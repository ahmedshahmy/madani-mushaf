[["4:69:18",89,"رَفِيقًۭا","companion(s)","وَٱلصَّـٰلِحِينَ ۚ وَحَسُنَ أُو۟لَـٰٓئِكَ","",4162],["5:6:12",108,"ٱلْمَرَافِقِ","the elbows","وُجُوهَكُمْ وَأَيْدِيَكُمْ إِلَى","وَٱمْسَحُوا۟ بِرُءُوسِكُمْ وَأَرْجُلَكُمْ",3699],["18:16:19",295,"مِّرْفَقًۭا","(in) ease","لَكُم مِّنْ أَمْرِكُم","",3948],["18:29:28",297,"مُرْتَفَقًا","(is) the resting place","بِئْسَ ٱلشَّرَابُ وَسَآءَتْ","",2500],["18:31:28",297,"مُرْتَفَقًۭا","(is) the resting place","نِعْمَ ٱلثَّوَابُ وَحَسُنَتْ","",2500]]