[["4:36:32",84,"فَخُورًا","(and) [a] boastful","مَن كَانَ مُخْتَالًۭا","",1547],["11:10:13",222,"فَخُورٌ","(and) boastful","عَنِّىٓ ۚ إِنَّهُۥ لَفَرِحٌۭ","",1547],["31:18:16",412,"فَخُورٍۢ","boaster","يُحِبُّ كُلَّ مُخْتَالٍۢ","",1547],["55:14:5",531,"كَٱلْفَخَّارِ","like the pottery","ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍۢ","",3432],["57:20:8",540,"وَتَفَاخُرٌۢ","and boasting","لَعِبٌۭ وَلَهْوٌۭ وَزِينَةٌۭ","بَيْنَكُمْ وَتَكَاثُرٌۭ فِى",4364],["57:23:15",540,"فَخُورٍ","boaster","يُحِبُّ كُلَّ مُخْتَالٍۢ","",1547]]