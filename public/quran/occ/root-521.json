[["2:187:37",29,"ٱلْأَبْيَضُ","[the] white","يَتَبَيَّنَ لَكُمُ ٱلْخَيْطُ","مِنَ ٱلْخَيْطِ ٱلْأَسْوَدِ",953],["3:106:2",63,"تَبْيَضُّ","would become white","يَوْمَ","وُجُوهٌۭ وَتَسْوَدُّ وُجُوهٌۭ ۚ",2101],["3:107:3",63,"ٱبْيَضَّتْ","turn white","وَأَمَّا ٱلَّذِينَ","وُجُوهُهُمْ فَفِى رَحْمَةِ",2101],["7:108:5",164,"بَيْضَآءُ","(was) white","يَدَهُۥ فَإِذَا هِىَ","لِلنَّـٰظِرِينَ",953],["12:84:7",245,"وَٱبْيَضَّتْ","And became white","يَـٰٓأَسَفَىٰ عَلَىٰ يُوسُفَ","عَيْنَاهُ مِنَ ٱلْحُزْنِ",2101],["20:22:6",313,"بَيْضَآءَ","white","إِلَىٰ جَنَاحِكَ تَخْرُجْ","مِنْ غَيْرِ سُوٓءٍ",953],["26:33:5",368,"بَيْضَآءُ","(was) white","يَدَهُۥ فَإِذَا هِىَ","لِلنَّـٰظِرِينَ",953],["27:12:6",377,"بَيْضَآءَ","white","فِى جَيْبِكَ تَخْرُجْ","مِنْ غَيْرِ سُوٓءٍۢ ۖ",953],["28:32:6",389,"بَيْضَآءَ","white","فِى جَيْبِكَ تَخْرُجْ","مِنْ غَيْرِ سُوٓءٍۢ",953],["35:27:17",437,"بِيضٌۭ","white","وَمِنَ ٱلْجِبَالِ جُدَدٌۢ","وَحُمْرٌۭ مُّخْتَلِفٌ أَلْوَٰنُهَا",953],["37:46:1",447,"بَيْضَآءَ","White","","لَذَّةٍۢ لِّلشَّـٰرِبِينَ",953],["37:49:2",447,"بَيْضٌۭ","eggs","كَأَنَّهُنَّ","مَّكْنُونٌۭ",3350]]