[["4:4:13",77,"هَنِيٓـًۭٔا","(in) satisfaction","مِّنْهُ نَفْسًۭا فَكُلُوهُ","مَّرِيٓـًۭٔا",1555],["52:19:3",524,"هَنِيٓـًٔۢا","(in) satisfaction","كُلُوا۟ وَٱشْرَبُوا۟","بِمَا كُنتُمْ تَعْمَلُونَ",1555],["69:24:3",567,"هَنِيٓـًٔۢا","(in) satisfaction","كُلُوا۟ وَٱشْرَبُوا۟","بِمَآ أَسْلَفْتُمْ فِى",1555],["77:43:3",581,"هَنِيٓـًٔۢا","(in) satisfaction","كُلُوا۟ وَٱشْرَبُوا۟","بِمَا كُنتُمْ تَعْمَلُونَ",1555]]