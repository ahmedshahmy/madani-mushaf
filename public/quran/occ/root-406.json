[["3:49:18",56,"فَأَنفُخُ","then I breath","ٱلطِّينِ كَهَيْـَٔةِ ٱلطَّيْرِ","فِيهِ فَيَكُونُ طَيْرًۢا",531],["5:110:34",126,"فَتَنفُخُ","then you breath","كَهَيْـَٔةِ ٱلطَّيْرِ بِإِذْنِى","فِيهَا فَتَكُونُ طَيْرًۢا",531],["6:73:16",136,"يُنفَخُ","will be blown","وَلَهُ ٱلْمُلْكُ يَوْمَ","فِى ٱلصُّورِ ۚ عَـٰلِمُ",531],["15:29:3",263,"وَنَفَخْتُ","and [I] breathed","فَإِذَا سَوَّيْتُهُۥ","فِيهِ مِن رُّوحِى",531],["18:96:10",303,"ٱنفُخُوا۟ ۖ","Blow","بَيْنَ ٱلصَّدَفَيْنِ قَالَ","حَتَّىٰٓ إِذَا جَعَلَهُۥ",531],["18:99:7",304,"وَنُفِخَ","and (will be) blown","يَمُوجُ فِى بَعْضٍۢ ۖ","فِى ٱلصُّورِ فَجَمَعْنَـٰهُمْ",531],["20:102:2",319,"يُنفَخُ","will be blown","يَوْمَ","فِى ٱلصُّورِ ۚ وَنَحْشُرُ",531],["21:91:4",330,"فَنَفَخْنَا","so We breathed","وَٱلَّتِىٓ أَحْصَنَتْ فَرْجَهَا","فِيهَا مِن رُّوحِنَا",531],["23:101:2",348,"نُفِخَ","is blown","فَإِذَا","فِى ٱلصُّورِ فَلَآ",531],["27:87:2",384,"يُنفَخُ","will be blown","وَيَوْمَ","فِى ٱلصُّورِ فَفَزِعَ",531],["32:9:3",415,"وَنَفَخَ","and breathed","ثُمَّ سَوَّىٰهُ","فِيهِ مِن رُّوحِهِۦ ۖ",531],["36:51:1",443,"وَنُفِخَ","And will be blown","","فِى ٱلصُّورِ فَإِذَا",531],["38:72:3",457,"وَنَفَخْتُ","and breathed","فَإِذَا سَوَّيْتُهُۥ","فِيهِ مِن رُّوحِى",531],["39:68:1",466,"وَنُفِخَ","And (will) be blown","","فِى ٱلصُّورِ فَصَعِقَ",531],["39:68:16",466,"نُفِخَ","(it will) be blown","شَآءَ ٱللَّهُ ۖ ثُمَّ","فِيهِ أُخْرَىٰ فَإِذَا",531],["50:20:1",519,"وَنُفِخَ","And will be blown","","فِى ٱلصُّورِ ۚ ذَٰلِكَ",531],["66:12:7",561,"فَنَفَخْنَا","so We breathed","ٱلَّتِىٓ أَحْصَنَتْ فَرْجَهَا","فِيهِ مِن رُّوحِنَا",531],["69:13:2",567,"نُفِخَ","is blown","فَإِذَا","فِى ٱلصُّورِ نَفْخَةٌۭ",531],["69:13:5",567,"نَفْخَةٌۭ","a blast","نُفِخَ فِى ٱلصُّورِ","وَٰحِدَةٌۭ",4031],["78:18:2",582,"يُنفَخُ","(in which) shall be blown","يَوْمَ","فِى ٱلصُّورِ فَتَأْتُونَ",531]]