[["2:204:17",32,"ٱلْخِصَامِ","(of) opponents","قَلْبِهِۦ وَهُوَ أَلَدُّ","",1416],["3:44:20",55,"يَخْتَصِمُونَ","they (were) disputing","كُنتَ لَدَيْهِمْ إِذْ","",1024],["4:105:15",95,"خَصِيمًۭا","a pleader","وَلَا تَكُن لِّلْخَآئِنِينَ","",1416],["16:4:7",267,"خَصِيمٌۭ","(is) an opponent","نُّطْفَةٍۢ فَإِذَا هُوَ","مُّبِينٌۭ",1416],["22:19:2",334,"خَصْمَانِ","opponents","۞ هَـٰذَانِ","ٱخْتَصَمُوا۟ فِى رَبِّهِمْ ۖ",2037],["22:19:3",334,"ٱخْتَصَمُوا۟","dispute","۞ هَـٰذَانِ خَصْمَانِ","فِى رَبِّهِمْ ۖ فَٱلَّذِينَ",1024],["26:96:4",371,"يَخْتَصِمُونَ","(are) disputing","قَالُوا۟ وَهُمْ فِيهَا","",1024],["27:45:13",381,"يَخْتَصِمُونَ","quarreling","فَإِذَا هُمْ فَرِيقَانِ","",1024],["36:49:8",443,"يَخِصِّمُونَ","are disputing","وَٰحِدَةًۭ تَأْخُذُهُمْ وَهُمْ","",1024],["36:77:10",445,"خَصِيمٌۭ","(is) an opponent","نُّطْفَةٍۢ فَإِذَا هُوَ","مُّبِينٌۭ",1416],["38:21:4",454,"ٱلْخَصْمِ","(of) the litigants","۞ وَهَلْ أَتَىٰكَ نَبَؤُا۟","إِذْ تَسَوَّرُوا۟ ٱلْمِحْرَابَ",2037],["38:22:10",454,"خَصْمَانِ","(We are) two litigants","قَالُوا۟ لَا تَخَفْ ۖ","بَغَىٰ بَعْضُنَا عَلَىٰ",2037],["38:64:4",457,"تَخَاصُمُ","(the) quarreling","إِنَّ ذَٰلِكَ لَحَقٌّۭ","أَهْلِ ٱلنَّارِ",4434],["38:69:9",457,"يَخْتَصِمُونَ","they were disputing","بِٱلْمَلَإِ ٱلْأَعْلَىٰٓ إِذْ","",1024],["39:31:7",461,"تَخْتَصِمُونَ","will dispute","ٱلْقِيَـٰمَةِ عِندَ رَبِّكُمْ","",1024],["43:18:7",490,"ٱلْخِصَامِ","the dispute","ٱلْحِلْيَةِ وَهُوَ فِى","غَيْرُ مُبِينٍۢ",1416],["43:58:14",493,"خَصِمُونَ","argumentative","بَلْ هُمْ قَوْمٌ","",4562],["50:28:3",519,"تَخْتَصِمُوا۟","dispute","قَالَ لَا","لَدَىَّ وَقَدْ قَدَّمْتُ",1024]]