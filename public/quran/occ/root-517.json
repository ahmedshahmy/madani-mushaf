[["2:75:1",11,"۞ أَفَتَطْمَعُونَ","Do you hope","","أَن يُؤْمِنُوا۟ لَكُمْ",1013],["5:84:10",122,"وَنَطْمَعُ","And we hope","جَآءَنَا مِنَ ٱلْحَقِّ","أَن يُدْخِلَنَا رَبُّنَا",1013],["7:46:18",156,"يَطْمَعُونَ","hope","لَمْ يَدْخُلُوهَا وَهُمْ","",1013],["7:56:9",157,"وَطَمَعًا ۚ","and hope","إِصْلَـٰحِهَا وَٱدْعُوهُ خَوْفًۭا","إِنَّ رَحْمَتَ ٱللَّهِ",1528],["13:12:6",250,"وَطَمَعًۭا","and a hope","يُرِيكُمُ ٱلْبَرْقَ خَوْفًۭا","وَيُنشِئُ ٱلسَّحَابَ ٱلثِّقَالَ",1528],["26:51:2",369,"نَطْمَعُ","hope","إِنَّا","أَن يَغْفِرَ لَنَا",1013],["26:82:2",370,"أَطْمَعُ","I hope","وَٱلَّذِىٓ","أَن يَغْفِرَ لِى",1013],["30:24:6",406,"وَطَمَعًۭا","and hope","يُرِيكُمُ ٱلْبَرْقَ خَوْفًۭا","وَيُنَزِّلُ مِنَ ٱلسَّمَآءِ",1528],["32:16:8",416,"وَطَمَعًۭا","and hope","يَدْعُونَ رَبَّهُمْ خَوْفًۭا","وَمِمَّا رَزَقْنَـٰهُمْ يُنفِقُونَ",1528],["33:32:12",422,"فَيَطْمَعَ","lest should be moved with desire","فَلَا تَخْضَعْنَ بِٱلْقَوْلِ","ٱلَّذِى فِى قَلْبِهِۦ",1013],["70:38:1",569,"أَيَطْمَعُ","Does long","","كُلُّ ٱمْرِئٍۢ مِّنْهُمْ",1013],["74:15:2",575,"يَطْمَعُ","he desires","ثُمَّ","أَنْ أَزِيدَ",1013]]