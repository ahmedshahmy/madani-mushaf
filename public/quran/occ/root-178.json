[["2:10:4",3,"فَزَادَهُمُ","so has increased them","فِى قُلُوبِهِم مَّرَضٌۭ","ٱللَّهُ مَرَضًۭا ۖ وَلَهُمْ",246],["2:58:19",9,"وَسَنَزِيدُ","And We will increase","نَّغْفِرْ لَكُمْ خَطَـٰيَـٰكُمْ ۚ","ٱلْمُحْسِنِينَ",246],["2:247:31",40,"وَزَادَهُۥ","and increased him","ٱللَّهَ ٱصْطَفَىٰهُ عَلَيْكُمْ","بَسْطَةًۭ فِى ٱلْعِلْمِ",246],["3:90:7",61,"ٱزْدَادُوا۟","they increased","بَعْدَ إِيمَـٰنِهِمْ ثُمَّ","كُفْرًۭا لَّن تُقْبَلَ",1025],["3:173:11",72,"فَزَادَهُمْ","But it increased them","جَمَعُوا۟ لَكُمْ فَٱخْشَوْهُمْ","إِيمَـٰنًۭا وَقَالُوا۟ حَسْبُنَا",246],["3:178:13",73,"لِيَزْدَادُوٓا۟","so that they may increase","إِنَّمَا نُمْلِى لَهُمْ","إِثْمًۭا ۚ وَلَهُمْ عَذَابٌۭ",1025],["4:137:11",100,"ٱزْدَادُوا۟","increased","ثُمَّ كَفَرُوا۟ ثُمَّ","كُفْرًۭا لَّمْ يَكُنِ",1025],["4:173:8",105,"وَيَزِيدُهُم","and give them more","ٱلصَّـٰلِحَـٰتِ فَيُوَفِّيهِمْ أُجُورَهُمْ","مِّن فَضْلِهِۦ ۖ وَأَمَّا",246],["5:64:17",118,"وَلَيَزِيدَنَّ","And surely increase","يُنفِقُ كَيْفَ يَشَآءُ ۚ","كَثِيرًۭا مِّنْهُم مَّآ",246],["5:68:16",119,"وَلَيَزِيدَنَّ","And surely increase","إِلَيْكُم مِّن رَّبِّكُمْ ۗ","كَثِيرًۭا مِّنْهُم مَّآ",246],["7:69:19",159,"وَزَادَكُمْ","and increased you","بَعْدِ قَوْمِ نُوحٍۢ","فِى ٱلْخَلْقِ بَصْۜطَةًۭ ۖ",246],["7:161:19",171,"سَنَزِيدُ","We will increase (reward)","نَّغْفِرْ لَكُمْ خَطِيٓـَٔـٰتِكُمْ ۚ","ٱلْمُحْسِنِينَ",246],["8:2:13",177,"زَادَتْهُمْ","they increase them","تُلِيَتْ عَلَيْهِمْ ءَايَـٰتُهُۥ","إِيمَـٰنًۭا وَعَلَىٰ رَبِّهِمْ",246],["9:37:3",193,"زِيَادَةٌۭ","(is) an increase","إِنَّمَا ٱلنَّسِىٓءُ","فِى ٱلْكُفْرِ ۖ يُضَلُّ",2825],["9:47:5",194,"زَادُوكُمْ","they (would) have increased you","خَرَجُوا۟ فِيكُم مَّا","إِلَّا خَبَالًۭا وَلَأَوْضَعُوا۟",246],["9:124:9",207,"زَادَتْهُ","(has) increased [it]","مَّن يَقُولُ أَيُّكُمْ","هَـٰذِهِۦٓ إِيمَـٰنًۭا ۚ فَأَمَّا",246],["9:124:15",207,"فَزَادَتْهُمْ","then it has increased them","فَأَمَّا ٱلَّذِينَ ءَامَنُوا۟","إِيمَـٰنًۭا وَهُمْ يَسْتَبْشِرُونَ",246],["9:125:6",207,"فَزَادَتْهُمْ","(it) increases them","فِى قُلُوبِهِم مَّرَضٌۭ","رِجْسًا إِلَىٰ رِجْسِهِمْ",246],["10:26:4",212,"وَزِيَادَةٌۭ ۖ","and more","۞ لِّلَّذِينَ أَحْسَنُوا۟ ٱلْحُسْنَىٰ","وَلَا يَرْهَقُ وُجُوهَهُمْ",2825],["11:52:11",227,"وَيَزِدْكُمْ","and increase you","ٱلسَّمَآءَ عَلَيْكُم مِّدْرَارًۭا","قُوَّةً إِلَىٰ قُوَّتِكُمْ",246],["11:63:20",229,"تَزِيدُونَنِى","you would increase me","إِنْ عَصَيْتُهُۥ ۖ فَمَا","غَيْرَ تَخْسِيرٍۢ",246],["11:101:22",233,"زَادُوهُمْ","they increased them","أَمْرُ رَبِّكَ ۖ وَمَا","غَيْرَ تَتْبِيبٍۢ",246],["12:65:20",243,"وَنَزْدَادُ","and get an increase","أَهْلَنَا وَنَحْفَظُ أَخَانَا","كَيْلَ بَعِيرٍۢ ۖ ذَٰلِكَ",1025],["13:8:11",250,"تَزْدَادُ ۖ","they exceed","تَغِيضُ ٱلْأَرْحَامُ وَمَا","وَكُلُّ شَىْءٍ عِندَهُۥ",1025],["14:7:6",256,"لَأَزِيدَنَّكُمْ ۖ","surely I will increase you","رَبُّكُمْ لَئِن شَكَرْتُمْ","وَلَئِن كَفَرْتُمْ إِنَّ",246],["16:88:7",277,"زِدْنَـٰهُمْ","We will increase them","عَن سَبِيلِ ٱللَّهِ","عَذَابًۭا فَوْقَ ٱلْعَذَابِ",246],["17:41:8",286,"يَزِيدُهُمْ","it increases them","ٱلْقُرْءَانِ لِيَذَّكَّرُوا۟ وَمَا","إِلَّا نُفُورًۭا",246],["17:60:22",288,"يَزِيدُهُمْ","it increases them","ٱلْقُرْءَانِ ۚ وَنُخَوِّفُهُمْ فَمَا","إِلَّا طُغْيَـٰنًۭا كَبِيرًۭا",246],["17:82:10",290,"يَزِيدُ","it increases","وَرَحْمَةٌۭ لِّلْمُؤْمِنِينَ ۙ وَلَا","ٱلظَّـٰلِمِينَ إِلَّا خَسَارًۭا",246],["17:97:26",292,"زِدْنَـٰهُمْ","We (will) increase (for) them","جَهَنَّمُ ۖ كُلَّمَا خَبَتْ","سَعِيرًۭا",246],["17:109:4",293,"وَيَزِيدُهُمْ","and it increases them","وَيَخِرُّونَ لِلْأَذْقَانِ يَبْكُونَ","خُشُوعًۭا ۩",246],["18:13:10",294,"وَزِدْنَـٰهُمْ","and We increased them","فِتْيَةٌ ءَامَنُوا۟ بِرَبِّهِمْ","هُدًۭى",246],["18:25:7",296,"وَٱزْدَادُوا۟","and add","ثَلَـٰثَ مِا۟ئَةٍۢ سِنِينَ","تِسْعًۭا",1025],["19:76:1",310,"وَيَزِيدُ","And Allah increases","","ٱللَّهُ ٱلَّذِينَ ٱهْتَدَوْا۟",246],["20:114:16",320,"زِدْنِى","Increase me","وَحْيُهُۥ ۖ وَقُل رَّبِّ","عِلْمًۭا",246],["24:38:6",355,"وَيَزِيدَهُم","and increase them","أَحْسَنَ مَا عَمِلُوا۟","مِّن فَضْلِهِۦ ۗ وَٱللَّهُ",246],["25:60:12",365,"وَزَادَهُمْ","And it increases them","أَنَسْجُدُ لِمَا تَأْمُرُنَا","نُفُورًۭا ۩",246],["33:22:15",420,"زَادَهُمْ","it increased them","ٱللَّهُ وَرَسُولُهُۥ ۚ وَمَا","إِلَّآ إِيمَـٰنًۭا وَتَسْلِيمًۭا",246],["35:1:14",434,"يَزِيدُ","He increases","مَّثْنَىٰ وَثُلَـٰثَ وَرُبَـٰعَ ۚ","فِى ٱلْخَلْقِ مَا",246],["35:30:3",437,"وَيَزِيدَهُم","and increase for them","لِيُوَفِّيَهُمْ أُجُورَهُمْ","مِّن فَضْلِهِۦٓ ۚ إِنَّهُۥ",246],["35:39:12",439,"يَزِيدُ","increase","فَعَلَيْهِ كُفْرُهُۥ ۖ وَلَا","ٱلْكَـٰفِرِينَ كُفْرُهُمْ عِندَ",246],["35:39:20",439,"يَزِيدُ","increase","إِلَّا مَقْتًۭا ۖ وَلَا","ٱلْكَـٰفِرِينَ كُفْرُهُمْ إِلَّا",246],["35:42:17",439,"زَادَهُمْ","it increased them","جَآءَهُمْ نَذِيرٌۭ مَّا","إِلَّا نُفُورًا",246],["37:147:6",451,"يَزِيدُونَ","more","مِا۟ئَةِ أَلْفٍ أَوْ","",246],["38:61:7",456,"فَزِدْهُ","increase for him","قَدَّمَ لَنَا هَـٰذَا","عَذَابًۭا ضِعْفًۭا فِى",246],["42:20:6",485,"نَزِدْ","We increase","يُرِيدُ حَرْثَ ٱلْـَٔاخِرَةِ","لَهُۥ فِى حَرْثِهِۦ ۖ",246],["42:23:22",486,"نَّزِدْ","We increase","وَمَن يَقْتَرِفْ حَسَنَةًۭ","لَهُۥ فِيهَا حُسْنًا ۚ",246],["42:26:6",486,"وَيَزِيدُهُم","and increases (for) them","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","مِّن فَضْلِهِۦ ۚ وَٱلْكَـٰفِرُونَ",246],["47:17:3",508,"زَادَهُمْ","He increases them","وَٱلَّذِينَ ٱهْتَدَوْا۟","هُدًۭى وَءَاتَىٰهُمْ تَقْوَىٰهُمْ",246],["48:4:8",511,"لِيَزْدَادُوٓا۟","that they may increase","فِى قُلُوبِ ٱلْمُؤْمِنِينَ","إِيمَـٰنًۭا مَّعَ إِيمَـٰنِهِمْ ۗ",1025],["50:30:9",519,"مَّزِيدٍۢ","more","وَتَقُولُ هَلْ مِن","",2532],["50:35:6",519,"مَزِيدٌۭ","(is) more","يَشَآءُونَ فِيهَا وَلَدَيْنَا","",2532],["71:6:2",570,"يَزِدْهُمْ","increased them","فَلَمْ","دُعَآءِىٓ إِلَّا فِرَارًۭا",246],["71:21:9",571,"يَزِدْهُ","increase him","وَٱتَّبَعُوا۟ مَن لَّمْ","مَالُهُۥ وَوَلَدُهُۥٓ إِلَّا",246],["71:24:5",571,"تَزِدِ","increase","أَضَلُّوا۟ كَثِيرًۭا ۖ وَلَا","ٱلظَّـٰلِمِينَ إِلَّا ضَلَـٰلًۭا",246],["71:28:12",571,"تَزِدِ","increase","وَلِلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ وَلَا","ٱلظَّـٰلِمِينَ إِلَّا تَبَارًۢا",246],["72:6:10",572,"فَزَادُوهُمْ","so they increased them","بِرِجَالٍۢ مِّنَ ٱلْجِنِّ","رَهَقًۭا",246],["73:4:2",574,"زِدْ","add","أَوْ","عَلَيْهِ وَرَتِّلِ ٱلْقُرْءَانَ",246],["74:15:4",575,"أَزِيدَ","I (should) add more","ثُمَّ يَطْمَعُ أَنْ","",246],["74:31:18",576,"وَيَزْدَادَ","and may increase","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ","ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَـٰنًۭا ۙ",1025],["78:30:3",582,"نَّزِيدَكُمْ","We will increase you","فَذُوقُوا۟ فَلَن","إِلَّا عَذَابًا",246]]