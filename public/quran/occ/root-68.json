[["2:31:10",6,"أَنۢبِـُٔونِى","Inform Me","عَلَى ٱلْمَلَـٰٓئِكَةِ فَقَالَ","بِأَسْمَآءِ هَـٰٓؤُلَآءِ إِن",1476],["2:33:3",6,"أَنۢبِئْهُم","Inform them","قَالَ يَـٰٓـَٔادَمُ","بِأَسْمَآئِهِمْ ۖ فَلَمَّآ أَنۢبَأَهُم",1476],["2:33:6",6,"أَنۢبَأَهُم","he had informed them","أَنۢبِئْهُم بِأَسْمَآئِهِمْ ۖ فَلَمَّآ","بِأَسْمَآئِهِمْ قَالَ أَلَمْ",1476],["2:61:52",9,"ٱلنَّبِيِّـۧنَ","the Prophets","بِـَٔايَـٰتِ ٱللَّهِ وَيَقْتُلُونَ","بِغَيْرِ ٱلْحَقِّ ۗ ذَٰلِكَ",156],["2:91:24",14,"أَنۢبِيَآءَ","(the) Prophets","قُلْ فَلِمَ تَقْتُلُونَ","ٱللَّهِ مِن قَبْلُ",156],["2:136:21",21,"ٱلنَّبِيُّونَ","(to) the Prophets","وَعِيسَىٰ وَمَآ أُوتِىَ","مِن رَّبِّهِمْ لَا",156],["2:177:18",27,"وَٱلنَّبِيِّـۧنَ","and the Prophets","ٱلْـَٔاخِرِ وَٱلْمَلَـٰٓئِكَةِ وَٱلْكِتَـٰبِ","وَءَاتَى ٱلْمَالَ عَلَىٰ",156],["2:213:7",33,"ٱلنَّبِيِّـۧنَ","[the] Prophets","وَٰحِدَةًۭ فَبَعَثَ ٱللَّهُ","مُبَشِّرِينَ وَمُنذِرِينَ وَأَنزَلَ",156],["2:246:13",40,"لِنَبِىٍّۢ","to a Prophet","مُوسَىٰٓ إِذْ قَالُوا۟","لَّهُمُ ٱبْعَثْ لَنَا",156],["2:247:3",40,"نَبِيُّهُمْ","their Prophet","وَقَالَ لَهُمْ","إِنَّ ٱللَّهَ قَدْ",156],["2:248:3",40,"نَبِيُّهُمْ","their Prophet","وَقَالَ لَهُمْ","إِنَّ ءَايَةَ مُلْكِهِۦٓ",156],["3:15:2",51,"أَؤُنَبِّئُكُم","Shall I inform you","۞ قُلْ","بِخَيْرٍۢ مِّن ذَٰلِكُمْ ۚ",255],["3:21:7",52,"ٱلنَّبِيِّـۧنَ","the Prophets","بِـَٔايَـٰتِ ٱللَّهِ وَيَقْتُلُونَ","بِغَيْرِ حَقٍّۢ وَيَقْتُلُونَ",156],["3:39:18",55,"وَنَبِيًّۭا","and a Prophet","ٱللَّهِ وَسَيِّدًۭا وَحَصُورًۭا","مِّنَ ٱلصَّـٰلِحِينَ",156],["3:44:3",55,"أَنۢبَآءِ","(the) news","ذَٰلِكَ مِنْ","ٱلْغَيْبِ نُوحِيهِ إِلَيْكَ ۚ",376],["3:49:31",56,"وَأُنَبِّئُكُم","And I inform you","ٱلْمَوْتَىٰ بِإِذْنِ ٱللَّهِ ۖ","بِمَا تَأْكُلُونَ وَمَا",255],["3:68:8",58,"ٱلنَّبِىُّ","[the] Prophet","لَلَّذِينَ ٱتَّبَعُوهُ وَهَـٰذَا","وَٱلَّذِينَ ءَامَنُوا۟ ۗ وَٱللَّهُ",156],["3:79:9",60,"وَٱلنُّبُوَّةَ","and the Prophethood","ٱللَّهُ ٱلْكِتَـٰبَ وَٱلْحُكْمَ","ثُمَّ يَقُولَ لِلنَّاسِ",1381],["3:80:6",60,"وَٱلنَّبِيِّـۧنَ","and the Prophets","أَن تَتَّخِذُوا۟ ٱلْمَلَـٰٓئِكَةَ","أَرْبَابًا ۗ أَيَأْمُرُكُم بِٱلْكُفْرِ",156],["3:81:5",60,"ٱلنَّبِيِّـۧنَ","(of) the Prophets","أَخَذَ ٱللَّهُ مِيثَـٰقَ","لَمَآ ءَاتَيْتُكُم مِّن",156],["3:84:19",61,"وَٱلنَّبِيُّونَ","and the Prophets","أُوتِىَ مُوسَىٰ وَعِيسَىٰ","مِن رَّبِّهِمْ لَا",156],["3:112:28",64,"ٱلْأَنۢبِيَآءَ","the Prophets","بِـَٔايَـٰتِ ٱللَّهِ وَيَقْتُلُونَ","بِغَيْرِ حَقٍّۢ ۚ ذَٰلِكَ",156],["3:146:3",68,"نَّبِىٍّۢ","a Prophet","وَكَأَيِّن مِّن","قَـٰتَلَ مَعَهُۥ رِبِّيُّونَ",156],["3:161:3",71,"لِنَبِىٍّ","for a Prophet","وَمَا كَانَ","أَن يَغُلَّ ۚ وَمَن",156],["3:181:16",74,"ٱلْأَنۢبِيَآءَ","the Prophets","مَا قَالُوا۟ وَقَتْلَهُمُ","بِغَيْرِ حَقٍّۢ وَنَقُولُ",156],["4:69:12",89,"ٱلنَّبِيِّـۧنَ","the Prophets","ٱللَّهُ عَلَيْهِم مِّنَ","وَٱلصِّدِّيقِينَ وَٱلشُّهَدَآءِ وَٱلصَّـٰلِحِينَ ۚ",156],["4:155:8",103,"ٱلْأَنۢبِيَآءَ","(of) the Prophets","بِـَٔايَـٰتِ ٱللَّهِ وَقَتْلِهِمُ","بِغَيْرِ حَقٍّۢ وَقَوْلِهِمْ",156],["4:163:8",104,"وَٱلنَّبِيِّـۧنَ","and the Prophets","أَوْحَيْنَآ إِلَىٰ نُوحٍۢ","مِنۢ بَعْدِهِۦ ۚ وَأَوْحَيْنَآ",156],["5:14:21",110,"يُنَبِّئُهُمُ","will inform them","يَوْمِ ٱلْقِيَـٰمَةِ ۚ وَسَوْفَ","ٱللَّهُ بِمَا كَانُوا۟",255],["5:20:13",111,"أَنۢبِيَآءَ","Prophets","إِذْ جَعَلَ فِيكُمْ","وَجَعَلَكُم مُّلُوكًۭا وَءَاتَىٰكُم",156],["5:27:3",112,"نَبَأَ","the story","۞ وَٱتْلُ عَلَيْهِمْ","ٱبْنَىْ ءَادَمَ بِٱلْحَقِّ",376],["5:44:9",115,"ٱلنَّبِيُّونَ","the Prophets","وَنُورٌۭ ۚ يَحْكُمُ بِهَا","ٱلَّذِينَ أَسْلَمُوا۟ لِلَّذِينَ",156],["5:48:47",116,"فَيُنَبِّئُكُم","then He will inform you","ٱللَّهِ مَرْجِعُكُمْ جَمِيعًۭا","بِمَا كُنتُمْ فِيهِ",255],["5:60:3",118,"أُنَبِّئُكُم","I inform you","قُلْ هَلْ","بِشَرٍّۢ مِّن ذَٰلِكَ",255],["5:81:5",121,"وَٱلنَّبِىِّ","and the Prophet","كَانُوا۟ يُؤْمِنُونَ بِٱللَّهِ","وَمَآ أُنزِلَ إِلَيْهِ",156],["5:105:16",125,"فَيُنَبِّئُكُم","then He will inform you","ٱللَّهِ مَرْجِعُكُمْ جَمِيعًۭا","بِمَا كُنتُمْ تَعْمَلُونَ",255],["6:5:8",128,"أَنۢبَـٰٓؤُا۟","news","جَآءَهُمْ ۖ فَسَوْفَ يَأْتِيهِمْ","مَا كَانُوا۟ بِهِۦ",376],["6:34:21",131,"نَّبَإِى۟","(the) news","وَلَقَدْ جَآءَكَ مِن","ٱلْمُرْسَلِينَ",376],["6:60:19",135,"يُنَبِّئُكُم","He will inform you","إِلَيْهِ مَرْجِعُكُمْ ثُمَّ","بِمَا كُنتُمْ تَعْمَلُونَ",255],["6:67:2",135,"نَبَإٍۢ","news","لِّكُلِّ","مُّسْتَقَرٌّۭ ۚ وَسَوْفَ تَعْلَمُونَ",376],["6:89:6",138,"وَٱلنُّبُوَّةَ ۚ","and the Prophethood","ءَاتَيْنَـٰهُمُ ٱلْكِتَـٰبَ وَٱلْحُكْمَ","فَإِن يَكْفُرْ بِهَا",1381],["6:108:22",141,"فَيُنَبِّئُهُم","then He will inform them","إِلَىٰ رَبِّهِم مَّرْجِعُهُمْ","بِمَا كَانُوا۟ يَعْمَلُونَ",255],["6:112:4",142,"نَبِىٍّ","Prophet","وَكَذَٰلِكَ جَعَلْنَا لِكُلِّ","عَدُوًّۭا شَيَـٰطِينَ ٱلْإِنسِ",156],["6:143:19",147,"نَبِّـُٔونِى","Inform me","عَلَيْهِ أَرْحَامُ ٱلْأُنثَيَيْنِ ۖ","بِعِلْمٍ إِن كُنتُمْ",255],["6:159:16",150,"يُنَبِّئُهُم","He will inform them","إِلَى ٱللَّهِ ثُمَّ","بِمَا كَانُوا۟ يَفْعَلُونَ",255],["6:164:25",150,"فَيُنَبِّئُكُم","then He will inform you","إِلَىٰ رَبِّكُم مَّرْجِعُكُمْ","بِمَا كُنتُمْ فِيهِ",255],["7:94:6",162,"نَّبِىٍّ","Prophet","فِى قَرْيَةٍۢ مِّن","إِلَّآ أَخَذْنَآ أَهْلَهَا",156],["7:101:6",163,"أَنۢبَآئِهَا ۚ","their news","نَقُصُّ عَلَيْكَ مِنْ","وَلَقَدْ جَآءَتْهُمْ رُسُلُهُم",376],["7:157:4",170,"ٱلنَّبِىَّ","the Prophet","ٱلَّذِينَ يَتَّبِعُونَ ٱلرَّسُولَ","ٱلْأُمِّىَّ ٱلَّذِى يَجِدُونَهُۥ",156],["7:158:23",170,"ٱلنَّبِىِّ","the Prophet","فَـَٔامِنُوا۟ بِٱللَّهِ وَرَسُولِهِ","ٱلْأُمِّىِّ ٱلَّذِى يُؤْمِنُ",156],["7:175:3",173,"نَبَأَ","(the) story","وَٱتْلُ عَلَيْهِمْ","ٱلَّذِىٓ ءَاتَيْنَـٰهُ ءَايَـٰتِنَا",376],["8:64:2",185,"ٱلنَّبِىُّ","Prophet","يَـٰٓأَيُّهَا","حَسْبُكَ ٱللَّهُ وَمَنِ",156],["8:65:2",185,"ٱلنَّبِىُّ","Prophet","يَـٰٓأَيُّهَا","حَرِّضِ ٱلْمُؤْمِنِينَ عَلَى",156],["8:67:3",185,"لِنَبِىٍّ","for a Prophet","مَا كَانَ","أَن يَكُونَ لَهُۥٓ",156],["8:70:2",186,"ٱلنَّبِىُّ","Prophet","يَـٰٓأَيُّهَا","قُل لِّمَن فِىٓ",156],["9:61:4",196,"ٱلنَّبِىَّ","the Prophet","وَمِنْهُمُ ٱلَّذِينَ يُؤْذُونَ","وَيَقُولُونَ هُوَ أُذُنٌۭ ۚ",156],["9:64:7",197,"تُنَبِّئُهُم","informing them","تُنَزَّلَ عَلَيْهِمْ سُورَةٌۭ","بِمَا فِى قُلُوبِهِمْ ۚ",255],["9:70:3",198,"نَبَأُ","(the) news","أَلَمْ يَأْتِهِمْ","ٱلَّذِينَ مِن قَبْلِهِمْ",376],["9:73:2",199,"ٱلنَّبِىُّ","O Prophet","يَـٰٓأَيُّهَا","جَـٰهِدِ ٱلْكُفَّارَ وَٱلْمُنَـٰفِقِينَ",156],["9:94:13",202,"نَبَّأَنَا","Allah (has) informed us","نُّؤْمِنَ لَكُمْ قَدْ","ٱللَّهُ مِنْ أَخْبَارِكُمْ ۚ",255],["9:94:27",202,"فَيُنَبِّئُكُم","then He will inform you","عَـٰلِمِ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ","بِمَا كُنتُمْ تَعْمَلُونَ",255],["9:105:13",203,"فَيُنَبِّئُكُم","then He will inform you","عَـٰلِمِ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ","بِمَا كُنتُمْ تَعْمَلُونَ",255],["9:113:3",205,"لِلنَّبِىِّ","for the Prophet","مَا كَانَ","وَٱلَّذِينَ ءَامَنُوٓا۟ أَن",156],["9:117:5",205,"ٱلنَّبِىِّ","the Prophet","تَّابَ ٱللَّهُ عَلَى","وَٱلْمُهَـٰجِرِينَ وَٱلْأَنصَارِ ٱلَّذِينَ",156],["10:18:16",210,"أَتُنَبِّـُٔونَ","Do you inform","عِندَ ٱللَّهِ ۚ قُلْ","ٱللَّهَ بِمَا لَا",255],["10:23:22",211,"فَنُنَبِّئُكُم","and We will inform you","ثُمَّ إِلَيْنَا مَرْجِعُكُمْ","بِمَا كُنتُمْ تَعْمَلُونَ",255],["10:53:1",214,"۞ وَيَسْتَنۢبِـُٔونَكَ","And they ask you to inform","","أَحَقٌّ هُوَ ۖ قُلْ",4663],["10:71:3",217,"نَبَأَ","the news","۞ وَٱتْلُ عَلَيْهِمْ","نُوحٍ إِذْ قَالَ",376],["11:49:3",227,"أَنۢبَآءِ","the news","تِلْكَ مِنْ","ٱلْغَيْبِ نُوحِيهَآ إِلَيْكَ ۖ",376],["11:100:3",233,"أَنۢبَآءِ","(the) news","ذَٰلِكَ مِنْ","ٱلْقُرَىٰ نَقُصُّهُۥ عَلَيْكَ ۖ",376],["11:120:5",235,"أَنۢبَآءِ","(the) news","نَّقُصُّ عَلَيْكَ مِنْ","ٱلرُّسُلِ مَا نُثَبِّتُ",376],["12:15:12",237,"لَتُنَبِّئَنَّهُم","Surely, you will inform them","ٱلْجُبِّ ۚ وَأَوْحَيْنَآ إِلَيْهِ","بِأَمْرِهِمْ هَـٰذَا وَهُمْ",255],["12:36:22",239,"نَبِّئْنَا","Inform us","تَأْكُلُ ٱلطَّيْرُ مِنْهُ ۖ","بِتَأْوِيلِهِۦٓ ۖ إِنَّا نَرَىٰكَ",255],["12:37:7",239,"نَبَّأْتُكُمَا","I will inform both of you","طَعَامٌۭ تُرْزَقَانِهِۦٓ إِلَّا","بِتَأْوِيلِهِۦ قَبْلَ أَن",255],["12:45:9",241,"أُنَبِّئُكُم","[I] will inform you","بَعْدَ أُمَّةٍ أَنَا۠","بِتَأْوِيلِهِۦ فَأَرْسِلُونِ",255],["12:102:3",247,"أَنۢبَآءِ","the news","ذَٰلِكَ مِنْ","ٱلْغَيْبِ نُوحِيهِ إِلَيْكَ ۖ",376],["13:33:15",253,"تُنَبِّـُٔونَهُۥ","(do) you inform Him","قُلْ سَمُّوهُمْ ۚ أَمْ","بِمَا لَا يَعْلَمُ",255],["14:9:3",256,"نَبَؤُا۟","(the) news","أَلَمْ يَأْتِكُمْ","ٱلَّذِينَ مِن قَبْلِكُمْ",376],["15:49:1",264,"۞ نَبِّئْ","Inform","","عِبَادِىٓ أَنِّىٓ أَنَا",255],["15:51:1",264,"وَنَبِّئْهُمْ","And inform them","","عَن ضَيْفِ إِبْرَٰهِيمَ",255],["17:55:10",287,"ٱلنَّبِيِّـۧنَ","(of) the Prophets","وَلَقَدْ فَضَّلْنَا بَعْضَ","عَلَىٰ بَعْضٍۢ ۖ وَءَاتَيْنَا",156],["18:13:4",294,"نَبَأَهُم","their story","نَّحْنُ نَقُصُّ عَلَيْكَ","بِٱلْحَقِّ ۚ إِنَّهُمْ فِتْيَةٌ",376],["18:78:6",302,"سَأُنَبِّئُكَ","I will inform you","فِرَاقُ بَيْنِى وَبَيْنِكَ ۚ","بِتَأْوِيلِ مَا لَمْ",255],["18:103:3",304,"نُنَبِّئُكُم","We inform you","قُلْ هَلْ","بِٱلْأَخْسَرِينَ أَعْمَـٰلًا",255],["19:30:8",307,"نَبِيًّۭا","a Prophet","ءَاتَىٰنِىَ ٱلْكِتَـٰبَ وَجَعَلَنِى","",156],["19:41:8",308,"نَّبِيًّا","a Prophet","إِنَّهُۥ كَانَ صِدِّيقًۭا","",156],["19:49:14",308,"نَبِيًّۭا","a Prophet","وَيَعْقُوبَ ۖ وَكُلًّۭا جَعَلْنَا","",156],["19:51:10",308,"نَّبِيًّۭا","a Prophet","مُخْلَصًۭا وَكَانَ رَسُولًۭا","",156],["19:53:7",309,"نَبِيًّۭا","a Prophet","رَّحْمَتِنَآ أَخَاهُ هَـٰرُونَ","",156],["19:54:11",309,"نَّبِيًّۭا","a Prophet","ٱلْوَعْدِ وَكَانَ رَسُولًۭا","",156],["19:56:8",309,"نَّبِيًّۭا","a Prophet","إِنَّهُۥ كَانَ صِدِّيقًۭا","",156],["19:58:7",309,"ٱلنَّبِيِّـۧنَ","the Prophets","ٱللَّهُ عَلَيْهِم مِّنَ","مِن ذُرِّيَّةِ ءَادَمَ",156],["20:99:5",319,"أَنۢبَآءِ","(the) news","نَقُصُّ عَلَيْكَ مِنْ","مَا قَدْ سَبَقَ ۚ",376],["22:52:8",338,"نَبِىٍّ","a Prophet","مِن رَّسُولٍۢ وَلَا","إِلَّآ إِذَا تَمَنَّىٰٓ",156],["22:72:19",340,"أَفَأُنَبِّئُكُم","Then shall I inform you","عَلَيْهِمْ ءَايَـٰتِنَا ۗ قُلْ","بِشَرٍّۢ مِّن ذَٰلِكُمُ ۗ",255],["24:64:16",359,"فَيُنَبِّئُهُم","then He will inform them","وَيَوْمَ يُرْجَعُونَ إِلَيْهِ","بِمَا عَمِلُوا۟ ۗ وَٱللَّهُ",255],["25:31:4",362,"نَبِىٍّ","Prophet","وَكَذَٰلِكَ جَعَلْنَا لِكُلِّ","عَدُوًّۭا مِّنَ ٱلْمُجْرِمِينَ ۗ",156],["26:6:4",367,"أَنۢبَـٰٓؤُا۟","the news","فَقَدْ كَذَّبُوا۟ فَسَيَأْتِيهِمْ","مَا كَانُوا۟ بِهِۦ",376],["26:69:3",370,"نَبَأَ","(the) news","وَٱتْلُ عَلَيْهِمْ","إِبْرَٰهِيمَ",376],["26:221:2",376,"أُنَبِّئُكُمْ","I inform you","هَلْ","عَلَىٰ مَن تَنَزَّلُ",255],["27:22:13",378,"بِنَبَإٍۢ","with news","وَجِئْتُكَ مِن سَبَإٍۭ","يَقِينٍ",376],["28:3:4",385,"نَّبَإِ","(the) news","نَتْلُوا۟ عَلَيْكَ مِن","مُوسَىٰ وَفِرْعَوْنَ بِٱلْحَقِّ",376],["28:66:3",393,"ٱلْأَنۢبَآءُ","the information","فَعَمِيَتْ عَلَيْهِمُ","يَوْمَئِذٍۢ فَهُمْ لَا",376],["29:8:18",397,"فَأُنَبِّئُكُم","and I will inform you","تُطِعْهُمَآ ۚ إِلَىَّ مَرْجِعُكُمْ","بِمَا كُنتُمْ تَعْمَلُونَ",255],["29:27:8",399,"ٱلنُّبُوَّةَ","the Prophethood","وَجَعَلْنَا فِى ذُرِّيَّتِهِ","وَٱلْكِتَـٰبَ وَءَاتَيْنَـٰهُ أَجْرَهُۥ",1381],["31:15:26",412,"فَأُنَبِّئُكُم","then I will inform you","ثُمَّ إِلَىَّ مَرْجِعُكُمْ","بِمَا كُنتُمْ تَعْمَلُونَ",255],["31:23:8",413,"فَنُنَبِّئُهُم","then We will inform them","كُفْرُهُۥٓ ۚ إِلَيْنَا مَرْجِعُهُمْ","بِمَا عَمِلُوٓا۟ ۚ إِنَّ",255],["33:1:2",418,"ٱلنَّبِىُّ","O Prophet","يَـٰٓأَيُّهَا","ٱتَّقِ ٱللَّهَ وَلَا",156],["33:6:1",418,"ٱلنَّبِىُّ","The Prophet","","أَوْلَىٰ بِٱلْمُؤْمِنِينَ مِنْ",156],["33:7:4",419,"ٱلنَّبِيِّـۧنَ","the Prophets","وَإِذْ أَخَذْنَا مِنَ","مِيثَـٰقَهُمْ وَمِنكَ وَمِن",156],["33:13:14",419,"ٱلنَّبِىَّ","(from) the Prophet","وَيَسْتَـْٔذِنُ فَرِيقٌۭ مِّنْهُمُ","يَقُولُونَ إِنَّ بُيُوتَنَا",156],["33:20:16",420,"أَنۢبَآئِكُمْ ۖ","your news","ٱلْأَعْرَابِ يَسْـَٔلُونَ عَنْ","وَلَوْ كَانُوا۟ فِيكُم",376],["33:28:2",421,"ٱلنَّبِىُّ","O Prophet","يَـٰٓأَيُّهَا","قُل لِّأَزْوَٰجِكَ إِن",156],["33:30:2",421,"ٱلنَّبِىِّ","(of) the Prophet","يَـٰنِسَآءَ","مَن يَأْتِ مِنكُنَّ",156],["33:32:2",422,"ٱلنَّبِىِّ","(of) the Prophet","يَـٰنِسَآءَ","لَسْتُنَّ كَأَحَدٍۢ مِّنَ",156],["33:38:4",423,"ٱلنَّبِىِّ","the Prophet","مَّا كَانَ عَلَى","مِنْ حَرَجٍۢ فِيمَا",156],["33:40:12",423,"ٱلنَّبِيِّـۧنَ ۗ","(of) the Prophets","رَّسُولَ ٱللَّهِ وَخَاتَمَ","وَكَانَ ٱللَّهُ بِكُلِّ",156],["33:45:2",424,"ٱلنَّبِىُّ","O Prophet","يَـٰٓأَيُّهَا","إِنَّآ أَرْسَلْنَـٰكَ شَـٰهِدًۭا",156],["33:50:2",424,"ٱلنَّبِىُّ","O Prophet","يَـٰٓأَيُّهَا","إِنَّآ أَحْلَلْنَا لَكَ",156],["33:50:33",424,"لِلنَّبِىِّ","to the Prophet","إِن وَهَبَتْ نَفْسَهَا","إِنْ أَرَادَ ٱلنَّبِىُّ",156],["33:50:36",424,"ٱلنَّبِىُّ","the Prophet","لِلنَّبِىِّ إِنْ أَرَادَ","أَن يَسْتَنكِحَهَا خَالِصَةًۭ",156],["33:53:7",425,"ٱلنَّبِىِّ","(of) the Prophet","لَا تَدْخُلُوا۟ بُيُوتَ","إِلَّآ أَن يُؤْذَنَ",156],["33:53:31",425,"ٱلنَّبِىَّ","the Prophet","ذَٰلِكُمْ كَانَ يُؤْذِى","فَيَسْتَحْىِۦ مِنكُمْ ۖ وَٱللَّهُ",156],["33:56:6",426,"ٱلنَّبِىِّ ۚ","the Prophet","وَمَلَـٰٓئِكَتَهُۥ يُصَلُّونَ عَلَى","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟",156],["33:59:2",426,"ٱلنَّبِىُّ","O Prophet","يَـٰٓأَيُّهَا","قُل لِّأَزْوَٰجِكَ وَبَنَاتِكَ",156],["34:7:8",428,"يُنَبِّئُكُمْ","who informs you","نَدُلُّكُمْ عَلَىٰ رَجُلٍۢ","إِذَا مُزِّقْتُمْ كُلَّ",255],["35:14:16",436,"يُنَبِّئُكَ","can inform you","يَكْفُرُونَ بِشِرْكِكُمْ ۚ وَلَا","مِثْلُ خَبِيرٍۢ",255],["37:112:3",450,"نَبِيًّۭا","a Prophet","وَبَشَّرْنَـٰهُ بِإِسْحَـٰقَ","مِّنَ ٱلصَّـٰلِحِينَ",156],["38:21:3",454,"نَبَؤُا۟","(the) news","۞ وَهَلْ أَتَىٰكَ","ٱلْخَصْمِ إِذْ تَسَوَّرُوا۟",376],["38:67:3",457,"نَبَؤٌا۟","a news","قُلْ هُوَ","عَظِيمٌ",376],["38:88:2",458,"نَبَأَهُۥ","its information","وَلَتَعْلَمُنَّ","بَعْدَ حِينٍۭ",376],["39:7:24",459,"فَيُنَبِّئُكُم","then He will inform you","إِلَىٰ رَبِّكُم مَّرْجِعُكُمْ","بِمَا كُنتُمْ تَعْمَلُونَ ۚ",255],["39:69:8",466,"بِٱلنَّبِيِّـۧنَ","the Prophets","وَوُضِعَ ٱلْكِتَـٰبُ وَجِا۟ىٓءَ","وَٱلشُّهَدَآءِ وَقُضِىَ بَيْنَهُم",156],["41:50:24",482,"فَلَنُنَبِّئَنَّ","But We will surely inform","لِى عِندَهُۥ لَلْحُسْنَىٰ ۚ","ٱلَّذِينَ كَفَرُوا۟ بِمَا",255],["43:6:4",489,"نَّبِىٍّۢ","a Prophet","وَكَمْ أَرْسَلْنَا مِن","فِى ٱلْأَوَّلِينَ",156],["43:7:4",489,"نَّبِىٍّ","any Prophet","وَمَا يَأْتِيهِم مِّن","إِلَّا كَانُوا۟ بِهِۦ",156],["45:16:7",500,"وَٱلنُّبُوَّةَ","and the Prophethood","إِسْرَٰٓءِيلَ ٱلْكِتَـٰبَ وَٱلْحُكْمَ","وَرَزَقْنَـٰهُم مِّنَ ٱلطَّيِّبَـٰتِ",1381],["49:2:9",515,"ٱلنَّبِىِّ","(of) the Prophet","أَصْوَٰتَكُمْ فَوْقَ صَوْتِ","وَلَا تَجْهَرُوا۟ لَهُۥ",156],["49:6:7",516,"بِنَبَإٍۢ","with information","إِن جَآءَكُمْ فَاسِقٌۢ","فَتَبَيَّنُوٓا۟ أَن تُصِيبُوا۟",376],["53:36:3",527,"يُنَبَّأْ","he was informed","أَمْ لَمْ","بِمَا فِى صُحُفِ",255],["54:4:4",528,"ٱلْأَنۢبَآءِ","the information","وَلَقَدْ جَآءَهُم مِّنَ","مَا فِيهِ مُزْدَجَرٌ",376],["54:28:1",530,"وَنَبِّئْهُمْ","And inform them","","أَنَّ ٱلْمَآءَ قِسْمَةٌۢ",255],["57:26:8",541,"ٱلنُّبُوَّةَ","Prophethood","وَجَعَلْنَا فِى ذُرِّيَّتِهِمَا","وَٱلْكِتَـٰبَ ۖ فَمِنْهُم مُّهْتَدٍۢ ۖ",1381],["58:6:5",542,"فَيُنَبِّئُهُم","and inform them","يَبْعَثُهُمُ ٱللَّهُ جَمِيعًۭا","بِمَا عَمِلُوٓا۟ ۚ أَحْصَىٰهُ",255],["58:7:38",543,"يُنَبِّئُهُم","He will inform them","مَا كَانُوا۟ ۖ ثُمَّ","بِمَا عَمِلُوا۟ يَوْمَ",255],["60:12:2",551,"ٱلنَّبِىُّ","Prophet","يَـٰٓأَيُّهَا","إِذَا جَآءَكَ ٱلْمُؤْمِنَـٰتُ",156],["62:8:15",553,"فَيُنَبِّئُكُم","and He will inform you","عَـٰلِمِ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ","بِمَا كُنتُمْ تَعْمَلُونَ",255],["64:5:3",556,"نَبَؤُا۟","(the) news","أَلَمْ يَأْتِكُمْ","ٱلَّذِينَ كَفَرُوا۟ مِن",376],["64:7:12",556,"لَتُنَبَّؤُنَّ","surely you will be informed","وَرَبِّى لَتُبْعَثُنَّ ثُمَّ","بِمَا عَمِلْتُمْ ۚ وَذَٰلِكَ",255],["65:1:2",558,"ٱلنَّبِىُّ","Prophet","يَـٰٓأَيُّهَا","إِذَا طَلَّقْتُمُ ٱلنِّسَآءَ",156],["66:1:2",560,"ٱلنَّبِىُّ","Prophet","يَـٰٓأَيُّهَا","لِمَ تُحَرِّمُ مَآ",156],["66:3:3",560,"ٱلنَّبِىُّ","the Prophet","وَإِذْ أَسَرَّ","إِلَىٰ بَعْضِ أَزْوَٰجِهِۦ",156],["66:3:9",560,"نَبَّأَتْ","she informed","أَزْوَٰجِهِۦ حَدِيثًۭا فَلَمَّا","بِهِۦ وَأَظْهَرَهُ ٱللَّهُ",255],["66:3:20",560,"نَبَّأَهَا","he informed her","عَنۢ بَعْضٍۢ ۖ فَلَمَّا","بِهِۦ قَالَتْ مَنْ",255],["66:3:24",560,"أَنۢبَأَكَ","informed you","بِهِۦ قَالَتْ مَنْ","هَـٰذَا ۖ قَالَ نَبَّأَنِىَ",1476],["66:3:27",560,"نَبَّأَنِىَ","Has informed me","أَنۢبَأَكَ هَـٰذَا ۖ قَالَ","ٱلْعَلِيمُ ٱلْخَبِيرُ",255],["66:8:25",561,"ٱلنَّبِىَّ","the Prophet","لَا يُخْزِى ٱللَّهُ","وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ ۖ",156],["66:9:2",561,"ٱلنَّبِىُّ","Prophet","يَـٰٓأَيُّهَا","جَـٰهِدِ ٱلْكُفَّارَ وَٱلْمُنَـٰفِقِينَ",156],["75:13:1",577,"يُنَبَّؤُا۟","Will be informed","","ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا",255],["78:2:2",582,"ٱلنَّبَإِ","the News","عَنِ","ٱلْعَظِيمِ",376]]