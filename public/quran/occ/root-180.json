[["2:102:32",16,"فِتْنَةٌۭ","(are) a trial","يَقُولَآ إِنَّمَا نَحْنُ","فَلَا تَكْفُرْ ۖ فَيَتَعَلَّمُونَ",339],["2:191:8",30,"وَٱلْفِتْنَةُ","and [the] oppression","مِّنْ حَيْثُ أَخْرَجُوكُمْ ۚ","أَشَدُّ مِنَ ٱلْقَتْلِ ۚ",339],["2:193:5",30,"فِتْنَةٌۭ","oppression","حَتَّىٰ لَا تَكُونَ","وَيَكُونَ ٱلدِّينُ لِلَّهِ ۖ",339],["2:217:25",34,"وَٱلْفِتْنَةُ","And [the] oppression","أَكْبَرُ عِندَ ٱللَّهِ ۚ","أَكْبَرُ مِنَ ٱلْقَتْلِ ۗ",339],["3:7:24",50,"ٱلْفِتْنَةِ","[the] discord","تَشَـٰبَهَ مِنْهُ ٱبْتِغَآءَ","وَٱبْتِغَآءَ تَأْوِيلِهِۦ ۗ وَمَا",339],["4:91:12",92,"ٱلْفِتْنَةِ","the temptation","مَا رُدُّوٓا۟ إِلَى","أُرْكِسُوا۟ فِيهَا ۚ فَإِن",339],["4:101:15",94,"يَفْتِنَكُمُ","(may) harm you","إِنْ خِفْتُمْ أَن","ٱلَّذِينَ كَفَرُوٓا۟ ۚ إِنَّ",454],["5:41:44",114,"فِتْنَتَهُۥ","his trial","وَمَن يُرِدِ ٱللَّهُ","فَلَن تَمْلِكَ لَهُۥ",339],["5:49:12",116,"يَفْتِنُوكَ","they tempt you away","أَهْوَآءَهُمْ وَٱحْذَرْهُمْ أَن","عَنۢ بَعْضِ مَآ",454],["5:71:4",120,"فِتْنَةٌۭ","a trial","وَحَسِبُوٓا۟ أَلَّا تَكُونَ","فَعَمُوا۟ وَصَمُّوا۟ ثُمَّ",339],["6:23:4",130,"فِتْنَتُهُمْ","(for) them a plea","ثُمَّ لَمْ تَكُن","إِلَّآ أَن قَالُوا۟",339],["6:53:2",134,"فَتَنَّا","We try","وَكَذَٰلِكَ","بَعْضَهُم بِبَعْضٍۢ لِّيَقُولُوٓا۟",454],["7:27:4",153,"يَفْتِنَنَّكُمُ","tempt you","يَـٰبَنِىٓ ءَادَمَ لَا","ٱلشَّيْطَـٰنُ كَمَآ أَخْرَجَ",454],["7:155:26",169,"فِتْنَتُكَ","Your trial","إِنْ هِىَ إِلَّا","تُضِلُّ بِهَا مَن",339],["8:25:2",179,"فِتْنَةًۭ","a trial","وَٱتَّقُوا۟","لَّا تُصِيبَنَّ ٱلَّذِينَ",339],["8:28:5",180,"فِتْنَةٌۭ","(are) a trial","أَنَّمَآ أَمْوَٰلُكُمْ وَأَوْلَـٰدُكُمْ","وَأَنَّ ٱللَّهَ عِندَهُۥٓ",339],["8:39:5",181,"فِتْنَةٌۭ","oppression","حَتَّىٰ لَا تَكُونَ","وَيَكُونَ ٱلدِّينُ كُلُّهُۥ",339],["8:73:9",186,"فِتْنَةٌۭ","oppression","إِلَّا تَفْعَلُوهُ تَكُن","فِى ٱلْأَرْضِ وَفَسَادٌۭ",339],["9:47:11",194,"ٱلْفِتْنَةَ","dissension","وَلَأَوْضَعُوا۟ خِلَـٰلَكُمْ يَبْغُونَكُمُ","وَفِيكُمْ سَمَّـٰعُونَ لَهُمْ ۗ",339],["9:48:3",195,"ٱلْفِتْنَةَ","dissension","لَقَدِ ٱبْتَغَوُا۟","مِن قَبْلُ وَقَلَّبُوا۟",339],["9:49:7",195,"تَفْتِنِّىٓ ۚ","put me to trial","ٱئْذَن لِّى وَلَا","أَلَا فِى ٱلْفِتْنَةِ",454],["9:49:10",195,"ٱلْفِتْنَةِ","the trial","تَفْتِنِّىٓ ۚ أَلَا فِى","سَقَطُوا۟ ۗ وَإِنَّ جَهَنَّمَ",339],["9:126:4",207,"يُفْتَنُونَ","are tried","أَوَلَا يَرَوْنَ أَنَّهُمْ","فِى كُلِّ عَامٍۢ",454],["10:83:14",218,"يَفْتِنَهُمْ ۚ","they persecute them","فِرْعَوْنَ وَمَلَإِي۟هِمْ أَن","وَإِنَّ فِرْعَوْنَ لَعَالٍۢ",454],["10:85:8",218,"فِتْنَةًۭ","a trial","رَبَّنَا لَا تَجْعَلْنَا","لِّلْقَوْمِ ٱلظَّـٰلِمِينَ",339],["16:110:9",279,"فُتِنُوا۟","they had been put to trials","مِنۢ بَعْدِ مَا","ثُمَّ جَـٰهَدُوا۟ وَصَبَرُوٓا۟",454],["17:60:14",288,"فِتْنَةًۭ","(as) a trial","ٱلَّتِىٓ أَرَيْنَـٰكَ إِلَّا","لِّلنَّاسِ وَٱلشَّجَرَةَ ٱلْمَلْعُونَةَ",339],["17:73:3",289,"لَيَفْتِنُونَكَ","tempt you away","وَإِن كَادُوا۟","عَنِ ٱلَّذِىٓ أَوْحَيْنَآ",454],["20:40:23",314,"وَفَتَنَّـٰكَ","and We tried you","فَنَجَّيْنَـٰكَ مِنَ ٱلْغَمِّ","فُتُونًۭا ۚ فَلَبِثْتَ سِنِينَ",454],["20:40:24",314,"فُتُونًۭا ۚ","(with) a trial","مِنَ ٱلْغَمِّ وَفَتَنَّـٰكَ","فَلَبِثْتَ سِنِينَ فِىٓ",3445],["20:85:4",317,"فَتَنَّا","We (have) tried","قَالَ فَإِنَّا قَدْ","قَوْمَكَ مِنۢ بَعْدِكَ",454],["20:90:9",318,"فُتِنتُم","you are being tested","قَبْلُ يَـٰقَوْمِ إِنَّمَا","بِهِۦ ۖ وَإِنَّ رَبَّكُمُ",454],["20:131:13",321,"لِنَفْتِنَهُمْ","that We may test them","زَهْرَةَ ٱلْحَيَوٰةِ ٱلدُّنْيَا","فِيهِ ۚ وَرِزْقُ رَبِّكَ",454],["21:35:8",324,"فِتْنَةًۭ ۖ","(as) a trial","وَنَبْلُوكُم بِٱلشَّرِّ وَٱلْخَيْرِ","وَإِلَيْنَا تُرْجَعُونَ",339],["21:111:4",331,"فِتْنَةٌۭ","a trial","وَإِنْ أَدْرِى لَعَلَّهُۥ","لَّكُمْ وَمَتَـٰعٌ إِلَىٰ",339],["22:11:15",333,"فِتْنَةٌ","a trial","بِهِۦ ۖ وَإِنْ أَصَابَتْهُ","ٱنقَلَبَ عَلَىٰ وَجْهِهِۦ",339],["22:53:5",338,"فِتْنَةًۭ","a trial","مَا يُلْقِى ٱلشَّيْطَـٰنُ","لِّلَّذِينَ فِى قُلُوبِهِم",339],["24:63:23",359,"فِتْنَةٌ","a trial","أَمْرِهِۦٓ أَن تُصِيبَهُمْ","أَوْ يُصِيبَهُمْ عَذَابٌ",339],["25:20:16",361,"فِتْنَةً