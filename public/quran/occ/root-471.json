[["2:71:12",11,"ٱلْحَرْثَ","the field","ٱلْأَرْضَ وَلَا تَسْقِى","مُسَلَّمَةٌۭ لَّا شِيَةَ",681],["2:205:9",32,"ٱلْحَرْثَ","the crops","لِيُفْسِدَ فِيهَا وَيُهْلِكَ","وَٱلنَّسْلَ ۗ وَٱللَّهُ لَا",681],["2:223:2",35,"حَرْثٌۭ","(are) a tilth","نِسَآؤُكُمْ","لَّكُمْ فَأْتُوا۟ حَرْثَكُمْ",681],["2:223:5",35,"حَرْثَكُمْ","(to) your tilth","حَرْثٌۭ لَّكُمْ فَأْتُوا۟","أَنَّىٰ شِئْتُمْ ۖ وَقَدِّمُوا۟",681],["3:14:16",51,"وَٱلْحَرْثِ ۗ","and [the] tilled land","وَٱلْخَيْلِ ٱلْمُسَوَّمَةِ وَٱلْأَنْعَـٰمِ","ذَٰلِكَ مَتَـٰعُ ٱلْحَيَوٰةِ",681],["3:117:13",65,"حَرْثَ","(the) harvest","فِيهَا صِرٌّ أَصَابَتْ","قَوْمٍۢ ظَلَمُوٓا۟ أَنفُسَهُمْ",681],["6:136:6",145,"ٱلْحَرْثِ","the crops","مِمَّا ذَرَأَ مِنَ","وَٱلْأَنْعَـٰمِ نَصِيبًۭا فَقَالُوا۟",681],["6:138:4",146,"وَحَرْثٌ","and crops","وَقَالُوا۟ هَـٰذِهِۦٓ أَنْعَـٰمٌۭ","حِجْرٌۭ لَّا يَطْعَمُهَآ",681],["21:78:6",328,"ٱلْحَرْثِ","the field","إِذْ يَحْكُمَانِ فِى","إِذْ نَفَشَتْ فِيهِ",681],["42:20:4",485,"حَرْثَ","(the) harvest","مَن كَانَ يُرِيدُ","ٱلْـَٔاخِرَةِ نَزِدْ لَهُۥ",681],["42:20:9",485,"حَرْثِهِۦ ۖ","his harvest","نَزِدْ لَهُۥ فِى","وَمَن كَانَ يُرِيدُ",681],["42:20:13",485,"حَرْثَ","(the) harvest","وَمَن كَانَ يُرِيدُ","ٱلدُّنْيَا نُؤْتِهِۦ مِنْهَا",681],["56:63:3",536,"تَحْرُثُونَ","you sow","أَفَرَءَيْتُم مَّا","",4338],["68:22:4",565,"حَرْثِكُمْ","your crop","أَنِ ٱغْدُوا۟ عَلَىٰ","إِن كُنتُمْ صَـٰرِمِينَ",681]]