[["3:103:17",63,"فَأَصْبَحْتُم","then you became","فَأَلَّفَ بَيْنَ قُلُوبِكُمْ","بِنِعْمَتِهِۦٓ إِخْوَٰنًۭا وَكُنتُمْ",380],["5:30:7",112,"فَأَصْبَحَ","and became","قَتْلَ أَخِيهِ فَقَتَلَهُۥ","مِنَ ٱلْخَـٰسِرِينَ",380],["5:31:23",112,"فَأَصْبَحَ","Then he became","فَأُوَٰرِىَ سَوْءَةَ أَخِى ۖ","مِنَ ٱلنَّـٰدِمِينَ",380],["5:52:22",117,"فَيُصْبِحُوا۟","Then they will become","أَمْرٍۢ مِّنْ عِندِهِۦ","عَلَىٰ مَآ أَسَرُّوا۟",380],["5:53:14",117,"فَأَصْبَحُوا۟","and they became","لَمَعَكُمْ ۚ حَبِطَتْ أَعْمَـٰلُهُمْ","خَـٰسِرِينَ",380],["5:102:7",124,"أَصْبَحُوا۟","they became","مِّن قَبْلِكُمْ ثُمَّ","بِهَا كَـٰفِرِينَ",380],["6:96:2",140,"ٱلْإِصْبَاحِ","(of) the daybreak","فَالِقُ","وَجَعَلَ ٱلَّيْلَ سَكَنًۭا",2922],["7:78:3",160,"فَأَصْبَحُوا۟","then they became","فَأَخَذَتْهُمُ ٱلرَّجْفَةُ","فِى دَارِهِمْ جَـٰثِمِينَ",380],["7:91:3",162,"فَأَصْبَحُوا۟","then they became","فَأَخَذَتْهُمُ ٱلرَّجْفَةُ","فِى دَارِهِمْ جَـٰثِمِينَ",380],["11:67:5",229,"فَأَصْبَحُوا۟","then they became","ٱلَّذِينَ ظَلَمُوا۟ ٱلصَّيْحَةُ","فِى دِيَـٰرِهِمْ جَـٰثِمِينَ",380],["11:81:26",230,"ٱلصُّبْحُ ۚ","(is) morning","أَصَابَهُمْ ۚ إِنَّ مَوْعِدَهُمُ","أَلَيْسَ ٱلصُّبْحُ بِقَرِيبٍۢ",1312],["11:81:28",230,"ٱلصُّبْحُ","the morning","مَوْعِدَهُمُ ٱلصُّبْحُ ۚ أَلَيْسَ","بِقَرِيبٍۢ",1312],["11:94:15",232,"فَأَصْبَحُوا۟","then they became","ٱلَّذِينَ ظَلَمُوا۟ ٱلصَّيْحَةُ","فِى دِيَـٰرِهِمْ جَـٰثِمِينَ",380],["15:66:9",265,"مُّصْبِحِينَ","(by) early morning","دَابِرَ هَـٰٓؤُلَآءِ مَقْطُوعٌۭ","",1360],["15:83:3",266,"مُصْبِحِينَ","(at) early morning","فَأَخَذَتْهُمُ ٱلصَّيْحَةُ","",1360],["18:40:13",298,"فَتُصْبِحَ","then it will become","حُسْبَانًۭا مِّنَ ٱلسَّمَآءِ","صَعِيدًۭا زَلَقًا",380],["18:41:2",298,"يُصْبِحَ","will become","أَوْ","مَآؤُهَا غَوْرًۭا فَلَن",380],["18:42:3",298,"فَأَصْبَحَ","so he began","وَأُحِيطَ بِثَمَرِهِۦ","يُقَلِّبُ كَفَّيْهِ عَلَىٰ",380],["18:45:14",298,"فَأَصْبَحَ","then becomes","بِهِۦ نَبَاتُ ٱلْأَرْضِ","هَشِيمًۭا تَذْرُوهُ ٱلرِّيَـٰحُ ۗ",380],["22:63:9",339,"فَتُصْبِحُ","then becomes","مِنَ ٱلسَّمَآءِ مَآءًۭ","ٱلْأَرْضُ مُخْضَرَّةً ۗ إِنَّ",380],["23:40:4",344,"لَّيُصْبِحُنَّ","surely they will become","قَالَ عَمَّا قَلِيلٍۢ","نَـٰدِمِينَ",380],["24:35:9",354,"مِصْبَاحٌ ۖ","(is) a lamp","نُورِهِۦ كَمِشْكَوٰةٍۢ فِيهَا","ٱلْمِصْبَاحُ فِى زُجَاجَةٍ ۖ",1584],["24:35:10",354,"ٱلْمِصْبَاحُ","the lamp","كَمِشْكَوٰةٍۢ فِيهَا مِصْبَاحٌ ۖ","فِى زُجَاجَةٍ ۖ ٱلزُّجَاجَةُ",1584],["26:157:2",373,"فَأَصْبَحُوا۟","then they became","فَعَقَرُوهَا","نَـٰدِمِينَ",380],["28:10:1",386,"وَأَصْبَحَ","And became","","فُؤَادُ أُمِّ مُوسَىٰ",380],["28:18:1",387,"فَأَصْبَحَ","In the morning he was","","فِى ٱلْمَدِينَةِ خَآئِفًۭا",380],["28:82:1",395,"وَأَصْبَحَ","And began","","ٱلَّذِينَ تَمَنَّوْا۟ مَكَانَهُۥ",380],["29:37:4",400,"فَأَصْبَحُوا۟","and they became","فَكَذَّبُوهُ فَأَخَذَتْهُمُ ٱلرَّجْفَةُ","فِى دَارِهِمْ جَـٰثِمِينَ",380],["30:17:6",406,"تُصْبِحُونَ","you reach the morning","حِينَ تُمْسُونَ وَحِينَ","",380],["37:137:4",451,"مُّصْبِحِينَ","(in the) morning","وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم","",1360],["37:177:5",452,"صَبَاحُ","(the) morning","نَزَلَ بِسَاحَتِهِمْ فَسَآءَ","ٱلْمُنذَرِينَ",3237],["41:12:14",478,"بِمَصَـٰبِيحَ","with lamps","وَزَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا","وَحِفْظًۭا ۚ ذَٰلِكَ تَقْدِيرُ",1584],["41:23:7",479,"فَأَصْبَحْتُم","and you have become","ظَنَنتُم بِرَبِّكُمْ أَرْدَىٰكُمْ","مِّنَ ٱلْخَـٰسِرِينَ",380],["46:25:6",505,"فَأَصْبَحُوا۟","Then they became (such)","شَىْءٍۭ بِأَمْرِ رَبِّهَا","لَا يُرَىٰٓ إِلَّا",380],["49:6:13",516,"فَتُصْبِحُوا۟","then you become","تُصِيبُوا۟ قَوْمًۢا بِجَهَـٰلَةٍۢ","عَلَىٰ مَا فَعَلْتُمْ",380],["54:38:2",530,"صَبَّحَهُم","seized them in the morning","وَلَقَدْ","بُكْرَةً عَذَابٌۭ مُّسْتَقِرٌّۭ",3239],["61:14:34",552,"فَأَصْبَحُوا۟","and they became","ءَامَنُوا۟ عَلَىٰ عَدُوِّهِمْ","ظَـٰهِرِينَ",380],["67:5:5",562,"بِمَصَـٰبِيحَ","with lamps","زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا","وَجَعَلْنَـٰهَا رُجُومًۭا لِّلشَّيَـٰطِينِ ۖ",1584],["67:30:4",564,"أَصْبَحَ","becomes","قُلْ أَرَءَيْتُمْ إِنْ","مَآؤُكُمْ غَوْرًۭا فَمَن",380],["68:17:10",565,"مُصْبِحِينَ","(in the) morning","إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا","",1360],["68:20:1",565,"فَأَصْبَحَتْ","So it became","","كَٱلصَّرِيمِ",380],["68:21:2",565,"مُصْبِحِينَ","(at) morning","فَتَنَادَوْا۟","",1360],["74:34:1",576,"وَٱلصُّبْحِ","And the morning","","إِذَآ أَسْفَرَ",1312],["81:18:1",586,"وَٱلصُّبْحِ","And the dawn","","إِذَا تَنَفَّسَ",1312],["100:3:2",599,"صُبْحًۭا","(at) dawn","فَٱلْمُغِيرَٰتِ","",1312]]