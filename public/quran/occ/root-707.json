[["2:18:2",4,"بُكْمٌ","dumb","صُمٌّۢ","عُمْىٌۭ فَهُمْ لَا",1135],["2:171:14",26,"بُكْمٌ","dumb","دُعَآءًۭ وَنِدَآءًۭ ۚ صُمٌّۢ","عُمْىٌۭ فَهُمْ لَا",1135],["6:39:5",132,"وَبُكْمٌۭ","and dumb","كَذَّبُوا۟ بِـَٔايَـٰتِنَا صُمٌّۭ","فِى ٱلظُّلُمَـٰتِ ۗ مَن",1135],["8:22:7",179,"ٱلْبُكْمُ","the dumb","عِندَ ٱللَّهِ ٱلصُّمُّ","ٱلَّذِينَ لَا يَعْقِلُونَ",1135],["16:76:6",275,"أَبْكَمُ","(is) dumb","مَثَلًۭا رَّجُلَيْنِ أَحَدُهُمَآ","لَا يَقْدِرُ عَلَىٰ",1135],["17:97:20",292,"وَبُكْمًۭا","and dumb","عَلَىٰ وُجُوهِهِمْ عُمْيًۭا","وَصُمًّۭا ۖ مَّأْوَىٰهُمْ جَهَنَّمُ ۖ",1135]]