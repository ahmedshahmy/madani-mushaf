َّهُ سَيِّـَٔاتِ مَا",607],["41:18:5",478,"يَتَّقُونَ","fear (Allah)","ٱلَّذِينَ ءَامَنُوا۟ وَكَانُوا۟","",67],["43:35:12",492,"لِلْمُتَّقِينَ","(is) for the righteous","وَٱلْـَٔاخِرَةُ عِندَ رَبِّكَ","",244],["43:63:15",494,"فَٱتَّقُوا۟","So fear","ٱلَّذِى تَخْتَلِفُونَ فِيهِ ۖ","ٱللَّهَ وَأَطِيعُونِ",67],["43:67:7",494,"ٱلْمُتَّقِينَ","the righteous","لِبَعْضٍ عَدُوٌّ إِلَّا","",244],["44:51:2",498,"ٱلْمُتَّقِينَ","the righteous","إِنَّ","فِى مَقَامٍ أَمِينٍۢ",244],["44:56:8",498,"وَوَقَىٰهُمْ","And He will protect them","إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰ ۖ","عَذَابَ ٱلْجَحِيمِ",607],["45:19:15",500,"ٱلْمُتَّقِينَ","(of) the righteous","بَعْضٍۢ ۖ وَٱللَّهُ وَلِىُّ","",244],["47:15:5",508,"ٱلْمُتَّقُونَ ۖ","(to) the righteous","ٱلْجَنَّةِ ٱلَّتِى وُعِدَ","فِيهَآ أَنْهَـٰرٌۭ مِّن",244],["47:17:6",508,"تَقْوَىٰهُمْ","their righteousness","زَادَهُمْ هُدًۭى وَءَاتَىٰهُمْ","",580],["47:36:8",510,"وَتَتَّقُوا۟","and fear (Allah)","وَلَهْوٌۭ ۚ وَإِن تُؤْمِنُوا۟","يُؤْتِكُمْ أُجُورَكُمْ وَلَا",67],["48:26:19",514,"ٱلتَّقْوَىٰ","(of) righteousness","ٱلْمُؤْمِنِينَ وَأَلْزَمَهُمْ كَلِمَةَ","وَكَانُوٓا۟ أَحَقَّ بِهَا",580],["49:1:10",515,"وَٱتَّقُوا۟","and fear Allah","يَدَىِ ٱللَّهِ وَرَسُولِهِۦ ۖ","ٱللَّهَ ۚ إِنَّ ٱللَّهَ",67],["49:3:13",515,"لِلتَّقْوَىٰ ۚ","for righteousness","ٱمْتَحَنَ ٱللَّهُ قُلُوبَهُمْ","لَهُم مَّغْفِرَةٌۭ وَأَجْرٌ",580],["49:10:7",516,"وَٱتَّقُوا۟","and fear Allah","فَأَصْلِحُوا۟ بَيْنَ أَخَوَيْكُمْ ۚ","ٱللَّهَ لَعَلَّكُمْ تُرْحَمُونَ",67],["49:12:26",517,"وَٱتَّقُوا۟","And fear Allah","أَخِيهِ مَيْتًۭا فَكَرِهْتُمُوهُ ۚ","ٱللَّهَ ۚ إِنَّ ٱللَّهَ",67],["49:13:16",517,"أَتْقَىٰكُمْ ۚ","(is the) most righteous of you","أَكْرَمَكُمْ عِندَ ٱللَّهِ","إِنَّ ٱللَّهَ عَلِيمٌ",2195],["50:31:3",519,"لِلْمُتَّقِينَ","to the righteous","وَأُزْلِفَتِ ٱلْجَنَّةُ","غَيْرَ بَعِيدٍ",244],["51:15:2",521,"ٱلْمُتَّقِينَ","the righteous","إِنَّ","فِى جَنَّـٰتٍۢ وَعُيُونٍ",244],["52:17:2",524,"ٱلْمُتَّقِينَ","the righteous","إِنَّ","فِى جَنَّـٰتٍۢ وَنَعِيمٍۢ",244],["52:18:5",524,"وَوَقَىٰهُمْ","and protected them","بِمَآ ءَاتَىٰهُمْ رَبُّهُمْ","رَبُّهُمْ عَذَابَ ٱلْجَحِيمِ",607],["52:27:4",524,"وَوَقَىٰنَا","and protected us","فَمَنَّ ٱللَّهُ عَلَيْنَا","عَذَابَ ٱلسَّمُومِ",607],["53:32:31",527,"ٱتَّقَىٰٓ","fears","هُوَ أَعْلَمُ بِمَنِ","",67],["54:54:2",531,"ٱلْمُتَّقِينَ","the righteous","إِنَّ","فِى جَنَّـٰتٍۢ وَنَهَرٍۢ",244],["57:28:4",541,"ٱتَّقُوا۟","Fear","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","ٱللَّهَ وَءَامِنُوا۟ بِرَسُولِهِۦ",67],["58:9:14",543,"وَٱلتَّقْوَىٰ ۖ","and piety","ٱلرَّسُولِ وَتَنَـٰجَوْا۟ بِٱلْبِرِّ","وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ",580],["58:9:15",543,"وَٱتَّقُوا۟","And fear","وَتَنَـٰجَوْا۟ بِٱلْبِرِّ وَٱلتَّقْوَىٰ ۖ","ٱللَّهَ ٱلَّذِىٓ إِلَيْهِ",67],["59:7:32",546,"وَٱتَّقُوا۟","And fear","نَهَىٰكُمْ عَنْهُ فَٱنتَهُوا۟ ۚ","ٱللَّهَ ۖ إِنَّ ٱللَّهَ",67],["59:9:26",546,"يُوقَ","is saved","بِهِمْ خَصَاصَةٌۭ ۚ وَمَن","شُحَّ نَفْسِهِۦ فَأُو۟لَـٰٓئِكَ",607],["59:18:4",548,"ٱتَّقُوا۟","Fear","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","ٱللَّهَ وَلْتَنظُرْ نَفْسٌۭ",67],["59:18:11",548,"وَٱتَّقُوا۟","and fear","مَّا قَدَّمَتْ لِغَدٍۢ ۖ","ٱللَّهَ ۚ إِنَّ ٱللَّهَ",67],["60:11:16",550,"وَٱتَّقُوا۟","And fear","مِّثْلَ مَآ أَنفَقُوا۟ ۚ","ٱللَّهَ ٱلَّذِىٓ أَنتُم",67],["64:16:1",557,"فَٱتَّقُوا۟","So fear","","ٱللَّهَ مَا ٱسْتَطَعْتُمْ",67],["64:16:11",557,"يُوقَ","is saved","خَيْرًۭا لِّأَنفُسِكُمْ ۗ وَمَن","شُحَّ نَفْسِهِۦ فَأُو۟لَـٰٓئِكَ",607],["65:1:10",558,"وَٱتَّقُوا۟","and fear","لِعِدَّتِهِنَّ وَأَحْصُوا۟ ٱلْعِدَّةَ ۖ","ٱللَّهَ رَبَّكُمْ ۖ لَا",67],["65:2:26",558,"يَتَّقِ","fears","وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۚ وَمَن","ٱللَّهَ يَجْعَل لَّهُۥ",67],["65:4:22",558,"يَتَّقِ","fears","يَضَعْنَ حَمْلَهُنَّ ۚ وَمَن","ٱللَّهَ يَجْعَل لَّهُۥ",67],["65:5:7",558,"يَتَّقِ","fears","أَنزَلَهُۥٓ إِلَيْكُمْ ۚ وَمَن","ٱللَّهَ يُكَفِّرْ عَنْهُ",67],["65:10:6",559,"فَٱتَّقُوا۟","So fear","لَهُمْ عَذَابًۭا شَدِيدًۭا ۖ","ٱللَّهَ يَـٰٓأُو۟لِى ٱلْأَلْبَـٰبِ",67],["66:6:4",560,"قُوٓا۟","Protect","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","أَنفُسَكُمْ وَأَهْلِيكُمْ نَارًۭا",607],["68:34:2",565,"لِلْمُتَّقِينَ","for the righteous","إِنَّ","عِندَ رَبِّهِمْ جَنَّـٰتِ",244],["69:48:3",568,"لِّلْمُتَّقِينَ","for the Allah-fearing","وَإِنَّهُۥ لَتَذْكِرَةٌۭ","",244],["71:3:4",570,"وَٱتَّقُوهُ","and fear Him","أَنِ ٱعْبُدُوا۟ ٱللَّهَ","وَأَطِيعُونِ",67],["73:17:2",574,"تَتَّقُونَ","will you guard yourselves","فَكَيْفَ","إِن كَفَرْتُمْ يَوْمًۭا",67],["74:56:9",577,"ٱلتَّقْوَىٰ","to be feared","ٱللَّهُ ۚ هُوَ أَهْلُ","وَأَهْلُ ٱلْمَغْفِرَةِ",580],["76:11:1",579,"فَوَقَىٰهُمُ","But will protect them","","ٱللَّهُ شَرَّ ذَٰلِكَ",607],["77:41:2",581,"ٱلْمُتَّقِينَ","the righteous","إِنَّ","فِى ظِلَـٰلٍۢ وَعُيُونٍۢ",244],["78:31:2",583,"لِلْمُتَّقِينَ","for the righteous","إِنَّ","مَفَازًا",244],["91:8:3",595,"وَتَقْوَىٰهَا","and its righteousness","فَأَلْهَمَهَا فُجُورَهَا","",580],["92:5:4",595,"وَٱتَّقَىٰ","and fears","فَأَمَّا مَنْ أَعْطَىٰ","",67],["92:17:2",596,"ٱلْأَتْقَى","the righteous","وَسَيُجَنَّبُهَا","",2195],["96:12:3",597,"بِٱلتَّقْوَىٰٓ","[of the] righteousness","أَوْ أَمَرَ","",580]]