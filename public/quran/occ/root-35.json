16:81:18",276,"تَقِيكُم","to protect you","تَقِيكُمُ ٱلْحَرَّ وَسَرَٰبِيلَ","بَأْسَكُمْ ۚ كَذَٰلِكَ يُتِمُّ",607],["16:128:5",281,"ٱتَّقَوا۟","fear (Him)","ٱللَّهَ مَعَ ٱلَّذِينَ","وَّٱلَّذِينَ هُم مُّحْسِنُونَ",67],["19:13:6",306,"تَقِيًّۭا","righteous","لَّدُنَّا وَزَكَوٰةًۭ ۖ وَكَانَ","",1651],["19:18:8",306,"تَقِيًّۭا","God fearing","مِنكَ إِن كُنتَ","",1651],["19:63:9",309,"تَقِيًّۭا","righteous","عِبَادِنَا مَن كَانَ","",1651],["19:72:4",310,"ٱتَّقَوا۟","feared (Allah)","ثُمَّ نُنَجِّى ٱلَّذِينَ","وَّنَذَرُ ٱلظَّـٰلِمِينَ فِيهَا",67],["19:85:3",311,"ٱلْمُتَّقِينَ","the righteous","يَوْمَ نَحْشُرُ","إِلَى ٱلرَّحْمَـٰنِ وَفْدًۭا",244],["19:97:6",312,"ٱلْمُتَّقِينَ","(to) the righteous","بِلِسَانِكَ لِتُبَشِّرَ بِهِ","وَتُنذِرَ بِهِۦ قَوْمًۭا",244],["20:113:10",319,"يَتَّقُونَ","fear","مِنَ ٱلْوَعِيدِ لَعَلَّهُمْ","أَوْ يُحْدِثُ لَهُمْ",67],["20:132:12",321,"لِلتَّقْوَىٰ","(is) for the righteous[ness]","نَّحْنُ نَرْزُقُكَ ۗ وَٱلْعَـٰقِبَةُ","",580],["21:48:8",326,"لِّلْمُتَّقِينَ","for the righteous","ٱلْفُرْقَانَ وَضِيَآءًۭ وَذِكْرًۭا","",244],["22:1:3",332,"ٱتَّقُوا۟","Fear","يَـٰٓأَيُّهَا ٱلنَّاسُ","رَبَّكُمْ ۚ إِنَّ زَلْزَلَةَ",67],["22:32:8",336,"تَقْوَى","(the) piety","ٱللَّهِ فَإِنَّهَا مِن","ٱلْقُلُوبِ",580],["22:37:9",336,"ٱلتَّقْوَىٰ","the piety","دِمَآؤُهَا وَلَـٰكِن يَنَالُهُ","مِنكُمْ ۚ كَذَٰلِكَ سَخَّرَهَا",580],["23:23:16",343,"تَتَّقُونَ","you fear","إِلَـٰهٍ غَيْرُهُۥٓ ۖ أَفَلَا","",67],["23:32:14",344,"تَتَّقُونَ","you fear","إِلَـٰهٍ غَيْرُهُۥٓ ۖ أَفَلَا","",67],["23:52:8",345,"فَٱتَّقُونِ","so fear Me","وَٰحِدَةًۭ وَأَنَا۠ رَبُّكُمْ","",67],["23:87:5",347,"تَتَّقُونَ","you fear (Him)","لِلَّهِ ۚ قُلْ أَفَلَا","",67],["24:34:13",354,"لِّلْمُتَّقِينَ","for those who fear (Allah)","مِن قَبْلِكُمْ وَمَوْعِظَةًۭ","",244],["24:52:7",356,"وَيَتَّقْهِ","and (is) conscious of Him","وَرَسُولَهُۥ وَيَخْشَ ٱللَّهَ","فَأُو۟لَـٰٓئِكَ هُمُ ٱلْفَآئِزُونَ",67],["25:15:9",361,"ٱلْمُتَّقُونَ ۚ","(to) the righteous","ٱلْخُلْدِ ٱلَّتِى وُعِدَ","كَانَتْ لَهُمْ جَزَآءًۭ",244],["25:74:12",366,"لِلْمُتَّقِينَ","for the righteous","قُرَّةَ أَعْيُنٍۢ وَٱجْعَلْنَا","إِمَامًا",244],["26:11:4",367,"يَتَّقُونَ","they fear","قَوْمَ فِرْعَوْنَ ۚ أَلَا","",67],["26:90:3",371,"لِلْمُتَّقِينَ","for the righteous","وَأُزْلِفَتِ ٱلْجَنَّةُ","",244],["26:106:7",371,"تَتَّقُونَ","you fear (Allah)","أَخُوهُمْ نُوحٌ أَلَا","",67],["26:108:1",371,"فَٱتَّقُوا۟","So fear","","ٱللَّهَ وَأَطِيعُونِ",67],["26:110:1",371,"فَٱتَّقُوا۟","So fear","","ٱللَّهَ وَأَطِيعُونِ",67],["26:124:7",372,"تَتَّقُونَ","you fear (Allah)","أَخُوهُمْ هُودٌ أَلَا","",67],["26:126:1",372,"فَٱتَّقُوا۟","So fear","","ٱللَّهَ وَأَطِيعُونِ",67],["26:131:1",372,"فَٱتَّقُوا۟","So fear","","ٱللَّهَ وَأَطِيعُونِ",67],["26:132:1",372,"وَٱتَّقُوا۟","And fear","","ٱلَّذِىٓ أَمَدَّكُم بِمَا",67],["26:142:7",373,"تَتَّقُونَ","you fear (Allah)","أَخُوهُمْ صَـٰلِحٌ أَلَا","",67],["26:144:1",373,"فَٱتَّقُوا۟","So fear","","ٱللَّهَ وَأَطِيعُونِ",67],["26:150:1",373,"فَٱتَّقُوا۟","So fear","","ٱللَّهَ وَأَطِيعُونِ",67],["26:161:7",374,"تَتَّقُونَ","you fear (Allah)","أَخُوهُمْ لُوطٌ أَلَا","",67],["26:163:1",374,"فَٱتَّقُوا۟","So fear","","ٱللَّهَ وَأَطِيعُونِ",67],["26:177:6",374,"تَتَّقُونَ","you fear (Allah)","لَهُمْ شُعَيْبٌ أَلَا","",67],["26:179:1",374,"فَٱتَّقُوا۟","So fear","","ٱللَّهَ وَأَطِيعُونِ",67],["26:184:1",375,"وَٱتَّقُوا۟","And fear","","ٱلَّذِى خَلَقَكُمْ وَٱلْجِبِلَّةَ",67],["27:53:5",381,"يَتَّقُونَ","fear (Allah)","ٱلَّذِينَ ءَامَنُوا۟ وَكَانُوا۟","",67],["28:83:14",395,"لِلْمُتَّقِينَ","(is) for the righteous","وَلَا فَسَادًۭا ۚ وَٱلْعَـٰقِبَةُ","",244],["29:16:7",398,"وَٱتَّقُوهُ ۖ","and fear Him","لِقَوْمِهِ ٱعْبُدُوا۟ ٱللَّهَ","ذَٰلِكُمْ خَيْرٌۭ لَّكُمْ",67],["30:31:3",407,"وَٱتَّقُوهُ","and fear Him","۞ مُنِيبِينَ إِلَيْهِ","وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَلَا",67],["31:33:3",414,"ٱتَّقُوا۟","Fear","يَـٰٓأَيُّهَا ٱلنَّاسُ","رَبَّكُمْ وَٱخْشَوْا۟ يَوْمًۭا",67],["33:1:3",418,"ٱتَّقِ","Fear","يَـٰٓأَيُّهَا ٱلنَّبِىُّ","ٱللَّهَ وَلَا تُطِعِ",67],["33:32:8",422,"ٱتَّقَي