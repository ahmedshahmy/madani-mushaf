[["2:2:7",2,"لِّلْمُتَّقِينَ","for the God-conscious","رَيْبَ ۛ فِيهِ ۛ هُدًۭى","",244],["2:21:11",4,"تَتَّقُونَ","become righteous","مِن قَبْلِكُمْ لَعَلَّكُمْ","",67],["2:24:6",4,"فَٱتَّقُوا۟","then fear","تَفْعَلُوا۟ وَلَن تَفْعَلُوا۟","ٱلنَّارَ ٱلَّتِى وَقُودُهَا",67],["2:41:18",7,"فَٱتَّقُونِ","fear [Me]","ثَمَنًۭا قَلِيلًۭا وَإِيَّـٰىَ","",67],["2:48:1",7,"وَٱتَّقُوا۟","And fear","","يَوْمًۭا لَّا تَجْزِى",67],["2:63:15",10,"تَتَّقُونَ","(would become) righteous","مَا فِيهِ لَعَلَّكُمْ","",67],["2:66:9",10,"لِّلْمُتَّقِينَ","for those who fear (Allah)","وَمَا خَلْفَهَا وَمَوْعِظَةًۭ","",244],["2:103:4",16,"وَٱتَّقَوْا۟","and feared (Allah)","وَلَوْ أَنَّهُمْ ءَامَنُوا۟","لَمَثُوبَةٌۭ مِّنْ عِندِ",67],["2:123:1",19,"وَٱتَّقُوا۟","And fear","","يَوْمًۭا لَّا تَجْزِى",67],["2:177:51",27,"ٱلْمُتَّقُونَ","(are) the righteous","صَدَقُوا۟ ۖ وَأُو۟لَـٰٓئِكَ هُمُ","",244],["2:179:8",27,"تَتَّقُونَ","(become) righteous","يَـٰٓأُو۟لِى ٱلْأَلْبَـٰبِ لَعَلَّكُمْ","",67],["2:180:16",27,"ٱلْمُتَّقِينَ","the righteous ones","بِٱلْمَعْرُوفِ ۖ حَقًّا عَلَى","",244],["2:183:14",28,"تَتَّقُونَ","(become) righteous","مِن قَبْلِكُمْ لَعَلَّكُمْ","",67],["2:187:65",29,"يَتَّقُونَ","(become) righteous","ءَايَـٰتِهِۦ لِلنَّاسِ لَعَلَّهُمْ","",67],["2:189:19",29,"ٱتَّقَىٰ ۗ","fears (Allah)","وَلَـٰكِنَّ ٱلْبِرَّ مَنِ","وَأْتُوا۟ ٱلْبُيُوتَ مِنْ",67],["2:189:24",29,"وَٱتَّقُوا۟","And fear","ٱلْبُيُوتَ مِنْ أَبْوَٰبِهَا ۚ","ٱللَّهَ لَعَلَّكُمْ تُفْلِحُونَ",67],["2:194:16",30,"وَٱتَّقُوا۟","And fear","مَا ٱعْتَدَىٰ عَلَيْكُمْ ۚ","ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّ",67],["2:194:22",30,"ٱلْمُتَّقِينَ","those who fear (Him)","أَنَّ ٱللَّهَ مَعَ","",244],["2:196:67",30,"وَٱتَّقُوا۟","And fear","حَاضِرِى ٱلْمَسْجِدِ ٱلْحَرَامِ ۚ","ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّ",67],["2:197:26",31,"ٱلتَّقْوَىٰ ۚ","(is) righteousness","فَإِنَّ خَيْرَ ٱلزَّادِ","وَٱتَّقُونِ يَـٰٓأُو۟لِى ٱلْأَلْبَـٰبِ",580],["2:197:27",31,"وَٱتَّقُونِ","And fear Me","خَيْرَ ٱلزَّادِ ٱلتَّقْوَىٰ ۚ","يَـٰٓأُو۟لِى ٱلْأَلْبَـٰبِ",67],["2:201:12",31,"وَقِنَا","and save us","وَفِى ٱلْـَٔاخِرَةِ حَسَنَةًۭ","عَذَابَ ٱلنَّارِ",607],["2:203:19",32,"ٱتَّقَىٰ ۗ","fears","إِثْمَ عَلَيْهِ ۚ لِمَنِ","وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟",67],["2:203:20",32,"وَٱتَّقُوا۟","And fear","عَلَيْهِ ۚ لِمَنِ ٱتَّقَىٰ ۗ","ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّكُمْ",67],["2:206:4",32,"ٱتَّقِ","Fear","وَإِذَا قِيلَ لَهُ","ٱللَّهَ أَخَذَتْهُ ٱلْعِزَّةُ",67],["2:212:11",33,"ٱتَّقَوْا۟","fear (Allah)","ٱلَّذِينَ ءَامَنُوا۟ ۘ وَٱلَّذِينَ","فَوْقَهُمْ يَوْمَ ٱلْقِيَـٰمَةِ ۗ",67],["2:223:10",35,"وَٱتَّقُوا۟","And be conscious","شِئْتُمْ ۖ وَقَدِّمُوا۟ لِأَنفُسِكُمْ ۚ","ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّكُم",67],["2:224:8",35,"وَتَتَّقُوا۟","and be righteous","لِّأَيْمَـٰنِكُمْ أَن تَبَرُّوا۟","وَتُصْلِحُوا۟ بَيْنَ ٱلنَّاسِ ۗ",67],["2:231:38",37,"وَٱتَّقُوا۟","And fear","وَٱلْحِكْمَةِ يَعِظُكُم بِهِۦ ۚ","ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّ",67],["2:233:57",37,"وَٱتَّقُوا۟","And fear","مَّآ ءَاتَيْتُم بِٱلْمَعْرُوفِ ۗ","ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّ",67],["2:237:26",38,"لِلتَّقْوَىٰ ۚ","to [the] righteousness","وَأَن تَعْفُوٓا۟ أَقْرَبُ","وَلَا تَنسَوُا۟ ٱلْفَضْلَ",580],["2:241:6",39,"ٱلْمُتَّقِينَ","the righteous","بِٱلْمَعْرُوفِ ۖ حَقًّا عَلَى","",244],["2:278:4",47,"ٱتَّقُوا۟","Fear","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","ٱللَّهَ وَذَرُوا۟ مَا",67],["2:281:1",47,"وَٱتَّقُوا۟","And fear","","يَوْمًۭا تُرْجَعُونَ فِيهِ",67],["2:282:28",48,"وَلْيَتَّقِ","and let him fear","ٱلَّذِى عَلَيْهِ ٱلْحَقُّ","ٱللَّهَ رَبَّهُۥ وَلَا",67],["2:282:121",48,"وَٱتَّقُوا۟","and fear","فَإِنَّهُۥ فُسُوقٌۢ بِكُمْ ۗ","ٱللَّهَ ۖ وَيُعَلِّمُكُمُ ٱللَّهُ ۗ",67],["2:283:18",49,"وَلْيَتَّقِ","And let him fear","ٱلَّذِى ٱؤْتُمِنَ أَمَـٰنَتَهُۥ","ٱللَّهَ رَبَّهُۥ ۗ وَلَا",67],["3:15:7",51,"ٱتَّقَوْا۟","fear[ed]","مِّن ذَٰلِكُمْ ۚ لِلَّذِينَ","عِندَ رَبِّهِمْ جَنَّـٰتٌۭ",67],["3:16:9",52,"وَقِنَا","and save us","فَٱغْفِرْ لَنَا ذُنُوبَنَا","عَذَابَ ٱلنَّارِ",607],["3:28:19",53,"تَتَّقُوا۟","you fear","شَىْءٍ إِلَّآ أَن","مِنْهُمْ تُقَىٰةًۭ ۗ وَيُحَذِّرُكُمُ",67],["3:28:21",53,"تُقَىٰةًۭ ۗ","(as) a precaution","أَن تَتَّقُوا۟ مِنْهُمْ","وَيُحَذِّرُكُمُ ٱللَّهُ نَفْسَهُۥ ۗ",4465],["3:50:17",56,"فَٱتَّقُوا۟","So fear","بِـَٔايَةٍۢ مِّن رَّبِّكُمْ","ٱللَّهَ وَأَطِيعُونِ",67],["3:76:5",59,"وَٱتَّقَىٰ","and fears (Allah)","مَنْ أَوْفَىٰ بِعَهْدِهِۦ","فَإِنَّ ٱللَّهَ يُحِبُّ",67],["3:76:9",59,"ٱلْمُتَّقِينَ","those who fear (Him)","فَإِنَّ ٱللَّهَ يُحِبُّ","",244],["3:102:4",63,"ٱتَّقُوا۟","Fear","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","ٱللَّهَ حَقَّ تُقَاتِهِۦ",67],["3:102:7",63,"تُقَاتِهِۦ","(that) He (should) be feared","ٱتَّقُوا۟ ٱللَّهَ حَقَّ","وَلَا تَمُوتُنَّ إِلَّا",1651],["3:115:9",64,"بِٱلْمُتَّقِينَ","of the God-fearing","يُكْفَرُوهُ ۗ وَٱللَّهُ عَلِيمٌۢ","",244],["3:120:12",65,"وَتَتَّقُوا۟","and fear (Allah)","بِهَا ۖ وَإِن تَصْبِرُوا۟","لَا يَضُرُّكُمْ كَيْدُهُمْ",67],["3:123:7",66,"فَٱتَّقُوا۟","So fear","بِبَدْرٍۢ وَأَنتُمْ أَذِلَّةٌۭ ۖ","ٱللَّهَ لَعَلَّكُمْ تَشْكُرُونَ",67],["3:125:4",66,"وَتَتَّقُوا۟","and fear (Allah)","بَلَىٰٓ ۚ إِن تَصْبِرُوا۟","وَيَأْتُوكُم مِّن فَوْرِهِمْ",67],["3:130:9",66,"وَٱتَّقُوا۟","And fear","ٱلرِّبَوٰٓا۟ أَضْعَـٰفًۭا مُّضَـٰعَفَةًۭ ۖ","ٱللَّهَ لَعَلَّكُمْ تُفْلِحُونَ",67],["3:131:1",66,"وَٱتَّقُوا۟","And fear","","ٱلنَّارَ ٱلَّتِىٓ أُعِدَّتْ",67],["3:133:11",67,"لِلْمُتَّقِينَ","for the pious","ٱلسَّمَـٰوَٰتُ وَٱلْأَرْضُ أُعِدَّتْ","",244],["3:138:6",67,"لِّلْمُتَّقِينَ","for the God-fearing","لِّلنَّاسِ وَهُدًۭى وَمَوْعِظَةٌۭ","",244],["3:172:13",72,"وَٱتَّقَوْا۟","and feared Allah","لِلَّذِينَ أَحْسَنُوا۟ مِنْهُمْ","أَجْرٌ عَظِيمٌ",67],["3:179:33",73,"وَتَتَّقُوا۟","and fear (Allah)","وَرُسُلِهِۦ ۚ وَإِن تُؤْمِنُوا۟","فَلَكُمْ أَجْرٌ عَظِيمٌۭ",67],["3:186:19",74,"وَتَتَّقُوا۟","and fear (Allah)","كَثِيرًۭا ۚ وَإِن تَصْبِرُوا۟","فَإِنَّ ذَٰلِكَ مِنْ",67],["3:191:19",75,"فَقِنَا","so save us","هَـٰذَا بَـٰطِلًۭا سُبْحَـٰنَكَ","عَذَابَ ٱلنَّارِ",607],["3:198:3",76,"ٱتَّقَوْا۟","fear","لَـٰكِنِ ٱلَّذِينَ","رَبَّهُمْ لَهُمْ جَنَّـٰتٌۭ",67],["3:200:7",76,"وَٱتَّقُوا۟","and fear","ٱصْبِرُوا۟ وَصَابِرُوا۟ وَرَابِطُوا۟","ٱللَّهَ لَعَلَّكُمْ تُفْلِحُونَ",67],["4:1:3",77,"ٱتَّقُوا۟","Fear","يَـٰٓأَيُّهَا ٱلنَّاسُ","رَبَّكُمُ ٱلَّذِى خَلَقَكُم",67],["4:1:18",77,"وَٱتَّقُوا۟","And fear","رِجَالًۭا كَثِيرًۭا وَنِسَآءًۭ ۚ","ٱللَّهَ ٱلَّذِى تَسَآءَلُونَ",67],["4:9:11",78,"فَلْيَتَّقُوا۟","So let them fear","ضِعَـٰفًا خَافُوا۟ عَلَيْهِمْ","ٱللَّهَ وَلْيَقُولُوا۟ قَوْلًۭا",67],["4:77:45",90,"ٱتَّقَىٰ","fears (Allah)","وَٱلْـَٔاخِرَةُ خَيْرٌۭ لِّمَنِ","وَلَا تُظْلَمُونَ فَتِيلًا",67],["4:128:23",99,"وَتَتَّقُوا۟","and fear (Allah)","ٱلشُّحَّ ۚ وَإِن تُحْسِنُوا۟","فَإِنَّ ٱللَّهَ كَانَ",67],["4:129:17",99,"وَتَتَّقُوا۟","and fear (Allah)","كَٱلْمُعَلَّقَةِ ۚ وَإِن تُصْلِحُوا۟","فَإِنَّ ٱللَّهَ كَانَ",67],["4:131:17",99,"ٱتَّقُوا۟","you fear","قَبْلِكُمْ وَإِيَّاكُمْ أَنِ","ٱللَّهَ ۚ وَإِن تَكْفُرُوا۟",67],["5:2:41",106,"وَٱلتَّقْوَىٰ ۖ","and [the] piety","وَتَعَاوَنُوا۟ عَلَى ٱلْبِرِّ","وَلَا تَعَاوَنُوا۟ عَلَى",580],["5:2:47",106,"وَٱتَّقُوا۟","And fear","عَلَى ٱلْإِثْمِ وَٱلْعُدْوَٰنِ ۚ","ٱللَّهَ ۖ إِنَّ ٱللَّهَ",67],["5:4:26",107,"وَٱتَّقُوا۟","and fear","ٱسْمَ ٱللَّهِ عَلَيْهِ ۖ","ٱللَّهَ ۚ إِنَّ ٱللَّهَ",67],["5:7:13",108,"وَٱتَّقُوا۟","and fear","قُلْتُمْ سَمِعْنَا وَأَطَعْنَا ۖ","ٱللَّهَ ۚ إِنَّ ٱللَّهَ",67],["5:8:19",108,"لِلتَّقْوَىٰ ۖ","to [the] piety","ٱعْدِلُوا۟ هُوَ أَقْرَبُ","وَٱتَّقُوا۟ ٱللَّهَ ۚ إِنَّ",580],["5:8:20",108,"وَٱتَّقُوا۟","And fear","هُوَ أَقْرَبُ لِلتَّقْوَىٰ ۖ","ٱللَّهَ ۚ إِنَّ ٱللَّهَ",67],["5:11:18",109,"وَٱتَّقُوا۟","And fear","فَكَفَّ أَيْدِيَهُمْ عَنكُمْ ۖ","ٱللَّهَ ۚ وَعَلَى ٱللَّهِ",67],["5:27:24",112,"ٱلْمُتَّقِينَ","the God fearing","يَتَقَبَّلُ ٱللَّهُ مِنَ","",244],["5:35:4",113,"ٱتَّقُوا۟","Fear","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","ٱللَّهَ وَٱبْتَغُوٓا۟ إِلَيْهِ",67],["5:46:26",116,"لِّلْمُتَّقِينَ","for the God conscious","ٱلتَّوْرَىٰةِ وَهُدًۭى وَمَوْعِظَةًۭ","",244],["5:57:19",117,"وَٱتَّقُوا۟","And fear","قَبْلِكُمْ وَٱلْكُفَّارَ أَوْلِيَآءَ ۚ","ٱللَّهَ إِن كُنتُم",67],["5:65:6",119,"وَٱتَّقَوْا۟","and feared (Allah)","أَهْلَ ٱلْكِتَـٰبِ ءَامَنُوا۟","لَكَفَّرْنَا عَنْهُمْ سَيِّـَٔاتِهِمْ",67],["5:88:7",122,"وَٱتَّقُوا۟","And fear","ٱللَّهُ حَلَـٰلًۭا طَيِّبًۭا ۚ","ٱللَّهَ ٱلَّذِىٓ أَنتُم",67],["5:93:12",123,"ٱتَّقَوا۟","they fear (Allah)","طَعِمُوٓا۟ إِذَا مَا","وَّءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ",67],["5:93:17",123,"ٱتَّقَوا۟","they fear (Allah)","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ ثُمَّ","وَّءَامَنُوا۟ ثُمَّ ٱتَّقَوا۟",67],["5:93:20",123,"ٱتَّقَوا۟","they fear (Allah)","ٱتَّقَوا۟ وَّءَامَنُوا۟ ثُمَّ","وَّأَحْسَنُوا۟ ۗ وَٱللَّهُ يُحِبُّ",67],["5:96:16",124,"وَٱتَّقُوا۟","And be conscious","مَا دُمْتُمْ حُرُمًۭا ۗ","ٱللَّهَ ٱلَّذِىٓ إِلَيْهِ",67],["5:100:10",124,"فَٱتَّقُوا۟","So fear","أَعْجَبَكَ كَثْرَةُ ٱلْخَبِيثِ ۚ","ٱللَّهَ يَـٰٓأُو۟لِى ٱلْأَلْبَـٰبِ",67],["5:108:15",125,"وَٱتَّقُوا۟","And fear","أَيْمَـٰنٌۢ بَعْدَ أَيْمَـٰنِهِمْ ۗ","ٱللَّهَ وَٱسْمَعُوا۟ ۗ وَٱللَّهُ",67],["5:112:17",126,"ٱتَّقُوا۟","Fear","مِّنَ ٱلسَّمَآءِ ۖ قَالَ","ٱللَّهَ إِن كُنتُم",67],["6:32:11",131,"يَتَّقُونَ ۗ","(are) God conscious","ٱلْـَٔاخِرَةُ خَيْرٌۭ لِّلَّذِينَ","أَفَلَا تَعْقِلُونَ",67],["6:51:17",133,"يَتَّقُونَ","(become) righteous","وَلَا شَفِيعٌۭ لَّعَلَّهُمْ","",67],["6:69:4",136,"يَتَّقُونَ","fear (Allah)","وَمَا عَلَى ٱلَّذِينَ","مِنْ حِسَابِهِم مِّن",67],["6:69:12",136,"يَتَّقُونَ","fear (Allah)","وَلَـٰكِن ذِكْرَىٰ لَعَلَّهُمْ","",67],["6:72:4",136,"وَٱتَّقُوهُ ۚ","and fear Him","وَأَنْ أَقِيمُوا۟ ٱلصَّلَوٰةَ","وَهُوَ ٱلَّذِىٓ إِلَيْهِ",67],["6:153:17",149,"تَتَّقُونَ","become righteous","وَصَّىٰكُم بِهِۦ لَعَلَّكُمْ","",67],["6:155:6",149,"وَٱتَّقُوا۟","and fear (Allah)","أَنزَلْنَـٰهُ مُبَارَكٌۭ فَٱتَّبِعُوهُ","لَعَلَّكُمْ تُرْحَمُونَ",67],["7:26:11",153,"ٱلتَّقْوَىٰ","(of) [the] righteousness","سَوْءَٰتِكُمْ وَرِيشًۭا ۖ وَلِبَاسُ","ذَٰلِكَ خَيْرٌۭ ۚ ذَٰلِكَ",580],["7:35:11",154,"ٱتَّقَىٰ","fears Allah","عَلَيْكُمْ ءَايَـٰتِى ۙ فَمَنِ","وَأَصْلَحَ فَلَا خَوْفٌ",67],["7:63:11",158,"وَلِتَتَّقُوا۟","and that you may fear","رَجُلٍۢ مِّنكُمْ لِيُنذِرَكُمْ","وَلَعَلَّكُمْ تُرْحَمُونَ",67],["7:65:15",158,"تَتَّقُونَ","you fear (Allah)","إِلَـٰهٍ غَيْرُهُۥٓ ۚ أَفَلَا","",67],["7:96:6",163,"وَٱتَّقَوْا۟","and feared Allah","أَهْلَ ٱلْقُرَىٰٓ ءَامَنُوا۟","لَفَتَحْنَا عَلَيْهِم بَرَكَـٰتٍۢ",67],["7:128:16",165,"لِلْمُتَّقِينَ","(is) for the righteous","مِنْ عِبَادِهِۦ ۖ وَٱلْعَـٰقِبَةُ","",244],["7:156:24",170,"يَتَّقُونَ","(are) righteous","شَىْءٍۢ ۚ فَسَأَكْتُبُهَا لِلَّذِينَ","وَيُؤْتُونَ ٱلزَّكَوٰةَ وَٱلَّذِينَ",67],["7:164:19",172,"يَتَّقُونَ","become righteous","إِلَىٰ رَبِّكُمْ وَلَعَلَّهُمْ","",67],["7:169:38",172,"يَتَّقُونَ ۗ","fear Allah","ٱلْـَٔاخِرَةُ خَيْرٌۭ لِّلَّذِينَ","أَفَلَا تَعْقِلُونَ",67],["7:171:19",173,"تَتَّقُونَ","fear Allah","مَا فِيهِ لَعَلَّكُمْ","",67],["7:201:3",176,"ٱتَّقَوْا۟","fear (Allah)","إِنَّ ٱلَّذِينَ","إِذَا مَسَّهُمْ طَـٰٓئِفٌۭ",67],["8:1:8",177,"فَٱتَّقُوا۟","So fear","ٱلْأَنفَالُ لِلَّهِ وَٱلرَّسُولِ ۖ","ٱللَّهَ وَأَصْلِحُوا۟ ذَاتَ",67],["8:25:1",179,"وَٱتَّقُوا۟","And fear","","فِتْنَةًۭ لَّا تُصِيبَنَّ",67],["8:29:5",180,"تَتَّقُوا۟","you fear","ٱلَّذِينَ ءَامَنُوٓا۟ إِن","ٱللَّهَ يَجْعَل لَّكُمْ",67],["8:34:17",181,"ٱلْمُتَّقُونَ","the ones who fear Allah","إِنْ أَوْلِيَآؤُهُۥٓ إِلَّا","وَلَـٰكِنَّ أَكْثَرَهُمْ لَا",244],["8:56:12",184,"يَتَّقُونَ","fear (Allah)","مَرَّةٍۢ وَهُمْ لَا","",67],["8:69:6",185,"وَٱتَّقُوا۟","and fear","غَنِمْتُمْ حَلَـٰلًۭا طَيِّبًۭا ۚ","ٱللَّهَ ۚ إِنَّ ٱللَّهَ",67],["9:4:22",187,"ٱلْمُتَّقِينَ","the righteous","إِنَّ ٱللَّهَ يُحِبُّ","",244],["9:7:23",188,"ٱلْمُتَّقِينَ","the righteous","إِنَّ ٱللَّهَ يُحِبُّ","",244],["9:36:36",192,"ٱلْمُتَّقِينَ","the righteous","أَنَّ ٱللَّهَ مَعَ","",244],["9:44:14",194,"بِٱلْمُتَّقِينَ","of the righteous","وَأَنفُسِهِمْ ۗ وَٱللَّهُ عَلِيمٌۢ","",244],["9:108:8",204,"ٱلتَّقْوَىٰ","the righteousness","لَّمَسْجِدٌ أُسِّسَ عَلَى","مِنْ أَوَّلِ يَوْمٍ",580],["9:109:5",204,"تَقْوَىٰ","righteousness","أَسَّسَ بُنْيَـٰنَهُۥ عَلَىٰ","مِنَ ٱللَّهِ وَرِضْوَٰنٍ",580],["9:115:13",205,"يَتَّقُونَ ۚ","they should fear","يُبَيِّنَ لَهُم مَّا","إِنَّ ٱللَّهَ بِكُلِّ",67],["9:11