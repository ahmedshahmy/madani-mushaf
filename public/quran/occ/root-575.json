[["2:251:15",41,"دَفْعُ","(for the) repelling","مِمَّا يَشَآءُ ۗ وَلَوْلَا","ٱللَّهِ ٱلنَّاسَ بَعْضَهُم",2352],["3:167:12",72,"ٱدْفَعُوا۟ ۖ","defend","سَبِيلِ ٱللَّهِ أَوِ","قَالُوا۟ لَوْ نَعْلَمُ",1327],["4:6:11",77,"فَٱدْفَعُوٓا۟","then deliver","ءَانَسْتُم مِّنْهُمْ رُشْدًۭا","إِلَيْهِمْ أَمْوَٰلَهُمْ ۖ وَلَا",1327],["4:6:30",77,"دَفَعْتُمْ","you deliver","فَلْيَأْكُلْ بِٱلْمَعْرُوفِ ۚ فَإِذَا","إِلَيْهِمْ أَمْوَٰلَهُمْ فَأَشْهِدُوا۟",1327],["22:38:3",336,"يُدَٰفِعُ","defends","۞ إِنَّ ٱللَّهَ","عَنِ ٱلَّذِينَ ءَامَنُوٓا۟ ۗ",4718],["22:40:13",337,"دَفْعُ","Allah checks","رَبُّنَا ٱللَّهُ ۗ وَلَوْلَا","ٱللَّهِ ٱلنَّاسَ بَعْضَهُم",2352],["23:96:1",348,"ٱدْفَعْ","Repel","","بِٱلَّتِى هِىَ أَحْسَنُ",1327],["41:34:6",480,"ٱدْفَعْ","Repel","ٱلْحَسَنَةُ وَلَا ٱلسَّيِّئَةُ ۚ","بِٱلَّتِى هِىَ أَحْسَنُ",1327],["52:8:4",523,"دَافِعٍۢ","preventer","مَّا لَهُۥ مِن","",2350],["70:2:4",568,"دَافِعٌۭ","any preventer","لِّلْكَـٰفِرِينَ لَيْسَ لَهُۥ","",2350]]