[["3:127:7",66,"يَكْبِتَهُمْ","suppress them","ٱلَّذِينَ كَفَرُوٓا۟ أَوْ","فَيَنقَلِبُوا۟ خَآئِبِينَ",1866],["58:5:6",542,"كُبِتُوا۟","(will) be disgraced","يُحَآدُّونَ ٱللَّهَ وَرَسُولَهُۥ","كَمَا كُبِتَ ٱلَّذِينَ",1866],["58:5:8",542,"كُبِتَ","were disgraced","وَرَسُولَهُۥ كُبِتُوا۟ كَمَا","ٱلَّذِينَ مِن قَبْلِهِمْ ۚ",1866]]