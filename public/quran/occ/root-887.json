[["8:1:3",177,"ٱلْأَنفَالِ ۖ","the spoils of war","يَسْـَٔلُونَكَ عَنِ","قُلِ ٱلْأَنفَالُ لِلَّهِ",2183],["8:1:5",177,"ٱلْأَنفَالُ","The spoils of war","عَنِ ٱلْأَنفَالِ ۖ قُلِ","لِلَّهِ وَٱلرَّسُولِ ۖ فَٱتَّقُوا۟",2183],["17:79:5",290,"نَافِلَةًۭ","(as) additional","ٱلَّيْلِ فَتَهَجَّدْ بِهِۦ","لَّكَ عَسَىٰٓ أَن",2550],["21:72:5",327,"نَافِلَةًۭ ۖ","(in) addition","لَهُۥٓ إِسْحَـٰقَ وَيَعْقُوبَ","وَكُلًّۭا جَعَلْنَا صَـٰلِحِينَ",2550]]