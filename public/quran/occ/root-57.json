[["2:38:10",7,"تَبِعَ","follows","مِّنِّى هُدًۭى فَمَن","هُدَاىَ فَلَا خَوْفٌ",927],["2:102:1",16,"وَٱتَّبَعُوا۟","And they followed","","مَا تَتْلُوا۟ ٱلشَّيَـٰطِينُ",84],["2:120:8",19,"تَتَّبِعَ","you follow","وَلَا ٱلنَّصَـٰرَىٰ حَتَّىٰ","مِلَّتَهُمْ ۗ قُلْ إِنَّ",84],["2:120:17",19,"ٱتَّبَعْتَ","you follow","هُوَ ٱلْهُدَىٰ ۗ وَلَئِنِ","أَهْوَآءَهُم بَعْدَ ٱلَّذِى",84],["2:143:22",22,"يَتَّبِعُ","follows","إِلَّا لِنَعْلَمَ مَن","ٱلرَّسُولَ مِمَّن يَنقَلِبُ",84],["2:145:9",22,"تَبِعُوا۟","they would follow","بِكُلِّ ءَايَةٍۢ مَّا","قِبْلَتَكَ ۚ وَمَآ أَنتَ",927],["2:145:13",22,"بِتَابِعٍۢ","a follower","قِبْلَتَكَ ۚ وَمَآ أَنتَ","قِبْلَتَهُمْ ۚ وَمَا بَعْضُهُم",2004],["2:145:17",22,"بِتَابِعٍۢ","(are) followers","قِبْلَتَهُمْ ۚ وَمَا بَعْضُهُم","قِبْلَةَ بَعْضٍۢ ۚ وَلَئِنِ",2004],["2:145:21",22,"ٱتَّبَعْتَ","you followed","قِبْلَةَ بَعْضٍۢ ۚ وَلَئِنِ","أَهْوَآءَهُم مِّنۢ بَعْدِ",84],["2:166:4",25,"ٱتُّبِعُوا۟","were followed","إِذْ تَبَرَّأَ ٱلَّذِينَ","مِنَ ٱلَّذِينَ ٱتَّبَعُوا۟",84],["2:166:7",25,"ٱتَّبَعُوا۟","followed","ٱتُّبِعُوا۟ مِنَ ٱلَّذِينَ","وَرَأَوُا۟ ٱلْعَذَابَ وَتَقَطَّعَتْ",84],["2:167:3",25,"ٱتَّبَعُوا۟","followed","وَقَالَ ٱلَّذِينَ","لَوْ أَنَّ لَنَا",84],["2:168:10",25,"تَتَّبِعُوا۟","follow","حَلَـٰلًۭا طَيِّبًۭا وَلَا","خُطُوَٰتِ ٱلشَّيْطَـٰنِ ۚ إِنَّهُۥ",84],["2:170:4",26,"ٱتَّبِعُوا۟","Follow","وَإِذَا قِيلَ لَهُمُ","مَآ أَنزَلَ ٱللَّهُ",84],["2:170:10",26,"نَتَّبِعُ","we follow","ٱللَّهُ قَالُوا۟ بَلْ","مَآ أَلْفَيْنَا عَلَيْهِ",84],["2:178:21",27,"فَٱتِّبَاعٌۢ","then follows up","مِنْ أَخِيهِ شَىْءٌۭ","بِٱلْمَعْرُوفِ وَأَدَآءٌ إِلَيْهِ",2856],["2:208:9",32,"تَتَّبِعُوا۟","follow","ٱلسِّلْمِ كَآفَّةًۭ وَلَا","خُطُوَٰتِ ٱلشَّيْطَـٰنِ ۚ إِنَّهُۥ",84],["2:262:9",44,"يُتْبِعُونَ","they follow","ٱللَّهِ ثُمَّ لَا","مَآ أَنفَقُوا۟ مَنًّۭا",617],["2:263:7",44,"يَتْبَعُهَآ","followed [it]","خَيْرٌۭ مِّن صَدَقَةٍۢ","أَذًۭى ۗ وَٱللَّهُ غَنِىٌّ",927],["3:7:19",50,"فَيَتَّبِعُونَ","[so] they follow","فِى قُلُوبِهِمْ زَيْغٌۭ","مَا تَشَـٰبَهَ مِنْهُ",84],["3:20:8",52,"ٱتَّبَعَنِ ۗ","follow me","وَجْهِىَ لِلَّهِ وَمَنِ","وَقُل لِّلَّذِينَ أُوتُوا۟",84],["3:31:6",54,"فَٱتَّبِعُونِى","then follow me","كُنتُمْ تُحِبُّونَ ٱللَّهَ","يُحْبِبْكُمُ ٱللَّهُ وَيَغْفِرْ",84],["3:53:5",57,"وَٱتَّبَعْنَا","and we follow[ed]","ءَامَنَّا بِمَآ أَنزَلْتَ","ٱلرَّسُولَ فَٱكْتُبْنَا مَعَ",84],["3:55:15",57,"ٱتَّبَعُوكَ","follow[ed] you","كَفَرُوا۟ وَجَاعِلُ ٱلَّذِينَ","فَوْقَ ٱلَّذِينَ كَفَرُوٓا۟",84],["3:68:6",58,"ٱتَّبَعُوهُ","follow him","ٱلنَّاسِ بِإِبْرَٰهِيمَ لَلَّذِينَ","وَهَـٰذَا ٱلنَّبِىُّ وَٱلَّذِينَ",84],["3:73:5",59,"تَبِعَ","follows","تُؤْمِنُوٓا۟ إِلَّا لِمَن","دِينَكُمْ قُلْ إِنَّ",927],["3:95:4",62,"فَٱتَّبِعُوا۟","then follow","قُلْ صَدَقَ ٱللَّهُ ۗ","مِلَّةَ إِبْرَٰهِيمَ حَنِيفًۭا",84],["3:162:2",71,"ٱتَّبَعَ","pursues","أَفَمَنِ","رِضْوَٰنَ ٱللَّهِ كَمَنۢ",84],["3:167:17",72,"لَّٱتَّبَعْنَـٰكُمْ ۗ","certainly we (would have) followed you","لَوْ نَعْلَمُ قِتَالًۭا","هُمْ لِلْكُفْرِ يَوْمَئِذٍ",84],["3:174:9",73,"وَٱتَّبَعُوا۟","And they followed","لَّمْ يَمْسَسْهُمْ سُوٓءٌۭ","رِضْوَٰنَ ٱللَّهِ ۗ وَٱللَّهُ",84],["4:27:8",83,"يَتَّبِعُونَ","follow","عَلَيْكُمْ وَيُرِيدُ ٱلَّذِينَ","ٱلشَّهَوَٰتِ أَن تَمِيلُوا۟",84],["4:83:27",91,"لَٱتَّبَعْتُمُ","surely you (would have) followed","ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ","ٱلشَّيْطَـٰنَ إِلَّا قَلِيلًۭا",84],["4:92:53",93,"مُتَتَابِعَيْنِ","consecutively","يَجِدْ فَصِيَامُ شَهْرَيْنِ","تَوْبَةًۭ مِّنَ ٱللَّهِ ۗ",2511],["4:115:10",97,"وَيَتَّبِعْ","and he follows","تَبَيَّنَ لَهُ ٱلْهُدَىٰ","غَيْرَ سَبِيلِ ٱلْمُؤْمِنِينَ",84],["4:125:10",98,"وَٱتَّبَعَ","and follows","لِلَّهِ وَهُوَ مُحْسِنٌۭ","مِلَّةَ إِبْرَٰهِيمَ حَنِيفًۭا ۗ",84],["4:135:24",100,"تَتَّبِعُوا۟","follow","أَوْلَىٰ بِهِمَا ۖ فَلَا","ٱلْهَوَىٰٓ أَن تَعْدِلُوا۟ ۚ",84],["4:157:30",103,"ٱتِّبَاعَ","(the) following","مِنْ عِلْمٍ إِلَّا","ٱلظَّنِّ ۚ وَمَا قَتَلُوهُ",2856],["5:16:5",110,"ٱتَّبَعَ","seek","بِهِ ٱللَّهُ مَنِ","رِضْوَٰنَهُۥ سُبُلَ ٱلسَّلَـٰمِ",84],["5:48:19",116,"تَتَّبِعْ","follow","أَنزَلَ ٱللَّهُ ۖ وَلَا","أَهْوَآءَهُمْ عَمَّا جَآءَكَ",84],["5:49:8",116,"تَتَّبِعْ","follow","أَنزَلَ ٱللَّهُ وَلَا","أَهْوَآءَهُمْ وَٱحْذَرْهُمْ أَن",84],["5:77:11",120,"تَتَّبِعُوٓا۟","follow","غَيْرَ ٱلْحَقِّ وَلَا","أَهْوَآءَ قَوْمٍۢ قَدْ",84],["6:50:17",133,"أَتَّبِعُ","(do) I follow","إِنِّى مَلَكٌ ۖ إِنْ","إِلَّا مَا يُوحَىٰٓ",84],["6:56:13",134,"أَتَّبِعُ","I follow","ٱللَّهِ ۚ قُل لَّآ","أَهْوَآءَكُمْ ۙ قَدْ ضَلَلْتُ",84],["6:106:1",141,"ٱتَّبِعْ","Follow","","مَآ أُوحِىَ إِلَيْكَ",84],["6:116:12",142,"يَتَّبِعُونَ","they follow","سَبِيلِ ٱللَّهِ ۚ إِن","إِلَّا ٱلظَّنَّ وَإِنْ",84],["6:142:10",146,"تَتَّبِعُوا۟","follow","رَزَقَكُمُ ٱللَّهُ وَلَا","خُطُوَٰتِ ٱلشَّيْطَـٰنِ ۚ إِنَّهُۥ",84],["6:148:31",148,"تَتَّبِعُونَ","you follow","فَتُخْرِجُوهُ لَنَآ ۖ إِن","إِلَّا ٱلظَّنَّ وَإِنْ",84],["6:150:16",148,"تَتَّبِعْ","follow","تَشْهَدْ مَعَهُمْ ۚ وَلَا","أَهْوَآءَ ٱلَّذِينَ كَذَّبُوا۟",84],["6:153:5",149,"فَٱتَّبِعُوهُ ۖ","so follow it","هَـٰذَا صِرَٰطِى مُسْتَقِيمًۭا","وَلَا تَتَّبِعُوا۟ ٱلسُّبُلَ",84],["6:153:7",149,"تَتَّبِعُوا۟","follow","مُسْتَقِيمًۭا فَٱتَّبِعُوهُ ۖ وَلَا","ٱلسُّبُلَ فَتَفَرَّقَ بِكُمْ",84],["6:155:5",149,"فَٱتَّبِعُوهُ","so follow it","كِتَـٰبٌ أَنزَلْنَـٰهُ مُبَارَكٌۭ","وَٱتَّقُوا۟ لَعَلَّكُمْ تُرْحَمُونَ",84],["7:3:1",151,"ٱتَّبِعُوا۟","Follow","","مَآ أُنزِلَ إِلَيْكُم",84],["7:3:8",151,"تَتَّبِعُوا۟","follow","مِّن رَّبِّكُمْ وَلَا","مِن دُونِهِۦٓ أَوْلِيَآءَ ۗ",84],["7:18:7",152,"تَبِعَكَ","follows you","مَذْءُومًۭا مَّدْحُورًۭا ۖ لَّمَن","مِنْهُمْ لَأَمْلَأَنَّ جَهَنَّمَ",927],["7:90:8",162,"ٱتَّبَعْتُمْ","you follow","مِن قَوْمِهِۦ لَئِنِ","شُعَيْبًا إِنَّكُمْ إِذًۭا",84],["7:142:21",167,"تَتَّبِعْ","follow","قَوْمِى وَأَصْلِحْ وَلَا","سَبِيلَ ٱلْمُفْسِدِينَ",84],["7:157:2",170,"يَتَّبِعُونَ","follow","ٱلَّذِينَ","ٱلرَّسُولَ ٱلنَّبِىَّ ٱلْأُمِّىَّ",84],["7:157:36",170,"وَٱتَّبَعُوا۟","and follow","بِهِۦ وَعَزَّرُوهُ وَنَصَرُوهُ","ٱلنُّورَ ٱلَّذِىٓ أُنزِلَ",84],["7:158:29",170,"وَٱتَّبِعُوهُ","and follow him","يُؤْمِنُ بِٱللَّهِ وَكَلِمَـٰتِهِۦ","لَعَلَّكُمْ تَهْتَدُونَ",84],["7:175:9",173,"فَأَتْبَعَهُ","so followed him","ءَايَـٰتِنَا فَٱنسَلَخَ مِنْهَا","ٱلشَّيْطَـٰنُ فَكَانَ مِنَ",617],["7:176:9",173,"وَٱتَّبَعَ","and followed","أَخْلَدَ إِلَى ٱلْأَرْضِ","هَوَىٰهُ ۚ فَمَثَلُهُۥ كَمَثَلِ",84],["7:193:6",175,"يَتَّبِعُوكُمْ ۚ","will they follow you","إِلَى ٱلْهُدَىٰ لَا","سَوَآءٌ عَلَيْكُمْ أَدَعَوْتُمُوهُمْ",84],["7:203:10",176,"أَتَّبِعُ","I follow","ٱجْتَبَيْتَهَا ۚ قُلْ إِنَّمَآ","مَا يُوحَىٰٓ إِلَىَّ",84],["8:64:6",185,"ٱتَّبَعَكَ","follows you","حَسْبُكَ ٱللَّهُ وَمَنِ","مِنَ ٱلْمُؤْمِنِينَ",84],["9:42:7",194,"لَّٱتَّبَعُوكَ","surely they (would) have followed you","قَرِيبًۭا وَسَفَرًۭا قَاصِدًۭا","وَلَـٰكِنۢ بَعُدَتْ عَلَيْهِمُ",84],["9:100:7",203,"ٱتَّبَعُوهُم","followed them","ٱلْمُهَـٰجِرِينَ وَٱلْأَنصَارِ وَٱلَّذِينَ","بِإِحْسَـٰنٍۢ رَّضِىَ ٱللَّهُ",84],["9:117:9",205,"ٱتَّبَعُوهُ","followed him","وَٱلْمُهَـٰجِرِينَ وَٱلْأَنصَارِ ٱلَّذِينَ","فِى سَاعَةِ ٱلْعُسْرَةِ",84],["10:15:27",210,"أَتَّبِعُ","I follow","تِلْقَآئِ نَفْسِىٓ ۖ إِنْ","إِلَّا مَا يُوحَىٰٓ",84],["10:35:19",213,"يُتَّبَعَ","he should be followed","ٱلْحَقِّ أَحَقُّ أَن","أَمَّن لَّا يَهِدِّىٓ",84],["10:36:2",213,"يَتَّبِعُ","follow","وَمَا","أَكْثَرُهُمْ إِلَّا ظَنًّا ۚ",84],["10:66:11",216,"يَتَّبِعُ","follow","فِى ٱلْأَرْضِ ۗ وَمَا","ٱلَّذِينَ يَدْعُونَ مِن",84],["10:66:19",216,"يَتَّبِعُونَ","they follow","ٱللَّهِ شُرَكَآءَ ۚ إِن","إِلَّا ٱلظَّنَّ وَإِنْ",84],["10:89:7",219,"تَتَّبِعَآنِّ","follow","دَّعْوَتُكُمَا فَٱسْتَقِيمَا وَلَا","سَبِيلَ ٱلَّذِينَ لَا",84],["10:90:5",219,"فَأَتْبَعَهُمْ","and followed them","بِبَنِىٓ إِسْرَٰٓءِيلَ ٱلْبَحْرَ","فِرْعَوْنُ وَجُنُودُهُۥ بَغْيًۭا",617],["10:109:1",221,"وَٱتَّبِعْ","And follow","","مَا يُوحَىٰٓ إِلَيْكَ",84],["11:27:14",224,"ٱتَّبَعَكَ","followed [you]","مِّثْلَنَا وَمَا نَرَىٰكَ","إِلَّا ٱلَّذِينَ هُمْ",84],["11:59:8",228,"وَٱتَّبَعُوٓا۟","and followed","رَبِّهِمْ وَعَصَوْا۟ رُسُلَهُۥ","أَمْرَ كُلِّ جَبَّارٍ",84],["11:60:1",228,"وَأُتْبِعُوا۟","And they were followed","","فِى هَـٰذِهِ ٱلدُّنْيَا",617],["11:97:4",232,"فَٱتَّبَعُوٓا۟","but they followed","إِلَىٰ فِرْعَوْنَ وَمَلَإِي۟هِۦ","أَمْرَ فِرْعَوْنَ ۖ وَمَآ",84],["11:99:1",233,"وَأُتْبِعُوا۟","And they were followed","","فِى هَـٰذِهِۦ لَعْنَةًۭ",617],["11:116:19",234,"وَٱتَّبَعَ","But followed","مِّمَّنْ أَنجَيْنَا مِنْهُمْ ۗ","ٱلَّذِينَ ظَلَمُوا۟ مَآ",84],["12:38:1",240,"وَٱتَّبَعْتُ","And I follow","","مِلَّةَ ءَابَآءِىٓ إِبْرَٰهِيمَ",84],["12:108:11",248,"ٱتَّبَعَنِى ۖ","follows me","بَصِيرَةٍ أَنَا۠ وَمَنِ","وَسُبْحَـٰنَ ٱللَّهِ وَمَآ",84],["13:37:6",254,"ٱتَّبَعْتَ","you follow","حُكْمًا عَرَبِيًّۭا ۚ وَلَئِنِ","أَهْوَآءَهُم بَعْدَ مَا جَآءَكَ",84],["14:21:11",258,"تَبَعًۭا","followers","إِنَّا كُنَّا لَكُمْ","فَهَلْ أَنتُم مُّغْنُونَ",2660],["14:36:8",260,"تَبِعَنِى","follows me","مِّنَ ٱلنَّاسِ ۖ فَمَن","فَإِنَّهُۥ مِنِّى ۖ وَمَنْ",927],["14:44:16",261,"وَنَتَّبِعِ","and we will follow","قَرِيبٍۢ نُّجِبْ دَعْوَتَكَ","ٱلرُّسُلَ ۗ أَوَلَمْ تَكُونُوٓا۟",84],["15:18:5",263,"فَأَتْبَعَهُۥ","then follows him","مَنِ ٱسْتَرَقَ ٱلسَّمْعَ","شِهَابٌۭ مُّبِينٌۭ",617],["15:42:9",264,"ٱتَّبَعَكَ","follow you","سُلْطَـٰنٌ إِلَّا مَنِ","مِنَ ٱلْغَاوِينَ",84],["15:65:6",265,"وَٱتَّبِعْ","and follow","بِقِطْعٍۢ مِّنَ ٱلَّيْلِ","أَدْبَـٰرَهُمْ وَلَا يَلْتَفِتْ",84],["16:123:5",281,"ٱتَّبِعْ","You follow","أَوْحَيْنَآ إِلَيْكَ أَنِ","مِلَّةَ إِبْرَٰهِيمَ حَنِيفًۭا ۖ",84],["17:47:16",286,"تَتَّبِعُونَ","you follow","يَقُولُ ٱلظَّـٰلِمُونَ إِن","إِلَّا رَجُلًۭا مَّسْحُورًا",84],["17:63:4",288,"تَبِعَكَ","follows you","قَالَ ٱذْهَبْ فَمَن","مِنْهُمْ فَإِنَّ جَهَنَّمَ",927],["17:69:22",289,"تَبِيعًۭا","an avenger","لَكُمْ عَلَيْنَا بِهِۦ","",4355],["18:28:26",297,"وَٱتَّبَعَ","and follows","قَلْبَهُۥ عَن ذِكْرِنَا","هَوَىٰهُ وَكَانَ أَمْرُهُۥ",84],["18:66:5",301,"أَتَّبِعُكَ","I follow you","لَهُۥ مُوسَىٰ هَلْ","عَلَىٰٓ أَن تُعَلِّمَنِ",84],["18:70:3",301,"ٱتَّبَعْتَنِى","you follow me","قَالَ فَإِنِ","فَلَا تَسْـَٔلْنِى عَن",84],["18:85:1",303,"فَأَتْبَعَ","So he followed","","سَبَبًا",617],["18:89:2",303,"أَتْبَعَ","he followed","ثُمَّ","سَبَبًا",617],["18:92:2",303,"أَتْبَعَ","he followed","ثُمَّ","سَبَبًا",617],["19:43:10",308,"فَٱتَّبِعْنِىٓ","so follow me","مَا لَمْ يَأْتِكَ","أَهْدِكَ صِرَٰطًۭا سَوِيًّۭا",84],["19:59:7",309,"وَٱتَّبَعُوا۟","and they followed","خَلْفٌ أَضَاعُوا۟ ٱلصَّلَوٰةَ","ٱلشَّهَوَٰتِ ۖ فَسَوْفَ يَلْقَوْنَ",84],["20:16:8",313,"وَٱتَّبَعَ","and follows","لَّا يُؤْمِنُ بِهَا","هَوَىٰهُ فَتَرْدَىٰ",84],["20:47:20",314,"ٱتَّبَعَ","follows","وَٱلسَّلَـٰمُ عَلَىٰ مَنِ","ٱلْهُدَىٰٓ",84],["20:78:1",317,"فَأَتْبَعَهُمْ","Then followed them","","فِرْعَوْنُ بِجُنُودِهِۦ فَغَشِيَهُم",617],["20:90:14",318,"فَٱتَّبِعُونِى","so follow me","وَإِنَّ رَبَّكُمُ ٱلرَّحْمَـٰنُ","وَأَطِيعُوٓا۟ أَمْرِى",84],["20:93:2",318,"تَتَّبِعَنِ ۖ","you follow me","أَلَّا","أَفَعَصَيْتَ أَمْرِى",84],["20:108:2",319,"يَتَّبِعُونَ","they will follow","يَوْمَئِذٍۢ","ٱلدَّاعِىَ لَا عِوَجَ",84],["20:123:13",320,"ٱتَّبَعَ","follows","مِّنِّى هُدًۭى فَمَنِ","هُدَاىَ فَلَا يَضِلُّ",84],["20:134:13",321,"فَنَتَّبِعَ","so we (could) have followed","أَرْسَلْتَ إِلَيْنَا رَسُولًۭا","ءَايَـٰتِكَ مِن قَبْلِ",84],["22:3:9",332,"وَيَتَّبِعُ","and follows","ٱللَّهِ بِغَيْرِ عِلْمٍۢ","كُلَّ شَيْطَـٰنٍۢ مَّرِيدٍۢ",84],["23:44:11",345,"فَأَتْبَعْنَا","so We made (them) follow","أُمَّةًۭ رَّسُولُهَا كَذَّبُوهُ ۚ","بَعْضَهُم بَعْضًۭا وَجَعَلْنَـٰهُمْ",617],["23:71:2",346,"ٱتَّبَعَ","(had) followed","وَلَوِ","ٱلْحَقُّ أَهْوَآءَهُمْ لَفَسَدَتِ",84],["24:21:5",352,"تَتَّبِعُوا۟","follow","ٱلَّذِينَ ءَامَنُوا۟ لَا","خُطُوَٰتِ ٱلشَّيْطَـٰنِ ۚ وَمَن",84],["24:21:9",352,"يَتَّبِعْ","follows","خُطُوَٰتِ ٱلشَّيْطَـٰنِ ۚ وَمَن","خُطُوَٰتِ ٱلشَّيْطَـٰنِ فَإِنَّهُۥ",84],["24:31:49",353,"ٱلتَّـٰبِعِينَ","the attendants","مَلَكَتْ أَيْمَـٰنُهُنَّ أَوِ","غَيْرِ أُو۟لِى ٱلْإِرْبَةِ",2004],["25:8:14",360,"تَتَّبِعُونَ","you follow","وَقَالَ ٱلظَّـٰلِمُونَ إِن","إِلَّا رَجُلًۭا مَّسْحُورًا",84],["26:40:2",369,"نَتَّبِعُ","follow","لَعَلَّنَا","ٱلسَّحَرَةَ إِن كَانُوا۟",84],["26:52:8",369,"مُّتَّبَعُونَ","(will be) followed","أَسْرِ بِعِبَادِىٓ إِنَّكُم","",2543],["26:60:1",369,"فَأَتْبَعُوهُم","So they followed them","","مُّشْرِقِينَ",617],["26:111:4",371,"وَٱتَّبَعَكَ","while followed you","۞ قَالُوٓا۟ أَنُؤْمِنُ لَكَ","ٱلْأَرْذَلُونَ",84],["26:215:4",376,"ٱتَّبَعَكَ","follow you","وَٱخْفِضْ جَنَاحَكَ لِمَنِ","مِنَ ٱلْمُؤْمِنِينَ",84],["26:224:2",376,"يَتَّبِعُهُمُ","follow them","وَٱلشُّعَرَآءُ","ٱلْغَاوُۥنَ",84],["28:35:14",389,"ٱتَّبَعَكُمَا","follow you","بِـَٔايَـٰتِنَآ أَنتُمَا وَمَنِ","ٱلْغَـٰلِبُونَ",84],["28:42:1",390,"وَأَتْبَعْنَـٰهُمْ","And We caused to follow them","","فِى هَـٰذِهِ ٱلدُّنْيَا",617],["28:47:14",391,"فَنَتَّبِعَ","so we (could have) followed","أَرْسَلْتَ إِلَيْنَا رَسُولًۭا","ءَايَـٰتِكَ وَنَكُونَ مِنَ",84],["28:49:10",391,"أَتَّبِعْهُ","that I may follow it","هُوَ أَهْدَىٰ مِنْهُمَآ","إِن كُنتُمْ صَـٰدِقِينَ",84],["28:50:7",391,"يَتَّبِعُونَ","they follow","لَكَ فَٱعْلَمْ أَنَّمَا","أَهْوَآءَهُمْ ۚ وَمَنْ أَضَلُّ",84],["28:50:12",391,"ٱتَّبَعَ","follows","وَمَنْ أَضَلُّ مِمَّنِ","هَوَىٰهُ بِغَيْرِ هُدًۭى",84],["28:57:3",392,"نَّتَّبِعِ","we follow","وَقَالُوٓا۟ إِن","ٱلْهُدَىٰ مَعَكَ نُتَخَطَّفْ",84],["29:12:6",397,"ٱتَّبِعُوا۟","Follow","كَفَرُوا۟ لِلَّذِينَ ءَامَنُوا۟","سَبِيلَنَا وَلْنَحْمِلْ خَطَـٰيَـٰكُمْ",84],["30:29:2",407,"ٱتَّبَعَ","follow","بَلِ","ٱلَّذِينَ ظَلَمُوٓا۟ أَهْوَآءَهُم",84],["31:15:18",412,"وَٱتَّبِعْ","and follow","فِى ٱلدُّنْيَا مَعْرُوفًۭا ۖ","سَبِيلَ مَنْ أَنَابَ",84],["31:21:4",413,"ٱتَّبِعُوا۟","Follow","وَإِذَا قِيلَ لَهُمُ","مَآ أَنزَلَ ٱللَّهُ",84],["31:21:10",413,"نَتَّبِعُ","we will follow","ٱللَّهُ قَالُوا۟ بَلْ","مَا وَجَدْنَا عَلَيْهِ",84],["33:2:1",418,"وَٱتَّبِعْ","And follow","","مَا يُوحَىٰٓ إِلَيْكَ",84],["34:20:6",430,"فَٱتَّبَعُوهُ","so they followed him","عَلَيْهِمْ إِبْلِيسُ ظَنَّهُۥ","إِلَّا فَرِيقًۭا مِّنَ",84],["36:11:4",440,"ٱتَّبَعَ","follows","إِنَّمَا تُنذِرُ مَنِ","ٱلذِّكْرَ وَخَشِىَ ٱلرَّحْمَـٰنَ",84],["36:20:9",441,"ٱتَّبِعُوا۟","Follow","يَسْعَىٰ قَالَ يَـٰقَوْمِ","ٱلْمُرْسَلِينَ",84],["36:21:1",441,"ٱتَّبِعُوا۟","Follow","","مَن لَّا يَسْـَٔلُكُمْ",84],["37:10:5",446,"فَأَتْبَعَهُۥ","but follows him","مَنْ خَطِفَ ٱلْخَطْفَةَ","شِهَابٌۭ ثَاقِبٌۭ",617],["38:26:12",454,"تَتَّبِعِ","follow","ٱلنَّاسِ بِٱلْحَقِّ وَلَا","ٱلْهَوَىٰ فَيُضِلَّكَ عَن",84],["38:85:5",458,"تَبِعَكَ","follow you","جَهَنَّمَ مِنكَ وَمِمَّن","مِنْهُمْ أَجْمَعِينَ",927],["39:18:4",460,"فَيَتَّبِعُونَ","then follow","ٱلَّذِينَ يَسْتَمِعُونَ ٱلْقَوْلَ","أَحْسَنَهُۥٓ ۚ أُو۟لَـٰٓئِكَ ٱلَّذِينَ",84],["39:55:1",464,"وَٱتَّبِعُوٓا۟","And follow","","أَحْسَنَ مَآ أُنزِلَ",84],["40:7:23",467,"وَٱتَّبَعُوا۟","and follow","فَٱغْفِرْ لِلَّذِينَ تَابُوا۟","سَبِيلَكَ وَقِهِمْ عَذَابَ",84],["40:38:5",471,"ٱتَّبِعُونِ","Follow me","ٱلَّذِىٓ ءَامَنَ يَـٰقَوْمِ","أَهْدِكُمْ سَبِيلَ ٱلرَّشَادِ",84],["40:47:12",472,"تَبَعًۭا","followers","إِنَّا كُنَّا لَكُمْ","فَهَلْ أَنتُم مُّغْنُونَ",2660],["42:15:7",484,"تَتَّبِعْ","follow","كَمَآ أُمِرْتَ ۖ وَلَا","أَهْوَآءَهُمْ ۖ وَقُلْ ءَامَنتُ",84],["43:61:7",494,"وَٱتَّبِعُونِ ۚ","and follow Me","فَلَا تَمْتَرُنَّ بِهَا","هَـٰذَا صِرَٰطٌۭ مُّسْتَقِيمٌۭ",84],["44:23:5",497,"مُّتَّبَعُونَ","(will be) followed","بِعِبَادِى لَيْلًا إِنَّكُم","",2543],["45:18:7",500,"فَٱتَّبِعْهَا","so follow it","شَرِيعَةٍۢ مِّنَ ٱلْأَمْرِ","وَلَا تَتَّبِعْ أَهْوَآءَ",84],["45:18:9",500,"تَتَّبِعْ","follow","ٱلْأَمْرِ فَٱتَّبِعْهَا وَلَا","أَهْوَآءَ ٱلَّذِينَ لَا",84],["46:9:15",503,"أَتَّبِعُ","I follow","وَلَا بِكُمْ ۖ إِنْ","إِلَّا مَا يُوحَىٰٓ",84],["47:3:5",507,"ٱتَّبَعُوا۟","follow","بِأَنَّ ٱلَّذِينَ كَفَرُوا۟","ٱلْبَـٰطِلَ وَأَنَّ ٱلَّذِينَ",84],["47:3:10",507,"ٱتَّبَعُوا۟","follow","وَأَنَّ ٱلَّذِينَ ءَامَنُوا۟","ٱلْحَقَّ مِن رَّبِّهِمْ ۚ",84],["47:14:12",508,"وَٱتَّبَعُوٓا۟","while they follow","لَهُۥ سُوٓءُ عَمَلِهِۦ","أَهْوَآءَهُم",84],["47:16:23",508,"وَٱتَّبَعُوٓا۟","and they follow","ٱللَّهُ عَلَىٰ قُلُوبِهِمْ","أَهْوَآءَهُمْ",84],["47:28:3",509,"ٱتَّبَعُوا۟","followed","ذَٰلِكَ بِأَنَّهُمُ","مَآ أَسْخَطَ ٱللَّهَ",84],["48:15:9",512,"نَتَّبِعْكُمْ ۖ","(to) follow you","مَغَانِمَ لِتَأْخُذُوهَا ذَرُونَا","يُرِيدُونَ أَن يُبَدِّلُوا۟",84],["48:15:17",512,"تَتَّبِعُونَا","will you follow us","ٱللَّهِ ۚ قُل لَّن","كَذَٰلِكُمْ قَالَ ٱللَّهُ",84],["52:21:3",524,"وَٱتَّبَعَتْهُمْ","and followed them","وَٱلَّذِينَ ءَامَنُوا۟","ذُرِّيَّتُهُم بِإِيمَـٰنٍ أَلْحَقْنَا",84],["53:23:15",526,"يَتَّبِعُونَ","they follow","مِن سُلْطَـٰنٍ ۚ إِن","إِلَّا ٱلظَّنَّ وَمَا",84],["53:28:7",527,"يَتَّبِعُونَ","they follow","مِنْ عِلْمٍ ۖ إِن","إِلَّا ٱلظَّنَّ ۖ وَإِنَّ",84],["54:3:2",528,"وَٱتَّبَعُوٓا۟","and followed","وَكَذَّبُوا۟","أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍۢ",84],["54:24:5",529,"نَّتَّبِعُهُۥٓ","(that) we should follow him","أَبَشَرًۭا مِّنَّا وَٰحِدًۭا","إِنَّآ إِذًۭا لَّفِى",84],["57:27:16",541,"ٱتَّبَعُوهُ","followed him","فِى قُلُوبِ ٱلَّذِينَ","رَأْفَةًۭ وَرَحْمَةًۭ وَرَهْبَانِيَّةً",84],["58:4:6",542,"مُتَتَابِعَيْنِ","consecutively","يَجِدْ فَصِيَامُ شَهْرَيْنِ","مِن قَبْلِ أَن",2511],["71:21:6",571,"وَٱتَّبَعُوا۟","and followed","رَّبِّ إِنَّهُمْ عَصَوْنِى","مَن لَّمْ يَزِدْهُ",84],["75:18:3",577,"فَٱتَّبِعْ","then follow","فَإِذَا قَرَأْنَـٰهُ","قُرْءَانَهُۥ",84],["77:17:2",580,"نُتْبِعُهُمُ","We follow them up","ثُمَّ","ٱلْـَٔاخِرِينَ",617],["79:7:1",583,"تَتْبَعُهَا","Follows it","","ٱلرَّادِفَةُ",927]]