[["2:35:13",6,"تَقْرَبَا","[you two] approach","حَيْثُ شِئْتُمَا وَلَا","هَـٰذِهِ ٱلشَّجَرَةَ فَتَكُونَا",807],["2:83:13",12,"ٱلْقُرْبَىٰ","relatives","وَبِٱلْوَٰلِدَيْنِ إِحْسَانًۭا وَذِى","وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ وَقُولُوا۟",602],["2:177:24",27,"ٱلْقُرْبَىٰ","(of) the near relatives","عَلَىٰ حُبِّهِۦ ذَوِى","وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينَ وَٱبْنَ",602],["2:180:12",27,"وَٱلْأَقْرَبِينَ","and the near relatives","خَيْرًا ٱلْوَصِيَّةُ لِلْوَٰلِدَيْنِ","بِٱلْمَعْرُوفِ ۖ حَقًّا عَلَى",522],["2:186:6",28,"قَرِيبٌ ۖ","near","عِبَادِى عَنِّى فَإِنِّى","أُجِيبُ دَعْوَةَ ٱلدَّاعِ",416],["2:187:58",29,"تَقْرَبُوهَا ۗ","approach them","حُدُودُ ٱللَّهِ فَلَا","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ",807],["2:214:30",33,"قَرِيبٌۭ","(is) near","إِنَّ نَصْرَ ٱللَّهِ","",416],["2:215:10",33,"وَٱلْأَقْرَبِينَ","and the relatives","مِّنْ خَيْرٍۢ فَلِلْوَٰلِدَيْنِ","وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ وَٱبْنِ",522],["2:222:12",35,"تَقْرَبُوهُنَّ","approach them","فِى ٱلْمَحِيضِ ۖ وَلَا","حَتَّىٰ يَطْهُرْنَ ۖ فَإِذَا",807],["2:237:25",38,"أَقْرَبُ","(is) nearer","ٱلنِّكَاحِ ۚ وَأَن تَعْفُوٓا۟","لِلتَّقْوَىٰ ۚ وَلَا تَنسَوُا۟",522],["3:45:20",55,"ٱلْمُقَرَّبِينَ","those brought near (to Allah)","ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ وَمِنَ","",990],["3:167:21",72,"أَقْرَبُ","(were) nearer","هُمْ لِلْكُفْرِ يَوْمَئِذٍ","مِنْهُمْ لِلْإِيمَـٰنِ ۚ يَقُولُونَ",522],["3:183:12",74,"بِقُرْبَانٍۢ","a sacrifice","لِرَسُولٍ حَتَّىٰ يَأْتِيَنَا","تَأْكُلُهُ ٱلنَّارُ ۗ قُلْ",1967],["4:7:6",78,"وَٱلْأَقْرَبُونَ","and the near relatives","مِّمَّا تَرَكَ ٱلْوَٰلِدَانِ","وَلِلنِّسَآءِ نَصِيبٌۭ مِّمَّا",522],["4:7:12",78,"وَٱلْأَقْرَبُونَ","and the near relatives","مِّمَّا تَرَكَ ٱلْوَٰلِدَانِ","مِمَّا قَلَّ مِنْهُ",522],["4:8:5",78,"ٱلْقُرْبَىٰ","the relatives","حَضَرَ ٱلْقِسْمَةَ أُو۟لُوا۟","وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينُ فَٱرْزُقُوهُم",602],["4:11:61",78,"أَقْرَبُ","(is) nearer","لَا تَدْرُونَ أَيُّهُمْ","لَكُمْ نَفْعًۭا ۚ فَرِيضَةًۭ",522],["4:17:12",80,"قَرِيبٍۢ","soon after","ثُمَّ يَتُوبُونَ مِن","فَأُو۟لَـٰٓئِكَ يَتُوبُ ٱللَّهُ",416],["4:33:7",83,"وَٱلْأَقْرَبُونَ ۚ","and the relatives","مِمَّا تَرَكَ ٱلْوَٰلِدَانِ","وَٱلَّذِينَ عَقَدَتْ أَيْمَـٰنُكُمْ",522],["4:36:10",84,"ٱلْقُرْبَىٰ","the relatives","وَبِٱلْوَٰلِدَيْنِ إِحْسَـٰنًۭا وَبِذِى","وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ وَٱلْجَارِ",602],["4:36:15",84,"ٱلْقُرْبَىٰ","near","وَٱلْمَسَـٰكِينِ وَٱلْجَارِ ذِى","وَٱلْجَارِ ٱلْجُنُبِ وَٱلصَّاحِبِ",602],["4:43:5",85,"تَقْرَبُوا۟","go near","ٱلَّذِينَ ءَامَنُوا۟ لَا","ٱلصَّلَوٰةَ وَأَنتُمْ سُكَـٰرَىٰ",807],["4:77:37",90,"قَرِيبٍۢ ۗ","near","أَخَّرْتَنَآ إِلَىٰٓ أَجَلٍۢ","قُلْ مَتَـٰعُ ٱلدُّنْيَا",416],["4:135:14",100,"وَٱلْأَقْرَبِينَ ۚ","and the relatives","أَنفُسِكُمْ أَوِ ٱلْوَٰلِدَيْنِ","إِن يَكُنْ غَنِيًّا",522],["4:172:10",105,"ٱلْمُقَرَّبُونَ ۚ","the ones who are near (to Allah)","لِّلَّهِ وَلَا ٱلْمَلَـٰٓئِكَةُ","وَمَن يَسْتَنكِفْ عَنْ",990],["5:8:18",108,"أَقْرَبُ","(is) nearer","تَعْدِلُوا۟ ۚ ٱعْدِلُوا۟ هُوَ","لِلتَّقْوَىٰ ۖ وَٱتَّقُوا۟ ٱللَّهَ ۚ",522],["5:27:8",112,"قَرَّبَا","both offered","ءَادَمَ بِٱلْحَقِّ إِذْ","قُرْبَانًۭا فَتُقُبِّلَ مِنْ",1386],["5:27:9",112,"قُرْبَانًۭا","a sacrifice","بِٱلْحَقِّ إِذْ قَرَّبَا","فَتُقُبِّلَ مِنْ أَحَدِهِمَا",1967],["5:82:11",121,"أَقْرَبَهُم","nearest of them","وَٱلَّذِينَ أَشْرَكُوا۟ ۖ وَلَتَجِدَنَّ","مَّوَدَّةًۭ لِّلَّذِينَ ءَامَنُوا۟",522],["5:106:43",125,"قُرْبَىٰ ۙ","a near relative","وَلَوْ كَانَ ذَا","وَلَا نَكْتُمُ شَهَـٰدَةَ",602],["6:151:23",148,"تَقْرَبُوا۟","go near","نَرْزُقُكُمْ وَإِيَّاهُمْ ۖ وَلَا","ٱلْفَوَٰحِشَ مَا ظَهَرَ",807],["6:152:2",149,"تَقْرَبُوا۟","go near","وَلَا","مَالَ ٱلْيَتِيمِ إِلَّا",807],["6:152:27",149,"قُرْبَىٰ ۖ","a near relative","وَلَوْ كَانَ ذَا","وَبِعَهْدِ ٱللَّهِ أَوْفُوا۟ ۚ",602],["7:19:11",152,"تَقْرَبَا","approach [both of you]","حَيْثُ شِئْتُمَا وَلَا","هَـٰذِهِ ٱلشَّجَرَةَ فَتَكُونَا",807],["7:56:13",157,"قَرِيبٌۭ","(is) near","إِنَّ رَحْمَتَ ٱللَّهِ","مِّنَ ٱلْمُحْسِنِينَ",416],["7:114:5",164,"ٱلْمُقَرَّبِينَ","the ones who are near","نَعَمْ وَإِنَّكُمْ لَمِنَ","",990],["7:185:17",174,"ٱقْتَرَبَ","come near","أَن يَكُونَ قَدِ","أَجَلُهُمْ ۖ فَبِأَىِّ حَدِيثٍۭ",1446],["8:41:11",182,"ٱلْقُرْبَىٰ","near relatives","خُمُسَهُۥ وَلِلرَّسُولِ وَلِذِى","وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ وَٱبْنِ",602],["9:28:8",191,"يَقْرَبُوا۟","so let them not come near","ٱلْمُشْرِكُونَ نَجَسٌۭ فَلَا","ٱلْمَسْجِدَ ٱلْحَرَامَ بَعْدَ",807],["9:42:4",194,"قَرِيبًۭا","near","لَوْ كَانَ عَرَضًۭا","وَسَفَرًۭا قَاصِدًۭا لَّٱتَّبَعُوكَ",416],["9:99:11",202,"قُرُبَـٰتٍ","(as) means of nearness","وَيَتَّخِذُ مَا يُنفِقُ","عِندَ ٱللَّهِ وَصَلَوَٰتِ",4148],["9:99:18",202,"قُرْبَةٌۭ","(is) a means of nearness","ٱلرَّسُولِ ۚ أَلَآ إِنَّهَا","لَّهُمْ ۚ سَيُدْخِلُهُمُ ٱللَّهُ",4147],["9:113:12",205,"قُرْبَىٰ","near of kin","وَلَوْ كَانُوٓا۟ أُو۟لِى","مِنۢ بَعْدِ مَا",602],["11:61:26",228,"قَرِيبٌۭ","(is) near","إِلَيْهِ ۚ إِنَّ رَبِّى","مُّجِيبٌۭ",416],["11:64:17",229,"قَرِيبٌۭ","impending","بِسُوٓءٍۢ فَيَأْخُذَكُمْ عَذَابٌۭ","",416],["11:81:29",230,"بِقَرِيبٍۢ","near","ٱلصُّبْحُ ۚ أَلَيْسَ ٱلصُّبْحُ","",416],["12:60:10",242,"تَقْرَبُونِ","you will come near me","لَكُمْ عِندِى وَلَا","",807],["13:31:40",253,"قَرِيبًۭا","close","قَارِعَةٌ أَوْ تَحُلُّ","مِّن دَارِهِمْ حَتَّىٰ",416],["14:44:13",261,"قَرِيبٍۢ","short","أَخِّرْنَآ إِلَىٰٓ أَجَلٍۢ","نُّجِبْ دَعْوَتَكَ وَنَتَّبِعِ",416],["16:77:13",275,"أَقْرَبُ ۚ","(is) nearer","ٱلْبَصَرِ أَوْ هُوَ","إِنَّ ٱللَّهَ عَلَىٰ",522],["16:90:8",277,"ٱلْقُرْبَىٰ","(to) relatives","وَٱلْإِحْسَـٰنِ وَإِيتَآئِ ذِى","وَيَنْهَىٰ عَنِ ٱلْفَحْشَآءِ",602],["17:26:3",284,"ٱلْقُرْبَىٰ","the relatives","وَءَاتِ ذَا","حَقَّهُۥ وَٱلْمِسْكِينَ وَٱبْنَ",602],["17:32:2",285,"تَقْرَبُوا۟","go near","وَلَا","ٱلزِّنَىٰٓ ۖ إِنَّهُۥ كَانَ",807],["17:34:2",285,"تَقْرَبُوا۟","come near","وَلَا","مَالَ ٱلْيَتِيمِ إِلَّا",807],["17:51:25",287,"قَرِيبًۭا","soon","عَسَىٰٓ أَن يَكُونَ","",416],["17:57:9",287,"أَقْرَبُ","(is) nearest","رَبِّهِمُ ٱلْوَسِيلَةَ أَيُّهُمْ","وَيَرْجُونَ رَحْمَتَهُۥ وَيَخَافُونَ",522],["18:24:14",296,"لِأَقْرَبَ","to a nearer (way)","أَن يَهْدِيَنِ رَبِّى","مِنْ هَـٰذَا رَشَدًۭا",522],["18:81:8",302,"وَأَقْرَبَ","and nearer","خَيْرًۭا مِّنْهُ زَكَوٰةًۭ","رُحْمًۭا",522],["19:52:6",309,"وَقَرَّبْنَـٰهُ","and brought him near","جَانِبِ ٱلطُّورِ ٱلْأَيْمَنِ","نَجِيًّۭا",1386],["21:1:1",322,"ٱقْتَرَبَ","(Has) approached","","لِلنَّاسِ حِسَابُهُمْ وَهُمْ",1446],["21:97:1",330,"وَٱقْتَرَبَ","And has approached","","ٱلْوَعْدُ ٱلْحَقُّ فَإِذَا",1446],["21:109:9",331,"أَقَرِيبٌ","whether is near","سَوَآءٍۢ ۖ وَإِنْ أَدْرِىٓ","أَم بَعِيدٌۭ مَّا",416],["22:13:4",333,"أَقْرَبُ","(is) closer","يَدْعُوا۟ لَمَن ضَرُّهُۥٓ","مِن نَّفْعِهِۦ ۚ لَبِئْسَ",522],["24:22:10",352,"ٱلْقُرْبَىٰ","(to) the near of kin","أَن يُؤْتُوٓا۟ أُو۟لِى","وَٱلْمَسَـٰكِينَ وَٱلْمُهَـٰجِرِينَ فِى",602],["26:42:6",369,"ٱلْمُقَرَّبِينَ","the ones who are brought near","وَإِنَّكُمْ إِذًۭا لَّمِنَ","",990],["26:214:3",376,"ٱلْأَقْرَبِينَ","[the] closest","وَأَنذِرْ عَشِيرَتَكَ","",522],["30:38:3",408,"ٱلْقُرْبَىٰ","the relative","فَـَٔاتِ ذَا","حَقَّهُۥ وَٱلْمِسْكِينَ وَٱبْنَ",602],["33:63:15",427,"قَرِيبًا","near","لَعَلَّ ٱلسَّاعَةَ تَكُونُ","",416],["34:37:6",432,"تُقَرِّبُكُمْ","will bring you close","وَلَآ أَوْلَـٰدُكُم بِٱلَّتِى","عِندَنَا زُلْفَىٰٓ إِلَّا",1386],["34:50:16",434,"قَرِيبٌۭ","Ever-Near","رَبِّىٓ ۚ إِنَّهُۥ سَمِيعٌۭ","",416],["34:51:10",434,"قَرِيبٍۢ","near","وَأُخِذُوا۟ مِن مَّكَانٍۢ","",416],["35:18:18",436,"قُرْبَىٰٓ ۗ","near of kin","وَلَوْ كَانَ ذَا","إِنَّمَا تُنذِرُ ٱلَّذِينَ",602],["39:3:13",458,"لِيُقَرِّبُونَآ","that they may bring us near","مَا نَعْبُدُهُمْ إِلَّا","إِلَى ٱللَّهِ زُلْفَىٰٓ",1386],["42:17:11",485,"قَرِيبٌۭ","(is) near","يُدْرِيكَ لَعَلَّ ٱلسَّاعَةَ","",416],["42:23:18",486,"ٱلْقُرْبَىٰ ۗ","the relatives","إِلَّا ٱلْمَوَدَّةَ فِى","وَمَن يَقْتَرِفْ حَسَنَةًۭ",602],["46:28:8",505,"قُرْبَانًا","gods as a way of approach","مِن دُونِ ٱللَّهِ","ءَالِهَةًۢ ۖ بَلْ ضَلُّوا۟",1967],["48:18:19",513,"قَرِيبًۭا","near","عَلَيْهِمْ وَأَثَـٰبَهُمْ فَتْحًۭا","",416],["48:27:28",514,"قَرِيبًا","near","دُونِ ذَٰلِكَ فَتْحًۭا","",416],["50:16:10",519,"أَقْرَبُ","(are) nearer","بِهِۦ نَفْسُهُۥ ۖ وَنَحْنُ","إِلَيْهِ مِنْ حَبْلِ",522],["50:41:7",520,"قَرِيبٍۢ","near","ٱلْمُنَادِ مِن مَّكَانٍۢ","",416],["51:27:1",521,"فَقَرَّبَهُۥٓ","And he placed it near","","إِلَيْهِمْ قَالَ أَلَا",1386],["54:1:1",528,"ٱقْتَرَبَتِ","Has come near","","ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ",1446],["56:11:2",534,"ٱلْمُقَرَّبُونَ","(are) the nearest ones","أُو۟لَـٰٓئِكَ","",990],["56:85:2",537,"أَقْرَبُ","(are) nearer","وَنَحْنُ","إِلَيْهِ مِنكُمْ وَلَـٰكِن",522],["56:88:5",537,"ٱلْمُقَرَّبِينَ","those brought near","إِن كَانَ مِنَ","",990],["59:7:12",546,"ٱلْقُرْبَىٰ","(of) the kindred","فَلِلَّهِ وَلِلرَّسُولِ وَلِذِى","وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ وَٱبْنِ",602],["59:15:5",547,"قَرِيبًۭا ۖ","shortly","ٱلَّذِينَ مِن قَبْلِهِمْ","ذَاقُوا۟ وَبَالَ أَمْرِهِمْ",416],["61:13:7",552,"قَرِيبٌۭ ۗ","near","مِّنَ ٱللَّهِ وَفَتْحٌۭ","وَبَشِّرِ ٱلْمُؤْمِنِينَ",416],["63:10:17",555,"قَرِيبٍۢ","near","أَخَّرْتَنِىٓ إِلَىٰٓ أَجَلٍۢ","فَأَصَّدَّقَ وَأَكُن مِّنَ",416],["70:7:2",568,"قَرِيبًۭا","near","وَنَرَىٰهُ","",416],["72:25:4",573,"أَقَرِيبٌۭ","whether is near","قُلْ إِنْ أَدْرِىٓ","مَّا تُوعَدُونَ أَمْ",416],["78:40:4",583,"قَرِيبًۭا","near","إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًۭا","يَوْمَ يَنظُرُ ٱلْمَرْءُ",416],["83:21:2",588,"ٱلْمُقَرَّبُونَ","those brought near","يَشْهَدُهُ","",990],["83:28:4",588,"ٱلْمُقَرَّبُونَ","those brought near","عَيْنًۭا يَشْرَبُ بِهَا","",990],["90:15:3",594,"مَقْرَبَةٍ","near relationship","يَتِيمًۭا ذَا","",3697],["96:19:5",598,"وَٱقْتَرِب ۩","and draw near (to Allah)","لَا تُطِعْهُ وَٱسْجُدْ","",1446]]