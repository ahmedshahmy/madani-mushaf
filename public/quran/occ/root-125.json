[["2:14:10",3,"شَيَـٰطِينِهِمْ","their evil ones","وَإِذَا خَلَوْا۟ إِلَىٰ","قَالُوٓا۟ إِنَّا مَعَكُمْ",120],["2:36:2",6,"ٱلشَّيْطَـٰنُ","the Shaitaan","فَأَزَلَّهُمَا","عَنْهَا فَأَخْرَجَهُمَا مِمَّا",120],["2:102:4",16,"ٱلشَّيَـٰطِينُ","the devils","وَٱتَّبَعُوا۟ مَا تَتْلُوا۟","عَلَىٰ مُلْكِ سُلَيْمَـٰنَ ۖ",120],["2:102:12",16,"ٱلشَّيَـٰطِينَ","the devils","كَفَرَ سُلَيْمَـٰنُ وَلَـٰكِنَّ","كَفَرُوا۟ يُعَلِّمُونَ ٱلنَّاسَ",120],["2:168:12",25,"ٱلشَّيْطَـٰنِ ۚ","the Shaitaan","وَلَا تَتَّبِعُوا۟ خُطُوَٰتِ","إِنَّهُۥ لَكُمْ عَدُوٌّۭ",120],["2:208:11",32,"ٱلشَّيْطَـٰنِ ۚ","(of) the Shaitaan","وَلَا تَتَّبِعُوا۟ خُطُوَٰتِ","إِنَّهُۥ لَكُمْ عَدُوٌّۭ",120],["2:268:1",45,"ٱلشَّيْطَـٰنُ","The Shaitaan","","يَعِدُكُمُ ٱلْفَقْرَ وَيَأْمُرُكُم",120],["2:275:11",47,"ٱلشَّيْطَـٰنُ","the Shaitaan","يَقُومُ ٱلَّذِى يَتَخَبَّطُهُ","مِنَ ٱلْمَسِّ ۚ ذَٰلِكَ",120],["3:36:23",54,"ٱلشَّيْطَـٰنِ","the Shaitaan","بِكَ وَذُرِّيَّتَهَا مِنَ","ٱلرَّجِيمِ",120],["3:155:10",70,"ٱلشَّيْطَـٰنُ","the Shaitaan","ٱلْجَمْعَانِ إِنَّمَا ٱسْتَزَلَّهُمُ","بِبَعْضِ مَا كَسَبُوا۟ ۖ",120],["3:175:3",73,"ٱلشَّيْطَـٰنُ","the Shaitaan","إِنَّمَا ذَٰلِكُمُ","يُخَوِّفُ أَوْلِيَآءَهُۥ فَلَا",120],["4:38:14",85,"ٱلشَّيْطَـٰنُ","the Shaitaan","ٱلْـَٔاخِرِ ۗ وَمَن يَكُنِ","لَهُۥ قَرِينًۭا فَسَآءَ",120],["4:60:26",88,"ٱلشَّيْطَـٰنُ","the Shaitaan","يَكْفُرُوا۟ بِهِۦ وَيُرِيدُ","أَن يُضِلَّهُمْ ضَلَـٰلًۢا",120],["4:76:15",90,"ٱلشَّيْطَـٰنِ ۖ","(of) the Shaitaan","ٱلطَّـٰغُوتِ فَقَـٰتِلُوٓا۟ أَوْلِيَآءَ","إِنَّ كَيْدَ ٱلشَّيْطَـٰنِ",120],["4:76:18",90,"ٱلشَّيْطَـٰنِ","(of) the Shaitaan","ٱلشَّيْطَـٰنِ ۖ إِنَّ كَيْدَ","كَانَ ضَعِيفًا",120],["4:83:28",91,"ٱلشَّيْطَـٰنَ","the Shaitaan","عَلَيْكُمْ وَرَحْمَتُهُۥ لَٱتَّبَعْتُمُ","إِلَّا قَلِيلًۭا",120],["4:117:10",97,"شَيْطَـٰنًۭا","Shaitaan","وَإِن يَدْعُونَ إِلَّا","مَّرِيدًۭا",120],["4:119:13",97,"ٱلشَّيْطَـٰنَ","the Shaitaan","ٱللَّهِ ۚ وَمَن يَتَّخِذِ","وَلِيًّۭا مِّن دُونِ",120],["4:120:5",97,"ٱلشَّيْطَـٰنُ","the Shaitaan","وَيُمَنِّيهِمْ ۖ وَمَا يَعِدُهُمُ","إِلَّا غُرُورًا",120],["5:90:12",122,"ٱلشَّيْطَـٰنِ","(of) the Shaitaan","رِجْسٌۭ مِّنْ عَمَلِ","فَٱجْتَنِبُوهُ لَعَلَّكُمْ تُفْلِحُونَ",120],["5:91:3",123,"ٱلشَّيْطَـٰنُ","the Shaitaan","إِنَّمَا يُرِيدُ","أَن يُوقِعَ بَيْنَكُمُ",120],["6:43:11",132,"ٱلشَّيْطَـٰنُ","the Shaitaan","قُلُوبُهُمْ وَزَيَّنَ لَهُمُ","مَا كَانُوا۟ يَعْمَلُونَ",120],["6:68:16",135,"ٱلشَّيْطَـٰنُ","the Shaitaan","غَيْرِهِۦ ۚ وَإِمَّا يُنسِيَنَّكَ","فَلَا تَقْعُدْ بَعْدَ",120],["6:71:20",136,"ٱلشَّيَـٰطِينُ","(by) the Shaitaan","ٱللَّهُ كَٱلَّذِى ٱسْتَهْوَتْهُ","فِى ٱلْأَرْضِ حَيْرَانَ",120],["6:112:6",142,"شَيَـٰطِينَ","devils","لِكُلِّ نَبِىٍّ عَدُوًّۭا","ٱلْإِنسِ وَٱلْجِنِّ يُوحِى",120],["6:121:12",143,"ٱلشَّيَـٰطِينَ","the devils","وَإِنَّهُۥ لَفِسْقٌۭ ۗ وَإِنَّ","لَيُوحُونَ إِلَىٰٓ أَوْلِيَآئِهِمْ",120],["6:142:12",146,"ٱلشَّيْطَـٰنِ ۚ","(of) Shaitaan","وَلَا تَتَّبِعُوا۟ خُطُوَٰتِ","إِنَّهُۥ لَكُمْ عَدُوٌّۭ",120],["7:20:3",152,"ٱلشَّيْطَـٰنُ","the Shaitaan","فَوَسْوَسَ لَهُمَا","لِيُبْدِىَ لَهُمَا مَا",120],["7:22:25",152,"ٱلشَّيْطَـٰنَ","[the] Shaitaan","وَأَقُل لَّكُمَآ إِنَّ","لَكُمَا عَدُوٌّۭ مُّبِينٌۭ",120],["7:27:5",153,"ٱلشَّيْطَـٰنُ","[the] Shaitaan","ءَادَمَ لَا يَفْتِنَنَّكُمُ","كَمَآ أَخْرَجَ أَبَوَيْكُم",120],["7:27:26",153,"ٱلشَّيَـٰطِينَ","the devils","تَرَوْنَهُمْ ۗ إِنَّا جَعَلْنَا","أَوْلِيَآءَ لِلَّذِينَ لَا",120],["7:30:9",153,"ٱلشَّيَـٰطِينَ","the devils","ٱلضَّلَـٰلَةُ ۗ إِنَّهُمُ ٱتَّخَذُوا۟","أَوْلِيَآءَ مِن دُونِ",120],["7:175:10",173,"ٱلشَّيْطَـٰنُ","the Shaitaan","فَٱنسَلَخَ مِنْهَا فَأَتْبَعَهُ","فَكَانَ مِنَ ٱلْغَاوِينَ",120],["7:200:4",176,"ٱلشَّيْطَـٰنِ","[the] Shaitaan","وَإِمَّا يَنزَغَنَّكَ مِنَ","نَزْغٌۭ فَٱسْتَعِذْ بِٱللَّهِ ۚ",120],["7:201:8",176,"ٱلشَّيْطَـٰنِ","the Shaitaan","مَسَّهُمْ طَـٰٓئِفٌۭ مِّنَ","تَذَكَّرُوا۟ فَإِذَا هُم",120],["8:11:16",178,"ٱلشَّيْطَـٰنِ","(of) the Shaitaan","وَيُذْهِبَ عَنكُمْ رِجْزَ","وَلِيَرْبِطَ عَلَىٰ قُلُوبِكُمْ",120],["8:48:4",183,"ٱلشَّيْطَـٰنُ","the Shaitaan","وَإِذْ زَيَّنَ لَهُمُ","أَعْمَـٰلَهُمْ وَقَالَ لَا",120],["12:5:12",236,"ٱلشَّيْطَـٰنَ","the Shaitaan","لَكَ كَيْدًا ۖ إِنَّ","لِلْإِنسَـٰنِ عَدُوٌّۭ مُّبِينٌۭ",120],["12:42:11",240,"ٱلشَّيْطَـٰنُ","the Shaitaan","عِندَ رَبِّكَ فَأَنسَىٰهُ","ذِكْرَ رَبِّهِۦ فَلَبِثَ",120],["12:100:34",247,"ٱلشَّيْطَـٰنُ","the Shaitaan","بَعْدِ أَن نَّزَغَ","بَيْنِى وَبَيْنَ إِخْوَتِىٓ ۚ",120],["14:22:2",258,"ٱلشَّيْطَـٰنُ","the Shaitaan","وَقَالَ","لَمَّا قُضِىَ ٱلْأَمْرُ",120],["15:17:4",263,"شَيْطَـٰنٍۢ","devil","وَحَفِظْنَـٰهَا مِن كُلِّ","رَّجِيمٍ",120],["16:63:10",273,"ٱلشَّيْطَـٰنُ","the Shaitaan","قَبْلِكَ فَزَيَّنَ لَهُمُ","أَعْمَـٰلَهُمْ فَهُوَ وَلِيُّهُمُ",120],["16:98:7",278,"ٱلشَّيْطَـٰنِ","the Shaitaan","فَٱسْتَعِذْ بِٱللَّهِ مِنَ","ٱلرَّجِيمِ",120],["17:27:5",284,"ٱلشَّيَـٰطِينِ ۖ","(of) the devils","ٱلْمُبَذِّرِينَ كَانُوٓا۟ إِخْوَٰنَ","وَكَانَ ٱلشَّيْطَـٰنُ لِرَبِّهِۦ",120],["17:27:7",284,"ٱلشَّيْطَـٰنُ","the Shaitaan","إِخْوَٰنَ ٱلشَّيَـٰطِينِ ۖ وَكَانَ","لِرَبِّهِۦ كَفُورًۭا",120],["17:53:8",287,"ٱلشَّيْطَـٰنَ","the Shaitaan","هِىَ أَحْسَنُ ۚ إِنَّ","يَنزَغُ بَيْنَهُمْ ۚ إِنَّ",120],["17:53:12",287,"ٱلشَّيْطَـٰنَ","the Shaitaan","يَنزَغُ بَيْنَهُمْ ۚ إِنَّ","كَانَ لِلْإِنسَـٰنِ عَدُوًّۭا",120],["17:64:17",288,"ٱلشَّيْطَـٰنُ","the Shaitaan","وَعِدْهُمْ ۚ وَمَا يَعِدُهُمُ","إِلَّا غُرُورًا",120],["18:63:13",301,"ٱلشَّيْطَـٰنُ","the Shaitaan","وَمَآ أَنسَىٰنِيهُ إِلَّا","أَنْ أَذْكُرَهُۥ ۚ وَٱتَّخَذَ",120],["19:44:4",308,"ٱلشَّيْطَـٰنَ ۖ","the Shaitaan","يَـٰٓأَبَتِ لَا تَعْبُدِ","إِنَّ ٱلشَّيْطَـٰنَ كَانَ",120],["19:44:6",308,"ٱلشَّيْطَـٰنَ","the Shaitaan","تَعْبُدِ ٱلشَّيْطَـٰنَ ۖ إِنَّ","كَانَ لِلرَّحْمَـٰنِ عَصِيًّۭا",120],["19:45:10",308,"لِلشَّيْطَـٰنِ","to the Shaitaan","مِّنَ ٱلرَّحْمَـٰنِ فَتَكُونَ","وَلِيًّۭا",120],["19:68:3",310,"وَٱلشَّيَـٰطِينَ","and the devils","فَوَرَبِّكَ لَنَحْشُرَنَّهُمْ","ثُمَّ لَنُحْضِرَنَّهُمْ حَوْلَ",120],["19:83:5",311,"ٱلشَّيَـٰطِينَ","the devils","تَرَ أَنَّآ أَرْسَلْنَا","عَلَى ٱلْكَـٰفِرِينَ تَؤُزُّهُمْ",120],["20:120:3",320,"ٱلشَّيْطَـٰنُ","Shaitaan","فَوَسْوَسَ إِلَيْهِ","قَالَ يَـٰٓـَٔادَمُ هَلْ",120],["21:82:2",329,"ٱلشَّيَـٰطِينِ","the devils","وَمِنَ","مَن يَغُوصُونَ لَهُۥ",120],["22:3:11",332,"شَيْطَـٰنٍۢ","devil","عِلْمٍۢ وَيَتَّبِعُ كُلَّ","مَّرِيدٍۢ",120],["22:52:13",338,"ٱلشَّيْطَـٰنُ","the Shaitaan","إِذَا تَمَنَّىٰٓ أَلْقَى","فِىٓ أُمْنِيَّتِهِۦ فَيَنسَخُ",120],["22:52:20",338,"ٱلشَّيْطَـٰنُ","the Shaitaan","ٱللَّهُ مَا يُلْقِى","ثُمَّ يُحْكِمُ ٱللَّهُ",120],["22:53:4",338,"ٱلشَّيْطَـٰنُ","the Shaitaan throws","لِّيَجْعَلَ مَا يُلْقِى","فِتْنَةًۭ لِّلَّذِينَ فِى",120],["23:97:7",348,"ٱلشَّيَـٰطِينِ","(of) the evil ones","بِكَ مِنْ هَمَزَٰتِ","",120],["24:21:7",352,"ٱلشَّيْطَـٰنِ ۚ","(of) the Shaitaan","لَا تَتَّبِعُوا۟ خُطُوَٰتِ","وَمَن يَتَّبِعْ خُطُوَٰتِ",120],["24:21:11",352,"ٱلشَّيْطَـٰنِ","(of) the Shaitaan","وَمَن يَتَّبِعْ خُطُوَٰتِ","فَإِنَّهُۥ يَأْمُرُ بِٱلْفَحْشَآءِ",120],["25:29:9",362,"ٱلشَّيْطَـٰنُ","the Shaitaan","إِذْ جَآءَنِى ۗ وَكَانَ","لِلْإِنسَـٰنِ خَذُولًۭا",120],["26:210:4",376,"ٱلشَّيَـٰطِينُ","the devils","وَمَا تَنَزَّلَتْ بِهِ","",120],["26:221:6",376,"ٱلشَّيَـٰطِينُ","the devils","عَلَىٰ مَن تَنَزَّلُ","",120],["27:24:10",379,"ٱلشَّيْطَـٰنُ","the Shaitaan","ٱللَّهِ وَزَيَّنَ لَهُمُ","أَعْمَـٰلَهُمْ فَصَدَّهُمْ عَنِ",120],["28:15:34",387,"ٱلشَّيْطَـٰنِ ۖ","(of) Shaitaan","هَـٰذَا مِنْ عَمَلِ","إِنَّهُۥ عَدُوٌّۭ مُّضِلٌّۭ",120],["29:38:10",400,"ٱلشَّيْطَـٰنُ","the Shaitaan","مَّسَـٰكِنِهِمْ ۖ وَزَيَّنَ لَهُمُ","أَعْمَـٰلَهُمْ فَصَدَّهُمْ عَنِ",120],["31:21:17",413,"ٱلشَّيْطَـٰنُ","Shaitaan was","ءَابَآءَنَآ ۚ أَوَلَوْ كَانَ","يَدْعُوهُمْ إِلَىٰ عَذَابِ",120],["35:6:2",435,"ٱلشَّيْطَـٰنَ","the Shaitaan","إِنَّ","لَكُمْ عَدُوٌّۭ فَٱتَّخِذُوهُ",120],["36:60:9",444,"ٱلشَّيْطَـٰنَ ۖ","the Shaitaan","أَن لَّا تَعْبُدُوا۟","إِنَّهُۥ لَكُمْ عَدُوٌّۭ",120],["37:7:4",446,"شَيْطَـٰنٍۢ","devil","وَحِفْظًۭا مِّن كُلِّ","مَّارِدٍۢ",120],["37:65:4",448,"ٱلشَّيَـٰطِينِ","(of) the devils","طَلْعُهَا كَأَنَّهُۥ رُءُوسُ","",120],["38:37:1",455,"وَٱلشَّيَـٰطِينَ","And the devils","","كُلَّ بَنَّآءٍۢ وَغَوَّاصٍۢ",120],["38:41:9",455,"ٱلشَّيْطَـٰنُ","Shaitaan","رَبَّهُۥٓ أَنِّى مَسَّنِىَ","بِنُصْبٍۢ وَعَذَابٍ",120],["41:36:4",480,"ٱلشَّيْطَـٰنِ","the Shaitaan","وَإِمَّا يَنزَغَنَّكَ مِنَ","نَزْغٌۭ فَٱسْتَعِذْ بِٱللَّهِ ۖ",120],["43:36:8",492,"شَيْطَـٰنًۭا","a devil","ٱلرَّحْمَـٰنِ نُقَيِّضْ لَهُۥ","فَهُوَ لَهُۥ قَرِينٌۭ",120],["43:62:3",494,"ٱلشَّيْطَـٰنُ ۖ","the Shaitaan","وَلَا يَصُدَّنَّكُمُ","إِنَّهُۥ لَكُمْ عَدُوٌّۭ",120],["47:25:12",509,"ٱلشَّيْطَـٰنُ","Shaitaan","تَبَيَّنَ لَهُمُ ٱلْهُدَى ۙ","سَوَّلَ لَهُمْ وَأَمْلَىٰ",120],["58:10:4",543,"ٱلشَّيْطَـٰنِ","the Shaitaan","إِنَّمَا ٱلنَّجْوَىٰ مِنَ","لِيَحْزُنَ ٱلَّذِينَ ءَامَنُوا۟",120],["58:19:3",544,"ٱلشَّيْطَـٰنُ","the Shaitaan","ٱسْتَحْوَذَ عَلَيْهِمُ","فَأَنسَىٰهُمْ ذِكْرَ ٱللَّهِ ۚ",120],["58:19:9",544,"ٱلشَّيْطَـٰنِ ۚ","(of) the Shaitaan","ٱللَّهِ ۚ أُو۟لَـٰٓئِكَ حِزْبُ","أَلَآ إِنَّ حِزْبَ",120],["58:19:13",544,"ٱلشَّيْطَـٰنِ","(of) the Shaitaan","أَلَآ إِنَّ حِزْبَ","هُمُ ٱلْخَـٰسِرُونَ",120],["59:16:2",547,"ٱلشَّيْطَـٰنِ","(of) the Shaitaan","كَمَثَلِ","إِذْ قَالَ لِلْإِنسَـٰنِ",120],["67:5:8",562,"لِّلشَّيَـٰطِينِ ۖ","for the devils","بِمَصَـٰبِيحَ وَجَعَلْنَـٰهَا رُجُومًۭا","وَأَعْتَدْنَا لَهُمْ عَذَابَ",120],["81:25:4",586,"شَيْطَـٰنٍۢ","(of) Shaitaan","وَمَا هُوَ بِقَوْلِ","رَّجِيمٍۢ",120]]