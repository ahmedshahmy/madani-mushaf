[["4:10:12",78,"وَسَيَصْلَوْنَ","and they will be burned","فِى بُطُونِهِمْ نَارًۭا ۖ","سَعِيرًۭا",703],["4:30:7",83,"نُصْلِيهِ","We (will) cast him","عُدْوَٰنًۭا وَظُلْمًۭا فَسَوْفَ","نَارًۭا ۚ وَكَانَ ذَٰلِكَ",1488],["4:56:6",87,"نُصْلِيهِمْ","We will burn them","كَفَرُوا۟ بِـَٔايَـٰتِنَا سَوْفَ","نَارًۭا كُلَّمَا نَضِجَتْ",1488],["4:115:17",97,"وَنُصْلِهِۦ","and We will burn him","نُوَلِّهِۦ مَا تَوَلَّىٰ","جَهَنَّمَ ۖ وَسَآءَتْ مَصِيرًا",1488],["14:29:2",259,"يَصْلَوْنَهَا ۖ","(in) it they will burn","جَهَنَّمَ","وَبِئْسَ ٱلْقَرَارُ",703],["17:18:16",284,"يَصْلَىٰهَا","he will burn","جَعَلْنَا لَهُۥ جَهَنَّمَ","مَذْمُومًۭا مَّدْحُورًۭا",703],["19:70:8",310,"صِلِيًّۭا","(of) being burnt","هُمْ أَوْلَىٰ بِهَا","",3264],["27:7:16",377,"تَصْطَلُونَ","warm yourselves","بِشِهَابٍۢ قَبَسٍۢ لَّعَلَّكُمْ","",2655],["28:29:27",389,"تَصْطَلُونَ","warm yourselves","مِّنَ ٱلنَّارِ لَعَلَّكُمْ","",2655],["36:64:1",444,"ٱصْلَوْهَا","Burn therein","","ٱلْيَوْمَ بِمَا كُنتُمْ",703],["37:163:4",452,"صَالِ","(is) to burn","إِلَّا مَنْ هُوَ","ٱلْجَحِيمِ",3231],["38:56:2",456,"يَصْلَوْنَهَا","they will burn therein","جَهَنَّمَ","فَبِئْسَ ٱلْمِهَادُ",703],["38:59:9",456,"صَالُوا۟","(will) burn","مَرْحَبًۢا بِهِمْ ۚ إِنَّهُمْ","ٱلنَّارِ",2285],["52:16:1",524,"ٱصْلَوْهَا","Burn in it","","فَٱصْبِرُوٓا۟ أَوْ لَا",703],["56:94:1",537,"وَتَصْلِيَةُ","And burning","","جَحِيمٍ",4343],["58:8:36",543,"يَصْلَوْنَهَا ۖ","they will burn in it","نَقُولُ ۚ حَسْبُهُمْ جَهَنَّمُ","فَبِئْسَ ٱلْمَصِيرُ",703],["69:31:3",567,"صَلُّوهُ","burn him","ثُمَّ ٱلْجَحِيمَ","",3248],["74:26:1",576,"سَأُصْلِيهِ","Soon I will drive him","","سَقَرَ",1488],["82:15:1",587,"يَصْلَوْنَهَا","They will burn (in) it","","يَوْمَ ٱلدِّينِ",703],["83:16:3",588,"لَصَالُوا۟","(surely) will burn","ثُمَّ إِنَّهُمْ","ٱلْجَحِيمِ",2285],["84:12:1",589,"وَيَصْلَىٰ","And he will burn","","سَعِيرًا",703],["87:12:2",592,"يَصْلَى","will burn","ٱلَّذِى","ٱلنَّارَ ٱلْكُبْرَىٰ",703],["88:4:1",592,"تَصْلَىٰ","They will burn","","نَارًا حَامِيَةًۭ",703],["92:15:2",596,"يَصْلَىٰهَآ","will burn (in) it","لَا","إِلَّا ٱلْأَشْقَى",703],["111:3:1",603,"سَيَصْلَىٰ","He will be burnt","","نَارًۭا ذَاتَ لَهَبٍۢ",703]]