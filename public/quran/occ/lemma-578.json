[["2:102:7",16,"سُلَيْمَـٰنَ ۖ","(of) Sulaiman","ٱلشَّيَـٰطِينُ عَلَىٰ مُلْكِ","وَمَا كَفَرَ سُلَيْمَـٰنُ",578],["2:102:10",16,"سُلَيْمَـٰنُ","Sulaiman","سُلَيْمَـٰنَ ۖ وَمَا كَفَرَ","وَلَـٰكِنَّ ٱلشَّيَـٰطِينَ كَفَرُوا۟",578],["4:163:22",104,"وَسُلَيْمَـٰنَ ۚ","and Sulaiman","وَأَيُّوبَ وَيُونُسَ وَهَـٰرُونَ","وَءَاتَيْنَا دَاوُۥدَ زَبُورًۭا",578],["6:84:14",138,"وَسُلَيْمَـٰنَ","and Sulaiman","وَمِن ذُرِّيَّتِهِۦ دَاوُۥدَ","وَأَيُّوبَ وَيُوسُفَ وَمُوسَىٰ",578],["21:78:2",328,"وَسُلَيْمَـٰنَ","and Sulaiman","وَدَاوُۥدَ","إِذْ يَحْكُمَانِ فِى",578],["21:79:2",328,"سُلَيْمَـٰنَ ۚ","(to) Sulaiman","فَفَهَّمْنَـٰهَا","وَكُلًّا ءَاتَيْنَا حُكْمًۭا",578],["21:81:1",328,"وَلِسُلَيْمَـٰنَ","And to Sulaiman","","ٱلرِّيحَ عَاصِفَةًۭ تَجْرِى",578],["27:15:4",378,"وَسُلَيْمَـٰنَ","and Sulaiman","وَلَقَدْ ءَاتَيْنَا دَاوُۥدَ","عِلْمًۭا ۖ وَقَالَا ٱلْحَمْدُ",578],["27:16:2",378,"سُلَيْمَـٰنُ","Sulaiman","وَوَرِثَ","دَاوُۥدَ ۖ وَقَالَ يَـٰٓأَيُّهَا",578],["27:17:2",378,"لِسُلَيْمَـٰنَ","for Sulaiman","وَحُشِرَ","جُنُودُهُۥ مِنَ ٱلْجِنِّ",578],["27:18:15",378,"سُلَيْمَـٰنُ","Sulaiman","مَسَـٰكِنَكُمْ لَا يَحْطِمَنَّكُمْ","وَجُنُودُهُۥ وَهُمْ لَا",578],["27:30:3",379,"سُلَيْمَـٰنَ","Sulaiman","إِنَّهُۥ مِن","وَإِنَّهُۥ بِسْمِ ٱللَّهِ",578],["27:36:3",380,"سُلَيْمَـٰنَ","(to) Sulaiman","فَلَمَّا جَآءَ","قَالَ أَتُمِدُّونَنِ بِمَالٍۢ",578],["27:44:25",380,"سُلَيْمَـٰنَ","Sulaiman","نَفْسِى وَأَسْلَمْتُ مَعَ","لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ",578],["34:12:1",429,"وَلِسُلَيْمَـٰنَ","And to Sulaiman","","ٱلرِّيحَ غُدُوُّهَا شَهْرٌۭ",578],["38:30:3",455,"سُلَيْمَـٰنَ ۚ","Sulaiman","وَوَهَبْنَا لِدَاوُۥدَ","نِعْمَ ٱلْعَبْدُ ۖ إِنَّهُۥٓ",578],["38:34:3",455,"سُلَيْمَـٰنَ","Sulaiman","وَلَقَدْ فَتَنَّا","وَأَلْقَيْنَا عَلَىٰ كُرْسِيِّهِۦ",578]]