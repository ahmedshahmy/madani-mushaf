[["17:92:7",291,"كِسَفًا","(in) pieces","كَمَا زَعَمْتَ عَلَيْنَا","أَوْ تَأْتِىَ بِٱللَّهِ",1571],["26:187:3",375,"كِسَفًۭا","fragments","فَأَسْقِطْ عَلَيْنَا","مِّنَ ٱلسَّمَآءِ إِن",1571],["30:48:13",409,"كِسَفًۭا","fragments","كَيْفَ يَشَآءُ وَيَجْعَلُهُۥ","فَتَرَى ٱلْوَدْقَ يَخْرُجُ",1571],["34:9:20",429,"كِسَفًۭا","fragments","أَوْ نُسْقِطْ عَلَيْهِمْ","مِّنَ ٱلسَّمَآءِ ۚ إِنَّ",1571],["52:44:3",525,"كِسْفًۭا","a portion","وَإِن يَرَوْا۟","مِّنَ ٱلسَّمَآءِ سَاقِطًۭا",3579]]