[["2:225:4",36,"بِٱللَّغْوِ","for (what is) unintentional","لَّا يُؤَاخِذُكُمُ ٱللَّهُ","فِىٓ أَيْمَـٰنِكُمْ وَلَـٰكِن",906],["5:89:4",122,"بِٱللَّغْوِ","for the thoughtless utterances","لَا يُؤَاخِذُكُمُ ٱللَّهُ","فِىٓ أَيْمَـٰنِكُمْ وَلَـٰكِن",906],["19:62:4",309,"لَغْوًا","vain talk","لَّا يَسْمَعُونَ فِيهَا","إِلَّا سَلَـٰمًۭا ۖ وَلَهُمْ",906],["23:3:4",342,"ٱللَّغْوِ","the vain talk","وَٱلَّذِينَ هُمْ عَنِ","مُعْرِضُونَ",906],["25:72:7",366,"بِٱللَّغْوِ","by futility","ٱلزُّورَ وَإِذَا مَرُّوا۟","مَرُّوا۟ كِرَامًۭا",906],["28:55:3",392,"ٱللَّغْوَ","vain talk","وَإِذَا سَمِعُوا۟","أَعْرَضُوا۟ عَنْهُ وَقَالُوا۟",906],["41:26:8",479,"وَٱلْغَوْا۟","and make noise","تَسْمَعُوا۟ لِهَـٰذَا ٱلْقُرْءَانِ","فِيهِ لَعَلَّكُمْ تَغْلِبُونَ",4803],["52:23:5",524,"لَغْوٌۭ","ill speech","فِيهَا كَأْسًۭا لَّا","فِيهَا وَلَا تَأْثِيمٌۭ",906],["56:25:4",535,"لَغْوًۭا","vain talk","لَا يَسْمَعُونَ فِيهَا","وَلَا تَأْثِيمًا",906],["78:35:4",583,"لَغْوًۭا","any vain talk","لَّا يَسْمَعُونَ فِيهَا","وَلَا كِذَّٰبًۭا",906],["88:11:4",592,"لَـٰغِيَةًۭ","vain talk","لَّا تَسْمَعُ فِيهَا","",3595]]