[["3:125:7",66,"فَوْرِهِمْ","suddenly","وَتَتَّقُوا۟ وَيَأْتُوكُم مِّن","هَـٰذَا يُمْدِدْكُمْ رَبُّكُم",3430],["11:40:5",226,"وَفَارَ","and overflowed","إِذَا جَآءَ أَمْرُنَا","ٱلتَّنُّورُ قُلْنَا ٱحْمِلْ",1824],["23:27:11",343,"وَفَارَ","and gushes forth","فَإِذَا جَآءَ أَمْرُنَا","ٱلتَّنُّورُ ۙ فَٱسْلُكْ فِيهَا",1824],["67:7:8",562,"تَفُورُ","boils up","لَهَا شَهِيقًۭا وَهِىَ","",1824]]