[["18:71:6",301,"ٱلسَّفِينَةِ","the ship","إِذَا رَكِبَا فِى","خَرَقَهَا ۖ قَالَ أَخَرَقْتَهَا",1636],["18:79:2",302,"ٱلسَّفِينَةُ","the ship","أَمَّا","فَكَانَتْ لِمَسَـٰكِينَ يَعْمَلُونَ",1636],["18:79:16",302,"سَفِينَةٍ","ship","مَّلِكٌۭ يَأْخُذُ كُلَّ","غَصْبًۭا",1636],["29:15:3",398,"ٱلسَّفِينَةِ","(of) the ship","فَأَنجَيْنَـٰهُ وَأَصْحَـٰبَ","وَجَعَلْنَـٰهَآ ءَايَةًۭ لِّلْعَـٰلَمِينَ",1636]]