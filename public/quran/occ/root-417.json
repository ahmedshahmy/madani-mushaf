[["4:10:13",78,"سَعِيرًۭا","(in) a Blazing Fire","بُطُونِهِمْ نَارًۭا ۖ وَسَيَصْلَوْنَ","",604],["4:55:11",87,"سَعِيرًا","(as a) Blazing Fire","عَنْهُ ۚ وَكَفَىٰ بِجَهَنَّمَ","",604],["17:97:27",292,"سَعِيرًۭا","the blazing fire","كُلَّمَا خَبَتْ زِدْنَـٰهُمْ","",604],["22:4:11",332,"ٱلسَّعِيرِ","(of) the Blaze","وَيَهْدِيهِ إِلَىٰ عَذَابِ","",604],["25:11:8",360,"سَعِيرًا","a Blazing Fire","لِمَن كَذَّبَ بِٱلسَّاعَةِ","",604],["31:21:21",413,"ٱلسَّعِيرِ","(of) the Blaze","يَدْعُوهُمْ إِلَىٰ عَذَابِ","",604],["33:64:7",427,"سَعِيرًا","a Blaze","ٱلْكَـٰفِرِينَ وَأَعَدَّ لَهُمْ","",604],["34:12:27",429,"ٱلسَّعِيرِ","(of) the Blaze","نُذِقْهُ مِنْ عَذَابِ","",604],["35:6:13",435,"ٱلسَّعِيرِ","(of) the Blaze","لِيَكُونُوا۟ مِنْ أَصْحَـٰبِ","",604],["42:7:22",483,"ٱلسَّعِيرِ","the Blazing Fire","ٱلْجَنَّةِ وَفَرِيقٌۭ فِى","",604],["48:13:9",512,"سَعِيرًۭا","a Blazing Fire","فَإِنَّآ أَعْتَدْنَا لِلْكَـٰفِرِينَ","",604],["54:24:10",529,"وَسُعُرٍ","and madness","إِذًۭا لَّفِى ضَلَـٰلٍۢ","",2641],["54:47:5",530,"وَسُعُرٍۢ","and madness","ٱلْمُجْرِمِينَ فِى ضَلَـٰلٍۢ","",2641],["67:5:12",562,"ٱلسَّعِيرِ","(of) the Blaze","وَأَعْتَدْنَا لَهُمْ عَذَابَ","",604],["67:10:11",562,"ٱلسَّعِيرِ","(of) the Blaze","كُنَّا فِىٓ أَصْحَـٰبِ","",604],["67:11:5",562,"ٱلسَّعِيرِ","(of) the Blaze","بِذَنۢبِهِمْ فَسُحْقًۭا لِّأَصْحَـٰبِ","",604],["76:4:6",578,"وَسَعِيرًا","and a Blazing Fire","لِلْكَـٰفِرِينَ سَلَـٰسِلَا۟ وَأَغْلَـٰلًۭا","",604],["81:12:3",586,"سُعِّرَتْ","is set ablaze","وَإِذَا ٱلْجَحِيمُ","",4273],["84:12:2",589,"سَعِيرًا","(in) a Blaze","وَيَصْلَىٰ","",604]]