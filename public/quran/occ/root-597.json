[["8:12:19",178,"ٱلْأَعْنَاقِ","the necks","ٱلرُّعْبَ فَٱضْرِبُوا۟ فَوْقَ","وَٱضْرِبُوا۟ مِنْهُمْ كُلَّ",886],["13:5:19",249,"أَعْنَاقِهِمْ ۖ","their necks","وَأُو۟لَـٰٓئِكَ ٱلْأَغْلَـٰلُ فِىٓ","وَأُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ ۖ",886],["17:13:6",283,"عُنُقِهِۦ ۖ","his neck","أَلْزَمْنَـٰهُ طَـٰٓئِرَهُۥ فِى","وَنُخْرِجُ لَهُۥ يَوْمَ",886],["17:29:6",285,"عُنُقِكَ","your neck","يَدَكَ مَغْلُولَةً إِلَىٰ","وَلَا تَبْسُطْهَا كُلَّ",886],["26:4:9",367,"أَعْنَـٰقُهُمْ","their necks","ٱلسَّمَآءِ ءَايَةًۭ فَظَلَّتْ","لَهَا خَـٰضِعِينَ",886],["34:33:26",432,"أَعْنَاقِ","(the) necks","وَجَعَلْنَا ٱلْأَغْلَـٰلَ فِىٓ","ٱلَّذِينَ كَفَرُوا۟ ۚ هَلْ",886],["36:8:4",440,"أَعْنَـٰقِهِمْ","their necks","إِنَّا جَعَلْنَا فِىٓ","أَغْلَـٰلًۭا فَهِىَ إِلَى",886],["38:33:6",455,"وَٱلْأَعْنَاقِ","and the necks","فَطَفِقَ مَسْحًۢا بِٱلسُّوقِ","",886],["40:71:4",475,"أَعْنَـٰقِهِمْ","their necks","إِذِ ٱلْأَغْلَـٰلُ فِىٓ","وَٱلسَّلَـٰسِلُ يُسْحَبُونَ",886]]