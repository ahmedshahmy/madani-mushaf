[["2:23:13",4,"وَٱدْعُوا۟","and call","بِسُورَةٍۢ مِّن مِّثْلِهِۦ","شُهَدَآءَكُم مِّن دُونِ",65],["2:61:9",9,"فَٱدْعُ","so pray","عَلَىٰ طَعَامٍۢ وَٰحِدٍۢ","لَنَا رَبَّكَ يُخْرِجْ",65],["2:68:2",10,"ٱدْعُ","Pray","قَالُوا۟","لَنَا رَبَّكَ يُبَيِّن",65],["2:69:2",10,"ٱدْعُ","Pray","قَالُوا۟","لَنَا رَبَّكَ يُبَيِّن",65],["2:70:2",11,"ٱدْعُ","Pray","قَالُوا۟","لَنَا رَبَّكَ يُبَيِّن",65],["2:171:11",26,"دُعَآءًۭ","calls","لَا يَسْمَعُ إِلَّا","وَنِدَآءًۭ ۚ صُمٌّۢ بُكْمٌ",466],["2:186:8",28,"دَعْوَةَ","(to the) invocation","فَإِنِّى قَرِيبٌ ۖ أُجِيبُ","ٱلدَّاعِ إِذَا دَعَانِ ۖ",1173],["2:186:9",28,"ٱلدَّاعِ","(of) the supplicant","قَرِيبٌ ۖ أُجِيبُ دَعْوَةَ","إِذَا دَعَانِ ۖ فَلْيَسْتَجِيبُوا۟",1822],["2:186:11",28,"دَعَانِ ۖ","he calls Me","دَعْوَةَ ٱلدَّاعِ إِذَا","فَلْيَسْتَجِيبُوا۟ لِى وَلْيُؤْمِنُوا۟",65],["2:221:26",35,"يَدْعُونَ","they invite","وَلَوْ أَعْجَبَكُمْ ۗ أُو۟لَـٰٓئِكَ","إِلَى ٱلنَّارِ ۖ وَٱللَّهُ",65],["2:221:30",35,"يَدْعُوٓا۟","invites","إِلَى ٱلنَّارِ ۖ وَٱللَّهُ","إِلَى ٱلْجَنَّةِ وَٱلْمَغْفِرَةِ",65],["2:260:32",44,"ٱدْعُهُنَّ","call them","مِّنْهُنَّ جُزْءًۭا ثُمَّ","يَأْتِينَكَ سَعْيًۭا ۚ وَٱعْلَمْ",65],["2:282:77",48,"دُعُوا۟ ۚ","they are called","ٱلشُّهَدَآءُ إِذَا مَا","وَلَا تَسْـَٔمُوٓا۟ أَن",65],["3:23:9",53,"يُدْعَوْنَ","They are invited","نَصِيبًۭا مِّنَ ٱلْكِتَـٰبِ","إِلَىٰ كِتَـٰبِ ٱللَّهِ",65],["3:38:2",55,"دَعَا","invoked","هُنَالِكَ","زَكَرِيَّا رَبَّهُۥ ۖ قَالَ",65],["3:38:15",55,"ٱلدُّعَآءِ","(of) the prayer","طَيِّبَةً ۖ إِنَّكَ سَمِيعُ","",466],["3:61:12",57,"نَدْعُ","let us call","ٱلْعِلْمِ فَقُلْ تَعَالَوْا۟","أَبْنَآءَنَا وَأَبْنَآءَكُمْ وَنِسَآءَنَا",65],["3:104:4",63,"يَدْعُونَ","inviting","وَلْتَكُن مِّنكُمْ أُمَّةٌۭ","إِلَى ٱلْخَيْرِ وَيَأْمُرُونَ",65],["3:153:8",69,"يَدْعُوكُمْ","was calling you","عَلَىٰٓ أَحَدٍۢ وَٱلرَّسُولُ","فِىٓ أُخْرَىٰكُمْ فَأَثَـٰبَكُمْ",65],["4:117:2",97,"يَدْعُونَ","they invoke","إِن","مِن دُونِهِۦٓ إِلَّآ",65],["4:117:8",97,"يَدْعُونَ","they invoke","إِلَّآ إِنَـٰثًۭا وَإِن","إِلَّا شَيْطَـٰنًۭا مَّرِيدًۭا",65],["6:40:12",132,"تَدْعُونَ","you call","ٱلسَّاعَةُ أَغَيْرَ ٱللَّهِ","إِن كُنتُمْ صَـٰدِقِينَ",65],["6:41:3",132,"تَدْعُونَ","you call","بَلْ إِيَّاهُ","فَيَكْشِفُ مَا تَدْعُونَ",65],["6:41:6",132,"تَدْعُونَ","you call","تَدْعُونَ فَيَكْشِفُ مَا","إِلَيْهِ إِن شَآءَ",65],["6:52:4",133,"يَدْعُونَ","call","وَلَا تَطْرُدِ ٱلَّذِينَ","رَبَّهُم بِٱلْغَدَوٰةِ وَٱلْعَشِىِّ",65],["6:56:7",134,"تَدْعُونَ","you call","أَنْ أَعْبُدَ ٱلَّذِينَ","مِن دُونِ ٱللَّهِ ۚ",65],["6:63:8",135,"تَدْعُونَهُۥ","you call Him","ظُلُمَـٰتِ ٱلْبَرِّ وَٱلْبَحْرِ","تَضَرُّعًۭا وَخُفْيَةًۭ لَّئِنْ",65],["6:71:2",136,"أَنَدْعُوا۟","Shall we call","قُلْ","مِن دُونِ ٱللَّهِ",65],["6:71:26",136,"يَدْعُونَهُۥٓ","who call him","حَيْرَانَ لَهُۥٓ أَصْحَـٰبٌۭ","إِلَى ٱلْهُدَى ٱئْتِنَا ۗ",65],["6:108:4",141,"يَدْعُونَ","they invoke","وَلَا تَسُبُّوا۟ ٱلَّذِينَ","مِن دُونِ ٱللَّهِ",65],["7:5:3",151,"دَعْوَىٰهُمْ","their plea","فَمَا كَانَ","إِذْ جَآءَهُم بَأْسُنَآ",1543],["7:29:10",153,"وَٱدْعُوهُ","and invoke Him","عِندَ كُلِّ مَسْجِدٍۢ","مُخْلِصِينَ لَهُ ٱلدِّينَ ۚ",65],["7:37:25",154,"تَدْعُونَ","invoke","أَيْنَ مَا كُنتُمْ","مِن دُونِ ٱللَّهِ ۖ",65],["7:55:1",157,"ٱدْعُوا۟","Call upon","","رَبَّكُمْ تَضَرُّعًۭا وَخُفْيَةً ۚ",65],["7:56:7",157,"وَٱدْعُوهُ","And call Him","ٱلْأَرْضِ بَعْدَ إِصْلَـٰحِهَا","خَوْفًۭا وَطَمَعًا ۚ إِنَّ",65],["7:134:7",166,"ٱدْعُ","Invoke","ٱلرِّجْزُ قَالُوا۟ يَـٰمُوسَى","لَنَا رَبَّكَ بِمَا",65],["7:180:4",174,"فَٱدْعُوهُ","so invoke Him","وَلِلَّهِ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ","بِهَا ۖ وَذَرُوا۟ ٱلَّذِينَ",65],["7:189:21",175,"دَّعَوَا","they both invoke","بِهِۦ ۖ فَلَمَّآ أَثْقَلَت","ٱللَّهَ رَبَّهُمَا لَئِنْ",65],["7:193:2",175,"تَدْعُوهُمْ","you call them","وَإِن","إِلَى ٱلْهُدَىٰ لَا",65],["7:193:9",175,"أَدَعَوْتُمُوهُمْ","whether you call them","يَتَّبِعُوكُمْ ۚ سَوَآءٌ عَلَيْكُمْ","أَمْ أَنتُمْ صَـٰمِتُونَ",65],["7:194:3",175,"تَدْعُونَ","you call","إِنَّ ٱلَّذِينَ","مِن دُونِ ٱللَّهِ",65],["7:194:9",175,"فَٱدْعُوهُمْ","So invoke them","ٱللَّهِ عِبَادٌ أَمْثَالُكُمْ ۖ","فَلْيَسْتَجِيبُوا۟ لَكُمْ إِن",65],["7:195:21",175,"ٱدْعُوا۟","Call","يَسْمَعُونَ بِهَا ۗ قُلِ","شُرَكَآءَكُمْ ثُمَّ كِيدُونِ",65],["7:197:2",176,"تَدْعُونَ","you invoke","وَٱلَّذِينَ","مِن دُونِهِۦ لَا",65],["7:198:2",176,"تَدْعُوهُمْ","you call them","وَإِن","إِلَى ٱلْهُدَىٰ لَا",65],["8:24:8",179,"دَعَاكُمْ","he calls you","لِلَّهِ وَلِلرَّسُولِ إِذَا","لِمَا يُحْيِيكُمْ ۖ وَٱعْلَمُوٓا۟",65],["10:10:1",209,"دَعْوَىٰهُمْ","Their prayer","","فِيهَا سُبْحَـٰنَكَ ٱللَّهُمَّ",1543],["10:10:9",209,"دَعْوَىٰهُمْ","(of) their call","فِيهَا سَلَـٰمٌۭ ۚ وَءَاخِرُ","أَنِ ٱلْحَمْدُ لِلَّهِ",1543],["10:12:5",209,"دَعَانَا","he calls Us","مَسَّ ٱلْإِنسَـٰنَ ٱلضُّرُّ","لِجَنۢبِهِۦٓ أَوْ قَاعِدًا",65],["10:12:18",209,"يَدْعُنَآ","called Us","مَرَّ كَأَن لَّمْ","إِلَىٰ ضُرٍّۢ مَّسَّهُۥ ۚ",65],["10:22:30",211,"دَعَوُا۟","They call","أَنَّهُمْ أُحِيطَ بِهِمْ ۙ","ٱللَّهَ مُخْلِصِينَ لَهُ",65],["10:25:2",211,"يَدْعُوٓا۟","calls","وَٱللَّهُ","إِلَىٰ دَارِ ٱلسَّلَـٰمِ",65],["10:38:8",213,"وَٱدْعُوا۟","and call","فَأْتُوا۟ بِسُورَةٍۢ مِّثْلِهِۦ","مَنِ ٱسْتَطَعْتُم مِّن",65],["10:66:13",216,"يَدْعُونَ","invoke","وَمَا يَتَّبِعُ ٱلَّذِينَ","مِن دُونِ ٱللَّهِ",65],["10:89:4",219,"دَّعْوَتُكُمَا","(the) invocation of both of you","قَالَ قَدْ أُجِيبَت","فَٱسْتَقِيمَا وَلَا تَتَّبِعَآنِّ",1173],["10:106:2",220,"تَدْعُ","invoke","وَلَا","مِن دُونِ ٱللَّهِ",65],["11:13:10",223,"وَٱدْعُوا۟","and call","سُوَرٍۢ مِّثْلِهِۦ مُفْتَرَيَـٰتٍۢ","مَنِ ٱسْتَطَعْتُم مِّن",65],["11:62:19",228,"تَدْعُونَآ","you call us","لَفِى شَكٍّۢ مِّمَّا","إِلَيْهِ مُرِيبٍۢ",65],["11:101:11",233,"يَدْعُونَ","they invoked","عَنْهُمْ ءَالِهَتُهُمُ ٱلَّتِى","مِن دُونِ ٱللَّهِ",65],["12:33:7",239,"يَدْعُونَنِىٓ","they invite me","أَحَبُّ إِلَىَّ مِمَّا","إِلَيْهِ ۖ وَإِلَّا تَصْرِفْ",65],["12:108:4",248,"أَدْعُوٓا۟","I invite","قُلْ هَـٰذِهِۦ سَبِيلِىٓ","إِلَى ٱللَّهِ ۚ عَلَىٰ",65],["13:14:2",251,"دَعْوَةُ","(is) supplication","لَهُۥ","ٱلْحَقِّ ۖ وَٱلَّذِينَ يَدْعُونَ",1173],["13:14:5",251,"يَدْعُونَ","they invoke","دَعْوَةُ ٱلْحَقِّ ۖ وَٱلَّذِينَ","مِن دُونِهِۦ لَا",65],["13:14:23",251,"دُعَآءُ","(is) the supplication","هُوَ بِبَـٰلِغِهِۦ ۚ وَمَا","ٱلْكَـٰفِرِينَ إِلَّا فِى",466],["13:36:23",254,"أَدْعُوا۟","I call","أُشْرِكَ بِهِۦٓ ۚ إِلَيْهِ","وَإِلَيْهِ مَـَٔابِ",65],["14:9:35",256,"تَدْعُونَنَآ","you invite us","لَفِى شَكٍّۢ مِّمَّا","إِلَيْهِ مُرِيبٍۢ",65],["14:10:9",256,"يَدْعُوكُمْ","He invites you","فَاطِرِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ","لِيَغْفِرَ لَكُم مِّن",65],["14:22:21",258,"دَعَوْتُكُمْ","I invited you","سُلْطَـٰنٍ إِلَّآ أَن","فَٱسْتَجَبْتُمْ لِى ۖ فَلَا",65],["14:39:13",260,"ٱلدُّعَآءِ","(of) the prayer","إِنَّ رَبِّى لَسَمِيعُ","",466],["14:40:9",260,"دُعَآءِ","my prayer","ذُرِّيَّتِى ۚ رَبَّنَا وَتَقَبَّلْ","",466],["14:44:15",261,"دَعْوَتَكَ","Your call","أَجَلٍۢ قَرِيبٍۢ نُّجِبْ","وَنَتَّبِعِ ٱلرُّسُلَ ۗ أَوَلَمْ",1173],["16:20:2",269,"يَدْعُونَ","they invoke","وَٱلَّذِينَ","مِن دُونِ ٱللَّهِ",65],["16:86:12",276,"نَدْعُوا۟","invoke","شُرَكَآؤُنَا ٱلَّذِينَ كُنَّا","مِن دُونِكَ ۖ فَأَلْقَوْا۟",65],["16:125:1",281,"ٱدْعُ","Call","","إِلَىٰ سَبِيلِ رَبِّكَ",65],["17:11:1",283,"وَيَدْعُ","And prays","","ٱلْإِنسَـٰنُ بِٱلشَّرِّ دُعَآءَهُۥ",65],["17:11:4",283,"دُعَآءَهُۥ","(as) he prays","وَيَدْعُ ٱلْإِنسَـٰنُ بِٱلشَّرِّ","بِٱلْخَيْرِ ۖ وَكَانَ ٱلْإِنسَـٰنُ",466],["17:52:2",287,"يَدْعُوكُمْ","He will call you","يَوْمَ","فَتَسْتَجِيبُونَ بِحَمْدِهِۦ وَتَظُنُّونَ",65],["17:56:2",287,"ٱدْعُوا۟","Call","قُلِ","ٱلَّذِينَ زَعَمْتُم مِّن",65],["17:57:3",287,"يَدْعُونَ","they call","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","يَبْتَغُونَ إِلَىٰ رَبِّهِمُ",65],["17:67:8",289,"تَدْعُونَ","you call","ٱلْبَحْرِ ضَلَّ مَن","إِلَّآ إِيَّاهُ ۖ فَلَمَّا",65],["17:71:2",289,"نَدْعُوا۟","We will call","يَوْمَ","كُلَّ أُنَاسٍۭ بِإِمَـٰمِهِمْ ۖ",65],["17:110:2",293,"ٱدْعُوا۟","Invoke","قُلِ","ٱللَّهَ أَوِ ٱدْعُوا۟",65],["17:110:5",293,"ٱدْعُوا۟","invoke","ٱدْعُوا۟ ٱللَّهَ أَوِ","ٱلرَّحْمَـٰنَ ۖ أَيًّۭا مَّا",65],["17:110:9",293,"تَدْعُوا۟","you invoke","ٱلرَّحْمَـٰنَ ۖ أَيًّۭا مَّا","فَلَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ ۚ",65],["18:14:12",294,"نَّدْعُوَا۟","we will invoke","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ لَن","مِن دُونِهِۦٓ إِلَـٰهًۭا ۖ",65],["18:28:5",297,"يَدْعُونَ","call","نَفْسَكَ مَعَ ٱلَّذِينَ","رَبَّهُم بِٱلْغَدَوٰةِ وَٱلْعَشِىِّ",65],["18:52:7",299,"فَدَعَوْهُمْ","then they will call them","شُرَكَآءِىَ ٱلَّذِينَ زَعَمْتُمْ","فَلَمْ يَسْتَجِيبُوا۟ لَهُمْ",65],["18:57:24",300,"تَدْعُهُمْ","you call them","ءَاذَانِهِمْ وَقْرًۭا ۖ وَإِن","إِلَى ٱلْهُدَىٰ فَلَن",65],["19:4:12",305,"بِدُعَآئِكَ","in (my) supplication (to) You","شَيْبًۭا وَلَمْ أَكُنۢ","رَبِّ شَقِيًّۭا",466],["19:48:3",308,"تَدْعُونَ","you invoke","وَأَعْتَزِلُكُمْ وَمَا","مِن دُونِ ٱللَّهِ",65],["19:48:7",308,"وَأَدْعُوا۟","and I will invoke","مِن دُونِ ٱللَّهِ","رَبِّى عَسَىٰٓ أَلَّآ",65],["19:48:12",308,"بِدُعَآءِ","in invocation","عَسَىٰٓ أَلَّآ أَكُونَ","رَبِّى شَقِيًّۭا",466],["19:91:2",311,"دَعَوْا۟","they invoke","أَن","لِلرَّحْمَـٰنِ وَلَدًۭا",65],["20:108:3",319,"ٱلدَّاعِىَ","the caller","يَوْمَئِذٍۢ يَتَّبِعُونَ","لَا عِوَجَ لَهُۥ ۖ",1541],["21:15:4",323,"دَعْوَىٰهُمْ","their cry","فَمَا زَالَت تِّلْكَ","حَتَّىٰ جَعَلْنَـٰهُمْ حَصِيدًا",1543],["21:45:8",326,"ٱلدُّعَآءَ","the call","وَلَا يَسْمَعُ ٱلصُّمُّ","إِذَا مَا يُنذَرُونَ",466],["21:90:14",329,"وَيَدْعُونَنَا","and they supplicate to Us","يُسَـٰرِعُونَ فِى ٱلْخَيْرَٰتِ","رَغَبًۭا وَرَهَبًۭا ۖ وَكَانُوا۟",65],["22:12:1",333,"يَدْعُوا۟","He calls","","مِن دُونِ ٱللَّهِ",65],["22:13:1",333,"يَدْعُوا۟","He calls","","لَمَن ضَرُّهُۥٓ أَقْرَبُ",65],["22:62:8",339,"يَدْعُونَ","they invoke","ٱلْحَقُّ وَأَنَّ مَا","مِن دُونِهِۦ هُوَ",65],["22:67:11",340,"وَٱدْعُ","but invite (them)","يُنَـٰزِعُنَّكَ فِى ٱلْأَمْرِ ۚ","إِلَىٰ رَبِّكَ ۖ إِنَّكَ",65],["22:73:9",341,"تَدْعُونَ","you invoke","لَهُۥٓ ۚ إِنَّ ٱلَّذِينَ","مِن دُونِ ٱللَّهِ",65],["23:73:2",346,"لَتَدْعُوهُمْ","certainly call them","وَإِنَّكَ","إِلَىٰ صِرَٰطٍۢ مُّسْتَقِيمٍۢ",65],["23:117:2",349,"يَدْعُ","invokes","وَمَن","مَعَ ٱللَّهِ إِلَـٰهًا",65],["24:48:2",356,"دُعُوٓا۟","they are called","وَإِذَا","إِلَى ٱللَّهِ وَرَسُولِهِۦ",65],["24:51:6",356,"دُعُوٓا۟","they are called","قَوْلَ ٱلْمُؤْمِنِينَ إِذَا","إِلَى ٱللَّهِ وَرَسُولِهِۦ",65],["24:63:3",359,"دُعَآءَ","(the) calling","لَّا تَجْعَلُوا۟","ٱلرَّسُولِ بَيْنَكُمْ كَدُعَآءِ",466],["24:63:6",359,"كَدُعَآءِ","as (the) call","دُعَآءَ ٱلرَّسُولِ بَيْنَكُمْ","بَعْضِكُم بَعْضًۭا ۚ قَدْ",466],["25:13:7",361,"دَعَوْا۟","they will call","مَكَانًۭا ضَيِّقًۭا مُّقَرَّنِينَ","هُنَالِكَ ثُبُورًۭا",65],["25:14:2",361,"تَدْعُوا۟","call","لَّا","ٱلْيَوْمَ ثُبُورًۭا وَٰحِدًۭا",65],["25:14:6",361,"وَٱدْعُوا۟","but call","ٱلْيَوْمَ ثُبُورًۭا وَٰحِدًۭا","ثُبُورًۭا كَثِيرًۭا",65],["25:68:3",366,"يَدْعُونَ","invoke","وَٱلَّذِينَ لَا","مَعَ ٱللَّهِ إِلَـٰهًا",65],["25:77:7",366,"دُعَآؤُكُمْ ۖ","your prayer (is to Him)","بِكُمْ رَبِّى لَوْلَا","فَقَدْ كَذَّبْتُمْ فَسَوْفَ",466],["26:72:5",370,"تَدْعُونَ","you call","هَلْ يَسْمَعُونَكُمْ إِذْ","",65],["26:213:2",376,"تَدْعُ","invoke","فَلَا","مَعَ ٱللَّهِ إِلَـٰهًا",65],["27:62:5",382,"دَعَاهُ","he calls Him","يُجِيبُ ٱلْمُضْطَرَّ إِذَا","وَيَكْشِفُ ٱلسُّوٓءَ وَيَجْعَلُكُمْ",65],["27:80:8",384,"ٱلدُّعَآءَ","the call","وَلَا تُسْمِعُ ٱلصُّمَّ","إِذَا وَلَّوْا۟ مُدْبِرِينَ",466],["28:25:9",388,"يَدْعُوكَ","calls you","قَالَتْ إِنَّ أَبِى","لِيَجْزِيَكَ أَجْرَ مَا",65],["28:41:3",390,"يَدْعُونَ","inviting","وَجَعَلْنَـٰهُمْ أَئِمَّةًۭ","إِلَى ٱلنَّارِ ۖ وَيَوْمَ",65],["28:64:2",393,"ٱدْعُوا۟","Call","وَقِيلَ","شُرَكَآءَكُمْ فَدَعَوْهُمْ فَلَمْ",65],["28:64:4",393,"فَدَعَوْهُمْ","And they will call them","وَقِيلَ ٱدْعُوا۟ شُرَكَآءَكُمْ","فَلَمْ يَسْتَجِيبُوا۟ لَهُمْ",65],["28:87:10",396,"وَٱدْعُ","And invite (people)","إِذْ أُنزِلَتْ إِلَيْكَ ۖ","إِلَىٰ رَبِّكَ ۖ وَلَا",65],["28:88:2",396,"تَدْعُ","invoke","وَلَا","مَعَ ٱللَّهِ إِلَـٰهًا",65],["29:42:5",401,"يَدْعُونَ","they invoke","ٱللَّهَ يَعْلَمُ مَا","مِن دُونِهِۦ مِن",65],["29:65:5",404,"دَعَوُا۟","they call","رَكِبُوا۟ فِى ٱلْفُلْكِ","ٱللَّهَ مُخْلِصِينَ لَهُ",65],["30:25:10",407,"دَعَاكُمْ","He calls you","بِأَمْرِهِۦ ۚ ثُمَّ إِذَا","دَعْوَةًۭ مِّنَ ٱلْأَرْضِ",65],["30:25:11",407,"دَعْوَةًۭ","(with) a call","ثُمَّ إِذَا دَعَاكُمْ","مِّنَ ٱلْأَرْضِ إِذَآ",1173],["30:33:5",408,"دَعَوْا۟","they call","مَسَّ ٱلنَّاسَ ضُرٌّۭ","رَبَّهُم مُّنِيبِينَ إِلَيْهِ",65],["30:52:8",410,"ٱلدُّعَآءَ","the call","وَلَا تُسْمِعُ ٱلصُّمَّ","إِذَا وَلَّوْا۟ مُدْبِرِينَ",466],["31:21:18",413,"يَدْعُوهُمْ","(to) call them","أَوَلَوْ كَانَ ٱلشَّيْطَـٰنُ","إِلَىٰ عَذَابِ ٱلسَّعِيرِ",65],["31:30:8",414,"يَدْعُونَ","they call","ٱلْحَقُّ وَأَنَّ مَا","مِن دُونِهِ ٱلْبَـٰطِلُ",65],["31:32:5",414,"دَعَوُا۟","they call","غَشِيَهُم مَّوْجٌۭ كَٱلظُّلَلِ","ٱللَّهَ مُخْلِصِينَ لَهُ",65],["32:16:5",416,"يَدْعُونَ","they call","جُنُوبُهُمْ عَنِ ٱلْمَضَاجِعِ","رَبَّهُمْ خَوْفًۭا وَطَمَعًۭا",65],["33:4:18",418,"أَدْعِيَآءَكُمْ","your adopted sons","أُمَّهَـٰتِكُمْ ۚ وَمَا جَعَلَ","أَبْنَآءَكُمْ ۚ ذَٰلِكُمْ قَوْلُكُم",466],["33:5:1",418,"ٱدْعُوهُمْ","Call them","","لِـَٔابَآئِهِمْ هُوَ أَقْسَطُ",65],["33:37:40",423,"أَدْعِيَآئِهِمْ","(of) their adopted sons","حَرَجٌۭ فِىٓ أَزْوَٰجِ","إِذَا قَضَوْا۟ مِنْهُنَّ",466],["33:46:1",424,"وَدَاعِيًا","And as one who invites","","إِلَى ٱللَّهِ بِإِذْنِهِۦ",1541],["33:53:19",425,"دُعِيتُمْ","you are invited","إِنَىٰهُ وَلَـٰكِنْ إِذَا","فَٱدْخُلُوا۟ فَإِذَا طَعِمْتُمْ",65],["34:22:2",430,"ٱدْعُوا۟","Call upon","قُلِ","ٱلَّذِينَ زَعَمْتُم مِّن",65],["35:6:8",435,"يَدْعُوا۟","he invites","فَٱتَّخِذُوهُ عَدُوًّا ۚ إِنَّمَا","حِزْبَهُۥ لِيَكُونُوا۟ مِنْ",65],["35:13:22",436,"تَدْعُونَ","you invoke","لَهُ ٱلْمُلْكُ ۚ وَٱلَّذِينَ","مِن دُونِهِۦ مَا",65],["35:14:2",436,"تَدْعُوهُمْ","you invoke them","إِن","لَا يَسْمَعُوا۟ دُعَآءَكُمْ",65],["35:14:5",436,"دُعَآءَكُمْ","your call","تَدْعُوهُمْ لَا يَسْمَعُوا۟","وَلَوْ سَمِعُوا۟ مَا",466],["35:18:7",436,"تَدْعُ","calls","وِزْرَ أُخْرَىٰ ۚ وَإِن","مُثْقَلَةٌ إِلَىٰ حِمْلِهَا",65],["35:40:5",439,"تَدْعُونَ","you call","أَرَءَيْتُمْ شُرَكَآءَكُمُ ٱلَّذِينَ","مِن دُونِ ٱللَّهِ",65],["36:57:6",444,"يَدَّعُونَ","they call for","فَـٰكِهَةٌۭ وَلَهُم مَّا","",2053],["37:125:1",450,"أَتَدْعُونَ","Do you call","","بَعْلًۭا وَتَذَرُونَ أَحْسَنَ",65],["38:51:3",456,"يَدْعُونَ","they will call","مُتَّكِـِٔينَ فِيهَا","فِيهَا بِفَـٰكِهَةٍۢ كَثِيرَةٍۢ",65],["39:8:5",459,"دَعَا","he calls","مَسَّ ٱلْإِنسَـٰنَ ضُرٌّۭ","رَبَّهُۥ مُنِيبًا إِلَيْهِ",65],["39:8:17",459,"يَدْعُوٓا۟","he used to call","نَسِىَ مَا كَانَ","إِلَيْهِ مِن قَبْلُ",65],["39:38:12",462,"تَدْعُونَ","you invoke","قُلْ أَفَرَءَيْتُم مَّا","مِن دُونِ ٱللَّهِ",65],["39:49:5",464,"دَعَانَا","he calls upon Us","مَسَّ ٱلْإِنسَـٰنَ ضُرٌّۭ","ثُمَّ إِذَا خَوَّلْنَـٰهُ",65],["40:10:12",468,"تُدْعَوْنَ","you were called","مَّقْتِكُمْ أَنفُسَكُمْ إِذْ","إِلَى ٱلْإِيمَـٰنِ فَتَكْفُرُونَ",65],["40:12:4",468,"دُعِىَ","Allah was invoked","ذَٰلِكُم بِأَنَّهُۥٓ إِذَا","ٱللَّهُ وَحْدَهُۥ كَفَرْتُمْ ۖ",65],["40:14:1",468,"فَٱدْعُوا۟","So invoke","","ٱللَّهَ مُخْلِصِينَ لَهُ",65],["40:20:5",469,"يَدْعُونَ","they invoke","يَقْضِى بِٱلْحَقِّ ۖ وَٱلَّذِينَ","مِن دُونِهِۦ لَا",65],["40:26:6",470,"وَلْيَدْعُ","and let him call","ذَرُونِىٓ أَقْتُلْ مُوسَىٰ","رَبَّهُۥٓ ۖ إِنِّىٓ أَخَافُ",65],["40:41:4",472,"أَدْعُوكُمْ","(that) I call you","۞ وَيَـٰقَوْمِ مَا لِىٓ","إِلَى ٱلنَّجَوٰةِ وَتَدْعُونَنِىٓ",65],["40:41:7",472,"وَتَدْعُونَنِىٓ","while you call me","أَدْعُوكُمْ إِلَى ٱلنَّجَوٰةِ","إِلَى ٱلنَّارِ",65],["40:42:1",472,"تَدْعُونَنِى","You call me","","لِأَكْفُرَ بِٱللَّهِ وَأُشْرِكَ",65],["40:42:12",472,"أَدْعُوكُمْ","call you","بِهِۦ عِلْمٌۭ وَأَنَا۠","إِلَى ٱلْعَزِيزِ ٱلْغَفَّـٰرِ",65],["40:43:4",472,"تَدْعُونَنِىٓ","you call me","لَا جَرَمَ أَنَّمَا","إِلَيْهِ لَيْسَ لَهُۥ",65],["40:43:8",472,"دَعْوَةٌۭ","a claim","إِلَيْهِ لَيْسَ لَهُۥ","فِى ٱلدُّنْيَا وَلَا",1173],["40:49:7",472,"ٱدْعُوا۟","Call","ٱلنَّارِ لِخَزَنَةِ جَهَنَّمَ","رَبَّكُمْ يُخَفِّفْ عَنَّا",65],["40:50:10",473,"فَٱدْعُوا۟ ۗ","Then call","قَالُوا۟ بَلَىٰ ۚ قَالُوا۟","وَمَا دُعَـٰٓؤُا۟ ٱلْكَـٰفِرِينَ",65],["40:50:12",473,"دُعَـٰٓؤُا۟","(is the) call","قَالُوا۟ فَٱدْعُوا۟ ۗ وَمَا","ٱلْكَـٰفِرِينَ إِلَّا فِى",466],["40:60:3",474,"ٱدْعُونِىٓ","Call upon Me","وَقَالَ رَبُّكُمُ","أَسْتَجِبْ لَكُمْ ۚ إِنَّ",65],["40:65:7",474,"فَٱدْعُوهُ","so call Him","إِلَـٰهَ إِلَّا هُوَ","مُخْلِصِينَ لَهُ ٱلدِّينَ ۗ",65],["40:66:7",474,"تَدْعُونَ","you call","أَنْ أَعْبُدَ ٱلَّذِينَ","مِن دُونِ ٱللَّهِ",65],["40:74:10",475,"نَّدْعُوا۟","[we] call","بَل لَّمْ نَكُن","مِن قَبْلُ شَيْـًۭٔا ۚ",65],["41:5:6",477,"تَدْعُونَآ","you call us","فِىٓ أَكِنَّةٍۢ مِّمَّا","إِلَيْهِ وَفِىٓ ءَاذَانِنَا",65],["41:31:16",480,"تَدَّعُونَ","you ask","وَلَكُمْ فِيهَا مَا","",2053],["41:33:5",480,"دَعَآ","invites","أَحْسَنُ قَوْلًۭا مِّمَّن","إِلَى ٱللَّهِ وَعَمِلَ",65],["41:48:5",482,"يَدْعُونَ","invoking","عَنْهُم مَّا كَانُوا۟","مِن قَبْلُ ۖ وَظَنُّوا۟",65],["41:49:5",482,"دُعَآءِ","praying","يَسْـَٔمُ ٱلْإِنسَـٰنُ مِن","ٱلْخَيْرِ وَإِن مَّسَّهُ",466],["41:51:12",482,"دُعَآءٍ","(of) supplication","مَسَّهُ ٱلشَّرُّ فَذُو","عَرِيضٍۢ",466],["42:13:28",484,"تَدْعُوهُمْ","you call them","عَلَى ٱلْمُشْرِكِينَ مَا","إِلَيْهِ ۚ ٱللَّهُ يَجْتَبِىٓ",65],["42:15:2",484,"فَٱدْعُ ۖ","then invite","فَلِذَٰلِكَ","وَٱسْتَقِمْ كَمَآ أُمِرْتَ ۖ",65],["43:49:4",493,"ٱدْعُ","Invoke","وَقَالُوا۟ يَـٰٓأَيُّهَ ٱلسَّاحِرُ","لَنَا رَبَّكَ بِمَا",65],["43:86:4",495,"يَدْعُونَ","they invoke","وَلَا يَمْلِكُ ٱلَّذِينَ","مِن دُونِهِ ٱلشَّفَـٰعَةَ",65],["44:22:1",497,"فَدَعَا","So he called","","رَبَّهُۥٓ أَنَّ هَـٰٓؤُلَآءِ",65],["44:55:1",498,"يَدْعُونَ","They will call","","فِيهَا بِكُلِّ فَـٰكِهَةٍ",65],["45:28:7",501,"تُدْعَىٰٓ","will be called","جَاثِيَةًۭ ۚ كُلُّ أُمَّةٍۢ","إِلَىٰ كِتَـٰبِهَا ٱلْيَوْمَ",65],["46:4:4",502,"تَدْعُونَ","you call","قُلْ أَرَءَيْتُم مَّا","مِن دُونِ ٱللَّهِ",65],["46:5:4",502,"يَدْعُوا۟","calls","وَمَنْ أَضَلُّ مِمَّن","مِن دُونِ ٱللَّهِ",65],["46:5:17",502,"دُعَآئِهِمْ","their calls","ٱلْقِيَـٰمَةِ وَهُمْ عَن","غَـٰفِلُونَ",466],["46:31:3",506,"دَاعِىَ","(to the) caller","يَـٰقَوْمَنَآ أَجِيبُوا۟","ٱللَّهِ وَءَامِنُوا۟ بِهِۦ",1541],["46:32:4",506,"دَاعِىَ","(to the) caller","وَمَن لَّا يُجِبْ","ٱللَّهِ فَلَيْسَ بِمُعْجِزٍۢ",1541],["47:35:3",510,"وَتَدْعُوٓا۟","and call","فَلَا تَهِنُوا۟","إِلَى ٱلسَّلْمِ وَأَنتُمُ",65],["47:38:3",510,"تُدْعَوْنَ","called","هَـٰٓأَنتُمْ هَـٰٓؤُلَآءِ","لِتُنفِقُوا۟ فِى سَبِيلِ",65],["48:16:5",513,"سَتُدْعَوْنَ","You will be called","لِّلْمُخَلَّفِينَ مِنَ ٱلْأَعْرَابِ","إِلَىٰ قَوْمٍ أُو۟لِى",65],["52:28:5",524,"نَدْعُوهُ ۖ","call Him","كُنَّا مِن قَبْلُ","إِنَّهُۥ هُوَ ٱلْبَرُّ",65],["54:6:4",528,"يَدْعُ","will call","فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ","ٱلدَّاعِ إِلَىٰ شَىْءٍۢ",65],["54:6:5",528,"ٱلدَّاعِ","the caller","عَنْهُمْ ۘ يَوْمَ يَدْعُ","إِلَىٰ شَىْءٍۢ نُّكُرٍ",1822],["54:8:3",529,"ٱلدَّاعِ ۖ","the caller","مُّهْطِعِينَ إِلَى","يَقُولُ ٱلْكَـٰفِرُونَ هَـٰذَا",1822],["54:10:1",529,"فَدَعَا","So he called","","رَبَّهُۥٓ أَنِّى مَغْلُوبٌۭ",65],["57:8:7",538,"يَدْعُوكُمْ","calls you","تُؤْمِنُونَ بِٱللَّهِ ۙ وَٱلرَّسُولُ","لِتُؤْمِنُوا۟ بِرَبِّكُمْ وَقَدْ",65],["61:7:9",552,"يُدْعَىٰٓ","is invited","ٱللَّهِ ٱلْكَذِبَ وَهُوَ","إِلَى ٱلْإِسْلَـٰمِ ۚ وَٱللَّهُ",65],["67:27:13",564,"تَدَّعُونَ","call","ٱلَّذِى كُنتُم بِهِۦ","",2053],["68:42:5",565,"وَيُدْعَوْنَ","and they will be called","يُكْشَفُ عَن سَاقٍۢ","إِلَى ٱلسُّجُودِ فَلَا",65],["68:43:7",566,"يُدْعَوْنَ","called","ذِلَّةٌۭ ۖ وَقَدْ كَانُوا۟","إِلَى ٱلسُّجُودِ وَهُمْ",65],["70:17:1",569,"تَدْعُوا۟","Inviting","","مَنْ أَدْبَرَ وَتَوَلَّىٰ",65],["71:5:4",570,"دَعَوْتُ","invited","قَالَ رَبِّ إِنِّى","قَوْمِى لَيْلًۭا وَنَهَارًۭا",65],["71:6:3",570,"دُعَآءِىٓ","my invitation","فَلَمْ يَزِدْهُمْ","إِلَّا فِرَارًۭا",466],["71:7:3",570,"دَعَوْتُهُمْ","I invited them","وَإِنِّى كُلَّمَا","لِتَغْفِرَ لَهُمْ جَعَلُوٓا۟",65],["71:8:3",570,"دَعَوْتُهُمْ","invited them","ثُمَّ إِنِّى","جِهَارًۭا",65],["72:18:5",573,"تَدْعُوا۟","call","ٱلْمَسَـٰجِدَ لِلَّهِ فَلَا","مَعَ ٱللَّهِ أَحَدًۭا",65],["72:19:6",573,"يَدْعُوهُ","calling (upon) Him","قَامَ عَبْدُ ٱللَّهِ","كَادُوا۟ يَكُونُونَ عَلَيْهِ",65],["72:20:3",573,"أَدْعُوا۟","I call upon","قُلْ إِنَّمَآ","رَبِّى وَلَآ أُشْرِكُ",65],["84:11:2",589,"يَدْعُوا۟","he will call","فَسَوْفَ","ثُبُورًۭا",65],["96:17:1",598,"فَلْيَدْعُ","Then let him call","","نَادِيَهُۥ",65],["96:18:1",598,"سَنَدْعُ","We will call","","ٱلزَّبَانِيَةَ",65]]