[["19:23:4",306,"جِذْعِ","(the) trunk","فَأَجَآءَهَا ٱلْمَخَاضُ إِلَىٰ","ٱلنَّخْلَةِ قَالَتْ يَـٰلَيْتَنِى",1859],["19:25:3",306,"بِجِذْعِ","(the) trunk","وَهُزِّىٓ إِلَيْكِ","ٱلنَّخْلَةِ تُسَـٰقِطْ عَلَيْكِ",1859],["20:71:20",316,"جُذُوعِ","(the) trunks","خِلَـٰفٍۢ وَلَأُصَلِّبَنَّكُمْ فِى","ٱلنَّخْلِ وَلَتَعْلَمُنَّ أَيُّنَآ",1859]]