[["6:17:6",129,"كَاشِفَ","remover","ٱللَّهُ بِضُرٍّۢ فَلَا","لَهُۥٓ إِلَّا هُوَ ۖ",1862],["6:41:4",132,"فَيَكْشِفُ","and He would remove","بَلْ إِيَّاهُ تَدْعُونَ","مَا تَدْعُونَ إِلَيْهِ",662],["7:134:14",166,"كَشَفْتَ","you remove","عَهِدَ عِندَكَ ۖ لَئِن","عَنَّا ٱلرِّجْزَ لَنُؤْمِنَنَّ",662],["7:135:2",166,"كَشَفْنَا","We removed","فَلَمَّا","عَنْهُمُ ٱلرِّجْزَ إِلَىٰٓ",662],["10:12:12",209,"كَشَفْنَا","We remove","أَوْ قَآئِمًۭا فَلَمَّا","عَنْهُ ضُرَّهُۥ مَرَّ",662],["10:98:12",220,"كَشَفْنَا","We removed","يُونُسَ لَمَّآ ءَامَنُوا۟","عَنْهُمْ عَذَابَ ٱلْخِزْىِ",662],["10:107:6",221,"كَاشِفَ","remover","ٱللَّهُ بِضُرٍّۢ فَلَا","لَهُۥٓ إِلَّا هُوَ ۖ",1862],["16:54:3",272,"كَشَفَ","He removes","ثُمَّ إِذَا","ٱلضُّرَّ عَنكُمْ إِذَا",662],["17:56:9",287,"كَشْفَ","(to) remove","دُونِهِۦ فَلَا يَمْلِكُونَ","ٱلضُّرِّ عَنكُمْ وَلَا",3552],["21:84:3",329,"فَكَشَفْنَا","and We removed","فَٱسْتَجَبْنَا لَهُۥ","مَا بِهِۦ مِن",662],["23:75:3",347,"وَكَشَفْنَا","and We removed","۞ وَلَوْ رَحِمْنَـٰهُمْ","مَا بِهِم مِّن",662],["27:44:9",380,"وَكَشَفَتْ","and she uncovered","رَأَتْهُ حَسِبَتْهُ لُجَّةًۭ","عَن سَاقَيْهَا ۚ قَالَ",662],["27:62:6",382,"وَيَكْشِفُ","and He removes","ٱلْمُضْطَرَّ إِذَا دَعَاهُ","ٱلسُّوٓءَ وَيَجْعَلُكُمْ خُلَفَآءَ",662],["39:38:22",462,"كَـٰشِفَـٰتُ","removers","بِضُرٍّ هَلْ هُنَّ","ضُرِّهِۦٓ أَوْ أَرَادَنِى",3561],["43:50:2",493,"كَشَفْنَا","We removed","فَلَمَّا","عَنْهُمُ ٱلْعَذَابَ إِذَا",662],["44:12:2",496,"ٱكْشِفْ","Remove","رَّبَّنَا","عَنَّا ٱلْعَذَابَ إِنَّا",662],["44:15:2",496,"كَاشِفُوا۟","(will) remove","إِنَّا","ٱلْعَذَابِ قَلِيلًا ۚ إِنَّكُمْ",1862],["50:22:7",519,"فَكَشَفْنَا","So We have removed","غَفْلَةٍۢ مِّنْ هَـٰذَا","عَنكَ غِطَآءَكَ فَبَصَرُكَ",662],["53:58:6",528,"كَاشِفَةٌ","any remover","مِن دُونِ ٱللَّهِ","",3553],["68:42:2",565,"يُكْشَفُ","will be uncovered","يَوْمَ","عَن سَاقٍۢ وَيُدْعَوْنَ",662]]