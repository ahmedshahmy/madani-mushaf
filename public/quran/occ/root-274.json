[["2:259:9",43,"عُرُوشِهَا","its roofs","وَهِىَ خَاوِيَةٌ عَلَىٰ","قَالَ أَنَّىٰ يُحْىِۦ",372],["6:141:5",146,"مَّعْرُوشَـٰتٍۢ","trellised","ٱلَّذِىٓ أَنشَأَ جَنَّـٰتٍۢ","وَغَيْرَ مَعْرُوشَـٰتٍۢ وَٱلنَّخْلَ",2517],["6:141:7",146,"مَعْرُوشَـٰتٍۢ","trellised","جَنَّـٰتٍۢ مَّعْرُوشَـٰتٍۢ وَغَيْرَ","وَٱلنَّخْلَ وَٱلزَّرْعَ مُخْتَلِفًا",2517],["7:54:14",157,"ٱلْعَرْشِ","the Throne","ثُمَّ ٱسْتَوَىٰ عَلَى","يُغْشِى ٱلَّيْلَ ٱلنَّهَارَ",372],["7:137:29",166,"يَعْرِشُونَ","erect","وَقَوْمُهُۥ وَمَا كَانُوا۟","",2757],["9:129:14",207,"ٱلْعَرْشِ","(of) the Throne","تَوَكَّلْتُ ۖ وَهُوَ رَبُّ","ٱلْعَظِيمِ",372],["10:3:14",208,"ٱلْعَرْشِ ۖ","the Throne","ثُمَّ ٱسْتَوَىٰ عَلَى","يُدَبِّرُ ٱلْأَمْرَ ۖ مَا",372],["11:7:10",222,"عَرْشُهُۥ","and His throne was","سِتَّةِ أَيَّامٍۢ وَكَانَ","عَلَى ٱلْمَآءِ لِيَبْلُوَكُمْ",372],["12:100:4",247,"ٱلْعَرْشِ","the throne","وَرَفَعَ أَبَوَيْهِ عَلَى","وَخَرُّوا۟ لَهُۥ سُجَّدًۭا ۖ",372],["13:2:11",249,"ٱلْعَرْشِ ۖ","the Throne","ثُمَّ ٱسْتَوَىٰ عَلَى","وَسَخَّرَ ٱلشَّمْسَ وَٱلْقَمَرَ ۖ",372],["16:68:13",274,"يَعْرِشُونَ","they construct","وَمِنَ ٱلشَّجَرِ وَمِمَّا","",2757],["17:42:12",286,"ٱلْعَرْشِ","(of) the Throne","لَّٱبْتَغَوْا۟ إِلَىٰ ذِى","سَبِيلًۭا",372],["18:42:13",298,"عُرُوشِهَا","its trellises","وَهِىَ خَاوِيَةٌ عَلَىٰ","وَيَقُولُ يَـٰلَيْتَنِى لَمْ",372],["20:5:3",312,"ٱلْعَرْشِ","the Throne","ٱلرَّحْمَـٰنُ عَلَى","ٱسْتَوَىٰ",372],["21:22:11",323,"ٱلْعَرْشِ","(of) the Throne","فَسُبْحَـٰنَ ٱللَّهِ رَبِّ","عَمَّا يَصِفُونَ",372],["22:45:10",337,"عُرُوشِهَا","its roofs","فَهِىَ خَاوِيَةٌ عَلَىٰ","وَبِئْرٍۢ مُّعَطَّلَةٍۢ وَقَصْرٍۢ",372],["23:86:7",347,"ٱلْعَرْشِ","(of) the Throne","ٱلسَّمَـٰوَٰتِ ٱلسَّبْعِ وَرَبُّ","ٱلْعَظِيمِ",372],["23:116:10",349,"ٱلْعَرْشِ","(of) the Throne","إِلَّا هُوَ رَبُّ","ٱلْكَرِيمِ",372],["25:59:13",365,"ٱلْعَرْشِ ۚ","the Throne","ثُمَّ ٱسْتَوَىٰ عَلَى","ٱلرَّحْمَـٰنُ فَسْـَٔلْ بِهِۦ",372],["27:23:10",379,"عَرْشٌ","(is) a throne","كُلِّ شَىْءٍۢ وَلَهَا","عَظِيمٌۭ",372],["27:26:7",379,"ٱلْعَرْشِ","(of)