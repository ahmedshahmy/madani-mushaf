[["2:85:18",13,"تُفَـٰدُوهُمْ","you ransom them","وَإِن يَأْتُوكُمْ أُسَـٰرَىٰ","وَهُوَ مُحَرَّمٌ عَلَيْكُمْ",4458],["2:184:17",28,"فِدْيَةٌۭ","a ransom","وَعَلَى ٱلَّذِينَ يُطِيقُونَهُۥ","طَعَامُ مِسْكِينٍۢ ۖ فَمَن",1836],["2:196:27",30,"فَفِدْيَةٌۭ","then a ransom","أَذًۭى مِّن رَّأْسِهِۦ","مِّن صِيَامٍ أَوْ",1836],["2:229:33",36,"ٱفْتَدَتْ","she ransoms","جُنَاحَ عَلَيْهِمَا فِيمَا","بِهِۦ ۗ تِلْكَ حُدُودُ",1123],["3:91:15",61,"ٱفْتَدَىٰ","he offered as ransom","ٱلْأَرْضِ ذَهَبًۭا وَلَوِ","بِهِۦٓ ۗ أُو۟لَـٰٓئِكَ لَهُمْ",1123],["5:36:13",113,"لِيَفْتَدُوا۟","to ransom themselves","جَمِيعًۭا وَمِثْلَهُۥ مَعَهُۥ","بِهِۦ مِنْ عَذَابِ",1123],["10:54:9",215,"لَٱفْتَدَتْ","it (would) seek to ransom","مَا فِى ٱلْأَرْضِ","بِهِۦ ۗ وَأَسَرُّوا۟ ٱلنَّدَامَةَ",1123],["13:18:18",251,"لَٱفْتَدَوْا۟","surely they would offer ransom","جَمِيعًۭا وَمِثْلَهُۥ مَعَهُۥ","بِهِۦٓ ۚ أُو۟لَـٰٓئِكَ لَهُمْ",1123],["37:107:1",450,"وَفَدَيْنَـٰهُ","And We ransomed him","","بِذِبْحٍ عَظِيمٍۢ",3409],["39:47:11",463,"لَٱفْتَدَوْا۟","they would ransom","جَمِيعًۭا وَمِثْلَهُۥ مَعَهُۥ","بِهِۦ مِن سُوٓءِ",1123],["47:4:16",507,"فِدَآءً","ransom","مَنًّۢا بَعْدُ وَإِمَّا","حَتَّىٰ تَضَعَ ٱلْحَرْبُ",3435],["57:15:5",539,"فِدْيَةٌۭ","any ransom","لَا يُؤْخَذُ مِنكُمْ","وَلَا مِنَ ٱلَّذِينَ",1836],["70:11:5",569,"يَفْتَدِى","he (could be) ransomed","يَوَدُّ ٱلْمُجْرِمُ لَوْ","مِنْ عَذَابِ يَوْمِئِذٍۭ",1123]]