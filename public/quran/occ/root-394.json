[["2:33:22",6,"تَكْتُمُونَ","conceal","تُبْدُونَ وَمَا كُنتُمْ","",490],["2:42:5",7,"وَتَكْتُمُوا۟","and conceal","تَلْبِسُوا۟ ٱلْحَقَّ بِٱلْبَـٰطِلِ","ٱلْحَقَّ وَأَنتُمْ تَعْلَمُونَ",490],["2:72:10",11,"تَكْتُمُونَ","concealing","مُخْرِجٌۭ مَّا كُنتُمْ","",490],["2:140:21",21,"كَتَمَ","concealed","وَمَنْ أَظْلَمُ مِمَّن","شَهَـٰدَةً عِندَهُۥ مِنَ",490],["2:146:11",23,"لَيَكْتُمُونَ","surely they conceal","وَإِنَّ فَرِيقًۭا مِّنْهُمْ","ٱلْحَقَّ وَهُمْ يَعْلَمُونَ",490],["2:159:3",24,"يَكْتُمُونَ","conceal","إِنَّ ٱلَّذِينَ","مَآ أَنزَلْنَا مِنَ",490],["2:174:3",26,"يَكْتُمُونَ","conceal","إِنَّ ٱلَّذِينَ","مَآ أَنزَلَ ٱللَّهُ",490],["2:228:10",36,"يَكْتُمْنَ","they conceal","يَحِلُّ لَهُنَّ أَن","مَا خَلَقَ ٱللَّهُ",490],["2:283:22",49,"تَكْتُمُوا۟","conceal","ٱللَّهَ رَبَّهُۥ ۗ وَلَا","ٱلشَّهَـٰدَةَ ۚ وَمَن يَكْتُمْهَا",490],["2:283:25",49,"يَكْتُمْهَا","conceals it","تَكْتُمُوا۟ ٱلشَّهَـٰدَةَ ۚ وَمَن","فَإِنَّهُۥٓ ءَاثِمٌۭ قَلْبُهُۥ ۗ",490],["3:71:7",59,"وَتَكْتُمُونَ","and conceal","تَلْبِسُونَ ٱلْحَقَّ بِٱلْبَـٰطِلِ","ٱلْحَقَّ وَأَنتُمْ تَعْلَمُونَ",490],["3:167:33",72,"يَكْتُمُونَ","they conceal","وَٱللَّهُ أَعْلَمُ بِمَا","",490],["3:187:11",75,"تَكْتُمُونَهُۥ","conceal it","لَتُبَيِّنُنَّهُۥ لِلنَّاسِ وَلَا","فَنَبَذُوهُ وَرَآءَ ظُهُورِهِمْ",490],["4:37:6",84,"وَيَكْتُمُونَ","and hide","وَيَأْمُرُونَ ٱلنَّاسَ بِٱلْبُخْلِ","مَآ ءَاتَىٰهُمُ ٱللَّهُ",490],["4:42:12",85,"يَكْتُمُونَ","they will (be able to) hide","بِهِمُ ٱلْأَرْضُ وَلَا","ٱللَّهَ حَدِيثًۭا",490],["5:61:16",118,"يَكْتُمُونَ","hiding","أَعْلَمُ بِمَا كَانُوا۟","",490],["5:99:11",124,"تَكْتُمُونَ","you conceal","مَا تُبْدُونَ وَمَا","",490],["5:106:45",125,"نَكْتُمُ","we will conceal","ذَا قُرْبَىٰ ۙ وَلَا","شَهَـٰدَةَ ٱللَّهِ إِنَّآ",490],["21:110:8",331,"تَكْتُمُونَ","you conceal","ٱلْقَوْلِ وَيَعْلَمُ مَا","",490],["24:29:17",353,"تَكْتُمُونَ","you conceal","مَا تُبْدُونَ وَمَا","",490],["40:28:7",470,"يَكْتُمُ","who conceal(ed)","مِّنْ ءَالِ فِرْعَوْنَ","إِيمَـٰنَهُۥٓ أَتَقْتُلُونَ رَجُلًا",490]]