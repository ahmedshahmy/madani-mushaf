[["2:97:5",15,"لِّجِبْرِيلَ","to Jibreel","مَن كَانَ عَدُوًّۭا","فَإِنَّهُۥ نَزَّلَهُۥ عَلَىٰ",1860],["2:98:7",15,"وَجِبْرِيلَ","and Jibreel","لِّلَّهِ وَمَلَـٰٓئِكَتِهِۦ وَرُسُلِهِۦ","وَمِيكَىٰلَ فَإِنَّ ٱللَّهَ",1860],["66:4:15",560,"وَجِبْرِيلُ","and Jibreel","ٱللَّهَ هُوَ مَوْلَىٰهُ","وَصَـٰلِحُ ٱلْمُؤْمِنِينَ ۖ وَٱلْمَلَـٰٓئِكَةُ",1860]]