[["2:26:31",5,"كَثِيرًۭا","many","مَثَلًۭا ۘ يُضِلُّ بِهِۦ","وَيَهْدِى بِهِۦ كَثِيرًۭا ۚ",190],["2:26:34",5,"كَثِيرًۭا ۚ","many","كَثِيرًۭا وَيَهْدِى بِهِۦ","وَمَا يُضِلُّ بِهِۦٓ",190],["2:100:8",15,"أَكْثَرُهُمْ","most of them","فَرِيقٌۭ مِّنْهُم ۚ بَلْ","لَا يُؤْمِنُونَ",140],["2:109:2",17,"كَثِيرٌۭ","many","وَدَّ","مِّنْ أَهْلِ ٱلْكِتَـٰبِ",190],["2:243:25",39,"أَكْثَرَ","most","عَلَى ٱلنَّاسِ وَلَـٰكِنَّ","ٱلنَّاسِ لَا يَشْكُرُونَ",140],["2:245:11",39,"كَثِيرَةًۭ ۚ","many","فَيُضَـٰعِفَهُۥ لَهُۥٓ أَضْعَافًۭا","وَٱللَّهُ يَقْبِضُ وَيَبْصُۜطُ",786],["2:249:55",41,"كَثِيرَةًۢ","large","قَلِيلَةٍ غَلَبَتْ فِئَةًۭ","بِإِذْنِ ٱللَّهِ ۗ وَٱللَّهُ",786],["2:269:11",45,"كَثِيرًۭا ۗ","abundant","فَقَدْ أُوتِىَ خَيْرًۭا","وَمَا يَذَّكَّرُ إِلَّآ",190],["3:41:17",55,"كَثِيرًۭا","much","رَمْزًۭا ۗ وَٱذْكُر رَّبَّكَ","وَسَبِّحْ بِٱلْعَشِىِّ وَٱلْإِبْكَـٰرِ",190],["3:110:22",64,"وَأَكْثَرُهُمُ","but most of them","لَّهُم ۚ مِّنْهُمُ ٱلْمُؤْمِنُونَ","ٱلْفَـٰسِقُونَ",140],["3:146:7",68,"كَثِيرٌۭ","many","قَـٰتَلَ مَعَهُۥ رِبِّيُّونَ","فَمَا وَهَنُوا۟ لِمَآ",190],["3:186:16",74,"كَثِيرًۭا ۚ","many","ٱلَّذِينَ أَشْرَكُوٓا۟ أَذًۭى","وَإِن تَصْبِرُوا۟ وَتَتَّقُوا۟",190],["4:1:16",77,"كَثِيرًۭا","many","وَبَثَّ مِنْهُمَا رِجَالًۭا","وَنِسَآءًۭ ۚ وَٱتَّقُوا۟ ٱللَّهَ",190],["4:7:17",78,"كَثُرَ ۚ","much","قَلَّ مِنْهُ أَوْ","نَصِيبًۭا مَّفْرُوضًۭا",2421],["4:12:67",79,"أَكْثَرَ","more","ٱلسُّدُسُ ۚ فَإِن كَانُوٓا۟","مِن ذَٰلِكَ فَهُمْ",140],["4:19:34",80,"كَثِيرًۭا","much","ٱللَّهُ فِيهِ خَيْرًۭا","",190],["4:82:13",91,"كَثِيرًۭا","much","لَوَجَدُوا۟ فِيهِ ٱخْتِلَـٰفًۭا","",190],["4:94:25",93,"كَثِيرَةٌۭ ۚ","abundant","فَعِندَ ٱللَّهِ مَغَانِمُ","كَذَٰلِكَ كُنتُم مِّن",786],["4:100:10",94,"كَثِيرًۭا","many","فِى ٱلْأَرْضِ مُرَٰغَمًۭا","وَسَعَةًۭ ۚ وَمَن يَخْرُجْ",190],["4:114:4",97,"كَثِيرٍۢ","much","۞ لَّا خَيْرَ فِى","مِّن نَّجْوَىٰهُمْ إِلَّا",190],["4:160:14",103,"كَثِيرًۭا","many","عَن سَبِيلِ ٱللَّهِ","",190],["5:15:8",110,"كَثِيرًۭا","much","رَسُولُنَا يُبَيِّنُ لَكُمْ","مِّمّ