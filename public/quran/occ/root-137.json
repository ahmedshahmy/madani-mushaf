[["2:31:6",6,"عَرَضَهُمْ","He displayed them","ٱلْأَسْمَآءَ كُلَّهَا ثُمَّ","عَلَى ٱلْمَلَـٰٓئِكَةِ فَقَالَ",770],["2:83:29",12,"مُّعْرِضُونَ","refusing","قَلِيلًۭا مِّنكُمْ وَأَنتُم","",530],["2:224:4",35,"عُرْضَةًۭ","an excuse","وَلَا تَجْعَلُوا۟ ٱللَّهَ","لِّأَيْمَـٰنِكُمْ أَن تَبَرُّوا۟",3152],["2:235:5",38,"عَرَّضْتُم","you hint","جُنَاحَ عَلَيْكُمْ فِيمَا","بِهِۦ مِنْ خِطْبَةِ",3125],["3:23:20",53,"مُّعْرِضُونَ","those who are averse","فَرِيقٌۭ مِّنْهُمْ وَهُم","",530],["3:133:7",67,"عَرْضُهَا","its width","مِّن رَّبِّكُمْ وَجَنَّةٍ","ٱلسَّمَـٰوَٰتُ وَٱلْأَرْضُ أُعِدَّتْ",1502],["4:16:8",80,"فَأَعْرِضُوا۟","then turn away","فَإِن تَابَا وَأَصْلَحَا","عَنْهُمَآ ۗ إِنَّ ٱللَّهَ",349],["4:63:8",88,"فَأَعْرِضْ","so turn away","مَا فِى قُلُوبِهِمْ","عَنْهُمْ وَعِظْهُمْ وَقُل",349],["4:81:17",91,"فَأَعْرِضْ","So turn (away)","يَكْتُبُ مَا يُبَيِّتُونَ ۖ","عَنْهُمْ وَتَوَكَّلْ عَلَى",349],["4:94:19",93,"عَرَضَ","transitory gains","لَسْتَ مُؤْمِنًۭا تَبْتَغُونَ","ٱلْحَيَوٰةِ ٱلدُّنْيَا فَعِندَ",1154],["4:128:8",99,"إِعْرَاضًۭا","desertion","بَعْلِهَا نُشُوزًا أَوْ","فَلَا جُنَاحَ عَلَيْهِمَآ",2135],["4:135:31",100,"تُعْرِضُوا۟","refrain","وَإِن تَلْوُۥٓا۟ أَوْ","فَإِنَّ ٱللَّهَ كَانَ",349],["5:42:10",115,"أَعْرِضْ","turn away","فَٱحْكُم بَيْنَهُمْ أَوْ","عَنْهُمْ ۖ وَإِن تُعْرِضْ",349],["5:42:13",115,"تُعْرِضْ","you turn away","أَعْرِضْ عَنْهُمْ ۖ وَإِن","عَنْهُمْ فَلَن يَضُرُّوكَ",349],["6:4:11",128,"مُعْرِضِينَ","turning away","إِلَّا كَانُوا۟ عَنْهَا","",530],["6:35:5",131,"إِعْرَاضُهُمْ","their aversion","كَانَ كَبُرَ عَلَيْكَ","فَإِنِ ٱسْتَطَعْتَ أَن",2135],["6:68:7",135,"فَأَعْرِضْ","then turn away","يَخُوضُونَ فِىٓ ءَايَـٰتِنَا","عَنْهُمْ حَتَّىٰ يَخُوضُوا۟",349],["6:106:11",141,"وَأَعْرِضْ","and turn away","إِلَـٰهَ إِلَّا هُوَ ۖ","عَنِ ٱلْمُشْرِكِينَ",349],["7:169:8",172,"عَرَضَ","goods","وَرِثُوا۟ ٱلْكِتَـٰبَ يَأْخُذُونَ","هَـٰذَا ٱلْأَدْنَىٰ وَيَقُولُونَ",1154],["7:169:16",172,"عَرَضٌۭ","goods","لَنَا وَإِن يَأْتِهِمْ","مِّثْلُهُۥ يَأْخُذُوهُ ۚ أَلَمْ",1154],["7:199:5",176,"وَأَعْرِضْ","and turn away","ٱلْعَفْوَ وَأْمُرْ بِٱلْعُرْفِ","عَنِ ٱلْجَـٰهِلِينَ",349],["8:23:11",179,"مُّعْرِضُونَ","(were) averse","أَسْمَعَهُمْ لَتَوَلَّوا۟ وَّهُم","",530],["8:67:13",185,"عَرَضَ","(the) commodities","فِى ٱلْأَرْضِ ۚ تُرِيدُونَ","ٱلدُّنْيَا وَٱللَّهُ يُرِيدُ",1154],["9:42:3",194,"عَرَضًۭا","a gain","لَوْ كَانَ","قَرِيبًۭا وَسَفَرًۭا قَاصِدًۭا",1154],["9:76:9",199,"مُّعْرِضُونَ","(were) averse","بِهِۦ وَتَوَلَّوا۟ وَّهُم","",530],["9:95:7",202,"لِتُعْرِضُوا۟","that you may turn away","إِذَا ٱنقَلَبْتُمْ إِلَيْهِمْ","عَنْهُمْ ۖ فَأَعْرِضُوا۟ عَنْهُمْ ۖ",349],["9:95:9",202,"فَأَعْرِضُوا۟","So turn away","إِلَيْهِمْ لِتُعْرِضُوا۟ عَنْهُمْ ۖ","عَنْهُمْ ۖ إِنَّهُمْ رِجْسٌۭ ۖ",349],["11:18:9",223,"يُعْرَضُونَ","will be presented","ٱللَّهِ كَذِبًا ۚ أُو۟لَـٰٓئِكَ","عَلَىٰ رَبِّهِمْ وَيَقُولُ",770],["11:76:2",230,"أَعْرِضْ","Turn away","يَـٰٓإِبْرَٰهِيمُ","عَنْ هَـٰذَآ ۖ إِنَّهُۥ",349],["12:29:2",238,"أَعْرِضْ","turn away","يُوسُفُ","عَنْ هَـٰذَا ۚ وَٱسْتَغْفِرِى",349],["12:105:11",248,"مُعْرِضُونَ","the ones who turn away","عَلَيْهَا وَهُمْ عَنْهَا","",530],["15:81:5",266,"مُعْرِضِينَ","turning away","ءَايَـٰتِنَا فَكَانُوا۟ عَنْهَا","",530],["15:94:4",267,"وَأَعْرِضْ","and turn away","فَٱصْدَعْ بِمَا تُؤْمَرُ","عَنِ ٱلْمُشْرِكِينَ",349],["17:28:2",285,"تُعْرِضَنَّ","you turn away","وَإِمَّا","عَنْهُمُ ٱبْتِغَآءَ رَحْمَةٍۢ",349],["17:67:15",289,"أَعْرَضْتُمْ ۚ","you turn away","نَجَّىٰكُمْ إِلَى ٱلْبَرِّ","وَكَانَ ٱلْإِنسَـٰنُ كَفُورًا",349],["17:83:5",290,"أَعْرَضَ","he turns away","أَنْعَمْنَا عَلَى ٱلْإِنسَـٰنِ","وَنَـَٔا بِجَانِبِهِۦ ۖ وَإِذَا",349],["18:48:1",299,"وَعُرِضُوا۟","And they will be presented","","عَلَىٰ رَبِّكَ صَفًّۭا",770],["18:57:7",300,"فَأَعْرَضَ","but turns away","ذُكِّرَ بِـَٔايَـٰتِ رَبِّهِۦ","عَنْهَا وَنَسِىَ مَا",349],["18:100:1",304,"وَعَرَضْنَا","And We (will) present","","جَهَنَّمَ يَوْمَئِذٍۢ لِّلْكَـٰفِرِينَ",770],["18:100:5",304,"عَرْضًا","(on) display","جَهَنَّمَ يَوْمَئِذٍۢ لِّلْكَـٰفِرِينَ","",1502],["20:100:2",319,"أَعْرَضَ","turns away","مَّنْ","عَنْهُ فَإِنَّهُۥ يَحْمِلُ",349],["20:124:2",320,"أَعْرَضَ","turns away","وَمَنْ","عَن ذِكْرِى فَإِنَّ",349],["21:1:7",322,"مُّعْرِضُونَ","turning away","وَهُمْ فِى غَفْلَةٍۢ","",530],["21:24:22",323,"مُّعْرِضُونَ","(are) averse","يَعْلَمُونَ ٱلْحَقَّ ۖ فَهُم","",530],["21:32:8",324,"مُعْرِضُونَ","turn away","وَهُمْ عَنْ ءَايَـٰتِهَا","",530],["21:42:13",325,"مُّعْرِضُونَ","turn away","عَن ذِكْرِ رَبِّهِم","",530],["23:3:5",342,"مُعْرِضُونَ","turn away","هُمْ عَنِ ٱللَّغْوِ","",530],["23:71:16",346,"مُّعْرِضُونَ","(are) turning away","فَهُمْ عَن ذِكْرِهِم","",530],["24:33:37",354,"عَرَضَ","temporary gain","أَرَدْنَ تَحَصُّنًۭا لِّتَبْتَغُوا۟","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۚ وَمَن",1154],["24:48:11",356,"مُّعْرِضُونَ","(is) averse","إِذَا فَرِيقٌۭ مِّنْهُم","",530],["26:5:11",367,"مُعْرِضِينَ","turn away","إِلَّا كَانُوا۟ عَنْهُ","",530],["28:55:4",392,"أَعْرَضُوا۟","they turn away","وَإِذَا سَمِعُوا۟ ٱللَّغْوَ","عَنْهُ وَقَالُوا۟ لَنَآ",349],["32:22:8",417,"أَعْرَضَ","he turns away","بِـَٔايَـٰتِ رَبِّهِۦ ثُمَّ","عَنْهَآ ۚ إِنَّا مِنَ",349],["32:30:1",417,"فَأَعْرِضْ","So turn away","","عَنْهُمْ وَٱنتَظِرْ إِنَّهُم",349],["33:72:2",427,"عَرَضْنَا","[We] offered","إِنَّا","ٱلْأَمَانَةَ عَلَى ٱلسَّمَـٰوَٰتِ",770],["34:16:1",430,"فَأَعْرَضُوا۟","But they turned away","","فَأَرْسَلْنَا عَلَيْهِمْ سَيْلَ",349],["36:46:11",443,"مُعْرِضِينَ","turn away","إِلَّا كَانُوا۟ عَنْهَا","",530],["38:31:2",455,"عُرِضَ","were displayed","إِذْ","عَلَيْهِ بِٱلْعَشِىِّ ٱلصَّـٰفِنَـٰتُ",770],["38:68:3",457,"مُعْرِضُونَ","turn away","أَنتُمْ عَنْهُ","",530],["40:46:2",472,"يُعْرَضُونَ","they are exposed","ٱلنَّارُ","عَلَيْهَا غُدُوًّۭا وَعَشِيًّۭا ۖ",770],["41:4:3",477,"فَأَعْرَضَ","but turn away","بَشِيرًۭا وَنَذِيرًۭا","أَكْثَرُهُمْ فَهُمْ لَا",349],["41:13:2",478,"أَعْرَضُوا۟","they turn away","فَإِنْ","فَقُلْ أَنذَرْتُكُمْ صَـٰعِقَةًۭ",349],["41:51:5",482,"أَعْرَضَ","he turns away","أَنْعَمْنَا عَلَى ٱلْإِنسَـٰنِ","وَنَـَٔا بِجَانِبِهِۦ وَإِذَا",349],["41:51:13",482,"عَرِيضٍۢ","lengthy","ٱلشَّرُّ فَذُو دُعَآءٍ","",3124],["42:45:2",488,"يُعْرَضُونَ","being exposed","وَتَرَىٰهُمْ","عَلَيْهَا خَـٰشِعِينَ مِنَ",770],["42:48:2",488,"أَعْرَضُوا۟","they turn away","فَإِنْ","فَمَآ أَرْسَلْنَـٰكَ عَلَيْهِمْ",349],["46:3:15",502,"مُعْرِضُونَ","(are) turning away","كَفَرُوا۟ عَمَّآ أُنذِرُوا۟","",530],["46:20:2",504,"يُعْرَضُ","will be exposed","وَيَوْمَ","ٱلَّذِينَ كَفَرُوا۟ عَلَى",770],["46:24:3",505,"عَارِضًۭا","(as) a cloud","فَلَمَّا رَأَوْهُ","مُّسْتَقْبِلَ أَوْدِيَتِهِمْ قَالُوا۟",2227],["46:24:8",505,"عَارِضٌۭ","(is) a cloud","أَوْدِيَتِهِمْ قَالُوا۟ هَـٰذَا","مُّمْطِرُنَا ۚ بَلْ هُوَ",2227],["46:34:2",506,"يُعْرَضُ","are exposed","وَيَوْمَ","ٱلَّذِينَ كَفَرُوا۟ عَلَى",770],["53:29:1",527,"فَأَعْرِضْ","So turn away","","عَن مَّن تَوَلَّىٰ",349],["54:2:4",528,"يُعْرِضُوا۟","they turn away","وَإِن يَرَوْا۟ ءَايَةًۭ","وَيَقُولُوا۟ سِحْرٌۭ مُّسْتَمِرٌّۭ",349],["57:21:7",540,"عَرْضُهَا","its width","مِّن رَّبِّكُمْ وَجَنَّةٍ","كَعَرْضِ ٱلسَّمَآءِ وَٱلْأَرْضِ",1502],["57:21:8",540,"كَعَرْضِ","(is) like (the) width","رَّبِّكُمْ وَجَنَّةٍ عَرْضُهَا","ٱلسَّمَآءِ وَٱلْأَرْضِ أُعِدَّتْ",1502],["66:3:16",560,"وَأَعْرَضَ","and avoided","عَلَيْهِ عَرَّفَ بَعْضَهُۥ","عَنۢ بَعْضٍۢ ۖ فَلَمَّا",349],["69:18:2",567,"تُعْرَضُونَ","you will be exhibited","يَوْمَئِذٍۢ","لَا تَخْفَىٰ مِنكُمْ",770],["72:17:4",573,"يُعْرِضْ","turns away","لِّنَفْتِنَهُمْ فِيهِ ۚ وَمَن","عَن ذِكْرِ رَبِّهِۦ",349],["74:49:5",577,"مُعْرِضِينَ","they (are) turning away","لَهُمْ عَنِ ٱلتَّذْكِرَةِ","",530]]