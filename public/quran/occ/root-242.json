[["2:60:18",9,"مَّشْرَبَهُمْ ۖ","their drinking place","عَلِمَ كُلُّ أُنَاسٍۢ","كُلُوا۟ وَٱشْرَبُوا۟ مِن",1920],["2:60:20",9,"وَٱشْرَبُوا۟","and drink","أُنَاسٍۢ مَّشْرَبَهُمْ ۖ كُلُوا۟","مِن رِّزْقِ ٱللَّهِ",614],["2:93:15",14,"وَأُشْرِبُوا۟","And they were made to drink","قَالُوا۟ سَمِعْنَا وَعَصَيْنَا","فِى قُلُوبِهِمُ ٱلْعِجْلَ",3063],["2:187:32",29,"وَٱشْرَبُوا۟","and drink","ٱللَّهُ لَكُمْ ۚ وَكُلُوا۟","حَتَّىٰ يَتَبَيَّنَ لَكُمُ",614],["2:249:11",41,"شَرِبَ","drinks","مُبْتَلِيكُم بِنَهَرٍۢ فَمَن","مِنْهُ فَلَيْسَ مِنِّى",614],["2:249:25",41,"فَشَرِبُوا۟","Then they drank","ٱغْتَرَفَ غُرْفَةًۢ بِيَدِهِۦ ۚ","مِنْهُ إِلَّا قَلِيلًۭا",614],["2:259:40",43,"وَشَرَابِكَ","and your drink","فَٱنظُرْ إِلَىٰ طَعَامِكَ","لَمْ يَتَسَنَّهْ ۖ وَٱنظُرْ",756],["6:70:38",136,"شَرَابٌۭ","(will be) a drink","بِمَا كَسَبُوا۟ ۖ لَهُمْ","مِّنْ حَمِيمٍۢ وَعَذَابٌ",756],["7:31:9",154,"وَٱشْرَبُوا۟","and drink","كُلِّ مَسْجِدٍۢ وَكُلُوا۟","وَلَا تُسْرِفُوٓا۟ ۚ إِنَّهُۥ",614],["7:160:25",171,"مَّشْرَبَهُمْ ۚ","their drinking place","عَلِمَ كُلُّ أُنَاسٍۢ","وَظَلَّلْنَا عَلَيْهِمُ ٱلْغَمَـٰمَ",1920],["10:4:21",208,"شَرَابٌۭ","(will be) a drink","وَٱلَّذِينَ كَفَرُوا۟ لَهُمْ","مِّنْ حَمِيمٍۢ وَعَذَابٌ",756],["16:10:9",268,"شَرَابٌۭ","(is) drink","مَآءًۭ ۖ لَّكُم مِّنْهُ","وَمِنْهُ شَجَرٌۭ فِيهِ",756],["16:66:17",274,"لِّلشَّـٰرِبِينَ","to the drinkers","لَّبَنًا خَالِصًۭا سَآئِغًۭا","",1267],["16:69:13",274,"شَرَابٌۭ","a drink","يَخْرُجُ مِنۢ بُطُونِهَا","مُّخْتَلِفٌ أَلْوَٰنُهُۥ فِيهِ",756],["18:29:26",297,"ٱلشَّرَابُ","(is) the drink","يَشْوِى ٱلْوُجُوهَ ۚ بِئْسَ","وَسَآءَتْ مُرْتَفَقًا",756],["19:26:2",307,"وَٱشْرَبِى","and drink","فَكُلِى","وَقَرِّى عَيْنًۭا ۖ فَإِمَّا",614],["23:33:23",344,"وَيَشْرَبُ","and he drinks","مِمَّا تَأْكُلُونَ مِنْهُ","مِمَّا تَشْرَبُونَ",614],["23:33:25",344,"تَشْرَبُونَ","you drink","مِنْهُ وَيَشْرَبُ مِمَّا","",614],["26:155:5",373,"شِرْبٌۭ","(is a share of) drink","هَـٰذِهِۦ نَاقَةٌۭ لَّهَا","وَلَكُمْ شِرْبُ يَوْمٍۢ",1706],["26:155:7",373,"شِرْبُ","(is a share of) drink","لَّهَا شِرْبٌۭ وَلَكُمْ","يَوْمٍۢ مَّعْلُومٍۢ",1706],["35:12:8",436,"شَرَابُهُۥ","its drink","عَذْبٌۭ فُرَاتٌۭ سَآئِغٌۭ","وَهَـٰذَا مِلْحٌ أُجَاجٌۭ ۖ",756],["36:73:4",445,"وَمَشَارِبُ ۖ","and drinks","وَلَهُمْ فِيهَا مَنَـٰفِعُ","أَفَلَا يَشْكُرُونَ",1920],["37:46:3",447,"لِّلشَّـٰرِبِينَ","for the drinkers","بَيْضَآءَ لَذَّةٍۢ","",1267],["38:42:6",455,"وَشَرَابٌۭ","and a drink","هَـٰذَا مُغْتَسَلٌۢ بَارِدٌۭ","",756],["38:51:7",456,"وَشَرَابٍۢ","and drink","فِيهَا بِفَـٰكِهَةٍۢ كَثِيرَةٍۢ","",756],["47:15:22",508,"لِّلشَّـٰرِبِينَ","for (the) drinkers","مِّنْ خَمْرٍۢ لَّذَّةٍۢ","وَأَنْهَـٰرٌۭ مِّنْ عَسَلٍۢ",1267],["52:19:2",524,"وَٱشْرَبُوا۟","and drink","كُلُوا۟","هَنِيٓـًٔۢا بِمَا كُنتُمْ",614],["54:28:7",530,"شِرْبٍۢ","drink","قِسْمَةٌۢ بَيْنَهُمْ ۖ كُلُّ","مُّحْتَضَرٌۭ",1706],["56:54:1",536,"فَشَـٰرِبُونَ","And drink","","عَلَيْهِ مِنَ ٱلْحَمِيمِ",1267],["56:55:1",536,"فَشَـٰرِبُونَ","And will drink","","شُرْبَ ٱلْهِيمِ",1267],["56:55:2",536,"شُرْبَ","(as) drinking","فَشَـٰرِبُونَ","ٱلْهِيمِ",2893],["56:68:4",536,"تَشْرَبُونَ","you drink","أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى","",614],["69:24:2",567,"وَٱشْرَبُوا۟","and drink","كُلُوا۟","هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ",614],["76:5:3",578,"يَشْرَبُونَ","will drink","إِنَّ ٱلْأَبْرَارَ","مِن كَأْسٍۢ كَانَ",614],["76:6:2",579,"يَشْرَبُ","will drink","عَيْنًۭا","بِهَا عِبَادُ ٱللَّهِ",614],["76:21:12",579,"شَرَابًۭا","a drink","فِضَّةٍۢ وَسَقَىٰهُمْ رَبُّهُمْ","طَهُورًا",756],["77:43:2",581,"وَٱشْرَبُوا۟","and drink","كُلُوا۟","هَنِيٓـًٔۢا بِمَا كُنتُمْ",614],["78:24:6",582,"شَرَابًا","any drink","فِيهَا بَرْدًۭا وَلَا","",756],["83:28:2",588,"يَشْرَبُ","will drink","عَيْنًۭا","بِهَا ٱلْمُقَرَّبُونَ",614]]