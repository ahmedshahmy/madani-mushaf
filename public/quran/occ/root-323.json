[["4:40:5",85,"مِثْقَالَ","(as much as) weight","ٱللَّهَ لَا يَظْلِمُ","ذَرَّةٍۢ ۖ وَإِن تَكُ",984],["7:8:5",151,"ثَقُلَتْ","(will be) heavy","يَوْمَئِذٍ ٱلْحَقُّ ۚ فَمَن","مَوَٰزِينُهُۥ فَأُو۟لَـٰٓئِكَ هُمُ",1654],["7:57:13",157,"ثِقَالًۭا","heavy","إِذَآ أَقَلَّتْ سَحَابًۭا","سُقْنَـٰهُ لِبَلَدٍۢ مَّيِّتٍۢ",1409],["7:187:16",174,"ثَقُلَتْ","It lays heavily","لِوَقْتِهَآ إِلَّا هُوَ ۚ","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ",1654],["7:189:20",175,"أَثْقَلَت","she grows heavy","فَمَرَّتْ بِهِۦ ۖ فَلَمَّآ","دَّعَوَا ٱللَّهَ رَبَّهُمَا",3046],["9:38:13",193,"ٱثَّاقَلْتُمْ","you cling heavily","فِى سَبِيلِ ٱللَّهِ","إِلَى ٱلْأَرْضِ ۚ أَرَضِيتُم",4846],["9:41:3",194,"وَثِقَالًۭا","or heavy","ٱنفِرُوا۟ خِفَافًۭا","وَجَـٰهِدُوا۟ بِأَمْوَٰلِكُمْ وَأَنفُسِكُمْ",1409],["10:61:26",215,"مِّثْقَالِ","(the) weight","عَن رَّبِّكَ مِن","ذَرَّةٍۢ فِى ٱلْأَرْضِ",984],["13:12:9",250,"ٱلثِّقَالَ","the heavy","وَطَمَعًۭا وَيُنشِئُ ٱلسَّحَابَ","",1409],["16:7:2",268,"أَثْقَالَكُمْ","your loads","وَتَحْمِلُ","إِلَىٰ بَلَدٍۢ لَّمْ",1238],["21:47:12",326,"مِثْقَالَ","weight","شَيْـًۭٔا ۖ وَإِن كَانَ","حَبَّةٍۢ مِّنْ خَرْدَلٍ",984],["23:102:2",348,"ثَقُلَتْ","(are) heavy","فَمَن","مَوَٰزِينُهُۥ فَأُو۟لَـٰٓئِكَ هُمُ",1654],["29:13:2",397,"أَثْقَالَهُمْ","their burdens","وَلَيَحْمِلُنَّ","وَأَثْقَالًۭا مَّعَ أَثْقَالِهِمْ ۖ",1238],["29:13:3",397,"وَأَثْقَالًۭا","and burdens","وَلَيَحْمِلُنَّ أَثْقَالَهُمْ","مَّعَ أَثْقَالِهِمْ ۖ وَلَيُسْـَٔلُنَّ",1238],["29:13:5",397,"أَثْقَالِهِمْ ۖ","their burdens","أَثْقَالَهُمْ وَأَثْقَالًۭا مَّعَ","وَلَيُسْـَٔلُنَّ يَوْمَ ٱلْقِيَـٰمَةِ",1238],["31:16:5",412,"مِثْقَالَ","(the) weight","إِنَّهَآ إِن تَكُ","حَبَّةٍۢ مِّنْ خَرْدَلٍۢ",984],["34:3:16",428,"مِثْقَالُ","(the) weight","لَا يَعْزُبُ عَنْهُ","ذَرَّةٍۢ فِى ٱلسَّمَـٰوَٰتِ",984],["34:22:10",430,"مِثْقَالَ","(the) weight","ٱللَّهِ ۖ لَا يَمْلِكُونَ","ذَرَّةٍۢ فِى ٱلسَّمَـٰوَٰتِ",984],["35:18:8",436,"مُثْقَلَةٌ","a heavily laden","أُخْرَىٰ ۚ وَإِن تَدْعُ","إِلَىٰ حِمْلِهَا لَا",3884],["52:40:7",525,"مُّثْقَلُونَ","(are) overburdened","فَهُم مِّن مَّغْرَمٍۢ","",2544],["55:31:4",532,"ٱلثَّقَلَانِ","two classes","سَنَفْرُغُ لَكُمْ أَيُّهَ","",1238],["68:46:7",566,"مُّثْقَلُونَ","(are) burdened","فَهُم مِّن مَّغْرَمٍۢ","",2544],["73:5:5",574,"ثَقِيلًا","heavy","سَنُلْقِى عَلَيْكَ قَوْلًۭا","",1409],["76:27:8",580,"ثَقِيلًۭا","grave","وَيَذَرُونَ وَرَآءَهُمْ يَوْمًۭا","",1409],["99:2:3",599,"أَثْقَالَهَا","its burdens","وَأَخْرَجَتِ ٱلْأَرْضُ","",1238],["99:7:3",599,"مِثْقَالَ","(equal to the) weight","فَمَن يَعْمَلْ","ذَرَّةٍ خَيْرًۭا يَرَهُۥ",984],["99:8:3",599,"مِثْقَالَ","(equal to the) weight","وَمَن يَعْمَلْ","ذَرَّةٍۢ شَرًّۭا يَرَهُۥ",984],["101:6:3",600,"ثَقُلَتْ","(are) heavy","فَأَمَّا مَن","مَوَٰزِينُهُۥ",1654]]