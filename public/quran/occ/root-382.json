[["2:124:6",19,"فَأَتَمَّهُنَّ ۖ","and he fulfilled them","إِبْرَٰهِـۧمَ رَبُّهُۥ بِكَلِمَـٰتٍۢ","قَالَ إِنِّى جَاعِلُكَ",588],["2:150:27",23,"وَلِأُتِمَّ","And that I complete","فَلَا تَخْشَوْهُمْ وَٱخْشَوْنِى","نِعْمَتِى عَلَيْكُمْ وَلَعَلَّكُمْ",588],["2:187:44",29,"أَتِمُّوا۟","complete","مِنَ ٱلْفَجْرِ ۖ ثُمَّ","ٱلصِّيَامَ إِلَى ٱلَّيْلِ ۚ",588],["2:196:1",30,"وَأَتِمُّوا۟","And complete","","ٱلْحَجَّ وَٱلْعُمْرَةَ لِلَّهِ ۚ",588],["2:233:9",37,"يُتِمَّ","complete","لِمَنْ أَرَادَ أَن","ٱلرَّضَاعَةَ ۚ وَعَلَى ٱلْمَوْلُودِ",588],["5:3:44",107,"وَأَتْمَمْتُ","and I have completed","أَكْمَلْتُ لَكُمْ دِينَكُمْ","عَلَيْكُمْ نِعْمَتِى وَرَضِيتُ",588],["5:6:57",108,"وَلِيُتِمَّ","and to complete","وَلَـٰكِن يُرِيدُ لِيُطَهِّرَكُمْ","نِعْمَتَهُۥ عَلَيْكُمْ لَعَلَّكُمْ",588],["6:115:1",142,"وَتَمَّتْ","And (has been) fulfilled","","كَلِمَتُ رَبِّكَ صِدْقًۭا",1649],["6:154:5",149,"تَمَامًا","completing (Our Favor)","ءَاتَيْنَا مُوسَى ٱلْكِتَـٰبَ","عَلَى ٱلَّذِىٓ أَحْسَنَ",4390],["7:137:12",166,"وَتَمَّتْ","And was fulfilled","ٱلَّتِى بَـٰرَكْنَا فِيهَا ۖ","كَلِمَتُ رَبِّكَ ٱلْحُسْنَىٰ",1649],["7:142:5",167,"وَأَتْمَمْنَـٰهَا","and We completed them","مُوسَىٰ ثَلَـٰثِينَ لَيْلَةًۭ","بِعَشْرٍۢ فَتَمَّ مِيقَـٰتُ",588],["7:142:7",167,"فَتَمَّ","so was completed","لَيْلَةًۭ وَأَتْمَمْنَـٰهَا بِعَشْرٍۢ","مِيقَـٰتُ رَبِّهِۦٓ أَرْبَعِينَ",1649],["9:4:14",187,"فَأَتِمُّوٓا۟","so fulfil","يُظَـٰهِرُوا۟ عَلَيْكُمْ أَحَدًۭا","إِلَيْهِمْ عَهْدَهُمْ إِلَىٰ",588],["9:32:11",192,"يُتِمَّ","perfect","ٱللَّهُ إِلَّآ أَن","نُورَهُۥ وَلَوْ كَرِهَ",588],["11:119:7",235,"وَتَمَّتْ","And will be fulfilled","رَبُّكَ ۚ وَلِذَٰلِكَ خَلَقَهُمْ ۗ","كَلِمَةُ رَبِّكَ لَأَمْلَأَنَّ",1649],["12:6:8",236,"وَيُتِمُّ","and complete","مِن تَأْوِيلِ ٱلْأَحَادِيثِ","نِعْمَتَهُۥ عَلَيْكَ وَعَلَىٰٓ",588],["12:6:15",236,"أَتَمَّهَا","He completed it","ءَالِ يَعْقُوبَ كَمَآ","عَلَىٰٓ أَبَوَيْكَ مِن",588],["16:81:21",276,"يُتِمُّ","He completes","تَقِيكُم بَأْسَكُمْ ۚ كَذَٰلِكَ","نِعْمَتَهُۥ عَلَيْكُمْ لَعَلَّكُمْ",588],["28:27:15",388,"أَتْمَمْتَ","you complete","ثَمَـٰنِىَ حِجَجٍۢ ۖ فَإِنْ","عَشْرًۭا فَمِنْ عِندِكَ ۖ",588],["48:2:10",511,"وَيُتِمَّ","and complete","ذَنۢبِكَ وَمَا تَأَخَّرَ","نِعْمَتَهُۥ عَلَيْكَ وَيَهْدِيَكَ",588],["61:8:7",552,"مُتِمُّ","will perfect","ٱللَّهِ بِأَفْوَٰهِهِمْ وَٱللَّهُ","نُورِهِۦ وَلَوْ كَرِهَ",3881],["66:8:36",561,"أَتْمِمْ","Perfect","وَبِأَيْمَـٰنِهِمْ يَقُولُونَ رَبَّنَآ","لَنَا نُورَنَا وَٱغْفِرْ",588]]