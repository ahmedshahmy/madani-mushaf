[["4:43:41",85,"فَٱمْسَحُوا۟","and wipe (with it)","فَتَيَمَّمُوا۟ صَعِيدًۭا طَيِّبًۭا","بِوُجُوهِكُمْ وَأَيْدِيكُمْ ۗ إِنَّ",2103],["5:6:13",108,"وَٱمْسَحُوا۟","and wipe","وَأَيْدِيَكُمْ إِلَى ٱلْمَرَافِقِ","بِرُءُوسِكُمْ وَأَرْجُلَكُمْ إِلَى",2103],["5:6:43",108,"فَٱمْسَحُوا۟","then wipe","فَتَيَمَّمُوا۟ صَعِيدًۭا طَيِّبًۭا","بِوُجُوهِكُمْ وَأَيْدِيكُم مِّنْهُ ۚ",2103],["38:33:4",455,"مَسْحًۢا","(to) pass (his hand)","رُدُّوهَا عَلَىَّ ۖ فَطَفِقَ","بِٱلسُّوقِ وَٱلْأَعْنَاقِ",3714]]