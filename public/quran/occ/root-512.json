[["7:164:15",172,"مَعْذِرَةً","To be absolved","عَذَابًۭا شَدِيدًۭا ۖ قَالُوا۟","إِلَىٰ رَبِّكُمْ وَلَعَلَّهُمْ",1881],["9:66:2",197,"تَعْتَذِرُوا۟","make excuse","لَا","قَدْ كَفَرْتُم بَعْدَ",1428],["9:90:2",201,"ٱلْمُعَذِّرُونَ","the ones who make excuses","وَجَآءَ","مِنَ ٱلْأَعْرَابِ لِيُؤْذَنَ",3757],["9:94:1",202,"يَعْتَذِرُونَ","They will make excuses","","إِلَيْكُمْ إِذَا رَجَعْتُمْ",1428],["9:94:8",202,"تَعْتَذِرُوا۟","make excuse","إِلَيْهِمْ ۚ قُل لَّا","لَن نُّؤْمِنَ لَكُمْ",1428],["18:76:13",302,"عُذْرًۭا","an excuse","بَلَغْتَ مِن لَّدُنِّى","",2256],["30:57:6",410,"مَعْذِرَتُهُمْ","their excuses","يَنفَعُ ٱلَّذِينَ ظَلَمُوا۟","وَلَا هُمْ يُسْتَعْتَبُونَ",1881],["40:52:5",473,"مَعْذِرَتُهُمْ ۖ","their excuse","لَا يَنفَعُ ٱلظَّـٰلِمِينَ","وَلَهُمُ ٱللَّعْنَةُ وَلَهُمْ",1881],["66:7:5",560,"تَعْتَذِرُوا۟","make excuses","ٱلَّذِينَ كَفَرُوا۟ لَا","ٱلْيَوْمَ ۖ إِنَّمَا تُجْزَوْنَ",1428],["75:15:3",577,"مَعَاذِيرَهُۥ","his excuses","وَلَوْ أَلْقَىٰ","",3629],["77:6:1",580,"عُذْرًا","(As) justification","","أَوْ نُذْرًا",2256],["77:36:4",581,"فَيَعْتَذِرُونَ","to make excuses","وَلَا يُؤْذَنُ لَهُمْ","",1428]]