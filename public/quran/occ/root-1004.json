[["6:26:4",130,"وَيَنْـَٔوْنَ","and they keep away","وَهُمْ يَنْهَوْنَ عَنْهُ","عَنْهُ ۖ وَإِن يُهْلِكُونَ",1941],["17:83:6",290,"وَنَـَٔا","and becomes remote","عَلَى ٱلْإِنسَـٰنِ أَعْرَضَ","بِجَانِبِهِۦ ۖ وَإِذَا مَسَّهُ",1941],["41:51:6",482,"وَنَـَٔا","and distances himself","عَلَى ٱلْإِنسَـٰنِ أَعْرَضَ","بِجَانِبِهِۦ وَإِذَا مَسَّهُ",1941]]