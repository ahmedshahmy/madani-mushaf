[["3:170:10",72,"يَلْحَقُوا۟","yet joined","وَيَسْتَبْشِرُونَ بِٱلَّذِينَ لَمْ","بِهِم مِّنْ خَلْفِهِمْ",2769],["12:101:20",247,"وَأَلْحِقْنِى","and join me","وَٱلْـَٔاخِرَةِ ۖ تَوَفَّنِى مُسْلِمًۭا","بِٱلصَّـٰلِحِينَ",1471],["26:83:5",370,"وَأَلْحِقْنِى","and join me","هَبْ لِى حُكْمًۭا","بِٱلصَّـٰلِحِينَ",1471],["34:27:4",431,"أَلْحَقْتُم","you have joined","قُلْ أَرُونِىَ ٱلَّذِينَ","بِهِۦ شُرَكَآءَ ۖ كَلَّا ۚ",1471],["52:21:6",524,"أَلْحَقْنَا","We will join","وَٱتَّبَعَتْهُمْ ذُرِّيَّتُهُم بِإِيمَـٰنٍ","بِهِمْ ذُرِّيَّتَهُمْ وَمَآ",1471],["62:3:4",553,"يَلْحَقُوا۟","joined","وَءَاخَرِينَ مِنْهُمْ لَمَّا","بِهِمْ ۚ وَهُوَ ٱلْعَزِيزُ",2769]]