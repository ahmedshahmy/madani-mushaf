[["2:24:11",4,"وَٱلْحِجَارَةُ ۖ","and [the] stones","ٱلَّتِى وَقُودُهَا ٱلنَّاسُ","أُعِدَّتْ لِلْكَـٰفِرِينَ",823],["2:60:8",9,"ٱلْحَجَرَ ۖ","the stone","فَقُلْنَا ٱضْرِب بِّعَصَاكَ","فَٱنفَجَرَتْ مِنْهُ ٱثْنَتَا",2275],["2:74:8",11,"كَٱلْحِجَارَةِ","(became) like [the] stones","بَعْدِ ذَٰلِكَ فَهِىَ","أَوْ أَشَدُّ قَسْوَةًۭ ۚ",823],["2:74:14",11,"ٱلْحِجَارَةِ","the stones","قَسْوَةًۭ ۚ وَإِنَّ مِنَ","لَمَا يَتَفَجَّرُ مِنْهُ",823],["4:23:23",81,"حُجُورِكُم","your guardianship","وَرَبَـٰٓئِبُكُمُ ٱلَّـٰتِى فِى","مِّن نِّسَآئِكُمُ ٱلَّـٰتِى",3219],["6:138:5",146,"حِجْرٌۭ","forbidden","هَـٰذِهِۦٓ أَنْعَـٰمٌۭ وَحَرْثٌ","لَّا يَطْعَمُهَآ إِلَّا",1303],["7:160:15",171,"ٱلْحَجَرَ ۖ","the stone","أَنِ ٱضْرِب بِّعَصَاكَ","فَٱنۢبَجَسَتْ مِنْهُ ٱثْنَتَا",2275],["8:32:13",180,"حِجَارَةًۭ","(of) stones","عِندِكَ فَأَمْطِرْ عَلَيْنَا","مِّنَ ٱلسَّمَآءِ أَوِ",823],["11:82:9",231,"حِجَارَةًۭ","stones","سَافِلَهَا وَأَمْطَرْنَا عَلَيْهَا","مِّن سِجِّيلٍۢ مَّنضُودٍۢ",823],["15:74:6",266,"حِجَارَةًۭ","stones","سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ","مِّن سِجِّيلٍ",823],["15:80:4",266,"ٱلْحِجْرِ","(of) the Rocky Tract","وَلَقَدْ كَذَّبَ أَصْحَـٰبُ","ٱلْمُرْسَلِينَ",1303],["17:50:3",287,"حِجَارَةً","stones","۞ قُلْ كُونُوا۟","أَوْ حَدِيدًا",823],["25:22:9",362,"حِجْرًۭا","A partition","يَوْمَئِذٍۢ لِّلْمُجْرِمِينَ وَيَقُولُونَ","مَّحْجُورًۭا",1303],["25:22:10",362,"مَّحْجُورًۭا","forbidden","لِّلْمُجْرِمِينَ وَيَقُولُونَ حِجْرًۭا","",2519],["25:53:14",364,"وَحِجْرًۭا","and a partition","وَجَعَلَ بَيْنَهُمَا بَرْزَخًۭا","مَّحْجُورًۭا",1303],["25:53:15",364,"مَّحْجُورًۭا","forbidden","بَيْنَهُمَا بَرْزَخًۭا وَحِجْرًۭا","",2519],["49:4:6",515,"ٱلْحُجُرَٰتِ","the private chambers","يُنَادُونَكَ مِن وَرَآءِ","أَكْثَرُهُمْ لَا يَعْقِلُونَ",3218],["51:33:3",522,"حِجَارَةًۭ","stones","لِنُرْسِلَ عَلَيْهِمْ","مِّن طِينٍۢ",823],["66:6:10",560,"وَٱلْحِجَارَةُ","and stones","نَارًۭا وَقُودُهَا ٱلنَّاسُ","عَلَيْهَا مَلَـٰٓئِكَةٌ غِلَاظٌۭ",823],["89:5:6",593,"حِجْرٍ","who understand","ذَٰلِكَ قَسَمٌۭ لِّذِى","",1303],["105:4:2",601,"بِحِجَارَةٍۢ","with stones","تَرْمِيهِم","مِّن سِجِّيلٍۢ",823]]