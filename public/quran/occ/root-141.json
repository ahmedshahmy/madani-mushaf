[["2:196:15",30,"يَبْلُغَ","reaches","تَحْلِقُوا۟ رُءُوسَكُمْ حَتَّىٰ","ٱلْهَدْىُ مَحِلَّهُۥ ۚ فَمَن",288],["2:231:4",37,"فَبَلَغْنَ","and they reach","وَإِذَا طَلَّقْتُمُ ٱلنِّسَآءَ","أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ",288],["2:232:4",37,"فَبَلَغْنَ","and they reached","وَإِذَا طَلَّقْتُمُ ٱلنِّسَآءَ","أَجَلَهُنَّ فَلَا تَعْضُلُوهُنَّ",288],["2:234:12",38,"بَلَغْنَ","they reach","أَشْهُرٍۢ وَعَشْرًۭا ۖ فَإِذَا","أَجَلَهُنَّ فَلَا جُنَاحَ",288],["2:235:32",38,"يَبْلُغَ","reaches","عُقْدَةَ ٱلنِّكَاحِ حَتَّىٰ","ٱلْكِتَـٰبُ أَجَلَهُۥ ۚ وَٱعْلَمُوٓا۟",288],["3:20:23",52,"ٱلْبَلَـٰغُ ۗ","(is) to [the] convey","تَوَلَّوْا۟ فَإِنَّمَا عَلَيْكَ","وَٱللَّهُ بَصِيرٌۢ بِٱلْعِبَادِ",626],["3:40:8",55,"بَلَغَنِىَ","has reached me","لِى غُلَـٰمٌۭ وَقَدْ","ٱلْكِبَرُ وَٱمْرَأَتِى عَاقِرٌۭ ۖ",288],["4:6:5",77,"بَلَغُوا۟","they reach[ed]","ٱلْيَتَـٰمَىٰ حَتَّىٰٓ إِذَا","ٱلنِّكَاحَ فَإِنْ ءَانَسْتُم",288],["4:63:16",88,"بَلِيغًۭا","penetrating","فِىٓ أَنفُسِهِمْ قَوْلًۢا","",3339],["5:67:3",119,"بَلِّغْ","Convey","۞ يَـٰٓأَيُّهَا ٱلرَّسُولُ","مَآ أُنزِلَ إِلَيْكَ",1170],["5:67:13",119,"بَلَّغْتَ","you (have) conveyed","لَّمْ تَفْعَلْ فَمَا","رِسَالَتَهُۥ ۚ وَٱللَّهُ يَعْصِمُكَ",1170],["5:92:12",123,"ٱلْبَلَـٰغُ","(is to) convey (the Message)","أَنَّمَا عَلَىٰ رَسُولِنَا","ٱلْمُبِينُ",626],["5:95:25",123,"بَـٰلِغَ","reaching","عَدْلٍۢ مِّنكُمْ هَدْيًۢا","ٱلْكَعْبَةِ أَوْ كَفَّـٰرَةٌۭ",1168],["5:99:5",124,"ٱلْبَلَـٰغُ ۗ","the conveyance","عَلَى ٱلرَّسُولِ إِلَّا","وَٱللَّهُ يَعْلَمُ مَا",626],["6:19:18",130,"بَلَغَ ۚ","it reaches","لِأُنذِرَكُم بِهِۦ وَمَنۢ","أَئِنَّكُمْ لَتَشْهَدُونَ أَنَّ",288],["6:128:18",144,"وَبَلَغْنَآ","and we have reached","ٱسْتَمْتَعَ بَعْضُنَا بِبَعْضٍۢ","أَجَلَنَا ٱلَّذِىٓ أَجَّلْتَ",288],["6:149:4",148,"ٱلْبَـٰلِغَةُ ۖ","the conclusive","قُلْ فَلِلَّهِ ٱلْحُجَّةُ","فَلَوْ شَآءَ لَهَدَىٰكُمْ",1808],["6:152:10",149,"يَبْلُغَ","he reaches","هِىَ أَحْسَنُ حَتَّىٰ","أَشُدَّهُۥ ۖ وَأَوْفُوا۟ ٱلْكَيْلَ",288],["7:62:1",158,"أُبَلِّغُكُمْ","I convey to you","","رِسَـٰلَـٰتِ رَبِّى وَأَنصَحُ",1170],["7:68:1",159,"أُبَلِّغُكُمْ","I convey to you","","رِسَـٰلَـٰتِ رَبِّى وَأَنَا۠",1170],["7:79:6",160,"أَبْلَغْتُكُمْ","I have conveyed to you","وَقَالَ يَـٰقَوْمِ لَقَدْ","رِسَالَةَ رَبِّى وَنَصَحْتُ",1272],["7:93:6",162,"أَبْلَغْتُكُمْ","I (have) conveyed to you","وَقَالَ يَـٰقَوْمِ لَقَدْ","رِسَـٰلَـٰتِ رَبِّى وَنَصَحْتُ",1272],["7:135:8",166,"بَـٰلِغُوهُ","were to reach [it]","إِلَىٰٓ أَجَلٍ هُم","إِذَا هُمْ يَنكُثُونَ",1168],["9:6:12",187,"أَبْلِغْهُ","escort him","كَلَـٰمَ ٱللَّهِ ثُمَّ","مَأْمَنَهُۥ ۚ ذَٰلِكَ بِأَنَّهُمْ",1272],["11:57:4",228,"أَبْلَغْتُكُم","I have conveyed to you","فَإِن تَوَلَّوْا۟ فَقَدْ","مَّآ أُرْسِلْتُ بِهِۦٓ",1272],["12:22:2",237,"بَلَغَ","he reached","وَلَمَّا","أَشُدَّهُۥٓ ءَاتَيْنَـٰهُ حُكْمًۭا",288],["13:14:17",251,"لِيَبْلُغَ","to reach","كَفَّيْهِ إِلَى ٱلْمَآءِ","فَاهُ وَمَا هُوَ",288],["13:14:21",251,"بِبَـٰلِغِهِۦ ۚ","reaches it","فَاهُ وَمَا هُوَ","وَمَا دُعَآءُ ٱلْكَـٰفِرِينَ",1168],["13:40:11",254,"ٱلْبَلَـٰغُ","(is) the conveyance","نَتَوَفَّيَنَّكَ فَإِنَّمَا عَلَيْكَ","وَعَلَيْنَا ٱلْحِسَابُ",626],["14:52:2",261,"بَلَـٰغٌۭ","(is) a Message","هَـٰذَا","لِّلنَّاسِ وَلِيُنذَرُوا۟ بِهِۦ",626],["16:7:7",268,"بَـٰلِغِيهِ","reach it","بَلَدٍۢ لَّمْ تَكُونُوا۟","إِلَّا بِشِقِّ ٱلْأَنفُسِ ۚ",1168],["16:35:31",271,"ٱلْبَلَـٰغُ","the conveyance","عَلَى ٱلرُّسُلِ إِلَّا","ٱلْمُبِينُ",626],["16:82:5",276,"ٱلْبَلَـٰغُ","(is) the conveyance","تَوَلَّوْا۟ فَإِنَّمَا عَلَيْكَ","ٱلْمُبِينُ",626],["17:23:10",284,"يَبْلُغَنَّ","reach","وَبِٱلْوَٰلِدَيْنِ إِحْسَـٰنًا ۚ إِمَّا","عِندَكَ ٱلْكِبَرَ أَحَدُهُمَآ",288],["17:34:10",285,"يَبْلُغَ","he reaches","هِىَ أَحْسَنُ حَتَّىٰ","أَشُدَّهُۥ ۚ وَأَوْفُوا۟ بِٱلْعَهْدِ ۖ",288],["17:37:11",285,"تَبْلُغَ","reach","تَخْرِقَ ٱلْأَرْضَ وَلَن","ٱلْجِبَالَ طُولًۭا",288],["18:60:8",300,"أَبْلُغَ","I reach","لَآ أَبْرَحُ حَتَّىٰٓ","مَجْمَعَ ٱلْبَحْرَيْنِ أَوْ",288],["18:61:2",300,"بَلَغَا","they reached","فَلَمَّا","مَجْمَعَ بَيْنِهِمَا نَسِيَا",288],["18:76:10",302,"بَلَغْتَ","you have reached","فَلَا تُصَـٰحِبْنِى ۖ قَدْ","مِن لَّدُنِّى عُذْرًۭا",288],["18:82:18",302,"يَبْلُغَآ","they reach","فَأَرَادَ رَبُّكَ أَن","أَشُدَّهُمَا وَيَسْتَخْرِجَا كَنزَهُمَا",288],["18:86:3",303,"بَلَغَ","he reached","حَتَّىٰٓ إِذَا","مَغْرِبَ ٱلشَّمْسِ وَجَدَهَا",288],["18:90:3",303,"بَلَغَ","he reached","حَتَّىٰٓ إِذَا","مَطْلِعَ ٱلشَّمْسِ وَجَدَهَا",288],["18:93:3",303,"بَلَغَ","he reached","حَتَّىٰٓ إِذَا","بَيْنَ ٱلسَّدَّيْنِ وَجَدَ",288],["19:8:11",305,"بَلَغْتُ","I have reached","ٱمْرَأَتِى عَاقِرًۭا وَقَدْ","مِنَ ٱلْكِبَرِ عِتِيًّۭا",288],["21:106:4",331,"لَبَلَـٰغًۭا","surely is a Message","إِنَّ فِى هَـٰذَا","لِّقَوْمٍ عَـٰبِدِينَ",626],["22:5:39",332,"لِتَبْلُغُوٓا۟","that you may reach","نُخْرِجُكُمْ طِفْلًۭا ثُمَّ","أَشُدَّكُمْ ۖ وَمِنكُم مَّن",288],["24:54:22",357,"ٱلْبَلَـٰغُ","the conveyance","عَلَى ٱلرَّسُولِ إِلَّا","ٱلْمُبِينُ",626],["24:58:10",357,"يَبْلُغُوا۟","reached","أَيْمَـٰنُكُمْ وَٱلَّذِينَ لَمْ","ٱلْحُلُمَ مِنكُمْ ثَلَـٰثَ",288],["24:59:2",358,"بَلَغَ","reach","وَإِذَا","ٱلْأَطْفَـٰلُ مِنكُمُ ٱلْحُلُمَ",288],["28:14:2",387,"بَلَغَ","he reached","وَلَمَّا","أَشُدَّهُۥ وَٱسْتَوَىٰٓ ءَاتَيْنَـٰهُ",288],["29:18:12",398,"ٱلْبَلَـٰغُ","the conveyance","عَلَى ٱلرَّسُولِ إِلَّا","ٱلْمُبِينُ",626],["33:10:11",419,"وَبَلَغَتِ","and reached","وَإِذْ زَاغَتِ ٱلْأَبْصَـٰرُ","ٱلْقُلُوبُ ٱلْحَنَاجِرَ وَتَظُنُّونَ",288],["33:39:2",423,"يُبَلِّغُونَ","convey","ٱلَّذِينَ","رِسَـٰلَـٰتِ ٱللَّهِ وَيَخْشَوْنَهُۥ",1170],["34:45:6",433,"بَلَغُوا۟","they have attained","مِن قَبْلِهِمْ وَمَا","مِعْشَارَ مَآ ءَاتَيْنَـٰهُمْ",288],["36:17:4",441,"ٱلْبَلَـٰغُ","the conveyance","وَمَا عَلَيْنَآ إِلَّا","ٱلْمُبِينُ",626],["37:102:2",449,"بَلَغَ","he reached","فَلَمَّا","مَعَهُ ٱلسَّعْىَ قَالَ",288],["40:36:8",471,"أَبْلُغُ","reach","لِى صَرْحًۭا لَّعَلِّىٓ","ٱلْأَسْبَـٰبَ",288],["40:56:17",473,"بِبَـٰلِغِيهِ ۚ","(can) reach it","كِبْرٌۭ مَّا هُم","فَٱسْتَعِذْ بِٱللَّهِ ۖ إِنَّهُۥ",1168],["40:67:16",475,"لِتَبْلُغُوٓا۟","lets you reach","يُخْرِجُكُمْ طِفْلًۭا ثُمَّ","أَشُدَّكُمْ ثُمَّ لِتَكُونُوا۟",288],["40:67:26",475,"وَلِتَبْلُغُوٓا۟","and lets you reach","يُتَوَفَّىٰ مِن قَبْلُ ۖ","أَجَلًۭا مُّسَمًّۭى وَلَعَلَّكُمْ",288],["40:80:4",476,"وَلِتَبْلُغُوا۟","and that you may reach","وَلَكُمْ فِيهَا مَنَـٰفِعُ","عَلَيْهَا حَاجَةًۭ فِى",288],["42:48:10",488,"ٱلْبَلَـٰغُ ۗ","the conveyance","إِنْ عَلَيْكَ إِلَّا","وَإِنَّآ إِذَآ أَذَقْنَا",626],["46:15:16",504,"بَلَغَ","he reaches","شَهْرًا ۚ حَتَّىٰٓ إِذَا","أَشُدَّهُۥ وَبَلَغَ أَرْبَعِينَ",288],["46:15:18",504,"وَبَلَغَ","and reaches","إِذَا بَلَغَ أَشُدَّهُۥ","أَرْبَعِينَ سَنَةًۭ قَالَ",288],["46:23:6",505,"وَأُبَلِّغُكُم","and I convey to you","ٱلْعِلْمُ عِندَ ٱللَّهِ","مَّآ أُرْسِلْتُ بِهِۦ",1170],["46:35:22",506,"بَلَـٰغٌۭ ۚ","A notification","سَاعَةًۭ مِّن نَّهَارٍۭ ۚ","فَهَلْ يُهْلَكُ إِلَّا",626],["48:25:11",514,"يَبْلُغَ","reaching","وَٱلْهَدْىَ مَعْكُوفًا أَن","مَحِلَّهُۥ ۚ وَلَوْلَا رِجَالٌۭ",288],["53:30:2",527,"مَبْلَغُهُم","(is) their sum","ذَٰلِكَ","مِّنَ ٱلْعِلْمِ ۚ إِنَّ",3653],["54:5:2",528,"بَـٰلِغَةٌۭ ۖ","perfect","حِكْمَةٌۢ","فَمَا تُغْنِ ٱلنُّذُرُ",1808],["56:83:3",537,"بَلَغَتِ","it reaches","فَلَوْلَآ إِذَا","ٱلْحُلْقُومَ",288],["64:12:10",557,"ٱلْبَلَـٰغُ","(is) the conveyance","فَإِنَّمَا عَلَىٰ رَسُولِنَا","ٱلْمُبِينُ",626],["65:2:2",558,"بَلَغْنَ","they have reached","فَإِذَا","أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ",288],["65:3:14",558,"بَـٰلِغُ","(will) accomplish","حَسْبُهُۥٓ ۚ إِنَّ ٱللَّهَ","أَمْرِهِۦ ۚ قَدْ جَعَلَ",1168],["68:39:5",565,"بَـٰلِغَةٌ","reaching","لَكُمْ أَيْمَـٰنٌ عَلَيْنَا","إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ ۙ",1808],["72:23:2",573,"بَلَـٰغًۭا","(the) notification","إِلَّا","مِّنَ ٱللَّهِ وَرِسَـٰلَـٰتِهِۦ ۚ",626],["72:28:4",573,"أَبْلَغُوا۟","they have conveyed","لِّيَعْلَمَ أَن قَدْ","رِسَـٰلَـٰتِ رَبِّهِمْ وَأَحَاطَ",1272],["75:26:3",578,"بَلَغَتِ","it reaches","كَلَّآ إِذَا","ٱلتَّرَاقِىَ",288]]