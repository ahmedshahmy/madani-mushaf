[["17:64:5",288,"بِصَوْتِكَ","with your voice","مَنِ ٱسْتَطَعْتَ مِنْهُم","وَأَجْلِبْ عَلَيْهِم بِخَيْلِكَ",963],["20:108:8",319,"ٱلْأَصْوَاتُ","the voices","عِوَجَ لَهُۥ ۖ وَخَشَعَتِ","لِلرَّحْمَـٰنِ فَلَا تَسْمَعُ",963],["31:19:6",412,"صَوْتِكَ ۚ","your voice","مَشْيِكَ وَٱغْضُضْ مِن","إِنَّ أَنكَرَ ٱلْأَصْوَٰتِ",963],["31:19:9",412,"ٱلْأَصْوَٰتِ","(of all) sounds","صَوْتِكَ ۚ إِنَّ أَنكَرَ","لَصَوْتُ ٱلْحَمِيرِ",963],["31:19:10",412,"لَصَوْتُ","(is) surely (the) voice","إِنَّ أَنكَرَ ٱلْأَصْوَٰتِ","ٱلْحَمِيرِ",963],["49:2:6",515,"أَصْوَٰتَكُمْ","your voices","ءَامَنُوا۟ لَا تَرْفَعُوٓا۟","فَوْقَ صَوْتِ ٱلنَّبِىِّ",963],["49:2:8",515,"صَوْتِ","(the) voice","تَرْفَعُوٓا۟ أَصْوَٰتَكُمْ فَوْقَ","ٱلنَّبِىِّ وَلَا تَجْهَرُوا۟",963],["49:3:4",515,"أَصْوَٰتَهُمْ","their voices","إِنَّ ٱلَّذِينَ يَغُضُّونَ","عِندَ رَسُولِ ٱللَّهِ",963]]