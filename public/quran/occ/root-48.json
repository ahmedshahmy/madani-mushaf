[["2:58:20",9,"ٱلْمُحْسِنِينَ","the good-doers (in reward)","لَكُمْ خَطَـٰيَـٰكُمْ ۚ وَسَنَزِيدُ","",308],["2:83:11",12,"إِحْسَانًۭا","(be) good","إِلَّا ٱللَّهَ وَبِٱلْوَٰلِدَيْنِ","وَذِى ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ",706],["2:83:18",12,"حُسْنًۭا","good","وَٱلْمَسَـٰكِينِ وَقُولُوا۟ لِلنَّاسِ","وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟",682],["2:112:7",17,"مُحْسِنٌۭ","(is) a good-doer","وَجْهَهُۥ لِلَّهِ وَهُوَ","فَلَهُۥٓ أَجْرُهُۥ عِندَ",308],["2:138:4",21,"أَحْسَنُ","(is) better","صِبْغَةَ ٱللَّهِ ۖ وَمَنْ","مِنَ ٱللَّهِ صِبْغَةًۭ ۖ",323],["2:178:25",27,"بِإِحْسَـٰنٍۢ ۗ","with kindness","بِٱلْمَعْرُوفِ وَأَدَآءٌ إِلَيْهِ","ذَٰلِكَ تَخْفِيفٌۭ مِّن",706],["2:195:10",30,"وَأَحْسِنُوٓا۟ ۛ","And do good","بِأَيْدِيكُمْ إِلَى ٱلتَّهْلُكَةِ ۛ","إِنَّ ٱللَّهَ يُحِبُّ",484],["2:195:14",30,"ٱلْمُحْسِنِينَ","the good-doers","إِنَّ ٱللَّهَ يُحِبُّ","",308],["2:201:8",31,"حَسَنَةًۭ","good","ءَاتِنَا فِى ٱلدُّنْيَا","وَفِى ٱلْـَٔاخِرَةِ حَسَنَةًۭ",386],["2:201:11",31,"حَسَنَةًۭ","good","حَسَنَةًۭ وَفِى ٱلْـَٔاخِرَةِ","وَقِنَا عَذَابَ ٱلنَّارِ",386],["2:229:7",36,"بِإِحْسَـٰنٍۢ ۗ","with kindness","بِمَعْرُوفٍ أَوْ تَسْرِيحٌۢ","وَلَا يَحِلُّ لَكُمْ",706],["2:236:25",38,"ٱلْمُحْسِنِينَ","the good-doers","بِٱلْمَعْرُوفِ ۖ حَقًّا عَلَى","",308],["2:245:7",39,"حَسَنًۭا","good","يُقْرِضُ ٱللَّهَ قَرْضًا","فَيُضَـٰعِفَهُۥ لَهُۥٓ أَضْعَافًۭا",486],["3:14:23",51,"حُسْنُ","(is an) excellent","ٱلدُّنْيَا ۖ وَٱللَّهُ عِندَهُۥ","ٱلْمَـَٔابِ",682],["3:37:4",54,"حَسَنٍۢ","good","فَتَقَبَّلَهَا رَبُّهَا بِقَبُولٍ","وَأَنۢبَتَهَا نَبَاتًا حَسَنًۭا",486],["3:37:7",54,"حَسَنًۭا","good","حَسَنٍۢ وَأَنۢبَتَهَا نَبَاتًا","وَكَفَّلَهَا زَكَرِيَّا ۖ كُلَّمَا",486],["3:120:3",65,"حَسَنَةٌۭ","a good","إِن تَمْسَسْكُمْ","تَسُؤْهُمْ وَإِن تُصِبْكُمْ",386],["3:134:13",67,"ٱلْمُحْسِنِينَ","the good-doers","ٱلنَّاسِ ۗ وَٱللَّهُ يُحِبُّ","",308],["3:148:5",68,"وَحُسْنَ","and good","ٱللَّهُ ثَوَابَ ٱلدُّنْيَا","ثَوَابِ ٱلْـَٔاخِرَةِ ۗ وَٱللَّهُ",682],["3:148:10",68,"ٱلْمُحْسِنِينَ","the good-doers","ٱلْـَٔاخِرَةِ ۗ وَٱللَّهُ يُحِبُّ","",308],["3:172:11",72,"أَحْسَنُوا۟","did good","أَصَابَهُمُ ٱلْقَرْحُ ۚ لِلَّذِينَ","مِنْهُمْ وَٱتَّقَوْا۟ أَجْرٌ",484],["3:195:42",76,"حُسْنُ","(is the) best","ٱللَّهِ ۗ وَٱللَّهُ عِندَهُۥ","ٱلثَّوَابِ",682],["4:36:8",84,"إِحْسَـٰنًۭا","(do) good","بِهِۦ شَيْـًۭٔا ۖ وَبِٱلْوَٰلِدَيْنِ","وَبِذِى ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ",706],["4:40:9",85,"حَسَنَةًۭ","a good","ذَرَّةٍۢ ۖ وَإِن تَكُ","يُضَـٰعِفْهَا وَيُؤْتِ مِن",386],["4:59:27",87,"وَأَحْسَنُ","and more suitable","ٱلْـَٔاخِرِ ۚ ذَٰلِكَ خَيْرٌۭ","تَأْوِيلًا",323],["4:62:15",88,"إِحْسَـٰنًۭا","good","إِنْ أَرَدْنَآ إِلَّآ","وَتَوْفِيقًا",706],["4:69:16",89,"وَحَسُنَ","And excellent","وَٱلصِّدِّيقِينَ وَٱلشُّهَدَآءِ وَٱلصَّـٰلِحِينَ ۚ","أُو۟لَـٰٓئِكَ رَفِيقًۭا",1785],["4:78:12",90,"حَسَنَةٌۭ","any good","مُّشَيَّدَةٍۢ ۗ وَإِن تُصِبْهُمْ","يَقُولُوا۟ هَـٰذِهِۦ مِنْ",386],["4:79:4",90,"حَسَنَةٍۢ","(the) good","مَّآ أَصَابَكَ مِنْ","فَمِنَ ٱللَّهِ ۖ وَمَآ",386],["4:85:4",91,"حَسَنَةًۭ","good","مَّن يَشْفَعْ شَفَـٰعَةً","يَكُن لَّهُۥ نَصِيبٌۭ",386],["4:86:5",91,"بِأَحْسَنَ","with better","حُيِّيتُم بِتَحِيَّةٍۢ فَحَيُّوا۟","مِنْهَآ أَوْ رُدُّوهَآ ۗ",323],["4:95:26",94,"ٱلْحُسْنَىٰ ۚ","the best","وَكُلًّۭا وَعَدَ ٱللَّهُ","وَفَضَّلَ ٱللَّهُ ٱلْمُجَـٰهِدِينَ",568],["4:125:2",98,"أَحْسَنُ","(is) better","وَمَنْ","دِينًۭا مِّمَّنْ أَسْلَمَ",323],["4:125:9",98,"مُحْسِنٌۭ","(is) a good-doer","وَجْهَهُۥ لِلَّهِ وَهُوَ","وَٱتَّبَعَ مِلَّةَ إِبْرَٰهِيمَ",308],["4:128:22",99,"تُحْسِنُوا۟","you do good","ٱلْأَنفُسُ ٱلشُّحَّ ۚ وَإِن","وَتَتَّقُوا۟ فَإِنَّ ٱللَّهَ",484],["5:12:27",109,"حَسَنًۭا","goodly","وَأَقْرَضْتُمُ ٱللَّهَ قَرْضًا","لَّأُكَفِّرَنَّ عَنكُمْ سَيِّـَٔاتِكُمْ",486],["5:13:32",109,"ٱلْمُحْسِنِينَ","the good-doers","إِنَّ ٱللَّهَ يُحِبُّ","",308],["5:50:5",116,"أَحْسَنُ","better","ٱلْجَـٰهِلِيَّةِ يَبْغُونَ ۚ وَمَنْ","مِنَ ٱللَّهِ حُكْمًۭا",323],["5:85:14",122,"ٱلْمُحْسِنِينَ","(of) the good-doers","فِيهَا ۚ وَذَٰلِكَ جَزَآءُ","",308],["5:93:21",123,"وَّأَحْسَنُوا۟ ۗ","and do good","وَّءَامَنُوا۟ ثُمَّ ٱتَّقَوا۟","وَٱللَّهُ يُحِبُّ ٱلْمُحْسِنِينَ",484],["5:93:24",123,"ٱلْمُحْسِنِينَ","the good-doers","وَّأَحْسَنُوا۟ ۗ وَٱللَّهُ يُحِبُّ","",308],["6:84:21",138,"ٱلْمُحْسِنِينَ","the good-doers","وَهَـٰرُونَ ۚ وَكَذَٰلِكَ نَجْزِى","",308],["6:151:13",148,"إِحْسَـٰنًۭا ۖ","(be) good","بِهِۦ شَيْـًۭٔا ۖ وَبِٱلْوَٰلِدَيْنِ","وَلَا تَقْتُلُوٓا۟ أَوْلَـٰدَكُم",706],["6:152:8",149,"أَحْسَنُ","(is) best","إِلَّا بِٱلَّتِى هِىَ","حَتَّىٰ يَبْلُغَ أَشُدَّهُۥ ۖ",323],["6:154:8",149,"أَحْسَنَ","did good","تَمَامًا عَلَى ٱلَّذِىٓ","وَتَفْصِيلًۭا لِّكُلِّ شَىْءٍۢ",484],["6:160:3",150,"بِٱلْحَسَنَةِ","with a good deed","مَن جَآءَ","فَلَهُۥ عَشْرُ أَمْثَالِهَا ۖ",386],["7:56:15",157,"ٱلْمُحْسِنِينَ","the good-doers","ٱللَّهِ قَرِيبٌۭ مِّنَ","",308],["7:95:5",162,"ٱلْحَسَنَةَ","the good","بَدَّلْنَا مَكَانَ ٱلسَّيِّئَةِ","حَتَّىٰ عَفَوا۟ وَّقَالُوا۟",386],["7:131:3",166,"ٱلْحَسَنَةُ","the good","فَإِذَا جَآءَتْهُمُ","قَالُوا۟ لَنَا هَـٰذِهِۦ ۖ",386],["7:137:15",166,"ٱلْحُسْنَىٰ","the best","وَتَمَّتْ كَلِمَتُ رَبِّكَ","عَلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ",568],["7:145:17",168,"بِأَحْسَنِهَا ۚ","(the) best of it","وَأْمُرْ قَوْمَكَ يَأْخُذُوا۟","سَأُو۟رِيكُمْ دَارَ ٱلْفَـٰسِقِينَ",323],["7:156:6",170,"حَسَنَةًۭ","good","فِى هَـٰذِهِ ٱلدُّنْيَا","وَفِى ٱلْـَٔاخِرَةِ إِنَّا",386],["7:161:20",171,"ٱلْمُحْسِنِينَ","(of) the good-doers","لَكُمْ خَطِيٓـَٔـٰتِكُمْ ۚ سَنَزِيدُ","",308],["7:168:11",172,"بِٱلْحَسَنَـٰتِ","with the good","دُونَ ذَٰلِكَ ۖ وَبَلَوْنَـٰهُم","وَٱلسَّيِّـَٔاتِ لَعَلَّهُمْ يَرْجِعُونَ",1784],["7:180:3",174,"ٱلْحُسْنَىٰ","the most beautiful","وَلِلَّهِ ٱلْأَسْمَآءُ","فَٱدْعُوهُ بِهَا ۖ وَذَرُوا۟",568],["8:17:17",179,"حَسَنًا ۚ","good","ٱلْمُؤْمِنِينَ مِنْهُ بَلَآءً","إِنَّ ٱللَّهَ سَمِيعٌ",486],["9:50:3",195,"حَسَنَةٌۭ","good","إِن تُصِبْكَ","تَسُؤْهُمْ ۖ وَإِن تُصِبْكَ",386],["9:52:7",195,"ٱلْحُسْنَيَيْنِ ۖ","(of) the two best (things)","بِنَآ إِلَّآ إِحْدَى","وَنَحْنُ نَتَرَبَّصُ بِكُمْ",3226],["9:91:21",201,"ٱلْمُحْسِنِينَ","the good-doers","وَرَسُولِهِۦ ۚ مَا عَلَى","مِن سَبِيلٍۢ ۚ وَٱللَّهُ",308],["9:100:8",203,"بِإِحْسَـٰنٍۢ","in righteousness","وَٱلْأَنصَارِ وَٱلَّذِينَ ٱتَّبَعُوهُم","رَّضِىَ ٱللَّهُ عَنْهُمْ",706],["9:107:20",204,"ٱلْحُسْنَىٰ ۖ","the good","إِنْ أَرَدْنَآ إِلَّا","وَٱللَّهُ يَشْهَدُ إِنَّهُمْ",568],["9:120:52",206,"ٱلْمُحْسِنِينَ","(of) the good-doers","لَا يُضِيعُ أَجْرَ","",308],["9:121:15",206,"أَحْسَنَ","the best","لَهُمْ لِيَجْزِيَهُمُ ٱللَّهُ","مَا كَانُوا۟ يَعْمَلُونَ",323],["10:26:2",212,"أَحْسَنُوا۟","do good","۞ لِّلَّذِينَ","ٱلْحُسْنَىٰ وَزِيَادَةٌۭ ۖ وَلَا",484],["10:26:3",212,"ٱلْحُسْنَىٰ","(is) the best","۞ لِّلَّذِينَ أَحْسَنُوا۟","وَزِيَادَةٌۭ ۖ وَلَا يَرْهَقُ",568],["11:3:9",221,"حَسَنًا","a good","إِلَيْهِ يُمَتِّعْكُم مَّتَـٰعًا","إِلَىٰٓ أَجَلٍۢ مُّسَمًّۭى",486],["11:7:15",222,"أَحْسَنُ","(is) best","ٱلْمَآءِ لِيَبْلُوَكُمْ أَيُّكُمْ","عَمَلًۭا ۗ وَلَئِن قُلْتَ",323],["11:88:13",231,"حَسَنًۭا ۚ","a good provision","وَرَزَقَنِى مِنْهُ رِزْقًا","وَمَآ أُرِيدُ أَنْ",486],["11:114:9",234,"ٱلْحَسَنَـٰتِ","the good deeds","مِّنَ ٱلَّيْلِ ۚ إِنَّ","يُذْهِبْنَ ٱلسَّيِّـَٔاتِ ۚ ذَٰلِكَ",1784],["11:115:7",234,"ٱلْمُحْسِنِينَ","(of) the good-doers","لَا يُضِيعُ أَجْرَ","",308],["12:3:4",235,"أَحْسَنَ","the best","نَحْنُ نَقُصُّ عَلَيْكَ","ٱلْقَصَصِ بِمَآ أَوْحَيْنَآ",323],["12:22:9",237,"ٱلْمُحْسِنِينَ","the good-doers","وَعِلْمًۭا ۚ وَكَذَٰلِكَ نَجْزِى","",308],["12:23:18",238,"أَحْسَنَ","(who has) made good","ٱللَّهِ ۖ إِنَّهُۥ رَبِّىٓ","مَثْوَاىَ ۖ إِنَّهُۥ لَا",484],["12:36:27",239,"ٱلْمُحْسِنِينَ","the good-doers","إِنَّا نَرَىٰكَ مِنَ","",308],["12:56:17",242,"ٱلْمُحْسِنِينَ","(of) the good-doers","وَلَا نُضِيعُ أَجْرَ","",308],["12:78:15",244,"ٱلْمُحْسِنِينَ","the good-doers","إِنَّا نَرَىٰكَ مِنَ","",308],["12:90:23",246,"ٱلْمُحْسِنِينَ","(of) the good-doers","لَا يُضِيعُ أَجْرَ","",308],["12:100:20",247,"أَحْسَنَ","He was good","رَبِّى حَقًّۭا ۖ وَقَدْ","بِىٓ إِذْ أَخْرَجَنِى",484],["13:6:4",250,"ٱلْحَسَنَةِ","the good","وَيَسْتَعْجِلُونَكَ بِٱلسَّيِّئَةِ قَبْلَ","وَقَدْ خَلَتْ مِن",386],["13:18:4",251,"ٱلْحُسْنَىٰ ۚ","(is) the bliss","لِلَّذِينَ ٱسْتَجَابُوا۟ لِرَبِّهِمُ","وَٱلَّذِينَ لَمْ يَسْتَجِيبُوا۟",568],["13:22:14",252,"بِٱلْحَسَنَةِ","with the good","سِرًّۭا وَعَلَانِيَةًۭ وَيَدْرَءُونَ","ٱلسَّيِّئَةَ أُو۟لَـٰٓئِكَ لَهُمْ",386],["13:29:7",253,"وَحُسْنُ","and a beautiful","ٱلصَّـٰلِحَـٰتِ طُوبَىٰ لَهُمْ","مَـَٔابٍۢ",682],["16:30:10",270,"أَحْسَنُوا۟","do good","قَالُوا۟ خَيْرًۭا ۗ لِّلَّذِينَ","فِى هَـٰذِهِ ٱلدُّنْيَا",484],["16:30:14",270,"حَسَنَةٌۭ ۚ","(is) a good","فِى هَـٰذِهِ ٱلدُّنْيَا","وَلَدَارُ ٱلْـَٔاخِرَةِ خَيْرٌۭ ۚ",386],["16:41:12",271,"حَسَنَةًۭ ۖ","good","لَنُبَوِّئَنَّهُمْ فِى ٱلدُّنْيَا","وَلَأَجْرُ ٱلْـَٔاخِرَةِ أَكْبَرُ ۚ",386],["16:62:10",273,"ٱلْحُسْنَىٰ ۖ","(is) the best","ٱلْكَذِبَ أَنَّ لَهُمُ","لَا جَرَمَ أَنَّ",568],["16:67:9",274,"حَسَنًا ۗ","good","مِنْهُ سَكَرًۭا وَرِزْقًا","إِنَّ فِى ذَٰلِكَ",486],["16:75:14",275,"حَسَنًۭا","good","رَّزَقْنَـٰهُ مِنَّا رِزْقًا","فَهُوَ يُنفِقُ مِنْهُ",486],["16:90:5",277,"وَٱلْإِحْسَـٰنِ","and the good","ٱللَّهَ يَأْمُرُ بِٱلْعَدْلِ","وَإِيتَآئِ ذِى ٱلْقُرْبَىٰ",706],["16:96:12",278,"بِأَحْسَنِ","to (the) best","ٱلَّذِينَ صَبَرُوٓا۟ أَجْرَهُم","مَا كَانُوا۟ يَعْمَلُونَ",323],["16:97:15",278,"بِأَحْسَنِ","to (the) best","طَيِّبَةًۭ ۖ وَلَنَجْزِيَنَّهُمْ أَجْرَهُم","مَا كَانُوا۟ يَعْمَلُونَ",323],["16:122:4",281,"حَسَنَةًۭ ۖ","good","وَءَاتَيْنَـٰهُ فِى ٱلدُّنْيَا","وَإِنَّهُۥ فِى ٱلْـَٔاخِرَةِ",386],["16:125:7",281,"ٱلْحَسَنَةِ ۖ","the good","رَبِّكَ بِٱلْحِكْمَةِ وَٱلْمَوْعِظَةِ","وَجَـٰدِلْهُم بِٱلَّتِى هِىَ",386],["16:125:11",281,"أَحْسَنُ ۚ","(is) best","وَجَـٰدِلْهُم بِٱلَّتِى هِىَ","إِنَّ رَبَّكَ هُوَ",323],["16:128:8",281,"مُّحْسِنُونَ","(are) good-doers","ٱتَّقَوا۟ وَّٱلَّذِينَ هُم","",308],["17:7:2",282,"أَحْسَنتُمْ","you do good","إِنْ","أَحْسَنتُمْ لِأَنفُسِكُمْ ۖ وَإِنْ",484],["17:7:3",282,"أَحْسَنتُمْ","you do good","إِنْ أَحْسَنتُمْ","لِأَنفُسِكُمْ ۖ وَإِنْ أَسَأْتُمْ",484],["17:23:8",284,"إِحْسَـٰنًا ۚ","(be) good","إِلَّآ إِيَّاهُ وَبِٱلْوَٰلِدَيْنِ","إِمَّا يَبْلُغَنَّ عِندَكَ",706],["17:34:8",285,"أَحْسَنُ","best","إِلَّا بِٱلَّتِى هِىَ","حَتَّىٰ يَبْلُغَ أَشُدَّهُۥ ۚ",323],["17:35:10",285,"وَأَحْسَنُ","and best","ٱلْمُسْتَقِيمِ ۚ ذَٰلِكَ خَيْرٌۭ","تَأْوِيلًۭا",323],["17:53:6",287,"أَحْسَنُ ۚ","(is) best","يَقُولُوا۟ ٱلَّتِى هِىَ","إِنَّ ٱلشَّيْطَـٰنَ يَنزَغُ",323],["17:110:12",293,"ٱلْحُسْنَىٰ ۚ","the Most Beautiful Names","تَدْعُوا۟ فَلَهُ ٱلْأَسْمَآءُ","وَلَا تَجْهَرْ بِصَلَاتِكَ",568],["18:2:15",293,"حَسَنًۭا","(is) a good reward","أَنَّ لَهُمْ أَجْرًا","",486],["18:7:10",294,"أَحْسَنُ","(is) best","لَّهَا لِنَبْلُوَهُمْ أَيُّهُمْ","عَمَلًۭا",323],["18:30:11",297,"أَحْسَنَ","does good","نُضِيعُ أَجْرَ مَنْ","عَمَلًا",484],["18:31:27",297,"وَحَسُنَتْ","and good","ٱلْأَرَآئِكِ ۚ نِعْمَ ٱلثَّوَابُ","مُرْتَفَقًۭا",1785],["18:86:24",303,"حُسْنًۭا","(with) goodness","أَن تَتَّخِذَ فِيهِمْ","",682],["18:88:8",303,"ٱلْحُسْنَىٰ ۖ","good","صَـٰلِحًۭا فَلَهُۥ جَزَآءً","وَسَنَقُولُ لَهُۥ مِنْ",568],["18:104:10",304,"يُحْسِنُونَ","(were) acquiring good","وَهُمْ يَحْسَبُونَ أَنَّهُمْ","صُنْعًا",484],["19:73:15",310,"وَأَحْسَنُ","and best","ٱلْفَرِيقَيْنِ خَيْرٌۭ مَّقَامًۭا","نَدِيًّۭا",323],["19:74:7",310,"أَحْسَنُ","(were) better","مِّن قَرْنٍ هُمْ","أَثَـٰثًۭا وَرِءْيًۭا",323],["20:8:8",312,"ٱلْحُسْنَىٰ","the Most Beautiful","هُوَ ۖ لَهُ ٱلْأَسْمَآءُ","",568],["20:86:13",317,"حَسَنًا ۚ","good","يَعِدْكُمْ رَبُّكُمْ وَعْدًا","أَفَطَالَ عَلَيْكُمُ ٱلْعَهْدُ",486],["21:101:6",330,"ٱلْحُسْنَىٰٓ","the good","سَبَقَتْ لَهُم مِّنَّا","أُو۟لَـٰٓئِكَ عَنْهَا مُبْعَدُونَ",568],["22:37:20",336,"ٱلْمُحْسِنِينَ","(to) the good-doers","مَا هَدَىٰكُمْ ۗ وَبَشِّرِ","",308],["22:58:13",339,"حَسَنًۭا ۚ","good","لَيَرْزُقَنَّهُمُ ٱللَّهُ رِزْقًا","وَإِنَّ ٱللَّهَ لَهُوَ",486],["23:14:20",342,"أَحْسَنُ","(the) Best","ءَاخَرَ ۚ فَتَبَارَكَ ٱللَّهُ","ٱلْخَـٰلِقِينَ",323],["23:96:4",348,"أَحْسَنُ","(is) best","ٱدْفَعْ بِٱلَّتِى هِىَ","ٱلسَّيِّئَةَ ۚ نَحْنُ أَعْلَمُ",323],["24:38:3",355,"أَحْسَنَ","(with the) best","لِيَجْزِيَهُمُ ٱللَّهُ","مَا عَمِلُوا۟ وَيَزِيدَهُم",323],["25:24:6",362,"وَأَحْسَنُ","and a better","يَوْمَئِذٍ خَيْرٌۭ مُّسْتَقَرًّۭا","مَقِيلًۭا",323],["25:33:7",363,"وَأَحْسَنَ","and (the) best","إِلَّا جِئْنَـٰكَ بِٱلْحَقِّ","تَفْسِيرًا",323],["25:70:12",366,"حَسَنَـٰتٍۢ ۗ","(with) good ones","يُبَدِّلُ ٱللَّهُ سَيِّـَٔاتِهِمْ","وَكَانَ ٱللَّهُ غَفُورًۭا",1784],["25:76:3",366,"حَسُنَتْ","Good","خَـٰلِدِينَ فِيهَا ۚ","مُسْتَقَرًّۭا وَمُقَامًۭا",1785],["27:11:6",377,"حُسْنًۢا","good","ظَلَمَ ثُمَّ بَدَّلَ","بَعْدَ سُوٓءٍۢ فَإِنِّى",682],["27:46:7",381,"ٱلْحَسَنَةِ ۖ","the good","تَسْتَعْجِلُونَ بِٱلسَّيِّئَةِ قَبْلَ","لَوْلَا تَسْتَغْفِرُونَ ٱللَّهَ",386],["27:89:3",385,"بِٱلْحَسَنَةِ","with the good","مَن جَآءَ","فَلَهُۥ خَيْرٌۭ مِّنْهَا",386],["28:14:10",387,"ٱلْمُحْسِنِينَ","the good-doers","وَعِلْمًۭا ۚ وَكَذَٰلِكَ نَجْزِى","",308],["28:54:8",392,"بِٱلْحَسَنَةِ","with good","بِمَا صَبَرُوا۟ وَيَدْرَءُونَ","ٱلسَّيِّئَةَ وَمِمَّا رَزَقْنَـٰهُمْ",386],["28:61:4",393,"حَسَنًۭا","good","أَفَمَن وَعَدْنَـٰهُ وَعْدًا","فَهُوَ لَـٰقِيهِ كَمَن",486],["28:77:12",394,"وَأَحْسِن","And do good","نَصِيبَكَ مِنَ ٱلدُّنْيَا ۖ","كَمَآ أَحْسَنَ ٱللَّهُ",484],["28:77:14",394,"أَحْسَنَ","Allah has been good","ٱلدُّنْيَا ۖ وَأَحْسِن كَمَآ","ٱللَّهُ إِلَيْكَ ۖ وَلَا",484],["28:84:3",395,"بِٱلْحَسَنَةِ","with a good (deed)","مَن جَآءَ","فَلَهُۥ خَيْرٌۭ مِّنْهَا ۖ",386],["29:7:9",397,"أَحْسَنَ","(the) best","عَنْهُمْ سَيِّـَٔاتِهِمْ وَلَنَجْزِيَنَّهُمْ","ٱلَّذِى كَانُوا۟ يَعْمَلُونَ",323],["29:8:4",397,"حُسْنًۭا ۖ","goodness to his parents","وَوَصَّيْنَا ٱلْإِنسَـٰنَ بِوَٰلِدَيْهِ","وَإِن جَـٰهَدَاكَ لِتُشْرِكَ",682],["29:46:8",402,"أَحْسَنُ","(is) best","إِلَّا بِٱلَّتِى هِىَ","إِلَّا ٱلَّذِينَ ظَلَمُوا۟",323],["29:69:9",404,"ٱلْمُحْسِنِينَ","the good-doers","وَإِنَّ ٱللَّهَ لَمَعَ","",308],["31:3:3",411,"لِّلْمُحْسِنِينَ","for the good-doers","هُدًۭى وَرَحْمَةًۭ","",308],["31:22:7",413,"مُحْسِنٌۭ","(is) a good-doer","إِلَى ٱللَّهِ وَهُوَ","فَقَدِ ٱسْتَمْسَكَ بِٱلْعُرْوَةِ",308],["32:7:2",415,"أَحْسَنَ","made good","ٱلَّذِىٓ","كُلَّ شَىْءٍ خَلَقَهُۥ ۖ",484],["33:21:8",420,"حَسَنَةٌۭ","an excellent example","رَسُولِ ٱللَّهِ أُسْوَةٌ","لِّمَن كَانَ يَرْجُوا۟",386],["33:29:11",421,"لِلْمُحْسِنَـٰتِ","for the good-doers","فَإِنَّ ٱللَّهَ أَعَدَّ","مِنكُنَّ أَجْرًا عَظِيمًۭا",3770],["33:52:15",425,"حُسْنُهُنَّ","their beauty","أَزْوَٰجٍۢ وَلَوْ أَعْجَبَكَ","إِلَّا مَا مَلَكَتْ",682],["35:8:7",435,"حَسَنًۭا ۖ","(as) good","سُوٓءُ عَمَلِهِۦ فَرَءَاهُ","فَإِنَّ ٱللَّهَ يُضِلُّ",486],["37:80:4",449,"ٱلْمُحْسِنِينَ","the good-doers","إِنَّا كَذَٰلِكَ نَجْزِى","",308],["37:105:7",450,"ٱلْمُحْسِنِينَ","the good-doers","إِنَّا كَذَٰلِكَ نَجْزِى","",308],["37:110:3",450,"ٱلْمُحْسِنِينَ","the good-doers","كَذَٰلِكَ نَجْزِى","",308],["37:113:7",450,"مُحْسِنٌۭ","(are) good-doers","إِسْحَـٰقَ ۚ وَمِن ذُرِّيَّتِهِمَا","وَظَالِمٌۭ لِّنَفْسِهِۦ مُبِينٌۭ",308],["37:121:4",450,"ٱلْمُحْسِنِينَ","the good-doers","إِنَّا كَذَٰلِكَ نَجْزِى","",308],["37:125:4",450,"أَحْسَنَ","(the) Best","أَتَدْعُونَ بَعْلًۭا وَتَذَرُونَ","ٱلْخَـٰلِقِينَ",323],["37:131:4",451,"ٱلْمُحْسِنِينَ","the good-doers","إِنَّا كَذَٰلِكَ نَجْزِى","",308],["38:25:8",454,"وَحُسْنَ","and a good","لَهُۥ عِندَنَا لَزُلْفَىٰ","مَـَٔابٍۢ",682],["38:40:5",455,"وَحُسْنَ","and a good","لَهُۥ عِندَنَا لَزُلْفَىٰ","مَـَٔابٍۢ",682],["38:49:5",456,"لَحُسْنَ","surely, is a good","ذِكْرٌۭ ۚ وَإِنَّ لِلْمُتَّقِينَ","مَـَٔابٍۢ",682],["39:10:8",459,"أَحْسَنُوا۟","do good","ٱتَّقُوا۟ رَبَّكُمْ ۚ لِلَّذِينَ","فِى هَـٰذِهِ ٱلدُّنْيَا",484],["39:10:12",459,"حَسَنَةٌۭ ۗ","(is) good","فِى هَـٰذِهِ ٱلدُّنْيَا","وَأَرْضُ ٱللَّهِ وَٰسِعَةٌ ۗ",386],["39:18:5",460,"أَحْسَنَهُۥٓ ۚ","the best thereof","يَسْتَمِعُونَ ٱلْقَوْلَ فَيَتَّبِعُونَ","أُو۟لَـٰٓئِكَ ٱلَّذِينَ هَدَىٰهُمُ",323],["39:23:3",461,"أَحْسَنَ","(the) best","ٱللَّهُ نَزَّلَ","ٱلْحَدِيثِ كِتَـٰبًۭا مُّتَشَـٰبِهًۭا",323],["39:34:8",462,"ٱلْمُحْسِنِينَ","(of) the good-doers","رَبِّهِمْ ۚ ذَٰلِكَ جَزَآءُ","",308],["39:35:9",462,"بِأَحْسَنِ","for (the) best","عَمِلُوا۟ وَيَجْزِيَهُمْ أَجْرَهُم","ٱلَّذِى كَانُوا۟ يَعْمَلُونَ",323],["39:55:2",464,"أَحْسَنَ","(the) best","وَٱتَّبِعُوٓا۟","مَآ أُنزِلَ إِلَيْكُم",323],["39:58:12",465,"ٱلْمُحْسِنِينَ","the good-doers","كَرَّةًۭ فَأَكُونَ مِنَ","",308],["40:64:10",474,"فَأَحْسَنَ","and perfected","وَٱلسَّمَآءَ بِنَآءًۭ وَصَوَّرَكُمْ","صُوَرَكُمْ وَرَزَقَكُم مِّنَ",484],["41:33:2",480,"أَحْسَنُ","(is) better","وَمَنْ","قَوْلًۭا مِّمَّن دَعَآ",323],["41:34:3",480,"ٱلْحَسَنَةُ","the good (deed)","وَلَا تَسْتَوِى","وَلَا ٱلسَّيِّئَةُ ۚ ٱدْفَعْ",386],["41:34:9",480,"أَحْسَنُ","(is) better","ٱدْفَعْ بِٱلَّتِى هِىَ","فَإِذَا ٱلَّذِى بَيْنَكَ",323],["41:50:23",482,"لَلْحُسْنَىٰ ۚ","(will be) the best","إِنَّ لِى عِندَهُۥ","فَلَنُنَبِّئَنَّ ٱلَّذِينَ كَفَرُوا۟",568],["42:23:21",486,"حَسَنَةًۭ","any good","ٱلْقُرْبَىٰ ۗ وَمَن يَقْتَرِفْ","نَّزِدْ لَهُۥ فِيهَا",386],["42:23:25",486,"حُسْنًا ۚ","good","نَّزِدْ لَهُۥ فِيهَا","إِنَّ ٱللَّهَ غَفُورٌۭ",682],["46:12:16",503,"لِلْمُحْسِنِينَ","for the good-doers","ٱلَّذِينَ ظَلَمُوا۟ وَبُشْرَىٰ","",308],["46:15:4",504,"إِحْسَـٰنًا ۖ","kindness","وَوَصَّيْنَا ٱلْإِنسَـٰنَ بِوَٰلِدَيْهِ","حَمَلَتْهُ أُمُّهُۥ كُرْهًۭا",706],["46:16:5",504,"أَحْسَنَ","(the) best","ٱلَّذِينَ نَتَقَبَّلُ عَنْهُمْ","مَا عَمِلُوا۟ وَنَتَجَاوَزُ",323],["48:16:19",513,"حَسَنًۭا ۖ","good","يُؤْتِكُمُ ٱللَّهُ أَجْرًا","وَإِن تَتَوَلَّوْا۟ كَمَا",486],["51:16:9",521,"مُحْسِنِينَ","good-doers","كَانُوا۟ قَبْلَ ذَٰلِكَ","",308],["53:31:15",527,"أَحْسَنُوا۟","do good","عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ","بِٱلْحُسْنَى",484],["53:31:16",527,"بِٱلْحُسْنَى","with the best","وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟","",568],["55:60:3",533,"ٱلْإِحْسَـٰنِ","for the good","هَلْ جَزَآءُ","إِلَّا ٱلْإِحْسَـٰنُ",706],["55:60:5",533,"ٱلْإِحْسَـٰنُ","good","جَزَآءُ ٱلْإِحْسَـٰنِ إِلَّا","",706],["55:70:3",534,"حِسَانٌۭ","and beautiful ones","فِيهِنَّ خَيْرَٰتٌ","",486],["55:76:6",534,"حِسَانٍۢ","beautiful","رَفْرَفٍ خُضْرٍۢ وَعَبْقَرِىٍّ","",486],["57:10:33",538,"ٱلْحُسْنَىٰ ۚ","the best","وَكُلًّۭا وَعَدَ ٱللَّهُ","وَٱللَّهُ بِمَا تَعْمَلُونَ",568],["57:11:7",538,"حَسَنًۭا","goodly","يُقْرِضُ ٱللَّهَ قَرْضًا","فَيُضَـٰعِفَهُۥ لَهُۥ وَلَهُۥٓ",486],["57:18:7",539,"حَسَنًۭا","goodly","وَأَقْرَضُوا۟ ٱللَّهَ قَرْضًا","يُضَـٰعَفُ لَهُمْ وَلَهُمْ",486],["59:24:8",548,"ٱلْحُسْنَىٰ ۚ","the beautiful","ٱلْمُصَوِّرُ ۖ لَهُ ٱلْأَسْمَآءُ","يُسَبِّحُ لَهُۥ مَا",568],["60:4:5",549,"حَسَنَةٌۭ","good","كَانَتْ لَكُمْ أُسْوَةٌ","فِىٓ إِبْرَٰهِيمَ وَٱلَّذِينَ",386],["60:6:6",550,"حَسَنَةٌۭ","good","لَكُمْ فِيهِمْ أُسْوَةٌ","لِّمَن كَانَ يَرْجُوا۟",386],["64:3:6",556,"فَأَحْسَنَ","and made good","وَٱلْأَرْضَ بِٱلْحَقِّ وَصَوَّرَكُمْ","صُوَرَكُمْ ۖ وَإِلَيْهِ ٱلْمَصِيرُ",484],["64:17:5",557,"حَسَنًۭا","goodly","تُقْرِضُوا۟ ٱللَّهَ قَرْضًا","يُضَـٰعِفْهُ لَكُمْ وَيَغْفِرْ",486],["65:11:31",559,"أَحْسَنَ","Has been (granted) good","فِيهَآ أَبَدًۭا ۖ قَدْ","ٱللَّهُ لَهُۥ رِزْقًا",484],["67:2:7",562,"أَحْسَنُ","(is) best","وَٱلْحَيَوٰةَ لِيَبْلُوَكُمْ أَيُّكُمْ","عَمَلًۭا ۚ وَهُوَ ٱلْعَزِيزُ",323],["73:20:60",575,"حَسَنًۭا ۚ","goodly","وَأَقْرِضُوا۟ ٱللَّهَ قَرْضًا","وَمَا تُقَدِّمُوا۟ لِأَنفُسِكُم",486],["77:44:4",581,"ٱلْمُحْسِنِينَ","the good-doers","إِنَّا كَذَٰلِكَ نَجْزِى","",308],["92:6:2",595,"بِٱلْحُسْنَىٰ","in the best","وَصَدَّقَ","",568],["92:9:2",595,"بِٱلْحُسْنَىٰ","the best","وَكَذَّبَ","",568],["95:4:5",597,"أَحْسَنِ","(the) best","خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ","تَقْوِيمٍۢ",323]]