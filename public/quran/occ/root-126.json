[["2:185:6",28,"ٱلْقُرْءَانُ","the Quran","ٱلَّذِىٓ أُنزِلَ فِيهِ","هُدًۭى لِّلنَّاسِ وَبَيِّنَـٰتٍۢ",175],["2:228:5",36,"قُرُوٓءٍۢ ۚ","monthly periods","يَتَرَبَّصْنَ بِأَنفُسِهِنَّ ثَلَـٰثَةَ","وَلَا يَحِلُّ لَهُنَّ",4149],["4:82:3",91,"ٱلْقُرْءَانَ ۚ","(on) the Quran","أَفَلَا يَتَدَبَّرُونَ","وَلَوْ كَانَ مِنْ",175],["5:101:17",124,"ٱلْقُرْءَانُ","the Quran","عَنْهَا حِينَ يُنَزَّلُ","تُبْدَ لَكُمْ عَفَا",175],["6:19:14",130,"ٱلْقُرْءَانُ","[the] Quran","وَأُوحِىَ إِلَىَّ هَـٰذَا","لِأُنذِرَكُم بِهِۦ وَمَنۢ",175],["7:204:2",176,"قُرِئَ","is recited","وَإِذَا","ٱلْقُرْءَانُ فَٱسْتَمِعُوا۟ لَهُۥ",601],["7:204:3",176,"ٱلْقُرْءَانُ","the Quran","وَإِذَا قُرِئَ","فَٱسْتَمِعُوا۟ لَهُۥ وَأَنصِتُوا۟",175],["9:111:23",204,"وَٱلْقُرْءَانِ ۚ","and the Quran","فِى ٱلتَّوْرَىٰةِ وَٱلْإِنجِيلِ","وَمَنْ أَوْفَىٰ بِعَهْدِهِۦ",175],["10:15:12",210,"بِقُرْءَانٍ","a Quran","يَرْجُونَ لِقَآءَنَا ٱئْتِ","غَيْرِ هَـٰذَآ أَوْ",175],["10:37:4",213,"ٱلْقُرْءَانُ","the Quran","وَمَا كَانَ هَـٰذَا","أَن يُفْتَرَىٰ مِن",175],["10:61:9",215,"قُرْءَانٍۢ","(the) Quran","تَتْلُوا۟ مِنْهُ مِن","وَلَا تَعْمَلُونَ مِنْ",175],["10:94:10",219,"يَقْرَءُونَ","(have been) reading","إِلَيْكَ فَسْـَٔلِ ٱلَّذِينَ","ٱلْكِتَـٰبَ مِن قَبْلِكَ ۚ",601],["12:2:3",235,"قُرْءَٰنًا","(as) a Quran in Arabic","إِنَّآ أَنزَلْنَـٰهُ","عَرَبِيًّۭا لَّعَلَّكُمْ تَعْقِلُونَ",175],["12:3:10",235,"ٱلْقُرْءَانَ","the Quran","أَوْحَيْنَآ إِلَيْكَ هَـٰذَا","وَإِن كُنتَ مِن",175],["13:31:3",253,"قُرْءَانًۭا","any Quran","وَلَوْ أَنَّ","سُيِّرَتْ بِهِ ٱلْجِبَالُ",175],["15:1:5",262,"وَقُرْءَانٍۢ","and Quran","تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ","مُّبِينٍۢ",175],["15:87:6",266,"وَٱلْقُرْءَانَ","and the Quran","سَبْعًۭا مِّنَ ٱلْمَثَانِى","ٱلْعَظِيمَ",175],["15:91:3",267,"ٱلْقُرْءَانَ","the Quran","ٱلَّذِينَ جَعَلُوا۟","عِضِينَ",175],["16:98:2",278,"قَرَأْتَ","you recite","فَإِذَا","ٱلْقُرْءَانَ فَٱسْتَعِذْ بِٱللَّهِ",601],["16:98:3",278,"ٱلْقُرْءَانَ","the Quran","فَإِذَا قَرَأْتَ","فَٱسْتَعِذْ بِٱللَّهِ مِنَ",175],["17:9:3",283,"ٱلْقُرْءَانَ","the Quran","إِنَّ هَـٰذَا","يَهْدِى لِلَّتِى هِىَ",175],["17:14:1",283,"ٱقْرَأْ","Read","","كِتَـٰبَكَ كَفَىٰ بِنَفْسِكَ",601],["17:41:5",286,"ٱلْقُرْءَانِ","the Quran","صَرَّفْنَا فِى هَـٰذَا","لِيَذَّكَّرُوا۟ وَمَا يَزِيدُهُمْ",175],["17:45:2",286,"قَرَأْتَ","you recite","وَإِذَا","ٱلْقُرْءَانَ جَعَلْنَا بَيْنَكَ",601],["17:45:3",286,"ٱلْقُرْءَانَ","the Quran","وَإِذَا قَرَأْتَ","جَعَلْنَا بَيْنَكَ وَبَيْنَ",175],["17:46:14",286,"ٱلْقُرْءَانِ","the Quran","ذَكَرْتَ رَبَّكَ فِى","وَحْدَهُۥ وَلَّوْا۟ عَلَىٰٓ",175],["17:60:19",288,"ٱلْقُرْءَانِ ۚ","the Quran","وَٱلشَّجَرَةَ ٱلْمَلْعُونَةَ فِى","وَنُخَوِّفُهُمْ فَمَا يَزِيدُهُمْ",175],["17:71:11",289,"يَقْرَءُونَ","will read","كِتَـٰبَهُۥ بِيَمِينِهِۦ فَأُو۟لَـٰٓئِكَ","كِتَـٰبَهُمْ وَلَا يُظْلَمُونَ",601],["17:78:8",290,"وَقُرْءَانَ","and Quran","إِلَىٰ غَسَقِ ٱلَّيْلِ","ٱلْفَجْرِ ۖ إِنَّ قُرْءَانَ",175],["17:78:11",290,"قُرْءَانَ","the Quran","وَقُرْءَانَ ٱلْفَجْرِ ۖ إِنَّ","ٱلْفَجْرِ كَانَ مَشْهُودًۭا",175],["17:82:3",290,"ٱلْقُرْءَانِ","the Quran","وَنُنَزِّلُ مِنَ","مَا هُوَ شِفَآءٌۭ",175],["17:88:11",291,"ٱلْقُرْءَانِ","Quran","يَأْتُوا۟ بِمِثْلِ هَـٰذَا","لَا يَأْتُونَ بِمِثْلِهِۦ",175],["17:89:6",291,"ٱلْقُرْءَانِ","Quran","لِلنَّاسِ فِى هَـٰذَا","مِن كُلِّ مَثَلٍۢ",175],["17:93:18",291,"نَّقْرَؤُهُۥ ۗ","we could read it","تُنَزِّلَ عَلَيْنَا كِتَـٰبًۭا","قُلْ سُبْحَانَ رَبِّى",601],["17:106:1",293,"وَقُرْءَانًۭا","And the Quran","","فَرَقْنَـٰهُ لِتَقْرَأَهُۥ عَلَى",175],["17:106:3",293,"لِتَقْرَأَهُۥ","that you might recite it","وَقُرْءَانًۭا فَرَقْنَـٰهُ","عَلَى ٱلنَّاسِ عَلَىٰ",601],["18:54:5",300,"ٱلْقُرْءَانِ","the Quran","صَرَّفْنَا فِى هَـٰذَا","لِلنَّاسِ مِن كُلِّ",175],["20:2:4",312,"ٱلْقُرْءَانَ","the Quran","مَآ أَنزَلْنَا عَلَيْكَ","لِتَشْقَىٰٓ",175],["20:113:3",319,"قُرْءَانًا","(the) Quran","وَكَذَٰلِكَ أَنزَلْنَـٰهُ","عَرَبِيًّۭا وَصَرَّفْنَا فِيهِ",175],["20:114:7",320,"بِٱلْقُرْءَانِ","with the Quran","ٱلْحَقُّ ۗ وَلَا تَعْجَلْ","مِن قَبْلِ أَن",175],["25:30:8",362,"ٱلْقُرْءَانَ","the Quran","قَوْمِى ٱتَّخَذُوا۟ هَـٰذَا","مَهْجُورًۭا",175],["25:32:7",362,"ٱلْقُرْءَانُ","the Quran","لَوْلَا نُزِّلَ عَلَيْهِ","جُمْلَةًۭ وَٰحِدَةًۭ ۚ كَذَٰلِكَ",175],["26:199:1",375,"فَقَرَأَهُۥ","And he (had) recited it","","عَلَيْهِم مَّا كَانُوا۟",601],["27:1:4",377,"ٱلْقُرْءَانِ","(of) the Quran","طسٓ ۚ تِلْكَ ءَايَـٰتُ","وَكِتَابٍۢ مُّبِينٍ",175],["27:6:3",377,"ٱلْقُرْءَانَ","the Quran","وَإِنَّكَ لَتُلَقَّى","مِن لَّدُنْ حَكِيمٍ",175],["27:76:3",383,"ٱلْقُرْءَانَ","[the] Quran","إِنَّ هَـٰذَا","يَقُصُّ عَلَىٰ بَنِىٓ",175],["27:92:3",385,"ٱلْقُرْءَانَ ۖ","the Quran","وَأَنْ أَتْلُوَا۟","فَمَنِ ٱهْتَدَىٰ فَإِنَّمَا",175],["28:85:5",396,"ٱلْقُرْءَانَ","the Quran","ٱلَّذِى فَرَضَ عَلَيْكَ","لَرَآدُّكَ إِلَىٰ مَعَادٍۢ ۚ",175],["30:58:6",410,"ٱلْقُرْءَانِ","[the] Quran","لِلنَّاسِ فِى هَـٰذَا","مِن كُلِّ مَثَلٍۢ ۚ",175],["34:31:7",431,"ٱلْقُرْءَانِ","Quran","لَن نُّؤْمِنَ بِهَـٰذَا","وَلَا بِٱلَّذِى بَيْنَ",175],["36:2:1",440,"وَٱلْقُرْءَانِ","By the Quran","","ٱلْحَكِيمِ",175],["36:69:11",444,"وَقُرْءَانٌۭ","and a Quran","هُوَ إِلَّا ذِكْرٌۭ","مُّبِينٌۭ",175],["38:1:2",453,"وَٱلْقُرْءَانِ","By the Quran","صٓ ۚ","ذِى ٱلذِّكْرِ",175],["39:27:6",461,"ٱلْقُرْءَانِ","Quran","لِلنَّاسِ فِى هَـٰذَا","مِن كُلِّ مَثَلٍۢ",175],["39:28:1",461,"قُرْءَانًا","A Quran","","عَرَبِيًّا غَيْرَ ذِى",175],["41:3:4",477,"قُرْءَانًا","a Quran","كِتَـٰبٌۭ فُصِّلَتْ ءَايَـٰتُهُۥ","عَرَبِيًّۭا لِّقَوْمٍۢ يَعْلَمُونَ",175],["41:26:7",479,"ٱلْقُرْءَانِ","Quran","لَا تَسْمَعُوا۟ لِهَـٰذَا","وَٱلْغَوْا۟ فِيهِ لَعَلَّكُمْ",175],["41:44:3",481,"قُرْءَانًا","a Quran","وَلَوْ جَعَلْنَـٰهُ","أَعْجَمِيًّۭا لَّقَالُوا۟ لَوْلَا",175],["42:7:4",483,"قُرْءَانًا","a Quran","وَكَذَٰلِكَ أَوْحَيْنَآ إِلَيْكَ","عَرَبِيًّۭا لِّتُنذِرَ أُمَّ",175],["43:3:3",489,"قُرْءَٰنًا","a Quran","إِنَّا جَعَلْنَـٰهُ","عَرَبِيًّۭا لَّعَلَّكُمْ تَعْقِلُونَ",175],["43:31:5",491,"ٱلْقُرْءَانُ","the Quran","لَوْلَا نُزِّلَ هَـٰذَا","عَلَىٰ رَجُلٍۢ مِّنَ",175],["46:29:8",506,"ٱلْقُرْءَانَ","(to) the Quran","مِّنَ ٱلْجِنِّ يَسْتَمِعُونَ","فَلَمَّا حَضَرُوهُ قَالُوٓا۟",175],["47:24:3",509,"ٱلْقُرْءَانَ","(over) the Quran","أَفَلَا يَتَدَبَّرُونَ","أَمْ عَلَىٰ قُلُوبٍ",175],["50:1:2",518,"وَٱلْقُرْءَانِ","By the Quran","قٓ ۚ","ٱلْمَجِيدِ",175],["50:45:10",520,"بِٱلْقُرْءَانِ","with the Quran","عَلَيْهِم بِجَبَّارٍۢ ۖ فَذَكِّرْ","مَن يَخَافُ وَعِيدِ",175],["54:17:3",529,"ٱلْقُرْءَانَ","the Quran","وَلَقَدْ يَسَّرْنَا","لِلذِّكْرِ فَهَلْ مِن",175],["54:22:3",529,"ٱلْقُرْءَانَ","the Quran","وَلَقَدْ يَسَّرْنَا","لِلذِّكْرِ فَهَلْ مِن",175],["54:32:3",530,"ٱلْقُرْءَانَ","the Quran","وَلَقَدْ يَسَّرْنَا","لِلذِّكْرِ فَهَلْ مِن",175],["54:40:3",530,"ٱلْقُرْءَانَ","the Quran","وَلَقَدْ يَسَّرْنَا","لِلذِّكْرِ فَهَلْ مِن",175],["55:2:2",531,"ٱلْقُرْءَانَ","the Quran","عَلَّمَ","",175],["56:77:2",537,"لَقُرْءَانٌۭ","(is) surely, a Quran","إِنَّهُۥ","كَرِيمٌۭ",175],["59:21:4",548,"ٱلْقُرْءَانَ","Quran","لَوْ أَنزَلْنَا هَـٰذَا","عَلَىٰ جَبَلٍۢ لَّرَأَيْتَهُۥ",175],["69:19:8",567,"ٱقْرَءُوا۟","read","بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ","كِتَـٰبِيَهْ",601],["72:1:12",572,"قُرْءَانًا","a Quran","فَقَالُوٓا۟ إِنَّا سَمِعْنَا","عَجَبًۭا",175],["73:4:5",574,"ٱلْقُرْءَانَ","the Quran","زِدْ عَلَيْهِ وَرَتِّلِ","تَرْتِيلًا",175],["73:20:26",575,"فَٱقْرَءُوا۟","so recite","تُحْصُوهُ فَتَابَ عَلَيْكُمْ ۖ","مَا تَيَسَّرَ مِنَ",601],["73:20:30",575,"ٱلْقُرْءَانِ ۚ","the Quran","مَا تَيَسَّرَ مِنَ","عَلِمَ أَن سَيَكُونُ",175],["73:20:49",575,"فَٱقْرَءُوا۟","So recite","فِى سَبِيلِ ٱللَّهِ ۖ","مَا تَيَسَّرَ مِنْهُ ۚ",601],["75:17:4",577,"وَقُرْءَانَهُۥ","and its recitation","إِنَّ عَلَيْنَا جَمْعَهُۥ","",175],["75:18:2",577,"قَرَأْنَـٰهُ","We have recited it","فَإِذَا","فَٱتَّبِعْ قُرْءَانَهُۥ",601],["75:18:4",577,"قُرْءَانَهُۥ","its recitation","فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ","",175],["76:23:5",579,"ٱلْقُرْءَانَ","the Quran","نَحْنُ نَزَّلْنَا عَلَيْكَ","تَنزِيلًۭا",175],["84:21:2",589,"قُرِئَ","is recited","وَإِذَا","عَلَيْهِمُ ٱلْقُرْءَانُ لَا",601],["84:21:4",589,"ٱلْقُرْءَانُ","the Quran","وَإِذَا قُرِئَ عَلَيْهِمُ","لَا يَسْجُدُونَ ۩",175],["85:21:3",590,"قُرْءَانٌۭ","(is) a Quran","بَلْ هُوَ","مَّجِيدٌۭ",175],["87:6:1",591,"سَنُقْرِئُكَ","We will make you recite","","فَلَا تَنسَىٰٓ",4070],["96:1:1",597,"ٱقْرَأْ","Read","","بِٱسْمِ رَبِّكَ ٱلَّذِى",601],["96:3:1",597,"ٱقْرَأْ","Read","","وَرَبُّكَ ٱلْأَكْرَمُ",601]]