[["2:57:10",8,"طَيِّبَـٰتِ","(the) good things","وَٱلسَّلْوَىٰ ۖ كُلُوا۟ مِن","مَا رَزَقْنَـٰكُمْ ۖ وَمَا",487],["2:168:8",25,"طَيِّبًۭا","(and) good","فِى ٱلْأَرْضِ حَلَـٰلًۭا","وَلَا تَتَّبِعُوا۟ خُطُوَٰتِ",590],["2:172:6",26,"طَيِّبَـٰتِ","(the) good","ءَامَنُوا۟ كُلُوا۟ مِن","مَا رَزَقْنَـٰكُمْ وَٱشْكُرُوا۟",487],["2:267:6",45,"طَيِّبَـٰتِ","(the) good things","ءَامَنُوٓا۟ أَنفِقُوا۟ مِن","مَا كَسَبْتُمْ وَمِمَّآ",487],["3:38:12",55,"طَيِّبَةً ۖ","pure","مِن لَّدُنكَ ذُرِّيَّةًۭ","إِنَّكَ سَمِيعُ ٱلدُّعَآءِ",892],["3:179:14",73,"ٱلطَّيِّبِ ۗ","the good","يَمِيزَ ٱلْخَبِيثَ مِنَ","وَمَا كَانَ ٱللَّهُ",590],["4:2:7",77,"بِٱلطَّيِّبِ ۖ","with the good","وَلَا تَتَبَدَّلُوا۟ ٱلْخَبِيثَ","وَلَا تَأْكُلُوٓا۟ أَمْوَٰلَهُمْ",590],["4:3:9",77,"طَابَ","seems suitable","ٱلْيَتَـٰمَىٰ فَٱنكِحُوا۟ مَا","لَكُم مِّنَ ٱلنِّسَآءِ",1798],["4:4:6",77,"طِبْنَ","they remit","صَدُقَـٰتِهِنَّ نِحْلَةًۭ ۚ فَإِن","لَكُمْ عَن شَىْءٍۢ",1798],["4:43:40",85,"طَيِّبًۭا","clean","مَآءًۭ فَتَيَمَّمُوا۟ صَعِيدًۭا","فَٱمْسَحُوا۟ بِوُجُوهِكُمْ وَأَيْدِيكُمْ ۗ",590],["4:160:7",103,"طَيِّبَـٰتٍ","good things","هَادُوا۟ حَرَّمْنَا عَلَيْهِمْ","أُحِلَّتْ لَهُمْ وَبِصَدِّهِمْ",487],["5:4:8",107,"ٱلطَّيِّبَـٰتُ ۙ","the good things","قُلْ أُحِلَّ لَكُمُ","وَمَا عَلَّمْتُم مِّنَ",487],["5:5:4",107,"ٱلطَّيِّبَـٰتُ ۖ","the good things","ٱلْيَوْمَ أُحِلَّ لَكُمُ","وَطَعَامُ ٱلَّذِينَ أُوتُوا۟",487],["5:6:42",108,"طَيِّبًۭا","clean","مَآءًۭ فَتَيَمَّمُوا۟ صَعِيدًۭا","فَٱمْسَحُوا۟ بِوُجُوهِكُمْ وَأَيْدِيكُم",590],["5:87:6",122,"طَيِّبَـٰتِ","(the) good things","ءَامَنُوا۟ لَا تُحَرِّمُوا۟","مَآ أَحَلَّ ٱللَّهُ",487],["5:88:6",122,"طَيِّبًۭا ۚ","good","رَزَقَكُمُ ٱللَّهُ حَلَـٰلًۭا","وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ",590],["5:100:5",124,"وَٱلطَّيِّبُ","and the good","لَّا يَسْتَوِى ٱلْخَبِيثُ","وَلَوْ أَعْجَبَكَ كَثْرَةُ",590],["7:32:9",154,"وَٱلطَّيِّبَـٰتِ","and the pure things","ٱلَّتِىٓ أَخْرَجَ لِعِبَادِهِۦ","مِنَ ٱلرِّزْقِ ۚ قُلْ",487],["7:58:2",158,"ٱلطَّيِّبُ","[the] pure","وَٱلْبَلَدُ","يَخْرُجُ نَبَاتُهُۥ بِإِذْنِ",590],["7:157:20",170,"ٱلطَّيِّبَـٰتِ","the pure things","ٱلْمُنكَرِ وَيُحِلُّ لَهُمُ","وَيُحَرِّمُ عَلَيْهِمُ ٱلْخَبَـٰٓئِثَ",487],["7:160:35",171,"طَيِّبَـٰتِ","(the) good things","وَٱلسَّلْوَىٰ ۖ كُلُوا۟ مِن","مَا رَزَقْنَـٰكُمْ ۚ وَمَا",487],["8:26:17",180,"ٱلطَّيِّبَـٰتِ","the good things","بِنَصْرِهِۦ وَرَزَقَكُم مِّنَ","لَعَلَّكُمْ تَشْكُرُونَ",487],["8:37:5",181,"ٱلطَّيِّبِ","the good","ٱللَّهُ ٱلْخَبِيثَ مِنَ","وَيَجْعَلَ ٱلْخَبِيثَ بَعْضَهُۥ",590],["8:69:5",185,"طَيِّبًۭا ۚ","(and) good","مِمَّا غَنِمْتُمْ حَلَـٰلًۭا","وَٱتَّقُوا۟ ٱللَّهَ ۚ إِنَّ",590],["9:72:13",198,"طَيِّبَةًۭ","blessed","خَـٰلِدِينَ فِيهَا وَمَسَـٰكِنَ","فِى جَنَّـٰتِ عَدْنٍۢ ۚ",892],["10:22:15",211,"طَيِّبَةٍۢ","good","وَجَرَيْنَ بِهِم بِرِيحٍۢ","وَفَرِحُوا۟ بِهَا جَآءَتْهَا",892],["10:93:9",219,"ٱلطَّيِّبَـٰتِ","the good things","صِدْقٍۢ وَرَزَقْنَـٰهُم مِّنَ","فَمَا ٱخْتَلَفُوا۟ حَتَّىٰ",487],["13:29:5",253,"طُوبَىٰ","blessedness","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","لَهُمْ وَحُسْنُ مَـَٔابٍۢ",3298],["14:24:8",258,"طَيِّبَةًۭ","good","ٱللَّهُ مَثَلًۭا كَلِمَةًۭ","كَشَجَرَةٍۢ طَيِّبَةٍ أَصْلُهَا",892],["14:24:10",258,"طَيِّبَةٍ","good","كَلِمَةًۭ طَيِّبَةًۭ كَشَجَرَةٍۢ","أَصْلُهَا ثَابِتٌۭ وَفَرْعُهَا",892],["16:32:4",270,"طَيِّبِينَ ۙ","(when they are) pure","ٱلَّذِينَ تَتَوَفَّىٰهُمُ ٱلْمَلَـٰٓئِكَةُ","يَقُولُونَ سَلَـٰمٌ عَلَيْكُمُ",590],["16:72:15",274,"ٱلطَّيِّبَـٰتِ ۚ","the good things","وَحَفَدَةًۭ وَرَزَقَكُم مِّنَ","أَفَبِٱلْبَـٰطِلِ يُؤْمِنُونَ وَبِنِعْمَتِ",487],["16:97:12",278,"طَيِّبَةًۭ ۖ","good","مُؤْمِنٌۭ فَلَنُحْيِيَنَّهُۥ حَيَوٰةًۭ","وَلَنَجْزِيَنَّهُمْ أَجْرَهُم بِأَحْسَنِ",892],["16:114:6",280,"طَيِّبًۭا","and good","رَزَقَكُمُ ٱللَّهُ حَلَـٰلًۭا","وَٱشْكُرُوا۟ نِعْمَتَ ٱللَّهِ",590],["17:70:11",289,"ٱلطَّيِّبَـٰتِ","the good things","وَٱلْبَحْرِ وَرَزَقْنَـٰهُم مِّنَ","وَفَضَّلْنَـٰهُمْ عَلَىٰ كَثِيرٍۢ",487],["20:81:3",317,"طَيِّبَـٰتِ","(the) good things","كُلُوا۟ مِن","مَا رَزَقْنَـٰكُمْ وَلَا",487],["22:24:3",335,"ٱلطَّيِّبِ","the good","وَهُدُوٓا۟ إِلَى","مِنَ ٱلْقَوْلِ وَهُدُوٓا۟",590],["23:51:5",345,"ٱلطَّيِّبَـٰتِ","the good things","ٱلرُّسُلُ كُلُوا۟ مِنَ","وَٱعْمَلُوا۟ صَـٰلِحًا ۖ إِنِّى",487],["24:26:5",352,"وَٱلطَّيِّبَـٰتُ","And good women","لِلْخَبِيثِينَ وَٱلْخَبِيثُونَ لِلْخَبِيثَـٰتِ ۖ","لِلطَّيِّبِينَ وَٱلطَّيِّبُونَ لِلطَّيِّبَـٰتِ ۚ",487],["24:26:6",352,"لِلطَّيِّبِينَ","(are) for good men","وَٱلْخَبِيثُونَ لِلْخَبِيثَـٰتِ ۖ وَٱلطَّيِّبَـٰتُ","وَٱلطَّيِّبُونَ لِلطَّيِّبَـٰتِ ۚ أُو۟لَـٰٓئِكَ",590],["24:26:7",352,"وَٱلطَّيِّبُونَ","and good men","لِلْخَبِيثَـٰتِ ۖ وَٱلطَّيِّبَـٰتُ لِلطَّيِّبِينَ","لِلطَّيِّبَـٰتِ ۚ أُو۟لَـٰٓئِكَ مُبَرَّءُونَ",590],["24:26:8",352,"لِلطَّيِّبَـٰتِ ۚ","(are) for good women","وَٱلطَّيِّبَـٰتُ لِلطَّيِّبِينَ وَٱلطَّيِّبُونَ","أُو۟لَـٰٓئِكَ مُبَرَّءُونَ مِمَّا",487],["24:61:69",358,"طَيِّبَةًۭ ۚ","(and) good","عِندِ ٱللَّهِ مُبَـٰرَكَةًۭ","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ",892],["34:15:18",430,"طَيِّبَةٌۭ","good","وَٱشْكُرُوا۟ لَهُۥ ۚ بَلْدَةٌۭ","وَرَبٌّ غَفُورٌۭ",892],["35:10:11",435,"ٱلطَّيِّبُ","good","إِلَيْهِ يَصْعَدُ ٱلْكَلِمُ","وَٱلْعَمَلُ ٱلصَّـٰلِحُ يَرْفَعُهُۥ ۚ",590],["39:73:18",466,"طِبْتُمْ","you have done well","خَزَنَتُهَا سَلَـٰمٌ عَلَيْكُمْ","فَٱدْخُلُوهَا خَـٰلِدِينَ",1798],["40:64:14",474,"ٱلطَّيِّبَـٰتِ ۚ","the good things","صُوَرَكُمْ وَرَزَقَكُم مِّنَ","ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ ۖ",487],["45:16:10",500,"ٱلطَّيِّبَـٰتِ","the good things","وَٱلنُّبُوَّةَ وَرَزَقْنَـٰهُم مِّنَ","وَفَضَّلْنَـٰهُمْ عَلَى ٱلْعَـٰلَمِينَ",487],["46:20:8",504,"طَيِّبَـٰتِكُمْ","your good things","عَلَى ٱلنَّارِ أَذْهَبْتُمْ","فِى حَيَاتِكُمُ ٱلدُّنْيَا",487],["61:12:11",552,"طَيِّبَةًۭ","pleasant","تَحْتِهَا ٱلْأَنْهَـٰرُ وَمَسَـٰكِنَ","فِى جَنَّـٰتِ عَدْنٍۢ ۚ",892]]