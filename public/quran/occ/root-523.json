[["6:33:14",131,"يَجْحَدُونَ","they reject","ٱلظَّـٰلِمِينَ بِـَٔايَـٰتِ ٱللَّهِ","",730],["7:51:19",156,"يَجْحَدُونَ","they reject","وَمَا كَانُوا۟ بِـَٔايَـٰتِنَا","",730],["11:59:3",228,"جَحَدُوا۟","they rejected","وَتِلْكَ عَادٌۭ ۖ","بِـَٔايَـٰتِ رَبِّهِمْ وَعَصَوْا۟",730],["16:71:22",274,"يَجْحَدُونَ","they reject","سَوَآءٌ ۚ أَفَبِنِعْمَةِ ٱللَّهِ","",730],["27:14:1",378,"وَجَحَدُوا۟","And they rejected","","بِهَا وَٱسْتَيْقَنَتْهَآ أَنفُسُهُمْ",730],["29:47:16",402,"يَجْحَدُ","reject","يُؤْمِنُ بِهِۦ ۚ وَمَا","بِـَٔايَـٰتِنَآ إِلَّا ٱلْكَـٰفِرُونَ",730],["29:49:11",402,"يَجْحَدُ","reject","أُوتُوا۟ ٱلْعِلْمَ ۚ وَمَا","بِـَٔايَـٰتِنَآ إِلَّا ٱلظَّـٰلِمُونَ",730],["31:32:17",414,"يَجْحَدُ","deny","فَمِنْهُم مُّقْتَصِدٌۭ ۚ وَمَا","بِـَٔايَـٰتِنَآ إِلَّا كُلُّ",730],["40:63:7",474,"يَجْحَدُونَ","rejecting","كَانُوا۟ بِـَٔايَـٰتِ ٱللَّهِ","",730],["41:15:25",478,"يَجْحَدُونَ","deny","قُوَّةًۭ ۖ وَكَانُوا۟ بِـَٔايَـٰتِنَا","",730],["41:28:14",479,"يَجْحَدُونَ","reject","بِمَا كَانُوا۟ بِـَٔايَـٰتِنَا","",730],["46:26:24",505,"يَجْحَدُونَ","rejecting","شَىْءٍ إِذْ كَانُوا۟","بِـَٔايَـٰتِ ٱللَّهِ وَحَاقَ",730]]