[["24:31:18",353,"جُيُوبِهِنَّ ۖ","their bosoms","وَلْيَضْرِبْنَ بِخُمُرِهِنَّ عَلَىٰ","وَلَا يُبْدِينَ زِينَتَهُنَّ",1858],["27:12:4",377,"جَيْبِكَ","your bosom","وَأَدْخِلْ يَدَكَ فِى","تَخْرُجْ بَيْضَآءَ مِنْ",1858],["28:32:4",389,"جَيْبِكَ","your bosom","ٱسْلُكْ يَدَكَ فِى","تَخْرُجْ بَيْضَآءَ مِنْ",1858]]