[["6:10:6",129,"فَحَاقَ","but surrounded","بِرُسُلٍۢ مِّن قَبْلِكَ","بِٱلَّذِينَ سَخِرُوا۟ مِنْهُم",822],["11:8:17",222,"وَحَاقَ","and will surround","لَيْسَ مَصْرُوفًا عَنْهُمْ","بِهِم مَّا كَانُوا۟",822],["16:34:5",270,"وَحَاقَ","and surrounded","سَيِّـَٔاتُ مَا عَمِلُوا۟","بِهِم مَّا كَانُوا۟",822],["21:41:6",325,"فَحَاقَ","then surrounded","بِرُسُلٍۢ مِّن قَبْلِكَ","بِٱلَّذِينَ سَخِرُوا۟ مِنْهُم",822],["35:43:7",439,"يَحِيقُ","encompasses","وَمَكْرَ ٱلسَّيِّئِ ۚ وَلَا","ٱلْمَكْرُ ٱلسَّيِّئُ إِلَّا",822],["39:48:6",464,"وَحَاقَ","and will surround","سَيِّـَٔاتُ مَا كَسَبُوا۟","بِهِم مَّا كَانُوا۟",822],["40:45:6",472,"وَحَاقَ","and enveloped","سَيِّـَٔاتِ مَا مَكَرُوا۟ ۖ","بِـَٔالِ فِرْعَوْنَ سُوٓءُ",822],["40:83:10",476,"وَحَاقَ","and enveloped","عِندَهُم مِّنَ ٱلْعِلْمِ","بِهِم مَّا كَانُوا۟",822],["45:33:6",502,"وَحَاقَ","and (will) envelop","سَيِّـَٔاتُ مَا عَمِلُوا۟","بِهِم مَّا كَانُوا۟",822],["46:26:27",505,"وَحَاقَ","and enveloped","يَجْحَدُونَ بِـَٔايَـٰتِ ٱللَّهِ","بِهِم مَّا كَانُوا۟",822]]