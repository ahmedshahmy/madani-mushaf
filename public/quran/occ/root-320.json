[["6:6:27",128,"وَأَنشَأْنَا","and We raised","تَحْتِهِمْ فَأَهْلَكْنَـٰهُم بِذُنُوبِهِمْ","مِنۢ بَعْدِهِمْ قَرْنًا",503],["6:98:3",140,"أَنشَأَكُم","(has) produced you","وَهُوَ ٱلَّذِىٓ","مِّن نَّفْسٍۢ وَٰحِدَةٍۢ",503],["6:133:14",145,"أَنشَأَكُم","He raised you","مَّا يَشَآءُ كَمَآ","مِّن ذُرِّيَّةِ قَوْمٍ",503],["6:141:3",146,"أَنشَأَ","produced","۞ وَهُوَ ٱلَّذِىٓ","جَنَّـٰتٍۢ مَّعْرُوشَـٰتٍۢ وَغَيْرَ",503],["11:61:15",228,"أَنشَأَكُم","produced you","إِلَـٰهٍ غَيْرُهُۥ ۖ هُوَ","مِّنَ ٱلْأَرْضِ وَٱسْتَعْمَرَكُمْ",503],["13:12:7",250,"وَيُنشِئُ","and brings up","ٱلْبَرْقَ خَوْفًۭا وَطَمَعًۭا","ٱلسَّحَابَ ٱلثِّقَالَ",503],["21:11:7",323,"وَأَنشَأْنَا","and We produced","قَرْيَةٍۢ كَانَتْ ظَالِمَةًۭ","بَعْدَهَا قَوْمًا ءَاخَرِينَ",503],["23:14:15",342,"أَنشَأْنَـٰهُ","We produce it","ٱلْعِظَـٰمَ لَحْمًۭا ثُمَّ","خَلْقًا ءَاخَرَ ۚ فَتَبَارَكَ",503],["23:19:1",343,"فَأَنشَأْنَا","Then We produced","","لَكُم بِهِۦ جَنَّـٰتٍۢ",503],["23:31:2",344,"أَنشَأْنَا","We produced","ثُمَّ","مِنۢ بَعْدِهِمْ قَرْنًا",503],["23:42:2",344,"أَنشَأْنَا","We produced","ثُمَّ","مِنۢ بَعْدِهِمْ قُرُونًا",503],["23:78:3",347,"أَنشَأَ","produced","وَهُوَ ٱلَّذِىٓ","لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ",503],["28:45:2",391,"أَنشَأْنَا","[We] produced","وَلَـٰكِنَّآ","قُرُونًۭا فَتَطَاوَلَ عَلَيْهِمُ",503],["29:20:11",398,"يُنشِئُ","will produce","ٱلْخَلْقَ ۚ ثُمَّ ٱللَّهُ","ٱلنَّشْأَةَ ٱلْـَٔاخِرَةَ ۚ إِنَّ",503],["29:20:12",398,"ٱلنَّشْأَةَ","the creation","ثُمَّ ٱللَّهُ يُنشِئُ","ٱلْـَٔاخِرَةَ ۚ إِنَّ ٱللَّهَ",1950],["36:79:4",445,"أَنشَأَهَآ","produced them","قُلْ يُحْيِيهَا ٱلَّذِىٓ","أَوَّلَ مَرَّةٍۢ ۖ وَهُوَ",503],["43:18:2",490,"يُنَشَّؤُا۟","is brought up","أَوَمَن","فِى ٱلْحِلْيَةِ وَهُوَ",4726],["53:32:16",527,"أَنشَأَكُم","He produced you","أَعْلَمُ بِكُمْ إِذْ","مِّنَ ٱلْأَرْضِ وَإِذْ",503],["53:47:3",528,"ٱلنَّشْأَةَ","(is) the bringing forth","وَأَنَّ عَلَيْهِ","ٱلْأُخْرَىٰ",1950],["55:24:3",532,"ٱلْمُنشَـَٔاتُ","elevated","وَلَهُ ٱلْجَوَارِ","فِى ٱلْبَحْرِ كَٱلْأَعْلَـٰمِ",3819],["56:35:2",535,"أَنشَأْنَـٰهُنَّ","[We] have produced them","إِنَّآ","إِنشَآءًۭ",503],["56:35:3",535,"إِنشَآءًۭ","(into) a creation","إِنَّآ أَنشَأْنَـٰهُنَّ","",2932],["56:61:5",536,"وَنُنشِئَكُمْ","and produce you","أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ","فِى مَا لَا",503],["56:62:3",536,"ٱلنَّشْأَةَ","the creation","وَلَقَدْ عَلِمْتُمُ","ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ",1950],["56:72:2",536,"أَنشَأْتُمْ","who produced","ءَأَنتُمْ","شَجَرَتَهَآ أَمْ نَحْنُ",503],["56:72:6",536,"ٱلْمُنشِـُٔونَ","(are) the Producers","شَجَرَتَهَآ أَمْ نَحْنُ","",3821],["67:23:4",563,"أَنشَأَكُمْ","produced you","قُلْ هُوَ ٱلَّذِىٓ","وَجَعَلَ لَكُمُ ٱلسَّمْعَ",503],["73:6:2",574,"نَاشِئَةَ","(the) rising","إِنَّ","ٱلَّيْلِ هِىَ أَشَدُّ",4007]]