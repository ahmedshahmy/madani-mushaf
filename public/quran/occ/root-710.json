[["3:79:28",60,"تَدْرُسُونَ","studying (it)","ٱلْكِتَـٰبَ وَبِمَا كُنتُمْ","",1328],["6:105:5",141,"دَرَسْتَ","You have studied","نُصَرِّفُ ٱلْـَٔايَـٰتِ وَلِيَقُولُوا۟","وَلِنُبَيِّنَهُۥ لِقَوْمٍۢ يَعْلَمُونَ",1328],["6:156:13",149,"دِرَاسَتِهِمْ","their study","وَإِن كُنَّا عَن","لَغَـٰفِلِينَ",3382],["7:169:31",172,"وَدَرَسُوا۟","while they studied","ٱللَّهِ إِلَّا ٱلْحَقَّ","مَا فِيهِ ۗ وَٱلدَّارُ",1328],["34:44:5",433,"يَدْرُسُونَهَا ۖ","which they could study","ءَاتَيْنَـٰهُم مِّن كُتُبٍۢ","وَمَآ أَرْسَلْنَآ إِلَيْهِمْ",1328],["68:37:5",565,"تَدْرُسُونَ","you learn","لَكُمْ كِتَـٰبٌۭ فِيهِ","",1328]]