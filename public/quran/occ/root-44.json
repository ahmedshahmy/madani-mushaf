[["1:4:1",1,"مَـٰلِكِ","(The) Master","","يَوْمِ ٱلدِّينِ",1885],["2:30:4",6,"لِلْمَلَـٰٓئِكَةِ","to the angels","وَإِذْ قَالَ رَبُّكَ","إِنِّى جَاعِلٌۭ فِى",122],["2:31:8",6,"ٱلْمَلَـٰٓئِكَةِ","the angels","ثُمَّ عَرَضَهُمْ عَلَى","فَقَالَ أَنۢبِـُٔونِى بِأَسْمَآءِ",122],["2:34:3",6,"لِلْمَلَـٰٓئِكَةِ","to the angels","وَإِذْ قُلْنَا","ٱسْجُدُوا۟ لِـَٔادَمَ فَسَجَدُوٓا۟",122],["2:98:5",15,"وَمَلَـٰٓئِكَتِهِۦ","and His Angels","كَانَ عَدُوًّۭا لِّلَّهِ","وَرُسُلِهِۦ وَجِبْرِيلَ وَمِيكَىٰلَ",122],["2:102:6",16,"مُلْكِ","(the) kingdom","تَتْلُوا۟ ٱلشَّيَـٰطِينُ عَلَىٰ","سُلَيْمَـٰنَ ۖ وَمَا كَفَرَ",249],["2:102:20",16,"ٱلْمَلَكَيْنِ","the two angels","وَمَآ أُنزِلَ عَلَى","بِبَابِلَ هَـٰرُوتَ وَمَـٰرُوتَ ۚ",122],["2:107:6",17,"مُلْكُ","(is the) Kingdom","أَنَّ ٱللَّهَ لَهُۥ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۗ وَمَا",249],["2:161:11",24,"وَٱلْمَلَـٰٓئِكَةِ","and the Angels","عَلَيْهِمْ لَعْنَةُ ٱللَّهِ","وَٱلنَّاسِ أَجْمَعِينَ",122],["2:177:16",27,"وَٱلْمَلَـٰٓئِكَةِ","and the Angels","بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ","وَٱلْكِتَـٰبِ وَٱلنَّبِيِّـۧنَ وَءَاتَى",122],["2:210:11",32,"وَٱلْمَلَـٰٓئِكَةُ","and the Angels","ظُلَلٍۢ مِّنَ ٱلْغَمَامِ","وَقُضِىَ ٱلْأَمْرُ ۚ وَإِلَى",122],["2:246:17",40,"مَلِكًۭا","a king","لَّهُمُ ٱبْعَثْ لَنَا","نُّقَـٰتِلْ فِى سَبِيلِ",631],["2:247:10",40,"مَلِكًۭا ۚ","(as) a king","بَعَثَ لَكُمْ طَالُوتَ","قَالُوٓا۟ أَنَّىٰ يَكُونُ",631],["2:247:15",40,"ٱلْمُلْكُ","the kingship","أَنَّىٰ يَكُونُ لَهُ","عَلَيْنَا وَنَحْنُ أَحَقُّ",249],["2:247:19",40,"بِٱلْمُلْكِ","to kingship","عَلَيْنَا وَنَحْنُ أَحَقُّ","مِنْهُ وَلَمْ يُؤْتَ",249],["2:247:38",40,"مُلْكَهُۥ","His kingdom","وَٱلْجِسْمِ ۖ وَٱللَّهُ يُؤْتِى","مَن يَشَآءُ ۚ وَٱللَّهُ",249],["2:248:6",40,"مُلْكِهِۦٓ","(of) his kingship","نَبِيُّهُمْ إِنَّ ءَايَةَ","أَن يَأْتِيَكُمُ ٱلتَّابُوتُ",249],["2:248:22",40,"ٱلْمَلَـٰٓئِكَةُ ۚ","the Angels","وَءَالُ هَـٰرُونَ تَحْمِلُهُ","إِنَّ فِى ذَٰلِكَ",122],["2:251:9",41,"ٱلْمُلْكَ","the kingdom","جَالُوتَ وَءَاتَىٰهُ ٱللَّهُ","وَٱلْحِكْمَةَ وَعَلَّمَهُۥ مِمَّا",249],["2:258:12",43,"ٱلْمُلْكَ","the kingdom","أَنْ ءَاتَىٰهُ ٱللَّهُ","إِذْ قَالَ إِبْرَٰهِـۧمُ",249],["2:285:12",49,"وَمَلَـٰٓئِكَتِهِۦ","and His Angels","كُلٌّ ءَامَنَ بِٱللَّهِ","وَكُتُبِهِۦ وَرُسُلِهِۦ لَا",122],["3:18:8",52,"وَٱلْمَلَـٰٓئِكَةُ","and (so do) the Angels","إِلَـٰهَ إِلَّا هُوَ","وَأُو۟لُوا۟ ٱلْعِلْمِ قَآئِمًۢا",122],["3:26:3",53,"مَـٰلِكَ","Owner","قُلِ ٱللَّهُمَّ","ٱلْمُلْكِ تُؤْتِى ٱلْمُلْكَ",1885],["3:26:4",53,"ٱلْمُلْكِ","(of) the Dominion","قُلِ ٱللَّهُمَّ مَـٰلِكَ","تُؤْتِى ٱلْمُلْكَ مَن",249],["3:26:6",53,"ٱلْمُلْكَ","the dominion","مَـٰلِكَ ٱلْمُلْكِ تُؤْتِى","مَن تَشَآءُ وَتَنزِعُ",249],["3:26:10",53,"ٱلْمُلْكَ","the dominion","مَن تَشَآءُ وَتَنزِعُ","مِمَّن تَشَآءُ وَتُعِزُّ",249],["3:39:2",55,"ٱلْمَلَـٰٓئِكَةُ","the Angels","فَنَادَتْهُ","وَهُوَ قَآئِمٌۭ يُصَلِّى",122],["3:42:3",55,"ٱلْمَلَـٰٓئِكَةُ","the Angels","وَإِذْ قَالَتِ","يَـٰمَرْيَمُ إِنَّ ٱللَّهَ",122],["3:45:3",55,"ٱلْمَلَـٰٓئِكَةُ","the Angels","إِذْ قَالَتِ","يَـٰمَرْيَمُ إِنَّ ٱللَّهَ",122],["3:80:5",60,"ٱلْمَلَـٰٓئِكَةَ","the Angels","يَأْمُرَكُمْ أَن تَتَّخِذُوا۟","وَٱلنَّبِيِّـۧنَ أَرْبَابًا ۗ أَيَأْمُرُكُم",122],["3:87:7",61,"وَٱلْمَلَـٰٓئِكَةِ","and the Angels","عَلَيْهِمْ لَعْنَةَ ٱللَّهِ","وَٱلنَّاسِ أَجْمَعِينَ",122],["3:124:12",66,"ٱلْمَلَـٰٓئِكَةِ","[the] Angels","بِثَلَـٰثَةِ ءَالَـٰفٍۢ مِّنَ","مُنزَلِينَ",122],["3:125:14",66,"ٱلْمَلَـٰٓئِكَةِ","[the] Angels","بِخَمْسَةِ ءَالَـٰفٍۢ مِّنَ","مُسَوِّمِينَ",122],["3:189:2",75,"مُلْكُ","(is the) dominion","وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۗ وَٱللَّهُ",249],["4:3:23",77,"مَلَكَتْ","possesses","فَوَٰحِدَةً أَوْ مَا","أَيْمَـٰنُكُمْ ۚ ذَٰلِكَ أَدْنَىٰٓ",267],["4:24:6",82,"مَلَكَتْ","you possess","ٱلنِّسَآءِ إِلَّا مَا","أَيْمَـٰنُكُمْ ۖ كِتَـٰبَ ٱللَّهِ",267],["4:25:12",82,"مَلَكَتْ","possess[ed]","ٱلْمُؤْمِنَـٰتِ فَمِن مَّا","أَيْمَـٰنُكُم مِّن فَتَيَـٰتِكُمُ",267],["4:36:23",84,"مَلَكَتْ","possess[ed]","وَٱبْنِ ٱلسَّبِيلِ وَمَا","أَيْمَـٰنُكُمْ ۗ إِنَّ ٱللَّهَ",267],["4:53:5",87,"ٱلْمُلْكِ","the Kingdom","لَهُمْ نَصِيبٌۭ مِّنَ","فَإِذًۭا لَّا يُؤْتُونَ",249],["4:54:17",87,"مُّلْكًا","a kingdom","ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ وَءَاتَيْنَـٰهُم","عَظِيمًۭا",249],["4:97:4",94,"ٱلْمَلَـٰٓئِكَةُ","the Angels","إِنَّ ٱلَّذِينَ تَوَفَّىٰهُمُ","ظَالِمِىٓ أَنفُسِهِمْ قَالُوا۟",122],["4:136:20",100,"وَمَلَـٰٓئِكَتِهِۦ","and His Angels","وَمَن يَكْفُرْ بِٱللَّهِ","وَكُتُبِهِۦ وَرُسُلِهِۦ وَٱلْيَوْمِ",122],["4:166:9",104,"وَٱلْمَلَـٰٓئِكَةُ","and the Angels","إِلَيْكَ ۖ أَنزَلَهُۥ بِعِلْمِهِۦ ۖ","يَشْهَدُونَ ۚ وَكَفَىٰ بِٱللَّهِ",122],["4:172:9",105,"ٱلْمَلَـٰٓئِكَةُ","the Angels","عَبْدًۭا لِّلَّهِ وَلَا","ٱلْمُقَرَّبُونَ ۚ وَمَن يَسْتَنكِفْ",122],["5:17:13",110,"يَمْلِكُ","has power","مَرْيَمَ ۚ قُلْ فَمَن","مِنَ ٱللَّهِ شَيْـًٔا",267],["5:17:30",110,"مُلْكُ","(is the) dominion","ٱلْأَرْضِ جَمِيعًۭا ۗ وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا",249],["5:18:24",111,"مُلْكُ","(is the) dominion","مَن يَشَآءُ ۚ وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا",249],["5:20:15",111,"مُّلُوكًۭا","kings","فِيكُمْ أَنۢبِيَآءَ وَجَعَلَكُم","وَءَاتَىٰكُم مَّا لَمْ",631],["5:25:5",112,"أَمْلِكُ","(have) power","رَبِّ إِنِّى لَآ","إِلَّا نَفْسِى وَأَخِى ۖ",267],["5:40:6",114,"مُلْكُ","(the) dominion","أَنَّ ٱللَّهَ لَهُۥ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ يُعَذِّبُ",249],["5:41:46",114,"تَمْلِكَ","will you have power","ٱللَّهُ فِتْنَتَهُۥ فَلَن","لَهُۥ مِنَ ٱللَّهِ",267],["5:76:8",120,"يَمْلِكُ","has power","ٱللَّهِ مَا لَا","لَكُمْ ضَرًّۭا وَلَا",267],["5:120:2",127,"مُلْكُ","the dominion","لِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا",249],["6:8:5",128,"مَلَكٌۭ ۖ","an Angel","لَوْلَآ أُنزِلَ عَلَيْهِ","وَلَوْ أَنزَلْنَا مَلَكًۭا",122],["6:8:8",128,"مَلَكًۭا","an Angel","مَلَكٌۭ ۖ وَلَوْ أَنزَلْنَا","لَّقُضِىَ ٱلْأَمْرُ ثُمَّ",122],["6:9:3",129,"مَلَكًۭا","an Angel","وَلَوْ جَعَلْنَـٰهُ","لَّجَعَلْنَـٰهُ رَجُلًۭا وَلَلَبَسْنَا",122],["6:50:15",133,"مَلَكٌ ۖ","an Angel","أَقُولُ لَكُمْ إِنِّى","إِنْ أَتَّبِعُ إِلَّا",122],["6:73:14",136,"ٱلْمُلْكُ","(is) the Dominion","قَوْلُهُ ٱلْحَقُّ ۚ وَلَهُ","يَوْمَ يُنفَخُ فِى",249],["6:75:4",137,"مَلَكُوتَ","the kingdom","وَكَذَٰلِكَ نُرِىٓ إِبْرَٰهِيمَ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَلِيَكُونَ",1577],["6:93:30",139,"وَٱلْمَلَـٰٓئِكَةُ","while the Angels","فِى غَمَرَٰتِ ٱلْمَوْتِ","بَاسِطُوٓا۟ أَيْدِيهِمْ أَخْرِجُوٓا۟",122],["6:111:5",142,"ٱلْمَلَـٰٓئِكَةَ","the Angels","أَنَّنَا نَزَّلْنَآ إِلَيْهِمُ","وَكَلَّمَهُمُ ٱلْمَوْتَىٰ وَحَشَرْنَا",122],["6:158:6",150,"ٱلْمَلَـٰٓئِكَةُ","the Angels","إِلَّآ أَن تَأْتِيَهُمُ","أَوْ يَأْتِىَ رَبُّكَ",122],["7:11:7",151,"لِلْمَلَـٰٓئِكَةِ","to the Angels","صَوَّرْنَـٰكُمْ ثُمَّ قُلْنَا","ٱسْجُدُوا۟ لِـَٔادَمَ فَسَجَدُوٓا۟",122],["7:20:21",152,"مَلَكَيْنِ","Angels","إِلَّآ أَن تَكُونَا","أَوْ تَكُونَا مِنَ",122],["7:158:11",170,"مُلْكُ","(is the) dominion","جَمِيعًا ٱلَّذِى لَهُۥ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ لَآ",249],["7:185:4",174,"مَلَكُوتِ","(the) dominion","أَوَلَمْ يَنظُرُوا۟ فِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا",1577],["7:188:3",175,"أَمْلِكُ","I have power","قُل لَّآ","لِنَفْسِى نَفْعًۭا وَلَا",267],["8:9:10",178,"ٱلْمَلَـٰٓئِكَةِ","the Angels","مُمِدُّكُم بِأَلْفٍۢ مِّنَ","مُرْدِفِينَ",122],["8:12:5",178,"ٱلْمَلَـٰٓئِكَةِ","the Angels","يُوحِى رَبُّكَ إِلَى","أَنِّى مَعَكُمْ فَثَبِّتُوا۟",122],["8:50:7",183,"ٱلْمَلَـٰٓئِكَةُ","the Angels","يَتَوَفَّى ٱلَّذِينَ كَفَرُوا۟ ۙ","يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبَـٰرَهُمْ",122],["9:116:4",205,"مُلْكُ","the dominion","إِنَّ ٱللَّهَ لَهُۥ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ يُحْىِۦ",249],["10:31:8",212,"يَمْلِكُ","controls","ٱلسَّمَآءِ وَٱلْأَرْضِ أَمَّن","ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ وَمَن",267],["10:49:3",214,"أَمْلِكُ","I have power","قُل لَّآ","لِنَفْسِى ضَرًّۭا وَلَا",267],["11:12:19",222,"مَلَكٌ ۚ","an Angel","أَوْ جَآءَ مَعَهُۥ","إِنَّمَآ أَنتَ نَذِيرٌۭ ۚ",122],["11:31:13",225,"مَلَكٌۭ","an Angel","وَلَآ أَقُولُ إِنِّى","وَلَآ أَقُولُ لِلَّذِينَ",122],["12:31:31",239,"مَلَكٌۭ","an angel","إِنْ هَـٰذَآ إِلَّا","كَرِيمٌۭ",122],["12:43:2",240,"ٱلْمَلِكُ","the king","وَقَالَ","إِنِّىٓ أَرَىٰ سَبْعَ",631],["12:50:2",241,"ٱلْمَلِكُ","the king","وَقَالَ","ٱئْتُونِى بِهِۦ ۖ فَلَمَّا",631],["12:54:2",242,"ٱلْمَلِكُ","the king","وَقَالَ","ٱئْتُونِى بِهِۦٓ أَسْتَخْلِصْهُ",631],["12:72:4",244,"ٱلْمَلِكِ","(of) the king","قَالُوا۟ نَفْقِدُ صُوَاعَ","وَلِمَن جَآءَ بِهِۦ",631],["12:76:20",244,"ٱلْمَلِكِ","(of) the king","أَخَاهُ فِى دِينِ","إِلَّآ أَن يَشَآءَ",631],["12:101:5",247,"ٱلْمُلْكِ","the sovereignty","قَدْ ءَاتَيْتَنِى مِنَ","وَعَلَّمْتَنِى مِن تَأْوِيلِ",249],["13:13:4",250,"وَٱلْمَلَـٰٓئِكَةُ","and the Angels","وَيُسَبِّحُ ٱلرَّعْدُ بِحَمْدِهِۦ","مِنْ خِيفَتِهِۦ وَيُرْسِلُ",122],["13:16:14",251,"يَمْلِكُونَ","they have power","دُونِهِۦٓ أَوْلِيَآءَ لَا","لِأَنفُسِهِمْ نَفْعًۭا وَلَا",267],["13:23:10",252,"وَٱلْمَلَـٰٓئِكَةُ","And the Angels","ءَابَآئِهِمْ وَأَزْوَٰجِهِمْ وَذُرِّيَّـٰتِهِمْ ۖ","يَدْخُلُونَ عَلَيْهِم مِّن",122],["15:7:4",262,"بِٱلْمَلَـٰٓئِكَةِ","the Angels","لَّوْ مَا تَأْتِينَا","إِن كُنتَ مِنَ",122],["15:8:3",262,"ٱلْمَلَـٰٓئِكَةَ","the Angels","مَا نُنَزِّلُ","إِلَّا بِٱلْحَقِّ وَمَا",122],["15:28:4",263,"لِلْمَلَـٰٓئِكَةِ","to the Angels","وَإِذْ قَالَ رَبُّكَ","إِنِّى خَـٰلِقٌۢ بَشَرًۭا",122],["15:30:2",263,"ٱلْمَلَـٰٓئِكَةُ","the Angels","فَسَجَدَ","كُلُّهُمْ أَجْمَعُونَ",122],["16:2:2",267,"ٱلْمَلَـٰٓئِكَةَ","the Angels","يُنَزِّلُ","بِٱلرُّوحِ مِنْ أَمْرِهِۦ",122],["16:28:3",270,"ٱلْمَلَـٰٓئِكَةُ","the Angels","ٱلَّذِينَ تَتَوَفَّىٰهُمُ","ظَالِمِىٓ أَنفُسِهِمْ ۖ فَأَلْقَوُا۟",122],["16:32:3",270,"ٱلْمَلَـٰٓئِكَةُ","the Angels","ٱلَّذِينَ تَتَوَفَّىٰهُمُ","طَيِّبِينَ ۙ يَقُولُونَ سَلَـٰمٌ",122],["16:33:6",270,"ٱلْمَلَـٰٓئِكَةُ","the Angels","إِلَّآ أَن تَأْتِيَهُمُ","أَوْ يَأْتِىَ أَمْرُ",122],["16:49:11",272,"وَٱلْمَلَـٰٓئِكَةُ","and the Angels","ٱلْأَرْضِ مِن دَآبَّةٍۢ","وَهُمْ لَا يَسْتَكْبِرُونَ",122],["16:71:15",274,"مَلَكَتْ","possess","رِزْقِهِمْ عَلَىٰ مَا","أَيْمَـٰنُهُمْ فَهُمْ فِيهِ",267],["16:73:7",275,"يَمْلِكُ","possesses","ٱللَّهِ مَا لَا","لَهُمْ رِزْقًۭا مِّنَ",267],["16:75:5",275,"مَّمْلُوكًۭا","(who is) owned","ٱللَّهُ مَثَلًا عَبْدًۭا","لَّا يَقْدِرُ عَلَىٰ",3917],["17:40:6",286,"ٱلْمَلَـٰٓئِكَةِ","the Angels","بِٱلْبَنِينَ وَٱتَّخَذَ مِنَ","إِنَـٰثًا ۚ إِنَّكُمْ لَتَقُولُونَ",122],["17:56:8",287,"يَمْلِكُونَ","they have power","مِّن دُونِهِۦ فَلَا","كَشْفَ ٱلضُّرِّ عَنكُمْ",267],["17:61:3",288,"لِلْمَلَـٰٓئِكَةِ","to the Angels","وَإِذْ قُلْنَا","ٱسْجُدُوا۟ لِـَٔادَمَ فَسَجَدُوٓا۟",122],["17:92:11",291,"وَٱلْمَلَـٰٓئِكَةِ","and the Angels","أَوْ تَأْتِىَ بِٱللَّهِ","قَبِيلًا",122],["17:95:6",291,"مَلَـٰٓئِكَةٌۭ","Angels","كَانَ فِى ٱلْأَرْضِ","يَمْشُونَ مُطْمَئِنِّينَ لَنَزَّلْنَا",122],["17:95:13",291,"مَلَكًۭا","an Angel","عَلَيْهِم مِّنَ ٱلسَّمَآءِ","رَّسُولًۭا",122],["17:100:4",292,"تَمْلِكُونَ","possess","قُل لَّوْ أَنتُمْ","خَزَآئِنَ رَحْمَةِ رَبِّىٓ",267],["17:111:13",293,"ٱلْمُلْكِ","the dominion","لَّهُۥ شَرِيكٌۭ فِى","وَلَمْ يَكُن لَّهُۥ",249],["18:50:3",299,"لِلْمَلَـٰٓئِكَةِ","to the Angels","وَإِذْ قُلْنَا","ٱسْجُدُوا۟ لِـَٔادَمَ فَسَجَدُوٓا۟",122],["18:79:13",302,"مَّلِكٌۭ","a king","أَعِيبَهَا وَكَانَ وَرَآءَهُم","يَأْخُذُ كُلَّ سَفِينَةٍ",631],["19:87:2",311,"يَمْلِكُونَ","they will have the power","لَّا","ٱلشَّفَـٰعَةَ إِلَّا مَنِ",267],["20:87:5",317,"بِمَلْكِنَا","by our will","مَآ أَخْلَفْنَا مَوْعِدَكَ","وَلَـٰكِنَّا حُمِّلْنَآ أَوْزَارًۭا",3682],["20:89:8",318,"يَمْلِكُ","possess","إِلَيْهِمْ قَوْلًۭا وَلَا","لَهُمْ ضَرًّۭا وَلَا",267],["20:114:3",320,"ٱلْمَلِكُ","the King","فَتَعَـٰلَى ٱللَّهُ","ٱلْحَقُّ ۗ وَلَا تَعْجَلْ",631],["20:116:3",320,"لِلْمَلَـٰٓئِكَةِ","to the Angels","وَإِذْ قُلْنَا","ٱسْجُدُوا۟ لِـَٔادَمَ فَسَجَدُوٓا۟",122],["20:120:11",320,"وَمُلْكٍۢ","and a kingdom","عَلَىٰ شَجَرَةِ ٱلْخُلْدِ","لَّا يَبْلَىٰ",249],["21:103:6",331,"ٱلْمَلَـٰٓئِكَةُ","the Angels","ٱلْفَزَعُ ٱلْأَكْبَرُ وَتَتَلَقَّىٰهُمُ","هَـٰذَا يَوْمُكُمُ ٱلَّذِى",122],["22:56:1",339,"ٱلْمُلْكُ","The Sovereignty","","يَوْمَئِذٍۢ لِّلَّهِ يَحْكُمُ",249],["22:75:4",341,"ٱلْمَلَـٰٓئِكَةِ","the Angels","ٱللَّهُ يَصْطَفِى مِنَ","رُسُلًۭا وَمِنَ ٱلنَّاسِ ۚ",122],["23:6:6",342,"مَلَكَتْ","possess","أَزْوَٰجِهِمْ أَوْ مَا","أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ",267],["23:24:20",343,"مَلَـٰٓئِكَةًۭ","Angels","شَآءَ ٱللَّهُ لَأَنزَلَ","مَّا سَمِعْنَا بِهَـٰذَا",122],["23:88:4",347,"مَلَكُوتُ","(is the) dominion","قُلْ مَنۢ بِيَدِهِۦ","كُلِّ شَىْءٍۢ وَهُوَ",1577],["23:116:3",349,"ٱلْمَلِكُ","the King","فَتَعَـٰلَى ٱللَّهُ","ٱلْحَقُّ ۖ لَآ إِلَـٰهَ",631],["24:31:46",353,"مَلَكَتْ","possess","نِسَآئِهِنَّ أَوْ مَا","أَيْمَـٰنُهُنَّ أَوِ ٱلتَّـٰبِعِينَ",267],["24:33:15",354,"مَلَكَتْ","possess","يَبْتَغُونَ ٱلْكِتَـٰبَ مِمَّا","أَيْمَـٰنُكُمْ فَكَاتِبُوهُمْ إِنْ",267],["24:42:2",355,"مُلْكُ","(the) dominion","وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ وَإِلَى",249],["24:58:6",357,"مَلَكَتْ","possess","ءَامَنُوا۟ لِيَسْتَـْٔذِنكُمُ ٱلَّذِينَ","أَيْمَـٰنُكُمْ وَٱلَّذِينَ لَمْ",267],["24:61:46",358,"مَلَكْتُم","you possess","خَـٰلَـٰتِكُمْ أَوْ مَا","مَّفَاتِحَهُۥٓ أَوْ صَدِيقِكُمْ ۚ",267],["25:2:3",359,"مُلْكُ","(the) dominion","ٱلَّذِى لَهُۥ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَلَمْ",249],["25:2:14",359,"ٱلْمُلْكِ","the dominion","لَّهُۥ شَرِيكٌۭ فِى","وَخَلَقَ كُلَّ شَىْءٍۢ",249],["25:3:11",360,"يَمْلِكُونَ","they possess","وَهُمْ يُخْلَقُونَ وَلَا","لِأَنفُسِهِمْ ضَرًّۭا وَلَا",267],["25:3:17",360,"يَمْلِكُونَ","they control","وَلَا نَفْعًۭا وَلَا","مَوْتًۭا وَلَا حَيَوٰةًۭ",267],["25:7:13",360,"مَلَكٌۭ","an Angel","لَوْلَآ أُنزِلَ إِلَيْهِ","فَيَكُونَ مَعَهُۥ نَذِيرًا",122],["25:21:9",362,"ٱلْمَلَـٰٓئِكَةُ","the Angels","لَوْلَآ أُنزِلَ عَلَيْنَا","أَوْ نَرَىٰ رَبَّنَا ۗ",122],["25:22:3",362,"ٱلْمَلَـٰٓئِكَةَ","the Angels","يَوْمَ يَرَوْنَ","لَا بُشْرَىٰ يَوْمَئِذٍۢ",122],["25:25:6",362,"ٱلْمَلَـٰٓئِكَةُ","the Angels","ٱلسَّمَآءُ بِٱلْغَمَـٰمِ وَنُزِّلَ","تَنزِيلًا",122],["25:26:1",362,"ٱلْمُلْكُ","The Sovereignty","","يَوْمَئِذٍ ٱلْحَقُّ لِلرَّحْمَـٰنِ ۚ",249],["27:23:4",379,"تَمْلِكُهُمْ","ruling them","إِنِّى وَجَدتُّ ٱمْرَأَةًۭ","وَأُوتِيَتْ مِن كُلِّ",267],["27:34:3",379,"ٱلْمُلُوكَ","the kings","قَالَتْ إِنَّ","إِذَا دَخَلُوا۟ قَرْيَةً",631],["29:17:16",398,"يَمْلِكُونَ","possess","دُونِ ٱللَّهِ لَا","لَكُمْ رِزْقًۭا فَٱبْتَغُوا۟",267],["30:28:10",407,"مَلَكَتْ","possess","لَّكُم مِّن مَّا","أَيْمَـٰنُكُم مِّن شُرَكَآءَ",267],["32:11:3",415,"مَّلَكُ","(the) Angel","۞ قُلْ يَتَوَفَّىٰكُم","ٱلْمَوْتِ ٱلَّذِى وُكِّلَ",122],["33:43:5",423,"وَمَلَـٰٓئِكَتُهُۥ","and His Angels","ٱلَّذِى يُصَلِّى عَلَيْكُمْ","لِيُخْرِجَكُم مِّنَ ٱلظُّلُمَـٰتِ",122],["33:50:11",424,"مَلَكَتْ","you rightfully possess","ءَاتَيْتَ أُجُورَهُنَّ وَمَا","يَمِينُكَ مِمَّآ أَفَآءَ",267],["33:50:52",424,"مَلَكَتْ","they rightfully possess","فِىٓ أَزْوَٰجِهِمْ وَمَا","أَيْمَـٰنُهُمْ لِكَيْلَا يَكُونَ",267],["33:52:18",425,"مَلَكَتْ","you rightfully possess","حُسْنُهُنَّ إِلَّا مَا","يَمِينُكَ ۗ وَكَانَ ٱللَّهُ",267],["33:55:20",426,"مَلَكَتْ","they rightfully possess","نِسَآئِهِنَّ وَلَا مَا","أَيْمَـٰنُهُنَّ ۗ وَٱتَّقِينَ ٱللَّهَ ۚ",267],["33:56:3",426,"وَمَلَـٰٓئِكَتَهُۥ","and His Angels","إِنَّ ٱللَّهَ","يُصَلُّونَ عَلَى ٱلنَّبِىِّ ۚ",122],["34:22:9",430,"يَمْلِكُونَ","they possess","دُونِ ٱللَّهِ ۖ لَا","مِثْقَالَ ذَرَّةٍۢ فِى",267],["34:40:6",433,"لِلْمَلَـٰٓئِكَةِ","to the Angels","جَمِيعًۭا ثُمَّ يَقُولُ","أَهَـٰٓؤُلَآءِ إِيَّاكُمْ كَانُوا۟",122],["34:42:3",433,"يَمْلِكُ","possess power","فَٱلْيَوْمَ لَا","بَعْضُكُمْ لِبَعْضٍۢ نَّفْعًۭا",267],["35:1:7",434,"ٱلْمَلَـٰٓئِكَةِ","the Angels","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ جَاعِلِ","رُسُلًا أُو۟لِىٓ أَجْنِحَةٍۢ",122],["35:13:20",436,"ٱلْمُلْكُ ۚ","(is) the Dominion","ٱللَّهُ رَبُّكُمْ لَهُ","وَٱلَّذِينَ تَدْعُونَ مِن",249],["35:13:26",436,"يَمْلِكُونَ","they possess","مِن دُونِهِۦ مَا","مِن قِطْمِيرٍ",267],["36:71:12",445,"مَـٰلِكُونَ","(are the) owners","أَنْعَـٰمًۭا فَهُمْ لَهَا","",1885],["36:83:4",445,"مَلَكُوتُ","is (the) dominion","فَسُبْحَـٰنَ ٱلَّذِى بِيَدِهِۦ","كُلِّ شَىْءٍۢ وَإِلَيْهِ",1577],["37:150:3",451,"ٱلْمَلَـٰٓئِكَةَ","the Angels","أَمْ خَلَقْنَا","إِنَـٰثًۭا وَهُمْ شَـٰهِدُونَ",122],["38:10:3",453,"مُّلْكُ","(is the) dominion","أَمْ لَهُم","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْض