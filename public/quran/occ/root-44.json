on","وَتَبَارَكَ ٱلَّذِى لَهُۥ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا",249],["43:86:2",495,"يَمْلِكُ","have power","وَلَا","ٱلَّذِينَ يَدْعُونَ مِن",267],["45:27:2",501,"مُلْكُ","(is the) dominion","وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَيَوْمَ",249],["46:8:8",503,"تَمْلِكُونَ","you have power","إِنِ ٱفْتَرَيْتُهُۥ فَلَا","لِى مِنَ ٱللَّهِ",267],["47:27:4",509,"ٱلْمَلَـٰٓئِكَةُ","the Angels","فَكَيْفَ إِذَا تَوَفَّتْهُمُ","يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبَـٰرَهُمْ",122],["48:11:19",512,"يَمْلِكُ","has power","قُلُوبِهِمْ ۚ قُلْ فَمَن","لَكُم مِّنَ ٱللَّهِ",267],["48:14:2",512,"مُلْكُ","(is the) kingdom","وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ يَغْفِرُ",249],["53:26:3",526,"مَّلَكٍۢ","(the) Angels","۞ وَكَم مِّن","فِى ٱلسَّمَـٰوَٰتِ لَا",122],["53:27:7",527,"ٱلْمَلَـٰٓئِكَةَ","the Angels","يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ لَيُسَمُّونَ","تَسْمِيَةَ ٱلْأُنثَىٰ",122],["54:55:5",531,"مَلِيكٍۢ","a King","مَقْعَدِ صِدْقٍ عِندَ","مُّقْتَدِرٍۭ",3679],["57:2:2",537,"مُلْكُ","(is the) dominion","لَهُۥ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ يُحْىِۦ",249],["57:5:2",538,"مُلْكُ","(is the) dominion","لَّهُۥ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَإِلَى",249],["59:23:8",548,"ٱلْمَلِكُ","the Sovereign","إِلَـٰهَ إِلَّا هُوَ","ٱلْقُدُّوسُ ٱلسَّلَـٰمُ ٱلْمُؤْمِنُ",631],["60:4:40",549,"أَمْلِكُ","I have power","لَأَسْتَغْفِرَنَّ لَكَ وَمَآ","لَكَ مِنَ ٱللَّهِ",267],["62:1:9",553,"ٱلْمَلِكِ","the Sovereign","وَمَا فِى ٱلْأَرْضِ","ٱلْقُدُّوسِ ٱلْعَزِيزِ ٱلْحَكِيمِ",631],["64:1:10",556,"ٱلْمُلْكُ","(is the) dominion","فِى ٱلْأَرْضِ ۖ لَهُ","وَلَهُ ٱلْحَمْدُ ۖ وَهُوَ",249],["66:4:18",560,"وَٱلْمَلَـٰٓئِكَةُ","and the Angels","وَجِبْرِيلُ وَصَـٰلِحُ ٱلْمُؤْمِنِينَ ۖ","بَعْدَ ذَٰلِكَ ظَهِيرٌ",122],["66:6:12",560,"مَلَـٰٓئِكَةٌ","(are) Angels","ٱلنَّاسُ وَٱلْحِجَارَةُ عَلَيْهَا","غِلَاظٌۭ شِدَادٌۭ لَّا",122],["67:1:4",562,"ٱلْمُلْكُ","(is) the Dominion","تَبَـٰرَكَ ٱلَّذِى بِيَدِهِ","وَهُوَ عَلَىٰ كُلِّ",249],["69:17:1",567,"وَٱلْمَلَكُ","And the Angels","","عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ",122],["70:4:2",568,"ٱلْمَلَـٰٓئِكَةُ","the Angels","تَعْرُجُ","وَٱلرُّوحُ إِلَيْهِ فِى",122],["70:30:6",569,"مَلَكَتْ","they possess","أَزْوَٰجِهِمْ أَوْ مَا","أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ",267],["72:21:4",573,"أَمْلِكُ","possess","قُلْ إِنِّى لَآ","لَكُمْ ضَرًّۭا وَلَا",267],["74:31:6",576,"مَلَـٰٓئِكَةًۭ ۙ","Angels","أَصْحَـٰبَ ٱلنَّارِ إِلَّا","وَمَا جَعَلْنَا عِدَّتَهُمْ",122],["76:20:6",579,"وَمُلْكًۭا","and a kingdom","ثَمَّ رَأَيْتَ نَعِيمًۭا","كَبِيرًا",249],["78:37:8",583,"يَمْلِكُونَ","they have power","بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا","مِنْهُ خِطَابًۭا",267],["78:38:4",583,"وَٱلْمَلَـٰٓئِكَةُ","and the Angels","يَوْمَ يَقُومُ ٱلرُّوحُ","صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ",122],["82:19:3",587,"تَمْلِكُ","will have power","يَوْمَ لَا","نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ",267],["85:9:3",590,"مُلْكُ","(is) the dominion","ٱلَّذِى لَهُۥ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ",249],["89:22:3",593,"وَٱلْمَلَكُ","and the Angels","وَجَآءَ رَبُّكَ","صَفًّۭا صَفًّۭا",122],["97:4:2",598,"ٱلْمَلَـٰٓئِكَةُ","the Angels","تَنَزَّلُ","وَٱلرُّوحُ فِيهَا بِإِذْنِ",122],["114:2:1",604,"مَلِكِ","(The) King","","ٱلنَّاسِ",631]]