[["6:125:15",144,"ضَيِّقًا","tight","يُضِلَّهُۥ يَجْعَلْ صَدْرَهُۥ","حَرَجًۭا كَأَنَّمَا يَصَّعَّدُ",2220],["9:25:16",190,"وَضَاقَتْ","and (was) straitened","تُغْنِ عَنكُمْ شَيْـًۭٔا","عَلَيْكُمُ ٱلْأَرْضُ بِمَا",1043],["9:118:7",206,"ضَاقَتْ","(was) straitened","خُلِّفُوا۟ حَتَّىٰٓ إِذَا","عَلَيْهِمُ ٱلْأَرْضُ بِمَا",1043],["9:118:12",206,"وَضَاقَتْ","And (was) straitened","ٱلْأَرْضُ بِمَا رَحُبَتْ","عَلَيْهِمْ أَنفُسُهُمْ وَظَنُّوٓا۟",1043],["11:12:7",222,"وَضَآئِقٌۢ","and straitened","مَا يُوحَىٰٓ إِلَيْكَ","بِهِۦ صَدْرُكَ أَن",3073],["11:77:7",230,"وَضَاقَ","and felt straitened","لُوطًۭا سِىٓءَ بِهِمْ","بِهِمْ ذَرْعًۭا وَقَالَ",1043],["15:97:4",267,"يَضِيقُ","(is) straitened","وَلَقَدْ نَعْلَمُ أَنَّكَ","صَدْرُكَ بِمَا يَقُولُونَ",1043],["16:127:12",281,"ضَيْقٍۢ","distress","وَلَا تَكُ فِى","مِّمَّا يَمْكُرُونَ",2219],["25:13:5",361,"ضَيِّقًۭا","narrow","أُلْقُوا۟ مِنْهَا مَكَانًۭا","مُّقَرَّنِينَ دَعَوْا۟ هُنَالِكَ",2220],["26:13:1",367,"وَيَضِيقُ","And straitens","","صَدْرِى وَلَا يَنطَلِقُ",1043],["27:70:7",383,"ضَيْقٍۢ","distress","وَلَا تَكُن فِى","مِّمَّا يَمْكُرُونَ",2219],["29:33:8",400,"وَضَاقَ","and felt straitened","لُوطًۭا سِىٓءَ بِهِمْ","بِهِمْ ذَرْعًۭا وَقَالُوا۟",1043],["65:6:9",559,"لِتُضَيِّقُوا۟","to distress","وُجْدِكُمْ وَلَا تُضَآرُّوهُنَّ","عَلَيْهِنَّ ۚ وَإِن كُنَّ",4450]]