[["2:178:9",27,"ٱلْحُرُّ","the freeman","ٱلْقِصَاصُ فِى ٱلْقَتْلَى ۖ","بِٱلْحُرِّ وَٱلْعَبْدُ بِٱلْعَبْدِ",2283],["2:178:10",27,"بِٱلْحُرِّ","for the freeman","فِى ٱلْقَتْلَى ۖ ٱلْحُرُّ","وَٱلْعَبْدُ بِٱلْعَبْدِ وَٱلْأُنثَىٰ",2283],["3:35:12",54,"مُحَرَّرًۭا","dedicated","مَا فِى بَطْنِى","فَتَقَبَّلْ مِنِّىٓ ۖ إِنَّكَ",3768],["4:92:13",93,"فَتَحْرِيرُ","then freeing","قَتَلَ مُؤْمِنًا خَطَـًۭٔا","رَقَبَةٍۢ مُّؤْمِنَةٍۢ وَدِيَةٌۭ",1398],["4:92:31",93,"فَتَحْرِيرُ","then freeing","لَّكُمْ وَهُوَ مُؤْمِنٌۭ","رَقَبَةٍۢ مُّؤْمِنَةٍۢ ۖ وَإِن",1398],["4:92:45",93,"وَتَحْرِيرُ","and freeing","مُّسَلَّمَةٌ إِلَىٰٓ أَهْلِهِۦ","رَقَبَةٍۢ مُّؤْمِنَةٍۢ ۖ فَمَن",1398],["5:89:24",122,"تَحْرِيرُ","freeing","أَوْ كِسْوَتُهُمْ أَوْ","رَقَبَةٍۢ ۖ فَمَن لَّمْ",1398],["9:81:19",200,"ٱلْحَرِّ ۗ","the heat","لَا تَنفِرُوا۟ فِى","قُلْ نَارُ جَهَنَّمَ",1781],["9:81:24",200,"حَرًّۭا ۚ","(in) heat","نَارُ جَهَنَّمَ أَشَدُّ","لَّوْ كَانُوا۟ يَفْقَهُونَ",1781],["16:81:16",276,"ٱلْحَرَّ","(from) the heat","لَكُمْ سَرَٰبِيلَ تَقِيكُمُ","وَسَرَٰبِيلَ تَقِيكُم بَأْسَكُمْ ۚ",1781],["22:23:22",334,"حَرِيرٌۭ","(will be of) silk","وَلُؤْلُؤًۭا ۖ وَلِبَاسُهُمْ فِيهَا","",1780],["35:21:4",437,"ٱلْحَرُورُ","the heat","وَلَا ٱلظِّلُّ وَلَا","",3196],["35:33:13",438,"حَرِيرٌۭ","(will be of) silk","وَلُؤْلُؤًۭا ۖ وَلِبَاسُهُمْ فِيهَا","",1780],["58:3:9",542,"فَتَحْرِيرُ","then freeing","يَعُودُونَ لِمَا قَالُوا۟","رَقَبَةٍۢ مِّن قَبْلِ",1398],["76:12:5",579,"وَحَرِيرًۭا","and silk","بِمَا صَبَرُوا۟ جَنَّةًۭ","",1780]]