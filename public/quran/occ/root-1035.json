[["9:2:1",187,"فَسِيحُوا۟","So move about","","فِى ٱلْأَرْضِ أَرْبَعَةَ",4267],["9:112:4",205,"ٱلسَّـٰٓئِحُونَ","those who go out","ٱلتَّـٰٓئِبُونَ ٱلْعَـٰبِدُونَ ٱلْحَـٰمِدُونَ","ٱلرَّٰكِعُونَ ٱلسَّـٰجِدُونَ ٱلْـَٔامِرُونَ",4292],["66:5:15",560,"سَـٰٓئِحَـٰتٍۢ","who fast","قَـٰنِتَـٰتٍۢ تَـٰٓئِبَـٰتٍ عَـٰبِدَٰتٍۢ","ثَيِّبَـٰتٍۢ وَأَبْكَارًۭا",4240]]