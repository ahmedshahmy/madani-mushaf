[["3:200:6",76,"وَرَابِطُوا۟","and [be] constant","ءَامَنُوا۟ ٱصْبِرُوا۟ وَصَابِرُوا۟","وَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ",4151],["8:11:17",178,"وَلِيَرْبِطَ","And to strengthen","عَنكُمْ رِجْزَ ٱلشَّيْطَـٰنِ","عَلَىٰ قُلُوبِكُمْ وَيُثَبِّتَ",1980],["8:60:8",184,"رِّبَاطِ","tethered","مِّن قُوَّةٍۢ وَمِن","ٱلْخَيْلِ تُرْهِبُونَ بِهِۦ",4221],["18:14:1",294,"وَرَبَطْنَا","And We made firm","","عَلَىٰ قُلُوبِهِمْ إِذْ",1980],["28:10:12",386,"رَّبَطْنَا","We strengthened","بِهِۦ لَوْلَآ أَن","عَلَىٰ قَلْبِهَا لِتَكُونَ",1980]]