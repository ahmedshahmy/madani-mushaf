[["9:60:11",196,"وَٱلْغَـٰرِمِينَ","and for those in debt","قُلُوبُهُمْ وَفِى ٱلرِّقَابِ","وَفِى سَبِيلِ ٱللَّهِ",3454],["9:98:7",202,"مَغْرَمًۭا","(as) a loss","يَتَّخِذُ مَا يُنفِقُ","وَيَتَرَبَّصُ بِكُمُ ٱلدَّوَآئِرَ ۚ",1922],["25:65:11",365,"غَرَامًا","inseparable","إِنَّ عَذَابَهَا كَانَ","",3463],["52:40:6",525,"مَّغْرَمٍۢ","a debt","أَجْرًۭا فَهُم مِّن","مُّثْقَلُونَ",1922],["56:66:2",536,"لَمُغْرَمُونَ","surely are laden with debt","إِنَّا","",3803],["68:46:6",566,"مَّغْرَمٍۢ","(the) debt","أَجْرًۭا فَهُم مِّن","مُّثْقَلُونَ",1922]]