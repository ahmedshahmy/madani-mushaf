[["2:78:2",12,"أُمِّيُّونَ","(are) unlettered ones","وَمِنْهُمْ","لَا يَعْلَمُونَ ٱلْكِتَـٰبَ",1146],["2:124:11",19,"إِمَامًۭا ۖ","a leader","إِنِّى جَاعِلُكَ لِلنَّاسِ","قَالَ وَمِن ذُرِّيَّتِى ۖ",707],["2:128:7",20,"أُمَّةًۭ","a community","لَكَ وَمِن ذُرِّيَّتِنَآ","مُّسْلِمَةًۭ لَّكَ وَأَرِنَا",188],["2:134:2",20,"أُمَّةٌۭ","(was) a community","تِلْكَ","قَدْ خَلَتْ ۖ لَهَا",188],["2:141:2",21,"أُمَّةٌۭ","(was) a community","تِلْكَ","قَدْ خَلَتْ ۖ لَهَا",188],["2:143:3",22,"أُمَّةًۭ","a community","وَكَذَٰلِكَ جَعَلْنَـٰكُمْ","وَسَطًۭا لِّتَكُونُوا۟ شُهَدَآءَ",188],["2:213:3",33,"أُمَّةًۭ","a community","كَانَ ٱلنَّاسُ","وَٰحِدَةًۭ فَبَعَثَ ٱللَّهُ",188],["3:7:10",50,"أُمُّ","the foundation","ءَايَـٰتٌۭ مُّحْكَمَـٰتٌ هُنَّ","ٱلْكِتَـٰبِ وَأُخَرُ مُتَشَـٰبِهَـٰتٌۭ ۖ",338],["3:20:13",52,"وَٱلْأُمِّيِّـۧنَ","and the unlettered people","لِّلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ","ءَأَسْلَمْتُمْ ۚ فَإِنْ أَسْلَمُوا۟",1146],["3:75:29",59,"ٱلْأُمِّيِّـۧنَ","the unlettered people","لَيْسَ عَلَيْنَا فِى","سَبِيلٌۭ وَيَقُولُونَ عَلَى",1146],["3:104:3",63,"أُمَّةٌۭ","[a] people","وَلْتَكُن مِّنكُمْ","يَدْعُونَ إِلَى ٱلْخَيْرِ",188],["3:110:3",64,"أُمَّةٍ","(of) people","كُنتُمْ خَيْرَ","أُخْرِجَتْ لِلنَّاسِ تَأْمُرُونَ",188],["3:113:6",64,"أُمَّةٌۭ","(is) a community","مِّنْ أَهْلِ ٱلْكِتَـٰبِ","قَآئِمَةٌۭ يَتْلُونَ ءَايَـٰتِ",188],["4:11:41",78,"فَلِأُمِّهِ","then for his mother","وَلَدٌۭ وَوَرِثَهُۥٓ أَبَوَاهُ","ٱلثُّلُثُ ۚ فَإِن كَانَ",338],["4:11:47",78,"فَلِأُمِّهِ","then for his mother","كَانَ لَهُۥٓ إِخْوَةٌۭ","ٱلسُّدُسُ ۚ مِنۢ بَعْدِ",338],["4:23:3",81,"أُمَّهَـٰتُكُمْ","(are) your mothers","حُرِّمَتْ عَلَيْكُمْ","وَبَنَاتُكُمْ وَأَخَوَٰتُكُمْ وَعَمَّـٰتُكُمْ",338],["4:23:12",81,"وَأُمَّهَـٰتُكُمُ","and (the) mothers","ٱلْأَخِ وَبَنَاتُ ٱلْأُخْتِ","ٱلَّـٰتِىٓ أَرْضَعْنَكُمْ وَأَخَوَٰتُكُم",338],["4:23:18",81,"وَأُمَّهَـٰتُ","and mothers","وَأَخَوَٰتُكُم مِّنَ ٱلرَّضَـٰعَةِ","نِسَآئِكُمْ وَرَبَـٰٓئِبُكُمُ ٱلَّـٰتِى",338],["4:41:6",85,"أُمَّةٍۭ","nation","جِئْنَا مِن كُلِّ","بِشَهِيدٍۢ وَجِئْنَا بِكَ",188],["5:2:16",106,"ءَآمِّينَ","(those) coming","وَلَا ٱلْقَلَـٰٓئِدَ وَلَآ","ٱلْبَيْتَ ٱلْحَرَامَ يَبْتَغُونَ",3068],["5:17:24",110,"وَأُمَّهُۥ","and his mother","ٱلْمَسِيحَ ٱبْنَ مَرْيَمَ","وَمَن فِى ٱلْأَرْضِ",338],["5:48:34",116,"أُمَّةًۭ","a community","شَآءَ ٱللَّهُ لَجَعَلَكُمْ","وَٰحِدَةًۭ وَلَـٰكِن لِّيَبْلُوَكُمْ",188],["5:66:18",119,"أُمَّةٌۭ","(is) a community","تَحْتِ أَرْجُلِهِم ۚ مِّنْهُمْ","مُّقْتَصِدَةٌۭ ۖ وَكَثِيرٌۭ مِّنْهُمْ",188],["5:75:12",120,"وَأُمُّهُۥ","And his mother","مِن قَبْلِهِ ٱلرُّسُلُ","صِدِّيقَةٌۭ ۖ كَانَا يَأْكُلَانِ",338],["5:116:11",127,"وَأُمِّىَ","and my mother","قُلْتَ لِلنَّاسِ ٱتَّخِذُونِى","إِلَـٰهَيْنِ مِن دُونِ",338],["6:38:11",132,"أُمَمٌ","(are) communities","يَطِيرُ بِجَنَاحَيْهِ إِلَّآ","أَمْثَالُكُم ۚ مَّا فَرَّطْنَا",188],["6:42:4",132,"أُمَمٍۢ","nations","وَلَقَدْ أَرْسَلْنَآ إِلَىٰٓ","مِّن قَبْلِكَ فَأَخَذْنَـٰهُم",188],["6:92:10",139,"أُمَّ","(the) mother","بَيْنَ يَدَيْهِ وَلِتُنذِرَ","ٱلْقُرَىٰ وَمَنْ حَوْلَهَا ۚ",338],["6:108:16",141,"أُمَّةٍ","community","كَذَٰلِكَ زَيَّنَّا لِكُلِّ","عَمَلَهُمْ ثُمَّ إِلَىٰ",188],["7:34:2",154,"أُمَّةٍ","nation","وَلِكُلِّ","أَجَلٌۭ ۖ فَإِذَا جَآءَ",188],["7:38:4",155,"أُمَمٍۢ","(the) nations","قَالَ ٱدْخُلُوا۟ فِىٓ","قَدْ خَلَتْ مِن",188],["7:38:16",155,"أُمَّةٌۭ","a nation","ٱلنَّارِ ۖ كُلَّمَا دَخَلَتْ","لَّعَنَتْ أُخْتَهَا ۖ حَتَّىٰٓ",188],["7:150:25",169,"أُمَّ","(of) my mother","إِلَيْهِ ۚ قَالَ ٱبْنَ","إِنَّ ٱلْقَوْمَ ٱسْتَضْعَفُونِى",338],["7:157:5",170,"ٱلْأُمِّىَّ","the unlettered","يَتَّبِعُونَ ٱلرَّسُولَ ٱلنَّبِىَّ","ٱلَّذِى يَجِدُونَهُۥ مَكْتُوبًا",1146],["7:158:24",170,"ٱلْأُمِّىِّ","the unlettered","بِٱللَّهِ وَرَسُولِهِ ٱلنَّبِىِّ","ٱلَّذِى يُؤْمِنُ بِٱللَّهِ",1146],["7:159:4",170,"أُمَّةٌۭ","(is) a community","وَمِن قَوْمِ مُوسَىٰٓ","يَهْدُونَ بِٱلْحَقِّ وَبِهِۦ",188],["7:160:5",171,"أُمَمًۭا ۚ","(as) communities","ٱثْنَتَىْ عَشْرَةَ أَسْبَاطًا","وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ",188],["7:164:3",172,"أُمَّةٌۭ","a community","وَإِذْ قَالَتْ","مِّنْهُمْ لِمَ تَعِظُونَ",188],["7:168:4",172,"أُمَمًۭا ۖ","(as) nations","وَقَطَّعْنَـٰهُمْ فِى ٱلْأَرْضِ","مِّنْهُمُ ٱلصَّـٰلِحُونَ وَمِنْهُمْ",188],["7:181:3",174,"أُمَّةٌۭ","(is) a nation","وَمِمَّنْ خَلَقْنَآ","يَهْدُونَ بِٱلْحَقِّ وَبِهِۦ",188],["9:12:11",188,"أَئِمَّةَ","the leaders","فِى دِينِكُمْ فَقَـٰتِلُوٓا۟","ٱلْكُفْرِ ۙ إِنَّهُمْ لَآ",707],["10:19:5",210,"أُمَّةًۭ","a community","كَانَ ٱلنَّاسُ إِلَّآ","وَٰحِدَةًۭ فَٱخْتَلَفُوا۟ ۚ وَلَوْلَا",188],["10:47:2",214,"أُمَّةٍۢ","nation","وَلِكُلِّ","رَّسُولٌۭ ۖ فَإِذَا جَآءَ",188],["10:49:13",214,"أُمَّةٍ","nation","شَآءَ ٱللَّهُ ۗ لِكُلِّ","أَجَلٌ ۚ إِذَا جَآءَ",188],["11:8:6",222,"أُمَّةٍۢ","a time","عَنْهُمُ ٱلْعَذَابَ إِلَىٰٓ","مَّعْدُودَةٍۢ لَّيَقُولُنَّ مَا",188],["11:17:14",223,"إِمَامًۭا","(as) a guide","قَبْلِهِۦ كِتَـٰبُ مُوسَىٰٓ","وَرَحْمَةً ۚ أُو۟لَـٰٓئِكَ يُؤْمِنُونَ",707],["11:48:9",227,"أُمَمٍۢ","the nations","وَبَرَكَـٰتٍ عَلَيْكَ وَعَلَىٰٓ","مِّمَّن مَّعَكَ ۚ وَأُمَمٌۭ",188],["11:48:12",227,"وَأُمَمٌۭ","But (to other) nations","أُمَمٍۢ مِّمَّن مَّعَكَ ۚ","سَنُمَتِّعُهُمْ ثُمَّ يَمَسُّهُم",188],["11:118:6",235,"أُمَّةًۭ","one community","رَبُّكَ لَجَعَلَ ٱلنَّاسَ","وَٰحِدَةًۭ ۖ وَلَا يَزَالُونَ",188],["12:45:7",241,"أُمَّةٍ","a period","مِنْهُمَا وَٱدَّكَرَ بَعْدَ","أَنَا۠ أُنَبِّئُكُم بِتَأْوِيلِهِۦ",188],["13:30:4",253,"أُمَّةٍۢ","a nation","كَذَٰلِكَ أَرْسَلْنَـٰكَ فِىٓ","قَدْ خَلَتْ مِن",188],["13:30:9",253,"أُمَمٌۭ","nations","خَلَتْ مِن قَبْلِهَآ","لِّتَتْلُوَا۟ عَلَيْهِمُ ٱلَّذِىٓ",188],["13:39:7",254,"أُمُّ","(is) the Mother (of) the Book","يَشَآءُ وَيُثْبِتُ ۖ وَعِندَهُۥٓ","ٱلْكِتَـٰبِ",338],["15:5:4",262,"أُمَّةٍ","nation","مَّا تَسْبِقُ مِنْ","أَجَلَهَا وَمَا يَسْتَـْٔخِرُونَ",188],["15:79:4",266,"لَبِإِمَامٍۢ","(were) on a highway","فَٱنتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا","مُّبِينٍۢ",707],["16:36:5",271,"أُمَّةٍۢ","nation","بَعَثْنَا فِى كُلِّ","رَّسُولًا أَنِ ٱعْبُدُوا۟",188],["16:63:5",273,"أُمَمٍۢ","nations","لَقَدْ أَرْسَلْنَآ إِلَىٰٓ","مِّن قَبْلِكَ فَزَيَّنَ",188],["16:78:5",275,"أُمَّهَـٰتِكُمْ","(of) your mothers","أَخْرَجَكُم مِّنۢ بُطُونِ","لَا تَعْلَمُونَ شَيْـًۭٔا",338],["16:84:5",276,"أُمَّةٍۢ","nation","نَبْعَثُ مِن كُلِّ","شَهِيدًۭا ثُمَّ لَا",188],["16:89:5",277,"أُمَّةٍۢ","nation","نَبْعَثُ فِى كُلِّ","شَهِيدًا عَلَيْهِم مِّنْ",188],["16:92:16",277,"أُمَّةٌ","a community","بَيْنَكُمْ أَن تَكُونَ","هِىَ أَرْبَىٰ مِنْ",188],["16:92:20",277,"أُمَّةٍ ۚ","(another) community","هِىَ أَرْبَىٰ مِنْ","إِنَّمَا يَبْلُوكُمُ ٱللَّهُ",188],["16:93:5",277,"أُمَّةًۭ","a nation","شَآءَ ٱللَّهُ لَجَعَلَكُمْ","وَٰحِدَةًۭ وَلَـٰكِن يُضِلُّ",188],["16:120:4",281,"أُمَّةًۭ","a nation","إِنَّ إِبْرَٰهِيمَ كَانَ","قَانِتًۭا لِّلَّهِ حَنِيفًۭا",188],["17:71:5",289,"بِإِمَـٰمِهِمْ ۖ","with their record","نَدْعُوا۟ كُلَّ أُنَاسٍۭ","فَمَنْ أُوتِىَ كِتَـٰبَهُۥ",707],["19:28:10",307,"أُمُّكِ","your mother","سَوْءٍۢ وَمَا كَانَتْ","بَغِيًّۭا",338],["20:38:4",314,"أُمِّكَ","your mother","إِذْ أَوْحَيْنَآ إِلَىٰٓ","مَا يُوحَىٰٓ",338],["20:40:12",314,"أُمِّكَ","your mother","يَكْفُلُهُۥ ۖ فَرَجَعْنَـٰكَ إِلَىٰٓ","كَىْ تَقَرَّ عَيْنُهَا",338],["21:73:2",328,"أَئِمَّةًۭ","leaders","وَجَعَلْنَـٰهُمْ","يَهْدُونَ بِأَمْرِنَا وَأَوْحَيْنَآ",707],["21:92:3",330,"أُمَّتُكُمْ","(is) your religion","إِنَّ هَـٰذِهِۦٓ","أُمَّةًۭ وَٰحِدَةًۭ وَأَنَا۠",188],["21:92:4",330,"أُمَّةًۭ","religion","إِنَّ هَـٰذِهِۦٓ أُمَّتُكُمْ","وَٰحِدَةًۭ وَأَنَا۠ رَبُّكُمْ",188],["22:34:2",336,"أُمَّةٍۢ","nation","وَلِكُلِّ","جَعَلْنَا مَنسَكًۭا لِّيَذْكُرُوا۟",188],["22:67:2",340,"أُمَّةٍۢ","nation","لِّكُلِّ","جَعَلْنَا مَنسَكًا هُمْ",188],["23:43:4",345,"أُمَّةٍ","nation","مَا تَسْبِقُ مِنْ","أَجَلَهَا وَمَا يَسْتَـْٔخِرُونَ",188],["23:44:8",345,"أُمَّةًۭ","(to) a nation","كُلَّ مَا جَآءَ","رَّسُولُهَا كَذَّبُوهُ ۚ فَأَتْبَعْنَا",188],["23:50:4",345,"وَأُمَّهُۥٓ","and his mother","وَجَعَلْنَا ٱبْنَ مَرْيَمَ","ءَايَةًۭ وَءَاوَيْنَـٰهُمَآ إِلَىٰ",338],["23:52:3",345,"أُمَّتُكُمْ","your religion","وَإِنَّ هَـٰذِهِۦٓ","أُمَّةًۭ وَٰحِدَةًۭ وَأَنَا۠",188],["23:52:4",345,"أُمَّةًۭ","(is) religion","وَإِنَّ هَـٰذِهِۦٓ أُمَّتُكُمْ","وَٰحِدَةًۭ وَأَنَا۠ رَبُّكُمْ",188],["24:61:25",358,"أُمَّهَـٰتِكُمْ","(of) your mothers","ءَابَآئِكُمْ أَوْ بُيُوتِ","أَوْ بُيُوتِ إِخْوَٰنِكُمْ",338],["25:74:13",366,"إِمَامًا","a leader","أَعْيُنٍۢ وَٱجْعَلْنَا لِلْمُتَّقِينَ","",707],["27:83:5",384,"أُمَّةٍۢ","nation","نَحْشُرُ مِن كُلِّ","فَوْجًۭا مِّمَّن يُكَذِّبُ",188],["28:5:10",385,"أَئِمَّةًۭ","leaders","فِى ٱلْأَرْضِ وَنَجْعَلَهُمْ","وَنَجْعَلَهُمُ ٱلْوَٰرِثِينَ",707],["28:7:3",386,"أُمِّ","(the) mother","وَأَوْحَيْنَآ إِلَىٰٓ","مُوسَىٰٓ أَنْ أَرْضِعِيهِ ۖ",338],["28:10:3",386,"أُمِّ","(of the) mother","وَأَصْبَحَ فُؤَادُ","مُوسَىٰ فَـٰرِغًا ۖ إِن",338],["28:13:3",386,"أُمِّهِۦ","his mother","فَرَدَدْنَـٰهُ إِلَىٰٓ","كَىْ تَقَرَّ عَيْنُهَا",338],["28:23:7",388,"أُمَّةًۭ","a group","مَدْيَنَ وَجَدَ عَلَيْهِ","مِّنَ ٱلنَّاسِ يَسْقُونَ",188],["28:41:2",390,"أَئِمَّةًۭ","leaders","وَجَعَلْنَـٰهُمْ","يَدْعُونَ إِلَى ٱلنَّارِ ۖ",707],["28:59:9",392,"أُمِّهَا","their mother (town)","حَتَّىٰ يَبْعَثَ فِىٓ","رَسُولًۭا يَتْلُوا۟ عَلَيْهِمْ",338],["28:75:4",394,"أُمَّةٍۢ","nation","وَنَزَعْنَا مِن كُلِّ","شَهِيدًۭا فَقُلْنَا هَاتُوا۟",188],["29:18:5",398,"أُمَمٌۭ","(the) nations","تُكَذِّبُوا۟ فَقَدْ كَذَّبَ","مِّن قَبْلِكُمْ ۖ وَمَا",188],["31:14:5",412,"أُمُّهُۥ","his mother","ٱلْإِنسَـٰنَ بِوَٰلِدَيْهِ حَمَلَتْهُ","وَهْنًا عَلَىٰ وَهْنٍۢ",338],["32:24:3",417,"أَئِمَّةًۭ","leaders","وَجَعَلْنَا مِنْهُمْ","يَهْدُونَ بِأَمْرِنَا لَمَّا",707],["33:4:15",418,"أُمَّهَـٰتِكُمْ ۚ","(as) your mothers","ٱلَّـٰٓـِٔى تُظَـٰهِرُونَ مِنْهُنَّ","وَمَا جَعَلَ أَدْعِيَآءَكُمْ",338],["33:6:7",418,"أُمَّهَـٰتُهُمْ ۗ","(are) their mothers","مِنْ أَنفُسِهِمْ ۖ وَأَزْوَٰجُهُۥٓ","وَأُو۟لُوا۟ ٱلْأَرْحَامِ بَعْضُهُمْ",338],["35:24:8",437,"أُمَّةٍ","nation","وَنَذِيرًۭا ۚ وَإِن مِّنْ","إِلَّا خَلَا فِيهَا",188],["35:42:12",439,"ٱلْأُمَمِ ۖ","(of) the nations","أَهْدَىٰ مِنْ إِحْدَى","فَلَمَّا جَآءَهُمْ نَذِيرٌۭ",188],["36:12:13",440,"إِمَامٍۢ","a Register","شَىْءٍ أَحْصَيْنَـٰهُ فِىٓ","مُّبِينٍۢ",707],["39:6:18",459,"أُمَّهَـٰتِكُمْ","(of) your mothers","يَخْلُقُكُمْ فِى بُطُونِ","خَلْقًۭا مِّنۢ بَعْدِ",338],["40:5:10",467,"أُمَّةٍۭ","nation","بَعْدِهِمْ ۖ وَهَمَّتْ كُلُّ","بِرَسُولِهِمْ لِيَأْخُذُوهُ ۖ وَجَـٰدَلُوا۟",188],["41:25:15",479,"أُمَمٍۢ","nations","عَلَيْهِمُ ٱلْقَوْلُ فِىٓ","قَدْ خَلَتْ مِن",188],["42:7:7",483,"أُمَّ","(the) mother","قُرْءَانًا عَرَبِيًّۭا لِّتُنذِرَ","ٱلْقُرَىٰ وَمَنْ حَوْلَهَا",338],["42:8:5",483,"أُمَّةًۭ","a community","شَآءَ ٱللَّهُ لَجَعَلَهُمْ","وَٰحِدَةًۭ وَلَـٰكِن يُدْخِلُ",188],["43:4:3",489,"أُمِّ","(the) Mother","وَإِنَّهُۥ فِىٓ","ٱلْكِتَـٰبِ لَدَيْنَا لَعَلِىٌّ",338],["43:22:7",490,"أُمَّةٍۢ","a religion","وَجَدْنَآ ءَابَآءَنَا عَلَىٰٓ","وَإِنَّا عَلَىٰٓ ءَاثَـٰرِهِم",188],["43:23:17",491,"أُمَّةٍۢ","a religion","وَجَدْنَآ ءَابَآءَنَا عَلَىٰٓ","وَإِنَّا عَلَىٰٓ ءَاثَـٰرِهِم",188],["43:33:5",491,"أُمَّةًۭ","a community","أَن يَكُونَ ٱلنَّاسُ","وَٰحِدَةًۭ لَّجَعَلْنَا لِمَن",188],["45:28:3",501,"أُمَّةٍۢ","nation","وَتَرَىٰ كُلَّ","جَاثِيَةًۭ ۚ كُلُّ أُمَّةٍۢ",188],["45:28:6",501,"أُمَّةٍۢ","nation","أُمَّةٍۢ جَاثِيَةًۭ ۚ كُلُّ","تُدْعَىٰٓ إِلَىٰ كِتَـٰبِهَا",188],["46:12:5",503,"إِمَامًۭا","(as) a guide","قَبْلِهِۦ كِتَـٰبُ مُوسَىٰٓ","وَرَحْمَةًۭ ۚ وَهَـٰذَا كِتَـٰبٌۭ",707],["46:15:6",504,"أُمُّهُۥ","his mother","بِوَٰلِدَيْهِ إِحْسَـٰنًا ۖ حَمَلَتْهُ","كُرْهًۭا وَوَضَعَتْهُ كُرْهًۭا ۖ",338],["46:18:7",504,"أُمَمٍۢ","nations","عَلَيْهِمُ ٱلْقَوْلُ فِىٓ","قَدْ خَلَتْ مِن",188],["53:32:24",527,"أُمَّهَـٰتِكُمْ ۖ","(of) your mothers","أَجِنَّةٌۭ فِى بُطُونِ","فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ",338],["58:2:8",542,"أُمَّهَـٰتِهِمْ ۖ","(are) their mothers","نِّسَآئِهِم مَّا هُنَّ","إِنْ أُمَّهَـٰتُهُمْ إِلَّا",338],["58:2:10",542,"أُمَّهَـٰتُهُمْ","(are) their mothers","هُنَّ أُمَّهَـٰتِهِمْ ۖ إِنْ","إِلَّا ٱلَّـٰٓـِٔى وَلَدْنَهُمْ ۚ",338],["62:2:5",553,"ٱلْأُمِّيِّـۧنَ","the unlettered","ٱلَّذِى بَعَثَ فِى","رَسُولًۭا مِّنْهُمْ يَتْلُوا۟",1146],["75:5:5",577,"أَمَامَهُۥ","(to) what is before him","يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ","",3009],["80:35:1",585,"وَأُمِّهِۦ","And his mother","","وَأَبِيهِ",338],["101:9:1",600,"فَأُمُّهُۥ","His abode","","هَاوِيَةٌۭ",338]]