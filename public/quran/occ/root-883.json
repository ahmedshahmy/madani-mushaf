[["34:7:10",428,"مُزِّقْتُمْ","you have disintegrated","رَجُلٍۢ يُنَبِّئُكُمْ إِذَا","كُلَّ مُمَزَّقٍ إِنَّكُمْ",2514],["34:7:12",428,"مُمَزَّقٍ","disintegration","إِذَا مُزِّقْتُمْ كُلَّ","إِنَّكُمْ لَفِى خَلْقٍۢ",2495],["34:19:10",430,"وَمَزَّقْنَـٰهُمْ","and We dispersed them","أَنفُسَهُمْ فَجَعَلْنَـٰهُمْ أَحَادِيثَ","كُلَّ مُمَزَّقٍ ۚ إِنَّ",2514],["34:19:12",430,"مُمَزَّقٍ ۚ","dispersion","أَحَادِيثَ وَمَزَّقْنَـٰهُمْ كُلَّ","إِنَّ فِى ذَٰلِكَ",2495]]