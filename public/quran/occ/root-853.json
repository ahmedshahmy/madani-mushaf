[["7:18:5",152,"مَّدْحُورًۭا ۖ","and expelled","ٱخْرُجْ مِنْهَا مَذْءُومًۭا","لَّمَن تَبِعَكَ مِنْهُمْ",1921],["17:18:18",284,"مَّدْحُورًۭا","rejected","جَهَنَّمَ يَصْلَىٰهَا مَذْمُومًۭا","",1921],["17:39:18",286,"مَّدْحُورًا","abandoned","فِى جَهَنَّمَ مَلُومًۭا","",1921],["37:9:1",446,"دُحُورًۭا ۖ","Repelled","","وَلَهُمْ عَذَابٌۭ وَاصِبٌ",3384]]