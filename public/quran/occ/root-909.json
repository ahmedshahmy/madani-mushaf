[["20:85:9",317,"ٱلسَّامِرِىُّ","the Samiri","مِنۢ بَعْدِكَ وَأَضَلَّهُمُ","",1998],["20:87:15",317,"ٱلسَّامِرِىُّ","the Samiri","فَقَذَفْنَـٰهَا فَكَذَٰلِكَ أَلْقَى","",1998],["20:95:4",318,"يَـٰسَـٰمِرِىُّ","O Samiri","قَالَ فَمَا خَطْبُكَ","",1998],["23:67:3",346,"سَـٰمِرًۭا","conversing by night","مُسْتَكْبِرِينَ بِهِۦ","تَهْجُرُونَ",4244]]