[["3:153:14",69,"لِّكَيْلَا","so that not","فَأَثَـٰبَكُمْ غَمًّۢا بِغَمٍّۢ","تَحْزَنُوا۟ عَلَىٰ مَا",839],["16:70:11",274,"لِكَىْ","so that","إِلَىٰٓ أَرْذَلِ ٱلْعُمُرِ","لَا يَعْلَمَ بَعْدَ",839],["20:33:1",313,"كَىْ","That","","نُسَبِّحَكَ كَثِيرًۭا",839],["20:40:13",314,"كَىْ","that","فَرَجَعْنَـٰكَ إِلَىٰٓ أُمِّكَ","تَقَرَّ عَيْنُهَا وَلَا",839],["22:5:50",332,"لِكَيْلَا","so that not","إِلَىٰٓ أَرْذَلِ ٱلْعُمُرِ","يَعْلَمَ مِنۢ بَعْدِ",839],["28:13:4",386,"كَىْ","that","فَرَدَدْنَـٰهُ إِلَىٰٓ أُمِّهِۦ","تَقَرَّ عَيْنُهَا وَلَا",839],["33:37:32",423,"لِكَىْ","so that","مِّنْهَا وَطَرًۭا زَوَّجْنَـٰكَهَا","لَا يَكُونَ عَلَى",839],["33:50:54",424,"لِكَيْلَا","that not","وَمَا مَلَكَتْ أَيْمَـٰنُهُمْ","يَكُونَ عَلَيْكَ حَرَجٌۭ ۗ",839],["57:23:1",540,"لِّكَيْلَا","So that you may not","","تَأْسَوْا۟ عَلَىٰ مَا",839],["59:7:17",546,"كَىْ","that","وَٱلْمَسَـٰكِينِ وَٱبْنِ ٱلسَّبِيلِ","لَا يَكُونَ دُولَةًۢ",839]]