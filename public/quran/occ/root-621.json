[["4:112:7",96,"يَرْمِ","throws","أَوْ إِثْمًۭا ثُمَّ","بِهِۦ بَرِيٓـًۭٔا فَقَدِ",919],["8:17:7",179,"رَمَيْتَ","you threw","ٱللَّهَ قَتَلَهُمْ ۚ وَمَا","إِذْ رَمَيْتَ وَلَـٰكِنَّ",919],["8:17:9",179,"رَمَيْتَ","you threw","وَمَا رَمَيْتَ إِذْ","وَلَـٰكِنَّ ٱللَّهَ رَمَىٰ ۚ",919],["8:17:12",179,"رَمَىٰ ۚ","threw","رَمَيْتَ وَلَـٰكِنَّ ٱللَّهَ","وَلِيُبْلِىَ ٱلْمُؤْمِنِينَ مِنْهُ",919],["24:4:2",350,"يَرْمُونَ","accuse","وَٱلَّذِينَ","ٱلْمُحْصَنَـٰتِ ثُمَّ لَمْ",919],["24:6:2",350,"يَرْمُونَ","accuse","وَٱلَّذِينَ","أَزْوَٰجَهُمْ وَلَمْ يَكُن",919],["24:23:3",352,"يَرْمُونَ","accuse","إِنَّ ٱلَّذِينَ","ٱلْمُحْصَنَـٰتِ ٱلْغَـٰفِلَـٰتِ ٱلْمُؤْمِنَـٰتِ",919],["77:32:2",581,"تَرْمِى","throws up","إِنَّهَا","بِشَرَرٍۢ كَٱلْقَصْرِ",919],["105:4:1",601,"تَرْمِيهِم","Striking them","","بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ",919]]