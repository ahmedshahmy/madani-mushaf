[["2:15:7",3,"يَعْمَهُونَ","they wander blindly","وَيَمُدُّهُمْ فِى طُغْيَـٰنِهِمْ","",1113],["6:110:13",141,"يَعْمَهُونَ","wandering blindly","وَنَذَرُهُمْ فِى طُغْيَـٰنِهِمْ","",1113],["7:186:10",174,"يَعْمَهُونَ","wandering blindly","وَيَذَرُهُمْ فِى طُغْيَـٰنِهِمْ","",1113],["10:11:18",209,"يَعْمَهُونَ","wandering blindly","لِقَآءَنَا فِى طُغْيَـٰنِهِمْ","",1113],["15:72:5",266,"يَعْمَهُونَ","wandering blindly","إِنَّهُمْ لَفِى سَكْرَتِهِمْ","",1113],["23:75:11",347,"يَعْمَهُونَ","wandering blindly","لَّلَجُّوا۟ فِى طُغْيَـٰنِهِمْ","",1113],["27:4:10",377,"يَعْمَهُونَ","wander blindly","لَهُمْ أَعْمَـٰلَهُمْ فَهُمْ","",1113]]