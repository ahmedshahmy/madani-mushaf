[["2:130:11",20,"ٱصْطَفَيْنَـٰهُ","We chose him","سَفِهَ نَفْسَهُۥ ۚ وَلَقَدِ","فِى ٱلدُّنْيَا ۖ وَإِنَّهُۥ",754],["2:132:9",20,"ٱصْطَفَىٰ","has chosen","يَـٰبَنِىَّ إِنَّ ٱللَّهَ","لَكُمُ ٱلدِّينَ فَلَا",754],["2:247:29",40,"ٱصْطَفَىٰهُ","has chosen him","قَالَ إِنَّ ٱللَّهَ","عَلَيْكُمْ وَزَادَهُۥ بَسْطَةًۭ",754],["2:264:21",44,"صَفْوَانٍ","(that of a) smooth rock","ٱلْـَٔاخِرِ ۖ فَمَثَلُهُۥ كَمَثَلِ","عَلَيْهِ تُرَابٌۭ فَأَصَابَهُۥ",3244],["3:33:3",54,"ٱصْطَفَىٰٓ","chose","۞ إِنَّ ٱللَّهَ","ءَادَمَ وَنُوحًۭا وَءَالَ",754],["3:42:7",55,"ٱصْطَفَىٰكِ","(has) chosen you","يَـٰمَرْيَمُ إِنَّ ٱللَّهَ","وَطَهَّرَكِ وَٱصْطَفَىٰكِ عَلَىٰ",754],["3:42:9",55,"وَٱصْطَفَىٰكِ","and chosen you","ٱللَّهَ ٱصْطَفَىٰكِ وَطَهَّرَكِ","عَلَىٰ نِسَآءِ ٱلْعَـٰلَمِينَ",754],["7:144:4",168,"ٱصْطَفَيْتُكَ","have chosen you","قَالَ يَـٰمُوسَىٰٓ إِنِّى","عَلَى ٱلنَّاسِ بِرِسَـٰلَـٰتِى",754],["17:40:1",286,"أَفَأَصْفَىٰكُمْ","Then has your Lord chosen (for) you","","رَبُّكُم بِٱلْبَنِينَ وَٱتَّخَذَ",2163],["22:75:2",341,"يَصْطَفِى","chooses","ٱللَّهُ","مِنَ ٱلْمَلَـٰٓئِكَةِ رُسُلًۭا",754],["27:59:8",382,"ٱصْطَفَىٰٓ ۗ","He has chosen","عَلَىٰ عِبَادِهِ ٱلَّذِينَ","ءَآللَّهُ خَيْرٌ أَمَّا",754],["35:32:5",438,"ٱصْطَفَيْنَا","We have chosen","أَوْرَثْنَا ٱلْكِتَـٰبَ ٱلَّذِينَ","مِنْ عِبَادِنَا ۖ فَمِنْهُمْ",754],["37:153:1",451,"أَصْطَفَى","Has He chosen","","ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ",754],["38:47:4",456,"ٱلْمُصْطَفَيْنَ","the chosen ones","وَإِنَّهُمْ عِندَنَا لَمِنَ","ٱلْأَخْيَارِ",3775],["39:4:7",458,"لَّٱصْطَفَىٰ","surely, He (could) have chosen","أَن يَتَّخِذَ وَلَدًۭا","مِمَّا يَخْلُقُ مَا",754],["43:16:6",490,"وَأَصْفَىٰكُم","and He has chosen (for) you","مِمَّا يَخْلُقُ بَنَاتٍۢ","بِٱلْبَنِينَ",2163],["47:15:26",508,"مُّصَفًّۭى ۖ","purified","وَأَنْهَـٰرٌۭ مِّنْ عَسَلٍۢ","وَلَهُمْ فِيهَا مِن",3959]]