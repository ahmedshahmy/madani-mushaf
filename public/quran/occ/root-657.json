[["2:7:1",3,"خَتَمَ","Has set a seal","","ٱللَّهُ عَلَىٰ قُلُوبِهِمْ",1420],["6:46:8",133,"وَخَتَمَ","and sealed","ٱللَّهُ سَمْعَكُمْ وَأَبْصَـٰرَكُمْ","عَلَىٰ قُلُوبِكُم مَّنْ",1420],["33:40:11",423,"وَخَاتَمَ","and Seal","وَلَـٰكِن رَّسُولَ ٱللَّهِ","ٱلنَّبِيِّـۧنَ ۗ وَكَانَ ٱللَّهُ",4559],["36:65:2",444,"نَخْتِمُ","We will seal","ٱلْيَوْمَ","عَلَىٰٓ أَفْوَٰهِهِمْ وَتُكَلِّمُنَآ",1420],["42:24:10",486,"يَخْتِمْ","He would seal","فَإِن يَشَإِ ٱللَّهُ","عَلَىٰ قَلْبِكَ ۗ وَيَمْحُ",1420],["45:23:10",501,"وَخَتَمَ","and He sets a seal","ٱللَّهُ عَلَىٰ عِلْمٍۢ","عَلَىٰ سَمْعِهِۦ وَقَلْبِهِۦ",1420],["83:25:4",588,"مَّخْتُومٍ","sealed","يُسْقَوْنَ مِن رَّحِيقٍۢ","",3944],["83:26:1",588,"خِتَـٰمُهُۥ","Its seal","","مِسْكٌۭ ۚ وَفِى ذَٰلِكَ",4584]]