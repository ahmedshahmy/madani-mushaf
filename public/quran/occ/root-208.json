[["2:74:31",11,"خَشْيَةِ","fear","لَمَا يَهْبِطُ مِنْ","ٱللَّهِ ۗ وَمَا ٱللَّهُ",1007],["2:150:25",23,"تَخْشَوْهُمْ","fear them","ظَلَمُوا۟ مِنْهُمْ فَلَا","وَٱخْشَوْنِى وَلِأُتِمَّ نِعْمَتِى",294],["2:150:26",23,"وَٱخْشَوْنِى","but fear Me","مِنْهُمْ فَلَا تَخْشَوْهُمْ","وَلِأُتِمَّ نِعْمَتِى عَلَيْكُمْ",294],["3:173:10",72,"فَٱخْشَوْهُمْ","so fear them","قَدْ جَمَعُوا۟ لَكُمْ","فَزَادَهُمْ إِيمَـٰنًۭا وَقَالُوا۟",294],["4:9:1",78,"وَلْيَخْشَ","And let fear","","ٱلَّذِينَ لَوْ تَرَكُوا۟",294],["4:25:49",82,"خَشِىَ","fears","ٱلْعَذَابِ ۚ ذَٰلِكَ لِمَنْ","ٱلْعَنَتَ مِنكُمْ ۚ وَأَن",294],["4:77:20",90,"يَخْشَوْنَ","[they] fear","إِذَا فَرِيقٌۭ مِّنْهُمْ","ٱلنَّاسَ كَخَشْيَةِ ٱللَّهِ",294],["4:77:22",90,"كَخَشْيَةِ","as (they) fear","مِّنْهُمْ يَخْشَوْنَ ٱلنَّاسَ","ٱللَّهِ أَوْ أَشَدَّ",1007],["4:77:26",90,"خَشْيَةًۭ ۚ","fear","ٱللَّهِ أَوْ أَشَدَّ","وَقَالُوا۟ رَبَّنَا لِمَ",1007],["5:3:38",107,"تَخْشَوْهُمْ","fear them","مِن دِينِكُمْ فَلَا","وَٱخْشَوْنِ ۚ ٱلْيَوْمَ أَكْمَلْتُ",294],["5:3:39",107,"وَٱخْشَوْنِ ۚ","but fear Me","دِينِكُمْ فَلَا تَخْشَوْهُمْ","ٱلْيَوْمَ أَكْمَلْتُ لَكُمْ",294],["5:44:25",115,"تَخْشَوُا۟","fear","عَلَيْهِ شُهَدَآءَ ۚ فَلَا","ٱلنَّاسَ وَٱخْشَوْنِ وَلَا",294],["5:44:27",115,"وَٱخْشَوْنِ","but fear Me","فَلَا تَخْشَوُا۟ ٱلنَّاسَ","وَلَا تَشْتَرُوا۟ بِـَٔايَـٰتِى",294],["5:52:9",117,"نَخْشَىٰٓ","We fear","يُسَـٰرِعُونَ فِيهِمْ يَقُولُونَ","أَن تُصِيبَنَا دَآئِرَ ةٌۭ ۚ",294],["9:13:13",188,"أَتَخْشَوْنَهُمْ ۚ","Do you fear them","بَدَءُوكُمْ أَوَّلَ مَرَّةٍ ۚ","فَٱللَّهُ أَحَقُّ أَن",294],["9:13:17",188,"تَخْشَوْهُ","you should fear Him","فَٱللَّهُ أَحَقُّ أَن","إِن كُنتُم مُّؤْمِنِينَ",294],["9:18:15",189,"يَخْشَ","fear","وَءَاتَى ٱلزَّكَوٰةَ وَلَمْ","إِلَّا ٱللَّهَ ۖ فَعَسَىٰٓ",294],["9:24:12",190,"تَخْشَوْنَ","you fear","وَأَمْوَٰلٌ ٱقْتَرَفْتُمُوهَا وَتِجَـٰرَةٌۭ","كَسَادَهَا وَمَسَـٰكِنُ تَرْضَوْنَهَآ",294],["13:21:9",252,"وَيَخْشَوْنَ","and fear","بِهِۦٓ أَن يُوصَلَ","رَبَّهُمْ وَيَخَافُونَ سُوٓءَ",294],["17:31:4",285,"خَشْيَةَ","(for) fear","وَلَا تَقْتُلُوٓا۟ أَوْلَـٰدَكُمْ","إِمْلَـٰقٍۢ ۖ نَّحْنُ نَرْزُقُهُمْ",1007],["17:100:10",292,"خَشْيَةَ","(out of) fear","رَبِّىٓ إِذًۭا لَّأَمْسَكْتُمْ","ٱلْإِنفَاقِ ۚ وَكَانَ ٱلْإِنسَـٰنُ",1007],["18:80:6",302,"فَخَشِينَآ","and we feared","فَكَانَ أَبَوَاهُ مُؤْمِنَيْنِ","أَن يُرْهِقَهُمَا طُغْيَـٰنًۭا",294],["20:3:4",312,"يَخْشَىٰ","fear","إِلَّا تَذْكِرَةًۭ لِّمَن","",294],["20:44:8",314,"يَخْشَىٰ","fear","لَّعَلَّهُۥ يَتَذَكَّرُ أَوْ","",294],["20:77:18",317,"تَخْشَىٰ","being afraid","تَخَـٰفُ دَرَكًۭا وَلَا","",294],["20:94:9",318,"خَشِيتُ","[I] feared","وَلَا بِرَأْسِىٓ ۖ إِنِّى","أَن تَقُولَ فَرَّقْتَ",294],["21:28:14",324,"خَشْيَتِهِۦ","fear of Him","ٱرْتَضَىٰ وَهُم مِّنْ","مُشْفِقُونَ",1007],["21:49:2",326,"يَخْشَوْنَ","fear","ٱلَّذِينَ","رَبَّهُم بِٱلْغَيْبِ وَهُم",294],["23:57:5",345,"خَشْيَةِ","(the) fear","ٱلَّذِينَ هُم مِّنْ","رَبِّهِم مُّشْفِقُونَ",1007],["24:52:5",356,"وَيَخْشَ","and fears","يُطِعِ ٱللَّهَ وَرَسُولَهُۥ","ٱللَّهَ وَيَتَّقْهِ فَأُو۟لَـٰٓئِكَ",294],["31:33:5",414,"وَٱخْشَوْا۟","and fear","ٱلنَّاسُ ٱتَّقُوا۟ رَبَّكُمْ","يَوْمًۭا لَّا يَجْزِى",294],["33:37:20",423,"وَتَخْشَى","And you fear","مَا ٱللَّهُ مُبْدِيهِ","ٱلنَّاسَ وَٱللَّهُ أَحَقُّ",294],["33:37:25",423,"تَخْشَىٰهُ ۖ","you (should) fear Him","وَٱللَّهُ أَحَقُّ أَن","فَلَمَّا قَضَىٰ زَيْدٌۭ",294],["33:39:5",423,"وَيَخْشَوْنَهُۥ","and fear Him","يُبَلِّغُونَ رِسَـٰلَـٰتِ ٱللَّهِ","وَلَا يَخْشَوْنَ أَحَدًا",294],["33:39:7",423,"يَخْشَوْنَ","fear","ٱللَّهِ وَيَخْشَوْنَهُۥ وَلَا","أَحَدًا إِلَّا ٱللَّهَ ۗ",294],["35:18:22",436,"يَخْشَوْنَ","fear","إِنَّمَا تُنذِرُ ٱلَّذِينَ","رَبَّهُم بِٱلْغَيْبِ وَأَقَامُوا۟",294],["35:28:9",437,"يَخْشَى","fear","أَلْوَٰنُهُۥ كَذَٰلِكَ ۗ إِنَّمَا","ٱللَّهَ مِنْ عِبَادِهِ",294],["36:11:6",440,"وَخَشِىَ","and fears","مَنِ ٱتَّبَعَ ٱلذِّكْرَ","ٱلرَّحْمَـٰنَ بِٱلْغَيْبِ ۖ فَبَشِّرْهُ",294],["39:23:12",461,"يَخْشَوْنَ","fear","مِنْهُ جُلُودُ ٱلَّذِينَ","رَبَّهُمْ ثُمَّ تَلِينُ",294],["50:33:2",519,"خَشِىَ","feared","مَّنْ","ٱلرَّحْمَـٰنَ بِٱلْغَيْبِ وَجَآءَ",294],["59:21:11",548,"خَشْيَةِ","(the) fear","خَـٰشِعًۭا مُّتَصَدِّعًۭا مِّنْ","ٱللَّهِ ۚ وَتِلْكَ ٱلْأَمْثَـٰلُ",1007],["67:12:3",562,"يَخْشَوْنَ","fear","إِنَّ ٱلَّذِينَ","رَبَّهُم بِٱلْغَيْبِ لَهُم",294],["79:19:4",584,"فَتَخْشَىٰ","so you would fear","وَأَهْدِيَكَ إِلَىٰ رَبِّكَ","",294],["79:26:6",584,"يَخْشَىٰٓ","fears","ذَٰلِكَ لَعِبْرَةًۭ لِّمَن","",294],["79:45:5",584,"يَخْشَىٰهَا","fears it","أَنتَ مُنذِرُ مَن","",294],["80:9:2",585,"يَخْشَىٰ","fears","وَهُوَ","",294],["87:10:3",591,"يَخْشَىٰ","fears (Allah)","سَيَذَّكَّرُ مَن","",294],["98:8:20",599,"خَشِىَ","feared","عَنْهُ ۚ ذَٰلِكَ لِمَنْ","رَبَّهُۥ",294]]