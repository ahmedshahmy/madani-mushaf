[["2:36:9",6,"ٱهْبِطُوا۟","Go down (all of you)","كَانَا فِيهِ ۖ وَقُلْنَا","بَعْضُكُمْ لِبَعْضٍ عَدُوٌّۭ ۖ",1014],["2:38:2",7,"ٱهْبِطُوا۟","Go down","قُلْنَا","مِنْهَا جَمِيعًۭا ۖ فَإِمَّا",1014],["2:61:31",9,"ٱهْبِطُوا۟","Go down","بِٱلَّذِى هُوَ خَيْرٌ ۚ","مِصْرًۭا فَإِنَّ لَكُم",1014],["2:74:29",11,"يَهْبِطُ","fall down","وَإِنَّ مِنْهَا لَمَا","مِنْ خَشْيَةِ ٱللَّهِ ۗ",1014],["7:13:2",152,"فَٱهْبِطْ","Then go down","قَالَ","مِنْهَا فَمَا يَكُونُ",1014],["7:24:2",153,"ٱهْبِطُوا۟","Get down","قَالَ","بَعْضُكُمْ لِبَعْضٍ عَدُوٌّۭ ۖ",1014],["11:48:3",227,"ٱهْبِطْ","Go down","قِيلَ يَـٰنُوحُ","بِسَلَـٰمٍۢ مِّنَّا وَبَرَكَـٰتٍ",1014],["20:123:2",320,"ٱهْبِطَا","Go down","قَالَ","مِنْهَا جَمِيعًۢا ۖ بَعْضُكُمْ",1014]]