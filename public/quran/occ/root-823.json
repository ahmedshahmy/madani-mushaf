[["2:143:4",22,"وَسَطًۭا","(of the) middle way","وَكَذَٰلِكَ جَعَلْنَـٰكُمْ أُمَّةًۭ","لِّتَكُونُوا۟ شُهَدَآءَ عَلَى",4537],["2:238:5",39,"ٱلْوُسْطَىٰ","[the] middle","عَلَى ٱلصَّلَوَٰتِ وَٱلصَّلَوٰةِ","وَقُومُوا۟ لِلَّهِ قَـٰنِتِينَ",4550],["5:89:17",122,"أَوْسَطِ","average","عَشَرَةِ مَسَـٰكِينَ مِنْ","مَا تُطْعِمُونَ أَهْلِيكُمْ",2202],["68:28:2",565,"أَوْسَطُهُمْ","(the) most moderate of them","قَالَ","أَلَمْ أَقُل لَّكُمْ",2202],["100:5:1",599,"فَوَسَطْنَ","Then penetrate (in the) center","","بِهِۦ جَمْعًا",4538]]