[["2:17:5",4,"نَارًۭا","a fire","كَمَثَلِ ٱلَّذِى ٱسْتَوْقَدَ","فَلَمَّآ أَضَآءَتْ مَا",77],["2:17:12",4,"بِنُورِهِمْ","their light","حَوْلَهُۥ ذَهَبَ ٱللَّهُ","وَتَرَكَهُمْ فِى ظُلُمَـٰتٍۢ",273],["2:24:7",4,"ٱلنَّارَ","the Fire","وَلَن تَفْعَلُوا۟ فَٱتَّقُوا۟","ٱلَّتِى وَقُودُهَا ٱلنَّاسُ",77],["2:39:7",7,"ٱلنَّارِ ۖ","(of) the Fire","بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",77],["2:80:4",12,"ٱلنَّارُ","the Fire","وَقَالُوا۟ لَن تَمَسَّنَا","إِلَّآ أَيَّامًۭا مَّعْدُودَةًۭ ۚ",77],["2:81:10",12,"ٱلنَّارِ ۖ","(of) the Fire","خَطِيٓـَٔتُهُۥ فَأُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",77],["2:126:28",19,"ٱلنَّارِ ۖ","(of) the Fire","أَضْطَرُّهُۥٓ إِلَىٰ عَذَابِ","وَبِئْسَ ٱلْمَصِيرُ",77],["2:167:23",25,"ٱلنَّارِ","the Fire","هُم بِخَـٰرِجِينَ مِنَ","",77],["2:174:19",26,"ٱلنَّارَ","the Fire","فِى بُطُونِهِمْ إِلَّا","وَلَا يُكَلِّمُهُمُ ٱللَّهُ",77],["2:175:11",26,"ٱلنَّارِ","the Fire","فَمَآ أَصْبَرَهُمْ عَلَى","",77],["2:201:14",31,"ٱلنَّارِ","(of) the Fire","حَسَنَةًۭ وَقِنَا عَذَابَ","",77],["2:217:54",34,"ٱلنَّارِ ۖ","(of) the Fire","وَٱلْـَٔاخِرَةِ ۖ وَأُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",77],["2:221:28",35,"ٱلنَّارِ ۖ","the Fire","أُو۟لَـٰٓئِكَ يَدْعُونَ إِلَى","وَٱللَّهُ يَدْعُوٓا۟ إِلَى",77],["2:257:9",43,"ٱلنُّورِ ۖ","[the] light","مِّنَ ٱلظُّلُمَـٰتِ إِلَى","وَٱلَّذِينَ كَفَرُوٓا۟ أَوْلِيَآؤُهُمُ",273],["2:257:16",43,"ٱلنُّورِ","the light","ٱلطَّـٰغُوتُ يُخْرِجُونَهُم مِّنَ","إِلَى ٱلظُّلُمَـٰتِ ۗ أُو۟لَـٰٓئِكَ",273],["2:257:21",43,"ٱلنَّارِ ۖ","(of) the Fire","ٱلظُّلُمَـٰتِ ۗ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",77],["2:266:27",45,"نَارٌۭ","(is) fire","فَأَصَابَهَآ إِعْصَارٌۭ فِيهِ","فَٱحْتَرَقَتْ ۗ كَذَٰلِكَ يُبَيِّنُ",77],["2:275:42",47,"ٱلنَّارِ ۖ","(of) the Fire","عَادَ فَأُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",77],["3:10:16",51,"ٱلنَّارِ","(for) the Fire","وَأُو۟لَـٰٓئِكَ هُمْ وَقُودُ","",77],["3:16:11",52,"ٱلنَّارِ","(of) the Fire","ذُنُوبَنَا وَقِنَا عَذَابَ","",77],["3:24:6",53,"ٱلنَّارُ","the Fire","قَالُوا۟ لَن تَمَسَّنَا","إِلَّآ أَيَّامًۭا مَّعْدُودَٰتٍۢ ۖ",77],["3:103:25",63,"ٱلنَّارِ","the Fire","شَفَا حُفْرَةٍۢ مِّنَ","فَأَنقَذَكُم مِّنْهَا ۗ كَذَٰلِكَ",77],["3:116:15",65,"ٱلنَّارِ ۚ","(of) the Fire","شَيْـًۭٔا ۖ وَأُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",77],["3:131:2",66,"ٱلنَّارَ","the Fire","وَٱتَّقُوا۟","ٱلَّتِىٓ أُعِدَّتْ لِلْكَـٰفِرِينَ",77],["3:151:16",69,"ٱلنَّارُ ۚ","(will be) the Fire","بِهِۦ سُلْطَـٰنًۭا ۖ وَمَأْوَىٰهُمُ","وَبِئْسَ مَثْوَى ٱلظَّـٰلِمِينَ",77],["3:183:14",74,"ٱلنَّارُ ۗ","the fire","يَأْتِيَنَا بِقُرْبَانٍۢ تَأْكُلُهُ","قُلْ قَدْ جَآءَكُمْ",77],["3:184:12",74,"ٱلْمُنِيرِ","[the] Enlightening","بِٱلْبَيِّنَـٰتِ وَٱلزُّبُرِ وَٱلْكِتَـٰبِ","",1211],["3:185:13",74,"ٱلنَّارِ","the Fire","فَمَن زُحْزِحَ عَنِ","وَأُدْخِلَ ٱلْجَنَّةَ فَقَدْ",77],["3:191:21",75,"ٱلنَّارِ","(of) the Fire","سُبْحَـٰنَكَ فَقِنَا عَذَابَ","",77],["3:192:5",75,"ٱلنَّارَ","(to) the Fire","إِنَّكَ مَن تُدْخِلِ","فَقَدْ أَخْزَيْتَهُۥ ۖ وَمَا",77],["4:10:11",78,"نَارًۭا ۖ","fire","يَأْكُلُونَ فِى بُطُونِهِمْ","وَسَيَصْلَوْنَ سَعِيرًۭا",77],["4:14:8",79,"نَارًا","(to) Fire","وَيَتَعَدَّ حُدُودَهُۥ يُدْخِلْهُ","خَـٰلِدًۭا فِيهَا وَلَهُۥ",77],["4:30:8",83,"نَارًۭا ۚ","(into) a Fire","وَظُلْمًۭا فَسَوْفَ نُصْلِيهِ","وَكَانَ ذَٰلِكَ عَلَى",77],["4:56:7",87,"نَارًۭا","(in) a Fire","بِـَٔايَـٰتِنَا سَوْفَ نُصْلِيهِمْ","كُلَّمَا نَضِجَتْ جُلُودُهُم",77],["4:145:7",101,"ٱلنَّارِ","the Fire","ٱلدَّرْكِ ٱلْأَسْفَلِ مِنَ","وَلَن تَجِدَ لَهُمْ",77],["4:174:10",105,"نُورًۭا","a light","رَّبِّكُمْ وَأَنزَلْنَآ إِلَيْكُمْ","مُّبِينًۭا",273],["5:15:21",110,"نُورٌۭ","a light","جَآءَكُم مِّنَ ٱللَّهِ","وَكِتَـٰبٌۭ مُّبِينٌۭ",273],["5:16:13",110,"ٱلنُّورِ","the light","مِّنَ ٱلظُّلُمَـٰتِ إِلَى","بِإِذْنِهِۦ وَيَهْدِيهِمْ إِلَىٰ",273],["5:29:10",112,"ٱلنَّارِ ۚ","(of) the Fire","فَتَكُونَ مِنْ أَصْحَـٰبِ","وَذَٰلِكَ جَزَٰٓؤُا۟ ٱلظَّـٰلِمِينَ",77],["5:37:5",114,"ٱلنَّارِ","the Fire","أَن يَخْرُجُوا۟ مِنَ","وَمَا هُم بِخَـٰرِجِينَ",77],["5:44:6",115,"وَنُورٌۭ ۚ","and light","ٱلتَّوْرَىٰةَ فِيهَا هُدًۭى","يَحْكُمُ بِهَا ٱلنَّبِيُّونَ",273],["5:46:17",116,"وَنُورٌۭ","and light","ٱلْإِنجِيلَ فِيهِ هُدًۭى","وَمُصَدِّقًۭا لِّمَا بَيْنَ",273],["5:64:36",118,"نَارًۭا","(the) fire","ٱلْقِيَـٰمَةِ ۚ كُلَّمَآ أَوْقَدُوا۟","لِّلْحَرْبِ أَطْفَأَهَا ٱللَّهُ ۚ",77],["5:72:29",120,"ٱلنَّارُ ۖ","(will be) the Fire","عَلَيْهِ ٱلْجَنَّةَ وَمَأْوَىٰهُ","وَمَا لِلظَّـٰلِمِينَ مِنْ",77],["6:1:9",128,"وَٱلنُّورَ ۖ","and the light","وَٱلْأَرْضَ وَجَعَلَ ٱلظُّلُمَـٰتِ","ثُمَّ ٱلَّذِينَ كَفَرُوا۟",273],["6:27:6",130,"ٱلنَّارِ","the Fire","إِذْ وُقِفُوا۟ عَلَى","فَقَالُوا۟ يَـٰلَيْتَنَا نُرَدُّ",77],["6:91:23",139,"نُورًۭا","(as) a light","جَآءَ بِهِۦ مُوسَىٰ","وَهُدًۭى لِّلنَّاسِ ۖ تَجْعَلُونَهُۥ",273],["6:122:7",143,"نُورًۭا","light","فَأَحْيَيْنَـٰهُ وَجَعَلْنَا لَهُۥ","يَمْشِى بِهِۦ فِى",273],["6:128:24",144,"ٱلنَّارُ","The Fire","أَجَّلْتَ لَنَا ۚ قَالَ","مَثْوَىٰكُمْ خَـٰلِدِينَ فِيهَآ",77],["7:12:14",152,"نَّارٍۢ","fire","مِّنْهُ خَلَقْتَنِى مِن","وَخَلَقْتَهُۥ مِن طِينٍۢ",77],["7:36:8",154,"ٱلنَّارِ ۖ","(of) the Fire","عَنْهَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",77],["7:38:13",155,"ٱلنَّارِ ۖ","the Fire","ٱلْجِنِّ وَٱلْإِنسِ فِى","كُلَّمَا دَخَلَتْ أُمَّةٌۭ",77],["7:38:34",155,"ٱلنَّارِ ۖ","the Fire","عَذَابًۭا ضِعْفًۭا مِّنَ","قَالَ لِكُلٍّۢ ضِعْفٌۭ",77],["7:44:5",156,"ٱلنَّارِ","(of) the Fire","أَصْحَـٰبُ ٱلْجَنَّةِ أَصْحَـٰبَ","أَن قَدْ وَجَدْنَا",77],["7:47:6",156,"ٱلنَّارِ","(of) the Fire","أَبْصَـٰرُهُمْ تِلْقَآءَ أَصْحَـٰبِ","قَالُوا۟ رَبَّنَا لَا",77],["7:50:3",156,"ٱلنَّارِ","(of) the Fire","وَنَادَىٰٓ أَصْحَـٰبُ","أَصْحَـٰبَ ٱلْجَنَّةِ أَنْ",77],["7:157:37",170,"ٱلنُّورَ","the light","وَعَزَّرُوهُ وَنَصَرُوهُ وَٱتَّبَعُوا۟","ٱلَّذِىٓ أُنزِلَ مَعَهُۥٓ ۙ",273],["8:14:6",178,"ٱلنَّارِ","(of) the Fire","وَأَنَّ لِلْكَـٰفِرِينَ عَذَابَ","",77],["9:17:16",189,"ٱلنَّارِ","the Fire","حَبِطَتْ أَعْمَـٰلُهُمْ وَفِى","هُمْ خَـٰلِدُونَ",77],["9:32:4",192,"نُورَ","Allah's light","يُرِيدُونَ أَن يُطْفِـُٔوا۟","ٱللَّهِ بِأَفْوَٰهِهِمْ وَيَأْبَى",273],["9:32:12",192,"نُورَهُۥ","His Light","إِلَّآ أَن يُتِمَّ","وَلَوْ كَرِهَ ٱلْكَـٰفِرُونَ",273],["9:35:5",192,"نَارِ","the Fire","يُحْمَىٰ عَلَيْهَا فِى","جَهَنَّمَ فَتُكْوَىٰ بِهَا",77],["9:63:10",197,"نَارَ","(is the) Fire","وَرَسُولَهُۥ فَأَنَّ لَهُۥ","جَهَنَّمَ خَـٰلِدًۭا فِيهَا ۚ",77],["9:68:6",197,"نَارَ","Fire","ٱلْمُنَـٰفِقِينَ وَٱلْمُنَـٰفِقَـٰتِ وَٱلْكُفَّارَ","جَهَنَّمَ خَـٰلِدِينَ فِيهَا ۚ",77],["9:81:21",200,"نَارُ","(The) Fire","فِى ٱلْحَرِّ ۗ قُلْ","جَهَنَّمَ أَشَدُّ حَرًّۭا ۚ",77],["9:109:21",204,"نَارِ","(the) Fire","فَٱنْهَارَ بِهِۦ فِى","جَهَنَّمَ ۗ وَٱللَّهُ لَا",77],["10:5:7",208,"نُورًۭا","a reflected light","ٱلشَّمْسَ ضِيَآءًۭ وَٱلْقَمَرَ","وَقَدَّرَهُۥ مَنَازِلَ لِتَعْلَمُوا۟",273],["10:8:3",209,"ٱلنَّارُ","(will be) the Fire","أُو۟لَـٰٓئِكَ مَأْوَىٰهُمُ","بِمَا كَانُوا۟ يَكْسِبُونَ",77],["10:27:24",212,"ٱلنَّارِ ۖ","(of) the Fire","مُظْلِمًا ۚ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",77],["11:16:8",223,"ٱلنَّارُ ۖ","the Fire","فِى ٱلْـَٔاخِرَةِ إِلَّا","وَحَبِطَ مَا صَنَعُوا۟",77],["11:17:24",223,"فَٱلنَّارُ","then the Fire","بِهِۦ مِنَ ٱلْأَحْزَابِ","مَوْعِدُهُۥ ۚ فَلَا تَكُ",77],["11:98:6",233,"ٱلنَّارَ ۖ","(into) the Fire","يَوْمَ ٱلْقِيَـٰمَةِ فَأَوْرَدَهُمُ","وَبِئْسَ ٱلْوِرْدُ ٱلْمَوْرُودُ",77],["11:106:5",233,"ٱلنَّارِ","the Fire","ٱلَّذِينَ شَقُوا۟ فَفِى","لَهُمْ فِيهَا زَفِيرٌۭ",77],["11:113:7",234,"ٱلنَّارُ","the Fire","ٱلَّذِينَ ظَلَمُوا۟ فَتَمَسَّكُمُ","وَمَا لَكُم مِّن",77],["13:5:22",249,"ٱلنَّارِ ۖ","(of) the Fire","أَعْنَاقِهِمْ ۖ وَأُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",77],["13:16:28",251,"وَٱلنُّورُ ۗ","and the light","هَلْ تَسْتَوِى ٱلظُّلُمَـٰتُ","أَمْ جَعَلُوا۟ لِلَّهِ",273],["13:17:16",251,"ٱلنَّارِ","the fire","يُوقِدُونَ عَلَيْهِ فِى","ٱبْتِغَآءَ حِلْيَةٍ أَوْ",77],["13:35:19",254,"ٱلنَّارُ","(is) the Fire","ٱتَّقَوا۟ ۖ وَّعُقْبَى ٱلْكَـٰفِرِينَ","",77],["14:1:10",255,"ٱلنُّورِ","the light","مِنَ ٱلظُّلُمَـٰتِ إِلَى","بِإِذْنِ رَبِّهِمْ إِلَىٰ",273],["14:5:11",255,"ٱلنُّورِ","the light","مِنَ ٱلظُّلُمَـٰتِ إِلَى","وَذَكِّرْهُم بِأَيَّىٰمِ ٱللَّهِ ۚ",273],["14:30:12",259,"ٱلنَّارِ","the Fire","فَإِنَّ مَصِيرَكُمْ إِلَى","",77],["14:50:6",261,"ٱلنَّارُ","the Fire","قَطِرَانٍۢ وَتَغْشَىٰ وُجُوهَهُمُ","",77],["15:27:6",263,"نَّارِ","fire","مِن قَبْلُ مِن","ٱلسَّمُومِ",77],["16:62:15",273,"ٱلنَّارَ","(is) the Fire","جَرَمَ أَنَّ لَهُمُ","وَأَنَّهُم مُّفْرَطُونَ",77],["18:29:14",297,"نَارًا","a Fire","إِنَّآ أَعْتَدْنَا لِلظَّـٰلِمِينَ","أَحَاطَ بِهِمْ سُرَادِقُهَا ۚ",77],["18:53:3",299,"ٱلنَّارَ","the Fire","وَرَءَا ٱلْمُجْرِمُونَ","فَظَنُّوٓا۟ أَنَّهُم مُّوَاقِعُوهَا",77],["18:96:14",303,"نَارًۭا","fire","حَتَّىٰٓ إِذَا جَعَلَهُۥ","قَالَ ءَاتُونِىٓ أُفْرِغْ",77],["20:10:3",312,"نَارًۭا","a fire","إِذْ رَءَا","فَقَالَ لِأَهْلِهِ ٱمْكُثُوٓا۟",77],["20:10:9",312,"نَارًۭا","a fire","ٱمْكُثُوٓا۟ إِنِّىٓ ءَانَسْتُ","لَّعَلِّىٓ ءَاتِيكُم مِّنْهَا",77],["20:10:17",312,"ٱلنَّارِ","the fire","أَوْ أَجِدُ عَلَى","هُدًۭى",77],["21:39:10",325,"ٱلنَّارَ","the Fire","يَكُفُّونَ عَن وُجُوهِهِمُ","وَلَا عَن ظُهُورِهِمْ",77],["21:69:2",327,"يَـٰنَارُ","O fire","قُلْنَا","كُونِى بَرْدًۭا وَسَلَـٰمًا",77],["22:8:13",333,"مُّنِيرٍۢ","enlightening","هُدًۭى وَلَا كِتَـٰبٍۢ","",1211],["22:19:12",334,"نَّارٍۢ","fire","لَهُمْ ثِيَابٌۭ مِّن","يُصَبُّ مِن فَوْقِ",77],["22:72:23",340,"ٱلنَّارُ","The Fire","بِشَرٍّۢ مِّن ذَٰلِكُمُ ۗ","وَعَدَهَا ٱللَّهُ ٱلَّذِينَ",77],["23:104:3",348,"ٱلنَّارُ","the Fire","تَلْفَحُ وُجُوهَهُمُ","وَهُمْ فِيهَا كَـٰلِحُونَ",77],["24:35:2",354,"نُورُ","(is the) Light","۞ ٱللَّهُ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ مَثَلُ",273],["24:35:6",354,"نُورِهِۦ","(of) His Light","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ مَثَلُ","كَمِشْكَوٰةٍۢ فِيهَا مِصْبَاحٌ ۖ",273],["24:35:32",354,"نَارٌۭ ۚ","fire","وَلَوْ لَمْ تَمْسَسْهُ","نُّورٌ عَلَىٰ نُورٍۢ ۗ",77],["24:35:33",354,"نُّورٌ","Light","لَمْ تَمْسَسْهُ نَارٌۭ ۚ","عَلَىٰ نُورٍۢ ۗ يَهْدِى",273],["24:35:35",354,"نُورٍۢ ۗ","Light","نَارٌۭ ۚ نُّورٌ عَلَىٰ","يَهْدِى ٱللَّهُ لِنُورِ