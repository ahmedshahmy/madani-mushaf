ا",77],["35:20:4",437,"ٱلنُّورُ","[the] light","وَلَا ٱلظُّلُمَـٰتُ وَلَا","",273],["35:25:13",437,"ٱلْمُنِيرِ","[the] enlightening","بِٱلْبَيِّنَـٰتِ وَبِٱلزُّبُرِ وَبِٱلْكِتَـٰبِ","",1211],["35:36:4",438,"نَارُ","(will be the) Fire","وَٱلَّذِينَ كَفَرُوا۟ لَهُمْ","جَهَنَّمَ لَا يُقْضَىٰ",77],["36:80:7",445,"نَارًۭا","fire","مِّنَ ٱلشَّجَرِ ٱلْأَخْضَرِ","فَإِذَآ أَنتُم مِّنْهُ",77],["38:27:16",455,"ٱلنَّارِ","the Fire","لِّلَّذِينَ كَفَرُوا۟ مِنَ","",77],["38:59:10",456,"ٱلنَّارِ","(in) the Fire","بِهِمْ ۚ إِنَّهُمْ صَالُوا۟","",77],["38:61:11",456,"ٱلنَّارِ","the Fire","عَذَابًۭا ضِعْفًۭا فِى","",77],["38:64:6",457,"ٱلنَّارِ","(of) the Fire","لَحَقٌّۭ تَخَاصُمُ أَهْلِ","",77],["38:76:7",457,"نَّارٍۢ","fire","مِّنْهُ ۖ خَلَقْتَنِى مِن","وَخَلَقْتَهُۥ مِن طِينٍۢ",77],["39:8:34",459,"ٱلنَّارِ","(of) the Fire","إِنَّكَ مِنْ أَصْحَـٰبِ","",77],["39:16:6",460,"ٱلنَّارِ","the Fire","فَوْقِهِمْ ظُلَلٌۭ مِّنَ","وَمِن تَحْتِهِمْ ظُلَلٌۭ ۚ",77],["39:19:10",460,"ٱلنَّارِ","the Fire","تُنقِذُ مَن فِى","",77],["39:22:8",461,"نُورٍۢ","a light","لِلْإِسْلَـٰمِ فَهُوَ عَلَىٰ","مِّن رَّبِّهِۦ ۚ فَوَيْلٌۭ",273],["39:69:3",466,"بِنُورِ","with (the) light","وَأَشْرَقَتِ ٱلْأَرْضُ","رَبِّهَا وَوُضِعَ ٱلْكِتَـٰبُ",273],["40:6:10",467,"ٱلنَّارِ","(of) the Fire","كَفَرُوٓا۟ أَنَّهُمْ أَصْحَـٰبُ","",77],["40:41:9",472,"ٱلنَّارِ","the Fire","ٱلنَّجَوٰةِ وَتَدْعُونَنِىٓ إِلَى","",77],["40:43:22",472,"ٱلنَّارِ","(of) the Fire","ٱلْمُسْرِفِينَ هُمْ أَصْحَـٰبُ","",77],["40:46:1",472,"ٱلنَّارُ","The Fire","","يُعْرَضُونَ عَلَيْهَا غُدُوًّۭا",77],["40:47:4",472,"ٱلنَّارِ","the Fire","وَإِذْ يَتَحَآجُّونَ فِى","فَيَقُولُ ٱلضُّعَفَـٰٓؤُا۟ لِلَّذِينَ",77],["40:47:19",472,"ٱلنَّارِ","the Fire","عَنَّا نَصِيبًۭا مِّنَ","",77],["40:49:4",472,"ٱلنَّارِ","the Fire","وَقَالَ ٱلَّذِينَ فِى","لِخَزَنَةِ جَهَنَّمَ ٱدْعُوا۟",77],["40:72:5",475,"ٱلنَّارِ","the Fire","ٱلْحَمِيمِ ثُمَّ فِى","يُسْجَرُونَ",77],["41:19:6",478,"ٱلنَّارِ","the Fire","أَعْدَآءُ ٱللَّهِ إِلَى","فَهُمْ يُوزَعُونَ",77],["41:24:3",479,