[["7:40:17",155,"ٱلْجَمَلُ","the camel","ٱلْجَنَّةَ حَتَّىٰ يَلِجَ","فِى سَمِّ ٱلْخِيَاطِ ۚ",3521],["12:18:13",237,"جَمِيلٌۭ ۖ","(is) beautiful","أَنفُسُكُمْ أَمْرًۭا ۖ فَصَبْرٌۭ","وَٱللَّهُ ٱلْمُسْتَعَانُ عَلَىٰ",1077],["12:83:8",245,"جَمِيلٌ ۖ","(is) beautiful","أَنفُسُكُمْ أَمْرًۭا ۖ فَصَبْرٌۭ","عَسَى ٱللَّهُ أَن",1077],["15:85:14",266,"ٱلْجَمِيلَ","gracious","لَـَٔاتِيَةٌۭ ۖ فَٱصْفَحِ ٱلصَّفْحَ","",1077],["16:6:3",267,"جَمَالٌ","(is) beauty","وَلَكُمْ فِيهَا","حِينَ تُرِيحُونَ وَحِينَ",3520],["25:32:8",362,"جُمْلَةًۭ","all at once","نُزِّلَ عَلَيْهِ ٱلْقُرْءَانُ","وَٰحِدَةًۭ ۚ كَذَٰلِكَ لِنُثَبِّتَ",3547],["33:28:15",421,"جَمِيلًۭا","good","أُمَتِّعْكُنَّ وَأُسَرِّحْكُنَّ سَرَاحًۭا","",1077],["33:49:22",424,"جَمِيلًۭا","good","فَمَتِّعُوهُنَّ وَسَرِّحُوهُنَّ سَرَاحًۭا","",1077],["70:5:3",568,"جَمِيلًا","good","فَٱصْبِرْ صَبْرًۭا","",1077],["73:10:7",574,"جَمِيلًۭا","gracious","يَقُولُونَ وَٱهْجُرْهُمْ هَجْرًۭا","",1077],["77:33:2",581,"جِمَـٰلَتٌۭ","camels","كَأَنَّهُۥ","صُفْرٌۭ",3538]]