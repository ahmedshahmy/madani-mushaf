[["2:14:2",3,"لَقُوا۟","they meet","وَإِذَا","ٱلَّذِينَ ءَامَنُوا۟ قَالُوٓا۟",666],["2:37:1",6,"فَتَلَقَّىٰٓ","Then received","","ءَادَمُ مِن رَّبِّهِۦ",1647],["2:46:4",7,"مُّلَـٰقُوا۟","will meet","ٱلَّذِينَ يَظُنُّونَ أَنَّهُم","رَبِّهِمْ وَأَنَّهُمْ إِلَيْهِ",1604],["2:76:2",11,"لَقُوا۟","they meet","وَإِذَا","ٱلَّذِينَ ءَامَنُوا۟ قَالُوٓا۟",666],["2:195:6",30,"تُلْقُوا۟","throw (yourselves)","سَبِيلِ ٱللَّهِ وَلَا","بِأَيْدِيكُمْ إِلَى ٱلتَّهْلُكَةِ ۛ",169],["2:223:14",35,"مُّلَـٰقُوهُ ۗ","(will) meet Him","ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّكُم","وَبَشِّرِ ٱلْمُؤْمِنِينَ",1604],["2:249:47",41,"مُّلَـٰقُوا۟","(would) meet","ٱلَّذِينَ يَظُنُّونَ أَنَّهُم","ٱللَّهِ كَم مِّن",1604],["3:13:7",51,"ٱلْتَقَتَا ۖ","which met","ءَايَةٌۭ فِى فِئَتَيْنِ","فِئَةٌۭ تُقَـٰتِلُ فِى",1124],["3:44:11",55,"يُلْقُونَ","they cast","كُنتَ لَدَيْهِمْ إِذْ","أَقْلَـٰمَهُمْ أَيُّهُمْ يَكْفُلُ",169],["3:119:10",65,"لَقُوكُمْ","they meet you","بِٱلْكِتَـٰبِ كُلِّهِۦ وَإِذَا","قَالُوٓا۟ ءَامَنَّا وَإِذَا",666],["3:143:8",68,"تَلْقَوْهُ","you met it","مِن قَبْلِ أَن","فَقَدْ رَأَيْتُمُوهُ وَأَنتُمْ",666],["3:151:1",69,"سَنُلْقِى","We will cast","","فِى قُلُوبِ ٱلَّذِينَ",169],["3:155:6",70,"ٱلْتَقَى","met","تَوَلَّوْا۟ مِنكُمْ يَوْمَ","ٱلْجَمْعَانِ إِنَّمَا ٱسْتَزَلَّهُمُ",1124],["3:166:4",72,"ٱلْتَقَى","(when) met","وَمَآ أَصَـٰبَكُمْ يَوْمَ","ٱلْجَمْعَانِ فَبِإِذْنِ ٱللَّهِ",1124],["4:90:28",92,"وَأَلْقَوْا۟","and offer","ٱعْتَزَلُوكُمْ فَلَمْ يُقَـٰتِلُوكُمْ","إِلَيْكُمُ ٱلسَّلَمَ فَمَا",169],["4:91:18",92,"وَيُلْقُوٓا۟","and offer","فَإِن لَّمْ يَعْتَزِلُوكُمْ","إِلَيْكُمُ ٱلسَّلَمَ وَيَكُفُّوٓا۟",169],["4:94:13",93,"أَلْقَىٰٓ","offers","وَلَا تَقُولُوا۟ لِمَنْ","إِلَيْكُمُ ٱلسَّلَـٰمَ لَسْتَ",169],["4:171:21",105,"أَلْقَىٰهَآ","which He conveyed","رَسُولُ ٱللَّهِ وَكَلِمَتُهُۥٓ","إِلَىٰ مَرْيَمَ وَرُوحٌۭ",169],["5:64:27",118,"وَأَلْقَيْنَا","And We have cast","رَّبِّكَ طُغْيَـٰنًۭا وَكُفْرًۭا ۚ","بَيْنَهُمُ ٱلْعَدَٰوَةَ وَٱلْبَغْضَآءَ",169],["6:31:5",131,"بِلِقَآءِ","in (the) meeting","خَسِرَ ٱلَّذِينَ كَذَّبُوا۟","ٱللَّهِ ۖ حَتَّىٰٓ إِذَا",442],["6:130:12",144,"لِقَآءَ","(of the) meeting","عَلَيْكُمْ ءَايَـٰتِى وَيُنذِرُونَكُمْ","يَوْمِكُمْ هَـٰذَا ۚ قَالُوا۟",442],["6:154:15",149,"بِلِقَآءِ","in (the) meeting","وَهُدًۭى وَرَحْمَةًۭ لَّعَلَّهُم","رَبِّهِمْ يُؤْمِنُونَ",442],["7:47:4",156,"تِلْقَآءَ","towards","۞ وَإِذَا صُرِفَتْ أَبْصَـٰرُهُمْ","أَصْحَـٰبِ ٱلنَّارِ قَالُوا۟",2015],["7:51:13",156,"لِقَآءَ","(the) meeting","نَنسَىٰهُمْ كَمَا نَسُوا۟","يَوْمِهِمْ هَـٰذَا وَمَا",442],["7:107:1",164,"فَأَلْقَىٰ","So he threw","","عَصَاهُ فَإِذَا هِىَ",169],["7:115:5",164,"تُلْقِىَ","you throw","يَـٰمُوسَىٰٓ إِمَّآ أَن","وَإِمَّآ أَن نَّكُونَ",169],["7:115:10",164,"ٱلْمُلْقِينَ","the ones to throw","أَن نَّكُونَ نَحْنُ","",1934],["7:116:2",164,"أَلْقُوا۟ ۖ","Throw","قَالَ","فَلَمَّآ أَلْقَوْا۟ سَحَرُوٓا۟",169],["7:116:4",164,"أَلْقَوْا۟","they threw","قَالَ أَلْقُوا۟ ۖ فَلَمَّآ","سَحَرُوٓا۟ أَعْيُنَ ٱلنَّاسِ",169],["7:117:5",164,"أَلْقِ","Throw","إِلَىٰ مُوسَىٰٓ أَنْ","عَصَاكَ ۖ فَإِذَا هِىَ",169],["7:120:1",164,"وَأُلْقِىَ","And fell down","","ٱلسَّحَرَةُ سَـٰجِدِينَ",169],["7:147:4",168,"وَلِقَآءِ","and (the) meeting","وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا","ٱلْـَٔاخِرَةِ حَبِطَتْ أَعْمَـٰلُهُمْ ۚ",442],["7:150:16",169,"وَأَلْقَى","And he cast down","أَعَجِلْتُمْ أَمْرَ رَبِّكُمْ ۖ","ٱلْأَلْوَاحَ وَأَخَذَ بِرَأْسِ",169],["8:12:11",178,"سَأُلْقِى","I will cast","فَثَبِّتُوا۟ ٱلَّذِينَ ءَامَنُوا۟ ۚ","فِى قُلُوبِ ٱلَّذِينَ",169],["8:15:5",178,"لَقِيتُمُ","you meet","ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا","ٱلَّذِينَ كَفَرُوا۟ زَحْفًۭا",666],["8:41:27",182,"ٱلْتَقَى","(when) met","يَوْمَ ٱلْفُرْقَانِ يَوْمَ","ٱلْجَمْعَانِ ۗ وَٱللَّهُ عَلَىٰ",1124],["8:44:4",182,"ٱلْتَقَيْتُمْ","you met","وَإِذْ يُرِيكُمُوهُمْ إِذِ","فِىٓ أَعْيُنِكُمْ قَلِيلًۭا",1124],["8:45:5",182,"لَقِيتُمْ","you meet","ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا","فِئَةًۭ فَٱثْبُتُوا۟ وَٱذْكُرُوا۟",666],["9:77:7",199,"يَلْقَوْنَهُۥ","when they will meet Him","قُلُوبِهِمْ إِلَىٰ يَوْمِ","بِمَآ أَخْلَفُوا۟ ٱللَّهَ",666],["10:7:5",209,"لِقَآءَنَا","the meeting with Us","ٱلَّذِينَ لَا يَرْجُونَ","وَرَضُوا۟ بِٱلْحَيَوٰةِ ٱلدُّنْيَا",442],["10:11:15",209,"لِقَآءَنَا","the meeting with Us","ٱلَّذِينَ لَا يَرْجُونَ","فِى طُغْيَـٰنِهِمْ يَعْمَهُونَ",442],["10:15:10",210,"لِقَآءَنَا","(for the) meeting (with) Us","ٱلَّذِينَ لَا يَرْجُونَ","ٱئْتِ بِقُرْءَانٍ غَيْرِ",442],["10:15:24",210,"تِلْقَآئِ","my own accord","أَنْ أُبَدِّلَهُۥ مِن","نَفْسِىٓ ۖ إِنْ أَتَّبِعُ",2015],["10:45:16",214,"بِلِقَآءِ","the meeting","خَسِرَ ٱلَّذِينَ كَذَّبُوا۟","ٱللَّهِ وَمَا كَانُوا۟",442],["10:80:7",218,"أَلْقُوا۟","Throw","قَالَ لَهُم مُّوسَىٰٓ","مَآ أَنتُم مُّلْقُونَ",169],["10:80:10",218,"مُّلْقُونَ","(wish to) throw","أَلْقُوا۟ مَآ أَنتُم","",1934],["10:81:2",218,"أَلْقَوْا۟","they (had) thrown","فَلَمَّآ","قَالَ مُوسَىٰ مَا",169],["11:29:17",225,"مُّلَـٰقُوا۟","(will) be meeting","ٱلَّذِينَ ءَامَنُوٓا۟ ۚ إِنَّهُم","رَبِّهِمْ وَلَـٰكِنِّىٓ أَرَىٰكُمْ",1604],["12:10:7",236,"وَأَلْقُوهُ","but throw him","لَا تَقْتُلُوا۟ يُوسُفَ","فِى غَيَـٰبَتِ ٱلْجُبِّ",169],["12:93:4",246,"فَأَلْقُوهُ","and cast it","ٱذْهَبُوا۟ بِقَمِيصِى هَـٰذَا","عَلَىٰ وَجْهِ أَبِى",169],["12:96:5",247,"أَلْقَىٰهُ","he cast it","أَن جَآءَ ٱلْبَشِيرُ","عَلَىٰ وَجْهِهِۦ فَٱرْتَدَّ",169],["13:2:24",249,"بِلِقَآءِ","in the meeting","يُفَصِّلُ ٱلْـَٔايَـٰتِ لَعَلَّكُم","رَبِّكُمْ تُوقِنُونَ",442],["15:19:3",263,"وَأَلْقَيْنَا","and [We] cast","وَٱلْأَرْضَ مَدَدْنَـٰهَا","فِيهَا رَوَٰسِىَ وَأَنۢبَتْنَا",169],["16:15:1",269,"وَأَلْقَىٰ","And He has cast","","فِى ٱلْأَرْضِ رَوَٰسِىَ",169],["16:28:6",270,"فَأَلْقَوُا۟","then they would offer","ٱلْمَلَـٰٓئِكَةُ ظَالِمِىٓ أَنفُسِهِمْ ۖ","ٱلسَّلَمَ مَا كُنَّا",169],["16:86:15",276,"فَأَلْقَوْا۟","But they (will) throw back","نَدْعُوا۟ مِن دُونِكَ ۖ","إِلَيْهِمُ ٱلْقَوْلَ إِنَّكُمْ",169],["16:87:1",276,"وَأَلْقَوْا۟","And they (will) offer","","إِلَى ٱللَّهِ يَوْمَئِذٍ",169],["17:13:12",283,"يَلْقَىٰهُ","which he will find","يَوْمَ ٱلْقِيَـٰمَةِ كِتَـٰبًۭا","مَنشُورًا",666],["17:39:14",286,"فَتُلْقَىٰ","lest you should be thrown","ٱللَّهِ إِلَـٰهًا ءَاخَرَ","فِى جَهَنَّمَ مَلُومًۭا",169],["18:62:8",301,"لَقِينَا","we have suffered","ءَاتِنَا غَدَآءَنَا لَقَدْ","مِن سَفَرِنَا هَـٰذَا",666],["18:74:4",301,"لَقِيَا","they met","فَٱنطَلَقَا حَتَّىٰٓ إِذَا","غُلَـٰمًۭا فَقَتَلَهُۥ قَالَ",666],["18:105:6",304,"وَلِقَآئِهِۦ","and the meeting (with) Him","كَفَرُوا۟ بِـَٔايَـٰتِ رَبِّهِمْ","فَحَبِطَتْ أَعْمَـٰلُهُمْ فَلَا",442],["18:110:15",304,"لِقَآءَ","(for the) meeting","فَمَن كَانَ يَرْجُوا۟","رَبِّهِۦ فَلْيَعْمَلْ عَمَلًۭا",442],["19:59:10",309,"يَلْقَوْنَ","they will meet","وَٱتَّبَعُوا۟ ٱلشَّهَوَٰتِ ۖ فَسَوْفَ","غَيًّا",666],["20:19:2",313,"أَلْقِهَا","Throw it down","قَالَ","يَـٰمُوسَىٰ",169],["20:20:1",313,"فَأَلْقَىٰهَا","So he threw it down","","فَإِذَا هِىَ حَيَّةٌۭ",169],["20:39:8",314,"فَلْيُلْقِهِ","then let cast it","فَٱقْذِفِيهِ فِى ٱلْيَمِّ","ٱلْيَمُّ بِٱلسَّاحِلِ يَأْخُذْهُ",169],["20:39:16",314,"وَأَلْقَيْتُ","And I cast","لِّى وَعَدُوٌّۭ لَّهُۥ ۚ","عَلَيْكَ مَحَبَّةًۭ مِّنِّى",169],["20:65:5",316,"تُلْقِىَ","you throw","يَـٰمُوسَىٰٓ إِمَّآ أَن","وَإِمَّآ أَن نَّكُونَ",169],["20:65:11",316,"أَلْقَىٰ","throws","نَّكُونَ أَوَّلَ مَنْ","",169],["20:66:3",316,"أَلْقُوا۟ ۖ","you throw","قَالَ بَلْ","فَإِذَا حِبَالُهُمْ وَعِصِيُّهُمْ",169],["20:69:1",316,"وَأَلْقِ","And throw","","مَا فِى يَمِينِكَ",169],["20:70:1",316,"فَأُلْقِىَ","So were thrown down","","ٱلسَّحَرَةُ سُجَّدًۭا قَالُوٓا۟",169],["20:87:14",317,"أَلْقَى","threw","ٱلْقَوْمِ فَقَذَفْنَـٰهَا فَكَذَٰلِكَ","ٱلسَّامِرِىُّ",169],["21:103:5",331,"وَتَتَلَقَّىٰهُمُ","and will meet them","يَحْزُنُهُمُ ٱلْفَزَعُ ٱلْأَكْبَرُ","ٱلْمَلَـٰٓئِكَةُ هَـٰذَا يَوْمُكُمُ",1647],["22:52:12",338,"أَلْقَى","threw","إِلَّآ إِذَا تَمَنَّىٰٓ","ٱلشَّيْطَـٰنُ فِىٓ أُمْنِيَّتِهِۦ",169],["22:52:19",338,"يُلْقِى","throws","فَيَنسَخُ ٱللَّهُ مَا","ٱلشَّيْطَـٰنُ ثُمَّ يُحْكِمُ",169],["22:53:3",338,"يُلْقِى","the Shaitaan throws","لِّيَجْعَلَ مَا","ٱلشَّيْطَـٰنُ فِتْنَةًۭ لِّلَّذِينَ",169],["23:33:8",344,"بِلِقَآءِ","(the) meeting","ٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟","ٱلْـَٔاخِرَةِ وَأَتْرَفْنَـٰهُمْ فِى",442],["24:15:2",351,"تَلَقَّوْنَهُۥ","you received it","إِذْ","بِأَلْسِنَتِكُمْ وَتَقُولُونَ بِأَفْوَاهِكُم",1647],["25:8:2",360,"يُلْقَىٰٓ","is delivered","أَوْ","إِلَيْهِ كَنزٌ أَوْ",169],["25:13:2",361,"أُلْقُوا۟","they are thrown","وَإِذَآ","مِنْهَا مَكَانًۭا ضَيِّقًۭا",169],["25:21:5",362,"لِقَآءَنَا","(the) meeting with Us","ٱلَّذِينَ لَا يَرْجُونَ","لَوْلَآ أُنزِلَ عَلَيْنَا",442],["25:68:21",366,"يَلْقَ","will meet","وَمَن يَفْعَلْ ذَٰلِكَ","أَثَامًۭا",666],["25:75:6",366,"وَيُلَقَّوْنَ","and they will be met","ٱلْغُرْفَةَ بِمَا صَبَرُوا۟","فِيهَا تَحِيَّةًۭ وَسَلَـٰمًا",1193],["26:32:1",368,"فَأَلْقَىٰ","So he threw","","عَصَاهُ فَإِذَا هِىَ",169],["26:43:4",369,"أَلْقُوا۟","Throw","قَالَ لَهُم مُّوسَىٰٓ","مَآ أَنتُم مُّلْقُونَ",169],["26:43:7",369,"مُّلْقُونَ","(are) going to throw","أَلْقُوا۟ مَآ أَنتُم","",1934],["26:44:1",369,"فَأَلْقَوْا۟","So they threw","","حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا۟",169],["26:45:1",369,"فَأَلْقَىٰ","Then threw","","مُوسَىٰ عَصَاهُ فَإِذَا",169],["26:46:1",369,"فَأُلْقِىَ","Then fell down","","ٱلسَّحَرَةُ سَـٰجِدِينَ",169],["26:223:1",376,"يُلْقُونَ","They pass on","","ٱلسَّمْعَ وَأَكْثَرُهُمْ كَـٰذِبُونَ",169],["27:6:2",377,"لَتُلَقَّى","surely, receive","وَإِنَّكَ","ٱلْقُرْءَانَ مِن لَّدُنْ",1193],["27:10:1",377,"وَأَلْقِ","And, \"Throw","","عَصَاكَ ۚ فَلَمَّا رَءَاهَا",169],["27:28:4",379,"فَأَلْقِهْ","and deliver it","ٱذْهَب بِّكِتَـٰبِى هَـٰذَا","إِلَيْهِمْ ثُمَّ تَوَلَّ",169],["27:29:5",379,"أُلْقِىَ","is delivered","يَـٰٓأَيُّهَا ٱلْمَلَؤُا۟ إِنِّىٓ","إِلَىَّ كِتَـٰبٌۭ كَرِيمٌ",169],["28:7:10",386,"فَأَلْقِيهِ","then cast him","فَإِذَا خِفْتِ عَلَيْهِ","فِى ٱلْيَمِّ وَلَا",169],["28:22:3",388,"تِلْقَآءَ","towards","وَلَمَّا تَوَجَّهَ","مَدْيَنَ قَالَ عَسَىٰ",2015],["28:31:2",389,"أَلْقِ","throw","وَأَنْ","عَصَاكَ ۖ فَلَمَّا رَءَاهَا",169],["28:61:6",393,"لَـٰقِيهِ","(will) meet it","وَعْدًا حَسَنًۭا فَهُوَ","كَمَن مَّتَّعْنَـٰهُ مَتَـٰعَ",3596],["28:80:14",395,"يُلَقَّىٰهَآ","it is granted","وَعَمِلَ صَـٰلِحًۭا وَلَا","إِلَّا ٱلصَّـٰبِرُونَ",1193],["28:86:5",396,"يُلْقَىٰٓ","would be sent down","كُنتَ تَرْجُوٓا۟ أَن","إِلَيْكَ ٱلْكِتَـٰبُ إِلَّا",169],["29:5:4",396,"لِقَآءَ","(for the) meeting","مَن كَانَ يَرْجُوا۟","ٱللَّهِ فَإِنَّ أَجَلَ",442],["29:23:5",398,"وَلِقَآئِهِۦٓ","and (the) meeting (with) Him","كَفَرُوا۟ بِـَٔايَـٰتِ ٱللَّهِ","أُو۟لَـٰٓئِكَ يَئِسُوا۟ مِن",442],["30:8:20",405,"بِلِقَآئِ","in (the) meeting","كَثِيرًۭا مِّنَ ٱلنَّاسِ","رَبِّهِمْ لَكَـٰفِرُونَ",442],["30:16:6",406,"وَلِقَآئِ","and (the) meeting","كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا","ٱلْـَٔاخِرَةِ فَأُو۟لَـٰٓئِكَ فِى",442],["31:10:6",411,"وَأَلْقَىٰ","and has cast","بِغَيْرِ عَمَدٍۢ تَرَوْنَهَا ۖ","فِى ٱلْأَرْضِ رَوَٰسِىَ",169],["32:10:12",415,"بِلِقَآءِ","in (the) meeting","جَدِيدٍۭ ۚ بَلْ هُم","رَبِّهِمْ كَـٰفِرُونَ",442],["32:14:4",416,"لِقَآءَ","(the) meeting","فَذُوقُوا۟ بِمَا نَسِيتُمْ","يَوْمِكُمْ هَـٰذَآ إِنَّا",442],["32:23:10",417,"لِّقَآئِهِۦ ۖ","receiving it","فِى مِرْيَةٍۢ مِّن","وَجَعَلْنَـٰهُ هُدًۭى لِّبَنِىٓ",442],["33:44:3",424,"يَلْقَوْنَهُۥ","they will meet Him","تَحِيَّتُهُمْ يَوْمَ","سَلَـٰمٌۭ ۚ وَأَعَدَّ لَهُمْ",666],["37:97:5",449,"فَأَلْقُوهُ","and throw him","ٱبْنُوا۟ لَهُۥ بُنْيَـٰنًۭا","فِى ٱلْجَحِيمِ",169],["38:34:4",455,"وَأَلْقَيْنَا","and We placed","وَلَقَدْ فَتَنَّا سُلَيْمَـٰنَ","عَلَىٰ كُرْسِيِّهِۦ جَسَدًۭا",169],["39:71:24",466,"لِقَآءَ","(of the) meeting","ءَايَـٰتِ رَبِّكُمْ وَيُنذِرُونَكُمْ","يَوْمِكُمْ هَـٰذَا ۚ قَالُوا۟",442],["40:15:5",468,"يُلْقِى","He places","ٱلدَّرَجَـٰتِ ذُو ٱلْعَرْشِ","ٱلرُّوحَ مِنْ أَمْرِهِۦ",169],["40:15:16",468,"ٱلتَّلَاقِ","(of) the Meeting","عِبَادِهِۦ لِيُنذِرَ يَوْمَ","",4482],["41:35:2",480,"يُلَقَّىٰهَآ","it is granted","وَمَا","إِلَّا ٱلَّذِينَ صَبَرُوا۟",1193],["41:35:7",480,"يُلَقَّىٰهَآ","it is granted","ٱلَّذِينَ صَبَرُوا۟ وَمَا","إِلَّا ذُو حَظٍّ",1193],["41:40:10",481,"يُلْقَىٰ","is cast","يَخْفَوْنَ عَلَيْنَآ ۗ أَفَمَن","فِى ٱلنَّارِ خَيْرٌ",169],["41:54:6",482,"لِّقَآءِ","(the) meeting","فِى مِرْيَةٍۢ مِّن","رَبِّهِمْ ۗ أَلَآ إِنَّهُۥ",442],["43:53:2",493,"أُلْقِىَ","are placed","فَلَوْلَآ","عَلَيْهِ أَسْوِرَةٌۭ مِّن",169],["43:83:5",495,"يُلَـٰقُوا۟","they meet","يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ","يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ",2079],["45:34:6",502,"لِقَآءَ","(the) meeting","نَنسَىٰكُمْ كَمَا نَسِيتُمْ","يَوْمِكُمْ هَـٰذَا وَمَأْوَىٰكُمُ",442],["47:4:2",507,"لَقِيتُمُ","you meet","فَإِذَا","ٱلَّذِينَ كَفَرُوا۟ فَضَرْبَ",666],["50:7:3",518,"وَأَلْقَيْنَا","and cast","وَٱلْأَرْضَ مَدَدْنَـٰهَا","فِيهَا رَوَٰسِىَ وَأَنۢبَتْنَا",169],["50:17:2",519,"يَتَلَقَّى","receive","إِذْ","ٱلْمُتَلَقِّيَانِ عَنِ ٱلْيَمِينِ",1647],["50:17:3",519,"ٱلْمُتَلَقِّيَانِ","the two receivers","إِذْ يَتَلَقَّى","عَنِ ٱلْيَمِينِ وَعَنِ",3875],["50:24:1",519,"أَلْقِيَا","Throw","","فِى جَهَنَّمَ كُلَّ",169],["50:26:7",519,"فَأَلْقِيَاهُ","so throw him","ٱللَّهِ إِلَـٰهًا ءَاخَرَ","فِى ٱلْعَذَابِ ٱلشَّدِيدِ",169],["50:37:10",520,"أَلْقَى","(who) gives ear","لَهُۥ قَلْبٌ أَوْ","ٱلسَّمْعَ وَهُوَ شَهِيدٌۭ",169],["52:45:3",525,"يُلَـٰقُوا۟","they meet","فَذَرْهُمْ حَتَّىٰ","يَوْمَهُمُ ٱلَّذِى فِيهِ",2079],["54:12:4",529,"فَٱلْتَقَى","so met","وَفَجَّرْنَا ٱلْأَرْضَ عُيُونًۭا","ٱلْمَآءُ عَلَىٰٓ أَمْرٍۢ",1124],["54:25:1",529,"أَءُلْقِىَ","Has been sent","","ٱلذِّكْرُ عَلَيْهِ مِنۢ",169],["55:19:3",532,"يَلْتَقِيَانِ","meeting","مَرَجَ ٱلْبَحْرَيْنِ","",1124],["60:1:9",549,"تُلْقُونَ","offering","عَدُوِّى وَعَدُوَّكُمْ أَوْلِيَآءَ","إِلَيْهِم بِٱلْمَوَدَّةِ وَقَدْ",169],["62:8:8",553,"مُلَـٰقِيكُمْ ۖ","(will) meet you","تَفِرُّونَ مِنْهُ فَإِنَّهُۥ","ثُمَّ تُرَدُّونَ إِلَىٰ",2492],["67:7:2",562,"أُلْقُوا۟","they are thrown","إِذَآ","فِيهَا سَمِعُوا۟ لَهَا",169],["67:8:6",562,"أُلْقِىَ","is thrown","مِنَ ٱلْغَيْظِ ۖ كُلَّمَآ","فِيهَا فَوْجٌۭ سَأَلَهُمْ",169],["69:20:4",567,"مُلَـٰقٍ","(will) meet","إِنِّى ظَنَنتُ أَنِّى","حِسَابِيَهْ",3814],["70:42:5",570,"يُلَـٰقُوا۟","they meet","يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ","يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ",2079],["73:5:2",574,"سَنُلْقِى","will cast","إِنَّا","عَلَيْكَ قَوْلًۭا ثَقِيلًا",169],["75:15:2",577,"أَلْقَىٰ","he presents","وَلَوْ","مَعَاذِيرَهُۥ",169],["76:11:6",579,"وَلَقَّىٰهُمْ","and will cause them to meet","شَرَّ ذَٰلِكَ ٱلْيَوْمِ","نَضْرَةًۭ وَسُرُورًۭا",1193],["77:5:1",580,"فَٱلْمُلْقِيَـٰتِ","And those who bring down","","ذِكْرًا",3815],["84:4:1",589,"وَأَلْقَتْ","And has cast out","","مَا فِيهَا وَتَخَلَّتْ",169],["84:6:8",589,"فَمُلَـٰقِيهِ","and you (will) meet Him","إِلَىٰ رَبِّكَ كَدْحًۭا","",2492]]