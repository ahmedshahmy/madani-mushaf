[["4:101:9",94,"تَقْصُرُوا۟","you shorten","عَلَيْكُمْ جُنَاحٌ أَن","مِنَ ٱلصَّلَوٰةِ إِنْ",4405],["7:74:14",160,"قُصُورًۭا","palaces","تَتَّخِذُونَ مِن سُهُولِهَا","وَتَنْحِتُونَ ٱلْجِبَالَ بُيُوتًۭا ۖ",1616],["7:202:7",176,"يُقْصِرُونَ","they cease","ٱلْغَىِّ ثُمَّ لَا","",4731],["22:45:13",337,"وَقَصْرٍۢ","and castle","عُرُوشِهَا وَبِئْرٍۢ مُّعَطَّلَةٍۢ","مَّشِيدٍ",1616],["25:10:17",360,"قُصُورًۢا","palaces","ٱلْأَنْهَـٰرُ وَيَجْعَل لَّكَ","",1616],["37:48:2",447,"قَـٰصِرَٰتُ","(will be) companions of modest gaze","وَعِندَهُمْ","ٱلطَّرْفِ عِينٌۭ",1953],["38:52:2",456,"قَـٰصِرَٰتُ","(will be) companions of modest gaze","۞ وَعِندَهُمْ","ٱلطَّرْفِ أَتْرَابٌ",1953],["48:27:16",514,"وَمُقَصِّرِينَ","and shortened","ءَامِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ","لَا تَخَافُونَ ۖ فَعَلِمَ",3831],["55:56:2",533,"قَـٰصِرَٰتُ","(will be) companions of modest gaze","فِيهِنَّ","ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ",1953],["55:72:2",534,"مَّقْصُورَٰتٌۭ","restrained","حُورٌۭ","فِى ٱلْخِيَامِ",3921],["77:32:4",581,"كَٱلْقَصْرِ","as the fortress","إِنَّهَا تَرْمِى بِشَرَرٍۢ","",1616]]