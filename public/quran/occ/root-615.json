[["9:34:18",192,"يَكْنِزُونَ","hoard","سَبِيلِ ٱللَّهِ ۗ وَٱلَّذِينَ","ٱلذَّهَبَ وَٱلْفِضَّةَ وَلَا",1864],["9:35:14",192,"كَنَزْتُمْ","you hoarded","وَظُهُورُهُمْ ۖ هَـٰذَا مَا","لِأَنفُسِكُمْ فَذُوقُوا۟ مَا",1864],["9:35:19",192,"تَكْنِزُونَ","hoard","فَذُوقُوا۟ مَا كُنتُمْ","",1864],["11:12:15",222,"كَنزٌ","a treasure","لَوْلَآ أُنزِلَ عَلَيْهِ","أَوْ جَآءَ مَعَهُۥ",1190],["18:82:10",302,"كَنزٌۭ","a treasure","ٱلْمَدِينَةِ وَكَانَ تَحْتَهُۥ","لَّهُمَا وَكَانَ أَبُوهُمَا",1190],["18:82:21",302,"كَنزَهُمَا","their treasure","يَبْلُغَآ أَشُدَّهُمَا وَيَسْتَخْرِجَا","رَحْمَةًۭ مِّن رَّبِّكَ ۚ",1190],["25:8:4",360,"كَنزٌ","a treasure","أَوْ يُلْقَىٰٓ إِلَيْهِ","أَوْ تَكُونُ لَهُۥ",1190],["26:58:1",369,"وَكُنُوزٍۢ","And treasures","","وَمَقَامٍۢ كَرِيمٍۢ",1190],["28:76:11",394,"ٱلْكُنُوزِ","the treasures","عَلَيْهِمْ ۖ وَءَاتَيْنَـٰهُ مِنَ","مَآ إِنَّ مَفَاتِحَهُۥ",1190]]