[["2:25:6",5,"أَنَّ","that","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","لَهُمْ جَنَّـٰتٍۢ تَجْرِى",30],["2:26:16",5,"أَنَّهُ","that it","ٱلَّذِينَ ءَامَنُوا۟ فَيَعْلَمُونَ","ٱلْحَقُّ مِن رَّبِّهِمْ ۖ",30],["2:46:3",7,"أَنَّهُم","that they","ٱلَّذِينَ يَظُنُّونَ","مُّلَـٰقُوا۟ رَبِّهِمْ وَأَنَّهُمْ",30],["2:46:6",7,"وَأَنَّهُمْ","and that they","أَنَّهُم مُّلَـٰقُوا۟ رَبِّهِمْ","إِلَيْهِ رَٰجِعُونَ",30],["2:47:8",7,"وَأَنِّى","and that I","ٱلَّتِىٓ أَنْعَمْتُ عَلَيْكُمْ","فَضَّلْتُكُمْ عَلَى ٱلْعَـٰلَمِينَ",30],["2:61:46",9,"بِأَنَّهُمْ","because they","مِّنَ ٱللَّهِ ۗ ذَٰلِكَ","كَانُوا۟ يَكْفُرُونَ بِـَٔايَـٰتِ",30],["2:77:3",12,"أَنَّ","that","أَوَلَا يَعْلَمُونَ","ٱللَّهَ يَعْلَمُ مَا",30],["2:103:2",16,"أَنَّهُمْ","[that] they","وَلَوْ","ءَامَنُوا۟ وَٱتَّقَوْا۟ لَمَثُوبَةٌۭ",30],["2:106:14",17,"أَنَّ","that","مِثْلِهَآ ۗ أَلَمْ تَعْلَمْ","ٱللَّهَ عَلَىٰ كُلِّ",30],["2:107:3",17,"أَنَّ","that","أَلَمْ تَعْلَمْ","ٱللَّهَ لَهُۥ مُلْكُ",30],["2:122:8",19,"وَأَنِّى","and that I","ٱلَّتِىٓ أَنْعَمْتُ عَلَيْكُمْ","فَضَّلْتُكُمْ عَلَى ٱلْعَـٰلَمِينَ",30],["2:144:26",22,"أَنَّهُ","that it","أُوتُوا۟ ٱلْكِتَـٰبَ لَيَعْلَمُونَ","ٱلْحَقُّ مِن رَّبِّهِمْ ۗ",30],["2:165:24",25,"أَنَّ","that","إِذْ يَرَوْنَ ٱلْعَذَابَ","ٱلْقُوَّةَ لِلَّهِ جَمِيعًۭا",30],["2:165:28",25,"وَأَنَّ","and [that]","ٱلْقُوَّةَ لِلَّهِ جَمِيعًۭا","ٱللَّهَ شَدِيدُ ٱلْعَذَابِ",30],["2:167:5",25,"أَنَّ","[that]","ٱلَّذِينَ ٱتَّبَعُوا۟ لَوْ","لَنَا كَرَّةًۭ فَنَتَبَرَّأَ",30],["2:176:2",26,"بِأَنَّ","(is) because","ذَٰلِكَ","ٱللَّهَ نَزَّلَ ٱلْكِتَـٰبَ",30],["2:187:16",29,"أَنَّكُمْ","that you","لَّهُنَّ ۗ عَلِمَ ٱللَّهُ","كُنتُمْ تَخْتَانُونَ أَنفُسَكُمْ",30],["2:194:19",30,"أَنَّ","that","وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟","ٱللَّهَ مَعَ ٱلْمُتَّقِينَ",30],["2:196:70",30,"أَنَّ","that","وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟","ٱللَّهَ شَدِيدُ ٱلْعِقَابِ",30],["2:203:23",32,"أَنَّكُمْ","that you","وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟","إِلَيْهِ تُحْشَرُونَ",30],["2:209:9",32,"أَنَّ","that","جَآءَتْكُمُ ٱلْبَيِّنَـٰتُ فَٱعْلَمُوٓا۟","ٱللَّهَ عَزِيزٌ حَكِيمٌ",30],["2:223:13",35,"أَنَّكُم","that you","وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟","مُّلَـٰقُوهُ ۗ وَبَشِّرِ ٱلْمُؤْمِنِينَ",30],["2:231:41",37,"أَنَّ","that","وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟","ٱللَّهَ بِكُلِّ شَىْءٍ",30],["2:233:60",37,"أَنَّ","that","وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟","ٱللَّهَ بِمَا تَعْمَلُونَ",30],["2:235:16",38,"أَنَّكُمْ","that you","أَنفُسِكُمْ ۚ عَلِمَ ٱللَّهُ","سَتَذْكُرُونَهُنَّ وَلَـٰكِن لَّا",30],["2:235:36",38,"أَنَّ","that","ٱلْكِتَـٰبُ أَجَلَهُۥ ۚ وَٱعْلَمُوٓا۟","ٱللَّهَ يَعْلَمُ مَا",30],["2:235:44",38,"أَنَّ","that","أَنفُسِكُمْ فَٱحْذَرُوهُ ۚ وَٱعْلَمُوٓا۟","ٱللَّهَ غَفُورٌ حَلِيمٌۭ",30],["2:244:6",39,"أَنَّ","that","سَبِيلِ ٱللَّهِ وَٱعْلَمُوٓا۟","ٱللَّهَ سَمِيعٌ عَلِيمٌۭ",30],["2:249:46",41,"أَنَّهُم","that they","قَالَ ٱلَّذِينَ يَظُنُّونَ","مُّلَـٰقُوا۟ ٱللَّهِ كَم",30],["2:259:62",43,"أَنَّ","that","لَهُۥ قَالَ أَعْلَمُ","ٱللَّهَ عَلَىٰ كُلِّ",30],["2:260:36",44,"أَنَّ","that","يَأْتِينَكَ سَعْيًۭا ۚ وَٱعْلَمْ","ٱللَّهَ عَزِيزٌ حَكِيمٌۭ",30],["2:267:26",45,"أَنَّ","that","تُغْمِضُوا۟ فِيهِ ۚ وَٱعْلَمُوٓا۟","ٱللَّهَ غَنِىٌّ حَمِيدٌ",30],["2:275:15",47,"بِأَنَّهُمْ","(is) because they","مِنَ ٱلْمَسِّ ۚ ذَٰلِكَ","قَالُوٓا۟ إِنَّمَا ٱلْبَيْعُ",30],["3:18:3",52,"أَنَّهُۥ","that [He]","شَهِدَ ٱللَّهُ","لَآ إِلَـٰهَ إِلَّا",30],["3:24:2",53,"بِأَنَّهُمْ","(is) because they","ذَٰلِكَ","قَالُوا۟ لَن تَمَسَّنَا",30],["3:30:16",54,"أَنَّ","that","سُوٓءٍۢ تَوَدُّ لَوْ","بَيْنَهَا وَبَيْنَهُۥٓ أَمَدًۢا",30],["3:39:8",55,"أَنَّ","Indeed","يُصَلِّى فِى ٱلْمِحْرَابِ","ٱللَّهَ يُبَشِّرُكَ بِيَحْيَىٰ",30],["3:49:5",56,"أَنِّى","Indeed, I","إِلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ","قَدْ جِئْتُكُم بِـَٔايَةٍۢ",30],["3:49:11",56,"أَنِّىٓ","that I","بِـَٔايَةٍۢ مِّن رَّبِّكُمْ ۖ","أَخْلُقُ لَكُم مِّنَ",30],["3:52:19",56,"بِأَنَّا","that we","ءَامَنَّا بِٱللَّهِ وَٱشْهَدْ","مُسْلِمُونَ",30],["3:64:30",58,"بِأَنَّا","that we","تَوَلَّوْا۟ فَقُولُوا۟ ٱشْهَدُوا۟","مُسْلِمُونَ",30],["3:75:24",59,"بِأَنَّهُمْ","(is) because they","عَلَيْهِ قَآئِمًۭا ۗ ذَٰلِكَ","قَالُوا۟ لَيْسَ عَلَيْنَا",30],["3:86:9",61,"أَنَّ","that","بَعْدَ إِيمَـٰنِهِمْ وَشَهِدُوٓا۟","ٱلرَّسُولَ حَقٌّۭ وَجَآءَهُمُ",30],["3:87:3",61,"أَنَّ","that","أُو۟لَـٰٓئِكَ جَزَآؤُهُمْ","عَلَيْهِمْ لَعْنَةَ ٱللَّهِ",30],["3:112:22",64,"بِأَنَّهُمْ","(is) because","عَلَيْهِمُ ٱلْمَسْكَنَةُ ۚ ذَٰلِكَ","كَانُوا۟ يَكْفُرُونَ بِـَٔايَـٰتِ",30],["3:171:6",72,"وَأَنَّ","and that","مِّنَ ٱللَّهِ وَفَضْلٍۢ","ٱللَّهَ لَا يُضِيعُ",30],["3:178:5",73,"أَنَّمَا","that","يَحْسَبَنَّ ٱلَّذِينَ كَفَرُوٓا۟","نُمْلِى لَهُمْ خَيْرٌۭ",30],["3:182:5",74,"وَأَنَّ","and that","بِمَا قَدَّمَتْ أَيْدِيكُمْ","ٱللَّهَ لَيْسَ بِظَلَّامٍۢ",30],["3:195:4",76,"أَنِّى","Indeed, I","فَٱسْتَجَابَ لَهُمْ رَبُّهُمْ","لَآ أُضِيعُ عَمَلَ",30],["4:46:21",86,"أَنَّهُمْ","[that] they","فِى ٱلدِّينِ ۚ وَلَوْ","قَالُوا۟ سَمِعْنَا وَأَطَعْنَا",30],["4:60:6",88,"أَنَّهُمْ","that they","إِلَى ٱلَّذِينَ يَزْعُمُونَ","ءَامَنُوا۟ بِمَآ أُنزِلَ",30],["4:64:10",88,"أَنَّهُمْ","[that] they","بِإِذْنِ ٱللَّهِ ۚ وَلَوْ","إِذ ظَّلَمُوٓا۟ أَنفُسَهُمْ",30],["4:66:2",89,"أَنَّا","[that] We","وَلَوْ","كَتَبْنَا عَلَيْهِمْ أَنِ",30],["4:66:18",89,"أَنَّهُمْ","[that] they","قَلِيلٌۭ مِّنْهُمْ ۖ وَلَوْ","فَعَلُوا۟ مَا يُوعَظُونَ",30],["4:116:1",97,"إِنَّ","Indeed","","ٱللَّهَ لَا يَغْفِرُ",30],["4:138:3",100,"بِأَنَّ","that","بَشِّرِ ٱلْمُنَـٰفِقِينَ","لَهُمْ عَذَابًا أَلِيمًا",30],["5:32:8",113,"أَنَّهُۥ","that he","عَلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ","مَن قَتَلَ نَفْسًۢا",30],["5:34:10",113,"أَنَّ","that","تَقْدِرُوا۟ عَلَيْهِمْ ۖ فَٱعْلَمُوٓا۟","ٱللَّهَ غَفُورٌۭ رَّحِيمٌۭ",30],["5:36:5",113,"أَنَّ","that","ٱلَّذِينَ كَفَرُوا۟ لَوْ","لَهُم مَّا فِى",30],["5:40:3",114,"أَنَّ","that","أَلَمْ تَعْلَمْ","ٱللَّهَ لَهُۥ مُلْكُ",30],["5:45:4",115,"أَنَّ","that","وَكَتَبْنَا عَلَيْهِمْ فِيهَآ","ٱلنَّفْسَ بِٱلنَّفْسِ وَٱلْعَيْنَ",30],["5:49:22",116,"أَنَّمَا","only","فَإِن تَوَلَّوْا۟ فَٱعْلَمْ","يُرِيدُ ٱللَّهُ أَن",30],["5:58:9",118,"بِأَنَّهُمْ","(is) because they","هُزُوًۭا وَلَعِبًۭا ۚ ذَٰلِكَ","قَوْمٌۭ لَّا يَعْقِلُونَ",30],["5:59:18",118,"وَأَنَّ","and that","أُنزِلَ مِن قَبْلُ","أَكْثَرَكُمْ فَـٰسِقُونَ",30],["5:65:2",119,"أَنَّ","that","وَلَوْ","أَهْلَ ٱلْكِتَـٰبِ ءَامَنُوا۟",30],["5:66:2",119,"أَنَّهُمْ","that they","وَلَوْ","أَقَامُوا۟ ٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ",30],["5:82:20",121,"بِأَنَّ","because","إِنَّا نَصَـٰرَىٰ ۚ ذَٰلِكَ","مِنْهُمْ قِسِّيسِينَ وَرُهْبَانًۭا",30],["5:82:24",121,"وَأَنَّهُمْ","and that they","مِنْهُمْ قِسِّيسِينَ وَرُهْبَانًۭا","لَا يَسْتَكْبِرُونَ",30],["5:92:9",123,"أَنَّمَا","only","فَإِن تَوَلَّيْتُمْ فَٱعْلَمُوٓا۟","عَلَىٰ رَسُولِنَا ٱلْبَلَـٰغُ",30],["5:97:14",124,"أَنَّ","that","وَٱلْقَلَـٰٓئِدَ ۚ ذَٰلِكَ لِتَعْلَمُوٓا۟","ٱللَّهَ يَعْلَمُ مَا",30],["5:97:23",124,"وَأَنَّ","and that","وَمَا فِى ٱلْأَرْضِ","ٱللَّهَ بِكُلِّ شَىْءٍ",30],["5:98:2",124,"أَنَّ","that","ٱعْلَمُوٓا۟","ٱللَّهَ شَدِيدُ ٱلْعِقَابِ",30],["5:98:6",124,"وَأَنَّ","and that","ٱللَّهَ شَدِيدُ ٱلْعِقَابِ","ٱللَّهَ غَفُورٌۭ رَّحِيمٌۭ",30],["5:107:4",125,"أَنَّهُمَا","that the two","فَإِنْ عُثِرَ عَلَىٰٓ","ٱسْتَحَقَّآ إِثْمًۭا فَـَٔاخَرَانِ",30],["5:111:12",126,"بِأَنَّنَا","that indeed we","قَالُوٓا۟ ءَامَنَّا وَٱشْهَدْ","مُسْلِمُونَ",30],["6:19:21",130,"أَنَّ","that","بَلَغَ ۚ أَئِنَّكُمْ لَتَشْهَدُونَ","مَعَ ٱللَّهِ ءَالِهَةً",30],["6:54:14",134,"أَنَّهُۥ","that he","عَلَىٰ نَفْسِهِ ٱلرَّحْمَةَ ۖ","مَنْ عَمِلَ مِنكُمْ",30],["6:54:25",134,"فَأَنَّهُۥ","then, indeed He","مِنۢ بَعْدِهِۦ وَأَصْلَحَ","غَفُورٌۭ رَّحِيمٌۭ",30],["6:58:3",134,"أَنَّ","that","قُل لَّوْ","عِندِى مَا تَسْتَعْجِلُونَ",30],["6:81:7",137,"أَنَّكُمْ","that you","أَشْرَكْتُمْ وَلَا تَخَافُونَ","أَشْرَكْتُم بِٱللَّهِ مَا",30],["6:94:19",139,"أَنَّهُمْ","that they (were)","شُفَعَآءَكُمُ ٱلَّذِينَ زَعَمْتُمْ","فِيكُمْ شُرَكَـٰٓؤُا۟ ۚ لَقَد",30],["6:109:17",141,"أَنَّهَآ","that [it]","ٱللَّهِ ۖ وَمَا يُشْعِرُكُمْ","إِذَا جَآءَتْ لَا",30],["6:111:2",142,"أَنَّنَا","[that] We (had)","۞ وَلَوْ","نَزَّلْنَآ إِلَيْهِمُ ٱلْمَلَـٰٓئِكَةَ",30],["6:114:15",142,"أَنَّهُۥ","that it","ءَاتَيْنَـٰهُمُ ٱلْكِتَـٰبَ يَعْلَمُونَ","مُنَزَّلٌۭ مِّن رَّبِّكَ",30],["6:130:25",144,"أَنَّهُمْ","that they","وَشَهِدُوا۟ عَلَىٰٓ أَنفُسِهِمْ","كَانُوا۟ كَـٰفِرِينَ",30],["6:150:6",148,"أَنَّ","that","شُهَدَآءَكُمُ ٱلَّذِينَ يَشْهَدُونَ","ٱللَّهَ حَرَّمَ هَـٰذَا ۖ",30],["6:153:1",149,"وَأَنَّ","And that","","هَـٰذَا صِرَٰطِى مُسْتَقِيمًۭا",30],["6:157:4",149,"أَنَّآ","[that]","أَوْ تَقُولُوا۟ لَوْ","أُنزِلَ عَلَيْنَا ٱلْكِتَـٰبُ",30],["7:30:15",153,"أَنَّهُم","that they","دُونِ ٱللَّهِ وَيَحْسَبُونَ","مُّهْتَدُونَ",30],["7:37:35",154,"أَنَّهُمْ","that they","وَشَهِدُوا۟ عَلَىٰٓ أَنفُسِهِمْ","كَانُوا۟ كَـٰفِرِينَ",30],["7:75:13",160,"أَنَّ","that","ءَامَنَ مِنْهُمْ أَتَعْلَمُونَ","صَـٰلِحًۭا مُّرْسَلٌۭ مِّن",30],["7:96:2",163,"أَنَّ","[that]","وَلَوْ","أَهْلَ ٱلْقُرَىٰٓ ءَامَنُوا۟",30],["7:136:6",166,"بِأَنَّهُمْ","because they","فَأَغْرَقْنَـٰهُمْ فِى ٱلْيَمِّ","كَذَّبُوا۟ بِـَٔايَـٰتِنَا وَكَانُوا۟",30],["7:146:31",168,"بِأَنَّهُمْ","(is) because they","يَتَّخِذُوهُ سَبِيلًۭا ۚ ذَٰلِكَ","كَذَّبُوا۟ بِـَٔايَـٰتِنَا وَكَانُوا۟",30],["7:148:14",168,"أَنَّهُۥ","that it","خُوَارٌ ۚ أَلَمْ يَرَوْا۟","لَا يُكَلِّمُهُمْ وَلَا",30],["7:149:6",168,"أَنَّهُمْ","that they","فِىٓ أَيْدِيهِمْ وَرَأَوْا۟","قَدْ ضَلُّوا۟ قَالُوا۟",30],["7:171:8",173,"أَنَّهُۥ","that it","كَأَنَّهُۥ ظُلَّةٌۭ وَظَنُّوٓا۟","وَاقِعٌۢ بِهِمْ خُذُوا۟",30],["8:7:6",177,"أَنَّهَا","that it (would be)","ٱللَّهُ إِحْدَى ٱلطَّآئِفَتَيْنِ","لَكُمْ وَتَوَدُّونَ أَنَّ",30],["8:7:9",177,"أَنَّ","that","أَنَّهَا لَكُمْ وَتَوَدُّونَ","غَيْرَ ذَاتِ ٱلشَّوْكَةِ",30],["8:9:6",178,"أَنِّى","Indeed, I am","رَبَّكُمْ فَٱسْتَجَابَ لَكُمْ","مُمِدُّكُم بِأَلْفٍۢ مِّنَ",30],["8:12:6",178,"أَنِّى","I am","رَبُّكَ إِلَى ٱلْمَلَـٰٓئِكَةِ","مَعَكُمْ فَثَبِّتُوا۟ ٱلَّذِينَ",30],["8:13:2",178,"بِأَنَّهُمْ","(is) because they","ذَٰلِكَ","شَآقُّوا۟ ٱللَّهَ وَرَسُولَهُۥ ۚ",30],["8:14:3",178,"وَأَنَّ","And that","ذَٰلِكُمْ فَذُوقُوهُ","لِلْكَـٰفِرِينَ عَذَابَ ٱلنَّارِ",30],["8:18:2",179,"وَأَنَّ","and that","ذَٰلِكُمْ","ٱللَّهَ مُوهِنُ كَيْدِ",30],["8:19:21",179,"وَأَنَّ","And that","شَيْـًۭٔا وَلَوْ كَثُرَتْ","ٱللَّهَ مَعَ ٱلْمُؤْمِنِينَ",30],["8:24:12",179,"أَنَّ","that","لِمَا يُحْيِيكُمْ ۖ وَٱعْلَمُوٓا۟","ٱللَّهَ يَحُولُ بَيْنَ",30],["8:24:18",179,"وَأَنَّهُۥٓ","and that","بَيْنَ ٱلْمَرْءِ وَقَلْبِهِۦ","إِلَيْهِ تُحْشَرُونَ",30],["8:25:10",179,"أَنَّ","that","مِنكُمْ خَآصَّةًۭ ۖ وَٱعْلَمُوٓا۟","ٱللَّهَ شَدِيدُ ٱلْعِقَابِ",30],["8:28:2",180,"أَنَّمَآ","that","وَٱعْلَمُوٓا۟","أَمْوَٰلُكُمْ وَأَوْلَـٰدُكُمْ فِتْنَةٌۭ",30],["8:28:6",180,"وَأَنَّ","And that","أَمْوَٰلُكُمْ وَأَوْلَـٰدُكُمْ فِتْنَةٌۭ","ٱللَّهَ عِندَهُۥٓ أَجْرٌ",30],["8:40:4",181,"أَنَّ","that","وَإِن تَوَلَّوْا۟ فَٱعْلَمُوٓا۟","ٱللَّهَ مَوْلَىٰكُمْ ۚ نِعْمَ",30],["8:41:2",182,"أَنَّمَا","that what","۞ وَٱعْلَمُوٓا۟","غَنِمْتُم مِّن شَىْءٍۢ",30],["8:41:6",182,"فَأَنَّ","then that","غَنِمْتُم مِّن شَىْءٍۢ","لِلَّهِ خُمُسَهُۥ وَلِلرَّسُولِ",30],["8:51:5",183,"وَأَنَّ","And indeed","بِمَا قَدَّمَتْ أَيْدِيكُمْ","ٱللَّهَ لَيْسَ بِظَلَّـٰمٍۢ",30],["8:53:2",184,"بِأَنَّ","(is) because","ذَٰلِكَ","ٱللَّهَ لَمْ يَكُ",30],["8:53:15",184,"وَأَنَّ","And indeed","يُغَيِّرُوا۟ مَا بِأَنفُسِهِمْ ۙ","ٱللَّهَ سَمِيعٌ عَلِيمٌۭ",30],["8:65:23",185,"بِأَنَّهُمْ","because they","مِّنَ ٱلَّذِينَ كَفَرُوا۟","قَوْمٌۭ لَّا يَفْقَهُونَ",30],["8:66:6",185,"أَنَّ","that","ٱللَّهُ عَنكُمْ وَعَلِمَ","فِيكُمْ ضَعْفًۭا ۚ فَإِن",30],["9:2:7",187,"أَنَّكُمْ","that you","أَرْبَعَةَ أَشْهُرٍۢ وَٱعْلَمُوٓا۟","غَيْرُ مُعْجِزِى ٱللَّهِ ۙ",30],["9:2:11",187,"وَأَنَّ","and that","غَيْرُ مُعْجِزِى ٱللَّهِ ۙ","ٱللَّهَ مُخْزِى ٱلْكَـٰفِرِينَ",30],["9:3:10",187,"أَنَّ","that","يَوْمَ ٱلْحَجِّ ٱلْأَكْبَرِ","ٱللَّهَ بَرِىٓءٌۭ مِّنَ",30],["9:3:24",187,"أَنَّكُمْ","that you","وَإِن تَوَلَّيْتُمْ فَٱعْلَمُوٓا۟","غَيْرُ مُعْجِزِى ٱللَّهِ ۗ",30],["9:6:15",187,"بِأَنَّهُمْ","(is) because they","أَبْلِغْهُ مَأْمَنَهُۥ ۚ ذَٰلِكَ","قَوْمٌۭ لَّا يَعْلَمُونَ",30],["9:36:33",192,"أَنَّ","that","يُقَـٰتِلُونَكُمْ كَآفَّةًۭ ۚ وَٱعْلَمُوٓا۟","ٱللَّهَ مَعَ ٱلْمُتَّقِينَ",30],["9:54:8",195,"أَنَّهُمْ","that they","مِنْهُمْ نَفَقَـٰتُهُمْ إِلَّآ","كَفَرُوا۟ بِٱللَّهِ وَبِرَسُولِهِۦ",30],["9:59:2",196,"أَنَّهُمْ","[that] they","وَلَوْ","رَضُوا۟ مَآ ءَاتَىٰهُمُ",30],["9:63:3",197,"أَنَّهُۥ","that he","أَلَمْ يَعْلَمُوٓا۟","مَن يُحَادِدِ ٱللَّهَ",30],["9:63:8",197,"فَأَنَّ","[then] that","يُحَادِدِ ٱللَّهَ وَرَسُولَهُۥ","لَهُۥ نَارَ جَهَنَّمَ",30],["9:66:14",197,"بِأَنَّهُمْ","because they","مِّنكُمْ نُعَذِّبْ طَآئِفَةًۢ","كَانُوا۟ مُجْرِمِينَ",30],["9:78:3",199,"أَنَّ","that","أَلَمْ يَعْلَمُوٓا۟","ٱللَّهَ يَعْلَمُ سِرَّهُمْ",30],["9:78:8",199,"وَأَنَّ","and that","يَعْلَمُ سِرَّهُمْ وَنَجْوَىٰهُمْ","ٱللَّهَ عَلَّـٰمُ ٱلْغُيُوبِ",30],["9:80:17",200,"بِأَنَّهُمْ","(is) because they","ٱللَّهُ لَهُمْ ۚ ذَٰلِكَ","كَفَرُوا۟ بِٱللَّهِ وَرَسُولِهِۦ ۗ",30],["9:104:3",203,"أَنَّ","that","أَلَمْ يَعْلَمُوٓا۟","ٱللَّهَ هُوَ يَقْبَلُ",30],["9:104:12",203,"وَأَنَّ","and that","عِبَادِهِۦ وَيَأْخُذُ ٱلصَّدَقَـٰتِ","ٱللَّهَ هُوَ ٱلتَّوَّابُ",30],["9:111:8",204,"بِأَنَّ","because","ٱلْمُؤْمِنِينَ أَنفُسَهُمْ وَأَمْوَٰلَهُم","لَهُمُ ٱلْجَنَّةَ ۚ يُقَـٰتِلُونَ",30],["9:113:18",205,"أَنَّهُمْ","that they","مَا تَبَيَّنَ لَهُمْ","أَصْحَـٰبُ ٱلْجَحِيمِ",30],["9:114:14",205,"أَنَّهُۥ","that he","فَلَمَّا تَبَيَّنَ لَهُۥٓ","عَدُوٌّۭ لِّلَّهِ تَبَرَّأَ",30],["9:120:20",206,"بِأَنَّهُمْ","because [they]","عَن نَّفْسِهِۦ ۚ ذَٰلِكَ","لَا يُصِيبُهُمْ ظَمَأٌۭ",30],["9:123:13",207,"أَنَّ","that","فِيكُمْ غِلْظَةًۭ ۚ وَٱعْلَمُوٓا۟","ٱللَّهَ مَعَ ٱلْمُتَّقِينَ",30],["9:126:3",207,"أَنَّهُمْ","that they","أَوَلَا يَرَوْنَ","يُفْتَنُونَ فِى كُلِّ",30],["9:127:18",207,"بِأَنَّهُمْ","because they","صَرَفَ ٱللَّهُ قُلُوبَهُم","قَوْمٌۭ لَّا يَفْقَهُونَ",30],["10:2:15",208,"أَنَّ","that","وَبَشِّرِ ٱلَّذِينَ ءَامَنُوٓا۟","لَهُمْ قَدَمَ صِدْقٍ",30],["10:22:27",211,"أَنَّهُمْ","that they","كُلِّ مَكَانٍۢ وَظَنُّوٓا۟","أُحِيطَ بِهِمْ ۙ دَعَوُا۟",30],["10:24:25",211,"أَنَّهُمْ","that they","وَٱزَّيَّنَتْ وَظَنَّ أَهْلُهَآ","قَـٰدِرُونَ عَلَيْهَآ أَتَىٰهَآ",30],["10:33:8",212,"أَنَّهُمْ","that they","عَلَى ٱلَّذِينَ فَسَقُوٓا۟","لَا يُؤْمِنُونَ",30],["10:54:2",215,"أَنَّ","that","وَلَوْ","لِكُلِّ نَفْسٍۢ ظَلَمَتْ",30],["10:90:16",219,"أَنَّهُۥ","that","ٱلْغَرَقُ قَالَ ءَامَنتُ","لَآ إِلَـٰهَ إِلَّا",30],["11:14:5",223,"أَنَّمَآ","that","يَسْتَجِيبُوا۟ لَكُمْ فَٱعْلَمُوٓا۟","أُنزِلَ بِعِلْمِ ٱللَّهِ",30],["11:22:3",224,"أَنَّهُمْ","that they","لَا جَرَمَ","فِى ٱلْـَٔاخِرَةِ هُمُ",30],["11:36:4",225,"أَنَّهُۥ","That","وَأُوحِىَ إِلَىٰ نُوحٍ","لَن يُؤْمِنَ مِن",30],["11:54:13",228,"أَنِّى","that I am","أُشْهِدُ ٱللَّهَ وَٱشْهَدُوٓا۟","بَرِىٓءٌۭ مِّمَّا تُشْرِكُونَ",30],["11:80:3",230,"أَنَّ","that","قَالَ لَوْ","لِى بِكُمْ قُوَّةً",30],["12:42:4",240,"أَنَّهُۥ","that he","وَقَالَ لِلَّذِى ظَنَّ","نَاجٍۢ مِّنْهُمَا ٱذْكُرْنِى",30],["12:52:3",241,"أَنِّى","that I","ذَٰلِكَ لِيَعْلَمَ","لَمْ أَخُنْهُ بِٱلْغَيْبِ",30],["12:52:7",241,"وَأَنَّ","and that","لَمْ أَخُنْهُ بِٱلْغَيْبِ","ٱللَّهَ لَا يَهْدِى",30],["12:59:12",242,"أَنِّىٓ","that I","أَبِيكُمْ ۚ أَلَا تَرَوْنَ","أُوفِى ٱلْكَيْلَ وَأَنَا۠",30],["12:80:10",245,"أَنَّ","that","كَبِيرُهُمْ أَلَمْ تَعْلَمُوٓا۟","أَبَاكُمْ قَدْ أَخَذَ",30],["12:110:6",248,"أَنَّهُمْ","that they","ٱسْتَيْـَٔسَ ٱلرُّسُلُ وَظَنُّوٓا۟","قَدْ كُذِبُوا۟ جَآءَهُمْ",30],["13:18:10",251,"أَنَّ","that","يَسْتَجِيبُوا۟ لَهُۥ لَوْ","لَهُم مَّا فِى",30],["13:31:2",253,"أَنَّ","that was","وَلَوْ","قُرْءَانًۭا سُيِّرَتْ بِهِ",30],["13:41:3",254,"أَنَّا","that We","أَوَلَمْ يَرَوْا۟","نَأْتِى ٱلْأَرْضَ نَنقُصُهَا",30],["14:19:3",258,"أَنَّ","that","أَلَمْ تَرَ","ٱللَّهَ خَلَقَ ٱلسَّمَـٰوَٰتِ",30],["14:52:7",261,"أَنَّمَا","that only","وَلِيُنذَرُوا۟ بِهِۦ وَلِيَعْلَمُوٓا۟","هُوَ إِلَـٰهٌۭ وَٰحِدٌۭ",30],["15:49:3",264,"أَنِّىٓ","that I","۞ نَبِّئْ عِبَادِىٓ","أَنَا ٱلْغَفُورُ ٱلرَّحِيمُ",30],["15:50:1",264,"وَأَنَّ","And that","","عَذَابِى هُوَ ٱلْعَذَابُ",30],["15:66:5",265,"أَنَّ","that","إِلَيْهِ ذَٰلِكَ ٱلْأَمْرَ","دَابِرَ هَـٰٓؤُلَآءِ مَقْطُوعٌۭ",30],["15:97:3",267,"أَنَّكَ","that [you]","وَلَقَدْ نَعْلَمُ","يَضِيقُ صَدْرُكَ بِمَا",30],["16:2:13",267,"أَنَّهُۥ","that [He]","عِبَادِهِۦٓ أَنْ أَنذِرُوٓا۟","لَآ إِلَـٰهَ إِلَّآ",30],["16:23:3",269,"أَنَّ","that","لَا جَرَمَ","ٱللَّهَ يَعْلَمُ مَا",30],["16:39:9",271,"أَنَّهُمْ","that they","وَلِيَعْلَمَ ٱلَّذِينَ كَفَرُوٓا۟","كَانُوا۟ كَـٰذِبِينَ",30],["16:62:8",273,"أَنَّ","that","وَتَصِفُ أَلْسِنَتُهُمُ ٱلْكَذِبَ","لَهُمُ ٱلْحُسْنَىٰ ۖ لَا",30],["16:62:13",273,"أَنَّ","that","ٱلْحُسْنَىٰ ۖ لَا جَرَمَ","لَهُمُ ٱلنَّارَ وَأَنَّهُم",30],["16:62:16",273,"وَأَنَّهُم","and that they","أَنَّ لَهُمُ ٱلنَّارَ","مُّفْرَطُونَ",30],["16:103:3",279,"أَنَّهُمْ","that they","وَلَقَدْ نَعْلَمُ","يَقُولُونَ إِنَّمَا يُعَلِّمُهُۥ",30],["16:107:2",279,"بِأَنَّهُمُ","because","ذَٰلِكَ","ٱسْتَحَبُّوا۟ ٱلْحَيَوٰةَ ٱلدُّنْيَا",30],["16:107:8",279,"وَأَنَّ","and that","ٱلدُّنْيَا عَلَى ٱلْـَٔاخِرَةِ","ٱللَّهَ لَا يَهْدِى",30],["16:109:3",279,"أَنَّهُمْ","that they","لَا جَرَمَ","فِى ٱلْـَٔاخِرَةِ هُمُ",30],["17:9:13",283,"أَنَّ","that","ٱلَّذِينَ يَعْمَلُونَ ٱلصَّـٰلِحَـٰتِ","لَهُمْ أَجْرًۭا كَبِيرًۭا",30],["17:10:1",283,"وَأَنَّ","And that","","ٱلَّذِينَ لَا يُؤْمِنُونَ",30],["17:98:3",292,"بِأَنَّهُمْ","because they","ذَٰلِكَ جَزَآؤُهُم","كَفَرُوا۟ بِـَٔايَـٰتِنَا وَقَالُوٓا۟",30],["17:99:3",292,"أَنَّ","that","۞ أَوَلَمْ يَرَوْا۟","ٱللَّهَ ٱلَّذِى خَلَقَ",30],["18:2:12",293,"أَنَّ","that","ٱلَّذِينَ يَعْمَلُونَ ٱلصَّـٰلِحَـٰتِ","لَهُمْ أَجْرًا حَسَنًۭا",30],["18:9:3",294,"أَنَّ","that","أَمْ حَسِبْتَ","أَصْحَـٰبَ ٱلْكَهْفِ وَٱلرَّقِيمِ",30],["18:21:5",296,"أَنَّ","that","أَعْثَرْنَا عَلَيْهِمْ لِيَعْلَمُوٓا۟","وَعْدَ ٱللَّهِ حَقٌّۭ",30],["18:21:9",296,"وَأَنَّ","and that","وَعْدَ ٱللَّهِ حَقٌّۭ","ٱلسَّاعَةَ لَا رَيْبَ",30],["18:53:5",299,"أَنَّهُم","that they","ٱلْمُجْرِمُونَ ٱلنَّارَ فَظَنُّوٓا۟","مُّوَاقِعُوهَا وَلَمْ يَجِدُوا۟",30],["18:104:9",304,"أَنَّهُمْ","that they","ٱلدُّنْيَا وَهُمْ يَحْسَبُونَ","يُحْسِنُونَ صُنْعًا",30],["18:110:8",304,"أَنَّمَآ","that","مِّثْلُكُمْ يُوحَىٰٓ إِلَىَّ","إِلَـٰهُكُمْ إِلَـٰهٌۭ وَٰحِدٌۭ ۖ",30],["19:67:4",310,"أَنَّا","that We","أَوَلَا يَذْكُرُ ٱلْإِنسَـٰنُ","خَلَقْنَـٰهُ مِن قَبْلُ",30],["19:83:3",311,"أَنَّآ","that We","أَلَمْ تَرَ","أَرْسَلْنَا ٱلشَّيَـٰطِينَ عَلَى",30],["20:48:5",314,"أَنَّ","that","قَدْ أُوحِىَ إِلَيْنَآ","ٱلْعَذَابَ عَلَىٰ مَن",30],["20:66:11",316,"أَنَّهَا","that they","إِلَيْهِ مِن سِحْرِهِمْ","تَسْعَىٰ",30],["20:89:3",318,"أَلَّا","that not","أَفَلَا يَرَوْنَ","يَرْجِعُ إِلَيْهِمْ قَوْلًۭا",30],["20:119:1",320,"وَأَنَّكَ","And that you","","لَا تَظْمَؤُا۟ فِيهَا",30],["20:134:2",321,"أَنَّآ","We","وَلَوْ","أَهْلَكْنَـٰهُم بِعَذَابٍۢ مِّن",30],["21:25:10",324,"أَنَّهُۥ","that [He]","إِلَّا نُوحِىٓ إِلَيْهِ","لَآ إِلَـٰهَ إِلَّآ",30],["21:30:5",324,"أَنَّ","that","يَرَ ٱلَّذِينَ كَفَرُوٓا۟","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ كَانَتَا",30],["21:44:11",325,"أَنَّا","that We","ٱلْعُمُرُ ۗ أَفَلَا يَرَوْنَ","نَأْتِى ٱلْأَرْضَ نَنقُصُهَا",30],["21:83:5",329,"أَنِّى","Indeed, [I]","إِذْ نَادَىٰ رَبَّهُۥٓ","مَسَّنِىَ ٱلضُّرُّ وَأَنتَ",30],["21:95:5",330,"أَنَّهُمْ","that they","عَلَىٰ قَرْيَةٍ أَهْلَكْنَـٰهَآ","لَا يَرْجِعُونَ",30],["21:105:8",331,"أَنَّ","that","مِنۢ بَعْدِ ٱلذِّكْرِ","ٱلْأَرْضَ يَرِثُهَا عِبَادِىَ",30],["21:108:5",331,"أَنَّمَآ","that","إِنَّمَا يُوحَىٰٓ إِلَىَّ","إِلَـٰهُكُمْ إِلَـٰهٌۭ وَٰحِدٌۭ ۖ",30],["22:4:3",332,"أَنَّهُۥ","that he","كُتِبَ عَلَيْهِ","مَن تَوَلَّاهُ فَأَنَّهُۥ",30],["22:4:6",332,"فَأَنَّهُۥ","then indeed, he","أَنَّهُۥ مَن تَوَلَّاهُ","يُضِلُّهُۥ وَيَهْدِيهِ إِلَىٰ",30],["22:6:2",333,"بِأَنَّ","(is) because","ذَٰلِكَ","ٱللَّهَ هُوَ ٱلْحَقُّ",30],["22:6:6",333,"وَأَنَّهُۥ","And that He","ٱللَّهَ هُوَ ٱلْحَقُّ","يُحْىِ ٱلْمَوْتَىٰ وَأَنَّهُۥ",30],["22:6:9",333,"وَأَنَّهُۥ","and that He","وَأَنَّهُۥ يُحْىِ ٱلْمَوْتَىٰ","عَلَىٰ كُلِّ شَىْءٍۢ",30],["22:7:1",333,"وَأَنَّ","And that","","ٱلسَّاعَةَ ءَاتِيَةٌۭ لَّا",30],["22:7:7",333,"وَأَنَّ","and that","لَّا رَيْبَ فِيهَا","ٱللَّهَ يَبْعَثُ مَن",30],["22:10:5",333,"وَأَنَّ","and that","بِمَا قَدَّمَتْ يَدَاكَ","ٱللَّهَ لَيْسَ بِظَلَّـٰمٍۢ",30],["22:16:5",334,"وَأَنَّ","and that","أَنزَلْنَـٰهُ ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ","ٱللَّهَ يَهْدِى مَن",30],["22:18:3",334,"أَنَّ","that","أَلَمْ تَرَ","ٱللَّهَ يَسْجُدُ لَهُۥ",30],["22:39:4",337,"بِأَنَّهُمْ","because they","أُذِنَ لِلَّذِينَ يُقَـٰتَلُونَ","ظُلِمُوا۟ ۚ وَإِنَّ ٱللَّهَ",30],["22:54:5",338,"أَنَّهُ","that it","ٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ","ٱلْحَقُّ مِن رَّبِّكَ",30],["22:61:2",339,"بِأَنَّ","(is) because","ذَٰلِكَ","ٱللَّهَ يُولِجُ ٱلَّيْلَ",30],["22:61:12",339,"وَأَنَّ","And indeed","ٱلنَّهَارَ فِى ٱلَّيْلِ","ٱللَّهَ سَمِيعٌۢ بَصِيرٌۭ",30],["22:62:2",339,"بِأَنَّ","because","ذَٰلِكَ","ٱللَّهَ هُوَ ٱلْحَقُّ",30],["22:62:6",339,"وَأَنَّ","and that","ٱللَّهَ هُوَ ٱلْحَقُّ","مَا يَدْعُونَ مِن",30],["22:62:13",339,"وَأَنَّ","And that","دُونِهِۦ هُوَ ٱلْبَـٰطِلُ","ٱللَّهَ هُوَ ٱلْعَلِىُّ",30],["22:63:3",339,"أَنَّ","that","أَلَمْ تَرَ","ٱللَّهَ أَنزَلَ مِنَ",30],["22:65:3",340,"أَنَّ","that","أَلَمْ تَرَ","ٱللَّهَ سَخَّرَ لَكُم",30],["22:70:3",340,"أَنَّ","that","أَلَمْ تَعْلَمْ","ٱللَّهَ يَعْلَمُ مَا",30],["23:35:2",344,"أَنَّكُمْ","that you","أَيَعِدُكُمْ","إِذَا مِتُّمْ وَكُنتُمْ",30],["23:35:8",344,"أَنَّكُم","that you","وَكُنتُمْ تُرَابًۭا وَعِظَـٰمًا","مُّخْرَجُونَ",30],["23:55:2",345,"أَنَّمَا","that what","أَيَحْسَبُونَ","نُمِدُّهُم بِهِۦ مِن",30],["23:60:7",346,"أَنَّهُمْ","because they","ءَاتَوا۟ وَّقُلُوبُهُمْ وَجِلَةٌ","إِلَىٰ رَبِّهِمْ رَٰجِعُونَ",30],["23:111:6",349,"أَنَّهُمْ","indeed, they","ٱلْيَوْمَ بِمَا صَبَرُوٓا۟","هُمُ ٱلْفَآئِزُونَ",30],["23:114:7",349,"أَنَّكُمْ","only you","إِلَّا قَلِيلًۭا ۖ لَّوْ","كُنتُمْ تَعْلَمُونَ",30],["23:115:2",349,"أَنَّمَا","that","أَفَحَسِبْتُمْ","خَلَقْنَـٰكُمْ عَبَثًۭا وَأَنَّكُمْ",30],["23:115:5",349,"وَأَنَّكُمْ","and that you","أَنَّمَا خَلَقْنَـٰكُمْ عَبَثًۭا","إِلَيْنَا لَا تُرْجَعُونَ",30],["24:7:2",350,"أَنَّ","that","وَٱلْخَـٰمِسَةُ","لَعْنَتَ ٱللَّهِ عَلَيْهِ",30],["24:9:2",350,"أَنَّ","that","وَٱلْخَـٰمِسَةَ","غَضَبَ ٱللَّهِ عَلَيْهَآ",30],["24:10:6",350,"وَأَنَّ","and that","ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ","ٱللَّهَ تَوَّابٌ حَكِيمٌ",30],["24:20:6",351,"وَأَنَّ","And that","ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ","ٱللَّهَ رَءُوفٌۭ رَّحِيمٌۭ",30],["24:25:7",352,"أَنَّ","that","دِينَهُمُ ٱلْحَقَّ وَيَعْلَمُونَ","ٱللَّهَ هُوَ ٱلْحَقُّ",30],["24:41:3",355,"أَنَّ","that","أَلَمْ تَرَ","ٱللَّهَ يُسَبِّحُ لَهُۥ",30],["24:43:3",355,"أَنَّ","that","أَلَمْ تَرَ","ٱللَّهَ يُزْجِى سَحَابًۭا",30],["25:44:3",364,"أَنَّ","that","أَمْ تَحْسَبُ","أَكْثَرَهُمْ يَسْمَعُونَ أَوْ",30],["26:102:2",371,"أَنَّ","that","فَلَوْ","لَنَا كَرَّةًۭ فَنَكُونَ",30],["26:225:3",376,"أَنَّهُمْ","that they","أَلَمْ تَرَ","فِى كُلِّ وَادٍۢ",30],["26:226:1",376,"وَأَنَّهُمْ","And that they","","يَقُولُونَ مَا لَا",30],["27:51:6",381,"أَنَّا","that We","كَانَ عَـٰقِبَةُ مَكْرِهِمْ","دَمَّرْنَـٰهُمْ وَقَوْمَهُمْ أَجْمَعِينَ",30],["27:82:11",384,"أَنَّ","that","مِّنَ ٱلْأَرْضِ تُكَلِّمُهُمْ","ٱلنَّاسَ كَانُوا۟ بِـَٔايَـٰتِنَا",30],["27:86:3",384,"أَنَّا","that We","أَلَمْ يَرَوْا۟","جَعَلْنَا ٱلَّيْلَ لِيَسْكُنُوا۟",30],["28:13:10",386,"أَنَّ","that","وَلَا تَحْزَنَ وَلِتَعْلَمَ","وَعْدَ ٱللَّهِ حَقٌّۭ",30],["28:39:9",390,"أَنَّهُمْ","that they","بِغَيْرِ ٱلْحَقِّ وَظَنُّوٓا۟","إِلَيْنَا لَا يُرْجَعُونَ",30],["28:50:6",391,"أَنَّمَا","that only","يَسْتَجِيبُوا۟ لَكَ فَٱعْلَمْ","يَتَّبِعُونَ أَهْوَآءَهُمْ ۚ وَمَنْ",30],["28:64:11",393,"أَنَّهُمْ","[that] they","وَرَأَوُا۟ ٱلْعَذَابَ ۚ لَوْ","كَانُوا۟ يَهْتَدُونَ",30],["28:75:10",394,"أَنَّ","that","هَاتُوا۟ بُرْهَـٰنَكُمْ فَعَلِمُوٓا۟","ٱلْحَقَّ لِلَّهِ وَضَلَّ",30],["28:78:9",395,"أَنَّ","that","عِندِىٓ ۚ أَوَلَمْ يَعْلَمْ","ٱللَّهَ قَدْ أَهْلَكَ",30],["29:51:3",402,"أَنَّآ","that We","أَوَلَمْ يَكْفِهِمْ","أَنزَلْنَا عَلَيْكَ ٱلْكِتَـٰبَ",30],["29:67:3",404,"أَنَّا","that We","أَوَلَمْ يَرَوْا۟","جَعَلْنَا حَرَمًا ءَامِنًۭا",30],["30:37:3",408,"أَنَّ","that","أَوَلَمْ يَرَوْا۟","ٱللَّهَ يَبْسُطُ ٱلرِّزْقَ",30],["31:20:3",413,"أَنَّ","that","أَلَمْ تَرَوْا۟","ٱللَّهَ سَخَّرَ لَكُم",30],["31:27:2",413,"أَنَّمَا","whatever","وَلَوْ","فِى ٱلْأَرْضِ مِن",30],["31:29:3",414,"أَنَّ","that","أَلَمْ تَرَ","ٱللَّهَ يُولِجُ ٱلَّيْلَ",30],["31:29:21",414,"وَأَنَّ","and that","إِلَىٰٓ أَجَلٍۢ مُّسَمًّۭى","ٱللَّهَ بِمَا تَعْمَلُونَ",30],["31:30:2",414,"بِأَنَّ","(is) because","ذَٰلِكَ","ٱللَّهَ هُوَ ٱلْحَقُّ",30],["31:30:6",414,"وَأَنَّ","and that","ٱللَّهَ هُوَ ٱلْحَقُّ","مَا يَدْعُونَ مِن",30],["31:30:12",414,"وَأَنَّ","and that","مِن دُونِهِ ٱلْبَـٰطِلُ","ٱللَّهَ هُوَ ٱلْعَلِىُّ",30],["31:31:3",414,"أَنَّ","that","أَلَمْ تَرَ","ٱلْفُلْكَ تَجْرِى فِى",30],["32:27:3",417,"أَنَّا","that We","أَوَلَمْ يَرَوْا۟","نَسُوقُ ٱلْمَآءَ إِلَى",30],["33:20:10",420,"أَنَّهُم","that they (were)","ٱلْأَحْزَابُ يَوَدُّوا۟ لَوْ","بَادُونَ فِى ٱلْأَعْرَابِ",30],["33:47:3",424,"بِأَنَّ","that","وَبَشِّرِ ٱلْمُؤْمِنِينَ","لَهُم مِّنَ ٱللَّهِ",30],["35:27:3",437,"أَنَّ","that","أَلَمْ تَرَ","ٱللَّهَ أَنزَلَ مِنَ",30],["36:31:8",442,"أَنَّهُمْ","That they","قَبْلَهُم مِّنَ ٱلْقُرُونِ","إِلَيْهِمْ لَا يَرْجِعُونَ",30],["36:41:3",443,"أَنَّا","(is) that","وَءَايَةٌۭ لَّهُمْ","حَمَلْنَا ذُرِّيَّتَهُمْ فِى",30],["36:71:3",445,"أَنَّا","that We","أَوَلَمْ يَرَوْا۟","خَلَقْنَا لَهُم مِّمَّا",30],["36:77:4",445,"أَنَّا","that We","أَوَلَمْ يَرَ ٱلْإِنسَـٰنُ","خَلَقْنَـٰهُ مِن نُّطْفَةٍۢ",30],["37:102:11",449,"أَنِّىٓ","that I am","أَرَىٰ فِى ٱلْمَنَامِ","أَذْبَحُكَ فَٱنظُرْ مَاذَا",30],["37:143:2",451,"أَنَّهُۥ","that he","فَلَوْلَآ","كَانَ مِنَ ٱلْمُسَبِّحِينَ",30],["37:168:2",452,"أَنَّ","that","لَوْ","عِندَنَا ذِكْرًۭا مِّنَ",30],["38:24:26",454,"أَنَّمَا","that","هُمْ ۗ وَظَنَّ دَاوُۥدُ","فَتَنَّـٰهُ فَٱسْتَغْفَرَ رَبَّهُۥ",30],["38:41:7",455,"أَنِّى","That [I]","إِذْ نَادَىٰ رَبَّهُۥٓ","مَسَّنِىَ ٱلشَّيْطَـٰنُ بِنُصْبٍۢ",30],["38:70:5",457,"أَنَّمَآ","that only","يُوحَىٰٓ إِلَىَّ إِلَّآ","أَنَا۠ نَذِيرٌۭ مُّبِينٌ",30],["39:21:3",460,"أَنَّ","that","أَلَمْ تَرَ","ٱللَّهَ أَنزَلَ مِنَ",30],["39:47:2",463,"أَنَّ","And if","وَلَوْ","لِلَّذِينَ ظَلَمُوا۟ مَا",30],["39:52:3",464,"أَنَّ","that","أَوَلَمْ يَعْلَمُوٓا۟","ٱللَّهَ يَبْسُطُ ٱلرِّزْقَ",30],["39:57:4",465,"أَنَّ","If that","أَوْ تَقُولَ لَوْ","ٱللَّهَ هَدَىٰنِى لَكُنتُ",30],["39:58:7",465,"أَنَّ","only","تَرَى ٱلْعَذَابَ لَوْ","لِى كَرَّةًۭ فَأَكُونَ",30],["40:6:8",467,"أَنَّهُمْ","that they","عَلَى ٱلَّذِينَ كَفَرُوٓا۟","أَصْحَـٰبُ ٱلنَّارِ",30],["40:12:2",468,"بِأَنَّهُۥٓ","(is) because","ذَٰلِكُم","إِذَا دُعِىَ ٱللَّهُ",30],["40:22:2",469,"بِأَنَّهُمْ","(was) because [they]","ذَٰلِكَ","كَانَت تَّأْتِيهِمْ رُسُلُهُم",30],["40:43:3",472,"أَنَّمَا","that what","لَا جَرَمَ","تَدْعُونَنِىٓ إِلَيْهِ لَيْسَ",30],["40:43:14",472,"وَأَنَّ","and that","وَلَا فِى ٱلْـَٔاخِرَةِ","مَرَدَّنَآ إِلَى ٱللَّهِ",30],["40:43:18",472,"وَأَنَّ","and that","مَرَدَّنَآ إِلَى ٱللَّهِ","ٱلْمُسْرِفِينَ هُمْ أَصْحَـٰبُ",30],["41:6:8",477,"أَنَّمَآ","that","مِّثْلُكُمْ يُوحَىٰٓ إِلَىَّ","إِلَـٰهُكُمْ إِلَـٰهٌۭ وَٰحِدٌۭ",30],["41:15:15",478,"أَنَّ","that","قُوَّةً ۖ أَوَلَمْ يَرَوْا۟","ٱللَّهَ ٱلَّذِى خَلَقَهُمْ",30],["41:22:14",479,"أَنَّ","that","جُلُودُكُمْ وَلَـٰكِن ظَنَنتُمْ","ٱللَّهَ لَا يَعْلَمُ",30],["41:39:3",481,"أَنَّكَ","(is) that you","وَمِنْ ءَايَـٰتِهِۦٓ","تَرَى ٱلْأَرْضَ خَـٰشِعَةًۭ",30],["41:53:10",482,"أَنَّهُ","that it","حَتَّىٰ يَتَبَيَّنَ لَهُمْ","ٱلْحَقُّ ۗ أَوَلَمْ يَكْفِ",30],["41:53:15",482,"أَنَّهُۥ","that He","أَوَلَمْ يَكْفِ بِرَبِّكَ","عَلَىٰ كُلِّ شَىْءٍۢ",30],["42:18:12",485,"أَنَّهَا","that it","مُشْفِقُونَ مِنْهَا وَيَعْلَمُونَ","ٱلْحَقُّ ۗ أَلَآ إِنَّ",30],["43:37:6",492,"أَنَّهُم","that they","عَنِ ٱلسَّبِيلِ وَيَحْسَبُونَ","مُّهْتَدُونَ",30],["43:39:6",492,"أَنَّكُمْ","that you","ٱلْيَوْمَ إِذ ظَّلَمْتُمْ","فِى ٱلْعَذَابِ مُشْتَرِكُونَ",30],["43:80:3",495,"أَنَّا","that We","أَمْ يَحْسَبُونَ","لَا نَسْمَعُ سِرَّهُمْ",30],["44:22:3",497,"أَنَّ","That","فَدَعَا رَبَّهُۥٓ","هَـٰٓؤُلَآءِ قَوْمٌۭ مُّجْرِمُونَ",30],["45:35:2",502,"بِأَنَّكُمُ","(is) because you","ذَٰلِكُم","ٱتَّخَذْتُمْ ءَايَـٰتِ ٱللَّهِ",30],["46:33:3",506,"أَنَّ","that","أَوَلَمْ يَرَوْا۟","ٱللَّهَ ٱلَّذِى خَلَقَ",30],["47:3:2",507,"بِأَنَّ","(is) because","ذَٰلِكَ","ٱلَّذِينَ كَفَرُوا۟ ٱتَّبَعُوا۟",30],["47:3:7",507,"وَأَنَّ","and that","كَفَرُوا۟ ٱتَّبَعُوا۟ ٱلْبَـٰطِلَ","ٱلَّذِينَ ءَامَنُوا۟ ٱتَّبَعُوا۟",30],["47:9:2",507,"بِأَنَّهُمْ","(is) because they","ذَٰلِكَ","كَرِهُوا۟ مَآ أَنزَلَ",30],["47:11:2",507,"بِأَنَّ","(is) because","ذَٰلِكَ","ٱللَّهَ مَوْلَى ٱلَّذِينَ",30],["47:11:7",507,"وَأَنَّ","and that","مَوْلَى ٱلَّذِينَ ءَامَنُوا۟","ٱلْكَـٰفِرِينَ لَا مَوْلَىٰ",30],["47:19:2",508,"أَنَّهُۥ","that [He]","فَٱعْلَمْ","لَآ إِلَـٰهَ إِلَّا",30],["47:26:2",509,"بِأَنَّهُمْ","(is) because they","ذَٰلِكَ","قَالُوا۟ لِلَّذِينَ كَرِهُوا۟",30],["47:28:2",509,"بِأَنَّهُمُ","(is) because they","ذَٰلِكَ","ٱتَّبَعُوا۟ مَآ أَسْخَطَ",30],["49:5:2",516,"أَنَّهُمْ","they","وَلَوْ","صَبَرُوا۟ حَتَّىٰ تَخْرُجَ",30],["49:7:2",516,"أَنَّ","that","وَٱعْلَمُوٓا۟","فِيكُمْ رَسُولَ ٱللَّهِ ۚ",30],["51:23:8",521,"أَنَّكُمْ","you","لَحَقٌّۭ مِّثْلَ مَآ","تَنطِقُونَ",30],["53:40:1",527,"وَأَنَّ","And that","","سَعْيَهُۥ سَوْفَ يُرَىٰ",30],["53:42:1",527,"وَأَنَّ","And that","","إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ",30],["53:43:1",527,"وَأَنَّهُۥ","And that He","","هُوَ أَضْحَكَ وَأَبْكَىٰ",30],["53:44:1",527,"وَأَنَّهُۥ","And that He","","هُوَ أَمَاتَ وَأَحْيَا",30],["53:45:1",528,"وَأَنَّهُۥ","And that He","","خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ",30],["53:47:1",528,"وَأَنَّ","And that","","عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ",30],["53:48:1",528,"وَأَنَّهُۥ","And that He","","هُوَ أَغْنَىٰ وَأَقْنَىٰ",30],["53:49:1",528,"وَأَنَّهُۥ","And that He","","هُوَ رَبُّ ٱلشِّعْرَىٰ",30],["53:50:1",528,"وَأَنَّهُۥٓ","And that He","","أَهْلَكَ عَادًا ٱلْأُولَىٰ",30],["54:10:3",529,"أَنِّى","I am","فَدَعَا رَبَّهُۥٓ","مَغْلُوبٌۭ فَٱنتَصِرْ",30],["54:28:2",530,"أَنَّ","that","وَنَبِّئْهُمْ","ٱلْمَآءَ قِسْمَةٌۢ بَيْنَهُمْ ۖ",30],["56:82:3",537,"أَنَّكُمْ","that you","وَتَجْعَلُونَ رِزْقَكُمْ","تُكَذِّبُونَ",30],["57:17:2",539,"أَنَّ","that","ٱعْلَمُوٓا۟","ٱللَّهَ يُحْىِ ٱلْأَرْضَ",30],["57:20:2",540,"أَنَّمَا","that","ٱعْلَمُوٓا۟","ٱلْحَيَوٰةُ ٱلدُّنْيَا لَعِبٌۭ",30],["57:29:12",541,"وَأَنَّ","and that","مِّن فَضْلِ ٱللَّهِ ۙ","ٱلْفَضْلَ بِيَدِ ٱللَّهِ",30],["58:7:3",543,"أَنَّ","that","أَلَمْ تَرَ","ٱللَّهَ يَعْلَمُ مَا",30],["58:18:11",544,"أَنَّهُمْ","that they","يَحْلِفُونَ لَكُمْ ۖ وَيَحْسَبُونَ","عَلَىٰ شَىْءٍ ۚ أَلَآ",30],["59:2:18",545,"أَنَّهُم","that [they]","أَن يَخْرُجُوا۟ ۖ وَظَنُّوٓا۟","مَّانِعَتُهُمْ حُصُونُهُم مِّنَ",30],["59:4:2",546,"بِأَنَّهُمْ","(is) because [they]","ذَٰلِكَ","شَآقُّوا۟ ٱللَّهَ وَرَسُولَهُۥ ۖ",30],["59:13:9",547,"بِأَنَّهُمْ","(is) because they","مِّنَ ٱللَّهِ ۚ ذَٰلِكَ","قَوْمٌۭ لَّا يَفْقَهُونَ",30],["59:14:20",547,"بِأَنَّهُمْ","(is) because they","وَقُلُوبُهُمْ شَتَّىٰ ۚ ذَٰلِكَ","قَوْمٌۭ لَّا يَعْقِلُونَ",30],["59:17:3",548,"أَنَّهُمَا","that they","فَكَانَ عَـٰقِبَتَهُمَآ","فِى ٱلنَّارِ خَـٰلِدَيْنِ",30],["61:5:10",551,"أَنِّى","that I am","تُؤْذُونَنِى وَقَد تَّعْلَمُونَ","رَسُولُ ٱللَّهِ إِلَيْكُمْ ۖ",30],["62:6:7",553,"أَنَّكُمْ","that you","هَادُوٓا۟ إِن زَعَمْتُمْ","أَوْلِيَآءُ لِلَّهِ مِن",30],["63:3:2",554,"بِأَنَّهُمْ","(is) because","ذَٰلِكَ","ءَامَنُوا۟ ثُمَّ كَفَرُوا۟",30],["64:6:2",556,"بِأَنَّهُۥ","(is) because","ذَٰلِكَ","كَانَت تَّأْتِيهِمْ رُسُلُهُم",30],["65:12:13",559,"أَنَّ","that","ٱلْأَمْرُ بَيْنَهُنَّ لِتَعْلَمُوٓا۟","ٱللَّهَ عَلَىٰ كُلِّ",30],["65:12:19",559,"وَأَنَّ","And that","كُلِّ شَىْءٍۢ قَدِيرٌۭ","ٱللَّهَ قَدْ أَحَاطَ",30],["69:20:3",567,"أَنِّى","that I","إِنِّى ظَنَنتُ","مُلَـٰقٍ حِسَابِيَهْ",30],["69:49:3",568,"أَنَّ","that","وَإِنَّا لَنَعْلَمُ","مِنكُم مُّكَذِّبِينَ",30],["72:1:4",572,"أَنَّهُ","that","قُلْ أُوحِىَ إِلَىَّ","ٱسْتَمَعَ نَفَرٌۭ مِّنَ",30],["72:3:1",572,"وَأَنَّهُۥ","And that He","","تَعَـٰلَىٰ جَدُّ رَبِّنَا",30],["72:4:1",572,"وَأَنَّهُۥ","And that he","","كَانَ يَقُولُ سَفِيهُنَا",30],["72:5:1",572,"وَأَنَّا","And that we","","ظَنَنَّآ أَن لَّن",30],["72:6:1",572,"وَأَنَّهُۥ","And that","","كَانَ رِجَالٌۭ مِّنَ",30],["72:7:1",572,"وَأَنَّهُمْ","And that they","","ظَنُّوا۟ كَمَا ظَنَنتُمْ",30],["72:8:1",572,"وَأَنَّا","And that we","","لَمَسْنَا ٱلسَّمَآءَ فَوَجَدْنَـٰهَا",30],["72:9:1",572,"وَأَنَّا","And that we","","كُنَّا نَقْعُدُ مِنْهَا",30],["72:10:1",572,"وَأَنَّا","And that we","","لَا نَدْرِىٓ أَشَرٌّ",30],["72:11:1",572,"وَأَنَّا","And that [we]","","مِنَّا ٱلصَّـٰلِحُونَ وَمِنَّا",30],["72:12:1",572,"وَأَنَّا","And that we","","ظَنَنَّآ أَن لَّن",30],["72:13:1",572,"وَأَنَّا","And that [we]","","لَمَّا سَمِعْنَا ٱلْهُدَىٰٓ",30],["72:14:1",573,"وَأَنَّا","And that we","","مِنَّا ٱلْمُسْلِمُونَ وَمِنَّا",30],["72:18:1",573,"وَأَنَّ","And that","","ٱلْمَسَـٰجِدَ لِلَّهِ فَلَا",30],["72:19:1",573,"وَأَنَّهُۥ","And that","","لَمَّا قَامَ عَبْدُ",30],["73:20:4",575,"أَنَّكَ","that you","۞ إِنَّ رَبَّكَ يَعْلَمُ","تَقُومُ أَدْنَىٰ مِن",30],["75:28:2",578,"أَنَّهُ","that it","وَظَنَّ","ٱلْفِرَاقُ",30],["80:25:1",585,"اَنَّا","That [We]","","صَبَبْنَا ٱلْمَآءَ صَبًّۭا",30],["83:4:4",587,"أَنَّهُم","that they","أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ","مَّبْعُوثُونَ",30],["96:14:3",598,"بِأَنَّ","that","أَلَمْ يَعْلَم","ٱللَّهَ يَرَىٰ",30],["99:5:1",599,"بِأَنَّ","Because","","رَبَّكَ أَوْحَىٰ لَهَا",30],["104:3:2",601,"أَنَّ","that","يَحْسَبُ","مَالَهُۥٓ أَخْلَدَهُۥ",30]]