[["23:101:6",348,"أَنسَابَ","(there) will be relationship","فِى ٱلصُّورِ فَلَآ","بَيْنَهُمْ يَوْمَئِذٍۢ وَلَا",1944],["25:54:8",364,"نَسَبًۭا","blood relationship","ٱلْمَآءِ بَشَرًۭا فَجَعَلَهُۥ","وَصِهْرًۭا ۗ وَكَانَ رَبُّكَ",1944],["37:158:5",452,"نَسَبًۭا ۚ","a relationship","بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ","وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ",1944]]