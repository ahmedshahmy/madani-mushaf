[["2:164:29",25,"وَبَثَّ","and dispersing","ٱلْأَرْضَ بَعْدَ مَوْتِهَا","فِيهَا مِن كُلِّ",1325],["4:1:13",77,"وَبَثَّ","and dispersed","وَخَلَقَ مِنْهَا زَوْجَهَا","مِنْهُمَا رِجَالًۭا كَثِيرًۭا",1325],["12:86:4",245,"بَثِّى","(of) my suffering","قَالَ إِنَّمَآ أَشْكُوا۟","وَحُزْنِىٓ إِلَى ٱللَّهِ",3348],["31:10:13",411,"وَبَثَّ","and He dispersed","أَن تَمِيدَ بِكُمْ","فِيهَا مِن كُلِّ",1325],["42:29:7",486,"بَثَّ","He has dispersed","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا","فِيهِمَا مِن دَآبَّةٍۢ ۚ",1325],["45:4:4",499,"يَبُثُّ","He disperses","وَفِى خَلْقِكُمْ وَمَا","مِن دَآبَّةٍ ءَايَـٰتٌۭ",1325],["56:6:3",534,"مُّنۢبَثًّۭا","dispersing","فَكَانَتْ هَبَآءًۭ","",3973],["88:16:2",592,"مَبْثُوثَةٌ","spread out","وَزَرَابِىُّ","",3656],["101:4:5",600,"ٱلْمَبْثُوثِ","scattered","يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ","",3655]]