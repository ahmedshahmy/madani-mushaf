ِثْهُنَّ إِنسٌۭ قَبْلَهُمْ",32],["57:14:2",539,"أَلَمْ","Were not","يُنَادُونَهُمْ","نَكُن مَّعَكُمْ ۖ قَالُوا۟",32],["57:16:1",539,"۞ أَلَمْ","Has not","","يَأْنِ لِلَّذِينَ ءَامَنُوٓا۟",32],["58:4:2",542,"لَّمْ","(does) not","فَمَن","يَجِدْ فَصِيَامُ شَهْرَيْنِ",32],["58:4:12",542,"لَّمْ","not","أَن يَتَمَآسَّا ۖ فَمَن","يَسْتَطِعْ فَإِطْعَامُ سِتِّينَ",32],["58:7:1",543,"أَلَمْ","Do not","","تَرَ أَنَّ ٱللَّهَ",32],["58:8:1",543,"أَلَمْ","Do not","","تَرَ إِلَى ٱلَّذِينَ",32],["58:8:22",543,"لَمْ","not","جَآءُوكَ حَيَّوْكَ بِمَا","يُحَيِّكَ بِهِ ٱللَّهُ",32],["58:12:17",544,"لَّمْ","not","لَّكُمْ وَأَطْهَرُ ۚ فَإِن","تَجِدُوا۟ فَإِنَّ ٱللَّهَ",32],["58:13:9",544,"لَمْ","you do not","نَجْوَىٰكُمْ صَدَقَـٰتٍۢ ۚ فَإِذْ","تَفْعَلُوا۟ وَتَابَ ٱللَّهُ",32],["58:14:1",544,"۞ أَلَمْ","Do not","","تَرَ إِلَى ٱلَّذِينَ",32],["59:2:27",545,"لَمْ","not","ٱللَّهُ مِنْ حَيْثُ","يَحْتَسِبُوا۟ ۖ وَقَذَفَ فِى",32],["59:11:1",547,"۞ أَلَمْ","Do not","","تَرَ إِلَى ٱلَّذِينَ",32],["60:8:6",550,"لَمْ","(do) not","ٱللَّهُ عَنِ ٱلَّذِينَ","يُقَـٰتِلُوكُمْ فِى ٱلدِّينِ",32],["60:8:10",550,"وَلَمْ","and (do) not","يُقَـٰتِلُوكُمْ فِى ٱلدِّينِ","يُخْرِجُوكُم مِّن دِيَـٰرِكُمْ",32],["62:3:3",553,"لَمَّا","who have not yet","وَءَاخَرِينَ مِنْهُمْ","يَلْحَقُوا۟ بِهِمْ ۚ وَهُوَ",32],["62:5:6",553,"لَمْ","not","حُمِّلُوا۟ ٱلتَّوْرَىٰةَ ثُمَّ","يَحْمِلُوهَا كَمَثَلِ ٱلْحِمَارِ",32],["63:6:6",555,"لَمْ","(do) not","أَسْتَغْفَرْتَ لَهُمْ أَمْ","تَسْتَغْفِرْ لَهُمْ لَن",32],["64:5:1",556,"أَلَمْ","Has not","","يَأْتِكُمْ نَبَؤُا۟ ٱلَّذِينَ",32],["65:4:13",558,"لَمْ","not","ثَلَـٰثَةُ أَشْهُرٍۢ وَٱلَّـٰٓـِٔى","يَحِضْنَ ۚ وَأُو۟لَـٰتُ ٱلْأَحْمَالِ",32],["66:10:17",561,"فَلَمْ","so not","عِبَادِنَا صَـٰلِحَيْنِ فَخَانَتَاهُمَا","يُغْنِيَا عَنْهُمَا مِنَ",32],["67:8:11",562,"أَلَمْ","Did not","فَوْجٌۭ سَأَلَهُمْ خَزَنَتُهَآ","يَأْتِكُمْ نَذِيرٌۭ",32],["67:19:1",563,"أَوَلَمْ","Do not","","يَرَوْا۟ إِلَى ٱلطَّيْرِ",32],["68:28:3",565,"أَلَمْ","Did not","قَالَ أَوْسَطُهُمْ","أَقُل لَّكُمْ لَوْلَا",32],["69:25:8",567,"لَمْ","not","بِشِمَالِهِۦ فَيَقُولُ يَـٰلَيْتَنِى","أُوتَ كِتَـٰبِيَهْ",32],["69:26:1",567,"وَلَمْ","And not","","أَدْرِ مَا حِسَابِيَهْ",32],["71:6:1",570,"فَلَمْ","But not","","يَزِدْهُمْ دُعَآءِىٓ إِلَّا",32],["71:15:1",571,"أَلَمْ","Do not","","تَرَوْا۟ كَيْفَ خَلَقَ",32],["71:21:8",571,"لَّمْ","(did) not","عَصَوْنِى وَٱتَّبَعُوا۟ مَن","يَزِدْهُ مَالُهُۥ وَوَلَدُهُۥٓ",32],["71:25:6",571,"فَلَمْ","and not","أُغْرِقُوا۟ فَأُدْخِلُوا۟ نَارًۭا","يَجِدُوا۟ لَهُم مِّن",32],["74:43:2",576,"لَمْ","Not","قَالُوا۟","نَكُ مِنَ ٱلْمُصَلِّينَ",32],["74:44:1",576,"وَلَمْ","And not","","نَكُ نُطْعِمُ ٱلْمِسْكِينَ",32],["75:37:1",578,"أَلَمْ","Was not","","يَكُ نُطْفَةًۭ مِّن",32],["76:1:8",578,"لَمْ","not","حِينٌۭ مِّنَ ٱلدَّهْرِ","يَكُن شَيْـًۭٔا مَّذْكُورًا",32],["77:16:1",580,"أَلَمْ","Did not","","نُهْلِكِ ٱلْأَوَّلِينَ",32],["77:20:1",581,"أَلَمْ","Did not","","نَخْلُقكُّم مِّن مَّآءٍۢ",32],["77:25:1",581,"أَلَمْ","Have not","","نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",32],["78:6:1",582,"أَلَمْ","Have not","","نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًۭا",32],["79:46:4",584,"لَمْ","not","كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا","يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً",32],["80:23:2",585,"لَمَّا","Not","كَلَّا","يَقْضِ مَآ أَمَرَهُۥ",32],["85:10:7",590,"لَمْ","not","ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ثُمَّ","يَتُوبُوا۟ فَلَهُمْ عَذَابُ",32],["89:6:1",593,"أَلَمْ","Did not","","تَرَ كَيْفَ فَعَلَ",32],["89:8:2",593,"لَمْ","not","ٱلَّتِى","يُخْلَقْ مِثْلُهَا فِى",32],["90:7:3",594,"لَّمْ","not","أَيَحْسَبُ أَن","يَرَهُۥٓ أَحَدٌ",32],["90:8:1",594,"أَلَمْ","Have not","","نَجْعَل لَّهُۥ عَيْنَيْنِ",32],["93:6:1",596,"أَلَمْ","Did not","","يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ",32],["94:1:1",596,"أَلَمْ","Have not","","نَشْرَحْ لَكَ صَدْرَكَ",32],["96:5:4",597,"لَمْ","not","عَلَّمَ ٱلْإِنسَـٰنَ مَا","يَعْلَمْ",32],["96:14:1",598,"أَلَمْ","Does not","","يَعْلَم بِأَنَّ ٱللَّهَ",32],["96:15:3",598,"لَّمْ","not","كَلَّا لَئِن","يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",32],["98:1:1",598,"لَمْ","Not","","يَكُنِ ٱلَّذِي