[["2:6:8",3,"لَمْ","not","عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ","تُنذِرْهُمْ لَا يُؤْمِنُونَ",32],["2:24:2",4,"لَّمْ","not","فَإِن","تَفْعَلُوا۟ وَلَن تَفْعَلُوا۟",32],["2:33:9",6,"أَلَمْ","Did not","أَنۢبَأَهُم بِأَسْمَآئِهِمْ قَالَ","أَقُل لَّكُمْ إِنِّىٓ",32],["2:106:12",17,"أَلَمْ","Do not","مِّنْهَآ أَوْ مِثْلِهَآ ۗ","تَعْلَمْ أَنَّ ٱللَّهَ",32],["2:107:1",17,"أَلَمْ","Do not","","تَعْلَمْ أَنَّ ٱللَّهَ",32],["2:151:15",23,"لَمْ","not","وَٱلْحِكْمَةَ وَيُعَلِّمُكُم مَّا","تَكُونُوا۟ تَعْلَمُونَ",32],["2:196:46",30,"لَّمْ","(can) not","مِنَ ٱلْهَدْىِ ۚ فَمَن","يَجِدْ فَصِيَامُ ثَلَـٰثَةِ",32],["2:196:61",30,"لَّمْ","not","كَامِلَةٌۭ ۗ ذَٰلِكَ لِمَن","يَكُنْ أَهْلُهُۥ حَاضِرِى",32],["2:236:8",38,"لَمْ","not","طَلَّقْتُمُ ٱلنِّسَآءَ مَا","تَمَسُّوهُنَّ أَوْ تَفْرِضُوا۟",32],["2:239:13",39,"لَمْ","not","كَمَا عَلَّمَكُم مَّا","تَكُونُوا۟ تَعْلَمُونَ",32],["2:243:1",39,"۞ أَلَمْ","Did not","","تَرَ إِلَى ٱلَّذِينَ",32],["2:246:1",40,"أَلَمْ","Did not","","تَرَ إِلَى ٱلْمَلَإِ",32],["2:247:21",40,"وَلَمْ","and not","أَحَقُّ بِٱلْمُلْكِ مِنْهُ","يُؤْتَ سَعَةًۭ مِّنَ",32],["2:249:16",41,"لَّمْ","(does) not","فَلَيْسَ مِنِّى وَمَن","يَطْعَمْهُ فَإِنَّهُۥ مِنِّىٓ",32],["2:258:1",43,"أَلَمْ","Did not","","تَرَ إِلَى ٱلَّذِى",32],["2:259:41",43,"لَمْ","(they did) not","إِلَىٰ طَعَامِكَ وَشَرَابِكَ","يَتَسَنَّهْ ۖ وَٱنظُرْ إِلَىٰ",32],["2:260:10",44,"أَوَلَمْ","Have not","تُحْىِ ٱلْمَوْتَىٰ ۖ قَالَ","تُؤْمِن ۖ قَالَ بَلَىٰ",32],["2:265:20",45,"لَّمْ","(does) not","أُكُلَهَا ضِعْفَيْنِ فَإِن","يُصِبْهَا وَابِلٌۭ فَطَلٌّۭ ۗ",32],["2:279:2",47,"لَّمْ","not","فَإِن","تَفْعَلُوا۟ فَأْذَنُوا۟ بِحَرْبٍۢ",32],["2:282:57",48,"لَّمْ","not","مِن رِّجَالِكُمْ ۖ فَإِن","يَكُونَا رَجُلَيْنِ فَرَجُلٌۭ",32],["2:283:5",49,"وَلَمْ","and not","كُنتُمْ عَلَىٰ سَفَرٍۢ","تَجِدُوا۟ كَاتِبًۭا فَرِهَـٰنٌۭ",32],["3:23:1",53,"أَلَمْ","Have not","","تَرَ إِلَى ٱلَّذِينَ",32],["3:47:7",56,"وَلَمْ","and (has) not","يَكُونُ لِى وَلَدٌۭ","يَمْسَسْنِى بَشَرٌۭ ۖ قَالَ",32],["3:135:17",67,"وَلَمْ","And not","ٱلذُّنُوبَ إِلَّا ٱللَّهُ","يُصِرُّوا۟ عَلَىٰ مَا",32],["3:151:11",69,"لَمْ","not","أَشْرَكُوا۟ بِٱللَّهِ مَا","يُنَزِّلْ بِهِۦ سُلْطَـٰنًۭا ۖ",32],["3:170:9",72,"لَمْ","(have) not","فَضْلِهِۦ وَيَسْتَبْشِرُونَ بِٱلَّذِينَ","يَلْحَقُوا۟ بِهِم مِّنْ",32],["3:174:6",73,"لَّمْ","not","مِّنَ ٱللَّهِ وَفَضْلٍۢ","يَمْسَسْهُمْ سُوٓءٌۭ وَٱتَّبَعُوا۟",32],["3:188:11",75,"لَمْ","not","أَن يُحْمَدُوا۟ بِمَا","يَفْعَلُوا۟ فَلَا تَحْسَبَنَّهُم",32],["4:11:35",78,"لَّمْ","not","لَهُۥ وَلَدٌۭ ۚ فَإِن","يَكُن لَّهُۥ وَلَدٌۭ",32],["4:12:7",79,"لَّمْ","not","تَرَكَ أَزْوَٰجُكُمْ إِن","يَكُن لَّهُنَّ وَلَدٌۭ ۚ",32],["4:12:31",79,"لَّمْ","not","مِمَّا تَرَكْتُمْ إِن","يَكُن لَّكُمْ وَلَدٌۭ ۚ",32],["4:23:30",81,"لَّمْ","not","دَخَلْتُم بِهِنَّ فَإِن","تَكُونُوا۟ دَخَلْتُم بِهِنَّ",32],["4:25:2",82,"لَّمْ","(is) not","وَمَن","يَسْتَطِعْ مِنكُمْ طَوْلًا",32],["4:43:35",85,"فَلَمْ","and not","أَوْ لَـٰمَسْتُمُ ٱلنِّسَآءَ","تَجِدُوا۟ مَآءًۭ فَتَيَمَّمُوا۟",32],["4:44:1",85,"أَلَمْ","Did not","","تَرَ إِلَى ٱلَّذِينَ",32],["4:49:1",86,"أَلَمْ","Do not","","تَرَ إِلَى ٱلَّذِينَ",32],["4:51:1",86,"أَلَمْ","Do not","","تَرَ إِلَى ٱلَّذِينَ",32],["4:60:1",88,"أَلَمْ","Do not","","تَرَ إِلَى ٱلَّذِينَ",32],["4:72:14",89,"لَمْ","(that) not","ٱللَّهُ عَلَىَّ إِذْ","أَكُن مَّعَهُمْ شَهِيدًۭا",32],["4:73:8",89,"لَّمْ","(had) not","ٱللَّهِ لَيَقُولَنَّ كَأَن","تَكُنۢ بَيْنَكُمْ وَبَيْنَهُۥ",32],["4:77:1",90,"أَلَمْ","Have not","","تَرَ إِلَى ٱلَّذِينَ",32],["4:90:26",92,"فَلَمْ","and (do) not","فَلَقَـٰتَلُوكُمْ ۚ فَإِنِ ٱعْتَزَلُوكُمْ","يُقَـٰتِلُوكُمْ وَأَلْقَوْا۟ إِلَيْكُمُ",32],["4:91:16",92,"لَّمْ","not","أُرْكِسُوا۟ فِيهَا ۚ فَإِن","يَعْتَزِلُوكُمْ وَيُلْقُوٓا۟ إِلَيْكُمُ",32],["4:92:49",93,"لَّمْ","(does) not","رَقَبَةٍۢ مُّؤْمِنَةٍۢ ۖ فَمَن","يَجِدْ فَصِيَامُ شَهْرَيْنِ",32],["4:97:16",94,"أَلَمْ","Not","فِى ٱلْأَرْضِ ۚ قَالُوٓا۟","تَكُنْ أَرْضُ ٱللَّهِ",32],["4:102:21",95,"لَمْ","(which has) not","وَلْتَأْتِ طَآئِفَةٌ أُخْرَىٰ","يُصَلُّوا۟ فَلْيُصَلُّوا۟ مَعَكَ",32],["4:113:26",96,"لَمْ","not","وَٱلْحِكْمَةَ وَعَلَّمَكَ مَا","تَكُن تَعْلَمُ ۚ وَكَانَ",32],["4:137:13",100,"لَّمْ","not","ثُمَّ ٱزْدَادُوا۟ كُفْرًۭا","يَكُنِ ٱللَّهُ لِيَغْفِرَ",32],["4:141:11",101,"أَلَمْ","Were not","مِّنَ ٱللَّهِ قَالُوٓا۟","نَكُن مَّعَكُمْ وَإِن",32],["4:141:19",101,"أَلَمْ","Did not","لِلْكَـٰفِرِينَ نَصِيبٌۭ قَالُوٓا۟","نَسْتَحْوِذْ عَلَيْكُمْ وَنَمْنَعْكُم",32],["4:152:5",102,"وَلَمْ","and not","ءَامَنُوا۟ بِٱللَّهِ وَرُسُلِهِۦ","يُفَرِّقُوا۟ بَيْنَ أَحَدٍۢ",32],["4:164:8",104,"لَّمْ","not","مِن قَبْلُ وَرُسُلًۭا","نَقْصُصْهُمْ عَلَيْكَ ۚ وَكَلَّمَ",32],["4:168:5",104,"لَمْ","not","ٱلَّذِينَ كَفَرُوا۟ وَظَلَمُوا۟","يَكُنِ ٱللَّهُ لِيَغْفِرَ",32],["4:176:22",106,"لَّمْ","not","وَهُوَ يَرِثُهَآ إِن","يَكُن لَّهَا وَلَدٌۭ ۚ",32],["5:6:37",108,"فَلَمْ","and not","أَوْ لَـٰمَسْتُمُ ٱلنِّسَآءَ","تَجِدُوا۟ مَآءًۭ فَتَيَمَّمُوا۟",32],["5:20:18",111,"لَمْ","not","مُّلُوكًۭا وَءَاتَىٰكُم مَّا","يُؤْتِ أَحَدًۭا مِّنَ",32],["5:27:13",112,"وَلَمْ","and not","فَتُقُبِّلَ مِنْ أَحَدِهِمَا","يُتَقَبَّلْ مِنَ ٱلْـَٔاخَرِ",32],["5:40:1",114,"أَلَمْ","Do not","","تَعْلَمْ أَنَّ ٱللَّهَ",32],["5:41:14",114,"وَلَمْ","and not","قَالُوٓا۟ ءَامَنَّا بِأَفْوَٰهِهِمْ","تُؤْمِن قُلُوبُهُمْ ۛ وَمِنَ",32],["5:41:25",114,"لَمْ","(who have) not","سَمَّـٰعُونَ لِقَوْمٍ ءَاخَرِينَ","يَأْتُوكَ ۖ يُحَرِّفُونَ ٱلْكَلِمَ",32],["5:41:38",114,"لَّمْ","not","هَـٰذَا فَخُذُوهُ وَإِن","تُؤْتَوْهُ فَٱحْذَرُوا۟ ۚ وَمَن",32],["5:41:53",114,"لَمْ","never","شَيْـًٔا ۚ أُو۟لَـٰٓئِكَ ٱلَّذِينَ","يُرِدِ ٱللَّهُ أَن",32],["5:44:34",115,"لَّمْ","(does) not","ثَمَنًۭا قَلِيلًۭا ۚ وَمَن","يَحْكُم بِمَآ أَنزَلَ",32],["5:45:24",115,"لَّمْ","(does) not","كَفَّارَةٌۭ لَّهُۥ ۚ وَمَن","يَحْكُم بِمَآ أَنزَلَ",32],["5:47:9",116,"لَّمْ","(does) not","ٱللَّهُ فِيهِ ۚ وَمَن","يَحْكُم بِمَآ أَنزَلَ",32],["5:67:10",119,"لَّمْ","not","مِن رَّبِّكَ ۖ وَإِن","تَفْعَلْ فَمَا بَلَّغْتَ",32],["5:73:16",120,"لَّمْ","not","إِلَـٰهٌۭ وَٰحِدٌۭ ۚ وَإِن","يَنتَهُوا۟ عَمَّا يَقُولُونَ",32],["5:89:27",122,"لَّمْ","(does) not","تَحْرِيرُ رَقَبَةٍۢ ۖ فَمَن","يَجِدْ فَصِيَامُ ثَلَـٰثَةِ",32],["6:6:1",128,"أَلَمْ","Did not","","يَرَوْا۟ كَمْ أَهْلَكْنَا",32],["6:6:13",128,"لَمْ","not","فِى ٱلْأَرْضِ مَا","نُمَكِّن لَّكُمْ وَأَرْسَلْنَا",32],["6:23:2",130,"لَمْ","not","ثُمَّ","تَكُن فِتْنَتُهُمْ إِلَّآ",32],["6:77:12",137,"لَّمْ","(does) not","أَفَلَ قَالَ لَئِن","يَهْدِنِى رَبِّى لَأَكُونَنَّ",32],["6:81:11",137,"لَمْ","not","أَشْرَكْتُم بِٱللَّهِ مَا","يُنَزِّلْ بِهِۦ عَلَيْكُمْ",32],["6:82:3",138,"وَلَمْ","and (did) not","ٱلَّذِينَ ءَامَنُوا۟","يَلْبِسُوٓا۟ إِيمَـٰنَهُم بِظُلْمٍ",32],["6:91:33",139,"لَمْ","not","كَثِيرًۭا ۖ وَعُلِّمْتُم مَّا","تَعْلَمُوٓا۟ أَنتُمْ وَلَآ",32],["6:93:12",139,"وَلَمْ","while not","قَالَ أُوحِىَ إِلَىَّ","يُوحَ إِلَيْهِ شَىْءٌۭ",32],["6:101:8",140,"وَلَمْ","while not","يَكُونُ لَهُۥ وَلَدٌۭ","تَكُن لَّهُۥ صَـٰحِبَةٌۭ ۖ",32],["6:110:5",141,"لَمْ","not","أَفْـِٔدَتَهُمْ وَأَبْصَـٰرَهُمْ كَمَا","يُؤْمِنُوا۟ بِهِۦٓ أَوَّلَ",32],["6:121:4",143,"لَمْ","not","وَلَا تَأْكُلُوا۟ مِمَّا","يُذْكَرِ ٱسْمُ ٱللَّهِ",32],["6:130:4",144,"أَلَمْ","Did (there) not","يَـٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ","يَأْتِكُمْ رُسُلٌۭ مِّنكُمْ",32],["6:131:3",145,"لَّمْ","not","ذَٰلِكَ أَن","يَكُن رَّبُّكَ مُهْلِكَ",32],["6:158:24",150,"لَمْ","not","يَنفَعُ نَفْسًا إِيمَـٰنُهَا","تَكُنْ ءَامَنَتْ مِن",32],["7:11:13",151,"لَمْ","Not","فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ","يَكُن مِّنَ ٱلسَّـٰجِدِينَ",32],["7:22:17",152,"أَلَمْ","Did not","ٱلْجَنَّةِ ۖ وَنَادَىٰهُمَا رَبُّهُمَآ","أَنْهَكُمَا عَن تِلْكُمَا",32],["7:23:6",153,"لَّمْ","not","ظَلَمْنَآ أَنفُسَنَا وَإِن","تَغْفِرْ لَنَا وَتَرْحَمْنَا",32],["7:33:19",154,"لَمْ","not","تُشْرِكُوا۟ بِٱللَّهِ مَا","يُنَزِّلْ بِهِۦ سُلْطَـٰنًۭا",32],["7:46:15",156,"لَمْ","Not","أَن سَلَـٰمٌ عَلَيْكُمْ ۚ","يَدْخُلُوهَا وَهُمْ يَطْمَعُونَ",32],["7:87:10",161,"لَّمْ","not","أُرْسِلْتُ بِهِۦ وَطَآئِفَةٌۭ","يُؤْمِنُوا۟ فَٱصْبِرُوا۟ حَتَّىٰ",32],["7:92:5",162,"لَّمْ","not","كَذَّبُوا۟ شُعَيْبًۭا كَأَن","يَغْنَوْا۟ فِيهَا ۚ ٱلَّذِينَ",32],["7:100:1",163,"أَوَلَمْ","Would it not","","يَهْدِ لِلَّذِينَ يَرِثُونَ",32],["7:148:12",168,"أَلَمْ","Did not","جَسَدًۭا لَّهُۥ خُوَارٌ ۚ","يَرَوْا۟ أَنَّهُۥ لَا",32],["7:149:11",168,"لَّمْ","not","ضَلُّوا۟ قَالُوا۟ لَئِن","يَرْحَمْنَا رَبُّنَا وَيَغْفِرْ",32],["7:169:19",172,"أَلَمْ","Was not","عَرَضٌۭ مِّثْلُهُۥ يَأْخُذُوهُ ۚ","يُؤْخَذْ عَلَيْهِم مِّيثَـٰقُ",32],["7:184:1",174,"أَوَلَمْ","Do not","","يَتَفَكَّرُوا۟ ۗ مَا بِصَاحِبِهِم",32],["7:185:1",174,"أَوَلَمْ","Do not","","يَنظُرُوا۟ فِى مَلَكُوتِ",32],["7:203:2",176,"لَمْ","not","وَإِذَا","تَأْتِهِم بِـَٔايَةٍۢ قَالُوا۟",32],["8:17:1",179,"فَلَمْ","And not","","تَقْتُلُوهُمْ وَلَـٰكِنَّ ٱللَّهَ",32],["8:53:4",184,"لَمْ","not","ذَٰلِكَ بِأَنَّ ٱللَّهَ","يَكُ مُغَيِّرًۭا نِّعْمَةً",32],["8:72:20",186,"وَلَمْ","and (did) not","بَعْضٍۢ ۚ وَٱلَّذِينَ ءَامَنُوا۟","يُهَاجِرُوا۟ مَا لَكُم",32],["9:4:7",187,"لَمْ","not","مِّنَ ٱلْمُشْرِكِينَ ثُمَّ","يَنقُصُوكُمْ شَيْـًۭٔا وَلَمْ",32],["9:4:10",187,"وَلَمْ","and not","لَمْ يَنقُصُوكُمْ شَيْـًۭٔا","يُظَـٰهِرُوا۟ عَلَيْكُمْ أَحَدًۭا",32],["9:16:5",189,"وَلَمَّا","while not","حَسِبْتُمْ أَن تُتْرَكُوا۟","يَعْلَمِ ٱللَّهُ ٱلَّذِينَ",32],["9:16:11",189,"وَلَمْ","and not","ٱلَّذِينَ جَـٰهَدُوا۟ مِنكُمْ","يَتَّخِذُوا۟ مِن دُونِ",32],["9:18:14",189,"وَلَمْ","and not","ٱلصَّلَوٰةَ وَءَاتَى ٱلزَّكَوٰةَ","يَخْشَ إِلَّا ٱللَّهَ ۖ",32],["9:25:12",190,"فَلَمْ","but not","إِذْ أَعْجَبَتْكُمْ كَثْرَتُكُمْ","تُغْنِ عَنكُمْ شَيْـًۭٔا",32],["9:26:11",190,"لَّمْ","which you did not see","ٱلْمُؤْمِنِينَ وَأَنزَلَ جُنُودًۭا","تَرَوْهَا وَعَذَّبَ ٱلَّذِينَ",32],["9:40:30",193,"لَّمْ","which you did not see","عَلَيْهِ وَأَيَّدَهُۥ بِجُنُودٍۢ","تَرَوْهَا وَجَعَلَ كَلِمَةَ",32],["9:58:11",196,"لَّمْ","not","مِنْهَا رَضُوا۟ وَإِن","يُعْطَوْا۟ مِنْهَآ إِذَا",32],["9:63:1",197,"أَلَمْ","Do not","","يَعْلَمُوٓا۟ أَنَّهُۥ مَن",32],["9:70:1",198,"أَلَمْ","Has not","","يَأْتِهِمْ نَبَأُ ٱلَّذِينَ",32],["9:74:14",199,"لَمْ","not","إِسْلَـٰمِهِمْ وَهَمُّوا۟ بِمَا","يَنَالُوا۟ ۚ وَمَا نَقَمُوٓا۟",32],["9:78:1",199,"أَلَمْ","Do not","","يَعْلَمُوٓا۟ أَنَّ ٱللَّهَ",32],["9:104:1",203,"أَلَمْ","Do not","","يَعْلَمُوٓا۟ أَنَّ ٱللَّهَ",32],["10:12:17",209,"لَّمْ","(had) not","ضُرَّهُۥ مَرَّ كَأَن","يَدْعُنَآ إِلَىٰ ضُرٍّۢ",32],["10:24:36",211,"لَّمْ","not","فَجَعَلْنَـٰهَا حَصِيدًۭا كَأَن","تَغْنَ بِٱلْأَمْسِ ۚ كَذَٰلِكَ",32],["10:39:4",213,"لَمْ","not","بَلْ كَذَّبُوا۟ بِمَا","يُحِيطُوا۟ بِعِلْمِهِۦ وَلَمَّا",32],["10:39:7",213,"وَلَمَّا","and not","لَمْ يُحِيطُوا۟ بِعِلْمِهِۦ","يَأْتِهِمْ تَأْوِيلُهُۥ ۚ كَذَٰلِكَ",32],["10:45:4",214,"لَّمْ","they had not remained","وَيَوْمَ يَحْشُرُهُمْ كَأَن","يَلْبَثُوٓا۟ إِلَّا سَاعَةًۭ",32],["11:20:2",224,"لَمْ","not","أُو۟لَـٰٓئِكَ","يَكُونُوا۟ مُعْجِزِينَ فِى",32],["11:68:2",229,"لَّمْ","not","كَأَن","يَغْنَوْا۟ فِيهَآ ۗ أَلَآ",32],["11:95:2",232,"لَّمْ","not","كَأَن","يَغْنَوْا۟ فِيهَآ ۗ أَلَا",32],["12:32:12",239,"لَّمْ","not","نَّفْسِهِۦ فَٱسْتَعْصَمَ ۖ وَلَئِن","يَفْعَلْ مَآ ءَامُرُهُۥ",32],["12:52:4",241,"لَمْ","not","ذَٰلِكَ لِيَعْلَمَ أَنِّى","أَخُنْهُ بِٱلْغَيْبِ وَأَنَّ",32],["12:60:2",242,"لَّمْ","not","فَإِن","تَأْتُونِى بِهِۦ فَلَا",32],["12:77:14",244,"وَلَمْ","and (did) not","يُوسُفُ فِى نَفْسِهِۦ","يُبْدِهَا لَهُمْ ۚ قَالَ",32],["12:80:8",245,"أَلَمْ","Do not","نَجِيًّۭا ۖ قَالَ كَبِيرُهُمْ","تَعْلَمُوٓا۟ أَنَّ أَبَاكُمْ",32],["12:96:11",247,"أَلَمْ","Did not","فَٱرْتَدَّ بَصِيرًۭا ۖ قَالَ","أَقُل لَّكُمْ إِنِّىٓ",32],["12:109:12",248,"أَفَلَمْ","So have not","مِّنْ أَهْلِ ٱلْقُرَىٰٓ ۗ","يَسِيرُوا۟ فِى ٱلْأَرْضِ",32],["13:18:6",251,"لَمْ","(did) not","لِرَبِّهِمُ ٱلْحُسْنَىٰ ۚ وَٱلَّذِينَ","يَسْتَجِيبُوا۟ لَهُۥ لَوْ",32],["13:31:19",253,"أَفَلَمْ","Then do not","لِّلَّهِ ٱلْأَمْرُ جَمِيعًا ۗ","يَا۟يْـَٔسِ ٱلَّذِينَ ءَامَنُوٓا۟",32],["13:41:1",254,"أَوَلَمْ","Did not","","يَرَوْا۟ أَنَّا نَأْتِى",32],["14:9:1",256,"أَلَمْ","Has not","","يَأْتِكُمْ نَبَؤُا۟ ٱلَّذِينَ",32],["14:19:1",258,"أَلَمْ","Do not","","تَرَ أَنَّ ٱللَّهَ",32],["14:24:1",258,"أَلَمْ","Do not","","تَرَ كَيْفَ ضَرَبَ",32],["14:28:1",259,"۞ أَلَمْ","Have not","","تَرَ إِلَى ٱلَّذِينَ",32],["14:44:18",261,"أَوَلَمْ","Had not","دَعْوَتَكَ وَنَتَّبِعِ ٱلرُّسُلَ ۗ","تَكُونُوٓا۟ أَقْسَمْتُم مِّن",32],["15:33:2",264,"لَمْ","I am not","قَالَ","أَكُن لِّأَسْجُدَ لِبَشَرٍ",32],["15:70:2",265,"أَوَلَمْ","Did not","قَالُوٓا۟","نَنْهَكَ عَنِ ٱلْعَـٰلَمِينَ",32],["16:7:5",268,"لَّمْ","not","أَثْقَالَكُمْ إِلَىٰ بَلَدٍۢ","تَكُونُوا۟ بَـٰلِغِيهِ إِلَّا",32],["16:48:1",272,"أَوَلَمْ","Have not","","يَرَوْا۟ إِلَىٰ مَا",32],["16:79:1",275,"أَلَمْ","Do not","","يَرَوْا۟ إِلَى ٱلطَّيْرِ",32],["16:120:8",281,"وَلَمْ","and not","قَانِتًۭا لِّلَّهِ حَنِيفًۭا","يَكُ مِنَ ٱلْمُشْرِكِينَ",32],["17:99:1",292,"۞ أَوَلَمْ","Do not","","يَرَوْا۟ أَنَّ ٱللَّهَ",32],["17:111:5",293,"لَمْ","has not taken","ٱلْحَمْدُ لِلَّهِ ٱلَّذِى","يَتَّخِذْ وَلَدًۭا وَلَمْ",32],["17:111:8",293,"وَلَمْ","and not","لَمْ يَتَّخِذْ وَلَدًۭا","يَكُن لَّهُۥ شَرِيكٌۭ",32],["17:111:14",293,"وَلَمْ","and not","شَرِيكٌۭ فِى ٱلْمُلْكِ","يَكُن لَّهُۥ وَلِىٌّۭ",32],["18:1:8",293,"وَلَمْ","and not","عَلَىٰ عَبْدِهِ ٱلْكِتَـٰبَ","يَجْعَل لَّهُۥ عِوَجَاۜ",32],["18:6:7",294,"لَّمْ","not","عَلَىٰٓ ءَاثَـٰرِهِمْ إِن","يُؤْمِنُوا۟ بِهَـٰذَا ٱلْحَدِيثِ",32],["18:33:5",297,"وَلَمْ","and not","ٱلْجَنَّتَيْنِ ءَاتَتْ أُكُلَهَا","تَظْلِم مِّنْهُ شَيْـًۭٔا ۚ",32],["18:42:16",298,"لَمْ","I had not associated","عُرُوشِهَا وَيَقُولُ يَـٰلَيْتَنِى","أُشْرِكْ بِرَبِّىٓ أَحَدًۭا",32],["18:43:1",298,"وَلَمْ","And not","","تَكُن لَّهُۥ فِئَةٌۭ",32],["18:47:8",299,"فَلَمْ","and not","ٱلْأَرْضَ بَارِزَةًۭ وَحَشَرْنَـٰهُمْ","نُغَادِرْ مِنْهُمْ أَحَدًۭا",32],["18:52:8",299,"فَلَمْ","but not","ٱلَّذِينَ زَعَمْتُمْ فَدَعَوْهُمْ","يَسْتَجِيبُوا۟ لَهُمْ وَجَعَلْنَا",32],["18:53:7",299,"وَلَمْ","And not","فَظَنُّوٓا۟ أَنَّهُم مُّوَاقِعُوهَا","يَجِدُوا۟ عَنْهَا مَصْرِفًۭا",32],["18:68:5",301,"لَمْ","not","تَصْبِرُ عَلَىٰ مَا","تُحِطْ بِهِۦ خُبْرًۭا",32],["18:72:2",301,"أَلَمْ","Did not","قَالَ","أَقُلْ إِنَّكَ لَن",32],["18:75:2",302,"أَلَمْ","Did not","۞ قَالَ","أَقُل لَّكَ إِنَّكَ",32],["18:78:9",302,"لَمْ","not","سَأُنَبِّئُكَ بِتَأْوِيلِ مَا","تَسْتَطِع عَّلَيْهِ صَبْرًا",32],["18:82:32",302,"لَمْ","not","ذَٰلِكَ تَأْوِيلُ مَا","تَسْطِع عَّلَيْهِ صَبْرًۭا",32],["18:90:10",303,"لَّمْ","not","تَطْلُعُ عَلَىٰ قَوْمٍۢ","نَجْعَل لَّهُم مِّن",32],["19:4:10",305,"وَلَمْ","and not","وَٱشْتَعَلَ ٱلرَّأْسُ شَيْبًۭا","أَكُنۢ بِدُعَآئِكَ رَبِّ",32],["19:7:7",305,"لَمْ","not","بِغُلَـٰمٍ ٱسْمُهُۥ يَحْيَىٰ","نَجْعَل لَّهُۥ مِن",32],["19:9:12",305,"وَلَمْ","while not","خَلَقْتُكَ مِن قَبْلُ","تَكُ شَيْـًۭٔا",32],["19:14:3",306,"وَلَمْ","and not","وَبَرًّۢا بِوَٰلِدَيْهِ","يَكُن جَبَّارًا عَصِيًّۭا",32],["19:20:6",306,"وَلَمْ","when not","يَكُونُ لِى غُلَـٰمٌۭ","يَمْسَسْنِى بَشَرٌۭ وَلَمْ",32],["19:20:9",306,"وَلَمْ","and not","وَلَمْ يَمْسَسْنِى بَشَرٌۭ","أَكُ بَغِيًّۭا",32],["19:32:3",307,"وَلَمْ","and not","وَبَرًّۢا بِوَٰلِدَتِى","يَجْعَلْنِى جَبَّارًۭا شَقِيًّۭا",32],["19:43:8",308,"لَمْ","not","مِنَ ٱلْعِلْمِ مَا","يَأْتِكَ فَٱتَّبِعْنِىٓ أَهْدِكَ",32],["19:46:8",308,"لَّمْ","not","ءَالِهَتِى يَـٰٓإِبْرَٰهِيمُ ۖ لَئِن","تَنتَهِ لَأَرْجُمَنَّكَ ۖ وَٱهْجُرْنِى",32],["19:67:8",310,"وَلَمْ","while not","خَلَقْنَـٰهُ مِن قَبْلُ","يَكُ شَيْـًۭٔا",32],["19:83:1",311,"أَلَمْ","Do not","","تَرَ أَنَّآ أَرْسَلْنَا",32],["20:86:9",317,"أَلَمْ","Did not","أَسِفًۭا ۚ قَالَ يَـٰقَوْمِ","يَعِدْكُمْ رَبُّكُمْ وَعْدًا",32],["20:94:16",318,"وَلَمْ","and not","بَيْنَ بَنِىٓ إِسْرَٰٓءِيلَ","تَرْقُبْ قَوْلِى",32],["20:96:4",318,"لَمْ","not","قَالَ بَصُرْتُ بِمَا","يَبْصُرُوا۟ بِهِۦ فَقَبَضْتُ",32],["20:115:8",320,"وَلَمْ","and not","مِن قَبْلُ فَنَسِىَ","نَجِدْ لَهُۥ عَزْمًۭا",32],["20:127:5",321,"وَلَمْ","and not","نَجْزِى مَنْ أَسْرَفَ","يُؤْمِنۢ بِـَٔايَـٰتِ رَبِّهِۦ ۚ",32],["20:128:1",321,"أَفَلَمْ","Then has not","","يَهْدِ لَهُمْ كَمْ",32],["20:133:7",321,"أَوَلَمْ","Has not","بِـَٔايَةٍۢ مِّن رَّبِّهِۦٓ ۚ","تَأْتِهِم بَيِّنَةُ مَا",32],["21:30:1",324,"أَوَلَمْ","Do not","","يَرَ ٱلَّذِينَ كَفَرُوٓا۟",32],["22:18:1",334,"أَلَمْ","Do not","","تَرَ أَنَّ ٱللَّهَ",32],["22:46:1",337,"أَفَلَمْ","So have not","","يَسِيرُوا۟ فِى ٱلْأَرْضِ",32],["22:63:1",339,"أَلَمْ","Do not","","تَرَ أَنَّ ٱللَّهَ",32],["22:65:1",340,"أَلَمْ","Do not","","تَرَ أَنَّ ٱللَّهَ",32],["22:70:1",340,"أَلَمْ","Do not","","تَعْلَمْ أَنَّ ٱللَّهَ",32],["22:71:6",340,"لَمْ","not","دُونِ ٱللَّهِ مَا","يُنَزِّلْ بِهِۦ سُلْطَـٰنًۭا",32],["23:68:1",346,"أَفَلَمْ","Then, do not","","يَدَّبَّرُوا۟ ٱلْقَوْلَ أَمْ",32],["23:68:7",346,"لَمْ","not","أَمْ جَآءَهُم مَّا","يَأْتِ ءَابَآءَهُمُ ٱلْأَوَّلِينَ",32],["23:69:2",346,"لَمْ","(do) not","أَمْ","يَعْرِفُوا۟ رَسُولَهُمْ فَهُمْ",32],["23:105:1",349,"أَلَمْ","Were not","","تَكُنْ ءَايَـٰتِى تُتْلَىٰ",32],["24:4:5",350,"لَمْ","not","يَرْمُونَ ٱلْمُحْصَنَـٰتِ ثُمَّ","يَأْتُوا۟ بِأَرْبَعَةِ شُهَدَآءَ",32],["24:6:4",350,"وَلَمْ","and not","وَٱلَّذِينَ يَرْمُونَ أَزْوَٰجَهُمْ","يَكُن لَّهُمْ شُهَدَآءُ",32],["24:13:7",351,"لَمْ","not","بِأَرْبَعَةِ شُهَدَآءَ ۚ فَإِذْ","يَأْتُوا۟ بِٱلشُّهَدَآءِ فَأُو۟لَـٰٓئِكَ",32],["24:28:2",353,"لَّمْ","not","فَإِن","تَجِدُوا۟ فِيهَآ أَحَدًۭا",32],["24:31:58",353,"لَمْ","(are) not","أَوِ ٱلطِّفْلِ ٱلَّذِينَ","يَظْهَرُوا۟ عَلَىٰ عَوْرَٰتِ",32],["24:35:30",354,"لَمْ","not","زَيْتُهَا يُضِىٓءُ وَلَوْ","تَمْسَسْهُ نَارٌۭ ۚ نُّورٌ",32],["24:39:12",355,"لَمْ","not","حَتَّىٰٓ إِذَا جَآءَهُۥ","يَجِدْهُ شَيْـًۭٔا وَوَجَدَ",32],["24:40:21",355,"لَمْ","hardly","إِذَآ أَخْرَجَ يَدَهُۥ","يَكَدْ يَرَىٰهَا ۗ وَمَن",32],["24:40:25",355,"لَّمْ","not","يَكَدْ يَرَىٰهَا ۗ وَمَن","يَجْعَلِ ٱللَّهُ لَهُۥ",32],["24:41:1",355,"أَلَمْ","Do not","","تَرَ أَنَّ ٱللَّهَ",32],["24:43:1",355,"أَلَمْ","Do not","","تَرَ أَنَّ ٱللَّهَ",32],["24:58:9",357,"لَمْ","(have) not","مَلَكَتْ أَيْمَـٰنُكُمْ وَٱلَّذِينَ","يَبْلُغُوا۟ ٱلْحُلُمَ مِنكُمْ",32],["24:62:13",359,"لَّمْ","not","عَلَىٰٓ أَمْرٍۢ جَامِعٍۢ","يَذْهَبُوا۟ حَتَّىٰ يَسْتَـْٔذِنُوهُ ۚ",32],["25:2:6",359,"وَلَمْ","and not","مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","يَتَّخِذْ وَلَدًۭا وَلَمْ",32],["25:2:9",359,"وَلَمْ","and not","وَلَمْ يَتَّخِذْ وَلَدًۭا","يَكُن لَّهُۥ شَرِيكٌۭ",32],["25:28:3",362,"لَمْ","not","يَـٰوَيْلَتَىٰ لَيْتَنِى","أَتَّخِذْ فُلَانًا خَلِيلًۭا",32],["25:40:9",363,"أَفَلَمْ","Then do not","أُمْطِرَتْ مَطَرَ ٱلسَّوْءِ ۚ","يَكُونُوا۟ يَرَوْنَهَا ۚ بَلْ",32],["25:45:1",364,"أَلَمْ","Do you not","","تَرَ إِلَىٰ رَبِّكَ",32],["25:67:4",365,"لَمْ","(are) not extravagant","وَٱلَّذِينَ إِذَآ أَنفَقُوا۟","يُسْرِفُوا۟ وَلَمْ يَقْتُرُوا۟",32],["25:67:6",365,"وَلَمْ","and are not stingy","أَنفَقُوا۟ لَمْ يُسْرِفُوا۟","يَقْتُرُوا۟ وَكَانَ بَيْنَ",32],["25:73:6",366,"لَمْ","(do) not","ذُكِّرُوا۟ بِـَٔايَـٰتِ رَبِّهِمْ","يَخِرُّوا۟ عَلَيْهَا صُمًّۭا",32],["26:7:1",367,"أَوَلَمْ","Do not","","يَرَوْا۟ إِلَى ٱلْأَرْضِ",32],["26:18:2",367,"أَلَمْ","Did not","قَالَ","نُرَبِّكَ فِينَا وَلِيدًۭا",32],["26:116:3",372,"لَّمْ","not","قَالُوا۟ لَئِن","تَنتَهِ يَـٰنُوحُ لَتَكُونَنَّ",32],["26:136:6",372,"لَمْ","not","عَلَيْنَآ أَوَعَظْتَ أَمْ","تَكُن مِّنَ ٱلْوَٰعِظِينَ",32],["26:167:3",374,"لَّمْ","not","قَالُوا۟ لَئِن","تَنتَهِ يَـٰلُوطُ لَتَكُونَنَّ",32],["26:197:1",375,"أَوَلَمْ","Is it not","","يَكُن لَّهُمْ ءَايَةً",32],["26:225:1",376,"أَلَمْ","Do not","","تَرَ أَنَّهُمْ فِى",32],["27:10:10",377,"وَلَمْ","and (did) not","جَآنٌّۭ وَلَّىٰ مُدْبِرًۭا","يُعَقِّبْ ۚ يَـٰمُوسَىٰ لَا",32],["27:22:7",378,"لَمْ","not","فَقَالَ أَحَطتُ بِمَا","تُحِطْ بِهِۦ وَجِئْتُكَ",32],["27:84:7",384,"وَلَمْ","while not","قَالَ أَكَذَّبْتُم بِـَٔايَـٰتِى","تُحِيطُوا۟ بِهَا عِلْمًا",32],["27:86:1",384,"أَلَمْ","Do not","","يَرَوْا۟ أَنَّا جَعَلْنَا",32],["28:31:11",389,"وَلَمْ","and (did) not","جَآنٌّۭ وَلَّىٰ مُدْبِرًۭا","يُعَقِّبْ ۚ يَـٰمُوسَىٰٓ أَقْبِلْ",32],["28:48:13",391,"أَوَلَمْ","Did not","مَآ أُوتِىَ مُوسَىٰٓ ۚ","يَكْفُرُوا۟ بِمَآ أُوتِىَ",32],["28:50:2",391,"لَّمْ","not","فَإِن","يَسْتَجِيبُوا۟ لَكَ فَٱعْلَمْ",32],["28:57:9",392,"أَوَلَمْ","Have not","نُتَخَطَّفْ مِنْ أَرْضِنَآ ۚ","نُمَكِّن لَّهُمْ حَرَمًا",32],["28:58:9",392,"لَمْ","not","مَعِيشَتَهَا ۖ فَتِلْكَ مَسَـٰكِنُهُمْ","تُسْكَن مِّنۢ بَعْدِهِمْ",32],["28:64:5",393,"فَلَمْ","but not","ٱدْعُوا۟ شُرَكَآءَك