[["2:71:19",11,"جِئْتَ","you have come","فِيهَا ۚ قَالُوا۟ ٱلْـَٔـٰنَ","بِٱلْحَقِّ ۚ فَذَبَحُوهَا وَمَا",43],["2:87:18",13,"جَآءَكُمْ","came to you","بِرُوحِ ٱلْقُدُسِ ۗ أَفَكُلَّمَا","رَسُولٌۢ بِمَا لَا",43],["2:89:2",14,"جَآءَهُمْ","came to them","وَلَمَّا","كِتَـٰبٌۭ مِّنْ عِندِ",43],["2:89:18",14,"جَآءَهُم","came to them","ٱلَّذِينَ كَفَرُوا۟ فَلَمَّا","مَّا عَرَفُوا۟ كَفَرُوا۟",43],["2:92:2",14,"جَآءَكُم","came to you","۞ وَلَقَدْ","مُّوسَىٰ بِٱلْبَيِّنَـٰتِ ثُمَّ",43],["2:101:2",15,"جَآءَهُمْ","came to them","وَلَمَّا","رَسُولٌۭ مِّنْ عِندِ",43],["2:120:21",19,"جَآءَكَ","has come to you","أَهْوَآءَهُم بَعْدَ ٱلَّذِى","مِنَ ٱلْعِلْمِ ۙ مَا",43],["2:145:26",22,"جَآءَكَ","came to you","مِّنۢ بَعْدِ مَا","مِنَ ٱلْعِلْمِ ۙ إِنَّكَ",43],["2:209:6",32,"جَآءَتْكُمُ","came to you","مِّنۢ بَعْدِ مَا","ٱلْبَيِّنَـٰتُ فَٱعْلَمُوٓا۟ أَنَّ",43],["2:211:16",33,"جَآءَتْهُ","it (has) come to him","مِنۢ بَعْدِ مَا","فَإِنَّ ٱللَّهَ شَدِيدُ",43],["2:213:29",33,"جَآءَتْهُمُ","came to them","مِنۢ بَعْدِ مَا","ٱلْبَيِّنَـٰتُ بَغْيًۢا بَيْنَهُمْ ۖ",43],["2:253:33",42,"جَآءَتْهُمُ","came to them","مِّنۢ بَعْدِ مَا","ٱلْبَيِّنَـٰتُ وَلَـٰكِنِ ٱخْتَلَفُوا۟",43],["2:275:27",47,"جَآءَهُۥ","comes to him","وَحَرَّمَ ٱلرِّبَوٰا۟ ۚ فَمَن","مَوْعِظَةٌۭ مِّن رَّبِّهِۦ",43],["3:19:15",52,"جَآءَهُمُ","came to them","مِنۢ بَعْدِ مَا","ٱلْعِلْمُ بَغْيًۢا بَيْنَهُمْ ۗ",43],["3:49:7",56,"جِئْتُكُم","[I] (have) come (to) you","إِسْرَٰٓءِيلَ أَنِّى قَدْ","بِـَٔايَةٍۢ مِّن رَّبِّكُمْ ۖ",43],["3:50:13",56,"وَجِئْتُكُم","And I (have) come to you","ٱلَّذِى حُرِّمَ عَلَيْكُمْ ۚ","بِـَٔايَةٍۢ مِّن رَّبِّكُمْ",43],["3:61:7",57,"جَآءَكَ","came to you","مِنۢ بَعْدِ مَا","مِنَ ٱلْعِلْمِ فَقُلْ",43],["3:81:12",60,"جَآءَكُمْ","comes to you","كِتَـٰبٍۢ وَحِكْمَةٍۢ ثُمَّ","رَسُولٌۭ مُّصَدِّقٌۭ لِّمَا",43],["3:86:12",61,"وَجَآءَهُمُ","and came to them","أَنَّ ٱلرَّسُولَ حَقٌّۭ","ٱلْبَيِّنَـٰتُ ۚ وَٱللَّهُ لَا",43],["3:105:9",63,"جَآءَهُمُ","came to them","مِنۢ بَعْدِ مَا","ٱلْبَيِّنَـٰتُ ۚ وَأُو۟لَـٰٓئِكَ لَهُمْ",43],["3:183:17",74,"جَآءَكُمْ","came to you","ٱلنَّارُ ۗ قُلْ قَدْ","رُسُلٌۭ مِّن قَبْلِى",43],["3:184:8",74,"جَآءُو","(who) came","رُسُلٌۭ مِّن قَبْلِكَ","بِٱلْبَيِّنَـٰتِ وَٱلزُّبُرِ وَٱلْكِتَـٰبِ",43],["4:41:3",85,"جِئْنَا","We bring","فَكَيْفَ إِذَا","مِن كُلِّ أُمَّةٍۭ",43],["4:41:8",85,"وَجِئْنَا","and We bring","كُلِّ أُمَّةٍۭ بِشَهِيدٍۢ","بِكَ عَلَىٰ هَـٰٓؤُلَآءِ",43],["4:43:27",85,"جَآءَ","came","عَلَىٰ سَفَرٍ أَوْ","أَحَدٌۭ مِّنكُم مِّنَ",43],["4:62:9",88,"جَآءُوكَ","they come to you","قَدَّمَتْ أَيْدِيهِمْ ثُمَّ","يَحْلِفُونَ بِٱللَّهِ إِنْ",43],["4:64:14",88,"جَآءُوكَ","(had) come to you","إِذ ظَّلَمُوٓا۟ أَنفُسَهُمْ","فَٱسْتَغْفَرُوا۟ ٱللَّهَ وَٱسْتَغْفَرَ",43],["4:83:2",91,"جَآءَهُمْ","comes to them","وَإِذَا","أَمْرٌۭ مِّنَ ٱلْأَمْنِ",43],["4:90:10",92,"جَآءُوكُمْ","those who come to you","وَبَيْنَهُم مِّيثَـٰقٌ أَوْ","حَصِرَتْ صُدُورُهُمْ أَن",43],["4:153:29",102,"جَآءَتْهُمُ","came to them","مِنۢ بَعْدِ مَا","ٱلْبَيِّنَـٰتُ فَعَفَوْنَا عَن",43],["4:170:4",104,"جَآءَكُمُ","has come to you","يَـٰٓأَيُّهَا ٱلنَّاسُ قَدْ","ٱلرَّسُولُ بِٱلْحَقِّ مِن",43],["4:174:4",105,"جَآءَكُم","has come to you","يَـٰٓأَيُّهَا ٱلنَّاسُ قَدْ","بُرْهَـٰنٌۭ مِّن رَّبِّكُمْ",43],["5:6:29",108,"جَآءَ","has come","عَلَىٰ سَفَرٍ أَوْ","أَحَدٌۭ مِّنكُم مِّنَ",43],["5:15:4",110,"جَآءَكُمْ","has come to you","يَـٰٓأَهْلَ ٱلْكِتَـٰبِ قَدْ","رَسُولُنَا يُبَيِّنُ لَكُمْ",43],["5:15:18",110,"جَآءَكُم","has come to you","عَن كَثِيرٍۢ ۚ قَدْ","مِّنَ ٱللَّهِ نُورٌۭ",43],["5:19:4",111,"جَآءَكُمْ","has come to you","يَـٰٓأَهْلَ ٱلْكِتَـٰبِ قَدْ","رَسُولُنَا يُبَيِّنُ لَكُمْ",43],["5:19:15",111,"جَآءَنَا","(has) come to us","أَن تَقُولُوا۟ مَا","مِنۢ بَشِيرٍۢ وَلَا",43],["5:19:21",111,"جَآءَكُم","has come to you","وَلَا نَذِيرٍۢ ۖ فَقَدْ","بَشِيرٌۭ وَنَذِيرٌۭ ۗ وَٱللَّهُ",43],["5:32:29",113,"جَآءَتْهُمْ","came to them","ٱلنَّاسَ جَمِيعًۭا ۚ وَلَقَدْ","رُسُلُنَا بِٱلْبَيِّنَـٰتِ ثُمَّ",43],["5:42:6",115,"جَآءُوكَ","they come to you","أَكَّـٰلُونَ لِلسُّحْتِ ۚ فَإِن","فَٱحْكُم بَيْنَهُمْ أَوْ",43],["5:48:22",116,"جَآءَكَ","has come to you","تَتَّبِعْ أَهْوَآءَهُمْ عَمَّا","مِنَ ٱلْحَقِّ ۚ لِكُلٍّۢ",43],["5:61:2",118,"جَآءُوكُمْ","they come to you","وَإِذَا","قَالُوٓا۟ ءَامَنَّا وَقَد",43],["5:70:10",119,"جَآءَهُمْ","came to them","إِلَيْهِمْ رُسُلًۭا ۖ كُلَّمَا","رَسُولٌۢ بِمَا لَا",43],["5:84:7",122,"جَآءَنَا","came (to) us","نُؤْمِنُ بِٱللَّهِ وَمَا","مِنَ ٱلْحَقِّ وَنَطْمَعُ",43],["5:110:53",126,"جِئْتَهُم","you came to them","إِسْرَٰٓءِيلَ عَنكَ إِذْ","بِٱلْبَيِّنَـٰتِ فَقَالَ ٱلَّذِينَ",43],["6:5:5",128,"جَآءَهُمْ ۖ","it came to them","كَذَّبُوا۟ بِٱلْحَقِّ لَمَّا","فَسَوْفَ يَأْتِيهِمْ أَنۢبَـٰٓؤُا۟",43],["6:25:23",130,"جَآءُوكَ","they come to you","بِهَا ۚ حَتَّىٰٓ إِذَا","يُجَـٰدِلُونَكَ يَقُولُ ٱلَّذِينَ",43],["6:31:9",131,"جَآءَتْهُمُ","came to them","ٱللَّهِ ۖ حَتَّىٰٓ إِذَا","ٱلسَّاعَةُ بَغْتَةًۭ قَالُوا۟",43],["6:34:19",131,"جَآءَكَ","has come to you","لِكَلِمَـٰتِ ٱللَّهِ ۚ وَلَقَدْ","مِن نَّبَإِى۟ ٱلْمُرْسَلِينَ",43],["6:43:3",132,"جَآءَهُم","came to them","فَلَوْلَآ إِذْ","بَأْسُنَا تَضَرَّعُوا۟ وَلَـٰكِن",43],["6:54:2",134,"جَآءَكَ","come to you","وَإِذَا","ٱلَّذِينَ يُؤْمِنُونَ بِـَٔايَـٰتِنَا",43],["6:61:10",135,"جَآءَ","comes","حَفَظَةً حَتَّىٰٓ إِذَا","أَحَدَكُمُ ٱلْمَوْتُ تَوَفَّتْهُ",43],["6:91:20",139,"جَآءَ","brought","أَنزَلَ ٱلْكِتَـٰبَ ٱلَّذِى","بِهِۦ مُوسَىٰ نُورًۭا",43],["6:94:2",139,"جِئْتُمُونَا","you have come to Us","وَلَقَدْ","فُرَٰدَىٰ كَمَا خَلَقْنَـٰكُمْ",43],["6:104:2",141,"جَآءَكُم","has come to you","قَدْ","بَصَآئِرُ مِن رَّبِّكُمْ ۖ",43],["6:109:6",141,"جَآءَتْهُمْ","came to them","جَهْدَ أَيْمَـٰنِهِمْ لَئِن","ءَايَةٌۭ لَّيُؤْمِنُنَّ بِهَا ۚ",43],["6:109:19",141,"جَآءَتْ","it comes","يُشْعِرُكُمْ أَنَّهَآ إِذَا","لَا يُؤْمِنُونَ",43],["6:124:2",143,"جَآءَتْهُمْ","comes to them","وَإِذَا","ءَايَةٌۭ قَالُوا۟ لَن",43],["6:157:12",149,"جَآءَكُم","has come to you","أَهْدَىٰ مِنْهُمْ ۚ فَقَدْ","بَيِّنَةٌۭ مِّن رَّبِّكُمْ",43],["6:160:2",150,"جَآءَ","came","مَن","بِٱلْحَسَنَةِ فَلَهُۥ عَشْرُ",43],["6:160:8",150,"جَآءَ","came","عَشْرُ أَمْثَالِهَا ۖ وَمَن","بِٱلسَّيِّئَةِ فَلَا يُجْزَىٰٓ",43],["7:4:5",151,"فَجَآءَهَا","and came to it","مِّن قَرْيَةٍ أَهْلَكْنَـٰهَا","بَأْسُنَا بَيَـٰتًا أَوْ",43],["7:5:5",151,"جَآءَهُم","came to them","كَانَ دَعْوَىٰهُمْ إِذْ","بَأْسُنَآ إِلَّآ أَن",43],["7:34:5",154,"جَآءَ","comes","أُمَّةٍ أَجَلٌۭ ۖ فَإِذَا","أَجَلُهُمْ لَا يَسْتَأْخِرُونَ",43],["7:37:18",154,"جَآءَتْهُمْ","comes to them","ٱلْكِتَـٰبِ ۖ حَتَّىٰٓ إِذَا","رُسُلُنَا يَتَوَفَّوْنَهُمْ قَالُوٓا۟",43],["7:43:25",155,"جَآءَتْ","came","هَدَىٰنَا ٱللَّهُ ۖ لَقَدْ","رُسُلُ رَبِّنَا بِٱلْحَقِّ ۖ",43],["7:52:2",157,"جِئْنَـٰهُم","We had brought them","وَلَقَدْ","بِكِتَـٰبٍۢ فَصَّلْنَـٰهُ عَلَىٰ",43],["7:53:14",157,"جَآءَتْ","had come","مِن قَبْلُ قَدْ","رُسُلُ رَبِّنَا بِٱلْحَقِّ",43],["7:63:3",158,"جَآءَكُمْ","has come to you","أَوَعَجِبْتُمْ أَن","ذِكْرٌۭ مِّن رَّبِّكُمْ",43],["7:69:3",159,"جَآءَكُمْ","has come to you","أَوَعَجِبْتُمْ أَن","ذِكْرٌۭ مِّن رَّبِّكُمْ",43],["7:70:2",159,"أَجِئْتَنَا","Have you come to us","قَالُوٓا۟","لِنَعْبُدَ ٱللَّهَ وَحْدَهُۥ",43],["7:73:15",159,"جَآءَتْكُم","has come to you","إِلَـٰهٍ غَيْرُهُۥ ۖ قَدْ","بَيِّنَةٌۭ مِّن رَّبِّكُمْ ۖ",43],["7:85:15",161,"جَآءَتْكُم","has came to you","إِلَـٰهٍ غَيْرُهُۥ ۖ قَدْ","بَيِّنَةٌۭ مِّن رَّبِّكُمْ ۖ",43],["7:101:8",163,"جَآءَتْهُمْ","came to them","مِنْ أَنۢبَآئِهَا ۚ وَلَقَدْ","رُسُلُهُم بِٱلْبَيِّنَـٰتِ فَمَا",43],["7:105:11",164,"جِئْتُكُم","I (have) come to you","إِلَّا ٱلْحَقَّ ۚ قَدْ","بِبَيِّنَةٍۢ مِّن رَّبِّكُمْ",43],["7:106:4",164,"جِئْتَ","come","قَالَ إِن كُنتَ","بِـَٔايَةٍۢ فَأْتِ بِهَآ",43],["7:113:1",164,"وَجَآءَ","So came","","ٱلسَّحَرَةُ فِرْعَوْنَ قَالُوٓا۟",43],["7:116:9",164,"وَجَآءُو","and came (up)","أَعْيُنَ ٱلنَّاسِ وَٱسْتَرْهَبُوهُمْ","بِسِحْرٍ عَظِيمٍۢ",43],["7:126:10",165,"جَآءَتْنَا ۚ","they came to us","بِـَٔايَـٰتِ رَبِّنَا لَمَّا","رَبَّنَآ أَفْرِغْ عَلَيْنَا",43],["7:129:10",165,"جِئْتَنَا ۚ","you have come to us","وَمِنۢ بَعْدِ مَا","قَالَ عَسَىٰ رَبُّكُمْ",43],["7:131:2",166,"جَآءَتْهُمُ","came to them","فَإِذَا","ٱلْحَسَنَةُ قَالُوا۟ لَنَا",43],["7:143:2",167,"جَآءَ","came","وَلَمَّا","مُوسَىٰ لِمِيقَـٰتِنَا وَكَلَّمَهُۥ",43],["8:19:4",179,"جَآءَكُمُ","has come to you","إِن تَسْتَفْتِحُوا۟ فَقَدْ","ٱلْفَتْحُ ۖ وَإِن تَنتَهُوا۟",43],["9:48:10",195,"جَآءَ","came","لَكَ ٱلْأُمُورَ حَتَّىٰ","ٱلْحَقُّ وَظَهَرَ أَمْرُ",43],["9:90:1",201,"وَجَآءَ","And came","","ٱلْمُعَذِّرُونَ مِنَ ٱلْأَعْرَابِ",43],["9:128:2",207,"جَآءَكُمْ","(has) come to you","لَقَدْ","رَسُولٌۭ مِّنْ أَنفُسِكُمْ",43],["10:13:8",209,"وَجَآءَتْهُمْ","and came to them","قَبْلِكُمْ لَمَّا ظَلَمُوا۟ ۙ","رُسُلُهُم بِٱلْبَيِّنَـٰتِ وَمَا",43],["10:22:18",211,"جَآءَتْهَا","comes to it","طَيِّبَةٍۢ وَفَرِحُوا۟ بِهَا","رِيحٌ عَاصِفٌۭ وَجَآءَهُمُ",43],["10:22:21",211,"وَجَآءَهُمُ","and comes to them","جَآءَتْهَا رِيحٌ عَاصِفٌۭ","ٱلْمَوْجُ مِن كُلِّ",43],["10:47:5",214,"جَآءَ","comes","أُمَّةٍۢ رَّسُولٌۭ ۖ فَإِذَا","رَسُولُهُمْ قُضِىَ بَيْنَهُم",43],["10:49:16",214,"جَآءَ","comes","أُمَّةٍ أَجَلٌ ۚ إِذَا","أَجَلُهُمْ فَلَا يَسْتَـْٔخِرُونَ",43],["10:57:4",215,"جَآءَتْكُم","has come to you","يَـٰٓأَيُّهَا ٱلنَّاسُ قَدْ","مَّوْعِظَةٌۭ مِّن رَّبِّكُمْ",43],["10:74:8",217,"فَجَآءُوهُم","and they came to them","رُسُلًا إِلَىٰ قَوْمِهِمْ","بِٱلْبَيِّنَـٰتِ فَمَا كَانُوا۟",43],["10:76:2",217,"جَآءَهُمُ","came to them","فَلَمَّا","ٱلْحَقُّ مِنْ عِندِنَا",43],["10:77:6",217,"جَآءَكُمْ ۖ","it has come to you","أَتَقُولُونَ لِلْحَقِّ لَمَّا","أَسِحْرٌ هَـٰذَا وَلَا",43],["10:78:2",217,"أَجِئْتَنَا","Have you come to us","قَالُوٓا۟","لِتَلْفِتَنَا عَمَّا وَجَدْنَا",43],["10:80:2",218,"جَآءَ","came","فَلَمَّا","ٱلسَّحَرَةُ قَالَ لَهُم",43],["10:81:6",218,"جِئْتُم","you have brought","قَالَ مُوسَىٰ مَا","بِهِ ٱلسِّحْرُ ۖ إِنَّ",43],["10:93:13",219,"جَآءَهُمُ","came to them","فَمَا ٱخْتَلَفُوا۟ حَتَّىٰ","ٱلْعِلْمُ ۚ إِنَّ رَبَّكَ",43],["10:94:15",219,"جَآءَكَ","has come to you","مِن قَبْلِكَ ۚ لَقَدْ","ٱلْحَقُّ مِن رَّبِّكَ",43],["10:97:2",219,"جَآءَتْهُمْ","comes to them","وَلَوْ","كُلُّ ءَايَةٍ حَتَّىٰ",43],["10:108:5",221,"جَآءَكُمُ","has come to you","يَـٰٓأَيُّهَا ٱلنَّاسُ قَدْ","ٱلْحَقُّ مِن رَّبِّكُمْ ۖ",43],["11:12:17",222,"جَآءَ","has come","عَلَيْهِ كَنزٌ أَوْ","مَعَهُۥ مَلَكٌ ۚ إِنَّمَآ",43],["11:40:3",226,"جَآءَ","came","حَتَّىٰٓ إِذَا","أَمْرُنَا وَفَارَ ٱلتَّنُّورُ",43],["11:53:4",227,"جِئْتَنَا","You have not brought us","قَالُوا۟ يَـٰهُودُ مَا","بِبَيِّنَةٍۢ وَمَا نَحْنُ",43],["11:58:2",228,"جَآءَ","came","وَلَمَّا","أَمْرُنَا نَجَّيْنَا هُودًۭا",43],["11:66:2",229,"جَآءَ","came","فَلَمَّا","أَمْرُنَا نَجَّيْنَا صَـٰلِحًۭا",43],["11:69:2",229,"جَآءَتْ","came","وَلَقَدْ","رُسُلُنَآ إِبْرَٰهِيمَ بِٱلْبُشْرَىٰ",43],["11:69:13",229,"جَآءَ","bring","فَمَا لَبِثَ أَن","بِعِجْلٍ حَنِيذٍۢ",43],["11:74:6",230,"وَجَآءَتْهُ","and had reached him","عَنْ إِبْرَٰهِيمَ ٱلرَّوْعُ","ٱلْبُشْرَىٰ يُجَـٰدِلُنَا فِى",43],["11:76:7",230,"جَآءَ","has come","هَـٰذَآ ۖ إِنَّهُۥ قَدْ","أَمْرُ رَبِّكَ ۖ وَإِنَّهُمْ",43],["11:77:2",230,"جَآءَتْ","came","وَلَمَّا","رُسُلُنَا لُوطًۭا سِىٓءَ",43],["11:78:1",230,"وَجَآءَهُۥ","And came (to) him","","قَوْمُهُۥ يُهْرَعُونَ إِلَيْهِ",43],["11:82:2",231,"جَآءَ","came","فَلَمَّا","أَمْرُنَا جَعَلْنَا عَـٰلِيَهَا",43],["11:94:2",232,"جَآءَ","came","وَلَمَّا","أَمْرُنَا نَجَّيْنَا شُعَيْبًۭا",43],["11:101:18",233,"جَآءَ","came","مِن شَىْءٍۢ لَّمَّا","أَمْرُ رَبِّكَ ۖ وَمَا",43],["11:120:11",235,"وَجَآءَكَ","And has come to you","نُثَبِّتُ بِهِۦ فُؤَادَكَ ۚ","فِى هَـٰذِهِ ٱلْحَقُّ",43],["12:16:1",237,"وَجَآءُوٓ","And they came","","أَبَاهُمْ عِشَآءًۭ يَبْكُونَ",43],["12:18:1",237,"وَجَآءُو","And they brought","","عَلَىٰ قَمِيصِهِۦ بِدَمٍۢ",43],["12:19:1",237,"وَجَآءَتْ","And there came","","سَيَّارَةٌۭ فَأَرْسَلُوا۟ وَارِدَهُمْ",43],["12:50:6",241,"جَآءَهُ","came to him","ٱئْتُونِى بِهِۦ ۖ فَلَمَّا","ٱلرَّسُولُ قَالَ ٱرْجِعْ",43],["12:58:1",242,"وَجَآءَ","And came","","إِخْوَةُ يُوسُفَ فَدَخَلُوا۟",43],["12:72:6",244,"جَآءَ","brings","صُوَاعَ ٱلْمَلِكِ وَلِمَن","بِهِۦ حِمْلُ بَعِيرٍۢ",43],["12:73:6",244,"جِئْنَا","we came","لَقَدْ عَلِمْتُم مَّا","لِنُفْسِدَ فِى ٱلْأَرْضِ",43],["12:88:10",246,"وَجِئْنَا","and we have come","مَسَّنَا وَأَهْلَنَا ٱلضُّرُّ","بِبِضَـٰعَةٍۢ مُّزْجَىٰةٍۢ فَأَوْفِ",43],["12:96:3",247,"جَآءَ","arrived","فَلَمَّآ أَن","ٱلْبَشِيرُ أَلْقَىٰهُ عَلَىٰ",43],["12:100:26",247,"وَجَآءَ","and brought","أَخْرَجَنِى مِنَ ٱلسِّجْنِ","بِكُم مِّنَ ٱلْبَدْوِ",43],["12:110:9",248,"جَآءَهُمْ","then came to them","أَنَّهُمْ قَدْ كُذِبُوا۟","نَصْرُنَا فَنُجِّىَ مَن",43],["13:37:9",254,"جَآءَكَ","came to you","ٱتَّبَعْتَ أَهْوَآءَهُم بَعْدَ مَا","مِنَ ٱلْعِلْمِ مَا",43],["14:9:18",256,"جَآءَتْهُمْ","Came to them","يَعْلَمُهُمْ إِلَّا ٱللَّهُ ۚ","رُسُلُهُم بِٱلْبَيِّنَـٰتِ فَرَدُّوٓا۟",43],["15:61:2",265,"جَآءَ","came","فَلَمَّا","ءَالَ لُوطٍ ٱلْمُرْسَلُونَ",43],["15:63:3",265,"جِئْنَـٰكَ","we have come to you","قَالُوا۟ بَلْ","بِمَا كَانُوا۟ فِيهِ",43],["15:67:1",265,"وَجَآءَ","And came","","أَهْلُ ٱلْمَدِينَةِ يَسْتَبْشِرُونَ",43],["16:61:17",273,"جَآءَ","comes","أَجَلٍۢ مُّسَمًّۭى ۖ فَإِذَا","أَجَلُهُمْ لَا يَسْتَـْٔخِرُونَ",43],["16:89:10",277,"وَجِئْنَا","And We (will) bring","عَلَيْهِم مِّنْ أَنفُسِهِمْ ۖ","بِكَ شَهِيدًا عَلَىٰ",43],["16:113:2",280,"جَآءَهُمْ","came to them","وَلَقَدْ","رَسُولٌۭ مِّنْهُمْ فَكَذَّبُوهُ",43],["17:5:2",282,"جَآءَ","came","فَإِذَا","وَعْدُ أُولَىٰهُمَا بَعَثْنَا",43],["17:7:9",282,"جَآءَ","came","أَسَأْتُمْ فَلَهَا ۚ فَإِذَا","وَعْدُ ٱلْـَٔاخِرَةِ لِيَسُـۥٓـُٔوا۟",43],["17:81:2",290,"جَآءَ","Has come","وَقُلْ","ٱلْحَقُّ وَزَهَقَ ٱلْبَـٰطِلُ ۚ",43],["17:94:7",291,"جَآءَهُمُ","came to them","أَن يُؤْمِنُوٓا۟ إِذْ","ٱلْهُدَىٰٓ إِلَّآ أَن",43],["17:101:11",292,"جَآءَهُمْ","he came to them","بَنِىٓ إِسْرَٰٓءِيلَ إِذْ","فَقَالَ لَهُۥ فِرْعَوْنُ",43],["17:104:9",292,"جَآءَ","comes","ٱسْكُنُوا۟ ٱلْأَرْضَ فَإِذَا","وَعْدُ ٱلْـَٔاخِرَةِ جِئْنَا",43],["17:104:12",292,"جِئْنَا","We will bring","جَآءَ وَعْدُ ٱلْـَٔاخِرَةِ","بِكُمْ لَفِيفًۭا",43],["18:48:6",299,"جِئْتُمُونَا","you have come to Us","رَبِّكَ صَفًّۭا لَّقَدْ","كَمَا خَلَقْنَـٰكُمْ أَوَّلَ",43],["18:55:7",300,"جَآءَهُمُ","has come to them","أَن يُؤْمِنُوٓا۟ إِذْ","ٱلْهُدَىٰ وَيَسْتَغْفِرُوا۟ رَبَّهُمْ",43],["18:71:13",301,"جِئْتَ","you have done","لِتُغْرِقَ أَهْلَهَا لَقَدْ","شَيْـًٔا إِمْرًۭا",43],["18:74:14",301,"جِئْتَ","you have done","بِغَيْرِ نَفْسٍۢ لَّقَدْ","شَيْـًۭٔا نُّكْرًۭا",43],["18:98:7",304,"جَآءَ","comes","مِّن رَّبِّى ۖ فَإِذَا","وَعْدُ رَبِّى جَعَلَهُۥ",43],["18:109:16",304,"جِئْنَا","We brought","كَلِمَـٰتُ رَبِّى وَلَوْ","بِمِثْلِهِۦ مَدَدًۭا",43],["19:23:1",306,"فَأَجَآءَهَا","Then drove her","","ٱلْمَخَاضُ إِلَىٰ جِذْعِ",43],["19:27:8",307,"جِئْتِ","you (have) brought","قَالُوا۟ يَـٰمَرْيَمُ لَقَدْ","شَيْـًۭٔا فَرِيًّۭا",43],["19:43:4",308,"جَآءَنِى","(has) come to me","يَـٰٓأَبَتِ إِنِّى قَدْ","مِنَ ٱلْعِلْمِ مَا",43],["19:89:2",311,"جِئْتُمْ","you have put forth","لَّقَدْ","شَيْـًٔا إِدًّۭا",43],["20:40:31",314,"جِئْتَ","you came","أَهْلِ مَدْيَنَ ثُمَّ","عَلَىٰ قَدَرٍۢ يَـٰمُوسَىٰ",43],["20:47:13",314,"جِئْنَـٰكَ","we came to you","وَلَا تُعَذِّبْهُمْ ۖ قَدْ","بِـَٔايَةٍۢ مِّن رَّبِّكَ ۖ",43],["20:57:2",315,"أَجِئْتَنَا","Have you come to us","قَالَ","لِتُخْرِجَنَا مِنْ أَرْضِنَا",43],["20:72:6",316,"جَآءَنَا","has come to us","نُّؤْثِرَكَ عَلَىٰ مَا","مِنَ ٱلْبَيِّنَـٰتِ وَٱلَّذِى",43],["21:55:2",326,"أَجِئْتَنَا","Have you come to us","قَالُوٓا۟","بِٱلْحَقِّ أَمْ أَنتَ",43],["23:27:9",343,"جَآءَ","comes","بِأَعْيُنِنَا وَوَحْيِنَا فَإِذَا","أَمْرُنَا وَفَارَ ٱلتَّنُّورُ ۙ",43],["23:44:7",345,"جَآءَ","came","تَتْرَا ۖ كُلَّ مَا","أُمَّةًۭ رَّسُولُهَا كَذَّبُوهُ ۚ",43],["23:68:5",346,"جَآءَهُم","has come to them","يَدَّبَّرُوا۟ ٱلْقَوْلَ أَمْ","مَّا لَمْ يَأْتِ",43],["23:70:6",346,"جَآءَهُم","he brought them","بِهِۦ جِنَّةٌۢ ۚ بَلْ","بِٱلْحَقِّ وَأَكْثَرُهُمْ لِلْحَقِّ",43],["23:99:3",348,"جَآءَ","comes","حَتَّىٰٓ إِذَا","أَحَدَهُمُ ٱلْمَوْتُ قَالَ",43],["24:11:3",351,"جَآءُو","brought","إِنَّ ٱلَّذِينَ","بِٱلْإِفْكِ عُصْبَةٌۭ مِّنكُمْ ۚ",43],["24:13:2",351,"جَآءُو","they bring","لَّوْلَا","عَلَيْهِ بِأَرْبَعَةِ شُهَدَآءَ ۚ",43],["24:39:11",355,"جَآءَهُۥ","he comes to it","مَآءً حَتَّىٰٓ إِذَا","لَمْ يَجِدْهُ شَيْـًۭٔا",43],["25:4:14",360,"جَآءُو","they (have) produced","قَوْمٌ ءَاخَرُونَ ۖ فَقَدْ","ظُلْمًۭا وَزُورًۭا",43],["25:29:7",362,"جَآءَنِى ۗ","it (had) come to me","ٱلذِّكْرِ بَعْدَ إِذْ","وَكَانَ ٱلشَّيْطَـٰنُ لِلْإِنسَـٰنِ",43],["25:33:5",363,"جِئْنَـٰكَ","We bring you","يَأْتُونَكَ بِمَثَلٍ إِلَّا","بِٱلْحَقِّ وَأَحْسَنَ تَفْسِيرًا",43],["26:30:3",368,"جِئْتُكَ","I bring you","قَالَ أَوَلَوْ","بِشَىْءٍۢ مُّبِينٍۢ",43],["26:41:2",369,"جَآءَ","came","فَلَمَّا","ٱلسَّحَرَةُ قَالُوا۟ لِفِرْعَوْنَ",43],["26:206:2",375,"جَآءَهُم","comes to them","ثُمَّ","مَّا كَانُوا۟ يُوعَدُونَ",43],["27:8:2",377,"جَآءَهَا","he came to it","فَلَمَّا","نُودِىَ أَنۢ بُورِكَ",43],["27:13:2",377,"جَآءَتْهُمْ","came to them","فَلَمَّا","ءَايَـٰتُنَا مُبْصِرَةًۭ قَالُوا۟",43],["27:22:10",378,"وَجِئْتُكَ","and I have come to you","لَمْ تُحِطْ بِهِۦ","مِن سَبَإٍۭ بِنَبَإٍۢ",43],["27:36:2",380,"جَآءَ","came","فَلَمَّا","سُلَيْمَـٰنَ قَالَ أَتُمِدُّونَنِ",43],["27:42:2",380,"جَآءَتْ","she came","فَلَمَّا","قِيلَ أَهَـٰكَذَا عَرْشُكِ ۖ",43],["27:84:3",384,"جَآءُو","they come","حَتَّىٰٓ إِذَا","قَالَ أَكَذَّبْتُم بِـَٔايَـٰتِى",43],["27:89:2",385,"جَآءَ","comes","مَن","بِٱلْحَسَنَةِ فَلَهُۥ خَيْرٌۭ",43],["27:90:2",385,"جَآءَ","comes","وَمَن","بِٱلسَّيِّئَةِ فَكُبَّتْ وُجُوهُهُمْ",43],["28:20:1",387,"وَجَآءَ","And came","","رَجُلٌۭ مِّنْ أَقْصَا",43],["28:25:1",388,"فَجَآءَتْهُ","Then came to him","","إِحْدَىٰهُمَا تَمْشِى عَلَى",43],["28:25:16",388,"جَآءَهُۥ","he came to him","سَقَيْتَ لَنَا ۚ فَلَمَّا","وَقَصَّ عَلَيْهِ ٱلْقَصَصَ",43],["28:36:2",390,"جَآءَهُم","came to them","فَلَمَّا","مُّوسَىٰ بِـَٔايَـٰتِنَا بَيِّنَـٰتٍۢ",43],["28:37:6",390,"جَآءَ","has come","رَبِّىٓ أَعْلَمُ بِمَن","بِٱلْهُدَىٰ مِنْ عِندِهِۦ",43],["28:48:2",391,"جَآءَهُمُ","came to them","فَلَمَّا","ٱلْحَقُّ مِنْ عِندِنَا",43],["28:84:2",395,"جَآءَ","comes","مَن","بِٱلْحَسَنَةِ فَلَهُۥ خَيْرٌۭ",43],["28:84:8",395,"جَآءَ","comes","خَيْرٌۭ مِّنْهَا ۖ وَمَن","بِٱلسَّيِّئَةِ فَلَا يُجْزَى",43],["28:85:13",396,"جَآءَ","comes","رَّبِّىٓ أَعْلَمُ مَن","بِٱلْهُدَىٰ وَمَنْ هُوَ",43],["29:10:17",397,"جَآءَ","comes","كَعَذَابِ ٱللَّهِ وَلَئِن","نَصْرٌۭ مِّن رَّبِّكَ",43],["29:31:2",400,"جَآءَتْ","came","وَلَمَّا","رُسُلُنَآ إِبْرَٰهِيمَ بِٱلْبُشْرَىٰ",43],["29:33:3",400,"جَآءَتْ","came","وَلَمَّآ أَن","رُسُلُنَا لُوطًۭا سِىٓءَ",43],["29:39:5",401,"جَآءَهُم","came to them","وَفِرْعَوْنَ وَهَـٰمَـٰنَ ۖ وَلَقَدْ","مُّوسَىٰ بِٱلْبَيِّنَـٰتِ فَٱسْتَكْبَرُوا۟",43],["29:53:6",403,"لَّجَآءَهُمُ","surely (would) have come to them","وَلَوْلَآ أَجَلٌۭ مُّسَمًّۭى","ٱلْعَذَابُ وَلَيَأْتِيَنَّهُم بَغْتَةًۭ",43],["29:68:12",404,"جَآءَهُۥٓ ۚ","it has come to him","كَذَّبَ بِٱلْحَقِّ لَمَّا","أَلَيْسَ فِى جَهَنَّمَ",43],["30:9:22",405,"وَجَآءَتْهُمْ","And came (to) them","أَكْثَرَ مِمَّا عَمَرُوهَا","رُسُلُهُم بِٱلْبَيِّنَـٰتِ ۖ فَمَا",43],["30:47:8",409,"فَجَآءُوهُم","and they came to them","رُسُلًا إِلَىٰ قَوْمِهِمْ","بِٱلْبَيِّنَـٰتِ فَٱنتَقَمْنَا مِنَ",43],["30:58:11",410,"جِئْتَهُم","you bring them","كُلِّ مَثَلٍۢ ۚ وَلَئِن","بِـَٔايَةٍۢ لَّيَقُولَنَّ ٱلَّذِينَ",43],["33:9:9",419,"جَآءَتْكُمْ","came to you","ٱللَّهِ عَلَيْكُمْ إِذْ","جُنُودٌۭ فَأَرْسَلْنَا عَلَيْهِمْ",43],["33:10:2",419,"جَآءُوكُم","they came upon you","إِذْ","مِّن فَوْقِكُمْ وَمِنْ",43],["33:19:4",420,"جَآءَ","comes","أَشِحَّةً عَلَيْكُمْ ۖ فَإِذَا","ٱلْخَوْفُ رَأَيْتَهُمْ يَنظُرُونَ",43],["34:32:12",432,"جَآءَكُم ۖ","it had come to you","ٱلْهُدَىٰ بَعْدَ إِذْ","بَلْ كُنتُم مُّجْرِمِينَ",43],["34:43:29",433,"جَآءَهُمْ","it came to them","كَفَرُوا۟ لِلْحَقِّ لَمَّا","إِنْ هَـٰذَآ إِلَّا",43],["34:49:2",434,"جَآءَ","Has come","قُلْ","ٱلْحَقُّ وَمَا يُبْدِئُ",43],["35:25:8",437,"جَآءَتْهُمْ","Came to them","ٱلَّذِينَ مِن قَبْلِهِمْ","رُسُلُهُم بِٱلْبَيِّنَـٰتِ وَبِٱلزُّبُرِ",43],["35:37:19",438,"وَجَآءَكُمُ","And came to you","فِيهِ مَن تَذَكَّرَ","ٱلنَّذِيرُ ۖ فَذُوقُوا۟ فَمَا",43],["35:42:6",439,"جَآءَهُمْ","came to them","جَهْدَ أَيْمَـٰنِهِمْ لَئِن","نَذِيرٌۭ لَّيَكُونُنَّ أَهْدَىٰ",43],["35:42:14",439,"جَآءَهُمْ","came to them","إِحْدَى ٱلْأُمَمِ ۖ فَلَمَّا","نَذِيرٌۭ مَّا زَادَهُمْ",43],["35:45:19",440,"جَآءَ","comes","أَجَلٍۢ مُّسَمًّۭى ۖ فَإِذَا","أَجَلُهُمْ فَإِنَّ ٱللَّهَ",43],["36:13:7",441,"جَآءَهَا","came to it","أَصْحَـٰبَ ٱلْقَرْيَةِ إِذْ","ٱلْمُرْسَلُونَ",43],["36:20:1",441,"وَجَآءَ","And came","","مِنْ أَقْصَا ٱلْمَدِينَةِ",43],["37:37:2",447,"جَآءَ","he has brought","بَلْ","بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ",43],["37:84:2",449,"جَآءَ","he came","إِذْ","رَبَّهُۥ بِقَلْبٍۢ سَلِيمٍ",43],["38:4:3",453,"جَآءَهُم","has come to them","وَعَجِبُوٓا۟ أَن","مُّنذِرٌۭ مِّنْهُمْ ۖ وَقَالَ",43],["39:32:10",462,"جَآءَهُۥٓ ۚ","it comes to him","وَكَذَّبَ بِٱلصِّدْقِ إِذْ","أَلَيْسَ فِى جَهَنَّمَ",43],["39:33:2",462,"جَآءَ","brought","وَٱلَّذِى","بِٱلصِّدْقِ وَصَدَّقَ بِهِۦٓ ۙ",43],["39:59:3",465,"جَآءَتْكَ","came to you","بَلَىٰ قَدْ","ءَايَـٰتِى فَكَذَّبْتَ بِهَا",43],["39:69:7",466,"وَجِا۟ىٓءَ","and (will) be brought","رَبِّهَا وَوُضِعَ ٱلْكِتَـٰبُ","بِٱلنَّبِيِّـۧنَ وَٱلشُّهَدَآءِ وَقُضِىَ",43],["39:71:9",466,"جَآءُوهَا","they reach it","زُمَرًا ۖ حَتَّىٰٓ إِذَا","فُتِحَتْ أَبْوَٰبُهَا وَقَالَ",43],["39:73:10",466,"جَآءُوهَا","they reach it","زُمَرًا ۖ حَتَّىٰٓ إِذَا","وَفُتِحَتْ أَبْوَٰبُهَا وَقَالَ",43],["40:25:2",469,"جَآءَهُم","he brought to them","فَلَمَّا","بِٱلْحَقِّ مِنْ عِندِنَا",43],["40:28:16",470,"جَآءَكُم","he has brought you","رَبِّىَ ٱللَّهُ وَقَدْ","بِٱلْبَيِّنَـٰتِ مِن رَّبِّكُمْ ۖ",43],["40:29:14",470,"جَآءَنَا ۚ","it came to us","بَأْسِ ٱللَّهِ إِن","قَالَ فِرْعَوْنُ مَآ",43],["40:34:2",471,"جَآءَكُمْ","came to you","وَلَقَدْ","يُوسُفُ مِن قَبْلُ",43],["40:34:12",471,"جَآءَكُم","he brought to you","فِى شَكٍّۢ مِّمَّا","بِهِۦ ۖ حَتَّىٰٓ إِذَا",43],["40:66:12",474,"جَآءَنِىَ","have come to me","دُونِ ٱللَّهِ لَمَّا","ٱلْبَيِّنَـٰتُ مِن رَّبِّى",43],["40:78:25",476,"جَآءَ","comes","بِإِذْنِ ٱللَّهِ ۚ فَإِذَا","أَمْرُ ٱللَّهِ قُضِىَ",43],["40:83:2",476,"جَآءَتْهُمْ","came to them","فَلَمَّا","رُسُلُهُم بِٱلْبَيِّنَـٰتِ فَرِحُوا۟",43],["41:14:2",478,"جَآءَتْهُمُ","came to them","إِذْ","ٱلرُّسُلُ مِنۢ بَيْنِ",43],["41:20:4",478,"جَآءُوهَا","they come to it","حَتَّىٰٓ إِذَا مَا","شَهِدَ عَلَيْهِمْ سَمْعُهُمْ",43],["41:41:6",481,"جَآءَهُمْ ۖ","it comes to them","كَفَرُوا۟ بِٱلذِّكْرِ لَمَّا","وَإِنَّهُۥ لَكِتَـٰبٌ عَزِيزٌۭ",43],["42:14:7",484,"جَآءَهُمُ","came to them","مِنۢ بَعْدِ مَا","ٱلْعِلْمُ بَغْيًۢا بَيْنَهُمْ ۚ",43],["43:24:3",491,"جِئْتُكُم","I brought you","۞ قَـٰلَ أَوَلَوْ","بِأَهْدَىٰ مِمَّا وَجَدتُّمْ",43],["43:29:6",491,"جَآءَهُمُ","came to them","هَـٰٓؤُلَآءِ وَءَابَآءَهُمْ حَتَّىٰ","ٱلْحَقُّ وَرَسُولٌۭ مُّبِينٌۭ",43],["43:30:2",491,"جَآءَهُمُ","came to them","وَلَمَّا","ٱلْحَقُّ قَالُوا۟ هَـٰذَا",43],["43:38:3",492,"جَآءَنَا","he comes to Us","حَتَّىٰٓ إِذَا","قَالَ يَـٰلَيْتَ بَيْنِى",43],["43:47:2",492,"جَآءَهُم","he came to them","فَلَمَّا","بِـَٔايَـٰتِنَآ إِذَا هُم",43],["43:53:8",493,"جَآءَ","come","مِّن ذَهَبٍ أَوْ","مَعَهُ ٱلْمَلَـٰٓئِكَةُ مُقْتَرِنِينَ",43],["43:63:2",494,"جَآءَ","came","وَلَمَّا","عِيسَىٰ بِٱلْبَيِّنَـٰتِ قَالَ",43],["43:63:7",494,"جِئْتُكُم","I have come to you","بِٱلْبَيِّنَـٰتِ قَالَ قَدْ","بِٱلْحِكْمَةِ وَلِأُبَيِّنَ لَكُم",43],["43:78:2",495,"جِئْنَـٰكُم","We have brought you","لَقَدْ","بِٱلْحَقِّ وَلَـٰكِنَّ أَكْثَرَكُمْ",43],["44:13:5",496,"جَآءَهُمْ","had come to them","لَهُمُ ٱلذِّكْرَىٰ وَقَدْ","رَسُولٌۭ مُّبِينٌۭ",43],["44:17:6",496,"وَجَآءَهُمْ","and came to them","قَبْلَهُمْ قَوْمَ فِرْعَوْنَ","رَسُولٌۭ كَرِيمٌ",43],["45:17:11",500,"جَآءَهُمُ","came to them","مِنۢ بَعْدِ مَا","ٱلْعِلْمُ بَغْيًۢا بَيْنَهُمْ ۚ",43],["46:7:11",503,"جَآءَهُمْ","it comes to them","كَفَرُوا۟ لِلْحَقِّ لَمَّا","هَـٰذَا سِحْرٌۭ مُّبِينٌ",43],["46:22:2",505,"أَجِئْتَنَا","Have you come to us","قَالُوٓا۟","لِتَأْفِكَنَا عَنْ ءَالِهَتِنَا",43],["47:18:9",508,"جَآءَ","have come","تَأْتِيَهُم بَغْتَةًۭ ۖ فَقَدْ","أَشْرَاطُهَا ۚ فَأَنَّىٰ لَهُمْ",43],["47:18:14",508,"جَآءَتْهُمْ","has come to them","فَأَنَّىٰ لَهُمْ إِذَا","ذِكْرَىٰهُمْ",43],["49:6:5",516,"جَآءَكُمْ","comes to you","ٱلَّذِينَ ءَامَنُوٓا۟ إِن","فَاسِقٌۢ بِنَبَإٍۢ فَتَبَيَّنُوٓا۟",43],["50:2:4",518,"جَآءَهُم","has come to them","بَلْ عَجِبُوٓا۟ أَن","مُّنذِرٌۭ مِّنْهُمْ فَقَالَ",43],["50:5:5",518,"جَآءَهُمْ","it came (to) them","كَذَّبُوا۟ بِٱلْحَقِّ لَمَّا","فَهُمْ فِىٓ أَمْرٍۢ",43],["50:19:1",519,"وَجَآءَتْ","And will come","","سَكْرَةُ ٱلْمَوْتِ بِٱلْحَقِّ ۖ",43],["50:21:1",519,"وَجَآءَتْ","And will come","","كُلُّ نَفْسٍۢ مَّعَهَا",43],["50:33:5",519,"وَجَآءَ","and came","خَشِىَ ٱلرَّحْمَـٰنَ بِٱلْغَيْبِ","بِقَلْبٍۢ مُّنِيبٍ",43],["51:26:4",521,"فَجَآءَ","and came","فَرَاغَ إِلَىٰٓ أَهْلِهِۦ","بِعِجْلٍۢ سَمِينٍۢ",43],["53:23:22",526,"جَآءَهُم","has come to them","تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ","مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ",43],["54:4:2",528,"جَآءَهُم","has come to them","وَلَقَدْ","مِّنَ ٱلْأَنۢبَآءِ مَا",43],["54:41:2",530,"جَآءَ","came","وَلَقَدْ","ءَالَ فِرْعَوْنَ ٱلنُّذُرُ",43],["57:14:15",539,"جَآءَ","came","وَغَرَّتْكُمُ ٱلْأَمَانِىُّ حَتَّىٰ","أَمْرُ ٱللَّهِ وَغَرَّكُم",43],["58:8:19",543,"جَآءُوكَ","they come to you","وَمَعْصِيَتِ ٱلرَّسُولِ وَإِذَا","حَيَّوْكَ بِمَا لَمْ",43],["59:10:2",547,"جَآءُو","came","وَٱلَّذِينَ","مِنۢ بَعْدِهِمْ يَقُولُونَ",43],["60:1:15",549,"جَآءَكُم","came to you","وَقَدْ كَفَرُوا۟ بِمَا","مِّنَ ٱلْحَقِّ يُخْرِجُونَ",43],["60:10:5",550,"جَآءَكُمُ","come to you","ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا","ٱلْمُؤْمِنَـٰتُ مُهَـٰجِرَٰتٍۢ فَٱمْتَحِنُوهُنَّ ۖ",43],["60:12:4",551,"جَآءَكَ","come to you","يَـٰٓأَيُّهَا ٱلنَّبِىُّ إِذَا","ٱلْمُؤْمِنَـٰتُ يُبَايِعْنَكَ عَلَىٰٓ",43],["61:6:26",552,"جَآءَهُم","he came to them","ٱسْمُهُۥٓ أَحْمَدُ ۖ فَلَمَّا","بِٱلْبَيِّنَـٰتِ قَالُوا۟ هَـٰذَا",43],["63:1:2",554,"جَآءَكَ","come to you","إِذَا","ٱلْمُنَـٰفِقُونَ قَالُوا۟ نَشْهَدُ",43],["63:11:6",555,"جَآءَ","has come","ٱللَّهُ نَفْسًا إِذَا","أَجَلُهَا ۚ وَٱللَّهُ خَبِيرٌۢ",43],["67:9:4",562,"جَآءَنَا","came to us","قَالُوا۟ بَلَىٰ قَدْ","نَذِيرٌۭ فَكَذَّبْنَا وَقُلْنَا",43],["69:9:1",567,"وَجَآءَ","And came","","فِرْعَوْنُ وَمَن قَبْلَهُۥ",43],["71:4:13",570,"جَآءَ","it comes","أَجَلَ ٱللَّهِ إِذَا","لَا يُؤَخَّرُ ۖ لَوْ",43],["79:34:2",584,"جَآءَتِ","comes","فَإِذَا","ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",43],["80:2:2",585,"جَآءَهُ","came to him","أَن","ٱلْأَعْمَىٰ",43],["80:8:3",585,"جَآءَكَ","came to you","وَأَمَّا مَن","يَسْعَىٰ",43],["80:33:2",585,"جَآءَتِ","comes","فَإِذَا","ٱلصَّآخَّةُ",43],["89:22:1",593,"وَجَآءَ","And comes","","رَبُّكَ وَٱلْمَلَكُ صَفًّۭا",43],["89:23:1",594,"وَجِا۟ىٓءَ","And is brought","","يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ",43],["98:4:10",598,"جَآءَتْهُمُ","came (to) them","مِنۢ بَعْدِ مَا","ٱلْبَيِّنَةُ",43],["110:1:2",603,"جَآءَ","comes","إِذَا","نَصْرُ ٱللَّهِ وَٱلْفَتْحُ",43]]