[["3:185:17",74,"فَازَ ۗ","he is successful","وَأُدْخِلَ ٱلْجَنَّةَ فَقَدْ","وَمَا ٱلْحَيَوٰةُ ٱلدُّنْيَآ",1826],["3:188:15",75,"بِمَفَازَةٍۢ","(will) escape","يَفْعَلُوا۟ فَلَا تَحْسَبَنَّهُم","مِّنَ ٱلْعَذَابِ ۖ وَلَهُمْ",2449],["4:13:17",79,"ٱلْفَوْزُ","(is) the success","خَـٰلِدِينَ فِيهَا ۚ وَذَٰلِكَ","ٱلْعَظِيمُ",526],["4:73:16",89,"فَأَفُوزَ","then I would have attained","يَـٰلَيْتَنِى كُنتُ مَعَهُمْ","فَوْزًا عَظِيمًۭا",1826],["4:73:17",89,"فَوْزًا","a success","كُنتُ مَعَهُمْ فَأَفُوزَ","عَظِيمًۭا",526],["5:119:23",127,"ٱلْفَوْزُ","(is) the success","وَرَضُوا۟ عَنْهُ ۚ ذَٰلِكَ","ٱلْعَظِيمُ",526],["6:16:8",129,"ٱلْفَوْزُ","(is) the success","فَقَدْ رَحِمَهُۥ ۚ وَذَٰلِكَ","ٱلْمُبِينُ",526],["9:20:16",189,"ٱلْفَآئِزُونَ","(are) the successful","ٱللَّهِ ۚ وَأُو۟لَـٰٓئِكَ هُمُ","",1546],["9:72:23",198,"ٱلْفَوْزُ","(is) the success","أَكْبَرُ ۚ ذَٰلِكَ هُوَ","ٱلْعَظِيمُ",526],["9:89:12",201,"ٱلْفَوْزُ","(is) the success","خَـٰلِدِينَ فِيهَا ۚ ذَٰلِكَ","ٱلْعَظِيمُ",526],["9:100:24",203,"ٱلْفَوْزُ","(is) the success","فِيهَآ أَبَدًۭا ۚ ذَٰلِكَ","ٱلْعَظِيمُ",526],["9:111:36",204,"ٱلْفَوْزُ","(is) the success","بِهِۦ ۚ وَذَٰلِكَ هُوَ","ٱلْعَظِيمُ",526],["10:64:14",216,"ٱلْفَوْزُ","the success","ٱللَّهِ ۚ ذَٰلِكَ هُوَ","ٱلْعَظِيمُ",526],["23:111:8",349,"ٱلْفَآئِزُونَ","(are) the successful ones","صَبَرُوٓا۟ أَنَّهُمْ هُمُ","",1546],["24:52:10",356,"ٱلْفَآئِزُونَ","(are) the successful ones","وَيَتَّقْهِ فَأُو۟لَـٰٓئِكَ هُمُ","",1546],["33:71:12",427,"فَازَ","has attained","ٱللَّهَ وَرَسُولَهُۥ فَقَدْ","فَوْزًا عَظِيمًا",1826],["33:71:13",427,"فَوْزًا","an attainment","وَرَسُولَهُۥ فَقَدْ فَازَ","عَظِيمًا",526],["37:60:4",448,"ٱلْفَوْزُ","(is) the attainment","إِنَّ هَـٰذَا لَهُوَ","ٱلْعَظِيمُ",526],["39:61:5",465,"بِمَفَازَتِهِمْ","to their place of salvation","ٱللَّهُ ٱلَّذِينَ ٱتَّقَوْا۟","لَا يَمَسُّهُمُ ٱلسُّوٓءُ",2449],["40:9:11",468,"ٱلْفَوْزُ","(is) the success","رَحِمْتَهُۥ ۚ وَذَٰلِكَ هُوَ","ٱلْعَظِيمُ",526],["44:57:6",498,"ٱلْفَوْزُ","(will be) the success","رَّبِّكَ ۚ ذَٰلِكَ هُوَ","ٱلْعَظِيمُ",526],["45:30:12",501,"ٱلْفَوْزُ","(is) the success","رَحْمَتِهِۦ ۚ ذَٰلِكَ هُوَ","ٱلْمُبِينُ",526],["48:5:18",511,"فَوْزًا","a success","ذَٰلِكَ عِندَ ٱللَّهِ","عَظِيمًۭا",526],["57:12:21",539,"ٱلْفَوْزُ","the success","فِيهَا ۚ ذَٰلِكَ هُوَ","ٱلْعَظِيمُ",526],["59:20:10",548,"ٱلْفَآئِزُونَ","(are) the achievers","أَصْحَـٰبُ ٱلْجَنَّةِ هُمُ","",1546],["61:12:16",552,"ٱلْفَوْزُ","(is) the success","جَنَّـٰتِ عَدْنٍۢ ۚ ذَٰلِكَ","ٱلْعَظِيمُ",526],["64:9:26",556,"ٱلْفَوْزُ","(is) the success","فِيهَآ أَبَدًۭا ۚ ذَٰلِكَ","ٱلْعَظِيمُ",526],["78:31:3",583,"مَفَازًا","(is) success","إِنَّ لِلْمُتَّقِينَ","",3658],["85:11:13",590,"ٱلْفَوْزُ","(is) the success","تَحْتِهَا ٱلْأَنْهَـٰرُ ۚ ذَٰلِكَ","ٱلْكَبِيرُ",526]]