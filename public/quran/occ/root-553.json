[["2:57:3",8,"ٱلْغَمَامَ","(with) [the] clouds","وَظَلَّلْنَا عَلَيْكُمُ","وَأَنزَلْنَا عَلَيْكُمُ ٱلْمَنَّ",1551],["2:210:10",32,"ٱلْغَمَامِ","[the] clouds","فِى ظُلَلٍۢ مِّنَ","وَٱلْمَلَـٰٓئِكَةُ وَقُضِىَ ٱلْأَمْرُ ۚ",1551],["3:153:12",69,"غَمًّۢا","(with) distress","فِىٓ أُخْرَىٰكُمْ فَأَثَـٰبَكُمْ","بِغَمٍّۢ لِّكَيْلَا تَحْزَنُوا۟",1183],["3:153:13",69,"بِغَمٍّۢ","on distress","أُخْرَىٰكُمْ فَأَثَـٰبَكُمْ غَمًّۢا","لِّكَيْلَا تَحْزَنُوا۟ عَلَىٰ",1183],["3:154:6",70,"ٱلْغَمِّ","the distress","عَلَيْكُم مِّنۢ بَعْدِ","أَمَنَةًۭ نُّعَاسًۭا يَغْشَىٰ",1183],["7:160:28",171,"ٱلْغَمَـٰمَ","(with) the clouds","مَّشْرَبَهُمْ ۚ وَظَلَّلْنَا عَلَيْهِمُ","وَأَنزَلْنَا عَلَيْهِمُ ٱلْمَنَّ",1551],["10:71:28",217,"غُمَّةًۭ","any doubt","يَكُنْ أَمْرُكُمْ عَلَيْكُمْ","ثُمَّ ٱقْضُوٓا۟ إِلَىَّ",3478],["20:40:22",314,"ٱلْغَمِّ","the distress","نَفْسًۭا فَنَجَّيْنَـٰكَ مِنَ","وَفَتَنَّـٰكَ فُتُونًۭا ۚ فَلَبِثْتَ",1183],["21:88:5",329,"ٱلْغَمِّ ۚ","the distress","لَهُۥ وَنَجَّيْنَـٰهُ مِنَ","وَكَذَٰلِكَ نُـۨجِى ٱلْمُؤْمِنِينَ",1183],["22:22:7",334,"غَمٍّ","anguish","يَخْرُجُوا۟ مِنْهَا مِنْ","أُعِيدُوا۟ فِيهَا وَذُوقُوا۟",1183],["25:25:4",362,"بِٱلْغَمَـٰمِ","with the clouds","وَيَوْمَ تَشَقَّقُ ٱلسَّمَآءُ","وَنُزِّلَ ٱلْمَلَـٰٓئِكَةُ تَنزِيلًا",1551]]