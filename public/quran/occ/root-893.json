[["3:44:12",55,"أَقْلَـٰمَهُمْ","their pens","لَدَيْهِمْ إِذْ يُلْقُونَ","أَيُّهُمْ يَكْفُلُ مَرْيَمَ",1619],["31:27:7",413,"أَقْلَـٰمٌۭ","(were) pens","ٱلْأَرْضِ مِن شَجَرَةٍ","وَٱلْبَحْرُ يَمُدُّهُۥ مِنۢ",1619],["68:1:2",564,"وَٱلْقَلَمِ","By the pen","نٓ ۚ","وَمَا يَسْطُرُونَ",1619],["96:4:3",597,"بِٱلْقَلَمِ","by the pen","ٱلَّذِى عَلَّمَ","",1619]]