[["1:7:3",1,"أَنْعَمْتَ","You have bestowed (Your) Favors","صِرَٰطَ ٱلَّذِينَ","عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ",564],["2:40:4",7,"نِعْمَتِىَ","My Favor","يَـٰبَنِىٓ إِسْرَٰٓءِيلَ ٱذْكُرُوا۟","ٱلَّتِىٓ أَنْعَمْتُ عَلَيْكُمْ",237],["2:40:6",7,"أَنْعَمْتُ","I bestowed","ٱذْكُرُوا۟ نِعْمَتِىَ ٱلَّتِىٓ","عَلَيْكُمْ وَأَوْفُوا۟ بِعَهْدِىٓ",564],["2:47:4",7,"نِعْمَتِىَ","My Favor","يَـٰبَنِىٓ إِسْرَٰٓءِيلَ ٱذْكُرُوا۟","ٱلَّتِىٓ أَنْعَمْتُ عَلَيْكُمْ",237],["2:47:6",7,"أَنْعَمْتُ","I bestowed","ٱذْكُرُوا۟ نِعْمَتِىَ ٱلَّتِىٓ","عَلَيْكُمْ وَأَنِّى فَضَّلْتُكُمْ",564],["2:122:4",19,"نِعْمَتِىَ","My Favor","يَـٰبَنِىٓ إِسْرَٰٓءِيلَ ٱذْكُرُوا۟","ٱلَّتِىٓ أَنْعَمْتُ عَلَيْكُمْ",237],["2:122:6",19,"أَنْعَمْتُ","I bestowed","ٱذْكُرُوا۟ نِعْمَتِىَ ٱلَّتِىٓ","عَلَيْكُمْ وَأَنِّى فَضَّلْتُكُمْ",564],["2:150:28",23,"نِعْمَتِى","My favor","تَخْشَوْهُمْ وَٱخْشَوْنِى وَلِأُتِمَّ","عَلَيْكُمْ وَلَعَلَّكُمْ تَهْتَدُونَ",237],["2:211:11",33,"نِعْمَةَ","Favor","بَيِّنَةٍۢ ۗ وَمَن يُبَدِّلْ","ٱللَّهِ مِنۢ بَعْدِ",237],["2:231:27",37,"نِعْمَتَ","(the) Favors","ٱللَّهِ هُزُوًۭا ۚ وَٱذْكُرُوا۟","ٱللَّهِ عَلَيْكُمْ وَمَآ",237],["2:271:4",46,"فَنِعِمَّا","then good","إِن تُبْدُوا۟ ٱلصَّدَقَـٰتِ","هِىَ ۖ وَإِن تُخْفُوهَا",554],["3:14:15",51,"وَٱلْأَنْعَـٰمِ","and [the] cattle","وَٱلْفِضَّةِ وَٱلْخَيْلِ ٱلْمُسَوَّمَةِ","وَٱلْحَرْثِ ۗ ذَٰلِكَ مَتَـٰعُ",347],["3:103:8",63,"نِعْمَتَ","(the) Favor","وَلَا تَفَرَّقُوا۟ ۚ وَٱذْكُرُوا۟","ٱللَّهِ عَلَيْكُمْ إِذْ",237],["3:103:18",63,"بِنِعْمَتِهِۦٓ","by His Favor","بَيْنَ قُلُوبِكُمْ فَأَصْبَحْتُم","إِخْوَٰنًۭا وَكُنتُمْ عَلَىٰ",237],["3:136:13",67,"وَنِعْمَ","And an excellent","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا ۚ","أَجْرُ ٱلْعَـٰمِلِينَ",554],["3:171:2",72,"بِنِعْمَةٍۢ","of Favor","۞ يَسْتَبْشِرُونَ","مِّنَ ٱللَّهِ وَفَضْلٍۢ",237],["3:173:16",72,"وَنِعْمَ","and (He is the) best","وَقَالُوا۟ حَسْبُنَا ٱللَّهُ","ٱلْوَكِيلُ",554],["3:174:2",73,"بِنِعْمَةٍۢ","with (the) Favor","فَٱنقَلَبُوا۟","مِّنَ ٱللَّهِ وَفَضْلٍۢ",237],["4:58:18",87,"نِعِمَّا","excellently","بِٱلْعَدْلِ ۚ إِنَّ ٱللَّهَ","يَعِظُكُم بِهِۦٓ ۗ إِنَّ",554],["4:69:8",89,"أَنْعَمَ","has bestowed (His) Favor","فَأُو۟لَـٰٓئِكَ مَعَ ٱلَّذِينَ","ٱللَّهُ عَلَيْهِم مِّنَ",564],["4:72:10",89,"أَنْعَمَ","(has) favored","مُّصِيبَةٌۭ قَالَ قَدْ","ٱللَّهُ عَلَىَّ إِذْ",564],["4:119:6",97,"ٱلْأَنْعَـٰمِ","(of) the cattle","وَلَـَٔامُرَنَّهُمْ فَلَيُبَتِّكُنَّ ءَاذَانَ","وَلَـَٔامُرَنَّهُمْ فَلَيُغَيِّرُنَّ خَلْقَ",347],["5:1:9",106,"ٱلْأَنْعَـٰمِ","(of) the grazing livestock","أُحِلَّتْ لَكُم بَهِيمَةُ","إِلَّا مَا يُتْلَىٰ",347],["5:3:46",107,"نِعْمَتِى","My Favor","دِينَكُمْ وَأَتْمَمْتُ عَلَيْكُمْ","وَرَضِيتُ لَكُمُ ٱلْإِسْلَـٰمَ",237],["5:6:58",108,"نِعْمَتَهُۥ","His Favor","يُرِيدُ لِيُطَهِّرَكُمْ وَلِيُتِمَّ","عَلَيْكُمْ لَعَلَّكُمْ تَشْكُرُونَ",237],["5:7:2",108,"نِعْمَةَ","(the) Favor","وَٱذْكُرُوا۟","ٱللَّهِ عَلَيْكُمْ وَمِيثَـٰقَهُ",237],["5:11:5",109,"نِعْمَتَ","(the) Favor","ٱلَّذِينَ ءَامَنُوا۟ ٱذْكُرُوا۟","ٱللَّهِ عَلَيْكُمْ إِذْ",237],["5:20:7",111,"نِعْمَةَ","(the) Favor","لِقَوْمِهِۦ يَـٰقَوْمِ ٱذْكُرُوا۟","ٱللَّهِ عَلَيْكُمْ إِذْ",237],["5:23:6",111,"أَنْعَمَ","(had) favored","مِنَ ٱلَّذِينَ يَخَافُونَ","ٱللَّهُ عَلَيْهِمَا ٱدْخُلُوا۟",564],["5:65:12",119,"ٱلنَّعِيمِ","(of) Bliss","سَيِّـَٔاتِهِمْ وَلَأَدْخَلْنَـٰهُمْ جَنَّـٰتِ","",576],["5:95:18",123,"ٱلنَّعَمِ","the cattle","مَا قَتَلَ مِنَ","يَحْكُمُ بِهِۦ ذَوَا",347],["5:110:8",126,"نِعْمَتِى","My Favor","ٱبْنَ مَرْيَمَ ٱذْكُرْ","عَلَيْكَ وَعَلَىٰ وَٰلِدَتِكَ",237],["6:136:7",145,"وَٱلْأَنْعَـٰمِ","and the cattle","ذَرَأَ مِنَ ٱلْحَرْثِ","نَصِيبًۭا فَقَالُوا۟ هَـٰذَا",347],["6:138:3",146,"أَنْعَـٰمٌۭ","(are) cattle","وَقَالُوا۟ هَـٰذِهِۦٓ","وَحَرْثٌ حِجْرٌۭ لَّا",347],["6:138:12",146,"وَأَنْعَـٰمٌ","And cattle","مَن نَّشَآءُ بِزَعْمِهِمْ","حُرِّمَتْ ظُهُورُهَا وَأَنْعَـٰمٌۭ",347],["6:138:15",146,"وَأَنْعَـٰمٌۭ","and cattle","وَأَنْعَـٰمٌ حُرِّمَتْ ظُهُورُهَا","لَّا يَذْكُرُونَ ٱسْمَ",347],["6:139:6",146,"ٱلْأَنْعَـٰمِ","cattle","فِى بُطُونِ هَـٰذِهِ","خَالِصَةٌۭ لِّذُكُورِنَا وَمُحَرَّمٌ",347],["6:142:2",146,"ٱلْأَنْعَـٰمِ","the cattle","وَمِنَ","حَمُولَةًۭ وَفَرْشًۭا ۚ كُلُوا۟",347],["7:179:24",174,"كَٱلْأَنْعَـٰمِ","(are) like cattle","يَسْمَعُونَ بِهَآ ۚ أُو۟لَـٰٓئِكَ","بَلْ هُمْ أَضَلُّ ۚ",347],["8:40:7",181,"نِعْمَ","Excellent","أَنَّ ٱللَّهَ مَوْلَىٰكُمْ ۚ","ٱلْمَوْلَىٰ وَنِعْمَ ٱلنَّصِيرُ",554],["8:40:9",181,"وَنِعْمَ","and Excellent","مَوْلَىٰكُمْ ۚ نِعْمَ ٱلْمَوْلَىٰ","ٱلنَّصِيرُ",554],["8:53:7",184,"نِّعْمَةً","a favor","لَمْ يَكُ مُغَيِّرًۭا","أَنْعَمَهَا عَلَىٰ قَوْمٍ",237],["8:53:8",184,"أَنْعَمَهَا","which He had bestowed","يَكُ مُغَيِّرًۭا نِّعْمَةً","عَلَىٰ قَوْمٍ حَتَّىٰ",564],["9:21:9",190,"نَعِيمٌۭ","(is) bliss","وَجَنَّـٰتٍۢ لَّهُمْ فِيهَا","مُّقِيمٌ",576],["10:9:15",209,"ٱلنَّعِيمِ","(of) Delight","ٱلْأَنْهَـٰرُ فِى جَنَّـٰتِ","",576],["10:24:16",211,"وَٱلْأَنْعَـٰمُ","and the cattle","مِمَّا يَأْكُلُ ٱلنَّاسُ","حَتَّىٰٓ إِذَآ أَخَذَتِ",347],["11:10:3",222,"نَعْمَآءَ","(of) favor","وَلَئِنْ أَذَقْنَـٰهُ","بَعْدَ ضَرَّآءَ مَسَّتْهُ",4014],["12:6:9",236,"نِعْمَتَهُۥ","His Favor","تَأْوِيلِ ٱلْأَحَادِيثِ وَيُتِمُّ","عَلَيْكَ وَعَلَىٰٓ ءَالِ",237],["13:24:5",252,"فَنِعْمَ","And excellent","عَلَيْكُم بِمَا صَبَرْتُمْ ۚ","عُقْبَى ٱلدَّارِ",554],["14:6:6",256,"نِعْمَةَ","(the) Favor of Allah","مُوسَىٰ لِقَوْمِهِ ٱذْكُرُوا۟","ٱللَّهِ عَلَيْكُمْ إِذْ",237],["14:28:6",259,"نِعْمَتَ","(the) Favor","إِلَى ٱلَّذِينَ بَدَّلُوا۟","ٱللَّهِ كُفْرًۭا وَأَحَلُّوا۟",237],["14:34:8",260,"نِعْمَتَ","(the) Favor of Allah","سَأَلْتُمُوهُ ۚ وَإِن تَعُدُّوا۟","ٱللَّهِ لَا تُحْصُوهَآ ۗ",237],["16:5:1",267,"وَٱلْأَنْعَـٰمَ","And the cattle","","خَلَقَهَا ۗ لَكُمْ فِيهَا",347],["16:18:3",269,"نِعْمَةَ","the Favors of Allah","وَإِن تَعُدُّوا۟","ٱللَّهِ لَا تُحْصُوهَآ ۗ",237],["16:30:18",270,"وَلَنِعْمَ","And surely excellent","وَلَدَارُ ٱلْـَٔاخِرَةِ خَيْرٌۭ ۚ","دَارُ ٱلْمُتَّقِينَ",554],["16:53:4",272,"نِّعْمَةٍۢ","favor","وَمَا بِكُم مِّن","فَمِنَ ٱللَّهِ ۖ ثُمَّ",237],["16:66:4",274,"ٱلْأَنْعَـٰمِ","the cattle","وَإِنَّ لَكُمْ فِى","لَعِبْرَةًۭ ۖ نُّسْقِيكُم مِّمَّا",347],["16:71:20",274,"أَفَبِنِعْمَةِ","Then is it the Favor","فَهُمْ فِيهِ سَوَآءٌ ۚ","ٱللَّهِ يَجْحَدُونَ",237],["16:72:18",274,"وَبِنِعْمَتِ","and the Favor","ٱلطَّيِّبَـٰتِ ۚ أَفَبِٱلْبَـٰطِلِ يُؤْمِنُونَ","ٱللَّهِ هُمْ يَكْفُرُونَ",237],["16:80:11",276,"ٱلْأَنْعَـٰمِ","(of) the cattle","لَكُم مِّن جُلُودِ","بُيُوتًۭا تَسْتَخِفُّونَهَا يَوْمَ",347],["16:81:22",276,"نِعْمَتَهُۥ","His Favor","بَأْسَكُمْ ۚ كَذَٰلِكَ يُتِمُّ","عَلَيْكُمْ لَعَلَّكُمْ تُسْلِمُونَ",237],["16:83:2",276,"نِعْمَتَ","(the) Favor","يَعْرِفُونَ","ٱللَّهِ ثُمَّ يُنكِرُونَهَا",237],["16:112:15",280,"بِأَنْعُمِ","(the) Favors of Allah","كُلِّ مَكَانٍۢ فَكَفَرَتْ","ٱللَّهِ فَأَذَٰقَهَا ٱللَّهُ",237],["16:114:8",280,"نِعْمَتَ","(for the) Favor","حَلَـٰلًۭا طَيِّبًۭا وَٱشْكُرُوا۟","ٱللَّهِ إِن كُنتُمْ",237],["16:121:2",281,"لِّأَنْعُمِهِ ۚ","for His favors","شَاكِرًۭا","ٱجْتَبَىٰهُ وَهَدَىٰهُ إِلَىٰ",237],["17:83:2",290,"أَنْعَمْنَا","We bestow favor","وَإِذَآ","عَلَى ٱلْإِنسَـٰنِ أَعْرَضَ",564],["18:31:25",297,"نِعْمَ","Excellent","فِيهَا عَلَى ٱلْأَرَآئِكِ ۚ","ٱلثَّوَابُ وَحَسُنَتْ مُرْتَفَقًۭا",554],["19:58:3",309,"أَنْعَمَ","Allah bestowed favor","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","ٱللَّهُ عَلَيْهِم مِّنَ",564],["20:54:3",315,"أَنْعَـٰمَكُمْ ۗ","your cattle","كُلُوا۟ وَٱرْعَوْا۟","إِنَّ فِى ذَٰلِكَ",347],["22:28:15",335,"ٱلْأَنْعَـٰمِ ۖ","(of) cattle","رَزَقَهُم مِّنۢ بَهِيمَةِ","فَكُلُوا۟ مِنْهَا وَأَطْعِمُوا۟",347],["22:30:13",335,"ٱلْأَنْعَـٰمُ","the cattle","رَبِّهِۦ ۗ وَأُحِلَّتْ لَكُمُ","إِلَّا مَا يُتْلَىٰ",347],["22:34:13",336,"ٱلْأَنْعَـٰمِ ۗ","(of) cattle","رَزَقَهُم مِّنۢ بَهِيمَةِ","فَإِلَـٰهُكُمْ إِلَـٰهٌۭ وَٰحِدٌۭ",347],["22:56:12",339,"ٱلنَّعِيمِ","(of) Delight","ٱلصَّـٰلِحَـٰتِ فِى جَنَّـٰتِ","",576],["22:78:41",341,"فَنِعْمَ","so an Excellent","بِٱللَّهِ هُوَ مَوْلَىٰكُمْ ۖ","ٱلْمَوْلَىٰ وَنِعْمَ ٱلنَّصِيرُ",554],["22:78:43",341,"وَنِعْمَ","and an Excellent","مَوْلَىٰكُمْ ۖ فَنِعْمَ ٱلْمَوْلَىٰ","ٱلنَّصِيرُ",554],["23:21:4",343,"ٱلْأَنْعَـٰمِ","the cattle","وَإِنَّ لَكُمْ فِى","لَعِبْرَةًۭ ۖ نُّسْقِيكُم مِّمَّا",347],["25:44:11",364,"كَٱلْأَنْعَـٰمِ ۖ","like cattle","إِنْ هُمْ إِلَّا","بَلْ هُمْ أَضَلُّ",347],["25:49:8",364,"أَنْعَـٰمًۭا","cattle","وَنُسْقِيَهُۥ مِمَّا خَلَقْنَآ","وَأَنَاسِىَّ كَثِيرًۭا",347],["26:22:2",368,"نِعْمَةٌۭ","(is the) favor","وَتِلْكَ","تَمُنُّهَا عَلَىَّ أَنْ",237],["26:85:5",371,"ٱلنَّعِيمِ","(of) Delight","مِن وَرَثَةِ جَنَّةِ","",576],["26:133:2",372,"بِأَنْعَـٰمٍۢ","with cattle","أَمَدَّكُم","وَبَنِينَ",347],["27:19:10",378,"نِعْمَتَكَ","(for) Your Favor","أَوْزِعْنِىٓ أَنْ أَشْكُرَ","ٱلَّتِىٓ أَنْعَمْتَ عَلَىَّ",237],["27:19:12",378,"أَنْعَمْتَ","You have bestowed","أَشْكُرَ نِعْمَتَكَ ٱلَّتِىٓ","عَلَىَّ وَعَلَىٰ وَٰلِدَىَّ",564],["28:17:4",387,"أَنْعَمْتَ","You have favored","قَالَ رَبِّ بِمَآ","عَلَىَّ فَلَنْ أَكُونَ",564],["29:58:15",403,"نِعْمَ","Excellent is","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا ۚ","أَجْرُ ٱلْعَـٰمِلِينَ",554],["29:67:13",404,"وَبِنِعْمَةِ","and in (the) Favor","حَوْلِهِمْ ۚ أَفَبِٱلْبَـٰطِلِ يُؤْمِنُونَ","ٱللَّهِ يَكْفُرُونَ",237],["31:8:8",411,"ٱلنَّعِيمِ","(of) Delight","ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتُ","",576],["31:20:15",413,"نِعَمَهُۥ","His Bounties","ٱلْأَرْضِ وَأَسْبَغَ عَلَيْكُمْ","ظَـٰهِرَةًۭ وَبَاطِنَةًۭ ۗ وَمِنَ",237],["31:31:8",414,"بِنِعْمَتِ","by (the) Grace","تَجْرِى فِى ٱلْبَحْرِ","ٱللَّهِ لِيُرِيَكُم مِّنْ",237],["32:27:14",417,"أَنْعَـٰمُهُمْ","their cattle","زَرْعًۭا تَأْكُلُ مِنْهُ","وَأَنفُسُهُمْ ۖ أَفَلَا يُبْصِرُونَ",347],["33:9:5",419,"نِعْمَةَ","(the) Favor","ٱلَّذِينَ ءَامَنُوا۟ ٱذْكُرُوا۟","ٱللَّهِ عَلَيْكُمْ إِذْ",237],["33:37:4",423,"أَنْعَمَ","Allah bestowed favor","وَإِذْ تَقُولُ لِلَّذِىٓ","ٱللَّهُ عَلَيْهِ وَأَنْعَمْتَ",564],["33:37:7",423,"وَأَنْعَمْتَ","and you bestowed favor","أَنْعَمَ ٱللَّهُ عَلَيْهِ","عَلَيْهِ أَمْسِكْ عَلَيْكَ",564],["35:3:4",434,"نِعْمَتَ","(the) Favor","يَـٰٓأَيُّهَا ٱلنَّاسُ ٱذْكُرُوا۟","ٱللَّهِ عَلَيْكُمْ ۚ هَلْ",237],["35:28:4",437,"وَٱلْأَنْعَـٰمِ","and the cattle","وَمِنَ ٱلنَّاسِ وَٱلدَّوَآبِّ","مُخْتَلِفٌ أَلْوَٰنُهُۥ كَذَٰلِكَ ۗ",347],["36:71:9",445,"أَنْعَـٰمًۭا","cattle","مِّمَّا عَمِلَتْ أَيْدِينَآ","فَهُمْ لَهَا مَـٰلِكُونَ",347],["37:43:3",447,"ٱلنَّعِيمِ","(of) Delight","فِى جَنَّـٰتِ","",576],["37:57:2",448,"نِعْمَةُ","(for the) Grace","وَلَوْلَا","رَبِّى لَكُنتُ مِنَ",237],["37:75:4",448,"فَلَنِعْمَ","and Best","وَلَقَدْ نَادَىٰنَا نُوحٌۭ","ٱلْمُجِيبُونَ",554],["38:30:4",455,"نِعْمَ","an excellent","وَوَهَبْنَا لِدَاوُۥدَ سُلَيْمَـٰنَ ۚ","ٱلْعَبْدُ ۖ إِنَّهُۥٓ أَوَّابٌ",554],["38:44:11",456,"نِّعْمَ","an excellent","إِنَّا وَجَدْنَـٰهُ صَابِرًۭا ۚ","ٱلْعَبْدُ ۖ إِنَّهُۥٓ أَوَّابٌۭ",554],["39:6:12",459,"ٱلْأَنْعَـٰمِ","the cattle","وَأَنزَلَ لَكُم مِّنَ","ثَمَـٰنِيَةَ أَزْوَٰجٍۢ ۚ يَخْلُقُكُمْ",347],["39:8:12",459,"نِعْمَةًۭ","a favor","ثُمَّ إِذَا خَوَّلَهُۥ","مِّنْهُ نَسِىَ مَا",237],["39:49:9",464,"نِعْمَةًۭ","a favor","ثُمَّ إِذَا خَوَّلْنَـٰهُ","مِّنَّا قَالَ إِنَّمَآ",237],["39:74:14",466,"فَنِعْمَ","So excellent","ٱلْجَنَّةِ حَيْثُ نَشَآءُ ۖ","أَجْرُ ٱلْعَـٰمِلِينَ",554],["40:79:5",476,"ٱلْأَنْعَـٰمَ","the cattle","ٱلَّذِى جَعَلَ لَكُمُ","لِتَرْكَبُوا۟ مِنْهَا وَمِنْهَا",347],["41:51:2",482,"أَنْعَمْنَا","We bestow favor","وَإِذَآ","عَلَى ٱلْإِنسَـٰنِ أَعْرَضَ",564],["42:11:10",484,"ٱلْأَنْعَـٰمِ","the cattle","أَنفُسِكُمْ أَزْوَٰجًۭا وَمِنَ","أَزْوَٰجًۭا ۖ يَذْرَؤُكُمْ فِيهِ ۚ",347],["43:12:9",490,"وَٱلْأَنْعَـٰمِ","and the cattle","لَكُم مِّنَ ٱلْفُلْكِ","مَا تَرْكَبُونَ",347],["43:13:6",490,"نِعْمَةَ","(the) favor","ظُهُورِهِۦ ثُمَّ تَذْكُرُوا۟","رَبِّكُمْ إِذَا ٱسْتَوَيْتُمْ",237],["43:59:5",493,"أَنْعَمْنَا","We bestowed Our favor","هُوَ إِلَّا عَبْدٌ","عَلَيْهِ وَجَعَلْنَـٰهُ مَثَلًۭا",564],["44:27:1",497,"وَنَعْمَةٍۢ","And pleasant things","","كَانُوا۟ فِيهَا فَـٰكِهِينَ",2568],["46:15:26",504,"نِعْمَتَكَ","(for) Your favor","أَوْزِعْنِىٓ أَنْ أَشْكُرَ","ٱلَّتِىٓ أَنْعَمْتَ عَلَىَّ",237],["46:15:28",504,"أَنْعَمْتَ","You have bestowed","أَشْكُرَ نِعْمَتَكَ ٱلَّتِىٓ","عَلَىَّ وَعَلَىٰ وَٰلِدَىَّ",564],["47:12:19",508,"ٱلْأَنْعَـٰمُ","the cattle","وَيَأْكُلُونَ كَمَا تَأْكُلُ","وَٱلنَّارُ مَثْوًۭى لَّهُمْ",347],["48:2:11",511,"نِعْمَتَهُۥ","His favor","وَمَا تَأَخَّرَ وَيُتِمَّ","عَلَيْكَ وَيَهْدِيَكَ صِرَٰطًۭا",237],["49:8:4",516,"وَنِعْمَةًۭ ۚ","and favor","فَضْلًۭا مِّنَ ٱللَّهِ","وَٱللَّهُ عَلِيمٌ حَكِيمٌۭ",237],["51:48:3",522,"فَنِعْمَ","how excellent","وَٱلْأَرْضَ فَرَشْنَـٰهَا","ٱلْمَـٰهِدُونَ",554],["52:17:5",524,"وَنَعِيمٍۢ","and pleasure","ٱلْمُتَّقِينَ فِى جَنَّـٰتٍۢ","",576],["52:29:4",524,"بِنِعْمَتِ","(are) by (the) grace","فَذَكِّرْ فَمَآ أَنتَ","رَبِّكَ بِكَاهِنٍۢ وَلَا",237],["54:35:1",530,"نِّعْمَةًۭ","(As) a favor","","مِّنْ عِندِنَا ۚ كَذَٰلِكَ",237],["56:12:3",534,"ٱلنَّعِيمِ","(of) Pleasure","فِى جَنَّـٰتِ","",576],["56:89:4",537,"نَعِيمٍۢ","(of) Pleasure","فَرَوْحٌۭ وَرَيْحَانٌۭ وَجَنَّتُ","",576],["68:2:3",564,"بِنِعْمَةِ","by (the) Grace","مَآ أَنتَ","رَبِّكَ بِمَجْنُونٍۢ",237],["68:34:6",565,"ٱلنَّعِيمِ","(of) Delight","عِندَ رَبِّهِمْ جَنَّـٰتِ","",576],["68:49:4",566,"نِعْمَةٌۭ","a Favor","لَّوْلَآ أَن تَدَٰرَكَهُۥ","مِّن رَّبِّهِۦ لَنُبِذَ",237],["70:38:8",569,"نَعِيمٍۢ","(of) Delight","أَن يُدْخَلَ جَنَّةَ","",576],["73:11:4",574,"ٱلنَّعْمَةِ","(of) the ease","وَذَرْنِى وَٱلْمُكَذِّبِينَ أُو۟لِى","وَمَهِّلْهُمْ قَلِيلًا",2568],["76:20:5",579,"نَعِيمًۭا","blessings","رَأَيْتَ ثَمَّ رَأَيْتَ","وَمُلْكًۭا كَبِيرًا",576],["77:23:2",581,"فَنِعْمَ","and Best","فَقَدَرْنَا","ٱلْقَـٰدِرُونَ",554],["79:33:3",584,"وَلِأَنْعَـٰمِكُمْ","and for your cattle","مَتَـٰعًۭا لَّكُمْ","",347],["80:32:3",585,"وَلِأَنْعَـٰمِكُمْ","and for your cattle","مَّتَـٰعًۭا لَّكُمْ","",347],["82:13:4",587,"نَعِيمٍۢ","bliss","إِنَّ ٱلْأَبْرَارَ لَفِى","",576],["83:22:4",588,"نَعِيمٍ","bliss","إِنَّ ٱلْأَبْرَارَ لَفِى","",576],["83:24:5",588,"ٱلنَّعِيمِ","(of) bliss","فِى وُجُوهِهِمْ نَضْرَةَ","",576],["88:8:3",592,"نَّاعِمَةٌۭ","(will be) joyful","وُجُوهٌۭ يَوْمَئِذٍۢ","",4074],["89:15:8",593,"وَنَعَّمَهُۥ","and favors him","ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ","فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",4015],["92:19:5",596,"نِّعْمَةٍۢ","favor","لِأَحَدٍ عِندَهُۥ مِن","تُجْزَىٰٓ",237],["93:11:2",596,"بِنِعْمَةِ","(the) Favor","وَأَمَّا","رَبِّكَ فَحَدِّثْ",237],["102:8:5",600,"ٱلنَّعِيمِ","the pleasures","لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ","",576]]