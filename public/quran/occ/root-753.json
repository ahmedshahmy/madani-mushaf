[["7:150:7",169,"أَسِفًۭا","and grieved","إِلَىٰ قَوْمِهِۦ غَضْبَـٰنَ","قَالَ بِئْسَمَا خَلَفْتُمُونِى",2190],["12:84:4",245,"يَـٰٓأَسَفَىٰ","Alas, my grief","وَتَوَلَّىٰ عَنْهُمْ وَقَالَ","عَلَىٰ يُوسُفَ وَٱبْيَضَّتْ",2189],["18:6:11",294,"أَسَفًا","(in) grief","يُؤْمِنُوا۟ بِهَـٰذَا ٱلْحَدِيثِ","",2189],["20:86:6",317,"أَسِفًۭا ۚ","(and) sorrowful","إِلَىٰ قَوْمِهِۦ غَضْبَـٰنَ","قَالَ يَـٰقَوْمِ أَلَمْ",2190],["43:55:2",493,"ءَاسَفُونَا","they angered Us","فَلَمَّآ","ٱنتَقَمْنَا مِنْهُمْ فَأَغْرَقْنَـٰهُمْ",2909]]