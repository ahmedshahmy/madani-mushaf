[["2:187:40",29,"ٱلْأَسْوَدِ","[the] black","ٱلْأَبْيَضُ مِنَ ٱلْخَيْطِ","مِنَ ٱلْفَجْرِ ۖ ثُمَّ",3039],["3:39:16",55,"وَسَيِّدًۭا","and a noble","بِكَلِمَةٍۢ مِّنَ ٱللَّهِ","وَحَصُورًۭا وَنَبِيًّۭا مِّنَ",1992],["3:106:4",63,"وَتَسْوَدُّ","and would become black","يَوْمَ تَبْيَضُّ وُجُوهٌۭ","وُجُوهٌۭ ۚ فَأَمَّا ٱلَّذِينَ",2855],["3:106:8",63,"ٱسْوَدَّتْ","turn black","وُجُوهٌۭ ۚ فَأَمَّا ٱلَّذِينَ","وُجُوهُهُمْ أَكَفَرْتُم بَعْدَ",2855],["12:25:8",238,"سَيِّدَهَا","her husband","مِن دُبُرٍۢ وَأَلْفَيَا","لَدَا ٱلْبَابِ ۚ قَالَتْ",1992],["16:58:7",273,"مُسْوَدًّۭا","dark","بِٱلْأُنثَىٰ ظَلَّ وَجْهُهُۥ","وَهُوَ كَظِيمٌۭ",2509],["33:67:5",427,"سَادَتَنَا","our chiefs","رَبَّنَآ إِنَّآ أَطَعْنَا","وَكُبَرَآءَنَا فَأَضَلُّونَا ٱلسَّبِيلَا۠",1992],["35:27:22",437,"سُودٌۭ","and intensely black","مُّخْتَلِفٌ أَلْوَٰنُهَا وَغَرَابِيبُ","",4286],["39:60:9",465,"مُّسْوَدَّةٌ ۚ","(will be) blackened","عَلَى ٱللَّهِ وُجُوهُهُم","أَلَيْسَ فِى جَهَنَّمَ",3996],["43:17:10",490,"مُسْوَدًّۭا","dark","مَثَلًۭا ظَلَّ وَجْهُهُۥ","وَهُوَ كَظِيمٌ",2509]]