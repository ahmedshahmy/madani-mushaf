[["6:94:3",139,"فُرَٰدَىٰ","alone","وَلَقَدْ جِئْتُمُونَا","كَمَا خَلَقْنَـٰكُمْ أَوَّلَ",2368],["19:80:5",311,"فَرْدًۭا","alone","مَا يَقُولُ وَيَأْتِينَا","",1829],["19:95:5",311,"فَرْدًا","alone","ءَاتِيهِ يَوْمَ ٱلْقِيَـٰمَةِ","",1829],["21:89:8",329,"فَرْدًۭا","alone","رَبِّ لَا تَذَرْنِى","وَأَنتَ خَيْرُ ٱلْوَٰرِثِينَ",1829],["34:46:9",433,"وَفُرَٰدَىٰ","and (as) individuals","تَقُومُوا۟ لِلَّهِ مَثْنَىٰ","ثُمَّ تَتَفَكَّرُوا۟ ۚ مَا",2368]]