[["9:120:23",206,"ظَمَأٌۭ","thirst","بِأَنَّهُمْ لَا يُصِيبُهُمْ","وَلَا نَصَبٌۭ وَلَا",3305],["20:119:3",320,"تَظْمَؤُا۟","will suffer from thirst","وَأَنَّكَ لَا","فِيهَا وَلَا تَضْحَىٰ",4346],["24:39:7",355,"ٱلظَّمْـَٔانُ","the thirsty one","كَسَرَابٍۭ بِقِيعَةٍۢ يَحْسَبُهُ","مَآءً حَتَّىٰٓ إِذَا",3310]]