[["2:246:4",40,"ٱلْمَلَإِ","the chiefs","أَلَمْ تَرَ إِلَى","مِنۢ بَنِىٓ إِسْرَٰٓءِيلَ",365],["3:91:11",61,"مِّلْءُ","full","يُقْبَلَ مِنْ أَحَدِهِم","ٱلْأَرْضِ ذَهَبًۭا وَلَوِ",3947],["7:18:9",152,"لَأَمْلَأَنَّ","surely, I will fill","لَّمَن تَبِعَكَ مِنْهُمْ","جَهَنَّمَ مِنكُمْ أَجْمَعِينَ",1202],["7:60:2",158,"ٱلْمَلَأُ","the chiefs","قَالَ","مِن قَوْمِهِۦٓ إِنَّا",365],["7:66:2",158,"ٱلْمَلَأُ","the chiefs","قَالَ","ٱلَّذِينَ كَفَرُوا۟ مِن",365],["7:75:2",160,"ٱلْمَلَأُ","the chiefs","قَالَ","ٱلَّذِينَ ٱسْتَكْبَرُوا۟ مِن",365],["7:88:2",162,"ٱلْمَلَأُ","the chiefs","۞ قَالَ","ٱلَّذِينَ ٱسْتَكْبَرُوا۟ مِن",365],["7:90:2",162,"ٱلْمَلَأُ","the chiefs","وَقَالَ","ٱلَّذِينَ كَفَرُوا۟ مِن",365],["7:103:9",163,"وَمَلَإِي۟هِۦ","and his chiefs","بِـَٔايَـٰتِنَآ إِلَىٰ فِرْعَوْنَ","فَظَلَمُوا۟ بِهَا ۖ فَٱنظُرْ",365],["7:109:2",164,"ٱلْمَلَأُ","the chiefs","قَالَ","مِن قَوْمِ فِرْعَوْنَ",365],["7:127:2",165,"ٱلْمَلَأُ","the chiefs","وَقَالَ","مِن قَوْمِ فِرْعَوْنَ",365],["10:75:9",217,"وَمَلَإِي۟هِۦ","and his chiefs","وَهَـٰرُونَ إِلَىٰ فِرْعَوْنَ","بِـَٔايَـٰتِنَا فَٱسْتَكْبَرُوا۟ وَكَانُوا۟",365],["10:83:12",218,"وَمَلَإِي۟هِمْ","and their chiefs","خَوْفٍۢ مِّن فِرْعَوْنَ","أَن يَفْتِنَهُمْ ۚ وَإِنَّ",365],["10:88:7",218,"وَمَلَأَهُۥ","and his chiefs","إِنَّكَ ءَاتَيْتَ فِرْعَوْنَ","زِينَةًۭ وَأَمْوَٰلًۭا فِى",365],["11:27:2",224,"ٱلْمَلَأُ","the chiefs","فَقَالَ","ٱلَّذِينَ كَفَرُوا۟ مِن",365],["11:38:6",226,"مَلَأٌۭ","(the) chiefs","وَكُلَّمَا مَرَّ عَلَيْهِ","مِّن قَوْمِهِۦ سَخِرُوا۟",365],["11:97:3",232,"وَمَلَإِي۟هِۦ","and his chiefs","إِلَىٰ فِرْعَوْنَ","فَٱتَّبَعُوٓا۟ أَمْرَ فِرْعَوْنَ ۖ",365],["11:119:10",235,"لَأَمْلَأَنَّ","Surely I will fill","وَتَمَّتْ كَلِمَةُ رَبِّكَ","جَهَنَّمَ مِنَ ٱلْجِنَّةِ",1202],["12:43:17",240,"ٱلْمَلَأُ","chiefs","وَأُخَرَ يَابِسَـٰتٍۢ ۖ يَـٰٓأَيُّهَا","أَفْتُونِى فِى رُءْيَـٰىَ",365],["18:18:20",295,"وَلَمُلِئْتَ","and surely you would have been filled","لَوَلَّيْتَ مِنْهُمْ فِرَارًۭا","مِنْهُمْ رُعْبًۭا",1202],["23:24:2",343,"ٱلْمَلَؤُا۟","the chiefs","فَقَالَ","ٱلَّذِينَ كَفَرُوا۟ مِن",365],["23:33:2",344,"ٱلْمَلَأُ","the chiefs","وَقَالَ","مِن قَوْمِهِ ٱلَّذِينَ",365],["23:46:3",345,"وَمَلَإِي۟هِۦ","and his chiefs","إِلَىٰ فِرْعَوْنَ","فَٱسْتَكْبَرُوا۟ وَكَانُوا۟ قَوْمًا",365],["26:34:2",368,"لِلْمَلَإِ","to the chiefs","قَالَ","حَوْلَهُۥٓ إِنَّ هَـٰذَا",365],["27:29:3",379,"ٱلْمَلَؤُا۟","chiefs","قَالَتْ يَـٰٓأَيُّهَا","إِنِّىٓ أُلْقِىَ إِلَىَّ",365],["27:32:3",379,"ٱلْمَلَؤُا۟","chiefs","قَالَتْ يَـٰٓأَيُّهَا","أَفْتُونِى فِىٓ أَمْرِى",365],["27:38:3",380,"ٱلْمَلَؤُا۟","chiefs","قَالَ يَـٰٓأَيُّهَا","أَيُّكُمْ يَأْتِينِى بِعَرْشِهَا",365],["28:20:10",387,"ٱلْمَلَأَ","the chiefs","قَالَ يَـٰمُوسَىٰٓ إِنَّ","يَأْتَمِرُونَ بِكَ لِيَقْتُلُوكَ",365],["28:32:21",389,"وَمَلَإِي۟هِۦٓ ۚ","and his chiefs","رَّبِّكَ إِلَىٰ فِرْعَوْنَ","إِنَّهُمْ كَانُوا۟ قَوْمًۭا",365],["28:38:4",390,"ٱلْمَلَأُ","O chiefs","وَقَالَ فِرْعَوْنُ يَـٰٓأَيُّهَا","مَا عَلِمْتُ لَكُم",365],["32:13:11",416,"لَأَمْلَأَنَّ","that I will surely fill","حَقَّ ٱلْقَوْلُ مِنِّى","جَهَنَّمَ مِنَ ٱلْجِنَّةِ",1202],["37:8:4",446,"ٱلْمَلَإِ","the assembly","لَّا يَسَّمَّعُونَ إِلَى","ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن",365],["37:66:4",448,"فَمَالِـُٔونَ","and fill","فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا","مِنْهَا ٱلْبُطُونَ",2440],["38:6:2",453,"ٱلْمَلَأُ","the chiefs","وَٱنطَلَقَ","مِنْهُمْ أَنِ ٱمْشُوا۟",365],["38:69:6",457,"بِٱلْمَلَإِ","(of) the chiefs","لِىَ مِنْ عِلْمٍۭ","ٱلْأَعْلَىٰٓ إِذْ يَخْتَصِمُونَ",365],["38:85:1",458,"لَأَمْلَأَنَّ","Surely I will fill","","جَهَنَّمَ مِنكَ وَمِمَّن",1202],["43:46:7",492,"وَمَلَإِي۟هِۦ","and his chiefs","بِـَٔايَـٰتِنَآ إِلَىٰ فِرْعَوْنَ","فَقَالَ إِنِّى رَسُولُ",365],["50:30:5",519,"ٱمْتَلَأْتِ","you filled","نَقُولُ لِجَهَنَّمَ هَلِ","وَتَقُولُ هَلْ مِن",4810],["56:53:1",536,"فَمَالِـُٔونَ","Then will fill","","مِنْهَا ٱلْبُطُونَ",2440],["72:8:5",572,"مُلِئَتْ","filled (with)","لَمَسْنَا ٱلسَّمَآءَ فَوَجَدْنَـٰهَا","حَرَسًۭا شَدِيدًۭا وَشُهُبًۭا",1202]]