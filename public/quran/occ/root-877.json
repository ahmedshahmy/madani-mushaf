[["6:150:2",148,"هَلُمَّ","Bring forward","قُلْ","شُهَدَآءَكُمُ ٱلَّذِينَ يَشْهَدُونَ",2433],["33:18:8",420,"هَلُمَّ","Come","مِنكُمْ وَٱلْقَآئِلِينَ لِإِخْوَٰنِهِمْ","إِلَيْنَا ۖ وَلَا يَأْتُونَ",2433],["53:32:7",527,"ٱللَّمَمَ ۚ","the small faults","ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا","إِنَّ رَبَّكَ وَٰسِعُ",3612],["89:19:4",593,"لَّمًّۭا","altogether","وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا","",3613]]