[["2:17:15",4,"ظُلُمَـٰتٍۢ","darkness[es]","بِنُورِهِمْ وَتَرَكَهُمْ فِى","لَّا يُبْصِرُونَ",452],["2:19:6",4,"ظُلُمَـٰتٌۭ","darkness[es]","مِّنَ ٱلسَّمَآءِ فِيهِ","وَرَعْدٌۭ وَبَرْقٌۭ يَجْعَلُونَ",452],["2:20:11",4,"أَظْلَمَ","it darkens","مَّشَوْا۟ فِيهِ وَإِذَآ","عَلَيْهِمْ قَامُوا۟ ۚ وَلَوْ",2972],["2:35:18",6,"ٱلظَّـٰلِمِينَ","the wrongdoers","ٱلشَّجَرَةَ فَتَكُونَا مِنَ","",89],["2:51:12",8,"ظَـٰلِمُونَ","(were) wrongdoers","مِنۢ بَعْدِهِۦ وَأَنتُمْ","",89],["2:54:7",8,"ظَلَمْتُمْ","[you] have wronged","لِقَوْمِهِۦ يَـٰقَوْمِ إِنَّكُمْ","أَنفُسَكُم بِٱتِّخَاذِكُمُ ٱلْعِجْلَ",104],["2:57:14",8,"ظَلَمُونَا","they wronged Us","مَا رَزَقْنَـٰكُمْ ۖ وَمَا","وَلَـٰكِن كَانُوٓا۟ أَنفُسَهُمْ",104],["2:57:18",8,"يَظْلِمُونَ","doing wrong","وَلَـٰكِن كَانُوٓا۟ أَنفُسَهُمْ","",104],["2:59:3",9,"ظَلَمُوا۟","wronged","فَبَدَّلَ ٱلَّذِينَ","قَوْلًا غَيْرَ ٱلَّذِى",104],["2:59:12",9,"ظَلَمُوا۟","wronged","فَأَنزَلْنَا عَلَى ٱلَّذِينَ","رِجْزًۭا مِّنَ ٱلسَّمَآءِ",104],["2:92:11",14,"ظَـٰلِمُونَ","(were) wrongdoers","مِنۢ بَعْدِهِۦ وَأَنتُمْ","",89],["2:95:9",15,"بِٱلظَّـٰلِمِينَ","of the wrongdoers","أَيْدِيهِمْ ۗ وَٱللَّهُ عَلِيمٌۢ","",89],["2:114:2",18,"أَظْلَمُ","(is) more unjust","وَمَنْ","مِمَّن مَّنَعَ مَسَـٰجِدَ",585],["2:124:19",19,"ٱلظَّـٰلِمِينَ","(to) the wrongdoers","لَا يَنَالُ عَهْدِى","",89],["2:140:19",21,"أَظْلَمُ","(is) more unjust","أَمِ ٱللَّهُ ۗ وَمَنْ","مِمَّن كَتَمَ شَهَـٰدَةً",585],["2:145:32",22,"ٱلظَّـٰلِمِينَ","the wrongdoers","إِنَّكَ إِذًۭا لَّمِنَ","",89],["2:150:22",23,"ظَلَمُوا۟","wronged","حُجَّةٌ إِلَّا ٱلَّذِينَ","مِنْهُمْ فَلَا تَخْشَوْهُمْ",104],["2:165:20",25,"ظَلَمُوٓا۟","wronged","وَلَوْ يَرَى ٱلَّذِينَ","إِذْ يَرَوْنَ ٱلْعَذَابَ",104],["2:193:15",30,"ٱلظَّـٰلِمِينَ","the oppressors","عُدْوَٰنَ إِلَّا عَلَى","",89],["2:229:46",36,"ٱلظَّـٰلِمُونَ","(are) the wrongdoers","ٱللَّهِ فَأُو۟لَـٰٓئِكَ هُمُ","",89],["2:231:19",37,"ظَلَمَ","he wronged","يَفْعَلْ ذَٰلِكَ فَقَدْ","نَفْسَهُۥ ۚ وَلَا تَتَّخِذُوٓا۟",104],["2:246:54",40,"بِٱلظَّـٰلِمِينَ","of the wrongdoers","مِّنْهُمْ ۗ وَٱللَّهُ عَلِيمٌۢ","",89],["2:254:21",42,"ٱلظَّـٰلِمُونَ","(are) the wrongdoers","شَفَـٰعَةٌۭ ۗ وَٱلْكَـٰفِرُونَ هُمُ","",89],["2:257:7",43,"ٱلظُّلُمَـٰتِ","[the] darkness","ءَامَنُوا۟ يُخْرِجُهُم مِّنَ","إِلَى ٱلنُّورِ ۖ وَٱلَّذِينَ",452],["2:257:18",43,"ٱلظُّلُمَـٰتِ ۗ","[the] darkness","مِّنَ ٱلنُّورِ إِلَى","أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ ۖ",452],["2:258:43",43,"ٱلظَّـٰلِمِينَ","(who are) [the] wrongdoers","لَا يَهْدِى ٱلْقَوْمَ","",89],["2:270:13",46,"لِلظَّـٰلِمِينَ","for the wrongdoers","ٱللَّهَ يَعْلَمُهُۥ ۗ وَمَا","مِنْ أَنصَارٍ",89],["2:272:28",46,"تُظْلَمُونَ","be wronged","إِلَيْكُمْ وَأَنتُمْ لَا","",104],["2:279:15",47,"تَظْلِمُونَ","wrong","رُءُوسُ أَمْوَٰلِكُمْ لَا","وَلَا تُظْلَمُونَ",104],["2:279:17",47,"تُظْلَمُونَ","you will be wronged","لَا تَظْلِمُونَ وَلَا","",104],["2:281:15",47,"يُظْلَمُونَ","will be wronged","كَسَبَتْ وَهُمْ لَا","",104],["3:25:15",53,"يُظْلَمُونَ","be wronged","كَسَبَتْ وَهُمْ لَا","",104],["3:57:11",57,"ٱلظَّـٰلِمِينَ","the wrongdoers","وَٱللَّهُ لَا يُحِبُّ","",89],["3:86:18",61,"ٱلظَّـٰلِمِينَ","[the] wrongdoers","لَا يَهْدِى ٱلْقَوْمَ","",89],["3:94:11",62,"ٱلظَّـٰلِمُونَ","(are) the wrongdoers","ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ","",89],["3:108:10",63,"ظُلْمًۭا","injustice","وَمَا ٱللَّهُ يُرِيدُ","لِّلْعَـٰلَمِينَ",512],["3:117:15",65,"ظَلَمُوٓا۟","who wronged","أَصَابَتْ حَرْثَ قَوْمٍۢ","أَنفُسَهُمْ فَأَهْلَكَتْهُ ۚ وَمَا",104],["3:117:19",65,"ظَلَمَهُمُ","(has) wronged them","أَنفُسَهُمْ فَأَهْلَكَتْهُ ۚ وَمَا","ٱللَّهُ وَلَـٰكِنْ أَنفُسَهُمْ",104],["3:117:23",65,"يَظْلِمُونَ","they wronged","ٱللَّهُ وَلَـٰكِنْ أَنفُسَهُمْ","",104],["3:128:12",66,"ظَـٰلِمُونَ","(are) wrongdoers","أَوْ يُعَذِّبَهُمْ فَإِنَّهُمْ","",89],["3:135:6",67,"ظَلَمُوٓا۟","wronged","فَعَلُوا۟ فَـٰحِشَةً أَوْ","أَنفُسَهُمْ ذَكَرُوا۟ ٱللَّهَ",104],["3:140:24",67,"ٱلظَّـٰلِمِينَ","the wrongdoers","وَٱللَّهُ لَا يُحِبُّ","",89],["3:151:19",69,"ٱلظَّـٰلِمِينَ","[of] the wrongdoers","ٱلنَّارُ ۚ وَبِئْسَ مَثْوَ