ُوا۟","wronged","ثُمَّ قِيلَ لِلَّذِينَ","ذُوقُوا۟ عَذَابَ ٱلْخُلْدِ",104],["10:54:5",215,"ظَلَمَتْ","(that) wronged","أَنَّ لِكُلِّ نَفْسٍۢ","مَا فِى ٱلْأَرْضِ",104],["10:54:21",215,"يُظْلَمُونَ","(be) wronged","بِٱلْقِسْطِ ۚ وَهُمْ لَا","",104],["10:85:10",218,"ٱلظَّـٰلِمِينَ","the wrongdoers","تَجْعَلْنَا فِتْنَةًۭ لِّلْقَوْمِ","",89],["10:106:16",220,"ٱلظَّـٰلِمِينَ","the wrongdoers","فَإِنَّكَ إِذًۭا مِّنَ","",89],["11:18:2",223,"أَظْلَمُ","(is) more unjust","وَمَنْ","مِمَّنِ ٱفْتَرَىٰ عَلَى",585],["11:18:23",223,"ٱلظَّـٰلِمِينَ","the wrongdoers","لَعْنَةُ ٱللَّهِ عَلَى","",89],["11:31:31",225,"ٱلظَّـٰلِمِينَ","the wrongdoers","إِنِّىٓ إِذًۭا لَّمِنَ","",89],["11:37:9",225,"ظَلَمُوٓا۟ ۚ","wronged","تُخَـٰطِبْنِى فِى ٱلَّذِينَ","إِنَّهُم مُّغْرَقُونَ",104],["11:44:17",226,"ٱلظَّـٰلِمِينَ","the wrongdoers","وَقِيلَ بُعْدًۭا لِّلْقَوْمِ","",89],["11:67:3",229,"ظَلَمُوا۟","wronged","وَأَخَذَ ٱلَّذِينَ","ٱلصَّيْحَةُ فَأَصْبَحُوا۟ فِى",104],["11:83:7",231,"ٱلظَّـٰلِمِينَ","the wrongdoers","وَمَا هِىَ مِنَ","بِبَعِيدٍۢ",89],["11:94:13",232,"ظَلَمُوا۟","wronged","مِّنَّا وَأَخَذَتِ ٱلَّذِينَ","ٱلصَّيْحَةُ فَأَصْبَحُوا۟ فِى",104],["11:101:2",233,"ظَلَمْنَـٰهُمْ","We wronged them","وَمَا","وَلَـٰكِن ظَلَمُوٓا۟ أَنفُسَهُمْ ۖ",104],["11:101:4",233,"ظَلَمُوٓا۟","they wronged","وَمَا ظَلَمْنَـٰهُمْ وَلَـٰكِن","أَنفُسَهُمْ ۖ فَمَآ أَغْنَتْ",104],["11:102:8",233,"ظَـٰلِمَةٌ ۚ","(are) doing wrong","أَخَذَ ٱلْقُرَىٰ وَهِىَ","إِنَّ أَخْذَهُۥٓ أَلِيمٌۭ",1532],["11:113:5",234,"ظَلَمُوا۟","do wrong","تَرْكَنُوٓا۟ إِلَى ٱلَّذِينَ","فَتَمَسَّكُمُ ٱلنَّارُ وَمَا",104],["11:116:21",234,"ظَلَمُوا۟","did wrong","مِنْهُمْ ۗ وَٱتَّبَعَ ٱلَّذِينَ","مَآ أُتْرِفُوا۟ فِيهِ",104],["11:117:6",234,"بِظُلْمٍۢ","unjustly","رَبُّكَ لِيُهْلِكَ ٱلْقُرَىٰ","وَأَهْلُهَا مُصْلِحُونَ",512],["12:23:23",238,"ٱلظَّـٰلِمُونَ","the wrongdoers","إِنَّهُۥ لَا يُفْلِحُ","",89],["12:75:11",244,"ٱلظَّـٰلِمِينَ","the wrongdoers","جَزَٰٓؤُهُۥ ۚ كَذَٰلِكَ نَجْزِى","",89],["12:79:13",245,"لَّظَـٰلِمُونَ","surely (would be) wrongdoers","عِندَهُۥٓ إِنَّآ إِذًۭا","",89],["13:6:16",250,"ظُلْمِهِمْ ۖ","their wrongdoing","مَغْفِرَةٍۢ لِّلنَّاسِ عَلَىٰ","وَإِنَّ رَبَّكَ لَشَدِيدُ",512],["13:16:27",251,"ٱلظُّلُمَـٰتُ","the darkness[es]","أَمْ هَلْ تَسْتَوِى","وَٱلنُّورُ ۗ أَمْ جَعَلُوا۟",452],["14:1:8",255,"ٱلظُّلُمَـٰتِ","the darkness[es]","لِتُخْرِجَ ٱلنَّاسَ مِنَ","إِلَى ٱلنُّورِ بِإِذْنِ",452],["14:5:9",255,"ٱلظُّلُمَـٰتِ","the darkness[es]","أَخْرِجْ قَوْمَكَ مِنَ","إِلَى ٱلنُّورِ وَذَكِّرْهُم",452],["14:13:16",257,"ٱلظَّـٰلِمِينَ","the wrongdoers","إِلَيْهِمْ رَبُّهُمْ لَنُهْلِكَنَّ","",89],["14:22:41",258,"ٱلظَّـٰلِمِينَ","the wrongdoers","مِن قَبْلُ ۗ إِنَّ","لَهُمْ عَذَابٌ أَلِيمٌۭ",89],["14:27:14",259,"ٱلظَّـٰلِمِينَ ۚ","the wrongdoers","ٱلْـَٔاخِرَةِ ۖ وَيُضِلُّ ٱللَّهُ","وَيَفْعَلُ ٱللَّهُ مَا",89],["14:34:14",260,"لَظَلُومٌۭ","(is) surely unjust","تُحْصُوهَآ ۗ إِنَّ ٱلْإِنسَـٰنَ","كَفَّارٌۭ",2318],["14:42:7",260,"ٱلظَّـٰلِمُونَ ۚ","the wrongdoers","غَـٰفِلًا عَمَّا يَعْمَلُ","إِنَّمَا يُؤَخِّرُهُمْ لِيَوْمٍۢ",89],["14:44:8",261,"ظَلَمُوا۟","did wrong","ٱلْعَذَابُ فَيَقُولُ ٱلَّذِينَ","رَبَّنَآ أَخِّرْنَآ إِلَىٰٓ",104],["14:45:5",261,"ظَلَمُوٓا۟","wronged","فِى مَسَـٰكِنِ ٱلَّذِينَ","أَنفُسَهُمْ وَتَبَيَّنَ لَكُمْ",104],["15:78:5",266,"لَظَـٰلِمِينَ","surely wrongdoers","كَانَ أَصْحَـٰبُ ٱلْأَيْكَةِ","",89],["16:28:4",270,"ظَالِمِىٓ","(while) wronging","ٱلَّذِينَ تَتَوَفَّىٰهُمُ ٱلْمَلَـٰٓئِكَةُ","أَنفُسِهِمْ ۖ فَأَلْقَوُا۟ ٱلسَّلَمَ",2315],["16:33:17",270,"ظَلَمَهُمُ","wronged them","مِن قَبْلِهِمْ ۚ وَمَا","ٱللَّهُ وَلَـٰكِن كَانُوٓا۟",104],["16:33:22",270,"يَظْلِمُونَ","wronging","وَلَـٰكِن كَانُوٓا۟ أَنفُسَهُمْ","",104],["16:41:8",271,"ظُلِمُوا۟","they were wronged","مِنۢ بَعْدِ مَا","لَنُبَوِّئَنَّهُمْ فِى ٱلدُّنْيَا",104],["16:61:5",273,"بِظُلْمِهِم","for their wrongdoing","يُؤَاخِذُ ٱللَّهُ ٱلنَّاسَ","مَّا تَرَكَ عَلَيْهَا",512],["16:85:4",276,"ظَلَمُوا۟","wronged","وَإِذَا رَءَا ٱلَّذِينَ","ٱلْعَذَابَ فَلَا يُخَفَّفُ",104],["16:111:15",280,"يُظْلَمُونَ","be wronged","عَمِلَتْ وَهُمْ لَا","",104],["16:113:9",280,"ظَـٰلِمُونَ","(were) wrongdoers","فَأَخَذَهُمُ ٱلْعَذَابُ وَهُمْ","",89],["16:118:11",280,"ظَلَمْنَـٰهُمْ","We wronged them","مِن قَبْلُ ۖ وَمَا","وَلَـٰكِن كَانُوٓا۟ أَنفُسَهُمْ",104],["16:118:15",280,"يَظْلِمُونَ","wrong","وَلَـٰكِن كَانُوٓا۟ أَنفُسَهُمْ","",104],["17:33:11",285,"مَظْلُومًۭا","wrongfully","بِٱلْحَقِّ ۗ وَمَن قُتِلَ","فَقَدْ جَعَلْنَا لِوَلِيِّهِۦ",3648],["17:47:14",286,"ٱلظَّـٰلِمُونَ","the wrongdoers","نَجْوَىٰٓ إِذْ يَقُولُ","إِن تَتَّبِعُونَ إِلَّا",89],["17:59:15",288,"فَظَلَمُوا۟","but they wronged","ثَمُودَ ٱلنَّاقَةَ مُبْصِرَةًۭ","بِهَا ۚ وَمَا نُرْسِلُ",104],["17:71:14",289,"يُظْلَمُونَ","they will be wronged","يَقْرَءُونَ كِتَـٰبَهُمْ وَلَا","فَتِيلًۭا",104],["17:82:11",290,"ٱلظَّـٰلِمِينَ","the wrongdoers","لِّلْمُؤْمِنِينَ ۙ وَلَا يَزِيدُ","إِلَّا خَسَارًۭا",89],["17:99:21",292,"ٱلظَّـٰلِمُونَ","the wrongdoers","رَيْبَ فِيهِ فَأَبَى","إِلَّا كُفُورًۭا",89],["18:15:13",294,"أَظْلَمُ","(is) more wrong","بِسُلْطَـٰنٍۭ بَيِّنٍۢ ۖ فَمَنْ","مِمَّنِ ٱفْتَرَىٰ عَلَى",585],["18:29:13",297,"لِلظَّـٰلِمِينَ","for the wrongdoers","فَلْيَكْفُرْ ۚ إِنَّآ أَعْتَدْنَا","نَارًا أَحَاطَ بِهِمْ",89],["18:33:6",297,"تَظْلِم","did wrong","ءَاتَتْ أُكُلَهَا وَلَمْ","مِّنْهُ شَيْـًۭٔا ۚ وَفَجَّرْنَا",104],["18:35:4",298,"ظَالِمٌۭ","(was) unjust","وَدَخَلَ جَنَّتَهُۥ وَهُوَ","لِّنَفْسِهِۦ قَالَ مَآ",89],["18:49:25",299,"يَظْلِمُ","deals unjustly","عَمِلُوا۟ حَاضِرًۭا ۗ وَلَا","رَبُّكَ أَحَدًۭا",104],["18:50:25",299,"لِلظَّـٰلِمِينَ","for the wrongdoers","لَكُمْ عَدُوٌّۢ ۚ بِئْسَ","بَدَلًۭا",89],["18:57:2",300,"أَظْلَمُ","(is) more wrong","وَمَنْ","مِمَّن ذُكِّرَ بِـَٔايَـٰتِ",585],["18:59:5",300,"ظَلَمُوا۟","they wronged","ٱلْقُرَىٰٓ أَهْلَكْنَـٰهُمْ لَمَّا","وَجَعَلْنَا لِمَهْلِكِهِم مَّوْعِدًۭا",104],["18:87:4",303,"ظَلَمَ","wrongs","قَالَ أَمَّا مَن","فَسَوْفَ نُعَذِّبُهُۥ ثُمَّ",104],["19:38:7",307,"ٱلظَّـٰلِمُونَ","the wrongdoers","يَوْمَ يَأْتُونَنَا ۖ لَـٰكِنِ","ٱلْيَوْمَ فِى ضَلَـٰلٍۢ",89],["19:60:11",309,"يُظْلَمُونَ","they will be wronged","يَدْخُلُونَ ٱلْجَنَّةَ وَلَا","شَيْـًۭٔا",104],["19:72:6",310,"ٱلظَّـٰلِمِينَ","the wrongdoers","ٱلَّذِينَ ٱتَّقَوا۟ وَّنَذَرُ","فِيهَا جِثِيًّۭا",89],["20:111:9",319,"ظُلْمًۭا","wrongdoing","خَابَ مَنْ حَمَلَ","",512],["20:112:9",319,"ظُلْمًۭا","injustice","مُؤْمِنٌۭ فَلَا يَخَافُ","وَلَا هَضْمًۭا",512],["21:3:6",322,"ظَلَمُوا۟","[they] wronged","وَأَسَرُّوا۟ ٱلنَّجْوَى ٱلَّذِينَ","هَلْ هَـٰذَآ إِلَّا",104],["21:11:6",323,"ظَالِمَةًۭ","unjust","مِن قَرْيَةٍۢ كَانَتْ","وَأَنشَأْنَا بَعْدَهَا قَوْمًا",1532],["21:14:5",323,"ظَـٰلِمِينَ","wrongdoers","يَـٰوَيْلَنَآ إِنَّا كُنَّا","",89],["21:29:13",324,"ٱلظَّـٰلِمِينَ","the wrongdoers","جَهَنَّمَ ۚ كَذَٰلِكَ نَجْزِى","",89],["21:46:11",326,"ظَـٰلِمِينَ","wrongdoers","يَـٰوَيْلَنَآ إِنَّا كُنَّا","",89],["21:47:7",326,"تُظْلَمُ","will be wronged","لِيَوْمِ ٱلْقِيَـٰمَةِ فَلَا","نَفْسٌۭ شَيْـًۭٔا ۖ وَإِن",104],["21:59:8",327,"ٱلظَّـٰلِمِينَ","the wrongdoers","بِـَٔالِهَتِنَآ إِنَّهُۥ لَمِنَ","",89],["21:64:7",327,"ٱلظَّـٰلِمُونَ","(are) the wrongdoers","فَقَالُوٓا۟ إِنَّكُمْ أَنتُمُ","",89],["21:87:13",329,"ٱلظُّلُمَـٰتِ","the darkness(es)","عَلَيْهِ فَنَادَىٰ فِى","أَن لَّآ إِلَـٰهَ",452],["21:87:23",329,"ٱلظَّـٰلِمِينَ","the wrongdoers","إِنِّى كُنتُ مِنَ","",89],["21:97:19",330,"ظَـٰلِمِينَ","wrongdoers","هَـٰذَا بَلْ كُنَّا","",89],["22:10:8",333,"بِظَلَّـٰمٍۢ","unjust","وَأَنَّ ٱللَّهَ لَيْسَ","لِّلْعَبِيدِ",1318],["22:25:21",335,"بِظُلْمٍۢ","(or) wrongdoing","يُرِدْ فِيهِ بِإِلْحَادٍۭ","نُّذِقْهُ مِنْ عَذَابٍ",512],["22:39:5",337,"ظُلِمُوا۟ ۚ","were wronged","لِلَّذِينَ يُقَـٰتَلُونَ بِأَنَّهُمْ","وَإِنَّ ٱللَّهَ عَلَىٰ",104],["22:45:6",337,"ظَالِمَةٌۭ","was doing wrong","قَرْيَةٍ أَهْلَكْنَـٰهَا وَهِىَ","فَهِىَ خَاوِيَةٌ عَلَىٰ",1532],["22:48:7",338,"ظَالِمَةٌۭ","(was) doing wrong","أَمْلَيْتُ لَهَا وَهِىَ","ثُمَّ أَخَذْتُهَا وَإِلَىَّ",1532],["22:53:13",338,"ٱلظَّـٰلِمِينَ","the wrongdoers","وَٱلْقَاسِيَةِ قُلُوبُهُمْ ۗ وَإِنَّ","لَفِى شِقَاقٍۭ بَعِيدٍۢ",89],["22:71:16",340,"لِلظَّـٰلِمِينَ","(will be) for the wrongdoers","بِهِۦ عِلْمٌۭ ۗ وَمَا","مِن نَّصِيرٍۢ",89],["23:27:30",343,"ظَلَمُوٓا۟ ۖ","wronged","تُخَـٰطِبْنِى فِى ٱلَّذِينَ","إِنَّهُم مُّغْرَقُونَ",104],["23:28:15",344,"ٱلظَّـٰلِمِينَ","the wrongdoers","نَجَّىٰنَا مِنَ ٱلْقَوْمِ","",89],["23:41:8",344,"ٱلظَّـٰلِمِينَ","the wrongdoers","غُثَآءًۭ ۚ فَبُعْدًۭا لِّلْقَوْمِ","",89],["23:62:12",346,"يُظْلَمُونَ","be wronged","بِٱلْحَقِّ ۚ وَهُمْ لَا","",104],["23:94:6",348,"ٱلظَّـٰلِمِينَ","the wrongdoers","تَجْعَلْنِى فِى ٱلْقَوْمِ","",89],["23:107:7",349,"ظَـٰلِمُونَ","(would be) wrongdoers","فَإِنْ عُدْنَا فَإِنَّا","",89],["24:40:2",355,"كَظُلُمَـٰتٍۢ","(is) like (the) darkness[es]","أَوْ","فِى بَحْرٍۢ لُّجِّىٍّۢ",452],["24:40:14",355,"ظُلُمَـٰتٌۢ","darkness[es]","مِّن فَوْقِهِۦ سَحَابٌۭ ۚ","بَعْضُهَا فَوْقَ بَعْضٍ",452],["24:50:16",356,"ٱلظَّـٰلِمُونَ","(are) the wrongdoers","بَلْ أُو۟لَـٰٓئِكَ هُمُ","",89],["25:4:15",360,"ظُلْمًۭا","an injustice","ءَاخَرُونَ ۖ فَقَدْ جَآءُو","وَزُورًۭا",512],["25:8:12",360,"ٱلظَّـٰلِمُونَ","the wrongdoers","يَأْكُلُ مِنْهَا ۚ وَقَالَ","إِن تَتَّبِعُونَ إِلَّا",89],["25:19:11",361,"يَظْلِم","does wrong","وَلَا نَصْرًۭا ۚ وَمَن","مِّنكُمْ نُذِقْهُ عَذَابًۭا",104],["25:27:3",362,"ٱلظَّالِمُ","the wrongdoer","وَيَوْمَ يَعَضُّ","عَلَىٰ يَدَيْهِ يَقُولُ",89],["25:37:11",363,"لِلظَّـٰلِمِينَ","for the wrongdoers","لِلنَّاسِ ءَايَةًۭ ۖ وَأَعْتَدْنَا","عَذَابًا أَلِيمًۭا",89],["26:10:8",367,"ٱلظَّـٰلِمِينَ","(who are) wrongdoers","أَنِ ٱئْتِ ٱلْقَوْمَ","",89],["26:209:4",376,"ظَـٰلِمِينَ","unjust","ذِكْرَىٰ وَمَا كُنَّا","",89],["26:227:13",376,"ظُلِمُوا۟ ۗ","they were wronged","مِنۢ بَعْدِ مَا","وَسَيَعْلَمُ ٱلَّذِينَ ظَلَمُوٓا۟",104],["26:227:16",376,"ظَلَمُوٓا۟","have wronged","ظُلِمُوا۟ ۗ وَسَيَعْلَمُ ٱلَّذِينَ","أَىَّ مُنقَلَبٍۢ يَنقَلِبُونَ",104],["27:11:3",377,"ظَلَمَ","wrongs","إِلَّا مَن","ثُمَّ بَدَّلَ حُسْنًۢا",104],["27:14:5",378,"ظُلْمًۭا","(out of) injustice","بِهَا وَٱسْتَيْقَنَتْهَآ أَنفُسُهُمْ","وَعُلُوًّۭا ۚ فَٱنظُرْ كَيْفَ",512],["27:44:21",380,"ظَلَمْتُ","[I] have wronged","قَالَتْ رَبِّ إِنِّى","نَفْسِى وَأَسْلَمْتُ مَعَ",104],["27:52:5",381,"ظَلَمُوٓا۟ ۗ","they wronged","بُيُوتُهُمْ خَاوِيَةًۢ بِمَا","إِنَّ فِى ذَٰلِكَ",104],["27:63:4",382,"ظُلُمَـٰتِ","(the) darkness[es]","أَمَّن يَهْدِيكُمْ فِى","ٱلْبَرِّ وَٱلْبَحْرِ وَمَن",452],["27:85:5",384,"ظَلَمُوا۟","they wronged","ٱلْقَوْلُ عَلَيْهِم بِمَا","فَهُمْ لَا يَنطِقُونَ",104],["28:16:4",387,"ظَلَمْتُ","[I] have wronged","قَالَ رَبِّ إِنِّى","نَفْسِى فَٱغْفِرْ لِى",104],["28:21:10",387,"ٱلظَّـٰلِمِينَ","the wrongdoers","نَجِّنِى مِنَ ٱلْقَوْمِ","",89],["28:25:26",388,"ٱلظَّـٰلِمِينَ","the wrongdoers","نَجَوْتَ مِنَ ٱلْقَوْمِ","",89],["28:37:18",390,"ٱلظَّـٰلِمُونَ","the wrongdoers","إِنَّهُۥ لَا يُفْلِحُ","",89],["28:40:10",390,"ٱلظَّـٰلِمِينَ","(of) the wrongdoers","كَيْفَ كَانَ عَـٰقِبَةُ","",89],["28:50:23",391,"ٱلظَّـٰلِمِينَ","the wrongdoers","لَا يَهْدِى ٱلْقَوْمَ","",89],["28:59:20",392,"ظَـٰلِمُونَ","(were) wrongdoers","ٱلْقُرَىٰٓ إِلَّا وَأَهْلُهَا","",89],["29:14:16",397,"ظَـٰلِمُونَ","(were) wrongdoers","فَأَخَذَهُمُ ٱلطُّوفَانُ وَهُمْ","",89],["29:31:15",400,"ظَـٰلِمِينَ","wrongdoers","إِنَّ أَهْلَهَا كَانُوا۟","",89],["29:40:24",401,"لِيَظْلِمَهُمْ","to wrong them","وَمَا كَانَ ٱللَّهُ","وَلَـٰكِن كَانُوٓا۟ أَنفُسَهُمْ",104],["29:40:28",401,"يَظْلِمُونَ","doing wrong","وَلَـٰكِن كَانُوٓا۟ أَنفُسَهُمْ","",104],["29:46:11",402,"ظَلَمُوا۟","(do) wrong","أَحْسَنُ إِلَّا ٱلَّذِينَ","مِنْهُمْ ۖ وَقُولُوٓا۟ ءَامَنَّا",104],["29:49:14",402,"ٱلظَّـٰلِمُونَ","the wrongdoers","يَجْحَدُ بِـَٔايَـٰتِنَآ إِلَّا","",89],["29:68:2",404,"أَظْلَمُ","(is) more unjust","وَمَنْ","مِمَّنِ ٱفْتَرَىٰ عَلَى",585],["30:9:28",405,"لِيَظْلِمَهُمْ","to wrong them","فَمَا كَانَ ٱللَّهُ","وَلَـٰكِن كَانُوٓا۟ أَنفُسَهُمْ",104],["30:9:32",405,"يَظْلِمُونَ","(doing) wrong","وَلَـٰكِن كَانُوٓا۟ أَنفُسَهُمْ","",104],["30:29:4",407,"ظَلَمُوٓا۟","do wrong","بَلِ ٱتَّبَعَ ٱلَّذِينَ","أَهْوَآءَهُم بِغَيْرِ عِلْمٍۢ ۖ",104],["30:57:5",410,"ظَلَمُوا۟","wronged","لَّا يَنفَعُ ٱلَّذِينَ","مَعْذِرَتُهُمْ وَلَا هُمْ",104],["31:11:11",411,"ٱلظَّـٰلِمُونَ","the wrongdoers","مِن دُونِهِۦ ۚ بَلِ","فِى ضَلَـٰلٍۢ مُّبِينٍۢ",89],["31:13:13",412,"لَظُلْمٌ","(is) surely an injustice","بِٱللَّهِ ۖ إِنَّ ٱلشِّرْكَ","عَظِيمٌۭ",512],["32:22:2",417,"أَظْلَمُ","(is) more unjust","وَمَنْ","مِمَّن ذُكِّرَ بِـَٔايَـٰتِ",585],["33:43:8",423,"ٱلظُّلُمَـٰتِ","the darkness[es]","وَمَلَـٰٓئِكَتُهُۥ لِيُخْرِجَكُم مِّنَ","إِلَى ٱلنُّورِ ۚ وَكَانَ",452],["33:72:17",427,"ظَلُومًۭا","unjust","ٱلْإِنسَـٰنُ ۖ إِنَّهُۥ كَانَ","جَهُولًۭا",2318],["34:19:6",430,"وَظَلَمُوٓا۟","And they wronged","بَـٰعِدْ بَيْنَ أَسْفَارِنَا","أَنفُسَهُمْ فَجَعَلْنَـٰهُمْ أَحَادِيثَ",104],["34:31:15",431,"ٱلظَّـٰلِمُونَ","the wrongdoers","وَلَوْ تَرَىٰٓ إِذِ","مَوْقُوفُونَ عِندَ رَبِّهِمْ",89],["34:42:11",433,"ظَلَمُوا۟","who wronged","ضَرًّۭا وَنَقُولُ لِلَّذِينَ","ذُوقُوا۟ عَذَابَ ٱلنَّارِ",104],["35:20:2",437,"ٱلظُّلُمَـٰتُ","the darkness[es]","وَلَا","وَلَا ٱلنُّورُ",452],["35:32:9",438,"ظَالِمٌۭ","(is he) who wrongs","مِنْ عِبَادِنَا ۖ فَمِنْهُمْ","لِّنَفْسِهِۦ وَمِنْهُم مُّقْتَصِدٌۭ",89],["35:37:23",438,"لِلظَّـٰلِمِينَ","(is) for the wrongdoers","ٱلنَّذِيرُ ۖ فَذُوقُوا۟ فَمَا","مِن نَّصِيرٍ",89],["35:40:29",439,"ٱلظَّـٰلِمُونَ","the wrongdoers","بَلْ إِن يَعِدُ","بَعْضُهُم بَعْضًا إِلَّا",89],["36:37:9",442,"مُّظْلِمُونَ","(are) those in darkness","ٱلنَّهَارَ فَإِذَا هُم","",2488],["36:54:3",443,"تُظْلَمُ","will be wronged","فَٱلْيَوْمَ لَا","نَفْسٌۭ شَيْـًۭٔا وَلَا",104],["37:22:3",446,"ظَلَمُوا۟","wronged","۞ ٱحْشُرُوا۟ ٱلَّذِينَ","وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟",104],["37:63:4",448,"لِّلظَّـٰلِمِينَ","for the wrongdoers","إِنَّا جَعَلْنَـٰهَا فِتْنَةًۭ","",89],["37:113:8",450,"وَظَالِمٌۭ","and unjust","وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌۭ","لِّنَفْسِهِۦ مُبِينٌۭ",89],["38:24:3",454,"ظَلَمَكَ","he has wronged you","قَالَ لَقَدْ","بِسُؤَالِ نَعْجَتِكَ إِلَىٰ",104],["39:6:24",459,"ظُلُمَـٰتٍۢ","darkness[es]","بَعْدِ خَلْقٍۢ فِى","ثَلَـٰثٍۢ ۚ ذَٰلِكُمُ ٱللَّهُ",452],["39:24:9",461,"لِلظَّـٰلِمِينَ","to the wrongdoers","يَوْمَ ٱلْقِيَـٰمَةِ ۚ وَقِيلَ","ذُوقُوا۟ مَا كُنتُمْ",89],["39:32:2",462,"أَظْلَمُ","(is) more unjust","۞ فَمَنْ","مِمَّن كَذَبَ عَلَى",585],["39:47:4",463,"ظَلَمُوا۟","did wrong","وَلَوْ أَنَّ لِلَّذِينَ","مَا فِى ٱلْأَرْضِ",104],["39:51:6",464,"ظَلَمُوا۟","have wronged","مَا كَسَبُوا۟ ۚ وَٱلَّذِينَ","مِنْ هَـٰٓؤُلَآءِ سَيُصِيبُهُمْ",104],["39:69:15",466,"يُظْلَمُونَ","will not be wronged","بِٱلْحَقِّ وَهُمْ لَا","",104],["40:17:8",469,"ظُلْمَ","injustice","بِمَا كَسَبَتْ ۚ لَا","ٱلْيَوْمَ ۚ إِنَّ ٱللَّهَ",512],["40:18:10",469,"لِلظَّـٰلِمِينَ","for the wrongdoers","ٱلْحَنَاجِرِ كَـٰظِمِينَ ۚ مَا","مِنْ حَمِيمٍۢ وَلَا",89],["40:31:13",470,"ظُلْمًۭا","injustice","وَمَا ٱللَّهُ يُرِيدُ","لِّلْعِبَادِ",512],["40:52:4",473,"ٱلظَّـٰلِمِينَ","the wrongdoers","يَوْمَ لَا يَنفَعُ","مَعْذِرَتُهُمْ ۖ وَلَهُمُ ٱللَّعْنَةُ",89],["41:46:10",481,"بِظَلَّـٰمٍۢ","unjust","فَعَلَيْهَا ۗ وَمَا رَبُّكَ","لِّلْعَبِيدِ",1318],["42:8:13",483,"وَٱلظَّـٰلِمُونَ","And the wrongdoers","يَشَآءُ فِى رَحْمَتِهِۦ ۚ","مَا لَهُم مِّن",89],["42:21:19",485,"ٱلظَّـٰلِمِينَ","the wrongdoers","لَقُضِىَ بَيْنَهُمْ ۗ وَإِنَّ","لَهُمْ عَذَابٌ أَلِيمٌۭ",89],["42:22:2",485,"ٱلظَّـٰلِمِينَ","the wrongdoers","تَرَى","مُشْفِقِينَ مِمَّا كَسَبُوا۟",89],["42:40:14",487,"ٱلظَّـٰلِمِينَ","the wrongdoers","إِنَّهُۥ لَا يُحِبُّ","",89],["42:41:4",487,"ظُلْمِهِۦ","he has been wronged","وَلَمَنِ ٱنتَصَرَ بَعْدَ","فَأُو۟لَـٰٓئِكَ مَا عَلَيْهِم",512],["42:42:5",487,"يَظْلِمُونَ","oppress","ٱلسَّبِيلُ عَلَى ٱلَّذِينَ","ٱلنَّاسَ وَيَبْغُونَ فِى",104],["42:44:11",487,"ٱلظَّـٰلِمِينَ","the wrongdoers","مِّنۢ بَعْدِهِۦ ۗ وَتَرَى","لَمَّا رَأَوُا۟ ٱلْعَذَابَ",89],["42:45:24",488,"ٱلظَّـٰلِمِينَ","the wrongdoers","ٱلْقِيَـٰمَةِ ۗ أَلَآ إِنَّ","فِى عَذَابٍۢ مُّقِيمٍۢ",89],["43:39:5",492,"ظَّلَمْتُمْ","you have wronged","يَنفَعَكُمُ ٱلْيَوْمَ إِذ","أَنَّكُمْ فِى ٱلْعَذَابِ",104],["43:65:7",494,"ظَلَمُوا۟","wronged","بَيْنِهِمْ ۖ فَوَيْلٌۭ لِّلَّذِينَ","مِنْ عَذَابِ يَوْمٍ",104],["43:76:2",495,"ظَلَمْنَـٰهُمْ","We wronged them","وَمَا","وَلَـٰكِن كَانُوا۟ هُمُ",104],["43:76:6",495,"ٱلظَّـٰلِمِينَ","wrongdoers","وَلَـٰكِن كَانُوا۟ هُمُ","",89],["45:19:9",500,"ٱلظَّـٰلِمِينَ","the wrongdoers","ٱللَّهِ شَيْـًۭٔا ۚ وَإِنَّ","بَعْضُهُمْ أَوْلِيَآءُ بَعْضٍۢ ۖ",89],["45:22:13",500,"يُظْلَمُونَ","will not be wronged","كَسَبَتْ وَهُمْ لَا","",104],["46:10:24",503,"ٱلظَّـٰلِمِينَ","the wrongdoers","لَا يَهْدِى ٱلْقَوْمَ","",89],["46:12:14",503,"ظَلَمُوا۟","do wrong","عَرَبِيًّۭا لِّيُنذِرَ ٱلَّذِينَ","وَبُشْرَىٰ لِلْمُحْسِنِينَ",104],["46:19:9",504,"يُظْلَمُونَ","will not be wronged","أَعْمَـٰلَهُمْ وَهُمْ لَا","",104],["49:11:39",516,"ٱلظَّـٰلِمُونَ","(are) the wrongdoers","يَتُبْ فَأُو۟لَـٰٓئِكَ هُمُ","",89],["50:29:7",519,"بِظَلَّـٰمٍۢ","unjust","لَدَىَّ وَمَآ أَنَا۠","لِّلْعَبِيدِ",1318],["51:59:3",523,"ظَلَمُوا۟","do wrong","فَإِنَّ لِلَّذِينَ","ذَنُوبًۭا مِّثْلَ ذَنُوبِ",104],["52:47:3",525,"ظَلَمُوا۟","do wrong","وَإِنَّ لِلَّذِينَ","عَذَابًۭا دُونَ ذَٰلِكَ",104],["53:52:8",528,"أَظْلَمَ","more unjust","إِنَّهُمْ كَانُوا۟ هُمْ","وَأَطْغَىٰ",585],["57:9:10",538,"ٱلظُّلُمَـٰتِ","the darkness[es]","بَيِّنَـٰتٍۢ لِّيُخْرِجَكُم مِّنَ","إِلَى ٱلنُّورِ ۚ وَإِنَّ",452],["59:17:10",548,"ٱلظَّـٰلِمِينَ","(of) the wrongdoers","فِيهَا ۚ وَذَٰلِكَ جَزَٰٓؤُا۟","",89],["60:9:21",550,"ٱلظَّـٰلِمُونَ","(are) the wrongdoers","يَتَوَلَّهُمْ فَأُو۟لَـٰٓئِكَ هُمُ","",89],["61:7:2",552,"أَظْلَمُ","(is) more wrong","وَمَنْ","مِمَّنِ ٱفْتَرَىٰ عَلَى",585],["61:7:16",552,"ٱلظَّـٰلِمِينَ","[the] wrongdoers","لَا يَهْدِى ٱلْقَوْمَ","",89],["62:5:23",553,"ٱلظَّـٰلِمِينَ","the wrongdoers","لَا يَهْدِى ٱلْقَوْمَ","",89],["62:7:9",553,"بِٱلظَّـٰلِمِينَ","of the wrongdoers","أَيْدِيهِمْ ۚ وَٱللَّهُ عَلِيمٌۢ","",89],["65:1:32",558,"ظَلَمَ","he has wronged","حُدُودَ ٱللَّهِ فَقَدْ","نَفْسَهُۥ ۚ لَا تَدْرِى",104],["65:11:13",559,"ٱلظُّلُمَـٰتِ","the darkness[es]","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ مِنَ","إِلَى ٱلنُّورِ ۚ وَمَن",452],["66:11:24",561,"ٱلظَّـٰلِمِينَ","the wrongdoers","وَنَجِّنِى مِنَ ٱلْقَوْمِ","",89],["68:29:6",565,"ظَـٰلِمِينَ","wrongdoers","رَبِّنَآ إِنَّا كُنَّا","",89],["71:24:6",571,"ٱلظَّـٰلِمِينَ","the wrongdoers","كَثِيرًۭا ۖ وَلَا تَزِدِ","إِلَّا ضَلَـٰلًۭا",89],["71:28:13",571,"ٱلظَّـٰلِمِينَ","the wrongdoers","وَٱلْمُؤْمِنَـٰتِ وَلَا تَزِدِ","إِلَّا تَبَارًۢا",89],["76:31:6",580,"وَٱلظَّـٰلِمِينَ","but (for) the wrongdoers","يَشَآءُ فِى رَحْمَتِهِۦ ۚ","أَعَدَّ لَهُمْ عَذَابًا",89]]