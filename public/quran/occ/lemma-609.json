[["2:132:5",20,"وَيَعْقُوبُ","and Yaqub","بِهَآ إِبْرَٰهِـۧمُ بَنِيهِ","يَـٰبَنِىَّ إِنَّ ٱللَّهَ",609],["2:133:6",20,"يَعْقُوبَ","Yaqub","شُهَدَآءَ إِذْ حَضَرَ","ٱلْمَوْتُ إِذْ قَالَ",609],["2:136:13",21,"وَيَعْقُوبَ","and Yaqub","إِبْرَٰهِـۧمَ وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ","وَٱلْأَسْبَاطِ وَمَآ أُوتِىَ",609],["2:140:7",21,"وَيَعْقُوبَ","and Yaqub","إِبْرَٰهِـۧمَ وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ","وَٱلْأَسْبَاطَ كَانُوا۟ هُودًا",609],["3:84:13",61,"وَيَعْقُوبَ","and Yaqub","إِبْرَٰهِيمَ وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ","وَٱلْأَسْبَاطِ وَمَآ أُوتِىَ",609],["4:163:16",104,"وَيَعْقُوبَ","and Yaqub","إِبْرَٰهِيمَ وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ","وَٱلْأَسْبَاطِ وَعِيسَىٰ وَأَيُّوبَ",609],["6:84:4",138,"وَيَعْقُوبَ ۚ","and Yaqub","وَوَهَبْنَا لَهُۥٓ إِسْحَـٰقَ","كُلًّا هَدَيْنَا ۚ وَنُوحًا",609],["11:71:9",229,"يَعْقُوبَ","(of) Yaqub","وَمِن وَرَآءِ إِسْحَـٰقَ","",609],["12:6:13",236,"يَعْقُوبَ","(of) Yaqub","عَلَيْكَ وَعَلَىٰٓ ءَالِ","كَمَآ أَتَمَّهَا عَلَىٰٓ",609],["12:38:6",240,"وَيَعْقُوبَ ۚ","and Yaqub","ءَابَآءِىٓ إِبْرَٰهِيمَ وَإِسْحَـٰقَ","مَا كَانَ لَنَآ",609],["12:68:19",243,"يَعْقُوبَ","Yaqub's soul","حَاجَةًۭ فِى نَفْسِ","قَضَىٰهَا ۚ وَإِنَّهُۥ لَذُو",609],["19:6:5",305,"يَعْقُوبَ ۖ","(of) Yaqub","وَيَرِثُ مِنْ ءَالِ","وَٱجْعَلْهُ رَبِّ رَضِيًّۭا",609],["19:49:11",308,"وَيَعْقُوبَ ۖ","and Yaqub","وَهَبْنَا لَهُۥٓ إِسْحَـٰقَ","وَكُلًّۭا جَعَلْنَا نَبِيًّۭا",609],["21:72:4",327,"وَيَعْقُوبَ","and Yaqub","وَوَهَبْنَا لَهُۥٓ إِسْحَـٰقَ","نَافِلَةًۭ ۖ وَكُلًّۭا جَعَلْنَا",609],["29:27:4",399,"وَيَعْقُوبَ","and Yaqub","وَوَهَبْنَا لَهُۥٓ إِسْحَـٰقَ","وَجَعَلْنَا فِى ذُرِّيَّتِهِ",609],["38:45:5",456,"وَيَعْقُوبَ","and Ayyub","عِبَـٰدَنَآ إِبْرَٰهِيمَ وَإِسْحَـٰقَ","أُو۟لِى ٱلْأَيْدِى وَٱلْأَبْصَـٰرِ",609]]