[["2:64:2",10,"تَوَلَّيْتُم","you turned away","ثُمَّ","مِّنۢ بَعْدِ ذَٰلِكَ ۖ",145],["2:83:24",12,"تَوَلَّيْتُمْ","you turned away","وَءَاتُوا۟ ٱلزَّكَوٰةَ ثُمَّ","إِلَّا قَلِيلًۭا مِّنكُمْ",145],["2:107:15",17,"وَلِىٍّۢ","protector","دُونِ ٱللَّهِ مِن","وَلَا نَصِيرٍ",127],["2:115:5",18,"تُوَلُّوا۟","you turn","ٱلْمَشْرِقُ وَٱلْمَغْرِبُ ۚ فَأَيْنَمَا","فَثَمَّ وَجْهُ ٱللَّهِ ۚ",369],["2:120:29",19,"وَلِىٍّۢ","protector","مِنَ ٱللَّهِ مِن","وَلَا نَصِيرٍ",127],["2:137:10",21,"تَوَلَّوْا۟","they turn away","فَقَدِ ٱهْتَدَوا۟ ۖ وَّإِن","فَإِنَّمَا هُمْ فِى",145],["2:142:6",22,"وَلَّىٰهُمْ","(has) turned them","مِنَ ٱلنَّاسِ مَا","عَن قِبْلَتِهِمُ ٱلَّتِى",369],["2:144:7",22,"فَلَنُوَلِّيَنَّكَ","So We will surely turn you","وَجْهِكَ فِى ٱلسَّمَآءِ ۖ","قِبْلَةًۭ تَرْضَىٰهَا ۚ فَوَلِّ",369],["2:144:10",22,"فَوَلِّ","So turn","فَلَنُوَلِّيَنَّكَ قِبْلَةًۭ تَرْضَىٰهَا ۚ","وَجْهَكَ شَطْرَ ٱلْمَسْجِدِ",369],["2:144:18",22,"فَوَلُّوا۟","[so] turn","وَحَيْثُ مَا كُنتُمْ","وُجُوهَكُمْ شَطْرَهُۥ ۗ وَإِنَّ",369],["2:148:4",23,"مُوَلِّيهَا ۖ","turns towards it","وَلِكُلٍّۢ وِجْهَةٌ هُوَ","فَٱسْتَبِقُوا۟ ٱلْخَيْرَٰتِ ۚ أَيْنَ",3886],["2:149:4",23,"فَوَلِّ","[so] turn","وَمِنْ حَيْثُ خَرَجْتَ","وَجْهَكَ شَطْرَ ٱلْمَسْجِدِ",369],["2:150:4",23,"فَوَلِّ","[so] turn","وَمِنْ حَيْثُ خَرَجْتَ","وَجْهَكَ شَطْرَ ٱلْمَسْجِدِ",369],["2:150:12",23,"فَوَلُّوا۟","[so] turn","وَحَيْثُ مَا كُنتُمْ","وُجُوهَكُمْ شَطْرَهُۥ لِئَلَّا",369],["2:177:4",27,"تُوَلُّوا۟","you turn","۞ لَّيْسَ ٱلْبِرَّ أَن","وُجُوهَكُمْ قِبَلَ ٱلْمَشْرِقِ",369],["2:205:2",32,"تَوَلَّىٰ","he turns away","وَإِذَا","سَعَىٰ فِى ٱلْأَرْضِ",145],["2:246:48",40,"تَوَلَّوْا۟","they turned away","كُتِبَ عَلَيْهِمُ ٱلْقِتَالُ","إِلَّا قَلِيلًۭا مِّنْهُمْ ۗ",145],["2:257:2",43,"وَلِىُّ","(is the) Protecting Guardian","ٱللَّهُ","ٱلَّذِينَ ءَامَنُوا۟ يُخْرِجُهُم",127],["2:257:12",43,"أَوْلِيَآؤُهُمُ","their guardians","ٱلنُّورِ ۖ وَٱلَّذِينَ كَفَرُوٓا۟","ٱلطَّـٰغُوتُ يُخْرِجُونَهُم مِّنَ",127],["2:282:50",48,"وَلِيُّهُۥ","his guardi