َ","(the) friends","سَبِيلِ ٱلطَّـٰغُوتِ فَقَـٰتِلُوٓا۟","ٱلشَّيْطَـٰنِ ۖ إِنَّ كَيْدَ",127],["4:80:8",91,"تَوَلَّىٰ","turns away","أَطَاعَ ٱللَّهَ ۖ وَمَن","فَمَآ أَرْسَلْنَـٰكَ عَلَيْهِمْ",145],["4:89:11",92,"أَوْلِيَآءَ","allies","فَلَا تَتَّخِذُوا۟ مِنْهُمْ","حَتَّىٰ يُهَاجِرُوا۟ فِى",127],["4:89:18",92,"تَوَلَّوْا۟","they turn back","سَبِيلِ ٱللَّهِ ۚ فَإِن","فَخُذُوهُمْ وَٱقْتُلُوهُمْ حَيْثُ",145],["4:89:26",92,"وَلِيًّۭا","any ally","وَلَا تَتَّخِذُوا۟ مِنْهُمْ","وَلَا نَصِيرًا",127],["4:115:14",97,"نُوَلِّهِۦ","We will turn him","غَيْرَ سَبِيلِ ٱلْمُؤْمِنِينَ","مَا تَوَلَّىٰ وَنُصْلِهِۦ",369],["4:115:16",97,"تَوَلَّىٰ","he (has) turned","ٱلْمُؤْمِنِينَ نُوَلِّهِۦ مَا","وَنُصْلِهِۦ جَهَنَّمَ ۖ وَسَآءَتْ",145],["4:119:14",97,"وَلِيًّۭا","(as) a friend","وَمَن يَتَّخِذِ ٱلشَّيْطَـٰنَ","مِّن دُونِ ٱللَّهِ",127],["4:123:18",98,"وَلِيًّۭا","any protector","مِن دُونِ ٱللَّهِ","وَلَا نَصِيرًۭا",127],["4:135:21",100,"أَوْلَىٰ","(is) nearer","أَوْ فَقِيرًۭا فَٱللَّهُ","بِهِمَا ۖ فَلَا تَتَّبِعُوا۟",764],["4:139:4",100,"أَوْلِيَآءَ","(as) allies","ٱلَّذِينَ يَتَّخِذُونَ ٱلْكَـٰفِرِينَ","مِن دُونِ ٱلْمُؤْمِنِينَ ۚ",127],["4:144:7",101,"أَوْلِيَآءَ","(as) allies","لَا تَتَّخِذُوا۟ ٱلْكَـٰفِرِينَ","مِن دُونِ ٱلْمُؤْمِنِينَ ۚ",127],["4:173:24",105,"وَلِيًّۭا","any protector","مِّن دُونِ ٱللَّهِ","وَلَا نَصِيرًۭا",127],["5:43:9",115,"يَتَوَلَّوْنَ","they turn away","حُكْمُ ٱللَّهِ ثُمَّ","مِنۢ بَعْدِ ذَٰلِكَ ۚ",145],["5:49:20",116,"تَوَلَّوْا۟","they turn away","ٱللَّهُ إِلَيْكَ ۖ فَإِن","فَٱعْلَمْ أَنَّمَا يُرِيدُ",145],["5:51:8",117,"أَوْلِيَآءَ ۘ","(as) allies","تَتَّخِذُوا۟ ٱلْيَهُودَ وَٱلنَّصَـٰرَىٰٓ","بَعْضُهُمْ أَوْلِيَآءُ بَعْضٍۢ ۚ",127],["5:51:10",117,"أَوْلِيَآءُ","(are) allies","وَٱلنَّصَـٰرَىٰٓ أَوْلِيَآءَ ۘ بَعْضُهُمْ","بَعْضٍۢ ۚ وَمَن يَتَوَلَّهُم",127],["5:51:13",117,"يَتَوَلَّهُم","takes them as allies","أَوْلِيَآءُ بَعْضٍۢ ۚ وَمَن","مِّنكُمْ فَإِنَّهُۥ مِنْهُمْ ۗ",145],["5:55:2",117,"وَلِيُّكُمُ","your ally","إِنَّمَا","ٱللَّهُ وَرَسُولُهُۥ وَٱلَّذِينَ",127],["5:56:2",117,"يَتَوَلَّ","takes as an ally","وَمَن","ٱللَّهَ وَرَسُولَهُۥ وَٱلَّذِينَ",145],["5:57:18",117,"أَوْلِيَآءَ ۚ","(as) allies","مِن قَبْلِكُمْ وَٱلْكُفَّارَ","وَٱتَّقُوا۟ ٱللَّهَ إِن",127],["5:80:4",121,"يَتَوَلَّوْنَ","taking as allies","تَرَىٰ كَثِيرًۭا مِّنْهُمْ","ٱلَّذِينَ كَفَرُوا۟ ۚ لَبِئْسَ",145],["5:81:11",121,"أَوْلِيَآءَ","(as) allies","إِلَيْهِ مَا ٱتَّخَذُوهُمْ","وَلَـٰكِنَّ كَثِيرًۭا مِّنْهُمْ",127],["5:92:7",123,"تَوَلَّيْتُمْ","you turn away","ٱلرَّسُولَ وَٱحْذَرُوا۟ ۚ فَإِن","فَٱعْلَمُوٓا۟ أَنَّمَا عَلَىٰ",145],["5:107:14",125,"ٱلْأَوْلَيَـٰنِ","the former two","ٱلَّذِينَ ٱسْتَحَقَّ عَلَيْهِمُ","فَيُقْسِمَانِ بِٱللَّهِ لَشَهَـٰدَتُنَآ",3051],["6:14:5",129,"وَلِيًّۭا","(as) a protector","أَغَيْرَ ٱللَّهِ أَتَّخِذُ","فَاطِرِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ",127],["6:51:13",133,"وَلِىٌّۭ","any protector","لَهُم مِّن دُونِهِۦ","وَلَا شَفِيعٌۭ لَّعَلَّهُمْ",127],["6:62:5",135,"مَوْلَىٰهُمُ","their Protector","رُدُّوٓا۟ إِلَى ٱللَّهِ","ٱلْحَقِّ ۚ أَلَا لَهُ",551],["6:70:22",136,"وَلِىٌّۭ","any protector","مِن دُونِ ٱللَّهِ","وَلَا شَفِيعٌۭ وَإِن",127],["6:121:15",143,"أَوْلِيَآئِهِمْ","their friends","ٱلشَّيَـٰطِينَ لَيُوحُونَ إِلَىٰٓ","لِيُجَـٰدِلُوكُمْ ۖ وَإِنْ أَطَعْتُمُوهُمْ",127],["6:127:7",144,"وَلِيُّهُم","(will be) their protecting friend","عِندَ رَبِّهِمْ ۖ وَهُوَ","بِمَا كَانُوا۟ يَعْمَلُونَ",127],["6:128:11",144,"أَوْلِيَآؤُهُم","their friends","مِّنَ ٱلْإِنسِ ۖ وَقَالَ","مِّنَ ٱلْإِنسِ رَبَّنَا",127],["6:129:2",144,"نُوَلِّى","We make friends","وَكَذَٰلِكَ","بَعْضَ ٱلظَّـٰلِمِينَ بَعْضًۢا",369],["7:3:11",151,"أَوْلِيَآءَ ۗ","any allies","تَتَّبِعُوا۟ مِن دُونِهِۦٓ","قَلِيلًۭا مَّا تَذَكَّرُونَ",127],["7:27:27",153,"أَوْلِيَآءَ","friends","إِنَّا جَعَلْنَا ٱلشَّيَـٰطِينَ","لِلَّذِينَ لَا يُؤْمِنُونَ",127],["7:30:10",153,"أَوْلِيَآءَ","(as) allies","إِنَّهُمُ ٱتَّخَذُوا۟ ٱلشَّيَـٰطِينَ","مِن دُونِ ٱللَّهِ",127],["7:79:1",160,"فَتَوَلَّىٰ","So he turned away","","عَنْهُمْ وَقَالَ يَـٰقَوْمِ",145],["7:93:1",162,"فَتَوَلَّىٰ","So he turned away","","عَنْهُمْ وَقَالَ يَـٰقَوْمِ",145],["7:155:35",169,"وَلِيُّنَا","(are) our Protector","مَن تَشَآءُ ۖ أَنتَ","فَٱغْفِرْ لَنَا وَٱرْحَمْنَا ۖ",127],["7:196:2",176,"وَلِـِّۧىَ","my protector","إِنَّ","ٱللَّهُ ٱلَّذِى نَزَّلَ",127],["7:196:8",176,"يَتَوَلَّى","protects","نَزَّلَ ٱلْكِتَـٰبَ ۖ وَهُوَ","ٱلصَّـٰلِحِينَ",145],["8:15:10",178,"تُوَلُّوهُمُ","turn to them","كَفَرُوا۟ زَحْفًۭا فَلَا","ٱلْأَدْبَارَ",369],["8:16:2",178,"يُوَلِّهِمْ","turns to them","وَمَن","يَوْمَئِذٍۢ دُبُرَهُۥٓ إِلَّا",369],["8:20:8",179,"تَوَلَّوْا۟","turn away","ٱللَّهَ وَرَسُولَهُۥ وَلَا","عَنْهُ وَأَنتُمْ تَسْمَعُونَ",145],["8:23:9",179,"لَتَوَلَّوا۟","surely they would have turned away","لَّأَسْمَعَهُمْ ۖ وَلَوْ أَسْمَعَهُمْ","وَّهُم مُّعْرِضُونَ",145],["8:34:13",181,"أَوْلِيَآءَهُۥٓ ۚ","its guardians","ٱلْحَرَامِ وَمَا كَانُوٓا۟","إِنْ أَوْلِيَآؤُهُۥٓ إِلَّا",127],["8:34:15",181,"أَوْلِيَآؤُهُۥٓ","its guardians","كَانُوٓا۟ أَوْلِيَآءَهُۥٓ ۚ إِنْ","إِلَّا ٱلْمُتَّقُونَ وَلَـٰكِنَّ",127],["8:40:2",181,"تَوَلَّوْا۟","they turn away","وَإِن","فَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ",145],["8:40:6",181,"مَوْلَىٰكُمْ ۚ","(is) your Protector","فَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","نِعْمَ ٱلْمَوْلَىٰ وَنِعْمَ",551],["8:40:8",181,"ٱلْمَوْلَىٰ","(is) the Protector","ٱللَّهَ مَوْلَىٰكُمْ ۚ نِعْمَ","وَنِعْمَ ٱلنَّصِيرُ",551],["8:72:16",186,"أَوْلِيَآءُ","(are) allies","وَّنَصَرُوٓا۟ أُو۟لَـٰٓئِكَ بَعْضُهُمْ","بَعْضٍۢ ۚ وَٱلَّذِينَ ءَامَنُوا۟",127],["8:72:25",186,"وَلَـٰيَتِهِم","their protection","مَا لَكُم مِّن","مِّن شَىْءٍ حَتَّىٰ",2713],["8:73:4",186,"أَوْلِيَآءُ","(are) allies","وَٱلَّذِينَ كَفَرُوا۟ بَعْضُهُمْ","بَعْضٍ ۚ إِلَّا تَفْعَلُوهُ",127],["8:75:13",186,"أَوْلَىٰ","(are) nearer","وَأُو۟لُوا۟ ٱلْأَرْحَامِ بَعْضُهُمْ","بِبَعْضٍۢ فِى كِتَـٰبِ",764],["9:3:22",187,"تَوَلَّيْتُمْ","you turn away","خَيْرٌۭ لَّكُمْ ۖ وَإِن","فَٱعْلَمُوٓا۟ أَنَّكُمْ غَيْرُ",145],["9:23:8",190,"أَوْلِيَآءَ","(as) allies","تَتَّخِذُوٓا۟ ءَابَآءَكُمْ وَإِخْوَٰنَكُمْ","إِنِ ٱسْتَحَبُّوا۟ ٱلْكُفْرَ",127],["9:23:15",190,"يَتَوَلَّهُم","takes them as allies","عَلَى ٱلْإِيمَـٰنِ ۚ وَمَن","مِّنكُمْ فَأُو۟لَـٰٓئِكَ هُمُ",145],["9:25:22",190,"وَلَّيْتُم","you turned back","بِمَا رَحُبَتْ ثُمَّ","مُّدْبِرِينَ",369],["9:50:14",195,"وَيَتَوَلَّوا۟","And they turn away","أَمْرَنَا مِن قَبْلُ","وَّهُمْ فَرِحُونَ",145],["9:51:10",195,"مَوْلَىٰنَا ۚ","(is) our Protector","ٱللَّهُ لَنَا هُوَ","وَعَلَى ٱللَّهِ فَلْيَتَوَكَّلِ",551],["9:57:8",196,"لَّوَلَّوْا۟","surely, they would turn","مَغَـٰرَٰتٍ أَوْ مُدَّخَلًۭا","إِلَيْهِ وَهُمْ يَجْمَحُونَ",369],["9:71:4",198,"أَوْلِيَآءُ","(are) allies","وَٱلْمُؤْمِنُونَ وَٱلْمُؤْمِنَـٰتُ بَعْضُهُمْ","بَعْضٍۢ ۚ يَأْمُرُونَ بِٱلْمَعْرُوفِ",127],["9:74:31",199,"يَتَوَلَّوْا۟","they turn away","خَيْرًۭا لَّهُمْ ۖ وَإِن","يُعَذِّبْهُمُ ٱللَّهُ عَذَابًا",145],["9:74:44",199,"وَلِىٍّۢ","protector","فِى ٱلْأَرْضِ مِن","وَلَا نَصِيرٍۢ",127],["9:76:7",199,"وَتَوَلَّوا۟","and turned away","فَضْلِهِۦ بَخِلُوا۟ بِهِۦ","وَّهُم مُّعْرِضُونَ",145],["9:92:14",201,"تَوَلَّوا۟","They turned back","مَآ أَحْمِلُكُمْ عَلَيْهِ","وَّأَعْيُنُهُمْ تَفِيضُ مِنَ",145],["9:116:15",205,"وَلِىٍّۢ","protector","دُونِ ٱللَّهِ مِن","وَلَا نَصِيرٍۢ",127],["9:123:6",207,"يَلُونَكُم","(are) close to you","ءَامَنُوا۟ قَـٰتِلُوا۟ ٱلَّذِينَ","مِّنَ ٱلْكُفَّارِ وَلْيَجِدُوا۟",4643],["9:129:2",207,"تَوَلَّوْا۟","they turn away","فَإِن","فَقُلْ حَسْبِىَ ٱللَّهُ",145],["10:30:10",212,"مَوْلَىٰهُمُ","their Lord","وَرُدُّوٓا۟ إِلَى ٱللَّهِ","ٱلْحَقِّ ۖ وَضَلَّ عَنْهُم",551],["10:62:3",216,"أَوْلِيَآءَ","(the) friends","أَلَآ إِنَّ","ٱللَّهِ لَا خَوْفٌ",127],["10:72:2",217,"تَوَلَّيْتُمْ","you turn away","فَإِن","فَمَا سَأَلْتُكُم مِّنْ",145],["11:3:19",221,"تَوَلَّوْا۟","you turn away","فَضْلٍۢ فَضْلَهُۥ ۖ وَإِن","فَإِنِّىٓ أَخَافُ عَلَيْكُمْ",145],["11:20:14",224,"أَوْلِيَآءَ ۘ","protectors","دُونِ ٱللَّهِ مِنْ","يُضَـٰعَفُ لَهُمُ ٱلْعَذَابُ ۚ",127],["11:52:16",227,"تَتَوَلَّوْا۟","turn away","إِلَىٰ قُوَّتِكُمْ وَلَا","مُجْرِمِينَ",145],["11:57:2",228,"تَوَلَّوْا۟","you turn away","فَإِن","فَقَدْ أَبْلَغْتُكُم مَّآ",145],["11:113:14",234,"أَوْلِيَآءَ","protectors","دُونِ ٱللَّهِ مِنْ","ثُمَّ لَا تُنصَرُونَ",127],["12:84:1",245,"وَتَوَلَّىٰ","And he turned away","","عَنْهُمْ وَقَالَ يَـٰٓأَسَفَىٰ",145],["12:101:14",247,"وَلِىِّۦ","(are) my Protector","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ أَنتَ","فِى ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ ۖ",127],["13:11:35",250,"وَالٍ","protector","مِّن دُونِهِۦ مِن","",4509],["13:16:12",251,"أَوْلِيَآءَ","protectors","أَفَٱتَّخَذْتُم مِّن دُونِهِۦٓ","لَا يَمْلِكُونَ لِأَنفُسِهِمْ",127],["13:37:17",254,"وَلِىٍّۢ","protector","مِنَ ٱللَّهِ مِن","وَلَا وَاقٍۢ",127],["16:63:13",273,"وَلِيُّهُمُ","(is) their ally","ٱلشَّيْطَـٰنُ أَعْمَـٰلَهُمْ فَهُوَ","ٱلْيَوْمَ وَلَهُمْ عَذَابٌ",127],["16:76:14",275,"مَوْلَىٰهُ","his master","وَهُوَ كَلٌّ عَلَىٰ","أَيْنَمَا يُوَجِّههُّ لَا",551],["16:82:2",276,"تَوَلَّوْا۟","they turn away","فَإِن","فَإِنَّمَا عَلَيْكَ ٱلْبَلَـٰغُ",145],["16:100:5",278,"يَتَوَلَّوْنَهُۥ","take him as an ally","سُلْطَـٰنُهُۥ عَلَى ٱلَّذِينَ","وَٱلَّذِينَ هُم بِهِۦ",145],["17:33:14",285,"لِوَلِيِّهِۦ","for his heir","مَظْلُومًۭا فَقَدْ جَعَلْنَا","سُلْطَـٰنًۭا فَلَا يُسْرِف",127],["17:46:16",286,"وَلَّوْا۟","they turn","فِى ٱلْقُرْءَانِ وَحْدَهُۥ","عَلَىٰٓ أَدْبَـٰرِهِمْ نُفُورًۭا",369],["17:97:11",292,"أَوْلِيَآءَ","protectors","فَلَن تَجِدَ لَهُمْ","مِن دُونِهِۦ ۖ وَنَحْشُرُهُمْ",127],["17:111:17",293,"وَلِىٌّۭ","any protector","وَلَمْ يَكُن لَّهُۥ","مِّنَ ٱلذُّلِّ ۖ وَكَبِّرْهُ",127],["18:17:33",295,"وَلِيًّۭا","a protector","فَلَن تَجِدَ لَهُۥ","مُّرْشِدًۭا",127],["18:18:17",295,"لَوَلَّيْتَ","you (would) have surely turned back","لَوِ ٱطَّلَعْتَ عَلَيْهِمْ","مِنْهُمْ فِرَارًۭا وَلَمُلِئْتَ",369],["18:26:18",296,"وَلِىٍّۢ","protector","مِّن دُونِهِۦ مِن","وَلَا يُشْرِكُ فِى",127],["18:44:2",298,"ٱلْوَلَـٰيَةُ","the protection","هُنَالِكَ","لِلَّهِ ٱلْحَقِّ ۚ هُوَ",2713],["18:50:18",299,"أَوْلِيَآءَ","(as) protectors","رَبِّهِۦٓ ۗ أَفَتَتَّخِذُونَهُۥ وَذُرِّيَّتَهُۥٓ","مِن دُونِى وَهُمْ",127],["18:102:9",304,"أَوْلِيَآءَ ۚ","(as) protectors","عِبَادِى مِن دُونِىٓ","إِنَّآ أَعْتَدْنَا جَهَنَّمَ",127],["19:5:3",305,"ٱلْمَوَٰلِىَ","the successors","وَإِنِّى خِفْتُ","مِن وَرَآءِى وَكَانَتِ",2471],["19:5:13",305,"وَلِيًّۭا","an heir","لِى مِن لَّدُنكَ","",127],["19:45:11",308,"وَلِيًّۭا","a friend","ٱلرَّحْمَـٰنِ فَتَكُونَ لِلشَّيْطَـٰنِ","",127],["19:70:6",310,"أَوْلَىٰ","(are) most worthy","أَعْلَمُ بِٱلَّذِينَ هُمْ","بِهَا صِلِيًّۭا",764],["20:48:10",314,"وَتَوَلَّىٰ","and turns away","عَلَىٰ مَن كَذَّبَ","",145],["20:60:1",315,"فَتَوَلَّىٰ","Then went away","","فِرْعَوْنُ فَجَمَعَ كَيْدَهُۥ",145],["21:57:6",326,"تُوَلُّوا۟","you go away","أَصْنَـٰمَكُم بَعْدَ أَن","مُدْبِرِينَ",369],["21:109:2",331,"تَوَلَّوْا۟","they turn away","فَإِن","فَقُلْ ءَاذَنتُكُمْ عَلَىٰ",145],["22:4:5",332,"تَوَلَّاهُ","befriends him","عَلَيْهِ أَنَّهُۥ مَن","فَأَنَّهُۥ يُضِلُّهُۥ وَيَهْدِيهِ",145],["22:13:8",333,"ٱلْمَوْلَىٰ","protector","مِن نَّفْعِهِۦ ۚ لَبِئْسَ","وَلَبِئْسَ ٱلْعَشِيرُ",551],["22:78:40",341,"مَوْلَىٰكُمْ ۖ","(is) your Protector","وَٱعْتَصِمُوا۟ بِٱللَّهِ هُوَ","فَنِعْمَ ٱلْمَوْلَىٰ وَنِعْمَ",551],["22:78:42",341,"ٱلْمَوْلَىٰ","[the] Protector","هُوَ مَوْلَىٰكُمْ ۖ فَنِعْمَ","وَنِعْمَ ٱلنَّصِيرُ",551],["24:11:23",351,"تَوَلَّىٰ","took upon himself a greater share of it","مِنَ ٱلْإِثْمِ ۚ وَٱلَّذِى","كِبْرَهُۥ مِنْهُمْ لَهُۥ",145],["24:47:7",356,"يَتَوَلَّىٰ","turns away","وَبِٱلرَّسُولِ وَأَطَعْنَا ثُمَّ","فَرِيقٌۭ مِّنْهُم مِّنۢ",145],["24:54:7",357,"تَوَلَّوْا۟","you turn away","وَأَطِيعُوا۟ ٱلرَّسُولَ ۖ فَإِن","فَإِنَّمَا عَلَيْهِ مَا",145],["25:18:12",361,"أَوْلِيَآءَ","protectors","مِن دُونِكَ مِنْ","وَلَـٰكِن مَّتَّعْتَهُمْ وَءَابَآءَهُمْ",127],["27:10:8",377,"وَلَّىٰ","he turned back","تَهْتَزُّ كَأَنَّهَا جَآنٌّۭ","مُدْبِرًۭا وَلَمْ يُعَقِّبْ ۚ",369],["27:28:7",379,"تَوَلَّ","turn away","فَأَلْقِهْ إِلَيْهِمْ ثُمَّ","عَنْهُمْ فَٱنظُرْ مَاذَا",145],["27:49:8",381,"لِوَلِيِّهِۦ","to his heir","وَأَهْلَهُۥ ثُمَّ لَنَقُولَنَّ","مَا شَهِدْنَا مَهْلِكَ",127],["27:80:10",384,"وَلَّوْا۟","they turn back","ٱلصُّمَّ ٱلدُّعَآءَ إِذَا","مُدْبِرِينَ",369],["28:24:4",388,"تَوَلَّىٰٓ","he turned back","فَسَقَىٰ لَهُمَا ثُمَّ","إِلَى ٱلظِّلِّ فَقَالَ",145],["28:31:9",389,"وَلَّىٰ","he turned","تَهْتَزُّ كَأَنَّهَا جَآنٌّۭ","مُدْبِرًۭا وَلَمْ يُعَقِّبْ ۚ",369],["29:22:15",398,"وَلِىٍّۢ","protector","دُونِ ٱللَّهِ مِن","وَلَا نَصِيرٍۢ",127],["29:41:7",401,"أَوْلِيَآءَ","protectors","مِن دُونِ ٱللَّهِ","كَمَثَلِ ٱلْعَنكَبُوتِ ٱتَّخَذَتْ",127],["30:52:10",410,"وَلَّوْا۟","they turn","ٱلصُّمَّ ٱلدُّعَآءَ إِذَا","مُدْبِرِينَ",369],["31:7:5",411,"وَلَّىٰ","he turns away","تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا","مُسْتَكْبِرًۭا كَأَن لَّمْ",369],["32:4:20",415,"وَلِىٍّۢ","protector","مِّن دُونِهِۦ مِن","وَلَا شَفِيعٍ ۚ أَفَلَا",127],["33:5:14",418,"وَمَوَٰلِيكُمْ ۚ","and your friends","فَإِخْوَٰنُكُمْ فِى ٱلدِّينِ","وَلَيْسَ عَلَيْكُمْ جُنَاحٌۭ",3724],["33:6:2",418,"أَوْلَىٰ","(is) closer","ٱلنَّبِىُّ","بِٱلْمُؤْمِنِينَ مِنْ أَنفُسِهِمْ ۖ",764],["33:6:11",418,"أَوْلَىٰ","(are) closer","وَأُو۟لُوا۟ ٱلْأَرْحَامِ بَعْضُهُمْ","بِبَعْضٍۢ فِى كِتَـٰبِ",764],["33:6:23",418,"أَوْلِيَآئِكُم","your friends","أَن تَفْعَلُوٓا۟ إِلَىٰٓ","مَّعْرُوفًۭا ۚ كَانَ ذَٰلِكَ",127],["33:15:8",419,"يُوَلُّونَ","they would turn","مِن قَبْلُ لَا","ٱلْأَدْبَـٰرَ ۚ وَكَانَ عَهْدُ",369],["33:17:22",420,"وَلِيًّۭا","any protector","مِّن دُونِ ٱللَّهِ","وَلَا نَصِيرًۭا",127],["33:65:6",427,"وَلِيًّۭا","any protector","أَبَدًۭا ۖ لَّا يَجِدُونَ","وَلَا نَصِيرًۭا",127],["34:41:4",433,"وَلِيُّنَا","(are) our Protector","قَالُوا۟ سُبْحَـٰنَكَ أَنتَ","مِن دُونِهِم ۖ بَلْ",127],["37:90:1",449,"فَتَوَلَّوْا۟","So they turned away","","عَنْهُ مُدْبِرِينَ",145],["37:174:1",452,"فَتَوَلَّ","So turn away","","عَنْهُمْ حَتَّىٰ حِينٍۢ",145],["37:178:1",452,"وَتَوَلَّ","So turn away","","عَنْهُمْ حَتَّىٰ حِينٍۢ",145],["39:3:9",458,"أَوْلِيَآءَ","protectors","ٱتَّخَذُوا۟ مِن دُونِهِۦٓ","مَا نَعْبُدُهُمْ إِلَّا",127],["40:33:2",470,"تُوَلُّونَ","you will turn back","يَوْمَ","مُدْبِرِينَ مَا لَكُم",369],["41:31:2",480,"أَوْلِيَآؤُكُمْ","(are) your protectors","نَحْنُ","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا",127],["41:34:16",480,"وَلِىٌّ","(was) a friend","وَبَيْنَهُۥ عَدَٰوَةٌۭ كَأَنَّهُۥ","حَمِيمٌۭ",127],["42:6:5",483,"أَوْلِيَآءَ","protectors","ٱتَّخَذُوا۟ مِن دُونِهِۦٓ","ٱللَّهُ حَفِيظٌ عَلَيْهِمْ",127],["42:8:17",483,"وَلِىٍّۢ","protector","مَا لَهُم مِّن","وَلَا نَصِيرٍ",127],["42:9:5",483,"أَوْلِيَآءَ ۖ","protectors","ٱتَّخَذُوا۟ مِن دُونِهِۦٓ","فَٱللَّهُ هُوَ ٱلْوَلِىُّ",127],["42:9:8",483,"ٱلْوَلِىُّ","(is) the Protector","أَوْلِيَآءَ ۖ فَٱللَّهُ هُوَ","وَهُوَ يُحْىِ ٱلْمَوْتَىٰ",127],["42:28:12",486,"ٱلْوَلِىُّ","(is) the Protector","وَيَنشُرُ رَحْمَتَهُۥ ۚ وَهُوَ","ٱلْحَمِيدُ",127],["42:31:12",486,"وَلِىٍّۢ","protector","دُونِ ٱللَّهِ مِن","وَلَا نَصِيرٍۢ",127],["42:44:7",487,"وَلِىٍّۢ","protector","فَمَا لَهُۥ مِن","مِّنۢ بَعْدِهِۦ ۗ وَتَرَى",127],["42:46:5",488,"أَوْلِيَآءَ","protector","كَانَ لَهُم مِّنْ","يَنصُرُونَهُم مِّن دُونِ",127],["44:14:2",496,"تَوَلَّوْا۟","they turned away","ثُمَّ","عَنْهُ وَقَالُوا۟ مُعَلَّمٌۭ",145],["44:41:4",498,"مَوْلًى","a relation","يَوْمَ لَا يُغْنِى","عَن مَّوْلًۭى شَيْـًۭٔا",551],["44:41:6",498,"مَّوْلًۭى","a relation","يُغْنِى مَوْلًى عَن","شَيْـًۭٔا وَلَا هُمْ",551],["45:10:16",499,"أَوْلِيَآءَ ۖ","(as) protectors","مِن دُونِ ٱللَّهِ","وَلَهُمْ عَذَابٌ عَظِيمٌ",127],["45:19:11",500,"أَوْلِيَآءُ","(are) allies","وَإِنَّ ٱلظَّـٰلِمِينَ بَعْضُهُمْ","بَعْضٍۢ ۖ وَٱللَّهُ وَلِىُّ",127],["45:19:14",500,"وَلِىُّ","(is the) Protector","أَوْلِيَآءُ بَعْضٍۢ ۖ وَٱللَّهُ","ٱلْمُتَّقِينَ",127],["46:29:15",506,"وَلَّوْا۟","they turned back","أَنصِتُوا۟ ۖ فَلَمَّا قُضِىَ","إِلَىٰ قَوْمِهِم مُّنذِرِينَ",369],["46:32:14",506,"أَوْلِيَآءُ ۚ","protectors","لَهُۥ مِن دُونِهِۦٓ","أُو۟لَـٰٓئِكَ فِى ضَلَـٰلٍۢ",127],["47:11:4",507,"مَوْلَى","(is the) Protector","ذَٰلِكَ بِأَنَّ ٱللَّهَ","ٱلَّذِينَ ءَامَنُوا۟ وَأَنَّ",551],["47:11:10",507,"مَوْلَىٰ","protector","وَأَنَّ ٱلْكَـٰفِرِينَ لَا","لَهُمْ",551],["47:20:26",509,"فَأَوْلَىٰ","But more appropriate","عَلَيْهِ مِنَ ٱلْمَوْتِ ۖ","لَهُمْ",764],["47:22:4",509,"تَوَلَّيْتُمْ","you are given authority","فَهَلْ عَسَيْتُمْ إِن","أَن تُفْسِدُوا۟ فِى",145],["47:38:22",510,"تَتَوَلَّوْا۟","you turn away","وَأَنتُمُ ٱلْفُقَرَآءُ ۚ وَإِن","يَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ",145],["48:16:21",513,"تَتَوَلَّوْا۟","you turn away","أَجْرًا حَسَنًۭا ۖ وَإِن","كَمَا تَوَلَّيْتُم مِّن",145],["48:16:23",513,"تَوَلَّيْتُم","you turned away","وَإِن تَتَوَلَّوْا۟ كَمَا","مِّن قَبْلُ يُعَذِّبْكُمْ",145],["48:17:24",513,"يَتَوَلَّ","turns away","تَحْتِهَا ٱلْأَنْهَـٰرُ ۖ وَمَن","يُعَذِّبْهُ عَذَابًا أَلِيمًۭا",145],["48:22:5",513,"لَوَلَّوُا۟","surely they would turn","قَـٰتَلَكُمُ ٱلَّذِينَ كَفَرُوا۟","ٱلْأَدْبَـٰرَ ثُمَّ لَا",369],["48:22:10",513,"وَلِيًّۭا","any protector","ثُمَّ لَا يَجِدُونَ","وَلَا نَصِيرًۭا",127],["51:39:1",522,"فَتَوَلَّىٰ","But he turned away","","بِرُكْنِهِۦ وَقَالَ سَـٰحِرٌ",145],["51:54:1",523,"فَتَوَلَّ","So turn away","","عَنْهُمْ فَمَآ أَنتَ",145],["53:29:4",527,"تَوَلَّىٰ","turns away","فَأَعْرِضْ عَن مَّن","عَن ذِكْرِنَا وَلَمْ",145],["53:33:3",527,"تَوَلَّىٰ","turned away","أَفَرَءَيْتَ ٱلَّذِى","",145],["54:6:1",528,"فَتَوَلَّ","So turn away","","عَنْهُمْ ۘ يَوْمَ يَدْعُ",145],["54:45:3",530,"وَيُوَلُّونَ","and they will turn","سَيُهْزَمُ ٱلْجَمْعُ","ٱلدُّبُرَ",369],["57:15:13",539,"مَوْلَىٰكُمْ ۖ","your protector","مَأْوَىٰكُمُ ٱلنَّارُ ۖ هِىَ","وَبِئْسَ ٱلْمَصِيرُ",551],["57:24:7",540,"يَتَوَلَّ","turns away","ٱلنَّاسَ بِٱلْبُخْلِ ۗ وَمَن","فَإِنَّ ٱللَّهَ هُوَ",145],["58:14:5",544,"تَوَلَّوْا۟","take as allies","تَرَ إِلَى ٱلَّذِينَ","قَوْمًا غَضِبَ ٱللَّهُ",145],["59:12:12",547,"لَيُوَلُّنَّ","certainly they will turn","يَنصُرُونَهُمْ وَلَئِن نَّصَرُوهُمْ","ٱلْأَدْبَـٰرَ ثُمَّ لَا",369],["60:1:8",549,"أَوْلِيَآءَ","(as) allies","تَتَّخِذُوا۟ عَدُوِّى وَعَدُوَّكُمْ","تُلْقُونَ إِلَيْهِم بِٱلْمَوَدَّةِ",127],["60:6:14",550,"يَتَوَلَّ","turns away","وَٱلْيَوْمَ ٱلْـَٔاخِرَ ۚ وَمَن","فَإِنَّ ٱللَّهَ هُوَ",145],["60:9:16",550,"تَوَلَّوْهُمْ ۚ","you make them allies","عَلَىٰٓ إِخْرَاجِكُمْ أَن","وَمَن يَتَوَلَّهُمْ فَأُو۟لَـٰٓئِكَ",145],["60:9:18",550,"يَتَوَلَّهُمْ","makes them allies","أَن تَوَلَّوْهُمْ ۚ وَمَن","فَأُو۟لَـٰٓئِكَ هُمُ ٱلظَّـٰلِمُونَ",145],["60:13:5",551,"تَتَوَلَّوْا۟","make allies","ٱلَّذِينَ ءَامَنُوا۟ لَا","قَوْمًا غَضِبَ ٱللَّهُ",145],["62:6:8",553,"أَوْلِيَآءُ","(are) allies","إِن زَعَمْتُمْ أَنَّكُمْ","لِلَّهِ مِن دُونِ",127],["64:6:11",556,"وَتَوَلَّوا۟ ۚ","and turned away","أَبَشَرٌۭ يَهْدُونَنَا فَكَفَرُوا۟","وَّٱسْتَغْنَى ٱللَّهُ ۚ وَٱللَّهُ",145],["64:12:6",557,"تَوَلَّيْتُمْ","you turn away","وَأَطِيعُوا۟ ٱلرَّسُولَ ۚ فَإِن","فَإِنَّمَا عَلَىٰ رَسُولِنَا",145],["66:2:8",560,"مَوْلَىٰكُمْ ۖ","(is) your Protector","تَحِلَّةَ أَيْمَـٰنِكُمْ ۚ وَٱللَّهُ","وَهُوَ ٱلْعَلِيمُ ٱلْحَكِيمُ",551],["66:4:14",560,"مَوْلَىٰهُ","(is) his Protector","فَإِنَّ ٱللَّهَ هُوَ","وَجِبْرِيلُ وَصَـٰلِحُ ٱلْمُؤْمِنِينَ ۖ",551],["70:17:4",569,"وَتَوَلَّىٰ","and went away","تَدْعُوا۟ مَنْ أَدْبَرَ","",145],["75:32:3",578,"وَتَوَلَّىٰ","and turned away","وَلَـٰكِن كَذَّبَ","",145],["75:34:1",578,"أَوْلَىٰ","Woe","","لَكَ فَأَوْلَىٰ",764],["75:34:3",578,"فَأَوْلَىٰ","and woe","أَوْلَىٰ لَكَ","",764],["75:35:2",578,"أَوْلَىٰ","woe","ثُمَّ","لَكَ فَأَوْلَىٰٓ",764],["75:35:4",578,"فَأَوْلَىٰٓ","and woe","ثُمَّ أَوْلَىٰ لَكَ","",764],["80:1:2",585,"وَتَوَلَّىٰٓ","and turned away","عَبَسَ","",145],["88:23:3",593,"تَوَلَّىٰ","turns away","إِلَّا مَن","وَكَفَرَ",145],["92:16:3",596,"وَتَوَلَّىٰ","and turned away","ٱلَّذِى كَذَّبَ","",145],["96:13:4",598,"وَتَوَلَّىٰٓ","and turns away","أَرَءَيْتَ إِن كَذَّبَ","",145]]