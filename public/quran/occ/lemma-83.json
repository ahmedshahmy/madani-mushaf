[["2:51:3",8,"مُوسَىٰٓ","(for) Musa","وَإِذْ وَٰعَدْنَا","أَرْبَعِينَ لَيْلَةًۭ ثُمَّ",83],["2:53:3",8,"مُوسَى","Musa","وَإِذْ ءَاتَيْنَا","ٱلْكِتَـٰبَ وَٱلْفُرْقَانَ لَعَلَّكُمْ",83],["2:54:3",8,"مُوسَىٰ","Musa","وَإِذْ قَالَ","لِقَوْمِهِۦ يَـٰقَوْمِ إِنَّكُمْ",83],["2:55:3",8,"يَـٰمُوسَىٰ","O Musa","وَإِذْ قُلْتُمْ","لَن نُّؤْمِنَ لَكَ",83],["2:60:3",9,"مُوسَىٰ","Musa","۞ وَإِذِ ٱسْتَسْقَىٰ","لِقَوْمِهِۦ فَقُلْنَا ٱضْرِب",83],["2:61:3",9,"يَـٰمُوسَىٰ","O Musa","وَإِذْ قُلْتُمْ","لَن نَّصْبِرَ عَلَىٰ",83],["2:67:3",10,"مُوسَىٰ","Musa","وَإِذْ قَالَ","لِقَوْمِهِۦٓ إِنَّ ٱللَّهَ",83],["2:87:3",13,"مُوسَى","Musa","وَلَقَدْ ءَاتَيْنَا","ٱلْكِتَـٰبَ وَقَفَّيْنَا مِنۢ",83],["2:92:3",14,"مُّوسَىٰ","Musa","۞ وَلَقَدْ جَآءَكُم","بِٱلْبَيِّنَـٰتِ ثُمَّ ٱتَّخَذْتُمُ",83],["2:108:8",17,"مُوسَىٰ","Musa","رَسُولَكُمْ كَمَا سُئِلَ","مِن قَبْلُ ۗ وَمَن",83],["2:136:17",21,"مُوسَىٰ","(to) Musa","وَٱلْأَسْبَاطِ وَمَآ أُوتِىَ","وَعِيسَىٰ وَمَآ أُوتِىَ",83],["2:246:10",40,"مُوسَىٰٓ","Musa","إِسْرَٰٓءِيلَ مِنۢ بَعْدِ","إِذْ قَالُوا۟ لِنَبِىٍّۢ",83],["2:248:18",40,"مُوسَىٰ","(of) Musa","مِّمَّا تَرَكَ ءَالُ","وَءَالُ هَـٰرُونَ تَحْمِلُهُ",83],["3:84:17",61,"مُوسَىٰ","(to) Musa","وَٱلْأَسْبَاطِ وَمَآ أُوتِىَ","وَعِيسَىٰ وَٱلنَّبِيُّونَ مِن",83],["4:153:12",102,"مُوسَىٰٓ","Musa","ٱلسَّمَآءِ ۚ فَقَدْ سَأَلُوا۟","أَكْبَرَ مِن ذَٰلِكَ",83],["4:153:35",102,"مُوسَىٰ","Musa","عَن ذَٰلِكَ ۚ وَءَاتَيْنَا","سُلْطَـٰنًۭا مُّبِينًۭا",83],["4:164:13",104,"مُوسَىٰ","(to) Musa","عَلَيْكَ ۚ وَكَلَّمَ ٱللَّهُ","تَكْلِيمًۭا",83],["5:20:3",111,"مُوسَىٰ","Musa","وَإِذْ قَالَ","لِقَوْمِهِۦ يَـٰقَوْمِ ٱذْكُرُوا۟",83],["5:22:2",111,"يَـٰمُوسَىٰٓ","O Musa","قَالُوا۟","إِنَّ فِيهَا قَوْمًۭا",83],["5:24:2",112,"يَـٰمُوسَىٰٓ","O Musa","قَالُوا۟","إِنَّا لَن نَّدْخُلَهَآ",83],["6:84:17",138,"وَمُوسَىٰ","and Musa","وَسُلَيْمَـٰنَ وَأَيُّوبَ وَيُوسُفَ","وَهَـٰرُونَ ۚ وَكَذَٰلِكَ نَجْزِى",83],["6:91:22",139,"مُوسَىٰ","Musa","ٱلَّذِى جَآءَ بِهِۦ","نُورًۭا وَهُدًۭى لِّلنَّاسِ ۖ",83],["6:154:3",149,"مُوسَى","Musa"