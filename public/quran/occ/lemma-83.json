ِن قَبْلُ ۖ قَالُوا۟",83],["28:76:6",394,"مُوسَىٰ","(of) Musa","كَانَ مِن قَوْمِ","فَبَغَىٰ عَلَيْهِمْ ۖ وَءَاتَيْنَـٰهُ",83],["29:39:6",401,"مُّوسَىٰ","Musa","وَهَـٰمَـٰنَ ۖ وَلَقَدْ جَآءَهُم","بِٱلْبَيِّنَـٰتِ فَٱسْتَكْبَرُوا۟ فِى",83],["32:23:3",417,"مُوسَى","Musa","وَلَقَدْ ءَاتَيْنَا","ٱلْكِتَـٰبَ فَلَا تَكُن",83],["33:7:10",419,"وَمُوسَىٰ","and Musa","وَمِن نُّوحٍۢ وَإِبْرَٰهِيمَ","وَعِيسَى ٱبْنِ مَرْيَمَ ۖ",83],["33:69:8",427,"مُوسَىٰ","Musa","تَكُونُوا۟ كَٱلَّذِينَ ءَاذَوْا۟","فَبَرَّأَهُ ٱللَّهُ مِمَّا",83],["37:114:4",450,"مُوسَىٰ","Musa","وَلَقَدْ مَنَنَّا عَلَىٰ","وَهَـٰرُونَ",83],["37:120:3",450,"مُوسَىٰ","Musa","سَلَـٰمٌ عَلَىٰ","وَهَـٰرُونَ",83],["40:23:3",469,"مُوسَىٰ","Musa","وَلَقَدْ أَرْسَلْنَا","بِـَٔايَـٰتِنَا وَسُلْطَـٰنٍۢ مُّبِينٍ",83],["40:26:5",470,"مُوسَىٰ","Musa","فِرْعَوْنُ ذَرُونِىٓ أَقْتُلْ","وَلْيَدْعُ رَبَّهُۥٓ ۖ إِنِّىٓ",83],["40:27:2",470,"مُوسَىٰٓ","Musa","وَقَالَ","إِنِّى عُذْتُ بِرَبِّى",83],["40:37:6",471,"مُوسَىٰ","(of) Musa","فَأَطَّلِعَ إِلَىٰٓ إِلَـٰهِ","وَإِنِّى لَأَظُنُّهُۥ كَـٰذِبًۭا ۚ",83],["40:53:3",473,"مُوسَى","Musa","وَلَقَدْ ءَاتَيْنَا","ٱلْهُدَىٰ وَأَوْرَثْنَا بَنِىٓ",83],["41:45:3",481,"مُوسَى","Musa","وَلَقَدْ ءَاتَيْنَا","ٱلْكِتَـٰبَ فَٱخْتُلِفَ فِيهِ ۗ",83],["42:13:16",484,"وَمُوسَىٰ","and Musa","وَصَّيْنَا بِهِۦٓ إِبْرَٰهِيمَ","وَعِيسَىٰٓ ۖ أَنْ أَقِيمُوا۟",83],["43:46:3",492,"مُوسَىٰ","Musa","وَلَقَدْ أَرْسَلْنَا","بِـَٔايَـٰتِنَآ إِلَىٰ فِرْعَوْنَ",83],["46:12:4",503,"مُوسَىٰٓ","(of) Musa","وَمِن قَبْلِهِۦ كِتَـٰبُ","إِمَامًۭا وَرَحْمَةًۭ ۚ وَهَـٰذَا",83],["46:30:9",506,"مُوسَىٰ","Musa","أُنزِلَ مِنۢ بَعْدِ","مُصَدِّقًۭا لِّمَا بَيْنَ",83],["51:38:2",522,"مُوسَىٰٓ","Musa","وَفِى","إِذْ أَرْسَلْنَـٰهُ إِلَىٰ",83],["53:36:7",527,"مُوسَىٰ","(of) Musa","بِمَا فِى صُحُفِ","",83],["61:5:3",551,"مُوسَىٰ","Musa","وَإِذْ قَالَ","لِقَوْمِهِۦ يَـٰقَوْمِ لِمَ",83],["79:15:4",583,"مُوسَىٰٓ","(of) Musa","هَلْ أَتَىٰكَ حَدِيثُ","",83],["87:19:3",592,"وَمُوسَىٰ","and Musa","صُحُفِ إِبْرَٰهِيمَ","",83]]