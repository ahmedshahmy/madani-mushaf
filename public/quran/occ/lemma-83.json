عْدِهِم","وَهَـٰرُونَ إِلَىٰ فِرْعَوْنَ",83],["10:77:2",217,"مُوسَىٰٓ","Musa said","قَالَ","أَتَقُولُونَ لِلْحَقِّ لَمَّا",83],["10:80:6",218,"مُّوسَىٰٓ","Musa","ٱلسَّحَرَةُ قَالَ لَهُم","أَلْقُوا۟ مَآ أَنتُم",83],["10:81:4",218,"مُوسَىٰ","Musa said","فَلَمَّآ أَلْقَوْا۟ قَالَ","مَا جِئْتُم بِهِ",83],["10:83:3",218,"لِمُوسَىٰٓ","Musa","فَمَآ ءَامَنَ","إِلَّا ذُرِّيَّةٌۭ مِّن",83],["10:84:2",218,"مُوسَىٰ","And Musa said","وَقَالَ","يَـٰقَوْمِ إِن كُنتُمْ",83],["10:87:3",218,"مُوسَىٰ","Musa","وَأَوْحَيْنَآ إِلَىٰ","وَأَخِيهِ أَن تَبَوَّءَا",83],["10:88:2",218,"مُوسَىٰ","And Musa said","وَقَالَ","رَبَّنَآ إِنَّكَ ءَاتَيْتَ",83],["11:17:13",223,"مُوسَىٰٓ","(of) Musa","وَمِن قَبْلِهِۦ كِتَـٰبُ","إِمَامًۭا وَرَحْمَةً ۚ أُو۟لَـٰٓئِكَ",83],["11:96:3",232,"مُوسَىٰ","Musa","وَلَقَدْ أَرْسَلْنَا","بِـَٔايَـٰتِنَا وَسُلْطَـٰنٍۢ مُّبِينٍ",83],["11:110:3",234,"مُوسَى","Musa","وَلَقَدْ ءَاتَيْنَا","ٱلْكِتَـٰبَ فَٱخْتُلِفَ فِيهِ ۚ",83],["14:5:3",255,"مُوسَىٰ","Musa","وَلَقَدْ أَرْسَلْنَا","بِـَٔايَـٰتِنَآ أَنْ أَخْرِجْ",83],["14:6:3",256,"مُوسَىٰ","Musa","وَإِذْ قَالَ","لِقَوْمِهِ ٱذْكُرُوا۟ نِعْمَةَ",83],["14:8:2",256,"مُوسَىٰٓ","Musa","وَقَالَ","إِن تَكْفُرُوٓا۟ أَنتُمْ",83],["17:2:2",282,"مُوسَى","Musa","وَءَاتَيْنَا","ٱلْكِتَـٰبَ وَجَعَلْنَـٰهُ هُدًۭى",83],["17:101:3",292,"مُوسَىٰ","Musa","وَلَقَدْ ءَاتَيْنَا","تِسْعَ ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ ۖ",83],["17:101:17",292,"يَـٰمُوسَىٰ","O Musa","فِرْعَوْنُ إِنِّى لَأَظُنُّكَ","مَسْحُورًۭا",83],["18:60:3",300,"مُوسَىٰ","Musa","وَإِذْ قَالَ","لِفَتَىٰهُ لَآ أَبْرَحُ",83],["18:66:3",301,"مُوسَىٰ","Musa","قَالَ لَهُۥ","هَلْ أَتَّبِعُكَ عَلَىٰٓ",83],["19:51:4",308,"مُوسَىٰٓ ۚ","Musa","وَٱذْكُرْ فِى ٱلْكِتَـٰبِ","إِنَّهُۥ كَانَ مُخْلَصًۭا",83],["20:9:4",312,"مُوسَىٰٓ","(of) Musa","وَهَلْ أَتَىٰكَ حَدِيثُ","",83],["20:11:4",312,"يَـٰمُوسَىٰٓ","O Musa","فَلَمَّآ أَتَىٰهَا نُودِىَ","",83],["20:17:4",313,"يَـٰمُوسَىٰ","O Musa","وَمَا تِلْكَ بِيَمِينِكَ","",83],["20:19:3",313,"يَـٰمُوسَىٰ","O Musa","قَالَ أَلْقِهَا","",83],["20:36:5",313,"يَـٰمُوسَىٰ","O Musa","قَدْ أُوتِيتَ سُؤْلَكَ","",83],["20:40:34",314,"يَـٰمُوسَىٰ","O Musa","جِئْتَ عَلَىٰ قَدَرٍۢ","",83],["20:49:4",314,"يَـٰمُوسَىٰ","O Musa","قَالَ فَمَن رَّبُّكُمَا","",83],["20:57:7",315,"يَـٰمُوسَىٰ","O Musa","مِنْ أَرْضِنَا بِسِحْرِكَ","",83],["20:61:3",315,"مُّوسَىٰ","Musa","قَالَ لَهُم","وَيْلَكُمْ لَا تَفْتَرُوا۟",83],["20:65:2",316,"يَـٰمُوسَىٰٓ","O Musa","قَالُوا۟","إِمَّآ أَن تُلْقِىَ",83],["20:67:5",316,"مُّوسَىٰ","Musa","فِى نَفْسِهِۦ خِيفَةًۭ","",83],["20:70:8",316,"وَمُوسَىٰ","and Musa","ءَامَنَّا بِرَبِّ هَـٰرُونَ","",83],["20:77:4",317,"مُوسَىٰٓ","Musa","وَلَقَدْ أَوْحَيْنَآ إِلَىٰ","أَنْ أَسْرِ بِعِبَادِى",83],["20:83:5",317,"يَـٰمُوسَىٰ","O Musa","أَعْجَلَكَ عَن قَوْمِكَ","",83],["20:86:2",317,"مُوسَىٰٓ","Then Musa returned","فَرَجَعَ","إِلَىٰ قَوْمِهِۦ غَضْبَـٰنَ",83],["20:88:11",318,"مُوسَىٰ","(of) Musa","هَـٰذَآ إِلَـٰهُكُمْ وَإِلَـٰهُ","فَنَسِىَ",83],["20:91:9",318,"مُوسَىٰ","Musa","حَتَّىٰ يَرْجِعَ إِلَيْنَا","",83],["21:48:3",326,"مُوسَىٰ","Musa","وَلَقَدْ ءَاتَيْنَا","وَهَـٰرُونَ ٱلْفُرْقَانَ وَضِيَآءًۭ",83],["22:44:4",337,"مُوسَىٰ","And Musa was denied","وَأَصْحَـٰبُ مَدْيَنَ ۖ وَكُذِّبَ","فَأَمْلَيْتُ لِلْكَـٰفِرِينَ ثُمَّ",83],["23:45:3",345,"مُوسَىٰ","Musa","ثُمَّ أَرْسَلْنَا","وَأَخَاهُ هَـٰرُونَ بِـَٔايَـٰتِنَا",83],["23:49:3",345,"مُوسَى","Musa","وَلَقَدْ ءَاتَيْنَا","ٱلْكِتَـٰبَ لَعَلَّهُمْ يَهْتَدُونَ",83],["25:35:3",363,"مُوسَى","Musa","وَلَقَدْ ءَاتَيْنَا","ٱلْكِتَـٰبَ وَجَعَلْنَا مَعَهُۥٓ",83],["26:10:4",367,"مُوسَىٰٓ","Musa","وَإِذْ نَادَىٰ رَبُّكَ","أَنِ ٱئْتِ ٱلْقَوْمَ",83],["26:43:3",369,"مُّوسَىٰٓ","Musa","قَالَ لَهُم","أَلْقُوا۟ مَآ أَنتُم",83],["26:45:2",369,"مُوسَىٰ","Musa","فَأَلْقَىٰ","عَصَاهُ فَإِذَا هِىَ",83],["26:48:2",369,"مُوسَىٰ","(of) Musa","رَبِّ","وَهَـٰرُونَ",83],["26:52:3",369,"مُوسَىٰٓ","Musa","۞ وَأَوْحَيْنَآ إِلَىٰ","أَنْ أَسْرِ بِعِبَادِىٓ",83],["26:61:6",370,"مُوسَىٰٓ","(of) Musa","ٱلْجَمْعَانِ قَالَ أَصْحَـٰبُ","إِنَّا لَمُدْرَكُونَ",83],["26:63:3",370,"مُوسَىٰٓ","Musa","فَأ