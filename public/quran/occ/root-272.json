[["2:258:29",43,"بِٱلشَّمْسِ","the sun","فَإِنَّ ٱللَّهَ يَأْتِى","مِنَ ٱلْمَشْرِقِ فَأْتِ",342],["6:78:3",137,"ٱلشَّمْسَ","the sun","فَلَمَّا رَءَا","بَازِغَةًۭ قَالَ هَـٰذَا",342],["6:96:6",140,"وَٱلشَّمْسَ","and the sun","وَجَعَلَ ٱلَّيْلَ سَكَنًۭا","وَٱلْقَمَرَ حُسْبَانًۭا ۚ ذَٰلِكَ",342],["7:54:20",157,"وَٱلشَّمْسَ","and the sun","ٱلنَّهَارَ يَطْلُبُهُۥ حَثِيثًۭا","وَٱلْقَمَرَ وَٱلنُّجُومَ مُسَخَّرَٰتٍۭ",342],["10:5:4",208,"ٱلشَّمْسَ","the sun","هُوَ ٱلَّذِى جَعَلَ","ضِيَآءًۭ وَٱلْقَمَرَ نُورًۭا",342],["12:4:11",235,"وَٱلشَّمْسَ","and the sun","أَحَدَ عَشَرَ كَوْكَبًۭا","وَٱلْقَمَرَ رَأَيْتُهُمْ لِى",342],["13:2:13",249,"ٱلشَّمْسَ","the sun","عَلَى ٱلْعَرْشِ ۖ وَسَخَّرَ","وَٱلْقَمَرَ ۖ كُلٌّۭ يَجْرِى",342],["14:33:3",259,"ٱلشَّمْسَ","the sun","وَسَخَّرَ لَكُمُ","وَٱلْقَمَرَ دَآئِبَيْنِ ۖ وَسَخَّرَ",342],["16:12:5",268,"وَٱلشَّمْسَ","and the sun","لَكُمُ ٱلَّيْلَ وَٱلنَّهَارَ","وَٱلْقَمَرَ ۖ وَٱلنُّجُومُ مُسَخَّرَٰتٌۢ",342],["17:78:4",290,"ٱلشَّمْسِ","(of) the sun","أَقِمِ ٱلصَّلَوٰةَ لِدُلُوكِ","إِلَىٰ غَسَقِ ٱلَّيْلِ",342],["18:17:2",295,"ٱلشَّمْسَ","the sun","۞ وَتَرَى","إِذَا طَلَعَت تَّزَٰوَرُ",342],["18:86:5",303,"ٱلشَّمْسِ","(of) the sun","إِذَا بَلَغَ مَغْرِبَ","وَجَدَهَا تَغْرُبُ فِى",342],["18:90:5",303,"ٱلشَّمْسِ","(of) the sun","إِذَا بَلَغَ مَطْلِعَ","وَجَدَهَا تَطْلُعُ عَلَىٰ",342],["20:130:10",321,"ٱلشَّمْسِ","(of) the sun","رَبِّكَ قَبْلَ طُلُوعِ","وَقَبْلَ غُرُوبِهَا ۖ وَمِنْ",342],["21:33:6",324,"وَٱلشَّمْسَ","and the sun","خَلَقَ ٱلَّيْلَ وَٱلنَّهَارَ","وَٱلْقَمَرَ ۖ كُلٌّۭ فِى",342],["22:18:13",334,"وَٱلشَّمْسُ","and the sun","وَمَن فِى ٱلْأَرْضِ","وَٱلْقَمَرُ وَٱلنُّجُومُ وَٱلْجِبَالُ",342],["25:45:14",364,"ٱلشَّمْسَ","the sun","سَاكِنًۭا ثُمَّ جَعَلْنَا","عَلَيْهِ دَلِيلًۭا",342],["27:24:4",379,"لِلشَّمْسِ","to the sun","وَجَدتُّهَا وَقَوْمَهَا يَسْجُدُونَ","مِن دُونِ ٱللَّهِ",342],["29:61:8",403,"ٱلشَّمْسَ","the sun","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَسَخَّرَ","وَٱلْقَمَرَ لَيَقُولُنَّ ٱللَّهُ ۖ",342],["31:29:14",414,"ٱلشَّمْسَ","the sun","فِى ٱلَّيْلِ وَسَخَّرَ","وَٱلْقَمَرَ كُلٌّۭ يَجْرِىٓ",342],["35:13:10",436,"ٱلشَّمْسَ","the sun","فِى ٱلَّيْلِ وَسَخَّرَ","وَٱلْقَمَرَ كُلٌّۭ يَجْرِى",342],["36:38:1",442,"وَٱلشَّمْسُ","And the sun","","تَجْرِى لِمُسْتَقَرٍّۢ لَّهَا ۚ",342],["36:40:2",442,"ٱلشَّمْسُ","the sun","لَا","يَنۢبَغِى لَهَآ أَن",342],["39:5:14",458,"ٱلشَّمْسَ","the sun","عَلَى ٱلَّيْلِ ۖ وَسَخَّرَ","وَٱلْقَمَرَ ۖ كُلٌّۭ يَجْرِى",342],["41:37:5",480,"وَٱلشَّمْسُ","and the sun","ءَايَـٰتِهِ ٱلَّيْلُ وَٱلنَّهَارُ","وَٱلْقَمَرُ ۚ لَا تَسْجُدُوا۟",342],["41:37:9",480,"لِلشَّمْسِ","to the sun","وَٱلْقَمَرُ ۚ لَا تَسْجُدُوا۟","وَلَا لِلْقَمَرِ وَٱسْجُدُوا۟",342],["50:39:10",520,"ٱلشَّمْسِ","(of) the sun","رَبِّكَ قَبْلَ طُلُوعِ","وَقَبْلَ ٱلْغُرُوبِ",342],["55:5:1",531,"ٱلشَّمْسُ","The sun","","وَٱلْقَمَرُ بِحُسْبَانٍۢ",342],["71:16:6",571,"ٱلشَّمْسَ","the sun","فِيهِنَّ نُورًۭا وَجَعَلَ","سِرَاجًۭا",342],["75:9:2",577,"ٱلشَّمْسُ","the sun","وَجُمِعَ","وَٱلْقَمَرُ",342],["76:13:8",579,"شَمْسًۭا","sun","لَا يَرَوْنَ فِيهَا","وَلَا زَمْهَرِيرًۭا",342],["81:1:2",586,"ٱلشَّمْسُ","the sun","إِذَا","كُوِّرَتْ",342],["91:1:1",595,"وَٱلشَّمْسِ","By the sun","","وَضُحَىٰهَا",342]]