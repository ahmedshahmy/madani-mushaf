[["7:74:15",160,"وَتَنْحِتُونَ","and you carve out","مِن سُهُولِهَا قُصُورًۭا","ٱلْجِبَالَ بُيُوتًۭا ۖ فَٱذْكُرُوٓا۟",1669],["15:82:2",266,"يَنْحِتُونَ","carve","وَكَانُوا۟","مِنَ ٱلْجِبَالِ بُيُوتًا",1669],["26:149:1",373,"وَتَنْحِتُونَ","And you carve","","مِنَ ٱلْجِبَالِ بُيُوتًۭا",1669],["37:95:4",449,"تَنْحِتُونَ","you carve","قَالَ أَتَعْبُدُونَ مَا","",1669]]