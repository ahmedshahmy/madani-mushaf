[["3:178:6",73,"نُمْلِى","We give respite","ٱلَّذِينَ كَفَرُوٓا۟ أَنَّمَا","لَهُمْ خَيْرٌۭ لِّأَنفُسِهِمْ ۚ",875],["3:178:11",73,"نُمْلِى","We give respite","خَيْرٌۭ لِّأَنفُسِهِمْ ۚ إِنَّمَا","لَهُمْ لِيَزْدَادُوٓا۟ إِثْمًۭا ۚ",875],["7:183:1",174,"وَأُمْلِى","And I will give respite","","لَهُمْ ۚ إِنَّ كَيْدِى",875],["13:32:6",253,"فَأَمْلَيْتُ","but I granted respite","بِرُسُلٍۢ مِّن قَبْلِكَ","لِلَّذِينَ كَفَرُوا۟ ثُمَّ",875],["19:46:12",308,"مَلِيًّۭا","(for) a prolonged time","تَنتَهِ لَأَرْجُمَنَّكَ ۖ وَٱهْجُرْنِى","",3680],["22:44:5",337,"فَأَمْلَيْتُ","so I granted respite","مَدْيَنَ ۖ وَكُذِّبَ مُوسَىٰ","لِلْكَـٰفِرِينَ ثُمَّ أَخَذْتُهُمْ ۖ",875],["22:48:4",338,"أَمْلَيْتُ","I gave respite","وَكَأَيِّن مِّن قَرْيَةٍ","لَهَا وَهِىَ ظَالِمَةٌۭ",875],["25:5:6",360,"تُمْلَىٰ","are dictated","ٱلْأَوَّلِينَ ٱكْتَتَبَهَا فَهِىَ","عَلَيْهِ بُكْرَةًۭ وَأَصِيلًۭا",875],["47:25:15",509,"وَأَمْلَىٰ","and prolonged hope","ٱلشَّيْطَـٰنُ سَوَّلَ لَهُمْ","لَهُمْ",875],["68:45:1",566,"وَأُمْلِى","And I will give respite","","لَهُمْ ۚ إِنَّ كَيْدِى",875]]