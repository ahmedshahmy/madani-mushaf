[["9:14:8",189,"وَيَشْفِ","and will heal","وَيُخْزِهِمْ وَيَنصُرْكُمْ عَلَيْهِمْ","صُدُورَ قَوْمٍۢ مُّؤْمِنِينَ",2752],["10:57:8",215,"وَشِفَآءٌۭ","and a healing","مَّوْعِظَةٌۭ مِّن رَّبِّكُمْ","لِّمَا فِى ٱلصُّدُورِ",1456],["16:69:17",274,"شِفَآءٌۭ","(is) a healing","مُّخْتَلِفٌ أَلْوَٰنُهُۥ فِيهِ","لِّلنَّاسِ ۗ إِنَّ فِى",1456],["17:82:6",290,"شِفَآءٌۭ","(is) a healing","ٱلْقُرْءَانِ مَا هُوَ","وَرَحْمَةٌۭ لِّلْمُؤْمِنِينَ ۙ وَلَا",1456],["26:80:4",370,"يَشْفِينِ","cures me","وَإِذَا مَرِضْتُ فَهُوَ","",2752],["41:44:16",481,"وَشِفَآءٌۭ ۖ","and a healing","لِلَّذِينَ ءَامَنُوا۟ هُدًۭى","وَٱلَّذِينَ لَا يُؤْمِنُونَ",1456]]