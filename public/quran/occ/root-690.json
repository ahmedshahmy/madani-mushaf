[["6:99:28",140,"وَٱلزَّيْتُونَ","and the olives","وَجَنَّـٰتٍۢ مِّنْ أَعْنَابٍۢ","وَٱلرُّمَّانَ مُشْتَبِهًۭا وَغَيْرَ",1439],["6:141:12",146,"وَٱلزَّيْتُونَ","and the olives","وَٱلزَّرْعَ مُخْتَلِفًا أُكُلُهُۥ","وَٱلرُّمَّانَ مُتَشَـٰبِهًۭا وَغَيْرَ",1439],["16:11:5",268,"وَٱلزَّيْتُونَ","and the olives","لَكُم بِهِ ٱلزَّرْعَ","وَٱلنَّخِيلَ وَٱلْأَعْنَـٰبَ وَمِن",1439],["24:35:21",354,"زَيْتُونَةٍۢ","an olive","مِن شَجَرَةٍۢ مُّبَـٰرَكَةٍۢ","لَّا شَرْقِيَّةٍۢ وَلَا",4765],["24:35:27",354,"زَيْتُهَا","its oil","وَلَا غَرْبِيَّةٍۢ يَكَادُ","يُضِىٓءُ وَلَوْ لَمْ",4764],["80:29:1",585,"وَزَيْتُونًۭا","And olive","","وَنَخْلًۭا",1439],["95:1:2",597,"وَٱلزَّيْتُونِ","and the olive","وَٱلتِّينِ","",1439]]