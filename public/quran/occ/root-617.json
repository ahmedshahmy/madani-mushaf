[["2:27:2",5,"يَنقُضُونَ","break","ٱلَّذِينَ","عَهْدَ ٱللَّهِ مِنۢ",1213],["4:155:2",103,"نَقْضِهِم","their breaking","فَبِمَا","مِّيثَـٰقَهُمْ وَكُفْرِهِم بِـَٔايَـٰتِ",2557],["5:13:2",109,"نَقْضِهِم","their breaking","فَبِمَا","مِّيثَـٰقَهُمْ لَعَنَّـٰهُمْ وَجَعَلْنَا",2557],["8:56:5",184,"يَنقُضُونَ","they break","عَـٰهَدتَّ مِنْهُمْ ثُمَّ","عَهْدَهُمْ فِى كُلِّ",1213],["13:20:6",252,"يَنقُضُونَ","they break","بِعَهْدِ ٱللَّهِ وَلَا","ٱلْمِيثَـٰقَ",1213],["13:25:2",252,"يَنقُضُونَ","break","وَٱلَّذِينَ","عَهْدَ ٱللَّهِ مِنۢ",1213],["16:91:7",277,"تَنقُضُوا۟","break","إِذَا عَـٰهَدتُّمْ وَلَا","ٱلْأَيْمَـٰنَ بَعْدَ تَوْكِيدِهَا",1213],["16:92:4",277,"نَقَضَتْ","untwists","وَلَا تَكُونُوا۟ كَٱلَّتِى","غَزْلَهَا مِنۢ بَعْدِ",1213],["94:3:2",597,"أَنقَضَ","weighed upon","ٱلَّذِىٓ","ظَهْرَكَ",3023]]