[["3:106:13",63,"فَذُوقُوا۟","Then taste","أَكَفَرْتُم بَعْدَ إِيمَـٰنِكُمْ","ٱلْعَذَابَ بِمَا كُنتُمْ",322],["3:181:20",74,"ذُوقُوا۟","Taste","بِغَيْرِ حَقٍّۢ وَنَقُولُ","عَذَابَ ٱلْحَرِيقِ",322],["3:185:3",74,"ذَآئِقَةُ","(will) taste","كُلُّ نَفْسٍۢ","ٱلْمَوْتِ ۗ وَإِنَّمَا تُوَفَّوْنَ",1710],["4:56:14",87,"لِيَذُوقُوا۟","so that they may taste","بَدَّلْنَـٰهُمْ جُلُودًا غَيْرَهَا","ٱلْعَذَابَ ۗ إِنَّ ٱللَّهَ",322],["5:95:35",123,"لِّيَذُوقَ","that he may taste","عَدْلُ ذَٰلِكَ صِيَامًۭا","وَبَالَ أَمْرِهِۦ ۗ عَفَا",322],["6:30:15",131,"فَذُوقُوا۟","So taste","بَلَىٰ وَرَبِّنَا ۚ قَالَ","ٱلْعَذَابَ بِمَا كُنتُمْ",322],["6:65:18",135,"وَيُذِيقَ","and make (you) taste","أَوْ يَلْبِسَكُمْ شِيَعًۭا","بَعْضَكُم بَأْسَ بَعْضٍ ۗ",462],["6:148:21",148,"ذَاقُوا۟","they tasted","مِن قَبْلِهِمْ حَتَّىٰ","بَأْسَنَا ۗ قُلْ هَلْ",322],["7:22:4",152,"ذَاقَا","they both tasted","فَدَلَّىٰهُمَا بِغُرُورٍۢ ۚ فَلَمَّا","ٱلشَّجَرَةَ بَدَتْ لَهُمَا",322],["7:39:10",155,"فَذُوقُوا۟","so taste","عَلَيْنَا مِن فَضْلٍۢ","ٱلْعَذَابَ بِمَا كُنتُمْ",322],["8:14:2",178,"فَذُوقُوهُ","So taste it","ذَٰلِكُمْ","وَأَنَّ لِلْكَـٰفِرِينَ عَذَابَ",322],["8:35:9",181,"فَذُوقُوا۟","So taste","إِلَّا مُكَآءًۭ وَتَصْدِيَةًۭ ۚ","ٱلْعَذَابَ بِمَا كُنتُمْ",322],["8:50:11",183,"وَذُوقُوا۟","Taste","يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبَـٰرَهُمْ","عَذَابَ ٱلْحَرِيقِ",322],["9:35:16",192,"فَذُوقُوا۟","so taste","مَا كَنَزْتُمْ لِأَنفُسِكُمْ","مَا كُنتُمْ تَكْنِزُونَ",322],["10:21:2",211,"أَذَقْنَا","We let [the] mankind taste","وَإِذَآ","ٱلنَّاسَ رَحْمَةًۭ مِّنۢ",462],["10:52:5",214,"ذُوقُوا۟","Taste","قِيلَ لِلَّذِينَ ظَلَمُوا۟","عَذَابَ ٱلْخُلْدِ هَلْ",322],["10:70:8",216,"نُذِيقُهُمُ","We will make them taste","إِلَيْنَا مَرْجِعُهُمْ ثُمَّ","ٱلْعَذَابَ ٱلشَّدِيدَ بِمَا",462],["11:9:2",222,"أَذَقْنَا","We give man a taste","وَلَئِنْ","ٱلْإِنسَـٰنَ مِنَّا رَحْمَةًۭ",462],["11:10:2",222,"أَذَقْنَـٰهُ","We give him a taste","وَلَئِنْ","نَعْمَآءَ بَعْدَ ضَرَّآءَ",462],["16:94:10",278,"وَتَذُوقُوا۟","and you would taste","قَدَمٌۢ بَعْدَ ثُبُوتِهَا","ٱلسُّوٓءَ بِمَا صَدَدتُّمْ",322],["16:112:17",280,"فَأَذَٰقَهَا","so Allah made it taste","فَكَفَرَتْ بِأَنْعُمِ ٱللَّهِ","ٱللَّهُ لِبَاسَ ٱلْجُوعِ",462],["17:75:2",289,"لَّأَذَقْنَـٰكَ","We (would) have made you taste","إِذًۭا","ضِعْفَ ٱلْحَيَوٰةِ وَضِعْفَ",462],["21:35:3",324,"ذَآئِقَةُ","(will) taste","كُلُّ نَفْسٍۢ","ٱلْمَوْتِ ۗ وَنَبْلُوكُم بِٱلشَّرِّ",1710],["22:9:11",333,"وَنُذِيقُهُۥ","and We will make him taste","فِى ٱلدُّنْيَا خِزْىٌۭ ۖ","يَوْمَ ٱلْقِيَـٰمَةِ عَذَابَ",462],["22:22:10",334,"وَذُوقُوا۟","Taste","غَمٍّ أُعِيدُوا۟ فِيهَا","عَذَابَ ٱلْحَرِيقِ",322],["22:25:22",335,"نُّذِقْهُ","We will make him taste","فِيهِ بِإِلْحَادٍۭ بِظُلْمٍۢ","مِنْ عَذَابٍ أَلِيمٍۢ",462],["25:19:13",361,"نُذِقْهُ","We will make him taste","وَمَن يَظْلِم مِّنكُمْ","عَذَابًۭا كَبِيرًۭا",462],["29:55:10",403,"ذُوقُوا۟","Taste","تَحْتِ أَرْجُلِهِمْ وَيَقُولُ","مَا كُنتُمْ تَعْمَلُونَ",322],["29:57:3",403,"ذَآئِقَةُ","(will) taste","كُلُّ نَفْسٍۢ","ٱلْمَوْتِ ۖ ثُمَّ إِلَيْنَا",1710],["30:33:11",408,"أَذَاقَهُم","He causes them to taste","إِلَيْهِ ثُمَّ إِذَآ","مِّنْهُ رَحْمَةً إِذَا",462],["30:36:2",408,"أَذَقْنَا","We cause people to taste","وَإِذَآ","ٱلنَّاسَ رَحْمَةًۭ فَرِحُوا۟",462],["30:41:10",408,"لِيُذِيقَهُم","so that He may let them taste","كَسَبَتْ أَيْدِى ٱلنَّاسِ","بَعْضَ ٱلَّذِى عَمِلُوا۟",462],["30:46:7",409,"وَلِيُذِيقَكُم","and to let you taste","يُرْسِلَ ٱلرِّيَاحَ مُبَشِّرَٰتٍۢ","مِّن رَّحْمَتِهِۦ وَلِتَجْرِىَ",462],["32:14:1",416,"فَذُوقُوا۟","So taste","","بِمَا نَسِيتُمْ لِقَآءَ",322],["32:14:9",416,"وَذُوقُوا۟","And taste","هَـٰذَآ إِنَّا نَسِينَـٰكُمْ ۖ","عَذَابَ ٱلْخُلْدِ بِمَا",322],["32:20:15",416,"ذُوقُوا۟","Taste","فِيهَا وَقِيلَ لَهُمْ","عَذَابَ ٱلنَّارِ ٱلَّذِى",322],["32:21:1",417,"وَلَنُذِيقَنَّهُم","And surely, We will let them taste","","مِّنَ ٱلْعَذَابِ ٱلْأَدْنَىٰ",462],["34:12:24",429,"نُذِقْهُ","We will make him taste","مِنْهُمْ عَنْ أَمْرِنَا","مِنْ عَذَابِ ٱلسَّعِيرِ",462],["34:42:12",433,"ذُوقُوا۟","Taste","وَنَقُولُ لِلَّذِينَ ظَلَمُوا۟","عَذَابَ ٱلنَّارِ ٱلَّتِى",322],["35:37:21",438,"فَذُوقُوا۟","So taste","تَذَكَّرَ وَجَآءَكُمُ ٱلنَّذِيرُ ۖ","فَمَا لِلظَّـٰلِمِينَ مِن",322],["37:31:6",447,"لَذَآئِقُونَ","(will) certainly taste","قَوْلُ رَبِّنَآ ۖ إِنَّا","",2127],["37:38:2",447,"لَذَآئِقُوا۟","(will) surely taste","إِنَّكُمْ","ٱلْعَذَابِ ٱلْأَلِيمِ",2127],["38:8:14",453,"يَذُوقُوا۟","they have tasted","ذِكْرِى ۖ بَل لَّمَّا","عَذَابِ",322],["38:57:2",456,"فَلْيَذُوقُوهُ","Then let them taste it","هَـٰذَا","حَمِيمٌۭ وَغَسَّاقٌۭ",322],["39:24:10",461,"ذُوقُوا۟","Taste","ٱلْقِيَـٰمَةِ ۚ وَقِيلَ لِلظَّـٰلِمِينَ","مَا كُنتُمْ تَكْسِبُونَ",322],["39:26:1",461,"فَأَذَاقَهُمُ","So Allah made them","","ٱللَّهُ ٱلْخِزْىَ فِى",462],["41:16:8",478,"لِّنُذِيقَهُمْ","that We may make them taste","فِىٓ أَيَّامٍۢ نَّحِسَاتٍۢ","عَذَابَ ٱلْخِزْىِ فِى",462],["41:27:1",479,"فَلَنُذِيقَنَّ","But surely We will cause to taste","","ٱلَّذِينَ كَفَرُوا۟ عَذَابًۭا",462],["41:50:2",482,"أَذَقْنَـٰهُ","We let him taste","وَلَئِنْ","رَحْمَةًۭ مِّنَّا مِنۢ",462],["41:50:29",482,"وَلَنُذِيقَنَّهُم","and We will surely make them taste","كَفَرُوا۟ بِمَا عَمِلُوا۟","مِّنْ عَذَابٍ غَلِيظٍۢ",462],["42:48:13",488,"أَذَقْنَا","We cause to taste","ٱلْبَلَـٰغُ ۗ وَإِنَّآ إِذَآ","ٱلْإِنسَـٰنَ مِنَّا رَحْمَةًۭ",462],["44:49:1",498,"ذُقْ","Taste","","إِنَّكَ أَنتَ ٱلْعَزِيزُ",322],["44:56:2",498,"يَذُوقُونَ","they will taste","لَا","فِيهَا ٱلْمَوْتَ إِلَّا",322],["46:34:14",506,"فَذُوقُوا۟","Then taste","بَلَىٰ وَرَبِّنَا ۚ قَالَ","ٱلْعَذَابَ بِمَا كُنتُمْ",322],["51:14:1",521,"ذُوقُوا۟","Taste","","فِتْنَتَكُمْ هَـٰذَا ٱلَّذِى",322],["54:37:7",530,"فَذُوقُوا۟","So taste","ضَيْفِهِۦ فَطَمَسْنَآ أَعْيُنَهُمْ","عَذَابِى وَنُذُرِ",322],["54:39:1",530,"فَذُوقُوا۟","So taste","","عَذَابِى وَنُذُرِ",322],["54:48:7",530,"ذُوقُوا۟","Taste","ٱلنَّارِ عَلَىٰ وُجُوهِهِمْ","مَسَّ سَقَرَ",322],["59:15:6",547,"ذَاقُوا۟","they tasted","مِن قَبْلِهِمْ قَرِيبًۭا ۖ","وَبَالَ أَمْرِهِمْ وَلَهُمْ",322],["64:5:8",556,"فَذَاقُوا۟","So they tasted","كَفَرُوا۟ مِن قَبْلُ","وَبَالَ أَمْرِهِمْ وَلَهُمْ",322],["65:9:1",559,"فَذَاقَتْ","So it tasted","","وَبَالَ أَمْرِهَا وَكَانَ",322],["78:24:2",582,"يَذُوقُونَ","they will taste","لَّا","فِيهَا بَرْدًۭا وَلَا",322],["78:30:1",582,"فَذُوقُوا۟","So taste","","فَلَن نَّزِيدَكُمْ إِلَّا",322]]