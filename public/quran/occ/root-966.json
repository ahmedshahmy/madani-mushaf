[["7:22:9",152,"وَطَفِقَا","and they began","بَدَتْ لَهُمَا سَوْءَٰتُهُمَا","يَخْصِفَانِ عَلَيْهِمَا مِن",1800],["20:121:6",320,"وَطَفِقَا","and they began","فَبَدَتْ لَهُمَا سَوْءَٰتُهُمَا","يَخْصِفَانِ عَلَيْهِمَا مِن",1800],["38:33:3",455,"فَطَفِقَ","Then he began","رُدُّوهَا عَلَىَّ ۖ","مَسْحًۢا بِٱلسُّوقِ وَٱلْأَعْنَاقِ",1800]]