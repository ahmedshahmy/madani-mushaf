[["2:16:3",3,"ٱشْتَرَوُا۟","bought","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","ٱلضَّلَـٰلَةَ بِٱلْهُدَىٰ فَمَا",498],["2:41:13",7,"تَشْتَرُوا۟","exchange","كَافِرٍۭ بِهِۦ ۖ وَلَا","بِـَٔايَـٰتِى ثَمَنًۭا قَلِيلًۭا",498],["2:79:12",12,"لِيَشْتَرُوا۟","to barter","مِنْ عِندِ ٱللَّهِ","بِهِۦ ثَمَنًۭا قَلِيلًۭا ۖ",498],["2:86:3",13,"ٱشْتَرَوُا۟","bought","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","ٱلْحَيَوٰةَ ٱلدُّنْيَا بِٱلْـَٔاخِرَةِ ۖ",498],["2:90:2",14,"ٱشْتَرَوْا۟","(for) which they have sold","بِئْسَمَا","بِهِۦٓ أَنفُسَهُمْ أَن",498],["2:102:60",16,"ٱشْتَرَىٰهُ","buys it","وَلَقَدْ عَلِمُوا۟ لَمَنِ","مَا لَهُۥ فِى",498],["2:102:69",16,"شَرَوْا۟","they sold","خَلَـٰقٍۢ ۚ وَلَبِئْسَ مَا","بِهِۦٓ أَنفُسَهُمْ ۚ لَوْ",1454],["2:174:9",26,"وَيَشْتَرُونَ","and they purchase","ٱللَّهُ مِنَ ٱلْكِتَـٰبِ","بِهِۦ ثَمَنًۭا قَلِيلًا ۙ",498],["2:175:3",26,"ٱشْتَرَوُا۟","purchase[d]","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","ٱلضَّلَـٰلَةَ بِٱلْهُدَىٰ وَٱلْعَذَابَ",498],["2:207:4",32,"يَشْرِى","sells","وَمِنَ ٱلنَّاسِ مَن","نَفْسَهُ ٱبْتِغَآءَ مَرْضَاتِ",1454],["3:77:3",59,"يَشْتَرُونَ","exchange","إِنَّ ٱلَّذِينَ","بِعَهْدِ ٱللَّهِ وَأَيْمَـٰنِهِمْ",498],["3:177:3",73,"ٱشْتَرَوُا۟","(have) purchased","إِنَّ ٱلَّذِينَ","ٱلْكُفْرَ بِٱلْإِيمَـٰنِ لَن",498],["3:187:15",75,"وَٱشْتَرَوْا۟","and they exchanged","فَنَبَذُوهُ وَرَآءَ ظُهُورِهِمْ","بِهِۦ ثَمَنًۭا قَلِيلًۭا ۖ",498],["3:187:21",75,"يَشْتَرُونَ","they purchase","قَلِيلًۭا ۖ فَبِئْسَ مَا","",498],["3:199:17",76,"يَشْتَرُونَ","(do) they exchange","خَـٰشِعِينَ لِلَّهِ لَا","بِـَٔايَـٰتِ ٱللَّهِ ثَمَنًۭا",498],["4:44:9",85,"يَشْتَرُونَ","purchasing","نَصِيبًۭا مِّنَ ٱلْكِتَـٰبِ","ٱلضَّلَـٰلَةَ وَيُرِيدُونَ أَن",498],["4:74:6",89,"يَشْرُونَ","sell","سَبِيلِ ٱللَّهِ ٱلَّذِينَ","ٱلْحَيَوٰةَ ٱلدُّنْيَا بِٱلْـَٔاخِرَةِ ۚ",1454],["5:44:29",115,"تَشْتَرُوا۟","sell","ٱلنَّاسَ وَٱخْشَوْنِ وَلَا","بِـَٔايَـٰتِى ثَمَنًۭا قَلِيلًۭا ۚ",498],["5:106:37",125,"نَشْتَرِى","we will exchange","إِنِ ٱرْتَبْتُمْ لَا","بِهِۦ ثَمَنًۭا وَلَوْ",498],["9:9:1",188,"ٱشْتَرَوْا۟","They exchange","","بِـَٔايَـٰتِ ٱللَّهِ ثَمَنًۭا",498],["9:111:3",204,"ٱشْتَرَىٰ","(has) purchased","۞ إِنَّ ٱللَّهَ","مِنَ ٱلْمُؤْمِنِينَ أَنفُسَهُمْ",498],["12:20:1",237,"وَشَرَوْهُ","And they sold him","","بِثَمَنٍۭ بَخْسٍۢ دَرَٰهِمَ",1454],["12:21:3",237,"ٱشْتَرَىٰهُ","bought him","وَقَالَ ٱلَّذِى","مِن مِّصْرَ لِٱمْرَأَتِهِۦٓ",498],["16:95:2",278,"تَشْتَرُوا۟","exchange","وَلَا","بِعَهْدِ ٱللَّهِ ثَمَنًۭا",498],["31:6:4",411,"يَشْتَرِى","purchases","وَمِنَ ٱلنَّاسِ مَن","لَهْوَ ٱلْحَدِيثِ لِيُضِلَّ",498]]