[["3:26:9",53,"وَتَنزِعُ","and You take away","ٱلْمُلْكَ مَن تَشَآءُ","ٱلْمُلْكَ مِمَّن تَشَآءُ",854],["3:152:11",69,"وَتَنَـٰزَعْتُمْ","and you fell into dispute","حَتَّىٰٓ إِذَا فَشِلْتُمْ","فِى ٱلْأَمْرِ وَعَصَيْتُم",1107],["4:59:12",87,"تَنَـٰزَعْتُمْ","you disagree","ٱلْأَمْرِ مِنكُمْ ۖ فَإِن","فِى شَىْءٍۢ فَرُدُّوهُ",1107],["7:27:11",153,"يَنزِعُ","stripping","أَبَوَيْكُم مِّنَ ٱلْجَنَّةِ","عَنْهُمَا لِبَاسَهُمَا لِيُرِيَهُمَا",854],["7:43:1",155,"وَنَزَعْنَا","And We will remove","","مَا فِى صُدُورِهِم",854],["7:108:1",164,"وَنَزَعَ","And he drew out","","يَدَهُۥ فَإِذَا هِىَ",854],["8:43:11",182,"وَلَتَنَـٰزَعْتُمْ","and surely you would have disputed","أَرَىٰكَهُمْ كَثِيرًۭا لَّفَشِلْتُمْ","فِى ٱلْأَمْرِ وَلَـٰكِنَّ",1107],["8:46:5",183,"تَنَـٰزَعُوا۟","dispute","ٱللَّهَ وَرَسُولَهُۥ وَلَا","فَتَفْشَلُوا۟ وَتَذْهَبَ رِيحُكُمْ ۖ",1107],["11:9:7",222,"نَزَعْنَـٰهَا","We withdraw it","مِنَّا رَحْمَةًۭ ثُمَّ","مِنْهُ إِنَّهُۥ لَيَـُٔوسٌۭ",854],["15:47:1",264,"وَنَزَعْنَا","And We (will) remove","","مَا فِى صُدُورِهِم",854],["18:21:15",296,"يَتَنَـٰزَعُونَ","they disputed","رَيْبَ فِيهَآ إِذْ","بَيْنَهُمْ أَمْرَهُمْ ۖ فَقَالُوا۟",1107],["19:69:2",310,"لَنَنزِعَنَّ","surely, We will drag out","ثُمَّ","مِن كُلِّ شِيعَةٍ",854],["20:62:1",315,"فَتَنَـٰزَعُوٓا۟","Then they disputed","","أَمْرَهُم بَيْنَهُمْ وَأَسَرُّوا۟",1107],["22:67:8",340,"يُنَـٰزِعُنَّكَ","So let them not dispute with you","هُمْ نَاسِكُوهُ ۖ فَلَا","فِى ٱلْأَمْرِ ۚ وَٱدْعُ",4727],["26:33:1",368,"وَنَزَعَ","And he drew out","","يَدَهُۥ فَإِذَا هِىَ",854],["28:75:1",394,"وَنَزَعْنَا","And We will draw forth","","مِن كُلِّ أُمَّةٍۢ",854],["52:23:1",524,"يَتَنَـٰزَعُونَ","They will pass to one another","","فِيهَا كَأْسًۭا لَّا",1107],["54:20:1",529,"تَنزِعُ","Plucking out","","ٱلنَّاسَ كَأَنَّهُمْ أَعْجَازُ",854],["70:16:1",569,"نَزَّاعَةًۭ","A remover","","لِّلشَّوَىٰ",4056],["79:1:1",583,"وَٱلنَّـٰزِعَـٰتِ","By those who extract","","غَرْقًۭا",4085]]