[["11:75:5",230,"مُّنِيبٌۭ","and oft-returning","إِبْرَٰهِيمَ لَحَلِيمٌ أَوَّٰهٌۭ","",1090],["11:88:35",231,"أُنِيبُ","I turn","عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ","",763],["13:27:19",252,"أَنَابَ","turns back","وَيَهْدِىٓ إِلَيْهِ مَنْ","",763],["30:31:1",407,"۞ مُنِيبِينَ","Turning","","إِلَيْهِ وَٱتَّقُوهُ وَأَقِيمُوا۟",1090],["30:33:7",408,"مُّنِيبِينَ","turning","ضُرٌّۭ دَعَوْا۟ رَبَّهُم","إِلَيْهِ ثُمَّ إِذَآ",1090],["31:15:21",412,"أَنَابَ","turns","وَٱتَّبِعْ سَبِيلَ مَنْ","إِلَىَّ ۚ ثُمَّ إِلَىَّ",763],["34:9:29",429,"مُّنِيبٍۢ","who turns (to Allah)","لَـَٔايَةًۭ لِّكُلِّ عَبْدٍۢ","",1090],["38:24:32",454,"وَأَنَابَ ۩","and turned in repentance","رَبَّهُۥ وَخَرَّ رَاكِعًۭا","",763],["38:34:9",455,"أَنَابَ","he turned","كُرْسِيِّهِۦ جَسَدًۭا ثُمَّ","",763],["39:8:7",459,"مُنِيبًا","turning","ضُرٌّۭ دَعَا رَبَّهُۥ","إِلَيْهِ ثُمَّ إِذَا",1090],["39:17:6",460,"وَأَنَابُوٓا۟","and turn","ٱلطَّـٰغُوتَ أَن يَعْبُدُوهَا","إِلَى ٱللَّهِ لَهُمُ",763],["39:54:1",464,"وَأَنِيبُوٓا۟","And turn","","إِلَىٰ رَبِّكُمْ وَأَسْلِمُوا۟",763],["40:13:14",468,"يُنِيبُ","turns","يَتَذَكَّرُ إِلَّا مَن","",763],["42:10:15",483,"أُنِيبُ","I turn","عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ","",763],["42:13:38",484,"يُنِيبُ","turns","وَيَهْدِىٓ إِلَيْهِ مَن","",763],["50:8:5",518,"مُّنِيبٍۢ","who turns","وَذِكْرَىٰ لِكُلِّ عَبْدٍۢ","",1090],["50:33:7",519,"مُّنِيبٍ","returning","بِٱلْغَيْبِ وَجَآءَ بِقَلْبٍۢ","",1090],["60:4:50",549,"أَنَبْنَا","we turn","عَلَيْكَ تَوَكَّلْنَا وَإِلَيْكَ","وَإِلَيْكَ ٱلْمَصِيرُ",763]]