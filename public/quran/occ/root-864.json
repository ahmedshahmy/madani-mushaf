[["9:40:15",193,"ٱلْغَارِ","the cave","إِذْ هُمَا فِى","إِذْ يَقُولُ لِصَـٰحِبِهِۦ",3450],["9:57:5",196,"مَغَـٰرَٰتٍ","caves","يَجِدُونَ مَلْجَـًٔا أَوْ","أَوْ مُدَّخَلًۭا لَّوَلَّوْا۟",3661],["18:41:4",298,"غَوْرًۭا","sunken","أَوْ يُصْبِحَ مَآؤُهَا","فَلَن تَسْتَطِيعَ لَهُۥ",2376],["67:30:6",564,"غَوْرًۭا","sunken","إِنْ أَصْبَحَ مَآؤُكُمْ","فَمَن يَأْتِيكُم بِمَآءٍۢ",2376]]