[["2:233:2",37,"يُرْضِعْنَ","shall suckle","۞ وَٱلْوَٰلِدَٰتُ","أَوْلَـٰدَهُنَّ حَوْلَيْنِ كَامِلَيْنِ ۖ",4732],["2:233:10",37,"ٱلرَّضَاعَةَ ۚ","the suckling","أَرَادَ أَن يُتِمَّ","وَعَلَى ٱلْمَوْلُودِ لَهُۥ",2611],["2:233:47",37,"تَسْتَرْضِعُوٓا۟","ask another women to suckle","وَإِنْ أَرَدتُّمْ أَن","أَوْلَـٰدَكُمْ فَلَا جُنَاحَ",4422],["4:23:14",81,"أَرْضَعْنَكُمْ","nursed you","ٱلْأُخْتِ وَأُمَّهَـٰتُكُمُ ٱلَّـٰتِىٓ","وَأَخَوَٰتُكُم مِّنَ ٱلرَّضَـٰعَةِ",1277],["4:23:17",81,"ٱلرَّضَـٰعَةِ","the nursing","أَرْضَعْنَكُمْ وَأَخَوَٰتُكُم مِّنَ","وَأُمَّهَـٰتُ نِسَآئِكُمْ وَرَبَـٰٓئِبُكُمُ",2611],["22:2:5",332,"مُرْضِعَةٍ","nursing mother","تَرَوْنَهَا تَذْهَلُ كُلُّ","عَمَّآ أَرْضَعَتْ وَتَضَعُ",3842],["22:2:7",332,"أَرْضَعَتْ","she was nursing","كُلُّ مُرْضِعَةٍ عَمَّآ","وَتَضَعُ كُلُّ ذَاتِ",1277],["28:7:6",386,"أَرْضِعِيهِ ۖ","Suckle him","أُمِّ مُوسَىٰٓ أَنْ","فَإِذَا خِفْتِ عَلَيْهِ",1277],["28:12:3",386,"ٱلْمَرَاضِعَ","the wet nurses","۞ وَحَرَّمْنَا عَلَيْهِ","مِن قَبْلُ فَقَالَتْ",3698],["65:6:21",559,"أَرْضَعْنَ","they suckle","يَضَعْنَ حَمْلَهُنَّ ۚ فَإِنْ","لَكُمْ فَـَٔاتُوهُنَّ أُجُورَهُنَّ ۖ",1277],["65:6:30",559,"فَسَتُرْضِعُ","then may suckle","بِمَعْرُوفٍۢ ۖ وَإِن تَعَاسَرْتُمْ","لَهُۥٓ أُخْرَىٰ",1277]]