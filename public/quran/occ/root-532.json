[["2:184:9",28,"سَفَرٍۢ","a journey","مَّرِيضًا أَوْ عَلَىٰ","فَعِدَّةٌۭ مِّنْ أَيَّامٍ",1101],["2:185:23",28,"سَفَرٍۢ","a journey","مَرِيضًا أَوْ عَلَىٰ","فَعِدَّةٌۭ مِّنْ أَيَّامٍ",1101],["2:283:4",49,"سَفَرٍۢ","a journey","۞ وَإِن كُنتُمْ عَلَىٰ","وَلَمْ تَجِدُوا۟ كَاتِبًۭا",1101],["4:43:25",85,"سَفَرٍ","a journey","مَّرْضَىٰٓ أَوْ عَلَىٰ","أَوْ جَآءَ أَحَدٌۭ",1101],["5:6:27",108,"سَفَرٍ","a journey","مَّرْضَىٰٓ أَوْ عَلَىٰ","أَوْ جَآءَ أَحَدٌۭ",1101],["9:42:5",194,"وَسَفَرًۭا","and a journey","كَانَ عَرَضًۭا قَرِيبًۭا","قَاصِدًۭا لَّٱتَّبَعُوكَ وَلَـٰكِنۢ",1101],["18:62:10",301,"سَفَرِنَا","our journey","لَقَدْ لَقِينَا مِن","هَـٰذَا نَصَبًۭا",1101],["34:19:5",430,"أَسْفَارِنَا","our journeys","رَبَّنَا بَـٰعِدْ بَيْنَ","وَظَلَمُوٓا۟ أَنفُسَهُمْ فَجَعَلْنَـٰهُمْ",2191],["62:5:11",553,"أَسْفَارًۢا ۚ","books","كَمَثَلِ ٱلْحِمَارِ يَحْمِلُ","بِئْسَ مَثَلُ ٱلْقَوْمِ",2191],["74:34:3",576,"أَسْفَرَ","it brightens","وَٱلصُّبْحِ إِذَآ","",3036],["80:15:2",585,"سَفَرَةٍۢ","(of) scribes","بِأَيْدِى","",4247],["80:38:3",585,"مُّسْفِرَةٌۭ","(will be) bright","وُجُوهٌۭ يَوْمَئِذٍۢ","",3989]]