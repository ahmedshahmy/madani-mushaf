[["3:39:11",55,"بِيَحْيَىٰ","of Yahya","أَنَّ ٱللَّهَ يُبَشِّرُكَ","مُصَدِّقًۢا بِكَلِمَةٍۢ مِّنَ",1429],["6:85:2",138,"وَيَحْيَىٰ","and Yahya","وَزَكَرِيَّا","وَعِيسَىٰ وَإِلْيَاسَ ۖ كُلٌّۭ",1429],["19:7:6",305,"يَحْيَىٰ","(will be) Yahya","نُبَشِّرُكَ بِغُلَـٰمٍ ٱسْمُهُۥ","لَمْ نَجْعَل لَّهُۥ",1429],["19:12:1",306,"يَـٰيَحْيَىٰ","O Yahya","","خُذِ ٱلْكِتَـٰبَ بِقُوَّةٍۢ ۖ",1429],["21:90:5",329,"يَحْيَىٰ","Yahya","لَهُۥ وَوَهَبْنَا لَهُۥ","وَأَصْلَحْنَا لَهُۥ زَوْجَهُۥٓ ۚ",1429]]