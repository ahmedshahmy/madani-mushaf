[["11:98:5",233,"فَأَوْرَدَهُمُ","and lead them","قَوْمَهُۥ يَوْمَ ٱلْقِيَـٰمَةِ","ٱلنَّارَ ۖ وَبِئْسَ ٱلْوِرْدُ",3052],["11:98:8",233,"ٱلْوِرْدُ","(is) the place","فَأَوْرَدَهُمُ ٱلنَّارَ ۖ وَبِئْسَ","ٱلْمَوْرُودُ",2720],["11:98:9",233,"ٱلْمَوْرُودُ","to which (they are) led","ٱلنَّارَ ۖ وَبِئْسَ ٱلْوِرْدُ","",3732],["12:19:4",237,"وَارِدَهُمْ","their water drawer","وَجَآءَتْ سَيَّارَةٌۭ فَأَرْسَلُوا۟","فَأَدْلَىٰ دَلْوَهُۥ ۖ قَالَ",2024],["19:71:4",310,"وَارِدُهَا ۚ","(will be) passing over it","وَإِن مِّنكُمْ إِلَّا","كَانَ عَلَىٰ رَبِّكَ",2024],["19:86:5",311,"وِرْدًۭا","thirsty","ٱلْمُجْرِمِينَ إِلَىٰ جَهَنَّمَ","",2720],["21:98:11",330,"وَٰرِدُونَ","will come","جَهَنَّمَ أَنتُمْ لَهَا","",2024],["21:99:6",330,"وَرَدُوهَا ۖ","they (would) have come to it","هَـٰٓؤُلَآءِ ءَالِهَةًۭ مَّا","وَكُلٌّۭ فِيهَا خَـٰلِدُونَ",2714],["28:23:2",388,"وَرَدَ","he came","وَلَمَّا","مَآءَ مَدْيَنَ وَجَدَ",2714],["50:16:14",519,"ٱلْوَرِيدِ","(his) jugular vein","إِلَيْهِ مِنْ حَبْلِ","",4535],["55:37:5",532,"وَرْدَةًۭ","rose-colored","ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ","كَٱلدِّهَانِ",4536]]