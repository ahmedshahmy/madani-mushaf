[["2:218:6",34,"وَجَـٰهَدُوا۟","and strove","ءَامَنُوا۟ وَٱلَّذِينَ هَاجَرُوا۟","فِى سَبِيلِ ٱللَّهِ",400],["3:142:10",68,"جَـٰهَدُوا۟","strove hard","يَعْلَمِ ٱللَّهُ ٱلَّذِينَ","مِنكُمْ وَيَعْلَمَ ٱلصَّـٰبِرِينَ",400],["4:95:9",94,"وَٱلْمُجَـٰهِدُونَ","and the ones who strive","غَيْرُ أُو۟لِى ٱلضَّرَرِ","فِى سَبِيلِ ٱللَّهِ",1591],["4:95:17",94,"ٱلْمُجَـٰهِدِينَ","the ones who strive","وَأَنفُسِهِمْ ۚ فَضَّلَ ٱللَّهُ","بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ عَلَى",1591],["4:95:29",94,"ٱلْمُجَـٰهِدِينَ","the ones who strive","ٱلْحُسْنَىٰ ۚ وَفَضَّلَ ٱللَّهُ","عَلَى ٱلْقَـٰعِدِينَ أَجْرًا",1591],["5:35:9",113,"وَجَـٰهِدُوا۟","and strive hard","وَٱبْتَغُوٓا۟ إِلَيْهِ ٱلْوَسِيلَةَ","فِى سَبِيلِهِۦ لَعَلَّكُمْ",400],["5:53:8",117,"جَهْدَ","strongest","ٱلَّذِينَ أَقْسَمُوا۟ بِٱللَّهِ","أَيْمَـٰنِهِمْ ۙ إِنَّهُمْ لَمَعَكُمْ ۚ",1343],["5:54:21",117,"يُجَـٰهِدُونَ","striving","أَعِزَّةٍ عَلَى ٱلْكَـٰفِرِينَ","فِى سَبِيلِ ٱللَّهِ",400],["6:109:3",141,"جَهْدَ","strongest","وَأَقْسَمُوا۟ بِٱللَّهِ","أَيْمَـٰنِهِمْ لَئِن جَآءَتْهُمْ",1343],["8:72:5",186,"وَجَـٰهَدُوا۟","and strove hard","ٱلَّذِينَ ءَامَنُوا۟ وَهَاجَرُوا۟","بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ فِى",400],["8:74:4",186,"وَجَـٰهَدُوا۟","and strove hard","وَٱلَّذِينَ ءَامَنُوا۟ وَهَاجَرُوا۟","فِى سَبِيلِ ٱللَّهِ",400],["8:75:6",186,"وَجَـٰهَدُوا۟","and strove hard","مِنۢ بَعْدُ وَهَاجَرُوا۟","مَعَكُمْ فَأُو۟لَـٰٓئِكَ مِنكُمْ ۚ",400],["9:16:9",189,"جَـٰهَدُوا۟","strive","يَعْلَمِ ٱللَّهُ ٱلَّذِينَ","مِنكُمْ وَلَمْ يَتَّخِذُوا۟",400],["9:19:12",189,"وَجَـٰهَدَ","and strives","بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ","فِى سَبِيلِ ٱللَّهِ ۚ",400],["9:20:4",189,"وَجَـٰهَدُوا۟","and strove","ٱلَّذِينَ ءَامَنُوا۟ وَهَاجَرُوا۟","فِى سَبِيلِ ٱللَّهِ",400],["9:24:21",190,"وَجِهَادٍۢ","and striving","مِّنَ ٱللَّهِ وَرَسُولِهِۦ","فِى سَبِيلِهِۦ فَتَرَبَّصُوا۟",1562],["9:41:4",194,"وَجَـٰهِدُوا۟","and strive","ٱنفِرُوا۟ خِفَافًۭا وَثِقَالًۭا","بِأَمْوَٰلِكُمْ وَأَنفُسِكُمْ فِى",400],["9:44:9",194,"يُجَـٰهِدُوا۟","they strive","وَٱلْيَوْمِ ٱلْـَٔاخِرِ أَن","بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ ۗ وَٱللَّهُ",400],["9:73:3",199,"جَـٰهِدِ","Strive (against)","يَـٰٓأَيُّهَا ٱلنَّبِىُّ","ٱلْكُفَّارَ وَٱلْمُنَـٰفِقِينَ وَٱغْلُظْ",400],["9:79:12",199,"جُهْدَهُمْ","their effort","لَا يَجِدُونَ إِلَّا","فَيَسْخَرُونَ مِنْهُمْ ۙ سَخِرَ",3546],["9:81:9",200,"يُجَـٰهِدُوا۟","strive","ٱللَّهِ وَكَرِهُوٓا۟ أَن","بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ فِى",400],["9:86:7",200,"وَجَـٰهِدُوا۟","and strive","أَنْ ءَامِنُوا۟ بِٱللَّهِ","مَعَ رَسُولِهِ ٱسْتَـْٔذَنَكَ",400],["9:88:6",201,"جَـٰهَدُوا۟","strove","وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ","بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ ۚ وَأُو۟لَـٰٓئِكَ",400],["16:38:3",271,"جَهْدَ","strongest","وَأَقْسَمُوا۟ بِٱللَّهِ","أَيْمَـٰنِهِمْ ۙ لَا يَبْعَثُ",1343],["16:110:11",279,"جَـٰهَدُوا۟","strove hard","مَا فُتِنُوا۟ ثُمَّ","وَصَبَرُوٓا۟ إِنَّ رَبَّكَ",400],["22:78:1",341,"وَجَـٰهِدُوا۟","And strive","","فِى ٱللَّهِ حَقَّ",400],["22:78:5",341,"جِهَادِهِۦ ۚ","(with the) striving due (to) Him","فِى ٱللَّهِ حَقَّ","هُوَ ٱجْتَبَىٰكُمْ وَمَا",1562],["24:53:3",356,"جَهْدَ","strong","۞ وَأَقْسَمُوا۟ بِٱللَّهِ","أَيْمَـٰنِهِمْ لَئِنْ أَمَرْتَهُمْ",1343],["25:52:4",364,"وَجَـٰهِدْهُم","and strive (against) them","فَلَا تُطِعِ ٱلْكَـٰفِرِينَ","بِهِۦ جِهَادًۭا كَبِيرًۭا",400],["25:52:6",364,"جِهَادًۭا","a striving","ٱلْكَـٰفِرِينَ وَجَـٰهِدْهُم بِهِۦ","كَبِيرًۭا",1562],["29:6:2",396,"جَـٰهَدَ","strives","وَمَن","فَإِنَّمَا يُجَـٰهِدُ لِنَفْسِهِۦٓ ۚ",400],["29:6:4",396,"يُجَـٰهِدُ","he strives","وَمَن جَـٰهَدَ فَإِنَّمَا","لِنَفْسِهِۦٓ ۚ إِنَّ ٱللَّهَ",400],["29:8:6",397,"جَـٰهَدَاكَ","they both strive against you","بِوَٰلِدَيْهِ حُسْنًۭا ۖ وَإِن","لِتُشْرِكَ بِى مَا",400],["29:69:2",404,"جَـٰهَدُوا۟","strive","وَٱلَّذِينَ","فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا ۚ",400],["31:15:2",412,"جَـٰهَدَاكَ","they strive against you","وَإِن","عَلَىٰٓ أَن تُشْرِكَ",400],["35:42:3",439,"جَهْدَ","(the) strongest","وَأَقْسَمُوا۟ بِٱللَّهِ","أَيْمَـٰنِهِمْ لَئِن جَآءَهُمْ",1343],["47:31:4",510,"ٱلْمُجَـٰهِدِينَ","those who strive","وَلَنَبْلُوَنَّكُمْ حَتَّىٰ نَعْلَمَ","مِنكُمْ وَٱلصَّـٰبِرِينَ وَنَبْلُوَا۟",1591],["49:15:10",517,"وَجَـٰهَدُوا۟","but strive","ثُمَّ لَمْ يَرْتَابُوا۟","بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ فِى",400],["60:1:28",549,"جِهَـٰدًۭا","(to) strive","إِن كُنتُمْ خَرَجْتُمْ","فِى سَبِيلِى وَٱبْتِغَآءَ",1562],["61:11:4",552,"وَتُجَـٰهِدُونَ","and strive","تُؤْمِنُونَ بِٱللَّهِ وَرَسُولِهِۦ","فِى سَبِيلِ ٱللَّهِ",400],["66:9:3",561,"جَـٰهِدِ","Strive","يَـٰٓأَيُّهَا ٱلنَّبِىُّ","ٱلْكُفَّارَ وَٱلْمُنَـٰفِقِينَ وَٱغْلُظْ",400]]