[["6:112:13",142,"زُخْرُفَ","(with) decorative","بَعْضُهُمْ إِلَىٰ بَعْضٍۢ","ٱلْقَوْلِ غُرُورًۭا ۚ وَلَوْ",1689],["10:24:21",211,"زُخْرُفَهَا","its adornment","إِذَآ أَخَذَتِ ٱلْأَرْضُ","وَٱزَّيَّنَتْ وَظَنَّ أَهْلُهَآ",1689],["17:93:6",291,"زُخْرُفٍ","ornament","لَكَ بَيْتٌۭ مِّن","أَوْ تَرْقَىٰ فِى",1689],["43:35:1",492,"وَزُخْرُفًۭا ۚ","And ornaments of gold","","وَإِن كُلُّ ذَٰلِكَ",1689]]