[["2:59:1",9,"فَبَدَّلَ","But changed","","ٱلَّذِينَ ظَلَمُوا۟ قَوْلًا",453],["2:61:24",9,"أَتَسْتَبْدِلُونَ","Would you exchange","وَعَدَسِهَا وَبَصَلِهَا ۖ قَالَ","ٱلَّذِى هُوَ أَدْنَىٰ",2067],["2:108:12",17,"يَتَبَدَّلِ","exchanges","مِن قَبْلُ ۗ وَمَن","ٱلْكُفْرَ بِٱلْإِيمَـٰنِ فَقَدْ",2072],["2:181:2",27,"بَدَّلَهُۥ","changes it","فَمَنۢ","بَعْدَ مَا سَمِعَهُۥ فَإِنَّمَآ",453],["2:181:9",27,"يُبَدِّلُونَهُۥٓ ۚ","alter it","إِثْمُهُۥ عَلَى ٱلَّذِينَ","إِنَّ ٱللَّهَ سَمِيعٌ",453],["2:211:10",33,"يُبَدِّلْ","changes","ءَايَةٍۭ بَيِّنَةٍۢ ۗ وَمَن","نِعْمَةَ ٱللَّهِ مِنۢ",453],["4:2:5",77,"تَتَبَدَّلُوا۟","exchange","ٱلْيَتَـٰمَىٰٓ أَمْوَٰلَهُمْ ۖ وَلَا","ٱلْخَبِيثَ بِٱلطَّيِّبِ ۖ وَلَا",2072],["4:20:3",81,"ٱسْتِبْدَالَ","replacing","وَإِنْ أَرَدتُّمُ","زَوْجٍۢ مَّكَانَ زَوْجٍۢ",4840],["4:56:11",87,"بَدَّلْنَـٰهُمْ","We will change their","كُلَّمَا نَضِجَتْ جُلُودُهُم","جُلُودًا غَيْرَهَا لِيَذُوقُوا۟",453],["6:34:15",131,"مُبَدِّلَ","one (can) alter","أَتَىٰهُمْ نَصْرُنَا ۚ وَلَا","لِكَلِمَـٰتِ ٱللَّهِ ۚ وَلَقَدْ",1905],["6:115:7",142,"مُبَدِّلَ","one can change","صِدْقًۭا وَعَدْلًۭا ۚ لَّا","لِكَلِمَـٰتِهِۦ ۚ وَهُوَ ٱلسَّمِيعُ",1905],["7:95:2",162,"بَدَّلْنَا","We changed","ثُمَّ","مَكَانَ ٱلسَّيِّئَةِ ٱلْحَسَنَةَ",453],["7:162:1",171,"فَبَدَّلَ","But changed","","ٱلَّذِينَ ظَلَمُوا۟ مِنْهُمْ",453],["9:39:6",193,"وَيَسْتَبْدِلْ","and will replace you","يُعَذِّبْكُمْ عَذَابًا أَلِيمًۭا","قَوْمًا غَيْرَكُمْ وَلَا",2067],["10:15:16",210,"بَدِّلْهُ ۚ","change it","غَيْرِ هَـٰذَآ أَوْ","قُلْ مَا يَكُونُ",453],["10:15:22",210,"أُبَدِّلَهُۥ","I change it","يَكُونُ لِىٓ أَنْ","مِن تِلْقَآئِ نَفْسِىٓ ۖ",453],["10:64:9",216,"تَبْدِيلَ","change","وَفِى ٱلْـَٔاخِرَةِ ۚ لَا","لِكَلِمَـٰتِ ٱللَّهِ ۚ ذَٰلِكَ",1106],["14:28:5",259,"بَدَّلُوا۟","(have) changed","تَرَ إِلَى ٱلَّذِينَ","نِعْمَتَ ٱللَّهِ كُفْرًۭا",453],["14:48:2",261,"تُبَدَّلُ","will be changed","يَوْمَ","ٱلْأَرْضُ غَيْرَ ٱلْأَرْضِ",453],["16:101:2",278,"بَدَّلْنَآ","We substitute","وَإِذَا","ءَايَةًۭ مَّكَانَ ءَايَةٍۢ ۙ",453],["18:27:9",296,"مُبَدِّلَ","can change","كِتَابِ رَبِّكَ ۖ لَا","لِكَلِمَـٰتِهِۦ وَلَن تَجِدَ",1905],["18:50:26",299,"بَدَلًۭا","(is) the exchange","عَدُوٌّۢ ۚ بِئْسَ لِلظَّـٰلِمِينَ","",3333],["18:81:3",302,"يُبْدِلَهُمَا","would change for them","فَأَرَدْنَآ أَن","رَبُّهُمَا خَيْرًۭا مِّنْهُ",2077],["24:55:22",357,"وَلَيُبَدِّلَنَّهُم","and surely He will change for them","ٱلَّذِى ٱرْتَضَىٰ لَهُمْ","مِّنۢ بَعْدِ خَوْفِهِمْ",453],["25:70:9",366,"يُبَدِّلُ","Allah will replace","عَمَلًۭا صَـٰلِحًۭا فَأُو۟لَـٰٓئِكَ","ٱللَّهُ سَيِّـَٔاتِهِمْ حَسَنَـٰتٍۢ ۗ",453],["27:11:5",377,"بَدَّلَ","substitutes","مَن ظَلَمَ ثُمَّ","حُسْنًۢا بَعْدَ سُوٓءٍۢ",453],["30:30:12",407,"تَبْدِيلَ","change","ٱلنَّاسَ عَلَيْهَا ۚ لَا","لِخَلْقِ ٱللَّهِ ۚ ذَٰلِكَ",1106],["33:23:17",421,"بَدَّلُوا۟","they alter","مَّن يَنتَظِرُ ۖ وَمَا","تَبْدِيلًۭا",453],["33:23:18",421,"تَبْدِيلًۭا","(by) any alteration","يَنتَظِرُ ۖ وَمَا بَدَّلُوا۟","",1106],["33:52:9",425,"تَبَدَّلَ","exchange","بَعْدُ وَلَآ أَن","بِهِنَّ مِنْ أَزْوَٰجٍۢ",2072],["33:62:12",426,"تَبْدِيلًۭا","any change","تَجِدَ لِسُنَّةِ ٱللَّهِ","",1106],["34:16:6",430,"وَبَدَّلْنَـٰهُم","and We changed for them","عَلَيْهِمْ سَيْلَ ٱلْعَرِمِ","بِجَنَّتَيْهِمْ جَنَّتَيْنِ ذَوَاتَىْ",453],["35:43:21",439,"تَبْدِيلًۭا ۖ","any change","تَجِدَ لِسُنَّتِ ٱللَّهِ","وَلَن تَجِدَ لِسُنَّتِ",1106],["40:26:11",470,"يُبَدِّلَ","he will change","إِنِّىٓ أَخَافُ أَن","دِينَكُمْ أَوْ أَن",453],["47:38:23",510,"يَسْتَبْدِلْ","He will replace you","ٱلْفُقَرَآءُ ۚ وَإِن تَتَوَلَّوْا۟","قَوْمًا غَيْرَكُمْ ثُمَّ",2067],["48:15:12",512,"يُبَدِّلُوا۟","change","نَتَّبِعْكُمْ ۖ يُرِيدُونَ أَن","كَلَـٰمَ ٱللَّهِ ۚ قُل",453],["48:23:12",513,"تَبْدِيلًۭا","any change","تَجِدَ لِسُنَّةِ ٱللَّهِ","",1106],["50:29:2",519,"يُبَدَّلُ","will be changed","مَا","ٱلْقَوْلُ لَدَىَّ وَمَآ",453],["56:61:3",536,"نُّبَدِّلَ","We (will) change","عَلَىٰٓ أَن","أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى",453],["66:5:6",560,"يُبْدِلَهُۥٓ","He will substitute for him","إِن طَلَّقَكُنَّ أَن","أَزْوَٰجًا خَيْرًۭا مِّنكُنَّ",2077],["68:32:4",565,"يُبْدِلَنَا","will substitute for us","عَسَىٰ رَبُّنَآ أَن","خَيْرًۭا مِّنْهَآ إِنَّآ",2077],["70:41:3",570,"نُّبَدِّلَ","[We] replace","عَلَىٰٓ أَن","خَيْرًۭا مِّنْهُمْ وَمَا",453],["76:28:7",580,"بَدَّلْنَآ","We can change","أَسْرَهُمْ ۖ وَإِذَا شِئْنَا","أَمْثَـٰلَهُمْ تَبْدِيلًا",453],["76:28:9",580,"تَبْدِيلًا","(with) a change","شِئْنَا بَدَّلْنَآ أَمْثَـٰلَهُمْ","",1106]]