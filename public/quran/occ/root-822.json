[["8:2:7",177,"وَجِلَتْ","feel fear","إِذَا ذُكِرَ ٱللَّهُ","قُلُوبُهُمْ وَإِذَا تُلِيَتْ",2026],["15:52:9",265,"وَجِلُونَ","afraid","قَالَ إِنَّا مِنكُمْ","",4527],["15:53:3",265,"تَوْجَلْ","be afraid","قَالُوا۟ لَا","إِنَّا نُبَشِّرُكَ بِغُلَـٰمٍ",2026],["22:35:5",336,"وَجِلَتْ","fear","إِذَا ذُكِرَ ٱللَّهُ","قُلُوبُهُمْ وَٱلصَّـٰبِرِينَ عَلَىٰ",2026],["23:60:6",346,"وَجِلَةٌ","(are) fearful","مَآ ءَاتَوا۟ وَّقُلُوبُهُمْ","أَنَّهُمْ إِلَىٰ رَبِّهِمْ",4526]]