[["20:10:13",312,"بِقَبَسٍ","a burning brand","لَّعَلِّىٓ ءَاتِيكُم مِّنْهَا","أَوْ أَجِدُ عَلَى",2575],["27:7:14",377,"قَبَسٍۢ","burning","أَوْ ءَاتِيكُم بِشِهَابٍۢ","لَّعَلَّكُمْ تَصْطَلُونَ",2575],["57:13:8",539,"نَقْتَبِسْ","we may acquire","لِلَّذِينَ ءَامَنُوا۟ ٱنظُرُونَا","مِن نُّورِكُمْ قِيلَ",4043]]