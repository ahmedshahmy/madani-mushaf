[["2:6:6",3,"ءَأَنذَرْتَهُمْ","whether you warn them","كَفَرُوا۟ سَوَآءٌ عَلَيْهِمْ","أَمْ لَمْ تُنذِرْهُمْ",264],["2:6:9",3,"تُنذِرْهُمْ","you warn them","ءَأَنذَرْتَهُمْ أَمْ لَمْ","لَا يُؤْمِنُونَ",264],["2:119:5",18,"وَنَذِيرًۭا ۖ","and (as) a warner","أَرْسَلْنَـٰكَ بِٱلْحَقِّ بَشِيرًۭا","وَلَا تُسْـَٔلُ عَنْ",206],["2:213:9",33,"وَمُنذِرِينَ","and (as) warners","ٱللَّهُ ٱلنَّبِيِّـۧنَ مُبَشِّرِينَ","وَأَنزَلَ مَعَهُمُ ٱلْكِتَـٰبَ",633],["2:270:6",46,"نَذَرْتُم","you vow","مِّن نَّفَقَةٍ أَوْ","مِّن نَّذْرٍۢ فَإِنَّ",1608],["2:270:8",46,"نَّذْرٍۢ","vow(s)","أَوْ نَذَرْتُم مِّن","فَإِنَّ ٱللَّهَ يَعْلَمُهُۥ ۗ",2567],["3:35:7",54,"نَذَرْتُ","[I] vowed","عِمْرَٰنَ رَبِّ إِنِّى","لَكَ مَا فِى",1608],["4:165:3",104,"وَمُنذِرِينَ","and warners","رُّسُلًۭا مُّبَشِّرِينَ","لِئَلَّا يَكُونَ لِلنَّاسِ",633],["5:19:19",111,"نَذِيرٍۢ ۖ","a warner","مِنۢ بَشِيرٍۢ وَلَا","فَقَدْ جَآءَكُم بَشِيرٌۭ",206],["5:19:23",111,"وَنَذِيرٌۭ ۗ","and a warner","فَقَدْ جَآءَكُم بَشِيرٌۭ","وَٱللَّهُ عَلَىٰ كُلِّ",206],["6:19:15",130,"لِأُنذِرَكُم","that I may warn you","إِلَىَّ هَـٰذَا ٱلْقُرْءَانُ","بِهِۦ وَمَنۢ بَلَغَ ۚ",264],["6:48:6",133,"وَمُنذِرِينَ ۖ","and (as) warners","ٱلْمُرْسَلِينَ إِلَّا مُبَشِّرِينَ","فَمَنْ ءَامَنَ وَأَصْلَحَ",633],["6:51:1",133,"وَأَنذِرْ","And warn","","بِهِ ٱلَّذِينَ يَخَافُونَ",264],["6:92:9",139,"وَلِتُنذِرَ","so that you may warn","ٱلَّذِى بَيْنَ يَدَيْهِ","أُمَّ ٱلْقُرَىٰ وَمَنْ",264],["6:130:11",144,"وَيُنذِرُونَكُمْ","and warning you","يَقُصُّونَ عَلَيْكُمْ ءَايَـٰتِى","لِقَآءَ يَوْمِكُمْ هَـٰذَا ۚ",264],["7:2:10",151,"لِتُنذِرَ","that you warn","صَدْرِكَ حَرَجٌۭ مِّنْهُ","بِهِۦ وَذِكْرَىٰ لِلْمُؤْمِنِينَ",264],["7:63:10",158,"لِيُنذِرَكُمْ","that he may warn you","عَلَىٰ رَجُلٍۢ مِّنكُمْ","وَلِتَتَّقُوا۟ وَلَعَلَّكُمْ تُرْحَمُونَ",264],["7:69:10",159,"لِيُنذِرَكُمْ ۚ","that he may warn you","عَلَىٰ رَجُلٍۢ مِّنكُمْ","وَٱذْكُرُوٓا۟ إِذْ جَعَلَكُمْ",264],["7:184:10",174,"نَذِيرٌۭ","a warner","إِنْ هُوَ إِلَّا","مُّبِينٌ",206],["7:188:25",175,"نَذِيرٌۭ","a warner","إِنْ أَنَا۠ إِلَّا","وَبَشِيرٌۭ لِّقَوْمٍۢ يُؤْمِنُونَ",206],["9:122:16",206,"وَلِيُنذِرُوا۟","and that they may warn","لِّيَتَفَقَّهُوا۟ فِى ٱلدِّينِ","قَوْمَهُمْ إِذَا رَجَعُوٓا۟",264],["10:2:10",208,"أَنذِرِ","Warn","رَجُلٍۢ مِّنْهُمْ أَنْ","ٱلنَّاسَ وَبَشِّرِ ٱلَّذِينَ",264],["10:73:17",217,"ٱلْمُنذَرِينَ","(of) those who were warned","كَيْفَ كَانَ عَـٰقِبَةُ","",1364],["10:101:10",220,"وَٱلنُّذُرُ","and the warners","وَمَا تُغْنِى ٱلْـَٔايَـٰتُ","عَن قَوْمٍۢ لَّا",206],["11:2:8",221,"نَذِيرٌۭ","a warner","إِنَّنِى لَكُم مِّنْهُ","وَبَشِيرٌۭ",206],["11:12:22",222,"نَذِيرٌۭ ۚ","(are) a warner","مَلَكٌ ۚ إِنَّمَآ أَنتَ","وَٱللَّهُ عَلَىٰ كُلِّ",206],["11:25:8",224,"نَذِيرٌۭ","a warner","قَوْمِهِۦٓ إِنِّى لَكُمْ","مُّبِينٌ",206],["13:7:12",250,"مُنذِرٌۭ ۖ","(are) a warner","رَّبِّهِۦٓ ۗ إِنَّمَآ أَنتَ","وَلِكُلِّ قَوْمٍ هَادٍ",633],["14:44:1",261,"وَأَنذِرِ","And warn","","ٱلنَّاسَ يَوْمَ يَأْتِيهِمُ",264],["14:52:4",261,"وَلِيُنذَرُوا۟","that they may be warned","هَـٰذَا بَلَـٰغٌۭ لِّلنَّاسِ","بِهِۦ وَلِيَعْلَمُوٓا۟ أَنَّمَا",264],["15:89:4",266,"ٱلنَّذِيرُ","a warner","وَقُلْ إِنِّىٓ أَنَا","ٱلْمُبِينُ",206],["16:2:12",267,"أَنذِرُوٓا۟","Warn","مِنْ عِبَادِهِۦٓ أَنْ","أَنَّهُۥ لَآ إِلَـٰهَ",264],["17:105:9",293,"وَنَذِيرًۭا","and a warner","أَرْسَلْنَـٰكَ إِلَّا مُبَشِّرًۭا","",206],["18:2:2",293,"لِّيُنذِرَ","to warn","قَيِّمًۭا","بَأْسًۭا شَدِيدًۭا مِّن",264],["18:4:1",293,"وَيُنذِرَ","And to warn","","ٱلَّذِينَ قَالُوا۟ ٱتَّخَذَ",264],["18:56:6",300,"وَمُنذِرِينَ ۚ","and (as) warners","ٱلْمُرْسَلِينَ إِلَّا مُبَشِّرِينَ","وَيُجَـٰدِلُ ٱلَّذِينَ كَفَرُوا۟",633],["18:56:17",300,"أُنذِرُوا۟","they are warned","وَٱتَّخَذُوٓا۟ ءَايَـٰتِى وَمَآ","هُزُوًۭا",264],["19:26:12",307,"نَذَرْتُ","[I] have vowed","أَحَدًۭا فَقُولِىٓ إِنِّى","لِلرَّحْمَـٰنِ صَوْمًۭا فَلَنْ",1608],["19:39:1",308,"وَأَنذِرْهُمْ","And warn them","","يَوْمَ ٱلْحَسْرَةِ إِذْ",264],["19:97:7",312,"وَتُنذِرَ","and warn","لِتُبَشِّرَ بِهِ ٱلْمُتَّقِينَ","بِهِۦ قَوْمًۭا لُّدًّۭا",264],["21:45:3",326,"أُنذِرُكُم","I warn you","قُلْ إِنَّمَآ","بِٱلْوَحْىِ ۚ وَلَا يَسْمَعُ",264],["21:45:11",326,"يُنذَرُونَ","they are warned","ٱلدُّعَآءَ إِذَا مَا","",1608],["22:29:5",335,"نُذُورَهُمْ","their vows","لْيَقْضُوا۟ تَفَثَهُمْ وَلْيُوفُوا۟","وَلْيَطَّوَّفُوا۟ بِٱلْبَيْتِ ٱلْعَتِيقِ",4059],["22:49:7",338,"نَذِيرٌۭ","a warner","إِنَّمَآ أَنَا۠ لَكُمْ","مُّبِينٌۭ",206],["25:1:9",359,"نَذِيرًا","a warner","عَبْدِهِۦ لِيَكُونَ لِلْعَـٰلَمِينَ","",206],["25:7:16",360,"نَذِيرًا","a warner","مَلَكٌۭ فَيَكُونَ مَعَهُۥ","",206],["25:51:7",364,"نَّذِيرًۭا","a warner","فِى كُلِّ قَرْيَةٍۢ","",206],["25:56:5",365,"وَنَذِيرًۭا","and a warner","أَرْسَلْنَـٰكَ إِلَّا مُبَشِّرًۭا","",206],["26:115:4",372,"نَذِيرٌۭ","a warner","إِنْ أَنَا۠ إِلَّا","مُّبِينٌۭ",206],["26:173:6",374,"ٱلْمُنذَرِينَ","(on) those who were warned","مَّطَرًۭا ۖ فَسَآءَ مَطَرُ","",1364],["26:194:5",375,"ٱلْمُنذِرِينَ","the warners","قَلْبِكَ لِتَكُونَ مِنَ","",633],["26:208:7",376,"مُنذِرُونَ","warners","قَرْيَةٍ إِلَّا لَهَا","",633],["26:214:1",376,"وَأَنذِرْ","And warn","","عَشِيرَتَكَ ٱلْأَقْرَبِينَ",264],["27:58:6",382,"ٱلْمُنذَرِينَ","(on) those who were warned","مَّطَرًۭا ۖ فَسَآءَ مَطَرُ","",1364],["27:92:15",385,"ٱلْمُنذِرِينَ","the warners","إِنَّمَآ أَنَا۠ مِنَ","",633],["28:46:11",391,"لِتُنذِرَ","so that you warn","رَّحْمَةًۭ مِّن رَّبِّكَ","قَوْمًۭا مَّآ أَتَىٰهُم",264],["28:46:16",391,"نَّذِيرٍۢ","warner","مَّآ أَتَىٰهُم مِّن","مِّن قَبْلِكَ لَعَلَّهُمْ",206],["29:50:15",402,"نَذِيرٌۭ","a warner","ٱللَّهِ وَإِنَّمَآ أَنَا۠","مُّبِينٌ",206],["32:3:9",415,"لِتُنذِرَ","that you may warn","ٱلْحَقُّ مِن رَّبِّكَ","قَوْمًۭا مَّآ أَتَىٰهُم",264],["32:3:14",415,"نَّذِيرٍۢ","warner","مَّآ أَتَىٰهُم مِّن","مِّن قَبْلِكَ لَعَلَّهُمْ",206],["33:45:7",424,"وَنَذِيرًۭا","and (as) a warner","أَرْسَلْنَـٰكَ شَـٰهِدًۭا وَمُبَشِّرًۭا","",206],["34:28:7",431,"وَنَذِيرًۭا","and (as) a warner","كَآفَّةًۭ لِّلنَّاسِ بَشِيرًۭا","وَلَـٰكِنَّ أَكْثَرَ ٱلنَّاسِ",206],["34:34:6",432,"نَّذِيرٍ","warner","فِى قَرْيَةٍۢ مِّن","إِلَّا قَالَ مُتْرَفُوهَآ",206],["34:44:11",433,"نَّذِيرٍۢ","warner","إِلَيْهِمْ قَبْلَكَ مِن","",206],["34:46:19",433,"نَذِيرٌۭ","a warner","إِنْ هُوَ إِلَّا","لَّكُم بَيْنَ يَدَىْ",206],["35:18:20",436,"تُنذِرُ","you can warn","ذَا قُرْبَىٰٓ ۗ إِنَّمَا","ٱلَّذِينَ يَخْشَوْنَ رَبَّهُم",264],["35:23:4",437,"نَذِيرٌ","a warner","إِنْ أَنتَ إِلَّا","",206],["35:24:5",437,"وَنَذِيرًۭا ۚ","and (as) a warner","أَرْسَلْنَـٰكَ بِٱلْحَقِّ بَشِيرًۭا","وَإِن مِّنْ أُمَّةٍ",206],["35:24:12",437,"نَذِيرٌۭ","a warner","إِلَّا خَلَا فِيهَا","",206],["35:37:20",438,"ٱلنَّذِيرُ ۖ","the warner","مَن تَذَكَّرَ وَجَآءَكُمُ","فَذُوقُوا۟ فَمَا لِلظَّـٰلِمِينَ",206],["35:42:7",439,"نَذِيرٌۭ","a warner","أَيْمَـٰنِهِمْ لَئِن جَآءَهُمْ","لَّيَكُونُنَّ أَهْدَىٰ مِنْ",206],["35:42:15",439,"نَذِيرٌۭ","a warner","ٱلْأُمَمِ ۖ فَلَمَّا جَآءَهُمْ","مَّا زَادَهُمْ إِلَّا",206],["36:6:1",440,"لِتُنذِرَ","That you may warn","","قَوْمًۭا مَّآ أُنذِرَ",264],["36:6:4",440,"أُنذِرَ","were warned","لِتُنذِرَ قَوْمًۭا مَّآ","ءَابَآؤُهُمْ فَهُمْ غَـٰفِلُونَ",264],["36:10:3",440,"ءَأَنذَرْتَهُمْ","whether you warn them","وَسَوَآءٌ عَلَيْهِمْ","أَمْ لَمْ تُنذِرْهُمْ",264],["36:10:6",440,"تُنذِرْهُمْ","warn them","ءَأَنذَرْتَهُمْ أَمْ لَمْ","لَا يُؤْمِنُونَ",264],["36:11:2",440,"تُنذِرُ","you (can) warn","إِنَّمَا","مَنِ ٱتَّبَعَ ٱلذِّكْرَ",264],["36:70:1",444,"لِّيُنذِرَ","To warn","","مَن كَانَ حَيًّۭا",264],["37:72:4",448,"مُّنذِرِينَ","warners","وَلَقَدْ أَرْسَلْنَا فِيهِم","",633],["37:73:5",448,"ٱلْمُنذَرِينَ","(of) those who were warned","كَيْفَ كَانَ عَـٰقِبَةُ","",1364],["37:177:6",452,"ٱلْمُنذَرِينَ","(for) those who were warned","بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ","",1364],["38:4:4",453,"مُّنذِرٌۭ","a warner","وَعَجِبُوٓا۟ أَن جَآءَهُم","مِّنْهُمْ ۖ وَقَالَ ٱلْكَـٰفِرُونَ",633],["38:65:4",457,"مُنذِرٌۭ ۖ","a warner","قُلْ إِنَّمَآ أَنَا۠","وَمَا مِنْ إِلَـٰهٍ",633],["38:70:7",457,"نَذِيرٌۭ","a warner","إِلَّآ أَنَّمَآ أَنَا۠","مُّبِينٌ",206],["39:71:23",466,