nings","بَـٰلِغَةٌۭ ۖ فَمَا تُغْنِ","",206],["54:16:4",529,"وَنُذُرِ","and My warnings","فَكَيْفَ كَانَ عَذَابِى","",206],["54:18:6",529,"وَنُذُرِ","and My warnings","فَكَيْفَ كَانَ عَذَابِى","",206],["54:21:4",529,"وَنُذُرِ","and My warnings","فَكَيْفَ كَانَ عَذَابِى","",206],["54:23:3",529,"بِٱلنُّذُرِ","the warnings","كَذَّبَتْ ثَمُودُ","",206],["54:30:4",530,"وَنُذُرِ","and My warnings","فَكَيْفَ كَانَ عَذَابِى","",206],["54:33:4",530,"بِٱلنُّذُرِ","the warnings","كَذَّبَتْ قَوْمُ لُوطٍۭ","",206],["54:36:2",530,"أَنذَرَهُم","he warned them","وَلَقَدْ","بَطْشَتَنَا فَتَمَارَوْا۟ بِٱلنُّذُرِ",264],["54:36:5",530,"بِٱلنُّذُرِ","the warnings","أَنذَرَهُم بَطْشَتَنَا فَتَمَارَوْا۟","",206],["54:37:9",530,"وَنُذُرِ","and My warnings","أَعْيُنَهُمْ فَذُوقُوا۟ عَذَابِى","",206],["54:39:3",530,"وَنُذُرِ","and My warnings","فَذُوقُوا۟ عَذَابِى","",206],["54:41:5",530,"ٱلنُّذُرُ","warnings","جَآءَ ءَالَ فِرْعَوْنَ","",206],["67:8:13",562,"نَذِيرٌۭ","a warner","خَزَنَتُهَآ أَلَمْ يَأْتِكُمْ","",206],["67:9:5",562,"نَذِيرٌۭ","a warner","بَلَىٰ قَدْ جَآءَنَا","فَكَذَّبْنَا وَقُلْنَا مَا",206],["67:17:12",563,"نَذِيرِ","(was) My warning","حَاصِبًۭا ۖ فَسَتَعْلَمُونَ كَيْفَ","",206],["67:26:8",563,"نَذِيرٌۭ","a warner","ٱللَّهِ وَإِنَّمَآ أَنَا۠","مُّبِينٌۭ",206],["71:1:7",570,"أَنذِرْ","Warn","إِلَىٰ قَوْمِهِۦٓ أَنْ","قَوْمَكَ مِن قَبْلِ",264],["71:2:5",570,"نَذِيرٌۭ","a warner","يَـٰقَوْمِ إِنِّى لَكُمْ","مُّبِينٌ",206],["74:2:2",575,"فَأَنذِرْ","and warn","قُمْ","",264],["74:36:1",576,"نَذِيرًۭا","A warning","","لِّلْبَشَرِ",206],["76:7:2",579,"بِٱلنَّذْرِ","the vows","يُوفُونَ","وَيَخَافُونَ يَوْمًۭا كَانَ",2567],["77:6:3",580,"نُذْرًا","warning","عُذْرًا أَوْ","",4058],["78:40:2",583,"أَنذَرْنَـٰكُمْ","[We] have warned you","إِنَّآ","عَذَابًۭا قَرِيبًۭا يَوْمَ",264],["79:45:3",584,"مُنذِرُ","(are) a warner","إِنَّمَآ أَنتَ","مَن يَخْشَىٰهَا",633],["92:14:1",596,"فَأَنذَرْتُكُمْ","So I warn you","","نَارًۭا تَلَظَّىٰ",264]]