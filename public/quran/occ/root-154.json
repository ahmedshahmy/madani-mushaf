[["2:255:49",42,"ٱلْعَلِىُّ","(is) the Most High","يَـُٔودُهُۥ حِفْظُهُمَا ۚ وَهُوَ","ٱلْعَظِيمُ",769],["3:61:11",57,"تَعَالَوْا۟","Come","مِنَ ٱلْعِلْمِ فَقُلْ","نَدْعُ أَبْنَآءَنَا وَأَبْنَآءَكُمْ",1001],["3:64:4",58,"تَعَالَوْا۟","Come","قُلْ يَـٰٓأَهْلَ ٱلْكِتَـٰبِ","إِلَىٰ كَلِمَةٍۢ سَوَآءٍۭ",1001],["3:139:6",67,"ٱلْأَعْلَوْنَ","[the] superior","وَلَا تَحْزَنُوا۟ وَأَنتُمُ","إِن كُنتُم مُّؤْمِنِينَ",2156],["3:167:6",72,"تَعَالَوْا۟","Come","نَافَقُوا۟ ۚ وَقِيلَ لَهُمْ","قَـٰتِلُوا۟ فِى سَبِيلِ",1001],["4:34:39",84,"عَلِيًّۭا","Most High","إِنَّ ٱللَّهَ كَانَ","كَبِيرًۭا",769],["4:61:4",88,"تَعَالَوْا۟","Come","وَإِذَا قِيلَ لَهُمْ","إِلَىٰ مَآ أَنزَلَ",1001],["5:104:4",125,"تَعَالَوْا۟","Come","وَإِذَا قِيلَ لَهُمْ","إِلَىٰ مَآ أَنزَلَ",1001],["6:100:13",140,"وَتَعَـٰلَىٰ","and Exalted","بِغَيْرِ عِلْمٍۢ ۚ سُبْحَـٰنَهُۥ","عَمَّا يَصِفُونَ",520],["6:151:2",148,"تَعَالَوْا۟","Come","۞ قُلْ","أَتْلُ مَا حَرَّمَ",1001],["7:190:9",175,"فَتَعَـٰلَى","But exalted","شُرَكَآءَ فِيمَآ ءَاتَىٰهُمَا ۚ","ٱللَّهُ عَمَّا يُشْرِكُونَ",520],["9:40:40",193,"ٱلْعُلْيَا ۗ","the highest","وَكَلِمَةُ ٱللَّهِ هِىَ","وَٱللَّهُ عَزِيزٌ حَكِيمٌ",1770],["10:18:27",210,"وَتَعَـٰلَىٰ","and Exalted","فِى ٱلْأَرْضِ ۚ سُبْحَـٰنَهُۥ","عَمَّا يُشْرِكُونَ",520],["10:83:17",218,"لَعَالٍۢ","(was) a tyrant","يَفْتِنَهُمْ ۚ وَإِنَّ فِرْعَوْنَ","فِى ٱلْأَرْضِ وَإِنَّهُۥ",3096],["11:82:5",231,"عَـٰلِيَهَا","its upside","جَآءَ أَمْرُنَا جَعَلْنَا","سَافِلَهَا وَأَمْطَرْنَا عَلَيْهَا",1495],["13:9:5",250,"ٱلْمُتَعَالِ","the Most High","ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ ٱلْكَبِيرُ","",3866],["15:74:2",266,"عَـٰلِيَهَا","its highest (part)","فَجَعَلْنَا","سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ",1495],["16:1:7",267,"وَتَعَـٰلَىٰ","and Exalted (is) He","فَلَا تَسْتَعْجِلُوهُ ۚ سُبْحَـٰنَهُۥ","عَمَّا يُشْرِكُونَ",520],["16:3:5",267,"تَعَـٰلَىٰ","Exalted is He","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ ۚ","عَمَّا يُشْرِكُونَ",520],["16:60:9",273,"ٱلْأَعْلَىٰ ۚ","the Highest","ٱلسَّوْءِ ۖ وَلِلَّهِ ٱلْمَثَلُ","وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ",874],["17:4:11",282,"وَلَتَعْلُنَّ","and surely you will reach","فِى ٱلْأَرْضِ مَرَّتَيْنِ","عُلُوًّۭا كَبِيرًۭا",520],["17:4:12",282,"عُلُوًّۭا","haughtiness","ٱلْأَرْضِ مَرَّتَيْنِ وَلَتَعْلُنَّ","كَبِيرًۭا",1507],["17:7:22",282,"عَلَوْا۟","they had conquered","مَرَّةٍۢ وَلِيُتَبِّرُوا۟ مَا","تَتْبِيرًا",520],["17:43:2",286,"وَتَعَـٰلَىٰ","and Exalted is He","سُبْحَـٰنَهُۥ","عَمَّا يَقُولُونَ عُلُوًّۭا",520],["17:43:5",286,"عُلُوًّۭا","(by) height","وَتَعَـٰلَىٰ عَمَّا يَقُولُونَ","كَبِيرًۭا",1507],["19:50:9",308,"عَلِيًّۭا","high","لَهُمْ لِسَانَ صِدْقٍ","",769],["19:57:3",309,"عَلِيًّا","high","وَرَفَعْنَـٰهُ مَكَانًا","",769],["20:4:6",312,"ٱلْعُلَى","[the] high","خَلَقَ ٱلْأَرْضَ وَٱلسَّمَـٰوَٰتِ","",1770],["20:64:10",315,"ٱسْتَعْلَىٰ","overcomes","أَفْلَحَ ٱلْيَوْمَ مَنِ","",4827],["20:68:6",316,"ٱلْأَعْلَىٰ","(will be) superior","تَخَفْ إِنَّكَ أَنتَ","",874],["20:75:10",316,"ٱلْعُلَىٰ","[the] high","فَأُو۟لَـٰٓئِكَ لَهُمُ ٱلدَّرَجَـٰتُ","",1770],["20:114:1",320,"فَتَعَـٰلَى","So high (above all)","","ٱللَّهُ ٱلْمَلِكُ ٱلْحَقُّ ۗ",520],["22:62:16",339,"ٱلْعَلِىُّ","(is) the Most High","وَأَنَّ ٱللَّهَ هُوَ","ٱلْكَبِيرُ",769],["23:46:7",345,"عَالِينَ","haughty","فَٱسْتَكْبَرُوا۟ وَكَانُوا۟ قَوْمًا","",2226],["23:91:17",348,"وَلَعَلَا","and surely would have overpowered","إِلَـٰهٍۭ بِمَا خَلَقَ","بَعْضُهُمْ عَلَىٰ بَعْضٍۢ ۚ",520],["23:92:4",348,"فَتَعَـٰلَىٰ","exalted is He","عَـٰلِمِ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ","عَمَّا يُشْرِكُونَ",520],["23:116:1",349,"فَتَعَـٰلَى","So exalted is","","ٱللَّهُ ٱلْمَلِكُ ٱلْحَقُّ ۖ",520],["27:14:6",378,"وَعُلُوًّۭا ۚ","and haughtiness","وَٱسْتَيْقَنَتْهَآ أَنفُسُهُمْ ظُلْمًۭا","فَٱنظُرْ كَيْفَ كَانَ",1507],["27:31:2",379,"تَعْلُوا۟","exalt yourselves","أَلَّا","عَلَىَّ وَأْتُونِى مُسْلِمِينَ",520],["27:63:17",382,"تَعَـٰلَى","High is","أَءِلَـٰهٌۭ مَّعَ ٱللَّهِ ۚ","ٱللَّهُ عَمَّا يُشْرِكُونَ",520],["28:4:3",385,"عَلَا","exalted himself","إِنَّ فِرْعَوْنَ","فِى ٱلْأَرْضِ وَجَعَلَ",520],["28:68:12",393,"وَتَعَـٰلَىٰ","and High is He","ٱلْخِيَرَةُ ۚ سُبْحَـٰنَ ٱللَّهِ","عَمَّا يُشْرِكُونَ",520],["28:83:8",395,"عُلُوًّۭا","exaltedness","لِلَّذِينَ لَا يُرِيدُونَ","فِى ٱلْأَرْضِ وَلَا",1507],["30:27:12",407,"ٱلْأَعْلَىٰ","the highest","عَلَيْهِ ۚ وَلَهُ ٱلْمَثَلُ","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ",874],["30:40:20",408,"وَتَعَـٰلَىٰ","and exalted is He","مِّن شَىْءٍۢ ۚ سُبْحَـٰنَهُۥ","عَمَّا يُشْرِكُونَ",520],["31:30:15",414,"ٱلْعَلِىُّ","(is) the Most High","وَأَنَّ ٱللَّهَ هُوَ","ٱلْكَبِيرُ",769],["33:28:11",421,"فَتَعَالَيْنَ","then come","ٱلْحَيَوٰةَ ٱلدُّنْيَا وَزِينَتَهَا","أُمَتِّعْكُنَّ وَأُسَرِّحْكُنَّ سَرَاحًۭا",1001],["34:23:21",431,"ٱلْعَلِىُّ","(is) the Most High","قَالُوا۟ ٱلْحَقَّ ۖ وَهُوَ","ٱلْكَبِيرُ",769],["37:8:5",446,"ٱلْأَعْلَىٰ","[the] exalted","يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ","وَيُقْذَفُونَ مِن كُلِّ",874],["38:69:7",457,"ٱلْأَعْلَىٰٓ","the exalted","مِنْ عِلْمٍۭ بِٱلْمَلَإِ","إِذْ يَخْتَصِمُونَ",874],["38:75:14",457,"ٱلْعَالِينَ","the exalted ones","أَمْ كُنتَ مِنَ","",2226],["39:67:15",465,"وَتَعَـٰلَىٰ","And High is He","مَطْوِيَّـٰتٌۢ بِيَمِينِهِۦ ۚ سُبْحَـٰنَهُۥ","عَمَّا يُشْرِكُونَ",520],["40:12:14",468,"ٱلْعَلِىِّ","the Most High","تُؤْمِنُوا۟ ۚ فَٱلْحُكْمُ لِلَّهِ","ٱلْكَبِيرِ",769],["42:4:9",483,"ٱلْعَلِىُّ","(is) the Most High","فِى ٱلْأَرْضِ ۖ وَهُوَ","ٱلْعَظِيمُ",769],["42:51:21",488,"عَلِىٌّ","(is) Most High","مَا يَشَآءُ ۚ إِنَّهُۥ","حَكِيمٌۭ",769],["43:4:6",489,"لَعَلِىٌّ","surely exalted","أُمِّ ٱلْكِتَـٰبِ لَدَيْنَا","حَكِيمٌ",769],["44:19:3",497,"تَعْلُوا۟","exalt yourselves","وَأَن لَّا","عَلَى ٱللَّهِ ۖ إِنِّىٓ",520],["44:31:5",497,"عَالِيًۭا","arrogant","فِرْعَوْنَ ۚ إِنَّهُۥ كَانَ","مِّنَ ٱلْمُسْرِفِينَ",1495],["47:35:7",510,"ٱلْأَعْلَوْنَ","(are) superior","إِلَى ٱلسَّلْمِ وَأَنتُمُ","وَٱللَّهُ مَعَكُمْ وَلَن",2156],["53:7:3",526,"ٱلْأَعْلَىٰ","the highest","وَهُوَ بِٱلْأُفُقِ","",874],["63:5:4",555,"تَعَالَوْا۟","Come","وَإِذَا قِيلَ لَهُمْ","يَسْتَغْفِرْ لَكُمْ رَسُولُ",1001],["69:22:3",567,"عَالِيَةٍۢ","elevated","فِى جَنَّةٍ","",2225],["72:3:2",572,"تَعَـٰلَىٰ","Exalted is","وَأَنَّهُۥ","جَدُّ رَبِّنَا مَا",520],["76:21:1",579,"عَـٰلِيَهُمْ","Upon them","","ثِيَابُ سُندُسٍ خُضْرٌۭ",1495],["79:24:4",584,"ٱلْأَعْلَىٰ","the Most High","فَقَالَ أَنَا۠ رَبُّكُمُ","",874],["83:18:6",588,"عِلِّيِّينَ","Illiyin","كِتَـٰبَ ٱلْأَبْرَارِ لَفِى","",2253],["83:19:4",588,"عِلِّيُّونَ","(is) Illiyun","وَمَآ أَدْرَىٰكَ مَا","",2253],["87:1:4",591,"ٱلْأَعْلَى","the Most High","سَبِّحِ ٱسْمَ رَبِّكَ","",874],["88:10:3",592,"عَالِيَةٍۢ","elevated","فِى جَنَّةٍ","",2225],["92:20:5",596,"ٱلْأَعْلَىٰ","the Most High","ٱبْتِغَآءَ وَجْهِ رَبِّهِ","",874]]