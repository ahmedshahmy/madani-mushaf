[["2:124:14",19,"ذُرِّيَّتِى ۖ","my offspring","إِمَامًۭا ۖ قَالَ وَمِن","قَالَ لَا يَنَالُ",379],["2:128:6",20,"ذُرِّيَّتِنَآ","our offspring","مُسْلِمَيْنِ لَكَ وَمِن","أُمَّةًۭ مُّسْلِمَةًۭ لَّكَ",379],["2:266:22",45,"ذُرِّيَّةٌۭ","children","وَأَصَابَهُ ٱلْكِبَرُ وَلَهُۥ","ضُعَفَآءُ فَأَصَابَهَآ إِعْصَارٌۭ",379],["3:34:1",54,"ذُرِّيَّةًۢ","Descendents","","بَعْضُهَا مِنۢ بَعْضٍۢ ۗ",379],["3:36:21",54,"وَذُرِّيَّتَهَا","and her offspring","وَإِنِّىٓ أُعِيذُهَا بِكَ","مِنَ ٱلشَّيْطَـٰنِ ٱلرَّجِيمِ",379],["3:38:11",55,"ذُرِّيَّةًۭ","offspring","لِى مِن لَّدُنكَ","طَيِّبَةً ۖ إِنَّكَ سَمِيعُ",379],["4:9:7",78,"ذُرِّيَّةًۭ","offspring","تَرَكُوا۟ مِنْ خَلْفِهِمْ","ضِعَـٰفًا خَافُوا۟ عَلَيْهِمْ",379],["4:40:6",85,"ذَرَّةٍۢ ۖ","(of) an atom","لَا يَظْلِمُ مِثْقَالَ","وَإِن تَكُ حَسَنَةًۭ",1133],["6:84:12",138,"ذُرِّيَّتِهِۦ","his descendents","مِن قَبْلُ ۖ وَمِن","دَاوُۥدَ وَسُلَيْمَـٰنَ وَأَيُّوبَ",379],["6:87:3",138,"وَذُرِّيَّـٰتِهِمْ","and their descendents","وَمِنْ ءَابَآئِهِمْ","وَإِخْوَٰنِهِمْ ۖ وَٱجْتَبَيْنَـٰهُمْ وَهَدَيْنَـٰهُمْ",1458],["6:133:16",145,"ذُرِّيَّةِ","the descendants","كَمَآ أَنشَأَكُم مِّن","قَوْمٍ ءَاخَرِينَ",379],["7:172:9",173,"ذُرِّيَّتَهُمْ","their descendants","ءَادَمَ مِن ظُهُورِهِمْ","وَأَشْهَدَهُمْ عَلَىٰٓ أَنفُسِهِمْ",379],["7:173:9",173,"ذُرِّيَّةًۭ","descendants","مِن قَبْلُ وَكُنَّا","مِّنۢ بَعْدِهِمْ ۖ أَفَتُهْلِكُنَا",379],["10:61:27",215,"ذَرَّةٍۢ","(of) an atom","رَّبِّكَ مِن مِّثْقَالِ","فِى ٱلْأَرْضِ وَلَا",1133],["10:83:5",218,"ذُرِّيَّةٌۭ","(the) offspring","ءَامَنَ لِمُوسَىٰٓ إِلَّا","مِّن قَوْمِهِۦ عَلَىٰ",379],["13:23:9",252,"وَذُرِّيَّـٰتِهِمْ ۖ","and their offsprings","مِنْ ءَابَآئِهِمْ وَأَزْوَٰجِهِمْ","وَٱلْمَلَـٰٓئِكَةُ يَدْخُلُونَ عَلَيْهِم",1458],["13:38:9",254,"وَذُرِّيَّةًۭ ۚ","and offspring","وَجَعَلْنَا لَهُمْ أَزْوَٰجًۭا","وَمَا كَانَ لِرَسُولٍ",379],["14:37:5",260,"ذُرِّيَّتِى","my offsprings","إِنِّىٓ أَسْكَنتُ مِن","بِوَادٍ غَيْرِ ذِى",379],["14:40:6",260,"ذُرِّيَّتِى ۚ","my offsprings","مُقِيمَ ٱلصَّلَوٰةِ وَمِن","رَبَّنَا وَتَقَبَّلْ دُعَآءِ",379],["17:3:1",282,"ذُرِّيَّةَ","Offsprings","","مَنْ حَمَلْنَا مَعَ",379],["17:62:13",288,"ذُرِّيَّتَهُۥٓ","his offspring","يَوْمِ ٱلْقِيَـٰمَةِ لَأَحْتَنِكَنَّ","إِلَّا قَلِيلًۭا",379],["18:50:17",299,"وَذُرِّيَّتَهُۥٓ","and his offspring","أَمْرِ رَبِّهِۦٓ ۗ أَفَتَتَّخِذُونَهُۥ","أَوْلِيَآءَ مِن دُونِى",379],["19:58:9",309,"ذُرِّيَّةِ","(the) offspring","مِّنَ ٱلنَّبِيِّـۧنَ مِن","ءَادَمَ وَمِمَّنْ حَمَلْنَا",379],["19:58:16",309,"ذُرِّيَّةِ","(the) offspring","مَعَ نُوحٍۢ وَمِن","إِبْرَٰهِيمَ وَإِسْرَٰٓءِيلَ وَمِمَّنْ",379],["25:74:8",366,"وَذُرِّيَّـٰتِنَا","and our offspring","لَنَا مِنْ أَزْوَٰجِنَا","قُرَّةَ أَعْيُنٍۢ وَٱجْعَلْنَا",1458],["29:27:7",399,"ذُرِّيَّتِهِ","his offsprings","وَيَعْقُوبَ وَجَعَلْنَا فِى","ٱلنُّبُوَّةَ وَٱلْكِتَـٰبَ وَءَاتَيْنَـٰهُ",379],["34:3:17",428,"ذَرَّةٍۢ","(of) an atom","يَعْزُبُ عَنْهُ مِثْقَالُ","فِى ٱلسَّمَـٰوَٰتِ وَلَا",1133],["34:22:11",430,"ذَرَّةٍۢ","(of) an atom","لَا يَمْلِكُونَ مِثْقَالَ","فِى ٱلسَّمَـٰوَٰتِ وَلَا",1133],["36:41:5",443,"ذُرِّيَّتَهُمْ","their offspring","لَّهُمْ أَنَّا حَمَلْنَا","فِى ٱلْفُلْكِ ٱلْمَشْحُونِ",379],["37:77:2",449,"ذُرِّيَّتَهُۥ","his offspring","وَجَعَلْنَا","هُمُ ٱلْبَاقِينَ",379],["37:113:6",450,"ذُرِّيَّتِهِمَا","their offspring","وَعَلَىٰٓ إِسْحَـٰقَ ۚ وَمِن","مُحْسِنٌۭ وَظَالِمٌۭ لِّنَفْسِهِۦ",379],["40:8:12",468,"وَذُرِّيَّـٰتِهِمْ ۚ","and their offspring","مِنْ ءَابَآئِهِمْ وَأَزْوَٰجِهِمْ","إِنَّكَ أَنتَ ٱلْعَزِيزُ",1458],["46:15:39",504,"ذُرِّيَّتِىٓ ۖ","my offspring","وَأَصْلِحْ لِى فِى","إِنِّى تُبْتُ إِلَيْكَ",379],["52:21:4",524,"ذُرِّيَّتُهُم","their offspring","وَٱلَّذِينَ ءَامَنُوا۟ وَٱتَّبَعَتْهُمْ","بِإِيمَـٰنٍ أَلْحَقْنَا بِهِمْ",379],["52:21:8",524,"ذُرِّيَّتَهُمْ","their offspring","بِإِيمَـٰنٍ أَلْحَقْنَا بِهِمْ","وَمَآ أَلَتْنَـٰهُم مِّنْ",379],["57:26:7",541,"ذُرِّيَّتِهِمَا","their offspring","وَإِبْرَٰهِيمَ وَجَعَلْنَا فِى","ٱلنُّبُوَّةَ وَٱلْكِتَـٰبَ ۖ فَمِنْهُم",379],["99:7:4",599,"ذَرَّةٍ","(of) an atom","فَمَن يَعْمَلْ مِثْقَالَ","خَيْرًۭا يَرَهُۥ",1133],["99:8:4",599,"ذَرَّةٍۢ","(of) an atom","وَمَن يَعْمَلْ مِثْقَالَ","شَرًّۭا يَرَهُۥ",1133]]