[["2:115:11",18,"وَٰسِعٌ","(is) All-Encompassing","ٱللَّهِ ۚ إِنَّ ٱللَّهَ","عَلِيمٌۭ",929],["2:233:21",37,"وُسْعَهَا ۚ","its capacity","تُكَلَّفُ نَفْسٌ إِلَّا","لَا تُضَآرَّ وَٰلِدَةٌۢ",1412],["2:236:16",38,"ٱلْمُوسِعِ","the wealthy","فَرِيضَةًۭ ۚ وَمَتِّعُوهُنَّ عَلَى","قَدَرُهُۥ وَعَلَى ٱلْمُقْتِرِ",2512],["2:247:23",40,"سَعَةًۭ","abundance","مِنْهُ وَلَمْ يُؤْتَ","مِّنَ ٱلْمَالِ ۚ قَالَ",1227],["2:247:42",40,"وَٰسِعٌ","(is) All-Encompassing","مَن يَشَآءُ ۚ وَٱللَّهُ","عَلِيمٌۭ",929],["2:255:41",42,"وَسِعَ","Extends","إِلَّا بِمَا شَآءَ ۚ","كُرْسِيُّهُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ ۖ",1245],["2:261:23",44,"وَٰسِعٌ","(is) All-Encompassing","لِمَن يَشَآءُ ۗ وَٱللَّهُ","عَلِيمٌ",929],["2:268:12",45,"وَٰسِعٌ","(is) All-Encompassing","مِّنْهُ وَفَضْلًۭا ۗ وَٱللَّهُ","عَلِيمٌۭ",929],["2:286:6",49,"وُسْعَهَا ۚ","its capacity","ٱللَّهُ نَفْسًا إِلَّا","لَهَا مَا كَسَبَتْ",1412],["3:73:31",59,"وَٰسِعٌ","(is) All-Encompassing","مَن يَشَآءُ ۗ وَٱللَّهُ","عَلِيمٌۭ",929],["4:97:20",94,"وَٰسِعَةًۭ","spacious (enough)","تَكُنْ أَرْضُ ٱللَّهِ","فَتُهَاجِرُوا۟ فِيهَا ۚ فَأُو۟لَـٰٓئِكَ",1657],["4:100:11",94,"وَسَعَةًۭ ۚ","and abundance","ٱلْأَرْضِ مُرَٰغَمًۭا كَثِيرًۭا","وَمَن يَخْرُجْ مِنۢ",1227],["4:130:7",99,"سَعَتِهِۦ ۚ","His abundance","ٱللَّهُ كُلًّۭا مِّن","وَكَانَ ٱللَّهُ وَٰسِعًا",1227],["4:130:10",99,"وَٰسِعًا","All-Encompassing","سَعَتِهِۦ ۚ وَكَانَ ٱللَّهُ","حَكِيمًۭا",929],["5:54:36",117,"وَٰسِعٌ","(is) All-Encompassing","مَن يَشَآءُ ۚ وَٱللَّهُ","عَلِيمٌ",929],["6:80:19",137,"وَسِعَ","Encompasses","يَشَآءَ رَبِّى شَيْـًۭٔا ۗ","رَبِّى كُلَّ شَىْءٍ",1245],["6:147:7",148,"وَٰسِعَةٍۢ","Vast","رَّبُّكُمْ ذُو رَحْمَةٍۢ","وَلَا يُرَدُّ بَأْسُهُۥ",1657],["6:152:20",149,"وُسْعَهَا ۖ","(to) its capacity","نُكَلِّفُ نَفْسًا إِلَّا","وَإِذَا قُلْتُمْ فَٱعْدِلُوا۟",1412],["7:42:9",155,"وُسْعَهَآ","(to) its capacity","نُكَلِّفُ نَفْسًا إِلَّا","أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْجَنَّةِ ۖ",1412],["7:89:26",162,"وَسِعَ","Encompasses","يَشَآءَ ٱللَّهُ رَبُّنَا ۚ","رَبُّنَا كُلَّ شَىْءٍ",1245],["7:156:19",170,"وَسِعَتْ","encompasses","مَنْ أَشَآءُ ۖ وَرَحْمَتِى","كُلَّ شَىْءٍۢ ۚ فَسَأَكْتُبُهَا",1245],["20:98:9",318,"وَسِعَ","He has encompassed","إِلَـٰهَ إِلَّا هُوَ ۚ","كُلَّ شَىْءٍ عِلْمًۭا",1245],["23:62:5",346,"وُسْعَهَا ۖ","(to) its capacity","نُكَلِّفُ نَفْسًا إِلَّا","وَلَدَيْنَا كِتَـٰبٌۭ يَنطِقُ",1412],["24:22:6",352,"وَٱلسَّعَةِ","and the amplitude of means","أُو۟لُوا۟ ٱلْفَضْلِ مِنكُمْ","أَن يُؤْتُوٓا۟ أُو۟لِى",1227],["24:32:16",354,"وَٰسِعٌ","(is) All-Encompassing","مِن فَضْلِهِۦ ۗ وَٱللَّهُ","عَلِيمٌۭ",929],["29:56:6",403,"وَٰسِعَةٌۭ","(is) spacious","ءَامَنُوٓا۟ إِنَّ أَرْضِى","فَإِيَّـٰىَ فَٱعْبُدُونِ",1657],["39:10:15",459,"وَٰسِعَةٌ ۗ","(is) spacious","حَسَنَةٌۭ ۗ وَأَرْضُ ٱللَّهِ","إِنَّمَا يُوَفَّى ٱلصَّـٰبِرُونَ",1657],["40:7:15",467,"وَسِعْتَ","You encompass","لِلَّذِينَ ءَامَنُوا۟ رَبَّنَا","كُلَّ شَىْءٍۢ رَّحْمَةًۭ",1245],["51:47:5",522,"لَمُوسِعُونَ","(are) surely (its) Expanders","بَنَيْنَـٰهَا بِأَيْي۟دٍۢ وَإِنَّا","",2512],["53:32:10",527,"وَٰسِعُ","(is) vast","ٱللَّمَمَ ۚ إِنَّ رَبَّكَ","ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ",929],["65:7:3",559,"سَعَةٍۢ","(of) ample means","لِيُنفِقْ ذُو","مِّن سَعَتِهِۦ ۖ وَمَن",1227],["65:7:5",559,"سَعَتِهِۦ ۖ","his ample means","ذُو سَعَةٍۢ مِّن","وَمَن قُدِرَ عَلَيْهِ",1227]]