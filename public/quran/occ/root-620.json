[["2:245:13",39,"يَقْبِضُ","withholds","أَضْعَافًۭا كَثِيرَةًۭ ۚ وَٱللَّهُ","وَيَبْصُۜطُ وَإِلَيْهِ تُرْجَعُونَ",1385],["2:283:9",49,"مَّقْبُوضَةٌۭ ۖ","in hand","تَجِدُوا۟ كَاتِبًۭا فَرِهَـٰنٌۭ","فَإِنْ أَمِنَ بَعْضُكُم",3922],["9:67:11",197,"وَيَقْبِضُونَ","and they close","وَيَنْهَوْنَ عَنِ ٱلْمَعْرُوفِ","أَيْدِيَهُمْ ۚ نَسُوا۟ ٱللَّهَ",1385],["20:96:7",318,"فَقَبَضْتُ","so I took","لَمْ يَبْصُرُوا۟ بِهِۦ","قَبْضَةًۭ مِّنْ أَثَرِ",1385],["20:96:8",318,"قَبْضَةًۭ","a handful","يَبْصُرُوا۟ بِهِۦ فَقَبَضْتُ","مِّنْ أَثَرِ ٱلرَّسُولِ",2577],["25:46:2",364,"قَبَضْنَـٰهُ","We withdraw it","ثُمَّ","إِلَيْنَا قَبْضًۭا يَسِيرًۭا",1385],["25:46:4",364,"قَبْضًۭا","a withdrawal","ثُمَّ قَبَضْنَـٰهُ إِلَيْنَا","يَسِيرًۭا",4119],["39:67:8",465,"قَبْضَتُهُۥ","(will be) in His Grip","قَدْرِهِۦ وَٱلْأَرْضُ جَمِيعًۭا","يَوْمَ ٱلْقِيَـٰمَةِ وَٱلسَّمَـٰوَٰتُ",2577],["67:19:7",563,"وَيَقْبِضْنَ ۚ","and folding","ٱلطَّيْرِ فَوْقَهُمْ صَـٰٓفَّـٰتٍۢ","مَا يُمْسِكُهُنَّ إِلَّا",1385]]