[["2:44:10",7,"تَعْقِلُونَ","you use reason","تَتْلُونَ ٱلْكِتَـٰبَ ۚ أَفَلَا","",241],["2:73:11",11,"تَعْقِلُونَ","use your intellect","وَيُرِيكُمْ ءَايَـٰتِهِۦ لَعَلَّكُمْ","",241],["2:75:17",11,"عَقَلُوهُ","they understood it","مِنۢ بَعْدِ مَا","وَهُمْ يَعْلَمُونَ",241],["2:76:23",11,"تَعْقِلُونَ","understand","عِندَ رَبِّكُمْ ۚ أَفَلَا","",241],["2:164:43",25,"يَعْقِلُونَ","who use their intellect","وَٱلْأَرْضِ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ","",241],["2:170:19",26,"يَعْقِلُونَ","understand","كَانَ ءَابَآؤُهُمْ لَا","شَيْـًۭٔا وَلَا يَهْتَدُونَ",241],["2:171:18",26,"يَعْقِلُونَ","understand","عُمْىٌۭ فَهُمْ لَا","",241],["2:242:7",39,"تَعْقِلُونَ","use your intellect","لَكُمْ ءَايَـٰتِهِۦ لَعَلَّكُمْ","",241],["3:65:15",58,"تَعْقِلُونَ","you use your intellect","مِنۢ بَعْدِهِۦٓ ۚ أَفَلَا","",241],["3:118:30",65,"تَعْقِلُونَ","(to use) reason","ٱلْـَٔايَـٰتِ ۖ إِن كُنتُمْ","",241],["5:58:12",118,"يَعْقِلُونَ","understand","بِأَنَّهُمْ قَوْمٌۭ لَّا","",241],["5:103:21",124,"يَعْقِلُونَ","use reason","ٱلْكَذِبَ ۖ وَأَكْثَرُهُمْ لَا","",241],["6:32:13",131,"تَعْقِلُونَ","(will) you reason","لِّلَّذِينَ يَتَّقُونَ ۗ أَفَلَا","",241],["6:151:42",148,"تَعْقِلُونَ","use reason","وَصَّىٰكُم بِهِۦ لَعَلَّكُمْ","",241],["7:169:40",172,"تَعْقِلُونَ","you use intellect","لِّلَّذِينَ يَتَّقُونَ ۗ أَفَلَا","",241],["8:22:10",179,"يَعْقِلُونَ","use (their) intellect","ٱلْبُكْمُ ٱلَّذِينَ لَا","",241],["10:16:18",210,"تَعْقِلُونَ","you use reason","مِّن قَبْلِهِۦٓ ۚ أَفَلَا","",241],["10:42:11",213,"يَعْقِلُونَ","use reason","وَلَوْ كَانُوا۟ لَا","",241],["10:100:14",220,"يَعْقِلُونَ","use reason","عَلَى ٱلَّذِينَ لَا","",241],["11:51:13",227,"تَعْقِلُونَ","you use reason","ٱلَّذِى فَطَرَنِىٓ ۚ أَفَلَا","",241],["12:2:6",235,"تَعْقِلُونَ","understand","قُرْءَٰنًا عَرَبِيًّۭا لَّعَلَّكُمْ","",241],["12:109:29",248,"تَعْقِلُونَ","you use reason","لِّلَّذِينَ ٱتَّقَوْا۟ ۗ أَفَلَا","",241],["13:4:27",249,"يَعْقِلُونَ","who use reason","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ","",241],["16:12:15",268,"يَعْقِلُونَ","who use reason","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ","",241],["16:67:15",274,"يَعْقِلُونَ","who use reason","ذَٰلِكَ لَـَٔايَةًۭ لِّقَوْمٍۢ","",241],["21:10:8",322,"تَعْقِلُونَ","you use reason","فِيهِ ذِكْرُكُمْ ۖ أَفَلَا","",241],["21:67:9",327,"تَعْقِلُونَ","you use reason","دُونِ ٱللَّهِ ۖ أَفَلَا","",241],["22:46:8",337,"يَعْقِلُونَ","(to) reason","فَتَكُونَ لَهُمْ قُلُوبٌۭ","بِهَآ أَوْ ءَاذَانٌۭ",241],["23:80:10",347,"تَعْقِلُونَ","you reason","ٱلَّيْلِ وَٱلنَّهَارِ ۚ أَفَلَا","",241],["24:61:76",358,"تَعْقِلُونَ","understand","لَكُمُ ٱلْـَٔايَـٰتِ لَعَلَّكُمْ","",241],["25:44:7",364,"يَعْقِلُونَ ۚ","understand","أَكْثَرَهُمْ يَسْمَعُونَ أَوْ","إِنْ هُمْ إِلَّا",241],["26:28:9",368,"تَعْقِلُونَ","(to) reason","بَيْنَهُمَآ ۖ إِن كُنتُمْ","",241],["28:60:15",393,"تَعْقِلُونَ","you use intellect","خَيْرٌۭ وَأَبْقَىٰٓ ۚ أَفَلَا","",241],["29:35:7",400,"يَعْقِلُونَ","who use reason","ءَايَةًۢ بَيِّنَةًۭ لِّقَوْمٍۢ","",241],["29:43:6",401,"يَعْقِلُهَآ","will understand them","نَضْرِبُهَا لِلنَّاسِ ۖ وَمَا","إِلَّا ٱلْعَـٰلِمُونَ",241],["29:63:22",403,"يَعْقِلُونَ","use reason","بَلْ أَكْثَرُهُمْ لَا","",241],["30:24:21",406,"يَعْقِلُونَ","who use intellect","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ","",241],["30:28:27",407,"يَعْقِلُونَ","(who) use reason","نُفَصِّلُ ٱلْـَٔايَـٰتِ لِقَوْمٍۢ","",241],["36:62:8",444,"تَعْقِلُونَ","use reason","كَثِيرًا ۖ أَفَلَمْ تَكُونُوا۟","",241],["36:68:7",444,"يَعْقِلُونَ","they use intellect","فِى ٱلْخَلْقِ ۖ أَفَلَا","",241],["37:138:3",451,"تَعْقِلُونَ","you use reason","وَبِٱلَّيْلِ ۗ أَفَلَا","",241],["39:43:14",463,"يَعْقِلُونَ","they understand","يَمْلِكُونَ شَيْـًۭٔا وَلَا","",241],["40:67:30",475,"تَعْقِلُونَ","use reason","أَجَلًۭا مُّسَمًّۭى وَلَعَلَّكُمْ","",241],["43:3:6",489,"تَعْقِلُونَ","understand","قُرْءَٰنًا عَرَبِيًّۭا لَّعَلَّكُمْ","",241],["45:5:20",499,"يَعْقِلُونَ","who reason","ٱلرِّيَـٰحِ ءَايَـٰتٌۭ لِّقَوْمٍۢ","",241],["49:4:9",515,"يَعْقِلُونَ","understand","ٱلْحُجُرَٰتِ أَكْثَرُهُمْ لَا",