[["17:107:17",293,"لِلْأَذْقَانِ","on their faces","يُتْلَىٰ عَلَيْهِمْ يَخِرُّونَ","سُجَّدًۭا",1719],["17:109:2",293,"لِلْأَذْقَانِ","on their faces","وَيَخِرُّونَ","يَبْكُونَ وَيَزِيدُهُمْ خُشُوعًۭا ۩",1719],["36:8:8",440,"ٱلْأَذْقَانِ","the chins","أَغْلَـٰلًۭا فَهِىَ إِلَى","فَهُم مُّقْمَحُونَ",1719]]