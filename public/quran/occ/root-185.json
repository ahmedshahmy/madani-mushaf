[["2:43:4",7,"ٱلزَّكَوٰةَ","zakah","وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟","وَٱرْكَعُوا۟ مَعَ ٱلرَّٰكِعِينَ",355],["2:83:22",12,"ٱلزَّكَوٰةَ","the zakah","وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟","ثُمَّ تَوَلَّيْتُمْ إِلَّا",355],["2:110:4",17,"ٱلزَّكَوٰةَ ۚ","[the] zakah","وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟","وَمَا تُقَدِّمُوا۟ لِأَنفُسِكُم",355],["2:129:12",20,"وَيُزَكِّيهِمْ ۚ","and purify them","وَيُعَلِّمُهُمُ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ","إِنَّكَ أَنتَ ٱلْعَزِيزُ",753],["2:151:9",23,"وَيُزَكِّيكُمْ","and purifies you","يَتْلُوا۟ عَلَيْكُمْ ءَايَـٰتِنَا","وَيُعَلِّمُكُمُ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ",753],["2:174:26",26,"يُزَكِّيهِمْ","will He purify them","يَوْمَ ٱلْقِيَـٰمَةِ وَلَا","وَلَهُمْ عَذَابٌ أَلِيمٌ",753],["2:177:35",27,"ٱلزَّكَوٰةَ","the zakah","وَأَقَامَ ٱلصَّلَوٰةَ وَءَاتَى","وَٱلْمُوفُونَ بِعَهْدِهِمْ إِذَا",355],["2:232:26",37,"أَزْكَىٰ","(is) more virtuous","وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۗ ذَٰلِكُمْ","لَكُمْ وَأَطْهَرُ ۗ وَٱللَّهُ",1487],["2:277:9",47,"ٱلزَّكَوٰةَ","the zakah","وَأَقَامُوا۟ ٱلصَّلَوٰةَ وَءَاتَوُا۟","لَهُمْ أَجْرُهُمْ عِندَ",355],["3:77:24",59,"يُزَكِّيهِمْ","purify them","يَوْمَ ٱلْقِيَـٰمَةِ وَلَا","وَلَهُمْ عَذَابٌ أَلِيمٌۭ",753],["3:164:15",71,"وَيُزَكِّيهِمْ","and purifying them","يَتْلُوا۟ عَلَيْهِمْ ءَايَـٰتِهِۦ","وَيُعَلِّمُهُمُ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ",753],["4:49:5",86,"يُزَكُّونَ","claim purity","تَرَ إِلَى ٱلَّذِينَ","أَنفُسَهُم ۚ بَلِ ٱللَّهُ",753],["4:49:9",86,"يُزَكِّى","He purifies","أَنفُسَهُم ۚ بَلِ ٱللَّهُ","مَن يَشَآءُ وَلَا",753],["4:77:12",90,"ٱلزَّكَوٰةَ","the zakah","وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟","فَلَمَّا كُتِبَ عَلَيْهِمُ",355],["4:162:18",103,"ٱلزَّكَوٰةَ","the zakah","وَٱلْمُقِيمِينَ ٱلصَّلَوٰةَ ۚ وَٱلْمُؤْتُونَ","وَٱلْمُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ",355],["5:12:20",109,"ٱلزَّكَوٰةَ","the zakah","أَقَمْتُمُ ٱلصَّلَوٰةَ وَءَاتَيْتُمُ","وَءَامَنتُم بِرُسُلِى وَعَزَّرْتُمُوهُمْ",355],["5:55:11",117,"ٱلزَّكَوٰةَ","zakah","يُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤْتُونَ","وَهُمْ رَٰكِعُونَ",355],["7:156:26",170,"ٱلزَّكَوٰةَ","zakah","لِلَّذِينَ يَتَّقُونَ وَيُؤْتُونَ","وَٱلَّذِينَ هُم بِـَٔايَـٰتِنَا",355],["9:5:20",187,"ٱلزَّكَوٰةَ","the zakah","وَأَقَامُوا۟ ٱلصَّلَوٰةَ وَءَاتَوُا۟","فَخَلُّوا۟ سَبِيلَهُمْ ۚ إِنَّ",355],["9:11:6",188,"ٱلزَّكَوٰةَ","the zakah","وَأَقَامُوا۟ ٱلصَّلَوٰةَ وَءَاتَوُا۟","فَإِخْوَٰنُكُمْ فِى ٱلدِّينِ ۗ",355],["9:18:13",189,"ٱلزَّكَوٰةَ","the zakah","وَأَقَامَ ٱلصَّلَوٰةَ وَءَاتَى","وَلَمْ يَخْشَ إِلَّا",355],["9:71:14",198,"ٱلزَّكَوٰةَ","the zakah","وَيُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤْتُونَ","وَيُطِيعُونَ ٱللَّهَ وَرَسُولَهُۥٓ ۚ",355],["9:103:6",203,"وَتُزَكِّيهِم","and cause them increase","أَمْوَٰلِهِمْ صَدَقَةًۭ تُطَهِّرُهُمْ","بِهَا وَصَلِّ عَلَيْهِمْ ۖ",753],["18:19:29",295,"أَزْكَىٰ","the purest","ٱلْمَدِينَةِ فَلْيَنظُرْ أَيُّهَآ","طَعَامًۭا فَلْيَأْتِكُم بِرِزْقٍۢ",1487],["18:74:10",301,"زَكِيَّةًۢ","pure","قَالَ أَقَتَلْتَ نَفْسًۭا","بِغَيْرِ نَفْسٍۢ لَّقَدْ",4754],["18:81:7",302,"زَكَوٰةًۭ","(in) purity","رَبُّهُمَا خَيْرًۭا مِّنْهُ","وَأَقْرَبَ رُحْمًۭا",355],["19:13:4",306,"وَزَكَوٰةًۭ ۖ","and purity","وَحَنَانًۭا مِّن لَّدُنَّا","وَكَانَ تَقِيًّۭا",355],["19:19:9",306,"زَكِيًّۭا","pure","لِأَهَبَ لَكِ غُلَـٰمًۭا","",4753],["19:31:8",307,"وَٱلزَّكَوٰةِ","and zakah","كُنتُ وَأَوْصَـٰنِى بِٱلصَّلَوٰةِ","مَا دُمْتُ حَيًّۭا",355],["19:55:5",309,"وَٱلزَّكَوٰةِ","and zakah","يَأْمُرُ أَهْلَهُۥ بِٱلصَّلَوٰةِ","وَكَانَ عِندَ رَبِّهِۦ",355],["20:76:12",316,"تَزَكَّىٰ","purifies himself","وَذَٰلِكَ جَزَآءُ مَن","",1003],["21:73:12",328,"ٱلزَّكَوٰةِ ۖ","(of) zakah","وَإِقَامَ ٱلصَّلَوٰةِ وَإِيتَآءَ","وَكَانُوا۟ لَنَا عَـٰبِدِينَ",355],["22:41:9",337,"ٱلزَّكَوٰةَ","zakah","أَقَامُوا۟ ٱلصَّلَوٰةَ وَءَاتَوُا۟","وَأَمَرُوا۟ بِٱلْمَعْرُوفِ وَنَهَوْا۟",355],["22:78:36",341,"ٱلزَّكَوٰةَ","zakah","فَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟","وَٱعْتَصِمُوا۟ بِٱللَّهِ هُوَ",355],["23:4:3",342,"لِلزَّكَوٰةِ","of purification works","وَٱلَّذِينَ هُمْ","فَـٰعِلُونَ",355],["24:21:22",352,"زَكَىٰ","(would) have been pure","عَلَيْكُمْ وَرَحْمَتُهُۥ مَا","مِنكُم مِّنْ أَحَدٍ",4752],["24:21:29",352,"يُزَكِّى","purifies","أَبَدًۭا وَلَـٰكِنَّ ٱللَّهَ","مَن يَشَآءُ ۗ وَٱللَّهُ",753],["24:28:17",353,"أَزْكَىٰ","(is) purer","ٱرْجِعُوا۟ فَٱرْجِعُوا۟ ۖ هُوَ","لَكُمْ ۚ وَٱللَّهُ بِمَا",1487],["24:30:9",353,"أَزْكَىٰ","(is) purer","وَيَحْفَظُوا۟ فُرُوجَهُمْ ۚ ذَٰلِكَ","لَهُمْ ۗ إِنَّ ٱللَّهَ",1487],["24:37:13",355,"ٱلزَّكَوٰةِ ۙ","zakah","وَإِقَامِ ٱلصَّلَوٰةِ وَإِيتَآءِ","يَخَافُونَ يَوْمًۭا تَتَقَلَّبُ",355],["24:56:4",357,"ٱلزَّكَوٰةَ","zakah","وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟","وَأَطِيعُوا۟ ٱلرَّسُولَ لَعَلَّكُمْ",355],["27:3:5",377,"ٱلزَّكَوٰةَ","zakah","يُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤْتُونَ","وَهُم بِٱلْـَٔاخِرَةِ هُمْ",355],["30:39:16",408,"زَكَوٰةٍۢ","zakah","وَمَآ ءَاتَيْتُم مِّن","تُرِيدُونَ وَجْهَ ٱللَّهِ",355],["31:4:5",411,"ٱلزَّكَوٰةَ","zakah","يُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤْتُونَ","وَهُم بِٱلْـَٔاخِرَةِ هُمْ",355],["33:33:12",422,"ٱلزَّكَوٰةَ","zakah","وَأَقِمْنَ ٱلصَّلَوٰةَ وَءَاتِينَ","وَأَطِعْنَ ٱللَّهَ وَرَسُولَهُۥٓ ۚ",355],["35:18:28",436,"تَزَكَّىٰ","purifies himself","وَأَقَامُوا۟ ٱلصَّلَوٰةَ ۚ وَمَن","فَإِنَّمَا يَتَزَكَّىٰ لِنَفْسِهِۦ ۚ",1003],["35:18:30",436,"يَتَزَكَّىٰ","he purifies","وَمَن تَزَكَّىٰ فَإِنَّمَا","لِنَفْسِهِۦ ۚ وَإِلَى ٱللَّهِ",1003],["41:7:4",477,"ٱلزَّكَوٰةَ","the zakah","ٱلَّذِينَ لَا يُؤْتُونَ","وَهُم بِٱلْـَٔاخِرَةِ هُمْ",355],["53:32:26",527,"تُزَكُّوٓا۟","ascribe purity","بُطُونِ أُمَّهَـٰتِكُمْ ۖ فَلَا","أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ",753],["58:13:17",544,"ٱلزَّكَوٰةَ","the zakah","فَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟","وَأَطِيعُوا۟ ٱللَّهَ وَرَسُولَهُۥ ۚ",355],["62:2:11",553,"وَيُزَكِّيهِمْ","and purifying them","يَتْلُوا۟ عَلَيْهِمْ ءَايَـٰتِهِۦ","وَيُعَلِّمُهُمُ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ",753],["73:20:56",575,"ٱلزَّكَوٰةَ","the zakah","وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟","وَأَقْرِضُوا۟ ٱللَّهَ قَرْضًا",355],["79:18:6",584,"تَزَكَّىٰ","purify yourself","لَّكَ إِلَىٰٓ أَن","",1003],["80:3:4",585,"يَزَّكَّىٰٓ","purify himself","وَمَا يُدْرِيكَ لَعَلَّهُۥ","",1003],["80:7:4",585,"يَزَّكَّىٰ","he purifies himself","وَمَا عَلَيْكَ أَلَّا","",1003],["87:14:4",592,"تَزَكَّىٰ","purifies (himself)","قَدْ أَفْلَحَ مَن","",1003],["91:9:4",595,"زَكَّىٰهَا","purifies it","قَدْ أَفْلَحَ مَن","",753],["92:18:4",596,"يَتَزَكَّىٰ","(to) purify himself","ٱلَّذِى يُؤْتِى مَالَهُۥ","",1003],["98:5:13",598,"ٱلزَّكَوٰةَ ۚ","the zakah","وَيُقِيمُوا۟ ٱلصَّلَوٰةَ وَيُؤْتُوا۟","وَذَٰلِكَ دِينُ ٱلْقَيِّمَةِ",355]]