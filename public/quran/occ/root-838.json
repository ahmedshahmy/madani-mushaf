[["2:273:16",46,"ٱلتَّعَفُّفِ","(their) restraint","ٱلْجَاهِلُ أَغْنِيَآءَ مِنَ","تَعْرِفُهُم بِسِيمَـٰهُمْ لَا",4477],["4:6:23",77,"فَلْيَسْتَعْفِفْ ۖ","then he should refrain","وَمَن كَانَ غَنِيًّۭا","وَمَن كَانَ فَقِيرًۭا",2066],["24:33:1",354,"وَلْيَسْتَعْفِفِ","And let be chaste","","ٱلَّذِينَ لَا يَجِدُونَ",2066],["24:60:18",358,"يَسْتَعْفِفْنَ","they modestly refrain","مُتَبَرِّجَـٰتٍۭ بِزِينَةٍۢ ۖ وَأَن","خَيْرٌۭ لَّهُنَّ ۗ وَٱللَّهُ",2066]]