[["2:236:19",38,"ٱلْمُقْتِرِ","the poor","ٱلْمُوسِعِ قَدَرُهُۥ وَعَلَى","قَدَرُهُۥ مَتَـٰعًۢا بِٱلْمَعْرُوفِ ۖ",3839],["10:26:8",212,"قَتَرٌۭ","dust","وَلَا يَرْهَقُ وُجُوهَهُمْ","وَلَا ذِلَّةٌ ۚ أُو۟لَـٰٓئِكَ",4129],["17:100:14",292,"قَتُورًۭا","stingy","ٱلْإِنفَاقِ ۚ وَكَانَ ٱلْإِنسَـٰنُ","",4132],["25:67:7",365,"يَقْتُرُوا۟","and are not stingy","لَمْ يُسْرِفُوا۟ وَلَمْ","وَكَانَ بَيْنَ ذَٰلِكَ",4650],["80:41:2",586,"قَتَرَةٌ","darkness","تَرْهَقُهَا","",4130]]