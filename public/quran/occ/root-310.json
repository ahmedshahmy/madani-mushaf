[["2:7:9",3,"غِشَـٰوَةٌۭ ۖ","(is) a veil","سَمْعِهِمْ ۖ وَعَلَىٰٓ أَبْصَـٰرِهِمْ","وَلَهُمْ عَذَابٌ عَظِيمٌۭ",2378],["3:154:9",70,"يَغْشَىٰ","overcoming","ٱلْغَمِّ أَمَنَةًۭ نُّعَاسًۭا","طَآئِفَةًۭ مِّنكُمْ ۖ وَطَآئِفَةٌۭ",685],["7:41:7",155,"غَوَاشٍۢ ۚ","coverings","مِهَادٌۭ وَمِن فَوْقِهِمْ","وَكَذَٰلِكَ نَجْزِى ٱلظَّـٰلِمِينَ",1843],["7:54:15",157,"يُغْشِى","He covers","ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ","ٱلَّيْلَ ٱلنَّهَارَ يَطْلُبُهُۥ",1489],["7:189:13",175,"تَغَشَّىٰهَا","he covers her","لِيَسْكُنَ إِلَيْهَا ۖ فَلَمَّا","حَمَلَتْ حَمْلًا خَفِيفًۭا",4374],["8:11:2",178,"يُغَشِّيكُمُ","He covered you","إِذْ","ٱلنُّعَاسَ أَمَنَةًۭ مِّنْهُ",1841],["10:27:16",212,"أُغْشِيَتْ","had been covered","مِنْ عَاصِمٍۢ ۖ كَأَنَّمَآ","وُجُوهُهُمْ قِطَعًۭا مِّنَ",1489],["11:5:9",221,"يَسْتَغْشُونَ","they cover (themselves)","مِنْهُ ۚ أَلَا حِينَ","ثِيَابَهُمْ يَعْلَمُ مَا",2847],["12:107:4",248,"غَـٰشِيَةٌۭ","an overwhelming","أَفَأَمِنُوٓا۟ أَن تَأْتِيَهُمْ","مِّنْ عَذَابِ ٱللَّهِ",1843],["13:3:16",249,"يُغْشِى","He covers","فِيهَا زَوْجَيْنِ ٱثْنَيْنِ ۖ","ٱلَّيْلَ ٱلنَّهَارَ ۚ إِنَّ",1489],["14:50:4",261,"وَتَغْشَىٰ","and will cover","سَرَابِيلُهُم مِّن قَطِرَانٍۢ","وُجُوهَهُمُ ٱلنَّارُ",685],["20:78:4",317,"فَغَشِيَهُم","but covered them","فَأَتْبَعَهُمْ فِرْعَوْنُ بِجُنُودِهِۦ","مِّنَ ٱلْيَمِّ مَا",685],["20:78:8",317,"غَشِيَهُمْ","covered them","مِّنَ ٱلْيَمِّ مَا","",685],["24:40:6",355,"يَغْشَىٰهُ","covers it","فِى بَحْرٍۢ لُّجِّىٍّۢ","مَوْجٌۭ مِّن فَوْقِهِۦ",685],["29:55:2",403,"يَغْشَىٰهُمُ","will cover them","يَوْمَ","ٱلْعَذَابُ مِن فَوْقِهِمْ",685],["31:32:2",414,"غَشِيَهُم","covers them","وَإِذَا","مَّوْجٌۭ كَٱلظُّلَلِ دَعَوُا۟",685],["33:19:12",420,"يُغْشَىٰ","faints","تَدُورُ أَعْيُنُهُمْ كَٱلَّذِى","عَلَيْهِ مِنَ ٱلْمَوْتِ ۖ",685],["36:9:9",440,"فَأَغْشَيْنَـٰهُمْ","and We covered them","وَمِنْ خَلْفِهِمْ سَدًّۭا","فَهُمْ لَا يُبْصِرُونَ",1489],["44:11:1",496,"يَغْشَى","Enveloping","","ٱلنَّاسَ ۖ هَـٰذَا عَذَابٌ",685],["45:23:17",501,"غِشَـٰوَةًۭ","a veil","وَجَعَلَ عَلَىٰ بَصَرِهِۦ","فَمَن يَهْدِيهِ مِنۢ",2378],["47:20:22",509,"ٱلْمَغْشِىِّ","(of) one fainting","يَنظُرُونَ إِلَيْكَ نَظَرَ","عَلَيْهِ مِنَ ٱلْمَوْتِ ۖ",3662],["53:16:2",526,"يَغْشَى","covered","إِذْ","ٱلسِّدْرَةَ مَا يَغْشَىٰ",685],["53:16:5",526,"يَغْشَىٰ","covers","يَغْشَى ٱلسِّدْرَةَ مَا","",685],["53:54:1",528,"فَغَشَّىٰهَا","So covered them","","مَا غَشَّىٰ",1841],["53:54:3",528,"غَشَّىٰ","covered","فَغَشَّىٰهَا مَا","",1841],["71:7:10",570,"وَٱسْتَغْشَوْا۟","and covered themselves","أَصَـٰبِعَهُمْ فِىٓ ءَاذَانِهِمْ","ثِيَابَهُمْ وَأَصَرُّوا۟ وَٱسْتَكْبَرُوا۟",2847],["88:1:4",592,"ٱلْغَـٰشِيَةِ","(of) the Overwhelming","هَلْ أَتَىٰكَ حَدِيثُ","",1843],["91:4:3",595,"يَغْشَىٰهَا","it covers it","وَٱلَّيْلِ إِذَا","",685],["92:1:3",595,"يَغْشَىٰ","it covers","وَٱلَّيْلِ إِذَا","",685]]