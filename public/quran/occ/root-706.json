[["5:1:16",106,"ٱلصَّيْدِ","(to) hunt","عَلَيْكُمْ غَيْرَ مُحِلِّى","وَأَنتُمْ حُرُمٌ ۗ إِنَّ",1310],["5:2:26",106,"فَٱصْطَادُوا۟ ۚ","then (you may) hunt","وَرِضْوَٰنًۭا ۚ وَإِذَا حَلَلْتُمْ","وَلَا يَجْرِمَنَّكُمْ شَنَـَٔانُ",4787],["5:94:8",123,"ٱلصَّيْدِ","the game","ٱللَّهُ بِشَىْءٍۢ مِّنَ","تَنَالُهُۥٓ أَيْدِيكُمْ وَرِمَاحُكُمْ",1310],["5:95:6",123,"ٱلصَّيْدَ","the game","ءَامَنُوا۟ لَا تَقْتُلُوا۟","وَأَنتُمْ حُرُمٌۭ ۚ وَمَن",1310],["5:96:3",124,"صَيْدُ","game","أُحِلَّ لَكُمْ","ٱلْبَحْرِ وَطَعَامُهُۥ مَتَـٰعًۭا",1310],["5:96:11",124,"صَيْدُ","game","وَلِلسَّيَّارَةِ ۖ وَحُرِّمَ عَلَيْكُمْ","ٱلْبَرِّ مَا دُمْتُمْ",1310]]