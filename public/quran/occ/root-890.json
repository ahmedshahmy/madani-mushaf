[["2:205:10",32,"وَٱلنَّسْلَ ۗ","and progeny","فِيهَا وَيُهْلِكَ ٱلْحَرْثَ","وَٱللَّهُ لَا يُحِبُّ",2560],["21:96:10",330,"يَنسِلُونَ","descend","مِّن كُلِّ حَدَبٍۢ","",2776],["32:8:3",415,"نَسْلَهُۥ","his progeny","ثُمَّ جَعَلَ","مِن سُلَـٰلَةٍۢ مِّن",2560],["36:51:10",443,"يَنسِلُونَ","[they] will hasten","ٱلْأَجْدَاثِ إِلَىٰ رَبِّهِمْ","",2776]]