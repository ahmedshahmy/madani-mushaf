[["1:4:3",1,"ٱلدِّينِ","(of the) Judgment","مَـٰلِكِ يَوْمِ","",116],["2:132:11",20,"ٱلدِّينَ","the religion","ٱللَّهَ ٱصْطَفَىٰ لَكُمُ","فَلَا تَمُوتُنَّ إِلَّا",116],["2:193:7",30,"ٱلدِّينُ","the religion","تَكُونَ فِتْنَةٌۭ وَيَكُونَ","لِلَّهِ ۖ فَإِنِ ٱنتَهَوْا۟",116],["2:217:35",34,"دِينِكُمْ","your religion","حَتَّىٰ يَرُدُّوكُمْ عَن","إِنِ ٱسْتَطَـٰعُوا۟ ۚ وَمَن",116],["2:217:42",34,"دِينِهِۦ","his religion","يَرْتَدِدْ مِنكُمْ عَن","فَيَمُتْ وَهُوَ كَافِرٌۭ",116],["2:256:4",42,"ٱلدِّينِ ۖ","the religion","لَآ إِكْرَاهَ فِى","قَد تَّبَيَّنَ ٱلرُّشْدُ",116],["2:282:5",48,"تَدَايَنتُم","you contract with one another","ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا","بِدَيْنٍ إِلَىٰٓ أَجَلٍۢ",4360],["2:282:6",48,"بِدَيْنٍ","any debt","ءَامَنُوٓا۟ إِذَا تَدَايَنتُم","إِلَىٰٓ أَجَلٍۢ مُّسَمًّۭى",1329],["3:19:2",52,"ٱلدِّينَ","the religion","إِنَّ","عِندَ ٱللَّهِ ٱلْإِسْلَـٰمُ ۗ",116],["3:24:12",53,"دِينِهِم","their religion","مَّعْدُودَٰتٍۢ ۖ وَغَرَّهُمْ فِى","مَّا كَانُوا۟ يَفْتَرُونَ",116],["3:73:6",59,"دِينَكُمْ","your religion","إِلَّا لِمَن تَبِعَ","قُلْ إِنَّ ٱلْهُدَىٰ",116],["3:83:2",60,"دِينِ","(the) religion","أَفَغَيْرَ","ٱللَّهِ يَبْغُونَ وَلَهُۥٓ",116],["3:85:5",61,"دِينًۭا","(as) religion","يَبْتَغِ غَيْرَ ٱلْإِسْلَـٰمِ","فَلَن يُقْبَلَ مِنْهُ",116],["4:11:55",78,"دَيْنٍ ۗ","any debt","يُوصِى بِهَآ أَوْ","ءَابَآؤُكُمْ وَأَبْنَآؤُكُمْ لَا",1329],["4:12:25",79,"دَيْنٍۢ ۚ","any debt","يُوصِينَ بِهَآ أَوْ","وَلَهُنَّ ٱلرُّبُعُ مِمَّا",1329],["4:12:49",79,"دَيْنٍۢ ۗ","any debt","تُوصُونَ بِهَآ أَوْ","وَإِن كَانَ رَجُلٌۭ",1329],["4:12:80",79,"دَيْنٍ","any debt","يُوصَىٰ بِهَآ أَوْ","غَيْرَ مُضَآرٍّۢ ۚ وَصِيَّةًۭ",1329],["4:46:19",86,"ٱلدِّينِ ۚ","the religion","بِأَلْسِنَتِهِمْ وَطَعْنًۭا فِى","وَلَوْ أَنَّهُمْ قَالُوا۟",116],["4:125:3",98,"دِينًۭا","(in) religion","وَمَنْ أَحْسَنُ","مِّمَّنْ أَسْلَمَ وَجْهَهُۥ",116],["4:146:8",101,"دِينَهُمْ","(in) their religion","وَٱعْتَصَمُوا۟ بِٱللَّهِ وَأَخْلَصُوا۟","لِلَّهِ فَأُو۟لَـٰٓئِكَ مَعَ",116],["4:171:6",105,"دِينِكُمْ",