[["2:22:15",4,"ٱلثَّمَرَٰتِ","the fruits","فَأَخْرَجَ بِهِۦ مِنَ","رِزْقًۭا لَّكُمْ ۖ فَلَا",606],["2:25:17",5,"ثَمَرَةٍۢ","fruit","رُزِقُوا۟ مِنْهَا مِن","رِّزْقًۭا ۙ قَالُوا۟ هَـٰذَا",4498],["2:126:12",19,"ٱلثَّمَرَٰتِ","fruits","وَٱرْزُقْ أَهْلَهُۥ مِنَ","مَنْ ءَامَنَ مِنْهُم",606],["2:155:10",24,"وَٱلثَّمَرَٰتِ ۗ","and [the] fruits","مِّنَ ٱلْأَمْوَٰلِ وَٱلْأَنفُسِ","وَبَشِّرِ ٱلصَّـٰبِرِينَ",606],["2:266:18",45,"ٱلثَّمَرَٰتِ","(of) [the] fruits","فِيهَا مِن كُلِّ","وَأَصَابَهُ ٱلْكِبَرُ وَلَهُۥ",606],["6:99:35",140,"ثَمَرِهِۦٓ","its fruit","مُتَشَـٰبِهٍ ۗ ٱنظُرُوٓا۟ إِلَىٰ","إِذَآ أَثْمَرَ وَيَنْعِهِۦٓ ۚ",1408],["6:99:37",140,"أَثْمَرَ","it bears fruit","إِلَىٰ ثَمَرِهِۦٓ إِذَآ","وَيَنْعِهِۦٓ ۚ إِنَّ فِى",2197],["6:141:19",146,"ثَمَرِهِۦٓ","its fruit","مُتَشَـٰبِهٍۢ ۚ كُلُوا۟ مِن","إِذَآ أَثْمَرَ وَءَاتُوا۟",1408],["6:141:21",146,"أَثْمَرَ","it bears fruit","مِن ثَمَرِهِۦٓ إِذَآ","وَءَاتُوا۟ حَقَّهُۥ يَوْمَ",2197],["7:57:24",157,"ٱلثَّمَرَٰتِ ۚ","(of) fruits","بِهِۦ مِن كُلِّ","كَذَٰلِكَ نُخْرِجُ ٱلْمَوْتَىٰ",606],["7:130:8",165,"ٱلثَّمَرَٰتِ","[the] fruits","بِٱلسِّنِينَ وَنَقْصٍۢ مِّنَ","لَعَلَّهُمْ يَذَّكَّرُونَ",606],["13:3:11",249,"ٱلثَّمَرَٰتِ","(of) the fruits","وَأَنْهَـٰرًۭا ۖ وَمِن كُلِّ","جَعَلَ فِيهَا زَوْجَيْنِ",606],["14:32:13",259,"ٱلثَّمَرَٰتِ","the fruits","فَأَخْرَجَ بِهِۦ مِنَ","رِزْقًۭا لَّكُمْ ۖ وَسَخَّرَ",606],["14:37:24",260,"ٱلثَّمَرَٰتِ","the fruits","إِلَيْهِمْ وَٱرْزُقْهُم مِّنَ","لَعَلَّهُمْ يَشْكُرُونَ",606],["16:11:10",268,"ٱلثَّمَرَٰتِ ۗ","(of) fruits","وَٱلْأَعْنَـٰبَ وَمِن كُلِّ","إِنَّ فِى ذَٰلِكَ",606],["16:67:2",274,"ثَمَرَٰتِ","fruits","وَمِن","ٱلنَّخِيلِ وَٱلْأَعْنَـٰبِ تَتَّخِذُونَ",606],["16:69:5",274,"ٱلثَّمَرَٰتِ","the fruits","كُلِى مِن كُلِّ","فَٱسْلُكِى سُبُلَ رَبِّكِ",606],["18:34:3",297,"ثَمَرٌۭ","fruit","وَكَانَ لَهُۥ","فَقَالَ لِصَـٰحِبِهِۦ وَهُوَ",1408],["18:42:2",298,"بِثَمَرِهِۦ","his fruits","وَأُحِيطَ","فَأَصْبَحَ يُقَلِّبُ كَفَّيْهِ",1408],["28:57:16",392,"ثَمَرَٰتُ","fruits","ءَامِنًۭا يُجْبَىٰٓ إِلَيْهِ","كُلِّ شَىْءٍۢ رِّزْقًۭا",606],["35:27:11",437,"ثَمَرَٰتٍۢ","fruits","مَآءًۭ فَأَخْرَجْنَا بِهِۦ","مُّخْتَلِفًا أَلْوَٰنُهَا ۚ وَمِنَ",606],["36:35:3",442,"ثَمَرِهِۦ","its fruit","لِيَأْكُلُوا۟ مِن","وَمَا عَمِلَتْهُ أَيْدِيهِمْ ۖ",1408],["41:47:8",482,"ثَمَرَٰتٍۢ","fruits","وَمَا تَخْرُجُ مِن","مِّنْ أَكْمَامِهَا وَمَا",606],["47:15:31",508,"ٱلثَّمَرَٰتِ","fruits","فِيهَا مِن كُلِّ","وَمَغْفِرَةٌۭ مِّن رَّبِّهِمْ ۖ",606]]