[["7:10:8",151,"مَعَـٰيِشَ ۗ","livelihood","وَجَعَلْنَا لَكُمْ فِيهَا","قَلِيلًۭا مَّا تَشْكُرُونَ",2443],["15:20:4",263,"مَعَـٰيِشَ","means of living","وَجَعَلْنَا لَكُمْ فِيهَا","وَمَن لَّسْتُمْ لَهُۥ",2443],["20:124:7",320,"مَعِيشَةًۭ","(is) a life","ذِكْرِى فَإِنَّ لَهُۥ","ضَنكًۭا وَنَحْشُرُهُۥ يَوْمَ",1879],["28:58:6",392,"مَعِيشَتَهَا ۖ","(in) its means of livelihood","مِن قَرْيَةٍۭ بَطِرَتْ","فَتِلْكَ مَسَـٰكِنُهُمْ لَمْ",1879],["43:32:8",491,"مَّعِيشَتَهُمْ","their livelihood","نَحْنُ قَسَمْنَا بَيْنَهُم","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۚ",1879],["69:21:3",567,"عِيشَةٍۢ","a life","فَهُوَ فِى","رَّاضِيَةٍۢ",2255],["78:11:3",582,"مَعَاشًۭا","(for) livelihood","وَجَعَلْنَا ٱلنَّهَارَ","",3628],["101:7:3",600,"عِيشَةٍۢ","a life","فَهُوَ فِى","رَّاضِيَةٍۢ",2255]]