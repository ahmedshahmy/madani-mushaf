[["6:32:6",131,"وَلَهْوٌۭ ۖ","and amusement","ٱلدُّنْيَآ إِلَّا لَعِبٌۭ","وَلَلدَّارُ ٱلْـَٔاخِرَةُ خَيْرٌۭ",841],["6:70:6",136,"وَلَهْوًۭا","and amusement","ٱتَّخَذُوا۟ دِينَهُمْ لَعِبًۭا","وَغَرَّتْهُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا ۚ",841],["7:51:4",156,"لَهْوًۭا","(as) an amusement","ٱلَّذِينَ ٱتَّخَذُوا۟ دِينَهُمْ","وَلَعِبًۭا وَغَرَّتْهُمُ ٱلْحَيَوٰةُ",841],["15:3:4",262,"وَيُلْهِهِمُ","and diverted them","ذَرْهُمْ يَأْكُلُوا۟ وَيَتَمَتَّعُوا۟","ٱلْأَمَلُ ۖ فَسَوْفَ يَعْلَمُونَ",1472],["21:3:1",322,"لَاهِيَةًۭ","Distracted","","قُلُوبُهُمْ ۗ وَأَسَرُّوا۟ ٱلنَّجْوَى",3590],["21:17:5",323,"لَهْوًۭا","a pastime","أَرَدْنَآ أَن نَّتَّخِذَ","لَّٱتَّخَذْنَـٰهُ مِن لَّدُنَّآ",841],["24:37:3",355,"تُلْهِيهِمْ","distracts them","رِجَالٌۭ لَّا","تِجَـٰرَةٌۭ وَلَا بَيْعٌ",1472],["29:64:6",404,"لَهْوٌۭ","amusement","ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا","وَلَعِبٌۭ ۚ وَإِنَّ ٱلدَّارَ",841],["31:6:5",411,"لَهْوَ","idle tales","ٱلنَّاسِ مَن يَشْتَرِى","ٱلْحَدِيثِ لِيُضِلَّ عَن",841],["47:36:5",510,"وَلَهْوٌۭ ۚ","and amusement","ٱلْحَيَوٰةُ ٱلدُّنْيَا لَعِبٌۭ","وَإِن تُؤْمِنُوا۟ وَتَتَّقُوا۟",841],["57:20:6",540,"وَلَهْوٌۭ","and amusement","ٱلْحَيَوٰةُ ٱلدُّنْيَا لَعِبٌۭ","وَزِينَةٌۭ وَتَفَاخُرٌۢ بَيْنَكُمْ",841],["62:11:5",554,"لَهْوًا","a sport","رَأَوْا۟ تِجَـٰرَةً أَوْ","ٱنفَضُّوٓا۟ إِلَيْهَا وَتَرَكُوكَ",841],["62:11:16",554,"ٱللَّهْوِ","the sport","ٱللَّهِ خَيْرٌۭ مِّنَ","وَمِنَ ٱلتِّجَـٰرَةِ ۚ وَٱللَّهُ",841],["63:9:5",555,"تُلْهِكُمْ","divert you","ٱلَّذِينَ ءَامَنُوا۟ لَا","أَمْوَٰلُكُمْ وَلَآ أَوْلَـٰدُكُمْ",1472],["80:10:3",585,"تَلَهَّىٰ","(are) distracted","فَأَنتَ عَنْهُ","",4386],["102:1:1",600,"أَلْهَىٰكُمُ","Diverts you","","ٱلتَّكَاثُرُ",1472]]