[["2:164:9",25,"وَٱلْفُلْكِ","and the ships","وَٱخْتِلَـٰفِ ٱلَّيْلِ وَٱلنَّهَارِ","ٱلَّتِى تَجْرِى فِى",455],["7:64:6",158,"ٱلْفُلْكِ","the ship","وَٱلَّذِينَ مَعَهُۥ فِى","وَأَغْرَقْنَا ٱلَّذِينَ كَذَّبُوا۟",455],["10:22:11",211,"ٱلْفُلْكِ","the ships","إِذَا كُنتُمْ فِى","وَجَرَيْنَ بِهِم بِرِيحٍۢ",455],["10:73:6",217,"ٱلْفُلْكِ","the ship","وَمَن مَّعَهُۥ فِى","وَجَعَلْنَـٰهُمْ خَلَـٰٓئِفَ وَأَغْرَقْنَا",455],["11:37:2",225,"ٱلْفُلْكَ","the ship","وَٱصْنَعِ","بِأَعْيُنِنَا وَوَحْيِنَا وَلَا",455],["11:38:2",226,"ٱلْفُلْكَ","the ship","وَيَصْنَعُ","وَكُلَّمَا مَرَّ عَلَيْهِ",455],["14:32:18",259,"ٱلْفُلْكَ","the ships","لَّكُمْ ۖ وَسَخَّرَ لَكُمُ","لِتَجْرِىَ فِى ٱلْبَحْرِ",455],["16:14:14",268,"ٱلْفُلْكَ","the ships","حِلْيَةًۭ تَلْبَسُونَهَا وَتَرَى","مَوَاخِرَ فِيهِ وَلِتَبْتَغُوا۟",455],["17:66:5",288,"ٱلْفُلْكَ","the ship","ٱلَّذِى يُزْجِى لَكُمُ","فِى ٱلْبَحْرِ لِتَبْتَغُوا۟",455],["21:33:10",324,"فَلَكٍۢ","an orbit","وَٱلْقَمَرَ ۖ كُلٌّۭ فِى","يَسْبَحُونَ",2362],["22:65:10",340,"وَٱلْفُلْكَ","and the ships","مَّا فِى ٱلْأَرْضِ","تَجْرِى فِى ٱلْبَحْرِ",455],["23:22:3",343,"ٱلْفُلْكِ","[the] ships","وَعَلَيْهَا وَعَلَى","تُحْمَلُونَ",455],["23:27:5",343,"ٱلْفُلْكَ","the ship","إِلَيْهِ أَنِ ٱصْنَعِ","بِأَعْيُنِنَا وَوَحْيِنَا فَإِذَا",455],["23:28:7",344,"ٱلْفُلْكِ","the ship","وَمَن مَّعَكَ عَلَى","فَقُلِ ٱلْحَمْدُ لِلَّهِ",455],["26:119:5",372,"ٱلْفُلْكِ","the ship","وَمَن مَّعَهُۥ فِى","ٱلْمَشْحُونِ",455],["29:65:4",404,"ٱلْفُلْكِ","the ship","فَإِذَا رَكِبُوا۟ فِى","دَعَوُا۟ ٱللَّهَ مُخْلِصِينَ",455],["30:46:11",409,"ٱلْفُلْكُ","the ships","مِّن رَّحْمَتِهِۦ وَلِتَجْرِىَ","بِأَمْرِهِۦ وَلِتَبْتَغُوا۟ مِن",455],["31:31:4",414,"ٱلْفُلْكَ","the ships","أَلَمْ تَرَ أَنَّ","تَجْرِى فِى ٱلْبَحْرِ",455],["35:12:21",436,"ٱلْفُلْكَ","the ships","حِلْيَةًۭ تَلْبَسُونَهَا ۖ وَتَرَى","فِيهِ مَوَاخِرَ لِتَبْتَغُوا۟",455],["36:40:14",442,"فَلَكٍۢ","an orbit","ٱلنَّهَارِ ۚ وَكُلٌّۭ فِى","يَسْبَحُونَ",2362],["36:41:7",443,"ٱلْفُلْكِ","the ship","حَمَلْنَا ذُرِّيَّتَهُمْ فِى","ٱلْمَشْحُونِ",455],["37:140:4",451,"ٱلْفُلْكِ","the ship","إِذْ أَبَقَ إِلَى","ٱلْمَشْحُونِ",455],["40:80:11",476,"ٱلْفُلْكِ","the ships","صُدُورِكُمْ وَعَلَيْهَا وَعَلَى","تُحْمَلُونَ",455],["43:12:8",490,"ٱلْفُلْكِ","the ships","وَجَعَلَ لَكُم مِّنَ","وَٱلْأَنْعَـٰمِ مَا تَرْكَبُونَ",455],["45:12:7",499,"ٱلْفُلْكُ","the ships","لَكُمُ ٱلْبَحْرَ لِتَجْرِىَ","فِيهِ بِأَمْرِهِۦ وَلِتَبْتَغُوا۟",455]]