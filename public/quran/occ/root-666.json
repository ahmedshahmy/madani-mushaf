[["3:176:17",73,"حَظًّۭا","any portion","أَلَّا يَجْعَلَ لَهُمْ","فِى ٱلْـَٔاخِرَةِ ۖ وَلَهُمْ",1052],["4:11:7",78,"حَظِّ","(the) portion","أَوْلَـٰدِكُمْ ۖ لِلذَّكَرِ مِثْلُ","ٱلْأُنثَيَيْنِ ۚ فَإِن كُنَّ",1052],["4:176:40",106,"حَظِّ","share","وَنِسَآءًۭ فَلِلذَّكَرِ مِثْلُ","ٱلْأُنثَيَيْنِ ۗ يُبَيِّنُ ٱللَّهُ",1052],["5:13:13",109,"حَظًّۭا","a part","عَن مَّوَاضِعِهِۦ ۙ وَنَسُوا۟","مِّمَّا ذُكِّرُوا۟ بِهِۦ ۚ",1052],["5:14:9",110,"حَظًّۭا","a part","أَخَذْنَا مِيثَـٰقَهُمْ فَنَسُوا۟","مِّمَّا ذُكِّرُوا۟ بِهِۦ",1052],["28:79:19",395,"حَظٍّ","(of) fortune","قَـٰرُونُ إِنَّهُۥ لَذُو","عَظِيمٍۢ",1052],["41:35:10",480,"حَظٍّ","(of) fortune","يُلَقَّىٰهَآ إِلَّا ذُو","عَظِيمٍۢ",1052]]