[["9:55:14",196,"وَتَزْهَقَ","and should depart","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا","أَنفُسُهُمْ وَهُمْ كَـٰفِرُونَ",2094],["9:85:13",200,"وَتَزْهَقَ","and will depart","بِهَا فِى ٱلدُّنْيَا","أَنفُسُهُمْ وَهُمْ كَـٰفِرُونَ",2094],["17:81:4",290,"وَزَهَقَ","and perished","وَقُلْ جَآءَ ٱلْحَقُّ","ٱلْبَـٰطِلُ ۚ إِنَّ ٱلْبَـٰطِلَ",2094],["17:81:9",290,"زَهُوقًۭا","(bound) to perish","إِنَّ ٱلْبَـٰطِلَ كَانَ","",4750],["21:18:9",323,"زَاهِقٌۭ ۚ","vanishing","فَيَدْمَغُهُۥ فَإِذَا هُوَ","وَلَكُمُ ٱلْوَيْلُ مِمَّا",4747]]