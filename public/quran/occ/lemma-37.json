[["2:25:20",5,"هَـٰذَا","This (is)","ثَمَرَةٍۢ رِّزْقًۭا ۙ قَالُوا۟","ٱلَّذِى رُزِقْنَا مِن",37],["2:26:27",5,"بِهَـٰذَا","by this","مَاذَآ أَرَادَ ٱللَّهُ","مَثَلًۭا ۘ يُضِلُّ بِهِۦ",37],["2:31:12",6,"هَـٰٓؤُلَآءِ","(of) these","فَقَالَ أَنۢبِـُٔونِى بِأَسْمَآءِ","إِن كُنتُمْ صَـٰدِقِينَ",37],["2:35:14",6,"هَـٰذِهِ","this","شِئْتُمَا وَلَا تَقْرَبَا","ٱلشَّجَرَةَ فَتَكُونَا مِنَ",37],["2:58:4",9,"هَـٰذِهِ","this","وَإِذْ قُلْنَا ٱدْخُلُوا۟","ٱلْقَرْيَةَ فَكُلُوا۟ مِنْهَا",37],["2:79:8",12,"هَـٰذَا","This","بِأَيْدِيهِمْ ثُمَّ يَقُولُونَ","مِنْ عِندِ ٱللَّهِ",37],["2:85:3",13,"هَـٰٓؤُلَآءِ","(are) those","ثُمَّ أَنتُمْ","تَقْتُلُونَ أَنفُسَكُمْ وَتُخْرِجُونَ",37],["2:126:6",19,"هَـٰذَا","this","إِبْرَٰهِـۧمُ رَبِّ ٱجْعَلْ","بَلَدًا ءَامِنًۭا وَٱرْزُقْ",37],["2:259:13",43,"هَـٰذِهِ","this (town)","قَالَ أَنَّىٰ يُحْىِۦ","ٱللَّهُ بَعْدَ مَوْتِهَا ۖ",37],["3:37:22",54,"هَـٰذَا ۖ","(is) this","يَـٰمَرْيَمُ أَنَّىٰ لَكِ","قَالَتْ هُوَ مِنْ",37],["3:51:6",56,"هَـٰذَا","This","رَبِّى وَرَبُّكُمْ فَٱعْبُدُوهُ ۗ","صِرَٰطٌۭ مُّسْتَقِيمٌۭ",37],["3:62:2",58,"هَـٰذَا","this","إِنَّ","لَهُوَ ٱلْقَصَصُ ٱلْحَقُّ ۚ",37],["3:66:2",58,"هَـٰٓؤُلَآءِ","those who","هَـٰٓأَنتُمْ","حَـٰجَجْتُمْ فِيمَا لَكُم",37],["3:68:7",58,"وَهَـٰذَا","and this","بِإِبْرَٰهِيمَ لَلَّذِينَ ٱتَّبَعُوهُ","ٱلنَّبِىُّ وَٱلَّذِينَ ءَامَنُوا۟ ۗ",37],["3:117:5",65,"هَـٰذِهِ","this","مَا يُنفِقُونَ فِى","ٱلْحَيَوٰةِ ٱلدُّنْيَا كَمَثَلِ",37],["3:125:8",66,"هَـٰذَا","[this]","وَيَأْتُوكُم مِّن فَوْرِهِمْ","يُمْدِدْكُمْ رَبُّكُم بِخَمْسَةِ",37],["3:138:1",67,"هَـٰذَا","This","","بَيَانٌۭ لِّلنَّاسِ وَهُدًۭى",37],["3:165:9",71,"هَـٰذَا ۖ","(is) this","مِّثْلَيْهَا قُلْتُمْ أَنَّىٰ","قُلْ هُوَ مِنْ",37],["3:191:16",75,"هَـٰذَا","this","رَبَّنَا مَا خَلَقْتَ","بَـٰطِلًۭا سُبْحَـٰنَكَ فَقِنَا",37],["4:41:11",85,"هَـٰٓؤُلَآءِ","these (people)","وَجِئْنَا بِكَ عَلَىٰ","شَهِيدًۭا",37],["4:51:15",86,"هَـٰٓؤُلَآءِ","These","وَيَقُولُونَ لِلَّذِينَ كَفَرُوا۟","أَهْدَىٰ مِنَ ٱلَّذِينَ",37],["4:75:18",90,"هَـٰذِهِ","this","رَبَّنَآ أَخْرِجْنَا مِنْ","ٱلْقَرْيَةِ ٱلظَّالِمِ أَهْلُهَا",37],["4:78:14",90,"هَـٰذِهِۦ","This","تُصِبْهُمْ حَسَنَةٌۭ يَقُولُوا۟","مِنْ عِندِ ٱللَّهِ ۖ",37],["4:78:22",90,"هَـٰذِهِۦ","This","تُصِبْهُمْ سَيِّئَةٌۭ يَقُولُوا۟","مِنْ عِندِكَ ۚ قُلْ",37],["4:78:31",90,"هَـٰٓؤُلَآءِ","(with) these","عِندِ ٱللَّهِ ۖ فَمَالِ","ٱلْقَوْمِ لَا يَكَادُونَ",37],["4:109:2",96,"هَـٰٓؤُلَآءِ","those who","هَـٰٓأَنتُمْ","جَـٰدَلْتُمْ عَنْهُمْ فِى",37],["4:143:6",101,"هَـٰٓؤُلَآءِ","these","ذَٰلِكَ لَآ إِلَىٰ","وَلَآ إِلَىٰ هَـٰٓؤُلَآءِ ۚ",37],["4:143:9",101,"هَـٰٓؤُلَآءِ ۚ","those","هَـٰٓؤُلَآءِ وَلَآ إِلَىٰ","وَمَن يُضْلِلِ ٱللَّهُ",37],["5:31:18",112,"هَـٰذَا","this","أَنْ أَكُونَ مِثْلَ","ٱلْغُرَابِ فَأُوَٰرِىَ سَوْءَةَ",37],["5:41:35",114,"هَـٰذَا","this","يَقُولُونَ إِنْ أُوتِيتُمْ","فَخُذُوهُ وَإِن لَّمْ",37],["5:53:4",117,"أَهَـٰٓؤُلَآءِ","Are these","وَيَقُولُ ٱلَّذِينَ ءَامَنُوٓا۟","ٱلَّذِينَ أَقْسَمُوا۟ بِٱللَّهِ",37],["5:110:60",126,"هَـٰذَآ","(is) this","كَفَرُوا۟ مِنْهُمْ إِنْ","إِلَّا سِحْرٌۭ مُّبِينٌۭ",37],["5:119:3",127,"هَـٰذَا","This","قَالَ ٱللَّهُ","يَوْمُ يَنفَعُ ٱلصَّـٰدِقِينَ",37],["6:7:13",128,"هَـٰذَآ","(is) this","ٱلَّذِينَ كَفَرُوٓا۟ إِنْ","إِلَّا سِحْرٌۭ مُّبِينٌۭ",37],["6:19:13",130,"هَـٰذَا","this","وَبَيْنَكُمْ ۚ وَأُوحِىَ إِلَىَّ","ٱلْقُرْءَانُ لِأُنذِرَكُم بِهِۦ",37],["6:25:29",130,"هَـٰذَآ","(is) this","ٱلَّذِينَ كَفَرُوٓا۟ إِنْ","إِلَّآ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",37],["6:30:9",131,"هَـٰذَا","this","رَبِّهِمْ ۚ قَالَ أَلَيْسَ","بِٱلْحَقِّ ۚ قَالُوا۟ بَلَىٰ",37],["6:53:6",134,"أَهَـٰٓؤُلَآءِ","Are these","بَعْضَهُم بِبَعْضٍۢ لِّيَقُولُوٓا۟","مَنَّ ٱللَّهُ عَلَيْهِم",37],["6:63:14",135,"هَـٰذِهِۦ","this","لَّئِنْ أَنجَىٰنَا مِنْ","لَنَكُونَنَّ مِنَ ٱلشَّـٰكِرِينَ",37],["6:76:8",137,"هَـٰذَا","This","رَءَا كَوْكَبًۭا ۖ قَالَ","رَبِّى ۖ فَلَمَّآ أَفَلَ",37],["6:77:6",137,"هَـٰذَا","This","ٱلْقَمَرَ بَازِغًۭا قَالَ","رَبِّى ۖ فَلَمَّآ أَفَلَ",37],["6:78:6",137,"هَـٰذَا","This (is)","ٱلشَّمْسَ بَازِغَةًۭ قَالَ","رَبِّى هَـٰذَآ أَكْبَرُ ۖ",37],["6:78:8",137,"هَـٰذَآ","this (is)","قَالَ هَـٰذَا رَبِّى","أَكْبَرُ ۖ فَلَمَّآ أَفَلَتْ",37],["6:89:10",138,"هَـٰٓؤُلَآءِ","these","فَإِن يَكْفُرْ بِهَا","فَقَدْ وَكَّلْنَا بِهَا",37],["6:92:1",139,"وَهَـٰذَا","And this","","كِتَـٰبٌ أَنزَلْنَـٰهُ مُبَارَكٌۭ",37],["6:126:1",144,"وَهَـٰذَا","And this","","صِرَٰطُ رَبِّكَ مُسْتَقِيمًۭا ۗ",37],["6:130:14",144,"هَـٰذَا ۚ","this","وَيُنذِرُونَكُمْ لِقَآءَ يَوْمِكُمْ","قَالُوا۟ شَهِدْنَا عَلَىٰٓ",37],["6:136:10",145,"هَـٰذَا","This","وَٱلْأَنْعَـٰمِ نَصِيبًۭا فَقَالُوا۟","لِلَّهِ بِزَعْمِهِمْ وَهَـٰذَا",37],["6:136:13",145,"وَهَـٰذَا","And this","هَـٰذَا لِلَّهِ بِزَعْمِهِمْ","لِشُرَكَآئِنَا ۖ فَمَا كَانَ",37],["6:138:2",146,"هَـٰذِهِۦٓ","These","وَقَالُوا۟","أَنْعَـٰمٌۭ وَحَرْثٌ حِجْرٌۭ",37],["6:139:5",146,"هَـٰذِهِ","(of) these","مَا فِى بُطُونِ","ٱلْأَنْعَـٰمِ خَالِصَةٌۭ لِّذُكُورِنَا",37],["6:144:23",147,"بِهَـٰذَا ۚ","with this","إِذْ وَصَّىٰكُمُ ٱللَّهُ","فَمَنْ أَظْلَمُ مِمَّنِ",37],["6:150:9",148,"هَـٰذَا ۖ","this","أَنَّ ٱللَّهَ حَرَّمَ","فَإِن شَهِدُوا۟ فَلَا",37],["6:153:2",149,"هَـٰذَا","this","وَأَنَّ","صِرَٰطِى مُسْتَقِيمًۭا فَٱتَّبِعُوهُ ۖ",37],["6:155:1",149,"وَهَـٰذَا","And this","","كِتَـٰبٌ أَنزَلْنَـٰهُ مُبَارَكٌۭ",37],["7:19:12",152,"هَـٰذِهِ","this","شِئْتُمَا وَلَا تَقْرَبَا","ٱلشَّجَرَةَ فَتَكُونَا مِنَ",37],["7:20:16",152,"هَـٰذِهِ","this","نَهَىٰكُمَا رَبُّكُمَا عَنْ","ٱلشَّجَرَةِ إِلَّآ أَن",37],["7:38:28",155,"هَـٰٓؤُلَآءِ","these","أُخْرَىٰهُمْ لِأُولَىٰهُمْ رَبَّنَا","أَضَلُّونَا فَـَٔاتِهِمْ عَذَابًۭا",37],["7:43:16",155,"لِهَـٰذَا","to this","لِلَّهِ ٱلَّذِى هَدَىٰنَا","وَمَا كُنَّا لِنَهْتَدِىَ",37],["7:49:1",156,"أَهَـٰٓؤُلَآءِ","Are these","","ٱلَّذِينَ أَقْسَمْتُمْ لَا",37],["7:51:15",156,"هَـٰذَا","this","نَسُوا۟ لِقَآءَ يَوْمِهِمْ","وَمَا كَانُوا۟ بِـَٔايَـٰتِنَا",37],["7:73:19",159,"هَـٰذِهِۦ","This","بَيِّنَةٌۭ مِّن رَّبِّكُمْ ۖ","نَاقَةُ ٱللَّهِ لَكُمْ",37],["7:109:7",164,"هَـٰذَا","this","قَوْمِ فِرْعَوْنَ إِنَّ","لَسَـٰحِرٌ عَلِيمٌۭ",37],["7:123:10",165,"هَـٰذَا","this","ءَاذَنَ لَكُمْ ۖ إِنَّ","لَمَكْرٌۭ مَّكَرْتُمُوهُ فِى",37],["7:131:6",166,"هَـٰذِهِۦ ۖ","(is) this","ٱلْحَسَنَةُ قَالُوا۟ لَنَا","وَإِن تُصِبْهُمْ سَيِّئَةٌۭ",37],["7:139:2",167,"هَـٰٓؤُلَآءِ","these","إِنَّ","مُتَبَّرٌۭ مَّا هُمْ",37],["7:156:4",170,"هَـٰذِهِ","this","۞ وَٱكْتُبْ لَنَا فِى","ٱلدُّنْيَا حَسَنَةًۭ وَفِى",37],["7:161:5",171,"هَـٰذِهِ","(in) this","قِيلَ لَهُمُ ٱسْكُنُوا۟","ٱلْقَرْيَةَ وَكُلُوا۟ مِنْهَا",37],["7:169:9",172,"هَـٰذَا","(of) this","ٱلْكِتَـٰبَ يَأْخُذُونَ عَرَضَ","ٱلْأَدْنَىٰ وَيَقُولُونَ سَيُغْفَرُ",37],["7:172:25",173,"هَـٰذَا","this","إِنَّا كُنَّا عَنْ","غَـٰفِلِينَ",37],["7:203:16",176,"هَـٰذَا","This (is)","إِلَىَّ مِن رَّبِّى ۚ","بَصَآئِرُ مِن رَّبِّكُمْ",37],["8:31:12",180,"هَـٰذَآ ۙ","this","نَشَآءُ لَقُلْنَا مِثْلَ","إِنْ هَـٰذَآ إِلَّآ",37],["8:31:14",180,"هَـٰذَآ","is this","مِثْلَ هَـٰذَآ ۙ إِنْ","إِلَّآ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",37],["8:32:6",180,"هَـٰذَا","this","ٱللَّهُمَّ إِن كَانَ","هُوَ ٱلْحَقَّ مِنْ",37],["8:49:9",183,"هَـٰٓؤُلَآءِ","these (people)","قُلُوبِهِم مَّرَضٌ غَرَّ","دِينُهُمْ ۗ وَمَن يَتَوَكَّلْ",37],["9:28:13",191,"هَـٰذَا ۚ","this, their (final) year","ٱلْحَرَامَ بَعْدَ عَامِهِمْ","وَإِنْ خِفْتُمْ عَيْلَةًۭ",37],["9:35:12",192,"هَـٰذَا","This","جِبَاهُهُمْ وَجُنُوبُهُمْ وَظُهُورُهُمْ ۖ","مَا كَنَزْتُمْ لِأَنفُسِكُمْ",37],["9:124:10",207,"هَـٰذِهِۦٓ","(by) this","يَقُولُ أَيُّكُمْ زَادَتْهُ","إِيمَـٰنًۭا ۚ فَأَمَّا ٱلَّذِينَ",37],["10:2:24",208,"هَـٰذَا","this","قَالَ ٱلْكَـٰفِرُونَ إِنَّ","لَسَـٰحِرٌۭ مُّبِينٌ",37],["10:15:14",210,"هَـٰذَآ","this","ٱئْتِ بِقُرْءَانٍ غَيْرِ","أَوْ بَدِّلْهُ ۚ قُلْ",37],["10:18:11",210,"هَـٰٓؤُلَآءِ","These","وَلَا يَنفَعُهُمْ وَيَقُولُونَ","شُفَعَـٰٓؤُنَا عِندَ ٱللَّهِ ۚ",37],["10:22:38",211,"هَـٰذِهِۦ","this","لَئِنْ أَنجَيْتَنَا مِنْ","لَنَكُونَنَّ مِنَ ٱلشَّـٰكِرِينَ",37],["10:37:3",213,"هَـٰذَا","this","وَمَا كَانَ","ٱلْقُرْءَانُ أَن يُفْتَرَىٰ",37],["10:48:3",214,"هَـٰذَا","(will) this","وَيَقُولُونَ مَتَىٰ","ٱلْوَعْدُ إِن كُنتُمْ",37],["10:68:19",216,"بِهَـٰذَآ ۚ","for this","عِندَكُم مِّن سُلْطَـٰنٍۭ","أَتَقُولُونَ عَلَى ٱللَّهِ",37],["10:76:8",217,"هَـٰذَا","this","عِندِنَا قَالُوٓا۟ إِنَّ","لَسِحْرٌۭ مُّبِينٌۭ",37],["10:77:8",217,"هَـٰذَا","Is this magic","لَمَّا جَآءَكُمْ ۖ أَسِحْرٌ","وَلَا يُفْلِحُ ٱلسَّـٰحِرُونَ",37],["11:7:28",222,"هَـٰذَآ","This is not","ٱلَّذِينَ كَفَرُوٓا۟ إِنْ","إِلَّا سِحْرٌۭ مُّبِينٌۭ",37],["11:18:14",223,"هَـٰٓؤُلَآءِ","These (are)","رَبِّهِمْ وَيَقُولُ ٱلْأَشْهَـٰدُ","ٱلَّذِينَ كَذَبُوا۟ عَلَىٰ",37],["11:49:15",227,"هَـٰذَا ۖ","this","قَوْمُكَ مِن قَبْلِ","فَٱصْبِرْ ۖ إِنَّ ٱلْعَـٰقِبَةَ",37],["11:60:3",228,"هَـٰذِهِ","this","وَأُتْبِعُوا۟ فِى","ٱلدُّنْيَا لَعْنَةًۭ وَيَوْمَ",37],["11:62:8",228,"هَـٰذَآ ۖ","this","فِينَا مَرْجُوًّۭا قَبْلَ","أَتَنْهَىٰنَآ أَن نَّعْبُدَ",37],["11:64:2",229,"هَـٰذِهِۦ","This","وَيَـٰقَوْمِ","نَاقَةُ ٱللَّهِ لَكُمْ",37],["11:72:6",230,"وَهَـٰذَا","and this","ءَأَلِدُ وَأَنَا۠ عَجُوزٌۭ","بَعْلِى شَيْخًا ۖ إِنَّ",37],["11:72:10",230,"هَـٰذَا","this","بَعْلِى شَيْخًا ۖ إِنَّ","لَشَىْءٌ عَجِيبٌۭ",37],["11:76:4",230,"هَـٰذَآ ۖ","this","يَـٰٓإِبْرَٰهِيمُ أَعْرِضْ عَنْ","إِنَّهُۥ قَدْ جَآءَ",37],["11:77:11",230,"هَـٰذَا","This","بِهِمْ ذَرْعًۭا وَقَالَ","يَوْمٌ عَصِيبٌۭ",37],["11:78:12",230,"هَـٰٓؤُلَآءِ","These","ٱلسَّيِّـَٔاتِ ۚ قَالَ يَـٰقَوْمِ","بَنَاتِى هُنَّ أَطْهَرُ",37],["11:99:3",233,"هَـٰذِهِۦ","this","وَأُتْبِعُوا۟ فِى","لَعْنَةًۭ وَيَوْمَ ٱلْقِيَـٰمَةِ ۚ",37],["11:109:7",234,"هَـٰٓؤُلَآءِ ۚ","these (polytheists)","مِرْيَةٍۢ مِّمَّا يَعْبُدُ","مَا يَعْبُدُونَ إِلَّا",37],["11:120:13",235,"هَـٰذِهِ","this","فُؤَادَكَ ۚ وَجَآءَكَ فِى","ٱلْحَقُّ وَمَوْعِظَةٌۭ وَذِكْرَىٰ",37],["12:3:9",235,"هَـٰذَا","(of) this","بِمَآ أَوْحَيْنَآ إِلَيْكَ","ٱلْقُرْءَانَ وَإِن كُنتَ",37],["12:15:14",237,"هَـٰذَا","about this affair","إِلَيْهِ لَتُنَبِّئَنَّهُم بِأَمْرِهِمْ","وَهُمْ لَا يَشْعُرُونَ",37],["12:19:9",237,"هَـٰذَا","This","دَلْوَهُۥ ۖ قَالَ يَـٰبُشْرَىٰ","غُلَـٰمٌۭ ۚ وَأَسَرُّوهُ بِضَـٰعَةًۭ ۚ",37],["12:29:4",238,"هَـٰذَا ۚ","this","يُوسُفُ أَعْرِضْ عَنْ","وَٱسْتَغْفِرِى لِذَنۢبِكِ ۖ إِنَّكِ",37],["12:31:26",239,"هَـٰذَا","(is) this","حَـٰشَ لِلَّهِ مَا","بَشَرًا إِنْ هَـٰذَآ",37],["12:31:29",239,"هَـٰذَآ","(is) this","هَـٰذَا بَشَرًا إِنْ","إِلَّا مَلَكٌۭ كَرِيمٌۭ",37],["12:65:12",243,"هَـٰذِهِۦ","This","يَـٰٓأَبَانَا مَا نَبْغِى ۖ","بِضَـٰعَتُنَا رُدَّتْ إِلَيْنَا ۖ",37],["12:90:8",246,"وَهَـٰذَآ","and this","قَالَ أَنَا۠ يُوسُفُ","أَخِى ۖ قَدْ مَنَّ",37],["12:93:3",246,"هَـٰذَا","with this shirt of mine","ٱذْهَبُوا۟ بِقَمِيصِى","فَأَلْقُوهُ عَلَىٰ وَجْهِ",37],["12:100:10",247,"هَـٰذَا","This","سُجَّدًۭا ۖ وَقَالَ يَـٰٓأَبَتِ","تَأْوِيلُ رُءْيَـٰىَ مِن",37],["12:108:2",248,"هَـٰذِهِۦ","This","قُلْ","سَبِيلِىٓ أَدْعُوٓا۟ إِلَى",37],["14:35:6",260,"هَـٰذَا","this","إِبْرَٰهِيمُ رَبِّ ٱجْعَلْ","ٱلْبَلَدَ ءَامِنًۭا وَٱجْنُبْنِى",37],["14:52:1",261,"هَـٰذَا","This","","بَلَـٰغٌۭ لِّلنَّاسِ وَلِيُنذَرُوا۟",37],["15:41:2",264,"هَـٰذَا","This","قَالَ","صِرَٰطٌ عَلَىَّ مُسْتَقِيمٌ",37],["15:66:7",265,"هَـٰٓؤُلَآءِ","(of) these","ٱلْأَمْرَ أَنَّ دَابِرَ","مَقْطُوعٌۭ مُّصْبِحِينَ",37],["15:68:3",265,"هَـٰٓؤُلَآءِ","these","قَالَ إِنَّ","ضَيْفِى فَلَا تَفْضَحُونِ",37],["15:71:2",266,"هَـٰٓؤُلَآءِ","These","قَالَ","بَنَاتِىٓ إِن كُنتُمْ",37],["16:30:12",270,"هَـٰذِهِ","this","لِّلَّذِينَ أَحْسَنُوا۟ فِى","ٱلدُّنْيَا حَسَنَةٌۭ ۚ وَلَدَارُ",37],["16:86:8",276,"هَـٰٓؤُلَآءِ","these","شُرَكَآءَهُمْ قَالُوا۟ رَبَّنَا","شُرَكَآؤُنَا ٱلَّذِينَ كُنَّا",37],["16:89:14",277,"هَـٰٓؤُلَآءِ ۚ","these","بِكَ شَهِيدًا عَلَىٰ","وَنَزَّلْنَا عَلَيْكَ ٱلْكِتَـٰبَ",37],["16:103:13",279,"وَهَـٰذَا","while this","يُلْحِدُونَ إِلَيْهِ أَعْجَمِىٌّۭ","لِسَانٌ عَرَبِىٌّۭ مُّبِينٌ",37],["16:116:7",280,"هَـٰذَا","This","تَصِفُ أَلْسِنَتُكُمُ ٱلْكَذِبَ","حَلَـٰلٌۭ وَهَـٰذَا حَرَامٌۭ",37],["16:116:9",280,"وَهَـٰذَا","and this","ٱلْكَذِبَ هَـٰذَا حَلَـٰلٌۭ","حَرَامٌۭ لِّتَفْتَرُوا۟ عَلَى",37],["17:9:2",283,"هَـٰذَا","this","إِنَّ","ٱلْقُرْءَانَ يَهْدِى لِلَّتِى",37],["17:20:3",284,"هَـٰٓؤُلَآءِ","(to) these","كُلًّۭا نُّمِدُّ","وَهَـٰٓؤُلَآءِ مِنْ عَطَآءِ",37],["17:20:4",284,"وَهَـٰٓؤُلَآءِ","and (to) these","كُلًّۭا نُّمِدُّ هَـٰٓؤُلَآءِ","مِنْ عَطَآءِ رَبِّكَ ۚ",37],["17:41:4",286,"هَـٰذَا","this","وَلَقَدْ صَرَّفْنَا فِى","ٱلْقُرْءَانِ لِيَذَّكَّرُوا۟ وَمَا",37],["17:62:3",288,"هَـٰذَا","this","قَالَ أَرَءَيْتَكَ","ٱلَّذِى كَرَّمْتَ عَلَىَّ",37],["17:72:4",289,"هَـٰذِهِۦٓ","this (world)","وَمَن كَانَ فِى","أَعْمَىٰ فَهُوَ فِى",37],["17:88:10",291,"هَـٰذَا","(of) this","أَن يَأْتُوا۟ بِمِثْلِ","ٱلْقُرْءَانِ لَا يَأْتُونَ",37],["17:89:5",291,"هَـٰذَا","this","صَرَّفْنَا لِلنَّاسِ فِى","ٱلْقُرْءَانِ مِن كُلِّ",37],["17:102:6",292,"هَـٰٓؤُلَآءِ","these","عَلِمْتَ مَآ أَنزَلَ","إِلَّا رَبُّ ٱلسَّمَـٰوَٰتِ",37],["18:6:9",294,"بِهَـٰذَا","in this","إِن لَّمْ يُؤْمِنُوا۟","ٱلْحَدِيثِ أَسَفًا",37],["18:15:1",294,"هَـٰٓؤُلَآءِ","These","","قَوْمُنَا ٱتَّخَذُوا۟ مِن",37],["18:19:24",295,"هَـٰذِهِۦٓ","with this silver coin of yours","فَٱبْعَثُوٓا۟ أَحَدَكُم بِوَرِقِكُمْ","إِلَى ٱلْمَدِينَةِ فَلْيَنظُرْ",37],["18:24:16",296,"هَـٰذَا","this","رَبِّى لِأَقْرَبَ مِنْ","رَشَدًۭا",37],["18:35:11",298,"هَـٰذِهِۦٓ","this","أَظُنُّ أَن تَبِيدَ","أَبَدًۭا",37],["18:49:11",299,"هَـٰذَا","this","وَيَقُولُونَ يَـٰوَيْلَتَنَا مَالِ","ٱلْكِتَـٰبِ لَا يُغَادِرُ",37],["18:54:4",300,"هَـٰذَا","this","وَلَقَدْ صَرَّفْنَا فِى","ٱلْقُرْءَانِ لِلنَّاسِ مِن",37],["18:62:11",301,"هَـٰذَا","this","لَقِينَا مِن سَفَرِنَا","نَصَبًۭا",37],["18:78:2",302,"هَـٰذَا","This","قَالَ","فِرَاقُ بَيْنِى وَبَيْنِكَ ۚ",37],["18:98:2",304,"هَـٰذَا","This","قَالَ","رَحْمَةٌۭ مِّن رَّبِّى ۖ",37],["19:23:10",306,"هَـٰذَا","this","يَـٰلَيْتَنِى مِتُّ قَبْلَ","وَكُنتُ نَسْيًۭا مَّنسِيًّۭا",37],["19:36:6",307,"هَـٰذَا","This","رَبِّى وَرَبُّكُمْ فَٱعْبُدُوهُ ۚ","صِرَٰطٌۭ مُّسْتَقِيمٌۭ",37],["20:72:17",316,"هَـٰذِهِ","(for) this","قَاضٍ ۖ إِنَّمَا تَقْضِى","ٱلْحَيَوٰةَ ٱلدُّنْيَآ",37],["20:88:8",318,"هَـٰذَآ","This","لَّهُۥ خُوَارٌۭ فَقَالُوا۟","إِلَـٰهُكُمْ وَإِلَـٰهُ مُوسَىٰ",37],["20:117:4",320,"هَـٰذَا","this","فَقُلْنَا يَـٰٓـَٔادَمُ إِنَّ","عَدُوٌّۭ لَّكَ وَلِزَوْجِكَ",37],["21:3:8",322,"هَـٰذَآ","this","ٱلَّذِينَ ظَلَمُوا۟ هَلْ","إِلَّا بَشَرٌۭ مِّثْلُكُمْ ۖ",37],["21:24:9",323,"هَـٰذَا","This","قُلْ هَاتُوا۟ بُرْهَـٰنَكُمْ ۖ","ذِكْرُ مَن مَّعِىَ",37],["21:36:9",325,"أَهَـٰذَا","Is this","يَتَّخِذُونَكَ إِلَّا هُزُوًا","ٱلَّذِى يَذْكُرُ ءَالِهَتَكُمْ",37],["21:38:3",325,"هَـٰذَا","this","وَيَقُولُونَ مَتَىٰ","ٱلْوَعْدُ إِن كُنتُمْ",37],["21:44:3",325,"هَـٰٓؤُلَآءِ","(to) these","بَلْ مَتَّعْنَا","وَءَابَآءَهُمْ حَتَّىٰ طَالَ",37],["21:50:1",326,"وَهَـٰذَا","And this","","ذِكْرٌۭ مُّبَارَكٌ أَنزَلْنَـٰهُ ۚ",37],["21:52:6",326,"هَـٰذِهِ","(are) these","لِأَبِيهِ وَقَوْمِهِۦ مَا","ٱلتَّمَاثِيلُ ٱلَّتِىٓ أَنتُمْ",37],["21:59:4",327,"هَـٰذَا","this","قَالُوا۟ مَن فَعَلَ","بِـَٔالِهَتِنَآ إِنَّهُۥ لَمِنَ",37],["21:62:4",327,"هَـٰذَا","this","قَالُوٓا۟ ءَأَنتَ فَعَلْتَ","بِـَٔالِهَتِنَا يَـٰٓإِبْرَٰهِيمُ",37],["21:63:5",327,"هَـٰذَا","(is) this","بَلْ فَعَلَهُۥ كَبِيرُهُمْ","فَسْـَٔلُوهُمْ إِن كَانُوا۟",37],["21:65:8",327,"هَـٰٓؤُلَآءِ","these","لَقَدْ عَلِمْتَ مَا","يَنطِقُونَ",37],["21:92:2",330,"هَـٰذِهِۦٓ","this","إِنَّ","أُمَّتُكُمْ أُمَّةًۭ وَٰحِدَةًۭ",37],["21:97:16",330,"هَـٰذَا","this","فِى غَفْلَةٍۢ مِّنْ","بَلْ كُنَّا ظَـٰلِمِينَ",37],["21:99:3",330,"هَـٰٓؤُلَآءِ","these","لَوْ كَانَ","ءَالِهَةًۭ مَّا وَرَدُوهَا ۖ",37],["21:103:7",331,"هَـٰذَا","This","ٱلْأَكْبَرُ وَتَتَلَقَّىٰهُمُ ٱلْمَلَـٰٓئِكَةُ","يَوْمُكُمُ ٱلَّذِى كُنتُمْ",37],["21:106:3",331,"هَـٰذَا","this","إِنَّ فِى","لَبَلَـٰغًۭا لِّقَوْمٍ عَـٰبِدِينَ",37],["22:78:24",341,"هَـٰذَا","this","مِن قَبْلُ وَفِى","لِيَكُونَ ٱلرَّسُولُ شَهِيدًا",37],["23:24:8",343,"هَـٰذَآ","This is not","مِن قَوْمِهِۦ مَا","إِلَّا بَشَرٌۭ مِّثْلُكُمْ",37],["23:24:23",343,"بِهَـٰذَا","of this","مَلَـٰٓئِكَةًۭ مَّا سَمِعْنَا","فِىٓ ءَابَآئِنَا ٱلْأَوَّلِينَ",37],["23:33:15",344,"هَـٰذَآ","(is) this","ٱلْحَيَوٰةِ ٱلدُّنْيَا مَا","إِلَّا بَشَرٌۭ مِّثْلُكُمْ",37],["23:52:2",345,"هَـٰذِهِۦٓ","this","وَإِنَّ","أُمَّتُكُمْ أُمَّةًۭ وَٰحِدَةًۭ",37],["23:63:6",346,"هَـٰذَا","this","فِى غَمْرَةٍۢ مِّنْ","وَلَهُمْ أَعْمَـٰلٌۭ مِّن",37],["23:83:5",347,"هَـٰذَا","this","وُعِدْنَا نَحْنُ وَءَابَآؤُنَا","مِن قَبْلُ إِنْ",37],["23:83:9",347,"هَـٰذَآ","(is) this","مِن قَبْلُ إِنْ","إِلَّآ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",37],["24:12:10",351,"هَـٰذَآ","This","بِأَنفُسِهِمْ خَيْرًۭا وَقَالُوا۟","إِفْكٌۭ مُّبِينٌۭ",37],["24:16:10",351,"بِهَـٰذَا","of this","لَنَآ أَن نَّتَكَلَّمَ","سُبْحَـٰنَكَ هَـٰذَا بُهْتَـٰنٌ",37],["24:16:12",351,"هَـٰذَا","This","نَّتَكَلَّمَ بِهَـٰذَا سُبْحَـٰنَكَ","بُهْتَـٰنٌ عَظِيمٌۭ",37],["25:4:5",360,"هَـٰذَآ","this","ٱلَّذِينَ كَفَرُوٓا۟ إِنْ","إِلَّآ إِفْكٌ ٱفْتَرَىٰهُ",37],["25:7:3",360,"هَـٰذَا","this","وَقَالُوا۟ مَالِ","ٱلرَّسُولِ يَأْكُلُ ٱلطَّعَامَ",37],["25:17:12",361,"هَـٰٓؤُلَآءِ","these","ءَأَنتُمْ أَضْلَلْتُمْ عِبَادِى","أَمْ هُمْ ضَلُّوا۟",37],["25:30:7",362,"هَـٰذَا","this","إِنَّ قَوْمِى ٱتَّخَذُوا۟","ٱلْقُرْءَانَ مَهْجُورًۭا",37],["25:41:7",363,"أَهَـٰذَا","Is this","يَتَّخِذُونَكَ إِلَّا هُزُوًا","ٱلَّذِى بَعَثَ ٱللَّهُ",37],["25:53:5",364,"هَـٰذَا","[this] (one)","ٱلَّذِى مَرَجَ ٱلْبَحْرَيْنِ","عَذْبٌۭ فُرَاتٌۭ وَهَـٰذَا",37],["25:53:8",364,"وَهَـٰذَا","and [this] (one)","هَـٰذَا عَذْبٌۭ فُرَاتٌۭ","مِلْحٌ أُجَاجٌۭ وَجَعَلَ",37],["26:34:5",368,"هَـٰذَا","this","لِلْمَلَإِ حَوْلَهُۥٓ إِنَّ","لَسَـٰحِرٌ عَلِيمٌۭ",37],["26:54:2",369,"هَـٰٓؤُلَآءِ","these","إِنَّ","لَشِرْذِمَةٌۭ قَلِيلُونَ",37],["26:137:2",373,"هَـٰذَآ","(is) this","إِنْ","إِلَّا خُلُقُ ٱلْأَوَّلِينَ",37],["26:155:2",373,"هَـٰذِهِۦ","This","قَالَ","نَاقَةٌۭ لَّهَا شِرْبٌۭ",37],["27:13:6",377,"هَـٰذَا","This","ءَايَـٰتُنَا مُبْصِرَةًۭ قَالُوا۟","سِحْرٌۭ مُّبِينٌۭ",37],["27:16:15",378,"هَـٰذَا","this","كُلِّ شَىْءٍ ۖ إِنَّ","لَهُوَ ٱلْفَضْلُ ٱلْمُبِينُ",37],["27:28:3",379,"هَـٰذَا","this","ٱذْهَب بِّكِتَـٰبِى","فَأَلْقِهْ إِلَيْهِمْ ثُمَّ",37],["27:40:20",380,"هَـٰذَا","This","مُسْتَقِرًّا عِندَهُۥ قَالَ","مِن فَضْلِ رَبِّى",37],["27:68:3",383,"هَـٰذَا","this","لَقَدْ وُعِدْنَا","نَحْنُ وَءَابَآؤُنَا مِن",37],["27:68:9",383,"هَـٰذَآ","(is) this","مِن قَبْلُ إِنْ","إِلَّآ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",37],["27:71:3",383,"هَـٰذَا","(will) this","وَيَقُولُونَ مَتَىٰ","ٱلْوَعْدُ إِن كُنتُمْ",37],["27:76:2",383,"هَـٰذَا","this","إِنَّ","ٱلْقُرْءَانَ يَقُصُّ عَلَىٰ",37],["27:91:6",385,"هَـٰذِهِ","(of) this","أَنْ أَعْبُدَ رَبَّ","ٱلْبَلْدَةِ ٱلَّذِى حَرَّمَهَا",37],["28:15:12",387,"هَـٰذَا","this","فِيهَا رَجُلَيْنِ يَقْتَتِلَانِ","مِن شِيعَتِهِۦ وَهَـٰذَا",37],["28:15:15",387,"وَهَـٰذَا","and this","هَـٰذَا مِن شِيعَتِهِۦ","مِنْ عَدُوِّهِۦ ۖ فَٱسْتَغَـٰثَهُ",37],["28:15:31",387,"هَـٰذَا","This (is)","فَقَضَىٰ عَلَيْهِ ۖ قَالَ","مِنْ عَمَلِ ٱلشَّيْطَـٰنِ ۖ",37],["28:36:8",390,"هَـٰذَآ","(is) this","بَيِّنَـٰتٍۢ قَالُوا۟ مَا","إِلَّا سِحْرٌۭ مُّفْتَرًۭى",37],["28:36:14",390,"بِهَـٰذَا","of this","مُّفْتَرًۭى وَمَا سَمِعْنَا","فِىٓ ءَابَآئِنَا ٱلْأَوَّلِينَ",37],["28:42:3",390,"هَـٰذِهِ","this","وَأَتْبَعْنَـٰهُمْ فِى","ٱلدُّنْيَا لَعْنَةًۭ ۖ وَيَوْمَ",37],["28:63:7",393,"هَـٰٓؤُلَآءِ","These","عَلَيْهِمُ ٱلْقَوْلُ رَبَّنَا","ٱلَّذِينَ أَغْوَيْنَآ أَغْوَيْنَـٰهُمْ",37],["29:31:10",400,"هَـٰذِهِ","(of) this","إِنَّا مُهْلِكُوٓا۟ أَهْلِ","ٱلْقَرْيَةِ ۖ إِنَّ أَهْلَهَا",37],["29:34:5",400,"هَـٰذِهِ","(of) this","مُنزِلُونَ عَلَىٰٓ أَهْلِ","ٱلْقَرْيَةِ رِجْزًۭا مِّنَ",37],["29:47:11",402,"هَـٰٓؤُلَآءِ","these","يُؤْمِنُونَ بِهِۦ ۖ وَمِنْ","مَن يُؤْمِنُ بِهِۦ ۚ",37],["29:64:2",404,"هَـٰذِهِ","(is) this","وَمَا","ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا",37],["30:56:14",410,"فَهَـٰذَا","And this","إِلَىٰ يَوْمِ ٱلْبَعْثِ ۖ","يَوْمُ ٱلْبَعْثِ وَلَـٰكِنَّكُمْ",37],["30:58:5",410,"هَـٰذَا","this","ضَرَبْنَا لِلنَّاسِ فِى","ٱلْقُرْءَانِ مِن كُلِّ",37],["31:11:1",411,"هَـٰذَا","This","","خَلْقُ ٱللَّهِ فَأَرُونِى",37],["32:14:6",416,"هَـٰذَآ","(of) this Day of yours","نَسِيتُمْ لِقَآءَ يَوْمِكُمْ","إِنَّا نَسِينَـٰكُمْ ۖ وَذُوقُوا۟",37],["32:28:3",417,"هَـٰذَا","this","وَيَقُولُونَ مَتَىٰ","ٱلْفَتْحُ إِن كُنتُمْ",37],["33:22:6",420,"هَـٰذَا","This","ٱلْمُؤْمِنُونَ ٱلْأَحْزَابَ قَالُوا۟","مَا وَعَدَنَا ٱللَّهُ",37],["34:29:3",431,"هَـٰذَا","(is) this","وَيَقُولُونَ مَتَىٰ","ٱلْوَعْدُ إِن كُنتُمْ",37],["34:31:6",431,"بِهَـٰذَا","in this","كَفَرُوا۟ لَن نُّؤْمِنَ","ٱلْقُرْءَانِ وَلَا بِٱلَّذِى",37],["34:40:7",433,"أَهَـٰٓؤُلَآءِ","Were these you","ثُمَّ يَقُولُ لِلْمَلَـٰٓئِكَةِ","إِيَّاكُمْ كَانُوا۟ يَعْبُدُونَ",37],["34:43:8",433,"هَـٰذَآ","(is) this","بَيِّنَـٰتٍۢ قَالُوا۟ مَا","إِلَّا رَجُلٌۭ يُرِيدُ",37],["34:43:20",433,"هَـٰذَآ","(is) this","ءَابَآؤُكُمْ وَقَالُوا۟ مَا","إِلَّآ إِفْكٌۭ مُّفْتَرًۭى ۚ",37],["34:43:31",433,"هَـٰذَآ","(is) this","لَمَّا جَآءَهُمْ إِنْ","إِلَّا سِحْرٌۭ مُّبِينٌۭ",37],["35:12:4",436,"هَـٰذَا","This","وَمَا يَسْتَوِى ٱلْبَحْرَانِ","عَذْبٌۭ فُرَاتٌۭ سَآئِغٌۭ",37],["35:12:9",436,"وَهَـٰذَا","and this","فُرَاتٌۭ سَآئِغٌۭ شَرَابُهُۥ","مِلْحٌ أُجَاجٌۭ ۖ وَمِن",37],["36:48:3",443,"هَـٰذَا","this","وَيَقُولُونَ مَتَىٰ","ٱلْوَعْدُ إِن كُنتُمْ",37],["36:52:7",443,"هَـٰذَا","This (is)","بَعَثَنَا مِن مَّرْقَدِنَا ۜ ۗ","مَا وَعَدَ ٱلرَّحْمَـٰنُ",37],["36:61:3",444,"هَـٰذَا","This","وَأَنِ ٱعْبُدُونِى ۚ","صِرَٰطٌۭ مُّسْتَقِيمٌۭ",37],["36:63:1",444,"هَـٰذِهِۦ","This (is)","","جَهَنَّمُ ٱلَّتِى كُنتُمْ",37],["37:15:3",446,"هَـٰذَآ","(is) this","وَقَالُوٓا۟ إِنْ","إِلَّا سِحْرٌۭ مُّبِينٌ",37],["37:20:3",446,"هَـٰذَا","This","وَقَالُوا۟ يَـٰوَيْلَنَا","يَوْمُ ٱلدِّينِ",37],["37:21:1",446,"هَـٰذَا","This","","يَوْمُ ٱلْفَصْلِ ٱلَّذِى",37],["37:60:2",448,"هَـٰذَا","this","إِنَّ","لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ",37],["37:61:2",448,"هَـٰذَا","(of) this","لِمِثْلِ","فَلْيَعْمَلِ ٱلْعَـٰمِلُونَ",37],["37:106:2",450,"هَـٰذَا","this","إِنَّ","لَهُوَ ٱلْبَلَـٰٓؤُا۟ ٱلْمُبِينُ",37],["38:4:8",453,"هَـٰذَا","This","مِّنْهُمْ ۖ وَقَالَ ٱلْكَـٰفِرُونَ","سَـٰحِرٌۭ كَذَّابٌ",37],["38:5:6",453,"هَـٰذَا","this","إِلَـٰهًۭا وَٰحِدًا ۖ إِنَّ","لَشَىْءٌ عُجَابٌۭ",37],["38:6:10",453,"هَـٰذَا","this","عَلَىٰٓ ءَالِهَتِكُمْ ۖ إِنَّ","لَشَىْءٌۭ يُرَادُ",37],["38:7:3",453,"بِهَـٰذَا","of this","مَا سَمِعْنَا","فِى ٱلْمِلَّةِ ٱلْـَٔاخِرَةِ",37],["38:7:8",453,"هَـٰذَآ","(is) this","ٱلْمِلَّةِ ٱلْـَٔاخِرَةِ إِنْ","إِلَّا ٱخْتِلَـٰقٌ",37],["38:15:3",453,"هَـٰٓؤُلَآءِ","these","وَمَا يَنظُرُ","إِلَّا صَيْحَةًۭ وَٰحِدَةًۭ",37],["38:23:2",454,"هَـٰذَآ","this","إِنَّ","أَخِى لَهُۥ تِسْعٌۭ",37],["38:39:1",455,"هَـٰذَا","This","","عَطَآؤُنَا فَٱمْنُنْ أَوْ",37],["38:42:3",455,"هَـٰذَا","This","ٱرْكُضْ بِرِجْلِكَ ۖ","مُغْتَسَلٌۢ بَارِدٌۭ وَشَرَابٌۭ",37],["38:49:1",456,"هَـٰذَا","This","","ذِكْرٌۭ ۚ وَإِنَّ لِلْمُتَّقِينَ",37],["38:53:1",456,"هَـٰذَا","This","","مَا تُوعَدُونَ لِيَوْمِ",37],["38:54:2",456,"هَـٰذَا","this","إِنَّ","لَرِزْقُنَا مَا لَهُۥ",37],["38:55:1",456,"هَـٰذَا ۚ","This (is so)","","وَإِنَّ لِلطَّـٰغِينَ لَشَرَّ",37],["38:57:1",456,"هَـٰذَا","This (is so)","","فَلْيَذُوقُوهُ حَمِيمٌۭ وَغَسَّاقٌۭ",37],["38:59:1",456,"هَـٰذَا","This","","فَوْجٌۭ مُّقْتَحِمٌۭ مَّعَكُمْ ۖ",37],["38:61:6",456,"هَـٰذَا","this","مَن قَدَّمَ لَنَا","فَزِدْهُ عَذَابًۭا ضِعْفًۭا",37],["39:10:10",459,"هَـٰذِهِ","this","لِلَّذِينَ أَحْسَنُوا۟ فِى","ٱلدُّنْيَا حَسَنَةٌۭ ۗ وَأَرْضُ",37],["39:27:5",461,"هَـٰذَا","this","ضَرَبْنَا لِلنَّاسِ فِى","ٱلْقُرْءَانِ مِن كُلِّ",37],["39:51:8",464,"هَـٰٓؤُلَآءِ","these","وَٱلَّذِينَ ظَلَمُوا۟ مِنْ","سَيُصِيبُهُمْ سَيِّـَٔاتُ مَا",37],["39:71:26",466,"هَـٰذَا ۚ","this","وَيُنذِرُونَكُمْ لِقَآءَ يَوْمِكُمْ","قَالُوا۟ بَلَىٰ وَلَـٰكِنْ",37],["40:39:3",471,"هَـٰذِهِ","this","يَـٰقَوْمِ إِنَّمَا","ٱلْحَيَوٰةُ ٱلدُّنْيَا مَتَـٰعٌۭ",37],["41:26:6",479,"لِهَـٰذَا","to this","كَفَرُوا۟ لَا تَسْمَعُوا۟","ٱلْقُرْءَانِ وَٱلْغَوْا۟ فِيهِ",37],["41:50:10",482,"هَـٰذَا","This (is)","ضَرَّآءَ مَسَّتْهُ لَيَقُولَنَّ","لِى وَمَآ أَظُنُّ",37],["43:13:16",490,"هَـٰذَا","this","ٱلَّذِى سَخَّرَ لَنَا","وَمَا كُنَّا لَهُۥ",37],["43:29:3",491,"هَـٰٓؤُلَآءِ","(to) these","بَلْ مَتَّعْتُ","وَءَابَآءَهُمْ حَتَّىٰ جَآءَهُمُ",37],["43:30:5",491,"هَـٰذَا","This","جَآءَهُمُ ٱلْحَقُّ قَالُوا۟","سِحْرٌۭ وَإِنَّا بِهِۦ",37],["43:31:4",491,"هَـٰذَا","this","وَقَالُوا۟ لَوْلَا نُزِّلَ","ٱلْقُرْءَانُ عَلَىٰ رَجُلٍۢ",37],["43:51:11",493,"وَهَـٰذِهِ","and these","لِى مُلْكُ مِصْرَ","ٱلْأَنْهَـٰرُ تَجْرِى مِن",37],["43:52:5",493,"هَـٰذَا","this","أَنَا۠ خَيْرٌۭ مِّنْ","ٱلَّذِى هُوَ مَهِينٌۭ",37],["43:61:8",494,"هَـٰذَا","This","تَمْتَرُنَّ بِهَا وَٱتَّبِعُونِ ۚ","صِرَٰطٌۭ مُّسْتَقِيمٌۭ",37],["43:64:7",494,"هَـٰذَا","This","رَبِّى وَرَبُّكُمْ فَٱعْبُدُوهُ ۚ","صِرَٰطٌۭ مُّسْتَقِيمٌۭ",37],["43:88:4",495,"هَـٰٓؤُلَآءِ","these","وَقِيلِهِۦ يَـٰرَبِّ إِنَّ","قَوْمٌۭ لَّا يُؤْمِنُونَ",37],["44:11:3",496,"هَـٰذَا","This","يَغْشَى ٱلنَّاسَ ۖ","عَذَابٌ أَلِيمٌۭ",37],["44:22:4",497,"هَـٰٓؤُلَآءِ","these","فَدَعَا رَبَّهُۥٓ أَنَّ","قَوْمٌۭ مُّجْرِمُونَ",37],["44:34:2",497,"هَـٰٓؤُلَآءِ","these","إِنَّ","لَيَقُولُونَ",37],["44:50:2",498,"هَـٰذَا","this","إِنَّ","مَا كُنتُم بِهِۦ",37],["45:11:1",499,"هَـٰذَا","This","","هُدًۭى ۖ وَٱلَّذِينَ كَفَرُوا۟",37],["45:20:1",500,"هَـٰذَا","This","","بَصَـٰٓئِرُ لِلنَّاسِ وَهُدًۭى",37],["45:29:1",501,"هَـٰذَا","This","","كِتَـٰبُنَا يَنطِقُ عَلَيْكُم",37],["45:34:8",502,"هَـٰذَا","(of) this Day of yours","نَسِيتُمْ لِقَآءَ يَوْمِكُمْ","وَمَأْوَىٰكُمُ ٱلنَّارُ وَمَا",37],["46:4:22",502,"هَـٰذَآ","this","بِكِتَـٰبٍۢ مِّن قَبْلِ","أَوْ أَثَـٰرَةٍۢ مِّنْ",37],["46:7:12",503,"هَـٰذَا","This","لِلْحَقِّ لَمَّا جَآءَهُمْ","سِحْرٌۭ مُّبِينٌ",37],["46:11:17",503,"هَـٰذَآ","This","يَهْتَدُوا۟ بِهِۦ فَسَيَقُولُونَ","إِفْكٌۭ قَدِيمٌۭ",37],["46:12:7",503,"وَهَـٰذَا","And this","مُوسَىٰٓ إِمَامًۭا وَرَحْمَةًۭ ۚ","كِتَـٰبٌۭ مُّصَدِّقٌۭ لِّسَانًا",37],["46:17:25",504,"هَـٰذَآ","(is) this","حَقٌّۭ فَيَقُولُ مَا","إِلَّآ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",37],["46:24:7",505,"هَـٰذَا","This","مُّسْتَقْبِلَ أَوْدِيَتِهِمْ قَالُوا۟","عَارِضٌۭ مُّمْطِرُنَا ۚ بَلْ",37],["46:34:8",506,"هَـٰذَا","this","عَلَى ٱلنَّارِ أَلَيْسَ","بِٱلْحَقِّ ۖ قَالُوا۟ بَلَىٰ",37],["47:38:2",510,"هَـٰٓؤُلَآءِ","these","هَـٰٓأَنتُمْ","تُدْعَوْنَ لِتُنفِقُوا۟ فِى",37],["48:20:8",513,"هَـٰذِهِۦ","this","تَأْخُذُونَهَا فَعَجَّلَ لَكُمْ","وَكَفَّ أَيْدِىَ ٱلنَّاسِ",37],["50:2:9",518,"هَـٰذَا","This","مِّنْهُمْ فَقَالَ ٱلْكَـٰفِرُونَ","شَىْءٌ عَجِيبٌ",37],["50:22:6",519,"هَـٰذَا","this","فِى غَفْلَةٍۢ مِّنْ","فَكَشَفْنَا عَنكَ غِطَآءَكَ",37],["50:23:3",519,"هَـٰذَا","This","وَقَالَ قَرِينُهُۥ","مَا لَدَىَّ عَتِيدٌ",37],["50:32:1",519,"هَـٰذَا","This","","مَا تُوعَدُونَ لِكُلِّ",37],["51:14:3",521,"هَـٰذَا","This","ذُوقُوا۟ فِتْنَتَكُمْ","ٱلَّذِى كُنتُم بِهِۦ",37],["52:14:1",523,"هَـٰذِهِ","This","","ٱلنَّارُ ٱلَّتِى كُنتُم",37],["52:15:2",524,"هَـٰذَآ","Then is this magic","أَفَسِحْرٌ","أَمْ أَنتُمْ لَا",37],["52:32:4",525,"بِهَـٰذَآ ۚ","this","أَمْ تَأْمُرُهُمْ أَحْلَـٰمُهُم","أَمْ هُمْ قَوْمٌۭ",37],["53:56:1",528,"هَـٰذَا","This","","نَذِيرٌۭ مِّنَ ٱلنُّذُرِ",37],["53:59:2",528,"هَـٰذَا","this","أَفَمِنْ","ٱلْحَدِيثِ تَعْجَبُونَ",37],["54:8:6",529,"هَـٰذَا","This","ٱلدَّاعِ ۖ يَقُولُ ٱلْكَـٰفِرُونَ","يَوْمٌ عَسِرٌۭ",37],["55:43:1",533,"هَـٰذِهِۦ","This","","جَهَنَّمُ ٱلَّتِى يُكَذِّبُ",37],["56:56:1",536,"هَـٰذَا","This","","نُزُلُهُمْ يَوْمَ ٱلدِّينِ",37],["56:81:1",537,"أَفَبِهَـٰذَا","Then is it to this","","ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ",37],["56:95:2",537,"هَـٰذَا","this","إِنَّ","لَهُوَ حَقُّ ٱلْيَقِينِ",37],["59:21:3",548,"هَـٰذَا","this","لَوْ أَنزَلْنَا","ٱلْقُرْءَانَ عَلَىٰ جَبَلٍۢ",37],["61:6:29",552,"هَـٰذَا","This","جَآءَهُم بِٱلْبَيِّنَـٰتِ قَالُوا۟","سِحْرٌۭ مُّبِينٌۭ",37],["66:3:25",560,"هَـٰذَا ۖ","this","قَالَتْ مَنْ أَنۢبَأَكَ","قَالَ نَبَّأَنِىَ ٱلْعَلِيمُ",37],["67:20:2",563,"هَـٰذَا","this","أَمَّنْ","ٱلَّذِى هُوَ جُندٌۭ",37],["67:21:2",563,"هَـٰذَا","this","أَمَّنْ","ٱلَّذِى يَرْزُقُكُمْ إِنْ",37],["67:25:3",563,"هَـٰذَا","(is) this","وَيَقُولُونَ مَتَىٰ","ٱلْوَعْدُ إِن كُنتُمْ",37],["67:27:9",564,"هَـٰذَا","This","ٱلَّذِينَ كَفَرُوا۟ وَقِيلَ","ٱلَّذِى كُنتُم بِهِۦ",37],["68:44:4",566,"بِهَـٰذَا","this","فَذَرْنِى وَمَن يُكَذِّبُ","ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ",37],["73:19:2",574,"هَـٰذِهِۦ","this","إِنَّ","تَذْكِرَةٌۭ ۖ فَمَن شَآءَ",37],["74:24:3",576,"هَـٰذَآ","(is) this","فَقَالَ إِنْ","إِلَّا سِحْرٌۭ يُؤْثَرُ",37],["74:25:2",576,"هَـٰذَآ","(is) this","إِنْ","إِلَّا قَوْلُ ٱلْبَشَرِ",37],["74:31:37",576,"بِهَـٰذَا","by this","مَاذَآ أَرَادَ ٱللَّهُ","مَثَلًۭا ۚ كَذَٰلِكَ يُضِلُّ",37],["76:22:2",579,"هَـٰذَا","this","إِنَّ","كَانَ لَكُمْ جَزَآءًۭ",37],["76:27:2",580,"هَـٰٓؤُلَآءِ","these","إِنَّ","يُحِبُّونَ ٱلْعَاجِلَةَ وَيَذَرُونَ",37],["76:29:2",580,"هَـٰذِهِۦ","this","إِنَّ","تَذْكِرَةٌۭ ۖ فَمَن شَآءَ",37],["77:35:1",581,"هَـٰذَا","This","","يَوْمُ لَا يَنطِقُونَ",37],["77:38:1",581,"هَـٰذَا","This","","يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ",37],["83:17:3",588,"هَـٰذَا","This","ثُمَّ يُقَالُ","ٱلَّذِى كُنتُم بِهِۦ",37],["83:32:5",588,"هَـٰٓؤُلَآءِ","these","رَأَوْهُمْ قَالُوٓا۟ إِنَّ","لَضَآلُّونَ",37],["87:18:2",592,"هَـٰذَا","this","إِنَّ","لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",37],["90:1:3",594,"بِهَـٰذَا","by this","لَآ أُقْسِمُ","ٱلْبَلَدِ",37],["90:2:3",594,"بِهَـٰذَا","in this","وَأَنتَ حِلٌّۢ","ٱلْبَلَدِ",37],["95:3:1",597,"وَهَـٰذَا","And this","","ٱلْبَلَدِ ٱلْأَمِينِ",37],["106:3:3",602,"هَـٰذَا","(of) this","فَلْيَعْبُدُوا۟ رَبَّ","ٱلْبَيْتِ",37]]