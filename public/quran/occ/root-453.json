[["2:179:6",27,"ٱلْأَلْبَـٰبِ","(of) understanding","ٱلْقِصَاصِ حَيَوٰةٌۭ يَـٰٓأُو۟لِى","لَعَلَّكُمْ تَتَّقُونَ",586],["2:197:29",31,"ٱلْأَلْبَـٰبِ","(of) understanding","ٱلتَّقْوَىٰ ۚ وَٱتَّقُونِ يَـٰٓأُو۟لِى","",586],["2:269:16",45,"ٱلْأَلْبَـٰبِ","(of) understanding","يَذَّكَّرُ إِلَّآ أُو۟لُوا۟","",586],["3:7:46",50,"ٱلْأَلْبَـٰبِ","(of) understanding","يَذَّكَّرُ إِلَّآ أُو۟لُوا۟","",586],["3:190:11",75,"ٱلْأَلْبَـٰبِ","(of) understanding","وَٱلنَّهَارِ لَـَٔايَـٰتٍۢ لِّأُو۟لِى","",586],["5:100:13",124,"ٱلْأَلْبَـٰبِ","(of) understanding","فَٱتَّقُوا۟ ٱللَّهَ يَـٰٓأُو۟لِى","لَعَلَّكُمْ تُفْلِحُونَ",586],["12:111:7",248,"ٱلْأَلْبَـٰبِ ۗ","(of) understanding","قَصَصِهِمْ عِبْرَةٌۭ لِّأُو۟لِى","مَا كَانَ حَدِيثًۭا",586],["13:19:15",252,"ٱلْأَلْبَـٰبِ","(of) understanding","إِنَّمَا يَتَذَكَّرُ أُو۟لُوا۟","",586],["14:52:13",261,"ٱلْأَلْبَـٰبِ","(of) understanding","وَٰحِدٌۭ وَلِيَذَّكَّرَ أُو۟لُوا۟","",586],["38:29:9",455,"ٱلْأَلْبَـٰبِ","those of understanding","ءَايَـٰتِهِۦ وَلِيَتَذَكَّرَ أُو۟لُوا۟","",586],["38:43:10",456,"ٱلْأَلْبَـٰبِ","for those of understanding","مِّنَّا وَذِكْرَىٰ لِأُو۟لِى","",586],["39:9:24",459,"ٱلْأَلْبَـٰبِ","those of understanding","إِنَّمَا يَتَذَكَّرُ أُو۟لُوا۟","",586],["39:18:13",460,"ٱلْأَلْبَـٰبِ","the men of understanding","وَأُو۟لَـٰٓئِكَ هُمْ أُو۟لُوا۟","",586],["39:21:31",460,"ٱلْأَلْبَـٰبِ","for those of understanding","ذَٰلِكَ لَذِكْرَىٰ لِأُو۟لِى","",586],["40:54:4",473,"ٱلْأَلْبَـٰبِ","(of) understanding","هُدًۭى وَذِكْرَىٰ لِأُو۟لِى","",586],["65:10:9",559,"ٱلْأَلْبَـٰبِ","(of) understanding","فَٱتَّقُوا۟ ٱللَّهَ يَـٰٓأُو۟لِى","ٱلَّذِينَ ءَامَنُوا۟ ۚ قَدْ",586]]