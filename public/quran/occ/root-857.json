[["3:122:6",66,"تَفْشَلَا","they lost heart","طَّآئِفَتَانِ مِنكُمْ أَن","وَٱللَّهُ وَلِيُّهُمَا ۗ وَعَلَى",1545],["3:152:10",69,"فَشِلْتُمْ","you lost courage","بِإِذْنِهِۦ ۖ حَتَّىٰٓ إِذَا","وَتَنَـٰزَعْتُمْ فِى ٱلْأَمْرِ",1545],["8:43:10",182,"لَّفَشِلْتُمْ","surely you would have lost courage","وَلَوْ أَرَىٰكَهُمْ كَثِيرًۭا","وَلَتَنَـٰزَعْتُمْ فِى ٱلْأَمْرِ",1545],["8:46:6",183,"فَتَفْشَلُوا۟","lest you lose courage","وَرَسُولَهُۥ وَلَا تَنَـٰزَعُوا۟","وَتَذْهَبَ رِيحُكُمْ ۖ وَٱصْبِرُوٓا۟ ۚ",1545]]