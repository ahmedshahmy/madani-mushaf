[["24:30:3",353,"يَغُضُّوا۟","they should lower","قُل لِّلْمُؤْمِنِينَ","مِنْ أَبْصَـٰرِهِمْ وَيَحْفَظُوا۟",1668],["24:31:3",353,"يَغْضُضْنَ","(that) they should lower","وَقُل لِّلْمُؤْمِنَـٰتِ","مِنْ أَبْصَـٰرِهِنَّ وَيَحْفَظْنَ",1668],["31:19:4",412,"وَٱغْضُضْ","and lower","وَٱقْصِدْ فِى مَشْيِكَ","مِن صَوْتِكَ ۚ إِنَّ",1668],["49:3:3",515,"يَغُضُّونَ","lower","إِنَّ ٱلَّذِينَ","أَصْوَٰتَهُمْ عِندَ رَسُولِ",1668]]