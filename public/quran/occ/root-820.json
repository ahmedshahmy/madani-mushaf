[["17:102:15",292,"مَثْبُورًۭا","(you are) destroyed","وَإِنِّى لَأَظُنُّكَ يَـٰفِرْعَوْنُ","",3721],["25:13:9",361,"ثُبُورًۭا","(for) destruction","مُّقَرَّنِينَ دَعَوْا۟ هُنَالِكَ","",1655],["25:14:4",361,"ثُبُورًۭا","(for) destruction","لَّا تَدْعُوا۟ ٱلْيَوْمَ","وَٰحِدًۭا وَٱدْعُوا۟ ثُبُورًۭا",1655],["25:14:7",361,"ثُبُورًۭا","(for) destructions","ثُبُورًۭا وَٰحِدًۭا وَٱدْعُوا۟","كَثِيرًۭا",1655],["84:11:3",589,"ثُبُورًۭا","(for) destruction","فَسَوْفَ يَدْعُوا۟","",1655]]