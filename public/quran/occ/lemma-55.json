[["2:5:1",2,"أُو۟لَـٰٓئِكَ","Those","","عَلَىٰ هُدًۭى مِّن",55],["2:5:6",2,"وَأُو۟لَـٰٓئِكَ","and those","هُدًۭى مِّن رَّبِّهِمْ ۖ","هُمُ ٱلْمُفْلِحُونَ",55],["2:16:1",3,"أُو۟لَـٰٓئِكَ","Those","","ٱلَّذِينَ ٱشْتَرَوُا۟ ٱلضَّلَـٰلَةَ",55],["2:27:18",5,"أُو۟لَـٰٓئِكَ","Those","وَيُفْسِدُونَ فِى ٱلْأَرْضِ ۚ","هُمُ ٱلْخَـٰسِرُونَ",55],["2:39:5",7,"أُو۟لَـٰٓئِكَ","those","كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَـٰتِنَآ","أَصْحَـٰبُ ٱلنَّارِ ۖ هُمْ",55],["2:81:8",12,"فَأُو۟لَـٰٓئِكَ","[so] those","وَأَحَـٰطَتْ بِهِۦ خَطِيٓـَٔتُهُۥ","أَصْحَـٰبُ ٱلنَّارِ ۖ هُمْ",55],["2:82:5",12,"أُو۟لَـٰٓئِكَ","those","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","أَصْحَـٰبُ ٱلْجَنَّةِ ۖ هُمْ",55],["2:86:1",13,"أُو۟لَـٰٓئِكَ","Those","","ٱلَّذِينَ ٱشْتَرَوُا۟ ٱلْحَيَوٰةَ",55],["2:114:14",18,"أُو۟لَـٰٓئِكَ","Those","وَسَعَىٰ فِى خَرَابِهَآ ۚ","مَا كَانَ لَهُمْ",55],["2:121:7",19,"أُو۟لَـٰٓئِكَ","Those (people)","يَتْلُونَهُۥ حَقَّ تِلَاوَتِهِۦٓ","يُؤْمِنُونَ بِهِۦ ۗ وَمَن",55],["2:121:13",19,"فَأُو۟لَـٰٓئِكَ","then those","وَمَن يَكْفُرْ بِهِۦ","هُمُ ٱلْخَـٰسِرُونَ",55],["2:157:1",24,"أُو۟لَـٰٓئِكَ","Those","","عَلَيْهِمْ صَلَوَٰتٌۭ مِّن",55],["2:157:7",24,"وَأُو۟لَـٰٓئِكَ","And those","مِّن رَّبِّهِمْ وَرَحْمَةٌۭ ۖ","هُمُ ٱلْمُهْتَدُونَ",55],["2:159:16",24,"أُو۟لَـٰٓئِكَ","those","لِلنَّاسِ فِى ٱلْكِتَـٰبِ ۙ","يَلْعَنُهُمُ ٱللَّهُ وَيَلْعَنُهُمُ",55],["2:160:6",24,"فَأُو۟لَـٰٓئِكَ","Then those","تَابُوا۟ وَأَصْلَحُوا۟ وَبَيَّنُوا۟","أَتُوبُ عَلَيْهِمْ ۚ وَأَنَا",55],["2:161:7",24,"أُو۟لَـٰٓئِكَ","those","وَمَاتُوا۟ وَهُمْ كُفَّارٌ","عَلَيْهِمْ لَعْنَةُ ٱللَّهِ",55],["2:174:13",26,"أُو۟لَـٰٓئِكَ","Those","بِهِۦ ثَمَنًۭا قَلِيلًا ۙ","مَا يَأْكُلُونَ فِى",55],["2:175:1",26,"أُو۟لَـٰٓئِكَ","Those","","ٱلَّذِينَ ٱشْتَرَوُا۟ ٱلضَّلَـٰلَةَ",55],["2:177:46",27,"أُو۟لَـٰٓئِكَ","Those","وَٱلضَّرَّآءِ وَحِينَ ٱلْبَأْسِ ۗ","ٱلَّذِينَ صَدَقُوا۟ ۖ وَأُو۟لَـٰٓئِكَ",55],["2:177:49",27,"وَأُو۟لَـٰٓئِكَ","and those","أُو۟لَـٰٓئِكَ ٱلَّذِينَ صَدَقُوا۟ ۖ","هُمُ ٱلْمُتَّقُونَ",55],["2:202:1",31,"أُو۟لَـٰٓئِكَ","Those","