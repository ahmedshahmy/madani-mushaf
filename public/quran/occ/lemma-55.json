those","بِمَآ أَنزَلَ ٱللَّهُ","هُمُ ٱلْفَـٰسِقُونَ",55],["5:60:21",118,"أُو۟لَـٰٓئِكَ","Those","وَٱلْخَنَازِيرَ وَعَبَدَ ٱلطَّـٰغُوتَ ۚ","شَرٌّۭ مَّكَانًۭا وَأَضَلُّ",55],["5:86:5",122,"أُو۟لَـٰٓئِكَ","those","كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَـٰتِنَآ","أَصْحَـٰبُ ٱلْجَحِيمِ",55],["6:70:32",136,"أُو۟لَـٰٓئِكَ","Those","لَّا يُؤْخَذْ مِنْهَآ ۗ","ٱلَّذِينَ أُبْسِلُوا۟ بِمَا",55],["6:82:7",138,"أُو۟لَـٰٓئِكَ","those","يَلْبِسُوٓا۟ إِيمَـٰنَهُم بِظُلْمٍ","لَهُمُ ٱلْأَمْنُ وَهُم",55],["6:89:1",138,"أُو۟لَـٰٓئِكَ","Those","","ٱلَّذِينَ ءَاتَيْنَـٰهُمُ ٱلْكِتَـٰبَ",55],["6:90:1",138,"أُو۟لَـٰٓئِكَ","Those","","ٱلَّذِينَ هَدَى ٱللَّهُ ۖ",55],["7:8:7",151,"فَأُو۟لَـٰٓئِكَ","then those","فَمَن ثَقُلَتْ مَوَٰزِينُهُۥ","هُمُ ٱلْمُفْلِحُونَ",55],["7:9:4",151,"فَأُو۟لَـٰٓئِكَ","so those","وَمَنْ خَفَّتْ مَوَٰزِينُهُۥ","ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُم",55],["7:36:6",154,"أُو۟لَـٰٓئِكَ","those","بِـَٔايَـٰتِنَا وَٱسْتَكْبَرُوا۟ عَنْهَآ","أَصْحَـٰبُ ٱلنَّارِ ۖ هُمْ",55],["7:37:11",154,"أُو۟لَـٰٓئِكَ","Those","أَوْ كَذَّبَ بِـَٔايَـٰتِهِۦٓ ۚ","يَنَالُهُمْ نَصِيبُهُم مِّنَ",55],["7:42:10",155,"أُو۟لَـٰٓئِكَ","Those","نَفْسًا إِلَّا وُسْعَهَآ","أَصْحَـٰبُ ٱلْجَنَّةِ ۖ هُمْ",55],["7:157:41",170,"أُو۟لَـٰٓئِكَ","Those (are)","ٱلَّذِىٓ أُنزِلَ مَعَهُۥٓ ۙ","هُمُ ٱلْمُفْلِحُونَ",55],["7:178:8",173,"فَأُو۟لَـٰٓئِكَ","then those","ٱلْمُهْتَدِى ۖ وَمَن يُضْلِلْ","هُمُ ٱلْخَـٰسِرُونَ",55],["7:179:23",174,"أُو۟لَـٰٓئِكَ","Those","لَّا يَسْمَعُونَ بِهَآ ۚ","كَٱلْأَنْعَـٰمِ بَلْ هُمْ",55],["7:179:28",174,"أُو۟لَـٰٓئِكَ","Those","بَلْ هُمْ أَضَلُّ ۚ","هُمُ ٱلْغَـٰفِلُونَ",55],["8:4:1",177,"أُو۟لَـٰٓئِكَ","Those","","هُمُ ٱلْمُؤْمِنُونَ حَقًّۭا ۚ",55],["8:37:16",181,"أُو۟لَـٰٓئِكَ","Those","فَيَجْعَلَهُۥ فِى جَهَنَّمَ ۚ","هُمُ ٱلْخَـٰسِرُونَ",55],["8:72:14",186,"أُو۟لَـٰٓئِكَ","those","وَٱلَّذِينَ ءَاوَوا۟ وَّنَصَرُوٓا۟","بَعْضُهُمْ أَوْلِيَآءُ بَعْضٍۢ ۚ",55],["8:74:11",186,"أُو۟لَـٰٓئِكَ","those","وَٱلَّذِينَ ءَاوَوا۟ وَّنَصَرُوٓا۟","هُمُ ٱلْمُؤْمِنُونَ حَقًّۭا ۚ",55],["8:75:8",186,"فَأُو۟لَـٰٓئِكَ","then those","وَهَاجَرُوا۟ وَجَـٰهَدُوا۟ مَعَكُمْ","مِنكُمْ ۚ وَأُو۟لُوا۟ ٱلْأَرْحَامِ",55],["9:10:8",188,"وَأُو۟لَـٰٓئِكَ","And those","إِلًّۭا وَلَا ذِمَّةًۭ ۚ","هُمُ ٱلْمُعْتَدُونَ",55],["9:17:12",189,"أُو۟لَـٰٓئِكَ","(For) those","عَلَىٰٓ أَنفُسِهِم بِٱلْكُفْرِ ۚ","حَبِطَتْ أَعْمَـٰلُهُمْ وَفِى",55],["9:18:19",189,"أُو۟لَـٰٓئِكَ","those","إِلَّا ٱللَّهَ ۖ فَعَسَىٰٓ","أَن يَكُونُوا۟ مِنَ",55],["9:20:14",189,"وَأُو۟لَـٰٓئِكَ","And those","دَرَجَةً عِندَ ٱللَّهِ ۚ","هُمُ ٱلْفَآئِزُونَ",55],["9:23:17",190,"فَأُو۟لَـٰٓئِكَ","then those","وَمَن يَتَوَلَّهُم مِّنكُمْ","هُمُ ٱلظَّـٰلِمُونَ",55],["9:69:24",198,"أُو۟لَـٰٓئِكَ","Those","وَخُضْتُمْ كَٱلَّذِى خَاضُوٓا۟ ۚ","حَبِطَتْ أَعْمَـٰلُهُمْ فِى",55],["9:69:30",198,"وَأُو۟لَـٰٓئِكَ","And those","فِى ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ ۖ","هُمُ ٱلْخَـٰسِرُونَ",55],["9:71:18",198,"أُو۟لَـٰٓئِكَ","Those","وَيُطِيعُونَ ٱللَّهَ وَرَسُولَهُۥٓ ۚ","سَيَرْحَمُهُمُ ٱللَّهُ ۗ إِنَّ",55],["9:88:9",201,"وَأُو۟لَـٰٓئِكَ","And those","جَـٰهَدُوا۟ بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ ۚ","لَهُمُ ٱلْخَيْرَٰتُ ۖ وَأُو۟لَـٰٓئِكَ",55],["9:88:12",201,"وَأُو۟لَـٰٓئِكَ","and those","وَأُو۟لَـٰٓئِكَ لَهُمُ ٱلْخَيْرَٰتُ ۖ","هُمُ ٱلْمُفْلِحُونَ",55],["10:8:1",209,"أُو۟لَـٰٓئِكَ","Those","","مَأْوَىٰهُمُ ٱلنَّارُ بِمَا",55],["10:26:11",212,"أُو۟لَـٰٓئِكَ","Those","قَتَرٌۭ وَلَا ذِلَّةٌ ۚ","أَصْحَـٰبُ ٱلْجَنَّةِ ۖ هُمْ",55],["10:27:22",212,"أُو۟لَـٰٓئِكَ","Those","مِّنَ ٱلَّيْلِ مُظْلِمًا ۚ","أَصْحَـٰبُ ٱلنَّارِ ۖ هُمْ",55],["11:11:6",222,"أُو۟لَـٰٓئِكَ","those","صَبَرُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","لَهُم مَّغْفِرَةٌۭ وَأَجْرٌۭ",55],["11:16:1",223,"أُو۟لَـٰٓئِكَ","Those","","ٱلَّذِينَ لَيْسَ لَهُمْ",55],["11:17:16",223,"أُو۟لَـٰٓئِكَ","Those","مُوسَىٰٓ إِمَامًۭا وَرَحْمَةً ۚ","يُؤْمِنُونَ بِهِۦ ۚ وَمَن",55],["11:18:8",223,"أُو۟لَـٰٓئِكَ","Those","عَلَى ٱللَّهِ كَذِبًا ۚ","يُعْرَضُونَ عَلَىٰ رَبِّهِمْ",55],["11:20:1",224,"أُو۟لَـٰٓئِكَ","Those","","لَمْ يَكُونُوا۟ مُعْجِزِينَ",55],["11:21:1",224,"أُو۟لَـٰٓئِكَ","Those","","ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُمْ",55],["11:23:9",224,"أُو۟لَـٰٓئِكَ","those","وَأَخْبَتُوٓا۟ إِلَىٰ رَبِّهِمْ","أَصْحَـٰبُ ٱلْجَنَّةِ ۖ هُمْ",55],["13:5:12",249,"أُو۟لَـٰٓئِكَ","Those","لَفِى خَلْقٍۢ جَدِيدٍ ۗ","ٱلَّذِينَ كَفَرُوا۟ بِرَبِّهِمْ ۖ",55],["13:5:16",249,"وَأُو۟لَـٰٓئِكَ","and those","ٱلَّذِينَ كَفَرُوا۟ بِرَبِّهِمْ ۖ","ٱلْأَغْلَـٰلُ فِىٓ أَعْنَاقِهِمْ ۖ",55],["13:5:20",249,"وَأُو۟لَـٰٓئِكَ","those","ٱلْأَغْلَـٰلُ فِىٓ أَعْنَاقِهِمْ ۖ","أَصْحَـٰبُ ٱلنَّارِ ۖ هُمْ",55],["13:18:20",251,"أُو۟لَـٰٓئِكَ","Those","مَعَهُۥ لَٱفْتَدَوْا۟ بِهِۦٓ ۚ","لَهُمْ سُوٓءُ ٱلْحِسَابِ",55],["13:22:16",252,"أُو۟لَـٰٓئِكَ","those","وَيَدْرَءُونَ بِٱلْحَسَنَةِ ٱلسَّيِّئَةَ","لَهُمْ عُقْبَى ٱلدَّارِ",55],["13:25:18",252,"أُو۟لَـٰٓئِكَ","Those","وَيُفْسِدُونَ فِى ٱلْأَرْضِ ۙ","لَهُمُ ٱللَّعْنَةُ وَلَهُمْ",55],["14:3:13",255,"أُو۟لَـٰٓئِكَ","those","ٱللَّهِ وَيَبْغُونَهَا عِوَجًا ۚ","فِى ضَلَـٰلٍۭ بَعِيدٍۢ",55],["16:105:9",279,"وَأُو۟لَـٰٓئِكَ","and those","يُؤْمِنُونَ بِـَٔايَـٰتِ ٱللَّهِ ۖ","هُمُ ٱلْكَـٰذِبُونَ",55],["16:108:1",279,"أُو۟لَـٰٓئِكَ","Those","","ٱلَّذِينَ طَبَعَ ٱللَّهُ",55],["16:108:9",279,"وَأُو۟لَـٰٓئِكَ","And those","قُلُوبِهِمْ وَسَمْعِهِمْ وَأَبْصَـٰرِهِمْ ۖ","هُمُ ٱلْغَـٰفِلُونَ",55],["17:19:9",284,"فَأُو۟لَـٰٓئِكَ","then those","سَعْيَهَا وَهُوَ مُؤْمِنٌۭ","كَانَ سَعْيُهُم مَّشْكُورًۭا",55],["17:36:13",285,"أُو۟لَـٰٓئِكَ","those","وَٱلْبَصَرَ وَٱلْفُؤَادَ كُلُّ","كَانَ عَنْهُ مَسْـُٔولًۭا",55],["17:57:1",287,"أُو۟لَـٰٓئِكَ","Those","","ٱلَّذِينَ يَدْعُونَ يَبْتَغُونَ",55],["17:71:10",289,"فَأُو۟لَـٰٓئِكَ","then those","أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ","يَقْرَءُونَ كِتَـٰبَهُمْ وَلَا",55],["18:31:1",297,"أُو۟لَـٰٓئِكَ","Those","","لَهُمْ جَنَّـٰتُ عَدْنٍۢ",55],["18:105:1",304,"أُو۟لَـٰٓئِكَ","Those","","ٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِ",55],["19:58:1",309,"أُو۟لَـٰٓئِكَ","Those","","ٱلَّذِينَ أَنْعَمَ ٱللَّهُ",55],["19:60:7",309,"فَأُو۟لَـٰٓئِكَ","Then those","وَءَامَنَ وَعَمِلَ صَـٰلِحًۭا","يَدْخُلُونَ ٱلْجَنَّةَ وَلَا",55],["20:75:7",316,"فَأُو۟لَـٰٓئِكَ","then those","قَدْ عَمِلَ ٱلصَّـٰلِحَـٰتِ","لَهُمُ ٱلدَّرَجَـٰتُ ٱلْعُلَىٰ",55],["21:101:7",330,"أُو۟لَـٰٓئِكَ","those","لَهُم مِّنَّا ٱلْحُسْنَىٰٓ","عَنْهَا مُبْعَدُونَ",55],["22:51:6",338,"أُو۟لَـٰٓئِكَ","those","فِىٓ ءَايَـٰتِنَا مُعَـٰجِزِينَ","أَصْحَـٰبُ ٱلْجَحِيمِ",55],["22:57:5",339,"فَأُو۟لَـٰٓئِكَ","then those","كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا","لَهُمْ عَذَابٌۭ مُّهِينٌۭ",55],["23:7:5",342,"فَأُو۟لَـٰٓئِكَ","then those","ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ","هُمُ ٱلْعَادُونَ",55],["23:10:1",342,"أُو۟لَـٰٓئِكَ","Those","","هُمُ ٱلْوَٰرِثُونَ",55],["23:61:1",346,"أُو۟لَـٰٓئِكَ","(It is) those","","يُسَـٰرِعُونَ فِى ٱلْخَيْرَٰتِ",55],["23:102:4",348,"فَأُو۟لَـٰٓئِكَ","then those","فَمَن ثَقُلَتْ مَوَٰزِينُهُۥ","هُمُ ٱلْمُفْلِحُونَ",55],["23:103:4",348,"فَأُو۟لَـٰٓئِكَ","then those","وَمَنْ خَفَّتْ مَوَٰزِينُهُۥ","ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُمْ",55],["24:4:17",350,"وَأُو۟لَـٰٓئِكَ","And those","لَهُمْ شَهَـٰدَةً أَبَدًۭا ۚ","هُمُ ٱلْفَـٰسِقُونَ",55],["24:13:10",351,"فَأُو۟لَـٰٓئِكَ","then those","لَمْ يَأْتُوا۟ بِٱلشُّهَدَآءِ","عِندَ ٱللَّهِ هُمُ",55],["24:26:9",352,"أُو۟لَـٰٓئِكَ","Those","لِلطَّيِّبِينَ وَٱلطَّيِّبُونَ لِلطَّيِّبَـٰتِ ۚ","مُبَرَّءُونَ مِمَّا يَقُولُونَ ۖ",55],["24:47:14",356,"أُو۟لَـٰٓئِكَ","those","بَعْدِ ذَٰلِكَ ۚ وَمَآ","بِٱلْمُؤْمِنِينَ",55],["24:50:14",356,"أُو۟لَـٰٓئِكَ","those","عَلَيْهِمْ وَرَسُولُهُۥ ۚ بَلْ","هُمُ ٱلظَّـٰلِمُونَ",55],["24:51:16",356,"وَأُو۟لَـٰٓئِكَ","And those","يَقُولُوا۟ سَمِعْنَا وَأَطَعْنَا ۚ","هُمُ ٱلْمُفْلِحُونَ",55],["24:52:8",356,"فَأُو۟لَـٰٓئِكَ","then those","وَيَخْشَ ٱللَّهَ وَيَتَّقْهِ","هُمُ ٱلْفَآئِزُونَ",55],["24:55:36",357,"فَأُو۟لَـٰٓئِكَ","then those","كَفَرَ بَعْدَ ذَٰلِكَ","هُمُ ٱلْفَـٰسِقُونَ",55],["24:62:20",359,"أُو۟لَـٰٓئِكَ","those","إِنَّ ٱلَّذِينَ يَسْتَـْٔذِنُونَكَ","ٱلَّذِينَ يُؤْمِنُونَ بِٱللَّهِ",55],["25:34:7",363,"أُو۟لَـٰٓئِكَ","those","وُجُوهِهِمْ إِلَىٰ جَهَنَّمَ","شَرٌّۭ مَّكَانًۭا وَأَضَلُّ",55],["25:70:8",366,"فَأُو۟لَـٰٓئِكَ","then (for) those","وَعَمِلَ عَمَلًۭا صَـٰلِحًۭا","يُبَدِّلُ ٱللَّهُ سَيِّـَٔاتِهِمْ",55],["25:75:1",366,"أُو۟لَـٰٓئِكَ","Those","","يُجْزَوْنَ ٱلْغُرْفَةَ بِمَا",55],["27:5:1",377,"أُو۟لَـٰٓئِكَ","Those","","ٱلَّذِينَ لَهُمْ سُوٓءُ",55],["28:54:1",392,"أُو۟لَـٰٓئِكَ","Those","","يُؤْتَوْنَ أَجْرَهُم مَّرَّتَيْنِ",55],["29:23:6",398,"أُو۟لَـٰٓئِكَ","those","بِـَٔايَـٰتِ ٱللَّهِ وَلِقَآئِهِۦٓ","يَئِسُوا۟ مِن رَّحْمَتِى",55],["29:23:10",398,"وَأُو۟لَـٰٓئِكَ","And those","يَئِسُوا۟ مِن رَّحْمَتِى","لَهُمْ عَذَابٌ أَلِيمٌۭ",55],["29:52:17",402,"أُو۟لَـٰٓئِكَ","those","بِٱلْبَـٰطِلِ وَكَفَرُوا۟ بِٱللَّهِ","هُمُ ٱلْخَـٰسِرُونَ",55],["30:16:8",406,"فَأُو۟لَـٰٓئِكَ","then those","بِـَٔايَـٰتِنَا وَلِقَآئِ ٱلْـَٔاخِرَةِ","فِى ٱلْعَذَابِ مُحْضَرُونَ",55],["30:38:14",408,"وَأُو۟لَـٰٓئِكَ","And those","يُرِيدُونَ وَجْهَ ٱللَّهِ ۖ","هُمُ ٱلْمُفْلِحُونَ",55],["30:39:20",408,"فَأُو۟لَـٰٓئِكَ","then those","تُرِيدُونَ وَجْهَ ٱللَّهِ","هُمُ ٱلْمُضْعِفُونَ",55],["31:5:1",411,"أُو۟لَـٰٓئِكَ","Those","","عَلَىٰ هُدًۭى مِّن",55],["31:5:6",411,"وَأُو۟لَـٰٓئِكَ","and those","هُدًۭى مِّن رَّبِّهِمْ ۖ","هُمُ ٱلْمُفْلِحُونَ",55],["31:6:15",411,"أُو۟لَـٰٓئِكَ","Those","عِلْمٍۢ وَيَتَّخِذَهَا هُزُوًا ۚ","لَهُمْ عَذَابٌۭ مُّهِينٌۭ",55],["33:19:25",420,"أُو۟لَـٰٓئِكَ","Those","أَشِحَّةً عَلَى ٱلْخَيْرِ ۚ","لَمْ يُؤْمِنُوا۟ فَأَحْبَطَ",55],["34:4:6",428,"أُو۟لَـٰٓئِكَ","Those","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ ۚ","لَهُم مَّغْفِرَةٌۭ وَرِزْقٌۭ",55],["34:5:6",428,"أُو۟لَـٰٓئِكَ","those","فِىٓ ءَايَـٰتِنَا مُعَـٰجِزِينَ","لَهُمْ عَذَابٌۭ مِّن",55],["34:37:14",432,"فَأُو۟لَـٰٓئِكَ","then those","ءَامَنَ وَعَمِلَ صَـٰلِحًۭا","لَهُمْ جَزَآءُ ٱلضِّعْفِ",55],["34:38:6",432,"أُو۟لَـٰٓئِكَ","those","فِىٓ ءَايَـٰتِنَا مُعَـٰجِزِينَ","فِى ٱلْعَذَابِ مُحْضَرُونَ",55],["35:10:22",435,"أُو۟لَـٰٓئِكَ","(of) those","عَذَابٌۭ شَدِيدٌۭ ۖ وَمَكْرُ","هُوَ يَبُورُ",55],["37:41:1",447,"أُو۟لَـٰٓئِكَ","Those","","لَهُمْ رِزْقٌۭ مَّعْلُومٌۭ",55],["38:13:6",453,"أُو۟لَـٰٓئِكَ","Those","لُوطٍۢ وَأَصْحَـٰبُ لْـَٔيْكَةِ ۚ","ٱلْأَحْزَابُ",55],["39:18:6",460,"أُو۟لَـٰٓئِكَ","those","ٱلْقَوْلَ ف