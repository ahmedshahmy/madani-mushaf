[["2:228:35",36,"وَلِلرِّجَالِ","and for the men","ٱلَّذِى عَلَيْهِنَّ بِٱلْمَعْرُوفِ ۚ","عَلَيْهِنَّ دَرَجَةٌۭ ۗ وَٱللَّهُ",391],["2:239:3",39,"فَرِجَالًا","then (pray) on foot","فَإِنْ خِفْتُمْ","أَوْ رُكْبَانًۭا ۖ فَإِذَآ",391],["2:282:55",48,"رِّجَالِكُمْ ۖ","your men","وَٱسْتَشْهِدُوا۟ شَهِيدَيْنِ مِن","فَإِن لَّمْ يَكُونَا",391],["2:282:59",48,"رَجُلَيْنِ","two men","فَإِن لَّمْ يَكُونَا","فَرَجُلٌۭ وَٱمْرَأَتَانِ مِمَّن",377],["2:282:60",48,"فَرَجُلٌۭ","then one man","لَّمْ يَكُونَا رَجُلَيْنِ","وَٱمْرَأَتَانِ مِمَّن تَرْضَوْنَ",377],["4:1:15",77,"رِجَالًۭا","men","زَوْجَهَا وَبَثَّ مِنْهُمَا","كَثِيرًۭا وَنِسَآءًۭ ۚ وَٱتَّقُوا۟",391],["4:7:1",78,"لِّلرِّجَالِ","For the men","","نَصِيبٌۭ مِّمَّا تَرَكَ",391],["4:12:52",79,"رَجُلٌۭ","a man","دَيْنٍۢ ۗ وَإِن كَانَ","يُورَثُ كَلَـٰلَةً أَوِ",377],["4:32:10",83,"لِّلرِّجَالِ","For men","بَعْضَكُمْ عَلَىٰ بَعْضٍۢ ۚ","نَصِيبٌۭ مِّمَّا ٱكْتَسَبُوا۟ ۖ",391],["4:34:1",84,"ٱلرِّجَالُ","[The] men","","قَوَّٰمُونَ عَلَى ٱلنِّسَآءِ",391],["4:75:10",90,"ٱلرِّجَالِ","the men","ٱللَّهِ وَٱلْمُسْتَضْعَفِينَ مِنَ","وَٱلنِّسَآءِ وَٱلْوِلْدَٰنِ ٱلَّذِينَ",391],["4:98:4",94,"ٱلرِّجَالِ","the men","إِلَّا ٱلْمُسْتَضْعَفِينَ مِنَ","وَٱلنِّسَآءِ وَٱلْوِلْدَٰنِ لَا",391],["4:176:36",106,"رِّجَالًۭا","men","وَإِن كَانُوٓا۟ إِخْوَةًۭ","وَنِسَآءًۭ فَلِلذَّكَرِ مِثْلُ",391],["5:6:15",108,"وَأَرْجُلَكُمْ","and your feet","ٱلْمَرَافِقِ وَٱمْسَحُوا۟ بِرُءُوسِكُمْ","إِلَى ٱلْكَعْبَيْنِ ۚ وَإِن",637],["5:23:2",111,"رَجُلَانِ","two men","قَالَ","مِنَ ٱلَّذِينَ يَخَافُونَ",377],["5:33:18",113,"وَأَرْجُلُهُم","and their feet","أَوْ تُقَطَّعَ أَيْدِيهِمْ","مِّنْ خِلَـٰفٍ أَوْ",637],["5:66:16",119,"أَرْجُلِهِم ۚ","their feet","فَوْقِهِمْ وَمِن تَحْتِ","مِّنْهُمْ أُمَّةٌۭ مُّقْتَصِدَةٌۭ ۖ",637],["6:9:5",129,"رَجُلًۭا","a man","جَعَلْنَـٰهُ مَلَكًۭا لَّجَعَلْنَـٰهُ","وَلَلَبَسْنَا عَلَيْهِم مَّا",377],["6:65:14",135,"أَرْجُلِكُمْ","your feet","أَوْ مِن تَحْتِ","أَوْ يَلْبِسَكُمْ شِيَعًۭا",637],["7:46:5",156,"رِجَالٌۭ","(will be) men","حِجَابٌۭ ۚ وَعَلَى ٱلْأَعْرَافِ","يَعْرِفُونَ كُلًّۢا بِسِيمَىٰهُمْ ۚ",391],["7:48:4",156,"رِجَالًۭا","(to) men","وَنَادَىٰٓ أَصْحَـٰبُ ٱلْأَعْرَافِ","يَعْرِفُونَهُم بِسِيمَىٰهُمْ قَالُوا۟",391],["7:63:8",158,"رَجُلٍۢ","a man","مِّن رَّبِّكُمْ عَلَىٰ","مِّنكُمْ لِيُنذِرَكُمْ وَلِتَتَّقُوا۟",377],["7:69:8",159,"رَجُلٍۢ","a man","مِّن رَّبِّكُمْ عَلَىٰ","مِّنكُمْ لِيُنذِرَكُمْ ۚ وَٱذْكُرُوٓا۟",377],["7:81:3",160,"ٱلرِّجَالَ","the men","إِنَّكُمْ لَتَأْتُونَ","شَهْوَةًۭ مِّن دُونِ",391],["7:124:3",165,"وَأَرْجُلَكُم","and your feet","لَأُقَطِّعَنَّ أَيْدِيَكُمْ","مِّنْ خِلَـٰفٍۢ ثُمَّ",637],["7:155:5",169,"رَجُلًۭا","men","مُوسَىٰ قَوْمَهُۥ سَبْعِينَ","لِّمِيقَـٰتِنَا ۖ فَلَمَّآ أَخَذَتْهُمُ",377],["7:195:2",175,"أَرْجُلٌۭ","feet","أَلَهُمْ","يَمْشُونَ بِهَآ ۖ أَمْ",637],["9:108:17",204,"رِجَالٌۭ","(are) men","تَقُومَ فِيهِ ۚ فِيهِ","يُحِبُّونَ أَن يَتَطَهَّرُوا۟ ۚ",391],["10:2:7",208,"رَجُلٍۢ","a man","أَنْ أَوْحَيْنَآ إِلَىٰ","مِّنْهُمْ أَنْ أَنذِرِ",377],["11:78:25",230,"رَجُلٌۭ","a man","ضَيْفِىٓ ۖ أَلَيْسَ مِنكُمْ","رَّشِيدٌۭ",377],["12:109:6",248,"رِجَالًۭا","men","مِن قَبْلِكَ إِلَّا","نُّوحِىٓ إِلَيْهِم مِّنْ",391],["16:43:6",272,"رِجَالًۭا","men","مِن قَبْلِكَ إِلَّا","نُّوحِىٓ إِلَيْهِمْ ۚ فَسْـَٔلُوٓا۟",391],["16:76:4",275,"رَّجُلَيْنِ","(of) two men","وَضَرَبَ ٱللَّهُ مَثَلًۭا","أَحَدُهُمَآ أَبْكَمُ لَا",377],["17:47:18",286,"رَجُلًۭا","a man","إِن تَتَّبِعُونَ إِلَّا","مَّسْحُورًا",377],["17:64:9",288,"وَرَجِلِكَ","and infantry","وَأَجْلِبْ عَلَيْهِم بِخَيْلِكَ","وَشَارِكْهُمْ فِى ٱلْأَمْوَٰلِ",4171],["18:32:4",297,"رَّجُلَيْنِ","of two men:","۞ وَٱضْرِبْ لَهُم مَّثَلًۭا","جَعَلْنَا لِأَحَدِهِمَا جَنَّتَيْنِ",377],["18:37:16",298,"رَجُلًۭا","(into) a man","نُّطْفَةٍۢ ثُمَّ سَوَّىٰكَ","",377],["20:71:15",316,"وَأَرْجُلَكُم","and your feet","ٱلسِّحْرَ ۖ فَلَأُقَطِّعَنَّ أَيْدِيَكُمْ","مِّنْ خِلَـٰفٍۢ وَلَأُصَلِّبَنَّكُمْ",637],["21:7:5",322,"رِجَالًۭا","men","أَرْسَلْنَا قَبْلَكَ إِلَّا","نُّوحِىٓ إِلَيْهِمْ ۖ فَسْـَٔلُوٓا۟",391],["22:27:6",335,"رِجَالًۭا","(on) foot","ٱلنَّاسِ بِٱلْحَجِّ يَأْتُوكَ","وَعَلَىٰ كُلِّ ضَامِرٍۢ",391],["23:25:4",343,"رَجُلٌۢ","a man","إِنْ هُوَ إِلَّا","بِهِۦ جِنَّةٌۭ فَتَرَبَّصُوا۟",377],["23:38:4",344,"رَجُلٌ","a man","إِنْ هُوَ إِلَّا","ٱفْتَرَىٰ عَلَى ٱللَّهِ",377],["24:24:6",352,"وَأَرْجُلُهُم","and their feet","عَلَيْهِمْ أَلْسِنَتُهُمْ وَأَيْدِيهِمْ","بِمَا كَانُوا۟ يَعْمَلُونَ",637],["24:31:54",353,"ٱلرِّجَالِ","[the] men","أُو۟لِى ٱلْإِرْبَةِ مِنَ","أَوِ ٱلطِّفْلِ ٱلَّذِينَ",391],["24:31:65",353,"بِأَرْجُلِهِنَّ","their feet","ٱلنِّسَآءِ ۖ وَلَا يَضْرِبْنَ","لِيُعْلَمَ مَا يُخْفِينَ",637],["24:37:1",355,"رِجَالٌۭ","Men","","لَّا تُلْهِيهِمْ تِجَـٰرَةٌۭ",391],["24:45:16",356,"رِجْلَيْنِ","two legs","مَّن يَمْشِى عَلَىٰ","وَمِنْهُم مَّن يَمْشِى",637],["25:8:16",360,"رَجُلًۭا","a man","إِن تَتَّبِعُونَ إِلَّا","مَّسْحُورًا",377],["26:49:17",369,"وَأَرْجُلَكُم","and your feet","تَعْلَمُونَ ۚ لَأُقَطِّعَنَّ أَيْدِيَكُمْ","مِّنْ خِلَـٰفٍۢ وَلَأُصَلِّبَنَّكُمْ",637],["27:55:3",381,"ٱلرِّجَالَ","the men","أَئِنَّكُمْ لَتَأْتُونَ","شَهْوَةًۭ مِّن دُونِ",391],["28:15:10",387,"رَجُلَيْنِ","two men","أَهْلِهَا فَوَجَدَ فِيهَا","يَقْتَتِلَانِ هَـٰذَا مِن",377],["28:20:2",387,"رَجُلٌۭ","a man","وَجَآءَ","مِّنْ أَقْصَا ٱلْمَدِينَةِ",377],["29:29:3",399,"ٱلرِّجَالَ","the men","أَئِنَّكُمْ لَتَأْتُونَ","وَتَقْطَعُونَ ٱلسَّبِيلَ وَتَأْتُونَ",391],["29:55:8",403,"أَرْجُلِهِمْ","their feet","فَوْقِهِمْ وَمِن تَحْتِ","وَيَقُولُ ذُوقُوا۟ مَا",637],["33:4:4",418,"لِرَجُلٍۢ","for any man","مَّا جَعَلَ ٱللَّهُ","مِّن قَلْبَيْنِ فِى",377],["33:23:3",421,"رِجَالٌۭ","(are) men","مِّنَ ٱلْمُؤْمِنِينَ","صَدَقُوا۟ مَا عَـٰهَدُوا۟",391],["33:40:7",423,"رِّجَالِكُمْ","your men","أَبَآ أَحَدٍۢ مِّن","وَلَـٰكِن رَّسُولَ ٱللَّهِ",391],["34:7:7",428,"رَجُلٍۢ","a man","هَلْ نَدُلُّكُمْ عَلَىٰ","يُنَبِّئُكُمْ إِذَا مُزِّقْتُمْ",377],["34:43:10",433,"رَجُلٌۭ","a man","مَا هَـٰذَآ إِلَّا","يُرِيدُ أَن يَصُدَّكُمْ",377],["36:20:5",441,"رَجُلٌۭ","a man","مِنْ أَقْصَا ٱلْمَدِينَةِ","يَسْعَىٰ قَالَ يَـٰقَوْمِ",377],["36:65:8",444,"أَرْجُلُهُم","their feet","وَتُكَلِّمُنَآ أَيْدِيهِمْ وَتَشْهَدُ","بِمَا كَانُوا۟ يَكْسِبُونَ",637],["38:42:2",455,"بِرِجْلِكَ ۖ","with your foot","ٱرْكُضْ","هَـٰذَا مُغْتَسَلٌۢ بَارِدٌۭ",637],["38:62:6",457,"رِجَالًۭا","men","لَنَا لَا نَرَىٰ","كُنَّا نَعُدُّهُم مِّنَ",391],["39:29:4",461,"رَّجُلًۭا","a man","ضَرَبَ ٱللَّهُ مَثَلًۭا","فِيهِ شُرَكَآءُ مُتَشَـٰكِسُونَ",377],["39:29:8",461,"وَرَجُلًۭا","and a man","فِيهِ شُرَكَآءُ مُتَشَـٰكِسُونَ","سَلَمًۭا لِّرَجُلٍ هَلْ",377],["39:29:10",461,"لِّرَجُلٍ","to one man","مُتَشَـٰكِسُونَ وَرَجُلًۭا سَلَمًۭا","هَلْ يَسْتَوِيَانِ مَثَلًا ۚ",377],["40:28:2",470,"رَجُلٌۭ","a man","وَقَالَ","مُّؤْمِنٌۭ مِّنْ ءَالِ",377],["40:28:10",470,"رَجُلًا","a man","يَكْتُمُ إِيمَـٰنَهُۥٓ أَتَقْتُلُونَ","أَن يَقُولَ رَبِّىَ",377],["43:31:7",491,"رَجُلٍۢ","a man","هَـٰذَا ٱلْقُرْءَانُ عَلَىٰ","مِّنَ ٱلْقَرْيَتَيْنِ عَظِيمٍ",377],["48:25:14",514,"رِجَالٌۭ","(for) men","يَبْلُغَ مَحِلَّهُۥ ۚ وَلَوْلَا","مُّؤْمِنُونَ وَنِسَآءٌۭ مُّؤْمِنَـٰتٌۭ",391],["60:12:26",551,"وَأَرْجُلِهِنَّ","and their feet","يَفْتَرِينَهُۥ بَيْنَ أَيْدِيهِنَّ","وَلَا يَعْصِينَكَ فِى",637],["72:6:3",572,"رِجَالٌۭ","men","وَأَنَّهُۥ كَانَ","مِّنَ ٱلْإِنسِ يَعُوذُونَ",391],["72:6:7",572,"بِرِجَالٍۢ","in (the) men","مِّنَ ٱلْإِنسِ يَعُوذُونَ","مِّنَ ٱلْجِنِّ فَزَادُوهُمْ",391]]