[["21:103:3",331,"ٱلْفَزَعُ","the terror","لَا يَحْزُنُهُمُ","ٱلْأَكْبَرُ وَتَتَلَقَّىٰهُمُ ٱلْمَلَـٰٓئِكَةُ",2365],["27:87:5",384,"فَفَزِعَ","and will be terrified","يُنفَخُ فِى ٱلصُّورِ","مَن فِى ٱلسَّمَـٰوَٰتِ",1834],["27:89:9",385,"فَزَعٍۢ","(the) terror","مِّنْهَا وَهُم مِّن","يَوْمَئِذٍ ءَامِنُونَ",2365],["34:23:11",431,"فُزِّعَ","fear is removed","لَهُۥ ۚ حَتَّىٰٓ إِذَا","عَن قُلُوبِهِمْ قَالُوا۟",3447],["34:51:4",434,"فَزِعُوا۟","they will be terrified","وَلَوْ تَرَىٰٓ إِذْ","فَلَا فَوْتَ وَأُخِذُوا۟",1834],["38:22:5",454,"فَفَزِعَ","and he was afraid","دَخَلُوا۟ عَلَىٰ دَاوُۥدَ","مِنْهُمْ ۖ قَالُوا۟ لَا",1834]]