[["3:125:11",66,"بِخَمْسَةِ","with five","هَـٰذَا يُمْدِدْكُمْ رَبُّكُم","ءَالَـٰفٍۢ مِّنَ ٱلْمَلَـٰٓئِكَةِ",2041],["8:41:8",182,"خُمُسَهُۥ","(is) one fifth of it","شَىْءٍۢ فَأَنَّ لِلَّهِ","وَلِلرَّسُولِ وَلِذِى ٱلْقُرْبَىٰ",4595],["18:22:6",296,"خَمْسَةٌۭ","(they were) five","رَّابِعُهُمْ كَلْبُهُمْ وَيَقُولُونَ","سَادِسُهُمْ كَلْبُهُمْ رَجْمًۢا",2041],["24:7:1",350,"وَٱلْخَـٰمِسَةُ","And the fifth","","أَنَّ لَعْنَتَ ٱللَّهِ",2731],["24:9:1",350,"وَٱلْخَـٰمِسَةَ","And the fifth","","أَنَّ غَضَبَ ٱللَّهِ",2731],["29:14:11",397,"خَمْسِينَ","fifty","أَلْفَ سَنَةٍ إِلَّا","عَامًۭا فَأَخَذَهُمُ ٱلطُّوفَانُ",2738],["58:7:21",543,"خَمْسَةٍ","five","هُوَ رَابِعُهُمْ وَلَا","إِلَّا هُوَ سَادِسُهُمْ",2041],["70:4:9",568,"خَمْسِينَ","(is) fifty","يَوْمٍۢ كَانَ مِقْدَارُهُۥ","أَلْفَ سَنَةٍۢ",2738]]