[["2:96:13",15,"أَلْفَ","(of) a thousand","أَحَدُهُمْ لَوْ يُعَمَّرُ","سَنَةٍۢ وَمَا هُوَ",647],["2:243:9",39,"أُلُوفٌ","(were in) thousands","مِن دِيَـٰرِهِمْ وَهُمْ","حَذَرَ ٱلْمَوْتِ فَقَالَ",647],["3:103:14",63,"فَأَلَّفَ","then He made friendship","إِذْ كُنتُمْ أَعْدَآءًۭ","بَيْنَ قُلُوبِكُمْ فَأَصْبَحْتُم",1274],["3:124:10",66,"ءَالَـٰفٍۢ","thousand[s]","يُمِدَّكُمْ رَبُّكُم بِثَلَـٰثَةِ","مِّنَ ٱلْمَلَـٰٓئِكَةِ مُنزَلِينَ",647],["3:125:12",66,"ءَالَـٰفٍۢ","thousand[s]","يُمْدِدْكُمْ رَبُّكُم بِخَمْسَةِ","مِّنَ ٱلْمَلَـٰٓئِكَةِ مُسَوِّمِينَ",647],["8:9:8",178,"بِأَلْفٍۢ","with a thousand","لَكُمْ أَنِّى مُمِدُّكُم","مِّنَ ٱلْمَلَـٰٓئِكَةِ مُرْدِفِينَ",647],["8:63:1",185,"وَأَلَّفَ","And He (has) put affection","","بَيْنَ قُلُوبِهِمْ ۚ لَوْ",1274],["8:63:11",185,"أَلَّفْتَ","(could) you (have) put affection","ٱلْأَرْضِ جَمِيعًۭا مَّآ","بَيْنَ قُلُوبِهِمْ وَلَـٰكِنَّ",1274],["8:63:16",185,"أَلَّفَ","(has) put affection","قُلُوبِهِمْ وَلَـٰكِنَّ ٱللَّهَ","بَيْنَهُمْ ۚ إِنَّهُۥ عَزِيزٌ",1274],["8:65:19",185,"أَلْفًۭا","a thousand","مِّنكُم مِّا۟ئَةٌۭ يَغْلِبُوٓا۟","مِّنَ ٱلَّذِينَ كَفَرُوا۟",647],["8:66:19",185,"أَلْفٌۭ","a thousand","وَإِن يَكُن مِّنكُمْ","يَغْلِبُوٓا۟ أَلْفَيْنِ بِإِذْنِ",647],["8:66:21",185,"أَلْفَيْنِ","two thousand","مِّنكُمْ أَلْفٌۭ يَغْلِبُوٓا۟","بِإِذْنِ ٱللَّهِ ۗ وَٱللَّهُ",647],["9:60:7",196,"وَٱلْمُؤَلَّفَةِ","and the ones inclined","وَٱلْمَسَـٰكِينِ وَٱلْعَـٰمِلِينَ عَلَيْهَا","قُلُوبُهُمْ وَفِى ٱلرِّقَابِ",3749],["22:47:11",338,"كَأَلْفِ","(is) like a thousand","يَوْمًا عِندَ رَبِّكَ","سَنَةٍۢ مِّمَّا تَعُدُّونَ",647],["24:43:8",355,"يُؤَلِّفُ","joins","يُزْجِى سَحَابًۭا ثُمَّ","بَيْنَهُۥ ثُمَّ يَجْعَلُهُۥ",1274],["29:14:8",397,"أَلْفَ","a thousand","قَوْمِهِۦ فَلَبِثَ فِيهِمْ","سَنَةٍ إِلَّا خَمْسِينَ",647],["32:5:14",415,"أَلْفَ","a thousand","يَوْمٍۢ كَانَ مِقْدَارُهُۥٓ","سَنَةٍۢ مِّمَّا تَعُدُّونَ",647],["37:147:4",451,"أَلْفٍ","thousand","وَأَرْسَلْنَـٰهُ إِلَىٰ مِا۟ئَةِ","أَوْ يَزِيدُونَ",647],["70:4:10",568,"أَلْفَ","thousand","كَانَ مِقْدَارُهُۥ خَمْسِينَ","سَنَةٍۢ",647],["97:3:5",598,"أَلْفِ","a thousand","ٱلْقَدْرِ خَيْرٌۭ مِّنْ","شَهْرٍۢ",647],["106:1:1",602,"لِإِيلَـٰفِ","For (the) familiarity","","قُرَيْشٍ",2141],["106:2:1",602,"إِۦلَـٰفِهِمْ","Their familiarity","","رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ",2141]]