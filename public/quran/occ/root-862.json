[["4:43:19",85,"تَغْتَسِلُوا۟ ۚ","you have bathed","عَابِرِى سَبِيلٍ حَتَّىٰ","وَإِن كُنتُم مَّرْضَىٰٓ",4377],["5:6:8",108,"فَٱغْسِلُوا۟","then wash","قُمْتُمْ إِلَى ٱلصَّلَوٰةِ","وُجُوهَكُمْ وَأَيْدِيَكُمْ إِلَى",4795],["38:42:4",455,"مُغْتَسَلٌۢ","(is a spring of) water to bathe","ٱرْكُضْ بِرِجْلِكَ ۖ هَـٰذَا","بَارِدٌۭ وَشَرَابٌۭ",3804],["69:36:5",568,"غِسْلِينٍۢ","(the) discharge of wounds","طَعَامٌ إِلَّا مِنْ","",3474]]