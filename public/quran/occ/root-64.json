[["2:49:7",8,"سُوٓءَ","horrible","ءَالِ فِرْعَوْنَ يَسُومُونَكُمْ","ٱلْعَذَابِ يُذَبِّحُونَ أَبْنَآءَكُمْ",238],["2:81:4",12,"سَيِّئَةًۭ","evil","بَلَىٰ مَن كَسَبَ","وَأَحَـٰطَتْ بِهِۦ خَطِيٓـَٔتُهُۥ",477],["2:169:3",25,"بِٱلسُّوٓءِ","to (do) the evil","إِنَّمَا يَأْمُرُكُم","وَٱلْفَحْشَآءِ وَأَن تَقُولُوا۟",238],["2:271:16",46,"سَيِّـَٔاتِكُمْ ۗ","your evil deeds","وَيُكَفِّرُ عَنكُم مِّن","وَٱللَّهُ بِمَا تَعْمَلُونَ",325],["3:30:13",54,"سُوٓءٍۢ","evil","وَمَا عَمِلَتْ مِن","تَوَدُّ لَوْ أَنَّ",238],["3:120:4",65,"تَسُؤْهُمْ","it grieves them","إِن تَمْسَسْكُمْ حَسَنَةٌۭ","وَإِن تُصِبْكُمْ سَيِّئَةٌۭ",367],["3:120:7",65,"سَيِّئَةٌۭ","misfortune","تَسُؤْهُمْ وَإِن تُصِبْكُمْ","يَفْرَحُوا۟ بِهَا ۖ وَإِن",477],["3:174:8",73,"سُوٓءٌۭ","any harm","وَفَضْلٍۢ لَّمْ يَمْسَسْهُمْ","وَٱتَّبَعُوا۟ رِضْوَٰنَ ٱللَّهِ ۗ",238],["3:193:17",75,"سَيِّـَٔاتِنَا","our evil deeds","ذُنُوبَنَا وَكَفِّرْ عَنَّا","وَتَوَفَّنَا مَعَ ٱلْأَبْرَارِ",325],["3:195:29",76,"سَيِّـَٔاتِهِمْ","their evil deeds","وَقُتِلُوا۟ لَأُكَفِّرَنَّ عَنْهُمْ","وَلَأُدْخِلَنَّهُمْ جَنَّـٰتٍۢ تَجْرِى",325],["4:17:7",80,"ٱلسُّوٓءَ","the evil","ٱللَّهِ لِلَّذِينَ يَعْمَلُونَ","بِجَهَـٰلَةٍۢ ثُمَّ يَتُوبُونَ",238],["4:18:5",80,"ٱلسَّيِّـَٔاتِ","the evil deeds","ٱلتَّوْبَةُ لِلَّذِينَ يَعْمَلُونَ","حَتَّىٰٓ إِذَا حَضَرَ",325],["4:22:16",81,"وَسَآءَ","and (an) evil","كَانَ فَـٰحِشَةًۭ وَمَقْتًۭا","سَبِيلًا",367],["4:31:9",83,"سَيِّـَٔاتِكُمْ","your evil deeds","عَنْهُ نُكَفِّرْ عَنكُمْ","وَنُدْخِلْكُم مُّدْخَلًۭا كَرِيمًۭا",325],["4:38:17",85,"فَسَآءَ","then evil","ٱلشَّيْطَـٰنُ لَهُۥ قَرِينًۭا","قَرِينًۭا",367],["4:78:20",90,"سَيِّئَةٌۭ","any evil","ٱللَّهِ ۖ وَإِن تُصِبْهُمْ","يَقُولُوا۟ هَـٰذِهِۦ مِنْ",477],["4:79:10",90,"سَيِّئَةٍۢ","(the) evil","وَمَآ أَصَابَكَ مِن","فَمِن نَّفْسِكَ ۚ وَأَرْسَلْنَـٰكَ",477],["4:85:12",91,"سَيِّئَةًۭ","evil","وَمَن يَشْفَعْ شَفَـٰعَةًۭ","يَكُن لَّهُۥ كِفْلٌۭ",477],["4:97:26",94,"وَسَآءَتْ","and it is an evil","فَأُو۟لَـٰٓئِكَ مَأْوَىٰهُمْ جَهَنَّمُ ۖ","مَصِيرًا",367],["4:110:3",96,"سُوٓءًا","evil","وَمَن يَعْمَلْ","أَوْ يَظْلِمْ نَفْسَهُۥ",238],["4:115:19",97,"وَسَآءَتْ","and evil it is","تَوَلَّىٰ وَنُصْلِهِۦ جَهَنَّمَ ۖ","مَصِيرًا",367],["4:123:9",98,"سُوٓءًۭا","evil","ٱلْكِتَـٰبِ ۗ مَن يَعْمَلْ","يُجْزَ بِهِۦ وَلَا",238],["4:148:5",102,"بِٱلسُّوٓءِ","of [the] evil","يُحِبُّ ٱللَّهُ ٱلْجَهْرَ","مِنَ ٱلْقَوْلِ إِلَّا",238],["4:149:9",102,"سُوٓءٍۢ","an evil","أَوْ تَعْفُوا۟ عَن","فَإِنَّ ٱللَّهَ كَانَ",238],["5:12:30",109,"سَيِّـَٔاتِكُمْ","your evil deeds","حَسَنًۭا لَّأُكَفِّرَنَّ عَنكُمْ","وَلَأُدْخِلَنَّكُمْ جَنَّـٰتٍۢ تَجْرِى",325],["5:31:10",112,"سَوْءَةَ","(the) dead body","لِيُرِيَهُۥ كَيْفَ يُوَٰرِى","أَخِيهِ ۚ قَالَ يَـٰوَيْلَتَىٰٓ",2631],["5:31:21",112,"سَوْءَةَ","(the) dead body","هَـٰذَا ٱلْغُرَابِ فَأُوَٰرِىَ","أَخِى ۖ فَأَصْبَحَ مِنَ",2631],["5:65:9",119,"سَيِّـَٔاتِهِمْ","their evil (deeds)","وَٱتَّقَوْا۟ لَكَفَّرْنَا عَنْهُمْ","وَلَأَدْخَلْنَـٰهُمْ جَنَّـٰتِ ٱلنَّعِيمِ",325],["5:66:22",119,"سَآءَ","evil","مُّقْتَصِدَةٌۭ ۖ وَكَثِيرٌۭ مِّنْهُمْ","مَا يَعْمَلُونَ",367],["5:101:11",124,"تَسُؤْكُمْ","it may distress you","إِن تُبْدَ لَكُمْ","وَإِن تَسْـَٔلُوا۟ عَنْهَا",367],["6:31:24",131,"سَآءَ","Evil","عَلَىٰ ظُهُورِهِمْ ۚ أَلَا","مَا يَزِرُونَ",367],["6:54:18",134,"سُوٓءًۢا","evil","مَنْ عَمِلَ مِنكُمْ","بِجَهَـٰلَةٍۢ ثُمَّ تَابَ",238],["6:136:29",145,"سَآءَ","Evil","يَصِلُ إِلَىٰ شُرَكَآئِهِمْ ۗ","مَا يَحْكُمُونَ",367],["6:157:31",149,"سُوٓءَ","(with) an evil","يَصْدِفُونَ عَنْ ءَايَـٰتِنَا","ٱلْعَذَابِ بِمَا كَانُوا۟",238],["6:160:9",150,"بِٱلسَّيِّئَةِ","with an evil deed","أَمْثَالِهَا ۖ وَمَن جَآءَ","فَلَا يُجْزَىٰٓ إِلَّا",477],["7:20:10",152,"سَوْءَٰتِهِمَا","their shame","وُۥرِىَ عَنْهُمَا مِن","وَقَالَ مَا نَهَىٰكُمَا",1395],["7:22:8",152,"سَوْءَٰتُهُمَا","their shame","ٱلشَّجَرَةَ بَدَتْ لَهُمَا","وَطَفِقَا يَخْصِفَانِ عَلَيْهِمَا",1395],["7:26:8",153,"سَوْءَٰتِكُمْ","your shame","عَلَيْكُمْ لِبَاسًۭا يُوَٰرِى","وَرِيشًۭا ۖ وَلِبَاسُ ٱلتَّقْوَىٰ",1395],["7:27:15",153,"سَوْءَٰتِهِمَآ ۗ","their shame","عَنْهُمَا لِبَاسَهُمَا لِيُرِيَهُمَا","إِنَّهُۥ يَرَىٰكُمْ هُوَ",1395],["7:73:31",159,"بِسُوٓءٍۢ","with harm","ٱللَّهِ ۖ وَلَا تَمَسُّوهَا","فَيَأْخُذَكُمْ عَذَابٌ أَلِيمٌۭ",238],["7:95:4",162,"ٱلسَّيِّئَةِ","(of) the bad","ثُمَّ بَدَّلْنَا مَكَانَ","ٱلْحَسَنَةَ حَتَّىٰ عَفَوا۟",477],["7:131:9",166,"سَيِّئَةٌۭ","bad","هَـٰذِهِۦ ۖ وَإِن تُصِبْهُمْ","يَطَّيَّرُوا۟ بِمُوسَىٰ وَمَن",477],["7:141:7",167,"سُوٓءَ","(with) worst","ءَالِ فِرْعَوْنَ يَسُومُونَكُمْ","ٱلْعَذَابِ ۖ يُقَتِّلُونَ أَبْنَآءَكُمْ",238],["7:153:3",169,"ٱلسَّيِّـَٔاتِ","the evil deeds","وَٱلَّذِينَ عَمِلُوا۟","ثُمَّ تَابُوا۟ مِنۢ",325],["7:165:10",172,"ٱلسُّوٓءِ","the evil","ٱلَّذِينَ يَنْهَوْنَ عَنِ","وَأَخَذْنَا ٱلَّذِينَ ظَلَمُوا۟",238],["7:167:11",172,"سُوٓءَ","(with) a grievous","ٱلْقِيَـٰمَةِ مَن يَسُومُهُمْ","ٱلْعَذَابِ ۗ إِنَّ رَبَّكَ",238],["7:168:12",172,"وَٱلسَّيِّـَٔاتِ","and the bad","ذَٰلِكَ ۖ وَبَلَوْنَـٰهُم بِٱلْحَسَنَـٰتِ","لَعَلَّهُمْ يَرْجِعُونَ",325],["7:177:1",173,"سَآءَ","Evil","","مَثَلًا ٱلْقَوْمُ ٱلَّذِينَ",367],["7:188:21",175,"ٱلسُّوٓءُ ۚ","the evil","ٱلْخَيْرِ وَمَا مَسَّنِىَ","إِنْ أَنَا۠ إِلَّا",238],["8:29:12",180,"سَيِّـَٔاتِكُمْ","your evil deeds","فُرْقَانًۭا وَيُكَفِّرْ عَنكُمْ","وَيَغْفِرْ لَكُمْ ۗ وَٱللَّهُ",325],["9:9:10",188,"سَآءَ","evil","عَن سَبِيلِهِۦٓ ۚ إِنَّهُمْ","مَا كَانُوا۟ يَعْمَلُونَ",367],["9:37:25",193,"سُوٓءُ","(the) evil","ٱللَّهُ ۚ زُيِّنَ لَهُمْ","أَعْمَـٰلِهِمْ ۗ وَٱللَّهُ لَا",238],["9:50:4",195,"تَسُؤْهُمْ ۖ","it distresses them","إِن تُصِبْكَ حَسَنَةٌۭ","وَإِن تُصِبْكَ مُصِيبَةٌۭ",367],["9:98:13",202,"ٱلسَّوْءِ ۗ","(of) the evil","ٱلدَّوَآئِرَ ۚ عَلَيْهِمْ دَآئِرَةُ","وَٱللَّهُ سَمِيعٌ عَلِيمٌۭ",924],["9:102:8",203,"سَيِّئًا","(that was) evil","عَمَلًۭا صَـٰلِحًۭا وَءَاخَرَ","عَسَى ٱللَّهُ أَن",1642],["10:27:3",212,"ٱلسَّيِّـَٔاتِ","the evil deeds","وَٱلَّذِينَ كَسَبُوا۟","جَزَآءُ سَيِّئَةٍۭ بِمِثْلِهَا",325],["10:27:5",212,"سَيِّئَةٍۭ","(of) an evil deed","كَسَبُوا۟ ٱلسَّيِّـَٔاتِ جَزَآءُ","بِمِثْلِهَا وَتَرْهَقُهُمْ ذِلَّةٌۭ ۖ",477],["11:10:9",222,"ٱلسَّيِّـَٔاتُ","the evils","مَسَّتْهُ لَيَقُولَنَّ ذَهَبَ","عَنِّىٓ ۚ إِنَّهُۥ لَفَرِحٌۭ",325],["11:54:7",228,"بِسُوٓءٍۢ ۗ","with evil","ٱعْتَرَىٰكَ بَعْضُ ءَالِهَتِنَا","قَالَ إِنِّىٓ أُشْهِدُ",238],["11:64:14",229,"بِسُوٓءٍۢ","with harm","ٱللَّهِ وَلَا تَمَسُّوهَا","فَيَأْخُذَكُمْ عَذَابٌۭ قَرِيبٌۭ",238],["11:77:5",230,"سِىٓءَ","he was distressed","جَآءَتْ رُسُلُنَا لُوطًۭا","بِهِمْ وَضَاقَ بِهِمْ",367],["11:78:9",230,"ٱلسَّيِّـَٔاتِ ۚ","the evil deeds","قَبْلُ كَانُوا۟ يَعْمَلُونَ","قَالَ يَـٰقَوْمِ هَـٰٓؤُلَآءِ",325],["11:114:11",234,"ٱلسَّيِّـَٔاتِ ۚ","the evil deeds","إِنَّ ٱلْحَسَنَـٰتِ يُذْهِبْنَ","ذَٰلِكَ ذِكْرَىٰ لِلذَّٰكِرِينَ",325],["12:24:14",238,"ٱلسُّوٓءَ","the evil","كَذَٰلِكَ لِنَصْرِفَ عَنْهُ","وَٱلْفَحْشَآءَ ۚ إِنَّهُۥ مِنْ",238],["12:25:17",238,"سُوٓءًا","evil","مَنْ أَرَادَ بِأَهْلِكَ","إِلَّآ أَن يُسْجَنَ",238],["12:51:16",241,"سُوٓءٍۢ ۚ","evil","عَلِمْنَا عَلَيْهِ مِن","قَالَتِ ٱمْرَأَتُ ٱلْعَزِيزِ",238],["12:53:7",242,"بِٱلسُّوٓءِ","of evil","إِنَّ ٱلنَّفْسَ لَأَمَّارَةٌۢ","إِلَّا مَا رَحِمَ",238],["13:6:2",250,"بِٱلسَّيِّئَةِ","the evil","وَيَسْتَعْجِلُونَكَ","قَبْلَ ٱلْحَسَنَةِ وَقَدْ",477],["13:11:26",250,"سُوٓءًۭا","misfortune","أَرَادَ ٱللَّهُ بِقَوْمٍۢ","فَلَا مَرَدَّ لَهُۥ ۚ",238],["13:18:22",251,"سُوٓءُ","(is) a terrible","بِهِۦٓ ۚ أُو۟لَـٰٓئِكَ لَهُمْ","ٱلْحِسَابِ وَمَأْوَىٰهُمْ جَهَنَّمُ ۖ",238],["13:21:12",252,"سُوٓءَ","(of) the evil","وَيَخْشَوْنَ رَبَّهُمْ وَيَخَافُونَ","ٱلْحِسَابِ",238],["13:22:15",252,"ٱلسَّيِّئَةَ","the evil","وَعَلَانِيَةًۭ وَيَدْرَءُونَ بِٱلْحَسَنَةِ","أُو۟لَـٰٓئِكَ لَهُمْ عُقْبَى",477],["13:25:22",252,"سُوٓءُ","(is) an evil","لَهُمُ ٱللَّعْنَةُ وَلَهُمْ","ٱلدَّارِ",238],["14:6:15",256,"سُوٓءَ","(with) evil","ءَالِ فِرْعَوْنَ يَسُومُونَكُمْ","ٱلْعَذَابِ وَيُذَبِّحُونَ أَبْنَآءَكُمْ",238],["16:25:13",269,"سَآءَ","evil","بِغَيْرِ عِلْمٍ ۗ أَلَا","مَا يَزِرُونَ",367],["16:27:19",270,"وَٱلسُّوٓءَ","and evil","إِنَّ ٱلْخِزْىَ ٱلْيَوْمَ","عَلَى ٱلْكَـٰفِرِينَ",238],["16:28:12",270,"سُوٓءٍۭ ۚ","evil","كُنَّا نَعْمَلُ مِن","بَلَىٰٓ إِنَّ ٱللَّهَ",238],["16:34:2",270,"سَيِّـَٔاتُ","(the) evil (results)","فَأَصَابَهُمْ","مَا عَمِلُوا۟ وَحَاقَ",325],["16:45:4",272,"ٱلسَّيِّـَٔاتِ","the evil deeds","أَفَأَمِنَ ٱلَّذِينَ مَكَرُوا۟","أَن يَخْسِفَ ٱللَّهُ",325],["16:59:5",273,"سُوٓءِ","the evil","مِنَ ٱلْقَوْمِ مِن","مَا بُشِّرَ بِهِۦٓ ۚ",238],["16:59:17",273,"سَآءَ","evil","فِى ٱلتُّرَابِ ۗ أَلَا","مَا يَحْكُمُونَ",367],["16:60:6",273,"ٱلسَّوْءِ ۖ","(of) the evil","يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ مَثَلُ","وَلِلَّهِ ٱلْمَثَلُ ٱلْأَعْلَىٰ ۚ",924],["16:94:11",278,"ٱلسُّوٓءَ","the evil","بَعْدَ ثُبُوتِهَا وَتَذُوقُوا۟","بِمَا صَدَدتُّمْ عَن",238],["16:119:6",281,"ٱلسُّوٓءَ","evil","رَبَّكَ لِلَّذِينَ عَمِلُوا۟","بِجَهَـٰلَةٍۢ ثُمَّ تَابُوا۟",238],["17:7:6",282,"أَسَأْتُمْ","you do evil","أَحْسَنتُمْ لِأَنفُسِكُمْ ۖ وَإِنْ","فَلَهَا ۚ فَإِذَا جَآءَ",1278],["17:7:12",282,"لِيَسُـۥٓـُٔوا۟","to sadden","جَآءَ وَعْدُ ٱلْـَٔاخِرَةِ","وُجُوهَكُمْ وَلِيَدْخُلُوا۟ ٱلْمَسْجِدَ",367],["17:32:7",285,"وَسَآءَ","and (an) evil","إِنَّهُۥ كَانَ فَـٰحِشَةًۭ","سَبِيلًۭا",367],["17:38:4",285,"سَيِّئُهُۥ","[its] evil","كُلُّ ذَٰلِكَ كَانَ","عِندَ رَبِّكَ مَكْرُوهًۭا",1642],["18:29:27",297,"وَسَآءَتْ","and evil","ٱلْوُجُوهَ ۚ بِئْسَ ٱلشَّرَابُ","مُرْتَفَقًا",367],["19:28:7",307,"سَوْءٍۢ","an evil man","كَانَ أَبُوكِ ٱمْرَأَ","وَمَا كَانَتْ أُمُّكِ",924],["20:22:9",313,"سُوٓءٍ","disease","بَيْضَآءَ مِنْ غَيْرِ","ءَايَةً أُخْرَىٰ",238],["20:101:3",319,"وَسَآءَ","and evil","خَـٰلِدِينَ فِيهِ ۖ","لَهُمْ يَوْمَ ٱلْقِيَـٰمَةِ",367],["20:121:5",320,"سَوْءَٰتُهُمَا","their shame","مِنْهَا فَبَدَتْ لَهُمَا","وَطَفِقَا يَخْصِفَانِ عَلَيْهِمَا",1395],["21:74:15",328,"سَوْءٍۢ","evil","إِنَّهُمْ كَانُوا۟ قَوْمَ","فَـٰسِقِينَ",924],["21:77:10",328,"سَوْءٍۢ","evil","إِنَّهُمْ كَانُوا۟ قَوْمَ","فَأَغْرَقْنَـٰهُمْ أَجْمَعِينَ",924],["23:96:5",348,"ٱلسَّيِّئَةَ ۚ","the evil","بِٱلَّتِى هِىَ أَحْسَنُ","نَحْنُ أَعْلَمُ بِمَا",477],["25:40:8",363,"ٱلسَّوْءِ ۚ","(of) evil","ٱلَّتِىٓ أُمْطِرَتْ مَطَرَ","أَفَلَمْ يَكُونُوا۟ يَرَوْنَهَا ۚ",924],["25:66:2",365,"سَآءَتْ","(is) an evil","إِنَّهَا","مُسْتَقَرًّۭا وَمُقَامًۭا",367],["25:70:11",366,"سَيِّـَٔاتِهِمْ","their evil deeds","فَأُو۟لَـٰٓئِكَ يُبَدِّلُ ٱللَّهُ","حَسَنَـٰتٍۢ ۗ وَكَانَ ٱللَّهُ",325],["26:156:3",373,"بِسُوٓءٍۢ","with harm","وَلَا تَمَسُّوهَا","فَيَأْخُذَكُمْ عَذَابُ يَوْمٍ",238],["26:173:4",374,"فَسَآءَ","and evil was","وَأَمْطَرْنَا عَلَيْهِم مَّطَرًۭا ۖ","مَطَرُ ٱلْمُنذَرِينَ",367],["27:5:4",377,"سُوٓءُ","(is) an evil","أُو۟لَـٰٓئِكَ ٱلَّذِينَ لَهُمْ","ٱلْعَذَابِ وَهُمْ فِى",238],["27:11:8",377,"سُوٓءٍۢ","evil","بَدَّلَ حُسْنًۢا بَعْدَ","فَإِنِّى غَفُورٌۭ رَّحِيمٌۭ",238],["27:12:9",377,"سُوٓءٍۢ ۖ","harm","بَيْضَآءَ مِنْ غَيْرِ","فِى تِسْعِ ءَايَـٰتٍ",238],["27:46:5",381,"بِٱلسَّيِّئَةِ","the evil","يَـٰقَوْمِ لِمَ تَسْتَعْجِلُونَ","قَبْلَ ٱلْحَسَنَةِ ۖ لَوْلَا",477],["27:58:4",382,"فَسَآءَ","and was evil","وَأَمْطَرْنَا عَلَيْهِم مَّطَرًۭا ۖ","مَطَرُ ٱلْمُنذَرِينَ",367],["27:62:7",382,"ٱلسُّوٓءَ","the evil","إِذَا دَعَاهُ وَيَكْشِفُ","وَيَجْعَلُكُمْ خُلَفَآءَ ٱلْأَرْضِ ۗ",238],["27:90:3",385,"بِٱلسَّيِّئَةِ","with the evil","وَمَن جَآءَ","فَكُبَّتْ وُجُوهُهُمْ فِى",477],["28:32:9",389,"سُوٓءٍۢ","any harm","بَيْضَآءَ مِنْ غَيْرِ","وَٱضْمُمْ إِلَيْكَ جَنَاحَكَ",238],["28:54:9",392,"ٱلسَّيِّئَةَ","the evil","صَبَرُوا۟ وَيَدْرَءُونَ بِٱلْحَسَنَةِ","وَمِمَّا رَزَقْنَـٰهُمْ يُنفِقُونَ",477],["28:84:9",395,"بِٱلسَّيِّئَةِ","with an evil (deed)","مِّنْهَا ۖ وَمَن جَآءَ","فَلَا يُجْزَى ٱلَّذِينَ",477],["28:84:14",395,"ٱلسَّيِّـَٔاتِ","the evil (deeds)","يُجْزَى ٱلَّذِينَ عَمِلُوا۟","إِلَّا مَا كَانُوا۟",325],["29:4:5",396,"ٱلسَّيِّـَٔاتِ","evil deeds","حَسِبَ ٱلَّذِينَ يَعْمَلُونَ","أَن يَسْبِقُونَا ۚ سَآءَ",325],["29:4:8",396,"سَآءَ","Evil is","ٱلسَّيِّـَٔاتِ أَن يَسْبِقُونَا ۚ","مَا يَحْكُمُونَ",367],["29:7:7",397,"سَيِّـَٔاتِهِمْ","their evil deeds","ٱلصَّـٰلِحَـٰتِ لَنُكَفِّرَنَّ عَنْهُمْ","وَلَنَجْزِيَنَّهُمْ أَحْسَنَ ٱلَّذِى",325],["29:33:6",400,"سِىٓءَ","he was distressed","جَآءَتْ رُسُلُنَا لُوطًۭا","بِهِمْ وَضَاقَ بِهِمْ",367],["30:10:5",405,"أَسَـٰٓـُٔوا۟","did evil","كَانَ عَـٰقِبَةَ ٱلَّذِينَ","ٱلسُّوٓأَىٰٓ أَن كَذَّبُوا۟",1278],["30:10:6",405,"ٱلسُّوٓأَىٰٓ","the evil","عَـٰقِبَةَ ٱلَّذِينَ أَسَـٰٓـُٔوا۟","أَن كَذَّبُوا۟ بِـَٔايَـٰتِ",4302],["30:36:9",408,"سَيِّئَةٌۢ","an evil","بِهَا ۖ وَإِن تُصِبْهُمْ","بِمَا قَدَّمَتْ أَيْدِيهِمْ",477],["33:17:11",420,"سُوٓءًا","any harm","إِنْ أَرَادَ بِكُمْ","أَوْ أَرَادَ بِكُمْ",238],["35:8:4",435,"سُوٓءُ","(the) evil","أَفَمَن زُيِّنَ لَهُۥ","عَمَلِهِۦ فَرَءَاهُ حَسَنًۭا ۖ",238],["35:10:17",435,"ٱلسَّيِّـَٔاتِ","the evil","يَرْفَعُهُۥ ۚ وَٱلَّذِينَ يَمْكُرُونَ","لَهُمْ عَذَابٌۭ شَدِيدٌۭ ۖ",325],["35:43:5",439,"ٱلسَّيِّئِ ۚ","(of) the evil","فِى ٱلْأَرْضِ وَمَكْرَ","وَلَا يَحِيقُ ٱلْمَكْرُ",1642],["35:43:9",439,"ٱلسَّيِّئُ","(of) the evil","وَلَا يَحِيقُ ٱلْمَكْرُ","إِلَّا بِأَهْلِهِۦ ۚ فَهَلْ",1642],["37:177:4",452,"فَسَآءَ","then evil (will be)","فَإِذَا نَزَلَ بِسَاحَتِهِمْ","صَبَاحُ ٱلْمُنذَرِينَ",367],["39:24:4",461,"سُوٓءَ","(the) worst","أَفَمَن يَتَّقِى بِوَجْهِهِۦ","ٱلْعَذَابِ يَوْمَ ٱلْقِيَـٰمَةِ ۚ",238],["39:35:4",462,"أَسْوَأَ","(the) worst","لِيُكَفِّرَ ٱللَّهُ عَنْهُمْ","ٱلَّذِى عَمِلُوا۟ وَيَجْزِيَهُمْ",2194],["39:47:14",463,"سُوٓءِ","(the) evil","لَٱفْتَدَوْا۟ بِهِۦ مِن","ٱلْعَذَابِ يَوْمَ ٱلْقِيَـٰمَةِ ۚ",238],["39:48:3",464,"سَيِّـَٔاتُ","(the) evils","وَبَدَا لَهُمْ","مَا كَسَبُوا۟ وَحَاقَ",325],["39:51:2",464,"سَيِّـَٔاتُ","(the) evils","فَأَصَابَهُمْ","مَا كَسَبُوا۟ ۚ وَٱلَّذِينَ",325],["39:51:10",464,"سَيِّـَٔاتُ","(the) evils","مِنْ هَـٰٓؤُلَآءِ سَيُصِيبُهُمْ","مَا كَسَبُوا۟ وَمَا",325],["39:61:8",465,"ٱلسُّوٓءُ","the evil","بِمَفَازَتِهِمْ لَا يَمَسُّهُمُ","وَلَا هُمْ يَحْزَنُونَ",238],["40:9:2",468,"ٱلسَّيِّـَٔاتِ ۚ","(from) the evils","وَقِهِمُ","وَمَن تَقِ ٱلسَّيِّـَٔاتِ",325],["40:9:5",468,"ٱلسَّيِّـَٔاتِ","(from) the evils","ٱلسَّيِّـَٔاتِ ۚ وَمَن تَقِ","يَوْمَئِذٍۢ فَقَدْ رَحِمْتَهُۥ ۚ",325],["40:37:13",471,"سُوٓءُ","(the) evil","وَكَذَٰلِكَ زُيِّنَ لِفِرْعَوْنَ","عَمَلِهِۦ وَصُدَّ عَنِ",238],["40:40:3",471,"سَيِّئَةًۭ","an evil","مَنْ عَمِلَ","فَلَا يُجْزَىٰٓ إِلَّا",477],["40:45:3",472,"سَيِّـَٔاتِ","(from the) evils","فَوَقَىٰهُ ٱللَّهُ","مَا مَكَرُوا۟ ۖ وَحَاقَ",325],["40:45:9",472,"سُوٓءُ","(the) worst","وَحَاقَ بِـَٔالِ فِرْعَوْنَ","ٱلْعَذَابِ",238],["40:52:9",473,"سُوٓءُ","(is the) worst","وَلَهُمُ ٱللَّعْنَةُ وَلَهُمْ","ٱلدَّارِ",238],["40:58:10",473,"ٱلْمُسِىٓءُ ۚ","the evildoer","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَلَا","قَلِيلًۭا مَّا تَتَذَكَّرُونَ",3851],["41:27:7",479,"أَسْوَأَ","(the) worst","عَذَابًۭا شَدِيدًۭا وَلَنَجْزِيَنَّهُمْ","ٱلَّذِى كَانُوا۟ يَعْمَلُونَ",2194],["41:34:5",480,"ٱلسَّيِّئَةُ ۚ","the evil (deed)","تَسْتَوِى ٱلْحَسَنَةُ وَلَا","ٱدْفَعْ بِٱلَّتِى هِىَ",477],["41:46:6",481,"أَسَآءَ","does evil","صَـٰلِحًۭا فَلِنَفْسِهِۦ ۖ وَمَنْ","فَعَلَيْهَا ۗ وَمَا رَبُّكَ",1278],["42:25:9",486,"ٱلسَّيِّـَٔاتِ","the evil","عِبَادِهِۦ وَيَعْفُوا۟ عَنِ","وَيَعْلَمُ مَا تَفْعَلُونَ",325],["42:40:2",487,"سَيِّئَةٍۢ","(of) an evil","وَجَزَٰٓؤُا۟","سَيِّئَةٌۭ مِّثْلُهَا ۖ فَمَنْ",477],["42:40:3",487,"سَيِّئَةٌۭ","(is) an evil","وَجَزَٰٓؤُا۟ سَيِّئَةٍۢ","مِّثْلُهَا ۖ فَمَنْ عَفَا",477],["42:48:21",488,"سَيِّئَةٌۢ","evil","بِهَا ۖ وَإِن تُصِبْهُمْ","بِمَا قَدَّمَتْ أَيْدِيهِمْ",477],["45:15:6",500,"أَسَآءَ","does evil","صَـٰلِحًۭا فَلِنَفْسِهِۦ ۖ وَمَنْ","فَعَلَيْهَا ۖ ثُمَّ إِلَىٰ",1278],["45:21:5",500,"ٱلسَّيِّـَٔاتِ","evil deeds","حَسِبَ ٱلَّذِينَ ٱجْتَرَحُوا۟","أَن نَّجْعَلَهُمْ كَٱلَّذِينَ",325],["45:21:15",500,"سَآءَ","Evil is","سَوَآءًۭ مَّحْيَاهُمْ وَمَمَاتُهُمْ ۚ","مَا يَحْكُمُونَ",367],["45:33:3",502,"سَيِّـَٔاتُ","(the) evil","وَبَدَا لَهُمْ","مَا عَمِلُوا۟ وَحَاقَ",325],["46:16:10",504,"سَيِّـَٔاتِهِمْ","their evil deeds","عَمِلُوا۟ وَنَتَجَاوَزُ عَن","فِىٓ أَصْحَـٰبِ ٱلْجَنَّةِ ۖ",325],["47:2:16",507,"سَيِّـَٔاتِهِمْ","their misdeeds","رَّبِّهِمْ ۙ كَفَّرَ عَنْهُمْ","وَأَصْلَحَ بَالَهُمْ",325],["47:14:10",508,"سُوٓءُ","(the) evil","كَمَن زُيِّنَ لَهُۥ","عَمَلِهِۦ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُم",238],["48:5:13",511,"سَيِّـَٔاتِهِمْ ۚ","their misdeeds","فِيهَا وَيُكَفِّرَ عَنْهُمْ","وَكَانَ ذَٰلِكَ عِندَ",325],["48:6:9",511,"ٱلسَّوْءِ ۚ","evil","ٱلظَّآنِّينَ بِٱللَّهِ ظَنَّ","عَلَيْهِمْ دَآئِرَةُ ٱلسَّوْءِ ۖ",924],["48:6:12",511,"ٱلسَّوْءِ ۖ","(of) evil","ٱلسَّوْءِ ۚ عَلَيْهِمْ دَآئِرَةُ","وَغَضِبَ ٱللَّهُ عَلَيْهِمْ",924],["48:6:20",511,"وَسَآءَتْ","and evil","وَأَعَدَّ لَهُمْ جَهَنَّمَ ۖ","مَصِيرًۭا",367],["48:12:17",512,"ٱلسَّوْءِ","evil","قُلُوبِكُمْ وَظَنَنتُمْ ظَنَّ","وَكُنتُمْ قَوْمًۢا بُورًۭا",924],["53:31:10",527,"أَسَـٰٓـُٔوا۟","do evil","ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ","بِمَا عَمِلُوا۟ وَيَجْزِىَ",1278],["58:15:7",544,"سَآءَ","evil is","عَذَابًۭا شَدِيدًا ۖ إِنَّهُمْ","مَا كَانُوا۟ يَعْمَلُونَ",367],["60:2:10",549,"بِٱلسُّوٓءِ","with evil","إِلَيْكُمْ أَيْدِيَهُمْ وَأَلْسِنَتَهُم","وَوَدُّوا۟ لَوْ تَكْفُرُونَ",238],["63:2:9",554,"سَآءَ","evil is","سَبِيلِ ٱللَّهِ ۚ إِنَّهُمْ","مَا كَانُوا۟ يَعْمَلُونَ",367],["64:9:15",556,"سَيِّـَٔاتِهِۦ","his evil deeds","صَـٰلِحًۭا يُكَفِّرْ عَنْهُ","وَيُدْخِلْهُ جَنَّـٰتٍۢ تَجْرِى",325],["65:5:11",558,"سَيِّـَٔاتِهِۦ","his evil deeds","ٱللَّهَ يُكَفِّرْ عَنْهُ","وَيُعْظِمْ لَهُۥٓ أَجْرًا",325],["66:8:14",561,"سَيِّـَٔاتِكُمْ","your evil deeds","أَن يُكَفِّرَ عَنكُمْ","وَيُدْخِلَكُمْ جَنَّـٰتٍۢ تَجْرِى",325],["67:27:4",564,"سِيٓـَٔتْ","(will be) distressed","فَلَمَّا رَأَوْهُ زُلْفَةًۭ","وُجُوهُ ٱلَّذِينَ كَفَرُوا۟",367]]