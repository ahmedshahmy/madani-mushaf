[["7:46:2",156,"حِجَابٌۭ ۚ","(will be) a partition","وَبَيْنَهُمَا","وَعَلَى ٱلْأَعْرَافِ رِجَالٌۭ",1058],["17:45:11",286,"حِجَابًۭا","a barrier","لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ","مَّسْتُورًۭا",1058],["19:17:4",306,"حِجَابًۭا","a screen","فَٱتَّخَذَتْ مِن دُونِهِمْ","فَأَرْسَلْنَآ إِلَيْهَا رُوحَنَا",1058],["33:53:45",425,"حِجَابٍۢ ۚ","a screen","فَسْـَٔلُوهُنَّ مِن وَرَآءِ","ذَٰلِكُمْ أَطْهَرُ لِقُلُوبِكُمْ",1058],["38:32:11",455,"بِٱلْحِجَابِ","in the veil","رَبِّى حَتَّىٰ تَوَارَتْ","",1058],["41:5:14",477,"حِجَابٌۭ","(is) a screen","وَمِنۢ بَيْنِنَا وَبَيْنِكَ","فَٱعْمَلْ إِنَّنَا عَـٰمِلُونَ",1058],["42:51:12",488,"حِجَابٍ","a veil","أَوْ مِن وَرَآئِ","أَوْ يُرْسِلَ رَسُولًۭا",1058],["83:15:6",588,"لَّمَحْجُوبُونَ","surely will be partitioned","عَن رَّبِّهِمْ يَوْمَئِذٍۢ","",3640]]