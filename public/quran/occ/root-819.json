[["2:261:12",44,"سَنَابِلَ","ears","حَبَّةٍ أَنۢبَتَتْ سَبْعَ","فِى كُلِّ سُنۢبُلَةٍۢ",2646],["2:261:15",44,"سُنۢبُلَةٍۢ","ear","سَنَابِلَ فِى كُلِّ","مِّا۟ئَةُ حَبَّةٍۢ ۗ وَٱللَّهُ",2646],["12:43:12",240,"سُنۢبُلَـٰتٍ","ears (of corn)","سَبْعٌ عِجَافٌۭ وَسَبْعَ","خُضْرٍۢ وَأُخَرَ يَابِسَـٰتٍۢ ۖ",2645],["12:46:13",241,"سُنۢبُلَـٰتٍ","ears (of corn)","سَبْعٌ عِجَافٌۭ وَسَبْعِ","خُضْرٍۢ وَأُخَرَ يَابِسَـٰتٍۢ",2645],["12:47:10",241,"سُنۢبُلِهِۦٓ","its ears","حَصَدتُّمْ فَذَرُوهُ فِى","إِلَّا قَلِيلًۭا مِّمَّا",4280]]