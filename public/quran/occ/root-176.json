,199],["91:2:3",595,"تَلَىٰهَا","it follows it","وَٱلْقَمَرِ إِذَا","",199],["98:2:4",598,"يَتْلُوا۟","reciting","رَسُولٌۭ مِّنَ ٱللَّهِ","صُحُفًۭا مُّطَهَّرَةًۭ",199]]