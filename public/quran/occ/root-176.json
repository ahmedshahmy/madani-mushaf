[["2:44:7",7,"تَتْلُونَ","[you] recite","وَتَنسَوْنَ أَنفُسَكُمْ وَأَنتُمْ","ٱلْكِتَـٰبَ ۚ أَفَلَا تَعْقِلُونَ",199],["2:102:3",16,"تَتْلُوا۟","recite(d)","وَٱتَّبَعُوا۟ مَا","ٱلشَّيَـٰطِينُ عَلَىٰ مُلْكِ",199],["2:113:14",18,"يَتْلُونَ","recite","عَلَىٰ شَىْءٍۢ وَهُمْ","ٱلْكِتَـٰبَ ۗ كَذَٰلِكَ قَالَ",199],["2:121:4",19,"يَتْلُونَهُۥ","recite it","ٱلَّذِينَ ءَاتَيْنَـٰهُمُ ٱلْكِتَـٰبَ","حَقَّ تِلَاوَتِهِۦٓ أُو۟لَـٰٓئِكَ",199],["2:121:6",19,"تِلَاوَتِهِۦٓ","(of) its recitation","ٱلْكِتَـٰبَ يَتْلُونَهُۥ حَقَّ","أُو۟لَـٰٓئِكَ يُؤْمِنُونَ بِهِۦ ۗ",4446],["2:129:6",20,"يَتْلُوا۟","(who) will recite","فِيهِمْ رَسُولًۭا مِّنْهُمْ","عَلَيْهِمْ ءَايَـٰتِكَ وَيُعَلِّمُهُمُ",199],["2:151:6",23,"يَتْلُوا۟","(who) recites","فِيكُمْ رَسُولًۭا مِّنكُمْ","عَلَيْكُمْ ءَايَـٰتِنَا وَيُزَكِّيكُمْ",199],["2:252:4",41,"نَتْلُوهَا","We recite them","تِلْكَ ءَايَـٰتُ ٱللَّهِ","عَلَيْكَ بِٱلْحَقِّ ۚ وَإِنَّكَ",199],["3:58:2",57,"نَتْلُوهُ","(is what) We recite [it]","ذَٰلِكَ","عَلَيْكَ مِنَ ٱلْـَٔايَـٰتِ",199],["3:93:21",62,"فَٱتْلُوهَآ","and recite it","قُلْ فَأْتُوا۟ بِٱلتَّوْرَىٰةِ","إِن كُنتُمْ صَـٰدِقِينَ",199],["3:101:4",63,"تُتْلَىٰ","is recited","وَكَيْفَ تَكْفُرُونَ وَأَنتُمْ","عَلَيْكُمْ ءَايَـٰتُ ٱللَّهِ",199],["3:108:4",63,"نَتْلُوهَا","We recite them","تِلْكَ ءَايَـٰتُ ٱللَّهِ","عَلَيْكَ بِٱلْحَقِّ ۗ وَمَا",199],["3:113:8",64,"يَتْلُونَ","(and) reciting","ٱلْكِتَـٰبِ أُمَّةٌۭ قَآئِمَةٌۭ","ءَايَـٰتِ ٱللَّهِ ءَانَآءَ",199],["3:164:12",71,"يَتْلُوا۟","reciting","رَسُولًۭا مِّنْ أَنفُسِهِمْ","عَلَيْهِمْ ءَايَـٰتِهِۦ وَيُزَكِّيهِمْ",199],["4:127:9",98,"يُتْلَىٰ","is recited","يُفْتِيكُمْ فِيهِنَّ وَمَا","عَلَيْكُمْ فِى ٱلْكِتَـٰبِ",199],["5:1:12",106,"يُتْلَىٰ","is recited","ٱلْأَنْعَـٰمِ إِلَّا مَا","عَلَيْكُمْ غَيْرَ مُحِلِّى",199],["5:27:1",112,"۞ وَٱتْلُ","And recite","","عَلَيْهِمْ نَبَأَ ٱبْنَىْ",199],["6:151:3",148,"أَتْلُ","I will recite","۞ قُلْ تَعَالَوْا۟","مَا حَرَّمَ رَبُّكُمْ",199],["7:175:1",173,"وَٱتْلُ","And recite","","عَلَيْهِمْ نَبَأَ ٱلَّذِىٓ",199],["8:2:10",177,"تُلِيَتْ","are recited","وَجِلَتْ قُلُوبُهُمْ وَإِذَا","عَلَيْهِمْ ءَايَـٰتُهُۥ زَادَتْهُمْ",199],["8:31:2",180,"تُتْلَىٰ","are recited","وَإِذَا","عَلَيْهِمْ ءَايَـٰتُنَا قَالُوا۟",199],["10:15:2",210,"تُتْلَىٰ","are recited","وَإِذَا","عَلَيْهِمْ ءَايَاتُنَا بَيِّنَـٰتٍۢ ۙ",199],["10:16:6",210,"تَلَوْتُهُۥ","I (would) have recited it","شَآءَ ٱللَّهُ مَا","عَلَيْكُمْ وَلَآ أَدْرَىٰكُم",199],["10:61:6",215,"تَتْلُوا۟","you recite","فِى شَأْنٍۢ وَمَا","مِنْهُ مِن قُرْءَانٍۢ",199],["10:71:1",217,"۞ وَٱتْلُ","And recite","","عَلَيْهِمْ نَبَأَ نُوحٍ",199],["11:17:7",223,"وَيَتْلُوهُ","and recites it","بَيِّنَةٍۢ مِّن رَّبِّهِۦ","شَاهِدٌۭ مِّنْهُ وَمِن",199],["13:30:10",253,"لِّتَتْلُوَا۟","so that you might recite","مِن قَبْلِهَآ أُمَمٌۭ","عَلَيْهِمُ ٱلَّذِىٓ أَوْحَيْنَآ",199],["17:107:14",293,"يُتْلَىٰ","it is recited","مِن قَبْلِهِۦٓ إِذَا","عَلَيْهِمْ يَخِرُّونَ لِلْأَذْقَانِ",199],["18:27:1",296,"وَٱتْلُ","And recite","","مَآ أُوحِىَ إِلَيْكَ",199],["18:83:6",302,"سَأَتْلُوا۟","I will recite","ذِى ٱلْقَرْنَيْنِ ۖ قُلْ","عَلَيْكُم مِّنْهُ ذِكْرًا",199],["19:58:23",309,"تُتْلَىٰ","were recited","هَدَيْنَا وَٱجْتَبَيْنَآ ۚ إِذَا","عَلَيْهِمْ ءَايَـٰتُ ٱلرَّحْمَـٰنِ",199],["19:73:2",310,"تُتْلَىٰ","are recited","وَإِذَا","عَلَيْهِمْ ءَايَـٰتُنَا بَيِّنَـٰتٍۢ",199],["22:30:16",335,"يُتْلَىٰ","is recited","ٱلْأَنْعَـٰمُ إِلَّا مَا","عَلَيْكُمْ ۖ فَٱجْتَنِبُوا۟ ٱلرِّجْسَ",199],["22:72:2",340,"تُتْلَىٰ","are recited","وَإِذَا","عَلَيْهِمْ ءَايَـٰتُنَا بَيِّنَـٰتٍۢ",199],["22:72:15",340,"يَتْلُونَ","recite","يَكَادُونَ يَسْطُونَ بِٱلَّذِينَ","عَلَيْهِمْ ءَايَـٰتِنَا ۗ قُلْ",199],["23:66:4",346,"تُتْلَىٰ","recited","قَدْ كَانَتْ ءَايَـٰتِى","عَلَيْكُمْ فَكُنتُمْ عَلَىٰٓ",199],["23:105:4",349,"تُتْلَىٰ","recited","أَلَمْ تَكُنْ ءَايَـٰتِى","عَلَيْكُمْ فَكُنتُم بِهَا",199],["26:69:1",370,"وَٱتْلُ","And recite","","عَلَيْهِمْ نَبَأَ إِبْرَٰهِيمَ",199],["27:92:2",385,"أَتْلُوَا۟","I recite","وَأَنْ","ٱلْقُرْءَانَ ۖ فَمَنِ ٱهْتَدَىٰ",199],["28:3:1",385,"نَتْلُوا۟","We