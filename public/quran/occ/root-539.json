[["4:140:19",100,"يَخُوضُوا۟","they engage","تَقْعُدُوا۟ مَعَهُمْ حَتَّىٰ","فِى حَدِيثٍ غَيْرِهِۦٓ ۚ",931],["6:68:4",135,"يَخُوضُونَ","engage (in vain talks)","وَإِذَا رَأَيْتَ ٱلَّذِينَ","فِىٓ ءَايَـٰتِنَا فَأَعْرِضْ",931],["6:68:10",135,"يَخُوضُوا۟","they engage","فَأَعْرِضْ عَنْهُمْ حَتَّىٰ","فِى حَدِيثٍ غَيْرِهِۦ ۚ",931],["6:91:43",139,"خَوْضِهِمْ","their discourse","ثُمَّ ذَرْهُمْ فِى","يَلْعَبُونَ",2742],["9:65:6",197,"نَخُوضُ","conversing","لَيَقُولُنَّ إِنَّمَا كُنَّا","وَنَلْعَبُ ۚ قُلْ أَبِٱللَّهِ",931],["9:69:21",198,"وَخُضْتُمْ","and you indulge","مِن قَبْلِكُم بِخَلَـٰقِهِمْ","كَٱلَّذِى خَاضُوٓا۟ ۚ أُو۟لَـٰٓئِكَ",931],["9:69:23",198,"خَاضُوٓا۟ ۚ","indulges (in idle talk)","بِخَلَـٰقِهِمْ وَخُضْتُمْ كَٱلَّذِى","أُو۟لَـٰٓئِكَ حَبِطَتْ أَعْمَـٰلُهُمْ",931],["43:83:2",495,"يَخُوضُوا۟","(to) converse vainly","فَذَرْهُمْ","وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟",931],["52:12:4",523,"خَوْضٍۢ","(vain) discourse","ٱلَّذِينَ هُمْ فِى","يَلْعَبُونَ",2742],["70:42:2",570,"يَخُوضُوا۟","(to) converse vainly","فَذَرْهُمْ","وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟",931],["74:45:2",576,"نَخُوضُ","indulge in vain talk","وَكُنَّا","مَعَ ٱلْخَآئِضِينَ",931],["74:45:4",576,"ٱلْخَآئِضِينَ","the vain talkers","وَكُنَّا نَخُوضُ مَعَ","",4553]]