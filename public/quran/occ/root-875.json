[["43:71:6",494,"وَأَكْوَابٍۢ ۖ","and cups","بِصِحَافٍۢ مِّن ذَهَبٍۢ","وَفِيهَا مَا تَشْتَهِيهِ",1470],["56:18:1",535,"بِأَكْوَابٍۢ","With vessels","","وَأَبَارِيقَ وَكَأْسٍۢ مِّن",1470],["76:15:6",579,"وَأَكْوَابٍۢ","and cups","بِـَٔانِيَةٍۢ مِّن فِضَّةٍۢ","كَانَتْ قَوَارِيرَا۠",1470],["88:14:1",592,"وَأَكْوَابٌۭ","And cups","","مَّوْضُوعَةٌۭ",1470]]