[["3:78:4",60,"يَلْوُۥنَ","they distort","وَإِنَّ مِنْهُمْ لَفَرِيقًۭا","أَلْسِنَتَهُم بِٱلْكِتَـٰبِ لِتَحْسَبُوهُ",2059],["3:153:4",69,"تَلْوُۥنَ","casting a glance","۞ إِذْ تُصْعِدُونَ وَلَا","عَلَىٰٓ أَحَدٍۢ وَٱلرَّسُولُ",2059],["4:46:15",86,"لَيًّۢا","twisting","غَيْرَ مُسْمَعٍۢ وَرَٰعِنَا","بِأَلْسِنَتِهِمْ وَطَعْنًۭا فِى",3604],["4:135:29",100,"تَلْوُۥٓا۟","you distort","أَن تَعْدِلُوا۟ ۚ وَإِن","أَوْ تُعْرِضُوا۟ فَإِنَّ",2059],["63:5:9",555,"لَوَّوْا۟","They turn aside","لَكُمْ رَسُولُ ٱللَّهِ","رُءُوسَهُمْ وَرَأَيْتَهُمْ يَصُدُّونَ",3602]]