[["2:100:4",15,"نَّبَذَهُۥ","threw it away","أَوَكُلَّمَا عَـٰهَدُوا۟ عَهْدًۭا","فَرِيقٌۭ مِّنْهُم ۚ بَلْ",853],["2:101:10",15,"نَبَذَ","threw away","مُصَدِّقٌۭ لِّمَا مَعَهُمْ","فَرِيقٌۭ مِّنَ ٱلَّذِينَ",853],["3:187:12",75,"فَنَبَذُوهُ","Then they threw it","لِلنَّاسِ وَلَا تَكْتُمُونَهُۥ","وَرَآءَ ظُهُورِهِمْ وَٱشْتَرَوْا۟",853],["8:58:6",184,"فَٱنۢبِذْ","throw back","مِن قَوْمٍ خِيَانَةًۭ","إِلَيْهِمْ عَلَىٰ سَوَآءٍ ۚ",853],["19:16:6",306,"ٱنتَبَذَتْ","she withdrew","ٱلْكِتَـٰبِ مَرْيَمَ إِذِ","مِنْ أَهْلِهَا مَكَانًۭا",2842],["19:22:2",306,"فَٱنتَبَذَتْ","and she withdrew","۞ فَحَمَلَتْهُ","بِهِۦ مَكَانًۭا قَصِيًّۭا",2842],["20:96:12",318,"فَنَبَذْتُهَا","then threw it","مِّنْ أَثَرِ ٱلرَّسُولِ","وَكَذَٰلِكَ سَوَّلَتْ لِى",853],["28:40:3",390,"فَنَبَذْنَـٰهُمْ","and We threw them","فَأَخَذْنَـٰهُ وَجُنُودَهُۥ","فِى ٱلْيَمِّ ۖ فَٱنظُرْ",853],["37:145:1",451,"۞ فَنَبَذْنَـٰهُ","But We cast him","","بِٱلْعَرَآءِ وَهُوَ سَقِيمٌۭ",853],["51:40:3",522,"فَنَبَذْنَـٰهُمْ","and threw them","فَأَخَذْنَـٰهُ وَجُنُودَهُۥ","فِى ٱلْيَمِّ وَهُوَ",853],["68:49:7",566,"لَنُبِذَ","surely he would have been thrown","نِعْمَةٌۭ مِّن رَّبِّهِۦ","بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌۭ",853],["104:4:2",601,"لَيُنۢبَذَنَّ","Surely he will be thrown","كَلَّا ۖ","فِى ٱلْحُطَمَةِ",853]]