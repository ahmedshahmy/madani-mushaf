[["4:78:3",90,"يُدْرِككُّمُ","will overtake you","أَيْنَمَا تَكُونُوا۟","ٱلْمَوْتُ وَلَوْ كُنتُمْ",1136],["4:100:21",94,"يُدْرِكْهُ","overtakes him","ٱللَّهِ وَرَسُولِهِۦ ثُمَّ","ٱلْمَوْتُ فَقَدْ وَقَعَ",1136],["4:145:4",101,"ٱلدَّرْكِ","the depths","إِنَّ ٱلْمُنَـٰفِقِينَ فِى","ٱلْأَسْفَلِ مِنَ ٱلنَّارِ",3389],["6:103:2",141,"تُدْرِكُهُ","grasp Him","لَّا","ٱلْأَبْصَـٰرُ وَهُوَ يُدْرِكُ",1136],["6:103:5",141,"يُدْرِكُ","(can) grasp","تُدْرِكُهُ ٱلْأَبْصَـٰرُ وَهُوَ","ٱلْأَبْصَـٰرَ ۖ وَهُوَ ٱللَّطِيفُ",1136],["7:38:21",155,"ٱدَّارَكُوا۟","they had overtaken one another","أُخْتَهَا ۖ حَتَّىٰٓ إِذَا","فِيهَا جَمِيعًۭا قَالَتْ",2102],["10:90:12",219,"أَدْرَكَهُ","overtook him","وَعَدْوًا ۖ حَتَّىٰٓ إِذَآ","ٱلْغَرَقُ قَالَ ءَامَنتُ",1136],["20:77:16",317,"دَرَكًۭا","to be overtaken","يَبَسًۭا لَّا تَخَـٰفُ","وَلَا تَخْشَىٰ",3377],["26:61:8",370,"لَمُدْرَكُونَ","(are) surely to be overtaken","أَصْحَـٰبُ مُوسَىٰٓ إِنَّا","",3793],["27:66:2",383,"ٱدَّٰرَكَ","is arrested","بَلِ","عِلْمُهُمْ فِى ٱلْـَٔاخِرَةِ ۚ",2102],["36:40:6",442,"تُدْرِكَ","it overtakes","يَنۢبَغِى لَهَآ أَن","ٱلْقَمَرَ وَلَا ٱلَّيْلُ",1136],["68:49:3",566,"تَدَٰرَكَهُۥ","overtook him","لَّوْلَآ أَن","نِعْمَةٌۭ مِّن رَّبِّهِۦ",2102]]