[["2:115:4",18,"فَأَيْنَمَا","so wherever","وَلِلَّهِ ٱلْمَشْرِقُ وَٱلْمَغْرِبُ ۚ","تُوَلُّوا۟ فَثَمَّ وَجْهُ",523],["2:148:7",23,"أَيْنَ","Wherever","مُوَلِّيهَا ۖ فَٱسْتَبِقُوا۟ ٱلْخَيْرَٰتِ ۚ","مَا تَكُونُوا۟ يَأْتِ",523],["3:112:4",64,"أَيْنَ","wherever","ضُرِبَتْ عَلَيْهِمُ ٱلذِّلَّةُ","مَا ثُقِفُوٓا۟ إِلَّا",523],["4:78:1",90,"أَيْنَمَا","Wherever","","تَكُونُوا۟ يُدْرِككُّمُ ٱلْمَوْتُ",523],["6:22:8",130,"أَيْنَ","Where (are)","نَقُولُ لِلَّذِينَ أَشْرَكُوٓا۟","شُرَكَآؤُكُمُ ٱلَّذِينَ كُنتُمْ",523],["7:37:22",154,"أَيْنَ","Where are","رُسُلُنَا يَتَوَفَّوْنَهُمْ قَالُوٓا۟","مَا كُنتُمْ تَدْعُونَ",523],["16:27:6",270,"أَيْنَ","Where","ٱلْقِيَـٰمَةِ يُخْزِيهِمْ وَيَقُولُ","شُرَكَآءِىَ ٱلَّذِينَ كُنتُمْ",523],["16:76:15",275,"أَيْنَمَا","Wherever","كَلٌّ عَلَىٰ مَوْلَىٰهُ","يُوَجِّههُّ لَا يَأْتِ",523],["19:31:3",307,"أَيْنَ","wherever","وَجَعَلَنِى مُبَارَكًا","مَا كُنتُ وَأَوْصَـٰنِى",523],["26:92:3",371,"أَيْنَ","Where","وَقِيلَ لَهُمْ","مَا كُنتُمْ تَعْبُدُونَ",523],["28:62:4",393,"أَيْنَ","Where","وَيَوْمَ يُنَادِيهِمْ فَيَقُولُ","شُرَكَآءِىَ ٱلَّذِينَ كُنتُمْ",523],["28:74:4",394,"أَيْنَ","Where","وَيَوْمَ يُنَادِيهِمْ فَيَقُولُ","شُرَكَآءِىَ ٱلَّذِينَ كُنتُمْ",523],["33:61:2",426,"أَيْنَمَا","wherever","مَّلْعُونِينَ ۖ","ثُقِفُوٓا۟ أُخِذُوا۟ وَقُتِّلُوا۟",523],["40:73:4",475,"أَيْنَ","Where","ثُمَّ قِيلَ لَهُمْ","مَا كُنتُمْ تُشْرِكُونَ",523],["41:47:21",482,"أَيْنَ","Where (are)","بِعِلْمِهِۦ ۚ وَيَوْمَ يُنَادِيهِمْ","شُرَكَآءِى قَالُوٓا۟ ءَاذَنَّـٰكَ",523],["57:4:30",538,"أَيْنَ","wherever","فِيهَا ۖ وَهُوَ مَعَكُمْ","مَا كُنتُمْ ۚ وَٱللَّهُ",523],["58:7:34",543,"أَيْنَ","wherever","إِلَّا هُوَ مَعَهُمْ","مَا كَانُوا۟ ۖ ثُمَّ",523],["75:10:4",577,"أَيْنَ","Where","يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ","ٱلْمَفَرُّ",523],["81:26:1",586,"فَأَيْنَ","So where","","تَذْهَبُونَ",523]]