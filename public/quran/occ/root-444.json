[["4:60:5",88,"يَزْعُمُونَ","claim","تَرَ إِلَى ٱلَّذِينَ","أَنَّهُمْ ءَامَنُوا۟ بِمَآ",704],["6:22:12",130,"تَزْعُمُونَ","claim","شُرَكَآؤُكُمُ ٱلَّذِينَ كُنتُمْ","",704],["6:94:18",139,"زَعَمْتُمْ","you claimed","مَعَكُمْ شُفَعَآءَكُمُ ٱلَّذِينَ","أَنَّهُمْ فِيكُمْ شُرَكَـٰٓؤُا۟ ۚ",704],["6:94:29",139,"تَزْعُمُونَ","claim","عَنكُم مَّا كُنتُمْ","",704],["6:136:12",145,"بِزَعْمِهِمْ","by their claim","فَقَالُوا۟ هَـٰذَا لِلَّهِ","وَهَـٰذَا لِشُرَكَآئِنَا ۖ فَمَا",2821],["6:138:11",146,"بِزَعْمِهِمْ","by their claim","إِلَّا مَن نَّشَآءُ","وَأَنْعَـٰمٌ حُرِّمَتْ ظُهُورُهَا",2821],["12:72:12",244,"زَعِيمٌۭ","(is) responsible","بَعِيرٍۢ وَأَنَا۠ بِهِۦ","",2820],["17:56:4",287,"زَعَمْتُم","you claimed","قُلِ ٱدْعُوا۟ ٱلَّذِينَ","مِّن دُونِهِۦ فَلَا",704],["17:92:5",291,"زَعَمْتَ","you have claimed","تُسْقِطَ ٱلسَّمَآءَ كَمَا","عَلَيْنَا كِسَفًا أَوْ",704],["18:48:12",299,"زَعَمْتُمْ","you claimed","أَوَّلَ مَرَّةٍۭ ۚ بَلْ","أَلَّن نَّجْعَلَ لَكُم",704],["18:52:6",299,"زَعَمْتُمْ","you claimed","نَادُوا۟ شُرَكَآءِىَ ٱلَّذِينَ","فَدَعَوْهُمْ فَلَمْ يَسْتَجِيبُوا۟",704],["28:62:8",393,"تَزْعُمُونَ","claim","شُرَكَآءِىَ ٱلَّذِينَ كُنتُمْ","",704],["28:74:8",394,"تَزْعُمُونَ","claim","شُرَكَآءِىَ ٱلَّذِينَ كُنتُمْ","",704],["34:22:4",430,"زَعَمْتُم","you claim","قُلِ ٱدْعُوا۟ ٱلَّذِينَ","مِّن دُونِ ٱللَّهِ ۖ",704],["62:6:6",553,"زَعَمْتُمْ","you claim","ٱلَّذِينَ هَادُوٓا۟ إِن","أَنَّكُمْ أَوْلِيَآءُ لِلَّهِ",704],["64:7:1",556,"زَعَمَ","Claim","","ٱلَّذِينَ كَفَرُوٓا۟ أَن",704],["68:40:4",565,"زَعِيمٌ","(is) responsible","سَلْهُمْ أَيُّهُم بِذَٰلِكَ","",2820]]