[["2:66:8",10,"وَمَوْعِظَةًۭ","and an admonition","يَدَيْهَا وَمَا خَلْفَهَا","لِّلْمُتَّقِينَ",914],["2:231:36",37,"يَعِظُكُم","He instructs you","مِّنَ ٱلْكِتَـٰبِ وَٱلْحِكْمَةِ","بِهِۦ ۚ وَٱتَّقُوا۟ ٱللَّهَ",640],["2:232:16",37,"يُوعَظُ","is admonished","بَيْنَهُم بِٱلْمَعْرُوفِ ۗ ذَٰلِكَ","بِهِۦ مَن كَانَ",640],["2:275:28",47,"مَوْعِظَةٌۭ","(the) admonition","ٱلرِّبَوٰا۟ ۚ فَمَن جَآءَهُۥ","مِّن رَّبِّهِۦ فَٱنتَهَىٰ",914],["3:138:5",67,"وَمَوْعِظَةٌۭ","and admonition","بَيَانٌۭ لِّلنَّاسِ وَهُدًۭى","لِّلْمُتَّقِينَ",914],["4:34:25",84,"فَعِظُوهُنَّ","then advise them","وَٱلَّـٰتِى تَخَافُونَ نُشُوزَهُنَّ","وَٱهْجُرُوهُنَّ فِى ٱلْمَضَاجِعِ",640],["4:58:19",87,"يَعِظُكُم","advises you","إِنَّ ٱللَّهَ نِعِمَّا","بِهِۦٓ ۗ إِنَّ ٱللَّهَ",640],["4:63:10",88,"وَعِظْهُمْ","and admonish them","قُلُوبِهِمْ فَأَعْرِضْ عَنْهُمْ","وَقُل لَّهُمْ فِىٓ",640],["4:66:21",89,"يُوعَظُونَ","they were advised","أَنَّهُمْ فَعَلُوا۟ مَا","بِهِۦ لَكَانَ خَيْرًۭا",640],["5:46:25",116,"وَمَوْعِظَةًۭ","and an admonition","مِنَ ٱلتَّوْرَىٰةِ وَهُدًۭى","لِّلْمُتَّقِينَ",914],["7:145:8",168,"مَّوْعِظَةًۭ","an instruction","مِن كُلِّ شَىْءٍۢ","وَتَفْصِيلًۭا لِّكُلِّ شَىْءٍۢ",914],["7:164:6",172,"تَعِظُونَ","(do) you preach","أُمَّةٌۭ مِّنْهُمْ لِمَ","قَوْمًا ۙ ٱللَّهُ مُهْلِكُهُمْ",640],["10:57:5",215,"مَّوْعِظَةٌۭ","an instruction","ٱلنَّاسُ قَدْ جَآءَتْكُم","مِّن رَّبِّكُمْ وَشِفَآءٌۭ",914],["11:46:19",227,"أَعِظُكَ","admonish you","بِهِۦ عِلْمٌ ۖ إِنِّىٓ","أَن تَكُونَ مِنَ",640],["11:120:15",235,"وَمَوْعِظَةٌۭ","and an admonition","فِى هَـٰذِهِ ٱلْحَقُّ","وَذِكْرَىٰ لِلْمُؤْمِنِينَ",914],["16:90:14",277,"يَعِظُكُمْ","He admonishes you","ٱلْفَحْشَآءِ وَٱلْمُنكَرِ وَٱلْبَغْىِ ۚ","لَعَلَّكُمْ تَذَكَّرُونَ",640],["16:125:6",281,"وَٱلْمَوْعِظَةِ","and the instruction","سَبِيلِ رَبِّكَ بِٱلْحِكْمَةِ","ٱلْحَسَنَةِ ۖ وَجَـٰدِلْهُم بِٱلَّتِى",914],["24:17:1",351,"يَعِظُكُمُ","Allah warns you","","ٱللَّهُ أَن تَعُودُوا۟",640],["24:34:12",354,"وَمَوْعِظَةًۭ","and an admonition","خَلَوْا۟ مِن قَبْلِكُمْ","لِّلْمُتَّقِينَ",914],["26:136:4",372,"أَوَعَظْتَ","whether you advise","قَالُوا۟ سَوَآءٌ عَلَيْنَآ","أَمْ لَمْ تَكُن",640],["26:136:9",372,"ٱلْوَٰعِظِينَ","the advisors","لَمْ تَكُن مِّنَ","",4517],["31:13:6",412,"يَعِظُهُۥ","(was) instructing him","لُقْمَـٰنُ لِٱبْنِهِۦ وَهُوَ","يَـٰبُنَىَّ لَا تُشْرِكْ",640],["34:46:3",433,"أَعِظُكُم","I advise you","۞ قُلْ إِنَّمَآ","بِوَٰحِدَةٍ ۖ أَن تَقُومُوا۟",640],["58:3:16",542,"تُوعَظُونَ","you are admonished","أَن يَتَمَآسَّا ۚ ذَٰلِكُمْ","بِهِۦ ۚ وَٱللَّهُ بِمَا",640],["65:2:17",558,"يُوعَظُ","is instructed","ٱلشَّهَـٰدَةَ لِلَّهِ ۚ ذَٰلِكُمْ","بِهِۦ مَن كَانَ",640]]