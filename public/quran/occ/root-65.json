[["2:19:16",4,"ٱلْمَوْتِ ۚ","[the] death","مِّنَ ٱلصَّوَٰعِقِ حَذَرَ","وَٱللَّهُ مُحِيطٌۢ بِٱلْكَـٰفِرِينَ",236],["2:28:5",5,"أَمْوَٰتًۭا","dead","تَكْفُرُونَ بِٱللَّهِ وَكُنتُمْ","فَأَحْيَـٰكُمْ ۖ ثُمَّ يُمِيتُكُمْ",310],["2:28:8",5,"يُمِيتُكُمْ","He will cause you to die","أَمْوَٰتًۭا فَأَحْيَـٰكُمْ ۖ ثُمَّ","ثُمَّ يُحْيِيكُمْ ثُمَّ",485],["2:56:5",8,"مَوْتِكُمْ","your death","بَعَثْنَـٰكُم مِّنۢ بَعْدِ","لَعَلَّكُمْ تَشْكُرُونَ",236],["2:73:7",11,"ٱلْمَوْتَىٰ","the dead","كَذَٰلِكَ يُحْىِ ٱللَّهُ","وَيُرِيكُمْ ءَايَـٰتِهِۦ لَعَلَّكُمْ",310],["2:94:14",15,"ٱلْمَوْتَ","(for) [the] death","دُونِ ٱلنَّاسِ فَتَمَنَّوُا۟","إِن كُنتُمْ صَـٰدِقِينَ",236],["2:132:13",20,"تَمُوتُنَّ","(should) you die","لَكُمُ ٱلدِّينَ فَلَا","إِلَّا وَأَنتُم مُّسْلِمُونَ",304],["2:133:7",20,"ٱلْمَوْتُ","[the] death","إِذْ حَضَرَ يَعْقُوبَ","إِذْ قَالَ لِبَنِيهِ",236],["2:154:8",24,"أَمْوَٰتٌۢ ۚ","(They are) dead","فِى سَبِيلِ ٱللَّهِ","بَلْ أَحْيَآءٌۭ وَلَـٰكِن",310],["2:161:4",24,"وَمَاتُوا۟","and die[d]","إِنَّ ٱلَّذِينَ كَفَرُوا۟","وَهُمْ كُفَّارٌ أُو۟لَـٰٓئِكَ",304],["2:164:28",25,"مَوْتِهَا","its death","بِهِ ٱلْأَرْضَ بَعْدَ","وَبَثَّ فِيهَا مِن",236],["2:173:4",26,"ٱلْمَيْتَةَ","the dead animals","إِنَّمَا حَرَّمَ عَلَيْكُمُ","وَٱلدَّمَ وَلَحْمَ ٱلْخِنزِيرِ",1200],["2:180:6",27,"ٱلْمَوْتُ","[the] death","إِذَا حَضَرَ أَحَدَكُمُ","إِن تَرَكَ خَيْرًا",236],["2:217:43",34,"فَيَمُتْ","then dies","مِنكُمْ عَن دِينِهِۦ","وَهُوَ كَافِرٌۭ فَأُو۟لَـٰٓئِكَ",304],["2:243:11",39,"ٱلْمَوْتِ","(of) [the] death","وَهُمْ أُلُوفٌ حَذَرَ","فَقَالَ لَهُمُ ٱللَّهُ",236],["2:243:15",39,"مُوتُوا۟","Die","فَقَالَ لَهُمُ ٱللَّهُ","ثُمَّ أَحْيَـٰهُمْ ۚ إِنَّ",304],["2:258:19",43,"وَيُمِيتُ","and causes death","رَبِّىَ ٱلَّذِى يُحْىِۦ","قَالَ أَنَا۠ أُحْىِۦ",485],["2:258:23",43,"وَأُمِيتُ ۖ","and cause death","قَالَ أَنَا۠ أُحْىِۦ","قَالَ إِبْرَٰهِـۧمُ فَإِنَّ",485],["2:259:16",43,"مَوْتِهَا ۖ","its death","هَـٰذِهِ ٱللَّهُ بَعْدَ","فَأَمَاتَهُ ٱللَّهُ مِا۟ئَةَ",236],["2:259:17",43,"فَأَمَاتَهُ","Then he was made to die","ٱللَّهُ بَعْدَ مَوْتِهَا ۖ","ٱللَّهُ مِا۟ئَةَ عَامٍۢ",485],["2:260:8",44,"ٱلْمَوْتَىٰ ۖ","(to) the dead","أَرِنِى كَيْفَ تُحْىِ","قَالَ أَوَلَمْ تُؤْمِن ۖ",310],["3:27:12",53,"ٱلْمَيِّتِ","the dead","وَتُخْرِجُ ٱلْحَىَّ مِنَ","وَتُخْرِجُ ٱلْمَيِّتَ مِنَ",310],["3:27:14",53,"ٱلْمَيِّتَ","the dead","مِنَ ٱلْمَيِّتِ وَتُخْرِجُ","مِنَ ٱلْحَىِّ ۖ وَتَرْزُقُ",310],["3:49:28",56,"ٱلْمَوْتَىٰ","(to) the dead","ٱلْأَكْمَهَ وَٱلْأَبْرَصَ وَأُحْىِ","بِإِذْنِ ٱللَّهِ ۖ وَأُنَبِّئُكُم",310],["3:91:4",61,"وَمَاتُوا۟","and died","إِنَّ ٱلَّذِينَ كَفَرُوا۟","وَهُمْ كُفَّارٌۭ فَلَن",304],["3:102:9",63,"تَمُوتُنَّ","die","حَقَّ تُقَاتِهِۦ وَلَا","إِلَّا وَأَنتُم مُّسْلِمُونَ",304],["3:119:21",65,"مُوتُوا۟","Die","مِنَ ٱلْغَيْظِ ۚ قُلْ","بِغَيْظِكُمْ ۗ إِنَّ ٱللَّهَ",304],["3:143:4",68,"ٱلْمَوْتَ","(for) death","وَلَقَدْ كُنتُمْ تَمَنَّوْنَ","مِن قَبْلِ أَن",236],["3:144:11",68,"مَّاتَ","he died","قَبْلِهِ ٱلرُّسُلُ ۚ أَفَإِي۟ن","أَوْ قُتِلَ ٱنقَلَبْتُمْ",304],["3:145:5",68,"تَمُوتَ","he dies","كَانَ لِنَفْسٍ أَن","إِلَّا بِإِذْنِ ٱللَّهِ",304],["3:156:21",70,"مَاتُوا۟","they (would have) died","كَانُوا۟ عِندَنَا مَا","وَمَا قُتِلُوا۟ لِيَجْعَلَ",304],["3:156:32",70,"وَيُمِيتُ ۗ","and causes death","قُلُوبِهِمْ ۗ وَٱللَّهُ يُحْىِۦ","وَٱللَّهُ بِمَا تَعْمَلُونَ",485],["3:157:7",70,"مُتُّمْ","die[d]","سَبِيلِ ٱللَّهِ أَوْ","لَمَغْفِرَةٌۭ مِّنَ ٱللَّهِ",304],["3:158:2",71,"مُّتُّمْ","you die","وَلَئِن","أَوْ قُتِلْتُمْ لَإِلَى",304],["3:168:13",72,"ٱلْمَوْتَ","[the] death","فَٱدْرَءُوا۟ عَنْ أَنفُسِكُمُ","إِن كُنتُمْ صَـٰدِقِينَ",236],["3:169:8",72,"أَمْوَٰتًۢا ۚ","(as) dead","فِى سَبِيلِ ٱللَّهِ","بَلْ أَحْيَآءٌ عِندَ",310],["3:185:4",74,"ٱلْمَوْتِ ۗ","[the] death","كُلُّ نَفْسٍۢ ذَآئِقَةُ","وَإِنَّمَا تُوَفَّوْنَ أُجُورَكُمْ",236],["4:15:17",80,"ٱلْمَوْتُ","[the] death","ٱلْبُيُوتِ حَتَّىٰ يَتَوَفَّىٰهُنَّ","أَوْ يَجْعَلَ ٱللَّهُ",236],["4:18:10",80,"ٱلْمَوْتُ","[the] death","إِذَا حَضَرَ أَحَدَهُمُ","قَالَ إِنِّى تُبْتُ",236],["4:18:17",80,"يَمُوتُونَ","die","ٱلْـَٔـٰنَ وَلَا ٱلَّذِينَ","وَهُمْ كُفَّارٌ ۚ أُو۟لَـٰٓئِكَ",304],["4:78:4",90,"ٱلْمَوْتُ","[the] death","أَيْنَمَا تَكُونُوا۟ يُدْرِككُّمُ","وَلَوْ كُنتُمْ فِى",236],["4:100:22",94,"ٱلْمَوْتُ","[the] death","وَرَسُولِهِۦ ثُمَّ يُدْرِكْهُ","فَقَدْ وَقَعَ أَجْرُهُۥ",236],["4:159:9",103,"مَوْتِهِۦ ۖ","his death","لَيُؤْمِنَنَّ بِهِۦ قَبْلَ","وَيَوْمَ ٱلْقِيَـٰمَةِ يَكُونُ",236],["5:3:3",107,"ٱلْمَيْتَةُ","the dead animals","حُرِّمَتْ عَلَيْكُمُ","وَٱلدَّمُ وَلَحْمُ ٱلْخِنزِيرِ",1200],["5:106:9",125,"ٱلْمَوْتُ","[the] death","إِذَا حَضَرَ أَحَدَكُمُ","حِينَ ٱلْوَصِيَّةِ ٱثْنَانِ",236],["5:106:27",125,"ٱلْمَوْتِ ۚ","(of) [the] death","ٱلْأَرْضِ فَأَصَـٰبَتْكُم مُّصِيبَةُ","تَحْبِسُونَهُمَا مِنۢ بَعْدِ",236],["5:110:45",126,"ٱلْمَوْتَىٰ","the dead","بِإِذْنِى ۖ وَإِذْ تُخْرِجُ","بِإِذْنِى ۖ وَإِذْ كَفَفْتُ",310],["6:36:5",132,"وَٱلْمَوْتَىٰ","But the dead","يَسْتَجِيبُ ٱلَّذِينَ يَسْمَعُونَ ۘ","يَبْعَثُهُمُ ٱللَّهُ ثُمَّ",310],["6:61:12",135,"ٱلْمَوْتُ","the death","إِذَا جَآءَ أَحَدَكُمُ","تَوَفَّتْهُ رُسُلُنَا وَهُمْ",236],["6:93:29",139,"ٱلْمَوْتِ","(of) [the] death","ٱلظَّـٰلِمُونَ فِى غَمَرَٰتِ","وَٱلْمَلَـٰٓئِكَةُ بَاسِطُوٓا۟ أَيْدِيهِمْ",236],["6:95:9",140,"ٱلْمَيِّتِ","the dead","يُخْرِجُ ٱلْحَىَّ مِنَ","وَمُخْرِجُ ٱلْمَيِّتِ مِنَ",310],["6:95:11",140,"ٱلْمَيِّتِ","the dead","مِنَ ٱلْمَيِّتِ وَمُخْرِجُ","مِنَ ٱلْحَىِّ ۚ ذَٰلِكُمُ",310],["6:111:7",142,"ٱلْمَوْتَىٰ","the dead","إِلَيْهِمُ ٱلْمَلَـٰٓئِكَةَ وَكَلَّمَهُمُ","وَحَشَرْنَا عَلَيْهِمْ كُلَّ",310],["6:122:3",143,"مَيْتًۭا","dead","أَوَمَن كَانَ","فَأَحْيَيْنَـٰهُ وَجَعَلْنَا لَهُۥ",1370],["6:139:14",146,"مَّيْتَةًۭ","(born) dead","أَزْوَٰجِنَا ۖ وَإِن يَكُن","فَهُمْ فِيهِ شُرَكَآءُ ۚ",1200],["6:145:15",147,"مَيْتَةً","dead","إِلَّآ أَن يَكُونَ","أَوْ دَمًۭا مَّسْفُوحًا",1200],["6:162:6",150,"وَمَمَاتِى","and my dying","صَلَاتِى وَنُسُكِى وَمَحْيَاىَ","لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ",1888],["7:25:5",153,"تَمُوتُونَ","you will die","فِيهَا تَحْيَوْنَ وَفِيهَا","وَمِنْهَا تُخْرَجُونَ",304],["7:57:16",157,"مَّيِّتٍۢ","dead","ثِقَالًۭا سُقْنَـٰهُ لِبَلَدٍۢ","فَأَنزَلْنَا بِهِ ٱلْمَآءَ",310],["7:57:27",157,"ٱلْمَوْتَىٰ","the dead","ٱلثَّمَرَٰتِ ۚ كَذَٰلِكَ نُخْرِجُ","لَعَلَّكُمْ تَذَكَّرُونَ",310],["7:158:19",170,"وَيُمِيتُ ۖ","and causes death","إِلَّا هُوَ يُحْىِۦ","فَـَٔامِنُوا۟ بِٱللَّهِ وَرَسُولِهِ",485],["8:6:9",177,"ٱلْمَوْتِ","[the] death","كَأَنَّمَا يُسَاقُونَ إِلَى","وَهُمْ يَنظُرُونَ",236],["9:84:6",200,"مَّاتَ","who dies","عَلَىٰٓ أَحَدٍۢ مِّنْهُم","أَبَدًۭا وَلَا تَقُمْ",304],["9:84:16",200,"وَمَاتُوا۟","and died","كَفَرُوا۟ بِٱللَّهِ وَرَسُولِهِۦ","وَهُمْ فَـٰسِقُونَ",304],["9:116:8",205,"وَيُمِيتُ ۚ","and He causes death","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ يُحْىِۦ","وَمَا لَكُم مِّن",485],["9:125:10",207,"وَمَاتُوا۟","And they die","رِجْسًا إِلَىٰ رِجْسِهِمْ","وَهُمْ كَـٰفِرُونَ",304],["10:31:15",212,"ٱلْمَيِّتِ","the dead","يُخْرِجُ ٱلْحَىَّ مِنَ","وَيُخْرِجُ ٱلْمَيِّتَ مِنَ",310],["10:31:17",212,"ٱلْمَيِّتَ","the dead","مِنَ ٱلْمَيِّتِ وَيُخْرِجُ","مِنَ ٱلْحَىِّ وَمَن",310],["10:56:3",215,"وَيُمِيتُ","and causes death","هُوَ يُحْىِۦ","وَإِلَيْهِ تُرْجَعُونَ",485],["11:7:23",222,"ٱلْمَوْتِ","[the] death","مَّبْعُوثُونَ مِنۢ بَعْدِ","لَيَقُولَنَّ ٱلَّذِينَ كَفَرُوٓا۟",236],["13:31:14",253,"ٱلْمَوْتَىٰ ۗ","the dead","أَوْ كُلِّمَ بِهِ","بَل لِّلَّهِ ٱلْأَمْرُ",310],["14:17:6",257,"ٱلْمَوْتُ","the death","يَكَادُ يُسِيغُهُۥ وَيَأْتِيهِ","مِن كُلِّ مَكَانٍۢ",236],["14:17:12",257,"بِمَيِّتٍۢ ۖ","will die","مَكَانٍۢ وَمَا هُوَ","وَمِن وَرَآئِهِۦ عَذَابٌ",310],["15:23:4",263,"وَنُمِيتُ","and We cause death","وَإِنَّا لَنَحْنُ نُحْىِۦ","وَنَحْنُ ٱلْوَٰرِثُونَ",485],["16:21:1",269,"أَمْوَٰتٌ","(They are) dead","","غَيْرُ أَحْيَآءٍۢ ۖ وَمَا",310],["16:38:9",271,"يَمُوتُ ۚ","dies","يَبْعَثُ ٱللَّهُ مَن","بَلَىٰ وَعْدًا عَلَيْهِ",304],["16:65:10",274,"مَوْتِهَآ ۚ","its death","بِهِ ٱلْأَرْضَ بَعْدَ","إِنَّ فِى ذَٰلِكَ",236],["16:115:4",280,"ٱلْمَيْتَةَ","the dead animal","إِنَّمَا حَرَّمَ عَلَيْكُمُ","وَٱلدَّمَ وَلَحْمَ ٱلْخِنزِيرِ",1200],["17:75:6",289,"ٱلْمَمَاتِ","(after) the death","ضِعْفَ ٱلْحَيَوٰةِ وَضِعْفَ","ثُمَّ لَا تَجِدُ",1888],["19:15:6",306,"يَمُوتُ","he dies","يَوْمَ وُلِدَ وَيَوْمَ","وَيَوْمَ يُبْعَثُ حَيًّۭا",304],["19:23:8",306,"مِتُّ","I (had) died","ٱلنَّخْلَةِ قَالَتْ يَـٰلَيْتَنِى","قَبْلَ هَـٰذَا وَكُنتُ",304],["19:33:6",307,"أَمُوتُ","I will die","يَوْمَ وُلِدتُّ وَيَوْمَ","وَيَوْمَ أُبْعَثُ حَيًّۭا",304],["19:66:5",310,"مِتُّ","I am dead","ٱلْإِنسَـٰنُ أَءِذَا مَا","لَسَوْفَ أُخْرَجُ حَيًّا",304],["20:74:10",316,"يَمُوتُ","he will die","لَهُۥ جَهَنَّمَ لَا","فِيهَا وَلَا يَحْيَىٰ",304],["21:34:8",324,"مِّتَّ","you die","قَبْلِكَ ٱلْخُلْدَ ۖ أَفَإِي۟ن","فَهُمُ ٱلْخَـٰلِدُونَ",304],["21:35:4",324,"ٱلْمَوْتِ ۗ","[the] death","كُلُّ نَفْسٍۢ ذَآئِقَةُ","وَنَبْلُوكُم بِٱلشَّرِّ وَٱلْخَيْرِ",236],["22:6:8",333,"ٱلْمَوْتَىٰ","(to) the dead","ٱلْحَقُّ وَأَنَّهُۥ يُحْىِ","وَأَنَّهُۥ عَلَىٰ كُلِّ",310],["22:58:9",339,"مَاتُوا۟","died","ثُمَّ قُتِلُوٓا۟ أَوْ","لَيَرْزُقَنَّهُمُ ٱللَّهُ رِزْقًا",304],["22:66:5",340,"يُمِيتُكُمْ","He will cause you to die","ٱلَّذِىٓ أَحْيَاكُمْ ثُمَّ","ثُمَّ يُحْيِيكُمْ ۗ إِنَّ",485],["23:15:5",342,"لَمَيِّتُونَ","surely (will) die","إِنَّكُم بَعْدَ ذَٰلِكَ","",310],["23:35:4",344,"مِتُّمْ","you are dead","أَيَعِدُكُمْ أَنَّكُمْ إِذَا","وَكُنتُمْ تُرَابًۭا وَعِظَـٰمًا",304],["23:37:6",344,"نَمُوتُ","we die","إِلَّا حَيَاتُنَا ٱلدُّنْيَا","وَنَحْيَا وَمَا نَحْنُ",304],["23:80:4",347,"وَيُمِيتُ","and causes death","وَهُوَ ٱلَّذِى يُحْىِۦ","وَلَهُ ٱخْتِلَـٰفُ ٱلَّيْلِ",485],["23:82:3",347,"مِتْنَا","we are dead","قَالُوٓا۟ أَءِذَا","وَكُنَّا تُرَابًۭا وَعِظَـٰمًا",304],["23:99:5",348,"ٱلْمَوْتُ","the death","إِذَا جَآءَ أَحَدَهُمُ","قَالَ رَبِّ ٱرْجِعُونِ",236],["25:3:18",360,"مَوْتًۭا","death","نَفْعًۭا وَلَا يَمْلِكُونَ","وَلَا حَيَوٰةًۭ وَلَا",236],["25:49:4",364,"مَّيْتًۭا","dead","لِّنُحْـِۧىَ بِهِۦ بَلْدَةًۭ","وَنُسْقِيَهُۥ مِمَّا خَلَقْنَآ",1370],["25:58:6",365,"يَمُوتُ","does not die","ٱلْحَىِّ ٱلَّذِى لَا","وَسَبِّحْ بِحَمْدِهِۦ ۚ وَكَفَىٰ",304],["26:81:2",370,"يُمِيتُنِى","will cause me to die","وَٱلَّذِى","ثُمَّ يُحْيِينِ",485],["27:80:4",384,"ٱلْمَوْتَىٰ","the dead","إِنَّكَ لَا تُسْمِعُ","وَلَا تُسْمِعُ ٱلصُّمَّ",310],["29:57:4",403,"ٱلْمَوْتِ ۖ","the death","كُلُّ نَفْسٍۢ ذَآئِقَةُ","ثُمَّ إِلَيْنَا تُرْجَعُونَ",236],["29:63:13",403,"مَوْتِهَا","its death","ٱلْأَرْضَ مِنۢ بَعْدِ","لَيَقُولُنَّ ٱللَّهُ ۚ قُلِ",236],["30:19:4",406,"ٱلْمَيِّتِ","the dead","يُخْرِجُ ٱلْحَىَّ مِنَ","وَيُخْرِجُ ٱلْمَيِّتَ مِنَ",310],["30:19:6",406,"ٱلْمَيِّتَ","the dead","مِنَ ٱلْمَيِّتِ وَيُخْرِجُ","مِنَ ٱلْحَىِّ وَيُحْىِ",310],["30:19:12",406,"مَوْتِهَا ۚ","its death","وَيُحْىِ ٱلْأَرْضَ بَعْدَ","وَكَذَٰلِكَ تُخْرَجُونَ",236],["30:24:15",406,"مَوْتِهَآ ۚ","its death","بِهِ ٱلْأَرْضَ بَعْدَ","إِنَّ فِى ذَٰلِكَ",236],["30:40:7",408,"يُمِيتُكُمْ","He will cause you to die","ثُمَّ رَزَقَكُمْ ثُمَّ","ثُمَّ يُحْيِيكُمْ ۖ هَلْ",485],["30:50:10",409,"مَوْتِهَآ ۚ","its death","يُحْىِ ٱلْأَرْضَ بَعْدَ","إِنَّ ذَٰلِكَ لَمُحْىِ",236],["30:50:14",409,"ٱلْمَوْتَىٰ ۖ","(to) the dead","إِنَّ ذَٰلِكَ لَمُحْىِ","وَهُوَ عَلَىٰ كُلِّ",310],["30:52:4",410,"ٱلْمَوْتَىٰ","make the dead hear","فَإِنَّكَ لَا تُسْمِعُ","وَلَا تُسْمِعُ ٱلصُّمَّ",310],["31:34:23",414,"تَمُوتُ ۚ","it will die","نَفْسٌۢ بِأَىِّ أَرْضٍۢ","إِنَّ ٱللَّهَ عَلِيمٌ",304],["32:11:4",415,"ٱلْمَوْتِ","(of) the death","۞ قُلْ يَتَوَفَّىٰكُم مَّلَكُ","ٱلَّذِى وُكِّلَ بِكُمْ",236],["33:16:8",420,"ٱلْمَوْتِ","death","إِن فَرَرْتُم مِّنَ","أَوِ ٱلْقَتْلِ وَإِذًۭا",236],["33:19:15",420,"ٱلْمَوْتِ ۖ","[the] death","يُغْشَىٰ عَلَيْهِ مِنَ","فَإِذَا ذَهَبَ ٱلْخَوْفُ",236],["34:14:4",429,"ٱلْمَوْتَ","the death","فَلَمَّا قَضَيْنَا عَلَيْهِ","مَا دَلَّهُمْ عَلَىٰ",236],["34:14:8",429,"مَوْتِهِۦٓ","his death","مَا دَلَّهُمْ عَلَىٰ","إِلَّا دَآبَّةُ ٱلْأَرْضِ",236],["35:9:10",435,"مَّيِّتٍۢ","dead","فَسُقْنَـٰهُ إِلَىٰ بَلَدٍۢ","فَأَحْيَيْنَا بِهِ ٱلْأَرْضَ",310],["35:9:15",435,"مَوْتِهَا ۚ","its death","بِهِ ٱلْأَرْضَ بَعْدَ","كَذَٰلِكَ ٱلنُّشُورُ",236],["35:22:5",437,"ٱلْأَمْوَٰتُ ۚ","the dead","يَسْتَوِى ٱلْأَحْيَآءُ وَلَا","إِنَّ ٱللَّهَ يُسْمِعُ",310],["35:36:9",438,"فَيَمُوتُوا۟","that they die","لَا يُقْضَىٰ عَلَيْهِمْ","وَلَا يُخَفَّفُ عَنْهُم",304],["36:12:4",440,"ٱلْمَوْتَىٰ","(to) the dead","إِنَّا نَحْنُ نُحْىِ","وَنَكْتُبُ مَا قَدَّمُوا۟",310],["36:33:4",442,"ٱلْمَيْتَةُ","dead","وَءَايَةٌۭ لَّهُمُ ٱلْأَرْضُ","أَحْيَيْنَـٰهَا وَأَخْرَجْنَا مِنْهَا",1200],["37:16:2",446,"مِتْنَا","we are dead","أَءِذَا","وَكُنَّا تُرَابًۭا وَعِظَـٰمًا",304],["37:53:2",448,"مِتْنَا","we have died","أَءِذَا","وَكُنَّا تُرَابًۭا وَعِظَـٰمًا",304],["37:58:3",448,"بِمَيِّتِينَ","(to) die","أَفَمَا نَحْنُ","",310],["37:59:2",448,"مَوْتَتَنَا","our death","إِلَّا","ٱلْأُولَىٰ وَمَا نَحْنُ",1893],["39:30:2",461,"مَيِّتٌۭ","will die","إِنَّكَ","وَإِنَّهُم مَّيِّتُونَ",310],["39:30:4",461,"مَّيِّتُونَ","(will also) die","إِنَّكَ مَيِّتٌۭ وَإِنَّهُم","",310],["39:42:5",463,"مَوْتِهَا","(of) their death","يَتَوَفَّى ٱلْأَنفُسَ حِينَ","وَٱلَّتِى لَمْ تَمُتْ",236],["39:42:8",463,"تَمُتْ","die","مَوْتِهَا وَٱلَّتِى لَمْ","فِى مَنَامِهَا ۖ فَيُمْسِكُ",304],["39:42:15",463,"ٱلْمَوْتَ","the death","ٱلَّتِى قَضَىٰ عَلَيْهَا","وَيُرْسِلُ ٱلْأُخْرَىٰٓ إِلَىٰٓ",236],["40:11:3",468,"أَمَتَّنَا","You gave us death","قَالُوا۟ رَبَّنَآ","ٱثْنَتَيْنِ وَأَحْيَيْتَنَا ٱثْنَتَيْنِ",485],["40:68:4",475,"وَيُمِيتُ ۖ","and causes death","هُوَ ٱلَّذِى يُحْىِۦ","فَإِذَا قَضَىٰٓ أَمْرًۭا",485],["41:39:17",481,"ٱلْمَوْتَىٰٓ ۚ","(to) the dead","ٱلَّذِىٓ أَحْيَاهَا لَمُحْىِ","إِنَّهُۥ عَلَىٰ كُلِّ",310],["42:9:11",483,"ٱلْمَوْتَىٰ","(to) the dead","ٱلْوَلِىُّ وَهُوَ يُحْىِ","وَهُوَ عَلَىٰ كُلِّ",310],["43:11:10",490,"مَّيْتًۭا ۚ","dead","فَأَنشَرْنَا بِهِۦ بَلْدَةًۭ","كَذَٰلِكَ تُخْرَجُونَ",1370],["44:8:6",496,"وَيُمِيتُ ۖ","and causes death","إِلَّا هُوَ يُحْىِۦ","رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ",485],["44:35:4",497,"مَوْتَتُنَا","our death","إِنْ هِىَ إِلَّا","ٱلْأُولَىٰ وَمَا نَحْنُ",1893],["44:56:4",498,"ٱلْمَوْتَ","the death","لَا يَذُوقُونَ فِيهَا","إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰ ۖ",236],["44:56:6",498,"ٱلْمَوْتَةَ","the death","فِيهَا ٱلْمَوْتَ إِلَّا","ٱلْأُولَىٰ ۖ وَوَقَىٰهُمْ عَذَابَ",1893],["45:5:15",499,"مَوْتِهَا","its death","بِهِ ٱلْأَرْضَ بَعْدَ","وَتَصْرِيفِ ٱلرِّيَـٰحِ ءَايَـٰتٌۭ",236],["45:21:14",500,"وَمَمَاتُهُمْ ۚ","and their death","ٱلصَّـٰلِحَـٰتِ سَوَآءًۭ مَّحْيَاهُمْ","سَآءَ مَا يَحْكُمُونَ",1888],["45:24:7",501,"نَمُوتُ","we die","إِلَّا حَيَاتُنَا ٱلدُّنْيَا","وَنَحْيَا وَمَا يُهْلِكُنَآ",304],["45:26:5",501,"يُمِيتُكُمْ","causes you to die","ٱللَّهُ يُحْيِيكُمْ ثُمَّ","ثُمَّ يَجْمَعُكُمْ إِلَىٰ",485],["46:33:16",506,"ٱلْمَوْتَىٰ ۚ","(to) the dead","عَلَىٰٓ أَن يُحْـِۧىَ","بَلَىٰٓ إِنَّهُۥ عَلَىٰ",310],["47:20:25",509,"ٱلْمَوْتِ ۖ","the death","ٱلْمَغْشِىِّ عَلَيْهِ مِنَ","فَأَوْلَىٰ لَهُمْ",236],["47:34:9",510,"مَاتُوا۟","died","سَبِيلِ ٱللَّهِ ثُمَّ","وَهُمْ كُفَّارٌۭ فَلَن",304],["49:12:24",517,"مَيْتًۭا","dead","يَأْكُلَ لَحْمَ أَخِيهِ","فَكَرِهْتُمُوهُ ۚ وَٱتَّقُوا۟ ٱللَّهَ ۚ",1370],["50:3:2",518,"مِتْنَا","we die","أَءِذَا","وَكُنَّا تُرَابًۭا ۖ ذَٰلِكَ",304],["50:11:6",518,"مَّيْتًۭا ۚ","dead","وَأَحْيَيْنَا بِهِۦ بَلْدَةًۭ","كَذَٰلِكَ ٱلْخُرُوجُ",1370],["50:19:3",519,"ٱلْمَوْتِ","(of) death","وَجَآءَتْ سَكْرَةُ","بِٱلْحَقِّ ۖ ذَٰلِكَ مَا",236],["50:43:4",520,"وَنُمِيتُ","and [We] cause death","إِنَّا نَحْنُ نُحْىِۦ","وَإِلَيْنَا ٱلْمَصِيرُ",485],["53:44:3",527,"أَمَاتَ","causes death","وَأَنَّهُۥ هُوَ","وَأَحْيَا",485],["56:47:4",535,"مِتْنَا","we die","وَكَانُوا۟ يَقُولُونَ أَئِذَا","وَكُنَّا تُرَابًۭا وَعِظَـٰمًا",304],["56:60:4",536,"ٱلْمَوْتَ","the death","نَحْنُ قَدَّرْنَا بَيْنَكُمُ","وَمَا نَحْنُ بِمَسْبُوقِينَ",236],["57:2:6",537,"وَيُمِيتُ ۖ","and causes death","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ يُحْىِۦ","وَهُوَ عَلَىٰ كُلِّ",485],["57:17:7",539,"مَوْتِهَا ۚ","its death","يُحْىِ ٱلْأَرْضَ بَعْدَ","قَدْ بَيَّنَّا لَكُمُ",236],["62:6:14",553,"ٱلْمَوْتَ","(for) the death","دُونِ ٱلنَّاسِ فَتَمَنَّوُا۟","إِن كُنتُمْ صَـٰدِقِينَ",236],["62:8:3",553,"ٱلْمَوْتَ","the death","قُلْ إِنَّ","ٱلَّذِى تَفِرُّونَ مِنْهُ",236],["63:10:10",555,"ٱلْمَوْتُ","the death","أَن يَأْتِىَ أَحَدَكُمُ","فَيَقُولَ رَبِّ لَوْلَآ",236],["67:2:3",562,"ٱلْمَوْتَ","death","ٱلَّذِى خَلَقَ","وَٱلْحَيَوٰةَ لِيَبْلُوَكُمْ أَيُّكُمْ",236],["75:40:7",578,"ٱلْمَوْتَىٰ","(to) the dead","عَلَىٰٓ أَن يُحْـِۧىَ","",310],["77:26:2",581,"وَأَمْوَٰتًۭا","and (the) dead","أَحْيَآءًۭ","",310],["80:21:2",585,"أَمَاتَهُۥ","He causes him to die","ثُمَّ","فَأَقْبَرَهُۥ",485],["87:13:3",592,"يَمُوتُ","he will die","ثُمَّ لَا","فِيهَا وَلَا يَحْيَىٰ",304]]