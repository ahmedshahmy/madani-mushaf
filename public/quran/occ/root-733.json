[["15:55:7",265,"ٱلْقَـٰنِطِينَ","the despairing","فَلَا تَكُن مِّنَ","",4117],["15:56:3",265,"يَقْنَطُ","despairs","قَالَ وَمَن","مِن رَّحْمَةِ رَبِّهِۦٓ",1620],["30:36:15",408,"يَقْنَطُونَ","despair","أَيْدِيهِمْ إِذَا هُمْ","",1620],["39:53:8",464,"تَقْنَطُوا۟","despair","عَلَىٰٓ أَنفُسِهِمْ لَا","مِن رَّحْمَةِ ٱللَّهِ ۚ",1620],["41:49:11",482,"قَنُوطٌۭ","(and) despairs","مَّسَّهُ ٱلشَّرُّ فَيَـُٔوسٌۭ","",4126],["42:28:8",486,"قَنَطُوا۟","they have despaired","مِنۢ بَعْدِ مَا","وَيَنشُرُ رَحْمَتَهُۥ ۚ وَهُوَ",1620]]