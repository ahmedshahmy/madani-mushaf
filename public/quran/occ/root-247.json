[["2:49:15",8,"بَلَآءٌۭ","(was) a trial","نِسَآءَكُمْ ۚ وَفِى ذَٰلِكُم","مِّن رَّبِّكُمْ عَظِيمٌۭ",1169],["2:124:2",19,"ٱبْتَلَىٰٓ","tried","۞ وَإِذِ","إِبْرَٰهِـۧمَ رَبُّهُۥ بِكَلِمَـٰتٍۢ",1021],["2:155:1",24,"وَلَنَبْلُوَنَّكُم","And surely We will test you","","بِشَىْءٍۢ مِّنَ ٱلْخَوْفِ",513],["2:249:8",41,"مُبْتَلِيكُم","will test you","قَالَ إِنَّ ٱللَّهَ","بِنَهَرٍۢ فَمَن شَرِبَ",2489],["3:152:32",69,"لِيَبْتَلِيَكُمْ ۖ","so that He may test you","ثُمَّ صَرَفَكُمْ عَنْهُمْ","وَلَقَدْ عَفَا عَنكُمْ ۗ",1021],["3:154:63",70,"وَلِيَبْتَلِىَ","And that might test","ٱلْقَتْلُ إِلَىٰ مَضَاجِعِهِمْ ۖ","ٱللَّهُ مَا فِى",1021],["3:186:1",74,"۞ لَتُبْلَوُنَّ","You will certainly be tested","","فِىٓ أَمْوَٰلِكُمْ وَأَنفُسِكُمْ",2803],["4:6:1",77,"وَٱبْتَلُوا۟","And test","","ٱلْيَتَـٰمَىٰ حَتَّىٰٓ إِذَا",1021],["5:48:37",116,"لِّيَبْلُوَكُمْ","to test you","أُمَّةًۭ وَٰحِدَةًۭ وَلَـٰكِن","فِى مَآ ءَاتَىٰكُمْ ۖ",513],["5:94:4",123,"لَيَبْلُوَنَّكُمُ","Surely will test you","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","ٱللَّهُ بِشَىْءٍۢ مِّنَ",513],["6:165:11",150,"لِّيَبْلُوَكُمْ","so that He may test you","فَوْقَ بَعْضٍۢ دَرَجَـٰتٍۢ","فِى مَآ ءَاتَىٰكُمْ ۗ",513],["7:141:15",167,"بَلَآءٌۭ","(was) a trial","نِسَآءَكُمْ ۚ وَفِى ذَٰلِكُم","مِّن رَّبِّكُمْ عَظِيمٌۭ",1169],["7:163:24",171,"نَبْلُوهُم","We test them","لَا تَأْتِيهِمْ ۚ كَذَٰلِكَ","بِمَا كَانُوا۟ يَفْسُقُونَ",513],["7:168:10",172,"وَبَلَوْنَـٰهُم","And We tested them","وَمِنْهُمْ دُونَ ذَٰلِكَ ۖ","بِٱلْحَسَنَـٰتِ وَٱلسَّيِّـَٔاتِ لَعَلَّهُمْ",513],["8:17:13",179,"وَلِيُبْلِىَ","and that He may test","وَلَـٰكِنَّ ٱللَّهَ رَمَىٰ ۚ","ٱلْمُؤْمِنِينَ مِنْهُ بَلَآءً",2803],["8:17:16",179,"بَلَآءً","(with) a trial","وَلِيُبْلِىَ ٱلْمُؤْمِنِينَ مِنْهُ","حَسَنًا ۚ إِنَّ ٱللَّهَ",1169],["10:30:2",212,"تَبْلُوا۟","will be put to trial","هُنَالِكَ","كُلُّ نَفْسٍۢ مَّآ",513],["11:7:13",222,"لِيَبْلُوَكُمْ","that He might test [you]","عَرْشُهُۥ عَلَى ٱلْمَآءِ","أَيُّكُمْ أَحْسَنُ عَمَلًۭا ۗ",513],["14:6:23",256,"بَلَآءٌۭ","(was) a trial","نِسَآءَكُمْ ۚ وَفِى ذَٰلِكُم","مِّن رَّبِّكُمْ عَظِيمٌۭ",1169],["16:92:22",277,"يَبْلُوكُمُ","Allah tests you","مِنْ أُمَّةٍ ۚ إِنَّمَا","ٱللَّهُ بِهِۦ ۚ وَلَيُبَيِّنَنَّ",513],["18:7:8",294,"لِنَبْلُوَهُمْ","that We may test [them]","ٱلْأَرْضِ زِينَةًۭ لَّهَا","أَيُّهُمْ أَحْسَنُ عَمَلًۭا",513],["20:120:13",320,"يَبْلَىٰ","(that will) deteriorate","ٱلْخُلْدِ وَمُلْكٍۢ لَّا","",513],["21:35:5",324,"وَنَبْلُوكُم","And We test you","نَفْسٍۢ ذَآئِقَةُ ٱلْمَوْتِ ۗ","بِٱلشَّرِّ وَٱلْخَيْرِ فِتْنَةًۭ ۖ",513],["23:30:7",344,"لَمُبْتَلِينَ","surely testing","لَـَٔايَـٰتٍۢ وَإِن كُنَّا","",2489],["27:40:24",380,"لِيَبْلُوَنِىٓ","to test me","مِن فَضْلِ رَبِّى","ءَأَشْكُرُ أَمْ أَكْفُرُ ۖ",513],["33:11:2",419,"ٱبْتُلِىَ","were tried","هُنَالِكَ","ٱلْمُؤْمِنُونَ وَزُلْزِلُوا۟ زِلْزَالًۭا",1021],["37:106:4",450,"ٱلْبَلَـٰٓؤُا۟","the trial","إِنَّ هَـٰذَا لَهُوَ","ٱلْمُبِينُ",1169],["44:33:6",497,"بَلَـٰٓؤٌۭا۟","(was) a trial","ٱلْـَٔايَـٰتِ مَا فِيهِ","مُّبِينٌ",1169],["47:4:28",507,"لِّيَبْلُوَا۟","to test","لَٱنتَصَرَ مِنْهُمْ وَلَـٰكِن","بَعْضَكُم بِبَعْضٍۢ ۗ وَٱلَّذِينَ",513],["47:31:1",510,"وَلَنَبْلُوَنَّكُمْ","And surely We will test you","","حَتَّىٰ نَعْلَمَ ٱلْمُجَـٰهِدِينَ",513],["47:31:7",510,"وَنَبْلُوَا۟","and We will test","ٱلْمُجَـٰهِدِينَ مِنكُمْ وَٱلصَّـٰبِرِينَ","أَخْبَارَكُمْ",513],["67:2:5",562,"لِيَبْلُوَكُمْ","that He may test you","خَلَقَ ٱلْمَوْتَ وَٱلْحَيَوٰةَ","أَيُّكُمْ أَحْسَنُ عَمَلًۭا ۚ",513],["68:17:2",565,"بَلَوْنَـٰهُمْ","have tried them","إِنَّا","كَمَا بَلَوْنَآ أَصْحَـٰبَ",513],["68:17:4",565,"بَلَوْنَآ","We tried","إِنَّا بَلَوْنَـٰهُمْ كَمَا","أَصْحَـٰبَ ٱلْجَنَّةِ إِذْ",513],["76:2:7",578,"نَّبْتَلِيهِ","(that) We test him","مِن نُّطْفَةٍ أَمْشَاجٍۢ","فَجَعَلْنَـٰهُ سَمِيعًۢا بَصِيرًا",1021],["86:9:2",591,"تُبْلَى","will be tested","يَوْمَ","ٱلسَّرَآئِرُ",513],["89:15:5",593,"ٱبْتَلَىٰهُ","try him","ٱلْإِنسَـٰنُ إِذَا مَا","رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ",1021],["89:16:4",593,"ٱبْتَلَىٰهُ","He try him","وَأَمَّآ إِذَا مَا","فَقَدَرَ عَلَيْهِ رِزْقَهُۥ",1021]]