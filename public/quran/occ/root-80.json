[["2:61:27",9,"أَدْنَىٰ","(is) inferior","أَتَسْتَبْدِلُونَ ٱلَّذِى هُوَ","بِٱلَّذِى هُوَ خَيْرٌ ۚ",712],["2:85:38",13,"ٱلدُّنْيَا ۖ","(of) the world","خِزْىٌۭ فِى ٱلْحَيَوٰةِ","وَيَوْمَ ٱلْقِيَـٰمَةِ يُرَدُّونَ",102],["2:86:5",13,"ٱلدُّنْيَا","(of) the world","ٱلَّذِينَ ٱشْتَرَوُا۟ ٱلْحَيَوٰةَ","بِٱلْـَٔاخِرَةِ ۖ فَلَا يُخَفَّفُ",102],["2:114:24",18,"ٱلدُّنْيَا","the world","خَآئِفِينَ ۚ لَهُمْ فِى","خِزْىٌۭ وَلَهُمْ فِى",102],["2:130:13",20,"ٱلدُّنْيَا ۖ","the world","وَلَقَدِ ٱصْطَفَيْنَـٰهُ فِى","وَإِنَّهُۥ فِى ٱلْـَٔاخِرَةِ",102],["2:200:18",31,"ٱلدُّنْيَا","the world","رَبَّنَآ ءَاتِنَا فِى","وَمَا لَهُۥ فِى",102],["2:201:7",31,"ٱلدُّنْيَا","the world","رَبَّنَآ ءَاتِنَا فِى","حَسَنَةًۭ وَفِى ٱلْـَٔاخِرَةِ",102],["2:204:8",32,"ٱلدُّنْيَا","(of) the world","قَوْلُهُۥ فِى ٱلْحَيَوٰةِ","وَيُشْهِدُ ٱللَّهَ عَلَىٰ",102],["2:212:5",33,"ٱلدُّنْيَا","(of) the world","لِلَّذِينَ كَفَرُوا۟ ٱلْحَيَوٰةُ","وَيَسْخَرُونَ مِنَ ٱلَّذِينَ",102],["2:217:50",34,"ٱلدُّنْيَا","the world","حَبِطَتْ أَعْمَـٰلُهُمْ فِى","وَٱلْـَٔاخِرَةِ ۖ وَأُو۟لَـٰٓئِكَ أَصْحَـٰبُ",102],["2:220:2",35,"ٱلدُّنْيَا","the world","فِى","وَٱلْـَٔاخِرَةِ ۗ وَيَسْـَٔلُونَكَ عَنِ",102],["2:282:93",48,"وَأَدْنَىٰٓ","and nearer","ٱللَّهِ وَأَقْوَمُ لِلشَّهَـٰدَةِ","أَلَّا تَرْتَابُوٓا۟ ۖ إِلَّآ",712],["3:14:20",51,"ٱلدُّنْيَا ۖ","(of) the world","ذَٰلِكَ مَتَـٰعُ ٱلْحَيَوٰةِ","وَٱللَّهُ عِندَهُۥ حُسْنُ",102],["3:22:6",52,"ٱلدُّنْيَا","the world","حَبِطَتْ أَعْمَـٰلُهُمْ فِى","وَٱلْـَٔاخِرَةِ وَمَا لَهُم",102],["3:45:17",55,"ٱلدُّنْيَا","the world","مَرْيَمَ وَجِيهًۭا فِى","وَٱلْـَٔاخِرَةِ وَمِنَ ٱلْمُقَرَّبِينَ",102],["3:56:8",57,"ٱلدُّنْيَا","the world","عَذَابًۭا شَدِيدًۭا فِى","وَٱلْـَٔاخِرَةِ وَمَا لَهُم",102],["3:117:7",65,"ٱلدُّنْيَا","(of) the world","فِى هَـٰذِهِ ٱلْحَيَوٰةِ","كَمَثَلِ رِيحٍۢ فِيهَا",102],["3:145:14",68,"ٱلدُّنْيَا","(of) the world","وَمَن يُرِدْ ثَوَابَ","نُؤْتِهِۦ مِنْهَا وَمَن",102],["3:148:4",68,"ٱلدُّنْيَا","(in) the world","فَـَٔاتَىٰهُمُ ٱللَّهُ ثَوَابَ","وَحُسْنَ ثَوَابِ ٱلْـَٔاخِرَةِ ۗ",102],["3:152:24",69,"ٱلدُّنْيَا","the world","مِنكُم مَّن يُرِيدُ","وَمِنكُم مَّن يُرِيدُ",102],["3:185:20",74,"ٱلدُّنْيَآ","(of) the world","فَازَ ۗ وَمَا ٱلْحَيَوٰةُ","إِلَّا مَتَـٰعُ ٱلْغُرُورِ",102],["4:3:26",77,"أَدْنَىٰٓ","(is) more appropriate","مَلَكَتْ أَيْمَـٰنُكُمْ ۚ ذَٰلِكَ","أَلَّا تَعُولُوا۟",712],["4:74:8",89,"ٱلدُّنْيَا","(of) the world","ٱلَّذِينَ يَشْرُونَ ٱلْحَيَوٰةَ","بِٱلْـَٔاخِرَةِ ۚ وَمَن يُقَـٰتِلْ",102],["4:77:40",90,"ٱلدُّنْيَا","(of) the world","قَرِيبٍۢ ۗ قُلْ مَتَـٰعُ","قَلِيلٌۭ وَٱلْـَٔاخِرَةُ خَيْرٌۭ",102],["4:94:21",93,"ٱلدُّنْيَا","(of) the world","تَبْتَغُونَ عَرَضَ ٱلْحَيَوٰةِ","فَعِندَ ٱللَّهِ مَغَانِمُ",102],["4:109:7",96,"ٱلدُّنْيَا","(of) the world","عَنْهُمْ فِى ٱلْحَيَوٰةِ","فَمَن يُجَـٰدِلُ ٱللَّهَ",102],["4:134:5",99,"ٱلدُّنْيَا","(of) the world","كَانَ يُرِيدُ ثَوَابَ","فَعِندَ ٱللَّهِ ثَوَابُ",102],["4:134:9",99,"ٱلدُّنْيَا","(of) the world","فَعِندَ ٱللَّهِ ثَوَابُ","وَٱلْـَٔاخِرَةِ ۚ وَكَانَ ٱللَّهُ",102],["5:33:29",113,"ٱلدُّنْيَا ۖ","the world","لَهُمْ خِزْىٌۭ فِى","وَلَهُمْ فِى ٱلْـَٔاخِرَةِ",102],["5:41:61",114,"ٱلدُّنْيَا","the world","قُلُوبَهُمْ ۚ لَهُمْ فِى","خِزْىٌۭ ۖ وَلَهُمْ فِى",102],["5:108:2",125,"أَدْنَىٰٓ","(is) closer","ذَٰلِكَ","أَن يَأْتُوا۟ بِٱلشَّهَـٰدَةِ",712],["6:29:6",131,"ٱلدُّنْيَا","(of) the world","هِىَ إِلَّا حَيَاتُنَا","وَمَا نَحْنُ بِمَبْعُوثِينَ",102],["6:32:3",131,"ٱلدُّنْيَآ","(of) the world","وَمَا ٱلْحَيَوٰةُ","إِلَّا لَعِبٌۭ وَلَهْوٌۭ ۖ",102],["6:70:9",136,"ٱلدُّنْيَا ۚ","(of) the world","وَلَهْوًۭا وَغَرَّتْهُمُ ٱلْحَيَوٰةُ","وَذَكِّرْ بِهِۦٓ أَن",102],["6:99:24",140,"دَانِيَةٌۭ","hanging low","مِن طَلْعِهَا قِنْوَانٌۭ","وَجَنَّـٰتٍۢ مِّنْ أَعْنَابٍۢ",1820],["6:130:21",144,"ٱلدُّنْيَا","(of) the world","أَنفُسِنَا ۖ وَغَرَّتْهُمُ ٱلْحَيَوٰةُ","وَشَهِدُوا۟ عَلَىٰٓ أَنفُسِهِمْ",102],["7:32:18",154,"ٱلدُّنْيَا","(of) the world","ءَامَنُوا۟ فِى ٱلْحَيَوٰةِ","خَالِصَةًۭ يَوْمَ ٱلْقِيَـٰمَةِ ۗ",102],["7:51:8",156,"ٱلدُّنْيَا ۚ","(of) the world","وَلَعِبًۭا وَغَرَّتْهُمُ 