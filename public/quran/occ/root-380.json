[["2:256:9",42,"ٱلْغَىِّ ۚ","the wrong","تَّبَيَّنَ ٱلرُّشْدُ مِنَ","فَمَن يَكْفُرْ بِٱلطَّـٰغُوتِ",1552],["7:16:3",152,"أَغْوَيْتَنِى","You have sent me astray","قَالَ فَبِمَآ","لَأَقْعُدَنَّ لَهُمْ صِرَٰطَكَ",954],["7:146:27",168,"ٱلْغَىِّ","(of) [the] error","وَإِن يَرَوْا۟ سَبِيلَ","يَتَّخِذُوهُ سَبِيلًۭا ۚ ذَٰلِكَ",1552],["7:175:13",173,"ٱلْغَاوِينَ","those gone astray","ٱلشَّيْطَـٰنُ فَكَانَ مِنَ","",1182],["7:202:4",176,"ٱلْغَىِّ","the error","وَإِخْوَٰنُهُمْ يَمُدُّونَهُمْ فِى","ثُمَّ لَا يُقْصِرُونَ",1552],["11:34:14",225,"يُغْوِيَكُمْ ۚ","let you go astray","ٱللَّهُ يُرِيدُ أَن","هُوَ رَبُّكُمْ وَإِلَيْهِ",954],["15:39:4",264,"أَغْوَيْتَنِى","You misled me","قَالَ رَبِّ بِمَآ","لَأُزَيِّنَنَّ لَهُمْ فِى",954],["15:39:9",264,"وَلَأُغْوِيَنَّهُمْ","and I will mislead them","لَهُمْ فِى ٱلْأَرْضِ","أَجْمَعِينَ",954],["15:42:11",264,"ٱلْغَاوِينَ","the ones who go astray","مَنِ ٱتَّبَعَكَ مِنَ","",1182],["19:59:11",309,"غَيًّا","evil","ٱلشَّهَوَٰتِ ۖ فَسَوْفَ يَلْقَوْنَ","",1552],["20:121:15",320,"فَغَوَىٰ","and erred","وَعَصَىٰٓ ءَادَمُ رَبَّهُۥ","",1848],["26:91:3",371,"لِلْغَاوِينَ","to the deviators","وَبُرِّزَتِ ٱلْجَحِيمُ","",1182],["26:94:4",371,"وَٱلْغَاوُۥنَ","and the deviators","فَكُبْكِبُوا۟ فِيهَا هُمْ","",1182],["26:224:3",376,"ٱلْغَاوُۥنَ","the deviators","وَٱلشُّعَرَآءُ يَتَّبِعُهُمُ","",1182],["28:18:15",387,"لَغَوِىٌّۭ","(are) surely a deviator","لَهُۥ مُوسَىٰٓ إِنَّكَ","مُّبِينٌۭ",3469],["28:63:9",393,"أَغْوَيْنَآ","we led astray","رَبَّنَا هَـٰٓؤُلَآءِ ٱلَّذِينَ","أَغْوَيْنَـٰهُمْ كَمَا غَوَيْنَا ۖ",954],["28:63:10",393,"أَغْوَيْنَـٰهُمْ","We led them astray","هَـٰٓؤُلَآءِ ٱلَّذِينَ أَغْوَيْنَآ","كَمَا غَوَيْنَا ۖ تَبَرَّأْنَآ",954],["28:63:12",393,"غَوَيْنَا ۖ","we were astray","أَغْوَيْنَآ أَغْوَيْنَـٰهُمْ كَمَا","تَبَرَّأْنَآ إِلَيْكَ ۖ مَا",1848],["37:32:1",447,"فَأَغْوَيْنَـٰكُمْ","So we led you astray","","إِنَّا كُنَّا غَـٰوِينَ",954],["37:32:4",447,"غَـٰوِينَ","astray","فَأَغْوَيْنَـٰكُمْ إِنَّا كُنَّا","",1182],["38:82:3",457,"لَأُغْوِيَنَّهُمْ","I will surely mislead them","قَالَ فَبِعِزَّتِكَ","أَجْمَعِينَ",954],["53:2:5",526,"غَوَىٰ","has he erred","ضَلَّ صَاحِبُكُمْ وَمَا","",1848]]