[["2:74:2",11,"قَسَتْ","hardened","ثُمَّ","قُلُوبُكُم مِّنۢ بَعْدِ",1958],["2:74:11",11,"قَسْوَةًۭ ۚ","(in) hardness","كَٱلْحِجَارَةِ أَوْ أَشَدُّ","وَإِنَّ مِنَ ٱلْحِجَارَةِ",4127],["5:13:7",109,"قَـٰسِيَةًۭ ۖ","hard","لَعَنَّـٰهُمْ وَجَعَلْنَا قُلُوبَهُمْ","يُحَرِّفُونَ ٱلْكَلِمَ عَن",1955],["6:43:7",132,"قَسَتْ","became hardened","بَأْسُنَا تَضَرَّعُوا۟ وَلَـٰكِن","قُلُوبُهُمْ وَزَيَّنَ لَهُمُ",1958],["22:53:10",338,"وَٱلْقَاسِيَةِ","and (are) hardened","فِى قُلُوبِهِم مَّرَضٌۭ","قُلُوبُهُمْ ۗ وَإِنَّ ٱلظَّـٰلِمِينَ",1955],["39:22:12",461,"لِّلْقَـٰسِيَةِ","to (those are) hardened","مِّن رَّبِّهِۦ ۚ فَوَيْلٌۭ","قُلُوبُهُم مِّن ذِكْرِ",1955],["57:16:24",539,"فَقَسَتْ","so hardened","فَطَالَ عَلَيْهِمُ ٱلْأَمَدُ","قُلُوبُهُمْ ۖ وَكَثِيرٌۭ مِّنْهُمْ",1958]]