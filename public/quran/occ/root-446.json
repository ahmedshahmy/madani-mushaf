[["4:18:21",80,"أَعْتَدْنَا","We have prepared","وَهُمْ كُفَّارٌ ۚ أُو۟لَـٰٓئِكَ","لَهُمْ عَذَابًا أَلِيمًۭا",646],["4:37:12",84,"وَأَعْتَدْنَا","and We (have) prepared","ٱللَّهُ مِن فَضْلِهِۦ ۗ","لِلْكَـٰفِرِينَ عَذَابًۭا مُّهِينًۭا",646],["4:151:5",102,"وَأَعْتَدْنَا","And We have prepared","هُمُ ٱلْكَـٰفِرُونَ حَقًّۭا ۚ","لِلْكَـٰفِرِينَ عَذَابًۭا مُّهِينًۭا",646],["4:161:10",103,"وَأَعْتَدْنَا","And We have prepared","أَمْوَٰلَ ٱلنَّاسِ بِٱلْبَـٰطِلِ ۚ","لِلْكَـٰفِرِينَ مِنْهُمْ عَذَابًا",646],["12:31:6",239,"وَأَعْتَدَتْ","and she prepared","بِمَكْرِهِنَّ أَرْسَلَتْ إِلَيْهِنَّ","لَهُنَّ مُتَّكَـًۭٔا وَءَاتَتْ",646],["17:10:6",283,"أَعْتَدْنَا","We have prepared","لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ","لَهُمْ عَذَابًا أَلِيمًۭا",646],["18:29:12",297,"أَعْتَدْنَا","have prepared","شَآءَ فَلْيَكْفُرْ ۚ إِنَّآ","لِلظَّـٰلِمِينَ نَارًا أَحَاطَ",646],["18:102:11",304,"أَعْتَدْنَا","We have prepared","دُونِىٓ أَوْلِيَآءَ ۚ إِنَّآ","جَهَنَّمَ لِلْكَـٰفِرِينَ نُزُلًۭا",646],["25:11:4",360,"وَأَعْتَدْنَا","and We have prepared","بَلْ كَذَّبُوا۟ بِٱلسَّاعَةِ ۖ","لِمَن كَذَّبَ بِٱلسَّاعَةِ",646],["25:37:10",363,"وَأَعْتَدْنَا","And We have prepared","وَجَعَلْنَـٰهُمْ لِلنَّاسِ ءَايَةًۭ ۖ","لِلظَّـٰلِمِينَ عَذَابًا أَلِيمًۭا",646],["33:31:11",422,"وَأَعْتَدْنَا","and We have prepared","نُّؤْتِهَآ أَجْرَهَا مَرَّتَيْنِ","لَهَا رِزْقًۭا كَرِيمًۭا",646],["48:13:7",512,"أَعْتَدْنَا","[We] have prepared","بِٱللَّهِ وَرَسُولِهِۦ فَإِنَّآ","لِلْكَـٰفِرِينَ سَعِيرًۭا",646],["50:18:8",519,"عَتِيدٌۭ","ready","إِلَّا لَدَيْهِ رَقِيبٌ","",2246],["50:23:6",519,"عَتِيدٌ","ready","هَـٰذَا مَا لَدَىَّ","",2246],["67:5:9",562,"وَأَعْتَدْنَا","and We have prepared","وَجَعَلْنَـٰهَا رُجُومًۭا لِّلشَّيَـٰطِينِ ۖ","لَهُمْ عَذَابَ ٱلسَّعِيرِ",646],["76:4:2",578,"أَعْتَدْنَا","[We] have prepared","إِنَّآ","لِلْكَـٰفِرِينَ سَلَـٰسِلَا۟ وَأَغْلَـٰلًۭا",646]]