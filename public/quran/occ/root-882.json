[["3:179:11",73,"يَمِيزَ","He separates","أَنتُمْ عَلَيْهِ حَتَّىٰ","ٱلْخَبِيثَ مِنَ ٱلطَّيِّبِ ۗ",2772],["8:37:1",181,"لِيَمِيزَ","That may distinguish","","ٱللَّهُ ٱلْخَبِيثَ مِنَ",2772],["36:59:1",444,"وَٱمْتَـٰزُوا۟","But stand apart","","ٱلْيَوْمَ أَيُّهَا ٱلْمُجْرِمُونَ",4809],["67:8:2",562,"تَمَيَّزُ","bursts","تَكَادُ","مِنَ ٱلْغَيْظِ ۖ كُلَّمَآ",4392]]