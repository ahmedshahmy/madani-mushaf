[["2:22:11",4,"مَآءًۭ","water","وَأَنزَلَ مِنَ ٱلسَّمَآءِ","فَأَخْرَجَ بِهِۦ مِنَ",191],["2:74:25",11,"ٱلْمَآءُ ۚ","[the] water","يَشَّقَّقُ فَيَخْرُجُ مِنْهُ","وَإِنَّ مِنْهَا لَمَا",191],["2:164:23",25,"مَّآءٍۢ","water","مِنَ ٱلسَّمَآءِ مِن","فَأَحْيَا بِهِ ٱلْأَرْضَ",191],["4:43:37",85,"مَآءًۭ","water","ٱلنِّسَآءَ فَلَمْ تَجِدُوا۟","فَتَيَمَّمُوا۟ صَعِيدًۭا طَيِّبًۭا",191],["5:6:39",108,"مَآءًۭ","water","ٱلنِّسَآءَ فَلَمْ تَجِدُوا۟","فَتَيَمَّمُوا۟ صَعِيدًۭا طَيِّبًۭا",191],["6:99:6",140,"مَآءًۭ","water","أَنزَلَ مِنَ ٱلسَّمَآءِ","فَأَخْرَجْنَا بِهِۦ نَبَاتَ",191],["7:50:10",156,"ٱلْمَآءِ","(some) water","أَفِيضُوا۟ عَلَيْنَا مِنَ","أَوْ مِمَّا رَزَقَكُمُ",191],["7:57:19",157,"ٱلْمَآءَ","the water","مَّيِّتٍۢ فَأَنزَلْنَا بِهِ","فَأَخْرَجْنَا بِهِۦ مِن",191],["8:11:10",178,"مَآءًۭ","water","عَلَيْكُم مِّنَ ٱلسَّمَآءِ","لِّيُطَهِّرَكُم بِهِۦ وَيُذْهِبَ",191],["10:24:5",211,"كَمَآءٍ","(is) like (the) water","مَثَلُ ٱلْحَيَوٰةِ ٱلدُّنْيَا","أَنزَلْنَـٰهُ مِنَ ٱلسَّمَآءِ",191],["11:7:12",222,"ٱلْمَآءِ","the water","وَكَانَ عَرْشُهُۥ عَلَى","لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ",191],["11:43:7",226,"ٱلْمَآءِ ۚ","the water","جَبَلٍۢ يَعْصِمُنِى مِنَ","قَالَ لَا عَاصِمَ",191],["11:44:4",226,"مَآءَكِ","your water","وَقِيلَ يَـٰٓأَرْضُ ٱبْلَعِى","وَيَـٰسَمَآءُ أَقْلِعِى وَغِيضَ",191],["11:44:8",226,"ٱلْمَآءُ","the water","وَيَـٰسَمَآءُ أَقْلِعِى وَغِيضَ","وَقُضِىَ ٱلْأَمْرُ وَٱسْتَوَتْ",191],["13:4:14",249,"بِمَآءٍۢ","with water","وَغَيْرُ صِنْوَانٍۢ يُسْقَىٰ","وَٰحِدٍۢ وَنُفَضِّلُ بَعْضَهَا",191],["13:14:16",251,"ٱلْمَآءِ","water","كَبَـٰسِطِ كَفَّيْهِ إِلَى","لِيَبْلُغَ فَاهُ وَمَا",191],["13:17:4",251,"مَآءًۭ","water","أَنزَلَ مِنَ ٱلسَّمَآءِ","فَسَالَتْ أَوْدِيَةٌۢ بِقَدَرِهَا",191],["14:16:6",257,"مَّآءٍۢ","water","جَهَنَّمُ وَيُسْقَىٰ مِن","صَدِيدٍۢ",191],["14:32:9",259,"مَآءًۭ","water","وَأَنزَلَ مِنَ ٱلسَّمَآءِ","فَأَخْرَجَ بِهِۦ مِنَ",191],["15:22:7",263,"مَآءًۭ","water","فَأَنزَلْنَا مِنَ ٱلسَّمَآءِ","فَأَسْقَيْنَـٰكُمُوهُ وَمَآ أَن