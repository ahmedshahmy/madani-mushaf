[["12:68:16",243,"حَاجَةًۭ","(it was) a need","مِن شَىْءٍ إِلَّا","فِى نَفْسِ يَعْقُوبَ",1772],["40:80:6",476,"حَاجَةًۭ","a need","مَنَـٰفِعُ وَلِتَبْلُغُوا۟ عَلَيْهَا","فِى صُدُورِكُمْ وَعَلَيْهَا",1772],["59:9:15",546,"حَاجَةًۭ","any want","يَجِدُونَ فِى صُدُورِهِمْ","مِّمَّآ أُوتُوا۟ وَيُؤْثِرُونَ",1772]]