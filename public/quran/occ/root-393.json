[["2:62:5",10,"هَادُوا۟","became Jews","ٱلَّذِينَ ءَامَنُوا۟ وَٱلَّذِينَ","وَٱلنَّصَـٰرَىٰ وَٱلصَّـٰبِـِٔينَ مَنْ",782],["2:111:8",17,"هُودًا","(a) Jew[s]","إِلَّا مَن كَانَ","أَوْ نَصَـٰرَىٰ ۗ تِلْكَ",1851],["2:135:3",21,"هُودًا","Jews","وَقَالُوا۟ كُونُوا۟","أَوْ نَصَـٰرَىٰ تَهْتَدُوا۟ ۗ",1851],["2:140:10",21,"هُودًا","Jews","وَيَعْقُوبَ وَٱلْأَسْبَاطَ كَانُوا۟","أَوْ نَصَـٰرَىٰ ۗ قُلْ",1851],["4:46:3",86,"هَادُوا۟","are Jews","مِّنَ ٱلَّذِينَ","يُحَرِّفُونَ ٱلْكَلِمَ عَن",782],["4:160:4",103,"هَادُوا۟","were Jews","فَبِظُلْمٍۢ مِّنَ ٱلَّذِينَ","حَرَّمْنَا عَلَيْهِمْ طَيِّبَـٰتٍ",782],["5:41:19",114,"هَادُوا۟ ۛ","(are) Jews","قُلُوبُهُمْ ۛ وَمِنَ ٱلَّذِينَ","سَمَّـٰعُونَ لِلْكَذِبِ سَمَّـٰعُونَ",782],["5:44:13",115,"هَادُوا۟","were Jews","ٱلَّذِينَ أَسْلَمُوا۟ لِلَّذِينَ","وَٱلرَّبَّـٰنِيُّونَ وَٱلْأَحْبَارُ بِمَا",782],["5:69:5",119,"هَادُوا۟","became Jews","ٱلَّذِينَ ءَامَنُوا۟ وَٱلَّذِينَ","وَٱلصَّـٰبِـُٔونَ وَٱلنَّصَـٰرَىٰ مَنْ",782],["6:146:3",147,"هَادُوا۟","are Jews","وَعَلَى ٱلَّذِينَ","حَرَّمْنَا كُلَّ ذِى",782],["7:65:4",158,"هُودًۭا ۗ","Hud","۞ وَإِلَىٰ عَادٍ أَخَاهُمْ","قَالَ يَـٰقَوْمِ ٱعْبُدُوا۟",1074],["7:156:10",170,"هُدْنَآ","we have turned","وَفِى ٱلْـَٔاخِرَةِ إِنَّا","إِلَيْكَ ۚ قَالَ عَذَابِىٓ",782],["11:50:4",227,"هُودًۭا ۚ","Hud","وَإِلَىٰ عَادٍ أَخَاهُمْ","قَالَ يَـٰقَوْمِ ٱعْبُدُوا۟",1074],["11:53:2",227,"يَـٰهُودُ","O Hud","قَالُوا۟","مَا جِئْتَنَا بِبَيِّنَةٍۢ",1074],["11:58:5",228,"هُودًۭا","Hud","جَآءَ أَمْرُنَا نَجَّيْنَا","وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ",1074],["11:60:17",228,"هُودٍۢ","(of) Hud","بُعْدًۭا لِّعَادٍۢ قَوْمِ","",1074],["11:89:14",232,"هُودٍ","(the) people of Hud","نُوحٍ أَوْ قَوْمَ","أَوْ قَوْمَ صَـٰلِحٍۢ ۚ",1074],["16:118:3",280,"هَادُوا۟","are Jews","وَعَلَى ٱلَّذِينَ","حَرَّمْنَا مَا قَصَصْنَا",782],["22:17:5",334,"هَادُوا۟","were Jews","ٱلَّذِينَ ءَامَنُوا۟ وَٱلَّذِينَ","وَٱلصَّـٰبِـِٔينَ وَٱلنَّصَـٰرَىٰ وَٱلْمَجُوسَ",782],["26:124:5",372,"هُودٌ","Hud","قَالَ لَهُمْ أَخُوهُمْ","أَلَا تَتَّقُونَ",1074],["62:6:4",553,"هَادُوٓا۟","(are) Jews","قُلْ يَـٰٓأَيُّهَا ٱلَّذِينَ","إِن زَعَمْتُمْ أَنَّكُمْ",782]]