[["1:4:2",1,"يَوْمِ","(of the) Day","مَـٰلِكِ","ٱلدِّينِ",25],["2:8:7",3,"وَبِٱلْيَوْمِ","and in the Day","يَقُولُ ءَامَنَّا بِٱللَّهِ","ٱلْـَٔاخِرِ وَمَا هُم",25],["2:48:2",7,"يَوْمًۭا","a day","وَٱتَّقُوا۟","لَّا تَجْزِى نَفْسٌ",25],["2:62:11",10,"وَٱلْيَوْمِ","and the Day","مَنْ ءَامَنَ بِٱللَّهِ","ٱلْـَٔاخِرِ وَعَمِلَ صَـٰلِحًۭا",25],["2:80:6",12,"أَيَّامًۭا","(for) days","تَمَسَّنَا ٱلنَّارُ إِلَّآ","مَّعْدُودَةًۭ ۚ قُلْ أَتَّخَذْتُمْ",25],["2:85:39",13,"وَيَوْمَ","and (on the) Day","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ","ٱلْقِيَـٰمَةِ يُرَدُّونَ إِلَىٰٓ",25],["2:113:26",18,"يَوْمَ","(on the) Day","فَٱللَّهُ يَحْكُمُ بَيْنَهُمْ","ٱلْقِيَـٰمَةِ فِيمَا كَانُوا۟",25],["2:123:2",19,"يَوْمًۭا","a day","وَٱتَّقُوا۟","لَّا تَجْزِى نَفْسٌ",25],["2:126:17",19,"وَٱلْيَوْمِ","and the Day","ءَامَنَ مِنْهُم بِٱللَّهِ","ٱلْـَٔاخِرِ ۖ قَالَ وَمَن",25],["2:174:23",26,"يَوْمَ","(on the) Day","وَلَا يُكَلِّمُهُمُ ٱللَّهُ","ٱلْقِيَـٰمَةِ وَلَا يُزَكِّيهِمْ",25],["2:177:14",27,"وَٱلْيَوْمِ","and the Day","مَنْ ءَامَنَ بِٱللَّهِ","ٱلْـَٔاخِرِ وَٱلْمَلَـٰٓئِكَةِ وَٱلْكِتَـٰبِ",25],["2:184:1",28,"أَيَّامًۭا","(Fasting for) days","","مَّعْدُودَٰتٍۢ ۚ فَمَن كَانَ",25],["2:184:12",28,"أَيَّامٍ","days","سَفَرٍۢ فَعِدَّةٌۭ مِّنْ","أُخَرَ ۚ وَعَلَى ٱلَّذِينَ",25],["2:185:26",28,"أَيَّامٍ","days","سَفَرٍۢ فَعِدَّةٌۭ مِّنْ","أُخَرَ ۗ يُرِيدُ ٱللَّهُ",25],["2:196:50",30,"أَيَّامٍۢ","days","يَجِدْ فَصِيَامُ ثَلَـٰثَةِ","فِى ٱلْحَجِّ وَسَبْعَةٍ",25],["2:203:4",32,"أَيَّامٍۢ","days","۞ وَٱذْكُرُوا۟ ٱللَّهَ فِىٓ","مَّعْدُودَٰتٍۢ ۚ فَمَن تَعَجَّلَ",25],["2:203:9",32,"يَوْمَيْنِ","two days","فَمَن تَعَجَّلَ فِى","فَلَآ إِثْمَ عَلَيْهِ",25],["2:212:13",33,"يَوْمَ","(on the) Day","وَٱلَّذِينَ ٱتَّقَوْا۟ فَوْقَهُمْ","ٱلْقِيَـٰمَةِ ۗ وَٱللَّهُ يَرْزُقُ",25],["2:228:20",36,"وَٱلْيَوْمِ","and the Day","كُنَّ يُؤْمِنَّ بِٱللَّهِ","ٱلْـَٔاخِرِ ۚ وَبُعُولَتُهُنَّ أَحَقُّ",25],["2:232:23",37,"وَٱلْيَوْمِ","and the Day","مِنكُمْ يُؤْمِنُ بِٱللَّهِ","ٱلْـَٔاخِرِ ۗ ذَٰلِكُمْ أَزْكَىٰ",25],["2:249:40",41,"ٱلْيَوْمَ","today","لَا طَاقَةَ لَنَا","بِجَالُوتَ وَجُنُودِهِۦ ۚ قَالَ",25],["2:254:11",42,"يَوْمٌۭ","a Day","قَبْلِ أَن يَأْتِىَ","لَّا بَيْعٌۭ فِيهِ",25],["2:259:28",43,"يَوْمًا","(for) a day","لَبِثْتَ ۖ قَالَ لَبِثْتُ","أَوْ بَعْضَ يَوْمٍۢ ۖ",25],["2:259:31",43,"يَوْمٍۢ ۖ","(of) a day","يَوْمًا أَوْ بَعْضَ","قَالَ بَل لَّبِثْتَ",25],["2:264:17",44,"وَٱلْيَوْمِ","and the Day","وَلَا يُؤْمِنُ بِٱللَّهِ","ٱلْـَٔاخِرِ ۖ فَمَثَلُهُۥ كَمَثَلِ",25],["2:281:2",47,"يَوْمًۭا","a Day","وَٱتَّقُوا۟","تُرْجَعُونَ فِيهِ إِلَى",25],["3:9:5",50,"لِيَوْمٍۢ","on a Day","إِنَّكَ جَامِعُ ٱلنَّاسِ","لَّا رَيْبَ فِيهِ ۚ",25],["3:24:8",53,"أَيَّامًۭا","(for) days","تَمَسَّنَا ٱلنَّارُ إِلَّآ","مَّعْدُودَٰتٍۢ ۖ وَغَرَّهُمْ فِى",25],["3:25:4",53,"لِيَوْمٍۢ","on a Day","فَكَيْفَ إِذَا جَمَعْنَـٰهُمْ","لَّا رَيْبَ فِيهِ",25],["3:30:1",54,"يَوْمَ","(On the) day","","تَجِدُ كُلُّ نَفْسٍۢ",25],["3:41:12",55,"أَيَّامٍ","days","تُكَلِّمَ ٱلنَّاسَ ثَلَـٰثَةَ","إِلَّا رَمْزًۭا ۗ وَٱذْكُر",25],["3:55:20",57,"يَوْمِ","(the) Day","ٱلَّذِينَ كَفَرُوٓا۟ إِلَىٰ","ٱلْقِيَـٰمَةِ ۖ ثُمَّ إِلَىَّ",25],["3:77:21",59,"يَوْمَ","(on the) Day","وَلَا يَنظُرُ إِلَيْهِمْ","ٱلْقِيَـٰمَةِ وَلَا يُزَكِّيهِمْ",25],["3:106:1",63,"يَوْمَ","(On the) Day","","تَبْيَضُّ وُجُوهٌۭ وَتَسْوَدُّ",25],["3:114:3",64,"وَٱلْيَوْمِ","and the Day","يُؤْمِنُونَ بِٱللَّهِ","ٱلْـَٔاخِرِ وَيَأْمُرُونَ بِٱلْمَعْرُوفِ",25],["3:140:10",67,"ٱلْأَيَّامُ","[the] days","قَرْحٌۭ مِّثْلُهُۥ ۚ وَتِلْكَ","نُدَاوِلُهَا بَيْنَ ٱلنَّاسِ",25],["3:155:5",70,"يَوْمَ","(on the) day","ٱلَّذِينَ تَوَلَّوْا۟ مِنكُمْ","ٱلْتَقَى ٱلْجَمْعَانِ إِنَّمَا",25],["3:161:11",71,"يَوْمَ","(on the) Day","يَأْتِ بِمَا غَلَّ","ٱلْقِيَـٰمَةِ ۚ ثُمَّ تُوَفَّىٰ",25],["3:166:3",72,"يَوْمَ","(on the) day","وَمَآ أَصَـٰبَكُمْ","ٱلْتَقَى ٱلْجَمْعَانِ فَبِإِذْنِ",25],["3:180:21",73,"يَوْمَ","(on the) Day","مَا بَخِلُوا۟ بِهِۦ","ٱلْقِيَـٰمَةِ ۗ وَلِلَّهِ مِيرَٰثُ",25],["3:185:8",74,"يَوْمَ","(on the) Day","وَإِنَّمَا تُوَفَّوْنَ أُجُورَكُمْ","ٱلْقِيَـٰمَةِ ۖ فَمَن زُحْزِحَ",25],["3:194:9",75,"يَوْمَ","(on the) Day","رُسُلِكَ وَلَا تُخْزِنَا","ٱلْقِيَـٰمَةِ ۗ إِنَّكَ لَا",25],["4:38:10",85,"بِٱلْيَوْمِ","in the Day","يُؤْمِنُونَ بِٱللَّهِ وَلَا","ٱلْـَٔاخِرِ ۗ وَمَن يَكُنِ",25],["4:39:6",85,"وَٱلْيَوْمِ","and the Day","لَوْ ءَامَنُوا۟ بِٱللَّهِ","ٱلْـَٔاخِرِ وَأَنفَقُوا۟ مِمَّا",25],["4:59:23",87,"وَٱلْيَوْمِ","and the Day","كُنتُمْ تُؤْمِنُونَ بِٱللَّهِ","ٱلْـَٔاخِرِ ۚ ذَٰلِكَ خَيْرٌۭ",25],["4:87:8",92,"يَوْمِ","(the) Day","هُوَ ۚ لَيَجْمَعَنَّكُمْ إِلَىٰ","ٱلْقِيَـٰمَةِ لَا رَيْبَ",25],["4:109:12",96,"يَوْمَ","(on the) Day","يُجَـٰدِلُ ٱللَّهَ عَنْهُمْ","ٱلْقِيَـٰمَةِ أَم مَّن",25],["4:136:23",100,"وَٱلْيَوْمِ","and the Day","وَمَلَـٰٓئِكَتِهِۦ وَكُتُبِهِۦ وَرُسُلِهِۦ","ٱلْـَٔاخِرِ فَقَدْ ضَلَّ",25],["4:141:28",101,"يَوْمَ","(on the) Day","فَٱللَّهُ يَحْكُمُ بَيْنَكُمْ","ٱلْقِيَـٰمَةِ ۗ وَلَن يَجْعَلَ",25],["4:159:10",103,"وَيَوْمَ","And (on the) Day","بِهِۦ قَبْلَ مَوْتِهِۦ ۖ","ٱلْقِيَـٰمَةِ يَكُونُ عَلَيْهِمْ",25],["4:162:21",103,"وَٱلْيَوْمِ","and the Day","ٱلزَّكَوٰةَ وَٱلْمُؤْمِنُونَ بِٱللَّهِ","ٱلْـَٔاخِرِ أُو۟لَـٰٓئِكَ سَنُؤْتِيهِمْ",25],["5:3:31",107,"ٱلْيَوْمَ","This day","بِٱلْأَزْلَـٰمِ ۚ ذَٰلِكُمْ فِسْقٌ ۗ","يَئِسَ ٱلَّذِينَ كَفَرُوا۟",25],["5:3:40",107,"ٱلْيَوْمَ","This day","فَلَا تَخْشَوْهُمْ وَٱخْشَوْنِ ۚ","أَكْمَلْتُ لَكُمْ دِينَكُمْ",25],["5:5:1",107,"ٱلْيَوْمَ","This day","","أُحِلَّ لَكُمُ ٱلطَّيِّبَـٰتُ ۖ",25],["5:14:18",110,"يَوْمِ","(the) Day","ٱلْعَدَاوَةَ وَٱلْبَغْضَآءَ إِلَىٰ","ٱلْقِيَـٰمَةِ ۚ وَسَوْفَ يُنَبِّئُهُمُ",25],["5:36:17",113,"يَوْمِ","(of the) Day","بِهِۦ مِنْ عَذَابِ","ٱلْقِيَـٰمَةِ مَا تُقُبِّلَ",25],["5:64:32",118,"يَوْمِ","(the) Day","ٱلْعَدَٰوَةَ وَٱلْبَغْضَآءَ إِلَىٰ","ٱلْقِيَـٰمَةِ ۚ كُلَّمَآ أَوْقَدُوا۟",25],["5:69:11",119,"وَٱلْيَوْمِ","and the Day","مَنْ ءَامَنَ بِٱللَّهِ","ٱلْـَٔاخِرِ وَعَمِلَ صَـٰلِحًۭا",25],["5:89:31",122,"أَيَّامٍۢ ۚ","days","يَجِدْ فَصِيَامُ ثَلَـٰثَةِ","ذَٰلِكَ كَفَّـٰرَةُ أَيْمَـٰنِكُمْ",25],["5:109:1",126,"۞ يَوْمَ","(The) day","","يَجْمَعُ ٱللَّهُ ٱلرُّسُلَ",25],["5:119:4",127,"يَوْمُ","Day","قَالَ ٱللَّهُ هَـٰذَا","يَنفَعُ ٱلصَّـٰدِقِينَ صِدْقُهُمْ ۚ",25],["6:12:15",129,"يَوْمِ","(the) Day","ٱلرَّحْمَةَ ۚ لَيَجْمَعَنَّكُمْ إِلَىٰ","ٱلْقِيَـٰمَةِ لَا رَيْبَ",25],["6:15:8",129,"يَوْمٍ","(of) a Day","عَصَيْتُ رَبِّى عَذَابَ","عَظِيمٍۢ",25],["6:22:1",130,"وَيَوْمَ","And (the) Day","","نَحْشُرُهُمْ جَمِيعًۭا ثُمَّ",25],["6:73:7",136,"وَيَوْمَ","And (the) Day","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ ۖ","يَقُولُ كُن فَيَكُونُ ۚ",25],["6:73:15",136,"يَوْمَ","(on the) Day","ٱلْحَقُّ ۚ وَلَهُ ٱلْمُلْكُ","يُنفَخُ فِى ٱلصُّورِ ۚ",25],["6:93:35",139,"ٱلْيَوْمَ","Today","أَيْدِيهِمْ أَخْرِجُوٓا۟ أَنفُسَكُمُ ۖ","تُجْزَوْنَ عَذَابَ ٱلْهُونِ",25],["6:128:1",144,"وَيَوْمَ","And (the) Day","","يَحْشُرُهُمْ جَمِيعًۭا يَـٰمَعْشَرَ",25],["6:130:13",144,"يَوْمِكُمْ","(of) your day","ءَايَـٰتِى وَيُنذِرُونَكُمْ لِقَآءَ","هَـٰذَا ۚ قَالُوا۟ شَهِدْنَا",25],["6:141:24",146,"يَوْمَ","(on the) day","أَثْمَرَ وَءَاتُوا۟ حَقَّهُۥ","حَصَادِهِۦ ۖ وَلَا تُسْرِفُوٓا۟ ۚ",25],["6:158:15",150,"يَوْمَ","(The) Day","بَعْضُ ءَايَـٰتِ رَبِّكَ ۗ","يَأْتِى بَعْضُ ءَايَـٰتِ",25],["7:14:4",152,"يَوْمِ","(the) Day","قَالَ أَنظِرْنِىٓ إِلَىٰ","يُبْعَثُونَ",25],["7:32:20",154,"يَوْمَ","(on the) Day","ٱلْحَيَوٰةِ ٱلدُّنْيَا خَالِصَةًۭ","ٱلْقِيَـٰمَةِ ۗ كَذَٰلِكَ نُفَصِّلُ",25],["7:51:9",156,"فَٱلْيَوْمَ","So today","وَغَرَّتْهُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا ۚ","نَنسَىٰهُمْ كَمَا نَسُوا۟",25],["7:51:14",156,"يَوْمِهِمْ","(of) their day","كَمَا نَسُوا۟ لِقَآءَ","هَـٰذَا وَمَا كَانُوا۟",25],["7:53:5",157,"يَوْمَ","(The) Day","يَنظُرُونَ إِلَّا تَأْوِيلَهُۥ ۚ","يَأْتِى تَأْوِيلُهُۥ يَقُولُ",25],["7:54:10",157,"أَيَّامٍۢ","epochs","وَٱلْأَرْضَ فِى سِتَّةِ","ثُمَّ ٱسْتَوَىٰ عَلَى",25],["7:59:19",158,"يَوْمٍ","(of the) Day","أَخَافُ عَلَيْكُمْ عَذَابَ","عَظِيمٍۢ",25],["7:163:15",171,"يَوْمَ","(on the) day","إِذْ تَأْتِيهِمْ حِيتَانُهُمْ","سَبْتِهِمْ شُرَّعًۭا وَيَوْمَ",25],["7:163:18",171,"وَيَوْمَ","and (on the) day","يَوْمَ سَبْتِهِمْ شُرَّعًۭا","لَا يَسْبِتُونَ ۙ لَا",25],["7:167:7",172,"ي