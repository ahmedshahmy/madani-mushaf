[["8:9:2",178,"تَسْتَغِيثُونَ","you were seeking help","إِذْ","رَبَّكُمْ فَٱسْتَجَابَ لَكُمْ",1700],["18:29:19",297,"يَسْتَغِيثُوا۟","they call for relief","بِهِمْ سُرَادِقُهَا ۚ وَإِن","يُغَاثُوا۟ بِمَآءٍۢ كَٱلْمُهْلِ",1700],["18:29:20",297,"يُغَاثُوا۟","they will be relieved","سُرَادِقُهَا ۚ وَإِن يَسْتَغِيثُوا۟","بِمَآءٍۢ كَٱلْمُهْلِ يَشْوِى",4720],["28:15:18",387,"فَٱسْتَغَـٰثَهُ","And called him for help","وَهَـٰذَا مِنْ عَدُوِّهِۦ ۖ","ٱلَّذِى مِن شِيعَتِهِۦ",1700],["46:17:15",504,"يَسْتَغِيثَانِ","seek help","مِن قَبْلِى وَهُمَا","ٱللَّهَ وَيْلَكَ ءَامِنْ",1700]]