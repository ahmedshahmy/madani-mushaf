e Most Gracious","تُتْلَىٰ عَلَيْهِمْ ءَايَـٰتُ","خَرُّوا۟ سُجَّدًۭا وَبُكِيًّۭا ۩",212],["19:61:5",309,"ٱلرَّحْمَـٰنُ","the Most Gracious","عَدْنٍ ٱلَّتِى وَعَدَ","عِبَادَهُۥ بِٱلْغَيْبِ ۚ إِنَّهُۥ",212],["19:69:9",310,"ٱلرَّحْمَـٰنِ","the Most Gracious","أَيُّهُمْ أَشَدُّ عَلَى","عِتِيًّۭا",212],["19:75:8",310,"ٱلرَّحْمَـٰنُ","the Most Gracious","ٱلضَّلَـٰلَةِ فَلْيَمْدُدْ لَهُ","مَدًّا ۚ حَتَّىٰٓ إِذَا",212],["19:78:6",311,"ٱلرَّحْمَـٰنِ","the Most Gracious","أَمِ ٱتَّخَذَ عِندَ","عَهْدًۭا",212],["19:85:5",311,"ٱلرَّحْمَـٰنِ","the Most Gracious","نَحْشُرُ ٱلْمُتَّقِينَ إِلَى","وَفْدًۭا",212],["19:87:8",311,"ٱلرَّحْمَـٰنِ","the Most Gracious","مَنِ ٱتَّخَذَ عِندَ","عَهْدًۭا",212],["19:88:3",311,"ٱلرَّحْمَـٰنُ","the Most Gracious","وَقَالُوا۟ ٱتَّخَذَ","وَلَدًۭا",212],["19:91:3",311,"لِلرَّحْمَـٰنِ","to the Most Gracious","أَن دَعَوْا۟","وَلَدًۭا",212],["19:92:3",311,"لِلرَّحْمَـٰنِ","for the Most Gracious","وَمَا يَنۢبَغِى","أَن يَتَّخِذَ وَلَدًا",212],["19:93:9",311,"ٱلرَّحْمَـٰنِ","(to) the Most Gracious","وَٱلْأَرْضِ إِلَّآ ءَاتِى","عَبْدًۭا",212],["19:96:8",312,"ٱلرَّحْمَـٰنُ","the Most Gracious","ٱلصَّـٰلِحَـٰتِ سَيَجْعَلُ لَهُمُ","وُدًّۭا",212],["20:5:1",312,"ٱلرَّحْمَـٰنُ","The Most Gracious","","عَلَى ٱلْعَرْشِ ٱسْتَوَىٰ",212],["20:90:13",318,"ٱلرَّحْمَـٰنُ","(is) the Most Gracious","بِهِۦ ۖ وَإِنَّ رَبَّكُمُ","فَٱتَّبِعُونِى وَأَطِيعُوٓا۟ أَمْرِى",212],["20:108:9",319,"لِلرَّحْمَـٰنِ","for the Most Gracious","لَهُۥ ۖ وَخَشَعَتِ ٱلْأَصْوَاتُ","فَلَا تَسْمَعُ إِلَّا",212],["20:109:9",319,"ٱلرَّحْمَـٰنُ","the Most Gracious","مَنْ أَذِنَ لَهُ","وَرَضِىَ لَهُۥ قَوْلًۭا",212],["21:26:3",324,"ٱلرَّحْمَـٰنُ","the Most Gracious","وَقَالُوا۟ ٱتَّخَذَ","وَلَدًۭا ۗ سُبْحَـٰنَهُۥ ۚ بَلْ",212],["21:36:15",325,"ٱلرَّحْمَـٰنِ","(of) the Most Gracious","ءَالِهَتَكُمْ وَهُم بِذِكْرِ","هُمْ كَـٰفِرُونَ",212],["21:42:7",325,"ٱلرَّحْمَـٰنِ ۗ","the Most Gracious","بِٱلَّيْلِ وَٱلنَّهَارِ مِنَ","بَلْ هُمْ عَن",212],["21:75:3",328,"رَحْمَتِنَآ ۖ","Our Mercy","وَأَدْخَلْنَـٰهُ 