[["7:187:26",174,"حَفِىٌّ","(were) well informed","بَغْتَةًۭ ۗ يَسْـَٔلُونَكَ كَأَنَّكَ","عَنْهَا ۖ قُلْ إِنَّمَا",2274],["19:47:10",308,"حَفِيًّۭا","Ever Gracious","إِنَّهُۥ كَانَ بِى","",2274],["47:37:3",510,"فَيُحْفِكُمْ","and press you","إِن يَسْـَٔلْكُمُوهَا","تَبْخَلُوا۟ وَيُخْرِجْ أَضْغَـٰنَكُمْ",4703]]