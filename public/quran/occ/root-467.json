[["2:239:5",39,"رُكْبَانًۭا ۖ","riding","خِفْتُمْ فَرِجَالًا أَوْ","فَإِذَآ أَمِنتُمْ فَٱذْكُرُوا۟",4202],["6:99:18",140,"مُّتَرَاكِبًۭا","thick clustered","نُّخْرِجُ مِنْهُ حَبًّۭا","وَمِنَ ٱلنَّخْلِ مِن",4001],["8:42:8",182,"وَٱلرَّكْبُ","and the caravan","وَهُم بِٱلْعُدْوَةِ ٱلْقُصْوَىٰ","أَسْفَلَ مِنكُمْ ۚ وَلَوْ",4215],["11:41:2",226,"ٱرْكَبُوا۟","Embark","۞ وَقَالَ","فِيهَا بِسْمِ ٱللَّهِ",918],["11:42:14",226,"ٱرْكَب","Embark","فِى مَعْزِلٍۢ يَـٰبُنَىَّ","مَّعَنَا وَلَا تَكُن",918],["16:8:4",268,"لِتَرْكَبُوهَا","for you to ride them","وَٱلْخَيْلَ وَٱلْبِغَالَ وَٱلْحَمِيرَ","وَزِينَةًۭ ۚ وَيَخْلُقُ مَا",918],["18:71:4",301,"رَكِبَا","they had embarked","فَٱنطَلَقَا حَتَّىٰٓ إِذَا","فِى ٱلسَّفِينَةِ خَرَقَهَا ۖ",918],["29:65:2",404,"رَكِبُوا۟","they embark","فَإِذَا","فِى ٱلْفُلْكِ دَعَوُا۟",918],["36:42:6",443,"يَرْكَبُونَ","they ride","مِّن مِّثْلِهِۦ مَا","",918],["36:72:4",445,"رَكُوبُهُمْ","they ride them","وَذَلَّلْنَـٰهَا لَهُمْ فَمِنْهَا","وَمِنْهَا يَأْكُلُونَ",4174],["40:79:6",476,"لِتَرْكَبُوا۟","that you may ride","جَعَلَ لَكُمُ ٱلْأَنْعَـٰمَ","مِنْهَا وَمِنْهَا تَأْكُلُونَ",918],["43:12:11",490,"تَرْكَبُونَ","you ride","ٱلْفُلْكِ وَٱلْأَنْعَـٰمِ مَا","",918],["59:6:13",546,"رِكَابٍۢ","camels","مِنْ خَيْلٍۢ وَلَا","وَلَـٰكِنَّ ٱللَّهَ يُسَلِّطُ",4191],["82:8:6",587,"رَكَّبَكَ","He assembled you","صُورَةٍۢ مَّا شَآءَ","",4175],["84:19:1",589,"لَتَرْكَبُنَّ","You will surely embark","","طَبَقًا عَن طَبَقٍۢ",918]]