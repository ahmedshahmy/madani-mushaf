[["2:60:7",9,"بِّعَصَاكَ","with your staff","لِقَوْمِهِۦ فَقُلْنَا ٱضْرِب","ٱلْحَجَرَ ۖ فَٱنفَجَرَتْ مِنْهُ",819],["7:107:2",164,"عَصَاهُ","his staff","فَأَلْقَىٰ","فَإِذَا هِىَ ثُعْبَانٌۭ",819],["7:117:6",164,"عَصَاكَ ۖ","your staff","مُوسَىٰٓ أَنْ أَلْقِ","فَإِذَا هِىَ تَلْقَفُ",819],["7:160:14",171,"بِّعَصَاكَ","with your staff","قَوْمُهُۥٓ أَنِ ٱضْرِب","ٱلْحَجَرَ ۖ فَٱنۢبَجَسَتْ مِنْهُ",819],["20:18:3",313,"عَصَاىَ","(is) my staff","قَالَ هِىَ","أَتَوَكَّؤُا۟ عَلَيْهَا وَأَهُشُّ",819],["20:66:6",316,"وَعِصِيُّهُمْ","and their staffs","أَلْقُوا۟ ۖ فَإِذَا حِبَالُهُمْ","يُخَيَّلُ إِلَيْهِ مِن",2250],["26:32:2",368,"عَصَاهُ","his staff","فَأَلْقَىٰ","فَإِذَا هِىَ ثُعْبَانٌۭ",819],["26:44:3",369,"وَعِصِيَّهُمْ","and their staffs","فَأَلْقَوْا۟ حِبَالَهُمْ","وَقَالُوا۟ بِعِزَّةِ فِرْعَوْنَ",2250],["26:45:3",369,"عَصَاهُ","his staff","فَأَلْقَىٰ مُوسَىٰ","فَإِذَا هِىَ تَلْقَفُ",819],["26:63:6",370,"بِّعَصَاكَ","with your staff","مُوسَىٰٓ أَنِ ٱضْرِب","ٱلْبَحْرَ ۖ فَٱنفَلَقَ فَكَانَ",819],["27:10:2",377,"عَصَاكَ ۚ","your staff","وَأَلْقِ","فَلَمَّا رَءَاهَا تَهْتَزُّ",819],["28:31:3",389,"عَصَاكَ ۖ","your staff","وَأَنْ أَلْقِ","فَلَمَّا رَءَاهَا تَهْتَزُّ",819]]