[["2:155:5",24,"وَٱلْجُوعِ","and [the] hunger","بِشَىْءٍۢ مِّنَ ٱلْخَوْفِ","وَنَقْصٍۢ مِّنَ ٱلْأَمْوَٰلِ",1564],["16:112:20",280,"ٱلْجُوعِ","(of) the hunger","فَأَذَٰقَهَا ٱللَّهُ لِبَاسَ","وَٱلْخَوْفِ بِمَا كَانُوا۟",1564],["20:118:4",320,"تَجُوعَ","you will be hungry","إِنَّ لَكَ أَلَّا","فِيهَا وَلَا تَعْرَىٰ",4380],["88:7:6",592,"جُوعٍۢ","hunger","وَلَا يُغْنِى مِن","",1564],["106:4:4",602,"جُوعٍۢ","(against) hunger","ٱلَّذِىٓ أَطْعَمَهُم مِّن","وَءَامَنَهُم مِّنْ خَوْفٍۭ",1564]]