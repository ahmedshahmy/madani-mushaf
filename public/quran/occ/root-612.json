[["2:198:10",31,"أَفَضْتُم","you depart","مِّن رَّبِّكُمْ ۚ فَإِذَآ","مِّنْ عَرَفَـٰتٍۢ فَٱذْكُرُوا۟",1036],["2:199:2",31,"أَفِيضُوا۟","depart","ثُمَّ","مِنْ حَيْثُ أَفَاضَ",1036],["2:199:5",31,"أَفَاضَ","depart","أَفِيضُوا۟ مِنْ حَيْثُ","ٱلنَّاسُ وَٱسْتَغْفِرُوا۟ ٱللَّهَ ۚ",1036],["5:83:9",121,"تَفِيضُ","overflowing","ٱلرَّسُولِ تَرَىٰٓ أَعْيُنَهُمْ","مِنَ ٱلدَّمْعِ مِمَّا",2666],["7:50:7",156,"أَفِيضُوا۟","Pour","أَصْحَـٰبَ ٱلْجَنَّةِ أَنْ","عَلَيْنَا مِنَ ٱلْمَآءِ",1036],["9:92:16",201,"تَفِيضُ","flowing","عَلَيْهِ تَوَلَّوا۟ وَّأَعْيُنُهُمْ","مِنَ ٱلدَّمْعِ حَزَنًا",2666],["10:61:19",215,"تُفِيضُونَ","you are engaged","عَلَيْكُمْ شُهُودًا إِذْ","فِيهِ ۚ وَمَا يَعْزُبُ",1036],["24:14:12",351,"أَفَضْتُمْ","you had rushed glibly","لَمَسَّكُمْ فِى مَآ","فِيهِ عَذَابٌ عَظِيمٌ",1036],["46:8:16",503,"تُفِيضُونَ","you utter","هُوَ أَعْلَمُ بِمَا","فِيهِ ۖ كَفَىٰ بِهِۦ",1036]]