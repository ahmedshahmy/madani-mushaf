[["8:37:11",181,"فَيَرْكُمَهُۥ","and heap them","بَعْضَهُۥ عَلَىٰ بَعْضٍۢ","جَمِيعًۭا فَيَجْعَلَهُۥ فِى",4652],["24:43:12",355,"رُكَامًۭا","(into) a mass","بَيْنَهُۥ ثُمَّ يَجْعَلُهُۥ","فَتَرَى ٱلْوَدْقَ يَخْرُجُ",4201],["52:44:9",525,"مَّرْكُومٌۭ","heaped up","سَاقِطًۭا يَقُولُوا۟ سَحَابٌۭ","",3929]]