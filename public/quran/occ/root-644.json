[["6:103:8",141,"ٱللَّطِيفُ","the All-Subtle","يُدْرِكُ ٱلْأَبْصَـٰرَ ۖ وَهُوَ","ٱلْخَبِيرُ",1083],["12:100:40",247,"لَطِيفٌۭ","(is) Most Subtle","إِخْوَتِىٓ ۚ إِنَّ رَبِّى","لِّمَا يَشَآءُ ۚ إِنَّهُۥ",1083],["18:19:34",295,"وَلْيَتَلَطَّفْ","and let him be cautious","فَلْيَأْتِكُم بِرِزْقٍۢ مِّنْهُ","وَلَا يُشْعِرَنَّ بِكُمْ",4680],["22:63:14",339,"لَطِيفٌ","(is) surely Subtle","مُخْضَرَّةً ۗ إِنَّ ٱللَّهَ","خَبِيرٌۭ",1083],["31:16:23",412,"لَطِيفٌ","(is) All-Subtle","ٱللَّهُ ۚ إِنَّ ٱللَّهَ","خَبِيرٌۭ",1083],["33:34:13",422,"لَطِيفًا","All-Subtle","إِنَّ ٱللَّهَ كَانَ","خَبِيرًا",1083],["42:19:2",485,"لَطِيفٌۢ","(is) Subtle","ٱللَّهُ","بِعِبَادِهِۦ يَرْزُقُ مَن",1083],["67:14:6",563,"ٱللَّطِيفُ","(is) the Subtle","مَنْ خَلَقَ وَهُوَ","ٱلْخَبِيرُ",1083]]