[["7:21:3",152,"لَكُمَا","to both of you","وَقَاسَمَهُمَآ إِنِّى","لَمِنَ ٱلنَّـٰصِحِينَ",1129],["7:22:23",152,"لَّكُمَآ","to both of you","تِلْكُمَا ٱلشَّجَرَةِ وَأَقُل","إِنَّ ٱلشَّيْطَـٰنَ لَكُمَا",1129],["7:22:26",152,"لَكُمَا","to both of you","لَّكُمَآ إِنَّ ٱلشَّيْطَـٰنَ","عَدُوٌّۭ مُّبِينٌۭ",1129],["10:78:9",217,"لَكُمَا","and you two (may) have","عَلَيْهِ ءَابَآءَنَا وَتَكُونَ","ٱلْكِبْرِيَآءُ فِى ٱلْأَرْضِ",1129],["10:78:15",217,"لَكُمَا","(in) you two","ٱلْأَرْضِ وَمَا نَحْنُ","بِمُؤْمِنِينَ",1129],["28:35:6",389,"لَكُمَا","for both of you","عَضُدَكَ بِأَخِيكَ وَنَجْعَلُ","سُلْطَـٰنًۭا فَلَا يَصِلُونَ",1129],["46:17:5",504,"لَّكُمَآ","to both of you","قَالَ لِوَٰلِدَيْهِ أُفٍّۢ","أَتَعِدَانِنِىٓ أَنْ أُخْرَجَ",1129]]