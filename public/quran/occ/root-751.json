[["11:77:9",230,"ذَرْعًۭا","(and) uneasy","بِهِمْ وَضَاقَ بِهِمْ","وَقَالَ هَـٰذَا يَوْمٌ",1711],["18:18:12",295,"ذِرَاعَيْهِ","his two forelegs","ٱلشِّمَالِ ۖ وَكَلْبُهُم بَـٰسِطٌۭ","بِٱلْوَصِيدِ ۚ لَوِ ٱطَّلَعْتَ",2131],["29:33:10",400,"ذَرْعًۭا","(and) uneasy","بِهِمْ وَضَاقَ بِهِمْ","وَقَالُوا۟ لَا تَخَفْ",1711],["69:32:4",567,"ذَرْعُهَا","its length","ثُمَّ فِى سِلْسِلَةٍۢ","سَبْعُونَ ذِرَاعًۭا فَٱسْلُكُوهُ",1711],["69:32:6",567,"ذِرَاعًۭا","cubits","سِلْسِلَةٍۢ ذَرْعُهَا سَبْعُونَ","فَٱسْلُكُوهُ",2131]]