[["2:17:13",4,"وَتَرَكَهُمْ","and left them","ذَهَبَ ٱللَّهُ بِنُورِهِمْ","فِى ظُلُمَـٰتٍۢ لَّا",291],["2:180:8",27,"تَرَكَ","he leaves","أَحَدَكُمُ ٱلْمَوْتُ إِن","خَيْرًا ٱلْوَصِيَّةُ لِلْوَٰلِدَيْنِ",291],["2:248:16",40,"تَرَكَ","(was) left","رَّبِّكُمْ وَبَقِيَّةٌۭ مِّمَّا","ءَالُ مُوسَىٰ وَءَالُ",291],["2:264:26",44,"فَتَرَكَهُۥ","then left it","تُرَابٌۭ فَأَصَابَهُۥ وَابِلٌۭ","صَلْدًۭا ۖ لَّا يَقْدِرُونَ",291],["4:7:4",78,"تَرَكَ","(is) left","لِّلرِّجَالِ نَصِيبٌۭ مِّمَّا","ٱلْوَٰلِدَانِ وَٱلْأَقْرَبُونَ وَلِلنِّسَآءِ",291],["4:7:10",78,"تَرَكَ","(is) left","وَلِلنِّسَآءِ نَصِيبٌۭ مِّمَّا","ٱلْوَٰلِدَانِ وَٱلْأَقْرَبُونَ مِمَّا",291],["4:9:4",78,"تَرَكُوا۟","they left","وَلْيَخْشَ ٱلَّذِينَ لَوْ","مِنْ خَلْفِهِمْ ذُرِّيَّةًۭ",291],["4:11:17",78,"تَرَكَ ۖ","he left","فَلَهُنَّ ثُلُثَا مَا","وَإِن كَانَتْ وَٰحِدَةًۭ",291],["4:11:29",78,"تَرَكَ","(is) left","مِّنْهُمَا ٱلسُّدُسُ مِمَّا","إِن كَانَ لَهُۥ",291],["4:12:4",79,"تَرَكَ","(is) left","۞ وَلَكُمْ نِصْفُ مَا","أَزْوَٰجُكُمْ إِن لَّمْ",291],["4:12:18",79,"تَرَكْنَ ۚ","they left","فَلَكُمُ ٱلرُّبُعُ مِمَّا","مِنۢ بَعْدِ وَصِيَّةٍۢ",291],["4:12:29",79,"تَرَكْتُمْ","you left","وَلَهُنَّ ٱلرُّبُعُ مِمَّا","إِن لَّمْ يَكُن",291],["4:12:42",79,"تَرَكْتُم ۚ","you left","فَلَهُنَّ ٱلثُّمُنُ مِمَّا","مِّنۢ بَعْدِ وَصِيَّةٍۢ",291],["4:33:5",83,"تَرَكَ","(is) left","جَعَلْنَا مَوَٰلِىَ مِمَّا","ٱلْوَٰلِدَانِ وَٱلْأَقْرَبُونَ ۚ وَٱلَّذِينَ",291],["4:176:18",106,"تَرَكَ ۚ","he left","فَلَهَا نِصْفُ مَا","وَهُوَ يَرِثُهَآ إِن",291],["4:176:32",106,"تَرَكَ ۚ","he left","فَلَهُمَا ٱلثُّلُثَانِ مِمَّا","وَإِن كَانُوٓا۟ إِخْوَةًۭ",291],["6:94:8",139,"وَتَرَكْتُم","and you have left","خَلَقْنَـٰكُمْ أَوَّلَ مَرَّةٍۢ","مَّا خَوَّلْنَـٰكُمْ وَرَآءَ",291],["7:176:19",173,"تَتْرُكْهُ","if you leave him","عَلَيْهِ يَلْهَثْ أَوْ","يَلْهَث ۚ ذَّٰلِكَ مَثَلُ",291],["9:16:4",189,"تُتْرَكُوا۟","you would be left","أَمْ حَسِبْتُمْ أَن","وَلَمَّا يَعْلَمِ ٱللَّهُ",291],["11:12:2",222,"تَارِكٌۢ","(may) give up","فَلَعَلَّكَ","بَعْضَ مَا يُوحَىٰٓ",2005],["11:53:8",227,"بِتَارِكِىٓ","(will) leave","بِبَيِّنَةٍۢ وَمَا نَحْنُ","ءَالِهَتِنَا عَن قَوْلِكَ",2005],["11:87:6",231,"نَّتْرُكَ","we leave","أَصَلَوٰتُكَ تَأْمُرُكَ أَن","مَا يَعْبُدُ ءَابَآؤُنَآ",291],["12:17:6",237,"وَتَرَكْنَا","and we left","إِنَّا ذَهَبْنَا نَسْتَبِقُ","يُوسُفَ عِندَ مَتَـٰعِنَا",291],["12:37:17",239,"تَرَكْتُ","[I] abandon","عَلَّمَنِى رَبِّىٓ ۚ إِنِّى","مِلَّةَ قَوْمٍۢ لَّا",291],["16:61:7",273,"تَرَكَ","He (would) have left","ٱلنَّاسَ بِظُلْمِهِم مَّا","عَلَيْهَا مِن دَآبَّةٍۢ",291],["18:99:1",304,"۞ وَتَرَكْنَا","And We (will) leave","","بَعْضَهُمْ يَوْمَئِذٍۢ يَمُوجُ",291],["23:100:5",348,"تَرَكْتُ ۚ","I left behind","أَعْمَلُ صَـٰلِحًۭا فِيمَا","كَلَّآ ۚ إِنَّهَا كَلِمَةٌ",291],["26:146:1",373,"أَتُتْرَكُونَ","Will you be left","","فِى مَا هَـٰهُنَآ",291],["29:2:4",396,"يُتْرَكُوٓا۟","they will be left","أَحَسِبَ ٱلنَّاسُ أَن","أَن يَقُولُوٓا۟ ءَامَنَّا",291],["29:35:2",400,"تَّرَكْنَا","We have left","وَلَقَد","مِنْهَآ ءَايَةًۢ بَيِّنَةًۭ",291],["35:45:8",440,"تَرَكَ","He would leave","بِمَا كَسَبُوا۟ مَا","عَلَىٰ ظَهْرِهَا مِن",291],["37:36:3",447,"لَتَارِكُوٓا۟","to leave","وَيَقُولُونَ أَئِنَّا","ءَالِهَتِنَا لِشَاعِرٍۢ مَّجْنُونٍۭ",2005],["37:78:1",449,"وَتَرَكْنَا","And We left","","عَلَيْهِ فِى ٱلْـَٔاخِرِينَ",291],["37:108:1",450,"وَتَرَكْنَا","And We left","","عَلَيْهِ فِى ٱلْـَٔاخِرِينَ",291],["37:119:1",450,"وَتَرَكْنَا","And We left","","عَلَيْهِمَا فِى ٱلْـَٔاخِرِينَ",291],["37:129:1",451,"وَتَرَكْنَا","And We left","","عَلَيْهِ فِى ٱلْـَٔاخِرِينَ",291],["44:24:1",497,"وَٱتْرُكِ","And leave","","ٱلْبَحْرَ رَهْوًا ۖ إِنَّهُمْ",291],["44:25:2",497,"تَرَكُوا۟","(did) they leave","كَمْ","مِن جَنَّـٰتٍۢ وَعُيُونٍۢ",291],["51:37:1",522,"وَتَرَكْنَا","And We left","","فِيهَآ ءَايَةًۭ لِّلَّذِينَ",291],["54:15:2",529,"تَّرَكْنَـٰهَآ","We left it","وَلَقَد","ءَايَةًۭ فَهَلْ مِن",291],["59:5:6",546,"تَرَكْتُمُوهَا","you left them","مِّن لِّينَةٍ أَوْ","قَآئِمَةً عَلَىٰٓ أُصُولِهَا",291],["62:11:8",554,"وَتَرَكُوكَ","and left you","لَهْوًا ٱنفَضُّوٓا۟ إِلَيْهَا","قَآئِمًۭا ۚ قُلْ مَا",291],["75:36:4",578,"يُتْرَكَ","he will be left","أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن","سُدًى",291]]