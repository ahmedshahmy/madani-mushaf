[["2:56:2",8,"بَعَثْنَـٰكُم","We revived you","ثُمَّ","مِّنۢ بَعْدِ مَوْتِكُمْ",227],["2:129:2",20,"وَٱبْعَثْ","[And] raise up","رَبَّنَا","فِيهِمْ رَسُولًۭا مِّنْهُمْ",227],["2:213:5",33,"فَبَعَثَ","then raised up","ٱلنَّاسُ أُمَّةًۭ وَٰحِدَةًۭ","ٱللَّهُ ٱلنَّبِيِّـۧنَ مُبَشِّرِينَ",227],["2:246:15",40,"ٱبْعَثْ","Appoint","قَالُوا۟ لِنَبِىٍّۢ لَّهُمُ","لَنَا مَلِكًۭا نُّقَـٰتِلْ",227],["2:247:7",40,"بَعَثَ","raised","إِنَّ ٱللَّهَ قَدْ","لَكُمْ طَالُوتَ مَلِكًۭا ۚ",227],["2:259:22",43,"بَعَثَهُۥ ۖ","He raised him","مِا۟ئَةَ عَامٍۢ ثُمَّ","قَالَ كَمْ لَبِثْتَ ۖ",227],["3:164:7",71,"بَعَثَ","He raised","عَلَى ٱلْمُؤْمِنِينَ إِذْ","فِيهِمْ رَسُولًۭا مِّنْ",227],["4:35:5",84,"فَٱبْعَثُوا۟","then send","خِفْتُمْ شِقَاقَ بَيْنِهِمَا","حَكَمًۭا مِّنْ أَهْلِهِۦ",227],["5:12:7",109,"وَبَعَثْنَا","and We appointed","مِيثَـٰقَ بَنِىٓ إِسْرَٰٓءِيلَ","مِنْهُمُ ٱثْنَىْ عَشَرَ",227],["5:31:1",112,"فَبَعَثَ","Then (was) sent","","ٱللَّهُ غُرَابًۭا يَبْحَثُ",227],["6:29:9",131,"بِمَبْعُوثِينَ","(will be) resurrected","ٱلدُّنْيَا وَمَا نَحْنُ","",913],["6:36:6",132,"يَبْعَثُهُمُ","will resurrect them","ٱلَّذِينَ يَسْمَعُونَ ۘ وَٱلْمَوْتَىٰ","ٱللَّهُ ثُمَّ إِلَيْهِ",227],["6:60:10",135,"يَبْعَثُكُمْ","He raises you up","جَرَحْتُم بِٱلنَّهَارِ ثُمَّ","فِيهِ لِيُقْضَىٰٓ أَجَلٌۭ",227],["6:65:6",135,"يَبْعَثَ","send","ٱلْقَادِرُ عَلَىٰٓ أَن","عَلَيْكُمْ عَذَابًۭا مِّن",227],["7:14:5",152,"يُبْعَثُونَ","they are raised up","أَنظِرْنِىٓ إِلَىٰ يَوْمِ","",227],["7:103:2",163,"بَعَثْنَا","We sent","ثُمَّ","مِنۢ بَعْدِهِم مُّوسَىٰ",227],["7:167:4",172,"لَيَبْعَثَنَّ","that He would surely send","وَإِذْ تَأَذَّنَ رَبُّكَ","عَلَيْهِمْ إِلَىٰ يَوْمِ",227],["9:46:10",194,"ٱنۢبِعَاثَهُمْ","their being sent","وَلَـٰكِن كَرِهَ ٱللَّهُ","فَثَبَّطَهُمْ وَقِيلَ ٱقْعُدُوا۟",4814],["10:74:2",217,"بَعَثْنَا","We sent","ثُمَّ","مِنۢ بَعْدِهِۦ رُسُلًا",227],["10:75:2",217,"بَعَثْنَا","We sent","ثُمَّ","مِنۢ بَعْدِهِم مُّوسَىٰ",227],["11:7:20",222,"مَّبْعُوثُونَ","(will be) resurrected","وَلَئِن قُلْتَ إِنَّكُم","مِنۢ بَعْدِ ٱلْمَوْتِ",913],["15:36:6",264,"يُبْعَثُونَ","they are raised","فَأَنظِرْنِىٓ إِلَىٰ يَوْمِ","",227],["16:21:7",269,"يُبْعَثُونَ","they will be resurrected","وَمَا يَشْعُرُونَ أَيَّانَ","",227],["16:36:2",271,"بَعَثْنَا","We sent","وَلَقَدْ","فِى كُلِّ أُمَّةٍۢ",227],["16:38:6",271,"يَبْعَثُ","Allah will not resurrect","جَهْدَ أَيْمَـٰنِهِمْ ۙ لَا","ٱللَّهُ مَن يَمُوتُ ۚ",227],["16:84:2",276,"نَبْعَثُ","We will resurrect","وَيَوْمَ","مِن كُلِّ أُمَّةٍۢ",227],["16:89:2",277,"نَبْعَثُ","We will resurrect","وَيَوْمَ","فِى كُلِّ أُمَّةٍۢ",227],["17:5:5",282,"بَعَثْنَا","We raised","جَآءَ وَعْدُ أُولَىٰهُمَا","عَلَيْكُمْ عِبَادًۭا لَّنَآ",227],["17:15:20",283,"نَبْعَثَ","We have sent","كُنَّا مُعَذِّبِينَ حَتَّىٰ","رَسُولًۭا",227],["17:49:7",286,"لَمَبْعُوثُونَ","surely (be) resurrected","عِظَـٰمًۭا وَرُفَـٰتًا أَءِنَّا","خَلْقًۭا جَدِيدًۭا",913],["17:79:9",290,"يَبْعَثَكَ","will raise you","لَّكَ عَسَىٰٓ أَن","رَبُّكَ مَقَامًۭا مَّحْمُودًۭا",227],["17:94:12",291,"أَبَعَثَ","Has Allah sent","إِلَّآ أَن قَالُوٓا۟","ٱللَّهُ بَشَرًۭا رَّسُولًۭا",227],["17:98:12",292,"لَمَبْعُوثُونَ","surely (be) resurrected","عِظَـٰمًۭا وَرُفَـٰتًا أَءِنَّا","خَلْقًۭا جَدِيدًا",913],["18:12:2",294,"بَعَثْنَـٰهُمْ","We raised them up","ثُمَّ","لِنَعْلَمَ أَىُّ ٱلْحِزْبَيْنِ",227],["18:19:2",295,"بَعَثْنَـٰهُمْ","We raised them","وَكَذَٰلِكَ","لِيَتَسَآءَلُوا۟ بَيْنَهُمْ ۚ قَالَ",227],["18:19:21",295,"فَٱبْعَثُوٓا۟","So send","أَعْلَمُ بِمَا لَبِثْتُمْ","أَحَدَكُم بِوَرِقِكُمْ هَـٰذِهِۦٓ",227],["19:15:8",306,"يُبْعَثُ","he will be raised","وَيَوْمَ يَمُوتُ وَيَوْمَ","حَيًّۭا",227],["19:33:8",307,"أُبْعَثُ","I will be raised","وَيَوْمَ أَمُوتُ وَيَوْمَ","حَيًّۭا",227],["22:5:8",332,"ٱلْبَعْثِ","the Resurrection","فِى رَيْبٍۢ مِّنَ","فَإِنَّا خَلَقْنَـٰكُم مِّن",1535],["22:7:9",333,"يَبْعَثُ","will resurrect","فِيهَا وَأَنَّ ٱللَّهَ","مَن فِى ٱلْقُبُورِ",227],["23:16:5",342,"تُبْعَثُونَ","will be resurrected","إِنَّكُمْ يَوْمَ ٱلْقِيَـٰمَةِ","",227],["23:37:10",344,"بِمَبْعُوثِينَ","(will be) resurrected","وَنَحْيَا وَمَا نَحْنُ","",913],["23:82:8",347,"لَمَبْعُوثُونَ","surely be resurrected","تُرَابًۭا وَعِظَـٰمًا أَءِنَّا","",913],["23:100:16",348,"يُبْعَثُونَ","they are resurrected","بَرْزَخٌ إِلَىٰ يَوْمِ","",227],["25:41:9",363,"بَعَثَ","Allah has sent","هُزُوًا أَهَـٰذَا ٱلَّذِى","ٱللَّهُ رَسُولًا",227],["25:51:3",364,"لَبَعَثْنَا","surely, We (would) have raised","وَلَوْ شِئْنَا","فِى كُلِّ قَرْيَةٍۢ",227],["26:36:4",368,"وَٱبْعَثْ","and send","قَالُوٓا۟ أَرْجِهْ وَأَخَاهُ","فِى ٱلْمَدَآئِنِ حَـٰشِرِينَ",227],["26:87:4",371,"يُبْعَثُونَ","they are resurrected","وَلَا تُخْزِنِى يَوْمَ","",227],["27:65:14",383,"يُبْعَثُونَ","they will be resurrected","وَمَا يَشْعُرُونَ أَيَّانَ","",227],["28:59:7",392,"يَبْعَثَ","He (had) sent","مُهْلِكَ ٱلْقُرَىٰ حَتَّىٰ","فِىٓ أُمِّهَا رَسُولًۭا",227],["30:56:13",410,"ٱلْبَعْثِ ۖ","(of) Resurrection","ٱللَّهِ إِلَىٰ يَوْمِ","فَهَـٰذَا يَوْمُ ٱلْبَعْثِ",1535],["30:56:16",410,"ٱلْبَعْثِ","(of) the Resurrection","ٱلْبَعْثِ ۖ فَهَـٰذَا يَوْمُ","وَلَـٰكِنَّكُمْ كُنتُمْ لَا",1535],["31:28:4",413,"بَعْثُكُمْ","your resurrection","مَّا خَلْقُكُمْ وَلَا","إِلَّا كَنَفْسٍۢ وَٰحِدَةٍ ۗ",1535],["36:52:4",443,"بَعَثَنَا","has raised us","قَالُوا۟ يَـٰوَيْلَنَا مَنۢ","مِن مَّرْقَدِنَا ۜ ۗ هَـٰذَا",227],["37:16:7",446,"لَمَبْعُوثُونَ","be certainly resurrected","تُرَابًۭا وَعِظَـٰمًا أَءِنَّا","",913],["37:144:6",451,"يُبْعَثُونَ","they are resurrected","بَطْنِهِۦٓ إِلَىٰ يَوْمِ","",227],["38:79:6",457,"يُبْعَثُونَ","they are resurrected","فَأَنظِرْنِىٓ إِلَىٰ يَوْمِ","",227],["40:34:19",471,"يَبْعَثَ","will Allah raise","هَلَكَ قُلْتُمْ لَن","ٱللَّهُ مِنۢ بَعْدِهِۦ",227],["56:47:9",535,"لَمَبْعُوثُونَ","surely be resurrected","تُرَابًۭا وَعِظَـٰمًا أَءِنَّا","",913],["58:6:2",542,"يَبْعَثُهُمُ","(when) Allah will raise them","يَوْمَ","ٱللَّهُ جَمِيعًۭا فَيُنَبِّئُهُم",227],["58:18:2",544,"يَبْعَثُهُمُ","Allah will raise them","يَوْمَ","ٱللَّهُ جَمِيعًۭا فَيَحْلِفُونَ",227],["62:2:3",553,"بَعَثَ","sent","هُوَ ٱلَّذِى","فِى ٱلْأُمِّيِّـۧنَ رَسُولًۭا",227],["64:7:6",556,"يُبْعَثُوا۟ ۚ","will they be raised","كَفَرُوٓا۟ أَن لَّن","قُلْ بَلَىٰ وَرَبِّى",227],["64:7:10",556,"لَتُبْعَثُنَّ","surely you will be raised","قُلْ بَلَىٰ وَرَبِّى","ثُمَّ لَتُنَبَّؤُنَّ بِمَا",227],["72:7:7",572,"يَبْعَثَ","will raise","ظَنَنتُمْ أَن لَّن","ٱللَّهُ أَحَدًۭا",227],["83:4:5",587,"مَّبْعُوثُونَ","(will be) resurrected","يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم","",913],["91:12:2",595,"ٱنۢبَعَثَ","(was) sent forth","إِذِ","أَشْقَىٰهَا",4812]]