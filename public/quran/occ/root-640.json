[["6:31:16",131,"فَرَّطْنَا","we neglected","يَـٰحَسْرَتَنَا عَلَىٰ مَا","فِيهَا وَهُمْ يَحْمِلُونَ",1332],["6:38:14",132,"فَرَّطْنَا","We have neglected","أُمَمٌ أَمْثَالُكُم ۚ مَّا","فِى ٱلْكِتَـٰبِ مِن",1332],["6:61:17",135,"يُفَرِّطُونَ","fail","رُسُلُنَا وَهُمْ لَا","",1332],["12:80:21",245,"فَرَّطتُمْ","you failed","وَمِن قَبْلُ مَا","فِى يُوسُفَ ۖ فَلَنْ",1332],["16:62:17",273,"مُّفْرَطُونَ","(will) be abandoned","لَهُمُ ٱلنَّارَ وَأَنَّهُم","",3965],["18:28:30",297,"فُرُطًۭا","(in) excess","هَوَىٰهُ وَكَانَ أَمْرُهُۥ","",3444],["20:45:6",314,"يَفْرُطَ","he will hasten","إِنَّنَا نَخَافُ أَن","عَلَيْنَآ أَوْ أَن",4629],["39:56:7",464,"فَرَّطتُ","I neglected","يَـٰحَسْرَتَىٰ عَلَىٰ مَا","فِى جَنۢبِ ٱللَّهِ",1332]]