[["2:12:5",3,"وَلَـٰكِن","[and] but","إِنَّهُمْ هُمُ ٱلْمُفْسِدُونَ","لَّا يَشْعُرُونَ",162],["2:13:17",3,"وَلَـٰكِن","[and] but","إِنَّهُمْ هُمُ ٱلسُّفَهَآءُ","لَّا يَعْلَمُونَ",162],["2:57:15",8,"وَلَـٰكِن","but","رَزَقْنَـٰكُمْ ۖ وَمَا ظَلَمُونَا","كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ",162],["2:154:11",24,"وَلَـٰكِن","[and] but","أَمْوَٰتٌۢ ۚ بَلْ أَحْيَآءٌۭ","لَّا تَشْعُرُونَ",162],["2:225:7",36,"وَلَـٰكِن","[and] but","بِٱللَّغْوِ فِىٓ أَيْمَـٰنِكُمْ","يُؤَاخِذُكُم بِمَا كَسَبَتْ",162],["2:235:18",38,"وَلَـٰكِن","[and] but","ٱللَّهُ أَنَّكُمْ سَتَذْكُرُونَهُنَّ","لَّا تُوَاعِدُوهُنَّ سِرًّا",162],["2:253:35",42,"وَلَـٰكِنِ","[And] but","مَا جَآءَتْهُمُ ٱلْبَيِّنَـٰتُ","ٱخْتَلَفُوا۟ فَمِنْهُم مَّنْ",162],["2:260:14",44,"وَلَـٰكِن","[and] but","تُؤْمِن ۖ قَالَ بَلَىٰ","لِّيَطْمَئِنَّ قَلْبِى ۖ قَالَ",162],["3:67:7",58,"وَلَـٰكِن","[and] but","يَهُودِيًّۭا وَلَا نَصْرَانِيًّۭا","كَانَ حَنِيفًۭا مُّسْلِمًۭا",162],["3:79:19",60,"وَلَـٰكِن","but (would say)","مِن دُونِ ٱللَّهِ","كُونُوا۟ رَبَّـٰنِيِّـۧنَ بِمَا",162],["3:117:21",65,"وَلَـٰكِنْ","[and] but","وَمَا ظَلَمَهُمُ ٱللَّهُ","أَنفُسَهُمْ يَظْلِمُونَ",162],["3:198:1",76,"لَـٰكِنِ","But","","ٱلَّذِينَ ٱتَّقَوْا۟ رَبَّهُمْ",162],["4:46:31",86,"وَلَـٰكِن","[And] but","خَيْرًۭا لَّهُمْ وَأَقْوَمَ","لَّعَنَهُمُ ٱللَّهُ بِكُفْرِهِمْ",162],["4:157:14",103,"وَلَـٰكِن","but","قَتَلُوهُ وَمَا صَلَبُوهُ","شُبِّهَ لَهُمْ ۚ وَإِنَّ",162],["4:162:1",103,"لَّـٰكِنِ","But","","ٱلرَّٰسِخُونَ فِى ٱلْعِلْمِ",162],["4:166:1",104,"لَّـٰكِنِ","But","","ٱللَّهُ يَشْهَدُ بِمَآ",162],["5:6:54",108,"وَلَـٰكِن","but","عَلَيْكُم مِّنْ حَرَجٍۢ","يُرِيدُ لِيُطَهِّرَكُمْ وَلِيُتِمَّ",162],["5:48:36",116,"وَلَـٰكِن","[and] but","لَجَعَلَكُمْ أُمَّةًۭ وَٰحِدَةًۭ","لِّيَبْلُوَكُمْ فِى مَآ",162],["5:89:7",122,"وَلَـٰكِن","but","بِٱللَّغْوِ فِىٓ أَيْمَـٰنِكُمْ","يُؤَاخِذُكُم بِمَا عَقَّدتُّمُ",162],["6:43:6",132,"وَلَـٰكِن","But","جَآءَهُم بَأْسُنَا تَضَرَّعُوا۟","قَسَتْ قُلُوبُهُمْ وَزَيَّنَ",162],["6:69:9",136,"وَلَـٰكِن","but","حِسَابِهِم مِّن شَىْءٍۢ","ذِكْرَىٰ لَعَلَّهُمْ يَتَّقُونَ",162],["7:38:38",155,"وَلَـٰكِن","[and] but","قَالَ لِكُلٍّۢ ضِعْفٌۭ","لَّا تَعْلَمُونَ",162],["7:61:6",158,"وَلَـٰكِنِّى","but I am","لَيْسَ بِى ضَلَـٰلَةٌۭ","رَسُولٌۭ مِّن رَّبِّ",162],["7:67:6",158,"وَلَـٰكِنِّى","but I am","لَيْسَ بِى سَفَاهَةٌۭ","رَسُولٌۭ مِّن رَّبِّ",162],["7:79:11",160,"وَلَـٰكِن","but","رَبِّى وَنَصَحْتُ لَكُمْ","لَّا تُحِبُّونَ ٱلنَّـٰصِحِينَ",162],["7:96:13",163,"وَلَـٰكِن","but","مِّنَ ٱلسَّمَآءِ وَٱلْأَرْضِ","كَذَّبُوا۟ فَأَخَذْنَـٰهُم بِمَا",162],["7:143:15",167,"وَلَـٰكِنِ","but","قَالَ لَن تَرَىٰنِى","ٱنظُرْ إِلَى ٱلْجَبَلِ",162],["7:160:40",171,"وَلَـٰكِن","but","رَزَقْنَـٰكُمْ ۚ وَمَا ظَلَمُونَا","كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ",162],["8:42:16",182,"وَلَـٰكِن","But","لَٱخْتَلَفْتُمْ فِى ٱلْمِيعَـٰدِ ۙ","لِّيَقْضِىَ ٱللَّهُ أَمْرًۭا",162],["9:42:8",194,"وَلَـٰكِنۢ","but","وَسَفَرًۭا قَاصِدًۭا لَّٱتَّبَعُوكَ","بَعُدَتْ عَلَيْهِمُ ٱلشُّقَّةُ ۚ",162],["9:46:7",194,"وَلَـٰكِن","But","لَأَعَدُّوا۟ لَهُۥ عُدَّةًۭ","كَرِهَ ٱللَّهُ ٱنۢبِعَاثَهُمْ",162],["9:70:23",198,"وَلَـٰكِن","but","كَانَ ٱللَّهُ لِيَظْلِمَهُمْ","كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ",162],["9:88:1",201,"لَـٰكِنِ","But","","ٱلرَّسُولُ وَٱلَّذِينَ ءَامَنُوا۟",162],["10:37:10",213,"وَلَـٰكِن","but","مِن دُونِ ٱللَّهِ","تَصْدِيقَ ٱلَّذِى بَيْنَ",162],["10:104:17",220,"وَلَـٰكِنْ","but","مِن دُونِ ٱللَّهِ","أَعْبُدُ ٱللَّهَ ٱلَّذِى",162],["11:29:19",225,"وَلَـٰكِنِّىٓ","but I","إِنَّهُم مُّلَـٰقُوا۟ رَبِّهِمْ","أَرَىٰكُمْ قَوْمًۭا تَجْهَلُونَ",162],["11:101:3",233,"وَلَـٰكِن","but","وَمَا ظَلَمْنَـٰهُمْ","ظَلَمُوٓا۟ أَنفُسَهُمْ ۖ فَمَآ",162],["12:111:12",248,"وَلَـٰكِن","but","كَانَ حَدِيثًۭا يُفْتَرَىٰ","تَصْدِيقَ ٱلَّذِى بَيْنَ",162],["16:33:19",270,"وَلَـٰكِن","but","وَمَا ظَلَمَهُمُ ٱللَّهُ","كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ",162],["16:61:11",273,"وَلَـٰكِن","but","عَلَيْهَا مِن دَآبَّةٍۢ","يُؤَخِّرُهُمْ إِلَىٰٓ أَجَلٍۢ",162],["16:93:7",277,"وَلَـٰكِن","but","لَجَعَلَكُمْ أُمَّةًۭ وَٰحِدَةًۭ","يُضِلُّ مَن يَشَآءُ",162],["16:106:13",279,"وَلَـٰكِن","But","وَقَلْبُهُۥ مُطْمَئِنٌّۢ بِٱلْإِيمَـٰنِ","مَّن شَرَحَ بِٱلْكُفْرِ",162],["16:118:12",280,"وَلَـٰكِن","but","قَبْلُ ۖ وَمَا ظَلَمْنَـٰهُمْ","كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ",162],["17:44:14",286,"وَلَـٰكِن","but","إِلَّا يُسَبِّحُ بِحَمْدِهِۦ","لَّا تَفْقَهُونَ تَسْبِيحَهُمْ ۗ",162],["18:38:1",298,"لَّـٰكِنَّا۠","But as for me","","هُوَ ٱللَّهُ رَبِّى",162],["19:38:6",307,"لَـٰكِنِ","but","وَأَبْصِرْ يَوْمَ يَأْتُونَنَا ۖ","ٱلظَّـٰلِمُونَ ٱلْيَوْمَ فِى",162],["20:87:6",317,"وَلَـٰكِنَّا","but we","أَخْلَفْنَا مَوْعِدَكَ بِمَلْكِنَا","حُمِّلْنَآ أَوْزَارًۭا مِّن",162],["22:37:7",336,"وَلَـٰكِن","but","لُحُومُهَا وَلَا دِمَآؤُهَا","يَنَالُهُ ٱلتَّقْوَىٰ مِنكُمْ ۚ",162],["22:46:18",337,"وَلَـٰكِن","but","لَا تَعْمَى ٱلْأَبْصَـٰرُ","تَعْمَى ٱلْقُلُوبُ ٱلَّتِى",162],["25:18:13",361,"وَلَـٰكِن","But","دُونِكَ مِنْ أَوْلِيَآءَ","مَّتَّعْتَهُمْ وَءَابَآءَهُمْ حَتَّىٰ",162],["28:45:1",391,"وَلَـٰكِنَّآ","But We","","أَنشَأْنَا قُرُونًۭا فَتَطَاوَلَ",162],["28:45:16",391,"وَلَـٰكِنَّا","but We","تَتْلُوا۟ عَلَيْهِمْ ءَايَـٰتِنَا","كُنَّا مُرْسِلِينَ",162],["28:46:7",391,"وَلَـٰكِن","But","ٱلطُّورِ إِذْ نَادَيْنَا","رَّحْمَةًۭ مِّن رَّبِّكَ",162],["29:40:25",401,"وَلَـٰكِن","but","كَانَ ٱللَّهُ لِيَظْلِمَهُمْ","كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ",162],["30:9:29",405,"وَلَـٰكِن","but","كَانَ ٱللَّهُ لِيَظْلِمَهُمْ","كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ",162],["32:13:7",416,"وَلَـٰكِنْ","but","كُلَّ نَفْسٍ هُدَىٰهَا","حَقَّ ٱلْقَوْلُ مِنِّى",162],["33:5:21",418,"وَلَـٰكِن","but","فِيمَآ أَخْطَأْتُم بِهِۦ","مَّا تَعَمَّدَتْ قُلُوبُكُمْ ۚ",162],["33:40:8",423,"وَلَـٰكِن","but","أَحَدٍۢ مِّن رِّجَالِكُمْ","رَّسُولَ ٱللَّهِ وَخَاتَمَ",162],["33:53:17",425,"وَلَـٰكِنْ","But","غَيْرَ نَـٰظِرِينَ إِنَىٰهُ","إِذَا دُعِيتُمْ فَٱدْخُلُوا۟",162],["35:45:13",440,"وَلَـٰكِن","But","ظَهْرِهَا مِن دَآبَّةٍۢ","يُؤَخِّرُهُمْ إِلَىٰٓ أَجَلٍۢ",162],["39:20:1",460,"لَـٰكِنِ","But","","ٱلَّذِينَ ٱتَّقَوْا۟ رَبَّهُمْ",162],["39:71:29",466,"وَلَـٰكِنْ","But","هَـٰذَا ۚ قَالُوا۟ بَلَىٰ","حَقَّتْ كَلِمَةُ ٱلْعَذَابِ",162],["41:22:12",479,"وَلَـٰكِن","but","أَبْصَـٰرُكُمْ وَلَا جُلُودُكُمْ","ظَنَنتُمْ أَنَّ ٱللَّهَ",162],["42:8:7",483,"وَلَـٰكِن","but","لَجَعَلَهُمْ أُمَّةًۭ وَٰحِدَةًۭ","يُدْخِلُ مَن يَشَآءُ",162],["42:27:9",486,"وَلَـٰكِن","but","لَبَغَوْا۟ فِى ٱلْأَرْضِ","يُنَزِّلُ بِقَدَرٍۢ مَّا",162],["42:52:14",489,"وَلَـٰكِن","But","ٱلْكِتَـٰبُ وَلَا ٱلْإِيمَـٰنُ","جَعَلْنَـٰهُ نُورًۭا نَّهْدِى",162],["43:76:3",495,"وَلَـٰكِن","but","وَمَا ظَلَمْنَـٰهُمْ","كَانُوا۟ هُمُ ٱلظَّـٰلِمِينَ",162],["46:23:10",505,"وَلَـٰكِنِّىٓ","but","مَّآ أُرْسِلْتُ بِهِۦ","أَرَىٰكُمْ قَوْمًۭا تَجْهَلُونَ",162],["47:4:27",507,"وَلَـٰكِن","but","ٱللَّهُ لَٱنتَصَرَ مِنْهُمْ","لِّيَبْلُوَا۟ بَعْضَكُم بِبَعْضٍۢ ۗ",162],["49:14:7",517,"وَلَـٰكِن","but","قُل لَّمْ تُؤْمِنُوا۟","قُولُوٓا۟ أَسْلَمْنَا وَلَمَّا",162],["50:27:6",519,"وَلَـٰكِن","but","رَبَّنَا مَآ أَطْغَيْتُهُۥ","كَانَ فِى ضَلَـٰلٍۭ",162],["56:85:5",537,"وَلَـٰكِن","but","أَقْرَبُ إِلَيْهِ مِنكُمْ","لَّا تُبْصِرُونَ",162],["75:32:1",578,"وَلَـٰكِن","But","","كَذَّبَ وَتَوَلَّىٰ",162]]