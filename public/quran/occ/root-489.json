[["11:67:4",229,"ٱلصَّيْحَةُ","the thunderous blast","وَأَخَذَ ٱلَّذِينَ ظَلَمُوا۟","فَأَصْبَحُوا۟ فِى دِيَـٰرِهِمْ",683],["11:94:14",232,"ٱلصَّيْحَةُ","the thunderous blast","وَأَخَذَتِ ٱلَّذِينَ ظَلَمُوا۟","فَأَصْبَحُوا۟ فِى دِيَـٰرِهِمْ",683],["15:73:2",266,"ٱلصَّيْحَةُ","the awful cry","فَأَخَذَتْهُمُ","مُشْرِقِينَ",683],["15:83:2",266,"ٱلصَّيْحَةُ","the awful cry","فَأَخَذَتْهُمُ","مُصْبِحِينَ",683],["23:41:2",344,"ٱلصَّيْحَةُ","the awful cry","فَأَخَذَتْهُمُ","بِٱلْحَقِّ فَجَعَلْنَـٰهُمْ غُثَآءًۭ ۚ",683],["29:40:12",401,"ٱلصَّيْحَةُ","the awful cry","وَمِنْهُم مَّنْ أَخَذَتْهُ","وَمِنْهُم مَّنْ خَسَفْنَا",683],["36:29:4",442,"صَيْحَةًۭ","a shout","إِن كَانَتْ إِلَّا","وَٰحِدَةًۭ فَإِذَا هُمْ",683],["36:49:4",443,"صَيْحَةًۭ","a shout","مَا يَنظُرُونَ إِلَّا","وَٰحِدَةًۭ تَأْخُذُهُمْ وَهُمْ",683],["36:53:4",443,"صَيْحَةًۭ","a shout","إِن كَانَتْ إِلَّا","وَٰحِدَةًۭ فَإِذَا هُمْ",683],["38:15:5",453,"صَيْحَةًۭ","a shout","يَنظُرُ هَـٰٓؤُلَآءِ إِلَّا","وَٰحِدَةًۭ مَّا لَهَا",683],["50:42:3",520,"ٱلصَّيْحَةَ","the Blast","يَوْمَ يَسْمَعُونَ","بِٱلْحَقِّ ۚ ذَٰلِكَ يَوْمُ",683],["54:31:4",530,"صَيْحَةًۭ","thunderous blast","إِنَّآ أَرْسَلْنَا عَلَيْهِمْ","وَٰحِدَةًۭ فَكَانُوا۟ كَهَشِيمِ",683],["63:4:14",554,"صَيْحَةٍ","shout","مُّسَنَّدَةٌۭ ۖ يَحْسَبُونَ كُلَّ","عَلَيْهِمْ ۚ هُمُ ٱلْعَدُوُّ",683]]