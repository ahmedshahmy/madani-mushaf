[["2:22:5",4,"فِرَٰشًۭا","a resting place","جَعَلَ لَكُمُ ٱلْأَرْضَ","وَٱلسَّمَآءَ بِنَآءًۭ وَأَنزَلَ",1837],["6:142:4",146,"وَفَرْشًۭا ۚ","and (some for) meat","وَمِنَ ٱلْأَنْعَـٰمِ حَمُولَةًۭ","كُلُوا۟ مِمَّا رَزَقَكُمُ",3420],["51:48:2",522,"فَرَشْنَـٰهَا","We have spread it","وَٱلْأَرْضَ","فَنِعْمَ ٱلْمَـٰهِدُونَ",3417],["55:54:3",533,"فُرُشٍۭ","couches","مُتَّكِـِٔينَ عَلَىٰ","بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍۢ ۚ",1837],["56:34:1",535,"وَفُرُشٍۢ","And (on) couches","","مَّرْفُوعَةٍ",1837],["101:4:4",600,"كَٱلْفَرَاشِ","like moths","يَوْمَ يَكُونُ ٱلنَّاسُ","ٱلْمَبْثُوثِ",3418]]