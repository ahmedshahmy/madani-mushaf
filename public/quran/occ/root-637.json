[["2:258:36",43,"فَبُهِتَ","So became dumbfounded","بِهَا مِنَ ٱلْمَغْرِبِ","ٱلَّذِى كَفَرَ ۗ وَٱللَّهُ",2345],["4:20:15",81,"بُهْتَـٰنًۭا","(by) slander","مِنْهُ شَيْـًٔا ۚ أَتَأْخُذُونَهُۥ","وَإِثْمًۭا مُّبِينًۭا",1172],["4:112:12",96,"بُهْتَـٰنًۭا","(with) a slander","بَرِيٓـًۭٔا فَقَدِ ٱحْتَمَلَ","وَإِثْمًۭا مُّبِينًۭا",1172],["4:156:5",103,"بُهْتَـٰنًا","a slander","وَقَوْلِهِمْ عَلَىٰ مَرْيَمَ","عَظِيمًۭا",1172],["21:40:4",325,"فَتَبْهَتُهُمْ","and bewilder them","بَلْ تَأْتِيهِم بَغْتَةًۭ","فَلَا يَسْتَطِيعُونَ رَدَّهَا",2345],["24:16:13",351,"بُهْتَـٰنٌ","(is) a slander","بِهَـٰذَا سُبْحَـٰنَكَ هَـٰذَا","عَظِيمٌۭ",1172],["33:58:10",426,"بُهْتَـٰنًۭا","false accusation","ٱكْتَسَبُوا۟ فَقَدِ ٱحْتَمَلُوا۟","وَإِثْمًۭا مُّبِينًۭا",1172],["60:12:22",551,"بِبُهْتَـٰنٍۢ","slander","أَوْلَـٰدَهُنَّ وَلَا يَأْتِينَ","يَفْتَرِينَهُۥ بَيْنَ أَيْدِيهِنَّ",1172]]