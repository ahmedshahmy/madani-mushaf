[["4:38:16",85,"قَرِينًۭا","(as) companion","يَكُنِ ٱلشَّيْطَـٰنُ لَهُۥ","فَسَآءَ قَرِينًۭا",997],["4:38:18",85,"قَرِينًۭا","(is he as) a companion","لَهُۥ قَرِينًۭا فَسَآءَ","",997],["6:6:8",128,"قَرْنٍۢ","generations","مِن قَبْلِهِم مِّن","مَّكَّنَّـٰهُمْ فِى ٱلْأَرْضِ",458],["6:6:30",128,"قَرْنًا","generations","وَأَنشَأْنَا مِنۢ بَعْدِهِمْ","ءَاخَرِينَ",458],["10:13:3",209,"ٱلْقُرُونَ","the generations","وَلَقَدْ أَهْلَكْنَا","مِن قَبْلِكُمْ لَمَّا",458],["11:116:4",234,"ٱلْقُرُونِ","the generations","فَلَوْلَا كَانَ مِنَ","مِن قَبْلِكُمْ أُو۟لُوا۟",458],["14:49:4",261,"مُّقَرَّنِينَ","bound together","وَتَرَى ٱلْمُجْرِمِينَ يَوْمَئِذٍۢ","فِى ٱلْأَصْفَادِ",1935],["17:17:4",283,"ٱلْقُرُونِ","the generations","وَكَمْ أَهْلَكْنَا مِنَ","مِنۢ بَعْدِ نُوحٍۢ ۗ",458],["18:83:4",302,"ٱلْقَرْنَيْنِ ۖ","Dhul-qarnain","وَيَسْـَٔلُونَكَ عَن ذِى","قُلْ سَأَتْلُوا۟ عَلَيْكُم",458],["18:86:16",303,"ٱلْقَرْنَيْنِ","O Dhul-qarnain","قَوْمًۭا ۗ قُلْنَا يَـٰذَا","إِمَّآ أَن تُعَذِّبَ",458],["18:94:3",303,"ٱلْقَرْنَيْنِ","O Dhul-qarnain","قَالُوا۟ يَـٰذَا","إِنَّ يَأْجُوجَ وَمَأْجُوجَ",458],["19:74:5",310,"قَرْنٍ","a generation","أَهْلَكْنَا قَبْلَهُم مِّن","هُمْ أَحْسَنُ أَثَـٰثًۭا",458],["19:98:5",312,"قَرْنٍ","a generation","أَهْلَكْنَا قَبْلَهُم مِّن","هَلْ تُحِسُّ مِنْهُم",458],["20:51:4",314,"ٱلْقُرُونِ","(of) the generations","قَالَ فَمَا بَالُ","ٱلْأُولَىٰ",458],["20:128:8",321,"ٱلْقُرُونِ","the generations","أَهْلَكْنَا قَبْلَهُم مِّنَ","يَمْشُونَ فِى مَسَـٰكِنِهِمْ ۗ",458],["23:31:5",344,"قَرْنًا","a generation","أَنشَأْنَا مِنۢ بَعْدِهِمْ","ءَاخَرِينَ",458],["23:42:5",344,"قُرُونًا","a generation","أَنشَأْنَا مِنۢ بَعْدِهِمْ","ءَاخَرِينَ",458],["25:13:6",361,"مُّقَرَّنِينَ","bound in chains","مِنْهَا مَكَانًۭا ضَيِّقًۭا","دَعَوْا۟ هُنَالِكَ ثُبُورًۭا",1935],["25:38:5",363,"وَقُرُونًۢا","and generations","وَثَمُودَا۟ وَأَصْحَـٰبَ ٱلرَّسِّ","بَيْنَ ذَٰلِكَ كَثِيرًۭا",458],["28:43:9",390,"ٱلْقُرُونَ","the generations","بَعْدِ مَآ أَهْلَكْنَا","ٱلْأُولَىٰ بَصَآئِرَ لِلن