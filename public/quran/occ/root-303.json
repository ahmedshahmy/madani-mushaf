[["2:164:34",25,"وَتَصْرِيفِ","and directing","مِن كُلِّ دَآبَّةٍۢ","ٱلرِّيَـٰحِ وَٱلسَّحَابِ ٱلْمُسَخَّرِ",2657],["3:152:30",69,"صَرَفَكُمْ","He diverted you","يُرِيدُ ٱلْـَٔاخِرَةَ ۚ ثُمَّ","عَنْهُمْ لِيَبْتَلِيَكُمْ ۖ وَلَقَدْ",657],["6:16:2",129,"يُصْرَفْ","is averted","مَّن","عَنْهُ يَوْمَئِذٍۢ فَقَدْ",657],["6:46:19",133,"نُصَرِّفُ","We explain","بِهِ ۗ ٱنظُرْ كَيْفَ","ٱلْـَٔايَـٰتِ ثُمَّ هُمْ",826],["6:65:24",135,"نُصَرِّفُ","We explain","بَعْضٍ ۗ ٱنظُرْ كَيْفَ","ٱلْـَٔايَـٰتِ لَعَلَّهُمْ يَفْقَهُونَ",826],["6:105:2",141,"نُصَرِّفُ","We explain","وَكَذَٰلِكَ","ٱلْـَٔايَـٰتِ وَلِيَقُولُوا۟ دَرَسْتَ",826],["7:47:2",156,"صُرِفَتْ","are turned","۞ وَإِذَا","أَبْصَـٰرُهُمْ تِلْقَآءَ أَصْحَـٰبِ",657],["7:58:14",158,"نُصَرِّفُ","We explain","إِلَّا نَكِدًۭا ۚ كَذَٰلِكَ","ٱلْـَٔايَـٰتِ لِقَوْمٍۢ يَشْكُرُونَ",826],["7:146:1",168,"سَأَصْرِفُ","I will turn away","","عَنْ ءَايَـٰتِىَ ٱلَّذِينَ",657],["9:127:14",207,"ٱنصَرَفُوا۟ ۚ","they turn away","مِّنْ أَحَدٍۢ ثُمَّ","صَرَفَ ٱللَّهُ قُلُوبَهُم",4811],["9:127:15",207,"صَرَفَ","Allah has turned away","أَحَدٍۢ ثُمَّ ٱنصَرَفُوا۟ ۚ","ٱللَّهُ قُلُوبَهُم بِأَنَّهُمْ",657],["10:32:11",212,"تُصْرَفُونَ","(are) you turned away","إِلَّا ٱلضَّلَـٰلُ ۖ فَأَنَّىٰ","",657],["11:8:15",222,"مَصْرُوفًا","(will be) averted","يَوْمَ يَأْتِيهِمْ لَيْسَ","عَنْهُمْ وَحَاقَ بِهِم",3643],["12:24:12",238,"لِنَصْرِفَ","that We might avert","بُرْهَـٰنَ رَبِّهِۦ ۚ كَذَٰلِكَ","عَنْهُ ٱلسُّوٓءَ وَٱلْفَحْشَآءَ ۚ",657],["12:33:10",239,"تَصْرِفْ","You turn away","يَدْعُونَنِىٓ إِلَيْهِ ۖ وَإِلَّا","عَنِّى كَيْدَهُنَّ أَصْبُ",657],["12:34:4",239,"فَصَرَفَ","and turned away","فَٱسْتَجَابَ لَهُۥ رَبُّهُۥ","عَنْهُ كَيْدَهُنَّ ۚ إِنَّهُۥ",657],["17:41:2",286,"صَرَّفْنَا","We have explained","وَلَقَدْ","فِى هَـٰذَا ٱلْقُرْءَانِ",826],["17:89:2",291,"صَرَّفْنَا","We have explained","وَلَقَدْ","لِلنَّاسِ فِى هَـٰذَا",826],["18:53:10",299,"مَصْرِفًۭا","a way of escape","وَلَمْ يَجِدُوا۟ عَنْهَا","",3642],["18:54:2",300,"صَرَّفْنَا","We have explained","وَلَقَدْ","فِى هَـٰذَا ٱلْقُرْءَانِ",826],["20:113:5",319,"وَصَرَّفْنَا","and We have explained","أَنزَلْنَـٰهُ قُرْءَانًا عَرَبِيًّۭا","فِيهِ مِنَ ٱلْوَعِيدِ",826],["24:43:30",355,"وَيَصْرِفُهُۥ","and averts it","بِهِۦ مَن يَشَآءُ","عَن مَّن يَشَآءُ ۖ",657],["25:19:7",361,"صَرْفًۭا","(to) avert","تَقُولُونَ فَمَا تَسْتَطِيعُونَ","وَلَا نَصْرًۭا ۚ وَمَن",3252],["25:50:2",364,"صَرَّفْنَـٰهُ","We have distributed it","وَلَقَدْ","بَيْنَهُمْ لِيَذَّكَّرُوا۟ فَأَبَىٰٓ",826],["25:65:4",365,"ٱصْرِفْ","Avert","وَٱلَّذِينَ يَقُولُونَ رَبَّنَا","عَنَّا عَذَابَ جَهَنَّمَ ۖ",657],["39:6:36",459,"تُصْرَفُونَ","are you turning away","إِلَّا هُوَ ۖ فَأَنَّىٰ","",657],["40:69:10",475,"يُصْرَفُونَ","they are turned away","ءَايَـٰتِ ٱللَّهِ أَنَّىٰ","",657],["45:5:16",499,"وَتَصْرِيفِ","and (in) directing","ٱلْأَرْضَ بَعْدَ مَوْتِهَا","ٱلرِّيَـٰحِ ءَايَـٰتٌۭ لِّقَوْمٍۢ",2657],["46:27:7",505,"وَصَرَّفْنَا","and We have diversified","حَوْلَكُم مِّنَ ٱلْقُرَىٰ","ٱلْـَٔايَـٰتِ لَعَلَّهُمْ يَرْجِعُونَ",826],["46:29:2",506,"صَرَفْنَآ","We directed","وَإِذْ","إِلَيْكَ نَفَرًۭا مِّنَ",657]]