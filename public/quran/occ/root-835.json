[["11:72:8",230,"شَيْخًا ۖ","(is) an old man","عَجُوزٌۭ وَهَـٰذَا بَعْلِى","إِنَّ هَـٰذَا لَشَىْءٌ",1455],["12:78:7",244,"شَيْخًۭا","old","إِنَّ لَهُۥٓ أَبًۭا","كَبِيرًۭا فَخُذْ أَحَدَنَا",1455],["28:23:26",388,"شَيْخٌۭ","(is) a very old man","يُصْدِرَ ٱلرِّعَآءُ ۖ وَأَبُونَا","كَبِيرٌۭ",1455],["40:67:20",475,"شُيُوخًۭا ۚ","old","أَشُدَّكُمْ ثُمَّ لِتَكُونُوا۟","وَمِنكُم مَّن يُتَوَفَّىٰ",1455]]