[["3:52:12",56,"ٱلْحَوَارِيُّونَ","the disciples","إِلَى ٱللَّهِ ۖ قَالَ","نَحْنُ أَنصَارُ ٱللَّهِ",1302],["5:111:4",126,"ٱلْحَوَارِيِّـۧنَ","the disciples","وَإِذْ أَوْحَيْتُ إِلَى","أَنْ ءَامِنُوا۟ بِى",1302],["5:112:3",126,"ٱلْحَوَارِيُّونَ","the disciples","إِذْ قَالَ","يَـٰعِيسَى ٱبْنَ مَرْيَمَ",1302],["18:34:7",297,"يُحَاوِرُهُۥٓ","(was) talking with him","فَقَالَ لِصَـٰحِبِهِۦ وَهُوَ","أَنَا۠ أَكْثَرُ مِنكَ",2799],["18:37:5",298,"يُحَاوِرُهُۥٓ","was talking to him","لَهُۥ صَاحِبُهُۥ وَهُوَ","أَكَفَرْتَ بِٱلَّذِى خَلَقَكَ",2799],["44:54:3",498,"بِحُورٍ","(to) companions with beautiful eyes","كَذَٰلِكَ وَزَوَّجْنَـٰهُم","عِينٍۢ",1516],["52:20:6",524,"بِحُورٍ","to fair ones","سُرُرٍۢ مَّصْفُوفَةٍۢ ۖ وَزَوَّجْنَـٰهُم","عِينٍۢ",1516],["55:72:1",534,"حُورٌۭ","Fair ones","","مَّقْصُورَٰتٌۭ فِى ٱلْخِيَامِ",1516],["56:22:1",535,"وَحُورٌ","And fair ones","","عِينٌۭ",1516],["58:1:14",542,"تَحَاوُرَكُمَآ ۚ","(the) dialogue of both of you","ٱللَّهِ وَٱللَّهُ يَسْمَعُ","إِنَّ ٱللَّهَ سَمِيعٌۢ",4329],["61:14:12",552,"لِلْحَوَارِيِّـۧنَ","to the disciples","عِيسَى ٱبْنُ مَرْيَمَ","مَنْ أَنصَارِىٓ إِلَى",1302],["61:14:18",552,"ٱلْحَوَارِيُّونَ","the disciples","إِلَى ٱللَّهِ ۖ قَالَ","نَحْنُ أَنصَارُ ٱللَّهِ ۖ",1302],["84:14:5",589,"يَحُورَ","he would return","ظَنَّ أَن لَّن","",4612]]