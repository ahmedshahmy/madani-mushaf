[["4:11:27",78,"ٱلسُّدُسُ","a sixth","لِكُلِّ وَٰحِدٍۢ مِّنْهُمَا","مِمَّا تَرَكَ إِن",2002],["4:11:48",78,"ٱلسُّدُسُ ۚ","(is) the sixth","لَهُۥٓ إِخْوَةٌۭ فَلِأُمِّهِ","مِنۢ بَعْدِ وَصِيَّةٍۢ",2002],["4:12:64",79,"ٱلسُّدُسُ ۚ","(is) the sixth","فَلِكُلِّ وَٰحِدٍۢ مِّنْهُمَا","فَإِن كَانُوٓا۟ أَكْثَرَ",2002],["18:22:7",296,"سَادِسُهُمْ","the sixth of them","كَلْبُهُمْ وَيَقُولُونَ خَمْسَةٌۭ","كَلْبُهُمْ رَجْمًۢا بِٱلْغَيْبِ ۖ",2617],["58:7:24",543,"سَادِسُهُمْ","(the) sixth of them","خَمْسَةٍ إِلَّا هُوَ","وَلَآ أَدْنَىٰ مِن",2617]]