[["2:23:16",4,"دُونِ","other than","وَٱدْعُوا۟ شُهَدَآءَكُم مِّن","ٱللَّهِ إِن كُنتُمْ",78],["2:94:11",15,"دُونِ","excluding","ٱللَّهِ خَالِصَةًۭ مِّن","ٱلنَّاسِ فَتَمَنَّوُا۟ ٱلْمَوْتَ",78],["2:107:12",17,"دُونِ","besides","وَمَا لَكُم مِّن","ٱللَّهِ مِن وَلِىٍّۢ",78],["2:165:6",25,"دُونِ","besides","مَن يَتَّخِذُ مِن","ٱللَّهِ أَندَادًۭا يُحِبُّونَهُمْ",78],["3:28:7",53,"دُونِ","instead of","ٱلْكَـٰفِرِينَ أَوْلِيَآءَ مِن","ٱلْمُؤْمِنِينَ ۖ وَمَن يَفْعَلْ",78],["3:64:24",58,"دُونِ","besides","بَعْضًا أَرْبَابًۭا مِّن","ٱللَّهِ ۚ فَإِن تَوَلَّوْا۟",78],["3:79:17",60,"دُونِ","besides","عِبَادًۭا لِّى مِن","ٱللَّهِ وَلَـٰكِن كُونُوا۟",78],["3:118:8",65,"دُونِكُمْ","other than yourselves","تَتَّخِذُوا۟ بِطَانَةًۭ مِّن","لَا يَأْلُونَكُمْ خَبَالًۭا",78],["4:48:10",86,"دُونَ","other than","بِهِۦ وَيَغْفِرُ مَا","ذَٰلِكَ لِمَن يَشَآءُ ۚ",78],["4:116:10",97,"دُونَ","other than","بِهِۦ وَيَغْفِرُ مَا","ذَٰلِكَ لِمَن يَشَآءُ ۚ",78],["4:117:4",97,"دُونِهِۦٓ","besides Him","إِن يَدْعُونَ مِن","إِلَّآ إِنَـٰثًۭا وَإِن",78],["4:119:16",97,"دُونِ","besides","ٱلشَّيْطَـٰنَ وَلِيًّۭا مِّن","ٱللَّهِ فَقَدْ خَسِرَ",78],["4:123:16",98,"دُونِ","besides","يَجِدْ لَهُۥ مِن","ٱللَّهِ وَلِيًّۭا وَلَا",78],["4:139:6",100,"دُونِ","instead of","ٱلْكَـٰفِرِينَ أَوْلِيَآءَ مِن","ٱلْمُؤْمِنِينَ ۚ أَيَبْتَغُونَ عِندَهُمُ",78],["4:144:9",101,"دُونِ","instead of","ٱلْكَـٰفِرِينَ أَوْلِيَآءَ مِن","ٱلْمُؤْمِنِينَ ۚ أَتُرِيدُونَ أَن",78],["4:173:22",105,"دُونِ","besides","يَجِدُونَ لَهُم مِّن","ٱللَّهِ وَلِيًّۭا وَلَا",78],["5:76:4",120,"دُونِ","besides","قُلْ أَتَعْبُدُونَ مِن","ٱللَّهِ مَا لَا",78],["5:116:14",127,"دُونِ","besides","وَأُمِّىَ إِلَـٰهَيْنِ مِن","ٱللَّهِ ۖ قَالَ سُبْحَـٰنَكَ",78],["6:51:12",133,"دُونِهِۦ","other than Him","لَيْسَ لَهُم مِّن","وَلِىٌّۭ وَلَا شَفِيعٌۭ",78],["6:56:9",134,"دُونِ","besides","ٱلَّذِينَ تَدْعُونَ مِن","ٱللَّهِ ۚ قُل لَّآ",78],["6:70:20",136,"دُونِ","besides","لَيْسَ لَهَا مِن","ٱللَّهِ وَلِىٌّۭ وَلَا",78],["6:71:4",136,"دُونِ","besides","قُلْ أَنَدْعُوا۟ مِن","ٱللَّهِ مَا لَا",78],["6:108:6",141,"دُونِ","other than","ٱلَّذِينَ يَدْعُونَ مِن","ٱللَّهِ فَيَسُبُّوا۟ ٱللَّهَ",78],["7:3:10",151,"دُونِهِۦٓ","beside Him","وَلَا تَتَّبِعُوا۟ مِن","أَوْلِيَآءَ ۗ قَلِيلًۭا مَّا",78],["7:30:12",153,"دُونِ","besides","ٱلشَّيَـٰطِينَ أَوْلِيَآءَ مِن","ٱللَّهِ وَيَحْسَبُونَ أَنَّهُم",78],["7:37:27",154,"دُونِ","besides","كُنتُمْ تَدْعُونَ مِن","ٱللَّهِ ۖ قَالُوا۟ ضَلُّوا۟",78],["7:81:6",160,"دُونِ","instead of","ٱلرِّجَالَ شَهْوَةًۭ مِّن","ٱلنِّسَآءِ ۚ بَلْ أَنتُمْ",78],["7:168:8",172,"دُونَ","(are) other than","مِّنْهُمُ ٱلصَّـٰلِحُونَ وَمِنْهُمْ","ذَٰلِكَ ۖ وَبَلَوْنَـٰهُم بِٱلْحَسَنَـٰتِ",78],["7:194:5",175,"دُونِ","besides","ٱلَّذِينَ تَدْعُونَ مِن","ٱللَّهِ عِبَادٌ أَمْثَالُكُمْ ۖ",78],["7:197:4",176,"دُونِهِۦ","besides Him","وَٱلَّذِينَ تَدْعُونَ مِن","لَا يَسْتَطِيعُونَ نَصْرَكُمْ",78],["7:205:7",176,"وَدُونَ","and without","نَفْسِكَ تَضَرُّعًۭا وَخِيفَةًۭ","ٱلْجَهْرِ مِنَ ٱلْقَوْلِ",78],["8:60:17",184,"دُونِهِمْ","besides them","وَعَدُوَّكُمْ وَءَاخَرِينَ مِن","لَا تَعْلَمُونَهُمُ ٱللَّهُ",78],["9:16:14",189,"دُونِ","besides Allah","وَلَمْ يَتَّخِذُوا۟ مِن","ٱللَّهِ وَلَا رَسُولِهِۦ",78],["9:31:6",191,"دُونِ","besides","وَرُهْبَـٰنَهُمْ أَرْبَابًۭا مِّن","ٱللَّهِ وَٱلْمَسِيحَ ٱبْنَ",78],["9:116:12",205,"دُونِ","besides Allah","وَمَا لَكُم مِّن","ٱللَّهِ مِن وَلِىٍّۢ",78],["10:18:3",210,"دُونِ","other than","وَيَعْبُدُونَ مِن","ٱللَّهِ مَا لَا",78],["10:37:8",213,"دُونِ","other than Allah","أَن يُفْتَرَىٰ مِن","ٱللَّهِ وَلَـٰكِن تَصْدِيقَ",78],["10:38:12",213,"دُونِ","besides Allah","مَنِ ٱسْتَطَعْتُم مِّن","ٱللَّهِ إِن كُنتُمْ",78],["10:66:15",216,"دُونِ","other than Allah","ٱلَّذِينَ يَدْعُونَ مِن","ٱللَّهِ شُرَكَآءَ ۚ إِن",78],["10:104:15",220,"دُونِ","besides Allah","ٱلَّذِينَ تَعْبُدُونَ مِن","ٱللَّهِ وَلَـٰكِنْ أَعْبُدُ",78],["10:106:4",220,"دُونِ","besides Allah","وَلَا تَدْعُ مِن","ٱللَّهِ مَا لَا",78],["11:13:14",223,"دُونِ","besides Allah","مَنِ ٱسْتَطَعْتُم مِّن","ٱللَّهِ إِن كُنتُمْ",78],["11:20:11",224,"دُونِ","besides","كَانَ لَهُم مِّن","ٱللَّهِ مِنْ أَوْلِيَآءَ ۘ",78],["11:55:2",228,"دُونِهِۦ ۖ","Other than Him","مِن","فَكِيدُونِى جَمِيعًۭا ثُمَّ",78],["11:101:13",233,"دُونِ","other than Allah","ٱلَّتِى يَدْعُونَ مِن","ٱللَّهِ مِن شَىْءٍۢ",78],["11:113:11",234,"دُونِ","besides Allah","وَمَا لَكُم مِّن","ٱللَّهِ مِنْ أَوْلِيَآءَ",78],["12:40:4",240,"دُونِهِۦٓ","besides Him","مَا تَعْبُدُونَ مِن","إِلَّآ أَسْمَآءًۭ سَمَّيْتُمُوهَآ",78],["13:11:33",250,"دُونِهِۦ","besides Him","وَمَا لَهُم مِّن","مِن وَالٍ",78],["13:14:7",251,"دُونِهِۦ","besides Him","وَٱلَّذِينَ يَدْعُونَ مِن","لَا يَسْتَجِيبُونَ لَهُم",78],["13:16:11",251,"دُونِهِۦٓ","besides Him","قُلْ أَفَٱتَّخَذْتُم مِّن","أَوْلِيَآءَ لَا يَمْلِكُونَ",78],["16:20:4",269,"دُونِ","besides","وَٱلَّذِينَ يَدْعُونَ مِن","ٱللَّهِ لَا يَخْلُقُونَ",78],["16:35:10",271,"دُونِهِۦ","other than Him","مَا عَبَدْنَا مِن","مِن شَىْءٍۢ نَّحْنُ",78],["16:35:19",271,"دُونِهِۦ","other than Him","وَلَا حَرَّمْنَا مِن","مِن شَىْءٍۢ ۚ كَذَٰلِكَ",78],["16:73:3",275,"دُونِ","other than","وَيَعْبُدُونَ مِن","ٱللَّهِ مَا لَا",78],["16:86:14",276,"دُونِكَ ۖ","besides You","كُنَّا نَدْعُوا۟ مِن","فَأَلْقَوْا۟ إِلَيْهِمُ ٱلْقَوْلَ",78],["17:2:11",282,"دُونِى","other than Me","أَلَّا تَتَّخِذُوا۟ مِن","وَكِيلًۭا",78],["17:56:6",287,"دُونِهِۦ","besides Him","ٱلَّذِينَ زَعَمْتُم مِّن","فَلَا يَمْلِكُونَ كَشْفَ",78],["17:97:13",292,"دُونِهِۦ ۖ","besides Him","لَهُمْ أَوْلِيَآءَ مِن","وَنَحْشُرُهُمْ يَوْمَ ٱلْقِيَـٰمَةِ",78],["18:14:14",294,"دُونِهِۦٓ","besides Him","لَن نَّدْعُوَا۟ مِن","إِلَـٰهًۭا ۖ لَّقَدْ قُلْنَآ",78],["18:15:5",294,"دُونِهِۦٓ","besides Him","قَوْمُنَا ٱتَّخَذُوا۟ مِن","ءَالِهَةًۭ ۖ لَّوْلَا يَأْتُونَ",78],["18:26:16",296,"دُونِهِۦ","besides Him","مَا لَهُم مِّن","مِن وَلِىٍّۢ وَلَا",78],["18:27:14",296,"دُونِهِۦ","besides Him","وَلَن تَجِدَ مِن","مُلْتَحَدًۭا",78],["18:43:7",298,"دُونِ","other than","فِئَةٌۭ يَنصُرُونَهُۥ مِن","ٱللَّهِ وَمَا كَانَ",78],["18:50:20",299,"دُونِى","other than Me","وَذُرِّيَّتَهُۥٓ أَوْلِيَآءَ مِن","وَهُمْ لَكُمْ عَدُوٌّۢ ۚ",78],["18:58:18",300,"دُونِهِۦ","other than it","لَّن يَجِدُوا۟ مِن","مَوْئِلًۭا",78],["18:90:14",303,"دُونِهَا","against it","نَجْعَل لَّهُم مِّن","سِتْرًۭا",78],["18:93:8",303,"دُونِهِمَا","besides them","ٱلسَّدَّيْنِ وَجَدَ مِن","قَوْمًۭا لَّا يَكَادُونَ",78],["18:102:8",304,"دُونِىٓ","besides Me","يَتَّخِذُوا۟ عِبَادِى مِن","أَوْلِيَآءَ ۚ إِنَّآ أَعْتَدْنَا",78],["19:17:3",306,"دُونِهِمْ","from them","فَٱتَّخَذَتْ مِن","حِجَابًۭا فَأَرْسَلْنَآ إِلَيْهَا",78],["19:48:5",308,"دُونِ","besides","وَمَا تَدْعُونَ مِن","ٱللَّهِ وَأَدْعُوا۟ رَبِّى",78],["19:49:6",308,"دُونِ","besides Allah","وَمَا يَعْبُدُونَ مِن","ٱللَّهِ وَهَبْنَا لَهُۥٓ",78],["19:81:3",311,"دُونِ","besides Allah","وَٱتَّخَذُوا۟ مِن","ٱللَّهِ ءَالِهَةًۭ لِّيَكُونُوا۟",78],["21:24:4",323,"دُونِهِۦٓ","besides Him","أَمِ ٱتَّخَذُوا۟ مِن","ءَالِهَةًۭ ۖ قُلْ هَاتُوا۟",78],["21:29:7",324,"دُونِهِۦ","besides Him","إِنِّىٓ إِلَـٰهٌۭ مِّن","فَذَٰلِكَ نَجْزِيهِ جَهَنَّمَ ۚ",78],["21:43:6",325,"دُونِنَا ۚ","Us","ءَالِهَةٌۭ تَمْنَعُهُم مِّن","لَا يَسْتَطِيعُونَ نَصْرَ",78],["21:66:4",327,"دُونِ","besides","قَالَ أَفَتَعْبُدُونَ مِن","ٱللَّهِ مَا لَا",78],["21:67:6",327,"دُونِ","besides","وَلِمَا تَعْبُدُونَ مِن","ٱللَّهِ ۖ أَفَلَا تَعْقِلُونَ",78],["21:82:8",329,"دُونَ","other than","لَهُۥ وَيَعْمَلُونَ عَمَلًۭا","ذَٰلِكَ ۖ وَكُنَّا لَهُمْ",78],["21:98:5",330,"دُونِ","besides Allah","وَمَا تَعْبُدُونَ مِن","ٱللَّهِ حَصَبُ جَهَنَّمَ",78],["22:12:3",333,"دُونِ","besides","يَدْعُوا۟ مِن","ٱللَّهِ مَا لَا",78],["22:62:10",339,"دُونِهِۦ","besides Him","مَا يَدْعُونَ مِن","هُوَ ٱلْبَـٰطِلُ وَأَنَّ",78],["22:71:3",340,"دُونِ","besides Allah","وَيَعْبُدُونَ مِن","ٱللَّهِ مَا لَمْ",78],["22:73:11",341,"دُونِ","besides Allah","ٱلَّذِينَ تَدْعُونَ مِن","ٱللَّهِ لَن يَخْلُقُوا۟",78],["23:63:10",346,"دُونِ","besides","وَلَهُمْ أَعْمَـٰلٌۭ مِّن","ذَٰلِكَ هُمْ لَهَا",78],["25:3:3",360,"دُونِهِۦٓ","besides Him","وَٱتَّخَذُوا۟ مِن","ءَالِهَةًۭ لَّا يَخْلُقُونَ",78],["25:17:6",361,"دُونِ","besides Allah","وَمَا يَعْبُدُونَ مِن","ٱللَّهِ فَيَقُولُ ءَأَنتُمْ",78],["25:18:10",361,"دُونِكَ","besides You","أَن نَّتَّخِذَ مِن","مِنْ أَوْلِيَآءَ وَلَـٰكِن",78],["25:55:3",364,"دُونِ","besides Allah","وَيَعْبُدُونَ مِن","ٱللَّهِ مَا لَا",78],["26:93:2",371,"دُونِ","Besides Allah","مِن","ٱللَّهِ هَلْ يَنصُرُونَكُمْ",78],["27:24:6",379,"دُونِ","instead of Allah","يَسْجُدُونَ لِلشَّمْسِ مِن","ٱللَّهِ وَزَيَّنَ لَهُمُ",78],["27:43:6",380,"دُونِ","besides","كَانَت تَّعْبُدُ مِن","ٱللَّهِ ۖ إِنَّهَا كَانَتْ",78],["27:55:6",381,"دُونِ","instead of","ٱلرِّجَالَ شَهْوَةًۭ مِّن","ٱلنِّسَآءِ ۚ بَلْ أَنتُمْ",78],["28:23:13",388,"دُونِهِمُ","besides them","يَسْقُونَ وَوَجَدَ مِن","ٱمْرَأَتَيْنِ تَذُودَانِ ۖ قَالَ",78],["28:81:12",395,"دُونِ","besides","فِئَةٍۢ يَنصُرُونَهُۥ مِن","ٱللَّهِ وَمَا كَانَ",78],["29:17:4",398,"دُونِ","besides","إِنَّمَا تَعْبُدُونَ مِن","ٱللَّهِ أَوْثَـٰنًۭا وَتَخْلُقُونَ",78],["29:17:13",398,"دُونِ","besides","ٱلَّذِينَ تَعْبُدُونَ مِن","ٱللَّهِ لَا يَمْلِكُونَ",78],["29:22:12",398,"دُونِ","besides","وَمَا لَكُم مِّن","ٱللَّهِ مِن وَلِىٍّۢ",78],["29:25:5",399,"دُونِ","besides","إِنَّمَا ٱتَّخَذْتُم مِّن","ٱللَّهِ أَوْثَـٰنًۭا مَّوَدَّةَ",78],["29:41:5",401,"دُونِ","besides","ٱلَّذِينَ ٱتَّخَذُوا۟ مِن","ٱللَّهِ أَوْلِيَآءَ كَمَثَلِ",78],["29:42:7",401,"دُونِهِۦ","besides Him","مَا يَدْعُونَ مِن","مِن شَىْءٍۢ ۚ وَهُوَ",78],["31:11:9",411,"دُونِهِۦ ۚ","besides Him","خَلَقَ ٱلَّذِينَ مِن","بَلِ ٱلظَّـٰلِمُونَ فِى",78],["31:30:10",414,"دُونِهِ","besides Him","مَا يَدْعُونَ مِن","ٱلْبَـٰطِلُ وَأَنَّ ٱللَّهَ",78],["32:4:18",415,"دُونِهِۦ","besides Him","مَا لَكُم مِّن","مِن وَلِىٍّۢ وَلَا",78],["32:21:5",417,"دُونَ","before","مِّنَ ٱلْعَذَابِ ٱلْأَدْنَىٰ","ٱلْعَذَابِ ٱلْأَكْبَرِ لَعَلَّهُمْ",78],["33:17:20",420,"دُونِ","besides","يَجِدُونَ لَهُم مِّن","ٱللَّهِ وَلِيًّۭا وَلَا",78],["33:50:42",424,"دُونِ","excluding","خَالِصَةًۭ لَّكَ مِن","ٱلْمُؤْمِنِينَ ۗ قَدْ عَلِمْنَا",78],["34:22:6",430,"دُونِ","besides","ٱلَّذِينَ زَعَمْتُم مِّن","ٱللَّهِ ۖ لَا يَمْلِكُونَ",78],["34:41:6",433,"دُونِهِم ۖ","not them","أَنتَ وَلِيُّنَا مِن","بَلْ كَانُوا۟ يَعْبُدُونَ",78],["35:13:24",436,"دُونِهِۦ","besides Him","وَٱلَّذِينَ تَدْعُونَ مِن","مَا يَمْلِكُونَ مِن",78],["35:40:7",439,"دُونِ","besides","ٱلَّذِينَ تَدْعُونَ مِن","ٱللَّهِ أَرُونِى مَاذَا",78],["36:23:3",441,"دُونِهِۦٓ","besides Him","ءَأَتَّخِذُ مِن","ءَالِهَةً إِن يُرِدْنِ",78],["36:74:3",445,"دُونِ","besides","وَٱتَّخَذُوا۟ مِن","ٱللَّهِ ءَالِهَةًۭ لَّعَلَّهُمْ",78],["37:23:2",446,"دُونِ","Besides","مِن","ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ",78],["37:86:3",449,"دُونَ","other than","أَئِفْكًا ءَالِهَةًۭ","ٱللَّهِ تُرِيدُونَ",78],["39:3:8",458,"دُونِهِۦٓ","besides Him","وَٱلَّذِينَ ٱتَّخَذُوا۟ مِن","أَوْلِيَآءَ مَا نَعْبُدُهُمْ",78],["39:15:5",460,"دُونِهِۦ ۗ","besides Him","مَا شِئْتُم مِّن","قُلْ إِنَّ ٱلْخَـٰسِرِينَ",78],["39:36:8",462,"دُونِهِۦ ۚ","besides Him","وَيُخَوِّفُونَكَ بِٱلَّذِينَ مِن","وَمَن يُضْلِلِ ٱللَّهُ",78],["39:38:14",462,"دُونِ","besides","مَّا تَدْعُونَ مِن","ٱللَّهِ إِنْ أَرَادَنِىَ",78],["39:43:4",463,"دُونِ","besides","أَمِ ٱتَّخَذُوا۟ مِن","ٱللَّهِ شُفَعَآءَ ۚ قُلْ",78],["39:45:15",463,"دُونِهِۦٓ","besides Him","ذُكِرَ ٱلَّذِينَ مِن","إِذَا هُمْ يَسْتَبْشِرُونَ",78],["40:20:7",469,"دُونِهِۦ","besides Him","وَٱلَّذِينَ يَدْعُونَ مِن","لَا يَقْضُونَ بِشَىْءٍ ۗ",78],["40:66:9",474,"دُونِ","besides","ٱلَّذِينَ تَدْعُونَ مِن","ٱللَّهِ لَمَّا جَآءَنِىَ",78],["40:74:2",475,"دُونِ","Other than","مِن","ٱللَّهِ ۖ قَالُوا۟ ضَلُّوا۟",78],["42:6:4",483,"دُونِهِۦٓ","besides","وَٱلَّذِينَ ٱتَّخَذُوا۟ مِن","أَوْلِيَآءَ ٱللَّهُ حَفِيظٌ",78],["42:9:4",483,"دُونِهِۦٓ","besides Him","أَمِ ٱتَّخَذُوا۟ مِن","أَوْلِيَآءَ ۖ فَٱللَّهُ هُوَ",78],["42:31:9",486,"دُونِ","besides","وَمَا لَكُم مِّن","ٱللَّهِ مِن وَلِىٍّۢ",78],["42:46:8",488,"دُونِ","besides","أَوْلِيَآءَ يَنصُرُونَهُم مِّن","ٱللَّهِ ۗ وَمَن يُضْلِلِ",78],["43:45:10",492,"دُونِ","besides","رُّسُلِنَآ أَجَعَلْنَا مِن","ٱلرَّحْمَـٰنِ ءَالِهَةًۭ يُعْبَدُونَ",78],["43:86:6",495,"دُونِهِ","besides Him","ٱلَّذِينَ يَدْعُونَ مِن","ٱلشَّفَـٰعَةَ إِلَّا مَن",78],["45:10:14",499,"دُونِ","besides","مَا ٱتَّخَذُوا۟ مِن","ٱللَّهِ أَوْلِيَآءَ ۖ وَلَهُمْ",78],["46:4:6",502,"دُونِ","besides","مَّا تَدْعُونَ مِن","ٱللَّهِ أَرُونِى مَاذَا",78],["46:5:6",502,"دُونِ","besides","مِمَّن يَدْعُوا۟ مِن","ٱللَّهِ مَن لَّا",78],["46:28:6",505,"دُونِ","besides","ٱلَّذِينَ ٱتَّخَذُوا۟ مِن","ٱللَّهِ قُرْبَانًا ءَالِهَةًۢ ۖ",78],["46:32:13",506,"دُونِهِۦٓ","besides Him","وَلَيْسَ لَهُۥ مِن","أَوْلِيَآءُ ۚ أُو۟لَـٰٓئِكَ فِى",78],["48:27:25",514,"دُونِ","besides","تَعْلَمُوا۟ فَجَعَلَ مِن","ذَٰلِكَ فَتْحًۭا قَرِيبًا",78],["52:47:5",525,"دُونَ","before","لِلَّذِينَ ظَلَمُوا۟ عَذَابًۭا","ذَٰلِكَ وَلَـٰكِنَّ أَكْثَرَهُمْ",78],["53:58:4",528,"دُونِ","besides","لَيْسَ لَهَا مِن","ٱللَّهِ كَاشِفَةٌ",78],["55:62:2",533,"دُونِهِمَا","Besides these two","وَمِن","جَنَّتَانِ",78],["60:4:19",549,"دُونِ","besides","وَمِمَّا تَعْبُدُونَ مِن","ٱللَّهِ كَفَرْنَا بِكُمْ",78],["62:6:11",553,"دُونِ","excluding","أَوْلِيَآءُ لِلَّهِ مِن","ٱلنَّاسِ فَتَمَنَّوُا۟ ٱلْمَوْتَ",78],["67:20:9",563,"دُونِ","besides","لَّكُمْ يَنصُرُكُم مِّن","ٱلرَّحْمَـٰنِ ۚ إِنِ ٱلْكَـٰفِرُونَ",78],["71:25:10",571,"دُونِ","besides","يَجِدُوا۟ لَهُم مِّن","ٱللَّهِ أَنصَارًۭا",78],["72:11:5",572,"دُونَ","(are) other than","مِنَّا ٱلصَّـٰلِحُونَ وَمِنَّا","ذَٰلِكَ ۖ كُنَّا طَرَآئِقَ",78],["72:22:11",573,"دُونِهِۦ","besides Him","وَلَنْ أَجِدَ مِن","مُلْتَحَدًا",78]]