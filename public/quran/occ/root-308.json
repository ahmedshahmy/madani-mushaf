[["4:11:59",78,"تَدْرُونَ","you know","ءَابَآؤُكُمْ وَأَبْنَآؤُكُمْ لَا","أَيُّهُمْ أَقْرَبُ لَكُمْ",744],["10:16:9",210,"أَدْرَىٰكُم","He (would) have made it known to you","تَلَوْتُهُۥ عَلَيْكُمْ وَلَآ","بِهِۦ ۖ فَقَدْ لَبِثْتُ",562],["21:109:8",331,"أَدْرِىٓ","I know","عَلَىٰ سَوَآءٍۢ ۖ وَإِنْ","أَقَرِيبٌ أَم بَعِيدٌۭ",744],["21:111:2",331,"أَدْرِى","I know","وَإِنْ","لَعَلَّهُۥ فِتْنَةٌۭ لَّكُمْ",744],["31:34:13",414,"تَدْرِى","knows","فِى ٱلْأَرْحَامِ ۖ وَمَا","نَفْسٌۭ مَّاذَا تَكْسِبُ",744],["31:34:19",414,"تَدْرِى","knows","تَكْسِبُ غَدًۭا ۖ وَمَا","نَفْسٌۢ بِأَىِّ أَرْضٍۢ",744],["33:63:11",427,"يُدْرِيكَ","will make you know","عِندَ ٱللَّهِ ۚ وَمَا","لَعَلَّ ٱلسَّاعَةَ تَكُونُ",562],["42:17:8",485,"يُدْرِيكَ","will make you know","بِٱلْحَقِّ وَٱلْمِيزَانَ ۗ وَمَا","لَعَلَّ ٱلسَّاعَةَ قَرِيبٌۭ",562],["42:52:9",489,"تَدْرِى","know","أَمْرِنَا ۚ مَا كُنتَ","مَا ٱلْكِتَـٰبُ وَلَا",744],["45:32:13",501,"نَدْرِى","we know","فِيهَا قُلْتُم مَّا","مَا ٱلسَّاعَةُ إِن",744],["46:9:8",503,"أَدْرِى","I know","مِّنَ ٱلرُّسُلِ وَمَآ","مَا يُفْعَلُ بِى",744],["65:1:35",558,"تَدْرِى","you know","ظَلَمَ نَفْسَهُۥ ۚ لَا","لَعَلَّ ٱللَّهَ يُحْدِثُ",744],["69:3:2",566,"أَدْرَىٰكَ","will make you know","وَمَآ","مَا ٱلْحَآقَّةُ",562],["69:26:2",567,"أَدْرِ","I had known","وَلَمْ","مَا حِسَابِيَهْ",744],["72:10:3",572,"نَدْرِىٓ","we know","وَأَنَّا لَا","أَشَرٌّ أُرِيدَ بِمَن",744],["72:25:3",573,"أَدْرِىٓ","I know","قُلْ إِنْ","أَقَرِيبٌۭ مَّا تُوعَدُونَ",744],["74:27:2",576,"أَدْرَىٰكَ","can make you know","وَمَآ","مَا سَقَرُ",562],["77:14:2",580,"أَدْرَىٰكَ","will make you know","وَمَآ","مَا يَوْمُ ٱلْفَصْلِ",562],["80:3:2",585,"يُدْرِيكَ","would make you know","وَمَا","لَعَلَّهُۥ يَزَّكَّىٰٓ",562],["82:17:2",587,"أَدْرَىٰكَ","can make you know","وَمَآ","مَا يَوْمُ ٱلدِّينِ",562],["82:18:3",587,"أَدْرَىٰكَ","can make you know","ثُمَّ مَآ","مَا يَوْمُ ٱلدِّينِ",562],["83:8:2",588,"أَدْرَىٰكَ","can make you know","وَمَآ","مَا سِجِّينٌۭ",562],["83:19:2",588,"أَدْرَىٰكَ","can make you know","وَمَآ","مَا عِلِّيُّونَ",562],["86:2:2",591,"أَدْرَىٰكَ","can make you know","وَمَآ","مَا ٱلطَّارِقُ",562],["90:12:2",594,"أَدْرَىٰكَ","can make you know","وَمَآ","مَا ٱلْعَقَبَةُ",562],["97:2:2",598,"أَدْرَىٰكَ","can make you know","وَمَآ","مَا لَيْلَةُ ٱلْقَدْرِ",562],["101:3:2",600,"أَدْرَىٰكَ","will make you know","وَمَآ","مَا ٱلْقَارِعَةُ",562],["101:10:2",600,"أَدْرَىٰكَ","will make you know","وَمَآ","مَا هِيَهْ",562],["104:5:2",601,"أَدْرَىٰكَ","will make you know","وَمَآ","مَا ٱلْحُطَمَةُ",562]]