[["3:127:2",66,"طَرَفًۭا","a part","لِيَقْطَعَ","مِّنَ ٱلَّذِينَ كَفَرُوٓا۟",1315],["11:114:3",234,"طَرَفَىِ","(at the) two ends","وَأَقِمِ ٱلصَّلَوٰةَ","ٱلنَّهَارِ وَزُلَفًۭا مِّنَ",1315],["13:41:8",254,"أَطْرَافِهَا ۚ","its borders","ٱلْأَرْضَ نَنقُصُهَا مِنْ","وَٱللَّهُ يَحْكُمُ لَا",1315],["14:43:7",261,"طَرْفُهُمْ ۖ","their gaze","لَا يَرْتَدُّ إِلَيْهِمْ","وَأَفْـِٔدَتُهُمْ هَوَآءٌۭ",1161],["20:130:17",321,"وَأَطْرَافَ","(at the) ends","ءَانَآئِ ٱلَّيْلِ فَسَبِّحْ","ٱلنَّهَارِ لَعَلَّكَ تَرْضَىٰ",1315],["21:44:16",325,"أَطْرَافِهَآ ۚ","its borders","ٱلْأَرْضَ نَنقُصُهَا مِنْ","أَفَهُمُ ٱلْغَـٰلِبُونَ",1315],["27:40:14",380,"طَرْفُكَ ۚ","your glance","أَن يَرْتَدَّ إِلَيْكَ","فَلَمَّا رَءَاهُ مُسْتَقِرًّا",1161],["37:48:3",447,"ٱلطَّرْفِ","(will be) companions of modest gaze","وَعِندَهُمْ قَـٰصِرَٰتُ","عِينٌۭ",1161],["38:52:3",456,"ٱلطَّرْفِ","(will be) companions of modest gaze","۞ وَعِندَهُمْ قَـٰصِرَٰتُ","أَتْرَابٌ",1161],["42:45:9",488,"طَرْفٍ","a glance","ٱلذُّلِّ يَنظُرُونَ مِن","خَفِىٍّۢ ۗ وَقَالَ ٱلَّذِينَ",1161],["55:56:3",533,"ٱلطَّرْفِ","(will be) companions of modest gaze","فِيهِنَّ قَـٰصِرَٰتُ","لَمْ يَطْمِثْهُنَّ إِنسٌۭ",1161]]