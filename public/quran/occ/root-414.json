[["23:19:10",343,"فَوَٰكِهُ","(are) fruits","وَأَعْنَـٰبٍۢ لَّكُمْ فِيهَا","كَثِيرَةٌۭ وَمِنْهَا تَأْكُلُونَ",1833],["36:55:7",444,"فَـٰكِهُونَ","(in) amusement","ٱلْيَوْمَ فِى شُغُلٍۢ","",1827],["36:57:3",444,"فَـٰكِهَةٌۭ","(are) fruits","لَهُمْ فِيهَا","وَلَهُم مَّا يَدَّعُونَ",780],["37:42:1",447,"فَوَٰكِهُ ۖ","Fruits","","وَهُم مُّكْرَمُونَ",1833],["38:51:5",456,"بِفَـٰكِهَةٍۢ","for fruit","فِيهَا يَدْعُونَ فِيهَا","كَثِيرَةٍۢ وَشَرَابٍۢ",780],["43:73:3",494,"فَـٰكِهَةٌۭ","(are) fruits","لَكُمْ فِيهَا","كَثِيرَةٌۭ مِّنْهَا تَأْكُلُونَ",780],["44:27:4",497,"فَـٰكِهِينَ","take delight","وَنَعْمَةٍۢ كَانُوا۟ فِيهَا","",1827],["44:55:4",498,"فَـٰكِهَةٍ","(of) fruit","يَدْعُونَ فِيهَا بِكُلِّ","ءَامِنِينَ",780],["52:18:1",524,"فَـٰكِهِينَ","Enjoying","","بِمَآ ءَاتَىٰهُمْ رَبُّهُمْ",1827],["52:22:2",524,"بِفَـٰكِهَةٍۢ","with fruit","وَأَمْدَدْنَـٰهُم","وَلَحْمٍۢ مِّمَّا يَشْتَهُونَ",780],["55:11:2",531,"فَـٰكِهَةٌۭ","(is) fruit","فِيهَا","وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ",780],["55:52:4",533,"فَـٰكِهَةٍۢ","fruits","فِيهِمَا مِن كُلِّ","زَوْجَانِ",780],["55:68:2",533,"فَـٰكِهَةٌۭ","(are) fruits","فِيهِمَا","وَنَخْلٌۭ وَرُمَّانٌۭ",780],["56:20:1",535,"وَفَـٰكِهَةٍۢ","And fruits","","مِّمَّا يَتَخَيَّرُونَ",780],["56:32:1",535,"وَفَـٰكِهَةٍۢ","And fruit","","كَثِيرَةٍۢ",780],["56:65:6",536,"تَفَكَّهُونَ","wondering","لَجَعَلْنَـٰهُ حُطَـٰمًۭا فَظَلْتُمْ","",4366],["77:42:1",581,"وَفَوَٰكِهَ","And fruits","","مِمَّا يَشْتَهُونَ",1833],["80:31:1",585,"وَفَـٰكِهَةًۭ","And fruits","","وَأَبًّۭا",780],["83:31:6",588,"فَكِهِينَ","jesting","إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟","",3412]]