[["2:40:13",7,"فَٱرْهَبُونِ","fear [Me]","أُوفِ بِعَهْدِكُمْ وَإِيَّـٰىَ","",2062],["5:82:23",121,"وَرُهْبَانًۭا","and monks","بِأَنَّ مِنْهُمْ قِسِّيسِينَ","وَأَنَّهُمْ لَا يَسْتَكْبِرُونَ",1978],["7:116:8",164,"وَٱسْتَرْهَبُوهُمْ","and terrified them","سَحَرُوٓا۟ أَعْيُنَ ٱلنَّاسِ","وَجَآءُو بِسِحْرٍ عَظِيمٍۢ",4835],["7:154:15",169,"يَرْهَبُونَ","(are) fearful","لِّلَّذِينَ هُمْ لِرَبِّهِمْ","",2062],["8:60:10",184,"تُرْهِبُونَ","(to) terrify","وَمِن رِّبَاطِ ٱلْخَيْلِ","بِهِۦ عَدُوَّ ٱللَّهِ",4468],["9:31:3",191,"وَرُهْبَـٰنَهُمْ","and their monks","ٱتَّخَذُوٓا۟ أَحْبَارَهُمْ","أَرْبَابًۭا مِّن دُونِ",1978],["9:34:8",192,"وَٱلرُّهْبَانِ","and the monks","كَثِيرًۭا مِّنَ ٱلْأَحْبَارِ","لَيَأْكُلُونَ أَمْوَٰلَ ٱلنَّاسِ",1978],["16:51:12",272,"فَٱرْهَبُونِ","you fear [Me]","إِلَـٰهٌۭ وَٰحِدٌۭ ۖ فَإِيَّـٰىَ","",2062],["21:90:16",329,"وَرَهَبًۭا ۖ","and fear","ٱلْخَيْرَٰتِ وَيَدْعُونَنَا رَغَبًۭا","وَكَانُوا۟ لَنَا خَـٰشِعِينَ",4165],["28:32:14",389,"ٱلرَّهْبِ ۖ","fear","إِلَيْكَ جَنَاحَكَ مِنَ","فَذَٰنِكَ بُرْهَـٰنَانِ مِن",4214],["57:27:19",541,"وَرَهْبَانِيَّةً","But monasticism","ٱتَّبَعُوهُ رَأْفَةًۭ وَرَحْمَةًۭ","ٱبْتَدَعُوهَا مَا كَتَبْنَـٰهَا",4168],["59:13:3",547,"رَهْبَةًۭ","(in) fear","لَأَنتُمْ أَشَدُّ","فِى صُدُورِهِم مِّنَ",4169]]