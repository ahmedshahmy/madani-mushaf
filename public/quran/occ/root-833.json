[["10:61:4",215,"شَأْنٍۢ","any situation","وَمَا تَكُونُ فِى","وَمَا تَتْلُوا۟ مِنْهُ",1450],["24:62:28",359,"شَأْنِهِمْ","affair of theirs","فَإِذَا ٱسْتَـْٔذَنُوكَ لِبَعْضِ","فَأْذَن لِّمَن شِئْتَ",1450],["55:29:10",532,"شَأْنٍۢ","a matter","يَوْمٍ هُوَ فِى","",1450],["80:37:5",585,"شَأْنٌۭ","(will be) a matter","ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ","يُغْنِيهِ",1450]]