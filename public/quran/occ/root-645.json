[["9:84:11",200,"قَبْرِهِۦٓ ۖ","his grave","وَلَا تَقُمْ عَلَىٰ","إِنَّهُمْ كَفَرُوا۟ بِٱللَّهِ",1217],["22:7:12",333,"ٱلْقُبُورِ","the graves","يَبْعَثُ مَن فِى","",1217],["35:22:16",437,"ٱلْقُبُورِ","the graves","بِمُسْمِعٍۢ مَّن فِى","",1217],["60:13:19",551,"ٱلْقُبُورِ","(of) the graves","ٱلْكُفَّارُ مِنْ أَصْحَـٰبِ","",1217],["80:21:3",585,"فَأَقْبَرَهُۥ","and provides a grave for him","ثُمَّ أَمَاتَهُۥ","",3026],["82:4:2",587,"ٱلْقُبُورُ","the graves","وَإِذَا","بُعْثِرَتْ",1217],["100:9:7",600,"ٱلْقُبُورِ","the graves","بُعْثِرَ مَا فِى","",1217],["102:2:3",600,"ٱلْمَقَابِرَ","the graves","حَتَّىٰ زُرْتُمُ","",3692]]