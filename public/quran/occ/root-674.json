[["2:226:9",36,"فَآءُو","they return","أَرْبَعَةِ أَشْهُرٍۢ ۖ فَإِن","فَإِنَّ ٱللَّهَ غَفُورٌۭ",1823],["16:48:9",272,"يَتَفَيَّؤُا۟","Incline","ٱللَّهُ مِن شَىْءٍۢ","ظِلَـٰلُهُۥ عَنِ ٱلْيَمِينِ",4675],["33:50:14",424,"أَفَآءَ","Allah has given","مَلَكَتْ يَمِينُكَ مِمَّآ","ٱللَّهُ عَلَيْكَ وَبَنَاتِ",1731],["49:9:17",516,"تَفِىٓءَ","it returns","ٱلَّتِى تَبْغِى حَتَّىٰ","إِلَىٰٓ أَمْرِ ٱللَّهِ ۚ",1823],["49:9:22",516,"فَآءَتْ","it returns","أَمْرِ ٱللَّهِ ۚ فَإِن","فَأَصْلِحُوا۟ بَيْنَهُمَا بِٱلْعَدْلِ",1823],["59:6:2",546,"أَفَآءَ","(was) restored","وَمَآ","ٱللَّهُ عَلَىٰ رَسُولِهِۦ",1731],["59:7:2",546,"أَفَآءَ","(was) restored","مَّآ","ٱللَّهُ عَلَىٰ رَسُولِهِۦ",1731]]