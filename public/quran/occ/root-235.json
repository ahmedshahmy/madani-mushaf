[["2:260:28",44,"جَبَلٍۢ","hill","ٱجْعَلْ عَلَىٰ كُلِّ","مِّنْهُنَّ جُزْءًۭا ثُمَّ",302],["7:74:16",160,"ٱلْجِبَالَ","the mountains","سُهُولِهَا قُصُورًۭا وَتَنْحِتُونَ","بُيُوتًۭا ۖ فَٱذْكُرُوٓا۟ ءَالَآءَ",302],["7:143:18",167,"ٱلْجَبَلِ","the mountain","وَلَـٰكِنِ ٱنظُرْ إِلَى","فَإِنِ ٱسْتَقَرَّ مَكَانَهُۥ",302],["7:143:27",167,"لِلْجَبَلِ","to the mountain","فَلَمَّا تَجَلَّىٰ رَبُّهُۥ","جَعَلَهُۥ دَكًّۭا وَخَرَّ",302],["7:171:3",173,"ٱلْجَبَلَ","the mountain","۞ وَإِذْ نَتَقْنَا","فَوْقَهُمْ كَأَنَّهُۥ ظُلَّةٌۭ",302],["11:42:6",226,"كَٱلْجِبَالِ","like mountains","بِهِمْ فِى مَوْجٍۢ","وَنَادَىٰ نُوحٌ ٱبْنَهُۥ",302],["11:43:4",226,"جَبَلٍۢ","a mountain","قَالَ سَـَٔاوِىٓ إِلَىٰ","يَعْصِمُنِى مِنَ ٱلْمَآءِ ۚ",302],["13:31:6",253,"ٱلْجِبَالُ","the mountains","قُرْءَانًۭا سُيِّرَتْ بِهِ","أَوْ قُطِّعَتْ بِهِ",302],["14:46:12",261,"ٱلْجِبَالُ","the mountains","مَكْرُهُمْ لِتَزُولَ مِنْهُ","",302],["15:82:4",266,"ٱلْجِبَالِ","the mountains","وَكَانُوا۟ يَنْحِتُونَ مِنَ","بُيُوتًا ءَامِنِينَ",302],["16:68:8",274,"ٱلْجِبَالِ","the mountains","أَنِ ٱتَّخِذِى مِنَ","بُيُوتًۭا وَمِنَ ٱلشَّجَرِ",302],["16:81:10",276,"ٱلْجِبَالِ","the mountains","وَجَعَلَ لَكُم مِّنَ","أَكْنَـٰنًۭا وَجَعَلَ لَكُمْ",302],["17:37:12",285,"ٱلْجِبَالَ","the mountains","ٱلْأَرْضَ وَلَن تَبْلُغَ","طُولًۭا",302],["18:47:3",299,"ٱلْجِبَالَ","the mountains","وَيَوْمَ نُسَيِّرُ","وَتَرَى ٱلْأَرْضَ بَارِزَةًۭ",302],["19:90:8",311,"ٱلْجِبَالُ","the mountain","وَتَنشَقُّ ٱلْأَرْضُ وَتَخِرُّ","هَدًّا",302],["20:105:3",319,"ٱلْجِبَالِ","the mountains","وَيَسْـَٔلُونَكَ عَنِ","فَقُلْ يَنسِفُهَا رَبِّى",302],["21:79:10",328,"ٱلْجِبَالَ","the mountains","وَسَخَّرْنَا مَعَ دَاوُۥدَ","يُسَبِّحْنَ وَٱلطَّيْرَ ۚ وَكُنَّا",302],["22:18:16",334,"وَٱلْجِبَالُ","and the mountains","وَٱلشَّمْسُ وَٱلْقَمَرُ وَٱلنُّجُومُ","وَٱلشَّجَرُ وَٱلدَّوَآبُّ وَكَثِيرٌۭ",302],["24:43:22",355,"جِبَالٍۢ","mountains","مِنَ ٱلسَّمَآءِ مِن","فِيهَا مِنۢ بَرَدٍۢ",302],["26:149:3",373,"ٱلْجِبَالِ","the mountains","وَتَنْحِتُونَ مِنَ","بُيُوتًۭا فَـٰرِهِينَ",302],["26:184:4",375,"وَٱلْجِبِلَّةَ","and the generations","وَٱتَّقُوا۟ ٱلَّذِى خَلَقَكُمْ","ٱلْأَوَّلِينَ",2403],["27:88:2",384,"ٱلْجِبَالَ","the mountains","وَتَرَى","تَحْسَبُهَا جَامِدَةًۭ وَهِىَ",302],["33:72:7",427,"وَٱلْجِبَالِ","and the mountains","عَلَى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","فَأَبَيْنَ أَن يَحْمِلْنَهَا",302],["34:10:6",429,"يَـٰجِبَالُ","O mountains","دَاوُۥدَ مِنَّا فَضْلًۭا ۖ","أَوِّبِى مَعَهُۥ وَٱلطَّيْرَ ۖ",302],["35:27:15",437,"ٱلْجِبَالِ","the mountains","مُّخْتَلِفًا أَلْوَٰنُهَا ۚ وَمِنَ","جُدَدٌۢ بِيضٌۭ وَحُمْرٌۭ",302],["36:62:4",444,"جِبِلًّۭا","a multitude","وَلَقَدْ أَضَلَّ مِنكُمْ","كَثِيرًا ۖ أَفَلَمْ تَكُونُوا۟",2403],["38:18:3",454,"ٱلْجِبَالَ","the mountains","إِنَّا سَخَّرْنَا","مَعَهُۥ يُسَبِّحْنَ بِٱلْعَشِىِّ",302],["52:10:2",523,"ٱلْجِبَالُ","the mountains","وَتَسِيرُ","سَيْرًۭا",302],["56:5:2",534,"ٱلْجِبَالُ","the mountains","وَبُسَّتِ","بَسًّۭا",302],["59:21:6",548,"جَبَلٍۢ","a mountain","هَـٰذَا ٱلْقُرْءَانَ عَلَىٰ","لَّرَأَيْتَهُۥ خَـٰشِعًۭا مُّتَصَدِّعًۭا",302],["69:14:3",567,"وَٱلْجِبَالُ","and the mountains","وَحُمِلَتِ ٱلْأَرْضُ","فَدُكَّتَا دَكَّةًۭ وَٰحِدَةًۭ",302],["70:9:2",568,"ٱلْجِبَالُ","the mountains","وَتَكُونُ","كَٱلْعِهْنِ",302],["73:14:4",574,"وَٱلْجِبَالُ","and the mountains","يَوْمَ تَرْجُفُ ٱلْأَرْضُ","وَكَانَتِ ٱلْجِبَالُ كَثِيبًۭا",302],["73:14:6",574,"ٱلْجِبَالُ","the mountains","ٱلْأَرْضُ وَٱلْجِبَالُ وَكَانَتِ","كَثِيبًۭا مَّهِيلًا",302],["77:10:2",580,"ٱلْجِبَالُ","the mountains","وَإِذَا","نُسِفَتْ",302],["78:7:1",582,"وَٱلْجِبَالَ","And the mountains","","أَوْتَادًۭا",302],["78:20:2",582,"ٱلْجِبَالُ","the mountains","وَسُيِّرَتِ","فَكَانَتْ سَرَابًا",302],["79:32:1",584,"وَٱلْجِبَالَ","And the mountains","","أَرْسَىٰهَا",302],["81:3:2",586,"ٱلْجِبَالُ","the mountains","وَإِذَا","سُيِّرَتْ",302],["88:19:2",592,"ٱلْجِبَالِ","the mountains","وَإِلَى","كَيْفَ نُصِبَتْ",302],["101:5:2",600,"ٱلْجِبَالُ","the mountains","وَتَكُونُ","كَٱلْعِهْنِ ٱلْمَنفُوشِ",302]]