[["2:27:10",5,"أَمَرَ","has ordered","مِيثَـٰقِهِۦ وَيَقْطَعُونَ مَآ","ٱللَّهُ بِهِۦٓ أَن",147],["2:44:1",7,"۞ أَتَأْمُرُونَ","Do you order","","ٱلنَّاسَ بِٱلْبِرِّ وَتَنسَوْنَ",147],["2:67:7",10,"يَأْمُرُكُمْ","commands you","لِقَوْمِهِۦٓ إِنَّ ٱللَّهَ","أَن تَذْبَحُوا۟ بَقَرَةًۭ ۖ",147],["2:68:23",10,"تُؤْمَرُونَ","you are commanded","ذَٰلِكَ ۖ فَٱفْعَلُوا۟ مَا","",147],["2:93:22",14,"يَأْمُرُكُم","orders you (to do) it","بِكُفْرِهِمْ ۚ قُلْ بِئْسَمَا","بِهِۦٓ إِيمَـٰنُكُمْ إِن",147],["2:109:27",17,"بِأَمْرِهِۦٓ ۗ","His Command","حَتَّىٰ يَأْتِىَ ٱللَّهُ","إِنَّ ٱللَّهَ عَلَىٰ",66],["2:117:6",18,"أَمْرًۭا","a matter","وَٱلْأَرْضِ ۖ وَإِذَا قَضَىٰٓ","فَإِنَّمَا يَقُولُ لَهُۥ",66],["2:169:2",25,"يَأْمُرُكُم","he commands you","إِنَّمَا","بِٱلسُّوٓءِ وَٱلْفَحْشَآءِ وَأَن",147],["2:210:13",32,"ٱلْأَمْرُ ۚ","the matter","ٱلْغَمَامِ وَٱلْمَلَـٰٓئِكَةُ وَقُضِىَ","وَإِلَى ٱللَّهِ تُرْجَعُ",66],["2:210:17",32,"ٱلْأُمُورُ","(all) the matters","وَإِلَى ٱللَّهِ تُرْجَعُ","",66],["2:222:20",35,"أَمَرَكُمُ","has ordered you","فَأْتُوهُنَّ مِنْ حَيْثُ","ٱللَّهُ ۚ إِنَّ ٱللَّهَ",147],["2:268:4",45,"وَيَأْمُرُكُم","and orders you","ٱلشَّيْطَـٰنُ يَعِدُكُمُ ٱلْفَقْرَ","بِٱلْفَحْشَآءِ ۖ وَٱللَّهُ يَعِدُكُم",147],["2:275:35",47,"وَأَمْرُهُۥٓ","and his case","فَلَهُۥ مَا سَلَفَ","إِلَى ٱللَّهِ ۖ وَمَنْ",66],["3:21:12",52,"يَأْمُرُونَ","order","حَقٍّۢ وَيَقْتُلُونَ ٱلَّذِينَ","بِٱلْقِسْطِ مِنَ ٱلنَّاسِ",147],["3:47:18",56,"أَمْرًۭا","a matter","يَشَآءُ ۚ إِذَا قَضَىٰٓ","فَإِنَّمَا يَقُولُ لَهُۥ",66],["3:80:2",60,"يَأْمُرَكُمْ","he will order you","وَلَا","أَن تَتَّخِذُوا۟ ٱلْمَلَـٰٓئِكَةَ",147],["3:80:8",60,"أَيَأْمُرُكُم","Would he order you","ٱلْمَلَـٰٓئِكَةَ وَٱلنَّبِيِّـۧنَ أَرْبَابًا ۗ","بِٱلْكُفْرِ بَعْدَ إِذْ",147],["3:104:7",63,"وَيَأْمُرُونَ","[and] enjoining","يَدْعُونَ إِلَى ٱلْخَيْرِ","بِٱلْمَعْرُوفِ وَيَنْهَوْنَ عَنِ",147],["3:109:11",64,"ٱلْأُمُورُ","the matters","وَإِلَى ٱللَّهِ تُرْجَعُ","",66],["3:110:6",64,"تَأْمُرُونَ","enjoining","أُمَّةٍ أُخْرِجَتْ لِلنَّاسِ","بِٱلْمَعْرُوفِ وَتَنْهَوْنَ عَنِ",147],["3:114:5",64,"وَيَأْمُرُونَ","and they enjoin","بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ","بِٱلْمَعْرُوفِ وَيَنْهَوْنَ عَنِ",147],["3:128:4",66,"ٱلْأَمْرِ","the decision","لَيْسَ لَكَ مِنَ","شَىْءٌ أَوْ يَتُوبَ",66],["3:147:13",68,"أَمْرِنَا","our affairs","ذُنُوبَنَا وَإِسْرَافَنَا فِىٓ","وَثَبِّتْ أَقْدَامَنَا وَٱنصُرْنَا",66],["3:152:13",69,"ٱلْأَمْرِ","the order","فَشِلْتُمْ وَتَنَـٰزَعْتُمْ فِى","وَعَصَيْتُم مِّنۢ بَعْدِ",66],["3:154:26",70,"ٱلْأَمْرِ","the matter","هَل لَّنَا مِنَ","مِن شَىْءٍۢ ۗ قُلْ",66],["3:154:31",70,"ٱلْأَمْرَ","the matter","شَىْءٍۢ ۗ قُلْ إِنَّ","كُلَّهُۥ لِلَّهِ ۗ يُخْفُونَ",66],["3:154:46",70,"ٱلْأَمْرِ","the matter","كَانَ لَنَا مِنَ","شَىْءٌۭ مَّا قُتِلْنَا",66],["3:159:21",71,"ٱلْأَمْرِ ۖ","the matter","لَهُمْ وَشَاوِرْهُمْ فِى","فَإِذَا عَزَمْتَ فَتَوَكَّلْ",66],["3:186:24",74,"ٱلْأُمُورِ","(of) determination","ذَٰلِكَ مِنْ عَزْمِ","",66],["4:37:3",84,"وَيَأْمُرُونَ","and order","ٱلَّذِينَ يَبْخَلُونَ","ٱلنَّاسَ بِٱلْبُخْلِ وَيَكْتُمُونَ",147],["4:47:26",86,"أَمْرُ","(the) command","أَصْحَـٰبَ ٱلسَّبْتِ ۚ وَكَانَ","ٱللَّهِ مَفْعُولًا",66],["4:58:3",87,"يَأْمُرُكُمْ","orders you","۞ إِنَّ ٱللَّهَ","أَن تُؤَدُّوا۟ ٱلْأَمَـٰنَـٰتِ",147],["4:59:9",87,"ٱلْأَمْرِ","(having) authority","وَأَطِيعُوا۟ ٱلرَّسُولَ وَأُو۟لِى","مِنكُمْ ۖ فَإِن تَنَـٰزَعْتُمْ",66],["4:60:21",88,"أُمِرُوٓا۟","they were ordered","إِلَى ٱلطَّـٰغُوتِ وَقَدْ","أَن يَكْفُرُوا۟ بِهِۦ",147],["4:83:3",91,"أَمْرٌۭ","a matter","وَإِذَا جَآءَهُمْ","مِّنَ ٱلْأَمْنِ أَوِ",66],["4:83:16",91,"ٱلْأَمْرِ","(having) authority","ٱلرَّسُولِ وَإِلَىٰٓ أُو۟لِى","مِنْهُمْ لَعَلِمَهُ ٱلَّذِينَ",66],["4:114:9",97,"أَمَرَ","orders","نَّجْوَىٰهُمْ إِلَّا مَنْ","بِصَدَقَةٍ أَوْ مَعْرُوفٍ",147],["4:119:3",97,"وَلَـَٔامُرَنَّهُمْ","and surely I will order them","وَلَأُضِلَّنَّهُمْ وَلَأُمَنِّيَنَّهُمْ","فَلَيُبَتِّكُنَّ ءَاذَانَ ٱلْأَنْعَـٰمِ",147],["4:119:7",97,"وَلَـَٔامُرَنَّهُمْ","and surely I will order them","فَلَيُبَتِّكُنَّ ءَاذَانَ ٱلْأَنْعَـٰمِ","فَلَيُغَيِّرُنَّ خَلْقَ ٱللَّهِ ۚ",147],["5:52:19",117,"أَمْرٍۢ","a decision","يَأْتِىَ بِٱلْفَتْحِ أَوْ","مِّنْ عِندِهِۦ فَيُصْبِحُوا۟",66],["5:95:37",123,"أَمْرِهِۦ ۗ","(of) his deed","صِيَامًۭا لِّيَذُوقَ وَبَالَ","عَفَا ٱللَّهُ عَمَّا",66],["5:117:6",127,"أَمَرْتَنِى","You commanded me","لَهُمْ إِلَّا مَآ","بِهِۦٓ أَنِ ٱعْبُدُوا۟",147],["6:8:10",128,"ٱلْأَمْرُ","the matter","أَنزَلْنَا مَلَكًۭا لَّقُضِىَ","ثُمَّ لَا يُنظَرُونَ",66],["6:14:15",129,"أُمِرْتُ","[I] am commanded","يُطْعَمُ ۗ قُلْ إِنِّىٓ","أَنْ أَكُونَ أَوَّلَ",147],["6:58:9",134,"ٱلْأَمْرُ","the matter","تَسْتَعْجِلُونَ بِهِۦ لَقُضِىَ","بَيْنِى وَبَيْنَكُمْ ۗ وَٱللَّهُ",66],["6:71:36",136,"وَأُمِرْنَا","and we have been commanded","ٱللَّهِ هُوَ ٱلْهُدَىٰ ۖ","لِنُسْلِمَ لِرَبِّ ٱلْعَـٰلَمِينَ",147],["6:159:12",150,"أَمْرُهُمْ","their affair","فِى شَىْءٍ ۚ إِنَّمَآ","إِلَى ٱللَّهِ ثُمَّ",66],["6:163:5",150,"أُمِرْتُ","I have been commanded","شَرِيكَ لَهُۥ ۖ وَبِذَٰلِكَ","وَأَنَا۠ أَوَّلُ ٱلْمُسْلِمِينَ",147],["7:12:7",152,"أَمَرْتُكَ ۖ","I commanded you","أَلَّا تَسْجُدَ إِذْ","قَالَ أَنَا۠ خَيْرٌۭ",147],["7:28:9",153,"أَمَرَنَا","(has) ordered us","عَلَيْهَآ ءَابَآءَنَا وَٱللَّهُ","بِهَا ۗ قُلْ إِنَّ",147],["7:28:15",153,"يَأْمُرُ","order","إِنَّ ٱللَّهَ لَا","بِٱلْفَحْشَآءِ ۖ أَتَقُولُونَ عَلَى",147],["7:29:2",153,"أَمَرَ","(Has been) ordered","قُلْ","رَبِّى بِٱلْقِسْطِ ۖ وَأَقِيمُوا۟",147],["7:54:24",157,"بِأَمْرِهِۦٓ ۗ","by His command","وَٱلْقَمَرَ وَٱلنُّجُومَ مُسَخَّرَٰتٍۭ","أَلَا لَهُ ٱلْخَلْقُ",66],["7:54:28",157,"وَٱلْأَمْرُ ۗ","and the command","أَلَا لَهُ ٱلْخَلْقُ","تَبَارَكَ ٱللَّهُ رَبُّ",66],["7:77:5",160,"أَمْرِ","(the) command","ٱلنَّاقَةَ وَعَتَوْا۟ عَنْ","رَبِّهِمْ وَقَالُوا۟ يَـٰصَـٰلِحُ",66],["7:110:7",164,"تَأْمُرُونَ","(do) you instruct","مِّنْ أَرْضِكُمْ ۖ فَمَاذَا","",147],["7:145:14",168,"وَأْمُرْ","and order","شَىْءٍۢ فَخُذْهَا بِقُوَّةٍۢ","قَوْمَكَ يَأْخُذُوا۟ بِأَحْسَنِهَا ۚ",147],["7:150:14",169,"أَمْرَ","(over the) matter","مِنۢ بَعْدِىٓ ۖ أَعَجِلْتُمْ","رَبِّكُمْ ۖ وَأَلْقَى ٱلْأَلْوَاحَ",66],["7:157:13",170,"يَأْمُرُهُم","He commands them","فِى ٱلتَّوْرَىٰةِ وَٱلْإِنجِيلِ","بِٱلْمَعْرُوفِ وَيَنْهَىٰهُمْ عَنِ",147],["7:199:3",176,"وَأْمُرْ","and enjoin","خُذِ ٱلْعَفْوَ","بِٱلْعُرْفِ وَأَعْرِضْ عَنِ",147],["8:42:19",182,"أَمْرًۭا","a matter","وَلَـٰكِن لِّيَقْضِىَ ٱللَّهُ","كَانَ مَفْعُولًۭا لِّيَهْلِكَ",66],["8:43:13",182,"ٱلْأَمْرِ","the matter","لَّفَشِلْتُمْ وَلَتَنَـٰزَعْتُمْ فِى","وَلَـٰكِنَّ ٱللَّهَ سَلَّمَ ۗ",66],["8:44:13",182,"أَمْرًۭا","a matter","أَعْيُنِهِمْ لِيَقْضِىَ ٱللَّهُ","كَانَ مَفْعُولًۭا ۗ وَإِلَى",66],["8:44:19",182,"ٱلْأُمُورُ","(all) the matters","وَإِلَى ٱللَّهِ تُرْجَعُ","",66],["9:24:28",190,"بِأَمْرِهِۦ ۗ","His Command","حَتَّىٰ يَأْتِىَ ٱللَّهُ","وَٱللَّهُ لَا يَهْدِى",66],["9:31:12",191,"أُمِرُوٓا۟","they were commanded","ٱبْنَ مَرْيَمَ وَمَآ","إِلَّا لِيَعْبُدُوٓا۟ إِلَـٰهًۭا",147],["9:48:8",195,"ٱلْأُمُورَ","the matters","قَبْلُ وَقَلَّبُوا۟ لَكَ","حَتَّىٰ جَآءَ ٱلْحَقُّ",66],["9:48:13",195,"أَمْرُ","(the) Order of Allah","جَآءَ ٱلْحَقُّ وَظَهَرَ","ٱللَّهِ وَهُمْ كَـٰرِهُونَ",66],["9:50:11",195,"أَمْرَنَا","our matter","يَقُولُوا۟ قَدْ أَخَذْنَآ","مِن قَبْلُ وَيَتَوَلَّوا۟",66],["9:67:6",197,"يَأْمُرُونَ","They enjoin","بَعْضُهُم مِّنۢ بَعْضٍۢ ۚ","بِٱلْمُنكَرِ وَيَنْهَوْنَ عَنِ",147],["9:71:6",198,"يَأْمُرُونَ","They enjoin","بَعْضُهُمْ أَوْلِيَآءُ بَعْضٍۢ ۚ","بِٱلْمَعْرُوفِ وَيَنْهَوْنَ عَنِ",147],["9:106:3",203,"لِأَمْرِ","for the Command of Allah","وَءَاخَرُونَ مُرْجَوْنَ","ٱللَّهِ إِمَّا يُعَذِّبُهُمْ",66],["9:112:7",205,"ٱلْـَٔامِرُونَ","those who enjoin","ٱلسَّـٰٓئِحُونَ ٱلرَّٰكِعُونَ ٱلسَّـٰجِدُونَ","بِٱلْمَعْرُوفِ وَٱلنَّاهُونَ عَنِ",2906],["10:3:16",208,"ٱلْأَمْرَ ۖ","the affairs","عَلَى ٱلْعَرْشِ ۖ يُدَبِّرُ","مَا مِن شَفِيعٍ",66],["10:24:29",211,"أَمْرُنَا","Our command","قَـٰدِرُونَ عَلَيْهَآ أَتَىٰهَآ","لَيْلًا أَوْ نَهَارًۭا",66],["10:31:22",212,"ٱلْأَمْرَ ۚ","the affairs","ٱلْحَىِّ وَمَن يُدَبِّرُ","فَسَيَقُولُونَ ٱللَّهُ ۚ فَقُلْ",66],["10:71:21",217,"أَمْرَكُمْ","your plan","ٱللَّهِ تَوَكَّلْتُ فَأَجْمِعُوٓا۟","وَشُرَكَآءَكُمْ ثُمَّ لَا",66],["10:71:26",217,"أَمْرُكُمْ","(in) your plan","ثُمَّ لَا يَكُنْ","عَلَيْكُمْ غُمَّةًۭ ثُمَّ",66],["10:72:12",217,"وَأُمِرْتُ","and I have been commanded","إِلَّا عَلَى ٱللَّهِ ۖ","أَنْ أَكُونَ مِنَ",147],["10:104:22",220,"وَأُمِرْتُ","And I am commanded","ٱللَّهَ ٱلَّذِى يَتَوَفَّىٰكُمْ ۖ","أَنْ أَكُونَ مِنَ",147],["11:40:4",226,"أَمْرُنَا","Our command","حَتَّىٰٓ إِذَا جَآءَ","وَفَارَ ٱلتَّنُّورُ قُلْنَا",66],["11:43:13",226,"أَمْرِ","the Command of Allah","عَاصِمَ ٱلْيَوْمَ مِنْ","ٱللَّهِ إِلَّا مَن",66],["11:44:10",226,"ٱلْأَمْرُ","the Command","وَغِيضَ ٱلْمَآءُ وَقُضِىَ","وَٱسْتَوَتْ عَلَى ٱلْجُودِىِّ ۖ",66],["11:58:3",228,"أَمْرُنَا","Our command","وَلَمَّا جَآءَ","نَجَّيْنَا هُودًۭا وَٱلَّذِينَ",66],["11:59:9",228,"أَمْرَ","(the) command","وَعَصَوْا۟ رُسُلَهُۥ وَٱتَّبَعُوٓا۟","كُلِّ جَبَّارٍ عَنِيدٍۢ",66],["11:66:3",229,"أَمْرُنَا","Our command","فَلَمَّا جَآءَ","نَجَّيْنَا صَـٰلِحًۭا وَٱلَّذِينَ",66],["11:73:4",230,"أَمْرِ","(the) decree of Allah","قَالُوٓا۟ أَتَعْجَبِينَ مِنْ","ٱللَّهِ ۖ رَحْمَتُ ٱللَّهِ",66],["11:76:8",230,"أَمْرُ","(the) Command","إِنَّهُۥ قَدْ جَآءَ","رَبِّكَ ۖ وَإِنَّهُمْ ءَاتِيهِمْ",66],["11:82:3",231,"أَمْرُنَا","Our Command","فَلَمَّا جَآءَ","جَعَلْنَا عَـٰلِيَهَا سَافِلَهَا",66],["11:87:4",231,"تَأْمُرُكَ","command you","قَالُوا۟ يَـٰشُعَيْبُ أَصَلَوٰتُكَ","أَن نَّتْرُكَ مَا",147],["11:94:3",232,"أَمْرُنَا","Our Command","وَلَمَّا جَآءَ","نَجَّيْنَا شُعَيْبًۭا وَٱلَّذِينَ",66],["11:97:5",232,"أَمْرَ","(the) command of Firaun","فِرْعَوْنَ وَمَلَإِي۟هِۦ فَٱتَّبَعُوٓا۟","فِرْعَوْنَ ۖ وَمَآ أَمْرُ",66],["11:97:8",232,"أَمْرُ","(the) command of Firaun","أَمْرَ فِرْعَوْنَ ۖ وَمَآ","فِرْعَوْنَ بِرَشِيدٍۢ",66],["11:101:19",233,"أَمْرُ","(the) command (of) your Lord","شَىْءٍۢ لَّمَّا جَآءَ","رَبِّكَ ۖ وَمَا زَادُوهُمْ",66],["11:112:3",234,"أُمِرْتَ","you are commanded","فَٱسْتَقِمْ كَمَآ","وَمَن تَابَ مَعَكَ",147],["11:123:7",235,"ٱلْأَمْرُ","the matter","وَٱلْأَرْضِ وَإِلَيْهِ يُرْجَعُ","كُلُّهُۥ فَٱعْبُدْهُ وَتَوَكَّلْ",66],["12:15:13",237,"بِأَمْرِهِمْ","about this affair","وَأَوْحَيْنَآ إِلَيْهِ لَتُنَبِّئَنَّهُم","هَـٰذَا وَهُمْ لَا",66],["12:18:11",237,"أَمْرًۭا ۖ","(to) a matter","سَوَّلَتْ لَكُمْ أَنفُسُكُمْ","فَصَبْرٌۭ جَمِيلٌۭ ۖ وَٱللَّهُ",66],["12:21:27",237,"أَمْرِهِۦ","His affairs","وَٱللَّهُ غَالِبٌ عَلَىٰٓ","وَلَـٰكِنَّ أَكْثَرَ ٱلنَّاسِ",66],["12:32:15",239,"ءَامُرُهُۥ","I order him","لَّمْ يَفْعَلْ مَآ","لَيُسْجَنَنَّ وَلَيَكُونًۭا مِّنَ",147],["12:40:20",240,"أَمَرَ","He has commanded","ٱلْحُكْمُ إِلَّا لِلَّهِ ۚ","أَلَّا تَعْبُدُوٓا۟ إِلَّآ",147],["12:41:16",240,"ٱلْأَمْرُ","the matter","مِن رَّأْسِهِۦ ۚ قُضِىَ","ٱلَّذِى فِيهِ تَسْتَفْتِيَانِ",66],["12:53:6",242,"لَأَمَّارَةٌۢ","(is) a certain enjoiner","نَفْسِىٓ ۚ إِنَّ ٱلنَّفْسَ","بِٱلسُّوٓءِ إِلَّا مَا",3017],["12:68:5",243,"أَمَرَهُمْ","ordered them","دَخَلُوا۟ مِنْ حَيْثُ","أَبُوهُم مَّا كَانَ",147],["12:83:6",245,"أَمْرًۭا ۖ","something","سَوَّلَتْ لَكُمْ أَنفُسُكُمْ","فَصَبْرٌۭ جَمِيلٌ ۖ عَسَى",66],["12:102:12",247,"أَمْرَهُمْ","their plan","لَدَيْهِمْ إِذْ أَجْمَعُوٓا۟","وَهُمْ يَمْكُرُونَ",66],["13:2:20",249,"ٱلْأَمْرَ","the matter","لِأَجَلٍۢ مُّسَمًّۭى ۚ يُدَبِّرُ","يُفَصِّلُ ٱلْـَٔايَـٰتِ لَعَلَّكُم",66],["13:11:10",250,"أَمْرِ","(the) command","خَلْفِهِۦ يَحْفَظُونَهُۥ مِنْ","ٱللَّهِ ۗ إِنَّ ٱللَّهَ",66],["13:21:4",252,"أَمَرَ","(has been) commanded","وَٱلَّذِينَ يَصِلُونَ مَآ","ٱللَّهُ بِهِۦٓ أَن",147],["13:25:10",252,"أَمَرَ","(has been) commanded","مِيثَـٰقِهِۦ وَيَقْطَعُونَ مَآ","ٱللَّهُ بِهِۦٓ أَن",147],["13:31:17",253,"ٱلْأَمْرُ","(is) the command","ٱلْمَوْتَىٰ ۗ بَل لِّلَّهِ","جَمِيعًا ۗ أَفَلَمْ يَا۟يْـَٔسِ",66],["13:36:15",254,"أُمِرْتُ","I have been commanded","بَعْضَهُۥ ۚ قُلْ إِنَّمَآ","أَنْ أَعْبُدَ ٱللَّهَ",147],["14:22:5",258,"ٱلْأَمْرُ","the matter","ٱلشَّيْطَـٰنُ لَمَّا قُضِىَ","إِنَّ ٱللَّهَ وَعَدَكُمْ",66],["14:32:22",259,"بِأَمْرِهِۦ ۖ","by His command","لِتَجْرِىَ فِى ٱلْبَحْرِ","وَسَخَّرَ لَكُمُ ٱلْأَنْهَـٰرَ",66],["15:65:14",265,"تُؤْمَرُونَ","you are ordered","أَحَدٌۭ وَٱمْضُوا۟ حَيْثُ","",147],["15:66:4",265,"ٱلْأَمْرَ","the matter","وَقَضَيْنَآ إِلَيْهِ ذَٰلِكَ","أَنَّ دَابِرَ هَـٰٓؤُلَآءِ",66],["15:94:3",267,"تُؤْمَرُ","you are ordered","فَٱصْدَعْ بِمَا","وَأَعْرِضْ عَنِ ٱلْمُشْرِكِينَ",147],["16:1:2",267,"أَمْرُ","(the) command of Allah","أَتَىٰٓ","ٱللَّهِ فَلَا تَسْتَعْجِلُوهُ ۚ",66],["16:2:5",267,"أَمْرِهِۦ","His Command","ٱلْمَلَـٰٓئِكَةَ بِٱلرُّوحِ مِنْ","عَلَىٰ مَن يَشَآءُ",66],["16:12:9",268,"بِأَمْرِهِۦٓ ۗ","by His command","وَٱلْقَمَرَ ۖ وَٱلنُّجُومُ مُسَخَّرَٰتٌۢ","إِنَّ فِى ذَٰلِكَ",66],["16:33:9",270,"أَمْرُ","(the) Command","ٱلْمَلَـٰٓئِكَةُ أَوْ يَأْتِىَ","رَبِّكَ ۚ كَذَٰلِكَ فَعَلَ",66],["16:50:7",272,"يُؤْمَرُونَ ۩","they are commanded","فَوْقِهِمْ وَيَفْعَلُونَ مَا","",147],["16:76:24",275,"يَأْمُرُ","commands","يَسْتَوِى هُوَ وَمَن","بِٱلْعَدْلِ ۙ وَهُوَ عَلَىٰ",147],["16:77:6",275,"أَمْرُ","(is the) matter","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَمَآ","ٱلسَّاعَةِ إِلَّا كَلَمْحِ",66],["16:90:3",277,"يَأْمُرُ","commands","۞ إِنَّ ٱللَّهَ","بِٱلْعَدْلِ وَٱلْإِحْسَـٰنِ وَإِيتَآئِ",147],["17:16:6",283,"أَمَرْنَا","We order","أَن نُّهْلِكَ قَرْيَةً","مُتْرَفِيهَا فَفَسَقُوا۟ فِيهَا",147],["17:85:7",290,"أَمْرِ","(the) affair","قُلِ ٱلرُّوحُ مِنْ","رَبِّى وَمَآ أُوتِيتُم",66],["18:10:15",294,"أَمْرِنَا","our affair","وَهَيِّئْ لَنَا مِنْ","رَشَدًۭا",66],["18:16:18",295,"أَمْرِكُم","your affair","وَيُهَيِّئْ لَكُم مِّنْ","مِّرْفَقًۭا",66],["18:21:17",296,"أَمْرَهُمْ ۖ","about their affair","إِذْ يَتَنَـٰزَعُونَ بَيْنَهُمْ","فَقَالُوا۟ ٱبْنُوا۟ عَلَيْهِم",66],["18:21:29",296,"أَمْرِهِمْ","their matter","ٱلَّذِينَ غَلَبُوا۟ عَلَىٰٓ","لَنَتَّخِذَنَّ عَلَيْهِم مَّسْجِدًۭا",66],["18:28:29",297,"أَمْرُهُۥ","his affair","وَٱتَّبَعَ هَوَىٰهُ وَكَانَ","فُرُطًۭا",66],["18:50:14",299,"أَمْرِ","the Command","ٱلْجِنِّ فَفَسَقَ عَنْ","رَبِّهِۦٓ ۗ أَفَتَتَّخِذُونَهُۥ وَذُرِّيَّتَهُۥٓ",66],["18:69:10",301,"أَمْرًۭا","order","وَلَآ أَعْصِى لَكَ","",66],["18:71:15",301,"إِمْرًۭا","grave","لَقَدْ جِئْتَ شَيْـًٔا","",2930],["18:73:9",301,"أَمْرِى","my affair","وَلَا تُرْهِقْنِى مِنْ","عُسْرًۭا",66],["18:82:28",302,"أَمْرِى ۚ","my (own) accord","وَمَا فَعَلْتُهُۥ عَنْ","ذَٰلِكَ تَأْوِيلُ مَا",66],["18:88:12",303,"أَمْرِنَا","our command","وَسَنَقُولُ لَهُۥ مِنْ","يُسْرًۭا",66],["19:21:14",306,"أَمْرًۭا","a matter","وَرَحْمَةًۭ مِّنَّا ۚ وَكَانَ","مَّقْضِيًّۭا",66],["19:35:11",307,"أَمْرًۭا","a matter","سُبْحَـٰنَهُۥٓ ۚ إِذَا قَضَىٰٓ","فَإِنَّمَا يَقُولُ لَهُۥ",66],["19:39:6",308,"ٱلْأَمْرُ","the matter","ٱلْحَسْرَةِ إِذْ قُضِىَ","وَهُمْ فِى غَفْلَةٍۢ",66],["19:55:2",309,"يَأْمُرُ","(to) enjoin","وَكَانَ","أَهْلَهُۥ بِٱلصَّلَوٰةِ وَٱلزَّكَوٰةِ",147],["19:64:4",309,"بِأَمْرِ","by (the) Command","وَمَا نَتَنَزَّلُ إِلَّا","رَبِّكَ ۖ لَهُۥ مَا",66],["20:26:3",313,"أَمْرِى","my task","وَيَسِّرْ لِىٓ","",66],["20:32:3",313,"أَمْرِى","my task","وَأَشْرِكْهُ فِىٓ","",66],["20:62:2",315,"أَمْرَهُم","(in) their affair","فَتَنَـٰزَعُوٓا۟","بَيْنَهُمْ وَأَسَرُّوا۟ ٱلنَّجْوَىٰ",66],["20:90:16",318,"أَمْرِى","my order","ٱلرَّحْمَـٰنُ فَٱتَّبِعُونِى وَأَطِيعُوٓا۟","",66],["20:93:4",318,"أَمْرِى","my order","أَلَّا تَتَّبِعَنِ ۖ أَفَعَصَيْتَ","",66],["20:132:1",321,"وَأْمُرْ","And enjoin","","أَهْلَكَ بِٱلصَّلَوٰةِ وَٱصْطَبِرْ",147],["21:27:5",324,"بِأَمْرِهِۦ","by His command","يَسْبِقُونَهُۥ بِٱلْقَوْلِ وَهُم","يَعْمَلُونَ",66],["21:73:4",328,"بِأَمْرِنَا","by Our Command","وَجَعَلْنَـٰهُمْ أَئِمَّةًۭ يَهْدُونَ","وَأَوْحَيْنَآ إِلَيْهِمْ فِعْلَ",66],["21:81:5",328,"بِأَمْرِهِۦٓ","by his command","ٱلرِّيحَ عَاصِفَةًۭ تَجْرِى","إِلَى ٱلْأَرْضِ ٱلَّتِى",66],["21:93:2",330,"أَمْرَهُم","their affair","وَتَقَطَّعُوٓا۟","بَيْنَهُمْ ۖ كُلٌّ إِلَيْنَا",66],["22:41:10",337,"وَأَمَرُوا۟","and they enjoin","ٱلصَّلَوٰةَ وَءَاتَوُا۟ ٱلزَّكَوٰةَ","بِٱلْمَعْرُوفِ وَنَهَوْا۟ عَنِ",147],["22:41:17",337,"ٱلْأُمُورِ","(of) the matters","ٱلْمُنكَرِ ۗ وَلِلَّهِ عَـٰقِبَةُ","",66],["22:65:14",340,"بِأَمْرِهِۦ","by His Command","تَجْرِى فِى ٱلْبَحْرِ","وَيُمْسِكُ ٱلسَّمَآءَ أَن",66],["22:67:10",340,"ٱلْأَمْرِ ۚ","the matter","فَلَا يُنَـٰزِعُنَّكَ فِى","وَٱدْعُ إِلَىٰ رَبِّكَ ۖ",66],["22:76:10",341,"ٱلْأُمُورُ","all the matters","وَإِلَى ٱللَّهِ تُرْجَعُ","",66],["23:27:10",343,"أَمْرُنَا","Our Command","وَوَحْيِنَا فَإِذَا جَآءَ","وَفَارَ ٱلتَّنُّورُ ۙ فَٱسْلُكْ",66],["23:53:2",345,"أَمْرَهُم","their affair (of unity)","فَتَقَطَّعُوٓا۟","بَيْنَهُمْ زُبُرًۭا ۖ كُلُّ",66],["24:21:13",352,"يَأْمُرُ","commands","خُطُوَٰتِ ٱلشَّيْطَـٰنِ فَإِنَّهُۥ","بِٱلْفَحْشَآءِ وَٱلْمُنكَرِ ۚ وَلَوْلَا",147],["24:53:6",356,"أَمَرْتَهُمْ","you ordered them","جَهْدَ أَيْمَـٰنِهِمْ لَئِنْ","لَيَخْرُجُنَّ ۖ قُل لَّا",147],["24:62:11",359,"أَمْرٍۢ","a matter","كَانُوا۟ مَعَهُۥ عَلَىٰٓ","جَامِعٍۢ لَّمْ يَذْهَبُوا۟",66],["24:63:20",359,"أَمْرِهِۦٓ","his orders","ٱلَّذِينَ يُخَالِفُونَ عَنْ","أَن تُصِيبَهُمْ فِتْنَةٌ",66],["25:60:11",365,"تَأْمُرُنَا","you order us","ٱلرَّحْمَـٰنُ أَنَسْجُدُ لِمَا","وَزَادَهُمْ نُفُورًۭا ۩",147],["26:35:8",368,"تَأْمُرُونَ","(do) you advise","أَرْضِكُم بِسِحْرِهِۦ فَمَاذَا","",147],["26:151:3",373,"أَمْرَ","(the) command","وَلَا تُطِيعُوٓا۟","ٱلْمُسْرِفِينَ",66],["27:32:6",379,"أَمْرِى","my affair","ٱلْمَلَؤُا۟ أَفْتُونِى فِىٓ","مَا كُنتُ قَاطِعَةً",66],["27:32:10",379,"أَمْرًا","any matter","مَا كُنتُ قَاطِعَةً","حَتَّىٰ تَشْهَدُونِ",66],["27:33:8",379,"وَٱلْأَمْرُ","and the command","وَأُو۟لُوا۟ بَأْسٍۢ شَدِيدٍۢ","إِلَيْكِ فَٱنظُرِى مَاذَا",66],["27:33:12",379,"تَأْمُرِينَ","you will command","إِلَيْكِ فَٱنظُرِى مَاذَا","",147],["27:91:2",385,"أُمِرْتُ","I am commanded","إِنَّمَآ","أَنْ أَعْبُدَ رَبَّ",147],["27:91:13",385,"وَأُمِرْتُ","And I am commanded","وَلَهُۥ كُلُّ شَىْءٍۢ ۖ","أَنْ أَكُونَ مِنَ",147],["28:20:11",387,"يَأْتَمِرُونَ","are taking counsel","يَـٰمُوسَىٰٓ إِنَّ ٱلْمَلَأَ","بِكَ لِيَقْتُلُوكَ فَٱخْرُجْ",2754],["28:44:9",391,"ٱلْأَمْرَ","the Commandment","قَضَيْنَآ إِلَىٰ مُوسَى","وَمَا كُنتَ مِنَ",66],["30:4:5",404,"ٱلْأَمْرُ","(is) the command","بِضْعِ سِنِينَ ۗ لِلَّهِ","مِن قَبْلُ وَمِنۢ",66],["30:25:7",407,"بِأَمْرِهِۦ ۚ","by His Command","تَقُومَ ٱلسَّمَآءُ وَٱلْأَرْضُ","ثُمَّ إِذَا دَعَاكُمْ",66],["30:46:12",409,"بِأَمْرِهِۦ","at His Command","رَّحْمَتِهِۦ وَلِتَجْرِىَ ٱلْفُلْكُ","وَلِتَبْتَغُوا۟ مِن فَضْلِهِۦ",66],["31:17:4",412,"وَأْمُرْ","and enjoin","يَـٰبُنَىَّ أَقِمِ ٱلصَّلَوٰةَ","بِٱلْمَعْرُوفِ وَٱنْهَ عَنِ",147],["31:17:17",412,"ٱلْأُمُورِ","the matters requiring determination","ذَٰلِكَ مِنْ عَزْمِ","",66],["31:22:15",413,"ٱلْأُمُورِ","(of) the matters","وَإِلَى ٱللَّهِ عَـٰقِبَةُ","",66],["32:5:2",415,"ٱلْأَمْرَ","the affair","يُدَبِّرُ","مِنَ ٱلسَّمَآءِ إِلَى",66],["32:24:5",417,"بِأَمْرِنَا","by Our Command","مِنْهُمْ أَئِمَّةًۭ يَهْدُونَ","لَمَّا صَبَرُوا۟ ۖ وَكَانُوا۟",66],["33:36:10",423,"أَمْرًا","a matter","قَضَى ٱللَّهُ وَرَسُولُهُۥٓ","أَن يَكُونَ لَهُمُ",66],["33:36:16",423,"أَمْرِهِمْ ۗ","their affair","لَهُمُ ٱلْخِيَرَةُ مِنْ","وَمَن يَعْصِ ٱللَّهَ",66],["33:37:46",423,"أَمْرُ","(the) Command","مِنْهُنَّ وَطَرًۭا ۚ وَكَانَ","ٱللَّهِ مَفْعُولًۭا",66],["33:38:19",423,"أَمْرُ","(the) Command","مِن قَبْلُ ۚ وَكَانَ","ٱللَّهِ قَدَرًۭا مَّقْدُورًا",66],["34:12:23",429,"أَمْرِنَا","Our Command","يَزِغْ مِنْهُمْ عَنْ","نُذِقْهُ مِنْ عَذَابِ",66],["34:33:11",432,"تَأْمُرُونَنَآ","you were ordering us","ٱلَّيْلِ وَٱلنَّهَارِ إِذْ","أَن نَّكْفُرَ بِٱللَّهِ",147],["35:4:11",435,"ٱلْأُمُورُ","the matters","وَإِلَى ٱللَّهِ تُرْجَعُ","",66],["36:82:2",445,"أَمْرُهُۥٓ","His Command","إِنَّمَآ","إِذَآ أَرَادَ شَيْـًٔا",66],["37:102:20",449,"تُؤْمَرُ ۖ","you are commanded","يَـٰٓأَبَتِ ٱفْعَلْ مَا","سَتَجِدُنِىٓ إِن شَآءَ",147],["38:36:5",455,"بِأَمْرِهِۦ","by his command","لَهُ ٱلرِّيحَ تَجْرِى","رُخَآءً حَيْثُ أَصَابَ",66],["39:11:3",460,"أُمِرْتُ","[I] am commanded","قُلْ إِنِّىٓ","أَنْ أَعْبُدَ ٱللَّهَ",147],["39:12:1",460,"وَأُمِرْتُ","And I am commanded","","لِأَنْ أَكُونَ أَوَّلَ",147],["39:64:4",465,"تَأْمُرُوٓنِّىٓ","you order me","قُلْ أَفَغَيْرَ ٱللَّهِ","أَعْبُدُ أَيُّهَا ٱلْجَـٰهِلُونَ",147],["40:15:8",468,"أَمْرِهِۦ","His Command","يُلْقِى ٱلرُّوحَ مِنْ","عَلَىٰ مَن يَشَآءُ",66],["40:44:6",472,"أَمْرِىٓ","my affair","أَقُولُ لَكُمْ ۚ وَأُفَوِّضُ","إِلَى ٱللَّهِ ۚ إِنَّ",66],["40:66:16",474,"وَأُمِرْتُ","and I am commanded","ٱلْبَيِّنَـٰتُ مِن رَّبِّى","أَنْ أُسْلِمَ لِرَبِّ",147],["40:68:7",475,"أَمْرًۭا","a matter","وَيُمِيتُ ۖ فَإِذَا قَضَىٰٓ","فَإِنَّمَا يَقُولُ لَهُۥ",66],["40:78:26",476,"أَمْرُ","(the) Command","ٱللَّهِ ۚ فَإِذَا جَآءَ","ٱللَّهِ قُضِىَ بِٱلْحَقِّ",66],["41:12:10",478,"أَمْرَهَا ۚ","its affair","فِى كُلِّ سَمَآءٍ","وَزَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا",66],["42:15:5",484,"أُمِرْتَ ۖ","you are commanded","فَٱدْعُ ۖ وَٱسْتَقِمْ كَمَآ","وَلَا تَتَّبِعْ أَهْوَآءَهُمْ ۖ",147],["42:15:16",484,"وَأُمِرْتُ","and I am commanded","ٱللَّهُ مِن كِتَـٰبٍۢ ۖ","لِأَعْدِلَ بَيْنَكُمُ ۖ ٱللَّهُ",147],["42:38:6",487,"وَأَمْرُهُمْ","and their affairs","لِرَبِّهِمْ وَأَقَامُوا۟ ٱلصَّلَوٰةَ","شُورَىٰ بَيْنَهُمْ وَمِمَّا",66],["42:43:8",487,"ٱلْأُمُورِ","matters of determination","ذَٰلِكَ لَمِنْ عَزْمِ","",66],["42:52:6",489,"أَمْرِنَا ۚ","Our Command","إِلَيْكَ رُوحًۭا مِّنْ","مَا كُنتَ تَدْرِى",66],["42:53:15",489,"ٱلْأُمُورُ","all affairs","إِلَى ٱللَّهِ تَصِيرُ","",66],["43:79:3",495,"أَمْرًۭا","an affair","أَمْ أَبْرَمُوٓا۟","فَإِنَّا مُبْرِمُونَ",66],["44:4:4",496,"أَمْرٍ","affair","فِيهَا يُفْرَقُ كُلُّ","حَكِيمٍ",66],["44:5:1",496,"أَمْرًۭا","A command","","مِّنْ عِندِنَآ ۚ إِنَّا",66],["45:12:9",499,"بِأَمْرِهِۦ","by His Command","لِتَجْرِىَ ٱلْفُلْكُ فِيهِ","وَلِتَبْتَغُوا۟ مِن فَضْلِهِۦ",66],["45:17:4",500,"ٱلْأَمْرِ ۖ","the matter","وَءَاتَيْنَـٰهُم بَيِّنَـٰتٍۢ مِّنَ","فَمَا ٱخْتَلَفُوٓا۟ إِلَّا",66],["45:18:6",500,"ٱلْأَمْرِ","the matter","عَلَىٰ شَرِيعَةٍۢ مِّنَ","فَٱتَّبِعْهَا وَلَا تَتَّبِعْ",66],["46:25:4",505,"بِأَمْرِ","by (the) command","تُدَمِّرُ كُلَّ شَىْءٍۭ","رَبِّهَا فَأَصْبَحُوا۟ لَا",66],["47:21:6",509,"ٱلْأَمْرُ","the matter","مَّعْرُوفٌۭ ۚ فَإِذَا عَزَمَ","فَلَوْ صَدَقُوا۟ ٱللَّهَ",66],["47:26:12",509,"ٱلْأَمْرِ ۖ","(of) the matter","سَنُطِيعُكُمْ فِى بَعْضِ","وَٱللَّهُ يَعْلَمُ إِسْرَارَهُمْ",66],["49:7:11",516,"ٱلْأَمْرِ","the matter","فِى كَثِيرٍۢ مِّنَ","لَعَنِتُّمْ وَلَـٰكِنَّ ٱللَّهَ",66],["49:9:19",516,"أَمْرِ","(the) command","حَتَّىٰ تَفِىٓءَ إِلَىٰٓ","ٱللَّهِ ۚ فَإِن فَآءَتْ",66],["50:5:8",518,"أَمْرٍۢ","a state","جَآءَهُمْ فَهُمْ فِىٓ","مَّرِيجٍ",66],["51:4:2",520,"أَمْرًا","Command","فَٱلْمُقَسِّمَـٰتِ","",66],["51:44:3",522,"أَمْرِ","(the) Command","فَعَتَوْا۟ عَنْ","رَبِّهِمْ فَأَخَذَتْهُمُ ٱلصَّـٰعِقَةُ",66],["52:32:2",525,"تَأْمُرُهُمْ","command them","أَمْ","أَحْلَـٰمُهُم بِهَـٰذَآ ۚ أَمْ",147],["54:3:5",528,"أَمْرٍۢ","matter","وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ","مُّسْتَقِرٌّۭ",66],["54:12:7",529,"أَمْرٍۢ","a matter","فَٱلْتَقَى ٱلْمَآءُ عَلَىٰٓ","قَدْ قُدِرَ",66],["54:50:2",531,"أَمْرُنَآ","(is) Our Command","وَمَآ","إِلَّا وَٰحِدَةٌۭ كَلَمْحٍۭ",66],["57:5:8",538,"ٱلْأُمُورُ","the matters","وَإِلَى ٱللَّهِ تُرْجَعُ","",66],["57:14:16",539,"أَمْرُ","(the) Command","ٱلْأَمَانِىُّ حَتَّىٰ جَآءَ","ٱللَّهِ وَغَرَّكُم بِٱللَّهِ",66],["57:24:3",540,"وَيَأْمُرُونَ","and enjoin","ٱلَّذِينَ يَبْخَلُونَ","ٱلنَّاسَ بِٱلْبُخْلِ ۗ وَمَن",147],["59:15:8",547,"أَمْرِهِمْ","(of) their affair","قَرِيبًۭا ۖ ذَاقُوا۟ وَبَالَ","وَلَهُمْ عَذَابٌ أَلِيمٌۭ",66],["64:5:10",556,"أَمْرِهِمْ","(of) their affair","قَبْلُ فَذَاقُوا۟ وَبَالَ","وَلَهُمْ عَذَابٌ أَلِيمٌۭ",66],["65:1:41",558,"أَمْرًۭا","a matter","يُحْدِثُ بَعْدَ ذَٰلِكَ","",66],["65:3:15",558,"أَمْرِهِۦ ۚ","His purpose","إِنَّ ٱللَّهَ بَـٰلِغُ","قَدْ جَعَلَ ٱللَّهُ",66],["65:4:27",558,"أَمْرِهِۦ","his affair","يَجْعَل لَّهُۥ مِنْ","يُسْرًۭا",66],["65:5:2",558,"أَمْرُ","(is the) Command","ذَٰلِكَ","ٱللَّهِ أَنزَلَهُۥٓ إِلَيْكُمْ ۚ",66],["65:6:25",559,"وَأْتَمِرُوا۟","and consult","لَكُمْ فَـَٔاتُوهُنَّ أُجُورَهُنَّ ۖ","بَيْنَكُم بِمَعْرُوفٍۢ ۖ وَإِن",2754],["65:8:6",559,"أَمْرِ","(the) Command","قَرْيَةٍ عَتَتْ عَنْ","رَبِّهَا وَرُسُلِهِۦ فَحَاسَبْنَـٰهَا",66],["65:9:3",559,"أَمْرِهَا","(of) its affair","فَذَاقَتْ وَبَالَ","وَكَانَ عَـٰقِبَةُ أَمْرِهَا",66],["65:9:6",559,"أَمْرِهَا","(of) its affair","أَمْرِهَا وَكَانَ عَـٰقِبَةُ","خُسْرًا",66],["65:12:10",559,"ٱلْأَمْرُ","the command","ٱلْأَرْضِ مِثْلَهُنَّ يَتَنَزَّلُ","بَيْنَهُنَّ لِتَعْلَمُوٓا۟ أَنَّ",66],["66:6:19",560,"أَمَرَهُمْ","He Commands them","يَعْصُونَ ٱللَّهَ مَآ","وَيَفْعَلُونَ مَا يُؤْمَرُونَ",147],["66:6:22",560,"يُؤْمَرُونَ","they are commanded","أَمَرَهُمْ وَيَفْعَلُونَ مَا","",147],["79:5:2",583,"أَمْرًۭا","(the) matter","فَٱلْمُدَبِّرَٰتِ","",66],["80:23:5",585,"أَمَرَهُۥ","He commanded him","لَمَّا يَقْضِ مَآ","",147],["82:19:7",587,"وَٱلْأَمْرُ","and the Command","نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ","يَوْمَئِذٍۢ لِّلَّهِ",66],["96:12:2",597,"أَمَرَ","he enjoins","أَوْ","بِٱلتَّقْوَىٰٓ",147],["97:4:9",598,"أَمْرٍۢ","affair","رَبِّهِم مِّن كُلِّ","",66],["98:5:2",598,"أُمِرُوٓا۟","they were commanded","وَمَآ","إِلَّا لِيَعْبُدُوا۟ ٱللَّهَ",147]]