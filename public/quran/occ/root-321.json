[["2:218:11",34,"يَرْجُونَ","they hope","سَبِيلِ ٱللَّهِ أُو۟لَـٰٓئِكَ","رَحْمَتَ ٱللَّهِ ۚ وَٱللَّهُ",480],["4:104:13",95,"وَتَرْجُونَ","while you (have) hope","يَأْلَمُونَ كَمَا تَأْلَمُونَ ۖ","مِنَ ٱللَّهِ مَا",480],["4:104:18",95,"يَرْجُونَ ۗ","they hope","ٱللَّهِ مَا لَا","وَكَانَ ٱللَّهُ عَلِيمًا",480],["7:111:2",164,"أَرْجِهْ","Postpone him","قَالُوٓا۟","وَأَخَاهُ وَأَرْسِلْ فِى",2019],["9:106:2",203,"مُرْجَوْنَ","deferred","وَءَاخَرُونَ","لِأَمْرِ ٱللَّهِ إِمَّا",3844],["10:7:4",209,"يَرْجُونَ","expect","إِنَّ ٱلَّذِينَ لَا","لِقَآءَنَا وَرَضُوا۟ بِٱلْحَيَوٰةِ",480],["10:11:14",209,"يَرْجُونَ","expect","فَنَذَرُ ٱلَّذِينَ لَا","لِقَآءَنَا فِى طُغْيَـٰنِهِمْ",480],["10:15:9",210,"يَرْجُونَ","hope","قَالَ ٱلَّذِينَ لَا","لِقَآءَنَا ٱئْتِ بِقُرْءَانٍ",480],["11:62:6",228,"مَرْجُوًّۭا","the one in whom hope was placed","قَدْ كُنتَ فِينَا","قَبْلَ هَـٰذَآ ۖ أَتَنْهَىٰنَآ",3708],["17:28:8",285,"تَرْجُوهَا","which you expect","رَحْمَةٍۢ مِّن رَّبِّكَ","فَقُل لَّهُمْ قَوْلًۭا",480],["17:57:10",287,"وَيَرْجُونَ","and they hope","ٱلْوَسِيلَةَ أَيُّهُمْ أَقْرَبُ","رَحْمَتَهُۥ وَيَخَافُونَ عَذَابَهُۥٓ ۚ",480],["18:110:14",304,"يَرْجُوا۟","hoping","وَٰحِدٌۭ ۖ فَمَن كَانَ","لِقَآءَ رَبِّهِۦ فَلْيَعْمَلْ",480],["24:60:6",358,"يَرْجُونَ","have desire","ٱلنِّسَآءِ ٱلَّـٰتِى لَا","نِكَاحًۭا فَلَيْسَ عَلَيْهِنَّ",480],["25:21:4",362,"يَرْجُونَ","expect","۞ وَقَالَ ٱلَّذِينَ لَا","لِقَآءَنَا لَوْلَآ أُنزِلَ",480],["25:40:15",363,"يَرْجُونَ","expecting","بَلْ كَانُوا۟ لَا","نُشُورًۭا",480],["26:36:2",368,"أَرْجِهْ","Postpone him","قَالُوٓا۟","وَأَخَاهُ وَٱبْعَثْ فِى",2019],["28:86:3",396,"تَرْجُوٓا۟","expecting","وَمَا كُنتَ","أَن يُلْقَىٰٓ إِلَيْكَ",480],["29:5:3",396,"يَرْجُوا۟","hopes","مَن كَانَ","لِقَآءَ ٱللَّهِ فَإِنَّ",480],["29:36:9",400,"وَٱرْجُوا۟","and expect","يَـٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ","ٱلْيَوْمَ ٱلْـَٔاخِرَ وَلَا",480],["33:21:11",420,"يَرْجُوا۟","hope","حَسَنَةٌۭ لِّمَن كَانَ","ٱللَّهَ وَٱلْيَوْمَ ٱلْـَٔاخِرَ",480],["33:51:1",425,"۞ تُرْجِى","You may defer","","مَن تَشَآءُ مِنْهُنَّ",2019],["35:29:13",437,"يَرْجُونَ","hope","رَزَقْنَـٰهُمْ سِرًّۭا وَعَلَانِيَةًۭ","تِجَـٰرَةًۭ لَّن تَبُورَ",480],["39:9:10",459,"وَيَرْجُوا۟","and hoping","وَقَآئِمًۭا يَحْذَرُ ٱلْـَٔاخِرَةَ","رَحْمَةَ رَبِّهِۦ ۗ قُلْ",480],["45:14:7",500,"يَرْجُونَ","hope","يَغْفِرُوا۟ لِلَّذِينَ لَا","أَيَّامَ ٱللَّهِ لِيَجْزِىَ",480],["60:6:9",550,"يَرْجُوا۟","hopeful","حَسَنَةٌۭ لِّمَن كَانَ","ٱللَّهَ وَٱلْيَوْمَ ٱلْـَٔاخِرَ ۚ",480],["69:17:3",567,"أَرْجَآئِهَا ۚ","its edges","وَٱلْمَلَكُ عَلَىٰٓ","وَيَحْمِلُ عَرْشَ رَبِّكَ",3032],["71:13:4",571,"تَرْجُونَ","you attribute","مَّا لَكُمْ لَا","لِلَّهِ وَقَارًۭا",480],["78:27:4",582,"يَرْجُونَ","expecting","إِنَّهُمْ كَانُوا۟ لَا","حِسَابًۭا",480]]