[["18:48:4",299,"صَفًّۭا","(in) rows","وَعُرِضُوا۟ عَلَىٰ رَبِّكَ","لَّقَدْ جِئْتُمُونَا كَمَا",1060],["20:64:5",315,"صَفًّۭا ۚ","(in) a line","كَيْدَكُمْ ثُمَّ ٱئْتُوا۟","وَقَدْ أَفْلَحَ ٱلْيَوْمَ",1060],["22:36:14",336,"صَوَآفَّ ۖ","(when) lined up","ٱسْمَ ٱللَّهِ عَلَيْهَا","فَإِذَا وَجَبَتْ جُنُوبُهَا",3254],["24:41:12",355,"صَـٰٓفَّـٰتٍۢ ۖ","(with) wings outspread","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَٱلطَّيْرُ","كُلٌّۭ قَدْ عَلِمَ",1792],["37:1:1",446,"وَٱلصَّـٰٓفَّـٰتِ","By those lined","","صَفًّۭا",1792],["37:1:2",446,"صَفًّۭا","(in) rows","وَٱلصَّـٰٓفَّـٰتِ","",1060],["37:165:3",452,"ٱلصَّآفُّونَ","stand in rows","وَإِنَّا لَنَحْنُ","",3271],["52:20:4",524,"مَّصْفُوفَةٍۢ ۖ","lined up","مُتَّكِـِٔينَ عَلَىٰ سُرُرٍۢ","وَزَوَّجْنَـٰهُم بِحُورٍ عِينٍۢ",2445],["61:4:8",551,"صَفًّۭا","(in) a row","يُقَـٰتِلُونَ فِى سَبِيلِهِۦ","كَأَنَّهُم بُنْيَـٰنٌۭ مَّرْصُوصٌۭ",1060],["67:19:6",563,"صَـٰٓفَّـٰتٍۢ","spreading (their wings)","إِلَى ٱلطَّيْرِ فَوْقَهُمْ","وَيَقْبِضْنَ ۚ مَا يُمْسِكُهُنَّ",1792],["78:38:5",583,"صَفًّۭا ۖ","(in) rows","يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ","لَّا يَتَكَلَّمُونَ إِلَّا",1060],["88:15:2",592,"مَصْفُوفَةٌۭ","lined up","وَنَمَارِقُ","",2445],["89:22:4",593,"صَفًّۭا","rank","وَجَآءَ رَبُّكَ وَٱلْمَلَكُ","صَفًّۭا",1060],["89:22:5",593,"صَفًّۭا","(upon) rank","رَبُّكَ وَٱلْمَلَكُ صَفًّۭا","",1060]]