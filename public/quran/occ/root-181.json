[["2:3:3",2,"بِٱلْغَيْبِ","in the unseen","ٱلَّذِينَ يُؤْمِنُونَ","وَيُقِيمُونَ ٱلصَّلَوٰةَ وَمِمَّا",242],["2:33:14",6,"غَيْبَ","(the) unseen","لَّكُمْ إِنِّىٓ أَعْلَمُ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَأَعْلَمُ",242],["3:44:4",55,"ٱلْغَيْبِ","(of) the unseen","ذَٰلِكَ مِنْ أَنۢبَآءِ","نُوحِيهِ إِلَيْكَ ۚ وَمَا",242],["3:179:20",73,"ٱلْغَيْبِ","the unseen","ٱللَّهُ لِيُطْلِعَكُمْ عَلَى","وَلَـٰكِنَّ ٱللَّهَ يَجْتَبِى",242],["4:34:18",84,"لِّلْغَيْبِ","in the unseen","فَٱلصَّـٰلِحَـٰتُ قَـٰنِتَـٰتٌ حَـٰفِظَـٰتٌۭ","بِمَا حَفِظَ ٱللَّهُ ۚ",242],["5:94:16",123,"بِٱلْغَيْبِ ۚ","in the unseen","ٱللَّهُ مَن يَخَافُهُۥ","فَمَنِ ٱعْتَدَىٰ بَعْدَ",242],["5:109:15",126,"ٱلْغُيُوبِ","(of) the unseen","إِنَّكَ أَنتَ عَلَّـٰمُ","",1553],["5:116:44",127,"ٱلْغُيُوبِ","(of) the unseen","إِنَّكَ أَنتَ عَلَّـٰمُ","",1553],["6:50:10",133,"ٱلْغَيْبَ","the unseen","ٱللَّهِ وَلَآ أَعْلَمُ","وَلَآ أَقُولُ لَكُمْ",242],["6:59:3",134,"ٱلْغَيْبِ","(of) the unseen","۞ وَعِندَهُۥ مَفَاتِحُ","لَا يَعْلَمُهَآ إِلَّا",242],["6:73:20",136,"ٱلْغَيْبِ","(of) the unseen","فِى ٱلصُّورِ ۚ عَـٰلِمُ","وَٱلشَّهَـٰدَةِ ۚ وَهُوَ ٱلْحَكِيمُ",242],["7:7:6",151,"غَآئِبِينَ","absent","بِعِلْمٍۢ ۖ وَمَا كُنَّا","",1842],["7:188:15",175,"ٱلْغَيْبَ","(of) the unseen","وَلَوْ كُنتُ أَعْلَمُ","لَٱسْتَكْثَرْتُ مِنَ ٱلْخَيْرِ",242],["9:78:11",199,"ٱلْغُيُوبِ","(of) the unseen","وَأَنَّ ٱللَّهَ عَلَّـٰمُ","",1553],["9:94:25",202,"ٱلْغَيْبِ","(of) the unseen","تُرَدُّونَ إِلَىٰ عَـٰلِمِ","وَٱلشَّهَـٰدَةِ فَيُنَبِّئُكُم بِمَا",242],["9:105:11",203,"ٱلْغَيْبِ","(of) the unseen","وَسَتُرَدُّونَ إِلَىٰ عَـٰلِمِ","وَٱلشَّهَـٰدَةِ فَيُنَبِّئُكُم بِمَا",242],["10:20:10",210,"ٱلْغَيْبُ","the unseen","رَّبِّهِۦ ۖ فَقُلْ إِنَّمَا","لِلَّهِ فَٱنتَظِرُوٓا۟ إِنِّى",242],["11:31:9",225,"ٱلْغَيْبَ","the unseen","ٱللَّهِ وَلَآ أَعْلَمُ","وَلَآ أَقُولُ إِنِّى",242],["11:49:4",227,"ٱلْغَيْبِ","(of) the unseen","تِلْكَ مِنْ أَنۢبَآءِ","نُوحِيهَآ إِلَيْكَ ۖ مَا",242],["11:123:2",235,"غَيْبُ","(is the) unseen","وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَإِلَيْهِ",242],["12:10:9",236,"غَيَـٰبَتِ","the bottom","يُوسُفَ وَأَلْقُوهُ فِى","ٱلْجُبِّ يَلْتَقِطْهُ بَعْضُ",2377],["12:15:8",237,"غَيَـٰبَتِ","(the) bottom","أَن يَجْعَلُوهُ فِى","ٱلْجُبِّ ۚ وَأَوْحَيْنَآ إِلَيْهِ",2377],["12:52:6",241,"بِٱلْغَيْبِ","in secret","أَنِّى لَمْ أَخُنْهُ","وَأَنَّ ٱللَّهَ لَا",242],["12:81:16",245,"لِلْغَيْبِ","of the unseen","عَلِمْنَا وَمَا كُنَّا","حَـٰفِظِينَ",242],["12:102:4",247,"ٱلْغَيْبِ","(of) the unseen","ذَٰلِكَ مِنْ أَنۢبَآءِ","نُوحِيهِ إِلَيْكَ ۖ وَمَا",242],["13:9:2",250,"ٱلْغَيْبِ","(of) the unseen","عَـٰلِمُ","وَٱلشَّهَـٰدَةِ ٱلْكَبِيرُ ٱلْمُتَعَالِ",242],["16:77:2",275,"غَيْبُ","(the) unseen","وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَمَآ",242],["18:22:10",296,"بِٱلْغَيْبِ ۖ","about the unseen","سَادِسُهُمْ كَلْبُهُمْ رَجْمًۢا","وَيَقُولُونَ سَبْعَةٌۭ وَثَامِنُهُمْ",242],["18:26:7",296,"غَيْبُ","(is the) unseen","بِمَا لَبِثُوا۟ ۖ لَهُۥ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ أَبْصِرْ",242],["19:61:7",309,"بِٱلْغَيْبِ ۚ","in the unseen","وَعَدَ ٱلرَّحْمَـٰنُ عِبَادَهُۥ","إِنَّهُۥ كَانَ وَعْدُهُۥ",242],["19:78:2",311,"ٱلْغَيْبَ","(into) the unseen","أَطَّلَعَ","أَمِ ٱتَّخَذَ عِندَ",242],["21:49:4",326,"بِٱلْغَيْبِ","in the unseen","ٱلَّذِينَ يَخْشَوْنَ رَبَّهُم","وَهُم مِّنَ ٱلسَّاعَةِ",242],["23:92:2",348,"ٱلْغَيْبِ","(of) the unseen","عَـٰلِمِ","وَٱلشَّهَـٰدَةِ فَتَعَـٰلَىٰ عَمَّا",242],["27:20:12",378,"ٱلْغَآئِبِينَ","the absent","أَمْ كَانَ مِنَ","",1842],["27:65:8",383,"ٱلْغَيْبَ","(of) the unseen","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","إِلَّا ٱللَّهُ ۚ وَمَا",242],["27:75:3",383,"غَآئِبَةٍۢ","hidden","وَمَا مِنْ","فِى ٱلسَّمَآءِ وَٱلْأَرْضِ",3449],["32:6:3",415,"ٱلْغَيْبِ","(of) the hidden","ذَٰلِكَ عَـٰلِمُ","وَٱلشَّهَـٰدَةِ ٱلْعَزِيزُ ٱلرَّحِيمُ",242],["34:3:12",428,"ٱلْغَيْبِ ۖ","(of) the unseen","وَرَبِّى لَتَأْتِيَنَّكُمْ عَـٰلِمِ","لَا يَعْزُبُ عَنْهُ",242],["34:14:22",429,"ٱلْغَيْبَ","the unseen","لَّوْ كَانُوا۟ يَعْلَمُونَ","مَا لَبِثُوا۟ فِى",242],["34:48:7",433,"ٱلْغُيُوبِ","(of) the unseen","يَقْذِفُ بِٱلْحَقِّ عَلَّـٰمُ","",1553],["34:53:7",434,"بِٱلْغَيْبِ","about the unseen","مِن قَبْلُ ۖ وَيَقْذِفُونَ","مِن مَّكَانٍۭ بَعِيدٍۢ",242],["35:18:24",436,"بِٱلْغَيْبِ","unseen","ٱلَّذِينَ يَخْشَوْنَ رَبَّهُم","وَأَقَامُوا۟ ٱلصَّلَوٰةَ ۚ وَمَن",242],["35:38:4",438,"غَيْبِ","(of the) unseen","إِنَّ ٱللَّهَ عَـٰلِمُ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ إِنَّهُۥ",242],["36:11:8",440,"بِٱلْغَيْبِ ۖ","in the unseen","ٱلذِّكْرَ وَخَشِىَ ٱلرَّحْمَـٰنَ","فَبَشِّرْهُ بِمَغْفِرَةٍۢ وَأَجْرٍۢ",242],["39:46:7",463,"ٱلْغَيْبِ","(of) the unseen","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ عَـٰلِمَ","وَٱلشَّهَـٰدَةِ أَنتَ تَحْكُمُ",242],["49:12:15",517,"يَغْتَب","backbite","وَلَا تَجَسَّسُوا۟ وَلَا","بَّعْضُكُم بَعْضًا ۚ أَيُحِبُّ",4633],["49:18:4",517,"غَيْبَ","(the) unseen","إِنَّ ٱللَّهَ يَعْلَمُ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ",242],["50:33:4",519,"بِٱلْغَيْبِ","in the unseen","مَّنْ خَشِىَ ٱلرَّحْمَـٰنَ","وَجَآءَ بِقَلْبٍۢ مُّنِيبٍ",242],["52:41:3",525,"ٱلْغَيْبُ","(is) the unseen","أَمْ عِندَهُمُ","فَهُمْ يَكْتُبُونَ",242],["53:35:3",527,"ٱلْغَيْبِ","(of) the unseen","أَعِندَهُۥ عِلْمُ","فَهُوَ يَرَىٰٓ",242],["57:25:24",541,"بِٱلْغَيْبِ ۚ","unseen","مَن يَنصُرُهُۥ وَرُسُلَهُۥ","إِنَّ ٱللَّهَ قَوِىٌّ",242],["59:22:9",548,"ٱلْغَيْبِ","(of) the unseen","إِلَّا هُوَ ۖ عَـٰلِمُ","وَٱلشَّهَـٰدَةِ ۖ هُوَ ٱلرَّحْمَـٰنُ",242],["62:8:13",553,"ٱلْغَيْبِ","(of) the unseen","تُرَدُّونَ إِلَىٰ عَـٰلِمِ","وَٱلشَّهَـٰدَةِ فَيُنَبِّئُكُم بِمَا",242],["64:18:2",557,"ٱلْغَيْبِ","(of) the unseen","عَـٰلِمُ","وَٱلشَّهَـٰدَةِ ٱلْعَزِيزُ ٱلْحَكِيمُ",242],["67:12:5",562,"بِٱلْغَيْبِ","unseen","ٱلَّذِينَ يَخْشَوْنَ رَبَّهُم","لَهُم مَّغْفِرَةٌۭ وَأَجْرٌۭ",242],["68:47:3",566,"ٱلْغَيْبُ","the unseen","أَمْ عِندَهُمُ","فَهُمْ يَكْتُبُونَ",242],["72:26:2",573,"ٱلْغَيْبِ","(of) the unseen","عَـٰلِمُ","فَلَا يُظْهِرُ عَلَىٰ",242],["72:26:6",573,"غَيْبِهِۦٓ","His unseen","فَلَا يُظْهِرُ عَلَىٰ","أَحَدًا",242],["81:24:4",586,"ٱلْغَيْبِ","the unseen","وَمَا هُوَ عَلَى","بِضَنِينٍۢ",242],["82:16:4",587,"بِغَآئِبِينَ","(will be) absent","وَمَا هُمْ عَنْهَا","",1842]]