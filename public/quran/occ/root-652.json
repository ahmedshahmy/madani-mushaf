[["11:116:23",234,"أُتْرِفُوا۟","luxury they were given","ٱلَّذِينَ ظَلَمُوا۟ مَآ","فِيهِ وَكَانُوا۟ مُجْرِمِينَ",1753],["17:16:7",283,"مُتْرَفِيهَا","its wealthy people","نُّهْلِكَ قَرْيَةً أَمَرْنَا","فَفَسَقُوا۟ فِيهَا فَحَقَّ",1367],["21:13:6",323,"أُتْرِفْتُمْ","you were given luxury","وَٱرْجِعُوٓا۟ إِلَىٰ مَآ","فِيهِ وَمَسَـٰكِنِكُمْ لَعَلَّكُمْ",1753],["23:33:10",344,"وَأَتْرَفْنَـٰهُمْ","while We had given them luxury","وَكَذَّبُوا۟ بِلِقَآءِ ٱلْـَٔاخِرَةِ","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا",1753],["23:64:4",346,"مُتْرَفِيهِم","their affluent ones","حَتَّىٰٓ إِذَآ أَخَذْنَا","بِٱلْعَذَابِ إِذَا هُمْ",1367],["34:34:9",432,"مُتْرَفُوهَآ","its wealthy ones","نَّذِيرٍ إِلَّا قَالَ","إِنَّا بِمَآ أُرْسِلْتُم",1367],["43:23:12",491,"مُتْرَفُوهَآ","(the) wealthy ones of it","نَّذِيرٍ إِلَّا قَالَ","إِنَّا وَجَدْنَآ ءَابَآءَنَا",1367],["56:45:5",535,"مُتْرَفِينَ","indulging in affluence","كَانُوا۟ قَبْلَ ذَٰلِكَ","",1367]]