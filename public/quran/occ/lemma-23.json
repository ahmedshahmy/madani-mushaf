[["2:11:1",3,"وَإِذَا","And when","","قِيلَ لَهُمْ لَا",23],["2:13:1",3,"وَإِذَا","And when","","قِيلَ لَهُمْ ءَامِنُوا۟",23],["2:14:1",3,"وَإِذَا","And when","","لَقُوا۟ ٱلَّذِينَ ءَامَنُوا۟",23],["2:14:7",3,"وَإِذَا","But when","ءَامَنُوا۟ قَالُوٓا۟ ءَامَنَّا","خَلَوْا۟ إِلَىٰ شَيَـٰطِينِهِمْ",23],["2:20:10",4,"وَإِذَآ","and when","لَهُم مَّشَوْا۟ فِيهِ","أَظْلَمَ عَلَيْهِمْ قَامُوا۟ ۚ",23],["2:76:1",11,"وَإِذَا","And when","","لَقُوا۟ ٱلَّذِينَ ءَامَنُوا۟",23],["2:76:7",11,"وَإِذَا","But when","ءَامَنُوا۟ قَالُوٓا۟ ءَامَنَّا","خَلَا بَعْضُهُمْ إِلَىٰ",23],["2:91:1",14,"وَإِذَا","And when","","قِيلَ لَهُمْ ءَامِنُوا۟",23],["2:117:4",18,"وَإِذَا","And when","بَدِيعُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ","قَضَىٰٓ أَمْرًۭا فَإِنَّمَا",23],["2:156:2",24,"إِذَآ","when","ٱلَّذِينَ","أَصَـٰبَتْهُم مُّصِيبَةٌۭ قَالُوٓا۟",23],["2:170:1",26,"وَإِذَا","And when","","قِيلَ لَهُمُ ٱتَّبِعُوا۟",23],["2:177:38",27,"إِذَا","when","ٱلزَّكَوٰةَ وَٱلْمُوفُونَ بِعَهْدِهِمْ","عَـٰهَدُوا۟ ۖ وَٱلصَّـٰبِرِينَ فِى",23],["2:180:3",27,"إِذَا","when","كُتِبَ عَلَيْكُمْ","حَضَرَ أَحَدَكُمُ ٱلْمَوْتُ",23],["2:186:1",28,"وَإِذَا","And when","","سَأَلَكَ عِبَادِى عَنِّى",23],["2:186:10",28,"إِذَا","when","أُجِيبُ دَعْوَةَ ٱلدَّاعِ","دَعَانِ ۖ فَلْيَسْتَجِيبُوا۟ لِى",23],["2:196:34",30,"فَإِذَآ","Then when","صَدَقَةٍ أَوْ نُسُكٍۢ ۚ","أَمِنتُمْ فَمَن تَمَتَّعَ",23],["2:196:54",30,"إِذَا","when","فِى ٱلْحَجِّ وَسَبْعَةٍ","رَجَعْتُمْ ۗ تِلْكَ عَشَرَةٌۭ",23],["2:198:9",31,"فَإِذَآ","And when","فَضْلًۭا مِّن رَّبِّكُمْ ۚ","أَفَضْتُم مِّنْ عَرَفَـٰتٍۢ",23],["2:200:1",31,"فَإِذَا","Then when","","قَضَيْتُم مَّنَـٰسِكَكُمْ فَٱذْكُرُوا۟",23],["2:205:1",32,"وَإِذَا","And when","","تَوَلَّىٰ سَعَىٰ فِى",23],["2:206:1",32,"وَإِذَا","And when","","قِيلَ لَهُ ٱتَّقِ",23],["2:222:15",35,"فَإِذَا","Then when","تَقْرَبُوهُنَّ حَتَّىٰ يَطْهُرْنَ ۖ","تَطَهَّرْنَ فَأْتُوهُنَّ مِنْ",23],["2:231:1",37,"وَإِذَا","And when","","طَلَّقْتُمُ ٱلنِّسَآءَ فَبَلَغْنَ",23],["2:232:1",37,"وَإِذَا","And when","","طَلَّقْتُمُ ٱلنِّسَآءَ فَبَلَغْنَ",23],["2:232:11",37,"إِذَا","when","أَن يَنكِحْنَ أَزْوَٰجَهُنَّ","تَرَٰضَوْا۟ بَيْنَهُم بِٱلْمَعْرُوفِ ۗ",23],["2:233:52",37,"إِذَا","when","فَلَا جُنَاحَ عَلَيْكُمْ","سَلَّمْتُم مَّآ ءَاتَيْتُم",23],["2:234:11",38,"فَإِذَا","Then when","أَرْبَعَةَ أَشْهُرٍۢ وَعَشْرًۭا ۖ","بَلَغْنَ أَجَلَهُنَّ فَلَا",23],["2:239:6",39,"فَإِذَآ","Then when","فَرِجَالًا أَوْ رُكْبَانًۭا ۖ","أَمِنتُمْ فَٱذْكُرُوا۟ ٱللَّهَ",23],["2:282:4",48,"إِذَا","When","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟","تَدَايَنتُم بِدَيْنٍ إِلَىٰٓ",23],["2:282:75",48,"إِذَا","when","وَلَا يَأْبَ ٱلشُّهَدَآءُ","مَا دُعُوا۟ ۚ وَلَا",23],["2:282:109",48,"إِذَا","when","أَلَّا تَكْتُبُوهَا ۗ وَأَشْهِدُوٓا۟","تَبَايَعْتُمْ ۚ وَلَا يُضَآرَّ",23],["3:25:2",53,"إِذَا","when","فَكَيْفَ","جَمَعْنَـٰهُمْ لِيَوْمٍۢ لَّا",23],["3:47:16",56,"إِذَا","When","يَخْلُقُ مَا يَشَآءُ ۚ","قَضَىٰٓ أَمْرًۭا فَإِنَّمَا",23],["3:119:9",65,"وَإِذَا","And when","وَتُؤْمِنُونَ بِٱلْكِتَـٰبِ كُلِّهِۦ","لَقُوكُمْ قَالُوٓا۟ ءَامَنَّا",23],["3:119:13",65,"وَإِذَا","And when","لَقُوكُمْ قَالُوٓا۟ ءَامَنَّا","خَلَوْا۟ عَضُّوا۟ عَلَيْكُمُ",23],["3:135:2",67,"إِذَا","when","وَٱلَّذِينَ","فَعَلُوا۟ فَـٰحِشَةً أَوْ",23],["3:152:9",69,"إِذَا","when","تَحُسُّونَهُم بِإِذْنِهِۦ ۖ حَتَّىٰٓ","فَشِلْتُمْ وَتَنَـٰزَعْتُمْ فِى",23],["3:156:10",70,"إِذَا","when","كَفَرُوا۟ وَقَالُوا۟ لِإِخْوَٰنِهِمْ","ضَرَبُوا۟ فِى ٱلْأَرْضِ",23],["3:159:22",71,"فَإِذَا","Then when","وَشَاوِرْهُمْ فِى ٱلْأَمْرِ ۖ","عَزَمْتَ فَتَوَكَّلْ عَلَى",23],["4:6:4",77,"إِذَا","[when]","وَٱبْتَلُوا۟ ٱلْيَتَـٰمَىٰ حَتَّىٰٓ","بَلَغُوا۟ ٱلنِّكَاحَ فَإِنْ",23],["4:6:29",77,"فَإِذَا","Then when","فَقِيرًۭا فَلْيَأْكُلْ بِٱلْمَعْرُوفِ ۚ","دَفَعْتُمْ إِلَيْهِمْ أَمْوَٰلَهُمْ",23],["4:8:1",78,"وَإِذَا","And when","","حَضَرَ ٱلْقِسْمَةَ أُو۟لُوا۟",23],["4:18:7",80,"إِذَا","when","يَعْمَلُونَ ٱلسَّيِّـَٔاتِ حَتَّىٰٓ","حَضَرَ أَحَدَهُمُ ٱلْمَوْتُ",23],["4:25:35",82,"فَإِذَآ","Then when","وَلَا مُتَّخِذَٰتِ أَخْدَانٍۢ ۚ","أُحْصِنَّ فَإِنْ أَتَيْنَ",23],["4:41:2",85,"إِذَا","when","فَكَيْفَ","جِئْنَا مِن كُلِّ",23],["4:58:9",87,"وَإِذَا","and when","ٱلْأَمَـٰنَـٰتِ إِلَىٰٓ أَهْلِهَا","حَكَمْتُم بَيْنَ ٱلنَّاسِ",23],["4:61:1",88,"وَإِذَا","And when","","قِيلَ لَهُمْ تَعَالَوْا۟",23],["4:62:2",88,"إِذَآ","when","فَكَيْفَ","أَصَـٰبَتْهُم مُّصِيبَةٌۢ بِمَا",23],["4:81:3",91,"فَإِذَا","Then when","وَيَقُولُونَ طَاعَةٌۭ","بَرَزُوا۟ مِنْ عِندِكَ",23],["4:83:1",91,"وَإِذَا","And when","","جَآءَهُمْ أَمْرٌۭ مِّنَ",23],["4:86:1",91,"وَإِذَا","And when","","حُيِّيتُم بِتَحِيَّةٍۢ فَحَيُّوا۟",23],["4:94:4",93,"إِذَا","When","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟","ضَرَبْتُمْ فِى سَبِيلِ",23],["4:101:1",94,"وَإِذَا","And when","","ضَرَبْتُمْ فِى ٱلْأَرْضِ",23],["4:102:1",95,"وَإِذَا","And when","","كُنتَ فِيهِمْ فَأَقَمْتَ",23],["4:102:13",95,"فَإِذَا","Then when","مَّعَكَ وَلْيَأْخُذُوٓا۟ أَسْلِحَتَهُمْ","سَجَدُوا۟ فَلْيَكُونُوا۟ مِن",23],["4:103:1",95,"فَإِذَا","Then when","","قَضَيْتُمُ ٱلصَّلَوٰةَ فَٱذْكُرُوا۟",23],["4:103:10",95,"فَإِذَا","But when","وَقُعُودًۭا وَعَلَىٰ جُنُوبِكُمْ ۚ","ٱطْمَأْنَنتُمْ فَأَقِيمُوا۟ ٱلصَّلَوٰةَ ۚ",23],["4:140:7",100,"إِذَا","when","فِى ٱلْكِتَـٰبِ أَنْ","سَمِعْتُمْ ءَايَـٰتِ ٱللَّهِ",23],["4:142:7",101,"وَإِذَا","And when","ٱللَّهَ وَهُوَ خَـٰدِعُهُمْ","قَامُوٓا۟ إِلَى ٱلصَّلَوٰةِ",23],["5:2:24",106,"وَإِذَا","And when","مِّن رَّبِّهِمْ وَرِضْوَٰنًۭا ۚ","حَلَلْتُمْ فَٱصْطَادُوا۟ ۚ وَلَا",23],["5:5:24",107,"إِذَآ","when","ٱلْكِتَـٰبَ مِن قَبْلِكُمْ","ءَاتَيْتُمُوهُنَّ أُجُورَهُنَّ مُحْصِنِينَ",23],["5:6:4",108,"إِذَا","When","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟","قُمْتُمْ إِلَى ٱلصَّلَوٰةِ",23],["5:23:12",111,"فَإِذَا","then when","ٱدْخُلُوا۟ عَلَيْهِمُ ٱلْبَابَ","دَخَلْتُمُوهُ فَإِنَّكُمْ غَـٰلِبُونَ ۚ",23],["5:58:1",118,"وَإِذَا","And when","","نَادَيْتُمْ إِلَى ٱلصَّلَوٰةِ",23],["5:61:1",118,"وَإِذَا","And when","","جَآءُوكُمْ قَالُوٓا۟ ءَامَنَّا",23],["5:83:1",121,"وَإِذَا","And when","","سَمِعُوا۟ مَآ أُنزِلَ",23],["5:89:35",122,"إِذَا","when","ذَٰلِكَ كَفَّـٰرَةُ أَيْمَـٰنِكُمْ","حَلَفْتُمْ ۚ وَٱحْفَظُوٓا۟ أَيْمَـٰنَكُمْ ۚ",23],["5:93:10",123,"إِذَا","when","جُنَاحٌۭ فِيمَا طَعِمُوٓا۟","مَا ٱتَّقَوا۟ وَّءَامَنُوا۟",23],["5:104:1",125,"وَإِذَا","And when","","قِيلَ لَهُمْ تَعَالَوْا۟",23],["5:105:10",125,"إِذَا","when","يَضُرُّكُم مَّن ضَلَّ","ٱهْتَدَيْتُمْ ۚ إِلَى ٱللَّهِ",23],["5:106:6",125,"إِذَا","when","ءَامَنُوا۟ شَهَـٰدَةُ بَيْنِكُمْ","حَضَرَ أَحَدَكُمُ ٱلْمَوْتُ",23],["6:25:22",130,"إِذَا","when","يُؤْمِنُوا۟ بِهَا ۚ حَتَّىٰٓ","جَآءُوكَ يُجَـٰدِلُونَكَ يَقُولُ",23],["6:31:8",131,"إِذَا","when","بِلِقَآءِ ٱللَّهِ ۖ حَتَّىٰٓ","جَآءَتْهُمُ ٱلسَّاعَةُ بَغْتَةًۭ",23],["6:44:12",132,"إِذَا","when","كُلِّ شَىْءٍ حَتَّىٰٓ","فَرِحُوا۟ بِمَآ أُوتُوٓا۟",23],["6:44:18",132,"فَإِذَا","and then","أُوتُوٓا۟ أَخَذْنَـٰهُم بَغْتَةًۭ","هُم مُّبْلِسُونَ",23],["6:54:1",134,"وَإِذَا","And when","","جَآءَكَ ٱلَّذِينَ يُؤْمِنُونَ",23],["6:61:9",135,"إِذَا","when","عَلَيْكُمْ حَفَظَةً حَتَّىٰٓ","جَآءَ أَحَدَكُمُ ٱلْمَوْتُ",23],["6:68:1",135,"وَإِذَا","And when","","رَأَيْتَ ٱلَّذِينَ يَخُوضُونَ",23],["6:99:36",140,"إِذَآ","when","ٱنظُرُوٓا۟ إِلَىٰ ثَمَرِهِۦٓ","أَثْمَرَ وَيَنْعِهِۦٓ ۚ إِنَّ",23],["6:109:18",141,"إِذَا","when","وَمَا يُشْعِرُكُمْ أَنَّهَآ","جَآءَتْ لَا يُؤْمِنُونَ",23],["6:124:1",143,"وَإِذَا","And when","","جَآءَتْهُمْ ءَايَةٌۭ قَالُوا۟",23],["6:141:20",146,"إِذَآ","when","كُلُوا۟ مِن ثَمَرِهِۦٓ","أَثْمَرَ وَءَاتُوا۟ حَقَّهُۥ",23],["6:152:21",149,"وَإِذَا","And when","نَفْسًا إِلَّا وُسْعَهَا ۖ","قُلْتُمْ فَٱعْدِلُوا۟ وَلَوْ",23],["7:28:1",153,"وَإِذَا","And when","","فَعَلُوا۟ فَـٰحِشَةًۭ قَالُوا۟",23],["7:34:4",154,"فَإِذَا","So when","وَلِكُلِّ أُمَّةٍ أَجَلٌۭ ۖ","جَآءَ أَجَلُهُمْ لَا",23],["7:37:17",154,"إِذَا","when","مِّنَ ٱلْكِتَـٰبِ ۖ حَتَّىٰٓ","جَآءَتْهُمْ رُسُلُنَا يَتَوَفَّوْنَهُمْ",23],["7:38:20",155,"إِذَا","when","لَّعَنَتْ أُخْتَهَا ۖ حَتَّىٰٓ","ٱدَّارَكُوا۟ فِيهَا جَمِيعًۭا",23],["7:47:1",156,"۞ وَإِذَا","And when","","صُرِفَتْ أَبْصَـٰرُهُمْ تِلْقَآءَ",23],["7:57:10",157,"إِذَآ","when","يَدَىْ رَحْمَتِهِۦ ۖ حَتَّىٰٓ","أَقَلَّتْ سَحَابًۭا ثِقَالًۭا",23],["7:131:1",166,"فَإِذَا","But when","","جَآءَتْهُمُ ٱلْحَسَنَةُ قَالُوا۟",23],["7:135:9",166,"إِذَا","then","أَجَلٍ هُم بَـٰلِغُوهُ","هُمْ يَنكُثُونَ",23],["7:201:4",176,"إِذَا","when","إِنَّ ٱلَّذِينَ ٱتَّقَوْا۟","مَسَّهُمْ طَـٰٓئِفٌۭ مِّنَ",23],["7:201:10",176,"فَإِذَا","and then","مِّنَ ٱلشَّيْطَـٰنِ تَذَكَّرُوا۟","هُم مُّبْصِرُونَ",23],["7:203:1",176,"وَإِذَا","And when","","لَمْ تَأْتِهِم بِـَٔايَةٍۢ",23],["7:204:1",176,"وَإِذَا","And when","","قُرِئَ ٱلْقُرْءَانُ فَٱسْتَمِعُوا۟",23],["8:2:4",177,"إِذَا","when","إِنَّمَا ٱلْمُؤْمِنُونَ ٱلَّذِينَ","ذُكِرَ ٱللَّهُ وَجِلَتْ",23],["8:2:9",177,"وَإِذَا","and when","ٱللَّهُ وَجِلَتْ قُلُوبُهُمْ","تُلِيَتْ عَلَيْهِمْ ءَايَـٰتُهُۥ",23],["8:15:4",178,"إِذَا","When","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟","لَقِيتُمُ ٱلَّذِينَ كَفَرُوا۟",23],["8:24:7",179,"إِذَا","when","ٱسْتَجِيبُوا۟ لِلَّهِ وَلِلرَّسُولِ","دَعَاكُمْ لِمَا يُحْيِيكُمْ ۖ",23],["8:31:1",180,"وَإِذَا","And when","","تُتْلَىٰ عَلَيْهِمْ ءَايَـٰتُنَا",23],["8:45:4",182,"إِذَا","When","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟","لَقِيتُمْ فِئَةًۭ فَٱثْبُتُوا۟",23],["9:5:1",187,"فَإِذَا","Then when","","ٱنسَلَخَ ٱلْأَشْهُرُ ٱلْحُرُمُ",23],["9:38:6",193,"إِذَا","when","ءَامَنُوا۟ مَا لَكُمْ","قِيلَ لَكُمُ ٱنفِرُوا۟",23],["9:58:14",196,"إِذَا","then","لَّمْ يُعْطَوْا۟ مِنْهَآ","هُمْ يَسْخَطُونَ",23],["9:86:1",200,"وَإِذَآ","And when","","أُنزِلَتْ سُورَةٌ أَنْ",23],["9:91:15",201,"إِذَا","if","مَا يُنفِقُونَ حَرَجٌ","نَصَحُوا۟ لِلَّهِ وَرَسُولِهِۦ ۚ",23],["9:92:4",201,"إِذَا","when","وَلَا عَلَى ٱلَّذِينَ","مَآ أَتَوْكَ لِتَحْمِلَهُمْ",23],["9:94:3",202,"إِذَا","when","يَعْتَذِرُونَ إِلَيْكُمْ","رَجَعْتُمْ إِلَيْهِمْ ۚ قُل",23],["9:95:4",202,"إِذَا","when","سَيَحْلِفُونَ بِٱللَّهِ لَكُمْ","ٱنقَلَبْتُمْ إِلَيْهِمْ لِتُعْرِضُوا۟",23],["9:118:6",206,"إِذَا","when","ٱلَّذِينَ خُلِّفُوا۟ حَتَّىٰٓ","ضَاقَتْ عَلَيْهِمُ ٱلْأَرْضُ",23],["9:122:18",206,"إِذَا","when","ٱلدِّينِ وَلِيُنذِرُوا۟ قَوْمَهُمْ","رَجَعُوٓا۟ إِلَيْهِمْ لَعَلَّهُمْ",23],["9:124:1",207,"وَإِذَا","And whenever","","مَآ أُنزِلَتْ سُورَةٌۭ",23],["9:127:1",207,"وَإِذَا","And whenever","","مَآ أُنزِلَتْ سُورَةٌۭ",23],["10:12:1",209,"وَإِذَا","And when","","مَسَّ ٱلْإِنسَـٰنَ ٱلضُّرُّ",23],["10:15:1",210,"وَإِذَا","And when","","تُتْلَىٰ عَلَيْهِمْ ءَايَاتُنَا",23],["10:21:1",211,"وَإِذَآ","And when","","أَذَقْنَا ٱلنَّاسَ رَحْمَةًۭ",23],["10:22:8",211,"إِذَا","when","ٱلْبَرِّ وَٱلْبَحْرِ ۖ حَتَّىٰٓ","كُنتُمْ فِى ٱلْفُلْكِ",23],["10:24:18",211,"إِذَآ","when","ٱلنَّاسُ وَٱلْأَنْعَـٰمُ حَتَّىٰٓ","أَخَذَتِ ٱلْأَرْضُ زُخْرُفَهَا",23],["10:47:4",214,"فَإِذَا","So when","وَلِكُلِّ أُمَّةٍۢ رَّسُولٌۭ ۖ","جَآءَ رَسُولُهُمْ قُضِىَ",23],["10:49:15",214,"إِذَا","When","لِكُلِّ أُمَّةٍ أَجَلٌ ۚ","جَآءَ أَجَلُهُمْ فَلَا",23],["10:51:2",214,"إِذَا","when","أَثُمَّ","مَا وَقَعَ ءَامَنتُم",23],["10:90:11",219,"إِذَآ","when","بَغْيًۭا وَعَدْوًا ۖ حَتَّىٰٓ","أَدْرَكَهُ ٱلْغَرَقُ قَالَ",23],["11:40:2",226,"إِذَا","when","حَتَّىٰٓ","جَآءَ أَمْرُنَا وَفَارَ",23],["11:102:4",233,"إِذَآ","when","وَكَذَٰلِكَ أَخْذُ رَبِّكَ","أَخَذَ ٱلْقُرَىٰ وَهِىَ",23],["12:62:9",242,"إِذَا","when","رِحَالِهِمْ لَعَلَّهُمْ يَعْرِفُونَهَآ","ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمْ",23],["12:110:2",248,"إِذَا","when","حَتَّىٰٓ","ٱسْتَيْـَٔسَ ٱلرُّسُلُ وَظَنُّوٓا۟",23],["13:5:5",249,"أَءِذَا","When","تَعْجَبْ فَعَجَبٌۭ قَوْلُهُمْ","كُنَّا تُرَٰبًا أَءِنَّا",23],["13:11:22",250,"وَإِذَآ","And when","يُغَيِّرُوا۟ مَا بِأَنفُسِهِمْ ۗ","أَرَادَ ٱللَّهُ بِقَوْمٍۢ",23],["15:29:1",263,"فَإِذَا","So, when","","سَوَّيْتُهُۥ وَنَفَخْتُ فِيهِ",23],["16:4:5",267,"فَإِذَا","then behold","ٱلْإِنسَـٰنَ مِن نُّطْفَةٍۢ","هُوَ خَصِيمٌۭ مُّبِينٌۭ",23],["16:24:1",269,"وَإِذَا","And when","","قِيلَ لَهُم مَّاذَآ",23],["16:40:4",271,"إِذَآ","when","إِنَّمَا قَوْلُنَا لِشَىْءٍ","أَرَدْنَـٰهُ أَن نَّقُولَ",23],["16:53:8",272,"إِذَا","when","فَمِنَ ٱللَّهِ ۖ ثُمَّ","مَسَّكُمُ ٱلضُّرُّ فَإِلَيْهِ",23],["16:54:2",272,"إِذَا","when","ثُمَّ","كَشَفَ ٱلضُّرَّ عَنكُمْ",23],["16:54:6",272,"إِذَا","behold","كَشَفَ ٱلضُّرَّ عَنكُمْ","فَرِيقٌۭ مِّنكُم بِرَبِّهِمْ",23],["16:58:1",273,"وَإِذَا","And when","","بُشِّرَ أَحَدُهُم بِٱلْأُنثَىٰ",23],["16:61:16",273,"فَإِذَا","Then when","إِلَىٰٓ أَجَلٍۢ مُّسَمًّۭى ۖ","جَآءَ أَجَلُهُمْ لَا",23],["16:85:1",276,"وَإِذَا","And when","","رَءَا ٱلَّذِينَ ظَلَمُوا۟",23],["16:86:1",276,"وَإِذَا","And when","","رَءَا ٱلَّذِينَ أَشْرَكُوا۟",23],["16:91:4",277,"إِذَا","when","وَأَوْفُوا۟ بِعَهْدِ ٱللَّهِ","عَـٰهَدتُّمْ وَلَا تَنقُضُوا۟",23],["16:98:1",278,"فَإِذَا","So when","","قَرَأْتَ ٱلْقُرْءَانَ فَٱسْتَعِذْ",23],["16:101:1",278,"وَإِذَا","And when","","بَدَّلْنَآ ءَايَةًۭ مَّكَانَ",23],["17:5:1",282,"فَإِذَا","So when","","جَآءَ وَعْدُ أُولَىٰهُمَا",23],["17:7:8",282,"فَإِذَا","So when","وَإِنْ أَسَأْتُمْ فَلَهَا ۚ","جَآءَ وَعْدُ ٱلْـَٔاخِرَةِ",23],["17:16:1",283,"وَإِذَآ","And when","","أَرَدْنَآ أَن نُّهْلِكَ",23],["17:35:3",285,"إِذَا","when","وَأَوْفُوا۟ ٱلْكَيْلَ","كِلْتُمْ وَزِنُوا۟ بِٱلْقِسْطَاسِ",23],["17:45:1",286,"وَإِذَا","And when","","قَرَأْتَ ٱلْقُرْءَانَ جَعَلْنَا",23],["17:46:10",286,"وَإِذَا","And when","وَفِىٓ ءَاذَانِهِمْ وَقْرًۭا ۚ","ذَكَرْتَ رَبَّكَ فِى",23],["17:49:2",286,"أَءِذَا","Is it when","وَقَالُوٓا۟","كُنَّا عِظَـٰمًۭا وَرُفَـٰتًا",23],["17:67:1",289,"وَإِذَا","And when","","مَسَّكُمُ ٱلضُّرُّ فِى",23],["17:83:1",290,"وَإِذَآ","And when","","أَنْعَمْنَا عَلَى ٱلْإِنسَـٰنِ",23],["17:83:8",290,"وَإِذَا","And when","أَعْرَضَ وَنَـَٔا بِجَانِبِهِۦ ۖ","مَسَّهُ ٱلشَّرُّ كَانَ",23],["17:98:7",292,"أَءِذَا","When","كَفَرُوا۟ بِـَٔايَـٰتِنَا وَقَالُوٓا۟","كُنَّا عِظَـٰمًۭا وَرُفَـٰتًا",23],["17:104:8",292,"فَإِذَا","then when","إِسْرَٰٓءِيلَ ٱسْكُنُوا۟ ٱلْأَرْضَ","جَآءَ وَعْدُ ٱلْـَٔاخِرَةِ",23],["17:107:13",293,"إِذَا","when","ٱلْعِلْمَ مِن قَبْلِهِۦٓ","يُتْلَىٰ عَلَيْهِمْ يَخِرُّونَ",23],["18:17:3",295,"إِذَا","when","۞ وَتَرَى ٱلشَّمْسَ","طَلَعَت تَّزَٰوَرُ عَن",23],["18:17:10",295,"وَإِذَا","and when","كَهْفِهِمْ ذَاتَ ٱلْيَمِينِ","غَرَبَت تَّقْرِضُهُمْ ذَاتَ",23],["18:24:7",296,"إِذَا","when","ٱللَّهُ ۚ وَٱذْكُر رَّبَّكَ","نَسِيتَ وَقُلْ عَسَىٰٓ",23],["18:71:3",301,"إِذَا","when","فَٱنطَلَقَا حَتَّىٰٓ","رَكِبَا فِى ٱلسَّفِينَةِ",23],["18:74:3",301,"إِذَا","when","فَٱنطَلَقَا حَتَّىٰٓ","لَقِيَا غُلَـٰمًۭا فَقَتَلَهُۥ",23],["18:77:3",302,"إِذَآ","when","فَٱنطَلَقَا حَتَّىٰٓ","أَتَيَآ أَهْلَ قَرْيَةٍ",23],["18:86:2",303,"إِذَا","when","حَتَّىٰٓ","بَلَغَ مَغْرِبَ ٱلشَّمْسِ",23],["18:90:2",303,"إِذَا","when","حَتَّىٰٓ","بَلَغَ مَطْلِعَ ٱلشَّمْسِ",23],["18:93:2",303,"إِذَا","when","حَتَّىٰٓ","بَلَغَ بَيْنَ ٱلسَّدَّيْنِ",23],["18:96:5",303,"إِذَا","when","زُبَرَ ٱلْحَدِيدِ ۖ حَتَّىٰٓ","سَاوَىٰ بَيْنَ ٱلصَّدَفَيْنِ",23],["18:96:12",303,"إِذَا","when","قَالَ ٱنفُخُوا۟ ۖ حَتَّىٰٓ","جَعَلَهُۥ نَارًۭا قَالَ",23],["18:98:6",304,"فَإِذَا","But when","رَحْمَةٌۭ مِّن رَّبِّى ۖ","جَآءَ وَعْدُ رَبِّى",23],["19:35:9",307,"إِذَا","When","مِن وَلَدٍۢ ۖ سُبْحَـٰنَهُۥٓ ۚ","قَضَىٰٓ أَمْرًۭا فَإِنَّمَا",23],["19:58:22",309,"إِذَا","When","وَمِمَّنْ هَدَيْنَا وَٱجْتَبَيْنَآ ۚ","تُتْلَىٰ عَلَيْهِمْ ءَايَـٰتُ",23],["19:66:3",310,"أَءِذَا","What! When","وَيَقُولُ ٱلْإِنسَـٰنُ","مَا مِتُّ لَسَوْفَ",23],["19:73:1",310,"وَإِذَا","And when","","تُتْلَىٰ عَلَيْهِمْ ءَايَـٰتُنَا",23],["19:75:11",310,"إِذَا","when","ٱلرَّحْمَـٰنُ مَدًّا ۚ حَتَّىٰٓ","رَأَوْا۟ مَا يُوعَدُونَ",23],["21:12:4",323,"إِذَا","behold","فَلَمَّآ أَحَسُّوا۟ بَأْسَنَآ","هُم مِّنْهَا يَرْكُضُونَ",23],["21:18:7",323,"فَإِذَا","behold","عَلَى ٱلْبَـٰطِلِ فَيَدْمَغُهُۥ","هُوَ زَاهِقٌۭ ۚ وَلَكُمُ",23],["21:36:1",325,"وَإِذَا","And when","","رَءَاكَ ٱلَّذِينَ كَفَرُوٓا۟",23],["21:45:9",326,"إِذَا","when","يَسْمَعُ ٱلصُّمُّ ٱلدُّعَآءَ","مَا يُنذَرُونَ",23],["21:96:2",330,"إِذَا","when","حَتَّىٰٓ","فُتِحَتْ يَأْجُوجُ وَمَأْجُوجُ",23],["21:97:4",330,"فَإِذَا","then behold","وَٱقْتَرَبَ ٱلْوَعْدُ ٱلْحَقُّ","هِىَ شَـٰخِصَةٌ أَبْصَـٰرُ",23],["22:5:59",332,"فَإِذَآ","then when","وَتَرَى ٱلْأَرْضَ هَامِدَةًۭ","أَنزَلْنَا عَلَيْهَا ٱلْمَآءَ",23],["22:35:2",336,"إِذَا","when","ٱلَّذِينَ","ذُكِرَ ٱللَّهُ وَجِلَتْ",23],["22:36:15",336,"فَإِذَا","and when","ٱللَّهِ عَلَيْهَا صَوَآفَّ ۖ","وَجَبَتْ جُنُوبُهَا فَكُلُوا۟",23],["22:52:10",338,"إِذَا","when","وَلَا نَبِىٍّ إِلَّآ","تَمَنَّىٰٓ أَلْقَى ٱلشَّيْطَـٰنُ",23],["22:72:1",340,"وَإِذَا","And when","","تُتْلَىٰ عَلَيْهِمْ ءَايَـٰتُنَا",23],["23:27:8",343,"فَإِذَا","then when","ٱلْفُلْكَ بِأَعْيُنِنَا وَوَحْيِنَا","جَآءَ أَمْرُنَا وَفَارَ",23],["23:28:1",344,"فَإِذَا","And when","","ٱسْتَوَيْتَ أَنتَ وَمَن",23],["23:35:3",344,"إِذَا","when","أَيَعِدُكُمْ أَنَّكُمْ","مِتُّمْ وَكُنتُمْ تُرَابًۭا",23],["23:64:2",346,"إِذَآ","when","حَتَّىٰٓ","أَخَذْنَا مُتْرَفِيهِم بِٱلْعَذَابِ",23],["23:64:6",346,"إِذَا","behold","أَخَذْنَا مُتْرَفِيهِم بِٱلْعَذَابِ","هُمْ يَجْـَٔرُونَ",23],["23:77:2",347,"إِذَا","when","حَتَّىٰٓ","فَتَحْنَا عَلَيْهِم بَابًۭا",23],["23:77:9",347,"إِذَا","behold","ذَا عَذَابٍۢ شَدِيدٍ","هُمْ فِيهِ مُبْلِسُونَ",23],["23:82:2",347,"أَءِذَا","What! When","قَالُوٓا۟","مِتْنَا وَكُنَّا تُرَابًۭا",23],["23:99:2",348,"إِذَا","when","حَتَّىٰٓ","جَآءَ أَحَدَهُمُ ٱلْمَوْتُ",23],["23:101:1",348,"فَإِذَا","So when","","نُفِخَ فِى ٱلصُّورِ",23],["24:39:10",355,"إِذَا","when","ٱلظَّمْـَٔانُ مَآءً حَتَّىٰٓ","جَآءَهُۥ لَمْ يَجِدْهُ",23],["24:40:18",355,"إِذَآ","When","بَعْضُهَا فَوْقَ بَعْضٍ","أَخْرَجَ يَدَهُۥ لَمْ",23],["24:48:1",356,"وَإِذَا","And when","","دُعُوٓا۟ إِلَى ٱللَّهِ",23],["24:48:8",356,"إِذَا","behold","وَرَسُولِهِۦ لِيَحْكُمَ بَيْنَهُمْ","فَرِيقٌۭ مِّنْهُم مُّعْرِضُونَ",23],["24:51:5",356,"إِذَا","when","كَانَ قَوْلَ ٱلْمُؤْمِنِينَ","دُعُوٓا۟ إِلَى ٱللَّهِ",23],["24:59:1",358,"وَإِذَا","And when","","بَلَغَ ٱلْأَطْفَـٰلُ مِنكُمُ",23],["24:61:58",358,"فَإِذَا","But when","جَمِيعًا أَوْ أَشْتَاتًۭا ۚ","دَخَلْتُم بُيُوتًۭا فَسَلِّمُوا۟",23],["24:62:7",359,"وَإِذَا","and when","ءَامَنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ","كَانُوا۟ مَعَهُۥ عَلَىٰٓ",23],["24:62:25",359,"فَإِذَا","So when","يُؤْمِنُونَ بِٱللَّهِ وَرَسُولِهِۦ ۚ","ٱسْتَـْٔذَنُوكَ لِبَعْضِ شَأْنِهِمْ",23],["25:12:1",361,"إِذَا","When","","رَأَتْهُم مِّن مَّكَانٍۭ",23],["25:13:1",361,"وَإِذَآ","And when","","أُلْقُوا۟ مِنْهَا مَكَانًۭا",23],["25:41:1",363,"وَإِذَا","And when","","رَأَوْكَ إِن يَتَّخِذُونَكَ",23],["25:60:1",365,"وَإِذَا","And when","","قِيلَ لَهُمُ ٱسْجُدُوا۟",23],["25:63:8",365,"وَإِذَا","and when","عَلَى ٱلْأَرْضِ هَوْنًۭا","خَاطَبَهُمُ ٱلْجَـٰهِلُونَ قَالُوا۟",23],["25:67:2",365,"إِذَآ","when","وَٱلَّذِينَ","أَنفَقُوا۟ لَمْ يُسْرِفُوا۟",23],["25:72:5",366,"وَإِذَا","and when","لَا يَشْهَدُونَ ٱلزُّورَ","مَرُّوا۟ بِٱللَّغْوِ مَرُّوا۟",23],["25:73:2",366,"إِذَا","when","وَٱلَّذِينَ","ذُكِّرُوا۟ بِـَٔايَـٰتِ رَبِّهِمْ",23],["26:32:3",368,"فَإِذَا","and behold","فَأَلْقَىٰ عَصَاهُ","هِىَ ثُعْبَانٌۭ مُّبِينٌۭ",23],["26:33:3",368,"فَإِذَا","and behold","وَنَزَعَ يَدَهُۥ","هِىَ بَيْضَآءُ لِلنَّـٰظِرِينَ",23],["26:45:4",369,"فَإِذَا","and behold","فَأَلْقَىٰ مُوسَىٰ عَصَاهُ","هِىَ تَلْقَفُ مَا",23],["26:80:1",370,"وَإِذَا","And when","","مَرِضْتُ فَهُوَ يَشْفِينِ",23],["26:130:1",372,"وَإِذَا","And when","","بَطَشْتُم بَطَشْتُمْ جَبَّارِينَ",23],["27:18:2",378,"إِذَآ","when","حَتَّىٰٓ","أَتَوْا۟ عَلَىٰ وَادِ",23],["27:34:4",379,"إِذَا","when","قَالَتْ إِنَّ ٱلْمُلُوكَ","دَخَلُوا۟ قَرْيَةً أَفْسَدُوهَا",23],["27:45:10",381,"فَإِذَا","Then behold","أَنِ ٱعْبُدُوا۟ ٱللَّهَ","هُمْ فَرِيقَانِ يَخْتَصِمُونَ",23],["27:62:4",382,"إِذَا","when","أَمَّن يُجِيبُ ٱلْمُضْطَرَّ","دَعَاهُ وَيَكْشِفُ ٱلسُّوٓءَ",23],["27:67:4",383,"أَءِذَا","What, when","وَقَالَ ٱلَّذِينَ كَفَرُوٓا۟","كُنَّا تُرَٰبًۭا وَءَابَآؤُنَآ",23],["27:80:9",384,"إِذَا","when","تُسْمِعُ ٱلصُّمَّ ٱلدُّعَآءَ","وَلَّوْا۟ مُدْبِرِينَ",23],["27:82:1",384,"۞ وَإِذَا","And when","","وَقَعَ ٱلْقَوْلُ عَلَيْهِمْ",23],["27:84:2",384,"إِذَا","when","حَتَّىٰٓ","جَآءُو قَالَ أَكَذَّبْتُم",23],["28:7:7",386,"فَإِذَا","but when","مُوسَىٰٓ أَنْ أَرْضِعِيهِ ۖ","خِفْتِ عَلَيْهِ فَأَلْقِيهِ",23],["28:18:6",387,"فَإِذَا","when behold","ٱلْمَدِينَةِ خَآئِفًۭا يَتَرَقَّبُ","ٱلَّذِى ٱسْتَنصَرَهُۥ بِٱلْأَمْسِ",23],["28:53:1",392,"وَإِذَا","And when","","يُتْلَىٰ عَلَيْهِمْ قَالُوٓا۟",23],["28:55:1",392,"وَإِذَا","And when","","سَمِعُوا۟ ٱللَّغْوَ أَعْرَضُوا۟",23],["29:10:7",397,"فَإِذَآ","But when","يَقُولُ ءَامَنَّا بِٱللَّهِ","أُوذِىَ فِى ٱللَّهِ",23],["29:65:1",404,"فَإِذَا","And when","","رَكِبُوا۟ فِى ٱلْفُلْكِ",23],["30:20:8",406,"إِذَآ","behold","مِّن تُرَابٍۢ ثُمَّ","أَنتُم بَشَرٌۭ تَنتَشِرُونَ",23],["30:25:9",407,"إِذَا","when","وَٱلْأَرْضُ بِأَمْرِهِۦ ۚ ثُمَّ","دَعَاكُمْ دَعْوَةًۭ مِّنَ",23],["30:33:1",408,"وَإِذَا","And when","","مَسَّ ٱلنَّاسَ ضُرٌّۭ",23],["30:33:10",408,"إِذَآ","when","مُّنِيبِينَ إِلَيْهِ ثُمَّ","أَذَاقَهُم مِّنْهُ رَحْمَةً",23],["30:33:14",408,"إِذَا","behold","أَذَاقَهُم مِّنْهُ رَحْمَةً","فَرِيقٌۭ مِّنْهُم بِرَبِّهِمْ",23],["30:36:1",408,"وَإِذَآ","And when","","أَذَقْنَا ٱلنَّاسَ رَحْمَةًۭ",23],["30:48:19",409,"فَإِذَآ","Then when","يَخْرُجُ مِنْ خِلَـٰلِهِۦ ۖ","أَصَابَ بِهِۦ مَن",23],["30:48:26",409,"إِذَا","behold","يَشَآءُ مِنْ عِبَادِهِۦٓ","هُمْ يَسْتَبْشِرُونَ",23],["30:52:9",410,"إِذَا","when","تُسْمِعُ ٱلصُّمَّ ٱلدُّعَآءَ","وَلَّوْا۟ مُدْبِرِينَ",23],["31:7:1",411,"وَإِذَا","And when","","تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا",23],["31:21:1",413,"وَإِذَا","And when","","قِيلَ لَهُمُ ٱتَّبِعُوا۟",23],["31:32:1",414,"وَإِذَا","And when","","غَشِيَهُم مَّوْجٌۭ كَٱلظُّلَلِ",23],["32:10:2",415,"أَءِذَا","Is (it) when","وَقَالُوٓا۟","ضَلَلْنَا فِى ٱلْأَرْضِ",23],["32:15:5",416,"إِذَا","when","يُؤْمِنُ بِـَٔايَـٰتِنَا ٱلَّذِينَ","ذُكِّرُوا۟ بِهَا خَرُّوا۟",23],["33:19:3",420,"فَإِذَا","But when","أَشِحَّةً عَلَيْكُمْ ۖ","جَآءَ ٱلْخَوْفُ رَأَيْتَهُمْ",23],["33:19:16",420,"فَإِذَا","But when","عَلَيْهِ مِنَ ٱلْمَوْتِ ۖ","ذَهَبَ ٱلْخَوْفُ سَلَقُوكُم",23],["33:36:6",423,"إِذَا","when","لِمُؤْمِنٍۢ وَلَا مُؤْمِنَةٍ","قَضَى ٱللَّهُ وَرَسُولُهُۥٓ",23],["33:37:41",423,"إِذَا","when","فِىٓ أَزْوَٰجِ أَدْعِيَآئِهِمْ","قَضَوْا۟ مِنْهُنَّ وَطَرًۭا ۚ",23],["33:49:4",424,"إِذَا","When","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟","نَكَحْتُمُ ٱلْمُؤْمِنَـٰتِ ثُمَّ",23],["33:53:18",425,"إِذَا","when","نَـٰظِرِينَ إِنَىٰهُ وَلَـٰكِنْ","دُعِيتُمْ فَٱدْخُلُوا۟ فَإِذَا",23],["33:53:21",425,"فَإِذَا","and when","إِذَا دُعِيتُمْ فَٱدْخُلُوا۟","طَعِمْتُمْ فَٱنتَشِرُوا۟ وَلَا",23],["33:53:39",425,"وَإِذَا","And when","يَسْتَحْىِۦ مِنَ ٱلْحَقِّ ۚ","سَأَلْتُمُوهُنَّ مَتَـٰعًۭا فَسْـَٔلُوهُنَّ",23],["34:7:9",428,"إِذَا","when","عَلَىٰ رَجُلٍۢ يُنَبِّئُكُمْ","مُزِّقْتُمْ كُلَّ مُمَزَّقٍ",23],["34:23:10",431,"إِذَا","when","أَذِنَ لَهُۥ ۚ حَتَّىٰٓ","فُزِّعَ عَن قُلُوبِهِمْ",23],["34:43:1",433,"وَإِذَا","And when","","تُتْلَىٰ عَلَيْهِمْ ءَايَـٰتُنَا",23],["35:45:18",440,"فَإِذَا","And when","إِلَىٰٓ أَجَلٍۢ مُّسَمًّۭى ۖ","جَآءَ أَجَلُهُمْ فَإِنَّ",23],["36:37:7",442,"فَإِذَا","Then behold","نَسْلَخُ مِنْهُ ٱلنَّهَارَ","هُم مُّظْلِمُونَ",23],["36:45:1",443,"وَإِذَا","And when","","قِيلَ لَهُمُ ٱتَّقُوا۟",23],["36:47:1",443,"وَإِذَا","And when","","قِيلَ لَهُمْ أَنفِقُوا۟",23],["36:51:4",443,"فَإِذَا","and behold","وَنُفِخَ فِى ٱلصُّورِ","هُم مِّنَ ٱلْأَجْدَاثِ",23],["36:53:6",443,"فَإِذَا","so behold","إِلَّا صَيْحَةًۭ وَٰحِدَةًۭ","هُمْ جَمِيعٌۭ لَّدَيْنَا",23],["36:77:8",445,"فَإِذَا","Then behold","خَلَقْنَـٰهُ مِن نُّطْفَةٍۢ","هُوَ خَصِيمٌۭ مُّبِينٌۭ",23],["36:80:8",445,"فَإِذَآ","and behold","ٱلشَّجَرِ ٱلْأَخْضَرِ نَارًۭا","أَنتُم مِّنْهُ تُوقِدُونَ",23],["36:82:3",445,"إِذَآ","when","إِنَّمَآ أَمْرُهُۥٓ","أَرَادَ شَيْـًٔا أَن",23],["37:13:1",446,"وَإِذَا","And when","","ذُكِّرُوا۟ لَا يَذْكُرُونَ",23],["37:14:1",446,"وَإِذَا","And when","","رَأَوْا۟ ءَايَةًۭ يَسْتَسْخِرُونَ",23],["37:16:1",446,"أَءِذَا","Is it when","","مِتْنَا وَكُنَّا تُرَابًۭا",23],["37:19:5",446,"فَإِذَا","then, behold","هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ","هُمْ يَنظُرُونَ",23],["37:35:3",447,"إِذَا","when","إِنَّهُمْ كَانُوٓا۟","قِيلَ لَهُمْ لَآ",23],["37:53:1",448,"أَءِذَا","Is (it) when","","مِتْنَا وَكُنَّا تُرَابًۭا",23],["37:177:1",452,"فَإِذَا","But when","","نَزَلَ بِسَاحَتِهِمْ فَسَآءَ",23],["38:72:1",457,"فَإِذَا","So when","","سَوَّيْتُهُۥ وَنَفَخْتُ فِيهِ",23],["39:8:1",459,"۞ وَإِذَا","And when","","مَسَّ ٱلْإِنسَـٰنَ ضُرٌّۭ",23],["39:8:10",459,"إِذَا","when","مُنِيبًا إِلَيْهِ ثُمَّ","خَوَّلَهُۥ نِعْمَةًۭ مِّنْهُ",23],["39:45:1",463,"وَإِذَا","And when","","ذُكِرَ ٱللَّهُ وَحْدَهُ",23],["39:45:11",463,"وَإِذَا","and when","لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ ۖ","ذُكِرَ ٱلَّذِينَ مِن",23],["39:45:16",463,"إِذَا","behold","ٱلَّذِينَ مِن دُونِهِۦٓ","هُمْ يَسْتَبْشِرُونَ",23],["39:49:1",464,"فَإِذَا","So when","","مَسَّ ٱلْإِنسَـٰنَ ضُرٌّۭ",23],["39:49:7",464,"إِذَا","when","ضُرٌّۭ دَعَانَا ثُمَّ","خَوَّلْنَـٰهُ نِعْمَةًۭ مِّنَّا",23],["39:68:19",466,"فَإِذَا","and behold","نُفِخَ فِيهِ أُخْرَىٰ","هُمْ قِيَامٌۭ يَنظُرُونَ",23],["39:71:8",466,"إِذَا","when","جَهَنَّمَ زُمَرًا ۖ حَتَّىٰٓ","جَآءُوهَا فُتِحَتْ أَبْوَٰبُهَا",23],["39:73:9",466,"إِذَا","when","ٱلْجَنَّةِ زُمَرًا ۖ حَتَّىٰٓ","جَآءُوهَا وَفُتِحَتْ أَبْوَٰبُهَا",23],["40:12:3",468,"إِذَا","when","ذَٰلِكُم بِأَنَّهُۥٓ","دُعِىَ ٱللَّهُ وَحْدَهُۥ",23],["40:34:15",471,"إِذَا","when","جَآءَكُم بِهِۦ ۖ حَتَّىٰٓ","هَلَكَ قُلْتُمْ لَن",23],["40:68:5",475,"فَإِذَا","And when","ٱلَّذِى يُحْىِۦ وَيُمِيتُ ۖ","قَضَىٰٓ أَمْرًۭا فَإِنَّمَا",23],["40:78:24",476,"فَإِذَا","So when","إِلَّا بِإِذْنِ ٱللَّهِ ۚ","جَآءَ أَمْرُ ٱللَّهِ",23],["41:20:2",478,"إِذَا","when","حَتَّىٰٓ","مَا جَآءُوهَا شَهِدَ",23],["41:34:10",480,"فَإِذَا","then behold","بِٱلَّتِى هِىَ أَحْسَنُ","ٱلَّذِى بَيْنَكَ وَبَيْنَهُۥ",23],["41:39:7",481,"فَإِذَآ","but when","تَرَى ٱلْأَرْضَ خَـٰشِعَةًۭ","أَنزَلْنَا عَلَيْهَا ٱلْمَآءَ",23],["41:51:1",482,"وَإِذَآ","And when","","أَنْعَمْنَا عَلَى ٱلْإِنسَـٰنِ",23],["41:51:8",482,"وَإِذَا","but when","أَعْرَضَ وَنَـَٔا بِجَانِبِهِۦ","مَسَّهُ ٱلشَّرُّ فَذُو",23],["42:29:14",486,"إِذَا","when","وَهُوَ عَلَىٰ جَمْعِهِمْ","يَشَآءُ قَدِيرٌۭ",23],["42:37:6",487,"وَإِذَا","and when","كَبَـٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ","مَا غَضِبُوا۟ هُمْ",23],["42:39:2",487,"إِذَآ","when","وَٱلَّذِينَ","أَصَابَهُمُ ٱلْبَغْىُ هُمْ",23],["42:48:12",488,"إِذَآ","when","إِلَّا ٱلْبَلَـٰغُ ۗ وَإِنَّآ","أَذَقْنَا ٱلْإِنسَـٰنَ مِنَّا",23],["43:13:8",490,"إِذَا","when","تَذْكُرُوا۟ نِعْمَةَ رَبِّكُمْ","ٱسْتَوَيْتُمْ عَلَيْهِ وَتَقُولُوا۟",23],["43:17:1",490,"وَإِذَا","And when","","بُشِّرَ أَحَدُهُم بِمَا",23],["43:38:2",492,"إِذَا","when","حَتَّىٰٓ","جَآءَنَا قَالَ يَـٰلَيْتَ",23],["43:47:4",492,"إِذَا","behold","فَلَمَّا جَآءَهُم بِـَٔايَـٰتِنَآ","هُم مِّنْهَا يَضْحَكُونَ",23],["43:50:5",493,"إِذَا","behold","كَشَفْنَا عَنْهُمُ ٱلْعَذَابَ","هُمْ يَنكُثُونَ",23],["43:57:6",493,"إِذَا","behold","ٱبْنُ مَرْيَمَ مَثَلًا","قَوْمُكَ مِنْهُ يَصِدُّونَ",23],["45:9:1",499,"وَإِذَا","And when","","عَلِمَ مِنْ ءَايَـٰتِنَا",23],["45:25:1",501,"وَإِذَا","And when","","تُتْلَىٰ عَلَيْهِمْ ءَايَـٰتُنَا",23],["45:32:1",501,"وَإِذَا","And when","","قِيلَ إِنَّ وَعْدَ",23],["46:6:1",503,"وَإِذَا","And when","","حُشِرَ ٱلنَّاسُ كَانُوا۟",23],["46:7:1",503,"وَإِذَا","And when","","تُتْلَىٰ عَلَيْهِمْ ءَايَـٰتُنَا",23],["46:15:15",504,"إِذَا","when","ثَلَـٰثُونَ شَهْرًا ۚ حَتَّىٰٓ","بَلَغَ أَشُدَّهُۥ وَبَلَغَ",23],["47:4:1",507,"فَإِذَا","So when","","لَقِيتُمُ ٱلَّذِينَ كَفَرُوا۟",23],["47:4:8",507,"إِذَآ","when","فَضَرْبَ ٱلرِّقَابِ حَتَّىٰٓ","أَثْخَنتُمُوهُمْ فَشُدُّوا۟ ٱلْوَثَاقَ",23],["47:16:6",508,"إِذَا","when","يَسْتَمِعُ إِلَيْكَ حَتَّىٰٓ","خَرَجُوا۟ مِنْ عِندِكَ",23],["47:18:13",508,"إِذَا","when","أَشْرَاطُهَا ۚ فَأَنَّىٰ لَهُمْ","جَآءَتْهُمْ ذِكْرَىٰهُمْ",23],["47:20:7",509,"فَإِذَآ","But when","لَوْلَا نُزِّلَتْ سُورَةٌۭ ۖ","أُنزِلَتْ سُورَةٌۭ مُّحْكَمَةٌۭ",23],["47:21:4",509,"فَإِذَا","And when","طَاعَةٌۭ وَقَوْلٌۭ مَّعْرُوفٌۭ ۚ","عَزَمَ ٱلْأَمْرُ فَلَوْ",23],["47:27:2",509,"إِذَا","when","فَكَيْفَ","تَوَفَّتْهُمُ ٱلْمَلَـٰٓئِكَةُ يَضْرِبُونَ",23],["48:15:3",512,"إِذَا","when","سَيَقُولُ ٱلْمُخَلَّفُونَ","ٱنطَلَقْتُمْ إِلَىٰ مَغَانِمَ",23],["50:3:1",518,"أَءِذَا","What! When","","مِتْنَا وَكُنَّا تُرَابًۭا ۖ",23],["53:1:2",526,"إِذَا","when","وَٱلنَّجْمِ","هَوَىٰ",23],["53:46:3",528,"إِذَا","when","مِن نُّطْفَةٍ","تُمْنَىٰ",23],["55:37:1",532,"فَإِذَا","Then when","","ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ",23],["56:1:1",534,"إِذَا","W