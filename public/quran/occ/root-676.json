[["13:17:36",251,"فَيَمْكُثُ","remains","مَا يَنفَعُ ٱلنَّاسَ","فِى ٱلْأَرْضِ ۚ كَذَٰلِكَ",1576],["17:106:7",293,"مُكْثٍۢ","intervals","عَلَى ٱلنَّاسِ عَلَىٰ","وَنَزَّلْنَـٰهُ تَنزِيلًۭا",3813],["18:3:1",293,"مَّـٰكِثِينَ","(They will) abide","","فِيهِ أَبَدًۭا",2521],["20:10:6",312,"ٱمْكُثُوٓا۟","Stay here","نَارًۭا فَقَالَ لِأَهْلِهِ","إِنِّىٓ ءَانَسْتُ نَارًۭا",1576],["27:22:1",378,"فَمَكَثَ","So he stayed","","غَيْرَ بَعِيدٍۢ فَقَالَ",1576],["28:29:14",389,"ٱمْكُثُوٓا۟","Stay here","نَارًۭا قَالَ لِأَهْلِهِ","إِنِّىٓ ءَانَسْتُ نَارًۭا",1576],["43:77:8",495,"مَّـٰكِثُونَ","(will) remain","رَبُّكَ ۖ قَالَ إِنَّكُم","",2521]]