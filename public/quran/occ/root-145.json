[["2:37:5",6,"كَلِمَـٰتٍۢ","words","ءَادَمُ مِن رَّبِّهِۦ","فَتَابَ عَلَيْهِ ۚ إِنَّهُۥ",664],["2:75:10",11,"كَلَـٰمَ","(the) words","فَرِيقٌۭ مِّنْهُمْ يَسْمَعُونَ","ٱللَّهِ ثُمَّ يُحَرِّفُونَهُۥ",1567],["2:118:6",18,"يُكَلِّمُنَا","speaks to us","لَا يَعْلَمُونَ لَوْلَا","ٱللَّهُ أَوْ تَأْتِينَآ",515],["2:124:5",19,"بِكَلِمَـٰتٍۢ","with words","ٱبْتَلَىٰٓ إِبْرَٰهِـۧمَ رَبُّهُۥ","فَأَتَمَّهُنَّ ۖ قَالَ إِنِّى",664],["2:174:21",26,"يُكَلِّمُهُمُ","will speak to them","إِلَّا ٱلنَّارَ وَلَا","ٱللَّهُ يَوْمَ ٱلْقِيَـٰمَةِ",515],["2:253:9",42,"كَلَّمَ","spoke","بَعْضٍۢ ۘ مِّنْهُم مَّن","ٱللَّهُ ۖ وَرَفَعَ بَعْضَهُمْ",515],["3:39:13",55,"بِكَلِمَةٍۢ","[of] a Word","يُبَشِّرُكَ بِيَحْيَىٰ مُصَدِّقًۢا","مِّنَ ٱللَّهِ وَسَيِّدًۭا",387],["3:41:9",55,"تُكَلِّمَ","you will speak","قَالَ ءَايَتُكَ أَلَّا","ٱلنَّاسَ ثَلَـٰثَةَ أَيَّامٍ",515],["3:45:8",55,"بِكَلِمَةٍۢ","of a word","إِنَّ ٱللَّهَ يُبَشِّرُكِ","مِّنْهُ ٱسْمُهُ ٱلْمَسِيحُ",387],["3:46:1",56,"وَيُكَلِّمُ","And he will speak","","ٱلنَّاسَ فِى ٱلْمَهْدِ",515],["3:64:6",58,"كَلِمَةٍۢ","a word","ٱلْكِتَـٰبِ تَعَالَوْا۟ إِلَىٰ","سَوَآءٍۭ بَيْنَنَا وَبَيْنَكُمْ",387],["3:77:16",59,"يُكَلِّمُهُمُ","will speak to them","فِى ٱلْـَٔاخِرَةِ وَلَا","ٱللَّهُ وَلَا يَنظُرُ",515],["4:46:5",86,"ٱلْكَلِمَ","the words","ٱلَّذِينَ هَادُوا۟ يُحَرِّفُونَ","عَن مَّوَاضِعِهِۦ وَيَقُولُونَ",1568],["4:164:11",104,"وَكَلَّمَ","And spoke","لَّمْ نَقْصُصْهُمْ عَلَيْكَ ۚ","ٱللَّهُ مُوسَىٰ تَكْلِيمًۭا",515],["4:164:14",104,"تَكْلِيمًۭا","(in a) conversation","وَكَلَّمَ ٱللَّهُ مُوسَىٰ","",4383],["4:171:20",105,"وَكَلِمَتُهُۥٓ","and His word","مَرْيَمَ رَسُولُ ٱللَّهِ","أَلْقَىٰهَآ إِلَىٰ مَرْيَمَ",387],["5:13:9",109,"ٱلْكَلِمَ","the words","قُلُوبَهُمْ قَـٰسِيَةًۭ ۖ يُحَرِّفُونَ","عَن مَّوَاضِعِهِۦ ۙ وَنَسُوا۟",1568],["5:41:28",114,"ٱلْكَلِمَ","the words","لَمْ يَأْتُوكَ ۖ يُحَرِّفُونَ","مِنۢ بَعْدِ مَوَاضِعِهِۦ ۖ",1568],["5:110:16",126,"تُكَلِّمُ","you spoke","أَيَّدتُّكَ بِرُوحِ ٱلْقُدُسِ","ٱلنَّاسَ فِى ٱلْمَهْدِ",515],["6:34:16",131,"لِكَلِمَـٰتِ","(the) words","نَصْرُنَا ۚ وَلَا مُبَدِّلَ","ٱللَّهِ ۚ وَلَقَدْ جَآءَكَ",664],["6:111:6",142,"وَكَلَّمَهُمُ","and spoken to them","نَزَّلْنَآ إِلَيْهِمُ ٱلْمَلَـٰٓئِكَةَ","ٱلْمَوْتَىٰ وَحَشَرْنَا عَلَيْهِمْ",515],["6:115:2",142,"كَلِمَتُ","(the) word","وَتَمَّتْ","رَبِّكَ صِدْقًۭا وَعَدْلًۭا ۚ",387],["6:115:8",142,"لِكَلِمَـٰتِهِۦ ۚ","His words","وَعَدْلًۭا ۚ لَّا مُبَدِّلَ","وَهُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",664],["7:137:13",166,"كَلِمَتُ","(the) word","بَـٰرَكْنَا فِيهَا ۖ وَتَمَّتْ","رَبِّكَ ٱلْحُسْنَىٰ عَلَىٰ",387],["7:143:5",167,"وَكَلَّمَهُۥ","and spoke to him","جَآءَ مُوسَىٰ لِمِيقَـٰتِنَا","رَبُّهُۥ قَالَ رَبِّ",515],["7:144:8",168,"وَبِكَلَـٰمِى","and with My words","عَلَى ٱلنَّاسِ بِرِسَـٰلَـٰتِى","فَخُذْ مَآ ءَاتَيْتُكَ",1567],["7:148:16",168,"يُكَلِّمُهُمْ","speak to them","يَرَوْا۟ أَنَّهُۥ لَا","وَلَا يَهْدِيهِمْ سَبِيلًا ۘ",515],["7:158:28",170,"وَكَلِمَـٰتِهِۦ","and His Words","ٱلَّذِى يُؤْمِنُ بِٱللَّهِ","وَٱتَّبِعُوهُ لَعَلَّكُمْ تَهْتَدُونَ",664],["8:7:20",177,"بِكَلِمَـٰتِهِۦ","by His words","أَن يُحِقَّ ٱلْحَقَّ","وَيَقْطَعَ دَابِرَ ٱلْكَـٰفِرِينَ",664],["9:6:9",187,"كَلَـٰمَ","(the) Words of Allah","فَأَجِرْهُ حَتَّىٰ يَسْمَعَ","ٱللَّهِ ثُمَّ أَبْلِغْهُ",1567],["9:40:33",193,"كَلِمَةَ","(the) word","لَّمْ تَرَوْهَا وَجَعَلَ","ٱلَّذِينَ كَفَرُوا۟ ٱلسُّفْلَىٰ ۗ",387],["9:40:37",193,"وَكَلِمَةُ","while (the) Word","ٱلَّذِينَ كَفَرُوا۟ ٱلسُّفْلَىٰ ۗ","ٱللَّهِ هِىَ ٱلْعُلْيَا ۗ",387],["9:74:7",199,"كَلِمَةَ","(the) word","قَالُوا۟ وَلَقَدْ قَالُوا۟","ٱلْكُفْرِ وَكَفَرُوا۟ بَعْدَ",387],["10:19:9",210,"كَلِمَةٌۭ","a word","وَٰحِدَةًۭ فَٱخْتَلَفُوا۟ ۚ وَلَوْلَا","سَبَقَتْ مِن رَّبِّكَ",387],["10:33:3",212,"كَلِمَتُ","(the) Word","كَذَٰلِكَ حَقَّتْ","رَبِّكَ عَلَى ٱلَّذِينَ",387],["10:64:10",216,"لِكَلِمَـٰتِ","(is there) in the Words","ٱلْـَٔاخِرَةِ ۚ لَا تَبْدِيلَ","ٱللَّهِ ۚ ذَٰلِكَ هُوَ",664],["10:82:4",218,"بِكَلِمَـٰتِهِۦ","by His words","وَيُحِقُّ ٱللَّهُ ٱلْحَقَّ","وَلَوْ كَرِهَ ٱلْمُجْرِمُونَ",664],["10:96:5",219,"كَلِمَتُ","(the) Word","ٱلَّذِينَ حَقَّتْ عَلَيْهِمْ","رَبِّكَ لَا يُؤْمِنُونَ",387],["11:105:4",233,"تَكَلَّمُ","will speak","يَوْمَ يَأْتِ لَا","نَفْسٌ إِلَّا بِإِذْنِهِۦ ۚ",1676],["11:110:8",234,"كَلِمَةٌۭ","(for) a Word","فَٱخْتُلِفَ فِيهِ ۚ وَلَوْلَا","سَبَقَتْ مِن رَّبِّكَ",387],["11:119:8",235,"كَلِمَةُ","(the) Word of your Lord","وَلِذَٰلِكَ خَلَقَهُمْ ۗ وَتَمَّتْ","رَبِّكَ لَأَمْلَأَنَّ جَهَنَّمَ",387],["12:54:8",242,"كَلَّمَهُۥ","he spoke to him","أَسْتَخْلِصْهُ لِنَفْسِى ۖ فَلَمَّا","قَالَ إِنَّكَ ٱلْيَوْمَ",515],["13:31:12",253,"كُلِّمَ","could be made to speak","بِهِ ٱلْأَرْضُ أَوْ","بِهِ ٱلْمَوْتَىٰ ۗ بَل",515],["14:24:7",258,"كَلِمَةًۭ","a word","ضَرَبَ ٱللَّهُ مَثَلًۭا","طَيِّبَةًۭ كَشَجَرَةٍۢ طَيِّبَةٍ",387],["14:26:2",259,"كَلِمَةٍ","(of) a word","وَمَثَلُ","خَبِيثَةٍۢ كَشَجَرَةٍ خَبِيثَةٍ",387],["18:5:9",294,"كَلِمَةًۭ","the word","وَلَا لِـَٔابَآئِهِمْ ۚ كَبُرَتْ","تَخْرُجُ مِنْ أَفْوَٰهِهِمْ ۚ",387],["18:27:10",296,"لِكَلِمَـٰتِهِۦ","His Words","رَبِّكَ ۖ لَا مُبَدِّلَ","وَلَن تَجِدَ مِن",664],["18:109:6",304,"لِّكَلِمَـٰتِ","for (the) Words","كَانَ ٱلْبَحْرُ مِدَادًۭا","رَبِّى لَنَفِدَ ٱلْبَحْرُ",664],["18:109:13",304,"كَلِمَـٰتُ","(the) Words","قَبْلَ أَن تَنفَدَ","رَبِّى وَلَوْ جِئْنَا",664],["19:10:9",305,"تُكَلِّمَ","you will speak","قَالَ ءَايَتُكَ أَلَّا","ٱلنَّاسَ ثَلَـٰثَ لَيَالٍۢ",515],["19:26:16",307,"أُكَلِّمَ","I will speak","لِلرَّحْمَـٰنِ صَوْمًۭا فَلَنْ","ٱلْيَوْمَ إِنسِيًّۭا",515],["19:29:5",307,"نُكَلِّمُ","(can) we speak","إِلَيْهِ ۖ قَالُوا۟ كَيْفَ","مَن كَانَ فِى",515],["20:129:2",321,"كَلِمَةٌۭ","(for) a Word","وَلَوْلَا","سَبَقَتْ مِن رَّبِّكَ",387],["23:100:8",348,"كَلِمَةٌ","(is) a word","تَرَكْتُ ۚ كَلَّآ ۚ إِنَّهَا","هُوَ قَآئِلُهَا ۖ وَمِن",387],["23:108:5",349,"تُكَلِّمُونِ","speak to Me","ٱخْسَـُٔوا۟ فِيهَا وَلَا","",515],["24:16:9",351,"نَّتَكَلَّمَ","we speak","يَكُونُ لَنَآ أَن","بِهَـٰذَا سُبْحَـٰنَكَ هَـٰذَا",1676],["27:82:10",384,"تُكَلِّمُهُمْ","speaking to them","دَآبَّةًۭ مِّنَ ٱلْأَرْضِ","أَنَّ ٱلنَّاسَ كَانُوا۟",515],["30:35:6",408,"يَتَكَلَّمُ","speaks","عَلَيْهِمْ سُلْطَـٰنًۭا فَهُوَ","بِمَا كَانُوا۟ بِهِۦ",1676],["31:27:16",413,"كَلِمَـٰتُ","(the) Words","أَبْحُرٍۢ مَّا نَفِدَتْ","ٱللَّهِ ۗ إِنَّ ٱللَّهَ",664],["35:10:10",435,"ٱلْكَلِمُ","the words","جَمِيعًا ۚ إِلَيْهِ يَصْعَدُ","ٱلطَّيِّبُ وَٱلْعَمَلُ ٱلصَّـٰلِحُ",1568],["36:65:5",444,"وَتُكَلِّمُنَآ","and will speak to Us","نَخْتِمُ عَلَىٰٓ أَفْوَٰهِهِمْ","أَيْدِيهِمْ وَتَشْهَدُ أَرْجُلُهُم",515],["37:171:3",452,"كَلِمَتُنَا","Our Word","وَلَقَدْ سَبَقَتْ","لِعِبَادِنَا ٱلْمُرْسَلِينَ",387],["39:19:4",460,"كَلِمَةُ","the word","أَفَمَنْ حَقَّ عَلَيْهِ","ٱلْعَذَابِ أَفَأَنتَ تُنقِذُ",387],["39:71:31",466,"كَلِمَةُ","(the) word","بَلَىٰ وَلَـٰكِنْ حَقَّتْ","ٱلْعَذَابِ عَلَى ٱلْكَـٰفِرِينَ",387],["40:6:3",467,"كَلِمَتُ","(the) Word","وَكَذَٰلِكَ حَقَّتْ","رَبِّكَ عَلَى ٱلَّذِينَ",387],["41:45:8",481,"كَلِمَةٌۭ","(for) a word","فَٱخْتُلِفَ فِيهِ ۗ وَلَوْلَا","سَبَقَتْ مِن رَّبِّكَ",387],["42:14:12",484,"كَلِمَةٌۭ","(for) a word","بَغْيًۢا بَيْنَهُمْ ۚ وَلَوْلَا","سَبَقَتْ مِن رَّبِّكَ",387],["42:21:14",485,"كَلِمَةُ","(for) a word","بِهِ ٱللَّهُ ۚ وَلَوْلَا","ٱلْفَصْلِ لَقُضِىَ بَيْنَهُمْ ۗ",387],["42:24:18",486,"بِكَلِمَـٰتِهِۦٓ ۚ","by His Words","ٱلْبَـٰطِلَ وَيُحِقُّ ٱلْحَقَّ","إِنَّهُۥ عَلِيمٌۢ بِذَاتِ",664],["42:51:5",488,"يُكَلِّمَهُ","Allah should speak to him","كَانَ لِبَشَرٍ أَن","ٱللَّهُ إِلَّا وَحْيًا",515],["43:28:2",491,"كَلِمَةًۢ","a word","وَجَعَلَهَا","بَاقِيَةًۭ فِى عَقِبِهِۦ",387],["48:15:13",512,"كَلَـٰمَ","(the) Words","يُرِيدُونَ أَن يُبَدِّلُوا۟","ٱللَّهِ ۚ قُل لَّن",1567],["48:26:18",514,"كَلِمَةَ","(to the) word","وَعَلَى ٱلْمُؤْمِنِينَ وَأَلْزَمَهُمْ","ٱلتَّقْوَىٰ وَكَانُوٓا۟ أَحَقَّ",387],["66:12:12",561,"بِكَلِمَـٰتِ","(in the) Words","مِن رُّوحِنَا وَصَدَّقَتْ","رَبِّهَا وَكُتُبِهِۦ وَكَانَتْ",664],["78:38:7",583,"يَتَكَلَّمُونَ","they will speak","وَٱلْمَلَـٰٓئِكَةُ صَفًّۭا ۖ لَّا","إِلَّا مَنْ أَذِنَ",1676]]