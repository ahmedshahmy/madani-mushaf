[["18:49:5",299,"مُشْفِقِينَ","fearful","ٱلْكِتَـٰبُ فَتَرَى ٱلْمُجْرِمِينَ","مِمَّا فِيهِ وَيَقُولُونَ",986],["21:28:15",324,"مُشْفِقُونَ","stand in awe","وَهُم مِّنْ خَشْيَتِهِۦ","",986],["21:49:8",326,"مُشْفِقُونَ","(are) afraid","وَهُم مِّنَ ٱلسَّاعَةِ","",986],["23:57:7",345,"مُّشْفِقُونَ","(are) cautious","مِّنْ خَشْيَةِ رَبِّهِم","",986],["33:72:11",427,"وَأَشْفَقْنَ","and they feared","فَأَبَيْنَ أَن يَحْمِلْنَهَا","مِنْهَا وَحَمَلَهَا ٱلْإِنسَـٰنُ ۖ",2148],["42:18:9",485,"مُشْفِقُونَ","(are) fearful","بِهَا ۖ وَٱلَّذِينَ ءَامَنُوا۟","مِنْهَا وَيَعْلَمُونَ أَنَّهَا",986],["42:22:3",485,"مُشْفِقِينَ","fearful","تَرَى ٱلظَّـٰلِمِينَ","مِمَّا كَسَبُوا۟ وَهُوَ",986],["52:26:7",524,"مُشْفِقِينَ","fearful","قَبْلُ فِىٓ أَهْلِنَا","",986],["58:13:1",544,"ءَأَشْفَقْتُمْ","Are you afraid","","أَن تُقَدِّمُوا۟ بَيْنَ",2148],["70:27:6",569,"مُّشْفِقُونَ","(are) fearful","مِّنْ عَذَابِ رَبِّهِم","",986],["84:16:3",589,"بِٱلشَّفَقِ","by the twilight glow","فَلَآ أُقْسِمُ","",2897]]