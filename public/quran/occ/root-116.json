[["2:39:6",7,"أَصْحَـٰبُ","(are the) companions","وَكَذَّبُوا۟ بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ","ٱلنَّارِ ۖ هُمْ فِيهَا",143],["2:81:9",12,"أَصْحَـٰبُ","(are the) companions","بِهِۦ خَطِيٓـَٔتُهُۥ فَأُو۟لَـٰٓئِكَ","ٱلنَّارِ ۖ هُمْ فِيهَا",143],["2:82:6",12,"أَصْحَـٰبُ","(are the) companions","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ","ٱلْجَنَّةِ ۖ هُمْ فِيهَا",143],["2:119:9",18,"أَصْحَـٰبِ","(the) companions","وَلَا تُسْـَٔلُ عَنْ","ٱلْجَحِيمِ",143],["2:217:53",34,"أَصْحَـٰبُ","(are) companions","ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ ۖ وَأُو۟لَـٰٓئِكَ","ٱلنَّارِ ۖ هُمْ فِيهَا",143],["2:257:20",43,"أَصْحَـٰبُ","(are the) companions","إِلَى ٱلظُّلُمَـٰتِ ۗ أُو۟لَـٰٓئِكَ","ٱلنَّارِ ۖ هُمْ فِيهَا",143],["2:275:41",47,"أَصْحَـٰبُ","(are the) companions","وَمَنْ عَادَ فَأُو۟لَـٰٓئِكَ","ٱلنَّارِ ۖ هُمْ فِيهَا",143],["3:116:14",65,"أَصْحَـٰبُ","(are the) companions","ٱللَّهِ شَيْـًۭٔا ۖ وَأُو۟لَـٰٓئِكَ","ٱلنَّارِ ۚ هُمْ فِيهَا",143],["4:36:18",84,"وَٱلصَّاحِبِ","and the companion","ٱلْقُرْبَىٰ وَٱلْجَارِ ٱلْجُنُبِ","بِٱلْجَنۢبِ وَٱبْنِ ٱلسَّبِيلِ",824],["4:47:23",86,"أَصْحَـٰبَ","companions","نَلْعَنَهُمْ كَمَا لَعَنَّآ","ٱلسَّبْتِ ۚ وَكَانَ أَمْرُ",143],["5:10:6",109,"أَصْحَـٰبُ","(are the) companions","وَكَذَّبُوا۟ بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ","ٱلْجَحِيمِ",143],["5:29:9",112,"أَصْحَـٰبِ","(the) companions","وَإِثْمِكَ فَتَكُونَ مِنْ","ٱلنَّارِ ۚ وَذَٰلِكَ جَزَٰٓؤُا۟",143],["5:86:6",122,"أَصْحَـٰبُ","(are the) companions","وَكَذَّبُوا۟ بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ","ٱلْجَحِيمِ",143],["6:71:25",136,"أَصْحَـٰبٌۭ","companions","ٱلْأَرْضِ حَيْرَانَ لَهُۥٓ","يَدْعُونَهُۥٓ إِلَى ٱلْهُدَى",143],["6:101:11",140,"صَـٰحِبَةٌۭ ۖ","a companion","وَلَمْ تَكُن لَّهُۥ","وَخَلَقَ كُلَّ شَىْءٍۢ ۖ",1518],["7:36:7",154,"أَصْحَـٰبُ","(are the) companions","وَٱسْتَكْبَرُوا۟ عَنْهَآ أُو۟لَـٰٓئِكَ","ٱلنَّارِ ۖ هُمْ فِيهَا",143],["7:42:11",155,"أَصْحَـٰبُ","(are the) companions","إِلَّا وُسْعَهَآ أُو۟لَـٰٓئِكَ","ٱلْجَنَّةِ ۖ هُمْ فِيهَا",143],["7:44:2",156,"أَصْحَـٰبُ","(the) companions","وَنَادَىٰٓ","ٱلْجَنَّةِ أَصْحَـٰبَ ٱلنَّارِ",143],["7:44:4",156,"أَصْحَـٰبَ","(to the) companions","وَنَادَىٰٓ أَصْحَـٰبُ ٱلْجَنَّةِ","ٱلنَّارِ أَن قَدْ",143],["7:46:10",156,"أَصْحَـٰبَ","(to the) companions","كُلًّۢا بِسِيمَىٰهُمْ ۚ وَنَادَوْا۟","ٱلْجَنَّةِ أَن سَلَـٰمٌ",143],["7:47:5",156,"أَصْحَـٰبِ","(the) companions","صُرِفَتْ أَبْصَـٰرُهُمْ تِلْقَآءَ","ٱلنَّارِ قَالُوا۟ رَبَّنَا",143],["7:48:2",156,"أَصْحَـٰبُ","(the) companions","وَنَادَىٰٓ","ٱلْأَعْرَافِ رِجَالًۭا يَعْرِفُونَهُم",143],["7:50:2",156,"أَصْحَـٰبُ","(the) companions","وَنَادَىٰٓ","ٱلنَّارِ أَصْحَـٰبَ ٱلْجَنَّةِ",143],["7:50:4",156,"أَصْحَـٰبَ","(to the) companions","وَنَادَىٰٓ أَصْحَـٰبُ ٱلنَّارِ","ٱلْجَنَّةِ أَنْ أَفِيضُوا۟",143],["7:184:4",174,"بِصَاحِبِهِم","in their companion","أَوَلَمْ يَتَفَكَّرُوا۟ ۗ مَا","مِّن جِنَّةٍ ۚ إِنْ",824],["9:40:18",193,"لِصَـٰحِبِهِۦ","to his companion","ٱلْغَارِ إِذْ يَقُولُ","لَا تَحْزَنْ إِنَّ",824],["9:70:13",198,"وَأَصْحَـٰبِ","and (the) companions","وَثَمُودَ وَقَوْمِ إِبْرَٰهِيمَ","مَدْيَنَ وَٱلْمُؤْتَفِكَـٰتِ ۚ أَتَتْهُمْ",143],["9:113:19",205,"أَصْحَـٰبُ","(are the) companions","تَبَيَّنَ لَهُمْ أَنَّهُمْ","ٱلْجَحِيمِ",143],["10:26:12",212,"أَصْحَـٰبُ","(are the) companions","وَلَا ذِلَّةٌ ۚ أُو۟لَـٰٓئِكَ","ٱلْجَنَّةِ ۖ هُمْ فِيهَا",143],["10:27:23",212,"أَصْحَـٰبُ","(are the) companions","ٱلَّيْلِ مُظْلِمًا ۚ أُو۟لَـٰٓئِكَ","ٱلنَّارِ ۖ هُمْ فِيهَا",143],["11:23:10",224,"أَصْحَـٰبُ","(are the) companions","إِلَىٰ رَبِّهِمْ أُو۟لَـٰٓئِكَ","ٱلْجَنَّةِ ۖ هُمْ فِيهَا",143],["12:39:1",240,"يَـٰصَـٰحِبَىِ","O my two companions","","ٱلسِّجْنِ ءَأَرْبَابٌۭ مُّتَفَرِّقُونَ",2287],["12:41:1",240,"يَـٰصَـٰحِبَىِ","O my two companions","","ٱلسِّجْنِ أَمَّآ أَحَدُكُمَا",2287],["13:5:21",249,"أَصْحَـٰبُ","(are the) companions","فِىٓ أَعْنَاقِهِمْ ۖ وَأُو۟لَـٰٓئِكَ","ٱلنَّارِ ۖ هُمْ فِيهَا",143],["15:78:3",266,"أَصْحَـٰبُ","(the) companions","وَإِن كَانَ","ٱلْأَيْكَةِ لَظَـٰلِمِينَ",143],["15:80:3",266,"أَصْحَـٰبُ","(the) companions","وَلَقَدْ كَذَّبَ","ٱلْحِجْرِ ٱلْمُرْسَل