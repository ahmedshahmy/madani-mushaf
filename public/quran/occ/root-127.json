[["2:37:6",6,"فَتَابَ","So (his Lord) turned","مِن رَّبِّهِۦ كَلِمَـٰتٍۢ","عَلَيْهِ ۚ إِنَّهُۥ هُوَ",192],["2:37:10",6,"ٱلتَّوَّابُ","(is) the Oft-returning (to mercy)","عَلَيْهِ ۚ إِنَّهُۥ هُوَ","ٱلرَّحِيمُ",745],["2:54:11",8,"فَتُوبُوٓا۟","So turn in repentance","أَنفُسَكُم بِٱتِّخَاذِكُمُ ٱلْعِجْلَ","إِلَىٰ بَارِئِكُمْ فَٱقْتُلُوٓا۟",192],["2:54:21",8,"فَتَابَ","Then He turned","لَّكُمْ عِندَ بَارِئِكُمْ","عَلَيْكُمْ ۚ إِنَّهُۥ هُوَ",192],["2:54:25",8,"ٱلتَّوَّابُ","(is) the-returning","عَلَيْكُمْ ۚ إِنَّهُۥ هُوَ","ٱلرَّحِيمُ",745],["2:128:12",20,"وَتُبْ","and turn","لَّكَ وَأَرِنَا مَنَاسِكَنَا","عَلَيْنَآ ۖ إِنَّكَ أَنتَ",192],["2:128:16",20,"ٱلتَّوَّابُ","the Oft-returning","عَلَيْنَآ ۖ إِنَّكَ أَنتَ","ٱلرَّحِيمُ",745],["2:160:3",24,"تَابُوا۟","who repent[ed]","إِلَّا ٱلَّذِينَ","وَأَصْلَحُوا۟ وَبَيَّنُوا۟ فَأُو۟لَـٰٓئِكَ",192],["2:160:7",24,"أَتُوبُ","I will accept repentance","وَأَصْلَحُوا۟ وَبَيَّنُوا۟ فَأُو۟لَـٰٓئِكَ","عَلَيْهِمْ ۚ وَأَنَا ٱلتَّوَّابُ",192],["2:160:10",24,"ٱلتَّوَّابُ","the Acceptor of Repentance","أَتُوبُ عَلَيْهِمْ ۚ وَأَنَا","ٱلرَّحِيمُ",745],["2:187:20",29,"فَتَابَ","so He turned","كُنتُمْ تَخْتَانُونَ أَنفُسَكُمْ","عَلَيْكُمْ وَعَفَا عَنكُمْ ۖ",192],["2:222:25",35,"ٱلتَّوَّٰبِينَ","those who turn in repentance","إِنَّ ٱللَّهَ يُحِبُّ","وَيُحِبُّ ٱلْمُتَطَهِّرِينَ",745],["2:279:10",47,"تُبْتُمْ","you repent","ٱللَّهِ وَرَسُولِهِۦ ۖ وَإِن","فَلَكُمْ رُءُوسُ أَمْوَٰلِكُمْ",192],["3:89:3",61,"تَابُوا۟","repent","إِلَّا ٱلَّذِينَ","مِنۢ بَعْدِ ذَٰلِكَ",192],["3:90:11",61,"تَوْبَتُهُمْ","their repentance","كُفْرًۭا لَّن تُقْبَلَ","وَأُو۟لَـٰٓئِكَ هُمُ ٱلضَّآلُّونَ",1109],["3:128:7",66,"يَتُوبَ","He turns","ٱلْأَمْرِ شَىْءٌ أَوْ","عَلَيْهِمْ أَوْ يُعَذِّبَهُمْ",192],["4:16:6",80,"تَابَا","they repent","مِنكُمْ فَـَٔاذُوهُمَا ۖ فَإِن","وَأَصْلَحَا فَأَعْرِضُوا۟ عَنْهُمَآ ۗ",192],["4:16:13",80,"تَوَّابًۭا","Oft-Forgiving","إِنَّ ٱللَّهَ كَانَ","رَّحِيمًا",745],["4:17:2",80,"ٱلتَّوْبَةُ","the acceptance of repentance","إِنَّمَا","عَلَى ٱللَّهِ لِلَّذِينَ",1109],["4:17:10",80,"يَتُوبُونَ","they repent","ٱلسُّوٓءَ بِجَهَـٰلَةٍۢ ثُمَّ","مِن قَرِيبٍۢ فَأُو۟لَـٰٓئِكَ",192],["4:17:14",80,"يَتُوبُ","will have forgiveness","مِن قَرِيبٍۢ فَأُو۟لَـٰٓئِكَ","ٱللَّهُ عَلَيْهِمْ ۗ وَكَانَ",192],["4:18:2",80,"ٱلتَّوْبَةُ","(is) the acceptance of repentance","وَلَيْسَتِ","لِلَّذِينَ يَعْمَلُونَ ٱلسَّيِّـَٔاتِ",1109],["4:18:13",80,"تُبْتُ","repent","ٱلْمَوْتُ قَالَ إِنِّى","ٱلْـَٔـٰنَ وَلَا ٱلَّذِينَ",192],["4:26:10",82,"وَيَتُوبَ","and (to) accept repentance","ٱلَّذِينَ مِن قَبْلِكُمْ","عَلَيْكُمْ ۗ وَٱللَّهُ عَلِيمٌ",192],["4:27:4",83,"يَتُوبَ","accept repentance","وَٱللَّهُ يُرِيدُ أَن","عَلَيْكُمْ وَيُرِيدُ ٱلَّذِينَ",192],["4:64:22",88,"تَوَّابًۭا","Oft-Forgiving","ٱلرَّسُولُ لَوَجَدُوا۟ ٱللَّهَ","رَّحِيمًۭا",745],["4:92:54",93,"تَوْبَةًۭ","(seeking) repentance","فَصِيَامُ شَهْرَيْنِ مُتَتَابِعَيْنِ","مِّنَ ٱللَّهِ ۗ وَكَانَ",1109],["4:146:3",101,"تَابُوا۟","repent","إِلَّا ٱلَّذِينَ","وَأَصْلَحُوا۟ وَٱعْتَصَمُوا۟ بِٱللَّهِ",192],["5:34:3",113,"تَابُوا۟","repent","إِلَّا ٱلَّذِينَ","مِن قَبْلِ أَن",192],["5:39:2",114,"تَابَ","repented","فَمَن","مِنۢ بَعْدِ ظُلْمِهِۦ",192],["5:39:9",114,"يَتُوبُ","will turn in forgiveness","وَأَصْلَحَ فَإِنَّ ٱللَّهَ","عَلَيْهِ ۗ إِنَّ ٱللَّهَ",192],["5:71:8",120,"تَابَ","turned","فَعَمُوا۟ وَصَمُّوا۟ ثُمَّ","ٱللَّهُ عَلَيْهِمْ ثُمَّ",192],["5:74:2",120,"يَتُوبُونَ","they turn in repentance","أَفَلَا","إِلَى ٱللَّهِ وَيَسْتَغْفِرُونَهُۥ ۚ",192],["6:54:21",134,"تَابَ","repents","سُوٓءًۢا بِجَهَـٰلَةٍۢ ثُمَّ","مِنۢ بَعْدِهِۦ وَأَصْلَحَ",192],["7:143:37",167,"تُبْتُ","I turn (in repentance)","أَفَاقَ قَالَ سُبْحَـٰنَكَ","إِلَيْكَ وَأَنَا۠ أَوَّلُ",192],["7:153:5",169,"تَابُوا۟","repented","عَمِلُوا۟ ٱلسَّيِّـَٔاتِ ثُمَّ","مِنۢ بَعْدِهَا وَءَامَنُوٓا۟",192],["9:3:17",187,"تُبْتُمْ","you repent","ٱلْمُشْرِكِينَ ۙ وَرَسُولُهُۥ ۚ فَإِن","فَهُوَ خَيْرٌۭ لَّكُمْ ۖ",192],["9:5:16",187,"تَابُوا۟","they repent","كُلَّ مَرْصَدٍۢ ۚ فَإِن","وَأَقَامُوا۟ ٱلصَّلَوٰةَ وَءَاتَوُا۟",192],["9:11:2",188,"تَابُوا۟","they repent","فَإِن","وَأَقَامُوا۟ ٱلصَّلَوٰةَ وَءَاتَوُا۟",192],["9:15:4",189,"وَيَتُوبُ","And Allah accepts repentance","وَيُذْهِبْ غَيْظَ قُلُوبِهِمْ ۗ","ٱللَّهُ عَلَىٰ مَن",192],["9:27:2",191,"يَتُوبُ","Allah accepts repentance","ثُمَّ","ٱللَّهُ مِنۢ بَعْدِ",192],["9:74:26",199,"يَتُوبُوا۟","they repent","مِن فَضْلِهِۦ ۚ فَإِن","يَكُ خَيْرًۭا لَّهُمْ ۖ",192],["9:102:12",203,"يَتُوبَ","will turn (in mercy)","عَسَى ٱللَّهُ أَن","عَلَيْهِمْ ۚ إِنَّ ٱللَّهَ",192],["9:104:7",203,"ٱلتَّوْبَةَ","the repentance","ٱللَّهَ هُوَ يَقْبَلُ","عَنْ عِبَادِهِۦ وَيَأْخُذُ",1109],["9:104:15",203,"ٱلتَّوَّابُ","(is) the Acceptor of repentance","وَأَنَّ ٱللَّهَ هُوَ","ٱلرَّحِيمُ",745],["9:106:8",203,"يَتُوبُ","He will turn (in mercy)","إِمَّا يُعَذِّبُهُمْ وَإِمَّا","عَلَيْهِمْ ۗ وَٱللَّهُ عَلِيمٌ",192],["9:112:1",205,"ٱلتَّـٰٓئِبُونَ","Those who turn in repentance","","ٱلْعَـٰبِدُونَ ٱلْحَـٰمِدُونَ ٱلسَّـٰٓئِحُونَ",4478],["9:117:2",205,"تَّابَ","Allah turned (in mercy)","لَّقَد","ٱللَّهُ عَلَى ٱلنَّبِىِّ",192],["9:117:22",205,"تَابَ","He turned (in mercy)","فَرِيقٍۢ مِّنْهُمْ ثُمَّ","عَلَيْهِمْ ۚ إِنَّهُۥ بِهِمْ",192],["9:118:24",206,"تَابَ","He turned (in mercy)","إِلَّآ إِلَيْهِ ثُمَّ","عَلَيْهِمْ لِيَتُوبُوٓا۟ ۚ إِنَّ",192],["9:118:26",206,"لِيَتُوبُوٓا۟ ۚ","that they may repent","ثُمَّ تَابَ عَلَيْهِمْ","إِنَّ ٱللَّهَ هُوَ",192],["9:118:30",206,"ٱلتَّوَّابُ","(is) the Acceptor of repentance","إِنَّ ٱللَّهَ هُوَ","ٱلرَّحِيمُ",745],["9:126:13",207,"يَتُوبُونَ","they turn (in repentance)","مَرَّتَيْنِ ثُمَّ لَا","وَلَا هُمْ يَذَّكَّرُونَ",192],["11:3:5",221,"تُوبُوٓا۟","turn in repentance","ٱسْتَغْفِرُوا۟ رَبَّكُمْ ثُمَّ","إِلَيْهِ يُمَتِّعْكُم مَّتَـٰعًا",192],["11:52:5",227,"تُوبُوٓا۟","turn in repentance","ٱسْتَغْفِرُوا۟ رَبَّكُمْ ثُمَّ","إِلَيْهِ يُرْسِلِ ٱلسَّمَآءَ",192],["11:61:22",228,"تُوبُوٓا۟","turn in repentance","فِيهَا فَٱسْتَغْفِرُوهُ ثُمَّ","إِلَيْهِ ۚ إِنَّ رَبِّى",192],["11:90:4",232,"تُوبُوٓا۟","turn in repentance","وَٱسْتَغْفِرُوا۟ رَبَّكُمْ ثُمَّ","إِلَيْهِ ۚ إِنَّ رَبِّى",192],["11:112:5",234,"تَابَ","turn (in repentance)","كَمَآ أُمِرْتَ وَمَن","مَعَكَ وَلَا تَطْغَوْا۟ ۚ",192],["13:30:28",253,"مَتَابِ","(is) my return","عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ","",2468],["16:119:9",281,"تَابُوا۟","repented","ٱلسُّوٓءَ بِجَهَـٰلَةٍۢ ثُمَّ","مِنۢ بَعْدِ ذَٰلِكَ",192],["19:60:3",309,"تَابَ","repented","إِلَّا مَن","وَءَامَنَ وَعَمِلَ صَـٰلِحًۭا",192],["20:82:4",317,"تَابَ","repents","وَإِنِّى لَغَفَّارٌۭ لِّمَن","وَءَامَنَ وَعَمِلَ صَـٰلِحًۭا",192],["20:122:4",320,"فَتَابَ","and turned","ثُمَّ ٱجْتَبَـٰهُ رَبُّهُۥ","عَلَيْهِ وَهَدَىٰ",192],["24:5:3",350,"تَابُوا۟","repent","إِلَّا ٱلَّذِينَ","مِنۢ بَعْدِ ذَٰلِكَ",192],["24:10:8",350,"تَوَّابٌ","(is) Oft-Returning (to Mercy)","وَرَحْمَتُهُۥ وَأَنَّ ٱللَّهَ","حَكِيمٌ",745],["24:31:71",353,"وَتُوبُوٓا۟","And turn","يُخْفِينَ مِن زِينَتِهِنَّ ۚ","إِلَى ٱللَّهِ جَمِيعًا",192],["25:70:3",366,"تَابَ","repents","إِلَّا مَن","وَءَامَنَ وَعَمِلَ عَمَلًۭا",192],["25:71:2",366,"تَابَ","repents","وَمَن","وَعَمِلَ صَـٰلِحًۭا فَإِنَّهُۥ",192],["25:71:6",366,"يَتُوبُ","turns","وَعَمِلَ صَـٰلِحًۭا فَإِنَّهُۥ","إِلَى ٱللَّهِ مَتَابًۭا",192],["25:71:9",366,"مَتَابًۭا","(with) repentance","يَتُوبُ إِلَى ٱللَّهِ","",2468],["28:67:3",393,"تَابَ","repented","فَأَمَّا مَن","وَءَامَنَ وَعَمِلَ صَـٰلِحًۭا",192],["33:24:10",421,"يَتُوبَ","turn in mercy","إِن شَآءَ أَوْ","عَلَيْهِمْ ۚ إِنَّ ٱللَّهَ",192],["33:73:7",427,"وَيَتُوبَ","and Allah will turn (in Mercy)","وَٱلْمُنَـٰفِقَـٰتِ وَٱلْمُشْرِكِينَ وَٱلْمُشْرِكَـٰتِ","ٱللَّهُ عَلَى ٱلْمُؤْمِنِينَ",192],["40:3:4",467,"ٱلتَّوْبِ","(of) [the] repentance","غَافِرِ ٱلذَّنۢبِ وَقَابِلِ","شَدِيدِ ٱلْعِقَابِ ذِى",4488],["40:7:22",467,"تَابُوا۟","repent","وَعِلْمًۭا فَٱغْفِرْ لِلَّذِينَ","وَٱتَّبَعُوا۟ سَبِيلَكَ وَقِهِمْ",192],["42:25:4",486,"ٱلتَّوْبَةَ","the repentance","وَهُوَ ٱلَّذِى يَقْبَلُ","عَنْ عِبَادِهِۦ وَيَعْفُوا۟",1109],["46:15:41",504,"تُبْتُ","I turn","فِى ذُرِّيَّتِىٓ ۖ إِنِّى","إِلَيْكَ وَإِنِّى مِنَ",192],["49:11:36",516,"يَتُبْ","repent","ٱلْإِيمَـٰنِ ۚ وَمَن لَّمْ","فَأُو۟لَـٰٓئِكَ هُمُ ٱلظَّـٰلِمُونَ",192],["49:12:30",517,"تَوَّابٌۭ","(is) Oft-Returning","ٱللَّهَ ۚ إِنَّ ٱللَّهَ","رَّحِيمٌۭ",745],["58:13:11",544,"وَتَابَ","and Allah has forgiven","فَإِذْ لَمْ تَفْعَلُوا۟","ٱللَّهُ عَلَيْكُمْ فَأَقِيمُوا۟",192],["66:4:2",560,"تَتُوبَآ","you both turn","إِن","إِلَى ٱللَّهِ فَقَدْ",192],["66:5:13",560,"تَـٰٓئِبَـٰتٍ","repentant","مُسْلِمَـٰتٍۢ مُّؤْمِنَـٰتٍۢ قَـٰنِتَـٰتٍۢ","عَـٰبِدَٰتٍۢ سَـٰٓئِحَـٰتٍۢ ثَيِّبَـٰتٍۢ",4347],["66:8:4",561,"تُوبُوٓا۟","Turn","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","إِلَى ٱللَّهِ تَوْبَةًۭ",192],["66:8:7",561,"تَوْبَةًۭ","(in) repentance","تُوبُوٓا۟ إِلَى ٱللَّهِ","نَّصُوحًا عَسَىٰ رَبُّكُمْ",1109],["73:20:24",575,"فَتَابَ","so He has turned","أَن لَّن تُحْصُوهُ","عَلَيْكُمْ ۖ فَٱقْرَءُوا۟ مَا",192],["85:10:8",590,"يَتُوبُوا۟","they repented","وَٱلْمُؤْمِنَـٰتِ ثُمَّ لَمْ","فَلَهُمْ عَذَابُ جَهَنَّمَ",192],["110:3:7",603,"تَوَّابًۢا","Oft-Returning","وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ","",745]]