[["12:62:6",242,"رِحَالِهِمْ","their saddlebags","ٱجْعَلُوا۟ بِضَـٰعَتَهُمْ فِى","لَعَلَّهُمْ يَعْرِفُونَهَآ إِذَا",1972],["12:70:7",244,"رَحْلِ","the bag","جَعَلَ ٱلسِّقَايَةَ فِى","أَخِيهِ ثُمَّ أَذَّنَ",1972],["12:75:6",244,"رَحْلِهِۦ","his bag","مَن وُجِدَ فِى","فَهُوَ جَزَٰٓؤُهُۥ ۚ كَذَٰلِكَ",1972],["106:2:2",602,"رِحْلَةَ","(with the) journey","إِۦلَـٰفِهِمْ","ٱلشِّتَآءِ وَٱلصَّيْفِ",4187]]