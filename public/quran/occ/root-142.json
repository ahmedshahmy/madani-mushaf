[["2:41:16",7,"قَلِيلًۭا","small","تَشْتَرُوا۟ بِـَٔايَـٰتِى ثَمَنًۭا","وَإِيَّـٰىَ فَٱتَّقُونِ",173],["2:79:15",12,"قَلِيلًۭا ۖ","little","لِيَشْتَرُوا۟ بِهِۦ ثَمَنًۭا","فَوَيْلٌۭ لَّهُم مِّمَّا",173],["2:83:26",12,"قَلِيلًۭا","a few","ثُمَّ تَوَلَّيْتُمْ إِلَّا","مِّنكُمْ وَأَنتُم مُّعْرِضُونَ",173],["2:88:8",13,"فَقَلِيلًۭا","so little","لَّعَنَهُمُ ٱللَّهُ بِكُفْرِهِمْ","مَّا يُؤْمِنُونَ",173],["2:126:23",19,"قَلِيلًۭا","a little","وَمَن كَفَرَ فَأُمَتِّعُهُۥ","ثُمَّ أَضْطَرُّهُۥٓ إِلَىٰ",173],["2:174:12",26,"قَلِيلًا ۙ","little","وَيَشْتَرُونَ بِهِۦ ثَمَنًۭا","أُو۟لَـٰٓئِكَ مَا يَأْكُلُونَ",173],["2:246:50",40,"قَلِيلًۭا","a few","ٱلْقِتَالُ تَوَلَّوْا۟ إِلَّا","مِّنْهُمْ ۗ وَٱللَّهُ عَلِيمٌۢ",173],["2:249:28",41,"قَلِيلًۭا","a few","فَشَرِبُوا۟ مِنْهُ إِلَّا","مِّنْهُمْ ۚ فَلَمَّا جَاوَزَهُۥ",173],["2:249:52",41,"قَلِيلَةٍ","small","كَم مِّن فِئَةٍۢ","غَلَبَتْ فِئَةًۭ كَثِيرَةًۢ",4123],["3:77:8",59,"قَلِيلًا","little","ٱللَّهِ وَأَيْمَـٰنِهِمْ ثَمَنًۭا","أُو۟لَـٰٓئِكَ لَا خَلَـٰقَ",173],["3:187:18",75,"قَلِيلًۭا ۖ","little","وَٱشْتَرَوْا۟ بِهِۦ ثَمَنًۭا","فَبِئْسَ مَا يَشْتَرُونَ",173],["3:197:2",76,"قَلِيلٌۭ","little","مَتَـٰعٌۭ","ثُمَّ مَأْوَىٰهُمْ جَهَنَّمُ ۚ",173],["3:199:21",76,"قَلِيلًا ۗ","little","بِـَٔايَـٰتِ ٱللَّهِ ثَمَنًۭا","أُو۟لَـٰٓئِكَ لَهُمْ أَجْرُهُمْ",173],["4:7:14",78,"قَلَّ","(is) little","ٱلْوَٰلِدَانِ وَٱلْأَقْرَبُونَ مِمَّا","مِنْهُ أَوْ كَثُرَ ۚ",4124],["4:46:38",86,"قَلِيلًۭا","a few","فَلَا يُؤْمِنُونَ إِلَّا","",173],["4:66:15",89,"قَلِيلٌۭ","a few","مَّا فَعَلُوهُ إِلَّا","مِّنْهُمْ ۖ وَلَوْ أَنَّهُمْ",173],["4:77:41",90,"قَلِيلٌۭ","(is) little","قُلْ مَتَـٰعُ ٱلدُّنْيَا","وَٱلْـَٔاخِرَةُ خَيْرٌۭ لِّمَنِ",173],["4:83:30",91,"قَلِيلًۭا","a few","لَٱتَّبَعْتُمُ ٱلشَّيْطَـٰنَ إِلَّا","",173],["4:142:19",101,"قَلِيلًۭا","a little","يَذْكُرُونَ ٱللَّهَ إِلَّا","",173],["4:155:22",103,"قَلِيلًۭا","a few","فَلَا يُؤْمِنُونَ إِلَّا","",173],["5:13:24",109,"قَلِيلًۭا","a few","خَآئِنَةٍۢ مِّنْهُمْ إِلَّا","مِّنْهُمْ ۖ فَٱعْفُ عَنْهُمْ",173]