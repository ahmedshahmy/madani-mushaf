[["2:68:15",10,"فَارِضٌۭ","old","إِنَّهَا بَقَرَةٌۭ لَّا","وَلَا بِكْرٌ عَوَانٌۢ",3398],["2:197:5",31,"فَرَضَ","undertakes","أَشْهُرٌۭ مَّعْلُومَـٰتٌۭ ۚ فَمَن","فِيهِنَّ ٱلْحَجَّ فَلَا",898],["2:236:11",38,"تَفْرِضُوا۟","you specified","لَمْ تَمَسُّوهُنَّ أَوْ","لَهُنَّ فَرِيضَةًۭ ۚ وَمَتِّعُوهُنَّ",898],["2:236:13",38,"فَرِيضَةًۭ ۚ","an obligation (dower)","أَوْ تَفْرِضُوا۟ لَهُنَّ","وَمَتِّعُوهُنَّ عَلَى ٱلْمُوسِعِ",1177],["2:237:8",38,"فَرَضْتُمْ","you have specified","أَن تَمَسُّوهُنَّ وَقَدْ","لَهُنَّ فَرِيضَةًۭ فَنِصْفُ",898],["2:237:10",38,"فَرِيضَةًۭ","an obligation (dower)","وَقَدْ فَرَضْتُمْ لَهُنَّ","فَنِصْفُ مَا فَرَضْتُمْ",1177],["2:237:13",38,"فَرَضْتُمْ","you have specified","فَرِيضَةًۭ فَنِصْفُ مَا","إِلَّآ أَن يَعْفُونَ",898],["4:7:19",78,"مَّفْرُوضًۭا","obligatory","أَوْ كَثُرَ ۚ نَصِيبًۭا","",2522],["4:11:64",78,"فَرِيضَةًۭ","An obligation","أَقْرَبُ لَكُمْ نَفْعًۭا ۚ","مِّنَ ٱللَّهِ ۗ إِنَّ",1177],["4:24:28",82,"فَرِيضَةًۭ ۚ","(as) an obligation","مِنْهُنَّ فَـَٔاتُوهُنَّ أُجُورَهُنَّ","وَلَا جُنَاحَ عَلَيْكُمْ",1177],["4:24:37",82,"ٱلْفَرِيضَةِ ۚ","the obligation","بِهِۦ مِنۢ بَعْدِ","إِنَّ ٱللَّهَ كَانَ",1177],["4:118:8",97,"مَّفْرُوضًۭا","appointed","مِنْ عِبَادِكَ نَصِيبًۭا","",2522],["9:60:17",196,"فَرِيضَةًۭ","an obligation","ٱللَّهِ وَٱبْنِ ٱلسَّبِيلِ ۖ","مِّنَ ٱللَّهِ ۗ وَٱللَّهُ",1177],["24:1:3",350,"وَفَرَضْنَـٰهَا","and We (have) made it obligatory","سُورَةٌ أَنزَلْنَـٰهَا","وَأَنزَلْنَا فِيهَآ ءَايَـٰتٍۭ",898],["28:85:3",396,"فَرَضَ","ordained","إِنَّ ٱلَّذِى","عَلَيْكَ ٱلْقُرْءَانَ لَرَآدُّكَ",898],["33:38:8",423,"فَرَضَ","Allah has imposed","مِنْ حَرَجٍۢ فِيمَا","ٱللَّهُ لَهُۥ ۖ سُنَّةَ",898],["33:50:47",424,"فَرَضْنَا","We have made obligatory","قَدْ عَلِمْنَا مَا","عَلَيْهِمْ فِىٓ أَزْوَٰجِهِمْ",898],["66:2:2",560,"فَرَضَ","has ordained","قَدْ","ٱللَّهُ لَكُمْ تَحِلَّةَ",898]]