,"مِقْدَارُهُۥ","its measure","فِى يَوْمٍۢ كَانَ","خَمْسِينَ أَلْفَ سَنَةٍۢ",1896],["70:40:7",569,"لَقَـٰدِرُونَ","(are) surely Able","ٱلْمَشَـٰرِقِ وَٱلْمَغَـٰرِبِ إِنَّا","",672],["73:20:17",575,"يُقَدِّرُ","determines","ٱلَّذِينَ مَعَكَ ۚ وَٱللَّهُ","ٱلَّيْلَ وَٱلنَّهَارَ ۚ عَلِمَ",600],["74:18:3",575,"وَقَدَّرَ","and plotted","إِنَّهُۥ فَكَّرَ","",600],["74:19:3",576,"قَدَّرَ","he plotted","فَقُتِلَ كَيْفَ","",600],["74:20:4",576,"قَدَّرَ","he plotted","ثُمَّ قُتِلَ كَيْفَ","",600],["75:4:2",577,"قَـٰدِرِينَ","(We are) Able","بَلَىٰ","عَلَىٰٓ أَن نُّسَوِّىَ",672],["75:40:3",578,"بِقَـٰدِرٍ","(He) Able","أَلَيْسَ ذَٰلِكَ","عَلَىٰٓ أَن يُحْـِۧىَ",672],["76:16:4",579,"قَدَّرُوهَا","They will determine its","قَوَارِيرَا۟ مِن فِضَّةٍۢ","تَقْدِيرًۭا",600],["76:16:5",579,"تَقْدِيرًۭا","measure","مِن فِضَّةٍۢ قَدَّرُوهَا","",1404],["77:22:2",581,"قَدَرٍۢ","a period","إِلَىٰ","مَّعْلُومٍۢ",797],["77:23:1",581,"فَقَدَرْنَا","So We measured","","فَنِعْمَ ٱلْقَـٰدِرُونَ",430],["77:23:3",581,"ٱلْقَـٰدِرُونَ","(are We to) measure","فَقَدَرْنَا فَنِعْمَ","",672],["80:19:4",585,"فَقَدَّرَهُۥ","then He proportioned him","مِن نُّطْفَةٍ خَلَقَهُۥ","",600],["86:8:4",591,"لَقَادِرٌۭ","(is) Able","إِنَّهُۥ عَلَىٰ رَجْعِهِۦ","",672],["87:3:2",591,"قَدَّرَ","measured","وَٱلَّذِى","فَهَدَىٰ",600],["89:16:5",593,"فَقَدَرَ","and restricts","إِذَا مَا ٱبْتَلَىٰهُ","عَلَيْهِ رِزْقَهُۥ فَيَقُولُ",430],["90:5:4",594,"يَقْدِرَ","has power","أَيَحْسَبُ أَن لَّن","عَلَيْهِ أَحَدٌۭ",430],["97:1:5",598,"ٱلْقَدْرِ","(of) Power","أَنزَلْنَـٰهُ فِى لَيْلَةِ","",1095],["97:2:5",598,"ٱلْقَدْرِ","(of) Power (is)","أَدْرَىٰكَ مَا لَيْلَةُ","",1095],["97:3:2",598,"ٱلْقَدْرِ","(of) Power","لَيْلَةُ","خَيْرٌۭ مِّنْ أَلْفِ",1095]]