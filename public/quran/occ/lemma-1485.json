[["15:78:4",266,"ٱلْأَيْكَةِ","(of) the wood","وَإِن كَانَ أَصْحَـٰبُ","لَظَـٰلِمِينَ",1485],["26:176:3",374,"لْـَٔيْكَةِ","(of the) Wood","كَذَّبَ أَصْحَـٰبُ","ٱلْمُرْسَلِينَ",1485],["38:13:5",453,"لْـَٔيْكَةِ ۚ","(of) the wood","وَقَوْمُ لُوطٍۢ وَأَصْحَـٰبُ","أُو۟لَـٰٓئِكَ ٱلْأَحْزَابُ",1485],["50:14:2",518,"ٱلْأَيْكَةِ","(of) the wood","وَأَصْحَـٰبُ","وَقَوْمُ تُبَّعٍۢ ۚ كُلٌّۭ",1485]]