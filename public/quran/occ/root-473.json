[["2:183:6",28,"ٱلصِّيَامُ","[the] fasting","ءَامَنُوا۟ كُتِبَ عَلَيْكُمُ","كَمَا كُتِبَ عَلَى",890],["2:184:27",28,"تَصُومُوا۟","fast","خَيْرٌۭ لَّهُۥ ۚ وَأَن","خَيْرٌۭ لَّكُمْ ۖ إِن",2761],["2:185:17",28,"فَلْيَصُمْهُ ۖ","then he should fast in it","شَهِدَ مِنكُمُ ٱلشَّهْرَ","وَمَن كَانَ مَرِيضًا",2761],["2:187:4",29,"ٱلصِّيَامِ","(of) fasting","أُحِلَّ لَكُمْ لَيْلَةَ","ٱلرَّفَثُ إِلَىٰ نِسَآئِكُمْ ۚ",890],["2:187:45",29,"ٱلصِّيَامَ","the fast","ٱلْفَجْرِ ۖ ثُمَّ أَتِمُّوا۟","إِلَى ٱلَّيْلِ ۚ وَلَا",890],["2:196:29",30,"صِيَامٍ","fasting","رَّأْسِهِۦ فَفِدْيَةٌۭ مِّن","أَوْ صَدَقَةٍ أَوْ",890],["2:196:48",30,"فَصِيَامُ","then a fast","فَمَن لَّمْ يَجِدْ","ثَلَـٰثَةِ أَيَّامٍۢ فِى",890],["4:92:51",93,"فَصِيَامُ","then fasting","فَمَن لَّمْ يَجِدْ","شَهْرَيْنِ مُتَتَابِعَيْنِ تَوْبَةًۭ",890],["5:89:29",122,"فَصِيَامُ","(that), then fasting","فَمَن لَّمْ يَجِدْ","ثَلَـٰثَةِ أَيَّامٍۢ ۚ ذَٰلِكَ",890],["5:95:34",123,"صِيَامًۭا","(in) fasting","أَوْ عَدْلُ ذَٰلِكَ","لِّيَذُوقَ وَبَالَ أَمْرِهِۦ ۗ",890],["19:26:14",307,"صَوْمًۭا","a fast","إِنِّى نَذَرْتُ لِلرَّحْمَـٰنِ","فَلَنْ أُكَلِّمَ ٱلْيَوْمَ",3257],["33:35:16",422,"وَٱلصَّـٰٓئِمِينَ","and the men who fast","وَٱلْخَـٰشِعَـٰتِ وَٱلْمُتَصَدِّقِينَ وَٱلْمُتَصَدِّقَـٰتِ","وَٱلصَّـٰٓئِمَـٰتِ وَٱلْحَـٰفِظِينَ فُرُوجَهُمْ",3274],["33:35:17",422,"وَٱلصَّـٰٓئِمَـٰتِ","and the women who fast","وَٱلْمُتَصَدِّقِينَ وَٱلْمُتَصَدِّقَـٰتِ وَٱلصَّـٰٓئِمِينَ","وَٱلْحَـٰفِظِينَ فُرُوجَهُمْ وَٱلْحَـٰفِظَـٰتِ",3273],["58:4:4",542,"فَصِيَامُ","then fasting","فَمَن لَّمْ يَجِدْ","شَهْرَيْنِ مُتَتَابِعَيْنِ مِن",890]]