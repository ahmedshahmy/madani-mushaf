[["2:255:12",42,"نَوْمٌۭ ۚ","sleep","تَأْخُذُهُۥ سِنَةٌۭ وَلَا","لَّهُۥ مَا فِى",1945],["7:97:9",163,"نَآئِمُونَ","(were) asleep","بَأْسُنَا بَيَـٰتًۭا وَهُمْ","",2547],["8:43:5",182,"مَنَامِكَ","your dream","يُرِيكَهُمُ ٱللَّهُ فِى","قَلِيلًۭا ۖ وَلَوْ أَرَىٰكَهُمْ",1579],["25:47:7",364,"وَٱلنَّوْمَ","and the sleep","لَكُمُ ٱلَّيْلَ لِبَاسًۭا","سُبَاتًۭا وَجَعَلَ ٱلنَّهَارَ",1945],["30:23:3",406,"مَنَامُكُم","(is) your sleep","وَمِنْ ءَايَـٰتِهِۦ","بِٱلَّيْلِ وَٱلنَّهَارِ وَٱبْتِغَآؤُكُم",1579],["37:102:10",449,"ٱلْمَنَامِ","the dream","إِنِّىٓ أَرَىٰ فِى","أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ",1579],["39:42:10",463,"مَنَامِهَا ۖ","their sleep","لَمْ تَمُتْ فِى","فَيُمْسِكُ ٱلَّتِى قَضَىٰ",1579],["68:19:7",565,"نَآئِمُونَ","were asleep","مِّن رَّبِّكَ وَهُمْ","",2547],["78:9:2",582,"نَوْمَكُمْ","your sleep","وَجَعَلْنَا","سُبَاتًۭا",1945]]