[["2:74:35",11,"بِغَـٰفِلٍ","unaware","ٱللَّهِ ۗ وَمَا ٱللَّهُ","عَمَّا تَعْمَلُونَ",399],["2:85:47",13,"بِغَـٰفِلٍ","unaware","ٱلْعَذَابِ ۗ وَمَا ٱللَّهُ","عَمَّا تَعْمَلُونَ",399],["2:140:28",21,"بِغَـٰفِلٍ","unaware","ٱللَّهِ ۗ وَمَا ٱللَّهُ","عَمَّا تَعْمَلُونَ",399],["2:144:32",22,"بِغَـٰفِلٍ","unaware","رَّبِّهِمْ ۗ وَمَا ٱللَّهُ","عَمَّا يَعْمَلُونَ",399],["2:149:15",23,"بِغَـٰفِلٍ","unaware","رَّبِّكَ ۗ وَمَا ٱللَّهُ","عَمَّا تَعْمَلُونَ",399],["3:99:17",62,"بِغَـٰفِلٍ","(is) unaware","شُهَدَآءُ ۗ وَمَا ٱللَّهُ","عَمَّا تَعْمَلُونَ",399],["4:102:32",95,"تَغْفُلُونَ","you neglect","ٱلَّذِينَ كَفَرُوا۟ لَوْ","عَنْ أَسْلِحَتِكُمْ وَأَمْتِعَتِكُمْ",4376],["6:131:10",145,"غَـٰفِلُونَ","(are) unaware","ٱلْقُرَىٰ بِظُلْمٍۢ وَأَهْلُهَا","",399],["6:132:7",145,"بِغَـٰفِلٍ","unaware","عَمِلُوا۟ ۚ وَمَا رَبُّكَ","عَمَّا يَعْمَلُونَ",399],["6:156:14",149,"لَغَـٰفِلِينَ","certainly unaware","كُنَّا عَن دِرَاسَتِهِمْ","",399],["7:136:11",166,"غَـٰفِلِينَ","heedless","بِـَٔايَـٰتِنَا وَكَانُوا۟ عَنْهَا","",399],["7:146:36",168,"غَـٰفِلِينَ","heedless","بِـَٔايَـٰتِنَا وَكَانُوا۟ عَنْهَا","",399],["7:172:26",173,"غَـٰفِلِينَ","unaware","كُنَّا عَنْ هَـٰذَا","",399],["7:179:30",174,"ٱلْغَـٰفِلُونَ","(are) the heedless","أَضَلُّ ۚ أُو۟لَـٰٓئِكَ هُمُ","",399],["7:205:16",176,"ٱلْغَـٰفِلِينَ","the heedless","وَلَا تَكُن مِّنَ","",399],["10:7:15",209,"غَـٰفِلُونَ","heedless","هُمْ عَنْ ءَايَـٰتِنَا","",399],["10:29:10",212,"لَغَـٰفِلِينَ","certainly unaware","كُنَّا عَنْ عِبَادَتِكُمْ","",399],["10:92:14",219,"لَغَـٰفِلُونَ","(are) surely heedless","ٱلنَّاسِ عَنْ ءَايَـٰتِنَا","",399],["11:123:14",235,"بِغَـٰفِلٍ","unaware","عَلَيْهِ ۚ وَمَا رَبُّكَ","عَمَّا تَعْمَلُونَ",399],["12:3:16",235,"ٱلْغَـٰفِلِينَ","the unaware","مِن قَبْلِهِۦ لَمِنَ","",399],["12:13:13",236,"غَـٰفِلُونَ","(are) unaware","ٱلذِّئْبُ وَأَنتُمْ عَنْهُ","",399],["14:42:4",260,"غَـٰفِلًا","(is) unaware","وَلَا تَحْسَبَنَّ ٱللَّهَ","عَمَّا يَعْمَلُ ٱلظَّـٰلِمُونَ ۚ",399],["16:108:11",279,"ٱلْغَـٰفِلُونَ","the heedless","وَأَبْصَـٰرِهِمْ ۖ وَأُو۟لَـٰٓئِكَ هُمُ","",399],["18:28:22",297,"أَغْفَلْنَا","We have made heedless","وَلَا تُطِعْ مَنْ","قَلْبَهُۥ عَن ذِكْرِنَا",2988],["19:39:9",308,"غَفْلَةٍۢ","heedlessness","ٱلْأَمْرُ وَهُمْ فِى","وَهُمْ لَا يُؤْمِنُونَ",1335],["21:1:6",322,"غَفْلَةٍۢ","heedlessness","حِسَابُهُمْ وَهُمْ فِى","مُّعْرِضُونَ",1335],["21:97:14",330,"غَفْلَةٍۢ","heedlessness","قَدْ كُنَّا فِى","مِّنْ هَـٰذَا بَلْ",1335],["23:17:10",342,"غَـٰفِلِينَ","unaware","كُنَّا عَنِ ٱلْخَلْقِ","",399],["24:23:5",352,"ٱلْغَـٰفِلَـٰتِ","the unaware women","ٱلَّذِينَ يَرْمُونَ ٱلْمُحْصَنَـٰتِ","ٱلْمُؤْمِنَـٰتِ لُعِنُوا۟ فِى",3453],["27:93:9",385,"بِغَـٰفِلٍ","unaware","فَتَعْرِفُونَهَا ۚ وَمَا رَبُّكَ","عَمَّا تَعْمَلُونَ",399],["28:15:5",387,"غَفْلَةٍۢ","(of) inattention","ٱلْمَدِينَةَ عَلَىٰ حِينِ","مِّنْ أَهْلِهَا فَوَجَدَ",1335],["30:7:10",405,"غَـٰفِلُونَ","(are) heedless","عَنِ ٱلْـَٔاخِرَةِ هُمْ","",399],["36:6:7",440,"غَـٰفِلُونَ","(are) heedless","أُنذِرَ ءَابَآؤُهُمْ فَهُمْ","",399],["46:5:18",502,"غَـٰفِلُونَ","(are) unaware","وَهُمْ عَن دُعَآئِهِمْ","",399],["50:22:4",519,"غَفْلَةٍۢ","heedlessness","لَّقَدْ كُنتَ فِى","مِّنْ هَـٰذَا فَكَشَفْنَا",1335]]