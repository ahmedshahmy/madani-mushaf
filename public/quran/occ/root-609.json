[["3:75:20",59,"دُمْتَ","you keep constantly","إِلَيْكَ إِلَّا مَا","عَلَيْهِ قَآئِمًۭا ۗ ذَٰلِكَ",1067],["5:24:8",112,"دَامُوا۟","as long as they are","نَّدْخُلَهَآ أَبَدًۭا مَّا","فِيهَا ۖ فَٱذْهَبْ أَنتَ",1067],["5:96:14",124,"دُمْتُمْ","long as you","صَيْدُ ٱلْبَرِّ مَا","حُرُمًۭا ۗ وَٱتَّقُوا۟ ٱللَّهَ",1067],["5:117:17",127,"دُمْتُ","as long as I","عَلَيْهِمْ شَهِيدًۭا مَّا","فِيهِمْ ۖ فَلَمَّا تَوَفَّيْتَنِى",1067],["11:107:4",233,"دَامَتِ","as long as remain","خَـٰلِدِينَ فِيهَا مَا","ٱلسَّمَـٰوَٰتُ وَٱلْأَرْضُ إِلَّا",1067],["11:108:9",233,"دَامَتِ","as long as remains","خَـٰلِدِينَ فِيهَا مَا","ٱلسَّمَـٰوَٰتُ وَٱلْأَرْضُ إِلَّا",1067],["13:35:11",254,"دَآئِمٌۭ","(is) everlasting","تَحْتِهَا ٱلْأَنْهَـٰرُ ۖ أُكُلُهَا","وَظِلُّهَا ۚ تِلْكَ عُقْبَى",2349],["19:31:10",307,"دُمْتُ","as long as I am","بِٱلصَّلَوٰةِ وَٱلزَّكَوٰةِ مَا","حَيًّۭا",1067],["70:23:5",569,"دَآئِمُونَ","(are) constant","هُمْ عَلَىٰ صَلَاتِهِمْ","",2349]]