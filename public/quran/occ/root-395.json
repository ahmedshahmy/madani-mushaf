[["2:78:7",12,"أَمَانِىَّ","wishful thinking","يَعْلَمُونَ ٱلْكِتَـٰبَ إِلَّآ","وَإِنْ هُمْ إِلَّا",1145],["2:94:13",15,"فَتَمَنَّوُا۟","then wish","مِّن دُونِ ٱلنَّاسِ","ٱلْمَوْتَ إِن كُنتُمْ",1255],["2:95:2",15,"يَتَمَنَّوْهُ","they wish for it","وَلَن","أَبَدًۢا بِمَا قَدَّمَتْ",1255],["2:111:12",17,"أَمَانِيُّهُمْ ۗ","(is) their wishful thinking","أَوْ نَصَـٰرَىٰ ۗ تِلْكَ","قُلْ هَاتُوا۟ بُرْهَـٰنَكُمْ",1145],["3:143:3",68,"تَمَنَّوْنَ","wish","وَلَقَدْ كُنتُمْ","ٱلْمَوْتَ مِن قَبْلِ",1255],["4:32:2",83,"تَتَمَنَّوْا۟","covet","وَلَا","مَا فَضَّلَ ٱللَّهُ",1255],["4:119:2",97,"وَلَأُمَنِّيَنَّهُمْ","and surely arouse desires in them","وَلَأُضِلَّنَّهُمْ","وَلَـَٔامُرَنَّهُمْ فَلَيُبَتِّكُنَّ ءَاذَانَ",2810],["4:120:2",97,"وَيُمَنِّيهِمْ ۖ","and arouses desires in them","يَعِدُهُمْ","وَمَا يَعِدُهُمُ ٱلشَّيْطَـٰنُ",2810],["4:123:2",98,"بِأَمَانِيِّكُمْ","by your desire","لَّيْسَ","وَلَآ أَمَانِىِّ أَهْلِ",1145],["4:123:4",98,"أَمَانِىِّ","(by the) desire","لَّيْسَ بِأَمَانِيِّكُمْ وَلَآ","أَهْلِ ٱلْكِتَـٰبِ ۗ مَن",1145],["22:52:11",338,"تَمَنَّىٰٓ","he recited","نَبِىٍّ إِلَّآ إِذَا","أَلْقَى ٱلشَّيْطَـٰنُ فِىٓ",2009],["22:52:15",338,"أُمْنِيَّتِهِۦ","his recitation","أَلْقَى ٱلشَّيْطَـٰنُ فِىٓ","فَيَنسَخُ ٱللَّهُ مَا",1145],["28:82:3",395,"تَمَنَّوْا۟","(had) wished","وَأَصْبَحَ ٱلَّذِينَ","مَكَانَهُۥ بِٱلْأَمْسِ يَقُولُونَ",2009],["53:24:4",526,"تَمَنَّىٰ","he wishes","أَمْ لِلْإِنسَـٰنِ مَا","",2009],["53:46:4",528,"تُمْنَىٰ","it is emitted","مِن نُّطْفَةٍ إِذَا","",2082],["56:58:3",536,"تُمْنُونَ","you emit","أَفَرَءَيْتُم مَّا","",2082],["57:14:13",539,"ٱلْأَمَانِىُّ","the wishful thinking","وَتَرَبَّصْتُمْ وَٱرْتَبْتُمْ وَغَرَّتْكُمُ","حَتَّىٰ جَآءَ أَمْرُ",1145],["62:6:13",553,"فَتَمَنَّوُا۟","then wish","مِن دُونِ ٱلنَّاسِ","ٱلْمَوْتَ إِن كُنتُمْ",1255],["62:7:2",553,"يَتَمَنَّوْنَهُۥٓ","they will wish for it","وَلَا","أَبَدًۢا بِمَا قَدَّمَتْ",1255],["75:37:5",578,"مَّنِىٍّۢ","semen","يَكُ نُطْفَةًۭ مِّن","يُمْنَىٰ",3918],["75:37:6",578,"يُمْنَىٰ","emitted","نُطْفَةًۭ مِّن مَّنِىٍّۢ","",2082]]