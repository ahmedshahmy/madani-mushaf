[["2:27:3",5,"عَهْدَ","(the) Covenant","ٱلَّذِينَ يَنقُضُونَ","ٱللَّهِ مِنۢ بَعْدِ",371],["2:40:9",7,"بِعَهْدِىٓ","My Covenant","أَنْعَمْتُ عَلَيْكُمْ وَأَوْفُوا۟","أُوفِ بِعَهْدِكُمْ وَإِيَّـٰىَ",371],["2:40:11",7,"بِعَهْدِكُمْ","your covenant","وَأَوْفُوا۟ بِعَهْدِىٓ أُوفِ","وَإِيَّـٰىَ فَٱرْهَبُونِ",371],["2:80:12",12,"عَهْدًۭا","a covenant","أَتَّخَذْتُمْ عِندَ ٱللَّهِ","فَلَن يُخْلِفَ ٱللَّهُ",371],["2:80:16",12,"عَهْدَهُۥٓ ۖ","His Covenant","فَلَن يُخْلِفَ ٱللَّهُ","أَمْ تَقُولُونَ عَلَى",371],["2:100:2",15,"عَـٰهَدُوا۟","they took","أَوَكُلَّمَا","عَهْدًۭا نَّبَذَهُۥ فَرِيقٌۭ",767],["2:100:3",15,"عَهْدًۭا","a covenant","أَوَكُلَّمَا عَـٰهَدُوا۟","نَّبَذَهُۥ فَرِيقٌۭ مِّنْهُم ۚ",371],["2:124:18",19,"عَهْدِى","My Covenant","قَالَ لَا يَنَالُ","ٱلظَّـٰلِمِينَ",371],["2:125:12",19,"وَعَهِدْنَآ","And We made a covenant","مَّقَامِ إِبْرَٰهِـۧمَ مُصَلًّۭى ۖ","إِلَىٰٓ إِبْرَٰهِـۧمَ وَإِسْمَـٰعِيلَ",1153],["2:177:37",27,"بِعَهْدِهِمْ","their covenant","وَءَاتَى ٱلزَّكَوٰةَ وَٱلْمُوفُونَ","إِذَا عَـٰهَدُوا۟ ۖ وَٱلصَّـٰبِرِينَ",371],["2:177:39",27,"عَـٰهَدُوا۟ ۖ","they make it","وَٱلْمُوفُونَ بِعَهْدِهِمْ إِذَا","وَٱلصَّـٰبِرِينَ فِى ٱلْبَأْسَآءِ",767],["3:76:4",59,"بِعَهْدِهِۦ","his covenant","بَلَىٰ مَنْ أَوْفَىٰ","وَٱتَّقَىٰ فَإِنَّ ٱللَّهَ",371],["3:77:4",59,"بِعَهْدِ","(the) Covenant","إِنَّ ٱلَّذِينَ يَشْتَرُونَ","ٱللَّهِ وَأَيْمَـٰنِهِمْ ثَمَنًۭا",371],["3:183:5",74,"عَهِدَ","(has) taken promise","قَالُوٓا۟ إِنَّ ٱللَّهَ","إِلَيْنَآ أَلَّا نُؤْمِنَ",1153],["6:152:28",149,"وَبِعَهْدِ","And (the) Covenant","كَانَ ذَا قُرْبَىٰ ۖ","ٱللَّهِ أَوْفُوا۟ ۚ ذَٰلِكُمْ",371],["7:102:5",163,"عَهْدٍۢ ۖ","covenant","وَجَدْنَا لِأَكْثَرِهِم مِّنْ","وَإِن وَجَدْنَآ أَكْثَرَهُمْ",371],["7:134:11",166,"عَهِدَ","He has promised","لَنَا رَبَّكَ بِمَا","عِندَكَ ۖ لَئِن كَشَفْتَ",1153],["8:56:2",184,"عَـٰهَدتَّ","you made a covenant","ٱلَّذِينَ","مِنْهُمْ ثُمَّ يَنقُضُونَ",767],["8:56:6",184,"عَهْدَهُمْ","their covenant","مِنْهُمْ ثُمَّ يَنقُضُونَ","فِى كُلِّ مَرَّةٍۢ",371],["9:1:7",187,"عَـٰهَدتُّم","you made a covenant","وَرَسُولِهِۦٓ إِلَى ٱلَّذِينَ","مِّنَ ٱلْمُشْرِكِينَ",767],["9:4:3",187,"عَـٰهَدتُّم","you have a covenant","إِلَّا ٱلَّذِينَ","مِّنَ ٱلْمُشْرِكِينَ ثُمَّ",767],["9:4:16",187,"عَهْدَهُمْ","their treaty","أَحَدًۭا فَأَتِمُّوٓا۟ إِلَيْهِمْ","إِلَىٰ مُدَّتِهِمْ ۚ إِنَّ",371],["9:7:4",188,"عَهْدٌ","a covenant","كَيْفَ يَكُونُ لِلْمُشْرِكِينَ","عِندَ ٱللَّهِ وَعِندَ",371],["9:7:11",188,"عَـٰهَدتُّمْ","you made a covenant","رَسُولِهِۦٓ إِلَّا ٱلَّذِينَ","عِندَ ٱلْمَسْجِدِ ٱلْحَرَامِ ۖ",767],["9:12:6",188,"عَهْدِهِمْ","their treaty","أَيْمَـٰنَهُم مِّنۢ بَعْدِ","وَطَعَنُوا۟ فِى دِينِكُمْ",371],["9:75:3",199,"عَـٰهَدَ","made a covenant","۞ وَمِنْهُم مَّنْ","ٱللَّهَ لَئِنْ ءَاتَىٰنَا",767],["9:111:26",204,"بِعَهْدِهِۦ","to his promise","وَٱلْقُرْءَانِ ۚ وَمَنْ أَوْفَىٰ","مِنَ ٱللَّهِ ۚ فَٱسْتَبْشِرُوا۟",371],["13:20:3",252,"بِعَهْدِ","the covenant","ٱلَّذِينَ يُوفُونَ","ٱللَّهِ وَلَا يَنقُضُونَ",371],["13:25:3",252,"عَهْدَ","the covenant","وَٱلَّذِينَ يَنقُضُونَ","ٱللَّهِ مِنۢ بَعْدِ",371],["16:91:2",277,"بِعَهْدِ","the covenant","وَأَوْفُوا۟","ٱللَّهِ إِذَا عَـٰهَدتُّمْ",371],["16:91:5",277,"عَـٰهَدتُّمْ","you have taken a covenant","بِعَهْدِ ٱللَّهِ إِذَا","وَلَا تَنقُضُوا۟ ٱلْأَيْمَـٰنَ",767],["16:95:3",278,"بِعَهْدِ","the covenant","وَلَا تَشْتَرُوا۟","ٱللَّهِ ثَمَنًۭا قَلِيلًا ۚ",371],["17:34:13",285,"بِٱلْعَهْدِ ۖ","the covenant","يَبْلُغَ أَشُدَّهُۥ ۚ وَأَوْفُوا۟","إِنَّ ٱلْعَهْدَ كَانَ",371],["17:34:15",285,"ٱلْعَهْدَ","the covenant","وَأَوْفُوا۟ بِٱلْعَهْدِ ۖ إِنَّ","كَانَ مَسْـُٔولًۭا",371],["19:78:7",311,"عَهْدًۭا","a promise","ٱتَّخَذَ عِندَ ٱلرَّحْمَـٰنِ","",371],["19:87:9",311,"عَهْدًۭا","a covenant","ٱتَّخَذَ عِندَ ٱلرَّحْمَـٰنِ","",371],["20:86:16",317,"ٱلْعَهْدُ","the promise","حَسَنًا ۚ أَفَطَالَ عَلَيْكُمُ","أَمْ أَرَدتُّمْ أَن",371],["20:115:2",320,"عَهِدْنَآ","We made a covenant","وَلَقَدْ","إِلَىٰٓ ءَادَمَ مِن",1153],["23:8:4",342,"وَعَهْدِهِمْ","and their promise(s)","وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ","رَٰعُونَ",371],["33:15:3",419,"عَـٰهَدُوا۟","promised","وَلَقَدْ كَانُوا۟","ٱللَّهَ مِن قَبْلُ",767],["33:15:11",419,"عَهْدُ","(the) promise","يُوَلُّونَ ٱلْأَدْبَـٰرَ ۚ وَكَانَ","ٱللَّهِ مَسْـُٔولًۭا",371],["33:23:6",421,"عَـٰهَدُوا۟","they promised Allah","رِجَالٌۭ صَدَقُوا۟ مَا","ٱللَّهَ عَلَيْهِ ۖ فَمِنْهُم",767],["36:60:2",444,"أَعْهَدْ","I enjoin","۞ أَلَمْ","إِلَيْكُمْ يَـٰبَنِىٓ ءَادَمَ",1153],["43:49:8",493,"عَهِدَ","He has made covenant","لَنَا رَبَّكَ بِمَا","عِندَكَ إِنَّنَا لَمُهْتَدُونَ",1153],["48:10:20",512,"عَـٰهَدَ","he has covenanted","وَمَنْ أَوْفَىٰ بِمَا","عَلَيْهُ ٱللَّهَ فَسَيُؤْتِيهِ",767],["70:32:4",569,"وَعَهْدِهِمْ","and their promise","وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ","رَٰعُونَ",371]]