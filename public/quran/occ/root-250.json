[["2:102:41",16,"ٱلْمَرْءِ","the man","يُفَرِّقُونَ بِهِۦ بَيْنَ","وَزَوْجِهِۦ ۚ وَمَا هُم",1582],["2:282:61",48,"وَٱمْرَأَتَانِ","and two women","يَكُونَا رَجُلَيْنِ فَرَجُلٌۭ","مِمَّن تَرْضَوْنَ مِنَ",420],["3:35:3",54,"ٱمْرَأَتُ","(the) wife","إِذْ قَالَتِ","عِمْرَٰنَ رَبِّ إِنِّى",420],["3:40:10",55,"وَٱمْرَأَتِى","and my wife","وَقَدْ بَلَغَنِىَ ٱلْكِبَرُ","عَاقِرٌۭ ۖ قَالَ كَذَٰلِكَ",420],["4:4:14",77,"مَّرِيٓـًۭٔا","(and) ease","نَفْسًۭا فَكُلُوهُ هَنِيٓـًۭٔا","",3925],["4:12:56",79,"ٱمْرَأَةٌۭ","a women","يُورَثُ كَلَـٰلَةً أَوِ","وَلَهُۥٓ أَخٌ أَوْ",420],["4:128:2",99,"ٱمْرَأَةٌ","a woman","وَإِنِ","خَافَتْ مِنۢ بَعْلِهَا",420],["4:176:8",106,"ٱمْرُؤٌا۟","a man","فِى ٱلْكَلَـٰلَةِ ۚ إِنِ","هَلَكَ لَيْسَ لَهُۥ",4808],["7:83:4",161,"ٱمْرَأَتَهُۥ","his wife","فَأَنجَيْنَـٰهُ وَأَهْلَهُۥٓ إِلَّا","كَانَتْ مِنَ ٱلْغَـٰبِرِينَ",420],["8:24:16",179,"ٱلْمَرْءِ","a man","ٱللَّهَ يَحُولُ بَيْنَ","وَقَلْبِهِۦ وَأَنَّهُۥٓ إِلَيْهِ",1582],["11:71:1",229,"وَٱمْرَأَتُهُۥ","And his wife","","قَآئِمَةٌۭ فَضَحِكَتْ فَبَشَّرْنَـٰهَا",420],["11:81:19",230,"ٱمْرَأَتَكَ ۖ","your wife","مِنكُمْ أَحَدٌ إِلَّا","إِنَّهُۥ مُصِيبُهَا مَآ",420],["12:21:6",237,"لِٱمْرَأَتِهِۦٓ","to his wife","ٱشْتَرَىٰهُ مِن مِّصْرَ","أَكْرِمِى مَثْوَىٰهُ عَسَىٰٓ",420],["12:30:5",238,"ٱمْرَأَتُ","The wife of","نِسْوَةٌۭ فِى ٱلْمَدِينَةِ","ٱلْعَزِيزِ تُرَٰوِدُ فَتَىٰهَا",420],["12:51:18",241,"ٱمْرَأَتُ","(the) wife","مِن سُوٓءٍۢ ۚ قَالَتِ","ٱلْعَزِيزِ ٱلْـَٔـٰنَ حَصْحَصَ",420],["15:60:2",265,"ٱمْرَأَتَهُۥ","his wife","إِلَّا","قَدَّرْنَآ ۙ إِنَّهَا لَمِنَ",420],["19:5:7",305,"ٱمْرَأَتِى","my wife","مِن وَرَآءِى وَكَانَتِ","عَاقِرًۭا فَهَبْ لِى",420],["19:8:8",305,"ٱمْرَأَتِى","my wife","لِى غُلَـٰمٌۭ وَكَانَتِ","عَاقِرًۭا وَقَدْ بَلَغْتُ",420],["19:28:6",307,"ٱمْرَأَ","an evil man","مَا كَانَ أَبُوكِ","سَوْءٍۢ وَمَا كَانَتْ",4807],["24:11:16",351,"ٱمْرِئٍۢ","person","خَيْرٌۭ لَّكُمْ ۚ لِكُلِّ","مِّنْهُم مَّا ٱكْتَسَبَ",1444],["27:23:3",379,"ٱمْرَأَةًۭ","a woman","إِنِّى وَجَدتُّ","تَمْلِكُهُمْ وَأُوتِيَتْ مِن",420],["27:57:4",382,"ٱمْرَأَتَهُۥ","his wife","فَأَنجَيْنَـٰهُ وَأَهْلَهُۥٓ إِلَّا","قَدَّرْنَـٰهَا مِنَ ٱلْغَـٰبِرِينَ",420],["28:9:2",386,"ٱمْرَأَتُ","(the) wife","وَقَالَتِ","فِرْعَوْنَ قُرَّتُ عَيْنٍۢ",420],["28:23:14",388,"ٱمْرَأَتَيْنِ","two women","وَوَجَدَ مِن دُونِهِمُ","تَذُودَانِ ۖ قَالَ مَا",420],["29:32:13",400,"ٱمْرَأَتَهُۥ","his wife","لَنُنَجِّيَنَّهُۥ وَأَهْلَهُۥٓ إِلَّا","كَانَتْ مِنَ ٱلْغَـٰبِرِينَ",420],["29:33:20",400,"ٱمْرَأَتَكَ","your wife","مُنَجُّوكَ وَأَهْلَكَ إِلَّا","كَانَتْ مِنَ ٱلْغَـٰبِرِينَ",420],["33:50:28",424,"وَٱمْرَأَةًۭ","and a woman","ٱلَّـٰتِى هَاجَرْنَ مَعَكَ","مُّؤْمِنَةً إِن وَهَبَتْ",420],["51:29:2",521,"ٱمْرَأَتُهُۥ","his wife","فَأَقْبَلَتِ","فِى صَرَّةٍۢ فَصَكَّتْ",420],["52:21:16",524,"ٱمْرِئٍۭ","person","مِّن شَىْءٍۢ ۚ كُلُّ","بِمَا كَسَبَ رَهِينٌۭ",1444],["66:10:6",561,"ٱمْرَأَتَ","(the) wife","مَثَلًۭا لِّلَّذِينَ كَفَرُوا۟","نُوحٍۢ وَٱمْرَأَتَ لُوطٍۢ ۖ",420],["66:10:8",561,"وَٱمْرَأَتَ","(and the) wife","كَفَرُوا۟ ٱمْرَأَتَ نُوحٍۢ","لُوطٍۢ ۖ كَانَتَا تَحْتَ",420],["66:11:6",561,"ٱمْرَأَتَ","(the) wife","مَثَلًۭا لِّلَّذِينَ ءَامَنُوا۟","فِرْعَوْنَ إِذْ قَالَتْ",420],["70:38:3",569,"ٱمْرِئٍۢ","person","أَيَطْمَعُ كُلُّ","مِّنْهُمْ أَن يُدْخَلَ",1444],["74:52:4",577,"ٱمْرِئٍۢ","person","بَلْ يُرِيدُ كُلُّ","مِّنْهُمْ أَن يُؤْتَىٰ",1444],["78:40:7",583,"ٱلْمَرْءُ","the man","قَرِيبًۭا يَوْمَ يَنظُرُ","مَا قَدَّمَتْ يَدَاهُ",1582],["80:34:3",585,"ٱلْمَرْءُ","a man","يَوْمَ يَفِرُّ","مِنْ أَخِيهِ",1582],["80:37:2",585,"ٱمْرِئٍۢ","man","لِكُلِّ","مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ",1444],["111:4:1",603,"وَٱمْرَأَتُهُۥ","And his wife","","حَمَّالَةَ ٱلْحَطَبِ",420]]