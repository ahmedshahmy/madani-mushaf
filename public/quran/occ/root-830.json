[["2:259:7",43,"خَاوِيَةٌ","(had) overturned","عَلَىٰ قَرْيَةٍۢ وَهِىَ","عَلَىٰ عُرُوشِهَا قَالَ",1415],["18:42:11",298,"خَاوِيَةٌ","collapsed","أَنفَقَ فِيهَا وَهِىَ","عَلَىٰ عُرُوشِهَا وَيَقُولُ",1415],["22:45:8",337,"خَاوِيَةٌ","fell","وَهِىَ ظَالِمَةٌۭ فَهِىَ","عَلَىٰ عُرُوشِهَا وَبِئْرٍۢ",1415],["27:52:3",381,"خَاوِيَةًۢ","ruined","فَتِلْكَ بُيُوتُهُمْ","بِمَا ظَلَمُوٓا۟ ۗ إِنَّ",1415],["69:7:15",566,"خَاوِيَةٍۢ","hollow","كَأَنَّهُمْ أَعْجَازُ نَخْلٍ","",1415]]