[["2:103:5",16,"لَمَثُوبَةٌۭ","surely (the) reward","أَنَّهُمْ ءَامَنُوا۟ وَٱتَّقَوْا۟","مِّنْ عِندِ ٱللَّهِ",2469],["2:125:4",19,"مَثَابَةًۭ","a place of return","وَإِذْ جَعَلْنَا ٱلْبَيْتَ","لِّلنَّاسِ وَأَمْنًۭا وَٱتَّخِذُوا۟",3720],["3:145:13",68,"ثَوَابَ","reward","مُّؤَجَّلًۭا ۗ وَمَن يُرِدْ","ٱلدُّنْيَا نُؤْتِهِۦ مِنْهَا",700],["3:145:19",68,"ثَوَابَ","reward","مِنْهَا وَمَن يُرِدْ","ٱلْـَٔاخِرَةِ نُؤْتِهِۦ مِنْهَا ۚ",700],["3:148:3",68,"ثَوَابَ","reward","فَـَٔاتَىٰهُمُ ٱللَّهُ","ٱلدُّنْيَا وَحُسْنَ ثَوَابِ",700],["3:148:6",68,"ثَوَابِ","reward","ثَوَابَ ٱلدُّنْيَا وَحُسْنَ","ٱلْـَٔاخِرَةِ ۗ وَٱللَّهُ يُحِبُّ",700],["3:153:11",69,"فَأَثَـٰبَكُمْ","So (He) repaid you","يَدْعُوكُمْ فِىٓ أُخْرَىٰكُمْ","غَمًّۢا بِغَمٍّۢ لِّكَيْلَا",1743],["3:195:36",76,"ثَوَابًۭا","a reward","مِن تَحْتِهَا ٱلْأَنْهَـٰرُ","مِّنْ عِندِ ٱللَّهِ ۗ",700],["3:195:43",76,"ٱلثَّوَابِ","reward","وَٱللَّهُ عِندَهُۥ حُسْنُ","",700],["4:134:4",99,"ثَوَابَ","reward","مَّن كَانَ يُرِيدُ","ٱلدُّنْيَا فَعِندَ ٱللَّهِ",700],["4:134:8",99,"ثَوَابُ","(is the) reward","ٱلدُّنْيَا فَعِندَ ٱللَّهِ","ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ ۚ وَكَانَ",700],["5:60:7",118,"مَثُوبَةً","(as) recompense","بِشَرٍّۢ مِّن ذَٰلِكَ","عِندَ ٱللَّهِ ۚ مَن",2469],["5:85:1",122,"فَأَثَـٰبَهُمُ","So rewarded them","","ٱللَّهُ بِمَا قَالُوا۟",1743],["11:5:10",221,"ثِيَابَهُمْ","(with) their garments","أَلَا حِينَ يَسْتَغْشُونَ","يَعْلَمُ مَا يُسِرُّونَ",1005],["18:31:16",297,"ثِيَابًا","garments","مِن ذَهَبٍۢ وَيَلْبَسُونَ","خُضْرًۭا مِّن سُندُسٍۢ",1005],["18:31:26",297,"ٱلثَّوَابُ","(is) the reward","عَلَى ٱلْأَرَآئِكِ ۚ نِعْمَ","وَحَسُنَتْ مُرْتَفَقًۭا",700],["18:44:7",298,"ثَوَابًۭا","(to) reward","ٱلْحَقِّ ۚ هُوَ خَيْرٌۭ","وَخَيْرٌ عُقْبًۭا",700],["18:46:11",299,"ثَوَابًۭا","(for) reward","خَيْرٌ عِندَ رَبِّكَ","وَخَيْرٌ أَمَلًۭا",700],["19:76:11",310,"ثَوَابًۭا","(for) reward","خَيْرٌ عِندَ رَبِّكَ","وَخَيْرٌۭ مَّرَدًّا",700],["22:19:10",334,"ثِيَابٌۭ","garments","كَفَرُوا۟ قُطِّعَتْ لَهُمْ","مِّن نَّارٍۢ يُصَبُّ",1005],["24:58:21",357,"ثِيَابَكُم","your garments","ٱلْفَجْرِ وَحِينَ تَضَعُونَ","مِّنَ ٱلظَّهِيرَةِ وَمِنۢ",1005],["24:60:13",358,"ثِيَابَهُنَّ","their (outer) garments","جُنَاحٌ أَن يَضَعْنَ","غَيْرَ مُتَبَرِّجَـٰتٍۭ بِزِينَةٍۢ ۖ",1005],["28:80:6",395,"ثَوَابُ","(The) reward","أُوتُوا۟ ٱلْعِلْمَ وَيْلَكُمْ","ٱللَّهِ خَيْرٌۭ لِّمَنْ",700],["48:18:17",513,"وَأَثَـٰبَهُمْ","and rewarded them","فَأَنزَلَ ٱلسَّكِينَةَ عَلَيْهِمْ","فَتْحًۭا قَرِيبًۭا",1743],["71:7:11",570,"ثِيَابَهُمْ","(with) their garments","فِىٓ ءَاذَانِهِمْ وَٱسْتَغْشَوْا۟","وَأَصَرُّوا۟ وَٱسْتَكْبَرُوا۟ ٱسْتِكْبَارًۭا",1005],["74:4:1",575,"وَثِيَابَكَ","And your clothing","","فَطَهِّرْ",1005],["76:21:2",579,"ثِيَابُ","(will be) garments","عَـٰلِيَهُمْ","سُندُسٍ خُضْرٌۭ وَإِسْتَبْرَقٌۭ ۖ",1005],["83:36:2",589,"ثُوِّبَ","been rewarded","هَلْ","ٱلْكُفَّارُ مَا كَانُوا۟",4502]]