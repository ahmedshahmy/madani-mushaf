[["2:26:11",5,"فَوْقَهَا ۚ","above it","مَّا بَعُوضَةًۭ فَمَا","فَأَمَّا ٱلَّذِينَ ءَامَنُوا۟",284],["2:63:5",10,"فَوْقَكُمُ","over you","أَخَذْنَا مِيثَـٰقَكُمْ وَرَفَعْنَا","ٱلطُّورَ خُذُوا۟ مَآ",284],["2:93:5",14,"فَوْقَكُمُ","over you","أَخَذْنَا مِيثَـٰقَكُمْ وَرَفَعْنَا","ٱلطُّورَ خُذُوا۟ مَآ",284],["2:212:12",33,"فَوْقَهُمْ","(they will be) above them","ءَامَنُوا۟ ۘ وَٱلَّذِينَ ٱتَّقَوْا۟","يَوْمَ ٱلْقِيَـٰمَةِ ۗ وَٱللَّهُ",284],["3:55:16",57,"فَوْقَ","superior","وَجَاعِلُ ٱلَّذِينَ ٱتَّبَعُوكَ","ٱلَّذِينَ كَفَرُوٓا۟ إِلَىٰ",284],["4:11:12",78,"فَوْقَ","more (than)","فَإِن كُنَّ نِسَآءًۭ","ٱثْنَتَيْنِ فَلَهُنَّ ثُلُثَا",284],["4:154:2",102,"فَوْقَهُمُ","over them","وَرَفَعْنَا","ٱلطُّورَ بِمِيثَـٰقِهِمْ وَقُلْنَا",284],["5:66:13",119,"فَوْقِهِمْ","above them","رَّبِّهِمْ لَأَكَلُوا۟ مِن","وَمِن تَحْتِ أَرْجُلِهِم ۚ",284],["6:18:3",129,"فَوْقَ","over","وَهُوَ ٱلْقَاهِرُ","عِبَادِهِۦ ۚ وَهُوَ ٱلْحَكِيمُ",284],["6:61:3",135,"فَوْقَ","over","وَهُوَ ٱلْقَاهِرُ","عِبَادِهِۦ ۖ وَيُرْسِلُ عَلَيْكُمْ",284],["6:65:10",135,"فَوْقِكُمْ","above you","عَلَيْكُمْ عَذَابًۭا مِّن","أَوْ مِن تَحْتِ",284],["6:165:8",150,"فَوْقَ","above","ٱلْأَرْضِ وَرَفَعَ بَعْضَكُمْ","بَعْضٍۢ دَرَجَـٰتٍۢ لِّيَبْلُوَكُمْ",284],["7:41:6",155,"فَوْقِهِمْ","over them","جَهَنَّمَ مِهَادٌۭ وَمِن","غَوَاشٍۢ ۚ وَكَذَٰلِكَ نَجْزِى",284],["7:127:20",165,"فَوْقَهُمْ","over them","وَنَسْتَحْىِۦ نِسَآءَهُمْ وَإِنَّا","قَـٰهِرُونَ",284],["7:143:34",167,"أَفَاقَ","he recovered","مُوسَىٰ صَعِقًۭا ۚ فَلَمَّآ","قَالَ سُبْحَـٰنَكَ تُبْتُ",2983],["7:171:4",173,"فَوْقَهُمْ","above them","۞ وَإِذْ نَتَقْنَا ٱلْجَبَلَ","كَأَنَّهُۥ ظُلَّةٌۭ وَظَنُّوٓا۟",284],["8:12:18",178,"فَوْقَ","above","كَفَرُوا۟ ٱلرُّعْبَ فَٱضْرِبُوا۟","ٱلْأَعْنَاقِ وَٱضْرِبُوا۟ مِنْهُمْ",284],["12:36:16",239,"فَوْقَ","over","إِنِّىٓ أَرَىٰنِىٓ أَحْمِلُ","رَأْسِى خُبْزًۭا تَأْكُلُ",284],["12:76:29",244,"وَفَوْقَ","but over","دَرَجَـٰتٍۢ مَّن نَّشَآءُ ۗ","كُلِّ ذِى عِلْمٍ",284],["14:26:8",259,"فَوْقِ","the surface","خَبِيثَةٍ ٱجْتُثَّتْ مِن","ٱلْأَرْضِ مَا لَهَا",284],["16:26:15",269,"فَوْقِهِمْ","above them","عَلَيْهِمُ ٱلسَّقْفُ مِن","وَأَتَىٰهُمُ ٱلْعَذَابُ مِنْ",284],["16:50:4",272,"فَوْقِهِمْ","above them","يَخَافُونَ رَبَّهُم مِّن","وَيَفْعَلُونَ مَا يُؤْمَرُونَ ۩",284],["16:88:9",277,"فَوْقَ","over","ٱللَّهِ زِدْنَـٰهُمْ عَذَابًۭا","ٱلْعَذَابِ بِمَا كَانُوا۟",284],["22:19:15",334,"فَوْقِ","over","نَّارٍۢ يُصَبُّ مِن","رُءُوسِهِمُ ٱلْحَمِيمُ",284],["23:17:3",342,"فَوْقَكُمْ","above you","وَلَقَدْ خَلَقْنَا","سَبْعَ طَرَآئِقَ وَمَا",284],["24:40:9",355,"فَوْقِهِۦ","on it","يَغْشَىٰهُ مَوْجٌۭ مِّن","مَوْجٌۭ مِّن فَوْقِهِۦ",284],["24:40:12",355,"فَوْقِهِۦ","on it","فَوْقِهِۦ مَوْجٌۭ مِّن","سَحَابٌۭ ۚ ظُلُمَـٰتٌۢ بَعْضُهَا",284],["24:40:16",355,"فَوْقَ","on","سَحَابٌۭ ۚ ظُلُمَـٰتٌۢ بَعْضُهَا","بَعْضٍ إِذَآ أَخْرَجَ",284],["29:55:5",403,"فَوْقِهِمْ","above them","يَغْشَىٰهُمُ ٱلْعَذَابُ مِن","وَمِن تَحْتِ أَرْجُلِهِمْ",284],["33:10:4",419,"فَوْقِكُمْ","above you","إِذْ جَآءُوكُم مِّن","وَمِنْ أَسْفَلَ مِنكُمْ",284],["38:15:10",453,"فَوَاقٍۢ","delay","مَّا لَهَا مِن","",3429],["39:16:3",460,"فَوْقِهِمْ","above them","لَهُم مِّن","ظُلَلٌۭ مِّنَ ٱلنَّارِ",284],["39:20:8",460,"فَوْقِهَا","above them","لَهُمْ غُرَفٌۭ مِّن","غُرَفٌۭ مَّبْنِيَّةٌۭ تَجْرِى",284],["41:10:5",477,"فَوْقِهَا","above it","فِيهَا رَوَٰسِىَ مِن","وَبَـٰرَكَ فِيهَا وَقَدَّرَ",284],["42:5:5",483,"فَوْقِهِنَّ ۚ","above them","ٱلسَّمَـٰوَٰتُ يَتَفَطَّرْنَ مِن","وَٱلْمَلَـٰٓئِكَةُ يُسَبِّحُونَ بِحَمْدِ",284],["43:32:14",491,"فَوْقَ","above","ٱلدُّنْيَا ۚ وَرَفَعْنَا بَعْضَهُمْ","بَعْضٍۢ دَرَجَـٰتٍۢ لِّيَتَّخِذَ",284],["44:48:3",498,"فَوْقَ","over","ثُمَّ صُبُّوا۟","رَأْسِهِۦ مِنْ عَذَابِ",284],["48:10:9",512,"فَوْقَ","(is) over","ٱللَّهَ يَدُ ٱللَّهِ","أَيْدِيهِمْ ۚ فَمَن نَّكَثَ",284],["49:2:7",515,"فَوْقَ","above","لَا تَرْفَعُوٓا۟ أَصْوَٰتَكُمْ","صَوْتِ ٱلنَّبِىِّ وَلَا",284],["50:6:5",518,"فَوْقَهُمْ","above them","يَنظُرُوٓا۟ إِلَى ٱلسَّمَآءِ","كَيْفَ بَنَيْنَـٰهَا وَزَيَّنَّـٰهَا",284],["67:19:5",563,"فَوْقَهُمْ","above them","يَرَوْا۟ إِلَى ٱلطَّيْرِ","صَـٰٓفَّـٰتٍۢ وَيَقْبِضْنَ ۚ مَا",284],["69:17:7",567,"فَوْقَهُمْ","above them","وَيَحْمِلُ عَرْشَ رَبِّكَ","يَوْمَئِذٍۢ ثَمَـٰنِيَةٌۭ",284],["78:12:2",582,"فَوْقَكُمْ","over you","وَبَنَيْنَا","سَبْعًۭا شِدَادًۭا",284]]