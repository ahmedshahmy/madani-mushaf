[["10:26:6",212,"يَرْهَقُ","(will) cover","ٱلْحُسْنَىٰ وَزِيَادَةٌۭ ۖ وَلَا","وُجُوهَهُمْ قَتَرٌۭ وَلَا",1433],["10:27:7",212,"وَتَرْهَقُهُمْ","and (will) cover them","جَزَآءُ سَيِّئَةٍۭ بِمِثْلِهَا","ذِلَّةٌۭ ۖ مَّا لَهُم",1433],["18:73:7",301,"تُرْهِقْنِى","be hard (upon) me","بِمَا نَسِيتُ وَلَا","مِنْ أَمْرِى عُسْرًۭا",2085],["18:80:8",302,"يُرْهِقَهُمَا","he would overburden them","مُؤْمِنَيْنِ فَخَشِينَآ أَن","طُغْيَـٰنًۭا وَكُفْرًۭا",2085],["68:43:3",566,"تَرْهَقُهُمْ","will cover them","خَـٰشِعَةً أَبْصَـٰرُهُمْ","ذِلَّةٌۭ ۖ وَقَدْ كَانُوا۟",1433],["70:44:3",570,"تَرْهَقُهُمْ","will cover them","خَـٰشِعَةً أَبْصَـٰرُهُمْ","ذِلَّةٌۭ ۚ ذَٰلِكَ ٱلْيَوْمُ",1433],["72:6:11",572,"رَهَقًۭا","(in) burden","مِّنَ ٱلْجِنِّ فَزَادُوهُمْ","",2604],["72:13:14",572,"رَهَقًۭا","any burden","يَخَافُ بَخْسًۭا وَلَا","",2604],["74:17:1",575,"سَأُرْهِقُهُۥ","Soon I will cover Him","","صَعُودًا",2085],["80:41:1",586,"تَرْهَقُهَا","Will cover them","","قَتَرَةٌ",1433]]