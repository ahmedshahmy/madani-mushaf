[["3:3:10",50,"ٱلتَّوْرَىٰةَ","the Taurat","بَيْنَ يَدَيْهِ وَأَنزَلَ","وَٱلْإِنجِيلَ",558],["3:48:4",56,"وَٱلتَّوْرَىٰةَ","and the Taurat","وَيُعَلِّمُهُ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ","وَٱلْإِنجِيلَ",558],["3:50:6",56,"ٱلتَّوْرَىٰةِ","the Taurat","بَيْنَ يَدَىَّ مِنَ","وَلِأُحِلَّ لَكُم بَعْضَ",558],["3:65:9",58,"ٱلتَّوْرَىٰةُ","the Taurat","إِبْرَٰهِيمَ وَمَآ أُنزِلَتِ","وَٱلْإِنجِيلُ إِلَّا مِنۢ",558],["3:93:17",62,"ٱلتَّوْرَىٰةُ ۗ","the Taurat","قَبْلِ أَن تُنَزَّلَ","قُلْ فَأْتُوا۟ بِٱلتَّوْرَىٰةِ",558],["3:93:20",62,"بِٱلتَّوْرَىٰةِ","the Taurat","ٱلتَّوْرَىٰةُ ۗ قُلْ فَأْتُوا۟","فَٱتْلُوهَآ إِن كُنتُمْ",558],["5:43:4",115,"ٱلتَّوْرَىٰةُ","the Taurat","وَكَيْفَ يُحَكِّمُونَكَ وَعِندَهُمُ","فِيهَا حُكْمُ ٱللَّهِ",558],["5:44:3",115,"ٱلتَّوْرَىٰةَ","the Taurat","إِنَّآ أَنزَلْنَا","فِيهَا هُدًۭى وَنُورٌۭ ۚ",558],["5:46:12",116,"ٱلتَّوْرَىٰةِ ۖ","the Taurat","بَيْنَ يَدَيْهِ مِنَ","وَءَاتَيْنَـٰهُ ٱلْإِنجِيلَ فِيهِ",558],["5:46:23",116,"ٱلتَّوْرَىٰةِ","the Taurat","بَيْنَ يَدَيْهِ مِنَ","وَهُدًۭى وَمَوْعِظَةًۭ لِّلْمُتَّقِينَ",558],["5:66:4",119,"ٱلتَّوْرَىٰةَ","(by) the Taurat","وَلَوْ أَنَّهُمْ أَقَامُوا۟","وَٱلْإِنجِيلَ وَمَآ أُنزِلَ",558],["5:68:9",119,"ٱلتَّوْرَىٰةَ","(by) the Taurat","شَىْءٍ حَتَّىٰ تُقِيمُوا۟","وَٱلْإِنجِيلَ وَمَآ أُنزِلَ",558],["5:110:25",126,"وَٱلتَّوْرَىٰةَ","and the Taurat","عَلَّمْتُكَ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ","وَٱلْإِنجِيلَ ۖ وَإِذْ تَخْلُقُ",558],["7:157:11",170,"ٱلتَّوْرَىٰةِ","the Taurat","مَكْتُوبًا عِندَهُمْ فِى","وَٱلْإِنجِيلِ يَأْمُرُهُم بِٱلْمَعْرُوفِ",558],["9:111:21",204,"ٱلتَّوْرَىٰةِ","the Taurat","عَلَيْهِ حَقًّۭا فِى","وَٱلْإِنجِيلِ وَٱلْقُرْءَانِ ۚ وَمَنْ",558],["48:29:28",515,"ٱلتَّوْرَىٰةِ ۚ","the Taurah","ذَٰلِكَ مَثَلُهُمْ فِى","وَمَثَلُهُمْ فِى ٱلْإِنجِيلِ",558],["61:6:17",552,"ٱلتَّوْرَىٰةِ","the Taurat","بَيْنَ يَدَىَّ مِنَ","وَمُبَشِّرًۢا بِرَسُولٍۢ يَأْتِى",558],["62:5:4",553,"ٱلتَّوْرَىٰةَ","(with) the Taurat","مَثَلُ ٱلَّذِينَ حُمِّلُوا۟","ثُمَّ لَمْ يَحْمِلُوهَا",558]]