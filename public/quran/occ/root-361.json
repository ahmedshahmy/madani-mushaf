[["1:7:6",1,"ٱلْمَغْضُوبِ","those who earned (Your) wrath","أَنْعَمْتَ عَلَيْهِمْ غَيْرِ","عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ",3663],["2:61:42",9,"بِغَضَبٍۢ","wrath","ٱلذِّلَّةُ وَٱلْمَسْكَنَةُ وَبَآءُو","مِّنَ ٱللَّهِ ۗ ذَٰلِكَ",661],["2:90:22",14,"بِغَضَبٍ","wrath","مِنْ عِبَادِهِۦ ۖ فَبَآءُو","عَلَىٰ غَضَبٍۢ ۚ وَلِلْكَـٰفِرِينَ",661],["2:90:24",14,"غَضَبٍۢ ۚ","wrath","فَبَآءُو بِغَضَبٍ عَلَىٰ","وَلِلْكَـٰفِرِينَ عَذَابٌۭ مُّهِينٌۭ",661],["3:112:15",64,"بِغَضَبٍۢ","wrath","مِّنَ ٱلنَّاسِ وَبَآءُو","مِّنَ ٱللَّهِ وَضُرِبَتْ",661],["4:93:9",93,"وَغَضِبَ","and will fall the wrath","جَهَنَّمُ خَـٰلِدًۭا فِيهَا","ٱللَّهُ عَلَيْهِ وَلَعَنَهُۥ",1181],["5:60:13",118,"وَغَضِبَ","and He became angry","مَن لَّعَنَهُ ٱللَّهُ","عَلَيْهِ وَجَعَلَ مِنْهُمُ",1181],["7:71:8",159,"وَغَضَبٌ ۖ","and anger","مِّن رَّبِّكُمْ رِجْسٌۭ","أَتُجَـٰدِلُونَنِى فِىٓ أَسْمَآءٍۢ",661],["7:150:6",169,"غَضْبَـٰنَ","angry","مُوسَىٰٓ إِلَىٰ قَوْمِهِۦ","أَسِفًۭا قَالَ بِئْسَمَا",2371],["7:152:6",169,"غَضَبٌۭ","wrath","ٱتَّخَذُوا۟ ٱلْعِجْلَ سَيَنَالُهُمْ","مِّن رَّبِّهِمْ وَذِلَّةٌۭ",661],["7:154:5",169,"ٱلْغَضَبُ","the anger","سَكَتَ عَن مُّوسَى","أَخَذَ ٱلْأَلْوَاحَ ۖ وَفِى",661],["8:16:14",178,"بِغَضَبٍۢ","wrath","فِئَةٍۢ فَقَدْ بَآءَ","مِّنَ ٱللَّهِ وَمَأْوَىٰهُ",661],["16:106:19",279,"غَضَبٌۭ","(is) a wrath","بِٱلْكُفْرِ صَدْرًۭا فَعَلَيْهِمْ","مِّنَ ٱللَّهِ وَلَهُمْ",661],["20:81:11",317,"غَضَبِى ۖ","My Anger","فِيهِ فَيَحِلَّ عَلَيْكُمْ","وَمَن يَحْلِلْ عَلَيْهِ",661],["20:81:15",317,"غَضَبِى","My Anger","وَمَن يَحْلِلْ عَلَيْهِ","فَقَدْ هَوَىٰ",661],["20:86:5",317,"غَضْبَـٰنَ","angry","مُوسَىٰٓ إِلَىٰ قَوْمِهِۦ","أَسِفًۭا ۚ قَالَ يَـٰقَوْمِ",2371],["20:86:22",317,"غَضَبٌۭ","(the) Anger","أَن يَحِلَّ عَلَيْكُمْ","مِّن رَّبِّكُمْ فَأَخْلَفْتُم",661],["21:87:5",329,"مُغَـٰضِبًۭا","(while) angry","ٱلنُّونِ إِذ ذَّهَبَ","فَظَنَّ أَن لَّن",3800],["24:9:3",350,"غَضَبَ","the wrath of Allah","وَٱلْخَـٰمِسَةَ أَنَّ","ٱللَّهِ عَلَيْهَآ إِن",661],["42:16:15",485,"غَضَبٌۭ","(is) wrath","عِندَ رَبِّهِمْ وَعَلَيْهِمْ","وَلَهُمْ عَذَابٌۭ شَدِيدٌ",661],["42:37:8",487,"غَضِبُوا۟","they are angry","وَٱلْفَوَٰحِشَ وَإِذَا مَا","هُمْ يَغْفِرُونَ",1181],["48:6:13",511,"وَغَضِبَ","and Allah's wrath (is)","عَلَيْهِمْ دَآئِرَةُ ٱلسَّوْءِ ۖ","ٱللَّهُ عَلَيْهِمْ وَلَعَنَهُمْ",1181],["58:14:7",544,"غَضِبَ","wrath","ٱلَّذِينَ تَوَلَّوْا۟ قَوْمًا","ٱللَّهُ عَلَيْهِم مَّا",1181],["60:13:7",551,"غَضِبَ","(The) wrath","لَا تَتَوَلَّوْا۟ قَوْمًا","ٱللَّهُ عَلَيْهِمْ قَدْ",1181]]