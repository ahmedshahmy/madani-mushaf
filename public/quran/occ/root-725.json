[["18:29:22",297,"كَٱلْمُهْلِ","like molten brass","يَسْتَغِيثُوا۟ يُغَاثُوا۟ بِمَآءٍۢ","يَشْوِى ٱلْوُجُوهَ ۚ بِئْسَ",1908],["44:45:1",498,"كَٱلْمُهْلِ","Like the murky oil","","يَغْلِى فِى ٱلْبُطُونِ",1908],["70:8:4",568,"كَٱلْمُهْلِ","like molten copper","يَوْمَ تَكُونُ ٱلسَّمَآءُ","",1908],["73:11:5",574,"وَمَهِّلْهُمْ","and allow them respite","وَٱلْمُكَذِّبِينَ أُو۟لِى ٱلنَّعْمَةِ","قَلِيلًا",2452],["86:17:1",591,"فَمَهِّلِ","So give respite","","ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا",2452],["86:17:3",591,"أَمْهِلْهُمْ","Give respite to them","فَمَهِّلِ ٱلْكَـٰفِرِينَ","رُوَيْدًۢا",3013]]