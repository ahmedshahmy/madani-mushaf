[["2:173:7",26,"ٱلْخِنزِيرِ","(of) swine","ٱلْمَيْتَةَ وَٱلدَّمَ وَلَحْمَ","وَمَآ أُهِلَّ بِهِۦ",1422],["5:3:6",107,"ٱلْخِنزِيرِ","(of) the swine","ٱلْمَيْتَةُ وَٱلدَّمُ وَلَحْمُ","وَمَآ أُهِلَّ لِغَيْرِ",1422],["5:60:18",118,"وَٱلْخَنَازِيرَ","and [the] swines","وَجَعَلَ مِنْهُمُ ٱلْقِرَدَةَ","وَعَبَدَ ٱلطَّـٰغُوتَ ۚ أُو۟لَـٰٓئِكَ",1422],["6:145:21",147,"خِنزِيرٍۢ","(of) swine","مَّسْفُوحًا أَوْ لَحْمَ","فَإِنَّهُۥ رِجْسٌ أَوْ",1422],["16:115:7",280,"ٱلْخِنزِيرِ","(of) the swine","ٱلْمَيْتَةَ وَٱلدَّمَ وَلَحْمَ","وَمَآ أُهِلَّ لِغَيْرِ",1422]]