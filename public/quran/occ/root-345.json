[["2:187:55",29,"حُدُودُ","(are the) limits","فِى ٱلْمَسَـٰجِدِ ۗ تِلْكَ","ٱللَّهِ فَلَا تَقْرَبُوهَا ۗ",656],["2:229:21",36,"حُدُودَ","(the) limits","يَخَافَآ أَلَّا يُقِيمَا","ٱللَّهِ ۖ فَإِنْ خِفْتُمْ",656],["2:229:27",36,"حُدُودَ","(the) limits","خِفْتُمْ أَلَّا يُقِيمَا","ٱللَّهِ فَلَا جُنَاحَ",656],["2:229:36",36,"حُدُودُ","(are the) limits","ٱفْتَدَتْ بِهِۦ ۗ تِلْكَ","ٱللَّهِ فَلَا تَعْتَدُوهَا ۚ",656],["2:229:42",36,"حُدُودَ","(the) limits","تَعْتَدُوهَا ۚ وَمَن يَتَعَدَّ","ٱللَّهِ فَأُو۟لَـٰٓئِكَ هُمُ",656],["2:230:23",36,"حُدُودَ","(the) limits","ظَنَّآ أَن يُقِيمَا","ٱللَّهِ ۗ وَتِلْكَ حُدُودُ",656],["2:230:26",36,"حُدُودُ","(are the) limits","حُدُودَ ٱللَّهِ ۗ وَتِلْكَ","ٱللَّهِ يُبَيِّنُهَا لِقَوْمٍۢ",656],["4:13:2",79,"حُدُودُ","(are the) limits","تِلْكَ","ٱللَّهِ ۚ وَمَن يُطِعِ",656],["4:14:6",79,"حُدُودَهُۥ","His limits","ٱللَّهَ وَرَسُولَهُۥ وَيَتَعَدَّ","يُدْخِلْهُ نَارًا خَـٰلِدًۭا",656],["9:63:5",197,"يُحَادِدِ","opposes","يَعْلَمُوٓا۟ أَنَّهُۥ مَن","ٱللَّهَ وَرَسُولَهُۥ فَأَنَّ",2266],["9:97:8",202,"حُدُودَ","(the) limits","وَأَجْدَرُ أَلَّا يَعْلَمُوا۟","مَآ أَنزَلَ ٱللَّهُ",656],["9:112:13",205,"لِحُدُودِ","(the) limits","عَنِ ٱلْمُنكَرِ وَٱلْحَـٰفِظُونَ","ٱللَّهِ ۗ وَبَشِّرِ ٱلْمُؤْمِنِينَ",656],["17:50:5",287,"حَدِيدًا","iron","كُونُوا۟ حِجَارَةً أَوْ","",1157],["18:96:3",303,"ٱلْحَدِيدِ ۖ","(of) iron","ءَاتُونِى زُبَرَ","حَتَّىٰٓ إِذَا سَاوَىٰ",1157],["22:21:4",334,"حَدِيدٍۢ","iron","وَلَهُم مَّقَـٰمِعُ مِنْ","",1157],["33:19:21",420,"حِدَادٍ","sharp","ٱلْخَوْفُ سَلَقُوكُم بِأَلْسِنَةٍ","أَشِحَّةً عَلَى ٱلْخَيْرِ ۚ",3208],["34:10:12",429,"ٱلْحَدِيدَ","[the] iron","وَٱلطَّيْرَ ۖ وَأَلَنَّا لَهُ","",1157],["50:22:12",519,"حَدِيدٌۭ","(is) sharp","غِطَآءَكَ فَبَصَرُكَ ٱلْيَوْمَ","",1157],["57:25:13",541,"ٱلْحَدِيدَ","[the] iron","ٱلنَّاسُ بِٱلْقِسْطِ ۖ وَأَنزَلْنَا","فِيهِ بَأْسٌۭ شَدِيدٌۭ",1157],["58:4:22",542,"حُدُودُ","(are the) limits","بِٱللَّهِ وَرَسُولِهِۦ ۚ وَتِلْكَ","ٱللَّهِ ۗ وَلِلْكَـٰفِرِينَ عَذَابٌ",656],["58:5:3",542,"يُحَآدُّونَ","oppose","إِنَّ ٱلَّذِينَ","ٱللَّهَ وَرَسُولَهُۥ كُبِتُوا۟",2798],["58:20:3",544,"يُحَآدُّونَ","oppose","إِنَّ ٱلَّذِينَ","ٱللَّهَ وَرَسُولَهُۥٓ أُو۟لَـٰٓئِكَ",2798],["58:22:10",545,"حَآدَّ","oppose","ٱلْـَٔاخِرِ يُوَآدُّونَ مَنْ","ٱللَّهَ وَرَسُولَهُۥ وَلَوْ",2266],["65:1:25",558,"حُدُودُ","(are the) limits","بِفَـٰحِشَةٍۢ مُّبَيِّنَةٍۢ ۚ وَتِلْكَ","ٱللَّهِ ۚ وَمَن يَتَعَدَّ",656],["65:1:29",558,"حُدُودَ","(the) limits","ٱللَّهِ ۚ وَمَن يَتَعَدَّ","ٱللَّهِ فَقَدْ ظَلَمَ",656]]