[["9:72:16",198,"عَدْنٍۢ ۚ","(of) everlasting bliss","طَيِّبَةًۭ فِى جَنَّـٰتِ","وَرِضْوَٰنٌۭ مِّنَ ٱللَّهِ",768],["13:23:2",252,"عَدْنٍۢ","of Eden","جَنَّـٰتُ","يَدْخُلُونَهَا وَمَن صَلَحَ",768],["16:31:2",270,"عَدْنٍۢ","(of) Eden","جَنَّـٰتُ","يَدْخُلُونَهَا تَجْرِى مِن",768],["18:31:4",297,"عَدْنٍۢ","of Eden","أُو۟لَـٰٓئِكَ لَهُمْ جَنَّـٰتُ","تَجْرِى مِن تَحْتِهِمُ",768],["19:61:2",309,"عَدْنٍ","(of) Eden","جَنَّـٰتِ","ٱلَّتِى وَعَدَ ٱلرَّحْمَـٰنُ",768],["20:76:2",316,"عَدْنٍۢ","(of) Eden","جَنَّـٰتُ","تَجْرِى مِن تَحْتِهَا",768],["35:33:2",438,"عَدْنٍۢ","(of) Eternity","جَنَّـٰتُ","يَدْخُلُونَهَا يُحَلَّوْنَ فِيهَا",768],["38:50:2",456,"عَدْنٍۢ","(of) Eternity","جَنَّـٰتِ","مُّفَتَّحَةًۭ لَّهُمُ ٱلْأَبْوَٰبُ",768],["40:8:4",468,"عَدْنٍ","(of) Eden","رَبَّنَا وَأَدْخِلْهُمْ جَنَّـٰتِ","ٱلَّتِى وَعَدتَّهُمْ وَمَن",768],["61:12:14",552,"عَدْنٍۢ ۚ","(of) Eternity","طَيِّبَةًۭ فِى جَنَّـٰتِ","ذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ",768],["98:8:5",599,"عَدْنٍۢ","(of) Eternity","عِندَ رَبِّهِمْ جَنَّـٰتُ","تَجْرِى مِن تَحْتِهَا",768]]