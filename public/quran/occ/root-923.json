[["6:100:6",140,"وَخَرَقُوا۟","and they falsely attribute","شُرَكَآءَ ٱلْجِنَّ وَخَلَقَهُمْ ۖ","لَهُۥ بَنِينَ وَبَنَـٰتٍۭ",1665],["17:37:8",285,"تَخْرِقَ","tear","مَرَحًا ۖ إِنَّكَ لَن","ٱلْأَرْضَ وَلَن تَبْلُغَ",1665],["18:71:7",301,"خَرَقَهَا ۖ","he made a hole in it","رَكِبَا فِى ٱلسَّفِينَةِ","قَالَ أَخَرَقْتَهَا لِتُغْرِقَ",1665],["18:71:9",301,"أَخَرَقْتَهَا","Have you made a hole in it","ٱلسَّفِينَةِ خَرَقَهَا ۖ قَالَ","لِتُغْرِقَ أَهْلَهَا لَقَدْ",1665]]