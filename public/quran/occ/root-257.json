[["2:76:13",11,"أَتُحَدِّثُونَهُم","Do you tell them","إِلَىٰ بَعْضٍۢ قَالُوٓا۟","بِمَا فَتَحَ ٱللَّهُ",2016],["4:42:14",85,"حَدِيثًۭا","(any) statement","وَلَا يَكْتُمُونَ ٱللَّهَ","",385],["4:78:36",90,"حَدِيثًۭا","any statement","لَا يَكَادُونَ يَفْقَهُونَ","",385],["4:87:17",92,"حَدِيثًۭا","(in) statement","أَصْدَقُ مِنَ ٱللَّهِ","",385],["4:140:21",100,"حَدِيثٍ","a conversation","حَتَّىٰ يَخُوضُوا۟ فِى","غَيْرِهِۦٓ ۚ إِنَّكُمْ إِذًۭا",385],["6:68:12",135,"حَدِيثٍ","a talk","حَتَّىٰ يَخُوضُوا۟ فِى","غَيْرِهِۦ ۚ وَإِمَّا يُنسِيَنَّكَ",385],["7:185:20",174,"حَدِيثٍۭ","statement","ٱقْتَرَبَ أَجَلُهُمْ ۖ فَبِأَىِّ","بَعْدَهُۥ يُؤْمِنُونَ",385],["12:6:7",236,"ٱلْأَحَادِيثِ","(of) the narratives","وَيُعَلِّمُكَ مِن تَأْوِيلِ","وَيُتِمُّ نِعْمَتَهُۥ عَلَيْكَ",385],["12:21:23",237,"ٱلْأَحَادِيثِ ۚ","the events","وَلِنُعَلِّمَهُۥ مِن تَأْوِيلِ","وَٱللَّهُ غَالِبٌ عَلَىٰٓ",385],["12:101:9",247,"ٱلْأَحَادِيثِ ۚ","of the events","وَعَلَّمْتَنِى مِن تَأْوِيلِ","فَاطِرَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ",385],["12:111:10",248,"حَدِيثًۭا","a narration","ٱلْأَلْبَـٰبِ ۗ مَا كَانَ","يُفْتَرَىٰ وَلَـٰكِن تَصْدِيقَ",385],["18:6:10",294,"ٱلْحَدِيثِ","[the] narration","لَّمْ يُؤْمِنُوا۟ بِهَـٰذَا","أَسَفًا",385],["18:70:9",301,"أُحْدِثَ","I present","عَن شَىْءٍ حَتَّىٰٓ","لَكَ مِنْهُ ذِكْرًۭا",2076],["20:9:3",312,"حَدِيثُ","the narration","وَهَلْ أَتَىٰكَ","مُوسَىٰٓ",385],["20:113:12",319,"يُحْدِثُ","it may cause","لَعَلَّهُمْ يَتَّقُونَ أَوْ","لَهُمْ ذِكْرًۭا",2076],["21:2:7",322,"مُّحْدَثٍ","anew","ذِكْرٍۢ مِّن رَّبِّهِم","إِلَّا ٱسْتَمَعُوهُ وَهُمْ",2483],["23:44:15",345,"أَحَادِيثَ ۚ","narrations","بَعْضَهُم بَعْضًۭا وَجَعَلْنَـٰهُمْ","فَبُعْدًۭا لِّقَوْمٍۢ لَّا",385],["26:5:7",367,"مُحْدَثٍ","new","ذِكْرٍۢ مِّنَ ٱلرَّحْمَـٰنِ","إِلَّا كَانُوا۟ عَنْهُ",2483],["31:6:6",411,"ٱلْحَدِيثِ","idle tales","مَن يَشْتَرِى لَهْوَ","لِيُضِلَّ عَن سَبِيلِ",385],["33:53:26",425,"لِحَدِيثٍ ۚ","for a conversation","فَٱنتَشِرُوا۟ وَلَا مُسْتَـْٔنِسِينَ","إِنَّ ذَٰلِكُمْ كَانَ",385],["34:19:9",430,"أَحَ