[["25:53:3",364,"مَرَجَ","(has) released","۞ وَهُوَ ٱلَّذِى","ٱلْبَحْرَيْنِ هَـٰذَا عَذْبٌۭ",2459],["50:5:9",518,"مَّرِيجٍ","confused","فَهُمْ فِىٓ أَمْرٍۢ","",3926],["55:15:4",531,"مَّارِجٍۢ","a smokeless flame","وَخَلَقَ ٱلْجَآنَّ مِن","مِّن نَّارٍۢ",3907],["55:19:1",532,"مَرَجَ","He released","","ٱلْبَحْرَيْنِ يَلْتَقِيَانِ",2459],["55:22:4",532,"وَٱلْمَرْجَانُ","and the coral","يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ","",2463],["55:58:3",533,"وَٱلْمَرْجَانُ","and coral","كَأَنَّهُنَّ ٱلْيَاقُوتُ","",2463]]