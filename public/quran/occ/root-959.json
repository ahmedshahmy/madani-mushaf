[["2:62:7",10,"وَٱلصَّـٰبِـِٔينَ","and the Sabians","وَٱلَّذِينَ هَادُوا۟ وَٱلنَّصَـٰرَىٰ","مَنْ ءَامَنَ بِٱللَّهِ",1796],["5:69:6",119,"وَٱلصَّـٰبِـُٔونَ","and the Sabians","ءَامَنُوا۟ وَٱلَّذِينَ هَادُوا۟","وَٱلنَّصَـٰرَىٰ مَنْ ءَامَنَ",1796],["22:17:6",334,"وَٱلصَّـٰبِـِٔينَ","and the Sabians","ءَامَنُوا۟ وَٱلَّذِينَ هَادُوا۟","وَٱلنَّصَـٰرَىٰ وَٱلْمَجُوسَ وَٱلَّذِينَ",1796]]