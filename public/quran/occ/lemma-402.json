[["6:86:4",138,"وَلُوطًۭا ۚ","and Lut","وَإِسْمَـٰعِيلَ وَٱلْيَسَعَ وَيُونُسَ","وَكُلًّۭا فَضَّلْنَا عَلَى",402],["7:80:1",160,"وَلُوطًا","And Lut","","إِذْ قَالَ لِقَوْمِهِۦٓ",402],["11:70:18",229,"لُوطٍۢ","(of) Lut","أُرْسِلْنَآ إِلَىٰ قَوْمِ","",402],["11:74:11",230,"لُوطٍ","of Lut","يُجَـٰدِلُنَا فِى قَوْمِ","",402],["11:77:4",230,"لُوطًۭا","(to) Lut","وَلَمَّا جَآءَتْ رُسُلُنَا","سِىٓءَ بِهِمْ وَضَاقَ",402],["11:81:2",230,"يَـٰلُوطُ","O Lut","قَالُوا۟","إِنَّا رُسُلُ رَبِّكَ",402],["11:89:20",232,"لُوطٍۢ","(are the) people of Lut","صَـٰلِحٍۢ ۚ وَمَا قَوْمُ","مِّنكُم بِبَعِيدٍۢ",402],["15:59:3",265,"لُوطٍ","of Lut","إِلَّآ ءَالَ","إِنَّا لَمُنَجُّوهُمْ أَجْمَعِينَ",402],["15:61:4",265,"لُوطٍ","(of) Lut","فَلَمَّا جَآءَ ءَالَ","ٱلْمُرْسَلُونَ",402],["21:71:2",327,"وَلُوطًا","and Lut","وَنَجَّيْنَـٰهُ","إِلَى ٱلْأَرْضِ ٱلَّتِى",402],["21:74:1",328,"وَلُوطًا","And (to) Lut","","ءَاتَيْنَـٰهُ حُكْمًۭا وَعِلْمًۭا",402],["22:43:4",337,"لُوطٍۢ","(of) Lut","وَقَوْمُ إِبْرَٰهِيمَ وَقَوْمُ","",402],["26:160:3",374,"لُوطٍ","(of) Lut","كَذَّبَتْ قَوْمُ","ٱلْمُرْسَلِينَ",402],["26:161:5",374,"لُوطٌ","Lut","قَالَ لَهُمْ أَخُوهُمْ","أَلَا تَتَّقُونَ",402],["26:167:5",374,"يَـٰلُوطُ","O Lut","لَئِن لَّمْ تَنتَهِ","لَتَكُونَنَّ مِنَ ٱلْمُخْرَجِينَ",402],["27:54:1",381,"وَلُوطًا","And Lut","","إِذْ قَالَ لِقَوْمِهِۦٓ",402],["27:56:10",382,"لُوطٍۢ","(of) Lut","قَالُوٓا۟ أَخْرِجُوٓا۟ ءَالَ","مِّن قَرْيَتِكُمْ ۖ إِنَّهُمْ",402],["29:26:3",399,"لُوطٌۭ ۘ","Lut","۞ فَـَٔامَنَ لَهُۥ","وَقَالَ إِنِّى مُهَاجِرٌ",402],["29:28:1",399,"وَلُوطًا","And Lut","","إِذْ قَالَ لِقَوْمِهِۦٓ",402],["29:32:4",400,"لُوطًۭا ۚ","(is) Lut","قَالَ إِنَّ فِيهَا","قَالُوا۟ نَحْنُ أَعْلَمُ",402],["29:33:5",400,"لُوطًۭا","(to) Lut","أَن جَآءَتْ رُسُلُنَا","سِىٓءَ بِهِمْ وَضَاقَ",402],["37:133:2",451,"لُوطًۭا","Lut","وَإِنَّ","لَّمِنَ ٱلْمُرْسَلِينَ",402],["38:13:3",453,"لُوطٍۢ","(of) Lut","وَثَمُودُ وَقَوْمُ","وَأَصْحَـٰبُ لْـَٔيْكَةِ ۚ أُو۟لَـٰٓئِكَ",402],["50:13:4",518,"لُوطٍۢ","(of) Lut","وَعَادٌۭ وَفِرْعَوْنُ وَإِخْوَٰنُ","",402],["54:33:3",530,"لُوطٍۭ","(of) Lut","كَذَّبَتْ قَوْمُ","بِٱلنُّذُرِ",402],["54:34:7",530,"لُوطٍۢ ۖ","(of) Lut","حَاصِبًا إِلَّآ ءَالَ","نَّجَّيْنَـٰهُم بِسَحَرٍۢ",402],["66:10:9",561,"لُوطٍۢ ۖ","(of) Lut","ٱمْرَأَتَ نُوحٍۢ وَٱمْرَأَتَ","كَانَتَا تَحْتَ عَبْدَيْنِ",402]]