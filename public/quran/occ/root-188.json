[["2:58:5",9,"ٱلْقَرْيَةَ","town","قُلْنَا ٱدْخُلُوا۟ هَـٰذِهِ","فَكُلُوا۟ مِنْهَا حَيْثُ",211],["2:259:5",43,"قَرْيَةٍۢ","a township","كَٱلَّذِى مَرَّ عَلَىٰ","وَهِىَ خَاوِيَةٌ عَلَىٰ",211],["4:75:19",90,"ٱلْقَرْيَةِ","[the] town","أَخْرِجْنَا مِنْ هَـٰذِهِ","ٱلظَّالِمِ أَهْلُهَا وَٱجْعَل",211],["6:92:11",139,"ٱلْقُرَىٰ","(of) the cities","يَدَيْهِ وَلِتُنذِرَ أُمَّ","وَمَنْ حَوْلَهَا ۚ وَٱلَّذِينَ",211],["6:123:5",143,"قَرْيَةٍ","city","جَعَلْنَا فِى كُلِّ","أَكَـٰبِرَ مُجْرِمِيهَا لِيَمْكُرُوا۟",211],["6:131:7",145,"ٱلْقُرَىٰ","the cities","يَكُن رَّبُّكَ مُهْلِكَ","بِظُلْمٍۢ وَأَهْلُهَا غَـٰفِلُونَ",211],["7:4:3",151,"قَرْيَةٍ","a city","وَكَم مِّن","أَهْلَكْنَـٰهَا فَجَآءَهَا بَأْسُنَا",211],["7:82:10",161,"قَرْيَتِكُمْ ۖ","your town","قَالُوٓا۟ أَخْرِجُوهُم مِّن","إِنَّهُمْ أُنَاسٌۭ يَتَطَهَّرُونَ",211],["7:88:13",162,"قَرْيَتِنَآ","our city","ءَامَنُوا۟ مَعَكَ مِن","أَوْ لَتَعُودُنَّ فِى",211],["7:94:4",162,"قَرْيَةٍۢ","a city","وَمَآ أَرْسَلْنَا فِى","مِّن نَّبِىٍّ إِلَّآ",211],["7:96:4",163,"ٱلْقُرَىٰٓ","(of) the cities","وَلَوْ أَنَّ أَهْلَ","ءَامَنُوا۟ وَٱتَّقَوْا۟ لَفَتَحْنَا",211],["7:97:3",163,"ٱلْقُرَىٰٓ","(of) the cities","أَفَأَمِنَ أَهْلُ","أَن يَأْتِيَهُم بَأْسُنَا",211],["7:98:3",163,"ٱلْقُرَىٰٓ","(of) the cities","أَوَأَمِنَ أَهْلُ","أَن يَأْتِيَهُم بَأْسُنَا",211],["7:101:2",163,"ٱلْقُرَىٰ","(were) the cities","تِلْكَ","نَقُصُّ عَلَيْكَ مِنْ",211],["7:161:6",171,"ٱلْقَرْيَةَ","city","لَهُمُ ٱسْكُنُوا۟ هَـٰذِهِ","وَكُلُوا۟ مِنْهَا حَيْثُ",211],["7:163:3",171,"ٱلْقَرْيَةِ","the town","وَسْـَٔلْهُمْ عَنِ","ٱلَّتِى كَانَتْ حَاضِرَةَ",211],["10:98:3",220,"قَرْيَةٌ","any town","فَلَوْلَا كَانَتْ","ءَامَنَتْ فَنَفَعَهَآ إِيمَـٰنُهَآ",211],["11:100:4",233,"ٱلْقُرَىٰ","(of) the cities","ذَٰلِكَ مِنْ أَنۢبَآءِ","نَقُصُّهُۥ عَلَيْكَ ۖ مِنْهَا",211],["11:102:6",233,"ٱلْقُرَىٰ","the cities","رَبِّكَ إِذَآ أَخَذَ","وَهِىَ ظَـٰلِمَةٌ ۚ إِنَّ",211],["11:117:5",234,"ٱلْقُرَىٰ","the cities","كَانَ رَبُّكَ لِيُهْلِكَ","بِظُلْمٍۢ وَأَهْلُهَا مُصْلِحُونَ",211],["12:82:2",245,"ٱلْقَرْيَةَ","the town","وَسْـَٔلِ","ٱلَّتِى كُنَّا فِيهَا",211],["12:109:11",248,"ٱلْقُرَىٰٓ ۗ","(of) the townships","إِلَيْهِم مِّنْ أَهْلِ","أَفَلَمْ يَسِيرُوا۟ فِى",211],["15:4:4",262,"قَرْيَةٍ","town","وَمَآ أَهْلَكْنَا مِن","إِلَّا وَلَهَا كِتَابٌۭ",211],["16:112:4",280,"قَرْيَةًۭ","(of) a town","وَضَرَبَ ٱللَّهُ مَثَلًۭا","كَانَتْ ءَامِنَةًۭ مُّطْمَئِنَّةًۭ",211],["17:16:5",283,"قَرْيَةً","a town","أَرَدْنَآ أَن نُّهْلِكَ","أَمَرْنَا مُتْرَفِيهَا فَفَسَقُوا۟",211],["17:58:3",287,"قَرْيَةٍ","town","وَإِن مِّن","إِلَّا نَحْنُ مُهْلِكُوهَا",211],["18:59:2",300,"ٱلْقُرَىٰٓ","[the] towns","وَتِلْكَ","أَهْلَكْنَـٰهُمْ لَمَّا ظَلَمُوا۟",211],["18:77:6",302,"قَرْيَةٍ","(of) a town","إِذَآ أَتَيَآ أَهْلَ","ٱسْتَطْعَمَآ أَهْلَهَا فَأَبَوْا۟",211],["21:6:5",322,"قَرْيَةٍ","town","ءَامَنَتْ قَبْلَهُم مِّن","أَهْلَكْنَـٰهَآ ۖ أَفَهُمْ يُؤْمِنُونَ",211],["21:11:4",323,"قَرْيَةٍۢ","a town","وَكَمْ قَصَمْنَا مِن","كَانَتْ ظَالِمَةًۭ وَأَنشَأْنَا",211],["21:74:7",328,"ٱلْقَرْيَةِ","the town","وَعِلْمًۭا وَنَجَّيْنَـٰهُ مِنَ","ٱلَّتِى كَانَت تَّعْمَلُ",211],["21:95:3",330,"قَرْيَةٍ","a city","وَحَرَٰمٌ عَلَىٰ","أَهْلَكْنَـٰهَآ أَنَّهُمْ لَا",211],["22:45:3",337,"قَرْيَةٍ","a township","فَكَأَيِّن مِّن","أَهْلَكْنَـٰهَا وَهِىَ ظَالِمَةٌۭ",211],["22:48:3",338,"قَرْيَةٍ","a township","وَكَأَيِّن مِّن","أَمْلَيْتُ لَهَا وَهِىَ",211],["25:40:4",363,"ٱلْقَرْيَةِ","the town","وَلَقَدْ أَتَوْا۟ عَلَى","ٱلَّتِىٓ أُمْطِرَتْ مَطَرَ",211],["25:51:6",364,"قَرْيَةٍۢ","town","لَبَعَثْنَا فِى كُلِّ","نَّذِيرًۭا",211],["26:208:4",376,"قَرْيَةٍ","town","وَمَآ أَهْلَكْنَا مِن","إِلَّا لَهَا مُنذِرُونَ",211],["27:34:6",379,"قَرْيَةً","a town","ٱلْمُلُوكَ إِذَا دَخَلُوا۟","أَفْسَدُوهَا وَجَعَلُوٓا۟ أَعِزَّةَ",211],["27:56:12",382,"قَرْيَتِكُمْ ۖ","your town","ءَالَ لُوطٍۢ مِّن","إِنَّهُمْ أُنَاسٌۭ يَتَطَهَّرُونَ",211],["28:58:4",392,"قَرْيَةٍۭ","a town","وَكَمْ أَهْلَكْنَا مِن","بَطِرَتْ مَعِيشَتَهَا ۖ فَتِلْكَ",211],["28:59:5",392,"ٱلْقُرَىٰ","the towns","كَانَ رَبُّكَ مُهْلِكَ","حَتَّىٰ يَبْعَثَ فِىٓ",211],["28:59:17",392,"ٱلْقُرَىٰٓ","the towns","وَمَا كُنَّا مُهْلِكِى","إِلَّا وَأَهْلُهَا ظَـٰلِمُونَ",211],["29:31:11",400,"ٱلْقَرْيَةِ ۖ","town","مُهْلِكُوٓا۟ أَهْلِ هَـٰذِهِ","إِنَّ أَهْلَهَا كَانُوا۟",211],["29:34:6",400,"ٱلْقَرْيَةِ","town","عَلَىٰٓ أَهْلِ هَـٰذِهِ","رِجْزًۭا مِّنَ ٱلسَّمَآءِ",211],["34:18:4",430,"ٱلْقُرَى","the towns","وَجَعَلْنَا بَيْنَهُمْ وَبَيْنَ","ٱلَّتِى بَـٰرَكْنَا فِيهَا",211],["34:18:8",430,"قُرًۭى","towns","ٱلَّتِى بَـٰرَكْنَا فِيهَا","ظَـٰهِرَةًۭ وَقَدَّرْنَا فِيهَا",211],["34:34:4",432,"قَرْيَةٍۢ","a town","وَمَآ أَرْسَلْنَا فِى","مِّن نَّذِيرٍ إِلَّا",211],["36:13:5",441,"ٱلْقَرْيَةِ","(of) the city","لَهُم مَّثَلًا أَصْحَـٰبَ","إِذْ جَآءَهَا ٱلْمُرْسَلُونَ",211],["42:7:8",483,"ٱلْقُرَىٰ","(of) the towns","عَرَبِيًّۭا لِّتُنذِرَ أُمَّ","وَمَنْ حَوْلَهَا وَتُنذِرَ",211],["43:23:7",491,"قَرْيَةٍۢ","a town","مِن قَبْلِكَ فِى","مِّن نَّذِيرٍ إِلَّا",211],["43:31:9",491,"ٱلْقَرْيَتَيْنِ","the two towns","عَلَىٰ رَجُلٍۢ مِّنَ","عَظِيمٍ",211],["46:27:6",505,"ٱلْقُرَىٰ","the towns","مَا حَوْلَكُم مِّنَ","وَصَرَّفْنَا ٱلْـَٔايَـٰتِ لَعَلَّهُمْ",211],["47:13:3",508,"قَرْيَةٍ","a town","وَكَأَيِّن مِّن","هِىَ أَشَدُّ قُوَّةًۭ",211],["47:13:8",508,"قَرْيَتِكَ","your town","أَشَدُّ قُوَّةًۭ مِّن","ٱلَّتِىٓ أَخْرَجَتْكَ أَهْلَكْنَـٰهُمْ",211],["59:7:8",546,"ٱلْقُرَىٰ","(of) the towns","رَسُولِهِۦ مِنْ أَهْلِ","فَلِلَّهِ وَلِلرَّسُولِ وَلِذِى",211],["59:14:6",547,"قُرًۭى","towns","جَمِيعًا إِلَّا فِى","مُّحَصَّنَةٍ أَوْ مِن",211],["65:8:3",559,"قَرْيَةٍ","a town","وَكَأَيِّن مِّن","عَتَتْ عَنْ أَمْرِ",211]]