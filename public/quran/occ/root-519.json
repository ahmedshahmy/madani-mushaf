[["2:68:17",10,"بِكْرٌ","young","لَّا فَارِضٌۭ وَلَا","عَوَانٌۢ بَيْنَ ذَٰلِكَ ۖ",1817],["3:41:20",55,"وَٱلْإِبْكَـٰرِ","and (in) the morning","كَثِيرًۭا وَسَبِّحْ بِٱلْعَشِىِّ","",2137],["19:11:10",305,"بُكْرَةًۭ","(in) the morning","إِلَيْهِمْ أَن سَبِّحُوا۟","وَعَشِيًّۭا",1065],["19:62:10",309,"بُكْرَةًۭ","morning","وَلَهُمْ رِزْقُهُمْ فِيهَا","وَعَشِيًّۭا",1065],["25:5:8",360,"بُكْرَةًۭ","morning","فَهِىَ تُمْلَىٰ عَلَيْهِ","وَأَصِيلًۭا",1065],["33:42:2",423,"بُكْرَةًۭ","morning","وَسَبِّحُوهُ","وَأَصِيلًا",1065],["40:55:12",473,"وَٱلْإِبْكَـٰرِ","and the morning","بِحَمْدِ رَبِّكَ بِٱلْعَشِىِّ","",2137],["48:9:7",511,"بُكْرَةًۭ","morning","وَتُعَزِّرُوهُ وَتُوَقِّرُوهُ وَتُسَبِّحُوهُ","وَأَصِيلًا",1065],["54:38:3",530,"بُكْرَةً","early","وَلَقَدْ صَبَّحَهُم","عَذَابٌۭ مُّسْتَقِرٌّۭ",1065],["56:36:2",535,"أَبْكَارًا","virgins","فَجَعَلْنَـٰهُنَّ","",1817],["66:5:17",560,"وَأَبْكَارًۭا","and virgins","عَـٰبِدَٰتٍۢ سَـٰٓئِحَـٰتٍۢ ثَيِّبَـٰتٍۢ","",1817],["76:25:4",579,"بُكْرَةًۭ","morning","وَٱذْكُرِ ٱسْمَ رَبِّكَ","وَأَصِيلًۭا",1065]]