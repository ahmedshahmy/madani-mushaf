[["7:21:5",152,"ٱلنَّـٰصِحِينَ","the sincere advisors","إِنِّى لَكُمَا لَمِنَ","",1212],["7:62:4",158,"وَأَنصَحُ","and [I] advise","أُبَلِّغُكُمْ رِسَـٰلَـٰتِ رَبِّى","لَكُمْ وَأَعْلَمُ مِنَ",1375],["7:68:6",159,"نَاصِحٌ","an adviser","رَبِّى وَأَنَا۠ لَكُمْ","أَمِينٌ",1212],["7:79:9",160,"وَنَصَحْتُ","and [I] advised","أَبْلَغْتُكُمْ رِسَالَةَ رَبِّى","لَكُمْ وَلَـٰكِن لَّا",1375],["7:79:14",160,"ٱلنَّـٰصِحِينَ","the advisers","وَلَـٰكِن لَّا تُحِبُّونَ","",1212],["7:93:9",162,"وَنَصَحْتُ","and advised","أَبْلَغْتُكُمْ رِسَـٰلَـٰتِ رَبِّى","لَكُمْ ۖ فَكَيْفَ ءَاسَىٰ",1375],["9:91:16",201,"نَصَحُوا۟","they (are) sincere","يُنفِقُونَ حَرَجٌ إِذَا","لِلَّهِ وَرَسُولِهِۦ ۚ مَا",1375],["11:34:3",225,"نُصْحِىٓ","my advice","وَلَا يَنفَعُكُمْ","إِنْ أَرَدتُّ أَنْ",4061],["11:34:7",225,"أَنصَحَ","[I] advise","إِنْ أَرَدتُّ أَنْ","لَكُمْ إِن كَانَ",1375],["12:11:11",236,"لَنَـٰصِحُونَ","surely well-wishers","يُوسُفَ وَإِنَّا لَهُۥ","",1212],["28:12:16",386,"نَـٰصِحُونَ","(will be) sincere","لَكُمْ وَهُمْ لَهُۥ","",1212],["28:20:18",387,"ٱلنَّـٰصِحِينَ","the sincere advisors","إِنِّى لَكَ مِنَ","",1212],["66:8:8",561,"نَّصُوحًا","sincere","إِلَى ٱللَّهِ تَوْبَةًۭ","عَسَىٰ رَبُّكُمْ أَن",4081]]