[["2:259:25",43,"لَبِثْتَ ۖ","(have) you remained","بَعَثَهُۥ ۖ قَالَ كَمْ","قَالَ لَبِثْتُ يَوْمًا",364],["2:259:27",43,"لَبِثْتُ","I remained","كَمْ لَبِثْتَ ۖ قَالَ","يَوْمًا أَوْ بَعْضَ",364],["2:259:34",43,"لَّبِثْتَ","you (have) remained","يَوْمٍۢ ۖ قَالَ بَل","مِا۟ئَةَ عَامٍۢ فَٱنظُرْ",364],["10:16:12",210,"لَبِثْتُ","I have stayed","أَدْرَىٰكُم بِهِۦ ۖ فَقَدْ","فِيكُمْ عُمُرًۭا مِّن",364],["10:45:5",214,"يَلْبَثُوٓا۟","they had not remained","يَحْشُرُهُمْ كَأَن لَّمْ","إِلَّا سَاعَةًۭ مِّنَ",364],["11:69:11",229,"لَبِثَ","and not he delayed","قَالَ سَلَـٰمٌۭ ۖ فَمَا","أَن جَآءَ بِعِجْلٍ",364],["12:42:14",240,"فَلَبِثَ","so he remained","ٱلشَّيْطَـٰنُ ذِكْرَ رَبِّهِۦ","فِى ٱلسِّجْنِ بِضْعَ",364],["17:52:7",287,"لَّبِثْتُمْ","you had remained","بِحَمْدِهِۦ وَتَظُنُّونَ إِن","إِلَّا قَلِيلًۭا",364],["17:76:10",290,"يَلْبَثُونَ","they (would) have stayed","مِنْهَا ۖ وَإِذًۭا لَّا","خِلَـٰفَكَ إِلَّا قَلِيلًۭا",364],["18:12:8",294,"لَبِثُوٓا۟","(they had) remained","ٱلْحِزْبَيْنِ أَحْصَىٰ لِمَا","أَمَدًۭا",364],["18:19:9",295,"لَبِثْتُمْ ۖ","have you remained","قَآئِلٌۭ مِّنْهُمْ كَمْ","قَالُوا۟ لَبِثْنَا يَوْمًا",364],["18:19:11",295,"لَبِثْنَا","We have remained","كَمْ لَبِثْتُمْ ۖ قَالُوا۟","يَوْمًا أَوْ بَعْضَ",364],["18:19:20",295,"لَبِثْتُمْ","you have remained","رَبُّكُمْ أَعْلَمُ بِمَا","فَٱبْعَثُوٓا۟ أَحَدَكُم بِوَرِقِكُمْ",364],["18:25:1",296,"وَلَبِثُوا۟","And they remained","","فِى كَهْفِهِمْ ثَلَـٰثَ",364],["18:26:5",296,"لَبِثُوا۟ ۖ","they remained","ٱللَّهُ أَعْلَمُ بِمَا","لَهُۥ غَيْبُ ٱلسَّمَـٰوَٰتِ",364],["20:40:25",314,"فَلَبِثْتَ","Then you remained","ٱلْغَمِّ وَفَتَنَّـٰكَ فُتُونًۭا ۚ","سِنِينَ فِىٓ أَهْلِ",364],["20:103:4",319,"لَّبِثْتُمْ","you remained","يَتَخَـٰفَتُونَ بَيْنَهُمْ إِن","إِلَّا عَشْرًۭا",364],["20:104:10",319,"لَّبِثْتُمْ","you remained","أَمْثَلُهُمْ طَرِيقَةً إِن","إِلَّا يَوْمًۭا",364],["23:112:3",349,"لَبِثْتُمْ","did you remain","قَـٰلَ كَمْ","فِى ٱلْأَرْضِ عَدَدَ",364],["23:113:2",349,"لَبِثْنَا","We remained","قَالُوا۟","يَوْمًا أَوْ بَعْضَ",364],["23:114:3",349,"لَّبِثْتُمْ","you stayed","قَـٰلَ إِن","إِلَّا قَلِيلًۭا ۖ لَّوْ",364],["26:18:6",367,"وَلَبِثْتَ","and you remained","نُرَبِّكَ فِينَا وَلِيدًۭا","فِينَا مِنْ عُمُرِكَ",364],["29:14:6",397,"فَلَبِثَ","and he remained","نُوحًا إِلَىٰ قَوْمِهِۦ","فِيهِمْ أَلْفَ سَنَةٍ",364],["30:55:7",410,"لَبِثُوا۟","they remained","يُقْسِمُ ٱلْمُجْرِمُونَ مَا","غَيْرَ سَاعَةٍۢ ۚ كَذَٰلِكَ",364],["30:56:7",410,"لَبِثْتُمْ","you remained","ٱلْعِلْمَ وَٱلْإِيمَـٰنَ لَقَدْ","فِى كِتَـٰبِ ٱللَّهِ",364],["33:14:11",419,"تَلَبَّثُوا۟","they (would) have hesitated","ٱلْفِتْنَةَ لَـَٔاتَوْهَا وَمَا","بِهَآ إِلَّا يَسِيرًۭا",364],["34:14:24",429,"لَبِثُوا۟","they (would have) remained","يَعْلَمُونَ ٱلْغَيْبَ مَا","فِى ٱلْعَذَابِ ٱلْمُهِينِ",364],["37:144:1",451,"لَلَبِثَ","Certainly, he (would have) remained","","فِى بَطْنِهِۦٓ إِلَىٰ",364],["46:35:17",506,"يَلْبَثُوٓا۟","remained","مَا يُوعَدُونَ لَمْ","إِلَّا سَاعَةًۭ مِّن",364],["78:23:1",582,"لَّـٰبِثِينَ","(They will) be remaining","","فِيهَآ أَحْقَابًۭا",3611],["79:46:5",584,"يَلْبَثُوٓا۟","they had remained","يَوْمَ يَرَوْنَهَا لَمْ","إِلَّا عَشِيَّةً أَوْ",364]]