[["3:78:5",60,"أَلْسِنَتَهُم","their tongues","مِنْهُمْ لَفَرِيقًۭا يَلْوُۥنَ","بِٱلْكِتَـٰبِ لِتَحْسَبُوهُ مِنَ",428],["4:46:16",86,"بِأَلْسِنَتِهِمْ","[with] their tongues","مُسْمَعٍۢ وَرَٰعِنَا لَيًّۢا","وَطَعْنًۭا فِى ٱلدِّينِ ۚ",428],["5:78:8",121,"لِسَانِ","(the) tongue","بَنِىٓ إِسْرَٰٓءِيلَ عَلَىٰ","دَاوُۥدَ وَعِيسَى ٱبْنِ",428],["14:4:6",255,"بِلِسَانِ","with the language","مِن رَّسُولٍ إِلَّا","قَوْمِهِۦ لِيُبَيِّنَ لَهُمْ ۖ",428],["16:62:6",273,"أَلْسِنَتُهُمُ","their tongues","مَا يَكْرَهُونَ وَتَصِفُ","ٱلْكَذِبَ أَنَّ لَهُمُ",428],["16:103:8",279,"لِّسَانُ","(The) tongue","إِنَّمَا يُعَلِّمُهُۥ بَشَرٌۭ ۗ","ٱلَّذِى يُلْحِدُونَ إِلَيْهِ",428],["16:103:14",279,"لِسَانٌ","(is) a language","إِلَيْهِ أَعْجَمِىٌّۭ وَهَـٰذَا","عَرَبِىٌّۭ مُّبِينٌ",428],["16:116:5",280,"أَلْسِنَتُكُمُ","your tongues","تَقُولُوا۟ لِمَا تَصِفُ","ٱلْكَذِبَ هَـٰذَا حَلَـٰلٌۭ",428],["19:50:7",308,"لِسَانَ","a truthful mention","رَّحْمَتِنَا وَجَعَلْنَا لَهُمْ","صِدْقٍ عَلِيًّۭا",428],["19:97:3",312,"بِلِسَانِكَ","in your tongue","فَإِنَّمَا يَسَّرْنَـٰهُ","لِتُبَشِّرَ بِهِ ٱلْمُتَّقِينَ",428],["20:27:4",313,"لِّسَانِى","my tongue","وَٱحْلُلْ عُقْدَةًۭ مِّن","",428],["24:15:3",351,"بِأَلْسِنَتِكُمْ","with your tongues","إِذْ تَلَقَّوْنَهُۥ","وَتَقُولُونَ بِأَفْوَاهِكُم مَّا",428],["24:24:4",352,"أَلْسِنَتُهُمْ","their tongues","يَوْمَ تَشْهَدُ عَلَيْهِمْ","وَأَيْدِيهِمْ وَأَرْجُلُهُم بِمَا",428],["26:13:5",367,"لِسَانِى","my tongue","صَدْرِى وَلَا يَنطَلِقُ","فَأَرْسِلْ إِلَىٰ هَـٰرُونَ",428],["26:84:3",371,"لِسَانَ","a mention","وَٱجْعَل لِّى","صِدْقٍۢ فِى ٱلْـَٔاخِرِينَ",428],["26:195:1",375,"بِلِسَانٍ","In language","","عَرَبِىٍّۢ مُّبِينٍۢ",428],["28:34:6",389,"لِسَانًۭا","(in) speech","هُوَ أَفْصَحُ مِنِّى","فَأَرْسِلْهُ مَعِىَ رِدْءًۭا",428],["30:22:7",406,"أَلْسِنَتِكُمْ","(of) your languages","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَـٰفُ","وَأَلْوَٰنِكُمْ ۚ إِنَّ فِى",428],["33:19:20",420,"بِأَلْسِنَةٍ","with tongues","ذَهَبَ ٱلْخَوْفُ سَلَقُوكُم","حِدَادٍ أَشِحَّةً عَلَى",428],["44:58:3",498,"بِلِسَانِكَ","in your tongue","فَإِنَّمَا يَسَّرْنَـٰهُ","لَعَلَّهُمْ يَتَذَكَّرُونَ",428],["46:12:10",503,"لِّسَانًا","(in) language","وَهَـٰذَا كِتَـٰبٌۭ مُّصَدِّقٌۭ","عَرَبِيًّۭا لِّيُنذِرَ ٱلَّذِينَ",428],["48:11:12",512,"بِأَلْسِنَتِهِم","with their tongues","فَٱسْتَغْفِرْ لَنَا ۚ يَقُولُونَ","مَّا لَيْسَ فِى",428],["60:2:9",549,"وَأَلْسِنَتَهُم","and their tongues","وَيَبْسُطُوٓا۟ إِلَيْكُمْ أَيْدِيَهُمْ","بِٱلسُّوٓءِ وَوَدُّوا۟ لَوْ",428],["75:16:4",577,"لِسَانَكَ","your tongue","لَا تُحَرِّكْ بِهِۦ","لِتَعْجَلَ بِهِۦٓ",428],["90:9:1",594,"وَلِسَانًۭا","And a tongue","","وَشَفَتَيْنِ",428]]