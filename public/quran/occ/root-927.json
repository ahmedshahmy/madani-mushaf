[["14:44:26",261,"زَوَالٍۢ","end","مَا لَكُم مِّن","",4761],["14:46:10",261,"لِتَزُولَ","that should be moved","وَإِن كَانَ مَكْرُهُمْ","مِنْهُ ٱلْجِبَالُ",2088],["35:41:7",439,"تَزُولَا ۚ","they cease","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ أَن","وَلَئِن زَالَتَآ إِنْ",2088],["35:41:9",439,"زَالَتَآ","they should cease","أَن تَزُولَا ۚ وَلَئِن","إِنْ أَمْسَكَهُمَا مِنْ",2088]]