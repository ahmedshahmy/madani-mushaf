[["6:31:20",131,"أَوْزَارَهُمْ","their burdens","فِيهَا وَهُمْ يَحْمِلُونَ","عَلَىٰ ظُهُورِهِمْ ۚ أَلَا",747],["6:31:26",131,"يَزِرُونَ","they bear","أَلَا سَآءَ مَا","",1115],["6:164:17",150,"تَزِرُ","bears","إِلَّا عَلَيْهَا ۚ وَلَا","وَازِرَةٌۭ وِزْرَ أُخْرَىٰ ۚ",1115],["6:164:18",150,"وَازِرَةٌۭ","any bearer of burden","عَلَيْهَا ۚ وَلَا تَزِرُ","وِزْرَ أُخْرَىٰ ۚ ثُمَّ",1410],["6:164:19",150,"وِزْرَ","burden","وَلَا تَزِرُ وَازِرَةٌۭ","أُخْرَىٰ ۚ ثُمَّ إِلَىٰ",747],["16:25:2",269,"أَوْزَارَهُمْ","their own burdens","لِيَحْمِلُوٓا۟","كَامِلَةًۭ يَوْمَ ٱلْقِيَـٰمَةِ ۙ",747],["16:25:7",269,"أَوْزَارِ","the burdens","يَوْمَ ٱلْقِيَـٰمَةِ ۙ وَمِنْ","ٱلَّذِينَ يُضِلُّونَهُم بِغَيْرِ",747],["16:25:15",269,"يَزِرُونَ","they will bear","أَلَا سَآءَ مَا","",1115],["17:15:12",283,"تَزِرُ","will bear","يَضِلُّ عَلَيْهَا ۚ وَلَا","وَازِرَةٌۭ وِزْرَ أُخْرَىٰ ۗ",1115],["17:15:13",283,"وَازِرَةٌۭ","a bearer of burden","عَلَيْهَا ۚ وَلَا تَزِرُ","وِزْرَ أُخْرَىٰ ۗ وَمَا",1410],["17:15:14",283,"وِزْرَ","burden","وَلَا تَزِرُ وَازِرَةٌۭ","أُخْرَىٰ ۗ وَمَا كُنَّا",747],["20:29:3",313,"وَزِيرًۭا","a minister","وَٱجْعَل لِّى","مِّنْ أَهْلِى",2719],["20:87:8",317,"أَوْزَارًۭا","burdens","بِمَلْكِنَا وَلَـٰكِنَّا حُمِّلْنَآ","مِّن زِينَةِ ٱلْقَوْمِ",747],["20:100:8",319,"وِزْرًا","a burden","يَحْمِلُ يَوْمَ ٱلْقِيَـٰمَةِ","",747],["25:35:9",363,"وَزِيرًۭا","(as) an assistant","مَعَهُۥٓ أَخَاهُ هَـٰرُونَ","",2719],["35:18:2",436,"تَزِرُ","will bear","وَلَا","وَازِرَةٌۭ وِزْرَ أُخْرَىٰ ۚ",1115],["35:18:3",436,"وَازِرَةٌۭ","bearer of burdens","وَلَا تَزِرُ","وِزْرَ أُخْرَىٰ ۚ وَإِن",1410],["35:18:4",436,"وِزْرَ","burden","وَلَا تَزِرُ وَازِرَةٌۭ","أُخْرَىٰ ۚ وَإِن تَدْعُ",747],["39:7:16",459,"تَزِرُ","will bear","يَرْضَهُ لَكُمْ ۗ وَلَا","وَازِرَةٌۭ وِزْرَ أُخْرَىٰ ۗ",1115],["39:7:17",459,"وَازِرَةٌۭ","bearer of burdens","لَكُمْ ۗ وَلَا تَزِرُ","وِزْرَ أُخْرَىٰ ۗ ثُمَّ",1410],["39:7:18",459,"وِزْرَ","(the) burden","وَلَا تَزِرُ وَازِرَةٌۭ","أُخْرَىٰ ۗ ثُمَّ إِلَىٰ",747],["47:4:20",507