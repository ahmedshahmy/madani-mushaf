[["2:27:14",5,"يُوصَلَ","be joined","ٱللَّهُ بِهِۦٓ أَن","وَيُفْسِدُونَ فِى ٱلْأَرْضِ ۚ",865],["4:90:3",92,"يَصِلُونَ","join","إِلَّا ٱلَّذِينَ","إِلَىٰ قَوْمٍۭ بَيْنَكُمْ",865],["5:103:9",124,"وَصِيلَةٍۢ","a Wasilah","وَلَا سَآئِبَةٍۢ وَلَا","وَلَا حَامٍۢ ۙ وَلَـٰكِنَّ",4513],["6:136:19",145,"يَصِلُ","reach","كَانَ لِشُرَكَآئِهِمْ فَلَا","إِلَى ٱللَّهِ ۖ وَمَا",865],["6:136:26",145,"يَصِلُ","reaches","كَانَ لِلَّهِ فَهُوَ","إِلَىٰ شُرَكَآئِهِمْ ۗ سَآءَ",865],["11:70:5",229,"تَصِلُ","reaching","رَءَآ أَيْدِيَهُمْ لَا","إِلَيْهِ نَكِرَهُمْ وَأَوْجَسَ",865],["11:81:7",230,"يَصِلُوٓا۟","they will reach","رُسُلُ رَبِّكَ لَن","إِلَيْكَ ۖ فَأَسْرِ بِأَهْلِكَ",865],["13:21:2",252,"يَصِلُونَ","join","وَٱلَّذِينَ","مَآ أَمَرَ ٱللَّهُ",865],["13:21:8",252,"يُوصَلَ","be joined","ٱللَّهُ بِهِۦٓ أَن","وَيَخْشَوْنَ رَبَّهُمْ وَيَخَافُونَ",865],["13:25:14",252,"يُوصَلَ","be joined","ٱللَّهُ بِهِۦٓ أَن","وَيُفْسِدُونَ فِى ٱلْأَرْضِ ۙ",865],["28:35:9",389,"يَصِلُونَ","they will reach","لَكُمَا سُلْطَـٰنًۭا فَلَا","إِلَيْكُمَا ۚ بِـَٔايَـٰتِنَآ أَنتُمَا",865],["28:51:2",392,"وَصَّلْنَا","We have conveyed","۞ وَلَقَدْ","لَهُمُ ٱلْقَوْلَ لَعَلَّهُمْ",4515]]