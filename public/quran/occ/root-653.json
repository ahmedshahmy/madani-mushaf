[["2:264:25",44,"وَابِلٌۭ","heavy rain","عَلَيْهِ تُرَابٌۭ فَأَصَابَهُۥ","فَتَرَكَهُۥ صَلْدًۭا ۖ لَّا",2022],["2:265:15",45,"وَابِلٌۭ","heavy rain","جَنَّةٍۭ بِرَبْوَةٍ أَصَابَهَا","فَـَٔاتَتْ أُكُلَهَا ضِعْفَيْنِ",2022],["2:265:22",45,"وَابِلٌۭ","heavy rain","فَإِن لَّمْ يُصِبْهَا","فَطَلٌّۭ ۗ وَٱللَّهُ بِمَا",2022],["5:95:36",123,"وَبَالَ","(the) consequence","ذَٰلِكَ صِيَامًۭا لِّيَذُوقَ","أَمْرِهِۦ ۗ عَفَا ٱللَّهُ",1658],["59:15:7",547,"وَبَالَ","(the) evil result","قَبْلِهِمْ قَرِيبًۭا ۖ ذَاقُوا۟","أَمْرِهِمْ وَلَهُمْ عَذَابٌ",1658],["64:5:9",556,"وَبَالَ","(the bad) consequence","مِن قَبْلُ فَذَاقُوا۟","أَمْرِهِمْ وَلَهُمْ عَذَابٌ",1658],["65:9:2",559,"وَبَالَ","(the bad) consequence","فَذَاقَتْ","أَمْرِهَا وَكَانَ عَـٰقِبَةُ",1658],["73:16:6",574,"وَبِيلًۭا","ruinous","ٱلرَّسُولَ فَأَخَذْنَـٰهُ أَخْذًۭا","",4520]]