لَىٰ","شَىْءٍۢ قَدِيرٌ",31],["64:11:14",557,"بِكُلِّ","of every","يَهْدِ قَلْبَهُۥ ۚ وَٱللَّهُ","شَىْءٍ عَلِيمٌۭ",31],["65:3:19",558,"لِكُلِّ","for every","قَدْ جَعَلَ ٱللَّهُ","شَىْءٍۢ قَدْرًۭا",31],["65:12:16",559,"كُلِّ","every","أَنَّ ٱللَّهَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ وَأَنَّ",31],["65:12:23",559,"بِكُلِّ","all","ٱللَّهَ قَدْ أَحَاطَ","شَىْءٍ عِلْمًۢا",31],["66:8:43",561,"كُلِّ","every","لَنَآ ۖ إِنَّكَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["67:1:7",562,"كُلِّ","every","ٱلْمُلْكُ وَهُوَ عَلَىٰ","شَىْءٍۢ قَدِيرٌ",31],["67:8:5",562,"كُلَّمَآ","Every time","تَمَيَّزُ مِنَ ٱلْغَيْظِ ۖ","أُلْقِىَ فِيهَا فَوْجٌۭ",630],["67:19:13",563,"بِكُلِّ","(is) of every","إِلَّا ٱلرَّحْمَـٰنُ ۚ إِنَّهُۥ","شَىْءٍۭ بَصِيرٌ",31],["68:10:3",564,"كُلَّ","every","وَلَا تُطِعْ","حَلَّافٍۢ مَّهِينٍ",31],["70:38:2",569,"كُلُّ","every","أَيَطْمَعُ","ٱمْرِئٍۢ مِّنْهُمْ أَن",31],["71:7:2",570,"كُلَّمَا","every time","وَإِنِّى","دَعَوْتُهُمْ لِتَغْفِرَ لَهُمْ",630],["72:28:11",573,"كُلَّ","(of) all","بِمَا لَدَيْهِمْ وَأَحْصَىٰ","شَىْءٍ عَدَدًۢا",31],["74:38:1",576,"كُلُّ","Every","","نَفْسٍۭ بِمَا كَسَبَتْ",31],["74:52:3",577,"كُلُّ","every","بَلْ يُرِيدُ","ٱمْرِئٍۢ مِّنْهُمْ أَن",31],["78:29:1",582,"وَكُلَّ","And every","","شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًۭا",31],["80:37:1",585,"لِكُلِّ","For every","","ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ",31],["83:12:5",588,"كُلُّ","every","يُكَذِّبُ بِهِۦٓ إِلَّا","مُعْتَدٍ أَثِيمٍ",31],["85:9:8",590,"كُلِّ","every","وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ","شَىْءٍۢ شَهِيدٌ",31],["86:4:2",591,"كُلُّ","(is) every","إِن","نَفْسٍۢ لَّمَّا عَلَيْهَا",31],["97:4:8",598,"كُلِّ","every","بِإِذْنِ رَبِّهِم مِّن","أَمْرٍۢ",31],["104:1:2",601,"لِّكُلِّ","to every","وَيْلٌۭ","هُمَزَةٍۢ لُّمَزَةٍ",31]]