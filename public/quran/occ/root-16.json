[["2:20:5",4,"كُلَّمَآ","Whenever","ٱلْبَرْقُ يَخْطَفُ أَبْصَـٰرَهُمْ ۖ","أَضَآءَ لَهُم مَّشَوْا۟",630],["2:20:23",4,"كُلِّ","every","إِنَّ ٱللَّهَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["2:25:13",5,"كُلَّمَا","Every time","مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۖ","رُزِقُوا۟ مِنْهَا مِن",630],["2:29:17",5,"بِكُلِّ","of every","سَبْعَ سَمَـٰوَٰتٍۢ ۚ وَهُوَ","شَىْءٍ عَلِيمٌۭ",31],["2:31:4",6,"كُلَّهَا","all of them","وَعَلَّمَ ءَادَمَ ٱلْأَسْمَآءَ","ثُمَّ عَرَضَهُمْ عَلَى",31],["2:60:16",9,"كُلُّ","all","عَيْنًۭا ۖ قَدْ عَلِمَ","أُنَاسٍۢ مَّشْرَبَهُمْ ۖ كُلُوا۟",31],["2:87:17",13,"أَفَكُلَّمَا","Is it (not) so (that) whenever","وَأَيَّدْنَـٰهُ بِرُوحِ ٱلْقُدُسِ ۗ","جَآءَكُمْ رَسُولٌۢ بِمَا",630],["2:100:1",15,"أَوَكُلَّمَا","And is (it not that) whenever","","عَـٰهَدُوا۟ عَهْدًۭا نَّبَذَهُۥ",630],["2:106:17",17,"كُلِّ","every","أَنَّ ٱللَّهَ عَلَىٰ","شَىْءٍۢ قَدِيرٌ",31],["2:109:31",17,"كُلِّ","every","إِنَّ ٱللَّهَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["2:116:12",18,"كُلٌّۭ","All","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ","لَّهُۥ قَـٰنِتُونَ",31],["2:145:6",22,"بِكُلِّ","with all","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ","ءَايَةٍۢ مَّا تَبِعُوا۟",31],["2:148:1",23,"وَلِكُلٍّۢ","And for everyone","","وِجْهَةٌ هُوَ مُوَلِّيهَا ۖ",31],["2:148:17",23,"كُلِّ","every","إِنَّ ٱللَّهَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["2:164:32",25,"كُلِّ","every","وَبَثَّ فِيهَا مِن","دَآبَّةٍۢ وَتَصْرِيفِ ٱلرِّيَـٰحِ",31],["2:231:43",37,"بِكُلِّ","of every","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","شَىْءٍ عَلِيمٌۭ",31],["2:259:65",43,"كُلِّ","every","أَنَّ ٱللَّهَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["2:260:27",44,"كُلِّ","each","ثُمَّ ٱجْعَلْ عَلَىٰ","جَبَلٍۢ مِّنْهُنَّ جُزْءًۭا",31],["2:261:14",44,"كُلِّ","each","سَبْعَ سَنَابِلَ فِى","سُنۢبُلَةٍۢ مِّا۟ئَةُ حَبَّةٍۢ ۗ",31],["2:266:17",45,"كُلِّ","all (kinds)","لَهُۥ فِيهَا مِن","ٱلثَّمَرَٰتِ وَأَصَابَهُ ٱلْكِبَرُ",31],["2:276:9",47,"كُلَّ","every","وَٱللَّهُ لَا يُحِبُّ","كَفَّارٍ أَثِيمٍ",31],["2:281:9",47,"كُلُّ","every","ٱللَّهِ ۖ ثُمَّ تُوَفَّىٰ","نَفْسٍۢ مَّا كَسَبَتْ",31],["2:282:126",48,"بِكُلِّ","of every","وَيُعَلِّمُكُمُ ٱللَّهُ ۗ وَٱللَّهُ","شَىْءٍ عَلِيمٌۭ",31],["2:284:26",49,"كُلِّ","every","يَشَآءُ ۗ وَٱللَّهُ عَلَىٰ","شَىْءٍۢ قَدِيرٌ",31],["2:285:9",49,"كُلٌّ","All","مِن رَّبِّهِۦ وَٱلْمُؤْمِنُونَ ۚ","ءَامَنَ بِٱللَّهِ وَمَلَـٰٓئِكَتِهِۦ",31],["3:7:38",50,"كُلٌّۭ","All","يَقُولُونَ ءَامَنَّا بِهِۦ","مِّنْ عِندِ رَبِّنَا ۗ",31],["3:25:9",53,"كُلُّ","every","رَيْبَ فِيهِ وَوُفِّيَتْ","نَفْسٍۢ مَّا كَسَبَتْ",31],["3:26:23",53,"كُلِّ","every","ٱلْخَيْرُ ۖ إِنَّكَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["3:29:20",53,"كُلِّ","every","ٱلْأَرْضِ ۗ وَٱللَّهُ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["3:30:3",54,"كُلُّ","every","يَوْمَ تَجِدُ","نَفْسٍۢ مَّا عَمِلَتْ",31],["3:37:10",54,"كُلَّمَا","Whenever","حَسَنًۭا وَكَفَّلَهَا زَكَرِيَّا ۖ","دَخَلَ عَلَيْهَا زَكَرِيَّا",630],["3:93:1",62,"۞ كُلُّ","All","","ٱلطَّعَامِ كَانَ حِلًّۭا",31],["3:119:8",65,"كُلِّهِۦ","all of it","يُحِبُّونَكُمْ وَتُؤْمِنُونَ بِٱلْكِتَـٰبِ","وَإِذَا لَقُوكُمْ قَالُوٓا۟",31],["3:154:32",70,"كُلَّهُۥ","all (of) it","قُلْ إِنَّ ٱلْأَمْرَ","لِلَّهِ ۗ يُخْفُونَ فِىٓ",31],["3:161:15",71,"كُلُّ","every","ٱلْقِيَـٰمَةِ ۚ ثُمَّ تُوَفَّىٰ","نَفْسٍۢ مَّا كَسَبَتْ",31],["3:165:18",71,"كُلِّ","every","إِنَّ ٱللَّهَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["3:185:1",74,"كُلُّ","Every","","نَفْسٍۢ ذَآئِقَةُ ٱلْمَوْتِ ۗ",31],["3:189:7",75,"كُلِّ","every","وَٱلْأَرْضِ ۗ وَٱللَّهُ عَلَىٰ","شَىْءٍۢ قَدِيرٌ",31],["4:11:24",78,"لِكُلِّ","for each","فَلَهَا ٱلنِّصْفُ ۚ وَلِأَبَوَيْهِ","وَٰحِدٍۢ مِّنْهُمَا ٱلسُّدُسُ",31],["4:12:54",79,"كَلَـٰلَةً","(has) no parent or child","كَانَ رَجُلٌۭ يُورَثُ","أَوِ ٱمْرَأَةٌۭ وَلَهُۥٓ",2418],["4:12:61",79,"فَلِكُلِّ","then for each","أَخٌ أَوْ أُخْتٌۭ","وَٰحِدٍۢ مِّنْهُمَا ٱلسُّدُسُ ۚ",31],["4:32:25",83,"بِكُلِّ","of every","إِنَّ ٱللَّهَ كَانَ","شَىْءٍ عَلِيمًۭا",31],["4:33:1",83,"وَلِكُلٍّۢ","And for all","","جَعَلْنَا مَوَٰلِىَ مِمَّا",31],["4:33:17",83,"كُلِّ","every","ٱللَّهَ كَانَ عَلَىٰ","شَىْءٍۢ شَهِيدًا",31],["4:41:5",85,"كُلِّ","every","إِذَا جِئْنَا مِن","أُمَّةٍۭ بِشَهِيدٍۢ وَجِئْنَا",31],["4:56:8",87,"كُلَّمَا","Every time","سَوْفَ نُصْلِيهِمْ نَارًۭا","نَضِجَتْ جُلُودُهُم بَدَّلْنَـٰهُمْ",630],["4:78:26",90,"كُلٌّۭ","All","مِنْ عِندِكَ ۚ قُلْ","مِّنْ عِندِ ٱللَّهِ ۖ",31],["4:85:20",91,"كُلِّ","every","وَكَانَ ٱللَّهُ عَلَىٰ","شَىْءٍۢ مُّقِيتًۭا",31],["4:86:13",91,"كُلِّ","every","ٱللَّهَ كَانَ عَلَىٰ","شَىْءٍ حَسِيبًا",31],["4:91:8",92,"كُلَّ","Everytime","يَأْمَنُوكُمْ وَيَأْمَنُوا۟ قَوْمَهُمْ","مَا رُدُّوٓا۟ إِلَى",31],["4:95:23",94,"وَكُلًّۭا","And (to) all","عَلَى ٱلْقَـٰعِدِينَ دَرَجَةًۭ ۚ","وَعَدَ ٱللَّهُ ٱلْحُسْنَىٰ ۚ",31],["4:126:10",98,"بِكُلِّ","of every","ٱلْأَرْضِ ۚ وَكَانَ ٱللَّهُ","شَىْءٍۢ مُّحِيطًۭا",31],["4:129:11",99,"كُلَّ","(with) all","حَرَصْتُمْ ۖ فَلَا تَمِيلُوا۟","ٱلْمَيْلِ فَتَذَرُوهَا كَٱلْمُعَلَّقَةِ ۚ",31],["4:130:5",99,"كُلًّۭا","each (of them)","يَتَفَرَّقَا يُغْنِ ٱللَّهُ","مِّن سَعَتِهِۦ ۚ وَكَانَ",31],["4:176:6",106,"ٱلْكَلَـٰلَةِ ۚ","the Kalala","ٱللَّهُ يُفْتِيكُمْ فِى","إِنِ ٱمْرُؤٌا۟ هَلَكَ",2418],["4:176:48",106,"بِكُلِّ","of every","أَن تَضِلُّوا۟ ۗ وَٱللَّهُ","شَىْءٍ عَلِيمٌۢ",31],["5:17:40",110,"كُلِّ","every","يَشَآءُ ۚ وَٱللَّهُ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["5:19:26",111,"كُلِّ","every","وَنَذِيرٌۭ ۗ وَٱللَّهُ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["5:40:17",114,"كُلِّ","every","يَشَآءُ ۗ وَٱللَّهُ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["5:48:25",116,"لِكُلٍّۢ","For each","جَآءَكَ مِنَ ٱلْحَقِّ ۚ","جَعَلْنَا مِنكُمْ شِرْعَةًۭ",31],["5:64:34",118,"كُلَّمَآ","Every time","إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ ۚ","أَوْقَدُوا۟ نَارًۭا لِّلْحَرْبِ",630],["5:70:9",119,"كُلَّمَا","Whenever","وَأَرْسَلْنَآ إِلَيْهِمْ رُسُلًۭا ۖ","جَآءَهُمْ رَسُولٌۢ بِمَا",630],["5:97:25",124,"بِكُلِّ","of every","ٱلْأَرْضِ وَأَنَّ ٱللَّهَ","شَىْءٍ عَلِيمٌ",31],["5:117:27",127,"كُلِّ","every","عَلَيْهِمْ ۚ وَأَنتَ عَلَىٰ","شَىْءٍۢ شَهِيدٌ",31],["5:120:9",127,"كُلِّ","every","فِيهِنَّ ۚ وَهُوَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۢ",31],["6:17:15",129,"كُلِّ","every","بِخَيْرٍۢ فَهُوَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["6:25:16",130,"كُلَّ","every","وَقْرًۭا ۚ وَإِن يَرَوْا۟","ءَايَةٍۢ لَّا يُؤْمِنُوا۟",31],["6:44:9",132,"كُلِّ","(of) every","فَتَحْنَا عَلَيْهِمْ أَبْوَٰبَ","شَىْءٍ حَتَّىٰٓ إِذَا",31],["6:64:6",135,"كُلِّ","every","يُنَجِّيكُم مِّنْهَا وَمِن","كَرْبٍۢ ثُمَّ أَنتُمْ",31],["6:67:1",135,"لِّكُلِّ","For every","","نَبَإٍۢ مُّسْتَقَرٌّۭ ۚ وَسَوْفَ",31],["6:70:27",136,"كُلَّ","every","شَفِيعٌۭ وَإِن تَعْدِلْ","عَدْلٍۢ لَّا يُؤْخَذْ",31],["6:80:21",137,"كُلَّ","every","شَيْـًۭٔا ۗ وَسِعَ رَبِّى","شَىْءٍ عِلْمًا ۗ أَفَلَا",31],["6:84:5",138,"كُلًّا","all","لَهُۥٓ إِسْحَـٰقَ وَيَعْقُوبَ ۚ","هَدَيْنَا ۚ وَنُوحًا هَدَيْنَا",31],["6:85:5",138,"كُلٌّۭ","all (were)","وَيَحْيَىٰ وَعِيسَىٰ وَإِلْيَاسَ ۖ","مِّنَ ٱلصَّـٰلِحِينَ",31],["6:86:5",138,"وَكُلًّۭا","and all","وَٱلْيَسَعَ وَيُونُسَ وَلُوطًۭا ۚ","فَضَّلْنَا عَلَى ٱلْعَـٰلَمِينَ",31],["6:99:10",140,"كُلِّ","(of) every","فَأَخْرَجْنَا بِهِۦ نَبَاتَ","شَىْءٍۢ فَأَخْرَجْنَا مِنْهُ",31],["6:101:13",140,"كُلَّ","every","لَّهُۥ صَـٰحِبَةٌۭ ۖ وَخَلَقَ","شَىْءٍۢ ۖ وَهُوَ بِكُلِّ",31],["6:101:16",140,"بِكُلِّ","(is) of every","كُلَّ شَىْءٍۢ ۖ وَهُوَ","شَىْءٍ عَلِيمٌۭ",31],["6:102:9",141,"كُلِّ","(of) every","إِلَّا هُوَ ۖ خَـٰلِقُ","شَىْءٍۢ فَٱعْبُدُوهُ ۚ وَهُوَ",31],["6:102:14",141,"كُلِّ","every","فَٱعْبُدُوهُ ۚ وَهُوَ عَلَىٰ","شَىْءٍۢ وَكِيلٌۭ",31],["6:108:15",141,"لِكُلِّ","to every","عِلْمٍۢ ۗ كَذَٰلِكَ زَيَّنَّا","أُمَّةٍ عَمَلَهُمْ ثُمَّ",31],["6:111:10",142,"كُلَّ","every","ٱلْمَوْتَىٰ وَحَشَرْنَا عَلَيْهِمْ","شَىْءٍۢ قُبُلًۭا مَّا",31],["6:112:3",142,"لِكُلِّ","for every","وَكَذَٰلِكَ جَعَلْنَا","نَبِىٍّ عَدُوًّۭا شَيَـٰطِينَ",31],["6:123:4",143,"كُلِّ","every","وَكَذَٰلِكَ جَعَلْنَا فِى","قَرْيَةٍ أَكَـٰبِرَ مُجْرِمِيهَا",31],["6:132:1",145,"وَلِكُلٍّۢ","And for all","","دَرَجَـٰتٌۭ مِّمَّا عَمِلُوا۟ ۚ",31],["6:146:5",147,"كُلَّ","every","ٱلَّذِينَ هَادُوا۟ حَرَّمْنَا","ذِى ظُفُرٍۢ ۖ وَمِنَ",31],["6:154:10",149,"لِّكُلِّ","of every","ٱلَّذِىٓ أَحْسَنَ وَتَفْصِيلًۭا","شَىْءٍۢ وَهُدًۭى وَرَحْمَةًۭ",31],["6:164:8",150,"كُلِّ","(of) every","رَبًّۭا وَهُوَ رَبُّ","شَىْءٍۢ ۚ وَلَا تَكْسِبُ",31],["6:164:12",150,"كُلُّ","every","شَىْءٍۢ ۚ وَلَا تَكْسِبُ","نَفْسٍ إِلَّا عَلَيْهَا ۚ",31],["7:29:8",153,"كُلِّ","every","وَأَقِيمُوا۟ وُجُوهَكُمْ عِندَ","مَسْجِدٍۢ وَٱدْعُوهُ مُخْلِصِينَ",31],["7:31:6",154,"كُلِّ","every","خُذُوا۟ زِينَتَكُمْ عِندَ","مَسْجِدٍۢ وَكُلُوا۟ وَٱشْرَبُوا۟",31],["7:34:1",154,"وَلِكُلِّ","And for every","","أُمَّةٍ أَجَلٌۭ ۖ فَإِذَا",31],["7:38:14",155,"كُلَّمَا","Every time","وَٱلْإِنسِ فِى ٱلنَّارِ ۖ","دَخَلَتْ أُمَّةٌۭ لَّعَنَتْ",630],["7:38:36",155,"لِكُلٍّۢ","For each","مِّنَ ٱلنَّارِ ۖ قَالَ","ضِعْفٌۭ وَلَـٰكِن لَّا",31],["7:46:7",156,"كُلًّۢا","all","ٱلْأَعْرَافِ رِجَالٌۭ يَعْرِفُونَ","بِسِيمَىٰهُمْ ۚ وَنَادَوْا۟ أَصْحَـٰبَ",31],["7:57:23",157,"كُلِّ","all (kinds)","فَأَخْرَجْنَا بِهِۦ مِن","ٱلثَّمَرَٰتِ ۚ كَذَٰلِكَ نُخْرِجُ",31],["7:86:3",161,"بِكُلِّ","on every","وَلَا تَقْعُدُوا۟","صِرَٰطٍۢ تُوعِدُونَ وَتَصُدُّونَ",31],["7:89:28",162,"كُلَّ","every","رَبُّنَا ۚ وَسِعَ رَبُّنَا","شَىْءٍ عِلْمًا ۚ عَلَى",31],["7:112:2",164,"بِكُلِّ","[with] every","يَأْتُوكَ","سَـٰحِرٍ عَلِيمٍۢ",31],["7:145:6",168,"كُلِّ","every","فِى ٱلْأَلْوَاحِ مِن","شَىْءٍۢ مَّوْعِظَةًۭ وَتَفْصِيلًۭا",31],["7:145:10",168,"لِّكُلِّ","for every","شَىْءٍۢ مَّوْعِظَةًۭ وَتَفْصِيلًۭا","شَىْءٍۢ فَخُذْهَا بِقُوَّةٍۢ",31],["7:146:12",168,"كُلَّ","every","ٱلْحَقِّ وَإِن يَرَوْا۟","ءَايَةٍۢ لَّا يُؤْمِنُوا۟",31],["7:156:20",170,"كُلَّ","every","أَشَآءُ ۖ وَرَحْمَتِى وَسِعَتْ","شَىْءٍۢ ۚ فَسَأَكْتُبُهَا لِلَّذِينَ",31],["7:160:23",171,"كُلُّ","each","عَيْنًۭا ۖ قَدْ عَلِمَ","أُنَاسٍۢ مَّشْرَبَهُمْ ۚ وَظَلَّلْنَا",31],["8:12:22",178,"كُلَّ","every","ٱلْأَعْنَاقِ وَٱضْرِبُوا۟ مِنْهُمْ","بَنَانٍۢ",31],["8:39:8",181,"كُلُّهُۥ","all of it","فِتْنَةٌۭ وَيَكُونَ ٱلدِّينُ","لِلَّهِ ۚ فَإِنِ ٱنتَهَوْا۟",31],["8:41:31",182,"كُلِّ","every","ٱلْجَمْعَانِ ۗ وَٱللَّهُ عَلَىٰ","شَىْءٍۢ قَدِيرٌ",31],["8:54:15",184,"وَكُلٌّۭ","and (they) all","وَأَغْرَقْنَآ ءَالَ فِرْعَوْنَ ۚ","كَانُوا۟ ظَـٰلِمِينَ",31],["8:56:8",184,"كُلِّ","every","يَنقُضُونَ عَهْدَهُمْ فِى","مَرَّةٍۢ وَهُمْ لَا",31],["8:75:20",186,"بِكُلِّ","of every","ٱللَّهِ ۗ إِنَّ ٱللَّهَ","شَىْءٍ عَلِيمٌۢ",31],["9:5:13",187,"كُلَّ","(at) every","وَٱحْصُرُوهُمْ وَٱقْعُدُوا۟ لَهُمْ","مَرْصَدٍۢ ۚ فَإِن تَابُوا۟",31],["9:33:11",192,"كُلِّهِۦ","all religions","لِيُظْهِرَهُۥ عَلَى ٱلدِّينِ","وَلَوْ كَرِهَ ٱلْمُشْرِكُونَ",31],["9:39:14",193,"كُلِّ","every","شَيْـًۭٔا ۗ وَٱللَّهُ عَلَىٰ","شَىْءٍۢ قَدِيرٌ",31],["9:115:16",205,"بِكُلِّ","(of) every","يَتَّقُونَ ۚ إِنَّ ٱللَّهَ","شَىْءٍ عَلِيمٌ",31],["9:122:9",206,"كُلِّ","every","فَلَوْلَا نَفَرَ مِن","فِرْقَةٍۢ مِّنْهُمْ طَآئِفَةٌۭ",31],["9:126:6",207,"كُلِّ","every","أَنَّهُمْ يُفْتَنُونَ فِى","عَامٍۢ مَّرَّةً أَوْ",31],["10:22:24",211,"كُلِّ","every","وَجَآءَهُمُ ٱلْمَوْجُ مِن","مَكَانٍۢ وَظَنُّوٓا۟ أَنَّهُمْ",31],["10:30:3",212,"كُلُّ","every","هُنَالِكَ تَبْلُوا۟","نَفْسٍۢ مَّآ أَسْلَفَتْ ۚ",31],["10:47:1",214,"وَلِكُلِّ","And for every","","أُمَّةٍۢ رَّسُولٌۭ ۖ فَإِذَا",31],["10:49:12",214,"لِكُلِّ","For every","مَا شَآءَ ٱللَّهُ ۗ","أُمَّةٍ أَجَلٌ ۚ إِذَا",31],["10:54:3",215,"لِكُلِّ","for every","وَلَوْ أَنَّ","نَفْسٍۢ ظَلَمَتْ مَا",31],["10:79:4",218,"بِكُلِّ","every","وَقَالَ فِرْعَوْنُ ٱئْتُونِى","سَـٰحِرٍ عَلِيمٍۢ",31],["10:97:3",219,"كُلُّ","every","وَلَوْ جَآءَتْهُمْ","ءَايَةٍ حَتَّىٰ يَرَوُا۟",31],["10:99:8",220,"كُلُّهُمْ","all of them","مَن فِى ٱلْأَرْضِ","جَمِيعًا ۚ أَفَأَنتَ تُكْرِهُ",31],["11:3:14",221,"كُلَّ","(to) every","أَجَلٍۢ مُّسَمًّۭى وَيُؤْتِ","ذِى فَضْلٍۢ فَضْلَهُۥ ۖ",31],["11:4:6",221,"كُلِّ","every","مَرْجِعُكُمْ ۖ وَهُوَ عَلَىٰ","شَىْءٍۢ قَدِيرٌ",31],["11:6:13",222,"كُلٌّۭ","All","وَيَعْلَمُ مُسْتَقَرَّهَا وَمُسْتَوْدَعَهَا ۚ","فِى كِتَـٰبٍۢ مُّبِينٍۢ",31],["11:12:25",222,"كُلِّ","every","نَذِيرٌۭ ۚ وَٱللَّهُ عَلَىٰ","شَىْءٍۢ وَكِيلٌ",31],["11:38:3",226,"وَكُلَّمَا","and every time","وَيَصْنَعُ ٱلْفُلْكَ","مَرَّ عَلَيْهِ مَلَأٌۭ",630],["11:40:11",226,"كُلٍّۢ","every kind","ٱحْمِلْ فِيهَا مِن","زَوْجَيْنِ ٱثْنَيْنِ وَأَهْلَكَ",31],["11:57:19",228,"كُلِّ","all","إِنَّ رَبِّى عَلَىٰ","شَىْءٍ حَفِيظٌۭ",31],["11:59:10",228,"كُلِّ","(of) every","رُسُلَهُۥ وَٱتَّبَعُوٓا۟ أَمْرَ","جَبَّارٍ عَنِيدٍۢ",31],["11:111:2",234,"كُلًّۭا","to each [when]","وَإِنَّ","لَّمَّا لَيُوَفِّيَنَّهُمْ رَبُّكَ",31],["11:120:1",235,"وَكُلًّۭا","And each","","نَّقُصُّ عَلَيْكَ مِنْ",31],["11:123:8",235,"كُلُّهُۥ","all (of) it","وَإِلَيْهِ يُرْجَعُ ٱلْأَمْرُ","فَٱعْبُدْهُ وَتَوَكَّلْ عَلَيْهِ ۚ",31],["12:31:10",239,"كُلَّ","each","لَهُنَّ مُتَّكَـًۭٔا وَءَاتَتْ","وَٰحِدَةٍۢ مِّنْهُنَّ سِكِّينًۭا",31],["12:76:30",244,"كُلِّ","every","مَّن نَّشَآءُ ۗ وَفَوْقَ","ذِى عِلْمٍ عَلِيمٌۭ",31],["12:111:18",248,"كُلِّ","(of) all","بَيْنَ يَدَيْهِ وَتَفْصِيلَ","شَىْءٍۢ وَهُدًۭى وَرَحْمَةًۭ",31],["13:2:15",249,"كُلٌّۭ","each","وَسَخَّرَ ٱلشَّمْسَ وَٱلْقَمَرَ ۖ","يَجْرِى لِأَجَلٍۢ مُّسَمًّۭى ۚ",31],["13:3:10",249,"كُلِّ","all","رَوَٰسِىَ وَأَنْهَـٰرًۭا ۖ وَمِن","ٱلثَّمَرَٰتِ جَعَلَ فِيهَا",31],["13:7:13",250,"وَلِكُلِّ","and for every","إِنَّمَآ أَنتَ مُنذِرٌۭ ۖ","قَوْمٍ هَادٍ",31],["13:8:5",250,"كُلُّ","every","يَعْلَمُ مَا تَحْمِلُ","أُنثَىٰ وَمَا تَغِيضُ",31],["13:8:12",250,"وَكُلُّ","And every","ٱلْأَرْحَامُ وَمَا تَزْدَادُ ۖ","شَىْءٍ عِندَهُۥ بِمِقْدَارٍ",31],["13:16:41",251,"كُلِّ","of all","قُلِ ٱللَّهُ خَـٰلِقُ","شَىْءٍۢ وَهُوَ ٱلْوَٰحِدُ",31],["13:23:14",252,"كُلِّ","every","يَدْخُلُونَ عَلَيْهِم مِّن","بَابٍۢ",31],["13:33:5",253,"كُلِّ","every","هُوَ قَآئِمٌ عَلَىٰ","نَفْسٍۭ بِمَا كَسَبَتْ ۗ",31],["13:38:19",254,"لِكُلِّ","For everything","إِلَّا بِإِذْنِ ٱللَّهِ ۗ","أَجَلٍۢ كِتَابٌۭ",31],["13:42:12",254,"كُلُّ","every","يَعْلَمُ مَا تَكْسِبُ","نَفْسٍۢ ۗ وَسَيَعْلَمُ ٱلْكُفَّـٰرُ",31],["14:5:19",255,"لِّكُلِّ","for everyone","فِى ذَٰلِكَ لَـَٔايَـٰتٍۢ","صَبَّارٍۢ شَكُورٍۢ",31],["14:15:3",257,"كُلُّ","every","وَٱسْتَفْتَحُوا۟ وَخَابَ","جَبَّارٍ عَنِيدٍۢ",31],["14:17:8",257,"كُلِّ","every","وَيَأْتِيهِ ٱلْمَوْتُ مِن","مَكَانٍۢ وَمَا هُوَ",31],["14:25:3",259,"كُلَّ","all","تُؤْتِىٓ أُكُلَهَا","حِينٍۭ بِإِذْنِ رَبِّهَا ۗ",31],["14:34:3",260,"كُلِّ","all","وَءَاتَىٰكُم مِّن","مَا سَأَلْتُمُوهُ ۚ وَإِن",31],["14:51:3",261,"كُلَّ","each","لِيَجْزِىَ ٱللَّهُ","نَفْسٍۢ مَّا كَسَبَتْ ۚ",31],["15:17:3",263,"كُلِّ","every","وَحَفِظْنَـٰهَا مِن","شَيْطَـٰنٍۢ رَّجِيمٍ",31],["15:19:9",263,"كُلِّ","every","وَأَنۢبَتْنَا فِيهَا مِن","شَىْءٍۢ مَّوْزُونٍۢ",31],["15:30:3",263,"كُلُّهُمْ","all of them","فَسَجَدَ ٱلْمَلَـٰٓئِكَةُ","أَجْمَعُونَ",31],["15:44:4",264,"لِّكُلِّ","for each","لَهَا سَبْعَةُ أَبْوَٰبٍۢ","بَابٍۢ مِّنْهُمْ جُزْءٌۭ",31],["16:11:9",268,"كُلِّ","every kind","وَٱلنَّخِيلَ وَٱلْأَعْنَـٰبَ وَمِن","ٱلثَّمَرَٰتِ ۗ إِنَّ فِى",31],["16:36:4",271,"كُلِّ","every","وَلَقَدْ بَعَثْنَا فِى","أُمَّةٍۢ رَّسُولًا أَنِ",31],["16:69:4",274,"كُلِّ","all","ثُمَّ كُلِى مِن","ٱلثَّمَرَٰتِ فَٱسْلُكِى سُبُلَ",31],["16:76:12",275,"كَلٌّ","(is) a burden","عَلَىٰ شَىْءٍۢ وَهُوَ","عَلَىٰ مَوْلَىٰهُ أَيْنَمَا",3567],["16:77:17",275,"كُلِّ","every","إِنَّ ٱللَّهَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["16:84:4",276,"كُلِّ","every","وَيَوْمَ نَبْعَثُ مِن","أُمَّةٍۢ شَهِيدًۭا ثُمَّ",31],["16:89:4",277,"كُلِّ","every","وَيَوْمَ نَبْعَثُ فِى","أُمَّةٍۢ شَهِيدًا عَلَيْهِم",31],["16:89:19",277,"لِّكُلِّ","of every","عَلَيْكَ ٱلْكِتَـٰبَ تِبْيَـٰنًۭا","شَىْءٍۢ وَهُدًۭى وَرَحْمَةًۭ",31],["16:111:3",280,"كُلُّ","every","۞ يَوْمَ تَأْتِى","نَفْسٍۢ تُجَـٰدِلُ عَن",31],["16:111:9",280,"كُلُّ","every","عَن نَّفْسِهَا وَتُوَفَّىٰ","نَفْسٍۢ مَّا عَمِلَتْ",31],["16:112:12",280,"كُلِّ","every","رِزْقُهَا رَغَدًۭا مِّن","مَكَانٍۢ فَكَفَرَتْ بِأَنْعُمِ",31],["17:12:20",283,"وَكُلَّ","And every","عَدَدَ ٱلسِّنِينَ وَٱلْحِسَابَ ۚ","شَىْءٍۢ فَصَّلْنَـٰهُ تَفْصِيلًۭا",31],["17:13:1",283,"وَكُلَّ","And (for) every","","إِنسَـٰنٍ أَلْزَمْنَـٰهُ طَـٰٓئِرَهُۥ",31],["17:20:1",284,"كُلًّۭا","(To) each","","نُّمِدُّ هَـٰٓؤُلَآءِ وَهَـٰٓؤُلَآءِ",31],["17:29:9",285,"كُلَّ","(to its) utmost","عُنُقِكَ وَلَا تَبْسُطْهَا","ٱلْبَسْطِ فَتَقْعُدَ مَلُومًۭا",31],["17:36:12",285,"كُلُّ","all","ٱلسَّمْعَ وَٱلْبَصَرَ وَٱلْفُؤَادَ","أُو۟لَـٰٓئِكَ كَانَ عَنْهُ",31],["17:38:1",285,"كُلُّ","All"