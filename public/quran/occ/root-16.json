11",385,"كُلُّ","all","ٱلَّذِى حَرَّمَهَا وَلَهُۥ","شَىْءٍۢ ۖ وَأُمِرْتُ أَنْ",31],["28:48:25",391,"بِكُلٍّۢ","in all","تَظَـٰهَرَا وَقَالُوٓا۟ إِنَّا","كَـٰفِرُونَ",31],["28:57:17",392,"كُلِّ","(of) all","يُجْبَىٰٓ إِلَيْهِ ثَمَرَٰتُ","شَىْءٍۢ رِّزْقًۭا مِّن",31],["28:75:3",394,"كُلِّ","every","وَنَزَعْنَا مِن","أُمَّةٍۢ شَهِيدًۭا فَقُلْنَا",31],["28:88:11",396,"كُلُّ","Every","إِلَـٰهَ إِلَّا هُوَ ۚ","شَىْءٍ هَالِكٌ إِلَّا",31],["29:20:17",398,"كُلِّ","every","إِنَّ ٱللَّهَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["29:40:1",401,"فَكُلًّا","So each","","أَخَذْنَا بِذَنۢبِهِۦ ۖ فَمِنْهُم",31],["29:57:1",403,"كُلُّ","Every","","نَفْسٍۢ ذَآئِقَةُ ٱلْمَوْتِ ۖ",31],["29:62:12",403,"بِكُلِّ","of every","لَهُۥٓ ۚ إِنَّ ٱللَّهَ","شَىْءٍ عَلِيمٌۭ",31],["30:26:6",407,"كُلٌّۭ","All","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ","لَّهُۥ قَـٰنِتُونَ",31],["30:32:7",407,"كُلُّ","each","دِينَهُمْ وَكَانُوا۟ شِيَعًۭا ۖ","حِزْبٍۭ بِمَا لَدَيْهِمْ",31],["30:50:17",409,"كُلِّ","every","ٱلْمَوْتَىٰ ۖ وَهُوَ عَلَىٰ","شَىْءٍۢ قَدِيرٌۭ",31],["30:58:8",410,"كُلِّ","every","هَـٰذَا ٱلْقُرْءَانِ مِن","مَثَلٍۢ ۚ وَلَئِن جِئْتَهُم",31],["31:10:16",411,"كُلِّ","every","وَبَثَّ فِيهَا مِن","دَآبَّةٍۢ ۚ وَأَنزَلْنَا مِنَ",31],["31:10:25",411,"كُلِّ","every","فَأَنۢبَتْنَا فِيهَا مِن","زَوْجٍۢ كَرِيمٍ",31],["31:18:14",412,"كُلَّ","every","ٱللَّهَ لَا يُحِبُّ","مُخْتَالٍۢ فَخُورٍۢ",31],["31:29:16",414,"كُلٌّۭ","each","وَسَخَّرَ ٱلشَّمْسَ وَٱلْقَمَرَ","يَجْرِىٓ إِلَىٰٓ أَجَلٍۢ",31],["31:31:17",414,"لِّكُلِّ","for everyone","فِى ذَٰلِكَ لَـَٔايَـٰتٍۢ","صَبَّارٍۢ شَكُورٍۢ",31],["31:32:20",414,"كُلُّ","every","يَجْحَدُ بِـَٔايَـٰتِنَآ إِلَّا","خَتَّارٍۢ كَفُورٍۢ",31],["32:7:3",415,"كُلَّ","every","ٱلَّذِىٓ أَحْسَنَ","شَىْءٍ خَلَقَهُۥ ۖ وَبَدَأَ",31],["32:13:4",416,"كُلَّ","every","وَلَوْ شِئْنَا لَـَٔاتَيْنَا","نَفْسٍ هُدَىٰهَا وَلَـٰكِنْ",31],["32:20:6",416,"كُلَّمَآ","Every time","فَسَقُوا۟ فَمَأْوَىٰهُمُ ٱلنَّارُ ۖ","أَرَادُوٓا۟ أَن يَخْرُجُوا۟",630],["33:27:11",421,"كُلِّ","every","وَكَانَ ٱللَّهُ عَلَىٰ","شَىْءٍ