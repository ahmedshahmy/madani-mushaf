[["2:167:17",25,"حَسَرَٰتٍ","(as) regrets","يُرِيهِمُ ٱللَّهُ أَعْمَـٰلَهُمْ","عَلَيْهِمْ ۖ وَمَا هُم",1057],["3:156:27",70,"حَسْرَةًۭ","a regret","لِيَجْعَلَ ٱللَّهُ ذَٰلِكَ","فِى قُلُوبِهِمْ ۗ وَٱللَّهُ",1057],["6:31:13",131,"يَـٰحَسْرَتَنَا","Oh! Our regret","ٱلسَّاعَةُ بَغْتَةًۭ قَالُوا۟","عَلَىٰ مَا فَرَّطْنَا",3200],["8:36:14",181,"حَسْرَةًۭ","a regret","ثُمَّ تَكُونُ عَلَيْهِمْ","ثُمَّ يُغْلَبُونَ ۗ وَٱلَّذِينَ",1057],["17:29:13",285,"مَّحْسُورًا","insolvent","ٱلْبَسْطِ فَتَقْعُدَ مَلُومًۭا","",3913],["19:39:3",308,"ٱلْحَسْرَةِ","(of) the Regret","وَأَنذِرْهُمْ يَوْمَ","إِذْ قُضِىَ ٱلْأَمْرُ",1057],["21:19:13",323,"يَسْتَحْسِرُونَ","they tire","عَنْ عِبَادَتِهِۦ وَلَا","",4660],["35:8:20",435,"حَسَرَٰتٍ ۚ","(in) regrets","تَذْهَبْ نَفْسُكَ عَلَيْهِمْ","إِنَّ ٱللَّهَ عَلِيمٌۢ",1057],["36:30:1",442,"يَـٰحَسْرَةً","Alas","","عَلَى ٱلْعِبَادِ ۚ مَا",1057],["39:56:4",464,"يَـٰحَسْرَتَىٰ","Oh! My regret","أَن تَقُولَ نَفْسٌۭ","عَلَىٰ مَا فَرَّطتُ",3201],["67:4:10",562,"حَسِيرٌۭ","(is) fatigued","ٱلْبَصَرُ خَاسِئًۭا وَهُوَ","",3198],["69:50:2",568,"لَحَسْرَةٌ","(is) surely a regret","وَإِنَّهُۥ","عَلَى ٱلْكَـٰفِرِينَ",1057]]