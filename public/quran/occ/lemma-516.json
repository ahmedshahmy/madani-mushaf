[["3:44:9",55,"لَدَيْهِمْ","with them","إِلَيْكَ ۚ وَمَا كُنتَ","إِذْ يُلْقُونَ أَقْلَـٰمَهُمْ",516],["3:44:18",55,"لَدَيْهِمْ","with them","مَرْيَمَ وَمَا كُنتَ","إِذْ يَخْتَصِمُونَ",516],["12:54:12",242,"لَدَيْنَا","with us","قَالَ إِنَّكَ ٱلْيَوْمَ","مَكِينٌ أَمِينٌۭ",516],["12:102:9",247,"لَدَيْهِمْ","with them","إِلَيْكَ ۖ وَمَا كُنتَ","إِذْ أَجْمَعُوٓا۟ أَمْرَهُمْ",516],["18:91:5",303,"لَدَيْهِ","(was) with him","وَقَدْ أَحَطْنَا بِمَا","خُبْرًۭا",516],["23:53:8",345,"لَدَيْهِمْ","they have","كُلُّ حِزْبٍۭ بِمَا","فَرِحُونَ",516],["23:62:6",346,"وَلَدَيْنَا","and with Us","نَفْسًا إِلَّا وُسْعَهَا ۖ","كِتَـٰبٌۭ يَنطِقُ بِٱلْحَقِّ ۚ",516],["27:10:18",377,"لَدَىَّ","(in) My presence","إِنِّى لَا يَخَافُ","ٱلْمُرْسَلُونَ",516],["30:32:10",407,"لَدَيْهِمْ","they have","كُلُّ حِزْبٍۭ بِمَا","فَرِحُونَ",516],["36:32:5",442,"لَّدَيْنَا","before Us","كُلٌّۭ لَّمَّا جَمِيعٌۭ","مُحْضَرُونَ",516],["36:53:9",443,"لَّدَيْنَا","before Us","فَإِذَا هُمْ جَمِيعٌۭ","مُحْضَرُونَ",516],["43:4:5",489,"لَدَيْنَا","with Us","فِىٓ أُمِّ ٱلْكِتَـٰبِ","لَعَلِىٌّ حَكِيمٌ",516],["43:80:10",495,"لَدَيْهِمْ","with them","وَنَجْوَىٰهُم ۚ بَلَىٰ وَرُسُلُنَا","يَكْتُبُونَ",516],["50:18:6",519,"لَدَيْهِ","with him","مِن قَوْلٍ إِلَّا","رَقِيبٌ عَتِيدٌۭ",516],["50:23:5",519,"لَدَىَّ","(is) with me","قَرِينُهُۥ هَـٰذَا مَا","عَتِيدٌ",516],["50:28:4",519,"لَدَىَّ","(in) My presence","قَالَ لَا تَخْتَصِمُوا۟","وَقَدْ قَدَّمْتُ إِلَيْكُم",516],["50:29:4",519,"لَدَىَّ","with Me","مَا يُبَدَّلُ ٱلْقَوْلُ","وَمَآ أَنَا۠ بِظَلَّـٰمٍۢ",516],["50:35:5",519,"وَلَدَيْنَا","and with Us","مَّا يَشَآءُونَ فِيهَا","مَزِيدٌۭ",516],["72:28:9",573,"لَدَيْهِمْ","(is) with them","رَبِّهِمْ وَأَحَاطَ بِمَا","وَأَحْصَىٰ كُلَّ شَىْءٍ",516],["73:12:2",574,"لَدَيْنَآ","with Us","إِنَّ","أَنكَالًۭا وَجَحِيمًۭا",516]]