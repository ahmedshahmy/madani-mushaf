[["2:185:1",28,"شَهْرُ","Month","","رَمَضَانَ ٱلَّذِىٓ أُنزِلَ",482],["2:185:16",28,"ٱلشَّهْرَ","the month","فَمَن شَهِدَ مِنكُمُ","فَلْيَصُمْهُ ۖ وَمَن كَانَ",482],["2:194:1",30,"ٱلشَّهْرُ","The month","","ٱلْحَرَامُ بِٱلشَّهْرِ ٱلْحَرَامِ",482],["2:194:3",30,"بِٱلشَّهْرِ","(is) for the month","ٱلشَّهْرُ ٱلْحَرَامُ","ٱلْحَرَامِ وَٱلْحُرُمَـٰتُ قِصَاصٌۭ ۚ",482],["2:197:2",31,"أَشْهُرٌۭ","(are) months","ٱلْحَجُّ","مَّعْلُومَـٰتٌۭ ۚ فَمَن فَرَضَ",482],["2:217:3",34,"ٱلشَّهْرِ","the month","يَسْـَٔلُونَكَ عَنِ","ٱلْحَرَامِ قِتَالٍۢ فِيهِ ۖ",482],["2:226:7",36,"أَشْهُرٍۢ ۖ","months","نِّسَآئِهِمْ تَرَبُّصُ أَرْبَعَةِ","فَإِن فَآءُو فَإِنَّ",482],["2:234:9",38,"أَشْهُرٍۢ","months","يَتَرَبَّصْنَ بِأَنفُسِهِنَّ أَرْبَعَةَ","وَعَشْرًۭا ۖ فَإِذَا بَلَغْنَ",482],["4:92:52",93,"شَهْرَيْنِ","(for) two months","لَّمْ يَجِدْ فَصِيَامُ","مُتَتَابِعَيْنِ تَوْبَةًۭ مِّنَ",482],["5:2:9",106,"ٱلشَّهْرَ","the month","شَعَـٰٓئِرَ ٱللَّهِ وَلَا","ٱلْحَرَامَ وَلَا ٱلْهَدْىَ",482],["5:97:8",124,"وَٱلشَّهْرَ","and the month(s)","ٱلْحَرَامَ قِيَـٰمًۭا لِّلنَّاسِ","ٱلْحَرَامَ وَٱلْهَدْىَ وَٱلْقَلَـٰٓئِدَ ۚ",482],["9:2:5",187,"أَشْهُرٍۢ","months","فِى ٱلْأَرْضِ أَرْبَعَةَ","وَٱعْلَمُوٓا۟ أَنَّكُمْ غَيْرُ",482],["9:5:3",187,"ٱلْأَشْهُرُ","the sacred months","فَإِذَا ٱنسَلَخَ","ٱلْحُرُمُ فَٱقْتُلُوا۟ ٱلْمُشْرِكِينَ",482],["9:36:3",192,"ٱلشُّهُورِ","(of) the months","إِنَّ عِدَّةَ","عِندَ ٱللَّهِ ٱثْنَا",482],["9:36:8",192,"شَهْرًۭا","months","ٱللَّهِ ٱثْنَا عَشَرَ","فِى كِتَـٰبِ ٱللَّهِ",482],["34:12:4",429,"شَهْرٌۭ","(was) a month","وَلِسُلَيْمَـٰنَ ٱلرِّيحَ غُدُوُّهَا","وَرَوَاحُهَا شَهْرٌۭ ۖ وَأَسَلْنَا",482],["34:12:6",429,"شَهْرٌۭ ۖ","(was) a month","غُدُوُّهَا شَهْرٌۭ وَرَوَاحُهَا","وَأَسَلْنَا لَهُۥ عَيْنَ",482],["46:15:13",504,"شَهْرًا ۚ","month(s)","وَحَمْلُهُۥ وَفِصَـٰلُهُۥ ثَلَـٰثُونَ","حَتَّىٰٓ إِذَا بَلَغَ",482],["58:4:5",542,"شَهْرَيْنِ","(for) two months","لَّمْ يَجِدْ فَصِيَامُ","مُتَتَابِعَيْنِ مِن قَبْلِ",482],["65:4:11",558,"أَشْهُرٍۢ","months","ٱرْتَبْتُمْ فَعِدَّتُهُنَّ ثَلَـٰثَةُ","وَٱلَّـٰٓـِٔى لَمْ يَحِضْنَ ۚ",482],["97:3:6",598,"شَهْرٍۢ","month(s)","خَيْرٌۭ مِّنْ أَلْفِ","",482]]