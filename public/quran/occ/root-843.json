[["2:222:3",35,"ٱلْمَحِيضِ ۖ","[the] menstruation","وَيَسْـَٔلُونَكَ عَنِ","قُلْ هُوَ أَذًۭى",1884],["2:222:10",35,"ٱلْمَحِيضِ ۖ","(their) [the] menstruation","فَٱعْتَزِلُوا۟ ٱلنِّسَآءَ فِى","وَلَا تَقْرَبُوهُنَّ حَتَّىٰ",1884],["65:4:4",558,"ٱلْمَحِيضِ","the menstruation","وَٱلَّـٰٓـِٔى يَئِسْنَ مِنَ","مِن نِّسَآئِكُمْ إِنِ",1884],["65:4:14",558,"يَحِضْنَ ۚ","[they] menstruated","أَشْهُرٍۢ وَٱلَّـٰٓـِٔى لَمْ","وَأُو۟لَـٰتُ ٱلْأَحْمَالِ أَجَلُهُنَّ",4608]]