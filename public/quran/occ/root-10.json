230,"لَشَىْءٌ","(is) surely a thing","شَيْخًا ۖ إِنَّ هَـٰذَا","عَجِيبٌۭ",41],["11:85:9",231,"أَشْيَآءَهُمْ","(of) their things","وَلَا تَبْخَسُوا۟ ٱلنَّاسَ","وَلَا تَعْثَوْا۟ فِى",41],["11:87:16",231,"نَشَـٰٓؤُا۟ ۖ","we will","فِىٓ أَمْوَٰلِنَا مَا","إِنَّكَ لَأَنتَ ٱلْحَلِيمُ",54],["11:101:16",233,"شَىْءٍۢ","thing","دُونِ ٱللَّهِ مِن","لَّمَّا جَآءَ أَمْرُ",41],["11:107:9",233,"شَآءَ","what your Lord wills","وَٱلْأَرْضُ إِلَّا مَا","رَبُّكَ ۚ إِنَّ رَبَّكَ",54],["11:108:14",233,"شَآءَ","what your Lord wills","وَٱلْأَرْضُ إِلَّا مَا","رَبُّكَ ۖ عَطَآءً غَيْرَ",54],["11:118:2",235,"شَآءَ","your Lord (had) willed","وَلَوْ","رَبُّكَ لَجَعَلَ ٱلنَّاسَ",54],["12:38:14",240,"شَىْءٍۢ ۚ","thing","نُّشْرِكَ بِٱللَّهِ مِن","ذَٰلِكَ مِن فَضْلِ",41],["12:56:9",242,"يَشَآءُ ۚ","he willed","يَتَبَوَّأُ مِنْهَا حَيْثُ","نُصِيبُ بِرَحْمَتِنَا مَن",54],["12:56:13",242,"نَّشَآءُ ۖ","We will","نُصِيبُ بِرَحْمَتِنَا مَن","وَلَا نُضِيعُ أَجْرَ",54],["12:67:18",243,"شَىْءٍ ۖ","thing","مِّنَ ٱللَّهِ مِن","إِنِ ٱلْحُكْمُ إِلَّا",41],["12:68:14",243,"شَىْءٍ","thing","مِّنَ ٱللَّهِ مِن","إِلَّا حَاجَةًۭ فِى",41],["12:76:23",244,"يَشَآءَ","Allah willed","ٱلْمَلِكِ إِلَّآ أَن","ٱللَّهُ ۚ نَرْفَعُ دَرَجَـٰتٍۢ",54],["12:76:28",244,"نَّشَآءُ ۗ","We will","نَرْفَعُ دَرَجَـٰتٍۢ مَّن","وَفَوْقَ كُلِّ ذِى",54],["12:99:12",247,"شَآءَ","Allah wills","ٱدْخُلُوا۟ مِصْرَ إِن","ٱللَّهُ ءَامِنِينَ",54],["12:100:42",247,"يَشَآءُ ۚ","He wills","رَبِّى لَطِيفٌۭ لِّمَا","إِنَّهُۥ هُوَ ٱلْعَلِيمُ",54],["12:110:13",248,"نَّشَآءُ ۖ","We willed","نَصْرُنَا فَنُجِّىَ مَن","وَلَا يُرَدُّ بَأْسُنَا",54],["12:111:19",248,"شَىْءٍۢ","things","يَدَيْهِ وَتَفْصِيلَ كُلِّ","وَهُدًۭى وَرَحْمَةًۭ لِّقَوْمٍۢ",41],["13:8:13",250,"شَىْءٍ","thing","وَمَا تَزْدَادُ ۖ وَكُلُّ","عِندَهُۥ بِمِقْدَارٍ",41],["13:13:12",250,"يَشَآءُ","He wills","فَيُصِيبُ بِهَا مَن","وَهُمْ يُجَـٰدِلُونَ فِى",54],["13:14:11",251,"بِشَىْءٍ","with a thing","لَا يَسْتَجِيبُونَ لَهُم","إِلَّا كَبَـٰسِطِ كَفَّيْهِ",41],["13:16:42",251,"شَىْءٍ