[["2:160:9",24,"وَأَنَا","and I (am)","فَأُو۟لَـٰٓئِكَ أَتُوبُ عَلَيْهِمْ ۚ","ٱلتَّوَّابُ ٱلرَّحِيمُ",180],["2:258:21",43,"أَنَا۠","I","يُحْىِۦ وَيُمِيتُ قَالَ","أُحْىِۦ وَأُمِيتُ ۖ قَالَ",180],["3:81:30",60,"وَأَنَا۠","and I (am)","أَقْرَرْنَا ۚ قَالَ فَٱشْهَدُوا۟","مَعَكُم مِّنَ ٱلشَّـٰهِدِينَ",180],["5:28:7",112,"أَنَا۠","will I","يَدَكَ لِتَقْتُلَنِى مَآ","بِبَاسِطٍۢ يَدِىَ إِلَيْكَ",180],["6:56:19",134,"أَنَا۠","I (would be)","ضَلَلْتُ إِذًۭا وَمَآ","مِنَ ٱلْمُهْتَدِينَ",180],["6:79:10",137,"أَنَا۠","I (am)","وَٱلْأَرْضَ حَنِيفًۭا ۖ وَمَآ","مِنَ ٱلْمُشْرِكِينَ",180],["6:104:13",141,"أَنَا۠","(am) I","عَمِىَ فَعَلَيْهَا ۚ وَمَآ","عَلَيْكُم بِحَفِيظٍۢ",180],["6:163:6",150,"وَأَنَا۠","And I am","لَهُۥ ۖ وَبِذَٰلِكَ أُمِرْتُ","أَوَّلُ ٱلْمُسْلِمِينَ",180],["7:12:9",152,"أَنَا۠","I am","إِذْ أَمَرْتُكَ ۖ قَالَ","خَيْرٌۭ مِّنْهُ خَلَقْتَنِى",180],["7:68:4",159,"وَأَنَا۠","and I am","أُبَلِّغُكُمْ رِسَـٰلَـٰتِ رَبِّى","لَكُمْ نَاصِحٌ أَمِينٌ",180],["7:143:39",167,"وَأَنَا۠","and I am","سُبْحَـٰنَكَ تُبْتُ إِلَيْكَ","أَوَّلُ ٱلْمُؤْمِنِينَ",180],["7:188:23",175,"أَنَا۠","(am) I","مَسَّنِىَ ٱلسُّوٓءُ ۚ إِنْ","إِلَّا نَذِيرٌۭ وَبَشِيرٌۭ",180],["10:41:12",213,"وَأَنَا۠","and I am","بَرِيٓـُٔونَ مِمَّآ أَعْمَلُ","بَرِىٓءٌۭ مِّمَّا تَعْمَلُونَ",180],["10:90:25",219,"وَأَنَا۠","and I am","بِهِۦ بَنُوٓا۟ إِسْرَٰٓءِيلَ","مِنَ ٱلْمُسْلِمِينَ",180],["10:108:20",221,"أَنَا۠","And I am not","يَضِلُّ عَلَيْهَا ۖ وَمَآ","عَلَيْكُم بِوَكِيلٍۢ",180],["11:29:12",225,"أَنَا۠","I am","عَلَى ٱللَّهِ ۚ وَمَآ","بِطَارِدِ ٱلَّذِينَ ءَامَنُوٓا۟ ۚ",180],["11:35:9",225,"وَأَنَا۠","but I am","ٱفْتَرَيْتُهُۥ فَعَلَىَّ إِجْرَامِى","بَرِىٓءٌۭ مِّمَّا تُجْرِمُونَ",180],["11:72:4",230,"وَأَنَا۠","while I am","قَالَتْ يَـٰوَيْلَتَىٰٓ ءَأَلِدُ","عَجُوزٌۭ وَهَـٰذَا بَعْلِى",180],["11:86:9",231,"أَنَا۠","I am","كُنتُم مُّؤْمِنِينَ ۚ وَمَآ","عَلَيْكُم بِحَفِيظٍۢ",180],["12:45:8",241,"أَنَا۠","I","وَٱدَّكَرَ بَعْدَ أُمَّةٍ","أُنَبِّئُكُم بِتَأْوِيلِهِۦ فَأَرْسِلُونِ",180],["12:51:23",241,"أَنَا۠","I","ٱلْـَٔـٰنَ حَصْحَصَ ٱلْحَقُّ","رَٰوَدتُّهُۥ عَن نَّفْسِهِۦ",180],["12:59:15",242,"وَأَنَا۠","and that I am","أَنِّىٓ أُوفِى ٱلْكَيْلَ","خَيْرُ ٱلْمُنزِلِينَ",180],["12:69:10",243,"أَنَا۠","[I] am","أَخَاهُ ۖ قَالَ إِنِّىٓ","أَخُوكَ فَلَا تَبْتَئِسْ",180],["12:72:10",244,"وَأَنَا۠","and I","بِهِۦ حِمْلُ بَعِيرٍۢ","بِهِۦ زَعِيمٌۭ",180],["12:90:6",246,"أَنَا۠","I am","لَأَنتَ يُوسُفُ ۖ قَالَ","يُوسُفُ وَهَـٰذَآ أَخِى ۖ",180],["12:108:9",248,"أَنَا۠","I","ٱللَّهِ ۚ عَلَىٰ بَصِيرَةٍ","وَمَنِ ٱتَّبَعَنِى ۖ وَسُبْحَـٰنَ",180],["12:108:15",248,"أَنَا۠","I am","وَسُبْحَـٰنَ ٱللَّهِ وَمَآ","مِنَ ٱلْمُشْرِكِينَ",180],["14:22:29",258,"أَنَا۠","(can) I","وَلُومُوٓا۟ أَنفُسَكُم ۖ مَّآ","بِمُصْرِخِكُمْ وَمَآ أَنتُم",180],["15:49:4",264,"أَنَا","I am","۞ نَبِّئْ عِبَادِىٓ أَنِّىٓ","ٱلْغَفُورُ ٱلرَّحِيمُ",180],["15:89:3",266,"أَنَا","[I] am","وَقُلْ إِنِّىٓ","ٱلنَّذِيرُ ٱلْمُبِينُ",180],["16:2:17",267,"أَنَا۠","Me","لَآ إِلَـٰهَ إِلَّآ","فَٱتَّقُونِ",180],["18:34:8",297,"أَنَا۠","I am","لِصَـٰحِبِهِۦ وَهُوَ يُحَاوِرُهُۥٓ","أَكْثَرُ مِنكَ مَالًۭا",180],["18:39:15",298,"أَنَا۠","(me)","بِٱللَّهِ ۚ إِن تَرَنِ","أَقَلَّ مِنكَ مَالًۭا",180],["18:110:3",304,"أَنَا۠","I","قُلْ إِنَّمَآ","بَشَرٌۭ مِّثْلُكُمْ يُوحَىٰٓ",180],["19:19:3",306,"أَنَا۠","I am","قَالَ إِنَّمَآ","رَسُولُ رَبِّكِ لِأَهَبَ",180],["20:12:2",312,"أَنَا۠","I Am","إِنِّىٓ","رَبُّكَ فَٱخْلَعْ نَعْلَيْكَ ۖ",180],["20:13:1",313,"وَأَنَا","And I","","ٱخْتَرْتُكَ فَٱسْتَمِعْ لِمَا",180],["20:14:2",313,"أَنَا","I Am","إِنَّنِىٓ","ٱللَّهُ لَآ إِلَـٰهَ",180],["20:14:7",313,"أَنَا۠","I","لَآ إِلَـٰهَ إِلَّآ","فَٱعْبُدْنِى وَأَقِمِ ٱلصَّلَوٰةَ",180],["21:25:14",324,"أَنَا۠","Me","لَآ إِلَـٰهَ إِلَّآ","فَٱعْبُدُونِ",180],["21:56:9",326,"وَأَنَا۠","and I am","وَٱلْأَرْضِ ٱلَّذِى فَطَرَهُنَّ","عَلَىٰ ذَٰلِكُم مِّنَ",180],["21:92:6",330,"وَأَنَا۠","and I Am","أُمَّتُكُمْ أُمَّةًۭ وَٰحِدَةًۭ","رَبُّكُمْ فَٱعْبُدُونِ",180],["22:49:5",338,"أَنَا۠","I am","يَـٰٓأَيُّهَا ٱلنَّاسُ إِنَّمَآ","لَكُمْ نَذِيرٌۭ مُّبِينٌۭ",180],["23:52:6",345,"وَأَنَا۠","And I Am","أُمَّتُكُمْ أُمَّةًۭ وَٰحِدَةًۭ","رَبُّكُمْ فَٱتَّقُونِ",180],["26:20:4",368,"وَأَنَا۠","I","قَالَ فَعَلْتُهَآ إِذًۭا","مِنَ ٱلضَّآلِّينَ",180],["26:114:2",372,"أَنَا۠","I am","وَمَآ","بِطَارِدِ ٱلْمُؤْمِنِينَ",180],["26:115:2",372,"أَنَا۠","I am","إِنْ","إِلَّا نَذِيرٌۭ مُّبِينٌۭ",180],["27:9:3",377,"أَنَا","I Am","يَـٰمُوسَىٰٓ إِنَّهُۥٓ","ٱللَّهُ ٱلْعَزِيزُ ٱلْحَكِيمُ",180],["27:39:5",380,"أَنَا۠","I","عِفْرِيتٌۭ مِّنَ ٱلْجِنِّ","ءَاتِيكَ بِهِۦ قَبْلَ",180],["27:40:7",380,"أَنَا۠","I","عِلْمٌۭ مِّنَ ٱلْكِتَـٰبِ","ءَاتِيكَ بِهِۦ قَبْلَ",180],["27:92:13",385,"أَنَا۠","I am","ضَلَّ فَقُلْ إِنَّمَآ","مِنَ ٱلْمُنذِرِينَ",180],["28:30:16",389,"أَنَا","I Am","أَن يَـٰمُوسَىٰٓ إِنِّىٓ","ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",180],["29:50:14",402,"أَنَا۠","I (am)","عِندَ ٱللَّهِ وَإِنَّمَآ","نَذِيرٌۭ مُّبِينٌ",180],["38:65:3",457,"أَنَا۠","I am","قُلْ إِنَّمَآ","مُنذِرٌۭ ۖ وَمَا مِنْ",180],["38:70:6",457,"أَنَا۠","I am","إِلَىَّ إِلَّآ أَنَّمَآ","نَذِيرٌۭ مُّبِينٌ",180],["38:76:2",457,"أَنَا۠","I am","قَالَ","خَيْرٌۭ مِّنْهُ ۖ خَلَقْتَنِى",180],["38:86:8",458,"أَنَا۠","I am","مِنْ أَجْرٍۢ وَمَآ","مِنَ ٱلْمُتَكَلِّفِينَ",180],["40:42:11",472,"وَأَنَا۠","and I","لِى بِهِۦ عِلْمٌۭ","أَدْعُوكُمْ إِلَى ٱلْعَزِيزِ",180],["41:6:3",477,"أَنَا۠","I am","قُلْ إِنَّمَآ","بَشَرٌۭ مِّثْلُكُمْ يُوحَىٰٓ",180],["43:52:2",493,"أَنَا۠","am I","أَمْ","خَيْرٌۭ مِّنْ هَـٰذَا",180],["43:81:6",495,"فَأَنَا۠","Then, I","كَانَ لِلرَّحْمَـٰنِ وَلَدٌۭ","أَوَّلُ ٱلْعَـٰبِدِينَ",180],["46:9:21",503,"أَنَا۠","I am","يُوحَىٰٓ إِلَىَّ وَمَآ","إِلَّا نَذِيرٌۭ مُّبِينٌۭ",180],["50:29:6",519,"أَنَا۠","I Am","ٱلْقَوْلُ لَدَىَّ وَمَآ","بِظَلَّـٰمٍۢ لِّلْعَبِيدِ",180],["58:21:4",544,"أَنَا۠","I","كَتَبَ ٱللَّهُ لَأَغْلِبَنَّ","وَرُسُلِىٓ ۚ إِنَّ ٱللَّهَ",180],["60:1:36",549,"وَأَنَا۠","but I Am","تُسِرُّونَ إِلَيْهِم بِٱلْمَوَدَّةِ","أَعْلَمُ بِمَآ أَخْفَيْتُمْ",180],["67:26:7",563,"أَنَا۠","I am","عِندَ ٱللَّهِ وَإِنَّمَآ","نَذِيرٌۭ مُّبِينٌۭ",180],["79:24:2",584,"أَنَا۠","I am","فَقَالَ","رَبُّكُمُ ٱلْأَعْلَىٰ",180],["109:4:2",603,"أَنَا۠","I am","وَلَآ","عَابِدٌۭ مَّا عَبَدتُّمْ",180]]