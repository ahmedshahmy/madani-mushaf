[["7:143:30",167,"وَخَرَّ","and fell down","لِلْجَبَلِ جَعَلَهُۥ دَكًّۭا","مُوسَىٰ صَعِقًۭا ۚ فَلَمَّآ",749],["12:100:5",247,"وَخَرُّوا۟","and they fell down","أَبَوَيْهِ عَلَى ٱلْعَرْشِ","لَهُۥ سُجَّدًۭا ۖ وَقَالَ",749],["16:26:11",269,"فَخَرَّ","so fell","بُنْيَـٰنَهُم مِّنَ ٱلْقَوَاعِدِ","عَلَيْهِمُ ٱلسَّقْفُ مِن",749],["17:107:16",293,"يَخِرُّونَ","they fall","إِذَا يُتْلَىٰ عَلَيْهِمْ","لِلْأَذْقَانِ سُجَّدًۭا",749],["17:109:1",293,"وَيَخِرُّونَ","And they fall","","لِلْأَذْقَانِ يَبْكُونَ وَيَزِيدُهُمْ",749],["19:58:27",309,"خَرُّوا۟","they fell","عَلَيْهِمْ ءَايَـٰتُ ٱلرَّحْمَـٰنِ","سُجَّدًۭا وَبُكِيًّۭا ۩",749],["19:90:7",311,"وَتَخِرُّ","and collapse","مِنْهُ وَتَنشَقُّ ٱلْأَرْضُ","ٱلْجِبَالُ هَدًّا",749],["22:31:10",336,"خَرَّ","he had fallen","يُشْرِكْ بِٱللَّهِ فَكَأَنَّمَا","مِنَ ٱلسَّمَآءِ فَتَخْطَفُهُ",749],["25:73:7",366,"يَخِرُّوا۟","fall","بِـَٔايَـٰتِ رَبِّهِمْ لَمْ","عَلَيْهَا صُمًّۭا وَعُمْيَانًۭا",749],["32:15:8",416,"خَرُّوا۟","fall down","إِذَا ذُكِّرُوا۟ بِهَا","سُجَّدًۭا وَسَبَّحُوا۟ بِحَمْدِ",749],["34:14:15",429,"خَرَّ","he fell down","تَأْكُلُ مِنسَأَتَهُۥ ۖ فَلَمَّا","تَبَيَّنَتِ ٱلْجِنُّ أَن",749],["38:24:30",454,"وَخَرَّ","and fell down","فَتَنَّـٰهُ فَٱسْتَغْفَرَ رَبَّهُۥ","رَاكِعًۭا وَأَنَابَ ۩",749]]