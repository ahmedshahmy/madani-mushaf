[["2:75:13",11,"يُحَرِّفُونَهُۥ","they distort it","كَلَـٰمَ ٱللَّهِ ثُمَّ","مِنۢ بَعْدِ مَا",1680],["4:46:4",86,"يُحَرِّفُونَ","they distort","مِّنَ ٱلَّذِينَ هَادُوا۟","ٱلْكَلِمَ عَن مَّوَاضِعِهِۦ",1680],["5:13:8",109,"يُحَرِّفُونَ","They distort","وَجَعَلْنَا قُلُوبَهُمْ قَـٰسِيَةًۭ ۖ","ٱلْكَلِمَ عَن مَّوَاضِعِهِۦ ۙ",1680],["5:41:27",114,"يُحَرِّفُونَ","They distort","ءَاخَرِينَ لَمْ يَأْتُوكَ ۖ","ٱلْكَلِمَ مِنۢ بَعْدِ",1680],["8:16:6",178,"مُتَحَرِّفًۭا","(as) a strategy","يَوْمَئِذٍۢ دُبُرَهُۥٓ إِلَّا","لِّقِتَالٍ أَوْ مُتَحَيِّزًا",3867],["22:11:7",333,"حَرْفٍۢ ۖ","an edge","يَعْبُدُ ٱللَّهَ عَلَىٰ","فَإِنْ أَصَابَهُۥ خَيْرٌ",3195]]