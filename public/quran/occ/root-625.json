[["3:139:2",67,"تَهِنُوا۟","weaken","وَلَا","وَلَا تَحْزَنُوا۟ وَأَنتُمُ",1411],["3:146:9",68,"وَهَنُوا۟","they lost heart","رِبِّيُّونَ كَثِيرٌۭ فَمَا","لِمَآ أَصَابَهُمْ فِى",1411],["4:104:2",95,"تَهِنُوا۟","be weak","وَلَا","فِى ٱبْتِغَآءِ ٱلْقَوْمِ ۖ",1411],["8:18:4",179,"مُوهِنُ","one who makes weak","ذَٰلِكُمْ وَأَنَّ ٱللَّهَ","كَيْدِ ٱلْكَـٰفِرِينَ",3888],["19:4:4",305,"وَهَنَ","(have) weakened","قَالَ رَبِّ إِنِّى","ٱلْعَظْمُ مِنِّى وَٱشْتَعَلَ",1411],["29:41:13",401,"أَوْهَنَ","the weakest","ٱتَّخَذَتْ بَيْتًۭا ۖ وَإِنَّ","ٱلْبُيُوتِ لَبَيْتُ ٱلْعَنكَبُوتِ ۖ",3049],["31:14:6",412,"وَهْنًا","(in) weakness","بِوَٰلِدَيْهِ حَمَلَتْهُ أُمُّهُۥ","عَلَىٰ وَهْنٍۢ وَفِصَـٰلُهُۥ",2710],["31:14:8",412,"وَهْنٍۢ","weakness","أُمُّهُۥ وَهْنًا عَلَىٰ","وَفِصَـٰلُهُۥ فِى عَامَيْنِ",2710],["47:35:2",510,"تَهِنُوا۟","weaken","فَلَا","وَتَدْعُوٓا۟ إِلَى ٱلسَّلْمِ",1411]]