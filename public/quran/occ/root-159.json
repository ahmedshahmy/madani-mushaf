[["2:35:3",6,"ٱسْكُنْ","Dwell","وَقُلْنَا يَـٰٓـَٔادَمُ","أَنتَ وَزَوْجُكَ ٱلْجَنَّةَ",638],["2:61:40",9,"وَٱلْمَسْكَنَةُ","and the misery","وَضُرِبَتْ عَلَيْهِمُ ٱلذِّلَّةُ","وَبَآءُو بِغَضَبٍۢ مِّنَ",2465],["2:83:15",12,"وَٱلْمَسَـٰكِينِ","and the needy","وَذِى ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ","وَقُولُوا۟ لِلنَّاسِ حُسْنًۭا",457],["2:177:26",27,"وَٱلْمَسَـٰكِينَ","and the needy","ذَوِى ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ","وَٱبْنَ ٱلسَّبِيلِ وَٱلسَّآئِلِينَ",457],["2:184:19",28,"مِسْكِينٍۢ ۖ","a poor","يُطِيقُونَهُۥ فِدْيَةٌۭ طَعَامُ","فَمَن تَطَوَّعَ خَيْرًۭا",457],["2:215:12",33,"وَٱلْمَسَـٰكِينِ","and the needy","فَلِلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَ وَٱلْيَتَـٰمَىٰ","وَٱبْنِ ٱلسَّبِيلِ ۗ وَمَا",457],["2:248:11",40,"سَكِينَةٌۭ","(is) tranquility","يَأْتِيَكُمُ ٱلتَّابُوتُ فِيهِ","مِّن رَّبِّكُمْ وَبَقِيَّةٌۭ",1228],["3:112:20",64,"ٱلْمَسْكَنَةُ ۚ","the poverty","ٱللَّهِ وَضُرِبَتْ عَلَيْهِمُ","ذَٰلِكَ بِأَنَّهُمْ كَانُوا۟",2465],["4:8:7",78,"وَٱلْمَسَـٰكِينُ","and the poor","أُو۟لُوا۟ ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ","فَٱرْزُقُوهُم مِّنْهُ وَقُولُوا۟",457],["4:36:12",84,"وَٱلْمَسَـٰكِينِ","and the needy","وَبِذِى ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ","وَٱلْجَارِ ذِى ٱلْقُرْبَىٰ",457],["5:89:15",122,"مَسَـٰكِينَ","needy people","فَكَفَّـٰرَتُهُۥٓ إِطْعَامُ عَشَرَةِ","مِنْ أَوْسَطِ مَا",457],["5:95:30",123,"مَسَـٰكِينَ","needy people","أَوْ كَفَّـٰرَةٌۭ طَعَامُ","أَوْ عَدْلُ ذَٰلِكَ",457],["6:13:3",129,"سَكَنَ","dwells","۞ وَلَهُۥ مَا","فِى ٱلَّيْلِ وَٱلنَّهَارِ ۚ",638],["6:96:5",140,"سَكَنًۭا","(for) rest","ٱلْإِصْبَاحِ وَجَعَلَ ٱلَّيْلَ","وَٱلشَّمْسَ وَٱلْقَمَرَ حُسْبَانًۭا ۚ",1986],["7:19:2",152,"ٱسْكُنْ","Dwell","وَيَـٰٓـَٔادَمُ","أَنتَ وَزَوْجُكَ ٱلْجَنَّةَ",638],["7:161:4",171,"ٱسْكُنُوا۟","Live","وَإِذْ قِيلَ لَهُمُ","هَـٰذِهِ ٱلْقَرْيَةَ وَكُلُوا۟",638],["7:189:10",175,"لِيَسْكُنَ","that he might live","وَجَعَلَ مِنْهَا زَوْجَهَا","إِلَيْهَا ۖ فَلَمَّا تَغَشَّىٰهَا",638],["8:41:13",182,"وَٱلْمَسَـٰكِينِ","and the needy","وَلِذِى ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ","وَٱبْنِ ٱلسَّبِيلِ إِن",457],["9:24:14",190,"وَمَسَـٰكِنُ","and the dwellings","وَتِجَـٰرَةٌۭ تَخْشَوْنَ كَسَادَهَا","تَرْضَوْنَهَآ أَحَبَّ إِلَيْكُم",733],["9:26:4",190,"سَكِينَتَهُۥ","His tranquility","ثُمَّ أَنزَلَ ٱللَّهُ","عَلَىٰ رَسُولِهِۦ وَعَلَى",1228],["9:40:26",193,"سَكِينَتَهُۥ","His tranquility","مَعَنَا ۖ فَأَنزَلَ ٱللَّهُ","عَلَيْهِ وَأَيَّدَهُۥ بِجُنُودٍۢ",1228],["9:60:4",196,"وَٱلْمَسَـٰكِينِ","and the needy","۞ إِنَّمَا ٱلصَّدَقَـٰتُ لِلْفُقَرَآءِ","وَٱلْعَـٰمِلِينَ عَلَيْهَا وَٱلْمُؤَلَّفَةِ",457],["9:72:12",198,"وَمَسَـٰكِنَ","and dwellings","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا","طَيِّبَةًۭ فِى جَنَّـٰتِ",733],["9:103:12",203,"سَكَنٌۭ","(are a) reassurance","عَلَيْهِمْ ۖ إِنَّ صَلَوٰتَكَ","لَّهُمْ ۗ وَٱللَّهُ سَمِيعٌ",1986],["10:67:6",216,"لِتَسْكُنُوا۟","that you may rest","جَعَلَ لَكُمُ ٱلَّيْلَ","فِيهِ وَٱلنَّهَارَ مُبْصِرًا ۚ",638],["12:31:13",239,"سِكِّينًۭا","a knife","كُلَّ وَٰحِدَةٍۢ مِّنْهُنَّ","وَقَالَتِ ٱخْرُجْ عَلَيْهِنَّ ۖ",4263],["14:14:1",257,"وَلَنُسْكِنَنَّكُمُ","And surely We will make you dwell","","ٱلْأَرْضَ مِنۢ بَعْدِهِمْ ۚ",1281],["14:37:3",260,"أَسْكَنتُ","[I] have settled","رَّبَّنَآ إِنِّىٓ","مِن ذُرِّيَّتِى بِوَادٍ",1281],["14:45:1",261,"وَسَكَنتُمْ","And you dwelt","","فِى مَسَـٰكِنِ ٱلَّذِينَ",638],["14:45:3",261,"مَسَـٰكِنِ","the dwellings","وَسَكَنتُمْ فِى","ٱلَّذِينَ ظَلَمُوٓا۟ أَنفُسَهُمْ",733],["16:80:6",276,"سَكَنًۭا","a resting place","لَكُم مِّنۢ بُيُوتِكُمْ","وَجَعَلَ لَكُم مِّن",1986],["17:26:5",284,"وَٱلْمِسْكِينَ","and the needy","ذَا ٱلْقُرْبَىٰ حَقَّهُۥ","وَٱبْنَ ٱلسَّبِيلِ وَلَا",457],["17:104:6",292,"ٱسْكُنُوا۟","Dwell","بَعْدِهِۦ لِبَنِىٓ إِسْرَٰٓءِيلَ","ٱلْأَرْضَ فَإِذَا جَآءَ",638],["18:79:4",302,"لِمَسَـٰكِينَ","of (the) poor people","أَمَّا ٱلسَّفِينَةُ فَكَانَتْ","يَعْمَلُونَ فِى ٱلْبَحْرِ",457],["20:128:11",321,"مَسَـٰكِنِهِمْ ۗ","their dwellings","ٱلْقُرُونِ يَمْشُونَ فِى","إِنَّ فِى ذَٰلِكَ",733],["21:13:8",323,"وَمَسَـٰكِنِكُمْ","and to your homes","مَآ أُتْرِفْتُمْ فِيهِ","لَعَلَّكُمْ تُسْـَٔلُونَ",733],["23:18:6",343,"فَأَسْكَنَّـٰهُ","then We cause it to settle","ٱلسَّمَآءِ مَآءًۢ بِقَدَرٍۢ","فِى ٱلْأَرْضِ ۖ وَإِنَّا",1281],["24:22:11",352,"وَٱلْمَسَـٰكِينَ","and the needy","يُؤْتُوٓا۟ أُو۟لِى ٱلْقُرْبَىٰ","وَٱلْمُهَـٰجِرِينَ فِى سَبِيلِ",457],["24:29:8",353,"مَسْكُونَةٍۢ","inhabited","تَدْخُلُوا۟ بُيُوتًا غَيْرَ","فِيهَا مَتَـٰعٌۭ لَّكُمْ ۚ",3718],["25:45:11",364,"سَاكِنًۭا","stationary","وَلَوْ شَآءَ لَجَعَلَهُۥ","ثُمَّ جَعَلْنَا ٱلشَّمْسَ",4232],["27:18:12",378,"مَسَـٰكِنَكُمْ","your dwellings","يَـٰٓأَيُّهَا ٱلنَّمْلُ ٱدْخُلُوا۟","لَا يَحْطِمَنَّكُمْ سُلَيْمَـٰنُ",733],["27:86:6",384,"لِيَسْكُنُوا۟","that they may rest","أَنَّا جَعَلْنَا ٱلَّيْلَ","فِيهِ وَٱلنَّهَارَ مُبْصِرًا ۚ",638],["28:58:8",392,"مَسَـٰكِنُهُمْ","(are) their dwellings","بَطِرَتْ مَعِيشَتَهَا ۖ فَتِلْكَ","لَمْ تُسْكَن مِّنۢ",733],["28:58:10",392,"تُسْكَن","have been inhabited","فَتِلْكَ مَسَـٰكِنُهُمْ لَمْ","مِّنۢ بَعْدِهِمْ إِلَّا",638],["28:72:18",394,"تَسْكُنُونَ","(for) you (to) rest","ٱللَّهِ يَأْتِيكُم بِلَيْلٍۢ","فِيهِ ۖ أَفَلَا تُبْصِرُونَ",638],["28:73:7",394,"لِتَسْكُنُوا۟","that you may rest","لَكُمُ ٱلَّيْلَ وَٱلنَّهَارَ","فِيهِ وَلِتَبْتَغُوا۟ مِن",638],["29:38:7",400,"مَّسَـٰكِنِهِمْ ۖ","their dwellings","تَّبَيَّنَ لَكُم مِّن","وَزَيَّنَ لَهُمُ ٱلشَّيْطَـٰنُ",733],["30:21:9",406,"لِّتَسْكُنُوٓا۟","that you may find tranquility","مِّنْ أَنفُسِكُمْ أَزْوَٰجًۭا","إِلَيْهَا وَجَعَلَ بَيْنَكُم",638],["30:38:5",408,"وَٱلْمِسْكِينَ","and the poor","ذَا ٱلْقُرْبَىٰ حَقَّهُۥ","وَٱبْنَ ٱلسَّبِيلِ ۚ ذَٰلِكَ",457],["32:26:12",417,"مَسَـٰكِنِهِمْ ۚ","their dwellings","ٱلْقُرُونِ يَمْشُونَ فِى","إِنَّ فِى ذَٰلِكَ",733],["34:15:5",430,"مَسْكَنِهِمْ","their dwelling place","كَانَ لِسَبَإٍۢ فِى","ءَايَةٌۭ ۖ جَنَّتَانِ عَن",733],["40:61:6",474,"لِتَسْكُنُوا۟","that you may rest","جَعَلَ لَكُمُ ٱلَّيْلَ","فِيهِ وَٱلنَّهَارَ مُبْصِرًا ۚ",638],["42:33:3",487,"يُسْكِنِ","He can cause the wind to become still","إِن يَشَأْ","ٱلرِّيحَ فَيَظْلَلْنَ رَوَاكِدَ",1281],["46:25:10",505,"مَسَـٰكِنُهُمْ ۚ","their dwellings","لَا يُرَىٰٓ إِلَّا","كَذَٰلِكَ نَجْزِى ٱلْقَوْمَ",733],["48:4:4",511,"ٱلسَّكِينَةَ","[the] tranquility","هُوَ ٱلَّذِىٓ أَنزَلَ","فِى قُلُوبِ ٱلْمُؤْمِنِينَ",1228],["48:18:15",513,"ٱلسَّكِينَةَ","the tranquility","فِى قُلُوبِهِمْ فَأَنزَلَ","عَلَيْهِمْ وَأَثَـٰبَهُمْ فَتْحًۭا",1228],["48:26:12",514,"سَكِينَتَهُۥ","His tranquility","ٱلْجَـٰهِلِيَّةِ فَأَنزَلَ ٱللَّهُ","عَلَىٰ رَسُولِهِۦ وَعَلَى",1228],["58:4:16",542,"مِسْكِينًۭا ۚ","needy one(s)","يَسْتَطِعْ فَإِطْعَامُ سِتِّينَ","ذَٰلِكَ لِتُؤْمِنُوا۟ بِٱللَّهِ",457],["59:7:14",546,"وَٱلْمَسَـٰكِينِ","and the needy","وَلِذِى ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ","وَٱبْنِ ٱلسَّبِيلِ كَىْ",457],["61:12:10",552,"وَمَسَـٰكِنَ","and dwellings","مِن تَحْتِهَا ٱلْأَنْهَـٰرُ","طَيِّبَةًۭ فِى جَنَّـٰتِ",733],["65:6:1",559,"أَسْكِنُوهُنَّ","Lodge them","","مِنْ حَيْثُ سَكَنتُم",1281],["65:6:4",559,"سَكَنتُم","you dwell","أَسْكِنُوهُنَّ مِنْ حَيْثُ","مِّن وُجْدِكُمْ وَلَا",638],["68:24:6",565,"مِّسْكِينٌۭ","any poor person","يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم","",457],["69:34:5",567,"ٱلْمِسْكِينِ","(of) the poor","يَحُضُّ عَلَىٰ طَعَامِ","",457],["74:44:4",576,"ٱلْمِسْكِينَ","the poor","وَلَمْ نَكُ نُطْعِمُ","",457],["76:8:5",579,"مِسْكِينًۭا","(to the) needy","ٱلطَّعَامَ عَلَىٰ حُبِّهِۦ","وَيَتِيمًۭا وَأَسِيرًا",457],["89:18:5",593,"ٱلْمِسْكِينِ","the poor","تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ","",457],["90:16:2",594,"مِسْكِينًۭا","a needy person","أَوْ","ذَا مَتْرَبَةٍۢ",457],["107:3:5",602,"ٱلْمِسْكِينِ","the poor","يَحُضُّ عَلَىٰ طَعَامِ","",457]]