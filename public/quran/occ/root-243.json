[["3:11:11",51,"بِذُنُوبِهِمْ ۗ","for their sins","بِـَٔايَـٰتِنَا فَأَخَذَهُمُ ٱللَّهُ","وَٱللَّهُ شَدِيدُ ٱلْعِقَابِ",312],["3:16:8",52,"ذُنُوبَنَا","our sins","ءَامَنَّا فَٱغْفِرْ لَنَا","وَقِنَا عَذَابَ ٱلنَّارِ",312],["3:31:11",54,"ذُنُوبَكُمْ ۗ","your sins","ٱللَّهُ وَيَغْفِرْ لَكُمْ","وَٱللَّهُ غَفُورٌۭ رَّحِيمٌۭ",312],["3:135:11",67,"لِذُنُوبِهِمْ","for their sins","ذَكَرُوا۟ ٱللَّهَ فَٱسْتَغْفَرُوا۟","وَمَن يَغْفِرُ ٱلذُّنُوبَ",312],["3:135:14",67,"ٱلذُّنُوبَ","the sins","لِذُنُوبِهِمْ وَمَن يَغْفِرُ","إِلَّا ٱللَّهُ وَلَمْ",312],["3:147:10",68,"ذُنُوبَنَا","our sins","رَبَّنَا ٱغْفِرْ لَنَا","وَإِسْرَافَنَا فِىٓ أَمْرِنَا",312],["3:193:14",75,"ذُنُوبَنَا","our sins","رَبَّنَا فَٱغْفِرْ لَنَا","وَكَفِّرْ عَنَّا سَيِّـَٔاتِنَا",312],["5:18:11",111,"بِذُنُوبِكُم ۖ","for your sins","قُلْ فَلِمَ يُعَذِّبُكُم","بَلْ أَنتُم بَشَرٌۭ",312],["5:49:28",116,"ذُنُوبِهِمْ ۗ","(of) their sins","أَن يُصِيبَهُم بِبَعْضِ","وَإِنَّ كَثِيرًۭا مِّنَ",312],["6:6:26",128,"بِذُنُوبِهِمْ","for their sins","مِن تَحْتِهِمْ فَأَهْلَكْنَـٰهُم","وَأَنشَأْنَا مِنۢ بَعْدِهِمْ",312],["7:100:13",163,"بِذُنُوبِهِمْ ۚ","for their sins","لَّوْ نَشَآءُ أَصَبْنَـٰهُم","وَنَطْبَعُ عَلَىٰ قُلُوبِهِمْ",312],["8:52:12",183,"بِذُنُوبِهِمْ ۗ","for their sins","ٱللَّهِ فَأَخَذَهُمُ ٱللَّهُ","إِنَّ ٱللَّهَ قَوِىٌّۭ",312],["8:54:11",184,"بِذُنُوبِهِمْ","for their sins","بِـَٔايَـٰتِ رَبِّهِمْ فَأَهْلَكْنَـٰهُم","وَأَغْرَقْنَآ ءَالَ فِرْعَوْنَ ۚ",312],["9:102:3",203,"بِذُنُوبِهِمْ","their sins","وَءَاخَرُونَ ٱعْتَرَفُوا۟","خَلَطُوا۟ عَمَلًۭا صَـٰلِحًۭا",312],["12:29:6",238,"لِذَنۢبِكِ ۖ","for your sin","عَنْ هَـٰذَا ۚ وَٱسْتَغْفِرِى","إِنَّكِ كُنتِ مِنَ",312],["12:97:5",247,"ذُنُوبَنَآ","(of) our sins","يَـٰٓأَبَانَا ٱسْتَغْفِرْ لَنَا","إِنَّا كُنَّا خَـٰطِـِٔينَ",312],["14:10:13",256,"ذُنُوبِكُمْ","your sins","لِيَغْفِرَ لَكُم مِّن","وَيُؤَخِّرَكُمْ إِلَىٰٓ أَجَلٍۢ",312],["17:17:10",283,"بِذُنُوبِ","concerning the sins","نُوحٍۢ ۗ وَكَفَىٰ بِرَبِّكَ","عِبَادِهِۦ خَبِيرًۢا بَصِيرًۭا",312],["25:58:11",365,"بِذُنُوبِ","regarding the sins","بِحَمْدِهِۦ ۚ وَكَفَىٰ بِهِۦ","عِبَادِهِۦ خَبِيرًا",312],["26:14:3",367,"ذَنۢبٌۭ","a crime","وَلَهُمْ عَلَىَّ","فَأَخَافُ أَن يَقْتُلُونِ",312],["28:78:27",395,"ذُنُوبِهِمُ","their sins","وَلَا يُسْـَٔلُ عَن","ٱلْمُجْرِمُونَ",312],["29:40:3",401,"بِذَنۢبِهِۦ ۖ","for his sin","فَكُلًّا أَخَذْنَا","فَمِنْهُم مَّنْ أَرْسَلْنَا",312],["33:71:6",427,"ذُنُوبَكُمْ ۗ","your sins","أَعْمَـٰلَكُمْ وَيَغْفِرْ لَكُمْ","وَمَن يُطِعِ ٱللَّهَ",312],["39:53:15",464,"ٱلذُّنُوبَ","the sins","إِنَّ ٱللَّهَ يَغْفِرُ","جَمِيعًا ۚ إِنَّهُۥ هُوَ",312],["40:3:2",467,"ٱلذَّنۢبِ","(of) the sin","غَافِرِ","وَقَابِلِ ٱلتَّوْبِ شَدِيدِ",312],["40:11:8",468,"بِذُنُوبِنَا","our sins","وَأَحْيَيْتَنَا ٱثْنَتَيْنِ فَٱعْتَرَفْنَا","فَهَلْ إِلَىٰ خُرُوجٍۢ",312],["40:21:23",469,"بِذُنُوبِهِمْ","for their sins","ٱلْأَرْضِ فَأَخَذَهُمُ ٱللَّهُ","وَمَا كَانَ لَهُم",312],["40:55:7",473,"لِذَنۢبِكَ","for your sin","ٱللَّهِ حَقٌّۭ وَٱسْتَغْفِرْ","وَسَبِّحْ بِحَمْدِ رَبِّكَ",312],["46:31:10",506,"ذُنُوبِكُمْ","your sins","يَغْفِرْ لَكُم مِّن","وَيُجِرْكُم مِّنْ عَذَابٍ",312],["47:19:8",508,"لِذَنۢبِكَ","for your sin","إِلَّا ٱللَّهُ وَٱسْتَغْفِرْ","وَلِلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ۗ وَٱللَّهُ",312],["48:2:7",511,"ذَنۢبِكَ","your sins","مَا تَقَدَّمَ مِن","وَمَا تَأَخَّرَ وَيُتِمَّ",312],["51:59:4",523,"ذَنُوبًۭا","(is) a portion","فَإِنَّ لِلَّذِينَ ظَلَمُوا۟","مِّثْلَ ذَنُوبِ أَصْحَـٰبِهِمْ",2129],["51:59:6",523,"ذَنُوبِ","(the) portion","ظَلَمُوا۟ ذَنُوبًۭا مِّثْلَ","أَصْحَـٰبِهِمْ فَلَا يَسْتَعْجِلُونِ",2129],["55:39:5",532,"ذَنۢبِهِۦٓ","his sin","لَّا يُسْـَٔلُ عَن","إِنسٌۭ وَلَا جَآنٌّۭ",312],["61:12:3",552,"ذُنُوبَكُمْ","your sins","يَغْفِرْ لَكُمْ","وَيُدْخِلْكُمْ جَنَّـٰتٍۢ تَجْرِى",312],["67:11:2",562,"بِذَنۢبِهِمْ","their sins","فَٱعْتَرَفُوا۟","فَسُحْقًۭا لِّأَصْحَـٰبِ ٱلسَّعِيرِ",312],["71:4:4",570,"ذُنُوبِكُمْ","your sins","يَغْفِرْ لَكُم مِّن","وَيُؤَخِّرْكُمْ إِلَىٰٓ أَجَلٍۢ",312],["81:9:2",586,"ذَنۢبٍۢ","sin","بِأَىِّ","قُتِلَتْ",312],["91:14:6",595,"بِذَنۢبِهِمْ","for their sin","فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم","فَسَوَّىٰهَا",312]]