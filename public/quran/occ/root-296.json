[["2:218:5",34,"هَاجَرُوا۟","emigrated","ٱلَّذِينَ ءَامَنُوا۟ وَٱلَّذِينَ","وَجَـٰهَدُوا۟ فِى سَبِيلِ",596],["3:195:18",76,"هَاجَرُوا۟","emigrated","مِّنۢ بَعْضٍۢ ۖ فَٱلَّذِينَ","وَأُخْرِجُوا۟ مِن دِيَـٰرِهِمْ",596],["4:34:26",84,"وَٱهْجُرُوهُنَّ","and forsake them","تَخَافُونَ نُشُوزَهُنَّ فَعِظُوهُنَّ","فِى ٱلْمَضَاجِعِ وَٱضْرِبُوهُنَّ ۖ",1441],["4:89:13",92,"يُهَاجِرُوا۟","they emigrate","مِنْهُمْ أَوْلِيَآءَ حَتَّىٰ","فِى سَبِيلِ ٱللَّهِ ۚ",596],["4:97:21",94,"فَتُهَاجِرُوا۟","so that you (could) emigrate","أَرْضُ ٱللَّهِ وَٰسِعَةًۭ","فِيهَا ۚ فَأُو۟لَـٰٓئِكَ مَأْوَىٰهُمْ",596],["4:100:2",94,"يُهَاجِرْ","emigrates","۞ وَمَن","فِى سَبِيلِ ٱللَّهِ",596],["4:100:16",94,"مُهَاجِرًا","(as) an emigrant","يَخْرُجْ مِنۢ بَيْتِهِۦ","إِلَى ٱللَّهِ وَرَسُولِهِۦ",1086],["8:72:4",186,"وَهَاجَرُوا۟","and emigrated","إِنَّ ٱلَّذِينَ ءَامَنُوا۟","وَجَـٰهَدُوا۟ بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ",596],["8:72:21",186,"يُهَاجِرُوا۟","emigrate","وَٱلَّذِينَ ءَامَنُوا۟ وَلَمْ","مَا لَكُم مِّن",596],["8:72:29",186,"يُهَاجِرُوا۟ ۚ","they emigrate","مِّن شَىْءٍ حَتَّىٰ","وَإِنِ ٱسْتَنصَرُوكُمْ فِى",596],["8:74:3",186,"وَهَاجَرُوا۟","and emigrated","وَٱلَّذِينَ ءَامَنُوا۟","وَجَـٰهَدُوا۟ فِى سَبِيلِ",596],["8:75:5",186,"وَهَاجَرُوا۟","and emigrated","ءَامَنُوا۟ مِنۢ بَعْدُ","وَجَـٰهَدُوا۟ مَعَكُمْ فَأُو۟لَـٰٓئِكَ",596],["9:20:3",189,"وَهَاجَرُوا۟","and emigrated","ٱلَّذِينَ ءَامَنُوا۟","وَجَـٰهَدُوا۟ فِى سَبِيلِ",596],["9:100:4",203,"ٱلْمُهَـٰجِرِينَ","the emigrants","وَٱلسَّـٰبِقُونَ ٱلْأَوَّلُونَ مِنَ","وَٱلْأَنصَارِ وَٱلَّذِينَ ٱتَّبَعُوهُم",1086],["9:117:6",205,"وَٱلْمُهَـٰجِرِينَ","and the emigrants","ٱللَّهُ عَلَى ٱلنَّبِىِّ","وَٱلْأَنصَارِ ٱلَّذِينَ ٱتَّبَعُوهُ",1086],["16:41:2",271,"هَاجَرُوا۟","emigrated","وَٱلَّذِينَ","فِى ٱللَّهِ مِنۢ",596],["16:110:5",279,"هَاجَرُوا۟","emigrated","إِنَّ رَبَّكَ لِلَّذِينَ","مِنۢ بَعْدِ مَا",596],["19:46:11",308,"وَٱهْجُرْنِى","so leave me","لَّمْ تَنتَهِ لَأَرْجُمَنَّكَ ۖ","مَلِيًّۭا",1441],["22:58:2",339,"هَاجَرُوا۟","emigrated","وَٱلَّذِينَ","فِى سَبِيلِ ٱللَّهِ",596],["23:67:4",346,"تَهْجُرُونَ","speaking evil","مُسْتَكْبِرِينَ بِهِۦ سَـٰمِرًۭا","",1441],["24:22:12",352,"وَٱلْمُهَـٰجِرِينَ","and the emigrants","أُو۟لِى ٱلْقُرْبَىٰ وَٱلْمَسَـٰكِينَ","فِى سَبِيلِ ٱللَّهِ ۖ",1086],["25:30:9",362,"مَهْجُورًۭا","(as) a forsaken thing","ٱتَّخَذُوا۟ هَـٰذَا ٱلْقُرْءَانَ","",3665],["29:26:6",399,"مُهَاجِرٌ","emigrating","لُوطٌۭ ۘ وَقَالَ إِنِّى","إِلَىٰ رَبِّىٓ ۖ إِنَّهُۥ",1086],["33:6:18",418,"وَٱلْمُهَـٰجِرِينَ","and the emigrants","ٱللَّهِ مِنَ ٱلْمُؤْمِنِينَ","إِلَّآ أَن تَفْعَلُوٓا۟",1086],["33:50:26",424,"هَاجَرْنَ","emigrated","وَبَنَاتِ خَـٰلَـٰتِكَ ٱلَّـٰتِى","مَعَكَ وَٱمْرَأَةًۭ مُّؤْمِنَةً",596],["59:8:2",546,"ٱلْمُهَـٰجِرِينَ","emigrants","لِلْفُقَرَآءِ","ٱلَّذِينَ أُخْرِجُوا۟ مِن",1086],["59:9:9",546,"هَاجَرَ","emigrated","قَبْلِهِمْ يُحِبُّونَ مَنْ","إِلَيْهِمْ وَلَا يَجِدُونَ",596],["60:10:7",550,"مُهَـٰجِرَٰتٍۢ","(as) emigrants","إِذَا جَآءَكُمُ ٱلْمُؤْمِنَـٰتُ","فَٱمْتَحِنُوهُنَّ ۖ ٱللَّهُ أَعْلَمُ",3806],["73:10:5",574,"وَٱهْجُرْهُمْ","and avoid them","عَلَىٰ مَا يَقُولُونَ","هَجْرًۭا جَمِيلًۭا",1441],["73:10:6",574,"هَجْرًۭا","an avoidance","مَا يَقُولُونَ وَٱهْجُرْهُمْ","جَمِيلًۭا",3492],["74:5:2",575,"فَٱهْجُرْ","avoid","وَٱلرُّجْزَ","",1441]]