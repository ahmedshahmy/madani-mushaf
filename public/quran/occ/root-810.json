[["2:87:5",13,"وَقَفَّيْنَا","and We followed up","ءَاتَيْنَا مُوسَى ٱلْكِتَـٰبَ","مِنۢ بَعْدِهِۦ بِٱلرُّسُلِ ۖ",1618],["5:46:1",116,"وَقَفَّيْنَا","And We sent","","عَلَىٰٓ ءَاثَـٰرِهِم بِعِيسَى",1618],["17:36:2",285,"تَقْفُ","pursue","وَلَا","مَا لَيْسَ لَكَ",4406],["57:27:2",541,"قَفَّيْنَا","We sent","ثُمَّ","عَلَىٰٓ ءَاثَـٰرِهِم بِرُسُلِنَا",1618],["57:27:6",541,"وَقَفَّيْنَا","and We followed","عَلَىٰٓ ءَاثَـٰرِهِم بِرُسُلِنَا","بِعِيسَى ٱبْنِ مَرْيَمَ",1618]]