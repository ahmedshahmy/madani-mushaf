[["3:8:8",50,"وَهَبْ","and grant","بَعْدَ إِذْ هَدَيْتَنَا","لَنَا مِن لَّدُنكَ",478],["3:8:15",50,"ٱلْوَهَّابُ","(are) the Bestower","رَحْمَةً ۚ إِنَّكَ أَنتَ","",2025],["3:38:7",55,"هَبْ","grant","رَبَّهُۥ ۖ قَالَ رَبِّ","لِى مِن لَّدُنكَ",478],["6:84:1",138,"وَوَهَبْنَا","And We bestowed","","لَهُۥٓ إِسْحَـٰقَ وَيَعْقُوبَ ۚ",478],["14:39:4",260,"وَهَبَ","has granted","ٱلْحَمْدُ لِلَّهِ ٱلَّذِى","لِى عَلَى ٱلْكِبَرِ",478],["19:5:9",305,"فَهَبْ","So give","وَكَانَتِ ٱمْرَأَتِى عَاقِرًۭا","لِى مِن لَّدُنكَ",478],["19:19:6",306,"لِأَهَبَ","that I (may) bestow","أَنَا۠ رَسُولُ رَبِّكِ","لَكِ غُلَـٰمًۭا زَكِيًّۭا",478],["19:49:8",308,"وَهَبْنَا","[and] We bestowed","مِن دُونِ ٱللَّهِ","لَهُۥٓ إِسْحَـٰقَ وَيَعْقُوبَ ۖ",478],["19:50:1",308,"وَوَهَبْنَا","And We bestowed","","لَهُم مِّن رَّحْمَتِنَا",478],["19:53:1",309,"وَوَهَبْنَا","And We bestowed","","لَهُۥ مِن رَّحْمَتِنَآ",478],["21:72:1",327,"وَوَهَبْنَا","And We bestowed","","لَهُۥٓ إِسْحَـٰقَ وَيَعْقُوبَ",478],["21:90:3",329,"وَوَهَبْنَا","and We bestowed","فَٱسْتَجَبْنَا لَهُۥ","لَهُۥ يَحْيَىٰ وَأَصْلَحْنَا",478],["25:74:4",366,"هَبْ","Grant","وَٱلَّذِينَ يَقُولُونَ رَبَّنَا","لَنَا مِنْ أَزْوَٰجِنَا",478],["26:21:5",368,"فَوَهَبَ","But granted","مِنكُمْ لَمَّا خِفْتُكُمْ","لِى رَبِّى حُكْمًۭا",478],["26:83:2",370,"هَبْ","Grant","رَبِّ","لِى حُكْمًۭا وَأَلْحِقْنِى",478],["29:27:1",399,"وَوَهَبْنَا","And We granted","","لَهُۥٓ إِسْحَـٰقَ وَيَعْقُوبَ",478],["33:50:31",424,"وَهَبَتْ","she gives","وَٱمْرَأَةًۭ مُّؤْمِنَةً إِن","نَفْسَهَا لِلنَّبِىِّ إِنْ",478],["37:100:2",449,"هَبْ","grant","رَبِّ","لِى مِنَ ٱلصَّـٰلِحِينَ",478],["38:9:7",453,"ٱلْوَهَّابِ","the Bestower","رَحْمَةِ رَبِّكَ ٱلْعَزِيزِ","",2025],["38:30:1",455,"وَوَهَبْنَا","And We gave","","لِدَاوُۥدَ سُلَيْمَـٰنَ ۚ نِعْمَ",478],["38:35:5",455,"وَهَبْ","and grant","رَبِّ ٱغْفِرْ لِى","لِى مُلْكًۭا لَّا",478],["38:35:15",455,"ٱلْوَهَّابُ","(are) the Bestower","بَعْدِىٓ ۖ إِنَّكَ أَنتَ","",2025],["38:43:1",456,"وَوَهَبْنَا","And We granted","","لَهُۥٓ أَهْلَهُۥ وَمِثْلَهُم",478],["42:49:8",488,"يَهَبُ","He grants","يَخْلُقُ مَا يَشَآءُ ۚ","لِمَن يَشَآءُ إِنَـٰثًۭا",478],["42:49:12",488,"وَيَهَبُ","and He grants","لِمَن يَشَآءُ إِنَـٰثًۭا","لِمَن يَشَآءُ ٱلذُّكُورَ",478]]