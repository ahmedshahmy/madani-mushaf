[["2:126:7",19,"بَلَدًا","a city","رَبِّ ٱجْعَلْ هَـٰذَا","ءَامِنًۭا وَٱرْزُقْ أَهْلَهُۥ",660],["3:196:7",76,"ٱلْبِلَـٰدِ","the land","ٱلَّذِينَ كَفَرُوا۟ فِى","",660],["7:57:15",157,"لِبَلَدٍۢ","to a land","سَحَابًۭا ثِقَالًۭا سُقْنَـٰهُ","مَّيِّتٍۢ فَأَنزَلْنَا بِهِ",660],["7:58:1",158,"وَٱلْبَلَدُ","And the land","","ٱلطَّيِّبُ يَخْرُجُ نَبَاتُهُۥ",660],["14:35:7",260,"ٱلْبَلَدَ","city","رَبِّ ٱجْعَلْ هَـٰذَا","ءَامِنًۭا وَٱجْنُبْنِى وَبَنِىَّ",660],["16:7:4",268,"بَلَدٍۢ","a land","وَتَحْمِلُ أَثْقَالَكُمْ إِلَىٰ","لَّمْ تَكُونُوا۟ بَـٰلِغِيهِ",660],["25:49:3",364,"بَلْدَةًۭ","(to) a land","لِّنُحْـِۧىَ بِهِۦ","مَّيْتًۭا وَنُسْقِيَهُۥ مِمَّا",1322],["27:91:7",385,"ٱلْبَلْدَةِ","city","أَعْبُدَ رَبَّ هَـٰذِهِ","ٱلَّذِى حَرَّمَهَا وَلَهُۥ",1322],["34:15:17",430,"بَلْدَةٌۭ","A land","رَبِّكُمْ وَٱشْكُرُوا۟ لَهُۥ ۚ","طَيِّبَةٌۭ وَرَبٌّ غَفُورٌۭ",1322],["35:9:9",435,"بَلَدٍۢ","a land","سَحَابًۭا فَسُقْنَـٰهُ إِلَىٰ","مَّيِّتٍۢ فَأَحْيَيْنَا بِهِ",660],["40:4:13",467,"ٱلْبِلَـٰدِ","the cities","يَغْرُرْكَ تَقَلُّبُهُمْ فِى","",660],["43:11:9",490,"بَلْدَةًۭ","a land","بِقَدَرٍۢ فَأَنشَرْنَا بِهِۦ","مَّيْتًۭا ۚ كَذَٰلِكَ تُخْرَجُونَ",1322],["50:11:5",518,"بَلْدَةًۭ","(to) a land","لِّلْعِبَادِ ۖ وَأَحْيَيْنَا بِهِۦ","مَّيْتًۭا ۚ كَذَٰلِكَ ٱلْخُرُوجُ",1322],["50:36:12",520,"ٱلْبِلَـٰدِ","the lands","بَطْشًۭا فَنَقَّبُوا۟ فِى","هَلْ مِن مَّحِيصٍ",660],["89:8:6",593,"ٱلْبِلَـٰدِ","the cities","يُخْلَقْ مِثْلُهَا فِى","",660],["89:11:4",593,"ٱلْبِلَـٰدِ","the lands","ٱلَّذِينَ طَغَوْا۟ فِى","",660],["90:1:4",594,"ٱلْبَلَدِ","city","لَآ أُقْسِمُ بِهَـٰذَا","",660],["90:2:4",594,"ٱلْبَلَدِ","city","وَأَنتَ حِلٌّۢ بِهَـٰذَا","",660],["95:3:2",597,"ٱلْبَلَدِ","[the] city","وَهَـٰذَا","ٱلْأَمِينِ",660]]