[["2:27:7",5,"مِيثَـٰقِهِۦ","its ratification","ٱللَّهِ مِنۢ بَعْدِ","وَيَقْطَعُونَ مَآ أَمَرَ",429],["2:63:3",10,"مِيثَـٰقَكُمْ","your covenant","وَإِذْ أَخَذْنَا","وَرَفَعْنَا فَوْقَكُمُ ٱلطُّورَ",429],["2:83:3",12,"مِيثَـٰقَ","(the) covenant","وَإِذْ أَخَذْنَا","بَنِىٓ إِسْرَٰٓءِيلَ لَا",429],["2:84:3",13,"مِيثَـٰقَكُمْ","your covenant","وَإِذْ أَخَذْنَا","لَا تَسْفِكُونَ دِمَآءَكُمْ",429],["2:93:3",14,"مِيثَـٰقَكُمْ","your covenant","وَإِذْ أَخَذْنَا","وَرَفَعْنَا فَوْقَكُمُ ٱلطُّورَ",429],["2:256:18",42,"ٱلْوُثْقَىٰ","[the] firm","فَقَدِ ٱسْتَمْسَكَ بِٱلْعُرْوَةِ","لَا ٱنفِصَامَ لَهَا ۗ",2722],["3:81:4",60,"مِيثَـٰقَ","covenant","وَإِذْ أَخَذَ ٱللَّهُ","ٱلنَّبِيِّـۧنَ لَمَآ ءَاتَيْتُكُم",429],["3:187:4",75,"مِيثَـٰقَ","a Covenant","وَإِذْ أَخَذَ ٱللَّهُ","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ",429],["4:21:10",81,"مِّيثَـٰقًا","covenant","بَعْضٍۢ وَأَخَذْنَ مِنكُم","غَلِيظًۭا",429],["4:90:8",92,"مِّيثَـٰقٌ","(is) a treaty","قَوْمٍۭ بَيْنَكُمْ وَبَيْنَهُم","أَوْ جَآءُوكُمْ حَصِرَتْ",429],["4:92:40",93,"مِّيثَـٰقٌۭ","(is) a treaty","قَوْمٍۭ بَيْنَكُمْ وَبَيْنَهُم","فَدِيَةٌۭ مُّسَلَّمَةٌ إِلَىٰٓ",429],["4:154:4",102,"بِمِيثَـٰقِهِمْ","for their covenant","وَرَفَعْنَا فَوْقَهُمُ ٱلطُّورَ","وَقُلْنَا لَهُمُ ٱدْخُلُوا۟",429],["4:154:18",102,"مِّيثَـٰقًا","a covenant","ٱلسَّبْتِ وَأَخَذْنَا مِنْهُم","غَلِيظًۭا",429],["4:155:3",103,"مِّيثَـٰقَهُمْ","(of) their covenant","فَبِمَا نَقْضِهِم","وَكُفْرِهِم بِـَٔايَـٰتِ ٱللَّهِ",429],["5:7:5",108,"وَمِيثَـٰقَهُ","and His covenant","نِعْمَةَ ٱللَّهِ عَلَيْكُمْ","ٱلَّذِى وَاثَقَكُم بِهِۦٓ",429],["5:7:7",108,"وَاثَقَكُم","He bound you","عَلَيْكُمْ وَمِيثَـٰقَهُ ٱلَّذِى","بِهِۦٓ إِذْ قُلْتُمْ",4510],["5:12:4",109,"مِيثَـٰقَ","a Covenant","۞ وَلَقَدْ أَخَذَ ٱللَّهُ","بَنِىٓ إِسْرَٰٓءِيلَ وَبَعَثْنَا",429],["5:13:3",109,"مِّيثَـٰقَهُمْ","(of) their covenant","فَبِمَا نَقْضِهِم","لَعَنَّـٰهُمْ وَجَعَلْنَا قُلُوبَهُمْ",429],["5:14:7",110,"مِيثَـٰقَهُمْ","their covenant","إِنَّا نَصَـٰرَىٰٓ أَخَذْنَا","فَنَسُوا۟ حَظًّۭا مِّمَّا",429],["5:70:3",119,"مِيثَـٰقَ","a Covenant","لَقَدْ أَخَذْنَا","بَنِىٓ إِسْرَٰٓءِيلَ وَأَرْسَلْنَآ",429],["7:169:22",172,"مِّيثَـٰقُ","Covenant","أَلَمْ يُؤْخَذْ عَلَيْهِم","ٱلْكِتَـٰبِ أَن لَّا",429],["8:72:41",186,"مِّيثَـٰقٌۭ ۗ","(is) a treaty","قَوْمٍۭ بَيْنَكُمْ وَبَيْنَهُم","وَٱللَّهُ بِمَا تَعْمَلُونَ",429],["12:66:7",243,"مَوْثِقًۭا","a promise","مَعَكُمْ حَتَّىٰ تُؤْتُونِ","مِّنَ ٱللَّهِ لَتَأْتُنَّنِى",1927],["12:66:18",243,"مَوْثِقَهُمْ","their promise","بِكُمْ ۖ فَلَمَّآ ءَاتَوْهُ","قَالَ ٱللَّهُ عَلَىٰ",1927],["12:80:15",245,"مَّوْثِقًۭا","a promise","قَدْ أَخَذَ عَلَيْكُم","مِّنَ ٱللَّهِ وَمِن",1927],["13:20:7",252,"ٱلْمِيثَـٰقَ","the contract","ٱللَّهِ وَلَا يَنقُضُونَ","",429],["13:25:7",252,"مِيثَـٰقِهِۦ","contracting it","ٱللَّهِ مِنۢ بَعْدِ","وَيَقْطَعُونَ مَآ أَمَرَ",429],["31:22:11",413,"ٱلْوُثْقَىٰ ۗ","the most trustworthy","فَقَدِ ٱسْتَمْسَكَ بِٱلْعُرْوَةِ","وَإِلَى ٱللَّهِ عَـٰقِبَةُ",2722],["33:7:5",419,"مِيثَـٰقَهُمْ","their Covenant","أَخَذْنَا مِنَ ٱلنَّبِيِّـۧنَ","وَمِنكَ وَمِن نُّوحٍۢ",429],["33:7:16",419,"مِّيثَـٰقًا","a covenant","مَرْيَمَ ۖ وَأَخَذْنَا مِنْهُم","غَلِيظًۭا",429],["47:4:11",507,"ٱلْوَثَاقَ","the bond","إِذَآ أَثْخَنتُمُوهُمْ فَشُدُّوا۟","فَإِمَّا مَنًّۢا بَعْدُ",2717],["57:8:12",538,"مِيثَـٰقَكُمْ","your covenant","بِرَبِّكُمْ وَقَدْ أَخَذَ","إِن كُنتُم مُّؤْمِنِينَ",429],["89:26:2",594,"يُوثِقُ","will bind","وَلَا","وَثَاقَهُۥٓ أَحَدٌۭ",4743],["89:26:3",594,"وَثَاقَهُۥٓ","(as) His binding","وَلَا يُوثِقُ","أَحَدٌۭ",2717]]