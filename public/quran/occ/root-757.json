[["2:220:22",35,"لَأَعْنَتَكُمْ ۚ","surely He (could have) put you in difficulties","وَلَوْ شَآءَ ٱللَّهُ","إِنَّ ٱللَّهَ عَزِيزٌ",2953],["3:118:14",65,"عَنِتُّمْ","distresses you","خَبَالًۭا وَدُّوا۟ مَا","قَدْ بَدَتِ ٱلْبَغْضَآءُ",1766],["4:25:50",82,"ٱلْعَنَتَ","committing sin","ذَٰلِكَ لِمَنْ خَشِىَ","مِنكُمْ ۚ وَأَن تَصْبِرُوا۟",3118],["9:128:9",207,"عَنِتُّمْ","you suffer","عَزِيزٌ عَلَيْهِ مَا","حَرِيصٌ عَلَيْكُم بِٱلْمُؤْمِنِينَ",1766],["49:7:12",516,"لَعَنِتُّمْ","surely you would be in difficulty","كَثِيرٍۢ مِّنَ ٱلْأَمْرِ","وَلَـٰكِنَّ ٱللَّهَ حَبَّبَ",1766]]