[["2:133:19",20,"ءَابَآئِكَ","(of) your forefathers","نَعْبُدُ إِلَـٰهَكَ وَإِلَـٰهَ","إِبْرَٰهِـۧمَ وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ",189],["2:170:14",26,"ءَابَآءَنَآ ۗ","our forefathers (following)","مَآ أَلْفَيْنَا عَلَيْهِ","أَوَلَوْ كَانَ ءَابَآؤُهُمْ",189],["2:170:17",26,"ءَابَآؤُهُمْ","their forefathers","ءَابَآءَنَآ ۗ أَوَلَوْ كَانَ","لَا يَعْقِلُونَ شَيْـًۭٔا",189],["2:200:7",31,"ءَابَآءَكُمْ","your forefathers","فَٱذْكُرُوا۟ ٱللَّهَ كَذِكْرِكُمْ","أَوْ أَشَدَّ ذِكْرًۭا ۗ",189],["4:11:23",78,"وَلِأَبَوَيْهِ","And for his parents","وَٰحِدَةًۭ فَلَهَا ٱلنِّصْفُ ۚ","لِكُلِّ وَٰحِدٍۢ مِّنْهُمَا",1034],["4:11:40",78,"أَبَوَاهُ","his parents","لَّهُۥ وَلَدٌۭ وَوَرِثَهُۥٓ","فَلِأُمِّهِ ٱلثُّلُثُ ۚ فَإِن",1034],["4:11:56",78,"ءَابَآؤُكُمْ","Your parents","بِهَآ أَوْ دَيْنٍ ۗ","وَأَبْنَآؤُكُمْ لَا تَدْرُونَ",189],["4:22:5",81,"ءَابَآؤُكُم","your fathers","تَنكِحُوا۟ مَا نَكَحَ","مِّنَ ٱلنِّسَآءِ إِلَّا",189],["5:104:16",125,"ءَابَآءَنَآ ۚ","our forefathers","مَا وَجَدْنَا عَلَيْهِ","أَوَلَوْ كَانَ ءَابَآؤُهُمْ",189],["5:104:19",125,"ءَابَآؤُهُمْ","their forefathers","ءَابَآءَنَآ ۚ أَوَلَوْ كَانَ","لَا يَعْلَمُونَ شَيْـًۭٔا",189],["6:74:4",137,"لِأَبِيهِ","to his father","۞ وَإِذْ قَالَ إِبْرَٰهِيمُ","ءَازَرَ أَتَتَّخِذُ أَصْنَامًا",254],["6:87:2",138,"ءَابَآئِهِمْ","their fathers","وَمِنْ","وَذُرِّيَّـٰتِهِمْ وَإِخْوَٰنِهِمْ ۖ وَٱجْتَبَيْنَـٰهُمْ",189],["6:91:37",139,"ءَابَآؤُكُمْ ۖ","your forefathers","تَعْلَمُوٓا۟ أَنتُمْ وَلَآ","قُلِ ٱللَّهُ ۖ ثُمَّ",189],["6:148:10",148,"ءَابَآؤُنَا","our forefathers","مَآ أَشْرَكْنَا وَلَآ","وَلَا حَرَّمْنَا مِن",189],["7:27:8",153,"أَبَوَيْكُم","your parents","ٱلشَّيْطَـٰنُ كَمَآ أَخْرَجَ","مِّنَ ٱلْجَنَّةِ يَنزِعُ",1034],["7:28:7",153,"ءَابَآءَنَا","our forefathers","قَالُوا۟ وَجَدْنَا عَلَيْهَآ","وَٱللَّهُ أَمَرَنَا بِهَا ۗ",189],["7:70:10",159,"ءَابَآؤُنَا ۖ","our forefathers","مَا كَانَ يَعْبُدُ","فَأْتِنَا بِمَا تَعِدُنَآ",189],["7:71:14",159,"وَءَابَآؤُكُم","and your forefathers","أَسْمَآءٍۢ سَمَّيْتُمُوهَآ أَنتُمْ","مَّا نَزَّلَ ٱللَّهُ",189],["7:95:11",162,"ءَابَآءَنَا","our forefathers","وَّقَالُوا۟ قَدْ مَسَّ","ٱلضَّرَّآءُ وَٱلسَّرَّآءُ فَأَخَذْنَـٰهُم",189],["7:173:5",173,"ءَابَآؤُنَا","(by) our forefathers","تَقُولُوٓا۟ إِنَّمَآ أَشْرَكَ","مِن قَبْلُ وَكُنَّا",189],["9:23:6",190,"ءَابَآءَكُمْ","your fathers","ءَامَنُوا۟ لَا تَتَّخِذُوٓا۟","وَإِخْوَٰنَكُمْ أَوْلِيَآءَ إِنِ",189],["9:24:4",190,"ءَابَآؤُكُمْ","your fathers","قُلْ إِن كَانَ","وَأَبْنَآؤُكُمْ وَإِخْوَٰنُكُمْ وَأَزْوَٰجُكُمْ",189],["9:114:5",205,"لِأَبِيهِ","for his father","كَانَ ٱسْتِغْفَارُ إِبْرَٰهِيمَ","إِلَّا عَن مَّوْعِدَةٍۢ",254],["10:78:7",217,"ءَابَآءَنَا","our forefathers","عَمَّا وَجَدْنَا عَلَيْهِ","وَتَكُونَ لَكُمَا ٱلْكِبْرِيَآءُ",189],["11:62:14",228,"ءَابَآؤُنَا","our forefathers worshipped","نَّعْبُدَ مَا يَعْبُدُ","وَإِنَّنَا لَفِى شَكٍّۢ",189],["11:87:9",231,"ءَابَآؤُنَآ","our forefathers","نَّتْرُكَ مَا يَعْبُدُ","أَوْ أَن نَّفْعَلَ",189],["11:109:13",234,"ءَابَآؤُهُم","their forefathers","إِلَّا كَمَا يَعْبُدُ","مِّن قَبْلُ ۚ وَإِنَّا",189],["12:4:4",235,"لِأَبِيهِ","to his father","إِذْ قَالَ يُوسُفُ","يَـٰٓأَبَتِ إِنِّى رَأَيْتُ",254],["12:4:5",235,"يَـٰٓأَبَتِ","O my father","قَالَ يُوسُفُ لِأَبِيهِ","إِنِّى رَأَيْتُ أَحَدَ",254],["12:6:17",236,"أَبَوَيْكَ","your two forefathers","كَمَآ أَتَمَّهَا عَلَىٰٓ","مِن قَبْلُ إِبْرَٰهِيمَ",1034],["12:8:7",236,"أَبِينَا","our father","وَأَخُوهُ أَحَبُّ إِلَىٰٓ","مِنَّا وَنَحْنُ عُصْبَةٌ",254],["12:8:12",236,"أَبَانَا","our father","وَنَحْنُ عُصْبَةٌ إِنَّ","لَفِى ضَلَـٰلٍۢ مُّبِينٍ",254],["12:9:9",236,"أَبِيكُمْ","(of) your father","يَخْلُ لَكُمْ وَجْهُ","وَتَكُونُوا۟ مِنۢ بَعْدِهِۦ",254],["12:11:2",236,"يَـٰٓأَبَانَا","O our father","قَالُوا۟","مَا لَكَ لَا",254],["12:16:2",237,"أَبَاهُمْ","(to) their father","وَجَآءُوٓ","عِشَآءًۭ يَبْكُونَ",254],["12:17:2",237,"يَـٰٓأَبَانَآ","O our father","قَالُوا۟","إِنَّا ذَهَبْنَا نَسْتَبِقُ",254],["12:38:3",240,"ءَابَآءِىٓ","(of) my forefathers","وَٱتَّبَعْتُ مِلَّةَ","إِبْرَٰهِيمَ وَإِسْحَـٰقَ وَيَعْقُوبَ ۚ",189],["12:40:9",240,"وَءَابَآؤُكُم","and your forefathers","أَسْمَآءًۭ سَمَّيْتُمُوهَآ أَنتُمْ","مَّآ أَنزَلَ ٱللَّهُ",189],["12:59:9",242,"أَبِيكُمْ ۚ","your father","بِأَخٍۢ لَّكُم مِّنْ","أَلَا تَرَوْنَ أَنِّىٓ",254],["12:61:4",242,"أَبَاهُ","(from) his father","قَالُوا۟ سَنُرَٰوِدُ عَنْهُ","وَإِنَّا لَفَـٰعِلُونَ",254],["12:63:4",242,"أَبِيهِمْ","their father","فَلَمَّا رَجَعُوٓا۟ إِلَىٰٓ","قَالُوا۟ يَـٰٓأَبَانَا مُنِعَ",254],["12:63:6",242,"يَـٰٓأَبَانَا","O our father","إِلَىٰٓ أَبِيهِمْ قَالُوا۟","مُنِعَ مِنَّا ٱلْكَيْلُ",254],["12:65:9",243,"يَـٰٓأَبَانَا","O our father","رُدَّتْ إِلَيْهِمْ ۖ قَالُوا۟","مَا نَبْغِى ۖ هَـٰذِهِۦ",254],["12:68:6",243,"أَبُوهُم","their father","مِنْ حَيْثُ أَمَرَهُمْ","مَّا كَانَ يُغْنِى",254],["12:78:6",244,"أَبًۭا","a father","ٱلْعَزِيزُ إِنَّ لَهُۥٓ","شَيْخًۭا كَبِيرًۭا فَخُذْ",254],["12:80:11",245,"أَبَاكُمْ","your father","أَلَمْ تَعْلَمُوٓا۟ أَنَّ","قَدْ أَخَذَ عَلَيْكُم",254],["12:80:30",245,"أَبِىٓ","my father","حَتَّىٰ يَأْذَنَ لِىٓ","أَوْ يَحْكُمَ ٱللَّهُ",254],["12:81:3",245,"أَبِيكُمْ","your father","ٱرْجِعُوٓا۟ إِلَىٰٓ","فَقُولُوا۟ يَـٰٓأَبَانَآ إِنَّ",254],["12:81:5",245,"يَـٰٓأَبَانَآ","'O our father","إِلَىٰٓ أَبِيكُمْ فَقُولُوا۟","إِنَّ ٱبْنَكَ سَرَقَ",254],["12:93:7",246,"أَبِى","(of) my father","فَأَلْقُوهُ عَلَىٰ وَجْهِ","يَأْتِ بَصِيرًۭا وَأْتُونِى",254],["12:94:5",246,"أَبُوهُمْ","their father said","فَصَلَتِ ٱلْعِيرُ قَالَ","إِنِّى لَأَجِدُ رِيحَ",254],["12:97:2",247,"يَـٰٓأَبَانَا","O our father","قَالُوا۟","ٱسْتَغْفِرْ لَنَا ذُنُوبَنَآ",254],["12:99:7",247,"أَبَوَيْهِ","his parents","يُوسُفَ ءَاوَىٰٓ إِلَيْهِ","وَقَالَ ٱدْخُلُوا۟ مِصْرَ",1034],["12:100:2",247,"أَبَوَيْهِ","his parents","وَرَفَعَ","عَلَى ٱلْعَرْشِ وَخَرُّوا۟",1034],["12:100:9",247,"يَـٰٓأَبَتِ","O my father","لَهُۥ سُجَّدًۭا ۖ وَقَالَ","هَـٰذَا تَأْوِيلُ رُءْيَـٰىَ",254],["13:23:7",252,"ءَابَآئِهِمْ","their fathers","وَمَن صَلَحَ مِنْ","وَأَزْوَٰجِهِمْ وَذُرِّيَّـٰتِهِمْ ۖ وَٱلْمَلَـٰٓئِكَةُ",189],["14:10:30",256,"ءَابَآؤُنَا","our forefathers","عَمَّا كَانَ يَعْبُدُ","فَأْتُونَا بِسُلْطَـٰنٍۢ مُّبِينٍۢ",189],["16:35:15",271,"ءَابَآؤُنَا","our forefathers","شَىْءٍۢ نَّحْنُ وَلَآ","وَلَا حَرَّمْنَا مِن",189],["18:5:7",294,"لِـَٔابَآئِهِمْ ۚ","their forefathers","مِنْ عِلْمٍۢ وَلَا","كَبُرَتْ كَلِمَةًۭ تَخْرُجُ",189],["18:80:4",302,"أَبَوَاهُ","his parents were","وَأَمَّا ٱلْغُلَـٰمُ فَكَانَ","مُؤْمِنَيْنِ فَخَشِينَآ أَن",1034],["18:82:13",302,"أَبُوهُمَا","their father","كَنزٌۭ لَّهُمَا وَكَانَ","صَـٰلِحًۭا فَأَرَادَ رَبُّكَ",254],["19:28:5",307,"أَبُوكِ","your father","هَـٰرُونَ مَا كَانَ","ٱمْرَأَ سَوْءٍۢ وَمَا",254],["19:42:3",308,"لِأَبِيهِ","to his father","إِذْ قَالَ","يَـٰٓأَبَتِ لِمَ تَعْبُدُ",254],["19:42:4",308,"يَـٰٓأَبَتِ","O my father","إِذْ قَالَ لِأَبِيهِ","لِمَ تَعْبُدُ مَا",254],["19:43:1",308,"يَـٰٓأَبَتِ","O my father","","إِنِّى قَدْ جَآءَنِى",254],["19:44:1",308,"يَـٰٓأَبَتِ","O my father","","لَا تَعْبُدِ ٱلشَّيْطَـٰنَ ۖ",254],["19:45:1",308,"يَـٰٓأَبَتِ","O my father","","إِنِّىٓ أَخَافُ أَن",254],["21:44:4",325,"وَءَابَآءَهُمْ","and their fathers","بَلْ مَتَّعْنَا هَـٰٓؤُلَآءِ","حَتَّىٰ طَالَ عَلَيْهِمُ",189],["21:52:3",326,"لِأَبِيهِ","to his father","إِذْ قَالَ","وَقَوْمِهِۦ مَا هَـٰذِهِ",254],["21:53:3",326,"ءَابَآءَنَا","our forefathers","قَالُوا۟ وَجَدْنَآ","لَهَا عَـٰبِدِينَ",189],["21:54:5",326,"وَءَابَآؤُكُمْ","and your forefathers","لَقَدْ كُنتُمْ أَنتُمْ","فِى ضَلَـٰلٍۢ مُّبِينٍۢ",189],["22:78:16",341,"أَبِيكُمْ","(of) your father","مِنْ حَرَجٍۢ ۚ مِّلَّةَ","إِبْرَٰهِيمَ ۚ هُوَ سَمَّىٰكُمُ",254],["23:24:25",343,"ءَابَآئِنَا","our forefathers","سَمِعْنَا بِهَـٰذَا فِىٓ","ٱلْأَوَّلِينَ",189],["23:68:9",346,"ءَابَآءَهُمُ","(to) their forefathers","مَّا لَمْ يَأْتِ","ٱلْأَوَّلِينَ",189],["23:83:4",347,"وَءَابَآؤُنَا","and our forefathers","لَقَدْ وُعِدْنَا نَحْنُ","هَـٰذَا مِن قَبْلُ",189],["24:31:25",353,"ءَابَآئِهِنَّ","their fathers","إِلَّا لِبُعُولَتِهِنَّ أَوْ","أَوْ ءَابَآءِ بُعُولَتِهِنَّ",189],["24:31:27",353,"ءَابَآءِ","fathers","أَوْ ءَابَآئِهِنَّ أَوْ","بُعُولَتِهِنَّ أَوْ أَبْنَآئِهِنَّ",189],["24:61:22",358,"ءَابَآئِكُمْ","(of) your fathers","بُيُوتِكُمْ أَوْ بُيُوتِ","أَوْ بُيُوتِ أُمَّهَـٰتِكُمْ",189],["25:18:15",361,"وَءَابَآءَهُمْ","and their forefathers","أَوْلِيَآءَ وَلَـٰكِن مَّتَّعْتَهُمْ","حَتَّىٰ نَسُوا۟ ٱلذِّكْرَ",189],["26:26:4",368,"ءَابَآئِكُمُ","(of) your forefathers","قَالَ رَبُّكُمْ وَرَبُّ","ٱلْأَوَّلِينَ",189],["26:70:3",370,"لِأَبِيهِ","to his father","إِذْ قَالَ","وَقَوْمِهِۦ مَا تَعْبُدُونَ",254],["26:74:4",370,"ءَابَآءَنَا","our forefathers","قَالُوا۟ بَلْ وَجَدْنَآ","كَذَٰلِكَ يَفْعَلُونَ",189],["26:76:2",370,"وَءَابَآؤُكُمُ","and your forefathers","أَنتُمْ","ٱلْأَقْدَمُونَ",189],["26:86:2",371,"لِأَبِىٓ","my father","وَٱغْفِرْ","إِنَّهُۥ كَانَ مِنَ",254],["27:67:7",383,"وَءَابَآؤُنَآ","and our forefathers","أَءِذَا كُنَّا تُرَٰبًۭا","أَئِنَّا لَمُخْرَجُونَ",189],["27:68:5",383,"وَءَابَآؤُنَا","and our forefathers","وُعِدْنَا هَـٰذَا نَحْنُ","مِن قَبْلُ إِنْ",189],["28:23:25",388,"وَأَبُونَا","and our father","حَتَّىٰ يُصْدِرَ ٱلرِّعَآءُ ۖ","شَيْخٌۭ كَبِيرٌۭ",254],["28:25:8",388,"أَبِى","my father","ٱسْتِحْيَآءٍۢ قَالَتْ إِنَّ","يَدْعُوكَ لِيَجْزِيَكَ أَجْرَ",254],["28:26:3",388,"يَـٰٓأَبَتِ","O my father","قَالَتْ إِحْدَىٰهُمَا","ٱسْتَـْٔجِرْهُ ۖ إِنَّ خَيْرَ",254],["28:36:16",390,"ءَابَآئِنَا","our forefathers","سَمِعْنَا بِهَـٰذَا فِىٓ","ٱلْأَوَّلِينَ",189],["31:21:14",413,"ءَابَآءَنَآ ۚ","our forefathers","مَا وَجَدْنَا عَلَيْهِ","أَوَلَوْ كَانَ ٱلشَّيْطَـٰنُ",189],["33:5:2",418,"لِـَٔابَآئِهِمْ","by their fathers","ٱدْعُوهُمْ","هُوَ أَقْسَطُ عِندَ",189],["33:5:10",418,"ءَابَآءَهُمْ","their fathers","فَإِن لَّمْ تَعْلَمُوٓا۟","فَإِخْوَٰنُكُمْ فِى ٱلدِّينِ",189],["33:40:4",423,"أَبَآ","(the) father","مَّا كَانَ مُحَمَّدٌ","أَحَدٍۢ مِّن رِّجَالِكُمْ",254],["33:55:5",426,"ءَابَآئِهِنَّ","their fathers","جُنَاحَ عَلَيْهِنَّ فِىٓ","وَلَآ أَبْنَآئِهِنَّ وَلَآ",189],["34:43:17",433,"ءَابَآؤُكُمْ","your forefathers","عَمَّا كَانَ يَعْبُدُ","وَقَالُوا۟ مَا هَـٰذَآ",189],["36:6:5",440,"ءَابَآؤُهُمْ","their forefathers","قَوْمًۭا مَّآ أُنذِرَ","فَهُمْ غَـٰفِلُونَ",189],["37:17:1",446,"أَوَءَابَآؤُنَا","Or our fathers","","ٱلْأَوَّلُونَ",189],["37:69:3",448,"ءَابَآءَهُمْ","their fathers","إِنَّهُمْ أَلْفَوْا۟","ضَآلِّينَ",189],["37:85:3",449,"لِأَبِيهِ","to his father","إِذْ قَالَ","وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ",254],["37:102:17",449,"يَـٰٓأَبَتِ","O my father","مَاذَا تَرَىٰ ۚ قَالَ","ٱفْعَلْ مَا تُؤْمَرُ ۖ",254],["37:126:4",450,"ءَابَآئِكُمُ","(of) your forefathers","ٱللَّهَ رَبَّكُمْ وَرَبَّ","ٱلْأَوَّلِينَ",189],["40:8:10",468,"ءَابَآئِهِمْ","their fathers","وَمَن صَلَحَ مِنْ","وَأَزْوَٰجِهِمْ وَذُرِّيَّـٰتِهِمْ ۚ إِنَّكَ",189],["43:22:5",490,"ءَابَآءَنَا","our forefathers","قَالُوٓا۟ إِنَّا وَجَدْنَآ","عَلَىٰٓ أُمَّةٍۢ وَإِنَّا",189],["43:23:15",491,"ءَابَآءَنَا","our forefathers","مُتْرَفُوهَآ إِنَّا وَجَدْنَآ","عَلَىٰٓ أُمَّةٍۢ وَإِنَّا",189],["43:24:8",491,"ءَابَآءَكُمْ ۖ","your forefathers","مِمَّا وَجَدتُّمْ عَلَيْهِ","قَالُوٓا۟ إِنَّا بِمَآ",189],["43:26:4",491,"لِأَبِيهِ","to his father","وَإِذْ قَالَ إِبْرَٰهِيمُ","وَقَوْمِهِۦٓ إِنَّنِى بَرَآءٌۭ",254],["43:29:4",491,"وَءَابَآءَهُمْ","and their forefathers","بَلْ مَتَّعْتُ هَـٰٓؤُلَآءِ","حَتَّىٰ جَآءَهُمُ ٱلْحَقُّ",189],["44:8:9",496,"ءَابَآئِكُمُ","(of) your fathers","وَيُمِيتُ ۖ رَبُّكُمْ وَرَبُّ","ٱلْأَوَّلِينَ",189],["44:36:2",497,"بِـَٔابَآئِنَآ","our forefathers","فَأْتُوا۟","إِن كُنتُمْ صَـٰدِقِينَ",189],["45:25:13",501,"بِـَٔابَآئِنَآ","our forefathers","أَن قَالُوا۟ ٱئْتُوا۟","إِن كُنتُمْ صَـٰدِقِينَ",189],["53:23:7",526,"وَءَابَآؤُكُم","and your forefathers","أَسْمَآءٌۭ سَمَّيْتُمُوهَآ أَنتُمْ","مَّآ أَنزَلَ ٱللَّهُ",189],["56:48:1",535,"أَوَءَابَآؤُنَا","And also our fathers","","ٱلْأَوَّلُونَ",189],["58:22:15",545,"ءَابَآءَهُمْ","their fathers","وَرَسُولَهُۥ وَلَوْ كَانُوٓا۟","أَوْ أَبْنَآءَهُمْ أَوْ",189],["60:4:36",549,"لِأَبِيهِ","to his father","إِلَّا قَوْلَ إِبْرَٰهِيمَ","لَأَسْتَغْفِرَنَّ لَكَ وَمَآ",254],["80:35:2",585,"وَأَبِيهِ","and his father","وَأُمِّهِۦ","",254],["111:1:3",603,"أَبِى","(of) Abu","تَبَّتْ يَدَآ","لَهَبٍۢ وَتَبَّ",254]]