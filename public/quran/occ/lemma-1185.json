[["28:6:7",386,"وَهَـٰمَـٰنَ","and Haman","ٱلْأَرْضِ وَنُرِىَ فِرْعَوْنَ","وَجُنُودَهُمَا مِنْهُم مَّا",1185],["28:8:10",386,"وَهَـٰمَـٰنَ","and Haman","وَحَزَنًا ۗ إِنَّ فِرْعَوْنَ","وَجُنُودَهُمَا كَانُوا۟ خَـٰطِـِٔينَ",1185],["28:38:13",390,"يَـٰهَـٰمَـٰنُ","O Haman","غَيْرِى فَأَوْقِدْ لِى","عَلَى ٱلطِّينِ فَٱجْعَل",1185],["29:39:3",401,"وَهَـٰمَـٰنَ ۖ","and Haman","وَقَـٰرُونَ وَفِرْعَوْنَ","وَلَقَدْ جَآءَهُم مُّوسَىٰ",1185],["40:24:3",469,"وَهَـٰمَـٰنَ","Haman","إِلَىٰ فِرْعَوْنَ","وَقَـٰرُونَ فَقَالُوا۟ سَـٰحِرٌۭ",1185],["40:36:3",471,"يَـٰهَـٰمَـٰنُ","O Haman","وَقَالَ فِرْعَوْنُ","ٱبْنِ لِى صَرْحًۭا",1185]]