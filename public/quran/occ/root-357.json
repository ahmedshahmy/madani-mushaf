[["2:196:24",30,"أَذًۭى","an ailment","مَّرِيضًا أَوْ بِهِۦٓ","مِّن رَّأْسِهِۦ فَفِدْيَةٌۭ",872],["2:222:6",35,"أَذًۭى","(is) a hurt","ٱلْمَحِيضِ ۖ قُلْ هُوَ","فَٱعْتَزِلُوا۟ ٱلنِّسَآءَ فِى",872],["2:262:14",44,"أَذًۭى ۙ","hurt","أَنفَقُوا۟ مَنًّۭا وَلَآ","لَّهُمْ أَجْرُهُمْ عِندَ",872],["2:263:8",44,"أَذًۭى ۗ","(by) hurt","مِّن صَدَقَةٍۢ يَتْبَعُهَآ","وَٱللَّهُ غَنِىٌّ حَلِيمٌۭ",872],["2:264:8",44,"وَٱلْأَذَىٰ","or [the] hurt","تُبْطِلُوا۟ صَدَقَـٰتِكُم بِٱلْمَنِّ","كَٱلَّذِى يُنفِقُ مَالَهُۥ",872],["3:111:4",64,"أَذًۭى ۖ","a hurt","لَن يَضُرُّوكُمْ إِلَّآ","وَإِن يُقَـٰتِلُوكُمْ يُوَلُّوكُمُ",872],["3:186:15",74,"أَذًۭى","hurtful things","وَمِنَ ٱلَّذِينَ أَشْرَكُوٓا۟","كَثِيرًۭا ۚ وَإِن تَصْبِرُوا۟",872],["3:195:22",76,"وَأُوذُوا۟","and were harmed","وَأُخْرِجُوا۟ مِن دِيَـٰرِهِمْ","فِى سَبِيلِى وَقَـٰتَلُوا۟",619],["4:16:4",80,"فَـَٔاذُوهُمَا ۖ","then punish both of them","وَٱلَّذَانِ يَأْتِيَـٰنِهَا مِنكُمْ","فَإِن تَابَا وَأَصْلَحَا",619],["4:102:46",95,"أَذًۭى","any trouble","إِن كَانَ بِكُمْ","مِّن مَّطَرٍ أَوْ",872],["6:34:10",131,"وَأُوذُوا۟","and they were harmed","عَلَىٰ مَا كُذِّبُوا۟","حَتَّىٰٓ أَتَىٰهُمْ نَصْرُنَا ۚ",619],["7:129:2",165,"أُوذِينَا","We have been harmed","قَالُوٓا۟","مِن قَبْلِ أَن",619],["9:61:3",196,"يُؤْذُونَ","hurt","وَمِنْهُمُ ٱلَّذِينَ","ٱلنَّبِىَّ وَيَقُولُونَ هُوَ",619],["9:61:21",196,"يُؤْذُونَ","hurt","ءَامَنُوا۟ مِنكُمْ ۚ وَٱلَّذِينَ","رَسُولَ ٱللَّهِ لَهُمْ",619],["14:12:13",257,"ءَاذَيْتُمُونَا ۚ","harm you may cause us","وَلَنَصْبِرَنَّ عَلَىٰ مَآ","وَعَلَى ٱللَّهِ فَلْيَتَوَكَّلِ",619],["29:10:8",397,"أُوذِىَ","he is harmed","ءَامَنَّا بِٱللَّهِ فَإِذَآ","فِى ٱللَّهِ جَعَلَ",619],["33:48:6",424,"أَذَىٰهُمْ","their harm","ٱلْكَـٰفِرِينَ وَٱلْمُنَـٰفِقِينَ وَدَعْ","وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ",872],["33:53:30",425,"يُؤْذِى","troubling","إِنَّ ذَٰلِكُمْ كَانَ","ٱلنَّبِىَّ فَيَسْتَحْىِۦ مِنكُمْ ۖ",619],["33:53:54",425,"تُؤْذُوا۟","you trouble","كَانَ لَكُمْ أَن","رَسُولَ ٱللَّهِ وَلَآ",619],["33:57:3",426,"يُؤْذُونَ","annoy","إِنَّ ٱلَّذِينَ","ٱللَّهَ وَرَسُولَهُۥ لَعَنَهُمُ",619],["33:58:2",426,"يُؤْذُونَ","harm","وَٱلَّذِينَ","ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ بِغَيْرِ",619],["33:59:17",426,"يُؤْذَيْنَ ۗ","harmed","أَن يُعْرَفْنَ فَلَا","وَكَانَ ٱللَّهُ غَفُورًۭا",619],["33:69:7",427,"ءَاذَوْا۟","abused","لَا تَكُونُوا۟ كَٱلَّذِينَ","مُوسَىٰ فَبَرَّأَهُ ٱللَّهُ",619],["61:5:7",551,"تُؤْذُونَنِى","do you hurt me","لِقَوْمِهِۦ يَـٰقَوْمِ لِمَ","وَقَد تَّعْلَمُونَ أَنِّى",619]]