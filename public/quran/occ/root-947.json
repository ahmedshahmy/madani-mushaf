[["3:154:62",70,"مَضَاجِعِهِمْ ۖ","their places of death","عَلَيْهِمُ ٱلْقَتْلُ إِلَىٰ","وَلِيَبْتَلِىَ ٱللَّهُ مَا",1878],["4:34:28",84,"ٱلْمَضَاجِعِ","the bed","فَعِظُوهُنَّ وَٱهْجُرُوهُنَّ فِى","وَٱضْرِبُوهُنَّ ۖ فَإِنْ أَطَعْنَكُمْ",1878],["32:16:4",416,"ٱلْمَضَاجِعِ","(their) beds","تَتَجَافَىٰ جُنُوبُهُمْ عَنِ","يَدْعُونَ رَبَّهُمْ خَوْفًۭا",1878]]