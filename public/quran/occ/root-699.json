[["27:18:14",378,"يَحْطِمَنَّكُمْ","lest not crush you","ٱدْخُلُوا۟ مَسَـٰكِنَكُمْ لَا","سُلَيْمَـٰنُ وَجُنُودُهُۥ وَهُمْ",4610],["39:21:25",460,"حُطَـٰمًا ۚ","debris","مُصْفَرًّۭا ثُمَّ يَجْعَلُهُۥ","إِنَّ فِى ذَٰلِكَ",1790],["56:65:4",536,"حُطَـٰمًۭا","debris","لَوْ نَشَآءُ لَجَعَلْنَـٰهُ","فَظَلْتُمْ تَفَكَّهُونَ",1790],["57:20:25",540,"حُطَـٰمًۭا ۖ","debris","مُصْفَرًّۭا ثُمَّ يَكُونُ","وَفِى ٱلْـَٔاخِرَةِ عَذَابٌۭ",1790],["104:4:4",601,"ٱلْحُطَمَةِ","the Crusher","كَلَّا ۖ لَيُنۢبَذَنَّ فِى","",2281],["104:5:4",601,"ٱلْحُطَمَةُ","the Crusher (is)","وَمَآ أَدْرَىٰكَ مَا","",2281]]