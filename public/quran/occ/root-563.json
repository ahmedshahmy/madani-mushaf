[["2:17:4",4,"ٱسْتَوْقَدَ","kindled","مَثَلُهُمْ كَمَثَلِ ٱلَّذِى","نَارًۭا فَلَمَّآ أَضَآءَتْ",4836],["2:24:9",4,"وَقُودُهَا","[its] fuel","فَٱتَّقُوا۟ ٱلنَّارَ ٱلَّتِى","ٱلنَّاسُ وَٱلْحِجَارَةُ ۖ أُعِدَّتْ",1659],["3:10:15",51,"وَقُودُ","(the) fuel","شَيْـًۭٔا ۖ وَأُو۟لَـٰٓئِكَ هُمْ","ٱلنَّارِ",1659],["5:64:35",118,"أَوْقَدُوا۟","they kindled","يَوْمِ ٱلْقِيَـٰمَةِ ۚ كُلَّمَآ","نَارًۭا لِّلْحَرْبِ أَطْفَأَهَا",1285],["13:17:13",251,"يُوقِدُونَ","they heat","زَبَدًۭا رَّابِيًۭا ۚ وَمِمَّا","عَلَيْهِ فِى ٱلنَّارِ",1285],["24:35:17",354,"يُوقَدُ","(which) is lit","كَأَنَّهَا كَوْكَبٌۭ دُرِّىٌّۭ","مِن شَجَرَةٍۢ مُّبَـٰرَكَةٍۢ",1285],["28:38:11",390,"فَأَوْقِدْ","So kindle","مِّنْ إِلَـٰهٍ غَيْرِى","لِى يَـٰهَـٰمَـٰنُ عَلَى",1285],["36:80:11",445,"تُوقِدُونَ","ignite","فَإِذَآ أَنتُم مِّنْهُ","",1285],["66:6:8",560,"وَقُودُهَا","whose fuel","أَنفُسَكُمْ وَأَهْلِيكُمْ نَارًۭا","ٱلنَّاسُ وَٱلْحِجَارَةُ عَلَيْهَا",1659],["85:5:3",590,"ٱلْوَقُودِ","(of) the fuel","ٱلنَّارِ ذَاتِ","",1659],["104:6:3",601,"ٱلْمُوقَدَةُ","kindled","نَارُ ٱللَّهِ","",3889]]