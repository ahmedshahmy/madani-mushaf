[["2:29:14",5,"سَبْعَ","seven","إِلَى ٱلسَّمَآءِ فَسَوَّىٰهُنَّ","سَمَـٰوَٰتٍۢ ۚ وَهُوَ بِكُلِّ",460],["2:196:53",30,"وَسَبْعَةٍ","and seven (days)","أَيَّامٍۢ فِى ٱلْحَجِّ","إِذَا رَجَعْتُمْ ۗ تِلْكَ",1634],["2:261:11",44,"سَبْعَ","seven","كَمَثَلِ حَبَّةٍ أَنۢبَتَتْ","سَنَابِلَ فِى كُلِّ",460],["5:3:18",107,"ٱلسَّبُعُ","the wild animal","وَٱلنَّطِيحَةُ وَمَآ أَكَلَ","إِلَّا مَا ذَكَّيْتُمْ",4296],["7:155:4",169,"سَبْعِينَ","seventy","وَٱخْتَارَ مُوسَىٰ قَوْمَهُۥ","رَجُلًۭا لِّمِيقَـٰتِنَا ۖ فَلَمَّآ",460],["9:80:10",200,"سَبْعِينَ","seventy","إِن تَسْتَغْفِرْ لَهُمْ","مَرَّةًۭ فَلَن يَغْفِرَ",460],["12:43:5",240,"سَبْعَ","seven","ٱلْمَلِكُ إِنِّىٓ أَرَىٰ","بَقَرَٰتٍۢ سِمَانٍۢ يَأْكُلُهُنَّ",460],["12:43:9",240,"سَبْعٌ","seven","بَقَرَٰتٍۢ سِمَانٍۢ يَأْكُلُهُنَّ","عِجَافٌۭ وَسَبْعَ سُنۢبُلَـٰتٍ",460],["12:43:11",240,"وَسَبْعَ","and seven","يَأْكُلُهُنَّ سَبْعٌ عِجَافٌۭ","سُنۢبُلَـٰتٍ خُضْرٍۢ وَأُخَرَ",460],["12:46:6",241,"سَبْعِ","(the) seven","ٱلصِّدِّيقُ أَفْتِنَا فِى","بَقَرَٰتٍۢ سِمَانٍۢ يَأْكُلُهُنَّ",460],["12:46:10",241,"سَبْعٌ","seven","بَقَرَٰتٍۢ سِمَانٍۢ يَأْكُلُهُنَّ","عِجَافٌۭ وَسَبْعِ سُنۢبُلَـٰتٍ",460],["12:46:12",241,"وَسَبْعِ","and seven","يَأْكُلُهُنَّ سَبْعٌ عِجَافٌۭ","سُنۢبُلَـٰتٍ خُضْرٍۢ وَأُخَرَ",460],["12:47:3",241,"سَبْعَ","(for) seven","قَالَ تَزْرَعُونَ","سِنِينَ دَأَبًۭا فَمَا",460],["12:48:6",241,"سَبْعٌۭ","seven","مِنۢ بَعْدِ ذَٰلِكَ","شِدَادٌۭ يَأْكُلْنَ مَا",460],["15:44:2",264,"سَبْعَةُ","(are) seven","لَهَا","أَبْوَٰبٍۢ لِّكُلِّ بَابٍۢ",1634],["15:87:3",266,"سَبْعًۭا","seven","وَلَقَدْ ءَاتَيْنَـٰكَ","مِّنَ ٱلْمَثَانِى وَٱلْقُرْءَانَ",460],["17:44:4",286,"ٱلسَّبْعُ","the seven heavens","تُسَبِّحُ لَهُ ٱلسَّمَـٰوَٰتُ","وَٱلْأَرْضُ وَمَن فِيهِنَّ ۚ",460],["18:22:12",296,"سَبْعَةٌۭ","(they were) seven","رَجْمًۢا بِٱلْغَيْبِ ۖ وَيَقُولُونَ","وَثَامِنُهُمْ كَلْبُهُمْ ۚ قُل",1634],["23:17:4",342,"سَبْعَ","seven","وَلَقَدْ خَلَقْنَا فَوْقَكُمْ","طَرَآئِقَ وَمَا كُنَّا",460],["23:86:5",347,"ٱلسَّبْعِ","(of) the seven heavens","مَن رَّبُّ