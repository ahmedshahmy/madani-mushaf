[["3:14:24",51,"ٱلْمَـَٔابِ","[the] abode to return","وَٱللَّهُ عِندَهُۥ حُسْنُ","",908],["13:29:8",253,"مَـَٔابٍۢ","place of return","طُوبَىٰ لَهُمْ وَحُسْنُ","",908],["13:36:25",254,"مَـَٔابِ","(is) my return","إِلَيْهِ أَدْعُوا۟ وَإِلَيْهِ","",908],["17:25:11",284,"لِلْأَوَّٰبِينَ","to those who often turn (to Him)","صَـٰلِحِينَ فَإِنَّهُۥ كَانَ","غَفُورًۭا",1142],["34:10:7",429,"أَوِّبِى","Repeat praises","مِنَّا فَضْلًۭا ۖ يَـٰجِبَالُ","مَعَهُۥ وَٱلطَّيْرَ ۖ وَأَلَنَّا",3053],["38:17:11",454,"أَوَّابٌ","repeatedly turning","ذَا ٱلْأَيْدِ ۖ إِنَّهُۥٓ","",1142],["38:19:5",454,"أَوَّابٌۭ","repeatedly turning","مَحْشُورَةًۭ ۖ كُلٌّۭ لَّهُۥٓ","",1142],["38:25:9",454,"مَـَٔابٍۢ","place of return","عِندَنَا لَزُلْفَىٰ وَحُسْنَ","",908],["38:30:7",455,"أَوَّابٌ","(was) one who repeatedly turned","نِعْمَ ٱلْعَبْدُ ۖ إِنَّهُۥٓ","",1142],["38:40:6",455,"مَـَٔابٍۢ","place of return","عِندَنَا لَزُلْفَىٰ وَحُسْنَ","",908],["38:44:14",456,"أَوَّابٌۭ","repeatedly turned","نِّعْمَ ٱلْعَبْدُ ۖ إِنَّهُۥٓ","",1142],["38:49:6",456,"مَـَٔابٍۢ","place of return","وَإِنَّ لِلْمُتَّقِينَ لَحُسْنَ","",908],["38:55:5",456,"مَـَٔابٍۢ","place of return","وَإِنَّ لِلطَّـٰغِينَ لَشَرَّ","",908],["50:32:5",519,"أَوَّابٍ","who turns","مَا تُوعَدُونَ لِكُلِّ","حَفِيظٍۢ",1142],["78:22:2",582,"مَـَٔابًۭا","a place of return","لِّلطَّـٰغِينَ","",908],["78:39:9",583,"مَـَٔابًا","a return","ٱتَّخَذَ إِلَىٰ رَبِّهِۦ","",908],["88:25:3",593,"إِيَابَهُمْ","(will be) their return","إِنَّ إِلَيْنَآ","",2940]]