[["2:196:49",30,"ثَلَـٰثَةِ","(of) three","لَّمْ يَجِدْ فَصِيَامُ","أَيَّامٍۢ فِى ٱلْحَجِّ",699],["2:228:4",36,"ثَلَـٰثَةَ","(for) three","وَٱلْمُطَلَّقَـٰتُ يَتَرَبَّصْنَ بِأَنفُسِهِنَّ","قُرُوٓءٍۢ ۚ وَلَا يَحِلُّ",699],["3:41:11",55,"ثَلَـٰثَةَ","(for) three","أَلَّا تُكَلِّمَ ٱلنَّاسَ","أَيَّامٍ إِلَّا رَمْزًۭا ۗ",699],["3:124:9",66,"بِثَلَـٰثَةِ","with three","أَن يُمِدَّكُمْ رَبُّكُم","ءَالَـٰفٍۢ مِّنَ ٱلْمَلَـٰٓئِكَةِ",699],["4:3:14",77,"وَثُلَـٰثَ","or three","مِّنَ ٱلنِّسَآءِ مَثْنَىٰ","وَرُبَـٰعَ ۖ فَإِنْ خِفْتُمْ",2703],["4:11:15",78,"ثُلُثَا","two thirds","فَوْقَ ٱثْنَتَيْنِ فَلَهُنَّ","مَا تَرَكَ ۖ وَإِن",1239],["4:11:42",78,"ٱلثُّلُثُ ۚ","(is) one third","وَوَرِثَهُۥٓ أَبَوَاهُ فَلِأُمِّهِ","فَإِن كَانَ لَهُۥٓ",1239],["4:12:73",79,"ٱلثُّلُثِ ۚ","the third","فَهُمْ شُرَكَآءُ فِى","مِنۢ بَعْدِ وَصِيَّةٍۢ",1239],["4:171:31",105,"ثَلَـٰثَةٌ ۚ","Three","وَرُسُلِهِۦ ۖ وَلَا تَقُولُوا۟","ٱنتَهُوا۟ خَيْرًۭا لَّكُمْ ۚ",699],["4:176:30",106,"ٱلثُّلُثَانِ","two thirds","كَانَتَا ٱثْنَتَيْنِ فَلَهُمَا","مِمَّا تَرَكَ ۚ وَإِن",1239],["5:73:7",120,"ثَالِثُ","(is the) third","قَالُوٓا۟ إِنَّ ٱللَّهَ","ثَلَـٰثَةٍۢ ۘ وَمَا مِنْ",2699],["5:73:8",120,"ثَلَـٰثَةٍۢ ۘ","(of) three","إِنَّ ٱللَّهَ ثَالِثُ","وَمَا مِنْ إِلَـٰهٍ",699],["5:89:30",122,"ثَلَـٰثَةِ","(for) three","لَّمْ يَجِدْ فَصِيَامُ","أَيَّامٍۢ ۚ ذَٰلِكَ كَفَّـٰرَةُ",699],["7:142:3",167,"ثَلَـٰثِينَ","thirty","۞ وَوَٰعَدْنَا مُوسَىٰ","لَيْلَةًۭ وَأَتْمَمْنَـٰهَا بِعَشْرٍۢ",1004],["9:118:2",206,"ٱلثَّلَـٰثَةِ","the three","وَعَلَى","ٱلَّذِينَ خُلِّفُوا۟ حَتَّىٰٓ",699],["11:65:6",229,"ثَلَـٰثَةَ","(for) three","تَمَتَّعُوا۟ فِى دَارِكُمْ","أَيَّامٍۢ ۖ ذَٰلِكَ وَعْدٌ",699],["18:22:2",296,"ثَلَـٰثَةٌۭ","(they were) three","سَيَقُولُونَ","رَّابِعُهُمْ كَلْبُهُمْ وَيَقُولُونَ",699],["18:25:4",296,"ثَلَـٰثَ","(for) three","وَلَبِثُوا۟ فِى كَهْفِهِمْ","مِا۟ئَةٍۢ سِنِينَ وَٱزْدَادُوا۟",1004],["19:10:11",305,"ثَلَـٰثَ","(for) three","أَلَّا تُكَلِّمَ ٱلنَّاسَ","لَيَالٍۢ سَوِيًّۭا",1004],["24:58:13",357,"ثَلَـٰثَ","(at) three","يَبْلُغُوا۟ ٱلْحُلُمَ مِنكُمْ","مَرَّٰتٍۢ ۚ مِّن قَبْلِ",1004],["24:58:28",357,"ثَلَـٰثُ","(These) three","بَعْدِ صَلَوٰةِ ٱلْعِشَآءِ ۚ","عَوْرَٰتٍۢ لَّكُمْ ۚ لَيْسَ",1004],["35:1:12",434,"وَثُلَـٰثَ","or three","أُو۟لِىٓ أَجْنِحَةٍۢ مَّثْنَىٰ","وَرُبَـٰعَ ۚ يَزِيدُ فِى",2703],["36:14:7",441,"بِثَالِثٍۢ","with a third","ٱثْنَيْنِ فَكَذَّبُوهُمَا فَعَزَّزْنَا","فَقَالُوٓا۟ إِنَّآ إِلَيْكُم",2699],["39:6:25",459,"ثَلَـٰثٍۢ ۚ","three","خَلْقٍۢ فِى ظُلُمَـٰتٍۢ","ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ",1004],["46:15:12",504,"ثَلَـٰثُونَ","(is) thirty","كُرْهًۭا ۖ وَحَمْلُهُۥ وَفِصَـٰلُهُۥ","شَهْرًا ۚ حَتَّىٰٓ إِذَا",1004],["53:20:2",526,"ٱلثَّالِثَةَ","the third","وَمَنَوٰةَ","ٱلْأُخْرَىٰٓ",4503],["56:7:3",534,"ثَلَـٰثَةًۭ","three","وَكُنتُمْ أَزْوَٰجًۭا","",699],["58:7:16",543,"ثَلَـٰثَةٍ","(of) three","يَكُونُ مِن نَّجْوَىٰ","إِلَّا هُوَ رَابِعُهُمْ",699],["65:4:10",558,"ثَلَـٰثَةُ","(is) three","إِنِ ٱرْتَبْتُمْ فَعِدَّتُهُنَّ","أَشْهُرٍۢ وَٱلَّـٰٓـِٔى لَمْ",699],["73:20:8",575,"ثُلُثَىِ","two-thirds","تَقُومُ أَدْنَىٰ مِن","ٱلَّيْلِ وَنِصْفَهُۥ وَثُلُثَهُۥ",1239],["73:20:11",575,"وَثُلُثَهُۥ","and a third of it","ثُلُثَىِ ٱلَّيْلِ وَنِصْفَهُۥ","وَطَآئِفَةٌۭ مِّنَ ٱلَّذِينَ",1239],["77:30:5",581,"ثَلَـٰثِ","three","إِلَىٰ ظِلٍّۢ ذِى","شُعَبٍۢ",1004]]