[["2:48:12",7,"شَفَـٰعَةٌۭ","any intercession","وَلَا يُقْبَلُ مِنْهَا","وَلَا يُؤْخَذُ مِنْهَا",676],["2:123:15",19,"شَفَـٰعَةٌۭ","any intercession","عَدْلٌۭ وَلَا تَنفَعُهَا","وَلَا هُمْ يُنصَرُونَ",676],["2:254:18",42,"شَفَـٰعَةٌۭ ۗ","intercession","وَلَا خُلَّةٌۭ وَلَا","وَٱلْكَـٰفِرُونَ هُمُ ٱلظَّـٰلِمُونَ",676],["2:255:23",42,"يَشْفَعُ","can intercede","مَن ذَا ٱلَّذِى","عِندَهُۥٓ إِلَّا بِإِذْنِهِۦ ۚ",1426],["4:85:2",91,"يَشْفَعْ","intercedes","مَّن","شَفَـٰعَةً حَسَنَةًۭ يَكُن",1426],["4:85:3",91,"شَفَـٰعَةً","an intercession","مَّن يَشْفَعْ","حَسَنَةًۭ يَكُن لَّهُۥ",676],["4:85:10",91,"يَشْفَعْ","intercedes","نَصِيبٌۭ مِّنْهَا ۖ وَمَن","شَفَـٰعَةًۭ سَيِّئَةًۭ يَكُن",1426],["4:85:11",91,"شَفَـٰعَةًۭ","an intercession","مِّنْهَا ۖ وَمَن يَشْفَعْ","سَيِّئَةًۭ يَكُن لَّهُۥ",676],["6:51:15",133,"شَفِيعٌۭ","any intercessor","دُونِهِۦ وَلِىٌّۭ وَلَا","لَّعَلَّهُمْ يَتَّقُونَ",809],["6:70:24",136,"شَفِيعٌۭ","any intercessor","ٱللَّهِ وَلِىٌّۭ وَلَا","وَإِن تَعْدِلْ كُلَّ",809],["6:94:16",139,"شُفَعَآءَكُمُ","your intercessors","وَمَا نَرَىٰ مَعَكُمْ","ٱلَّذِينَ زَعَمْتُمْ أَنَّهُمْ",809],["7:53:21",157,"شُفَعَآءَ","intercessors","فَهَل لَّنَا مِن","فَيَشْفَعُوا۟ لَنَآ أَوْ",809],["7:53:22",157,"فَيَشْفَعُوا۟","so (that) they intercede","لَّنَا مِن شُفَعَآءَ","لَنَآ أَوْ نُرَدُّ",1426],["10:3:19",208,"شَفِيعٍ","(is) any intercessor","ٱلْأَمْرَ ۖ مَا مِن","إِلَّا مِنۢ بَعْدِ",809],["10:18:12",210,"شُفَعَـٰٓؤُنَا","(are) our intercessors","يَنفَعُهُمْ وَيَقُولُونَ هَـٰٓؤُلَآءِ","عِندَ ٱللَّهِ ۚ قُلْ",809],["19:87:3",311,"ٱلشَّفَـٰعَةَ","(of) the intercession","لَّا يَمْلِكُونَ","إِلَّا مَنِ ٱتَّخَذَ",676],["20:109:4",319,"ٱلشَّفَـٰعَةُ","the intercession","يَوْمَئِذٍۢ لَّا تَنفَعُ","إِلَّا مَنْ أَذِنَ",676],["21:28:8",324,"يَشْفَعُونَ","they (can) intercede","وَمَا خَلْفَهُمْ وَلَا","إِلَّا لِمَنِ ٱرْتَضَىٰ",1426],["26:100:4",371,"شَـٰفِعِينَ","intercessors","فَمَا لَنَا مِن","",2114],["30:13:6",405,"شُفَعَـٰٓؤُا۟","any intercessors","لَّهُم مِّن شُرَكَآئِهِمْ","وَكَانُوا۟ بِشُرَكَآئِهِمْ كَـٰفِرِينَ",809],["32:4:22",415,"شَفِيعٍ ۚ","any intercessor","مِن وَلِىٍّۢ وَلَا","أَفَلَا تَتَذَكَّرُونَ",809],["34:23:3",431,"ٱلشَّفَـٰعَةُ","the intercession","وَلَا تَنفَعُ","عِندَهُۥٓ إِلَّا لِمَنْ",676],["36:23:12",441,"شَفَـٰعَتُهُمْ","their intercession","لَّا تُغْنِ عَنِّى","شَيْـًۭٔا وَلَا يُنقِذُونِ",676],["39:43:6",463,"شُفَعَآءَ ۚ","intercessors","مِن دُونِ ٱللَّهِ","قُلْ أَوَلَوْ كَانُوا۟",809],["39:44:3",463,"ٱلشَّفَـٰعَةُ","the intercession","قُل لِّلَّهِ","جَمِيعًۭا ۖ لَّهُۥ مُلْكُ",676],["40:18:14",469,"شَفِيعٍۢ","intercessor","مِنْ حَمِيمٍۢ وَلَا","يُطَاعُ",809],["43:86:7",495,"ٱلشَّفَـٰعَةَ","(for) the intercession","يَدْعُونَ مِن دُونِهِ","إِلَّا مَن شَهِدَ",676],["53:26:8",526,"شَفَـٰعَتُهُمْ","their intercession","ٱلسَّمَـٰوَٰتِ لَا تُغْنِى","شَيْـًٔا إِلَّا مِنۢ",676],["74:48:3",577,"شَفَـٰعَةُ","intercession","فَمَا تَنفَعُهُمْ","ٱلشَّـٰفِعِينَ",676],["74:48:4",577,"ٱلشَّـٰفِعِينَ","(of) the intercessors","فَمَا تَنفَعُهُمْ شَفَـٰعَةُ","",2114],["89:3:1",593,"وَٱلشَّفْعِ","And the even","","وَٱلْوَتْرِ",2898]]