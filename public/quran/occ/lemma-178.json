[["2:124:3",19,"إِبْرَٰهِـۧمَ","Ibrahim","۞ وَإِذِ ٱبْتَلَىٰٓ","رَبُّهُۥ بِكَلِمَـٰتٍۢ فَأَتَمَّهُنَّ ۖ",178],["2:125:10",19,"إِبْرَٰهِـۧمَ","(of) Ibrahim","وَٱتَّخِذُوا۟ مِن مَّقَامِ","مُصَلًّۭى ۖ وَعَهِدْنَآ إِلَىٰٓ",178],["2:125:14",19,"إِبْرَٰهِـۧمَ","Ibrahim","مُصَلًّۭى ۖ وَعَهِدْنَآ إِلَىٰٓ","وَإِسْمَـٰعِيلَ أَن طَهِّرَا",178],["2:126:3",19,"إِبْرَٰهِـۧمُ","Ibrahim","وَإِذْ قَالَ","رَبِّ ٱجْعَلْ هَـٰذَا",178],["2:127:3",20,"إِبْرَٰهِـۧمُ","Ibrahim","وَإِذْ يَرْفَعُ","ٱلْقَوَاعِدَ مِنَ ٱلْبَيْتِ",178],["2:130:5",20,"إِبْرَٰهِـۧمَ","(of) Ibrahim","يَرْغَبُ عَن مِّلَّةِ","إِلَّا مَن سَفِهَ",178],["2:132:3",20,"إِبْرَٰهِـۧمُ","Ibrahim","وَوَصَّىٰ بِهَآ","بَنِيهِ وَيَعْقُوبُ يَـٰبَنِىَّ",178],["2:133:20",20,"إِبْرَٰهِـۧمَ","Ibrahim","إِلَـٰهَكَ وَإِلَـٰهَ ءَابَآئِكَ","وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ إِلَـٰهًۭا",178],["2:135:10",21,"إِبْرَٰهِـۧمَ","(of) Ibrahim","قُلْ بَلْ مِلَّةَ","حَنِيفًۭا ۖ وَمَا كَانَ",178],["2:136:10",21,"إِبْرَٰهِـۧمَ","Ibrahim","وَمَآ أُنزِلَ إِلَىٰٓ","وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ وَيَعْقُوبَ",178],["2:140:4",21,"إِبْرَٰهِـۧمَ","Ibrahim","أَمْ تَقُولُونَ إِنَّ","وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ وَيَعْقُوبَ",178],["2:258:6",43,"إِبْرَٰهِـۧمَ","(with) Ibrahim","إِلَى ٱلَّذِى حَآجَّ","فِى رَبِّهِۦٓ أَنْ",178],["2:258:15",43,"إِبْرَٰهِـۧمُ","Ibrahim","ٱلْمُلْكَ إِذْ قَالَ","رَبِّىَ ٱلَّذِى يُحْىِۦ",178],["2:258:25",43,"إِبْرَٰهِـۧمُ","Ibrahim","أُحْىِۦ وَأُمِيتُ ۖ قَالَ","فَإِنَّ ٱللَّهَ يَأْتِى",178],["2:260:3",44,"إِبْرَٰهِـۧمُ","Ibrahim","وَإِذْ قَالَ","رَبِّ أَرِنِى كَيْفَ",178],["3:33:7",54,"إِبْرَٰهِيمَ","(of) Ibrahim","ءَادَمَ وَنُوحًۭا وَءَالَ","وَءَالَ عِمْرَٰنَ عَلَى",178],["3:65:6",58,"إِبْرَٰهِيمَ","Ibrahim","لِمَ تُحَآجُّونَ فِىٓ","وَمَآ أُنزِلَتِ ٱلتَّوْرَىٰةُ",178],["3:67:3",58,"إِبْرَٰهِيمُ","Ibrahim","مَا كَانَ","يَهُودِيًّۭا وَلَا نَصْرَانِيًّۭا",178],["3:68:4",58,"بِإِبْرَٰهِيمَ","with Ibrahim","إِنَّ أَوْلَى ٱلنَّاسِ","لَلَّذِينَ ٱتَّبَعُوهُ وَهَـٰذَا",178],["3:84:10",61,"إِبْرَٰهِيمَ","Ibrahim","وَمَآ أُنزِلَ عَلَىٰٓ","وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ وَيَعْقُوبَ",178],["3:95:6",62,"إِبْرَٰهِيمَ","(of) Ibrahim","ٱللَّهُ ۗ فَٱتَّبِعُوا۟ مِلَّةَ","حَنِيفًۭا وَمَا كَانَ",178],["3:97:5",62,"إِبْرَٰهِيمَ ۖ","(of) Ibrahim","ءَايَـٰتٌۢ بَيِّنَـٰتٌۭ مَّقَامُ","وَمَن دَخَلَهُۥ كَانَ",178],["4:54:13",87,"إِبْرَٰهِيمَ","(of) Ibrahim","فَقَدْ ءَاتَيْنَآ ءَالَ","ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ وَءَاتَيْنَـٰهُم",178],["4:125:12",98,"إِبْرَٰهِيمَ","(of) Ibrahim","مُحْسِنٌۭ وَٱتَّبَعَ مِلَّةَ","حَنِيفًۭا ۗ وَٱتَّخَذَ ٱللَّهُ",178],["4:125:16",98,"إِبْرَٰهِيمَ","Ibrahim","حَنِيفًۭا ۗ وَٱتَّخَذَ ٱللَّهُ","خَلِيلًۭا",178],["4:163:13",104,"إِبْرَٰهِيمَ","Ibrahim","بَعْدِهِۦ ۚ وَأَوْحَيْنَآ إِلَىٰٓ","وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ وَيَعْقُوبَ",178],["6:74:3",137,"إِبْرَٰهِيمُ","Ibrahim","۞ وَإِذْ قَالَ","لِأَبِيهِ ءَازَرَ أَتَتَّخِذُ",178],["6:75:3",137,"إِبْرَٰهِيمَ","Ibrahim","وَكَذَٰلِكَ نُرِىٓ","مَلَكُوتَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ",178],["6:83:4",138,"إِبْرَٰهِيمَ","(to) Ibrahim","وَتِلْكَ حُجَّتُنَآ ءَاتَيْنَـٰهَآ","عَلَىٰ قَوْمِهِۦ ۚ نَرْفَعُ",178],["6:161:11",150,"إِبْرَٰهِيمَ","(of) Ibrahim","دِينًۭا قِيَمًۭا مِّلَّةَ","حَنِيفًۭا ۚ وَمَا كَانَ",178],["9:70:12",198,"إِبْرَٰهِيمَ","(of) Ibrahim","وَعَادٍۢ وَثَمُودَ وَقَوْمِ","وَأَصْحَـٰبِ مَدْيَنَ وَٱلْمُؤْتَفِكَـٰتِ ۚ",178],["9:114:4",205,"إِبْرَٰهِيمَ","(by) Ibrahim","وَمَا كَانَ ٱسْتِغْفَارُ","لِأَبِيهِ إِلَّا عَن",178],["9:114:20",205,"إِبْرَٰهِيمَ","Ibrahim","تَبَرَّأَ مِنْهُ ۚ إِنَّ","لَأَوَّٰهٌ حَلِيمٌۭ",178],["11:69:4",229,"إِبْرَٰهِيمَ","(to) Ibrahim","وَلَقَدْ جَآءَتْ رُسُلُنَآ","بِٱلْبُشْرَىٰ قَالُوا۟ سَلَـٰمًۭا ۖ",178],["11:74:4",230,"إِبْرَٰهِيمَ","Ibrahim","فَلَمَّا ذَهَبَ عَنْ","ٱلرَّوْعُ وَجَآءَتْهُ ٱلْبُشْرَىٰ",178],["11:75:2",230,"إِبْرَٰهِيمَ","Ibrahim","إِنَّ","لَحَلِيمٌ أَوَّٰهٌۭ مُّنِيبٌۭ",178],["11:76:1",230,"يَـٰٓإِبْرَٰهِيمُ","O Ibrahim","","أَعْرِضْ عَنْ هَـٰذَآ ۖ",178],["12:6:20",236,"إِبْرَٰهِيمَ","Ibrahim","أَبَوَيْكَ مِن قَبْلُ","وَإِسْحَـٰقَ ۚ إِنَّ رَبَّكَ",178],["12:38:4",240,"إِبْرَٰهِيمَ","Ibrahim","وَٱتَّبَعْتُ مِلَّةَ ءَابَآءِىٓ","وَإِسْحَـٰقَ وَيَعْقُوبَ ۚ مَا",178],["14:35:3",260,"إِبْرَٰهِيمُ","Ibrahim","وَإِذْ قَالَ","رَبِّ ٱجْعَلْ هَـٰذَا",178],["15:51:4",264,"إِبْرَٰهِيمَ","(of) Ibrahim","وَنَبِّئْهُمْ عَن ضَيْفِ","",178],["16:120:2",281,"إِبْرَٰهِيمَ","Ibrahim","إِنَّ","كَانَ أُمَّةًۭ قَانِتًۭا",178],["16:123:7",281,"إِبْرَٰهِيمَ","(of) Ibrahim","أَنِ ٱتَّبِعْ مِلَّةَ","حَنِيفًۭا ۖ وَمَا كَانَ",178],["19:41:4",308,"إِبْرَٰهِيمَ ۚ","Ibrahim","وَٱذْكُرْ فِى ٱلْكِتَـٰبِ","إِنَّهُۥ كَانَ صِدِّيقًۭا",178],["19:46:6",308,"يَـٰٓإِبْرَٰهِيمُ ۖ","O Ibrahim","أَنتَ عَنْ ءَالِهَتِى","لَئِن لَّمْ تَنتَهِ",178],["19:58:17",309,"إِبْرَٰهِيمَ","(of) Ibrahim","نُوحٍۢ وَمِن ذُرِّيَّةِ","وَإِسْرَٰٓءِيلَ وَمِمَّنْ هَدَيْنَا",178],["21:51:3",326,"إِبْرَٰهِيمَ","Ibrahim","۞ وَلَقَدْ ءَاتَيْنَآ","رُشْدَهُۥ مِن قَبْلُ",178],["21:60:7",327,"إِبْرَٰهِيمُ","Ibrahim","يَذْكُرُهُمْ يُقَالُ لَهُۥٓ","",178],["21:62:6",327,"يَـٰٓإِبْرَٰهِيمُ","O Ibrahim","فَعَلْتَ هَـٰذَا بِـَٔالِهَتِنَا","",178],["21:69:7",327,"إِبْرَٰهِيمَ","Ibrahim","بَرْدًۭا وَسَلَـٰمًا عَلَىٰٓ","",178],["22:26:3",335,"لِإِبْرَٰهِيمَ","to Ibrahim","وَإِذْ بَوَّأْنَا","مَكَانَ ٱلْبَيْتِ أَن",178],["22:43:2",337,"إِبْرَٰهِيمَ","(of) Ibrahim","وَقَوْمُ","وَقَوْمُ لُوطٍۢ",178],["22:78:17",341,"إِبْرَٰهِيمَ ۚ","Ibrahim","حَرَجٍۢ ۚ مِّلَّةَ أَبِيكُمْ","هُوَ سَمَّىٰكُمُ ٱلْمُسْلِمِينَ",178],["26:69:4",370,"إِبْرَٰهِيمَ","(of) Ibrahim","وَٱتْلُ عَلَيْهِمْ نَبَأَ","",178],["29:16:1",398,"وَإِبْرَٰهِيمَ","And Ibrahim","","إِذْ قَالَ لِقَوْمِهِ",178],["29:31:4",400,"إِبْرَٰهِيمَ","(to) Ibrahim","وَلَمَّا جَآءَتْ رُسُلُنَآ","بِٱلْبُشْرَىٰ قَالُوٓا۟ إِنَّا",178],["33:7:9",419,"وَإِبْرَٰهِيمَ","and Ibrahim","وَمِنكَ وَمِن نُّوحٍۢ","وَمُوسَىٰ وَعِيسَى ٱبْنِ",178],["37:83:4",449,"لَإِبْرَٰهِيمَ","(was) surely Ibrahim","۞ وَإِنَّ مِن شِيعَتِهِۦ","",178],["37:104:3",450,"يَـٰٓإِبْرَٰهِيمُ","O Ibrahim","وَنَـٰدَيْنَـٰهُ أَن","",178],["37:109:3",450,"إِبْرَٰهِيمَ","Ibrahim","سَلَـٰمٌ عَلَىٰٓ","",178],["38:45:3",456,"إِبْرَٰهِيمَ","Ibrahim","وَٱذْكُرْ عِبَـٰدَنَآ","وَإِسْحَـٰقَ وَيَعْقُوبَ أُو۟لِى",178],["42:13:15",484,"إِبْرَٰهِيمَ","Ibrahim","وَمَا وَصَّيْنَا بِهِۦٓ","وَمُوسَىٰ وَعِيسَىٰٓ ۖ أَنْ",178],["43:26:3",491,"إِبْرَٰهِيمُ","Ibrahim Said","وَإِذْ قَالَ","لِأَبِيهِ وَقَوْمِهِۦٓ إِنَّنِى",178],["51:24:5",521,"إِبْرَٰهِيمَ","(of) Ibrahim","أَتَىٰكَ حَدِيثُ ضَيْفِ","ٱلْمُكْرَمِينَ",178],["53:37:1",527,"وَإِبْرَٰهِيمَ","And Ibrahim","","ٱلَّذِى وَفَّىٰٓ",178],["57:26:4",541,"وَإِبْرَٰهِيمَ","and Ibrahim","وَلَقَدْ أَرْسَلْنَا نُوحًۭا","وَجَعَلْنَا فِى ذُرِّيَّتِهِمَا",178],["60:4:7",549,"إِبْرَٰهِيمَ","Ibrahim","أُسْوَةٌ حَسَنَةٌۭ فِىٓ","وَٱلَّذِينَ مَعَهُۥٓ إِذْ",178],["60:4:35",549,"إِبْرَٰهِيمَ","(of) Ibrahim","وَحْدَهُۥٓ إِلَّا قَوْلَ","لِأَبِيهِ لَأَسْتَغْفِرَنَّ لَكَ",178],["87:19:2",592,"إِبْرَٰهِيمَ","(of) Ibrahim","صُحُفِ","وَمُوسَىٰ",178]]