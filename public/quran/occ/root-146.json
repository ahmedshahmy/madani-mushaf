[["2:102:45",16,"بِضَآرِّينَ","at all [be those who] harm","وَزَوْجِهِۦ ۚ وَمَا هُم","بِهِۦ مِنْ أَحَدٍ",2217],["2:102:54",16,"يَضُرُّهُمْ","harms them","ٱللَّهِ ۚ وَيَتَعَلَّمُونَ مَا","وَلَا يَنفَعُهُمْ ۚ وَلَقَدْ",532],["2:126:25",19,"أَضْطَرُّهُۥٓ","I will force him","فَأُمَتِّعُهُۥ قَلِيلًۭا ثُمَّ","إِلَىٰ عَذَابِ ٱلنَّارِ ۖ",1121],["2:173:14",26,"ٱضْطُرَّ","(is) forced by necessity","لِغَيْرِ ٱللَّهِ ۖ فَمَنِ","غَيْرَ بَاغٍۢ وَلَا",1121],["2:177:43",27,"وَٱلضَّرَّآءِ","and [the] hardship","وَٱلصَّـٰبِرِينَ فِى ٱلْبَأْسَآءِ","وَحِينَ ٱلْبَأْسِ ۗ أُو۟لَـٰٓئِكَ",882],["2:214:15",33,"وَٱلضَّرَّآءُ","and [the] hardship","قَبْلِكُم ۖ مَّسَّتْهُمُ ٱلْبَأْسَآءُ","وَزُلْزِلُوا۟ حَتَّىٰ يَقُولَ",882],["2:231:13",37,"ضِرَارًۭا","(to) hurt","بِمَعْرُوفٍۢ ۚ وَلَا تُمْسِكُوهُنَّ","لِّتَعْتَدُوا۟ ۚ وَمَن يَفْعَلْ",2221],["2:233:23",37,"تُضَآرَّ","made to suffer","إِلَّا وُسْعَهَا ۚ لَا","وَٰلِدَةٌۢ بِوَلَدِهَا وَلَا",2075],["2:282:112",48,"يُضَآرَّ","(should) be harmed","إِذَا تَبَايَعْتُمْ ۚ وَلَا","كَاتِبٌۭ وَلَا شَهِيدٌۭ ۚ",2075],["3:111:2",64,"يَضُرُّوكُمْ","will they harm you","لَن","إِلَّآ أَذًۭى ۖ وَإِن",532],["3:120:14",65,"يَضُرُّكُمْ","will harm you","تَصْبِرُوا۟ وَتَتَّقُوا۟ لَا","كَيْدُهُمْ شَيْـًٔا ۗ إِنَّ",532],["3:134:5",67,"وَٱلضَّرَّآءِ","and (in) the hardship","يُنفِقُونَ فِى ٱلسَّرَّآءِ","وَٱلْكَـٰظِمِينَ ٱلْغَيْظَ وَٱلْعَافِينَ",882],["3:144:22",68,"يَضُرَّ","will he harm","عَلَىٰ عَقِبَيْهِ فَلَن","ٱللَّهَ شَيْـًۭٔا ۗ وَسَيَجْزِى",532],["3:176:9",73,"يَضُرُّوا۟","will harm","ٱلْكُفْرِ ۚ إِنَّهُمْ لَن","ٱللَّهَ شَيْـًۭٔا ۗ يُرِيدُ",532],["3:177:7",73,"يَضُرُّوا۟","will they harm","ٱلْكُفْرَ بِٱلْإِيمَـٰنِ لَن","ٱللَّهَ شَيْـًۭٔا وَلَهُمْ",532],["4:12:82",79,"مُضَآرٍّۢ ۚ","(being) harmful","أَوْ دَيْنٍ غَيْرَ","وَصِيَّةًۭ مِّنَ ٱللَّهِ ۗ",3753],["4:95:8",94,"ٱلضَّرَرِ","[the] disabled","ٱلْمُؤْمِنِينَ غَيْرُ أُو۟لِى","وَٱلْمُجَـٰهِدُونَ فِى سَبِيلِ",3085],["4:113:16",96,"يَضُرُّونَكَ","they will harm you","إِلَّآ أَنفُسَهُمْ ۖ وَمَا","مِن شَىْءٍۢ ۚ وَأَنزَلَ",532],["5:3:52",107,"ٱضْطُرَّ","(is) forced","ٱلْإِسْلَـٰمَ دِينًۭا ۚ فَمَنِ","فِى مَخْمَصَةٍ غَيْرَ",1121],["5:42:16",115,"يَضُرُّوكَ","will they harm you","تُعْرِضْ عَنْهُمْ فَلَن","شَيْـًۭٔا ۖ وَإِنْ حَكَمْتَ",532],["5:76:10",120,"ضَرًّۭا","any harm","لَا يَمْلِكُ لَكُمْ","وَلَا نَفْعًۭا ۚ وَٱللَّهُ",817],["5:105:7",125,"يَضُرُّكُم","will harm you","عَلَيْكُمْ أَنفُسَكُمْ ۖ لَا","مَّن ضَلَّ إِذَا",532],["6:17:4",129,"بِضُرٍّۢ","with affliction","وَإِن يَمْسَسْكَ ٱللَّهُ","فَلَا كَاشِفَ لَهُۥٓ",524],["6:42:9",132,"وَٱلضَّرَّآءِ","and hardship","قَبْلِكَ فَأَخَذْنَـٰهُم بِٱلْبَأْسَآءِ","لَعَلَّهُمْ يَتَضَرَّعُونَ",882],["6:71:10",136,"يَضُرُّنَا","harms us","لَا يَنفَعُنَا وَلَا","وَنُرَدُّ عَلَىٰٓ أَعْقَابِنَا",532],["6:119:18",143,"ٱضْطُرِرْتُمْ","you are compelled","عَلَيْكُمْ إِلَّا مَا","إِلَيْهِ ۗ وَإِنَّ كَثِيرًۭا",1121],["6:145:31",147,"ٱضْطُرَّ","(is) compelled","ٱللَّهِ بِهِۦ ۚ فَمَنِ","غَيْرَ بَاغٍۢ وَلَا",1121],["7:94:11",162,"وَٱلضَّرَّآءِ","and hardship","أَخَذْنَآ أَهْلَهَا بِٱلْبَأْسَآءِ","لَعَلَّهُمْ يَضَّرَّعُونَ",882],["7:95:12",162,"ٱلضَّرَّآءُ","the adversity","قَدْ مَسَّ ءَابَآءَنَا","وَٱلسَّرَّآءُ فَأَخَذْنَـٰهُم بَغْتَةًۭ",882],["7:188:7",175,"ضَرًّا","(power to) harm","لِنَفْسِى نَفْعًۭا وَلَا","إِلَّا مَا شَآءَ",817],["9:39:10",193,"تَضُرُّوهُ","you can harm Him","قَوْمًا غَيْرَكُمْ وَلَا","شَيْـًۭٔا ۗ وَٱللَّهُ عَلَىٰ",532],["9:107:4",204,"ضِرَارًۭا","(for causing) harm","وَٱلَّذِينَ ٱتَّخَذُوا۟ مَسْجِدًۭا","وَكُفْرًۭا وَتَفْرِيقًۢا بَيْنَ",2221],["10:12:4",209,"ٱلضُّرُّ","the affliction","وَإِذَا مَسَّ ٱلْإِنسَـٰنَ","دَعَانَا لِجَنۢبِهِۦٓ أَوْ",524],["10:12:14",209,"ضُرَّهُۥ","his affliction","فَلَمَّا كَشَفْنَا عَنْهُ","مَرَّ كَأَن لَّمْ",524],["10:12:20",209,"ضُرٍّۢ","(the) affliction","لَّمْ يَدْعُنَآ إِلَىٰ","مَّسَّهُۥ ۚ كَذَٰلِكَ زُيِّنَ",524],["10:18:7",210,"يَضُرُّهُمْ","harm them","ٱللَّهِ مَا لَا","وَلَا يَنفَعُهُمْ وَيَقُولُونَ",532],["10:21:7",211,"ضَرَّآءَ","adversity","رَحْمَةًۭ مِّنۢ بَعْدِ","مَسَّتْهُمْ إِذَا لَهُم",882],["10:49:5",214,"ضَرًّۭا","(for) any harm","لَّآ أَمْلِكُ لِنَفْسِى","وَلَا نَفْعًا إِلَّا",817],["10:106:10",220,"يَضُرُّكَ ۖ","harm you","لَا يَنفَعُكَ وَلَا","فَإِن فَعَلْتَ فَإِنَّكَ",532],["10:107:4",221,"بِضُرٍّۢ","with adversity","وَإِن يَمْسَسْكَ ٱللَّهُ","فَلَا كَاشِفَ لَهُۥٓ",524],["11:10:5",222,"ضَرَّآءَ","hardship","أَذَقْنَـٰهُ نَعْمَآءَ بَعْدَ","مَسَّتْهُ لَيَقُولَنَّ ذَهَبَ",882],["11:57:14",228,"تَضُرُّونَهُۥ","you will harm Him","قَوْمًا غَيْرَكُمْ وَلَا","شَيْـًٔا ۚ إِنَّ رَبِّى",532],["12:88:9",246,"ٱلضُّرُّ","the adversity","ٱلْعَزِيزُ مَسَّنَا وَأَهْلَنَا","وَجِئْنَا بِبِضَـٰعَةٍۢ مُّزْجَىٰةٍۢ",524],["13:16:18",251,"ضَرًّۭا ۚ","(to) harm","لِأَنفُسِهِمْ نَفْعًۭا وَلَا","قُلْ هَلْ يَسْتَوِى",817],["16:53:10",272,"ٱلضُّرُّ","the adversity","ثُمَّ إِذَا مَسَّكُمُ","فَإِلَيْهِ تَجْـَٔرُونَ",524],["16:54:4",272,"ٱلضُّرَّ","the adversity","ثُمَّ إِذَا كَشَفَ","عَنكُمْ إِذَا فَرِيقٌۭ",524],["16:115:14",280,"ٱضْطُرَّ","(is) forced","ٱللَّهِ بِهِۦ ۖ فَمَنِ","غَيْرَ بَاغٍۢ وَلَا",1121],["17:56:10",287,"ٱلضُّرِّ","the misfortunes","فَلَا يَمْلِكُونَ كَشْفَ","عَنكُمْ وَلَا تَحْوِيلًا",524],["17:67:3",289,"ٱلضُّرُّ","the hardship","وَإِذَا مَسَّكُمُ","فِى ٱلْبَحْرِ ضَلَّ",524],["20:89:10",318,"ضَرًّۭا","any harm","وَلَا يَمْلِكُ لَهُمْ","وَلَا نَفْعًۭا",817],["21:66:11",327,"يَضُرُّكُمْ","harms you","يَنفَعُكُمْ شَيْـًۭٔا وَلَا","",532],["21:83:7",329,"ٱلضُّرُّ","the adversity","رَبَّهُۥٓ أَنِّى مَسَّنِىَ","وَأَنتَ أَرْحَمُ ٱلرَّٰحِمِينَ",524],["21:84:7",329,"ضُرٍّۢ ۖ","(the) adversity","مَا بِهِۦ مِن","وَءَاتَيْنَـٰهُ أَهْلَهُۥ وَمِثْلَهُم",524],["22:12:7",333,"يَضُرُّهُۥ","harms him","ٱللَّهِ مَا لَا","وَمَا لَا يَنفَعُهُۥ ۚ",532],["22:13:3",333,"ضَرُّهُۥٓ","his harm","يَدْعُوا۟ لَمَن","أَقْرَبُ مِن نَّفْعِهِۦ ۚ",817],["23:75:7",347,"ضُرٍّۢ","(the) hardship","مَا بِهِم مِّن","لَّلَجُّوا۟ فِى طُغْيَـٰنِهِمْ",524],["25:3:13",360,"ضَرًّۭا","any harm","وَلَا يَمْلِكُونَ لِأَنفُسِهِمْ","وَلَا نَفْعًۭا وَلَا",817],["25:55:9",364,"يَضُرُّهُمْ ۗ","harms them","لَا يَنفَعُهُمْ وَلَا","وَكَانَ ٱلْكَافِرُ عَلَىٰ",532],["26:73:4",370,"يَضُرُّونَ","they harm (you)","أَوْ يَنفَعُونَكُمْ أَوْ","",532],["27:62:3",382,"ٱلْمُضْطَرَّ","(to) the distressed one","أَمَّن يُجِيبُ","إِذَا دَعَاهُ وَيَكْشِفُ",3756],["30:33:4",408,"ضُرٌّۭ","hardship","وَإِذَا مَسَّ ٱلنَّاسَ","دَعَوْا۟ رَبَّهُم مُّنِيبِينَ",524],["31:24:4",413,"نَضْطَرُّهُمْ","We will force them","نُمَتِّعُهُمْ قَلِيلًۭا ثُمَّ","إِلَىٰ عَذَابٍ غَلِيظٍۢ",1121],["34:42:8",433,"ضَرًّۭا","to harm","لِبَعْضٍۢ نَّفْعًۭا وَلَا","وَنَقُولُ لِلَّذِينَ ظَلَمُوا۟",817],["36:23:8",441,"بِضُرٍّۢ","any harm","إِن يُرِدْنِ ٱلرَّحْمَـٰنُ","لَّا تُغْنِ عَنِّى",524],["39:8:4",459,"ضُرٌّۭ","adversity","۞ وَإِذَا مَسَّ ٱلْإِنسَـٰنَ","دَعَا رَبَّهُۥ مُنِيبًا",524],["39:38:19",462,"بِضُرٍّ","harm","إِنْ أَرَادَنِىَ ٱللَّهُ","هَلْ هُنَّ كَـٰشِفَـٰتُ",524],["39:38:23",462,"ضُرِّهِۦٓ","(of) harm (from) Him","هَلْ هُنَّ كَـٰشِفَـٰتُ","أَوْ أَرَادَنِى بِرَحْمَةٍ",524],["39:49:4",464,"ضُرٌّۭ","adversity","فَإِذَا مَسَّ ٱلْإِنسَـٰنَ","دَعَانَا ثُمَّ إِذَا",524],["41:50:7",482,"ضَرَّآءَ","an adversity","مِّنَّا مِنۢ بَعْدِ","مَسَّتْهُ لَيَقُولَنَّ هَـٰذَا",882],["47:32:17",510,"يَضُرُّوا۟","will they harm","لَهُمُ ٱلْهُدَىٰ لَن","ٱللَّهَ شَيْـًۭٔا وَسَيُحْبِطُ",532],["48:11:27",512,"ضَرًّا","harm","إِنْ أَرَادَ بِكُمْ","أَوْ أَرَادَ بِكُمْ",817],["58:10:9",543,"بِضَآرِّهِمْ","he (can) harm them","ٱلَّذِينَ ءَامَنُوا۟ وَلَيْسَ","شَيْـًٔا إِلَّا بِإِذْنِ",2217],["65:6:8",559,"تُضَآرُّوهُنَّ","harm them","مِّن وُجْدِكُمْ وَلَا","لِتُضَيِّقُوا۟ عَلَيْهِنَّ ۚ وَإِن",2075],["72:21:6",573,"ضَرًّۭا","any harm","لَآ أَمْلِكُ لَكُمْ","وَلَا رَشَدًۭا",817]]