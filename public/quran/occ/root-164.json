[["5:2:28",106,"يَجْرِمَنَّكُمْ","incite you","حَلَلْتُمْ فَٱصْطَادُوا۟ ۚ وَلَا","شَنَـَٔانُ قَوْمٍ أَن",2056],["5:8:10",108,"يَجْرِمَنَّكُمْ","prevent you","شُهَدَآءَ بِٱلْقِسْطِ ۖ وَلَا","شَنَـَٔانُ قَوْمٍ عَلَىٰٓ",2056],["6:55:6",134,"ٱلْمُجْرِمِينَ","(of) the criminals","ٱلْـَٔايَـٰتِ وَلِتَسْتَبِينَ سَبِيلُ","",228],["6:123:7",143,"مُجْرِمِيهَا","(of) its criminals","كُلِّ قَرْيَةٍ أَكَـٰبِرَ","لِيَمْكُرُوا۟ فِيهَا ۖ وَمَا",228],["6:124:21",143,"أَجْرَمُوا۟","committed crimes","رِسَالَتَهُۥ ۗ سَيُصِيبُ ٱلَّذِينَ","صَغَارٌ عِندَ ٱللَّهِ",1273],["6:147:13",148,"ٱلْمُجْرِمِينَ","(who are) criminals","بَأْسُهُۥ عَنِ ٱلْقَوْمِ","",228],["7:40:23",155,"ٱلْمُجْرِمِينَ","the criminals","ٱلْخِيَاطِ ۚ وَكَذَٰلِكَ نَجْزِى","",228],["7:84:8",161,"ٱلْمُجْرِمِينَ","(of) the criminals","كَيْفَ كَانَ عَـٰقِبَةُ","",228],["7:133:13",166,"مُّجْرِمِينَ","criminal","فَٱسْتَكْبَرُوا۟ وَكَانُوا۟ قَوْمًۭا","",228],["8:8:7",177,"ٱلْمُجْرِمُونَ","the criminals","ٱلْبَـٰطِلَ وَلَوْ كَرِهَ","",228],["9:66:16",197,"مُجْرِمِينَ","criminals","طَآئِفَةًۢ بِأَنَّهُمْ كَانُوا۟","",228],["10:13:17",209,"ٱلْمُجْرِمِينَ","(who are) criminals","كَذَٰلِكَ نَجْزِى ٱلْقَوْمَ","",228],["10:17:14",210,"ٱلْمُجْرِمُونَ","the criminals","إِنَّهُۥ لَا يُفْلِحُ","",228],["10:50:12",214,"ٱلْمُجْرِمُونَ","the criminals","مَّاذَا يَسْتَعْجِلُ مِنْهُ","",228],["10:75:14",217,"مُّجْرِمِينَ","criminal","فَٱسْتَكْبَرُوا۟ وَكَانُوا۟ قَوْمًۭا","",228],["10:82:7",218,"ٱلْمُجْرِمُونَ","the criminals","بِكَلِمَـٰتِهِۦ وَلَوْ كَرِهَ","",228],["11:22:2",224,"جَرَمَ","doubt","لَا","أَنَّهُمْ فِى ٱلْـَٔاخِرَةِ",1344],["11:35:8",225,"إِجْرَامِى","(is) my crime","إِنِ ٱفْتَرَيْتُهُۥ فَعَلَىَّ","وَأَنَا۠ بَرِىٓءٌۭ مِّمَّا",2926],["11:35:12",225,"تُجْرِمُونَ","crimes you commit","وَأَنَا۠ بَرِىٓءٌۭ مِّمَّا","",1273],["11:52:17",227,"مُجْرِمِينَ","(as) criminals","قُوَّتِكُمْ وَلَا تَتَوَلَّوْا۟","",228],["11:89:3",232,"يَجْرِمَنَّكُمْ","(Let) not cause you to sin","وَيَـٰقَوْمِ لَا","شِقَاقِىٓ أَن يُصِيبَكُم",2056],["11:116: