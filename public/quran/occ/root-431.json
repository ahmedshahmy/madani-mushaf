[["2:115:2",18,"ٱلْمَشْرِقُ","(is) the east","وَلِلَّهِ","وَٱلْمَغْرِبُ ۚ فَأَيْنَمَا تُوَلُّوا۟",788],["2:142:14",22,"ٱلْمَشْرِقُ","(is) the east","عَلَيْهَا ۚ قُل لِّلَّهِ","وَٱلْمَغْرِبُ ۚ يَهْدِى مَن",788],["2:177:7",27,"ٱلْمَشْرِقِ","the east","تُوَلُّوا۟ وُجُوهَكُمْ قِبَلَ","وَٱلْمَغْرِبِ وَلَـٰكِنَّ ٱلْبِرَّ",788],["2:258:31",43,"ٱلْمَشْرِقِ","the east","يَأْتِى بِٱلشَّمْسِ مِنَ","فَأْتِ بِهَا مِنَ",788],["7:137:6",166,"مَشَـٰرِقَ","(the) eastern (parts)","ٱلَّذِينَ كَانُوا۟ يُسْتَضْعَفُونَ","ٱلْأَرْضِ وَمَغَـٰرِبَهَا ٱلَّتِى",788],["15:73:3",266,"مُشْرِقِينَ","at sunrise","فَأَخَذَتْهُمُ ٱلصَّيْحَةُ","",2533],["19:16:10",306,"شَرْقِيًّۭا","eastern","مِنْ أَهْلِهَا مَكَانًۭا","",2874],["24:35:23",354,"شَرْقِيَّةٍۢ","(of the) east","مُّبَـٰرَكَةٍۢ زَيْتُونَةٍۢ لَّا","وَلَا غَرْبِيَّةٍۢ يَكَادُ",2875],["26:28:3",368,"ٱلْمَشْرِقِ","(of) the east","قَالَ رَبُّ","وَٱلْمَغْرِبِ وَمَا بَيْنَهُمَآ ۖ",788],["26:60:2",369,"مُّشْرِقِينَ","(at) sunrise","فَأَتْبَعُوهُم","",2533],["37:5:7",446,"ٱلْمَشَـٰرِقِ","(of) each point of sunrise","وَمَا بَيْنَهُمَا وَرَبُّ","",788],["38:18:7",454,"وَٱلْإِشْرَاقِ","and [the] sunrise","مَعَهُۥ يُسَبِّحْنَ بِٱلْعَشِىِّ","",2920],["39:69:1",466,"وَأَشْرَقَتِ","And (will) shine","","ٱلْأَرْضُ بِنُورِ رَبِّهَا",2946],["43:38:9",492,"ٱلْمَشْرِقَيْنِ","(of) the East and the West","بَيْنِى وَبَيْنَكَ بُعْدَ","فَبِئْسَ ٱلْقَرِينُ",788],["55:17:2",531,"ٱلْمَشْرِقَيْنِ","(of) the two Easts","رَبُّ","وَرَبُّ ٱلْمَغْرِبَيْنِ",788],["70:40:4",569,"ٱلْمَشَـٰرِقِ","(of) the risings","فَلَآ أُقْسِمُ بِرَبِّ","وَٱلْمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ",788],["73:9:2",574,"ٱلْمَشْرِقِ","(of) the east","رَّبُّ","وَٱلْمَغْرِبِ لَآ إِلَـٰهَ",788]]