[["5:75:25",120,"يُؤْفَكُونَ","they are deluded","ثُمَّ ٱنظُرْ أَنَّىٰ","",589],["6:95:17",140,"تُؤْفَكُونَ","are you deluded","ذَٰلِكُمُ ٱللَّهُ ۖ فَأَنَّىٰ","",589],["7:117:11",164,"يَأْفِكُونَ","they (were) falsifying","هِىَ تَلْقَفُ مَا","",589],["9:30:23",191,"يُؤْفَكُونَ","deluded are they","قَـٰتَلَهُمُ ٱللَّهُ ۚ أَنَّىٰ","",589],["9:70:15",198,"وَٱلْمُؤْتَفِكَـٰتِ ۚ","and the towns overturned","إِبْرَٰهِيمَ وَأَصْحَـٰبِ مَدْيَنَ","أَتَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَـٰتِ ۖ",1899],["10:34:17",213,"تُؤْفَكُونَ","you are deluded","ثُمَّ يُعِيدُهُۥ ۖ فَأَنَّىٰ","",589],["24:11:4",351,"بِٱلْإِفْكِ","the lie","إِنَّ ٱلَّذِينَ جَآءُو","عُصْبَةٌۭ مِّنكُمْ ۚ لَا",871],["24:12:11",351,"إِفْكٌۭ","(is) a lie","خَيْرًۭا وَقَالُوا۟ هَـٰذَآ","مُّبِينٌۭ",871],["25:4:7",360,"إِفْكٌ","a lie","إِنْ هَـٰذَآ إِلَّآ","ٱفْتَرَىٰهُ وَأَعَانَهُۥ عَلَيْهِ",871],["26:45:8",369,"يَأْفِكُونَ","they falsified","هِىَ تَلْقَفُ مَا","",589],["26:222:4",376,"أَفَّاكٍ","liar","تَنَزَّلُ عَلَىٰ كُلِّ","أَثِيمٍۢ",2167],["29:17:8",398,"إِفْكًا ۚ","falsehood","ٱللَّهِ أَوْثَـٰنًۭا وَتَخْلُقُونَ","إِنَّ ٱلَّذِينَ تَعْبُدُونَ",871],["29:61:13",403,"يُؤْفَكُونَ","are they deluded","لَيَقُولُنَّ ٱللَّهُ ۖ فَأَنَّىٰ","",589],["30:55:12",410,"يُؤْفَكُونَ","deluded","سَاعَةٍۢ ۚ كَذَٰلِكَ كَانُوا۟","",589],["34:43:22",433,"إِفْكٌۭ","a lie","مَا هَـٰذَآ إِلَّآ","مُّفْتَرًۭى ۚ وَقَالَ ٱلَّذِينَ",871],["35:3:21",434,"تُؤْفَكُونَ","(are) you deluded","إِلَّا هُوَ ۖ فَأَنَّىٰ","",589],["37:86:1",449,"أَئِفْكًا","Is it falsehood","","ءَالِهَةًۭ دُونَ ٱللَّهِ",871],["37:151:4",451,"إِفْكِهِمْ","their falsehood","أَلَآ إِنَّهُم مِّنْ","لَيَقُولُونَ",871],["40:62:12",474,"تُؤْفَكُونَ","are you deluded","إِلَّا هُوَ ۖ فَأَنَّىٰ","",589],["40:63:2",474,"يُؤْفَكُ","were deluded","كَذَٰلِكَ","ٱلَّذِينَ كَانُوا۟ بِـَٔايَـٰتِ",589],["43:87:8",495,"يُؤْفَكُونَ","are they deluded","لَيَقُولُنَّ ٱللَّهُ ۖ فَأَنَّىٰ","",589],["45:7:3",499,"أَفَّاكٍ","liar","وَيْلٌۭ لِّكُلِّ","أَثِيمٍۢ",2167],["46:11:18",503,"إِفْكٌۭ","(is) a lie","بِهِۦ فَسَيَقُولُونَ هَـٰذَآ","قَدِيمٌۭ",871],["46:22:3",505,"لِتَأْفِكَنَا","to turn us away","قَالُوٓا۟ أَجِئْتَنَا","عَنْ ءَالِهَتِنَا فَأْتِنَا",589],["46:28:14",505,"إِفْكُهُمْ","(was) their falsehood","ضَلُّوا۟ عَنْهُمْ ۚ وَذَٰلِكَ","وَمَا كَانُوا۟ يَفْتَرُونَ",871],["51:9:1",521,"يُؤْفَكُ","Deluded away","","عَنْهُ مَنْ أُفِكَ",589],["51:9:4",521,"أُفِكَ","is deluded","يُؤْفَكُ عَنْهُ مَنْ","",589],["53:53:1",528,"وَٱلْمُؤْتَفِكَةَ","And the overturned cities","","أَهْوَىٰ",1899],["63:4:22",554,"يُؤْفَكُونَ","are they deluded","قَـٰتَلَهُمُ ٱللَّهُ ۖ أَنَّىٰ","",589],["69:9:5",567,"وَٱلْمُؤْتَفِكَـٰتُ","and the overturned cities","فِرْعَوْنُ وَمَن قَبْلَهُۥ","بِٱلْخَاطِئَةِ",1899]]