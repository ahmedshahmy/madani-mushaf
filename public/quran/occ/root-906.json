[["4:102:12",95,"أَسْلِحَتَهُمْ","their arms","مِّنْهُم مَّعَكَ وَلْيَأْخُذُوٓا۟","فَإِذَا سَجَدُوا۟ فَلْيَكُونُوا۟",1483],["4:102:27",95,"وَأَسْلِحَتَهُمْ ۗ","and their arms","مَعَكَ وَلْيَأْخُذُوا۟ حِذْرَهُمْ","وَدَّ ٱلَّذِينَ كَفَرُوا۟",1483],["4:102:34",95,"أَسْلِحَتِكُمْ","your arms","لَوْ تَغْفُلُونَ عَنْ","وَأَمْتِعَتِكُمْ فَيَمِيلُونَ عَلَيْكُم",1483],["4:102:54",95,"أَسْلِحَتَكُمْ ۖ","your arms","مَّرْضَىٰٓ أَن تَضَعُوٓا۟","وَخُذُوا۟ حِذْرَكُمْ ۗ إِنَّ",1483]]