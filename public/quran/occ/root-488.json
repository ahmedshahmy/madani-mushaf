[["2:282:82",48,"صَغِيرًا","small","تَسْـَٔمُوٓا۟ أَن تَكْتُبُوهُ","أَوْ كَبِيرًا إِلَىٰٓ",1793],["6:124:22",143,"صَغَارٌ","a humiliation","سَيُصِيبُ ٱلَّذِينَ أَجْرَمُوا۟","عِندَ ٱللَّهِ وَعَذَابٌۭ",3245],["7:13:13",152,"ٱلصَّـٰغِرِينَ","the disgraced ones","فَٱخْرُجْ إِنَّكَ مِنَ","",1308],["7:119:4",164,"صَـٰغِرِينَ","humiliated","فَغُلِبُوا۟ هُنَالِكَ وَٱنقَلَبُوا۟","",1308],["9:29:29",191,"صَـٰغِرُونَ","(are) subdued","عَن يَدٍۢ وَهُمْ","",1308],["9:121:4",206,"صَغِيرَةًۭ","small","وَلَا يُنفِقُونَ نَفَقَةًۭ","وَلَا كَبِيرَةًۭ وَلَا",2293],["10:61:34",215,"أَصْغَرَ","smaller","فِى ٱلسَّمَآءِ وَلَآ","مِن ذَٰلِكَ وَلَآ",2164],["12:32:19",239,"ٱلصَّـٰغِرِينَ","those who are disgraced","لَيُسْجَنَنَّ وَلَيَكُونًۭا مِّنَ","",1308],["17:24:12",284,"صَغِيرًۭا","(when I was) small","ٱرْحَمْهُمَا كَمَا رَبَّيَانِى","",1793],["18:49:15",299,"صَغِيرَةًۭ","a small","ٱلْكِتَـٰبِ لَا يُغَادِرُ","وَلَا كَبِيرَةً إِلَّآ",2293],["27:37:13",380,"صَـٰغِرُونَ","(will be) abased","مِّنْهَآ أَذِلَّةًۭ وَهُمْ","",1308],["34:3:24",428,"أَصْغَرُ","smaller","فِى ٱلْأَرْضِ وَلَآ","مِن ذَٰلِكَ وَلَآ",2164],["54:53:2",531,"صَغِيرٍۢ","small","وَكُلُّ","وَكَبِيرٍۢ مُّسْتَطَرٌ",1793]]