ْعَلِيمُ",20],["6:117:3",142,"هُوَ","He","إِنَّ رَبَّكَ","أَعْلَمُ مَن يَضِلُّ",20],["6:117:9",142,"وَهُوَ","and He","يَضِلُّ عَن سَبِيلِهِۦ ۖ","أَعْلَمُ بِٱلْمُهْتَدِينَ",20],["6:119:28",143,"هُوَ","He","عِلْمٍ ۗ إِنَّ رَبَّكَ","أَعْلَمُ بِٱلْمُعْتَدِينَ",20],["6:127:6",144,"وَهُوَ","And He","ٱلسَّلَـٰمِ عِندَ رَبِّهِمْ ۖ","وَلِيُّهُم بِمَا كَانُوا۟",20],["6:136:25",145,"فَهُوَ","then it","وَمَا كَانَ لِلَّهِ","يَصِلُ إِلَىٰ شُرَكَآئِهِمْ ۗ",20],["6:141:1",146,"۞ وَهُوَ","And He","","ٱلَّذِىٓ أَنشَأَ جَنَّـٰتٍۢ",20],["6:164:6",150,"وَهُوَ","while He","ٱللَّهِ أَبْغِى رَبًّۭا","رَبُّ كُلِّ شَىْءٍۢ ۚ",20],["6:165:1",150,"وَهُوَ","And He","","ٱلَّذِى جَعَلَكُمْ خَلَـٰٓئِفَ",20],["7:27:18",153,"هُوَ","he","سَوْءَٰتِهِمَآ ۗ إِنَّهُۥ يَرَىٰكُمْ","وَقَبِيلُهُۥ مِنْ حَيْثُ",20],["7:57:1",157,"وَهُوَ","And He","","ٱلَّذِى يُرْسِلُ ٱلرِّيَـٰحَ",20],["7:87:17",161,"وَهُوَ","And He","يَحْكُمَ ٱللَّهُ بَيْنَنَا ۚ","خَيْرُ ٱلْحَـٰكِمِينَ",20],["7:140:6",167,"وَهُوَ","while He","ٱللَّهِ أَبْغِيكُمْ إِلَـٰهًۭا","فَضَّلَكُمْ عَلَى ٱلْعَـٰلَمِينَ",20],["7:158:17",170,"هُوَ","Him","لَآ إِلَـٰهَ إِلَّا","يُحْىِۦ وَيُمِيتُ ۖ فَـَٔامِنُوا۟",20],["7:178:4",173,"فَهُوَ","then he","مَن يَهْدِ ٱللَّهُ","ٱلْمُهْتَدِى ۖ وَمَن يُضْلِلْ",20],["7:184:8",174,"هُوَ","he","مِّن جِنَّةٍ ۚ إِنْ","إِلَّا نَذِيرٌۭ مُّبِينٌ",20],["7:187:15",174,"هُوَ ۚ","Him","يُجَلِّيهَا لِوَقْتِهَآ إِلَّا","ثَقُلَتْ فِى ٱلسَّمَـٰوَٰتِ",20],["7:189:1",175,"۞ هُوَ","He","","ٱلَّذِى خَلَقَكُم مِّن",20],["7:196:7",176,"وَهُوَ","And He","ٱلَّذِى نَزَّلَ ٱلْكِتَـٰبَ ۖ","يَتَوَلَّى ٱلصَّـٰلِحِينَ",20],["8:19:8",179,"فَهُوَ","then it (is)","ٱلْفَتْحُ ۖ وَإِن تَنتَهُوا۟","خَيْرٌۭ لَّكُمْ ۖ وَإِن",20],["8:32:7",180,"هُوَ","[it]","إِن كَانَ هَـٰذَا","ٱلْحَقَّ مِنْ عِندِكَ",20],["8:61:10",184,"هُوَ","He","عَلَى ٱللَّهِ ۚ إِنَّهُۥ","ٱلسَّمِيعُ ٱلْعَلِيمُ",20],["8:62:8",185,"هُوَ","He","فَإِنَّ حَسْبَكَ ٱللَّهُ ۚ","ٱلَّذِىٓ أَيَّدَكَ بِنَصْرِهِۦ",20],["9:3:18",187,"فَهُوَ","then, it is","وَرَسُولُهُۥ ۚ فَإِن تُبْتُمْ","خَيْرٌۭ 