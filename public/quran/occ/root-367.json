[["4:100:24",94,"وَقَعَ","(became) incumbent","يُدْرِكْهُ ٱلْمَوْتُ فَقَدْ","أَجْرُهُۥ عَلَى ٱللَّهِ ۗ",746],["5:91:5",123,"يُوقِعَ","cause","يُرِيدُ ٱلشَّيْطَـٰنُ أَن","بَيْنَكُمُ ٱلْعَدَٰوَةَ وَٱلْبَغْضَآءَ",4742],["7:71:3",159,"وَقَعَ","has fallen","قَالَ قَدْ","عَلَيْكُم مِّن رَّبِّكُمْ",746],["7:118:1",164,"فَوَقَعَ","So was established","","ٱلْحَقُّ وَبَطَلَ مَا",746],["7:134:2",166,"وَقَعَ","fell","وَلَمَّا","عَلَيْهِمُ ٱلرِّجْزُ قَالُوا۟",746],["7:171:9",173,"وَاقِعٌۢ","(would) fall","ظُلَّةٌۭ وَظَنُّوٓا۟ أَنَّهُۥ","بِهِمْ خُذُوا۟ مَآ",1240],["10:51:4",214,"وَقَعَ","(it had) occurred","أَثُمَّ إِذَا مَا","ءَامَنتُم بِهِۦٓ ۚ ءَآلْـَٔـٰنَ",746],["15:29:7",263,"فَقَعُوا۟","then fall down","فِيهِ مِن رُّوحِى","لَهُۥ سَـٰجِدِينَ",746],["18:53:6",299,"مُّوَاقِعُوهَا","are to fall in it","ٱلنَّارَ فَظَنُّوٓا۟ أَنَّهُم","وَلَمْ يَجِدُوا۟ عَنْهَا",4003],["22:65:18",340,"تَقَعَ","it falls","وَيُمْسِكُ ٱلسَّمَآءَ أَن","عَلَى ٱلْأَرْضِ إِلَّا",746],["27:82:2",384,"وَقَعَ","(is) fulfilled","۞ وَإِذَا","ٱلْقَوْلُ عَلَيْهِمْ أَخْرَجْنَا",746],["27:85:1",384,"وَوَقَعَ","And (will be) fulfilled","","ٱلْقَوْلُ عَلَيْهِم بِمَا",746],["38:72:7",457,"فَقَعُوا۟","then fall down","فِيهِ مِن رُّوحِى","لَهُۥ سَـٰجِدِينَ",746],["42:22:7",485,"وَاقِعٌۢ","(will) befall","مِمَّا كَسَبُوا۟ وَهُوَ","بِهِمْ ۗ وَٱلَّذِينَ ءَامَنُوا۟",1240],["51:6:3",520,"لَوَٰقِعٌۭ","(is) surely to occur","وَإِنَّ ٱلدِّينَ","",1240],["52:7:4",523,"لَوَٰقِعٌۭ","(will) surely occur","إِنَّ عَذَابَ رَبِّكَ","",1240],["56:1:2",534,"وَقَعَتِ","occurs","إِذَا","ٱلْوَاقِعَةُ",746],["56:1:3",534,"ٱلْوَاقِعَةُ","the Event","إِذَا وَقَعَتِ","",2705],["56:2:2",534,"لِوَقْعَتِهَا","at its occurrence","لَيْسَ","كَاذِبَةٌ",4532],["56:75:3",536,"بِمَوَٰقِعِ","by setting","۞ فَلَآ أُقْسِمُ","ٱلنُّجُومِ",3725],["69:15:2",567,"وَقَعَتِ","will occur","فَيَوْمَئِذٍۢ","ٱلْوَاقِعَةُ",746],["69:15:3",567,"ٱلْوَاقِعَةُ","the Occurrence","فَيَوْمَئِذٍۢ وَقَعَتِ","",2705],["70:1:4",568,"وَاقِعٍۢ","bound to happen","سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ","",1240],["77:7:3",580,"لَوَٰقِعٌۭ","will surely occur","إِنَّمَا تُوعَدُونَ","",1240]]