[["1:1:1",1,"بِسْمِ","In (the) name","","ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",305],["2:19:4",4,"ٱلسَّمَآءِ","the sky","أَوْ كَصَيِّبٍۢ مِّنَ","فِيهِ ظُلُمَـٰتٌۭ وَرَعْدٌۭ",38],["2:22:6",4,"وَٱلسَّمَآءَ","and the sky","لَكُمُ ٱلْأَرْضَ فِرَٰشًۭا","بِنَآءًۭ وَأَنزَلَ مِنَ",38],["2:22:10",4,"ٱلسَّمَآءِ","the sky","بِنَآءًۭ وَأَنزَلَ مِنَ","مَآءًۭ فَأَخْرَجَ بِهِۦ",38],["2:29:12",5,"ٱلسَّمَآءِ","the heaven","ثُمَّ ٱسْتَوَىٰٓ إِلَى","فَسَوَّىٰهُنَّ سَبْعَ سَمَـٰوَٰتٍۢ ۚ",38],["2:29:15",5,"سَمَـٰوَٰتٍۢ ۚ","heavens","ٱلسَّمَآءِ فَسَوَّىٰهُنَّ سَبْعَ","وَهُوَ بِكُلِّ شَىْءٍ",38],["2:31:3",6,"ٱلْأَسْمَآءَ","the names","وَعَلَّمَ ءَادَمَ","كُلَّهَا ثُمَّ عَرَضَهُمْ",305],["2:31:11",6,"بِأَسْمَآءِ","of (the) names","ٱلْمَلَـٰٓئِكَةِ فَقَالَ أَنۢبِـُٔونِى","هَـٰٓؤُلَآءِ إِن كُنتُمْ",305],["2:33:4",6,"بِأَسْمَآئِهِمْ ۖ","of their names","قَالَ يَـٰٓـَٔادَمُ أَنۢبِئْهُم","فَلَمَّآ أَنۢبَأَهُم بِأَسْمَآئِهِمْ",305],["2:33:7",6,"بِأَسْمَآئِهِمْ","of their names","بِأَسْمَآئِهِمْ ۖ فَلَمَّآ أَنۢبَأَهُم","قَالَ أَلَمْ أَقُل",305],["2:33:15",6,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","إِنِّىٓ أَعْلَمُ غَيْبَ","وَٱلْأَرْضِ وَأَعْلَمُ مَا",38],["2:59:15",9,"ٱلسَّمَآءِ","the sky","ظَلَمُوا۟ رِجْزًۭا مِّنَ","بِمَا كَانُوا۟ يَفْسُقُونَ",38],["2:107:7",17,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱللَّهَ لَهُۥ مُلْكُ","وَٱلْأَرْضِ ۗ وَمَا لَكُم",38],["2:114:10",18,"ٱسْمُهُۥ","His name","أَن يُذْكَرَ فِيهَا","وَسَعَىٰ فِى خَرَابِهَآ ۚ",305],["2:116:10",18,"ٱلسَّمَـٰوَٰتِ","the heavens","لَّهُۥ مَا فِى","وَٱلْأَرْضِ ۖ كُلٌّۭ لَّهُۥ",38],["2:117:2",18,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","بَدِيعُ","وَٱلْأَرْضِ ۖ وَإِذَا قَضَىٰٓ",38],["2:144:6",22,"ٱلسَّمَآءِ ۖ","the heaven","تَقَلُّبَ وَجْهِكَ فِى","فَلَنُوَلِّيَنَّكَ قِبْلَةًۭ تَرْضَىٰهَا ۚ",38],["2:164:4",25,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","إِنَّ فِى خَلْقِ","وَٱلْأَرْضِ وَٱخْتِلَـٰفِ ٱلَّيْلِ",38],["2:164:21",25,"ٱلسَّمَآءِ","the sky","أَنزَلَ ٱللَّهُ مِنَ","مِن مَّآءٍۢ فَأَحْيَا",38],["2:164:39",25,"ٱلسَّمَآءِ","the sky","وَٱلسَّحَابِ ٱلْمُسَخَّرِ بَيْنَ","وَٱلْأَرْضِ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ",38],["2:255:16",42,"ٱلسَّمَـٰوَٰتِ","the heavens","لَّهُۥ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۗ",38],["2:255:43",42,"ٱلسَّمَـٰوَٰتِ","(to) the heavens","شَآءَ ۚ وَسِعَ كُرْسِيُّهُ","وَٱلْأَرْضَ ۖ وَلَا يَـُٔودُهُۥ",38],["2:282:9",48,"مُّسَمًّۭى","fixed","بِدَيْنٍ إِلَىٰٓ أَجَلٍۢ","فَٱكْتُبُوهُ ۚ وَلْيَكْتُب بَّيْنَكُمْ",494],["2:284:4",49,"ٱلسَّمَـٰوَٰتِ","the heavens","لِّلَّهِ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۗ",38],["3:5:11",50,"ٱلسَّمَآءِ","the heaven","ٱلْأَرْضِ وَلَا فِى","",38],["3:29:14",53,"ٱلسَّمَـٰوَٰتِ","the heavens","وَيَعْلَمُ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۗ",38],["3:36:16",54,"سَمَّيْتُهَا","[I] (have) named her","ٱلذَّكَرُ كَٱلْأُنثَىٰ ۖ وَإِنِّى","مَرْيَمَ وَإِنِّىٓ أُعِيذُهَا",1000],["3:45:10",55,"ٱسْمُهُ","his name","يُبَشِّرُكِ بِكَلِمَةٍۢ مِّنْهُ","ٱلْمَسِيحُ عِيسَى ٱبْنُ",305],["3:83:9",60,"ٱلسَّمَـٰوَٰتِ","the heavens","أَسْلَمَ مَن فِى","وَٱلْأَرْضِ طَوْعًۭا وَكَرْهًۭا",38],["3:109:4",64,"ٱلسَّمَـٰوَٰتِ","the heavens","وَلِلَّهِ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۚ",38],["3:129:4",66,"ٱلسَّمَـٰوَٰتِ","the heavens","وَلِلَّهِ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۚ",38],["3:133:8",67,"ٱلسَّمَـٰوَٰتُ","(is like that of) the heavens","رَّبِّكُمْ وَجَنَّةٍ عَرْضُهَا","وَٱلْأَرْضُ أُعِدَّتْ لِلْمُتَّقِينَ",38],["3:180:25",73,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱلْقِيَـٰمَةِ ۗ وَلِلَّهِ مِيرَٰثُ","وَٱلْأَرْضِ ۗ وَٱللَّهُ بِمَا",38],["3:189:3",75,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","وَلِلَّهِ مُلْكُ","وَٱلْأَرْضِ ۗ وَٱللَّهُ عَلَىٰ",38],["3:190:4",75,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","إِنَّ فِى خَلْقِ","وَٱلْأَرْضِ وَٱخْتِلَـٰفِ ٱلَّيْلِ",38],["3:191:11",75,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","وَيَتَفَكَّرُونَ فِى خَلْقِ","وَٱلْأَرْضِ رَبَّنَا مَا",38],["4:126:4",98,"ٱلسَّمَـٰوَٰتِ","the heavens","وَلِلَّهِ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۚ",38],["4:131:4",99,"ٱلسَّمَـٰوَٰتِ","the heavens","وَلِلَّهِ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۗ",38],["4:131:25",99,"ٱلسَّمَـٰوَٰتِ","the heavens","لِلَّهِ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۚ",38],["4:132:4",99,"ٱلسَّمَـٰوَٰتِ","the heavens","وَلِلَّهِ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۚ",38],["4:153:9",102,"ٱلسَّمَآءِ ۚ","the heaven","عَلَيْهِمْ كِتَـٰبًۭا مِّنَ","فَقَدْ سَأَلُوا۟ مُوسَىٰٓ",38],["4:170:18",104,"ٱلسَّمَـٰوَٰتِ","the heavens","لِلَّهِ مَا فِى","وَٱلْأَرْضِ ۚ وَكَانَ ٱللَّهُ",38],["4:171:47",105,"ٱلسَّمَـٰوَٰتِ","the heavens","لَّهُۥ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۗ",38],["5:4:23",107,"ٱسْمَ","(the) name","أَمْسَكْنَ عَلَيْكُمْ وَٱذْكُرُوا۟","ٱللَّهِ عَلَيْهِ ۖ وَٱتَّقُوا۟",305],["5:17:31",110,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","جَمِيعًۭا ۗ وَلِلَّهِ مُلْكُ","وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ۚ",38],["5:18:25",111,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","يَشَآءُ ۚ وَلِلَّهِ مُلْكُ","وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ۖ",38],["5:40:7",114,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱللَّهَ لَهُۥ مُلْكُ","وَٱلْأَرْضِ يُعَذِّبُ مَن",38],["5:97:19",124,"ٱلسَّمَـٰوَٰتِ","the heavens","يَعْلَمُ مَا فِى","وَمَا فِى ٱلْأَرْضِ",38],["5:112:15",126,"ٱلسَّمَآءِ ۖ","the heaven","عَلَيْنَا مَآئِدَةًۭ مِّنَ","قَالَ ٱتَّقُوا۟ ٱللَّهَ",38],["5:114:11",127,"ٱلسَّمَآءِ","the heaven","عَلَيْنَا مَآئِدَةًۭ مِّنَ","تَكُونُ لَنَا عِيدًۭا",38],["5:120:3",127,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","لِلَّهِ مُلْكُ","وَٱلْأَرْضِ وَمَا فِيهِنَّ ۚ",38],["6:1:5",128,"ٱلسَّمَـٰوَٰتِ","the heavens","لِلَّهِ ٱلَّذِى خَلَقَ","وَٱلْأَرْضَ وَجَعَلَ ٱلظُّلُمَـٰتِ",38],["6:2:10",128,"مُّسَمًّى","specified","قَضَىٰٓ أَجَلًۭا ۖ وَأَجَلٌۭ","عِندَهُۥ ۖ ثُمَّ أَنتُمْ",494],["6:3:4",128,"ٱلسَّمَـٰوَٰتِ","the heavens","وَهُوَ ٱللَّهُ فِى","وَفِى ٱلْأَرْضِ ۖ يَعْلَمُ",38],["6:6:17",128,"ٱلسَّمَآءَ","(rain from) the sky","نُمَكِّن لَّكُمْ وَأَرْسَلْنَا","عَلَيْهِم مِّدْرَارًۭا وَجَعَلْنَا",38],["6:12:5",129,"ٱلسَّمَـٰوَٰتِ","the heavens","لِّمَن مَّا فِى","وَٱلْأَرْضِ ۖ قُل لِّلَّهِ ۚ",38],["6:14:7",129,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","أَتَّخِذُ وَلِيًّۭا فَاطِرِ","وَٱلْأَرْضِ وَهُوَ يُطْعِمُ",38],["6:35:16",131,"ٱلسَّمَآءِ","the sky","أَوْ سُلَّمًۭا فِى","فَتَأْتِيَهُم بِـَٔايَةٍۢ ۚ وَلَوْ",38],["6:60:14",135,"مُّسَمًّۭى ۖ","specified","فِيهِ لِيُقْضَىٰٓ أَجَلٌۭ","ثُمَّ إِلَيْهِ مَرْجِعُكُمْ",494],["6:73:4",136,"ٱلسَّمَـٰوَٰتِ","the heavens","وَهُوَ ٱلَّذِى خَلَقَ","وَٱلْأَرْضَ بِٱلْحَقِّ ۖ وَيَوْمَ",38],["6:75:5",137,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","نُرِىٓ إِبْرَٰهِيمَ مَلَكُوتَ","وَٱلْأَرْضِ وَلِيَكُونَ مِنَ",38],["6:79:6",137,"ٱلسَّمَـٰوَٰتِ","the heavens","وَجْهِىَ لِلَّذِى فَطَرَ","وَٱلْأَرْضَ حَنِيفًۭا ۖ وَمَآ",38],["6:99:5",140,"ٱلسَّمَآءِ","the sky","ٱلَّذِىٓ أَنزَلَ مِنَ","مَآءًۭ فَأَخْرَجْنَا بِهِۦ",38],["6:101:2",140,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","بَدِيعُ","وَٱلْأَرْضِ ۖ أَنَّىٰ يَكُونُ",38],["6:118:4",142,"ٱسْمُ","(the) name","فَكُلُوا۟ مِمَّا ذُكِرَ","ٱللَّهِ عَلَيْهِ إِن",305],["6:119:7",143,"ٱسْمُ","(the) name","تَأْكُلُوا۟ مِمَّا ذُكِرَ","ٱللَّهِ عَلَيْهِ وَقَدْ",305],["6:121:6",143,"ٱسْمُ","(the) name","مِمَّا لَمْ يُذْكَرِ","ٱللَّهِ عَلَيْهِ وَإِنَّهُۥ",305],["6:125:20",144,"ٱلسَّمَآءِ ۚ","the sky","كَأَنَّمَا يَصَّعَّدُ فِى","كَذَٰلِكَ يَجْعَلُ ٱللَّهُ",38],["6:138:18",146,"ٱسْمَ","(the) name","وَأَنْعَـٰمٌۭ لَّا يَذْكُرُونَ","ٱللَّهِ عَلَيْهَا ٱفْتِرَآءً",305],["7:40:11",155,"ٱلسَّمَآءِ","(of) the heaven","تُفَتَّحُ لَهُمْ أَبْوَٰبُ","وَلَا يَدْخُلُونَ ٱلْجَنَّةَ",38],["7:54:6",157,"ٱلسَّمَـٰوَٰتِ","the heavens","ٱللَّهُ ٱلَّذِى خَلَقَ","وَٱلْأَرْضَ فِى سِتَّةِ",38],["7:71:11",159,"أَسْمَآءٍۢ","names","وَغَضَبٌ ۖ أَتُجَـٰدِلُونَنِى فِىٓ","سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم",305],["7:71:12",159,"سَمَّيْتُمُوهَآ","you have named them","أَتُجَـٰدِلُونَنِى فِىٓ أَسْمَآءٍۢ","أَنتُمْ وَءَابَآؤُكُم مَّا",1000],["7:96:11",163,"ٱلسَّمَآءِ","the heaven","عَلَيْهِم بَرَكَـٰتٍۢ مِّنَ","وَٱلْأَرْضِ وَلَـٰكِن كَذَّبُوا۟",38],["7:158:12",170,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱلَّذِى لَهُۥ مُلْكُ","وَٱلْأَرْضِ ۖ لَآ إِلَـٰهَ",38],["7:162:14",171,"ٱلسَّمَآءِ","the sky","عَلَيْهِمْ رِجْزًۭا مِّنَ","بِمَا كَانُوا۟ يَظْلِمُونَ",38],["7:180:2",174,"ٱلْأَسْمَآءُ","(are) the names","وَلِلَّهِ","ٱلْحُسْنَىٰ فَٱدْعُوهُ بِهَا ۖ",305],["7:180:10",174,"أَسْمَـٰٓئِهِۦ ۚ","His names","ٱلَّذِينَ يُلْحِدُونَ فِىٓ","سَيُجْزَوْنَ مَا كَانُوا۟",305],["7:185:5",174,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","يَنظُرُوا۟ فِى مَلَكُوتِ","وَٱلْأَرْضِ وَمَا خَلَقَ",38],["7:187:18",174,"ٱلسَّمَـٰوَٰتِ","the heavens","هُوَ ۚ ثَقُلَتْ فِى","وَٱلْأَرْضِ ۚ لَا تَأْتِيكُمْ",38],["8:11:9",178,"ٱلسَّمَآءِ","the sky","وَيُنَزِّلُ عَلَيْكُم مِّنَ","مَآءًۭ لِّيُطَهِّرَكُم بِهِۦ",38],["8:32:15",180,"ٱلسَّمَآءِ","the sky","عَلَيْنَا حِجَارَةًۭ مِّنَ","أَوِ ٱئْتِنَا بِعَذَابٍ",38],["9:36:14",192,"ٱلسَّمَـٰوَٰتِ","the heavens","ٱللَّهِ يَوْمَ خَلَقَ","وَٱلْأَرْضَ مِنْهَآ أَرْبَعَةٌ",38],["9:116:5",205,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱللَّهَ لَهُۥ مُلْكُ","وَٱلْأَرْضِ ۖ يُحْىِۦ وَيُمِيتُ ۚ",38],["10:3:6",208,"ٱلسَّمَـٰوَٰتِ","the heavens","ٱللَّهُ ٱلَّذِى خَلَقَ","وَٱلْأَرْضَ فِى سِتَّةِ",38],["10:6:10",208,"ٱلسَّمَـٰوَٰتِ","the heavens","خَلَقَ ٱللَّهُ فِى","وَٱلْأَرْضِ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ",38],["10:18:22",210,"ٱلسَّمَـٰوَٰتِ","the heavens","لَا يَعْلَمُ فِى","وَلَا فِى ٱلْأَرْضِ ۚ",38],["10:24:8",211,"ٱلسَّمَآءِ","the sky","كَمَآءٍ أَنزَلْنَـٰهُ مِنَ","فَٱخْتَلَطَ بِهِۦ نَبَاتُ",38],["10:31:5",212,"ٱلسَّمَآءِ","the sky","مَن يَرْزُقُكُم مِّنَ","وَٱلْأَرْضِ أَمَّن يَمْلِكُ",38],["10:55:6",215,"ٱلسَّمَـٰوَٰتِ","the heavens","لِلَّهِ مَا فِى","وَٱلْأَرْضِ ۗ أَلَآ إِنَّ",38],["10:61:32",215,"ٱلسَّمَآءِ","the heavens","ٱلْأَرْضِ وَلَا فِى","وَلَآ أَصْغَرَ مِن",38],["10:66:6",216,"ٱلسَّمَـٰوَٰتِ","the heavens","لِلَّهِ مَن فِى","وَمَن فِى ٱلْأَرْضِ ۗ",38],["10:68:11",216,"ٱلسَّمَـٰوَٰتِ","the heavens","لَهُۥ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۚ",38],["10:101:5",220,"ٱلسَّمَـٰوَٰتِ","the heavens","ٱنظُرُوا۟ مَاذَا فِى","وَٱلْأَرْضِ ۚ وَمَا تُغْنِى",38],["11:3:12",221,"مُّسَمًّۭى","appointed","حَسَنًا إِلَىٰٓ أَجَلٍۢ","وَيُؤْتِ كُلَّ ذِى",494],["11:7:4",222,"ٱلسَّمَـٰوَٰتِ","the heavens","وَهُوَ ٱلَّذِى خَلَقَ","وَٱلْأَرْضَ فِى سِتَّةِ",38],["11:41:4",226,"بِسْمِ","in the name","۞ وَقَالَ ٱرْكَبُوا۟ فِيهَا","ٱللَّهِ مَجْر۪ىٰهَا وَمُرْسَىٰهَآ ۚ",305],["11:44:5",226,"وَيَـٰسَمَآءُ","and O sky","يَـٰٓأَرْضُ ٱبْلَعِى مَآءَكِ","أَقْلِعِى وَغِيضَ ٱلْمَآءُ",38],["11:52:8",227,"ٱلسَّمَآءَ","(from) the sky (rain)","تُوبُوٓا۟ إِلَيْهِ يُرْسِلِ","عَلَيْكُم مِّدْرَارًۭا وَيَزِدْكُمْ",38],["11:107:5",233,"ٱلسَّمَـٰوَٰتُ","the heavens","فِيهَا مَا دَامَتِ","وَٱلْأَرْضُ إِلَّا مَا",38],["11:108:10",233,"ٱلسَّمَـٰوَٰتُ","the heavens","فِيهَا مَا دَامَتِ","وَٱلْأَرْضُ إِلَّا مَا",38],["11:123:3",235,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","وَلِلَّهِ غَيْبُ","وَٱلْأَرْضِ وَإِلَيْهِ يُرْجَعُ",38],["12:40:6",240,"أَسْمَآءًۭ","names","مِن دُونِهِۦٓ إِلَّآ","سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم",305],["12:40:7",240,"سَمَّيْتُمُوهَآ","which you have named them","دُونِهِۦٓ إِلَّآ أَسْمَآءًۭ","أَنتُمْ وَءَابَآؤُكُم مَّآ",1000],["12:101:11",247,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","تَأْوِيلِ ٱلْأَحَادِيثِ ۚ فَاطِرَ","وَٱلْأَرْضِ أَنتَ وَلِىِّۦ",38],["12:105:5",248,"ٱلسَّمَـٰوَٰتِ","the heavens","مِّنْ ءَايَةٍۢ فِى","وَٱلْأَرْضِ يَمُرُّونَ عَلَيْهَا",38],["13:2:4",249,"ٱلسَّمَـٰوَٰتِ","the heavens","ٱللَّهُ ٱلَّذِى رَفَعَ","بِغَيْرِ عَمَدٍۢ تَرَوْنَهَا ۖ",38],["13:2:18",249,"مُّسَمًّۭى ۚ","appointed","كُلٌّۭ يَجْرِى لِأَجَلٍۢ","يُدَبِّرُ ٱلْأَمْرَ يُفَصِّلُ",494],["13:15:5",251,"ٱلسَّمَـٰوَٰتِ","the heavens","يَسْجُدُ مَن فِى","وَٱلْأَرْضِ طَوْعًۭا وَكَرْهًۭا",38],["13:16:4",251,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","قُلْ مَن رَّبُّ","وَٱلْأَرْضِ قُلِ ٱللَّهُ ۚ",38],["13:17:3",251,"ٱلسَّمَآءِ","the sky","أَنزَلَ مِنَ","مَآءًۭ فَسَالَتْ أَوْدِيَةٌۢ",38],["13:33:13",253,"سَمُّوهُمْ ۚ","Name them","لِلَّهِ شُرَكَآءَ قُلْ","أَمْ تُنَبِّـُٔونَهُۥ بِمَا",1000],["14:2:6",255,"ٱلسَّمَـٰوَٰتِ","the heavens","لَهُۥ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۗ",38],["14:10:7",256,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱللَّهِ شَكٌّۭ فَاطِرِ","وَٱلْأَرْضِ ۖ يَدْعُوكُمْ لِيَغْفِرَ",38],["14:10:17",256,"مُّسَمًّۭى ۚ","appointed","وَيُؤَخِّرَكُمْ إِلَىٰٓ أَجَلٍۢ","قَالُوٓا۟ إِنْ أَنتُمْ",494],["14:19:6",258,"ٱلسَّمَـٰوَٰتِ","the heavens","أَنَّ ٱللَّهَ خَلَقَ","وَٱلْأَرْضَ بِٱلْحَقِّ ۚ إِن",38],["14:24:15",258,"ٱلسَّمَآءِ","the sky","ثَابِتٌۭ وَفَرْعُهَا فِى","",38],["14:32:4",259,"ٱلسَّمَـٰوَٰتِ","the heavens","ٱللَّهُ ٱلَّذِى خَلَقَ","وَٱلْأَرْضَ وَأَنزَلَ مِنَ",38],["14:32:8",259,"ٱلسَّمَآءِ","the sky","وَٱلْأَرْضَ وَأَنزَلَ مِنَ","مَآءًۭ فَأَخْرَجَ بِهِۦ",38],["14:38:18",260,"ٱلسَّمَآءِ","the heaven","ٱلْأَرْضِ وَلَا فِى","",38],["14:48:6",261,"وَٱلسَّمَـٰوَٰتُ ۖ","and the heavens","ٱلْأَرْضُ غَيْرَ ٱلْأَرْضِ","وَبَرَزُوا۟ لِلَّهِ ٱلْوَٰحِدِ",38],["15:14:6",262,"ٱلسَّمَآءِ","the heaven","عَلَيْهِم بَابًۭا مِّنَ","فَظَلُّوا۟ فِيهِ يَعْرُجُونَ",38],["15:16:4",263,"ٱلسَّمَآءِ","the heavens","وَلَقَدْ جَعَلْنَا فِى","بُرُوجًۭا وَزَيَّنَّـٰهَا لِلنَّـٰظِرِينَ",38],["15:22:6",263,"ٱلسَّمَآءِ","the sky","لَوَٰقِحَ فَأَنزَلْنَا مِنَ","مَآءًۭ فَأَسْقَيْنَـٰكُمُوهُ وَمَآ",38],["15:85:3",266,"ٱلسَّمَـٰوَٰتِ","the heavens","وَمَا خَلَقْنَا","وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ",38],["16:3:2",267,"ٱلسَّمَـٰوَٰتِ","the heavens","خَلَقَ","وَٱلْأَرْضَ بِٱلْحَقِّ ۚ تَعَـٰلَىٰ",38],["16:10:5",268,"ٱلسَّمَآءِ","the sky","ٱلَّذِىٓ أَنزَلَ مِنَ","مَآءًۭ ۖ لَّكُم مِّنْهُ",38],["16:49:5",272,"ٱلسَّمَـٰوَٰتِ","the heavens","يَسْجُدُ مَا فِى","وَمَا فِى ٱلْأَرْضِ",38],["16:52:4",272,"ٱلسَّمَـٰوَٰتِ","the heavens","وَلَهُۥ مَا فِى","وَٱلْأَرْضِ وَلَهُ ٱلدِّينُ",38],["16:61:15",273,"مُّسَمًّۭى ۖ","appointed","يُؤَخِّرُهُمْ إِلَىٰٓ أَجَلٍۢ","فَإِذَا جَآءَ أَجَلُهُمْ",494],["16:65:4",274,"ٱلسَّمَآءِ","the sky","وَٱللَّهُ أَنزَلَ مِنَ","مَآءًۭ فَأَحْيَا بِهِ",38],["16:73:11",275,"ٱلسَّمَـٰوَٰتِ","the heavens","لَهُمْ رِزْقًۭا مِّنَ","وَٱلْأَرْضِ شَيْـًۭٔا وَلَا",38],["16:77:3",275,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","وَلِلَّهِ غَيْبُ","وَٱلْأَرْضِ ۚ وَمَآ أَمْرُ",38],["16:79:8",275,"ٱلسَّمَآءِ","(of) the sky","مُسَخَّرَٰتٍۢ فِى جَوِّ","مَا يُمْسِكُهُنَّ إِلَّا",38],["17:44:3",286,"ٱلسَّمَـٰوَٰتُ","the seven heavens","تُسَبِّحُ لَهُ","ٱلسَّبْعُ وَٱلْأَرْضُ وَمَن",38],["17:55:5",287,"ٱلسَّمَـٰوَٰتِ","the heavens","أَعْلَمُ بِمَن فِى","وَٱلْأَرْضِ ۗ وَلَقَدْ فَضَّلْنَا",38],["17:92:3",291,"ٱلسَّمَآءَ","the sky","أَوْ تُسْقِطَ","كَمَا زَعَمْتَ عَلَيْنَا",38],["17:93:10",291,"ٱلسَّمَآءِ","the sky","أَوْ تَرْقَىٰ فِى","وَلَن نُّؤْمِنَ لِرُقِيِّكَ",38],["17:95:12",291,"ٱلسَّمَآءِ","the heaven","لَنَزَّلْنَا عَلَيْهِم مِّنَ","مَلَكًۭا رَّسُولًۭا",38],["17:99:7",292,"ٱلسَّمَـٰوَٰتِ","the heavens","ٱللَّهَ ٱلَّذِى خَلَقَ","وَٱلْأَرْضَ قَادِرٌ عَلَىٰٓ",38],["17:102:9",292,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","هَـٰٓؤُلَآءِ إِلَّا رَبُّ","وَٱلْأَرْضِ بَصَآئِرَ وَإِنِّى",38],["17:110:11",293,"ٱلْأَسْمَآءُ","the Most Beautiful Names","مَّا تَدْعُوا۟ فَلَهُ","ٱلْحُسْنَىٰ ۚ وَلَا تَجْهَرْ",305],["18:14:9",294,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","فَقَالُوا۟ رَبُّنَا رَبُّ","وَٱلْأَرْضِ لَن نَّدْعُوَا۟",38],["18:26:8",296,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","لَبِثُوا۟ ۖ لَهُۥ غَيْبُ","وَٱلْأَرْضِ ۖ أَبْصِرْ بِهِۦ",38],["18:40:12",298,"ٱلسَّمَآءِ","the sky","عَلَيْهَا حُسْبَانًۭا مِّنَ","فَتُصْبِحَ صَعِيدًۭا زَلَقًا",38],["18:45:9",298,"ٱلسَّمَآءِ","the sky","كَمَآءٍ أَنزَلْنَـٰهُ مِنَ","فَٱخْتَلَطَ بِهِۦ نَبَاتُ",38],["18:51:4",299,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","۞ مَّآ أَشْهَدتُّهُمْ خَلْقَ","وَٱلْأَرْضِ وَلَا خَلْقَ",38],["19:7:5",305,"ٱسْمُهُۥ","his name","إِنَّا نُبَشِّرُكَ بِغُلَـٰمٍ","يَحْيَىٰ لَمْ نَجْعَل",305],["19:7:12",305,"سَمِيًّۭا","(this) name","لَّهُۥ مِن قَبْلُ","",2626],["19:65:2",310,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","رَّبُّ","وَٱلْأَرْضِ وَمَا بَيْنَهُمَا",38],["19:65:12",310,"سَمِيًّۭا","any similarity","هَلْ تَعْلَمُ لَهُۥ","",2626],["19:90:2",311,"ٱلسَّمَـٰوَٰتُ","the heavens","تَكَادُ","يَتَفَطَّرْنَ مِنْهُ وَتَنشَقُّ",38],["19:93:5",311,"ٱلسَّمَـٰوَٰتِ","the heavens","كُلُّ مَن فِى","وَٱلْأَرْضِ إِلَّآ ءَاتِى",38],["20:4:5",312,"وَٱلسَّمَـٰوَٰتِ","and the heavens","مِّمَّنْ خَلَقَ ٱلْأَرْضَ","ٱلْعُلَى",38],["20:6:4",312,"ٱلسَّمَـٰوَٰتِ","the heavens","لَهُۥ مَا فِى","وَمَا فِى ٱلْأَرْضِ",38],["20:8:7",312,"ٱلْأَسْمَآءُ","the Names","إِلَّا هُوَ ۖ لَهُ","ٱلْحُسْنَىٰ",305],["20:53:12",315,"ٱلسَّمَآءِ","the sky","سُبُلًۭا وَأَنزَلَ مِنَ","مَآءًۭ فَأَخْرَجْنَا بِهِۦٓ",38],["20:129:9",321,"مُّسَمًّۭى","determined","لَكَانَ لِزَامًۭا وَأَجَلٌۭ","",494],["21:4:6",322,"ٱلسَّمَآءِ","the heavens","يَعْلَمُ ٱلْقَوْلَ فِى","وَٱلْأَرْضِ ۖ وَهُوَ ٱلسَّمِيعُ",38],["21:16:3",323,"ٱلسَّمَآءَ","the heavens","وَمَا خَلَقْنَا","وَٱلْأَرْضَ وَمَا بَيْنَهُمَا",38],["21:19:4",323,"ٱلسَّمَـٰوَٰتِ","the heavens","وَلَهُۥ مَن فِى","وَٱلْأَرْضِ ۚ وَمَنْ عِندَهُۥ",38],["21:30:6",324,"ٱلسَّمَـٰوَٰتِ","the heavens","ٱلَّذِينَ كَفَرُوٓا۟ أَنَّ","وَٱلْأَرْضَ كَانَتَا رَتْقًۭا",38],["21:32:2",324,"ٱلسَّمَآءَ","the sky","وَجَعَلْنَا","سَقْفًۭا مَّحْفُوظًۭا ۖ وَهُمْ",38],["21:56:5",326,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","بَل رَّبُّكُمْ رَبُّ","وَٱلْأَرْضِ ٱلَّذِى فَطَرَهُنَّ",38],["21:104:3",331,"ٱلسَّمَآءَ","the heaven","يَوْمَ نَطْوِى","كَطَىِّ ٱلسِّجِلِّ لِلْكُتُبِ ۚ",38],["22:5:34",332,"مُّسَمًّۭى","appointed","نَشَآءُ إِلَىٰٓ أَجَلٍۢ","ثُمَّ نُخْرِجُكُمْ طِفْلًۭا",494],["22:15:14",333,"ٱلسَّمَآءِ","the sky","فَلْيَمْدُدْ بِسَبَبٍ إِلَى","ثُمَّ لْيَقْطَعْ فَلْيَنظُرْ",38],["22:18:9",334,"ٱلسَّمَـٰوَٰتِ","the heavens","لَهُۥ مَن فِى","وَمَن فِى ٱلْأَرْضِ",38],["22:28:5",335,"ٱسْمَ","(the) name","مَنَـٰفِعَ لَهُمْ وَيَذْكُرُوا۟","ٱللَّهِ فِىٓ أَيَّامٍۢ",305],["22:31:12",336,"ٱلسَّمَآءِ","the sky","فَكَأَنَّمَا خَرَّ مِنَ","فَتَخْطَفُهُ ٱلطَّيْرُ أَوْ",38],["22:33:6",336,"مُّسَمًّۭى","appointed","مَنَـٰفِعُ إِلَىٰٓ أَجَلٍۢ","ثُمَّ مَحِلُّهَآ إِلَى",494],["22:34:6",336,"ٱسْمَ","(the) name","جَعَلْنَا مَنسَكًۭا لِّيَذْكُرُوا۟","ٱللَّهِ عَلَىٰ مَا",305],["22:36:11",336,"ٱسْمَ","(the) name","فِيهَا خَيْرٌۭ ۖ فَٱذْكُرُوا۟","ٱللَّهِ عَلَيْهَا صَوَآفَّ ۖ",305],["22:40:25",337,"ٱسْمُ","(the) name of Allah","وَمَسَـٰجِدُ يُذْكَرُ فِيهَا","ٱللَّهِ كَثِيرًۭا ۗ وَلَيَنصُرَنَّ",305],["22:63:7",339,"ٱلسَّمَآءِ","the sky","ٱللَّهَ أَنزَلَ مِنَ","مَآءًۭ فَتُصْبِحُ ٱلْأَرْضُ",38],["22:64:4",339,"ٱلسَّمَـٰوَٰتِ","the heavens","لَّهُۥ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۗ",38],["22:65:16",340,"ٱلسَّمَآءَ","the sky","ٱلْبَحْرِ بِأَمْرِهِۦ وَيُمْسِكُ","أَن تَقَعَ عَلَى",38],["22:70:8",340,"ٱلسَّمَآءِ","the heaven","يَعْلَمُ مَا فِى","وَٱلْأَرْضِ ۗ إِنَّ ذَٰلِكَ",38],["22:78:19",341,"سَمَّىٰكُمُ","named you","أَبِيكُمْ إِبْرَٰهِيمَ ۚ هُوَ","ٱلْمُسْلِمِينَ مِن قَبْلُ",1000],["23:18:3",343,"ٱلسَّمَآءِ","the sky","وَأَنزَلْنَا مِنَ","مَآءًۢ بِقَدَرٍۢ فَأَسْكَنَّـٰهُ",38],["23:71:6",346,"ٱلسَّمَـٰوَٰتُ","the heavens","ٱلْحَقُّ أَهْوَآءَهُمْ لَفَسَدَتِ","وَٱلْأَرْضُ وَمَن فِيهِنَّ ۚ",38],["23:86:4",347,"ٱلسَّمَـٰوَٰتِ","(of) the seven heavens","قُلْ مَن رَّبُّ","ٱلسَّبْعِ وَرَبُّ ٱلْعَرْشِ",38],["24:35:3",354,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","۞ ٱللَّهُ نُورُ","وَٱلْأَرْضِ ۚ مَثَلُ نُورِهِۦ",38],["24:36:9",354,"ٱسْمُهُۥ","His name","تُرْفَعَ وَيُذْكَرَ فِيهَا","يُسَبِّحُ لَهُۥ فِيهَا",305],["24:41:9",355,"ٱلسَّمَـٰوَٰتِ","the heavens","لَهُۥ مَن فِى","وَٱلْأَرْضِ وَٱلطَّيْرُ صَـٰٓفَّـٰتٍۢ ۖ",38],["24:42:3",355,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","وَلِلَّهِ مُلْكُ","وَٱلْأَرْضِ ۖ وَإِلَى ٱللَّهِ",38],["24:43:20",355,"ٱلسَّمَآءِ","(the) sky","خِلَـٰلِهِۦ وَيُنَزِّلُ مِنَ","مِن جِبَالٍۢ فِيهَا",38],["24:64:6",359,"ٱلسَّمَـٰوَٰتِ","the heavens","لِلَّهِ مَا فِى","وَٱلْأَرْضِ ۖ قَدْ يَعْلَمُ",38],["25:2:4",359,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱلَّذِى لَهُۥ مُلْكُ","وَٱلْأَرْضِ وَلَمْ يَتَّخِذْ",38],["25:6:7",360,"ٱلسَّمَـٰوَٰتِ","the heavens","يَعْلَمُ ٱلسِّرَّ فِى","وَٱلْأَرْضِ ۚ إِنَّهُۥ كَانَ",38],["25:25:3",362,"ٱلسَّمَآءُ","the heavens","وَيَوْمَ تَشَقَّقُ","بِٱلْغَمَـٰمِ وَنُزِّلَ ٱلْمَلَـٰٓئِكَةُ",38],["25:48:11",364,"ٱلسَّمَآءِ","the sky","رَحْمَتِهِۦ ۚ وَأَنزَلْنَا مِنَ","مَآءًۭ طَهُورًۭا",38],["25:59:3",365,"ٱلسَّمَـٰوَٰتِ","the heavens","ٱلَّذِى خَلَقَ","وَٱلْأَرْضَ وَمَا بَيْنَهُمَا",38],["25:61:5",365,"ٱلسَّمَآءِ","the skies","ٱلَّذِى جَعَلَ فِى","بُرُوجًۭا وَجَعَلَ فِيهَا",38],["26:4:6",367,"ٱلسَّمَآءِ","the sky","نُنَزِّلْ عَلَيْهِم مِّنَ","ءَايَةًۭ فَظَلَّتْ أَعْنَـٰقُهُمْ",38],["26:24:3",368,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","قَالَ رَبُّ","وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ",38],["26:187:5",375,"ٱلسَّمَآءِ","the sky","عَلَيْنَا كِسَفًۭا مِّنَ","إِن كُنتَ مِنَ",38],["27:25:8",379,"ٱلسَّمَـٰوَٰتِ","the heavens","يُخْرِجُ ٱلْخَبْءَ فِى","وَٱلْأَرْضِ وَيَعْلَمُ مَا",38],["27:30:5",379,"بِسْمِ","In the name","مِن سُلَيْمَـٰنَ وَإِنَّهُۥ","ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",305],["27:60:3",382,"ٱلسَّمَـٰوَٰتِ","the heavens","أَمَّنْ خَلَقَ","وَٱلْأَرْضَ وَأَنزَلَ لَكُم",38],["27:60:8",382,"ٱلسَّمَآءِ","the sky","وَأَنزَلَ لَكُم مِّنَ","مَآءًۭ فَأَنۢبَتْنَا بِهِۦ",38],["27:64:9",383,"ٱلسَّمَآءِ","the heavens","وَمَن يَرْزُقُكُم مِّنَ","وَٱلْأَرْضِ ۗ أَءِلَـٰهٌۭ مَّعَ",38],["27:65:6",383,"ٱلسَّمَـٰوَٰتِ","the heavens","يَعْلَمُ مَن فِى","وَٱلْأَرْضِ ٱلْغَيْبَ إِلَّا",38],["27:75:5",383,"ٱلسَّمَآءِ","the heavens","مِنْ غَآئِبَةٍۢ فِى","وَٱلْأَرْضِ إِلَّا فِى",38],["27:87:8",384,"ٱلسَّمَـٰوَٰتِ","the heavens","فَفَزِعَ مَن فِى","وَمَن فِى ٱلْأَرْضِ",38],["29:22:8",398,"ٱلسَّمَآءِ ۖ","the heaven","ٱلْأَرْضِ وَلَا فِى","وَمَا لَكُم مِّن",38],["29:34:9",400,"ٱلسَّمَآءِ","(the) sky","ٱلْقَرْيَةِ رِجْزًۭا مِّنَ","بِمَا كَانُوا۟ يَفْسُقُونَ",38],["29:44:3",401,"ٱلسَّمَـٰوَٰتِ","the heavens","خَلَقَ ٱللَّهُ","وَٱلْأَرْضَ بِٱلْحَقِّ ۚ إِنَّ",38],["29:52:10",402,"ٱلسَّمَـٰوَٰتِ","the heavens","يَعْلَمُ مَا فِى","وَٱلْأَرْضِ ۗ وَٱلَّذِينَ ءَامَنُوا۟",38],["29:53:5",403,"مُّسَمًّۭى","appointed","بِٱلْعَذَابِ ۚ وَلَوْلَآ أَجَلٌۭ","لَّجَآءَهُمُ ٱلْعَذَابُ وَلَيَأْتِيَنَّهُم",494],["29:61:5",403,"ٱلسَّمَـٰوَٰتِ","the heavens","سَأَلْتَهُم مَّنْ خَلَقَ","وَٱلْأَرْضَ وَسَخَّرَ ٱلشَّمْسَ",38],["29:63:6",403,"ٱلسَّمَآءِ","the sky","مَّن نَّزَّلَ مِنَ","مَآءًۭ فَأَحْيَا بِهِ",38],["30:8:8",405,"ٱلسَّمَـٰوَٰتِ","the heavens","مَّا خَلَقَ ٱللَّهُ","وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ",38],["30:8:15",405,"مُّسَمًّۭى ۗ","appointed","إِلَّا بِٱلْحَقِّ وَأَجَلٍۢ","وَإِنَّ كَثِيرًۭا مِّنَ",494],["30:18:4",406,"ٱلسَّمَـٰوَٰتِ","the heavens","وَلَهُ ٱلْحَمْدُ فِى","وَٱلْأَرْضِ وَعَشِيًّۭا وَحِينَ",38],["30:22:4",406,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","وَمِنْ ءَايَـٰتِهِۦ خَلْقُ","وَٱلْأَرْضِ وَٱخْتِلَـٰفُ أَلْسِنَتِكُمْ",38],["30:24:9",406,"ٱلسَّمَآءِ","the sky","وَطَمَعًۭا وَيُنَزِّلُ مِنَ","مَآءًۭ فَيُحْىِۦ بِهِ",38],["30:25:5",407,"ٱلسَّمَآءُ","the heavens","ءَايَـٰتِهِۦٓ أَن تَقُومَ","وَٱلْأَرْضُ بِأَمْرِهِۦ ۚ ثُمَّ",38],["30:26:4",407,"ٱلسَّمَـٰوَٰتِ","the heavens","وَلَهُۥ مَن فِى","وَٱلْأَرْضِ ۖ كُلٌّۭ لَّهُۥ",38],["30:27:14",407,"ٱلسَّمَـٰوَٰتِ","the heavens","ٱلْمَثَلُ ٱلْأَعْلَىٰ فِى","وَٱلْأَرْضِ ۚ وَهُوَ ٱلْعَزِيزُ",38],["30:48:9",409,"ٱلسَّمَآءِ","the sky","سَحَابًۭا فَيَبْسُطُهُۥ فِى","كَيْفَ يَشَآءُ وَيَجْعَلُهُۥ",38],["31:10:2",411,"ٱلسَّمَـٰوَٰتِ","the heavens","خَلَقَ","بِغَيْرِ عَمَدٍۢ تَرَوْنَهَا ۖ",38],["31:10:20",411,"ٱلسَّمَآءِ","the sky","دَآبَّةٍۢ ۚ وَأَنزَلْنَا مِنَ","مَآءًۭ فَأَنۢبَتْنَا فِيهَا",38],["31:16:14",412,"ٱلسَّمَـٰوَٰتِ","the heavens","صَخْرَةٍ أَوْ فِى","أَوْ فِى ٱلْأَرْضِ",38],["31:20:9",413,"ٱلسَّمَـٰوَٰتِ","the heavens","لَكُم مَّا فِى","وَمَا فِى ٱلْأَرْضِ",38],["31:25:5",413,"ٱلسَّمَـٰوَٰتِ","the heavens","سَأَلْتَهُم مَّنْ خَلَقَ","وَٱلْأَرْضَ لَيَقُولُنَّ ٱللَّهُ ۚ",38],["31:26:4",413,"ٱلسَّمَـٰوَٰتِ","the heavens","لِلَّهِ مَا فِى","وَٱلْأَرْضِ ۚ إِنَّ ٱللَّهَ",38],["31:29:20",414,"مُّسَمًّۭى","appointed","يَجْرِىٓ إِلَىٰٓ أَجَلٍۢ","وَأَنَّ ٱللَّهَ بِمَا",494],["32:4:4",415,"ٱلسَّمَـٰوَٰتِ","the heavens","ٱللَّهُ ٱلَّذِى خَلَقَ","وَٱلْأَرْضَ وَمَا بَيْنَهُمَا",38],["32:5:4",415,"ٱلسَّمَآءِ","the heaven","يُدَبِّرُ ٱلْأَمْرَ مِنَ","إِلَى ٱلْأَرْضِ ثُمَّ",38],["33:72:5",427,"ٱلسَّمَـٰوَٰتِ","the heavens","عَرَضْنَا ٱلْأَمَانَةَ عَلَى","وَٱلْأَرْضِ وَٱلْجِبَالِ فَأَبَيْنَ",38],["34:1:7",428,"ٱلسَّمَـٰوَٰتِ","the heavens","لَهُۥ مَا فِى","وَمَا فِى ٱلْأَرْضِ",38],["34:2:12",428,"ٱلسَّمَآءِ","the heaven","وَمَا يَنزِلُ مِنَ","وَمَا يَعْرُجُ فِيهَا ۚ",38],["34:3:19",428,"ٱلسَّمَـٰوَٰتِ","the heavens","مِثْقَالُ ذَرَّةٍۢ فِى","وَلَا فِى ٱلْأَرْضِ",38],["34:9:10",429,"ٱلسَّمَآءِ","the heaven","وَمَا خَلْفَهُم مِّنَ","وَٱلْأَرْضِ ۚ إِن نَّشَأْ",38],["34:9:22",429,"ٱلسَّمَآءِ ۚ","the sky","عَلَيْهِمْ كِسَفًۭا مِّنَ","إِنَّ فِى ذَٰلِكَ",38],["34:22:13",430,"ٱلسَّمَـٰوَٰتِ","the heavens","مِثْقَالَ ذَرَّةٍۢ فِى","وَلَا فِى ٱلْأَرْضِ",38],["34:24:5",431,"ٱلسَّمَـٰوَٰتِ","the heavens","مَن يَرْزُقُكُم مِّنَ","وَٱلْأَرْضِ ۖ قُلِ ٱللَّهُ ۖ",38],["35:1:4",434,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱلْحَمْدُ لِلَّهِ فَاطِرِ","وَٱلْأَرْضِ جَاعِلِ ٱلْمَلَـٰٓئِكَةِ",38],["35:3:14",434,"ٱلسَّمَآءِ","the sky","ٱللَّهِ يَرْزُقُكُم مِّنَ","وَٱلْأَرْضِ ۚ لَآ إِلَـٰهَ",38],["35:13:15",436,"مُّسَمًّۭى ۚ","appointed","كُلٌّۭ يَجْرِى لِأَجَلٍۢ","ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ",494],["35:27:7",437,"ٱلسَّمَآءِ","the sky","ٱللَّهَ أَنزَلَ مِنَ","مَآءًۭ فَأَخْرَجْنَا بِهِۦ",38],["35:38:5",438,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱللَّهَ عَـٰلِمُ غَيْبِ","وَٱلْأَرْضِ ۚ إِنَّهُۥ عَلِيمٌۢ",38],["35:40:18",439,"ٱلسَّمَـٰوَٰتِ","the heavens","لَهُمْ شِرْكٌۭ فِى","أَمْ ءَاتَيْنَـٰهُمْ كِتَـٰبًۭا",38],["35:41:4",439,"ٱلسَّمَـٰوَٰتِ","the heavens","۞ إِنَّ ٱللَّهَ يُمْسِكُ","وَٱلْأَرْضَ أَن تَزُولَا ۚ",38],["35:44:23",439,"ٱلسَّمَـٰوَٰتِ","the heavens","مِن شَىْءٍۢ فِى","وَلَا فِى ٱلْأَرْضِ ۚ",38],["35:45:17",440,"مُّسَمًّۭى ۖ","appointed","يُؤَخِّرُهُمْ إِلَىٰٓ أَجَلٍۢ","فَإِذَا جَآءَ أَجَلُهُمْ",494],["36:28:10",442,"ٱلسَّمَآءِ","the heaven","مِن جُندٍۢ مِّنَ","وَمَا كُنَّا مُنزِلِينَ",38],["36:81:4",445,"ٱلسَّمَـٰوَٰتِ","the heavens","أَوَلَيْسَ ٱلَّذِى خَلَقَ","وَٱلْأَرْضَ بِقَـٰدِرٍ عَلَىٰٓ",38],["37:5:2",446,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","رَّبُّ","وَٱلْأَرْضِ وَمَا بَيْنَهُمَا",38],["37:6:3",446,"ٱلسَّمَآءَ","the sky","إِنَّا زَيَّنَّا","ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ",38],["38:10:4",453,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","أَمْ لَهُم مُّلْكُ","وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ۖ",38],["38:27:3",455,"ٱلسَّمَآءَ","the heaven","وَمَا خَلَقْنَا","وَٱلْأَرْضَ وَمَا بَيْنَهُمَا",38],["38:66:2",457,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","رَبُّ","وَٱلْأَرْضِ وَمَا بَيْنَهُمَا",38],["39:5:2",458,"ٱلسَّمَـٰوَٰتِ","the heavens","خَلَقَ","وَٱلْأَرْضَ بِٱلْحَقِّ ۖ يُكَوِّرُ",38],["39:5:19",458,"مُّسَمًّى ۗ","specified","كُلٌّۭ يَجْرِى لِأَجَلٍۢ","أَلَا هُوَ ٱلْعَزِيزُ",494],["39:21:7",460,"ٱلسَّمَآءِ","the sky","ٱللَّهَ أَنزَلَ مِنَ","مَآءًۭ فَسَلَكَهُۥ يَنَـٰبِيعَ",38],["39:38:5",462,"ٱلسَّمَـٰوَٰتِ","the heavens","سَأَلْتَهُم مَّنْ خَلَقَ","وَٱلْأَرْضَ لَيَقُولُنَّ ٱللَّهُ ۚ",38],["39:42:20",463,"مُّسَمًّى ۚ","specified","ٱلْأُخْرَىٰٓ إِلَىٰٓ أَجَلٍۢ","إِنَّ فِى ذَٰلِكَ",494],["39:44:7",463,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","جَمِيعًۭا ۖ لَّهُۥ مُلْكُ","وَٱلْأَرْضِ ۖ ثُمَّ إِلَيْهِ",38],["39:46:4",463,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","قُلِ ٱللَّهُمَّ فَاطِرَ","وَٱلْأَرْضِ عَـٰلِمَ ٱلْغَيْبِ",38],["39:63:3",465,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","لَّهُۥ مَقَالِيدُ","وَٱلْأَرْضِ ۗ وَٱلَّذِينَ كَفَرُوا۟",38],["39:67:11",465,"وَٱلسَّمَـٰوَٰتُ","and the heavens","قَبْضَتُهُۥ يَوْمَ ٱلْقِيَـٰمَةِ","مَطْوِيَّـٰتٌۢ بِيَمِينِهِۦ ۚ سُبْحَـٰنَهُۥ",38],["39:68:7",466,"ٱلسَّمَـٰوَٰتِ","the heavens","فَصَعِقَ مَن فِى","وَمَن فِى ٱلْأَرْضِ",38],["40:13:8",468,"ٱلسَّمَآءِ","the sky","وَيُنَزِّلُ لَكُم مِّنَ","رِزْقًۭا ۚ وَمَا يَتَذَكَّرُ",38],["40:37:2",471,"ٱلسَّمَـٰوَٰتِ","(to) the heavens","أَسْبَـٰبَ","فَأَطَّلِعَ إِلَىٰٓ إِلَـٰهِ",38],["40:57:2",473,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","لَخَلْقُ","وَٱلْأَرْضِ أَكْبَرُ مِنْ",38],["40:64:7",474,"وَٱلسَّمَآءَ","and the sky","لَكُمُ ٱلْأَرْضَ قَرَارًۭا","بِنَآءًۭ وَصَوَّرَكُمْ فَأَحْسَنَ",38],["40:67:28",475,"مُّسَمًّۭى","specified","قَبْلُ ۖ وَلِتَبْلُغُوٓا۟ أَجَلًۭا","وَلَعَلَّكُمْ تَعْقِلُونَ",494],["41:11:4",477,"ٱلسَّمَآءِ","the heaven","ثُمَّ ٱسْتَوَىٰٓ إِلَى","وَهِىَ دُخَانٌۭ فَقَالَ",38],["41:12:3",478,"سَمَـٰوَاتٍۢ","heavens","فَقَضَىٰهُنَّ سَبْعَ","فِى يَوْمَيْنِ وَأَوْحَىٰ",38],["41:12:9",478,"سَمَآءٍ","heaven","وَأَوْحَىٰ فِى كُلِّ","أَمْرَهَا ۚ وَزَيَّنَّا ٱلسَّمَآءَ",38],["41:12:12",478,"ٱلسَّمَآءَ","the heaven","سَمَآءٍ أَمْرَهَا ۚ وَزَيَّنَّا","ٱلدُّنْيَا بِمَصَـٰبِيحَ وَحِفْظًۭا ۚ",38],["42:4:4",483,"ٱلسَّمَـٰوَٰتِ","the heavens","لَهُۥ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۖ",38],["42:5:2",483,"ٱلسَّمَـٰوَٰتُ","the heavens","تَكَادُ","يَتَفَطَّرْنَ مِن فَوْقِهِنَّ ۚ",38],["42:11:2",484,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","فَاطِرُ","وَٱلْأَرْضِ ۚ جَعَلَ لَكُم",38],["42:12:3",484,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","لَهُۥ مَقَالِيدُ","وَٱلْأَرْضِ ۖ يَبْسُطُ ٱلرِّزْقَ",38],["42:14:18",484,"مُّسَمًّۭى","specified","رَّبِّكَ إِلَىٰٓ أَجَلٍۢ","لَّقُضِىَ بَيْنَهُمْ ۚ وَإِنَّ",494],["42:29:4",486,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","وَمِنْ ءَايَـٰتِهِۦ خَلْقُ","وَٱلْأَرْضِ وَمَا بَثَّ",38],["42:49:3",488,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","لِّلَّهِ مُلْكُ","وَٱلْأَرْضِ ۚ يَخْلُقُ مَا",38],["42:53:7",489,"ٱلسَّمَـٰوَٰتِ","the heavens","لَهُۥ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۗ",38],["43:9:5",489,"ٱلسَّمَـٰوَٰتِ","the heavens","سَأَلْتَهُم مَّنْ خَلَقَ","وَٱلْأَرْضَ لَيَقُولُنَّ خَلَقَهُنَّ",38],["43:11:4",490,"ٱلسَّمَآءِ","the sky","وَٱلَّذِى نَزَّلَ مِنَ","مَآءًۢ بِقَدَرٍۢ فَأَنشَرْنَا",38],["43:82:3",495,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","سُبْحَـٰنَ رَبِّ","وَٱلْأَرْضِ رَبِّ ٱلْعَرْشِ",38],["43:84:4",495,"ٱلسَّمَآءِ","the heaven","وَهُوَ ٱلَّذِى فِى","إِلَـٰهٌۭ وَفِى ٱلْأَرْضِ",38],["43:85:5",495,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱلَّذِى لَهُۥ مُلْكُ","وَٱلْأَرْضِ وَمَا بَيْنَهُمَا",38],["44:7:2",496,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","رَبِّ","وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ",38],["44:10:4",496,"ٱلسَّمَآءُ","the sky","فَٱرْتَقِبْ يَوْمَ تَأْتِى","بِدُخَانٍۢ مُّبِينٍۢ",38],["44:29:4",497,"ٱلسَّمَآءُ","the heaven","فَمَا بَكَتْ عَلَيْهِمُ","وَٱلْأَرْضُ وَمَا كَانُوا۟",38],["44:38:3",497,"ٱلسَّمَـٰوَٰتِ","the heavens","وَمَا خَلَقْنَا","وَٱلْأَرْضَ وَمَا بَيْنَهُمَا",38],["45:3:3",499,"ٱلسَّمَـٰوَٰتِ","the heavens","إِنَّ فِى","وَٱلْأَرْضِ لَـَٔايَـٰتٍۢ لِّلْمُؤْمِنِينَ",38],["45:5:8",499,"ٱلسَّمَآءِ","the sky","أَنزَلَ ٱللَّهُ مِنَ","مِن رِّزْقٍۢ فَأَحْيَا",38],["45:13:5",499,"ٱلسَّمَـٰوَٰتِ","the heavens","لَكُم مَّا فِى","وَمَا فِى ٱلْأَرْضِ",38],["45:22:3",500,"ٱلسَّمَـٰوَٰتِ","the heavens","وَخَلَقَ ٱللَّهُ","وَٱلْأَرْضَ بِٱلْحَقِّ وَلِتُجْزَىٰ",38],["45:27:3",501,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","وَلِلَّهِ مُلْكُ","وَٱلْأَرْضِ ۚ وَيَوْمَ تَقُومُ",38],["45:36:4",502,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","فَلِلَّهِ ٱلْحَمْدُ رَبِّ","وَرَبِّ ٱلْأَرْضِ رَبِّ",38],["45:37:4",502,"ٱلسَّمَـٰوَٰتِ","the heavens","وَلَهُ ٱلْكِبْرِيَآءُ فِى","وَٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ",38],["46:3:3",502,"ٱلسَّمَـٰوَٰتِ","the heavens","مَا خَلَقْنَا","وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ",38],["46:3:10",502,"مُّسَمًّۭى ۚ","appointed","إِلَّا بِٱلْحَقِّ وَأَجَلٍۢ","وَٱلَّذِينَ كَفَرُوا۟ عَمَّآ",494],["46:4:17",502,"ٱلسَّمَـٰوَٰتِ ۖ","the heavens","لَهُمْ شِرْكٌۭ فِى","ٱئْتُونِى بِكِتَـٰبٍۢ مِّن",38],["46:33:7",506,"ٱلسَّمَـٰوَٰتِ","the heavens","ٱللَّهَ ٱلَّذِى خَلَقَ","وَٱلْأَرْضَ وَلَمْ يَعْىَ",38],["48:4:14",511,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","إِيمَـٰنِهِمْ ۗ وَلِلَّهِ جُنُودُ","وَٱلْأَرْضِ ۚ وَكَانَ ٱللَّهُ",38],["48:7:3",511,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","وَلِلَّهِ جُنُودُ","وَٱلْأَرْضِ ۚ وَكَانَ ٱللَّهُ",38],["48:14:3",512,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","وَلِلَّهِ مُلْكُ","وَٱلْأَرْضِ ۚ يَغْفِرُ لِمَن",38],["49:11:30",516,"ٱلِٱسْمُ","the name","تَنَابَزُوا۟ بِٱلْأَلْقَـٰبِ ۖ بِئْسَ","ٱلْفُسُوقُ بَعْدَ ٱلْإِيمَـٰنِ ۚ",305],["49:16:9",517,"ٱلسَّمَـٰوَٰتِ","the heavens","يَعْلَمُ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۚ",38],["49:18:5",517,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱللَّهَ يَعْلَمُ غَيْبَ","وَٱلْأَرْضِ ۚ وَٱللَّهُ بَصِيرٌۢ",38],["50:6:4",518,"ٱلسَّمَآءِ","the sky","أَفَلَمْ يَنظُرُوٓا۟ إِلَى","فَوْقَهُمْ كَيْفَ بَنَيْنَـٰهَا",38],["50:9:3",518,"ٱلسَّمَآءِ","the sky","وَنَزَّلْنَا مِنَ","مَآءًۭ مُّبَـٰرَكًۭا فَأَنۢبَتْنَا",38],["50:38:3",520,"ٱلسَّمَـٰوَٰتِ","the heavens","وَلَقَدْ خَلَقْنَا","وَٱلْأَرْضَ وَمَا بَيْنَهُمَا",38],["51:7:1",521,"وَٱلسَّمَآءِ","By the heaven","","ذَاتِ ٱلْحُبُكِ",38],["51:22:2",521,"ٱلسَّمَآءِ","the heaven","وَفِى","رِزْقُكُمْ وَمَا تُوعَدُونَ",38],["51:23:2",521,"ٱلسَّمَآءِ","(of) the heaven","فَوَرَبِّ","وَٱلْأَرْضِ إِنَّهُۥ لَحَقٌّۭ",38],["51:47:1",522,"وَٱلسَّمَآءَ","And the heaven","","بَنَيْنَـٰهَا بِأَيْي۟دٍۢ وَإِنَّا",38],["52:9:3",523,"ٱلسَّمَآءُ","the heaven","يَوْمَ تَمُورُ","مَوْرًۭا",38],["52:36:3",525,"ٱلسَّمَـٰوَٰتِ","the heavens","أَمْ خَلَقُوا۟","وَٱلْأَرْضَ ۚ بَل لَّا",38],["52:44:5",525,"ٱلسَّمَآءِ","the sky","يَرَوْا۟ كِسْفًۭا مِّنَ","سَاقِطًۭا يَقُولُوا۟ سَحَابٌۭ",38],["53:23:4",526,"أَسْمَآءٌۭ","names","إِنْ هِىَ إِلَّآ","سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم",305],["53:23:5",526,"سَمَّيْتُمُوهَآ","you have named them","هِىَ إِلَّآ أَسْمَآءٌۭ","أَنتُمْ وَءَابَآؤُكُم مَّآ",1000],["53:26:5",526,"ٱلسَّمَـٰوَٰتِ","the heavens","مِّن مَّلَكٍۢ فِى","لَا تُغْنِى شَفَـٰعَتُهُمْ",38],["53:27:6",527,"لَيُسَمُّونَ","surely they name","لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ","ٱلْمَلَـٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ",1000],["53:27:8",527,"تَسْمِيَةَ","name(s)","بِٱلْـَٔاخِرَةِ لَيُسَمُّونَ ٱلْمَلَـٰٓئِكَةَ","ٱلْأُنثَىٰ",4415],["53:31:4",527,"ٱلسَّمَـٰوَٰتِ","the heavens","وَلِلَّهِ مَا فِى","وَمَا فِى ٱلْأَرْضِ",38],["54:11:3",529,"ٱلسَّمَآءِ","(of) heaven","فَفَتَحْنَآ أَبْوَٰبَ","بِمَآءٍۢ مُّنْهَمِرٍۢ",38],["55:7:1",531,"وَٱلسَّمَآءَ","And the heaven","","رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ",38],["55:29:4",532,"ٱلسَّمَـٰوَٰتِ","the heavens","يَسْـَٔلُهُۥ مَن فِى","وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ",38],["55:33:10",532,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","تَنفُذُوا۟ مِنْ أَقْطَارِ","وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا",38],["55:37:3",532,"ٱلسَّمَآءُ","the heaven","فَإِذَا ٱنشَقَّتِ","فَكَانَتْ وَرْدَةًۭ كَٱلدِّهَانِ",38],["55:78:2",534,"ٱسْمُ","(the) name","تَبَـٰرَكَ","رَبِّكَ ذِى ٱلْجَلَـٰلِ",305],["56:74:2",536,"بِٱسْمِ","(the) name","فَسَبِّحْ","رَبِّكَ ٱلْعَظِيمِ",305],["56:96:2",537,"بِٱسْمِ","(the) name","فَسَبِّحْ","رَبِّكَ ٱلْعَظِيمِ",305],["57:1:5",537,"ٱلسَّمَـٰوَٰتِ","the heavens","لِلَّهِ مَا فِى","وَٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ",38],["57:2:3",537,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","لَهُۥ مُلْكُ","وَٱلْأَرْضِ ۖ يُحْىِۦ وَيُمِيتُ ۖ",38],["57:4:4",538,"ٱلسَّمَـٰوَٰتِ","the heavens","هُوَ ٱلَّذِى خَلَقَ","وَٱلْأَرْضَ فِى سِتَّةِ",38],["57:4:24",538,"ٱلسَّمَآءِ","the heaven","وَمَا يَنزِلُ مِنَ","وَمَا يَعْرُجُ فِيهَا ۖ",38],["57:5:3",538,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","لَّهُۥ مُلْكُ","وَٱلْأَرْضِ ۚ وَإِلَى ٱللَّهِ",38],["57:10:10",538,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱللَّهِ وَلِلَّهِ مِيرَٰثُ","وَٱلْأَرْضِ ۚ لَا يَسْتَوِى",38],["57:21:9",540,"ٱلسَّمَآءِ","(of) the heaven","وَجَنَّةٍ عَرْضُهَا كَعَرْضِ","وَٱلْأَرْضِ أُعِدَّتْ لِلَّذِينَ",38],["58:7:8",543,"ٱلسَّمَـٰوَٰتِ","the heavens","يَعْلَمُ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۖ",38],["59:1:5",545,"ٱلسَّمَـٰوَٰتِ","the heavens","لِلَّهِ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۖ",38],["59:24:7",548,"ٱلْأَسْمَآءُ","(are) the names","ٱلْبَارِئُ ٱلْمُصَوِّرُ ۖ لَهُ","ٱلْحُسْنَىٰ ۚ يُسَبِّحُ لَهُۥ",305],["59:24:13",548,"ٱلسَّمَـٰوَٰتِ","the heavens","لَهُۥ مَا فِى","وَٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ",38],["61:1:5",551,"ٱلسَّمَـٰوَٰتِ","the heavens","لِلَّهِ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۖ",38],["61:6:23",552,"ٱسْمُهُۥٓ","whose name (will be)","يَأْتِى مِنۢ بَعْدِى","أَحْمَدُ ۖ فَلَمَّا جَآءَهُم",305],["62:1:5",553,"ٱلسَّمَـٰوَٰتِ","the heavens","لِلَّهِ مَا فِى","وَمَا فِى ٱلْأَرْضِ",38],["63:7:15",555,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","يَنفَضُّوا۟ ۗ وَلِلَّهِ خَزَآئِنُ","وَٱلْأَرْضِ وَلَـٰكِنَّ ٱلْمُنَـٰفِقِينَ",38],["64:1:5",556,"ٱلسَّمَـٰوَٰتِ","the heavens","لِلَّهِ مَا فِى","وَمَا فِى ٱلْأَرْضِ ۖ",38],["64:3:2",556,"ٱلسَّمَـٰوَٰتِ","the heavens","خَلَقَ","وَٱلْأَرْضَ بِٱلْحَقِّ وَصَوَّرَكُمْ",38],["64:4:4",556,"ٱلسَّمَـٰوَٰتِ","the heavens","يَعْلَمُ مَا فِى","وَٱلْأَرْضِ وَيَعْلَمُ مَا",38],["65:12:5",559,"سَمَـٰوَٰتٍۢ","heavens","ٱلَّذِى خَلَقَ سَبْعَ","وَمِنَ ٱلْأَرْضِ مِثْلَهُنَّ",38],["67:3:4",562,"سَمَـٰوَٰتٍۢ","heavens","ٱلَّذِى خَلَقَ سَبْعَ","طِبَاقًۭا ۖ مَّا تَرَىٰ",38],["67:5:3",562,"ٱلسَّمَآءَ","the heaven","وَلَقَدْ زَيَّنَّا","ٱلدُّنْيَا بِمَصَـٰبِيحَ وَجَعَلْنَـٰهَا",38],["67:16:4",563,"ٱلسَّمَآءِ","the heaven","ءَأَمِنتُم مَّن فِى","أَن يَخْسِفَ بِكُمُ",38],["67:17:5",563,"ٱلسَّمَآءِ","the heaven","أَمِنتُم مَّن فِى","أَن يُرْسِلَ عَلَيْكُمْ",38],["69:16:2",567,"ٱلسَّمَآءُ","the heaven","وَٱنشَقَّتِ","فَهِىَ يَوْمَئِذٍۢ وَاهِيَةٌۭ",38],["69:52:2",568,"بِٱسْمِ","(the) name","فَسَبِّحْ","رَبِّكَ ٱلْعَظِيمِ",305],["70:8:3",568,"ٱلسَّمَآءُ","the sky","يَوْمَ تَكُونُ","كَٱلْمُهْلِ",38],["71:4:8",570,"مُّسَمًّى ۚ","specified","وَيُؤَخِّرْكُمْ إِلَىٰٓ أَجَلٍۢ","إِنَّ أَجَلَ ٱللَّهِ",494],["71:11:2",571,"ٱلسَّمَآءَ","(rain from) the sky","يُرْسِلِ","عَلَيْكُم مِّدْرَارًۭا",38],["71:15:7",571,"سَمَـٰوَٰتٍۢ","heavens","خَلَقَ ٱللَّهُ سَبْعَ","طِبَاقًۭا",38],["72:8:3",572,"ٱلسَّمَآءَ","the heaven","وَأَنَّا لَمَسْنَا","فَوَجَدْنَـٰهَا مُلِئَتْ حَرَسًۭا",38],["73:8:2",574,"ٱسْمَ","(the) name","وَٱذْكُرِ","رَبِّكَ وَتَبَتَّلْ إِلَيْهِ",305],["73:18:1",574,"ٱلسَّمَآءُ","The heaven","","مُنفَطِرٌۢ بِهِۦ ۚ كَانَ",38],["76:18:3",579,"تُسَمَّىٰ","named","عَيْنًۭا فِيهَا","سَلْسَبِيلًۭا",1000],["76:25:2",579,"ٱسْمَ","(the) name","وَٱذْكُرِ","رَبِّكَ بُكْرَةًۭ وَأَصِيلًۭا",305],["77:9:2",580,"ٱلسَّمَآءُ","the heaven","وَإِذَا","فُرِجَتْ",38],["78:19:2",582,"ٱلسَّمَآءُ","the heaven","وَفُتِحَتِ","فَكَانَتْ أَبْوَٰبًۭا",38],["78:37:2",583,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","رَّبِّ","وَٱلْأَرْضِ وَمَا بَيْنَهُمَا",38],["79:27:5",584,"ٱلسَّمَآءُ ۚ","the heaven","أَشَدُّ خَلْقًا أَمِ","بَنَىٰهَا",38],["81:11:2",586,"ٱلسَّمَآءُ","the sky","وَإِذَا","كُشِطَتْ",38],["82:1:2",587,"ٱلسَّمَآءُ","the sky","إِذَا","ٱنفَطَرَتْ",38],["84:1:2",589,"ٱلسَّمَآءُ","the sky","إِذَا","ٱنشَقَّتْ",38],["85:1:1",590,"وَٱلسَّمَآءِ","By the sky","","ذَاتِ ٱلْبُرُوجِ",38],["85:9:4",590,"ٱلسَّمَـٰوَٰتِ","(of) the heavens","ٱلَّذِى لَهُۥ مُلْكُ","وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ",38],["86:1:1",591,"وَٱلسَّمَآءِ","By the sky","","وَٱلطَّارِقِ",38],["86:11:1",591,"وَٱلسَّمَآءِ","By the sky","","ذَاتِ ٱلرَّجْعِ",38],["87:1:2",591,"ٱسْمَ","(the) name","سَبِّحِ","رَبِّكَ ٱلْأَعْلَى",305],["87:15:2",592,"ٱسْمَ","(the) name","وَذَكَرَ","رَبِّهِۦ فَصَلَّىٰ",305],["88:18:2",592,"ٱلسَّمَآءِ","the sky","وَإِلَى","كَيْفَ رُفِعَتْ",38],["91:5:1",595,"وَٱلسَّمَآءِ","And the heaven","","وَمَا بَنَىٰهَا",38],["96:1:2",597,"بِٱسْمِ","in (the) name","ٱقْرَأْ","رَبِّكَ ٱلَّذِى خَلَقَ",305]]