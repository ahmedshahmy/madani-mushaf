[["13:17:10",251,"زَبَدًۭا","a foam","بِقَدَرِهَا فَٱحْتَمَلَ ٱلسَّيْلُ","رَّابِيًۭا ۚ وَمِمَّا يُوقِدُونَ",2091],["13:17:21",251,"زَبَدٌۭ","a foam","حِلْيَةٍ أَوْ مَتَـٰعٍۢ","مِّثْلُهُۥ ۚ كَذَٰلِكَ يَضْرِبُ",2091],["13:17:29",251,"ٱلزَّبَدُ","the foam","ٱلْحَقَّ وَٱلْبَـٰطِلَ ۚ فَأَمَّا","فَيَذْهَبُ جُفَآءًۭ ۖ وَأَمَّا",2091]]