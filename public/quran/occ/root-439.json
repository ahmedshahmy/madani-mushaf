[["2:226:5",36,"تَرَبُّصُ","(is a) waiting (of)","يُؤْلُونَ مِن نِّسَآئِهِمْ","أَرْبَعَةِ أَشْهُرٍۢ ۖ فَإِن",4410],["2:228:2",36,"يَتَرَبَّصْنَ","shall wait","وَٱلْمُطَلَّقَـٰتُ","بِأَنفُسِهِنَّ ثَلَـٰثَةَ قُرُوٓءٍۢ ۚ",698],["2:234:6",38,"يَتَرَبَّصْنَ","(the widows) should wait","مِنكُمْ وَيَذَرُونَ أَزْوَٰجًۭا","بِأَنفُسِهِنَّ أَرْبَعَةَ أَشْهُرٍۢ",698],["4:141:2",101,"يَتَرَبَّصُونَ","are waiting","ٱلَّذِينَ","بِكُمْ فَإِن كَانَ",698],["9:24:24",190,"فَتَرَبَّصُوا۟","then wait","وَجِهَادٍۢ فِى سَبِيلِهِۦ","حَتَّىٰ يَأْتِىَ ٱللَّهُ",698],["9:52:3",195,"تَرَبَّصُونَ","you await","قُلْ هَلْ","بِنَآ إِلَّآ إِحْدَى",698],["9:52:9",195,"نَتَرَبَّصُ","[we] await","إِحْدَى ٱلْحُسْنَيَيْنِ ۖ وَنَحْنُ","بِكُمْ أَن يُصِيبَكُمُ",698],["9:52:19",195,"فَتَرَبَّصُوٓا۟","So wait","عِندِهِۦٓ أَوْ بِأَيْدِينَا ۖ","إِنَّا مَعَكُم مُّتَرَبِّصُونَ",698],["9:52:22",195,"مُّتَرَبِّصُونَ","(are) waiting","فَتَرَبَّصُوٓا۟ إِنَّا مَعَكُم","",1939],["9:98:8",202,"وَيَتَرَبَّصُ","and he awaits","مَا يُنفِقُ مَغْرَمًۭا","بِكُمُ ٱلدَّوَآئِرَ ۚ عَلَيْهِمْ",698],["20:135:3",321,"مُّتَرَبِّصٌۭ","(is) waiting","قُلْ كُلٌّۭ","فَتَرَبَّصُوا۟ ۖ فَسَتَعْلَمُونَ مَنْ",1939],["20:135:4",321,"فَتَرَبَّصُوا۟ ۖ","so await","قُلْ كُلٌّۭ مُّتَرَبِّصٌۭ","فَسَتَعْلَمُونَ مَنْ أَصْحَـٰبُ",698],["23:25:7",343,"فَتَرَبَّصُوا۟","so wait","رَجُلٌۢ بِهِۦ جِنَّةٌۭ","بِهِۦ حَتَّىٰ حِينٍۢ",698],["52:30:4",524,"نَّتَرَبَّصُ","we wait","أَمْ يَقُولُونَ شَاعِرٌۭ","بِهِۦ رَيْبَ ٱلْمَنُونِ",698],["52:31:2",524,"تَرَبَّصُوا۟","Wait","قُلْ","فَإِنِّى مَعَكُم مِّنَ",698],["52:31:6",524,"ٱلْمُتَرَبِّصِينَ","those who wait","فَإِنِّى مَعَكُم مِّنَ","",1939],["57:14:10",539,"وَتَرَبَّصْتُمْ","and you awaited","وَلَـٰكِنَّكُمْ فَتَنتُمْ أَنفُسَكُمْ","وَٱرْتَبْتُمْ وَغَرَّتْكُمُ ٱلْأَمَانِىُّ",698]]