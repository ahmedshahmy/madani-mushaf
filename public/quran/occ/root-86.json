[["2:61:36",9,"سَأَلْتُمْ ۗ","you have asked (for)","فَإِنَّ لَكُم مَّا","وَضُرِبَتْ عَلَيْهِمُ ٱلذِّلَّةُ",105],["2:108:4",17,"تَسْـَٔلُوا۟","you ask","أَمْ تُرِيدُونَ أَن","رَسُولَكُمْ كَمَا سُئِلَ",105],["2:108:7",17,"سُئِلَ","was asked","تَسْـَٔلُوا۟ رَسُولَكُمْ كَمَا","مُوسَىٰ مِن قَبْلُ ۗ",105],["2:119:7",18,"تُسْـَٔلُ","you will be asked","بَشِيرًۭا وَنَذِيرًۭا ۖ وَلَا","عَنْ أَصْحَـٰبِ ٱلْجَحِيمِ",105],["2:134:12",20,"تُسْـَٔلُونَ","you will be asked","مَّا كَسَبْتُمْ ۖ وَلَا","عَمَّا كَانُوا۟ يَعْمَلُونَ",105],["2:141:12",21,"تُسْـَٔلُونَ","you will be asked","مَّا كَسَبْتُمْ ۖ وَلَا","عَمَّا كَانُوا۟ يَعْمَلُونَ",105],["2:177:29",27,"وَٱلسَّآئِلِينَ","and those who ask","وَٱلْمَسَـٰكِينَ وَٱبْنَ ٱلسَّبِيلِ","وَفِى ٱلرِّقَابِ وَأَقَامَ",1099],["2:186:2",28,"سَأَلَكَ","ask you","وَإِذَا","عِبَادِى عَنِّى فَإِنِّى",105],["2:189:1",29,"۞ يَسْـَٔلُونَكَ","They ask you","","عَنِ ٱلْأَهِلَّةِ ۖ قُلْ",105],["2:211:1",33,"سَلْ","Ask","","بَنِىٓ إِسْرَٰٓءِيلَ كَمْ",105],["2:215:1",33,"يَسْـَٔلُونَكَ","They ask you","","مَاذَا يُنفِقُونَ ۖ قُلْ",105],["2:217:1",34,"يَسْـَٔلُونَكَ","They ask you","","عَنِ ٱلشَّهْرِ ٱلْحَرَامِ",105],["2:219:1",34,"۞ يَسْـَٔلُونَكَ","They ask you","","عَنِ ٱلْخَمْرِ وَٱلْمَيْسِرِ ۖ",105],["2:219:15",34,"وَيَسْـَٔلُونَكَ","And they ask you","أَكْبَرُ مِن نَّفْعِهِمَا ۗ","مَاذَا يُنفِقُونَ قُلِ",105],["2:220:4",35,"وَيَسْـَٔلُونَكَ","They ask you","فِى ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ ۗ","عَنِ ٱلْيَتَـٰمَىٰ ۖ قُلْ",105],["2:222:1",35,"وَيَسْـَٔلُونَكَ","And they ask you","","عَنِ ٱلْمَحِيضِ ۖ قُلْ",105],["2:273:20",46,"يَسْـَٔلُونَ","(do) they ask","تَعْرِفُهُم بِسِيمَـٰهُمْ لَا","ٱلنَّاسَ إِلْحَافًۭا ۗ وَمَا",105],["4:1:21",77,"تَسَآءَلُونَ","you ask","وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِى","بِهِۦ وَٱلْأَرْحَامَ ۚ إِنَّ",939],["4:32:18",83,"وَسْـَٔلُوا۟","And ask","نَصِيبٌۭ مِّمَّا ٱكْتَسَبْنَ ۚ","ٱللَّهَ مِن فَضْلِهِۦٓ ۗ",105],["4:153:1",102,"يَسْـَٔلُكَ","Ask you","","أَهْلُ ٱلْكِتَـٰبِ أَن",105],["4:153:11",102,"سَأَلُوا۟","they (had) asked","مِّنَ ٱلسَّمَآءِ ۚ فَقَدْ","مُوسَىٰٓ أَكْبَرَ مِن",105],["5:4:1",107,"يَسْـَٔلُونَكَ","They ask you","","مَاذَآ أُحِلَّ لَهُمْ ۖ",105],["5:101:5",124,"تَسْـَٔلُوا۟","ask","ٱلَّذِينَ ءَامَنُوا۟ لَا","عَنْ أَشْيَآءَ إِن",105],["5:101:13",124,"تَسْـَٔلُوا۟","you ask","لَكُمْ تَسُؤْكُمْ وَإِن","عَنْهَا حِينَ يُنَزَّلُ",105],["5:102:2",124,"سَأَلَهَا","asked them","قَدْ","قَوْمٌۭ مِّن قَبْلِكُمْ",105],["6:90:9",138,"أَسْـَٔلُكُمْ","I ask you","ٱقْتَدِهْ ۗ قُل لَّآ","عَلَيْهِ أَجْرًا ۖ إِنْ",105],["7:6:1",151,"فَلَنَسْـَٔلَنَّ","Then surely We will question","","ٱلَّذِينَ أُرْسِلَ إِلَيْهِمْ",105],["7:6:5",151,"وَلَنَسْـَٔلَنَّ","and surely We will question","ٱلَّذِينَ أُرْسِلَ إِلَيْهِمْ","ٱلْمُرْسَلِينَ",105],["7:163:1",171,"وَسْـَٔلْهُمْ","And ask them","","عَنِ ٱلْقَرْيَةِ ٱلَّتِى",105],["7:187:1",174,"يَسْـَٔلُونَكَ","They ask you","","عَنِ ٱلسَّاعَةِ أَيَّانَ",105],["7:187:24",174,"يَسْـَٔلُونَكَ","They ask you","تَأْتِيكُمْ إِلَّا بَغْتَةًۭ ۗ","كَأَنَّكَ حَفِىٌّ عَنْهَا ۖ",105],["8:1:1",177,"يَسْـَٔلُونَكَ","They ask you","","عَنِ ٱلْأَنفَالِ ۖ قُلِ",105],["9:65:2",197,"سَأَلْتَهُمْ","you ask them","وَلَئِن","لَيَقُولُنَّ إِنَّمَا كُنَّا",105],["10:72:4",217,"سَأَلْتُكُم","I have asked you","فَإِن تَوَلَّيْتُمْ فَمَا","مِّنْ أَجْرٍ ۖ إِنْ",105],["10:94:8",219,"فَسْـَٔلِ","then ask","مِّمَّآ أَنزَلْنَآ إِلَيْكَ","ٱلَّذِينَ يَقْرَءُونَ ٱلْكِتَـٰبَ",105],["11:29:3",225,"أَسْـَٔلُكُمْ","I ask (of) you","وَيَـٰقَوْمِ لَآ","عَلَيْهِ مَالًا ۖ إِنْ",105],["11:46:12",227,"تَسْـَٔلْنِ","ask Me","غَيْرُ صَـٰلِحٍۢ ۖ فَلَا","مَا لَيْسَ لَكَ",105],["11:47:7",227,"أَسْـَٔلَكَ","I (should) ask You","أَعُوذُ بِكَ أَنْ","مَا لَيْسَ لِى",105],["11:51:3",227,"أَسْـَٔلُكُمْ","I ask you","يَـٰقَوْمِ لَآ","عَلَيْهِ أَجْرًا ۖ إِنْ",105],["12:7:7",236,"لِّلسَّآئِلِينَ","for those who ask","يُوسُفَ وَإِخْوَتِهِۦٓ ءَايَـٰتٌۭ","",1099],["12:50:12",241,"فَسْـَٔلْهُ","and ask him","ٱرْجِعْ إِلَىٰ رَبِّكَ","مَا بَالُ ٱلنِّسْوَةِ",105],["12:82:1",245,"وَسْـَٔلِ","And ask","","ٱلْقَرْيَةَ ٱلَّتِى كُنَّا",105],["12:104:2",248,"تَسْـَٔلُهُمْ","you ask them","وَمَا","عَلَيْهِ مِنْ أَجْرٍ ۚ",105],["14:34:5",260,"سَأَلْتُمُوهُ ۚ","you asked of Him","مِّن كُلِّ مَا","وَإِن تَعُدُّوا۟ نِعْمَتَ",105],["15:92:2",267,"لَنَسْـَٔلَنَّهُمْ","surely We will question them","فَوَرَبِّكَ","أَجْمَعِينَ",105],["16:43:9",272,"فَسْـَٔلُوٓا۟","so ask","رِجَالًۭا نُّوحِىٓ إِلَيْهِمْ ۚ","أَهْلَ ٱلذِّكْرِ إِن",105],["16:56:9",273,"لَتُسْـَٔلُنَّ","surely you will be asked","مِّمَّا رَزَقْنَـٰهُمْ ۗ تَٱللَّهِ","عَمَّا كُنتُمْ تَفْتَرُونَ",105],["16:93:14",277,"وَلَتُسْـَٔلُنَّ","And surely you will be questioned","وَيَهْدِى مَن يَشَآءُ ۚ","عَمَّا كُنتُمْ تَعْمَلُونَ",105],["17:34:17",285,"مَسْـُٔولًۭا","questioned","إِنَّ ٱلْعَهْدَ كَانَ","",1357],["17:36:16",285,"مَسْـُٔولًۭا","questioned","أُو۟لَـٰٓئِكَ كَانَ عَنْهُ","",1357],["17:85:1",290,"وَيَسْـَٔلُونَكَ","And they ask you","","عَنِ ٱلرُّوحِ ۖ قُلِ",105],["17:101:7",292,"فَسْـَٔلْ","so ask","تِسْعَ ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ ۖ","بَنِىٓ إِسْرَٰٓءِيلَ إِذْ",105],["18:19:3",295,"لِيَتَسَآءَلُوا۟","that they might question","وَكَذَٰلِكَ بَعَثْنَـٰهُمْ","بَيْنَهُمْ ۚ قَالَ قَآئِلٌۭ",939],["18:70:5",301,"تَسْـَٔلْنِى","ask me","فَإِنِ ٱتَّبَعْتَنِى فَلَا","عَن شَىْءٍ حَتَّىٰٓ",105],["18:76:3",302,"سَأَلْتُكَ","I ask you","قَالَ إِن","عَن شَىْءٍۭ بَعْدَهَا",105],["18:83:1",302,"وَيَسْـَٔلُونَكَ","And they ask you","","عَن ذِى ٱلْقَرْنَيْنِ ۖ",105],["20:36:4",313,"سُؤْلَكَ","your request","قَالَ قَدْ أُوتِيتَ","يَـٰمُوسَىٰ",4271],["20:105:1",319,"وَيَسْـَٔلُونَكَ","And they ask you","","عَنِ ٱلْجِبَالِ فَقُلْ",105],["20:132:7",321,"نَسْـَٔلُكَ","We ask you","وَٱصْطَبِرْ عَلَيْهَا ۖ لَا","رِزْقًۭا ۖ نَّحْنُ نَرْزُقُكَ ۗ",105],["21:7:8",322,"فَسْـَٔلُوٓا۟","So ask","رِجَالًۭا نُّوحِىٓ إِلَيْهِمْ ۖ","أَهْلَ ٱلذِّكْرِ إِن",105],["21:13:10",323,"تُسْـَٔلُونَ","be questioned","فِيهِ وَمَسَـٰكِنِكُمْ لَعَلَّكُمْ","",105],["21:23:2",323,"يُسْـَٔلُ","He (can) be questioned","لَا","عَمَّا يَفْعَلُ وَهُمْ",105],["21:23:6",323,"يُسْـَٔلُونَ","will be questioned","عَمَّا يَفْعَلُ وَهُمْ","",105],["21:63:6",327,"فَسْـَٔلُوهُمْ","So ask them","فَعَلَهُۥ كَبِيرُهُمْ هَـٰذَا","إِن كَانُوا۟ يَنطِقُونَ",105],["23:72:2",346,"تَسْـَٔلُهُمْ","you ask them","أَمْ","خَرْجًۭا فَخَرَاجُ رَبِّكَ",105],["23:101:10",348,"يَتَسَآءَلُونَ","will they ask each other","بَيْنَهُمْ يَوْمَئِذٍۢ وَلَا","",939],["23:113:7",349,"فَسْـَٔلِ","but ask","أَوْ بَعْضَ يَوْمٍۢ","ٱلْعَآدِّينَ",105],["25:16:10",361,"مَّسْـُٔولًۭا","requested","عَلَىٰ رَبِّكَ وَعْدًۭا","",1357],["25:57:3",365,"أَسْـَٔلُكُمْ","I ask (of) you","قُلْ مَآ","عَلَيْهِ مِنْ أَجْرٍ",105],["25:59:15",365,"فَسْـَٔلْ","so ask","عَلَى ٱلْعَرْشِ ۚ ٱلرَّحْمَـٰنُ","بِهِۦ خَبِيرًۭا",105],["26:109:2",371,"أَسْـَٔلُكُمْ","I ask (of) you","وَمَآ","عَلَيْهِ مِنْ أَجْرٍ ۖ",105],["26:127:2",372,"أَسْـَٔلُكُمْ","I ask you","وَمَآ","عَلَيْهِ مِنْ أَجْرٍ ۖ",105],["26:145:2",373,"أَسْـَٔلُكُمْ","I ask you","وَمَآ","عَلَيْهِ مِنْ أَجْرٍ ۖ",105],["26:164:2",374,"أَسْـَٔلُكُمْ","I ask you","وَمَآ","عَلَيْهِ مِنْ أَجْرٍ ۖ",105],["26:180:2",374,"أَسْـَٔلُكُمْ","I ask (of) you","وَمَآ","عَلَيْهِ مِنْ أَجْرٍ ۖ",105],["28:66:7",393,"يَتَسَآءَلُونَ","will not ask one another","يَوْمَئِذٍۢ فَهُمْ لَا","",939],["28:78:25",395,"يُسْـَٔلُ","will be questioned","وَأَكْثَرُ جَمْعًۭا ۚ وَلَا","عَن ذُنُوبِهِمُ ٱلْمُجْرِمُونَ",105],["29:13:6",397,"وَلَيُسْـَٔلُنَّ","and surely they will be questioned","وَأَثْقَالًۭا مَّعَ أَثْقَالِهِمْ ۖ","يَوْمَ ٱلْقِيَـٰمَةِ عَمَّا",105],["29:61:2",403,"سَأَلْتَهُم","you ask them","وَلَئِن","مَّنْ خَلَقَ ٱلسَّمَـٰوَٰتِ",105],["29:63:2",403,"سَأَلْتَهُم","you ask them","وَلَئِن","مَّن نَّزَّلَ مِنَ",105],["31:25:2",413,"سَأَلْتَهُم","you ask them","وَلَئِن","مَّنْ خَلَقَ ٱلسَّمَـٰوَٰتِ",105],["33:8:1",419,"لِّيَسْـَٔلَ","That He may ask","","ٱلصَّـٰدِقِينَ عَن صِدْقِهِمْ ۚ",105],["33:14:7",419,"سُئِلُوا۟","they had been asked","مِّنْ أَقْطَارِهَا ثُمَّ","ٱلْفِتْنَةَ لَـَٔاتَوْهَا وَمَا",105],["33:15:13",419,"مَسْـُٔولًۭا","to be questioned","وَكَانَ عَهْدُ ٱللَّهِ","",1357],["33:20:14",420,"يَسْـَٔلُونَ","asking","بَادُونَ فِى ٱلْأَعْرَابِ","عَنْ أَنۢبَآئِكُمْ ۖ وَلَوْ",105],["33:53:40",425,"سَأَلْتُمُوهُنَّ","you ask them","مِنَ ٱلْحَقِّ ۚ وَإِذَا","مَتَـٰعًۭا فَسْـَٔلُوهُنَّ مِن",105],["33:53:42",425,"فَسْـَٔلُوهُنَّ","then ask them","وَإِذَا سَأَلْتُمُوهُنَّ مَتَـٰعًۭا","مِن وَرَآءِ حِجَابٍۢ ۚ",105],["33:63:1",427,"يَسْـَٔلُكَ","Ask you","","ٱلنَّاسُ عَنِ ٱلسَّاعَةِ ۖ",105],["34:25:3",431,"تُسْـَٔلُونَ","you will be asked","قُل لَّا","عَمَّآ أَجْرَمْنَا وَلَا",105],["34:25:7",431,"نُسْـَٔلُ","we will be asked","عَمَّآ أَجْرَمْنَا وَلَا","عَمَّا تَعْمَلُونَ",105],["34:47:3",433,"سَأَلْتُكُم","I ask you","قُلْ مَا","مِّنْ أَجْرٍۢ فَهُوَ",105],["36:21:4",441,"يَسْـَٔلُكُمْ","ask (of) you","ٱتَّبِعُوا۟ مَن لَّا","أَجْرًۭا وَهُم مُّهْتَدُونَ",105],["37:24:3",446,"مَّسْـُٔولُونَ","(are) to be questioned","وَقِفُوهُمْ ۖ إِنَّهُم","",1357],["37:27:5",447,"يَتَسَآءَلُونَ","questioning one another","بَعْضُهُمْ عَلَىٰ بَعْضٍۢ","",939],["37:50:5",447,"يَتَسَآءَلُونَ","questioning one another","بَعْضُهُمْ عَلَىٰ بَعْضٍۢ","",939],["38:24:4",454,"بِسُؤَالِ","by demanding","قَالَ لَقَدْ ظَلَمَكَ","نَعْجَتِكَ إِلَىٰ نِعَاجِهِۦ ۖ",4270],["38:86:3",458,"أَسْـَٔلُكُمْ","I ask of you","قُلْ مَآ","عَلَيْهِ مِنْ أَجْرٍۢ",105],["39:38:2",462,"سَأَلْتَهُم","you ask them","وَلَئِن","مَّنْ خَلَقَ ٱلسَّمَـٰوَٰتِ",105],["41:10:15",477,"لِّلسَّآئِلِينَ","for those who ask","أَرْبَعَةِ أَيَّامٍۢ سَوَآءًۭ","",1099],["42:23:12",486,"أَسْـَٔلُكُمْ","I ask you","ٱلصَّـٰلِحَـٰتِ ۗ قُل لَّآ","عَلَيْهِ أَجْرًا إِلَّا",105],["43:9:2",489,"سَأَلْتَهُم","you ask them","وَلَئِن","مَّنْ خَلَقَ ٱلسَّمَـٰوَٰتِ",105],["43:19:12",490,"وَيُسْـَٔلُونَ","and they will be questioned","خَلْقَهُمْ ۚ سَتُكْتَبُ شَهَـٰدَتُهُمْ","",105],["43:44:6",492,"تُسْـَٔلُونَ","you will be questioned","لَّكَ وَلِقَوْمِكَ ۖ وَسَوْفَ","",105],["43:45:1",492,"وَسْـَٔلْ","And ask","","مَنْ أَرْسَلْنَا مِن",105],["43:87:2",495,"سَأَلْتَهُم","you ask them","وَلَئِن","مَّنْ خَلَقَهُمْ لَيَقُولُنَّ",105],["47:36:12",510,"يَسْـَٔلْكُمْ","will ask you","يُؤْتِكُمْ أُجُورَكُمْ وَلَا","أَمْوَٰلَكُمْ",105],["47:37:2",510,"يَسْـَٔلْكُمُوهَا","He were to ask you for it","إِن","فَيُحْفِكُمْ تَبْخَلُوا۟ وَيُخْرِجْ",105],["51:12:1",521,"يَسْـَٔلُونَ","They ask","","أَيَّانَ يَوْمُ ٱلدِّينِ",105],["51:19:4",521,"لِّلسَّآئِلِ","(of) those who asked","وَفِىٓ أَمْوَٰلِهِمْ حَقٌّۭ","وَٱلْمَحْرُومِ",1099],["52:25:5",524,"يَتَسَآءَلُونَ","inquiring","بَعْضُهُمْ عَلَىٰ بَعْضٍۢ","",939],["52:40:2",525,"تَسْـَٔلُهُمْ","(do) you ask from them","أَمْ","أَجْرًۭا فَهُم مِّن",105],["55:29:1",532,"يَسْـَٔلُهُۥ","Asks Him","","مَن فِى ٱلسَّمَـٰوَٰتِ",105],["55:39:3",532,"يُسْـَٔلُ","will be asked","فَيَوْمَئِذٍۢ لَّا","عَن ذَنۢبِهِۦٓ إِنسٌۭ",105],["60:10:42",550,"وَسْـَٔلُوا۟","but ask (for)","تُمْسِكُوا۟ بِعِصَمِ ٱلْكَوَافِرِ","مَآ أَنفَقْتُمْ وَلْيَسْـَٔلُوا۟",105],["60:10:45",550,"وَلْيَسْـَٔلُوا۟","and let them ask","وَسْـَٔلُوا۟ مَآ أَنفَقْتُمْ","مَآ أَنفَقُوا۟ ۚ ذَٰلِكُمْ",105],["67:8:9",562,"سَأَلَهُمْ","(will) ask them","أُلْقِىَ فِيهَا فَوْجٌۭ","خَزَنَتُهَآ أَلَمْ يَأْتِكُمْ",105],["68:40:1",565,"سَلْهُمْ","Ask them","","أَيُّهُم بِذَٰلِكَ زَعِيمٌ",105],["68:46:2",566,"تَسْـَٔلُهُمْ","you ask them","أَمْ","أَجْرًۭا فَهُم مِّن",105],["70:1:1",568,"سَأَلَ","Asked","","سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ",105],["70:1:2",568,"سَآئِلٌۢ","a questioner","سَأَلَ","بِعَذَابٍۢ وَاقِعٍۢ",1099],["70:10:2",568,"يَسْـَٔلُ","will ask","وَلَا","حَمِيمٌ حَمِيمًۭا",105],["70:25:1",569,"لِّلسَّآئِلِ","For the one who asks","","وَٱلْمَحْرُومِ",1099],["74:40:3",576,"يَتَسَآءَلُونَ","asking each other","فِى جَنَّـٰتٍۢ","",939],["75:6:1",577,"يَسْـَٔلُ","He asks","","أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ",105],["78:1:2",582,"يَتَسَآءَلُونَ","are they asking one another","عَمَّ","",939],["79:42:1",584,"يَسْـَٔلُونَكَ","They ask you","","عَنِ ٱلسَّاعَةِ أَيَّانَ",105],["81:8:3",586,"سُئِلَتْ","is asked","وَإِذَا ٱلْمَوْءُۥدَةُ","",105],["93:10:2",596,"ٱلسَّآئِلَ","one who asks","وَأَمَّا","فَلَا تَنْهَرْ",1099],["102:8:2",600,"لَتُسْـَٔلُنَّ","surely you will be asked","ثُمَّ","يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ",105]]