[["7:77:3",160,"وَعَتَوْا۟","and (were) insolent","فَعَقَرُوا۟ ٱلنَّاقَةَ","عَنْ أَمْرِ رَبِّهِمْ",1296],["7:166:2",172,"عَتَوْا۟","they exceeded all bounds","فَلَمَّا","عَن مَّا نُهُوا۟",1296],["19:8:14",305,"عِتِيًّۭا","extreme","بَلَغْتُ مِنَ ٱلْكِبَرِ","",2254],["19:69:10",310,"عِتِيًّۭا","(in) rebellion","أَشَدُّ عَلَى ٱلرَّحْمَـٰنِ","",2254],["25:21:17",362,"وَعَتَوْ","and (become) insolent","ٱسْتَكْبَرُوا۟ فِىٓ أَنفُسِهِمْ","عُتُوًّۭا كَبِيرًۭا",1296],["25:21:18",362,"عُتُوًّۭا","(with) insolence","فِىٓ أَنفُسِهِمْ وَعَتَوْ","كَبِيرًۭا",2262],["51:44:1",522,"فَعَتَوْا۟","But they rebelled","","عَنْ أَمْرِ رَبِّهِمْ",1296],["65:8:4",559,"عَتَتْ","rebelled","وَكَأَيِّن مِّن قَرْيَةٍ","عَنْ أَمْرِ رَبِّهَا",1296],["67:21:11",563,"عُتُوٍّۢ","pride","بَل لَّجُّوا۟ فِى","وَنُفُورٍ",2262],["69:6:6",566,"عَاتِيَةٍۢ","violent","فَأُهْلِكُوا۟ بِرِيحٍۢ صَرْصَرٍ","",3098]]