[["2:17:7",4,"أَضَآءَتْ","it illuminated","ٱسْتَوْقَدَ نَارًۭا فَلَمَّآ","مَا حَوْلَهُۥ ذَهَبَ",1721],["2:20:6",4,"أَضَآءَ","it flashes","يَخْطَفُ أَبْصَـٰرَهُمْ ۖ كُلَّمَآ","لَهُم مَّشَوْا۟ فِيهِ",1721],["10:5:5",208,"ضِيَآءًۭ","a shining light","ٱلَّذِى جَعَلَ ٱلشَّمْسَ","وَٱلْقَمَرَ نُورًۭا وَقَدَّرَهُۥ",1758],["21:48:6",326,"وَضِيَآءًۭ","and a light","مُوسَىٰ وَهَـٰرُونَ ٱلْفُرْقَانَ","وَذِكْرًۭا لِّلْمُتَّقِينَ",1758],["24:35:28",354,"يُضِىٓءُ","glow","غَرْبِيَّةٍۢ يَكَادُ زَيْتُهَا","وَلَوْ لَمْ تَمْسَسْهُ",1721],["28:71:17",394,"بِضِيَآءٍ ۖ","light","غَيْرُ ٱللَّهِ يَأْتِيكُم","أَفَلَا تَسْمَعُونَ",1758]]