[["2:88:5",13,"لَّعَنَهُمُ","has cursed them","قُلُوبُنَا غُلْفٌۢ ۚ بَل","ٱللَّهُ بِكُفْرِهِمْ فَقَلِيلًۭا",456],["2:89:23",14,"فَلَعْنَةُ","So (the) curse","عَرَفُوا۟ كَفَرُوا۟ بِهِۦ ۚ","ٱللَّهِ عَلَى ٱلْكَـٰفِرِينَ",665],["2:159:17",24,"يَلْعَنُهُمُ","curses them","فِى ٱلْكِتَـٰبِ ۙ أُو۟لَـٰٓئِكَ","ٱللَّهُ وَيَلْعَنُهُمُ ٱللَّـٰعِنُونَ",456],["2:159:19",24,"وَيَلْعَنُهُمُ","and curse them","أُو۟لَـٰٓئِكَ يَلْعَنُهُمُ ٱللَّهُ","ٱللَّـٰعِنُونَ",456],["2:159:20",24,"ٱللَّـٰعِنُونَ","the ones who curse","يَلْعَنُهُمُ ٱللَّهُ وَيَلْعَنُهُمُ","",3610],["2:161:9",24,"لَعْنَةُ","(is the) curse","كُفَّارٌ أُو۟لَـٰٓئِكَ عَلَيْهِمْ","ٱللَّهِ وَٱلْمَلَـٰٓئِكَةِ وَٱلنَّاسِ",665],["3:61:22",57,"لَّعْنَتَ","the curse","ثُمَّ نَبْتَهِلْ فَنَجْعَل","ٱللَّهِ عَلَى ٱلْكَـٰذِبِينَ",665],["3:87:5",61,"لَعْنَةَ","(is the) curse","جَزَآؤُهُمْ أَنَّ عَلَيْهِمْ","ٱللَّهِ وَٱلْمَلَـٰٓئِكَةِ وَٱلنَّاسِ",665],["4:46:32",86,"لَّعَنَهُمُ","cursed them","لَّهُمْ وَأَقْوَمَ وَلَـٰكِن","ٱللَّهُ بِكُفْرِهِمْ فَلَا",456],["4:47:20",86,"نَلْعَنَهُمْ","We curse them","عَلَىٰٓ أَدْبَارِهَآ أَوْ","كَمَا لَعَنَّآ أَصْحَـٰبَ",456],["4:47:22",86,"لَعَنَّآ","We cursed","أَوْ نَلْعَنَهُمْ كَمَا","أَصْحَـٰبَ ٱلسَّبْتِ ۚ وَكَانَ",456],["4:52:3",87,"لَعَنَهُمُ","(who have been) cursed","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","ٱللَّهُ ۖ وَمَن يَلْعَنِ",456],["4:52:6",87,"يَلْعَنِ","(is) cursed","لَعَنَهُمُ ٱللَّهُ ۖ وَمَن","ٱللَّهُ فَلَن تَجِدَ",456],["4:93:12",93,"وَلَعَنَهُۥ","and He (will) curse him","وَغَضِبَ ٱللَّهُ عَلَيْهِ","وَأَعَدَّ لَهُۥ عَذَابًا",456],["4:118:1",97,"لَّعَنَهُ","He was cursed","","ٱللَّهُ ۘ وَقَالَ لَأَتَّخِذَنَّ",456],["5:13:4",109,"لَعَنَّـٰهُمْ","We cursed them","فَبِمَا نَقْضِهِم مِّيثَـٰقَهُمْ","وَجَعَلْنَا قُلُوبَهُمْ قَـٰسِيَةًۭ ۖ",456],["5:60:11",118,"لَّعَنَهُ","has (been) cursed","عِندَ ٱللَّهِ ۚ مَن","ٱللَّهُ وَغَضِبَ عَلَيْهِ",456],["5:64:8",118,"وَلُعِنُوا۟","and they have been cursed","مَغْلُولَةٌ ۚ غُلَّتْ أَيْدِيهِمْ","بِمَا قَالُوا۟ ۘ بَلْ",456],["5:78:1",121,"لُعِنَ","Were cursed","","ٱلَّذِينَ كَفَرُوا۟ مِنۢ",456],["7:38:17",155,"لَّعَنَتْ","it cursed","كُلَّمَا دَخَلَتْ أُمَّةٌۭ","أُخْتَهَا ۖ حَتَّىٰٓ إِذَا",456],["7:44:25",156,"لَّعْنَةُ","(The) curse","مُؤَذِّنٌۢ بَيْنَهُمْ أَن","ٱللَّهِ عَلَى ٱلظَّـٰلِمِينَ",665],["9:68:12",197,"وَلَعَنَهُمُ","And Allah has cursed them","فِيهَا ۚ هِىَ حَسْبُهُمْ ۚ","ٱللَّهُ ۖ وَلَهُمْ عَذَابٌۭ",456],["11:18:20",223,"لَعْنَةُ","(The) curse of Allah","عَلَىٰ رَبِّهِمْ ۚ أَلَا","ٱللَّهِ عَلَى ٱلظَّـٰلِمِينَ",665],["11:60:5",228,"لَعْنَةًۭ","(with) a curse","فِى هَـٰذِهِ ٱلدُّنْيَا","وَيَوْمَ ٱلْقِيَـٰمَةِ ۗ أَلَآ",665],["11:99:4",233,"لَعْنَةًۭ","(by) a curse","وَأُتْبِعُوا۟ فِى هَـٰذِهِۦ","وَيَوْمَ ٱلْقِيَـٰمَةِ ۚ بِئْسَ",665],["13:25:20",252,"ٱللَّعْنَةُ","(is) the curse","ٱلْأَرْضِ ۙ أُو۟لَـٰٓئِكَ لَهُمُ","وَلَهُمْ سُوٓءُ ٱلدَّارِ",665],["15:35:3",264,"ٱللَّعْنَةَ","(will be) the curse","وَإِنَّ عَلَيْكَ","إِلَىٰ يَوْمِ ٱلدِّينِ",665],["17:60:17",288,"ٱلْمَلْعُونَةَ","the accursed","فِتْنَةًۭ لِّلنَّاسِ وَٱلشَّجَرَةَ","فِى ٱلْقُرْءَانِ ۚ وَنُخَوِّفُهُمْ",3681],["24:7:3",350,"لَعْنَتَ","(the) curse of Allah","وَٱلْخَـٰمِسَةُ أَنَّ","ٱللَّهِ عَلَيْهِ إِن",665],["24:23:7",352,"لُعِنُوا۟","are cursed","ٱلْمُحْصَنَـٰتِ ٱلْغَـٰفِلَـٰتِ ٱلْمُؤْمِنَـٰتِ","فِى ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ",456],["28:42:5",390,"لَعْنَةًۭ ۖ","a curse","فِى هَـٰذِهِ ٱلدُّنْيَا","وَيَوْمَ ٱلْقِيَـٰمَةِ هُم",665],["29:25:19",399,"وَيَلْعَنُ","and curse","يَكْفُرُ بَعْضُكُم بِبَعْضٍۢ","بَعْضُكُم بَعْضًۭا وَمَأْوَىٰكُمُ",456],["33:57:6",426,"لَعَنَهُمُ","Allah has cursed them","يُؤْذُونَ ٱللَّهَ وَرَسُولَهُۥ","ٱللَّهُ فِى ٱلدُّنْيَا",456],["33:61:1",426,"مَّلْعُونِينَ ۖ","Accursed","","أَيْنَمَا ثُقِفُوٓا۟ أُخِذُوا۟",3916],["33:64:3",427,"لَعَنَ","has cursed","إِنَّ ٱللَّهَ","ٱلْكَـٰفِرِينَ وَأَعَدَّ لَهُمْ",456],["33:68:6",427,"وَٱلْعَنْهُمْ","and curse them","ضِعْفَيْنِ مِنَ ٱلْعَذَابِ","لَعْنًۭا كَبِيرًۭا",456],["33:68:7",427,"لَعْنًۭا","(with) a curse","مِنَ ٱلْعَذَابِ وَٱلْعَنْهُمْ","كَبِيرًۭا",3592],["38:78:3",457,"لَعْنَتِىٓ","(is) My curse","وَإِنَّ عَلَيْكَ","إِلَىٰ يَوْمِ ٱلدِّينِ",665],["40:52:7",473,"ٱللَّعْنَةُ","(is) the curse","ٱلظَّـٰلِمِينَ مَعْذِرَتُهُمْ ۖ وَلَهُمُ","وَلَهُمْ سُوٓءُ ٱلدَّارِ",665],["47:23:3",509,"لَعَنَهُمُ","Allah has cursed them","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","ٱللَّهُ فَأَصَمَّهُمْ وَأَعْمَىٰٓ",456],["48:6:16",511,"وَلَعَنَهُمْ","and He has cursed them","وَغَضِبَ ٱللَّهُ عَلَيْهِمْ","وَأَعَدَّ لَهُمْ جَهَنَّمَ ۖ",456]]