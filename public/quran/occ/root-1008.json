[["55:33:7",532,"تَنفُذُوا۟","pass beyond","إِنِ ٱسْتَطَعْتُمْ أَن","مِنْ أَقْطَارِ ٱلسَّمَـٰوَٰتِ",2011],["55:33:12",532,"فَٱنفُذُوا۟ ۚ","then pass","أَقْطَارِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","لَا تَنفُذُونَ إِلَّا",2011],["55:33:14",532,"تَنفُذُونَ","you (can) pass","وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا","إِلَّا بِسُلْطَـٰنٍۢ",2011]]