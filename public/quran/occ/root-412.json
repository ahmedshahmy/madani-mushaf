[["3:179:18",73,"لِيُطْلِعَكُمْ","to inform you","وَمَا كَانَ ٱللَّهُ","عَلَى ٱلْغَيْبِ وَلَـٰكِنَّ",4712],["5:13:19",109,"تَطَّلِعُ","to discover","بِهِۦ ۚ وَلَا تَزَالُ","عَلَىٰ خَآئِنَةٍۢ مِّنْهُمْ",1061],["6:99:22",140,"طَلْعِهَا","its spathe","وَمِنَ ٱلنَّخْلِ مِن","قِنْوَانٌۭ دَانِيَةٌۭ وَجَنَّـٰتٍۢ",1527],["18:17:4",295,"طَلَعَت","it rose","۞ وَتَرَى ٱلشَّمْسَ إِذَا","تَّزَٰوَرُ عَن كَهْفِهِمْ",2307],["18:18:15",295,"ٱطَّلَعْتَ","you had looked","ذِرَاعَيْهِ بِٱلْوَصِيدِ ۚ لَوِ","عَلَيْهِمْ لَوَلَّيْتَ مِنْهُمْ",1061],["18:90:4",303,"مَطْلِعَ","(the) rising place","حَتَّىٰٓ إِذَا بَلَغَ","ٱلشَّمْسِ وَجَدَهَا تَطْلُعُ",3645],["18:90:7",303,"تَطْلُعُ","rising","مَطْلِعَ ٱلشَّمْسِ وَجَدَهَا","عَلَىٰ قَوْمٍۢ لَّمْ",2307],["19:78:1",311,"أَطَّلَعَ","Has he looked","","ٱلْغَيْبَ أَمِ ٱتَّخَذَ",1061],["20:130:9",321,"طُلُوعِ","(the) rising","بِحَمْدِ رَبِّكَ قَبْلَ","ٱلشَّمْسِ وَقَبْلَ غُرُوبِهَا ۖ",2310],["26:148:3",373,"طَلْعُهَا","its spadix","وَزُرُوعٍۢ وَنَخْلٍۢ","هَضِيمٌۭ",1527],["28:38:20",390,"أَطَّلِعُ","I may look","لِّى صَرْحًۭا لَّعَلِّىٓ","إِلَىٰٓ إِلَـٰهِ مُوسَىٰ",1061],["37:54:4",448,"مُّطَّلِعُونَ","be looking","قَالَ هَلْ أَنتُم","",3961],["37:55:1",448,"فَٱطَّلَعَ","Then he (will) look","","فَرَءَاهُ فِى سَوَآءِ",1061],["37:65:1",448,"طَلْعُهَا","Its emerging fruit","","كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ",1527],["40:37:3",471,"فَأَطَّلِعَ","so I may look","أَسْبَـٰبَ ٱلسَّمَـٰوَٰتِ","إِلَىٰٓ إِلَـٰهِ مُوسَىٰ",1061],["50:10:4",518,"طَلْعٌۭ","(are) layers","وَٱلنَّخْلَ بَاسِقَـٰتٍۢ لَّهَا","نَّضِيدٌۭ",1527],["50:39:9",520,"طُلُوعِ","(the) rising","بِحَمْدِ رَبِّكَ قَبْلَ","ٱلشَّمْسِ وَقَبْلَ ٱلْغُرُوبِ",2310],["97:5:4",598,"مَطْلَعِ","(the) emergence","سَلَـٰمٌ هِىَ حَتَّىٰ","ٱلْفَجْرِ",3644],["104:7:2",601,"تَطَّلِعُ","mounts up","ٱلَّتِى","عَلَى ٱلْأَفْـِٔدَةِ",1061]]