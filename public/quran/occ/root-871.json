[["5:4:12",107,"ٱلْجَوَارِحِ","(your) hunting animals","وَمَا عَلَّمْتُم مِّنَ","مُكَلِّبِينَ تُعَلِّمُونَهُنَّ مِمَّا",3529],["5:45:15",115,"وَٱلْجُرُوحَ","and (for) wounds","بِٱلْأُذُنِ وَٱلسِّنَّ بِٱلسِّنِّ","قِصَاصٌۭ ۚ فَمَن تَصَدَّقَ",3550],["6:60:7",135,"جَرَحْتُم","you committed","بِٱلَّيْلِ وَيَعْلَمُ مَا","بِٱلنَّهَارِ ثُمَّ يَبْعَثُكُمْ",3527],["45:21:4",500,"ٱجْتَرَحُوا۟","commit","أَمْ حَسِبَ ٱلَّذِينَ","ٱلسَّيِّـَٔاتِ أَن نَّجْعَلَهُمْ",4798]]