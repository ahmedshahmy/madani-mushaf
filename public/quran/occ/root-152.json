[["2:50:2",8,"فَرَقْنَا","We parted","وَإِذْ","بِكُمُ ٱلْبَحْرَ فَأَنجَيْنَـٰكُمْ",1331],["2:53:5",8,"وَٱلْفُرْقَانَ","and the Criterion","ءَاتَيْنَا مُوسَى ٱلْكِتَـٰبَ","لَعَلَّكُمْ تَهْتَدُونَ",1070],["2:75:7",11,"فَرِيقٌۭ","a party","لَكُمْ وَقَدْ كَانَ","مِّنْهُمْ يَسْمَعُونَ كَلَـٰمَ",344],["2:85:7",13,"فَرِيقًۭا","a party","تَقْتُلُونَ أَنفُسَكُمْ وَتُخْرِجُونَ","مِّنكُم مِّن دِيَـٰرِهِمْ",344],["2:87:25",13,"فَفَرِيقًۭا","So a party","تَهْوَىٰٓ أَنفُسُكُمُ ٱسْتَكْبَرْتُمْ","كَذَّبْتُمْ وَفَرِيقًۭا تَقْتُلُونَ",344],["2:87:27",13,"وَفَرِيقًۭا","and a party","ٱسْتَكْبَرْتُمْ فَفَرِيقًۭا كَذَّبْتُمْ","تَقْتُلُونَ",344],["2:100:5",15,"فَرِيقٌۭ","a party","عَـٰهَدُوا۟ عَهْدًۭا نَّبَذَهُۥ","مِّنْهُم ۚ بَلْ أَكْثَرُهُمْ",344],["2:101:11",15,"فَرِيقٌۭ","a party","لِّمَا مَعَهُمْ نَبَذَ","مِّنَ ٱلَّذِينَ أُوتُوا۟",344],["2:102:38",16,"يُفَرِّقُونَ","[they] causes separation","فَيَتَعَلَّمُونَ مِنْهُمَا مَا","بِهِۦ بَيْنَ ٱلْمَرْءِ",899],["2:136:25",21,"نُفَرِّقُ","we make distinction","مِن رَّبِّهِمْ لَا","بَيْنَ أَحَدٍۢ مِّنْهُمْ",899],["2:146:9",23,"فَرِيقًۭا","a group","يَعْرِفُونَ أَبْنَآءَهُمْ ۖ وَإِنَّ","مِّنْهُمْ لَيَكْتُمُونَ ٱلْحَقَّ",344],["2:185:12",28,"وَٱلْفُرْقَانِ ۚ","and the Criterion","وَبَيِّنَـٰتٍۢ مِّنَ ٱلْهُدَىٰ","فَمَن شَهِدَ مِنكُمُ",1070],["2:188:11",29,"فَرِيقًۭا","a portion","إِلَى ٱلْحُكَّامِ لِتَأْكُلُوا۟","مِّنْ أَمْوَٰلِ ٱلنَّاسِ",344],["2:285:16",49,"نُفَرِّقُ","we make distinction","وَكُتُبِهِۦ وَرُسُلِهِۦ لَا","بَيْنَ أَحَدٍۢ مِّن",899],["3:4:6",50,"ٱلْفُرْقَانَ ۗ","the Criterion","هُدًۭى لِّلنَّاسِ وَأَنزَلَ","إِنَّ ٱلَّذِينَ كَفَرُوا۟",1070],["3:23:17",53,"فَرِيقٌۭ","a party","بَيْنَهُمْ ثُمَّ يَتَوَلَّىٰ","مِّنْهُمْ وَهُم مُّعْرِضُونَ",344],["3:78:3",60,"لَفَرِيقًۭا","surely (is) a group","وَإِنَّ مِنْهُمْ","يَلْوُۥنَ أَلْسِنَتَهُم بِٱلْكِتَـٰبِ",344],["3:84:23",61,"نُفَرِّقُ","we make distinction","مِن رَّبِّهِمْ لَا","بَيْنَ أَحَدٍۢ مِّنْهُمْ",899],["3:100:6",62,"فَرِيقًۭا","a group","ءَامَنُوٓا۟ إِن تُطِيعُوا۟","مِّنَ ٱلَّذِينَ أُوتُوا۟",344],["3:103:6",63,"تَفَرَّقُوا۟ ۚ","be divided","ٱللَّهِ جَمِيعًۭا وَلَا","وَٱذْكُرُوا۟ نِعْمَتَ ٱللَّهِ",1002],["3:105:4",63,"تَفَرَّقُوا۟","became divided","وَلَا تَكُونُوا۟ كَٱلَّذِينَ","وَٱخْتَلَفُوا۟ مِنۢ بَعْدِ",1002],["4:77:18",90,"فَرِيقٌۭ","a group","عَلَيْهِمُ ٱلْقِتَالُ إِذَا","مِّنْهُمْ يَخْشَوْنَ ٱلنَّاسَ",344],["4:130:2",99,"يَتَفَرَّقَا","they separate","وَإِن","يُغْنِ ٱللَّهُ كُلًّۭا",1002],["4:150:8",102,"يُفَرِّقُوا۟","they differentiate","وَرُسُلِهِۦ وَيُرِيدُونَ أَن","بَيْنَ ٱللَّهِ وَرُسُلِهِۦ",899],["4:152:6",102,"يُفَرِّقُوا۟","they differentiate","بِٱللَّهِ وَرُسُلِهِۦ وَلَمْ","بَيْنَ أَحَدٍۢ مِّنْهُمْ",899],["5:25:9",112,"فَٱفْرُقْ","so (make a) separation","إِلَّا نَفْسِى وَأَخِى ۖ","بَيْنَنَا وَبَيْنَ ٱلْقَوْمِ",1331],["5:70:16",119,"فَرِيقًۭا","a group","لَا تَهْوَىٰٓ أَنفُسُهُمْ","كَذَّبُوا۟ وَفَرِيقًۭا يَقْتُلُونَ",344],["5:70:18",119,"وَفَرِيقًۭا","and a group","أَنفُسُهُمْ فَرِيقًۭا كَذَّبُوا۟","يَقْتُلُونَ",344],["6:81:17",137,"ٱلْفَرِيقَيْنِ","(of) the two parties","عَلَيْكُمْ سُلْطَـٰنًۭا ۚ فَأَىُّ","أَحَقُّ بِٱلْأَمْنِ ۖ إِن",344],["6:153:9",149,"فَتَفَرَّقَ","then they will separate","وَلَا تَتَّبِعُوا۟ ٱلسُّبُلَ","بِكُمْ عَن سَبِيلِهِۦ ۚ",1002],["6:159:3",150,"فَرَّقُوا۟","divide","إِنَّ ٱلَّذِينَ","دِينَهُمْ وَكَانُوا۟ شِيَعًۭا",899],["7:30:1",153,"فَرِيقًا","A group","","هَدَىٰ وَفَرِيقًا حَقَّ",344],["7:30:3",153,"وَفَرِيقًا","and a group","فَرِيقًا هَدَىٰ","حَقَّ عَلَيْهِمُ ٱلضَّلَـٰلَةُ ۗ",344],["8:5:8",177,"فَرِيقًۭا","a party","بَيْتِكَ بِٱلْحَقِّ وَإِنَّ","مِّنَ ٱلْمُؤْمِنِينَ لَكَـٰرِهُونَ",344],["8:29:9",180,"فُرْقَانًۭا","a criterion","ٱللَّهَ يَجْعَل لَّكُمْ","وَيُكَفِّرْ عَنكُمْ سَيِّـَٔاتِكُمْ",1070],["8:41:25",182,"ٱلْفُرْقَانِ","(of) the criterion","عَلَىٰ عَبْدِنَا يَوْمَ","يَوْمَ ٱلْتَقَى ٱلْجَمْعَانِ ۗ",1070],["9:56:10",196,"يَفْرَقُونَ","(who) are afraid","مِّنكُمْ وَلَـٰكِنَّهُمْ قَوْمٌۭ","",1331],["9:107:6",204,"وَتَفْرِيقًۢا","and (for) division","مَسْجِدًۭا ضِرَارًۭا وَكُفْرًۭا","بَيْنَ ٱلْمُؤْمِنِينَ وَإِرْصَادًۭا",4371],["9:117:19",205,"فَرِيقٍۢ","(of) a party","كَادَ يَزِيغُ قُلُوبُ","مِّنْهُمْ ثُمَّ تَابَ",344],["9:122:10",206,"فِرْقَةٍۢ","group","نَفَرَ مِن كُلِّ","مِّنْهُمْ طَآئِفَةٌۭ لِّيَتَفَقَّهُوا۟",3437],["11:24:2",224,"ٱلْفَرِيقَيْنِ","(of) the two parties","۞ مَثَلُ","كَٱلْأَعْمَىٰ وَٱلْأَصَمِّ وَٱلْبَصِيرِ",344],["12:39:4",240,"مُّتَفَرِّقُونَ","separate","يَـٰصَـٰحِبَىِ ٱلسِّجْنِ ءَأَرْبَابٌۭ","خَيْرٌ أَمِ ٱللَّهُ",3999],["12:67:11",243,"مُّتَفَرِّقَةٍۢ ۖ","different","وَٱدْخُلُوا۟ مِنْ أَبْوَٰبٍۢ","وَمَآ أُغْنِى عَنكُم",3998],["16:54:7",272,"فَرِيقٌۭ","A group","ٱلضُّرَّ عَنكُمْ إِذَا","مِّنكُم بِرَبِّهِمْ يُشْرِكُونَ",344],["17:106:2",293,"فَرَقْنَـٰهُ","We have divided","وَقُرْءَانًۭا","لِتَقْرَأَهُۥ عَلَى ٱلنَّاسِ",1331],["18:78:3",302,"فِرَاقُ","(is) parting","قَالَ هَـٰذَا","بَيْنِى وَبَيْنِكَ ۚ سَأُنَبِّئُكَ",2366],["19:73:12",310,"ٱلْفَرِيقَيْنِ","(of) the two groups","لِلَّذِينَ ءَامَنُوٓا۟ أَىُّ","خَيْرٌۭ مَّقَامًۭا وَأَحْسَنُ",344],["20:94:12",318,"فَرَّقْتَ","You caused division","خَشِيتُ أَن تَقُولَ","بَيْنَ بَنِىٓ إِسْرَٰٓءِيلَ",899],["21:48:5",326,"ٱلْفُرْقَانَ","the Criterion","ءَاتَيْنَا مُوسَىٰ وَهَـٰرُونَ","وَضِيَآءًۭ وَذِكْرًۭا لِّلْمُتَّقِينَ",1070],["23:109:3",349,"فَرِيقٌۭ","a party","إِنَّهُۥ كَانَ","مِّنْ عِبَادِى يَقُولُونَ",344],["24:47:8",356,"فَرِيقٌۭ","a party","وَأَطَعْنَا ثُمَّ يَتَوَلَّىٰ","مِّنْهُم مِّنۢ بَعْدِ",344],["24:48:9",356,"فَرِيقٌۭ","a party","لِيَحْكُمَ بَيْنَهُمْ إِذَا","مِّنْهُم مُّعْرِضُونَ",344],["25:1:4",359,"ٱلْفُرْقَانَ","the Criterion","تَبَارَكَ ٱلَّذِى نَزَّلَ","عَلَىٰ عَبْدِهِۦ لِيَكُونَ",1070],["26:63:11",370,"فِرْقٍۢ","part","فَٱنفَلَقَ فَكَانَ كُلُّ","كَٱلطَّوْدِ ٱلْعَظِيمِ",3436],["27:45:12",381,"فَرِيقَانِ","(became) two parties","ٱللَّهَ فَإِذَا هُمْ","يَخْتَصِمُونَ",344],["30:14:5",405,"يَتَفَرَّقُونَ","they will become separated","تَقُومُ ٱلسَّاعَةُ يَوْمَئِذٍۢ","",1002],["30:32:3",407,"فَرَّقُوا۟","divide","مِنَ ٱلَّذِينَ","دِينَهُمْ وَكَانُوا۟ شِيَعًۭا ۖ",899],["30:33:15",408,"فَرِيقٌۭ","A party","مِّنْهُ رَحْمَةً إِذَا","مِّنْهُم بِرَبِّهِمْ يُشْرِكُونَ",344],["33:13:12",419,"فَرِيقٌۭ","a group","لَكُمْ فَٱرْجِعُوا۟ ۚ وَيَسْتَـْٔذِنُ","مِّنْهُمُ ٱلنَّبِىَّ يَقُولُونَ",344],["33:26:13",421,"فَرِيقًۭا","a group","فِى قُلُوبِهِمُ ٱلرُّعْبَ","تَقْتُلُونَ وَتَأْسِرُونَ فَرِيقًۭا",344],["33:26:16",421,"فَرِيقًۭا","a group","فَرِيقًۭا تَقْتُلُونَ وَتَأْسِرُونَ","",344],["34:20:8",430,"فَرِيقًۭا","a group","ظَنَّهُۥ فَٱتَّبَعُوهُ إِلَّا","مِّنَ ٱلْمُؤْمِنِينَ",344],["42:7:17",483,"فَرِيقٌۭ","A party","لَا رَيْبَ فِيهِ ۚ","فِى ٱلْجَنَّةِ وَفَرِيقٌۭ",344],["42:7:20",483,"وَفَرِيقٌۭ","and a party","فَرِيقٌۭ فِى ٱلْجَنَّةِ","فِى ٱلسَّعِيرِ",344],["42:13:22",484,"تَتَفَرَّقُوا۟","be divided","أَقِيمُوا۟ ٱلدِّينَ وَلَا","فِيهِ ۚ كَبُرَ عَلَى",1002],["42:14:2",484,"تَفَرَّقُوٓا۟","they became divided","وَمَا","إِلَّا مِنۢ بَعْدِ",1002],["44:4:2",496,"يُفْرَقُ","is made distinct","فِيهَا","كُلُّ أَمْرٍ حَكِيمٍ",1331],["65:2:7",558,"فَارِقُوهُنَّ","part with them","فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ","بِمَعْرُوفٍۢ وَأَشْهِدُوا۟ ذَوَىْ",3399],["75:28:3",578,"ٱلْفِرَاقُ","(is) the parting","وَظَنَّ أَنَّهُ","",2366],["77:4:1",580,"فَٱلْفَـٰرِقَـٰتِ","And those who separate","","فَرْقًۭا",3406],["77:4:2",580,"فَرْقًۭا","(by the) Criterion","فَٱلْفَـٰرِقَـٰتِ","",3422],["98:4:2",598,"تَفَرَّقَ","became divided","وَمَا","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ",1002]]