[["2:24:4",4,"وَلَن","and never","فَإِن لَّمْ تَفْعَلُوا۟","تَفْعَلُوا۟ فَٱتَّقُوا۟ ٱلنَّارَ",109],["2:55:4",8,"لَن","Never","وَإِذْ قُلْتُمْ يَـٰمُوسَىٰ","نُّؤْمِنَ لَكَ حَتَّىٰ",109],["2:61:4",9,"لَن","Never (will)","وَإِذْ قُلْتُمْ يَـٰمُوسَىٰ","نَّصْبِرَ عَلَىٰ طَعَامٍۢ",109],["2:80:2",12,"لَن","Never","وَقَالُوا۟","تَمَسَّنَا ٱلنَّارُ إِلَّآ",109],["2:80:13",12,"فَلَن","so never","عِندَ ٱللَّهِ عَهْدًۭا","يُخْلِفَ ٱللَّهُ عَهْدَهُۥٓ ۖ",109],["2:95:1",15,"وَلَن","And never (will)","","يَتَمَنَّوْهُ أَبَدًۢا بِمَا",109],["2:111:2",17,"لَن","Never","وَقَالُوا۟","يَدْخُلَ ٱلْجَنَّةَ إِلَّا",109],["2:120:1",19,"وَلَن","And never","","تَرْضَىٰ عَنكَ ٱلْيَهُودُ",109],["3:10:4",51,"لَن","never","إِنَّ ٱلَّذِينَ كَفَرُوا۟","تُغْنِىَ عَنْهُمْ أَمْوَٰلُهُمْ",109],["3:24:4",53,"لَن","Never","ذَٰلِكَ بِأَنَّهُمْ قَالُوا۟","تَمَسَّنَا ٱلنَّارُ إِلَّآ",109],["3:85:6",61,"فَلَن","then never","غَيْرَ ٱلْإِسْلَـٰمِ دِينًۭا","يُقْبَلَ مِنْهُ وَهُوَ",109],["3:90:9",61,"لَّن","never","ثُمَّ ٱزْدَادُوا۟ كُفْرًۭا","تُقْبَلَ تَوْبَتُهُمْ وَأُو۟لَـٰٓئِكَ",109],["3:91:7",61,"فَلَن","then never","وَمَاتُوا۟ وَهُمْ كُفَّارٌۭ","يُقْبَلَ مِنْ أَحَدِهِم",109],["3:92:1",62,"لَن","Never","","تَنَالُوا۟ ٱلْبِرَّ حَتَّىٰ",109],["3:111:1",64,"لَن","Never","","يَضُرُّوكُمْ إِلَّآ أَذًۭى ۖ",109],["3:115:5",64,"فَلَن","then never","يَفْعَلُوا۟ مِنْ خَيْرٍۢ","يُكْفَرُوهُ ۗ وَٱللَّهُ عَلِيمٌۢ",109],["3:116:4",65,"لَن","never","إِنَّ ٱلَّذِينَ كَفَرُوا۟","تُغْنِىَ عَنْهُمْ أَمْوَٰلُهُمْ",109],["3:124:4",66,"أَلَن","Is it not","إِذْ تَقُولُ لِلْمُؤْمِنِينَ","يَكْفِيَكُمْ أَن يُمِدَّكُمْ",109],["3:144:21",68,"فَلَن","then never","يَنقَلِبْ عَلَىٰ عَقِبَيْهِ","يَضُرَّ ٱللَّهَ شَيْـًۭٔا ۗ",109],["3:176:8",73,"لَن","never","فِى ٱلْكُفْرِ ۚ إِنَّهُمْ","يَضُرُّوا۟ ٱللَّهَ شَيْـًۭٔا ۗ",109],["3:177:6",73,"لَن","never","ٱشْتَرَوُا۟ ٱلْكُفْرَ بِٱلْإِيمَـٰنِ","يَضُرُّوا۟ ٱللَّهَ شَيْـًۭٔا",109],["4:52:8",87,"فَلَن","then never","وَمَن يَلْعَنِ ٱللَّهُ","تَجِدَ لَهُۥ نَصِيرًا",109],["4:88:19",92,"فَلَن","then n