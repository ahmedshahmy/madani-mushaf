[["4:92:16",93,"وَدِيَةٌۭ","and blood money","فَتَحْرِيرُ رَقَبَةٍۢ مُّؤْمِنَةٍۢ","مُّسَلَّمَةٌ إِلَىٰٓ أَهْلِهِۦٓ",2355],["4:92:41",93,"فَدِيَةٌۭ","then blood money","بَيْنَكُمْ وَبَيْنَهُم مِّيثَـٰقٌۭ","مُّسَلَّمَةٌ إِلَىٰٓ أَهْلِهِۦ",2355],["9:121:9",206,"وَادِيًا","a valley","كَبِيرَةًۭ وَلَا يَقْطَعُونَ","إِلَّا كُتِبَ لَهُمْ",4506],["13:17:6",251,"أَوْدِيَةٌۢ","the valleys","ٱلسَّمَآءِ مَآءًۭ فَسَالَتْ","بِقَدَرِهَا فَٱحْتَمَلَ ٱلسَّيْلُ",2200],["14:37:6",260,"بِوَادٍ","in a valley","أَسْكَنتُ مِن ذُرِّيَّتِى","غَيْرِ ذِى زَرْعٍ",1110],["20:12:7",312,"بِٱلْوَادِ","(are) in the valley","فَٱخْلَعْ نَعْلَيْكَ ۖ إِنَّكَ","ٱلْمُقَدَّسِ طُوًۭى",1110],["26:225:6",376,"وَادٍۢ","valley","أَنَّهُمْ فِى كُلِّ","يَهِيمُونَ",1110],["27:18:5",378,"وَادِ","(the) valley","إِذَآ أَتَوْا۟ عَلَىٰ","ٱلنَّمْلِ قَالَتْ نَمْلَةٌۭ",1110],["28:30:6",389,"ٱلْوَادِ","(of) the valley","نُودِىَ مِن شَـٰطِئِ","ٱلْأَيْمَنِ فِى ٱلْبُقْعَةِ",1110],["46:24:5",505,"أَوْدِيَتِهِمْ","their valleys","رَأَوْهُ عَارِضًۭا مُّسْتَقْبِلَ","قَالُوا۟ هَـٰذَا عَارِضٌۭ",2200],["79:16:4",583,"بِٱلْوَادِ","in the valley","إِذْ نَادَىٰهُ رَبُّهُۥ","ٱلْمُقَدَّسِ طُوًى",1110],["89:9:5",593,"بِٱلْوَادِ","in the valley","ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ","",1110]]