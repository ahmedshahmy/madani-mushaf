[["5:22:6",111,"جَبَّارِينَ","(of) tyrannical strength","إِنَّ فِيهَا قَوْمًۭا","وَإِنَّا لَن نَّدْخُلَهَا",837],["11:59:11",228,"جَبَّارٍ","tyrant","وَٱتَّبَعُوٓا۟ أَمْرَ كُلِّ","عَنِيدٍۢ",837],["14:15:4",257,"جَبَّارٍ","tyrant","وَٱسْتَفْتَحُوا۟ وَخَابَ كُلُّ","عَنِيدٍۢ",837],["19:14:5",306,"جَبَّارًا","a tyrant","بِوَٰلِدَيْهِ وَلَمْ يَكُن","عَصِيًّۭا",837],["19:32:5",307,"جَبَّارًۭا","insolent","بِوَٰلِدَتِى وَلَمْ يَجْعَلْنِى","شَقِيًّۭا",837],["26:130:4",372,"جَبَّارِينَ","(as) tyrants","وَإِذَا بَطَشْتُم بَطَشْتُمْ","",837],["28:19:24",387,"جَبَّارًۭا","a tyrant","إِلَّآ أَن تَكُونَ","فِى ٱلْأَرْضِ وَمَا",837],["40:35:23",471,"جَبَّارٍۢ","tyrant","كُلِّ قَلْبِ مُتَكَبِّرٍۢ","",837],["50:45:8",520,"بِجَبَّارٍۢ ۖ","the one to compel","وَمَآ أَنتَ عَلَيْهِم","فَذَكِّرْ بِٱلْقُرْءَانِ مَن",837],["59:23:14",548,"ٱلْجَبَّارُ","the Irresistible","ٱلْمُؤْمِنُ ٱلْمُهَيْمِنُ ٱلْعَزِيزُ","ٱلْمُتَكَبِّرُ ۚ سُبْحَـٰنَ ٱللَّهِ",837]]