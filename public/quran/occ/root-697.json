[["6:141:25",146,"حَصَادِهِۦ ۖ","(of) its harvest","وَءَاتُوا۟ حَقَّهُۥ يَوْمَ","وَلَا تُسْرِفُوٓا۟ ۚ إِنَّهُۥ",3167],["10:24:34",211,"حَصِيدًۭا","a harvest clean-mown","أَوْ نَهَارًۭا فَجَعَلْنَـٰهَا","كَأَن لَّمْ تَغْنَ",1510],["11:100:9",233,"وَحَصِيدٌۭ","and (some) mown","عَلَيْكَ ۖ مِنْهَا قَآئِمٌۭ","",1510],["12:47:7",241,"حَصَدتُّمْ","you reap","سِنِينَ دَأَبًۭا فَمَا","فَذَرُوهُ فِى سُنۢبُلِهِۦٓ",3169],["21:15:7",323,"حَصِيدًا","reaped","دَعْوَىٰهُمْ حَتَّىٰ جَعَلْنَـٰهُمْ","خَـٰمِدِينَ",1510],["50:9:10",518,"ٱلْحَصِيدِ","(for) the harvest","بِهِۦ جَنَّـٰتٍۢ وَحَبَّ","",1510]]