[["2:42:2",7,"تَلْبِسُوا۟","mix","وَلَا","ٱلْحَقَّ بِٱلْبَـٰطِلِ وَتَكْتُمُوا۟",787],["2:187:9",29,"لِبَاسٌۭ","(are) garments","إِلَىٰ نِسَآئِكُمْ ۚ هُنَّ","لَّكُمْ وَأَنتُمْ لِبَاسٌۭ",842],["2:187:12",29,"لِبَاسٌۭ","(are) garments","لِبَاسٌۭ لَّكُمْ وَأَنتُمْ","لَّهُنَّ ۗ عَلِمَ ٱللَّهُ",842],["3:71:4",59,"تَلْبِسُونَ","do you mix","يَـٰٓأَهْلَ ٱلْكِتَـٰبِ لِمَ","ٱلْحَقَّ بِٱلْبَـٰطِلِ وَتَكْتُمُونَ",787],["6:9:6",129,"وَلَلَبَسْنَا","and certainly We (would) have obscured","مَلَكًۭا لَّجَعَلْنَـٰهُ رَجُلًۭا","عَلَيْهِم مَّا يَلْبِسُونَ",787],["6:9:9",129,"يَلْبِسُونَ","they are obscuring","وَلَلَبَسْنَا عَلَيْهِم مَّا","",787],["6:65:16",135,"يَلْبِسَكُمْ","(to) confuse you","تَحْتِ أَرْجُلِكُمْ أَوْ","شِيَعًۭا وَيُذِيقَ بَعْضَكُم",787],["6:82:4",138,"يَلْبِسُوٓا۟","mix","ٱلَّذِينَ ءَامَنُوا۟ وَلَمْ","إِيمَـٰنَهُم بِظُلْمٍ أُو۟لَـٰٓئِكَ",787],["6:137:10",145,"وَلِيَلْبِسُوا۟","and that they make confusing","أَوْلَـٰدِهِمْ شُرَكَآؤُهُمْ لِيُرْدُوهُمْ","عَلَيْهِمْ دِينَهُمْ ۖ وَلَوْ",787],["7:26:6",153,"لِبَاسًۭا","clothing","قَدْ أَنزَلْنَا عَلَيْكُمْ","يُوَٰرِى سَوْءَٰتِكُمْ وَرِيشًۭا ۖ",842],["7:26:10",153,"وَلِبَاسُ","But the clothing","يُوَٰرِى سَوْءَٰتِكُمْ وَرِيشًۭا ۖ","ٱلتَّقْوَىٰ ذَٰلِكَ خَيْرٌۭ ۚ",842],["7:27:13",153,"لِبَاسَهُمَا","their clothing","ٱلْجَنَّةِ يَنزِعُ عَنْهُمَا","لِيُرِيَهُمَا سَوْءَٰتِهِمَآ ۗ إِنَّهُۥ",842],["16:14:12",268,"تَلْبَسُونَهَا","(that) you wear them","وَتَسْتَخْرِجُوا۟ مِنْهُ حِلْيَةًۭ","وَتَرَى ٱلْفُلْكَ مَوَاخِرَ",787],["16:112:19",280,"لِبَاسَ","(the) garb","ٱللَّهِ فَأَذَٰقَهَا ٱللَّهُ","ٱلْجُوعِ وَٱلْخَوْفِ بِمَا",842],["18:31:15",297,"وَيَلْبَسُونَ","and will wear","أَسَاوِرَ مِن ذَهَبٍۢ","ثِيَابًا خُضْرًۭا مِّن",787],["21:80:3",328,"لَبُوسٍۢ","(of) coats of armor","وَعَلَّمْنَـٰهُ صَنْعَةَ","لَّكُمْ لِتُحْصِنَكُم مِّنۢ",3598],["22:23:20",334,"وَلِبَاسُهُمْ","and their garments","مِن ذَهَبٍۢ وَلُؤْلُؤًۭا ۖ","فِيهَا حَرِيرٌۭ",842],["25:47:6",364,"لِبَاسًۭا","(as) a covering","جَعَلَ لَكُمُ ٱلَّيْلَ","وَٱلنَّوْمَ سُبَاتًۭا وَجَعَلَ",842],["35:12:19",436,"تَلْبَسُونَهَا ۖ","you wear them","طَرِيًّۭا وَتَسْتَخْرِجُونَ حِلْيَةًۭ","وَتَرَى ٱلْفُلْكَ فِيهِ",787],["35:33:11",438,"وَلِبَاسُهُمْ","and their garments","مِن ذَهَبٍۢ وَلُؤْلُؤًۭا ۖ","فِيهَا حَرِيرٌۭ",842],["44:53:1",498,"يَلْبَسُونَ","Wearing garments","","مِن سُندُسٍۢ وَإِسْتَبْرَقٍۢ",787],["50:15:7",518,"لَبْسٍۢ","doubt","بَلْ هُمْ فِى","مِّنْ خَلْقٍۢ جَدِيدٍۢ",3597],["78:10:3",582,"لِبَاسًۭا","(as) covering","وَجَعَلْنَا ٱلَّيْلَ","",842]]