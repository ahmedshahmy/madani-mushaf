[["2:16:8",3,"تِّجَـٰرَتُهُمْ","their commerce","بِٱلْهُدَىٰ فَمَا رَبِحَت","وَمَا كَانُوا۟ مُهْتَدِينَ",928],["2:282:99",48,"تِجَـٰرَةً","a transaction","إِلَّآ أَن تَكُونَ","حَاضِرَةًۭ تُدِيرُونَهَا بَيْنَكُمْ",928],["4:29:12",83,"تِجَـٰرَةً","business","إِلَّآ أَن تَكُونَ","عَن تَرَاضٍۢ مِّنكُمْ ۚ",928],["9:24:11",190,"وَتِجَـٰرَةٌۭ","and the commerce","وَعَشِيرَتُكُمْ وَأَمْوَٰلٌ ٱقْتَرَفْتُمُوهَا","تَخْشَوْنَ كَسَادَهَا وَمَسَـٰكِنُ",928],["24:37:4",355,"تِجَـٰرَةٌۭ","trade","رِجَالٌۭ لَّا تُلْهِيهِمْ","وَلَا بَيْعٌ عَن",928],["35:29:14",437,"تِجَـٰرَةًۭ","(for) a commerce","سِرًّۭا وَعَلَانِيَةًۭ يَرْجُونَ","لَّن تَبُورَ",928],["61:10:7",552,"تِجَـٰرَةٍۢ","a transaction","هَلْ أَدُلُّكُمْ عَلَىٰ","تُنجِيكُم مِّنْ عَذَابٍ",928],["62:11:3",554,"تِجَـٰرَةً","a transaction","وَإِذَا رَأَوْا۟","أَوْ لَهْوًا ٱنفَضُّوٓا۟",928],["62:11:18",554,"ٱلتِّجَـٰرَةِ ۚ","(any) transaction","مِّنَ ٱللَّهْوِ وَمِنَ","وَٱللَّهُ خَيْرُ ٱلرَّٰزِقِينَ",928]]