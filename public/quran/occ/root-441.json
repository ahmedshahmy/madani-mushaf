[["2:23:10",4,"بِسُورَةٍۢ","a chapter","عَلَىٰ عَبْدِنَا فَأْتُوا۟","مِّن مِّثْلِهِۦ وَٱدْعُوا۟",860],["9:64:6",197,"سُورَةٌۭ","a Surah","أَن تُنَزَّلَ عَلَيْهِمْ","تُنَبِّئُهُم بِمَا فِى",860],["9:86:3",200,"سُورَةٌ","a Surah","وَإِذَآ أُنزِلَتْ","أَنْ ءَامِنُوا۟ بِٱللَّهِ",860],["9:124:4",207,"سُورَةٌۭ","a Surah","وَإِذَا مَآ أُنزِلَتْ","فَمِنْهُم مَّن يَقُولُ",860],["9:127:4",207,"سُورَةٌۭ","a Surah","وَإِذَا مَآ أُنزِلَتْ","نَّظَرَ بَعْضُهُمْ إِلَىٰ",860],["10:38:6",213,"بِسُورَةٍۢ","a Surah","ٱفْتَرَىٰهُ ۖ قُلْ فَأْتُوا۟","مِّثْلِهِۦ وَٱدْعُوا۟ مَنِ",860],["11:13:7",223,"سُوَرٍۢ","Surahs","قُلْ فَأْتُوا۟ بِعَشْرِ","مِّثْلِهِۦ مُفْتَرَيَـٰتٍۢ وَٱدْعُوا۟",860],["18:31:12",297,"أَسَاوِرَ","bracelets","يُحَلَّوْنَ فِيهَا مِنْ","مِن ذَهَبٍۢ وَيَلْبَسُونَ",1279],["22:23:16",334,"أَسَاوِرَ","bracelets","يُحَلَّوْنَ فِيهَا مِنْ","مِن ذَهَبٍۢ وَلُؤْلُؤًۭا ۖ",1279],["24:1:1",350,"سُورَةٌ","A Surah","","أَنزَلْنَـٰهَا وَفَرَضْنَـٰهَا وَأَنزَلْنَا",860],["35:33:7",438,"أَسَاوِرَ","bracelets","يُحَلَّوْنَ فِيهَا مِنْ","مِن ذَهَبٍۢ وَلُؤْلُؤًۭا ۖ",1279],["38:21:6",454,"تَسَوَّرُوا۟","they climbed over the wall","نَبَؤُا۟ ٱلْخَصْمِ إِذْ","ٱلْمِحْرَابَ",4414],["43:53:4",493,"أَسْوِرَةٌۭ","bracelets","فَلَوْلَآ أُلْقِىَ عَلَيْهِ","مِّن ذَهَبٍ أَوْ",1279],["47:20:6",509,"سُورَةٌۭ ۖ","a Surah","ءَامَنُوا۟ لَوْلَا نُزِّلَتْ","فَإِذَآ أُنزِلَتْ سُورَةٌۭ",860],["47:20:9",509,"سُورَةٌۭ","a Surah","سُورَةٌۭ ۖ فَإِذَآ أُنزِلَتْ","مُّحْكَمَةٌۭ وَذُكِرَ فِيهَا",860],["57:13:18",539,"بِسُورٍۢ","a wall","نُورًۭا فَضُرِبَ بَيْنَهُم","لَّهُۥ بَابٌۢ بَاطِنُهُۥ",4287],["76:21:7",579,"أَسَاوِرَ","(with) bracelets","خُضْرٌۭ وَإِسْتَبْرَقٌۭ ۖ وَحُلُّوٓا۟","مِن فِضَّةٍۢ وَسَقَىٰهُمْ",1279]]