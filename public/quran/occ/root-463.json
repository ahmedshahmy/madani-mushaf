[["7:29:15",153,"بَدَأَكُمْ","He originated you","لَهُ ٱلدِّينَ ۚ كَمَا","تَعُودُونَ",726],["9:13:10",188,"بَدَءُوكُمْ","began (to attack) you","بِإِخْرَاجِ ٱلرَّسُولِ وَهُم","أَوَّلَ مَرَّةٍ ۚ أَتَخْشَوْنَهُمْ ۚ",726],["10:4:8",208,"يَبْدَؤُا۟","originates","ٱللَّهِ حَقًّا ۚ إِنَّهُۥ","ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ",726],["10:34:6",213,"يَبْدَؤُا۟","originates","مِن شُرَكَآئِكُم مَّن","ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ ۚ",726],["10:34:12",213,"يَبْدَؤُا۟","originates","يُعِيدُهُۥ ۚ قُلِ ٱللَّهُ","ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ ۖ",726],["12:76:1",244,"فَبَدَأَ","So he began","","بِأَوْعِيَتِهِمْ قَبْلَ وِعَآءِ",726],["21:104:8",331,"بَدَأْنَآ","We began","ٱلسِّجِلِّ لِلْكُتُبِ ۚ كَمَا","أَوَّلَ خَلْقٍۢ نُّعِيدُهُۥ ۚ",726],["27:64:2",383,"يَبْدَؤُا۟","originates","أَمَّن","ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ",726],["29:19:4",398,"يُبْدِئُ","Allah originates","أَوَلَمْ يَرَوْا۟ كَيْفَ","ٱللَّهُ ٱلْخَلْقَ ثُمَّ",2078],["29:20:7",398,"بَدَأَ","He originated","ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ","ٱلْخَلْقَ ۚ ثُمَّ ٱللَّهُ",726],["30:11:2",405,"يَبْدَؤُا۟","originates","ٱللَّهُ","ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ",726],["30:27:3",407,"يَبْدَؤُا۟","originates","وَهُوَ ٱلَّذِى","ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ",726],["32:7:6",415,"وَبَدَأَ","and He began","كُلَّ شَىْءٍ خَلَقَهُۥ ۖ","خَلْقَ ٱلْإِنسَـٰنِ مِن",726],["34:49:5",434,"يُبْدِئُ","(can) originate","جَآءَ ٱلْحَقُّ وَمَا","ٱلْبَـٰطِلُ وَمَا يُعِيدُ",2078],["85:13:3",590,"يُبْدِئُ","originates","إِنَّهُۥ هُوَ","وَيُعِيدُ",2078]]