:38:10",336,"يُحِبُّ","like","إِنَّ ٱللَّهَ لَا","كُلَّ خَوَّانٍۢ كَفُورٍ",186],["24:19:3",351,"يُحِبُّونَ","like","إِنَّ ٱلَّذِينَ","أَن تَشِيعَ ٱلْفَـٰحِشَةُ",186],["24:22:19",352,"تُحِبُّونَ","you like","وَلْيَعْفُوا۟ وَلْيَصْفَحُوٓا۟ ۗ أَلَا","أَن يَغْفِرَ ٱللَّهُ",186],["28:56:5",392,"أَحْبَبْتَ","you love","لَا تَهْدِى مَنْ","وَلَـٰكِنَّ ٱللَّهَ يَهْدِى",186],["28:76:28",394,"يُحِبُّ","love","إِنَّ ٱللَّهَ لَا","ٱلْفَرِحِينَ",186],["28:77:25",394,"يُحِبُّ","love","إِنَّ ٱللَّهَ لَا","ٱلْمُفْسِدِينَ",186],["30:45:10",409,"يُحِبُّ","like","فَضْلِهِۦٓ ۚ إِنَّهُۥ لَا","ٱلْكَـٰفِرِينَ",186],["31:16:6",412,"حَبَّةٍۢ","(of) a grain","إِن تَكُ مِثْقَالَ","مِّنْ خَرْدَلٍۢ فَتَكُن",1300],["31:18:13",412,"يُحِبُّ","like","إِنَّ ٱللَّهَ لَا","كُلَّ مُخْتَالٍۢ فَخُورٍۢ",186],["36:33:8",442,"حَبًّۭا","grain","أَحْيَيْنَـٰهَا وَأَخْرَجْنَا مِنْهَا","فَمِنْهُ يَأْكُلُونَ",1054],["38:32:3",455,"أَحْبَبْتُ","[I] preferred","فَقَالَ إِنِّىٓ","حُبَّ ٱلْخَيْرِ عَن",186],["38:32:4",455,"حُبَّ","(the) love","فَقَالَ إِنِّىٓ أَحْبَبْتُ","ٱلْخَيْرِ عَن ذِكْرِ",888],["41:17:4",478,"فَٱسْتَحَبُّوا۟","but they preferred","وَأَمَّا ثَمُودُ فَهَدَيْنَـٰهُمْ","ٱلْعَمَىٰ عَلَى ٱلْهُدَىٰ",1699],["42:40:13",487,"يُحِبُّ","like","ٱللَّهِ ۚ إِنَّهُۥ لَا","ٱلظَّـٰلِمِينَ",186],["49:7:15",516,"حَبَّبَ","has endeared","لَعَنِتُّمْ وَلَـٰكِنَّ ٱللَّهَ","إِلَيْكُمُ ٱلْإِيمَـٰنَ وَزَيَّنَهُۥ",3178],["49:9:29",516,"يُحِبُّ","loves","وَأَقْسِطُوٓا۟ ۖ إِنَّ ٱللَّهَ","ٱلْمُقْسِطِينَ",186],["49:12:18",517,"أَيُحِبُّ","Would like","يَغْتَب بَّعْضُكُم بَعْضًا ۚ","أَحَدُكُمْ أَن يَأْكُلَ",186],["50:9:9",518,"وَحَبَّ","and grain","فَأَنۢبَتْنَا بِهِۦ جَنَّـٰتٍۢ","ٱلْحَصِيدِ",1054],["55:12:1",531,"وَٱلْحَبُّ","And the grain","","ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ",1054],["57:23:12",540,"يُحِبُّ","love","ءَاتَىٰكُمْ ۗ وَٱللَّهُ لَا","كُلَّ مُخْتَالٍۢ فَخُورٍ",186],["59:9:7",546,"يُحِبُّونَ","love","وَٱلْإِيمَـٰنَ مِن قَبْلِهِمْ","مَنْ هَاجَرَ إِلَيْهِمْ",186],["60:8:20",550,"يُحِبُّ","loves","إِلَيْهِمْ ۚ إِنَّ ٱللَّهَ","ٱلْمُقْسِطِينَ",186],["61:4:3",551,"يُحِبُّ","loves","إِنَّ ٱللَّهَ","ٱلَّذِينَ يُقَـٰتِلُونَ فِى",186],["61:13:2",552,"تُحِبُّونَهَا ۖ","that you love","وَأُخْرَىٰ","نَصْرٌۭ مِّنَ ٱللَّهِ",186],["75:20:3",578,"تُحِبُّونَ","you love","كَلَّا بَلْ","ٱلْعَاجِلَةَ",186],["76:8:4",579,"حُبِّهِۦ","love (for) it","وَيُطْعِمُونَ ٱلطَّعَامَ عَلَىٰ","مِسْكِينًۭا وَيَتِيمًۭا وَأَسِيرًا",888],["76:27:3",580,"يُحِبُّونَ","love","إِنَّ هَـٰٓؤُلَآءِ","ٱلْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ",186],["78:15:3",582,"حَبًّۭا","grain","لِّنُخْرِجَ بِهِۦ","وَنَبَاتًۭا",1054],["80:27:3",585,"حَبًّۭا","grain","فَأَنۢبَتْنَا فِيهَا","",1054],["89:20:1",593,"وَتُحِبُّونَ","And you love","","ٱلْمَالَ حُبًّۭا جَمًّۭا",186],["89:20:3",593,"حُبًّۭا","(with) love","وَتُحِبُّونَ ٱلْمَالَ","جَمًّۭا",888],["100:8:2",600,"لِحُبِّ","in (the) love","وَإِنَّهُۥ","ٱلْخَيْرِ لَشَدِيدٌ",888]]