[["2:165:9",25,"يُحِبُّونَهُمْ","They love them","دُونِ ٱللَّهِ أَندَادًۭا","كَحُبِّ ٱللَّهِ ۖ وَٱلَّذِينَ",186],["2:165:10",25,"كَحُبِّ","as (they should) love","ٱللَّهِ أَندَادًۭا يُحِبُّونَهُمْ","ٱللَّهِ ۖ وَٱلَّذِينَ ءَامَنُوٓا۟",888],["2:165:15",25,"حُبًّۭا","(in) love","وَٱلَّذِينَ ءَامَنُوٓا۟ أَشَدُّ","لِّلَّهِ ۗ وَلَوْ يَرَى",888],["2:177:22",27,"حُبِّهِۦ","spite of his love (for it)","وَءَاتَى ٱلْمَالَ عَلَىٰ","ذَوِى ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ",888],["2:190:12",29,"يُحِبُّ","like","إِنَّ ٱللَّهَ لَا","ٱلْمُعْتَدِينَ",186],["2:195:13",30,"يُحِبُّ","loves","وَأَحْسِنُوٓا۟ ۛ إِنَّ ٱللَّهَ","ٱلْمُحْسِنِينَ",186],["2:205:13",32,"يُحِبُّ","love","وَٱلنَّسْلَ ۗ وَٱللَّهُ لَا","ٱلْفَسَادَ",186],["2:216:16",34,"تُحِبُّوا۟","you love","لَّكُمْ ۖ وَعَسَىٰٓ أَن","شَيْـًۭٔا وَهُوَ شَرٌّۭ",186],["2:222:24",35,"يُحِبُّ","loves","ٱللَّهُ ۚ إِنَّ ٱللَّهَ","ٱلتَّوَّٰبِينَ وَيُحِبُّ ٱلْمُتَطَهِّرِينَ",186],["2:222:26",35,"وَيُحِبُّ","and loves","ٱللَّهَ يُحِبُّ ٱلتَّوَّٰبِينَ","ٱلْمُتَطَهِّرِينَ",186],["2:261:9",44,"حَبَّةٍ","a grain","سَبِيلِ ٱللَّهِ كَمَثَلِ","أَنۢبَتَتْ سَبْعَ سَنَابِلَ",1300],["2:261:17",44,"حَبَّةٍۢ ۗ","grain(s)","كُلِّ سُنۢبُلَةٍۢ مِّا۟ئَةُ","وَٱللَّهُ يُضَـٰعِفُ لِمَن",1300],["2:276:8",47,"يُحِبُّ","love","ٱلصَّدَقَـٰتِ ۗ وَٱللَّهُ لَا","كُلَّ كَفَّارٍ أَثِيمٍ",186],["3:14:3",51,"حُبُّ","(is) love","زُيِّنَ لِلنَّاسِ","ٱلشَّهَوَٰتِ مِنَ ٱلنِّسَآءِ",888],["3:31:4",54,"تُحِبُّونَ","love","قُلْ إِن كُنتُمْ","ٱللَّهَ فَٱتَّبِعُونِى يُحْبِبْكُمُ",186],["3:31:7",54,"يُحْبِبْكُمُ","will love you","تُحِبُّونَ ٱللَّهَ فَٱتَّبِعُونِى","ٱللَّهُ وَيَغْفِرْ لَكُمْ",186],["3:32:10",54,"يُحِبُّ","love","فَإِنَّ ٱللَّهَ لَا","ٱلْكَـٰفِرِينَ",186],["3:57:10",57,"يُحِبُّ","love","أُجُورَهُمْ ۗ وَٱللَّهُ لَا","ٱلظَّـٰلِمِينَ",186],["3:76:8",59,"يُحِبُّ","loves","وَٱتَّقَىٰ فَإِنَّ ٱللَّهَ","ٱلْمُتَّقِينَ",186],["3:92:7",62,"تُحِبُّونَ ۚ","you love","حَتَّىٰ تُنفِقُوا۟ مِمَّا","وَمَا تُنفِقُوا۟ مِن",186],["3:119:3",65,"تُحِبُّونَهُمْ","you love them","هَـٰٓأَنتُمْ أُو۟لَآءِ","وَلَا يُحِبُّونَكُمْ وَتُؤْمِنُونَ",186],["3:119:5",65,"يُحِبُّونَكُمْ","they love you","أُو۟لَآءِ تُحِبُّونَهُمْ وَلَا","وَتُؤْمِنُونَ بِٱلْكِتَـٰبِ كُلِّهِۦ",186],["3:134:12",67,"يُحِبُّ","loves","عَنِ ٱلنَّاسِ ۗ وَٱللَّهُ","ٱلْمُحْسِنِينَ",186],["3:140:23",67,"يُحِبُّ","love","شُهَدَآءَ ۗ وَٱللَّهُ لَا","ٱلظَّـٰلِمِينَ",186],["3:146:20",68,"يُحِبُّ","loves","وَمَا ٱسْتَكَانُوا۟ ۗ وَٱللَّهُ","ٱلصَّـٰبِرِينَ",186],["3:148:9",68,"يُحِبُّ","loves","ثَوَابِ ٱلْـَٔاخِرَةِ ۗ وَٱللَّهُ","ٱلْمُحْسِنِينَ",186],["3:152:20",69,"تُحِبُّونَ ۚ","you love","مَآ أَرَىٰكُم مَّا","مِنكُم مَّن يُرِيدُ",186],["3:159:29",71,"يُحِبُّ","loves","ٱللَّهِ ۚ إِنَّ ٱللَّهَ","ٱلْمُتَوَكِّلِينَ",186],["3:188:7",75,"وَّيُحِبُّونَ","and they love","يَفْرَحُونَ بِمَآ أَتَوا۟","أَن يُحْمَدُوا۟ بِمَا",186],["4:36:28",84,"يُحِبُّ","love","إِنَّ ٱللَّهَ لَا","مَن كَانَ مُخْتَالًۭا",186],["4:107:10",96,"يُحِبُّ","love","إِنَّ ٱللَّهَ لَا","مَن كَانَ خَوَّانًا",186],["4:148:2",102,"يُحِبُّ","love","۞ لَّا","ٱللَّهُ ٱلْجَهْرَ بِٱلسُّوٓءِ",186],["5:13:31",109,"يُحِبُّ","loves","وَٱصْفَحْ ۚ إِنَّ ٱللَّهَ","ٱلْمُحْسِنِينَ",186],["5:18:7",111,"وَأَحِبَّـٰٓؤُهُۥ ۚ","and His beloved","نَحْنُ أَبْنَـٰٓؤُا۟ ٱللَّهِ","قُلْ فَلِمَ يُعَذِّبُكُم",2956],["5:42:25",115,"يُحِبُّ","loves","بِٱلْقِسْطِ ۚ إِنَّ ٱللَّهَ","ٱلْمُقْسِطِينَ",186],["5:54:13",117,"يُحِبُّهُمْ","whom He loves","يَأْتِى ٱللَّهُ بِقَوْمٍۢ","وَيُحِبُّونَهُۥٓ أَذِلَّةٍ عَلَى",186],["5:54:14",117,"وَيُحِبُّونَهُۥٓ","and they love Him","ٱللَّهُ بِقَوْمٍۢ يُحِبُّهُمْ","أَذِلَّةٍ عَلَى ٱلْمُؤْمِنِينَ",186],["5:64:46",118,"يُحِبُّ","love","فَسَادًۭا ۚ وَٱللَّهُ لَا","ٱلْمُفْسِدِينَ",186],["5:87:16",122,"يُحِبُّ","love","إِنَّ ٱللَّهَ لَا","ٱلْمُعْتَدِينَ",186],["5:93:23",123,"يُحِبُّ","loves","ٱتَّقَوا۟ وَّأَحْسَنُوا۟ ۗ وَٱللَّهُ","ٱلْمُحْسِنِينَ",186],["6:59:20",134,"حَبَّةٍۢ","a grain","إِلَّا يَعْلَمُهَا وَلَا","فِى ظُلُمَـٰتِ ٱلْأَرْضِ",1300],["6:76:14",137,"أُحِبُّ","(do) I like","أَفَلَ قَالَ لَآ","ٱلْـَٔافِلِينَ",186],["6:95:4",140,"ٱ