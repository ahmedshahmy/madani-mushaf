[["6:25:13",130,"وَقْرًۭا ۚ","deafness","يَفْقَهُوهُ وَفِىٓ ءَاذَانِهِمْ","وَإِن يَرَوْا۟ كُلَّ",1244],["17:46:9",286,"وَقْرًۭا ۚ","deafness","يَفْقَهُوهُ وَفِىٓ ءَاذَانِهِمْ","وَإِذَا ذَكَرْتَ رَبَّكَ",1244],["18:57:22",300,"وَقْرًۭا ۖ","(is) deafness","يَفْقَهُوهُ وَفِىٓ ءَاذَانِهِمْ","وَإِن تَدْعُهُمْ إِلَى",1244],["31:7:13",411,"وَقْرًۭا ۖ","(is) deafness","كَأَنَّ فِىٓ أُذُنَيْهِ","فَبَشِّرْهُ بِعَذَابٍ أَلِيمٍ",1244],["41:5:10",477,"وَقْرٌۭ","(is) deafness","إِلَيْهِ وَفِىٓ ءَاذَانِنَا","وَمِنۢ بَيْنِنَا وَبَيْنِكَ",1244],["41:44:22",481,"وَقْرٌۭ","(is) deafness","يُؤْمِنُونَ فِىٓ ءَاذَانِهِمْ","وَهُوَ عَلَيْهِمْ عَمًى ۚ",1244],["48:9:5",511,"وَتُوَقِّرُوهُ","and respect him","بِٱللَّهِ وَرَسُولِهِۦ وَتُعَزِّرُوهُ","وَتُسَبِّحُوهُ بُكْرَةًۭ وَأَصِيلًا",4473],["51:2:2",520,"وِقْرًۭا","a load","فَٱلْحَـٰمِلَـٰتِ","",4546],["71:13:6",571,"وَقَارًۭا","grandeur","لَا تَرْجُونَ لِلَّهِ","",4530]]