[["2:99:8",15,"بِهَآ","in them","بَيِّنَـٰتٍۢ ۖ وَمَا يَكْفُرُ","إِلَّا ٱلْفَـٰسِقُونَ",94],["2:132:2",20,"بِهَآ","[it]","وَوَصَّىٰ","إِبْرَٰهِـۧمُ بَنِيهِ وَيَعْقُوبُ",94],["2:134:5",20,"لَهَا","for it","أُمَّةٌۭ قَدْ خَلَتْ ۖ","مَا كَسَبَتْ وَلَكُم",94],["2:141:5",21,"لَهَا","for it","أُمَّةٌۭ قَدْ خَلَتْ ۖ","مَا كَسَبَتْ وَلَكُم",94],["2:188:7",29,"بِهَآ","[with] it","بَيْنَكُم بِٱلْبَـٰطِلِ وَتُدْلُوا۟","إِلَى ٱلْحُكَّامِ لِتَأْكُلُوا۟",94],["2:256:21",42,"لَهَا ۗ","[for it]","ٱلْوُثْقَىٰ لَا ٱنفِصَامَ","وَٱللَّهُ سَمِيعٌ عَلِيمٌ",94],["2:258:33",43,"بِهَا","it","مِنَ ٱلْمَشْرِقِ فَأْتِ","مِنَ ٱلْمَغْرِبِ فَبُهِتَ",94],["2:286:7",49,"لَهَا","for it","نَفْسًا إِلَّا وُسْعَهَا ۚ","مَا كَسَبَتْ وَعَلَيْهَا",94],["3:120:9",65,"بِهَا ۖ","at it","تُصِبْكُمْ سَيِّئَةٌۭ يَفْرَحُوا۟","وَإِن تَصْبِرُوا۟ وَتَتَّقُوا۟",94],["4:11:21",78,"فَلَهَا","then for her","وَإِن كَانَتْ وَٰحِدَةًۭ","ٱلنِّصْفُ ۚ وَلِأَبَوَيْهِ لِكُلِّ",94],["4:11:53",78,"بِهَآ","[of which]","بَعْدِ وَصِيَّةٍۢ يُوصِى","أَوْ دَيْنٍ ۗ ءَابَآؤُكُمْ",94],["4:12:23",79,"بِهَآ","[for which]","بَعْدِ وَصِيَّةٍۢ يُوصِينَ","أَوْ دَيْنٍۢ ۚ وَلَهُنَّ",94],["4:12:47",79,"بِهَآ","[for which]","بَعْدِ وَصِيَّةٍۢ تُوصُونَ","أَوْ دَيْنٍۢ ۗ وَإِن",94],["4:12:78",79,"بِهَآ","[for which]","بَعْدِ وَصِيَّةٍۢ يُوصَىٰ","أَوْ دَيْنٍ غَيْرَ",94],["4:140:12",100,"بِهَا","[it]","ءَايَـٰتِ ٱللَّهِ يُكْفَرُ","وَيُسْتَهْزَأُ بِهَا فَلَا",94],["4:140:14",100,"بِهَا","at [it]","يُكْفَرُ بِهَا وَيُسْتَهْزَأُ","فَلَا تَقْعُدُوا۟ مَعَهُمْ",94],["4:176:15",106,"فَلَهَا","then for her","وَلَدٌۭ وَلَهُۥٓ أُخْتٌۭ","نِصْفُ مَا تَرَكَ ۚ",94],["4:176:24",106,"لَّهَا","for her","إِن لَّمْ يَكُن","وَلَدٌۭ ۚ فَإِن كَانَتَا",94],["5:44:8",115,"بِهَا","by it","هُدًۭى وَنُورٌۭ ۚ يَحْكُمُ","ٱلنَّبِيُّونَ ٱلَّذِينَ أَسْلَمُوا۟",94],["5:102:8",124,"بِهَا","thereby","قَبْلِكُمْ ثُمَّ أَصْبَحُوا۟","كَـٰفِرِينَ",94],["6:25:20",130,"بِهَا ۚ","in it","ءَايَةٍۢ لَّا يُؤْمِنُوا۟","حَتَّىٰٓ إِذَا جَآءُوكَ",94],["6:70:18",136,"لَهَا","(is) for it","بِمَا كَسَبَتْ لَيْسَ","مِن دُونِ ٱللَّهِ",94],["6:89:9",138,"بِهَا","in it","وَٱلنُّبُوَّةَ ۚ فَإِن يَكْفُرْ","هَـٰٓؤُلَآءِ فَقَدْ وَكَّلْنَا",94],["6:89:13",138,"بِهَا","it","هَـٰٓؤُلَآءِ فَقَدْ وَكَّلْنَا","قَوْمًۭا لَّيْسُوا۟ بِهَا",94],["6:89:16",138,"بِهَا","therein","بِهَا قَوْمًۭا لَّيْسُوا۟","بِكَـٰفِرِينَ",94],["6:97:7",140,"بِهَا","with them","لَكُمُ ٱلنُّجُومَ لِتَهْتَدُوا۟","فِى ظُلُمَـٰتِ ٱلْبَرِّ",94],["6:109:9",141,"بِهَا ۚ","in it","جَآءَتْهُمْ ءَايَةٌۭ لَّيُؤْمِنُنَّ","قُلْ إِنَّمَا ٱلْـَٔايَـٰتُ",94],["7:28:10",153,"بِهَا ۗ","of it","ءَابَآءَنَا وَٱللَّهُ أَمَرَنَا","قُلْ إِنَّ ٱللَّهَ",94],["7:71:18",159,"بِهَا","for it","مَّا نَزَّلَ ٱللَّهُ","مِن سُلْطَـٰنٍۢ ۚ فَٱنتَظِرُوٓا۟",94],["7:80:9",160,"بِهَا","therein","ٱلْفَـٰحِشَةَ مَا سَبَقَكُم","مِنْ أَحَدٍۢ مِّنَ",94],["7:103:11",163,"بِهَا ۖ","to them","فِرْعَوْنَ وَمَلَإِي۟هِۦ فَظَلَمُوا۟","فَٱنظُرْ كَيْفَ كَانَ",94],["7:106:7",164,"بِهَآ","it","جِئْتَ بِـَٔايَةٍۢ فَأْتِ","إِن كُنتَ مِنَ",94],["7:132:8",166,"بِهَا","with it","مِنْ ءَايَةٍۢ لِّتَسْحَرَنَا","فَمَا نَحْنُ لَكَ",94],["7:146:16",168,"بِهَا","in it","ءَايَةٍۢ لَّا يُؤْمِنُوا۟","وَإِن يَرَوْا۟ سَبِيلَ",94],["7:155:28",169,"بِهَا","by it","إِلَّا فِتْنَتُكَ تُضِلُّ","مَن تَشَآءُ وَتَهْدِى",94],["7:176:4",173,"بِهَا","with these","وَلَوْ شِئْنَا لَرَفَعْنَـٰهُ","وَلَـٰكِنَّهُۥٓ أَخْلَدَ إِلَى",94],["7:179:12",174,"بِهَا","with them","قُلُوبٌۭ لَّا يَفْقَهُونَ","وَلَهُمْ أَعْيُنٌۭ لَّا",94],["7:179:17",174,"بِهَا","with them","أَعْيُنٌۭ لَّا يُبْصِرُونَ","وَلَهُمْ ءَاذَانٌۭ لَّا",94],["7:179:22",174,"بِهَآ ۚ","with them","ءَاذَانٌۭ لَّا يَسْمَعُونَ","أُو۟لَـٰٓئِكَ كَٱلْأَنْعَـٰمِ بَلْ",94],["7:180:5",174,"بِهَا ۖ","by them","ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ فَٱدْعُوهُ","وَذَرُوا۟ ٱلَّذِينَ يُلْحِدُونَ",94],["7:195:4",175,"بِهَآ ۖ","with [it]","أَلَهُمْ أَرْجُلٌۭ يَمْشُونَ","أَمْ لَهُمْ أَيْدٍۢ",94],["7:195:9",175,"بِهَآ ۖ","with [it]","لَهُمْ أَيْدٍۢ يَبْطِشُونَ","أَمْ لَهُمْ أَعْيُنٌۭ",94],["7:195:14",175,"بِهَآ ۖ","with [it]","لَهُمْ أَعْيُنٌۭ يُبْصِرُونَ","أَمْ لَهُمْ ءَاذَانٌۭ",94],["7:195:19",175,"بِهَا ۗ","with [it]","لَهُمْ ءَاذَانٌۭ يَسْمَعُونَ","قُلِ ٱدْعُوا۟ شُرَكَآءَكُمْ",94],["8:61:5",184,"لَهَا","to it","جَنَحُوا۟ لِلسَّلْمِ فَٱجْنَحْ","وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ",94],["9:35:8",192,"بِهَا","with it","نَارِ جَهَنَّمَ فَتُكْوَىٰ","جِبَاهُهُمْ وَجُنُوبُهُمْ وَظُهُورُهُمْ ۖ",94],["9:55:10",196,"بِهَا","with it","يُرِيدُ ٱللَّهُ لِيُعَذِّبَهُم","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا",94],["9:85:10",200,"بِهَا","with it","ٱللَّهُ أَن يُعَذِّبَهُم","فِى ٱلدُّنْيَا وَتَزْهَقَ",94],["9:103:7",203,"بِهَا","by it","صَدَقَةًۭ تُطَهِّرُهُمْ وَتُزَكِّيهِم","وَصَلِّ عَلَيْهِمْ ۖ إِنَّ",94],["10:7:10",209,"بِهَا","with it","بِٱلْحَيَوٰةِ ٱلدُّنْيَا وَٱطْمَأَنُّوا۟","وَٱلَّذِينَ هُمْ عَنْ",94],["10:22:17",211,"بِهَا","therein","بِرِيحٍۢ طَيِّبَةٍۢ وَفَرِحُوا۟","جَآءَتْهَا رِيحٌ عَاصِفٌۭ",94],["11:28:18",224,"لَهَا","averse to it","عَلَيْكُمْ أَنُلْزِمُكُمُوهَا وَأَنتُمْ","كَـٰرِهُونَ",94],["12:24:5",238,"بِهَا","her","هَمَّتْ بِهِۦ ۖ وَهَمَّ","لَوْلَآ أَن رَّءَا",94],["12:40:13",240,"بِهَا","for it","مَّآ أَنزَلَ ٱللَّهُ","مِن سُلْطَـٰنٍ ۚ إِنِ",94],["13:13:10",250,"بِهَا","with it","وَيُرْسِلُ ٱلصَّوَٰعِقَ فَيُصِيبُ","مَن يَشَآءُ وَهُمْ",94],["14:26:11",259,"لَهَا","for it","فَوْقِ ٱلْأَرْضِ مَا","مِن قَرَارٍۢ",94],["15:4:6",262,"وَلَهَا","(there was) for it","مِن قَرْيَةٍ إِلَّا","كِتَابٌۭ مَّعْلُومٌۭ",94],["15:44:1",264,"لَهَا","For it","","سَبْعَةُ أَبْوَٰبٍۢ لِّكُلِّ",94],["17:7:7",282,"فَلَهَا ۚ","then it is for it","لِأَنفُسِكُمْ ۖ وَإِنْ أَسَأْتُمْ","فَإِذَا جَآءَ وَعْدُ",94],["17:19:5",284,"لَهَا","for it","أَرَادَ ٱلْـَٔاخِرَةَ وَسَعَىٰ","سَعْيَهَا وَهُوَ مُؤْمِنٌۭ",94],["17:59:9",288,"بِهَا","them","إِلَّآ أَن كَذَّبَ","ٱلْأَوَّلُونَ ۚ وَءَاتَيْنَا ثَمُودَ",94],["17:59:16",288,"بِهَا ۚ","her","ٱلنَّاقَةَ مُبْصِرَةًۭ فَظَلَمُوا۟","وَمَا نُرْسِلُ بِٱلْـَٔايَـٰتِ",94],["17:110:18",293,"بِهَا","therein","بِصَلَاتِكَ وَلَا تُخَافِتْ","وَٱبْتَغِ بَيْنَ ذَٰلِكَ",94],["18:7:7",294,"لَّهَا","for it","عَلَى ٱلْأَرْضِ زِينَةًۭ","لِنَبْلُوَهُمْ أَيُّهُمْ أَحْسَنُ",94],["19:17:9",306,"لَهَا","then he assumed for her the likeness","إِلَيْهَا رُوحَنَا فَتَمَثَّلَ","بَشَرًۭا سَوِيًّۭا",94],["19:70:7",310,"بِهَا","therein","بِٱلَّذِينَ هُمْ أَوْلَىٰ","صِلِيًّۭا",94],["20:16:7",313,"بِهَا","in it","مَن لَّا يُؤْمِنُ","وَٱتَّبَعَ هَوَىٰهُ فَتَرْدَىٰ",94],["20:18:7",313,"بِهَا","with it","أَتَوَكَّؤُا۟ عَلَيْهَا وَأَهُشُّ","عَلَىٰ غَنَمِى وَلِىَ",94],["21:47:17",326,"بِهَا ۗ","[with] it","مِّنْ خَرْدَلٍ أَتَيْنَا","وَكَفَىٰ بِنَا حَـٰسِبِينَ",94],["21:52:10",326,"لَهَا","to it","ٱلتَّمَاثِيلُ ٱلَّتِىٓ أَنتُمْ","عَـٰكِفُونَ",94],["21:53:4",326,"لَهَا","of them","قَالُوا۟ وَجَدْنَآ ءَابَآءَنَا","عَـٰبِدِينَ",94],["21:98:10",330,"لَهَا","to it","حَصَبُ جَهَنَّمَ أَنتُمْ","وَٰرِدُونَ",94],["22:46:9",337,"بِهَآ","with it","لَهُمْ قُلُوبٌۭ يَعْقِلُونَ","أَوْ ءَاذَانٌۭ يَسْمَعُونَ",94],["22:46:13",337,"بِهَا ۖ","with it","أَوْ ءَاذَانٌۭ يَسْمَعُونَ","فَإِنَّهَا لَا تَعْمَى",94],["22:48:5",338,"لَهَا","to it","مِّن قَرْيَةٍ أَمْلَيْتُ","وَهِىَ ظَالِمَةٌۭ ثُمَّ",94],["23:61:6",346,"لَهَا","in them","فِى ٱلْخَيْرَٰتِ وَهُمْ","سَـٰبِقُونَ",94],["23:63:13",346,"لَهَا","for it","دُونِ ذَٰلِكَ هُمْ","عَـٰمِلُونَ",94],["23:105:7",349,"بِهَا","deny them","تُتْلَىٰ عَلَيْكُمْ فَكُنتُم","تُكَذِّبُونَ",94],["25:12:7",361,"لَهَا","its","مَّكَانٍۭ بَعِيدٍۢ سَمِعُوا۟","تَغَيُّظًۭا وَزَفِيرًۭا",94],["26:4:10",367,"لَهَا","to it","ءَايَةًۭ فَظَلَّتْ أَعْنَـٰقُهُمْ","خَـٰضِعِينَ",94],["26:71:5",370,"لَهَا","to them","نَعْبُدُ أَصْنَامًۭا فَنَظَلُّ","عَـٰكِفِينَ",94],["26:155:4",373,"لَّهَا","For her","قَالَ هَـٰذِهِۦ نَاقَةٌۭ","شِرْبٌۭ وَلَكُمْ شِرْبُ",94],["26:208:6",376,"لَهَا","it had","مِن قَرْيَةٍ إِلَّا","مُنذِرُونَ",94],["27:14:2",378,"بِهَا","them","وَجَحَدُوا۟","وَٱسْتَيْقَنَتْهَآ أَنفُسُهُمْ ظُلْمًۭا",94],["27:23:9",379,"وَلَهَا","and for her","مِن كُلِّ شَىْءٍۢ","عَرْشٌ عَظِيمٌۭ",94],["27:37:8",380,"بِهَا","of it","لَّا قِبَلَ لَهُم","وَلَنُخْرِجَنَّهُم مِّنْهَآ أَذِلَّةًۭ",94],["27:41:3",380,"لَهَا","for her","قَالَ نَكِّرُوا۟","عَرْشَهَا نَنظُرْ أَتَهْتَدِىٓ",94],["27:44:2",380,"لَهَا","to her","قِيلَ","ٱدْخُلِى ٱلصَّرْحَ ۖ فَلَمَّا",94],["27:61:9",382,"لَهَا","for it","خِلَـٰلَهَآ أَنْهَـٰرًۭا وَجَعَلَ","رَوَٰسِىَ وَجَعَلَ بَيْنَ",94],["27:84:9",384,"بِهَا","them","بِـَٔايَـٰتِى وَلَمْ تُحِيطُوا۟","عِلْمًا أَمَّاذَا كُنتُمْ",94],["29:28:10",399,"بِهَا","with it","ٱلْفَـٰحِشَةَ مَا سَبَقَكُم","مِنْ أَحَدٍۢ مِّنَ",94],["30:10:12",405,"بِهَا","of them","بِـَٔايَـٰتِ ٱللَّهِ وَكَانُوا۟","يَسْتَهْزِءُونَ",94],["30:36:6",408,"بِهَا ۖ","therein","ٱلنَّاسَ رَحْمَةًۭ فَرِحُوا۟","وَإِن تُصِبْهُمْ سَيِّئَةٌۢ",94],["31:16:19",412,"بِهَا","Allah will bring it forth","فِى ٱلْأَرْضِ يَأْتِ","ٱللَّهُ ۚ إِنَّ ٱللَّهَ",94],["32:15:7",416,"بِهَا","of them","ٱلَّذِينَ إِذَا ذُكِّرُوا۟","خَرُّوا۟ سُجَّدًۭا وَسَبَّحُوا۟",94],["33:14:12",419,"بِهَآ","over it","لَـَٔاتَوْهَا وَمَا تَلَبَّثُوا۟","إِلَّا يَسِيرًۭا",94],["33:30:9",421,"لَهَا","for her","بِفَـٰحِشَةٍۢ مُّبَيِّنَةٍۢ يُضَـٰعَفْ","ٱلْعَذَابُ ضِعْفَيْنِ ۚ وَكَانَ",94],["33:31:12",422,"لَهَا","for her","أَجْرَهَا مَرَّتَيْنِ وَأَعْتَدْنَا","رِزْقًۭا كَرِيمًۭا",94],["34:42:17",433,"بِهَا","to [it]","ٱلنَّارِ ٱلَّتِى كُنتُم","تُكَذِّبُونَ",94],["35:2:9",434,"لَهَا ۖ","it","رَّحْمَةٍۢ فَلَا مُمْسِكَ","وَمَا يُمْسِكْ فَلَا",94],["36:38:4",442,"لَّهَا ۚ","for it","وَٱلشَّمْسُ تَجْرِى لِمُسْتَقَرٍّۢ","ذَٰلِكَ تَقْدِيرُ ٱلْعَزِيزِ",94],["36:40:4",442,"لَهَآ","for it","لَا ٱلشَّمْسُ يَنۢبَغِى","أَن تُدْرِكَ ٱلْقَمَرَ",94],["36:71:11",445,"لَهَا","[for them]","أَيْدِينَآ أَنْعَـٰمًۭا فَهُمْ","مَـٰلِكُونَ",94],["38:15:8",453,"لَهَا","for it","صَيْحَةًۭ وَٰحِدَةًۭ مَّا","مِن فَوَاقٍۢ",94],["39:59:6",465,"بِهَا","them","جَآءَتْكَ ءَايَـٰتِى فَكَذَّبْتَ","وَٱسْتَكْبَرْتَ وَكُنتَ مِنَ",94],["41:11:8",477,"لَهَا","to it","وَهِىَ دُخَانٌۭ فَقَالَ","وَلِلْأَرْضِ ٱئْتِيَا طَوْعًا",94],["42:18:2",485,"بِهَا","[of] it","يَسْتَعْجِلُ","ٱلَّذِينَ لَا يُؤْمِنُونَ",94],["42:18:6",485,"بِهَا ۖ","in it","ٱلَّذِينَ لَا يُؤْمِنُونَ","وَٱلَّذِينَ ءَامَنُوا۟ مُشْفِقُونَ",94],["42:48:18",488,"بِهَا ۖ","in it","مِنَّا رَحْمَةًۭ فَرِحَ","وَإِن تُصِبْهُمْ سَيِّئَةٌۢ",94],["43:61:6",494,"بِهَا","about it","لِّلسَّاعَةِ فَلَا تَمْتَرُنَّ","وَٱتَّبِعُونِ ۚ هَـٰذَا صِرَٰطٌۭ",94],["46:20:13",504,"بِهَا","therein","حَيَاتِكُمُ ٱلدُّنْيَا وَٱسْتَمْتَعْتُم","فَٱلْيَوْمَ تُجْزَوْنَ عَذَابَ",94],["48:21:8",513,"بِهَا ۚ","them","قَدْ أَحَاطَ ٱللَّهُ","وَكَانَ ٱللَّهُ عَلَىٰ",94],["48:26:22",514,"بِهَا","of it","ٱلتَّقْوَىٰ وَكَانُوٓا۟ أَحَقَّ","وَأَهْلَهَا ۚ وَكَانَ ٱللَّهُ",94],["50:6:10",518,"لَهَا","for it","بَنَيْنَـٰهَا وَزَيَّنَّـٰهَا وَمَا","مِن فُرُوجٍۢ",94],["50:10:3",518,"لَّهَا","for it","وَٱلنَّخْلَ بَاسِقَـٰتٍۢ","طَلْعٌۭ نَّضِيدٌۭ",94],["52:14:5",523,"بِهَا","[of it]","ٱلنَّارُ ٱلَّتِى كُنتُم","تُكَذِّبُونَ",94],["53:23:11",526,"بِهَا","for it","مَّآ أَنزَلَ ٱللَّهُ","مِن سُلْطَـٰنٍ ۚ إِن",94],["53:58:2",528,"لَهَا","for it","لَيْسَ","مِن دُونِ ٱللَّهِ",94],["55:43:5",533,"بِهَا","[of it]","جَهَنَّمُ ٱلَّتِى يُكَذِّبُ","ٱلْمُجْرِمُونَ",94],["67:7:5",562,"لَهَا","from it","أُلْقُوا۟ فِيهَا سَمِعُوا۟","شَهِيقًۭا وَهِىَ تَفُورُ",94],["75:25:4",578,"بِهَا","to them","تَظُنُّ أَن يُفْعَلَ","فَاقِرَةٌۭ",94],["76:6:3",579,"بِهَا","from it","عَيْنًۭا يَشْرَبُ","عِبَادُ ٱللَّهِ يُفَجِّرُونَهَا",94],["83:28:3",588,"بِهَا","from it","عَيْنًۭا يَشْرَبُ","ٱلْمُقَرَّبُونَ",94],["99:3:4",599,"لَهَا","(is) with it","وَقَالَ ٱلْإِنسَـٰنُ مَا","",94],["99:5:4",599,"لَهَا","[to] it","بِأَنَّ رَبَّكَ أَوْحَىٰ","",94]]