[["2:225:14",36,"حَلِيمٌۭ","Most Forbearing","قُلُوبُكُمْ ۗ وَٱللَّهُ غَفُورٌ","",620],["2:235:47",38,"حَلِيمٌۭ","Most Forbearing","أَنَّ ٱللَّهَ غَفُورٌ","",620],["2:263:11",44,"حَلِيمٌۭ","All-Forbearing","أَذًۭى ۗ وَٱللَّهُ غَنِىٌّ","",620],["3:155:21",70,"حَلِيمٌۭ","All-Forbearing","إِنَّ ٱللَّهَ غَفُورٌ","",620],["4:12:88",79,"حَلِيمٌۭ","All-Forbearing","ٱللَّهِ ۗ وَٱللَّهُ عَلِيمٌ","",620],["5:101:25",124,"حَلِيمٌۭ","All-Forbearing","عَنْهَا ۗ وَٱللَّهُ غَفُورٌ","",620],["9:114:22",205,"حَلِيمٌۭ","forbearing","إِنَّ إِبْرَٰهِيمَ لَأَوَّٰهٌ","",620],["11:75:3",230,"لَحَلِيمٌ","(was) certainly forbearing","إِنَّ إِبْرَٰهِيمَ","أَوَّٰهٌۭ مُّنِيبٌۭ",620],["11:87:19",231,"ٱلْحَلِيمُ","(are) the forbearing","نَشَـٰٓؤُا۟ ۖ إِنَّكَ لَأَنتَ","ٱلرَّشِيدُ",620],["12:44:3",241,"أَحْلَـٰمٍۢ ۖ","dreams","قَالُوٓا۟ أَضْغَـٰثُ","وَمَا نَحْنُ بِتَأْوِيلِ",1159],["12:44:7",241,"ٱلْأَحْلَـٰمِ","(of) the dreams","وَمَا نَحْنُ بِتَأْوِيلِ","بِعَـٰلِمِينَ",1159],["17:44:20",286,"حَلِيمًا","Ever-Forbearing","تَسْبِيحَهُمْ ۗ إِنَّهُۥ كَانَ","غَفُورًۭا",620],["21:5:4",322,"أَحْلَـٰمٍۭ","dreams","بَلْ قَالُوٓا۟ أَضْغَـٰثُ","بَلِ ٱفْتَرَىٰهُ بَلْ",1159],["22:59:7",339,"حَلِيمٌۭ","Most Forbearing","وَإِنَّ ٱللَّهَ لَعَلِيمٌ","",620],["24:58:11",357,"ٱلْحُلُمَ","puberty","وَٱلَّذِينَ لَمْ يَبْلُغُوا۟","مِنكُمْ ثَلَـٰثَ مَرَّٰتٍۢ ۚ",1159],["24:59:5",358,"ٱلْحُلُمَ","the puberty","بَلَغَ ٱلْأَطْفَـٰلُ مِنكُمُ","فَلْيَسْتَـْٔذِنُوا۟ كَمَا ٱسْتَـْٔذَنَ",1159],["33:51:35",425,"حَلِيمًۭا","Most Forbearing","وَكَانَ ٱللَّهُ عَلِيمًا","",620],["35:41:18",439,"حَلِيمًا","Most Forbearing","بَعْدِهِۦٓ ۚ إِنَّهُۥ كَانَ","غَفُورًۭا",620],["37:101:3",449,"حَلِيمٍۢ","forbearing","فَبَشَّرْنَـٰهُ بِغُلَـٰمٍ","",620],["52:32:3",525,"أَحْلَـٰمُهُم","their minds","أَمْ تَأْمُرُهُمْ","بِهَـٰذَآ ۚ أَمْ هُمْ",1159],["64:17:12",557,"حَلِيمٌ","Most Forbearing","لَكُمْ ۚ وَٱللَّهُ شَكُورٌ","",620]]