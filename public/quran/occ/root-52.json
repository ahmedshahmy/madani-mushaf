[["2:26:4",5,"يَسْتَحْىِۦٓ","ashamed","۞ إِنَّ ٱللَّهَ لَا","أَن يَضْرِبَ مَثَلًۭا",938],["2:28:6",5,"فَأَحْيَـٰكُمْ ۖ","then He gave you life","بِٱللَّهِ وَكُنتُمْ أَمْوَٰتًۭا","ثُمَّ يُمِيتُكُمْ ثُمَّ",230],["2:28:10",5,"يُحْيِيكُمْ","He will give you life","ثُمَّ يُمِيتُكُمْ ثُمَّ","ثُمَّ إِلَيْهِ تُرْجَعُونَ",230],["2:49:11",8,"وَيَسْتَحْيُونَ","and letting live","ٱلْعَذَابِ يُذَبِّحُونَ أَبْنَآءَكُمْ","نِسَآءَكُمْ ۚ وَفِى ذَٰلِكُم",938],["2:73:5",11,"يُحْىِ","revives","ٱضْرِبُوهُ بِبَعْضِهَا ۚ كَذَٰلِكَ","ٱللَّهُ ٱلْمَوْتَىٰ وَيُرِيكُمْ",230],["2:85:37",13,"ٱلْحَيَوٰةِ","the life","إِلَّا خِزْىٌۭ فِى","ٱلدُّنْيَا ۖ وَيَوْمَ ٱلْقِيَـٰمَةِ",150],["2:86:4",13,"ٱلْحَيَوٰةَ","the life","أُو۟لَـٰٓئِكَ ٱلَّذِينَ ٱشْتَرَوُا۟","ٱلدُّنْيَا بِٱلْـَٔاخِرَةِ ۖ فَلَا",150],["2:96:5",15,"حَيَوٰةٍۢ","life","أَحْرَصَ ٱلنَّاسِ عَلَىٰ","وَمِنَ ٱلَّذِينَ أَشْرَكُوا۟ ۚ",150],["2:154:10",24,"أَحْيَآءٌۭ","(they are) alive","ٱللَّهِ أَمْوَٰتٌۢ ۚ بَلْ","وَلَـٰكِن لَّا تَشْعُرُونَ",437],["2:164:24",25,"فَأَحْيَا","giving life","ٱلسَّمَآءِ مِن مَّآءٍۢ","بِهِ ٱلْأَرْضَ بَعْدَ",230],["2:179:4",27,"حَيَوٰةٌۭ","(is) life","وَلَكُمْ فِى ٱلْقِصَاصِ","يَـٰٓأُو۟لِى ٱلْأَلْبَـٰبِ لَعَلَّكُمْ",150],["2:204:7",32,"ٱلْحَيَوٰةِ","the life","يُعْجِبُكَ قَوْلُهُۥ فِى","ٱلدُّنْيَا وَيُشْهِدُ ٱللَّهَ",150],["2:212:4",33,"ٱلْحَيَوٰةُ","(is) the life","زُيِّنَ لِلَّذِينَ كَفَرُوا۟","ٱلدُّنْيَا وَيَسْخَرُونَ مِنَ",150],["2:243:17",39,"أَحْيَـٰهُمْ ۚ","He restored them to life","ٱللَّهُ مُوتُوا۟ ثُمَّ","إِنَّ ٱللَّهَ لَذُو",230],["2:255:6",42,"ٱلْحَىُّ","the Ever-Living","إِلَـٰهَ إِلَّا هُوَ","ٱلْقَيُّومُ ۚ لَا تَأْخُذُهُۥ",437],["2:258:18",43,"يُحْىِۦ","grants life","إِبْرَٰهِـۧمُ رَبِّىَ ٱلَّذِى","وَيُمِيتُ قَالَ أَنَا۠",230],["2:258:22",43,"أُحْىِۦ","give life","وَيُمِيتُ قَالَ أَنَا۠","وَأُمِيتُ ۖ قَالَ إِبْرَٰهِـۧمُ",230],["2:259:12",43,"يُحْىِۦ","(will) bring to life","عُرُوشِهَا قَالَ أَنَّىٰ","هَـٰذِهِ ٱللَّهُ بَعْدَ",230],["2:260:7",44,"تُحْىِ","You give life","رَبِّ أَرِنِى كَيْفَ","ٱلْمَوْتَىٰ ۖ قَالَ أَوَلَمْ",230],["3:2:6",50,"ٱلْحَىُّ","the Ever-Living","إِلَـٰهَ إِلَّا هُوَ","ٱلْقَيُّومُ",437],["3:14:19",51,"ٱلْحَيَوٰةِ","(of) life","وَٱلْحَرْثِ ۗ ذَٰلِكَ مَتَـٰعُ","ٱلدُّنْيَا ۖ وَٱللَّهُ عِندَهُۥ",150],["3:27:10",53,"ٱلْحَىَّ","the living","فِى ٱلَّيْلِ ۖ وَتُخْرِجُ","مِنَ ٱلْمَيِّتِ وَتُخْرِجُ",437],["3:27:16",53,"ٱلْحَىِّ ۖ","the living","وَتُخْرِجُ ٱلْمَيِّتَ مِنَ","وَتَرْزُقُ مَن تَشَآءُ",437],["3:49:27",56,"وَأُحْىِ","and I give life","وَأُبْرِئُ ٱلْأَكْمَهَ وَٱلْأَبْرَصَ","ٱلْمَوْتَىٰ بِإِذْنِ ٱللَّهِ ۖ",230],["3:117:6",65,"ٱلْحَيَوٰةِ","[the] life","يُنفِقُونَ فِى هَـٰذِهِ","ٱلدُّنْيَا كَمَثَلِ رِيحٍۢ",150],["3:156:31",70,"يُحْىِۦ","gives life","فِى قُلُوبِهِمْ ۗ وَٱللَّهُ","وَيُمِيتُ ۗ وَٱللَّهُ بِمَا",230],["3:169:10",72,"أَحْيَآءٌ","They are alive","ٱللَّهِ أَمْوَٰتًۢا ۚ بَلْ","عِندَ رَبِّهِمْ يُرْزَقُونَ",437],["3:185:19",74,"ٱلْحَيَوٰةُ","(is) the life","فَقَدْ فَازَ ۗ وَمَا","ٱلدُّنْيَآ إِلَّا مَتَـٰعُ",150],["4:74:7",89,"ٱلْحَيَوٰةَ","the life","ٱللَّهِ ٱلَّذِينَ يَشْرُونَ","ٱلدُّنْيَا بِٱلْـَٔاخِرَةِ ۚ وَمَن",150],["4:86:2",91,"حُيِّيتُم","you are greeted","وَإِذَا","بِتَحِيَّةٍۢ فَحَيُّوا۟ بِأَحْسَنَ",1513],["4:86:3",91,"بِتَحِيَّةٍۢ","with a greeting","وَإِذَا حُيِّيتُم","فَحَيُّوا۟ بِأَحْسَنَ مِنْهَآ",1235],["4:86:4",91,"فَحَيُّوا۟","then greet","وَإِذَا حُيِّيتُم بِتَحِيَّةٍۢ","بِأَحْسَنَ مِنْهَآ أَوْ",1513],["4:94:20",93,"ٱلْحَيَوٰةِ","(of) the life","مُؤْمِنًۭا تَبْتَغُونَ عَرَضَ","ٱلدُّنْيَا فَعِندَ ٱللَّهِ",150],["4:109:6",96,"ٱلْحَيَوٰةِ","the life","جَـٰدَلْتُمْ عَنْهُمْ فِى","ٱلدُّنْيَا فَمَن يُجَـٰدِلُ",150],["5:32:23",113,"أَحْيَاهَا","saves it","ٱلنَّاسَ جَمِيعًۭا وَمَنْ","فَكَأَنَّمَآ أَحْيَا ٱلنَّاسَ",230],["5:32:25",113,"أَحْيَا","he has saved","وَمَنْ أَحْيَاهَا فَكَأَنَّمَآ","ٱلنَّاسَ جَمِيعًۭا ۚ وَلَقَدْ",230],["6:29:5",131,"حَيَاتُنَا","our life","إِنْ هِىَ إِلَّا","ٱلدُّنْيَا وَمَا نَحْنُ",150],["6:32:2",131,"ٱلْحَيَوٰةُ","(is) the life","وَمَا","ٱلدُّنْيَآ إِلَّا لَعِبٌۭ",150],["6:70:8",136,"ٱلْحَيَوٰةُ","the life","لَعِبًۭا وَلَهْوًۭا وَغَرَّتْهُمُ","ٱلدُّنْيَا ۚ وَذَكِّرْ بِهِۦٓ",150],["6:95:7",140,"ٱلْحَىَّ","the living","ٱلْحَبِّ وَٱلنَّوَىٰ ۖ يُخْرِجُ","مِنَ ٱلْمَيِّتِ وَمُخْرِجُ",437],["6:95:13",140,"ٱلْحَىِّ ۚ","the living","وَمُخْرِجُ ٱلْمَيِّتِ مِنَ","ذَٰلِكُمُ ٱللَّهُ ۖ فَأَنَّىٰ",437],["6:122:4",143,"فَأَحْيَيْنَـٰهُ","and We gave him life","أَوَمَن كَانَ مَيْتًۭا","وَجَعَلْنَا لَهُۥ نُورًۭا",230],["6:130:20",144,"ٱلْحَيَوٰةُ","the life","عَلَىٰٓ أَنفُسِنَا ۖ وَغَرَّتْهُمُ","ٱلدُّنْيَا وَشَهِدُوا۟ عَلَىٰٓ",150],["6:162:5",150,"وَمَحْيَاىَ","and my living","إِنَّ صَلَاتِى وَنُسُكِى","وَمَمَاتِى لِلَّهِ رَبِّ",2520],["7:25:3",153,"تَحْيَوْنَ","you will live","قَالَ فِيهَا","وَفِيهَا تَمُوتُونَ وَمِنْهَا",1051],["7:32:17",154,"ٱلْحَيَوٰةِ","the life","لِلَّذِينَ ءَامَنُوا۟ فِى","ٱلدُّنْيَا خَالِصَةًۭ يَوْمَ",150],["7:51:7",156,"ٱلْحَيَوٰةُ","the life","لَهْوًۭا وَلَعِبًۭا وَغَرَّتْهُمُ","ٱلدُّنْيَا ۚ فَٱلْيَوْمَ نَنسَىٰهُمْ",150],["7:127:17",165,"وَنَسْتَحْىِۦ","and we will let live","قَالَ سَنُقَتِّلُ أَبْنَآءَهُمْ","نِسَآءَهُمْ وَإِنَّا فَوْقَهُمْ",938],["7:141:11",167,"وَيَسْتَحْيُونَ","and letting live","ٱلْعَذَابِ ۖ يُقَتِّلُونَ أَبْنَآءَكُمْ","نِسَآءَكُمْ ۚ وَفِى ذَٰلِكُم",938],["7:152:11",169,"ٱلْحَيَوٰةِ","the life","رَّبِّهِمْ وَذِلَّةٌۭ فِى","ٱلدُّنْيَا ۚ وَكَذَٰلِكَ نَجْزِى",150],["7:158:18",170,"يُحْىِۦ","He gives life","إِلَـٰهَ إِلَّا هُوَ","وَيُمِيتُ ۖ فَـَٔامِنُوا۟ بِٱللَّهِ",230],["8:24:10",179,"يُحْيِيكُمْ ۖ","gives you life","إِذَا دَعَاكُمْ لِمَا","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ",230],["8:42:27",182,"وَيَحْيَىٰ","and (might) live","هَلَكَ عَنۢ بَيِّنَةٍۢ","مَنْ حَىَّ عَنۢ",1051],["8:42:29",182,"حَىَّ","(were to) live","بَيِّنَةٍۢ وَيَحْيَىٰ مَنْ","عَنۢ بَيِّنَةٍۢ ۗ وَإِنَّ",1051],["9:38:17",193,"بِٱلْحَيَوٰةِ","with the life","إِلَى ٱلْأَرْضِ ۚ أَرَضِيتُم","ٱلدُّنْيَا مِنَ ٱلْـَٔاخِرَةِ ۚ",150],["9:38:23",193,"ٱلْحَيَوٰةِ","(of) the life","ٱلْـَٔاخِرَةِ ۚ فَمَا مَتَـٰعُ","ٱلدُّنْيَا فِى ٱلْـَٔاخِرَةِ",150],["9:55:12",196,"ٱلْحَيَوٰةِ","the life","لِيُعَذِّبَهُم بِهَا فِى","ٱلدُّنْيَا وَتَزْهَقَ أَنفُسُهُمْ",150],["9:116:7",205,"يُحْىِۦ","He gives life","مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ","وَيُمِيتُ ۚ وَمَا لَكُم",230],["10:7:7",209,"بِٱلْحَيَوٰةِ","with the life","يَرْجُونَ لِقَآءَنَا وَرَضُوا۟","ٱلدُّنْيَا وَٱطْمَأَنُّوا۟ بِهَا",150],["10:10:5",209,"وَتَحِيَّتُهُمْ","And their greeting","فِيهَا سُبْحَـٰنَكَ ٱللَّهُمَّ","فِيهَا سَلَـٰمٌۭ ۚ وَءَاخِرُ",1235],["10:23:17",211,"ٱلْحَيَوٰةِ","(of) the life","عَلَىٰٓ أَنفُسِكُم ۖ مَّتَـٰعَ","ٱلدُّنْيَا ۖ ثُمَّ إِلَيْنَا",150],["10:24:3",211,"ٱلْحَيَوٰةِ","(of) the life","إِنَّمَا مَثَلُ","ٱلدُّنْيَا كَمَآءٍ أَنزَلْنَـٰهُ",150],["10:31:13",212,"ٱلْحَىَّ","the living","وَٱلْأَبْصَـٰرَ وَمَن يُخْرِجُ","مِنَ ٱلْمَيِّتِ وَيُخْرِجُ",437],["10:31:19",212,"ٱلْحَىِّ","the living","وَيُخْرِجُ ٱلْمَيِّتَ مِنَ","وَمَن يُدَبِّرُ ٱلْأَمْرَ ۚ",437],["10:56:2",215,"يُحْىِۦ","gives life","هُوَ","وَيُمِيتُ وَإِلَيْهِ تُرْجَعُونَ",230],["10:64:4",216,"ٱلْحَيَوٰةِ","the life","لَهُمُ ٱلْبُشْرَىٰ فِى","ٱلدُّنْيَا وَفِى ٱلْـَٔاخِرَةِ ۚ",150],["10:88:11",218,"ٱلْحَيَوٰةِ","the life","زِينَةًۭ وَأَمْوَٰلًۭا فِى","ٱلدُّنْيَا رَبَّنَا لِيُضِلُّوا۟",150],["10:98:17",220,"ٱلْحَيَوٰةِ","the life","عَذَابَ ٱلْخِزْىِ فِى","ٱلدُّنْيَا وَمَتَّعْنَـٰهُمْ إِلَىٰ",150],["11:15:4",223,"ٱلْحَيَوٰةَ","the life","مَن كَانَ يُرِيدُ","ٱلدُّنْيَا وَزِينَتَهَا نُوَفِّ",150],["13:26:8",252,"بِٱلْحَيَوٰةِ","in the life","يَشَآءُ وَيَقْدِرُ ۚ وَفَرِحُوا۟","ٱلدُّنْيَا وَمَا ٱلْحَيَوٰةُ",150],["13:26:11",252,"ٱلْحَيَوٰةُ","(is) the life","بِٱلْحَيَوٰةِ ٱلدُّنْيَا وَمَا","ٱلدُّنْيَا فِى ٱلْـَٔاخِرَةِ",150],["13:34:4",253,"ٱلْحَيَوٰةِ","the life","لَّهُمْ عَذَابٌۭ فِى","ٱلدُّنْيَا ۖ وَلَعَذَابُ ٱلْـَٔاخِرَةِ",150],["14:3:3",255,"ٱلْحَيَوٰةَ","the life","ٱلَّذِينَ يَسْتَحِبُّونَ","ٱلدُّنْيَا عَلَى ٱلْـَٔاخِرَةِ",150],["14:6:19",256,"وَيَسْتَحْيُونَ","and letting live","ٱلْعَذَابِ وَيُذَبِّحُونَ أَبْنَآءَكُمْ","نِسَآءَكُمْ ۚ وَفِى ذَٰلِكُم",938],["14:23:15",258,"تَحِيَّتُهُمْ","their greetings","فِيهَا بِإِذْنِ رَبِّهِمْ ۖ","فِيهَا سَلَـٰمٌ",1235],["14:27:8",259,"ٱلْحَيَوٰةِ","the life","بِٱلْقَوْلِ ٱلثَّابِتِ فِى","ٱلدُّنْيَا وَفِى ٱلْـَٔاخِرَةِ ۖ",150],["15:23:3",263,"نُحْىِۦ","We give life","وَإِنَّا لَنَحْنُ","وَنُمِيتُ وَنَحْنُ ٱلْوَٰرِثُونَ",230],["16:21:3",269,"أَحْيَآءٍۢ ۖ","not alive","أَمْوَٰتٌ غَيْرُ","وَمَا يَشْعُرُونَ أَيَّانَ",437],["16:65:6",274,"فَأَحْيَا","then gives life","مِنَ ٱلسَّمَآءِ مَآءًۭ","بِهِ ٱلْأَرْضَ بَعْدَ",230],["16:97:10",278,"فَلَنُحْيِيَنَّهُۥ","then surely We will give him life","أُنثَىٰ وَهُوَ مُؤْمِنٌۭ","حَيَوٰةًۭ طَيِّبَةًۭ ۖ وَلَنَجْزِيَنَّهُمْ",230],["16:97:11",278,"حَيَوٰةًۭ","a life","وَهُوَ مُؤْمِنٌۭ فَلَنُحْيِيَنَّهُۥ","طَيِّبَةًۭ ۖ وَلَنَجْزِيَنَّهُمْ أَجْرَهُم",150],["16:107:4",279,"ٱلْحَيَوٰةَ","the life","ذَٰلِكَ بِأَنَّهُمُ ٱسْتَحَبُّوا۟","ٱلدُّنْيَا عَلَى ٱلْـَٔاخِرَةِ",150],["17:75:4",289,"ٱلْحَيَوٰةِ","(in) the life","إِذًۭا لَّأَذَقْنَـٰكَ ضِعْفَ","وَضِعْفَ ٱلْمَمَاتِ ثُمَّ",150],["18:28:17",297,"ٱلْحَيَوٰةِ","(of) the life","عَنْهُمْ تُرِيدُ زِينَةَ","ٱلدُّنْيَا ۖ وَلَا تُطِعْ",150],["18:45:4",298,"ٱلْحَيَوٰةِ","(of) the life","وَٱضْرِبْ لَهُم مَّثَلَ","ٱلدُّنْيَا كَمَآءٍ أَنزَلْنَـٰهُ",150],["18:46:4",299,"ٱلْحَيَوٰةِ","(of) the life","ٱلْمَالُ وَٱلْبَنُونَ زِينَةُ","ٱلدُّنْيَا ۖ وَٱلْبَـٰقِيَـٰتُ ٱلصَّـٰلِحَـٰتُ",150],["18:104:5",304,"ٱلْحَيَوٰةِ","the life","ضَلَّ سَعْيُهُمْ فِى","ٱلدُّنْيَا وَهُمْ يَحْسَبُونَ",150],["19:15:9",306,"حَيًّۭا","alive","يَمُوتُ وَيَوْمَ يُبْعَثُ","",437],["19:31:11",307,"حَيًّۭا","alive","وَٱلزَّكَوٰةِ مَا دُمْتُ","",437],["19:33:9",307,"حَيًّۭا","alive","أَمُوتُ وَيَوْمَ أُبْعَثُ","",437],["19:66:8",310,"حَيًّا","alive","مِتُّ لَسَوْفَ أُخْرَجُ","",437],["20:20:4",313,"حَيَّةٌۭ","(was) a snake","فَأَلْقَىٰهَا فَإِذَا هِىَ","تَسْعَىٰ",3207],["20:72:18",316,"ٱلْحَيَوٰةَ","life","إِنَّمَا تَقْضِى هَـٰذِهِ","ٱلدُّنْيَآ",150],["20:74:13",316,"يَحْيَىٰ","live","يَمُوتُ فِيهَا وَلَا","",1051],["20:97:6",318,"ٱلْحَيَوٰةِ","the life","فَإِنَّ لَكَ فِى","أَن تَقُولَ لَا",150],["20:111:3",319,"لِلْحَىِّ","before the Ever-Living","۞ وَعَنَتِ ٱلْوُجُوهُ","ٱلْقَيُّومِ ۖ وَقَدْ خَابَ",437],["20:131:11",321,"ٱلْحَيَوٰةِ","(of) the life","أَزْوَٰجًۭا مِّنْهُمْ زَهْرَةَ","ٱلدُّنْيَا لِنَفْتِنَهُمْ فِيهِ ۚ",150],["21:30:16",324,"حَىٍّ ۖ","living thing","ٱلْمَآءِ كُلَّ شَىْءٍ","أَفَلَا يُؤْمِنُونَ",437],["22:6:7",333,"يُحْىِ","[He] gives life","هُوَ ٱلْحَقُّ وَأَنَّهُۥ","ٱلْمَوْتَىٰ وَأَنَّهُۥ عَلَىٰ",230],["22:66:3",340,"أَحْيَاكُمْ","gave you life","وَهُوَ ٱلَّذِىٓ","ثُمَّ يُمِيتُكُمْ ثُمَّ",230],["22:66:7",340,"يُحْيِيكُمْ ۗ","He will give you life (again)","ثُمَّ يُمِيتُكُمْ ثُمَّ","إِنَّ ٱلْإِنسَـٰنَ لَكَفُورٌۭ",230],["23:33:12",344,"ٱلْحَيَوٰةِ","the life","ٱلْـَٔاخِرَةِ وَأَتْرَفْنَـٰهُمْ فِى","ٱلدُّنْيَا مَا هَـٰذَآ",150],["23:37:4",344,"حَيَاتُنَا","our life","إِنْ هِىَ إِلَّا","ٱلدُّنْيَا نَمُوتُ وَنَحْيَا",150],["23:37:7",344,"وَنَحْيَا","and we live","حَيَاتُنَا ٱلدُّنْيَا نَمُوتُ","وَمَا نَحْنُ بِمَبْعُوثِينَ",1051],["23:80:3",347,"يُحْىِۦ","gives life","وَهُوَ ٱلَّذِى","وَيُمِيتُ وَلَهُ ٱخْتِلَـٰفُ",230],["24:33:38",354,"ٱلْحَيَوٰةِ","(of) the life","تَحَصُّنًۭا لِّتَبْتَغُوا۟ عَرَضَ","ٱلدُّنْيَا ۚ وَمَن يُكْرِههُّنَّ",150],["24:61:64",358,"تَحِيَّةًۭ","a greeting","فَسَلِّمُوا۟ عَلَىٰٓ أَنفُسِكُمْ","مِّنْ عِندِ ٱللَّهِ",1235],["25:3:20",360,"حَيَوٰةًۭ","life","يَمْلِكُونَ مَوْتًۭا وَلَا","وَلَا نُشُورًۭا",150],["25:49:1",364,"لِّنُحْـِۧىَ","That We may give life","","بِهِۦ بَلْدَةًۭ مَّيْتًۭا",230],["25:58:3",365,"ٱلْحَىِّ","the Ever-Living","وَتَوَكَّلْ عَلَى","ٱلَّذِى لَا يَمُوتُ",437],["25:75:8",366,"تَحِيَّةًۭ","(with) greetings","صَبَرُوا۟ وَيُلَقَّوْنَ فِيهَا","وَسَلَـٰمًا",1235],["26:81:4",370,"يُحْيِينِ","he will give me life","وَٱلَّذِى يُمِيتُنِى ثُمَّ","",230],["28:4:14",385,"وَيَسْتَحْىِۦ","and letting live","مِّنْهُمْ يُذَبِّحُ أَبْنَآءَهُمْ","نِسَآءَهُمْ ۚ إِنَّهُۥ كَانَ",938],["28:25:5",388,"ٱسْتِحْيَآءٍۢ","shyness","إِحْدَىٰهُمَا تَمْشِى عَلَى","قَالَتْ إِنَّ أَبِى",4839],["28:60:6",393,"ٱلْحَيَوٰةِ","(of the) life","مِّن شَىْءٍۢ فَمَتَـٰعُ","ٱلدُّنْيَا وَزِينَتُهَا ۚ وَمَا",150],["28:61:10",393,"ٱلْحَيَوٰةِ","(of the) life","كَمَن مَّتَّعْنَـٰهُ مَتَـٰعَ","ٱلدُّنْيَا ثُمَّ هُوَ",150],["28:79:9",395,"ٱلْحَيَوٰةَ","the life","قَالَ ٱلَّذِينَ يُرِيدُونَ","ٱلدُّنْيَا يَـٰلَيْتَ لَنَا",150],["29:25:11",399,"ٱلْحَيَوٰةِ","the life","مَّوَدَّةَ بَيْنِكُمْ فِى","ٱلدُّنْيَا ۖ ثُمَّ يَوْمَ",150],["29:63:8",403,"فَأَحْيَا","and gives life","مِنَ ٱلسَّمَآءِ مَآءًۭ","بِهِ ٱلْأَرْضَ مِنۢ",230],["29:64:3",404,"ٱلْحَيَوٰةُ","life","وَمَا هَـٰذِهِ","ٱلدُّنْيَآ إِلَّا لَهْوٌۭ",150],["29:64:12",404,"ٱلْحَيَوَانُ ۚ","(is) the life","ٱلدَّارَ ٱلْـَٔاخِرَةَ لَهِىَ","لَوْ كَانُوا۟ يَعْلَمُونَ",3205],["30:7:4",405,"ٱلْحَيَوٰةِ","the life","يَعْلَمُونَ ظَـٰهِرًۭا مِّنَ","ٱلدُّنْيَا وَهُمْ عَنِ",150],["30:19:2",406,"ٱلْحَىَّ","the living","يُخْرِجُ","مِنَ ٱلْمَيِّتِ وَيُخْرِجُ",437],["30:19:8",406,"ٱلْحَىِّ","the living","وَيُخْرِجُ ٱلْمَيِّتَ مِنَ","وَيُحْىِ ٱلْأَرْضَ بَعْدَ",437],["30:19:9",406,"وَيُحْىِ","and He gives life","ٱلْمَيِّتَ مِنَ ٱلْحَىِّ","ٱلْأَرْضَ بَعْدَ مَوْتِهَا ۚ",230],["30:24:11",406,"فَيُحْىِۦ","and gives life","مِنَ ٱلسَّمَآءِ مَآءًۭ","بِهِ ٱلْأَرْضَ بَعْدَ",230],["30:40:9",408,"يُحْيِيكُمْ ۖ","He will give you life","ثُمَّ يُمِيتُكُمْ ثُمَّ","هَلْ مِن شُرَكَآئِكُم",230],["30:50:7",409,"يُحْىِ","He gives life","رَحْمَتِ ٱللَّهِ كَيْفَ","ٱلْأَرْضَ بَعْدَ مَوْتِهَآ ۚ",230],["30:50:13",409,"لَمُحْىِ","surely He (will) give life","مَوْتِهَآ ۚ إِنَّ ذَٰلِكَ","ٱلْمَوْتَىٰ ۖ وَهُوَ عَلَىٰ",2482],["31:33:25",414,"ٱلْحَيَوٰةُ","the life","حَقٌّۭ ۖ فَلَا تَغُرَّنَّكُمُ","ٱلدُّنْيَا وَلَا يَغُرَّنَّكُم",150],["33:28:8",421,"ٱلْحَيَوٰةَ","the life","إِن كُنتُنَّ تُرِدْنَ","ٱلدُّنْيَا وَزِينَتَهَا فَتَعَالَيْنَ",150],["33:44:1",424,"تَحِيَّتُهُمْ","Their greetings","","يَوْمَ يَلْقَوْنَهُۥ سَلَـٰمٌۭ ۚ",1235],["33:53:32",425,"فَيَسْتَحْىِۦ","and he is shy","كَانَ يُؤْذِى ٱلنَّبِىَّ","مِنكُمْ ۖ وَٱللَّهُ لَا",938],["33:53:36",425,"يَسْتَحْىِۦ","is not shy","مِنكُمْ ۖ وَٱللَّهُ لَا","مِنَ ٱلْحَقِّ ۚ وَإِذَا",938],["35:5:9",435,"ٱلْحَيَوٰةُ","the life","حَقٌّۭ ۖ فَلَا تَغُرَّنَّكُمُ","ٱلدُّنْيَا ۖ وَلَا يَغُرَّنَّكُم",150],["35:9:11",435,"فَأَحْيَيْنَا","and We revive","إِلَىٰ بَلَدٍۢ مَّيِّتٍۢ","بِهِ ٱلْأَرْضَ بَعْدَ",230],["35:22:3",437,"ٱلْأَحْيَآءُ","(are) the living","وَمَا يَسْتَوِى","وَلَا ٱلْأَمْوَٰتُ ۚ إِنَّ",437],["36:12:3",440,"نُحْىِ","[We] give life","إِنَّا نَحْنُ","ٱلْمَوْتَىٰ وَنَكْتُبُ مَا",230],["36:33:5",442,"أَحْيَيْنَـٰهَا","We give it life","لَّهُمُ ٱلْأَرْضُ ٱلْمَيْتَةُ","وَأَخْرَجْنَا مِنْهَا حَبًّۭا",230],["36:70:4",444,"حَيًّۭا","alive","لِّيُنذِرَ مَن كَانَ","وَيَحِقَّ ٱلْقَوْلُ عَلَى",437],["36:78:8",445,"يُحْىِ","will give life","خَلْقَهُۥ ۖ قَالَ مَن","ٱلْعِظَـٰمَ وَهِىَ رَمِيمٌۭ",230],["36:79:2",445,"يُحْيِيهَا","He will give them life","قُلْ","ٱلَّذِىٓ أَنشَأَهَآ أَوَّلَ",230],["39:26:5",461,"ٱلْحَيَوٰةِ","the life","ٱللَّهُ ٱلْخِزْىَ فِى","ٱلدُّنْيَا ۖ وَلَعَذَابُ ٱلْـَٔاخِرَةِ",150],["40:11:5",468,"وَأَحْيَيْتَنَا","and You gave us life","رَبَّنَآ أَمَتَّنَا ٱثْنَتَيْنِ","ٱثْنَتَيْنِ فَٱعْتَرَفْنَا بِذُنُوبِنَا",230],["40:25:12",469,"وَٱسْتَحْيُوا۟","and let live","ٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ","نِسَآءَهُمْ ۚ وَمَا كَيْدُ",938],["40:39:4",471,"ٱلْحَيَوٰةُ","the life","يَـٰقَوْمِ إِنَّمَا هَـٰذِهِ","ٱلدُّنْيَا مَتَـٰعٌۭ وَإِنَّ",150],["40:51:7",473,"ٱلْحَيَوٰةِ","the life","وَٱلَّذِينَ ءَامَنُوا۟ فِى","ٱلدُّنْيَا وَيَوْمَ يَقُومُ",150],["40:65:2",474,"ٱلْحَىُّ","(is) the Ever-Living","هُوَ","لَآ إِلَـٰهَ إِلَّا",437],["40:68:3",475,"يُحْىِۦ","gives life","هُوَ ٱلَّذِى","وَيُمِيتُ ۖ فَإِذَا قَضَىٰٓ",230],["41:16:12",478,"ٱلْحَيَوٰةِ","the life","عَذَابَ ٱلْخِزْىِ فِى","ٱلدُّنْيَا ۖ وَلَعَذَابُ ٱلْـَٔاخِرَةِ",150],["41:31:4",480,"ٱلْحَيَوٰةِ","the life","نَحْنُ أَوْلِيَآؤُكُمْ فِى","ٱلدُّنْيَا وَفِى ٱلْـَٔاخِرَةِ ۖ",150],["41:39:15",481,"أَحْيَاهَا","gives it life","وَرَبَتْ ۚ إِنَّ ٱلَّذِىٓ","لَمُحْىِ ٱلْمَوْتَىٰٓ ۚ إِنَّهُۥ",230],["41:39:16",481,"لَمُحْىِ","(is) surely the Giver of life","إِنَّ ٱلَّذِىٓ أَحْيَاهَا","ٱلْمَوْتَىٰٓ ۚ إِنَّهُۥ عَلَىٰ",2482],["42:9:10",483,"يُحْىِ","gives life","هُوَ ٱلْوَلِىُّ وَهُوَ","ٱلْمَوْتَىٰ وَهُوَ عَلَىٰ",230],["42:36:6",487,"ٱلْحَيَوٰةِ","(for) the life","مِّن شَىْءٍۢ فَمَتَـٰعُ","ٱلدُّنْيَا ۖ وَمَا عِندَ",150],["43:32:10",491,"ٱلْحَيَوٰةِ","the life","بَيْنَهُم مَّعِيشَتَهُمْ فِى","ٱلدُّنْيَا ۚ وَرَفَعْنَا بَعْضَهُمْ",150],["43:35:7",492,"ٱلْحَيَوٰةِ","(of) the life","ذَٰلِكَ لَمَّا مَتَـٰعُ","ٱلدُّنْيَا ۚ وَٱلْـَٔاخِرَةُ عِندَ",150],["44:8:5",496,"يُحْىِۦ","He gives life","إِلَـٰهَ إِلَّا هُوَ","وَيُمِيتُ ۖ رَبُّكُمْ وَرَبُّ",230],["45:5:11",499,"فَأَحْيَا","and gives life","ٱلسَّمَآءِ مِن رِّزْقٍۢ","بِهِ ٱلْأَرْضَ بَعْدَ",230],["45:21:13",500,"مَّحْيَاهُمْ","(in) their life","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ سَوَآءًۭ","وَمَمَاتُهُمْ ۚ سَآءَ مَا",2520],["45:24:5",501,"حَيَاتُنَا","our life","مَا هِىَ إِلَّا","ٱلدُّنْيَا نَمُوتُ وَنَحْيَا",150],["45:24:8",501,"وَنَحْيَا","and we live","حَيَاتُنَا ٱلدُّنْيَا نَمُوتُ","وَمَا يُهْلِكُنَآ إِلَّا",1051],["45:26:3",501,"يُحْيِيكُمْ","gives you life","قُلِ ٱللَّهُ","ثُمَّ يُمِيتُكُمْ ثُمَّ",230],["45:35:8",502,"ٱلْحَيَوٰةُ","the life","ٱللَّهِ هُزُوًۭا وَغَرَّتْكُمُ","ٱلدُّنْيَا ۚ فَٱلْيَوْمَ لَا",150],["46:20:10",504,"حَيَاتِكُمُ","your life","أَذْهَبْتُمْ طَيِّبَـٰتِكُمْ فِى","ٱلدُّنْيَا وَٱسْتَمْتَعْتُم بِهَا",150],["46:33:15",506,"يُحْـِۧىَ","to give life","بِقَـٰدِرٍ عَلَىٰٓ أَن","ٱلْمَوْتَىٰ ۚ بَلَىٰٓ إِنَّهُۥ",230],["47:36:2",510,"ٱلْحَيَوٰةُ","the life","إِنَّمَا","ٱلدُّنْيَا لَعِبٌۭ وَلَهْوٌۭ ۚ",150],["50:11:3",518,"وَأَحْيَيْنَا","and We give life","رِّزْقًۭا لِّلْعِبَادِ ۖ","بِهِۦ بَلْدَةًۭ مَّيْتًۭا ۚ",230],["50:43:3",520,"نُحْىِۦ","[We] give life","إِنَّا نَحْنُ","وَنُمِيتُ وَإِلَيْنَا ٱلْمَصِيرُ",230],["53:29:10",527,"ٱلْحَيَوٰةَ","the life","وَلَمْ يُرِدْ إِلَّا","ٱلدُّنْيَا",150],["53:44:4",527,"وَأَحْيَا","and gives life","وَأَنَّهُۥ هُوَ أَمَاتَ","",230],["57:2:5",537,"يُحْىِۦ","He gives life","مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ","وَيُمِيتُ ۖ وَهُوَ عَلَىٰ",230],["57:17:4",539,"يُحْىِ","gives life","ٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","ٱلْأَرْضَ بَعْدَ مَوْتِهَا ۚ",230],["57:20:3",540,"ٱلْحَيَوٰةُ","the life","ٱعْلَمُوٓا۟ أَنَّمَا","ٱلدُّنْيَا لَعِبٌۭ وَلَهْوٌۭ",150],["57:20:35",540,"ٱلْحَيَوٰةُ","(is) the life","ٱللَّهِ وَرِضْوَٰنٌۭ ۚ وَمَا","ٱلدُّنْيَآ إِلَّا مَتَـٰعُ",150],["58:8:20",543,"حَيَّوْكَ","they greet you","ٱلرَّسُولِ وَإِذَا جَآءُوكَ","بِمَا لَمْ يُحَيِّكَ",1513],["58:8:23",543,"يُحَيِّكَ","greets you","حَيَّوْكَ بِمَا لَمْ","بِهِ ٱللَّهُ وَيَقُولُونَ",1513],["67:2:4",562,"وَٱلْحَيَوٰةَ","and life","ٱلَّذِى خَلَقَ ٱلْمَوْتَ","لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ",150],["75:40:6",578,"يُحْـِۧىَ","give life","بِقَـٰدِرٍ عَلَىٰٓ أَن","ٱلْمَوْتَىٰ",230],["77:26:1",581,"أَحْيَآءًۭ","(For the) living","","وَأَمْوَٰتًۭا",437],["79:38:2",584,"ٱلْحَيَوٰةَ","the life","وَءَاثَرَ","ٱلدُّنْيَا",150],["87:13:6",592,"يَحْيَىٰ","will live","يَمُوتُ فِيهَا وَلَا","",1051],["87:16:3",592,"ٱلْحَيَوٰةَ","the life","بَلْ تُؤْثِرُونَ","ٱلدُّنْيَا",150],["89:24:4",594,"لِحَيَاتِى","for my life","يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ","",150]]