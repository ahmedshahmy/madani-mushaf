[["2:26:39",5,"ٱلْفَـٰسِقِينَ","the defiantly disobedient","يُضِلُّ بِهِۦٓ إِلَّا","",316],["2:59:18",9,"يَفْسُقُونَ","defiantly disobeying","ٱلسَّمَآءِ بِمَا كَانُوا۟","",834],["2:99:10",15,"ٱلْفَـٰسِقُونَ","the defiantly disobedient","يَكْفُرُ بِهَآ إِلَّا","",316],["2:197:11",31,"فُسُوقَ","wickedness","فَلَا رَفَثَ وَلَا","وَلَا جِدَالَ فِى",1550],["2:282:119",48,"فُسُوقٌۢ","(is) sinful conduct","وَإِن تَفْعَلُوا۟ فَإِنَّهُۥ","بِكُمْ ۗ وَٱتَّقُوا۟ ٱللَّهَ ۖ",1550],["3:82:7",60,"ٱلْفَـٰسِقُونَ","(are) the defiantly disobedient","ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ","",316],["3:110:23",64,"ٱلْفَـٰسِقُونَ","(are) defiantly disobedient","مِّنْهُمُ ٱلْمُؤْمِنُونَ وَأَكْثَرُهُمُ","",316],["5:3:30",107,"فِسْقٌ ۗ","(is) grave disobedience","تَسْتَقْسِمُوا۟ بِٱلْأَزْلَـٰمِ ۚ ذَٰلِكُمْ","ٱلْيَوْمَ يَئِسَ ٱلَّذِينَ",1838],["5:25:13",112,"ٱلْفَـٰسِقِينَ","(the) defiantly disobedient","بَيْنَنَا وَبَيْنَ ٱلْقَوْمِ","",316],["5:26:14",112,"ٱلْفَـٰسِقِينَ","the defiantly disobedient","تَأْسَ عَلَى ٱلْقَوْمِ","",316],["5:47:16",116,"ٱلْفَـٰسِقُونَ","the defiantly disobedient","ٱللَّهُ فَأُو۟لَـٰٓئِكَ هُمُ","",316],["5:49:33",116,"لَفَـٰسِقُونَ","(are) defiantly disobedient","كَثِيرًۭا مِّنَ ٱلنَّاسِ","",316],["5:59:20",118,"فَـٰسِقُونَ","(are) defiantly disobedient","قَبْلُ وَأَنَّ أَكْثَرَكُمْ","",316],["5:81:15",121,"فَـٰسِقُونَ","(are) defiantly disobedient","وَلَـٰكِنَّ كَثِيرًۭا مِّنْهُمْ","",316],["5:108:22",125,"ٱلْفَـٰسِقِينَ","the defiantly disobedient","لَا يَهْدِى ٱلْقَوْمَ","",316],["6:49:8",133,"يَفْسُقُونَ","defiantly disobey","ٱلْعَذَابُ بِمَا كَانُوا۟","",834],["6:121:10",143,"لَفِسْقٌۭ ۗ","grave disobedience","ٱللَّهِ عَلَيْهِ وَإِنَّهُۥ","وَإِنَّ ٱلشَّيَـٰطِينَ لَيُوحُونَ",1838],["6:145:25",147,"فِسْقًا","(it be) disobedience","فَإِنَّهُۥ رِجْسٌ أَوْ","أُهِلَّ لِغَيْرِ ٱللَّهِ",1838],["7:102:9",163,"لَفَـٰسِقِينَ","certainly, defiantly disobedient","وَإِن وَجَدْنَآ أَكْثَرَهُمْ","",316],["7:145:20",168,"ٱلْفَـٰسِقِينَ","(of) the defiantly disobedient","بِأَحْسَنِهَ