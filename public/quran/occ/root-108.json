","إِلَىٰٓ أُمِّكَ كَىْ",142],["20:86:1",317,"فَرَجَعَ","Then Musa returned","","مُوسَىٰٓ إِلَىٰ قَوْمِهِۦ",142],["20:89:4",318,"يَرْجِعُ","it (could) return","أَفَلَا يَرَوْنَ أَلَّا","إِلَيْهِمْ قَوْلًۭا وَلَا",142],["20:91:7",318,"يَرْجِعَ","returns","عَلَيْهِ عَـٰكِفِينَ حَتَّىٰ","إِلَيْنَا مُوسَىٰ",142],["21:13:3",323,"وَٱرْجِعُوٓا۟","but return","لَا تَرْكُضُوا۟","إِلَىٰ مَآ أُتْرِفْتُمْ",142],["21:35:10",324,"تُرْجَعُونَ","you will be returned","وَٱلْخَيْرِ فِتْنَةًۭ ۖ وَإِلَيْنَا","",142],["21:58:8",327,"يَرْجِعُونَ","return","لَّهُمْ لَعَلَّهُمْ إِلَيْهِ","",142],["21:64:1",327,"فَرَجَعُوٓا۟","So they returned","","إِلَىٰٓ أَنفُسِهِمْ فَقَالُوٓا۟",142],["21:93:6",330,"رَٰجِعُونَ","(will) return","بَيْنَهُمْ ۖ كُلٌّ إِلَيْنَا","",1629],["21:95:7",330,"يَرْجِعُونَ","will return","أَهْلَكْنَـٰهَآ أَنَّهُمْ لَا","",142],["22:76:9",341,"تُرْجَعُ","return","خَلْفَهُمْ ۗ وَإِلَى ٱللَّهِ","ٱلْأُمُورُ",142],["23:60:10",346,"رَٰجِعُونَ","(will) return","أَنَّهُمْ إِلَىٰ رَبِّهِمْ","",1629],["23:99:8",348,"ٱرْجِعُونِ","Send me back","ٱلْمَوْتُ قَالَ رَبِّ","",142],["23:115:8",349,"تُرْجَعُونَ","will be returned","وَأَنَّكُمْ إِلَيْنَا لَا","",142],["24:28:14",353,"ٱرْجِعُوا۟","Go back","وَإِن قِيلَ لَكُمُ","فَٱرْجِعُوا۟ ۖ هُوَ أَزْكَىٰ",142],["24:28:15",353,"فَٱرْجِعُوا۟ ۖ","then go back","قِيلَ لَكُمُ ٱرْجِعُوا۟","هُوَ أَزْكَىٰ لَكُمْ ۚ",142],["24:64:14",359,"يُرْجَعُونَ","they will be returned","أَنتُمْ عَلَيْهِ وَيَوْمَ","إِلَيْهِ فَيُنَبِّئُهُم بِمَا",142],["27:28:11",379,"يَرْجِعُونَ","they return","عَنْهُمْ فَٱنظُرْ مَاذَا","",142],["27:35:7",379,"يَرْجِعُ","return","بِهَدِيَّةٍۢ فَنَاظِرَةٌۢ بِمَ","ٱلْمُرْسَلُونَ",142],["27:37:1",380,"ٱرْجِعْ","Return","","إِلَيْهِمْ فَلَنَأْتِيَنَّهُم بِجُنُودٍۢ",142],["28:39:12",390,"يُرْجَعُونَ","will be returned","أَنَّهُمْ إِلَيْنَا لَا","",142],["28:70:15",393,"تُرْجَعُونَ","you will be returned","وَلَهُ ٱلْحُكْمُ وَإِلَيْهِ","",142],["28:88:19",396,"تُرْجَعُونَ","you will be returned","لَهُ ٱلْحُكْمُ وَإِلَيْهِ","",142