],["40:77:14",475,"يُرْجَعُونَ","they will be returned","أَوْ نَتَوَفَّيَنَّكَ فَإِلَيْنَا","",142],["41:21:18",479,"تُرْجَعُونَ","you will be returned","أَوَّلَ مَرَّةٍۢ وَإِلَيْهِ","",142],["41:50:17",482,"رُّجِعْتُ","I am returned","ٱلسَّاعَةَ قَآئِمَةًۭ وَلَئِن","إِلَىٰ رَبِّىٓ إِنَّ",142],["43:28:7",491,"يَرْجِعُونَ","return","فِى عَقِبِهِۦ لَعَلَّهُمْ","",142],["43:48:13",493,"يَرْجِعُونَ","return","وَأَخَذْنَـٰهُم بِٱلْعَذَابِ لَعَلَّهُمْ","",142],["43:85:13",495,"تُرْجَعُونَ","you will be returned","عِلْمُ ٱلسَّاعَةِ وَإِلَيْهِ","",142],["45:15:11",500,"تُرْجَعُونَ","you will be returned","ثُمَّ إِلَىٰ رَبِّكُمْ","",142],["46:27:10",505,"يَرْجِعُونَ","return","وَصَرَّفْنَا ٱلْـَٔايَـٰتِ لَعَلَّهُمْ","",142],["50:3:6",518,"رَجْعٌۢ","(is) a return","وَكُنَّا تُرَابًۭا ۖ ذَٰلِكَ","بَعِيدٌۭ",1976],["56:87:1",537,"تَرْجِعُونَهَآ","Bring it back","","إِن كُنتُمْ صَـٰدِقِينَ",142],["57:5:7",538,"تُرْجَعُ","will be returned","وَٱلْأَرْضِ ۚ وَإِلَى ٱللَّهِ","ٱلْأُمُورُ",142],["57:13:12",539,"ٱرْجِعُوا۟","Go back","مِن نُّورِكُمْ قِيلَ","وَرَآءَكُمْ فَٱلْتَمِسُوا۟ نُورًۭا",142],["60:10:16",550,"تَرْجِعُوهُنَّ","return them","عَلِمْتُمُوهُنَّ مُؤْمِنَـٰتٍۢ فَلَا","إِلَى ٱلْكُفَّارِ ۖ لَا",142],["63:8:3",555,"رَّجَعْنَآ","we return","يَقُولُونَ لَئِن","إِلَى ٱلْمَدِينَةِ لَيُخْرِجَنَّ",142],["67:3:13",562,"فَٱرْجِعِ","So return","ٱلرَّحْمَـٰنِ مِن تَفَـٰوُتٍۢ ۖ","ٱلْبَصَرَ هَلْ تَرَىٰ",142],["67:4:2",562,"ٱرْجِعِ","return","ثُمَّ","ٱلْبَصَرَ كَرَّتَيْنِ يَنقَلِبْ",142],["86:8:3",591,"رَجْعِهِۦ","return him","إِنَّهُۥ عَلَىٰ","لَقَادِرٌۭ",1976],["86:11:3",591,"ٱلرَّجْعِ","returns","وَٱلسَّمَآءِ ذَاتِ","",1976],["89:28:1",594,"ٱرْجِعِىٓ","Return","","إِلَىٰ رَبِّكِ رَاضِيَةًۭ",142],["96:8:4",597,"ٱلرُّجْعَىٰٓ","(is) the return","إِنَّ إِلَىٰ رَبِّكَ","",4224]]