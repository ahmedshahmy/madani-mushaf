ِمْ غَيْرُ مَأْمُونٍۢ",36],["71:1:13",570,"عَذَابٌ","a punishment","قَبْلِ أَن يَأْتِيَهُمْ","أَلِيمٌۭ",36],["72:17:9",573,"عَذَابًۭا","a punishment","ذِكْرِ رَبِّهِۦ يَسْلُكْهُ","صَعَدًۭا",36],["73:13:4",574,"وَعَذَابًا","and a punishment","وَطَعَامًۭا ذَا غُصَّةٍۢ","أَلِيمًۭا",36],["76:31:9",580,"عَذَابًا","a punishment","وَٱلظَّـٰلِمِينَ أَعَدَّ لَهُمْ","أَلِيمًۢا",36],["78:30:5",582,"عَذَابًا","(in) punishment","فَلَن نَّزِيدَكُمْ إِلَّا","",36],["78:40:3",583,"عَذَابًۭا","(of) a punishment","إِنَّآ أَنذَرْنَـٰكُمْ","قَرِيبًۭا يَوْمَ يَنظُرُ",36],["84:24:2",589,"بِعَذَابٍ","of a punishment","فَبَشِّرْهُم","أَلِيمٍ",36],["85:10:10",590,"عَذَابُ","(is the) punishment","لَمْ يَتُوبُوا۟ فَلَهُمْ","جَهَنَّمَ وَلَهُمْ عَذَابُ",36],["85:10:13",590,"عَذَابُ","(is the) punishment","عَذَابُ جَهَنَّمَ وَلَهُمْ","ٱلْحَرِيقِ",36],["88:24:1",593,"فَيُعَذِّبُهُ","Then will punish him","","ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",280],["88:24:3",593,"ٱلْعَذَابَ","(with) the punishment","فَيُعَذِّبُهُ ٱللَّهُ","ٱلْأَكْبَرَ",36],["89:13:5",593,"عَذَابٍ","(of) punishment","عَلَيْهِمْ رَبُّكَ سَوْطَ","",36],["89:25:3",594,"يُعَذِّبُ","will punish","فَيَوْمَئِذٍۢ لَّا","عَذَابَهُۥٓ أَحَدٌۭ",280],["89:25:4",594,"عَذَابَهُۥٓ","(as) His punishment","فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ","أَحَدٌۭ",36]]