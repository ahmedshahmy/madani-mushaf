,36],["43:65:9",494,"عَذَابِ","(the) punishment","لِّلَّذِينَ ظَلَمُوا۟ مِنْ","يَوْمٍ أَلِيمٍ",36],["43:74:4",495,"عَذَابِ","(the) punishment","إِنَّ ٱلْمُجْرِمِينَ فِى","جَهَنَّمَ خَـٰلِدُونَ",36],["44:11:4",496,"عَذَابٌ","(will be) a punishment","يَغْشَى ٱلنَّاسَ ۖ هَـٰذَا","أَلِيمٌۭ",36],["44:12:4",496,"ٱلْعَذَابَ","the punishment","رَّبَّنَا ٱكْشِفْ عَنَّا","إِنَّا مُؤْمِنُونَ",36],["44:15:3",496,"ٱلْعَذَابِ","the punishment","إِنَّا كَاشِفُوا۟","قَلِيلًا ۚ إِنَّكُمْ عَآئِدُونَ",36],["44:30:6",497,"ٱلْعَذَابِ","the punishment","بَنِىٓ إِسْرَٰٓءِيلَ مِنَ","ٱلْمُهِينِ",36],["44:48:6",498,"عَذَابِ","(the) punishment","فَوْقَ رَأْسِهِۦ مِنْ","ٱلْحَمِيمِ",36],["44:56:9",498,"عَذَابَ","(from the) punishment","ٱلْمَوْتَةَ ٱلْأُولَىٰ ۖ وَوَقَىٰهُمْ","ٱلْجَحِيمِ",36],["45:8:13",499,"بِعَذَابٍ","(of) a punishment","لَّمْ يَسْمَعْهَا ۖ فَبَشِّرْهُ","أَلِيمٍۢ",36],["45:9:10",499,"عَذَابٌۭ","(is) a punishment","هُزُوًا ۚ أُو۟لَـٰٓئِكَ لَهُمْ","مُّهِينٌۭ",36],["45:10:18",499,"عَذَابٌ","(is) a punishment","ٱللَّهِ أَوْلِيَآءَ ۖ وَلَهُمْ","عَظِيمٌ",36],["45:11:8",499,"عَذَابٌۭ","(is) a punishment","بِـَٔايَـٰتِ رَبِّهِمْ لَهُمْ","مِّن رِّجْزٍ أَلِيمٌ",36],["46:20:16",504,"عَذَابَ","(with) a punishment","بِهَا فَٱلْيَوْمَ تُجْزَوْنَ","ٱلْهُونِ بِمَا كُنتُمْ",36],["46:21:23",505,"عَذَابَ","a punishment","إِنِّىٓ أَخَافُ عَلَيْكُمْ","يَوْمٍ عَظِيمٍۢ",36],["46:24:17",505,"عَذَابٌ","(is) a punishment","بِهِۦ ۖ رِيحٌۭ فِيهَا","أَلِيمٌۭ",36],["46:31:13",506,"عَذَابٍ","a punishment","ذُنُوبِكُمْ وَيُجِرْكُم مِّنْ","أَلِيمٍۢ",36],["46:34:15",506,"ٱلْعَذَابَ","the punishment","وَرَبِّنَا ۚ قَالَ فَذُوقُوا۟","بِمَا كُنتُمْ تَكْفُرُونَ",36],["48:6:1",511,"وَيُعَذِّبَ","And He (may) punish","","ٱلْمُنَـٰفِقِينَ وَٱلْمُنَـٰفِقَـٰتِ وَٱلْمُشْرِكِينَ",280],["48:14:8",512,"وَيُعَذِّبُ","and punishes","يَغْفِرُ لِمَن يَشَآءُ","مَن يَشَآءُ ۚ وَكَانَ",280],["48:16:26",513,"يُعَذِّبْكُمْ","He will punish you","تَوَلَّيْتُم مِّن قَبْلُ","عَذَابًا أَلِيمًۭا",280],["48:16:27",513,"عَذَابًا","(with) a punishment","مِّن قَبْلُ يُعَذِّبْكُمْ","أَلِيمًۭا",36],["48:17:25",513,"يُعَذِّبْهُ","He will punish him","ٱلْأَنْهَـٰرُ ۖ وَمَن يَتَوَلَّ","عَذَابًا أَلِيمًۭا",280],["48:17:26",513,"عَذَابًا","(with) a punishment","وَمَن يَتَوَلَّ يُعَذِّبْهُ","أَلِيمًۭا",36],["48:25:35",514,"لَعَذَّبْنَا","surely, We would have punished","يَشَآءُ ۚ لَوْ تَزَيَّلُوا۟","ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ",280],["48:25:39",514,"عَذَابًا","(with) a punishment","ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ","أَلِيمًا",36],["50:26:9",519,"ٱلْعَذَابِ","the punishment","ءَاخَرَ فَأَلْقِيَاهُ فِى","ٱلشَّدِيدِ",36],["51:37:6",522,"ٱلْعَذَابَ","the punishment","ءَايَةًۭ لِّلَّذِينَ يَخَافُونَ","ٱلْأَلِيمَ",36],["52:7:2",523,"عَذَابَ","(the) punishment","إِنَّ","رَبِّكَ لَوَٰقِعٌۭ",36],["52:18:7",524,"عَذَابَ","(from the) punishment","رَبُّهُمْ وَوَقَىٰهُمْ رَبُّهُمْ","ٱلْجَحِيمِ",36],["52:27:5",524,"عَذَابَ","(from the) punishment","ٱللَّهُ عَلَيْنَا وَوَقَىٰنَا","ٱلسَّمُومِ",36],["52:47:4",525,"عَذَابًۭا","(is) a punishment","وَإِنَّ لِلَّذِينَ ظَلَمُوا۟","دُونَ ذَٰلِكَ وَلَـٰكِنَّ",36],["54:16:3",529,"عَذَابِى","My punishment","فَكَيْفَ كَانَ","وَنُذُرِ",36],["54:18:5",529,"عَذَابِى","My punishment","عَادٌۭ فَكَيْفَ كَانَ","وَنُذُرِ",36],["54:21:3",529,"عَذَابِى","My punishment","فَكَيْفَ كَانَ","وَنُذُرِ",36],["54:30:3",530,"عَذَابِى","My punishment","فَكَيْفَ كَانَ","وَنُذُرِ",36],["54:37:8",530,"عَذَابِى","My punishment","فَطَمَسْنَآ أَعْيُنَهُمْ فَذُوقُوا۟","وَنُذُرِ",36],["54:38:4",530,"عَذَابٌۭ","a punishment","وَلَقَدْ صَبَّحَهُم بُكْرَةً","مُّسْتَقِرٌّۭ",36],["54:39:2",530,"عَذَابِى","My punishment","فَذُوقُوا۟","وَنُذُرِ",36],["57:13:27",539,"ٱلْعَذَابُ","the punishment","وَظَـٰهِرُهُۥ مِن قِبَلِهِ","",36],["57:20:28",540,"عَذَابٌۭ","(is) a punishment","حُطَـٰمًۭا ۖ وَفِى ٱلْـَٔاخِرَةِ","شَدِيدٌۭ وَمَغْفِرَةٌۭ مِّنَ",36],["58:4:25",542,"عَذَابٌ","(is) a punishment","حُدُودُ ٱللَّهِ ۗ وَلِلْكَـٰفِرِينَ","أَلِيمٌ",36],["58:5:17",542,"عَذَابٌۭ","(is) a punishment","ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ ۚ وَلِلْك