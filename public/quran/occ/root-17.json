[["2:7:11",3,"عَذَابٌ","(is) a punishment","أَبْصَـٰرِهِمْ غِشَـٰوَةٌۭ ۖ وَلَهُمْ","عَظِيمٌۭ",36],["2:10:8",3,"عَذَابٌ","(is) a punishment","ٱللَّهُ مَرَضًۭا ۖ وَلَهُمْ","أَلِيمٌۢ بِمَا كَانُوا۟",36],["2:49:8",8,"ٱلْعَذَابِ","torment","فِرْعَوْنَ يَسُومُونَكُمْ سُوٓءَ","يُذَبِّحُونَ أَبْنَآءَكُمْ وَيَسْتَحْيُونَ",36],["2:85:44",13,"ٱلْعَذَابِ ۗ","punishment","يُرَدُّونَ إِلَىٰٓ أَشَدِّ","وَمَا ٱللَّهُ بِغَـٰفِلٍ",36],["2:86:10",13,"ٱلْعَذَابُ","the punishment","فَلَا يُخَفَّفُ عَنْهُمُ","وَلَا هُمْ يُنصَرُونَ",36],["2:90:26",14,"عَذَابٌۭ","(is) a punishment","عَلَىٰ غَضَبٍۢ ۚ وَلِلْكَـٰفِرِينَ","مُّهِينٌۭ",36],["2:96:19",15,"ٱلْعَذَابِ","the punishment","هُوَ بِمُزَحْزِحِهِۦ مِنَ","أَن يُعَمَّرَ ۗ وَٱللَّهُ",36],["2:104:11",16,"عَذَابٌ","(is) a punishment","ٱنظُرْنَا وَٱسْمَعُوا۟ ۗ وَلِلْكَـٰفِرِينَ","أَلِيمٌۭ",36],["2:114:29",18,"عَذَابٌ","(is) a punishment","وَلَهُمْ فِى ٱلْـَٔاخِرَةِ","عَظِيمٌۭ",36],["2:126:27",19,"عَذَابِ","(the) punishment","ثُمَّ أَضْطَرُّهُۥٓ إِلَىٰ","ٱلنَّارِ ۖ وَبِئْسَ ٱلْمَصِيرُ",36],["2:162:6",24,"ٱلْعَذَابُ","the punishment","لَا يُخَفَّفُ عَنْهُمُ","وَلَا هُمْ يُنظَرُونَ",36],["2:165:23",25,"ٱلْعَذَابَ","the punishment","ظَلَمُوٓا۟ إِذْ يَرَوْنَ","أَنَّ ٱلْقُوَّةَ لِلَّهِ",36],["2:165:31",25,"ٱلْعَذَابِ","(in) [the] punishment","وَأَنَّ ٱللَّهَ شَدِيدُ","",36],["2:166:9",25,"ٱلْعَذَابَ","the punishment","ٱلَّذِينَ ٱتَّبَعُوا۟ وَرَأَوُا۟","وَتَقَطَّعَتْ بِهِمُ ٱلْأَسْبَابُ",36],["2:174:28",26,"عَذَابٌ","(is) a punishment","وَلَا يُزَكِّيهِمْ وَلَهُمْ","أَلِيمٌ",36],["2:175:6",26,"وَٱلْعَذَابَ","and [the] punishment","ٱشْتَرَوُا۟ ٱلضَّلَـٰلَةَ بِٱلْهُدَىٰ","بِٱلْمَغْفِرَةِ ۚ فَمَآ أَصْبَرَهُمْ",36],["2:178:36",27,"عَذَابٌ","(is) a punishment","بَعْدَ ذَٰلِكَ فَلَهُۥ","أَلِيمٌۭ",36],["2:201:13",31,"عَذَابَ","(from the) punishment","ٱلْـَٔاخِرَةِ حَسَنَةًۭ وَقِنَا","ٱلنَّارِ",36],["2:284:21",49,"وَيُعَذِّبُ","and He will punish","فَيَغْفِرُ لِمَن يَشَآءُ","مَن يَشَآءُ ۗ وَٱللَّهُ",280],["3:4:13",50,"عَذَابٌۭ","(is) a punishment","بِـَٔايَـٰتِ ٱللَّهِ لَهُمْ","شَدِيدٌۭ ۗ وَٱللَّهُ عَزِيزٌۭ",36],["3:16:10",52,"عَذَابَ","(from) punishment","لَنَا ذُنُوبَنَا وَقِنَا","ٱلنَّارِ",36],["3:21:17",52,"بِعَذَابٍ","of a punishment","مِنَ ٱلنَّاسِ فَبَشِّرْهُم","أَلِيمٍ",36],["3:56:4",57,"فَأُعَذِّبُهُمْ","then I will punish them","فَأَمَّا ٱلَّذِينَ كَفَرُوا۟","عَذَابًۭا شَدِيدًۭا فِى",280],["3:56:5",57,"عَذَابًۭا","(with) a punishment","ٱلَّذِينَ كَفَرُوا۟ فَأُعَذِّبُهُمْ","شَدِيدًۭا فِى ٱلدُّنْيَا",36],["3:77:26",59,"عَذَابٌ","(is) a punishment","وَلَا يُزَكِّيهِمْ وَلَهُمْ","أَلِيمٌۭ",36],["3:88:6",61,"ٱلْعَذَابُ","the punishment","لَا يُخَفَّفُ عَنْهُمُ","وَلَا هُمْ يُنظَرُونَ",36],["3:91:19",61,"عَذَابٌ","(is) a punishment","بِهِۦٓ ۗ أُو۟لَـٰٓئِكَ لَهُمْ","أَلِيمٌۭ وَمَا لَهُم",36],["3:105:13",63,"عَذَابٌ","(is) a punishment","ٱلْبَيِّنَـٰتُ ۚ وَأُو۟لَـٰٓئِكَ لَهُمْ","عَظِيمٌۭ",36],["3:106:14",63,"ٱلْعَذَابَ","the punishment","بَعْدَ إِيمَـٰنِكُمْ فَذُوقُوا۟","بِمَا كُنتُمْ تَكْفُرُونَ",36],["3:128:10",66,"يُعَذِّبَهُمْ","punishes them","يَتُوبَ عَلَيْهِمْ أَوْ","فَإِنَّهُمْ ظَـٰلِمُونَ",280],["3:129:11",66,"وَيُعَذِّبُ","and punishes","يَغْفِرُ لِمَن يَشَآءُ","مَن يَشَآءُ ۚ وَٱللَّهُ",280],["3:176:21",73,"عَذَابٌ","(is) a punishment","فِى ٱلْـَٔاخِرَةِ ۖ وَلَهُمْ","عَظِيمٌ",36],["3:177:11",73,"عَذَابٌ","(is) a punishment","ٱللَّهَ شَيْـًۭٔا وَلَهُمْ","أَلِيمٌۭ",36],["3:178:16",73,"عَذَابٌۭ","(is) a punishment","لِيَزْدَادُوٓا۟ إِثْمًۭا ۚ وَلَهُمْ","مُّهِينٌۭ",36],["3:181:21",74,"عَذَابَ","(the) punishment","حَقٍّۢ وَنَقُولُ ذُوقُوا۟","ٱلْحَرِيقِ",36],["3:188:17",75,"ٱلْعَذَابِ ۖ","the punishment","تَحْسَبَنَّهُم بِمَفَازَةٍۢ مِّنَ","وَلَهُمْ عَذَابٌ أَلِيمٌۭ",36],["3:188:19",75,"عَذَابٌ","(is a) punishment","مِّنَ ٱلْعَذَابِ ۖ وَلَهُمْ","أَلِيمٌۭ",36],["3:191:20",75,"عَذَابَ","(from the) punishment","بَـٰطِلًۭا سُبْحَـٰنَكَ فَقِنَا","ٱلنَّارِ",36],["4:14:12",79,"عَذَابٌۭ","(is) a punishment","خَـٰلِدًۭا فِيهَا وَلَهُۥ","مُّهِينٌۭ",36],["4:18:23",80,"عَذَابًا","a punishment","أُو۟لَـٰٓئِكَ أَعْتَدْنَا لَهُمْ","أَلِيمًۭا",36],["4:25:46",82,"ٱلْعَذَابِ ۚ","the punishment","عَلَى ٱلْمُحْصَنَـٰتِ مِنَ","ذَٰلِكَ لِمَنْ خَشِىَ",36],["4:37:14",84,"عَذَابًۭا","a punishment","فَضْلِهِۦ ۗ وَأَعْتَدْنَا لِلْكَـٰفِرِينَ","مُّهِينًۭا",36],["4:56:15",87,"ٱلْعَذَابَ ۗ","the punishment","جُلُودًا غَيْرَهَا لِيَذُوقُوا۟","إِنَّ ٱللَّهَ كَانَ",36],["4:93:15",93,"عَذَابًا","a punishment","وَلَعَنَهُۥ وَأَعَدَّ لَهُۥ","عَظِيمًۭا",36],["4:102:61",95,"عَذَابًۭا","a punishment","ٱللَّهَ أَعَدَّ لِلْكَـٰفِرِينَ","مُّهِينًۭا",36],["4:138:5",100,"عَذَابًا","(is) a punishment","ٱلْمُنَـٰفِقِينَ بِأَنَّ لَهُمْ","أَلِيمًا",36],["4:147:4",101,"بِعَذَابِكُمْ","by punishing you","مَّا يَفْعَلُ ٱللَّهُ","إِن شَكَرْتُمْ وَءَامَنتُمْ ۚ",36],["4:151:7",102,"عَذَابًۭا","a punishment","حَقًّۭا ۚ وَأَعْتَدْنَا لِلْكَـٰفِرِينَ","مُّهِينًۭا",36],["4:161:13",103,"عَذَابًا","a punishment","وَأَعْتَدْنَا لِلْكَـٰفِرِينَ مِنْهُمْ","أَلِيمًۭا",36],["4:173:15",105,"فَيُعَذِّبُهُمْ","then He will punish them","ٱلَّذِينَ ٱسْتَنكَفُوا۟ وَٱسْتَكْبَرُوا۟","عَذَابًا أَلِيمًۭا وَلَا",280],["4:173:16",105,"عَذَابًا","(with) a punishment","ٱسْتَنكَفُوا۟ وَٱسْتَكْبَرُوا۟ فَيُعَذِّبُهُمْ","أَلِيمًۭا وَلَا يَجِدُونَ",36],["5:18:10",111,"يُعَذِّبُكُم","(does He) punish you","وَأَحِبَّـٰٓؤُهُۥ ۚ قُلْ فَلِمَ","بِذُنُوبِكُم ۖ بَلْ أَنتُم",280],["5:18:20",111,"وَيُعَذِّبُ","and punishes","يَغْفِرُ لِمَن يَشَآءُ","مَن يَشَآءُ ۚ وَلِلَّهِ",280],["5:33:33",113,"عَذَابٌ","(is) a punishment","وَلَهُمْ فِى ٱلْـَٔاخِرَةِ","عَظِيمٌ",36],["5:36:16",113,"عَذَابِ","(the) punishment","لِيَفْتَدُوا۟ بِهِۦ مِنْ","يَوْمِ ٱلْقِيَـٰمَةِ مَا",36],["5:36:23",113,"عَذَابٌ","(is) a punishment","تُقُبِّلَ مِنْهُمْ ۖ وَلَهُمْ","أَلِيمٌۭ",36],["5:37:11",114,"عَذَابٌۭ","(is) a punishment","بِخَـٰرِجِينَ مِنْهَا ۖ وَلَهُمْ","مُّقِيمٌۭ",36],["5:40:9",114,"يُعَذِّبُ","He punishes","مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","مَن يَشَآءُ وَيَغْفِرُ",280],["5:41:66",114,"عَذَابٌ","(is) a punishment","وَلَهُمْ فِى ٱلْـَٔاخِرَةِ","عَظِيمٌۭ",36],["5:73:24",120,"عَذَابٌ","a punishment","ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ","أَلِيمٌ",36],["5:80:17",121,"ٱلْعَذَابِ","the punishment","ٱللَّهُ عَلَيْهِمْ وَفِى","هُمْ خَـٰلِدُونَ",36],["5:94:22",123,"عَذَابٌ","(is) a punishment","بَعْدَ ذَٰلِكَ فَلَهُۥ","أَلِيمٌۭ",36],["5:115:11",127,"أُعَذِّبُهُۥ","[I] will punish him","بَعْدُ مِنكُمْ فَإِنِّىٓ","عَذَابًۭا لَّآ أُعَذِّبُهُۥٓ",280],["5:115:12",127,"عَذَابًۭا","(with) a punishment","مِنكُمْ فَإِنِّىٓ أُعَذِّبُهُۥ","لَّآ أُعَذِّبُهُۥٓ أَحَدًۭا",36],["5:115:14",127,"أُعَذِّبُهُۥٓ","I have punished","أُعَذِّبُهُۥ عَذَابًۭا لَّآ","أَحَدًۭا مِّنَ ٱلْعَـٰلَمِينَ",280],["5:118:2",127,"تُعَذِّبْهُمْ","You punish them","إِن","فَإِنَّهُمْ عِبَادُكَ ۖ وَإِن",280],["6:15:7",129,"عَذَابَ","punishment","إِنْ عَصَيْتُ رَبِّى","يَوْمٍ عَظِيمٍۢ",36],["6:30:16",131,"ٱلْعَذَابَ","the punishment","وَرَبِّنَا ۚ قَالَ فَذُوقُوا۟","بِمَا كُنتُمْ تَكْفُرُونَ",36],["6:40:5",132,"عَذَابُ","punishment","أَرَءَيْتَكُمْ إِنْ أَتَىٰكُمْ","ٱللَّهِ أَوْ أَتَتْكُمُ",36],["6:47:5",133,"عَذَابُ","punishment","أَرَءَيْتَكُمْ إِنْ أَتَىٰكُمْ","ٱللَّهِ بَغْتَةً أَوْ",36],["6:49:5",133,"ٱلْعَذَابُ","the punishment","كَذَّبُوا۟ بِـَٔايَـٰتِنَا يَمَسُّهُمُ","بِمَا كَانُوا۟ يَفْسُقُونَ",36],["6:65:8",135,"عَذَابًۭا","punishment","أَن يَبْعَثَ عَلَيْكُمْ","مِّن فَوْقِكُمْ أَوْ",36],["6:70:41",136,"وَعَذَابٌ","and a punishment","شَرَابٌۭ مِّنْ حَمِيمٍۢ","أَلِيمٌۢ بِمَا كَانُوا۟",36],["6:93:37",139,"عَذَابَ","(with) punishment","أَنفُسَكُمُ ۖ ٱلْيَوْمَ تُجْزَوْنَ","ٱلْهُونِ بِمَا كُنتُمْ",36],["6:124:25",143,"وَعَذَابٌۭ","and a punishment","صَغَارٌ عِندَ ٱللَّهِ","شَدِيدٌۢ بِمَا كَانُوا۟",36],["6:157:32",149,"ٱلْعَذَابِ","punishment","عَنْ ءَايَـٰتِنَا سُوٓءَ","بِمَا كَانُوا۟ يَصْدِفُونَ",36],["7:38:31",155,"عَذَابًۭا","punishment","هَـٰٓؤُلَآءِ أَضَلُّونَا فَـَٔاتِهِمْ","ضِعْفًۭا مِّنَ ٱلنَّارِ ۖ",36],["7:39:11",155,"ٱلْعَذَابَ","the punishment","مِن فَضْلٍۢ فَذُوقُوا۟","بِمَا كُنتُمْ تَكْسِبُونَ",36],["7:59:18",158,"عَذَابَ","punishment","إِنِّىٓ أَخَافُ عَلَيْكُمْ","يَوْمٍ عَظِيمٍۢ",36],["7:73:33",159,"عَذَابٌ","a punishment","تَمَسُّوهَا بِسُوٓءٍۢ فَيَأْخُذَكُمْ","أَلِيمٌۭ",36],["7:141:8",167,"ٱلْعَذَابِ ۖ","(of) torment","فِرْعَوْنَ يَسُومُونَكُمْ سُوٓءَ","يُقَتِّلُونَ أَبْنَآءَكُمْ وَيَسْتَحْيُونَ",36],["7:156:13",170,"عَذَابِىٓ","My punishment","هُدْنَآ إِلَيْكَ ۚ قَالَ","أُصِيبُ بِهِۦ مَنْ",36],["7:164:11",172,"مُعَذِّبُهُمْ","punish them","ٱللَّهُ مُهْلِكُهُمْ أَوْ","عَذَابًۭا شَدِيدًۭا ۖ قَالُوا۟",1586],["7:164:12",172,"عَذَابًۭا","(with) a punishment","مُهْلِكُهُمْ أَوْ مُعَذِّبُهُمْ","شَدِيدًۭا ۖ قَالُوا۟ مَعْذِرَةً",36],["7:165:14",172,"بِعَذَابٍۭ","with a punishment","وَأَخَذْنَا ٱلَّذِينَ ظَلَمُوا۟","بَـِٔيسٍۭ بِمَا كَانُوا۟",36],["7:167:12",172,"ٱلْعَذَابِ ۗ","[the] punishment","مَن يَسُومُهُمْ سُوٓءَ","إِنَّ رَبَّكَ لَسَرِيعُ",36],["8:14:5",178,"عَذَابَ","(is the) punishment","فَذُوقُوهُ وَأَنَّ لِلْكَـٰفِرِينَ","ٱلنَّارِ",36],["8:32:18",180,"بِعَذَابٍ","a punishment","ٱلسَّمَآءِ أَوِ ٱئْتِنَا","أَلِيمٍۢ",36],["8:33:4",180,"لِيُعَذِّبَهُمْ","that He punishes them","وَمَا كَانَ ٱللَّهُ","وَأَنتَ فِيهِمْ ۚ وَمَا",280],["8:33:10",180,"مُعَذِّبَهُمْ","the One Who punishes them","وَمَا كَانَ ٱللَّهُ","وَهُمْ يَسْتَغْفِرُونَ",1586],["8:34:4",181,"يُعَذِّبَهُمُ","(should) punish them","وَمَا لَهُمْ أَلَّا","ٱللَّهُ وَهُمْ يَصُدُّونَ",280],["8:35:10",181,"ٱلْعَذَابَ","the punishment","مُكَآءًۭ وَتَصْدِيَةًۭ ۚ فَذُوقُوا۟","بِمَا كُنتُمْ تَكْفُرُونَ",36],["8:50:12",183,"عَذَابَ","(the) punishment","وُجُوهَهُمْ وَأَدْبَـٰرَهُمْ وَذُوقُوا۟","ٱلْحَرِيقِ",36],["8:68:9",185,"عَذَابٌ","a punishment","لَمَسَّكُمْ فِيمَآ أَخَذْتُمْ","عَظِيمٌۭ",36],["9:3:31",187,"بِعَذَابٍ","of a punishment","وَبَشِّرِ ٱلَّذِينَ كَفَرُوا۟","أَلِيمٍ",36],["9:14:2",189,"يُعَذِّبْهُمُ","Allah will punish them","قَـٰتِلُوهُمْ","ٱللَّهُ بِأَيْدِيكُمْ وَيُخْزِهِمْ",280],["9:26:13",190,"وَعَذَّبَ","and He punished","جُنُودًۭا لَّمْ تَرَوْهَا","ٱلَّذِينَ كَفَرُوا۟ ۚ وَذَٰلِكَ",280],["9:34:27",192,"بِعَذَابٍ","of a punishment","سَبِيلِ ٱللَّهِ فَبَشِّرْهُم","أَلِيمٍۢ",36],["9:39:3",193,"يُعَذِّبْكُمْ","He will punish you","إِلَّا تَنفِرُوا۟","عَذَابًا أَلِيمًۭا وَيَسْتَبْدِلْ",280],["9:39:4",193,"عَذَابًا","(with) a painful punishment","إِلَّا تَنفِرُوا۟ يُعَذِّبْكُمْ","أَلِيمًۭا وَيَسْتَبْدِلْ قَوْمًا",36],["9:52:14",195,"بِعَذَابٍۢ","with a punishment","أَن يُصِيبَكُمُ ٱللَّهُ","مِّنْ عِندِهِۦٓ أَوْ",36],["9:55:9",196,"لِيُعَذِّبَهُم","to punish them","إِنَّمَا يُرِيدُ ٱللَّهُ","بِهَا فِى ٱلْحَيَوٰةِ",280],["9:61:25",196,"عَذَابٌ","(is) a punishment","رَسُولَ ٱللَّهِ لَهُمْ","أَلِيمٌۭ",36],["9:66:12",197,"نُعَذِّبْ","We will punish","عَن طَآئِفَةٍۢ مِّنكُمْ","طَآئِفَةًۢ بِأَنَّهُمْ كَانُوا۟",280],["9:68:15",197,"عَذَابٌۭ","(is) a punishment","وَلَعَنَهُمُ ٱللَّهُ ۖ وَلَهُمْ","مُّقِيمٌۭ",36],["9:74:32",199,"يُعَذِّبْهُمُ","Allah will punish them","لَّهُمْ ۖ وَإِن يَتَوَلَّوْا۟","ٱللَّهُ عَذَابًا أَلِيمًۭا",280],["9:74:34",199,"عَذَابًا","(with) a punishment","يَتَوَلَّوْا۟ يُعَذِّبْهُمُ ٱللَّهُ","أَلِيمًۭا فِى ٱلدُّنْيَا",36],["9:79:19",199,"عَذَابٌ","(is) a punishment","ٱللَّهُ مِنْهُمْ وَلَهُمْ","أَلِيمٌ",36],["9:85:9",200,"يُعَذِّبَهُم","punish them","يُرِيدُ ٱللَّهُ أَن","بِهَا فِى ٱلدُّنْيَا",280],["9:90:16",201,"عَذَابٌ","a punishment","ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ","أَلِيمٌۭ",36],["9:101:16",203,"سَنُعَذِّبُهُم","We will punish them","تَعْلَمُهُمْ ۖ نَحْنُ نَعْلَمُهُمْ ۚ","مَّرَّتَيْنِ ثُمَّ يُرَدُّونَ",280],["9:101:21",203,"عَذَابٍ","a punishment","ثُمَّ يُرَدُّونَ إِلَىٰ","عَظِيمٍۢ",36],["9:106:6",203,"يُعَذِّبُهُمْ","He will punish them","لِأَمْرِ ٱللَّهِ إِمَّا","وَإِمَّا يَتُوبُ عَلَيْهِمْ ۗ",280],["10:4:24",208,"وَعَذَابٌ","and a punishment","شَرَابٌۭ مِّنْ حَمِيمٍۢ","أَلِيمٌۢ بِمَا كَانُوا۟",36],["10:15:37",210,"عَذَابَ","(the) punishment","إِنْ عَصَيْتُ رَبِّى","يَوْمٍ عَظِيمٍۢ",36],["10:50:5",214,"عَذَابُهُۥ","His punishment","أَرَءَيْتُمْ إِنْ أَتَىٰكُمْ","بَيَـٰتًا أَوْ نَهَارًۭا",36],["10:52:6",214,"عَذَابَ","punishment","لِلَّذِينَ ظَلَمُوا۟ ذُوقُوا۟","ٱلْخُلْدِ هَلْ تُجْزَوْنَ",36],["10:54:15",215,"ٱلْعَذَابَ ۖ","the punishment","ٱلنَّدَامَةَ لَمَّا رَأَوُا۟","وَقُضِىَ بَيْنَهُم بِٱلْقِسْطِ ۚ",36],["10:70:9",216,"ٱلْعَذَابَ","the punishment","مَرْجِعُهُمْ ثُمَّ نُذِيقُهُمُ","ٱلشَّدِيدَ بِمَا كَانُوا۟",36],["10:88:28",218,"ٱلْعَذَابَ","the punishment","يُؤْمِنُوا۟ حَتَّىٰ يَرَوُا۟","ٱلْأَلِيمَ",36],["10:97:7",219,"ٱلْعَذَابَ","the punishment","ءَايَةٍ حَتَّىٰ يَرَوُا۟","ٱلْأَلِيمَ",36],["10:98:14",220,"عَذَابَ","(the) punishment","ءَامَنُوا۟ كَشَفْنَا عَنْهُمْ","ٱلْخِزْىِ فِى ٱلْحَيَوٰةِ",36],["11:3:23",221,"عَذَابَ","(the) punishment","فَإِنِّىٓ أَخَافُ عَلَيْكُمْ","يَوْمٍۢ كَبِيرٍ",36],["11:8:4",222,"ٱلْعَذَابَ","the punishment","وَلَئِنْ أَخَّرْنَا عَنْهُمُ","إِلَىٰٓ أُمَّةٍۢ مَّعْدُودَةٍۢ",36],["11:20:17",224,"ٱلْعَذَابُ ۚ","the punishment","أَوْلِيَآءَ ۘ يُضَـٰعَفُ لَهُمُ","مَا كَانُوا۟ يَسْتَطِيعُونَ",36],["11:26:9",224,"عَذَابَ","(the) punishment","إِنِّىٓ أَخَافُ عَلَيْكُمْ","يَوْمٍ أَلِيمٍۢ",36],["11:39:5",226,"عَذَابٌۭ","a punishment","تَعْلَمُونَ مَن يَأْتِيهِ","يُخْزِيهِ وَيَحِلُّ عَلَيْهِ",36],["11:39:9",226,"عَذَابٌۭ","a punishment","يُخْزِيهِ وَيَحِلُّ عَلَيْهِ","مُّقِيمٌ",36],["11:48:17",227,"عَذَابٌ","a punishment","ثُمَّ يَمَسُّهُم مِّنَّا","أَلِيمٌۭ",36],["11:58:13",228,"عَذَابٍ","a punishment","مِّنَّا وَنَجَّيْنَـٰهُم مِّنْ","غَلِيظٍۢ",36],["11:64:16",229,"عَذَابٌۭ","a punishment","تَمَسُّوهَا بِسُوٓءٍۢ فَيَأْخُذَكُمْ","قَرِيبٌۭ",36],["11:76:12",230,"عَذَابٌ","a punishment","رَبِّكَ ۖ وَإِنَّهُمْ ءَاتِيهِمْ","غَيْرُ مَرْدُودٍۢ",36],["11:84:24",231,"عَذَابَ","punishment","وَإِنِّىٓ أَخَافُ عَلَيْكُمْ","يَوْمٍۢ مُّحِيطٍۢ",36],["11:93:11",232,"عَذَابٌۭ","a punishment","تَعْلَمُونَ مَن يَأْتِيهِ","يُخْزِيهِ وَمَنْ هُوَ",36],["11:103:7",233,"عَذَابَ","(the) punishment","لَـَٔايَةًۭ لِّمَنْ خَافَ","ٱلْـَٔاخِرَةِ ۚ ذَٰلِكَ يَوْمٌۭ",36],["12:25:22",238,"عَذَابٌ","a punishment","أَن يُسْجَنَ أَوْ","أَلِيمٌۭ",36],["12:107:6",248,"عَذَابِ","punishment","تَأْتِيَهُمْ غَـٰشِيَةٌۭ مِّنْ","ٱللَّهِ أَوْ تَأْتِيَهُمُ",36],["13:34:2",253,"عَذَابٌۭ","(is) a punishment","لَّهُمْ","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ",36],["13:34:6",253,"وَلَعَذَابُ","and surely the punishment","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ","ٱلْـَٔاخِرَةِ أَشَقُّ ۖ وَمَا",36],["14:2:13",255,"عَذَابٍۢ","the punishment","وَوَيْلٌۭ لِّلْكَـٰفِرِينَ مِنْ","شَدِيدٍ",36],["14:6:16",256,"ٱلْعَذَابِ","torment","فِرْعَوْنَ يَسُومُونَكُمْ سُوٓءَ","وَيُذَبِّحُونَ أَبْنَآءَكُمْ وَيَسْتَحْيُونَ",36],["14:7:10",256,"عَذَابِى","My punishment","وَلَئِن كَفَرْتُمْ إِنَّ","لَشَدِيدٌۭ",36],["14:17:15",257,"عَذَابٌ","(is) a punishment","بِمَيِّتٍۢ ۖ وَمِن وَرَآئِهِۦ","غَلِيظٌۭ",36],["14:21:17",258,"عَذَابِ","(the) punishment","مُّغْنُونَ عَنَّا مِنْ","ٱللَّهِ مِن شَىْءٍۢ ۚ",36],["14:22:43",258,"عَذَابٌ","(is) a punishment","إِنَّ ٱلظَّـٰلِمِينَ لَهُمْ","أَلِيمٌۭ",36],["14:44:5",261,"ٱلْعَذَابُ","the punishment","ٱلنَّاسَ يَوْمَ يَأْتِيهِمُ","فَيَقُولُ ٱلَّذِينَ ظَلَمُوا۟",36],["15:50:2",264,"عَذَابِى","My punishment","وَأَنَّ","هُوَ ٱلْعَذَابُ ٱلْأَلِيمُ",36],["15:50:4",264,"ٱلْعَذَابُ","(is) the punishment","وَأَنَّ عَذَابِى هُوَ","ٱلْأَلِيمُ",36],["16:26:17",269,"ٱلْعَذَابُ","the punishment","مِن فَوْقِهِمْ وَأَتَىٰهُمُ","مِنْ حَيْثُ لَا",36],["16:45:12",272,"ٱلْعَذَابُ","the punishment","ٱلْأَرْضَ أَوْ يَأْتِيَهُمُ","مِنْ حَيْثُ لَا",36],["16:63:16",273,"عَذَابٌ","(is) a punishment","وَلِيُّهُمُ ٱلْيَوْمَ وَلَهُمْ","أَلِيمٌۭ",36],["16:85:5",276,"ٱلْعَذَابَ","the punishment","رَءَا ٱلَّذِينَ ظَلَمُوا۟","فَلَا يُخَفَّفُ عَنْهُمْ",36],["16:88:8",277,"عَذَابًۭا","(in) punishment","سَبِيلِ ٱللَّهِ زِدْنَـٰهُمْ","فَوْقَ ٱلْعَذَابِ بِمَا",36],["16:88:10",277,"ٱلْعَذَابِ","punishment","زِدْنَـٰهُمْ عَذَابًۭا فَوْقَ","بِمَا كَانُوا۟ يُفْسِدُونَ",36],["16:94:18",278,"عَذَابٌ","(is) a punishment","سَبِيلِ ٱللَّهِ ۖ وَلَكُمْ","عَظِيمٌۭ",36],["16:104:11",279,"عَذَابٌ","(is) a punishment","يَهْدِيهِمُ ٱللَّهُ وَلَهُمْ","أَلِيمٌ",36],["16:106:23",279,"عَذَابٌ","(is) a punishment","مِّنَ ٱللَّهِ وَلَهُمْ","عَظِيمٌۭ",36],["16:113:7",280,"ٱلْعَذَابُ","the punishment","مِّنْهُمْ فَكَذَّبُوهُ فَأَخَذَهُمُ","وَهُمْ ظَـٰلِمُونَ",36],["16:117:4",280,"عَذَابٌ","(is) a punishment","مَتَـٰعٌۭ قَلِيلٌۭ وَلَهُمْ","أَلِيمٌۭ",36],["17:10:8",283,"عَذَابًا","a punishment","بِٱلْـَٔاخِرَةِ أَعْتَدْنَا لَهُمْ","أَلِيمًۭا",36],["17:15:18",283,"مُعَذِّبِينَ","are to punish","أُخْرَىٰ ۗ وَمَا كُنَّا","حَتَّىٰ نَبْعَثَ رَسُولًۭا",1586],["17:54:10",287,"يُعَذِّبْكُمْ ۚ","He will punish you","أَوْ إِن يَشَأْ","وَمَآ أَرْسَلْنَـٰكَ عَلَيْهِمْ",280],["17:57:13",287,"عَذَابَهُۥٓ ۚ","His punishment","وَيَرْجُونَ رَحْمَتَهُۥ وَيَخَافُونَ","إِنَّ عَذَابَ رَبِّكَ",36],["17:57:15",287,"عَذَابَ","(the) punishment","وَيَخَافُونَ عَذَابَهُۥٓ ۚ إِنَّ","رَبِّكَ كَانَ مَحْذُورًۭا",36],["17:58:11",287,"مُعَذِّبُوهَا","punish it","يَوْمِ ٱلْقِيَـٰمَةِ أَوْ","عَذَابًۭا شَدِيدًۭا ۚ كَانَ",1586],["17:58:12",287,"عَذَابًۭا","with a punishment","ٱلْقِيَـٰمَةِ أَوْ مُعَذِّبُوهَا","شَدِيدًۭا ۚ كَانَ ذَٰلِكَ",36],["18:55:18",300,"ٱلْعَذَابُ","the punishment","ٱلْأَوَّلِينَ أَوْ يَأْتِيَهُمُ","قُبُلًۭا",36],["18:58:11",300,"ٱلْعَذَابَ ۚ","the punishment","كَسَبُوا۟ لَعَجَّلَ لَهُمُ","بَل لَّهُم مَّوْعِدٌۭ",36],["18:86:19",303,"تُعَذِّبَ","you punish","ٱلْقَرْنَيْنِ إِمَّآ أَن","وَإِمَّآ أَن تَتَّخِذَ",280],["18:87:6",303,"نُعَذِّبُهُۥ","we will punish him","مَن ظَلَمَ فَسَوْفَ","ثُمَّ يُرَدُّ إِلَىٰ",280],["18:87:11",303,"فَيُعَذِّبُهُۥ","and He will punish him","يُرَدُّ إِلَىٰ رَبِّهِۦ","عَذَابًۭا نُّكْرًۭا",280],["18:87:12",303,"عَذَابًۭا","(with) a punishment","إِلَىٰ رَبِّهِۦ فَيُعَذِّبُهُۥ","نُّكْرًۭا",36],["19:45:6",308,"عَذَابٌۭ","a punishment","أَخَافُ أَن يَمَسَّكَ","مِّنَ ٱلرَّحْمَـٰنِ فَتَكُونَ",36],["19:75:16",310,"ٱلْعَذَابَ","the punishment","مَا يُوعَدُونَ إِمَّا","وَإِمَّا ٱلسَّاعَةَ فَسَيَعْلَمُونَ",36],["19:79:8",311,"ٱلْعَذَابِ","the punishment","وَنَمُدُّ لَهُۥ مِنَ","مَدًّۭا",36],["20:47:11",314,"تُعَذِّبْهُمْ ۖ","torment them","بَنِىٓ إِسْرَٰٓءِيلَ وَلَا","قَدْ جِئْنَـٰكَ بِـَٔايَةٍۢ",280],["20:48:6",314,"ٱلْعَذَابَ","the punishment","أُوحِىَ إِلَيْنَآ أَنَّ","عَلَىٰ مَن كَذَّبَ",36],["20:61:11",315,"بِعَذَابٍۢ ۖ","with a punishment","ٱللَّهِ كَذِبًۭا فَيُسْحِتَكُم","وَقَدْ خَابَ مَنِ",36],["20:71:25",316,"عَذَابًۭا","(in) punishment","وَلَتَعْلَمُنَّ أَيُّنَآ أَشَدُّ","وَأَبْقَىٰ",36],["20:127:9",321,"وَلَعَذَابُ","And surely (the) punishment","يُؤْمِنۢ بِـَٔايَـٰتِ رَبِّهِۦ ۚ","ٱلْـَٔاخِرَةِ أَشَدُّ وَأَبْقَىٰٓ",36],["20:134:4",321,"بِعَذَابٍۢ","with a punishment","وَلَوْ أَنَّآ أَهْلَكْنَـٰهُم","مِّن قَبْلِهِۦ لَقَالُوا۟",36],["21:46:5",326,"عَذَابِ","(the) punishment","مَّسَّتْهُمْ نَفْحَةٌۭ مِّنْ","رَبِّكَ لَيَقُولُنَّ يَـٰوَيْلَنَآ",36],["22:2:20",332,"عَذَابَ","(the) punishment","هُم بِسُكَـٰرَىٰ وَلَـٰكِنَّ","ٱللَّهِ شَدِيدٌۭ",36],["22:4:10",332,"عَذَابِ","(the) punishment","يُضِلُّهُۥ وَيَهْدِيهِ إِلَىٰ","ٱلسَّعِيرِ",36],["22:9:14",333,"عَذَابَ","(the) punishment","وَنُذِيقُهُۥ يَوْمَ ٱلْقِيَـٰمَةِ","ٱلْحَرِيقِ",36],["22:18:25",334,"ٱلْعَذَابُ ۗ","the punishment","وَكَثِيرٌ حَقَّ عَلَيْهِ","وَمَن يُهِنِ ٱللَّهُ",36],["22:22:11",334,"عَذَابَ","(the) punishment","أُعِيدُوا۟ فِيهَا وَذُوقُوا۟","ٱلْحَرِيقِ",36],["22:25:24",335,"عَذَابٍ","a punishment","بِظُلْمٍۢ نُّذِقْهُ مِنْ","أَلِيمٍۢ",36],["22:47:2",338,"بِٱلْعَذَابِ","the punishment","وَيَسْتَعْجِلُونَكَ","وَلَن يُخْلِفَ ٱللَّهُ",36],["22:55:14",338,"عَذَابُ","(the) punishment","بَغْتَةً أَوْ يَأْتِيَهُمْ","يَوْمٍ عَقِيمٍ",36],["22:57:7",339,"عَذَابٌۭ","(will be) a punishment","بِـَٔايَـٰتِنَا فَأُو۟لَـٰٓئِكَ لَهُمْ","مُّهِينٌۭ",36],["23:64:5",346,"بِٱلْعَذَابِ","with the punishment","إِذَآ أَخَذْنَا مُتْرَفِيهِم","إِذَا هُمْ يَجْـَٔرُونَ",36],["23:76:3",347,"بِٱلْعَذَابِ","with the punishment","وَلَقَدْ أَخَذْنَـٰهُم","فَمَا ٱسْتَكَانُوا۟ لِرَبِّهِمْ",36],["23:77:7",347,"عَذَابٍۢ","of a punishment","عَلَيْهِم بَابًۭا ذَا","شَدِيدٍ إِذَا هُمْ",36],["24:2:23",350,"عَذَابَهُمَا","their punishment","وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۖ وَلْيَشْهَدْ","طَآئِفَةٌۭ مِّنَ ٱلْمُؤْمِنِينَ",36],["24:8:3",350,"ٱلْعَذَابَ","the punishment","وَيَدْرَؤُا۟ عَنْهَا","أَن تَشْهَدَ أَرْبَعَ",36],["24:11:27",351,"عَذَابٌ","(is) a punishment","كِبْرَهُۥ مِنْهُمْ لَهُۥ","عَظِيمٌۭ",36],["24:14:14",351,"عَذَابٌ","a punishment","مَآ أَفَضْتُمْ فِيهِ","عَظِيمٌ",36],["24:19:11",351,"عَذَابٌ","(is) a punishment","ٱلَّذِينَ ءَامَنُوا۟ لَهُمْ","أَلِيمٌۭ فِى ٱلدُّنْيَا",36],["24:23:12",352,"عَذَابٌ","(is) a punishment","ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ وَلَهُمْ","عَظِيمٌۭ",36],["24:63:26",359,"عَذَابٌ","a punishment","فِتْنَةٌ أَوْ يُصِيبَهُمْ","أَلِيمٌ",36],["25:19:14",361,"عَذَابًۭا","a punishment","يَظْلِم مِّنكُمْ نُذِقْهُ","كَبِيرًۭا",36],["25:37:12",363,"عَذَابًا","a punishment","ءَايَةًۭ ۖ وَأَعْتَدْنَا لِلظَّـٰلِمِينَ","أَلِيمًۭا",36],["25:42:14",363,"ٱلْعَذَابَ","the punishment","يَعْلَمُونَ حِينَ يَرَوْنَ","مَنْ أَضَلُّ سَبِيلًا",36],["25:53:6",364,"عَذْبٌۭ","palatable","مَرَجَ ٱلْبَحْرَيْنِ هَـٰذَا","فُرَاتٌۭ وَهَـٰذَا مِلْحٌ",2223],["25:65:6",365,"عَذَابَ","the punishment","رَبَّنَا ٱصْرِفْ عَنَّا","جَهَنَّمَ ۖ إِنَّ عَذَابَهَا",36],["25:65:9",365,"عَذَابَهَا","its punishment","عَذَابَ جَهَنَّمَ ۖ إِنَّ","كَانَ غَرَامًا",36],["25:69:3",366,"ٱلْعَذَابُ","the punishment","يُضَـٰعَفْ لَهُ","يَوْمَ ٱلْقِيَـٰمَةِ وَيَخْلُدْ",36],["26:135:4",372,"عَذَابَ","(the) punishment","إِنِّىٓ أَخَافُ عَلَيْكُمْ","يَوْمٍ عَظِيمٍۢ",36],["26:138:3",373,"بِمُعَذَّبِينَ","(are) the ones to be punished","وَمَا نَحْنُ","",1585],["26:156:5",373,"عَذَابُ","(the) punishment","تَمَسُّوهَا بِسُوٓءٍۢ فَيَأْخُذَكُمْ","يَوْمٍ عَظِيمٍۢ",36],["26:158:2",373,"ٱلْعَذَابُ ۗ","the punishment","فَأَخَذَهُمُ","إِنَّ فِى ذَٰلِكَ",36],["26:189:3",375,"عَذَابُ","(the) punishment","فَكَذَّبُوهُ فَأَخَذَهُمْ","يَوْمِ ٱلظُّلَّةِ ۚ إِنَّهُۥ",36],["26:189:8",375,"عَذَابَ","(the) punishment","ٱلظُّلَّةِ ۚ إِنَّهُۥ كَانَ","يَوْمٍ عَظِيمٍ",36],["26:201:6",375,"ٱلْعَذَابَ","the punishment","بِهِۦ حَتَّىٰ يَرَوُا۟","ٱلْأَلِيمَ",36],["26:204:1",375,"أَفَبِعَذَابِنَا","So is it for Our punishment","","يَسْتَعْجِلُونَ",36],["26:213:9",376,"ٱلْمُعَذَّبِينَ","those punished","ءَاخَرَ فَتَكُونَ مِنَ","",1585],["27:5:5",377,"ٱلْعَذَابِ","[the] punishment","ٱلَّذِينَ لَهُمْ سُوٓءُ","وَهُمْ فِى ٱلْـَٔاخِرَةِ",36],["27:21:1",378,"لَأُعَذِّبَنَّهُۥ","I will surely punish him","","عَذَابًۭا شَدِيدًا أَوْ",280],["27:21:2",378,"عَذَابًۭا","(with) a punishment","لَأُعَذِّبَنَّهُۥ","شَدِيدًا أَوْ لَأَا۟ذْبَحَنَّهُۥٓ",36],["28:64:9",393,"ٱلْعَذَابَ ۚ","the punishment","يَسْتَجِيبُوا۟ لَهُمْ وَرَأَوُا۟","لَوْ أَنَّهُمْ كَانُوا۟",36],["29:10:14",397,"كَعَذَابِ","as (the) punishment","جَعَلَ فِتْنَةَ ٱلنَّاسِ","ٱللَّهِ وَلَئِن جَآءَ",36],["29:21:1",398,"يُعَذِّبُ","He punishes","","مَن يَشَآءُ وَيَرْحَمُ",280],["29:23:12",398,"عَذَابٌ","(is) a punishment","رَّحْمَتِى وَأُو۟لَـٰٓئِكَ لَهُمْ","أَلِيمٌۭ",36],["29:29:18",399,"بِعَذَابِ","(the) punishment","أَن قَالُوا۟ ٱئْتِنَا","ٱللَّهِ إِن كُنتَ",36],["29:53:2",403,"بِٱلْعَذَابِ ۚ","[with] the punishment","وَيَسْتَعْجِلُونَكَ","وَلَوْلَآ أَجَلٌۭ مُّسَمًّۭى",36],["29:53:7",403,"ٱلْعَذَابُ","the punishment","أَجَلٌۭ مُّسَمًّۭى لَّجَآءَهُمُ","وَلَيَأْتِيَنَّهُم بَغْتَةًۭ وَهُمْ",36],["29:54:2",403,"بِٱلْعَذَابِ","the punishment","يَسْتَعْجِلُونَكَ","وَإِنَّ جَهَنَّمَ لَمُحِيطَةٌۢ",36],["29:55:3",403,"ٱلْعَذَابُ","the punishment","يَوْمَ يَغْشَىٰهُمُ","مِن فَوْقِهِمْ وَمِن",36],["30:16:10",406,"ٱلْعَذَابِ","the punishment","ٱلْـَٔاخِرَةِ فَأُو۟لَـٰٓئِكَ فِى","مُحْضَرُونَ",36],["31:6:17",411,"عَذَابٌۭ","(is) a punishment","هُزُوًا ۚ أُو۟لَـٰٓئِكَ لَهُمْ","مُّهِينٌۭ",36],["31:7:15",411,"بِعَذَابٍ","of a punishment","أُذُنَيْهِ وَقْرًۭا ۖ فَبَشِّرْهُ","أَلِيمٍ",36],["31:21:20",413,"عَذَابِ","(the) punishment","ٱلشَّيْطَـٰنُ يَدْعُوهُمْ إِلَىٰ","ٱلسَّعِيرِ",36],["31:24:6",413,"عَذَابٍ","a punishment","ثُمَّ نَضْطَرُّهُمْ إِلَىٰ","غَلِيظٍۢ",36],["32:14:10",416,"عَذَابَ","(the) punishment","إِنَّا نَسِينَـٰكُمْ ۖ وَذُوقُوا۟","ٱلْخُلْدِ بِمَا كُنتُمْ",36],["32:20:16",416,"عَذَابَ","(the) punishment","وَقِيلَ لَهُمْ ذُوقُوا۟","ٱلنَّارِ ٱلَّذِى كُنتُم",36],["32:21:3",417,"ٱلْعَذَابِ","the punishment","وَلَنُذِيقَنَّهُم مِّنَ","ٱلْأَدْنَىٰ دُونَ ٱلْعَذَابِ",36],["32:21:6",417,"ٱلْعَذَابِ","the punishment","ٱلْعَذَابِ ٱلْأَدْنَىٰ دُونَ","ٱلْأَكْبَرِ لَعَلَّهُمْ يَرْجِعُونَ",36],["33:8:7",419,"عَذَابًا","a punishment","صِدْقِهِمْ ۚ وَأَعَدَّ لِلْكَـٰفِرِينَ","أَلِيمًۭا",36],["33:24:5",421,"وَيُعَذِّبَ","and punish","ٱللَّهُ ٱلصَّـٰدِقِينَ بِصِدْقِهِمْ","ٱلْمُنَـٰفِقِينَ إِن شَآءَ",280],["33:30:10",421,"ٱلْعَذَابُ","the punishment","مُّبَيِّنَةٍۢ يُضَـٰعَفْ لَهَا","ضِعْفَيْنِ ۚ وَكَانَ ذَٰلِكَ",36],["33:57:13",426,"عَذَابًۭا","a punishment","وَٱلْـَٔاخِرَةِ وَأَعَدَّ لَهُمْ","مُّهِينًۭا",36],["33:68:5",427,"ٱلْعَذَابِ","punishment","ءَاتِهِمْ ضِعْفَيْنِ مِنَ","وَٱلْعَنْهُمْ لَعْنًۭا كَبِيرًۭا",36],["33:73:1",427,"لِّيُعَذِّبَ","So that Allah may punish","","ٱللَّهُ ٱلْمُنَـٰفِقِينَ وَٱلْمُنَـٰفِقَـٰتِ",280],["34:5:8",428,"عَذَابٌۭ","(is) a punishment","مُعَـٰجِزِينَ أُو۟لَـٰٓئِكَ لَهُمْ","مِّن رِّجْزٍ أَلِيمٌۭ",36],["34:8:14",429,"ٱلْعَذَابِ","the punishment","يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ فِى","وَٱلضَّلَـٰلِ ٱلْبَعِيدِ",36],["34:12:26",429,"عَذَابِ","(the) punishment","أَمْرِنَا نُذِقْهُ مِنْ","ٱلسَّعِيرِ",36],["34:14:26",429,"ٱلْعَذَابِ","the punishment","مَا لَبِثُوا۟ فِى","ٱلْمُهِينِ",36],["34:33:22",432,"ٱلْعَذَابَ","the punishment","ٱلنَّدَامَةَ لَمَّا رَأَوُا۟","وَجَعَلْنَا ٱلْأَغْلَـٰلَ فِىٓ",36],["34:35:8",432,"بِمُعَذَّبِينَ","will be punished","وَأَوْلَـٰدًۭا وَمَا نَحْنُ","",1585],["34:38:8",432,"ٱلْعَذَابِ","the punishment","مُعَـٰجِزِينَ أُو۟لَـٰٓئِكَ فِى","مُحْضَرُونَ",36],["34:42:13",433,"عَذَابَ","(the) punishment","لِلَّذِينَ ظَلَمُوا۟ ذُوقُوا۟","ٱلنَّارِ ٱلَّتِى كُنتُم",36],["34:46:23",433,"عَذَابٍۢ","a punishment","لَّكُم بَيْنَ يَدَىْ","شَدِيدٍۢ",36],["35:7:4",435,"عَذَابٌۭ","(will be) a punishment","ٱلَّذِينَ كَفَرُوا۟ لَهُمْ","شَدِيدٌۭ ۖ وَٱلَّذِينَ ءَامَنُوا۟",36],["35:10:19",435,"عَذَابٌۭ","(is) a punishment","يَمْكُرُونَ ٱلسَّيِّـَٔاتِ لَهُمْ","شَدِيدٌۭ ۖ وَمَكْرُ أُو۟لَـٰٓئِكَ",36],["35:12:5",436,"عَذْبٌۭ","(is) fresh","يَسْتَوِى ٱلْبَحْرَانِ هَـٰذَا","فُرَاتٌۭ سَآئِغٌۭ شَرَابُهُۥ",2223],["35:36:14",438,"عَذَابِهَا ۚ","its torment","يُخَفَّفُ عَنْهُم مِّنْ","كَذَٰلِكَ نَجْزِى كُلَّ",36],["36:18:11",441,"عَذَابٌ","a punishment","لَنَرْجُمَنَّكُمْ وَلَيَمَسَّنَّكُم مِّنَّا","أَلِيمٌۭ",36],["37:9:3",446,"عَذَابٌۭ","(is) a punishment","دُحُورًۭا ۖ وَلَهُمْ","وَاصِبٌ",36],["37:33:4",447,"ٱلْعَذَابِ","the punishment","فَإِنَّهُمْ يَوْمَئِذٍۢ فِى","مُشْتَرِكُونَ",36],["37:38:3",447,"ٱلْعَذَابِ","the punishment","إِنَّكُمْ لَذَآئِقُوا۟","ٱلْأَلِيمِ",36],["37:59:6",448,"بِمُعَذَّبِينَ","will be punished","ٱلْأُولَىٰ وَمَا نَحْنُ","",1585],["37:176:1",452,"أَفَبِعَذَابِنَا","Then is (it) for Our punishment","","يَسْتَعْجِلُونَ",36],["38:8:15",453,"عَذَابِ","My punishment","بَل لَّمَّا يَذُوقُوا۟","",36],["38:26:25",454,"عَذَابٌۭ","(is) a punishment","سَبِيلِ ٱللَّهِ لَهُمْ","شَدِيدٌۢ بِمَا نَسُوا۟",36],["38:41:11",455,"وَعَذَابٍ","and suffering","مَسَّنِىَ ٱلشَّيْطَـٰنُ بِنُصْبٍۢ","",36],["38:61:8",456,"عَذَابًۭا","a punishment","لَنَا هَـٰذَا فَزِدْهُ","ضِعْفًۭا فِى ٱلنَّارِ",36],["39:13:7",460,"عَذَابَ","(the) punishment","إِنْ عَصَيْتُ رَبِّى","يَوْمٍ عَظِيمٍۢ",36],["39:19:5",460,"ٱلْعَذَابِ","(of) the punishment","حَقَّ عَلَيْهِ كَلِمَةُ","أَفَأَنتَ تُنقِذُ مَن",36],["39:24:5",461,"ٱلْعَذَابِ","punishment","يَتَّقِى بِوَجْهِهِۦ سُوٓءَ","يَوْمَ ٱلْقِيَـٰمَةِ ۚ وَقِيلَ",36],["39:25:6",461,"ٱلْعَذَابُ","the punishment","مِن قَبْلِهِمْ فَأَتَىٰهُمُ","مِنْ حَيْثُ لَا",36],["39:26:7",461,"وَلَعَذَابُ","and certainly (the) punishment","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ","ٱلْـَٔاخِرَةِ أَكْبَرُ ۚ لَوْ",36],["39:40:3",462,"عَذَابٌۭ","a punishment","مَن يَأْتِيهِ","يُخْزِيهِ وَيَحِلُّ عَلَيْهِ",36],["39:40:7",462,"عَذَابٌۭ","a punishment","يُخْزِيهِ وَيَحِلُّ عَلَيْهِ","مُّقِيمٌ",36],["39:47:15",463,"ٱلْعَذَابِ","(of) the punishment","بِهِۦ مِن سُوٓءِ","يَوْمَ ٱلْقِيَـٰمَةِ ۚ وَبَدَا",36],["39:54:10",464,"ٱلْعَذَابُ","the punishment","قَبْلِ أَن يَأْتِيَكُمُ","ثُمَّ لَا تُنصَرُونَ",36],["39:55:12",464,"ٱلْعَذَابُ","the punishment","قَبْلِ أَن يَأْتِيَكُمُ","بَغْتَةًۭ وَأَنت