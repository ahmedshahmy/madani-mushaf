[["3:45:11",55,"ٱلْمَسِيحُ","(is) the Messiah","بِكَلِمَةٍۢ مِّنْهُ ٱسْمُهُ","عِيسَى ٱبْنُ مَرْيَمَ",790],["4:157:4",103,"ٱلْمَسِيحَ","the Messiah","وَقَوْلِهِمْ إِنَّا قَتَلْنَا","عِيسَى ٱبْنَ مَرْيَمَ",790],["4:171:14",105,"ٱلْمَسِيحُ","the Messiah","إِلَّا ٱلْحَقَّ ۚ إِنَّمَا","عِيسَى ٱبْنُ مَرْيَمَ",790],["4:172:3",105,"ٱلْمَسِيحُ","the Messiah","لَّن يَسْتَنكِفَ","أَن يَكُونَ عَبْدًۭا",790],["5:17:8",110,"ٱلْمَسِيحُ","(is) the Messiah","إِنَّ ٱللَّهَ هُوَ","ٱبْنُ مَرْيَمَ ۚ قُلْ",790],["5:17:21",110,"ٱلْمَسِيحَ","the Messiah","أَرَادَ أَن يُهْلِكَ","ٱبْنَ مَرْيَمَ وَأُمَّهُۥ",790],["5:72:8",120,"ٱلْمَسِيحُ","(is) the Messiah","إِنَّ ٱللَّهَ هُوَ","ٱبْنُ مَرْيَمَ ۖ وَقَالَ",790],["5:72:12",120,"ٱلْمَسِيحُ","the Messiah","ٱبْنُ مَرْيَمَ ۖ وَقَالَ","يَـٰبَنِىٓ إِسْرَٰٓءِيلَ ٱعْبُدُوا۟",790],["5:75:2",120,"ٱلْمَسِيحُ","(is) the Messiah","مَّا","ٱبْنُ مَرْيَمَ إِلَّا",790],["9:30:8",191,"ٱلْمَسِيحُ","Messiah","ٱللَّهِ وَقَالَتِ ٱلنَّصَـٰرَى","ٱبْنُ ٱللَّهِ ۖ ذَٰلِكَ",790],["9:31:8",191,"وَٱلْمَسِيحَ","and the Messiah","مِّن دُونِ ٱللَّهِ","ٱبْنَ مَرْيَمَ وَمَآ",790]]