[["17:32:3",285,"ٱلزِّنَىٰٓ ۖ","adultery","وَلَا تَقْرَبُوا۟","إِنَّهُۥ كَانَ فَـٰحِشَةًۭ",4776],["24:2:1",350,"ٱلزَّانِيَةُ","The fornicatress","","وَٱلزَّانِى فَٱجْلِدُوا۟ كُلَّ",2090],["24:2:2",350,"وَٱلزَّانِى","and the fornicator","ٱلزَّانِيَةُ","فَٱجْلِدُوا۟ كُلَّ وَٰحِدٍۢ",2089],["24:3:1",350,"ٱلزَّانِى","The fornicator","","لَا يَنكِحُ إِلَّا",2089],["24:3:5",350,"زَانِيَةً","a fornicatress","لَا يَنكِحُ إِلَّا","أَوْ مُشْرِكَةًۭ وَٱلزَّانِيَةُ",2090],["24:3:8",350,"وَٱلزَّانِيَةُ","and the fornicatress","زَانِيَةً أَوْ مُشْرِكَةًۭ","لَا يَنكِحُهَآ إِلَّا",2090],["24:3:12",350,"زَانٍ","a fornicator","لَا يَنكِحُهَآ إِلَّا","أَوْ مُشْرِكٌۭ ۚ وَحُرِّمَ",2089],["25:68:17",366,"يَزْنُونَ ۚ","commit unlawful sexual intercourse","إِلَّا بِٱلْحَقِّ وَلَا","وَمَن يَفْعَلْ ذَٰلِكَ",2793],["60:12:16",551,"يَزْنِينَ","they will commit adultery","وَلَا يَسْرِقْنَ وَلَا","وَلَا يَقْتُلْنَ أَوْلَـٰدَهُنَّ",2793]]