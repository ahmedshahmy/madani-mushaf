[["2:86:8",13,"يُخَفَّفُ","will be lightened","ٱلدُّنْيَا بِٱلْـَٔاخِرَةِ ۖ فَلَا","عَنْهُمُ ٱلْعَذَابُ وَلَا",1009],["2:162:4",24,"يُخَفَّفُ","will be lightened","خَـٰلِدِينَ فِيهَا ۖ لَا","عَنْهُمُ ٱلْعَذَابُ وَلَا",1009],["2:178:27",27,"تَخْفِيفٌۭ","a concession","إِلَيْهِ بِإِحْسَـٰنٍۢ ۗ ذَٰلِكَ","مِّن رَّبِّكُمْ وَرَحْمَةٌۭ ۗ",4438],["3:88:4",61,"يُخَفَّفُ","will be lightened","خَـٰلِدِينَ فِيهَا لَا","عَنْهُمُ ٱلْعَذَابُ وَلَا",1009],["4:28:4",83,"يُخَفِّفَ","lighten","يُرِيدُ ٱللَّهُ أَن","عَنكُمْ ۚ وَخُلِقَ ٱلْإِنسَـٰنُ",1009],["7:9:2",151,"خَفَّتْ","(will be) light","وَمَنْ","مَوَٰزِينُهُۥ فَأُو۟لَـٰٓئِكَ ٱلَّذِينَ",2040],["7:189:16",175,"خَفِيفًۭا","light","تَغَشَّىٰهَا حَمَلَتْ حَمْلًا","فَمَرَّتْ بِهِۦ ۖ فَلَمَّآ",2736],["8:66:2",185,"خَفَّفَ","has (been) lightened","ٱلْـَٔـٰنَ","ٱللَّهُ عَنكُمْ وَعَلِمَ",1009],["9:41:2",194,"خِفَافًۭا","light","ٱنفِرُوا۟","وَثِقَالًۭا وَجَـٰهِدُوا۟ بِأَمْوَٰلِكُمْ",2736],["16:80:13",276,"تَسْتَخِفُّونَهَا","which you find light","جُلُودِ ٱلْأَنْعَـٰمِ بُيُوتًۭا","يَوْمَ ظَعْنِكُمْ وَيَوْمَ",2110],["16:85:7",276,"يُخَفَّفُ","it will be lightened","ظَلَمُوا۟ ٱلْعَذَابَ فَلَا","عَنْهُمْ وَلَا هُمْ",1009],["23:103:2",348,"خَفَّتْ","(are) light","وَمَنْ","مَوَٰزِينُهُۥ فَأُو۟لَـٰٓئِكَ ٱلَّذِينَ",2040],["30:60:7",410,"يَسْتَخِفَّنَّكَ","take you in light estimation","ٱللَّهِ حَقٌّۭ ۖ وَلَا","ٱلَّذِينَ لَا يُوقِنُونَ",2110],["35:36:11",438,"يُخَفَّفُ","will be lightened","عَلَيْهِمْ فَيَمُوتُوا۟ وَلَا","عَنْهُم مِّنْ عَذَابِهَا ۚ",1009],["40:49:9",472,"يُخَفِّفْ","(to) lighten","جَهَنَّمَ ٱدْعُوا۟ رَبَّكُمْ","عَنَّا يَوْمًۭا مِّنَ",1009],["43:54:1",493,"فَٱسْتَخَفَّ","So he bluffed","","قَوْمَهُۥ فَأَطَاعُوهُ ۚ إِنَّهُمْ",2110],["101:8:3",600,"خَفَّتْ","(are) light","وَأَمَّا مَنْ","مَوَٰزِينُهُۥ",2040]]