[["4:24:21",82,"مُسَـٰفِحِينَ ۚ","(to be) lustful","بِأَمْوَٰلِكُم مُّحْصِنِينَ غَيْرَ","فَمَا ٱسْتَمْتَعْتُم بِهِۦ",2502],["4:25:31",82,"مُسَـٰفِحَـٰتٍۢ","those who commit immorality","بِٱلْمَعْرُوفِ مُحْصَنَـٰتٍ غَيْرَ","وَلَا مُتَّخِذَٰتِ أَخْدَانٍۢ ۚ",3848],["5:5:29",107,"مُسَـٰفِحِينَ","being lewd","أُجُورَهُنَّ مُحْصِنِينَ غَيْرَ","وَلَا مُتَّخِذِىٓ أَخْدَانٍۢ ۗ",2502],["6:145:18",147,"مَّسْفُوحًا","poured forth","مَيْتَةً أَوْ دَمًۭا","أَوْ لَحْمَ خِنزِيرٍۢ",3932]]