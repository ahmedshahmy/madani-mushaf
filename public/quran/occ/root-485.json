[["3:101:11",63,"يَعْتَصِم","holds firmly","وَفِيكُمْ رَسُولُهُۥ ۗ وَمَن","بِٱللَّهِ فَقَدْ هُدِىَ",1440],["3:103:1",63,"وَٱعْتَصِمُوا۟","And hold firmly","","بِحَبْلِ ٱللَّهِ جَمِيعًۭا",1440],["4:146:5",101,"وَٱعْتَصَمُوا۟","and hold fast","ٱلَّذِينَ تَابُوا۟ وَأَصْلَحُوا۟","بِٱللَّهِ وَأَخْلَصُوا۟ دِينَهُمْ",1440],["4:175:5",105,"وَٱعْتَصَمُوا۟","and held fast","ٱلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ","بِهِۦ فَسَيُدْخِلُهُمْ فِى",1440],["5:67:16",119,"يَعْصِمُكَ","will protect you","بَلَّغْتَ رِسَالَتَهُۥ ۚ وَٱللَّهُ","مِنَ ٱلنَّاسِ ۗ إِنَّ",2048],["10:27:14",212,"عَاصِمٍۢ ۖ","defender","مِّنَ ٱللَّهِ مِنْ","كَأَنَّمَآ أُغْشِيَتْ وُجُوهُهُمْ",1761],["11:43:5",226,"يَعْصِمُنِى","(that) will save me","سَـَٔاوِىٓ إِلَىٰ جَبَلٍۢ","مِنَ ٱلْمَآءِ ۚ قَالَ",2048],["11:43:10",226,"عَاصِمَ","protector","ٱلْمَآءِ ۚ قَالَ لَا","ٱلْيَوْمَ مِنْ أَمْرِ",1761],["12:32:10",239,"فَٱسْتَعْصَمَ ۖ","but he saved himself","رَٰوَدتُّهُۥ عَن نَّفْسِهِۦ","وَلَئِن لَّمْ يَفْعَلْ",4826],["22:78:37",341,"وَٱعْتَصِمُوا۟","and hold fast","ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ","بِٱللَّهِ هُوَ مَوْلَىٰكُمْ ۖ",1440],["33:17:5",420,"يَعْصِمُكُم","(can) protect you","مَن ذَا ٱلَّذِى","مِّنَ ٱللَّهِ إِنْ",2048],["40:33:9",470,"عَاصِمٍۢ ۗ","protector","مِّنَ ٱللَّهِ مِنْ","وَمَن يُضْلِلِ ٱللَّهُ",1761],["60:10:40",550,"بِعِصَمِ","to marriage bonds","أُجُورَهُنَّ ۚ وَلَا تُمْسِكُوا۟","ٱلْكَوَافِرِ وَسْـَٔلُوا۟ مَآ",3137]]