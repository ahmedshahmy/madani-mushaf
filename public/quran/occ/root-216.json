[["2:44:4",7,"وَتَنسَوْنَ","and you forget","۞ أَتَأْمُرُونَ ٱلنَّاسَ بِٱلْبِرِّ","أَنفُسَكُمْ وَأَنتُمْ تَتْلُونَ",333],["2:106:6",17,"نُنسِهَا","[We] cause it to be forgotten","مِنْ ءَايَةٍ أَوْ","نَأْتِ بِخَيْرٍۢ مِّنْهَآ",1038],["2:237:28",38,"تَنسَوُا۟","forget","أَقْرَبُ لِلتَّقْوَىٰ ۚ وَلَا","ٱلْفَضْلَ بَيْنَكُمْ ۚ إِنَّ",333],["2:286:17",49,"نَّسِينَآ","we forget","لَا تُؤَاخِذْنَآ إِن","أَوْ أَخْطَأْنَا ۚ رَبَّنَا",333],["5:13:12",109,"وَنَسُوا۟","and forgot","ٱلْكَلِمَ عَن مَّوَاضِعِهِۦ ۙ","حَظًّۭا مِّمَّا ذُكِّرُوا۟",333],["5:14:8",110,"فَنَسُوا۟","but they forgot","نَصَـٰرَىٰٓ أَخَذْنَا مِيثَـٰقَهُمْ","حَظًّۭا مِّمَّا ذُكِّرُوا۟",333],["6:41:10",132,"وَتَنسَوْنَ","and you will forget","إِلَيْهِ إِن شَآءَ","مَا تُشْرِكُونَ",333],["6:44:2",132,"نَسُوا۟","they forgot","فَلَمَّا","مَا ذُكِّرُوا۟ بِهِۦ",333],["6:68:15",135,"يُنسِيَنَّكَ","causes you to forget","حَدِيثٍ غَيْرِهِۦ ۚ وَإِمَّا","ٱلشَّيْطَـٰنُ فَلَا تَقْعُدْ",1038],["7:51:10",156,"نَنسَىٰهُمْ","We forget them","ٱلْحَيَوٰةُ ٱلدُّنْيَا ۚ فَٱلْيَوْمَ","كَمَا نَسُوا۟ لِقَآءَ",333],["7:51:12",156,"نَسُوا۟","they forgot","فَٱلْيَوْمَ نَنسَىٰهُمْ كَمَا","لِقَآءَ يَوْمِهِمْ هَـٰذَا",333],["7:53:10",157,"نَسُوهُ","had forgotten it","تَأْوِيلُهُۥ يَقُولُ ٱلَّذِينَ","مِن قَبْلُ قَدْ",333],["7:165:2",172,"نَسُوا۟","they forgot","فَلَمَّا","مَا ذُكِّرُوا۟ بِهِۦٓ",333],["9:67:13",197,"نَسُوا۟","They forget","ٱلْمَعْرُوفِ وَيَقْبِضُونَ أَيْدِيَهُمْ ۚ","ٱللَّهَ فَنَسِيَهُمْ ۗ إِنَّ",333],["9:67:15",197,"فَنَسِيَهُمْ ۗ","so He has forgotten them","أَيْدِيَهُمْ ۚ نَسُوا۟ ٱللَّهَ","إِنَّ ٱلْمُنَـٰفِقِينَ هُمُ",333],["12:42:10",240,"فَأَنسَىٰهُ","But made him forget","ٱذْكُرْنِى عِندَ رَبِّكَ","ٱلشَّيْطَـٰنُ ذِكْرَ رَبِّهِۦ",1038],["18:24:8",296,"نَسِيتَ","you forget","وَٱذْكُر رَّبَّكَ إِذَا","وَقُلْ عَسَىٰٓ أَن",333],["18:57:9",300,"وَنَسِىَ","and forgets","رَبِّهِۦ فَأَعْرَضَ عَنْهَا","مَا قَدَّمَتْ يَدَاهُ ۚ",333],["18:61:5",300,"نَسِيَا","they forgot","بَلَغَا مَجْمَعَ بَيْنِهِمَا","حُوتَهُمَا فَٱتَّخَذَ سَبِيلَهُۥ",333],["18:63:8",301,"نَسِيتُ","[I] forgot","إِلَى ٱلصَّخْرَةِ فَإِنِّى","ٱلْحُوتَ وَمَآ أَنسَىٰنِيهُ",333],["18:63:11",301,"أَنسَىٰنِيهُ","made me forget it","نَسِيتُ ٱلْحُوتَ وَمَآ","إِلَّا ٱلشَّيْطَـٰنُ أَنْ",1038],["18:73:5",301,"نَسِيتُ","I forgot","لَا تُؤَاخِذْنِى بِمَا","وَلَا تُرْهِقْنِى مِنْ",333],["19:23:12",306,"نَسْيًۭا","(in) oblivion","قَبْلَ هَـٰذَا وَكُنتُ","مَّنسِيًّۭا",4051],["19:23:13",306,"مَّنسِيًّۭا","forgotten","هَـٰذَا وَكُنتُ نَسْيًۭا","",3919],["19:64:18",309,"نَسِيًّۭا","forgetful","وَمَا كَانَ رَبُّكَ","",4046],["20:52:11",315,"يَنسَى","forgets","يَضِلُّ رَبِّى وَلَا","",333],["20:88:12",318,"فَنَسِىَ","but he forgot","إِلَـٰهُكُمْ وَإِلَـٰهُ مُوسَىٰ","",333],["20:115:7",320,"فَنَسِىَ","but he forgot","ءَادَمَ مِن قَبْلُ","وَلَمْ نَجِدْ لَهُۥ",333],["20:126:5",321,"فَنَسِيتَهَا ۖ","but you forgot them","كَذَٰلِكَ أَتَتْكَ ءَايَـٰتُنَا","وَكَذَٰلِكَ ٱلْيَوْمَ تُنسَىٰ",333],["20:126:8",321,"تُنسَىٰ","you will be forgotten","فَنَسِيتَهَا ۖ وَكَذَٰلِكَ ٱلْيَوْمَ","",333],["23:110:4",349,"أَنسَوْكُمْ","they made you forget","فَٱتَّخَذْتُمُوهُمْ سِخْرِيًّا حَتَّىٰٓ","ذِكْرِى وَكُنتُم مِّنْهُمْ",1038],["25:18:17",361,"نَسُوا۟","they forgot","مَّتَّعْتَهُمْ وَءَابَآءَهُمْ حَتَّىٰ","ٱلذِّكْرَ وَكَانُوا۟ قَوْمًۢا",333],["28:77:8",394,"تَنسَ","forget","ٱلدَّارَ ٱلْـَٔاخِرَةَ ۖ وَلَا","نَصِيبَكَ مِنَ ٱلدُّنْيَا ۖ",333],["32:14:3",416,"نَسِيتُمْ","you forgot","فَذُوقُوا۟ بِمَا","لِقَآءَ يَوْمِكُمْ هَـٰذَآ",333],["32:14:8",416,"نَسِينَـٰكُمْ ۖ","have forgotten you","يَوْمِكُمْ هَـٰذَآ إِنَّا","وَذُوقُوا۟ عَذَابَ ٱلْخُلْدِ",333],["36:78:4",445,"وَنَسِىَ","and forgets","وَضَرَبَ لَنَا مَثَلًۭا","خَلْقَهُۥ ۖ قَالَ مَن",333],["38:26:28",454,"نَسُوا۟","they forgot","عَذَابٌۭ شَدِيدٌۢ بِمَا","يَوْمَ ٱلْحِسَابِ",333],["39:8:14",459,"نَسِىَ","he forgets","خَوَّلَهُۥ نِعْمَةًۭ مِّنْهُ","مَا كَانَ يَدْعُوٓا۟",333],["45:34:3",502,"نَنسَىٰكُمْ","We forget you","وَقِيلَ ٱلْيَوْمَ","كَمَا نَسِيتُمْ لِقَآءَ",333],["45:34:5",502,"نَسِيتُمْ","you forgot","ٱلْيَوْمَ نَنسَىٰكُمْ كَمَا","لِقَآءَ يَوْمِكُمْ هَـٰذَا",333],["58:6:10",542,"وَنَسُوهُ ۚ","while they forgot it","عَمِلُوٓا۟ ۚ أَحْصَىٰهُ ٱللَّهُ","وَٱللَّهُ عَلَىٰ كُلِّ",333],["58:19:4",544,"فَأَنسَىٰهُمْ","so he made them forget","ٱسْتَحْوَذَ عَلَيْهِمُ ٱلشَّيْطَـٰنُ","ذِكْرَ ٱللَّهِ ۚ أُو۟لَـٰٓئِكَ",1038],["59:19:4",548,"نَسُوا۟","forgot","وَلَا تَكُونُوا۟ كَٱلَّذِينَ","ٱللَّهَ فَأَنسَىٰهُمْ أَنفُسَهُمْ ۚ",333],["59:19:6",548,"فَأَنسَىٰهُمْ","so He made them forget","كَٱلَّذِينَ نَسُوا۟ ٱللَّهَ","أَنفُسَهُمْ ۚ أُو۟لَـٰٓئِكَ هُمُ",1038],["87:6:3",591,"تَنسَىٰٓ","you will forget","سَنُقْرِئُكَ فَلَا","",333]]