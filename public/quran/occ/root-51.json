[["2:7:6",3,"سَمْعِهِمْ ۖ","their hearing","عَلَىٰ قُلُوبِهِمْ وَعَلَىٰ","وَعَلَىٰٓ أَبْصَـٰرِهِمْ غِشَـٰوَةٌۭ ۖ",475],["2:20:18",4,"بِسَمْعِهِمْ","their hearing","شَآءَ ٱللَّهُ لَذَهَبَ","وَأَبْصَـٰرِهِمْ ۚ إِنَّ ٱللَّهَ",475],["2:75:9",11,"يَسْمَعُونَ","(who used to) hear","كَانَ فَرِيقٌۭ مِّنْهُمْ","كَلَـٰمَ ٱللَّهِ ثُمَّ",144],["2:93:11",14,"وَٱسْمَعُوا۟ ۖ","and listen","مَآ ءَاتَيْنَـٰكُم بِقُوَّةٍۢ","قَالُوا۟ سَمِعْنَا وَعَصَيْنَا",144],["2:93:13",14,"سَمِعْنَا","We heard","بِقُوَّةٍۢ وَٱسْمَعُوا۟ ۖ قَالُوا۟","وَعَصَيْنَا وَأُشْرِبُوا۟ فِى",144],["2:104:9",16,"وَٱسْمَعُوا۟ ۗ","and listen","رَٰعِنَا وَقُولُوا۟ ٱنظُرْنَا","وَلِلْكَـٰفِرِينَ عَذَابٌ أَلِيمٌۭ",144],["2:127:13",20,"ٱلسَّمِيعُ","the All-Hearing","مِنَّآ ۖ إِنَّكَ أَنتَ","ٱلْعَلِيمُ",252],["2:137:18",21,"ٱلسَّمِيعُ","(is) the All-Hearing","فَسَيَكْفِيكَهُمُ ٱللَّهُ ۚ وَهُوَ","ٱلْعَلِيمُ",252],["2:171:9",26,"يَسْمَعُ","(does) hear","يَنْعِقُ بِمَا لَا","إِلَّا دُعَآءًۭ وَنِدَآءًۭ ۚ",144],["2:181:4",27,"سَمِعَهُۥ","he (has) heard [it]","فَمَنۢ بَدَّلَهُۥ بَعْدَ مَا","فَإِنَّمَآ إِثْمُهُۥ عَلَى",144],["2:181:12",27,"سَمِيعٌ","(is) All-Hearing","يُبَدِّلُونَهُۥٓ ۚ إِنَّ ٱللَّهَ","عَلِيمٌۭ",252],["2:224:13",35,"سَمِيعٌ","(is) All-Hearing","بَيْنَ ٱلنَّاسِ ۗ وَٱللَّهُ","عَلِيمٌۭ",252],["2:227:6",36,"سَمِيعٌ","(is) All-Hearing","ٱلطَّلَـٰقَ فَإِنَّ ٱللَّهَ","عَلِيمٌۭ",252],["2:244:8",39,"سَمِيعٌ","(is) All-Hearing","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","عَلِيمٌۭ",252],["2:256:23",42,"سَمِيعٌ","(is) All-Hearing","ٱنفِصَامَ لَهَا ۗ وَٱللَّهُ","عَلِيمٌ",252],["2:285:22",49,"سَمِعْنَا","We heard","مِّن رُّسُلِهِۦ ۚ وَقَالُوا۟","وَأَطَعْنَا ۖ غُفْرَانَكَ رَبَّنَا",144],["3:34:6",54,"سَمِيعٌ","(is) All-Hearing","مِنۢ بَعْضٍۢ ۗ وَٱللَّهُ","عَلِيمٌ",252],["3:35:17",54,"ٱلسَّمِيعُ","(are) the All-Hearing","مِنِّىٓ ۖ إِنَّكَ أَنتَ","ٱلْعَلِيمُ",252],["3:38:14",55,"سَمِيعُ","(are) All-Hearer","ذُرِّيَّةًۭ طَيِّبَةً ۖ إِنَّكَ","ٱلدُّعَآءِ",252],["3:121:10",65,"سَمِيعٌ","(is) All-Hearing","مَقَـٰعِدَ لِلْقِتَالِ ۗ وَٱللَّهُ","عَلِيمٌ",252],["3:181:2",74,"سَمِعَ","heard","لَّقَدْ","ٱللَّهُ قَوْلَ ٱلَّذِينَ",144],["3:186:5",74,"وَلَتَسْمَعُنَّ","And you will certainly hear","فِىٓ أَمْوَٰلِكُمْ وَأَنفُسِكُمْ","مِنَ ٱلَّذِينَ أُوتُوا۟",144],["3:193:3",75,"سَمِعْنَا","[we] heard","رَّبَّنَآ إِنَّنَا","مُنَادِيًۭا يُنَادِى لِلْإِيمَـٰنِ",144],["4:46:9",86,"سَمِعْنَا","We hear[d]","عَن مَّوَاضِعِهِۦ وَيَقُولُونَ","وَعَصَيْنَا وَٱسْمَعْ غَيْرَ",144],["4:46:11",86,"وَٱسْمَعْ","and \"Hear","وَيَقُولُونَ سَمِعْنَا وَعَصَيْنَا","غَيْرَ مُسْمَعٍۢ وَرَٰعِنَا",144],["4:46:13",86,"مُسْمَعٍۢ","to be heard","وَعَصَيْنَا وَٱسْمَعْ غَيْرَ","وَرَٰعِنَا لَيًّۢا بِأَلْسِنَتِهِمْ",3852],["4:46:23",86,"سَمِعْنَا","We hear[d]","وَلَوْ أَنَّهُمْ قَالُوا۟","وَأَطَعْنَا وَٱسْمَعْ وَٱنظُرْنَا",144],["4:46:25",86,"وَٱسْمَعْ","and \"Hear","قَالُوا۟ سَمِعْنَا وَأَطَعْنَا","وَٱنظُرْنَا لَكَانَ خَيْرًۭا",144],["4:58:24",87,"سَمِيعًۢا","All-Hearing","إِنَّ ٱللَّهَ كَانَ","بَصِيرًۭا",252],["4:134:13",99,"سَمِيعًۢا","All-Hearing","وَٱلْـَٔاخِرَةِ ۚ وَكَانَ ٱللَّهُ","بَصِيرًۭا",252],["4:140:8",100,"سَمِعْتُمْ","you hear","ٱلْكِتَـٰبِ أَنْ إِذَا","ءَايَـٰتِ ٱللَّهِ يُكْفَرُ",144],["4:148:13",102,"سَمِيعًا","All-Hearing","ظُلِمَ ۚ وَكَانَ ٱللَّهُ","عَلِيمًا",252],["5:7:11",108,"سَمِعْنَا","We heard","بِهِۦٓ إِذْ قُلْتُمْ","وَأَطَعْنَا ۖ وَٱتَّقُوا۟ ٱللَّهَ ۚ",144],["5:41:20",114,"سَمَّـٰعُونَ","They (are) listeners","وَمِنَ ٱلَّذِينَ هَادُوا۟ ۛ","لِلْكَذِبِ سَمَّـٰعُونَ لِقَوْمٍ",1637],["5:41:22",114,"سَمَّـٰعُونَ","(and) listeners","هَادُوا۟ ۛ سَمَّـٰعُونَ لِلْكَذِبِ","لِقَوْمٍ ءَاخَرِينَ لَمْ",1637],["5:42:1",115,"سَمَّـٰعُونَ","Listeners","","لِلْكَذِبِ أَكَّـٰلُونَ لِلسُّحْتِ ۚ",1637],["5:76:15",120,"ٱلسَّمِيعُ","(is) the All-Hearing","نَفْعًۭا ۚ وَٱللَّهُ هُوَ","ٱلْعَلِيمُ",252],["5:83:2",121,"سَمِعُوا۟","they listen","وَإِذَا","مَآ أُنزِلَ إِلَى",144],["5:108:17",125,"وَٱسْمَعُوا۟ ۗ","and listen","أَيْمَـٰنِهِمْ ۗ وَٱتَّقُوا۟ ٱللَّهَ","وَٱللَّهُ لَا يَهْدِى",144],["6:13:8",129,"ٱلسَّمِيعُ","(is) All-Hearing","ٱلَّيْلِ وَٱلنَّهَارِ ۚ وَهُوَ","ٱلْعَلِيمُ",252],["6:25:3",130,"يَسْتَمِعُ","listen","وَمِنْهُم مَّن","إِلَيْكَ ۖ وَجَعَلْنَا عَلَىٰ",611],["6:36:4",132,"يَسْمَعُونَ ۘ","listen","۞ إِنَّمَا يَسْتَجِيبُ ٱلَّذِينَ","وَٱلْمَوْتَىٰ يَبْعَثُهُمُ ٱللَّهُ",144],["6:46:6",133,"سَمْعَكُمْ","your hearing","إِنْ أَخَذَ ٱللَّهُ","وَأَبْصَـٰرَكُمْ وَخَتَمَ عَلَىٰ",475],["6:115:10",142,"ٱلسَّمِيعُ","(is) the All-Hearer","مُبَدِّلَ لِكَلِمَـٰتِهِۦ ۚ وَهُوَ","ٱلْعَلِيمُ",252],["7:100:19",163,"يَسْمَعُونَ","hear","قُلُوبِهِمْ فَهُمْ لَا","",144],["7:179:21",174,"يَسْمَعُونَ","they hear","وَلَهُمْ ءَاذَانٌۭ لَّا","بِهَآ ۚ أُو۟لَـٰٓئِكَ كَٱلْأَنْعَـٰمِ",144],["7:195:18",175,"يَسْمَعُونَ","(to) hear","أَمْ لَهُمْ ءَاذَانٌۭ","بِهَا ۗ قُلِ ٱدْعُوا۟",144],["7:198:6",176,"يَسْمَعُوا۟ ۖ","do they not","إِلَى ٱلْهُدَىٰ لَا","وَتَرَىٰهُمْ يَنظُرُونَ إِلَيْكَ",144],["7:200:9",176,"سَمِيعٌ","(is) All-Hearing","فَٱسْتَعِذْ بِٱللَّهِ ۚ إِنَّهُۥ","عَلِيمٌ",252],["7:204:4",176,"فَٱسْتَمِعُوا۟","then listen","وَإِذَا قُرِئَ ٱلْقُرْءَانُ","لَهُۥ وَأَنصِتُوا۟ لَعَلَّكُمْ",611],["8:17:20",179,"سَمِيعٌ","(is) All-Hearing","حَسَنًا ۚ إِنَّ ٱللَّهَ","عَلِيمٌۭ",252],["8:20:11",179,"تَسْمَعُونَ","hear","تَوَلَّوْا۟ عَنْهُ وَأَنتُمْ","",144],["8:21:5",179,"سَمِعْنَا","We heard","تَكُونُوا۟ كَٱلَّذِينَ قَالُوا۟","وَهُمْ لَا يَسْمَعُونَ",144],["8:21:8",179,"يَسْمَعُونَ","hear","سَمِعْنَا وَهُمْ لَا","",144],["8:23:6",179,"لَّأَسْمَعَهُمْ ۖ","surely, He (would) have made them hear","ٱللَّهُ فِيهِمْ خَيْرًۭا","وَلَوْ أَسْمَعَهُمْ لَتَوَلَّوا۟",679],["8:23:8",179,"أَسْمَعَهُمْ","He had made them hear","خَيْرًۭا لَّأَسْمَعَهُمْ ۖ وَلَوْ","لَتَوَلَّوا۟ وَّهُم مُّعْرِضُونَ",679],["8:31:7",180,"سَمِعْنَا","we have heard","ءَايَـٰتُنَا قَالُوا۟ قَدْ","لَوْ نَشَآءُ لَقُلْنَا",144],["8:42:34",182,"لَسَمِيعٌ","(is) All-Hearing","بَيِّنَةٍۢ ۗ وَإِنَّ ٱللَّهَ","عَلِيمٌ",252],["8:53:17",184,"سَمِيعٌ","(is) All-Hearing","بِأَنفُسِهِمْ ۙ وَأَنَّ ٱللَّهَ","عَلِيمٌۭ",252],["8:61:11",184,"ٱلسَّمِيعُ","(is) All-Hearer","ٱللَّهِ ۚ إِنَّهُۥ هُوَ","ٱلْعَلِيمُ",252],["9:6:8",187,"يَسْمَعَ","he hears","ٱسْتَجَارَكَ فَأَجِرْهُ حَتَّىٰ","كَلَـٰمَ ٱللَّهِ ثُمَّ",144],["9:47:13",194,"سَمَّـٰعُونَ","who would have listened","يَبْغُونَكُمُ ٱلْفِتْنَةَ وَفِيكُمْ","لَهُمْ ۗ وَٱللَّهُ عَلِيمٌۢ",1637],["9:98:15",202,"سَمِيعٌ","(is) All-Hearer","دَآئِرَةُ ٱلسَّوْءِ ۗ وَٱللَّهُ","عَلِيمٌۭ",252],["9:103:15",203,"سَمِيعٌ","(is) All-Hearer","سَكَنٌۭ لَّهُمْ ۗ وَٱللَّهُ","عَلِيمٌ",252],["10:31:9",212,"ٱلسَّمْعَ","the hearing","وَٱلْأَرْضِ أَمَّن يَمْلِكُ","وَٱلْأَبْصَـٰرَ وَمَن يُخْرِجُ",475],["10:42:3",213,"يَسْتَمِعُونَ","listen","وَمِنْهُم مَّن","إِلَيْكَ ۚ أَفَأَنتَ تُسْمِعُ",611],["10:42:6",213,"تُسْمِعُ","cause the deaf to hear","يَسْتَمِعُونَ إِلَيْكَ ۚ أَفَأَنتَ","ٱلصُّمَّ وَلَوْ كَانُوا۟",679],["10:65:9",216,"ٱلسَّمِيعُ","(is) the All-Hearer","لِلَّهِ جَمِيعًا ۚ هُوَ","ٱلْعَلِيمُ",252],["10:67:15",216,"يَسْمَعُونَ","(who) listen","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ","",144],["11:20:21",224,"ٱلسَّمْعَ","(to) hear","مَا كَانُوا۟ يَسْتَطِيعُونَ","وَمَا كَانُوا۟ يُبْصِرُونَ",475],["11:24:6",224,"وَٱلسَّمِيعِ ۚ","and the hearer","كَٱلْأَعْمَىٰ وَٱلْأَصَمِّ وَٱلْبَصِيرِ","هَلْ يَسْتَوِيَانِ مَثَلًا ۚ",252],["12:31:2",239,"سَمِعَتْ","she heard","فَلَمَّا","بِمَكْرِهِنَّ أَرْسَلَتْ إِلَيْهِنَّ",144],["12:34:9",239,"ٱلسَّمِيعُ","(is) All-Hearer","كَيْدَهُنَّ ۚ إِنَّهُۥ هُوَ","ٱلْعَلِيمُ",252],["14:39:12",260,"لَسَمِيعُ","(is) All-Hearer","وَإِسْحَـٰقَ ۚ إِنَّ رَبِّى","ٱلدُّعَآءِ",252],["15:18:4",263,"ٱلسَّمْعَ","the hearing","إِلَّا مَنِ ٱسْتَرَقَ","فَأَتْبَعَهُۥ شِهَابٌۭ مُّبِينٌۭ",475],["16:65:16",274,"يَسْمَعُونَ","who listen","ذَٰلِكَ لَـَٔايَةًۭ لِّقَوْمٍۢ","",144],["16:78:11",275,"ٱلسَّمْعَ","the hearing","شَيْـًۭٔا وَجَعَلَ لَكُمُ","وَٱلْأَبْصَـٰرَ وَٱلْأَفْـِٔدَةَ ۙ لَعَلَّكُمْ",475],["16:108:7",279,"وَسَمْعِهِمْ","and their hearing","ٱللَّهُ عَلَىٰ قُلُوبِهِمْ","وَأَبْصَـٰرِهِمْ ۖ وَأُو۟لَـٰٓئِكَ هُمُ",475],["17:1:20",282,"ٱلسَّمِيعُ","(is) the All-Hearer","ءَايَـٰتِنَآ ۚ إِنَّهُۥ هُوَ","ٱلْبَصِيرُ",252],["17:36:9",285,"ٱلسَّمْعَ","the hearing","بِهِۦ عِلْمٌ ۚ إِنَّ","وَٱلْبَصَرَ وَٱلْفُؤَادَ كُلُّ",475],["17:47:4",286,"يَسْتَمِعُونَ","they listen","نَّحْنُ أَعْلَمُ بِمَا","بِهِۦٓ إِذْ يَسْتَمِعُونَ",611],["17:47:7",286,"يَسْتَمِعُونَ","they listen","يَسْتَمِعُونَ بِهِۦٓ إِذْ","إِلَيْكَ وَإِذْ هُمْ",611],["18:26:12",296,"وَأَسْمِعْ ۚ","And how clearly He hears","وَٱلْأَرْضِ ۖ أَبْصِرْ بِهِۦ","مَا لَهُم مِّن",679],["18:101:11",304,"سَمْعًا","(to) hear","وَكَانُوا۟ لَا يَسْتَطِيعُونَ","",475],["19:38:1",307,"أَسْمِعْ","How they will hear","","بِهِمْ وَأَبْصِرْ يَوْمَ",679],["19:42:9",308,"يَسْمَعُ","hears","تَعْبُدُ مَا لَا","وَلَا يُبْصِرُ وَلَا",144],["19:62:2",309,"يَسْمَعُونَ","they will hear","لَّا","فِيهَا لَغْوًا إِلَّا",144],["19:98:12",312,"تَسْمَعُ","hear","مِّنْ أَحَدٍ أَوْ","لَهُمْ رِكْزًۢا",144],["20:13:3",313,"فَٱسْتَمِعْ","so listen","وَأَنَا ٱخْتَرْتُكَ","لِمَا يُوحَىٰٓ",611],["20:46:6",314,"أَسْمَعُ","I hear","تَخَافَآ ۖ إِنَّنِى مَعَكُمَآ","وَأَرَىٰ",144],["20:108:11",319,"تَسْمَعُ","you will hear","ٱلْأَصْوَاتُ لِلرَّحْمَـٰنِ فَلَا","إِلَّا هَمْسًۭا",144],["21:2:9",322,"ٱسْتَمَعُوهُ","they listen to it","رَّبِّهِم مُّحْدَثٍ إِلَّا","وَهُمْ يَلْعَبُونَ",611],["21:4:9",322,"ٱلسَّمِيعُ","(is) the All-Hearer","ٱلسَّمَآءِ وَٱلْأَرْضِ ۖ وَهُوَ","ٱلْعَلِيمُ",252],["21:45:6",326,"يَسْمَعُ","hear","أُنذِرُكُم بِٱلْوَحْىِ ۚ وَلَا","ٱلصُّمُّ ٱلدُّعَآءَ إِذَا",144],["21:60:2",327,"سَمِعْنَا","We heard","قَالُوا۟","فَتًۭى يَذْكُرُهُمْ يُقَالُ",144],["21:100:7",330,"يَسْمَعُونَ","will hear","وَهُمْ فِيهَا لَا","",144],["21:102:2",331,"يَسْمَعُونَ","they will hear","لَا","حَسِيسَهَا ۖ وَهُمْ فِى",144],["22:46:12",337,"يَسْمَعُونَ","(to) hear","بِهَآ أَوْ ءَاذَانٌۭ","بِهَا ۖ فَإِنَّهَا لَا",144],["22:61:14",339,"سَمِيعٌۢ","(is) All-Hearer","ٱلَّيْلِ وَأَنَّ ٱللَّهَ","بَصِيرٌۭ",252],["22:73:5",341,"فَٱسْتَمِعُوا۟","so listen","ٱلنَّاسُ ضُرِبَ مَثَلٌۭ","لَهُۥٓ ۚ إِنَّ ٱلَّذِينَ",611],["22:75:10",341,"سَمِيعٌۢ","(is) All-Hearer","ٱلنَّاسِ ۚ إِنَّ ٱللَّهَ","بَصِيرٌۭ",252],["23:24:22",343,"سَمِعْنَا","we heard","لَأَنزَلَ مَلَـٰٓئِكَةًۭ مَّا","بِهَـٰذَا فِىٓ ءَابَآئِنَا",144],["23:78:5",347,"ٱلسَّمْعَ","the hearing","ٱلَّذِىٓ أَنشَأَ لَكُمُ","وَٱلْأَبْصَـٰرَ وَٱلْأَفْـِٔدَةَ ۚ قَلِيلًۭا",475],["24:12:3",351,"سَمِعْتُمُوهُ","you heard it","لَّوْلَآ إِذْ","ظَنَّ ٱلْمُؤْمِنُونَ وَٱلْمُؤْمِنَـٰتُ",144],["24:16:3",351,"سَمِعْتُمُوهُ","you heard it","وَلَوْلَآ إِذْ","قُلْتُم مَّا يَكُونُ",144],["24:21:33",352,"سَمِيعٌ","(is) All-Hearer","مَن يَشَآءُ ۗ وَٱللَّهُ","عَلِيمٌۭ",252],["24:51:14",356,"سَمِعْنَا","We hear","بَيْنَهُمْ أَن يَقُولُوا۟","وَأَطَعْنَا ۚ وَأُو۟لَـٰٓئِكَ هُمُ",144],["24:60:22",358,"سَمِيعٌ","(is) All-Hearer","خَيْرٌۭ لَّهُنَّ ۗ وَٱللَّهُ","عَلِيمٌۭ",252],["25:12:6",361,"سَمِعُوا۟","they will hear","مِّن مَّكَانٍۭ بَعِيدٍۢ","لَهَا تَغَيُّظًۭا وَزَفِيرًۭا",144],["25:44:5",364,"يَسْمَعُونَ","hear","تَحْسَبُ أَنَّ أَكْثَرَهُمْ","أَوْ يَعْقِلُونَ ۚ إِنْ",144],["26:15:7",367,"مُّسْتَمِعُونَ","listening","بِـَٔايَـٰتِنَآ ۖ إِنَّا مَعَكُم","",2507],["26:25:5",368,"تَسْتَمِعُونَ","you hear","لِمَنْ حَوْلَهُۥٓ أَلَا","",611],["26:72:3",370,"يَسْمَعُونَكُمْ","they hear you","قَالَ هَلْ","إِذْ تَدْعُونَ",144],["26:212:3",376,"ٱلسَّمْعِ","the hearing","إِنَّهُمْ عَنِ","لَمَعْزُولُونَ",475],["26:220:3",376,"ٱلسَّمِيعُ","(is) the All-Hearer","إِنَّهُۥ هُوَ","ٱلْعَلِيمُ",252],["26:223:2",376,"ٱلسَّمْعَ","(what is) heard","يُلْقُونَ","وَأَكْثَرُهُمْ كَـٰذِبُونَ",475],["27:80:3",384,"تُسْمِعُ","cause to hear","إِنَّكَ لَا","ٱلْمَوْتَىٰ وَلَا تُسْمِعُ",679],["27:80:6",384,"تُسْمِعُ","can you cause to hear","تُسْمِعُ ٱلْمَوْتَىٰ وَلَا","ٱلصُّمَّ ٱلدُّعَآءَ إِذَا",679],["27:81:8",384,"تُسْمِعُ","you can cause to hear","عَن ضَلَـٰلَتِهِمْ ۖ إِن","إِلَّا مَن يُؤْمِنُ",679],["28:36:13",390,"سَمِعْنَا","we heard","سِحْرٌۭ مُّفْتَرًۭى وَمَا","بِهَـٰذَا فِىٓ ءَابَآئِنَا",144],["28:55:2",392,"سَمِعُوا۟","they hear","وَإِذَا","ٱللَّغْوَ أَعْرَضُوا۟ عَنْهُ",144],["28:71:19",394,"تَسْمَعُونَ","you hear","يَأْتِيكُم بِضِيَآءٍ ۖ أَفَلَا","",144],["29:5:11",396,"ٱلسَّمِيعُ","(is) the All-Hearer","ٱللَّهِ لَـَٔاتٍۢ ۚ وَهُوَ","ٱلْعَلِيمُ",252],["29:60:11",403,"ٱلسَّمِيعُ","(is) the All-Hearer","يَرْزُقُهَا وَإِيَّاكُمْ ۚ وَهُوَ","ٱلْعَلِيمُ",252],["30:23:14",406,"يَسْمَعُونَ","who listen","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ","",144],["30:52:3",410,"تُسْمِعُ","make the dead hear","فَإِنَّكَ لَا","ٱلْمَوْتَىٰ وَلَا تُسْمِعُ",679],["30:52:6",410,"تُسْمِعُ","make the deaf hear","تُسْمِعُ ٱلْمَوْتَىٰ وَلَا","ٱلصُّمَّ ٱلدُّعَآءَ إِذَا",679],["30:53:8",410,"تُسْمِعُ","you can make hear","عَن ضَلَـٰلَتِهِمْ ۖ إِن","إِلَّا مَن يُؤْمِنُ",679],["31:7:9",411,"يَسْمَعْهَا","he (had) heard them","مُسْتَكْبِرًۭا كَأَن لَّمْ","كَأَنَّ فِىٓ أُذُنَيْهِ",144],["31:28:10",413,"سَمِيعٌۢ","(is) All-Hearer","وَٰحِدَةٍ ۗ إِنَّ ٱللَّهَ","بَصِيرٌ",252],["32:9:9",415,"ٱلسَّمْعَ","the hearing","رُّوحِهِۦ ۖ وَجَعَلَ لَكُمُ","وَٱلْأَبْصَـٰرَ وَٱلْأَفْـِٔدَةَ ۚ قَلِيلًۭا",475],["32:12:11",416,"وَسَمِعْنَا","and we have heard","رَبِّهِمْ رَبَّنَآ أَبْصَرْنَا","فَٱرْجِعْنَا نَعْمَلْ صَـٰلِحًا",144],["32:26:18",417,"يَسْمَعُونَ","they hear","ذَٰلِكَ لَـَٔايَـٰتٍ ۖ أَفَلَا","",144],["34:50:15",434,"سَمِيعٌۭ","(is) All-Hearer","إِلَىَّ رَبِّىٓ ۚ إِنَّهُۥ","قَرِيبٌۭ",252],["35:14:4",436,"يَسْمَعُوا۟","they hear","إِن تَدْعُوهُمْ لَا","دُعَآءَكُمْ وَلَوْ سَمِعُوا۟",144],["35:14:7",436,"سَمِعُوا۟","they heard","يَسْمَعُوا۟ دُعَآءَكُمْ وَلَوْ","مَا ٱسْتَجَابُوا۟ لَكُمْ ۖ",144],["35:22:8",437,"يُسْمِعُ","causes to hear","ٱلْأَمْوَٰتُ ۚ إِنَّ ٱللَّهَ","مَن يَشَآءُ ۖ وَمَآ",679],["35:22:13",437,"بِمُسْمِعٍۢ","can make hear","يَشَآءُ ۖ وَمَآ أَنتَ","مَّن فِى ٱلْقُبُورِ",3853],["36:25:4",441,"فَٱسْمَعُونِ","so listen to me","إِنِّىٓ ءَامَنتُ بِرَبِّكُمْ","",144],["37:8:2",446,"يَسَّمَّعُونَ","they may listen","لَّا","إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ",4669],["38:7:2",453,"سَمِعْنَا","we heard","مَا","بِهَـٰذَا فِى ٱلْمِلَّةِ",144],["39:18:2",460,"يَسْتَمِعُونَ","they listen (to)","ٱلَّذِينَ","ٱلْقَوْلَ فَيَتَّبِعُونَ أَحْسَنَهُۥٓ ۚ",611],["40:20:14",469,"ٱلسَّمِيعُ","(is) the All-Hearer","إِنَّ ٱللَّهَ هُوَ","ٱلْبَصِيرُ",252],["40:56:22",473,"ٱلسَّمِيعُ","(is) the All-Hearer","بِٱللَّهِ ۖ إِنَّهُۥ هُوَ","ٱلْبَصِيرُ",252],["41:4:7",477,"يَسْمَعُونَ","hear","أَكْثَرُهُمْ فَهُمْ لَا","",144],["41:20:7",478,"سَمْعُهُمْ","their hearing","جَآءُوهَا شَهِدَ عَلَيْهِمْ","وَأَبْصَـٰرُهُمْ وَجُلُودُهُم بِمَا",475],["41:22:7",479,"سَمْعُكُمْ","your hearing","أَن يَشْهَدَ عَلَيْكُمْ","وَلَآ أَبْصَـٰرُكُمْ وَلَا",475],["41:26:5",479,"تَسْمَعُوا۟","listen","ٱلَّذِينَ كَفَرُوا۟ لَا","لِهَـٰذَا ٱلْقُرْءَانِ وَٱلْغَوْا۟",144],["41:36:10",480,"ٱلسَّمِيعُ","(is) the All-Hearer","بِٱللَّهِ ۖ إِنَّهُۥ هُوَ","ٱلْعَلِيمُ",252],["42:11:18",484,"ٱلسَّمِيعُ","(is) the All-Hearer","كَمِثْلِهِۦ شَىْءٌۭ ۖ وَهُوَ","ٱلْبَصِيرُ",252],["43:40:2",492,"تُسْمِعُ","cause to hear","أَفَأَنتَ","ٱلصُّمَّ أَوْ تَهْدِى",679],["43:80:5",495,"نَسْمَعُ","hear","يَحْسَبُونَ أَنَّا لَا","سِرَّهُمْ وَنَجْوَىٰهُم ۚ بَلَىٰ",144],["44:6:6",496,"ٱلسَّمِيعُ","(is) the All-Hearer","رَّبِّكَ ۚ إِنَّهُۥ هُوَ","ٱلْعَلِيمُ",252],["45:8:1",499,"يَسْمَعُ","Who hears","","ءَايَـٰتِ ٱللَّهِ تُتْلَىٰ",144],["45:8:11",499,"يَسْمَعْهَا ۖ","he heard them","مُسْتَكْبِرًۭا كَأَن لَّمْ","فَبَشِّرْهُ بِعَذَابٍ أَلِيمٍۢ",144],["45:23:12",501,"سَمْعِهِۦ","his hearing","عِلْمٍۢ وَخَتَمَ عَلَىٰ","وَقَلْبِهِۦ وَجَعَلَ عَلَىٰ",475],["46:26:9",505,"سَمْعًۭا","hearing","فِيهِ وَجَعَلْنَا لَهُمْ","وَأَبْصَـٰرًۭا وَأَفْـِٔدَةًۭ فَمَآ",475],["46:26:15",505,"سَمْعُهُمْ","their hearing","فَمَآ أَغْنَىٰ عَنْهُمْ","وَلَآ أَبْصَـٰرُهُمْ وَلَآ",475],["46:29:7",506,"يَسْتَمِعُونَ","listening","نَفَرًۭا مِّنَ ٱلْجِنِّ","ٱلْقُرْءَانَ فَلَمَّا حَضَرُوهُ",611],["46:30:4",506,"سَمِعْنَا","[we] have heard","قَالُوا۟ يَـٰقَوْمَنَآ إِنَّا","كِتَـٰبًا أُنزِلَ مِنۢ",144],["47:16:3",508,"يَسْتَمِعُ","listen","وَمِنْهُم مَّن","إِلَيْكَ حَتَّىٰٓ إِذَا",611],["49:1:14",515,"سَمِيعٌ","(is) All-Hearer","ٱللَّهَ ۚ إِنَّ ٱللَّهَ","عَلِيمٌۭ",252],["50:37:11",520,"ٱلسَّمْعَ","(who) gives ear","قَلْبٌ أَوْ أَلْقَى","وَهُوَ شَهِيدٌۭ",475],["50:41:1",520,"وَٱسْتَمِعْ","And listen","","يَوْمَ يُنَادِ ٱلْمُنَادِ",611],["50:42:2",520,"يَسْمَعُونَ","they will hear","يَوْمَ","ٱلصَّيْحَةَ بِٱلْحَقِّ ۚ ذَٰلِكَ",144],["52:38:4",525,"يَسْتَمِعُونَ","they listen","أَمْ لَهُمْ سُلَّمٌۭ","فِيهِ ۖ فَلْيَأْتِ مُسْتَمِعُهُم",611],["52:38:7",525,"مُسْتَمِعُهُم","their listener","يَسْتَمِعُونَ فِيهِ ۖ فَلْيَأْتِ","بِسُلْطَـٰنٍۢ مُّبِينٍ",2507],["56:25:2",535,"يَسْمَعُونَ","they will hear","لَا","فِيهَا لَغْوًۭا وَلَا",144],["58:1:2",542,"سَمِعَ","Allah has heard","قَدْ","ٱللَّهُ قَوْلَ ٱلَّتِى",144],["58:1:13",542,"يَسْمَعُ","hears","إِلَى ٱللَّهِ وَٱللَّهُ","تَحَاوُرَكُمَآ ۚ إِنَّ ٱللَّهَ",144],["58:1:17",542,"سَمِيعٌۢ","(is) All-Hearer","تَحَاوُرَكُمَآ ۚ إِنَّ ٱللَّهَ","بَصِيرٌ",252],["63:4:7",554,"تَسْمَعْ","you listen","أَجْسَامُهُمْ ۖ وَإِن يَقُولُوا۟","لِقَوْلِهِمْ ۖ كَأَنَّهُمْ خُشُبٌۭ",144],["64:16:5",557,"وَٱسْمَعُوا۟","and listen","ٱللَّهَ مَا ٱسْتَطَعْتُمْ","وَأَطِيعُوا۟ وَأَنفِقُوا۟ خَيْرًۭا",144],["67:7:4",562,"سَمِعُوا۟","they will hear","إِذَآ أُلْقُوا۟ فِيهَا","لَهَا شَهِيقًۭا وَهِىَ",144],["67:10:4",562,"نَسْمَعُ","listened","وَقَالُوا۟ لَوْ كُنَّا","أَوْ نَعْقِلُ مَا",144],["67:23:7",563,"ٱلسَّمْعَ","the hearing","أَنشَأَكُمْ وَجَعَلَ لَكُمُ","وَٱلْأَبْصَـٰرَ وَٱلْأَفْـِٔدَةَ ۖ قَلِيلًۭا",475],["68:51:8",566,"سَمِعُوا۟","they hear","لَيُزْلِقُونَكَ بِأَبْصَـٰرِهِمْ لَمَّا","ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ",144],["72:1:5",572,"ٱسْتَمَعَ","listened","أُوحِىَ إِلَىَّ أَنَّهُ","نَفَرٌۭ مِّنَ ٱلْجِنِّ",611],["72:1:11",572,"سَمِعْنَا","heard","ٱلْجِنِّ فَقَالُوٓا۟ إِنَّا","قُرْءَانًا عَجَبًۭا",144],["72:9:6",572,"لِلسَّمْعِ ۖ","for hearing","نَقْعُدُ مِنْهَا مَقَـٰعِدَ","فَمَن يَسْتَمِعِ ٱلْـَٔانَ",475],["72:9:8",572,"يَسْتَمِعِ","listens","مَقَـٰعِدَ لِلسَّمْعِ ۖ فَمَن","ٱلْـَٔانَ يَجِدْ لَهُۥ",611],["72:13:3",572,"سَمِعْنَا","we heard","وَأَنَّا لَمَّا","ٱلْهُدَىٰٓ ءَامَنَّا بِهِۦ ۖ",144],["76:2:9",578,"سَمِيعًۢا","hearing","أَمْشَاجٍۢ نَّبْتَلِيهِ فَجَعَلْنَـٰهُ","بَصِيرًا",252],["78:35:2",583,"يَسْمَعُونَ","they will hear","لَّا","فِيهَا لَغْوًۭا وَلَا",144],["88:11:2",592,"تَسْمَعُ","they will hear","لَّا","فِيهَا لَـٰغِيَةًۭ",144]]