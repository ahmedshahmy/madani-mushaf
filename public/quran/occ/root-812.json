[["6:113:9",142,"وَلِيَقْتَرِفُوا۟","and so that they may commit","يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ وَلِيَرْضَوْهُ","مَا هُم مُّقْتَرِفُونَ",1694],["6:113:12",142,"مُّقْتَرِفُونَ","(are) committing","وَلِيَقْتَرِفُوا۟ مَا هُم","",3984],["6:120:12",143,"يَقْتَرِفُونَ","commit","سَيُجْزَوْنَ بِمَا كَانُوا۟","",1694],["9:24:10",190,"ٱقْتَرَفْتُمُوهَا","that you have acquired","وَأَزْوَٰجُكُمْ وَعَشِيرَتُكُمْ وَأَمْوَٰلٌ","وَتِجَـٰرَةٌۭ تَخْشَوْنَ كَسَادَهَا",1694],["42:23:20",486,"يَقْتَرِفْ","earns","فِى ٱلْقُرْبَىٰ ۗ وَمَن","حَسَنَةًۭ نَّزِدْ لَهُۥ",1694]]