[["25:61:9",365,"سِرَٰجًۭا","a lamp","بُرُوجًۭا وَجَعَلَ فِيهَا","وَقَمَرًۭا مُّنِيرًۭا",1643],["33:46:5",424,"وَسِرَاجًۭا","and (as) a lamp","إِلَى ٱللَّهِ بِإِذْنِهِۦ","مُّنِيرًۭا",1643],["71:16:7",571,"سِرَاجًۭا","a lamp","نُورًۭا وَجَعَلَ ٱلشَّمْسَ","",1643],["78:13:2",582,"سِرَاجًۭا","a lamp","وَجَعَلْنَا","وَهَّاجًۭا",1643]]