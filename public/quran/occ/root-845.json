[["27:44:4",380,"ٱلصَّرْحَ ۖ","the palace","قِيلَ لَهَا ٱدْخُلِى","فَلَمَّا رَأَتْهُ حَسِبَتْهُ",1523],["27:44:14",380,"صَرْحٌۭ","(is) a palace","سَاقَيْهَا ۚ قَالَ إِنَّهُۥ","مُّمَرَّدٌۭ مِّن قَوَارِيرَ ۗ",1523],["28:38:18",390,"صَرْحًۭا","a lofty tower","ٱلطِّينِ فَٱجْعَل لِّى","لَّعَلِّىٓ أَطَّلِعُ إِلَىٰٓ",1523],["40:36:6",471,"صَرْحًۭا","a tower","يَـٰهَـٰمَـٰنُ ٱبْنِ لِى","لَّعَلِّىٓ أَبْلُغُ ٱلْأَسْبَـٰبَ",1523]]