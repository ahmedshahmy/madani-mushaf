[["2:248:14",40,"وَبَقِيَّةٌۭ","and a remnant","سَكِينَةٌۭ مِّن رَّبِّكُمْ","مِّمَّا تَرَكَ ءَالُ",1812],["2:278:8",47,"بَقِىَ","remained","ٱللَّهَ وَذَرُوا۟ مَا","مِنَ ٱلرِّبَوٰٓا۟ إِن",1811],["11:86:1",231,"بَقِيَّتُ","(What) remains","","ٱللَّهِ خَيْرٌۭ لَّكُمْ",1812],["11:116:8",234,"بَقِيَّةٍۢ","those possessing a remnant","مِن قَبْلِكُمْ أُو۟لُوا۟","يَنْهَوْنَ عَنِ ٱلْفَسَادِ",1812],["16:96:7",278,"بَاقٍۢ ۗ","(will) be remaining","وَمَا عِندَ ٱللَّهِ","وَلَنَجْزِيَنَّ ٱلَّذِينَ صَبَرُوٓا۟",3317],["18:46:6",299,"وَٱلْبَـٰقِيَـٰتُ","But the enduring","زِينَةُ ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ","ٱلصَّـٰلِحَـٰتُ خَيْرٌ عِندَ",2329],["19:76:6",310,"وَٱلْبَـٰقِيَـٰتُ","And the everlasting","ٱلَّذِينَ ٱهْتَدَوْا۟ هُدًۭى ۗ","ٱلصَّـٰلِحَـٰتُ خَيْرٌ عِندَ",2329],["20:71:26",316,"وَأَبْقَىٰ","and more lasting","أَيُّنَآ أَشَدُّ عَذَابًۭا","",1035],["20:73:14",316,"وَأَبْقَىٰٓ","and Ever Lasting","ٱلسِّحْرِ ۗ وَٱللَّهُ خَيْرٌۭ","",1035],["20:127:12",321,"وَأَبْقَىٰٓ","and more lasting","وَلَعَذَابُ ٱلْـَٔاخِرَةِ أَشَدُّ","",1035],["20:131:18",321,"وَأَبْقَىٰ","and more lasting","وَرِزْقُ رَبِّكَ خَيْرٌۭ","",1035],["26:120:4",372,"ٱلْبَاقِينَ","the remaining ones","ثُمَّ أَغْرَقْنَا بَعْدُ","",2321],["28:60:13",393,"وَأَبْقَىٰٓ ۚ","and more lasting","عِندَ ٱللَّهِ خَيْرٌۭ","أَفَلَا تَعْقِلُونَ",1035],["37:77:4",449,"ٱلْبَاقِينَ","the survivors","وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ","",2321],["42:36:12",487,"وَأَبْقَىٰ","and more lasting","عِندَ ٱللَّهِ خَيْرٌۭ","لِلَّذِينَ ءَامَنُوا۟ وَعَلَىٰ",1035],["43:28:3",491,"بَاقِيَةًۭ","lasting","وَجَعَلَهَا كَلِمَةًۢ","فِى عَقِبِهِۦ لَعَلَّهُمْ",2320],["53:51:3",528,"أَبْقَىٰ","He spared","وَثَمُودَا۟ فَمَآ","",1811],["55:27:1",532,"وَيَبْقَىٰ","But will remain","","وَجْهُ رَبِّكَ ذُو",1811],["69:8:5",566,"بَاقِيَةٍۢ","remains","تَرَىٰ لَهُم مِّنۢ","",2320],["74:28:2",576,"تُبْقِى","it lets remain","لَا","وَلَا تَذَرُ",4456],["87:17:3",592,"وَأَبْقَىٰٓ","and everlasting","وَٱلْـَٔاخِرَةُ خَيْرٌۭ","",1035]]