[["22:30:21",335,"ٱلْأَوْثَـٰنِ","the idols","فَٱجْتَنِبُوا۟ ٱلرِّجْسَ مِنَ","وَٱجْتَنِبُوا۟ قَوْلَ ٱلزُّورِ",1746],["29:17:6",398,"أَوْثَـٰنًۭا","idols","مِن دُونِ ٱللَّهِ","وَتَخْلُقُونَ إِفْكًا ۚ إِنَّ",1746],["29:25:7",399,"أَوْثَـٰنًۭا","idols","مِّن دُونِ ٱللَّهِ","مَّوَدَّةَ بَيْنِكُمْ فِى",1746]]