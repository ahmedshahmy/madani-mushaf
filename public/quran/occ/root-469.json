[["3:41:19",55,"بِٱلْعَشِىِّ","in the evening","رَّبَّكَ كَثِيرًۭا وَسَبِّحْ","وَٱلْإِبْكَـٰرِ",818],["6:52:7",133,"وَٱلْعَشِىِّ","and the evening","يَدْعُونَ رَبَّهُم بِٱلْغَدَوٰةِ","يُرِيدُونَ وَجْهَهُۥ ۖ مَا",818],["12:16:3",237,"عِشَآءًۭ","early at night","وَجَآءُوٓ أَبَاهُمْ","يَبْكُونَ",2249],["18:28:8",297,"وَٱلْعَشِىِّ","and the evening","يَدْعُونَ رَبَّهُم بِٱلْغَدَوٰةِ","يُرِيدُونَ وَجْهَهُۥ ۖ وَلَا",818],["19:11:11",305,"وَعَشِيًّۭا","and (in) the evening","أَن سَبِّحُوا۟ بُكْرَةًۭ","",818],["19:62:11",309,"وَعَشِيًّۭا","and evening","رِزْقُهُمْ فِيهَا بُكْرَةًۭ","",818],["24:58:27",357,"ٱلْعِشَآءِ ۚ","(of) night","وَمِنۢ بَعْدِ صَلَوٰةِ","ثَلَـٰثُ عَوْرَٰتٍۢ لَّكُمْ ۚ",2249],["30:18:6",406,"وَعَشِيًّۭا","and (at) night","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","وَحِينَ تُظْهِرُونَ",818],["38:18:6",454,"بِٱلْعَشِىِّ","in the evening","ٱلْجِبَالَ مَعَهُۥ يُسَبِّحْنَ","وَٱلْإِشْرَاقِ",818],["38:31:4",455,"بِٱلْعَشِىِّ","in the afternoon","إِذْ عُرِضَ عَلَيْهِ","ٱلصَّـٰفِنَـٰتُ ٱلْجِيَادُ",818],["40:46:5",472,"وَعَشِيًّۭا ۖ","and evening","يُعْرَضُونَ عَلَيْهَا غُدُوًّۭا","وَيَوْمَ تَقُومُ ٱلسَّاعَةُ",818],["40:55:11",473,"بِٱلْعَشِىِّ","in the evening","وَسَبِّحْ بِحَمْدِ رَبِّكَ","وَٱلْإِبْكَـٰرِ",818],["43:36:2",492,"يَعْشُ","turns away","وَمَن","عَن ذِكْرِ ٱلرَّحْمَـٰنِ",4604],["79:46:7",584,"عَشِيَّةً","an evening","لَمْ يَلْبَثُوٓا۟ إِلَّا","أَوْ ضُحَىٰهَا",3087]]