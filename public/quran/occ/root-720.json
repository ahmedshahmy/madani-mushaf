[["2:167:7",25,"كَرَّةًۭ","a return","لَوْ أَنَّ لَنَا","فَنَتَبَرَّأَ مِنْهُمْ كَمَا",1191],["17:6:4",282,"ٱلْكَرَّةَ","the return victory","ثُمَّ رَدَدْنَا لَكُمُ","عَلَيْهِمْ وَأَمْدَدْنَـٰكُم بِأَمْوَٰلٍۢ",1191],["26:102:4",371,"كَرَّةًۭ","a return","فَلَوْ أَنَّ لَنَا","فَنَكُونَ مِنَ ٱلْمُؤْمِنِينَ",1191],["39:58:9",465,"كَرَّةًۭ","another chance","لَوْ أَنَّ لِى","فَأَكُونَ مِنَ ٱلْمُحْسِنِينَ",1191],["67:4:4",562,"كَرَّتَيْنِ","twice (again)","ثُمَّ ٱرْجِعِ ٱلْبَصَرَ","يَنقَلِبْ إِلَيْكَ ٱلْبَصَرُ",1191],["79:12:4",583,"كَرَّةٌ","(would be) a return","قَالُوا۟ تِلْكَ إِذًۭا","خَاسِرَةٌۭ",1191]]