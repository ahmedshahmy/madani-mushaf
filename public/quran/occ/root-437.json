[["2:114:4",18,"مَّنَعَ","prevents","وَمَنْ أَظْلَمُ مِمَّن","مَسَـٰجِدَ ٱللَّهِ أَن",735],["4:141:22",101,"وَنَمْنَعْكُم","and we protected you","أَلَمْ نَسْتَحْوِذْ عَلَيْكُمْ","مِّنَ ٱلْمُؤْمِنِينَ ۚ فَٱللَّهُ",735],["7:12:3",152,"مَنَعَكَ","prevented you","قَالَ مَا","أَلَّا تَسْجُدَ إِذْ",735],["9:54:2",195,"مَنَعَهُمْ","prevents them","وَمَا","أَن تُقْبَلَ مِنْهُمْ",735],["12:63:7",242,"مُنِعَ","Has been denied","أَبِيهِمْ قَالُوا۟ يَـٰٓأَبَانَا","مِنَّا ٱلْكَيْلُ فَأَرْسِلْ",735],["17:59:2",288,"مَنَعَنَآ","stopped Us","وَمَا","أَن نُّرْسِلَ بِٱلْـَٔايَـٰتِ",735],["17:94:2",291,"مَنَعَ","prevented","وَمَا","ٱلنَّاسَ أَن يُؤْمِنُوٓا۟",735],["18:55:2",300,"مَنَعَ","prevents","وَمَا","ٱلنَّاسَ أَن يُؤْمِنُوٓا۟",735],["20:92:4",318,"مَنَعَكَ","prevented you","قَالَ يَـٰهَـٰرُونُ مَا","إِذْ رَأَيْتَهُمْ ضَلُّوٓا۟",735],["21:43:4",325,"تَمْنَعُهُم","(to) defend them","أَمْ لَهُمْ ءَالِهَةٌۭ","مِّن دُونِنَا ۚ لَا",735],["38:75:4",457,"مَنَعَكَ","prevented you","قَالَ يَـٰٓإِبْلِيسُ مَا","أَن تَسْجُدَ لِمَا",735],["50:25:1",519,"مَّنَّاعٍۢ","Forbidder","","لِّلْخَيْرِ مُعْتَدٍۢ مُّرِيبٍ",2527],["56:33:4",535,"مَمْنُوعَةٍۢ","forbidden","لَّا مَقْطُوعَةٍۢ وَلَا","",3683],["59:2:19",545,"مَّانِعَتُهُمْ","would defend them","يَخْرُجُوا۟ ۖ وَظَنُّوٓا۟ أَنَّهُم","حُصُونُهُم مِّنَ ٱللَّهِ",3905],["68:12:1",564,"مَّنَّاعٍۢ","A preventer","","لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ",2527],["70:21:4",569,"مَنُوعًا","withholding","وَإِذَا مَسَّهُ ٱلْخَيْرُ","",3690],["107:7:1",602,"وَيَمْنَعُونَ","And they deny","","ٱلْمَاعُونَ",735]]