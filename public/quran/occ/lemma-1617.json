[["28:76:2",394,"قَـٰرُونَ","Qarun","۞ إِنَّ","كَانَ مِن قَوْمِ",1617],["28:79:16",395,"قَـٰرُونُ","(to) Qarun","مِثْلَ مَآ أُوتِىَ","إِنَّهُۥ لَذُو حَظٍّ",1617],["29:39:1",401,"وَقَـٰرُونَ","And Qarun","","وَفِرْعَوْنَ وَهَـٰمَـٰنَ ۖ وَلَقَدْ",1617],["40:24:4",469,"وَقَـٰرُونَ","and Qarun","إِلَىٰ فِرْعَوْنَ وَهَـٰمَـٰنَ","فَقَالُوا۟ سَـٰحِرٌۭ كَذَّابٌۭ",1617]]