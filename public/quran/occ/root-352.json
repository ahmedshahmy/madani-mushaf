[["2:282:88",48,"أَقْسَطُ","(is) more just","إِلَىٰٓ أَجَلِهِۦ ۚ ذَٰلِكُمْ","عِندَ ٱللَّهِ وَأَقْوَمُ",2186],["3:18:12",52,"بِٱلْقِسْطِ ۚ","in justice","وَأُو۟لُوا۟ ٱلْعِلْمِ قَآئِمًۢا","لَآ إِلَـٰهَ إِلَّا",636],["3:21:13",52,"بِٱلْقِسْطِ","[with] justice","وَيَقْتُلُونَ ٱلَّذِينَ يَأْمُرُونَ","مِنَ ٱلنَّاسِ فَبَشِّرْهُم",636],["4:3:4",77,"تُقْسِطُوا۟","you will be able to do justice","وَإِنْ خِفْتُمْ أَلَّا","فِى ٱلْيَتَـٰمَىٰ فَٱنكِحُوا۟",2018],["4:127:31",98,"بِٱلْقِسْطِ ۚ","with justice","وَأَن تَقُومُوا۟ لِلْيَتَـٰمَىٰ","وَمَا تَفْعَلُوا۟ مِنْ",636],["4:135:6",100,"بِٱلْقِسْطِ","of justice","ءَامَنُوا۟ كُونُوا۟ قَوَّٰمِينَ","شُهَدَآءَ لِلَّهِ وَلَوْ",636],["5:8:8",108,"بِٱلْقِسْطِ ۖ","in justice","قَوَّٰمِينَ لِلَّهِ شُهَدَآءَ","وَلَا يَجْرِمَنَّكُمْ شَنَـَٔانُ",636],["5:42:22",115,"بِٱلْقِسْطِ ۚ","with [the] justice","حَكَمْتَ فَٱحْكُم بَيْنَهُم","إِنَّ ٱللَّهَ يُحِبُّ",636],["5:42:26",115,"ٱلْمُقْسِطِينَ","the ones who are just","إِنَّ ٱللَّهَ يُحِبُّ","",1914],["6:152:15",149,"بِٱلْقِسْطِ ۖ","with justice","وَأَوْفُوا۟ ٱلْكَيْلَ وَٱلْمِيزَانَ","لَا نُكَلِّفُ نَفْسًا",636],["7:29:4",153,"بِٱلْقِسْطِ ۖ","justice","قُلْ أَمَرَ رَبِّى","وَأَقِيمُوا۟ وُجُوهَكُمْ عِندَ",636],["10:4:17",208,"بِٱلْقِسْطِ ۚ","in justice","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","وَٱلَّذِينَ كَفَرُوا۟ لَهُمْ",636],["10:47:9",214,"بِٱلْقِسْطِ","in justice","رَسُولُهُمْ قُضِىَ بَيْنَهُم","وَهُمْ لَا يُظْلَمُونَ",636],["10:54:18",215,"بِٱلْقِسْطِ ۚ","in justice","ٱلْعَذَابَ ۖ وَقُضِىَ بَيْنَهُم","وَهُمْ لَا يُظْلَمُونَ",636],["11:85:5",231,"بِٱلْقِسْطِ ۖ","in justice","أَوْفُوا۟ ٱلْمِكْيَالَ وَٱلْمِيزَانَ","وَلَا تَبْخَسُوا۟ ٱلنَّاسَ",636],["21:47:3",326,"ٱلْقِسْطَ","(of) the justice","وَنَضَعُ ٱلْمَوَٰزِينَ","لِيَوْمِ ٱلْقِيَـٰمَةِ فَلَا",636],["33:5:4",418,"أَقْسَطُ","(is) more just","ٱدْعُوهُمْ لِـَٔابَآئِهِمْ هُوَ","عِندَ ٱللَّهِ ۚ فَإِن",2186],["49:9:26",516,"وَأَقْسِطُوٓا۟ ۖ","and act justly","فَأَصْلِحُوا۟ بَيْنَهُمَا بِٱلْعَدْلِ","إِنَّ ٱللَّهَ يُحِبُّ",2018],["49:9:30",516,"ٱلْمُقْسِطِينَ","those who act justly","إِنَّ ٱللَّهَ يُحِبُّ","",1914],["55:9:3",531,"بِٱلْقِسْطِ","in justice","وَأَقِيمُوا۟ ٱلْوَزْنَ","وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ",636],["57:25:11",541,"بِٱلْقِسْطِ ۖ","justice","وَٱلْمِيزَانَ لِيَقُومَ ٱلنَّاسُ","وَأَنزَلْنَا ٱلْحَدِيدَ فِيهِ",636],["60:8:16",550,"وَتُقْسِطُوٓا۟","and deal justly","دِيَـٰرِكُمْ أَن تَبَرُّوهُمْ","إِلَيْهِمْ ۚ إِنَّ ٱللَّهَ",2018],["60:8:21",550,"ٱلْمُقْسِطِينَ","those who act justly","إِنَّ ٱللَّهَ يُحِبُّ","",1914],["72:14:5",573,"ٱلْقَـٰسِطُونَ ۖ","(are) unjust","مِنَّا ٱلْمُسْلِمُونَ وَمِنَّا","فَمَنْ أَسْلَمَ فَأُو۟لَـٰٓئِكَ",2574],["72:15:2",573,"ٱلْقَـٰسِطُونَ","the unjust","وَأَمَّا","فَكَانُوا۟ لِجَهَنَّمَ حَطَبًۭا",2574]]