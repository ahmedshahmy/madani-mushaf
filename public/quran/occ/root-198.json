[["2:168:7",25,"حَلَـٰلًۭا","lawful","مِمَّا فِى ٱلْأَرْضِ","طَيِّبًۭا وَلَا تَتَّبِعُوا۟",1158],["2:187:1",29,"أُحِلَّ","Permitted","","لَكُمْ لَيْلَةَ ٱلصِّيَامِ",501],["2:196:17",30,"مَحِلَّهُۥ ۚ","(to) its destination","حَتَّىٰ يَبْلُغَ ٱلْهَدْىُ","فَمَن كَانَ مِنكُم",1883],["2:228:7",36,"يَحِلُّ","lawful","ثَلَـٰثَةَ قُرُوٓءٍۢ ۚ وَلَا","لَهُنَّ أَن يَكْتُمْنَ",655],["2:229:9",36,"يَحِلُّ","lawful","تَسْرِيحٌۢ بِإِحْسَـٰنٍۢ ۗ وَلَا","لَكُمْ أَن تَأْخُذُوا۟",655],["2:230:4",36,"تَحِلُّ","lawful","فَإِن طَلَّقَهَا فَلَا","لَهُۥ مِنۢ بَعْدُ",655],["2:275:21",47,"وَأَحَلَّ","While has permitted","ٱلْبَيْعُ مِثْلُ ٱلرِّبَوٰا۟ ۗ","ٱللَّهُ ٱلْبَيْعَ وَحَرَّمَ",501],["3:50:7",56,"وَلِأُحِلَّ","and so that I make lawful","يَدَىَّ مِنَ ٱلتَّوْرَىٰةِ","لَكُم بَعْضَ ٱلَّذِى",501],["3:93:4",62,"حِلًّۭا","lawful","۞ كُلُّ ٱلطَّعَامِ كَانَ","لِّبَنِىٓ إِسْرَٰٓءِيلَ إِلَّا",1304],["4:19:5",80,"يَحِلُّ","(is) lawful","ٱلَّذِينَ ءَامَنُوا۟ لَا","لَكُمْ أَن تَرِثُوا۟",655],["4:23:37",81,"وَحَلَـٰٓئِلُ","And wives","فَلَا جُنَاحَ عَلَيْكُمْ","أَبْنَآئِكُمُ ٱلَّذِينَ مِنْ",3183],["4:24:11",82,"وَأُحِلَّ","And are lawful","كِتَـٰبَ ٱللَّهِ عَلَيْكُمْ ۚ","لَكُم مَّا وَرَآءَ",501],["4:160:8",103,"أُحِلَّتْ","which had been lawful","حَرَّمْنَا عَلَيْهِمْ طَيِّبَـٰتٍ","لَهُمْ وَبِصَدِّهِمْ عَن",501],["5:1:6",106,"أُحِلَّتْ","Are made lawful","ءَامَنُوٓا۟ أَوْفُوا۟ بِٱلْعُقُودِ ۚ","لَكُم بَهِيمَةُ ٱلْأَنْعَـٰمِ",501],["5:1:15",106,"مُحِلِّى","being permitted","يُتْلَىٰ عَلَيْكُمْ غَيْرَ","ٱلصَّيْدِ وَأَنتُمْ حُرُمٌ ۗ",3769],["5:2:5",106,"تُحِلُّوا۟","violate","ٱلَّذِينَ ءَامَنُوا۟ لَا","شَعَـٰٓئِرَ ٱللَّهِ وَلَا",501],["5:2:25",106,"حَلَلْتُمْ","you come out of Ihram","رَّبِّهِمْ وَرِضْوَٰنًۭا ۚ وَإِذَا","فَٱصْطَادُوا۟ ۚ وَلَا يَجْرِمَنَّكُمْ",655],["5:4:3",107,"أُحِلَّ","(is) made lawful","يَسْـَٔلُونَكَ مَاذَآ","لَهُمْ ۖ قُلْ أُحِلَّ",501],["5:4:6",107,"أُحِلَّ","Are made lawful","أُحِلَّ لَهُمْ ۖ قُلْ","لَكُمُ ٱلطَّيِّبَـٰتُ ۙ وَمَا",501],["5:5:2",107,"أُحِلَّ","are made lawful","ٱلْيَوْمَ","لَكُمُ ٱلطَّيِّبَـٰتُ ۖ وَطَعَامُ",501],["5:5:9",107,"حِلٌّۭ","(is) lawful","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ","لَّكُمْ وَطَعَامُكُمْ حِلٌّۭ",1304],["5:5:12",107,"حِلٌّۭ","(is) lawful","حِلٌّۭ لَّكُمْ وَطَعَامُكُمْ","لَّهُمْ ۖ وَٱلْمُحْصَنَـٰتُ مِنَ",1304],["5:87:8",122,"أَحَلَّ","has (been) made lawful","تُحَرِّمُوا۟ طَيِّبَـٰتِ مَآ","ٱللَّهُ لَكُمْ وَلَا",501],["5:88:5",122,"حَلَـٰلًۭا","lawful","مِمَّا رَزَقَكُمُ ٱللَّهُ","طَيِّبًۭا ۚ وَٱتَّقُوا۟ ٱللَّهَ",1158],["5:96:1",124,"أُحِلَّ","Is made lawful","","لَكُمْ صَيْدُ ٱلْبَحْرِ",501],["7:157:18",170,"وَيُحِلُّ","and he makes lawful","وَيَنْهَىٰهُمْ عَنِ ٱلْمُنكَرِ","لَهُمُ ٱلطَّيِّبَـٰتِ وَيُحَرِّمُ",501],["8:69:4",185,"حَلَـٰلًۭا","lawful","فَكُلُوا۟ مِمَّا غَنِمْتُمْ","طَيِّبًۭا ۚ وَٱتَّقُوا۟ ٱللَّهَ ۚ",1158],["9:37:10",193,"يُحِلُّونَهُۥ","They make it lawful","بِهِ ٱلَّذِينَ كَفَرُوا۟","عَامًۭا وَيُحَرِّمُونَهُۥ عَامًۭا",501],["9:37:19",193,"فَيُحِلُّوا۟","and making lawful","مَا حَرَّمَ ٱللَّهُ","مَا حَرَّمَ ٱللَّهُ ۚ",501],["10:59:12",215,"وَحَلَـٰلًۭا","and lawful","فَجَعَلْتُم مِّنْهُ حَرَامًۭا","قُلْ ءَآللَّهُ أَذِنَ",1158],["11:39:7",226,"وَيَحِلُّ","and will descend","يَأْتِيهِ عَذَابٌۭ يُخْزِيهِ","عَلَيْهِ عَذَابٌۭ مُّقِيمٌ",655],["13:31:39",253,"تَحُلُّ","it settles","صَنَعُوا۟ قَارِعَةٌ أَوْ","قَرِيبًۭا مِّن دَارِهِمْ",655],["14:28:9",259,"وَأَحَلُّوا۟","and they led","نِعْمَتَ ٱللَّهِ كُفْرًۭا","قَوْمَهُمْ دَارَ ٱلْبَوَارِ",501],["16:114:5",280,"حَلَـٰلًۭا","lawful","مِمَّا رَزَقَكُمُ ٱللَّهُ","طَيِّبًۭا وَٱشْكُرُوا۟ نِعْمَتَ",1158],["16:116:8",280,"حَلَـٰلٌۭ","(is) lawful","أَلْسِنَتُكُمُ ٱلْكَذِبَ هَـٰذَا","وَهَـٰذَا حَرَامٌۭ لِّتَفْتَرُوا۟",1158],["20:27:1",313,"وَٱحْلُلْ","And untie","","عُقْدَةًۭ مِّن لِّسَانِى",655],["20:81:9",317,"فَيَحِلَّ","lest should descend","وَلَا تَطْغَوْا۟ فِيهِ","عَلَيْكُمْ غَضَبِى ۖ وَمَن",655],["20:81:13",317,"يَحْلِلْ","on whom descends","عَلَيْكُمْ غَضَبِى ۖ وَمَن","عَلَيْهِ غَضَبِى فَقَدْ",655],["20:86:20",317,"يَحِلَّ","descend","أَمْ أَرَدتُّمْ أَن","عَلَيْكُمْ غَضَبٌۭ مِّن",655],["22:30:11",335,"وَأُحِلَّتْ","And are made lawful","لَّهُۥ عِندَ رَبِّهِۦ ۗ","لَكُمُ ٱلْأَنْعَـٰمُ إِلَّا",501],["22:33:8",336,"مَحِلُّهَآ","their place of sacrifice","أَجَلٍۢ مُّسَمًّۭى ثُمَّ","إِلَى ٱلْبَيْتِ ٱلْعَتِيقِ",1883],["33:50:4",424,"أَحْلَلْنَا","[We] have made lawful","يَـٰٓأَيُّهَا ٱلنَّبِىُّ إِنَّآ","لَكَ أَزْوَٰجَكَ ٱلَّـٰتِىٓ",501],["33:52:2",425,"يَحِلُّ","lawful","لَّا","لَكَ ٱلنِّسَآءُ مِنۢ",655],["35:35:2",438,"أَحَلَّنَا","has settled us","ٱلَّذِىٓ","دَارَ ٱلْمُقَامَةِ مِن",501],["39:40:5",462,"وَيَحِلُّ","and descends","يَأْتِيهِ عَذَابٌۭ يُخْزِيهِ","عَلَيْهِ عَذَابٌۭ مُّقِيمٌ",655],["48:25:12",514,"مَحِلَّهُۥ ۚ","its place (of sacrifice)","مَعْكُوفًا أَن يَبْلُغَ","وَلَوْلَا رِجَالٌۭ مُّؤْمِنُونَ",1883],["60:10:21",550,"حِلٌّۭ","(are) lawful","ٱلْكُفَّارِ ۖ لَا هُنَّ","لَّهُمْ وَلَا هُمْ",1304],["60:10:25",550,"يَحِلُّونَ","are lawful","لَّهُمْ وَلَا هُمْ","لَهُنَّ ۖ وَءَاتُوهُم مَّآ",655],["66:1:6",560,"أَحَلَّ","has made lawful","لِمَ تُحَرِّمُ مَآ","ٱللَّهُ لَكَ ۖ تَبْتَغِى",501],["66:2:5",560,"تَحِلَّةَ","(the) dissolution","فَرَضَ ٱللَّهُ لَكُمْ","أَيْمَـٰنِكُمْ ۚ وَٱللَّهُ مَوْلَىٰكُمْ ۖ",4334],["90:2:2",594,"حِلٌّۢ","(are) free (to dwell)","وَأَنتَ","بِهَـٰذَا ٱلْبَلَدِ",1304]]