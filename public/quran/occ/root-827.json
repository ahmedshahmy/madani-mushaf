[["2:9:1",3,"يُخَـٰدِعُونَ","They seek to deceive","","ٱللَّهَ وَٱلَّذِينَ ءَامَنُوا۟",2817],["2:9:6",3,"يَخْدَعُونَ","they deceive","وَٱلَّذِينَ ءَامَنُوا۟ وَمَا","إِلَّآ أَنفُسَهُمْ وَمَا",2789],["4:142:3",101,"يُخَـٰدِعُونَ","(seek to) deceive","إِنَّ ٱلْمُنَـٰفِقِينَ","ٱللَّهَ وَهُوَ خَـٰدِعُهُمْ",2817],["4:142:6",101,"خَـٰدِعُهُمْ","who deceives them","يُخَـٰدِعُونَ ٱللَّهَ وَهُوَ","وَإِذَا قَامُوٓا۟ إِلَى",4565],["8:62:4",185,"يَخْدَعُوكَ","deceive you","وَإِن يُرِيدُوٓا۟ أَن","فَإِنَّ حَسْبَكَ ٱللَّهُ ۚ",2789]]