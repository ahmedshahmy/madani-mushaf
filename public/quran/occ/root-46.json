[["2:25:8",5,"جَنَّـٰتٍۢ","(will be) Gardens","ٱلصَّـٰلِحَـٰتِ أَنَّ لَهُمْ","تَجْرِى مِن تَحْتِهَا",76],["2:35:6",6,"ٱلْجَنَّةَ","(in) Paradise","ٱسْكُنْ أَنتَ وَزَوْجُكَ","وَكُلَا مِنْهَا رَغَدًا",76],["2:82:7",12,"ٱلْجَنَّةِ ۖ","(of) Paradise","ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",76],["2:111:4",17,"ٱلْجَنَّةَ","the Paradise","وَقَالُوا۟ لَن يَدْخُلَ","إِلَّا مَن كَانَ",76],["2:214:5",33,"ٱلْجَنَّةَ","Paradise","حَسِبْتُمْ أَن تَدْخُلُوا۟","وَلَمَّا يَأْتِكُم مَّثَلُ",76],["2:221:32",35,"ٱلْجَنَّةِ","Paradise","وَٱللَّهُ يَدْعُوٓا۟ إِلَى","وَٱلْمَغْفِرَةِ بِإِذْنِهِۦ ۖ وَيُبَيِّنُ",76],["2:265:12",45,"جَنَّةٍۭ","a garden","مِّنْ أَنفُسِهِمْ كَمَثَلِ","بِرَبْوَةٍ أَصَابَهَا وَابِلٌۭ",76],["2:266:6",45,"جَنَّةٌۭ","a garden","أَن تَكُونَ لَهُۥ","مِّن نَّخِيلٍۢ وَأَعْنَابٍۢ",76],["3:15:10",51,"جَنَّـٰتٌۭ","(are) Gardens","ٱتَّقَوْا۟ عِندَ رَبِّهِمْ","تَجْرِى مِن تَحْتِهَا",76],["3:133:6",67,"وَجَنَّةٍ","and a Garden","مَغْفِرَةٍۢ مِّن رَّبِّكُمْ","عَرْضُهَا ٱلسَّمَـٰوَٰتُ وَٱلْأَرْضُ",76],["3:136:6",67,"وَجَنَّـٰتٌۭ","and Gardens","مَّغْفِرَةٌۭ مِّن رَّبِّهِمْ","تَجْرِى مِن تَحْتِهَا",76],["3:142:5",68,"ٱلْجَنَّةَ","Paradise","حَسِبْتُمْ أَن تَدْخُلُوا۟","وَلَمَّا يَعْلَمِ ٱللَّهُ",76],["3:185:15",74,"ٱلْجَنَّةَ","(to) Paradise","عَنِ ٱلنَّارِ وَأُدْخِلَ","فَقَدْ فَازَ ۗ وَمَا",76],["3:195:31",76,"جَنَّـٰتٍۢ","(to) Gardens","عَنْهُمْ سَيِّـَٔاتِهِمْ وَلَأُدْخِلَنَّهُمْ","تَجْرِى مِن تَحْتِهَا",76],["3:198:6",76,"جَنَّـٰتٌۭ","(will be) Gardens","ٱتَّقَوْا۟ رَبَّهُمْ لَهُمْ","تَجْرِى مِن تَحْتِهَا",76],["4:13:9",79,"جَنَّـٰتٍۢ","(to) Gardens","ٱللَّهَ وَرَسُولَهُۥ يُدْخِلْهُ","تَجْرِى مِن تَحْتِهَا",76],["4:57:6",87,"جَنَّـٰتٍۢ","(in) Gardens","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ سَنُدْخِلُهُمْ","تَجْرِى مِن تَحْتِهَا",76],["4:122:6",98,"جَنَّـٰتٍۢ","(in) Gardens","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ سَنُدْخِلُهُمْ","تَجْرِى مِن تَحْتِهَا",76],["4:124:13",98,"ٱلْجَنَّةَ","Paradise","مُؤْمِنٌۭ فَأُو۟لَـٰٓئِكَ يَدْخُلُونَ","وَلَا يُظْلَمُونَ نَقِيرًۭا",76],["5:12:32",109,"جَنَّـٰتٍۢ","(to) gardens","عَنكُمْ سَيِّـَٔاتِكُمْ وَلَأُدْخِلَنَّكُمْ","تَجْرِى مِن تَحْتِهَا",76],["5:65:11",119,"جَنَّـٰتِ","(to) Gardens","عَنْهُمْ سَيِّـَٔاتِهِمْ وَلَأَدْخَلْنَـٰهُمْ","ٱلنَّعِيمِ",76],["5:72:27",120,"ٱلْجَنَّةَ","Paradise","حَرَّمَ ٱللَّهُ عَلَيْهِ","وَمَأْوَىٰهُ ٱلنَّارُ ۖ وَمَا",76],["5:85:5",122,"جَنَّـٰتٍۢ","(with) Gardens","ٱللَّهُ بِمَا قَالُوا۟","تَجْرِى مِن تَحْتِهَا",76],["5:119:9",127,"جَنَّـٰتٌۭ","(are) Gardens","ٱلصَّـٰدِقِينَ صِدْقُهُمْ ۚ لَهُمْ","تَجْرِى مِن تَحْتِهَا",76],["6:76:2",137,"جَنَّ","covered","فَلَمَّا","عَلَيْهِ ٱلَّيْلُ رَءَا",3526],["6:99:25",140,"وَجَنَّـٰتٍۢ","And gardens","طَلْعِهَا قِنْوَانٌۭ دَانِيَةٌۭ","مِّنْ أَعْنَابٍۢ وَٱلزَّيْتُونَ",76],["6:100:4",140,"ٱلْجِنَّ","jinn","وَجَعَلُوا۟ لِلَّهِ شُرَكَآءَ","وَخَلَقَهُمْ ۖ وَخَرَقُوا۟ لَهُۥ",468],["6:112:8",142,"وَٱلْجِنِّ","and the jinn","عَدُوًّۭا شَيَـٰطِينَ ٱلْإِنسِ","يُوحِى بَعْضُهُمْ إِلَىٰ",468],["6:128:5",144,"ٱلْجِنِّ","(of) [the] jinn","يَحْشُرُهُمْ جَمِيعًۭا يَـٰمَعْشَرَ","قَدِ ٱسْتَكْثَرْتُم مِّنَ",468],["6:130:2",144,"ٱلْجِنِّ","(of) [the] jinn","يَـٰمَعْشَرَ","وَٱلْإِنسِ أَلَمْ يَأْتِكُمْ",468],["6:141:4",146,"جَنَّـٰتٍۢ","gardens","۞ وَهُوَ ٱلَّذِىٓ أَنشَأَ","مَّعْرُوشَـٰتٍۢ وَغَيْرَ مَعْرُوشَـٰتٍۢ",76],["7:19:5",152,"ٱلْجَنَّةَ","(in) the Garden","ٱسْكُنْ أَنتَ وَزَوْجُكَ","فَكُلَا مِنْ حَيْثُ",76],["7:22:14",152,"ٱلْجَنَّةِ ۖ","(of) the Garden","عَلَيْهِمَا مِن وَرَقِ","وَنَادَىٰهُمَا رَبُّهُمَآ أَلَمْ",76],["7:27:10",153,"ٱلْجَنَّةِ","Paradise","أَخْرَجَ أَبَوَيْكُم مِّنَ","يَنزِعُ عَنْهُمَا لِبَاسَهُمَا",76],["7:38:10",155,"ٱلْجِنِّ","the jinn","مِن قَبْلِكُم مِّنَ","وَٱلْإِنسِ فِى ٱلنَّارِ ۖ",468],["7:40:14",155,"ٱلْجَنَّةَ","Paradise","ٱلسَّمَآءِ وَلَا يَدْخُلُونَ","حَتَّىٰ يَلِجَ ٱلْجَمَلُ",76],["7:42:12",155,"ٱلْجَنَّةِ ۖ","(of) Paradise","وُسْعَهَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",76],["7:43:32",155,"ٱلْجَنَّةُ","(is) Paradise","وَنُودُوٓا۟ أَن تِلْكُمُ","أُورِثْتُمُوهَا بِمَا كُنتُمْ",76],["7:44:3",156,"ٱلْجَنَّةِ","(of) Paradise","وَنَادَىٰٓ أَصْحَـٰبُ","أَصْحَـٰبَ ٱلنَّارِ أَن",76],["7:46:11",156,"ٱلْجَنَّةِ","(of) Paradise","بِسِيمَىٰهُمْ ۚ وَنَادَوْا۟ أَصْحَـٰبَ","أَن سَلَـٰمٌ عَلَيْكُمْ ۚ",76],["7:49:9",156,"ٱلْجَنَّةَ","Paradise","ٱللَّهُ بِرَحْمَةٍ ۚ ٱدْخُلُوا۟","لَا خَوْفٌ عَلَيْكُمْ",76],["7:50:5",156,"ٱلْجَنَّةِ","(of) Paradise","أَصْحَـٰبُ ٱلنَّارِ أَصْحَـٰبَ","أَنْ أَفِيضُوا۟ عَلَيْنَا",76],["7:179:6",174,"ٱلْجِنِّ","the jinn","لِجَهَنَّمَ كَثِيرًۭا مِّنَ","وَٱلْإِنسِ ۖ لَهُمْ قُلُوبٌۭ",468],["7:184:6",174,"جِنَّةٍ ۚ","(is) any madness","مَا بِصَاحِبِهِم مِّن","إِنْ هُوَ إِلَّا",838],["9:21:6",190,"وَجَنَّـٰتٍۢ","and Gardens","بِرَحْمَةٍۢ مِّنْهُ وَرِضْوَٰنٍۢ","لَّهُمْ فِيهَا نَعِيمٌۭ",76],["9:72:5",198,"جَنَّـٰتٍۢ","Gardens","ٱللَّهُ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ","تَجْرِى مِن تَحْتِهَا",76],["9:72:15",198,"جَنَّـٰتِ","Gardens","وَمَسَـٰكِنَ طَيِّبَةًۭ فِى","عَدْنٍۢ ۚ وَرِضْوَٰنٌۭ مِّنَ",76],["9:89:4",201,"جَنَّـٰتٍۢ","Gardens","أَعَدَّ ٱللَّهُ لَهُمْ","تَجْرِى مِن تَحْتِهَا",76],["9:100:16",203,"جَنَّـٰتٍۢ","Gardens","عَنْهُ وَأَعَدَّ لَهُمْ","تَجْرِى تَحْتَهَا ٱلْأَنْهَـٰرُ",76],["9:111:10",204,"ٱلْجَنَّةَ ۚ","(is) Paradise","وَأَمْوَٰلَهُم بِأَنَّ لَهُمُ","يُقَـٰتِلُونَ فِى سَبِيلِ",76],["10:9:14",209,"جَنَّـٰتِ","Gardens","تَحْتِهِمُ ٱلْأَنْهَـٰرُ فِى","ٱلنَّعِيمِ",76],["10:26:13",212,"ٱلْجَنَّةِ ۖ","(of) Paradise","ذِلَّةٌ ۚ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",76],["11:23:11",224,"ٱلْجَنَّةِ ۖ","(of) Paradise","رَبِّهِمْ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ","هُمْ فِيهَا خَـٰلِدُونَ",76],["11:108:5",233,"ٱلْجَنَّةِ","Paradise","ٱلَّذِينَ سُعِدُوا۟ فَفِى","خَـٰلِدِينَ فِيهَا مَا",76],["11:119:13",235,"ٱلْجِنَّةِ","the Jinn","لَأَمْلَأَنَّ جَهَنَّمَ مِنَ","وَٱلنَّاسِ أَجْمَعِينَ",838],["13:4:5",249,"وَجَنَّـٰتٌۭ","and gardens","ٱلْأَرْضِ قِطَعٌۭ مُّتَجَـٰوِرَٰتٌۭ","مِّنْ أَعْنَـٰبٍۢ وَزَرْعٌۭ",76],["13:23:1",252,"جَنَّـٰتُ","Gardens","","عَدْنٍۢ يَدْخُلُونَهَا وَمَن",76],["13:35:2",254,"ٱلْجَنَّةِ","of Paradise","۞ مَّثَلُ","ٱلَّتِى وُع