[["15:26:5",263,"صَلْصَـٰلٍۢ","sounding clay","خَلَقْنَا ٱلْإِنسَـٰنَ مِن","مِّنْ حَمَإٍۢ مَّسْنُونٍۢ",1522],["15:28:9",263,"صَلْصَـٰلٍۢ","clay","خَـٰلِقٌۢ بَشَرًۭا مِّن","مِّنْ حَمَإٍۢ مَّسْنُونٍۢ",1522],["15:33:8",264,"صَلْصَـٰلٍۢ","clay","لِبَشَرٍ خَلَقْتَهُۥ مِن","مِّنْ حَمَإٍۢ مَّسْنُونٍۢ",1522],["55:14:4",531,"صَلْصَـٰلٍۢ","clay","خَلَقَ ٱلْإِنسَـٰنَ مِن","كَٱلْفَخَّارِ",1522]]