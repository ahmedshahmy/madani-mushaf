[["3:36:2",54,"وَضَعَتْهَا","she delivered her","فَلَمَّا","قَالَتْ رَبِّ إِنِّى",497],["3:36:6",54,"وَضَعْتُهَآ","[I] (have) delivered [her]","قَالَتْ رَبِّ إِنِّى","أُنثَىٰ وَٱللَّهُ أَعْلَمُ",497],["3:36:11",54,"وَضَعَتْ","she delivered","وَٱللَّهُ أَعْلَمُ بِمَا","وَلَيْسَ ٱلذَّكَرُ كَٱلْأُنثَىٰ ۖ",497],["3:96:4",62,"وُضِعَ","set up","إِنَّ أَوَّلَ بَيْتٍۢ","لِلنَّاسِ لَلَّذِى بِبَكَّةَ",497],["4:46:7",86,"مَّوَاضِعِهِۦ","their places","يُحَرِّفُونَ ٱلْكَلِمَ عَن","وَيَقُولُونَ سَمِعْنَا وَعَصَيْنَا",1926],["4:102:53",95,"تَضَعُوٓا۟","you lay down","كُنتُم مَّرْضَىٰٓ أَن","أَسْلِحَتَكُمْ ۖ وَخُذُوا۟ حِذْرَكُمْ ۗ",497],["5:13:11",109,"مَّوَاضِعِهِۦ ۙ","their places","يُحَرِّفُونَ ٱلْكَلِمَ عَن","وَنَسُوا۟ حَظًّۭا مِّمَّا",1926],["5:41:31",114,"مَوَاضِعِهِۦ ۖ","their context","ٱلْكَلِمَ مِنۢ بَعْدِ","يَقُولُونَ إِنْ أُوتِيتُمْ",1926],["7:157:24",170,"وَيَضَعُ","and he relieves","وَيُحَرِّمُ عَلَيْهِمُ ٱلْخَبَـٰٓئِثَ","عَنْهُمْ إِصْرَهُمْ وَٱلْأَغْلَـٰلَ",497],["9:47:8",194,"وَلَأَوْضَعُوا۟","and would have been active","زَادُوكُمْ إِلَّا خَبَالًۭا","خِلَـٰلَكُمْ يَبْغُونَكُمُ ٱلْفِتْنَةَ",3047],["18:49:1",299,"وَوُضِعَ","And (will) be placed","","ٱلْكِتَـٰبُ فَتَرَى ٱلْمُجْرِمِينَ",497],["21:47:1",326,"وَنَضَعُ","And We set","","ٱلْمَوَٰزِينَ ٱلْقِسْطَ لِيَوْمِ",497],["22:2:8",332,"وَتَضَعُ","and will deliver","مُرْضِعَةٍ عَمَّآ أَرْضَعَتْ","كُلُّ ذَاتِ حَمْلٍ",497],["24:58:20",357,"تَضَعُونَ","you put aside","صَلَوٰةِ ٱلْفَجْرِ وَحِينَ","ثِيَابَكُم مِّنَ ٱلظَّهِيرَةِ",497],["24:60:12",358,"يَضَعْنَ","they put aside","عَلَيْهِنَّ جُنَاحٌ أَن","ثِيَابَهُنَّ غَيْرَ مُتَبَرِّجَـٰتٍۭ",497],["35:11:16",435,"تَضَعُ","gives birth","مِنْ أُنثَىٰ وَلَا","إِلَّا بِعِلْمِهِۦ ۚ وَمَا",497],["39:69:5",466,"وَوُضِعَ","and (will) be placed","ٱلْأَرْضُ بِنُورِ رَبِّهَا","ٱلْكِتَـٰبُ وَجِا۟ىٓءَ بِٱلنَّبِيِّـۧنَ",497],["41:47:16",482,"تَضَعُ","gives birth","مِنْ أُنثَىٰ وَلَا","إِلَّا بِعِلْمِهِۦ ۚ وَيَوْمَ",497],["46:15:8",504,"وَوَضَعَتْهُ","and gave birth to him","حَمَلَتْهُ أُمُّهُۥ كُرْهًۭا","كُرْهًۭا ۖ وَحَمْلُهُۥ وَفِصَـٰلُهُۥ",497],["47:4:18",507,"تَضَعَ","lays down","وَإِمَّا فِدَآءً حَتَّىٰ","ٱلْحَرْبُ أَوْزَارَهَا ۚ ذَٰلِكَ",497],["55:7:3",531,"وَوَضَعَ","and He has set up","وَٱلسَّمَآءَ رَفَعَهَا","ٱلْمِيزَانَ",497],["55:10:2",531,"وَضَعَهَا","He laid it","وَٱلْأَرْضَ","لِلْأَنَامِ",497],["65:4:19",558,"يَضَعْنَ","they deliver","ٱلْأَحْمَالِ أَجَلُهُنَّ أَن","حَمْلَهُنَّ ۚ وَمَن يَتَّقِ",497],["65:6:18",559,"يَضَعْنَ","they deliver","فَأَنفِقُوا۟ عَلَيْهِنَّ حَتَّىٰ","حَمْلَهُنَّ ۚ فَإِنْ أَرْضَعْنَ",497],["88:14:2",592,"مَّوْضُوعَةٌۭ","put in place","وَأَكْوَابٌۭ","",3935],["94:2:1",596,"وَوَضَعْنَا","And We removed","","عَنكَ وِزْرَكَ",497]]