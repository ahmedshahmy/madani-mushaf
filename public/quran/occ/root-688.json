[["2:20:3",4,"يَخْطَفُ","snatches away","يَكَادُ ٱلْبَرْقُ","أَبْصَـٰرَهُمْ ۖ كُلَّمَآ أَضَآءَ",2038],["8:26:10",180,"يَتَخَطَّفَكُمُ","might do away with you","ٱلْأَرْضِ تَخَافُونَ أَن","ٱلنَّاسُ فَـَٔاوَىٰكُمْ وَأَيَّدَكُم",2073],["22:31:13",336,"فَتَخْطَفُهُ","and (had) snatched him","خَرَّ مِنَ ٱلسَّمَآءِ","ٱلطَّيْرُ أَوْ تَهْوِى",2038],["28:57:6",392,"نُتَخَطَّفْ","we would be swept","نَّتَّبِعِ ٱلْهُدَىٰ مَعَكَ","مِنْ أَرْضِنَآ ۚ أَوَلَمْ",2073],["29:67:7",404,"وَيُتَخَطَّفُ","while are being taken away","جَعَلْنَا حَرَمًا ءَامِنًۭا","ٱلنَّاسُ مِنْ حَوْلِهِمْ ۚ",2073],["37:10:3",446,"خَطِفَ","snatches","إِلَّا مَنْ","ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌۭ",2038],["37:10:4",446,"ٱلْخَطْفَةَ","(by) theft","إِلَّا مَنْ خَطِفَ","فَأَتْبَعَهُۥ شِهَابٌۭ ثَاقِبٌۭ",4563]]