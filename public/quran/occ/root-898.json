[["11:80:10",230,"رُكْنٍۢ","a support","أَوْ ءَاوِىٓ إِلَىٰ","شَدِيدٍۢ",2609],["11:113:2",234,"تَرْكَنُوٓا۟","incline","وَلَا","إِلَى ٱلَّذِينَ ظَلَمُوا۟",2680],["17:74:6",289,"تَرْكَنُ","(would) have inclined","ثَبَّتْنَـٰكَ لَقَدْ كِدتَّ","إِلَيْهِمْ شَيْـًۭٔا قَلِيلًا",2680],["51:39:2",522,"بِرُكْنِهِۦ","with his supporters","فَتَوَلَّىٰ","وَقَالَ سَـٰحِرٌ أَوْ",2609]]