[["1:6:1",1,"ٱهْدِنَا","Guide us","","ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",79],["2:2:6",2,"هُدًۭى","a Guidance","لَا رَيْبَ ۛ فِيهِ ۛ","لِّلْمُتَّقِينَ",129],["2:5:3",2,"هُدًۭى","Guidance","أُو۟لَـٰٓئِكَ عَلَىٰ","مِّن رَّبِّهِمْ ۖ وَأُو۟لَـٰٓئِكَ",129],["2:16:5",3,"بِٱلْهُدَىٰ","for [the] guidance","ٱلَّذِينَ ٱشْتَرَوُا۟ ٱلضَّلَـٰلَةَ","فَمَا رَبِحَت تِّجَـٰرَتُهُمْ",129],["2:16:11",3,"مُهْتَدِينَ","guided-ones","تِّجَـٰرَتُهُمْ وَمَا كَانُوا۟","",575],["2:26:32",5,"وَيَهْدِى","and He guides","يُضِلُّ بِهِۦ كَثِيرًۭا","بِهِۦ كَثِيرًۭا ۚ وَمَا",79],["2:38:8",7,"هُدًۭى","Guidance","فَإِمَّا يَأْتِيَنَّكُم مِّنِّى","فَمَن تَبِعَ هُدَاىَ",129],["2:38:11",7,"هُدَاىَ","My Guidance","هُدًۭى فَمَن تَبِعَ","فَلَا خَوْفٌ عَلَيْهِمْ",129],["2:53:7",8,"تَهْتَدُونَ","(would be) guided","ٱلْكِتَـٰبَ وَٱلْفُرْقَانَ لَعَلَّكُمْ","",295],["2:70:17",11,"لَمُهْتَدُونَ","(will) surely be those who are guided","إِن شَآءَ ٱللَّهُ","",575],["2:97:16",15,"وَهُدًۭى","and a guidance","لِّمَا بَيْنَ يَدَيْهِ","وَبُشْرَىٰ لِلْمُؤْمِنِينَ",129],["2:120:12",19,"هُدَى","(the) Guidance","مِلَّتَهُمْ ۗ قُلْ إِنَّ","ٱللَّهِ هُوَ ٱلْهُدَىٰ ۗ",129],["2:120:15",19,"ٱلْهُدَىٰ ۗ","(is) the Guidance","هُدَى ٱللَّهِ هُوَ","وَلَئِنِ ٱتَّبَعْتَ أَهْوَآءَهُم",129],["2:135:6",21,"تَهْتَدُوا۟ ۗ","(then) you will be guided","هُودًا أَوْ نَصَـٰرَىٰ","قُلْ بَلْ مِلَّةَ",295],["2:137:8",21,"ٱهْتَدَوا۟ ۖ","they are (rightly) guided","ءَامَنتُم بِهِۦ فَقَدِ","وَّإِن تَوَلَّوْا۟ فَإِنَّمَا",295],["2:142:16",22,"يَهْدِى","He guides","لِّلَّهِ ٱلْمَشْرِقُ وَٱلْمَغْرِبُ ۚ","مَن يَشَآءُ إِلَىٰ",79],["2:143:34",22,"هَدَى","guided","إِلَّا عَلَى ٱلَّذِينَ","ٱللَّهُ ۗ وَمَا كَانَ",79],["2:150:31",23,"تَهْتَدُونَ","(be) guided","نِعْمَتِى عَلَيْكُمْ وَلَعَلَّكُمْ","",295],["2:157:9",24,"ٱلْمُهْتَدُونَ","(are) the guided ones","وَرَحْمَةٌۭ ۖ وَأُو۟لَـٰٓئِكَ هُمُ","",575],["2:159:8",24,"وَٱلْهُدَىٰ","and the Guidance","أَنزَلْنَا مِنَ ٱلْبَيِّنَـٰتِ","مِنۢ بَعْدِ مَا",129],["2:170:22",26,"يَهْتَدُونَ","were they guided","يَعْقِلُونَ شَيْـًۭٔا وَلَا","",295],["2:175:5",26,"بِٱلْهُدَىٰ","for [the] Guidance","ٱلَّذِينَ ٱشْتَرَوُا۟ ٱلضَّلَـٰلَةَ","وَٱلْعَذَابَ بِٱلْمَغْفِرَةِ ۚ فَمَآ",129],["2:185:7",28,"هُدًۭى","a Guidance","أُنزِلَ فِيهِ ٱلْقُرْءَانُ","لِّلنَّاسِ وَبَيِّنَـٰتٍۢ مِّنَ",129],["2:185:11",28,"ٱلْهُدَىٰ","[the] Guidance","لِّلنَّاسِ وَبَيِّنَـٰتٍۢ مِّنَ","وَٱلْفُرْقَانِ ۚ فَمَن شَهِدَ",129],["2:185:42",28,"هَدَىٰكُمْ","He guided you","ٱللَّهَ عَلَىٰ مَا","وَلَعَلَّكُمْ تَشْكُرُونَ",79],["2:196:10",30,"ٱلْهَدْىِ ۖ","the sacrificial animal","فَمَا ٱسْتَيْسَرَ مِنَ","وَلَا تَحْلِقُوا۟ رُءُوسَكُمْ",1073],["2:196:16",30,"ٱلْهَدْىُ","the sacrificial animal","رُءُوسَكُمْ حَتَّىٰ يَبْلُغَ","مَحِلَّهُۥ ۚ فَمَن كَانَ",1073],["2:196:44",30,"ٱلْهَدْىِ ۚ","the sacrificial animal","فَمَا ٱسْتَيْسَرَ مِنَ","فَمَن لَّمْ يَجِدْ",1073],["2:198:20",31,"هَدَىٰكُمْ","He (has) guided you","ٱلْحَرَامِ ۖ وَٱذْكُرُوهُ كَمَا","وَإِن كُنتُم مِّن",79],["2:213:33",33,"فَهَدَى","And guided","ٱلْبَيِّنَـٰتُ بَغْيًۢا بَيْنَهُمْ ۖ","ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟",79],["2:213:44",33,"يَهْدِى","guides","ٱلْحَقِّ بِإِذْنِهِۦ ۗ وَٱللَّهُ","مَن يَشَآءُ إِلَىٰ",79],["2:258:41",43,"يَهْدِى","guide","كَفَرَ ۗ وَٱللَّهُ لَا","ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",79],["2:264:36",44,"يَهْدِى","guide","كَسَبُوا۟ ۗ وَٱللَّهُ لَا","ٱلْقَوْمَ ٱلْكَـٰفِرِينَ",79],["2:272:3",46,"هُدَىٰهُمْ","(is) their guidance","۞ لَّيْسَ عَلَيْكَ","وَلَـٰكِنَّ ٱللَّهَ يَهْدِى",129],["2:272:6",46,"يَهْدِى","guides","هُدَىٰهُمْ وَلَـٰكِنَّ ٱللَّهَ","مَن يَشَآءُ ۗ وَمَا",79],["3:4:3",50,"هُدًۭى","(as) guidance","مِن قَبْلُ","لِّلنَّاسِ وَأَنزَلَ ٱلْفُرْقَانَ ۗ",129],["3:8:7",50,"هَدَيْتَنَا","You (have) guided us","قُلُوبَنَا بَعْدَ إِذْ","وَهَبْ لَنَا مِن",79],["3:20:18",52,"ٱهْتَدَوا۟ ۖ","they are guided","فَإِنْ أَسْلَمُوا۟ فَقَدِ","وَّإِن تَوَلَّوْا۟ فَإِنَّمَا",295],["3:73:9",59,"ٱلْهُدَىٰ","the (true) guidance","دِينَكُمْ قُلْ إِنَّ","هُدَى ٱللَّهِ أَن",129],["3:73:10",59,"هُدَى","(is the) Guidance","قُلْ إِنَّ ٱلْهُدَىٰ","ٱللَّهِ أَن يُؤْتَىٰٓ",129],["3:86:2",61,"يَهْدِى","(shall) guide","كَيْفَ","ٱللَّهُ قَوْمًۭا كَفَرُوا۟",79],["3:86:16",61,"يَهْدِى","guide","ٱلْبَيِّنَـٰتُ ۚ وَٱللَّهُ لَا","ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",79],["3:96:9",62,"وَهُدًۭى","and a guidance","لَلَّذِى بِبَكَّةَ مُبَارَكًۭا","لِّلْعَـٰلَمِينَ",129],["3:101:14",63,"هُدِىَ","he is guided","يَعْتَصِم بِٱللَّهِ فَقَدْ","إِلَىٰ صِرَٰطٍۢ مُّسْتَقِيمٍۢ",79],["3:103:34",63,"تَهْتَدُونَ","(be) guided","لَكُمْ ءَايَـٰتِهِۦ لَعَلَّكُمْ","",295],["3:138:4",67,"وَهُدًۭى","and guidance","هَـٰذَا بَيَانٌۭ لِّلنَّاسِ","وَمَوْعِظَةٌۭ لِّلْمُتَّقِينَ",129],["4:26:5",82,"وَيَهْدِيَكُمْ","and to guide you","ٱللَّهُ لِيُبَيِّنَ لَكُمْ","سُنَنَ ٱلَّذِينَ مِن",79],["4:51:16",86,"أَهْدَىٰ","(are) better guided","لِلَّذِينَ كَفَرُوا۟ هَـٰٓؤُلَآءِ","مِنَ ٱلَّذِينَ ءَامَنُوا۟",1037],["4:68:1",89,"وَلَهَدَيْنَـٰهُمْ","And We would have guided them","","صِرَٰطًۭا مُّسْتَقِيمًۭا",79],["4:88:12",92,"تَهْدُوا۟","you guide","كَسَبُوٓا۟ ۚ أَتُرِيدُونَ أَن","مَنْ أَضَلَّ ٱللَّهُ ۖ",79],["4:98:11",94,"يَهْتَدُونَ","they are directed","يَسْتَطِيعُونَ حِيلَةًۭ وَلَا","سَبِيلًۭا",295],["4:115:9",97,"ٱلْهُدَىٰ","(of) the guidance","مَا تَبَيَّنَ لَهُ","وَيَتَّبِعْ غَيْرَ سَبِيلِ",129],["4:137:19",100,"لِيَهْدِيَهُمْ","will guide them","لِيَغْفِرَ لَهُمْ وَلَا","سَبِيلًۢا",79],["4:168:11",104,"لِيَهْدِيَهُمْ","He will guide them","لِيَغْفِرَ لَهُمْ وَلَا","طَرِيقًا",79],["4:175:12",105,"وَيَهْدِيهِمْ","and will guide them","رَحْمَةٍۢ مِّنْهُ وَفَضْلٍۢ","إِلَيْهِ صِرَٰطًۭا مُّسْتَقِيمًۭا",79],["5:2:12",106,"ٱلْهَدْىَ","the sacrificial animals","ٱلشَّهْرَ ٱلْحَرَامَ وَلَا","وَلَا ٱلْقَلَـٰٓئِدَ وَلَآ",1073],["5:16:1",110,"يَهْدِى","Guides","","بِهِ ٱللَّهُ مَنِ",79],["5:16:15",110,"وَيَهْدِيهِمْ","and guides them","إِلَى ٱلنُّورِ بِإِذْنِهِۦ","إِلَىٰ صِرَٰطٍۢ مُّسْتَقِيمٍۢ",79],["5:44:5",115,"هُدًۭى","(was) Guidance","أَنزَلْنَا ٱلتَّوْرَىٰةَ فِيهَا","وَنُورٌۭ ۚ يَحْكُمُ بِهَا",129],["5:46:16",116,"هُدًۭى","(was) Guidance","وَءَاتَيْنَـٰهُ ٱلْإِنجِيلَ فِيهِ","وَنُورٌۭ وَمُصَدِّقًۭا لِّمَا",129],["5:46:24",116,"وَهُدًۭى","and a Guidance","يَدَيْهِ مِنَ ٱلتَّوْرَىٰةِ","وَمَوْعِظَةًۭ لِّلْمُتَّقِينَ",129],["5:51:20",117,"يَهْدِى","guide","إِنَّ ٱللَّهَ لَا","ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",79],["5:67:22",119,"يَهْدِى","guide","إِنَّ ٱللَّهَ لَا","ٱلْقَوْمَ ٱلْكَـٰفِرِينَ",79],["5:95:24",123,"هَدْيًۢا","(as) an offering","ذَوَا عَدْلٍۢ مِّنكُمْ","بَـٰلِغَ ٱلْكَعْبَةِ أَوْ",1073],["5:97:10",124,"وَٱلْهَدْىَ","and the (animals) for offering","لِّلنَّاسِ وَٱلشَّهْرَ ٱلْحَرَامَ","وَٱلْقَلَـٰٓئِدَ ۚ ذَٰلِكَ لِتَعْلَمُوٓا۟",1073],["5:104:24",125,"يَهْتَدُونَ","they (were) guided","يَعْلَمُونَ شَيْـًۭٔا وَلَا","",295],["5:105:11",125,"ٱهْتَدَيْتُمْ ۚ","you have been guided","مَّن ضَلَّ إِذَا","إِلَى ٱللَّهِ مَرْجِعُكُمْ",295],["5:108:20",125,"يَهْدِى","guide","وَٱسْمَعُوا۟ ۗ وَٱللَّهُ لَا","ٱلْقَوْمَ ٱلْفَـٰسِقِينَ",79],["6:35:24",131,"ٱلْهُدَىٰ ۚ","the guidance","ٱللَّهُ لَجَمَعَهُمْ عَلَى","فَلَا تَكُونَنَّ مِنَ",129],["6:56:21",134,"ٱلْمُهْتَدِينَ","the guided-ones","وَمَآ أَنَا۠ مِنَ","",575],["6:71:16",136,"هَدَىٰنَا","(has) guided us","أَعْقَابِنَا بَعْدَ إِذْ","ٱللَّهُ كَٱلَّذِى ٱسْتَهْوَتْهُ",79],["6:71:28",136,"ٱلْهُدَى","the guidance","أَصْحَـٰبٌۭ يَدْعُونَهُۥٓ إِلَى","ٱئْتِنَا ۗ قُلْ إِنَّ",129],["6:71:32",136,"هُدَى","(the) Guidance","ٱئْتِنَا ۗ قُلْ إِنَّ","ٱللَّهِ هُوَ ٱلْهُدَىٰ ۖ",129],["6:71:35",136,"ٱلْهُدَىٰ ۖ","(is) the Guidance","هُدَى ٱللَّهِ هُوَ","وَأُمِرْنَا لِنُسْلِمَ لِرَبِّ",129],["6:77:13",137,"يَهْدِنِى","guide me","قَالَ لَئِن لَّمْ","رَبِّى لَأَكُونَنَّ مِنَ",79],["6:80:8",137,"هَدَىٰنِ ۚ","He has guided me","فِى ٱللَّهِ وَقَدْ","وَلَآ أَخَافُ مَا",79],["6:82:11",138,"مُّهْتَدُونَ","(are) rightly guided","لَهُمُ ٱلْأَمْنُ وَهُم","",575],["6:84:6",138,"هَدَيْنَا ۚ","We guided","إِسْحَـٰقَ وَيَعْقُوبَ ۚ كُلًّا","وَنُوحًا هَدَيْنَا مِن",79],["6:84:8",138,"هَدَيْنَا","We guided","كُلًّا هَدَيْنَا ۚ وَنُوحًا","مِن قَبْلُ ۖ وَمِن",79],["6:87:6",138,"وَهَدَيْنَـٰهُمْ","and We guided them","وَذُرِّيَّـٰتِهِمْ وَإِخْوَٰنِهِمْ ۖ وَٱجْتَبَيْنَـٰهُمْ","إِلَىٰ صِرَٰطٍۢ مُّسْتَقِيمٍۢ",79],["6:88:2",138,"هُدَى","(is the) Guidance","ذَٰلِكَ","ٱللَّهِ يَهْدِى بِهِۦ",129],["6:88:4",138,"يَهْدِى","He guides","ذَٰلِكَ هُدَى ٱللَّهِ","بِهِۦ مَن يَشَآءُ",79],["6:90:3",138,"هَدَى","(have been) guided","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","ٱللَّهُ ۖ فَبِهُدَىٰهُمُ ٱقْتَدِهْ ۗ",79],["6:90:5",138,"فَبِهُدَىٰهُمُ","so of their guidance","ٱلَّذِينَ هَدَى ٱللَّهُ ۖ","ٱقْتَدِهْ ۗ قُل لَّآ",129],["6:91:24",139,"وَهُدًۭى","and guidance","بِهِۦ مُوسَىٰ نُورًۭا","لِّلنَّاسِ ۖ تَجْعَلُونَهُۥ قَرَاطِيسَ",129],["6:97:6",140,"لِتَهْتَدُوا۟","that you may guide yourselves","جَعَلَ لَكُمُ ٱلنُّجُومَ","بِهَا فِى ظُلُمَـٰتِ",295],["6:117:11",142,"بِٱلْمُهْتَدِينَ","of the guided-ones","سَبِيلِهِۦ ۖ وَهُوَ أَعْلَمُ","",575],["6:125:5",144,"يَهْدِيَهُۥ","He guides him","يُرِدِ ٱللَّهُ أَن","يَشْرَحْ صَدْرَهُۥ لِلْإِسْلَـٰمِ ۖ",79],["6:140:20",146,"مُهْتَدِينَ","guided-ones","ضَلُّوا۟ وَمَا كَانُوا۟","",575],["6:144:38",147,"يَهْدِى","guide","إِنَّ ٱللَّهَ لَا","ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",79],["6:149:7",148,"لَهَدَىٰكُمْ","surely He (would) have guided you","ٱلْبَـٰلِغَةُ ۖ فَلَوْ شَآءَ","أَجْمَعِينَ",79],["6:154:12",149,"وَهُدًۭى","and a guidance","وَتَفْصِيلًۭا لِّكُلِّ شَىْءٍۢ","وَرَحْمَةًۭ لَّعَلَّهُم بِلِقَآءِ",129],["6:157:9",149,"أَهْدَىٰ","better guided","عَلَيْنَا ٱلْكِتَـٰبُ لَكُنَّآ","مِنْهُمْ ۚ فَقَدْ جَآءَكُم",1037],["6:157:16",149,"وَهُدًۭى","and a Guidance","بَيِّنَةٌۭ مِّن رَّبِّكُمْ","وَرَحْمَةٌۭ ۚ فَمَنْ أَظْلَمُ",129],["6:161:3",150,"هَدَىٰنِى","has guided me","قُلْ إِنَّنِى","رَبِّىٓ إِلَىٰ صِرَٰطٍۢ",79],["7:30:2",153,"هَدَىٰ","He guided","فَرِيقًا","وَفَرِيقًا حَقَّ عَلَيْهِمُ",79],["7:30:16",153,"مُّهْتَدُونَ","(are the) guided-ones","ٱللَّهِ وَيَحْسَبُونَ أَنَّهُم","",575],["7:43:15",155,"هَدَىٰنَا","guided us","ٱلْحَمْدُ لِلَّهِ ٱلَّذِى","لِهَـٰذَا وَمَا كُنَّا",79],["7:43:19",155,"لِنَهْتَدِىَ","to receive guidance","لِهَـٰذَا وَمَا كُنَّا","لَوْلَآ أَنْ هَدَىٰنَا",295],["7:43:22",155,"هَدَىٰنَا","(had) guided us","لِنَهْتَدِىَ لَوْلَآ أَنْ","ٱللَّهُ ۖ لَقَدْ جَآءَتْ",79],["7:52:7",157,"هُدًۭى","as guidance","فَصَّلْنَـٰهُ عَلَىٰ عِلْمٍ","وَرَحْمَةًۭ لِّقَوْمٍۢ يُؤْمِنُونَ",129],["7:100:2",163,"يَهْدِ","guide","أَوَلَمْ","لِلَّذِينَ يَرِثُونَ ٱلْأَرْضَ",79],["7:148:18",168,"يَهْدِيهِمْ","guide them","لَا يُكَلِّمُهُمْ وَلَا","سَبِيلًا ۘ ٱتَّخَذُوهُ وَكَانُوا۟",79],["7:154:10",169,"هُدًۭى","(was) guidance","ٱلْأَلْوَاحَ ۖ وَفِى نُسْخَتِهَا","وَرَحْمَةٌۭ لِّلَّذِينَ هُمْ",129],["7:155:31",169,"وَتَهْدِى","and You guide","بِهَا مَن تَشَآءُ","مَن تَشَآءُ ۖ أَنتَ",79],["7:158:31",170,"تَهْتَدُونَ","(be) guided","وَكَلِمَـٰتِهِۦ وَٱتَّبِعُوهُ لَعَلَّكُمْ","",295],["7:159:5",170,"يَهْدُونَ","(which) guides","قَوْمِ مُوسَىٰٓ أُمَّةٌۭ","بِٱلْحَقِّ وَبِهِۦ يَعْدِلُونَ",79],["7:178:2",173,"يَهْدِ","(is) guided","مَن","ٱللَّهُ فَهُوَ ٱلْمُهْتَدِى ۖ",79],["7:178:5",173,"ٱلْمُهْتَدِى ۖ","(is) the guided one","يَهْدِ ٱللَّهُ فَهُوَ","وَمَن يُضْلِلْ فَأُو۟لَـٰٓئِكَ",3809],["7:181:4",174,"يَهْدُونَ","who guides","وَمِمَّنْ خَلَقْنَآ أُمَّةٌۭ","بِٱلْحَقِّ وَبِهِۦ يَعْدِلُونَ",79],["7:186:5",174,"هَادِىَ","guide","يُضْلِلِ ٱللَّهُ فَلَا","لَهُۥ ۚ وَيَذَرُهُمْ فِى",2386],["7:193:4",175,"ٱلْهُدَىٰ","the guidance","وَإِن تَدْعُوهُمْ إِلَى","لَا يَتَّبِعُوكُمْ ۚ سَوَآءٌ",129],["7:198:4",176,"ٱلْهُدَىٰ","the guidance","وَإِن تَدْعُوهُمْ إِلَى","لَا يَسْمَعُوا۟ ۖ وَتَرَىٰهُمْ",129],["7:203:20",176,"وَهُدًۭى","and guidance","بَصَآئِرُ مِن رَّبِّكُمْ","وَرَحْمَةٌۭ لِّقَوْمٍۢ يُؤْمِنُونَ",129],["9:18:23",189,"ٱلْمُهْتَدِينَ","the guided ones","أَن يَكُونُوا۟ مِنَ","",575],["9:19:22",189,"يَهْدِى","guide","ٱللَّهِ ۗ وَٱللَّهُ لَا","ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",79],["9:24:31",190,"يَهْدِى","guide","بِأَمْرِهِۦ ۗ وَٱللَّهُ لَا","ٱلْقَوْمَ ٱلْفَـٰسِقِينَ",79],["9:33:5",192,"بِٱلْهُدَىٰ","with the guidance","ٱلَّذِىٓ أَرْسَلَ رَسُولَهُۥ","وَدِينِ ٱلْحَقِّ لِيُظْهِرَهُۥ",129],["9:37:29",193,"يَهْدِى","guide","أَعْمَـٰلِهِمْ ۗ وَٱللَّهُ لَا","ٱلْقَوْمَ ٱلْكَـٰفِرِينَ",79],["9:80:23",200,"يَهْدِى","guide","وَرَسُولِهِۦ ۗ وَٱللَّهُ لَا","ٱلْقَوْمَ ٱلْفَـٰسِقِينَ",79],["9:109:25",204,"يَهْدِى","guide","جَهَنَّمَ ۗ وَٱللَّهُ لَا","ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",79],["9:115:8",205,"هَدَىٰهُمْ","He has guided them","قَوْمًۢا بَعْدَ إِذْ","حَتَّىٰ يُبَيِّنَ لَهُم",79],["10:9:6",209,"يَهْدِيهِمْ","(will) guide them","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","رَبُّهُم بِإِيمَـٰنِهِمْ ۖ تَجْرِى",79],["10:25:6",211,"وَيَهْدِى","and guides","إِلَىٰ دَارِ ٱلسَّلَـٰمِ","مَن يَشَآءُ إِلَىٰ",79],["10:35:6",213,"يَهْدِىٓ","guides","مِن شُرَكَآئِكُم مَّن","إِلَى ٱلْحَقِّ ۚ قُلِ",79],["10:35:11",213,"يَهْدِى","guides","ٱلْحَقِّ ۚ قُلِ ٱللَّهُ","لِلْحَقِّ ۗ أَفَمَن يَهْدِىٓ",79],["10:35:14",213,"يَهْدِىٓ","guides","يَهْدِى لِلْحَقِّ ۗ أَفَمَن","إِلَى ٱلْحَقِّ أَحَقُّ",79],["10:35:22",213,"يَهِدِّىٓ","guide","يُتَّبَعَ أَمَّن لَّا","إِلَّآ أَن يُهْدَىٰ ۖ",295],["10:35:25",213,"يُهْدَىٰ ۖ","he is guided","يَهِدِّىٓ إِلَّآ أَن","فَمَا لَكُمْ كَيْفَ",79],["10:43:6",214,"تَهْدِى","guide","يَنظُرُ إِلَيْكَ ۚ أَفَأَنتَ","ٱلْعُمْىَ وَلَوْ كَانُوا۟",79],["10:45:20",214,"مُهْتَدِينَ","the guided ones","ٱللَّهِ وَمَا كَانُوا۟","",575],["10:57:12",215,"وَهُدًۭى","and guidance","لِّمَا فِى ٱلصُّدُورِ","وَرَحْمَةٌۭ لِّلْمُؤْمِنِينَ",129],["10:108:10",221,"ٱهْتَدَىٰ","(is) guided","مِن رَّبِّكُمْ ۖ فَمَنِ","فَإِنَّمَا يَهْتَدِى لِنَفْسِهِۦ ۖ",295],["10:108:12",221,"يَهْتَدِى","(he is) guided","فَمَنِ ٱهْتَدَىٰ فَإِنَّمَا","لِنَفْسِهِۦ ۖ وَمَن ضَلَّ",295],["12:52:10",241,"يَهْدِى","guide","وَأَنَّ ٱللَّهَ لَا","كَيْدَ ٱلْخَآئِنِينَ",79],["12:111:20",248,"وَهُدًۭى","and a guidance","وَتَفْصِيلَ كُلِّ شَىْءٍۢ","وَرَحْمَةًۭ لِّقَوْمٍۢ يُؤْمِنُونَ",129],["13:7:15",250,"هَادٍ","(is) a guide","مُنذِرٌۭ ۖ وَلِكُلِّ قَوْمٍ","",1072],["13:27:16",252,"وَيَهْدِىٓ","and guides","يُضِلُّ مَن يَشَآءُ","إِلَيْهِ مَنْ أَنَابَ",79],["13:31:27",253,"لَهَدَى","surely, He would have guided","لَّوْ يَشَآءُ ٱللَّهُ","ٱلنَّاسَ جَمِيعًۭا ۗ وَلَا",79],["13:33:39",253,"هَادٍۢ","guide","فَمَا لَهُۥ مِنْ","",1072],["14:4:14",255,"وَيَهْدِى","and guides","ٱللَّهُ مَن يَشَآءُ","مَن يَشَآءُ ۚ وَهُوَ",79],["14:12:8",257,"هَدَىٰنَا","He has guided us","عَلَى ٱللَّهِ وَقَدْ","سُبُلَنَا ۚ وَلَنَصْبِرَنَّ عَلَىٰ",79],["14:21:23",258,"هَدَىٰنَا","Allah had guided us","شَىْءٍۢ ۚ قَالُوا۟ لَوْ","ٱللَّهُ لَهَدَيْنَـٰكُمْ ۖ سَوَآءٌ",79],["14:21:25",258,"لَهَدَيْنَـٰكُمْ ۖ","surely we would have guided you","لَوْ هَدَىٰنَا ٱللَّهُ","سَوَآءٌ عَلَيْنَآ أَجَزِعْنَآ",79],["16:9:9",268,"لَهَدَىٰكُمْ","surely He would have guided you","جَآئِرٌۭ ۚ وَلَوْ شَآءَ","أَجْمَعِينَ",79],["16:15:11",269,"تَهْتَدُونَ","be guided","وَأَنْهَـٰرًۭا وَسُبُلًۭا لَّعَلَّكُمْ","",295],["16:16:4",269,"يَهْتَدُونَ","guide themselves","وَعَلَـٰمَـٰتٍۢ ۚ وَبِٱلنَّجْمِ هُمْ","",295],["16:36:14",271,"هَدَى","Allah guided","ٱلطَّـٰغُوتَ ۖ فَمِنْهُم مَّنْ","ٱللَّهُ وَمِنْهُم مَّنْ",79],["16:37:4",271,"هُدَىٰهُمْ","their guidance","إِن تَحْرِصْ عَلَىٰ","فَإِنَّ ٱللَّهَ لَا",129],["16:37:8",271,"يَهْدِى","guide","فَإِنَّ ٱللَّهَ لَا","مَن يُضِلُّ ۖ وَمَا",79],["16:64:11",273,"وَهُدًۭى","and (as) a guidance","ٱلَّذِى ٱخْتَلَفُوا۟ فِيهِ ۙ","وَرَحْمَةًۭ لِّقَوْمٍۢ يُؤْمِنُونَ",129],["16:89:21",277,"وَهُدًۭى","and a guidance","تِبْيَـٰنًۭا لِّكُلِّ شَىْءٍۢ","وَرَحْمَةًۭ وَبُشْرَىٰ لِلْمُسْلِمِينَ",129],["16:93:11",277,"وَيَهْدِى","and guides","يُضِلُّ مَن يَشَآءُ","مَن يَشَآءُ ۚ وَلَتُسْـَٔلُنَّ",79],["16:102:11",278,"وَهُدًۭى","and (as) a guidance","لِيُثَبِّتَ ٱلَّذِينَ ءَامَنُوا۟","وَبُشْرَىٰ لِلْمُسْلِمِينَ",129],["16:104:8",279,"يَهْدِيهِمُ","Allah will guide them","بِـَٔايَـٰتِ ٱللَّهِ لَا","ٱللَّهُ وَلَهُمْ عَذَابٌ",79],["16:107:11",279,"يَهْدِى","guide","وَأَنَّ ٱللَّهَ لَا","ٱلْقَوْمَ ٱلْكَـٰفِرِينَ",79],["16:121:4",281,"وَهَدَىٰهُ","and guided him","شَاكِرًۭا لِّأَنْعُمِهِ ۚ ٱجْتَبَىٰهُ","إِلَىٰ صِرَٰطٍۢ مُّسْتَقِيمٍۢ",79],["16:125:22",281,"بِٱلْمُهْتَدِينَ","of the guided ones","سَبِيلِهِۦ ۖ وَهُوَ أَعْلَمُ","",575],["17:2:5",282,"هُدًۭى","a guidance","مُوسَى ٱلْكِتَـٰبَ وَجَعَلْنَـٰهُ","لِّبَنِىٓ إِسْرَٰٓءِيلَ أَلَّا",129],["17:9:4",283,"يَهْدِى","guides","إِنَّ هَـٰذَا ٱلْقُرْءَانَ","لِلَّتِى هِىَ أَقْوَمُ",79],["17:15:2",283,"ٱهْتَدَىٰ","(is) guided","مَّنِ","فَإِنَّمَا يَهْتَدِى لِنَفْسِهِۦ ۖ",295],["17:15:4",283,"يَهْتَدِى","he is guided","مَّنِ ٱهْتَدَىٰ فَإِنَّمَا","لِنَفْسِهِۦ ۖ وَمَن ضَلَّ",295],["17:84:10",290,"أَهْدَىٰ","(is) best guided","أَعْلَمُ بِمَنْ هُوَ","سَبِيلًۭا",1037],["17:94:8",291,"ٱلْهُدَىٰٓ","the guidance","يُؤْمِنُوٓا۟ إِذْ جَآءَهُمُ","إِلَّآ أَن قَالُوٓا۟",129],["17:97:2",292,"يَهْدِ","Allah guides","وَمَن","ٱللَّهُ فَهُوَ ٱلْمُهْتَدِ ۖ",79],["17:97:5",292,"ٱلْمُهْتَدِ ۖ","the guided one","يَهْدِ ٱللَّهُ فَهُوَ","وَمَن يُضْلِلْ فَلَن",1933],["18:13:11",294,"هُدًۭى","(in) guidance","ءَامَنُوا۟ بِرَبِّهِمْ وَزِدْنَـٰهُمْ","",129],["18:17:24",295,"يَهْدِ","Allah guides","ءَايَـٰتِ ٱللَّهِ ۗ مَن","ٱللَّهُ فَهُوَ ٱلْمُهْتَدِ ۖ",79],["18:17:27",295,"ٱلْمُهْتَدِ ۖ","(is) the guided one","يَهْدِ ٱللَّهُ فَهُوَ","وَمَن يُضْلِلْ فَلَن",1933],["18:24:12",296,"يَهْدِيَنِ","will guide me","وَقُلْ عَسَىٰٓ أَن","رَبِّى لِأَقْرَبَ مِنْ",79],["18:55:8",300,"ٱلْهُدَىٰ","the guidance","يُؤْمِنُوٓا۟ إِذْ جَآءَهُمُ","وَيَسْتَغْفِرُوا۟ رَبَّهُمْ إِلَّآ",129],["18:57:26",300,"ٱلْهُدَىٰ","the guidance","وَإِن تَدْعُهُمْ إِلَى","فَلَن يَهْتَدُوٓا۟ إِذًا",129],["18:57:28",300,"يَهْتَدُوٓا۟","they will be guided","إِلَى ٱلْهُدَىٰ فَلَن","إِذًا أَبَدًۭا",295],["19:43:11",308,"أَهْدِكَ","I will guide you","لَمْ يَأْتِكَ فَٱتَّبِعْنِىٓ","صِرَٰطًۭا سَوِيًّۭا",79],["19:58:20",309,"هَدَيْنَا","We guided","إِبْرَٰهِيمَ وَإِسْرَٰٓءِيلَ وَمِمَّنْ","وَٱجْتَبَيْنَآ ۚ إِذَا تُتْلَىٰ",79],["19:76:4",310,"ٱهْتَدَوْا۟","accept guidance","وَيَزِيدُ ٱللَّهُ ٱلَّذِينَ","هُدًۭى ۗ وَٱلْبَـٰقِيَـٰتُ ٱلصَّـٰلِحَـٰتُ",295],["19:76:5",310,"هُدًۭى ۗ","(in) guidance","ٱللَّهُ ٱلَّذِينَ ٱهْتَدَوْا۟","وَٱلْبَـٰقِيَـٰتُ ٱلصَّـٰلِحَـٰتُ خَيْرٌ",129],["20:10:18",312,"هُدًۭى","guidance","أَجِدُ عَلَى ٱلنَّارِ","",129],["20:47:21",314,"ٱلْهُدَىٰٓ","the Guidance","عَلَىٰ مَنِ ٱتَّبَعَ","",129],["20:50:9",314,"هَدَىٰ","He guided (it)","شَىْءٍ خَلْقَهُۥ ثُمَّ","",79],["20:79:5",317,"هَدَىٰ","guide them","فِرْعَوْنُ قَوْمَهُۥ وَمَا","",79],["20:82:9",317,"ٱهْتَدَىٰ","remains guided","وَعَمِلَ صَـٰلِحًۭا ثُمَّ","",295],["20:122:6",320,"وَهَدَىٰ","and guided (him)","رَبُّهُۥ فَتَابَ عَلَيْهِ","",79],["20:123:11",320,"هُدًۭى","guidance","فَإِمَّا يَأْتِيَنَّكُم مِّنِّى","فَمَنِ ٱتَّبَعَ هُدَاىَ",129],["20:123:14",320,"هُدَاىَ","My guidance","هُدًۭى فَمَنِ ٱتَّبَعَ","فَلَا يَضِلُّ وَلَا",129],["20:128:2",321,"يَهْدِ","it guided","أَفَلَمْ","لَهُمْ كَمْ أَهْلَكْنَا",79],["20:135:11",321,"ٱهْتَدَىٰ","is guided","ٱلصِّرَٰطِ ٱلسَّوِىِّ وَمَنِ","",295],["21:31:13",324,"يَهْتَدُونَ","(be) guided","فِجَاجًۭا سُبُلًۭا لَّعَلَّهُمْ","",295],["21:73:3",328,"يَهْدُونَ","they guide","وَجَعَلْنَـٰهُمْ أَئِمَّةًۭ","بِأَمْرِنَا وَأَوْحَيْنَآ إِلَيْهِمْ",79],["22:4:8",332,"وَيَهْدِيهِ","and will guide him","تَوَلَّاهُ فَأَنَّهُۥ يُضِلُّهُۥ","إِلَىٰ عَذَابِ ٱلسَّعِيرِ",79],["22:8:10",333,"هُدًۭى","any guidance","بِغَيْرِ عِلْمٍۢ وَلَا","وَلَا كِتَـٰبٍۢ مُّنِيرٍۢ",129],["22:16:7",334,"يَهْدِى","guides","بَيِّنَـٰتٍۢ وَأَنَّ ٱللَّهَ","مَن يُرِيدُ",79],["22:24:1",335,"وَهُدُوٓا۟","And they were guided","","إِلَى ٱلطَّيِّبِ مِنَ",79],["22:24:6",335,"وَهُدُوٓا۟","and they were guided","ٱلطَّيِّبِ مِنَ ٱلْقَوْلِ","إِلَىٰ صِرَٰطِ ٱلْحَمِيدِ",79],["22:37:18",336,"هَدَىٰكُمْ ۗ","He has guided you","ٱللَّهَ عَلَىٰ مَا","وَبَشِّرِ ٱلْمُحْسِنِينَ",79],["22:54:16",338,"لَهَادِ","(is) surely (the) Guide","قُلُوبُهُمْ ۗ وَإِنَّ ٱللَّهَ","ٱلَّذِينَ ءَامَنُوٓا۟ إِلَىٰ",1072],["22:67:16",340,"هُدًۭى","guidance","رَبِّكَ ۖ إِنَّكَ لَعَلَىٰ","مُّسْتَقِيمٍۢ",129],["23:49:6",345,"يَهْتَدُونَ","be guided","مُوسَى ٱلْكِتَـٰبَ لَعَلَّهُمْ","",295],["24:35:36",354,"يَهْدِى","Allah guides","نُّورٌ عَلَىٰ نُورٍۢ ۗ","ٱللَّهُ لِنُورِهِۦ مَن",79],["24:46:6",356,"يَهْدِى","guides","ءَايَـٰتٍۢ مُّبَيِّنَـٰتٍۢ ۚ وَٱللَّهُ","مَن يَشَآءُ إِلَىٰ",79],["24:54:17",357,"تَهْتَدُوا۟ ۚ","you will be guided","حُمِّلْتُمْ ۖ وَإِن تُطِيعُوهُ","وَمَا عَلَى ٱلرَّسُولِ",295],["25:31:10",362,"هَادِيًۭا","(as) a Guide","ٱلْمُجْرِمِينَ ۗ وَكَفَىٰ بِرَبِّكَ","وَنَصِيرًۭا",2386],["26:62:6",370,"سَيَهْدِينِ","He will guide me","إِنَّ مَعِىَ رَبِّى","",79],["26:78:4",370,"يَهْدِينِ","guides me","ٱلَّذِى خَلَقَنِى فَهُوَ","",79],["27:2:1",377,"هُدًۭى","A guidance","","وَبُشْرَىٰ لِلْمُؤْمِنِينَ",129],["27:24:17",379,"يَهْتَدُونَ","guided","ٱلسَّبِيلِ فَهُمْ لَا","",295],["27:35:4",379,"بِهَدِيَّةٍۢ","a gift","وَإِنِّى مُرْسِلَةٌ إِلَيْهِم","فَنَاظِرَةٌۢ بِمَ يَرْجِعُ",2390],["27:36:15",380,"بِهَدِيَّتِكُمْ","in your gift","ءَاتَىٰكُم بَلْ أَنتُم","تَفْرَحُونَ",2390],["27:41:6",380,"أَتَهْتَدِىٓ","whether she will be guided","لَهَا عَرْشَهَا نَنظُرْ","أَمْ تَكُونُ مِنَ",295],["27:41:12",380,"يَهْتَدُونَ","are not guided","مِنَ ٱلَّذِينَ لَا","",295],["27:63:2",382,"يَهْدِيكُمْ","guides you","أَمَّن","فِى ظُلُمَـٰتِ ٱلْبَرِّ",79],["27:77:2",384,"لَهُدًۭى","(is) surely a guidance","وَإِنَّهُۥ","وَرَحْمَةٌۭ لِّلْمُؤْمِنِينَ",129],["27:81:3",384,"بِهَـٰدِى","guide","وَمَآ أَنتَ","ٱلْعُمْىِ عَن ضَلَـٰلَتِهِمْ ۖ",3487],["27:92:5",385,"ٱهْتَدَىٰ","accepts guidance","أَتْلُوَا۟ ٱلْقُرْءَانَ ۖ فَمَنِ","فَإِنَّمَا يَهْتَدِى لِنَفْسِهِۦ ۖ",295],["27:92:7",385,"يَهْتَدِى","he accepts guidance","فَمَنِ ٱهْتَدَىٰ فَإِنَّمَا","لِنَفْسِهِۦ ۖ وَمَن ضَلَّ",295],["28:22:9",388,"يَهْدِيَنِى","will guide me","عَسَىٰ رَبِّىٓ أَن","سَوَآءَ ٱلسَّبِيلِ",79],["28:37:7",390,"بِٱلْهُدَىٰ","with [the] guidance","أَعْلَمُ بِمَن جَآءَ","مِنْ عِندِهِۦ وَمَن",129],["28:43:13",390,"وَهُدًۭى","and a guidance","ٱلْأُولَىٰ بَصَآئِرَ لِلنَّاسِ","وَرَحْمَةًۭ لَّعَلَّهُمْ يَتَذَكَّرُونَ",129],["28:49:8",391,"أَهْدَىٰ","(is) a better guide","عِندِ ٱللَّهِ هُوَ","مِنْهُمَآ أَتَّبِعْهُ إِن",1037],["28:50:15",391,"هُدًۭى","guidance","ٱتَّبَعَ هَوَىٰهُ بِغَيْرِ","مِّنَ ٱللَّهِ ۚ إِنَّ",129],["28:50:21",391,"يَهْدِى","guide","إِنَّ ٱللَّهَ لَا","ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",79],["28:56:3",392,"تَهْدِى","guide","إِنَّكَ لَا","مَنْ أَحْبَبْتَ وَلَـٰكِنَّ",79],["28:56:8",392,"يَهْدِى","guides","أَحْبَبْتَ وَلَـٰكِنَّ ٱللَّهَ","مَن يَشَآءُ ۚ وَهُوَ",79],["28:56:13",392,"بِٱلْمُهْتَدِينَ","(of) the guided ones","يَشَآءُ ۚ وَهُوَ أَعْلَمُ","",575],["28:57:4",392,"ٱلْهُدَىٰ","the guidance","وَقَالُوٓا۟ إِن نَّتَّبِعِ","مَعَكَ نُتَخَطَّفْ مِنْ",129],["28:64:13",393,"يَهْتَدُونَ","guided","لَوْ أَنَّهُمْ كَانُوا۟","",295],["28:85:14",396,"بِٱلْهُدَىٰ","with the guidance","أَعْلَمُ مَن جَآءَ","وَمَنْ هُوَ فِى",129],["29:69:4",404,"لَنَهْدِيَنَّهُمْ","We will surely, guide them","وَٱلَّذِينَ جَـٰهَدُوا۟ فِينَا","سُبُلَنَا ۚ وَإِنَّ ٱللَّهَ",79],["30:29:9",407,"يَهْدِى","(can) guide","بِغَيْرِ عِلْمٍۢ ۖ فَمَن","مَنْ أَضَلَّ ٱللَّهُ ۖ",79],["30:53:3",410,"بِهَـٰدِ","can guide","وَمَآ أَنتَ","ٱلْعُمْىِ عَن ضَلَـٰلَتِهِمْ ۖ",1072],["31:3:1",411,"هُدًۭى","A guidance","","وَرَحْمَةًۭ لِّلْمُحْسِنِينَ",129],["31:5:3",411,"هُدًۭى","guidance","أُو۟لَـٰٓئِكَ عَلَىٰ","مِّن رَّبِّهِمْ ۖ وَأُو۟لَـٰٓئِكَ",129],["31:20:27",413,"هُدًۭى","guidance","بِغَيْرِ عِلْمٍۢ وَلَا","وَلَا كِتَـٰبٍۢ مُّنِيرٍۢ",129],["32:3:18",415,"يَهْتَدُونَ","be guided","مِّن قَبْلِكَ لَعَلَّهُمْ","",295],["32:13:6",416,"هُدَىٰهَا","its guidance","لَـَٔاتَيْنَا كُلَّ نَفْسٍ","وَلَـٰكِنْ حَقَّ ٱلْقَوْلُ",129],["32:23:12",417,"هُدًۭى","a guide","مِّن لِّقَآئِهِۦ ۖ وَجَعَلْنَـٰهُ","لِّبَنِىٓ إِسْرَٰٓءِيلَ",129],["32:24:4",417,"يَهْدُونَ","guiding","وَجَعَلْنَا مِنْهُمْ أَئِمَّةًۭ","بِأَمْرِنَا لَمَّا صَبَرُوا۟ ۖ",79],["32:26:2",417,"يَهْدِ","guide","أَوَلَمْ","لَهُمْ كَمْ أَهْلَكْنَا",79],["33:4:27",418,"يَهْدِى","guides","يَقُولُ ٱلْحَقَّ وَهُوَ","ٱلسَّبِيلَ",79],["34:6:12",428,"وَيَهْدِىٓ","and it guides","رَّبِّكَ هُوَ ٱلْحَقَّ","إِلَىٰ صِرَٰطِ ٱلْعَزِيزِ",79],["34:24:13",431,"هُدًى","guidance","أَوْ إِيَّاكُمْ لَعَلَىٰ","أَوْ فِى ضَلَـٰلٍۢ",129],["34:32:9",432,"ٱلْهُدَىٰ","the guidance","أَنَحْنُ صَدَدْنَـٰكُمْ عَنِ","بَعْدَ إِذْ جَآءَكُم ۖ",129],["34:50:9",434,"ٱهْتَدَيْتُ","I am guided","عَلَىٰ نَفْسِى ۖ وَإِنِ","فَبِمَا يُوحِىٓ إِلَىَّ",295],["35:8:13",435,"وَيَهْدِى","and guides","يُضِلُّ مَن يَشَآءُ","مَن يَشَآءُ ۖ فَلَا",79],["35:42:9",439,"أَهْدَىٰ","more guided","جَآءَهُمْ نَذِيرٌۭ لَّيَكُونُنَّ","مِنْ إِحْدَى ٱلْأُمَمِ ۖ",1037],["36:21:7",441,"مُّهْتَدُونَ","(are) rightly guided","يَسْـَٔلُكُمْ أَجْرًۭا وَهُم","",575],["37:23:4",446,"فَٱهْدُوهُمْ","then lead them","مِن دُونِ ٱللَّهِ","إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ",79],["37:99:6",449,"سَيَهْدِينِ","He will guide me","ذَاهِبٌ إِلَىٰ رَبِّى","",79],["37:118:1",450,"وَهَدَيْنَـٰهُمَا","And We guided both of them","","ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",79],["38:22:20",454,"وَٱهْدِنَآ","and guide us","بِٱلْحَقِّ وَلَا تُشْطِطْ","إِلَىٰ سَوَآءِ ٱلصِّرَٰطِ",79],["39:3:29",458,"يَهْدِى","guide","إِنَّ ٱللَّهَ لَا","مَنْ هُوَ كَـٰذِبٌۭ",79],["39:18:8",460,"هَدَىٰهُمُ","Allah has guided them","أَحْسَنَهُۥٓ ۚ أُو۟لَـٰٓئِكَ ٱلَّذِينَ","ٱللَّهُ ۖ وَأُو۟لَـٰٓئِكَ هُمْ",79],["39:23:22",461,"هُدَى","(is the) guidance","ذِكْرِ ٱللَّهِ ۚ ذَٰلِكَ","ٱللَّهِ يَهْدِى بِهِۦ",129],["39:23:24",461,"يَهْدِى","He guides","ذَٰلِكَ هُدَى ٱللَّهِ","بِهِۦ مَن يَشَآءُ ۚ",79],["39:23:34",461,"هَادٍ","guide","فَمَا لَهُۥ مِنْ","",1072],["39:36:15",462,"هَادٍۢ","guide","فَمَا لَهُۥ مِنْ","",1072],["39:37:2",462,"يَهْدِ","Allah guides","وَمَن","ٱللَّهُ فَمَا لَهُۥ",79],["39:41:8",463,"ٱهْتَدَىٰ","accepts guidance","لِلنَّاسِ بِٱلْحَقِّ ۖ فَمَنِ","فَلِنَفْسِهِۦ ۖ وَمَن ضَلَّ",295],["39:57:6",465,"هَدَىٰنِى","(had) guided me","لَوْ أَنَّ ٱللَّهَ","لَكُنتُ مِنَ ٱلْمُتَّقِينَ",79],["40:28:35",470,"يَهْدِى","guide","إِنَّ ٱللَّهَ لَا","مَنْ هُوَ مُسْرِفٌۭ",79],["40:29:23",470,"أَهْدِيكُمْ","I guide you","مَآ أَرَىٰ وَمَآ","إِلَّا سَبِيلَ ٱلرَّشَادِ",79],["40:33:16",470,"هَادٍۢ","guide","فَمَا لَهُۥ مِنْ","",1072],["40:38:6",471,"أَهْدِكُمْ","I will guide you","ءَامَنَ يَـٰقَوْمِ ٱتَّبِعُونِ","سَبِيلَ ٱلرَّشَادِ",79],["40:53:4",473,"ٱلْهُدَىٰ","the guidance","وَلَقَدْ ءَاتَيْنَا مُوسَى","وَأَوْرَثْنَا بَنِىٓ إِسْرَٰٓءِيلَ",129],["40:54:1",473,"هُدًۭى","A guide","","وَذِكْرَىٰ لِأُو۟لِى ٱلْأَلْبَـٰبِ",129],["41:17:3",478,"فَهَدَيْنَـٰهُمْ","We guided them","وَأَمَّا ثَمُودُ","فَٱسْتَحَبُّوا۟ ٱلْعَمَىٰ عَلَى",79],["41:17:7",478,"ٱلْهُدَىٰ","the guidance","فَٱسْتَحَبُّوا۟ ٱلْعَمَىٰ عَلَى","فَأَخَذَتْهُمْ صَـٰعِقَةُ ٱلْعَذَابِ",129],["41:44:15",481,"هُدًۭى","a guidance","هُوَ لِلَّذِينَ ءَامَنُوا۟","وَشِفَآءٌۭ ۖ وَٱلَّذِينَ لَا",129],["42:13:35",484,"وَيَهْدِىٓ","and guides","إِلَيْهِ مَن يَشَآءُ","إِلَيْهِ مَن يُنِيبُ",79],["42:52:17",489,"نَّهْدِى","We guide","وَلَـٰكِن جَعَلْنَـٰهُ نُورًۭا","بِهِۦ مَن نَّشَآءُ",79],["42:52:24",489,"لَتَهْدِىٓ","surely guide","مِنْ عِبَادِنَا ۚ وَإِنَّكَ","إِلَىٰ صِرَٰطٍۢ مُّسْتَقِيمٍۢ",79],["43:10:11",489,"تَهْتَدُونَ","(be) guided","فِيهَا سُبُلًۭا لَّعَلَّكُمْ","",295],["43:22:11",490,"مُّهْتَدُونَ","(are) guided","وَإِنَّا عَلَىٰٓ ءَاثَـٰرِهِم","",575],["43:24:4",491,"بِأَهْدَىٰ","better guidance","۞ قَـٰلَ أَوَلَوْ جِئْتُكُم","مِمَّا وَجَدتُّمْ عَلَيْهِ",1037],["43:27:5",491,"سَيَهْدِينِ","will guide me","ٱلَّذِى فَطَرَنِى فَإِنَّهُۥ","",79],["43:37:7",492,"مُّهْتَدُونَ","(are) guided","ٱلسَّبِيلِ وَيَحْسَبُونَ أَنَّهُم","",575],["43:40:5",492,"تَهْدِى","guide","تُسْمِعُ ٱلصُّمَّ أَوْ","ٱلْعُمْىَ وَمَن كَانَ",79],["43:49:11",493,"لَمُهْتَدُونَ","(will) surely be guided","عَهِدَ عِندَكَ إِنَّنَا","",575],["45:11:2",499,"هُدًۭى ۖ","(is) guidance","هَـٰذَا","وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِ",129],["45:20:4",500,"وَهُدًۭى","and guidance","هَـٰذَا بَصَـٰٓئِرُ لِلنَّاسِ","وَرَحْمَةٌۭ لِّقَوْمٍۢ يُوقِنُونَ",129],["45:23:19",501,"يَهْدِيهِ","will guide him","بَصَرِهِۦ غِشَـٰوَةًۭ فَمَن","مِنۢ بَعْدِ ٱللَّهِ ۚ",79],["46:10:22",503,"يَهْدِى","guide","إِنَّ ٱللَّهَ لَا","ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",79],["46:11:14",503,"يَهْتَدُوا۟","they (are) guided","إِلَيْهِ ۚ وَإِذْ لَمْ","بِهِۦ فَسَيَقُولُونَ هَـٰذَآ",295],["46:30:14",506,"يَهْدِىٓ","guiding","لِّمَا بَيْنَ يَدَيْهِ","إِلَى ٱلْحَقِّ وَإِلَىٰ",79],["47:5:1",507,"سَيَهْدِيهِمْ","He will guide them","","وَيُصْلِحُ بَالَهُمْ",79],["47:17:2",508,"ٱهْتَدَوْا۟","accept guidance","وَٱلَّذِينَ","زَادَهُمْ هُدًۭى وَءَاتَىٰهُمْ",295],["47:17:4",508,"هُدًۭى","(in) guidance","وَٱلَّذِينَ ٱهْتَدَوْا۟ زَادَهُمْ","وَءَاتَىٰهُمْ تَقْوَىٰهُمْ",129],["47:25:11",509,"ٱلْهُدَى ۙ","(of) the guidance","مَا تَبَيَّنَ لَهُمُ","ٱلشَّيْطَـٰنُ سَوَّلَ لَهُمْ",129],["47:32:15",510,"ٱلْهُدَىٰ","the guidance","مَا تَبَيَّنَ لَهُمُ","لَن يَضُرُّوا۟ ٱللَّهَ",129],["48:2:13",511,"وَيَهْدِيَكَ","and guide you","وَيُتِمَّ نِعْمَتَهُۥ عَلَيْكَ","صِرَٰطًۭا مُّسْتَقِيمًۭا",79],["48:20:16",513,"وَيَهْدِيَكُمْ","and He may guide you","وَلِتَكُونَ ءَايَةًۭ لِّلْمُؤْمِنِينَ","صِرَٰطًۭا مُّسْتَقِيمًۭا",79],["48:25:8",514,"وَٱلْهَدْىَ","while the offering","عَنِ ٱلْمَسْجِدِ ٱلْحَرَامِ","مَعْكُوفًا أَن يَبْلُغَ",1073],["48:28:5",514,"بِٱلْهُدَىٰ","with guidance","ٱلَّذِىٓ أَرْسَلَ رَسُولَهُۥ","وَدِينِ ٱلْحَقِّ لِيُظْهِرَهُۥ",129],["49:17:15",517,"هَدَىٰكُمْ","He has guided you","يَمُنُّ عَلَيْكُمْ أَنْ","لِلْإِيمَـٰنِ إِن كُنتُمْ",79],["53:23:25",526,"ٱلْهُدَىٰٓ","the guidance","جَآءَهُم مِّن رَّبِّهِمُ","",129],["53:30:16",527,"ٱهْتَدَىٰ","is guided","وَهُوَ أَعْلَمُ بِمَنِ","",295],["57:26:11",541,"مُّهْتَدٍۢ ۖ","(is) a guided one","ٱلنُّبُوَّةَ وَٱلْكِتَـٰبَ ۖ فَمِنْهُم","وَكَثِيرٌۭ مِّنْهُمْ فَـٰسِقُونَ",1933],["61:5:21",551,"يَهْدِى","guide","قُلُوبَهُمْ ۚ وَٱللَّهُ لَا","ٱلْقَوْمَ ٱلْفَـٰسِقِينَ",79],["61:7:14",552,"يَهْدِى","guide","ٱلْإِسْلَـٰمِ ۚ وَٱللَّهُ لَا","ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",79],["61:9:5",552,"بِٱلْهُدَىٰ","with guidance","ٱلَّذِىٓ أَرْسَلَ رَسُولَهُۥ","وَدِينِ ٱلْحَقِّ لِيُظْهِرَهُۥ",129],["62:5:21",553,"يَهْدِى","guide","ٱللَّهِ ۚ وَٱللَّهُ لَا","ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",79],["63:6:16",555,"يَهْدِى","guide","إِنَّ ٱللَّهَ لَا","ٱلْقَوْمَ ٱلْفَـٰسِقِينَ",79],["64:6:9",556,"يَهْدُونَنَا","guide us","بِٱلْبَيِّنَـٰتِ فَقَالُوٓا۟ أَبَشَرٌۭ","فَكَفَرُوا۟ وَتَوَلَّوا۟ ۚ وَّٱسْتَغْنَى",79],["64:11:11",557,"يَهْدِ","He guides","وَمَن يُؤْمِنۢ بِٱللَّهِ","قَلْبَهُۥ ۚ وَٱللَّهُ بِكُلِّ",79],["67:22:6",563,"أَهْدَىٰٓ","better guided","مُكِبًّا عَلَىٰ وَجْهِهِۦٓ","أَمَّن يَمْشِى سَوِيًّا",1037],["68:7:11",564,"بِٱلْمُهْتَدِينَ","of the guided ones","سَبِيلِهِۦ وَهُوَ أَعْلَمُ","",575],["72:2:1",572,"يَهْدِىٓ","It guides","","إِلَى ٱلرُّشْدِ فَـَٔامَنَّا",79],["72:13:4",572,"ٱلْهُدَىٰٓ","the Guidance","وَأَنَّا لَمَّا سَمِعْنَا","ءَامَنَّا بِهِۦ ۖ فَمَن",129],["74:31:44",576,"وَيَهْدِى","and guides","ٱللَّهُ مَن يَشَآءُ","مَن يَشَآءُ ۚ وَمَا",79],["76:3:2",578,"هَدَيْنَـٰهُ","guided him","إِنَّا","ٱلسَّبِيلَ إِمَّا شَاكِرًۭا",79],["79:19:1",584,"وَأَهْدِيَكَ","And I will guide you","","إِلَىٰ رَبِّكَ فَتَخْشَىٰ",79],["87:3:3",591,"فَهَدَىٰ","then guided","وَٱلَّذِى قَدَّرَ","",79],["90:10:1",594,"وَهَدَيْنَـٰهُ","And shown him","","ٱلنَّجْدَيْنِ",79],["92:12:3",596,"لَلْهُدَىٰ","(is) the guidance","إِنَّ عَلَيْنَا","",129],["93:7:3",596,"فَهَدَىٰ","so He guided","وَوَجَدَكَ ضَآلًّۭا","",79],["96:11:5",597,"ٱلْهُدَىٰٓ","[the] guidance","إِن كَانَ عَلَى","",129]]