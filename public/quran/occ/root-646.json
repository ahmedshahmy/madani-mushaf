[["2:130:2",20,"يَرْغَبُ","will turn away","وَمَن","عَن مِّلَّةِ إِبْرَٰهِـۧمَ",1670],["4:127:22",98,"وَتَرْغَبُونَ","and you desire","مَا كُتِبَ لَهُنَّ","أَن تَنكِحُوهُنَّ وَٱلْمُسْتَضْعَفِينَ",1670],["9:59:19",196,"رَٰغِبُونَ","turn our hopes","إِنَّآ إِلَى ٱللَّهِ","",1971],["9:120:15",206,"يَرْغَبُوا۟","they prefer","رَّسُولِ ٱللَّهِ وَلَا","بِأَنفُسِهِمْ عَن نَّفْسِهِۦ ۚ",1670],["19:46:2",308,"أَرَاغِبٌ","Do you hate","قَالَ","أَنتَ عَنْ ءَالِهَتِى",1971],["21:90:15",329,"رَغَبًۭا","(in) hope","فِى ٱلْخَيْرَٰتِ وَيَدْعُونَنَا","وَرَهَبًۭا ۖ وَكَانُوا۟ لَنَا",4164],["68:32:10",565,"رَٰغِبُونَ","turn devoutly","إِنَّآ إِلَىٰ رَبِّنَا","",1971],["94:8:3",597,"فَٱرْغَب","turn your attention","وَإِلَىٰ رَبِّكَ","",1670]]