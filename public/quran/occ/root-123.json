[["2:34:4",6,"ٱسْجُدُوا۟","Prostrate","وَإِذْ قُلْنَا لِلْمَلَـٰٓئِكَةِ","لِـَٔادَمَ فَسَجَدُوٓا۟ إِلَّآ",334],["2:34:6",6,"فَسَجَدُوٓا۟","[so] they prostrated","لِلْمَلَـٰٓئِكَةِ ٱسْجُدُوا۟ لِـَٔادَمَ","إِلَّآ إِبْلِيسَ أَبَىٰ",334],["2:58:13",9,"سُجَّدًۭا","prostrating","رَغَدًۭا وَٱدْخُلُوا۟ ٱلْبَابَ","وَقُولُوا۟ حِطَّةٌۭ نَّغْفِرْ",459],["2:114:5",18,"مَسَـٰجِدَ","(the) masajid","أَظْلَمُ مِمَّن مَّنَعَ","ٱللَّهِ أَن يُذْكَرَ",389],["2:125:22",19,"ٱلسُّجُودِ","and those who prostrate","لِلطَّآئِفِينَ وَٱلْعَـٰكِفِينَ وَٱلرُّكَّعِ","",1234],["2:144:13",22,"ٱلْمَسْجِدِ","(of) Al-Masjid","فَوَلِّ وَجْهَكَ شَطْرَ","ٱلْحَرَامِ ۚ وَحَيْثُ مَا",389],["2:149:7",23,"ٱلْمَسْجِدِ","(of) Al-Masjid","فَوَلِّ وَجْهَكَ شَطْرَ","ٱلْحَرَامِ ۖ وَإِنَّهُۥ لَلْحَقُّ",389],["2:150:7",23,"ٱلْمَسْجِدِ","(of) Al-Masjid","فَوَلِّ وَجْهَكَ شَطْرَ","ٱلْحَرَامِ ۚ وَحَيْثُ مَا",389],["2:187:53",29,"ٱلْمَسَـٰجِدِ ۗ","the masajid","وَأَنتُمْ عَـٰكِفُونَ فِى","تِلْكَ حُدُودُ ٱللَّهِ",389],["2:191:15",30,"ٱلْمَسْجِدِ","Al-Masjid","وَلَا تُقَـٰتِلُوهُمْ عِندَ","ٱلْحَرَامِ حَتَّىٰ يُقَـٰتِلُوكُمْ",389],["2:196:65",30,"ٱلْمَسْجِدِ","(near) Al-Masjid","يَكُنْ أَهْلُهُۥ حَاضِرِى","ٱلْحَرَامِ ۚ وَٱتَّقُوا۟ ٱللَّهَ",389],["2:217:17",34,"وَٱلْمَسْجِدِ","and (preventing access to) Al-Masjid","ٱللَّهِ وَكُفْرٌۢ بِهِۦ","ٱلْحَرَامِ وَإِخْرَاجُ أَهْلِهِۦ",389],["3:43:4",55,"وَٱسْجُدِى","and prostrate","يَـٰمَرْيَمُ ٱقْنُتِى لِرَبِّكِ","وَٱرْكَعِى مَعَ ٱلرَّٰكِعِينَ",334],["3:113:14",64,"يَسْجُدُونَ","prostrate","ءَانَآءَ ٱلَّيْلِ وَهُمْ","",334],["4:102:14",95,"سَجَدُوا۟","they have prostrated","وَلْيَأْخُذُوٓا۟ أَسْلِحَتَهُمْ فَإِذَا","فَلْيَكُونُوا۟ مِن وَرَآئِكُمْ",334],["4:154:9",102,"سُجَّدًۭا","prostrating","لَهُمُ ٱدْخُلُوا۟ ٱلْبَابَ","وَقُلْنَا لَهُمْ لَا",459],["5:2:34",106,"ٱلْمَسْجِدِ","Al-Masjid","أَن صَدُّوكُمْ عَنِ","ٱلْحَرَامِ أَن تَعْتَدُوا۟ ۘ",389],["7:11:8",151,"ٱسْجُدُوا۟","Prostrate","ثُمَّ قُلْنَا لِلْمَلَـٰٓئِكَةِ","لِـَٔادَمَ فَسَجَدُوٓا۟ إِلَّآ",334],["7:11:10",151,"فَسَجَدُوٓا