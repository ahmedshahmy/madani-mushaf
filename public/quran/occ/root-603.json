[["2:266:28",45,"فَٱحْتَرَقَتْ ۗ","then it is burnt","إِعْصَارٌۭ فِيهِ نَارٌۭ","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ",4786],["3:181:22",74,"ٱلْحَرِيقِ","(of) the Burning Fire","وَنَقُولُ ذُوقُوا۟ عَذَابَ","",1301],["8:50:13",183,"ٱلْحَرِيقِ","(of) the Blazing Fire","وَأَدْبَـٰرَهُمْ وَذُوقُوا۟ عَذَابَ","",1301],["20:97:23",318,"لَّنُحَرِّقَنَّهُۥ","Surely we will burn it","ظَلْتَ عَلَيْهِ عَاكِفًۭا ۖ","ثُمَّ لَنَنسِفَنَّهُۥ فِى",1782],["21:68:2",327,"حَرِّقُوهُ","Burn him","قَالُوا۟","وَٱنصُرُوٓا۟ ءَالِهَتَكُمْ إِن",1782],["22:9:15",333,"ٱلْحَرِيقِ","(of) the Burning Fire","يَوْمَ ٱلْقِيَـٰمَةِ عَذَابَ","",1301],["22:22:12",334,"ٱلْحَرِيقِ","(of) the Burning Fire","فِيهَا وَذُوقُوا۟ عَذَابَ","",1301],["29:24:10",399,"حَرِّقُوهُ","burn him","قَالُوا۟ ٱقْتُلُوهُ أَوْ","فَأَنجَىٰهُ ٱللَّهُ مِنَ",1782],["85:10:14",590,"ٱلْحَرِيقِ","(of) the Burning Fire","جَهَنَّمَ وَلَهُمْ عَذَابُ","",1301]]