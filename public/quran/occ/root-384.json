[["2:58:18",9,"خَطَـٰيَـٰكُمْ ۚ","your sins","حِطَّةٌۭ نَّغْفِرْ لَكُمْ","وَسَنَزِيدُ ٱلْمُحْسِنِينَ",1008],["2:81:7",12,"خَطِيٓـَٔتُهُۥ","his sins","سَيِّئَةًۭ وَأَحَـٰطَتْ بِهِۦ","فَأُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ ۖ",1008],["2:286:19",49,"أَخْطَأْنَا ۚ","we err","إِن نَّسِينَآ أَوْ","رَبَّنَا وَلَا تَحْمِلْ",2205],["4:92:8",93,"خَطَـًۭٔا ۚ","(by) mistake","يَقْتُلَ مُؤْمِنًا إِلَّا","وَمَن قَتَلَ مُؤْمِنًا",2728],["4:92:12",93,"خَطَـًۭٔا","(by) mistake","وَمَن قَتَلَ مُؤْمِنًا","فَتَحْرِيرُ رَقَبَةٍۢ مُّؤْمِنَةٍۢ",2728],["4:112:3",96,"خَطِيٓـَٔةً","a fault","وَمَن يَكْسِبْ","أَوْ إِثْمًۭا ثُمَّ",1008],["7:161:18",171,"خَطِيٓـَٔـٰتِكُمْ ۚ","your sins","سُجَّدًۭا نَّغْفِرْ لَكُمْ","سَنَزِيدُ ٱلْمُحْسِنِينَ",2729],["12:29:10",238,"ٱلْخَاطِـِٔينَ","the sinful","إِنَّكِ كُنتِ مِنَ","",1418],["12:91:9",246,"لَخَـٰطِـِٔينَ","sinners","عَلَيْنَا وَإِن كُنَّا","",1418],["12:97:8",247,"خَـٰطِـِٔينَ","sinners","ذُنُوبَنَآ إِنَّا كُنَّا","",1418],["17:31:12",285,"خِطْـًۭٔا","a sin","إِنَّ قَتْلَهُمْ كَانَ","كَبِيرًۭا",4581],["20:73:6",316,"خَطَـٰيَـٰنَا","our sins","بِرَبِّنَا لِيَغْفِرَ لَنَا","وَمَآ أَكْرَهْتَنَا عَلَيْهِ",1008],["26:51:7",369,"خَطَـٰيَـٰنَآ","our sins","يَغْفِرَ لَنَا رَبُّنَا","أَن كُنَّآ أَوَّلَ",1008],["26:82:6",370,"خَطِيٓـَٔتِى","my faults","أَن يَغْفِرَ لِى","يَوْمَ ٱلدِّينِ",1008],["28:8:13",386,"خَـٰطِـِٔينَ","sinners","وَهَـٰمَـٰنَ وَجُنُودَهُمَا كَانُوا۟","",1418],["29:12:9",397,"خَطَـٰيَـٰكُمْ","your sins","ٱتَّبِعُوا۟ سَبِيلَنَا وَلْنَحْمِلْ","وَمَا هُم بِحَـٰمِلِينَ",1008],["29:12:14",397,"خَطَـٰيَـٰهُم","their sins","هُم بِحَـٰمِلِينَ مِنْ","مِّن شَىْءٍ ۖ إِنَّهُمْ",1008],["33:5:19",418,"أَخْطَأْتُم","you made a mistake","عَلَيْكُمْ جُنَاحٌۭ فِيمَآ","بِهِۦ وَلَـٰكِن مَّا",2205],["69:9:6",567,"بِٱلْخَاطِئَةِ","with sin","وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَـٰتُ","",2724],["69:37:4",568,"ٱلْخَـٰطِـُٔونَ","the sinners","لَّا يَأْكُلُهُۥٓ إِلَّا","",1418],["71:25:2",571,"خَطِيٓـَٔـٰتِهِمْ","their sins","مِّمَّا","أُغْرِقُوا۟ فَأُدْخِلُوا۟ نَارًۭا",2729],["96:16:3",598,"خَاطِئَةٍۢ","sinful","نَاصِيَةٍۢ كَـٰذِبَةٍ","",2724]]