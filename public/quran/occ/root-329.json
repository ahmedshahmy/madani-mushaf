[["2:204:4",32,"يُعْجِبُكَ","pleases you","وَمِنَ ٱلنَّاسِ مَن","قَوْلُهُۥ فِى ٱلْحَيَوٰةِ",762],["2:221:12",35,"أَعْجَبَتْكُمْ ۗ","she pleases you","مِّن مُّشْرِكَةٍۢ وَلَوْ","وَلَا تُنكِحُوا۟ ٱلْمُشْرِكِينَ",762],["2:221:24",35,"أَعْجَبَكُمْ ۗ","he pleases you","مِّن مُّشْرِكٍۢ وَلَوْ","أُو۟لَـٰٓئِكَ يَدْعُونَ إِلَى",762],["5:100:7",124,"أَعْجَبَكَ","impresses you","ٱلْخَبِيثُ وَٱلطَّيِّبُ وَلَوْ","كَثْرَةُ ٱلْخَبِيثِ ۚ فَٱتَّقُوا۟",762],["7:63:1",158,"أَوَعَجِبْتُمْ","Do you wonder","","أَن جَآءَكُمْ ذِكْرٌۭ",958],["7:69:1",159,"أَوَعَجِبْتُمْ","Do you wonder","","أَن جَآءَكُمْ ذِكْرٌۭ",958],["9:25:10",190,"أَعْجَبَتْكُمْ","pleased you","وَيَوْمَ حُنَيْنٍ ۙ إِذْ","كَثْرَتُكُمْ فَلَمْ تُغْنِ",762],["9:55:2",196,"تُعْجِبْكَ","impress you","فَلَا","أَمْوَٰلُهُمْ وَلَآ أَوْلَـٰدُهُمْ ۚ",762],["9:85:2",200,"تُعْجِبْكَ","impress you","وَلَا","أَمْوَٰلُهُمْ وَأَوْلَـٰدُهُمْ ۚ إِنَّمَا",762],["10:2:3",208,"عَجَبًا","a wonder","أَكَانَ لِلنَّاسِ","أَنْ أَوْحَيْنَآ إِلَىٰ",1291],["11:72:12",230,"عَجِيبٌۭ","amazing","إِنَّ هَـٰذَا لَشَىْءٌ","",2237],["11:73:2",230,"أَتَعْجَبِينَ","Are you amazed","قَالُوٓا۟","مِنْ أَمْرِ ٱللَّهِ ۖ",958],["13:5:2",249,"تَعْجَبْ","you (are) astonished","۞ وَإِن","فَعَجَبٌۭ قَوْلُهُمْ أَءِذَا",958],["13:5:3",249,"فَعَجَبٌۭ","then astonishing","۞ وَإِن تَعْجَبْ","قَوْلُهُمْ أَءِذَا كُنَّا",1291],["18:9:10",294,"عَجَبًا","a wonder","كَانُوا۟ مِنْ ءَايَـٰتِنَا","",1291],["18:63:20",301,"عَجَبًۭا","amazingly","سَبِيلَهُۥ فِى ٱلْبَحْرِ","",1291],["33:52:14",425,"أَعْجَبَكَ","pleases you","مِنْ أَزْوَٰجٍۢ وَلَوْ","حُسْنُهُنَّ إِلَّا مَا",762],["37:12:2",446,"عَجِبْتَ","you wonder","بَلْ","وَيَسْخَرُونَ",958],["38:4:1",453,"وَعَجِبُوٓا۟","And they wonder","","أَن جَآءَهُم مُّنذِرٌۭ",958],["38:5:8",453,"عُجَابٌۭ","curious","إِنَّ هَـٰذَا لَشَىْءٌ","",3148],["48:29:40",515,"يُعْجِبُ","delighting","فَٱسْتَوَىٰ عَلَىٰ سُوقِهِۦ","ٱلزُّرَّاعَ لِيَغِيظَ بِهِمُ",762],["50:2:2",518,"عَجِبُوٓا۟","they wonder","بَلْ","أَن جَآءَهُم مُّنذِرٌۭ",958],["50:2:11",518,"عَجِيبٌ","amazing","ٱلْكَـٰفِرُونَ هَـٰذَا شَىْءٌ","",2237],["53:59:4",528,"تَعْجَبُونَ","you wonder","أَفَمِنْ هَـٰذَا ٱلْحَدِيثِ","",958],["57:20:16",540,"أَعْجَبَ","pleases","وَٱلْأَوْلَـٰدِ ۖ كَمَثَلِ غَيْثٍ","ٱلْكُفَّارَ نَبَاتُهُۥ ثُمَّ",762],["63:4:3",554,"تُعْجِبُكَ","pleases you","۞ وَإِذَا رَأَيْتَهُمْ","أَجْسَامُهُمْ ۖ وَإِن يَقُولُوا۟",762],["72:1:13",572,"عَجَبًۭا","amazing","إِنَّا سَمِعْنَا قُرْءَانًا","",1291]]