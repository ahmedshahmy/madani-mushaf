[["11:77:13",230,"عَصِيبٌۭ","distressful","وَقَالَ هَـٰذَا يَوْمٌ","",3099],["12:8:10",236,"عُصْبَةٌ","(are) a group","أَبِينَا مِنَّا وَنَحْنُ","إِنَّ أَبَانَا لَفِى",1506],["12:14:6",236,"عُصْبَةٌ","(are) a group","أَكَلَهُ ٱلذِّئْبُ وَنَحْنُ","إِنَّآ إِذًۭا لَّخَـٰسِرُونَ",1506],["24:11:5",351,"عُصْبَةٌۭ","(are) a group","ٱلَّذِينَ جَآءُو بِٱلْإِفْكِ","مِّنكُمْ ۚ لَا تَحْسَبُوهُ",1506],["28:76:16",394,"بِٱلْعُصْبَةِ","a company (of men)","إِنَّ مَفَاتِحَهُۥ لَتَنُوٓأُ","أُو۟لِى ٱلْقُوَّةِ إِذْ",1506]]