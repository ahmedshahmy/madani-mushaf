[["2:11:7",3,"ٱلْأَرْضِ","the earth","لَا تُفْسِدُوا۟ فِى","قَالُوٓا۟ إِنَّمَا نَحْنُ",22],["2:22:4",4,"ٱلْأَرْضَ","the earth","ٱلَّذِى جَعَلَ لَكُمُ","فِرَٰشًۭا وَٱلسَّمَآءَ بِنَآءًۭ",22],["2:27:17",5,"ٱلْأَرْضِ ۚ","the earth","يُوصَلَ وَيُفْسِدُونَ فِى","أُو۟لَـٰٓئِكَ هُمُ ٱلْخَـٰسِرُونَ",22],["2:29:7",5,"ٱلْأَرْضِ","the earth","لَكُم مَّا فِى","جَمِيعًۭا ثُمَّ ٱسْتَوَىٰٓ",22],["2:30:8",6,"ٱلْأَرْضِ","the earth","إِنِّى جَاعِلٌۭ فِى","خَلِيفَةًۭ ۖ قَالُوٓا۟ أَتَجْعَلُ",22],["2:33:16",6,"وَٱلْأَرْضِ","and the earth","أَعْلَمُ غَيْبَ ٱلسَّمَـٰوَٰتِ","وَأَعْلَمُ مَا تُبْدُونَ",22],["2:36:15",6,"ٱلْأَرْضِ","the earth","عَدُوٌّۭ ۖ وَلَكُمْ فِى","مُسْتَقَرٌّۭ وَمَتَـٰعٌ إِلَىٰ",22],["2:60:27",9,"ٱلْأَرْضِ","the earth","وَلَا تَعْثَوْا۟ فِى","مُفْسِدِينَ",22],["2:61:16",9,"ٱلْأَرْضُ","the earth","لَنَا مِمَّا تُنۢبِتُ","مِنۢ بَقْلِهَا وَقِثَّآئِهَا",22],["2:71:9",11,"ٱلْأَرْضَ","the earth","لَّا ذَلُولٌۭ تُثِيرُ","وَلَا تَسْقِى ٱلْحَرْثَ",22],["2:107:8",17,"وَٱلْأَرْضِ ۗ","and the earth","لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ","وَمَا لَكُم مِّن",22],["2:116:11",18,"وَٱلْأَرْضِ ۖ","and the earth","مَا فِى ٱلسَّمَـٰوَٰتِ","كُلٌّۭ لَّهُۥ قَـٰنِتُونَ",22],["2:117:3",18,"وَٱلْأَرْضِ ۖ","and the earth","بَدِيعُ ٱلسَّمَـٰوَٰتِ","وَإِذَا قَضَىٰٓ أَمْرًۭا",22],["2:164:5",25,"وَٱلْأَرْضِ","and the earth","فِى خَلْقِ ٱلسَّمَـٰوَٰتِ","وَٱخْتِلَـٰفِ ٱلَّيْلِ وَٱلنَّهَارِ",22],["2:164:26",25,"ٱلْأَرْضَ","(to) the earth","مَّآءٍۢ فَأَحْيَا بِهِ","بَعْدَ مَوْتِهَا وَبَثَّ",22],["2:164:40",25,"وَٱلْأَرْضِ","and the earth","ٱلْمُسَخَّرِ بَيْنَ ٱلسَّمَآءِ","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يَعْقِلُونَ",22],["2:168:6",25,"ٱلْأَرْضِ","the earth","كُلُوا۟ مِمَّا فِى","حَلَـٰلًۭا طَيِّبًۭا وَلَا",22],["2:205:5",32,"ٱلْأَرْضِ","the earth","تَوَلَّىٰ سَعَىٰ فِى","لِيُفْسِدَ فِيهَا وَيُهْلِكَ",22],["2:251:21",41,"ٱلْأَرْضُ","the Earth","بَعْضَهُم بِبَعْضٍۢ لَّفَسَدَتِ","وَلَـٰكِنَّ ٱللَّهَ ذُو",22],["2:255:19",42,"ٱلْأَرْضِ ۗ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","مَن ذَا ٱلَّذِى",22],["2:255:44",42,"وَٱلْأَرْضَ ۖ","and the earth","وَسِعَ كُرْسِيُّهُ ٱلسَّمَـٰوَٰتِ","وَلَا يَـُٔودُهُۥ حِفْظُهُمَا ۚ",22],["2:267:13",45,"ٱلْأَرْضِ ۖ","the earth","أَخْرَجْنَا لَكُم مِّنَ","وَلَا تَيَمَّمُوا۟ ٱلْخَبِيثَ",22],["2:273:11",46,"ٱلْأَرْضِ","the earth","يَسْتَطِيعُونَ ضَرْبًۭا فِى","يَحْسَبُهُمُ ٱلْجَاهِلُ أَغْنِيَآءَ",22],["2:284:7",49,"ٱلْأَرْضِ ۗ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَإِن تُبْدُوا۟ مَا",22],["3:5:8",50,"ٱلْأَرْضِ","the earth","عَلَيْهِ شَىْءٌۭ فِى","وَلَا فِى ٱلسَّمَآءِ",22],["3:29:17",53,"ٱلْأَرْضِ ۗ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَٱللَّهُ عَلَىٰ كُلِّ",22],["3:83:10",60,"وَٱلْأَرْضِ","and the earth","مَن فِى ٱلسَّمَـٰوَٰتِ","طَوْعًۭا وَكَرْهًۭا وَإِلَيْهِ",22],["3:91:12",61,"ٱلْأَرْضِ","earth","مِنْ أَحَدِهِم مِّلْءُ","ذَهَبًۭا وَلَوِ ٱفْتَدَىٰ",22],["3:109:7",64,"ٱلْأَرْضِ ۚ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَإِلَى ٱللَّهِ تُرْجَعُ",22],["3:129:7",66,"ٱلْأَرْضِ ۚ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","يَغْفِرُ لِمَن يَشَآءُ",22],["3:133:9",67,"وَٱلْأَرْضُ","and the earth","وَجَنَّةٍ عَرْضُهَا ٱلسَّمَـٰوَٰتُ","أُعِدَّتْ لِلْمُتَّقِينَ",22],["3:137:8",67,"ٱلْأَرْضِ","the earth","سُنَنٌۭ فَسِيرُوا۟ فِى","فَٱنظُرُوا۟ كَيْفَ كَانَ",22],["3:156:13",70,"ٱلْأَرْضِ","the earth","إِذَا ضَرَبُوا۟ فِى","أَوْ كَانُوا۟ غُزًّۭى",22],["3:180:26",73,"وَٱلْأَرْضِ ۗ","and the earth","وَلِلَّهِ مِيرَٰثُ ٱلسَّمَـٰوَٰتِ","وَٱللَّهُ بِمَا تَعْمَلُونَ",22],["3:189:4",75,"وَٱلْأَرْضِ ۗ","and the earth","وَلِلَّهِ مُلْكُ ٱلسَّمَـٰوَٰتِ","وَٱللَّهُ عَلَىٰ كُلِّ",22],["3:190:5",75,"وَٱلْأَرْضِ","and the earth","فِى خَلْقِ ٱلسَّمَـٰوَٰتِ","وَٱخْتِلَـٰفِ ٱلَّيْلِ وَٱلنَّهَارِ",22],["3:191:12",75,"وَٱلْأَرْضِ","and the earth","فِى خَلْقِ ٱلسَّمَـٰوَٰتِ","رَبَّنَا مَا خَلَقْتَ",22],["4:42:10",85,"ٱلْأَرْضُ","the earth","لَوْ تُسَوَّىٰ بِهِمُ","وَلَا يَكْتُمُونَ ٱللَّهَ",22],["4:97:14",94,"ٱلْأَرْضِ ۚ","the earth","كُنَّا مُسْتَضْعَفِينَ فِى","قَالُوٓا۟ أَلَمْ تَكُنْ",22],["4:97:18",94,"أَرْضُ","(the) earth","قَالُوٓا۟ أَلَمْ تَكُنْ","ٱللَّهِ وَٰسِعَةًۭ فَتُهَاجِرُوا۟",22],["4:100:8",94,"ٱلْأَرْضِ","the earth","ٱللَّهِ يَجِدْ فِى","مُرَٰغَمًۭا كَثِيرًۭا وَسَعَةًۭ ۚ",22],["4:101:4",94,"ٱلْأَرْضِ","the earth","وَإِذَا ضَرَبْتُمْ فِى","فَلَيْسَ عَلَيْكُمْ جُنَاحٌ",22],["4:126:7",98,"ٱلْأَرْضِ ۚ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَكَانَ ٱللَّهُ بِكُلِّ",22],["4:131:7",99,"ٱلْأَرْضِ ۗ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَلَقَدْ وَصَّيْنَا ٱلَّذِينَ",22],["4:131:28",99,"ٱلْأَرْضِ ۚ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَكَانَ ٱللَّهُ غَنِيًّا",22],["4:132:7",99,"ٱلْأَرْضِ ۚ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَكَفَىٰ بِٱللَّهِ وَكِيلًا",22],["4:170:19",104,"وَٱلْأَرْضِ ۚ","and the earth","مَا فِى ٱلسَّمَـٰوَٰتِ","وَكَانَ ٱللَّهُ عَلِيمًا",22],["4:171:50",105,"ٱلْأَرْضِ ۗ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَكَفَىٰ بِٱللَّهِ وَكِيلًۭا",22],["5:17:27",110,"ٱلْأَرْضِ","the earth","وَأُمَّهُۥ وَمَن فِى","جَمِيعًۭا ۗ وَلِلَّهِ مُلْكُ",22],["5:17:32",110,"وَٱلْأَرْضِ","and the earth","وَلِلَّهِ مُلْكُ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَا ۚ يَخْلُقُ",22],["5:18:26",111,"وَٱلْأَرْضِ","and the earth","وَلِلَّهِ مُلْكُ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَا ۖ وَإِلَيْهِ",22],["5:21:3",111,"ٱلْأَرْضَ","the land","يَـٰقَوْمِ ٱدْخُلُوا۟","ٱلْمُقَدَّسَةَ ٱلَّتِى كَتَبَ",22],["5:26:9",112,"ٱلْأَرْضِ ۚ","the earth","سَنَةًۭ ۛ يَتِيهُونَ فِى","فَلَا تَأْسَ عَلَى",22],["5:31:6",112,"ٱلْأَرْضِ","the earth","غُرَابًۭا يَبْحَثُ فِى","لِيُرِيَهُۥ كَيْفَ يُوَٰرِى",22],["5:32:17",113,"ٱلْأَرْضِ","the earth","أَوْ فَسَادٍۢ فِى","فَكَأَنَّمَا قَتَلَ ٱلنَّاسَ",22],["5:32:39",113,"ٱلْأَرْضِ","the earth","بَعْدَ ذَٰلِكَ فِى","لَمُسْرِفُونَ",22],["5:33:9",113,"ٱلْأَرْضِ","the earth","وَرَسُولَهُۥ وَيَسْعَوْنَ فِى","فَسَادًا أَن يُقَتَّلُوٓا۟",22],["5:33:24",113,"ٱلْأَرْضِ ۚ","the land","أَوْ يُنفَوْا۟ مِنَ","ذَٰلِكَ لَهُمْ خِزْىٌۭ",22],["5:36:9",113,"ٱلْأَرْضِ","the earth","لَهُم مَّا فِى","جَمِيعًۭا وَمِثْلَهُۥ مَعَهُۥ",22],["5:40:8",114,"وَٱلْأَرْضِ","and the earth","لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ","يُعَذِّبُ مَن يَشَآءُ",22],["5:64:42",118,"ٱلْأَرْضِ","the earth","ٱللَّهُ ۚ وَيَسْعَوْنَ فِى","فَسَادًۭا ۚ وَٱللَّهُ لَا",22],["5:97:22",124,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَأَنَّ ٱللَّهَ بِكُلِّ",22],["5:106:24",125,"ٱلْأَرْضِ","the earth","أَنتُمْ ضَرَبْتُمْ فِى","فَأَصَـٰبَتْكُم مُّصِيبَةُ ٱلْمَوْتِ ۚ",22],["5:120:4",127,"وَٱلْأَرْضِ","and the earth","لِلَّهِ مُلْكُ ٱلسَّمَـٰوَٰتِ","وَمَا فِيهِنَّ ۚ وَهُوَ",22],["6:1:6",128,"وَٱلْأَرْضَ","and the earth","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ","وَجَعَلَ ٱلظُّلُمَـٰتِ وَٱلنُّورَ ۖ",22],["6:3:6",128,"ٱلْأَرْضِ ۖ","the earth","فِى ٱلسَّمَـٰوَٰتِ وَفِى","يَعْلَمُ سِرَّكُمْ وَجَهْرَكُمْ",22],["6:6:11",128,"ٱلْأَرْضِ","the earth","قَرْنٍۢ مَّكَّنَّـٰهُمْ فِى","مَا لَمْ نُمَكِّن",22],["6:11:4",129,"ٱلْأَرْضِ","the earth","قُلْ سِيرُوا۟ فِى","ثُمَّ ٱنظُرُوا۟ كَيْفَ",22],["6:12:6",129,"وَٱلْأَرْضِ ۖ","and the earth","مَّا فِى ٱلسَّمَـٰوَٰتِ","قُل لِّلَّهِ ۚ كَتَبَ",22],["6:14:8",129,"وَٱلْأَرْضِ","and the earth","وَلِيًّۭا فَاطِرِ ٱلسَّمَـٰوَٰتِ","وَهُوَ يُطْعِمُ وَلَا",22],["6:35:12",131,"ٱلْأَرْضِ","the earth","تَبْتَغِىَ نَفَقًۭا فِى","أَوْ سُلَّمًۭا فِى",22],["6:38:5",132,"ٱلْأَرْضِ","the earth","مِن دَآبَّةٍۢ فِى","وَلَا طَـٰٓئِرٍۢ يَطِيرُ",22],["6:59:23",134,"ٱلْأَرْضِ","(of) the earth","حَبَّةٍۢ فِى ظُلُمَـٰتِ","وَلَا رَطْبٍۢ وَلَا",22],["6:71:22",136,"ٱلْأَرْضِ","the earth","ٱسْتَهْوَتْهُ ٱلشَّيَـٰطِينُ فِى","حَيْرَانَ لَهُۥٓ أَصْحَـٰبٌۭ",22],["6:73:5",136,"وَٱلْأَرْضَ","and the earth","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ","بِٱلْحَقِّ ۖ وَيَوْمَ يَقُولُ",22],["6:75:6",137,"وَٱلْأَرْضِ","and the earth","إِبْرَٰهِيمَ مَلَكُوتَ ٱلسَّمَـٰوَٰتِ","وَلِيَكُونَ مِنَ ٱلْمُوقِنِينَ",22],["6:79:7",137,"وَٱلْأَرْضَ","and the earth","لِلَّذِى فَطَرَ ٱلسَّمَـٰوَٰتِ","حَنِيفًۭا ۖ وَمَآ أَنَا۠",22],["6:101:3",140,"وَٱلْأَرْضِ ۖ","and the earth","بَدِيعُ ٱلسَّمَـٰوَٰتِ","أَنَّىٰ يَكُونُ لَهُۥ",22],["6:116:6",142,"ٱلْأَرْضِ","the earth","أَكْثَرَ مَن فِى","يُضِلُّوكَ عَن سَبِيلِ",22],["6:165:5",150,"ٱلْأَرْضِ","(of) the earth","ٱلَّذِى جَعَلَكُمْ خَلَـٰٓئِفَ","وَرَفَعَ بَعْضَكُمْ فَوْقَ",22],["7:10:4",151,"ٱلْأَرْضِ","the earth","وَلَقَدْ مَكَّنَّـٰكُمْ فِى","وَجَعَلْنَا لَكُمْ فِيهَا",22],["7:24:8",153,"ٱلْأَرْضِ","the earth","عَدُوٌّۭ ۖ وَلَكُمْ فِى","مُسْتَقَرٌّۭ وَمَتَـٰعٌ إِلَىٰ",22],["7:54:7",157,"وَٱلْأَرْضَ","and the earth","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ","فِى سِتَّةِ أَيَّامٍۢ",22],["7:56:4",157,"ٱلْأَرْضِ","the earth","وَلَا تُفْسِدُوا۟ فِى","بَعْدَ إِصْلَـٰحِهَا وَٱدْعُوهُ",22],["7:73:27",159,"أَرْضِ","(the) earth","فَذَرُوهَا تَأْكُلْ فِىٓ","ٱللَّهِ ۖ وَلَا تَمَسُّوهَا",22],["7:74:10",160,"ٱلْأَرْضِ","the earth","عَادٍۢ وَبَوَّأَكُمْ فِى","تَتَّخِذُونَ مِن سُهُولِهَا",22],["7:74:24",160,"ٱلْأَرْضِ","(the) earth","وَلَا تَعْثَوْا۟ فِى","مُفْسِدِينَ",22],["7:85:29",161,"ٱلْأَرْضِ","the earth","وَلَا تُفْسِدُوا۟ فِى","بَعْدَ إِصْلَـٰحِهَا ۚ ذَٰلِكُمْ",22],["7:96:12",163,"وَٱلْأَرْضِ","and the earth","بَرَكَـٰتٍۢ مِّنَ ٱلسَّمَآءِ","وَلَـٰكِن كَذَّبُوا۟ فَأَخَذْنَـٰهُم",22],["7:100:5",163,"ٱلْأَرْضَ","the land","يَهْدِ لِلَّذِينَ يَرِثُونَ","مِنۢ بَعْدِ أَهْلِهَآ",22],["7:110:5",164,"أَرْضِكُمْ ۖ","your land","أَن يُخْرِجَكُم مِّنْ","فَمَاذَا تَأْمُرُونَ",22],["7:127:11",165,"ٱلْأَرْضِ","the earth","وَقَوْمَهُۥ لِيُفْسِدُوا۟ فِى","وَيَذَرَكَ وَءَالِهَتَكَ ۚ قَالَ",22],["7:128:8",165,"ٱلْأَرْضَ","the earth","بِٱللَّهِ وَٱصْبِرُوٓا۟ ۖ إِنَّ","لِلَّهِ يُورِثُهَا مَن",22],["7:129:19",165,"ٱلْأَرْضِ","the earth","عَدُوَّكُمْ وَيَسْتَخْلِفَكُمْ فِى","فَيَنظُرَ كَيْفَ تَعْمَلُونَ",22],["7:137:7",166,"ٱلْأَرْضِ","(of) the land","كَانُوا۟ يُسْتَضْعَفُونَ مَشَـٰرِقَ","وَمَغَـٰرِبَهَا ٱلَّتِى بَـٰرَكْنَا",22],["7:146:7",168,"ٱلْأَرْضِ","the earth","ٱلَّذِينَ يَتَكَبَّرُونَ فِى","بِغَيْرِ ٱلْحَقِّ وَإِن",22],["7:158:13",170,"وَٱلْأَرْضِ ۖ","and the earth","لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ","لَآ إِلَـٰهَ إِلَّا",22],["7:168:3",172,"ٱلْأَرْضِ","the earth","وَقَطَّعْنَـٰهُمْ فِى","أُمَمًۭا ۖ مِّنْهُمُ ٱلصَّـٰلِحُونَ",22],["7:176:8",173,"ٱلْأَرْضِ","the earth","وَلَـٰكِنَّهُۥٓ أَخْلَدَ إِلَى","وَٱتَّبَعَ هَوَىٰهُ ۚ فَمَثَلُهُۥ",22],["7:185:6",174,"وَٱلْأَرْضِ","and the earth","فِى مَلَكُوتِ ٱلسَّمَـٰوَٰتِ","وَمَا خَلَقَ ٱللَّهُ",22],["7:187:19",174,"وَٱلْأَرْضِ ۚ","and the earth","ثَقُلَتْ فِى ٱلسَّمَـٰوَٰتِ","لَا تَأْتِيكُمْ إِلَّا",22],["8:26:7",180,"ٱلْأَرْضِ","the earth","قَلِيلٌۭ مُّسْتَضْعَفُونَ فِى","تَخَافُونَ أَن يَتَخَطَّفَكُمُ",22],["8:63:8",185,"ٱلْأَرْضِ","the earth","أَنفَقْتَ مَا فِى","جَمِيعًۭا مَّآ أَلَّفْتَ",22],["8:67:11",185,"ٱلْأَرْضِ ۚ","the land","حَتَّىٰ يُثْخِنَ فِى","تُرِيدُونَ عَرَضَ ٱلدُّنْيَا",22],["8:73:11",186,"ٱلْأَرْضِ","the earth","تَكُن فِتْنَةٌۭ فِى","وَفَسَادٌۭ كَبِيرٌۭ",22],["9:2:3",187,"ٱلْأَرْضِ","the land","فَسِيحُوا۟ فِى","أَرْبَعَةَ أَشْهُرٍۢ وَٱعْلَمُوٓا۟",22],["9:25:18",190,"ٱلْأَرْضُ","the earth","شَيْـًۭٔا وَضَاقَتْ عَلَيْكُمُ","بِمَا رَحُبَتْ ثُمَّ",22],["9:36:15",192,"وَٱلْأَرْضَ","and the earth","يَوْمَ خَلَقَ ٱلسَّمَـٰوَٰتِ","مِنْهَآ أَرْبَعَةٌ حُرُمٌۭ ۚ",22],["9:38:15",193,"ٱلْأَرْضِ ۚ","the earth","ٱللَّهِ ٱثَّاقَلْتُمْ إِلَى","أَرَضِيتُم بِٱلْحَيَوٰةِ ٱلدُّنْيَا",22],["9:74:42",199,"ٱلْأَرْضِ","the earth","وَمَا لَهُمْ فِى","مِن وَلِىٍّۢ وَلَا",22],["9:116:6",205,"وَٱلْأَرْضِ ۖ","and the earth","لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ","يُحْىِۦ وَيُمِيتُ ۚ وَمَا",22],["9:118:9",206,"ٱلْأَرْضُ","the earth","إِذَا ضَاقَتْ عَلَيْهِمُ","بِمَا رَحُبَتْ وَضَاقَتْ",22],["10:3:7",208,"وَٱلْأَرْضَ","and the earth","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ","فِى سِتَّةِ أَيَّامٍۢ",22],["10:6:11",208,"وَٱلْأَرْضِ","and the earth","ٱللَّهُ فِى ٱلسَّمَـٰوَٰتِ","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يَتَّقُونَ",22],["10:14:5",209,"ٱلْأَرْضِ","the earth","جَعَلْنَـٰكُمْ خَلَـٰٓئِفَ فِى","مِنۢ بَعْدِهِمْ لِنَنظُرَ",22],["10:18:25",210,"ٱلْأَرْضِ ۚ","the earth","ٱلسَّمَـٰوَٰتِ وَلَا فِى","سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ عَمَّا",22],["10:23:7",211,"ٱلْأَرْضِ","the earth","هُمْ يَبْغُونَ فِى","بِغَيْرِ ٱلْحَقِّ ۗ يَـٰٓأَيُّهَا",22],["10:24:12",211,"ٱلْأَرْضِ","(of) the earth","فَٱخْتَلَطَ بِهِۦ نَبَاتُ","مِمَّا يَأْكُلُ ٱلنَّاسُ",22],["10:24:20",211,"ٱلْأَرْضُ","the earth","حَتَّىٰٓ إِذَآ أَخَذَتِ","زُخْرُفَهَا وَٱزَّيَّنَتْ وَظَنَّ",22],["10:31:6",212,"وَٱلْأَرْضِ","and the earth","يَرْزُقُكُم مِّنَ ٱلسَّمَآءِ","أَمَّن يَمْلِكُ ٱلسَّمْعَ",22],["10:54:8",215,"ٱلْأَرْضِ","the earth","ظَلَمَتْ مَا فِى","لَٱفْتَدَتْ بِهِۦ ۗ وَأَسَرُّوا۟",22],["10:55:7",215,"وَٱلْأَرْضِ ۗ","and the earth","مَا فِى ٱلسَّمَـٰوَٰتِ","أَلَآ إِنَّ وَعْدَ",22],["10:61:29",215,"ٱلْأَرْضِ","the earth","مِّثْقَالِ ذَرَّةٍۢ فِى","وَلَا فِى ٱلسَّمَآءِ",22],["10:66:9",216,"ٱلْأَرْضِ ۗ","the earth","ٱلسَّمَـٰوَٰتِ وَمَن فِى","وَمَا يَتَّبِعُ ٱلَّذِينَ",22],["10:68:14",216,"ٱلْأَرْضِ ۚ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","إِنْ عِندَكُم مِّن",22],["10:78:12",217,"ٱلْأَرْضِ","the land","لَكُمَا ٱلْكِبْرِيَآءُ فِى","وَمَا نَحْنُ لَكُمَا",22],["10:83:19",218,"ٱلْأَرْضِ","the earth","فِرْعَوْنَ لَعَالٍۢ فِى","وَإِنَّهُۥ لَمِنَ ٱلْمُسْرِفِينَ",22],["10:99:7",220,"ٱلْأَرْضِ","the earth","لَـَٔامَنَ مَن فِى","كُلُّهُمْ جَمِيعًا ۚ أَفَأَنتَ",22],["10:101:6",220,"وَٱلْأَرْضِ ۚ","and the earth","مَاذَا فِى ٱلسَّمَـٰوَٰتِ","وَمَا تُغْنِى ٱلْـَٔايَـٰتُ",22],["11:6:5",222,"ٱلْأَرْضِ","the earth","مِن دَآبَّةٍۢ فِى","إِلَّا عَلَى ٱللَّهِ",22],["11:7:5",222,"وَٱلْأَرْضَ","and the earth","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ","فِى سِتَّةِ أَيَّامٍۢ",22],["11:20:6",224,"ٱلْأَرْضِ","the earth","يَكُونُوا۟ مُعْجِزِينَ فِى","وَمَا كَانَ لَهُم",22],["11:44:2",226,"يَـٰٓأَرْضُ","O earth","وَقِيلَ","ٱبْلَعِى مَآءَكِ وَيَـٰسَمَآءُ",22],["11:61:17",228,"ٱلْأَرْضِ","the earth","هُوَ أَنشَأَكُم مِّنَ","وَٱسْتَعْمَرَكُمْ فِيهَا فَٱسْتَغْفِرُوهُ",22],["11:64:10",229,"أَرْضِ","the earth","فَذَرُوهَا تَأْكُلْ فِىٓ","ٱللَّهِ وَلَا تَمَسُّوهَا",22],["11:85:13",231,"ٱلْأَرْضِ","the earth","وَلَا تَعْثَوْا۟ فِى","مُفْسِدِينَ",22],["11:107:6",233,"وَٱلْأَرْضُ","and the earth","مَا دَامَتِ ٱلسَّمَـٰوَٰتُ","إِلَّا مَا شَآءَ",22],["11:108:11",233,"وَٱلْأَرْضُ","and the earth","مَا دَامَتِ ٱلسَّمَـٰوَٰتُ","إِلَّا مَا شَآءَ",22],["11:116:13",234,"ٱلْأَرْضِ","the earth","عَنِ ٱلْفَسَادِ فِى","إِلَّا قَلِيلًۭا مِّمَّنْ",22],["11:123:4",235,"وَٱلْأَرْضِ","and the earth","وَلِلَّهِ غَيْبُ ٱلسَّمَـٰوَٰتِ","وَإِلَيْهِ يُرْجَعُ ٱلْأَمْرُ",22],["12:9:5",236,"أَرْضًۭا","(to) a land","يُوسُفَ أَوِ ٱطْرَحُوهُ","يَخْلُ لَكُمْ وَجْهُ",22],["12:21:19",237,"ٱلْأَرْضِ","the land","مَكَّنَّا لِيُوسُفَ فِى","وَلِنُعَلِّمَهُۥ مِن تَأْوِيلِ",22],["12:55:5",242,"ٱلْأَرْضِ ۖ","(of) the land","ٱجْعَلْنِى عَلَىٰ خَزَآئِنِ","إِنِّى حَفِيظٌ عَلِيمٌۭ",22],["12:56:5",242,"ٱلْأَرْضِ","the land","مَكَّنَّا لِيُوسُفَ فِى","يَتَبَوَّأُ مِنْهَا حَيْثُ",22],["12:73:9",244,"ٱلْأَرْضِ","the land","جِئْنَا لِنُفْسِدَ فِى","وَمَا كُنَّا سَـٰرِقِينَ",22],["12:80:26",245,"ٱلْأَرْضَ","the land","يُوسُفَ ۖ فَلَنْ أَبْرَحَ","حَتَّىٰ يَأْذَنَ لِىٓ",22],["12:101:12",247,"وَٱلْأَرْضِ","and the earth","ٱلْأَحَادِيثِ ۚ فَاطِرَ ٱلسَّمَـٰوَٰتِ","أَنتَ وَلِىِّۦ فِى",22],["12:105:6",248,"وَٱلْأَرْضِ","and the earth","ءَايَةٍۢ فِى ٱلسَّمَـٰوَٰتِ","يَمُرُّونَ عَلَيْهَا وَهُمْ",22],["12:109:15",248,"ٱلْأَرْضِ","the earth","أَفَلَمْ يَسِيرُوا۟ فِى","فَيَنظُرُوا۟ كَيْفَ كَانَ",22],["13:3:4",249,"ٱلْأَرْضَ","the earth","وَهُوَ ٱلَّذِى مَدَّ","وَجَعَلَ فِيهَا رَوَٰسِىَ",22],["13:4:2",249,"ٱلْأَرْضِ","the earth","وَفِى","قِطَعٌۭ مُّتَجَـٰوِرَٰتٌۭ وَجَنَّـٰتٌۭ",22],["13:15:6",251,"وَٱلْأَرْضِ","and the earth","مَن فِى ٱلسَّمَـٰوَٰتِ","طَوْعًۭا وَكَرْهًۭا وَظِلَـٰلُهُم",22],["13:16:5",251,"وَٱلْأَرْضِ","and the earth","مَن رَّبُّ ٱلسَّمَـٰوَٰتِ","قُلِ ٱللَّهُ ۚ قُلْ",22],["13:17:38",251,"ٱلْأَرْضِ ۚ","the earth","ٱلنَّاسَ فَيَمْكُثُ فِى","كَذَٰلِكَ يَضْرِبُ ٱللَّهُ",22],["13:18:14",251,"ٱلْأَرْضِ","the earth","لَهُم مَّا فِى","جَمِيعًۭا وَمِثْلَهُۥ مَعَهُۥ",22],["13:25:17",252,"ٱلْأَرْضِ ۙ","the earth","يُوصَلَ وَيُفْسِدُونَ فِى","أُو۟لَـٰٓئِكَ لَهُمُ ٱللَّعْنَةُ",22],["13:31:10",253,"ٱلْأَرْضُ","the earth","أَوْ قُطِّعَتْ بِهِ","أَوْ كُلِّمَ بِهِ",22],["13:33:20",253,"ٱلْأَرْضِ","the earth","لَا يَعْلَمُ فِى","أَم بِظَـٰهِرٍۢ مِّنَ",22],["13:41:5",254,"ٱلْأَرْضَ","(to) the land","يَرَوْا۟ أَنَّا نَأْتِى","نَنقُصُهَا مِنْ أَطْرَافِهَا ۚ",22],["14:2:9",255,"ٱلْأَرْضِ ۗ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَوَيْلٌۭ لِّلْكَـٰفِرِينَ مِنْ",22],["14:8:8",256,"ٱلْأَرْضِ","the earth","أَنتُمْ وَمَن فِى","جَمِيعًۭا فَإِنَّ ٱللَّهَ",22],["14:10:8",256,"وَٱلْأَرْضِ ۖ","and the earth","شَكٌّۭ فَاطِرِ ٱلسَّمَـٰوَٰتِ","يَدْعُوكُمْ لِيَغْفِرَ لَكُم",22],["14:13:7",257,"أَرْضِنَآ","our land","لِرُسُلِهِمْ لَنُخْرِجَنَّكُم مِّنْ","أَوْ لَتَعُودُنَّ فِى",22],["14:14:2",257,"ٱلْأَرْضَ","(in) the land","وَلَنُسْكِنَنَّكُمُ","مِنۢ بَعْدِهِمْ ۚ ذَٰلِكَ",22],["14:19:7",258,"وَٱلْأَرْضَ","and the earth","ٱللَّهَ خَلَقَ ٱلسَّمَـٰوَٰتِ","بِٱلْحَقِّ ۚ إِن يَشَأْ",22],["14:26:9",259,"ٱلْأَرْضِ","(of) the earth","ٱجْتُثَّتْ مِن فَوْقِ","مَا لَهَا مِن",22],["14:32:5",259,"وَٱلْأَرْضَ","and the earth","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ","وَأَنزَلَ مِنَ ٱلسَّمَآءِ",22],["14:38:15",260,"ٱلْأَرْضِ","the earth","مِن شَىْءٍۢ فِى","وَلَا فِى ٱلسَّمَآءِ",22],["14:48:3",261,"ٱلْأَرْضُ","the earth","يَوْمَ تُبَدَّلُ","غَيْرَ ٱلْأَرْضِ وَٱلسَّمَـٰوَٰتُ ۖ",22],["14:48:5",261,"ٱلْأَرْضِ","the earth","تُبَدَّلُ ٱلْأَرْضُ غَيْرَ","وَٱلسَّمَـٰوَٰتُ ۖ وَبَرَزُوا۟ لِلَّهِ",22],["15:19:1",263,"وَٱلْأَرْضَ","And the earth","","مَدَدْنَـٰهَا وَأَلْقَيْنَا فِيهَا",22],["15:39:8",264,"ٱلْأَرْضِ","the earth","لَأُزَيِّنَنَّ لَهُمْ فِى","وَلَأُغْوِيَنَّهُمْ أَجْمَعِينَ",22],["15:85:4",266,"وَٱلْأَرْضَ","and the earth","وَمَا خَلَقْنَا ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَآ إِلَّا",22],["16:3:3",267,"وَٱلْأَرْضَ","and the earth","خَلَقَ ٱلسَّمَـٰوَٰتِ","بِٱلْحَقِّ ۚ تَعَـٰلَىٰ عَمَّا",22],["16:13:5",268,"ٱلْأَرْضِ","the earth","ذَرَأَ لَكُمْ فِى","مُخْتَلِفًا أَلْوَٰنُهُۥٓ ۗ إِنَّ",22],["16:15:3",269,"ٱلْأَرْضِ","the earth","وَأَلْقَىٰ فِى","رَوَٰسِىَ أَن تَمِيدَ",22],["16:36:23",271,"ٱلْأَرْضِ","the earth","ٱلضَّلَـٰلَةُ ۚ فَسِيرُوا۟ فِى","فَٱنظُرُوا۟ كَيْفَ كَانَ",22],["16:45:9",272,"ٱلْأَرْضَ","the earth","يَخْسِفَ ٱللَّهُ بِهِمُ","أَوْ يَأْتِيَهُمُ ٱلْعَذَابُ",22],["16:49:8",272,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","مِن دَآبَّةٍۢ وَٱلْمَلَـٰٓئِكَةُ",22],["16:52:5",272,"وَٱلْأَرْضِ","and the earth","مَا فِى ٱلسَّمَـٰوَٰتِ","وَلَهُ ٱلدِّينُ وَاصِبًا ۚ",22],["16:65:8",274,"ٱلْأَرْضَ","(to) the earth","مَآءًۭ فَأَحْيَا بِهِ","بَعْدَ مَوْتِهَآ ۚ إِنَّ",22],["16:73:12",275,"وَٱلْأَرْضِ","and the earth","رِزْقًۭا مِّنَ ٱلسَّمَـٰوَٰتِ","شَيْـًۭٔا وَلَا يَسْتَطِيعُونَ",22],["16:77:4",275,"وَٱلْأَرْضِ ۚ","and the earth","وَلِلَّهِ غَيْبُ ٱلسَّمَـٰوَٰتِ","وَمَآ أَمْرُ ٱلسَّاعَةِ",22],["17:4:9",282,"ٱلْأَرْضِ","the earth","ٱلْكِتَـٰبِ لَتُفْسِدُنَّ فِى","مَرَّتَيْنِ وَلَتَعْلُنَّ عُلُوًّۭا",22],["17:37:4",285,"ٱلْأَرْضِ","the earth","وَلَا تَمْشِ فِى","مَرَحًا ۖ إِنَّكَ لَن",22],["17:37:9",285,"ٱلْأَرْضَ","the earth","إِنَّكَ لَن تَخْرِقَ","وَلَن تَبْلُغَ ٱلْجِبَالَ",22],["17:44:5",286,"وَٱلْأَرْضُ","and the earth","لَهُ ٱلسَّمَـٰوَٰتُ ٱلسَّبْعُ","وَمَن فِيهِنَّ ۚ وَإِن",22],["17:55:6",287,"وَٱلْأَرْضِ ۗ","and the earth","بِمَن فِى ٱلسَّمَـٰوَٰتِ","وَلَقَدْ فَضَّلْنَا بَعْضَ",22],["17:76:5",290,"ٱلْأَرْضِ","the land","كَادُوا۟ لَيَسْتَفِزُّونَكَ مِنَ","لِيُخْرِجُوكَ مِنْهَا ۖ وَإِذًۭا",22],["17:90:9",291,"ٱلْأَرْضِ","the earth","تَفْجُرَ لَنَا مِنَ","يَنۢبُوعًا",22],["17:95:5",291,"ٱلْأَرْضِ","the earth","لَّوْ كَانَ فِى","مَلَـٰٓئِكَةٌۭ يَمْشُونَ مُطْمَئِنِّينَ",22],["17:99:8",292,"وَٱلْأَرْضَ","and the earth","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ","قَادِرٌ عَلَىٰٓ أَن",22],["17:102:10",292,"وَٱلْأَرْضِ","and the earth","إِلَّا رَبُّ ٱلسَّمَـٰوَٰتِ","بَصَآئِرَ وَإِنِّى لَأَظُنُّكَ",22],["17:103:5",292,"ٱلْأَرْضِ","the land","أَن يَسْتَفِزَّهُم مِّنَ","فَأَغْرَقْنَـٰهُ وَمَن مَّعَهُۥ",22],["17:104:7",292,"ٱلْأَرْضَ","(in) the land","لِبَنِىٓ إِسْرَٰٓءِيلَ ٱسْكُنُوا۟","فَإِذَا جَآءَ وَعْدُ",22],["18:7:5",294,"ٱلْأَرْضِ","the earth","جَعَلْنَا مَا عَلَى","زِينَةًۭ لَّهَا لِنَبْلُوَهُمْ",22],["18:14:10",294,"وَٱلْأَرْضِ","and the earth","رَبُّنَا رَبُّ ٱلسَّمَـٰوَٰتِ","لَن نَّدْعُوَا۟ مِن",22],["18:26:9",296,"وَٱلْأَرْضِ ۖ","and the earth","لَهُۥ غَيْبُ ٱلسَّمَـٰوَٰتِ","أَبْصِرْ بِهِۦ وَأَسْمِعْ ۚ",22],["18:45:13",298,"ٱلْأَرْضِ","(of) the earth","فَٱخْتَلَطَ بِهِۦ نَبَاتُ","فَأَصْبَحَ هَشِيمًۭا تَذْرُوهُ",22],["18:47:5",299,"ٱلْأَرْضَ","the earth","نُسَيِّرُ ٱلْجِبَالَ وَتَرَى","بَارِزَةًۭ وَحَشَرْنَـٰهُمْ فَلَمْ",22],["18:51:5",299,"وَٱلْأَرْضِ","and the earth","أَشْهَدتُّهُمْ خَلْقَ ٱلسَّمَـٰوَٰتِ","وَلَا خَلْقَ أَنفُسِهِمْ",22],["18:84:5",303,"ٱلْأَرْضِ","the earth","مَكَّنَّا لَهُۥ فِى","وَءَاتَيْنَـٰهُ مِن كُلِّ",22],["18:94:9",303,"ٱلْأَرْضِ","the land","وَمَأْجُوجَ مُفْسِدُونَ فِى","فَهَلْ نَجْعَلُ لَكَ",22],["19:40:4",308,"ٱلْأَرْضَ","the earth","إِنَّا نَحْنُ نَرِثُ","وَمَنْ عَلَيْهَا وَإِلَيْنَا",22],["19:65:3",310,"وَٱلْأَرْضِ","and the earth","رَّبُّ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَا فَٱعْبُدْهُ",22],["19:90:6",311,"ٱلْأَرْضُ","the earth","يَتَفَطَّرْنَ مِنْهُ وَتَنشَقُّ","وَتَخِرُّ ٱلْجِبَالُ هَدًّا",22],["19:93:6",311,"وَٱلْأَرْضِ","and the earth","مَن فِى ٱلسَّمَـٰوَٰتِ","إِلَّآ ءَاتِى ٱلرَّحْمَـٰنِ",22],["20:4:4",312,"ٱلْأَرْضَ","the earth","تَنزِيلًۭا مِّمَّنْ خَلَقَ","وَٱلسَّمَـٰوَٰتِ ٱلْعُلَى",22],["20:6:7",312,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَمَا بَيْنَهُمَا وَمَا",22],["20:53:4",315,"ٱلْأَرْضَ","the earth","ٱلَّذِى جَعَلَ لَكُمُ","مَهْدًۭا وَسَلَكَ لَكُمْ",22],["20:57:5",315,"أَرْضِنَا","our land","أَجِئْتَنَا لِتُخْرِجَنَا مِنْ","بِسِحْرِكَ يَـٰمُوسَىٰ",22],["20:63:9",315,"أَرْضِكُم","your land","أَن يُخْرِجَاكُم مِّنْ","بِسِحْرِهِمَا وَيَذْهَبَا بِطَرِيقَتِكُمُ",22],["21:4:7",322,"وَٱلْأَرْضِ ۖ","and the earth","ٱلْقَوْلَ فِى ٱلسَّمَآءِ","وَهُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",22],["21:16:4",323,"وَٱلْأَرْضَ","and the earth","وَمَا خَلَقْنَا ٱلسَّمَآءَ","وَمَا بَيْنَهُمَا لَـٰعِبِينَ",22],["21:19:5",323,"وَٱلْأَرْضِ ۚ","and the earth","مَن فِى ٱلسَّمَـٰوَٰتِ","وَمَنْ عِندَهُۥ لَا",22],["21:21:5",323,"ٱلْأَرْضِ","the earth","ٱتَّخَذُوٓا۟ ءَالِهَةًۭ مِّنَ","هُمْ يُنشِرُونَ",22],["21:30:7",324,"وَٱلْأَرْضَ","and the earth","كَفَرُوٓا۟ أَنَّ ٱلسَّمَـٰوَٰتِ","كَانَتَا رَتْقًۭا فَفَتَقْنَـٰهُمَا ۖ",22],["21:31:3",324,"ٱلْأَرْضِ","the earth","وَجَعَلْنَا فِى","رَوَٰسِىَ أَن تَمِيدَ",22],["21:44:13",325,"ٱلْأَرْضَ","(to) the land","يَرَوْنَ أَنَّا نَأْتِى","نَنقُصُهَا مِنْ أَطْرَافِهَآ ۚ",22],["21:56:6",326,"وَٱلْأَرْضِ","and the earth","رَّبُّكُمْ رَبُّ ٱلسَّمَـٰوَٰتِ","ٱلَّذِى فَطَرَهُنَّ وَأَنَا۠",22],["21:71:4",327,"ٱلْأَرْضِ","the land","وَنَجَّيْنَـٰهُ وَلُوطًا إِلَى","ٱلَّتِى بَـٰرَكْنَا فِيهَا",22],["21:81:7",328,"ٱلْأَرْضِ","the land","تَجْرِى بِأَمْرِهِۦٓ إِلَى","ٱلَّتِى بَـٰرَكْنَا فِيهَا ۚ",22],["21:105:9",331,"ٱلْأَرْضَ","the earth","بَعْدِ ٱلذِّكْرِ أَنَّ","يَرِثُهَا عِبَادِىَ ٱلصَّـٰلِحُونَ",22],["22:5:57",332,"ٱلْأَرْضَ","the earth","عِلْمٍۢ شَيْـًۭٔا ۚ وَتَرَى","هَامِدَةًۭ فَإِذَآ أَنزَلْنَا",22],["22:18:12",334,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَمَن فِى","وَٱلشَّمْسُ وَٱلْقَمَرُ وَٱلنُّجُومُ",22],["22:41:5",337,"ٱلْأَرْضِ","the land","إِن مَّكَّنَّـٰهُمْ فِى","أَقَامُوا۟ ٱلصَّلَوٰةَ وَءَاتَوُا۟",22],["22:46:4",337,"ٱلْأَرْضِ","the land","أَفَلَمْ يَسِيرُوا۟ فِى","فَتَكُونَ لَهُمْ قُلُوبٌۭ",22],["22:63:10",339,"ٱلْأَرْضُ","the earth","ٱلسَّمَآءِ مَآءًۭ فَتُصْبِحُ","مُخْضَرَّةً ۗ إِنَّ ٱللَّهَ",22],["22:64:7",339,"ٱلْأَرْضِ ۗ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَإِنَّ ٱللَّهَ لَهُوَ",22],["22:65:9",340,"ٱلْأَرْضِ","the earth","لَكُم مَّا فِى","وَٱلْفُلْكَ تَجْرِى فِى",22],["22:65:20",340,"ٱلْأَرْضِ","the earth","أَن تَقَعَ عَلَى","إِلَّا بِإِذْنِهِۦٓ ۗ إِنَّ",22],["22:70:9",340,"وَٱلْأَرْضِ ۗ","and the earth","مَا فِى ٱلسَّمَآءِ","إِنَّ ذَٰلِكَ فِى",22],["23:18:8",343,"ٱلْأَرْضِ ۖ","the earth","بِقَدَرٍۢ فَأَسْكَنَّـٰهُ فِى","وَإِنَّا عَلَىٰ ذَهَابٍۭ",22],["23:71:7",346,"وَٱلْأَرْضُ","and the earth","أَهْوَآءَهُمْ لَفَسَدَتِ ٱلسَّمَـٰوَٰتُ","وَمَن فِيهِنَّ ۚ بَلْ",22],["23:79:5",347,"ٱلْأَرْضِ","the earth","ٱلَّذِى ذَرَأَكُمْ فِى","وَإِلَيْهِ تُحْشَرُونَ",22],["23:84:3",347,"ٱلْأَرْضُ","the earth","قُل لِّمَنِ","وَمَن فِيهَآ إِن",22],["23:112:5",349,"ٱلْأَرْضِ","the earth","كَمْ لَبِثْتُمْ فِى","عَدَدَ سِنِينَ",22],["24:35:4",354,"وَٱلْأَرْضِ ۚ","and the earth","۞ ٱللَّهُ نُورُ ٱلسَّمَـٰوَٰتِ","مَثَلُ نُورِهِۦ كَمِشْكَوٰةٍۢ",22],["24:41:10",355,"وَٱلْأَرْضِ","and the earth","مَن فِى ٱلسَّمَـٰوَٰتِ","وَٱلطَّيْرُ صَـٰٓفَّـٰتٍۢ ۖ كُلٌّۭ",22],["24:42:4",355,"وَٱلْأَرْضِ ۖ","and the earth","وَلِلَّهِ مُلْكُ ٱلسَّمَـٰوَٰتِ","وَإِلَى ٱللَّهِ ٱلْمَصِيرُ",22],["24:55:10",357,"ٱلْأَرْضِ","the earth","ٱلصَّـٰلِحَـٰتِ لَيَسْتَخْلِفَنَّهُمْ فِى","كَمَا ٱسْتَخْلَفَ ٱلَّذِينَ",22],["24:57:7",357,"ٱلْأَرْضِ ۚ","the earth","كَفَرُوا۟ مُعْجِزِينَ فِى","وَمَأْوَىٰهُمُ ٱلنَّارُ ۖ وَلَبِئْسَ",22],["24:64:7",359,"وَٱلْأَرْضِ ۖ","and the earth","مَا فِى ٱلسَّمَـٰوَٰتِ","قَدْ يَعْلَمُ مَآ",22],["25:2:5",359,"وَٱلْأَرْضِ","and the earth","لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ","وَلَمْ يَتَّخِذْ وَلَدًۭا",22],["25:6:8",360,"وَٱلْأَرْضِ ۚ","and the earth","ٱلسِّرَّ فِى ٱلسَّمَـٰوَٰتِ","إِنَّهُۥ كَانَ غَفُورًۭا",22],["25:59:4",365,"وَٱلْأَرْضَ","and the earth","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَا فِى",22],["25:63:6",365,"ٱلْأَرْضِ","the earth","ٱلَّذِينَ يَمْشُونَ عَلَى","هَوْنًۭا وَإِذَا خَاطَبَهُمُ",22],["26:7:4",367,"ٱلْأَرْضِ","the earth","أَوَلَمْ يَرَوْا۟ إِلَى","كَمْ أَنۢبَتْنَا فِيهَا",22],["26:24:4",368,"وَٱلْأَرْضِ","and the earth","قَالَ رَبُّ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَآ ۖ إِن",22],["26:35:5",368,"أَرْضِكُم","your land","أَن يُخْرِجَكُم مِّنْ","بِسِحْرِهِۦ فَمَاذَا تَأْمُرُونَ",22],["26:152:4",373,"ٱلْأَرْضِ","the earth","ٱلَّذِينَ يُفْسِدُونَ فِى","وَلَا يُصْلِحُونَ",22],["26:183:8",374,"ٱلْأَرْضِ","the earth","وَلَا تَعْثَوْا۟ فِى","مُفْسِدِينَ",22],["27:25:9",379,"وَٱلْأَرْضِ","and the earth","ٱلْخَبْءَ فِى ٱلسَّمَـٰوَٰتِ","وَيَعْلَمُ مَا تُخْفُونَ",22],["27:48:8",381,"ٱلْأَرْضِ","the land","رَهْطٍۢ يُفْسِدُونَ فِى","وَلَا يُصْلِحُونَ",22],["27:60:4",382,"وَٱلْأَرْضَ","and the earth","أَمَّنْ خَلَقَ ٱلسَّمَـٰوَٰتِ","وَأَنزَلَ لَكُم مِّنَ",22],["27:61:3",382,"ٱلْأَرْضَ","the earth","أَمَّن جَعَلَ","قَرَارًۭا وَجَعَلَ خِلَـٰلَهَآ",22],["27:62:10",382,"ٱلْأَرْضِ ۗ","(of) the earth","ٱلسُّوٓءَ وَيَجْعَلُكُمْ خُلَفَآءَ","أَءِلَـٰهٌۭ مَّعَ ٱللَّهِ ۚ",22],["27:64:10",383,"وَٱلْأَرْضِ ۗ","and the earth","يَرْزُقُكُم مِّنَ ٱلسَّمَآءِ","أَءِلَـٰهٌۭ مَّعَ ٱللَّهِ ۚ",22],["27:65:7",383,"وَٱلْأَرْضِ","and the earth","مَن فِى ٱلسَّمَـٰوَٰتِ","ٱلْغَيْبَ إِلَّا ٱللَّهُ ۚ",22],["27:69:4",383,"ٱلْأَرْضِ","the land","قُلْ سِيرُوا۟ فِى","فَٱنظُرُوا۟ كَيْفَ كَانَ",22],["27:75:6",383,"وَٱلْأَرْضِ","and the earth","غَآئِبَةٍۢ فِى ٱلسَّمَآءِ","إِلَّا فِى كِتَـٰبٍۢ",22],["27:82:9",384,"ٱلْأَرْضِ","the earth","لَهُمْ دَآبَّةًۭ مِّنَ","تُكَلِّمُهُمْ أَنَّ ٱلنَّاسَ",22],["27:87:11",384,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَمَن فِى","إِلَّا مَن شَآءَ",22],["28:4:5",385,"ٱلْأَرْضِ","the land","فِرْعَوْنَ عَلَا فِى","وَجَعَلَ أَهْلَهَا شِيَعًۭا",22],["28:5:8",385,"ٱلْأَرْضِ","the land","ٱلَّذِينَ ٱسْتُضْعِفُوا۟ فِى","وَنَجْعَلَهُمْ أَئِمَّةًۭ وَنَجْعَلَهُمُ",22],["28:6:4",386,"ٱلْأَرْضِ","the land","وَنُمَكِّنَ لَهُمْ فِى","وَنُرِىَ فِرْعَوْنَ وَهَـٰمَـٰنَ",22],["28:19:26",387,"ٱلْأَرْضِ","the earth","تَكُونَ جَبَّارًۭا فِى","وَمَا تُرِيدُ أَن",22],["28:39:5",390,"ٱلْأَرْضِ","the land","هُوَ وَجُنُودُهُۥ فِى","بِغَيْرِ ٱلْحَقِّ وَظَنُّوٓا۟",22],["28:57:8",392,"أَرْضِنَآ ۚ","our land","مَعَكَ نُتَخَطَّفْ مِنْ","أَوَلَمْ نُمَكِّن لَّهُمْ",22],["28:77:21",394,"ٱلْأَرْضِ ۖ","the earth","تَبْغِ ٱلْفَسَادَ فِى","إِنَّ ٱللَّهَ لَا",22],["28:81:4",395,"ٱلْأَرْضَ","the earth","فَخَسَفْنَا بِهِۦ وَبِدَارِهِ","فَمَا كَانَ لَهُۥ",22],["28:83:10",395,"ٱلْأَرْضِ","the earth","يُرِيدُونَ عُلُوًّۭا فِى","وَلَا فَسَادًۭا ۚ وَٱلْعَـٰقِبَةُ",22],["29:20:4",398,"ٱلْأَرْضِ","the earth","قُلْ سِيرُوا۟ فِى","فَٱنظُرُوا۟ كَيْفَ بَدَأَ",22],["29:22:5",398,"ٱلْأَرْضِ","the earth","أَنتُم بِمُعْجِزِينَ فِى","وَلَا فِى ٱلسَّمَآءِ ۖ",22],["29:36:15",400,"ٱلْأَرْضِ","the earth","وَلَا تَعْثَوْا۟ فِى","مُفْسِدِينَ",22],["29:39:10",401,"ٱلْأَرْضِ","the earth","بِٱلْبَيِّنَـٰتِ فَٱسْتَكْبَرُوا۟ فِى","وَمَا كَانُوا۟ سَـٰبِقِينَ",22],["29:40:17",401,"ٱلْأَرْضَ","the earth","مَّنْ خَسَفْنَا بِهِ","وَمِنْهُم مَّنْ أَغْرَقْنَا ۚ",22],["29:44:4",401,"وَٱلْأَرْضَ","and the earth","خَلَقَ ٱللَّهُ ٱلسَّمَـٰوَٰتِ","بِٱلْحَقِّ ۚ إِنَّ فِى",22],["29:52:11",402,"وَٱلْأَرْضِ ۗ","and the earth","مَا فِى ٱلسَّمَـٰوَٰتِ","وَٱلَّذِينَ ءَامَنُوا۟ بِٱلْبَـٰطِلِ",22],["29:56:5",403,"أَرْضِى","My earth","ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّ","وَٰسِعَةٌۭ فَإِيَّـٰىَ فَٱعْبُدُونِ",22],["29:61:6",403,"وَٱلْأَرْضَ","and the earth","مَّنْ خَلَقَ ٱلسَّمَـٰوَٰتِ","وَسَخَّرَ ٱلشَّمْسَ وَٱلْقَمَرَ",22],["29:63:10",403,"ٱلْأَرْضَ","(to) the earth","مَآءًۭ فَأَحْيَا بِهِ","مِنۢ بَعْدِ مَوْتِهَا",22],["30:3:3",404,"ٱلْأَرْضِ","land","فِىٓ أَدْنَى","وَهُم مِّنۢ بَعْدِ",22],["30:8:9",405,"وَٱلْأَرْضَ","and the earth","خَلَقَ ٱللَّهُ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَآ إِلَّا",22],["30:9:4",405,"ٱلْأَرْضِ","the earth","أَوَلَمْ يَسِيرُوا۟ فِى","فَيَنظُرُوا۟ كَيْفَ كَانَ",22],["30:9:17",405,"ٱلْأَرْضَ","the earth","مِنْهُمْ قُوَّةًۭ وَأَثَارُوا۟","وَعَمَرُوهَآ أَكْثَرَ مِمَّا",22],["30:18:5",406,"وَٱلْأَرْضِ","and the earth","ٱلْحَمْدُ فِى ٱلسَّمَـٰوَٰتِ","وَعَشِيًّۭا وَحِينَ تُظْهِرُونَ",22],["30:19:10",406,"ٱلْأَرْضَ","(to) the earth","مِنَ ٱلْحَىِّ وَيُحْىِ","بَعْدَ مَوْتِهَا ۚ وَكَذَٰلِكَ",22],["30:22:5",406,"وَٱلْأَرْضِ","and the earth","ءَايَـٰتِهِۦ خَلْقُ ٱلسَّمَـٰوَٰتِ","وَٱخْتِلَـٰفُ أَلْسِنَتِكُمْ وَأَلْوَٰنِكُمْ ۚ",22],["30:24:13",406,"ٱلْأَرْضَ","(to) the earth","مَآءًۭ فَيُحْىِۦ بِهِ","بَعْدَ مَوْتِهَآ ۚ إِنَّ",22],["30:25:6",407,"وَٱلْأَرْضُ","and the earth","أَن تَقُومَ ٱلسَّمَآءُ","بِأَمْرِهِۦ ۚ ثُمَّ إِذَا",22],["30:25:13",407,"ٱلْأَرْضِ","the earth","دَعَاكُمْ دَعْوَةًۭ مِّنَ","إِذَآ أَنتُمْ تَخْرُجُونَ",22],["30:26:5",407,"وَٱلْأَرْضِ ۖ","and the earth","مَن فِى ٱلسَّمَـٰوَٰتِ","كُلٌّۭ لَّهُۥ قَـٰنِتُونَ",22],["30:27:15",407,"وَٱلْأَرْضِ ۚ","and the earth","ٱلْأَعْلَىٰ فِى ٱلسَّمَـٰوَٰتِ","وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ",22],["30:42:4",409,"ٱلْأَرْضِ","the earth","قُلْ سِيرُوا۟ فِى","فَٱنظُرُوا۟ كَيْفَ كَانَ",22],["30:50:8",409,"ٱلْأَرْضَ","(to) the earth","ٱللَّهِ كَيْفَ يُحْىِ","بَعْدَ مَوْتِهَآ ۚ إِنَّ",22],["31:10:8",411,"ٱلْأَرْضِ","the earth","تَرَوْنَهَا ۖ وَأَلْقَىٰ فِى","رَوَٰسِىَ أَن تَمِيدَ",22],["31:16:17",412,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ أَوْ فِى","يَأْتِ بِهَا ٱللَّهُ ۚ",22],["31:18:8",412,"ٱلْأَرْضِ","the earth","وَلَا تَمْشِ فِى","مَرَحًا ۖ إِنَّ ٱللَّهَ",22],["31:20:12",413,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَأَسْبَغَ عَلَيْكُمْ نِعَمَهُۥ",22],["31:25:6",413,"وَٱلْأَرْضَ","and the earth","مَّنْ خَلَقَ ٱلسَّمَـٰوَٰتِ","لَيَقُولُنَّ ٱللَّهُ ۚ قُلِ",22],["31:26:5",413,"وَٱلْأَرْضِ ۚ","and the earth","مَا فِى ٱلسَّمَـٰوَٰتِ","إِنَّ ٱللَّهَ هُوَ",22],["31:27:4",413,"ٱلْأَرْضِ","the earth","وَلَوْ أَنَّمَا فِى","مِن شَجَرَةٍ أَقْلَـٰمٌۭ",22],["31:34:22",414,"أَرْضٍۢ","land","تَدْرِى نَفْسٌۢ بِأَىِّ","تَمُوتُ ۚ إِنَّ ٱللَّهَ",22],["32:4:5",415,"وَٱلْأَرْضَ","and the earth","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَا فِى",22],["32:5:6",415,"ٱلْأَرْضِ","the earth","مِنَ ٱلسَّمَآءِ إِلَى","ثُمَّ يَعْرُجُ إِلَيْهِ",22],["32:10:5",415,"ٱلْأَرْضِ","the earth","أَءِذَا ضَلَلْنَا فِى","أَءِنَّا لَفِى خَلْقٍۢ",22],["32:27:7",417,"ٱلْأَرْضِ","the land","نَسُوقُ ٱلْمَآءَ إِلَى","ٱلْجُرُزِ فَنُخْرِجُ بِهِۦ",22],["33:27:2",421,"أَرْضَهُمْ","their land","وَأَوْرَثَكُمْ","وَدِيَـٰرَهُمْ وَأَمْوَٰلَهُمْ وَأَرْضًۭا",22],["33:27:5",421,"وَأَرْضًۭا","and a land","أَرْضَهُمْ وَدِيَـٰرَهُمْ وَأَمْوَٰلَهُمْ","لَّمْ تَطَـُٔوهَا ۚ وَكَانَ",22],["33:72:6",427,"وَٱلْأَرْضِ","and the earth","ٱلْأَمَانَةَ عَلَى ٱلسَّمَـٰوَٰتِ","وَٱلْجِبَالِ فَأَبَيْنَ أَن",22],["34:1:10",428,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَلَهُ ٱلْحَمْدُ فِى",22],["34:2:5",428,"ٱلْأَرْضِ","the earth","مَا يَلِجُ فِى","وَمَا يَخْرُجُ مِنْهَا",22],["34:3:22",428,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَلَا فِى","وَلَآ أَصْغَرُ مِن",22],["34:9:11",429,"وَٱلْأَرْضِ ۚ","and the earth","خَلْفَهُم مِّنَ ٱلسَّمَآءِ","إِن نَّشَأْ نَخْسِفْ",22],["34:9:16",429,"ٱلْأَرْضَ","the earth","نَّشَأْ نَخْسِفْ بِهِمُ","أَوْ نُسْقِطْ عَلَيْهِمْ",22],["34:14:11",429,"ٱلْأَرْضِ","(of) the earth","مَوْتِهِۦٓ إِلَّا دَآبَّةُ","تَأْكُلُ مِنسَأَتَهُۥ ۖ فَلَمَّا",22],["34:22:16",430,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَلَا فِى","وَمَا لَهُمْ فِيهِمَا",22],["34:24:6",431,"وَٱلْأَرْضِ ۖ","and the earth","يَرْزُقُكُم مِّنَ ٱلسَّمَـٰوَٰتِ","قُلِ ٱللَّهُ ۖ وَإِنَّآ",22],["35:1:5",434,"وَٱلْأَرْضِ","and the earth","لِلَّهِ فَاطِرِ ٱلسَّمَـٰوَٰتِ","جَاعِلِ ٱلْمَلَـٰٓئِكَةِ رُسُلًا",22],["35:3:15",434,"وَٱلْأَرْضِ ۚ","and the earth","يَرْزُقُكُم مِّنَ ٱلسَّمَآءِ","لَآ إِلَـٰهَ إِلَّا",22],["35:9:13",435,"ٱلْأَرْضَ","the earth","مَّيِّتٍۢ فَأَحْيَيْنَا بِهِ","بَعْدَ مَوْتِهَا ۚ كَذَٰلِكَ",22],["35:38:6",438,"وَٱلْأَرْضِ ۚ","and the earth","عَـٰلِمُ غَيْبِ ٱلسَّمَـٰوَٰتِ","إِنَّهُۥ عَلِيمٌۢ بِذَاتِ",22],["35:39:6",439,"ٱلْأَرْضِ ۚ","the earth","جَعَلَكُمْ خَلَـٰٓئِفَ فِى","فَمَن كَفَرَ فَعَلَيْهِ",22],["35:40:13",439,"ٱلْأَرْضِ","the earth","مَاذَا خَلَقُوا۟ مِنَ","أَمْ لَهُمْ شِرْكٌۭ",22],["35:41:5",439,"وَٱلْأَرْضَ","and the earth","ٱللَّهَ يُمْسِكُ ٱلسَّمَـٰوَٰتِ","أَن تَزُولَا ۚ وَلَئِن",22],["35:43:3",439,"ٱلْأَرْضِ","the land","ٱسْتِكْبَارًۭا فِى","وَمَكْرَ ٱلسَّيِّئِ ۚ وَلَا",22],["35:44:4",439,"ٱلْأَرْضِ","the land","أَوَلَمْ يَسِيرُوا۟ فِى","فَيَنظُرُوا۟ كَيْفَ كَانَ",22],["35:44:26",439,"ٱلْأَرْضِ ۚ","the earth","ٱلسَّمَـٰوَٰتِ وَلَا فِى","إِنَّهُۥ كَانَ عَلِيمًۭا",22],["36:33:3",442,"ٱلْأَرْضُ","(is) the earth","وَءَايَةٌۭ لَّهُمُ","ٱلْمَيْتَةُ أَحْيَيْنَـٰهَا وَأَخْرَجْنَا",22],["36:36:8",442,"ٱلْأَرْضُ","the earth","كُلَّهَا مِمَّا تُنۢبِتُ","وَمِنْ أَنفُسِهِمْ وَمِمَّا",22],["36:81:5",445,"وَٱلْأَرْضَ","and the earth","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ","بِقَـٰدِرٍ عَلَىٰٓ أَن",22],["37:5:3",446,"وَٱلْأَرْضِ","and the earth","رَّبُّ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَا وَرَبُّ",22],["38:10:5",453,"وَٱلْأَرْضِ","and the earth","لَهُم مُّلْكُ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَا ۖ فَلْيَرْتَقُوا۟",22],["38:26:6",454,"ٱلْأَرْضِ","the earth","جَعَلْنَـٰكَ خَلِيفَةًۭ فِى","فَٱحْكُم بَيْنَ ٱلنَّاسِ",22],["38:27:4",455,"وَٱلْأَرْضَ","and the earth","وَمَا خَلَقْنَا ٱلسَّمَآءَ","وَمَا بَيْنَهُمَا بَـٰطِلًۭا ۚ",22],["38:28:9",455,"ٱلْأَرْضِ","the earth","ٱلصَّـٰلِحَـٰتِ كَٱلْمُفْسِدِينَ فِى","أَمْ نَجْعَلُ ٱلْمُتَّقِينَ",22],["38:66:3",457,"وَٱلْأَرْضِ","and the earth","رَبُّ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَا ٱلْعَزِيزُ",22],["39:5:3",458,"وَٱلْأَرْضَ","and the earth","خَلَقَ ٱلسَّمَـٰوَٰتِ","بِٱلْحَقِّ ۖ يُكَوِّرُ ٱلَّيْلَ",22],["39:10:13",459,"وَأَرْضُ","and the earth","هَـٰذِهِ ٱلدُّنْيَا حَسَنَةٌۭ ۗ","ٱللَّهِ وَٰسِعَةٌ ۗ إِنَّمَا",22],["39:21:12",460,"ٱلْأَرْضِ","the earth","فَسَلَكَهُۥ يَنَـٰبِيعَ فِى","ثُمَّ يُخْرِجُ بِهِۦ",22],["39:38:6",462,"وَٱلْأَرْضَ","and the earth","مَّنْ خَلَقَ ٱلسَّمَـٰوَٰتِ","لَيَقُولُنَّ ٱللَّهُ ۚ قُلْ",22],["39:44:8",463,"وَٱلْأَرْضِ ۖ","and the earth","لَّهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ","ثُمَّ إِلَيْهِ تُرْجَعُونَ",22],["39:46:5",463,"وَٱلْأَرْضِ","and the earth","ٱللَّهُمَّ فَاطِرَ ٱلسَّمَـٰوَٰتِ","عَـٰلِمَ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ",22],["39:47:7",463,"ٱلْأَرْضِ","the earth","ظَلَمُوا۟ مَا فِى","جَمِيعًۭا وَمِثْلَهُۥ مَعَهُۥ",22],["39:63:4",465,"وَٱلْأَرْضِ ۗ","and the earth","لَّهُۥ مَقَالِيدُ ٱلسَّمَـٰوَٰتِ","وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِ",22],["39:67:6",465,"وَٱلْأَرْضُ","while the earth","ٱللَّهَ حَقَّ قَدْرِهِۦ","جَمِيعًۭا قَبْضَتُهُۥ يَوْمَ",22],["39:68:10",466,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَمَن فِى","إِلَّا مَن شَآءَ",22],["39:69:2",466,"ٱلْأَرْضُ","the earth","وَأَشْرَقَتِ","بِنُورِ رَبِّهَا وَوُضِعَ",22],["39:74:8",466,"ٱلْأَرْضَ","the earth","صَدَقَنَا وَعْدَهُۥ وَأَوْرَثَنَا","نَتَبَوَّأُ مِنَ ٱلْجَنَّةِ",22],["40:21:4",469,"ٱلْأَرْضِ","the earth","۞ أَوَلَمْ يَسِيرُوا۟ فِى","فَيَنظُرُوا۟ كَيْفَ كَانَ",22],["40:21:20",469,"ٱلْأَرْضِ","the land","قُوَّةًۭ وَءَاثَارًۭا فِى","فَأَخَذَهُمُ ٱللَّهُ بِذُنُوبِهِمْ",22],["40:26:17",470,"ٱلْأَرْضِ","the land","أَن يُظْهِرَ فِى","ٱلْفَسَادَ",22],["40:29:7",470,"ٱلْأَرْضِ","the land","ٱلْيَوْمَ ظَـٰهِرِينَ فِى","فَمَن يَنصُرُنَا مِنۢ",22],["40:57:3",473,"وَٱلْأَرْضِ","and the earth","لَخَلْقُ ٱلسَّمَـٰوَٰتِ","أَكْبَرُ مِنْ خَلْقِ",22],["40:64:5",474,"ٱلْأَرْضَ","the earth","ٱلَّذِى جَعَلَ لَكُمُ","قَرَارًۭا وَٱلسَّمَآءَ بِنَآءًۭ",22],["40:75:6",475,"ٱلْأَرْضِ","the earth","كُنتُمْ تَفْرَحُونَ فِى","بِغَيْرِ ٱلْحَقِّ وَبِمَا",22],["40:82:4",476,"ٱلْأَرْضِ","the land","أَفَلَمْ يَسِيرُوا۟ فِى","فَيَنظُرُوا۟ كَيْفَ كَانَ",22],["40:82:19",476,"ٱلْأَرْضِ","the land","قُوَّةًۭ وَءَاثَارًۭا فِى","فَمَآ أَغْنَىٰ عَنْهُم",22],["41:9:6",477,"ٱلْأَرْضَ","the earth","لَتَكْفُرُونَ بِٱلَّذِى خَلَقَ","فِى يَوْمَيْنِ وَتَجْعَلُونَ",22],["41:11:9",477,"وَلِلْأَرْضِ","and to the earth","دُخَانٌۭ فَقَالَ لَهَا","ٱئْتِيَا طَوْعًا أَوْ",22],["41:15:5",478,"ٱلْأَرْضِ","the land","عَادٌۭ فَٱسْتَكْبَرُوا۟ فِى","بِغَيْرِ ٱلْحَقِّ وَقَالُوا۟",22],["41:39:5",481,"ٱلْأَرْضَ","the earth","ءَايَـٰتِهِۦٓ أَنَّكَ تَرَى","خَـٰشِعَةًۭ فَإِذَآ أَنزَلْنَا",22],["42:4:7",483,"ٱلْأَرْضِ ۖ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَهُوَ ٱلْعَلِىُّ ٱلْعَظِيمُ",22],["42:5:13",483,"ٱلْأَرْضِ ۗ","the earth","وَيَسْتَغْفِرُونَ لِمَن فِى","أَلَآ إِنَّ ٱللَّهَ",22],["42:11:3",484,"وَٱلْأَرْضِ ۚ","and the earth","فَاطِرُ ٱلسَّمَـٰوَٰتِ","جَعَلَ لَكُم مِّنْ",22],["42:12:4",484,"وَٱلْأَرْضِ ۖ","and the earth","لَهُۥ مَقَالِيدُ ٱلسَّمَـٰوَٰتِ","يَبْسُطُ ٱلرِّزْقَ لِمَن",22],["42:27:8",486,"ٱلْأَرْضِ","the earth","لِعِبَادِهِۦ لَبَغَوْا۟ فِى","وَلَـٰكِن يُنَزِّلُ بِقَدَرٍۢ",22],["42:29:5",486,"وَٱلْأَرْضِ","and the earth","ءَايَـٰتِهِۦ خَلْقُ ٱلسَّمَـٰوَٰتِ","وَمَا بَثَّ فِيهِمَا",22],["42:31:5",486,"ٱلْأَرْضِ ۖ","the earth","أَنتُم بِمُعْجِزِينَ فِى","وَمَا لَكُم مِّن",22],["42:42:9",487,"ٱلْأَرْضِ","the earth","ٱلنَّاسَ وَيَبْغُونَ فِى","بِغَيْرِ ٱلْحَقِّ ۚ أُو۟لَـٰٓئِكَ",22],["42:49:4",488,"وَٱلْأَرْضِ ۚ","and the earth","لِّلَّهِ مُلْكُ ٱلسَّمَـٰوَٰتِ","يَخْلُقُ مَا يَشَآءُ ۚ",22],["42:53:10",489,"ٱلْأَرْضِ ۗ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","أَلَآ إِلَى ٱللَّهِ",22],["43:9:6",489,"وَٱلْأَرْضَ","and the earth","مَّنْ خَلَقَ ٱلسَّمَـٰوَٰتِ","لَيَقُولُنَّ خَلَقَهُنَّ ٱلْعَزِيزُ",22],["43:10:4",489,"ٱلْأَرْضَ","the earth","ٱلَّذِى جَعَلَ لَكُمُ","مَهْدًۭا وَجَعَلَ لَكُمْ",22],["43:60:7",493,"ٱلْأَرْضِ","the earth","مِنكُم مَّلَـٰٓئِكَةًۭ فِى","يَخْلُفُونَ",22],["43:82:4",495,"وَٱلْأَرْضِ","and the earth","سُبْحَـٰنَ رَبِّ ٱلسَّمَـٰوَٰتِ","رَبِّ ٱلْعَرْشِ عَمَّا",22],["43:84:7",495,"ٱلْأَرْضِ","the earth","ٱلسَّمَآءِ إِلَـٰهٌۭ وَفِى","إِلَـٰهٌۭ ۚ وَهُوَ ٱلْحَكِيمُ",22],["43:85:6",495,"وَٱلْأَرْضِ","and the earth","لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَا وَعِندَهُۥ",22],["44:7:3",496,"وَٱلْأَرْضِ","and the earth","رَبِّ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَآ ۖ إِن",22],["44:29:5",497,"وَٱلْأَرْضُ","and the earth","بَكَتْ عَلَيْهِمُ ٱلسَّمَآءُ","وَمَا كَانُوا۟ مُنظَرِينَ",22],["44:38:4",497,"وَٱلْأَرْضَ","and the earth","وَمَا خَلَقْنَا ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَا لَـٰعِبِينَ",22],["45:3:4",499,"وَٱلْأَرْضِ","and the earth","إِنَّ فِى ٱلسَّمَـٰوَٰتِ","لَـَٔايَـٰتٍۢ لِّلْمُؤْمِنِينَ",22],["45:5:13",499,"ٱلْأَرْضَ","(to) the earth","رِّزْقٍۢ فَأَحْيَا بِهِ","بَعْدَ مَوْتِهَا وَتَصْرِيفِ",22],["45:13:8",499,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","جَمِيعًۭا مِّنْهُ ۚ إِنَّ",22],["45:22:4",500,"وَٱلْأَرْضَ","and the earth","وَخَلَقَ ٱللَّهُ ٱلسَّمَـٰوَٰتِ","بِٱلْحَقِّ وَلِتُجْزَىٰ كُلُّ",22],["45:27:4",501,"وَٱلْأَرْضِ ۚ","and the earth","وَلِلَّهِ مُلْكُ ٱلسَّمَـٰوَٰتِ","وَيَوْمَ تَقُومُ ٱلسَّاعَةُ",22],["45:36:6",502,"ٱلْأَرْضِ","(of) the earth","رَبِّ ٱلسَّمَـٰوَٰتِ وَرَبِّ","رَبِّ ٱلْعَـٰلَمِينَ",22],["45:37:5",502,"وَٱلْأَرْضِ ۖ","and the earth","ٱلْكِبْرِيَآءُ فِى ٱلسَّمَـٰوَٰتِ","وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ",22],["46:3:4",502,"وَٱلْأَرْضَ","and the earth","مَا خَلَقْنَا ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَآ إِلَّا",22],["46:4:12",502,"ٱلْأَرْضِ","the earth","مَاذَا خَلَقُوا۟ مِنَ","أَمْ لَهُمْ شِرْكٌۭ",22],["46:20:22",504,"ٱلْأَرْضِ","the earth","كُنتُمْ تَسْتَكْبِرُونَ فِى","بِغَيْرِ ٱلْحَقِّ وَبِمَا",22],["46:32:9",506,"ٱلْأَرْضِ","the earth","فَلَيْسَ بِمُعْجِزٍۢ فِى","وَلَيْسَ لَهُۥ مِن",22],["46:33:8",506,"وَٱلْأَرْضَ","and the earth","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ","وَلَمْ يَعْىَ بِخَلْقِهِنَّ",22],["47:10:4",507,"ٱلْأَرْضِ","the earth","۞ أَفَلَمْ يَسِيرُوا۟ فِى","فَيَنظُرُوا۟ كَيْفَ كَانَ",22],["47:22:8",509,"ٱلْأَرْضِ","the earth","أَن تُفْسِدُوا۟ فِى","وَتُقَطِّعُوٓا۟ أَرْحَامَكُمْ",22],["48:4:15",511,"وَٱلْأَرْضِ ۚ","and the earth","وَلِلَّهِ جُنُودُ ٱلسَّمَـٰوَٰتِ","وَكَانَ ٱللَّهُ عَلِيمًا",22],["48:7:4",511,"وَٱلْأَرْضِ ۚ","and the earth","وَلِلَّهِ جُنُودُ ٱلسَّمَـٰوَٰتِ","وَكَانَ ٱللَّهُ عَزِيزًا",22],["48:14:4",512,"وَٱلْأَرْضِ ۚ","and the earth","وَلِلَّهِ مُلْكُ ٱلسَّمَـٰوَٰتِ","يَغْفِرُ لِمَن يَشَآءُ",22],["49:16:12",517,"ٱلْأَرْضِ ۚ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَٱللَّهُ بِكُلِّ شَىْءٍ",22],["49:18:6",517,"وَٱلْأَرْضِ ۚ","and the earth","يَعْلَمُ غَيْبَ ٱلسَّمَـٰوَٰتِ","وَٱللَّهُ بَصِيرٌۢ بِمَا",22],["50:4:5",518,"ٱلْأَرْضُ","the earth","عَلِمْنَا مَا تَنقُصُ","مِنْهُمْ ۖ وَعِندَنَا كِتَـٰبٌ",22],["50:7:1",518,"وَٱلْأَرْضَ","And the earth","","مَدَدْنَـٰهَا وَأَلْقَيْنَا فِيهَا",22],["50:38:4",520,"وَٱلْأَرْضَ","and the earth","وَلَقَدْ خَلَقْنَا ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَا فِى",22],["50:44:3",520,"ٱلْأَرْضُ","the earth","يَوْمَ تَشَقَّقُ","عَنْهُمْ سِرَاعًۭا ۚ ذَٰلِكَ",22],["51:20:2",521,"ٱلْأَرْضِ","the earth","وَفِى","ءَايَـٰتٌۭ لِّلْمُوقِنِينَ",22],["51:23:3",521,"وَٱلْأَرْضِ","and the earth","فَوَرَبِّ ٱلسَّمَآءِ","إِنَّهُۥ لَحَقٌّۭ مِّثْلَ",22],["51:48:1",522,"وَٱلْأَرْضَ","And the earth","","فَرَشْنَـٰهَا فَنِعْمَ ٱلْمَـٰهِدُونَ",22],["52:36:4",525,"وَٱلْأَرْضَ ۚ","and the earth","أَمْ خَلَقُوا۟ ٱلسَّمَـٰوَٰتِ","بَل لَّا يُوقِنُونَ",22],["53:31:7",527,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","لِيَجْزِىَ ٱلَّذِينَ أَسَـٰٓـُٔوا۟",22],["53:32:18",527,"ٱلْأَرْضِ","the earth","إِذْ أَنشَأَكُم مِّنَ","وَإِذْ أَنتُمْ أَجِنَّةٌۭ",22],["54:12:2",529,"ٱلْأَرْضَ","the earth","وَفَجَّرْنَا","عُيُونًۭا فَٱلْتَقَى ٱلْمَآءُ",22],["55:10:1",531,"وَٱلْأَرْضَ","And the earth","","وَضَعَهَا لِلْأَنَامِ",22],["55:29:5",532,"وَٱلْأَرْضِ ۚ","and the earth","مَن فِى ٱلسَّمَـٰوَٰتِ","كُلَّ يَوْمٍ هُوَ",22],["55:33:11",532,"وَٱلْأَرْضِ","and the earth","مِنْ أَقْطَارِ ٱلسَّمَـٰوَٰتِ","فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ",22],["56:4:3",534,"ٱلْأَرْضُ","the earth","إِذَا رُجَّتِ","رَجًّۭا",22],["57:1:6",537,"وَٱلْأَرْضِ ۖ","and the earth","مَا فِى ٱلسَّمَـٰوَٰتِ","وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ",22],["57:2:4",537,"وَٱلْأَرْضِ ۖ","and the earth","لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ","يُحْىِۦ وَيُمِيتُ ۖ وَهُوَ",22],["57:4:5",538,"وَٱلْأَرْضَ","and the earth","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ","فِى سِتَّةِ أَيَّامٍۢ",22],["57:4:17",538,"ٱلْأَرْضِ","the earth","مَا يَلِجُ فِى","وَمَا يَخْرُجُ مِنْهَا",22],["57:5:4",538,"وَٱلْأَرْضِ ۚ","and the earth","لَّهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ","وَإِلَى ٱللَّهِ تُرْجَعُ",22],["57:10:11",538,"وَٱلْأَرْضِ ۚ","and the earth","وَلِلَّهِ مِيرَٰثُ ٱلسَّمَـٰوَٰتِ","لَا يَسْتَوِى مِنكُم",22],["57:17:5",539,"ٱلْأَرْضَ","(to) the earth","أَنَّ ٱللَّهَ يُحْىِ","بَعْدَ مَوْتِهَا ۚ قَدْ",22],["57:21:10",540,"وَٱلْأَرْضِ","and the earth","عَرْضُهَا كَعَرْضِ ٱلسَّمَآءِ","أُعِدَّتْ لِلَّذِينَ ءَامَنُوا۟",22],["57:22:6",540,"ٱلْأَرْضِ","the earth","مِن مُّصِيبَةٍۢ فِى","وَلَا فِىٓ أَنفُسِكُمْ",22],["58:7:11",543,"ٱلْأَرْضِ ۖ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","مَا يَكُونُ مِن",22],["59:1:8",545,"ٱلْأَرْضِ ۖ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ",22],["59:24:14",548,"وَٱلْأَرْضِ ۖ","and the earth","مَا فِى ٱلسَّمَـٰوَٰتِ","وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ",22],["61:1:8",551,"ٱلْأَرْضِ ۖ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ",22],["62:1:8",553,"ٱلْأَرْضِ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","ٱلْمَلِكِ ٱلْقُدُّوسِ ٱلْعَزِيزِ",22],["62:10:6",554,"ٱلْأَرْضِ","the land","ٱلصَّلَوٰةُ فَٱنتَشِرُوا۟ فِى","وَٱبْتَغُوا۟ مِن فَضْلِ",22],["63:7:16",555,"وَٱلْأَرْضِ","and the earth","وَلِلَّهِ خَزَآئِنُ ٱلسَّمَـٰوَٰتِ","وَلَـٰكِنَّ ٱلْمُنَـٰفِقِينَ لَا",22],["64:1:8",556,"ٱلْأَرْضِ ۖ","the earth","ٱلسَّمَـٰوَٰتِ وَمَا فِى","لَهُ ٱلْمُلْكُ وَلَهُ",22],["64:3:3",556,"وَٱلْأَرْضَ","and the earth","خَلَقَ ٱلسَّمَـٰوَٰتِ","بِٱلْحَقِّ وَصَوَّرَكُمْ فَأَحْسَنَ",22],["64:4:5",556,"وَٱلْأَرْضِ","and the earth","مَا فِى ٱلسَّمَـٰوَٰتِ","وَيَعْلَمُ مَا تُسِرُّونَ",22],["65:12:7",559,"ٱلْأَرْضِ","the earth","سَبْعَ سَمَـٰوَٰتٍۢ وَمِنَ","مِثْلَهُنَّ يَتَنَزَّلُ ٱلْأَمْرُ",22],["67:15:5",563,"ٱلْأَرْضَ","the earth","ٱلَّذِى جَعَلَ لَكُمُ","ذَلُولًۭا فَٱمْشُوا۟ فِى",22],["67:16:8",563,"ٱلْأَرْضَ","the earth","أَن يَخْسِفَ بِكُمُ","فَإِذَا هِىَ تَمُورُ",22],["67:24:6",563,"ٱلْأَرْضِ","the earth","ٱلَّذِى ذَرَأَكُمْ فِى","وَإِلَيْهِ تُحْشَرُونَ",22],["69:14:2",567,"ٱلْأَرْضُ","the earth","وَحُمِلَتِ","وَٱلْجِبَالُ فَدُكَّتَا دَكَّةًۭ",22],["70:14:3",569,"ٱلْأَرْضِ","the earth","وَمَن فِى","جَمِيعًۭا ثُمَّ يُنجِيهِ",22],["71:17:4",571,"ٱلْأَرْضِ","the earth","وَٱللَّهُ أَنۢبَتَكُم مِّنَ","نَبَاتًۭا",22],["71:19:4",571,"ٱلْأَرْضَ","the earth","وَٱللَّهُ جَعَلَ لَكُمُ","بِسَاطًۭا",22],["71:26:7",571,"ٱلْأَرْضِ","the earth","لَا تَذَرْ عَلَى","مِنَ ٱلْكَـٰفِرِينَ دَيَّارًا",22],["72:10:8",572,"ٱلْأَرْضِ","the earth","أُرِيدَ بِمَن فِى","أَمْ أَرَادَ بِهِمْ",22],["72:12:8",572,"ٱلْأَرْضِ","the earth","نُّعْجِزَ ٱللَّهَ فِى","وَلَن نُّعْجِزَهُۥ هَرَبًۭا",22],["73:14:3",574,"ٱلْأَرْضُ","the earth","يَوْمَ تَرْجُفُ","وَٱلْجِبَالُ وَكَانَتِ ٱلْجِبَالُ",22],["73:20:39",575,"ٱلْأَرْضِ","the land","وَءَاخَرُونَ يَضْرِبُونَ فِى","يَبْتَغُونَ مِن فَضْلِ",22],["77:25:3",581,"ٱلْأَرْضَ","the earth","أَلَمْ نَجْعَلِ","كِفَاتًا",22],["78:6:3",582,"ٱلْأَرْضَ","the earth","أَلَمْ نَجْعَلِ","مِهَـٰدًۭا",22],["78:37:3",583,"وَٱلْأَرْضِ","and the earth","رَّبِّ ٱلسَّمَـٰوَٰتِ","وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ",22],["79:30:1",584,"وَٱلْأَرْضَ","And the earth","","بَعْدَ ذَٰلِكَ دَحَىٰهَآ",22],["80:26:3",585,"ٱلْأَرْضَ","the earth","ثُمَّ شَقَقْنَا","شَقًّۭا",22],["84:3:2",589,"ٱلْأَرْضُ","the earth","وَإِذَا","مُدَّتْ",22],["85:9:5",590,"وَٱلْأَرْضِ ۚ","and the earth","لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ","وَٱللَّهُ عَلَىٰ كُلِّ",22],["86:12:1",591,"وَٱلْأَرْضِ","And the earth","","ذَاتِ ٱلصَّدْعِ",22],["88:20:2",592,"ٱلْأَرْضِ","the earth","وَإِلَى","كَيْفَ سُطِحَتْ",22],["89:21:4",593,"ٱلْأَرْضُ","the earth","كَلَّآ إِذَا دُكَّتِ","دَكًّۭا دَكًّۭا",22],["91:6:1",595,"وَٱلْأَرْضِ","And the earth","","وَمَا طَحَىٰهَا",22],["99:1:3",599,"ٱلْأَرْضُ","the earth","إِذَا زُلْزِلَتِ","زِلْزَالَهَا",22],["99:2:2",599,"ٱلْأَرْضُ","the earth","وَأَخْرَجَتِ","أَثْقَالَهَا",22]]