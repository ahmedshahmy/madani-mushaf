[["2:102:16",16,"ٱلسِّحْرَ","[the] magic","كَفَرُوا۟ يُعَلِّمُونَ ٱلنَّاسَ","وَمَآ أُنزِلَ عَلَى",393],["3:17:6",52,"بِٱلْأَسْحَارِ","[in the] before dawn","وَٱلْقَـٰنِتِينَ وَٱلْمُنفِقِينَ وَٱلْمُسْتَغْفِرِينَ","",1984],["5:110:62",126,"سِحْرٌۭ","magic","إِنْ هَـٰذَآ إِلَّا","مُّبِينٌۭ",393],["6:7:15",128,"سِحْرٌۭ","magic","إِنْ هَـٰذَآ إِلَّا","مُّبِينٌۭ",393],["7:109:8",164,"لَسَـٰحِرٌ","(is) surely a magician","فِرْعَوْنَ إِنَّ هَـٰذَا","عَلِيمٌۭ",474],["7:112:3",164,"سَـٰحِرٍ","magician","يَأْتُوكَ بِكُلِّ","عَلِيمٍۢ",474],["7:113:2",164,"ٱلسَّحَرَةُ","the magicians","وَجَآءَ","فِرْعَوْنَ قَالُوٓا۟ إِنَّ",474],["7:116:5",164,"سَحَرُوٓا۟","they bewitched","أَلْقُوا۟ ۖ فَلَمَّآ أَلْقَوْا۟","أَعْيُنَ ٱلنَّاسِ وَٱسْتَرْهَبُوهُمْ",1985],["7:116:10",164,"بِسِحْرٍ","with a magic","ٱلنَّاسِ وَٱسْتَرْهَبُوهُمْ وَجَآءُو","عَظِيمٍۢ",393],["7:120:2",164,"ٱلسَّحَرَةُ","the magicians","وَأُلْقِىَ","سَـٰجِدِينَ",474],["7:132:7",166,"لِّتَسْحَرَنَا","so that you bewitch us","بِهِۦ مِنْ ءَايَةٍۢ","بِهَا فَمَا نَحْنُ",1985],["10:2:25",208,"لَسَـٰحِرٌۭ","(is) surely a magician","ٱلْكَـٰفِرُونَ إِنَّ هَـٰذَا","مُّبِينٌ",474],["10:76:9",217,"لَسِحْرٌۭ","(is) surely, a magic","قَالُوٓا۟ إِنَّ هَـٰذَا","مُّبِينٌۭ",393],["10:77:7",217,"أَسِحْرٌ","Is this magic","لِلْحَقِّ لَمَّا جَآءَكُمْ ۖ","هَـٰذَا وَلَا يُفْلِحُ",393],["10:77:11",217,"ٱلسَّـٰحِرُونَ","the magicians","هَـٰذَا وَلَا يُفْلِحُ","",474],["10:79:5",218,"سَـٰحِرٍ","magician","فِرْعَوْنُ ٱئْتُونِى بِكُلِّ","عَلِيمٍۢ",474],["10:80:3",218,"ٱلسَّحَرَةُ","the magicians","فَلَمَّا جَآءَ","قَالَ لَهُم مُّوسَىٰٓ",474],["10:81:8",218,"ٱلسِّحْرُ ۖ","(is) the magic","مَا جِئْتُم بِهِ","إِنَّ ٱللَّهَ سَيُبْطِلُهُۥٓ ۖ",393],["11:7:30",222,"سِحْرٌۭ","a magic","إِنْ هَـٰذَآ إِلَّا","مُّبِينٌۭ",393],["15:15:8",262,"مَّسْحُورُونَ","bewitched","بَلْ نَحْنُ قَوْمٌۭ","",1601],["17:47:19",286,"مَّسْحُورًا","bewitched","تَتَّبِعُونَ إِلَّا رَجُلًۭا","",1601],["17:101:18",292,"مَسْحُورًۭا","(you are) bewitched","إِنِّى لَأَظُنُّكَ يَـٰ