[["3:151:14",69,"سُلْطَـٰنًۭا ۖ","any authority","لَمْ يُنَزِّلْ بِهِۦ","وَمَأْوَىٰهُمُ ٱلنَّارُ ۚ وَبِئْسَ",320],["4:90:21",92,"لَسَلَّطَهُمْ","surely He (would have) given them power","وَلَوْ شَآءَ ٱللَّهُ","عَلَيْكُمْ فَلَقَـٰتَلُوكُمْ ۚ فَإِنِ",2625],["4:91:31",92,"سُلْطَـٰنًۭا","an authority","جَعَلْنَا لَكُمْ عَلَيْهِمْ","مُّبِينًۭا",320],["4:144:16",101,"سُلْطَـٰنًۭا","an evidence","تَجْعَلُوا۟ لِلَّهِ عَلَيْكُمْ","مُّبِينًا",320],["4:153:36",102,"سُلْطَـٰنًۭا","an authority","ذَٰلِكَ ۚ وَءَاتَيْنَا مُوسَىٰ","مُّبِينًۭا",320],["6:81:15",137,"سُلْطَـٰنًۭا ۚ","any authority","يُنَزِّلْ بِهِۦ عَلَيْكُمْ","فَأَىُّ ٱلْفَرِيقَيْنِ أَحَقُّ",320],["7:33:22",154,"سُلْطَـٰنًۭا","any authority","لَمْ يُنَزِّلْ بِهِۦ","وَأَن تَقُولُوا۟ عَلَى",320],["7:71:20",159,"سُلْطَـٰنٍۢ ۚ","authority","ٱللَّهُ بِهَا مِن","فَٱنتَظِرُوٓا۟ إِنِّى مَعَكُم",320],["10:68:18",216,"سُلْطَـٰنٍۭ","authority","إِنْ عِندَكُم مِّن","بِهَـٰذَآ ۚ أَتَقُولُونَ عَلَى",320],["11:96:5",232,"وَسُلْطَـٰنٍۢ","and an authority","أَرْسَلْنَا مُوسَىٰ بِـَٔايَـٰتِنَا","مُّبِينٍ",320],["12:40:15",240,"سُلْطَـٰنٍ ۚ","authority","ٱللَّهُ بِهَا مِن","إِنِ ٱلْحُكْمُ إِلَّا",320],["14:10:32",256,"بِسُلْطَـٰنٍۢ","an authority","يَعْبُدُ ءَابَآؤُنَا فَأْتُونَا","مُّبِينٍۢ",320],["14:11:22",257,"بِسُلْطَـٰنٍ","an authority","لَنَآ أَن نَّأْتِيَكُم","إِلَّا بِإِذْنِ ٱللَّهِ ۚ",320],["14:22:18",258,"سُلْطَـٰنٍ","authority","لِىَ عَلَيْكُم مِّن","إِلَّآ أَن دَعَوْتُكُمْ",320],["15:42:6",264,"سُلْطَـٰنٌ","any authority","لَيْسَ لَكَ عَلَيْهِمْ","إِلَّا مَنِ ٱتَّبَعَكَ",320],["16:99:4",278,"سُلْطَـٰنٌ","(is) any authority","إِنَّهُۥ لَيْسَ لَهُۥ","عَلَى ٱلَّذِينَ ءَامَنُوا۟",320],["16:100:2",278,"سُلْطَـٰنُهُۥ","his authority","إِنَّمَا","عَلَى ٱلَّذِينَ يَتَوَلَّوْنَهُۥ",320],["17:33:15",285,"سُلْطَـٰنًۭا","an authority","فَقَدْ جَعَلْنَا لِوَلِيِّهِۦ","فَلَا يُسْرِف فِّى",320],["17:65:6",288,"سُلْطَـٰنٌۭ ۚ","any authority","لَيْسَ لَكَ عَلَيْهِمْ","وَكَفَىٰ بِرَبِّكَ وَكِيلًۭا",320],["17:80:13",290,"سُلْطَـٰنًۭا","an authority","لِّى مِن لَّدُنكَ","نَّصِيرًۭا",320],["18:15:10",294,"بِسُلْطَـٰنٍۭ","with an authority","لَّوْلَا يَأْتُونَ عَلَيْهِم","بَيِّنٍۢ ۖ فَمَنْ أَظْلَمُ",320],["22:71:9",340,"سُلْطَـٰنًۭا","any authority","لَمْ يُنَزِّلْ بِهِۦ","وَمَا لَيْسَ لَهُم",320],["23:45:7",345,"وَسُلْطَـٰنٍۢ","and an authority","وَأَخَاهُ هَـٰرُونَ بِـَٔايَـٰتِنَا","مُّبِينٍ",320],["27:21:8",378,"بِسُلْطَـٰنٍۢ","a reason","لَأَا۟ذْبَحَنَّهُۥٓ أَوْ لَيَأْتِيَنِّى","مُّبِينٍۢ",320],["28:35:7",389,"سُلْطَـٰنًۭا","an authority","بِأَخِيكَ وَنَجْعَلُ لَكُمَا","فَلَا يَصِلُونَ إِلَيْكُمَا ۚ",320],["30:35:4",408,"سُلْطَـٰنًۭا","an authority","أَمْ أَنزَلْنَا عَلَيْهِمْ","فَهُوَ يَتَكَلَّمُ بِمَا",320],["34:21:6",430,"سُلْطَـٰنٍ","authority","لَهُۥ عَلَيْهِم مِّن","إِلَّا لِنَعْلَمَ مَن",320],["37:30:6",447,"سُلْطَـٰنٍۭ ۖ","authority","لَنَا عَلَيْكُم مِّن","بَلْ كُنتُمْ قَوْمًۭا",320],["37:156:3",452,"سُلْطَـٰنٌۭ","an authority","أَمْ لَكُمْ","مُّبِينٌۭ",320],["40:23:5",469,"وَسُلْطَـٰنٍۢ","and an authority","أَرْسَلْنَا مُوسَىٰ بِـَٔايَـٰتِنَا","مُّبِينٍ",320],["40:35:7",471,"سُلْطَـٰنٍ","any authority","ءَايَـٰتِ ٱللَّهِ بِغَيْرِ","أَتَىٰهُمْ ۖ كَبُرَ مَقْتًا",320],["40:56:8",473,"سُلْطَـٰنٍ","any authority","ءَايَـٰتِ ٱللَّهِ بِغَيْرِ","أَتَىٰهُمْ ۙ إِن فِى",320],["44:19:8",497,"بِسُلْطَـٰنٍۢ","with an authority","ٱللَّهِ ۖ إِنِّىٓ ءَاتِيكُم","مُّبِينٍۢ",320],["51:38:7",522,"بِسُلْطَـٰنٍۢ","with an authority","أَرْسَلْنَـٰهُ إِلَىٰ فِرْعَوْنَ","مُّبِينٍۢ",320],["52:38:8",525,"بِسُلْطَـٰنٍۢ","an authority","فِيهِ ۖ فَلْيَأْتِ مُسْتَمِعُهُم","مُّبِينٍ",320],["53:23:13",526,"سُلْطَـٰنٍ ۚ","authority","ٱللَّهُ بِهَا مِن","إِن يَتَّبِعُونَ إِلَّا",320],["55:33:16",532,"بِسُلْطَـٰنٍۢ","by authority","لَا تَنفُذُونَ إِلَّا","",320],["59:6:16",546,"يُسَلِّطُ","gives power","رِكَابٍۢ وَلَـٰكِنَّ ٱللَّهَ","رُسُلَهُۥ عَلَىٰ مَن",2625],["69:29:3",567,"سُلْطَـٰنِيَهْ","my authority","هَلَكَ عَنِّى","",320]]