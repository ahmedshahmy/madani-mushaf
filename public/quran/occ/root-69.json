[["2:26:9",5,"بَعُوضَةًۭ","(of) a mosquito","يَضْرِبَ مَثَلًۭا مَّا","فَمَا فَوْقَهَا ۚ فَأَمَّا",3324],["2:36:10",6,"بَعْضُكُمْ","some of you","فِيهِ ۖ وَقُلْنَا ٱهْبِطُوا۟","لِبَعْضٍ عَدُوٌّۭ ۖ وَلَكُمْ",70],["2:36:11",6,"لِبَعْضٍ","to others","وَقُلْنَا ٱهْبِطُوا۟ بَعْضُكُمْ","عَدُوٌّۭ ۖ وَلَكُمْ فِى",70],["2:73:3",11,"بِبَعْضِهَا ۚ","with a part of it","فَقُلْنَا ٱضْرِبُوهُ","كَذَٰلِكَ يُحْىِ ٱللَّهُ",70],["2:76:9",11,"بَعْضُهُمْ","some of them","ءَامَنَّا وَإِذَا خَلَا","إِلَىٰ بَعْضٍۢ قَالُوٓا۟",70],["2:76:11",11,"بَعْضٍۢ","some (others)","خَلَا بَعْضُهُمْ إِلَىٰ","قَالُوٓا۟ أَتُحَدِّثُونَهُم بِمَا",70],["2:85:24",13,"بِبَعْضِ","in part (of)","عَلَيْكُمْ إِخْرَاجُهُمْ ۚ أَفَتُؤْمِنُونَ","ٱلْكِتَـٰبِ وَتَكْفُرُونَ بِبَعْضٍۢ ۚ",70],["2:85:27",13,"بِبَعْضٍۢ ۚ","in part","بِبَعْضِ ٱلْكِتَـٰبِ وَتَكْفُرُونَ","فَمَا جَزَآءُ مَن",70],["2:145:16",22,"بَعْضُهُم","some of them","بِتَابِعٍۢ قِبْلَتَهُمْ ۚ وَمَا","بِتَابِعٍۢ قِبْلَةَ بَعْضٍۢ ۚ",70],["2:145:19",22,"بَعْضٍۢ ۚ","(of each) other","بَعْضُهُم بِتَابِعٍۢ قِبْلَةَ","وَلَئِنِ ٱتَّبَعْتَ أَهْوَآءَهُم",70],["2:251:18",41,"بَعْضَهُم","some of them","دَفْعُ ٱللَّهِ ٱلنَّاسَ","بِبَعْضٍۢ لَّفَسَدَتِ ٱلْأَرْضُ",70],["2:251:19",41,"بِبَعْضٍۢ","with others","ٱللَّهِ ٱلنَّاسَ بَعْضَهُم","لَّفَسَدَتِ ٱلْأَرْضُ وَلَـٰكِنَّ",70],["2:253:4",42,"بَعْضَهُمْ","some of them","۞ تِلْكَ ٱلرُّسُلُ فَضَّلْنَا","عَلَىٰ بَعْضٍۢ ۘ مِّنْهُم",70],["2:253:6",42,"بَعْضٍۢ ۘ","others","فَضَّلْنَا بَعْضَهُمْ عَلَىٰ","مِّنْهُم مَّن كَلَّمَ",70],["2:253:12",42,"بَعْضَهُمْ","some of them","كَلَّمَ ٱللَّهُ ۖ وَرَفَعَ","دَرَجَـٰتٍۢ ۚ وَءَاتَيْنَا عِيسَى",70],["2:259:30",43,"بَعْضَ","a part","لَبِثْتُ يَوْمًا أَوْ","يَوْمٍۢ ۖ قَالَ بَل",70],["2:283:12",49,"بَعْضُكُم","one of you","مَّقْبُوضَةٌۭ ۖ فَإِنْ أَمِنَ","بَعْضًۭا فَلْيُؤَدِّ ٱلَّذِى",70],["2:283:13",49,"بَعْضًۭا","(to) another","فَإِنْ أَمِنَ بَعْضُكُم","فَلْيُؤَدِّ ٱلَّذِى ٱؤْتُمِنَ",70],["3:34:2",54,"بَعْضُهَا","some of them","ذُرِّيَّةًۢ","مِنۢ بَعْضٍۢ ۗ وَٱللَّهُ",70],["3:34:4",54,"بَعْضٍۢ ۗ","others","ذُرِّيَّةًۢ بَعْضُهَا مِنۢ","وَٱللَّهُ سَمِيعٌ عَلِيمٌ",70],["3:50:9",56,"بَعْضَ","some","ٱلتَّوْرَىٰةِ وَلِأُحِلَّ لَكُم","ٱلَّذِى حُرِّمَ عَلَيْكُمْ ۚ",70],["3:64:20",58,"بَعْضُنَا","some of us","شَيْـًۭٔا وَلَا يَتَّخِذَ","بَعْضًا أَرْبَابًۭا مِّن",70],["3:64:21",58,"بَعْضًا","(to) others","وَلَا يَتَّخِذَ بَعْضُنَا","أَرْبَابًۭا مِّن دُونِ",70],["3:155:11",70,"بِبَعْضِ","for some","إِنَّمَا ٱسْتَزَلَّهُمُ ٱلشَّيْطَـٰنُ","مَا كَسَبُوا۟ ۖ وَلَقَدْ",70],["3:195:14",76,"بَعْضُكُم","each of you","ذَكَرٍ أَوْ أُنثَىٰ ۖ","مِّنۢ بَعْضٍۢ ۖ فَٱلَّذِينَ",70],["3:195:16",76,"بَعْضٍۢ ۖ","(the) other","أُنثَىٰ ۖ بَعْضُكُم مِّنۢ","فَٱلَّذِينَ هَاجَرُوا۟ وَأُخْرِجُوا۟",70],["4:19:14",80,"بِبَعْضِ","a part","وَلَا تَعْضُلُوهُنَّ لِتَذْهَبُوا۟","مَآ ءَاتَيْتُمُوهُنَّ إِلَّآ",70],["4:21:5",81,"بَعْضُكُمْ","one of you","تَأْخُذُونَهُۥ وَقَدْ أَفْضَىٰ","إِلَىٰ بَعْضٍۢ وَأَخَذْنَ",70],["4:21:7",81,"بَعْضٍۢ","another","أَفْضَىٰ بَعْضُكُمْ إِلَىٰ","وَأَخَذْنَ مِنكُم مِّيثَـٰقًا",70],["4:25:20",82,"بَعْضُكُم","You","وَٱللَّهُ أَعْلَمُ بِإِيمَـٰنِكُم ۚ","مِّنۢ بَعْضٍۢ ۚ فَٱنكِحُوهُنَّ",70],["4:25:22",82,"بَعْضٍۢ ۚ","(one) another","بِإِيمَـٰنِكُم ۚ بَعْضُكُم مِّنۢ","فَٱنكِحُوهُنَّ بِإِذْنِ أَهْلِهِنَّ",70],["4:32:7",83,"بَعْضَكُمْ","some of you","فَضَّلَ ٱللَّهُ بِهِۦ","عَلَىٰ بَعْضٍۢ ۚ لِّلرِّجَالِ",70],["4:32:9",83,"بَعْضٍۢ ۚ","others","بِهِۦ بَعْضَكُمْ عَلَىٰ","لِّلرِّجَالِ نَصِيبٌۭ مِّمَّا",70],["4:34:8",84,"بَعْضَهُمْ","some of them","بِمَا فَضَّلَ ٱللَّهُ","عَلَىٰ بَعْضٍۢ وَبِمَآ",70],["4:34:10",84,"بَعْضٍۢ","others","ٱللَّهُ بَعْضَهُمْ عَلَىٰ","وَبِمَآ أَنفَقُوا۟ مِنْ",70],["4:150:14",102,"بِبَعْضٍۢ","in some","وَرُسُلِهِۦ وَيَقُولُونَ نُؤْمِنُ","وَنَكْفُرُ بِبَعْضٍۢ وَيُرِيدُونَ",70],["4:150:16",102,"بِبَعْضٍۢ","in others","نُؤْمِنُ بِبَعْضٍۢ وَنَكْفُرُ","وَيُرِيدُونَ أَن يَتَّخِذُوا۟",70],["5:49:14",116,"بَعْضِ","some","أَن يَفْتِنُوكَ عَنۢ","مَآ أَنزَلَ ٱللَّهُ",70],["5:49:27",116,"بِبَعْضِ","for some","ٱللَّهُ أَن يُصِيبَهُم","ذُنُوبِهِمْ ۗ وَإِنَّ كَثِيرًۭا",70],["5:51:9",117,"بَعْضُهُمْ","Some of them","ٱلْيَهُودَ وَٱلنَّصَـٰرَىٰٓ أَوْلِيَآءَ ۘ","أَوْلِيَآءُ بَعْضٍۢ ۚ وَمَن",70],["5:51:11",117,"بَعْضٍۢ ۚ","(to) others","أَوْلِيَآءَ ۘ بَعْضُهُمْ أَوْلِيَآءُ","وَمَن يَتَوَلَّهُم مِّنكُمْ",70],["6:53:3",134,"بَعْضَهُم","some of them","وَكَذَٰلِكَ فَتَنَّا","بِبَعْضٍۢ لِّيَقُولُوٓا۟ أَهَـٰٓؤُلَآءِ",70],["6:53:4",134,"بِبَعْضٍۢ","with others","وَكَذَٰلِكَ فَتَنَّا بَعْضَهُم","لِّيَقُولُوٓا۟ أَهَـٰٓؤُلَآءِ مَنَّ",70],["6:65:19",135,"بَعْضَكُم","some of you","يَلْبِسَكُمْ شِيَعًۭا وَيُذِيقَ","بَأْسَ بَعْضٍ ۗ ٱنظُرْ",70],["6:65:21",135,"بَعْضٍ ۗ","(of) others","وَيُذِيقَ بَعْضَكُم بَأْسَ","ٱنظُرْ كَيْفَ نُصَرِّفُ",70],["6:112:10",142,"بَعْضُهُمْ","some of them","ٱلْإِنسِ وَٱلْجِنِّ يُوحِى","إِلَىٰ بَعْضٍۢ زُخْرُفَ",70],["6:112:12",142,"بَعْضٍۢ","others","يُوحِى بَعْضُهُمْ إِلَىٰ","زُخْرُفَ ٱلْقَوْلِ غُرُورًۭا ۚ",70],["6:128:16",144,"بَعْضُنَا","some of us","ٱلْإِنسِ رَبَّنَا ٱسْتَمْتَعَ","بِبَعْضٍۢ وَبَلَغْنَآ أَجَلَنَا",70],["6:128:17",144,"بِبَعْضٍۢ","by others","رَبَّنَا ٱسْتَمْتَعَ بَعْضُنَا","وَبَلَغْنَآ أَجَلَنَا ٱلَّذِىٓ",70],["6:129:3",144,"بَعْضَ","some (of)","وَكَذَٰلِكَ نُوَلِّى","ٱلظَّـٰلِمِينَ بَعْضًۢا بِمَا",70],["6:129:5",144,"بَعْضًۢا","(to) others","نُوَلِّى بَعْضَ ٱلظَّـٰلِمِينَ","بِمَا كَانُوا۟ يَكْسِبُونَ",70],["6:158:12",150,"بَعْضُ","some (of)","رَبُّكَ أَوْ يَأْتِىَ","ءَايَـٰتِ رَبِّكَ ۗ يَوْمَ",70],["6:158:17",150,"بَعْضُ","some (of)","رَبِّكَ ۗ يَوْمَ يَأْتِى","ءَايَـٰتِ رَبِّكَ لَا",70],["6:165:7",150,"بَعْضَكُمْ","some of you","خَلَـٰٓئِفَ ٱلْأَرْضِ وَرَفَعَ","فَوْقَ بَعْضٍۢ دَرَجَـٰتٍۢ",70],["6:165:9",150,"بَعْضٍۢ","others","وَرَفَعَ بَعْضَكُمْ فَوْقَ","دَرَجَـٰتٍۢ لِّيَبْلُوَكُمْ فِى",70],["7:24:3",153,"بَعْضُكُمْ","some of you","قَالَ ٱهْبِطُوا۟","لِبَعْضٍ عَدُوٌّۭ ۖ وَلَكُمْ",70],["7:24:4",153,"لِبَعْضٍ","to some others","قَالَ ٱهْبِطُوا۟ بَعْضُكُمْ","عَدُوٌّۭ ۖ وَلَكُمْ فِى",70],["8:37:8",181,"بَعْضَهُۥ","some of them","ٱلطَّيِّبِ وَيَجْعَلَ ٱلْخَبِيثَ","عَلَىٰ بَعْضٍۢ فَيَرْكُمَهُۥ",70],["8:37:10",181,"بَعْضٍۢ","others","ٱلْخَبِيثَ بَعْضَهُۥ عَلَىٰ","فَيَرْكُمَهُۥ جَمِيعًۭا فَيَجْعَلَهُۥ",70],["8:72:15",186,"بَعْضُهُمْ","some of them","ءَاوَوا۟ وَّنَصَرُوٓا۟ أُو۟لَـٰٓئِكَ","أَوْلِيَآءُ بَعْضٍۢ ۚ وَٱلَّذِينَ",70],["8:72:17",186,"بَعْضٍۢ ۚ","(of) another","أُو۟لَـٰٓئِكَ بَعْضُهُمْ أَوْلِيَآءُ","وَٱلَّذِينَ ءَامَنُوا۟ وَلَمْ",70],["8:73:3",186,"بَعْضُهُمْ","some of them","وَٱلَّذِينَ كَفَرُوا۟","أَوْلِيَآءُ بَعْضٍ ۚ إِلَّا",70],["8:73:5",186,"بَعْضٍ ۚ","(to) another","كَفَرُوا۟ بَعْضُهُمْ أَوْلِيَآءُ","إِلَّا تَفْعَلُوهُ تَكُن",70],["8:75:12",186,"بَعْضُهُمْ","some of them","مِنكُمْ ۚ وَأُو۟لُوا۟ ٱلْأَرْحَامِ","أَوْلَىٰ بِبَعْضٍۢ فِى",70],["8:75:14",186,"بِبَعْضٍۢ","to another","ٱلْأَرْحَامِ بَعْضُهُمْ أَوْلَىٰ","فِى كِتَـٰبِ ٱللَّهِ ۗ",70],["9:67:3",197,"بَعْضُهُم","some of them","ٱلْمُنَـٰفِقُونَ وَٱلْمُنَـٰفِقَـٰتُ","مِّنۢ بَعْضٍۢ ۚ يَأْمُرُونَ",70],["9:67:5",197,"بَعْضٍۢ ۚ","others","وَٱلْمُنَـٰفِقَـٰتُ بَعْضُهُم مِّنۢ","يَأْمُرُونَ بِٱلْمُنكَرِ وَيَنْهَوْنَ",70],["9:71:3",198,"بَعْضُهُمْ","some of them","وَٱلْمُؤْمِنُونَ وَٱلْمُؤْمِنَـٰتُ","أَوْلِيَآءُ بَعْضٍۢ ۚ يَأْمُرُونَ",70],["9:71:5",198,"بَعْضٍۢ ۚ","(of) others","وَٱلْمُؤْمِنَـٰتُ بَعْضُهُمْ أَوْلِيَآءُ","يَأْمُرُونَ بِٱلْمَعْرُوفِ وَيَنْهَوْنَ",70],["9:127:6",207,"بَعْضُهُمْ","some of them","أُنزِلَتْ سُورَةٌۭ نَّظَرَ","إِلَىٰ بَعْضٍ هَلْ",70],["9:127:8",207,"بَعْضٍ","others","نَّظَرَ بَعْضُهُمْ إِلَىٰ","هَلْ يَرَىٰكُم مِّنْ",70],["10:46:3",214,"بَعْضَ","some","وَإِمَّا نُرِيَنَّكَ","ٱلَّذِى نَعِدُهُمْ أَوْ",70],["11:12:3",222,"بَعْضَ","a part","فَلَعَلَّكَ تَارِكٌۢ","مَا يُوحَىٰٓ إِلَيْكَ",70],["11:54:5",228,"بَعْضُ","some","نَّقُولُ إِلَّا ٱعْتَرَىٰكَ","ءَالِهَتِنَا بِسُوٓءٍۢ ۗ قَالَ",70],["12:10:12",236,"بَعْضُ","some","غَيَـٰبَتِ ٱلْجُبِّ يَلْتَقِطْهُ","ٱلسَّيَّارَةِ إِن كُنتُمْ",70],["13:4:17",249,"بَعْضَهَا","some of them","بِمَآءٍۢ وَٰحِدٍۢ وَنُفَضِّلُ","عَلَىٰ بَعْضٍۢ فِى",70],["13:4:19",249,"بَعْضٍۢ","others","وَنُفَضِّلُ بَعْضَهَا عَلَىٰ","فِى ٱلْأُكُلِ ۚ إِنَّ",70],["13:36:12",254,"بَعْضَهُۥ ۚ","a part of it","ٱلْأَحْزَابِ مَن يُنكِرُ","قُلْ إِنَّمَآ أُمِرْتُ",70],["13:40:4",254,"بَعْضَ","a part","وَإِن مَّا نُرِيَنَّكَ","ٱلَّذِى نَعِدُهُمْ أَوْ",70],["16:71:3",274,"بَعْضَكُمْ","some of you","وَٱللَّهُ فَضَّلَ","عَلَىٰ بَعْضٍۢ فِى",70],["16:71:5",274,"بَعْضٍۢ","others","فَضَّلَ بَعْضَكُمْ عَلَىٰ","فِى ٱلرِّزْقِ ۚ فَمَا",70],["17:21:4",284,"بَعْضَهُمْ","some of them","ٱنظُرْ كَيْفَ فَضَّلْنَا","عَلَىٰ بَعْضٍۢ ۚ وَلَلْـَٔاخِرَةُ",70],["17:21:6",284,"بَعْضٍۢ ۚ","others","فَضَّلْنَا بَعْضَهُمْ عَلَىٰ","وَلَلْـَٔاخِرَةُ أَكْبَرُ دَرَجَـٰتٍۢ",70],["17:55:9",287,"بَعْضَ","some","وَٱلْأَرْضِ ۗ وَلَقَدْ فَضَّلْنَا","ٱلنَّبِيِّـۧنَ عَلَىٰ بَعْضٍۢ ۖ",70],["17:55:12",287,"بَعْضٍۢ ۖ","others","بَعْضَ ٱلنَّبِيِّـۧنَ عَلَىٰ","وَءَاتَيْنَا دَاوُۥدَ زَبُورًۭا",70],["17:88:17",291,"بَعْضُهُمْ","some of them","بِمِثْلِهِۦ وَلَوْ كَانَ","لِبَعْضٍۢ ظَهِيرًۭا",70],["17:88:18",291,"لِبَعْضٍۢ","to some others","وَلَوْ كَانَ بَعْضُهُمْ","ظَهِيرًۭا",70],["18:19:14",295,"بَعْضَ","a part","لَبِثْنَا يَوْمًا أَوْ","يَوْمٍۢ ۚ قَالُوا۟ رَبُّكُمْ",70],["18:99:2",304,"بَعْضَهُمْ","some of them","۞ وَتَرَكْنَا","يَوْمَئِذٍۢ يَمُوجُ فِى",70],["18:99:6",304,"بَعْضٍۢ ۖ","others","يَوْمَئِذٍۢ يَمُوجُ فِى","وَنُفِخَ فِى ٱلصُّورِ",70],["20:123:5",320,"بَعْضُكُمْ","some of you","ٱهْبِطَا مِنْهَا جَمِيعًۢا ۖ","لِبَعْضٍ عَدُوٌّۭ ۖ فَإِمَّا",70],["20:123:6",320,"لِبَعْضٍ","to others","مِنْهَا جَمِيعًۢا ۖ بَعْضُكُمْ","عَدُوٌّۭ ۖ فَإِمَّا يَأْتِيَنَّكُم",70],["22:40:16",337,"بَعْضَهُم","some of them","دَفْعُ ٱللَّهِ ٱلنَّاسَ","بِبَعْضٍۢ لَّهُدِّمَتْ صَوَٰمِعُ",70],["22:40:17",337,"بِبَعْضٍۢ","by others","ٱللَّهِ ٱلنَّاسَ بَعْضَهُم","لَّهُدِّمَتْ صَوَٰمِعُ وَبِيَعٌۭ",70],["23:44:12",345,"بَعْضَهُم","some of them","رَّسُولُهَا كَذَّبُوهُ ۚ فَأَتْبَعْنَا","بَعْضًۭا وَجَعَلْنَـٰهُمْ أَحَادِيثَ ۚ",70],["23:44:13",345,"بَعْضًۭا","others","كَذَّبُوهُ ۚ فَأَتْبَعْنَا بَعْضَهُم","وَجَعَلْنَـٰهُمْ أَحَادِيثَ ۚ فَبُعْدًۭا",70],["23:91:18",348,"بَعْضُهُمْ","some of them","بِمَا خَلَق