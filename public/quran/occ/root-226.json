[["2:186:7",28,"أُجِيبُ","I respond","عَنِّى فَإِنِّى قَرِيبٌ ۖ","دَعْوَةَ ٱلدَّاعِ إِذَا",956],["2:186:12",28,"فَلْيَسْتَجِيبُوا۟","So let them respond","ٱلدَّاعِ إِذَا دَعَانِ ۖ","لِى وَلْيُؤْمِنُوا۟ بِى",394],["3:172:2",72,"ٱسْتَجَابُوا۟","responded","ٱلَّذِينَ","لِلَّهِ وَٱلرَّسُولِ مِنۢ",394],["3:195:1",76,"فَٱسْتَجَابَ","Then responded","","لَهُمْ رَبُّهُمْ أَنِّى",394],["5:109:7",126,"أُجِبْتُمْ ۖ","was (the) response you received","ٱلرُّسُلَ فَيَقُولُ مَاذَآ","قَالُوا۟ لَا عِلْمَ",956],["6:36:2",132,"يَسْتَجِيبُ","respond","۞ إِنَّمَا","ٱلَّذِينَ يَسْمَعُونَ ۘ وَٱلْمَوْتَىٰ",394],["7:82:3",161,"جَوَابَ","(the) answer","وَمَا كَانَ","قَوْمِهِۦٓ إِلَّآ أَن",1561],["7:194:10",175,"فَلْيَسْتَجِيبُوا۟","and let them respond","عِبَادٌ أَمْثَالُكُمْ ۖ فَٱدْعُوهُمْ","لَكُمْ إِن كُنتُمْ",394],["8:9:4",178,"فَٱسْتَجَابَ","and He answered","إِذْ تَسْتَغِيثُونَ رَبَّكُمْ","لَكُمْ أَنِّى مُمِدُّكُم",394],["8:24:4",179,"ٱسْتَجِيبُوا۟","Respond","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","لِلَّهِ وَلِلرَّسُولِ إِذَا",394],["10:89:3",219,"أُجِيبَت","has been answered","قَالَ قَدْ","دَّعْوَتُكُمَا فَٱسْتَقِيمَا وَلَا",956],["11:14:2",223,"يَسْتَجِيبُوا۟","they respond","فَإِلَّمْ","لَكُمْ فَٱعْلَمُوٓا۟ أَنَّمَآ",394],["11:61:27",228,"مُّجِيبٌۭ","All-Responsive","إِنَّ رَبِّى قَرِيبٌۭ","",2539],["12:34:1",239,"فَٱسْتَجَابَ","So responded","","لَهُۥ رَبُّهُۥ فَصَرَفَ",394],["13:14:9",251,"يَسْتَجِيبُونَ","they respond","مِن دُونِهِۦ لَا","لَهُم بِشَىْءٍ إِلَّا",394],["13:18:2",251,"ٱسْتَجَابُوا۟","responded","لِلَّذِينَ","لِرَبِّهِمُ ٱلْحُسْنَىٰ ۚ وَٱلَّذِينَ",394],["13:18:7",251,"يَسْتَجِيبُوا۟","respond","ٱلْحُسْنَىٰ ۚ وَٱلَّذِينَ لَمْ","لَهُۥ لَوْ أَنَّ",394],["14:22:22",258,"فَٱسْتَجَبْتُمْ","and you responded","إِلَّآ أَن دَعَوْتُكُمْ","لِى ۖ فَلَا تَلُومُونِى",394],["14:44:14",261,"نُّجِبْ","we will answer","إِلَىٰٓ أَجَلٍۢ قَرِيبٍۢ","دَعْوَتَكَ وَنَتَّبِعِ ٱلرُّسُلَ ۗ",956],["17:52:3",287,"فَتَسْتَجِيبُونَ","and you will respond","يَوْمَ يَدْعُوكُمْ","بِحَمْدِهِۦ وَتَظُنُّونَ إِن",394],["18:52:9",299,"يَسْتَجِيبُوا۟","they will respond","زَعَمْتُمْ فَدَعَوْهُمْ فَلَمْ","لَهُمْ وَجَعَلْنَا بَيْنَهُم",394],["21:76:6",328,"فَٱسْتَجَبْنَا","so We responded","نَادَىٰ مِن قَبْلُ","لَهُۥ فَنَجَّيْنَـٰهُ وَأَهْلَهُۥ",394],["21:84:1",329,"فَٱسْتَجَبْنَا","So We responded","","لَهُۥ فَكَشَفْنَا مَا",394],["21:88:1",329,"فَٱسْتَجَبْنَا","So We responded","","لَهُۥ وَنَجَّيْنَـٰهُ مِنَ",394],["21:90:1",329,"فَٱسْتَجَبْنَا","So We responded","","لَهُۥ وَوَهَبْنَا لَهُۥ",394],["27:56:3",382,"جَوَابَ","(the) answer","۞ فَمَا كَانَ","قَوْمِهِۦٓ إِلَّآ أَن",1561],["27:62:2",382,"يُجِيبُ","responds","أَمَّن","ٱلْمُضْطَرَّ إِذَا دَعَاهُ",956],["28:50:3",391,"يَسْتَجِيبُوا۟","they respond","فَإِن لَّمْ","لَكَ فَٱعْلَمْ أَنَّمَا",394],["28:64:6",393,"يَسْتَجِيبُوا۟","they will respond","شُرَكَآءَكُمْ فَدَعَوْهُمْ فَلَمْ","لَهُمْ وَرَأَوُا۟ ٱلْعَذَابَ ۚ",394],["28:65:5",393,"أَجَبْتُمُ","did you answer","يُنَادِيهِمْ فَيَقُولُ مَاذَآ","ٱلْمُرْسَلِينَ",956],["29:24:3",399,"جَوَابَ","(the) answer","فَمَا كَانَ","قَوْمِهِۦٓ إِلَّآ أَن",1561],["29:29:12",399,"جَوَابَ","(the) answer","ٱلْمُنكَرَ ۖ فَمَا كَانَ","قَوْمِهِۦٓ إِلَّآ أَن",1561],["35:14:9",436,"ٱسْتَجَابُوا۟","they (would) respond","وَلَوْ سَمِعُوا۟ مَا","لَكُمْ ۖ وَيَوْمَ ٱلْقِيَـٰمَةِ",394],["37:75:5",448,"ٱلْمُجِيبُونَ","(are We as) Responders","نَادَىٰنَا نُوحٌۭ فَلَنِعْمَ","",2539],["40:60:4",474,"أَسْتَجِبْ","I will respond","وَقَالَ رَبُّكُمُ ٱدْعُونِىٓ","لَكُمْ ۚ إِنَّ ٱلَّذِينَ",394],["42:16:8",485,"ٱسْتُجِيبَ","response has been made to Him","مِنۢ بَعْدِ مَا","لَهُۥ حُجَّتُهُمْ دَاحِضَةٌ",394],["42:26:1",486,"وَيَسْتَجِيبُ","And He answers","","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",394],["42:38:2",487,"ٱسْتَجَابُوا۟","respond","وَٱلَّذِينَ","لِرَبِّهِمْ وَأَقَامُوا۟ ٱلصَّلَوٰةَ",394],["42:47:1",488,"ٱسْتَجِيبُوا۟","Respond","","لِرَبِّكُم مِّن قَبْلِ",394],["46:5:10",502,"يَسْتَجِيبُ","will not respond","ٱللَّهِ مَن لَّا","لَهُۥٓ إِلَىٰ يَوْمِ",394],["46:31:2",506,"أَجِيبُوا۟","Respond","يَـٰقَوْمَنَآ","دَاعِىَ ٱللَّهِ وَءَامِنُوا۟",956],["46:32:3",506,"يُجِبْ","respond","وَمَن لَّا","دَاعِىَ ٱللَّهِ فَلَيْسَ",956],["89:9:3",593,"جَابُوا۟","carved out","وَثَمُودَ ٱلَّذِينَ","ٱلصَّخْرَ بِٱلْوَادِ",3508]]