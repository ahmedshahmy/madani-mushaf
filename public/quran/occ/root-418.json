[["2:41:15",7,"ثَمَنًۭا","a price","وَلَا تَشْتَرُوا۟ بِـَٔايَـٰتِى","قَلِيلًۭا وَإِيَّـٰىَ فَٱتَّقُونِ",803],["2:79:14",12,"ثَمَنًۭا","(for) a price","ٱللَّهِ لِيَشْتَرُوا۟ بِهِۦ","قَلِيلًۭا ۖ فَوَيْلٌۭ لَّهُم",803],["2:174:11",26,"ثَمَنًۭا","a gain","ٱلْكِتَـٰبِ وَيَشْتَرُونَ بِهِۦ","قَلِيلًا ۙ أُو۟لَـٰٓئِكَ مَا",803],["3:77:7",59,"ثَمَنًۭا","(for) a price","بِعَهْدِ ٱللَّهِ وَأَيْمَـٰنِهِمْ","قَلِيلًا أُو۟لَـٰٓئِكَ لَا",803],["3:187:17",75,"ثَمَنًۭا","(for) a price","ظُهُورِهِمْ وَٱشْتَرَوْا۟ بِهِۦ","قَلِيلًۭا ۖ فَبِئْسَ مَا",803],["3:199:20",76,"ثَمَنًۭا","(for) a price","يَشْتَرُونَ بِـَٔايَـٰتِ ٱللَّهِ","قَلِيلًا ۗ أُو۟لَـٰٓئِكَ لَهُمْ",803],["4:12:40",79,"ٱلثُّمُنُ","(is) the eighth","لَكُمْ وَلَدٌۭ فَلَهُنَّ","مِمَّا تَرَكْتُم ۚ مِّنۢ",4505],["5:44:31",115,"ثَمَنًۭا","(for) a price","وَلَا تَشْتَرُوا۟ بِـَٔايَـٰتِى","قَلِيلًۭا ۚ وَمَن لَّمْ",803],["5:106:39",125,"ثَمَنًۭا","a price","لَا نَشْتَرِى بِهِۦ","وَلَوْ كَانَ ذَا",803],["6:143:1",147,"ثَمَـٰنِيَةَ","Eight","","أَزْوَٰجٍۢ ۖ مِّنَ ٱلضَّأْنِ",1652],["9:9:4",188,"ثَمَنًۭا","(for) a little price","ٱشْتَرَوْا۟ بِـَٔايَـٰتِ ٱللَّهِ","قَلِيلًۭا فَصَدُّوا۟ عَن",803],["12:20:2",237,"بِثَمَنٍۭ","for a price","وَشَرَوْهُ","بَخْسٍۢ دَرَٰهِمَ مَعْدُودَةٍۢ",803],["16:95:5",278,"ثَمَنًۭا","(for) a price","تَشْتَرُوا۟ بِعَهْدِ ٱللَّهِ","قَلِيلًا ۚ إِنَّمَا عِندَ",803],["18:22:13",296,"وَثَامِنُهُمْ","and the eight of them","بِٱلْغَيْبِ ۖ وَيَقُولُونَ سَبْعَةٌۭ","كَلْبُهُمْ ۚ قُل رَّبِّىٓ",4492],["24:4:10",350,"ثَمَـٰنِينَ","(with) eighty","بِأَرْبَعَةِ شُهَدَآءَ فَٱجْلِدُوهُمْ","جَلْدَةًۭ وَلَا تَقْبَلُوا۟",4497],["28:27:12",388,"ثَمَـٰنِىَ","(for) eight","عَلَىٰٓ أَن تَأْجُرَنِى","حِجَجٍۢ ۖ فَإِنْ أَتْمَمْتَ",4496],["39:6:13",459,"ثَمَـٰنِيَةَ","eight","لَكُم مِّنَ ٱلْأَنْعَـٰمِ","أَزْوَٰجٍۢ ۚ يَخْلُقُكُمْ فِى",1652],["69:7:5",566,"وَثَمَـٰنِيَةَ","and eight","عَلَيْهِمْ سَبْعَ لَيَالٍۢ","أَيَّامٍ حُسُومًۭا فَتَرَى",1652],["69:17:9",567,"ثَمَـٰنِيَةٌۭ","eight","رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍۢ","",1652]]