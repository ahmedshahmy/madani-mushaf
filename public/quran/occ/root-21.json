[["2:55:8",8,"نَرَى","we see","نُّؤْمِنَ لَكَ حَتَّىٰ","ٱللَّهَ جَهْرَةًۭ فَأَخَذَتْكُمُ",46],["2:73:8",11,"وَيُرِيكُمْ","and shows you","يُحْىِ ٱللَّهُ ٱلْمَوْتَىٰ","ءَايَـٰتِهِۦ لَعَلَّكُمْ تَعْقِلُونَ",287],["2:128:10",20,"وَأَرِنَا","And show us","أُمَّةًۭ مُّسْلِمَةًۭ لَّكَ","مَنَاسِكَنَا وَتُبْ عَلَيْنَآ ۖ",287],["2:144:2",22,"نَرَىٰ","We see","قَدْ","تَقَلُّبَ وَجْهِكَ فِى",46],["2:165:18",25,"يَرَى","would see","حُبًّۭا لِّلَّهِ ۗ وَلَوْ","ٱلَّذِينَ ظَلَمُوٓا۟ إِذْ",46],["2:165:22",25,"يَرَوْنَ","they will see","ٱلَّذِينَ ظَلَمُوٓا۟ إِذْ","ٱلْعَذَابَ أَنَّ ٱلْقُوَّةَ",46],["2:166:8",25,"وَرَأَوُا۟","and they will see","مِنَ ٱلَّذِينَ ٱتَّبَعُوا۟","ٱلْعَذَابَ وَتَقَطَّعَتْ بِهِمُ",46],["2:167:14",25,"يُرِيهِمُ","will show them","تَبَرَّءُوا۟ مِنَّا ۗ كَذَٰلِكَ","ٱللَّهُ أَعْمَـٰلَهُمْ حَسَرَٰتٍ",287],["2:243:2",39,"تَرَ","you see","۞ أَلَمْ","إِلَى ٱلَّذِينَ خَرَجُوا۟",46],["2:246:2",40,"تَرَ","you see","أَلَمْ","إِلَى ٱلْمَلَإِ مِنۢ",46],["2:258:2",43,"تَرَ","you see","أَلَمْ","إِلَى ٱلَّذِى حَآجَّ",46],["2:260:5",44,"أَرِنِى","show me","قَالَ إِبْرَٰهِـۧمُ رَبِّ","كَيْفَ تُحْىِ ٱلْمَوْتَىٰ ۖ",287],["2:264:12",44,"رِئَآءَ","(to) be seen","كَٱلَّذِى يُنفِقُ مَالَهُۥ","ٱلنَّاسِ وَلَا يُؤْمِنُ",1977],["3:13:15",51,"يَرَوْنَهُم","They were seeing them","ٱللَّهِ وَأُخْرَىٰ كَافِرَةٌۭ","مِّثْلَيْهِمْ رَأْىَ ٱلْعَيْنِ ۚ",46],["3:13:17",51,"رَأْىَ","with the sight","كَافِرَةٌۭ يَرَوْنَهُم مِّثْلَيْهِمْ","ٱلْعَيْنِ ۚ وَٱللَّهُ يُؤَيِّدُ",2591],["3:23:2",53,"تَرَ","you seen","أَلَمْ","إِلَى ٱلَّذِينَ أُوتُوا۟",46],["3:143:10",68,"رَأَيْتُمُوهُ","you have seen it","أَن تَلْقَوْهُ فَقَدْ","وَأَنتُمْ تَنظُرُونَ",46],["3:152:18",69,"أَرَىٰكُم","He (had) shown you","مِّنۢ بَعْدِ مَآ","مَّا تُحِبُّونَ ۚ مِنكُم",46],["4:38:4",85,"رِئَآءَ","to be seen","وَٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُمْ","ٱلنَّاسِ وَلَا يُؤْمِنُونَ",1977],["4:44:2",85,"تَرَ","you see","أَلَمْ","إِلَى ٱلَّذِينَ أُوتُوا۟",46],["4:49:2",86,"تَرَ","you see","أَلَمْ","إِلَى ٱلَّذِينَ يُزَكُّونَ",46],["4:51:2",86,"تَرَ","you see","أَلَمْ","إِلَى ٱلَّذِينَ أُوتُوا۟",46],["4:60:2",88,"تَرَ","you see","أَلَمْ","إِلَى ٱلَّذِينَ يَزْعُمُونَ",46],["4:61:11",88,"رَأَيْتَ","you see","ٱللَّهُ وَإِلَى ٱلرَّسُولِ","ٱلْمُنَـٰفِقِينَ يَصُدُّونَ عَنكَ",46],["4:77:2",90,"تَرَ","you seen","أَلَمْ","إِلَى ٱلَّذِينَ قِيلَ",46],["4:105:10",95,"أَرَىٰكَ","has shown you","بَيْنَ ٱلنَّاسِ بِمَآ","ٱللَّهُ ۚ وَلَا تَكُن",46],["4:142:13",101,"يُرَآءُونَ","showing off","ٱلصَّلَوٰةِ قَامُوا۟ كُسَالَىٰ","ٱلنَّاسَ وَلَا يَذْكُرُونَ",2812],["4:153:17",102,"أَرِنَا","Show us","مِن ذَٰلِكَ فَقَالُوٓا۟","ٱللَّهَ جَهْرَةًۭ فَأَخَذَتْهُمُ",287],["5:31:7",112,"لِيُرِيَهُۥ","to show him","يَبْحَثُ فِى ٱلْأَرْضِ","كَيْفَ يُوَٰرِى سَوْءَةَ",287],["5:52:1",117,"فَتَرَى","And you see","","ٱلَّذِينَ فِى قُلُوبِهِم",46],["5:62:1",118,"وَتَرَىٰ","And you see","","كَثِيرًۭا مِّنْهُمْ يُسَـٰرِعُونَ",46],["5:80:1",121,"تَرَىٰ","You see","","كَثِيرًۭا مِّنْهُمْ يَتَوَلَّوْنَ",46],["5:83:7",121,"تَرَىٰٓ","you see","أُنزِلَ إِلَى ٱلرَّسُولِ","أَعْيُنَهُمْ تَفِيضُ مِنَ",46],["6:6:2",128,"يَرَوْا۟","they see","أَلَمْ","كَمْ أَهْلَكْنَا مِن",46],["6:25:15",130,"يَرَوْا۟","they see","ءَاذَانِهِمْ وَقْرًۭا ۚ وَإِن","كُلَّ ءَايَةٍۢ لَّا",46],["6:27:2",130,"تَرَىٰٓ","you (could) see","وَلَوْ","إِذْ وُقِفُوا۟ عَلَى",46],["6:30:2",131,"تَرَىٰٓ","you (could) see","وَلَوْ","إِذْ وُقِفُوا۟ عَلَىٰ",46],["6:40:2",132,"أَرَءَيْتَكُمْ","Have you seen","قُلْ","إِنْ أَتَىٰكُمْ عَذَابُ",46],["6:46:2",133,"أَرَءَيْتُمْ","Have you seen","قُلْ","إِنْ أَخَذَ ٱللَّهُ",46],["6:47:2",133,"أَرَءَيْتَكُمْ","Have you seen","قُلْ","إِنْ أَتَىٰكُمْ عَذَابُ",46],["6:68:2",135,"رَأَيْتَ","you see","وَإِذَا","ٱلَّذِينَ يَخُوضُونَ فِىٓ",46],["6:74:10",137,"أَرَىٰكَ","[I] see you","أَصْنَامًا ءَالِهَةً ۖ إِنِّىٓ","وَقَوْمَكَ فِى ضَلَـٰلٍۢ",46],["6:75:2",137,"نُرِىٓ","We show(ed)","وَكَذَٰلِكَ","إِبْرَٰهِيمَ مَلَكُوتَ ٱلسَّمَـٰوَٰتِ",287],["6:76:5",137,"رَءَا","he saw","جَنَّ عَلَيْهِ ٱلَّيْلُ","كَوْكَبًۭا ۖ قَالَ هَـٰذَا",46],["6:77:2",137,"رَءَا","he saw","فَلَمَّا","ٱلْقَمَرَ بَازِغًۭا قَالَ",46],["6:78:2",137,"رَءَا","he saw","فَلَمَّا","ٱلشَّمْسَ بَازِغَةًۭ قَالَ",46],["6:93:24",139,"تَرَىٰٓ","you (could) see","أَنزَلَ ٱللَّهُ ۗ وَلَوْ","إِذِ ٱلظَّـٰلِمُونَ فِى",46],["6:94:14",139,"نَرَىٰ","We see","وَرَآءَ ظُهُورِكُمْ ۖ وَمَا","مَعَكُمْ شُفَعَآءَكُمُ ٱلَّذِينَ",46],["7:27:14",153,"لِيُرِيَهُمَا","to show both of them","يَنزِعُ عَنْهُمَا لِبَاسَهُمَا","سَوْءَٰتِهِمَآ ۗ إِنَّهُۥ يَرَىٰكُمْ",287],["7:27:17",153,"يَرَىٰكُمْ","sees you","لِيُرِيَهُمَا سَوْءَٰتِهِمَآ ۗ إِنَّهُۥ","هُوَ وَقَبِيلُهُۥ مِنْ",46],["7:27:23",153,"تَرَوْنَهُمْ ۗ","you see them","مِنْ حَيْثُ لَا","إِنَّا جَعَلْنَا ٱلشَّيَـٰطِينَ",46],["7:60:6",158,"لَنَرَىٰكَ","surely see you","مِن قَوْمِهِۦٓ إِنَّا","فِى ضَلَـٰلٍۢ مُّبِينٍۢ",46],["7:66:8",158,"لَنَرَىٰكَ","surely, see you","مِن قَوْمِهِۦٓ إِنَّا","فِى سَفَاهَةٍۢ وَإِنَّا",46],["7:143:9",167,"أَرِنِىٓ","Show me","رَبُّهُۥ قَالَ رَبِّ","أَنظُرْ إِلَيْكَ ۚ قَالَ",287],["7:143:14",167,"تَرَىٰنِى","you (can) see Me","إِلَيْكَ ۚ قَالَ لَن","وَلَـٰكِنِ ٱنظُرْ إِلَى",46],["7:143:23",167,"تَرَىٰنِى ۚ","you (will) see Me","ٱسْتَقَرَّ مَكَانَهُۥ فَسَوْفَ","فَلَمَّا تَجَلَّىٰ رَبُّهُۥ",46],["7:145:18",168,"سَأُو۟رِيكُمْ","I will show you","قَوْمَكَ يَأْخُذُوا۟ بِأَحْسَنِهَا ۚ","دَارَ ٱلْفَـٰسِقِينَ",287],["7:146:11",168,"يَرَوْا۟","they see","بِغَيْرِ ٱلْحَقِّ وَإِن","كُلَّ ءَايَةٍۢ لَّا",46],["7:146:18",168,"يَرَوْا۟","they see","يُؤْمِنُوا۟ بِهَا وَإِن","سَبِيلَ ٱلرُّشْدِ لَا",46],["7:146:25",168,"يَرَوْا۟","they see","يَتَّخِذُوهُ سَبِيلًۭا وَإِن","سَبِيلَ ٱلْغَىِّ يَتَّخِذُوهُ",46],["7:148:13",168,"يَرَوْا۟","they see","لَّهُۥ خُوَارٌ ۚ أَلَمْ","أَنَّهُۥ لَا يُكَلِّمُهُمْ",46],["7:149:5",168,"وَرَأَوْا۟","and they saw","سُقِطَ فِىٓ أَيْدِيهِمْ","أَنَّهُمْ قَدْ ضَلُّوا۟",46],["7:198:7",176,"وَتَرَىٰهُمْ","And you see them","ٱلْهُدَىٰ لَا يَسْمَعُوا۟ ۖ","يَنظُرُونَ إِلَيْكَ وَهُمْ",46],["8:43:2",182,"يُرِيكَهُمُ","you (where) shown them","إِذْ","ٱللَّهُ فِى مَنَامِكَ",287],["8:43:8",182,"أَرَىٰكَهُمْ","He had shown them to you","مَنَامِكَ قَلِيلًۭا ۖ وَلَوْ","كَثِيرًۭا لَّفَشِلْتُمْ وَلَتَنَـٰزَعْتُمْ",46],["8:44:2",182,"يُرِيكُمُوهُمْ","He showed them to you","وَإِذْ","إِذِ ٱلْتَقَيْتُمْ فِىٓ",287],["8:47:8",183,"وَرِئَآءَ","and showing off","مِن دِيَـٰرِهِم بَطَرًۭا","ٱلنَّاسِ وَيَصُدُّونَ عَن",1977],["8:48:17",183,"تَرَآءَتِ","came in sight","جَارٌۭ لَّكُمْ ۖ فَلَمَّا","ٱلْفِئَتَانِ نَكَصَ عَلَىٰ",2677],["8:48:27",183,"أَرَىٰ","see","بَرِىٓءٌۭ مِّنكُمْ إِنِّىٓ","مَا لَا تَرَوْنَ",46],["8:48:30",183,"تَرَوْنَ","you see","أَرَىٰ مَا لَا","إِنِّىٓ أَخَافُ ٱللَّهَ ۚ",46],["8:50:2",183,"تَرَىٰٓ","you (could) see","وَلَوْ","إِذْ يَتَوَفَّى ٱلَّذِينَ",46],["9:26:12",190,"تَرَوْهَا","which you did not see","وَأَنزَلَ جُنُودًۭا لَّمْ","وَعَذَّبَ ٱلَّذِينَ كَفَرُوا۟ ۚ",46],["9:40:31",193,"تَرَوْهَا","which you did not see","وَأَيَّدَهُۥ بِجُنُودٍۢ لَّمْ","وَجَعَلَ كَلِمَةَ ٱلَّذِينَ",46],["9:94:17",202,"وَسَيَرَى","and Allah will see","ٱللَّهُ مِنْ أَخْبَارِكُمْ ۚ","ٱللَّهُ عَمَلَكُمْ وَرَسُولُهُۥ",46],["9:105:3",203,"فَسَيَرَى","then Allah will see","وَقُلِ ٱعْمَلُوا۟","ٱللَّهُ عَمَلَكُمْ وَرَسُولُهُۥ",46],["9:126:2",207,"يَرَوْنَ","they see","أَوَلَا","أَنَّهُمْ يُفْتَنُونَ فِى",46],["9:127:10",207,"يَرَىٰكُم","see you","إِلَىٰ بَعْضٍ هَلْ","مِّنْ أَحَدٍۢ ثُمَّ",46],["10:46:2",214,"نُرِيَنَّكَ","We show you","وَإِمَّا","بَعْضَ ٱلَّذِى نَعِدُهُمْ",287],["10:50:2",214,"أَرَءَيْتُمْ","Do you see","قُلْ","إِنْ أَتَىٰكُمْ عَذَابُهُۥ",46],["10:54:14",215,"رَأَوُا۟","they see","وَأَسَرُّوا۟ ٱلنَّدَامَةَ لَمَّا","ٱلْعَذَابَ ۖ وَقُضِىَ بَيْنَهُم",46],["10:59:2",215,"أَرَءَيْتُم","Have you seen","قُلْ","مَّآ أَنزَلَ ٱللَّهُ",46],["10:88:27",218,"يَرَوُا۟","they see","فَلَا يُؤْمِنُوا۟ حَتَّىٰ","ٱلْعَذَابَ ٱلْأَلِيمَ",46],["10:97:6",219,"يَرَوُا۟","they see","كُلُّ ءَايَةٍ حَتَّىٰ","ٱلْعَذَابَ ٱلْأَلِيمَ",46],["11:27:8",224,"نَرَىٰكَ","we see you","مِن قَوْمِهِۦ مَا","إِلَّا بَشَرًۭا مِّثْلَنَا",46],["11:27:13",224,"نَرَىٰكَ","we see you","بَشَرًۭا مِّثْلَنَا وَمَا","ٱتَّبَعَكَ إِلَّا ٱلَّذِينَ",46],["11:27:20",224,"ٱلرَّأْىِ","immature in opinion","هُمْ أَرَاذِلُنَا بَادِىَ","وَمَا نَرَىٰ لَكُمْ",2591],["11:27:22",224,"نَرَىٰ","we see","بَادِىَ ٱلرَّأْىِ وَمَا","لَكُمْ عَلَيْنَا مِن",46],["11:28:3",224,"أَرَءَيْتُمْ","Do you see","قَالَ يَـٰقَوْمِ","إِن كُنتُ عَلَىٰ",46],["11:29:20",225,"أَرَىٰكُمْ","see you","مُّلَـٰقُوا۟ رَبِّهِمْ وَلَـٰكِنِّىٓ","قَوْمًۭا تَجْهَلُونَ",46],["11:63:3",229,"أَرَءَيْتُمْ","Do you see","قَالَ يَـٰقَوْمِ","إِن كُنتُ عَلَىٰ",46],["11:70:2",229,"رَءَآ","he saw","فَلَمَّا","أَيْدِيَهُمْ لَا تَصِلُ",46],["11:84:19",231,"أَرَىٰكُم","see you","ٱلْمِكْيَالَ وَٱلْمِيزَانَ ۚ إِنِّىٓ","بِخَيْرٍۢ وَإِنِّىٓ أَخَافُ",46],["11:88:3",231,"أَرَءَيْتُمْ","Do you see","قَالَ يَـٰقَوْمِ","إِن كُنتُ عَلَىٰ",46],["11:91:9",232,"لَنَرَىٰكَ","surely [we] see you","مِّمَّا تَقُولُ وَإِنَّا","فِينَا ضَعِيفًۭا ۖ وَلَوْلَا",46],["12:4:7",235,"رَأَيْتُ","I saw","لِأَبِيهِ يَـٰٓأَبَتِ إِنِّى","أَحَدَ عَشَرَ كَوْكَبًۭا",46],["12:4:13",235,"رَأَيْتُهُمْ","I saw them","كَوْكَبًۭا وَٱلشَّمْسَ وَٱلْقَمَرَ","لِى سَـٰجِدِينَ",46],["12:5:5",236,"رُءْيَاكَ","your vision","يَـٰبُنَىَّ لَا تَقْصُصْ","عَلَىٰٓ إِخْوَتِكَ فَيَكِيدُوا۟",1098],["12:24:8",238,"رَّءَا","he saw","بِهَا لَوْلَآ أَن","بُرْهَـٰنَ رَبِّهِۦ ۚ كَذَٰلِكَ",46],["12:28:2",238,"رَءَا","he saw","فَلَمَّا","قَمِيصَهُۥ قُدَّ مِن",46],["12:30:15",238,"لَنَرَىٰهَا","[we] surely see her","شَغَفَهَا حُبًّا ۖ إِنَّا","فِى ضَلَـٰلٍۢ مُّبِينٍۢ",46],["12:31:18",239,"رَأَيْنَهُۥٓ","they saw him","ٱخْرُجْ عَلَيْهِنَّ ۖ فَلَمَّا","أَكْبَرْنَهُۥ وَقَطَّعْنَ أَيْدِيَهُنَّ",46],["12:35:7",239,"رَأَوُا۟","they had seen","مِّنۢ بَعْدِ مَا","ٱلْـَٔايَـٰتِ لَيَسْجُنُنَّهُۥ حَتَّىٰ",46],["12:36:8",239,"أَرَىٰنِىٓ","[I] see myself","قَالَ أَحَدُهُمَآ إِنِّىٓ","أَعْصِرُ خَمْرًۭا ۖ وَقَالَ",46],["12:36:14",239,"أَرَىٰنِىٓ","[I] see myself","وَقَالَ ٱلْـَٔاخَرُ إِنِّىٓ","أَحْمِلُ فَوْقَ رَأْسِى",46],["12:36:25",239,"نَرَىٰكَ","[we] see you","نَبِّئْنَا بِتَأْوِيلِهِۦٓ ۖ إِنَّا","مِنَ ٱلْمُحْسِنِينَ",46],["12:43:4",240,"أَرَىٰ","[I] have seen","وَقَالَ ٱلْمَلِكُ إِنِّىٓ","سَبْعَ بَقَرَٰتٍۢ سِمَانٍۢ",46],["12:43:20",240,"رُءْيَـٰىَ","my vision","ٱلْمَلَأُ أَفْتُونِى فِى","إِن كُنتُمْ لِلرُّءْيَا",1098],["12:43:23",240,"لِلرُّءْيَا","of visions","رُءْيَـٰىَ إِن كُنتُمْ","تَعْبُرُونَ",1098],["12:59:11",242,"تَرَوْنَ","you see","مِّنْ أَبِيكُمْ ۚ أَلَا","أَنِّىٓ أُوفِى ٱلْكَيْلَ",46],["12:78:13",244,"نَرَىٰكَ","[we] see you","أَحَدَنَا مَكَانَهُۥٓ ۖ إِنَّا","مِنَ ٱلْمُحْسِنِينَ",46],["12:100:12",247,"رُءْيَـٰىَ","(of) my dream","يَـٰٓأَبَتِ هَـٰذَا تَأْوِيلُ","مِن قَبْلُ قَدْ",1098],["13:2:7",249,"تَرَوْنَهَا ۖ","that you see","ٱلسَّمَـٰوَٰتِ بِغَيْرِ عَمَدٍۢ","ثُمَّ ٱسْتَوَىٰ عَلَى",46],["13:12:3",250,"يُرِيكُمُ","shows you","هُوَ ٱلَّذِى","ٱلْبَرْقَ خَوْفًۭا وَطَمَعًۭا",287],["13:40:3",254,"نُرِيَنَّكَ","We show you","وَإِن مَّا","بَعْضَ ٱلَّذِى نَعِدُهُمْ",287],["13:41:2",254,"يَرَوْا۟","they see","أَوَلَمْ","أَنَّا نَأْتِى ٱلْأَرْضَ",46],["14:19:2",258,"تَرَ","you see","أَلَمْ","أَنَّ ٱللَّهَ خَلَقَ",46],["14:24:2",258,"تَرَ","you see","أَلَمْ","كَيْفَ ضَرَبَ ٱللَّهُ",46],["14:28:2",259,"تَرَ","you seen","۞ أَلَمْ","إِلَى ٱلَّذِينَ بَدَّلُوا۟",46],["14:49:1",261,"وَتَرَى","And you will see","","ٱلْمُجْرِمِينَ يَوْمَئِذٍۢ مُّقَرَّنِينَ",46],["16:14:13",268,"وَتَرَى","And you see","مِنْهُ حِلْيَةًۭ تَلْبَسُونَهَا","ٱلْفُلْكَ مَوَاخِرَ فِيهِ",46],["16:48:2",272,"يَرَوْا۟","they seen","أَوَلَمْ","إِلَىٰ مَا خَلَقَ",46],["16:79:2",275,"يَرَوْا۟","they see","أَلَمْ","إِلَى ٱلطَّيْرِ مُسَخَّرَٰتٍۢ",46],["16:85:2",276,"رَءَا","(will) see","وَإِذَا","ٱلَّذِينَ ظَلَمُوا۟ ٱلْعَذَابَ",46],["16:86:2",276,"رَءَا","(will) see","وَإِذَا","ٱلَّذِينَ أَشْرَكُوا۟ شُرَكَآءَهُمْ",46],["17:1:15",282,"لِنُرِيَهُۥ","that We may show him","ٱلَّذِى بَـٰرَكْنَا حَوْلَهُۥ","مِنْ ءَايَـٰتِنَآ ۚ إِنَّهُۥ",287],["17:60:10",288,"ٱلرُّءْيَا","the vision","بِٱلنَّاسِ ۚ وَمَا جَعَلْنَا","ٱلَّتِىٓ أَرَيْنَـٰكَ إِلَّا",1098],["17:60:12",288,"أَرَيْنَـٰكَ","We showed you","جَعَلْنَا ٱلرُّءْيَا ٱلَّتِىٓ","إِلَّا فِتْنَةًۭ لِّلنَّاسِ",287],["17:62:2",288,"أَرَءَيْتَكَ","Do You see","قَالَ","هَـٰذَا ٱلَّذِى كَرَّمْتَ",46],["17:99:2",292,"يَرَوْا۟","they see","۞ أَوَلَمْ","أَنَّ ٱللَّهَ ٱلَّذِى",46],["18:17:1",295,"۞ وَتَرَى","And you (might) have seen","","ٱلشَّمْسَ إِذَا طَلَعَت",46],["18:39:14",298,"تَرَنِ","you see me","إِلَّا بِٱللَّهِ ۚ إِن","أَنَا۠ أَقَلَّ مِنكَ",46],["18:47:4",299,"وَتَرَى","and you will see","وَيَوْمَ نُسَيِّرُ ٱلْجِبَالَ","ٱلْأَرْضَ بَارِزَةًۭ وَحَشَرْنَـٰهُمْ",46],["18:49:3",299,"فَتَرَى","and you will see","وَوُضِعَ ٱلْكِتَـٰبُ","ٱلْمُجْرِمِينَ مُشْفِقِينَ مِمَّا",46],["18:53:1",299,"وَرَءَا","And will see","","ٱلْمُجْرِمُونَ ٱلنَّارَ فَظَنُّوٓا۟",46],["18:63:2",301,"أَرَءَيْتَ","Did you see","قَالَ","إِذْ أَوَيْنَآ إِلَى",46],["19:26:6",307,"تَرَيِنَّ","you see","وَقَرِّى عَيْنًۭا ۖ فَإِمَّا","مِنَ ٱلْبَشَرِ أَحَدًۭا",46],["19:74:9",310,"وَرِءْيًۭا","and appearance","هُمْ أَحْسَنُ أَثَـٰثًۭا","",4185],["19:75:12",310,"رَأَوْا۟","they see","مَدًّا ۚ حَتَّىٰٓ إِذَا","مَا يُوعَدُونَ إِمَّا",46],["19:77:1",311,"أَفَرَءَيْتَ","Then, have you seen","","ٱلَّذِى كَفَرَ بِـَٔايَـٰتِنَا",46],["19:83:2",311,"تَرَ","you see","أَلَمْ","أَنَّآ أَرْسَلْنَا ٱلشَّيَـٰطِينَ",46],["20:10:2",312,"رَءَا","he saw","إِذْ","نَارًۭا فَقَالَ لِأَهْلِهِ",46],["20:23:1",313,"لِنُرِيَكَ","That We may show you","","مِنْ ءَايَـٰتِنَا ٱلْكُبْرَى",287],["20:46:7",314,"وَأَرَىٰ","and I see","إِنَّنِى مَعَكُمَآ أَسْمَعُ","",46],["20:56:2",315,"أَرَيْنَـٰهُ","We showed him","وَلَقَدْ","ءَايَـٰتِنَا كُلَّهَا فَكَذَّبَ",287],["20:89:2",318,"يَرَوْنَ","they see","أَفَلَا","أَلَّا يَرْجِعُ إِلَيْهِمْ",46],["20:92:6",318,"رَأَيْتَهُمْ","you saw them","مَا مَنَعَكَ إِذْ","ضَلُّوٓا۟",46],["20:107:2",319,"تَرَىٰ","you will see","لَّا","فِيهَا عِوَجًۭا وَلَآ",46],["21:30:2",324,"يَرَ","see","أَوَلَمْ","ٱلَّذِينَ كَفَرُوٓا۟ أَنَّ",46],["21:36:2",325,"رَءَاكَ","they see you","وَإِذَا","ٱلَّذِينَ كَفَرُوٓا۟ إِن",46],["21:37:5",325,"سَأُو۟رِيكُمْ","I will show you","ٱلْإِنسَـٰنُ مِنْ عَجَلٍۢ ۚ","ءَايَـٰتِى فَلَا تَسْتَعْجِلُونِ",287],["21:44:10",325,"يَرَوْنَ","they see","عَلَيْهِمُ ٱلْعُمُرُ ۗ أَفَلَا","أَنَّا نَأْتِى ٱلْأَرْضَ",46],["22:2:2",332,"تَرَوْنَهَا","you will see it","يَوْمَ","تَذْهَلُ كُلُّ مُرْضِعَةٍ",46],["22:2:13",332,"وَتَرَى","and you will see","ذَاتِ حَمْلٍ حَمْلَهَا","ٱلنَّاسَ سُكَـٰرَىٰ وَمَا",46],["22:5:56",332,"وَتَرَى","And you see","بَعْدِ عِلْمٍۢ شَيْـًۭٔا ۚ","ٱلْأَرْضَ هَامِدَةًۭ فَإِذَآ",46],["22:18:2",334,"تَرَ","you see","أَلَمْ","أَنَّ ٱللَّهَ يَسْجُدُ",46],["22:63:2",339,"تَرَ","you see","أَلَمْ","أَنَّ ٱللَّهَ أَنزَلَ",46],["22:65:2",340,"تَرَ","you see","أَلَمْ","أَنَّ ٱللَّهَ سَخَّرَ",46],["23:93:4",348,"تُرِيَنِّى","You should show me","قُل رَّبِّ إِمَّا","مَا يُوعَدُونَ",287],["23:95:4",348,"نُّرِيَكَ","We show you","وَإِنَّا عَلَىٰٓ أَن","مَا نَعِدُهُمْ لَقَـٰدِرُونَ",287],["24:40:23",355,"يَرَىٰهَا ۗ","he (can) see it","يَدَهُۥ لَمْ يَكَدْ","وَمَن لَّمْ يَجْعَلِ",46],["24:41:2",355,"تَرَ","you see","أَلَمْ","أَنَّ ٱللَّهَ يُسَبِّحُ",46],["24:43:2",355,"تَرَ","you see","أَلَمْ","أَنَّ ٱللَّهَ يُزْجِى",46],["24:43:13",355,"فَتَرَى","then you see","ثُمَّ يَجْعَلُهُۥ رُكَامًۭا","ٱلْوَدْقَ يَخْرُجُ مِنْ",46],["25:12:2",361,"رَأَتْهُم","it sees them","إِذَا","مِّن مَّكَانٍۭ بَعِيدٍۢ",46],["25:21:11",362,"نَرَىٰ","we see","عَلَيْنَا ٱلْمَلَـٰٓئِكَةُ أَوْ","رَبَّنَا ۗ لَقَدِ ٱسْتَكْبَرُوا۟",46],["25:22:2",362,"يَرَوْنَ","they see","يَوْمَ","ٱلْمَلَـٰٓئِكَةَ لَا بُشْرَىٰ",46],["25:40:11",363,"يَرَوْنَهَا ۚ","see it","ٱلسَّوْءِ ۚ أَفَلَمْ يَكُونُوا۟","بَلْ كَانُوا۟ لَا",46],["25:41:2",363,"رَأَوْكَ","they see you","وَإِذَا","إِن يَتَّخِذُونَكَ إِلَّا",46],["25:42:13",363,"يَرَوْنَ","they will see","وَسَوْفَ يَعْلَمُونَ حِينَ","ٱلْعَذَابَ مَنْ أَضَلُّ",46],["25:43:1",363,"أَرَءَيْتَ","Have you seen","","مَنِ ٱتَّخَذَ إِلَـٰهَهُۥ",46],["25:45:2",364,"تَرَ","see","أَلَمْ","إِلَىٰ رَبِّكَ كَيْفَ",46],["26:7:2",367,"يَرَوْا۟","they see","أَوَلَمْ","إِلَى ٱلْأَرْضِ كَمْ",46],["26:61:2",370,"تَرَٰٓءَا","saw each other","فَلَمَّا","ٱلْجَمْعَانِ قَالَ أَصْحَـٰبُ",2677],["26:75:2",370,"أَفَرَءَيْتُم","Do you see","قَالَ","مَّا كُنتُمْ تَعْبُدُونَ",46],["26:201:5",375,"يَرَوُا۟","they see","يُؤْمِنُونَ بِهِۦ حَتَّىٰ","ٱلْعَذَابَ ٱلْأَلِيمَ",46],["26:205:1",375,"أَفَرَءَيْتَ","Then have you seen","","إِن مَّتَّعْنَـٰهُمْ سِنِينَ",46],["26:218:2",376,"يَرَىٰكَ","sees you","ٱلَّذِى","حِينَ تَقُومُ",46],["26:225:2",376,"تَرَ","you see","أَلَمْ","أَنَّهُمْ فِى كُلِّ",46],["27:10:4",377,"رَءَاهَا","he saw it","وَأَلْقِ عَصَاكَ ۚ فَلَمَّا","تَهْتَزُّ كَأَنَّهَا جَآنٌّۭ",46],["27:20:7",378,"أَرَى","I see","مَا لِىَ لَآ","ٱلْهُدْهُدَ أَمْ كَانَ",46],["27:40:16",380,"رَءَاهُ","he saw it","إِلَيْكَ طَرْفُكَ ۚ فَلَمَّا","مُسْتَقِرًّا عِندَهُۥ قَالَ",46],["27:44:6",380,"رَأَتْهُ","she saw it","ٱدْخُلِى ٱلصَّرْحَ ۖ فَلَمَّا","حَسِبَتْهُ لُجَّةًۭ وَكَشَفَتْ",46],["27:86:2",384,"يَرَوْا۟","they see","أَلَمْ","أَنَّا جَعَلْنَا ٱلَّيْلَ",46],["27:88:1",384,"وَتَرَى","And you see","","ٱلْجِبَالَ تَحْسَبُهَا جَامِدَةًۭ",46],["27:93:4",385,"سَيُرِيكُمْ","He will show you","وَقُلِ ٱلْحَمْدُ لِلَّهِ","ءَايَـٰتِهِۦ فَتَعْرِفُونَهَا ۚ وَمَا",287],["28:6:5",386,"وَنُرِىَ","and show","لَهُمْ فِى ٱلْأَرْضِ","فِرْعَوْنَ وَهَـٰمَـٰنَ وَجُنُودَهُمَا",287],["28:31:5",389,"رَءَاهَا","he saw it","أَلْقِ عَصَاكَ ۖ فَلَمَّا","تَهْتَزُّ كَأَنَّهَا جَآنٌّۭ",46],["28:64:8",393,"وَرَأَوُا۟","and they will see","فَلَمْ يَسْتَجِيبُوا۟ لَهُمْ","ٱلْعَذَابَ ۚ لَوْ أَنَّهُمْ",46],["28:71:2",394,"أَرَءَيْتُمْ","Have you seen","قُلْ","إِن جَعَلَ ٱللَّهُ",46],["28:72:2",394,"أَرَءَيْتُمْ","Have you seen","قُلْ","إِن جَعَلَ ٱللَّهُ",46],["29:19:2",398,"يَرَوْا۟","they see","أَوَلَمْ","كَيْفَ يُبْدِئُ ٱللَّهُ",46],["29:67:2",404,"يَرَوْا۟","they see","أَوَلَمْ","أَنَّا جَعَلْنَا حَرَمًا",46],["30:24:3",406,"يُرِيكُمُ","He shows you","وَمِنْ ءَايَـٰتِهِۦ","ٱلْبَرْقَ خَوْفًۭا وَطَمَعًۭا",287],["30:37:2",408,"يَرَوْا۟","they see","أَوَلَمْ","أَنَّ ٱللَّهَ يَبْسُطُ",46],["30:48:14",409,"فَتَرَى","so you see","يَشَآءُ وَيَجْعَلُهُۥ كِسَفًۭا","ٱلْوَدْقَ يَخْرُجُ مِنْ",46],["30:51:4",410,"فَرَأَوْهُ","and they see it","وَلَئِنْ أَرْسَلْنَا رِيحًۭا","مُصْفَرًّۭا لَّظَلُّوا۟ مِنۢ",46],["31:10:5",411,"تَرَوْنَهَا ۖ","that you see","ٱلسَّمَـٰوَٰتِ بِغَيْرِ عَمَدٍۢ","وَأَلْقَىٰ فِى ٱلْأَرْضِ",46],["31:11:4",411,"فَأَرُونِى","So show Me","هَـٰذَا خَلْقُ ٱللَّهِ","مَاذَا خَلَقَ ٱلَّذِينَ",287],["31:20:2",413,"تَرَوْا۟","you see","أَلَمْ","أَنَّ ٱللَّهَ سَخَّرَ",46],["31:29:2",414,"تَرَ","you see","أَلَمْ","أَنَّ ٱللَّهَ يُولِجُ",46],["31:31:2",414,"تَرَ","you see","أَلَمْ","أَنَّ ٱلْفُلْكَ تَجْرِى",46],["31:31:10",414,"لِيُرِيَكُم","that He may show you","ٱلْبَحْرِ بِنِعْمَتِ ٱللَّهِ","مِّنْ ءَايَـٰتِهِۦٓ ۚ إِنَّ",287],["32:12:2",416,"تَرَىٰٓ","you (could) see","وَلَوْ","إِذِ ٱلْمُجْرِمُونَ نَاكِسُوا۟",46],["32:27:2",417,"يَرَوْا۟","they see","أَوَلَمْ","أَنَّا نَسُوقُ ٱلْمَآءَ",46],["33:9:16",419,"تَرَوْهَا ۚ","you (could) see them","رِيحًۭا وَجُنُودًۭا لَّمْ","وَكَانَ ٱللَّهُ بِمَا",46],["33:19:6",420,"رَأَيْتَهُمْ","you see them","فَإِذَا جَآءَ ٱلْخَوْفُ","يَنظُرُونَ إِلَيْكَ تَدُورُ",46],["33:22:2",420,"رَءَا","saw","وَلَمَّا","ٱلْمُؤْمِنُونَ ٱلْأَحْزَابَ قَالُوا۟",46],["34:6:1",428,"وَيَرَى","And see","","ٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ",46],["34:9:2",429,"يَرَوْا۟","they see","أَفَلَمْ","إِلَىٰ مَا بَيْنَ",46],["34:27:2",431,"أَرُونِىَ","Show me","قُلْ","ٱلَّذِينَ أَلْحَقْتُم بِهِۦ",287],["34:31:13",431,"تَرَىٰٓ","you (could) see","بَيْنَ يَدَيْهِ ۗ وَلَوْ","إِذِ ٱلظَّـٰلِمُونَ مَوْقُوفُونَ",46],["34:33:21",432,"رَأَوُا۟","they see","وَأَسَرُّوا۟ ٱلنَّدَامَةَ لَمَّا","ٱلْعَذَابَ وَجَعَلْنَا ٱلْأَغْلَـٰلَ",46],["34:51:2",434,"تَرَىٰٓ","you (could) see","وَلَوْ","إِذْ فَزِعُوا۟ فَلَا",46],["35:8:6",435,"فَرَءَاهُ","so that he sees it","لَهُۥ سُوٓءُ عَمَلِهِۦ","حَسَنًۭا ۖ فَإِنَّ ٱللَّهَ",46],["35:12:20",436,"وَتَرَى","and you see","وَتَسْتَخْرِجُونَ حِلْيَةًۭ تَلْبَسُونَهَا ۖ","ٱلْفُلْكَ فِيهِ مَوَاخِرَ",46],["35:27:2",437,"تَرَ","you see","أَلَمْ","أَنَّ ٱللَّهَ أَنزَلَ",46],["35:40:2",439,"أَرَءَيْتُمْ","Have you seen","قُلْ","شُرَكَآءَكُمُ ٱلَّذِينَ تَدْعُونَ",46],["35:40:9",439,"أَرُونِى","Show Me","مِن دُونِ ٱللَّهِ","مَاذَا خَلَقُوا۟ مِنَ",287],["36:31:2",442,"يَرَوْا۟","they see","أَلَمْ","كَمْ أَهْلَكْنَا قَبْلَهُم",46],["36:71:2",445,"يَرَوْا۟","they see","أَوَلَمْ","أَنَّا خَلَقْنَا لَهُم",46],["36:77:2",445,"يَرَ","see","أَوَلَمْ","ٱلْإِنسَـٰنُ أَنَّا خَلَقْنَـٰهُ",46],["37:14:2",446,"رَأَوْا۟","they see","وَإِذَا","ءَايَةًۭ يَسْتَسْخِرُونَ",46],["37:55:2",448,"فَرَءَاهُ","and see him","فَٱطَّلَعَ","فِى سَوَآءِ ٱلْجَحِيمِ",46],["37:102:8",449,"أَرَىٰ","have seen","قَالَ يَـٰبُنَىَّ إِنِّىٓ","فِى ٱلْمَنَامِ أَنِّىٓ",46],["37:102:15",449,"تَرَىٰ ۚ","you see","أَذْبَحُكَ فَٱنظُرْ مَاذَا","قَالَ يَـٰٓأَبَتِ ٱفْعَلْ",46],["37:105:3",450,"ٱلرُّءْيَآ ۚ","the vision","قَدْ صَدَّقْتَ","إِنَّا كَذَٰلِكَ نَجْزِى",1098],["38:62:5",457,"نَرَىٰ","we see","مَا لَنَا لَا","رِجَالًۭا كُنَّا نَعُدُّهُم",46],["39:21:2",460,"تَرَ","you see","أَلَمْ","أَنَّ ٱللَّهَ أَنزَلَ",46],["39:21:21",460,"فَتَرَىٰهُ","and you see it","أَلْوَٰنُهُۥ ثُمَّ يَهِيجُ","مُصْفَرًّۭا ثُمَّ يَجْعَلُهُۥ",46],["39:38:10",462,"أَفَرَءَيْتُم","Then do you see","لَيَقُولُنَّ ٱللَّهُ ۚ قُلْ","مَّا تَدْعُونَ مِن",46],["39:58:4",465,"تَرَى","it sees","أَوْ تَقُولَ حِينَ","ٱلْعَذَابَ لَوْ أَنَّ",46],["39:60:3",465,"تَرَى","you will see","وَيَوْمَ ٱلْقِيَـٰمَةِ","ٱلَّذِينَ كَذَبُوا۟ عَلَى",46],["39:75:1",467,"وَتَرَى","And you will see","","ٱلْمَلَـٰٓئِكَةَ حَآفِّينَ مِنْ",46],["40:13:3",468,"يُرِيكُمْ","shows you","هُوَ ٱلَّذِى","ءَايَـٰتِهِۦ وَيُنَزِّلُ لَكُم",287],["40:29:18",470,"أُرِيكُمْ","I show you","قَالَ فِرْعَوْنُ مَآ","إِلَّا مَآ أَرَىٰ",287],["40:29:21",470,"أَرَىٰ","I see","أُرِيكُمْ إِلَّا مَآ","وَمَآ أَهْدِيكُمْ إِلَّا",46],["40:69:2",475,"تَرَ","you see","أَلَمْ","إِلَى ٱلَّذِينَ يُجَـٰدِلُونَ",46],["40:77:7",475,"نُرِيَنَّكَ","We show you","ٱللَّهِ حَقٌّۭ ۚ فَإِمَّا","بَعْضَ ٱلَّذِى نَعِدُهُمْ",287],["40:81:1",476,"وَيُرِيكُمْ","And He shows you","","ءَايَـٰتِهِۦ فَأَىَّ ءَايَـٰتِ",287],["40:84:2",476,"رَأَوْا۟","they saw","فَلَمَّا","بَأْسَنَا قَالُوٓا۟ ءَامَنَّا",46],["40:85:6",476,"رَأَوْا۟","they saw","يَنفَعُهُمْ إِيمَـٰنُهُمْ لَمَّا","بَأْسَنَا ۖ سُنَّتَ ٱللَّهِ",46],["41:15:14",478,"يَرَوْا۟","they see","مِنَّا قُوَّةً ۖ أَوَلَمْ","أَنَّ ٱللَّهَ ٱلَّذِى",46],["41:29:5",479,"أَرِنَا","Show us","ٱلَّذِينَ كَفَرُوا۟ رَبَّنَآ","ٱلَّذَيْنِ أَضَلَّانَا مِنَ",287],["41:39:4",481,"تَرَى","see","وَمِنْ ءَايَـٰتِهِۦٓ أَنَّكَ","ٱلْأَرْضَ خَـٰشِعَةًۭ فَإِذَآ",46],["41:52:2",482,"أَرَءَيْتُمْ","You see","قُلْ","إِن كَانَ مِنْ",46],["41:53:1",482,"سَنُرِيهِمْ","Soon We will show them","","ءَايَـٰتِنَا فِى ٱلْـَٔافَاقِ",287],["42:22:1",485,"تَرَى","You will see","","ٱلظَّـٰلِمِينَ مُشْفِقِينَ مِمَّا",46],["42:44:10",487,"وَتَرَى","And you will see","وَلِىٍّۢ مِّنۢ بَعْدِهِۦ ۗ","ٱلظَّـٰلِمِينَ لَمَّا رَأَوُا۟",46],["42:44:13",487,"رَأَوُا۟","they see","وَتَرَى ٱلظَّـٰلِمِينَ لَمَّا","ٱلْعَذَابَ يَقُولُونَ هَلْ",46],["42:45:1",488,"وَتَرَىٰهُمْ","And you will see them","","يُعْرَضُونَ عَلَيْهَا خَـٰشِعِينَ",46],["43:42:2",492,"نُرِيَنَّكَ","We show you","أَوْ","ٱلَّذِى وَعَدْنَـٰهُمْ فَإِنَّا",287],["43:48:2",493,"نُرِيهِم","We showed them","وَمَا","مِّنْ ءَايَةٍ إِلَّا",287],["45:23:1",501,"أَفَرَءَيْتَ","Have you seen","","مَنِ ٱتَّخَذَ إِلَـٰهَهُۥ",46],["45:28:1",501,"وَتَرَىٰ","And you will see","","كُلَّ أُمَّةٍۢ جَاثِيَةًۭ ۚ",46],["46:4:2",502,"أَرَءَيْتُم","Do you see","قُلْ","مَّا تَدْعُونَ مِن",46],["46:4:8",502,"أَرُونِى","Show me","مِن دُونِ ٱللَّهِ","مَاذَا خَلَقُوا۟ مِنَ",287],["46:10:2",503,"أَرَءَيْتُمْ","Do you see","قُلْ","إِن كَانَ مِنْ",46],["46:23:11",505,"أَرَىٰكُمْ","I see you","أُرْسِلْتُ بِهِۦ وَلَـٰكِنِّىٓ","قَوْمًۭا تَجْهَلُونَ",46],["46:24:2",505,"رَأَوْهُ","they saw it","فَلَمَّا","عَارِضًۭا مُّسْتَقْبِلَ أَوْدِيَتِهِمْ",46],["46:25:8",505,"يُرَىٰٓ","is seen","رَبِّهَا فَأَصْبَحُوا۟ لَا","إِلَّا مَسَـٰكِنُهُمْ ۚ كَذَٰلِكَ",46],["46:33:2",506,"يَرَوْا۟","they see","أَوَلَمْ","أَنَّ ٱللَّهَ ٱلَّذِى",46],["46:35:13",506,"يَرَوْنَ","they see","لَّهُمْ ۚ كَأَنَّهُمْ يَوْمَ","مَا يُوعَدُونَ لَمْ",46],["47:20:14",509,"رَأَيْتَ","you see","وَذُكِرَ فِيهَا ٱلْقِتَالُ ۙ","ٱلَّذِينَ فِى قُلُوبِهِم",46],["47:30:3",510,"لَأَرَيْنَـٰكَهُمْ","surely, We could show them to you","وَلَوْ نَشَآءُ","فَلَعَرَفْتَهُم بِسِيمَـٰهُمْ ۚ وَلَتَعْرِفَنَّهُمْ",287],["48:27:5",514,"ٱلرُّءْيَا","vision","صَدَقَ ٱللَّهُ رَسُولَهُ","بِٱلْحَقِّ ۖ لَتَدْخُلُنَّ ٱلْمَسْجِدَ",1098],["48:29:11",515,"تَرَىٰهُمْ","You see them","ٱلْكُفَّارِ رُحَمَآءُ بَيْنَهُمْ ۖ","رُكَّعًۭا سُجَّدًۭا يَبْتَغُونَ",46],["52:44:2",525,"يَرَوْا۟","they were to see","وَإِن","كِسْفًۭا مِّنَ ٱلسَّمَآءِ",46],["53:11:5",526,"رَأَىٰٓ","it saw","كَذَبَ ٱلْفُؤَادُ مَا","",46],["53:12:4",526,"يَرَىٰ","he saw","أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا","",46],["53:13:2",526,"رَءَاهُ","he saw him","وَلَقَدْ","نَزْلَةً أُخْرَىٰ",46],["53:18:2",526,"رَأَىٰ","he saw","لَقَدْ","مِنْ ءَايَـٰتِ رَبِّهِ",46],["53:19:1",526,"أَفَرَءَيْتُمُ","So have you seen","","ٱللَّـٰتَ وَٱلْعُزَّىٰ",46],["53:33:1",527,"أَفَرَءَيْتَ","Did you see","","ٱلَّذِى تَوَلَّىٰ",46],["53:35:5",527,"يَرَىٰٓ","sees","عِلْمُ ٱلْغَيْبِ فَهُوَ","",46],["53:40:4",527,"يُرَىٰ","be seen","وَأَنَّ سَعْيَهُۥ سَوْفَ","",46],["54:2:2",528,"يَرَوْا۟","they see","وَإِن","ءَايَةًۭ يُعْرِضُوا۟ وَيَقُولُوا۟",46],["56:58:1",536,"أَفَرَءَيْتُم","Do you see","","مَّا تُمْنُونَ",46],["56:63:1",536,"أَفَرَءَيْتُم","And do you see","","مَّا تَحْرُثُونَ",46],["56:68:1",536,"أَفَرَءَيْتُمُ","Do you see","","ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ",46],["56:71:1",536,"أَفَرَءَيْتُمُ","Do you see","","ٱلنَّارَ ٱلَّتِى تُورُونَ",46],["57:12:2",539,"تَرَى","you will see","يَوْمَ","ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ يَسْعَىٰ",46],["57:20:21",540,"فَتَرَىٰهُ","and you see it","نَبَاتُهُۥ ثُمَّ يَهِيجُ","مُصْفَرًّۭا ثُمَّ يَكُونُ",46],["58:7:2",543,"تَرَ","you see","أَلَمْ","أَنَّ ٱللَّهَ يَعْلَمُ",46],["58:8:2",543,"تَرَ","you see","أَلَمْ","إِلَى ٱلَّذِينَ نُهُوا۟",46],["58:14:2",544,"تَرَ","you see","۞ أَلَمْ","إِلَى ٱلَّذِينَ تَوَلَّوْا۟",46],["59:11:2",547,"تَرَ","you see","۞ أَلَمْ","إِلَى ٱلَّذِينَ نَافَقُوا۟",46],["59:21:7",548,"لَّرَأَيْتَهُۥ","surely you (would) have seen it","ٱلْقُرْءَانَ عَلَىٰ جَبَلٍۢ","خَـٰشِعًۭا مُّتَصَدِّعًۭا مِّنْ",46],["62:11:2",554,"رَأَوْا۟","they saw","وَإِذَا","تِجَـٰرَةً أَوْ لَهْوًا",46],["63:4:2",554,"رَأَيْتَهُمْ","you see them","۞ وَإِذَا","تُعْجِبُكَ أَجْسَامُهُمْ ۖ وَإِن",46],["63:5:11",555,"وَرَأَيْتَهُمْ","and you see them","ٱللَّهِ لَوَّوْا۟ رُءُوسَهُمْ","يَصُدُّونَ وَهُم مُّسْتَكْبِرُونَ",46],["67:3:7",562,"تَرَىٰ","you see","سَمَـٰوَٰتٍۢ طِبَاقًۭا ۖ مَّا","فِى خَلْقِ ٱلرَّحْمَـٰنِ",46],["67:3:16",562,"تَرَىٰ","you see","فَٱرْجِعِ ٱلْبَصَرَ هَلْ","مِن فُطُورٍۢ",46],["67:19:2",563,"يَرَوْا۟","they see","أَوَلَمْ","إِلَى ٱلطَّيْرِ فَوْقَهُمْ",46],["67:27:2",564,"رَأَوْهُ","they (will) see it","فَلَمَّا","زُلْفَةًۭ سِيٓـَٔتْ وُجُوهُ",46],["67:28:2",564,"أَرَءَيْتُمْ","Have you seen","قُلْ","إِنْ أَهْلَكَنِىَ ٱللَّهُ",46],["67:30:2",564,"أَرَءَيْتُمْ","Have you seen","قُلْ","إِنْ أَصْبَحَ مَآؤُكُمْ",46],["68:26:2",565,"رَأَوْهَا","they saw it","فَلَمَّا","قَالُوٓا۟ إِنَّا لَضَآلُّونَ",46],["69:7:8",566,"فَتَرَى","so you would see","وَثَمَـٰنِيَةَ أَيَّامٍ حُسُومًۭا","ٱلْقَوْمَ فِيهَا صَرْعَىٰ",46],["69:8:2",566,"تَرَىٰ","you see","فَهَلْ","لَهُم مِّنۢ بَاقِيَةٍۢ",46],["70:6:2",568,"يَرَوْنَهُۥ","see it","إِنَّهُمْ","بَعِيدًۭا",46],["70:7:1",568,"وَنَرَىٰهُ","But We see it","","قَرِيبًۭا",46],["71:15:2",571,"تَرَوْا۟","you see","أَلَمْ","كَيْفَ خَلَقَ ٱللَّهُ",46],["72:24:3",573,"رَأَوْا۟","they see","حَتَّىٰٓ إِذَا","مَا يُوعَدُونَ فَسَيَعْلَمُونَ",46],["76:13:6",579,"يَرَوْنَ","they will see","عَلَى ٱلْأَرَآئِكِ ۖ لَا","فِيهَا شَمْسًۭا وَلَا",46],["76:19:6",579,"رَأَيْتَهُمْ","you see them","وِلْدَٰنٌۭ مُّخَلَّدُونَ إِذَا","حَسِبْتَهُمْ لُؤْلُؤًۭا مَّنثُورًۭا",46],["76:20:2",579,"رَأَيْتَ","you look","وَإِذَا","ثَمَّ رَأَيْتَ نَعِيمًۭا",46],["76:20:4",579,"رَأَيْتَ","you will see","وَإِذَا رَأَيْتَ ثَمَّ","نَعِيمًۭا وَمُلْكًۭا كَبِيرًا",46],["79:20:1",584,"فَأَرَىٰهُ","Then he showed him","","ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",46],["79:36:4",584,"يَرَىٰ","sees","وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن","",46],["79:46:3",584,"يَرَوْنَهَا","they see it","كَأَنَّهُمْ يَوْمَ","لَمْ يَلْبَثُوٓا۟ إِلَّا",46],["81:23:2",586,"رَءَاهُ","he saw him","وَلَقَدْ","بِٱلْأُفُقِ ٱلْمُبِينِ",46],["83:32:2",588,"رَأَوْهُمْ","they saw them","وَإِذَا","قَالُوٓا۟ إِنَّ هَـٰٓؤُلَآءِ",46],["89:6:2",593,"تَرَ","you see","أَلَمْ","كَيْفَ فَعَلَ رَبُّكَ",46],["90:7:4",594,"يَرَهُۥٓ","sees him","أَيَحْسَبُ أَن لَّمْ","أَحَدٌ",46],["96:7:2",597,"رَّءَاهُ","he sees himself","أَن","ٱسْتَغْنَىٰٓ",46],["96:9:1",597,"أَرَءَيْتَ","Have you seen","","ٱلَّذِى يَنْهَىٰ",46],["96:11:1",597,"أَرَءَيْتَ","Have you seen","","إِن كَانَ عَلَى",46],["96:13:1",598,"أَرَءَيْتَ","Have you seen","","إِن كَذَّبَ وَتَوَلَّىٰٓ",46],["96:14:5",598,"يَرَىٰ","sees","يَعْلَم بِأَنَّ ٱللَّهَ","",46],["99:6:5",599,"لِّيُرَوْا۟","to be shown","يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا","أَعْمَـٰلَهُمْ",287],["99:7:6",599,"يَرَهُۥ","will see it","مِثْقَالَ ذَرَّةٍ خَيْرًۭا","",46],["99:8:6",599,"يَرَهُۥ","will see it","مِثْقَالَ ذَرَّةٍۢ شَرًّۭا","",46],["102:6:1",600,"لَتَرَوُنَّ","Surely you will see","","ٱلْجَحِيمَ",46],["102:7:2",600,"لَتَرَوُنَّهَا","surely you will see it","ثُمَّ","عَيْنَ ٱلْيَقِينِ",46],["105:1:2",601,"تَرَ","you seen","أَلَمْ","كَيْفَ فَعَلَ رَبُّكَ",46],["107:1:1",602,"أَرَءَيْتَ","Have you seen","","ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",46],["107:6:3",602,"يُرَآءُونَ","make show","ٱلَّذِينَ هُمْ","",2812],["110:2:1",603,"وَرَأَيْتَ","And you see","","ٱلنَّاسَ يَدْخُلُونَ فِى",46]]