[["2:60:13",9,"عَيْنًۭا ۖ","springs","مِنْهُ ٱثْنَتَا عَشْرَةَ","قَدْ عَلِمَ كُلُّ",207],["3:13:18",51,"ٱلْعَيْنِ ۚ","(of) their eyes","يَرَوْنَهُم مِّثْلَيْهِمْ رَأْىَ","وَٱللَّهُ يُؤَيِّدُ بِنَصْرِهِۦ",207],["5:45:7",115,"وَٱلْعَيْنَ","and the eye","أَنَّ ٱلنَّفْسَ بِٱلنَّفْسِ","بِٱلْعَيْنِ وَٱلْأَنفَ بِٱلْأَنفِ",207],["5:45:8",115,"بِٱلْعَيْنِ","for the eye","ٱلنَّفْسَ بِٱلنَّفْسِ وَٱلْعَيْنَ","وَٱلْأَنفَ بِٱلْأَنفِ وَٱلْأُذُنَ",207],["5:83:8",121,"أَعْيُنَهُمْ","their eyes","إِلَى ٱلرَّسُولِ تَرَىٰٓ","تَفِيضُ مِنَ ٱلدَّمْعِ",207],["7:116:6",164,"أَعْيُنَ","(the) eyes","فَلَمَّآ أَلْقَوْا۟ سَحَرُوٓا۟","ٱلنَّاسِ وَٱسْتَرْهَبُوهُمْ وَجَآءُو",207],["7:160:20",171,"عَيْنًۭا ۖ","springs","مِنْهُ ٱثْنَتَا عَشْرَةَ","قَدْ عَلِمَ كُلُّ",207],["7:179:14",174,"أَعْيُنٌۭ","(are) eyes","يَفْقَهُونَ بِهَا وَلَهُمْ","لَّا يُبْصِرُونَ بِهَا",207],["7:195:12",175,"أَعْيُنٌۭ","eyes","بِهَآ ۖ أَمْ لَهُمْ","يُبْصِرُونَ بِهَآ ۖ أَمْ",207],["8:44:6",182,"أَعْيُنِكُمْ","your eyes","إِذِ ٱلْتَقَيْتُمْ فِىٓ","قَلِيلًۭا وَيُقَلِّلُكُمْ فِىٓ",207],["8:44:10",182,"أَعْيُنِهِمْ","their eyes","قَلِيلًۭا وَيُقَلِّلُكُمْ فِىٓ","لِيَقْضِىَ ٱللَّهُ أَمْرًۭا",207],["9:92:15",201,"وَّأَعْيُنُهُمْ","with their eyes","أَحْمِلُكُمْ عَلَيْهِ تَوَلَّوا۟","تَفِيضُ مِنَ ٱلدَّمْعِ",207],["11:31:18",225,"أَعْيُنُكُمْ","your eyes","أَقُولُ لِلَّذِينَ تَزْدَرِىٓ","لَن يُؤْتِيَهُمُ ٱللَّهُ",207],["11:37:3",225,"بِأَعْيُنِنَا","under Our Eyes","وَٱصْنَعِ ٱلْفُلْكَ","وَوَحْيِنَا وَلَا تُخَـٰطِبْنِى",207],["12:84:8",245,"عَيْنَاهُ","his eyes","عَلَىٰ يُوسُفَ وَٱبْيَضَّتْ","مِنَ ٱلْحُزْنِ فَهُوَ",207],["15:45:5",264,"وَعُيُونٍ","and water springs","ٱلْمُتَّقِينَ فِى جَنَّـٰتٍۢ","",207],["15:88:3",266,"عَيْنَيْكَ","your eyes","لَا تَمُدَّنَّ","إِلَىٰ مَا مَتَّعْنَا",207],["18:28:13",297,"عَيْنَاكَ","your eyes","وَجْهَهُۥ ۖ وَلَا تَعْدُ","عَنْهُمْ تُرِيدُ زِينَةَ",207],["18:86:9",303,"عَيْنٍ","a spring","وَجَدَهَا تَغْرُبُ فِى","حَمِئَةٍۢ وَوَجَدَ عِندَهَا",207],["18:101:3",304,"أَعْيُنُهُمْ","their eyes","ٱلَّذِينَ كَانَتْ","فِى غِطَآءٍ عَن",207],["19:26:4",307,"عَيْنًۭا ۖ","(your) eyes","فَكُلِى وَٱشْرَبِى وَقَرِّى","فَإِمَّا تَرَيِنَّ مِنَ",207],["20:39:22",314,"عَيْنِىٓ","My eye","مِّنِّى وَلِتُصْنَعَ عَلَىٰ","",207],["20:40:15",314,"عَيْنُهَا","her eyes","أُمِّكَ كَىْ تَقَرَّ","وَلَا تَحْزَنَ ۚ وَقَتَلْتَ",207],["20:131:3",321,"عَيْنَيْكَ","your eyes","وَلَا تَمُدَّنَّ","إِلَىٰ مَا مَتَّعْنَا",207],["21:61:5",327,"أَعْيُنِ","(the) eyes","فَأْتُوا۟ بِهِۦ عَلَىٰٓ","ٱلنَّاسِ لَعَلَّهُمْ يَشْهَدُونَ",207],["23:27:6",343,"بِأَعْيُنِنَا","under Our eyes","أَنِ ٱصْنَعِ ٱلْفُلْكَ","وَوَحْيِنَا فَإِذَا جَآءَ",207],["23:50:11",345,"وَمَعِينٍۢ","and water springs","رَبْوَةٍۢ ذَاتِ قَرَارٍۢ","",1596],["25:74:10",366,"أَعْيُنٍۢ","(to) our eyes","أَزْوَٰجِنَا وَذُرِّيَّـٰتِنَا قُرَّةَ","وَٱجْعَلْنَا لِلْمُتَّقِينَ إِمَامًا",207],["26:57:4",369,"وَعُيُونٍۢ","and springs","فَأَخْرَجْنَـٰهُم مِّن جَنَّـٰتٍۢ","",207],["26:134:2",372,"وَعُيُونٍ","and springs","وَجَنَّـٰتٍۢ","",207],["26:147:3",373,"وَعُيُونٍۢ","and springs","فِى جَنَّـٰتٍۢ","",207],["28:9:5",386,"عَيْنٍۢ","(of the) eye","ٱمْرَأَتُ فِرْعَوْنَ قُرَّتُ","لِّى وَلَكَ ۖ لَا",207],["28:13:6",386,"عَيْنُهَا","her eye","أُمِّهِۦ كَىْ تَقَرَّ","وَلَا تَحْزَنَ وَلِتَعْلَمَ",207],["32:17:9",416,"أَعْيُنٍۢ","(for) the eyes","لَهُم مِّن قُرَّةِ","جَزَآءًۢ بِمَا كَانُوا۟",207],["33:19:10",420,"أَعْيُنُهُمْ","their eyes","يَنظُرُونَ إِلَيْكَ تَدُورُ","كَٱلَّذِى يُغْشَىٰ عَلَيْهِ",207],["33:51:20",425,"أَعْيُنُهُنَّ","their eyes","أَدْنَىٰٓ أَن تَقَرَّ","وَلَا يَحْزَنَّ وَيَرْضَيْنَ",207],["34:12:9",429,"عَيْنَ","a spring","شَهْرٌۭ ۖ وَأَسَلْنَا لَهُۥ","ٱلْقِطْرِ ۖ وَمِنَ ٱلْجِنِّ",207],["36:34:10",442,"ٱلْعُيُونِ","the springs","وَفَجَّرْنَا فِيهَا مِنَ","",207],["36:66:5",444,"أَعْيُنِهِمْ","their eyes","نَشَآءُ لَطَمَسْنَا عَلَىٰٓ","فَٱسْتَبَقُوا۟ ٱلصِّرَٰطَ فَأَنَّىٰ",207],["37:45:5",447,"مَّعِينٍۭ","a flowing spring","عَلَيْهِم بِكَأْسٍۢ مِّن","",1596],["37:48:4",447,"عِينٌۭ","(having) beautiful eyes","وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ","",1505],["40:19:3",469,"ٱلْأَعْيُنِ","(the) stealthy glance","يَعْلَمُ خَآئِنَةَ","وَمَا تُخْفِى ٱلصُّدُورُ",207],["43:71:12",494,"ٱلْأَعْيُنُ ۖ","the eyes","تَشْتَهِيهِ ٱلْأَنفُسُ وَتَلَذُّ","وَأَنتُمْ فِيهَا خَـٰلِدُونَ",207],["44:25:5",497,"وَعُيُونٍۢ","and springs","تَرَكُوا۟ مِن جَنَّـٰتٍۢ","",207],["44:52:3",498,"وَعُيُونٍۢ","and springs","فِى جَنَّـٰتٍۢ","",207],["44:54:4",498,"عِينٍۢ","(to) companions with beautiful eyes","كَذَٰلِكَ وَزَوَّجْنَـٰهُم بِحُورٍ","",1505],["51:15:5",521,"وَعُيُونٍ","and springs","ٱلْمُتَّقِينَ فِى جَنَّـٰتٍۢ","",207],["52:20:7",524,"عِينٍۢ","(with) large eyes","مَّصْفُوفَةٍۢ ۖ وَزَوَّجْنَـٰهُم بِحُورٍ","",1505],["52:48:5",525,"بِأَعْيُنِنَا ۖ","(are) in Our Eyes","لِحُكْمِ رَبِّكَ فَإِنَّكَ","وَسَبِّحْ بِحَمْدِ رَبِّكَ",207],["54:12:3",529,"عُيُونًۭا","(with) springs","وَفَجَّرْنَا ٱلْأَرْضَ","فَٱلْتَقَى ٱلْمَآءُ عَلَىٰٓ",207],["54:14:2",529,"بِأَعْيُنِنَا","before Our eyes","تَجْرِى","جَزَآءًۭ لِّمَن كَانَ",207],["54:37:6",530,"أَعْيُنَهُمْ","their eyes","عَن ضَيْفِهِۦ فَطَمَسْنَآ","فَذُوقُوا۟ عَذَابِى وَنُذُرِ",207],["55:50:2",533,"عَيْنَانِ","(are) two springs","فِيهِمَا","تَجْرِيَانِ",207],["55:66:2",533,"عَيْنَانِ","(are) two springs","فِيهِمَا","نَضَّاخَتَانِ",207],["56:18:5",535,"مَّعِينٍۢ","a flowing stream","وَأَبَارِيقَ وَكَأْسٍۢ مِّن","",1596],["56:22:2",535,"عِينٌۭ","(with) large eyes","وَحُورٌ","",1505],["67:30:10",564,"مَّعِينٍۭ","flowing","فَمَن يَأْتِيكُم بِمَآءٍۢ","",1596],["76:6:1",579,"عَيْنًۭا","A spring","","يَشْرَبُ بِهَا عِبَادُ",207],["76:18:1",579,"عَيْنًۭا","A spring","","فِيهَا تُسَمَّىٰ سَلْسَبِيلًۭا",207],["77:41:5",581,"وَعُيُونٍۢ","and springs","ٱلْمُتَّقِينَ فِى ظِلَـٰلٍۢ","",207],["83:28:1",588,"عَيْنًۭا","A spring","","يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ",207],["88:5:3",592,"عَيْنٍ","a spring","تُسْقَىٰ مِنْ","ءَانِيَةٍۢ",207],["88:12:2",592,"عَيْنٌۭ","(will be) a spring","فِيهَا","جَارِيَةٌۭ",207],["90:8:4",594,"عَيْنَيْنِ","two eyes","أَلَمْ نَجْعَل لَّهُۥ","",207],["102:7:3",600,"عَيْنَ","(with the) eye","ثُمَّ لَتَرَوُنَّهَا","ٱلْيَقِينِ",207]]