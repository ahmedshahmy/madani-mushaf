[["3:14:8",51,"وَٱلْقَنَـٰطِيرِ","and [the] heaps","مِنَ ٱلنِّسَآءِ وَٱلْبَنِينَ","ٱلْمُقَنطَرَةِ مِنَ ٱلذَّهَبِ",1963],["3:14:9",51,"ٱلْمُقَنطَرَةِ","[the] stored up","ٱلنِّسَآءِ وَٱلْبَنِينَ وَٱلْقَنَـٰطِيرِ","مِنَ ٱلذَّهَبِ وَٱلْفِضَّةِ",3833],["3:75:7",59,"بِقِنطَارٍۢ","with a great amount of wealth","مَنْ إِن تَأْمَنْهُ","يُؤَدِّهِۦٓ إِلَيْكَ وَمِنْهُم",1963],["4:20:9",81,"قِنطَارًۭا","heap (of gold)","زَوْجٍۢ وَءَاتَيْتُمْ إِحْدَىٰهُنَّ","فَلَا تَأْخُذُوا۟ مِنْهُ",1963]]