[["4:36:13",84,"وَٱلْجَارِ","and the neighbor","ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ","ذِى ٱلْقُرْبَىٰ وَٱلْجَارِ",1854],["4:36:16",84,"وَٱلْجَارِ","and the neighbor","وَٱلْجَارِ ذِى ٱلْقُرْبَىٰ","ٱلْجُنُبِ وَٱلصَّاحِبِ بِٱلْجَنۢبِ",1854],["8:48:14",183,"جَارٌۭ","a neighbor","مِنَ ٱلنَّاسِ وَإِنِّى","لَّكُمْ ۖ فَلَمَّا تَرَآءَتِ",1854],["9:6:5",187,"ٱسْتَجَارَكَ","seek your protection","أَحَدٌۭ مِّنَ ٱلْمُشْرِكِينَ","فَأَجِرْهُ حَتَّىٰ يَسْمَعَ",4832],["9:6:6",187,"فَأَجِرْهُ","then grant him protection","مِّنَ ٱلْمُشْرِكِينَ ٱسْتَجَارَكَ","حَتَّىٰ يَسْمَعَ كَلَـٰمَ",1257],["13:4:4",249,"مُّتَجَـٰوِرَٰتٌۭ","neighboring","وَفِى ٱلْأَرْضِ قِطَعٌۭ","وَجَنَّـٰتٌۭ مِّنْ أَعْنَـٰبٍۢ",4000],["16:9:6",268,"جَآئِرٌۭ ۚ","(are) crooked","قَصْدُ ٱلسَّبِيلِ وَمِنْهَا","وَلَوْ شَآءَ لَهَدَىٰكُمْ",3507],["23:88:8",347,"يُجِيرُ","protects","كُلِّ شَىْءٍۢ وَهُوَ","وَلَا يُجَارُ عَلَيْهِ",1257],["23:88:10",347,"يُجَارُ","(can) be protected","وَهُوَ يُجِيرُ وَلَا","عَلَيْهِ إِن كُنتُمْ",1257],["33:60:16",426,"يُجَاوِرُونَكَ","they will remain your neighbors","بِهِمْ ثُمَّ لَا","فِيهَآ إِلَّا قَلِيلًۭا",4722],["46:31:11",506,"وَيُجِرْكُم","and will protect you","لَكُم مِّن ذُنُوبِكُمْ","مِّنْ عَذَابٍ أَلِيمٍۢ",1257],["67:28:11",564,"يُجِيرُ","(can) protect","أَوْ رَحِمَنَا فَمَن","ٱلْكَـٰفِرِينَ مِنْ عَذَابٍ",1257],["72:22:4",573,"يُجِيرَنِى","can protect me","قُلْ إِنِّى لَن","مِنَ ٱللَّهِ أَحَدٌۭ",1257]]