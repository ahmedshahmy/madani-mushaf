[["2:89:20",14,"عَرَفُوا۟","they recognized","فَلَمَّا جَآءَهُم مَّا","كَفَرُوا۟ بِهِۦ ۚ فَلَعْنَةُ",505],["2:146:4",23,"يَعْرِفُونَهُۥ","they recognize it","ٱلَّذِينَ ءَاتَيْنَـٰهُمُ ٱلْكِتَـٰبَ","كَمَا يَعْرِفُونَ أَبْنَآءَهُمْ ۖ",505],["2:146:6",23,"يَعْرِفُونَ","they recognize","ٱلْكِتَـٰبَ يَعْرِفُونَهُۥ كَمَا","أَبْنَآءَهُمْ ۖ وَإِنَّ فَرِيقًۭا",505],["2:178:22",27,"بِٱلْمَعْرُوفِ","with suitable","أَخِيهِ شَىْءٌۭ فَٱتِّبَاعٌۢ","وَأَدَآءٌ إِلَيْهِ بِإِحْسَـٰنٍۢ ۗ",309],["2:180:13",27,"بِٱلْمَعْرُوفِ ۖ","with due fairness","ٱلْوَصِيَّةُ لِلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَ","حَقًّا عَلَى ٱلْمُتَّقِينَ",309],["2:228:34",36,"بِٱلْمَعْرُوفِ ۚ","in a reasonable manner","مِثْلُ ٱلَّذِى عَلَيْهِنَّ","وَلِلرِّجَالِ عَلَيْهِنَّ دَرَجَةٌۭ ۗ",309],["2:229:4",36,"بِمَعْرُوفٍ","in a reasonable manner","ٱلطَّلَـٰقُ مَرَّتَانِ ۖ فَإِمْسَاكٌۢ","أَوْ تَسْرِيحٌۢ بِإِحْسَـٰنٍۢ ۗ",309],["2:231:7",37,"بِمَعْرُوفٍ","in a fair manner","فَبَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ","أَوْ سَرِّحُوهُنَّ بِمَعْرُوفٍۢ ۚ",309],["2:231:10",37,"بِمَعْرُوفٍۢ ۚ","in a fair manner","بِمَعْرُوفٍ أَوْ سَرِّحُوهُنَّ","وَلَا تُمْسِكُوهُنَّ ضِرَارًۭا",309],["2:232:14",37,"بِٱلْمَعْرُوفِ ۗ","in a fair manner","إِذَا تَرَٰضَوْا۟ بَيْنَهُم","ذَٰلِكَ يُوعَظُ بِهِۦ",309],["2:233:16",37,"بِٱلْمَعْرُوفِ ۚ","in a fair manner","لَهُۥ رِزْقُهُنَّ وَكِسْوَتُهُنَّ","لَا تُكَلَّفُ نَفْسٌ",309],["2:233:56",37,"بِٱلْمَعْرُوفِ ۗ","in a fair manner","سَلَّمْتُم مَّآ ءَاتَيْتُم","وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟",309],["2:234:21",38,"بِٱلْمَعْرُوفِ ۗ","in a fair manner","فَعَلْنَ فِىٓ أَنفُسِهِنَّ","وَٱللَّهُ بِمَا تَعْمَلُونَ",309],["2:235:26",38,"مَّعْرُوفًۭا ۚ","honorable","أَن تَقُولُوا۟ قَوْلًۭا","وَلَا تَعْزِمُوا۟ عُقْدَةَ",309],["2:236:22",38,"بِٱلْمَعْرُوفِ ۖ","in a fair manner","ٱلْمُقْتِرِ قَدَرُهُۥ مَتَـٰعًۢا","حَقًّا عَلَى ٱلْمُحْسِنِينَ",309],["2:240:24",39,"مَّعْرُوفٍۢ ۗ","honorably","فِىٓ أَنفُسِهِنَّ مِن","وَٱللَّهُ عَزِيزٌ حَكِيمٌۭ",309],["2:241:3",39,"بِٱلْمَعْرُوفِ ۖ","in a fair manner","وَلِلْمُطَلَّقَـٰتِ مَتَـٰعٌۢ","حَقًّا عَلَى ٱلْمُتَّقِينَ",309],["2:263:2",44,"مَّعْرُوفٌۭ","kind","۞ قَوْلٌۭ","وَمَغْفِرَةٌ خَيْرٌۭ مِّن",309],["2:273:17",46,"تَعْرِفُهُم","you recognize them","أَغْنِيَآءَ مِنَ ٱلتَّعَفُّفِ","بِسِيمَـٰهُمْ لَا يَسْـَٔلُونَ",505],["3:104:8",63,"بِٱلْمَعْرُوفِ","the right","إِلَى ٱلْخَيْرِ وَيَأْمُرُونَ","وَيَنْهَوْنَ عَنِ ٱلْمُنكَرِ ۚ",309],["3:110:7",64,"بِٱلْمَعْرُوفِ","the right","أُخْرِجَتْ لِلنَّاسِ تَأْمُرُونَ","وَتَنْهَوْنَ عَنِ ٱلْمُنكَرِ",309],["3:114:6",64,"بِٱلْمَعْرُوفِ","[with] the right","وَٱلْيَوْمِ ٱلْـَٔاخِرِ وَيَأْمُرُونَ","وَيَنْهَوْنَ عَنِ ٱلْمُنكَرِ",309],["4:5:16",77,"مَّعْرُوفًۭا","(of) kindness","وَقُولُوا۟ لَهُمْ قَوْلًۭا","",309],["4:6:28",77,"بِٱلْمَعْرُوفِ ۚ","in a fair manner","كَانَ فَقِيرًۭا فَلْيَأْكُلْ","فَإِذَا دَفَعْتُمْ إِلَيْهِمْ",309],["4:8:13",78,"مَّعْرُوفًۭا","(of) kindness","وَقُولُوا۟ لَهُمْ قَوْلًۭا","",309],["4:19:23",80,"بِٱلْمَعْرُوفِ ۚ","in kindness","بِفَـٰحِشَةٍۢ مُّبَيِّنَةٍۢ ۚ وَعَاشِرُوهُنَّ","فَإِن كَرِهْتُمُوهُنَّ فَعَسَىٰٓ",309],["4:25:28",82,"بِٱلْمَعْرُوفِ","in a fair manner","أَهْلِهِنَّ وَءَاتُوهُنَّ أُجُورَهُنَّ","مُحْصَنَـٰتٍ غَيْرَ مُسَـٰفِحَـٰتٍۢ",309],["4:114:12",97,"مَعْرُوفٍ","kindness","أَمَرَ بِصَدَقَةٍ أَوْ","أَوْ إِصْلَـٰحٍۭ بَيْنَ",309],["5:83:13",121,"عَرَفُوا۟","they recognized","مِنَ ٱلدَّمْعِ مِمَّا","مِنَ ٱلْحَقِّ ۖ يَقُولُونَ",505],["6:20:4",130,"يَعْرِفُونَهُۥ","they recognize him","ٱلَّذِينَ ءَاتَيْنَـٰهُمُ ٱلْكِتَـٰبَ","كَمَا يَعْرِفُونَ أَبْنَآءَهُمُ ۘ",505],["6:20:6",130,"يَعْرِفُونَ","they recognize","ٱلْكِتَـٰبَ يَعْرِفُونَهُۥ كَمَا","أَبْنَآءَهُمُ ۘ ٱلَّذِينَ خَسِرُوٓا۟",505],["7:46:4",156,"ٱلْأَعْرَافِ","the heights","وَبَيْنَهُمَا حِجَابٌۭ ۚ وَعَلَى","رِجَالٌۭ يَعْرِفُونَ كُلًّۢا",2157],["7:46:6",156,"يَعْرِفُونَ","recognizing","وَعَلَى ٱلْأَعْرَافِ رِجَالٌۭ","كُلًّۢا بِسِيمَىٰهُمْ ۚ وَنَادَوْا۟",505],["7:48:3",156,"ٱلْأَعْرَافِ","(of) the heights","وَنَادَىٰٓ أَصْحَـٰبُ","رِجَالًۭا يَعْرِفُونَهُم بِسِيمَىٰهُمْ",2157],["7:48:5",156,"يَعْرِفُونَهُم","whom they recognize","أَصْحَـٰبُ ٱلْأَعْرَافِ رِجَالًۭا","بِسِيمَىٰهُمْ قَالُوا۟ مَآ",505],["7:157:14",170,"بِٱلْمَعْرُوفِ","to the right","ٱلتَّوْرَىٰةِ وَٱلْإِنجِيلِ يَأْمُرُهُم","وَيَنْهَىٰهُمْ عَنِ ٱلْمُنكَرِ",309],["7:199:4",176,"بِٱلْعُرْفِ","the good","خُذِ ٱلْعَفْوَ وَأْمُرْ","وَأَعْرِضْ عَنِ ٱلْجَـٰهِلِينَ",2259],["9:67:10",197,"ٱلْمَعْرُوفِ","(is) the right","بِٱلْمُنكَرِ وَيَنْهَوْنَ عَنِ","وَيَقْبِضُونَ أَيْدِيَهُمْ ۚ نَسُوا۟",309],["9:71:7",198,"بِٱلْمَعْرُوفِ","the right","أَوْلِيَآءُ بَعْضٍۢ ۚ يَأْمُرُونَ","وَيَنْهَوْنَ عَنِ ٱلْمُنكَرِ",309],["9:102:2",203,"ٱعْتَرَفُوا۟","(who have) acknowledged","وَءَاخَرُونَ","بِذُنُوبِهِمْ خَلَطُوا۟ عَمَلًۭا",2097],["9:112:8",205,"بِٱلْمَعْرُوفِ","the right","ٱلرَّٰكِعُونَ ٱلسَّـٰجِدُونَ ٱلْـَٔامِرُونَ","وَٱلنَّاهُونَ عَنِ ٱلْمُنكَرِ",309],["10:45:10",214,"يَتَعَارَفُونَ","they will recognize each other","سَاعَةًۭ مِّنَ ٱلنَّهَارِ","بَيْنَهُمْ ۚ قَدْ خَسِرَ",2781],["12:58:6",242,"فَعَرَفَهُمْ","and he recognized them","يُوسُفَ فَدَخَلُوا۟ عَلَيْهِ","وَهُمْ لَهُۥ مُنكِرُونَ",505],["12:62:8",242,"يَعْرِفُونَهَآ","may recognize it","فِى رِحَالِهِمْ لَعَلَّهُمْ","إِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ",505],["16:83:1",276,"يَعْرِفُونَ","They recognize","","نِعْمَتَ ٱللَّهِ ثُمَّ",505],["22:41:11",337,"بِٱلْمَعْرُوفِ","the right","وَءَاتَوُا۟ ٱلزَّكَوٰةَ وَأَمَرُوا۟","وَنَهَوْا۟ عَنِ ٱلْمُنكَرِ ۗ",309],["22:72:6",340,"تَعْرِفُ","you will recognize","عَلَيْهِمْ ءَايَـٰتُنَا بَيِّنَـٰتٍۢ","فِى وُجُوهِ ٱلَّذِينَ",505],["23:69:3",346,"يَعْرِفُوا۟","they recognize","أَمْ لَمْ","رَسُولَهُمْ فَهُمْ لَهُۥ",505],["24:53:12",356,"مَّعْرُوفَةٌ ۚ","(is) known","لَّا تُقْسِمُوا۟ ۖ طَاعَةٌۭ","إِنَّ ٱللَّهَ خَبِيرٌۢ",3910],["27:93:6",385,"فَتَعْرِفُونَهَا ۚ","and you will recognize them","لِلَّهِ سَيُرِيكُمْ ءَايَـٰتِهِۦ","وَمَا رَبُّكَ بِغَـٰفِلٍ",505],["31:15:17",412,"مَعْرُوفًۭا ۖ","(with) kindness","وَصَاحِبْهُمَا فِى ٱلدُّنْيَا","وَٱتَّبِعْ سَبِيلَ مَنْ",309],["31:17:5",412,"بِٱلْمَعْرُوفِ","[with] the right","أَقِمِ ٱلصَّلَوٰةَ وَأْمُرْ","وَٱنْهَ عَنِ ٱلْمُنكَرِ",309],["33:6:24",418,"مَّعْرُوفًۭا ۚ","a kindness","تَفْعَلُوٓا۟ إِلَىٰٓ أَوْلِيَآئِكُم","كَانَ ذَٰلِكَ فِى",309],["33:32:19",422,"مَّعْرُوفًۭا","appropriate","مَرَضٌۭ وَقُلْنَ قَوْلًۭا","",309],["33:59:15",426,"يُعْرَفْنَ","they should be known","ذَٰلِكَ أَدْنَىٰٓ أَن","فَلَا يُؤْذَيْنَ ۗ وَكَانَ",505],["40:11:7",468,"فَٱعْتَرَفْنَا","and we confess","ٱثْنَتَيْنِ وَأَحْيَيْتَنَا ٱثْنَتَيْنِ","بِذُنُوبِنَا فَهَلْ إِلَىٰ",2097],["47:6:3",507,"عَرَّفَهَا","He has made it known","وَيُدْخِلُهُمُ ٱلْجَنَّةَ","لَهُمْ",2244],["47:21:3",509,"مَّعْرُوفٌۭ ۚ","kind","طَاعَةٌۭ وَقَوْلٌۭ","فَإِذَا عَزَمَ ٱلْأَمْرُ",309],["47:30:4",510,"فَلَعَرَفْتَهُم","and you would know them","وَلَوْ نَشَآءُ لَأَرَيْنَـٰكَهُمْ","بِسِيمَـٰهُمْ ۚ وَلَتَعْرِفَنَّهُمْ فِى",505],["47:30:6",510,"وَلَتَعْرِفَنَّهُمْ","but surely, you will know them","لَأَرَيْنَـٰكَهُمْ فَلَعَرَفْتَهُم بِسِيمَـٰهُمْ ۚ","فِى لَحْنِ ٱلْقَوْلِ ۚ",505],["49:13:11",517,"لِتَعَارَفُوٓا۟ ۚ","that you may know one another","وَجَعَلْنَـٰكُمْ شُعُوبًۭا وَقَبَآئِلَ","إِنَّ أَكْرَمَكُمْ عِندَ",2781],["55:41:1",532,"يُعْرَفُ","Will be known","","ٱلْمُجْرِمُونَ بِسِيمَـٰهُمْ فَيُؤْخَذُ",505],["60:12:30",551,"مَعْرُوفٍۢ ۙ","(the) right","وَلَا يَعْصِينَكَ فِى","فَبَايِعْهُنَّ وَٱسْتَغْفِرْ لَهُنَّ",309],["65:2:5",558,"بِمَعْرُوفٍ","with kindness","بَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ","أَوْ فَارِقُوهُنَّ بِمَعْرُوفٍۢ",309],["65:2:8",558,"بِمَعْرُوفٍۢ","with kindness","بِمَعْرُوفٍ أَوْ فَارِقُوهُنَّ","وَأَشْهِدُوا۟ ذَوَىْ عَدْلٍۢ",309],["65:6:27",559,"بِمَعْرُوفٍۢ ۖ","with kindness","أُجُورَهُنَّ ۖ وَأْتَمِرُوا۟ بَيْنَكُم","وَإِن تَعَاسَرْتُمْ فَسَتُرْضِعُ",309],["66:3:14",560,"عَرَّفَ","he made known","وَأَظْهَرَهُ ٱللَّهُ عَلَيْهِ","بَعْضَهُۥ وَأَعْرَضَ عَنۢ",2244],["67:11:1",562,"فَٱعْتَرَفُوا۟","Then they (will) confess","","بِذَنۢبِهِمْ فَسُحْقًۭا لِّأَصْحَـٰبِ",2097],["77:1:2",580,"عُرْفًۭا","one after another","وَٱلْمُرْسَلَـٰتِ","",2259],["83:24:1",588,"تَعْرِفُ","You will recognize","","فِى وُجُوهِهِمْ نَضْرَةَ",505]]