[["3:184:10",74,"وَٱلزُّبُرِ","and the Scriptures","قَبْلِكَ جَآءُو بِٱلْبَيِّنَـٰتِ","وَٱلْكِتَـٰبِ ٱلْمُنِيرِ",1120],["4:163:25",104,"زَبُورًۭا","the Zaboor","وَسُلَيْمَـٰنَ ۚ وَءَاتَيْنَا دَاوُۥدَ","",2092],["16:44:2",272,"وَٱلزُّبُرِ ۗ","and the Books","بِٱلْبَيِّنَـٰتِ","وَأَنزَلْنَآ إِلَيْكَ ٱلذِّكْرَ",1120],["17:55:15",287,"زَبُورًۭا","Zaboor","بَعْضٍۢ ۖ وَءَاتَيْنَا دَاوُۥدَ","",2092],["18:96:2",303,"زُبَرَ","sheets","ءَاتُونِى","ٱلْحَدِيدِ ۖ حَتَّىٰٓ إِذَا",4768],["21:105:4",331,"ٱلزَّبُورِ","the Scripture","وَلَقَدْ كَتَبْنَا فِى","مِنۢ بَعْدِ ٱلذِّكْرِ",2092],["23:53:4",345,"زُبُرًۭا ۖ","(into) sects","فَتَقَطَّعُوٓا۟ أَمْرَهُم بَيْنَهُمْ","كُلُّ حِزْبٍۭ بِمَا",1120],["26:196:3",375,"زُبُرِ","(the) Scriptures","وَإِنَّهُۥ لَفِى","ٱلْأَوَّلِينَ",1120],["35:25:11",437,"وَبِٱلزُّبُرِ","and with Scriptures","جَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَـٰتِ","وَبِٱلْكِتَـٰبِ ٱلْمُنِيرِ",1120],["54:43:9",530,"ٱلزُّبُرِ","the Scriptures","لَكُم بَرَآءَةٌۭ فِى","",1120],["54:52:5",531,"ٱلزُّبُرِ","the written records","شَىْءٍۢ فَعَلُوهُ فِى","",1120]]