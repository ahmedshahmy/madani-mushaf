[["2:235:8",38,"خِطْبَةِ","marriage proposal","عَرَّضْتُم بِهِۦ مِنْ","ٱلنِّسَآءِ أَوْ أَكْنَنتُمْ",4582],["11:37:6",225,"تُخَـٰطِبْنِى","address Me","بِأَعْيُنِنَا وَوَحْيِنَا وَلَا","فِى ٱلَّذِينَ ظَلَمُوٓا۟ ۚ",2032],["12:51:3",241,"خَطْبُكُنَّ","(was) your affair","قَالَ مَا","إِذْ رَٰوَدتُّنَّ يُوسُفَ",1417],["15:57:3",265,"خَطْبُكُمْ","(is) your business","قَالَ فَمَا","أَيُّهَا ٱلْمُرْسَلُونَ",1417],["20:95:3",318,"خَطْبُكَ","(is) your case","قَالَ فَمَا","يَـٰسَـٰمِرِىُّ",1417],["23:27:27",343,"تُخَـٰطِبْنِى","address Me","ٱلْقَوْلُ مِنْهُمْ ۖ وَلَا","فِى ٱلَّذِينَ ظَلَمُوٓا۟ ۖ",2032],["25:63:9",365,"خَاطَبَهُمُ","address them","ٱلْأَرْضِ هَوْنًۭا وَإِذَا","ٱلْجَـٰهِلُونَ قَالُوا۟ سَلَـٰمًۭا",2032],["28:23:18",388,"خَطْبُكُمَا ۖ","(is the) matter with both of you","تَذُودَانِ ۖ قَالَ مَا","قَالَتَا لَا نَسْقِى",1417],["38:20:6",454,"ٱلْخِطَابِ","speech","وَءَاتَيْنَـٰهُ ٱلْحِكْمَةَ وَفَصْلَ","",2044],["38:23:15",454,"ٱلْخِطَابِ","[the] speech","أَكْفِلْنِيهَا وَعَزَّنِى فِى","",2044],["51:31:3",522,"خَطْبُكُمْ","(is) your mission","۞ قَالَ فَمَا","أَيُّهَا ٱلْمُرْسَلُونَ",1417],["78:37:10",583,"خِطَابًۭا","(to) address","لَا يَمْلِكُونَ مِنْهُ","",2044]]