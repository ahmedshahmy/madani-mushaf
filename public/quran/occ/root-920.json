[["6:59:16",134,"وَرَقَةٍ","any leaf","وَمَا تَسْقُطُ مِن","إِلَّا يَعْلَمُهَا وَلَا",4533],["7:22:13",152,"وَرَقِ","(the) leaves","يَخْصِفَانِ عَلَيْهِمَا مِن","ٱلْجَنَّةِ ۖ وَنَادَىٰهُمَا رَبُّهُمَآ",2715],["18:19:23",295,"بِوَرِقِكُمْ","with this silver coin of yours","لَبِثْتُمْ فَٱبْعَثُوٓا۟ أَحَدَكُم","هَـٰذِهِۦٓ إِلَى ٱلْمَدِينَةِ",4534],["20:121:10",320,"وَرَقِ","(the) leaves","يَخْصِفَانِ عَلَيْهِمَا مِن","ٱلْجَنَّةِ ۚ وَعَصَىٰٓ ءَادَمُ",2715]]