[["2:117:5",18,"قَضَىٰٓ","He decrees","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ وَإِذَا","أَمْرًۭا فَإِنَّمَا يَقُولُ",204],["2:200:2",31,"قَضَيْتُم","you complete[d]","فَإِذَا","مَّنَـٰسِكَكُمْ فَٱذْكُرُوا۟ ٱللَّهَ",204],["2:210:12",32,"وَقُضِىَ","and is decreed","مِّنَ ٱلْغَمَامِ وَٱلْمَلَـٰٓئِكَةُ","ٱلْأَمْرُ ۚ وَإِلَى ٱللَّهِ",204],["3:47:17",56,"قَضَىٰٓ","He decrees","مَا يَشَآءُ ۚ إِذَا","أَمْرًۭا فَإِنَّمَا يَقُولُ",204],["4:65:17",88,"قَضَيْتَ","you (have) decided","أَنفُسِهِمْ حَرَجًۭا مِّمَّا","وَيُسَلِّمُوا۟ تَسْلِيمًۭا",204],["4:103:2",95,"قَضَيْتُمُ","you (have) finished","فَإِذَا","ٱلصَّلَوٰةَ فَٱذْكُرُوا۟ ٱللَّهَ",204],["6:2:7",128,"قَضَىٰٓ","He decreed","مِّن طِينٍۢ ثُمَّ","أَجَلًۭا ۖ وَأَجَلٌۭ مُّسَمًّى",204],["6:8:9",128,"لَّقُضِىَ","surely (would) have been decided","وَلَوْ أَنزَلْنَا مَلَكًۭا","ٱلْأَمْرُ ثُمَّ لَا",204],["6:58:8",134,"لَقُضِىَ","surely would have been decided","مَا تَسْتَعْجِلُونَ بِهِۦ","ٱلْأَمْرُ بَيْنِى وَبَيْنَكُمْ ۗ",204],["6:60:12",135,"لِيُقْضَىٰٓ","so that is fulfilled","ثُمَّ يَبْعَثُكُمْ فِيهِ","أَجَلٌۭ مُّسَمًّۭى ۖ ثُمَّ",204],["8:42:17",182,"لِّيَقْضِىَ","that might accomplish","فِى ٱلْمِيعَـٰدِ ۙ وَلَـٰكِن","ٱللَّهُ أَمْرًۭا كَانَ",204],["8:44:11",182,"لِيَقْضِىَ","that might accomplish","وَيُقَلِّلُكُمْ فِىٓ أَعْيُنِهِمْ","ٱللَّهُ أَمْرًۭا كَانَ",204],["10:11:8",209,"لَقُضِىَ","surely, would have been decreed","ٱلشَّرَّ ٱسْتِعْجَالَهُم بِٱلْخَيْرِ","إِلَيْهِمْ أَجَلُهُمْ ۖ فَنَذَرُ",204],["10:19:13",210,"لَقُضِىَ","surely, it (would) have been judged","سَبَقَتْ مِن رَّبِّكَ","بَيْنَهُمْ فِيمَا فِيهِ",204],["10:47:7",214,"قُضِىَ","it will be judged","فَإِذَا جَآءَ رَسُولُهُمْ","بَيْنَهُم بِٱلْقِسْطِ وَهُمْ",204],["10:54:16",215,"وَقُضِىَ","But will be judged","لَمَّا رَأَوُا۟ ٱلْعَذَابَ ۖ","بَيْنَهُم بِٱلْقِسْطِ ۚ وَهُمْ",204],["10:71:30",217,"ٱقْضُوٓا۟","carry (it out)","عَلَيْكُمْ غُمَّةًۭ ثُمَّ","إِلَىَّ وَلَا تُنظِرُونِ",204],["10:93:17",219,"يَقْضِى","will judge","ٱلْعِلْمُ ۚ إِنَّ رَبَّكَ","بَيْنَهُمْ يَوْمَ ٱلْقِيَـٰمَةِ",204],["11:44:9",226,"وَقُضِىَ","and was fulfilled","أَقْلِعِى وَغِيضَ ٱلْمَآءُ","ٱلْأَمْرُ وَٱسْتَوَتْ عَلَى",204],["11:110:12",234,"لَقُضِىَ","surely would have been judged","سَبَقَتْ مِن رَّبِّكَ","بَيْنَهُمْ ۚ وَإِنَّهُمْ لَفِى",204],["12:41:15",240,"قُضِىَ","Has been decreed","ٱلطَّيْرُ مِن رَّأْسِهِۦ ۚ","ٱلْأَمْرُ ٱلَّذِى فِيهِ",204],["12:68:20",243,"قَضَىٰهَا ۚ","which he carried out","فِى نَفْسِ يَعْقُوبَ","وَإِنَّهُۥ لَذُو عِلْمٍۢ",204],["14:22:4",258,"قُضِىَ","has been decided","وَقَالَ ٱلشَّيْطَـٰنُ لَمَّا","ٱلْأَمْرُ إِنَّ ٱللَّهَ",204],["15:66:1",265,"وَقَضَيْنَآ","And We conveyed","","إِلَيْهِ ذَٰلِكَ ٱلْأَمْرَ",204],["17:4:1",282,"وَقَضَيْنَآ","And We decreed","","إِلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ",204],["17:23:1",284,"۞ وَقَضَىٰ","And has decreed","","رَبُّكَ أَلَّا تَعْبُدُوٓا۟",204],["19:21:15",306,"مَّقْضِيًّۭا","decreed.'","مِّنَّا ۚ وَكَانَ أَمْرًۭا","",2528],["19:35:10",307,"قَضَىٰٓ","He decrees","وَلَدٍۢ ۖ سُبْحَـٰنَهُۥٓ ۚ إِذَا","أَمْرًۭا فَإِنَّمَا يَقُولُ",204],["19:39:5",308,"قُضِىَ","has been decided","يَوْمَ ٱلْحَسْرَةِ إِذْ","ٱلْأَمْرُ وَهُمْ فِى",204],["19:71:9",310,"مَّقْضِيًّۭا","decreed","عَلَىٰ رَبِّكَ حَتْمًۭا","",2528],["20:72:11",316,"فَٱقْضِ","So decree","ٱلْبَيِّنَـٰتِ وَٱلَّذِى فَطَرَنَا ۖ","مَآ أَنتَ قَاضٍ ۖ",204],["20:72:14",316,"قَاضٍ ۖ","(are) decreeing","فَٱقْضِ مَآ أَنتَ","إِنَّمَا تَقْضِى هَـٰذِهِ",4099],["20:72:16",316,"تَقْضِى","you can decree","أَنتَ قَاضٍ ۖ إِنَّمَا","هَـٰذِهِ ٱلْحَيَوٰةَ ٱلدُّنْيَآ",204],["20:114:11",320,"يُقْضَىٰٓ","is completed","مِن قَبْلِ أَن","إِلَيْكَ وَحْيُهُۥ ۖ وَقُل",204],["22:29:2",335,"لْيَقْضُوا۟","let them end","ثُمَّ","تَفَثَهُمْ وَلْيُوفُوا۟ نُذُورَهُمْ",204],["27:78:3",384,"يَقْضِى","will judge","إِنَّ رَبَّكَ","بَيْنَهُم بِحُكْمِهِۦ ۚ وَهُوَ",204],["28:15:28",387,"فَقَضَىٰ","and killed him","عَدُوِّهِۦ فَوَكَزَهُۥ مُوسَىٰ","عَلَيْهِ ۖ قَالَ هَـٰذَا",204],["28:28:7",388,"قَضَيْتُ","I complete","وَبَيْنَكَ ۖ أَيَّمَا ٱلْأَجَلَيْنِ","فَلَا عُدْوَٰنَ عَلَىَّ ۖ",204],["28:29:2",389,"قَضَىٰ","Musa fulfilled","۞ فَلَمَّا","مُوسَى ٱلْأَجَلَ وَسَارَ",204],["28:44:6",391,"قَضَيْنَآ","We decreed","بِجَانِبِ ٱلْغَرْبِىِّ إِذْ","إِلَىٰ مُوسَى ٱلْأَمْرَ",204],["33:23:11",421,"قَضَىٰ","has fulfilled","عَلَيْهِ ۖ فَمِنْهُم مَّن","نَحْبَهُۥ وَمِنْهُم مَّن",204],["33:36:7",423,"قَضَى","Allah has decided","وَلَا مُؤْمِنَةٍ إِذَا","ٱللَّهُ وَرَسُولُهُۥٓ أَمْرًا",204],["33:37:27",423,"قَضَىٰ","ended","أَن تَخْشَىٰهُ ۖ فَلَمَّا","زَيْدٌۭ مِّنْهَا وَطَرًۭا",204],["33:37:42",423,"قَضَوْا۟","they have ended","أَزْوَٰجِ أَدْعِيَآئِهِمْ إِذَا","مِنْهُنَّ وَطَرًۭا ۚ وَكَانَ",204],["34:14:2",429,"قَضَيْنَا","We decreed","فَلَمَّا","عَلَيْهِ ٱلْمَوْتَ مَا",204],["35:36:7",438,"يُقْضَىٰ","is decreed","نَارُ جَهَنَّمَ لَا","عَلَيْهِمْ فَيَمُوتُوا۟ وَلَا",204],["39:42:13",463,"قَضَىٰ","He has decreed","مَنَامِهَا ۖ فَيُمْسِكُ ٱلَّتِى","عَلَيْهَا ٱلْمَوْتَ وَيُرْسِلُ",204],["39:69:10",466,"وَقُضِىَ","and it (will) be judged","وَجِا۟ىٓءَ بِٱلنَّبِيِّـۧنَ وَٱلشُّهَدَآءِ","بَيْنَهُم بِٱلْحَقِّ وَهُمْ",204],["39:75:10",467,"وَقُضِىَ","And (will) be judged","يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ ۖ","بَيْنَهُم بِٱلْحَقِّ وَقِيلَ",204],["40:20:2",469,"يَقْضِى","judges","وَٱللَّهُ","بِٱلْحَقِّ ۖ وَٱلَّذِينَ يَدْعُونَ",204],["40:20:9",469,"يَقْضُونَ","they judge","مِن دُونِهِۦ لَا","بِشَىْءٍ ۗ إِنَّ ٱللَّهَ",204],["40:68:6",475,"قَضَىٰٓ","He decrees","يُحْىِۦ وَيُمِيتُ ۖ فَإِذَا","أَمْرًۭا فَإِنَّمَا يَقُولُ",204],["40:78:28",476,"قُضِىَ","it will be decided","جَآءَ أَمْرُ ٱللَّهِ","بِٱلْحَقِّ وَخَسِرَ هُنَالِكَ",204],["41:12:1",478,"فَقَضَىٰهُنَّ","Then He completed them","","سَبْعَ سَمَـٰوَاتٍۢ فِى",204],["41:45:12",481,"لَقُضِىَ","surely, would have been settled","سَبَقَتْ مِن رَّبِّكَ","بَيْنَهُمْ ۚ وَإِنَّهُمْ لَفِى",204],["42:14:19",484,"لَّقُضِىَ","surely, it (would have) been settled","إِلَىٰٓ أَجَلٍۢ مُّسَمًّۭى","بَيْنَهُمْ ۚ وَإِنَّ ٱلَّذِينَ",204],["42:21:16",485,"لَقُضِىَ","surely, it (would have) been judged","وَلَوْلَا كَلِمَةُ ٱلْفَصْلِ","بَيْنَهُمْ ۗ وَإِنَّ ٱلظَّـٰلِمِينَ",204],["43:77:3",495,"لِيَقْضِ","Let put an end","وَنَادَوْا۟ يَـٰمَـٰلِكُ","عَلَيْنَا رَبُّكَ ۖ قَالَ",204],["45:17:17",500,"يَقْضِى","will judge","بَيْنَهُمْ ۚ إِنَّ رَبَّكَ","بَيْنَهُمْ يَوْمَ ٱلْقِيَـٰمَةِ",204],["46:29:14",506,"قُضِىَ","it was concluded","قَالُوٓا۟ أَنصِتُوا۟ ۖ فَلَمَّا","وَلَّوْا۟ إِلَىٰ قَوْمِهِم",204],["62:10:2",554,"قُضِيَتِ","is concluded","فَإِذَا","ٱلصَّلَوٰةُ فَٱنتَشِرُوا۟ فِى",204],["69:27:3",567,"ٱلْقَاضِيَةَ","the end","يَـٰلَيْتَهَا كَانَتِ","",4100],["80:23:3",585,"يَقْضِ","he has accomplished","كَلَّا لَمَّا","مَآ أَمَرَهُۥ",204]]