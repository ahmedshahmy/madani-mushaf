[["2:67:10",10,"بَقَرَةًۭ ۖ","a cow","يَأْمُرُكُمْ أَن تَذْبَحُوا۟","قَالُوٓا۟ أَتَتَّخِذُنَا هُزُوًۭا ۖ",1537],["2:68:13",10,"بَقَرَةٌۭ","(is) a cow","إِنَّهُۥ يَقُولُ إِنَّهَا","لَّا فَارِضٌۭ وَلَا",1537],["2:69:13",10,"بَقَرَةٌۭ","a cow","إِنَّهُۥ يَقُولُ إِنَّهَا","صَفْرَآءُ فَاقِعٌۭ لَّوْنُهَا",1537],["2:70:10",11,"ٱلْبَقَرَ","[the] cows","مَا هِىَ إِنَّ","تَشَـٰبَهَ عَلَيْنَا وَإِنَّآ",1810],["2:71:5",11,"بَقَرَةٌۭ","(is) a cow","إِنَّهُۥ يَقُولُ إِنَّهَا","لَّا ذَلُولٌۭ تُثِيرُ",1537],["6:144:5",147,"ٱلْبَقَرِ","the cows","ٱلْإِبِلِ ٱثْنَيْنِ وَمِنَ","ٱثْنَيْنِ ۗ قُلْ ءَآلذَّكَرَيْنِ",1810],["6:146:9",147,"ٱلْبَقَرِ","the cows","ذِى ظُفُرٍۢ ۖ وَمِنَ","وَٱلْغَنَمِ حَرَّمْنَا عَلَيْهِمْ",1810],["12:43:6",240,"بَقَرَٰتٍۢ","cows","إِنِّىٓ أَرَىٰ سَبْعَ","سِمَانٍۢ يَأْكُلُهُنَّ سَبْعٌ",2335],["12:46:7",241,"بَقَرَٰتٍۢ","cows","أَفْتِنَا فِى سَبْعِ","سِمَانٍۢ يَأْكُلُهُنَّ سَبْعٌ",2335]]