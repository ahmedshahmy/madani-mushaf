[["3:14:12",51,"وَٱلْفِضَّةِ","and [the] silver","ٱلْمُقَنطَرَةِ مِنَ ٱلذَّهَبِ","وَٱلْخَيْلِ ٱلْمُسَوَّمَةِ وَٱلْأَنْعَـٰمِ",1179],["3:159:12",71,"لَٱنفَضُّوا۟","surely they (would have) dispersed","فَظًّا غَلِيظَ ٱلْقَلْبِ","مِنْ حَوْلِكَ ۖ فَٱعْفُ",2104],["9:34:20",192,"وَٱلْفِضَّةَ","and the silver","وَٱلَّذِينَ يَكْنِزُونَ ٱلذَّهَبَ","وَلَا يُنفِقُونَهَا فِى",1179],["43:33:14",491,"فِضَّةٍۢ","silver","لِبُيُوتِهِمْ سُقُفًۭا مِّن","وَمَعَارِجَ عَلَيْهَا يَظْهَرُونَ",1179],["62:11:6",554,"ٱنفَضُّوٓا۟","they rushed","تِجَـٰرَةً أَوْ لَهْوًا","إِلَيْهَا وَتَرَكُوكَ قَآئِمًۭا ۚ",2104],["63:7:12",555,"يَنفَضُّوا۟ ۗ","they disband","رَسُولِ ٱللَّهِ حَتَّىٰ","وَلِلَّهِ خَزَآئِنُ ٱلسَّمَـٰوَٰتِ",2104],["76:15:5",579,"فِضَّةٍۢ","silver","عَلَيْهِم بِـَٔانِيَةٍۢ مِّن","وَأَكْوَابٍۢ كَانَتْ قَوَارِيرَا۠",1179],["76:16:3",579,"فِضَّةٍۢ","silver","قَوَارِيرَا۟ مِن","قَدَّرُوهَا تَقْدِيرًۭا",1179],["76:21:9",579,"فِضَّةٍۢ","silver","وَحُلُّوٓا۟ أَسَاوِرَ مِن","وَسَقَىٰهُمْ رَبُّهُمْ شَرَابًۭا",1179]]