[["2:249:4",41,"بِٱلْجُنُودِ","with the forces","فَلَمَّا فَصَلَ طَالُوتُ","قَالَ إِنَّ ٱللَّهَ",374],["2:249:42",41,"وَجُنُودِهِۦ ۚ","and his troops","لَنَا ٱلْيَوْمَ بِجَالُوتَ","قَالَ ٱلَّذِينَ يَظُنُّونَ",374],["2:250:4",41,"وَجُنُودِهِۦ","and his troops","وَلَمَّا بَرَزُوا۟ لِجَالُوتَ","قَالُوا۟ رَبَّنَآ أَفْرِغْ",374],["9:26:10",190,"جُنُودًۭا","forces","وَعَلَى ٱلْمُؤْمِنِينَ وَأَنزَلَ","لَّمْ تَرَوْهَا وَعَذَّبَ",374],["9:40:29",193,"بِجُنُودٍۢ","with forces","سَكِينَتَهُۥ عَلَيْهِ وَأَيَّدَهُۥ","لَّمْ تَرَوْهَا وَجَعَلَ",374],["10:90:7",219,"وَجُنُودُهُۥ","and his hosts","ٱلْبَحْرَ فَأَتْبَعَهُمْ فِرْعَوْنُ","بَغْيًۭا وَعَدْوًا ۖ حَتَّىٰٓ",374],["19:75:25",310,"جُندًۭا","(in) forces","شَرٌّۭ مَّكَانًۭا وَأَضْعَفُ","",374],["20:78:3",317,"بِجُنُودِهِۦ","with his forces","فَأَتْبَعَهُمْ فِرْعَوْنُ","فَغَشِيَهُم مِّنَ ٱلْيَمِّ",374],["26:95:1",371,"وَجُنُودُ","And (the) hosts","","إِبْلِيسَ أَجْمَعُونَ",374],["27:17:3",378,"جُنُودُهُۥ","his hosts","وَحُشِرَ لِسُلَيْمَـٰنَ","مِنَ ٱلْجِنِّ وَٱلْإِنسِ",374],["27:18:16",378,"وَجُنُودُهُۥ","and his hosts","لَا يَحْطِمَنَّكُمْ سُلَيْمَـٰنُ","وَهُمْ لَا يَشْعُرُونَ",374],["27:37:4",380,"بِجُنُودٍۢ","with hosts","ٱرْجِعْ إِلَيْهِمْ فَلَنَأْتِيَنَّهُم","لَّا قِبَلَ لَهُم",374],["28:6:8",386,"وَجُنُودَهُمَا","and their hosts","وَنُرِىَ فِرْعَوْنَ وَهَـٰمَـٰنَ","مِنْهُم مَّا كَانُوا۟",374],["28:8:11",386,"وَجُنُودَهُمَا","and their hosts","إِنَّ فِرْعَوْنَ وَهَـٰمَـٰنَ","كَانُوا۟ خَـٰطِـِٔينَ",374],["28:39:3",390,"وَجُنُودُهُۥ","and his hosts","وَٱسْتَكْبَرَ هُوَ","فِى ٱلْأَرْضِ بِغَيْرِ",374],["28:40:2",390,"وَجُنُودَهُۥ","and his hosts","فَأَخَذْنَـٰهُ","فَنَبَذْنَـٰهُمْ فِى ٱلْيَمِّ ۖ",374],["33:9:10",419,"جُنُودٌۭ","(the) hosts","عَلَيْكُمْ إِذْ جَآءَتْكُمْ","فَأَرْسَلْنَا عَلَيْهِمْ رِيحًۭا",374],["33:9:14",419,"وَجُنُودًۭا","and hosts","فَأَرْسَلْنَا عَلَيْهِمْ رِيحًۭا","لَّمْ تَرَوْهَا ۚ وَكَانَ",374],["36:28:8",442,"جُندٍۢ","host","مِنۢ بَعْدِهِۦ مِن","مِّنَ ٱلسَّمَآءِ وَمَا",374],["36:75:6",445,"جُندٌۭ","(are) hosts","نَصْرَهُمْ وَهُمْ لَهُمْ","مُّحْضَرُونَ",374],["37:173:2",452,"جُندَنَا","Our host","وَإِنَّ","لَهُمُ ٱلْغَـٰلِبُونَ",374],["38:11:1",453,"جُندٌۭ","Soldiers","","مَّا هُنَالِكَ مَهْزُومٌۭ",374],["44:24:5",497,"جُندٌۭ","(are) an army","ٱلْبَحْرَ رَهْوًا ۖ إِنَّهُمْ","مُّغْرَقُونَ",374],["48:4:13",511,"جُنُودُ","(are the) hosts","مَّعَ إِيمَـٰنِهِمْ ۗ وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَكَانَ",374],["48:7:2",511,"جُنُودُ","(are the) hosts","وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَكَانَ",374],["51:40:2",522,"وَجُنُودَهُۥ","and his hosts","فَأَخَذْنَـٰهُ","فَنَبَذْنَـٰهُمْ فِى ٱلْيَمِّ",374],["67:20:5",563,"جُندٌۭ","(is) an army","هَـٰذَا ٱلَّذِى هُوَ","لَّكُمْ يَنصُرُكُم مِّن",374],["74:31:49",576,"جُنُودَ","(the) hosts","يَشَآءُ ۚ وَمَا يَعْلَمُ","رَبِّكَ إِلَّا هُوَ ۚ",374],["85:17:4",590,"ٱلْجُنُودِ","(of) the hosts","هَلْ أَتَىٰكَ حَدِيثُ","",374]]