[["2:32:10",6,"أَنتَ","You","مَا عَلَّمْتَنَآ ۖ إِنَّكَ","ٱلْعَلِيمُ ٱلْحَكِيمُ",139],["2:35:4",6,"أَنتَ","you","وَقُلْنَا يَـٰٓـَٔادَمُ ٱسْكُنْ","وَزَوْجُكَ ٱلْجَنَّةَ وَكُلَا",139],["2:127:12",20,"أَنتَ","[You] (are)","تَقَبَّلْ مِنَّآ ۖ إِنَّكَ","ٱلسَّمِيعُ ٱلْعَلِيمُ",139],["2:128:15",20,"أَنتَ","[You] (are)","وَتُبْ عَلَيْنَآ ۖ إِنَّكَ","ٱلتَّوَّابُ ٱلرَّحِيمُ",139],["2:129:14",20,"أَنتَ","You (are)","وَٱلْحِكْمَةَ وَيُزَكِّيهِمْ ۚ إِنَّكَ","ٱلْعَزِيزُ ٱلْحَكِيمُ",139],["2:145:12",22,"أَنتَ","(will) you (be)","تَبِعُوا۟ قِبْلَتَكَ ۚ وَمَآ","بِتَابِعٍۢ قِبْلَتَهُمْ ۚ وَمَا",139],["2:286:44",49,"أَنتَ","You (are)","وَٱغْفِرْ لَنَا وَٱرْحَمْنَآ ۚ","مَوْلَىٰنَا فَٱنصُرْنَا عَلَى",139],["3:8:14",50,"أَنتَ","You","لَّدُنكَ رَحْمَةً ۚ إِنَّكَ","ٱلْوَهَّابُ",139],["3:35:16",54,"أَنتَ","You","فَتَقَبَّلْ مِنِّىٓ ۖ إِنَّكَ","ٱلسَّمِيعُ ٱلْعَلِيمُ",139],["5:24:11",112,"أَنتَ","you","دَامُوا۟ فِيهَا ۖ فَٱذْهَبْ","وَرَبُّكَ فَقَـٰتِلَآ إِنَّا",139],["5:109:13",126,"أَنتَ","You","عِلْمَ لَنَآ ۖ إِنَّكَ","عَلَّـٰمُ ٱلْغُيُوبِ",139],["5:114:20",127,"وَأَنتَ","and You","وَءَايَةًۭ مِّنكَ ۖ وَٱرْزُقْنَا","خَيْرُ ٱلرَّٰزِقِينَ",139],["5:116:7",127,"ءَأَنتَ","Did you","يَـٰعِيسَى ٱبْنَ مَرْيَمَ","قُلْتَ لِلنَّاسِ ٱتَّخِذُونِى",139],["5:116:42",127,"أَنتَ","You","فِى نَفْسِكَ ۚ إِنَّكَ","عَلَّـٰمُ ٱلْغُيُوبِ",139],["5:117:22",127,"أَنتَ","[You]","فَلَمَّا تَوَفَّيْتَنِى كُنتَ","ٱلرَّقِيبَ عَلَيْهِمْ ۚ وَأَنتَ",139],["5:117:25",127,"وَأَنتَ","and You","أَنتَ ٱلرَّقِيبَ عَلَيْهِمْ ۚ","عَلَىٰ كُلِّ شَىْءٍۢ",139],["5:118:9",127,"أَنتَ","You","تَغْفِرْ لَهُمْ فَإِنَّكَ","ٱلْعَزِيزُ ٱلْحَكِيمُ",139],["6:107:11",141,"أَنتَ","you","عَلَيْهِمْ حَفِيظًۭا ۖ وَمَآ","عَلَيْهِم بِوَكِيلٍۢ",139],["7:19:3",152,"أَنتَ","you","وَيَـٰٓـَٔادَمُ ٱسْكُنْ","وَزَوْجُكَ ٱلْجَنَّةَ فَكُلَا",139],["7:89:40",162,"وَأَنتَ","and You","وَبَيْنَ قَوْمِنَا بِٱلْحَقِّ","خَيْرُ ٱلْفَـٰتِحِينَ",139],["7:151:9",169,"وَأَنتَ","for You","وَأَدْخِلْنَا فِى رَحْمَتِكَ ۖ","أَرْحَمُ ٱلرَّٰحِمِينَ",139],["7:155:34",1