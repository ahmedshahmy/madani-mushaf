[["9:97:5",202,"وَأَجْدَرُ","and more likely","أَشَدُّ كُفْرًۭا وَنِفَاقًۭا","أَلَّا يَعْلَمُوا۟ حُدُودَ",2994],["18:77:14",302,"جِدَارًۭا","a wall","يُضَيِّفُوهُمَا فَوَجَدَا فِيهَا","يُرِيدُ أَن يَنقَضَّ",2405],["18:82:2",302,"ٱلْجِدَارُ","the wall","وَأَمَّا","فَكَانَ لِغُلَـٰمَيْنِ يَتِيمَيْنِ",2405],["59:14:11",547,"جُدُرٍۭ ۚ","walls","أَوْ مِن وَرَآءِ","بَأْسُهُم بَيْنَهُمْ شَدِيدٌۭ ۚ",3544]]