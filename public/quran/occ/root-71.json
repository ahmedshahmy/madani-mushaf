[["2:23:20",4,"صَـٰدِقِينَ","truthful","ٱللَّهِ إِن كُنتُمْ","",201],["2:31:15",6,"صَـٰدِقِينَ","truthful","هَـٰٓؤُلَآءِ إِن كُنتُمْ","",201],["2:41:4",7,"مُصَدِّقًۭا","confirming","وَءَامِنُوا۟ بِمَآ أَنزَلْتُ","لِّمَا مَعَكُمْ وَلَا",529],["2:89:7",14,"مُصَدِّقٌۭ","confirming","مِّنْ عِندِ ٱللَّهِ","لِّمَا مَعَهُمْ وَكَانُوا۟",529],["2:91:18",14,"مُصَدِّقًۭا","confirming","وَرَآءَهُۥ وَهُوَ ٱلْحَقُّ","لِّمَا مَعَهُمْ ۗ قُلْ",529],["2:94:17",15,"صَـٰدِقِينَ","truthful","ٱلْمَوْتَ إِن كُنتُمْ","",201],["2:97:12",15,"مُصَدِّقًۭا","confirming","قَلْبِكَ بِإِذْنِ ٱللَّهِ","لِّمَا بَيْنَ يَدَيْهِ",529],["2:101:7",15,"مُصَدِّقٌۭ","confirming","مِّنْ عِندِ ٱللَّهِ","لِّمَا مَعَهُمْ نَبَذَ",529],["2:111:18",17,"صَـٰدِقِينَ","[those who are] truthful","بُرْهَـٰنَكُمْ إِن كُنتُمْ","",201],["2:177:48",27,"صَدَقُوا۟ ۖ","are true","ٱلْبَأْسِ ۗ أُو۟لَـٰٓئِكَ ٱلَّذِينَ","وَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُتَّقُونَ",623],["2:196:31",30,"صَدَقَةٍ","charity","مِّن صِيَامٍ أَوْ","أَوْ نُسُكٍۢ ۚ فَإِذَآ",1309],["2:263:6",44,"صَدَقَةٍۢ","a charity","وَمَغْفِرَةٌ خَيْرٌۭ مِّن","يَتْبَعُهَآ أَذًۭى ۗ وَٱللَّهُ",1309],["2:264:6",44,"صَدَقَـٰتِكُم","your charities","ءَامَنُوا۟ لَا تُبْطِلُوا۟","بِٱلْمَنِّ وَٱلْأَذَىٰ كَٱلَّذِى",962],["2:271:3",46,"ٱلصَّدَقَـٰتِ","the charities","إِن تُبْدُوا۟","فَنِعِمَّا هِىَ ۖ وَإِن",962],["2:276:5",47,"ٱلصَّدَقَـٰتِ ۗ","(for) the charities","ٱللَّهُ ٱلرِّبَوٰا۟ وَيُرْبِى","وَٱللَّهُ لَا يُحِبُّ",962],["2:280:9",47,"تَصَدَّقُوا۟","you remit as charity","إِلَىٰ مَيْسَرَةٍۢ ۚ وَأَن","خَيْرٌۭ لَّكُمْ ۖ إِن",1236],["3:3:5",50,"مُصَدِّقًۭا","confirming","عَلَيْكَ ٱلْكِتَـٰبَ بِٱلْحَقِّ","لِّمَا بَيْنَ يَدَيْهِ",529],["3:17:2",52,"وَٱلصَّـٰدِقِينَ","and the truthful","ٱلصَّـٰبِرِينَ","وَٱلْقَـٰنِتِينَ وَٱلْمُنفِقِينَ وَٱلْمُسْتَغْفِرِينَ",201],["3:39:12",55,"مُصَدِّقًۢا","confirming","ٱللَّهَ يُبَشِّرُكَ بِيَحْيَىٰ","بِكَلِمَةٍۢ مِّنَ ٱللَّهِ",529],["3:50:1",56,"وَمُصَدِّقًۭا","And confirming","","لِّمَا بَيْنَ يَدَىَّ",529],["3:81:14",60,"مُّصَدِّقٌۭ","confirming"