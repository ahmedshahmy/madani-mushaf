ulness","يَوْمُ يَنفَعُ ٱلصَّـٰدِقِينَ","لَهُمْ جَنَّـٰتٌۭ تَجْرِى",658],["6:40:15",132,"صَـٰدِقِينَ","truthful","تَدْعُونَ إِن كُنتُمْ","",201],["6:92:5",139,"مُّصَدِّقُ","confirming","كِتَـٰبٌ أَنزَلْنَـٰهُ مُبَارَكٌۭ","ٱلَّذِى بَيْنَ يَدَيْهِ",529],["6:115:4",142,"صِدْقًۭا","(in) truth","وَتَمَّتْ كَلِمَتُ رَبِّكَ","وَعَدْلًۭا ۚ لَّا مُبَدِّلَ",658],["6:143:23",147,"صَـٰدِقِينَ","truthful","بِعِلْمٍ إِن كُنتُمْ","",201],["6:146:28",147,"لَصَـٰدِقُونَ","[surely] are truthful","جَزَيْنَـٰهُم بِبَغْيِهِمْ ۖ وَإِنَّا","",201],["7:70:17",159,"ٱلصَّـٰدِقِينَ","the truthful","إِن كُنتَ مِنَ","",201],["7:106:11",164,"ٱلصَّـٰدِقِينَ","the truthful","إِن كُنتَ مِنَ","",201],["7:194:14",175,"صَـٰدِقِينَ","truthful","لَكُمْ إِن كُنتُمْ","",201],["9:43:11",194,"صَدَقُوا۟","were truthful","يَتَبَيَّنَ لَكَ ٱلَّذِينَ","وَتَعْلَمَ ٱلْكَـٰذِبِينَ",623],["9:58:5",196,"ٱلصَّدَقَـٰتِ","the charities","مَّن يَلْمِزُكَ فِى","فَإِنْ أُعْطُوا۟ مِنْهَا",962],["9:60:2",196,"ٱلصَّدَقَـٰتُ","the charities","۞ إِنَّمَا","لِلْفُقَرَآءِ وَٱلْمَسَـٰكِينِ وَٱلْعَـٰمِلِينَ",962],["9:75:9",199,"لَنَصَّدَّقَنَّ","surely we will give charity","ءَاتَىٰنَا مِن فَضْلِهِۦ","وَلَنَكُونَنَّ مِنَ ٱلصَّـٰلِحِينَ",1236],["9:79:7",199,"ٱلصَّدَقَـٰتِ","the charities","مِنَ ٱلْمُؤْمِنِينَ فِى","وَٱلَّذِينَ لَا يَجِدُونَ",962],["9:103:4",203,"صَدَقَةًۭ","a charity","خُذْ مِنْ أَمْوَٰلِهِمْ","تُطَهِّرُهُمْ وَتُزَكِّيهِم بِهَا",1309],["9:104:11",203,"ٱلصَّدَقَـٰتِ","the charities","عَنْ عِبَادِهِۦ وَيَأْخُذُ","وَأَنَّ ٱللَّهَ هُوَ",962],["9:119:8",206,"ٱلصَّـٰدِقِينَ","those who are truthful","ٱللَّهَ وَكُونُوا۟ مَعَ","",201],["10:2:18",208,"صِدْقٍ","(will be) a respectable position","أَنَّ لَهُمْ قَدَمَ","عِندَ رَبِّهِمْ ۗ قَالَ",658],["10:37:11",213,"تَصْدِيقَ","(it is) a confirmation","دُونِ ٱللَّهِ وَلَـٰكِن","ٱلَّذِى بَيْنَ يَدَيْهِ",2656],["10:38:16",213,"صَـٰدِقِينَ","truthful","ٱللَّهِ إِن كُنتُمْ","",201],["10:48:7",214,"صَـٰدِقِينَ","truthful","ٱلْوَعْدُ إِن كُنتُمْ","",201],["10:93:6",219,"صِدْقٍۢ","honorable","بَنِىٓ إِسْرَٰٓءِيلَ مُبَوَّأَ","وَرَزَقْنَـٰهُم مِّنَ ٱلطَّيِّبَـٰتِ",658],["11:13:18",223,"صَـٰدِقِينَ","truthful","ٱللَّهِ إِن كُنتُمْ","",201],["11:32:13",225,"ٱلصَّـٰدِقِينَ","the truthful","إِن كُنتَ مِنَ","",201],["12:17:18",237,"صَـٰدِقِينَ","truthful","لَّنَا وَلَوْ كُنَّا","",201],["12:26:16",238,"فَصَدَقَتْ","then she has spoken the truth","قُدَّ مِن قُبُلٍۢ","وَهُوَ مِنَ ٱلْكَـٰذِبِينَ",623],["12:27:10",238,"ٱلصَّـٰدِقِينَ","the truthful","فَكَذَبَتْ وَهُوَ مِنَ","",201],["12:46:3",241,"ٱلصِّدِّيقُ","the truthful one","يُوسُفُ أَيُّهَا","أَفْتِنَا فِى سَبْعِ",1311],["12:51:29",241,"ٱلصَّـٰدِقِينَ","the truthful","نَّفْسِهِۦ وَإِنَّهُۥ لَمِنَ","",201],["12:82:11",245,"لَصَـٰدِقُونَ","surely (are) truthful.'","أَقْبَلْنَا فِيهَا ۖ وَإِنَّا","",201],["12:88:16",246,"وَتَصَدَّقْ","and be charitable","فَأَوْفِ لَنَا ٱلْكَيْلَ","عَلَيْنَآ ۖ إِنَّ ٱللَّهَ",1236],["12:88:21",246,"ٱلْمُتَصَدِّقِينَ","the charitable","إِنَّ ٱللَّهَ يَجْزِى","",2510],["12:111:13",248,"تَصْدِيقَ","a confirmation","حَدِيثًۭا يُفْتَرَىٰ وَلَـٰكِن","ٱلَّذِى بَيْنَ يَدَيْهِ",2656],["15:7:8",262,"ٱلصَّـٰدِقِينَ","the truthful","إِن كُنتَ مِنَ","",201],["15:64:4",265,"لَصَـٰدِقُونَ","surely (are) truthful","وَأَتَيْنَـٰكَ بِٱلْحَقِّ وَإِنَّا","",201],["17:80:5",290,"صِدْقٍۢ","sound","رَّبِّ أَدْخِلْنِى مُدْخَلَ","وَأَخْرِجْنِى مُخْرَجَ صِدْقٍۢ",658],["17:80:8",290,"صِدْقٍۢ","sound","صِدْقٍۢ وَأَخْرِجْنِى مُخْرَجَ","وَٱجْعَل لِّى مِن",658],["19:41:7",308,"صِدِّيقًۭا","a man of truth","إِبْرَٰهِيمَ ۚ إِنَّهُۥ كَانَ","نَّبِيًّا",1311],["19:50:8",308,"صِدْقٍ","a truthful mention","وَجَعَلْنَا لَهُمْ لِسَانَ","عَلِيًّۭا",658],["19:54:7",309,"صَادِقَ","true","إِسْمَـٰعِيلَ ۚ إِنَّهُۥ كَانَ","ٱلْوَعْدِ وَكَانَ رَسُولًۭا",201],["19:56:7",309,"صِدِّيقًۭا","truthful","إِدْرِيسَ ۚ إِنَّهُۥ كَانَ","نَّبِيًّۭا",1311],["21:9:2",322,"صَدَقْنَـٰهُمُ","We fulfilled (for) them","ثُمَّ","ٱلْوَعْدَ فَأَنجَيْنَـٰهُمْ وَمَن",623],["21:38:7",325,"صَـٰدِقِينَ","truthful","ٱلْوَعْدُ إِن كُنتُمْ","",201],["24:6:17",350,"ٱلصَّـٰدِقِينَ","the truthful","بِٱللَّهِ ۙ إِنَّهُۥ لَمِنَ","",201],["24:9:9",350,"ٱلصَّـٰدِقِينَ","the truthful","إِن كَانَ مِنَ","",201],["24:61:49",358,"صَدِيقِكُمْ ۚ","your friend","مَلَكْتُم مَّفَاتِحَهُۥٓ أَوْ","لَيْسَ عَلَيْكُمْ جُنَاحٌ",2289],["26:31:7",368,"ٱلصَّـٰدِقِينَ","the truthful","إِن كُنتَ مِنَ","",201],["26:84:4",371,"صِدْقٍۢ","(of) honor","وَٱجْعَل لِّى لِسَانَ","فِى ٱلْـَٔاخِرِينَ",658],["26:101:2",371,"صَدِيقٍ","a friend","وَلَا","حَمِيمٍۢ",2289],["26:154:11",373,"ٱلصَّـٰدِقِينَ","the truthful","إِن كُنتَ مِنَ","",201],["26:187:9",375,"ٱلصَّـٰدِقِينَ","the truthful","إِن كُنتَ مِنَ","",201],["27:27:3",379,"أَصَدَقْتَ","whether you speak (the) truth","۞ قَالَ سَنَنظُرُ","أَمْ كُنتَ مِنَ",623],["27:49:14",381,"لَصَـٰدِقُونَ","(are) surely truthful","مَهْلِكَ أَهْلِهِۦ وَإِنَّا","",201],["27:64:19",383,"صَـٰدِقِينَ","truthful","بُرْهَـٰنَكُمْ إِن كُنتُمْ","",201],["27:71:7",383,"صَـٰدِقِينَ","truthful","ٱلْوَعْدُ إِن كُنتُمْ","",201],["28:34:10",389,"يُصَدِّقُنِىٓ ۖ","who will confirm me","فَأَرْسِلْهُ مَعِىَ رِدْءًۭا","إِنِّىٓ أَخَافُ أَن",825],["28:49:13",391,"صَـٰدِقِينَ","truthful","أَتَّبِعْهُ إِن كُنتُمْ","",201],["29:3:9",396,"صَدَقُوا۟","(are) truthful","فَلَيَعْلَمَنَّ ٱللَّهُ ٱلَّذِينَ","وَلَيَعْلَمَنَّ ٱلْكَـٰذِبِينَ",623],["29:29:23",399,"ٱلصَّـٰدِقِينَ","the truthful","إِن كُنتَ مِنَ","",201],["32:28:7",417,"صَـٰدِقِينَ","truthful","ٱلْفَتْحُ إِن كُنتُمْ","",201],["33:8:2",419,"ٱلصَّـٰدِقِينَ","the truthful","لِّيَسْـَٔلَ","عَن صِدْقِهِمْ ۚ وَأَعَدَّ",201],["33:8:4",419,"صِدْقِهِمْ ۚ","their truth","لِّيَسْـَٔلَ ٱلصَّـٰدِقِينَ عَن","وَأَعَدَّ لِلْكَـٰفِرِينَ عَذَابًا",658],["33:22:11",420,"وَصَدَقَ","and Allah spoke the truth","وَعَدَنَا ٱللَّهُ وَرَسُولُهُۥ","ٱللَّهُ وَرَسُولُهُۥ ۚ وَمَا",623],["33:23:4",421,"صَدَقُوا۟","(who) have been true","مِّنَ ٱلْمُؤْمِنِينَ رِجَالٌۭ","مَا عَـٰهَدُوا۟ ٱللَّهَ",623],["33:24:3",421,"ٱلصَّـٰدِقِينَ","the truthful","لِّيَجْزِىَ ٱللَّهُ","بِصِدْقِهِمْ وَيُعَذِّبَ ٱلْمُنَـٰفِقِينَ",201],["33:24:4",421,"بِصِدْقِهِمْ","for their truth","لِّيَجْزِىَ ٱللَّهُ ٱلصَّـٰدِقِينَ","وَيُعَذِّبَ ٱلْمُنَـٰفِقِينَ إِن",658],["33:35:8",422,"وَٱلصَّـٰدِقِينَ","and the truthful men","وَٱلْمُؤْمِنَـٰتِ وَٱلْقَـٰنِتِينَ وَٱلْقَـٰنِتَـٰتِ","وَٱلصَّـٰدِقَـٰتِ وَٱلصَّـٰبِرِينَ وَٱلصَّـٰبِرَٰتِ",201],["33:35:9",422,"وَٱلصَّـٰدِقَـٰتِ","and the truthful women","وَٱلْقَـٰنِتِينَ وَٱلْقَـٰنِتَـٰتِ وَٱلصَّـٰدِقِينَ","وَٱلصَّـٰبِرِينَ وَٱلصَّـٰبِرَٰتِ وَٱلْخَـٰشِعِينَ",3276],["33:35:14",422,"وَٱلْمُتَصَدِّقِينَ","and the men who give charity","وَٱلصَّـٰبِرَٰتِ وَٱلْخَـٰشِعِينَ وَٱلْخَـٰشِعَـٰتِ","وَٱلْمُتَصَدِّقَـٰتِ وَٱلصَّـٰٓئِمِينَ وَٱلصَّـٰٓئِمَـٰتِ",2510],["33:35:15",422,"وَٱلْمُتَصَدِّقَـٰتِ","and the women who give charity","وَٱلْخَـٰشِعِينَ وَٱلْخَـٰشِعَـٰتِ وَٱلْمُتَصَدِّقِينَ","وَٱلصَّـٰٓئِمِينَ وَٱلصَّـٰٓئِمَـٰتِ وَٱلْحَـٰفِظِينَ",3869],["34:20:2",430,"صَدَّقَ","found true","وَلَقَدْ","عَلَيْهِمْ إِبْلِيسُ ظَنَّهُۥ",825],["34:29:7",431,"صَـٰدِقِينَ","truthful","ٱلْوَعْدُ إِن كُنتُمْ","",201],["35:31:8",438,"مُصَدِّقًۭا","confirming","ٱلْكِتَـٰبِ هُوَ ٱلْحَقُّ","لِّمَا بَيْنَ يَدَيْهِ ۗ",529],["36:48:7",443,"صَـٰدِقِينَ","truthful","ٱلْوَعْدُ إِن كُنتُمْ","",201],["36:52:11",443,"وَصَدَقَ","and told (the) truth","مَا وَعَدَ ٱلرَّحْمَـٰنُ","ٱلْمُرْسَلُونَ",623],["37:37:4",447,"وَصَدَّقَ","and confirmed","بَلْ جَآءَ بِٱلْحَقِّ","ٱلْمُرْسَلِينَ",825],["37:52:4",448,"ٱلْمُصَدِّقِينَ","those who believe","يَقُولُ أَءِنَّكَ لَمِنَ","",529],["37:105:2",450,"صَدَّقْتَ","you have fulfilled","قَدْ","ٱلرُّءْيَآ ۚ إِنَّا كَذَٰلِكَ",825],["37:157:5",452,"صَـٰدِقِينَ","truthful","بِكِتَـٰبِكُمْ إِن كُنتُمْ","",201],["39:32:8",462,"بِٱلصِّدْقِ","the truth","عَلَى ٱللَّهِ وَكَذَّبَ","إِذْ جَآءَهُۥٓ ۚ أَلَيْسَ",658],["39:33:3",462,"بِٱلصِّدْقِ","the truth","وَٱلَّذِى جَآءَ","وَصَدَّقَ بِهِۦٓ ۙ أُو۟لَـٰٓئِكَ",658],["39:33:4",462,"وَصَدَّقَ","and believed","وَٱلَّذِى جَآءَ بِٱلصِّدْقِ","بِهِۦٓ ۙ أُو۟لَـٰٓئِكَ هُمُ",825],["39:74:5",466,"صَدَقَنَا","has fulfilled for us","ٱلْحَمْدُ لِلَّهِ ٱلَّذِى","وَعْدَهُۥ وَأَوْرَثَنَا ٱلْأَرْضَ",623],["40:28:27",470,"صَادِقًۭا","truthful","كَذِبُهُۥ ۖ وَإِن يَكُ","يُصِبْكُم بَعْضُ ٱلَّذِى",201],["44:36:5",497,"صَـٰدِقِينَ","truthful","بِـَٔابَآئِنَآ إِن كُنتُمْ","",201],["45:25:16",501,"صَـٰدِقِينَ","truthful","بِـَٔابَآئِنَآ إِن كُنتُمْ","",201],["46:4:29",502,"صَـٰدِقِينَ","truthful","عِلْمٍ إِن كُنتُمْ","",201],["46:12:9",503,"مُّصَدِّقٌۭ","confirming","وَرَحْمَةًۭ ۚ وَهَـٰذَا كِتَـٰبٌۭ","لِّسَانًا عَرَبِيًّۭا لِّيُنذِرَ",529],["46:16:15",504,"ٱلصِّدْقِ","true","أَصْحَـٰبِ ٱلْجَنَّةِ ۖ وَعْدَ","ٱلَّذِى كَانُوا۟ يُوعَدُونَ",658],["46:22:12",505,"ٱلصَّـٰدِقِينَ","the truthful","إِن كُنتَ مِنَ","",201],["46:30:10",506,"مُصَدِّقًۭا","confirming","مِنۢ بَعْدِ مُوسَىٰ","لِّمَا بَيْنَ يَدَيْهِ",529],["47:21:8",509,"صَدَقُوا۟","they had been true","عَزَمَ ٱلْأَمْرُ فَلَوْ","ٱللَّهَ لَكَانَ خَيْرًۭا",623],["48:27:2",514,"صَدَقَ","Allah has fulfilled","لَّقَدْ","ٱللَّهُ رَسُولَهُ ٱلرُّءْيَا",623],["49:15:18",517,"ٱلصَّـٰدِقُونَ","(are) the truthful","ٱللَّهِ ۚ أُو۟لَـٰٓئِكَ هُمُ","",201],["49:17:19",517,"صَـٰدِقِينَ","truthful","لِلْإِيمَـٰنِ إِن كُنتُمْ","",201],["51:5:3",520,"لَصَادِقٌۭ","(is) surely true","إِنَّمَا تُوعَدُونَ","",201],["52:34:6",525,"صَـٰدِقِينَ","truthful","مِّثْلِهِۦٓ إِن كَانُوا۟","",201],["54:55:3",531,"صِدْقٍ","(of) honor","فِى مَقْعَدِ","عِندَ مَلِيكٍۢ مُّقْتَدِرٍۭ",658],["56:57:4",536,"تُصَدِّقُونَ","you admit the truth","نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا","",825],["56:87:4",537,"صَـٰدِقِينَ","truthful","تَرْجِعُونَهَآ إِن كُنتُمْ","",201],["57:18:2",539,"ٱلْمُصَّدِّقِينَ","the men who give charity","إِنَّ","وَٱلْمُصَّدِّقَـٰتِ وَأَقْرَضُوا۟ ٱللَّهَ",3777],["57:18:3",539,"وَٱلْمُصَّدِّقَـٰتِ","and the women who give charity","إِنَّ ٱلْمُصَّدِّقِينَ","وَأَقْرَضُوا۟ ٱللَّهَ قَرْضًا",3776],["57:19:7",540,"ٱلصِّدِّيقُونَ ۖ","(are) the truthful","وَرُسُلِهِۦٓ أُو۟لَـٰٓئِكَ هُمُ","وَٱلشُّهَدَآءُ عِندَ رَبِّهِمْ",1311],["58:12:11",544,"صَدَقَةًۭ ۚ","charity","بَيْنَ يَدَىْ نَجْوَىٰكُمْ","ذَٰلِكَ خَيْرٌۭ لَّكُمْ",1309],["58:13:7",544,"صَدَقَـٰتٍۢ ۚ","charities","بَيْنَ يَدَىْ نَجْوَىٰكُمْ","فَإِذْ لَمْ تَفْعَلُوا۟",962],["59:8:18",546,"ٱلصَّـٰدِقُونَ","(are) the truthful","وَرَسُولَهُۥٓ ۚ أُو۟لَـٰٓئِكَ هُمُ","",201],["61:6:12",552,"مُّصَدِّقًۭا","confirming","رَسُولُ ٱللَّهِ إِلَيْكُم","لِّمَا بَيْنَ يَدَىَّ",529],["62:6:17",553,"صَـٰدِقِينَ","truthful","ٱلْمَوْتَ إِن كُنتُمْ","",201],["63:10:18",555,"فَأَصَّدَّقَ","so I would give charity","إِلَىٰٓ أَجَلٍۢ قَرِيبٍۢ","وَأَكُن مِّنَ ٱلصَّـٰلِحِينَ",1236],["66:12:11",561,"وَصَدَّقَتْ","And she believed","فِيهِ مِن رُّوحِنَا","بِكَلِمَـٰتِ رَبِّهَا وَكُتُبِهِۦ",825],["67:25:7",563,"صَـٰدِقِينَ","truthful","ٱلْوَعْدُ إِن كُنتُمْ","",201],["68:41:8",565,"صَـٰدِقِينَ","truthful","بِشُرَكَآئِهِمْ إِن كَانُوا۟","",201],["70:26:2",569,"يُصَدِّقُونَ","accept (the) truth","وَٱلَّذِينَ","بِيَوْمِ ٱلدِّينِ",825],["75:31:2",578,"صَدَّقَ","he accepted (the) truth","فَلَا","وَلَا صَلَّىٰ",825],["92:6:1",595,"وَصَدَّقَ","And believes","","بِٱلْحُسْنَىٰ",825]]