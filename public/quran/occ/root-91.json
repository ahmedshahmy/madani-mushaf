[["2:38:13",7,"خَوْفٌ","fear","تَبِعَ هُدَاىَ فَلَا","عَلَيْهِمْ وَلَا هُمْ",418],["2:62:20",10,"خَوْفٌ","fear","عِندَ رَبِّهِمْ وَلَا","عَلَيْهِمْ وَلَا هُمْ",418],["2:112:13",17,"خَوْفٌ","fear","عِندَ رَبِّهِۦ وَلَا","عَلَيْهِمْ وَلَا هُمْ",418],["2:114:21",18,"خَآئِفِينَ ۚ","(like) those in fear","أَن يَدْخُلُوهَآ إِلَّا","لَهُمْ فِى ٱلدُّنْيَا",2033],["2:155:4",24,"ٱلْخَوْفِ","[the] fear","وَلَنَبْلُوَنَّكُم بِشَىْءٍۢ مِّنَ","وَٱلْجُوعِ وَنَقْصٍۢ مِّنَ",418],["2:182:2",28,"خَافَ","fears","فَمَنْ","مِن مُّوصٍۢ جَنَفًا",136],["2:229:18",36,"يَخَافَآ","both fear","شَيْـًٔا إِلَّآ أَن","أَلَّا يُقِيمَا حُدُودَ",136],["2:229:24",36,"خِفْتُمْ","you fear","حُدُودَ ٱللَّهِ ۖ فَإِنْ","أَلَّا يُقِيمَا حُدُودَ",136],["2:239:2",39,"خِفْتُمْ","you fear","فَإِنْ","فَرِجَالًا أَوْ رُكْبَانًۭا ۖ",136],["2:262:20",44,"خَوْفٌ","fear","عِندَ رَبِّهِمْ وَلَا","عَلَيْهِمْ وَلَا هُمْ",418],["2:274:13",46,"خَوْفٌ","fear","عِندَ رَبِّهِمْ وَلَا","عَلَيْهِمْ وَلَا هُمْ",418],["2:277:15",47,"خَوْفٌ","fear","عِندَ رَبِّهِمْ وَلَا","عَلَيْهِمْ وَلَا هُمْ",418],["3:170:15",72,"خَوْفٌ","fear","مِّنْ خَلْفِهِمْ أَلَّا","عَلَيْهِمْ وَلَا هُمْ",418],["3:175:4",73,"يُخَوِّفُ","frightens (you)","إِنَّمَا ذَٰلِكُمُ ٱلشَّيْطَـٰنُ","أَوْلِيَآءَهُۥ فَلَا تَخَافُوهُمْ",1687],["3:175:7",73,"تَخَافُوهُمْ","fear them","يُخَوِّفُ أَوْلِيَآءَهُۥ فَلَا","وَخَافُونِ إِن كُنتُم",136],["3:175:8",73,"وَخَافُونِ","but fear Me","أَوْلِيَآءَهُۥ فَلَا تَخَافُوهُمْ","إِن كُنتُم مُّؤْمِنِينَ",136],["4:3:2",77,"خِفْتُمْ","you fear","وَإِنْ","أَلَّا تُقْسِطُوا۟ فِى",136],["4:3:17",77,"خِفْتُمْ","you fear","وَثُلَـٰثَ وَرُبَـٰعَ ۖ فَإِنْ","أَلَّا تَعْدِلُوا۟ فَوَٰحِدَةً",136],["4:9:9",78,"خَافُوا۟","(and) they would have feared","خَلْفِهِمْ ذُرِّيَّةًۭ ضِعَـٰفًا","عَلَيْهِمْ فَلْيَتَّقُوا۟ ٱللَّهَ",136],["4:34:23",84,"تَخَافُونَ","you fear","حَفِظَ ٱللَّهُ ۚ وَٱلَّـٰتِى","نُشُوزَهُنَّ فَعِظُوهُنَّ وَٱهْجُرُوهُنَّ",136],["4:35:2",84,"خِفْتُمْ","you fear","وَإِنْ","شِقَاقَ بَيْنِهِمَا فَٱبْعَثُوا۟",136],["4:83:7",91,"ٱلْخَوْفِ","[the] fear","مِّنَ ٱلْأَمْنِ أَوِ","أَذَاعُوا۟ بِهِۦ ۖ وَلَوْ",418],["4:101:13",94,"خِفْتُمْ","you fear","مِنَ ٱلصَّلَوٰةِ إِنْ","أَن يَفْتِنَكُمُ ٱلَّذِينَ",136],["4:128:3",99,"خَافَتْ","fears","وَإِنِ ٱمْرَأَةٌ","مِنۢ بَعْلِهَا نُشُوزًا",136],["5:23:5",111,"يَخَافُونَ","feared (Allah)","رَجُلَانِ مِنَ ٱلَّذِينَ","أَنْعَمَ ٱللَّهُ عَلَيْهِمَا",136],["5:28:13",112,"أَخَافُ","fear","إِلَيْكَ لِأَقْتُلَكَ ۖ إِنِّىٓ","ٱللَّهَ رَبَّ ٱلْعَـٰلَمِينَ",136],["5:54:26",117,"يَخَافُونَ","fearing","سَبِيلِ ٱللَّهِ وَلَا","لَوْمَةَ لَآئِمٍۢ ۚ ذَٰلِكَ",136],["5:69:16",119,"خَوْفٌ","fear","وَعَمِلَ صَـٰلِحًۭا فَلَا","عَلَيْهِمْ وَلَا هُمْ",418],["5:94:15",123,"يَخَافُهُۥ","fears Him","لِيَعْلَمَ ٱللَّهُ مَن","بِٱلْغَيْبِ ۚ فَمَنِ ٱعْتَدَىٰ",136],["5:108:9",125,"يَخَافُوٓا۟","they would fear","عَلَىٰ وَجْهِهَآ أَوْ","أَن تُرَدَّ أَيْمَـٰنٌۢ",136],["6:15:3",129,"أَخَافُ","[I] fear","قُلْ إِنِّىٓ","إِنْ عَصَيْتُ رَبِّى",136],["6:48:11",133,"خَوْفٌ","fear","ءَامَنَ وَأَصْلَحَ فَلَا","عَلَيْهِمْ وَلَا هُمْ",418],["6:51:4",133,"يَخَافُونَ","fear","وَأَنذِرْ بِهِ ٱلَّذِينَ","أَن يُحْشَرُوٓا۟ إِلَىٰ",136],["6:80:10",137,"أَخَافُ","(do) I fear","وَقَدْ هَدَىٰنِ ۚ وَلَآ","مَا تُشْرِكُونَ بِهِۦٓ",136],["6:81:2",137,"أَخَافُ","could I fear","وَكَيْفَ","مَآ أَشْرَكْتُمْ وَلَا",136],["6:81:6",137,"تَخَافُونَ","you fear","مَآ أَشْرَكْتُمْ وَلَا","أَنَّكُمْ أَشْرَكْتُم بِٱللَّهِ",136],["7:35:14",154,"خَوْفٌ","fear","ٱتَّقَىٰ وَأَصْلَحَ فَلَا","عَلَيْهِمْ وَلَا هُمْ",418],["7:49:11",156,"خَوْفٌ","fear","ٱدْخُلُوا۟ ٱلْجَنَّةَ لَا","عَلَيْكُمْ وَلَآ أَنتُمْ",418],["7:56:8",157,"خَوْفًۭا","(in) fear","بَعْدَ إِصْلَـٰحِهَا وَٱدْعُوهُ","وَطَمَعًا ۚ إِنَّ رَحْمَتَ",418],["7:59:16",158,"أَخَافُ","[I] fear","إِلَـٰهٍ غَيْرُهُۥٓ إِنِّىٓ","عَلَيْكُمْ عَذَابَ يَوْمٍ",136],["7:205:6",176,"وَخِيفَةًۭ","and (in) fear","فِى نَفْسِكَ تَضَرُّعًۭا","وَدُونَ ٱلْجَهْرِ مِنَ",1249],["8:26:8",180,"تَخَافُونَ","fearing","مُّسْتَضْعَفُونَ فِى ٱلْأَرْضِ","أَن يَتَخَطَّفَكُمُ ٱلنَّاسُ",136],["8:48:32",183,"أَخَافُ","[I] fear","لَا تَرَوْنَ إِنِّىٓ","ٱللَّهَ ۚ وَٱللَّهُ شَدِيدُ",136],["8:58:2",184,"تَخَافَنَّ","you fear","وَإِمَّا","مِن قَوْمٍ خِيَانَةًۭ",136],["9:28:15",191,"خِفْتُمْ","you fear","عَامِهِمْ هَـٰذَا ۚ وَإِنْ","عَيْلَةًۭ فَسَوْفَ يُغْنِيكُمُ",136],["10:15:33",210,"أَخَافُ","[I] fear","يُوحَىٰٓ إِلَىَّ ۖ إِنِّىٓ","إِنْ عَصَيْتُ رَبِّى",136],["10:62:6",216,"خَوْفٌ","fear","أَوْلِيَآءَ ٱللَّهِ لَا","عَلَيْهِمْ وَلَا هُمْ",418],["10:83:9",218,"خَوْفٍۢ","fear","مِّن قَوْمِهِۦ عَلَىٰ","مِّن فِرْعَوْنَ وَمَلَإِي۟هِمْ",418],["11:3:21",221,"أَخَافُ","fear","وَإِن تَوَلَّوْا۟ فَإِنِّىٓ","عَلَيْكُمْ عَذَابَ يَوْمٍۢ",136],["11:26:7",224,"أَخَافُ","[I] fear","إِلَّا ٱللَّهَ ۖ إِنِّىٓ","عَلَيْكُمْ عَذَابَ يَوْمٍ",136],["11:70:10",229,"خِيفَةًۭ ۚ","[a fear]","نَكِرَهُمْ وَأَوْجَسَ مِنْهُمْ","قَالُوا۟ لَا تَخَفْ",1249],["11:70:13",229,"تَخَفْ","fear","خِيفَةًۭ ۚ قَالُوا۟ لَا","إِنَّآ أُرْسِلْنَآ إِلَىٰ",136],["11:84:22",231,"أَخَافُ","fear","أَرَىٰكُم بِخَيْرٍۢ وَإِنِّىٓ","عَلَيْكُمْ عَذَابَ يَوْمٍۢ",136],["11:103:6",233,"خَافَ","fear","ذَٰلِكَ لَـَٔايَةًۭ لِّمَنْ","عَذَابَ ٱلْـَٔاخِرَةِ ۚ ذَٰلِكَ",136],["12:13:7",236,"وَأَخَافُ","and I fear","أَن تَذْهَبُوا۟ بِهِۦ","أَن يَأْكُلَهُ ٱلذِّئْبُ",136],["13:12:5",250,"خَوْفًۭا","a fear","ٱلَّذِى يُرِيكُمُ ٱلْبَرْقَ","وَطَمَعًۭا وَيُنشِئُ ٱلسَّحَابَ",418],["13:13:6",250,"خِيفَتِهِۦ","fear of Him","بِحَمْدِهِۦ وَٱلْمَلَـٰٓئِكَةُ مِنْ","وَيُرْسِلُ ٱلصَّوَٰعِقَ فَيُصِيبُ",1249],["13:21:11",252,"وَيَخَافُونَ","and are afraid","يُوصَلَ وَيَخْشَوْنَ رَبَّهُمْ","سُوٓءَ ٱلْحِسَابِ",136],["14:14:7",257,"خَافَ","fears","بَعْدِهِمْ ۚ ذَٰلِكَ لِمَنْ","مَقَامِى وَخَافَ وَعِيدِ",136],["14:14:9",257,"وَخَافَ","and fears","لِمَنْ خَافَ مَقَامِى","وَعِيدِ",136],["16:47:4",272,"تَخَوُّفٍۢ","a gradual wasting","أَوْ يَأْخُذَهُمْ عَلَىٰ","فَإِنَّ رَبَّكُمْ لَرَءُوفٌۭ",4436],["16:50:1",272,"يَخَافُونَ","They fear","","رَبَّهُم مِّن فَوْقِهِمْ",136],["16:112:21",280,"وَٱلْخَوْفِ","and the fear","ٱللَّهُ لِبَاسَ ٱلْجُوعِ","بِمَا كَانُوا۟ يَصْنَعُونَ",418],["17:57:12",287,"وَيَخَافُونَ","and fear","أَقْرَبُ وَيَرْجُونَ رَحْمَتَهُۥ","عَذَابَهُۥٓ ۚ إِنَّ عَذَابَ",136],["17:59:21",288,"تَخْوِيفًۭا","(as) a warning","نُرْسِلُ بِٱلْـَٔايَـٰتِ إِلَّا","",4440],["17:60:20",288,"وَنُخَوِّفُهُمْ","And We threaten them","ٱلْمَلْعُونَةَ فِى ٱلْقُرْءَانِ ۚ","فَمَا يَزِيدُهُمْ إِلَّا",1687],["19:5:2",305,"خِفْتُ","[I] fear","وَإِنِّى","ٱلْمَوَٰلِىَ مِن وَرَآءِى",136],["19:45:3",308,"أَخَافُ","[I] fear","يَـٰٓأَبَتِ إِنِّىٓ","أَن يَمَسَّكَ عَذَابٌۭ",136],["20:21:4",313,"تَخَفْ ۖ","fear","قَالَ خُذْهَا وَلَا","سَنُعِيدُهَا سِيرَتَهَا ٱلْأُولَىٰ",136],["20:45:4",314,"نَخَافُ","fear","قَالَا رَبَّنَآ إِنَّنَا","أَن يَفْرُطَ عَلَيْنَآ",136],["20:46:3",314,"تَخَافَآ ۖ","fear","قَالَ لَا","إِنَّنِى مَعَكُمَآ أَسْمَعُ",136],["20:67:4",316,"خِيفَةًۭ","a fear","فَأَوْجَسَ فِى نَفْسِهِۦ","مُّوسَىٰ",1249],["20:68:3",316,"تَخَفْ","fear","قُلْنَا لَا","إِنَّكَ أَنتَ ٱلْأَعْلَىٰ",136],["20:77:15",317,"تَخَـٰفُ","fearing","ٱلْبَحْرِ يَبَسًۭا لَّا","دَرَكًۭا وَلَا تَخْشَىٰ",136],["20:112:8",319,"يَخَافُ","he will fear","وَهُوَ مُؤْمِنٌۭ فَلَا","ظُلْمًۭا وَلَا هَضْمًۭا",136],["24:37:14",355,"يَخَافُونَ","They fear","ٱلصَّلَوٰةِ وَإِيتَآءِ ٱلزَّكَوٰةِ ۙ","يَوْمًۭا تَتَقَلَّبُ فِيهِ",136],["24:50:7",356,"يَخَافُونَ","they fear","أَمِ ٱرْتَابُوٓا۟ أَمْ","أَن يَحِيفَ ٱللَّهُ",136],["24:55:25",357,"خَوْفِهِمْ","their fear","وَلَيُبَدِّلَنَّهُم مِّنۢ بَعْدِ","أَمْنًۭا ۚ يَعْبُدُونَنِى لَا",418],["26:12:4",367,"أَخَافُ","[I] fear","قَالَ رَبِّ إِنِّىٓ","أَن يُكَذِّبُونِ",136],["26:14:4",367,"فَأَخَافُ","so I fear","وَلَهُمْ عَلَىَّ ذَنۢبٌۭ","أَن يَقْتُلُونِ",136],["26:21:4",368,"خِفْتُكُمْ","I feared you","فَفَرَرْتُ مِنكُمْ لَمَّا","فَوَهَبَ لِى رَبِّى",136],["26:135:2",372,"أَخَافُ","[I] fear","إِنِّىٓ","عَلَيْكُمْ عَذَابَ يَوْمٍ",136],["27:10:14",377,"تَخَفْ","fear","يُعَقِّبْ ۚ يَـٰمُوسَىٰ لَا","إِنِّى لَا يَخَافُ",136],["27:10:17",377,"يَخَافُ","fear","تَخَفْ إِنِّى لَا","لَدَىَّ ٱلْمُرْسَلُونَ",136],["28:7:8",386,"خِفْتِ","you