40:30:6",470,"أَخَافُ","[I] fear","ءَامَنَ يَـٰقَوْمِ إِنِّىٓ","عَلَيْكُم مِّثْلَ يَوْمِ",136],["40:32:3",470,"أَخَافُ","[I] fear","وَيَـٰقَوْمِ إِنِّىٓ","عَلَيْكُمْ يَوْمَ ٱلتَّنَادِ",136],["41:30:12",480,"تَخَافُوا۟","fear","عَلَيْهِمُ ٱلْمَلَـٰٓئِكَةُ أَلَّا","وَلَا تَحْزَنُوا۟ وَأَبْشِرُوا۟",136],["43:68:3",494,"خَوْفٌ","fear","يَـٰعِبَادِ لَا","عَلَيْكُمُ ٱلْيَوْمَ وَلَآ",418],["46:13:9",503,"خَوْفٌ","fear","ثُمَّ ٱسْتَقَـٰمُوا۟ فَلَا","عَلَيْهِمْ وَلَا هُمْ",418],["46:21:21",505,"أَخَافُ","[I] fear","إِلَّا ٱللَّهَ إِنِّىٓ","عَلَيْكُمْ عَذَابَ يَوْمٍ",136],["48:27:18",514,"تَخَافُونَ ۖ","fearing","رُءُوسَكُمْ وَمُقَصِّرِينَ لَا","فَعَلِمَ مَا لَمْ",136],["50:45:12",520,"يَخَافُ","fears","فَذَكِّرْ بِٱلْقُرْءَانِ مَن","وَعِيدِ",136],["51:28:3",521,"خِيفَةًۭ ۖ","a fear","فَأَوْجَسَ مِنْهُمْ","قَالُوا۟ لَا تَخَفْ ۖ",1249],["51:28:6",521,"تَخَفْ ۖ","fear","خِيفَةًۭ ۖ قَالُوا۟ لَا","وَبَشَّرُوهُ بِغُلَـٰمٍ عَلِيمٍۢ",136],["51:37:5",522,"يَخَافُونَ","fear","فِيهَآ ءَايَةًۭ لِّلَّذِينَ","ٱلْعَذَابَ ٱلْأَلِيمَ",136],["55:46:2",533,"خَافَ","fears","وَلِمَنْ","مَقَامَ رَبِّهِۦ جَنَّتَانِ",136],["59:16:14",547,"أَخَافُ","I fear","بَرِىٓءٌۭ مِّنكَ إِنِّىٓ","ٱللَّهَ رَبَّ ٱلْعَـٰلَمِينَ",136],["72:13:11",572,"يَخَافُ","he will fear","يُؤْمِنۢ بِرَبِّهِۦ فَلَا","بَخْسًۭا وَلَا رَهَقًۭا",136],["74:53:4",577,"يَخَافُونَ","they fear","كَلَّا ۖ بَل لَّا","ٱلْـَٔاخِرَةَ",136],["76:7:3",579,"وَيَخَافُونَ","and fear","يُوفُونَ بِٱلنَّذْرِ","يَوْمًۭا كَانَ شَرُّهُۥ",136],["76:10:2",579,"نَخَافُ","fear","إِنَّا","مِن رَّبِّنَا يَوْمًا",136],["79:40:3",584,"خَافَ","feared","وَأَمَّا مَنْ","مَقَامَ رَبِّهِۦ وَنَهَى",136],["91:15:2",595,"يَخَافُ","He fears","وَلَا","عُقْبَـٰهَا",136],["106:4:7",602,"خَوْفٍۭ","fear","جُوعٍۢ وَءَامَنَهُم مِّنْ","",418]]