[["2:87:15",13,"بِرُوحِ","(with)","مَرْيَمَ ٱلْبَيِّنَـٰتِ وَأَيَّدْنَـٰهُ","ٱلْقُدُسِ ۗ أَفَكُلَّمَا جَآءَكُمْ",496],["2:164:35",25,"ٱلرِّيَـٰحِ","(of) the winds","كُلِّ دَآبَّةٍۢ وَتَصْرِيفِ","وَٱلسَّحَابِ ٱلْمُسَخَّرِ بَيْنَ",378],["2:253:20",42,"بِرُوحِ","with Spirit","مَرْيَمَ ٱلْبَيِّنَـٰتِ وَأَيَّدْنَـٰهُ","ٱلْقُدُسِ ۗ وَلَوْ شَآءَ",496],["3:117:9",65,"رِيحٍۢ","(of) a wind","ٱلْحَيَوٰةِ ٱلدُّنْيَا كَمَثَلِ","فِيهَا صِرٌّ أَصَابَتْ",378],["4:171:24",105,"وَرُوحٌۭ","and a spirit","أَلْقَىٰهَآ إِلَىٰ مَرْيَمَ","مِّنْهُ ۖ فَـَٔامِنُوا۟ بِٱللَّهِ",496],["5:110:14",126,"بِرُوحِ","with (the) Spirit","وَٰلِدَتِكَ إِذْ أَيَّدتُّكَ","ٱلْقُدُسِ تُكَلِّمُ ٱلنَّاسَ",496],["7:57:4",157,"ٱلرِّيَـٰحَ","the winds","وَهُوَ ٱلَّذِى يُرْسِلُ","بُشْرًۢا بَيْنَ يَدَىْ",378],["8:46:8",183,"رِيحُكُمْ ۖ","your strength","تَنَـٰزَعُوا۟ فَتَفْشَلُوا۟ وَتَذْهَبَ","وَٱصْبِرُوٓا۟ ۚ إِنَّ ٱللَّهَ",378],["10:22:14",211,"بِرِيحٍۢ","with a wind","ٱلْفُلْكِ وَجَرَيْنَ بِهِم","طَيِّبَةٍۢ وَفَرِحُوا۟ بِهَا",378],["10:22:19",211,"رِيحٌ","a wind","وَفَرِحُوا۟ بِهَا جَآءَتْهَا","عَاصِفٌۭ وَجَآءَهُمُ ٱلْمَوْجُ",378],["12:87:10",246,"رَّوْحِ","(the) Mercy of Allah","وَلَا تَا۟يْـَٔسُوا۟ مِن","ٱللَّهِ ۖ إِنَّهُۥ لَا",1981],["12:87:16",246,"رَّوْحِ","(the) Mercy of Allah","لَا يَا۟يْـَٔسُ مِن","ٱللَّهِ إِلَّا ٱلْقَوْمُ",1981],["12:94:8",246,"رِيحَ","(the) smell","أَبُوهُمْ إِنِّى لَأَجِدُ","يُوسُفَ ۖ لَوْلَآ أَن",378],["14:18:9",257,"ٱلرِّيحُ","the wind","كَرَمَادٍ ٱشْتَدَّتْ بِهِ","فِى يَوْمٍ عَاصِفٍۢ ۖ",378],["15:22:2",263,"ٱلرِّيَـٰحَ","the winds","وَأَرْسَلْنَا","لَوَٰقِحَ فَأَنزَلْنَا مِنَ",378],["15:29:6",263,"رُّوحِى","My spirit","وَنَفَخْتُ فِيهِ مِن","فَقَعُوا۟ لَهُۥ سَـٰجِدِينَ",496],["16:2:3",267,"بِٱلرُّوحِ","with the inspiration","يُنَزِّلُ ٱلْمَلَـٰٓئِكَةَ","مِنْ أَمْرِهِۦ عَلَىٰ",496],["16:6:5",267,"تُرِيحُونَ","you bring them in","فِيهَا جَمَالٌ حِينَ","وَحِينَ تَسْرَحُونَ",4467],["16:102:3",278,"رُوحُ","the Holy Spirit","قُلْ نَزَّلَهُۥ","ٱلْقُدُسِ مِن رَّبِّكَ",496],["17:69:12",289,"ٱلرِّيحِ","the wind","عَلَيْكُمْ قَاصِفًۭا مِّنَ","فَيُغْرِقَكُم بِمَا كَفَرْتُمْ ۙ",378],["17:85:3",290,"ٱلرُّوحِ ۖ","the soul","وَيَسْـَٔلُونَكَ عَنِ","قُلِ ٱلرُّوحُ مِنْ",496],["17:85:5",290,"ٱلرُّوحُ","The soul","عَنِ ٱلرُّوحِ ۖ قُلِ","مِنْ أَمْرِ رَبِّى",496],["18:45:17",298,"ٱلرِّيَـٰحُ ۗ","(by) the winds","فَأَصْبَحَ هَشِيمًۭا تَذْرُوهُ","وَكَانَ ٱللَّهُ عَلَىٰ",378],["19:17:7",306,"رُوحَنَا","Our Spirit","حِجَابًۭا فَأَرْسَلْنَآ إِلَيْهَا","فَتَمَثَّلَ لَهَا بَشَرًۭا",496],["21:81:2",328,"ٱلرِّيحَ","the wind","وَلِسُلَيْمَـٰنَ","عَاصِفَةًۭ تَجْرِى بِأَمْرِهِۦٓ",378],["21:91:7",330,"رُّوحِنَا","Our Spirit","فَنَفَخْنَا فِيهَا مِن","وَجَعَلْنَـٰهَا وَٱبْنَهَآ ءَايَةًۭ",496],["22:31:18",336,"ٱلرِّيحُ","the wind","أَوْ تَهْوِى بِهِ","فِى مَكَانٍۢ سَحِيقٍۢ",378],["25:48:4",364,"ٱلرِّيَـٰحَ","the winds","وَهُوَ ٱلَّذِىٓ أَرْسَلَ","بُشْرًۢا بَيْنَ يَدَىْ",378],["26:193:3",375,"ٱلرُّوحُ","the Spirit","نَزَلَ بِهِ","ٱلْأَمِينُ",496],["27:63:9",382,"ٱلرِّيَـٰحَ","the winds","وَٱلْبَحْرِ وَمَن يُرْسِلُ","بُشْرًۢا بَيْنَ يَدَىْ",378],["30:46:5",409,"ٱلرِّيَاحَ","the winds","ءَايَـٰتِهِۦٓ أَن يُرْسِلَ","مُبَشِّرَٰتٍۢ وَلِيُذِيقَكُم مِّن",378],["30:48:4",409,"ٱلرِّيَـٰحَ","the winds","ٱللَّهُ ٱلَّذِى يُرْسِلُ","فَتُثِيرُ سَحَابًۭا فَيَبْسُطُهُۥ",378],["30:51:3",410,"رِيحًۭا","a wind","وَلَئِنْ أَرْسَلْنَا","فَرَأَوْهُ مُصْفَرًّۭا لَّظَلُّوا۟",378],["32:9:6",415,"رُّوحِهِۦ ۖ","His spirit","وَنَفَخَ فِيهِ مِن","وَجَعَلَ لَكُمُ ٱلسَّمْعَ",496],["33:9:13",419,"رِيحًۭا","a wind","جُنُودٌۭ فَأَرْسَلْنَا عَلَيْهِمْ","وَجُنُودًۭا لَّمْ تَرَوْهَا ۚ",378],["34:12:2",429,"ٱلرِّيحَ","the wind","وَلِسُلَيْمَـٰنَ","غُدُوُّهَا شَهْرٌۭ وَرَوَاحُهَا",378],["34:12:5",429,"وَرَوَاحُهَا","and its afternoon course","ٱلرِّيحَ غُدُوُّهَا شَهْرٌۭ","شَهْرٌۭ ۖ وَأَسَلْنَا لَهُۥ",4181],["35:9:4",435,"ٱلرِّيَـٰحَ","the winds","وَٱللَّهُ ٱلَّذِىٓ أَرْسَلَ","فَتُثِيرُ سَحَابًۭا فَسُقْنَـٰهُ",378],["38:36:3",455,"ٱلرِّيحَ","the wind","فَسَخَّرْنَا لَهُ","تَجْرِى بِأَمْرِهِۦ رُخَآءً",378],["38:72:6",457,"رُّوحِى","My spirit","وَنَفَخْتُ فِيهِ مِن","فَقَعُوا۟ لَهُۥ سَـٰجِدِينَ",496],["40:15:6",468,"ٱلرُّوحَ","the inspiration","ذُو ٱلْعَرْشِ يُلْقِى","مِنْ أَمْرِهِۦ عَلَىٰ",496],["41:16:3",478,"رِيحًۭا","a wind","فَأَرْسَلْنَا عَلَيْهِمْ","صَرْصَرًۭا فِىٓ أَيَّامٍۢ",378],["42:33:4",487,"ٱلرِّيحَ","He can cause the wind to become still","إِن يَشَأْ يُسْكِنِ","فَيَظْلَلْنَ رَوَاكِدَ عَلَىٰ",378],["42:52:4",489,"رُوحًۭا","an inspiration","وَكَذَٰلِكَ أَوْحَيْنَآ إِلَيْكَ","مِّنْ أَمْرِنَا ۚ مَا",496],["45:5:17",499,"ٱلرِّيَـٰحِ","(the) winds","بَعْدَ مَوْتِهَا وَتَصْرِيفِ","ءَايَـٰتٌۭ لِّقَوْمٍۢ يَعْقِلُونَ",378],["46:24:15",505,"رِيحٌۭ","a wind","مَا ٱسْتَعْجَلْتُم بِهِۦ ۖ","فِيهَا عَذَابٌ أَلِيمٌۭ",378],["51:41:6",522,"ٱلرِّيحَ","the wind","إِذْ أَرْسَلْنَا عَلَيْهِمُ","ٱلْعَقِيمَ",378],["54:19:4",529,"رِيحًۭا","a wind","إِنَّآ أَرْسَلْنَا عَلَيْهِمْ","صَرْصَرًۭا فِى يَوْمِ",378],["55:12:4",531,"وَٱلرَّيْحَانُ","and scented plants","وَٱلْحَبُّ ذُو ٱلْعَصْفِ","",2614],["56:89:1",537,"فَرَوْحٌۭ","Then rest","","وَرَيْحَانٌۭ وَجَنَّتُ نَعِيمٍۢ",1981],["56:89:2",537,"وَرَيْحَانٌۭ","and bounty","فَرَوْحٌۭ","وَجَنَّتُ نَعِيمٍۢ",2614],["58:22:28",545,"بِرُوحٍۢ","with a spirit","قُلُوبِهِمُ ٱلْإِيمَـٰنَ وَأَيَّدَهُم","مِّنْهُ ۖ وَيُدْخِلُهُمْ جَنَّـٰتٍۢ",496],["66:12:10",561,"رُّوحِنَا","Our Spirit","فَنَفَخْنَا فِيهِ مِن","وَصَدَّقَتْ بِكَلِمَـٰتِ رَبِّهَا",496],["69:6:4",566,"بِرِيحٍۢ","by a wind","وَأَمَّا عَادٌۭ فَأُهْلِكُوا۟","صَرْصَرٍ عَاتِيَةٍۢ",378],["70:4:3",568,"وَٱلرُّوحُ","and the Spirit","تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ","إِلَيْهِ فِى يَوْمٍۢ",496],["78:38:3",583,"ٱلرُّوحُ","the Spirit","يَوْمَ يَقُومُ","وَٱلْمَلَـٰٓئِكَةُ صَفًّۭا ۖ لَّا",496],["97:4:3",598,"وَٱلرُّوحُ","and the Spirit","تَنَزَّلُ ٱلْمَلَـٰٓئِكَةُ","فِيهَا بِإِذْنِ رَبِّهِم",496]]