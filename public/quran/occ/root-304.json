[["2:178:6",27,"ٱلْقِصَاصُ","(is) the legal retribution","ءَامَنُوا۟ كُتِبَ عَلَيْكُمُ","فِى ٱلْقَتْلَى ۖ ٱلْحُرُّ",1621],["2:179:3",27,"ٱلْقِصَاصِ","the legal retribution","وَلَكُمْ فِى","حَيَوٰةٌۭ يَـٰٓأُو۟لِى ٱلْأَلْبَـٰبِ",1621],["2:194:6",30,"قِصَاصٌۭ ۚ","(is) legal retribution","بِٱلشَّهْرِ ٱلْحَرَامِ وَٱلْحُرُمَـٰتُ","فَمَنِ ٱعْتَدَىٰ عَلَيْكُمْ",1621],["3:62:4",58,"ٱلْقَصَصُ","the narration","إِنَّ هَـٰذَا لَهُوَ","ٱلْحَقُّ ۚ وَمَا مِنْ",1216],["4:164:3",104,"قَصَصْنَـٰهُمْ","We (have) mentioned them","وَرُسُلًۭا قَدْ","عَلَيْكَ مِن قَبْلُ",517],["4:164:9",104,"نَقْصُصْهُمْ","We (have) mentioned them","قَبْلُ وَرُسُلًۭا لَّمْ","عَلَيْكَ ۚ وَكَلَّمَ ٱللَّهُ",517],["5:45:16",115,"قِصَاصٌۭ ۚ","(is) retribution","وَٱلسِّنَّ بِٱلسِّنِّ وَٱلْجُرُوحَ","فَمَن تَصَدَّقَ بِهِۦ",1621],["6:57:18",134,"يَقُصُّ","He relates","ٱلْحُكْمُ إِلَّا لِلَّهِ ۖ","ٱلْحَقَّ ۖ وَهُوَ خَيْرُ",517],["6:130:8",144,"يَقُصُّونَ","relating","يَأْتِكُمْ رُسُلٌۭ مِّنكُمْ","عَلَيْكُمْ ءَايَـٰتِى وَيُنذِرُونَكُمْ",517],["7:7:1",151,"فَلَنَقُصَّنَّ","Then surely We will narrate","","عَلَيْهِم بِعِلْمٍۢ ۖ وَمَا",517],["7:35:7",154,"يَقُصُّونَ","relating","يَأْتِيَنَّكُمْ رُسُلٌۭ مِّنكُمْ","عَلَيْكُمْ ءَايَـٰتِى ۙ فَمَنِ",517],["7:101:3",163,"نَقُصُّ","We relate","تِلْكَ ٱلْقُرَىٰ","عَلَيْكَ مِنْ أَنۢبَآئِهَا ۚ",517],["7:176:27",173,"فَٱقْصُصِ","So relate","ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا ۚ","ٱلْقَصَصَ لَعَلَّهُمْ يَتَفَكَّرُونَ",517],["7:176:28",173,"ٱلْقَصَصَ","the story","كَذَّبُوا۟ بِـَٔايَـٰتِنَا ۚ فَٱقْصُصِ","لَعَلَّهُمْ يَتَفَكَّرُونَ",1216],["11:100:5",233,"نَقُصُّهُۥ","(which) We relate","مِنْ أَنۢبَآءِ ٱلْقُرَىٰ","عَلَيْكَ ۖ مِنْهَا قَآئِمٌۭ",517],["11:120:2",235,"نَّقُصُّ","We relate","وَكُلًّۭا","عَلَيْكَ مِنْ أَنۢبَآءِ",517],["12:3:2",235,"نَقُصُّ","relate","نَحْنُ","عَلَيْكَ أَحْسَنَ ٱلْقَصَصِ",517],["12:3:5",235,"ٱلْقَصَصِ","of the narrations","نَقُصُّ عَلَيْكَ أَحْسَنَ","بِمَآ أَوْحَيْنَآ إِلَيْكَ",1216],["12:5:4",236,"تَقْصُصْ","relate","قَالَ يَـٰبُنَىَّ لَا","رُءْيَاكَ عَلَىٰٓ إِخْوَتِكَ",517],["12:111:4",248,"قَصَصِهِمْ","their stories","لَقَدْ كَانَ فِى","عِبْرَةٌۭ لِّأُو۟لِى ٱلْأَلْبَـٰبِ ۗ",1216],["16:118:6",280,"قَصَصْنَا","We related","هَادُوا۟ حَرَّمْنَا مَا","عَلَيْكَ مِن قَبْلُ ۖ",517],["18:13:2",294,"نَقُصُّ","narrate","نَّحْنُ","عَلَيْكَ نَبَأَهُم بِٱلْحَقِّ ۚ",517],["18:64:9",301,"قَصَصًۭا","retracing","فَٱرْتَدَّا عَلَىٰٓ ءَاثَارِهِمَا","",1216],["20:99:2",319,"نَقُصُّ","We relate","كَذَٰلِكَ","عَلَيْكَ مِنْ أَنۢبَآءِ",517],["27:76:4",383,"يَقُصُّ","relates","إِنَّ هَـٰذَا ٱلْقُرْءَانَ","عَلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ",517],["28:11:3",386,"قُصِّيهِ ۖ","Follow him","وَقَالَتْ لِأُخْتِهِۦ","فَبَصُرَتْ بِهِۦ عَن",517],["28:25:17",388,"وَقَصَّ","and narrated","لَنَا ۚ فَلَمَّا جَآءَهُۥ","عَلَيْهِ ٱلْقَصَصَ قَالَ",517],["28:25:19",388,"ٱلْقَصَصَ","the story","جَآءَهُۥ وَقَصَّ عَلَيْهِ","قَالَ لَا تَخَفْ ۖ",1216],["40:78:8",476,"قَصَصْنَا","We have related","قَبْلِكَ مِنْهُم مَّن","عَلَيْكَ وَمِنْهُم مَّن",517],["40:78:13",476,"نَقْصُصْ","We have related","وَمِنْهُم مَّن لَّمْ","عَلَيْكَ ۗ وَمَا كَانَ",517]]