[["2:120:9",19,"مِلَّتَهُمْ ۗ","their religion","ٱلنَّصَـٰرَىٰ حَتَّىٰ تَتَّبِعَ","قُلْ إِنَّ هُدَى",632],["2:130:4",20,"مِّلَّةِ","(the) religion","وَمَن يَرْغَبُ عَن","إِبْرَٰهِـۧمَ إِلَّا مَن",632],["2:135:9",21,"مِلَّةَ","(the) religion","تَهْتَدُوا۟ ۗ قُلْ بَلْ","إِبْرَٰهِـۧمَ حَنِيفًۭا ۖ وَمَا",632],["2:282:24",48,"وَلْيُمْلِلِ","and let dictate","عَلَّمَهُ ٱللَّهُ ۚ فَلْيَكْتُبْ","ٱلَّذِى عَلَيْهِ ٱلْحَقُّ",2081],["2:282:47",48,"يُمِلَّ","(can) dictate","لَا يَسْتَطِيعُ أَن","هُوَ فَلْيُمْلِلْ وَلِيُّهُۥ",2081],["2:282:49",48,"فَلْيُمْلِلْ","then let dictate","أَن يُمِلَّ هُوَ","وَلِيُّهُۥ بِٱلْعَدْلِ ۚ وَٱسْتَشْهِدُوا۟",2081],["3:95:5",62,"مِلَّةَ","(the) religion","صَدَقَ ٱللَّهُ ۗ فَٱتَّبِعُوا۟","إِبْرَٰهِيمَ حَنِيفًۭا وَمَا",632],["4:125:11",98,"مِلَّةَ","(the) religion","وَهُوَ مُحْسِنٌۭ وَٱتَّبَعَ","إِبْرَٰهِيمَ حَنِيفًۭا ۗ وَٱتَّخَذَ",632],["6:161:10",150,"مِّلَّةَ","religion","مُّسْتَقِيمٍۢ دِينًۭا قِيَمًۭا","إِبْرَٰهِيمَ حَنِيفًۭا ۚ وَمَا",632],["7:88:17",162,"مِلَّتِنَا ۚ","our religion","أَوْ لَتَعُودُنَّ فِى","قَالَ أَوَلَوْ كُنَّا",632],["7:89:9",162,"مِلَّتِكُم","your religion","إِنْ عُدْنَا فِى","بَعْدَ إِذْ نَجَّىٰنَا",632],["12:37:18",239,"مِلَّةَ","(the) religion","رَبِّىٓ ۚ إِنِّى تَرَكْتُ","قَوْمٍۢ لَّا يُؤْمِنُونَ",632],["12:38:2",240,"مِلَّةَ","(the) religion","وَٱتَّبَعْتُ","ءَابَآءِىٓ إِبْرَٰهِيمَ وَإِسْحَـٰقَ",632],["14:13:11",257,"مِلَّتِنَا ۖ","our religion","أَوْ لَتَعُودُنَّ فِى","فَأَوْحَىٰٓ إِلَيْهِمْ رَبُّهُمْ",632],["16:123:6",281,"مِلَّةَ","(the) religion","إِلَيْكَ أَنِ ٱتَّبِعْ","إِبْرَٰهِيمَ حَنِيفًۭا ۖ وَمَا",632],["18:20:9",295,"مِلَّتِهِمْ","their religion","أَوْ يُعِيدُوكُمْ فِى","وَلَن تُفْلِحُوٓا۟ إِذًا",632],["22:78:15",341,"مِّلَّةَ","(The) religion","ٱلدِّينِ مِنْ حَرَجٍۢ ۚ","أَبِيكُمْ إِبْرَٰهِيمَ ۚ هُوَ",632],["38:7:5",453,"ٱلْمِلَّةِ","the religion","سَمِعْنَا بِهَـٰذَا فِى","ٱلْـَٔاخِرَةِ إِنْ هَـٰذَآ",632]]