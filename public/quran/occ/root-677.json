[["10:22:22",211,"ٱلْمَوْجُ","the waves","رِيحٌ عَاصِفٌۭ وَجَآءَهُمُ","مِن كُلِّ مَكَانٍۢ",1199],["11:42:5",226,"مَوْجٍۢ","the waves","تَجْرِى بِهِمْ فِى","كَٱلْجِبَالِ وَنَادَىٰ نُوحٌ",1199],["11:43:20",226,"ٱلْمَوْجُ","the waves","رَّحِمَ ۚ وَحَالَ بَيْنَهُمَا","فَكَانَ مِنَ ٱلْمُغْرَقِينَ",1199],["18:99:4",304,"يَمُوجُ","to surge","۞ وَتَرَكْنَا بَعْضَهُمْ يَوْمَئِذٍۢ","فِى بَعْضٍۢ ۖ وَنُفِخَ",4645],["24:40:7",355,"مَوْجٌۭ","a wave","بَحْرٍۢ لُّجِّىٍّۢ يَغْشَىٰهُ","مِّن فَوْقِهِۦ مَوْجٌۭ",1199],["24:40:10",355,"مَوْجٌۭ","a wave","مَوْجٌۭ مِّن فَوْقِهِۦ","مِّن فَوْقِهِۦ سَحَابٌۭ ۚ",1199],["31:32:3",414,"مَّوْجٌۭ","a wave","وَإِذَا غَشِيَهُم","كَٱلظُّلَلِ دَعَوُا۟ ٱللَّهَ",1199]]