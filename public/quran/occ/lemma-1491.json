[["3:119:2",65,"أُو۟لَآءِ","those","هَـٰٓأَنتُمْ","تُحِبُّونَهُمْ وَلَا يُحِبُّونَكُمْ",1491],["4:91:27",92,"وَأُو۟لَـٰٓئِكُمْ","And those","وَٱقْتُلُوهُمْ حَيْثُ ثَقِفْتُمُوهُمْ ۚ","جَعَلْنَا لَكُمْ عَلَيْهِمْ",1491],["20:84:3",317,"أُو۟لَآءِ","(are) close","قَالَ هُمْ","عَلَىٰٓ أَثَرِى وَعَجِلْتُ",1491],["54:43:4",530,"أُو۟لَـٰٓئِكُمْ","those","أَكُفَّارُكُمْ خَيْرٌۭ مِّنْ","أَمْ لَكُم بَرَآءَةٌۭ",1491]]