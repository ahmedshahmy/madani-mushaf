[["2:206:12",32,"ٱلْمِهَادُ","[the] resting-place","فَحَسْبُهُۥ جَهَنَّمُ ۚ وَلَبِئْسَ","",1085],["3:12:9",51,"ٱلْمِهَادُ","[the] resting place","إِلَىٰ جَهَنَّمَ ۚ وَبِئْسَ","",1085],["3:46:4",56,"ٱلْمَهْدِ","the cradle","وَيُكَلِّمُ ٱلنَّاسَ فِى","وَكَهْلًۭا وَمِنَ ٱلصَّـٰلِحِينَ",1353],["3:197:7",76,"ٱلْمِهَادُ","[the] resting place","مَأْوَىٰهُمْ جَهَنَّمُ ۚ وَبِئْسَ","",1085],["5:110:19",126,"ٱلْمَهْدِ","the cradle","تُكَلِّمُ ٱلنَّاسَ فِى","وَكَهْلًۭا ۖ وَإِذْ عَلَّمْتُكَ",1353],["7:41:4",155,"مِهَادٌۭ","(is) a bed","لَهُم مِّن جَهَنَّمَ","وَمِن فَوْقِهِمْ غَوَاشٍۢ ۚ",1085],["13:18:27",251,"ٱلْمِهَادُ","(is) the resting place","وَمَأْوَىٰهُمْ جَهَنَّمُ ۖ وَبِئْسَ","",1085],["19:29:9",307,"ٱلْمَهْدِ","the cradle","مَن كَانَ فِى","صَبِيًّۭا",1353],["20:53:5",315,"مَهْدًۭا","(as) a bed","جَعَلَ لَكُمُ ٱلْأَرْضَ","وَسَلَكَ لَكُمْ فِيهَا",1353],["30:44:9",409,"يَمْهَدُونَ","they are preparing","عَمِلَ صَـٰلِحًۭا فَلِأَنفُسِهِمْ","",4644],["38:56:4",456,"ٱلْمِهَادُ","the resting place","جَهَنَّمَ يَصْلَوْنَهَا فَبِئْسَ","",1085],["43:10:5",489,"مَهْدًۭا","a bed","جَعَلَ لَكُمُ ٱلْأَرْضَ","وَجَعَلَ لَكُمْ فِيهَا",1353],["51:48:4",522,"ٱلْمَـٰهِدُونَ","(are) the Spreaders","وَٱلْأَرْضَ فَرَشْنَـٰهَا فَنِعْمَ","",3650],["74:14:1",575,"وَمَهَّدتُّ","And I spread","","لَهُۥ تَمْهِيدًۭا",3668],["74:14:3",575,"تَمْهِيدًۭا","ease","وَمَهَّدتُّ لَهُۥ","",4393],["78:6:4",582,"مِهَـٰدًۭا","a resting place","أَلَمْ نَجْعَلِ ٱلْأَرْضَ","",1085]]