[["2:173:6",26,"وَلَحْمَ","and flesh","عَلَيْكُمُ ٱلْمَيْتَةَ وَٱلدَّمَ","ٱلْخِنزِيرِ وَمَآ أُهِلَّ",732],["2:259:56",43,"لَحْمًۭا ۚ","(with) flesh","نُنشِزُهَا ثُمَّ نَكْسُوهَا","فَلَمَّا تَبَيَّنَ لَهُۥ",732],["5:3:5",107,"وَلَحْمُ","and flesh","عَلَيْكُمُ ٱلْمَيْتَةُ وَٱلدَّمُ","ٱلْخِنزِيرِ وَمَآ أُهِلَّ",732],["6:145:20",147,"لَحْمَ","(the) flesh","دَمًۭا مَّسْفُوحًا أَوْ","خِنزِيرٍۢ فَإِنَّهُۥ رِجْسٌ",732],["16:14:7",268,"لَحْمًۭا","meat","ٱلْبَحْرَ لِتَأْكُلُوا۟ مِنْهُ","طَرِيًّۭا وَتَسْتَخْرِجُوا۟ مِنْهُ",732],["16:115:6",280,"وَلَحْمَ","and the flesh","عَلَيْكُمُ ٱلْمَيْتَةَ وَٱلدَّمَ","ٱلْخِنزِيرِ وَمَآ أُهِلَّ",732],["22:37:4",336,"لُحُومُهَا","their meat","لَن يَنَالَ ٱللَّهَ","وَلَا دِمَآؤُهَا وَلَـٰكِن",732],["23:14:13",342,"لَحْمًۭا","(with) flesh","عِظَـٰمًۭا فَكَسَوْنَا ٱلْعِظَـٰمَ","ثُمَّ أَنشَأْنَـٰهُ خَلْقًا",732],["35:12:15",436,"لَحْمًۭا","meat","وَمِن كُلٍّۢ تَأْكُلُونَ","طَرِيًّۭا وَتَسْتَخْرِجُونَ حِلْيَةًۭ",732],["49:12:22",517,"لَحْمَ","(the) flesh","أَحَدُكُمْ أَن يَأْكُلَ","أَخِيهِ مَيْتًۭا فَكَرِهْتُمُوهُ ۚ",732],["52:22:3",524,"وَلَحْمٍۢ","and meat","وَأَمْدَدْنَـٰهُم بِفَـٰكِهَةٍۢ","مِّمَّا يَشْتَهُونَ",732],["56:21:1",535,"وَلَحْمِ","And (the) flesh","","طَيْرٍۢ مِّمَّا يَشْتَهُونَ",732]]