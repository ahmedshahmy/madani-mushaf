[["2:7:8",3,"أَبْصَـٰرِهِمْ","their vision","وَعَلَىٰ سَمْعِهِمْ ۖ وَعَلَىٰٓ","غِشَـٰوَةٌۭ ۖ وَلَهُمْ عَذَابٌ",247],["2:17:17",4,"يُبْصِرُونَ","(do) they see","فِى ظُلُمَـٰتٍۢ لَّا","",370],["2:20:4",4,"أَبْصَـٰرَهُمْ ۖ","their sight","يَكَادُ ٱلْبَرْقُ يَخْطَفُ","كُلَّمَآ أَضَآءَ لَهُم",247],["2:20:19",4,"وَأَبْصَـٰرِهِمْ ۚ","and their sight","ٱللَّهُ لَذَهَبَ بِسَمْعِهِمْ","إِنَّ ٱللَّهَ عَلَىٰ",247],["2:96:23",15,"بَصِيرٌۢ","(is) All-Seer","أَن يُعَمَّرَ ۗ وَٱللَّهُ","بِمَا يَعْمَلُونَ",232],["2:110:17",17,"بَصِيرٌۭ","(is) All-Seer","ٱللَّهَ بِمَا تَعْمَلُونَ","",232],["2:233:64",37,"بَصِيرٌۭ","(is) All-Seer","ٱللَّهَ بِمَا تَعْمَلُونَ","",232],["2:237:35",38,"بَصِيرٌ","(is) All-Seer","ٱللَّهَ بِمَا تَعْمَلُونَ","",232],["2:265:27",45,"بَصِيرٌ","(is) All-Seer","وَٱللَّهُ بِمَا تَعْمَلُونَ","",232],["3:13:29",51,"ٱلْأَبْصَـٰرِ","(of) vision","ذَٰلِكَ لَعِبْرَةًۭ لِّأُو۟لِى","",247],["3:15:23",51,"بَصِيرٌۢ","(is) All-Seer","مِّنَ ٱللَّهِ ۗ وَٱللَّهُ","بِٱلْعِبَادِ",232],["3:20:25",52,"بَصِيرٌۢ","(is) All-Seer","عَلَيْكَ ٱلْبَلَـٰغُ ۗ وَٱللَّهُ","بِٱلْعِبَادِ",232],["3:156:36",70,"بَصِيرٌۭ","(is) All-Seer","وَٱللَّهُ بِمَا تَعْمَلُونَ","",232],["3:163:6",71,"بَصِيرٌۢ","(is) All-Seer","عِندَ ٱللَّهِ ۗ وَٱللَّهُ","بِمَا يَعْمَلُونَ",232],["4:58:25",87,"بَصِيرًۭا","All-Seeing","ٱللَّهَ كَانَ سَمِيعًۢا","",232],["4:134:14",99,"بَصِيرًۭا","All-Seeing","وَكَانَ ٱللَّهُ سَمِيعًۢا","",232],["5:71:17",120,"بَصِيرٌۢ","(is) All-Seer","كَثِيرٌۭ مِّنْهُمْ ۚ وَٱللَّهُ","بِمَا يَعْمَلُونَ",232],["6:46:7",133,"وَأَبْصَـٰرَكُمْ","and your sight","أَخَذَ ٱللَّهُ سَمْعَكُمْ","وَخَتَمَ عَلَىٰ قُلُوبِكُم",247],["6:50:26",133,"وَٱلْبَصِيرُ ۚ","and the seeing one","هَلْ يَسْتَوِى ٱلْأَعْمَىٰ","أَفَلَا تَتَفَكَّرُونَ",232],["6:103:3",141,"ٱلْأَبْصَـٰرُ","the visions","لَّا تُدْرِكُهُ","وَهُوَ يُدْرِكُ ٱلْأَبْصَـٰرَ ۖ",247],["6:103:6",141,"ٱلْأَبْصَـٰرَ ۖ","(all) the vision","ٱلْأَبْصَـٰرُ وَهُوَ يُدْرِكُ","وَهُوَ ٱللَّطِيفُ ٱلْخَبِيرُ",247],["6:104:3",141,"بَصَآئِرُ","enlightenment","قَ