[["2:85:20",13,"مُحَرَّمٌ","(was) forbidden","أُسَـٰرَىٰ تُفَـٰدُوهُمْ وَهُوَ","عَلَيْكُمْ إِخْرَاجُهُمْ ۚ أَفَتُؤْمِنُونَ",1588],["2:144:14",22,"ٱلْحَرَامِ ۚ","Al-Haraam","وَجْهَكَ شَطْرَ ٱلْمَسْجِدِ","وَحَيْثُ مَا كُنتُمْ",343],["2:149:8",23,"ٱلْحَرَامِ ۖ","Al-Haraam","وَجْهَكَ شَطْرَ ٱلْمَسْجِدِ","وَإِنَّهُۥ لَلْحَقُّ مِن",343],["2:150:8",23,"ٱلْحَرَامِ ۚ","Al-Haraam","وَجْهَكَ شَطْرَ ٱلْمَسْجِدِ","وَحَيْثُ مَا كُنتُمْ",343],["2:173:2",26,"حَرَّمَ","He has forbidden","إِنَّمَا","عَلَيْكُمُ ٱلْمَيْتَةَ وَٱلدَّمَ",300],["2:191:16",30,"ٱلْحَرَامِ","Al-Haraam","تُقَـٰتِلُوهُمْ عِندَ ٱلْمَسْجِدِ","حَتَّىٰ يُقَـٰتِلُوكُمْ فِيهِ ۖ",343],["2:194:2",30,"ٱلْحَرَامُ","[the] sacred","ٱلشَّهْرُ","بِٱلشَّهْرِ ٱلْحَرَامِ وَٱلْحُرُمَـٰتُ",343],["2:194:4",30,"ٱلْحَرَامِ","[the] sacred","ٱلشَّهْرُ ٱلْحَرَامُ بِٱلشَّهْرِ","وَٱلْحُرُمَـٰتُ قِصَاصٌۭ ۚ فَمَنِ",343],["2:194:5",30,"وَٱلْحُرُمَـٰتُ","and for all the violations","ٱلْحَرَامُ بِٱلشَّهْرِ ٱلْحَرَامِ","قِصَاصٌۭ ۚ فَمَنِ ٱعْتَدَىٰ",2282],["2:196:66",30,"ٱلْحَرَامِ ۚ","Al-Haraam","أَهْلُهُۥ حَاضِرِى ٱلْمَسْجِدِ","وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟",343],["2:198:17",31,"ٱلْحَرَامِ ۖ","[the] Sacred","ٱللَّهَ عِندَ ٱلْمَشْعَرِ","وَٱذْكُرُوهُ كَمَا هَدَىٰكُمْ",343],["2:217:4",34,"ٱلْحَرَامِ","[the] sacred","يَسْـَٔلُونَكَ عَنِ ٱلشَّهْرِ","قِتَالٍۢ فِيهِ ۖ قُلْ",343],["2:217:18",34,"ٱلْحَرَامِ","Al-Haraam","وَكُفْرٌۢ بِهِۦ وَٱلْمَسْجِدِ","وَإِخْرَاجُ أَهْلِهِۦ مِنْهُ",343],["2:275:24",47,"وَحَرَّمَ","but (has) forbidden","وَأَحَلَّ ٱللَّهُ ٱلْبَيْعَ","ٱلرِّبَوٰا۟ ۚ فَمَن جَآءَهُۥ",300],["3:50:11",56,"حُرِّمَ","was forbidden","لَكُم بَعْضَ ٱلَّذِى","عَلَيْكُمْ ۚ وَجِئْتُكُم بِـَٔايَةٍۢ",300],["3:93:9",62,"حَرَّمَ","made unlawful","إِسْرَٰٓءِيلَ إِلَّا مَا","إِسْرَٰٓءِيلُ عَلَىٰ نَفْسِهِۦ",300],["4:23:1",81,"حُرِّمَتْ","Forbidden","","عَلَيْكُمْ أُمَّهَـٰتُكُمْ وَبَنَاتُكُمْ",300],["4:160:5",103,"حَرَّمْنَا","We made unlawful","مِّنَ ٱلَّذِينَ هَادُوا۟","عَلَيْهِمْ طَيِّبَـٰتٍ أُحِلَّتْ",300],["5:1:18",106,"حُرُمٌ ۗ","(are in) Ihram","مُحِلِّى ٱلصَّيْدِ وَأَنتُمْ","إِنَّ ٱللَّهَ يَحْكُمُ",343],["5:2:10",106,"ٱلْحَرَامَ","the sacred","ٱللَّهِ وَلَا ٱلشَّهْرَ","وَلَا ٱلْهَدْىَ وَلَا",343],["5:2:18",106,"ٱلْحَرَامَ","the Sacred","وَلَآ ءَآمِّينَ ٱلْبَيْتَ","يَبْتَغُونَ فَضْلًۭا مِّن",343],["5:2:35",106,"ٱلْحَرَامِ","Al-Haraam","صَدُّوكُمْ عَنِ ٱلْمَسْجِدِ","أَن تَعْتَدُوا۟ ۘ وَتَعَاوَنُوا۟",343],["5:3:1",107,"حُرِّمَتْ","Are made unlawful","","عَلَيْكُمُ ٱلْمَيْتَةُ وَٱلدَّمُ",300],["5:26:3",112,"مُحَرَّمَةٌ","(will be) forbidden","قَالَ فَإِنَّهَا","عَلَيْهِمْ ۛ أَرْبَعِينَ سَنَةًۭ ۛ",3767],["5:72:24",120,"حَرَّمَ","(has) forbidden","يُشْرِكْ بِٱللَّهِ فَقَدْ","ٱللَّهُ عَلَيْهِ ٱلْجَنَّةَ",300],["5:87:5",122,"تُحَرِّمُوا۟","make unlawful","ٱلَّذِينَ ءَامَنُوا۟ لَا","طَيِّبَـٰتِ مَآ أَحَلَّ",300],["5:95:8",123,"حُرُمٌۭ ۚ","(are in) Ihram","تَقْتُلُوا۟ ٱلصَّيْدَ وَأَنتُمْ","وَمَن قَتَلَهُۥ مِنكُم",343],["5:96:9",124,"وَحُرِّمَ","and is made unlawful","مَتَـٰعًۭا لَّكُمْ وَلِلسَّيَّارَةِ ۖ","عَلَيْكُمْ صَيْدُ ٱلْبَرِّ",300],["5:96:15",124,"حُرُمًۭا ۗ","(are in) Ihram","ٱلْبَرِّ مَا دُمْتُمْ","وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ",343],["5:97:5",124,"ٱلْحَرَامَ","the Sacred","ٱللَّهُ ٱلْكَعْبَةَ ٱلْبَيْتَ","قِيَـٰمًۭا لِّلنَّاسِ وَٱلشَّهْرَ",343],["5:97:9",124,"ٱلْحَرَامَ","[the] sacred","قِيَـٰمًۭا لِّلنَّاسِ وَٱلشَّهْرَ","وَٱلْهَدْىَ وَٱلْقَلَـٰٓئِدَ ۚ ذَٰلِكَ",343],["6:119:14",143,"حَرَّمَ","He (has) forbidden","فَصَّلَ لَكُم مَّا","عَلَيْكُمْ إِلَّا مَا",300],["6:138:13",146,"حُرِّمَتْ","forbidden","نَّشَآءُ بِزَعْمِهِمْ وَأَنْعَـٰمٌ","ظُهُورُهَا وَأَنْعَـٰمٌۭ لَّا",300],["6:139:9",146,"وَمُحَرَّمٌ","and forbidden","ٱلْأَنْعَـٰمِ خَالِصَةٌۭ لِّذُكُورِنَا","عَلَىٰٓ أَزْوَٰجِنَا ۖ وَإِن",1588],["6:140:9",146,"وَحَرَّمُوا۟","and forbid","سَفَهًۢا بِغَيْرِ عِلْمٍۢ","مَا رَزَقَهُمُ ٱللَّهُ",300],["6:143:11",147,"حَرَّمَ","He has forbidden","ٱثْنَيْنِ ۗ قُلْ ءَآلذَّكَرَيْنِ","أَمِ ٱلْأُنثَيَيْنِ أَمَّا",300],["6:144:9",147,"حَرَّمَ","He (has) forbidden","ٱثْنَيْنِ ۗ قُلْ ءَآلذَّكَرَيْنِ","أَمِ ٱلْأُنثَيَيْنِ أَمَّا",300],["6:145:8",147,"مُحَرَّمًا","(anything) forbidden","مَآ أُوحِىَ إِلَىَّ","عَلَىٰ طَاعِمٍۢ يَطْعَمُهُۥٓ",1588],["6:146:4",147,"حَرَّمْنَا","We forbade","وَعَلَى ٱلَّذِينَ هَادُوا۟","كُلَّ ذِى ظُفُرٍۢ ۖ",300],["6:146:11",147,"حَرَّمْنَا","We forbade","وَمِنَ ٱلْبَقَرِ وَٱلْغَنَمِ","عَلَيْهِمْ شُحُومَهُمَآ إِلَّا",300],["6:148:12",148,"حَرَّمْنَا","we (would) have forbidden","وَلَآ ءَابَآؤُنَا وَلَا","مِن شَىْءٍۢ ۚ كَذَٰلِكَ",300],["6:150:8",148,"حَرَّمَ","prohibited","يَشْهَدُونَ أَنَّ ٱللَّهَ","هَـٰذَا ۖ فَإِن شَهِدُوا۟",300],["6:151:5",148,"حَرَّمَ","has prohibited","تَعَالَوْا۟ أَتْلُ مَا","رَبُّكُمْ عَلَيْكُمْ ۖ أَلَّا",300],["6:151:34",148,"حَرَّمَ","has (been) forbidden","تَقْتُلُوا۟ ٱلنَّفْسَ ٱلَّتِى","ٱللَّهُ إِلَّا بِٱلْحَقِّ ۚ",300],["7:32:3",154,"حَرَّمَ","has forbidden","قُلْ مَنْ","زِينَةَ ٱللَّهِ ٱلَّتِىٓ",300],["7:33:3",154,"حَرَّمَ","(had) forbidden","قُلْ إِنَّمَا","رَبِّىَ ٱلْفَوَٰحِشَ مَا",300],["7:50:18",156,"حَرَّمَهُمَا","has forbidden both","قَالُوٓا۟ إِنَّ ٱللَّهَ","عَلَى ٱلْكَـٰفِرِينَ",300],["7:157:21",170,"وَيُحَرِّمُ","and makes unlawful","وَيُحِلُّ لَهُمُ ٱلطَّيِّبَـٰتِ","عَلَيْهِمُ ٱلْخَبَـٰٓئِثَ وَيَضَعُ",300],["8:34:10",181,"ٱلْحَرَامِ","Al-Haraam","يَصُدُّونَ عَنِ ٱلْمَسْجِدِ","وَمَا كَانُوٓا۟ أَوْلِيَآءَهُۥٓ ۚ",343],["9:5:4",187,"ٱلْحُرُمُ","the sacred months","فَإِذَا ٱنسَلَخَ ٱلْأَشْهُرُ","فَٱقْتُلُوا۟ ٱلْمُشْرِكِينَ حَيْثُ",343],["9:7:14",188,"ٱلْحَرَامِ ۖ","Al-Haraam","عَـٰهَدتُّمْ عِندَ ٱلْمَسْجِدِ","فَمَا ٱسْتَقَـٰمُوا۟ لَكُمْ",343],["9:19:6",189,"ٱلْحَرَامِ","(of) Al-Masjid Al-Haraam","ٱلْحَآجِّ وَعِمَارَةَ ٱلْمَسْجِدِ","كَمَنْ ءَامَنَ بِٱللَّهِ",343],["9:28:10",191,"ٱلْحَرَامَ","Al-Masjid Al-Haraam","فَلَا يَقْرَبُوا۟ ٱلْمَسْجِدَ","بَعْدَ عَامِهِمْ هَـٰذَا ۚ",343],["9:29:10",191,"يُحَرِّمُونَ","they make unlawful","بِٱلْيَوْمِ ٱلْـَٔاخِرِ وَلَا","مَا حَرَّمَ ٱللَّهُ",300],["9:29:12",191,"حَرَّمَ","Allah has made unlawful","وَلَا يُحَرِّمُونَ مَا","ٱللَّهُ وَرَسُولُهُۥ وَلَا",300],["9:36:18",192,"حُرُمٌۭ ۚ","(are) sacred","وَٱلْأَرْضَ مِنْهَآ أَرْبَعَةٌ","ذَٰلِكَ ٱلدِّينُ ٱلْقَيِّمُ ۚ",343],["9:37:12",193,"وَيُحَرِّمُونَهُۥ","and make it unlawful","كَفَرُوا۟ يُحِلُّونَهُۥ عَامًۭا","عَامًۭا لِّيُوَاطِـُٔوا۟ عِدَّةَ",300],["9:37:17",193,"حَرَّمَ","Allah has made unlawful","لِّيُوَاطِـُٔوا۟ عِدَّةَ مَا","ٱللَّهُ فَيُحِلُّوا۟ مَا",300],["9:37:21",193,"حَرَّمَ","Allah has made unlawful","ٱللَّهُ فَيُحِلُّوا۟ مَا","ٱللَّهُ ۚ زُيِّنَ لَهُمْ",300],["10:59:11",215,"حَرَامًۭا","unlawful","رِّزْقٍۢ فَجَعَلْتُم مِّنْهُ","وَحَلَـٰلًۭا قُلْ ءَآللَّهُ",343],["14:37:12",260,"ٱلْمُحَرَّمِ","Your Sacred House","زَرْعٍ عِندَ بَيْتِكَ","رَبَّنَا لِيُقِيمُوا۟ ٱلصَّلَوٰةَ",1588],["16:35:17",271,"حَرَّمْنَا","we (would) have forbidden","وَلَآ ءَابَآؤُنَا وَلَا","مِن دُونِهِۦ مِن",300],["16:115:2",280,"حَرَّمَ","He has forbidden","إِنَّمَا","عَلَيْكُمُ ٱلْمَيْتَةَ وَٱلدَّمَ",300],["16:116:10",280,"حَرَامٌۭ","(is) forbidden","هَـٰذَا حَلَـٰلٌۭ وَهَـٰذَا","لِّتَفْتَرُوا۟ عَلَى ٱللَّهِ",343],["16:118:4",280,"حَرَّمْنَا","We have forbidden","وَعَلَى ٱلَّذِينَ هَادُوا۟","مَا قَصَصْنَا عَلَيْكَ",300],["17:1:8",282,"ٱلْحَرَامِ","Al-Masjid Al-Haraam","لَيْلًۭا مِّنَ ٱلْمَسْجِدِ","إِلَى ٱلْمَسْجِدِ ٱلْأَقْصَا",343],["17:33:5",285,"حَرَّمَ","Allah has forbidden","تَقْتُلُوا۟ ٱلنَّفْسَ ٱلَّتِى","ٱللَّهُ إِلَّا بِٱلْحَقِّ ۗ",300],["21:95:1",330,"وَحَرَٰمٌ","And (there is) prohibition","","عَلَىٰ قَرْيَةٍ أَهْلَكْنَـٰهَآ",343],["22:25:9",335,"ٱلْحَرَامِ","and Al-Masjid Al-Haraam","سَبِيلِ ٱللَّهِ وَٱلْمَسْجِدِ","ٱلَّذِى جَعَلْنَـٰهُ لِلنَّاسِ",343],["22:30:4",335,"حُرُمَـٰتِ","(the) sacred rites","ذَٰلِكَ وَمَن يُعَظِّمْ","ٱللَّهِ فَهُوَ خَيْرٌۭ",2282],["24:3:15",350,"وَحُرِّمَ","And is forbidden","زَانٍ أَوْ مُشْرِكٌۭ ۚ","ذَٰلِكَ عَلَى ٱلْمُؤْمِنِينَ",300],["25:68:12",366,"حَرَّمَ","Allah has forbidden","يَقْتُلُونَ ٱلنَّفْسَ ٱلَّتِى","ٱللَّهُ إِلَّا بِٱلْحَقِّ",300],["27:91:9",385,"حَرَّمَهَا","made it sacred","هَـٰذِهِ ٱلْبَلْدَةِ ٱلَّذِى","وَلَهُۥ كُلُّ شَىْءٍۢ ۖ",300],["28:12:1",386,"۞ وَحَرَّمْنَا","And We had forbidden","","عَلَيْهِ ٱلْمَرَاضِعَ مِن",300],["28:57:12",392,"حَرَمًا","a sanctuary","أَوَلَمْ نُمَكِّن لَّهُمْ","ءَامِنًۭا يُجْبَىٰٓ إِلَيْهِ",343],["29:67:5",404,"حَرَمًا","a Sanctuary","يَرَوْا۟ أَنَّا جَعَلْنَا","ءَامِنًۭا وَيُتَخَطَّفُ ٱلنَّاسُ",343],["48:25:7",514,"ٱلْحَرَامِ","Al-Masjid Al-Haraam","وَصَدُّوكُمْ عَنِ ٱلْمَسْجِدِ","وَٱلْهَدْىَ مَعْكُوفًا أَن",343],["48:27:9",514,"ٱلْحَرَامَ","Al-Masjid Al-Haraam","بِٱلْحَقِّ ۖ لَتَدْخُلُنَّ ٱلْمَسْجِدَ","إِن شَآءَ ٱللَّهُ",343],["51:19:5",521,"وَٱلْمَحْرُومِ","and the deprived","أَمْوَٰلِهِمْ حَقٌّۭ لِّلسَّآئِلِ","",1574],["56:67:3",536,"مَحْرُومُونَ","(are) deprived","بَلْ نَحْنُ","",1574],["66:1:4",560,"تُحَرِّمُ","you prohibit","يَـٰٓأَيُّهَا ٱلنَّبِىُّ لِمَ","مَآ أَحَلَّ ٱللَّهُ",300],["68:27:3",565,"مَحْرُومُونَ","(are) deprived","بَلْ نَحْنُ","",1574],["70:25:2",569,"وَٱلْمَحْرُومِ","and the deprived","لِّلسَّآئِلِ","",1574]]