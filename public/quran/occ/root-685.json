[["2:229:6",36,"تَسْرِيحٌۢ","to release (her)","فَإِمْسَاكٌۢ بِمَعْرُوفٍ أَوْ","بِإِحْسَـٰنٍۢ ۗ وَلَا يَحِلُّ",4418],["2:231:9",37,"سَرِّحُوهُنَّ","release them","فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ","بِمَعْرُوفٍۢ ۚ وَلَا تُمْسِكُوهُنَّ",1990],["16:6:7",267,"تَسْرَحُونَ","you take them out","حِينَ تُرِيحُونَ وَحِينَ","",4417],["33:28:13",421,"وَأُسَرِّحْكُنَّ","and release you","وَزِينَتَهَا فَتَعَالَيْنَ أُمَتِّعْكُنَّ","سَرَاحًۭا جَمِيلًۭا",1990],["33:28:14",421,"سَرَاحًۭا","(with) a release","فَتَعَالَيْنَ أُمَتِّعْكُنَّ وَأُسَرِّحْكُنَّ","جَمِيلًۭا",2628],["33:49:20",424,"وَسَرِّحُوهُنَّ","and release them","عِدَّةٍۢ تَعْتَدُّونَهَا ۖ فَمَتِّعُوهُنَّ","سَرَاحًۭا جَمِيلًۭا",1990],["33:49:21",424,"سَرَاحًۭا","(with) a release","تَعْتَدُّونَهَا ۖ فَمَتِّعُوهُنَّ وَسَرِّحُوهُنَّ","جَمِيلًۭا",2628]]