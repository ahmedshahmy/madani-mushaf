[["4:24:1",82,"۞ وَٱلْمُحْصَنَـٰتُ","And (prohibited are) the ones who are married","","مِنَ ٱلنِّسَآءِ إِلَّا",987],["4:24:19",82,"مُّحْصِنِينَ","desiring to be chaste","أَن تَبْتَغُوا۟ بِأَمْوَٰلِكُم","غَيْرَ مُسَـٰفِحِينَ ۚ فَمَا",2535],["4:25:8",82,"ٱلْمُحْصَنَـٰتِ","the free chaste","طَوْلًا أَن يَنكِحَ","ٱلْمُؤْمِنَـٰتِ فَمِن مَّا",987],["4:25:29",82,"مُحْصَنَـٰتٍ","(They should be) chaste","وَءَاتُوهُنَّ أُجُورَهُنَّ بِٱلْمَعْرُوفِ","غَيْرَ مُسَـٰفِحَـٰتٍۢ وَلَا",987],["4:25:36",82,"أُحْصِنَّ","they are married","مُتَّخِذَٰتِ أَخْدَانٍۢ ۚ فَإِذَآ","فَإِنْ أَتَيْنَ بِفَـٰحِشَةٍۢ",1270],["4:25:44",82,"ٱلْمُحْصَنَـٰتِ","the free chaste women","نِصْفُ مَا عَلَى","مِنَ ٱلْعَذَابِ ۚ ذَٰلِكَ",987],["5:5:14",107,"وَٱلْمُحْصَنَـٰتُ","And the chaste women","وَطَعَامُكُمْ حِلٌّۭ لَّهُمْ ۖ","مِنَ ٱلْمُؤْمِنَـٰتِ وَٱلْمُحْصَنَـٰتُ",987],["5:5:17",107,"وَٱلْمُحْصَنَـٰتُ","and the chaste women","وَٱلْمُحْصَنَـٰتُ مِنَ ٱلْمُؤْمِنَـٰتِ","مِنَ ٱلَّذِينَ أُوتُوا۟",987],["5:5:27",107,"مُحْصِنِينَ","being chaste","إِذَآ ءَاتَيْتُمُوهُنَّ أُجُورَهُنَّ","غَيْرَ مُسَـٰفِحِينَ وَلَا",2535],["12:48:15",241,"تُحْصِنُونَ","you (will) store","إِلَّا قَلِيلًۭا مِّمَّا","",1270],["21:80:5",328,"لِتُحْصِنَكُم","to protect you","صَنْعَةَ لَبُوسٍۢ لَّكُمْ","مِّنۢ بَأْسِكُمْ ۖ فَهَلْ",1270],["21:91:2",330,"أَحْصَنَتْ","guarded","وَٱلَّتِىٓ","فَرْجَهَا فَنَفَخْنَا فِيهَا",1270],["24:4:3",350,"ٱلْمُحْصَنَـٰتِ","the chaste women","وَٱلَّذِينَ يَرْمُونَ","ثُمَّ لَمْ يَأْتُوا۟",987],["24:23:4",352,"ٱلْمُحْصَنَـٰتِ","the chaste women","إِنَّ ٱلَّذِينَ يَرْمُونَ","ٱلْغَـٰفِلَـٰتِ ٱلْمُؤْمِنَـٰتِ لُعِنُوا۟",987],["24:33:35",354,"تَحَصُّنًۭا","chastity","ٱلْبِغَآءِ إِنْ أَرَدْنَ","لِّتَبْتَغُوا۟ عَرَضَ ٱلْحَيَوٰةِ",4330],["59:2:20",545,"حُصُونُهُم","their fortresses","وَظَنُّوٓا۟ أَنَّهُم مَّانِعَتُهُمْ","مِّنَ ٱللَّهِ فَأَتَىٰهُمُ",3214],["59:14:7",547,"مُّحَصَّنَةٍ","fortified","إِلَّا فِى قُرًۭى","أَوْ مِن وَرَآءِ",3955],["66:12:5",561,"أَحْصَنَتْ","guarded","ٱبْنَتَ عِمْرَٰنَ ٱلَّتِىٓ","فَرْجَهَا فَنَفَخْنَا فِيهِ",1270]]