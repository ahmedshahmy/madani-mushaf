وَمَرْيَمَ","عِمْرَٰنَ ٱلَّتِىٓ أَحْصَنَتْ",2831],["68:14:5",564,"وَبَنِينَ","and children","كَانَ ذَا مَالٍۢ","",141],["70:11:9",569,"بِبَنِيهِ","by his children","مِنْ عَذَابِ يَوْمِئِذٍۭ","",141],["71:12:3",571,"وَبَنِينَ","and children","وَيُمْدِدْكُم بِأَمْوَٰلٍۢ","وَيَجْعَل لَّكُمْ جَنَّـٰتٍۢ",141],["74:13:1",575,"وَبَنِينَ","And children","","شُهُودًۭا",141],["78:12:1",582,"وَبَنَيْنَا","And We constructed","","فَوْقَكُمْ سَبْعًۭا شِدَادًۭا",779],["79:27:6",584,"بَنَىٰهَا","He constructed it","خَلْقًا أَمِ ٱلسَّمَآءُ ۚ","",779],["80:36:2",585,"وَبَنِيهِ","and his children","وَصَـٰحِبَتِهِۦ","",141],["91:5:3",595,"بَنَىٰهَا","constructed it","وَٱلسَّمَآءِ وَمَا","",779]]