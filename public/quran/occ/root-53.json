[["2:22:7",4,"بِنَآءًۭ","a canopy","ٱلْأَرْضَ فِرَٰشًۭا وَٱلسَّمَآءَ","وَأَنزَلَ مِنَ ٱلسَّمَآءِ",2343],["2:40:1",7,"يَـٰبَنِىٓ","O Children","","إِسْرَٰٓءِيلَ ٱذْكُرُوا۟ نِعْمَتِىَ",141],["2:47:1",7,"يَـٰبَنِىٓ","O Children","","إِسْرَٰٓءِيلَ ٱذْكُرُوا۟ نِعْمَتِىَ",141],["2:49:10",8,"أَبْنَآءَكُمْ","your sons","سُوٓءَ ٱلْعَذَابِ يُذَبِّحُونَ","وَيَسْتَحْيُونَ نِسَآءَكُمْ ۚ وَفِى",193],["2:83:4",12,"بَنِىٓ","(from the) Children","وَإِذْ أَخَذْنَا مِيثَـٰقَ","إِسْرَٰٓءِيلَ لَا تَعْبُدُونَ",141],["2:87:11",13,"ٱبْنَ","(the) son","بِٱلرُّسُلِ ۖ وَءَاتَيْنَا عِيسَى","مَرْيَمَ ٱلْبَيِّنَـٰتِ وَأَيَّدْنَـٰهُ",193],["2:122:1",19,"يَـٰبَنِىٓ","O Children","","إِسْرَٰٓءِيلَ ٱذْكُرُوا۟ نِعْمَتِىَ",141],["2:132:4",20,"بَنِيهِ","(upon) his sons","وَوَصَّىٰ بِهَآ إِبْرَٰهِـۧمُ","وَيَعْقُوبُ يَـٰبَنِىَّ إِنَّ",141],["2:132:6",20,"يَـٰبَنِىَّ","O my sons","إِبْرَٰهِـۧمُ بَنِيهِ وَيَعْقُوبُ","إِنَّ ٱللَّهَ ٱصْطَفَىٰ",141],["2:133:10",20,"لِبَنِيهِ","to his sons","ٱلْمَوْتُ إِذْ قَالَ","مَا تَعْبُدُونَ مِنۢ",141],["2:146:7",23,"أَبْنَآءَهُمْ ۖ","their sons","يَعْرِفُونَهُۥ كَمَا يَعْرِفُونَ","وَإِنَّ فَرِيقًۭا مِّنْهُمْ",193],["2:177:27",27,"وَٱبْنَ","and (of)","ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينَ","ٱلسَّبِيلِ وَٱلسَّآئِلِينَ وَفِى",193],["2:211:2",33,"بَنِىٓ","(the) Children","سَلْ","إِسْرَٰٓءِيلَ كَمْ ءَاتَيْنَـٰهُم",141],["2:215:13",33,"وَٱبْنِ","and (of)","وَٱلْأَقْرَبِينَ وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ","ٱلسَّبِيلِ ۗ وَمَا تَفْعَلُوا۟",193],["2:246:6",40,"بَنِىٓ","(the) Children","إِلَى ٱلْمَلَإِ مِنۢ","إِسْرَٰٓءِيلَ مِنۢ بَعْدِ",141],["2:246:43",40,"وَأَبْنَآئِنَا ۖ","and our children","أُخْرِجْنَا مِن دِيَـٰرِنَا","فَلَمَّا كُتِبَ عَلَيْهِمُ",193],["2:253:16",42,"ٱبْنَ","son","دَرَجَـٰتٍۢ ۚ وَءَاتَيْنَا عِيسَى","مَرْيَمَ ٱلْبَيِّنَـٰتِ وَأَيَّدْنَـٰهُ",193],["3:14:7",51,"وَٱلْبَنِينَ","and [the] sons","ٱلشَّهَوَٰتِ مِنَ ٱلنِّسَآءِ","وَٱلْقَنَـٰطِيرِ ٱلْمُقَنطَرَةِ مِنَ",141],["3:45:13",55,"ٱبْنُ","son","ٱسْمُهُ ٱلْمَسِيحُ عِيسَى","مَرْيَمَ وَجِيهًۭا فِى",193],["3:49:3",56,"بَنِىٓ","(the) Children","وَرَسُولًا إِلَىٰ","إِسْرَٰٓءِيلَ أَنِّى قَدْ",141],["3:61:13",57,"أَبْنَآءَنَا","our sons","فَقُلْ تَعَالَوْا۟ نَدْعُ","وَأَبْنَآءَكُمْ وَنِسَآءَنَا وَنِسَآءَكُمْ",193],["3:61:14",57,"وَأَبْنَآءَكُمْ","and your sons","تَعَالَوْا۟ نَدْعُ أَبْنَآءَنَا","وَنِسَآءَنَا وَنِسَآءَكُمْ وَأَنفُسَنَا",193],["3:93:5",62,"لِّبَنِىٓ","for (the) Children","ٱلطَّعَامِ كَانَ حِلًّۭا","إِسْرَٰٓءِيلَ إِلَّا مَا",141],["4:11:57",78,"وَأَبْنَآؤُكُمْ","and your children","أَوْ دَيْنٍ ۗ ءَابَآؤُكُمْ","لَا تَدْرُونَ أَيُّهُمْ",193],["4:23:4",81,"وَبَنَاتُكُمْ","and your daughters","حُرِّمَتْ عَلَيْكُمْ أُمَّهَـٰتُكُمْ","وَأَخَوَٰتُكُمْ وَعَمَّـٰتُكُمْ وَخَـٰلَـٰتُكُمْ",570],["4:23:8",81,"وَبَنَاتُ","and daughters","وَأَخَوَٰتُكُمْ وَعَمَّـٰتُكُمْ وَخَـٰلَـٰتُكُمْ","ٱلْأَخِ وَبَنَاتُ ٱلْأُخْتِ",570],["4:23:10",81,"وَبَنَاتُ","and daughters","وَخَـٰلَـٰتُكُمْ وَبَنَاتُ ٱلْأَخِ","ٱلْأُخْتِ وَأُمَّهَـٰتُكُمُ ٱلَّـٰتِىٓ",570],["4:23:38",81,"أَبْنَآئِكُمُ","(of) your sons","جُنَاحَ عَلَيْكُمْ وَحَلَـٰٓئِلُ","ٱلَّذِينَ مِنْ أَصْلَـٰبِكُمْ",193],["4:36:20",84,"وَٱبْنِ","and the","ٱلْجُنُبِ وَٱلصَّاحِبِ بِٱلْجَنۢبِ","ٱلسَّبِيلِ وَمَا مَلَكَتْ",193],["4:157:6",103,"ٱبْنَ","son","قَتَلْنَا ٱلْمَسِيحَ عِيسَى","مَرْيَمَ رَسُولَ ٱللَّهِ",193],["4:171:16",105,"ٱبْنُ","son","إِنَّمَا ٱلْمَسِيحُ عِيسَى","مَرْيَمَ رَسُولُ ٱللَّهِ",193],["5:12:5",109,"بَنِىٓ","(from the) Children","أَخَذَ ٱللَّهُ مِيثَـٰقَ","إِسْرَٰٓءِيلَ وَبَعَثْنَا مِنْهُمُ",141],["5:17:9",110,"ٱبْنُ","son","ٱللَّهَ هُوَ ٱلْمَسِيحُ","مَرْيَمَ ۚ قُلْ فَمَن",193],["5:17:22",110,"ٱبْنَ","son","أَن يُهْلِكَ ٱلْمَسِيحَ","مَرْيَمَ وَأُمَّهُۥ وَمَن",193],["5:18:5",111,"أَبْنَـٰٓؤُا۟","(the) children","ٱلْيَهُودُ وَٱلنَّصَـٰرَىٰ نَحْنُ","ٱللَّهِ وَأَحِبَّـٰٓؤُهُۥ ۚ قُلْ",193],["5:27:4",112,"ٱبْنَىْ","(of) two sons","۞ وَٱتْلُ عَلَيْهِمْ نَبَأَ","ءَادَمَ بِٱلْحَقِّ إِذْ",193],["5:32:6",113,"بَنِىٓ","(the) Children","ذَٰلِكَ كَتَبْنَا عَلَىٰ","إِسْرَٰٓءِيلَ أَنَّهُۥ مَن",141],["5:46:5",116,"ٱبْنِ","son","عَلَىٰٓ ءَاثَـٰرِهِم بِعِيسَى","مَرْيَمَ مُصَدِّقًۭا لِّمَا",193],["5:70:4",119,"بَنِىٓ","(from the) Children","لَقَدْ أَخَذْنَا مِيثَـٰقَ","إِسْرَٰٓءِيلَ وَأَرْسَلْنَآ إِلَيْهِمْ",141],["5:72:9",120,"ٱبْنُ","son","ٱللَّهَ هُوَ ٱلْمَسِيحُ","مَرْيَمَ ۖ وَقَالَ ٱلْمَسِيحُ",193],["5:72:13",120,"يَـٰبَنِىٓ","O Children","مَرْيَمَ ۖ وَقَالَ ٱلْمَسِيحُ","إِسْرَٰٓءِيلَ ٱعْبُدُوا۟ ٱللَّهَ",141],["5:75:3",120,"ٱبْنُ","son","مَّا ٱلْمَسِيحُ","مَرْيَمَ إِلَّا رَسُولٌۭ",193],["5:78:5",121,"بَنِىٓ","(the) Children","ٱلَّذِينَ كَفَرُوا۟ مِنۢ","إِسْرَٰٓءِيلَ عَلَىٰ لِسَانِ",141],["5:78:11",121,"ٱبْنِ","son","لِسَانِ دَاوُۥدَ وَعِيسَى","مَرْيَمَ ۚ ذَٰلِكَ بِمَا",193],["5:110:5",126,"ٱبْنَ","son","قَالَ ٱللَّهُ يَـٰعِيسَى","مَرْيَمَ ٱذْكُرْ نِعْمَتِى",193],["5:110:49",126,"بَنِىٓ","(the) Children","بِإِذْنِى ۖ وَإِذْ كَفَفْتُ","إِسْرَٰٓءِيلَ عَنكَ إِذْ",141],["5:112:5",126,"ٱبْنَ","son","قَالَ ٱلْحَوَارِيُّونَ يَـٰعِيسَى","مَرْيَمَ هَلْ يَسْتَطِيعُ",193],["5:114:3",127,"ٱبْنُ","son","قَالَ عِيسَى","مَرْيَمَ ٱللَّهُمَّ رَبَّنَآ",193],["5:116:5",127,"ٱبْنَ","son","قَالَ ٱللَّهُ يَـٰعِيسَى","مَرْيَمَ ءَأَنتَ قُلْتَ",193],["6:20:7",130,"أَبْنَآءَهُمُ ۘ","their sons","يَعْرِفُونَهُۥ كَمَا يَعْرِفُونَ","ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُمْ",193],["6:100:8",140,"بَنِينَ","sons","وَخَلَقَهُمْ ۖ وَخَرَقُوا۟ لَهُۥ","وَبَنَـٰتٍۭ بِغَيْرِ عِلْمٍۢ ۚ",141],["6:100:9",140,"وَبَنَـٰتٍۭ","and daughters","وَخَرَقُوا۟ لَهُۥ بَنِينَ","بِغَيْرِ عِلْمٍۢ ۚ سُبْحَـٰنَهُۥ",570],["7:26:1",153,"يَـٰبَنِىٓ","O Children","","ءَادَمَ قَدْ أَنزَلْنَا",141],["7:27:1",153,"يَـٰبَنِىٓ","O Children","","ءَادَمَ لَا يَفْتِنَنَّكُمُ",141],["7:31:1",154,"۞ يَـٰبَنِىٓ","O Children","","ءَادَمَ خُذُوا۟ زِينَتَكُمْ",141],["7:35:1",154,"يَـٰبَنِىٓ","O Children","","ءَادَمَ إِمَّا يَأْتِيَنَّكُمْ",141],["7:105:17",164,"بَنِىٓ","(the) Children","رَّبِّكُمْ فَأَرْسِلْ مَعِىَ","إِسْرَٰٓءِيلَ",141],["7:127:16",165,"أَبْنَآءَهُمْ","their sons","وَءَالِهَتَكَ ۚ قَالَ سَنُقَتِّلُ","وَنَسْتَحْىِۦ نِسَآءَهُمْ وَإِنَّا",193],["7:134:21",166,"بَنِىٓ","(the) Children","لَكَ وَلَنُرْسِلَنَّ مَعَكَ","إِسْرَٰٓءِيلَ",141],["7:137:17",166,"بَنِىٓ","(the) Children","رَبِّكَ ٱلْحُسْنَىٰ عَلَىٰ","إِسْرَٰٓءِيلَ بِمَا صَبَرُوا۟ ۖ",141],["7:138:2",167,"بِبَنِىٓ","(the) Children","وَجَـٰوَزْنَا","إِسْرَٰٓءِيلَ ٱلْبَحْرَ فَأَتَوْا۟",141],["7:141:10",167,"أَبْنَآءَكُمْ","your sons","سُوٓءَ ٱلْعَذَابِ ۖ يُقَتِّلُونَ","وَيَسْتَحْيُونَ نِسَآءَكُمْ ۚ وَفِى",193],["7:150:24",169,"ٱبْنَ","O son","يَجُرُّهُۥٓ إِلَيْهِ ۚ قَالَ","أُمَّ إِنَّ ٱلْقَوْمَ",193],["7:172:5",173,"بَنِىٓ","(the) Children","أَخَذَ رَبُّكَ مِنۢ","ءَادَمَ مِن ظُهُورِهِمْ",141],["8:41:14",182,"وَٱبْنِ","and the","ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ","ٱلسَّبِيلِ إِن كُنتُمْ",193],["9:24:5",190,"وَأَبْنَآؤُكُمْ","and your sons","إِن كَانَ ءَابَآؤُكُمْ","وَإِخْوَٰنُكُمْ وَأَزْوَٰجُكُمْ وَعَشِيرَتُكُمْ",193],["9:30:4",191,"ٱبْنُ","(is) son","وَقَالَتِ ٱلْيَهُودُ عُزَيْرٌ","ٱللَّهِ وَقَالَتِ ٱلنَّصَـٰرَى",193],["9:30:9",191,"ٱبْنُ","(is) son","وَقَالَتِ ٱلنَّصَـٰرَى ٱلْمَسِيحُ","ٱللَّهِ ۖ ذَٰلِكَ قَوْلُهُم",193],["9:31:9",191,"ٱبْنَ","son","دُونِ ٱللَّهِ وَٱلْمَسِيحَ","مَرْيَمَ وَمَآ أُمِرُوٓا۟",193],["9:60:15",196,"وَٱبْنِ","and the wayfarer","وَفِى سَبِيلِ ٱللَّهِ","ٱلسَّبِيلِ ۖ فَرِيضَةًۭ مِّنَ",193],["9:109:3",204,"بُنْيَـٰنَهُۥ","his building","أَفَمَنْ أَسَّسَ","عَلَىٰ تَقْوَىٰ مِنَ",1066],["9:109:13",204,"بُنْيَـٰنَهُۥ","his building","أَم مَّنْ أَسَّسَ","عَلَىٰ شَفَا جُرُفٍ",1066],["9:110:3",204,"بُنْيَـٰنُهُمُ","their building","لَا يَزَالُ","ٱلَّذِى بَنَوْا۟ رِيبَةًۭ",1066],["9:110:5",204,"بَنَوْا۟","they built","يَزَالُ بُنْيَـٰنُهُمُ ٱلَّذِى","رِيبَةًۭ فِى قُلُوبِهِمْ",779],["10:90:2",219,"بِبَنِىٓ","(the) Children","۞ وَجَـٰوَزْنَا","إِسْرَٰٓءِيلَ ٱلْبَحْرَ فَأَتْبَعَهُمْ",141],["10:90:23",219,"بَنُوٓا۟","the Children of Israel","ٱلَّذِىٓ ءَامَنَتْ بِهِۦ","إِسْرَٰٓءِيلَ وَأَنَا۠ مِنَ",141],["10:93:3",219,"بَنِىٓ","(the) Children","وَلَقَدْ بَوَّأْنَا","إِسْرَٰٓءِيلَ مُبَوَّأَ صِدْقٍۢ",141],["11:42:9",226,"ٱبْنَهُۥ","(to) his son","كَٱلْجِبَالِ وَنَادَىٰ نُوحٌ","وَكَانَ فِى مَعْزِلٍۢ",193],["11:42:13",226,"يَـٰبُنَىَّ","O my son","وَكَانَ فِى مَعْزِلٍۢ","ٱرْكَب مَّعَنَا وَلَا",141],["11:45:7",226,"ٱبْنِى","my son","فَقَالَ رَبِّ إِنَّ","مِنْ أَهْلِى وَإِنَّ",193],["11:78:13",230,"بَنَاتِى","(are) my daughters","قَالَ يَـٰقَوْمِ هَـٰٓؤُلَآءِ","هُنَّ أَطْهَرُ لَكُمْ ۖ",570],["11:79:7",230,"بَنَاتِكَ","your daughters","مَا لَنَا فِى","مِنْ حَقٍّۢ وَإِنَّكَ",570],["12:5:2",236,"يَـٰبُنَىَّ","O my son","قَالَ","لَا تَقْصُصْ رُءْيَاكَ",141],["12:67:2",243,"يَـٰبَنِىَّ","O my sons","وَقَالَ","لَا تَدْخُلُوا۟ مِنۢ",141],["12:81:7",245,"ٱبْنَكَ","your son","فَقُولُوا۟ يَـٰٓأَبَانَآ إِنَّ","سَرَقَ وَمَا شَهِدْنَآ",193],["12:87:1",246,"يَـٰبَنِىَّ","O my sons","","ٱذْهَبُوا۟ فَتَحَسَّسُوا۟ مِن",141],["14:6:18",256,"أَبْنَآءَكُمْ","your sons","سُوٓءَ ٱلْعَذَابِ وَيُذَبِّحُونَ","وَيَسْتَحْيُونَ نِسَآءَكُمْ ۚ وَفِى",193],["14:35:10",260,"وَبَنِىَّ","and my sons","ٱلْبَلَدَ ءَامِنًۭا وَٱجْنُبْنِى","أَن نَّعْبُدَ ٱلْأَصْنَامَ",141],["15:71:3",266,"بَنَاتِىٓ","(are) my daughters","قَالَ هَـٰٓؤُلَآءِ","إِن كُنتُمْ فَـٰعِلِينَ",570],["16:26:8",269,"بُنْيَـٰنَهُم","(at) their building","قَبْلِهِمْ فَأَتَى ٱللَّهُ","مِّنَ ٱلْقَوَاعِدِ فَخَرَّ",1066],["16:57:3",273,"ٱلْبَنَـٰتِ","daughters","وَيَجْعَلُونَ لِلَّهِ","سُبْحَـٰنَهُۥ ۙ وَلَهُم مَّا",570],["16:72:11",274,"بَنِينَ","sons","لَكُم مِّنْ أَزْوَٰجِكُم","وَحَفَدَةًۭ وَرَزَقَكُم مِّنَ",141],["17:2:6",282,"لِّبَنِىٓ","for the Children","ٱلْكِتَـٰبَ وَجَعَلْنَـٰهُ هُدًۭى","إِسْرَٰٓءِيلَ أَلَّا تَتَّخِذُوا۟",141],["17:4:3",282,"بَنِىٓ","(the) Children","وَقَضَيْنَآ إِلَىٰ","إِسْرَٰٓءِيلَ فِى ٱلْكِتَـٰبِ",141],["17:6:8",282,"وَبَنِينَ","and sons","عَلَيْهِمْ وَأَمْدَدْنَـٰكُم بِأَمْوَٰلٍۢ","وَجَعَلْنَـٰكُمْ أَكْثَرَ نَفِيرًا",141],["17:26:6",284,"وَٱبْنَ","and the wayfarer","ٱلْقُرْبَىٰ حَقَّهُۥ وَٱلْمِسْكِينَ","ٱلسَّبِيلِ وَلَا تُبَذِّرْ",193],["17:40:3",286,"بِٱلْبَنِينَ","sons","أَفَأَصْفَىٰكُمْ رَبُّكُم","وَٱتَّخَذَ مِنَ ٱلْمَلَـٰٓئِكَةِ",141],["17:70:3",289,"بَنِىٓ","(the) children of Adam","۞ وَلَقَدْ كَرَّمْنَا","ءَادَمَ وَحَمَلْنَـٰهُمْ فِى",141],["17:101:8",292,"بَنِىٓ","(the) Children of Israel","ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ ۖ فَسْـَٔلْ","إِسْرَٰٓءِيلَ إِذْ جَآءَهُمْ",141],["17:104:4",292,"لِبَنِىٓ","to the Children of Israel","وَقُلْنَا مِنۢ بَعْدِهِۦ","إِسْرَٰٓءِيلَ ٱسْكُنُوا۟ ٱلْأَرْضَ",141],["18:21:19",296,"ٱبْنُوا۟","Construct","بَيْنَهُمْ أَمْرَهُمْ ۖ فَقَالُوا۟","عَلَيْهِم بُنْيَـٰنًۭا ۖ رَّبُّهُمْ",779],["18:21:21",296,"بُنْيَـٰنًۭا ۖ","a structure","فَقَالُوا۟ ٱبْنُوا۟ عَلَيْهِم","رَّبُّهُمْ أَعْلَمُ بِهِمْ ۚ",1066],["18:46:2",299,"وَٱلْبَنُونَ","and children","ٱلْمَالُ","زِينَةُ ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ",141],["19:34:3",307,"ٱبْنُ","(the) son","ذَٰلِكَ عِيسَى","مَرْيَمَ ۚ قَوْلَ ٱلْحَقِّ",193],["20:47:8",314,"بَنِىٓ","(the) Children of Israel","رَبِّكَ فَأَرْسِلْ مَعَنَا","إِسْرَٰٓءِيلَ وَلَا تُعَذِّبْهُمْ ۖ",141],["20:80:1",317,"يَـٰبَنِىٓ","O Children of Israel","","إِسْرَٰٓءِيلَ قَدْ أَنجَيْنَـٰكُم",141],["20:94:2",318,"يَبْنَؤُمَّ","O son of my mother","قَالَ","لَا تَأْخُذْ بِلِحْيَتِى",193],["20:94:14",318,"بَنِىٓ","(the) Children of Israel","تَقُولَ فَرَّقْتَ بَيْنَ","إِسْرَٰٓءِيلَ وَلَمْ تَرْقُبْ",141],["21:91:9",330,"وَٱبْنَهَآ","and her son","مِن رُّوحِنَا وَجَعَلْنَـٰهَا","ءَايَةًۭ لِّلْعَـٰلَمِينَ",193],["23:50:2",345,"ٱبْنَ","(the) son","وَجَعَلْنَا","مَرْيَمَ وَأُمَّهُۥٓ ءَايَةًۭ",193],["23:55:7",345,"وَبَنِينَ","and children","بِهِۦ مِن مَّالٍۢ","",141],["24:31:30",353,"أَبْنَآئِهِنَّ","their sons","ءَابَآءِ بُعُولَتِهِنَّ أَوْ","أَوْ أَبْنَآءِ بُعُولَتِهِنَّ",193],["24:31:32",353,"أَبْنَآءِ","sons","أَوْ أَبْنَآئِهِنَّ أَوْ","بُعُولَتِهِنَّ أَوْ إِخْوَٰنِهِنَّ",193],["24:31:37",353,"بَنِىٓ","sons","أَوْ إِخْوَٰنِهِنَّ أَوْ","إِخْوَٰنِهِنَّ أَوْ بَنِىٓ",141],["24:31:40",353,"بَنِىٓ","sons","بَنِىٓ إِخْوَٰنِهِنَّ أَوْ","أَخَوَٰتِهِنَّ أَوْ نِسَآئِهِنَّ",141],["26:17:4",367,"بَنِىٓ","(the) Children of Israel.'","أَنْ أَرْسِلْ مَعَنَا","إِسْرَٰٓءِيلَ",141],["26:22:7",368,"بَنِىٓ","(the) Children of Israel","عَلَىَّ أَنْ عَبَّدتَّ","إِسْرَٰٓءِيلَ",141],["26:59:3",369,"بَنِىٓ","(the) Children of Israel","كَذَٰلِكَ وَأَوْرَثْنَـٰهَا","إِسْرَٰٓءِيلَ",141],["26:88:6",371,"بَنُونَ","sons","يَنفَعُ مَالٌۭ وَلَا","",141],["26:128:1",372,"أَتَبْنُونَ","Do you construct","","بِكُلِّ رِيعٍ ءَايَةًۭ",779],["26:133:3",372,"وَبَنِينَ","and children","أَمَدَّكُم بِأَنْعَـٰمٍۢ","",141],["26:197:8",375,"بَنِىٓ","(of the) Children","أَن يَعْلَمَهُۥ عُلَمَـٰٓؤُا۟","إِسْرَٰٓءِيلَ",141],["27:76:6",383,"بَنِىٓ","(the) Children","ٱلْقُرْءَانَ يَقُصُّ عَلَىٰ","إِسْرَٰٓءِيلَ أَكْثَرَ ٱلَّذِى",141],["28:4:13",385,"أَبْنَآءَهُمْ","their sons","طَآئِفَةًۭ مِّنْهُمْ يُذَبِّحُ","وَيَسْتَحْىِۦ نِسَآءَهُمْ ۚ إِنَّهُۥ",193],["28:27:7",388,"ٱبْنَتَىَّ","(of) my daughters","أَنْ أُنكِحَكَ إِحْدَى","هَـٰتَيْنِ عَلَىٰٓ أَن",2831],["30:38:6",408,"وَٱبْنَ","and the wayfarer","ٱلْقُرْبَىٰ حَقَّهُۥ وَٱلْمِسْكِينَ","ٱلسَّبِيلِ ۚ ذَٰلِكَ خَيْرٌۭ",193],["31:13:4",412,"لِٱبْنِهِۦ","to his son","وَإِذْ قَالَ لُقْمَـٰنُ","وَهُوَ يَعِظُهُۥ يَـٰبُنَىَّ",193],["31:13:7",412,"يَـٰبُنَىَّ","O my son","لِٱبْنِهِۦ وَهُوَ يَعِظُهُۥ","لَا تُشْرِكْ بِٱللَّهِ ۖ",141],["31:16:1",412,"يَـٰبُنَىَّ","O my son","","إِنَّهَآ إِن تَكُ",141],["31:17:1",412,"يَـٰبُنَىَّ","O my son","","أَقِمِ ٱلصَّلَوٰةَ وَأْمُرْ",141],["32:23:13",417,"لِّبَنِىٓ","for the Children of Israel","لِّقَآئِهِۦ ۖ وَجَعَلْنَـٰهُ هُدًۭى","إِسْرَٰٓءِيلَ",141],["33:4:19",418,"أَبْنَآءَكُمْ ۚ","your sons","وَمَا جَعَلَ أَدْعِيَآءَكُمْ","ذَٰلِكُمْ قَوْلُكُم بِأَفْوَٰهِكُمْ ۖ",193],["33:7:12",419,"ٱبْنِ","son","وَإِبْرَٰهِيمَ وَمُوسَىٰ وَعِيسَى","مَرْيَمَ ۖ وَأَخَذْنَا مِنْهُم",193],["33:50:17",424,"وَبَنَاتِ","and (the) daughters","أَفَآءَ ٱللَّهُ عَلَيْكَ","عَمِّكَ وَبَنَاتِ عَمَّـٰتِكَ",570],["33:50:19",424,"وَبَنَاتِ","and (the) daughters","عَلَيْكَ وَبَنَاتِ عَمِّكَ","عَمَّـٰتِكَ وَبَنَاتِ خَالِكَ",570],["33:50:21",424,"وَبَنَاتِ","and (the) daughters","عَمِّكَ وَبَنَاتِ عَمَّـٰتِكَ","خَالِكَ وَبَنَاتِ خَـٰلَـٰ