[["6:6:19",128,"مِّدْرَارًۭا","showering abundantly","وَأَرْسَلْنَا ٱلسَّمَآءَ عَلَيْهِم","وَجَعَلْنَا ٱلْأَنْهَـٰرَ تَجْرِى",1928],["11:52:10",227,"مِّدْرَارًۭا","(in) abundance","يُرْسِلِ ٱلسَّمَآءَ عَلَيْكُم","وَيَزِدْكُمْ قُوَّةً إِلَىٰ",1928],["24:35:16",354,"دُرِّىٌّۭ","brilliant","ٱلزُّجَاجَةُ كَأَنَّهَا كَوْكَبٌۭ","يُوقَدُ مِن شَجَرَةٍۢ",3386],["71:11:4",571,"مِّدْرَارًۭا","(in) abundance","يُرْسِلِ ٱلسَّمَآءَ عَلَيْكُم","",1928]]