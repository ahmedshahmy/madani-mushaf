[["33:4:12",418,"ٱلَّـٰٓـِٔى","whom","وَمَا جَعَلَ أَزْوَٰجَكُمُ","تُظَـٰهِرُونَ مِنْهُنَّ أُمَّهَـٰتِكُمْ ۚ",1692],["58:2:12",542,"ٱلَّـٰٓـِٔى","those who","إِنْ أُمَّهَـٰتُهُمْ إِلَّا","وَلَدْنَهُمْ ۚ وَإِنَّهُمْ لَيَقُولُونَ",1692],["65:4:1",558,"وَٱلَّـٰٓـِٔى","And those who","","يَئِسْنَ مِنَ ٱلْمَحِيضِ",1692],["65:4:12",558,"وَٱلَّـٰٓـِٔى","and the ones who","فَعِدَّتُهُنَّ ثَلَـٰثَةُ أَشْهُرٍۢ","لَمْ يَحِضْنَ ۚ وَأُو۟لَـٰتُ",1692]]