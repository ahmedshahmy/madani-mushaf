[["2:72:4",11,"فَٱدَّٰرَْٰٔتُمْ","then you disputed","وَإِذْ قَتَلْتُمْ نَفْسًۭا","فِيهَا ۖ وَٱللَّهُ مُخْرِجٌۭ",4793],["3:168:10",72,"فَٱدْرَءُوا۟","Then avert","مَا قُتِلُوا۟ ۗ قُلْ","عَنْ أَنفُسِكُمُ ٱلْمَوْتَ",1667],["13:22:13",252,"وَيَدْرَءُونَ","and they repel","رَزَقْنَـٰهُمْ سِرًّۭا وَعَلَانِيَةًۭ","بِٱلْحَسَنَةِ ٱلسَّيِّئَةَ أُو۟لَـٰٓئِكَ",1667],["24:8:1",350,"وَيَدْرَؤُا۟","But it would prevent","","عَنْهَا ٱلْعَذَابَ أَن",1667],["28:54:7",392,"وَيَدْرَءُونَ","and they repel","مَّرَّتَيْنِ بِمَا صَبَرُوا۟","بِٱلْحَسَنَةِ ٱلسَّيِّئَةَ وَمِمَّا",1667]]