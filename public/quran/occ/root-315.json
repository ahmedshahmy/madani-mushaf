[["2:96:9",15,"يَوَدُّ","Loves","وَمِنَ ٱلَّذِينَ أَشْرَكُوا۟ ۚ","أَحَدُهُمْ لَوْ يُعَمَّرُ",582],["2:105:2",16,"يَوَدُّ","like","مَّا","ٱلَّذِينَ كَفَرُوا۟ مِنْ",582],["2:109:1",17,"وَدَّ","Wish[ed]","","كَثِيرٌۭ مِّنْ أَهْلِ",582],["2:266:1",45,"أَيَوَدُّ","Would like","","أَحَدُكُمْ أَن تَكُونَ",582],["3:30:14",54,"تَوَدُّ","it will wish","عَمِلَتْ مِن سُوٓءٍۢ","لَوْ أَنَّ بَيْنَهَا",582],["3:69:1",58,"وَدَّت","Wished","","طَّآئِفَةٌۭ مِّنْ أَهْلِ",582],["3:118:12",65,"وَدُّوا۟","They wish","لَا يَأْلُونَكُمْ خَبَالًۭا","مَا عَنِتُّمْ قَدْ",582],["4:42:2",85,"يَوَدُّ","will wish","يَوْمَئِذٍۢ","ٱلَّذِينَ كَفَرُوا۟ وَعَصَوُا۟",582],["4:73:12",89,"مَوَدَّةٌۭ","any affection","تَكُنۢ بَيْنَكُمْ وَبَيْنَهُۥ","يَـٰلَيْتَنِى كُنتُ مَعَهُمْ",992],["4:89:1",92,"وَدُّوا۟","They wish","","لَوْ تَكْفُرُونَ كَمَا",582],["4:102:28",95,"وَدَّ","Wished","وَلْيَأْخُذُوا۟ حِذْرَهُمْ وَأَسْلِحَتَهُمْ ۗ","ٱلَّذِينَ كَفَرُوا۟ لَوْ",582],["5:82:12",121,"مَّوَدَّةًۭ","(in) affection","أَشْرَكُوا۟ ۖ وَلَتَجِدَنَّ أَقْرَبَهُم","لِّلَّذِينَ ءَامَنُوا۟ ٱلَّذِينَ",992],["8:7:8",177,"وَتَوَدُّونَ","and you wished","ٱلطَّآئِفَتَيْنِ أَنَّهَا لَكُمْ","أَنَّ غَيْرَ ذَاتِ",582],["11:90:9",232,"وَدُودٌۭ","Most Loving","إِنَّ رَبِّى رَحِيمٌۭ","",2709],["15:2:2",262,"يَوَدُّ","will wish","رُّبَمَا","ٱلَّذِينَ كَفَرُوا۟ لَوْ",582],["19:96:9",312,"وُدًّۭا","affection","سَيَجْعَلُ لَهُمُ ٱلرَّحْمَـٰنُ","",4548],["29:25:8",399,"مَّوَدَّةَ","(out of) love","دُونِ ٱللَّهِ أَوْثَـٰنًۭا","بَيْنِكُمْ فِى ٱلْحَيَوٰةِ",992],["30:21:13",406,"مَّوَدَّةًۭ","love","إِلَيْهَا وَجَعَلَ بَيْنَكُم","وَرَحْمَةً ۚ إِنَّ فِى",992],["33:20:8",420,"يَوَدُّوا۟","they would wish","وَإِن يَأْتِ ٱلْأَحْزَابُ","لَوْ أَنَّهُم بَادُونَ",582],["42:23:16",486,"ٱلْمَوَدَّةَ","the love","عَلَيْهِ أَجْرًا إِلَّا","فِى ٱلْقُرْبَىٰ ۗ وَمَن",992],["58:22:8",545,"يُوَآدُّونَ","loving","بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ","مَنْ حَآدَّ ٱللَّهَ",582],["60:1:11",549,"بِٱلْمَوَدَّةِ","love","أَوْلِيَآءَ تُلْقُونَ إِلَيْهِم","وَقَدْ كَفَرُوا۟ بِمَا",992],["60:1:35",549,"بِٱلْمَوَدَّةِ","love","مَرْضَاتِى ۚ تُسِرُّونَ إِلَيْهِم","وَأَنَا۠ أَعْلَمُ بِمَآ",992],["60:2:11",549,"وَوَدُّوا۟","and they desire","أَيْدِيَهُمْ وَأَلْسِنَتَهُم بِٱلسُّوٓءِ","لَوْ تَكْفُرُونَ",582],["60:7:10",550,"مَّوَدَّةًۭ ۚ","love","ٱلَّذِينَ عَادَيْتُم مِّنْهُم","وَٱللَّهُ قَدِيرٌۭ ۚ وَٱللَّهُ",992],["68:9:1",564,"وَدُّوا۟","They wish","","لَوْ تُدْهِنُ فَيُدْهِنُونَ",582],["70:11:2",569,"يَوَدُّ","Would wish","يُبَصَّرُونَهُمْ ۚ","ٱلْمُجْرِمُ لَوْ يَفْتَدِى",582],["71:23:7",571,"وَدًّۭا","Wadd","ءَالِهَتَكُمْ وَلَا تَذَرُنَّ","وَلَا سُوَاعًۭا وَلَا",4521],["85:14:3",590,"ٱلْوَدُودُ","the Most Loving","وَهُوَ ٱلْغَفُورُ","",2709]]