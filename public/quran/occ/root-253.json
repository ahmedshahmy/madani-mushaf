[["3:104:11",63,"ٱلْمُنكَرِ ۚ","the wrong","بِٱلْمَعْرُوفِ وَيَنْهَوْنَ عَنِ","وَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ",552],["3:110:10",64,"ٱلْمُنكَرِ","the wrong","بِٱلْمَعْرُوفِ وَتَنْهَوْنَ عَنِ","وَتُؤْمِنُونَ بِٱللَّهِ ۗ وَلَوْ",552],["3:114:9",64,"ٱلْمُنكَرِ","the wrong","بِٱلْمَعْرُوفِ وَيَنْهَوْنَ عَنِ","وَيُسَـٰرِعُونَ فِى ٱلْخَيْرَٰتِ",552],["5:79:5",121,"مُّنكَرٍۢ","wrongdoing","لَا يَتَنَاهَوْنَ عَن","فَعَلُوهُ ۚ لَبِئْسَ مَا",552],["7:157:17",170,"ٱلْمُنكَرِ","the wrong","بِٱلْمَعْرُوفِ وَيَنْهَىٰهُمْ عَنِ","وَيُحِلُّ لَهُمُ ٱلطَّيِّبَـٰتِ",552],["9:67:7",197,"بِٱلْمُنكَرِ","the wrong","مِّنۢ بَعْضٍۢ ۚ يَأْمُرُونَ","وَيَنْهَوْنَ عَنِ ٱلْمَعْرُوفِ",552],["9:71:10",198,"ٱلْمُنكَرِ","the wrong","بِٱلْمَعْرُوفِ وَيَنْهَوْنَ عَنِ","وَيُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤْتُونَ",552],["9:112:11",205,"ٱلْمُنكَرِ","the wrong","بِٱلْمَعْرُوفِ وَٱلنَّاهُونَ عَنِ","وَٱلْحَـٰفِظُونَ لِحُدُودِ ٱللَّهِ ۗ",552],["11:70:7",229,"نَكِرَهُمْ","he felt unfamiliar of them","لَا تَصِلُ إِلَيْهِ","وَأَوْجَسَ مِنْهُمْ خِيفَةًۭ ۚ",4034],["12:58:9",242,"مُنكِرُونَ","knew him not","فَعَرَفَهُمْ وَهُمْ لَهُۥ","",1909],["13:36:11",254,"يُنكِرُ","deny","وَمِنَ ٱلْأَحْزَابِ مَن","بَعْضَهُۥ ۚ قُلْ إِنَّمَآ",2083],["15:62:4",265,"مُّنكَرُونَ","unknown","قَالَ إِنَّكُمْ قَوْمٌۭ","",552],["16:22:9",269,"مُّنكِرَةٌۭ","refuse","يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ قُلُوبُهُم","وَهُم مُّسْتَكْبِرُونَ",3974],["16:83:5",276,"يُنكِرُونَهَا","they deny it","نِعْمَتَ ٱللَّهِ ثُمَّ","وَأَكْثَرُهُمُ ٱلْكَـٰفِرُونَ",2083],["16:90:12",277,"وَٱلْمُنكَرِ","and the bad","وَيَنْهَىٰ عَنِ ٱلْفَحْشَآءِ","وَٱلْبَغْىِ ۚ يَعِظُكُمْ لَعَلَّكُمْ",552],["18:74:16",301,"نُّكْرًۭا","evil","لَّقَدْ جِئْتَ شَيْـًۭٔا","",1951],["18:87:13",303,"نُّكْرًۭا","terrible","رَبِّهِۦ فَيُعَذِّبُهُۥ عَذَابًۭا","",1951],["21:50:7",326,"مُنكِرُونَ","rejecters","أَنزَلْنَـٰهُ ۚ أَفَأَنتُمْ لَهُۥ","",1909],["22:41:14",337,"ٱلْمُنكَرِ ۗ","the wrong","بِٱلْمَعْرُوفِ وَنَهَوْا۟ عَنِ","وَلِلَّهِ عَـٰقِبَةُ ٱلْأُمُورِ",552],["22:44:11",337,"نَكِيرِ","My punishment","أَخَذْتُهُمْ ۖ فَكَيْفَ كَانَ","",1613],["22:72:11",340,"ٱلْمُنكَرَ ۖ","the denial","وُجُوهِ ٱلَّذِينَ كَفَرُوا۟","يَكَادُونَ يَسْطُونَ بِٱلَّذِينَ",552],["23:69:7",346,"مُنكِرُونَ","(are) rejecting him","رَسُولَهُمْ فَهُمْ لَهُۥ","",1909],["24:21:15",352,"وَٱلْمُنكَرِ ۚ","and the evil","فَإِنَّهُۥ يَأْمُرُ بِٱلْفَحْشَآءِ","وَلَوْلَا فَضْلُ ٱللَّهِ",552],["27:41:2",380,"نَكِّرُوا۟","Disguise","قَالَ","لَهَا عَرْشَهَا نَنظُرْ",4035],["29:29:9",399,"ٱلْمُنكَرَ ۖ","evil","وَتَأْتُونَ فِى نَادِيكُمُ","فَمَا كَانَ جَوَابَ",552],["29:45:14",401,"وَٱلْمُنكَرِ ۗ","and evil deeds","تَنْهَىٰ عَنِ ٱلْفَحْشَآءِ","وَلَذِكْرُ ٱللَّهِ أَكْبَرُ ۗ",552],["31:17:8",412,"ٱلْمُنكَرِ","the wrong","بِٱلْمَعْرُوفِ وَٱنْهَ عَنِ","وَٱصْبِرْ عَلَىٰ مَآ",552],["31:19:8",412,"أَنكَرَ","(the) harshest","مِن صَوْتِكَ ۚ إِنَّ","ٱلْأَصْوَٰتِ لَصَوْتُ ٱلْحَمِيرِ",3022],["34:45:14",433,"نَكِيرِ","My rejection","رُسُلِى ۖ فَكَيْفَ كَانَ","",1613],["35:26:7",437,"نَكِيرِ","My rejection","كَفَرُوا۟ ۖ فَكَيْفَ كَانَ","",1613],["40:81:6",476,"تُنكِرُونَ","will you deny","فَأَىَّ ءَايَـٰتِ ٱللَّهِ","",2083],["42:47:21",488,"نَّكِيرٍۢ","denial","وَمَا لَكُم مِّن","",4091],["51:25:9",521,"مُّنكَرُونَ","unknown","قَالَ سَلَـٰمٌۭ قَوْمٌۭ","",552],["54:6:8",528,"نُّكُرٍ","terrible","ٱلدَّاعِ إِلَىٰ شَىْءٍۢ","",4097],["58:2:16",542,"مُنكَرًۭا","an evil","وَلَدْنَهُمْ ۚ وَإِنَّهُمْ لَيَقُولُونَ","مِّنَ ٱلْقَوْلِ وَزُورًۭا ۚ",552],["65:8:14",559,"نُّكْرًۭا","terrible","شَدِيدًۭا وَعَذَّبْنَـٰهَا عَذَابًۭا","",1951],["67:18:8",563,"نَكِيرِ","My rejection","قَبْلِهِمْ فَكَيْفَ كَانَ","",1613]]