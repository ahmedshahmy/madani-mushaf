[["2:2:1",2,"ذَٰلِكَ","That","","ٱلْكِتَـٰبُ لَا رَيْبَ ۛ",19],["2:49:14",8,"ذَٰلِكُم","that","وَيَسْتَحْيُونَ نِسَآءَكُمْ ۚ وَفِى","بَلَآءٌۭ مِّن رَّبِّكُمْ",19],["2:52:6",8,"ذَٰلِكَ","that","عَنكُم مِّنۢ بَعْدِ","لَعَلَّكُمْ تَشْكُرُونَ",19],["2:54:16",8,"ذَٰلِكُمْ","That","بَارِئِكُمْ فَٱقْتُلُوٓا۟ أَنفُسَكُمْ","خَيْرٌۭ لَّكُمْ عِندَ",19],["2:61:45",9,"ذَٰلِكَ","That (was)","بِغَضَبٍۢ مِّنَ ٱللَّهِ ۗ","بِأَنَّهُمْ كَانُوا۟ يَكْفُرُونَ",19],["2:61:55",9,"ذَٰلِكَ","That","ٱلنَّبِيِّـۧنَ بِغَيْرِ ٱلْحَقِّ ۗ","بِمَا عَصَوا۟ وَّكَانُوا۟",19],["2:64:5",10,"ذَٰلِكَ ۖ","that","تَوَلَّيْتُم مِّنۢ بَعْدِ","فَلَوْلَا فَضْلُ ٱللَّهِ",19],["2:68:20",10,"ذَٰلِكَ ۖ","that","بِكْرٌ عَوَانٌۢ بَيْنَ","فَٱفْعَلُوا۟ مَا تُؤْمَرُونَ",19],["2:73:4",11,"كَذَٰلِكَ","Like this","فَقُلْنَا ٱضْرِبُوهُ بِبَعْضِهَا ۚ","يُحْىِ ٱللَّهُ ٱلْمَوْتَىٰ",19],["2:74:6",11,"ذَٰلِكَ","that","قُلُوبُكُم مِّنۢ بَعْدِ","فَهِىَ كَٱلْحِجَارَةِ أَوْ",19],["2:85:32",13,"ذَٰلِكَ","that","جَزَآءُ مَن يَفْعَلُ","مِنكُمْ إِلَّا خِزْىٌۭ",19],["2:111:11",17,"تِلْكَ","That","هُودًا أَوْ نَصَـٰرَىٰ ۗ","أَمَانِيُّهُمْ ۗ قُلْ هَاتُوا۟",19],["2:113:16",18,"كَذَٰلِكَ","Like that","وَهُمْ يَتْلُونَ ٱلْكِتَـٰبَ ۗ","قَالَ ٱلَّذِينَ لَا",19],["2:118:11",18,"كَذَٰلِكَ","Like that","أَوْ تَأْتِينَآ ءَايَةٌۭ ۗ","قَالَ ٱلَّذِينَ مِن",19],["2:134:1",20,"تِلْكَ","This","","أُمَّةٌۭ قَدْ خَلَتْ ۖ",19],["2:141:1",21,"تِلْكَ","This","","أُمَّةٌۭ قَدْ خَلَتْ ۖ",19],["2:143:1",22,"وَكَذَٰلِكَ","And thus","","جَعَلْنَـٰكُمْ أُمَّةًۭ وَسَطًۭا",19],["2:167:13",25,"كَذَٰلِكَ","Thus","كَمَا تَبَرَّءُوا۟ مِنَّا ۗ","يُرِيهِمُ ٱللَّهُ أَعْمَـٰلَهُمْ",19],["2:176:1",26,"ذَٰلِكَ","That","","بِأَنَّ ٱللَّهَ نَزَّلَ",19],["2:178:26",27,"ذَٰلِكَ","That (is)","وَأَدَآءٌ إِلَيْهِ بِإِحْسَـٰنٍۢ ۗ","تَخْفِيفٌۭ مِّن رَّبِّكُمْ",19],["2:178:34",27,"ذَٰلِكَ","that","فَمَنِ ٱعْتَدَىٰ بَعْدَ","فَلَهُۥ عَذَابٌ أَلِيمٌۭ",19],["2:187:54",29,"تِلْكَ","These","عَـٰكِفُونَ فِى ٱلْمَسَـٰجِدِ ۗ","حُدُودُ ٱللَّهِ فَلَا",19],["2:187:59",29,"كَذَٰلِكَ","Thus","ٱللَّهِ فَلَا تَقْرَبُوهَا ۗ","يُبَيِّنُ ٱللَّهُ ءَايَـٰتِهِۦ",19],["2:191:23",30,"كَذَٰلِكَ","Such","فَإِن قَـٰتَلُوكُمْ فَٱقْتُلُوهُمْ ۗ","جَزَآءُ ٱلْكَـٰفِرِينَ",19],["2:196:56",30,"تِلْكَ","This","وَسَبْعَةٍ إِذَا رَجَعْتُمْ ۗ","عَشَرَةٌۭ كَامِلَةٌۭ ۗ ذَٰلِكَ",19],["2:196:59",30,"ذَٰلِكَ","That","تِلْكَ عَشَرَةٌۭ كَامِلَةٌۭ ۗ","لِمَن لَّمْ يَكُنْ",19],["2:219:20",34,"كَذَٰلِكَ","Thus","يُنفِقُونَ قُلِ ٱلْعَفْوَ ۗ","يُبَيِّنُ ٱللَّهُ لَكُمُ",19],["2:228:26",36,"ذَٰلِكَ","that (period)","أَحَقُّ بِرَدِّهِنَّ فِى","إِنْ أَرَادُوٓا۟ إِصْلَـٰحًۭا ۚ",19],["2:229:35",36,"تِلْكَ","These","فِيمَا ٱفْتَدَتْ بِهِۦ ۗ","حُدُودُ ٱللَّهِ فَلَا",19],["2:230:25",36,"وَتِلْكَ","And these","يُقِيمَا حُدُودَ ٱللَّهِ ۗ","حُدُودُ ٱللَّهِ يُبَيِّنُهَا",19],["2:231:17",37,"ذَٰلِكَ","that","لِّتَعْتَدُوا۟ ۚ وَمَن يَفْعَلْ","فَقَدْ ظَلَمَ نَفْسَهُۥ ۚ",19],["2:232:15",37,"ذَٰلِكَ","That","تَرَٰضَوْا۟ بَيْنَهُم بِٱلْمَعْرُوفِ ۗ","يُوعَظُ بِهِۦ مَن",19],["2:232:25",37,"ذَٰلِكُمْ","that","بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۗ","أَزْكَىٰ لَكُمْ وَأَطْهَرُ ۗ",19],["2:233:33",37,"ذَٰلِكَ ۗ","that (of the father)","وَعَلَى ٱلْوَارِثِ مِثْلُ","فَإِنْ أَرَادَا فِصَالًا",19],["2:242:1",39,"كَذَٰلِكَ","Thus","","يُبَيِّنُ ٱللَّهُ لَكُمْ",19],["2:248:25",40,"ذَٰلِكَ","that","ٱلْمَلَـٰٓئِكَةُ ۚ إِنَّ فِى","لَـَٔايَةًۭ لَّكُمْ إِن",19],["2:252:1",41,"تِلْكَ","These","","ءَايَـٰتُ ٱللَّهِ نَتْلُوهَا",19],["2:253:1",42,"۞ تِلْكَ","These","","ٱلرُّسُلُ فَضَّلْنَا بَعْضَهُمْ",19],["2:266:29",45,"كَذَٰلِكَ","Thus","فِيهِ نَارٌۭ فَٱحْتَرَقَتْ ۗ","يُبَيِّنُ ٱللَّهُ لَكُمُ",19],["2:275:14",47,"ذَٰلِكَ","That","ٱلشَّيْطَـٰنُ مِنَ ٱلْمَسِّ ۚ","بِأَنَّهُمْ قَالُوٓا۟ إِنَّمَا",19],["2:282:87",48,"ذَٰلِكُمْ","That","كَبِيرًا إِلَىٰٓ أَجَلِهِۦ ۚ","أَقْسَطُ عِندَ ٱللَّهِ",19],["3:13:26",51,"ذَٰلِكَ","that","يَشَآءُ ۗ إِنَّ فِى","لَعِبْرَةًۭ لِّأُو۟لِى ٱلْأَبْصَـٰرِ",19],["3:14:17",51,"ذَٰلِكَ","That","ٱلْمُسَوَّمَةِ وَٱلْأَنْعَـٰمِ وَٱلْحَرْثِ ۗ","مَتَـٰعُ ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ",19],["3:15:5",51,"ذَٰلِكُمْ ۚ","that","أَؤُنَبِّئُكُم بِخَيْرٍۢ مِّن","لِلَّذِينَ ٱتَّقَوْا۟ عِندَ",19],["3:24:1",53,"ذَٰلِكَ","That","","بِأَنَّهُمْ قَالُوا۟ لَن",19],["3:28:11",53,"ذَٰلِكَ","that","ٱلْمُؤْمِنِينَ ۖ وَمَن يَفْعَلْ","فَلَيْسَ مِنَ ٱللَّهِ",19],["3:40:13",55,"كَذَٰلِكَ","Thus","وَٱمْرَأَتِى عَاقِرٌۭ ۖ قَالَ","ٱللَّهُ يَفْعَلُ مَا",19],["3:44:1",55,"ذَٰلِكَ","That","","مِنْ أَنۢبَآءِ ٱلْغَيْبِ",19],["3:47:11",56,"كَذَٰلِكِ","Thus","يَمْسَسْنِى بَشَرٌۭ ۖ قَالَ","ٱللَّهُ يَخْلُقُ مَا",19],["3:49:40",56,"ذَٰلِكَ","that","بُيُوتِكُمْ ۚ إِنَّ فِى","لَـَٔايَةًۭ لَّكُمْ إِن",19],["3:58:1",57,"ذَٰلِكَ","That","","نَتْلُوهُ عَلَيْكَ مِنَ",19],["3:75:23",59,"ذَٰلِكَ","That","دُمْتَ عَلَيْهِ قَآئِمًۭا ۗ","بِأَنَّهُمْ قَالُوا۟ لَيْسَ",19],["3:81:24",60,"ذَٰلِكُمْ","that (condition)","ءَأَقْرَرْتُمْ وَأَخَذْتُمْ عَلَىٰ","إِصْرِى ۖ قَالُوٓا۟ أَقْرَرْنَا ۚ",19],["3:82:4",60,"ذَٰلِكَ","that","فَمَن تَوَلَّىٰ بَعْدَ","فَأُو۟لَـٰٓئِكَ هُمُ ٱلْفَـٰسِقُونَ",19],["3:89:6",61,"ذَٰلِكَ","that","تَابُوا۟ مِنۢ بَعْدِ","وَأَصْلَحُوا۟ فَإِنَّ ٱللَّهَ",19],["3:94:8",62,"ذَٰلِكَ","that","ٱلْكَذِبَ مِنۢ بَعْدِ","فَأُو۟لَـٰٓئِكَ هُمُ ٱلظَّـٰلِمُونَ",19],["3:103:28",63,"كَذَٰلِكَ","Thus","ٱلنَّارِ فَأَنقَذَكُم مِّنْهَا ۗ","يُبَيِّنُ ٱللَّهُ لَكُمْ",19],["3:108:1",63,"تِلْكَ","These","","ءَايَـٰتُ ٱللَّهِ نَتْلُوهَا",19],["3:112:21",64,"ذَٰلِكَ","That","وَضُرِبَتْ عَلَيْهِمُ ٱلْمَسْكَنَةُ ۚ","بِأَنَّهُمْ كَانُوا۟ يَكْفُرُونَ",19],["3:112:31",64,"ذَٰلِكَ","That","ٱلْأَنۢبِيَآءَ بِغَيْرِ حَقٍّۢ ۚ","بِمَا عَصَوا۟ وَّكَانُوا۟",19],["3:140:9",67,"وَتِلْكَ","And this","ٱلْقَوْمَ قَرْحٌۭ مِّثْلُهُۥ ۚ","ٱلْأَيَّامُ نُدَاوِلُهَا بَيْنَ",19],["3:156:26",70,"ذَٰلِكَ","that","قُتِلُوا۟ لِيَجْعَلَ ٱللَّهُ","حَسْرَةًۭ فِى قُلُوبِهِمْ ۗ",19],["3:175:2",73,"ذَٰلِكُمُ","that","إِنَّمَا","ٱلشَّيْطَـٰنُ يُخَوِّفُ أَوْلِيَآءَهُۥ",19],["3:182:1",74,"ذَٰلِكَ","That","","بِمَا قَدَّمَتْ أَيْدِيكُمْ",19],["3:186:21",74,"ذَٰلِكَ","that","تَصْبِرُوا۟ وَتَتَّقُوا۟ فَإِنَّ","مِنْ عَزْمِ ٱلْأُمُورِ",19],["4:3:25",77,"ذَٰلِكَ","That","مَا مَلَكَتْ أَيْمَـٰنُكُمْ ۚ","أَدْنَىٰٓ أَلَّا تَعُولُوا۟",19],["4:12:69",79,"ذَٰلِكَ","that","كَانُوٓا۟ أَكْثَرَ مِن","فَهُمْ شُرَكَآءُ فِى",19],["4:13:1",79,"تِلْكَ","These","","حُدُودُ ٱللَّهِ ۚ وَمَن",19],["4:13:16",79,"وَذَٰلِكَ","And that","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا ۚ","ٱلْفَوْزُ ٱلْعَظِيمُ",19],["4:24:15",82,"ذَٰلِكُمْ","that","لَكُم مَّا وَرَآءَ","أَن تَبْتَغُوا۟ بِأَمْوَٰلِكُم",19],["4:25:47",82,"ذَٰلِكَ","That","ٱلْمُحْصَنَـٰتِ مِنَ ٱلْعَذَابِ ۚ","لِمَنْ خَشِىَ ٱلْعَنَتَ",19],["4:30:3",83,"ذَٰلِكَ","that","وَمَن يَفْعَلْ","عُدْوَٰنًۭا وَظُلْمًۭا فَسَوْفَ",19],["4:30:10",83,"ذَٰلِكَ","that","نُصْلِيهِ نَارًۭا ۚ وَكَانَ","عَلَى ٱللَّهِ يَسِيرًا",19],["4:48:11",86,"ذَٰلِكَ","that","وَيَغْفِرُ مَا دُونَ","لِمَن يَشَآءُ ۚ وَمَن",19],["4:59:25",87,"ذَٰلِكَ","That","بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۚ","خَيْرٌۭ وَأَحْسَنُ تَأْوِيلًا",19],["4:70:1",89,"ذَٰلِكَ","That","","ٱلْفَضْلُ مِنَ ٱللَّهِ ۚ",19],["4:94:26",93,"كَذَٰلِكَ","Like that","ٱللَّهِ مَغَانِمُ كَثِيرَةٌۭ ۚ","كُنتُم مِّن قَبْلُ",19],["4:114:19",97,"ذَٰلِكَ","that","ٱلنَّاسِ ۚ وَمَن يَفْعَلْ","ٱبْتِغَآءَ مَرْضَاتِ ٱللَّهِ",19],["4:116:11",97,"ذَٰلِكَ","that","وَيَغْفِرُ مَا دُونَ","لِمَن يَشَآءُ ۚ وَمَن",19],["4:133:11",99,"ذَٰلِكَ","that","وَكَانَ ٱللَّهُ عَلَىٰ","قَدِيرًۭا",19],["4:143:3",101,"ذَٰلِكَ","that","مُّذَبْذَبِينَ بَيْنَ","لَآ إِلَىٰ هَـٰٓؤُلَآءِ",19],["4:150:21",102,"ذَٰلِكَ","that","أَن يَتَّخِذُوا۟ بَيْنَ","سَبِيلًا",19],["4:153:15",102,"ذَٰلِكَ","that","مُوسَىٰٓ أَكْبَرَ مِن","فَقَالُوٓا۟ أَرِنَا ٱللَّهَ",19],["4:153:33",102,"ذَٰلِكَ ۚ","that","ٱلْبَيِّنَـٰتُ فَعَفَوْنَا عَن","وَءَاتَيْنَا مُوسَىٰ سُلْطَـٰنًۭا",19],["4:169:8",104,"ذَٰلِكَ","that","فِيهَآ أَبَدًۭا ۚ وَكَانَ","عَلَى ٱللَّهِ يَسِيرًۭا",19],["5:3:29",107,"ذَٰلِكُمْ","that","وَأَن تَسْتَقْسِمُوا۟ بِٱلْأَزْلَـٰمِ ۚ","فِسْقٌ ۗ ٱلْيَوْمَ يَئِسَ",19],["5:12:40",109,"ذَٰلِكَ","that","فَمَن كَفَرَ بَعْدَ","مِنكُمْ فَقَدْ ضَلَّ",19],["5:29:11",112,"وَذَٰلِكَ","and that","مِنْ أَصْحَـٰبِ ٱلنَّارِ ۚ","جَزَٰٓؤُا۟ ٱلظَّـٰلِمِينَ",19],["5:32:3",113,"ذَٰلِكَ","that","مِنْ أَجْلِ","كَتَبْنَا عَلَىٰ بَنِىٓ",19],["5:32:37",113,"ذَٰلِكَ","that","كَثِيرًۭا مِّنْهُم بَعْدَ","فِى ٱلْأَرْضِ لَمُسْرِفُونَ",19],["5:33:25",113,"ذَٰلِكَ","That","يُنفَوْا۟ مِنَ ٱلْأَرْضِ ۚ","لَهُمْ خِزْىٌۭ فِى",19],["5:43:12",115,"ذَٰلِكَ ۚ","that","يَتَوَلَّوْنَ مِنۢ بَعْدِ","وَمَآ أُو۟لَـٰٓئِكَ بِٱلْمُؤْمِنِينَ",19],["5:54:29",117,"ذَٰلِكَ","That","يَخَافُونَ لَوْمَةَ لَآئِمٍۢ ۚ","فَضْلُ ٱللَّهِ يُؤْتِيهِ",19],["5:58:8",118,"ذَٰلِكَ","That","ٱتَّخَذُوهَا هُزُوًۭا وَلَعِبًۭا ۚ","بِأَنَّهُمْ قَوْمٌۭ لَّا",19],["5:60:6",118,"ذَٰلِكَ","that","أُنَبِّئُكُم بِشَرٍّۢ مِّن","مَثُوبَةً عِندَ ٱللَّهِ ۚ",19],["5:78:13",121,"ذَٰلِكَ","that (was)","وَعِيسَى ٱبْنِ مَرْيَمَ ۚ","بِمَا عَصَوا۟ وَّكَانُوا۟",19],["5:82:19",121,"ذَٰلِكَ","That (is)","قَالُوٓا۟ إِنَّا نَصَـٰرَىٰ ۚ","بِأَنَّ مِنْهُمْ قِسِّيسِينَ",19],["5:85:12",122,"وَذَٰلِكَ","And that","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا ۚ","جَزَآءُ ٱلْمُحْسِنِينَ",19],["5:89:32",122,"ذَٰلِكَ","That","فَصِيَامُ ثَلَـٰثَةِ أَيَّامٍۢ ۚ","كَفَّـٰرَةُ أَيْمَـٰنِكُمْ إِذَا",19],["5:89:39",122,"كَذَٰلِكَ","Thus","حَلَفْتُمْ ۚ وَٱحْفَظُوٓا۟ أَيْمَـٰنَكُمْ ۚ","يُبَيِّنُ ٱللَّهُ لَكُمْ",19],["5:94:20",123,"ذَٰلِكَ","that","فَمَنِ ٱعْتَدَىٰ بَعْدَ","فَلَهُۥ عَذَابٌ أَلِيمٌۭ",19],["5:95:33",123,"ذَٰلِكَ","(of) that","مَسَـٰكِينَ أَوْ عَدْلُ","صِيَامًۭا لِّيَذُوقَ وَبَالَ",19],["5:97:12",124,"ذَٰلِكَ","That (is)","ٱلْحَرَامَ وَٱلْهَدْىَ وَٱلْقَلَـٰٓئِدَ ۚ","لِتَعْلَمُوٓا۟ أَنَّ ٱللَّهَ",19],["5:108:1",125,"ذَٰلِكَ","That","","أَدْنَىٰٓ أَن يَأْتُوا۟",19],["5:119:22",127,"ذَٰلِكَ","That","عَنْهُمْ وَرَضُوا۟ عَنْهُ ۚ","ٱلْفَوْزُ ٱلْعَظِيمُ",19],["6:16:7",129,"وَذَٰلِكَ","And that","يَوْمَئِذٍۢ فَقَدْ رَحِمَهُۥ ۚ","ٱلْفَوْزُ ٱلْمُبِينُ",19],["6:53:1",134,"وَكَذَٰلِكَ","And thus","","فَتَنَّا بَعْضَهُم بِبَعْضٍۢ",19],["6:55:1",134,"وَكَذَٰلِكَ","And thus","","نُفَصِّلُ ٱلْـَٔايَـٰتِ وَلِتَسْتَبِينَ",19],["6:75:1",137,"وَكَذَٰلِكَ","And thus","","نُرِىٓ إِبْرَٰهِيمَ مَلَكُوتَ",19],["6:83:1",138,"وَتِلْكَ","And this","","حُجَّتُنَآ ءَاتَيْنَـٰهَآ إِبْرَٰهِيمَ",19],["6:84:19",138,"وَكَذَٰلِكَ","And thus","وَيُوسُفَ وَمُوسَىٰ وَهَـٰرُونَ ۚ","نَجْزِى ٱلْمُحْسِنِينَ",19],["6:88:1",138,"ذَٰلِكَ","That","","هُدَى ٱللَّهِ يَهْدِى",19],["6:95:14",140,"ذَٰلِكُمُ","That","ٱلْمَيِّتِ مِنَ ٱلْحَىِّ ۚ","ٱللَّهُ ۖ فَأَنَّىٰ تُؤْفَكُونَ",19],["6:96:9",140,"ذَٰلِكَ","That","وَٱلشَّمْسَ وَٱلْقَمَرَ حُسْبَانًۭا ۚ","تَقْدِيرُ ٱلْعَزِيزِ ٱلْعَلِيمِ",19],["6:99:41",140,"ذَٰلِكُمْ","that","وَيَنْعِهِۦٓ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يُؤْمِنُونَ",19],["6:102:1",141,"ذَٰلِكُمُ","That","","ٱللَّهُ رَبُّكُمْ ۖ لَآ",19],["6:105:1",141,"وَكَذَٰلِكَ","And thus","","نُصَرِّفُ ٱلْـَٔايَـٰتِ وَلِيَقُولُوا۟",19],["6:108:13",141,"كَذَٰلِكَ","Thus","عَدْوًۢا بِغَيْرِ عِلْمٍۢ ۗ","زَيَّنَّا لِكُلِّ أُمَّةٍ",19],["6:112:1",142,"وَكَذَٰلِكَ","And thus","","جَعَلْنَا لِكُلِّ نَبِىٍّ",19],["6:122:19",143,"كَذَٰلِكَ","Thus","لَيْسَ بِخَارِجٍۢ مِّنْهَا ۚ","زُيِّنَ لِلْكَـٰفِرِينَ مَا",19],["6:123:1",143,"وَكَذَٰلِكَ","And thus","","جَعَلْنَا فِى كُلِّ",19],["6:125:21",144,"كَذَٰلِكَ","Thus","يَصَّعَّدُ فِى ٱلسَّمَآءِ ۚ","يَجْعَلُ ٱللَّهُ ٱلرِّجْسَ",19],["6:129:1",144,"وَكَذَٰلِكَ","And thus","","نُوَلِّى بَعْضَ ٱلظَّـٰلِمِينَ",19],["6:131:1",145,"ذَٰلِكَ","That (is because)","","أَن لَّمْ يَكُن",19],["6:137:1",145,"وَكَذَٰلِكَ","And likewise","","زَيَّنَ لِكَثِيرٍۢ مِّنَ",19],["6:146:24",147,"ذَٰلِكَ","That","مَا ٱخْتَلَطَ بِعَظْمٍۢ ۚ","جَزَيْنَـٰهُم بِبَغْيِهِمْ ۖ وَإِنَّا",19],["6:148:15",148,"كَذَٰلِكَ","Likewise","حَرَّمْنَا مِن شَىْءٍۢ ۚ","كَذَّبَ ٱلَّذِينَ مِن",19],["6:151:38",148,"ذَٰلِكُمْ","That","ٱللَّهُ إِلَّا بِٱلْحَقِّ ۚ","وَصَّىٰكُم بِهِۦ لَعَلَّكُمْ",19],["6:152:31",149,"ذَٰلِكُمْ","That","وَبِعَهْدِ ٱللَّهِ أَوْفُوا۟ ۚ","وَصَّىٰكُم بِهِۦ لَعَلَّكُمْ",19],["6:153:13",149,"ذَٰلِكُمْ","That","بِكُمْ عَن سَبِيلِهِۦ ۚ","وَصَّىٰكُم بِهِۦ لَعَلَّكُمْ",19],["6:163:4",150,"وَبِذَٰلِكَ","and with that","لَا شَرِيكَ لَهُۥ ۖ","أُمِرْتُ وَأَنَا۠ أَوَّلُ",19],["7:26:12",153,"ذَٰلِكَ","that","وَرِيشًۭا ۖ وَلِبَاسُ ٱلتَّقْوَىٰ","خَيْرٌۭ ۚ ذَٰلِكَ مِنْ",19],["7:26:14",153,"ذَٰلِكَ","That","ٱلتَّقْوَىٰ ذَٰلِكَ خَيْرٌۭ ۚ","مِنْ ءَايَـٰتِ ٱللَّهِ",19],["7:32:22",154,"كَذَٰلِكَ","Thus","خَالِصَةًۭ يَوْمَ ٱلْقِيَـٰمَةِ ۗ","نُفَصِّلُ ٱلْـَٔايَـٰتِ لِقَوْمٍۢ",19],["7:40:21",155,"وَكَذَٰلِكَ","And thus","فِى سَمِّ ٱلْخِيَاطِ ۚ","نَجْزِى ٱلْمُجْرِمِينَ",19],["7:41:8",155,"وَكَذَٰلِكَ","And thus","وَمِن فَوْقِهِمْ غَوَاشٍۢ ۚ","نَجْزِى ٱلظَّـٰلِمِينَ",19],["7:57:25",157,"كَذَٰلِكَ","Thus","مِن كُلِّ ٱلثَّمَرَٰتِ ۚ","نُخْرِجُ ٱلْمَوْتَىٰ لَعَلَّكُمْ",19],["7:58:13",158,"كَذَٰلِكَ","Thus","يَخْرُجُ إِلَّا نَكِدًۭا ۚ","نُصَرِّفُ ٱلْـَٔايَـٰتِ لِقَوْمٍۢ",19],["7:85:32",161,"ذَٰلِكُمْ","That","ٱلْأَرْضِ بَعْدَ إِصْلَـٰحِهَا ۚ","خَيْرٌۭ لَّكُمْ إِن",19],["7:101:1",163,"تِلْكَ","These","","ٱلْقُرَىٰ نَقُصُّ عَلَيْكَ",19],["7:101:18",163,"كَذَٰلِكَ","Thus","كَذَّبُوا۟ مِن قَبْلُ ۚ","يَطْبَعُ ٱللَّهُ عَلَىٰ",19],["7:141:14",167,"ذَٰلِكُم","that","وَيَسْتَحْيُونَ نِسَآءَكُمْ ۚ وَفِى","بَلَآءٌۭ مِّن رَّبِّكُمْ",19],["7:146:30",168,"ذَٰلِكَ","That","ٱلْغَىِّ يَتَّخِذُوهُ سَبِيلًۭا ۚ","بِأَنَّهُمْ كَذَّبُوا۟ بِـَٔايَـٰتِنَا",19],["7:152:13",169,"وَكَذَٰلِكَ","And thus","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۚ","نَجْزِى ٱلْمُفْتَرِينَ",19],["7:163:23",171,"كَذَٰلِكَ","Thus","يَسْبِتُونَ ۙ لَا تَأْتِيهِمْ ۚ","نَبْلُوهُم بِمَا كَانُوا۟",19],["7:168:9",172,"ذَٰلِكَ ۖ","that","ٱلصَّـٰلِحُونَ وَمِنْهُمْ دُونَ","وَبَلَوْنَـٰهُم بِٱلْحَسَنَـٰتِ وَٱلسَّيِّـَٔاتِ",19],["7:174:1",173,"وَكَذَٰلِكَ","And thus","","نُفَصِّلُ ٱلْـَٔايَـٰتِ وَلَعَلَّهُمْ",19],["7:176:21",173,"ذَّٰلِكَ","That","أَوْ تَتْرُكْهُ يَلْهَث ۚ","مَثَلُ ٱلْقَوْمِ ٱلَّذِينَ",19],["8:13:1",178,"ذَٰلِكَ","That","","بِأَنَّهُمْ شَآقُّوا۟ ٱللَّهَ",19],["8:14:1",178,"ذَٰلِكُمْ","That","","فَذُوقُوهُ وَأَنَّ لِلْكَـٰفِرِينَ",19],["8:18:1",179,"ذَٰلِكُمْ","That (is the case)","","وَأَنَّ ٱللَّهَ مُوهِنُ",19],["8:51:1",183,"ذَٰلِكَ","That","","بِمَا قَدَّمَتْ أَيْدِيكُمْ",19],["8:53:1",184,"ذَٰلِكَ","That","","بِأَنَّ ٱللَّهَ لَمْ",19],["9:6:14",187,"ذَٰلِكَ","That","ثُمَّ أَبْلِغْهُ مَأْمَنَهُۥ ۚ","بِأَنَّهُمْ قَوْمٌۭ لَّا",19],["9:26:16",190,"وَذَٰلِكَ","And that","وَعَذَّبَ ٱلَّذِينَ كَفَرُوا۟ ۚ","جَزَآءُ ٱلْكَـٰفِرِينَ",19],["9:27:6",191,"ذَٰلِكَ","that","ٱللَّهُ مِنۢ بَعْدِ","عَلَىٰ مَن يَشَآءُ ۗ",19],["9:30:11",191,"ذَٰلِكَ","That","ٱلْمَسِيحُ ٱبْنُ ٱللَّهِ ۖ","قَوْلُهُم بِأَفْوَٰهِهِمْ ۖ يُضَـٰهِـُٔونَ",19],["9:36:19",192,"ذَٰلِكَ","That","مِنْهَآ أَرْبَعَةٌ حُرُمٌۭ ۚ","ٱلدِّينُ ٱلْقَيِّمُ ۚ فَلَا",19],["9:41:10",194,"ذَٰلِكُمْ","That","فِى سَبِيلِ ٱللَّهِ ۚ","خَيْرٌۭ لَّكُمْ إِن",19],["9:63:14",197,"ذَٰلِكَ","That","جَهَنَّمَ خَـٰلِدًۭا فِيهَا ۚ","ٱلْخِزْىُ ٱلْعَظِيمُ",19],["9:72:21",198,"ذَٰلِكَ","That","مِّنَ ٱللَّهِ أَكْبَرُ ۚ","هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ",19],["9:80:16",200,"ذَٰلِكَ","That","يَغْفِرَ ٱللَّهُ لَهُمْ ۚ","بِأَنَّهُمْ كَفَرُوا۟ بِٱللَّهِ",19],["9:89:11",201,"ذَٰلِكَ","That","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا ۚ","ٱلْفَوْزُ ٱلْعَظِيمُ",19],["9:100:23",203,"ذَٰلِكَ","That","خَـٰلِدِينَ فِيهَآ أَبَدًۭا ۚ","ٱلْفَوْزُ ٱلْعَظِيمُ",19],["9:111:34",204,"وَذَٰلِكَ","And that","ٱلَّذِى بَايَعْتُم بِهِۦ ۚ","هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ",19],["9:120:19",206,"ذَٰلِكَ","That is","بِأَنفُسِهِمْ عَن نَّفْسِهِۦ ۚ","بِأَنَّهُمْ لَا يُصِيبُهُمْ",19],["10:1:2",208,"تِلْكَ","These","الٓر ۚ","ءَايَـٰتُ ٱلْكِتَـٰبِ ٱلْحَكِيمِ",19],["10:3:24",208,"ذَٰلِكُمُ","That","مِنۢ بَعْدِ إِذْنِهِۦ ۚ","ٱللَّهُ رَبُّكُمْ فَٱعْبُدُوهُ ۚ",19],["10:5:17",208,"ذَٰلِكَ","that","مَا خَلَقَ ٱللَّهُ","إِلَّا بِٱلْحَقِّ ۚ يُفَصِّلُ",19],["10:12:22",209,"كَذَٰلِكَ","Thus","إِلَىٰ ضُرٍّۢ مَّسَّهُۥ ۚ","زُيِّنَ لِلْمُسْرِفِينَ مَا",19],["10:13:14",209,"كَذَٰلِكَ","Thus","وَمَا كَانُوا۟ لِيُؤْمِنُوا۟ ۚ","نَجْزِى ٱلْقَوْمَ ٱلْمُجْرِمِينَ",19],["10:24:39",211,"كَذَٰلِكَ","Thus","لَّمْ تَغْنَ بِٱلْأَمْسِ ۚ","نُفَصِّلُ ٱلْـَٔايَـٰتِ لِقَوْمٍۢ",19],["10:32:1",212,"فَذَٰلِكُمُ","For that","","ٱللَّهُ رَبُّكُمُ ٱلْحَقُّ ۖ",19],["10:33:1",212,"كَذَٰلِكَ","Thus","","حَقَّتْ كَلِمَتُ رَبِّكَ",19],["10:39:10",213,"كَذَٰلِكَ","Thus","وَلَمَّا يَأْتِهِمْ تَأْوِيلُهُۥ ۚ","كَذَّبَ ٱلَّذِينَ مِن",19],["10:58:5",215,"فَبِذَٰلِكَ","so in that","بِفَضْلِ ٱللَّهِ وَبِرَحْمَتِهِۦ","فَلْيَفْرَحُوا۟ هُوَ خَيْرٌۭ",19],["10:61:36",215,"ذَٰلِكَ","that","وَلَآ أَصْغَرَ مِن","وَلَآ أَكْبَرَ إِلَّا",19],["10:64:12",216,"ذَٰلِكَ","That","تَبْدِيلَ لِكَلِمَـٰتِ ٱللَّهِ ۚ","هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ",19],["10:67:12",216,"ذَٰلِكَ","that","مُبْصِرًا ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يَسْمَعُونَ",19],["10:74:18",217,"كَذَٰلِكَ","Thus","بِهِۦ مِن قَبْلُ ۚ","نَطْبَعُ عَلَىٰ قُلُوبِ",19],["10:103:6",220,"كَذَٰلِكَ","Thus","رُسُلَنَا وَٱلَّذِينَ ءَامَنُوا۟ ۚ","حَقًّا عَلَيْنَا نُنجِ",19],["11:49:1",227,"تِلْكَ","This","","مِنْ أَنۢبَآءِ ٱلْغَيْبِ",19],["11:59:1",228,"وَتِلْكَ","And this","","عَادٌۭ ۖ جَحَدُوا۟ بِـَٔايَـٰتِ",19],["11:65:8",229,"ذَٰلِكَ","That","دَارِكُمْ ثَلَـٰثَةَ أَيَّامٍۢ ۖ","وَعْدٌ غَيْرُ مَكْذُوبٍۢ",19],["11:100:1",233,"ذَٰلِكَ","That","","مِنْ أَنۢبَآءِ ٱلْقُرَىٰ",19],["11:102:1",233,"وَكَذَٰلِكَ","And thus","","أَخْذُ رَبِّكَ إِذَآ",19],["11:103:3",233,"ذَٰلِكَ","that","إِنَّ فِى","لَـَٔايَةًۭ لِّمَنْ خَافَ",19],["11:103:9",233,"ذَٰلِكَ","That","خَافَ عَذَابَ ٱلْـَٔاخِرَةِ ۚ","يَوْمٌۭ مَّجْمُوعٌۭ لَّهُ",19],["11:103:14",233,"وَذَٰلِكَ","and that","مَّجْمُوعٌۭ لَّهُ ٱلنَّاسُ","يَوْمٌۭ مَّشْهُودٌۭ",19],["11:114:12",234,"ذَٰلِكَ","That","ٱلْحَسَنَـٰتِ يُذْهِبْنَ ٱلسَّيِّـَٔاتِ ۚ","ذِكْرَىٰ لِلذَّٰكِرِينَ",19],["11:119:5",235,"وَلِذَٰلِكَ","and for that","مَن رَّحِمَ رَبُّكَ ۚ","خَلَقَهُمْ ۗ وَتَمَّتْ كَلِمَةُ",19],["12:1:2",235,"تِلْكَ","These","الٓر ۚ","ءَايَـٰتُ ٱلْكِتَـٰبِ ٱلْمُبِينِ",19],["12:6:1",236,"وَكَذَٰلِكَ","And thus","","يَجْتَبِيكَ رَبُّكَ وَيُعَلِّمُكَ",19],["12:21:15",237,"وَكَذَٰلِكَ","And thus","أَوْ نَتَّخِذَهُۥ وَلَدًۭا ۚ","مَكَّنَّا لِيُوسُفَ فِى",19],["12:22:7",237,"وَكَذَٰلِكَ","And thus","ءَاتَيْنَـٰهُ حُكْمًۭا وَعِلْمًۭا ۚ","نَجْزِى ٱلْمُحْسِنِينَ",19],["12:24:11",238,"كَذَٰلِكَ","Thus","رَّءَا بُرْهَـٰنَ رَبِّهِۦ ۚ","لِنَصْرِفَ عَنْهُ ٱلسُّوٓءَ",19],["12:32:2",239,"فَذَٰلِكُنَّ","That","قَالَتْ","ٱلَّذِى لُمْتُنَّنِى فِيهِ ۖ",19],["12:37:12",239,"ذَٰلِكُمَا","That","قَبْلَ أَن يَأْتِيَكُمَا ۚ","مِمَّا عَلَّمَنِى رَبِّىٓ ۚ",19],["12:38:15",240,"ذَٰلِكَ","That","بِٱللَّهِ مِن شَىْءٍۢ ۚ","مِن فَضْلِ ٱللَّهِ",19],["12:40:25",240,"ذَٰلِكَ","That","تَعْبُدُوٓا۟ إِلَّآ إِيَّاهُ ۚ","ٱلدِّينُ ٱلْقَيِّمُ وَلَـٰكِنَّ",19],["12:48:5",241,"ذَٰلِكَ","that","يَأْتِى مِنۢ بَعْدِ","سَبْعٌۭ شِدَادٌۭ يَأْكُلْنَ",19],["12:49:5",241,"ذَٰلِكَ","that","يَأْتِى مِنۢ بَعْدِ","عَامٌۭ فِيهِ يُغَاثُ",19],["12:52:1",241,"ذَٰلِكَ","That","","لِيَعْلَمَ أَنِّى لَمْ",19],["12:56:1",242,"وَكَذَٰلِكَ","And thus","","مَكَّنَّا لِيُوسُفَ فِى",19],["12:65:23",243,"ذَٰلِكَ","That","وَنَزْدَادُ كَيْلَ بَعِيرٍۢ ۖ","كَيْلٌۭ يَسِيرٌۭ",19],["12:75:9",244,"كَذَٰلِكَ","Thus","رَحْلِهِۦ فَهُوَ جَزَٰٓؤُهُۥ ۚ","نَجْزِى ٱلظَّـٰلِمِينَ",19],["12:76:11",244,"كَذَٰلِكَ","Thus","مِن وِعَآءِ أَخِيهِ ۚ","كِدْنَا لِيُوسُفَ ۖ مَا",19],["12:102:1",247,"ذَٰلِكَ","That","","مِنْ أَنۢبَآءِ ٱلْغَيْبِ",19],["13:1:2",249,"تِلْكَ","These","الٓمٓر ۚ","ءَايَـٰتُ ٱلْكِتَـٰبِ ۗ وَٱلَّذِىٓ",19],["13:3:21",249,"ذَٰلِكَ","that","ٱلنَّهَارَ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يَتَفَكَّرُونَ",19],["13:4:24",249,"ذَٰلِكَ","that","ٱلْأُكُلِ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يَعْقِلُونَ",19],["13:17:23",251,"كَذَٰلِكَ","Thus","مَتَـٰعٍۢ زَبَدٌۭ مِّثْلُهُۥ ۚ","يَضْرِبُ ٱللَّهُ ٱلْحَقَّ",19],["13:17:39",251,"كَذَٰلِكَ","Thus","فَيَمْكُثُ فِى ٱلْأَرْضِ ۚ","يَضْرِبُ ٱللَّهُ ٱلْأَمْثَالَ",19],["13:30:1",253,"كَذَٰلِكَ","Thus","","أَرْسَلْنَـٰكَ فِىٓ أُمَّةٍۢ",19],["13:35:13",254,"تِلْكَ","This","أُكُلُهَا دَآئِمٌۭ وَظِلُّهَا ۚ","عُقْبَى ٱلَّذِينَ ٱتَّقَوا۟ ۖ",19],["13:37:1",254,"وَكَذَٰلِكَ","And thus","","أَنزَلْنَـٰهُ حُكْمًا عَرَبِيًّۭا ۚ",19],["14:5:17",255,"ذَٰلِكَ","that","ٱللَّهِ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّكُلِّ صَبَّارٍۢ",19],["14:6:22",256,"ذَٰلِكُم","that","وَيَسْتَحْيُونَ نِسَآءَكُمْ ۚ وَفِى","بَلَآءٌۭ مِّن رَّبِّكُمْ",19],["14:14:5",257,"ذَٰلِكَ","That","ٱلْأَرْضَ مِنۢ بَعْدِهِمْ ۚ","لِمَنْ خَافَ مَقَامِى",19],["14:18:19",257,"ذَٰلِكَ","That","كَسَبُوا۟ عَلَىٰ شَىْءٍۢ ۚ","هُوَ ٱلضَّلَـٰلُ ٱلْبَعِيدُ",19],["14:20:2",258,"ذَٰلِكَ","(is) that","وَمَا","عَلَى ٱللَّهِ بِعَزِيزٍۢ",19],["15:1:2",262,"تِلْكَ","These","الٓر ۚ","ءَايَـٰتُ ٱلْكِتَـٰبِ وَقُرْءَانٍۢ",19],["15:12:1",262,"كَذَٰلِكَ","Thus","","نَسْلُكُهُۥ فِى قُلُوبِ",19],["15:66:3",265,"ذَٰلِكَ","[that]","وَقَضَيْنَآ إِلَيْهِ","ٱلْأَمْرَ أَنَّ دَابِرَ",19],["15:75:3",266,"ذَٰلِكَ","that","إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّلْمُتَوَسِّمِينَ",19],["15:77:3",266,"ذَٰلِكَ","that","إِنَّ فِى","لَـَٔايَةًۭ لِّلْمُؤْمِنِينَ",19],["16:11:13",268,"ذَٰلِكَ","that","ٱلثَّمَرَٰتِ ۗ إِنَّ فِى","لَـَٔايَةًۭ لِّقَوْمٍۢ يَتَفَكَّرُونَ",19],["16:12:12",268,"ذَٰلِكَ","that","بِأَمْرِهِۦٓ ۗ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يَعْقِلُونَ",19],["16:13:10",268,"ذَٰلِكَ","that","أَلْوَٰنُهُۥٓ ۗ إِنَّ فِى","لَـَٔايَةًۭ لِّقَوْمٍۢ يَذَّكَّرُونَ",19],["16:31:12",270,"كَذَٰلِكَ","Thus","فِيهَا مَا يَشَآءُونَ ۚ","يَجْزِى ٱللَّهُ ٱلْمُتَّقِينَ",19],["16:33:11",270,"كَذَٰلِكَ","Thus","يَأْتِىَ أَمْرُ رَبِّكَ ۚ","فَعَلَ ٱلَّذِينَ مِن",19],["16:35:22",271,"كَذَٰلِكَ","Thus","دُونِهِۦ مِن شَىْءٍۢ ۚ","فَعَلَ ٱلَّذِينَ مِن",19],["16:65:13",274,"ذَٰلِكَ","that","مَوْتِهَآ ۚ إِنَّ فِى","لَـَٔايَةًۭ لِّقَوْمٍۢ يَسْمَعُونَ",19],["16:67:12",274,"ذَٰلِكَ","that","حَسَنًا ۗ إِنَّ فِى","لَـَٔايَةًۭ لِّقَوْمٍۢ يَعْقِلُونَ",19],["16:69:21",274,"ذَٰلِكَ","that","لِّلنَّاسِ ۗ إِنَّ فِى","لَـَٔايَةًۭ لِّقَوْمٍۢ يَتَفَكَّرُونَ",19],["16:79:15",275,"ذَٰلِكَ","that","ٱللَّهُ ۗ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يُؤْمِنُونَ",19],["16:81:20",276,"كَذَٰلِكَ","Thus","وَسَرَٰبِيلَ تَقِيكُم بَأْسَكُمْ ۚ","يُتِمُّ نِعْمَتَهُۥ عَلَيْكُمْ",19],["16:107:1",279,"ذَٰلِكَ","That (is)","","بِأَنَّهُمُ ٱسْتَحَبُّوا۟ ٱلْحَيَوٰةَ",19],["16:119:12",281,"ذَٰلِكَ","that","تَابُوا۟ مِنۢ بَعْدِ","وَأَصْلَحُوٓا۟ إِنَّ رَبَّكَ",19],["17:35:8",285,"ذَٰلِكَ","That","وَزِنُوا۟ بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ ۚ","خَيْرٌۭ وَأَحْسَنُ تَأْوِيلًۭا",19],["17:38:2",285,"ذَٰلِكَ","that","كُلُّ","كَانَ سَيِّئُهُۥ عِندَ",19],["17:39:1",286,"ذَٰلِكَ","That","","مِمَّآ أَوْحَىٰٓ إِلَيْكَ",19],["17:58:15",287,"ذَٰلِكَ","That is","عَذَابًۭا شَدِيدًۭا ۚ كَانَ","فِى ٱلْكِتَـٰبِ مَسْطُورًۭا",19],["17:98:1",292,"ذَٰلِكَ","That","","جَزَآؤُهُم بِأَنَّهُمْ كَفَرُوا۟",19],["17:110:21",293,"ذَٰلِكَ","that","بِهَا وَٱبْتَغِ بَيْنَ","سَبِيلًۭا",19],["18:17:19",295,"ذَٰلِكَ","That","فِى فَجْوَةٍۢ مِّنْهُ ۚ","مِنْ ءَايَـٰتِ ٱللَّهِ ۗ",19],["18:19:1",295,"وَكَذَٰلِكَ","And similarly","","بَعَثْنَـٰهُمْ لِيَتَسَآءَلُوا۟ بَيْنَهُمْ ۚ",19],["18:21:1",296,"وَكَذَٰلِكَ","And similarly","","أَعْثَرْنَا عَلَيْهِمْ لِيَعْلَمُوٓا۟",19],["18:23:6",296,"ذَٰلِكَ","that","لِشَا۟ىْءٍ إِنِّى فَاعِلٌۭ","غَدًا",19],["18:59:1",300,"وَتِلْكَ","And these","","ٱلْقُرَىٰٓ أَهْلَكْنَـٰهُمْ لَمَّا",19],["18:64:2",301,"ذَٰلِكَ","That","قَالَ","مَا كُنَّا نَبْغِ ۚ",19],["18:82:29",302,"ذَٰلِكَ","That","فَعَلْتُهُۥ عَنْ أَمْرِى ۚ","تَأْوِيلُ مَا لَمْ",19],["18:91:1",303,"كَذَٰلِكَ","Thus","","وَقَدْ أَحَطْنَا بِمَا",19],["18:106:1",304,"ذَٰلِكَ","That","","جَزَآؤُهُمْ جَهَنَّمُ بِمَا",19],["19:9:2",305,"كَذَٰلِكَ","Thus","قَالَ","قَالَ رَبُّكَ هُوَ",19],["19:21:2",306,"كَذَٰلِكِ","Thus","قَالَ","قَالَ رَبُّكِ هُوَ",19],["19:34:1",307,"ذَٰلِكَ","That","","عِيسَى ٱبْنُ مَرْيَمَ ۚ",19],["19:63:1",309,"تِلْكَ","This","","ٱلْجَنَّةُ ٱلَّتِى نُورِثُ",19],["19:64:14",309,"ذَٰلِكَ ۚ","that","خَلْفَنَا وَمَا بَيْنَ","وَمَا كَانَ رَبُّكَ",19],["20:17:2",313,"تِلْكَ","(is) that","وَمَا","بِيَمِينِكَ يَـٰمُوسَىٰ",19],["20:54:6",315,"ذَٰلِكَ","that","أَنْعَـٰمَكُمْ ۗ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّأُو۟لِى ٱلنُّهَىٰ",19],["20:76:9",316,"وَذَٰلِكَ","And that","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا ۚ","جَزَآءُ مَن تَزَكَّىٰ",19],["20:87:13",317,"فَكَذَٰلِكَ","and thus","زِينَةِ ٱلْقَوْمِ فَقَذَفْنَـٰهَا","أَلْقَى ٱلسَّامِرِىُّ",19],["20:96:13",318,"وَكَذَٰلِكَ","and thus","أَثَرِ ٱلرَّسُولِ فَنَبَذْتُهَا","سَوَّلَتْ لِى نَفْسِى",19],["20:99:1",319,"كَذَٰلِكَ","Thus","","نَقُصُّ عَلَيْكَ مِنْ",19],["20:113:1",319,"وَكَذَٰلِكَ","And thus","","أَنزَلْنَـٰهُ قُرْءَانًا عَرَبِيًّۭا",19],["20:126:2",321,"كَذَٰلِكَ","Thus","قَالَ","أَتَتْكَ ءَايَـٰتُنَا فَنَسِيتَهَا ۖ",19],["20:126:6",321,"وَكَذَٰلِكَ","and thus","أَتَتْكَ ءَايَـٰتُنَا فَنَسِيتَهَا ۖ","ٱلْيَوْمَ تُنسَىٰ",19],["20:127:1",321,"وَكَذَٰلِكَ","And thus","","نَجْزِى مَنْ أَسْرَفَ",19],["20:128:14",321,"ذَٰلِكَ","that","مَسَـٰكِنِهِمْ ۗ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّأُو۟لِى ٱلنُّهَىٰ",19],["21:15:3",323,"تِّلْكَ","[this]","فَمَا زَالَت","دَعْوَىٰهُمْ حَتَّىٰ جَعَلْنَـٰهُمْ",19],["21:29:8",324,"فَذَٰلِكَ","Then that","إِلَـٰهٌۭ مِّن دُونِهِۦ","نَجْزِيهِ جَهَنَّمَ ۚ كَذَٰلِكَ",19],["21:29:11",324,"كَذَٰلِكَ","Thus","فَذَٰلِكَ نَجْزِيهِ جَهَنَّمَ ۚ","نَجْزِى ٱلظَّـٰلِمِينَ",19],["21:56:11",326,"ذَٰلِكُم","that","فَطَرَهُنَّ وَأَنَا۠ عَلَىٰ","مِّنَ ٱلشَّـٰهِدِينَ",19],["21:82:9",329,"ذَٰلِكَ ۖ","that","وَيَعْمَلُونَ عَمَلًۭا دُونَ","وَكُنَّا لَهُمْ حَـٰفِظِينَ",19],["21:88:6",329,"وَكَذَٰلِكَ","And thus","وَنَجَّيْنَـٰهُ مِنَ ٱلْغَمِّ ۚ","نُـۨجِى ٱلْمُؤْمِنِينَ",19],["22:6:1",333,"ذَٰلِكَ","That","","بِأَنَّ ٱللَّهَ هُوَ",19],["22:10:1",333,"ذَٰلِكَ","That","","بِمَا قَدَّمَتْ يَدَاكَ",19],["22:11:22",333,"ذَٰلِكَ","That","خَسِرَ ٱلدُّنْيَا وَٱلْـَٔاخِرَةَ ۚ","هُوَ ٱلْخُسْرَانُ ٱلْمُبِينُ",19],["22:12:11",333,"ذَٰلِكَ","That","وَمَا لَا يَنفَعُهُۥ ۚ","هُوَ ٱلضَّلَـٰلُ ٱلْبَعِيدُ",19],["22:16:1",334,"وَكَذَٰلِكَ","And thus","","أَنزَلْنَـٰهُ ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ",19],["22:30:1",335,"ذَٰلِكَ","That","","وَمَن يُعَظِّمْ حُرُمَـٰتِ",19],["22:32:1",336,"ذَٰلِكَ","That","","وَمَن يُعَظِّمْ شَعَـٰٓئِرَ",19],["22:36:23",336,"كَذَٰلِكَ","Thus","وَأَطْعِمُوا۟ ٱلْقَانِعَ وَٱلْمُعْتَرَّ ۚ","سَخَّرْنَـٰهَا لَكُمْ لَعَلَّكُمْ",19],["22:37:11",336,"كَذَٰلِكَ","Thus","يَنَالُهُ ٱلتَّقْوَىٰ مِنكُمْ ۚ","سَخَّرَهَا لَكُمْ لِتُكَبِّرُوا۟",19],["22:60:1",339,"۞ ذَٰلِكَ","That","","وَمَنْ عَاقَبَ بِمِثْلِ",19],["22:61:1",339,"ذَٰلِكَ","That","","بِأَنَّ ٱللَّهَ يُولِجُ",19],["22:62:1",339,"ذَٰلِكَ","That (is)","","بِأَنَّ ٱللَّهَ هُوَ",19],["22:70:11",340,"ذَٰلِكَ","that","ٱلسَّمَآءِ وَٱلْأَرْضِ ۗ إِنَّ","فِى كِتَـٰبٍ ۚ إِنَّ",19],["22:70:15",340,"ذَٰلِكَ","that","فِى كِتَـٰبٍ ۚ إِنَّ","عَلَى ٱللَّهِ يَسِيرٌۭ",19],["22:72:22",340,"ذَٰلِكُمُ ۗ","that","أَفَأُنَبِّئُكُم بِشَرٍّۢ مِّن","ٱلنَّارُ وَعَدَهَا ٱللَّهُ",19],["23:7:4",342,"ذَٰلِكَ","that","فَمَنِ ٱبْتَغَىٰ وَرَآءَ","فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ",19],["23:15:4",342,"ذَٰلِكَ","that","ثُمَّ إِنَّكُم بَعْدَ","لَمَيِّتُونَ",19],["23:30:3",344,"ذَٰلِكَ","that","إِنَّ فِى","لَـَٔايَـٰتٍۢ وَإِن كُنَّا",19],["23:63:11",346,"ذَٰلِكَ","that","أَعْمَـٰلٌۭ مِّن دُونِ","هُمْ لَهَا عَـٰمِلُونَ",19],["24:3:16",350,"ذَٰلِكَ","that","أَوْ مُشْرِكٌۭ ۚ وَحُرِّمَ","عَلَى ٱلْمُؤْمِنِينَ",19],["24:5:6",350,"ذَٰلِكَ","that","تَابُوا۟ مِنۢ بَعْدِ","وَأَصْلَحُوا۟ فَإِنَّ ٱللَّهَ",19],["24:27:14",352,"ذَٰلِكُمْ","That","وَتُسَلِّمُوا۟ عَلَىٰٓ أَهْلِهَا ۚ","خَيْرٌۭ لَّكُمْ لَعَلَّكُمْ",19],["24:30:8",353,"ذَٰلِكَ","That","أَبْصَـٰرِهِمْ وَيَحْفَظُوا۟ فُرُوجَهُمْ ۚ","أَزْكَىٰ لَهُمْ ۗ إِنَّ",19],["24:44:7",356,"ذَٰلِكَ","that","وَٱلنَّهَارَ ۚ إِنَّ فِى","لَعِبْرَةًۭ لِّأُو۟لِى ٱلْأَبْصَـٰرِ",19],["24:47:12",356,"ذَٰلِكَ ۚ","that","مِّنْهُم مِّنۢ بَعْدِ","وَمَآ أُو۟لَـٰٓئِكَ بِٱلْمُؤْمِنِينَ",19],["24:55:35",357,"ذَٰلِكَ","that","وَمَن كَفَرَ بَعْدَ","فَأُو۟لَـٰٓئِكَ هُمُ ٱلْفَـٰسِقُونَ",19],["24:58:42",357,"كَذَٰلِكَ","Thus","بَعْضُكُمْ عَلَىٰ بَعْضٍۢ ۚ","يُبَيِّنُ ٱللَّهُ لَكُمُ",19],["24:59:12",358,"كَذَٰلِكَ","Thus","ٱلَّذِينَ مِن قَبْلِهِمْ ۚ","يُبَيِّنُ ٱللَّهُ لَكُمْ",19],["24:61:70",358,"كَذَٰلِكَ","Thus","ٱللَّهِ مُبَـٰرَكَةًۭ طَيِّبَةًۭ ۚ","يُبَيِّنُ ٱللَّهُ لَكُمُ",19],["25:10:9",360,"ذَٰلِكَ","that","لَكَ خَيْرًۭا مِّن","جَنَّـٰتٍۢ تَجْرِى مِن",19],["25:15:2",361,"أَذَٰلِكَ","Is that","قُلْ","خَيْرٌ أَمْ جَنَّةُ",19],["25:31:1",362,"وَكَذَٰلِكَ","And thus","","جَعَلْنَا لِكُلِّ نَبِىٍّ",19],["25:32:10",362,"كَذَٰلِكَ","Thus","ٱلْقُرْءَانُ جُمْلَةًۭ وَٰحِدَةًۭ ۚ","لِنُثَبِّتَ بِهِۦ فُؤَادَكَ ۖ",19],["25:38:7",363,"ذَٰلِكَ","that","ٱلرَّسِّ وَقُرُونًۢا بَيْنَ","كَثِيرًۭا",19],["25:67:10",365,"ذَٰلِكَ","that","يَقْتُرُوا۟ وَكَانَ بَيْنَ","قَوَامًۭا",19],["25:68:20",366,"ذَٰلِكَ","that","يَزْنُونَ ۚ وَمَن يَفْعَلْ","يَلْقَ أَثَامًۭا",19],["26:2:1",367,"تِلْكَ","These","","ءَايَـٰتُ ٱلْكِتَـٰبِ ٱلْمُبِينِ",19],["26:8:3",367,"ذَٰلِكَ","that","إِنَّ فِى","لَـَٔايَةًۭ ۖ وَمَا كَانَ",19],["26:22:1",368,"وَتِلْكَ","And this","","نِعْمَةٌۭ تَمُنُّهَا عَلَىَّ",19],["26:59:1",369,"كَذَٰلِكَ","Thus","","وَأَوْرَثْنَـٰهَا بَنِىٓ إِسْرَٰٓءِيلَ",19],["26:67:3",370,"ذَٰلِكَ","that","إِنَّ فِى","لَـَٔايَةًۭ ۖ وَمَا كَانَ",19],["26:74:5",370,"كَذَٰلِكَ","like that","بَلْ وَجَدْنَآ ءَابَآءَنَا","يَفْعَلُونَ",19],["26:103:3",371,"ذَٰلِكَ","that","إِنَّ فِى","لَـَٔايَةًۭ ۖ وَمَا كَانَ",19],["26:121:3",372,"ذَٰلِكَ","that","إِنَّ فِى","لَـَٔايَةًۭ ۖ وَمَا كَانَ",19],["26:139:5",373,"ذَٰلِكَ","that","فَأَهْلَكْنَـٰهُمْ ۗ إِنَّ فِى","لَـَٔايَةًۭ ۖ وَمَا كَانَ",19],["26:158:5",373,"ذَٰلِكَ","that","ٱلْعَذَابُ ۗ إِنَّ فِى","لَـَٔايَةًۭ ۖ وَمَا كَانَ",19],["26:174:3",374,"ذَٰلِكَ","that","إِنَّ فِى","لَـَٔايَةًۭ ۖ وَمَا كَانَ",19],["26:190:3",375,"ذَٰلِكَ","that","إِنَّ فِى","لَـَٔايَةًۭ ۖ وَمَا كَانَ",19],["26:200:1",375,"كَذَٰلِكَ","Thus","","سَلَكْنَـٰهُ فِى قُلُوبِ",19],["27:1:2",377,"تِلْكَ","These","طسٓ ۚ","ءَايَـٰتُ ٱلْقُرْءَانِ وَكِتَابٍۢ",19],["27:34:12",379,"وَكَذَٰلِكَ","And thus","أَعِزَّةَ أَهْلِهَآ أَذِلَّةًۭ ۖ","يَفْعَلُونَ",19],["27:52:1",381,"فَتِلْكَ","So, these","","بُيُوتُهُمْ خَاوِيَةًۢ بِمَا",19],["27:52:8",381,"ذَٰلِكَ","that","ظَلَمُوٓا۟ ۗ إِنَّ فِى","لَـَٔايَةًۭ لِّقَوْمٍۢ يَعْلَمُونَ",19],["27:86:12",384,"ذَٰلِكَ","that","مُبْصِرًا ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يُؤْمِنُونَ",19],["28:2:1",385,"تِلْكَ","These","","ءَايَـٰتُ ٱلْكِتَـٰبِ ٱلْمُبِينِ",19],["28:14:8",387,"وَكَذَٰلِكَ","And thus","ءَاتَيْنَـٰهُ حُكْمًۭا وَعِلْمًۭا ۚ","نَجْزِى ٱلْمُحْسِنِينَ",19],["28:28:2",388,"ذَٰلِكَ","That","قَالَ","بَيْنِى وَبَيْنَكَ ۖ أَيَّمَا",19],["28:58:7",392,"فَتِلْكَ","And these","قَرْيَةٍۭ بَطِرَتْ مَعِيشَتَهَا ۖ","مَسَـٰكِنُهُمْ لَمْ تُسْكَن",19],["28:83:1",395,"تِلْكَ","That","","ٱلدَّارُ ٱلْـَٔاخِرَةُ نَجْعَلُهَا",19],["29:16:8",398,"ذَٰلِكُمْ","That","ٱعْبُدُوا۟ ٱللَّهَ وَٱتَّقُوهُ ۖ","خَيْرٌۭ لَّكُمْ إِن",19],["29:19:10",398,"ذَٰلِكَ","that","ثُمَّ يُعِيدُهُۥٓ ۚ إِنَّ","عَلَى ٱللَّهِ يَسِيرٌۭ",19],["29:24:17",399,"ذَٰلِكَ","that","ٱلنَّارِ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يُؤْمِنُونَ",19],["29:43:1",401,"وَتِلْكَ","And these","","ٱلْأَمْثَـٰلُ نَضْرِبُهَا لِلنَّاسِ ۖ",19],["29:44:8",401,"ذَٰلِكَ","that","بِٱلْحَقِّ ۚ إِنَّ فِى","لَـَٔايَةًۭ لِّلْمُؤْمِنِينَ",19],["29:47:1",402,"وَكَذَٰلِكَ","And thus","","أَنزَلْنَآ إِلَيْكَ ٱلْكِتَـٰبَ ۚ",19],["29:51:11",402,"ذَٰلِكَ","that","عَلَيْهِمْ ۚ إِنَّ فِى","لَرَحْمَةًۭ وَذِكْرَىٰ لِقَوْمٍۢ",19],["30:19:13",406,"وَكَذَٰلِكَ","and thus","ٱلْأَرْضَ بَعْدَ مَوْتِهَا ۚ","تُخْرَجُونَ",19],["30:21:17",406,"ذَٰلِكَ","that","وَرَحْمَةً ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يَتَفَكَّرُونَ",19],["30:22:11",406,"ذَٰلِكَ","that","وَأَلْوَٰنِكُمْ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّلْعَـٰلِمِينَ",19],["30:23:11",406,"ذَٰلِكَ","that","فَضْلِهِۦٓ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يَسْمَعُونَ",19],["30:24:18",406,"ذَٰلِكَ","that","مَوْتِهَآ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يَعْقِلُونَ",19],["30:28:23",407,"كَذَٰلِكَ","Thus","تَخَافُونَهُمْ كَخِيفَتِكُمْ أَنفُسَكُمْ ۚ","نُفَصِّلُ ٱلْـَٔايَـٰتِ لِقَوْمٍۢ",19],["30:30:15",407,"ذَٰلِكَ","That","تَبْدِيلَ لِخَلْقِ ٱللَّهِ ۚ","ٱلدِّينُ ٱلْقَيِّمُ وَلَـٰكِنَّ",19],["30:37:12",408,"ذَٰلِكَ","that","وَيَقْدِرُ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يُؤْمِنُونَ",19],["30:38:8",408,"ذَٰلِكَ","That","وَٱلْمِسْكِينَ وَٱبْنَ ٱلسَّبِيلِ ۚ","خَيْرٌۭ لِّلَّذِينَ يُرِيدُونَ",19],["30:40:16",408,"ذَٰلِكُم","that","مَّن يَفْعَلُ مِن","مِّن شَىْءٍۢ ۚ سُبْحَـٰنَهُۥ",19],["30:50:12",409,"ذَٰلِكَ","that","بَعْدَ مَوْتِهَآ ۚ إِنَّ","لَمُحْىِ ٱلْمَوْتَىٰ ۖ وَهُوَ",19],["30:55:10",410,"كَذَٰلِكَ","Thus","لَبِثُوا۟ غَيْرَ سَاعَةٍۢ ۚ","كَانُوا۟ يُؤْفَكُونَ",19],["30:59:1",410,"كَذَٰلِكَ","Thus","","يَطْبَعُ ٱللَّهُ عَلَىٰ",19],["31:2:1",411,"تِلْكَ","These","","ءَايَـٰتُ ٱلْكِتَـٰبِ ٱلْحَكِيمِ",19],["31:17:14",412,"ذَٰلِكَ","that","مَآ أَصَابَكَ ۖ إِنَّ","مِنْ عَزْمِ ٱلْأُمُورِ",19],["31:30:1",414,"ذَٰلِكَ","That","","بِأَنَّ ٱللَّهَ هُوَ",19],["31:31:15",414,"ذَٰلِكَ","that","ءَايَـٰتِهِۦٓ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّكُلِّ صَبَّارٍۢ",19],["32:6:1",415,"ذَٰلِكَ","That","","عَـٰلِمُ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ",19],["32:26:15",417,"ذَٰلِكَ","that","مَسَـٰكِنِهِمْ ۚ إِنَّ فِى","لَـَٔايَـٰتٍ ۖ أَفَلَا يَسْمَعُونَ",19],["33:4:20",418,"ذَٰلِكُمْ","That","جَعَلَ أَدْعِيَآءَكُمْ أَبْنَآءَكُمْ ۚ","قَوْلُكُم بِأَفْوَٰهِكُمْ ۖ وَٱللَّهُ",19],["33:6:26",418,"ذَٰلِكَ","That is","أَوْلِيَآئِكُم مَّعْرُوفًۭا ۚ كَانَ","فِى ٱلْكِتَـٰبِ مَسْطُورًۭا",19],["33:19:32",420,"ذَٰلِكَ","that","ٱللَّهُ أَعْمَـٰلَهُمْ ۚ وَكَانَ","عَلَى ٱللَّهِ يَسِيرًۭا",19],["33:30:13",421,"ذَٰلِكَ","And that is","ٱلْعَذَابُ ضِعْفَيْنِ ۚ وَكَانَ","عَلَى ٱللَّهِ يَسِيرًۭا",19],["33:51:16",425,"ذَٰلِكَ","That","فَلَا جُنَاحَ عَلَيْكَ ۚ","أَدْنَىٰٓ أَن تَقَرَّ",19],["33:53:28",425,"ذَٰلِكُمْ","that","مُسْتَـْٔنِسِينَ لِحَدِيثٍ ۚ إِنَّ","كَانَ يُؤْذِى ٱلنَّبِىَّ",19],["33:53:46",425,"ذَٰلِكُمْ","That","مِن وَرَآءِ حِجَابٍۢ ۚ","أَطْهَرُ لِقُلُوبِكُمْ وَقُلُوبِهِنَّ ۚ",19],["33:53:65",425,"ذَٰلِكُمْ","that","بَعْدِهِۦٓ أَبَدًا ۚ إِنَّ","كَانَ عِندَ ٱللَّهِ",19],["33:59:12",426,"ذَٰلِكَ","That","عَلَيْهِنَّ مِن جَلَـٰبِيبِهِنَّ ۚ","أَدْنَىٰٓ أَن يُعْرَفْنَ",19],["34:3:26",428,"ذَٰلِكَ","that","وَلَآ أَصْغَرُ مِن","وَلَآ أَكْبَرُ إِلَّا",19],["34:9:25",429,"ذَٰلِكَ","that","ٱلسَّمَآءِ ۚ إِنَّ فِى","لَـَٔايَةًۭ لِّكُلِّ عَبْدٍۢ",19],["34:17:1",430,"ذَٰلِكَ","That","","جَزَيْنَـٰهُم بِمَا كَفَرُوا۟ ۖ",19],["34:19:15",430,"ذَٰلِكَ","that","مُمَزَّقٍ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّكُلِّ صَبَّارٍۢ",19],["35:9:16",435,"كَذَٰلِكَ","Thus","ٱلْأَرْضَ بَعْدَ مَوْتِهَا ۚ","ٱلنُّشُورُ",19],["35:11:31",435,"ذَٰلِكَ","that","فِى كِتَـٰبٍ ۚ إِنَّ","عَلَى ٱللَّهِ يَسِيرٌۭ",19],["35:13:16",436,"ذَٰلِكُمُ","That (is)","يَجْرِى لِأَجَلٍۢ مُّسَمًّۭى ۚ","ٱللَّهُ رَبُّكُمْ لَهُ",19],["35:17:2",436,"ذَٰلِكَ","that","وَمَا","عَلَى ٱللَّهِ بِعَزِيزٍۢ",19],["35:28:7",437,"كَذَٰلِكَ ۗ","likewise","وَٱلْأَنْعَـٰمِ مُخْتَلِفٌ أَلْوَٰنُهُۥ","إِنَّمَا يَخْشَى ٱللَّهَ",19],["35:32:18",438,"ذَٰلِكَ","That","بِٱلْخَيْرَٰتِ بِإِذْنِ ٱللَّهِ ۚ","هُوَ ٱلْفَضْلُ ٱلْكَبِيرُ",19],["35:36:15",438,"كَذَٰلِكَ","Thus","عَنْهُم مِّنْ عَذَابِهَا ۚ","نَجْزِى كُلَّ كَفُورٍۢ",19],["36:38:5",442,"ذَٰلِكَ","That","تَجْرِى لِمُسْتَقَرٍّۢ لَّهَا ۚ","تَقْدِيرُ ٱلْعَزِيزِ ٱلْعَلِيمِ",19],["37:34:2",447,"كَذَٰلِكَ","thus","إِنَّا","نَفْعَلُ بِٱلْمُجْرِمِينَ",19],["37:62:1",448,"أَذَٰلِكَ","Is that","","خَيْرٌۭ نُّزُلًا أَمْ",19],["37:80:2",449,"كَذَٰلِكَ","thus","إِنَّا","نَجْزِى ٱلْمُحْسِنِينَ",19],["37:105:5",450,"كَذَٰلِكَ","thus","صَدَّقْتَ ٱلرُّءْيَآ ۚ إِنَّا","نَجْزِى ٱلْمُحْسِنِينَ",19],["37:110:1",450,"كَذَٰلِكَ","Thus","","نَجْزِى ٱلْمُحْسِنِينَ",19],["37:121:2",450,"كَذَٰلِكَ","thus","إِنَّا","نَجْزِى ٱلْمُحْسِنِينَ",19],["37:131:2",451,"كَذَٰلِكَ","thus","إِنَّا","نَجْزِى ٱلْمُحْسِنِينَ",19],["38:25:3",454,"ذَٰلِكَ ۖ","that","فَغَفَرْنَا لَهُۥ","وَإِنَّ لَهُۥ عِندَنَا",19],["38:27:8",455,"ذَٰلِكَ","That","وَمَا بَيْنَهُمَا بَـٰطِلًۭا ۚ","ظَنُّ ٱلَّذِينَ كَفَرُوا۟ ۚ",19],["38:64:2",457,"ذَٰلِكَ","that","إِنَّ","لَحَقٌّۭ تَخَاصُمُ أَهْلِ",19],["39:6:26",459,"ذَٰلِكُمُ","That","فِى ظُلُمَـٰتٍۢ ثَلَـٰثٍۢ ۚ","ٱللَّهُ رَبُّكُمْ لَهُ",19],["39:15:16",460,"ذَٰلِكَ","that","يَوْمَ ٱلْقِيَـٰمَةِ ۗ أَلَا","هُوَ ٱلْخُسْرَانُ ٱلْمُبِينُ",19],["39:16:10",460,"ذَٰلِكَ","(With) that","وَمِن تَحْتِهِمْ ظُلَلٌۭ ۚ","يُخَوِّفُ ٱللَّهُ بِهِۦ",19],["39:21:28",460,"ذَٰلِكَ","that","حُطَـٰمًا ۚ إِنَّ فِى","لَذِكْرَىٰ لِأُو۟لِى ٱلْأَلْبَـٰبِ",19],["39:23:21",461,"ذَٰلِكَ","That","إِلَىٰ ذِكْرِ ٱللَّهِ ۚ","هُدَى ٱللَّهِ يَهْدِى",19],["39:34:6",462,"ذَٰلِكَ","That","يَشَآءُونَ عِندَ رَبِّهِمْ ۚ","جَزَآءُ ٱلْمُحْسِنِينَ",19],["39:42:23",463,"ذَٰلِكَ","that","مُّسَمًّى ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يَتَفَكَّرُونَ",19],["39:52:12",464,"ذَٰلِكَ","that","وَيَقْدِرُ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يُؤْمِنُونَ",19],["40:6:1",467,"وَكَذَٰلِكَ","And thus","","حَقَّتْ كَلِمَتُ رَبِّكَ",19],["40:9:9",468,"وَذَٰلِكَ","And that","يَوْمَئِذٍۢ فَقَدْ رَحِمْتَهُۥ ۚ","هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ",19],["40:12:1",468,"ذَٰلِكُم","That","","بِأَنَّهُۥٓ إِذَا دُعِىَ",19],["40:22:1",469,"ذَٰلِكَ","That","","بِأَنَّهُمْ كَانَت تَّأْتِيهِمْ",19],["40:34:24",471,"كَذَٰلِكَ","Thus","مِنۢ بَعْدِهِۦ رَسُولًۭا ۚ","يُضِلُّ ٱللَّهُ مَنْ",19],["40:35:16",471,"كَذَٰلِكَ","Thus","وَعِندَ ٱلَّذِينَ ءَامَنُوا۟ ۚ","يَطْبَعُ ٱللَّهُ عَلَىٰ",19],["40:37:10",471,"وَكَذَٰلِكَ","And thus","وَإِنِّى لَأَظُنُّهُۥ كَـٰذِبًۭا ۚ","زُيِّنَ لِفِرْعَوْنَ سُوٓءُ",19],["40:62:1",474,"ذَٰلِكُمُ","That","","ٱللَّهُ رَبُّكُمْ خَـٰلِقُ",19],["40:63:1",474,"كَذَٰلِكَ","Thus","","يُؤْفَكُ ٱلَّذِينَ كَانُوا۟",19],["40:64:15",474,"ذَٰلِكُمُ","That","وَرَزَقَكُم مِّنَ ٱلطَّيِّبَـٰتِ ۚ","ٱللَّهُ رَبُّكُمْ ۖ فَتَبَارَكَ",19],["40:74:14",475,"كَذَٰلِكَ","Thus","مِن قَبْلُ شَيْـًۭٔا ۚ","يُضِلُّ ٱللَّهُ ٱلْكَـٰفِرِينَ",19],["40:75:1",475,"ذَٰلِكُم","That was","","بِمَا كُنتُمْ تَفْرَحُونَ",19],["41:9:12",477,"ذَٰلِكَ","That","وَتَجْعَلُونَ لَهُۥٓ أَندَادًۭا ۚ","رَبُّ ٱلْعَـٰلَمِينَ",19],["41:12:16",478,"ذَٰلِكَ","That","ٱلدُّنْيَا بِمَصَـٰبِيحَ وَحِفْظًۭا ۚ","تَقْدِيرُ ٱلْعَزِيزِ ٱلْعَلِيمِ",19],["41:23:1",479,"وَذَٰلِكُمْ","And that","","ظَنُّكُمُ ٱلَّذِى ظَنَنتُم",19],["41:28:1",479,"ذَٰلِكَ","That","","جَزَآءُ أَعْدَآءِ ٱللَّهِ",19],["42:3:1",483,"كَذَٰلِكَ","Thus","","يُوحِىٓ إِلَيْكَ وَإِلَى",19],["42:7:1",483,"وَكَذَٰلِكَ","And thus","","أَوْحَيْنَآ إِلَيْكَ قُرْءَانًا",19],["42:10:9",483,"ذَٰلِكُمُ","That","فَحُكْمُهُۥٓ إِلَى ٱللَّهِ ۚ","ٱللَّهُ رَبِّى عَلَيْهِ",19],["42:15:1",484,"فَلِذَٰلِكَ","So to that","","فَٱدْعُ ۖ وَٱسْتَقِمْ كَمَآ",19],["42:22:21",485,"ذَٰلِكَ","That","يَشَآءُونَ عِندَ رَبِّهِمْ ۚ","هُوَ ٱلْفَضْلُ ٱلْكَبِيرُ",19],["42:23:1",486,"ذَٰلِكَ","That","","ٱلَّذِى يُبَشِّرُ ٱللَّهُ",19],["42:33:11",487,"ذَٰلِكَ","that","ظَهْرِهِۦٓ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّكُلِّ صَبَّارٍۢ",19],["42:43:5",487,"ذَٰلِكَ","that","صَبَرَ وَغَفَرَ إِنَّ","لَمِنْ عَزْمِ ٱلْأُمُورِ",19],["42:52:1",489,"وَكَذَٰلِكَ","And thus","","أَوْحَيْنَآ إِلَيْكَ رُوحًۭا",19],["43:11:11",490,"كَذَٰلِكَ","thus","بِهِۦ بَلْدَةًۭ مَّيْتًۭا ۚ","تُخْرَجُونَ",19],["43:20:9",490,"بِذَٰلِكَ","about that","عَبَدْنَـٰهُم ۗ مَّا لَهُم","مِنْ عِلْمٍ ۖ إِنْ",19],["43:23:1",491,"وَكَذَٰلِكَ","And thus","","مَآ أَرْسَلْنَا مِن",19],["43:35:4",492,"ذَٰلِكَ","that","وَزُخْرُفًۭا ۚ وَإِن كُلُّ","لَمَّا مَتَـٰعُ ٱلْحَيَوٰةِ",19],["43:72:1",494,"وَتِلْكَ","And this","","ٱلْجَنَّةُ ٱلَّتِىٓ أُورِثْتُمُوهَا",19],["44:28:1",497,"كَذَٰلِكَ ۖ","Thus","","وَأَوْرَثْنَـٰهَا قَوْمًا ءَاخَرِينَ",19],["44:54:1",498,"كَذَٰلِكَ","Thus","","وَزَوَّجْنَـٰهُم بِحُورٍ عِينٍۢ",19],["44:57:4",498,"ذَٰلِكَ","That","فَضْلًۭا مِّن رَّبِّكَ ۚ","هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ",19],["45:6:1",499,"تِلْكَ","These","","ءَايَـٰتُ ٱللَّهِ نَتْلُوهَا",19],["45:13:13",499,"ذَٰلِكَ","that","مِّنْهُ ۚ إِنَّ فِى","لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يَتَفَكَّرُونَ",19],["45:24:15",501,"بِذَٰلِكَ","of that","ٱلدَّهْرُ ۚ وَمَا لَهُم","مِنْ عِلْمٍ ۖ إِنْ",19],["45:30:10",501,"ذَٰلِكَ","That","رَبُّهُمْ فِى رَحْمَتِهِۦ ۚ","هُوَ ٱلْفَوْزُ ٱلْمُبِينُ",19],["45:35:1",502,"ذَٰلِكُم","That","","بِأَنَّكُمُ ٱتَّخَذْتُمْ ءَايَـٰتِ",19],["46:25:11",505,"كَذَٰلِكَ","Thus","يُرَىٰٓ إِلَّا مَسَـٰكِنُهُمْ ۚ","نَجْزِى ٱلْقَوْمَ ٱلْمُجْرِمِينَ",19],["46:28:13",505,"وَذَٰلِكَ","And that","بَلْ ضَلُّوا۟ عَنْهُمْ ۚ","إِفْكُهُمْ وَمَا كَانُوا۟",19],["47:3:1",507,"ذَٰلِكَ","That","","بِأَنَّ ٱلَّذِينَ كَفَرُوا۟",19],["47:3:14",507,"كَذَٰلِكَ","Thus","ٱلْحَقَّ مِن رَّبِّهِمْ ۚ","يَضْرِبُ ٱللَّهُ لِلنَّاسِ",19],["47:4:21",507,"ذَٰلِكَ","That","تَضَعَ ٱلْحَرْبُ أَوْزَارَهَا ۚ","وَلَوْ يَشَآءُ ٱللَّهُ",19],["47:9:1",507,"ذَٰلِكَ","That","","بِأَنَّهُمْ كَرِهُوا۟ مَآ",19],["47:11:1",507,"ذَٰلِكَ","That","","بِأَنَّ ٱللَّهَ مَوْلَى",19],["47:26:1",509,"ذَٰلِكَ","That","","بِأَنَّهُمْ قَالُوا۟ لِلَّذِينَ",19],["47:28:1",509,"ذَٰلِكَ","That","","بِأَنَّهُمُ ٱتَّبَعُوا۟ مَآ",19],["48:5:15",511,"ذَٰلِكَ","that","عَنْهُمْ سَيِّـَٔاتِهِمْ ۚ وَكَانَ","عِندَ ٱللَّهِ فَوْزًا",19],["48:12:12",512,"ذَٰلِكَ","that was made fair-seeming","أَهْلِيهِمْ أَبَدًۭا وَزُيِّنَ","فِى قُلُوبِكُمْ وَظَنَنتُمْ",19],["48:15:18",512,"كَذَٰلِكُمْ","Thus","قُل لَّن تَتَّبِعُونَا","قَالَ ٱللَّهُ مِن",19],["48:27:26",514,"ذَٰلِكَ","that","فَجَعَلَ مِن دُونِ","فَتْحًۭا قَرِيبًا",19],["48:29:25",515,"ذَٰلِكَ","That","مِّنْ أَثَرِ ٱلسُّجُودِ ۚ","مَثَلُهُمْ فِى ٱلتَّوْرَىٰةِ ۚ",19],["50:3:5",518,"ذَٰلِكَ","That","مِتْنَا وَكُنَّا تُرَابًۭا ۖ","رَجْعٌۢ بَعِيدٌۭ",19],["50:11:7",518,"كَذَٰلِكَ","Thus","بِهِۦ بَلْدَةًۭ مَّيْتًۭا ۚ","ٱلْخُرُوجُ",19],["50:19:5",519,"ذَٰلِكَ","That","سَكْرَةُ ٱلْمَوْتِ بِٱلْحَقِّ ۖ","مَا كُنتَ مِنْهُ",19],["50:20:4",519,"ذَٰلِكَ","That","وَنُفِخَ فِى ٱلصُّورِ ۚ","يَوْمُ ٱلْوَعِيدِ",19],["50:34:3",519,"ذَٰلِكَ","That","ٱدْخُلُوهَا بِسَلَـٰمٍۢ ۖ","يَوْمُ ٱلْخُلُودِ",19],["50:37:3",520,"ذَٰلِكَ","that","إِنَّ فِى","لَذِكْرَىٰ لِمَن كَانَ",19],["50:42:5",520,"ذَٰلِكَ","That","يَسْمَعُونَ ٱلصَّيْحَةَ بِٱلْحَقِّ ۚ","يَوْمُ ٱلْخُرُوجِ",19],["50:44:6",520,"ذَٰلِكَ","That","ٱلْأَرْضُ عَنْهُمْ سِرَاعًۭا ۚ","حَشْرٌ عَلَيْنَا يَسِيرٌۭ",19],["51:16:8",521,"ذَٰلِكَ","that","إِنَّهُمْ كَانُوا۟ قَبْلَ","مُحْسِنِينَ",19],["51:30:2",521,"كَذَٰلِكِ","Thus","قَالُوا۟","قَالَ رَبُّكِ ۖ إِنَّهُۥ",19],["51:52:1",523,"كَذَٰلِكَ","Likewise","","مَآ أَتَى ٱلَّذِينَ",19],["52:47:6",525,"ذَٰلِكَ","that","ظَلَمُوا۟ عَذَابًۭا دُونَ","وَلَـٰكِنَّ أَكْثَرَهُمْ لَا",19],["53:22:1",526,"تِلْكَ","This","","إِذًۭا قِسْمَةٌۭ ضِيزَىٰٓ",19],["53:30:1",527,"ذَٰلِكَ","That","","مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ",19],["54:35:4",530,"كَذَٰلِكَ","Thus","نِّعْمَةًۭ مِّنْ عِندِنَا ۚ","نَجْزِى مَن شَكَرَ",19],["56:45:4",535,"ذَٰلِكَ","that","إِنَّهُمْ كَانُوا۟ قَبْلَ","مُتْرَفِينَ",19],["57:12:19",539,"ذَٰلِكَ","That","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا ۚ","هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ",19],["57:21:16",540,"ذَٰلِكَ","That","ءَامَنُوا۟ بِٱللَّهِ وَرُسُلِهِۦ ۚ","فَضْلُ ٱللَّهِ يُؤْتِيهِ",19],["57:22:18",540,"ذَٰلِكَ","that","أَن نَّبْرَأَهَآ ۚ إِنَّ","عَلَى ٱللَّهِ يَسِيرٌۭ",19],["58:3:15",542,"ذَٰلِكُمْ","That","قَبْلِ أَن يَتَمَآسَّا ۚ","تُوعَظُونَ بِهِۦ ۚ وَٱللَّهُ",19],["58:4:17",542,"ذَٰلِكَ","That","فَإِطْعَامُ سِتِّينَ مِسْكِينًۭا ۚ","لِتُؤْمِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ ۚ",19],["58:4:21",542,"وَتِلْكَ","and these","لِتُؤْمِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ ۚ","حُدُودُ ٱللَّهِ ۗ وَلِلْكَـٰفِرِينَ",19],["58:7:28",543,"ذَٰلِكَ","that","وَلَآ أَدْنَىٰ مِن","وَلَآ أَكْثَرَ إِلَّا",19],["58:12:12",544,"ذَٰلِكَ","That","يَدَىْ نَجْوَىٰكُمْ صَدَقَةًۭ ۚ","خَيْرٌۭ لَّكُمْ وَأَطْهَرُ ۚ",19],["59:4:1",546,"ذَٰلِكَ","That","","بِأَنَّهُمْ شَآقُّوا۟ ٱللَّهَ",19],["59:13:8",547,"ذَٰلِكَ","That","صُدُورِهِم مِّنَ ٱللَّهِ ۚ","بِأَنَّهُمْ قَوْمٌۭ لَّا",19],["59:14:19",547,"ذَٰلِكَ","That","جَمِيعًۭا وَقُلُوبُهُمْ شَتَّىٰ ۚ","بِأَنَّهُمْ قَوْمٌۭ لَّا",19],["59:17:8",548,"وَذَٰلِكَ","And that","ٱلنَّارِ خَـٰلِدَيْنِ فِيهَا ۚ","جَزَٰٓؤُا۟ ٱلظَّـٰلِمِينَ",19],["59:21:13",548,"وَتِلْكَ","And these","مِّنْ خَشْيَةِ ٱللَّهِ ۚ","ٱلْأَمْثَـٰلُ نَضْرِبُهَا لِلنَّاسِ",19],["60:10:48",550,"ذَٰلِكُمْ","That","وَلْيَسْـَٔلُوا۟ مَآ أَنفَقُوا۟ ۚ","حُكْمُ ٱللَّهِ ۖ يَحْكُمُ",19],["61:11:10",552,"ذَٰلِكُمْ","That","ٱللَّهِ بِأَمْوَٰلِكُمْ وَأَنفُسِكُمْ ۚ","خَيْرٌۭ لَّكُمْ إِن",19],["61:12:15",552,"ذَٰلِكَ","That","فِى جَنَّـٰتِ عَدْنٍۢ ۚ","ٱلْفَوْزُ ٱلْعَظِيمُ",19],["62:4:1",553,"ذَٰلِكَ","That","","فَضْلُ ٱللَّهِ يُؤْتِيهِ",19],["62:9:16",554,"ذَٰلِكُمْ","That","ٱللَّهِ وَذَرُوا۟ ٱلْبَيْعَ ۚ","خَيْرٌۭ لَّكُمْ إِن",19],["63:3:1",554,"ذَٰلِكَ","That","","بِأَنَّهُمْ ءَامَنُوا۟ ثُمَّ",19],["63:9:14",555,"ذَٰلِكَ","that","ٱللَّهِ ۚ وَمَن يَفْعَلْ","فَأُو۟لَـٰٓئِكَ هُمُ ٱلْخَـٰسِرُونَ",19],["64:6:1",556,"ذَٰلِكَ","That","","بِأَنَّهُۥ كَانَت تَّأْتِيهِمْ",19],["64:7:15",556,"وَذَٰلِكَ","And that","لَتُنَبَّؤُنَّ بِمَا عَمِلْتُمْ ۚ","عَلَى ٱللَّهِ يَسِيرٌۭ",19],["64:9:5",556,"ذَٰلِكَ","that","يَجْمَعُكُمْ لِيَوْمِ ٱلْجَمْعِ ۖ","يَوْمُ ٱلتَّغَابُنِ ۗ وَمَن",19],["64:9:25",556,"ذَٰلِكَ","That","خَـٰلِدِينَ فِيهَآ أَبَدًۭا ۚ","ٱلْفَوْزُ ٱلْعَظِيمُ",19],["65:1:24",558,"وَتِلْكَ","And these","يَأْتِينَ بِفَـٰحِشَةٍۢ مُّبَيِّنَةٍۢ ۚ","حُدُودُ ٱللَّهِ ۚ وَمَن",19],["65:1:40",558,"ذَٰلِكَ","that","ٱللَّهَ يُحْدِثُ بَعْدَ","أَمْرًۭا",19],["65:2:16",558,"ذَٰلِكُمْ","That","وَأَقِيمُوا۟ ٱلشَّهَـٰدَةَ لِلَّهِ ۚ","يُوعَظُ بِهِۦ مَن",19],["65:5:1",558,"ذَٰلِكَ","That","","أَمْرُ ٱللَّهِ أَنزَلَهُۥٓ",19],["66:4:20",560,"ذَٰلِكَ","that","ٱلْمُؤْمِنِينَ ۖ وَٱلْمَلَـٰٓئِكَةُ بَعْدَ","ظَهِيرٌ",19],["68:13:3",564,"ذَٰلِكَ","(all) that","عُتُلٍّۭ بَعْدَ","زَنِيمٍ",19],["68:33:1",565,"كَذَٰلِكَ","Such","","ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْـَٔاخِرَةِ",19],["68:40:3",565,"بِذَٰلِكَ","for that","سَلْهُمْ أَيُّهُم","زَعِيمٌ",19],["70:31:4",569,"ذَٰلِكَ","that","فَمَنِ ٱبْتَغَىٰ وَرَآءَ","فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ",19],["70:44:5",570,"ذَٰلِكَ","That","أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۚ","ٱلْيَوْمُ ٱلَّذِى كَانُوا۟",19],["72:11:6",572,"ذَٰلِكَ ۖ","that","ٱلصَّـٰلِحُونَ وَمِنَّا دُونَ","كُنَّا طَرَآئِقَ قِدَدًۭا",19],["74:9:1",575,"فَذَٰلِكَ","That","","يَوْمَئِذٍۢ يَوْمٌ عَسِيرٌ",19],["74:31:39",576,"كَذَٰلِكَ","Thus","ٱللَّهُ بِهَـٰذَا مَثَلًۭا ۚ","يُضِلُّ ٱللَّهُ مَن",19],["75:40:2",578,"ذَٰلِكَ","[that]","أَلَيْسَ","بِقَـٰدِرٍ عَلَىٰٓ أَن",19],["76:11:4",579,"ذَٰلِكَ","(of) that","فَوَقَىٰهُمُ ٱللَّهُ شَرَّ","ٱلْيَوْمِ وَلَقَّىٰهُمْ نَضْرَةًۭ",19],["77:18:1",580,"كَذَٰلِكَ","Thus","","نَفْعَلُ بِٱلْمُجْرِمِينَ",19],["77:44:2",581,"كَذَٰلِكَ","thus","إِنَّا","نَجْزِى ٱلْمُحْسِنِينَ",19],["78:39:1",583,"ذَٰلِكَ","That","","ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن",19],["79:12:2",583,"تِلْكَ","This","قَالُوا۟","إِذًۭا كَرَّةٌ خَاسِرَةٌۭ",19],["79:26:3",584,"ذَٰلِكَ","that","إِنَّ فِى","لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ",19],["79:30:3",584,"ذَٰلِكَ","that","وَٱلْأَرْضَ بَعْدَ","دَحَىٰهَآ",19],["83:26:4",588,"ذَٰلِكَ","that","خِتَـٰمُهُۥ مِسْكٌۭ ۚ وَفِى","فَلْيَتَنَافَسِ ٱلْمُتَنَـٰفِسُونَ",19],["85:11:12",590,"ذَٰلِكَ","That","مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۚ","ٱلْفَوْزُ ٱلْكَبِيرُ",19],["89:5:3",593,"ذَٰلِكَ","that","هَلْ فِى","قَسَمٌۭ لِّذِى حِجْرٍ",19],["98:5:14",598,"وَذَٰلِكَ","And that","ٱلصَّلَوٰةَ وَيُؤْتُوا۟ ٱلزَّكَوٰةَ ۚ","دِينُ ٱلْقَيِّمَةِ",19],["98:8:18",599,"ذَٰلِكَ","That","عَنْهُمْ وَرَضُوا۟ عَنْهُ ۚ","لِمَنْ خَشِىَ رَبَّهُۥ",19],["100:7:3",600,"ذَٰلِكَ","that","وَإِنَّهُۥ عَلَىٰ","لَشَهِيدٌۭ",19],["107:2:1",602,"فَذَٰلِكَ","Then that","","ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",19]]