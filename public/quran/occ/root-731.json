[["5:66:19",119,"مُّقْتَصِدَةٌۭ ۖ","moderate","أَرْجُلِهِم ۚ مِّنْهُمْ أُمَّةٌۭ","وَكَثِيرٌۭ مِّنْهُمْ سَآءَ",3982],["9:42:6",194,"قَاصِدًۭا","easy","عَرَضًۭا قَرِيبًۭا وَسَفَرًۭا","لَّٱتَّبَعُوكَ وَلَـٰكِنۢ بَعُدَتْ",4102],["16:9:3",268,"قَصْدُ","(is) the direction","وَعَلَى ٱللَّهِ","ٱلسَّبِيلِ وَمِنْهَا جَآئِرٌۭ ۚ",4115],["31:19:1",412,"وَٱقْصِدْ","And be moderate","","فِى مَشْيِكَ وَٱغْضُضْ",4823],["31:32:15",414,"مُّقْتَصِدٌۭ ۚ","(some are) moderate","إِلَى ٱلْبَرِّ فَمِنْهُم","وَمَا يَجْحَدُ بِـَٔايَـٰتِنَآ",2540],["35:32:12",438,"مُّقْتَصِدٌۭ","(is he who is) moderate","ظَالِمٌۭ لِّنَفْسِهِۦ وَمِنْهُم","وَمِنْهُمْ سَابِقٌۢ بِٱلْخَيْرَٰتِ",2540]]