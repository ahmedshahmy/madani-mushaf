[["2:219:3",34,"ٱلْخَمْرِ","[the] intoxicants","۞ يَسْـَٔلُونَكَ عَنِ","وَٱلْمَيْسِرِ ۖ قُلْ فِيهِمَآ",1247],["5:90:5",122,"ٱلْخَمْرُ","the intoxicants","ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّمَا","وَٱلْمَيْسِرُ وَٱلْأَنصَابُ وَٱلْأَزْلَـٰمُ",1247],["5:91:10",123,"ٱلْخَمْرِ","intoxicants","ٱلْعَدَٰوَةَ وَٱلْبَغْضَآءَ فِى","وَٱلْمَيْسِرِ وَيَصُدَّكُمْ عَن",1247],["12:36:10",239,"خَمْرًۭا ۖ","wine","إِنِّىٓ أَرَىٰنِىٓ أَعْصِرُ","وَقَالَ ٱلْـَٔاخَرُ إِنِّىٓ",1247],["12:41:7",240,"خَمْرًۭا ۖ","wine","أَحَدُكُمَا فَيَسْقِى رَبَّهُۥ","وَأَمَّا ٱلْـَٔاخَرُ فَيُصْلَبُ",1247],["24:31:16",353,"بِخُمُرِهِنَّ","their head covers","ظَهَرَ مِنْهَا ۖ وَلْيَضْرِبْنَ","عَلَىٰ جُيُوبِهِنَّ ۖ وَلَا",4594],["47:15:20",508,"خَمْرٍۢ","wine","طَعْمُهُۥ وَأَنْهَـٰرٌۭ مِّنْ","لَّذَّةٍۢ لِّلشَّـٰرِبِينَ وَأَنْهَـٰرٌۭ",1247]]