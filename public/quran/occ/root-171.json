[["2:275:39",47,"عَادَ","repeated","إِلَى ٱللَّهِ ۖ وَمَنْ","فَأُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ ۖ",545],["5:95:43",123,"عَادَ","returned","عَمَّا سَلَفَ ۚ وَمَنْ","فَيَنتَقِمُ ٱللَّهُ مِنْهُ ۗ",545],["5:114:14",127,"عِيدًۭا","a festival","ٱلسَّمَآءِ تَكُونُ لَنَا","لِّأَوَّلِنَا وَءَاخِرِنَا وَءَايَةًۭ",3143],["6:28:11",131,"لَعَادُوا۟","certainly they (would) return","قَبْلُ ۖ وَلَوْ رُدُّوا۟","لِمَا نُهُوا۟ عَنْهُ",545],["7:29:16",153,"تَعُودُونَ","(so) will you return","ٱلدِّينَ ۚ كَمَا بَدَأَكُمْ","",545],["7:65:2",158,"عَادٍ","Aad","۞ وَإِلَىٰ","أَخَاهُمْ هُودًۭا ۗ قَالَ",436],["7:74:7",160,"عَادٍۢ","Aad","خُلَفَآءَ مِنۢ بَعْدِ","وَبَوَّأَكُمْ فِى ٱلْأَرْضِ",436],["7:88:15",162,"لَتَعُودُنَّ","you must return","مِن قَرْيَتِنَآ أَوْ","فِى مِلَّتِنَا ۚ قَالَ",545],["7:89:7",162,"عُدْنَا","we returned","ٱللَّهِ كَذِبًا إِنْ","فِى مِلَّتِكُم بَعْدَ",545],["7:89:19",162,"نَّعُودَ","we return","يَكُونُ لَنَآ أَن","فِيهَآ إِلَّآ أَن",545],["8:19:12",179,"تَعُودُوا۟","you return","خَيْرٌۭ لَّكُمْ ۖ وَإِن","نَعُدْ وَلَن تُغْنِىَ",545],["8:19:13",179,"نَعُدْ","We will return (too)","لَّكُمْ ۖ وَإِن تَعُودُوا۟","وَلَن تُغْنِىَ عَنكُمْ",545],["8:38:12",181,"يَعُودُوا۟","they return","قَدْ سَلَفَ وَإِن","فَقَدْ مَضَتْ سُنَّتُ",545],["9:70:9",198,"وَعَادٍۢ","and Aad","قَبْلِهِمْ قَوْمِ نُوحٍۢ","وَثَمُودَ وَقَوْمِ إِبْرَٰهِيمَ",436],["10:4:11",208,"يُعِيدُهُۥ","He repeats it","يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ","لِيَجْزِىَ ٱلَّذِينَ ءَامَنُوا۟",543],["10:34:9",213,"يُعِيدُهُۥ ۚ","repeats it","يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ","قُلِ ٱللَّهُ يَبْدَؤُا۟",543],["10:34:15",213,"يُعِيدُهُۥ ۖ","repeats it","يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ","فَأَنَّىٰ تُؤْفَكُونَ",543],["11:50:2",227,"عَادٍ","Aad","وَإِلَىٰ","أَخَاهُمْ هُودًۭا ۚ قَالَ",436],["11:59:2",228,"عَادٌۭ ۖ","(was) Aad","وَتِلْكَ","جَحَدُوا۟ بِـَٔايَـٰتِ رَبِّهِمْ",436],["11:60:10",228,"عَادًۭا","Aad","ٱلْقِيَـٰمَةِ ۗ أَلَآ إِنَّ","كَفَرُوا۟ رَبَّهُمْ ۗ أَلَا",436],["11:60:15",228,"لِّعَادٍۢ","with Aad","رَبَّهُمْ ۗ أَلَا بُعْدًۭا","قَوْمِ هُودٍۢ",436],["14:9:9",256,"وَعَادٍۢ","and Aad","قَبْلِكُمْ قَوْمِ نُوحٍۢ","وَثَمُودَ ۛ وَٱلَّذِينَ مِنۢ",436],["14:13:9",257,"لَتَعُودُنَّ","surely you should return","مِّنْ أَرْضِنَآ أَوْ","فِى مِلَّتِنَا ۖ فَأَوْحَىٰٓ",545],["17:8:6",283,"عُدتُّمْ","you return","أَن يَرْحَمَكُمْ ۚ وَإِنْ","عُدْنَا ۘ وَجَعَلْنَا جَهَنَّمَ",545],["17:8:7",283,"عُدْنَا ۘ","We will return","يَرْحَمَكُمْ ۚ وَإِنْ عُدتُّمْ","وَجَعَلْنَا جَهَنَّمَ لِلْكَـٰفِرِينَ",545],["17:51:9",287,"يُعِيدُنَا ۖ","will restore us","صُدُورِكُمْ ۚ فَسَيَقُولُونَ مَن","قُلِ ٱلَّذِى فَطَرَكُمْ",543],["17:69:4",289,"يُعِيدَكُمْ","He will send you back","أَمْ أَمِنتُمْ أَن","فِيهِ تَارَةً أُخْرَىٰ",543],["18:20:7",295,"يُعِيدُوكُمْ","return you","عَلَيْكُمْ يَرْجُمُوكُمْ أَوْ","فِى مِلَّتِهِمْ وَلَن",543],["20:21:5",313,"سَنُعِيدُهَا","We will return it","خُذْهَا وَلَا تَخَفْ ۖ","سِيرَتَهَا ٱلْأُولَىٰ",543],["20:55:4",315,"نُعِيدُكُمْ","We will return you","۞ مِنْهَا خَلَقْنَـٰكُمْ وَفِيهَا","وَمِنْهَا نُخْرِجُكُمْ تَارَةً",543],["21:104:11",331,"نُّعِيدُهُۥ ۚ","We will repeat it","بَدَأْنَآ أَوَّلَ خَلْقٍۢ","وَعْدًا عَلَيْنَآ ۚ إِنَّا",543],["22:22:8",334,"أُعِيدُوا۟","they will be returned","مِنْهَا مِنْ غَمٍّ","فِيهَا وَذُوقُوا۟ عَذَابَ",543],["22:42:8",337,"وَعَادٌۭ","and Aad","قَبْلَهُمْ قَوْمُ نُوحٍۢ","وَثَمُودُ",436],["23:107:5",349,"عُدْنَا","we return","أَخْرِجْنَا مِنْهَا فَإِنْ","فَإِنَّا ظَـٰلِمُونَ",545],["24:17:4",351,"تَعُودُوا۟","you return","يَعِظُكُمُ ٱللَّهُ أَن","لِمِثْلِهِۦٓ أَبَدًا إِن",545],["25:38:1",363,"وَعَادًۭا","And Ad","","وَثَمُودَا۟ وَأَصْحَـٰبَ ٱلرَّسِّ",436],["26:123:2",372,"عَادٌ","(the people) of Aad","كَذَّبَتْ","ٱلْمُرْسَلِينَ",436],["27:64:5",383,"يُعِيدُهُۥ","repeats it","يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ","وَمَن يَرْزُقُكُم مِّنَ",543],["28:85:8",396,"مَعَادٍۢ ۚ","a place of return","ٱلْقُرْءَانَ لَرَآدُّكَ إِلَىٰ","قُل رَّبِّىٓ أَعْلَمُ",3630],["29:19:8",398,"يُعِيدُهُۥٓ ۚ","repeats it","ٱللَّهُ ٱلْخَلْقَ ثُمَّ","إِنَّ ذَٰلِكَ عَلَى",543],["29:38:1",400,"وَعَادًۭا","And Aad","","وَثَمُودَا۟ وَقَد تَّبَيَّنَ",436],["30:11:5",405,"يُعِيدُهُۥ","He repeats it","يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ","ثُمَّ إِلَيْهِ تُرْجَعُونَ",543],["30:27:6",407,"يُعِيدُهُۥ","repeats it","يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ","وَهُوَ أَهْوَنُ عَلَيْهِ ۚ",543],["32:20:11",416,"أُعِيدُوا۟","they (will) be returned","أَن يَخْرُجُوا۟ مِنْهَآ","فِيهَا وَقِيلَ لَهُمْ",543],["34:49:8",434,"يُعِيدُ","repeat","يُبْدِئُ ٱلْبَـٰطِلُ وَمَا","",543],["36:39:5",442,"عَادَ","it returns","قَدَّرْنَـٰهُ مَنَازِلَ حَتَّىٰ","كَٱلْعُرْجُونِ ٱلْقَدِيمِ",545],["38:12:5",453,"وَعَادٌۭ","and Aad","قَبْلَهُمْ قَوْمُ نُوحٍۢ","وَفِرْعَوْنُ ذُو ٱلْأَوْتَادِ",436],["40:31:5",470,"وَعَادٍۢ","and Aad","دَأْبِ قَوْمِ نُوحٍۢ","وَثَمُودَ وَٱلَّذِينَ مِنۢ",436],["41:13:8",478,"عَادٍۢ","(of) Aad","صَـٰعِقَةًۭ مِّثْلَ صَـٰعِقَةِ","وَثَمُودَ",436],["41:15:2",478,"عَادٌۭ","Aad","فَأَمَّا","فَٱسْتَكْبَرُوا۟ فِى ٱلْأَرْضِ",436],["44:15:6",496,"عَآئِدُونَ","(will) return","ٱلْعَذَابِ قَلِيلًا ۚ إِنَّكُمْ","",3091],["46:21:3",505,"عَادٍ","(of) Aad","۞ وَٱذْكُرْ أَخَا","إِذْ أَنذَرَ قَوْمَهُۥ",436],["50:13:1",518,"وَعَادٌۭ","And Aad","","وَفِرْعَوْنُ وَإِخْوَٰنُ لُوطٍۢ",436],["51:41:2",522,"عَادٍ","Aad","وَفِى","إِذْ أَرْسَلْنَا عَلَيْهِمُ",436],["53:50:3",528,"عَادًا","Aad","وَأَنَّهُۥٓ أَهْلَكَ","ٱلْأُولَىٰ",436],["54:18:2",529,"عَادٌۭ","Aad","كَذَّبَتْ","فَكَيْفَ كَانَ عَذَابِى",436],["58:3:6",542,"يَعُودُونَ","go back","مِن نِّسَآئِهِمْ ثُمَّ","لِمَا قَالُوا۟ فَتَحْرِيرُ",545],["58:8:9",543,"يَعُودُونَ","they return","عَنِ ٱلنَّجْوَىٰ ثُمَّ","لِمَا نُهُوا۟ عَنْهُ",545],["69:4:3",566,"وَعَادٌۢ","and Aad","كَذَّبَتْ ثَمُودُ","بِٱلْقَارِعَةِ",436],["69:6:2",566,"عَادٌۭ","Aad","وَأَمَّا","فَأُهْلِكُوا۟ بِرِيحٍۢ صَرْصَرٍ",436],["71:18:2",571,"يُعِيدُكُمْ","He will return you","ثُمَّ","فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًۭا",543],["85:13:4",590,"وَيُعِيدُ","and repeats","إِنَّهُۥ هُوَ يُبْدِئُ","",543],["89:6:6",593,"بِعَادٍ","with Aad","كَيْفَ فَعَلَ رَبُّكَ","",436]]