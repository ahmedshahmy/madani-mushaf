[["2:33:19",6,"تُبْدُونَ","you reveal","وَٱلْأَرْضِ وَأَعْلَمُ مَا","وَمَا كُنتُمْ تَكْتُمُونَ",642],["2:271:2",46,"تُبْدُوا۟","you disclose","إِن","ٱلصَّدَقَـٰتِ فَنِعِمَّا هِىَ ۖ",642],["2:284:9",49,"تُبْدُوا۟","you disclose","فِى ٱلْأَرْضِ ۗ وَإِن","مَا فِىٓ أَنفُسِكُمْ",642],["3:29:8",53,"تُبْدُوهُ","you disclose it","فِى صُدُورِكُمْ أَوْ","يَعْلَمْهُ ٱللَّهُ ۗ وَيَعْلَمُ",642],["3:118:16",65,"بَدَتِ","(has become) apparent","مَا عَنِتُّمْ قَدْ","ٱلْبَغْضَآءُ مِنْ أَفْوَٰهِهِمْ",777],["3:154:39",70,"يُبْدُونَ","they reveal","أَنفُسِهِم مَّا لَا","لَكَ ۖ يَقُولُونَ لَوْ",642],["4:149:2",102,"تُبْدُوا۟","you disclose","إِن","خَيْرًا أَوْ تُخْفُوهُ",642],["5:99:9",124,"تُبْدُونَ","you reveal","وَٱللَّهُ يَعْلَمُ مَا","وَمَا تَكْتُمُونَ",642],["5:101:9",124,"تُبْدَ","made clear","عَنْ أَشْيَآءَ إِن","لَكُمْ تَسُؤْكُمْ وَإِن",777],["5:101:18",124,"تُبْدَ","it would be made clear","حِينَ يُنَزَّلُ ٱلْقُرْءَانُ","لَكُمْ عَفَا ٱللَّهُ",777],["6:28:2",131,"بَدَا","became manifest","بَلْ","لَهُم مَّا كَانُوا۟",777],["6:91:28",139,"تُبْدُونَهَا","you disclose (some of) it","لِّلنَّاسِ ۖ تَجْعَلُونَهُۥ قَرَاطِيسَ","وَتُخْفُونَ كَثِيرًۭا ۖ وَعُلِّمْتُم",642],["7:20:4",152,"لِيُبْدِىَ","to make apparent","فَوَسْوَسَ لَهُمَا ٱلشَّيْطَـٰنُ","لَهُمَا مَا وُۥرِىَ",642],["7:22:6",152,"بَدَتْ","became apparent","فَلَمَّا ذَاقَا ٱلشَّجَرَةَ","لَهُمَا سَوْءَٰتُهُمَا وَطَفِقَا",777],["11:27:19",224,"بَادِىَ","immature in opinion","ٱلَّذِينَ هُمْ أَرَاذِلُنَا","ٱلرَّأْىِ وَمَا نَرَىٰ",3315],["12:35:2",239,"بَدَا","(it) appeared","ثُمَّ","لَهُم مِّنۢ بَعْدِ",777],["12:77:15",244,"يُبْدِهَا","reveal it","فِى نَفْسِهِۦ وَلَمْ","لَهُمْ ۚ قَالَ أَنتُمْ",642],["12:100:29",247,"ٱلْبَدْوِ","the bedouin life","وَجَآءَ بِكُم مِّنَ","مِنۢ بَعْدِ أَن",3336],["20:121:3",320,"فَبَدَتْ","so became apparent","فَأَكَلَا مِنْهَا","لَهُمَا سَوْءَٰتُهُمَا وَطَفِقَا",777],["22:25:16",335,"وَٱلْبَادِ ۚ","and the visitor","سَوَآءً ٱلْعَـٰكِفُ فِيهِ","وَمَن يُرِدْ فِيهِ",3314],["24:29:15",353,"تُبْدُونَ","you reveal","وَٱللَّهُ يَعْلَمُ مَا","وَمَا تَكْتُمُونَ",642],["24:31:9",353,"يُبْدِينَ","(to) display","وَيَحْفَظْنَ فُرُوجَهُنَّ وَلَا","زِينَتَهُنَّ إِلَّا مَا",642],["24:31:20",353,"يُبْدِينَ","(to) display","عَلَىٰ جُيُوبِهِنَّ ۖ وَلَا","زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ",642],["28:10:8",386,"لَتُبْدِى","(to) disclosing","فَـٰرِغًا ۖ إِن كَادَتْ","بِهِۦ لَوْلَآ أَن",642],["33:20:11",420,"بَادُونَ","living in (the) desert","يَوَدُّوا۟ لَوْ أَنَّهُم","فِى ٱلْأَعْرَابِ يَسْـَٔلُونَ",3316],["33:37:19",423,"مُبْدِيهِ","(was to) disclose","نَفْسِكَ مَا ٱللَّهُ","وَتَخْشَى ٱلنَّاسَ وَٱللَّهُ",3788],["33:54:2",425,"تُبْدُوا۟","you reveal","إِن","شَيْـًٔا أَوْ تُخْفُوهُ",642],["39:47:18",463,"وَبَدَا","And (will) appear","ٱلْعَذَابِ يَوْمَ ٱلْقِيَـٰمَةِ ۚ","لَهُم مِّنَ ٱللَّهِ",777],["39:48:1",464,"وَبَدَا","And will become apparent","","لَهُمْ سَيِّـَٔاتُ مَا",777],["45:33:1",502,"وَبَدَا","And (will) appear","","لَهُمْ سَيِّـَٔاتُ مَا",777],["60:4:23",549,"وَبَدَا","and has appeared","ٱللَّهِ كَفَرْنَا بِكُمْ","بَيْنَنَا وَبَيْنَكُمُ ٱلْعَدَٰوَةُ",777]]