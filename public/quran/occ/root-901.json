[["5:42:4",115,"لِلسُّحْتِ ۚ","of the forbidden","سَمَّـٰعُونَ لِلْكَذِبِ أَكَّـٰلُونَ","فَإِن جَآءُوكَ فَٱحْكُم",2001],["5:62:9",118,"ٱلسُّحْتَ ۚ","the forbidden","ٱلْإِثْمِ وَٱلْعُدْوَٰنِ وَأَكْلِهِمُ","لَبِئْسَ مَا كَانُوا۟",2001],["5:63:9",118,"ٱلسُّحْتَ ۚ","(of) the forbidden","قَوْلِهِمُ ٱلْإِثْمَ وَأَكْلِهِمُ","لَبِئْسَ مَا كَانُوا۟",2001],["20:61:10",315,"فَيُسْحِتَكُم","lest He will destroy you","عَلَى ٱللَّهِ كَذِبًۭا","بِعَذَابٍۢ ۖ وَقَدْ خَابَ",4734]]