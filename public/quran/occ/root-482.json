[["3:14:4",51,"ٱلشَّهَوَٰتِ","(of) the (things they) desire","زُيِّنَ لِلنَّاسِ حُبُّ","مِنَ ٱلنِّسَآءِ وَٱلْبَنِينَ",1707],["4:27:9",83,"ٱلشَّهَوَٰتِ","the passions","وَيُرِيدُ ٱلَّذِينَ يَتَّبِعُونَ","أَن تَمِيلُوا۟ مَيْلًا",1707],["7:81:4",160,"شَهْوَةًۭ","lustfully","إِنَّكُمْ لَتَأْتُونَ ٱلرِّجَالَ","مِّن دُونِ ٱلنِّسَآءِ ۚ",2117],["16:57:7",273,"يَشْتَهُونَ","they desire","سُبْحَـٰنَهُۥ ۙ وَلَهُم مَّا","",1020],["19:59:8",309,"ٱلشَّهَوَٰتِ ۖ","the lusts","أَضَاعُوا۟ ٱلصَّلَوٰةَ وَٱتَّبَعُوا۟","فَسَوْفَ يَلْقَوْنَ غَيًّا",1707],["21:102:7",331,"ٱشْتَهَتْ","desire","وَهُمْ فِى مَا","أَنفُسُهُمْ خَـٰلِدُونَ",1020],["27:55:4",381,"شَهْوَةًۭ","(with) lust","أَئِنَّكُمْ لَتَأْتُونَ ٱلرِّجَالَ","مِّن دُونِ ٱلنِّسَآءِ ۚ",2117],["34:54:5",434,"يَشْتَهُونَ","they desire","بَيْنَهُمْ وَبَيْنَ مَا","كَمَا فُعِلَ بِأَشْيَاعِهِم",1020],["41:31:11",480,"تَشْتَهِىٓ","desire","وَلَكُمْ فِيهَا مَا","أَنفُسُكُمْ وَلَكُمْ فِيهَا",1020],["43:71:9",494,"تَشْتَهِيهِ","desires","وَأَكْوَابٍۢ ۖ وَفِيهَا مَا","ٱلْأَنفُسُ وَتَلَذُّ ٱلْأَعْيُنُ ۖ",1020],["52:22:5",524,"يَشْتَهُونَ","they desire","بِفَـٰكِهَةٍۢ وَلَحْمٍۢ مِّمَّا","",1020],["56:21:4",535,"يَشْتَهُونَ","they desire","وَلَحْمِ طَيْرٍۢ مِّمَّا","",1020],["77:42:3",581,"يَشْتَهُونَ","they desire","وَفَوَٰكِهَ مِمَّا","",1020]]