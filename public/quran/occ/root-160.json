[["2:195:9",30,"ٱلتَّهْلُكَةِ ۛ","[the] destruction","تُلْقُوا۟ بِأَيْدِيكُمْ إِلَى","وَأَحْسِنُوٓا۟ ۛ إِنَّ ٱللَّهَ",4481],["2:205:8",32,"وَيُهْلِكَ","and destroys","ٱلْأَرْضِ لِيُفْسِدَ فِيهَا","ٱلْحَرْثَ وَٱلنَّسْلَ ۗ وَٱللَّهُ",231],["3:117:17",65,"فَأَهْلَكَتْهُ ۚ","then destroyed it","قَوْمٍۢ ظَلَمُوٓا۟ أَنفُسَهُمْ","وَمَا ظَلَمَهُمُ ٱللَّهُ",231],["4:176:9",106,"هَلَكَ","died","ٱلْكَلَـٰلَةِ ۚ إِنِ ٱمْرُؤٌا۟","لَيْسَ لَهُۥ وَلَدٌۭ",1340],["5:17:20",110,"يُهْلِكَ","destroy","إِنْ أَرَادَ أَن","ٱلْمَسِيحَ ٱبْنَ مَرْيَمَ",231],["6:6:4",128,"أَهْلَكْنَا","We destroyed","أَلَمْ يَرَوْا۟ كَمْ","مِن قَبْلِهِم مِّن",231],["6:6:25",128,"فَأَهْلَكْنَـٰهُم","Then We destroyed them","تَجْرِى مِن تَحْتِهِمْ","بِذُنُوبِهِمْ وَأَنشَأْنَا مِنۢ",231],["6:26:7",130,"يُهْلِكُونَ","they destroy","وَيَنْـَٔوْنَ عَنْهُ ۖ وَإِن","إِلَّآ أَنفُسَهُمْ وَمَا",231],["6:47:11",133,"يُهْلَكُ","(any) be destroyed","أَوْ جَهْرَةً هَلْ","إِلَّا ٱلْقَوْمُ ٱلظَّـٰلِمُونَ",231],["6:131:6",145,"مُهْلِكَ","one who destroys","لَّمْ يَكُن رَّبُّكَ","ٱلْقُرَىٰ بِظُلْمٍۢ وَأَهْلُهَا",1363],["7:4:4",151,"أَهْلَكْنَـٰهَا","We destroyed it","وَكَم مِّن قَرْيَةٍ","فَجَآءَهَا بَأْسُنَا بَيَـٰتًا",231],["7:129:15",165,"يُهْلِكَ","will destroy","عَسَىٰ رَبُّكُمْ أَن","عَدُوَّكُمْ وَيَسْتَخْلِفَكُمْ فِى",231],["7:155:14",169,"أَهْلَكْتَهُم","You (could) have destroyed them","رَبِّ لَوْ شِئْتَ","مِّن قَبْلُ وَإِيَّـٰىَ ۖ",231],["7:155:18",169,"أَتُهْلِكُنَا","Would You destroy us","مِّن قَبْلُ وَإِيَّـٰىَ ۖ","بِمَا فَعَلَ ٱلسُّفَهَآءُ",231],["7:164:9",172,"مُهْلِكُهُمْ","(is going to) destroy them","تَعِظُونَ قَوْمًا ۙ ٱللَّهُ","أَوْ مُعَذِّبُهُمْ عَذَابًۭا",1363],["7:173:12",173,"أَفَتُهْلِكُنَا","So will You destroy us","ذُرِّيَّةًۭ مِّنۢ بَعْدِهِمْ ۖ","بِمَا فَعَلَ ٱلْمُبْطِلُونَ",231],["8:42:22",182,"لِّيَهْلِكَ","that (might be) destroyed","أَمْرًۭا كَانَ مَفْعُولًۭا","مَنْ هَلَكَ عَنۢ",1340],["8:42:24",182,"هَلَكَ","(were to be) destroyed","مَفْعُولًۭا لِّيَهْلِكَ مَنْ","عَنۢ بَيِّنَةٍۢ وَيَحْيَىٰ",1340],["8:54:10",184,"فَأَهْلَكْنَـٰهُم","so We destroyed them","كَذَّبُوا۟ بِـَٔايَـٰتِ رَبِّهِمْ","بِذُنُوبِهِمْ وَأَغْرَقْنَآ ءَالَ",231],["9:42:18",194,"يُهْلِكُونَ","They destroy","ٱسْتَطَعْنَا لَخَرَجْنَا مَعَكُمْ","أَنفُسَهُمْ وَٱللَّهُ يَعْلَمُ",231],["10:13:2",209,"أَهْلَكْنَا","We destroyed","وَلَقَدْ","ٱلْقُرُونَ مِن قَبْلِكُمْ",231],["11:117:4",234,"لِيُهْلِكَ","destroy","وَمَا كَانَ رَبُّكَ","ٱلْقُرَىٰ بِظُلْمٍۢ وَأَهْلُهَا",231],["12:85:12",245,"ٱلْهَـٰلِكِينَ","those who perish","أَوْ تَكُونَ مِنَ","",2387],["14:13:15",257,"لَنُهْلِكَنَّ","We will surely destroy","فَأَوْحَىٰٓ إِلَيْهِمْ رَبُّهُمْ","ٱلظَّـٰلِمِينَ",231],["15:4:2",262,"أَهْلَكْنَا","We destroyed","وَمَآ","مِن قَرْيَةٍ إِلَّا",231],["17:16:4",283,"نُّهْلِكَ","We destroy","وَإِذَآ أَرَدْنَآ أَن","قَرْيَةً أَمَرْنَا مُتْرَفِيهَا",231],["17:17:2",283,"أَهْلَكْنَا","We destroyed","وَكَمْ","مِنَ ٱلْقُرُونِ مِنۢ",231],["17:58:6",287,"مُهْلِكُوهَا","(will) destroy it","قَرْيَةٍ إِلَّا نَحْنُ","قَبْلَ يَوْمِ ٱلْقِيَـٰمَةِ",1363],["18:59:3",300,"أَهْلَكْنَـٰهُمْ","We destroyed them","وَتِلْكَ ٱلْقُرَىٰٓ","لَمَّا ظَلَمُوا۟ وَجَعَلْنَا",231],["18:59:7",300,"لِمَهْلِكِهِم","for their destruction","لَمَّا ظَلَمُوا۟ وَجَعَلْنَا","مَّوْعِدًۭا",2451],["19:74:2",310,"أَهْلَكْنَا","We destroyed","وَكَمْ","قَبْلَهُم مِّن قَرْنٍ",231],["19:98:2",312,"أَهْلَكْنَا","We (have) destroyed","وَكَمْ","قَبْلَهُم مِّن قَرْنٍ",231],["20:128:5",321,"أَهْلَكْنَا","We (have) destroyed","يَهْدِ لَهُمْ كَمْ","قَبْلَهُم مِّنَ ٱلْقُرُونِ",231],["20:134:3",321,"أَهْلَكْنَـٰهُم","(had) destroyed them","وَلَوْ أَنَّآ","بِعَذَابٍۢ مِّن قَبْلِهِۦ",231],["21:6:6",322,"أَهْلَكْنَـٰهَآ ۖ","which We destroyed","قَبْلَهُم مِّن قَرْيَةٍ","أَفَهُمْ يُؤْمِنُونَ",231],["21:9:7",322,"وَأَهْلَكْنَا","and We destroyed","فَأَنجَيْنَـٰهُمْ وَمَن نَّشَآءُ","ٱلْمُسْرِفِينَ",231],["21:95:4",330,"أَهْلَكْنَـٰهَآ","which We have destroyed","وَحَرَٰمٌ عَلَىٰ قَرْيَةٍ","أَنَّهُمْ لَا يَرْجِعُونَ",231],["22:45:4",337,"أَهْلَكْنَـٰهَا","We have destroyed it","فَكَأَيِّن مِّن قَرْيَةٍ","وَهِىَ ظَالِمَةٌۭ فَهِىَ",231],["23:48:4",345,"ٱلْمُهْلَكِينَ","those who were destroyed","فَكَذَّبُوهُمَا فَكَانُوا۟ مِنَ","",3807],["26:139:2",373,"فَأَهْلَكْنَـٰهُمْ ۗ","then We destroyed them","فَكَذَّبُوهُ","إِنَّ فِى ذَٰلِكَ",231],["26:208:2",376,"أَهْلَكْنَا","We destroyed","وَمَآ","مِن قَرْيَةٍ إِلَّا",231],["27:49:11",381,"مَهْلِكَ","(the) destruction","لِوَلِيِّهِۦ مَا شَهِدْنَا","أَهْلِهِۦ وَإِنَّا لَصَـٰدِقُونَ",2451],["28:43:8",390,"أَهْلَكْنَا","We had destroyed","مِنۢ بَعْدِ مَآ","ٱلْقُرُونَ ٱلْأُولَىٰ بَصَآئِرَ",231],["28:58:2",392,"أَهْلَكْنَا","We have destroyed","وَكَمْ","مِن قَرْيَةٍۭ بَطِرَتْ",231],["28:59:4",392,"مُهْلِكَ","(the) one to destroy","وَمَا كَانَ رَبُّكَ","ٱلْقُرَىٰ حَتَّىٰ يَبْعَثَ",1363],["28:59:16",392,"مُهْلِكِى","(the) one to destroy","ءَايَـٰتِنَا ۚ وَمَا كُنَّا","ٱلْقُرَىٰٓ إِلَّا وَأَهْلُهَا",3808],["28:78:12",395,"أَهْلَكَ","destroyed","أَنَّ ٱللَّهَ قَدْ","مِن قَبْلِهِۦ مِنَ",231],["28:88:13",396,"هَالِكٌ","(will be) destroyed","هُوَ ۚ كُلُّ شَىْءٍ","إِلَّا وَجْهَهُۥ ۚ لَهُ",2387],["29:31:8",400,"مُهْلِكُوٓا۟","(are) going to destroy","بِٱلْبُشْرَىٰ قَالُوٓا۟ إِنَّا","أَهْلِ هَـٰذِهِ ٱلْقَرْيَةِ ۖ",1363],["32:26:5",417,"أَهْلَكْنَا","We have destroyed","يَهْدِ لَهُمْ كَمْ","مِن قَبْلِهِم مِّنَ",231],["36:31:4",442,"أَهْلَكْنَا","We destroyed","أَلَمْ يَرَوْا۟ كَمْ","قَبْلَهُم مِّنَ ٱلْقُرُونِ",231],["38:3:2",453,"أَهْلَكْنَا","We destroyed","كَمْ","مِن قَبْلِهِم مِّن",231],["40:34:16",471,"هَلَكَ","he died","بِهِۦ ۖ حَتَّىٰٓ إِذَا","قُلْتُمْ لَن يَبْعَثَ",1340],["43:8:1",489,"فَأَهْلَكْنَآ","Then We destroyed","","أَشَدَّ مِنْهُم بَطْشًۭا",231],["44:37:9",497,"أَهْلَكْنَـٰهُمْ ۖ","We destroyed them","وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ","إِنَّهُمْ كَانُوا۟ مُجْرِمِينَ",231],["45:24:10",501,"يُهْلِكُنَآ","destroys us","نَمُوتُ وَنَحْيَا وَمَا","إِلَّا ٱلدَّهْرُ ۚ وَمَا",231],["46:27:2",505,"أَهْلَكْنَا","We destroyed","وَلَقَدْ","مَا حَوْلَكُم مِّنَ",231],["46:35:24",506,"يُهْلَكُ","(any) be destroyed","نَّهَارٍۭ ۚ بَلَـٰغٌۭ ۚ فَهَلْ","إِلَّا ٱلْقَوْمُ ٱلْفَـٰسِقُونَ",231],["47:13:11",508,"أَهْلَكْنَـٰهُمْ","We destroyed them","قَرْيَتِكَ ٱلَّتِىٓ أَخْرَجَتْكَ","فَلَا نَاصِرَ لَهُمْ",231],["50:36:2",520,"أَهْلَكْنَا","We destroyed","وَكَمْ","قَبْلَهُم مِّن قَرْنٍ",231],["53:50:2",528,"أَهْلَكَ","destroyed","وَأَنَّهُۥٓ","عَادًا ٱلْأُولَىٰ",231],["54:51:2",531,"أَهْلَكْنَآ","We destroyed","وَلَقَدْ","أَشْيَاعَكُمْ فَهَلْ مِن",231],["67:28:4",564,"أَهْلَكَنِىَ","destroys me","قُلْ أَرَءَيْتُمْ إِنْ","ٱللَّهُ وَمَن مَّعِىَ",231],["69:5:3",566,"فَأُهْلِكُوا۟","they were destroyed","فَأَمَّا ثَمُودُ","بِٱلطَّاغِيَةِ",231],["69:6:3",566,"فَأُهْلِكُوا۟","they were destroyed","وَأَمَّا عَادٌۭ","بِرِيحٍۢ صَرْصَرٍ عَاتِيَةٍۢ",231],["69:29:1",567,"هَلَكَ","Is gone","","عَنِّى سُلْطَـٰنِيَهْ",1340],["77:16:2",580,"نُهْلِكِ","We destroy","أَلَمْ","ٱلْأَوَّلِينَ",231],["90:6:2",594,"أَهْلَكْتُ","I have squandered","يَقُولُ","مَالًۭا لُّبَدًا",231]]