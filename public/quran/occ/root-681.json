[["2:128:11",20,"مَنَاسِكَنَا","our ways of worship","مُّسْلِمَةًۭ لَّكَ وَأَرِنَا","وَتُبْ عَلَيْنَآ ۖ إِنَّكَ",1580],["2:196:33",30,"نُسُكٍۢ ۚ","sacrifice","أَوْ صَدَقَةٍ أَوْ","فَإِذَآ أَمِنتُمْ فَمَن",2566],["2:200:3",31,"مَّنَـٰسِكَكُمْ","your acts of worship","فَإِذَا قَضَيْتُم","فَٱذْكُرُوا۟ ٱللَّهَ كَذِكْرِكُمْ",1580],["6:162:4",150,"وَنُسُكِى","and my rites of sacrifice","قُلْ إِنَّ صَلَاتِى","وَمَحْيَاىَ وَمَمَاتِى لِلَّهِ",2566],["22:34:4",336,"مَنسَكًۭا","a rite","وَلِكُلِّ أُمَّةٍۢ جَعَلْنَا","لِّيَذْكُرُوا۟ ٱسْمَ ٱللَّهِ",1580],["22:67:4",340,"مَنسَكًا","rite(s)","لِّكُلِّ أُمَّةٍۢ جَعَلْنَا","هُمْ نَاسِكُوهُ ۖ فَلَا",1580],["22:67:6",340,"نَاسِكُوهُ ۖ","perform it","جَعَلْنَا مَنسَكًا هُمْ","فَلَا يُنَـٰزِعُنَّكَ فِى",4010]]