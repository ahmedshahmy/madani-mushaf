[["5:6:17",108,"ٱلْكَعْبَيْنِ ۚ","the ankles","بِرُءُوسِكُمْ وَأَرْجُلَكُمْ إِلَى","وَإِن كُنتُمْ جُنُبًۭا",3560],["5:95:26",123,"ٱلْكَعْبَةِ","the Kabah","مِّنكُمْ هَدْيًۢا بَـٰلِغَ","أَوْ كَفَّـٰرَةٌۭ طَعَامُ",2414],["5:97:3",124,"ٱلْكَعْبَةَ","the Kabah","۞ جَعَلَ ٱللَّهُ","ٱلْبَيْتَ ٱلْحَرَامَ قِيَـٰمًۭا",2414],["78:33:1",583,"وَكَوَاعِبَ","And splendid companions","","أَتْرَابًۭا",3573]]