[["4:23:7",81,"وَخَـٰلَـٰتُكُمْ","and your mother's sisters","وَبَنَاتُكُمْ وَأَخَوَٰتُكُمْ وَعَمَّـٰتُكُمْ","وَبَنَاتُ ٱلْأَخِ وَبَنَاتُ",2039],["6:94:10",139,"خَوَّلْنَـٰكُمْ","We bestowed (on) you","مَرَّةٍۢ وَتَرَكْتُم مَّا","وَرَآءَ ظُهُورِكُمْ ۖ وَمَا",2043],["24:61:40",358,"أَخْوَٰلِكُمْ","(of) your maternal uncles","عَمَّـٰتِكُمْ أَوْ بُيُوتِ","أَوْ بُيُوتِ خَـٰلَـٰتِكُمْ",2726],["24:61:43",358,"خَـٰلَـٰتِكُمْ","(of) your maternal aunts","أَخْوَٰلِكُمْ أَوْ بُيُوتِ","أَوْ مَا مَلَكْتُم",2039],["33:50:22",424,"خَالِكَ","(of) your maternal uncles","وَبَنَاتِ عَمَّـٰتِكَ وَبَنَاتِ","وَبَنَاتِ خَـٰلَـٰتِكَ ٱلَّـٰتِى",2726],["33:50:24",424,"خَـٰلَـٰتِكَ","(of) your maternal aunts","وَبَنَاتِ خَالِكَ وَبَنَاتِ","ٱلَّـٰتِى هَاجَرْنَ مَعَكَ",2039],["39:8:11",459,"خَوَّلَهُۥ","He bestows on him","إِلَيْهِ ثُمَّ إِذَا","نِعْمَةًۭ مِّنْهُ نَسِىَ",2043],["39:49:8",464,"خَوَّلْنَـٰهُ","We bestow (on) him","دَعَانَا ثُمَّ إِذَا","نِعْمَةًۭ مِّنَّا قَالَ",2043]]