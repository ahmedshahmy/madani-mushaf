[["4:43:8",85,"سُكَـٰرَىٰ","(are) intoxicated","تَقْرَبُوا۟ ٱلصَّلَوٰةَ وَأَنتُمْ","حَتَّىٰ تَعْلَمُوا۟ مَا",1995],["15:15:3",262,"سُكِّرَتْ","have been dazzled","لَقَالُوٓا۟ إِنَّمَا","أَبْصَـٰرُنَا بَلْ نَحْنُ",4279],["15:72:4",266,"سَكْرَتِهِمْ","their intoxication","لَعَمْرُكَ إِنَّهُمْ لَفِى","يَعْمَهُونَ",2623],["16:67:7",274,"سَكَرًۭا","intoxicant","وَٱلْأَعْنَـٰبِ تَتَّخِذُونَ مِنْهُ","وَرِزْقًا حَسَنًا ۗ إِنَّ",4250],["22:2:15",332,"سُكَـٰرَىٰ","intoxicated","حَمْلَهَا وَتَرَى ٱلنَّاسَ","وَمَا هُم بِسُكَـٰرَىٰ",1995],["22:2:18",332,"بِسُكَـٰرَىٰ","(are) intoxicated","سُكَـٰرَىٰ وَمَا هُم","وَلَـٰكِنَّ عَذَابَ ٱللَّهِ",1995],["50:19:2",519,"سَكْرَةُ","(the) stupor","وَجَآءَتْ","ٱلْمَوْتِ بِٱلْحَقِّ ۖ ذَٰلِكَ",2623]]