[["2:266:9",45,"وَأَعْنَابٍۢ","and grapevines","جَنَّةٌۭ مِّن نَّخِيلٍۢ","تَجْرِى مِن تَحْتِهَا",773],["6:99:27",140,"أَعْنَابٍۢ","grapes","دَانِيَةٌۭ وَجَنَّـٰتٍۢ مِّنْ","وَٱلزَّيْتُونَ وَٱلرُّمَّانَ مُشْتَبِهًۭا",773],["13:4:7",249,"أَعْنَـٰبٍۢ","grapevines","مُّتَجَـٰوِرَٰتٌۭ وَجَنَّـٰتٌۭ مِّنْ","وَزَرْعٌۭ وَنَخِيلٌۭ صِنْوَانٌۭ",773],["16:11:7",268,"وَٱلْأَعْنَـٰبَ","and the grapes","ٱلزَّرْعَ وَٱلزَّيْتُونَ وَٱلنَّخِيلَ","وَمِن كُلِّ ٱلثَّمَرَٰتِ ۗ",773],["16:67:4",274,"وَٱلْأَعْنَـٰبِ","and the grapes","وَمِن ثَمَرَٰتِ ٱلنَّخِيلِ","تَتَّخِذُونَ مِنْهُ سَكَرًۭا",773],["17:91:7",291,"وَعِنَبٍۢ","and grapes","جَنَّةٌۭ مِّن نَّخِيلٍۢ","فَتُفَجِّرَ ٱلْأَنْهَـٰرَ خِلَـٰلَهَا",773],["18:32:9",297,"أَعْنَـٰبٍۢ","grapes","لِأَحَدِهِمَا جَنَّتَيْنِ مِنْ","وَحَفَفْنَـٰهُمَا بِنَخْلٍۢ وَجَعَلْنَا",773],["23:19:7",343,"وَأَعْنَـٰبٍۢ","and grapevines","جَنَّـٰتٍۢ مِّن نَّخِيلٍۢ","لَّكُمْ فِيهَا فَوَٰكِهُ",773],["36:34:6",442,"وَأَعْنَـٰبٍۢ","and grapevines","جَنَّـٰتٍۢ مِّن نَّخِيلٍۢ","وَفَجَّرْنَا فِيهَا مِنَ",773],["78:32:2",583,"وَأَعْنَـٰبًۭا","and grapevines","حَدَآئِقَ","",773],["80:28:1",585,"وَعِنَبًۭا","And grapes","","وَقَضْبًۭا",773]]