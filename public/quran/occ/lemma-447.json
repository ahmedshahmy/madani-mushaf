[["2:245:2",39,"ذَا","(is) the one","مَّن","ٱلَّذِى يُقْرِضُ ٱللَّهَ",447],["2:255:21",42,"ذَا","(is) the one","فِى ٱلْأَرْضِ ۗ مَن","ٱلَّذِى يَشْفَعُ عِندَهُۥٓ",447],["3:160:10",71,"ذَا","(is)","وَإِن يَخْذُلْكُمْ فَمَن","ٱلَّذِى يَنصُرُكُم مِّنۢ",447],["5:95:21",123,"ذَوَا","two men","ٱلنَّعَمِ يَحْكُمُ بِهِۦ","عَدْلٍۢ مِّنكُمْ هَدْيًۢا",447],["5:106:13",125,"ذَوَا","men","حِينَ ٱلْوَصِيَّةِ ٱثْنَانِ","عَدْلٍۢ مِّنكُمْ أَوْ",447],["5:106:42",125,"ذَا","(of)","ثَمَنًۭا وَلَوْ كَانَ","قُرْبَىٰ ۙ وَلَا نَكْتُمُ",447],["6:152:26",149,"ذَا","(one of)","فَٱعْدِلُوا۟ وَلَوْ كَانَ","قُرْبَىٰ ۖ وَبِعَهْدِ ٱللَّهِ",447],["17:26:2",284,"ذَا","the relatives","وَءَاتِ","ٱلْقُرْبَىٰ حَقَّهُۥ وَٱلْمِسْكِينَ",447],["18:86:15",303,"يَـٰذَا","O Dhul-qarnain","عِندَهَا قَوْمًۭا ۗ قُلْنَا","ٱلْقَرْنَيْنِ إِمَّآ أَن",447],["18:94:2",303,"يَـٰذَا","O Dhul-qarnain","قَالُوا۟","ٱلْقَرْنَيْنِ إِنَّ يَأْجُوجَ",447],["21:85:3",329,"وَذَا","and Dhul-Kifl","وَإِسْمَـٰعِيلَ وَإِدْرِيسَ","ٱلْكِفْلِ ۖ كُلٌّۭ مِّنَ",447],["21:87:1",329,"وَذَا","And Dhun-Nun","","ٱلنُّونِ إِذ ذَّهَبَ",447],["23:77:6",347,"ذَا","of a punishment","فَتَحْنَا عَلَيْهِم بَابًۭا","عَذَابٍۢ شَدِيدٍ إِذَا",447],["30:38:2",408,"ذَا","the relative","فَـَٔاتِ","ٱلْقُرْبَىٰ حَقَّهُۥ وَٱلْمِسْكِينَ",447],["33:17:3",420,"ذَا","(is) it that","قُلْ مَن","ٱلَّذِى يَعْصِمُكُم مِّنَ",447],["35:18:17",436,"ذَا","near of kin","شَىْءٌۭ وَلَوْ كَانَ","قُرْبَىٰٓ ۗ إِنَّمَا تُنذِرُ",447],["38:17:8",454,"ذَا","the possessor of strength","وَٱذْكُرْ عَبْدَنَا دَاوُۥدَ","ٱلْأَيْدِ ۖ إِنَّهُۥٓ أَوَّابٌ",447],["38:48:4",456,"وَذَا","and Dhul-kifl","وَٱذْكُرْ إِسْمَـٰعِيلَ وَٱلْيَسَعَ","ٱلْكِفْلِ ۖ وَكُلٌّۭ مِّنَ",447],["57:11:2",538,"ذَا","the one who","مَّن","ٱلَّذِى يُقْرِضُ ٱللَّهَ",447],["68:14:3",564,"ذَا","a possessor","أَن كَانَ","مَالٍۢ وَبَنِينَ",447],["73:13:2",574,"ذَا","that","وَطَعَامًۭا","غُصَّةٍۢ وَعَذَابًا أَلِيمًۭا",447],["90:15:2",594,"ذَا","of","يَتِيمًۭا","مَقْرَبَةٍ",447],["90:16:3",594,"ذَا","in","أَوْ مِسْكِينًۭا","مَتْرَبَةٍۢ",447]]