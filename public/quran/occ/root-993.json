[["10:78:3",217,"لِتَلْفِتَنَا","to turn us away","قَالُوٓا۟ أَجِئْتَنَا","عَمَّا وَجَدْنَا عَلَيْهِ",4388],["11:81:15",230,"يَلْتَفِتْ","look back","مِّنَ ٱلَّيْلِ وَلَا","مِنكُمْ أَحَدٌ إِلَّا",2771],["15:65:9",265,"يَلْتَفِتْ","let look back","وَٱتَّبِعْ أَدْبَـٰرَهُمْ وَلَا","مِنكُمْ أَحَدٌۭ وَٱمْضُوا۟",2771]]