[["2:9:8",3,"أَنفُسَهُمْ","themselves","وَمَا يَخْدَعُونَ إِلَّآ","وَمَا يَشْعُرُونَ",39],["2:44:5",7,"أَنفُسَكُمْ","yourselves","ٱلنَّاسَ بِٱلْبِرِّ وَتَنسَوْنَ","وَأَنتُمْ تَتْلُونَ ٱلْكِتَـٰبَ ۚ",39],["2:48:5",7,"نَفْسٌ","any soul","يَوْمًۭا لَّا تَجْزِى","عَن نَّفْسٍۢ شَيْـًۭٔا",39],["2:48:7",7,"نَّفْسٍۢ","(another) soul","تَجْزِى نَفْسٌ عَن","شَيْـًۭٔا وَلَا يُقْبَلُ",39],["2:54:8",8,"أَنفُسَكُم","yourselves","يَـٰقَوْمِ إِنَّكُمْ ظَلَمْتُمْ","بِٱتِّخَاذِكُمُ ٱلْعِجْلَ فَتُوبُوٓا۟",39],["2:54:15",8,"أَنفُسَكُمْ","yourselves","إِلَىٰ بَارِئِكُمْ فَٱقْتُلُوٓا۟","ذَٰلِكُمْ خَيْرٌۭ لَّكُمْ",39],["2:57:17",8,"أَنفُسَهُمْ","(to) themselves","ظَلَمُونَا وَلَـٰكِن كَانُوٓا۟","يَظْلِمُونَ",39],["2:72:3",11,"نَفْسًۭا","a man","وَإِذْ قَتَلْتُمْ","فَٱدَّٰرَْٰٔتُمْ فِيهَا ۖ وَٱللَّهُ",39],["2:84:9",13,"أَنفُسَكُم","yourselves","دِمَآءَكُمْ وَلَا تُخْرِجُونَ","مِّن دِيَـٰرِكُمْ ثُمَّ",39],["2:85:5",13,"أَنفُسَكُمْ","yourselves","أَنتُمْ هَـٰٓؤُلَآءِ تَقْتُلُونَ","وَتُخْرِجُونَ فَرِيقًۭا مِّنكُم",39],["2:87:23",13,"أَنفُسُكُمُ","yourselves","بِمَا لَا تَهْوَىٰٓ","ٱسْتَكْبَرْتُمْ فَفَرِيقًۭا كَذَّبْتُمْ",39],["2:90:4",14,"أَنفُسَهُمْ","themselves","بِئْسَمَا ٱشْتَرَوْا۟ بِهِۦٓ","أَن يَكْفُرُوا۟ بِمَآ",39],["2:102:71",16,"أَنفُسَهُمْ ۚ","themselves","مَا شَرَوْا۟ بِهِۦٓ","لَوْ كَانُوا۟ يَعْلَمُونَ",39],["2:109:15",17,"أَنفُسِهِم","themselves","حَسَدًۭا مِّنْ عِندِ","مِّنۢ بَعْدِ مَا",39],["2:110:7",17,"لِأَنفُسِكُم","for yourselves","ٱلزَّكَوٰةَ ۚ وَمَا تُقَدِّمُوا۟","مِّنْ خَيْرٍۢ تَجِدُوهُ",39],["2:123:5",19,"نَفْسٌ","a soul","يَوْمًۭا لَّا تَجْزِى","عَن نَّفْسٍۢ شَيْـًۭٔا",39],["2:123:7",19,"نَّفْسٍۢ","(another) soul","تَجْزِى نَفْسٌ عَن","شَيْـًۭٔا وَلَا يُقْبَلُ",39],["2:130:9",20,"نَفْسَهُۥ ۚ","himself","إِلَّا مَن سَفِهَ","وَلَقَدِ ٱصْطَفَيْنَـٰهُ فِى",39],["2:155:9",24,"وَٱلْأَنفُسِ","and [the] lives","وَنَقْصٍۢ مِّنَ ٱلْأَمْوَٰلِ","وَٱلثَّمَرَٰتِ ۗ وَبَشِّرِ ٱلصَّـٰبِرِينَ",39],["2:187:19",29,"أَنفُسَكُمْ","yourselves","أَنَّكُمْ كُنتُمْ تَخْتَانُونَ","فَتَابَ عَلَيْكُمْ وَعَفَا",39],["2:207:5",32,"نَفْسَهُ","his own self","ٱلنَّاسِ مَن يَشْرِى","ٱبْتِغَآءَ مَرْضَاتِ ٱللَّهِ ۗ",39],["2:223:9",35,"لِأَنفُسِكُمْ ۚ","for yourselves","أَنَّىٰ شِئْتُمْ ۖ وَقَدِّمُوا۟","وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟",39],["2:228:3",36,"بِأَنفُسِهِنَّ","concerning themselves","وَٱلْمُطَلَّقَـٰتُ يَتَرَبَّصْنَ","ثَلَـٰثَةَ قُرُوٓءٍۢ ۚ وَلَا",39],["2:231:20",37,"نَفْسَهُۥ ۚ","himself","ذَٰلِكَ فَقَدْ ظَلَمَ","وَلَا تَتَّخِذُوٓا۟ ءَايَـٰتِ",39],["2:233:19",37,"نَفْسٌ","any soul","بِٱلْمَعْرُوفِ ۚ لَا تُكَلَّفُ","إِلَّا وُسْعَهَا ۚ لَا",39],["2:234:7",38,"بِأَنفُسِهِنَّ","for themselves","وَيَذَرُونَ أَزْوَٰجًۭا يَتَرَبَّصْنَ","أَرْبَعَةَ أَشْهُرٍۢ وَعَشْرًۭا ۖ",39],["2:234:20",38,"أَنفُسِهِنَّ","themselves","فِيمَا فَعَلْنَ فِىٓ","بِٱلْمَعْرُوفِ ۗ وَٱللَّهُ بِمَا",39],["2:235:13",38,"أَنفُسِكُمْ ۚ","yourselves","أَوْ أَكْنَنتُمْ فِىٓ","عَلِمَ ٱللَّهُ أَنَّكُمْ",39],["2:235:41",38,"أَنفُسِكُمْ","yourselves","يَعْلَمُ مَا فِىٓ","فَٱحْذَرُوهُ ۚ وَٱعْلَمُوٓا۟ أَنَّ",39],["2:240:22",39,"أَنفُسِهِنَّ","themselves","مَا فَعَلْنَ فِىٓ","مِن مَّعْرُوفٍۢ ۗ وَٱللَّهُ",39],["2:265:10",45,"أَنفُسِهِمْ","their (inner) souls","ٱللَّهِ وَتَثْبِيتًۭا مِّنْ","كَمَثَلِ جَنَّةٍۭ بِرَبْوَةٍ",39],["2:272:13",46,"فَلِأَنفُسِكُمْ ۚ","then it is for yourself","تُنفِقُوا۟ مِنْ خَيْرٍۢ","وَمَا تُنفِقُونَ إِلَّا",39],["2:281:10",47,"نَفْسٍۢ","soul","ثُمَّ تُوَفَّىٰ كُلُّ","مَّا كَسَبَتْ وَهُمْ",39],["2:284:12",49,"أَنفُسِكُمْ","yourselves","تُبْدُوا۟ مَا فِىٓ","أَوْ تُخْفُوهُ يُحَاسِبْكُم",39],["2:286:4",49,"نَفْسًا","any soul","لَا يُكَلِّفُ ٱللَّهُ","إِلَّا وُسْعَهَا ۚ لَهَا",39],["3:25:10",53,"نَفْسٍۢ","soul","فِيهِ وَوُفِّيَتْ كُلُّ","مَّا كَسَبَتْ وَهُمْ",39],["3:28:24",53,"نَفْسَهُۥ ۗ","(of) Himself","تُقَىٰةًۭ ۗ وَيُحَذِّرُكُمُ ٱللَّهُ","وَإِلَى ٱللَّهِ ٱلْمَصِيرُ",39],["3:30:4",54,"نَفْسٍۢ","soul","يَوْمَ تَجِدُ كُلُّ","مَّا عَمِلَتْ مِنْ",39],["3:30:23",54,"نَفْسَهُۥ ۗ","(against) Himself","بَعِيدًۭا ۗ وَيُحَذِّرُكُمُ ٱللَّهُ","وَٱللَّهُ رَءُوفٌۢ بِٱلْعِبَادِ",39],["3:61:17",57,"وَأَنفُسَنَا","and ourselves","وَأَبْنَآءَكُمْ وَنِسَآءَنَا وَنِسَآءَكُمْ","وَأَنفُسَكُمْ ثُمَّ نَبْتَهِلْ",39],["3:61:18",57,"وَأَنفُسَكُمْ","and yourselves","وَنِسَآءَنَا وَنِسَآءَكُمْ وَأَنفُسَنَا","ثُمَّ نَبْتَهِلْ فَنَجْعَل",39],["3:69:11",58,"أَنفُسَهُمْ","themselves","وَمَا يُضِلُّونَ إِلَّآ","وَمَا يَشْعُرُونَ",39],["3:93:12",62,"نَفْسِهِۦ","himself","حَرَّمَ إِسْرَٰٓءِيلُ عَلَىٰ","مِن قَبْلِ أَن",39],["3:117:16",65,"أَنفُسَهُمْ","themselves","حَرْثَ قَوْمٍۢ ظَلَمُوٓا۟","فَأَهْلَكَتْهُ ۚ وَمَا ظَلَمَهُمُ",39],["3:117:22",65,"أَنفُسَهُمْ","themselves","ظَلَمَهُمُ ٱللَّهُ وَلَـٰكِنْ","يَظْلِمُونَ",39],["3:135:7",67,"أَنفُسَهُمْ","themselves","فَـٰحِشَةً أَوْ ظَلَمُوٓا۟","ذَكَرُوا۟ ٱللَّهَ فَٱسْتَغْفَرُوا۟",39],["3:145:3",68,"لِنَفْسٍ","for a soul","وَمَا كَانَ","أَن تَمُوتَ إِلَّا",39],["3:154:15",70,"أَنفُسُهُمْ","(about) themselves","وَطَآئِفَةٌۭ قَدْ أَهَمَّتْهُمْ","يَظُنُّونَ بِٱللَّهِ غَيْرَ",39],["3:154:36",70,"أَنفُسِهِم","themselves","لِلَّهِ ۗ يُخْفُونَ فِىٓ","مَّا لَا يُبْدُونَ",39],["3:161:16",71,"نَفْسٍۢ","soul","ثُمَّ تُوَفَّىٰ كُلُّ","مَّا كَسَبَتْ وَهُمْ",39],["3:164:11",71,"أَنفُسِهِمْ","themselves","فِيهِمْ رَسُولًۭا مِّنْ","يَتْلُوا۟ عَلَيْهِمْ ءَايَـٰتِهِۦ",39],["3:165:14",71,"أَنفُسِكُمْ ۗ","yourselves","هُوَ مِنْ عِندِ","إِنَّ ٱللَّهَ عَلَىٰ",39],["3:168:12",72,"أَنفُسِكُمُ","yourselves","قُلْ فَٱدْرَءُوا۟ عَنْ","ٱلْمَوْتَ إِن كُنتُمْ",39],["3:178:9",73,"لِّأَنفُسِهِمْ ۚ","for themselves","نُمْلِى لَهُمْ خَيْرٌۭ","إِنَّمَا نُمْلِى لَهُمْ",39],["3:185:2",74,"نَفْسٍۢ","soul","كُلُّ","ذَآئِقَةُ ٱلْمَوْتِ ۗ وَإِنَّمَا",39],["3:186:4",74,"وَأَنفُسِكُمْ","and yourselves","۞ لَتُبْلَوُنَّ فِىٓ أَمْوَٰلِكُمْ","وَلَتَسْمَعُنَّ مِنَ ٱلَّذِينَ",39],["4:1:8",77,"نَّفْسٍۢ","a soul","ٱلَّذِى خَلَقَكُم مِّن","وَٰحِدَةٍۢ وَخَلَقَ مِنْهَا",39],["4:4:11",77,"نَفْسًۭا","(on their) own","عَن شَىْءٍۢ مِّنْهُ","فَكُلُوهُ هَنِيٓـًۭٔا مَّرِيٓـًۭٔا",39],["4:29:18",83,"أَنفُسَكُمْ ۚ","yourselves","مِّنكُمْ ۚ وَلَا تَقْتُلُوٓا۟","إِنَّ ٱللَّهَ كَانَ",39],["4:49:6",86,"أَنفُسَهُم ۚ","(for) themselves","إِلَى ٱلَّذِينَ يُزَكُّونَ","بَلِ ٱللَّهُ يُزَكِّى",39],["4:63:14",88,"أَنفُسِهِمْ","their souls","وَقُل لَّهُمْ فِىٓ","قَوْلًۢا بَلِيغًۭا",39],["4:64:13",88,"أَنفُسَهُمْ","themselves","أَنَّهُمْ إِذ ظَّلَمُوٓا۟","جَآءُوكَ فَٱسْتَغْفَرُوا۟ ٱللَّهَ",39],["4:65:14",88,"أَنفُسِهِمْ","themselves","لَا يَجِدُوا۟ فِىٓ","حَرَجًۭا مِّمَّا قَضَيْتَ",39],["4:66:7",89,"أَنفُسَكُمْ","yourselves","عَلَيْهِمْ أَنِ ٱقْتُلُوٓا۟","أَوِ ٱخْرُجُوا۟ مِن",39],["4:79:12",90,"نَّفْسِكَ ۚ","yourself","مِن سَيِّئَةٍۢ فَمِن","وَأَرْسَلْنَـٰكَ لِلنَّاسِ رَسُولًۭا ۚ",39],["4:84:8",91,"نَفْسَكَ ۚ","(for) yourself","لَا تُكَلَّفُ إِلَّا","وَحَرِّضِ ٱلْمُؤْمِنِينَ ۖ عَسَى",39],["4:95:14",94,"وَأَنفُسِهِمْ ۚ","and their lives","سَبِيلِ ٱللَّهِ بِأَمْوَٰلِهِمْ","فَضَّلَ ٱللَّهُ ٱلْمُجَـٰهِدِينَ",39],["4:95:19",94,"وَأَنفُسِهِمْ","and their lives","ٱللَّهُ ٱلْمُجَـٰهِدِينَ بِأَمْوَٰلِهِمْ","عَلَى ٱلْقَـٰعِدِينَ دَرَجَةًۭ ۚ",39],["4:97:6",94,"أَنفُسِهِمْ","themselves","تَوَفَّىٰهُمُ ٱلْمَلَـٰٓئِكَةُ ظَالِمِىٓ","قَالُوا۟ فِيمَ كُنتُمْ ۖ",39],["4:107:6",96,"أَنفُسَهُمْ ۚ","themselves","عَنِ ٱلَّذِينَ يَخْتَانُونَ","إِنَّ ٱللَّهَ لَا",39],["4:110:6",96,"نَفْسَهُۥ","his soul","سُوٓءًا أَوْ يَظْلِمْ","ثُمَّ يَسْتَغْفِرِ ٱللَّهَ",39],["4:111:7",96,"نَفْسِهِۦ ۚ","his soul","فَإِنَّمَا يَكْسِبُهُۥ عَلَىٰ","وَكَانَ ٱللَّهُ عَلِيمًا",39],["4:113:14",96,"أَنفُسَهُمْ ۖ","themselves","وَمَا يُضِلُّونَ إِلَّآ","وَمَا يَضُرُّونَكَ مِن",39],["4:128:19",99,"ٱلْأَنفُسُ","the souls","وَٱلصُّلْحُ خَيْرٌۭ ۗ وَأُحْضِرَتِ","ٱلشُّحَّ ۚ وَإِن تُحْسِنُوا۟",39],["4:135:11",100,"أَنفُسِكُمْ","yourselves","لِلَّهِ وَلَوْ عَلَىٰٓ","أَوِ ٱلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَ ۚ",39],["5:25:7",112,"نَفْسِى","(over) myself","لَآ أَمْلِكُ إِلَّا","وَأَخِى ۖ فَٱفْرُقْ بَيْنَنَا",39],["5:30:3",112,"نَفْسُهُۥ","his soul","فَطَوَّعَتْ لَهُۥ","قَتْلَ أَخِيهِ فَقَتَلَهُۥ",39],["5:32:11",113,"نَفْسًۢا","a soul","أَنَّهُۥ مَن قَتَلَ","بِغَيْرِ نَفْسٍ أَوْ",39],["5:32:13",113,"نَفْسٍ","(for) a soul","قَتَلَ نَفْسًۢا بِغَيْرِ","أَوْ فَسَادٍۢ فِى",39],["5:45:5",115,"ٱلنَّفْسَ","the life","عَلَيْهِمْ فِيهَآ أَنَّ","بِٱلنَّفْسِ وَٱلْعَيْنَ بِٱلْعَيْنِ",39],["5:45:6",115,"بِٱلنَّفْسِ","for the life","فِيهَآ أَنَّ ٱلنَّفْسَ","وَٱلْعَيْنَ بِٱلْعَيْنِ وَٱلْأَنفَ",39],["5:52:27",117,"أَنفُسِهِمْ","themselves","مَآ أَسَرُّوا۟ فِىٓ","نَـٰدِمِينَ",39],["5:70:15",119,"أَنفُسُهُمْ","their souls","بِمَا لَا تَهْوَىٰٓ","فَرِيقًۭا كَذَّبُوا۟ وَفَرِيقًۭا",39],["5:80:11",121,"أَنفُسُهُمْ","their souls","مَا قَدَّمَتْ لَهُمْ","أَن سَخِطَ ٱللَّهُ",39],["5:105:5",125,"أَنفُسَكُمْ ۖ","(is to guard) yourselves","ٱلَّذِينَ ءَامَنُوا۟ عَلَيْكُمْ","لَا يَضُرُّكُم مَّن",39],["5:116:35",127,"نَفْسِى","myself","تَعْلَمُ مَا فِى","وَلَآ أَعْلَمُ مَا",39],["5:116:40",127,"نَفْسِكَ ۚ","Yourself","أَعْلَمُ مَا فِى","إِنَّكَ أَنتَ عَلَّـٰمُ",39],["6:12:11",129,"نَفْسِهِ","Himself","لِّلَّهِ ۚ كَتَبَ عَلَىٰ","ٱلرَّحْمَةَ ۚ لَيَجْمَعَنَّكُمْ إِلَىٰ",39],["6:12:22",129,"أَنفُسَهُمْ","themselves","فِيهِ ۚ ٱلَّذِينَ خَسِرُوٓا۟","فَهُمْ لَا يُؤْمِنُونَ",39],["6:20:10",130,"أَنفُسَهُمْ","themselves","أَبْنَآءَهُمُ ۘ ٱلَّذِينَ خَسِرُوٓا۟","فَهُمْ لَا يُؤْمِنُونَ",39],["6:24:5",130,"أَنفُسِهِمْ ۚ","themselves","كَيْفَ كَذَبُوا۟ عَلَىٰٓ","وَضَلَّ عَنْهُم مَّا",39],["6:26:9",130,"أَنفُسَهُمْ","themselves","وَإِن يُهْلِكُونَ إِلَّآ","وَمَا يَشْعُرُونَ",39],["6:54:12",134,"نَفْسِهِ","Himself","كَتَبَ رَبُّكُمْ عَلَىٰ","ٱلرَّحْمَةَ ۖ أَنَّهُۥ مَنْ",39],["6:70:14",136,"نَفْسٌۢ","a soul","بِهِۦٓ أَن تُبْسَلَ","بِمَا كَسَبَتْ لَيْسَ",39],["6:93:34",139,"أَنفُسَكُمُ ۖ","your souls","بَاسِطُوٓا۟ أَيْدِيهِمْ أَخْرِجُوٓا۟","ٱلْيَوْمَ تُجْزَوْنَ عَذَابَ",39],["6:98:5",140,"نَّفْسٍۢ","a soul","ٱلَّذِىٓ أَنشَأَكُم مِّن","وَٰحِدَةٍۢ فَمُسْتَقَرٌّۭ وَمُسْتَوْدَعٌۭ ۗ",39],["6:104:8",141,"فَلِنَفْسِهِۦ ۖ","then (it is) for his soul","رَّبِّكُمْ ۖ فَمَنْ أَبْصَرَ","وَمَنْ عَمِىَ فَعَلَيْهَا ۚ",39],["6:123:13",143,"بِأَنفُسِهِمْ","against themselves","وَمَا يَمْكُرُونَ إِلَّا","وَمَا يَشْعُرُونَ",39],["6:130:18",144,"أَنفُسِنَا ۖ","ourselves","قَالُوا۟ شَهِدْنَا عَلَىٰٓ","وَغَرَّتْهُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا",39],["6:130:24",144,"أَنفُسِهِمْ","themselves","ٱلدُّنْيَا وَشَهِدُوا۟ عَلَىٰٓ","أَنَّهُمْ كَانُوا۟ كَـٰفِرِينَ",39],["6:151:32",148,"ٱلنَّفْسَ","the soul","بَطَنَ ۖ وَلَا تَقْتُلُوا۟","ٱلَّتِى حَرَّمَ ٱللَّهُ",39],["6:152:18",149,"نَفْسًا","any soul","بِٱلْقِسْطِ ۖ لَا نُكَلِّفُ","إِلَّا وُسْعَهَا ۖ وَإِذَا",39],["6:158:22",150,"نَفْسًا","a soul","رَبِّكَ لَا يَنفَعُ","إِيمَـٰنُهَا لَمْ تَكُنْ",39],["6:164:13",150,"نَفْسٍ","soul","وَلَا تَكْسِبُ كُلُّ","إِلَّا عَلَيْهَا ۚ وَلَا",39],["7:9:7",151,"أَنفُسَهُم","themselves","فَأُو۟لَـٰٓئِكَ ٱلَّذِينَ خَسِرُوٓا۟","بِمَا كَانُوا۟ بِـَٔايَـٰتِنَا",39],["7:23:4",153,"أَنفُسَنَا","ourselves","قَالَا رَبَّنَا ظَلَمْنَآ","وَإِن لَّمْ تَغْفِرْ",39],["7:37:34",154,"أَنفُسِهِمْ","themselves","عَنَّا وَشَهِدُوا۟ عَلَىٰٓ","أَنَّهُمْ كَانُوا۟ كَـٰفِرِينَ",39],["7:42:7",155,"نَفْسًا","any soul","ٱلصَّـٰلِحَـٰتِ لَا نُكَلِّفُ","إِلَّا وُسْعَهَآ أُو۟لَـٰٓئِكَ",39],["7:53:33",157,"أَنفُسَهُمْ","themselves","نَعْمَلُ ۚ قَدْ خَسِرُوٓا۟","وَضَلَّ عَنْهُم مَّا",39],["7:160:42",171,"أَنفُسَهُمْ","(to) themselves","ظَلَمُونَا وَلَـٰكِن كَانُوٓا۟","يَظْلِمُونَ",39],["7:172:12",173,"أَنفُسِهِمْ","themselves","ذُرِّيَّتَهُمْ وَأَشْهَدَهُمْ عَلَىٰٓ","أَلَسْتُ بِرَبِّكُمْ ۖ قَالُوا۟",39],["7:177:7",173,"وَأَنفُسَهُمْ","and themselves","ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا","كَانُوا۟ يَظْلِمُونَ",39],["7:188:4",175,"لِنَفْسِى","for myself","قُل لَّآ أَمْلِكُ","نَفْعًۭا وَلَا ضَرًّا",39],["7:189:5",175,"نَّفْسٍۢ","a soul","ٱلَّذِى خَلَقَكُم مِّن","وَٰحِدَةٍۢ وَجَعَلَ مِنْهَا",39],["7:192:6",175,"أَنفُسَهُمْ","themselves","لَهُمْ نَصْرًۭا وَلَآ","يَنصُرُونَ",39],["7:197:9",176,"أَنفُسَهُمْ","themselves","يَسْتَطِيعُونَ نَصْرَكُمْ وَلَآ","يَنصُرُونَ",39],["7:205:4",176,"نَفْسِكَ","yourself","وَٱذْكُر رَّبَّكَ فِى","تَضَرُّعًۭا وَخِيفَةًۭ وَدُونَ",39],["8:53:14",184,"بِأَنفُسِهِمْ ۙ","(is) in themselves","حَتَّىٰ يُغَيِّرُوا۟ مَا","وَأَنَّ ٱللَّهَ سَمِيعٌ",39],["8:72:7",186,"وَأَنفُسِهِمْ","and their lives","وَهَاجَرُوا۟ وَجَـٰهَدُوا۟ بِأَمْوَٰلِهِمْ","فِى سَبِيلِ ٱللَّهِ",39],["9:17:10",189,"أَنفُسِهِم","themselves","ٱللَّهِ شَـٰهِدِينَ عَلَىٰٓ","بِٱلْكُفْرِ ۚ أُو۟لَـٰٓئِكَ حَبِطَتْ",39],["9:20:9",189,"وَأَنفُسِهِمْ","and their lives","سَبِيلِ ٱللَّهِ بِأَمْوَٰلِهِمْ","أَعْظَمُ دَرَجَةً عِندَ",39],["9:35:15",192,"لِأَنفُسِكُمْ","for yourselves","هَـٰذَا مَا كَنَزْتُمْ","فَذُوقُوا۟ مَا كُنتُمْ",39],["9:36:25",192,"أَنفُسَكُمْ ۚ","yourselves","فَلَا تَظْلِمُوا۟ فِيهِنَّ","وَقَـٰتِلُوا۟ ٱلْمُشْرِكِينَ كَآفَّةًۭ",39],["9:41:6",194,"وَأَنفُسِكُمْ","and your lives","وَثِقَالًۭا وَجَـٰهِدُوا۟ بِأَمْوَٰلِكُمْ","فِى سَبِيلِ ٱللَّهِ ۚ",39],["9:42:19",194,"أَنفُسَهُمْ","their own selves","لَخَرَجْنَا مَعَكُمْ يُهْلِكُونَ","وَٱللَّهُ يَعْلَمُ إِنَّهُمْ",39],["9:44:11",194,"وَأَنفُسِهِمْ ۗ","and their lives","أَن يُجَـٰهِدُوا۟ بِأَمْوَٰلِهِمْ","وَٱللَّهُ عَلِيمٌۢ بِٱلْمُتَّقِينَ",39],["9:55:15",196,"أَنفُسُهُمْ","their souls","ٱلْحَيَوٰةِ ٱلدُّنْيَا وَتَزْهَقَ","وَهُمْ كَـٰفِرُونَ",39],["9:70:25",198,"أَنفُسَهُمْ","themselves","لِيَظْلِمَهُمْ وَلَـٰكِن كَانُوٓا۟","يَظْلِمُونَ",39],["9:81:11",200,"وَأَنفُسِهِمْ","and their lives","أَن يُجَـٰهِدُوا۟ بِأَمْوَٰلِهِمْ","فِى سَبِيلِ ٱللَّهِ",39],["9:85:14",200,"أَنفُسُهُمْ","their souls","فِى ٱلدُّنْيَا وَتَزْهَقَ","وَهُمْ كَـٰفِرُونَ",39],["9:88:8",201,"وَأَنفُسِهِمْ ۚ","and their lives","مَعَهُۥ جَـٰهَدُوا۟ بِأَمْوَٰلِهِمْ","وَأُو۟لَـٰٓئِكَ لَهُمُ ٱلْخَيْرَٰتُ ۖ",39],["9:111:6",204,"أَنفُسَهُمْ","their lives","ٱشْتَرَىٰ مِنَ ٱلْمُؤْمِنِينَ","وَأَمْوَٰلَهُم بِأَنَّ لَهُمُ",39],["9:118:14",206,"أَنفُسُهُمْ","their own souls","رَحُبَتْ وَضَاقَتْ عَلَيْهِمْ","وَظَنُّوٓا۟ أَن لَّا",39],["9:120:16",206,"بِأَنفُسِهِمْ","their lives","ٱللَّهِ وَلَا يَرْغَبُوا۟","عَن نَّفْسِهِۦ ۚ ذَٰلِكَ",39],["9:120:18",206,"نَّفْسِهِۦ ۚ","his life","يَرْغَبُوا۟ بِأَنفُسِهِمْ عَن","ذَٰلِكَ بِأَنَّهُمْ لَا",39],["9:128:5",207,"أَنفُسِكُمْ","yourselves","جَآءَكُمْ رَسُولٌۭ مِّنْ","عَزِيزٌ عَلَيْهِ مَا",39],["10:15:25",210,"نَفْسِىٓ ۖ","my own accord","أُبَدِّلَهُۥ مِن تِلْقَآئِ","إِنْ أَتَّبِعُ إِلَّا",39],["10:23:15",211,"أَنفُسِكُم ۖ","yourselves","إِنَّمَا بَغْيُكُمْ عَلَىٰٓ","مَّتَـٰعَ ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ",39],["10:30:4",212,"نَفْسٍۢ","soul","هُنَالِكَ تَبْلُوا۟ كُلُّ","مَّآ أَسْلَفَتْ ۚ وَرُدُّوٓا۟",39],["10:44:9",214,"أَنفُسَهُمْ","wrong themselves","شَيْـًۭٔا وَلَـٰكِنَّ ٱلنَّاسَ","يَظْلِمُونَ",39],["10:49:4",214,"لِنَفْسِى","for myself","قُل لَّآ أَمْلِكُ","ضَرًّۭا وَلَا نَفْعًا",39],["10:54:4",215,"نَفْسٍۢ","soul","وَلَوْ أَنَّ لِكُلِّ","ظَلَمَتْ مَا فِى",39],["10:100:3",220,"لِنَفْسٍ","for a soul","وَمَا كَانَ","أَن تُؤْمِنَ إِلَّا",39],["10:108:13",221,"لِنَفْسِهِۦ ۖ","for his soul","ٱهْتَدَىٰ فَإِنَّمَا يَهْتَدِى","وَمَن ضَلَّ فَإِنَّمَا",39],["11:21:4",224,"أَنفُسَهُمْ","their souls","أُو۟لَـٰٓئِكَ ٱلَّذِينَ خَسِرُوٓا۟","وَضَلَّ عَنْهُم مَّا",39],["11:31:27",225,"أَنفُسِهِمْ  ۖ","their souls","أَعْلَمُ بِمَا فِىٓ","إِنِّىٓ إِذًۭا لَّمِنَ",39],["11:101:5",233,"أَنفُسَهُمْ ۖ","themselves","ظَلَمْنَـٰهُمْ وَلَـٰكِن ظَلَمُوٓا۟","فَمَآ أَغْنَتْ عَنْهُمْ",39],["11:105:5",233,"نَفْسٌ","a soul","يَأْتِ لَا تَكَلَّمُ","إِلَّا بِإِذْنِهِۦ ۚ فَمِنْهُمْ",39],["12:18:10",237,"أَنفُسُكُمْ","your souls","بَلْ سَوَّلَتْ لَكُمْ","أَمْرًۭا ۖ فَصَبْرٌۭ جَمِيلٌۭ ۖ",39],["12:23:7",238,"نَّفْسِهِۦ","his self","فِى بَيْتِهَا عَن","وَغَلَّقَتِ ٱلْأَبْوَٰبَ وَقَالَتْ",39],["12:26:5",238,"نَّفْسِى ۚ","myself","هِىَ رَٰوَدَتْنِى عَن","وَشَهِدَ شَاهِدٌۭ مِّنْ",39],["12:30:10",238,"نَّفْسِهِۦ ۖ","himself","تُرَٰوِدُ فَتَىٰهَا عَن","قَدْ شَغَفَهَا حُبًّا ۖ",39],["12:32:9",239,"نَّفْسِهِۦ","[himself]","وَلَقَدْ رَٰوَدتُّهُۥ عَن","فَٱسْتَعْصَمَ ۖ وَلَئِن لَّمْ",39],["12:51:8",241,"نَّفْسِهِۦ ۚ","himself","رَٰوَدتُّنَّ يُوسُفَ عَن","قُلْنَ حَـٰشَ لِلَّهِ",39],["12:51:26",241,"نَّفْسِهِۦ","himself","أَنَا۠ رَٰوَدتُّهُۥ عَن","وَإِنَّهُۥ لَمِنَ ٱلصَّـٰدِقِينَ",39],["12:53:3",242,"نَفْسِىٓ ۚ","myself","۞ وَمَآ أُبَرِّئُ","إِنَّ ٱلنَّفْسَ لَأَمَّارَةٌۢ",39],["12:53:5",242,"ٱلنَّفْسَ","the soul","أُبَرِّئُ نَفْسِىٓ ۚ إِنَّ","لَأَمَّارَةٌۢ بِٱلسُّوٓءِ إِلَّا",39],["12:54:6",242,"لِنَفْسِى ۖ","for myself","ٱئْتُونِى بِهِۦٓ أَسْتَخْلِصْهُ","فَلَمَّا كَلَّمَهُۥ قَالَ",39],["12:68:18",243,"نَفْسِ","Yaqub's soul","إِلَّا حَاجَةًۭ فِى","يَعْقُوبَ قَضَىٰهَا ۚ وَإِنَّهُۥ",39],["12:77:13",244,"نَفْسِهِۦ","himself","فَأَسَرَّهَا يُوسُفُ فِى","وَلَمْ يُبْدِهَا لَهُمْ ۚ",39],["12:83:5",245,"أَنفُسُكُمْ","your souls","بَلْ سَوَّلَتْ لَكُمْ","أَمْرًۭا ۖ فَصَبْرٌۭ جَمِيلٌ ۖ",39],["13:11:21",250,"بِأَنفُسِهِمْ ۗ","(is) in themselves","حَتَّىٰ يُغَيِّرُوا۟ مَا","وَإِذَآ أَرَادَ ٱللَّهُ",39],["13:16:15",251,"لِأَنفُسِهِمْ","for themselves","أَوْلِيَآءَ لَا يَمْلِكُونَ","نَفْعًۭا وَلَا ضَرًّۭا ۚ",39],["13:33:6",253,"نَفْسٍۭ","soul","قَآئِمٌ عَلَىٰ كُلِّ","بِمَا كَسَبَتْ ۗ وَجَعَلُوا۟",39],["13:42:13",254,"نَفْسٍۢ ۗ","soul","مَا تَكْسِبُ كُلُّ","وَسَيَعْلَمُ ٱلْكُفَّـٰرُ لِمَنْ",39],["14:22:27",258,"أَنفُسَكُم ۖ","yourselves","فَلَا تَلُومُونِى وَلُومُوٓا۟","مَّآ أَنَا۠ بِمُصْرِخِكُمْ",39],["14:45:6",261,"أَنفُسَهُمْ","themselves","مَسَـٰكِنِ ٱلَّذِينَ ظَلَمُوٓا۟","وَتَبَيَّنَ لَكُمْ كَيْفَ",39],["14:51:4",261,"نَفْسٍۢ","soul","لِيَجْزِىَ ٱللَّهُ كُلَّ","مَّا كَسَبَتْ ۚ إِنَّ",39],["16:7:10",268,"ٱلْأَنفُسِ ۚ","(to) yourselves","بَـٰلِغِيهِ إِلَّا بِشِقِّ","إِنَّ رَبَّكُمْ لَرَءُوفٌۭ",39],["16:28:5",270,"أَنفُسِهِمْ ۖ","themselves","تَتَوَفَّىٰهُمُ ٱلْمَلَـٰٓئِكَةُ ظَالِمِىٓ","فَأَلْقَوُا۟ ٱلسَّلَمَ مَا",39],["16:33:21",270,"أَنفُسَهُمْ","themselves","ٱللَّهُ وَلَـٰكِن كَانُوٓا۟","يَظْلِمُونَ",39],["16:72:5",274,"أَنفُسِكُمْ","yourselves","جَعَلَ لَكُم مِّنْ","أَزْوَٰجًۭا وَجَعَلَ لَكُم",39],["16:89:9",277,"أَنفُسِهِمْ ۖ","themselves","شَهِيدًا عَلَيْهِم مِّنْ","وَجِئْنَا بِكَ شَهِيدًا",39],["16:111:4",280,"نَفْسٍۢ","soul","۞ يَوْمَ تَأْتِى كُلُّ","تُجَـٰدِلُ عَن نَّفْسِهَا",39],["16:111:7",280,"نَّفْسِهَا","itself","نَفْسٍۢ تُجَـٰدِلُ عَن","وَتُوَفَّىٰ كُلُّ نَفْسٍۢ",39],["16:111:10",280,"نَفْسٍۢ","soul","نَّفْسِهَا وَتُوَفَّىٰ كُلُّ","مَّا عَمِلَتْ وَهُمْ",39],["16:118:14",280,"أَنفُسَهُمْ","themselves","ظَلَمْنَـٰهُمْ وَلَـٰكِن كَانُوٓا۟","يَظْلِمُونَ",39],["17:7:4",282,"لِأَنفُسِكُمْ ۖ","for yourselves","إِنْ أَحْسَنتُمْ أَحْسَنتُمْ","وَإِنْ أَسَأْتُمْ فَلَهَا ۚ",39],["17:14:4",283,"بِنَفْسِكَ","(is) yourself","ٱقْرَأْ كِتَـٰبَكَ كَفَىٰ","ٱلْيَوْمَ عَلَيْكَ حَسِيبًۭا",39],["17:15:5",283,"لِنَفْسِهِۦ ۖ","for his soul","ٱهْتَدَىٰ فَإِنَّمَا يَهْتَدِى","وَمَن ضَلَّ فَإِنَّمَا",39],["17:25:5",284,"نُفُوسِكُمْ ۚ","yourselves","أَعْلَمُ بِمَا فِى","إِن تَكُونُوا۟ صَـٰلِحِينَ",39],["17:33:3",285,"ٱلنَّفْسَ","the soul","وَلَا تَقْتُلُوا۟","ٱلَّتِى حَرَّمَ ٱللَّهُ",39],["18:6:3",294,"نَّفْسَكَ","yourself","فَلَعَلَّكَ بَـٰخِعٌۭ","عَلَىٰٓ ءَاثَـٰرِهِمْ إِن",39],["18:28:2",297,"نَفْسَكَ","yourself","وَٱصْبِرْ","مَعَ ٱلَّذِينَ يَدْعُونَ",39],["18:35:5",298,"لِّنَفْسِهِۦ","to himself","جَنَّتَهُۥ وَهُوَ ظَالِمٌۭ","قَالَ مَآ أَظُنُّ",39],["18:51:8",299,"أَنفُسِهِمْ","(of) themselves","وَٱلْأَرْضِ وَلَا خَلْقَ","وَمَا كُنتُ مُتَّخِذَ",39],["18:74:9",301,"نَفْسًۭا","a soul","فَقَتَلَهُۥ قَالَ أَقَتَلْتَ","زَكِيَّةًۢ بِغَيْرِ نَفْسٍۢ",39],["18:74:12",301,"نَفْسٍۢ","a soul","نَفْسًۭا زَكِيَّةًۢ بِغَيْرِ","لَّقَدْ جِئْتَ شَيْـًۭٔا",39],["20:15:8",313,"نَفْسٍۭ","soul","أُخْفِيهَا لِتُجْزَىٰ كُلُّ","بِمَا تَسْعَىٰ",39],["20:40:19",314,"نَفْسًۭا","a man","وَلَا تَحْزَنَ ۚ وَقَتَلْتَ","فَنَجَّيْنَـٰكَ مِنَ ٱلْغَمِّ",39],["20:41:2",314,"لِنَفْسِى","for Myself","وَٱصْطَنَعْتُكَ","",39],["20:67:3",316,"نَفْسِهِۦ","himself","فَأَوْجَسَ فِى","خِيفَةًۭ مُّوسَىٰ",39],["20:96:16",318,"نَفْسِى","my soul","وَكَذَٰلِكَ سَوَّلَتْ لِى","",39],["21:35:2",324,"نَفْسٍۢ","soul","كُلُّ","ذَآئِقَةُ ٱلْمَوْتِ ۗ وَنَبْلُوكُم",39],["21:43:10",325,"أَنفُسِهِمْ","themselves","لَا يَسْتَطِيعُونَ نَصْرَ","وَلَا هُم مِّنَّا",39],["21:47:8",326,"نَفْسٌۭ","any soul","ٱلْقِيَـٰمَةِ فَلَا تُظْلَمُ","شَيْـًۭٔا ۖ وَإِن كَانَ",39],["21:64:3",327,"أَنفُسِهِمْ","themselves","فَرَجَعُوٓا۟ إِلَىٰٓ","فَقَالُوٓا۟ إِنَّكُمْ أَنتُمُ",39],["21:102:8",331,"أَنفُسُهُمْ","their souls","فِى مَا ٱشْتَهَتْ","خَـٰلِدُونَ",39],["23:62:3",346,"نَفْسًا","any soul","وَلَا نُكَلِّفُ","إِلَّا وُسْعَهَا ۖ وَلَدَيْنَا",39],["23:103:7",348,"أَنفُسَهُمْ","their souls","فَأُو۟لَـٰٓئِكَ ٱلَّذِينَ خَسِرُوٓا۟","فِى جَهَنَّمَ خَـٰلِدُونَ",39],["24:6:9",350,"أَنفُسُهُمْ","themselves","لَّهُمْ شُهَدَآءُ إِلَّآ","فَشَهَـٰدَةُ أَحَدِهِمْ أَرْبَعُ",39],["24:12:7",351,"بِأَنفُسِهِمْ","good of themselves","ظَنَّ ٱلْمُؤْمِنُونَ وَٱلْمُؤْمِنَـٰتُ","خَيْرًۭا وَقَالُوا۟ هَـٰذَآ",39],["24:61:15",358,"أَنفُسِكُمْ","yourselves","حَرَجٌۭ وَلَا عَلَىٰٓ","أَن تَأْكُلُوا۟ مِنۢ",39],["24:61:63",358,"أَنفُسِكُمْ","yourselves","بُيُوتًۭا فَسَلِّمُوا۟ عَلَىٰٓ","تَحِيَّةًۭ مِّنْ عِندِ",39],["25:3:12",360,"لِأَنفُسِهِمْ","for themselves","يُخْلَقُونَ وَلَا يَمْلِكُونَ","ضَرًّۭا وَلَا نَفْعًۭا",39],["25:21:16",362,"أَنفُسِهِمْ","themselves","لَقَدِ ٱسْتَكْبَرُوا۟ فِىٓ","وَعَتَوْ عُتُوًّۭا كَبِيرًۭا",39],["25:68:10",366,"ٱلنَّفْسَ","the soul","ءَاخَرَ وَلَا يَقْتُلُونَ","ٱلَّتِى حَرَّمَ ٱللَّهُ",39],["26:3:3",367,"نَّفْسَكَ","yourself","لَعَلَّكَ بَـٰخِعٌۭ","أَلَّا يَكُونُوا۟ مُؤْمِنِينَ",39],["27:14:4",378,"أَنفُسُهُمْ","themselves","وَجَحَدُوا۟ بِهَا وَٱسْتَيْقَنَتْهَآ","ظُلْمًۭا وَعُلُوًّۭا ۚ فَٱنظُرْ",39],["27:40:32",380,"لِنَفْسِهِۦ ۖ","for his own soul","شَكَرَ فَإِنَّمَا يَشْكُرُ","وَمَن كَفَرَ فَإِنَّ",39],["27:44:22",380,"نَفْسِى","myself","رَبِّ إِنِّى ظَلَمْتُ","وَأَسْلَمْتُ مَعَ سُلَيْمَـٰنَ",39],["27:92:8",385,"لِنَفْسِهِۦ ۖ","for himself","ٱهْتَدَىٰ فَإِنَّمَا يَهْتَدِى","وَمَن ضَلَّ فَقُلْ",39],["28:16:5",387,"نَفْسِى","my soul","رَبِّ إِنِّى ظَلَمْتُ","فَٱغْفِرْ لِى فَغَفَرَ",39],["28:19:17",387,"نَفْسًۢا","a person","تَقْتُلَنِى كَمَا قَتَلْتَ","بِٱلْأَمْسِ ۖ إِن تُرِيدُ",39],["28:33:6",389,"نَفْسًۭا","a man","إِنِّى قَتَلْتُ مِنْهُمْ","فَأَخَافُ أَن يَقْتُلُونِ",39],["29:6:5",396,"لِنَفْسِهِۦٓ ۚ","for himself","جَـٰهَدَ فَإِنَّمَا يُجَـٰهِدُ","إِنَّ ٱللَّهَ لَغَنِىٌّ",39],["29:40:27",401,"أَنفُسَهُمْ","themselves","لِيَظْلِمَهُمْ وَلَـٰكِن كَانُوٓا۟","يَظْلِمُونَ",39],["29:57:2",403,"نَفْسٍۢ","soul","كُلُّ","ذَآئِقَةُ ٱلْمَوْتِ ۖ ثُمَّ",39],["30:8:4",405,"أَنفُسِهِم ۗ","themselves","أَوَلَمْ يَتَفَكَّرُوا۟ فِىٓ","مَّا خَلَقَ ٱللَّهُ",39],["30:9:31",405,"أَنفُسَهُمْ","themselves","لِيَظْلِمَهُمْ وَلَـٰكِن كَانُوٓا۟","يَظْلِمُونَ",39],["30:21:7",406,"أَنفُسِكُمْ","yourselves","خَلَقَ لَكُم مِّنْ","أَزْوَٰجًۭا لِّتَسْكُنُوٓا۟ إِلَيْهَا",39],["30:28:5",407,"أَنفُسِكُمْ ۖ","yourselves","لَكُم مَّثَلًۭا مِّنْ","هَل لَّكُم مِّن",39],["30:28:22",407,"أَنفُسَكُمْ ۚ","yourselves","سَوَآءٌۭ تَخَافُونَهُمْ كَخِيفَتِكُمْ","كَذَٰلِكَ نُفَصِّلُ ٱلْـَٔايَـٰتِ",39],["30:44:8",409,"فَلِأَنفُسِهِمْ","then for themselves","وَمَنْ عَمِلَ صَـٰلِحًۭا","يَمْهَدُونَ",39],["31:12:12",412,"لِنَفْسِهِۦ ۖ","for himself","يَشْكُرْ فَإِنَّمَا يَشْكُرُ","وَمَن كَفَرَ فَإِنَّ",39],["31:28:6",413,"كَنَفْسٍۢ","as a soul","وَلَا بَعْثُكُمْ إِلَّا","وَٰحِدَةٍ ۗ إِنَّ ٱللَّهَ",39],["31:34:14",414,"نَفْسٌۭ","any soul","ٱلْأَرْحَامِ ۖ وَمَا تَدْرِى","مَّاذَا تَكْسِبُ غَدًۭا ۖ",39],["31:34:20",414,"نَفْسٌۢ","any soul","غَدًۭا ۖ وَمَا تَدْرِى","بِأَىِّ أَرْضٍۢ تَمُوتُ ۚ",39],["32:13:5",416,"نَفْسٍ","soul","شِئْنَا لَـَٔاتَيْنَا كُلَّ","هُدَىٰهَا وَلَـٰكِنْ حَقَّ",39],["32:17:3",416,"نَفْسٌۭ","a soul","فَلَا تَعْلَمُ","مَّآ أُخْفِىَ لَهُم",39],["32:27:15",417,"وَأَنفُسُهُمْ ۖ","and they themselves","تَأْكُلُ مِنْهُ أَنْعَـٰمُهُمْ","أَفَلَا يُبْصِرُونَ",39],["33:6:5",418,"أَنفُسِهِمْ ۖ","their own selves","أَوْلَىٰ بِٱلْمُؤْمِنِينَ مِنْ","وَأَزْوَٰجُهُۥٓ أُمَّهَـٰتُهُمْ ۗ وَأُو۟لُوا۟",39],["33:37:16",423,"نَفْسِكَ","yourself","ٱللَّهَ وَتُخْفِى فِى","مَا ٱللَّهُ مُبْدِيهِ",39],["33:50:32",424,"نَفْسَهَا","herself","مُّؤْمِنَةً إِن وَهَبَتْ","لِلنَّبِىِّ إِنْ أَرَادَ",39],["34:19:7",430,"أَنفُسَهُمْ","themselves","بَيْنَ أَسْفَارِنَا وَظَلَمُوٓا۟","فَجَعَلْنَـٰهُمْ أَحَادِيثَ وَمَزَّقْنَـٰهُمْ",39],["34:50:7",434,"نَفْسِى ۖ","myself","فَإِنَّمَآ أَضِلُّ عَلَىٰ","وَإِنِ ٱهْتَدَيْتُ فَبِمَا",39],["35:8:18",435,"نَفْسُكَ","your soul","يَشَآءُ ۖ فَلَا تَذْهَبْ","عَلَيْهِمْ حَسَرَٰتٍ ۚ إِنَّ",39],["35:18:31",436,"لِنَفْسِهِۦ ۚ","for his own self","تَزَكَّىٰ فَإِنَّمَا يَتَزَكَّىٰ","وَإِلَى ٱللَّهِ ٱلْمَصِيرُ",39],["35:32:10",438,"لِّنَفْسِهِۦ","himself","عِبَادِنَا ۖ فَمِنْهُمْ ظَالِمٌۭ","وَمِنْهُم مُّقْتَصِدٌۭ وَمِنْهُمْ",39],["36:36:10",442,"أَنفُسِهِمْ","themselves","تُنۢبِتُ ٱلْأَرْضُ وَمِنْ","وَمِمَّا لَا يَعْلَمُونَ",39],["36:54:4",443,"نَفْسٌۭ","a soul","فَٱلْيَوْمَ لَا تُظْلَمُ","شَيْـًۭٔا وَلَا تُجْزَوْنَ",39],["37:113:9",450,"لِّنَفْسِهِۦ","to himself","ذُرِّيَّتِهِمَا مُحْسِنٌۭ وَظَالِمٌۭ","مُبِينٌۭ",39],["39:6:3",459,"نَّفْسٍۢ","a soul","خَلَقَكُم مِّن","وَٰحِدَةٍۢ ثُمَّ جَعَلَ",39],["39:15:11",460,"أَنفُسَهُمْ","themselves","ٱلْخَـٰسِرِينَ ٱلَّذِينَ خَسِرُوٓا۟","وَأَهْلِيهِمْ يَوْمَ ٱلْقِيَـٰمَةِ ۗ",39],["39:41:9",463,"فَلِنَفْسِهِۦ ۖ","then (it is) for his soul","بِٱلْحَقِّ ۖ فَمَنِ ٱهْتَدَىٰ","وَمَن ضَلَّ فَإِنَّمَا",39],["39:42:3",463,"ٱلْأَنفُسَ","the souls","ٱللَّهُ يَتَوَفَّى","حِينَ مَوْتِهَا وَٱلَّتِى",39],["39:53:6",464,"أَنفُسِهِمْ","themselves","ٱلَّذِينَ أَسْرَفُوا۟ عَلَىٰٓ","لَا تَقْنَطُوا۟ مِن",39],["39:56:3",464,"نَفْسٌۭ","a soul","أَن تَقُولَ","يَـٰحَسْرَتَىٰ عَلَىٰ مَا",39],["39:70:3",466,"نَفْسٍۢ","soul","وَوُفِّيَتْ كُلُّ","مَّا عَمِلَتْ وَهُوَ",39],["40:10:10",468,"أَنفُسَكُمْ","(of) yourselves","أَكْبَرُ مِن مَّقْتِكُمْ","إِذْ تُدْعَوْنَ إِلَى",39],["40:17:4",469,"نَفْسٍۭ","soul","ٱلْيَوْمَ تُجْزَىٰ كُلُّ","بِمَا كَسَبَتْ ۚ لَا",39],["41:31:12",480,"أَنفُسُكُمْ","your souls","فِيهَا مَا تَشْتَهِىٓ","وَلَكُمْ فِيهَا مَا",39],["41:46:4",481,"فَلِنَفْسِهِۦ ۖ","then it is for his soul","مَّنْ عَمِلَ صَـٰلِحًۭا","وَمَنْ أَسَآءَ فَعَلَيْهَا ۗ",39],["41:53:6",482,"أَنفُسِهِمْ","themselves","فِى ٱلْـَٔافَاقِ وَفِىٓ","حَتَّىٰ يَتَبَيَّنَ لَهُمْ",39],["42:11:7",484,"أَنفُسِكُمْ","yourselves","جَعَلَ لَكُم مِّنْ","أَزْوَٰجًۭا وَمِنَ ٱلْأَنْعَـٰمِ",39],["42:45:18",488,"أَنفُسَهُمْ","themselves","ٱلْخَـٰسِرِينَ ٱلَّذِينَ خَسِرُوٓا۟","وَأَهْلِيهِمْ يَوْمَ ٱلْقِيَـٰمَةِ ۗ",39],["43:71:10",494,"ٱلْأَنفُسُ","the souls","وَفِيهَا مَا تَشْتَهِيهِ","وَتَلَذُّ ٱلْأَعْيُنُ ۖ وَأَنتُمْ",39],["45:15:4",500,"فَلِنَفْسِهِۦ ۖ","then it is for his soul","مَنْ عَمِلَ صَـٰلِحًۭا","وَمَنْ أَسَآءَ فَعَلَيْهَا ۖ",39],["45:22:8",500,"نَفْسٍۭ","soul","بِٱلْحَقِّ وَلِتُجْزَىٰ كُلُّ","بِمَا كَسَبَتْ وَهُمْ",39],["47:38:16",510,"نَّفْسِهِۦ ۚ","himself","فَإِنَّمَا يَبْخَلُ عَن","وَٱللَّهُ ٱلْغَنِىُّ وَأَنتُمُ",39],["48:10:16",512,"نَفْسِهِۦ ۖ","himself","فَإِنَّمَا يَنكُثُ عَلَىٰ","وَمَنْ أَوْفَىٰ بِمَا",39],["49:11:25",516,"أَنفُسَكُمْ","yourselves","مِّنْهُنَّ ۖ وَلَا تَلْمِزُوٓا۟","وَلَا تَنَابَزُوا۟ بِٱلْأَلْقَـٰبِ ۖ",39],["49:15:12",517,"وَأَنفُسِهِمْ","and their lives","يَرْتَابُوا۟ وَجَـٰهَدُوا۟ بِأَمْوَٰلِهِمْ","فِى سَبِيلِ ٱللَّهِ ۚ",39],["50:16:8",519,"نَفْسُهُۥ ۖ","his soul","مَا تُوَسْوِسُ بِهِۦ","وَنَحْنُ أَقْرَبُ إِلَيْهِ",39],["50:21:3",519,"نَفْسٍۢ","soul","وَجَآءَتْ كُلُّ","مَّعَهَا سَآئِقٌۭ وَشَهِيدٌۭ",39],["51:21:2",521,"أَنفُسِكُمْ ۚ","yourselves","وَفِىٓ","أَفَلَا تُبْصِرُونَ",39],["53:23:20",526,"ٱلْأَنفُسُ ۖ","the(ir) souls","ٱلظَّنَّ وَمَا تَهْوَى","وَلَقَدْ جَآءَهُم مِّن",39],["53:32:27",527,"أَنفُسَكُمْ ۖ","(to) yourselves","أُمَّهَـٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟","هُوَ أَعْلَمُ بِمَنِ",39],["57:14:9",539,"أَنفُسَكُمْ","yourselves","بَلَىٰ وَلَـٰكِنَّكُمْ فَتَنتُمْ","وَتَرَبَّصْتُمْ وَٱرْتَبْتُمْ وَغَرَّتْكُمُ",39],["57:22:9",540,"أَنفُسِكُمْ","yourselves","ٱلْأَرْضِ وَلَا فِىٓ","إِلَّا فِى كِتَـٰبٍۢ",39],["58:8:28",543,"أَنفُسِهِمْ","themselves","ٱللَّهُ وَيَقُولُونَ فِىٓ","لَوْلَا يُعَذِّبُنَا ٱللَّهُ",39],["59:9:20",546,"أَنفُسِهِمْ","themselves","أُوتُوا۟ وَيُؤْثِرُونَ عَلَىٰٓ","وَلَوْ كَانَ بِهِمْ",39],["59:9:28",546,"نَفْسِهِۦ","(of) his soul","وَمَن يُوقَ شُحَّ","فَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ",39],["59:18:7",548,"نَفْسٌۭ","every soul","ٱتَّقُوا۟ ٱللَّهَ وَلْتَنظُرْ","مَّا قَدَّمَتْ لِغَدٍۢ ۖ",39],["59:19:7",548,"أَنفُسَهُمْ ۚ","themselves","نَسُوا۟ ٱللَّهَ فَأَنسَىٰهُمْ","أُو۟لَـٰٓئِكَ هُمُ ٱلْفَـٰسِقُونَ",39],["61:11:9",552,"وَأَنفُسِكُمْ ۚ","and your lives","سَبِيلِ ٱللَّهِ بِأَمْوَٰلِكُمْ","ذَٰلِكُمْ خَيْرٌۭ لَّكُمْ",39],["63:11:4",555,"نَفْسًا","a soul","وَلَن يُؤَخِّرَ ٱللَّهُ","إِذَا جَآءَ أَجَلُهَا ۚ",39],["64:16:9",557,"لِّأَنفُسِكُمْ ۗ","for yourselves","وَأَطِيعُوا۟ وَأَنفِقُوا۟ خَيْرًۭا","وَمَن يُوقَ شُحَّ",39],["64:16:13",557,"نَفْسِهِۦ","(of) his soul","وَمَن يُوقَ شُحَّ","فَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ",39],["65:1:33",558,"نَفْسَهُۥ ۚ","himself","ٱللَّهِ فَقَدْ ظَلَمَ","لَا تَدْرِى لَعَلَّ",39],["65:7:17",559,"نَفْسًا","any soul","لَا يُكَلِّفُ ٱللَّهُ","إِلَّا مَآ ءَاتَىٰهَا ۚ",39],["66:6:5",560,"أَنفُسَكُمْ","yourselves","ٱلَّذِينَ ءَامَنُوا۟ قُوٓا۟","وَأَهْلِيكُمْ نَارًۭا وَقُودُهَا",39],["73:20:63",575,"لِأَنفُسِكُم","for yourselves","حَسَنًۭا ۚ وَمَا تُقَدِّمُوا۟","مِّنْ خَيْرٍۢ تَجِدُوهُ",39],["74:38:2",576,"نَفْسٍۭ","soul","كُلُّ","بِمَا كَسَبَتْ رَهِينَةٌ",39],["75:2:3",577,"بِٱلنَّفْسِ","by the soul","وَلَآ أُقْسِمُ","ٱللَّوَّامَةِ",39],["75:14:4",577,"نَفْسِهِۦ","himself","بَلِ ٱلْإِنسَـٰنُ عَلَىٰ","بَصِيرَةٌۭ",39],["79:40:7",584,"ٱلنَّفْسَ","his soul","مَقَامَ رَبِّهِۦ وَنَهَى","عَنِ ٱلْهَوَىٰ",39],["81:7:2",586,"ٱلنُّفُوسُ","the souls","وَإِذَا","زُوِّجَتْ",39],["81:14:2",586,"نَفْسٌۭ","a soul","عَلِمَتْ","مَّآ أَحْضَرَتْ",39],["81:18:3",586,"تَنَفَّسَ","it breathes","وَٱلصُّبْحِ إِذَا","",4399],["82:5:2",587,"نَفْسٌۭ","a soul","عَلِمَتْ","مَّا قَدَّمَتْ وَأَخَّرَتْ",39],["82:19:4",587,"نَفْسٌۭ","a soul","يَوْمَ لَا تَمْلِكُ","لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ",39],["82:19:5",587,"لِّنَفْسٍۢ","for a soul","لَا تَمْلِكُ نَفْسٌۭ","شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ",39],["83:26:5",588,"فَلْيَتَنَافَسِ","let aspire","مِسْكٌۭ ۚ وَفِى ذَٰلِكَ","ٱلْمُتَنَـٰفِسُونَ",4683],["83:26:6",588,"ٱلْمُتَنَـٰفِسُونَ","the aspirers","وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ","",3876],["86:4:3",591,"نَفْسٍۢ","soul","إِن كُلُّ","لَّمَّا عَلَيْهَا حَافِظٌۭ",39],["89:27:2",594,"ٱلنَّفْسُ","soul","يَـٰٓأَيَّتُهَا","ٱلْمُطْمَئِنَّةُ",39],["91:7:1",595,"وَنَفْسٍۢ","And (the) soul","","وَمَا سَوَّىٰهَا",39]]