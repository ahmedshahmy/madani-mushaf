[["2:211:4",33,"كَمْ","how many","سَلْ بَنِىٓ إِسْرَٰٓءِيلَ","ءَاتَيْنَـٰهُم مِّنْ ءَايَةٍۭ",489],["2:249:49",41,"كَم","How many","أَنَّهُم مُّلَـٰقُوا۟ ٱللَّهِ","مِّن فِئَةٍۢ قَلِيلَةٍ",489],["2:259:24",43,"كَمْ","How long","ثُمَّ بَعَثَهُۥ ۖ قَالَ","لَبِثْتَ ۖ قَالَ لَبِثْتُ",489],["6:6:3",128,"كَمْ","how many","أَلَمْ يَرَوْا۟","أَهْلَكْنَا مِن قَبْلِهِم",489],["7:4:1",151,"وَكَم","And how many","","مِّن قَرْيَةٍ أَهْلَكْنَـٰهَا",489],["17:17:1",283,"وَكَمْ","And how many","","أَهْلَكْنَا مِنَ ٱلْقُرُونِ",489],["18:19:8",295,"كَمْ","How long","قَالَ قَآئِلٌۭ مِّنْهُمْ","لَبِثْتُمْ ۖ قَالُوا۟ لَبِثْنَا",489],["19:74:1",310,"وَكَمْ","And how many","","أَهْلَكْنَا قَبْلَهُم مِّن",489],["19:98:1",312,"وَكَمْ","And how many","","أَهْلَكْنَا قَبْلَهُم مِّن",489],["20:128:4",321,"كَمْ","how many","أَفَلَمْ يَهْدِ لَهُمْ","أَهْلَكْنَا قَبْلَهُم مِّنَ",489],["21:11:1",323,"وَكَمْ","And how many","","قَصَمْنَا مِن قَرْيَةٍۢ",489],["23:112:2",349,"كَمْ","How long","قَـٰلَ","لَبِثْتُمْ فِى ٱلْأَرْضِ",489],["26:7:5",367,"كَمْ","how many","يَرَوْا۟ إِلَى ٱلْأَرْضِ","أَنۢبَتْنَا فِيهَا مِن",489],["28:58:1",392,"وَكَمْ","And how many","","أَهْلَكْنَا مِن قَرْيَةٍۭ",489],["32:26:4",417,"كَمْ","(that) how many","أَوَلَمْ يَهْدِ لَهُمْ","أَهْلَكْنَا مِن قَبْلِهِم",489],["36:31:3",442,"كَمْ","how many","أَلَمْ يَرَوْا۟","أَهْلَكْنَا قَبْلَهُم مِّنَ",489],["38:3:1",453,"كَمْ","How many","","أَهْلَكْنَا مِن قَبْلِهِم",489],["43:6:1",489,"وَكَمْ","And how many","","أَرْسَلْنَا مِن نَّبِىٍّۢ",489],["44:25:1",497,"كَمْ","How many","","تَرَكُوا۟ مِن جَنَّـٰتٍۢ",489],["50:36:1",520,"وَكَمْ","And how many","","أَهْلَكْنَا قَبْلَهُم مِّن",489],["53:26:1",526,"۞ وَكَم","And how many","","مِّن مَّلَكٍۢ فِى",489]]