[["4:71:6",89,"فَٱنفِرُوا۟","and advance","ءَامَنُوا۟ خُذُوا۟ حِذْرَكُمْ","ثُبَاتٍ أَوِ ٱنفِرُوا۟",993],["4:71:9",89,"ٱنفِرُوا۟","advance","فَٱنفِرُوا۟ ثُبَاتٍ أَوِ","جَمِيعًۭا",993],["9:38:9",193,"ٱنفِرُوا۟","go forth","إِذَا قِيلَ لَكُمُ","فِى سَبِيلِ ٱللَّهِ",993],["9:39:2",193,"تَنفِرُوا۟","you go forth","إِلَّا","يُعَذِّبْكُمْ عَذَابًا أَلِيمًۭا",993],["9:41:1",194,"ٱنفِرُوا۟","Go forth","","خِفَافًۭا وَثِقَالًۭا وَجَـٰهِدُوا۟",993],["9:81:17",200,"تَنفِرُوا۟","go forth","ٱللَّهِ وَقَالُوا۟ لَا","فِى ٱلْحَرِّ ۗ قُلْ",993],["9:122:4",206,"لِيَنفِرُوا۟","that they go forth","۞ وَمَا كَانَ ٱلْمُؤْمِنُونَ","كَآفَّةًۭ ۚ فَلَوْلَا نَفَرَ",993],["9:122:7",206,"نَفَرَ","go forth","لِيَنفِرُوا۟ كَآفَّةًۭ ۚ فَلَوْلَا","مِن كُلِّ فِرْقَةٍۢ",993],["17:6:11",282,"نَفِيرًا","numerous","وَبَنِينَ وَجَعَلْنَـٰكُمْ أَكْثَرَ","",4029],["17:41:10",286,"نُفُورًۭا","(in) aversion","وَمَا يَزِيدُهُمْ إِلَّا","",1380],["17:46:19",286,"نُفُورًۭا","(in) aversion","وَلَّوْا۟ عَلَىٰٓ أَدْبَـٰرِهِمْ","",1380],["18:34:13",297,"نَفَرًۭا","(in) men","مِنكَ مَالًۭا وَأَعَزُّ","",1942],["25:60:13",365,"نُفُورًۭا ۩","(in) aversion","لِمَا تَأْمُرُنَا وَزَادَهُمْ","",1380],["35:42:19",439,"نُفُورًا","(in) aversion","مَّا زَادَهُمْ إِلَّا","",1380],["46:29:4",506,"نَفَرًۭا","a party","وَإِذْ صَرَفْنَآ إِلَيْكَ","مِّنَ ٱلْجِنِّ يَسْتَمِعُونَ",1942],["67:21:12",563,"وَنُفُورٍ","and aversion","لَّجُّوا۟ فِى عُتُوٍّۢ","",1380],["72:1:6",572,"نَفَرٌۭ","a group","إِلَىَّ أَنَّهُ ٱسْتَمَعَ","مِّنَ ٱلْجِنِّ فَقَالُوٓا۟",1942],["74:50:3",577,"مُّسْتَنفِرَةٌۭ","frightened","كَأَنَّهُمْ حُمُرٌۭ","",3993]]