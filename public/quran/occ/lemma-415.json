[["2:26:24",5,"مَاذَآ","what","ٱلَّذِينَ كَفَرُوا۟ فَيَقُولُونَ","أَرَادَ ٱللَّهُ بِهَـٰذَا",415],["2:215:2",33,"مَاذَا","what","يَسْـَٔلُونَكَ","يُنفِقُونَ ۖ قُلْ مَآ",415],["2:219:16",34,"مَاذَا","what","مِن نَّفْعِهِمَا ۗ وَيَسْـَٔلُونَكَ","يُنفِقُونَ قُلِ ٱلْعَفْوَ ۗ",415],["4:39:1",85,"وَمَاذَا","And what","","عَلَيْهِمْ لَوْ ءَامَنُوا۟",415],["5:4:2",107,"مَاذَآ","what","يَسْـَٔلُونَكَ","أُحِلَّ لَهُمْ ۖ قُلْ",415],["5:109:6",126,"مَاذَآ","What","ٱللَّهُ ٱلرُّسُلَ فَيَقُولُ","أُجِبْتُمْ ۖ قَالُوا۟ لَا",415],["7:110:6",164,"فَمَاذَا","so what","يُخْرِجَكُم مِّنْ أَرْضِكُمْ ۖ","تَأْمُرُونَ",415],["10:32:5",212,"فَمَاذَا","So what (can be)","ٱللَّهُ رَبُّكُمُ ٱلْحَقُّ ۖ","بَعْدَ ٱلْحَقِّ إِلَّا",415],["10:50:9",214,"مَّاذَا","what (portion)","بَيَـٰتًا أَوْ نَهَارًۭا","يَسْتَعْجِلُ مِنْهُ ٱلْمُجْرِمُونَ",415],["10:101:3",220,"مَاذَا","what","قُلِ ٱنظُرُوا۟","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ",415],["12:71:4",244,"مَّاذَا","What (is it)","قَالُوا۟ وَأَقْبَلُوا۟ عَلَيْهِم","تَفْقِدُونَ",415],["16:24:4",269,"مَّاذَآ","What","وَإِذَا قِيلَ لَهُم","أَنزَلَ رَبُّكُمْ ۙ قَالُوٓا۟",415],["16:30:4",270,"مَاذَآ","What","۞ وَقِيلَ لِلَّذِينَ ٱتَّقَوْا۟","أَنزَلَ رَبُّكُمْ ۚ قَالُوا۟",415],["26:35:7",368,"فَمَاذَا","so what","مِّنْ أَرْضِكُم بِسِحْرِهِۦ","تَأْمُرُونَ",415],["27:28:10",379,"مَاذَا","what","تَوَلَّ عَنْهُمْ فَٱنظُرْ","يَرْجِعُونَ",415],["27:33:11",379,"مَاذَا","what","وَٱلْأَمْرُ إِلَيْكِ فَٱنظُرِى","تَأْمُرِينَ",415],["28:65:4",393,"مَاذَآ","What","وَيَوْمَ يُنَادِيهِمْ فَيَقُولُ","أَجَبْتُمُ ٱلْمُرْسَلِينَ",415],["31:11:5",411,"مَاذَا","what","خَلْقُ ٱللَّهِ فَأَرُونِى","خَلَقَ ٱلَّذِينَ مِن",415],["31:34:15",414,"مَّاذَا","what","وَمَا تَدْرِى نَفْسٌۭ","تَكْسِبُ غَدًۭا ۖ وَمَا",415],["34:23:15",431,"مَاذَا","What is that","عَن قُلُوبِهِمْ قَالُوا۟","قَالَ رَبُّكُمْ ۖ قَالُوا۟",415],["35:40:10",439,"مَاذَا","what","دُونِ ٱللَّهِ أَرُونِى","خَلَقُوا۟ مِنَ ٱلْأَرْضِ",415],["37:85:5",449,"مَاذَا","What is it","قَالَ لِأَبِيهِ وَقَوْمِهِۦ","تَعْبُدُونَ",415],["37:102:14",449,"مَاذَا","what","أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ","تَرَىٰ ۚ قَالَ يَـٰٓأَبَتِ",415],["46:4:9",502,"مَاذَا","what","دُونِ ٱللَّهِ أَرُونِى","خَلَقُوا۟ مِنَ ٱلْأَرْضِ",415],["47:16:14",508,"مَاذَا","What","لِلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ","قَالَ ءَانِفًا ۚ أُو۟لَـٰٓئِكَ",415],["74:31:34",576,"مَاذَآ","What","قُلُوبِهِم مَّرَضٌۭ وَٱلْكَـٰفِرُونَ","أَرَادَ ٱللَّهُ بِهَـٰذَا",415]]