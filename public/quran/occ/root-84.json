212,"جَمِيعًۭا","all together","وَيَوْمَ نَحْشُرُهُمْ","ثُمَّ نَقُولُ لِلَّذِينَ",224],["10:58:10",215,"يَجْمَعُونَ","they accumulate","هُوَ خَيْرٌۭ مِّمَّا","",467],["10:65:7",216,"جَمِيعًا ۚ","all","إِنَّ ٱلْعِزَّةَ لِلَّهِ","هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",224],["10:71:20",217,"فَأَجْمِعُوٓا۟","So you all resolve","فَعَلَى ٱللَّهِ تَوَكَّلْتُ","أَمْرَكُمْ وَشُرَكَآءَكُمْ ثُمَّ",1466],["10:99:9",220,"جَمِيعًا ۚ","together","فِى ٱلْأَرْضِ كُلُّهُمْ","أَفَأَنتَ تُكْرِهُ ٱلنَّاسَ",224],["11:55:4",228,"جَمِيعًۭا","all together","مِن دُونِهِۦ ۖ فَكِيدُونِى","ثُمَّ لَا تُنظِرُونِ",224],["11:103:11",233,"مَّجْمُوعٌۭ","(will) be gathered","ٱلْـَٔاخِرَةِ ۚ ذَٰلِكَ يَوْمٌۭ","لَّهُ ٱلنَّاسُ وَذَٰلِكَ",2523],["11:119:15",235,"أَجْمَعِينَ","all together","مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","",411],["12:15:4",237,"وَأَجْمَعُوٓا۟","and agreed","فَلَمَّا ذَهَبُوا۟ بِهِۦ","أَن يَجْعَلُوهُ فِى",1466],["12:83:14",245,"جَمِيعًا ۚ","all","أَن يَأْتِيَنِى بِهِمْ","إِنَّهُۥ هُوَ ٱلْعَلِيمُ",224],["12:93:12",246,"أَجْمَعِينَ","all together","بَصِيرًۭا وَأْتُونِى بِأَهْلِكُمْ","",411],["12:102:11",247,"أَجْمَعُوٓا۟","they put together","كُنتَ لَدَيْهِمْ إِذْ","أَمْرَهُمْ وَهُمْ يَمْكُرُونَ",1466],["13:18:15",251,"جَمِيعًۭا","all","مَّا فِى ٱلْأَرْضِ","وَمِثْلَهُۥ مَعَهُۥ لَٱفْتَدَوْا۟",224],["13:31:18",253,"جَمِيعًا ۗ","all","بَل لِّلَّهِ ٱلْأَمْرُ","أَفَلَمْ يَا۟يْـَٔسِ ٱلَّذِينَ",224],["13:31:29",253,"جَمِيعًۭا ۗ","all of the mankind","ٱللَّهُ لَهَدَى ٱلنَّاسَ","وَلَا يَزَالُ ٱلَّذِينَ",224],["13:42:8",254,"جَمِيعًۭا ۖ","all","قَبْلِهِمْ فَلِلَّهِ ٱلْمَكْرُ","يَعْلَمُ مَا تَكْسِبُ",224],["14:8:9",256,"جَمِيعًۭا","all","وَمَن فِى ٱلْأَرْضِ","فَإِنَّ ٱللَّهَ لَغَنِىٌّ",224],["14:21:3",258,"جَمِيعًۭا","all together","وَبَرَزُوا۟ لِلَّهِ","فَقَالَ ٱلضُّعَفَـٰٓؤُا۟ لِلَّذِينَ",224],["15:30:4",263,"أَجْمَعُونَ","together","فَسَجَدَ ٱلْمَلَـٰٓئِكَةُ كُلُّهُمْ","",411],["15:39:10",264,"أَجْمَعِينَ","all","فِى ٱلْأَرْضِ وَلَأُغْوِيَنَّهُمْ","",411],["15:43:4",264,"أَجْمَعِينَ","all","وَإِنَّ جَهَنَّمَ لَمَوْعِدُهُمْ","",411],["15:59:6",265,"أَجْمَعِينَ","all","لُوطٍ إِنَّا لَمُنَجُّوهُمْ","",411],["15:92:3",267,"أَجْمَعِينَ","all","فَوَرَبِّكَ لَنَسْـَٔلَنَّهُمْ","",411],["16:9:10",268,"أَجْمَعِينَ","all","وَلَوْ شَآءَ لَهَدَىٰكُمْ","",411],["17:88:3",291,"ٱجْتَمَعَتِ","gathered","قُل لَّئِنِ","ٱلْإِنسُ وَٱلْجِنُّ عَلَىٰٓ",2835],["17:103:9",292,"جَمِيعًۭا","all","فَأَغْرَقْنَـٰهُ وَمَن مَّعَهُۥ","",224],["18:60:9",300,"مَجْمَعَ","the junction","أَبْرَحُ حَتَّىٰٓ أَبْلُغَ","ٱلْبَحْرَيْنِ أَوْ أَمْضِىَ",2453],["18:61:3",300,"مَجْمَعَ","the junction","فَلَمَّا بَلَغَا","بَيْنِهِمَا نَسِيَا حُوتَهُمَا",2453],["18:99:10",304,"فَجَمَعْنَـٰهُمْ","then We (will) gather them","وَنُفِخَ فِى ٱلصُّورِ","جَمْعًۭا",467],["18:99:11",304,"جَمْعًۭا","all together","فِى ٱلصُّورِ فَجَمَعْنَـٰهُمْ","",688],["20:60:3",315,"فَجَمَعَ","and put together","فَتَوَلَّىٰ فِرْعَوْنُ","كَيْدَهُۥ ثُمَّ أَتَىٰ",467],["20:64:1",315,"فَأَجْمِعُوا۟","So put together","","كَيْدَكُمْ ثُمَّ ٱئْتُوا۟",1466],["20:123:4",320,"جَمِيعًۢا ۖ","all","قَالَ ٱهْبِطَا مِنْهَا","بَعْضُكُمْ لِبَعْضٍ عَدُوٌّۭ ۖ",224],["21:77:12",328,"أَجْمَعِينَ","all","قَوْمَ سَوْءٍۢ فَأَغْرَقْنَـٰهُمْ","",411],["22:73:17",341,"ٱجْتَمَعُوا۟","they gathered together","يَخْلُقُوا۟ ذُبَابًۭا وَلَوِ","لَهُۥ ۖ وَإِن يَسْلُبْهُمُ",2835],["24:31:74",353,"جَمِيعًا","altogether","وَتُوبُوٓا۟ إِلَى ٱللَّهِ","أَيُّهَ ٱلْمُؤْمِنُونَ لَعَلَّكُمْ",224],["24:61:55",358,"جَمِيعًا","together","جُنَاحٌ أَن تَأْكُلُوا۟","أَوْ أَشْتَاتًۭا ۚ فَإِذَا",224],["24:62:12",359,"جَامِعٍۢ","(of) collective action","مَعَهُۥ عَلَىٰٓ أَمْرٍۢ","لَّمْ يَذْهَبُوا۟ حَتَّىٰ",1853],["26:38:1",368,"فَجُمِعَ","So were assembled","","ٱلسَّحَرَةُ لِمِيقَـٰتِ يَوْمٍۢ",467],["26:39:5",368,"مُّجْتَمِعُونَ","assemble","لِلنَّاسِ هَلْ أَنتُم","",3966],["26:49:21",369,"أَجْمَعِينَ","all","مِّنْ خِلَـٰفٍۢ وَلَأُصَلِّبَنَّكُمْ","",411],["26:56:2",369,"لَجَمِيعٌ","(are) surely a multitude","وَإِنَّا","حَـٰذِرُونَ",224],["26:61:3",370,"ٱلْجَمْعَانِ","the two hosts","فَلَمَّا تَرَٰٓء