[["2:29:8",5,"جَمِيعًۭا","all","مَّا فِى ٱلْأَرْضِ","ثُمَّ ٱسْتَوَىٰٓ إِلَى",224],["2:38:4",7,"جَمِيعًۭا ۖ","all (of you)","قُلْنَا ٱهْبِطُوا۟ مِنْهَا","فَإِمَّا يَأْتِيَنَّكُم مِّنِّى",224],["2:148:13",23,"جَمِيعًا ۚ","together","يَأْتِ بِكُمُ ٱللَّهُ","إِنَّ ٱللَّهَ عَلَىٰ",224],["2:161:13",24,"أَجْمَعِينَ","all together","ٱللَّهِ وَٱلْمَلَـٰٓئِكَةِ وَٱلنَّاسِ","",411],["2:165:27",25,"جَمِيعًۭا","all","أَنَّ ٱلْقُوَّةَ لِلَّهِ","وَأَنَّ ٱللَّهَ شَدِيدُ",224],["3:9:3",50,"جَامِعُ","will gather","رَبَّنَآ إِنَّكَ","ٱلنَّاسِ لِيَوْمٍۢ لَّا",1853],["3:25:3",53,"جَمَعْنَـٰهُمْ","We will gather them","فَكَيْفَ إِذَا","لِيَوْمٍۢ لَّا رَيْبَ",467],["3:87:9",61,"أَجْمَعِينَ","all together","ٱللَّهِ وَٱلْمَلَـٰٓئِكَةِ وَٱلنَّاسِ","",411],["3:103:4",63,"جَمِيعًۭا","all together","وَٱعْتَصِمُوا۟ بِحَبْلِ ٱللَّهِ","وَلَا تَفَرَّقُوا۟ ۚ وَٱذْكُرُوا۟",224],["3:155:7",70,"ٱلْجَمْعَانِ","the two hosts","مِنكُمْ يَوْمَ ٱلْتَقَى","إِنَّمَا ٱسْتَزَلَّهُمُ ٱلشَّيْطَـٰنُ",688],["3:157:14",70,"يَجْمَعُونَ","they accumulate","وَرَحْمَةٌ خَيْرٌۭ مِّمَّا","",467],["3:166:5",72,"ٱلْجَمْعَانِ","the two hosts","أَصَـٰبَكُمْ يَوْمَ ٱلْتَقَى","فَبِإِذْنِ ٱللَّهِ وَلِيَعْلَمَ",688],["3:173:8",72,"جَمَعُوا۟","gathered","إِنَّ ٱلنَّاسَ قَدْ","لَكُمْ فَٱخْشَوْهُمْ فَزَادَهُمْ",467],["4:23:43",81,"تَجْمَعُوا۟","you gather together","مِنْ أَصْلَـٰبِكُمْ وَأَن","بَيْنَ ٱلْأُخْتَيْنِ إِلَّا",467],["4:71:10",89,"جَمِيعًۭا","all together","ثُبَاتٍ أَوِ ٱنفِرُوا۟","",224],["4:87:6",92,"لَيَجْمَعَنَّكُمْ","surely He will gather you","إِلَـٰهَ إِلَّا هُوَ ۚ","إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ",467],["4:139:14",100,"جَمِيعًۭا","all","فَإِنَّ ٱلْعِزَّةَ لِلَّهِ","",224],["4:140:28",100,"جَامِعُ","will gather","مِّثْلُهُمْ ۗ إِنَّ ٱللَّهَ","ٱلْمُنَـٰفِقِينَ وَٱلْكَـٰفِرِينَ فِى",1853],["4:140:33",100,"جَمِيعًا","all together","وَٱلْكَـٰفِرِينَ فِى جَهَنَّمَ","",224],["4:172:18",105,"جَمِيعًۭا","all together","وَيَسْتَكْبِرْ فَسَيَحْشُرُهُمْ إِلَيْهِ","",224],["5:17:28",110,"جَمِيعًۭا ۗ","all","وَمَن فِى ٱلْأَرْضِ",