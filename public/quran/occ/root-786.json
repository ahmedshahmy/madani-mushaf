[["7:143:25",167,"تَجَلَّىٰ","revealed (His) Glory","فَسَوْفَ تَرَىٰنِى ۚ فَلَمَّا","رَبُّهُۥ لِلْجَبَلِ جَعَلَهُۥ",2671],["7:187:12",174,"يُجَلِّيهَا","can reveal [it]","عِندَ رَبِّى ۖ لَا","لِوَقْتِهَآ إِلَّا هُوَ ۚ",2400],["59:3:6",545,"ٱلْجَلَآءَ","the exile","كَتَبَ ٱللَّهُ عَلَيْهِمُ","لَعَذَّبَهُمْ فِى ٱلدُّنْيَا ۖ",3518],["91:3:3",595,"جَلَّىٰهَا","it displays it","وَٱلنَّهَارِ إِذَا","",2400],["92:2:3",595,"تَجَلَّىٰ","it shines in brightness","وَٱلنَّهَارِ إِذَا","",2671]]