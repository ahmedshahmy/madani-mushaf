[["2:87:12",13,"مَرْيَمَ","(of) Maryam","وَءَاتَيْنَا عِيسَى ٱبْنَ","ٱلْبَيِّنَـٰتِ وَأَيَّدْنَـٰهُ بِرُوحِ",340],["2:253:17",42,"مَرْيَمَ","(of) Maryam","وَءَاتَيْنَا عِيسَى ٱبْنَ","ٱلْبَيِّنَـٰتِ وَأَيَّدْنَـٰهُ بِرُوحِ",340],["3:36:17",54,"مَرْيَمَ","Maryam","كَٱلْأُنثَىٰ ۖ وَإِنِّى سَمَّيْتُهَا","وَإِنِّىٓ أُعِيذُهَا بِكَ",340],["3:37:19",54,"يَـٰمَرْيَمُ","O Maryam","عِندَهَا رِزْقًۭا ۖ قَالَ","أَنَّىٰ لَكِ هَـٰذَا ۖ",340],["3:42:4",55,"يَـٰمَرْيَمُ","O Maryam","وَإِذْ قَالَتِ ٱلْمَلَـٰٓئِكَةُ","إِنَّ ٱللَّهَ ٱصْطَفَىٰكِ",340],["3:43:1",55,"يَـٰمَرْيَمُ","O Maryam","","ٱقْنُتِى لِرَبِّكِ وَٱسْجُدِى",340],["3:44:15",55,"مَرْيَمَ","Maryam","أَقْلَـٰمَهُمْ أَيُّهُمْ يَكْفُلُ","وَمَا كُنتَ لَدَيْهِمْ",340],["3:45:4",55,"يَـٰمَرْيَمُ","O Maryam","إِذْ قَالَتِ ٱلْمَلَـٰٓئِكَةُ","إِنَّ ٱللَّهَ يُبَشِّرُكِ",340],["3:45:14",55,"مَرْيَمَ","(of) Maryam","ٱلْمَسِيحُ عِيسَى ٱبْنُ","وَجِيهًۭا فِى ٱلدُّنْيَا",340],["4:156:4",103,"مَرْيَمَ","Maryam","وَبِكُفْرِهِمْ وَقَوْلِهِمْ عَلَىٰ","بُهْتَـٰنًا عَظِيمًۭا",340],["4:157:7",103,"مَرْيَمَ","(of) Maryam","ٱلْمَسِيحَ عِيسَى ٱبْنَ","رَسُولَ ٱللَّهِ وَمَا",340],["4:171:17",105,"مَرْيَمَ","(of) Maryam","ٱلْمَسِيحُ عِيسَى ٱبْنُ","رَسُولُ ٱللَّهِ وَكَلِمَتُهُۥٓ",340],["4:171:23",105,"مَرْيَمَ","Maryam","وَكَلِمَتُهُۥٓ أَلْقَىٰهَآ إِلَىٰ","وَرُوحٌۭ مِّنْهُ ۖ فَـَٔامِنُوا۟",340],["5:17:10",110,"مَرْيَمَ ۚ","(of) Maryam","هُوَ ٱلْمَسِيحُ ٱبْنُ","قُلْ فَمَن يَمْلِكُ",340],["5:17:23",110,"مَرْيَمَ","(of) Maryam","يُهْلِكَ ٱلْمَسِيحَ ٱبْنَ","وَأُمَّهُۥ وَمَن فِى",340],["5:46:6",116,"مَرْيَمَ","(of) Maryam","ءَاثَـٰرِهِم بِعِيسَى ٱبْنِ","مُصَدِّقًۭا لِّمَا بَيْنَ",340],["5:72:10",120,"مَرْيَمَ ۖ","(of) Maryam","هُوَ ٱلْمَسِيحُ ٱبْنُ","وَقَالَ ٱلْمَسِيحُ يَـٰبَنِىٓ",340],["5:75:4",120,"مَرْيَمَ","(of) Maryam","مَّا ٱلْمَسِيحُ ٱبْنُ","إِلَّا رَسُولٌۭ قَدْ",340],["5:78:12",121,"مَرْيَمَ ۚ","(of) Maryam","دَاوُۥدَ وَعِيسَى ٱبْنِ","ذَٰلِكَ بِمَا عَصَوا۟",340],["5:110:6",126,"مَرْيَمَ","(of) Maryam","ٱللَّهُ يَـٰعِيسَى ٱبْنَ","ٱذْكُرْ نِعْمَتِى 