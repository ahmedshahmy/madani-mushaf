[["4:102:48",95,"مَّطَرٍ","rain","بِكُمْ أَذًۭى مِّن","أَوْ كُنتُم مَّرْضَىٰٓ",1089],["7:84:1",161,"وَأَمْطَرْنَا","And We showered","","عَلَيْهِم مَّطَرًۭا ۖ فَٱنظُرْ",1042],["7:84:3",161,"مَّطَرًۭا ۖ","a rain","وَأَمْطَرْنَا عَلَيْهِم","فَٱنظُرْ كَيْفَ كَانَ",1089],["8:32:11",180,"فَأَمْطِرْ","then (send) rain","ٱلْحَقَّ مِنْ عِندِكَ","عَلَيْنَا حِجَارَةًۭ مِّنَ",1042],["11:82:7",231,"وَأَمْطَرْنَا","and We rained","جَعَلْنَا عَـٰلِيَهَا سَافِلَهَا","عَلَيْهَا حِجَارَةًۭ مِّن",1042],["15:74:4",266,"وَأَمْطَرْنَا","and We rained","فَجَعَلْنَا عَـٰلِيَهَا سَافِلَهَا","عَلَيْهِمْ حِجَارَةًۭ مِّن",1042],["25:40:6",363,"أُمْطِرَتْ","was showered","عَلَى ٱلْقَرْيَةِ ٱلَّتِىٓ","مَطَرَ ٱلسَّوْءِ ۚ أَفَلَمْ",1042],["25:40:7",363,"مَطَرَ","(with) a rain","ٱلْقَرْيَةِ ٱلَّتِىٓ أُمْطِرَتْ","ٱلسَّوْءِ ۚ أَفَلَمْ يَكُونُوا۟",1089],["26:173:1",374,"وَأَمْطَرْنَا","And We rained","","عَلَيْهِم مَّطَرًۭا ۖ فَسَآءَ",1042],["26:173:3",374,"مَّطَرًۭا ۖ","a rain","وَأَمْطَرْنَا عَلَيْهِم","فَسَآءَ مَطَرُ ٱلْمُنذَرِينَ",1089],["26:173:5",374,"مَطَرُ","(was) the rain","عَلَيْهِم مَّطَرًۭا ۖ فَسَآءَ","ٱلْمُنذَرِينَ",1089],["27:58:1",382,"وَأَمْطَرْنَا","And We rained","","عَلَيْهِم مَّطَرًۭا ۖ فَسَآءَ",1042],["27:58:3",382,"مَّطَرًۭا ۖ","a rain","وَأَمْطَرْنَا عَلَيْهِم","فَسَآءَ مَطَرُ ٱلْمُنذَرِينَ",1089],["27:58:5",382,"مَطَرُ","(the) rain","عَلَيْهِم مَّطَرًۭا ۖ فَسَآءَ","ٱلْمُنذَرِينَ",1089],["46:24:9",505,"مُّمْطِرُنَا ۚ","bringing us rain","قَالُوا۟ هَـٰذَا عَارِضٌۭ","بَلْ هُوَ مَا",3971]]