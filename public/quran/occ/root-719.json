[["5:4:13",107,"مُكَلِّبِينَ","ones who train animals to hunt","عَلَّمْتُم مِّنَ ٱلْجَوَارِحِ","تُعَلِّمُونَهُنَّ مِمَّا عَلَّمَكُمُ",3811],["7:176:13",173,"ٱلْكَلْبِ","(of) the dog","هَوَىٰهُ ۚ فَمَثَلُهُۥ كَمَثَلِ","إِن تَحْمِلْ عَلَيْهِ",1348],["18:18:10",295,"وَكَلْبُهُم","while their dog","ٱلْيَمِينِ وَذَاتَ ٱلشِّمَالِ ۖ","بَـٰسِطٌۭ ذِرَاعَيْهِ بِٱلْوَصِيدِ ۚ",1348],["18:22:4",296,"كَلْبُهُمْ","their dog","سَيَقُولُونَ ثَلَـٰثَةٌۭ رَّابِعُهُمْ","وَيَقُولُونَ خَمْسَةٌۭ سَادِسُهُمْ",1348],["18:22:8",296,"كَلْبُهُمْ","their dog","وَيَقُولُونَ خَمْسَةٌۭ سَادِسُهُمْ","رَجْمًۢا بِٱلْغَيْبِ ۖ وَيَقُولُونَ",1348],["18:22:14",296,"كَلْبُهُمْ ۚ","their dog","وَيَقُولُونَ سَبْعَةٌۭ وَثَامِنُهُمْ","قُل رَّبِّىٓ أَعْلَمُ",1348]]