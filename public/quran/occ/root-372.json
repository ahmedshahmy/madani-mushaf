[["2:221:2",35,"تَنكِحُوا۟","[you] marry","وَلَا","ٱلْمُشْرِكَـٰتِ حَتَّىٰ يُؤْمِنَّ ۚ",671],["2:221:14",35,"تُنكِحُوا۟","give in marriage (your women)","وَلَوْ أَعْجَبَتْكُمْ ۗ وَلَا","ٱلْمُشْرِكِينَ حَتَّىٰ يُؤْمِنُوا۟ ۚ",2017],["2:230:9",36,"تَنكِحَ","she marries","مِنۢ بَعْدُ حَتَّىٰ","زَوْجًا غَيْرَهُۥ ۗ فَإِن",671],["2:232:9",37,"يَنكِحْنَ","(from) marrying","فَلَا تَعْضُلُوهُنَّ أَن","أَزْوَٰجَهُنَّ إِذَا تَرَٰضَوْا۟",671],["2:235:30",38,"ٱلنِّكَاحِ","(of) marriage","وَلَا تَعْزِمُوا۟ عُقْدَةَ","حَتَّىٰ يَبْلُغَ ٱلْكِتَـٰبُ",1378],["2:237:22",38,"ٱلنِّكَاحِ ۚ","(of) the marriage","ٱلَّذِى بِيَدِهِۦ عُقْدَةُ","وَأَن تَعْفُوٓا۟ أَقْرَبُ",1378],["4:3:7",77,"فَٱنكِحُوا۟","then marry","تُقْسِطُوا۟ فِى ٱلْيَتَـٰمَىٰ","مَا طَابَ لَكُم",671],["4:6:6",77,"ٱلنِّكَاحَ","(the age of) marriage","حَتَّىٰٓ إِذَا بَلَغُوا۟","فَإِنْ ءَانَسْتُم مِّنْهُمْ",1378],["4:22:2",81,"تَنكِحُوا۟","marry","وَلَا","مَا نَكَحَ ءَابَآؤُكُم",671],["4:22:4",81,"نَكَحَ","married","وَلَا تَنكِحُوا۟ مَا","ءَابَآؤُكُم مِّنَ ٱلنِّسَآءِ",671],["4:25:7",82,"يَنكِحَ","marry","مِنكُمْ طَوْلًا أَن","ٱلْمُحْصَنَـٰتِ ٱلْمُؤْمِنَـٰتِ فَمِن",671],["4:25:23",82,"فَٱنكِحُوهُنَّ","So marry them","بَعْضُكُم مِّنۢ بَعْضٍۢ ۚ","بِإِذْنِ أَهْلِهِنَّ وَءَاتُوهُنَّ",671],["4:127:24",98,"تَنكِحُوهُنَّ","marry them","لَهُنَّ وَتَرْغَبُونَ أَن","وَٱلْمُسْتَضْعَفِينَ مِنَ ٱلْوِلْدَٰنِ",671],["24:3:3",350,"يَنكِحُ","marry","ٱلزَّانِى لَا","إِلَّا زَانِيَةً أَوْ",671],["24:3:10",350,"يَنكِحُهَآ","marry her","مُشْرِكَةًۭ وَٱلزَّانِيَةُ لَا","إِلَّا زَانٍ أَوْ",671],["24:32:1",354,"وَأَنكِحُوا۟","And marry","","ٱلْأَيَـٰمَىٰ مِنكُمْ وَٱلصَّـٰلِحِينَ",2017],["24:33:5",354,"نِكَاحًا","(means for) marriage","ٱلَّذِينَ لَا يَجِدُونَ","حَتَّىٰ يُغْنِيَهُمُ ٱللَّهُ",1378],["24:60:7",358,"نِكَاحًۭا","(for) marriage","ٱلَّـٰتِى لَا يَرْجُونَ","فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ",1378],["28:27:5",388,"أُنكِحَكَ","marry you to","إِنِّىٓ أُرِيدُ أَنْ","إِحْدَى ٱبْنَتَىَّ هَـٰتَيْنِ",2017],["33:49:5",424,"نَكَحْتُمُ","you marry","ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا","ٱلْمُؤْمِنَـٰتِ ثُمَّ طَلَّقْتُمُوهُنَّ",671],["33:50:38",424,"يَسْتَنكِحَهَا","marry her","أَرَادَ ٱلنَّبِىُّ أَن","خَالِصَةًۭ لَّكَ مِن",4664],["33:53:59",425,"تَنكِحُوٓا۟","you should marry","ٱللَّهِ وَلَآ أَن","أَزْوَٰجَهُۥ مِنۢ بَعْدِهِۦٓ",671],["60:10:34",550,"تَنكِحُوهُنَّ","you marry them","جُنَاحَ عَلَيْكُمْ أَن","إِذَآ ءَاتَيْتُمُوهُنَّ أُجُورَهُنَّ ۚ",671]]