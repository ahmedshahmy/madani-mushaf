[["3:179:23",73,"يَجْتَبِى","chooses","ٱلْغَيْبِ وَلَـٰكِنَّ ٱللَّهَ","مِن رُّسُلِهِۦ مَن",868],["6:87:5",138,"وَٱجْتَبَيْنَـٰهُمْ","and We chose them","ءَابَآئِهِمْ وَذُرِّيَّـٰتِهِمْ وَإِخْوَٰنِهِمْ ۖ","وَهَدَيْنَـٰهُمْ إِلَىٰ صِرَٰطٍۢ",868],["7:203:7",176,"ٱجْتَبَيْتَهَا ۚ","you devised it","بِـَٔايَةٍۢ قَالُوا۟ لَوْلَا","قُلْ إِنَّمَآ أَتَّبِعُ",868],["12:6:2",236,"يَجْتَبِيكَ","will choose you","وَكَذَٰلِكَ","رَبُّكَ وَيُعَلِّمُكَ مِن",868],["16:121:3",281,"ٱجْتَبَىٰهُ","He chose him","شَاكِرًۭا لِّأَنْعُمِهِ ۚ","وَهَدَىٰهُ إِلَىٰ صِرَٰطٍۢ",868],["19:58:21",309,"وَٱجْتَبَيْنَآ ۚ","and We chose","وَإِسْرَٰٓءِيلَ وَمِمَّنْ هَدَيْنَا","إِذَا تُتْلَىٰ عَلَيْهِمْ",868],["20:122:2",320,"ٱجْتَبَـٰهُ","chose him","ثُمَّ","رَبُّهُۥ فَتَابَ عَلَيْهِ",868],["22:78:7",341,"ٱجْتَبَىٰكُمْ","(has) chosen you","حَقَّ جِهَادِهِۦ ۚ هُوَ","وَمَا جَعَلَ عَلَيْكُمْ",868],["28:57:14",392,"يُجْبَىٰٓ","are brought","لَّهُمْ حَرَمًا ءَامِنًۭا","إِلَيْهِ ثَمَرَٰتُ كُلِّ",4724],["34:13:9",429,"كَٱلْجَوَابِ","like reservoirs","مَّحَـٰرِيبَ وَتَمَـٰثِيلَ وَجِفَانٍۢ","وَقُدُورٍۢ رَّاسِيَـٰتٍ ۚ ٱعْمَلُوٓا۟",3528],["42:13:31",484,"يَجْتَبِىٓ","chooses","تَدْعُوهُمْ إِلَيْهِ ۚ ٱللَّهُ","إِلَيْهِ مَن يَشَآءُ",868],["68:50:1",566,"فَٱجْتَبَـٰهُ","But chose him","","رَبُّهُۥ فَجَعَلَهُۥ مِنَ",868]]