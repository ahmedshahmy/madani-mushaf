[["2:132:1",20,"وَوَصَّىٰ","And enjoined","","بِهَآ إِبْرَٰهِـۧمُ بَنِيهِ",804],["2:180:10",27,"ٱلْوَصِيَّةُ","(making) the will","إِن تَرَكَ خَيْرًا","لِلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَ بِٱلْمَعْرُوفِ ۖ",1006],["2:182:4",28,"مُّوصٍۢ","(the) testator","فَمَنْ خَافَ مِن","جَنَفًا أَوْ إِثْمًۭا",4002],["2:240:6",39,"وَصِيَّةًۭ","(should make) a will","مِنكُمْ وَيَذَرُونَ أَزْوَٰجًۭا","لِّأَزْوَٰجِهِم مَّتَـٰعًا إِلَى",1006],["4:11:1",78,"يُوصِيكُمُ","Instructs you","","ٱللَّهُ فِىٓ أَوْلَـٰدِكُمْ ۖ",1284],["4:11:51",78,"وَصِيَّةٍۢ","any will","ٱلسُّدُسُ ۚ مِنۢ بَعْدِ","يُوصِى بِهَآ أَوْ",1006],["4:11:52",78,"يُوصِى","he has made","مِنۢ بَعْدِ وَصِيَّةٍۢ","بِهَآ أَوْ دَيْنٍ ۗ",1284],["4:12:21",79,"وَصِيَّةٍۢ","any will","تَرَكْنَ ۚ مِنۢ بَعْدِ","يُوصِينَ بِهَآ أَوْ",1006],["4:12:22",79,"يُوصِينَ","they have made","مِنۢ بَعْدِ وَصِيَّةٍۢ","بِهَآ أَوْ دَيْنٍۢ ۚ",4737],["4:12:45",79,"وَصِيَّةٍۢ","any will","تَرَكْتُم ۚ مِّنۢ بَعْدِ","تُوصُونَ بِهَآ أَوْ",1006],["4:12:46",79,"تُوصُونَ","you have made","مِّنۢ بَعْدِ وَصِيَّةٍۢ","بِهَآ أَوْ دَيْنٍۢ ۗ",1284],["4:12:76",79,"وَصِيَّةٍۢ","any will","ٱلثُّلُثِ ۚ مِنۢ بَعْدِ","يُوصَىٰ بِهَآ أَوْ",1006],["4:12:77",79,"يُوصَىٰ","was made","مِنۢ بَعْدِ وَصِيَّةٍۢ","بِهَآ أَوْ دَيْنٍ",1284],["4:12:83",79,"وَصِيَّةًۭ","An ordinance","دَيْنٍ غَيْرَ مُضَآرٍّۢ ۚ","مِّنَ ٱللَّهِ ۗ وَٱللَّهُ",1006],["4:131:9",99,"وَصَّيْنَا","We have instructed","فِى ٱلْأَرْضِ ۗ وَلَقَدْ","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ",804],["5:106:11",125,"ٱلْوَصِيَّةِ","[the] a will","أَحَدَكُمُ ٱلْمَوْتُ حِينَ","ٱثْنَانِ ذَوَا عَدْلٍۢ",1006],["6:144:21",147,"وَصَّىٰكُمُ","enjoined you","كُنتُمْ شُهَدَآءَ إِذْ","ٱللَّهُ بِهَـٰذَا ۚ فَمَنْ",804],["6:151:39",148,"وَصَّىٰكُم","(He) has enjoined on you","إِلَّا بِٱلْحَقِّ ۚ ذَٰلِكُمْ","بِهِۦ لَعَلَّكُمْ تَعْقِلُونَ",804],["6:152:32",149,"وَصَّىٰكُم","(He) has enjoined on you","ٱللَّهِ أَوْفُوا۟ ۚ ذَٰلِكُمْ","بِهِۦ لَعَلَّكُمْ تَذَكَّرُونَ",804],["6:153:14",149,"وَصَّىٰكُم","(He) has enjoined on you","عَن سَبِيلِهِۦ ۚ ذَٰلِكُمْ","بِهِۦ لَعَلَّكُمْ تَتَّقُونَ",804],["19:31:6",307,"وَأَوْصَـٰنِى","and has enjoined (on) me","أَيْنَ مَا كُنتُ","بِٱلصَّلَوٰةِ وَٱلزَّكَوٰةِ مَا",1284],["29:8:1",397,"وَوَصَّيْنَا","And We have enjoined","","ٱلْإِنسَـٰنَ بِوَٰلِدَيْهِ حُسْنًۭا ۖ",804],["31:14:1",412,"وَوَصَّيْنَا","And We have enjoined","","ٱلْإِنسَـٰنَ بِوَٰلِدَيْهِ حَمَلَتْهُ",804],["36:50:3",443,"تَوْصِيَةًۭ","(to) make a will","فَلَا يَسْتَطِيعُونَ","وَلَآ إِلَىٰٓ أَهْلِهِمْ",4432],["42:13:6",484,"وَصَّىٰ","He enjoined","مِّنَ ٱلدِّينِ مَا","بِهِۦ نُوحًۭا وَٱلَّذِىٓ",804],["42:13:13",484,"وَصَّيْنَا","We enjoined","أَوْحَيْنَآ إِلَيْكَ وَمَا","بِهِۦٓ إِبْرَٰهِيمَ وَمُوسَىٰ",804],["46:15:1",504,"وَوَصَّيْنَا","And We have enjoined","","ٱلْإِنسَـٰنَ بِوَٰلِدَيْهِ إِحْسَـٰنًا ۖ",804],["51:53:1",523,"أَتَوَاصَوْا۟","Have they transmitted it to them","","بِهِۦ ۚ بَلْ هُمْ",1405],["90:17:6",594,"وَتَوَاصَوْا۟","and enjoin (each other)","مِنَ ٱلَّذِينَ ءَامَنُوا۟","بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",1405],["90:17:8",594,"وَتَوَاصَوْا۟","and enjoin (each other)","ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","بِٱلْمَرْحَمَةِ",1405],["103:3:6",601,"وَتَوَاصَوْا۟","and enjoin (each other)","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ",1405],["103:3:8",601,"وَتَوَاصَوْا۟","and enjoin (each other)","ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ","بِٱلصَّبْرِ",1405]]