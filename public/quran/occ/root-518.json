[["3:49:15",56,"ٱلطِّينِ","[the] clay","أَخْلُقُ لَكُم مِّنَ","كَهَيْـَٔةِ ٱلطَّيْرِ فَأَنفُخُ",725],["5:110:30",126,"ٱلطِّينِ","the clay","وَإِذْ تَخْلُقُ مِنَ","كَهَيْـَٔةِ ٱلطَّيْرِ بِإِذْنِى",725],["6:2:5",128,"طِينٍۢ","clay","ٱلَّذِى خَلَقَكُم مِّن","ثُمَّ قَضَىٰٓ أَجَلًۭا ۖ",725],["7:12:17",152,"طِينٍۢ","clay","نَّارٍۢ وَخَلَقْتَهُۥ مِن","",725],["17:61:13",288,"طِينًۭا","(from) clay","ءَأَسْجُدُ لِمَنْ خَلَقْتَ","",725],["23:12:7",342,"طِينٍۢ","clay","مِن سُلَـٰلَةٍۢ مِّن","",725],["28:38:15",390,"ٱلطِّينِ","the clay","لِى يَـٰهَـٰمَـٰنُ عَلَى","فَٱجْعَل لِّى صَرْحًۭا",725],["32:7:10",415,"طِينٍۢ","clay","خَلْقَ ٱلْإِنسَـٰنِ مِن","",725],["37:11:11",446,"طِينٍۢ","a clay","إِنَّا خَلَقْنَـٰهُم مِّن","لَّازِبٍۭ",725],["38:71:9",457,"طِينٍۢ","clay","خَـٰلِقٌۢ بَشَرًۭا مِّن","",725],["38:76:10",457,"طِينٍۢ","clay","نَّارٍۢ وَخَلَقْتَهُۥ مِن","",725],["51:33:5",522,"طِينٍۢ","clay","عَلَيْهِمْ حِجَارَةًۭ مِّن","",725]]