[["6:64:7",135,"كَرْبٍۢ","distress","مِّنْهَا وَمِن كُلِّ","ثُمَّ أَنتُمْ تُشْرِكُونَ",1569],["21:76:11",328,"ٱلْكَرْبِ","the affliction","فَنَجَّيْنَـٰهُ وَأَهْلَهُۥ مِنَ","ٱلْعَظِيمِ",1569],["37:76:4",448,"ٱلْكَرْبِ","the distress","وَنَجَّيْنَـٰهُ وَأَهْلَهُۥ مِنَ","ٱلْعَظِيمِ",1569],["37:115:4",450,"ٱلْكَرْبِ","the distress","وَنَجَّيْنَـٰهُمَا وَقَوْمَهُمَا مِنَ","ٱلْعَظِيمِ",1569]]