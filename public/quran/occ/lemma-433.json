[["1:5:1",1,"إِيَّاكَ","You Alone","","نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",433],["1:5:3",1,"وَإِيَّاكَ","and You Alone","إِيَّاكَ نَعْبُدُ","نَسْتَعِينُ",433],["2:40:12",7,"وَإِيَّـٰىَ","and Me Alone","بِعَهْدِىٓ أُوفِ بِعَهْدِكُمْ","فَٱرْهَبُونِ",433],["2:41:17",7,"وَإِيَّـٰىَ","and Me Alone","بِـَٔايَـٰتِى ثَمَنًۭا قَلِيلًۭا","فَٱتَّقُونِ",433],["2:172:13",26,"إِيَّاهُ","alone","لِلَّهِ إِن كُنتُمْ","تَعْبُدُونَ",433],["4:131:15",99,"وَإِيَّاكُمْ","and yourselves","ٱلْكِتَـٰبَ مِن قَبْلِكُمْ","أَنِ ٱتَّقُوا۟ ٱللَّهَ ۚ",433],["6:41:2",132,"إِيَّاهُ","Him Alone","بَلْ","تَدْعُونَ فَيَكْشِفُ مَا",433],["6:151:21",148,"وَإِيَّاهُمْ ۖ","and for them","إِمْلَـٰقٍۢ ۖ نَّحْنُ نَرْزُقُكُمْ","وَلَا تَقْرَبُوا۟ ٱلْفَوَٰحِشَ",433],["7:155:17",169,"وَإِيَّـٰىَ ۖ","and me","أَهْلَكْتَهُم مِّن قَبْلُ","أَتُهْلِكُنَا بِمَا فَعَلَ",433],["9:114:10",205,"إِيَّاهُ","(to) him","عَن مَّوْعِدَةٍۢ وَعَدَهَآ","فَلَمَّا تَبَيَّنَ لَهُۥٓ",433],["10:28:17",212,"إِيَّانَا","worship us","شُرَكَآؤُهُم مَّا كُنتُمْ","تَعْبُدُونَ",433],["12:40:24",240,"إِيَّاهُ ۚ","Him Alone","أَلَّا تَعْبُدُوٓا۟ إِلَّآ","ذَٰلِكَ ٱلدِّينُ ٱلْقَيِّمُ",433],["16:51:11",272,"فَإِيَّـٰىَ","so Me Alone","هُوَ إِلَـٰهٌۭ وَٰحِدٌۭ ۖ","فَٱرْهَبُونِ",433],["16:114:12",280,"إِيَّاهُ","Him Alone","ٱللَّهِ إِن كُنتُمْ","تَعْبُدُونَ",433],["17:23:6",284,"إِيَّاهُ","Him Alone","أَلَّا تَعْبُدُوٓا۟ إِلَّآ","وَبِٱلْوَٰلِدَيْنِ إِحْسَـٰنًا ۚ إِمَّا",433],["17:31:8",285,"وَإِيَّاكُمْ ۚ","and for you","إِمْلَـٰقٍۢ ۖ نَّحْنُ نَرْزُقُهُمْ","إِنَّ قَتْلَهُمْ كَانَ",433],["17:67:10",289,"إِيَّاهُ ۖ","Him Alone","مَن تَدْعُونَ إِلَّآ","فَلَمَّا نَجَّىٰكُمْ إِلَى",433],["28:63:17",393,"إِيَّانَا","worship us","إِلَيْكَ ۖ مَا كَانُوٓا۟","يَعْبُدُونَ",433],["29:56:7",403,"فَإِيَّـٰىَ","so only","إِنَّ أَرْضِى وَٰسِعَةٌۭ","فَٱعْبُدُونِ",433],["29:60:9",403,"وَإِيَّاكُمْ ۚ","and (for) you","رِزْقَهَا ٱللَّهُ يَرْزُقُهَا","وَهُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",433],["34:24:11",431,"إِيَّاكُمْ","you","ٱللَّهُ ۖ وَإِنَّآ أَوْ","لَعَلَىٰ هُدًى أَوْ",433],["34:40:8",433,"إِيَّاكُمْ","Were these you","يَقُولُ لِلْمَلَـٰٓئِكَةِ أَهَـٰٓؤُلَآءِ","كَانُوا۟ يَعْبُدُونَ",433],["41:37:18",480,"إِيَّاهُ","Him alone","خَلَقَهُنَّ إِن كُنتُمْ","تَعْبُدُونَ",433],["60:1:20",549,"وَإِيَّاكُمْ ۙ","and yourselves","ٱلْحَقِّ يُخْرِجُونَ ٱلرَّسُولَ","أَن تُؤْمِنُوا۟ بِٱللَّهِ",433]]