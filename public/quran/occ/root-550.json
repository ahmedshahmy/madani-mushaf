[["2:63:6",10,"ٱلطُّورَ","the mount","مِيثَـٰقَكُمْ وَرَفَعْنَا فَوْقَكُمُ","خُذُوا۟ مَآ ءَاتَيْنَـٰكُم",829],["2:93:6",14,"ٱلطُّورَ","the mount","مِيثَـٰقَكُمْ وَرَفَعْنَا فَوْقَكُمُ","خُذُوا۟ مَآ ءَاتَيْنَـٰكُم",829],["4:154:3",102,"ٱلطُّورَ","the mount","وَرَفَعْنَا فَوْقَهُمُ","بِمِيثَـٰقِهِمْ وَقُلْنَا لَهُمُ",829],["19:52:4",309,"ٱلطُّورِ","(of) the Mount","وَنَـٰدَيْنَـٰهُ مِن جَانِبِ","ٱلْأَيْمَنِ وَقَرَّبْنَـٰهُ نَجِيًّۭا",829],["20:80:9",317,"ٱلطُّورِ","(of) the Mount","عَدُوِّكُمْ وَوَٰعَدْنَـٰكُمْ جَانِبَ","ٱلْأَيْمَنَ وَنَزَّلْنَا عَلَيْكُمُ",829],["23:20:4",343,"طُورِ","Mount Sinai","وَشَجَرَةًۭ تَخْرُجُ مِن","سَيْنَآءَ تَنۢبُتُ بِٱلدُّهْنِ",829],["28:29:10",389,"ٱلطُّورِ","(of) Mount Tur","ءَانَسَ مِن جَانِبِ","نَارًۭا قَالَ لِأَهْلِهِ",829],["28:46:4",391,"ٱلطُّورِ","(of) the Tur","وَمَا كُنتَ بِجَانِبِ","إِذْ نَادَيْنَا وَلَـٰكِن",829],["52:1:1",523,"وَٱلطُّورِ","By the Mount","","",829],["71:14:3",571,"أَطْوَارًا","(in) stages","وَقَدْ خَلَقَكُمْ","",2970],["95:2:1",597,"وَطُورِ","And (the) Mount","","سِينِينَ",829]]