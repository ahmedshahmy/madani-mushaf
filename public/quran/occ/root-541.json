[["2:87:14",13,"وَأَيَّدْنَـٰهُ","and We supported him","ٱبْنَ مَرْيَمَ ٱلْبَيِّنَـٰتِ","بِرُوحِ ٱلْقُدُسِ ۗ أَفَكُلَّمَا",879],["2:253:19",42,"وَأَيَّدْنَـٰهُ","and We supported him","ٱبْنَ مَرْيَمَ ٱلْبَيِّنَـٰتِ","بِرُوحِ ٱلْقُدُسِ ۗ وَلَوْ",879],["3:13:20",51,"يُؤَيِّدُ","supports","رَأْىَ ٱلْعَيْنِ ۚ وَٱللَّهُ","بِنَصْرِهِۦ مَن يَشَآءُ ۗ",879],["5:110:13",126,"أَيَّدتُّكَ","I strengthened you","وَعَلَىٰ وَٰلِدَتِكَ إِذْ","بِرُوحِ ٱلْقُدُسِ تُكَلِّمُ",879],["8:26:13",180,"وَأَيَّدَكُم","and strengthened you","يَتَخَطَّفَكُمُ ٱلنَّاسُ فَـَٔاوَىٰكُمْ","بِنَصْرِهِۦ وَرَزَقَكُم مِّنَ",879],["8:62:10",185,"أَيَّدَكَ","supported you","ٱللَّهُ ۚ هُوَ ٱلَّذِىٓ","بِنَصْرِهِۦ وَبِٱلْمُؤْمِنِينَ",879],["9:40:28",193,"وَأَيَّدَهُۥ","and supported him","ٱللَّهُ سَكِينَتَهُۥ عَلَيْهِ","بِجُنُودٍۢ لَّمْ تَرَوْهَا",879],["38:17:9",454,"ٱلْأَيْدِ ۖ","the possessor of strength","عَبْدَنَا دَاوُۥدَ ذَا","إِنَّهُۥٓ أَوَّابٌ",2210],["51:47:3",522,"بِأَيْي۟دٍۢ","with strength","وَٱلسَّمَآءَ بَنَيْنَـٰهَا","وَإِنَّا لَمُوسِعُونَ",2210],["58:22:27",545,"وَأَيَّدَهُم","and supported them","فِى قُلُوبِهِمُ ٱلْإِيمَـٰنَ","بِرُوحٍۢ مِّنْهُ ۖ وَيُدْخِلُهُمْ",879],["61:14:29",552,"فَأَيَّدْنَا","So We supported","إِسْرَٰٓءِيلَ وَكَفَرَت طَّآئِفَةٌۭ ۖ","ٱلَّذِينَ ءَامَنُوا۟ عَلَىٰ",879]]