[["2:26:25",5,"أَرَادَ","(did) intend","كَفَرُوا۟ فَيَقُولُونَ مَاذَآ","ٱللَّهُ بِهَـٰذَا مَثَلًۭا ۘ",81],["2:108:2",17,"تُرِيدُونَ","(do) you wish","أَمْ","أَن تَسْـَٔلُوا۟ رَسُولَكُمْ",81],["2:185:28",28,"يُرِيدُ","Intends","مِّنْ أَيَّامٍ أُخَرَ ۗ","ٱللَّهُ بِكُمُ ٱلْيُسْرَ",81],["2:185:33",28,"يُرِيدُ","intends","بِكُمُ ٱلْيُسْرَ وَلَا","بِكُمُ ٱلْعُسْرَ وَلِتُكْمِلُوا۟",81],["2:228:28",36,"أَرَادُوٓا۟","they wish","فِى ذَٰلِكَ إِنْ","إِصْلَـٰحًۭا ۚ وَلَهُنَّ مِثْلُ",81],["2:233:7",37,"أَرَادَ","wishes","حَوْلَيْنِ كَامِلَيْنِ ۖ لِمَنْ","أَن يُتِمَّ ٱلرَّضَاعَةَ ۚ",81],["2:233:35",37,"أَرَادَا","they both desire","مِثْلُ ذَٰلِكَ ۗ فَإِنْ","فِصَالًا عَن تَرَاضٍۢ",81],["2:233:45",37,"أَرَدتُّمْ","you want","جُنَاحَ عَلَيْهِمَا ۗ وَإِنْ","أَن تَسْتَرْضِعُوٓا۟ أَوْلَـٰدَكُمْ",81],["2:253:52",42,"يُرِيدُ","He intends","ٱللَّهَ يَفْعَلُ مَا","",81],["3:108:9",63,"يُرِيدُ","wants","بِٱلْحَقِّ ۗ وَمَا ٱللَّهُ","ظُلْمًۭا لِّلْعَـٰلَمِينَ",81],["3:145:12",68,"يُرِدْ","desires","كِتَـٰبًۭا مُّؤَجَّلًۭا ۗ وَمَن","ثَوَابَ ٱلدُّنْيَا نُؤْتِهِۦ",81],["3:145:18",68,"يُرِدْ","desires","نُؤْتِهِۦ مِنْهَا وَمَن","ثَوَابَ ٱلْـَٔاخِرَةِ نُؤْتِهِۦ",81],["3:152:23",69,"يُرِيدُ","desire","تُحِبُّونَ ۚ مِنكُم مَّن","ٱلدُّنْيَا وَمِنكُم مَّن",81],["3:152:27",69,"يُرِيدُ","desire","ٱلدُّنْيَا وَمِنكُم مَّن","ٱلْـَٔاخِرَةَ ۚ ثُمَّ صَرَفَكُمْ",81],["3:176:12",73,"يُرِيدُ","intends","يَضُرُّوا۟ ٱللَّهَ شَيْـًۭٔا ۗ","ٱللَّهُ أَلَّا يَجْعَلَ",81],["4:20:2",81,"أَرَدتُّمُ","you intend","وَإِنْ","ٱسْتِبْدَالَ زَوْجٍۢ مَّكَانَ",81],["4:26:1",82,"يُرِيدُ","Wishes","","ٱللَّهُ لِيُبَيِّنَ لَكُمْ",81],["4:27:2",83,"يُرِيدُ","wishes","وَٱللَّهُ","أَن يَتُوبَ عَلَيْكُمْ",81],["4:27:6",83,"وَيُرِيدُ","but wish","أَن يَتُوبَ عَلَيْكُمْ","ٱلَّذِينَ يَتَّبِعُونَ ٱلشَّهَوَٰتِ",81],["4:28:1",83,"يُرِيدُ","Wishes","","ٱللَّهُ أَن يُخَفِّفَ",81],["4:35:13",84,"يُرِيدَآ","they both wish","مِّنْ أَهْلِهَآ إِن","إِصْلَـٰحًۭا يُوَفِّقِ ٱللَّهُ",81],["4:44:11",85,"وَيُرِيدُونَ","and wishing","ٱلْكِتَـٰبِ يَشْتَرُونَ ٱلضَّلَـٰلَةَ","أَن تَضِلُّوا۟ ٱلسَّبِيلَ",81],["4:60:15",88,"يُرِيدُونَ","They wish","أُنزِلَ مِن قَبْلِكَ","أَن يَتَحَاكَمُوٓا۟ إِلَى",81],["4:60:25",88,"وَيُرِيدُ","And wishes","أَن يَكْفُرُوا۟ بِهِۦ","ٱلشَّيْطَـٰنُ أَن يُضِلَّهُمْ",81],["4:62:13",88,"أَرَدْنَآ","we intended","يَحْلِفُونَ بِٱللَّهِ إِنْ","إِلَّآ إِحْسَـٰنًۭا وَتَوْفِيقًا",81],["4:88:10",92,"أَتُرِيدُونَ","Do you wish","أَرْكَسَهُم بِمَا كَسَبُوٓا۟ ۚ","أَن تَهْدُوا۟ مَنْ",81],["4:91:3",92,"يُرِيدُونَ","wishing","سَتَجِدُونَ ءَاخَرِينَ","أَن يَأْمَنُوكُمْ وَيَأْمَنُوا۟",81],["4:134:3",99,"يُرِيدُ","desires","مَّن كَانَ","ثَوَابَ ٱلدُّنْيَا فَعِندَ",81],["4:144:11",101,"أَتُرِيدُونَ","Do you wish","مِن دُونِ ٱلْمُؤْمِنِينَ ۚ","أَن تَجْعَلُوا۟ لِلَّهِ",81],["4:150:6",102,"وَيُرِيدُونَ","and they wish","يَكْفُرُونَ بِٱللَّهِ وَرُسُلِهِۦ","أَن يُفَرِّقُوا۟ بَيْنَ",81],["4:150:17",102,"وَيُرِيدُونَ","And they wish","بِبَعْضٍۢ وَنَكْفُرُ بِبَعْضٍۢ","أَن يَتَّخِذُوا۟ بَيْنَ",81],["5:1:23",106,"يُرِيدُ","He wills","ٱللَّهَ يَحْكُمُ مَا","",81],["5:6:48",108,"يُرِيدُ","intend","وَأَيْدِيكُم مِّنْهُ ۚ مَا","ٱللَّهُ لِيَجْعَلَ عَلَيْكُم",81],["5:6:55",108,"يُرِيدُ","He intends","مِّنْ حَرَجٍۢ وَلَـٰكِن","لِيُطَهِّرَكُمْ وَلِيُتِمَّ نِعْمَتَهُۥ",81],["5:17:18",110,"أَرَادَ","He intends","ٱللَّهِ شَيْـًٔا إِنْ","أَن يُهْلِكَ ٱلْمَسِيحَ",81],["5:29:2",112,"أُرِيدُ","wish","إِنِّىٓ","أَن تَبُوٓأَ بِإِثْمِى",81],["5:37:1",114,"يُرِيدُونَ","They will wish","","أَن يَخْرُجُوا۟ مِنَ",81],["5:41:42",114,"يُرِدِ","intends","تُؤْتَوْهُ فَٱحْذَرُوا۟ ۚ وَمَن","ٱللَّهُ فِتْنَتَهُۥ فَلَن",81],["5:41:54",114,"يُرِدِ","will intend","أُو۟لَـٰٓئِكَ ٱلَّذِينَ لَمْ","ٱللَّهُ أَن يُطَهِّرَ",81],["5:49:23",116,"يُرِيدُ","intends","تَوَلَّوْا۟ فَٱعْلَمْ أَنَّمَا","ٱللَّهُ أَن يُصِيبَهُم",81],["5:91:2",123,"يُرِيدُ","intends","إِنَّمَا","ٱلشَّيْطَـٰنُ أَن يُوقِعَ",81],["5:113:2",126,"نُرِيدُ","We wish","قَالُوا۟","أَن نَّأْكُلَ مِنْهَا",81],["6:52:8",133,"يُرِيدُونَ","desiring","رَبَّهُم بِٱلْغَدَوٰةِ وَٱلْعَشِىِّ","وَجْهَهُۥ ۖ مَا عَلَيْكَ",81],["6:125:2",144,"يُرِدِ","wants","فَمَن","ٱللَّهُ أَن يَهْدِيَهُۥ",81],["6:125:10",144,"يُرِدْ","He wants","صَدْرَهُۥ لِلْإِسْلَـٰمِ ۖ وَمَن","أَن يُضِلَّهُۥ يَجْعَلْ",81],["7:110:1",164,"يُرِيدُ","He wants","","أَن يُخْرِجَكُم مِّنْ",81],["8:7:15",177,"وَيُرِيدُ","But intended","ٱلشَّوْكَةِ تَكُونُ لَكُمْ","ٱللَّهُ أَن يُحِقَّ",81],["8:62:2",185,"يُرِيدُوٓا۟","they intend","وَإِن","أَن يَخْدَعُوكَ فَإِنَّ",81],["8:67:12",185,"تُرِيدُونَ","You desire","يُثْخِنَ فِى ٱلْأَرْضِ ۚ","عَرَضَ ٱلدُّنْيَا وَٱللَّهُ",81],["8:67:16",185,"يُرِيدُ","desires","عَرَضَ ٱلدُّنْيَا وَٱللَّهُ","ٱلْـَٔاخِرَةَ ۗ وَٱللَّهُ عَزِيزٌ",81],["8:71:2",186,"يُرِيدُوا۟","they intend","وَإِن","خِيَانَتَكَ فَقَدْ خَانُوا۟",81],["9:32:1",192,"يُرِيدُونَ","They want","","أَن يُطْفِـُٔوا۟ نُورَ",81],["9:46:2",194,"أَرَادُوا۟","they had wished","۞ وَلَوْ","ٱلْخُرُوجَ لَأَعَدُّوا۟ لَهُۥ",81],["9:55:7",196,"يُرِيدُ","Allah intends","وَلَآ أَوْلَـٰدُهُمْ ۚ إِنَّمَا","ٱللَّهُ لِيُعَذِّبَهُم بِهَا",81],["9:85:6",200,"يُرِيدُ","Allah intends","أَمْوَٰلُهُمْ وَأَوْلَـٰدُهُمْ ۚ إِنَّمَا","ٱللَّهُ أَن يُعَذِّبَهُم",81],["9:107:18",204,"أَرَدْنَآ","we wish","قَبْلُ ۚ وَلَيَحْلِفُنَّ إِنْ","إِلَّا ٱلْحُسْنَىٰ ۖ وَٱللَّهُ",81],["10:107:11",221,"يُرِدْكَ","He intends for you","إِلَّا هُوَ ۖ وَإِن","بِخَيْرٍۢ فَلَا رَآدَّ",81],["11:15:3",223,"يُرِيدُ","desires","مَن كَانَ","ٱلْحَيَوٰةَ ٱلدُّنْيَا وَزِينَتَهَا",81],["11:34:5",225,"أَرَدتُّ","I wish","يَنفَعُكُمْ نُصْحِىٓ إِنْ","أَنْ أَنصَحَ لَكُمْ",81],["11:34:12",225,"يُرِيدُ","will","إِن كَانَ ٱللَّهُ","أَن يُغْوِيَكُمْ ۚ هُوَ",81],["11:79:13",230,"نُرِيدُ","we want","وَإِنَّكَ لَتَعْلَمُ مَا","",81],["11:88:15",231,"أُرِيدُ","I intend","رِزْقًا حَسَنًۭا ۚ وَمَآ","أَنْ أُخَالِفَكُمْ إِلَىٰ",81],["11:88:23",231,"أُرِيدُ","I intend","أَنْهَىٰكُمْ عَنْهُ ۚ إِنْ","إِلَّا ٱلْإِصْلَـٰحَ مَا",81],["11:107:15",233,"يُرِيدُ","He intends","رَبَّكَ فَعَّالٌۭ لِّمَا","",81],["12:23:1",238,"وَرَٰوَدَتْهُ","And sought to seduce him","","ٱلَّتِى هُوَ فِى",999],["12:25:15",238,"أَرَادَ","intended","مَا جَزَآءُ مَنْ","بِأَهْلِكَ سُوٓءًا إِلَّآ",81],["12:26:3",238,"رَٰوَدَتْنِى","sought to seduce me","قَالَ هِىَ","عَن نَّفْسِى ۚ وَشَهِدَ",999],["12:30:7",238,"تُرَٰوِدُ","(is) seeking to seduce","ٱلْمَدِينَةِ ٱمْرَأَتُ ٱلْعَزِيزِ","فَتَىٰهَا عَن نَّفْسِهِۦ ۖ",999],["12:32:7",239,"رَٰوَدتُّهُۥ","I sought to seduce him","لُمْتُنَّنِى فِيهِ ۖ وَلَقَدْ","عَن نَّفْسِهِۦ فَٱسْتَعْصَمَ ۖ",999],["12:51:5",241,"رَٰوَدتُّنَّ","you sought to seduce","مَا خَطْبُكُنَّ إِذْ","يُوسُفَ عَن نَّفْسِهِۦ ۚ",999],["12:51:24",241,"رَٰوَدتُّهُۥ","sought to seduce him","حَصْحَصَ ٱلْحَقُّ أَنَا۠","عَن نَّفْسِهِۦ وَإِنَّهُۥ",999],["12:61:2",242,"سَنُرَٰوِدُ","We will try to get permission","قَالُوا۟","عَنْهُ أَبَاهُ وَإِنَّا",999],["13:11:23",250,"أَرَادَ","wills","مَا بِأَنفُسِهِمْ ۗ وَإِذَآ","ٱللَّهُ بِقَوْمٍۢ سُوٓءًۭا",81],["14:10:24",256,"تُرِيدُونَ","you wish","إِلَّا بَشَرٌۭ مِّثْلُنَا","أَن تَصُدُّونَا عَمَّا",81],["16:40:5",271,"أَرَدْنَـٰهُ","We intend it","قَوْلُنَا لِشَىْءٍ إِذَآ","أَن نَّقُولَ لَهُۥ",81],["17:16:2",283,"أَرَدْنَآ","We intend","وَإِذَآ","أَن نُّهْلِكَ قَرْيَةً",81],["17:18:3",284,"يُرِيدُ","desire","مَّن كَانَ","ٱلْعَاجِلَةَ عَجَّلْنَا لَهُۥ",81],["17:18:11",284,"نُّرِيدُ","We intend","مَا نَشَآءُ لِمَن","ثُمَّ جَعَلْنَا لَهُۥ",81],["17:19:2",284,"أَرَادَ","desires","وَمَنْ","ٱلْـَٔاخِرَةَ وَسَعَىٰ لَهَا",81],["17:103:1",292,"فَأَرَادَ","So he intended","","أَن يَسْتَفِزَّهُم مِّنَ",81],["18:28:9",297,"يُرِيدُونَ","desiring","رَبَّهُم بِٱلْغَدَوٰةِ وَٱلْعَشِىِّ","وَجْهَهُۥ ۖ وَلَا تَعْدُ",81],["18:28:15",297,"تُرِيدُ","desiring","تَعْدُ عَيْنَاكَ عَنْهُمْ","زِينَةَ ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ",81],["18:77:15",302,"يُرِيدُ","(that) want(ed)","فَوَجَدَا فِيهَا جِدَارًۭا","أَن يَنقَضَّ فَأَقَامَهُۥ ۖ",81],["18:79:8",302,"فَأَرَدتُّ","So I intended","يَعْمَلُونَ فِى ٱلْبَحْرِ","أَنْ أَعِيبَهَا وَكَانَ",81],["18:81:1",302,"فَأَرَدْنَآ","So we intended","","أَن يُبْدِلَهُمَا رَبُّهُمَا",81],["18:82:15",302,"فَأَرَادَ","So intended","وَكَانَ أَبُوهُمَا صَـٰلِحًۭا","رَبُّكَ أَن يَبْلُغَآ",81],["20:63:5",315,"يُرِيدَانِ","they intend","إِنْ هَـٰذَٰنِ لَسَـٰحِرَٰنِ","أَن يُخْرِجَاكُم مِّنْ",81],["20:86:18",317,"أَرَدتُّمْ","did you desire","عَلَيْكُمُ ٱلْعَهْدُ أَمْ","أَن يَحِلَّ عَلَيْكُمْ",81],["21:17:2",323,"أَرَدْنَآ","We intended","لَوْ","أَن نَّتَّخِذَ لَهْوًۭا",81],["21:70:1",327,"وَأَرَادُوا۟","And they intended","","بِهِۦ كَيْدًۭا فَجَعَلْنَـٰهُمُ",81],["22:14:17",333,"يُرِيدُ","He intends","ٱللَّهَ يَفْعَلُ مَا","",81],["22:16:9",334,"يُرِيدُ","He intends","ٱللَّهَ يَهْدِى مَن","",81],["22:22:2",334,"أَرَادُوٓا۟","they want","كُلَّمَآ","أَن يَخْرُجُوا۟ مِنْهَا",81],["22:25:18",335,"يُرِدْ","intends","فِيهِ وَٱلْبَادِ ۚ وَمَن","فِيهِ بِإِلْحَادٍۭ بِظُلْمٍۢ",81],["23:24:12",343,"يُرِيدُ","he wishes","إِلَّا بَشَرٌۭ مِّثْلُكُمْ","أَن يَتَفَضَّلَ عَلَيْكُمْ",81],["24:33:34",354,"أَرَدْنَ","they desire","عَلَى ٱلْبِغَآءِ إِنْ","تَحَصُّنًۭا لِّتَبْتَغُوا۟ عَرَضَ",81],["25:62:8",365,"أَرَادَ","desires","وَٱلنَّهَارَ خِلْفَةًۭ لِّمَنْ","أَن يَذَّكَّرَ أَوْ",81],["25:62:12",365,"أَرَادَ","desires","أَن يَذَّكَّرَ أَوْ","شُكُورًۭا",81],["26:35:1",368,"يُرِيدُ","He wants","","أَن يُخْرِجَكُم مِّنْ",81],["28:5:1",385,"وَنُرِيدُ","And We wanted","","أَن نَّمُنَّ عَلَى",81],["28:19:3",387,"أَرَادَ","he wanted","فَلَمَّآ أَنْ","أَن يَبْطِشَ بِٱلَّذِى",81],["28:19:12",387,"أَتُرِيدُ","Do you intend","لَّهُمَا قَالَ يَـٰمُوسَىٰٓ","أَن تَقْتُلَنِى كَمَا",81],["28:19:20",387,"تُرِيدُ","you want","نَفْسًۢا بِٱلْأَمْسِ ۖ إِن","إِلَّآ أَن تَكُونَ",81],["28:19:28",387,"تُرِيدُ","you want","فِى ٱلْأَرْضِ وَمَا","أَن تَكُونَ مِنَ",81],["28:27:3",388,"أُرِيدُ","[I] wish","قَالَ إِنِّىٓ","أَنْ أُنكِحَكَ إِحْدَى",81],["28:27:20",388,"أُرِيدُ","I wish","فَمِنْ عِندِكَ ۖ وَمَآ","أَنْ أَشُقَّ عَلَيْكَ ۚ",81],["28:79:8",395,"يُرِيدُونَ","desire","زِينَتِهِۦ ۖ قَالَ ٱلَّذِينَ","ٱلْحَيَوٰةَ ٱلدُّنْيَا يَـٰلَيْتَ",81],["28:83:7",395,"يُرِيدُونَ","desire","نَجْعَلُهَا لِلَّذِينَ لَا","عُلُوًّۭا فِى ٱلْأَرْضِ",81],["30:38:11",408,"يُرِيدُونَ","desire","ذَٰلِكَ خَيْرٌۭ لِّلَّذِينَ","وَجْهَ ٱللَّهِ ۖ وَأُو۟لَـٰٓئِكَ",81],["30:39:17",408,"تُرِيدُونَ","desiring","ءَاتَيْتُم مِّن زَكَوٰةٍۢ","وَجْهَ ٱللَّهِ فَأُو۟لَـٰٓئِكَ",81],["32:20:7",416,"أَرَادُوٓا۟","they wish","فَمَأْوَىٰهُمُ ٱلنَّارُ ۖ كُلَّمَآ","أَن يَخْرُجُوا۟ مِنْهَآ",81],["33:13:23",419,"يُرِيدُونَ","they wished","هِىَ بِعَوْرَةٍ ۖ إِن","إِلَّا فِرَارًۭا",81],["33:17:9",420,"أَرَادَ","He intends","مِّنَ ٱللَّهِ إِنْ","بِكُمْ سُوٓءًا أَوْ",81],["33:17:13",420,"أَرَادَ","He intends","بِكُمْ سُوٓءًا أَوْ","بِكُمْ رَحْمَةًۭ ۚ وَلَا",81],["33:28:7",421,"تُرِدْنَ","desire","لِّأَزْوَٰجِكَ إِن كُنتُنَّ","ٱلْحَيَوٰةَ ٱلدُّنْيَا وَزِينَتَهَا",81],["33:29:3",421,"تُرِدْنَ","desire","وَإِن كُنتُنَّ","ٱللَّهَ وَرَسُولَهُۥ وَٱلدَّارَ",81],["33:33:17",422,"يُرِيدُ","Allah wishes","ٱللَّهَ وَرَسُولَهُۥٓ ۚ إِنَّمَا","ٱللَّهُ لِيُذْهِبَ عَنكُمُ",81],["33:50:35",424,"أَرَادَ","wishes","نَفْسَهَا لِلنَّبِىِّ إِنْ","ٱلنَّبِىُّ أَن يَسْتَنكِحَهَا",81],["34:43:11",433,"يُرِيدُ","who wishes","هَـٰذَآ إِلَّا رَجُلٌۭ","أَن يَصُدَّكُمْ عَمَّا",81],["35:10:3",435,"يُرِيدُ","[is] desires","مَن كَانَ","ٱلْعِزَّةَ فَلِلَّهِ ٱلْعِزَّةُ",81],["36:23:6",441,"يُرِدْنِ","intends for me","دُونِهِۦٓ ءَالِهَةً إِن","ٱلرَّحْمَـٰنُ بِضُرٍّۢ لَّا",81],["36:82:4",445,"أَرَادَ","He intends","إِنَّمَآ أَمْرُهُۥٓ إِذَآ","شَيْـًٔا أَن يَقُولَ",81],["37:86:5",449,"تُرِيدُونَ","(that) you desire","ءَالِهَةًۭ دُونَ ٱللَّهِ","",81],["37:98:1",449,"فَأَرَادُوا۟","And they intended","","بِهِۦ كَيْدًۭا فَجَعَلْنَـٰهُمُ",81],["38:6:12",453,"يُرَادُ","intended","إِنَّ هَـٰذَا لَشَىْءٌۭ","",81],["39:4:2",458,"أَرَادَ","Allah (had) intended","لَّوْ","ٱللَّهُ أَن يَتَّخِذَ",81],["39:38:17",462,"أَرَادَنِىَ","Allah intended for me","دُونِ ٱللَّهِ إِنْ","ٱللَّهُ بِضُرٍّ هَلْ",81],["39:38:25",462,"أَرَادَنِى","if He intended for me","كَـٰشِفَـٰتُ ضُرِّهِۦٓ أَوْ","بِرَحْمَةٍ هَلْ هُنَّ",81],["40:31:12",470,"يُرِيدُ","want","بَعْدِهِمْ ۚ وَمَا ٱللَّهُ","ظُلْمًۭا لِّلْعِبَادِ",81],["42:20:3",485,"يُرِيدُ","desiring","مَن كَانَ","حَرْثَ ٱلْـَٔاخِرَةِ نَزِدْ",81],["42:20:12",485,"يُرِيدُ","desiring","حَرْثِهِۦ ۖ وَمَن كَانَ","حَرْثَ ٱلدُّنْيَا نُؤْتِهِۦ",81],["48:11:25",512,"أَرَادَ","He intends","ٱللَّهِ شَيْـًٔا إِنْ","بِكُمْ ضَرًّا أَوْ",81],["48:11:29",512,"أَرَادَ","He intends","بِكُمْ ضَرًّا أَوْ","بِكُمْ نَفْعًۢا ۚ بَلْ",81],["48:15:10",512,"يُرِيدُونَ","They wish","لِتَأْخُذُوهَا ذَرُونَا نَتَّبِعْكُمْ ۖ","أَن يُبَدِّلُوا۟ كَلَـٰمَ",81],["51:57:2",523,"أُرِيدُ","I want","مَآ","مِنْهُم مِّن رِّزْقٍۢ",81],["51:57:7",523,"أُرِيدُ","I want","مِّن رِّزْقٍۢ وَمَآ","أَن يُطْعِمُونِ",81],["52:42:2",525,"يُرِيدُونَ","(do) they intend","أَمْ","كَيْدًۭا ۖ فَٱلَّذِينَ كَفَرُوا۟",81],["53:29:8",527,"يُرِدْ","he desires","عَن ذِكْرِنَا وَلَمْ","إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا",81],["54:37:2",530,"رَٰوَدُوهُ","they demanded from him","وَلَقَدْ","عَن ضَيْفِهِۦ فَطَمَسْنَآ",999],["61:8:1",552,"يُرِيدُونَ","They intend","","لِيُطْفِـُٔوا۟ نُورَ ٱللَّهِ",81],["72:10:5",572,"أُرِيدَ","is intended","لَا نَدْرِىٓ أَشَرٌّ","بِمَن فِى ٱلْأَرْضِ",81],["72:10:10",572,"أَرَادَ","intends","فِى ٱلْأَرْضِ أَمْ","بِهِمْ رَبُّهُمْ رَشَدًۭا",81],["74:31:35",576,"أَرَادَ","(does) intend","مَّرَضٌۭ وَٱلْكَـٰفِرُونَ مَاذَآ","ٱللَّهُ بِهَـٰذَا مَثَلًۭا ۚ",81],["74:52:2",577,"يُرِيدُ","Desires","بَلْ","كُلُّ ٱمْرِئٍۢ مِّنْهُمْ",81],["75:5:2",577,"يُرِيدُ","Desires","بَلْ","ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ",81],["76:9:6",579,"نُرِيدُ","we desire","لِوَجْهِ ٱللَّهِ لَا","مِنكُمْ جَزَآءًۭ وَلَا",81],["85:16:3",590,"يُرِيدُ","He intends","فَعَّالٌۭ لِّمَا","",81],["86:17:4",591,"رُوَيْدًۢا","little","فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ","",4205]]