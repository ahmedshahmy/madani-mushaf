[["12:31:8",239,"مُتَّكَـًۭٔا","a banquet","إِلَيْهِنَّ وَأَعْتَدَتْ لَهُنَّ","وَءَاتَتْ كُلَّ وَٰحِدَةٍۢ",3882],["18:31:21",297,"مُّتَّكِـِٔينَ","reclining","مِّن سُندُسٍۢ وَإِسْتَبْرَقٍۢ","فِيهَا عَلَى ٱلْأَرَآئِكِ ۚ",991],["20:18:4",313,"أَتَوَكَّؤُا۟","I lean","قَالَ هِىَ عَصَاىَ","عَلَيْهَا وَأَهُشُّ بِهَا",3041],["36:56:7",444,"مُتَّكِـُٔونَ","reclining","ظِلَـٰلٍ عَلَى ٱلْأَرَآئِكِ","",991],["38:51:1",456,"مُتَّكِـِٔينَ","Reclining","","فِيهَا يَدْعُونَ فِيهَا",991],["43:34:5",492,"يَتَّكِـُٔونَ","they recline","أَبْوَٰبًۭا وَسُرُرًا عَلَيْهَا","",4693],["52:20:1",524,"مُتَّكِـِٔينَ","Reclining","","عَلَىٰ سُرُرٍۢ مَّصْفُوفَةٍۢ ۖ",991],["55:54:1",533,"مُتَّكِـِٔينَ","Reclining","","عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا",991],["55:76:1",534,"مُتَّكِـِٔينَ","Reclining","","عَلَىٰ رَفْرَفٍ خُضْرٍۢ",991],["56:16:1",534,"مُّتَّكِـِٔينَ","Reclining","","عَلَيْهَا مُتَقَـٰبِلِينَ",991],["76:13:1",579,"مُّتَّكِـِٔينَ","Reclining","","فِيهَا عَلَى ٱلْأَرَآئِكِ ۖ",991]]