[["2:19:1",4,"أَوْ","Or","","كَصَيِّبٍۢ مِّنَ ٱلسَّمَآءِ",42],["2:74:9",11,"أَوْ","or","ذَٰلِكَ فَهِىَ كَٱلْحِجَارَةِ","أَشَدُّ قَسْوَةًۭ ۚ وَإِنَّ",42],["2:106:5",17,"أَوْ","or","نَنسَخْ مِنْ ءَايَةٍ","نُنسِهَا نَأْتِ بِخَيْرٍۢ",42],["2:106:10",17,"أَوْ","or","نَأْتِ بِخَيْرٍۢ مِّنْهَآ","مِثْلِهَآ ۗ أَلَمْ تَعْلَمْ",42],["2:111:9",17,"أَوْ","or","مَن كَانَ هُودًا","نَصَـٰرَىٰ ۗ تِلْكَ أَمَانِيُّهُمْ ۗ",42],["2:118:8",18,"أَوْ","or","لَوْلَا يُكَلِّمُنَا ٱللَّهُ","تَأْتِينَآ ءَايَةٌۭ ۗ كَذَٰلِكَ",42],["2:135:4",21,"أَوْ","or","وَقَالُوا۟ كُونُوا۟ هُودًا","نَصَـٰرَىٰ تَهْتَدُوا۟ ۗ قُلْ",42],["2:140:11",21,"أَوْ","or","وَٱلْأَسْبَاطَ كَانُوا۟ هُودًا","نَصَـٰرَىٰ ۗ قُلْ ءَأَنتُمْ",42],["2:158:10",24,"أَوِ","or","فَمَنْ حَجَّ ٱلْبَيْتَ","ٱعْتَمَرَ فَلَا جُنَاحَ",42],["2:182:6",28,"أَوْ","or","مِن مُّوصٍۢ جَنَفًا","إِثْمًۭا فَأَصْلَحَ بَيْنَهُمْ",42],["2:184:7",28,"أَوْ","or","كَانَ مِنكُم مَّرِيضًا","عَلَىٰ سَفَرٍۢ فَعِدَّةٌۭ",42],["2:185:21",28,"أَوْ","or","وَمَن كَانَ مَرِيضًا","عَلَىٰ سَفَرٍۢ فَعِدَّةٌۭ",42],["2:196:22",30,"أَوْ","or","كَانَ مِنكُم مَّرِيضًا","بِهِۦٓ أَذًۭى مِّن",42],["2:196:30",30,"أَوْ","or","فَفِدْيَةٌۭ مِّن صِيَامٍ","صَدَقَةٍ أَوْ نُسُكٍۢ ۚ",42],["2:196:32",30,"أَوْ","or","صِيَامٍ أَوْ صَدَقَةٍ","نُسُكٍۢ ۚ فَإِذَآ أَمِنتُمْ",42],["2:200:8",31,"أَوْ","or","ٱللَّهَ كَذِكْرِكُمْ ءَابَآءَكُمْ","أَشَدَّ ذِكْرًۭا ۗ فَمِنَ",42],["2:229:5",36,"أَوْ","or","مَرَّتَانِ ۖ فَإِمْسَاكٌۢ بِمَعْرُوفٍ","تَسْرِيحٌۢ بِإِحْسَـٰنٍۢ ۗ وَلَا",42],["2:231:8",37,"أَوْ","or","أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ","سَرِّحُوهُنَّ بِمَعْرُوفٍۢ ۚ وَلَا",42],["2:235:10",38,"أَوْ","or","مِنْ خِطْبَةِ ٱلنِّسَآءِ","أَكْنَنتُمْ فِىٓ أَنفُسِكُمْ ۚ",42],["2:236:10",38,"أَوْ","nor","مَا لَمْ تَمَسُّوهُنَّ","تَفْرِضُوا۟ لَهُنَّ فَرِيضَةًۭ ۚ",42],["2:237:17",38,"أَوْ","or","إِلَّآ أَن يَعْفُونَ","يَعْفُوَا۟ ٱلَّذِى بِيَدِهِۦ",42],["2:239:4",39,"أَوْ","or","فَإِنْ خِفْتُمْ فَرِجَالًا","رُكْبَانًۭا ۖ فَإِذَآ أَمِنتُمْ",42],["2:259:1",43,"أَوْ","Or","","كَٱلَّذِى مَرَّ عَلَىٰ