[["2:185:36",28,"وَلِتُكْمِلُوا۟","so that you complete","يُرِيدُ بِكُمُ ٱلْعُسْرَ","ٱلْعِدَّةَ وَلِتُكَبِّرُوا۟ ٱللَّهَ",2173],["2:196:58",30,"كَامِلَةٌۭ ۗ","in all","رَجَعْتُمْ ۗ تِلْكَ عَشَرَةٌۭ","ذَٰلِكَ لِمَن لَّمْ",2413],["2:233:5",37,"كَامِلَيْنِ ۖ","complete","يُرْضِعْنَ أَوْلَـٰدَهُنَّ حَوْلَيْنِ","لِمَنْ أَرَادَ أَن",3558],["5:3:41",107,"أَكْمَلْتُ","I have perfected","تَخْشَوْهُمْ وَٱخْشَوْنِ ۚ ٱلْيَوْمَ","لَكُمْ دِينَكُمْ وَأَتْمَمْتُ",2173],["16:25:3",269,"كَامِلَةًۭ","(in) full","لِيَحْمِلُوٓا۟ أَوْزَارَهُمْ","يَوْمَ ٱلْقِيَـٰمَةِ ۙ وَمِنْ",2413]]