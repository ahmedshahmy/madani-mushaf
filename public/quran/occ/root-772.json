[["6:52:2",133,"تَطْرُدِ","send away","وَلَا","ٱلَّذِينَ يَدْعُونَ رَبَّهُم",1801],["6:52:22",133,"فَتَطْرُدَهُمْ","So were you to send them away","عَلَيْهِم مِّن شَىْءٍۢ","فَتَكُونَ مِنَ ٱلظَّـٰلِمِينَ",1801],["11:29:13",225,"بِطَارِدِ","going to drive away","ٱللَّهِ ۚ وَمَآ أَنَا۠","ٱلَّذِينَ ءَامَنُوٓا۟ ۚ إِنَّهُم",2305],["11:30:7",225,"طَرَدتُّهُمْ ۚ","I drove them away","مِنَ ٱللَّهِ إِن","أَفَلَا تَذَكَّرُونَ",1801],["26:114:3",372,"بِطَارِدِ","the one to drive away","وَمَآ أَنَا۠","ٱلْمُؤْمِنِينَ",2305]]