[["2:74:10",11,"أَشَدُّ","stronger","فَهِىَ كَٱلْحِجَارَةِ أَوْ","قَسْوَةًۭ ۚ وَإِنَّ مِنَ",357],["2:85:43",13,"أَشَدِّ","(the) most severe","ٱلْقِيَـٰمَةِ يُرَدُّونَ إِلَىٰٓ","ٱلْعَذَابِ ۗ وَمَا ٱللَّهُ",357],["2:165:14",25,"أَشَدُّ","(are) stronger","ٱللَّهِ ۖ وَٱلَّذِينَ ءَامَنُوٓا۟","حُبًّۭا لِّلَّهِ ۗ وَلَوْ",357],["2:165:30",25,"شَدِيدُ","(is) severe","جَمِيعًۭا وَأَنَّ ٱللَّهَ","ٱلْعَذَابِ",213],["2:191:9",30,"أَشَدُّ","(is) worse","حَيْثُ أَخْرَجُوكُمْ ۚ وَٱلْفِتْنَةُ","مِنَ ٱلْقَتْلِ ۚ وَلَا",357],["2:196:72",30,"شَدِيدُ","(is) severe","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","ٱلْعِقَابِ",213],["2:200:9",31,"أَشَدَّ","(with) greater","كَذِكْرِكُمْ ءَابَآءَكُمْ أَوْ","ذِكْرًۭا ۗ فَمِنَ ٱلنَّاسِ",357],["2:211:19",33,"شَدِيدُ","(is) severe","جَآءَتْهُ فَإِنَّ ٱللَّهَ","ٱلْعِقَابِ",213],["3:4:14",50,"شَدِيدٌۭ ۗ","severe","ٱللَّهِ لَهُمْ عَذَابٌۭ","وَٱللَّهُ عَزِيزٌۭ ذُو",213],["3:11:13",51,"شَدِيدُ","(is) severe","ٱللَّهُ بِذُنُوبِهِمْ ۗ وَٱللَّهُ","ٱلْعِقَابِ",213],["3:56:6",57,"شَدِيدًۭا","severe","كَفَرُوا۟ فَأُعَذِّبُهُمْ عَذَابًۭا","فِى ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ",213],["4:66:26",89,"وَأَشَدَّ","and stronger","لَكَانَ خَيْرًۭا لَّهُمْ","تَثْبِيتًۭا",357],["4:77:25",90,"أَشَدَّ","more intense","كَخَشْيَةِ ٱللَّهِ أَوْ","خَشْيَةًۭ ۚ وَقَالُوا۟ رَبَّنَا",357],["4:84:19",91,"أَشَدُّ","(is) Stronger","ٱلَّذِينَ كَفَرُوا۟ ۚ وَٱللَّهُ","بَأْسًۭا وَأَشَدُّ تَنكِيلًۭا",357],["4:84:21",91,"وَأَشَدُّ","and Stronger","وَٱللَّهُ أَشَدُّ بَأْسًۭا","تَنكِيلًۭا",357],["5:2:51",106,"شَدِيدُ","(is) severe","ٱللَّهَ ۖ إِنَّ ٱللَّهَ","ٱلْعِقَابِ",213],["5:82:2",121,"أَشَدَّ","strongest","۞ لَتَجِدَنَّ","ٱلنَّاسِ عَدَٰوَةًۭ لِّلَّذِينَ",357],["5:98:4",124,"شَدِيدُ","(is) severe","ٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","ٱلْعِقَابِ وَأَنَّ ٱللَّهَ",213],["6:124:26",143,"شَدِيدٌۢ","severe","عِندَ ٱللَّهِ وَعَذَابٌۭ","بِمَا كَانُوا۟ يَمْكُرُونَ",213],["6:152:11",149,"أَشُدَّهُۥ ۖ","his maturity","أَحْسَنُ حَتَّىٰ يَبْلُغَ","وَأَوْفُوا۟ ٱلْكَيْلَ وَٱلْمِيزَانَ",950],["7:164:13",172,"شَدِيدًۭا ۖ","severe","أَوْ مُعَذِّبُهُمْ عَذَابًۭا","قَالُوا۟ مَعْذِرَةً إِلَىٰ",213],["8:13:12",178,"شَدِيدُ","(is) severe","وَرَسُولَهُۥ فَإِنَّ ٱللَّهَ","ٱلْعِقَابِ",213],["8:25:12",179,"شَدِيدُ","(is) severe","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","ٱلْعِقَابِ",213],["8:48:35",183,"شَدِيدُ","(is) severe","أَخَافُ ٱللَّهَ ۚ وَٱللَّهُ","ٱلْعِقَابِ",213],["8:52:16",183,"شَدِيدُ","(and) severe","إِنَّ ٱللَّهَ قَوِىٌّۭ","ٱلْعِقَابِ",213],["9:69:5",198,"أَشَدَّ","mightier","مِن قَبْلِكُمْ كَانُوٓا۟","مِنكُمْ قُوَّةًۭ وَأَكْثَرَ",357],["9:81:23",200,"أَشَدُّ","(is) more intense","قُلْ نَارُ جَهَنَّمَ","حَرًّۭا ۚ لَّوْ كَانُوا۟",357],["9:97:2",202,"أَشَدُّ","(are) stronger","ٱلْأَعْرَابُ","كُفْرًۭا وَنِفَاقًۭا وَأَجْدَرُ",357],["10:70:10",216,"ٱلشَّدِيدَ","the severe","ثُمَّ نُذِيقُهُمُ ٱلْعَذَابَ","بِمَا كَانُوا۟ يَكْفُرُونَ",213],["10:88:21",218,"وَٱشْدُدْ","and harden","ٱطْمِسْ عَلَىٰٓ أَمْوَٰلِهِمْ","عَلَىٰ قُلُوبِهِمْ فَلَا",1130],["11:80:11",230,"شَدِيدٍۢ","strong","ءَاوِىٓ إِلَىٰ رُكْنٍۢ","",213],["11:102:12",233,"شَدِيدٌ","(and) severe","إِنَّ أَخْذَهُۥٓ أَلِيمٌۭ","",213],["12:22:3",237,"أَشُدَّهُۥٓ","his maturity","وَلَمَّا بَلَغَ","ءَاتَيْنَـٰهُ حُكْمًۭا وَعِلْمًۭا ۚ",950],["12:48:7",241,"شِدَادٌۭ","hard (years)","بَعْدِ ذَٰلِكَ سَبْعٌۭ","يَأْكُلْنَ مَا قَدَّمْتُمْ",213],["13:6:19",250,"لَشَدِيدُ","(is) severe","ظُلْمِهِمْ ۖ وَإِنَّ رَبَّكَ","ٱلْعِقَابِ",213],["13:13:18",250,"شَدِيدُ","(is) Mighty","فِى ٱللَّهِ وَهُوَ","ٱلْمِحَالِ",213],["14:2:14",255,"شَدِيدٍ","severe","لِّلْكَـٰفِرِينَ مِنْ عَذَابٍۢ","",213],["14:7:11",256,"لَشَدِيدٌۭ","(is) surely severe","كَفَرْتُمْ إِنَّ عَذَابِى","",213],["14:18:7",257,"ٱشْتَدَّتْ","blows furiously","بِرَبِّهِمْ ۖ أَعْمَـٰلُهُمْ كَرَمَادٍ","بِهِ ٱلرِّيحُ فِى",4780],["17:5:11",282,"شَدِيدٍۢ","those of great military might","لَّنَآ أُو۟لِى بَأْسٍۢ","فَجَاسُوا۟ خِلَـٰلَ ٱلدِّيَارِ ۚ",213],["17:34:11",285,"أَشُدَّهُۥ ۚ","his maturity","أَحْسَنُ حَتَّىٰ يَبْلُغَ","وَأَوْفُوا۟ بِٱلْعَهْدِ ۖ إِنَّ",950],["17:58:13",287,"شَدِيدًۭا ۚ","severe","أَوْ مُعَذِّبُوهَا عَذَابًۭا","كَانَ ذَٰلِكَ فِى",213],["18:2:4",293,"شَدِيدًۭا","severe","قَيِّمًۭا لِّيُنذِرَ بَأْسًۭا","مِّن لَّدُنْهُ وَيُبَشِّرَ",213],["18:82:19",302,"أَشُدَّهُمَا","their maturity","رَبُّكَ أَن يَبْلُغَآ","وَيَسْتَخْرِجَا كَنزَهُمَا رَحْمَةًۭ",950],["19:69:7",310,"أَشَدُّ","(who were) worst","كُلِّ شِيعَةٍ أَيُّهُمْ","عَلَى ٱلرَّحْمَـٰنِ عِتِيًّۭا",357],["20:31:1",313,"ٱشْدُدْ","Reinforce","","بِهِۦٓ أَزْرِى",1130],["20:71:24",316,"أَشَدُّ","(is) more severe","ٱلنَّخْلِ وَلَتَعْلَمُنَّ أَيُّنَآ","عَذَابًۭا وَأَبْقَىٰ",357],["20:127:11",321,"أَشَدُّ","(is) more severe","رَبِّهِۦ ۚ وَلَعَذَابُ ٱلْـَٔاخِرَةِ","وَأَبْقَىٰٓ",357],["22:2:22",332,"شَدِيدٌۭ","(will be) severe","وَلَـٰكِنَّ عَذَابَ ٱللَّهِ","",213],["22:5:40",332,"أَشُدَّكُمْ ۖ","[your] maturity","طِفْلًۭا ثُمَّ لِتَبْلُغُوٓا۟","وَمِنكُم مَّن يُتَوَفَّىٰ",950],["23:77:8",347,"شَدِيدٍ","severe","بَابًۭا ذَا عَذَابٍۢ","إِذَا هُمْ فِيهِ",213],["27:21:3",378,"شَدِيدًا","severe","لَأُعَذِّبَنَّهُۥ عَذَابًۭا","أَوْ لَأَا۟ذْبَحَنَّهُۥٓ أَوْ",213],["27:33:7",379,"شَدِيدٍۢ","great","قُوَّةٍۢ وَأُو۟لُوا۟ بَأْسٍۢ","وَٱلْأَمْرُ إِلَيْكِ فَٱنظُرِى",213],["28:14:3",387,"أَشُدَّهُۥ","his full strength","وَلَمَّا بَلَغَ","وَٱسْتَوَىٰٓ ءَاتَيْنَـٰهُ حُكْمًۭا",950],["28:35:2",389,"سَنَشُدُّ","We will strengthen","قَالَ","عَضُدَكَ بِأَخِيكَ وَنَجْعَلُ",1130],["28:78:19",395,"أَشَدُّ","(were) stronger","ٱلْقُرُونِ مَنْ هُوَ","مِنْهُ قُوَّةًۭ وَأَكْثَرُ",357],["30:9:13",405,"أَشَدَّ","mightier","مِن قَبْلِهِمْ ۚ كَانُوٓا۟","مِنْهُمْ قُوَّةًۭ وَأَثَارُوا۟",357],["33:11:6",419,"شَدِيدًۭا","severe","ٱلْمُؤْمِنُونَ وَزُلْزِلُوا۟ زِلْزَالًۭا","",213],["34:46:24",433,"شَدِيدٍۢ","severe","بَيْنَ يَدَىْ عَذَابٍۢ","",213],["35:7:5",435,"شَدِيدٌۭ ۖ","severe","كَفَرُوا۟ لَهُمْ عَذَابٌۭ","وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",213],["35:10:20",435,"شَدِيدٌۭ ۖ","severe","ٱلسَّيِّـَٔاتِ لَهُمْ عَذَابٌۭ","وَمَكْرُ أُو۟لَـٰٓئِكَ هُوَ",213],["35:44:13",439,"أَشَدَّ","stronger","مِن قَبْلِهِمْ وَكَانُوٓا۟","مِنْهُمْ قُوَّةًۭ ۚ وَمَا",357],["37:11:3",446,"أَشَدُّ","a stronger","فَٱسْتَفْتِهِمْ أَهُمْ","خَلْقًا أَم مَّنْ",357],["38:20:1",454,"وَشَدَدْنَا","And We strengthened","","مُلْكَهُۥ وَءَاتَيْنَـٰهُ ٱلْحِكْمَةَ",1130],["38:26:26",454,"شَدِيدٌۢ","severe","ٱللَّهِ لَهُمْ عَذَابٌۭ","بِمَا نَسُوا۟ يَوْمَ",213],["40:3:5",467,"شَدِيدِ","severe","ٱلذَّنۢبِ وَقَابِلِ ٱلتَّوْبِ","ٱلْعِقَابِ ذِى ٱلطَّوْلِ ۖ",213],["40:21:15",469,"أَشَدَّ","superior","قَبْلِهِمْ ۚ كَانُوا۟ هُمْ","مِنْهُمْ قُوَّةًۭ وَءَاثَارًۭا",357],["40:22:12",469,"شَدِيدُ","severe","ٱللَّهُ ۚ إِنَّهُۥ قَوِىٌّۭ","ٱلْعِقَابِ",213],["40:46:12",472,"أَشَدَّ","(in the) severest","أَدْخِلُوٓا۟ ءَالَ فِرْعَوْنَ","ٱلْعَذَابِ",357],["40:67:17",475,"أَشُدَّكُمْ","your maturity","طِفْلًۭا ثُمَّ لِتَبْلُغُوٓا۟","ثُمَّ لِتَكُونُوا۟ شُيُوخًۭا ۚ",950],["40:82:15",476,"وَأَشَدَّ","and mightier","كَانُوٓا۟ أَكْثَرَ مِنْهُمْ","قُوَّةًۭ وَءَاثَارًۭا فِى",357],["41:15:10",478,"أَشَدُّ","(is) mightier","ٱلْحَقِّ وَقَالُوا۟ مَنْ","مِنَّا قُوَّةً ۖ أَوَلَمْ",357],["41:15:20",478,"أَشَدُّ","(is) Mightier","ٱلَّذِى خَلَقَهُمْ هُوَ","مِنْهُمْ قُوَّةًۭ ۖ وَكَانُوا۟",357],["41:27:5",479,"شَدِيدًۭا","severe","ٱلَّذِينَ كَفَرُوا۟ عَذَابًۭا","وَلَنَجْزِيَنَّهُمْ أَسْوَأَ ٱلَّذِى",213],["42:16:18",485,"شَدِيدٌ","severe","غَضَبٌۭ وَلَهُمْ عَذَابٌۭ","",213],["42:26:12",486,"شَدِيدٌۭ","severe","وَٱلْكَـٰفِرُونَ لَهُمْ عَذَابٌۭ","",213],["43:8:2",489,"أَشَدَّ","stronger","فَأَهْلَكْنَآ","مِنْهُم بَطْشًۭا وَمَضَىٰ",357],["46:15:17",504,"أَشُدَّهُۥ","his maturity","حَتَّىٰٓ إِذَا بَلَغَ","وَبَلَغَ أَرْبَعِينَ سَنَةًۭ",950],["47:4:10",507,"فَشُدُّوا۟","then bind firmly","حَتَّىٰٓ إِذَآ أَثْخَنتُمُوهُمْ","ٱلْوَثَاقَ فَإِمَّا مَنًّۢا",1130],["47:13:5",508,"أَشَدُّ","(was) stronger","مِّن قَرْيَةٍ هِىَ","قُوَّةًۭ مِّن قَرْيَتِكَ",357],["48:16:10",513,"شَدِيدٍۢ","great","قَوْمٍ أُو۟لِى بَأْسٍۢ","تُقَـٰتِلُونَهُمْ أَوْ يُسْلِمُونَ ۖ",213],["48:29:6",515,"أَشِدَّآءُ","(are) firm","ٱللَّهِ ۚ وَٱلَّذِينَ مَعَهُۥٓ","عَلَى ٱلْكُفَّارِ رُحَمَآءُ",213],["50:26:10",519,"ٱلشَّدِيدِ","the severe","فَأَلْقِيَاهُ فِى ٱلْعَذَابِ","",213],["50:36:7",520,"أَشَدُّ","(were) stronger","مِّن قَرْنٍ هُمْ","مِنْهُم بَطْشًۭا فَنَقَّبُوا۟",357],["53:5:2",526,"شَدِيدُ","the (one) mighty","عَلَّمَهُۥ","ٱلْقُوَىٰ",213],["57:20:29",540,"شَدِيدٌۭ","severe","وَفِى ٱلْـَٔاخِرَةِ عَذَابٌۭ","وَمَغْفِرَةٌۭ مِّنَ ٱللَّهِ",213],["57:25:16",541,"شَدِيدٌۭ","mighty","ٱلْحَدِيدَ فِيهِ بَأْسٌۭ","وَمَنَـٰفِعُ لِلنَّاسِ وَلِيَعْلَمَ",213],["58:15:5",544,"شَدِيدًا ۖ","severe","ٱللَّهُ لَهُمْ عَذَابًۭا","إِنَّهُمْ سَآءَ مَا",213],["59:4:11",546,"شَدِيدُ","(is) severe","ٱللَّهَ فَإِنَّ ٱللَّهَ","ٱلْعِقَابِ",213],["59:7:36",546,"شَدِيدُ","(is) severe","ٱللَّهَ ۖ إِنَّ ٱللَّهَ","ٱلْعِقَابِ",213],["59:13:2",547,"أَشَدُّ","(are) more intense","لَأَنتُمْ","رَهْبَةًۭ فِى صُدُورِهِم",357],["59:14:14",547,"شَدِيدٌۭ ۚ","(is) severe","جُدُرٍۭ ۚ بَأْسُهُم بَيْنَهُمْ","تَحْسَبُهُمْ جَمِيعًۭا وَقُلُوبُهُمْ",213],["65:8:11",559,"شَدِيدًۭا","severe","وَرُسُلِهِۦ فَحَاسَبْنَـٰهَا حِسَابًۭا","وَعَذَّبْنَـٰهَا عَذَابًۭا نُّكْرًۭا",213],["65:10:5",559,"شَدِيدًۭا ۖ","severe","ٱللَّهُ لَهُمْ عَذَابًۭا","فَٱتَّقُوا۟ ٱللَّهَ يَـٰٓأُو۟لِى",213],["66:6:14",560,"شِدَادٌۭ","severe","عَلَيْهَا مَلَـٰٓئِكَةٌ غِلَاظٌۭ","لَّا يَعْصُونَ ٱللَّهَ",213],["72:8:7",572,"شَدِيدًۭا","severe","فَوَجَدْنَـٰهَا مُلِئَتْ حَرَسًۭا","وَشُهُبًۭا",213],["73:6:5",574,"أَشَدُّ","(is) very hard","نَاشِئَةَ ٱلَّيْلِ هِىَ","وَطْـًۭٔا وَأَقْوَمُ قِيلًا",357],["76:28:3",580,"وَشَدَدْنَآ","and We strengthened","نَّحْنُ خَلَقْنَـٰهُمْ","أَسْرَهُمْ ۖ وَإِذَا شِئْنَا",1130],["78:12:4",582,"شِدَادًۭا","strong","وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا","",213],["79:27:2",584,"أَشَدُّ","a more difficult","ءَأَنتُمْ","خَلْقًا أَمِ ٱلسَّمَآءُ ۚ",357],["85:12:4",590,"لَشَدِيدٌ","(is) surely strong","إِنَّ بَطْشَ رَبِّكَ","",213],["100:8:4",600,"لَشَدِيدٌ","(is) surely intense","وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ","",213]]