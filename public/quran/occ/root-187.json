[["2:24:12",4,"أُعِدَّتْ","prepared","وَقُودُهَا ٱلنَّاسُ وَٱلْحِجَارَةُ ۖ","لِلْكَـٰفِرِينَ",500],["2:80:7",12,"مَّعْدُودَةًۭ ۚ","numbered","ٱلنَّارُ إِلَّآ أَيَّامًۭا","قُلْ أَتَّخَذْتُمْ عِندَ",1207],["2:184:2",28,"مَّعْدُودَٰتٍۢ ۚ","numbered","أَيَّامًۭا","فَمَن كَانَ مِنكُم",1207],["2:184:10",28,"فَعِدَّةٌۭ","then a prescribed number","أَوْ عَلَىٰ سَفَرٍۢ","مِّنْ أَيَّامٍ أُخَرَ ۚ",772],["2:185:24",28,"فَعِدَّةٌۭ","then prescribed number (should be made up)","أَوْ عَلَىٰ سَفَرٍۢ","مِّنْ أَيَّامٍ أُخَرَ ۗ",772],["2:185:37",28,"ٱلْعِدَّةَ","the prescribed period","بِكُمُ ٱلْعُسْرَ وَلِتُكْمِلُوا۟","وَلِتُكَبِّرُوا۟ ٱللَّهَ عَلَىٰ",772],["2:203:5",32,"مَّعْدُودَٰتٍۢ ۚ","numbered","ٱللَّهَ فِىٓ أَيَّامٍۢ","فَمَن تَعَجَّلَ فِى",1207],["3:24:9",53,"مَّعْدُودَٰتٍۢ ۖ","numbered","ٱلنَّارُ إِلَّآ أَيَّامًۭا","وَغَرَّهُمْ فِى دِينِهِم",1207],["3:131:4",66,"أُعِدَّتْ","is prepared","وَٱتَّقُوا۟ ٱلنَّارَ ٱلَّتِىٓ","لِلْكَـٰفِرِينَ",500],["3:133:10",67,"أُعِدَّتْ","prepared","عَرْضُهَا ٱلسَّمَـٰوَٰتُ وَٱلْأَرْضُ","لِلْمُتَّقِينَ",500],["4:93:13",93,"وَأَعَدَّ","and He has prepared","ٱللَّهُ عَلَيْهِ وَلَعَنَهُۥ","لَهُۥ عَذَابًا عَظِيمًۭا",500],["4:102:59",95,"أَعَدَّ","has prepared","حِذْرَكُمْ ۗ إِنَّ ٱللَّهَ","لِلْكَـٰفِرِينَ عَذَابًۭا مُّهِينًۭا",500],["8:60:1",184,"وَأَعِدُّوا۟","And prepare","","لَهُم مَّا ٱسْتَطَعْتُم",500],["9:36:2",192,"عِدَّةَ","(the) number","إِنَّ","ٱلشُّهُورِ عِندَ ٱللَّهِ",772],["9:37:15",193,"عِدَّةَ","the number","وَيُحَرِّمُونَهُۥ عَامًۭا لِّيُوَاطِـُٔوا۟","مَا حَرَّمَ ٱللَّهُ",772],["9:46:4",194,"لَأَعَدُّوا۟","surely they (would) have prepared","۞ وَلَوْ أَرَادُوا۟ ٱلْخُرُوجَ","لَهُۥ عُدَّةًۭ وَلَـٰكِن",500],["9:46:6",194,"عُدَّةًۭ","(some) preparation","ٱلْخُرُوجَ لَأَعَدُّوا۟ لَهُۥ","وَلَـٰكِن كَرِهَ ٱللَّهُ",3147],["9:89:1",201,"أَعَدَّ","Allah has prepared","","ٱللَّهُ لَهُمْ جَنَّـٰتٍۢ",500],["9:100:14",203,"وَأَعَدَّ","And He has prepared","عَنْهُمْ وَرَضُوا۟ عَنْهُ","لَهُمْ جَنَّـٰتٍۢ تَجْرِى",500],["10:5:11",208,"عَدَدَ","(the) number","وَقَدَّرَهُۥ مَنَازِلَ لِتَعْلَمُوا۟","ٱلسِّنِينَ وَٱلْحِسَابَ ۚ مَا",1152],["11:8:7",222,"مَّعْدُودَةٍۢ","determined","ٱلْعَذَابَ إِلَىٰٓ أُمَّةٍۢ","لَّيَقُولُنَّ مَا يَحْبِسُهُۥٓ ۗ",1207],["11:104:5",233,"مَّعْدُودٍۢ","limited","نُؤَخِّرُهُۥٓ إِلَّا لِأَجَلٍۢ","",3909],["12:20:5",237,"مَعْدُودَةٍۢ","few","بِثَمَنٍۭ بَخْسٍۢ دَرَٰهِمَ","وَكَانُوا۟ فِيهِ مِنَ",1207],["14:34:7",260,"تَعُدُّوا۟","you count","مَا سَأَلْتُمُوهُ ۚ وَإِن","نِعْمَتَ ٱللَّهِ لَا",1047],["16:18:2",269,"تَعُدُّوا۟","you should count","وَإِن","نِعْمَةَ ٱللَّهِ لَا",1047],["17:12:17",283,"عَدَدَ","(the) number","مِّن رَّبِّكُمْ وَلِتَعْلَمُوا۟","ٱلسِّنِينَ وَٱلْحِسَابَ ۚ وَكُلَّ",1152],["18:11:7",294,"عَدَدًۭا","a number","فِى ٱلْكَهْفِ سِنِينَ","",1152],["18:22:18",296,"بِعِدَّتِهِم","their number","قُل رَّبِّىٓ أَعْلَمُ","مَّا يَعْلَمُهُمْ إِلَّا",772],["19:84:5",311,"نَعُدُّ","We count","تَعْجَلْ عَلَيْهِمْ ۖ إِنَّمَا","لَهُمْ عَدًّۭا",1047],["19:84:7",311,"عَدًّۭا","a number","إِنَّمَا نَعُدُّ لَهُمْ","",2235],["19:94:3",311,"وَعَدَّهُمْ","and counted them","لَّقَدْ أَحْصَىٰهُمْ","عَدًّۭا",1047],["19:94:4",311,"عَدًّۭا","a counting","لَّقَدْ أَحْصَىٰهُمْ وَعَدَّهُمْ","",2235],["22:47:14",338,"تَعُدُّونَ","you count","كَأَلْفِ سَنَةٍۢ مِّمَّا","",1047],["23:112:6",349,"عَدَدَ","(in) number","لَبِثْتُمْ فِى ٱلْأَرْضِ","سِنِينَ",1152],["23:113:8",349,"ٱلْعَآدِّينَ","those who keep count","بَعْضَ يَوْمٍۢ فَسْـَٔلِ","",3090],["32:5:17",415,"تَعُدُّونَ","you count","أَلْفَ سَنَةٍۢ مِّمَّا","",1047],["33:8:5",419,"وَأَعَدَّ","And He has prepared","ٱلصَّـٰدِقِينَ عَن صِدْقِهِمْ ۚ","لِلْكَـٰفِرِينَ عَذَابًا أَلِيمًۭا",500],["33:29:10",421,"أَعَدَّ","has prepared","ٱلْـَٔاخِرَةَ فَإِنَّ ٱللَّهَ","لِلْمُحْسِنَـٰتِ مِنكُنَّ أَجْرًا",500],["33:35:25",422,"أَعَدَّ","Allah has prepared","ٱللَّهَ كَثِيرًۭا وَٱلذَّٰكِرَٰتِ","ٱللَّهُ لَهُم مَّغْفِرَةًۭ",500],["33:44:5",424,"وَأَعَدَّ","and He has prepared","يَوْمَ يَلْقَوْنَهُۥ سَلَـٰمٌۭ ۚ","لَهُمْ أَجْرًۭا كَرِيمًۭا",500],["33:49:17",424,"عِدَّةٍۢ","waiting period","لَكُمْ عَلَيْهِنَّ مِنْ","تَعْتَدُّونَهَا ۖ فَمَتِّعُوهُنَّ وَسَرِّحُوهُنَّ",772],["33:49:18",424,"تَعْتَدُّونَهَا ۖ","(to) count concerning them","عَلَيْهِنَّ مِنْ عِدَّةٍۢ","فَمَتِّعُوهُنَّ وَسَرِّحُوهُنَّ سَرَاحًۭا",4327],["33:57:11",426,"وَأَعَدَّ","and prepared","فِى ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ","لَهُمْ عَذَابًۭا مُّهِينًۭا",500],["33:64:5",427,"وَأَعَدَّ","and has prepared","ٱللَّهَ لَعَنَ ٱلْكَـٰفِرِينَ","لَهُمْ سَعِيرًا",500],["38:62:8",457,"نَعُدُّهُم","count them","نَرَىٰ رِجَالًۭا كُنَّا","مِّنَ ٱلْأَشْرَارِ",1047],["48:6:17",511,"وَأَعَدَّ","and prepared","ٱللَّهُ عَلَيْهِمْ وَلَعَنَهُمْ","لَهُمْ جَهَنَّمَ ۖ وَسَآءَتْ",500],["57:21:11",540,"أُعِدَّتْ","prepared","كَعَرْضِ ٱلسَّمَآءِ وَٱلْأَرْضِ","لِلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ",500],["58:15:1",544,"أَعَدَّ","Allah has prepared","","ٱللَّهُ لَهُمْ عَذَابًۭا",500],["65:1:7",558,"لِعِدَّتِهِنَّ","for their waiting period","طَلَّقْتُمُ ٱلنِّسَآءَ فَطَلِّقُوهُنَّ","وَأَحْصُوا۟ ٱلْعِدَّةَ ۖ وَٱتَّقُوا۟",772],["65:1:9",558,"ٱلْعِدَّةَ ۖ","(of) the waiting period","فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ وَأَحْصُوا۟","وَٱتَّقُوا۟ ٱللَّهَ رَبَّكُمْ ۖ",772],["65:4:9",558,"فَعِدَّتُهُنَّ","then their waiting period","نِّسَآئِكُمْ إِنِ ٱرْتَبْتُمْ","ثَلَـٰثَةُ أَشْهُرٍۢ وَٱلَّـٰٓـِٔى",772],["65:10:1",559,"أَعَدَّ","Has prepared","","ٱللَّهُ لَهُمْ عَذَابًۭا",500],["72:24:11",573,"عَدَدًۭا","(in) number","أَضْعَفُ نَاصِرًۭا وَأَقَلُّ","",1152],["72:28:13",573,"عَدَدًۢا","(in) number","وَأَحْصَىٰ كُلَّ شَىْءٍ","",1152],["74:31:9",576,"عِدَّتَهُمْ","their number","مَلَـٰٓئِكَةًۭ ۙ وَمَا جَعَلْنَا","إِلَّا فِتْنَةًۭ لِّلَّذِينَ",772],["76:31:7",580,"أَعَدَّ","He has prepared","فِى رَحْمَتِهِۦ ۚ وَٱلظَّـٰلِمِينَ","لَهُمْ عَذَابًا أَلِيمًۢا",500],["104:2:4",601,"وَعَدَّدَهُۥ","and counts it","ٱلَّذِى جَمَعَ مَالًۭا","",3110]]