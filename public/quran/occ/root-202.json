[["2:102:56",16,"يَنفَعُهُمْ ۚ","profits them","مَا يَضُرُّهُمْ وَلَا","وَلَقَدْ عَلِمُوا۟ لَمَنِ",358],["2:123:14",19,"تَنفَعُهَا","will benefit it","مِنْهَا عَدْلٌۭ وَلَا","شَفَـٰعَةٌۭ وَلَا هُمْ",358],["2:164:15",25,"يَنفَعُ","benefits","فِى ٱلْبَحْرِ بِمَا","ٱلنَّاسَ وَمَآ أَنزَلَ",358],["2:219:9",34,"وَمَنَـٰفِعُ","and (some) benefits","فِيهِمَآ إِثْمٌۭ كَبِيرٌۭ","لِلنَّاسِ وَإِثْمُهُمَآ أَكْبَرُ",983],["2:219:14",34,"نَّفْعِهِمَا ۗ","(the) benefit of (the) two","وَإِثْمُهُمَآ أَكْبَرُ مِن","وَيَسْـَٔلُونَكَ مَاذَا يُنفِقُونَ",794],["4:11:63",78,"نَفْعًۭا ۚ","(in) benefit","أَيُّهُمْ أَقْرَبُ لَكُمْ","فَرِيضَةًۭ مِّنَ ٱللَّهِ ۗ",794],["5:76:12",120,"نَفْعًۭا ۚ","any benefit","لَكُمْ ضَرًّۭا وَلَا","وَٱللَّهُ هُوَ ٱلسَّمِيعُ",794],["5:119:5",127,"يَنفَعُ","will profit","ٱللَّهُ هَـٰذَا يَوْمُ","ٱلصَّـٰدِقِينَ صِدْقُهُمْ ۚ لَهُمْ",358],["6:71:8",136,"يَنفَعُنَا","benefits us","ٱللَّهِ مَا لَا","وَلَا يَضُرُّنَا وَنُرَدُّ",358],["6:158:21",150,"يَنفَعُ","will benefit","ءَايَـٰتِ رَبِّكَ لَا","نَفْسًا إِيمَـٰنُهَا لَمْ",358],["7:188:5",175,"نَفْعًۭا","(to) benefit","لَّآ أَمْلِكُ لِنَفْسِى","وَلَا ضَرًّا إِلَّا",794],["10:18:9",210,"يَنفَعُهُمْ","benefit them","لَا يَضُرُّهُمْ وَلَا","وَيَقُولُونَ هَـٰٓؤُلَآءِ شُفَعَـٰٓؤُنَا",358],["10:49:7",214,"نَفْعًا","(for) any profit","لِنَفْسِى ضَرًّۭا وَلَا","إِلَّا مَا شَآءَ",794],["10:98:5",220,"فَنَفَعَهَآ","and benefited it","كَانَتْ قَرْيَةٌ ءَامَنَتْ","إِيمَـٰنُهَآ إِلَّا قَوْمَ",358],["10:106:8",220,"يَنفَعُكَ","benefit you","ٱللَّهِ مَا لَا","وَلَا يَضُرُّكَ ۖ فَإِن",358],["11:34:2",225,"يَنفَعُكُمْ","benefit you","وَلَا","نُصْحِىٓ إِنْ أَرَدتُّ",358],["12:21:11",237,"يَنفَعَنَآ","(he) will benefit us","مَثْوَىٰهُ عَسَىٰٓ أَن","أَوْ نَتَّخِذَهُۥ وَلَدًۭا ۚ",358],["13:16:16",251,"نَفْعًۭا","(to) benefit","لَا يَمْلِكُونَ لِأَنفُسِهِمْ","وَلَا ضَرًّۭا ۚ قُلْ",794],["13:17:34",251,"يَنفَعُ","benefits","جُفَآءًۭ ۖ وَأَمَّا مَا","ٱلنَّاسَ فَيَمْكُثُ فِى",358],["16:5:6",267,"وَمَنَـٰفِعُ","and benefits","لَكُمْ فِيهَا دِفْءٌۭ","وَمِنْهَا تَأْكُلُونَ",983],["20:89:12",318,"نَفْعًۭا","any benefit","لَهُمْ ضَرًّۭا وَلَا","",794],["20:109:3",319,"تَنفَعُ","will benefit","يَوْمَئِذٍۢ لَّا","ٱلشَّفَـٰعَةُ إِلَّا مَنْ",358],["21:66:8",327,"يَنفَعُكُمْ","benefit you","ٱللَّهِ مَا لَا","شَيْـًۭٔا وَلَا يَضُرُّكُمْ",358],["22:12:10",333,"يَنفَعُهُۥ ۚ","benefits him","يَضُرُّهُۥ وَمَا لَا","ذَٰلِكَ هُوَ ٱلضَّلَـٰلُ",358],["22:13:6",333,"نَّفْعِهِۦ ۚ","his benefit","ضَرُّهُۥٓ أَقْرَبُ مِن","لَبِئْسَ ٱلْمَوْلَىٰ وَلَبِئْسَ",794],["22:28:2",335,"مَنَـٰفِعَ","benefits","لِّيَشْهَدُوا۟","لَهُمْ وَيَذْكُرُوا۟ ٱسْمَ",983],["22:33:3",336,"مَنَـٰفِعُ","(are) benefits","لَكُمْ فِيهَا","إِلَىٰٓ أَجَلٍۢ مُّسَمًّۭى",983],["23:21:12",343,"مَنَـٰفِعُ","(are) benefits","بُطُونِهَا وَلَكُمْ فِيهَا","كَثِيرَةٌۭ وَمِنْهَا تَأْكُلُونَ",983],["25:3:15",360,"نَفْعًۭا","any benefit","لِأَنفُسِهِمْ ضَرًّۭا وَلَا","وَلَا يَمْلِكُونَ مَوْتًۭا",794],["25:55:7",364,"يَنفَعُهُمْ","not profits them","ٱللَّهِ مَا لَا","وَلَا يَضُرُّهُمْ ۗ وَكَانَ",358],["26:73:2",370,"يَنفَعُونَكُمْ","(do) they benefit you","أَوْ","أَوْ يَضُرُّونَ",358],["26:88:3",371,"يَنفَعُ","will benefit","يَوْمَ لَا","مَالٌۭ وَلَا بَنُونَ",358],["28:9:12",386,"يَنفَعَنَآ","he may benefit us","تَقْتُلُوهُ عَسَىٰٓ أَن","أَوْ نَتَّخِذَهُۥ وَلَدًۭا",358],["30:57:3",410,"يَنفَعُ","will profit","فَيَوْمَئِذٍۢ لَّا","ٱلَّذِينَ ظَلَمُوا۟ مَعْذِرَتُهُمْ",358],["32:29:5",417,"يَنفَعُ","will benefit","يَوْمَ ٱلْفَتْحِ لَا","ٱلَّذِينَ كَفَرُوٓا۟ إِيمَـٰنُهُمْ",358],["33:16:3",420,"يَنفَعَكُمُ","will benefit you","قُل لَّن","ٱلْفِرَارُ إِن فَرَرْتُم",358],["34:23:2",431,"تَنفَعُ","benefits","وَلَا","ٱلشَّفَـٰعَةُ عِندَهُۥٓ إِلَّا",358],["34:42:6",433,"نَّفْعًۭا","to benefit","يَمْلِكُ بَعْضُكُمْ لِبَعْضٍۢ","وَلَا ضَرًّۭا وَنَقُولُ",794],["36:73:3",445,"مَنَـٰفِعُ","(are) benefits","وَلَهُمْ فِيهَا","وَمَشَارِبُ ۖ أَفَلَا يَشْكُرُونَ",983],["40:52:3",473,"يَنفَعُ","will benefit","يَوْمَ لَا","ٱلظَّـٰلِمِينَ مَعْذِرَتُهُمْ ۖ وَلَهُمُ",358],["40:80:3",476,"مَنَـٰفِعُ","(are) benefits","وَلَكُمْ فِيهَا","وَلِتَبْلُغُوا۟ عَلَيْهَا حَاجَةًۭ",983],["40:85:3",476,"يَنفَعُهُمْ","benefit them","فَلَمْ يَكُ","إِيمَـٰنُهُمْ لَمَّا رَأَوْا۟",358],["43:39:2",492,"يَنفَعَكُمُ","will benefit you","وَلَن","ٱلْيَوْمَ إِذ ظَّلَمْتُمْ",358],["48:11:31",512,"نَفْعًۢا ۚ","a benefit","أَوْ أَرَادَ بِكُمْ","بَلْ كَانَ ٱللَّهُ",794],["51:55:4",523,"تَنفَعُ","benefits","وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ","ٱلْمُؤْمِنِينَ",358],["57:25:17",541,"وَمَنَـٰفِعُ","and benefits","فِيهِ بَأْسٌۭ شَدِيدٌۭ","لِلنَّاسِ وَلِيَعْلَمَ ٱللَّهُ",983],["60:3:2",549,"تَنفَعَكُمْ","will benefit you","لَن","أَرْحَامُكُمْ وَلَآ أَوْلَـٰدُكُمْ ۚ",358],["74:48:2",577,"تَنفَعُهُمْ","will benefit them","فَمَا","شَفَـٰعَةُ ٱلشَّـٰفِعِينَ",358],["80:4:3",585,"فَتَنفَعَهُ","so would benefit him","أَوْ يَذَّكَّرُ","ٱلذِّكْرَىٰٓ",358],["87:9:3",591,"نَّفَعَتِ","benefits","فَذَكِّرْ إِن","ٱلذِّكْرَىٰ",358]]