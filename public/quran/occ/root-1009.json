[["4:172:2",105,"يَسْتَنكِفَ","will disdain","لَّن","ٱلْمَسِيحُ أَن يَكُونَ",2109],["4:172:12",105,"يَسْتَنكِفْ","disdains","ٱلْمَلَـٰٓئِكَةُ ٱلْمُقَرَّبُونَ ۚ وَمَن","عَنْ عِبَادَتِهِۦ وَيَسْتَكْبِرْ",2109],["4:173:13",105,"ٱسْتَنكَفُوا۟","disdained","فَضْلِهِۦ ۖ وَأَمَّا ٱلَّذِينَ","وَٱسْتَكْبَرُوا۟ فَيُعَذِّبُهُمْ عَذَابًا",2109]]