[["2:265:13",45,"بِرَبْوَةٍ","on a height","أَنفُسِهِمْ كَمَثَلِ جَنَّةٍۭ","أَصَابَهَا وَابِلٌۭ فَـَٔاتَتْ",2600],["2:275:3",47,"ٱلرِّبَوٰا۟","[the] usury","ٱلَّذِينَ يَأْكُلُونَ","لَا يَقُومُونَ إِلَّا",1097],["2:275:20",47,"ٱلرِّبَوٰا۟ ۗ","[the] usury","إِنَّمَا ٱلْبَيْعُ مِثْلُ","وَأَحَلَّ ٱللَّهُ ٱلْبَيْعَ",1097],["2:275:25",47,"ٱلرِّبَوٰا۟ ۚ","[the] usury","ٱللَّهُ ٱلْبَيْعَ وَحَرَّمَ","فَمَن جَآءَهُۥ مَوْعِظَةٌۭ",1097],["2:276:3",47,"ٱلرِّبَوٰا۟","the usury","يَمْحَقُ ٱللَّهُ","وَيُرْبِى ٱلصَّدَقَـٰتِ ۗ وَٱللَّهُ",1097],["2:276:4",47,"وَيُرْبِى","and (gives) increase","يَمْحَقُ ٱللَّهُ ٱلرِّبَوٰا۟","ٱلصَّدَقَـٰتِ ۗ وَٱللَّهُ لَا",2187],["2:278:10",47,"ٱلرِّبَوٰٓا۟","[the] usury","مَا بَقِىَ مِنَ","إِن كُنتُم مُّؤْمِنِينَ",1097],["3:130:6",66,"ٱلرِّبَوٰٓا۟","the usury","ءَامَنُوا۟ لَا تَأْكُلُوا۟","أَضْعَـٰفًۭا مُّضَـٰعَفَةًۭ ۖ وَٱتَّقُوا۟",1097],["4:161:2",103,"ٱلرِّبَوٰا۟","(of) [the] usury","وَأَخْذِهِمُ","وَقَدْ نُهُوا۟ عَنْهُ",1097],["13:17:11",251,"رَّابِيًۭا ۚ","rising","فَٱحْتَمَلَ ٱلسَّيْلُ زَبَدًۭا","وَمِمَّا يُوقِدُونَ عَلَيْهِ",4207],["16:92:18",277,"أَرْبَىٰ","more numerous","تَكُونَ أُمَّةٌ هِىَ","مِنْ أُمَّةٍ ۚ إِنَّمَا",2187],["17:24:11",284,"رَبَّيَانِى","they brought me up","رَّبِّ ٱرْحَمْهُمَا كَمَا","صَغِيرًۭا",2601],["22:5:64",332,"وَرَبَتْ","and it swells","عَلَيْهَا ٱلْمَآءَ ٱهْتَزَّتْ","وَأَنۢبَتَتْ مِن كُلِّ",1630],["23:50:8",345,"رَبْوَةٍۢ","a high ground","ءَايَةًۭ وَءَاوَيْنَـٰهُمَآ إِلَىٰ","ذَاتِ قَرَارٍۢ وَمَعِينٍۢ",2600],["26:18:3",367,"نُرَبِّكَ","we bring you up","قَالَ أَلَمْ","فِينَا وَلِيدًۭا وَلَبِثْتَ",2601],["30:39:4",408,"رِّبًۭا","usury","وَمَآ ءَاتَيْتُم مِّن","لِّيَرْبُوَا۟ فِىٓ أَمْوَٰلِ",4220],["30:39:5",408,"لِّيَرْبُوَا۟","to increase","ءَاتَيْتُم مِّن رِّبًۭا","فِىٓ أَمْوَٰلِ ٱلنَّاسِ",1630],["30:39:10",408,"يَرْبُوا۟","(will) increase","أَمْوَٰلِ ٱلنَّاسِ فَلَا","عِندَ ٱللَّهِ ۖ وَمَآ",1630],["41:39:12",481,"وَرَبَتْ ۚ","and grows","عَلَيْهَا ٱلْمَآءَ ٱهْتَزَّتْ","إِنَّ ٱلَّذِىٓ أَحْيَاهَا",1630],["69:10:6",567,"رَّابِيَةً","exceeding","رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةًۭ","",4208]]