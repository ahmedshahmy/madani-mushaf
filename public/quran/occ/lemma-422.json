[["2:87:10",13,"عِيسَى","Isa","بَعْدِهِۦ بِٱلرُّسُلِ ۖ وَءَاتَيْنَا","ٱبْنَ مَرْيَمَ ٱلْبَيِّنَـٰتِ",422],["2:136:18",21,"وَعِيسَىٰ","and Isa","وَمَآ أُوتِىَ مُوسَىٰ","وَمَآ أُوتِىَ ٱلنَّبِيُّونَ",422],["2:253:15",42,"عِيسَى","Isa","بَعْضَهُمْ دَرَجَـٰتٍۢ ۚ وَءَاتَيْنَا","ٱبْنَ مَرْيَمَ ٱلْبَيِّنَـٰتِ",422],["3:45:12",55,"عِيسَى","Isa","مِّنْهُ ٱسْمُهُ ٱلْمَسِيحُ","ٱبْنُ مَرْيَمَ وَجِيهًۭا",422],["3:52:3",56,"عِيسَىٰ","Isa","۞ فَلَمَّآ أَحَسَّ","مِنْهُمُ ٱلْكُفْرَ قَالَ",422],["3:55:4",57,"يَـٰعِيسَىٰٓ","O Isa","إِذْ قَالَ ٱللَّهُ","إِنِّى مُتَوَفِّيكَ وَرَافِعُكَ",422],["3:59:3",57,"عِيسَىٰ","(of) Isa","إِنَّ مَثَلَ","عِندَ ٱللَّهِ كَمَثَلِ",422],["3:84:18",61,"وَعِيسَىٰ","and Isa","وَمَآ أُوتِىَ مُوسَىٰ","وَٱلنَّبِيُّونَ مِن رَّبِّهِمْ",422],["4:157:5",103,"عِيسَى","Isa","إِنَّا قَتَلْنَا ٱلْمَسِيحَ","ٱبْنَ مَرْيَمَ رَسُولَ",422],["4:163:18",104,"وَعِيسَىٰ","and Isa","وَإِسْحَـٰقَ وَيَعْقُوبَ وَٱلْأَسْبَاطِ","وَأَيُّوبَ وَيُونُسَ وَهَـٰرُونَ",422],["4:171:15",105,"عِيسَى","Isa","ٱلْحَقَّ ۚ إِنَّمَا ٱلْمَسِيحُ","ٱبْنُ مَرْيَمَ رَسُولُ",422],["5:46:4",116,"بِعِيسَى","Isa","وَقَفَّيْنَا عَلَىٰٓ ءَاثَـٰرِهِم","ٱبْنِ مَرْيَمَ مُصَدِّقًۭا",422],["5:78:10",121,"وَعِيسَى","and Isa","عَلَىٰ لِسَانِ دَاوُۥدَ","ٱبْنِ مَرْيَمَ ۚ ذَٰلِكَ",422],["5:110:4",126,"يَـٰعِيسَى","O Isa","إِذْ قَالَ ٱللَّهُ","ٱبْنَ مَرْيَمَ ٱذْكُرْ",422],["5:112:4",126,"يَـٰعِيسَى","O Isa","إِذْ قَالَ ٱلْحَوَارِيُّونَ","ٱبْنَ مَرْيَمَ هَلْ",422],["5:114:2",127,"عِيسَى","Isa","قَالَ","ٱبْنُ مَرْيَمَ ٱللَّهُمَّ",422],["5:116:4",127,"يَـٰعِيسَى","O Isa","وَإِذْ قَالَ ٱللَّهُ","ٱبْنَ مَرْيَمَ ءَأَنتَ",422],["6:85:3",138,"وَعِيسَىٰ","and Isa","وَزَكَرِيَّا وَيَحْيَىٰ","وَإِلْيَاسَ ۖ كُلٌّۭ مِّنَ",422],["19:34:2",307,"عِيسَى","(was) Isa","ذَٰلِكَ","ٱبْنُ مَرْيَمَ ۚ قَوْلَ",422],["33:7:11",419,"وَعِيسَى","and Isa","نُّوحٍۢ وَإِبْرَٰهِيمَ وَمُوسَىٰ","ٱبْنِ مَرْيَمَ ۖ وَأَخَذْنَا",422],["42:13:17",484,"وَعِيسَىٰٓ ۖ","and Isa","بِهِۦٓ إِبْرَٰهِيمَ وَمُوسَىٰ","أَنْ أَقِيمُوا۟ ٱلدِّينَ",422],["43:63:3",494,"عِيسَىٰ","Isa","وَلَمَّا جَآءَ","بِٱلْبَيِّنَـٰتِ قَالَ قَدْ",422],["57:27:7",541,"بِعِيسَى","with Isa","ءَاثَـٰرِهِم بِرُسُلِنَا وَقَفَّيْنَا","ٱبْنِ مَرْيَمَ وَءَاتَيْنَـٰهُ",422],["61:6:3",552,"عِيسَى","Isa","وَإِذْ قَالَ","ٱبْنُ مَرْيَمَ يَـٰبَنِىٓ",422],["61:14:9",552,"عِيسَى","Isa","ٱللَّهِ كَمَا قَالَ","ٱبْنُ مَرْيَمَ لِلْحَوَارِيِّـۧنَ",422]]