[["2:217:11",34,"وَصَدٌّ","but hindering (people)","قِتَالٌۭ فِيهِ كَبِيرٌۭ ۖ","عَن سَبِيلِ ٱللَّهِ",2290],["3:99:5",62,"تَصُدُّونَ","(do) you hinder","يَـٰٓأَهْلَ ٱلْكِتَـٰبِ لِمَ","عَن سَبِيلِ ٱللَّهِ",314],["4:55:7",87,"صَدَّ","turned away","بِهِۦ وَمِنْهُم مَّن","عَنْهُ ۚ وَكَفَىٰ بِجَهَنَّمَ",314],["4:61:13",88,"يَصُدُّونَ","turning away","ٱلرَّسُولِ رَأَيْتَ ٱلْمُنَـٰفِقِينَ","عَنكَ صُدُودًۭا",314],["4:61:15",88,"صُدُودًۭا","(in) aversion","ٱلْمُنَـٰفِقِينَ يَصُدُّونَ عَنكَ","",3266],["4:160:10",103,"وَبِصَدِّهِمْ","and for their hindering","طَيِّبَـٰتٍ أُحِلَّتْ لَهُمْ","عَن سَبِيلِ ٱللَّهِ",2290],["4:167:4",104,"وَصَدُّوا۟","and hinder","إِنَّ ٱلَّذِينَ كَفَرُوا۟","عَن سَبِيلِ ٱللَّهِ",314],["5:2:32",106,"صَدُّوكُمْ","they stopped you","شَنَـَٔانُ قَوْمٍ أَن","عَنِ ٱلْمَسْجِدِ ٱلْحَرَامِ",314],["5:91:12",123,"وَيَصُدَّكُمْ","and hinders you","فِى ٱلْخَمْرِ وَٱلْمَيْسِرِ","عَن ذِكْرِ ٱللَّهِ",314],["7:45:2",156,"يَصُدُّونَ","hinder","ٱلَّذِينَ","عَن سَبِيلِ ٱللَّهِ",314],["7:86:6",161,"وَتَصُدُّونَ","and hindering","بِكُلِّ صِرَٰطٍۢ تُوعِدُونَ","عَن سَبِيلِ ٱللَّهِ",314],["8:34:7",181,"يَصُدُّونَ","hinder (people)","يُعَذِّبَهُمُ ٱللَّهُ وَهُمْ","عَنِ ٱلْمَسْجِدِ ٱلْحَرَامِ",314],["8:36:6",181,"لِيَصُدُّوا۟","to hinder (people)","كَفَرُوا۟ يُنفِقُونَ أَمْوَٰلَهُمْ","عَن سَبِيلِ ٱللَّهِ ۚ",314],["8:47:10",183,"وَيَصُدُّونَ","and hinder (them)","بَطَرًۭا وَرِئَآءَ ٱلنَّاسِ","عَن سَبِيلِ ٱللَّهِ ۚ",314],["9:9:6",188,"فَصَدُّوا۟","and they hinder (people)","ٱللَّهِ ثَمَنًۭا قَلِيلًۭا","عَن سَبِيلِهِۦٓ ۚ إِنَّهُمْ",314],["9:34:13",192,"وَيَصُدُّونَ","and hinder","أَمْوَٰلَ ٱلنَّاسِ بِٱلْبَـٰطِلِ","عَن سَبِيلِ ٱللَّهِ ۗ",314],["11:19:2",223,"يَصُدُّونَ","hinder","ٱلَّذِينَ","عَن سَبِيلِ ٱللَّهِ",314],["13:33:30",253,"وَصُدُّوا۟","and they are hindered","لِلَّذِينَ كَفَرُوا۟ مَكْرُهُمْ","عَنِ ٱلسَّبِيلِ ۗ وَمَن",3267],["14:3:7",255,"وَيَصُدُّونَ","and hinder","ٱلدُّنْيَا عَلَى ٱلْـَٔاخِرَةِ","عَن سَبِيلِ ٱللَّهِ",314],["14:10:26",256,"تَصُدُّونَا","hinder us","مِّثْلُنَا تُرِيدُونَ أَن","عَمَّا كَانَ يَعْبُدُ",314],["14:16:7",257,"صَدِيدٍۢ","purulent","وَيُسْقَىٰ مِن مَّآءٍۢ","",3240],["16:88:3",277,"وَصَدُّوا۟","and hindered","ٱلَّذِينَ كَفَرُوا۟","عَن سَبِيلِ ٱللَّهِ",314],["16:94:13",278,"صَدَدتُّمْ","you hindered","وَتَذُوقُوا۟ ٱلسُّوٓءَ بِمَا","عَن سَبِيلِ ٱللَّهِ ۖ",314],["20:16:2",313,"يَصُدَّنَّكَ","(let) avert you","فَلَا","عَنْهَا مَن لَّا",314],["22:25:4",335,"وَيَصُدُّونَ","and hinder","إِنَّ ٱلَّذِينَ كَفَرُوا۟","عَن سَبِيلِ ٱللَّهِ",314],["27:24:12",379,"فَصَدَّهُمْ","and averted them","لَهُمُ ٱلشَّيْطَـٰنُ أَعْمَـٰلَهُمْ","عَنِ ٱلسَّبِيلِ فَهُمْ",314],["27:43:1",380,"وَصَدَّهَا","And has averted her","","مَا كَانَت تَّعْبُدُ",314],["28:87:2",396,"يَصُدُّنَّكَ","avert you","وَلَا","عَنْ ءَايَـٰتِ ٱللَّهِ",314],["29:38:12",400,"فَصَدَّهُمْ","and averted them","لَهُمُ ٱلشَّيْطَـٰنُ أَعْمَـٰلَهُمْ","عَنِ ٱلسَّبِيلِ وَكَانُوا۟",314],["34:32:7",432,"صَدَدْنَـٰكُمْ","avert you","لِلَّذِينَ ٱسْتُضْعِفُوٓا۟ أَنَحْنُ","عَنِ ٱلْهُدَىٰ بَعْدَ",314],["34:43:13",433,"يَصُدَّكُمْ","hinder you","رَجُلٌۭ يُرِيدُ أَن","عَمَّا كَانَ يَعْبُدُ",314],["40:37:15",471,"وَصُدَّ","and he was averted","لِفِرْعَوْنَ سُوٓءُ عَمَلِهِۦ","عَنِ ٱلسَّبِيلِ ۚ وَمَا",314],["43:37:2",492,"لَيَصُدُّونَهُمْ","surely, turn them","وَإِنَّهُمْ","عَنِ ٱلسَّبِيلِ وَيَحْسَبُونَ",314],["43:57:9",493,"يَصِدُّونَ","laughed aloud","إِذَا قَوْمُكَ مِنْهُ","",314],["43:62:2",494,"يَصُدَّنَّكُمُ","avert you","وَلَا","ٱلشَّيْطَـٰنُ ۖ إِنَّهُۥ لَكُمْ",314],["47:1:3",507,"وَصَدُّوا۟","and turn away","ٱلَّذِينَ كَفَرُوا۟","عَن سَبِيلِ ٱللَّهِ",314],["47:32:4",510,"وَصَدُّوا۟","and turn away","إِنَّ ٱلَّذِينَ كَفَرُوا۟","عَن سَبِيلِ ٱللَّهِ",314],["47:34:4",510,"وَصَدُّوا۟","and turn away","إِنَّ ٱلَّذِينَ كَفَرُوا۟","عَن سَبِيلِ ٱللَّهِ",314],["48:25:4",514,"وَصَدُّوكُمْ","and hindered you","هُمُ ٱلَّذِينَ كَفَرُوا۟","عَنِ ٱلْمَسْجِدِ ٱلْحَرَامِ",314],["58:16:4",544,"فَصَدُّوا۟","so they hinder","ٱتَّخَذُوٓا۟ أَيْمَـٰنَهُمْ جُنَّةًۭ","عَن سَبِيلِ ٱللَّهِ",314],["63:2:4",554,"فَصَدُّوا۟","so they turn away","ٱتَّخَذُوٓا۟ أَيْمَـٰنَهُمْ جُنَّةًۭ","عَن سَبِيلِ ٱللَّهِ ۚ",314],["63:5:12",555,"يَصُدُّونَ","turning away","لَوَّوْا۟ رُءُوسَهُمْ وَرَأَيْتَهُمْ","وَهُم مُّسْتَكْبِرُونَ",314]]