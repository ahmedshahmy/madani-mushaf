[["2:49:5",8,"فِرْعَوْنَ","(of) Firaun","نَجَّيْنَـٰكُم مِّنْ ءَالِ","يَسُومُونَكُمْ سُوٓءَ ٱلْعَذَابِ",158],["2:50:8",8,"فِرْعَوْنَ","(of) Firaun","فَأَنجَيْنَـٰكُمْ وَأَغْرَقْنَآ ءَالَ","وَأَنتُمْ تَنظُرُونَ",158],["3:11:3",51,"فِرْعَوْنَ","(of) Firaun","كَدَأْبِ ءَالِ","وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ",158],["7:103:8",163,"فِرْعَوْنَ","Firaun","مُّوسَىٰ بِـَٔايَـٰتِنَآ إِلَىٰ","وَمَلَإِي۟هِۦ فَظَلَمُوا۟ بِهَا ۖ",158],["7:104:3",163,"يَـٰفِرْعَوْنُ","O Firaun","وَقَالَ مُوسَىٰ","إِنِّى رَسُولٌۭ مِّن",158],["7:109:5",164,"فِرْعَوْنَ","(of) Firaun","ٱلْمَلَأُ مِن قَوْمِ","إِنَّ هَـٰذَا لَسَـٰحِرٌ",158],["7:113:3",164,"فِرْعَوْنَ","(to) Firaun","وَجَآءَ ٱلسَّحَرَةُ","قَالُوٓا۟ إِنَّ لَنَا",158],["7:123:2",165,"فِرْعَوْنُ","Firaun","قَالَ","ءَامَنتُم بِهِۦ قَبْلَ",158],["7:127:5",165,"فِرْعَوْنَ","(of) Firaun","ٱلْمَلَأُ مِن قَوْمِ","أَتَذَرُ مُوسَىٰ وَقَوْمَهُۥ",158],["7:130:4",165,"فِرْعَوْنَ","(of) Firaun","وَلَقَدْ أَخَذْنَآ ءَالَ","بِٱلسِّنِينَ وَنَقْصٍۢ مِّنَ",158],["7:137:25",166,"فِرْعَوْنُ","Firaun","مَا كَانَ يَصْنَعُ","وَقَوْمُهُۥ وَمَا كَانُوا۟",158],["7:141:5",167,"فِرْعَوْنَ","(of) Firaun","أَنجَيْنَـٰكُم مِّنْ ءَالِ","يَسُومُونَكُمْ سُوٓءَ ٱلْعَذَابِ ۖ",158],["8:52:3",183,"فِرْعَوْنَ ۙ","(of) Firaun","كَدَأْبِ ءَالِ","وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ",158],["8:54:3",184,"فِرْعَوْنَ ۙ","(of) Firaun","كَدَأْبِ ءَالِ","وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ",158],["8:54:14",184,"فِرْعَوْنَ ۚ","(of) Firaun","بِذُنُوبِهِمْ وَأَغْرَقْنَآ ءَالَ","وَكُلٌّۭ كَانُوا۟ ظَـٰلِمِينَ",158],["10:75:8",217,"فِرْعَوْنَ","Firaun","مُّوسَىٰ وَهَـٰرُونَ إِلَىٰ","وَمَلَإِي۟هِۦ بِـَٔايَـٰتِنَا فَٱسْتَكْبَرُوا۟",158],["10:79:2",218,"فِرْعَوْنُ","And Firaun said","وَقَالَ","ٱئْتُونِى بِكُلِّ سَـٰحِرٍ",158],["10:83:11",218,"فِرْعَوْنَ","Firaun","عَلَىٰ خَوْفٍۢ مِّن","وَمَلَإِي۟هِمْ أَن يَفْتِنَهُمْ ۚ",158],["10:83:16",218,"فِرْعَوْنَ","Firaun","أَن يَفْتِنَهُمْ ۚ وَإِنَّ","لَعَالٍۢ فِى ٱلْأَرْضِ",158],["10:88:6",218,"فِرْعَوْنَ","Firaun","رَبَّنَآ إِنَّكَ ءَاتَيْتَ","وَمَلَأَهُۥ زِينَةًۭ و