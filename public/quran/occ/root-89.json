[["2:30:9",6,"خَلِيفَةًۭ ۖ","a vicegerent","جَاعِلٌۭ فِى ٱلْأَرْضِ","قَالُوٓا۟ أَتَجْعَلُ فِيهَا",933],["2:66:7",10,"خَلْفَهَا","after them","بَيْنَ يَدَيْهَا وَمَا","وَمَوْعِظَةًۭ لِّلْمُتَّقِينَ",479],["2:80:14",12,"يُخْلِفَ","will break","ٱللَّهِ عَهْدًۭا فَلَن","ٱللَّهُ عَهْدَهُۥٓ ۖ أَمْ",650],["2:113:31",18,"يَخْتَلِفُونَ","differing","فِيمَا كَانُوا۟ فِيهِ","",336],["2:164:6",25,"وَٱخْتِلَـٰفِ","and alternation","خَلْقِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","ٱلَّيْلِ وَٱلنَّهَارِ وَٱلْفُلْكِ",1127],["2:176:9",26,"ٱخْتَلَفُوا۟","who differed","بِٱلْحَقِّ ۗ وَإِنَّ ٱلَّذِينَ","فِى ٱلْكِتَـٰبِ لَفِى",336],["2:213:18",33,"ٱخْتَلَفُوا۟","they differed","بَيْنَ ٱلنَّاسِ فِيمَا","فِيهِ ۚ وَمَا ٱخْتَلَفَ",336],["2:213:21",33,"ٱخْتَلَفَ","differ[ed]","ٱخْتَلَفُوا۟ فِيهِ ۚ وَمَا","فِيهِ إِلَّا ٱلَّذِينَ",336],["2:213:38",33,"ٱخْتَلَفُوا۟","they differed","ٱلَّذِينَ ءَامَنُوا۟ لِمَا","فِيهِ مِنَ ٱلْحَقِّ",336],["2:253:36",42,"ٱخْتَلَفُوا۟","they differed","جَآءَتْهُمُ ٱلْبَيِّنَـٰتُ وَلَـٰكِنِ","فَمِنْهُم مَّنْ ءَامَنَ",336],["2:255:32",42,"خَلْفَهُمْ ۖ","(is) behind them","بَيْنَ أَيْدِيهِمْ وَمَا","وَلَا يُحِيطُونَ بِشَىْءٍۢ",479],["3:9:12",50,"يُخْلِفُ","break","إِنَّ ٱللَّهَ لَا","ٱلْمِيعَادَ",650],["3:19:7",52,"ٱخْتَلَفَ","differed","ٱللَّهِ ٱلْإِسْلَـٰمُ ۗ وَمَا","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ",336],["3:55:30",57,"تَخْتَلِفُونَ","differing","فِيمَا كُنتُمْ فِيهِ","",336],["3:105:5",63,"وَٱخْتَلَفُوا۟","and differed","تَكُونُوا۟ كَٱلَّذِينَ تَفَرَّقُوا۟","مِنۢ بَعْدِ مَا",336],["3:170:13",72,"خَلْفِهِمْ","(but are) left behind","يَلْحَقُوا۟ بِهِم مِّنْ","أَلَّا خَوْفٌ عَلَيْهِمْ",479],["3:190:6",75,"وَٱخْتِلَـٰفِ","and (in the) alternation","خَلْقِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","ٱلَّيْلِ وَٱلنَّهَارِ لَـَٔايَـٰتٍۢ",1127],["3:194:13",75,"تُخْلِفُ","break","ٱلْقِيَـٰمَةِ ۗ إِنَّكَ لَا","ٱلْمِيعَادَ",650],["4:9:6",78,"خَلْفِهِمْ","behind","لَوْ تَرَكُوا۟ مِنْ","ذُرِّيَّةًۭ ضِعَـٰفًا خَافُوا۟",479],["4:82:12",91,"ٱخْتِلَـٰفًۭا","contradiction","ٱللَّهِ لَوَجَدُوا۟ فِيهِ","كَثِيرًۭا",1127],["4:157:19",103,"ٱخْتَلَفُوا۟","differ","لَهُمْ ۚ وَإِنَّ ٱلَّذِينَ","فِيهِ لَفِى شَكٍّۢ",336],["5:33:20",113,"خِلَـٰفٍ","opposite sides","أَيْدِيهِمْ وَأَرْجُلُهُم مِّنْ","أَوْ يُنفَوْا۟ مِنَ",1248],["5:48:51",116,"تَخْتَلِفُونَ","differing","بِمَا كُنتُمْ فِيهِ","",336],["6:133:8",145,"وَيَسْتَخْلِفْ","and grant succession","إِن يَشَأْ يُذْهِبْكُمْ","مِنۢ بَعْدِكُم مَّا",1448],["6:141:10",146,"مُخْتَلِفًا","diverse","مَعْرُوشَـٰتٍۢ وَٱلنَّخْلَ وَٱلزَّرْعَ","أُكُلُهُۥ وَٱلزَّيْتُونَ وَٱلرُّمَّانَ",852],["6:164:29",150,"تَخْتَلِفُونَ","differing","بِمَا كُنتُمْ فِيهِ","",336],["6:165:4",150,"خَلَـٰٓئِفَ","successors","وَهُوَ ٱلَّذِى جَعَلَكُمْ","ٱلْأَرْضِ وَرَفَعَ بَعْضَكُمْ",933],["7:17:7",152,"خَلْفِهِمْ","behind them","بَيْنِ أَيْدِيهِمْ وَمِنْ","وَعَنْ أَيْمَـٰنِهِمْ وَعَن",479],["7:69:14",159,"خُلَفَآءَ","successors","وَٱذْكُرُوٓا۟ إِذْ جَعَلَكُمْ","مِنۢ بَعْدِ قَوْمِ",933],["7:74:4",160,"خُلَفَآءَ","successors","وَٱذْكُرُوٓا۟ إِذْ جَعَلَكُمْ","مِنۢ بَعْدِ عَادٍۢ",933],["7:124:5",165,"خِلَـٰفٍۢ","opposite (sides)","أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ","ثُمَّ لَأُصَلِّبَنَّكُمْ أَجْمَعِينَ",1248],["7:129:17",165,"وَيَسْتَخْلِفَكُمْ","and make you successors","أَن يُهْلِكَ عَدُوَّكُمْ","فِى ٱلْأَرْضِ فَيَنظُرَ",1448],["7:142:16",167,"ٱخْلُفْنِى","Take my place","مُوسَىٰ لِأَخِيهِ هَـٰرُونَ","فِى قَوْمِى وَأَصْلِحْ",1419],["7:150:10",169,"خَلَفْتُمُونِى","you have done in my place","أَسِفًۭا قَالَ بِئْسَمَا","مِنۢ بَعْدِىٓ ۖ أَعَجِلْتُمْ",1419],["7:169:1",172,"فَخَلَفَ","Then succeeded","","مِنۢ بَعْدِهِمْ خَلْفٌۭ",1419],["7:169:4",172,"خَلْفٌۭ","successors","فَخَلَفَ مِنۢ بَعْدِهِمْ","وَرِثُوا۟ ٱلْكِتَـٰبَ يَأْخُذُونَ",479],["8:42:13",182,"لَٱخْتَلَفْتُمْ","certainly you would have failed","مِنكُمْ ۚ وَلَوْ تَوَاعَدتُّمْ","فِى ٱلْمِيعَـٰدِ ۙ وَلَـٰكِن",336],["8:57:8",184,"خَلْفَهُمْ","(are) behind them","فَشَرِّدْ بِهِم مَّنْ","لَعَلَّهُمْ يَذَّكَّرُونَ",479],["9:77:9",199,"أَخْلَفُوا۟","they broke","يَوْمِ يَلْقَوْنَهُۥ بِمَآ","ٱللَّهَ مَا وَعَدُوهُ",650],["9:81:2",200,"ٱلْمُخَلَّفُونَ","those who remained behind","فَرِحَ","بِمَقْعَدِهِمْ خِلَـٰفَ رَسُولِ",1595],["9:81:4",200,"خِلَـٰفَ","behind","فَرِحَ ٱلْمُخَلَّفُونَ بِمَقْعَدِهِمْ","رَسُولِ ٱللَّهِ وَكَرِهُوٓا۟",1248],["9:83:25",200,"ٱلْخَـٰلِفِينَ","those who stay behind","مَرَّةٍۢ فَٱقْعُدُوا۟ مَعَ","",4566],["9:87:5",201,"ٱلْخَوَالِفِ","those who stay behind","بِأَن يَكُونُوا۟ مَعَ","وَطُبِعَ عَلَىٰ قُلُوبِهِمْ",2741],["9:93:12",201,"ٱلْخَوَالِفِ","those who stay behind","بِأَن يَكُونُوا۟ مَعَ","وَطَبَعَ ٱللَّهُ عَلَىٰ",2741],["9:118:4",206,"خُلِّفُوا۟","were left behind","وَعَلَى ٱلثَّلَـٰثَةِ ٱلَّذِينَ","حَتَّىٰٓ إِذَا ضَاقَتْ",4593],["9:120:10",206,"يَتَخَلَّفُوا۟","they remain behind","مِّنَ ٱلْأَعْرَابِ أَن","عَن رَّسُولِ ٱللَّهِ",4690],["10:6:3",208,"ٱخْتِلَـٰفِ","(the) alternation","إِنَّ فِى","ٱلَّيْلِ وَٱلنَّهَارِ وَمَا",1127],["10:14:3",209,"خَلَـٰٓئِفَ","successors","ثُمَّ جَعَلْنَـٰكُمْ","فِى ٱلْأَرْضِ مِنۢ",933],["10:19:7",210,"فَٱخْتَلَفُوا۟ ۚ","then they differed","إِلَّآ أُمَّةًۭ وَٰحِدَةًۭ","وَلَوْلَا كَلِمَةٌۭ سَبَقَتْ",336],["10:19:17",210,"يَخْتَلِفُونَ","they differ","بَيْنَهُمْ فِيمَا فِيهِ","",336],["10:73:8",217,"خَلَـٰٓئِفَ","successors","فِى ٱلْفُلْكِ وَجَعَلْنَـٰهُمْ","وَأَغْرَقْنَا ٱلَّذِينَ كَذَّبُوا۟",933],["10:92:6",219,"خَلْفَكَ","succeed you","بِبَدَنِكَ لِتَكُونَ لِمَنْ","ءَايَةًۭ ۚ وَإِنَّ كَثِيرًۭا",479],["10:93:11",219,"ٱخْتَلَفُوا۟","they differ","مِّنَ ٱلطَّيِّبَـٰتِ فَمَا","حَتَّىٰ جَآءَهُمُ ٱلْعِلْمُ ۚ",336],["10:93:24",219,"يَخْتَلِفُونَ","differ","فِيمَا كَانُوا۟ فِيهِ","",336],["11:57:9",228,"وَيَسْتَخْلِفُ","And my Lord will give succession","أُرْسِلْتُ بِهِۦٓ إِلَيْكُمْ ۚ","رَبِّى قَوْمًا غَيْرَكُمْ",1448],["11:88:17",231,"أُخَالِفَكُمْ","I differ from you","وَمَآ أُرِيدُ أَنْ","إِلَىٰ مَآ أَنْهَىٰكُمْ",2816],["11:110:5",234,"فَٱخْتُلِفَ","but differences arose","ءَاتَيْنَا مُوسَى ٱلْكِتَـٰبَ","فِيهِ ۚ وَلَوْلَا كَلِمَةٌۭ",336],["11:118:10",235,"مُخْتَلِفِينَ","to differ","وَٰحِدَةًۭ ۖ وَلَا يَزَالُونَ","",852],["13:11:7",250,"خَلْفِهِۦ","and behind him","بَيْنِ يَدَيْهِ وَمِنْ","يَحْفَظُونَهُۥ مِنْ أَمْرِ",479],["13:31:50",253,"يُخْلِفُ","fail","إِنَّ ٱللَّهَ لَا","ٱلْمِيعَادَ",650],["14:22:12",258,"فَأَخْلَفْتُكُمْ ۖ","but I betrayed you","وَعْدَ ٱلْحَقِّ وَوَعَدتُّكُمْ","وَمَا كَانَ لِىَ",650],["14:47:4",261,"مُخْلِفَ","will fail","فَلَا تَحْسَبَنَّ ٱللَّهَ","وَعْدِهِۦ رُسُلَهُۥٓ ۗ إِنَّ",3893],["16:13:6",268,"مُخْتَلِفًا","(of) varying","لَكُمْ فِى ٱلْأَرْضِ","أَلْوَٰنُهُۥٓ ۗ إِنَّ فِى",852],["16:39:4",271,"يَخْتَلِفُونَ","they differ","لِيُبَيِّنَ لَهُمُ ٱلَّذِى","فِيهِ وَلِيَعْلَمَ ٱلَّذِينَ",336],["16:64:9",273,"ٱخْتَلَفُوا۟","they differed","لِتُبَيِّنَ لَهُمُ ٱلَّذِى","فِيهِ ۙ وَهُدًۭى وَرَحْمَةًۭ",336],["16:69:14",274,"مُّخْتَلِفٌ","(of) varying","مِنۢ بُطُونِهَا شَرَابٌۭ","أَلْوَٰنُهُۥ فِيهِ شِفَآءٌۭ",852],["16:92:32",277,"تَخْتَلِفُونَ","differ","مَا كُنتُمْ فِيهِ","",336],["16:124:6",281,"ٱخْتَلَفُوا۟","differed","ٱلسَّبْتُ عَلَى ٱلَّذِينَ","فِيهِ ۚ وَإِنَّ رَبَّكَ",336],["16:124:17",281,"يَخْتَلِفُونَ","differ","فِيمَا كَانُوا۟ فِيهِ","",336],["17:76:11",290,"خِلَـٰفَكَ","after you","وَإِذًۭا لَّا يَلْبَثُونَ","إِلَّا قَلِيلًۭا",1248],["19:37:1",307,"فَٱخْتَلَفَ","But differed","","ٱلْأَحْزَابُ مِنۢ بَيْنِهِمْ ۖ",336],["19:59:1",309,"۞ فَخَلَفَ","Then succeeded","","مِنۢ بَعْدِهِمْ خَلْفٌ",1419],["19:59:4",309,"خَلْفٌ","successors","۞ فَخَلَفَ مِنۢ بَعْدِهِمْ","أَضَاعُوا۟ ٱلصَّلَوٰةَ وَٱتَّبَعُوا۟",479],["19:64:11",309,"خَلْفَنَا","(is) behind us","بَيْنَ أَيْدِينَا وَمَا","وَمَا بَيْنَ ذَٰلِكَ ۚ",479],["20:58:9",315,"نُخْلِفُهُۥ","we will fail it","وَبَيْنَكَ مَوْعِدًۭا لَّا","نَحْنُ وَلَآ أَنتَ",650],["20:71:17",316,"خِلَـٰفٍۢ","opposite sides","أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ","وَلَأُصَلِّبَنَّكُمْ فِى جُذُوعِ",1248],["20:86:25",317,"فَأَخْلَفْتُم","so you broke","غَضَبٌۭ مِّن رَّبِّكُمْ","مَّوْعِدِى",650],["20:87:3",317,"أَخْلَفْنَا","we broke","قَالُوا۟ مَآ","مَوْعِدَكَ بِمَلْكِنَا وَلَـٰكِنَّا",650],["20:97:15",318,"تُخْلَفَهُۥ ۖ","you will fail to (keep) it","لَكَ مَوْعِدًۭا لَّن","وَٱنظُرْ إِلَىٰٓ إِلَـٰهِكَ",650],["20:110:6",319,"خَلْفَهُمْ","(is) behind them","بَيْنَ أَيْدِيهِمْ وَمَا","وَلَا يُحِيطُونَ بِهِۦ",479],["21:28:6",324,"خَلْفَهُمْ","(is) behind them","بَيْنَ أَيْدِيهِمْ وَمَا","وَلَا يَشْفَعُونَ إِلَّا",479],["22:47:4",338,"يُخْلِفَ","fail/violate","وَيَسْتَعْجِلُونَكَ بِٱلْعَذَابِ وَلَن","ٱللَّهُ وَعْدَهُۥ ۚ وَإِنَّ",650],["22:69:9",340,"تَخْتَلِفُونَ","differ","فِيمَا كُنتُمْ فِيهِ","",336],["22:76:6",341,"خَلْفَهُمْ ۗ","(is) after them","بَيْنَ أَيْدِيهِمْ وَمَا","وَإِلَى ٱللَّهِ تُرْجَعُ",479],["23:80:6",347,"ٱخْتِلَـٰفُ","(is the) alternation","يُحْىِۦ وَيُمِيتُ وَلَهُ","ٱلَّيْلِ وَٱلنَّهَارِ ۚ أَفَلَا",1127],["24:55:8",357,"لَيَسْتَخْلِفَنَّهُمْ","surely He will grant them succession","مِنكُمْ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","فِى ٱلْأَرْضِ كَمَا",1448],["24:55:12",357,"ٱسْتَخْلَفَ","He gave succession","فِى ٱلْأَرْضِ كَمَا","ٱلَّذِينَ مِن قَبْلِهِمْ",1448],["24:63:18",359,"يُخَالِفُونَ","oppose","لِوَاذًۭا ۚ فَلْيَحْذَرِ ٱلَّذِينَ","عَنْ أَمْرِهِۦٓ أَن",2816],["25:62:6",365,"خِلْفَةًۭ","(in) succession","جَعَلَ ٱلَّيْلَ وَٱلنَّهَارَ","لِّمَنْ أَرَادَ أَن",4583],["26:49:19",369,"خِلَـٰفٍۢ","opposite sides","أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ","وَلَأُصَلِّبَنَّكُمْ أَجْمَعِينَ",1248],["27:62:9",382,"خُلَفَآءَ","inheritors","وَيَكْشِفُ ٱلسُّوٓءَ وَيَجْعَلُكُمْ","ٱلْأَرْضِ ۗ أَءِلَـٰهٌۭ مَّعَ",933],["27:76:12",383,"يَخْتَلِفُونَ","differ","ٱلَّذِى هُمْ فِيهِ","",336],["30:6:4",405,"يُخْلِفُ","fail","وَعْدَ ٱللَّهِ ۖ لَا","ٱللَّهُ وَعْدَهُۥ وَلَـٰكِنَّ",650],["30:22:6",406,"وَٱخْتِلَـٰفُ","and the diversity","خَلْقُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","أَلْسِنَتِكُمْ وَأَلْوَٰنِكُمْ ۚ إِنَّ",1127],["32:25:11",417,"يَخْتَلِفُونَ","differ","فِيمَا كَانُوا۟ فِيهِ","",336],["34:9:8",429,"خَلْفَهُم","(is) behind them","بَيْنَ أَيْدِيهِمْ وَمَا","مِّنَ ٱلسَّمَآءِ وَٱلْأَرْضِ ۚ",479],["34:39:17",432,"يُخْلِفُهُۥ ۖ","will compensate it","مِّن شَىْءٍۢ فَهُوَ","وَهُوَ خَيْرُ ٱلرَّٰزِقِينَ",650],["35:27:12",437,"مُّخْتَلِفًا","(of) various","فَأَخْرَجْنَا بِهِۦ ثَمَرَٰتٍۢ","أَلْوَٰنُهَا ۚ وَمِنَ ٱلْجِبَالِ",852],["35:27:19",437,"مُّخْتَلِفٌ","(of) various","جُدَدٌۢ بِيضٌۭ وَحُمْرٌۭ","أَلْوَٰنُهَا وَغَرَابِيبُ سُودٌۭ",852],["35:28:5",437,"مُخْتَلِفٌ","(are) various","ٱلنَّاسِ وَٱلدَّوَآبِّ وَٱلْأَنْعَـٰمِ","أَلْوَٰنُهُۥ كَذَٰلِكَ ۗ إِنَّمَا",852],["35:39:4",439,"خَلَـٰٓئِفَ","successors","هُوَ ٱلَّذِى جَعَلَكُمْ","فِى ٱلْأَرْضِ ۚ فَمَن",933],["36:9:7",440,"خَلْفِهِمْ","behind them","أَيْدِيهِمْ سَدًّۭا وَمِنْ","سَدًّۭا فَأَغْشَيْنَـٰهُمْ فَهُمْ",479],["36:45:9",443,"خَلْفَكُمْ","(is) behind you","بَيْنَ أَيْدِيكُمْ وَمَا","لَعَلَّكُمْ تُرْحَمُونَ",479],["38:26:4",454,"خَلِيفَةًۭ","a vicegerent","يَـٰدَاوُۥدُ إِنَّا جَعَلْنَـٰكَ","فِى ٱلْأَرْضِ فَٱحْكُم",933],["39:3:25",458,"يَخْتَلِفُونَ ۗ","differ","مَا هُمْ فِيهِ","إِنَّ ٱللَّهَ لَا",336],["39:20:18",460,"يُخْلِفُ","Allah fails","وَعْدَ ٱللَّهِ ۖ لَا","ٱللَّهُ ٱلْمِيعَادَ",650],["39:21:17",460,"مُّخْتَلِفًا","(of) different","يُخْرِجُ بِهِۦ زَرْعًۭا","أَلْوَٰنُهُۥ ثُمَّ يَهِيجُ",852],["39:46:17",463,"يَخْتَلِفُونَ","differ","مَا كَانُوا۟ فِيهِ","",336],["41:14:8",478,"خَلْفِهِمْ","behind them","بَيْنِ أَيْدِيهِمْ وَمِنْ","أَلَّا تَعْبُدُوٓا۟ إِلَّا",479],["41:25:10",479,"خَلْفَهُمْ","(was) behind them","بَيْنَ أَيْدِيهِمْ وَمَا","وَحَقَّ عَلَيْهِمُ ٱلْقَوْلُ",479],["41:42:9",481,"خَلْفِهِۦ ۖ","behind it","يَدَيْهِ وَلَا مِنْ","تَنزِيلٌۭ مِّنْ حَكِيمٍ",479],["41:45:5",481,"فَٱخْتُلِفَ","but disputes arose","ءَاتَيْنَا مُوسَى ٱلْكِتَـٰبَ","فِيهِ ۗ وَلَوْلَا كَلِمَةٌۭ",336],["42:10:2",483,"ٱخْتَلَفْتُمْ","you differ","وَمَا","فِيهِ مِن شَىْءٍۢ",336],["43:60:8",493,"يَخْلُفُونَ","succeeding","مَّلَـٰٓئِكَةًۭ فِى ٱلْأَرْضِ","",1419],["43:63:13",494,"تَخْتَلِفُونَ","you differ","لَكُم بَعْضَ ٱلَّذِى","فِيهِ ۖ فَٱتَّقُوا۟ ٱللَّهَ",336],["43:65:1",494,"فَٱخْتَلَفَ","But differed","","ٱلْأَحْزَابُ مِنۢ بَيْنِهِمْ ۖ",336],["45:5:1",499,"وَٱخْتِلَـٰفِ","And (in the) alternation","","ٱلَّيْلِ وَٱلنَّهَارِ وَمَآ",1127],["45:17:6",500,"ٱخْتَلَفُوٓا۟","they differed","مِّنَ ٱلْأَمْرِ ۖ فَمَا","إِلَّا مِنۢ بَعْدِ",336],["45:17:24",500,"يَخْتَلِفُونَ","differ","فِيمَا كَانُوا۟ فِيهِ","",336],["46:21:15",505,"خَلْفِهِۦٓ","and after him","بَيْنِ يَدَيْهِ وَمِنْ","أَلَّا تَعْبُدُوٓا۟ إِلَّا",479],["48:11:3",512,"ٱلْمُخَلَّفُونَ","those who remained behind","سَيَقُولُ لَكَ","مِنَ ٱلْأَعْرَابِ شَغَلَتْنَآ",1595],["48:15:2",512,"ٱلْمُخَلَّفُونَ","those who remained behind","سَيَقُولُ","إِذَا ٱنطَلَقْتُمْ إِلَىٰ",1595],["48:16:2",513,"لِّلْمُخَلَّفِينَ","to those who remained behind","قُل","مِنَ ٱلْأَعْرَابِ سَتُدْعَوْنَ",1595],["51:8:4",521,"مُّخْتَلِفٍۢ","differing","إِنَّكُمْ لَفِى قَوْلٍۢ","",852],["57:7:7",538,"مُّسْتَخْلَفِينَ","trustees","وَأَنفِقُوا۟ مِمَّا جَعَلَكُم","فِيهِ ۖ فَٱلَّذِينَ ءَامَنُوا۟",3995],["72:27:12",573,"خَلْفِهِۦ","behind him","بَيْنِ يَدَيْهِ وَمِنْ","رَصَدًۭا",479],["78:3:4",582,"مُخْتَلِفُونَ","(in) disagreement","ٱلَّذِى هُمْ فِيهِ","",852]]