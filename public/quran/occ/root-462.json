[["2:18:1",4,"صُمٌّۢ","Deaf","","بُكْمٌ عُمْىٌۭ فَهُمْ",711],["2:171:13",26,"صُمٌّۢ","deaf","إِلَّا دُعَآءًۭ وَنِدَآءًۭ ۚ","بُكْمٌ عُمْىٌۭ فَهُمْ",711],["5:71:6",120,"وَصَمُّوا۟","and they became deaf","تَكُونَ فِتْنَةٌۭ فَعَمُوا۟","ثُمَّ تَابَ ٱللَّهُ",2296],["5:71:13",120,"وَصَمُّوا۟","and they became deaf","عَلَيْهِمْ ثُمَّ عَمُوا۟","كَثِيرٌۭ مِّنْهُمْ ۚ وَٱللَّهُ",2296],["6:39:4",132,"صُمٌّۭ","(are) deaf","وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا","وَبُكْمٌۭ فِى ٱلظُّلُمَـٰتِ ۗ",711],["8:22:6",179,"ٱلصُّمُّ","(are) the deaf","ٱلدَّوَآبِّ عِندَ ٱللَّهِ","ٱلْبُكْمُ ٱلَّذِينَ لَا",711],["10:42:7",213,"ٱلصُّمَّ","cause the deaf to hear","إِلَيْكَ ۚ أَفَأَنتَ تُسْمِعُ","وَلَوْ كَانُوا۟ لَا",711],["11:24:4",224,"وَٱلْأَصَمِّ","and the deaf","۞ مَثَلُ ٱلْفَرِيقَيْنِ كَٱلْأَعْمَىٰ","وَٱلْبَصِيرِ وَٱلسَّمِيعِ ۚ هَلْ",711],["17:97:21",292,"وَصُمًّۭا ۖ","and deaf","وُجُوهِهِمْ عُمْيًۭا وَبُكْمًۭا","مَّأْوَىٰهُمْ جَهَنَّمُ ۖ كُلَّمَا",711],["21:45:7",326,"ٱلصُّمُّ","the deaf","بِٱلْوَحْىِ ۚ وَلَا يَسْمَعُ","ٱلدُّعَآءَ إِذَا مَا",711],["25:73:9",366,"صُمًّۭا","deaf","لَمْ يَخِرُّوا۟ عَلَيْهَا","وَعُمْيَانًۭا",711],["27:80:7",384,"ٱلصُّمَّ","the deaf","ٱلْمَوْتَىٰ وَلَا تُسْمِعُ","ٱلدُّعَآءَ إِذَا وَلَّوْا۟",711],["30:52:7",410,"ٱلصُّمَّ","make the deaf hear","ٱلْمَوْتَىٰ وَلَا تُسْمِعُ","ٱلدُّعَآءَ إِذَا وَلَّوْا۟",711],["43:40:3",492,"ٱلصُّمَّ","the deaf","أَفَأَنتَ تُسْمِعُ","أَوْ تَهْدِى ٱلْعُمْىَ",711],["47:23:5",509,"فَأَصَمَّهُمْ","so He made them deaf","ٱلَّذِينَ لَعَنَهُمُ ٱللَّهُ","وَأَعْمَىٰٓ أَبْصَـٰرَهُمْ",2965]]