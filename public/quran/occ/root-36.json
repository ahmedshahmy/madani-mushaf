],["63:10:14",555,"أَخَّرْتَنِىٓ","You delay me","فَيَقُولَ رَبِّ لَوْلَآ","إِلَىٰٓ أَجَلٍۢ قَرِيبٍۢ",618],["63:11:2",555,"يُؤَخِّرَ","will (be) delayed","وَلَن","ٱللَّهُ نَفْسًا إِذَا",618],["65:2:24",558,"ٱلْـَٔاخِرِ ۚ","the Last","يُؤْمِنُ بِٱللَّهِ وَٱلْيَوْمِ","وَمَن يَتَّقِ ٱللَّهَ",72],["65:6:32",559,"أُخْرَىٰ","another (women)","تَعَاسَرْتُمْ فَسَتُرْضِعُ لَهُۥٓ","",172],["68:33:4",565,"ٱلْـَٔاخِرَةِ","(of) the Hereafter","كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ","أَكْبَرُ ۚ لَوْ كَانُوا۟",72],["71:4:5",570,"وَيُؤَخِّرْكُمْ","and give you respite","لَكُم مِّن ذُنُوبِكُمْ","إِلَىٰٓ أَجَلٍۢ مُّسَمًّى ۚ",618],["71:4:15",570,"يُؤَخَّرُ ۖ","is delayed","إِذَا جَآءَ لَا","لَوْ كُنتُمْ تَعْلَمُونَ",618],["73:20:36",575,"وَءَاخَرُونَ","and others","سَيَكُونُ مِنكُم مَّرْضَىٰ ۙ","يَضْرِبُونَ فِى ٱلْأَرْضِ",172],["73:20:44",575,"وَءَاخَرُونَ","and others","مِن فَضْلِ ٱللَّهِ ۙ","يُقَـٰتِلُونَ فِى سَبِيلِ",172],["74:37:7",576,"يَتَأَخَّرَ","stay behind","أَن يَتَقَدَّمَ أَوْ","",2003],["74:53:5",577,"ٱلْـَٔاخِرَةَ","the Hereafter","بَل لَّا يَخَافُونَ","",72],["75:13:6",577,"وَأَخَّرَ","and kept back","يَوْمَئِذٍۭ بِمَا قَدَّمَ","",618],["75:21:2",578,"ٱلْـَٔاخِرَةَ","the Hereafter","وَتَذَرُونَ","",72],["77:17:3",580,"ٱلْـَٔاخِرِينَ","(with) the later ones","ثُمَّ نُتْبِعُهُمُ","",72],["79:25:4",584,"ٱلْـَٔاخِرَةِ","(for) the last","فَأَخَذَهُ ٱللَّهُ نَكَالَ","وَٱلْأُولَىٰٓ",72],["82:5:5",587,"وَأَخَّرَتْ","and left behind","نَفْسٌۭ مَّا قَدَّمَتْ","",618],["87:17:1",592,"وَٱلْـَٔاخِرَةُ","While the Hereafter","","خَيْرٌۭ وَأَبْقَىٰٓ",72],["92:13:3",596,"لَلْـَٔاخِرَةَ","(is) the Hereafter","وَإِنَّ لَنَا","وَٱلْأُولَىٰ",72],["93:4:1",596,"وَلَلْـَٔاخِرَةُ","And surely the Hereafter","","خَيْرٌۭ لَّكَ مِنَ",72]]