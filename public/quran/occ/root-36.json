[["2:4:10",2,"وَبِٱلْـَٔاخِرَةِ","and in the Hereafter","أُنزِلَ مِن قَبْلِكَ","هُمْ يُوقِنُونَ",72],["2:8:8",3,"ٱلْـَٔاخِرِ","[the] Last","ءَامَنَّا بِٱللَّهِ وَبِٱلْيَوْمِ","وَمَا هُم بِمُؤْمِنِينَ",72],["2:62:12",10,"ٱلْـَٔاخِرِ","[the] Last","ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ","وَعَمِلَ صَـٰلِحًۭا فَلَهُمْ",72],["2:86:6",13,"بِٱلْـَٔاخِرَةِ ۖ","for the Hereafter","ٱشْتَرَوُا۟ ٱلْحَيَوٰةَ ٱلدُّنْيَا","فَلَا يُخَفَّفُ عَنْهُمُ",72],["2:94:6",15,"ٱلْـَٔاخِرَةُ","(of) the Hereafter","كَانَتْ لَكُمُ ٱلدَّارُ","عِندَ ٱللَّهِ خَالِصَةًۭ",72],["2:102:64",16,"ٱلْـَٔاخِرَةِ","the Hereafter","مَا لَهُۥ فِى","مِنْ خَلَـٰقٍۢ ۚ وَلَبِئْسَ",72],["2:114:28",18,"ٱلْـَٔاخِرَةِ","the Hereafter","خِزْىٌۭ وَلَهُمْ فِى","عَذَابٌ عَظِيمٌۭ",72],["2:126:18",19,"ٱلْـَٔاخِرِ ۖ","the Last","مِنْهُم بِٱللَّهِ وَٱلْيَوْمِ","قَالَ وَمَن كَفَرَ",72],["2:130:16",20,"ٱلْـَٔاخِرَةِ","the Hereafter","ٱلدُّنْيَا ۖ وَإِنَّهُۥ فِى","لَمِنَ ٱلصَّـٰلِحِينَ",72],["2:177:15",27,"ٱلْـَٔاخِرِ","[the] Last","ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ","وَٱلْمَلَـٰٓئِكَةِ وَٱلْكِتَـٰبِ وَٱلنَّبِيِّـۧنَ",72],["2:184:13",28,"أُخَرَ ۚ","other","فَعِدَّةٌۭ مِّنْ أَيَّامٍ","وَعَلَى ٱلَّذِينَ يُطِيقُونَهُۥ",172],["2:185:27",28,"أُخَرَ ۗ","other","فَعِدَّةٌۭ مِّنْ أَيَّامٍ","يُرِيدُ ٱللَّهُ بِكُمُ",172],["2:200:22",31,"ٱلْـَٔاخِرَةِ","the Hereafter","وَمَا لَهُۥ فِى","مِنْ خَلَـٰقٍۢ",72],["2:201:10",31,"ٱلْـَٔاخِرَةِ","the Hereafter","ٱلدُّنْيَا حَسَنَةًۭ وَفِى","حَسَنَةًۭ وَقِنَا عَذَابَ",72],["2:203:14",32,"تَأَخَّرَ","delays","إِثْمَ عَلَيْهِ وَمَن","فَلَآ إِثْمَ عَلَيْهِ ۚ",2003],["2:217:51",34,"وَٱلْـَٔاخِرَةِ ۖ","and the Hereafter","أَعْمَـٰلُهُمْ فِى ٱلدُّنْيَا","وَأُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ ۖ",72],["2:220:3",35,"وَٱلْـَٔاخِرَةِ ۗ","and the Hereafter","فِى ٱلدُّنْيَا","وَيَسْـَٔلُونَكَ عَنِ ٱلْيَتَـٰمَىٰ ۖ",72],["2:228:21",36,"ٱلْـَٔاخِرِ ۚ","[the] Last","يُؤْمِنَّ بِٱللَّهِ وَٱلْيَوْمِ","وَبُعُولَتُهُنَّ أَحَقُّ بِرَدِّهِنَّ",72],["2:232:24",37,"ٱلْـَٔاخِرِ ۗ","[the] Last","يُؤْمِنُ بِٱللَّهِ وَٱلْيَوْمِ","ذَٰلِكُمْ أَزْكَىٰ لَكُمْ",72],["2:264:18",44,"ٱلْـَٔاخِرِ ۖ","[the] Last","يُؤْمِنُ بِٱللَّهِ وَٱلْيَوْمِ","فَمَثَلُهُۥ كَمَثَلِ صَفْوَانٍ",72],["2:282:71",48,"ٱلْأُخْرَىٰ ۚ","the other","إِحْدَىٰهُمَا فَتُذَكِّرَ إِحْدَىٰهُمَا","وَلَا يَأْبَ ٱلشُّهَدَآءُ",172],["3:7:12",50,"وَأُخَرُ","and others","هُنَّ أُمُّ ٱلْكِتَـٰبِ","مُتَشَـٰبِهَـٰتٌۭ ۖ فَأَمَّا ٱلَّذِينَ",172],["3:13:13",51,"وَأُخْرَىٰ","and another","فِى سَبِيلِ ٱللَّهِ","كَافِرَةٌۭ يَرَوْنَهُم مِّثْلَيْهِمْ",172],["3:22:7",52,"وَٱلْـَٔاخِرَةِ","and (in) the Hereafter","أَعْمَـٰلُهُمْ فِى ٱلدُّنْيَا","وَمَا لَهُم مِّن",72],["3:45:18",55,"وَٱلْـَٔاخِرَةِ","and (in) the Hereafter","وَجِيهًۭا فِى ٱلدُّنْيَا","وَمِنَ ٱلْمُقَرَّبِينَ",72],["3:56:9",57,"وَٱلْـَٔاخِرَةِ","and (in) the Hereafter","شَدِيدًۭا فِى ٱلدُّنْيَا","وَمَا لَهُم مِّن",72],["3:72:15",59,"ءَاخِرَهُۥ","(at) its end","وَجْهَ ٱلنَّهَارِ وَٱكْفُرُوٓا۟","لَعَلَّهُمْ يَرْجِعُونَ",72],["3:77:14",59,"ٱلْـَٔاخِرَةِ","the Hereafter","خَلَـٰقَ لَهُمْ فِى","وَلَا يُكَلِّمُهُمُ ٱللَّهُ",72],["3:85:11",61,"ٱلْـَٔاخِرَةِ","the Hereafter","مِنْهُ وَهُوَ فِى","مِنَ ٱلْخَـٰسِرِينَ",72],["3:114:4",64,"ٱلْـَٔاخِرِ","the Last","يُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ","وَيَأْمُرُونَ بِٱلْمَعْرُوفِ وَيَنْهَوْنَ",72],["3:145:20",68,"ٱلْـَٔاخِرَةِ","(of) the Hereafter","وَمَن يُرِدْ ثَوَابَ","نُؤْتِهِۦ مِنْهَا ۚ وَسَنَجْزِى",72],["3:148:7",68,"ٱلْـَٔاخِرَةِ ۗ","(in) the Hereafter","ٱلدُّنْيَا وَحُسْنَ ثَوَابِ","وَٱللَّهُ يُحِبُّ ٱلْمُحْسِنِينَ",72],["3:152:28",69,"ٱلْـَٔاخِرَةَ ۚ","the Hereafter","وَمِنكُم مَّن يُرِيدُ","ثُمَّ صَرَفَكُمْ عَنْهُمْ",72],["3:153:10",69,"أُخْرَىٰكُمْ","(from) behind you","وَٱلرَّسُولُ يَدْعُوكُمْ فِىٓ","فَأَثَـٰبَكُمْ غَمًّۢا بِغَمٍّۢ",172],["3:176:19",73,"ٱلْـَٔاخِرَةِ ۖ","the Hereafter","لَهُمْ حَظًّۭا فِى","وَلَهُمْ عَذَابٌ عَظِيمٌ",72],["4:38:11",85,"ٱلْـَٔاخِرِ ۗ","the Last","بِٱللَّهِ وَلَا بِٱلْيَوْمِ","وَمَن يَكُنِ ٱلشَّيْطَـٰنُ",72],["4:39:7",85,"ٱلْـَٔاخِرِ","the Last","ءَامَنُوا۟ بِٱللَّهِ وَٱلْيَوْمِ","وَأَنفَقُوا۟ مِمَّا رَزَقَهُمُ",72],["4:59:24",87,"ٱلْـَٔاخِرِ ۚ","[the] Last","تُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ","ذَٰلِكَ خَيْرٌۭ وَأَحْسَنُ",72],["4:74:9",89,"بِٱلْـَٔاخِرَةِ ۚ","for the Hereafter","يَشْرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","وَمَن يُقَـٰتِلْ فِى",72],["4:77:34",90,"أَخَّرْتَنَآ","You postpone (it for) us","عَلَيْنَا ٱلْقِتَالَ لَوْلَآ","إِلَىٰٓ أَجَلٍۢ قَرِيبٍۢ ۗ",618],["4:77:42",90,"وَٱلْـَٔاخِرَةُ","and the Hereafter","مَتَـٰعُ ٱلدُّنْيَا قَلِيلٌۭ","خَيْرٌۭ لِّمَنِ ٱتَّقَىٰ",72],["4:91:2",92,"ءَاخَرِينَ","others","سَتَجِدُونَ","يُرِيدُونَ أَن يَأْمَنُوكُمْ",172],["4:102:20",95,"أُخْرَىٰ","other","وَرَآئِكُمْ وَلْتَأْتِ طَآئِفَةٌ","لَمْ يُصَلُّوا۟ فَلْيُصَلُّوا۟",172],["4:133:7",99,"بِـَٔاخَرِينَ ۚ","others","أَيُّهَا ٱلنَّاسُ وَيَأْتِ","وَكَانَ ٱللَّهُ عَلَىٰ",172],["4:134:10",99,"وَٱلْـَٔاخِرَةِ ۚ","and the Hereafter","ٱللَّهِ ثَوَابُ ٱلدُّنْيَا","وَكَانَ ٱللَّهُ سَمِيعًۢا",72],["4:136:24",100,"ٱلْـَٔاخِرِ","the Last","وَكُتُبِهِۦ وَرُسُلِهِۦ وَٱلْيَوْمِ","فَقَدْ ضَلَّ ضَلَـٰلًۢا",72],["4:162:22",103,"ٱلْـَٔاخِرِ","the Last","وَٱلْمُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ","أُو۟لَـٰٓئِكَ سَنُؤْتِيهِمْ أَجْرًا",72],["5:5:41",107,"ٱلْـَٔاخِرَةِ","the Hereafter","عَمَلُهُۥ وَهُوَ فِى","مِنَ ٱلْخَـٰسِرِينَ",72],["5:27:16",112,"ٱلْـَٔاخَرِ","the other","وَلَمْ يُتَقَبَّلْ مِنَ","قَالَ لَأَقْتُلَنَّكَ ۖ قَالَ",172],["5:33:32",113,"ٱلْـَٔاخِرَةِ","the Hereafter","ٱلدُّنْيَا ۖ وَلَهُمْ فِى","عَذَابٌ عَظِيمٌ",72],["5:41:24",114,"ءَاخَرِينَ","other","لِلْكَذِبِ سَمَّـٰعُونَ لِقَوْمٍ","لَمْ يَأْتُوكَ ۖ يُحَرِّفُونَ",172],["5:41:65",114,"ٱلْـَٔاخِرَةِ","the Hereafter","خِزْىٌۭ ۖ وَلَهُمْ فِى","عَذَابٌ عَظِيمٌۭ",72],["5:69:12",119,"ٱلْـَٔاخِرِ","the Last","ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ","وَعَمِلَ صَـٰلِحًۭا فَلَا",72],["5:106:17",125,"ءَاخَرَانِ","two others","عَدْلٍۢ مِّنكُمْ أَوْ","مِنْ غَيْرِكُمْ إِنْ",172],["5:107:7",125,"فَـَٔاخَرَانِ","then (let) two others","أَنَّهُمَا ٱسْتَحَقَّآ إِثْمًۭا","يَقُومَانِ مَقَامَهُمَا مِنَ",172],["5:114:16",127,"وَءَاخِرِنَا","and last of us","لَنَا عِيدًۭا لِّأَوَّلِنَا","وَءَايَةًۭ مِّنكَ ۖ وَٱرْزُقْنَا",72],["6:6:31",128,"ءَاخَرِينَ","other","مِنۢ بَعْدِهِمْ قَرْنًا","",172],["6:19:25",130,"أُخْرَىٰ ۚ","other","مَعَ ٱللَّهِ ءَالِهَةً","قُل لَّآ أَشْهَدُ ۚ",172],["6:32:8",131,"ٱلْـَٔاخِرَةُ","(of) the Hereafter","لَعِبٌۭ وَلَهْوٌۭ ۖ وَلَلدَّارُ","خَيْرٌۭ لِّلَّذِينَ يَتَّقُونَ ۗ",72],["6:92:16",139,"بِٱلْـَٔاخِرَةِ","in the Hereafter","حَوْلَهَا ۚ وَٱلَّذِينَ يُؤْمِنُونَ","يُؤْمِنُونَ بِهِۦ ۖ وَهُمْ",72],["6:113:7",142,"بِٱلْـَٔاخِرَةِ","in the Hereafter","ٱلَّذِينَ لَا يُؤْمِنُونَ","وَلِيَرْضَوْهُ وَلِيَقْتَرِفُوا۟ مَا",72],["6:133:18",145,"ءَاخَرِينَ","other","مِّن ذُرِّيَّةِ قَوْمٍ","",172],["6:150:24",148,"بِٱلْـَٔاخِرَةِ","in the Hereafter","وَٱلَّذِينَ لَا يُؤْمِنُونَ","وَهُم بِرَبِّهِمْ يَعْدِلُونَ",72],["6:164:20",150,"أُخْرَىٰ ۚ","(of) another","تَزِرُ وَازِرَةٌۭ وِزْرَ","ثُمَّ إِلَىٰ رَبِّكُم",172],["7:34:8",154,"يَسْتَأْخِرُونَ","seek to delay","جَآءَ أَجَلُهُمْ لَا","سَاعَةًۭ ۖ وَلَا يَسْتَقْدِمُونَ",1253],["7:38:25",155,"أُخْرَىٰهُمْ","(the) last of them","فِيهَا جَمِيعًۭا قَالَتْ","لِأُولَىٰهُمْ رَبَّنَا هَـٰٓؤُلَآءِ",172],["7:39:3",155,"لِأُخْرَىٰهُمْ","to (the) last of them","وَقَالَتْ أُولَىٰهُمْ","فَمَا كَانَ لَكُمْ",172],["7:45:9",156,"بِٱلْـَٔاخِرَةِ","concerning the Hereafter","وَيَبْغُونَهَا عِوَجًۭا وَهُم","كَـٰفِرُونَ",72],["7:147:5",168,"ٱلْـَٔاخِرَةِ","(of) the Hereafter","كَذَّبُوا۟ بِـَٔايَـٰتِنَا وَلِقَآءِ","حَبِطَتْ أَعْمَـٰلُهُمْ ۚ هَلْ",72],["7:156:8",170,"ٱلْـَٔاخِرَةِ","the Hereafter","ٱلدُّنْيَا حَسَنَةًۭ وَفِى","إِنَّا هُدْنَآ إِلَيْكَ ۚ",72],["7:169:35",172,"ٱلْـَٔاخِرَةُ","(of) the Hereafter","مَا فِيهِ ۗ وَٱلدَّارُ","خَيْرٌۭ لِّلَّذِينَ يَتَّقُونَ ۗ",72],["8:60:15",184,"وَءَاخَرِينَ","and others","عَدُوَّ ٱللَّهِ وَعَدُوَّكُمْ","مِن دُونِهِمْ لَا",172],["8:67:17",185,"ٱلْـَٔاخِرَةَ ۗ","(for you) the Hereafter","ٱلدُّنْيَا وَٱللَّهُ يُرِيدُ","وَٱللَّهُ عَزِيزٌ حَكِيمٌۭ",72],["9:18:9",189,"ٱلْـَٔاخِرِ","the Last","ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ","وَأَقَامَ ٱلصَّلَوٰةَ وَءَاتَى",72],["9:19:11",189,"ٱلْـَٔاخِرِ","the Last","ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ","وَجَـٰهَدَ فِى سَبِيلِ",72],["9:29:8",191,"ٱلْـَٔاخِرِ","the Last","بِٱللَّهِ وَلَا بِٱلْيَوْمِ","وَلَا يُحَرِّمُونَ مَا",72],["9:38:20",193,"ٱلْـَٔاخِرَةِ ۚ","the Hereafter","بِٱلْحَيَوٰةِ ٱلدُّنْيَا مِنَ","فَمَا مَتَـٰعُ ٱلْحَيَوٰةِ",72],["9:38:26",193,"ٱلْـَٔاخِرَةِ","the hereafter","ٱلْحَيَوٰةِ ٱلدُّنْيَا فِى","إِلَّا قَلِيلٌ",72],["9:44:7",194,"ٱلْـَٔاخِرِ","the Last","يُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ","أَن يُجَـٰهِدُوا۟ بِأَمْوَٰلِهِمْ",72],["9:45:8",194,"ٱلْـَٔاخِرِ","the Last","يُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ","وَٱرْتَابَتْ قُلُوبُهُمْ فَهُمْ",72],["9:69:29",198,"وَٱلْـَٔاخِرَةِ ۖ","and (in) the Hereafter","أَعْمَـٰلُهُمْ فِى ٱلدُّنْيَا","وَأُو۟لَـٰٓئِكَ هُمُ ٱلْخَـٰسِرُونَ",72],["9:74:38",199,"وَٱلْـَٔاخِرَةِ ۚ","and (in) the Hereafter","أَلِيمًۭا فِى ٱلدُّنْيَا","وَمَا لَهُمْ فِى",72],["9:99:7",202,"ٱلْـَٔاخِرِ","the Last","يُؤْمِنُ بِٱللَّهِ وَٱلْيَوْمِ","وَيَتَّخِذُ مَا يُنفِقُ",72],["9:102:1",203,"وَءَاخَرُونَ","And others","","ٱعْتَرَفُوا۟ بِذُنُوبِهِمْ خَلَطُوا۟",172],["9:102:7",203,"وَءَاخَرَ","(with) other","خَلَطُوا۟ عَمَلًۭا صَـٰلِحًۭا","سَيِّئًا عَسَى ٱللَّهُ",172],["9:106:1",203,"وَءَاخَرُونَ","And others","","مُرْجَوْنَ لِأَمْرِ ٱللَّهِ",172],["10:10:8",209,"وَءَاخِرُ","And the last","وَتَحِيَّتُهُمْ فِيهَا سَلَـٰمٌۭ ۚ","دَعْوَىٰهُمْ أَنِ ٱلْحَمْدُ",72],["10:49:19",214,"يَسْتَـْٔخِرُونَ","they remain behind","جَآءَ أَجَلُهُمْ فَلَا","سَاعَةًۭ ۖ وَلَا يَسْتَقْدِمُونَ",1253],["10:64:7",216,"ٱلْـَٔاخِرَةِ ۚ","the Hereafter","ٱلْحَيَوٰةِ ٱلدُّنْيَا وَفِى","لَا تَبْدِيلَ لِكَلِمَـٰتِ",72],["11:8:2",222,"أَخَّرْنَا","We delay","وَلَئِنْ","عَنْهُمُ ٱلْعَذَابَ إِلَىٰٓ",618],["11:16:6",223,"ٱلْـَٔاخِرَةِ","the Hereafter","لَيْسَ لَهُمْ فِى","إِلَّا ٱلنَّارُ ۖ وَحَبِطَ",72],["11:19:9",223,"بِٱلْـَٔاخِرَةِ","in the Hereafter","وَيَبْغُونَهَا عِوَجًۭا وَهُم","هُمْ كَـٰفِرُونَ",72],["11:22:5",224,"ٱلْـَٔاخِرَةِ","the Hereafter","جَرَمَ أَنَّهُمْ فِى","هُمُ ٱلْأَخْسَرُونَ",72],["11:103:8",233,"ٱلْـَٔاخِرَةِ ۚ","(of) the Hereafter","لِّمَنْ خَافَ عَذَابَ","ذَٰلِكَ يَوْمٌۭ مَّجْمُوعٌۭ",72],["11:104:2",233,"نُؤَخِّرُهُۥٓ","We delay it","وَمَا","إِلَّا لِأَجَلٍۢ مَّعْدُودٍۢ",618],["12:36:12",239,"ٱلْـَٔاخَرُ","the other","أَعْصِرُ خَمْرًۭا ۖ وَقَالَ","إِنِّىٓ أَرَىٰنِىٓ أَحْمِلُ",172],["12:37:24",239,"بِٱلْـَٔاخِرَةِ","in the Hereafter","يُؤْمِنُونَ بِٱللَّهِ وَهُم","هُمْ كَـٰفِرُونَ",72],["12:41:9",240,"ٱلْـَٔاخَرُ","the other","رَبَّهُۥ خَمْرًۭا ۖ وَأَمَّا","فَيُصْلَبُ فَتَأْكُلُ ٱلطَّيْرُ",172],["12:43:14",240,"وَأُخَرَ","and others","وَسَبْعَ سُنۢبُلَـٰتٍ خُضْرٍۢ","يَابِسَـٰتٍۢ ۖ يَـٰٓأَيُّهَا ٱلْمَلَأُ",172],["12:46:15",241,"وَأُخَرَ","and other","وَسَبْعِ سُنۢبُلَـٰتٍ خُضْرٍۢ","يَابِسَـٰتٍۢ لَّعَلِّىٓ أَرْجِعُ",172],["12:57:2",242,"ٱلْـَٔاخِرَةِ","(of) the Hereafter","وَلَأَجْرُ","خَيْرٌۭ لِّلَّذِينَ ءَامَنُوا۟",72],["12:101:17",247,"وَٱلْـَٔاخِرَةِ ۖ","and the Hereafter","وَلِىِّۦ فِى ٱلدُّنْيَا","تَوَفَّنِى مُسْلِمًۭا وَأَلْحِقْنِى",72],["12:109:24",248,"ٱلْـَٔاخِرَةِ","(of) the Hereafter","مِن قَبْلِهِمْ ۗ وَلَدَارُ","خَيْرٌۭ لِّلَّذِينَ ٱتَّقَوْا۟ ۗ",72],["13:26:14",252,"ٱلْـَٔاخِرَةِ","the Hereafter","ٱلْحَيَوٰةُ ٱلدُّنْيَا فِى","إِلَّا مَتَـٰعٌۭ",72],["13:34:7",253,"ٱلْـَٔاخِرَةِ","(of) the Hereafter","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ وَلَعَذَابُ","أَشَقُّ ۖ وَمَا لَهُم",72],["14:3:6",255,"ٱلْـَٔاخِرَةِ","the Hereafter","ٱلْحَيَوٰةَ ٱلدُّنْيَا عَلَى","وَيَصُدُّونَ عَن سَبِيلِ",72],["14:10:14",256,"وَيُؤَخِّرَكُمْ","and give you respite","لَكُم مِّن ذُنُوبِكُمْ","إِلَىٰٓ أَجَلٍۢ مُّسَمًّۭى ۚ",618],["14:27:11",259,"ٱلْـَٔاخِرَةِ ۖ","the Hereafter","ٱلْحَيَوٰةِ ٱلدُّنْيَا وَفِى","وَيُضِلُّ ٱللَّهُ ٱلظَّـٰلِمِينَ ۚ",72],["14:42:9",260,"يُؤَخِّرُهُمْ","He gives them respite","يَعْمَلُ ٱلظَّـٰلِمُونَ ۚ إِنَّمَا","لِيَوْمٍۢ تَشْخَصُ فِيهِ",618],["14:44:10",261,"أَخِّرْنَآ","Respite us","ٱلَّذِينَ ظَلَمُوا۟ رَبَّنَآ","إِلَىٰٓ أَجَلٍۢ قَرِيبٍۢ",618],["15:5:7",262,"يَسْتَـْٔخِرُونَ","(can) delay it","أُمَّةٍ أَجَلَهَا وَمَا","",1253],["15:24:7",263,"ٱلْمُسْتَـْٔخِرِينَ","the later ones","مِنكُمْ وَلَقَدْ عَلِمْنَا","",3856],["15:96:6",267,"ءَاخَرَ ۚ","another","مَعَ ٱللَّهِ إِلَـٰهًا","فَسَوْفَ يَعْلَمُونَ",172],["16:22:7",269,"بِٱلْـَٔاخِرَةِ","in the Hereafter","فَٱلَّذِينَ لَا يُؤْمِنُونَ","قُلُوبُهُم مُّنكِرَةٌۭ وَهُم",72],["16:30:16",270,"ٱلْـَٔاخِرَةِ","of the Hereafter","ٱلدُّنْيَا حَسَنَةٌۭ ۚ وَلَدَارُ","خَيْرٌۭ ۚ وَلَنِعْمَ دَارُ",72],["16:41:14",271,"ٱلْـَٔاخِرَةِ","(of) the Hereafter","ٱلدُّنْيَا حَسَنَةًۭ ۖ وَلَأَجْرُ","أَكْبَرُ ۚ لَوْ كَانُوا۟",72],["16:60:4",273,"بِٱلْـَٔاخِرَةِ","in the Hereafter","لِلَّذِينَ لَا يُؤْمِنُونَ","مَثَلُ ٱلسَّوْءِ ۖ وَلِلَّهِ",72],["16:61:12",273,"يُؤَخِّرُهُمْ","He defers them","مِن دَآبَّةٍۢ وَلَـٰكِن","إِلَىٰٓ أَجَلٍۢ مُّسَمًّۭى ۖ",618],["16:61:20",273,"يَسْتَـْٔخِرُونَ","they (will) remain behind","جَآءَ أَجَلُهُمْ لَا","سَاعَةًۭ ۖ وَلَا يَسْتَقْدِمُونَ",1253],["16:107:7",279,"ٱلْـَٔاخِرَةِ","the Hereafter","ٱلْحَيَوٰةَ ٱلدُّنْيَا عَلَى","وَأَنَّ ٱللَّهَ لَا",72],["16:109:5",279,"ٱلْـَٔاخِرَةِ","the Hereafter","جَرَمَ أَنَّهُمْ فِى","هُمُ ٱلْخَـٰسِرُونَ",72],["16:122:7",281,"ٱلْـَٔاخِرَةِ","the Hereafter","حَسَنَةًۭ ۖ وَإِنَّهُۥ فِى","لَمِنَ ٱلصَّـٰلِحِينَ",72],["17:7:11",282,"ٱلْـَٔاخِرَةِ","the last","فَإِذَا جَآءَ وَعْدُ","لِيَسُـۥٓـُٔوا۟ وُجُوهَكُمْ وَلِيَدْخُلُوا۟",72],["17:10:5",283,"بِٱلْـَٔاخِرَةِ","in the Hereafter","ٱلَّذِينَ لَا يُؤْمِنُونَ","أَعْتَدْنَا لَهُمْ عَذَابًا",72],["17:15:15",283,"أُخْرَىٰ ۗ","(of) another","تَزِرُ وَازِرَةٌۭ وِزْرَ","وَمَا كُنَّا مُعَذِّبِينَ",172],["17:19:3",284,"ٱلْـَٔاخِرَةَ","the Hereafter","وَمَنْ أَرَادَ","وَسَعَىٰ لَهَا سَعْيَهَا",72],["17:21:7",284,"وَلَلْـَٔاخِرَةُ","And surely the Hereafter","بَعْضَهُمْ عَلَىٰ بَعْضٍۢ ۚ","أَكْبَرُ دَرَجَـٰتٍۢ وَأَكْبَرُ",72],["17:22:6",284,"ءَاخَرَ","another","مَعَ ٱللَّهِ إِلَـٰهًا","فَتَقْعُدَ مَذْمُومًۭا مَّخْذُولًۭا",172],["17:39:13",286,"ءَاخَرَ","other","مَعَ ٱللَّهِ إِلَـٰهًا","فَتُلْقَىٰ فِى جَهَنَّمَ",172],["17:45:10",286,"بِٱلْـَٔاخِرَةِ","in the Hereafter","ٱلَّذِينَ لَا يُؤْمِنُونَ","حِجَابًۭا مَّسْتُورًۭا",72],["17:62:8",288,"أَخَّرْتَنِ","You give me respite","كَرَّمْتَ عَلَىَّ لَئِنْ","إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ",618],["17:69:7",289,"أُخْرَىٰ","another time","يُعِيدَكُمْ فِيهِ تَارَةً","فَيُرْسِلَ عَلَيْكُمْ قَاصِفًۭا",172],["17:72:8",289,"ٱلْـَٔاخِرَةِ","the Hereafter","أَعْمَىٰ فَهُوَ فِى","أَعْمَىٰ وَأَضَلُّ سَبِيلًۭا",72],["17:104:11",292,"ٱلْـَٔاخِرَةِ","(of) the Hereafter","فَإِذَا جَآءَ وَعْدُ","جِئْنَا بِكُمْ لَفِيفًۭا",72],["20:18:13",313,"أُخْرَىٰ","other","وَلِىَ فِيهَا مَـَٔارِبُ","",172],["20:22:11",313,"أُخْرَىٰ","another","غَيْرِ سُوٓءٍ ءَايَةً","",172],["20:37:5",313,"أُخْرَىٰٓ","another time","مَنَنَّا عَلَيْكَ مَرَّةً","",172],["20:55:8",315,"أُخْرَىٰ","another","وَمِنْهَا نُخْرِجُكُمْ تَارَةً","",172],["20:127:10",321,"ٱلْـَٔاخِرَةِ","(of) the Hereafter","بِـَٔايَـٰتِ رَبِّهِۦ ۚ وَلَعَذَابُ","أَشَدُّ وَأَبْقَىٰٓ",72],["21:11:10",323,"ءَاخَرِينَ","another people","وَأَنشَأْنَا بَعْدَهَا قَوْمًا","",172],["22:11:21",333,"وَٱلْـَٔاخِرَةَ ۚ","and the Hereafter","وَجْهِهِۦ خَسِرَ ٱلدُّنْيَا","ذَٰلِكَ هُوَ ٱلْخُسْرَانُ",72],["22:15:10",333,"وَٱلْـَٔاخِرَةِ","and the Hereafter","ٱللَّهُ فِى ٱلدُّنْيَا","فَلْيَمْدُدْ بِسَبَبٍ إِلَى",72],["23:14:17",342,"ءَاخَرَ ۚ","another","ثُمَّ أَنشَأْنَـٰهُ خَلْقًا","فَتَبَارَكَ ٱللَّهُ أَحْسَنُ",172],["23:31:6",344,"ءَاخَرِينَ","another","مِنۢ بَعْدِهِمْ قَرْنًا","",172],["23:33:9",344,"ٱلْـَٔاخِرَةِ","(of) the Hereafter","كَفَرُوا۟ وَكَذَّبُوا۟ بِلِقَآءِ","وَأَتْرَفْنَـٰهُمْ فِى ٱلْحَيَوٰةِ",72],["23:42:6",344,"ءَاخَرِينَ","another","مِنۢ بَعْدِهِمْ قُرُونًا","",172],["23:43:7",345,"يَسْتَـْٔخِرُونَ","they (can) delay (it)","أُمَّةٍ أَجَلَهَا وَمَا","",1253],["23:74:5",346,"بِٱلْـَٔاخِرَةِ","in the Hereafter","ٱلَّذِينَ لَا يُؤْمِنُونَ","عَنِ ٱلصِّرَٰطِ لَنَـٰكِبُونَ",72],["23:117:6",349,"ءَاخَرَ","other","مَعَ ٱللَّهِ إِلَـٰهًا","لَا بُرْهَـٰنَ لَهُۥ",172],["24:2:21",350,"ٱلْـَٔاخِرِ ۖ","the Last","تُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ","وَلْيَشْهَدْ عَذَابَهُمَا طَآئِفَةٌۭ",72],["24:14:8",351,"وَٱلْـَٔاخِرَةِ","and the Hereafter","وَرَحْمَتُهُۥ فِى ٱلدُّنْيَا","لَمَسَّكُمْ فِى مَآ",72],["24:19:15",351,"وَٱلْـَٔاخِرَةِ ۚ","and the Hereafter","أَلِيمٌۭ فِى ٱلدُّنْيَا","وَٱللَّهُ يَعْلَمُ وَأَنتُمْ",72],["24:23:10",352,"وَٱلْـَٔاخِرَةِ","and the Hereafter","لُعِنُوا۟ فِى ٱلدُّنْيَا","وَلَهُمْ عَذَابٌ عَظِيمٌۭ",72],["25:4:12",360,"ءَاخَرُونَ ۖ","other","وَأَعَانَهُۥ عَلَيْهِ قَوْمٌ","فَقَدْ جَآءُو ظُلْمًۭا",172],["25:68:7",366,"ءَاخَرَ","another","مَعَ ٱللَّهِ إِلَـٰهًا","وَلَا يَقْتُلُونَ ٱلنَّفْسَ",172],["26:64:3",370,"ٱلْـَٔاخَرِينَ","the others","وَأَزْلَفْنَا ثَمَّ","",172],["26:66:3",370,"ٱلْـَٔاخَرِينَ","the others","ثُمَّ أَغْرَقْنَا","",172],["26:84:6",371,"ٱلْـَٔاخِرِينَ","the later (generations)","لِسَانَ صِدْقٍۢ فِى","",72],["26:172:3",374,"ٱلْـَٔاخَرِينَ","the others","ثُمَّ دَمَّرْنَا","",172],["26:213:6",376,"ءَاخَرَ","another","مَعَ ٱللَّهِ إِلَـٰهًا","فَتَكُونَ مِنَ ٱلْمُعَذَّبِينَ",172],["27:3:7",377,"بِٱلْـَٔاخِرَةِ","in the Hereafter","وَيُؤْتُونَ ٱلزَّكَوٰةَ وَهُم","هُمْ يُوقِنُونَ",72],["27:4:5",377,"بِٱلْـَٔاخِرَةِ","in the Hereafter","ٱلَّذِينَ لَا يُؤْمِنُونَ","زَيَّنَّا لَهُمْ أَعْمَـٰلَهُمْ",72],["27:5:8",377,"ٱلْـَٔاخِرَةِ","the Hereafter","ٱلْعَذَابِ وَهُمْ فِى","هُمُ ٱلْأَخْسَرُونَ",72],["27:66:5",383,"ٱلْـَٔاخِرَةِ ۚ","the Hereafter","ٱدَّٰرَكَ عِلْمُهُمْ فِى","بَلْ هُمْ فِى",72],["28:70:11",393,"وَٱلْـَٔاخِرَةِ ۖ","and the last","ٱلْحَمْدُ فِى ٱلْأُولَىٰ","وَلَهُ ٱلْحُكْمُ وَإِلَيْهِ",72],["28:77:6",394,"ٱلْـَٔاخِرَةَ ۖ","(of) the Hereafter","ءَاتَىٰكَ ٱللَّهُ ٱلدَّارَ","وَلَا تَنسَ نَصِيبَكَ",72],["28:83:3",395,"ٱلْـَٔاخِرَةُ","(of) the Hereafter","تِلْكَ ٱلدَّارُ","نَجْعَلُهَا لِلَّذِينَ لَا",72],["28:88:6",396,"ءَاخَرَ ۘ","other","مَعَ ٱللَّهِ إِلَـٰهًا","لَآ إِلَـٰهَ إِلَّا",172],["29:20:13",398,"ٱلْـَٔاخِرَةَ ۚ","the last","ٱللَّهُ يُنشِئُ ٱلنَّشْأَةَ","إِنَّ ٱللَّهَ عَلَىٰ",72],["29:27:16",399,"ٱلْـَٔاخِرَةِ","the Hereafter","ٱلدُّنْيَا ۖ وَإِنَّهُۥ فِى","لَمِنَ ٱلصَّـٰلِحِينَ",72],["29:36:11",400,