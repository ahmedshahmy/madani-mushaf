[["8:42:7",182,"ٱلْقُصْوَىٰ","the farther","ٱلدُّنْيَا وَهُم بِٱلْعُدْوَةِ","وَٱلرَّكْبُ أَسْفَلَ مِنكُمْ ۚ",4143],["17:1:11",282,"ٱلْأَقْصَا","Al-Masjid Al-Aqsa","ٱلْحَرَامِ إِلَى ٱلْمَسْجِدِ","ٱلَّذِى بَـٰرَكْنَا حَوْلَهُۥ",1739],["19:22:5",306,"قَصِيًّۭا","remote","فَٱنتَبَذَتْ بِهِۦ مَكَانًۭا","",4114],["28:20:4",387,"أَقْصَا","(the) farthest end","وَجَآءَ رَجُلٌۭ مِّنْ","ٱلْمَدِينَةِ يَسْعَىٰ قَالَ",1739],["36:20:3",441,"أَقْصَا","(the) farthest end","وَجَآءَ مِنْ","ٱلْمَدِينَةِ رَجُلٌۭ يَسْعَىٰ",1739]]