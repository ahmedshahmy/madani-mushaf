[["2:48:16",7,"عَدْلٌۭ","a compensation","وَلَا يُؤْخَذُ مِنْهَا","وَلَا هُمْ يُنصَرُونَ",654],["2:123:12",19,"عَدْلٌۭ","any compensation","وَلَا يُقْبَلُ مِنْهَا","وَلَا تَنفَعُهَا شَفَـٰعَةٌۭ",654],["2:282:14",48,"بِٱلْعَدْلِ ۚ","in justice","وَلْيَكْتُب بَّيْنَكُمْ كَاتِبٌۢ","وَلَا يَأْبَ كَاتِبٌ",654],["2:282:51",48,"بِٱلْعَدْلِ ۚ","with justice","هُوَ فَلْيُمْلِلْ وَلِيُّهُۥ","وَٱسْتَشْهِدُوا۟ شَهِيدَيْنِ مِن",654],["4:3:19",77,"تَعْدِلُوا۟","you can do justice","فَإِنْ خِفْتُمْ أَلَّا","فَوَٰحِدَةً أَوْ مَا",653],["4:58:15",87,"بِٱلْعَدْلِ ۚ","with justice","ٱلنَّاسِ أَن تَحْكُمُوا۟","إِنَّ ٱللَّهَ نِعِمَّا",654],["4:129:4",99,"تَعْدِلُوا۟","deal justly","وَلَن تَسْتَطِيعُوٓا۟ أَن","بَيْنَ ٱلنِّسَآءِ وَلَوْ",653],["4:135:27",100,"تَعْدِلُوا۟ ۚ","you deviate","تَتَّبِعُوا۟ ٱلْهَوَىٰٓ أَن","وَإِن تَلْوُۥٓا۟ أَوْ",653],["5:8:15",108,"تَعْدِلُوا۟ ۚ","you do justice","قَوْمٍ عَلَىٰٓ أَلَّا","ٱعْدِلُوا۟ هُوَ أَقْرَبُ",653],["5:8:16",108,"ٱعْدِلُوا۟","Be just","عَلَىٰٓ أَلَّا تَعْدِلُوا۟ ۚ","هُوَ أَقْرَبُ لِلتَّقْوَىٰ ۖ",653],["5:95:22",123,"عَدْلٍۢ","just","يَحْكُمُ بِهِۦ ذَوَا","مِّنكُمْ هَدْيًۢا بَـٰلِغَ",654],["5:95:32",123,"عَدْلُ","equivalent","طَعَامُ مَسَـٰكِينَ أَوْ","ذَٰلِكَ صِيَامًۭا لِّيَذُوقَ",654],["5:106:14",125,"عَدْلٍۢ","just","ٱلْوَصِيَّةِ ٱثْنَانِ ذَوَا","مِّنكُمْ أَوْ ءَاخَرَانِ",654],["6:1:14",128,"يَعْدِلُونَ","equate others with Him","ٱلَّذِينَ كَفَرُوا۟ بِرَبِّهِمْ","",653],["6:70:26",136,"تَعْدِلْ","it offers ransom","وَلَا شَفِيعٌۭ وَإِن","كُلَّ عَدْلٍۢ لَّا",653],["6:70:28",136,"عَدْلٍۢ","ransom","وَإِن تَعْدِلْ كُلَّ","لَّا يُؤْخَذْ مِنْهَآ ۗ",654],["6:115:5",142,"وَعَدْلًۭا ۚ","and justice","كَلِمَتُ رَبِّكَ صِدْقًۭا","لَّا مُبَدِّلَ لِكَلِمَـٰتِهِۦ ۚ",654],["6:150:27",148,"يَعْدِلُونَ","set up equals","بِٱلْـَٔاخِرَةِ وَهُم بِرَبِّهِمْ","",653],["6:152:23",149,"فَٱعْدِلُوا۟","then be just","وُسْعَهَا ۖ وَإِذَا قُلْتُمْ","وَلَوْ كَانَ ذَا",653],["7:159:8",170,"يَعْدِلُونَ","establishes justice","يَهْدُونَ بِٱلْحَقِّ وَبِهِۦ","",653],["7:181:7",174,"يَعْدِلُونَ","they establish justice","يَهْدُونَ بِٱلْحَقِّ وَبِهِۦ","",653],["16:76:25",275,"بِٱلْعَدْلِ ۙ","[of] justice","هُوَ وَمَن يَأْمُرُ","وَهُوَ عَلَىٰ صِرَٰطٍۢ",654],["16:90:4",277,"بِٱلْعَدْلِ","justice","۞ إِنَّ ٱللَّهَ يَأْمُرُ","وَٱلْإِحْسَـٰنِ وَإِيتَآئِ ذِى",654],["27:60:27",382,"يَعْدِلُونَ","who ascribe equals","بَلْ هُمْ قَوْمٌۭ","",653],["42:15:17",484,"لِأَعْدِلَ","that I do justice","مِن كِتَـٰبٍۢ ۖ وَأُمِرْتُ","بَيْنَكُمُ ۖ ٱللَّهُ رَبُّنَا",653],["49:9:25",516,"بِٱلْعَدْلِ","with justice","فَآءَتْ فَأَصْلِحُوا۟ بَيْنَهُمَا","وَأَقْسِطُوٓا۟ ۖ إِنَّ ٱللَّهَ",654],["65:2:11",558,"عَدْلٍۢ","just","بِمَعْرُوفٍۢ وَأَشْهِدُوا۟ ذَوَىْ","مِّنكُمْ وَأَقِيمُوا۟ ٱلشَّهَـٰدَةَ",654],["82:7:4",587,"فَعَدَلَكَ","then balanced you","ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ","",653]]