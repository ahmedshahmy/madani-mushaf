[["12:86:3",245,"أَشْكُوا۟","I complain","قَالَ إِنَّمَآ","بَثِّى وَحُزْنِىٓ إِلَى",2944],["24:35:7",354,"كَمِشْكَوٰةٍۢ","(is) like a niche","وَٱلْأَرْضِ ۚ مَثَلُ نُورِهِۦ","فِيهَا مِصْبَاحٌ ۖ ٱلْمِصْبَاحُ",3737],["58:1:9",542,"وَتَشْتَكِىٓ","and she directs her complaint","تُجَـٰدِلُكَ فِى زَوْجِهَا","إِلَى ٱللَّهِ وَٱللَّهُ",4305]]