[["17:13:13",283,"مَنشُورًا","wide open","ٱلْقِيَـٰمَةِ كِتَـٰبًۭا يَلْقَىٰهُ","",2454],["18:16:10",295,"يَنشُرْ","Will spread","فَأْوُۥٓا۟ إِلَى ٱلْكَهْفِ","لَكُمْ رَبُّكُم مِّن",1947],["21:21:7",323,"يُنشِرُونَ","raise (the dead)","مِّنَ ٱلْأَرْضِ هُمْ","",1738],["25:3:22",360,"نُشُورًۭا","resurrection","وَلَا حَيَوٰةًۭ وَلَا","",1379],["25:40:16",363,"نُشُورًۭا","Resurrection","كَانُوا۟ لَا يَرْجُونَ","",1379],["25:47:11",364,"نُشُورًۭا","a resurrection","سُبَاتًۭا وَجَعَلَ ٱلنَّهَارَ","",1379],["30:20:11",406,"تَنتَشِرُونَ","dispersing","إِذَآ أَنتُم بَشَرٌۭ","",2012],["33:53:23",425,"فَٱنتَشِرُوا۟","then disperse","فَٱدْخُلُوا۟ فَإِذَا طَعِمْتُمْ","وَلَا مُسْتَـْٔنِسِينَ لِحَدِيثٍ ۚ",2012],["35:9:17",435,"ٱلنُّشُورُ","(will be) the Resurrection","بَعْدَ مَوْتِهَا ۚ كَذَٰلِكَ","",1379],["42:28:9",486,"وَيَنشُرُ","and spreads","بَعْدِ مَا قَنَطُوا۟","رَحْمَتَهُۥ ۚ وَهُوَ ٱلْوَلِىُّ",1947],["43:11:7",490,"فَأَنشَرْنَا","then We revive","ٱلسَّمَآءِ مَآءًۢ بِقَدَرٍۢ","بِهِۦ بَلْدَةًۭ مَّيْتًۭا ۚ",1738],["44:35:8",497,"بِمُنشَرِينَ","(will be) raised again","ٱلْأُولَىٰ وَمَا نَحْنُ","",3820],["52:3:3",523,"مَّنشُورٍۢ","unrolled","فِى رَقٍّۢ","",2454],["54:7:8",529,"مُّنتَشِرٌۭ","spreading","ٱلْأَجْدَاثِ كَأَنَّهُمْ جَرَادٌۭ","",3977],["62:10:4",554,"فَٱنتَشِرُوا۟","then disperse","فَإِذَا قُضِيَتِ ٱلصَّلَوٰةُ","فِى ٱلْأَرْضِ وَٱبْتَغُوا۟",2012],["67:15:14",563,"ٱلنُّشُورُ","(is) the Resurrection","مِن رِّزْقِهِۦ ۖ وَإِلَيْهِ","",1379],["74:52:9",577,"مُّنَشَّرَةًۭ","spread out","أَن يُؤْتَىٰ صُحُفًۭا","",3972],["77:3:1",580,"وَٱلنَّـٰشِرَٰتِ","And the ones that scatter","","نَشْرًۭا",4084],["77:3:2",580,"نَشْرًۭا","far and wide","وَٱلنَّـٰشِرَٰتِ","",4006],["80:22:4",585,"أَنشَرَهُۥ","He will resurrect him","ثُمَّ إِذَا شَآءَ","",1738],["81:10:3",586,"نُشِرَتْ","are laid open","وَإِذَا ٱلصُّحُفُ","",1947]]