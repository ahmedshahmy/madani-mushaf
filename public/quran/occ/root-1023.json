[["6:99:29",140,"وَٱلرُّمَّانَ","and the pomegranates","مِّنْ أَعْنَابٍۢ وَٱلزَّيْتُونَ","مُشْتَبِهًۭا وَغَيْرَ مُتَشَـٰبِهٍ ۗ",1982],["6:141:13",146,"وَٱلرُّمَّانَ","and the pomegranates","مُخْتَلِفًا أُكُلُهُۥ وَٱلزَّيْتُونَ","مُتَشَـٰبِهًۭا وَغَيْرَ مُتَشَـٰبِهٍۢ ۚ",1982],["55:68:4",533,"وَرُمَّانٌۭ","and pomegranates","فِيهِمَا فَـٰكِهَةٌۭ وَنَخْلٌۭ","",1982]]