[["2:6:4",3,"سَوَآءٌ","(it) is same","إِنَّ ٱلَّذِينَ كَفَرُوا۟","عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ",407],["2:29:10",5,"ٱسْتَوَىٰٓ","He turned","ٱلْأَرْضِ جَمِيعًۭا ثُمَّ","إِلَى ٱلسَّمَآءِ فَسَوَّىٰهُنَّ",335],["2:29:13",5,"فَسَوَّىٰهُنَّ","and fashioned them","ٱسْتَوَىٰٓ إِلَى ٱلسَّمَآءِ","سَبْعَ سَمَـٰوَٰتٍۢ ۚ وَهُوَ",697],["2:108:17",17,"سَوَآءَ","(the) evenness","بِٱلْإِيمَـٰنِ فَقَدْ ضَلَّ","ٱلسَّبِيلِ",407],["3:64:7",58,"سَوَآءٍۭ","equitable","تَعَالَوْا۟ إِلَىٰ كَلِمَةٍۢ","بَيْنَنَا وَبَيْنَكُمْ أَلَّا",407],["3:113:2",64,"سَوَآءًۭ ۗ","(the) same","۞ لَيْسُوا۟","مِّنْ أَهْلِ ٱلْكِتَـٰبِ",407],["4:42:8",85,"تُسَوَّىٰ","was leveled","وَعَصَوُا۟ ٱلرَّسُولَ لَوْ","بِهِمُ ٱلْأَرْضُ وَلَا",4470],["4:89:7",92,"سَوَآءًۭ ۖ","alike","كَمَا كَفَرُوا۟ فَتَكُونُونَ","فَلَا تَتَّخِذُوا۟ مِنْهُمْ",407],["4:95:2",94,"يَسْتَوِى","(are) equal","لَّا","ٱلْقَـٰعِدُونَ مِنَ ٱلْمُؤْمِنِينَ",335],["5:12:44",109,"سَوَآءَ","(from) the way","مِنكُمْ فَقَدْ ضَلَّ","ٱلسَّبِيلِ",407],["5:60:26",118,"سَوَآءِ","(the) even","مَّكَانًۭا وَأَضَلُّ عَن","ٱلسَّبِيلِ",407],["5:77:22",120,"سَوَآءِ","(the) right","كَثِيرًۭا وَضَلُّوا۟ عَن","ٱلسَّبِيلِ",407],["5:100:3",124,"يَسْتَوِى","(are) equal","قُل لَّا","ٱلْخَبِيثُ وَٱلطَّيِّبُ وَلَوْ",335],["6:50:24",133,"يَسْتَوِى","be equal","إِلَىَّ ۚ قُلْ هَلْ","ٱلْأَعْمَىٰ وَٱلْبَصِيرُ ۚ أَفَلَا",335],["7:54:12",157,"ٱسْتَوَىٰ","He ascended","سِتَّةِ أَيَّامٍۢ ثُمَّ","عَلَى ٱلْعَرْشِ يُغْشِى",335],["7:193:7",175,"سَوَآءٌ","(It is) same","ٱلْهُدَىٰ لَا يَتَّبِعُوكُمْ ۚ","عَلَيْكُمْ أَدَعَوْتُمُوهُمْ أَمْ",407],["8:58:9",184,"سَوَآءٍ ۚ","equal (terms)","فَٱنۢبِذْ إِلَيْهِمْ عَلَىٰ","إِنَّ ٱللَّهَ لَا",407],["9:19:17",189,"يَسْتَوُۥنَ","They are not equal","سَبِيلِ ٱللَّهِ ۚ لَا","عِندَ ٱللَّهِ ۗ وَٱللَّهُ",335],["10:3:12",208,"ٱسْتَوَىٰ","He established","سِتَّةِ أَيَّامٍۢ ثُمَّ","عَلَى ٱلْعَرْشِ ۖ يُدَبِّرُ",335],["11:24:8",224,"يَسْتَوِيَانِ","they equal","وَٱلْبَصِيرِ وَٱلسَّمِيعِ ۚ هَلْ","مَثَلًا ۚ أَفَلَا تَذَكَّرُونَ",335],["11:44:11",226,"وَٱسْتَوَتْ","And it rested","ٱلْمَآءُ وَقُضِىَ ٱلْأَمْرُ","عَلَى ٱلْجُودِىِّ ۖ وَقِيلَ",335],["13:2:9",249,"ٱسْتَوَىٰ","He established","عَمَدٍۢ تَرَوْنَهَا ۖ ثُمَّ","عَلَى ٱلْعَرْشِ ۖ وَسَخَّرَ",335],["13:10:1",250,"سَوَآءٌۭ","(It is) same (to Him)","","مِّنكُم مَّنْ أَسَرَّ",407],["13:16:21",251,"يَسْتَوِى","equal","ضَرًّۭا ۚ قُلْ هَلْ","ٱلْأَعْمَىٰ وَٱلْبَصِيرُ أَمْ",335],["13:16:26",251,"تَسْتَوِى","equal","وَٱلْبَصِيرُ أَمْ هَلْ","ٱلظُّلُمَـٰتُ وَٱلنُّورُ ۗ أَمْ",335],["14:21:26",258,"سَوَآءٌ","(It is) same","هَدَىٰنَا ٱللَّهُ لَهَدَيْنَـٰكُمْ ۖ","عَلَيْنَآ أَجَزِعْنَآ أَمْ",407],["15:29:2",263,"سَوَّيْتُهُۥ","I have fashioned him","فَإِذَا","وَنَفَخْتُ فِيهِ مِن",697],["16:71:19",274,"سَوَآءٌ ۚ","equal","أَيْمَـٰنُهُمْ فَهُمْ فِيهِ","أَفَبِنِعْمَةِ ٱللَّهِ يَجْحَدُونَ",407],["16:75:21",275,"يَسْتَوُۥنَ ۚ","they be equal","سِرًّۭا وَجَهْرًا ۖ هَلْ","ٱلْحَمْدُ لِلَّهِ ۚ بَلْ",335],["16:76:21",275,"يَسْتَوِى","equal","يَأْتِ بِخَيْرٍ ۖ هَلْ","هُوَ وَمَن يَأْمُرُ",335],["18:37:15",298,"سَوَّىٰكَ","fashioned you","مِن نُّطْفَةٍۢ ثُمَّ","رَجُلًۭا",697],["18:96:6",303,"سَاوَىٰ","he (had) leveled","ٱلْحَدِيدِ ۖ حَتَّىٰٓ إِذَا","بَيْنَ ٱلصَّدَفَيْنِ قَالَ",4236],["19:10:13",305,"سَوِيًّۭا","sound","ٱلنَّاسَ ثَلَـٰثَ لَيَالٍۢ","",1394],["19:17:11",306,"سَوِيًّۭا","well-proportioned","فَتَمَثَّلَ لَهَا بَشَرًۭا","",1394],["19:43:13",308,"سَوِيًّۭا","even","فَٱتَّبِعْنِىٓ أَهْدِكَ صِرَٰطًۭا","",1394],["20:5:4",312,"ٱسْتَوَىٰ","is established","ٱلرَّحْمَـٰنُ عَلَى ٱلْعَرْشِ","",335],["20:58:14",315,"سُوًۭى","even","وَلَآ أَنتَ مَكَانًۭا","",4284],["20:135:9",321,"ٱلسَّوِىِّ","[the] even","مَنْ أَصْحَـٰبُ ٱلصِّرَٰطِ","وَمَنِ ٱهْتَدَىٰ",1394],["21:109:6",331,"سَوَآءٍۢ ۖ","equally","فَقُلْ ءَاذَنتُكُمْ عَلَىٰ","وَإِنْ أَدْرِىٓ أَقَرِيبٌ",407],["22:25:13",335,"سَوَآءً","equal","ٱلَّذِى جَعَلْنَـٰهُ لِلنَّاسِ","ٱلْعَـٰكِفُ فِيهِ وَٱلْبَادِ ۚ",407],["23:28:2",344,"ٱسْتَوَيْتَ","you (have) boarded","فَإِذَا","أَنتَ وَمَن مَّعَكَ",335],["25:59:11",365,"ٱسْتَوَىٰ","He established Himself","سِتَّةِ أَيَّامٍۢ ثُمَّ","عَلَى ٱلْعَرْشِ ۚ ٱلرَّحْمَـٰنُ",335],["26:98:2",371,"نُسَوِّيكُم","we equated you","إِذْ","بِرَبِّ ٱلْعَـٰلَمِينَ",697],["26:136:2",372,"سَوَآءٌ","(It is) same","قَالُوا۟","عَلَيْنَآ أَوَعَظْتَ أَمْ",407],["28:14:4",387,"وَٱسْتَوَىٰٓ","and became mature","وَلَمَّا بَلَغَ أَشُدَّهُۥ","ءَاتَيْنَـٰهُ حُكْمًۭا وَعِلْمًۭا ۚ",335],["28:22:10",388,"سَوَآءَ","(to the) sound","رَبِّىٓ أَن يَهْدِيَنِى","ٱلسَّبِيلِ",407],["30:28:19",407,"سَوَآءٌۭ","(are) equal","رَزَقْنَـٰكُمْ فَأَنتُمْ فِيهِ","تَخَافُونَهُمْ كَخِيفَتِكُمْ أَنفُسَكُمْ ۚ",407],["32:4:12",415,"ٱسْتَوَىٰ","established Himself","سِتَّةِ أَيَّامٍۢ ثُمَّ","عَلَى ٱلْعَرْشِ ۖ مَا",335],["32:9:2",415,"سَوَّىٰهُ","He fashioned him","ثُمَّ","وَنَفَخَ فِيهِ مِن",697],["32:18:8",416,"يَسْتَوُۥنَ","they are equal","كَانَ فَاسِقًۭا ۚ لَّا","",335],["35:12:2",436,"يَسْتَوِى","are alike","وَمَا","ٱلْبَحْرَانِ هَـٰذَا عَذْبٌۭ",335],["35:19:2",437,"يَسْتَوِى","equal","وَمَا","ٱلْأَعْمَىٰ وَٱلْبَصِيرُ",335],["35:22:2",437,"يَسْتَوِى","equal","وَمَا","ٱلْأَحْيَآءُ وَلَا ٱلْأَمْوَٰتُ ۚ",335],["36:10:1",440,"وَسَوَآءٌ","And it (is) same","","عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ",407],["37:55:4",448,"سَوَآءِ","(the) midst","فَٱطَّلَعَ فَرَءَاهُ فِى","ٱلْجَحِيمِ",407],["38:22:22",454,"سَوَآءِ","an even","تُشْطِطْ وَٱهْدِنَآ إِلَىٰ","ٱلصِّرَٰطِ",407],["38:72:2",457,"سَوَّيْتُهُۥ","I have proportioned him","فَإِذَا","وَنَفَخْتُ فِيهِ مِن",697],["39:9:15",459,"يَسْتَوِى","equal","رَبِّهِۦ ۗ قُلْ هَلْ","ٱلَّذِينَ يَعْلَمُونَ وَٱلَّذِينَ",335],["39:29:12",461,"يَسْتَوِيَانِ","they both equal","سَلَمًۭا لِّرَجُلٍ هَلْ","مَثَلًا ۚ ٱلْحَمْدُ لِلَّهِ ۚ",335],["40:58:2",473,"يَسْتَوِى","(are) equal","وَمَا","ٱلْأَعْمَىٰ وَٱلْبَصِيرُ وَٱلَّذِينَ",335],["41:10:14",477,"سَوَآءًۭ","equal","فِىٓ أَرْبَعَةِ أَيَّامٍۢ","لِّلسَّآئِلِينَ",407],["41:11:2",477,"ٱسْتَوَىٰٓ","He directed (Himself)","ثُمَّ","إِلَى ٱلسَّمَآءِ وَهِىَ",335],["41:34:2",480,"تَسْتَوِى","(are) equal","وَلَا","ٱلْحَسَنَةُ وَلَا ٱلسَّيِّئَةُ ۚ",335],["43:13:1",490,"لِتَسْتَوُۥا۟","That you may sit firmly","","عَلَىٰ ظُهُورِهِۦ ثُمَّ",335],["43:13:9",490,"ٱسْتَوَيْتُمْ","you sit firmly","نِعْمَةَ رَبِّكُمْ إِذَا","عَلَيْهِ وَتَقُولُوا۟ سُبْحَـٰنَ",335],["44:47:4",498,"سَوَآءِ","(the) midst","خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ","ٱلْجَحِيمِ",407],["45:21:12",500,"سَوَآءًۭ","equal","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","مَّحْيَاهُمْ وَمَمَاتُهُمْ ۚ سَآءَ",407],["48:29:37",515,"فَٱسْتَوَىٰ","and it stands","شَطْـَٔهُۥ فَـَٔازَرَهُۥ فَٱسْتَغْلَظَ","عَلَىٰ سُوقِهِۦ يُعْجِبُ",335],["52:16:6",524,"سَوَآءٌ","(it is) same","أَوْ لَا تَصْبِرُوا۟","عَلَيْكُمْ ۖ إِنَّمَا تُجْزَوْنَ",407],["53:6:3",526,"فَٱسْتَوَىٰ","And he rose","ذُو مِرَّةٍۢ","",335],["57:4:10",538,"ٱسْتَوَىٰ","He rose","سِتَّةِ أَيَّامٍۢ ثُمَّ","عَلَى ٱلْعَرْشِ ۚ يَعْلَمُ",335],["57:10:13",538,"يَسْتَوِى","are equal","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ لَا","مِنكُم مَّنْ أَنفَقَ",335],["59:20:2",548,"يَسْتَوِىٓ","equal","لَا","أَصْحَـٰبُ ٱلنَّارِ وَأَصْحَـٰبُ",335],["60:1:47",549,"سَوَآءَ","(from the) straight","مِنكُمْ فَقَدْ ضَلَّ","ٱلسَّبِيلِ",407],["63:6:1",555,"سَوَآءٌ","(It) is same","","عَلَيْهِمْ أَسْتَغْفَرْتَ لَهُمْ",407],["67:22:9",563,"سَوِيًّا","upright","أَهْدَىٰٓ أَمَّن يَمْشِى","عَلَىٰ صِرَٰطٍۢ مُّسْتَقِيمٍۢ",1394],["75:4:5",577,"نُّسَوِّىَ","We can restore","قَـٰدِرِينَ عَلَىٰٓ أَن","بَنَانَهُۥ",697],["75:38:5",578,"فَسَوَّىٰ","and proportioned","كَانَ عَلَقَةًۭ فَخَلَقَ","",697],["79:28:3",584,"فَسَوَّىٰهَا","and proportioned it","رَفَعَ سَمْكَهَا","",697],["82:7:3",587,"فَسَوَّىٰكَ","then fashioned you","ٱلَّذِى خَلَقَكَ","فَعَدَلَكَ",697],["87:2:3",591,"فَسَوَّىٰ","then proportioned","ٱلَّذِى خَلَقَ","",697],["91:7:3",595,"سَوَّىٰهَا","proportioned it","وَنَفْسٍۢ وَمَا","",697],["91:14:7",595,"فَسَوَّىٰهَا","and leveled them","عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ","",697]]