[["4:78:35",90,"يَفْقَهُونَ","(to) understand","ٱلْقَوْمِ لَا يَكَادُونَ","حَدِيثًۭا",533],["6:25:10",130,"يَفْقَهُوهُ","they understand it","قُلُوبِهِمْ أَكِنَّةً أَن","وَفِىٓ ءَاذَانِهِمْ وَقْرًۭا ۚ",533],["6:65:27",135,"يَفْقَهُونَ","understand","نُصَرِّفُ ٱلْـَٔايَـٰتِ لَعَلَّهُمْ","",533],["6:98:13",140,"يَفْقَهُونَ","(who) understand","فَصَّلْنَا ٱلْـَٔايَـٰتِ لِقَوْمٍۢ","",533],["7:179:11",174,"يَفْقَهُونَ","they understand","لَهُمْ قُلُوبٌۭ لَّا","بِهَا وَلَهُمْ أَعْيُنٌۭ",533],["8:65:26",185,"يَفْقَهُونَ","understand","بِأَنَّهُمْ قَوْمٌۭ لَّا","",533],["9:81:27",200,"يَفْقَهُونَ","understand","حَرًّۭا ۚ لَّوْ كَانُوا۟","",533],["9:87:11",201,"يَفْقَهُونَ","understand","قُلُوبِهِمْ فَهُمْ لَا","",533],["9:122:13",206,"لِّيَتَفَقَّهُوا۟","that they may obtain understanding","فِرْقَةٍۢ مِّنْهُمْ طَآئِفَةٌۭ","فِى ٱلدِّينِ وَلِيُنذِرُوا۟",4674],["9:127:21",207,"يَفْقَهُونَ","they understand","بِأَنَّهُمْ قَوْمٌۭ لَّا","",533],["11:91:4",232,"نَفْقَهُ","we understand","قَالُوا۟ يَـٰشُعَيْبُ مَا","كَثِيرًۭا مِّمَّا تَقُولُ",533],["17:44:16",286,"تَفْقَهُونَ","you understand","بِحَمْدِهِۦ وَلَـٰكِن لَّا","تَسْبِيحَهُمْ ۗ إِنَّهُۥ كَانَ",533],["17:46:6",286,"يَفْقَهُوهُ","they understand it","قُلُوبِهِمْ أَكِنَّةً أَن","وَفِىٓ ءَاذَانِهِمْ وَقْرًۭا ۚ",533],["18:57:19",300,"يَفْقَهُوهُ","they understand it","قُلُوبِهِمْ أَكِنَّةً أَن","وَفِىٓ ءَاذَانِهِمْ وَقْرًۭا ۖ",533],["18:93:12",303,"يَفْقَهُونَ","understand","قَوْمًۭا لَّا يَكَادُونَ","قَوْلًۭا",533],["20:28:1",313,"يَفْقَهُوا۟","That they may understand","","قَوْلِى",533],["48:15:29",512,"يَفْقَهُونَ","understanding","بَلْ كَانُوا۟ لَا","إِلَّا قَلِيلًۭا",533],["59:13:12",547,"يَفْقَهُونَ","understand","بِأَنَّهُمْ قَوْمٌۭ لَّا","",533],["63:3:11",554,"يَفْقَهُونَ","understand","قُلُوبِهِمْ فَهُمْ لَا","",533],["63:7:20",555,"يَفْقَهُونَ","understand","وَلَـٰكِنَّ ٱلْمُنَـٰفِقِينَ لَا","",533]]