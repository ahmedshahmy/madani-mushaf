[["4:65:15",88,"حَرَجًۭا","any discomfort","يَجِدُوا۟ فِىٓ أَنفُسِهِمْ","مِّمَّا قَضَيْتَ وَيُسَلِّمُوا۟",621],["5:6:53",108,"حَرَجٍۢ","difficulty","لِيَجْعَلَ عَلَيْكُم مِّنْ","وَلَـٰكِن يُرِيدُ لِيُطَهِّرَكُمْ",621],["6:125:16",144,"حَرَجًۭا","and constricted","يَجْعَلْ صَدْرَهُۥ ضَيِّقًا","كَأَنَّمَا يَصَّعَّدُ فِى",621],["7:2:8",151,"حَرَجٌۭ","any uneasiness","يَكُن فِى صَدْرِكَ","مِّنْهُ لِتُنذِرَ بِهِۦ",621],["9:91:14",201,"حَرَجٌ","any blame","يَجِدُونَ مَا يُنفِقُونَ","إِذَا نَصَحُوا۟ لِلَّهِ",621],["22:78:14",341,"حَرَجٍۢ ۚ","difficulty","فِى ٱلدِّينِ مِنْ","مِّلَّةَ أَبِيكُمْ إِبْرَٰهِيمَ ۚ",621],["24:61:4",358,"حَرَجٌۭ","any blame","لَّيْسَ عَلَى ٱلْأَعْمَىٰ","وَلَا عَلَى ٱلْأَعْرَجِ",621],["24:61:8",358,"حَرَجٌۭ","any blame","وَلَا عَلَى ٱلْأَعْرَجِ","وَلَا عَلَى ٱلْمَرِيضِ",621],["24:61:12",358,"حَرَجٌۭ","any blame","وَلَا عَلَى ٱلْمَرِيضِ","وَلَا عَلَىٰٓ أَنفُسِكُمْ",621],["33:37:37",423,"حَرَجٌۭ","any discomfort","يَكُونَ عَلَى ٱلْمُؤْمِنِينَ","فِىٓ أَزْوَٰجِ أَدْعِيَآئِهِمْ",621],["33:38:6",423,"حَرَجٍۢ","discomfort","عَلَى ٱلنَّبِىِّ مِنْ","فِيمَا فَرَضَ ٱللَّهُ",621],["33:50:57",424,"حَرَجٌۭ ۗ","any discomfort","لِكَيْلَا يَكُونَ عَلَيْكَ","وَكَانَ ٱللَّهُ غَفُورًۭا",621],["48:17:4",513,"حَرَجٌۭ","any blame","لَّيْسَ عَلَى ٱلْأَعْمَىٰ","وَلَا عَلَى ٱلْأَعْرَجِ",621],["48:17:8",513,"حَرَجٌۭ","any blame","وَلَا عَلَى ٱلْأَعْرَجِ","وَلَا عَلَى ٱلْمَرِيضِ",621],["48:17:12",513,"حَرَجٌۭ ۗ","any blame","وَلَا عَلَى ٱلْمَرِيضِ","وَمَن يُطِعِ ٱللَّهَ",621]]