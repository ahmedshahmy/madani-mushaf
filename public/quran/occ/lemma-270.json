[["2:40:2",7,"إِسْرَٰٓءِيلَ","(of) Israel","يَـٰبَنِىٓ","ٱذْكُرُوا۟ نِعْمَتِىَ ٱلَّتِىٓ",270],["2:47:2",7,"إِسْرَٰٓءِيلَ","(of) Israel","يَـٰبَنِىٓ","ٱذْكُرُوا۟ نِعْمَتِىَ ٱلَّتِىٓ",270],["2:83:5",12,"إِسْرَٰٓءِيلَ","(of) Israel","أَخَذْنَا مِيثَـٰقَ بَنِىٓ","لَا تَعْبُدُونَ إِلَّا",270],["2:122:2",19,"إِسْرَٰٓءِيلَ","(of) Israel","يَـٰبَنِىٓ","ٱذْكُرُوا۟ نِعْمَتِىَ ٱلَّتِىٓ",270],["2:211:3",33,"إِسْرَٰٓءِيلَ","(of) Israel","سَلْ بَنِىٓ","كَمْ ءَاتَيْنَـٰهُم مِّنْ",270],["2:246:7",40,"إِسْرَٰٓءِيلَ","(of) Israel","ٱلْمَلَإِ مِنۢ بَنِىٓ","مِنۢ بَعْدِ مُوسَىٰٓ",270],["3:49:4",56,"إِسْرَٰٓءِيلَ","(of) Israel","وَرَسُولًا إِلَىٰ بَنِىٓ","أَنِّى قَدْ جِئْتُكُم",270],["3:93:6",62,"إِسْرَٰٓءِيلَ","(of) Israel","كَانَ حِلًّۭا لِّبَنِىٓ","إِلَّا مَا حَرَّمَ",270],["3:93:10",62,"إِسْرَٰٓءِيلُ","Israel","إِلَّا مَا حَرَّمَ","عَلَىٰ نَفْسِهِۦ مِن",270],["5:12:6",109,"إِسْرَٰٓءِيلَ","(of) Israel","ٱللَّهُ مِيثَـٰقَ بَنِىٓ","وَبَعَثْنَا مِنْهُمُ ٱثْنَىْ",270],["5:32:7",113,"إِسْرَٰٓءِيلَ","(of) Israel","كَتَبْنَا عَلَىٰ بَنِىٓ","أَنَّهُۥ مَن قَتَلَ",270],["5:70:5",119,"إِسْرَٰٓءِيلَ","(of) Israel","أَخَذْنَا مِيثَـٰقَ بَنِىٓ","وَأَرْسَلْنَآ إِلَيْهِمْ رُسُلًۭا ۖ",270],["5:72:14",120,"إِسْرَٰٓءِيلَ","(of) Israel","وَقَالَ ٱلْمَسِيحُ يَـٰبَنِىٓ","ٱعْبُدُوا۟ ٱللَّهَ رَبِّى",270],["5:78:6",121,"إِسْرَٰٓءِيلَ","(of) Israel","كَفَرُوا۟ مِنۢ بَنِىٓ","عَلَىٰ لِسَانِ دَاوُۥدَ",270],["5:110:50",126,"إِسْرَٰٓءِيلَ","(of) Israel","وَإِذْ كَفَفْتُ بَنِىٓ","عَنكَ إِذْ جِئْتَهُم",270],["7:105:18",164,"إِسْرَٰٓءِيلَ","(of) Israel","فَأَرْسِلْ مَعِىَ بَنِىٓ","",270],["7:134:22",166,"إِسْرَٰٓءِيلَ","(of) Israel","وَلَنُرْسِلَنَّ مَعَكَ بَنِىٓ","",270],["7:137:18",166,"إِسْرَٰٓءِيلَ","(of) Israel","ٱلْحُسْنَىٰ عَلَىٰ بَنِىٓ","بِمَا صَبَرُوا۟ ۖ وَدَمَّرْنَا",270],["7:138:3",167,"إِسْرَٰٓءِيلَ","(of) Israel","وَجَـٰوَزْنَا بِبَنِىٓ","ٱلْبَحْرَ فَأَتَوْا۟ عَلَىٰ",270],["10:90:3",219,"إِسْرَٰٓءِيلَ","(of) Israel","۞ وَجَـٰوَزْنَا بِبَنِىٓ","ٱلْبَحْرَ فَأَتْبَعَهُمْ فِرْعَوْنُ",270],["10:90:24",219,"إِسْرَٰٓءِيلَ","the Children of Israel","ءَامَنَتْ بِهِۦ بَنُوٓا۟","وَأَنَا۠ مِنَ ٱلْمُسْلِمِينَ",270],["10:93:4",219,"إِسْرَٰٓءِيلَ","(of) Israel","وَلَقَدْ بَوَّأْنَا بَنِىٓ","مُبَوَّأَ صِدْقٍۢ وَرَزَقْنَـٰهُم",270],["17:2:7",282,"إِسْرَٰٓءِيلَ","(of) Israel","وَجَعَلْنَـٰهُ هُدًۭى لِّبَنِىٓ","أَلَّا تَتَّخِذُوا۟ مِن",270],["17:4:4",282,"إِسْرَٰٓءِيلَ","(of) Israel","وَقَضَيْنَآ إِلَىٰ بَنِىٓ","فِى ٱلْكِتَـٰبِ لَتُفْسِدُنَّ",270],["17:101:9",292,"إِسْرَٰٓءِيلَ","(the) Children of Israel","بَيِّنَـٰتٍۢ ۖ فَسْـَٔلْ بَنِىٓ","إِذْ جَآءَهُمْ فَقَالَ",270],["17:104:5",292,"إِسْرَٰٓءِيلَ","to the Children of Israel","مِنۢ بَعْدِهِۦ لِبَنِىٓ","ٱسْكُنُوا۟ ٱلْأَرْضَ فَإِذَا",270],["19:58:18",309,"وَإِسْرَٰٓءِيلَ","and Israel","وَمِن ذُرِّيَّةِ إِبْرَٰهِيمَ","وَمِمَّنْ هَدَيْنَا وَٱجْتَبَيْنَآ ۚ",270],["20:47:9",314,"إِسْرَٰٓءِيلَ","(the) Children of Israel","فَأَرْسِلْ مَعَنَا بَنِىٓ","وَلَا تُعَذِّبْهُمْ ۖ قَدْ",270],["20:80:2",317,"إِسْرَٰٓءِيلَ","O Children of Israel","يَـٰبَنِىٓ","قَدْ أَنجَيْنَـٰكُم مِّنْ",270],["20:94:15",318,"إِسْرَٰٓءِيلَ","(the) Children of Israel","فَرَّقْتَ بَيْنَ بَنِىٓ","وَلَمْ تَرْقُبْ قَوْلِى",270],["26:17:5",367,"إِسْرَٰٓءِيلَ","(the) Children of Israel.'","أَرْسِلْ مَعَنَا بَنِىٓ","",270],["26:22:8",368,"إِسْرَٰٓءِيلَ","(the) Children of Israel","أَنْ عَبَّدتَّ بَنِىٓ","",270],["26:59:4",369,"إِسْرَٰٓءِيلَ","(the) Children of Israel","كَذَٰلِكَ وَأَوْرَثْنَـٰهَا بَنِىٓ","",270],["26:197:9",375,"إِسْرَٰٓءِيلَ","(of) Israel","يَعْلَمَهُۥ عُلَمَـٰٓؤُا۟ بَنِىٓ","",270],["27:76:7",383,"إِسْرَٰٓءِيلَ","(of) Israel","يَقُصُّ عَلَىٰ بَنِىٓ","أَكْثَرَ ٱلَّذِى هُمْ",270],["32:23:14",417,"إِسْرَٰٓءِيلَ","for the Children of Israel","وَجَعَلْنَـٰهُ هُدًۭى لِّبَنِىٓ","",270],["40:53:7",473,"إِسْرَٰٓءِيلَ","(the) Children of Israel","ٱلْهُدَىٰ وَأَوْرَثْنَا بَنِىٓ","ٱلْكِتَـٰبَ",270],["43:59:10",493,"إِسْرَٰٓءِيلَ","for (the) Children of Israel","وَجَعَلْنَـٰهُ مَثَلًۭا لِّبَنِىٓ","",270],["44:30:4",497,"إِسْرَٰٓءِيلَ","(the) Children of Israel","وَلَقَ