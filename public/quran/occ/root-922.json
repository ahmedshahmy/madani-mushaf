[["15:88:13",266,"وَٱخْفِضْ","And lower","وَلَا تَحْزَنْ عَلَيْهِمْ","جَنَاحَكَ لِلْمُؤْمِنِينَ",2111],["17:24:1",284,"وَٱخْفِضْ","And lower","","لَهُمَا جَنَاحَ ٱلذُّلِّ",2111],["26:215:1",376,"وَٱخْفِضْ","And lower","","جَنَاحَكَ لِمَنِ ٱتَّبَعَكَ",2111],["56:3:1",534,"خَافِضَةٌۭ","Bringing down","","رَّافِعَةٌ",4555]]