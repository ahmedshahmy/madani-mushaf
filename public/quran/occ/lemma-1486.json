[["4:163:19",104,"وَأَيُّوبَ","and Ayyub","وَيَعْقُوبَ وَٱلْأَسْبَاطِ وَعِيسَىٰ","وَيُونُسَ وَهَـٰرُونَ وَسُلَيْمَـٰنَ ۚ",1486],["6:84:15",138,"وَأَيُّوبَ","and Ayyub","ذُرِّيَّتِهِۦ دَاوُۥدَ وَسُلَيْمَـٰنَ","وَيُوسُفَ وَمُوسَىٰ وَهَـٰرُونَ ۚ",1486],["21:83:1",329,"۞ وَأَيُّوبَ","And Ayub","","إِذْ نَادَىٰ رَبَّهُۥٓ",1486],["38:41:3",455,"أَيُّوبَ","Ayyub","وَٱذْكُرْ عَبْدَنَآ","إِذْ نَادَىٰ رَبَّهُۥٓ",1486]]