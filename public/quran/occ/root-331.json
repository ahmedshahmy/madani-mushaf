[["3:24:10",53,"وَغَرَّهُمْ","And deceived them","إِلَّآ أَيَّامًۭا مَّعْدُودَٰتٍۢ ۖ","فِى دِينِهِم مَّا",629],["3:185:23",74,"ٱلْغُرُورِ","(of) delusion","ٱلدُّنْيَآ إِلَّا مَتَـٰعُ","",902],["3:196:2",76,"يَغُرَّنَّكَ","deceive you","لَا","تَقَلُّبُ ٱلَّذِينَ كَفَرُوا۟",629],["4:120:7",97,"غُرُورًا","deception","يَعِدُهُمُ ٱلشَّيْطَـٰنُ إِلَّا","",902],["6:70:7",136,"وَغَرَّتْهُمُ","and deluded them","دِينَهُمْ لَعِبًۭا وَلَهْوًۭا","ٱلْحَيَوٰةُ ٱلدُّنْيَا ۚ وَذَكِّرْ",629],["6:112:15",142,"غُرُورًۭا ۚ","(in) deception","بَعْضٍۢ زُخْرُفَ ٱلْقَوْلِ","وَلَوْ شَآءَ رَبُّكَ",902],["6:130:19",144,"وَغَرَّتْهُمُ","And deluded them","شَهِدْنَا عَلَىٰٓ أَنفُسِنَا ۖ","ٱلْحَيَوٰةُ ٱلدُّنْيَا وَشَهِدُوا۟",629],["7:22:2",152,"بِغُرُورٍۢ ۚ","by deception","فَدَلَّىٰهُمَا","فَلَمَّا ذَاقَا ٱلشَّجَرَةَ",902],["7:51:6",156,"وَغَرَّتْهُمُ","and deluded them","دِينَهُمْ لَهْوًۭا وَلَعِبًۭا","ٱلْحَيَوٰةُ ٱلدُّنْيَا ۚ فَٱلْيَوْمَ",629],["8:49:8",183,"غَرَّ","(Had) deluded","فِى قُلُوبِهِم مَّرَضٌ","هَـٰٓؤُلَآءِ دِينُهُمْ ۗ وَمَن",629],["17:64:19",288,"غُرُورًا","delusion","يَعِدُهُمُ ٱلشَّيْطَـٰنُ إِلَّا","",902],["31:33:24",414,"تَغُرَّنَّكُمُ","so let not deceive you","ٱللَّهِ حَقٌّۭ ۖ فَلَا","ٱلْحَيَوٰةُ ٱلدُّنْيَا وَلَا",629],["31:33:28",414,"يَغُرَّنَّكُم","and let not deceive you","ٱلْحَيَوٰةُ ٱلدُّنْيَا وَلَا","بِٱللَّهِ ٱلْغَرُورُ",629],["31:33:30",414,"ٱلْغَرُورُ","the deceiver","وَلَا يَغُرَّنَّكُم بِٱللَّهِ","",1847],["33:12:13",419,"غُرُورًۭا","delusion","ٱللَّهُ وَرَسُولُهُۥٓ إِلَّا","",902],["35:5:8",435,"تَغُرَّنَّكُمُ","deceive you","ٱللَّهِ حَقٌّۭ ۖ فَلَا","ٱلْحَيَوٰةُ ٱلدُّنْيَا ۖ وَلَا",629],["35:5:12",435,"يَغُرَّنَّكُم","deceive you","ٱلْحَيَوٰةُ ٱلدُّنْيَا ۖ وَلَا","بِٱللَّهِ ٱلْغَرُورُ",629],["35:5:14",435,"ٱلْغَرُورُ","the Deceiver","وَلَا يَغُرَّنَّكُم بِٱللَّهِ","",1847],["35:40:33",439,"غُرُورًا","delusion","بَعْضُهُم بَعْضًا إِلَّا","",902],["40:4:10",467,"يَغْرُرْكَ","deceive you","ٱلَّذِينَ كَفَرُوا۟ فَلَا","تَقَلُّبُهُمْ فِى ٱلْبِلَـٰدِ",629],["45:35:7",502,"وَغَرَّتْكُمُ","and deceived you","ءَايَـٰتِ ٱللَّهِ هُزُوًۭا","ٱلْحَيَوٰةُ ٱلدُّنْيَا ۚ فَٱلْيَوْمَ",629],["57:14:12",539,"وَغَرَّتْكُمُ","and deceived you","أَنفُسَكُمْ وَتَرَبَّصْتُمْ وَٱرْتَبْتُمْ","ٱلْأَمَانِىُّ حَتَّىٰ جَآءَ",629],["57:14:18",539,"وَغَرَّكُم","And deceived you","جَآءَ أَمْرُ ٱللَّهِ","بِٱللَّهِ ٱلْغَرُورُ",629],["57:14:20",539,"ٱلْغَرُورُ","the deceiver","ٱللَّهِ وَغَرَّكُم بِٱللَّهِ","",1847],["57:20:39",540,"ٱلْغُرُورِ","(of) delusion","ٱلدُّنْيَآ إِلَّا مَتَـٰعُ","",902],["67:20:15",563,"غُرُورٍ","delusion","ٱلْكَـٰفِرُونَ إِلَّا فِى","",902],["82:6:4",587,"غَرَّكَ","has deceived you","يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا","بِرَبِّكَ ٱلْكَرِيمِ",629]]