[["7:111:6",164,"ٱلْمَدَآئِنِ","the cities","وَأَخَاهُ وَأَرْسِلْ فِى","حَـٰشِرِينَ",1886],["7:123:14",165,"ٱلْمَدِينَةِ","the city","لَمَكْرٌۭ مَّكَرْتُمُوهُ فِى","لِتُخْرِجُوا۟ مِنْهَآ أَهْلَهَا ۖ",668],["9:101:8",203,"ٱلْمَدِينَةِ ۖ","(of) the Madinah","مُنَـٰفِقُونَ ۖ وَمِنْ أَهْلِ","مَرَدُوا۟ عَلَى ٱلنِّفَاقِ",668],["9:120:4",206,"ٱلْمَدِينَةِ","of the Madinah","مَا كَانَ لِأَهْلِ","وَمَنْ حَوْلَهُم مِّنَ",668],["12:30:4",238,"ٱلْمَدِينَةِ","the city","۞ وَقَالَ نِسْوَةٌۭ فِى","ٱمْرَأَتُ ٱلْعَزِيزِ تُرَٰوِدُ",668],["15:67:3",265,"ٱلْمَدِينَةِ","(of) the city","وَجَآءَ أَهْلُ","يَسْتَبْشِرُونَ",668],["18:19:26",295,"ٱلْمَدِينَةِ","the city","بِوَرِقِكُمْ هَـٰذِهِۦٓ إِلَى","فَلْيَنظُرْ أَيُّهَآ أَزْكَىٰ",668],["18:82:7",302,"ٱلْمَدِينَةِ","the town","لِغُلَـٰمَيْنِ يَتِيمَيْنِ فِى","وَكَانَ تَحْتَهُۥ كَنزٌۭ",668],["26:36:6",368,"ٱلْمَدَآئِنِ","the cities","وَأَخَاهُ وَٱبْعَثْ فِى","حَـٰشِرِينَ",1886],["26:53:4",369,"ٱلْمَدَآئِنِ","the cities","فَأَرْسَلَ فِرْعَوْنُ فِى","حَـٰشِرِينَ",1886],["27:48:3",381,"ٱلْمَدِينَةِ","the city","وَكَانَ فِى","تِسْعَةُ رَهْطٍۢ يُفْسِدُونَ",668],["28:15:2",387,"ٱلْمَدِينَةَ","the city","وَدَخَلَ","عَلَىٰ حِينِ غَفْلَةٍۢ",668],["28:18:3",387,"ٱلْمَدِينَةِ","the city","فَأَصْبَحَ فِى","خَآئِفًۭا يَتَرَقَّبُ فَإِذَا",668],["28:20:5",387,"ٱلْمَدِينَةِ","(of) the city","رَجُلٌۭ مِّنْ أَقْصَا","يَسْعَىٰ قَالَ يَـٰمُوسَىٰٓ",668],["33:60:11",426,"ٱلْمَدِينَةِ","the city","مَّرَضٌۭ وَٱلْمُرْجِفُونَ فِى","لَنُغْرِيَنَّكَ بِهِمْ ثُمَّ",668],["36:20:4",441,"ٱلْمَدِينَةِ","(of) the city","وَجَآءَ مِنْ أَقْصَا","رَجُلٌۭ يَسْعَىٰ قَالَ",668],["63:8:5",555,"ٱلْمَدِينَةِ","Al-Madinah","لَئِن رَّجَعْنَآ إِلَى","لَيُخْرِجَنَّ ٱلْأَعَزُّ مِنْهَا",668]]