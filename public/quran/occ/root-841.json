[["24:31:61",353,"عَوْرَٰتِ","private aspects","لَمْ يَظْهَرُوا۟ عَلَىٰ","ٱلنِّسَآءِ ۖ وَلَا يَضْرِبْنَ",1503],["24:58:29",357,"عَوْرَٰتٍۢ","(are) times of privacy","صَلَوٰةِ ٱلْعِشَآءِ ۚ ثَلَـٰثُ","لَّكُمْ ۚ لَيْسَ عَلَيْكُمْ",1503],["33:13:18",419,"عَوْرَةٌۭ","(are) exposed","يَقُولُونَ إِنَّ بُيُوتَنَا","وَمَا هِىَ بِعَوْرَةٍ ۖ",1503],["33:13:21",419,"بِعَوْرَةٍ ۖ","(were) exposed","عَوْرَةٌۭ وَمَا هِىَ","إِن يُرِيدُونَ إِلَّا",1503]]