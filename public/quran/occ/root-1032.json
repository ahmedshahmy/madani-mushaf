[["14:50:1",261,"سَرَابِيلُهُم","Their garments","","مِّن قَطِرَانٍۢ وَتَغْشَىٰ",1989],["16:81:14",276,"سَرَٰبِيلَ","garments","أَكْنَـٰنًۭا وَجَعَلَ لَكُمْ","تَقِيكُمُ ٱلْحَرَّ وَسَرَٰبِيلَ",1989],["16:81:17",276,"وَسَرَٰبِيلَ","and garments","سَرَٰبِيلَ تَقِيكُمُ ٱلْحَرَّ","تَقِيكُم بَأْسَكُمْ ۚ كَذَٰلِكَ",1989]]