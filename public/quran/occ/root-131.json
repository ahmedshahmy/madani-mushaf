[["2:49:2",8,"نَجَّيْنَـٰكُم","We saved you","وَإِذْ","مِّنْ ءَالِ فِرْعَوْنَ",319],["2:50:5",8,"فَأَنجَيْنَـٰكُمْ","then We saved you","فَرَقْنَا بِكُمُ ٱلْبَحْرَ","وَأَغْرَقْنَآ ءَالَ فِرْعَوْنَ",451],["4:114:6",97,"نَّجْوَىٰهُمْ","their secret talk","فِى كَثِيرٍۢ مِّن","إِلَّا مَنْ أَمَرَ",795],["6:63:3",135,"يُنَجِّيكُم","saves you","قُلْ مَن","مِّن ظُلُمَـٰتِ ٱلْبَرِّ",319],["6:63:12",135,"أَنجَىٰنَا","He saves us","تَضَرُّعًۭا وَخُفْيَةًۭ لَّئِنْ","مِنْ هَـٰذِهِۦ لَنَكُونَنَّ",451],["6:64:3",135,"يُنَجِّيكُم","saves you","قُلِ ٱللَّهُ","مِّنْهَا وَمِن كُلِّ",319],["7:64:2",158,"فَأَنجَيْنَـٰهُ","so We saved him","فَكَذَّبُوهُ","وَٱلَّذِينَ مَعَهُۥ فِى",451],["7:72:1",159,"فَأَنجَيْنَـٰهُ","So We saved him","","وَٱلَّذِينَ مَعَهُۥ بِرَحْمَةٍۢ",451],["7:83:1",161,"فَأَنجَيْنَـٰهُ","So We saved him","","وَأَهْلَهُۥٓ إِلَّا ٱمْرَأَتَهُۥ",451],["7:89:12",162,"نَجَّىٰنَا","saved us","مِلَّتِكُم بَعْدَ إِذْ","ٱللَّهُ مِنْهَا ۚ وَمَا",319],["7:141:2",167,"أَنجَيْنَـٰكُم","We saved you","وَإِذْ","مِّنْ ءَالِ فِرْعَوْنَ",451],["7:165:6",172,"أَنجَيْنَا","We saved","مَا ذُكِّرُوا۟ بِهِۦٓ","ٱلَّذِينَ يَنْهَوْنَ عَنِ",451],["9:78:7",199,"وَنَجْوَىٰهُمْ","and their secret conversation","ٱللَّهَ يَعْلَمُ سِرَّهُمْ","وَأَنَّ ٱللَّهَ عَلَّـٰمُ",795],["10:22:36",211,"أَنجَيْتَنَا","You save us","لَهُ ٱلدِّينَ لَئِنْ","مِنْ هَـٰذِهِۦ لَنَكُونَنَّ",451],["10:23:2",211,"أَنجَىٰهُمْ","He saved them","فَلَمَّآ","إِذَا هُمْ يَبْغُونَ",451],["10:73:2",217,"فَنَجَّيْنَـٰهُ","so We saved him","فَكَذَّبُوهُ","وَمَن مَّعَهُۥ فِى",319],["10:86:1",218,"وَنَجِّنَا","And save us","","بِرَحْمَتِكَ مِنَ ٱلْقَوْمِ",319],["10:92:2",219,"نُنَجِّيكَ","We will save you","فَٱلْيَوْمَ","بِبَدَنِكَ لِتَكُونَ لِمَنْ",319],["10:103:2",220,"نُنَجِّى","We will save","ثُمَّ","رُسُلَنَا وَٱلَّذِينَ ءَامَنُوا۟ ۚ",319],["10:103:9",220,"نُنجِ","(that) We save","كَذَٰلِكَ حَقًّا عَلَيْنَا","ٱلْمُؤْمِنِينَ",451],["11:58:4",228,"نَجَّيْنَا","We saved","وَلَمَّا جَآءَ أَمْرُنَا","هُودًۭا وَٱلَّذِينَ ءَامَنُوا۟",319],["11:58:11",228,"وَنَجَّيْنَـٰهُم","and We saved them","مَعَهُۥ بِرَحْمَةٍۢ مِّنَّا","مِّنْ عَذَابٍ غَلِيظٍۢ",319],["11:66:4",229,"نَجَّيْنَا","We saved","فَلَمَّا جَآءَ أَمْرُنَا","صَـٰلِحًۭا وَٱلَّذِينَ ءَامَنُوا۟",319],["11:94:4",232,"نَجَّيْنَا","We saved","وَلَمَّا جَآءَ أَمْرُنَا","شُعَيْبًۭا وَٱلَّذِينَ ءَامَنُوا۟",319],["11:116:17",234,"أَنجَيْنَا","We saved","إِلَّا قَلِيلًۭا مِّمَّنْ","مِنْهُمْ ۗ وَٱتَّبَعَ ٱلَّذِينَ",451],["12:42:5",240,"نَاجٍۢ","(would be) saved","لِلَّذِى ظَنَّ أَنَّهُۥ","مِّنْهُمَا ٱذْكُرْنِى عِندَ",4008],["12:45:3",241,"نَجَا","was saved","وَقَالَ ٱلَّذِى","مِنْهُمَا وَٱدَّكَرَ بَعْدَ",2553],["12:80:5",245,"نَجِيًّۭا ۖ","(in) private consultation","ٱسْتَيْـَٔسُوا۟ مِنْهُ خَلَصُوا۟","قَالَ كَبِيرُهُمْ أَلَمْ",2554],["12:110:11",248,"فَنُجِّىَ","and was saved","كُذِبُوا۟ جَآءَهُمْ نَصْرُنَا","مَن نَّشَآءُ ۖ وَلَا",319],["14:6:10",256,"أَنجَىٰكُم","He saved you","ٱللَّهِ عَلَيْكُمْ إِذْ","مِّنْ ءَالِ فِرْعَوْنَ",451],["15:59:5",265,"لَمُنَجُّوهُمْ","surely will save them","ءَالَ لُوطٍ إِنَّا","أَجْمَعِينَ",2496],["17:47:11",286,"نَجْوَىٰٓ","(are) in private conversation","إِلَيْكَ وَإِذْ هُمْ","إِذْ يَقُولُ ٱلظَّـٰلِمُونَ",795],["17:67:12",289,"نَجَّىٰكُمْ","He delivers you","إِلَّآ إِيَّاهُ ۖ فَلَمَّا","إِلَى ٱلْبَرِّ أَعْرَضْتُمْ ۚ",319],["19:52:7",309,"نَجِيًّۭا","(for) conversation","ٱلطُّورِ ٱلْأَيْمَنِ وَقَرَّبْنَـٰهُ","",2554],["19:72:2",310,"نُنَجِّى","We will deliver","ثُمَّ","ٱلَّذِينَ ٱتَّقَوا۟ وَّنَذَرُ",319],["20:40:20",314,"فَنَجَّيْنَـٰكَ","but We saved you","تَحْزَنَ ۚ وَقَتَلْتَ نَفْسًۭا","مِنَ ٱلْغَمِّ وَفَتَنَّـٰكَ",319],["20:62:5",315,"ٱلنَّجْوَىٰ","the private conversation","أَمْرَهُم بَيْنَهُمْ وَأَسَرُّوا۟","",795],["20:80:4",317,"أَنجَيْنَـٰكُم","We delivered you","يَـٰبَنِىٓ إِسْرَٰٓءِيلَ قَدْ","مِّنْ عَدُوِّكُمْ وَوَٰعَدْنَـٰكُمْ",451],["21:3:4",322,"ٱلنَّجْوَى","the private conversation","لَاهِيَةًۭ قُلُوبُهُمْ ۗ وَأَسَرُّوا۟","ٱلَّذِينَ ظَلَمُوا۟ هَلْ",795],["21:9:4",322,"فَأَنجَيْنَـٰهُمْ","and We saved them","ثُمَّ صَدَقْنَـٰهُمُ ٱلْوَعْدَ","وَمَن نَّشَآءُ وَأَهْلَكْنَا",451],["21:71:1",327,"وَنَجَّيْنَـٰهُ","And We delivered him","","وَلُوطًا إِلَى ٱلْأَرْضِ",319],["21:74:5",328,"وَنَجَّيْنَـٰهُ","and We saved him","ءَاتَيْنَـٰهُ حُكْمًۭا وَعِلْمًۭا","مِنَ ٱلْقَرْيَةِ ٱلَّتِى",319],["21:76:8",328,"فَنَجَّيْنَـٰهُ","and We saved him","قَبْلُ فَٱسْتَجَبْنَا لَهُۥ","وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ",319],["21:88:3",329,"وَنَجَّيْنَـٰهُ","and We saved him","فَٱسْتَجَبْنَا لَهُۥ","مِنَ ٱلْغَمِّ ۚ وَكَذَٰلِكَ",319],["21:88:7",329,"نُـۨجِى","We save","مِنَ ٱلْغَمِّ ۚ وَكَذَٰلِكَ","ٱلْمُؤْمِنِينَ",451],["23:28:12",344,"نَجَّىٰنَا","(has) saved us","ٱلْحَمْدُ لِلَّهِ ٱلَّذِى","مِنَ ٱلْقَوْمِ ٱلظَّـٰلِمِينَ",319],["26:65:1",370,"وَأَنجَيْنَا","And We saved","","مُوسَىٰ وَمَن مَّعَهُۥٓ",451],["26:118:5",372,"وَنَجِّنِى","and save me","بَيْنِى وَبَيْنَهُمْ فَتْحًۭا","وَمَن مَّعِىَ مِنَ",319],["26:119:1",372,"فَأَنجَيْنَـٰهُ","So We saved him","","وَمَن مَّعَهُۥ فِى",451],["26:169:2",374,"نَجِّنِى","Save me","رَبِّ","وَأَهْلِى مِمَّا يَعْمَلُونَ",319],["26:170:1",374,"فَنَجَّيْنَـٰهُ","So We saved him","","وَأَهْلَهُۥٓ أَجْمَعِينَ",319],["27:53:1",381,"وَأَنجَيْنَا","And We saved","","ٱلَّذِينَ ءَامَنُوا۟ وَكَانُوا۟",451],["27:57:1",382,"فَأَنجَيْنَـٰهُ","So We saved him","","وَأَهْلَهُۥٓ إِلَّا ٱمْرَأَتَهُۥ",451],["28:21:7",387,"نَجِّنِى","Save me","يَتَرَقَّبُ ۖ قَالَ رَبِّ","مِنَ ٱلْقَوْمِ ٱلظَّـٰلِمِينَ",319],["28:25:23",388,"نَجَوْتَ","You have escaped","قَالَ لَا تَخَفْ ۖ","مِنَ ٱلْقَوْمِ ٱلظَّـٰلِمِينَ",2553],["29:15:1",398,"فَأَنجَيْنَـٰهُ","But We saved him","","وَأَصْحَـٰبَ ٱلسَّفِينَةِ وَجَعَلْنَـٰهَآ",451],["29:24:11",399,"فَأَنجَىٰهُ","But Allah saved him","ٱقْتُلُوهُ أَوْ حَرِّقُوهُ","ٱللَّهُ مِنَ ٱلنَّارِ ۚ",451],["29:32:10",400,"لَنُنَجِّيَنَّهُۥ","We will surely save him","أَعْلَمُ بِمَن فِيهَا ۖ","وَأَهْلَهُۥٓ إِلَّا ٱمْرَأَتَهُۥ",319],["29:33:17",400,"مُنَجُّوكَ","(will) save you","وَلَا تَحْزَنْ ۖ إِنَّا","وَأَهْلَكَ إِلَّا ٱمْرَأَتَكَ",2496],["29:65:11",404,"نَجَّىٰهُمْ","He delivers them","لَهُ ٱلدِّينَ فَلَمَّا","إِلَى ٱلْبَرِّ إِذَا",319],["31:32:11",414,"نَجَّىٰهُمْ","He delivers them","لَهُ ٱلدِّينَ فَلَمَّا","إِلَى ٱلْبَرِّ فَمِنْهُم",319],["37:76:1",448,"وَنَجَّيْنَـٰهُ","And We saved him","","وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ",319],["37:115:1",450,"وَنَجَّيْنَـٰهُمَا","And We saved both of them","","وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ",319],["37:134:2",451,"نَجَّيْنَـٰهُ","We saved him","إِذْ","وَأَهْلَهُۥٓ أَجْمَعِينَ",319],["39:61:1",465,"وَيُنَجِّى","And Allah will deliver","","ٱللَّهُ ٱلَّذِينَ ٱتَّقَوْا۟",319],["40:41:6",472,"ٱلنَّجَوٰةِ","the salvation","لِىٓ أَدْعُوكُمْ إِلَى","وَتَدْعُونَنِىٓ إِلَى ٱلنَّارِ",4089],["41:18:1",478,"وَنَجَّيْنَا","And We saved","","ٱلَّذِينَ ءَامَنُوا۟ وَكَانُوا۟",319],["43:80:7",495,"وَنَجْوَىٰهُم ۚ","and their private counsel(s)","لَا نَسْمَعُ سِرَّهُمْ","بَلَىٰ وَرُسُلُنَا لَدَيْهِمْ",795],["44:30:2",497,"نَجَّيْنَا","We saved","وَلَقَدْ","بَنِىٓ إِسْرَٰٓءِيلَ مِنَ",319],["54:34:8",530,"نَّجَّيْنَـٰهُم","We saved them","إِلَّآ ءَالَ لُوطٍۢ ۖ","بِسَحَرٍۢ",319],["58:7:15",543,"نَّجْوَىٰ","secret counsel","مَا يَكُونُ مِن","ثَلَـٰثَةٍ إِلَّا هُوَ",795],["58:8:7",543,"ٱلنَّجْوَىٰ","secret counsels","ٱلَّذِينَ نُهُوا۟ عَنِ","ثُمَّ يَعُودُونَ لِمَا",795],["58:8:13",543,"وَيَتَنَـٰجَوْنَ","and they hold secret counsels","لِمَا نُهُوا۟ عَنْهُ","بِٱلْإِثْمِ وَٱلْعُدْوَٰنِ وَمَعْصِيَتِ",1650],["58:9:5",543,"تَنَـٰجَيْتُمْ","you hold secret counsel","ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا","فَلَا تَتَنَـٰجَوْا۟ بِٱلْإِثْمِ",1650],["58:9:7",543,"تَتَنَـٰجَوْا۟","hold secret counsel","إِذَا تَنَـٰجَيْتُمْ فَلَا","بِٱلْإِثْمِ وَٱلْعُدْوَٰنِ وَمَعْصِيَتِ",1650],["58:9:12",543,"وَتَنَـٰجَوْا۟","but hold secret counsel","وَٱلْعُدْوَٰنِ وَمَعْصِيَتِ ٱلرَّسُولِ","بِٱلْبِرِّ وَٱلتَّقْوَىٰ ۖ وَٱتَّقُوا۟",1650],["58:10:2",543,"ٱلنَّجْوَىٰ","the secret counsels","إِنَّمَا","مِنَ ٱلشَّيْطَـٰنِ لِيَحْزُنَ",795],["58:12:5",544,"نَـٰجَيْتُمُ","you privately consult","ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا","ٱلرَّسُولَ فَقَدِّمُوا۟ بَيْنَ",4022],["58:12:10",544,"نَجْوَىٰكُمْ","your private consultation","فَقَدِّمُوا۟ بَيْنَ يَدَىْ","صَدَقَةًۭ ۚ ذَٰلِكَ خَيْرٌۭ",795],["58:13:6",544,"نَجْوَىٰكُمْ","your private consultation","تُقَدِّمُوا۟ بَيْنَ يَدَىْ","صَدَقَـٰتٍۢ ۚ فَإِذْ لَمْ",795],["61:10:8",552,"تُنجِيكُم","(that) will save you","أَدُلُّكُمْ عَلَىٰ تِجَـٰرَةٍۢ","مِّنْ عَذَابٍ أَلِيمٍۢ",451],["66:11:17",561,"وَنَجِّنِى","and save me","بَيْتًۭا فِى ٱلْجَنَّةِ","مِن فِرْعَوْنَ وَعَمَلِهِۦ",319],["66:11:21",561,"وَنَجِّنِى","and save me","مِن فِرْعَوْنَ وَعَمَلِهِۦ","مِنَ ٱلْقَوْمِ ٱلظَّـٰلِمِينَ",319],["70:14:6",569,"يُنجِيهِ","it (could) save him","ٱلْأَرْضِ جَمِيعًۭا ثُمَّ","",451]]