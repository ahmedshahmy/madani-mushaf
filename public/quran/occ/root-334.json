[["6:77:3",137,"ٱلْقَمَرَ","the moon","فَلَمَّا رَءَا","بَازِغًۭا قَالَ هَـٰذَا",406],["6:96:7",140,"وَٱلْقَمَرَ","and the moon","ٱلَّيْلَ سَكَنًۭا وَٱلشَّمْسَ","حُسْبَانًۭا ۚ ذَٰلِكَ تَقْدِيرُ",406],["7:54:21",157,"وَٱلْقَمَرَ","and the moon","يَطْلُبُهُۥ حَثِيثًۭا وَٱلشَّمْسَ","وَٱلنُّجُومَ مُسَخَّرَٰتٍۭ بِأَمْرِهِۦٓ ۗ",406],["10:5:6",208,"وَٱلْقَمَرَ","and the moon","جَعَلَ ٱلشَّمْسَ ضِيَآءًۭ","نُورًۭا وَقَدَّرَهُۥ مَنَازِلَ",406],["12:4:12",235,"وَٱلْقَمَرَ","and the moon","عَشَرَ كَوْكَبًۭا وَٱلشَّمْسَ","رَأَيْتُهُمْ لِى سَـٰجِدِينَ",406],["13:2:14",249,"وَٱلْقَمَرَ ۖ","and the moon","ٱلْعَرْشِ ۖ وَسَخَّرَ ٱلشَّمْسَ","كُلٌّۭ يَجْرِى لِأَجَلٍۢ",406],["14:33:4",259,"وَٱلْقَمَرَ","and the moon","وَسَخَّرَ لَكُمُ ٱلشَّمْسَ","دَآئِبَيْنِ ۖ وَسَخَّرَ لَكُمُ",406],["16:12:6",268,"وَٱلْقَمَرَ ۖ","and the moon","ٱلَّيْلَ وَٱلنَّهَارَ وَٱلشَّمْسَ","وَٱلنُّجُومُ مُسَخَّرَٰتٌۢ بِأَمْرِهِۦٓ ۗ",406],["21:33:7",324,"وَٱلْقَمَرَ ۖ","and the moon","ٱلَّيْلَ وَٱلنَّهَارَ وَٱلشَّمْسَ","كُلٌّۭ فِى فَلَكٍۢ",406],["22:18:14",334,"وَٱلْقَمَرُ","and the moon","فِى ٱلْأَرْضِ وَٱلشَّمْسُ","وَٱلنُّجُومُ وَٱلْجِبَالُ وَٱلشَّجَرُ",406],["25:61:10",365,"وَقَمَرًۭا","and a moon","وَجَعَلَ فِيهَا سِرَٰجًۭا","مُّنِيرًۭا",406],["29:61:9",403,"وَٱلْقَمَرَ","and the moon","وَٱلْأَرْضَ وَسَخَّرَ ٱلشَّمْسَ","لَيَقُولُنَّ ٱللَّهُ ۖ فَأَنَّىٰ",406],["31:29:15",414,"وَٱلْقَمَرَ","and the moon","ٱلَّيْلِ وَسَخَّرَ ٱلشَّمْسَ","كُلٌّۭ يَجْرِىٓ إِلَىٰٓ",406],["35:13:11",436,"وَٱلْقَمَرَ","and the moon","ٱلَّيْلِ وَسَخَّرَ ٱلشَّمْسَ","كُلٌّۭ يَجْرِى لِأَجَلٍۢ",406],["36:39:1",442,"وَٱلْقَمَرَ","And the moon","","قَدَّرْنَـٰهُ مَنَازِلَ حَتَّىٰ",406],["36:40:7",442,"ٱلْقَمَرَ","the moon","لَهَآ أَن تُدْرِكَ","وَلَا ٱلَّيْلُ سَابِقُ",406],["39:5:15",458,"وَٱلْقَمَرَ ۖ","and the moon","ٱلَّيْلِ ۖ وَسَخَّرَ ٱلشَّمْسَ","كُلٌّۭ يَجْرِى لِأَجَلٍۢ",406],["41:37:6",480,"وَٱلْقَمَرُ ۚ","and the moon","ٱلَّيْلُ وَٱلنَّهَارُ وَٱلشَّمْسُ","لَا تَسْجُدُوا۟ لِلشَّمْسِ",406],["41:37:11",480,"لِلْقَمَرِ","to the moon","تَسْجُدُوا۟ لِلشَّمْسِ وَلَا","وَٱسْجُدُوا۟ لِلَّهِ ٱلَّذِى",406],["54:1:4",528,"ٱلْقَمَرُ","the moon","ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ","",406],["55:5:2",531,"وَٱلْقَمَرُ","and the moon","ٱلشَّمْسُ","بِحُسْبَانٍۢ",406],["71:16:2",571,"ٱلْقَمَرَ","the moon","وَجَعَلَ","فِيهِنَّ نُورًۭا وَجَعَلَ",406],["74:32:2",576,"وَٱلْقَمَرِ","By the moon","كَلَّا","",406],["75:8:2",577,"ٱلْقَمَرُ","the moon","وَخَسَفَ","",406],["75:9:3",577,"وَٱلْقَمَرُ","and the moon","وَجُمِعَ ٱلشَّمْسُ","",406],["84:18:1",589,"وَٱلْقَمَرِ","And the moon","","إِذَا ٱتَّسَقَ",406],["91:2:1",595,"وَٱلْقَمَرِ","And the moon","","إِذَا تَلَىٰهَا",406]]