[["7:180:8",174,"يُلْحِدُونَ","deviate","بِهَا ۖ وَذَرُوا۟ ٱلَّذِينَ","فِىٓ أَسْمَـٰٓئِهِۦ ۚ سَيُجْزَوْنَ",2080],["16:103:10",279,"يُلْحِدُونَ","they refer","بَشَرٌۭ ۗ لِّسَانُ ٱلَّذِى","إِلَيْهِ أَعْجَمِىٌّۭ وَهَـٰذَا",2080],["18:27:15",296,"مُلْتَحَدًۭا","a refuge","تَجِدَ مِن دُونِهِۦ","",2494],["22:25:20",335,"بِإِلْحَادٍۭ","of deviation","وَمَن يُرِدْ فِيهِ","بِظُلْمٍۢ نُّذِقْهُ مِنْ",2927],["41:40:3",481,"يُلْحِدُونَ","distort","إِنَّ ٱلَّذِينَ","فِىٓ ءَايَـٰتِنَا لَا",2080],["72:22:12",573,"مُلْتَحَدًا","any refuge","أَجِدَ مِن دُونِهِۦ","",2494]]