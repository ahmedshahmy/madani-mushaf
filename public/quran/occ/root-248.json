[["2:76:15",11,"فَتَحَ","has","قَالُوٓا۟ أَتُحَدِّثُونَهُم بِمَا","ٱللَّهُ عَلَيْكُمْ لِيُحَآجُّوكُم",594],["2:89:13",14,"يَسْتَفْتِحُونَ","(that), pray for victory","وَكَانُوا۟ مِن قَبْلُ","عَلَى ٱلَّذِينَ كَفَرُوا۟",2106],["4:141:7",101,"فَتْحٌۭ","a victory","فَإِن كَانَ لَكُمْ","مِّنَ ٱللَّهِ قَالُوٓا۟",729],["5:52:17",117,"بِٱلْفَتْحِ","the victory","ٱللَّهُ أَن يَأْتِىَ","أَوْ أَمْرٍۢ مِّنْ",729],["6:44:6",132,"فَتَحْنَا","We opened","مَا ذُكِّرُوا۟ بِهِۦ","عَلَيْهِمْ أَبْوَٰبَ كُلِّ",594],["6:59:2",134,"مَفَاتِحُ","(are the) keys","۞ وَعِندَهُۥ","ٱلْغَيْبِ لَا يَعْلَمُهَآ",1887],["7:40:8",155,"تُفَتَّحُ","be opened","وَٱسْتَكْبَرُوا۟ عَنْهَا لَا","لَهُمْ أَبْوَٰبُ ٱلسَّمَآءِ",4460],["7:89:35",162,"ٱفْتَحْ","Decide","ٱللَّهِ تَوَكَّلْنَا ۚ رَبَّنَا","بَيْنَنَا وَبَيْنَ قَوْمِنَا",594],["7:89:42",162,"ٱلْفَـٰتِحِينَ","(of) those who Decide","بِٱلْحَقِّ وَأَنتَ خَيْرُ","",3407],["7:96:7",163,"لَفَتَحْنَا","surely We (would have) opened","ٱلْقُرَىٰٓ ءَامَنُوا۟ وَٱتَّقَوْا۟","عَلَيْهِم بَرَكَـٰتٍۢ مِّنَ",594],["8:19:2",179,"تَسْتَفْتِحُوا۟","you ask for victory","إِن","فَقَدْ جَآءَكُمُ ٱلْفَتْحُ ۖ",2106],["8:19:5",179,"ٱلْفَتْحُ ۖ","the victory","تَسْتَفْتِحُوا۟ فَقَدْ جَآءَكُمُ","وَإِن تَنتَهُوا۟ فَهُوَ",729],["12:65:2",243,"فَتَحُوا۟","they opened","وَلَمَّا","مَتَـٰعَهُمْ وَجَدُوا۟ بِضَـٰعَتَهُمْ",594],["14:15:1",257,"وَٱسْتَفْتَحُوا۟","And they sought victory","","وَخَابَ كُلُّ جَبَّارٍ",2106],["15:14:2",262,"فَتَحْنَا","We opened","وَلَوْ","عَلَيْهِم بَابًۭا مِّنَ",594],["21:96:3",330,"فُتِحَتْ","has been opened","حَتَّىٰٓ إِذَا","يَأْجُوجُ وَمَأْجُوجُ وَهُم",594],["23:77:3",347,"فَتَحْنَا","We opened","حَتَّىٰٓ إِذَا","عَلَيْهِم بَابًۭا ذَا",594],["24:61:47",358,"مَّفَاتِحَهُۥٓ","its keys","أَوْ مَا مَلَكْتُم","أَوْ صَدِيقِكُمْ ۚ لَيْسَ",1887],["26:118:1",372,"فَٱفْتَحْ","So judge","","بَيْنِى وَبَيْنَهُمْ فَتْحًۭا",594],["26:118:4",372,"فَتْحًۭا","(with decisive) judgment","فَٱفْتَحْ بَيْنِى وَبَيْنَهُمْ","وَنَجِّنِى وَمَن مَّعِىَ",729],["28:76:14",394,"مَفَاتِحَهُۥ","(the) keys of it","ٱلْكُنُوزِ مَآ إِنَّ","لَتَنُوٓأُ بِٱلْعُصْبَةِ أُو۟لِى",1887],["32:28:4",417,"ٱلْفَتْحُ","decision","وَيَقُولُونَ مَتَىٰ هَـٰذَا","إِن كُنتُمْ صَـٰدِقِينَ",729],["32:29:3",417,"ٱلْفَتْحِ","(of) the Decision","قُلْ يَوْمَ","لَا يَنفَعُ ٱلَّذِينَ",729],["34:26:6",431,"يَفْتَحُ","He will judge","بَيْنَنَا رَبُّنَا ثُمَّ","بَيْنَنَا بِٱلْحَقِّ وَهُوَ",594],["34:26:10",431,"ٱلْفَتَّاحُ","(is) the Judge","بَيْنَنَا بِٱلْحَقِّ وَهُوَ","ٱلْعَلِيمُ",3428],["35:2:2",434,"يَفْتَحِ","Allah grants","مَّا","ٱللَّهُ لِلنَّاسِ مِن",594],["38:50:3",456,"مُّفَتَّحَةًۭ","(will be) opened","جَنَّـٰتِ عَدْنٍۢ","لَّهُمُ ٱلْأَبْوَٰبُ",3964],["39:71:10",466,"فُتِحَتْ","(will) be opened","حَتَّىٰٓ إِذَا جَآءُوهَا","أَبْوَٰبُهَا وَقَالَ لَهُمْ",594],["39:73:11",466,"وَفُتِحَتْ","and (will) be opened","حَتَّىٰٓ إِذَا جَآءُوهَا","أَبْوَٰبُهَا وَقَالَ لَهُمْ",594],["48:1:2",511,"فَتَحْنَا","We have given victory","إِنَّا","لَكَ فَتْحًۭا مُّبِينًۭا",594],["48:1:4",511,"فَتْحًۭا","a victory","إِنَّا فَتَحْنَا لَكَ","مُّبِينًۭا",729],["48:18:18",513,"فَتْحًۭا","(with) a victory","ٱلسَّكِينَةَ عَلَيْهِمْ وَأَثَـٰبَهُمْ","قَرِيبًۭا",729],["48:27:27",514,"فَتْحًۭا","a victory","مِن دُونِ ذَٰلِكَ","قَرِيبًا",729],["54:11:1",529,"فَفَتَحْنَآ","So We opened","","أَبْوَٰبَ ٱلسَّمَآءِ بِمَآءٍۢ",594],["57:10:19",538,"ٱلْفَتْحِ","the victory","أَنفَقَ مِن قَبْلِ","وَقَـٰتَلَ ۚ أُو۟لَـٰٓئِكَ أَعْظَمُ",729],["61:13:6",552,"وَفَتْحٌۭ","and a victory","نَصْرٌۭ مِّنَ ٱللَّهِ","قَرِيبٌۭ ۗ وَبَشِّرِ ٱلْمُؤْمِنِينَ",729],["78:19:1",582,"وَفُتِحَتِ","And is opened","","ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا",594],["110:1:5",603,"وَٱلْفَتْحُ","and the Victory","جَآءَ نَصْرُ ٱللَّهِ","",729]]