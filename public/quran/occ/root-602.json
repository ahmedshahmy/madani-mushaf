[["7:148:7",168,"حُلِيِّهِمْ","their ornaments","مِنۢ بَعْدِهِۦ مِنْ","عِجْلًۭا جَسَدًۭا لَّهُۥ",3221],["13:17:18",251,"حِلْيَةٍ","ornaments","فِى ٱلنَّارِ ٱبْتِغَآءَ","أَوْ مَتَـٰعٍۢ زَبَدٌۭ",1514],["16:14:11",268,"حِلْيَةًۭ","ornaments","طَرِيًّۭا وَتَسْتَخْرِجُوا۟ مِنْهُ","تَلْبَسُونَهَا وَتَرَى ٱلْفُلْكَ",1514],["18:31:9",297,"يُحَلَّوْنَ","They will be adorned","مِن تَحْتِهِمُ ٱلْأَنْهَـٰرُ","فِيهَا مِنْ أَسَاوِرَ",1515],["22:23:13",334,"يُحَلَّوْنَ","They will be adorned","مِن تَحْتِهَا ٱلْأَنْهَـٰرُ","فِيهَا مِنْ أَسَاوِرَ",1515],["35:12:18",436,"حِلْيَةًۭ","ornaments","لَحْمًۭا طَرِيًّۭا وَتَسْتَخْرِجُونَ","تَلْبَسُونَهَا ۖ وَتَرَى ٱلْفُلْكَ",1514],["35:33:4",438,"يُحَلَّوْنَ","They will be adorned","جَنَّـٰتُ عَدْنٍۢ يَدْخُلُونَهَا","فِيهَا مِنْ أَسَاوِرَ",1515],["43:18:4",490,"ٱلْحِلْيَةِ","ornaments","أَوَمَن يُنَشَّؤُا۟ فِى","وَهُوَ فِى ٱلْخِصَامِ",1514],["76:21:6",579,"وَحُلُّوٓا۟","And they will be adorned","سُندُسٍ خُضْرٌۭ وَإِسْتَبْرَقٌۭ ۖ","أَسَاوِرَ مِن فِضَّةٍۢ",1515]]