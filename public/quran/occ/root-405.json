[["2:147:7",23,"ٱلْمُمْتَرِينَ","the doubters","فَلَا تَكُونَنَّ مِنَ","",1592],["3:60:7",57,"ٱلْمُمْتَرِينَ","the doubters","فَلَا تَكُن مِّنَ","",1592],["6:2:14",128,"تَمْتَرُونَ","doubt","عِندَهُۥ ۖ ثُمَّ أَنتُمْ","",1432],["6:114:23",142,"ٱلْمُمْتَرِينَ","the ones who doubt","فَلَا تَكُونَنَّ مِنَ","",1592],["10:94:22",219,"ٱلْمُمْتَرِينَ","the doubters","فَلَا تَكُونَنَّ مِنَ","",1592],["11:17:29",223,"مِرْيَةٍۢ","doubt","فَلَا تَكُ فِى","مِّنْهُ ۚ إِنَّهُ ٱلْحَقُّ",1359],["11:109:4",234,"مِرْيَةٍۢ","doubt","فَلَا تَكُ فِى","مِّمَّا يَعْبُدُ هَـٰٓؤُلَآءِ ۚ",1359],["15:63:7",265,"يَمْتَرُونَ","disputing","بِمَا كَانُوا۟ فِيهِ","",1432],["18:22:24",296,"تُمَارِ","argue","إِلَّا قَلِيلٌۭ ۗ فَلَا","فِيهِمْ إِلَّا مِرَآءًۭ",4463],["18:22:27",296,"مِرَآءًۭ","(with) an argument","تُمَارِ فِيهِمْ إِلَّا","ظَـٰهِرًۭا وَلَا تَسْتَفْتِ",3743],["19:34:9",307,"يَمْتَرُونَ","they dispute","ٱلْحَقِّ ٱلَّذِى فِيهِ","",1432],["22:55:6",338,"مِرْيَةٍۢ","doubt","ٱلَّذِينَ كَفَرُوا۟ فِى","مِّنْهُ حَتَّىٰ تَأْتِيَهُمُ",1359],["32:23:8",417,"مِرْيَةٍۢ","doubt","فَلَا تَكُن فِى","مِّن لِّقَآئِهِۦ ۖ وَجَعَلْنَـٰهُ",1359],["41:54:4",482,"مِرْيَةٍۢ","doubt","أَلَآ إِنَّهُمْ فِى","مِّن لِّقَآءِ رَبِّهِمْ ۗ",1359],["42:18:17",485,"يُمَارُونَ","dispute","أَلَآ إِنَّ ٱلَّذِينَ","فِى ٱلسَّاعَةِ لَفِى",1648],["43:61:5",494,"تَمْتَرُنَّ","(be) doubtful","لَعِلْمٌۭ لِّلسَّاعَةِ فَلَا","بِهَا وَٱتَّبِعُونِ ۚ هَـٰذَا",1432],["44:50:6",498,"تَمْتَرُونَ","doubt","مَا كُنتُم بِهِۦ","",1432],["53:12:1",526,"أَفَتُمَـٰرُونَهُۥ","Then will you dispute with him","","عَلَىٰ مَا يَرَىٰ",1648],["53:55:4",528,"تَتَمَارَىٰ","will you doubt","فَبِأَىِّ ءَالَآءِ رَبِّكَ","",1648],["54:36:4",530,"فَتَمَارَوْا۟","but they disputed","وَلَقَدْ أَنذَرَهُم بَطْشَتَنَا","بِٱلنُّذُرِ",1648]]