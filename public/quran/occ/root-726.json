[["4:22:15",81,"وَمَقْتًۭا","and hateful","إِنَّهُۥ كَانَ فَـٰحِشَةًۭ","وَسَآءَ سَبِيلًا",1197],["35:39:18",439,"مَقْتًۭا ۖ","(in) hatred","عِندَ رَبِّهِمْ إِلَّا","وَلَا يَزِيدُ ٱلْكَـٰفِرِينَ",1197],["40:10:5",468,"لَمَقْتُ","Certainly Allah's hatred","ٱلَّذِينَ كَفَرُوا۟ يُنَادَوْنَ","ٱللَّهِ أَكْبَرُ مِن",1197],["40:10:9",468,"مَّقْتِكُمْ","your hatred","ٱللَّهِ أَكْبَرُ مِن","أَنفُسَكُمْ إِذْ تُدْعَوْنَ",1197],["40:35:10",471,"مَقْتًا","hateful","سُلْطَـٰنٍ أَتَىٰهُمْ ۖ كَبُرَ","عِندَ ٱللَّهِ وَعِندَ",1197],["61:3:2",551,"مَقْتًا","hatred","كَبُرَ","عِندَ ٱللَّهِ أَن",1197]]