[["2:87:22",13,"تَهْوَىٰٓ","desire","رَسُولٌۢ بِمَا لَا","أَنفُسُكُمُ ٱسْتَكْبَرْتُمْ فَفَرِيقًۭا",975],["2:120:18",19,"أَهْوَآءَهُم","their desires","ٱلْهُدَىٰ ۗ وَلَئِنِ ٱتَّبَعْتَ","بَعْدَ ٱلَّذِى جَآءَكَ",563],["2:145:22",22,"أَهْوَآءَهُم","their desires","بَعْضٍۢ ۚ وَلَئِنِ ٱتَّبَعْتَ","مِّنۢ بَعْدِ مَا",563],["4:135:25",100,"ٱلْهَوَىٰٓ","the desire","بِهِمَا ۖ فَلَا تَتَّبِعُوا۟","أَن تَعْدِلُوا۟ ۚ وَإِن",783],["5:48:20",116,"أَهْوَآءَهُمْ","their vain desires","ٱللَّهُ ۖ وَلَا تَتَّبِعْ","عَمَّا جَآءَكَ مِنَ",563],["5:49:9",116,"أَهْوَآءَهُمْ","their vain desires","ٱللَّهُ وَلَا تَتَّبِعْ","وَٱحْذَرْهُمْ أَن يَفْتِنُوكَ",563],["5:70:14",119,"تَهْوَىٰٓ","desired","رَسُولٌۢ بِمَا لَا","أَنفُسُهُمْ فَرِيقًۭا كَذَّبُوا۟",975],["5:77:12",120,"أَهْوَآءَ","(vain) desires","ٱلْحَقِّ وَلَا تَتَّبِعُوٓا۟","قَوْمٍۢ قَدْ ضَلُّوا۟",563],["6:56:14",134,"أَهْوَآءَكُمْ ۙ","your (vain) desires","قُل لَّآ أَتَّبِعُ","قَدْ ضَلَلْتُ إِذًۭا",563],["6:71:19",136,"ٱسْتَهْوَتْهُ","whom (has been) enticed","هَدَىٰنَا ٱللَّهُ كَٱلَّذِى","ٱلشَّيَـٰطِينُ فِى ٱلْأَرْضِ",4831],["6:119:23",143,"بِأَهْوَآئِهِم","by their (vain) desires","وَإِنَّ كَثِيرًۭا لَّيُضِلُّونَ","بِغَيْرِ عِلْمٍ ۗ إِنَّ",563],["6:150:17",148,"أَهْوَآءَ","(the) desires","مَعَهُمْ ۚ وَلَا تَتَّبِعْ","ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا",563],["7:176:10",173,"هَوَىٰهُ ۚ","his (vain) desires","إِلَى ٱلْأَرْضِ وَٱتَّبَعَ","فَمَثَلُهُۥ كَمَثَلِ ٱلْكَلْبِ",783],["13:37:7",254,"أَهْوَآءَهُم","their desires","عَرَبِيًّۭا ۚ وَلَئِنِ ٱتَّبَعْتَ","بَعْدَ مَا جَآءَكَ مِنَ",563],["14:37:20",260,"تَهْوِىٓ","incline","أَفْـِٔدَةًۭ مِّنَ ٱلنَّاسِ","إِلَيْهِمْ وَٱرْزُقْهُم مِّنَ",975],["14:43:9",261,"هَوَآءٌۭ","(are) empty","إِلَيْهِمْ طَرْفُهُمْ ۖ وَأَفْـِٔدَتُهُمْ","",783],["18:28:27",297,"هَوَىٰهُ","his desires","عَن ذِكْرِنَا وَٱتَّبَعَ","وَكَانَ أَمْرُهُۥ فُرُطًۭا",783],["20:16:9",313,"هَوَىٰهُ","his desires","يُؤْمِنُ بِهَا وَٱتَّبَعَ","فَتَرْدَىٰ",783],["20:81:17",317,"هَوَىٰ","he (has) perished","عَلَيْهِ غَضَبِى فَقَدْ","",975],["22:31:16",336,"تَهْوِى","had blown","فَتَخْطَفُهُ ٱلطَّيْرُ أَوْ","بِهِ ٱلرِّيحُ فِى",975],["23:71:4",346,"أَهْوَآءَهُمْ","their desires","وَلَوِ ٱتَّبَعَ ٱلْحَقُّ","لَفَسَدَتِ ٱلسَّمَـٰوَٰتُ وَٱلْأَرْضُ",563],["25:43:5",363,"هَوَىٰهُ","his own desire","مَنِ ٱتَّخَذَ إِلَـٰهَهُۥ","أَفَأَنتَ تَكُونُ عَلَيْهِ",783],["28:50:8",391,"أَهْوَآءَهُمْ ۚ","their desires","فَٱعْلَمْ أَنَّمَا يَتَّبِعُونَ","وَمَنْ أَضَلُّ مِمَّنِ",563],["28:50:13",391,"هَوَىٰهُ","his own desire","أَضَلُّ مِمَّنِ ٱتَّبَعَ","بِغَيْرِ هُدًۭى مِّنَ",783],["30:29:5",407,"أَهْوَآءَهُم","their desires","ٱتَّبَعَ ٱلَّذِينَ ظَلَمُوٓا۟","بِغَيْرِ عِلْمٍۢ ۖ فَمَن",563],["38:26:13",454,"ٱلْهَوَىٰ","the desire","بِٱلْحَقِّ وَلَا تَتَّبِعِ","فَيُضِلَّكَ عَن سَبِيلِ",783],["42:15:8",484,"أَهْوَآءَهُمْ ۖ","their desires","أُمِرْتَ ۖ وَلَا تَتَّبِعْ","وَقُلْ ءَامَنتُ بِمَآ",563],["45:18:10",500,"أَهْوَآءَ","(the) desires","فَٱتَّبِعْهَا وَلَا تَتَّبِعْ","ٱلَّذِينَ لَا يَعْلَمُونَ",563],["45:23:5",501,"هَوَىٰهُ","his desire","مَنِ ٱتَّخَذَ إِلَـٰهَهُۥ","وَأَضَلَّهُ ٱللَّهُ عَلَىٰ",783],["47:14:13",508,"أَهْوَآءَهُم","their desires","سُوٓءُ عَمَلِهِۦ وَٱتَّبَعُوٓا۟","",563],["47:16:24",508,"أَهْوَآءَهُمْ","their desires","عَلَىٰ قُلُوبِهِمْ وَٱتَّبَعُوٓا۟","",563],["53:1:3",526,"هَوَىٰ","it goes down","وَٱلنَّجْمِ إِذَا","",975],["53:3:4",526,"ٱلْهَوَىٰٓ","the desire","وَمَا يَنطِقُ عَنِ","",783],["53:23:19",526,"تَهْوَى","desire","إِلَّا ٱلظَّنَّ وَمَا","ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم",975],["53:53:2",528,"أَهْوَىٰ","He overthrew","وَٱلْمُؤْتَفِكَةَ","",975],["54:3:3",528,"أَهْوَآءَهُمْ ۚ","their desires","وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟","وَكُلُّ أَمْرٍۢ مُّسْتَقِرٌّۭ",563],["79:40:9",584,"ٱلْهَوَىٰ","the vain desires","وَنَهَى ٱلنَّفْسَ عَنِ","",783],["101:9:2",600,"هَاوِيَةٌۭ","(will be the) Pit","فَأُمُّهُۥ","",3484]]