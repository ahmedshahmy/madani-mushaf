[["2:106:2",17,"نَنسَخْ","We abrogate","۞ مَا","مِنْ ءَايَةٍ أَوْ",2775],["7:154:9",169,"نُسْخَتِهَا","their inscription","أَخَذَ ٱلْأَلْوَاحَ ۖ وَفِى","هُدًۭى وَرَحْمَةٌۭ لِّلَّذِينَ",4071],["22:52:16",338,"فَيَنسَخُ","But Allah abolishes","ٱلشَّيْطَـٰنُ فِىٓ أُمْنِيَّتِهِۦ","ٱللَّهُ مَا يُلْقِى",2775],["45:29:8",501,"نَسْتَنسِخُ","transcribe","بِٱلْحَقِّ ۚ إِنَّا كُنَّا","مَا كُنتُمْ تَعْمَلُونَ",4050]]