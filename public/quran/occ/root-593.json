[["2:217:30",34,"يَزَالُونَ","they will cease","مِنَ ٱلْقَتْلِ ۗ وَلَا","يُقَـٰتِلُونَكُمْ حَتَّىٰ يَرُدُّوكُمْ",1019],["5:13:18",109,"تَزَالُ","will you cease","ذُكِّرُوا۟ بِهِۦ ۚ وَلَا","تَطَّلِعُ عَلَىٰ خَآئِنَةٍۢ",1019],["9:110:2",204,"يَزَالُ","(will) cease","لَا","بُنْيَـٰنُهُمُ ٱلَّذِى بَنَوْا۟",1019],["10:28:11",212,"فَزَيَّلْنَا","Then We will separate","مَكَانَكُمْ أَنتُمْ وَشُرَكَآؤُكُمْ ۚ","بَيْنَهُمْ ۖ وَقَالَ شُرَكَآؤُهُم",4766],["11:118:9",235,"يَزَالُونَ","they will cease","أُمَّةًۭ وَٰحِدَةًۭ ۖ وَلَا","مُخْتَلِفِينَ",1019],["13:31:31",253,"يَزَالُ","will cease","ٱلنَّاسَ جَمِيعًۭا ۗ وَلَا","ٱلَّذِينَ كَفَرُوا۟ تُصِيبُهُم",1019],["21:15:2",323,"زَالَت","ceased","فَمَا","تِّلْكَ دَعْوَىٰهُمْ حَتَّىٰ",1019],["22:55:2",338,"يَزَالُ","will cease","وَلَا","ٱلَّذِينَ كَفَرُوا۟ فِى",1019],["40:34:8",471,"زِلْتُمْ","you ceased","قَبْلُ بِٱلْبَيِّنَـٰتِ فَمَا","فِى شَكٍّۢ مِّمَّا",1019],["48:25:34",514,"تَزَيَّلُوا۟","they had been apart","مَن يَشَآءُ ۚ لَوْ","لَعَذَّبْنَا ٱلَّذِينَ كَفَرُوا۟",4443]]