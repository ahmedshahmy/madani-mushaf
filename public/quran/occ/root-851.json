[["12:50:14",241,"بَالُ","(is the) case","رَبِّكَ فَسْـَٔلْهُ مَا","ٱلنِّسْوَةِ ٱلَّـٰتِى قَطَّعْنَ",1534],["20:51:3",314,"بَالُ","(is the) case","قَالَ فَمَا","ٱلْقُرُونِ ٱلْأُولَىٰ",1534],["47:2:18",507,"بَالَهُمْ","their condition","عَنْهُمْ سَيِّـَٔاتِهِمْ وَأَصْلَحَ","",1534],["47:5:3",507,"بَالَهُمْ","their condition","سَيَهْدِيهِمْ وَيُصْلِحُ","",1534]]