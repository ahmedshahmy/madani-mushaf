[["2:32:5",6,"لَنَآ","(is) for us","سُبْحَـٰنَكَ لَا عِلْمَ","إِلَّا مَا عَلَّمْتَنَآ ۖ",124],["2:61:10",9,"لَنَا","for us","طَعَامٍۢ وَٰحِدٍۢ فَٱدْعُ","رَبَّكَ يُخْرِجْ لَنَا",124],["2:61:13",9,"لَنَا","for us","لَنَا رَبَّكَ يُخْرِجْ","مِمَّا تُنۢبِتُ ٱلْأَرْضُ",124],["2:68:3",10,"لَنَا","for us","قَالُوا۟ ٱدْعُ","رَبَّكَ يُبَيِّن لَّنَا",124],["2:68:6",10,"لَّنَا","to us","لَنَا رَبَّكَ يُبَيِّن","مَا هِىَ ۚ قَالَ",124],["2:69:3",10,"لَنَا","for us","قَالُوا۟ ٱدْعُ","رَبَّكَ يُبَيِّن لَّنَا",124],["2:69:6",10,"لَّنَا","to us","لَنَا رَبَّكَ يُبَيِّن","مَا لَوْنُهَا ۚ قَالَ",124],["2:70:3",11,"لَنَا","for us","قَالُوا۟ ٱدْعُ","رَبَّكَ يُبَيِّن لَّنَا",124],["2:70:6",11,"لَّنَا","to us","لَنَا رَبَّكَ يُبَيِّن","مَا هِىَ إِنَّ",124],["2:139:8",21,"وَلَنَآ","And for us","وَهُوَ رَبُّنَا وَرَبُّكُمْ","أَعْمَـٰلُنَا وَلَكُمْ أَعْمَـٰلُكُمْ",124],["2:167:6",25,"لَنَا","for us","ٱتَّبَعُوا۟ لَوْ أَنَّ","كَرَّةًۭ فَنَتَبَرَّأَ مِنْهُمْ",124],["2:246:16",40,"لَنَا","for us","لِنَبِىٍّۢ لَّهُمُ ٱبْعَثْ","مَلِكًۭا نُّقَـٰتِلْ فِى",124],["2:246:33",40,"لَنَآ","for us","تُقَـٰتِلُوا۟ ۖ قَالُوا۟ وَمَا","أَلَّا نُقَـٰتِلَ فِى",124],["2:249:39",41,"لَنَا","for us","قَالُوا۟ لَا طَاقَةَ","ٱلْيَوْمَ بِجَالُوتَ وَجُنُودِهِۦ ۚ",124],["2:286:37",49,"لَنَا","we have","مَا لَا طَاقَةَ","بِهِۦ ۖ وَٱعْفُ عَنَّا",124],["2:286:42",49,"لَنَا","[for] us","وَٱعْفُ عَنَّا وَٱغْفِرْ","وَٱرْحَمْنَآ ۚ أَنتَ مَوْلَىٰنَا",124],["3:8:9",50,"لَنَا","(for) us","إِذْ هَدَيْتَنَا وَهَبْ","مِن لَّدُنكَ رَحْمَةً ۚ",124],["3:16:7",52,"لَنَا","for us","إِنَّنَآ ءَامَنَّا فَٱغْفِرْ","ذُنُوبَنَا وَقِنَا عَذَابَ",124],["3:147:9",68,"لَنَا","for us","قَالُوا۟ رَبَّنَا ٱغْفِرْ","ذُنُوبَنَا وَإِسْرَافَنَا فِىٓ",124],["3:154:24",70,"لَّنَا","for us","ٱلْجَـٰهِلِيَّةِ ۖ يَقُولُونَ هَل","مِنَ ٱلْأَمْرِ مِن",124],["3:154:44",70,"لَنَا","for us","يَقُولُونَ لَوْ كَانَ","مِنَ ٱلْأَمْرِ شَىْءٌۭ",124],["3:193:13",75,"لَنَا","for us","فَـَٔامَنَّا ۚ رَبَّنَا فَٱغْفِرْ","ذُنُوبَنَا وَكَفِّرْ عَنَّا",124],["4:75:23",90,"لَّنَا","for us","ٱلظَّالِمِ أَهْلُهَا وَٱجْعَل","مِن لَّدُنكَ وَلِيًّۭا",124],["4:75:28",90,"لَّنَا","for us","لَّدُنكَ وَلِيًّۭا وَٱجْعَل","مِن لَّدُنكَ نَصِيرًا",124],["5:84:2",122,"لَنَا","for us (that)","وَمَا","لَا نُؤْمِنُ بِٱللَّهِ",124],["5:109:11",126,"لَنَآ ۖ","for us","قَالُوا۟ لَا عِلْمَ","إِنَّكَ أَنتَ عَلَّـٰمُ",124],["5:114:13",127,"لَنَا","for us","مِّنَ ٱلسَّمَآءِ تَكُونُ","عِيدًۭا لِّأَوَّلِنَا وَءَاخِرِنَا",124],["6:128:22",144,"لَنَا ۚ","for us","أَجَلَنَا ٱلَّذِىٓ أَجَّلْتَ","قَالَ ٱلنَّارُ مَثْوَىٰكُمْ",124],["6:148:29",148,"لَنَآ ۖ","for us","مِّنْ عِلْمٍۢ فَتُخْرِجُوهُ","إِن تَتَّبِعُونَ إِلَّا",124],["7:23:8",153,"لَنَا","[for] us","وَإِن لَّمْ تَغْفِرْ","وَتَرْحَمْنَا لَنَكُونَنَّ مِنَ",124],["7:53:19",157,"لَّنَا","for us","رَبِّنَا بِٱلْحَقِّ فَهَل","مِن شُفَعَآءَ فَيَشْفَعُوا۟",124],["7:53:23",157,"لَنَآ","for us","مِن شُفَعَآءَ فَيَشْفَعُوا۟","أَوْ نُرَدُّ فَنَعْمَلَ",124],["7:89:17",162,"لَنَآ","for us","مِنْهَا ۚ وَمَا يَكُونُ","أَن نَّعُودَ فِيهَآ",124],["7:113:6",164,"لَنَا","for us","فِرْعَوْنَ قَالُوٓا۟ إِنَّ","لَأَجْرًا إِن كُنَّا",124],["7:131:5",166,"لَنَا","For us","جَآءَتْهُمُ ٱلْحَسَنَةُ قَالُوا۟","هَـٰذِهِۦ ۖ وَإِن تُصِبْهُمْ",124],["7:134:8",166,"لَنَا","for us","قَالُوا۟ يَـٰمُوسَى ٱدْعُ","رَبَّكَ بِمَا عَهِدَ",124],["7:138:15",167,"لَّنَآ","for us","قَالُوا۟ يَـٰمُوسَى ٱجْعَل","إِلَـٰهًۭا كَمَا لَهُمْ",124],["7:149:15",168,"لَنَا","[for] us","يَرْحَمْنَا رَبُّنَا وَيَغْفِرْ","لَنَكُونَنَّ مِنَ ٱلْخَـٰسِرِينَ",124],["7:155:37",169,"لَنَا","us","أَنتَ وَلِيُّنَا فَٱغْفِرْ","وَٱرْحَمْنَا ۖ وَأَنتَ خَيْرُ",124],["7:156:2",170,"لَنَا","for us","۞ وَٱكْتُبْ","فِى هَـٰذِهِ ٱلدُّنْيَا",124],["7:169:13",172,"لَنَا","for us","ٱلْأَدْنَىٰ وَيَقُولُونَ سَيُغْفَرُ","وَإِن يَأْتِهِمْ عَرَضٌۭ",124],["9:51:8",195,"لَنَا","for us","مَا كَتَبَ ٱللَّهُ","هُوَ مَوْلَىٰنَا ۚ وَعَلَى",124],["9:52:4",195,"بِنَآ","for us","قُلْ هَلْ تَرَبَّصُونَ","إِلَّآ إِحْدَى ٱلْحُسْنَيَيْنِ ۖ",124],["11:79:5",230,"لَنَا","we have","لَقَدْ عَلِمْتَ مَا","فِى بَنَاتِكَ مِنْ",124],["12:17:15",237,"لَّنَا","us","وَمَآ أَنتَ بِمُؤْمِنٍۢ","وَلَوْ كُنَّا صَـٰدِقِينَ",124],["12:38:9",240,"لَنَآ","for us","وَيَعْقُوبَ ۚ مَا كَانَ","أَن نُّشْرِكَ بِٱللَّهِ",124],["12:88:14",246,"لَنَا","to us","بِبِضَـٰعَةٍۢ مُّزْجَىٰةٍۢ فَأَوْفِ","ٱلْكَيْلَ وَتَصَدَّقْ عَلَيْنَآ ۖ",124],["12:97:4",247,"لَنَا","for us","قَالُوا۟ يَـٰٓأَبَانَا ٱسْتَغْفِرْ","ذُنُوبَنَآ إِنَّا كُنَّا",124],["14:11:19",257,"لَنَآ","for us","عِبَادِهِۦ ۖ وَمَا كَانَ","أَن نَّأْتِيَكُم بِسُلْطَـٰنٍ",124],["14:12:2",257,"لَنَآ","(is) for us","وَمَا","أَلَّا نَتَوَكَّلَ عَلَى",124],["14:21:32",258,"لَنَا","(is) for us","أَمْ صَبَرْنَا مَا","مِن مَّحِيصٍۢ",124],["17:5:8",282,"لَّنَآ","of Ours","بَعَثْنَا عَلَيْكُمْ عِبَادًۭا","أُو۟لِى بَأْسٍۢ شَدِيدٍۢ",124],["17:90:7",291,"لَنَا","for us","لَكَ حَتَّىٰ تَفْجُرَ","مِنَ ٱلْأَرْضِ يَنۢبُوعًا",124],["18:10:13",294,"لَنَا","for us","لَّدُنكَ رَحْمَةًۭ وَهَيِّئْ","مِنْ أَمْرِنَا رَشَدًۭا",124],["20:35:3",313,"بِنَا","of us","إِنَّكَ كُنتَ","بَصِيرًۭا",124],["20:73:5",316,"لَنَا","for us","ءَامَنَّا بِرَبِّنَا لِيَغْفِرَ","خَطَـٰيَـٰنَا وَمَآ أَكْرَهْتَنَا",124],["21:47:19",326,"بِنَا","(are) We","أَتَيْنَا بِهَا ۗ وَكَفَىٰ","حَـٰسِبِينَ",124],["21:73:14",328,"لَنَا","of Us","وَإِيتَآءَ ٱلزَّكَوٰةِ ۖ وَكَانُوا۟","عَـٰبِدِينَ",124],["21:90:18",329,"لَنَا","to Us","رَغَبًۭا وَرَهَبًۭا ۖ وَكَانُوا۟","خَـٰشِعِينَ",124],["23:47:6",345,"لَنَا","for us","لِبَشَرَيْنِ مِثْلِنَا وَقَوْمُهُمَا","عَـٰبِدُونَ",124],["23:109:10",349,"لَنَا","us","رَبَّنَآ ءَامَنَّا فَٱغْفِرْ","وَٱرْحَمْنَا وَأَنتَ خَيْرُ",124],["24:16:7",351,"لَنَآ","for us","قُلْتُم مَّا يَكُونُ","أَن نَّتَكَلَّمَ بِهَـٰذَا",124],["25:18:6",361,"لَنَآ","for us","مَا كَانَ يَنۢبَغِى","أَن نَّتَّخِذَ مِن",124],["25:74:5",366,"لَنَا","to us","يَقُولُونَ رَبَّنَا هَبْ","مِنْ أَزْوَٰجِنَا وَذُرِّيَّـٰتِنَا",124],["26:41:7",369,"لَنَا","for us","قَالُوا۟ لِفِرْعَوْنَ أَئِنَّ","لَأَجْرًا إِن كُنَّا",124],["26:51:5",369,"لَنَا","us","نَطْمَعُ أَن يَغْفِرَ","رَبُّنَا خَطَـٰيَـٰنَآ أَن",124],["26:55:2",369,"لَنَا","[to] us","وَإِنَّهُمْ","لَغَآئِظُونَ",124],["26:100:2",371,"لَنَا","we have","فَمَا","مِن شَـٰفِعِينَ",124],["26:102:3",371,"لَنَا","we had","فَلَوْ أَنَّ","كَرَّةًۭ فَنَكُونَ مِنَ",124],["28:25:14",388,"لَنَا ۚ","for us","أَجْرَ مَا سَقَيْتَ","فَلَمَّا جَآءَهُۥ وَقَصَّ",124],["28:55:7",392,"لَنَآ","For us","أَعْرَضُوا۟ عَنْهُ وَقَالُوا۟","أَعْمَـٰلُنَا وَلَكُمْ أَعْمَـٰلُكُمْ",124],["28:79:12",395,"لَنَا","for us","ٱلْحَيَوٰةَ ٱلدُّنْيَا يَـٰلَيْتَ","مِثْلَ مَآ أُوتِىَ",124],["28:82:22",395,"بِنَا ۖ","He would have caused it to swallow us","ٱللَّهُ عَلَيْنَا لَخَسَفَ","وَيْكَأَنَّهُۥ لَا يُفْلِحُ",124],["36:78:2",445,"لَنَا","for Us","وَضَرَبَ","مَثَلًۭا وَنَسِىَ خَلْقَهُۥ ۖ",124],["37:30:3",447,"لَنَا","for us","وَمَا كَانَ","عَلَيْكُم مِّن سُلْطَـٰنٍۭ ۖ",124],["38:16:4",453,"لَّنَا","for us","وَقَالُوا۟ رَبَّنَا عَجِّل","قِطَّنَا قَبْلَ يَوْمِ",124],["38:60:9",456,"لَنَا ۖ","upon us","بِكُمْ ۖ أَنتُمْ قَدَّمْتُمُوهُ","فَبِئْسَ ٱلْقَرَارُ",124],["38:61:5",456,"لَنَا","upon us","رَبَّنَا مَن قَدَّمَ","هَـٰذَا فَزِدْهُ عَذَابًۭا",124],["38:62:3",457,"لَنَا","for us","وَقَالُوا۟ مَا","لَا نَرَىٰ رِجَالًۭا",124],["42:15:22",484,"لَنَآ","For us","ٱللَّهُ رَبُّنَا وَرَبُّكُمْ ۖ","أَعْمَـٰلُنَا وَلَكُمْ أَعْمَـٰلُكُمْ ۖ",124],["43:13:15",490,"لَنَا","to us","سُبْحَـٰنَ ٱلَّذِى سَخَّرَ","هَـٰذَا وَمَا كُنَّا",124],["43:49:5",493,"لَنَا","for us","يَـٰٓأَيُّهَ ٱلسَّاحِرُ ٱدْعُ","رَبَّكَ بِمَا عَهِدَ",124],["48:11:10",512,"لَنَا ۚ","for us","أَمْوَٰلُنَا وَأَهْلُونَا فَٱسْتَغْفِرْ","يَقُولُونَ بِأَلْسِنَتِهِم مَّا",124],["59:10:8",547,"لَنَا","us","يَقُولُونَ رَبَّنَا ٱغْفِرْ","وَلِإِخْوَٰنِنَا ٱلَّذِينَ سَبَقُونَا",124],["60:5:8",549,"لَنَا","us","لِّلَّذِينَ كَفَرُوا۟ وَٱغْفِرْ","رَبَّنَآ ۖ إِنَّكَ أَنتَ",124],["66:8:37",561,"لَنَا","for us","يَقُولُونَ رَبَّنَآ أَتْمِمْ","نُورَنَا وَٱغْفِرْ لَنَآ ۖ",124],["66:8:40",561,"لَنَآ ۖ","to us","لَنَا نُورَنَا وَٱغْفِرْ","إِنَّكَ عَلَىٰ كُلِّ",124],["92:13:2",596,"لَنَا","for Us","وَإِنَّ","لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ",124]]