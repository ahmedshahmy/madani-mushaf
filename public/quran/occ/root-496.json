[["4:56:10",87,"جُلُودُهُم","their skins","نَارًۭا كُلَّمَا نَضِجَتْ","بَدَّلْنَـٰهُمْ جُلُودًا غَيْرَهَا",905],["4:56:12",87,"جُلُودًا","skins","نَضِجَتْ جُلُودُهُم بَدَّلْنَـٰهُمْ","غَيْرَهَا لِيَذُوقُوا۟ ٱلْعَذَابَ ۗ",905],["16:80:10",276,"جُلُودِ","the hides","وَجَعَلَ لَكُم مِّن","ٱلْأَنْعَـٰمِ بُيُوتًۭا تَسْتَخِفُّونَهَا",905],["22:20:6",334,"وَٱلْجُلُودُ","and the skins","مَا فِى بُطُونِهِمْ","",905],["24:2:3",350,"فَٱجْلِدُوا۟","[then] flog","ٱلزَّانِيَةُ وَٱلزَّانِى","كُلَّ وَٰحِدٍۢ مِّنْهُمَا",2834],["24:2:8",350,"جَلْدَةٍۢ ۖ","lash(es)","وَٰحِدٍۢ مِّنْهُمَا مِا۟ئَةَ","وَلَا تَأْخُذْكُم بِهِمَا",2399],["24:4:9",350,"فَٱجْلِدُوهُمْ","then flog them","يَأْتُوا۟ بِأَرْبَعَةِ شُهَدَآءَ","ثَمَـٰنِينَ جَلْدَةًۭ وَلَا",2834],["24:4:11",350,"جَلْدَةًۭ","lashe(s)","شُهَدَآءَ فَٱجْلِدُوهُمْ ثَمَـٰنِينَ","وَلَا تَقْبَلُوا۟ لَهُمْ",2399],["39:23:10",461,"جُلُودُ","(the) skins","مَّثَانِىَ تَقْشَعِرُّ مِنْهُ","ٱلَّذِينَ يَخْشَوْنَ رَبَّهُمْ",905],["39:23:16",461,"جُلُودُهُمْ","their skins","رَبَّهُمْ ثُمَّ تَلِينُ","وَقُلُوبُهُمْ إِلَىٰ ذِكْرِ",905],["41:20:9",478,"وَجُلُودُهُم","and their skins","عَلَيْهِمْ سَمْعُهُمْ وَأَبْصَـٰرُهُمْ","بِمَا كَانُوا۟ يَعْمَلُونَ",905],["41:21:2",479,"لِجُلُودِهِمْ","to their skins","وَقَالُوا۟","لِمَ شَهِدتُّمْ عَلَيْنَا ۖ",905],["41:22:11",479,"جُلُودُكُمْ","your skins","وَلَآ أَبْصَـٰرُكُمْ وَلَا","وَلَـٰكِن ظَنَنتُمْ أَنَّ",905]]