[["9:82:1",200,"فَلْيَضْحَكُوا۟","So let them laugh","","قَلِيلًۭا وَلْيَبْكُوا۟ كَثِيرًۭا",1044],["11:71:3",229,"فَضَحِكَتْ","and she laughed","وَٱمْرَأَتُهُۥ قَآئِمَةٌۭ","فَبَشَّرْنَـٰهَا بِإِسْحَـٰقَ وَمِن",1044],["23:110:8",349,"تَضْحَكُونَ","laugh","ذِكْرِى وَكُنتُم مِّنْهُمْ","",1044],["27:19:2",378,"ضَاحِكًۭا","laughing","فَتَبَسَّمَ","مِّن قَوْلِهَا وَقَالَ",3071],["43:47:7",492,"يَضْحَكُونَ","laughed","إِذَا هُم مِّنْهَا","",1044],["53:43:3",527,"أَضْحَكَ","makes (one) laugh","وَأَنَّهُۥ هُوَ","وَأَبْكَىٰ",2949],["53:60:1",528,"وَتَضْحَكُونَ","And you laugh","","وَلَا تَبْكُونَ",1044],["80:39:1",585,"ضَاحِكَةٌۭ","Laughing","","مُّسْتَبْشِرَةٌۭ",3072],["83:29:8",588,"يَضْحَكُونَ","laugh","مِنَ ٱلَّذِينَ ءَامَنُوا۟","",1044],["83:34:6",589,"يَضْحَكُونَ","they will laugh","ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ","",1044]]