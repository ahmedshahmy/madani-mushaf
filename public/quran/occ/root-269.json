[["2:158:13",24,"جُنَاحَ","blame","أَوِ ٱعْتَمَرَ فَلَا","عَلَيْهِ أَن يَطَّوَّفَ",427],["2:198:3",31,"جُنَاحٌ","any sin","لَيْسَ عَلَيْكُمْ","أَن تَبْتَغُوا۟ فَضْلًۭا",427],["2:229:30",36,"جُنَاحَ","sin","حُدُودَ ٱللَّهِ فَلَا","عَلَيْهِمَا فِيمَا ٱفْتَدَتْ",427],["2:230:15",36,"جُنَاحَ","sin","فَإِن طَلَّقَهَا فَلَا","عَلَيْهِمَآ أَن يَتَرَاجَعَآ",427],["2:233:42",37,"جُنَاحَ","blame","مِّنْهُمَا وَتَشَاوُرٍۢ فَلَا","عَلَيْهِمَا ۗ وَإِنْ أَرَدتُّمْ",427],["2:233:50",37,"جُنَاحَ","blame","تَسْتَرْضِعُوٓا۟ أَوْلَـٰدَكُمْ فَلَا","عَلَيْكُمْ إِذَا سَلَّمْتُم",427],["2:234:15",38,"جُنَاحَ","blame","بَلَغْنَ أَجَلَهُنَّ فَلَا","عَلَيْكُمْ فِيمَا فَعَلْنَ",427],["2:235:2",38,"جُنَاحَ","blame","وَلَا","عَلَيْكُمْ فِيمَا عَرَّضْتُم",427],["2:236:2",38,"جُنَاحَ","blame","لَّا","عَلَيْكُمْ إِن طَلَّقْتُمُ",427],["2:240:16",39,"جُنَاحَ","blame","فَإِنْ خَرَجْنَ فَلَا","عَلَيْكُمْ فِى مَا",427],["2:282:105",48,"جُنَاحٌ","any sin","بَيْنَكُمْ فَلَيْسَ عَلَيْكُمْ","أَلَّا تَكْتُبُوهَا ۗ وَأَشْهِدُوٓا۟",427],["4:23:35",81,"جُنَاحَ","sin","دَخَلْتُم بِهِنَّ فَلَا","عَلَيْكُمْ وَحَلَـٰٓئِلُ أَبْنَآئِكُمُ",427],["4:24:30",82,"جُنَاحَ","sin","أُجُورَهُنَّ فَرِيضَةًۭ ۚ وَلَا","عَلَيْكُمْ فِيمَا تَرَٰضَيْتُم",427],["4:101:7",94,"جُنَاحٌ","(is) any blame","ٱلْأَرْضِ فَلَيْسَ عَلَيْكُمْ","أَن تَقْصُرُوا۟ مِنَ",427],["4:102:41",95,"جُنَاحَ","blame","مَّيْلَةًۭ وَٰحِدَةًۭ ۚ وَلَا","عَلَيْكُمْ إِن كَانَ",427],["4:128:10",99,"جُنَاحَ","sin","أَوْ إِعْرَاضًۭا فَلَا","عَلَيْهِمَآ أَن يُصْلِحَا",427],["5:93:7",123,"جُنَاحٌۭ","any sin","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","فِيمَا طَعِمُوٓا۟ إِذَا",427],["6:38:9",132,"بِجَنَاحَيْهِ","with its wings","وَلَا طَـٰٓئِرٍۢ يَطِيرُ","إِلَّآ أُمَمٌ أَمْثَالُكُم ۚ",1078],["8:61:2",184,"جَنَحُوا۟","they incline","۞ وَإِن","لِلسَّلْمِ فَٱجْنَحْ لَهَا",2401],["8:61:4",184,"فَٱجْنَحْ","then you (also) incline","۞ وَإِن جَنَحُوا۟ لِلسَّلْمِ","لَهَا وَتَوَكَّلْ عَلَى",2401],["15:88:14",266,"جَنَاحَكَ","your wing","تَحْزَنْ عَلَيْهِمْ وَٱخْفِضْ","لِلْمُؤْمِنِينَ",1078],["17:24:3",284,"جَنَاحَ","(the) wing","وَٱخْفِضْ لَهُمَا","ٱلذُّلِّ مِنَ ٱلرَّحْمَةِ",1078],["20:22:4",313,"جَنَاحِكَ","your side","وَٱضْمُمْ يَدَكَ إِلَىٰ","تَخْرُجْ بَيْضَآءَ مِنْ",1078],["24:29:3",353,"جُنَاحٌ","(is) any blame","لَّيْسَ عَلَيْكُمْ","أَن تَدْخُلُوا۟ بُيُوتًا",427],["24:58:35",357,"جُنَاحٌۢ","any blame","عَلَيْكُمْ وَلَا عَلَيْهِمْ","بَعْدَهُنَّ ۚ طَوَّٰفُونَ عَلَيْكُم",427],["24:60:10",358,"جُنَاحٌ","any blame","نِكَاحًۭا فَلَيْسَ عَلَيْهِنَّ","أَن يَضَعْنَ ثِيَابَهُنَّ",427],["24:61:52",358,"جُنَاحٌ","any blame","صَدِيقِكُمْ ۚ لَيْسَ عَلَيْكُمْ","أَن تَأْكُلُوا۟ جَمِيعًا",427],["26:215:2",376,"جَنَاحَكَ","your wing","وَٱخْفِضْ","لِمَنِ ٱتَّبَعَكَ مِنَ",1078],["28:32:12",389,"جَنَاحَكَ","your hand","سُوٓءٍۢ وَٱضْمُمْ إِلَيْكَ","مِنَ ٱلرَّهْبِ ۖ فَذَٰنِكَ",1078],["33:5:17",418,"جُنَاحٌۭ","any blame","وَمَوَٰلِيكُمْ ۚ وَلَيْسَ عَلَيْكُمْ","فِيمَآ أَخْطَأْتُم بِهِۦ",427],["33:51:14",425,"جُنَاحَ","blame","مِمَّنْ عَزَلْتَ فَلَا","عَلَيْكَ ۚ ذَٰلِكَ أَدْنَىٰٓ",427],["33:55:2",426,"جُنَاحَ","blame","لَّا","عَلَيْهِنَّ فِىٓ ءَابَآئِهِنَّ",427],["35:1:10",434,"أَجْنِحَةٍۢ","having wings","ٱلْمَلَـٰٓئِكَةِ رُسُلًا أُو۟لِىٓ","مَّثْنَىٰ وَثُلَـٰثَ وَرُبَـٰعَ ۚ",1078],["60:10:31",550,"جُنَاحَ","any blame","مَّآ أَنفَقُوا۟ ۚ وَلَا","عَلَيْكُمْ أَن تَنكِحُوهُنَّ",427]]