[["2:220:12",35,"تُخَالِطُوهُمْ","you associate with them","لَّهُمْ خَيْرٌۭ ۖ وَإِن","فَإِخْوَٰنُكُمْ ۚ وَٱللَّهُ يَعْلَمُ",4476],["6:146:22",147,"ٱخْتَلَطَ","(is) joined","ٱلْحَوَايَآ أَوْ مَا","بِعَظْمٍۢ ۚ ذَٰلِكَ جَزَيْنَـٰهُم",2112],["9:102:4",203,"خَلَطُوا۟","They had mixed","وَءَاخَرُونَ ٱعْتَرَفُوا۟ بِذُنُوبِهِمْ","عَمَلًۭا صَـٰلِحًۭا وَءَاخَرَ",4573],["10:24:9",211,"فَٱخْتَلَطَ","so absorbs","أَنزَلْنَـٰهُ مِنَ ٱلسَّمَآءِ","بِهِۦ نَبَاتُ ٱلْأَرْضِ",2112],["18:45:10",298,"فَٱخْتَلَطَ","then mingles","أَنزَلْنَـٰهُ مِنَ ٱلسَّمَآءِ","بِهِۦ نَبَاتُ ٱلْأَرْضِ",2112],["38:24:11",454,"ٱلْخُلَطَآءِ","the partners","وَإِنَّ كَثِيرًۭا مِّنَ","لَيَبْغِى بَعْضُهُمْ عَلَىٰ",4590]]