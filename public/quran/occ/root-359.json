[["2:169:4",25,"وَٱلْفَحْشَآءِ","and the shameful","إِنَّمَا يَأْمُرُكُم بِٱلسُّوٓءِ","وَأَن تَقُولُوا۟ عَلَى",1069],["2:268:5",45,"بِٱلْفَحْشَآءِ ۖ","to immorality","يَعِدُكُمُ ٱلْفَقْرَ وَيَأْمُرُكُم","وَٱللَّهُ يَعِدُكُم مَّغْفِرَةًۭ",1069],["3:135:4",67,"فَـٰحِشَةً","immorality","وَٱلَّذِينَ إِذَا فَعَلُوا۟","أَوْ ظَلَمُوٓا۟ أَنفُسَهُمْ",573],["4:15:3",80,"ٱلْفَـٰحِشَةَ","[the] immorality","وَٱلَّـٰتِى يَأْتِينَ","مِن نِّسَآئِكُمْ فَٱسْتَشْهِدُوا۟",573],["4:19:20",80,"بِفَـٰحِشَةٍۢ","immorality","إِلَّآ أَن يَأْتِينَ","مُّبَيِّنَةٍۢ ۚ وَعَاشِرُوهُنَّ بِٱلْمَعْرُوفِ ۚ",573],["4:22:14",81,"فَـٰحِشَةًۭ","an immorality","سَلَفَ ۚ إِنَّهُۥ كَانَ","وَمَقْتًۭا وَسَآءَ سَبِيلًا",573],["4:25:39",82,"بِفَـٰحِشَةٍۢ","adultery","أُحْصِنَّ فَإِنْ أَتَيْنَ","فَعَلَيْهِنَّ نِصْفُ مَا",573],["6:151:24",148,"ٱلْفَوَٰحِشَ","[the] immoralities","وَإِيَّاهُمْ ۖ وَلَا تَقْرَبُوا۟","مَا ظَهَرَ مِنْهَا",573],["7:28:3",153,"فَـٰحِشَةًۭ","immorality","وَإِذَا فَعَلُوا۟","قَالُوا۟ وَجَدْنَا عَلَيْهَآ",573],["7:28:16",153,"بِٱلْفَحْشَآءِ ۖ","immorality","ٱللَّهَ لَا يَأْمُرُ","أَتَقُولُونَ عَلَى ٱللَّهِ",1069],["7:33:5",154,"ٱلْفَوَٰحِشَ","the shameful deeds","إِنَّمَا حَرَّمَ رَبِّىَ","مَا ظَهَرَ مِنْهَا",573],["7:80:6",160,"ٱلْفَـٰحِشَةَ","(such) immorality","قَالَ لِقَوْمِهِۦٓ أَتَأْتُونَ","مَا سَبَقَكُم بِهَا",573],["12:24:15",238,"وَٱلْفَحْشَآءَ ۚ","and the immorality","لِنَصْرِفَ عَنْهُ ٱلسُّوٓءَ","إِنَّهُۥ مِنْ عِبَادِنَا",1069],["16:90:11",277,"ٱلْفَحْشَآءِ","the immorality","ٱلْقُرْبَىٰ وَيَنْهَىٰ عَنِ","وَٱلْمُنكَرِ وَٱلْبَغْىِ ۚ يَعِظُكُمْ",1069],["17:32:6",285,"فَـٰحِشَةًۭ","an immorality","ٱلزِّنَىٰٓ ۖ إِنَّهُۥ كَانَ","وَسَآءَ سَبِيلًۭا",573],["24:19:6",351,"ٱلْفَـٰحِشَةُ","the immorality","يُحِبُّونَ أَن تَشِيعَ","فِى ٱلَّذِينَ ءَامَنُوا۟",573],["24:21:14",352,"بِٱلْفَحْشَآءِ","the immorality","ٱلشَّيْطَـٰنِ فَإِنَّهُۥ يَأْمُرُ","وَٱلْمُنكَرِ ۚ وَلَوْلَا فَضْلُ",1069],["27:54:6",381,"ٱلْفَـٰحِشَةَ","[the] immorality","قَالَ لِقَوْمِهِۦٓ أَتَأْتُونَ","وَأَنتُمْ تُبْصِرُونَ",573],["29:28:7",399,"ٱلْفَـٰحِشَةَ","the immorality","لِقَوْمِهِۦٓ إِنَّكُمْ لَتَأْتُونَ","مَا سَبَقَكُم بِهَا",573],["29:45:13",401,"ٱلْفَحْشَآءِ","the immorality","ٱلصَّلَوٰةَ تَنْهَىٰ عَنِ","وَٱلْمُنكَرِ ۗ وَلَذِكْرُ ٱللَّهِ",1069],["33:30:6",421,"بِفَـٰحِشَةٍۢ","immorality","مَن يَأْتِ مِنكُنَّ","مُّبَيِّنَةٍۢ يُضَـٰعَفْ لَهَا",573],["42:37:5",487,"وَٱلْفَوَٰحِشَ","and the immoralities","يَجْتَنِبُونَ كَبَـٰٓئِرَ ٱلْإِثْمِ","وَإِذَا مَا غَضِبُوا۟",573],["53:32:5",527,"وَٱلْفَوَٰحِشَ","and the immoralities","يَجْتَنِبُونَ كَبَـٰٓئِرَ ٱلْإِثْمِ","إِلَّا ٱللَّمَمَ ۚ إِنَّ",573],["65:1:22",558,"بِفَـٰحِشَةٍۢ","an immorality","إِلَّآ أَن يَأْتِينَ","مُّبَيِّنَةٍۢ ۚ وَتِلْكَ حُدُودُ",573]]