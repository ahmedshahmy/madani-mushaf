[["2:249:51",41,"فِئَةٍۢ","a company","ٱللَّهِ كَم مِّن","قَلِيلَةٍ غَلَبَتْ فِئَةًۭ",835],["2:249:54",41,"فِئَةًۭ","a company","فِئَةٍۢ قَلِيلَةٍ غَلَبَتْ","كَثِيرَةًۢ بِإِذْنِ ٱللَّهِ ۗ",835],["3:13:6",51,"فِئَتَيْنِ","(the) two hosts","لَكُمْ ءَايَةٌۭ فِى","ٱلْتَقَتَا ۖ فِئَةٌۭ تُقَـٰتِلُ",835],["3:13:8",51,"فِئَةٌۭ","one group","فِى فِئَتَيْنِ ٱلْتَقَتَا ۖ","تُقَـٰتِلُ فِى سَبِيلِ",835],["4:88:5",92,"فِئَتَيْنِ","(you have become) two parties","لَكُمْ فِى ٱلْمُنَـٰفِقِينَ","وَٱللَّهُ أَرْكَسَهُم بِمَا",835],["8:16:11",178,"فِئَةٍۢ","a group","أَوْ مُتَحَيِّزًا إِلَىٰ","فَقَدْ بَآءَ بِغَضَبٍۢ",835],["8:19:17",179,"فِئَتُكُمْ","your forces","وَلَن تُغْنِىَ عَنكُمْ","شَيْـًۭٔا وَلَوْ كَثُرَتْ",3439],["8:45:6",182,"فِئَةًۭ","a force","ءَامَنُوٓا۟ إِذَا لَقِيتُمْ","فَٱثْبُتُوا۟ وَٱذْكُرُوا۟ ٱللَّهَ",835],["8:48:18",183,"ٱلْفِئَتَانِ","the two forces","لَّكُمْ ۖ فَلَمَّا تَرَآءَتِ","نَكَصَ عَلَىٰ عَقِبَيْهِ",835],["18:43:4",298,"فِئَةٌۭ","a group","وَلَمْ تَكُن لَّهُۥ","يَنصُرُونَهُۥ مِن دُونِ",835],["28:81:9",395,"فِئَةٍۢ","group","كَانَ لَهُۥ مِن","يَنصُرُونَهُۥ مِن دُونِ",835]]