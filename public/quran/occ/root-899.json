[["17:93:8",291,"تَرْقَىٰ","you ascend","مِّن زُخْرُفٍ أَوْ","فِى ٱلسَّمَآءِ وَلَن",4413],["17:93:13",291,"لِرُقِيِّكَ","in your ascension","ٱلسَّمَآءِ وَلَن نُّؤْمِنَ","حَتَّىٰ تُنَزِّلَ عَلَيْنَا",4203],["38:10:8",453,"فَلْيَرْتَقُوا۟","Then let them ascend","وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ۖ","فِى ٱلْأَسْبَـٰبِ",4654],["75:27:3",578,"رَاقٍۢ","(will) cure","وَقِيلَ مَنْ ۜ","",4154]]