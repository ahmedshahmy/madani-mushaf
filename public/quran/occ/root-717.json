[["3:134:6",67,"وَٱلْكَـٰظِمِينَ","and those who restrain","فِى ٱلسَّرَّآءِ وَٱلضَّرَّآءِ","ٱلْغَيْظَ وَٱلْعَافِينَ عَنِ",2415],["12:84:12",245,"كَظِيمٌۭ","a suppressor","مِنَ ٱلْحُزْنِ فَهُوَ","",1863],["16:58:9",273,"كَظِيمٌۭ","suppresses grief","وَجْهُهُۥ مُسْوَدًّۭا وَهُوَ","",1863],["40:18:8",469,"كَـٰظِمِينَ ۚ","choked","ٱلْقُلُوبُ لَدَى ٱلْحَنَاجِرِ","مَا لِلظَّـٰلِمِينَ مِنْ",2415],["43:17:12",490,"كَظِيمٌ","(is) filled with grief","وَجْهُهُۥ مُسْوَدًّۭا وَهُوَ","",1863],["68:48:11",566,"مَكْظُومٌۭ","(was) distressed","إِذْ نَادَىٰ وَهُوَ","",3675]]