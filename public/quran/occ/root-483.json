[["2:34:9",6,"أَبَىٰ","He refused","فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ","وَٱسْتَكْبَرَ وَكَانَ مِنَ",678],["2:282:16",48,"يَأْبَ","(should) refuse","كَاتِبٌۢ بِٱلْعَدْلِ ۚ وَلَا","كَاتِبٌ أَن يَكْتُبَ",678],["2:282:73",48,"يَأْبَ","(should) refuse","إِحْدَىٰهُمَا ٱلْأُخْرَىٰ ۚ وَلَا","ٱلشُّهَدَآءُ إِذَا مَا",678],["9:8:13",188,"وَتَأْبَىٰ","but refuse","ذِمَّةًۭ ۚ يُرْضُونَكُم بِأَفْوَٰهِهِمْ","قُلُوبُهُمْ وَأَكْثَرُهُمْ فَـٰسِقُونَ",678],["9:32:7",192,"وَيَأْبَى","but Allah refuses","نُورَ ٱللَّهِ بِأَفْوَٰهِهِمْ","ٱللَّهُ إِلَّآ أَن",678],["15:31:3",263,"أَبَىٰٓ","He refused","إِلَّآ إِبْلِيسَ","أَن يَكُونَ مَعَ",678],["17:89:10",291,"فَأَبَىٰٓ","but refused","مِن كُلِّ مَثَلٍۢ","أَكْثَرُ ٱلنَّاسِ إِلَّا",678],["17:99:20",292,"فَأَبَى","But refused","لَّا رَيْبَ فِيهِ","ٱلظَّـٰلِمُونَ إِلَّا كُفُورًۭا",678],["18:77:9",302,"فَأَبَوْا۟","but they refused","قَرْيَةٍ ٱسْتَطْعَمَآ أَهْلَهَا","أَن يُضَيِّفُوهُمَا فَوَجَدَا",678],["20:56:6",315,"وَأَبَىٰ","and refused","ءَايَـٰتِنَا كُلَّهَا فَكَذَّبَ","",678],["20:116:9",320,"أَبَىٰ","he refused","فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ","",678],["25:50:5",364,"فَأَبَىٰٓ","but refuse","صَرَّفْنَـٰهُ بَيْنَهُمْ لِيَذَّكَّرُوا۟","أَكْثَرُ ٱلنَّاسِ إِلَّا",678],["33:72:8",427,"فَأَبَيْنَ","but they refused","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَٱلْجِبَالِ","أَن يَحْمِلْنَهَا وَأَشْفَقْنَ",678]]