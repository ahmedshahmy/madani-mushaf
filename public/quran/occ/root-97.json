[["2:48:4",7,"تَجْزِى","avail","وَٱتَّقُوا۟ يَوْمًۭا لَّا","نَفْسٌ عَن نَّفْسٍۢ",161],["2:85:29",13,"جَزَآءُ","(should be the) recompense","وَتَكْفُرُونَ بِبَعْضٍۢ ۚ فَمَا","مَن يَفْعَلُ ذَٰلِكَ",275],["2:123:4",19,"تَجْزِى","will avail","وَٱتَّقُوا۟ يَوْمًۭا لَّا","نَفْسٌ عَن نَّفْسٍۢ",161],["2:191:24",30,"جَزَآءُ","(is the) reward","قَـٰتَلُوكُمْ فَٱقْتُلُوهُمْ ۗ كَذَٰلِكَ","ٱلْكَـٰفِرِينَ",275],["3:87:2",61,"جَزَآؤُهُمْ","their recompense","أُو۟لَـٰٓئِكَ","أَنَّ عَلَيْهِمْ لَعْنَةَ",275],["3:136:2",67,"جَزَآؤُهُم","their reward","أُو۟لَـٰٓئِكَ","مَّغْفِرَةٌۭ مِّن رَّبِّهِمْ",275],["3:144:25",68,"وَسَيَجْزِى","And will reward","يَضُرَّ ٱللَّهَ شَيْـًۭٔا ۗ","ٱللَّهُ ٱلشَّـٰكِرِينَ",161],["3:145:23",68,"وَسَنَجْزِى","And We will reward","ٱلْـَٔاخِرَةِ نُؤْتِهِۦ مِنْهَا ۚ","ٱلشَّـٰكِرِينَ",161],["4:93:5",93,"فَجَزَآؤُهُۥ","then his recompense","يَقْتُلْ مُؤْمِنًۭا مُّتَعَمِّدًۭا","جَهَنَّمُ خَـٰلِدًۭا فِيهَا",275],["4:123:10",98,"يُجْزَ","will be recompensed","مَن يَعْمَلْ سُوٓءًۭا","بِهِۦ وَلَا يَجِدْ",161],["5:29:12",112,"جَزَٰٓؤُا۟","(is the) recompense","أَصْحَـٰبِ ٱلنَّارِ ۚ وَذَٰلِكَ","ٱلظَّـٰلِمِينَ",275],["5:33:2",113,"جَزَٰٓؤُا۟","(the) recompense","إِنَّمَا","ٱلَّذِينَ يُحَارِبُونَ ٱللَّهَ",275],["5:38:5",114,"جَزَآءًۢ","(as) a recompense","وَٱلسَّارِقَةُ فَٱقْطَعُوٓا۟ أَيْدِيَهُمَا","بِمَا كَسَبَا نَكَـٰلًۭا",275],["5:85:13",122,"جَزَآءُ","(is the) reward","خَـٰلِدِينَ فِيهَا ۚ وَذَٰلِكَ","ٱلْمُحْسِنِينَ",275],["5:95:13",123,"فَجَزَآءٌۭ","then penalty","قَتَلَهُۥ مِنكُم مُّتَعَمِّدًۭا","مِّثْلُ مَا قَتَلَ",275],["6:84:20",138,"نَجْزِى","We reward","وَمُوسَىٰ وَهَـٰرُونَ ۚ وَكَذَٰلِكَ","ٱلْمُحْسِنِينَ",161],["6:93:36",139,"تُجْزَوْنَ","you will be recompensed","أَخْرِجُوٓا۟ أَنفُسَكُمُ ۖ ٱلْيَوْمَ","عَذَابَ ٱلْهُونِ بِمَا",161],["6:120:9",143,"سَيُجْزَوْنَ","they will be recompensed","ٱلَّذِينَ يَكْسِبُونَ ٱلْإِثْمَ","بِمَا كَانُوا۟ يَقْتَرِفُونَ",161],["6:138:23",146,"سَيَجْزِيهِم","He will recompense them","عَلَيْهَا ٱفْتِرَآءً عَلَيْهِ ۚ","بِمَا كَانُوا۟ يَفْتَرُونَ",161],["6:139:18",146,"سَيَجْزِيهِمْ","He will recompense them","فَهُمْ فِيهِ شُرَكَآءُ ۚ","وَصْفَهُمْ ۚ إِنَّهُۥ حَكِيمٌ",161],["6:146:25",147,"جَزَيْنَـٰهُم","(is) their recompense","ٱخْتَلَطَ بِعَظْمٍۢ ۚ ذَٰلِكَ","بِبَغْيِهِمْ ۖ وَإِنَّا لَصَـٰدِقُونَ",161],["6:157:26",149,"سَنَجْزِى","We will recompense","ٱللَّهِ وَصَدَفَ عَنْهَا ۗ","ٱلَّذِينَ يَصْدِفُونَ عَنْ",161],["6:160:11",150,"يُجْزَىٰٓ","he will be recompensed","جَآءَ بِٱلسَّيِّئَةِ فَلَا","إِلَّا مِثْلَهَا وَهُمْ",161],["7:40:22",155,"نَجْزِى","We recompense","سَمِّ ٱلْخِيَاطِ ۚ وَكَذَٰلِكَ","ٱلْمُجْرِمِينَ",161],["7:41:9",155,"نَجْزِى","We recompense","فَوْقِهِمْ غَوَاشٍۢ ۚ وَكَذَٰلِكَ","ٱلظَّـٰلِمِينَ",161],["7:147:9",168,"يُجْزَوْنَ","they be recompensed","حَبِطَتْ أَعْمَـٰلُهُمْ ۚ هَلْ","إِلَّا مَا كَانُوا۟",161],["7:152:14",169,"نَجْزِى","We recompense","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۚ وَكَذَٰلِكَ","ٱلْمُفْتَرِينَ",161],["7:180:11",174,"سَيُجْزَوْنَ","They will be recompensed","يُلْحِدُونَ فِىٓ أَسْمَـٰٓئِهِۦ ۚ","مَا كَانُوا۟ يَعْمَلُونَ",161],["9:26:17",190,"جَزَآءُ","(is) the recompense","ٱلَّذِينَ كَفَرُوا۟ ۚ وَذَٰلِكَ","ٱلْكَـٰفِرِينَ",275],["9:29:25",191,"ٱلْجِزْيَةَ","the jizyah","ٱلْكِتَـٰبَ حَتَّىٰ يُعْطُوا۟","عَن يَدٍۢ وَهُمْ",3541],["9:82:5",200,"جَزَآءًۢ","(as) a recompense","قَلِيلًۭا وَلْيَبْكُوا۟ كَثِيرًۭا","بِمَا كَانُوا۟ يَكْسِبُونَ",275],["9:95:15",202,"جَزَآءًۢ","a recompense","رِجْسٌۭ ۖ وَمَأْوَىٰهُمْ جَهَنَّمُ","بِمَا كَانُوا۟ يَكْسِبُونَ",275],["9:121:13",206,"لِيَجْزِيَهُمُ","that Allah may reward them","إِلَّا كُتِبَ لَهُمْ","ٱللَّهُ أَحْسَنَ مَا",161],["10:4:12",208,"لِيَجْزِىَ","that He may reward","ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",161],["10:13:15",209,"نَجْزِى","We recompense","كَانُوا۟ لِيُؤْمِنُوا۟ ۚ كَذَٰلِكَ","ٱلْقَوْمَ ٱلْمُجْرِمِينَ",161],["10:27:4",212,"جَزَآءُ","(the) recompense","وَٱلَّذِينَ كَسَبُوا۟ ٱلسَّيِّـَٔاتِ","سَيِّئَةٍۭ بِمِثْلِهَا وَتَرْهَقُهُمْ",275],["10:52:9",214,"تُجْزَوْنَ","Are you (being) recompensed","عَذَابَ ٱلْخُلْدِ هَلْ","إِلَّا بِمَا كُنتُمْ",161],["12:22:8",237,"نَجْزِى","We reward","حُكْمًۭا وَعِلْمًۭا ۚ وَكَذَٰلِكَ","ٱلْمُحْسِنِينَ",161],["12:25:13",238,"جَزَآءُ","(is) the recompense","ٱلْبَابِ ۚ قَالَتْ مَا","مَنْ أَرَادَ بِأَهْلِكَ",275],["12:74:3",244,"جَزَٰٓؤُهُۥٓ","(will be the) recompense (of) it","قَالُوا۟ فَمَا","إِن كُنتُمْ كَـٰذِبِينَ",275],["12:75:2",244,"جَزَٰٓؤُهُۥ","Its recompense","قَالُوا۟","مَن وُجِدَ فِى",275],["12:75:8",244,"جَزَٰٓؤُهُۥ ۚ","(will be) his recompense","فِى رَحْلِهِۦ فَهُوَ","كَذَٰلِكَ نَجْزِى ٱلظَّـٰلِمِينَ",275],["12:75:10",244,"نَجْزِى","(do) we recompense","فَهُوَ جَزَٰٓؤُهُۥ ۚ كَذَٰلِكَ","ٱلظَّـٰلِمِينَ",161],["12:88:20",246,"يَجْزِى","rewards","عَلَيْنَآ ۖ إِنَّ ٱللَّهَ","ٱلْمُتَصَدِّقِينَ",161],["14:51:1",261,"لِيَجْزِىَ","So that Allah may recompense","","ٱللَّهُ كُلَّ نَفْسٍۢ",161],["16:31:13",270,"يَجْزِى","Allah rewards","مَا يَشَآءُونَ ۚ كَذَٰلِكَ","ٱللَّهُ ٱلْمُتَّقِينَ",161],["16:96:8",278,"وَلَنَجْزِيَنَّ","And surely We will pay","عِندَ ٱللَّهِ بَاقٍۢ ۗ","ٱلَّذِينَ صَبَرُوٓا۟ أَجْرَهُم",161],["16:97:13",278,"وَلَنَجْزِيَنَّهُمْ","and We will pay them","فَلَنُحْيِيَنَّهُۥ حَيَوٰةًۭ طَيِّبَةًۭ ۖ","أَجْرَهُم بِأَحْسَنِ مَا",161],["17:63:8",288,"جَزَآؤُكُمْ","(is) your recompense","مِنْهُمْ فَإِنَّ جَهَنَّمَ","جَزَآءًۭ مَّوْفُورًۭا",275],["17:63:9",288,"جَزَآءًۭ","a recompense","فَإِنَّ جَهَنَّمَ جَزَآؤُكُمْ","مَّوْفُورًۭا",275],["17:98:2",292,"جَزَآؤُهُم","(is) their recompense","ذَٰلِكَ","بِأَنَّهُمْ كَفَرُوا۟ بِـَٔايَـٰتِنَا",275],["18:88:7",303,"جَزَآءً","(is) a reward","وَعَمِلَ صَـٰلِحًۭا فَلَهُۥ","ٱلْحُسْنَىٰ ۖ وَسَنَقُولُ لَهُۥ",275],["18:106:2",304,"جَزَآؤُهُمْ","(is) their recompense","ذَٰلِكَ","جَهَنَّمُ بِمَا كَفَرُوا۟",275],["20:15:6",313,"لِتُجْزَىٰ","that may be recompensed","ءَاتِيَةٌ أَكَادُ أُخْفِيهَا","كُلُّ نَفْسٍۭ بِمَا",161],["20:76:10",316,"جَزَآءُ","(is) the reward","خَـٰلِدِينَ فِيهَا ۚ وَذَٰلِكَ","مَن تَزَكَّىٰ",275],["20:127:2",321,"نَجْزِى","We recompense","وَكَذَٰلِكَ","مَنْ أَسْرَفَ وَلَمْ",161],["21:29:9",324,"نَجْزِيهِ","We will recompense","مِّن دُونِهِۦ فَذَٰلِكَ","جَهَنَّمَ ۚ كَذَٰلِكَ نَجْزِى",161],["21:29:12",324,"نَجْزِى","We recompense","نَجْزِيهِ جَهَنَّمَ ۚ كَذَٰلِكَ","ٱلظَّـٰلِمِينَ",161],["23:111:2",349,"جَزَيْتُهُمُ","have rewarded them","إِنِّى","ٱلْيَوْمَ بِمَا صَبَرُوٓا۟",161],["24:38:1",355,"لِيَجْزِيَهُمُ","That Allah may reward them","","ٱللَّهُ أَحْسَنَ مَا",161],["25:15:12",361,"جَزَآءًۭ","a reward","ٱلْمُتَّقُونَ ۚ كَانَتْ لَهُمْ","وَمَصِيرًۭا",275],["25:75:2",366,"يُجْزَوْنَ","will be awarded","أُو۟لَـٰٓئِكَ","ٱلْغُرْفَةَ بِمَا صَبَرُوا۟",161],["27:90:9",385,"تُجْزَوْنَ","you recompensed","فِى ٱلنَّارِ هَلْ","إِلَّا مَا كُنتُمْ",161],["28:14:9",387,"نَجْزِى","We reward","حُكْمًۭا وَعِلْمًۭا ۚ وَكَذَٰلِكَ","ٱلْمُحْسِنِينَ",161],["28:25:10",388,"لِيَجْزِيَكَ","that he may reward you","إِنَّ أَبِى يَدْعُوكَ","أَجْرَ مَا سَقَيْتَ",161],["28:84:11",395,"يُجْزَى","will be recompensed","جَآءَ بِٱلسَّيِّئَةِ فَلَا","ٱلَّذِينَ عَمِلُوا۟ ٱلسَّيِّـَٔاتِ",161],["29:7:8",397,"وَلَنَجْزِيَنَّهُمْ","and We will surely reward them","لَنُكَفِّرَنَّ عَنْهُمْ سَيِّـَٔاتِهِمْ","أَحْسَنَ ٱلَّذِى كَانُوا۟",161],["30:45:1",409,"لِيَجْزِىَ","That He may reward","","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",161],["31:33:8",414,"يَجْزِى","can avail","وَٱخْشَوْا۟ يَوْمًۭا لَّا","وَالِدٌ عَن وَلَدِهِۦ",161],["31:33:15",414,"جَازٍ","(can) avail","وَلَا مَوْلُودٌ هُوَ","عَن وَالِدِهِۦ شَيْـًٔا ۚ",3512],["32:17:10",416,"جَزَآءًۢ","(as) a reward","مِّن قُرَّةِ أَعْيُنٍۢ","بِمَا كَانُوا۟ يَعْمَلُونَ",275],["33:24:1",421,"لِّيَجْزِىَ","That Allah may reward","","ٱللَّهُ ٱلصَّـٰدِقِينَ بِصِدْقِهِمْ",161],["34:4:1",428,"لِّيَجْزِىَ","That He may reward","","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",161],["34:17:2",430,"جَزَيْنَـٰهُم","We recompensed them","ذَٰلِكَ","بِمَا كَفَرُوا۟ ۖ وَهَلْ",161],["34:17:6",430,"نُجَـٰزِىٓ","We recompense","بِمَا كَفَرُوا۟ ۖ وَهَلْ","إِلَّا ٱلْكَفُورَ",4064],["34:33:30",432,"يُجْزَوْنَ","they be recompensed","ٱلَّذِينَ كَفَرُوا۟ ۚ هَلْ","إِلَّا مَا كَانُوا۟",161],["34:37:16",432,"جَزَآءُ","(will be) reward","صَـٰلِحًۭا فَأُو۟لَـٰٓئِكَ لَهُمْ","ٱلضِّعْفِ بِمَا عَمِلُوا۟",275],["35:36:16",438,"نَجْزِى","We recompense","مِّنْ عَذَابِهَا ۚ كَذَٰلِكَ","كُلَّ كَفُورٍۢ",161],["36:54:7",443,"تُجْزَوْنَ","you will be recompensed","نَفْسٌۭ شَيْـًۭٔا وَلَا","إِلَّا مَا كُنتُمْ",161],["37:39:2",447,"تُجْزَوْنَ","you will be recompensed","وَمَا","إِلَّا مَا كُنتُمْ",161],["37:80:3",449,"نَجْزِى","[We] reward","إِنَّا كَذَٰلِكَ","ٱلْمُحْسِنِينَ",161],["37:105:6",450,"نَجْزِى","[We] reward","ٱلرُّءْيَآ ۚ إِنَّا كَذَٰلِكَ","ٱلْمُحْسِنِينَ",161],["37:110:2",450,"نَجْزِى","We reward","كَذَٰلِكَ","ٱلْمُحْسِنِينَ",161],["37:121:3",450,"نَجْزِى","reward","إِنَّا كَذَٰلِكَ","ٱلْمُحْسِنِينَ",161],["37:131:3",451,"نَجْزِى","reward","إِنَّا كَذَٰلِكَ","ٱلْمُحْسِنِينَ",161],["39:34:7",462,"جَزَآءُ","(is the) reward","عِندَ رَبِّهِمْ ۚ ذَٰلِكَ","ٱلْمُحْسِنِينَ",275],["39:35:7",462,"وَيَجْزِيَهُمْ","and reward them","أَسْوَأَ ٱلَّذِى عَمِلُوا۟","أَجْرَهُم بِأَحْسَنِ ٱلَّذِى",161],["40:17:2",469,"تُجْزَىٰ","will be recompensed","ٱلْيَوْمَ","كُلُّ نَفْسٍۭ بِمَا",161],["40:40:5",471,"يُجْزَىٰٓ","he will be recompensed","عَمِلَ سَيِّئَةًۭ فَلَا","إِلَّا مِثْلَهَا ۖ وَمَنْ",161],["41:27:6",479,"وَلَنَجْزِيَنَّهُمْ","and surely We will recompense them","كَفَرُوا۟ عَذَابًۭا شَدِيدًۭا","أَسْوَأَ ٱلَّذِى كَانُوا۟",161],["41:28:2",479,"جَزَآءُ","(is the) recompense","ذَٰلِكَ","أَعْدَآءِ ٱللَّهِ ٱلنَّارُ ۖ",275],["41:28:10",479,"جَزَآءًۢ","(as) recompense","فِيهَا دَارُ ٱلْخُلْدِ ۖ","بِمَا كَانُوا۟ بِـَٔايَـٰتِنَا",275],["42:40:1",487,"وَجَزَٰٓؤُا۟","(The) recompense","","سَيِّئَةٍۢ سَيِّئَةٌۭ مِّثْلُهَا ۖ",275],["45:14:10",500,"لِيَجْزِىَ","that He may recompense","يَرْجُونَ أَيَّامَ ٱللَّهِ","قَوْمًۢا بِمَا كَانُوا۟",161],["45:22:6",500,"وَلِتُجْزَىٰ","and that may be recompensed","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ","كُلُّ نَفْسٍۭ بِمَا",161],["45:28:11",501,"تُجْزَوْنَ","you will be recompensed","إِلَىٰ كِتَـٰبِهَا ٱلْيَوْمَ","مَا كُنتُمْ تَعْمَلُونَ",161],["46:14:6",503,"جَزَآءًۢ","a reward","ٱلْجَنَّةِ خَـٰلِدِينَ فِيهَا","بِمَا كَانُوا۟ يَعْمَلُونَ",275],["46:20:15",504,"تُجْزَوْنَ","you will be recompensed","وَٱسْتَمْتَعْتُم بِهَا فَٱلْيَوْمَ","عَذَابَ ٱلْهُونِ بِمَا",161],["46:25:12",505,"نَجْزِى","We recompense","إِلَّا مَسَـٰكِنُهُمْ ۚ كَذَٰلِكَ","ٱلْقَوْمَ ٱلْمُجْرِمِينَ",161],["52:16:9",524,"تُجْزَوْنَ","you are being recompensed","سَوَآءٌ عَلَيْكُمْ ۖ إِنَّمَا","مَا كُنتُمْ تَعْمَلُونَ",161],["53:31:8",527,"لِيَجْزِىَ","that He may recompense","وَمَا فِى ٱلْأَرْضِ","ٱلَّذِينَ أَسَـٰٓـُٔوا۟ بِمَا",161],["53:31:13",527,"وَيَجْزِىَ","and recompense","أَسَـٰٓـُٔوا۟ بِمَا عَمِلُوا۟","ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى",161],["53:41:2",527,"يُجْزَىٰهُ","he will be recompensed for it","ثُمَّ","ٱلْجَزَآءَ ٱلْأَوْفَىٰ",161],["53:41:3",527,"ٱلْجَزَآءَ","the recompense","ثُمَّ يُجْزَىٰهُ","ٱلْأَوْفَىٰ",275],["54:14:3",529,"جَزَآءًۭ","a reward","تَجْرِى بِأَعْيُنِنَا","لِّمَن كَانَ كُفِرَ",275],["54:35:5",530,"نَجْزِى","We reward","مِّنْ عِندِنَا ۚ كَذَٰلِكَ","مَن شَكَرَ",161],["55:60:2",533,"جَزَآءُ","(the) reward","هَلْ","ٱلْإِحْسَـٰنِ إِلَّا ٱلْإِحْسَـٰنُ",275],["56:24:1",535,"جَزَآءًۢ","A reward","","بِمَا كَانُوا۟ يَعْمَلُونَ",275],["59:17:9",548,"جَزَٰٓؤُا۟","(is the) recompense","خَـٰلِدَيْنِ فِيهَا ۚ وَذَٰلِكَ","ٱلظَّـٰلِمِينَ",275],["66:7:8",560,"تُجْزَوْنَ","you will be recompensed","تَعْتَذِرُوا۟ ٱلْيَوْمَ ۖ إِنَّمَا","مَا كُنتُمْ تَعْمَلُونَ",161],["76:9:8",579,"جَزَآءًۭ","any reward","لَا نُرِيدُ مِنكُمْ","وَلَا شُكُورًا",275],["76:12:1",579,"وَجَزَىٰهُم","And will reward them","","بِمَا صَبَرُوا۟ جَنَّةًۭ",161],["76:22:5",579,"جَزَآءًۭ","a reward","هَـٰذَا كَانَ لَكُمْ","وَكَانَ سَعْيُكُم مَّشْكُورًا",275],["77:44:3",581,"نَجْزِى","reward","إِنَّا كَذَٰلِكَ","ٱلْمُحْسِنِينَ",161],["78:26:1",582,"جَزَآءًۭ","A recompense","","وِفَاقًا",275],["78:36:1",583,"جَزَآءًۭ","(As) a reward","","مِّن رَّبِّكَ عَطَآءً",275],["92:19:6",596,"تُجْزَىٰٓ","to be recompensed","عِندَهُۥ مِن نِّعْمَةٍۢ","",161],["98:8:1",599,"جَزَآؤُهُمْ","Their reward","","عِندَ رَبِّهِمْ جَنَّـٰتُ",275]]