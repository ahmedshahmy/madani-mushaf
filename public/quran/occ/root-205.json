[["2:85:13",13,"بِٱلْإِثْمِ","in sin","دِيَـٰرِهِمْ تَظَـٰهَرُونَ عَلَيْهِم","وَٱلْعُدْوَٰنِ وَإِن يَأْتُوكُمْ",327],["2:173:20",26,"إِثْمَ","sin","وَلَا عَادٍۢ فَلَآ","عَلَيْهِ ۚ إِنَّ ٱللَّهَ",327],["2:181:6",27,"إِثْمُهُۥ","its sin","بَعْدَ مَا سَمِعَهُۥ فَإِنَّمَآ","عَلَى ٱلَّذِينَ يُبَدِّلُونَهُۥٓ ۚ",327],["2:182:7",28,"إِثْمًۭا","sin","مُّوصٍۢ جَنَفًا أَوْ","فَأَصْلَحَ بَيْنَهُمْ فَلَآ",327],["2:182:11",28,"إِثْمَ","sin","فَأَصْلَحَ بَيْنَهُمْ فَلَآ","عَلَيْهِ ۚ إِنَّ ٱللَّهَ",327],["2:188:15",29,"بِٱلْإِثْمِ","sinfully","مِّنْ أَمْوَٰلِ ٱلنَّاسِ","وَأَنتُمْ تَعْلَمُونَ",327],["2:203:11",32,"إِثْمَ","sin","فِى يَوْمَيْنِ فَلَآ","عَلَيْهِ وَمَن تَأَخَّرَ",327],["2:203:16",32,"إِثْمَ","sin","وَمَن تَأَخَّرَ فَلَآ","عَلَيْهِ ۚ لِمَنِ ٱتَّقَىٰ ۗ",327],["2:206:8",32,"بِٱلْإِثْمِ ۚ","to [the] sins","ٱللَّهَ أَخَذَتْهُ ٱلْعِزَّةُ","فَحَسْبُهُۥ جَهَنَّمُ ۚ وَلَبِئْسَ",327],["2:219:7",34,"إِثْمٌۭ","(is) a sin","وَٱلْمَيْسِرِ ۖ قُلْ فِيهِمَآ","كَبِيرٌۭ وَمَنَـٰفِعُ لِلنَّاسِ",327],["2:219:11",34,"وَإِثْمُهُمَآ","But sin of both of them","كَبِيرٌۭ وَمَنَـٰفِعُ لِلنَّاسِ","أَكْبَرُ مِن نَّفْعِهِمَا ۗ",327],["2:276:11",47,"أَثِيمٍ","sinner","يُحِبُّ كُلَّ كَفَّارٍ","",1040],["2:283:27",49,"ءَاثِمٌۭ","(is) sinful","وَمَن يَكْتُمْهَا فَإِنَّهُۥٓ","قَلْبُهُۥ ۗ وَٱللَّهُ بِمَا",1754],["3:178:14",73,"إِثْمًۭا ۚ","(in) sins","نُمْلِى لَهُمْ لِيَزْدَادُوٓا۟","وَلَهُمْ عَذَابٌۭ مُّهِينٌۭ",327],["4:20:16",81,"وَإِثْمًۭا","and a sin","شَيْـًٔا ۚ أَتَأْخُذُونَهُۥ بُهْتَـٰنًۭا","مُّبِينًۭا",327],["4:48:19",86,"إِثْمًا","a sin","بِٱللَّهِ فَقَدِ ٱفْتَرَىٰٓ","عَظِيمًا",327],["4:50:9",86,"إِثْمًۭا","(as) a sin","ٱلْكَذِبَ ۖ وَكَفَىٰ بِهِۦٓ","مُّبِينًا",327],["4:107:14",96,"أَثِيمًۭا","(and) sinful","مَن كَانَ خَوَّانًا","",1040],["4:111:3",96,"إِثْمًۭا","sin","وَمَن يَكْسِبْ","فَإِنَّمَا يَكْسِبُهُۥ عَلَىٰ",327],["4:112:5",96,"إِثْمًۭا","a sin","يَكْسِبْ خَطِيٓـَٔةً أَوْ","ثُمَّ يَرْمِ بِهِۦ",327],["4:112:13",96,"وَإِثْمًۭا","and a sin","فَقَدِ ٱحْتَمَلَ بُهْتَـٰنًۭا","مُّبِينًۭا",327],["5:2:45",106,"ٱلْإِثْمِ","[the] sin","وَلَا تَعَاوَنُوا۟ عَلَى","وَٱلْعُدْوَٰنِ ۚ وَٱتَّقُوا۟ ٱللَّهَ ۖ",327],["5:3:57",107,"لِّإِثْمٍۢ ۙ","to sin","مَخْمَصَةٍ غَيْرَ مُتَجَانِفٍۢ","فَإِنَّ ٱللَّهَ غَفُورٌۭ",327],["5:29:5",112,"بِإِثْمِى","with my sin","أُرِيدُ أَن تَبُوٓأَ","وَإِثْمِكَ فَتَكُونَ مِنْ",327],["5:29:6",112,"وَإِثْمِكَ","and your sin","أَن تَبُوٓأَ بِإِثْمِى","فَتَكُونَ مِنْ أَصْحَـٰبِ",327],["5:62:6",118,"ٱلْإِثْمِ","[the] sin","مِّنْهُمْ يُسَـٰرِعُونَ فِى","وَٱلْعُدْوَٰنِ وَأَكْلِهِمُ ٱلسُّحْتَ ۚ",327],["5:63:7",118,"ٱلْإِثْمَ","the sinful","وَٱلْأَحْبَارُ عَن قَوْلِهِمُ","وَأَكْلِهِمُ ٱلسُّحْتَ ۚ لَبِئْسَ",327],["5:106:51",125,"ٱلْـَٔاثِمِينَ","the sinners","إِنَّآ إِذًۭا لَّمِنَ","",1754],["5:107:6",125,"إِثْمًۭا","(of) sin","عَلَىٰٓ أَنَّهُمَا ٱسْتَحَقَّآ","فَـَٔاخَرَانِ يَقُومَانِ مَقَامَهُمَا",327],["6:120:3",143,"ٱلْإِثْمِ","[the] sins","وَذَرُوا۟ ظَـٰهِرَ","وَبَاطِنَهُۥٓ ۚ إِنَّ ٱلَّذِينَ",327],["6:120:8",143,"ٱلْإِثْمَ","[the] sin","إِنَّ ٱلَّذِينَ يَكْسِبُونَ","سَيُجْزَوْنَ بِمَا كَانُوا۟",327],["7:33:11",154,"وَٱلْإِثْمَ","and the sin","مِنْهَا وَمَا بَطَنَ","وَٱلْبَغْىَ بِغَيْرِ ٱلْحَقِّ",327],["24:11:21",351,"ٱلْإِثْمِ ۚ","the sin","مَّا ٱكْتَسَبَ مِنَ","وَٱلَّذِى تَوَلَّىٰ كِبْرَهُۥ",327],["25:68:22",366,"أَثَامًۭا","a penalty","يَفْعَلْ ذَٰلِكَ يَلْقَ","",3043],["26:222:5",376,"أَثِيمٍۢ","sinful","عَلَىٰ كُلِّ أَفَّاكٍ","",1040],["33:58:11",426,"وَإِثْمًۭا","and sin","فَقَدِ ٱحْتَمَلُوا۟ بُهْتَـٰنًۭا","مُّبِينًۭا",327],["42:37:4",487,"ٱلْإِثْمِ","sins","وَٱلَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ","وَٱلْفَوَٰحِشَ وَإِذَا مَا",327],["44:44:2",498,"ٱلْأَثِيمِ","(of) the sinner(s)","طَعَامُ","",1040],["45:7:4",499,"أَثِيمٍۢ","sinful","وَيْلٌۭ لِّكُلِّ أَفَّاكٍ","",1040],["49:12:11",517,"إِثْمٌۭ ۖ","(is) sin","إِنَّ بَعْضَ ٱلظَّنِّ","وَلَا تَجَسَّسُوا۟ وَلَا",327],["52:23:8",524,"تَأْثِيمٌۭ","sin","لَغْوٌۭ فِيهَا وَلَا","",2651],["53:32:4",527,"ٱلْإِثْمِ","sins","ٱلَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ","وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ",327],["56:25:6",535,"تَأْثِيمًا","sinful (speech)","فِيهَا لَغْوًۭا وَلَا","",2651],["58:8:14",543,"بِٱلْإِثْمِ","for sin","نُهُوا۟ عَنْهُ وَيَتَنَـٰجَوْنَ","وَٱلْعُدْوَٰنِ وَمَعْصِيَتِ ٱلرَّسُولِ",327],["58:9:8",543,"بِٱلْإِثْمِ","for sin","تَنَـٰجَيْتُمْ فَلَا تَتَنَـٰجَوْا۟","وَٱلْعُدْوَٰنِ وَمَعْصِيَتِ ٱلرَّسُولِ",327],["68:12:4",564,"أَثِيمٍ","sinful","مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍ","",1040],["76:24:7",579,"ءَاثِمًا","any sinner","وَلَا تُطِعْ مِنْهُمْ","أَوْ كَفُورًۭا",1754],["83:12:7",588,"أَثِيمٍ","sinful","إِلَّا كُلُّ مُعْتَدٍ","",1040]]