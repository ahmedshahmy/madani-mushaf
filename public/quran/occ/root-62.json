[["2:7:4",3,"قُلُوبِهِمْ","their hearts","خَتَمَ ٱللَّهُ عَلَىٰ","وَعَلَىٰ سَمْعِهِمْ ۖ وَعَلَىٰٓ",86],["2:10:2",3,"قُلُوبِهِم","their hearts","فِى","مَّرَضٌۭ فَزَادَهُمُ ٱللَّهُ",86],["2:74:3",11,"قُلُوبُكُم","your hearts","ثُمَّ قَسَتْ","مِّنۢ بَعْدِ ذَٰلِكَ",86],["2:88:2",13,"قُلُوبُنَا","Our hearts","وَقَالُوا۟","غُلْفٌۢ ۚ بَل لَّعَنَهُمُ",86],["2:93:17",14,"قُلُوبِهِمُ","their hearts","وَعَصَيْنَا وَأُشْرِبُوا۟ فِى","ٱلْعِجْلَ بِكُفْرِهِمْ ۚ قُلْ",86],["2:97:9",15,"قَلْبِكَ","your heart","فَإِنَّهُۥ نَزَّلَهُۥ عَلَىٰ","بِإِذْنِ ٱللَّهِ مُصَدِّقًۭا",86],["2:118:19",18,"قُلُوبُهُمْ ۗ","their hearts","مِّثْلَ قَوْلِهِمْ ۘ تَشَـٰبَهَتْ","قَدْ بَيَّنَّا ٱلْـَٔايَـٰتِ",86],["2:143:25",22,"يَنقَلِبُ","turns back","يَتَّبِعُ ٱلرَّسُولَ مِمَّن","عَلَىٰ عَقِبَيْهِ ۚ وَإِن",584],["2:144:3",22,"تَقَلُّبَ","(the) turning","قَدْ نَرَىٰ","وَجْهِكَ فِى ٱلسَّمَآءِ ۖ",1402],["2:204:14",32,"قَلْبِهِۦ","his heart","عَلَىٰ مَا فِى","وَهُوَ أَلَدُّ ٱلْخِصَامِ",86],["2:225:11",36,"قُلُوبُكُمْ ۗ","your hearts","يُؤَاخِذُكُم بِمَا كَسَبَتْ","وَٱللَّهُ غَفُورٌ حَلِيمٌۭ",86],["2:260:16",44,"قَلْبِى ۖ","my heart","بَلَىٰ وَلَـٰكِن لِّيَطْمَئِنَّ","قَالَ فَخُذْ أَرْبَعَةًۭ",86],["2:283:28",49,"قَلْبُهُۥ ۗ","his heart","يَكْتُمْهَا فَإِنَّهُۥٓ ءَاثِمٌۭ","وَٱللَّهُ بِمَا تَعْمَلُونَ",86],["3:7:17",50,"قُلُوبِهِمْ","their hearts","فَأَمَّا ٱلَّذِينَ فِى","زَيْغٌۭ فَيَتَّبِعُونَ مَا",86],["3:8:4",50,"قُلُوبَنَا","our hearts","رَبَّنَا لَا تُزِغْ","بَعْدَ إِذْ هَدَيْتَنَا",86],["3:103:16",63,"قُلُوبِكُمْ","your hearts","أَعْدَآءًۭ فَأَلَّفَ بَيْنَ","فَأَصْبَحْتُم بِنِعْمَتِهِۦٓ إِخْوَٰنًۭا",86],["3:126:8",66,"قُلُوبُكُم","your hearts","بُشْرَىٰ لَكُمْ وَلِتَطْمَئِنَّ","بِهِۦ ۗ وَمَا ٱلنَّصْرُ",86],["3:127:8",66,"فَيَنقَلِبُوا۟","so (that) they turn back","كَفَرُوٓا۟ أَوْ يَكْبِتَهُمْ","خَآئِبِينَ",584],["3:144:14",68,"ٱنقَلَبْتُمْ","will you turn back","مَّاتَ أَوْ قُتِلَ","عَلَىٰٓ أَعْقَـٰبِكُمْ ۚ وَمَن",584],["3:144:18",68,"يَنقَلِبْ","turns back","عَلَىٰٓ أَعْقَـٰبِكُمْ ۚ وَمَن","عَلَىٰ عَقِبَيْهِ فَلَن",584],["3:149:11",69,"فَتَنقَلِبُوا۟","then you will turn back","يَرُدُّوكُمْ عَلَىٰٓ أَعْقَـٰبِكُمْ","خَـٰسِرِينَ",584],["3:151:3",69,"قُلُوبِ","(the) hearts","سَنُلْقِى فِى","ٱلَّذِينَ كَفَرُوا۟ ٱلرُّعْبَ",86],["3:154:71",70,"قُلُوبِكُمْ ۗ","your hearts","وَلِيُمَحِّصَ مَا فِى","وَٱللَّهُ عَلِيمٌۢ بِذَاتِ",86],["3:156:29",70,"قُلُوبِهِمْ ۗ","their hearts","ذَٰلِكَ حَسْرَةًۭ فِى","وَٱللَّهُ يُحْىِۦ وَيُمِيتُ ۗ",86],["3:159:11",71,"ٱلْقَلْبِ","(at) [the] heart","كُنتَ فَظًّا غَلِيظَ","لَٱنفَضُّوا۟ مِنْ حَوْلِكَ ۖ",86],["3:167:29",72,"قُلُوبِهِمْ ۗ","their hearts","مَّا لَيْسَ فِى","وَٱللَّهُ أَعْلَمُ بِمَا",86],["3:174:1",73,"فَٱنقَلَبُوا۟","So they returned","","بِنِعْمَةٍۢ مِّنَ ٱللَّهِ",584],["3:196:3",76,"تَقَلُّبُ","(the) movement","لَا يَغُرَّنَّكَ","ٱلَّذِينَ كَفَرُوا۟ فِى",1402],["4:63:7",88,"قُلُوبِهِمْ","their hearts","ٱللَّهُ مَا فِى","فَأَعْرِضْ عَنْهُمْ وَعِظْهُمْ",86],["4:155:12",103,"قُلُوبُنَا","Our hearts","بِغَيْرِ حَقٍّۢ وَقَوْلِهِمْ","غُلْفٌۢ ۚ بَلْ طَبَعَ",86],["5:13:6",109,"قُلُوبَهُمْ","their hearts","مِّيثَـٰقَهُمْ لَعَنَّـٰهُمْ وَجَعَلْنَا","قَـٰسِيَةًۭ ۖ يُحَرِّفُونَ ٱلْكَلِمَ",86],["5:21:13",111,"فَتَنقَلِبُوا۟","then you will turn back","تَرْتَدُّوا۟ عَلَىٰٓ أَدْبَارِكُمْ","خَـٰسِرِينَ",584],["5:41:16",114,"قُلُوبُهُمْ ۛ","their hearts","بِأَفْوَٰهِهِمْ وَلَمْ تُؤْمِن","وَمِنَ ٱلَّذِينَ هَادُوا۟ ۛ",86],["5:41:58",114,"قُلُوبَهُمْ ۚ","their hearts","ٱللَّهُ أَن يُطَهِّرَ","لَهُمْ فِى ٱلدُّنْيَا",86],["5:52:4",117,"قُلُوبِهِم","their hearts","فَتَرَى ٱلَّذِينَ فِى","مَّرَضٌۭ يُسَـٰرِعُونَ فِيهِمْ",86],["5:113:7",126,"قُلُوبُنَا","our hearts","نَّأْكُلَ مِنْهَا وَتَطْمَئِنَّ","وَنَعْلَمَ أَن قَدْ",86],["6:25:7",130,"قُلُوبِهِمْ","their hearts","إِلَيْكَ ۖ وَجَعَلْنَا عَلَىٰ","أَكِنَّةً أَن يَفْقَهُوهُ",86],["6:43:8",132,"قُلُوبُهُمْ","their hearts","تَضَرَّعُوا۟ وَلَـٰكِن قَسَتْ","وَزَيَّنَ لَهُمُ ٱلشَّيْطَـٰنُ",86],["6:46:10",133,"قُلُوبِكُم","your hearts","وَأَبْصَـٰرَكُمْ وَخَتَمَ عَلَىٰ","مَّنْ إِلَـٰهٌ غَيْرُ",86],["6:110:1",141,"وَنُقَلِّبُ","And We will turn","","أَفْـِٔدَتَهُمْ وَأَبْصَـٰرَهُمْ كَمَا",1219],["7:100:16",163,"قُلُوبِهِمْ","their hearts","بِذُنُوبِهِمْ ۚ وَنَطْبَعُ عَلَىٰ","فَهُمْ لَا يَسْمَعُونَ",86],["7:101:22",163,"قُلُوبِ","(the) hearts","يَطْبَعُ ٱللَّهُ عَلَىٰ","ٱلْكَـٰفِرِينَ",86],["7:119:3",164,"وَٱنقَلَبُوا۟","and returned","فَغُلِبُوا۟ هُنَالِكَ","صَـٰغِرِينَ",584],["7:125:5",165,"مُنقَلِبُونَ","(will) return","إِنَّآ إِلَىٰ رَبِّنَا","",1910],["7:179:9",174,"قُلُوبٌۭ","(are) hearts","ٱلْجِنِّ وَٱلْإِنسِ ۖ لَهُمْ","لَّا يَفْقَهُونَ بِهَا",86],["8:2:8",177,"قُلُوبُهُمْ","their hearts","ذُكِرَ ٱللَّهُ وَجِلَتْ","وَإِذَا تُلِيَتْ عَلَيْهِمْ",86],["8:10:8",178,"قُلُوبُكُمْ ۚ","your hearts","بُشْرَىٰ وَلِتَطْمَئِنَّ بِهِۦ","وَمَا ٱلنَّصْرُ إِلَّا",86],["8:11:19",178,"قُلُوبِكُمْ","your hearts","ٱلشَّيْطَـٰنِ وَلِيَرْبِطَ عَلَىٰ","وَيُثَبِّتَ بِهِ ٱلْأَقْدَامَ",86],["8:12:13",178,"قُلُوبِ","(the) hearts","ءَامَنُوا۟ ۚ سَأُلْقِى فِى","ٱلَّذِينَ كَفَرُوا۟ ٱلرُّعْبَ",86],["8:24:17",179,"وَقَلْبِهِۦ","and his heart","يَحُولُ بَيْنَ ٱلْمَرْءِ","وَأَنَّهُۥٓ إِلَيْهِ تُحْشَرُونَ",86],["8:49:6",183,"قُلُوبِهِم","their hearts","ٱلْمُنَـٰفِقُونَ وَٱلَّذِينَ فِى","مَّرَضٌ غَرَّ هَـٰٓؤُلَآءِ",86],["8:63:3",185,"قُلُوبِهِمْ ۚ","their hearts","وَأَلَّفَ بَيْنَ","لَوْ أَنفَقْتَ مَا",86],["8:63:13",185,"قُلُوبِهِمْ","their hearts","مَّآ أَلَّفْتَ بَيْنَ","وَلَـٰكِنَّ ٱللَّهَ أَلَّفَ",86],["8:70:13",186,"قُلُوبِكُمْ","your hearts","يَعْلَمِ ٱللَّهُ فِى","خَيْرًۭا يُؤْتِكُمْ خَيْرًۭا",86],["9:8:14",188,"قُلُوبُهُمْ","their hearts","يُرْضُونَكُم بِأَفْوَٰهِهِمْ وَتَأْبَىٰ","وَأَكْثَرُهُمْ فَـٰسِقُونَ",86],["9:15:3",189,"قُلُوبِهِمْ ۗ","(of) their hearts","وَيُذْهِبْ غَيْظَ","وَيَتُوبُ ٱللَّهُ عَلَىٰ",86],["9:45:10",194,"قُلُوبُهُمْ","their hearts","وَٱلْيَوْمِ ٱلْـَٔاخِرِ وَٱرْتَابَتْ","فَهُمْ فِى رَيْبِهِمْ",86],["9:48:6",195,"وَقَلَّبُوا۟","and had upset","ٱلْفِتْنَةَ مِن قَبْلُ","لَكَ ٱلْأُمُورَ حَتَّىٰ",1219],["9:60:8",196,"قُلُوبُهُمْ","their hearts","وَٱلْعَـٰمِلِينَ عَلَيْهَا وَٱلْمُؤَلَّفَةِ","وَفِى ٱلرِّقَابِ وَٱلْغَـٰرِمِينَ",86],["9:64:10",197,"قُلُوبِهِمْ ۚ","their hearts","تُنَبِّئُهُم بِمَا فِى","قُلِ ٱسْتَهْزِءُوٓا۟ إِنَّ",86],["9:77:4",199,"قُلُوبِهِمْ","their hearts","فَأَعْقَبَهُمْ نِفَاقًۭا فِى","إِلَىٰ يَوْمِ يَلْقَوْنَهُۥ",86],["9:87:8",201,"قُلُوبِهِمْ","their hearts","ٱلْخَوَالِفِ وَطُبِعَ عَلَىٰ","فَهُمْ لَا يَفْقَهُونَ",86],["9:93:16",201,"قُلُوبِهِمْ","their hearts","وَطَبَعَ ٱللَّهُ عَلَىٰ","فَهُمْ لَا يَعْلَمُونَ",86],["9:95:5",202,"ٱنقَلَبْتُمْ","you returned","بِٱللَّهِ لَكُمْ إِذَا","إِلَيْهِمْ لِتُعْرِضُوا۟ عَنْهُمْ ۖ",584],["9:110:8",204,"قُلُوبِهِمْ","their hearts","بَنَوْا۟ رِيبَةًۭ فِى","إِلَّآ أَن تَقَطَّعَ",86],["9:110:12",204,"قُلُوبُهُمْ ۗ","their hearts","إِلَّآ أَن تَقَطَّعَ","وَٱللَّهُ عَلِيمٌ حَكِيمٌ",86],["9:117:18",205,"قُلُوبُ","(the) hearts","مَا كَادَ يَزِيغُ","فَرِيقٍۢ مِّنْهُمْ ثُمَّ",86],["9:125:4",207,"قُلُوبِهِم","their hearts","وَأَمَّا ٱلَّذِينَ فِى","مَّرَضٌۭ فَزَادَتْهُمْ رِجْسًا",86],["9:127:17",207,"قُلُوبَهُم","their hearts","ٱنصَرَفُوا۟ ۚ صَرَفَ ٱللَّهُ","بِأَنَّهُمْ قَوْمٌۭ لَّا",86],["10:74:21",217,"قُلُوبِ","the hearts","كَذَٰلِكَ نَطْبَعُ عَلَىٰ","ٱلْمُعْتَدِينَ",86],["10:88:23",218,"قُلُوبِهِمْ","their hearts","أَمْوَٰلِهِمْ وَٱشْدُدْ عَلَىٰ","فَلَا يُؤْمِنُوا۟ حَتَّىٰ",86],["12:62:10",242,"ٱنقَلَبُوٓا۟","they go back","لَعَلَّهُمْ يَعْرِفُونَهَآ إِذَا","إِلَىٰٓ أَهْلِهِمْ لَعَلَّهُمْ",584],["13:28:4",252,"قُلُوبُهُم","their hearts","ٱلَّذِينَ ءَامَنُوا۟ وَتَطْمَئِنُّ","بِذِكْرِ ٱللَّهِ ۗ أَلَا",86],["13:28:11",252,"ٱلْقُلُوبُ","the hearts","بِذِكْرِ ٱللَّهِ تَطْمَئِنُّ","",86],["15:12:4",262,"قُلُوبِ","(the) hearts","كَذَٰلِكَ نَسْلُكُهُۥ فِى","ٱلْمُجْرِمِينَ",86],["16:22:8",269,"قُلُوبُهُم","their hearts","لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ","مُّنكِرَةٌۭ وَهُم مُّسْتَكْبِرُونَ",86],["16:46:4",272,"تَقَلُّبِهِمْ","their going to and fro","أَوْ يَأْخُذَهُمْ فِى","فَمَا هُم بِمُعْجِزِينَ",1402],["16:106:10",279,"وَقَلْبُهُۥ","while his heart","إِلَّا مَنْ أُكْرِهَ","مُطْمَئِنٌّۢ بِٱلْإِيمَـٰنِ وَلَـٰكِن",86],["16:108:6",279,"قُلُوبِهِمْ","their hearts","طَبَعَ ٱللَّهُ عَلَىٰ","وَسَمْعِهِمْ وَأَبْصَـٰرِهِمْ ۖ وَأُو۟لَـٰٓئِكَ",86],["17:46:3",286,"قُلُوبِهِمْ","their hearts","وَجَعَلْنَا عَلَىٰ","أَكِنَّةً أَن يَفْقَهُوهُ",86],["18:14:3",294,"قُلُوبِهِمْ","their hearts","وَرَبَطْنَا عَلَىٰ","إِذْ قَامُوا۟ فَقَالُوا۟",86],["18:18:5",295,"وَنُقَلِّبُهُمْ","And We turned them","أَيْقَاظًۭا وَهُمْ رُقُودٌۭ ۚ","ذَاتَ ٱلْيَمِينِ وَذَاتَ",1219],["18:28:23",297,"قَلْبَهُۥ","his heart","تُطِعْ مَنْ أَغْفَلْنَا","عَن ذِكْرِنَا وَٱتَّبَعَ",86],["18:36:12",298,"مُنقَلَبًۭا","(as) a return","لَأَجِدَنَّ خَيْرًۭا مِّنْهَا","",2497],["18:42:4",298,"يُقَلِّبُ","twisting","وَأُحِيطَ بِثَمَرِهِۦ فَأَصْبَحَ","كَفَّيْهِ عَلَىٰ مَآ",1219],["18:57:16",300,"قُلُوبِهِمْ","their hearts","إِنَّا جَعَلْنَا عَلَىٰ","أَكِنَّةً أَن يَفْقَهُوهُ",86],["21:3:2",322,"قُلُوبُهُمْ ۗ","their hearts","لَاهِيَةًۭ","وَأَسَرُّوا۟ ٱلنَّجْوَى ٱلَّذِينَ",86],["22:11:16",333,"ٱنقَلَبَ","he turns","وَإِنْ أَصَابَتْهُ فِتْنَةٌ","عَلَىٰ وَجْهِهِۦ خَسِرَ",584],["22:32:9",336,"ٱلْقُلُوبِ","(of) the hearts","فَإِنَّهَا مِن تَقْوَى","",86],["22:35:6",336,"قُلُوبُهُمْ","their hearts","ذُكِرَ ٱللَّهُ وَجِلَتْ","وَٱلصَّـٰبِرِينَ عَلَىٰ مَآ",86],["22:46:7",337,"قُلُوبٌۭ","hearts","ٱلْأَرْضِ فَتَكُونَ لَهُمْ","يَعْقِلُونَ بِهَآ أَوْ",86],["22:46:20",337,"ٱلْقُلُوبُ","the hearts","ٱلْأَبْصَـٰرُ وَلَـٰكِن تَعْمَى","ٱلَّتِى فِى ٱلصُّدُورِ",86],["22:53:8",338,"قُلُوبِهِم","their hearts","فِتْنَةًۭ لِّلَّذِينَ فِى","مَّرَضٌۭ وَٱلْقَاسِيَةِ قُلُوبُهُمْ ۗ",86],["22:53:11",338,"قُلُوبُهُمْ ۗ","their hearts","قُلُوبِهِم مَّرَضٌۭ وَٱلْقَاسِيَةِ","وَإِنَّ ٱلظَّـٰلِمِينَ لَفِى",86],["22:54:13",338,"قُلُوبُهُمْ ۗ","their hearts","بِهِۦ فَتُخْبِتَ لَهُۥ","وَإِنَّ ٱللَّهَ لَهَادِ",86],["23:60:5",346,"وَّقُلُوبُهُمْ","while their hearts","يُؤْتُونَ مَآ ءَاتَوا۟","وَجِلَةٌ أَنَّهُمْ إِلَىٰ",86],["23:63:2",346,"قُلُوبُهُمْ","their hearts","بَلْ","فِى غَمْرَةٍۢ مِّنْ",86],["24:37:16",355,"تَتَقَلَّبُ","will turn about","ٱلزَّكَوٰةِ ۙ يَخَافُونَ يَوْمًۭا","فِيهِ ٱلْقُلُوبُ وَٱلْأَبْصَـٰرُ",4426],["24:37:18",355,"ٱلْقُلُوبُ","the hearts","يَوْمًۭا تَتَقَلَّبُ فِيهِ","وَٱلْأَبْصَـٰرُ",86],["24:44:1",356,"يُقَلِّبُ","Allah alternates","","ٱللَّهُ ٱلَّيْلَ وَٱلنَّهَارَ ۚ",1219],["24:50:2",356,"قُلُوبِهِم","their hearts","أَفِى","مَّرَضٌ أَمِ ٱرْتَابُوٓا۟",86],["26:50:7",369,"مُنقَلِبُونَ","(will) return","إِنَّآ إِلَىٰ رَبِّنَا","",1910],["26:89:5",371,"بِقَلْبٍۢ","with a heart","مَنْ أَتَى ٱللَّهَ","سَلِيمٍۢ",86],["26:194:2",375,"قَلْبِكَ","your heart","عَلَىٰ","لِتَكُونَ مِنَ ٱلْمُنذِرِينَ",86],["26:200:4",375,"قُلُوبِ","(the) hearts","كَذَٰلِكَ سَلَكْنَـٰهُ فِى","ٱلْمُجْرِمِينَ",86],["26:219:1",376,"وَتَقَلُّبَكَ","And your movements","","فِى ٱلسَّـٰجِدِينَ",1402],["26:227:18",376,"مُنقَلَبٍۢ","return","ٱلَّذِينَ ظَلَمُوٓا۟ أَىَّ","يَنقَلِبُونَ",2497],["26:227:19",376,"يَنقَلِبُونَ","they will return","ظَلَمُوٓا۟ أَىَّ مُنقَلَبٍۢ","",584],["28:10:14",386,"قَلْبِهَا","her heart","أَن رَّبَطْنَا عَلَىٰ","لِتَكُونَ مِنَ ٱلْمُؤْمِنِينَ",86],["29:21:8",398,"تُقْلَبُونَ","you will be returned","مَن يَشَآءُ ۖ وَإِلَيْهِ","",4466],["30:59:5",410,"قُلُوبِ","(the) hearts","يَطْبَعُ ٱللَّهُ عَلَىٰ","ٱلَّذِينَ لَا يَعْلَمُونَ",86],["33:4:6",418,"قَلْبَيْنِ","two hearts","ٱللَّهُ لِرَجُلٍۢ مِّن","فِى جَوْفِهِۦ ۚ وَمَا",86],["33:5:24",418,"قُلُوبُكُمْ ۚ","your hearts","وَلَـٰكِن مَّا تَعَمَّدَتْ","وَكَانَ ٱللَّهُ غَفُورًۭا",86],["33:10:12",419,"ٱلْقُلُوبُ","the hearts","زَاغَتِ ٱلْأَبْصَـٰرُ وَبَلَغَتِ","ٱلْحَنَاجِرَ وَتَظُنُّونَ بِٱللَّهِ",86],["33:12:6",419,"قُلُوبِهِم","their hearts","ٱلْمُنَـٰفِقُونَ وَٱلَّذِينَ فِى","مَّرَضٌۭ مَّا وَعَدَنَا",86],["33:26:11",421,"قُلُوبِهِمُ","their hearts","صَيَاصِيهِمْ وَقَذَفَ فِى","ٱلرُّعْبَ فَرِيقًۭا تَقْتُلُونَ",86],["33:32:15",422,"قَلْبِهِۦ","his heart","فَيَطْمَعَ ٱلَّذِى فِى","مَرَضٌۭ وَقُلْنَ قَوْلًۭا",86],["33:51:31",425,"قُلُوبِكُمْ ۚ","your hearts","يَعْلَمُ مَا فِى","وَكَانَ ٱللَّهُ عَلِيمًا",86],["33:53:48",425,"لِقُلُوبِكُمْ","for your hearts","حِجَابٍۢ ۚ ذَٰلِكُمْ أَطْهَرُ","وَقُلُوبِهِنَّ ۚ وَمَا كَانَ",86],["33:53:49",425,"وَقُلُوبِهِنَّ ۚ","and their hearts","ذَٰلِكُمْ أَطْهَرُ لِقُلُوبِكُمْ","وَمَا كَانَ لَكُمْ",86],["33:60:7",426,"قُلُوبِهِم","their hearts","ٱلْمُنَـٰفِقُونَ وَٱلَّذِينَ فِى","مَّرَضٌۭ وَٱلْمُرْجِفُونَ فِى",86],["33:66:2",427,"تُقَلَّبُ","will be turned about","يَوْمَ","وُجُوهُهُمْ فِى ٱلنَّارِ",1219],["34:23:13",431,"قُلُوبِهِمْ","their hearts","إِذَا فُزِّعَ عَن","قَالُوا۟ مَاذَا قَالَ",86],["37:84:4",449,"بِقَلْبٍۢ","with a heart","إِذْ جَآءَ رَبَّهُۥ","سَلِيمٍ",86],["39:22:13",461,"قُلُوبُهُم","their hearts","رَّبِّهِۦ ۚ فَوَيْلٌۭ لِّلْقَـٰسِيَةِ","مِّن ذِكْرِ ٱللَّهِ ۚ",86],["39:23:17",461,"وَقُلُوبُهُمْ","and their hearts","ثُمَّ تَلِينُ جُلُودُهُمْ","إِلَىٰ ذِكْرِ ٱللَّهِ ۚ",86],["39:45:6",463,"قُلُوبُ","(the) hearts","ٱللَّهُ وَحْدَهُ ٱشْمَأَزَّتْ","ٱلَّذِينَ لَا يُؤْمِنُونَ",86],["40:4:11",467,"تَقَلُّبُهُمْ","their movement","كَفَرُوا۟ فَلَا يَغْرُرْكَ","فِى ٱلْبِلَـٰدِ",1402],["40:18:5",469,"ٱلْقُلُوبُ","the hearts","يَوْمَ ٱلْـَٔازِفَةِ إِذِ","لَدَى ٱلْحَنَاجِرِ كَـٰظِمِينَ ۚ",86],["40:35:21",471,"قَلْبِ","heart","ٱللَّهُ عَلَىٰ كُلِّ","مُتَكَبِّرٍۢ جَبَّارٍۢ",86],["41:5:2",477,"قُلُوبُنَا","Our hearts","وَقَالُوا۟","فِىٓ أَكِنَّةٍۢ مِّمَّا",86],["42:24:12",486,"قَلْبِكَ ۗ","your heart","ٱللَّهُ يَخْتِمْ عَلَىٰ","وَيَمْحُ ٱللَّهُ ٱلْبَـٰطِلَ",86],["43:14:4",490,"لَمُنقَلِبُونَ","will surely return","وَإِنَّآ إِلَىٰ رَبِّنَا","",1910],["45:23:13",501,"وَقَلْبِهِۦ","and his heart","وَخَتَمَ عَلَىٰ سَمْعِهِۦ","وَجَعَلَ عَلَىٰ بَصَرِهِۦ",86],["47:16:22",508,"قُلُوبِهِمْ","their hearts","طَبَعَ ٱللَّهُ عَلَىٰ","وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ",86],["47:19:13",508,"مُتَقَلَّبَكُمْ","your movement","وَٱلْمُؤْمِنَـٰتِ ۗ وَٱللَّهُ يَعْلَمُ","وَمَثْوَىٰكُمْ",3877],["47:20:17",509,"قُلُوبِهِم","their hearts","رَأَيْتَ ٱلَّذِينَ فِى","مَّرَضٌۭ يَنظُرُونَ إِلَيْكَ",86],["47:24:6",509,"قُلُوبٍ","(their) hearts","ٱلْقُرْءَانَ أَمْ عَلَىٰ","أَقْفَالُهَآ",86],["47:29:5",509,"قُلُوبِهِم","their hearts","حَسِبَ ٱلَّذِينَ فِى","مَّرَضٌ أَن لَّن",86],["48:4:6",511,"قُلُوبِ","(the) hearts","أَنزَلَ ٱلسَّكِينَةَ فِى","ٱلْمُؤْمِنِينَ لِيَزْدَادُوٓا۟ إِيمَـٰنًۭا",86],["48:11:16",512,"قُلُوبِهِمْ ۚ","their hearts","مَّا لَيْسَ فِى","قُلْ فَمَن يَمْلِكُ",86],["48:12:5",512,"يَنقَلِبَ","return","ظَنَنتُمْ أَن لَّن","ٱلرَّسُولُ وَٱلْمُؤْمِنُونَ إِلَىٰٓ",584],["48:12:14",512,"قُلُوبِكُمْ","your hearts","وَزُيِّنَ ذَٰلِكَ فِى","وَظَنَنتُمْ ظَنَّ ٱلسَّوْءِ",86],["48:18:13",513,"قُلُوبِهِمْ","their hearts","فَعَلِمَ مَا فِى","فَأَنزَلَ ٱلسَّكِينَةَ عَلَيْهِمْ",86],["48:26:6",514,"قُلُوبِهِمُ","their hearts","ٱلَّذِينَ كَفَرُوا۟ فِى","ٱلْحَمِيَّةَ حَمِيَّةَ ٱلْجَـٰهِلِيَّةِ",86],["49:3:12",515,"قُلُوبَهُمْ","their hearts","ٱلَّذِينَ ٱمْتَحَنَ ٱللَّهُ","لِلتَّقْوَىٰ ۚ لَهُم مَّغْفِرَةٌۭ",86],["49:7:20",516,"قُلُوبِكُمْ","your hearts","ٱلْإِيمَـٰنَ وَزَيَّنَهُۥ فِى","وَكَرَّهَ إِلَيْكُمُ ٱلْكُفْرَ",86],["49:14:14",517,"قُلُوبِكُمْ ۖ","your hearts","يَدْخُلِ ٱلْإِيمَـٰنُ فِى","وَإِن تُطِيعُوا۟ ٱللَّهَ",86],["50:33:6",519,"بِقَلْبٍۢ","with a heart","ٱلرَّحْمَـٰنَ بِٱلْغَيْبِ وَجَآءَ","مُّنِيبٍ",86],["50:37:8",520,"قَلْبٌ","a heart","لِمَن كَانَ لَهُۥ","أَوْ أَلْقَى ٱلسَّمْعَ",86],["57:16:7",539,"قُلُوبُهُمْ","their hearts","ءَامَنُوٓا۟ أَن تَخْشَعَ","لِذِكْرِ ٱللَّهِ وَمَا",86],["57:16:25",539,"قُلُوبُهُمْ ۖ","their hearts","عَلَيْهِمُ ٱلْأَمَدُ فَقَسَتْ","وَكَثِيرٌۭ مِّنْهُمْ فَـٰسِقُونَ",86],["57:27:14",541,"قُلُوبِ","(the) hearts","ٱلْإِنجِيلَ وَجَعَلْنَا فِى","ٱلَّذِينَ ٱتَّبَعُوهُ رَأْفَةًۭ",86],["58:22:25",545,"قُلُوبِهِمُ","their hearts","أُو۟لَـٰٓئِكَ كَتَبَ فِى","ٱلْإِيمَـٰنَ وَأَيَّدَهُم بِرُوحٍۢ",86],["59:2:31",545,"قُلُوبِهِمُ","their hearts","يَحْتَسِبُوا۟ ۖ وَقَذَفَ فِى","ٱلرُّعْبَ ۚ يُخْرِبُونَ بُيُوتَهُم",86],["59:10:16",547,"قُلُوبِنَا","our hearts","وَلَا تَجْعَلْ فِى","غِلًّۭا لِّلَّذِينَ ءَامَنُوا۟",86],["59:14:17",547,"وَقُلُوبُهُمْ","but their hearts","شَدِيدٌۭ ۚ تَحْسَبُهُمْ جَمِيعًۭا","شَتَّىٰ ۚ ذَٰلِكَ بِأَنَّهُمْ",86],["61:5:18",551,"قُلُوبَهُمْ ۚ","their hearts","زَاغُوٓا۟ أَزَاغَ ٱللَّهُ","وَٱللَّهُ لَا يَهْدِى",86],["63:3:8",554,"قُلُوبِهِمْ","their hearts","كَفَرُوا۟ فَطُبِعَ عَلَىٰ","فَهُمْ لَا يَفْقَهُونَ",86],["64:11:12",557,"قَلْبَهُۥ ۚ","his heart","يُؤْمِنۢ بِٱللَّهِ يَهْدِ","وَٱللَّهُ بِكُلِّ شَىْءٍ",86],["66:4:7",560,"قُلُوبُكُمَا ۖ","your hearts","ٱللَّهِ فَقَدْ صَغَتْ","وَإِن تَظَـٰهَرَا عَلَيْهِ",86],["67:4:5",562,"يَنقَلِبْ","Will return","ٱرْجِعِ ٱلْبَصَرَ كَرَّتَيْنِ","إِلَيْكَ ٱلْبَصَرُ خَاسِئًۭا",584],["74:31:31",576,"قُلُوبِهِم","their hearts","وَلِيَقُولَ ٱلَّذِينَ فِى","مَّرَضٌۭ وَٱلْكَـٰفِرُونَ مَاذَآ",86],["79:8:1",583,"قُلُوبٌۭ","Hearts","","يَوْمَئِذٍۢ وَاجِفَةٌ",86],["83:14:5",588,"قُلُوبِهِم","their hearts","بَلْ ۜ رَانَ عَلَىٰ","مَّا كَانُوا۟ يَكْسِبُونَ",86],["83:31:2",588,"ٱنقَلَبُوٓا۟","they returned","وَإِذَا","إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟",584],["83:31:5",588,"ٱنقَلَبُوا۟","they would return","ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ","فَكِهِينَ",584],["84:9:1",589,"وَيَنقَلِبُ","And he will return","","إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا",584]]