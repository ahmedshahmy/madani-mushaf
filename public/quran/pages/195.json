":52,"sd":null},{"k":"9:53","t":"Say, \"Spend willingly or unwillingly; never will it be accepted from you. Indeed, you have been a defiantly disobedient people.\"","j":10,"h":20,"s":9,"a":53,"sd":null},{"k":"9:54","t":"And what prevents their expenditures from being accepted from them but that they have disbelieved in Allāh and in His Messenger and that they come not to prayer except while they are lazy and that they do not spend except while they are unwilling.","j":10,"h":20,"s":9,"a":54,"sd":null}],"juz":10,"hizb":20,"surahs":[9],"sajdah":false}