P"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"42:22:12","a":"ٱلصَّـٰلِحَـٰتِ","t":"righteous deeds","p":"N","tr":"l-ṣāliḥāti","f":["ACT","PCPL","FP","GEN"],"r":55,"l":195,"g":[["ٱل","DET","prefix","Al"],["صَّـٰلِ","N","stem","ACT|PCPL|FP|GEN"]]},{"i":"42:22:13","a":"فِى","t":"(will be) in","p":"P","tr":"fī","l":3},{"i":"42:22:14","a":"رَوْضَاتِ","t":"flowering meadows","p":"N","tr":"rawḍāti","f":["FP","GEN"],"r":1210,"l":4183},{"i":"42:22:15","a":"ٱلْجَنَّاتِ ۖ","t":"(of) the Gardens","p":"N","tr":"l-janāti","f":["FP","GEN"],"r":46,"l":76,"g":[["ٱلْ","DET","prefix","Al"],["جَنَّاتِ","N","stem","FP|GEN"]]},{"i":"42:22:16","a":"لَهُم","t":"for them","p":"PRON","tr":"lahum","f":["3MP"],"l":11,"g":[["لَ","P","prefix","l:P"],["هُم","PRON","stem","3MP"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"42:22:17","a":"مَّا","t":"(is) whatever","p":"REL","tr":"mā","l":2},{"i":"42:22:18","a":"يَشَآءُونَ","t":"they wish","p":"V","tr":"yashāūna","f":["IMPF","3MP"],"r":10,"l":54,"g":[["يَشَآ","V","stem","IMPF|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"i":"42:22:19","a":"عِندَ","t":"with","p":"LOC","tr":"ʿinda","f":["ACC"],"r":45,"l":59},{"i":"42:22:20","a":"رَبِّهِمْ ۚ","t":"their Lord","p":"N","tr":"rabbihim","f":["M","GEN"],"r":3,"l":10,"g":[["رَبِّ","N","stem","M|GEN"],["هِمْ","PRON","suffix","PRON:3MP"]]},{"i":"42:22:21","a":"ذَٰلِكَ","t":"That","p":"DEM","tr":"dhālika","f":["MS"],"l":19},{"i":"42:22:22","a":"هُوَ","t":"it","p":"PRON","tr":"huwa","f":["3MS"],"l":20},{"i":"42:22:23","a":"ٱلْفَضْلُ","t":"(is) the Bounty","p":"N","tr":"l-faḍlu","f":["M","NOM"],"r":107,"l":131,"g":[["ٱلْ","DET","prefix","Al"],["فَضْلُ","N","stem","M|NOM"]]},{"i":"42:22:24","a":"ٱلْكَبِيرُ","t":"the Great","p":"ADJ","tr":"l-kabīru","f":["MS","NOM"],"r":66,"l":290,"g":[["ٱلْ","DET","prefix","Al"],["كَبِيرُ","ADJ","stem","MS|NOM"]]},{"e":"٢٢","v":"42:22"}]}],"verses":[{"k":"42:16","t":"And those who argue concerning Allāh after He has been responded to - their argument is invalid with their Lord, and upon them is [His] wrath, and for them is a severe punishment.","j":25,"h":49,"s":42,"a":16,"sd":null},{"k":"42:17","t":"It is Allāh who has sent down the Book in truth and [also] the balance [i.e., justice]. And what will make you perceive? Perhaps the Hour is near.","j":25,"h":49,"s":42,"a":17,"sd":null},{"k":"42:18","t":"Those who do not believe in it are impatient for it, but those who believe are fearful of it and know that it is the truth. Unquestionably, those who dispute concerning the Hour are in extreme error.","j":25,"h":49,"s":42,"a":18,"sd":null},{"k":"42:19","t":"Allāh is Subtle with His servants; He gives provision to whom He wills. And He is the Powerful, the Exalted in Might.","j":25,"h":49,"s":42,"a":19,"sd":null},{"k":"42:20","t":"Whoever desires the harvest of the Hereafter - We increase for him in his harvest [i.e., reward]. And whoever desires the harvest [i.e., benefits] of this world - We give him thereof, but there is not for him in the Hereafter any share.","j":25,"h":49,"s":42,"a":20,"sd":null},{"k":"42:21","t":"Or have they partners [i.e., other deities] who have ordained for them a religion to which Allāh has not consented? But if not for the decisive word, it would have been concluded between them. And indeed, the wrongdoers will have a painful punishment.","j":25,"h":49,"s":42,"a":21,"sd":null},{"k":"42:22","t":"You will see the wrongdoers fearful of what they have earned, and it will [certainly] befall them. And those who have believed and done righteous deeds will be in lush regions of the gardens [in Paradise] having whatever they will in the presence of their Lord. That is what is the great bounty.","j":25,"h":49,"s":42,"a":22,"sd":null}],"juz":25,"hizb":49,"surahs":[42],"sajdah":false}