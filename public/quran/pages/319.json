:[["وَ","CONJ","prefix","w:CONJ"],["صَرَّفْ","V","stem","PERF|(II)|1P"],["نَا","PRON","suffix","PRON:1P"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"20:113:6","a":"فِيهِ","t":"in it","p":"P","tr":"fīhi","l":3,"g":[["فِي","P","stem",""],["هِ","PRON","suffix","PRON:3MS"]]},{"i":"20:113:7","a":"مِنَ","t":"of","p":"P","tr":"mina","l":0},{"i":"20:113:8","a":"ٱلْوَعِيدِ","t":"the warnings","p":"N","tr":"l-waʿīdi","f":["M","GEN"],"r":73,"l":1241,"g":[["ٱلْ","DET","prefix","Al"],["وَعِيدِ","N","stem","M|GEN"]]},{"i":"20:113:9","a":"لَعَلَّهُمْ","t":"that they may","p":"ACC","tr":"laʿallahum","l":96,"g":[["لَعَلَّ","ACC","stem",""],["هُمْ","PRON","suffix","PRON:3MP"]]},{"i":"20:113:10","a":"يَتَّقُونَ","t":"fear","p":"V","tr":"yattaqūna","f":["IMPF","(VIII)","3MP"],"r":35,"l":67,"g":[["يَتَّقُ","V","stem","IMPF|(VIII)|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"i":"20:113:11","a":"أَوْ","t":"or","p":"CONJ","tr":"aw","l":42},{"i":"20:113:12","a":"يُحْدِثُ","t":"it may cause","p":"V","tr":"yuḥ'dithu","f":["IMPF","(IV)","3MS"],"r":257,"l":2076},{"i":"20:113:13","a":"لَهُمْ","t":"[for] them","p":"PRON","tr":"lahum","f":["3MP"],"l":11,"g":[["لَ","P","prefix","l:P"],["هُمْ","PRON","stem","3MP"]]},{"i":"20:113:14","a":"ذِكْرًۭا","t":"remembrance","p":"N","tr":"dhik'ran","f":["VN","M","INDEF","ACC"],"r":28,"l":149},{"e":"١١٣","v":"20:113"}]}],"verses":[{"k":"20:99","t":"Thus, [O Muḥammad], We relate to you from the news of what has preceded. And We have certainly given you from Us a message [i.e., the Qur’ān].","j":16,"h":32,"s":20,"a":99,"sd":null},{"k":"20:100","t":"Whoever turns away from it - then indeed, he will bear on the Day of Resurrection a burden [i.e., great sin],","j":16,"h":32,"s":20,"a":100,"sd":null},{"k":"20:101","t":"[Abiding] eternally therein, and evil it is for them on the Day of Resurrection as a load -","j":16,"h":32,"s":20,"a":101,"sd":null},{"k":"20:102","t":"The Day the Horn will be blown. And We will gather the criminals, that Day, blue-eyed.","j":16,"h":32,"s":20,"a":102,"sd":null},{"k":"20:103","t":"They will murmur among themselves, \"You remained not but ten [days in the world].\"","j":16,"h":32,"s":20,"a":103,"sd":null},{"k":"20:104","t":"We are most knowing of what they say when the best of them in manner [i.e., wisdom or speech] will say, \"You remained not but one day.\"","j":16,"h":32,"s":20,"a":104,"sd":null},{"k":"20:105","t":"And they ask you about the mountains, so say, \"My Lord will blow them away with a blast.","j":16,"h":32,"s":20,"a":105,"sd":null},{"k":"20:106","t":"And He will leave it [i.e., the earth] a level plain;","j":16,"h":32,"s":20,"a":106,"sd":null},{"k":"20:107","t":"You will not see therein a depression or an elevation.\"","j":16,"h":32,"s":20,"a":107,"sd":null},{"k":"20:108","t":"That Day, they [i.e., everyone] will follow [the call of] the Caller [with] no deviation therefrom, and [all] voices will be stilled before the Most Merciful, so you will not hear except a whisper [of footsteps].","j":16,"h":32,"s":20,"a":108,"sd":null},{"k":"20:109","t":"That Day, no intercession will benefit except [that of] one to whom the Most Merciful has given permission and has accepted his word.","j":16,"h":32,"s":20,"a":109,"sd":null},{"k":"20:110","t":"He [i.e., Allāh] knows what is [presently] before them and what will be after them, but they do not encompass it [i.e., what He knows] in knowledge.","j":16,"h":32,"s":20,"a":110,"sd":null},{"k":"20:111","t":"And [all] faces will be humbled before the Ever-Living, the Self-Sustaining. And he will have failed who carries injustice.","j":16,"h":32,"s":20,"a":111,"sd":null},{"k":"20:112","t":"But he who does of righteous deeds while he is a believer - he will neither fear injustice nor deprivation.","j":16,"h":32,"s":20,"a":112,"sd":null},{"k":"20:113","t":"And thus We have sent it down as an Arabic Qur’ān and have diversified therein the warnings that perhaps they will avoid [sin] or it would cause them remembrance.","j":16,"h":32,"s":20,"a":113,"sd":null}],"juz":16,"hizb":32,"surahs":[20],"sajdah":false}