,"l":61,"g":[["أَنزَلْ","V","stem","PERF|(IV)|1P"],["نَآ","PRON","suffix","PRON:1P"]]},{"i":"58:5:14","a":"ءَايَـٰتٍۭ","t":"Verses","p":"N","tr":"āyātin","f":["FP","INDEF","ACC"],"r":14,"l":28},{"i":"58:5:15","a":"بَيِّنَـٰتٍۢ ۚ","t":"clear","p":"ADJ","tr":"bayyinātin","f":["FP","INDEF","ACC"],"r":9,"l":171}]},{"l":14,"t":"a","c":0,"w":[{"i":"58:5:16","a":"وَلِلْكَـٰفِرِينَ","t":"And for the disbelievers","p":"N","tr":"walil'kāfirīna","f":["ACT","PCPL","MP","GEN"],"r":8,"l":90,"g":[["وَ","CONJ","prefix","w:CONJ"],["َ","P","prefix","l:P"],["لِ","DET","prefix","Al"],["ِلْكَـٰ","N","stem","ACT|PCPL|MP|GEN"]]},{"i":"58:5:17","a":"عَذَابٌۭ","t":"(is) a punishment","p":"N","tr":"ʿadhābun","f":["M","INDEF","NOM"],"r":17,"l":36},{"i":"58:5:18","a":"مُّهِينٌۭ","t":"humiliating","p":"ADJ","tr":"muhīnun","f":["ACT","PCPL","(IV)","M","INDEF","NOM"],"r":338,"l":670},{"e":"٥","v":"58:5"},{"i":"58:6:1","a":"يَوْمَ","t":"(On the) Day","p":"N","tr":"yawma","f":["M","ACC"],"r":13,"l":25},{"i":"58:6:2","a":"يَبْعَثُهُمُ","t":"(when) Allah will raise them","p":"V","tr":"yabʿathuhumu","f":["IMPF","3MS"],"r":162,"l":227,"g":[["يَبْعَثُ","V","stem","IMPF|3MS"],["هُمُ","PRON","suffix","PRON:3MP"]]},{"i":"58:6:3","a":"ٱللَّهُ","t":"(when) Allah will raise them","p":"PN","tr":"l-lahu","f":["NOM"],"r":0,"l":1},{"i":"58:6:4","a":"جَمِيعًۭا","t":"all","p":"N","tr":"jamīʿan","f":["M","INDEF","ACC"],"r":84,"l":224},{"i":"58:6:5","a":"فَيُنَبِّئُهُم","t":"and inform them","p":"V","tr":"fayunabbi-uhum","f":["IMPF","(II)","3MS"],"r":68,"l":255,"g":[["فَ","CONJ","prefix","f:CONJ"],["يُنَبِّئُ","V","stem","IMPF|(II)|3MS"],["هُم","PRON","suffix","PRON:3MP"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"58:6:6","a":"بِمَا","t":"of what","p":"REL","tr":"bimā","l":2,"g":[["بِ","P","prefix","bi"],["مَا","REL","stem",""]]},{"i":"58:6:7","a":"عَمِلُوٓا۟ ۚ","t":"they did","p":"V","tr":"ʿamilū","f":["PERF","3MP"],"r":18,"l":44,"g":[["عَمِلُ","V","stem","PERF|3MP"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"58:6:8","a":"أَحْصَىٰهُ","t":"Allah has recorded it","p":"V","tr":"aḥṣāhu","f":["PERF","(IV)","3MS"],"r":544,"l":815,"g":[["أَحْصَ","V","stem","PERF|(IV)|3MS"],["َ","PRON","suffix","PRON:3MS"]]},{"i":"58:6:9","a":"ٱللَّهُ","t":"Allah has recorded it","p":"PN","tr":"l-lahu","f":["NOM"],"r":0,"l":1},{"i":"58:6:10","a":"وَنَسُوهُ ۚ","t":"while they forgot it","p":"V","tr":"wanasūhu","f":["PERF","3MP"],"r":216,"l":333,"g":[["وَ","CIRC","prefix","w:CIRC"],["نَسُ","V","stem","PERF|3MP"],["و","PRON","suffix","PRON:3MP"],["هُ","PRON","suffix","PRON:3MS"]]},{"i":"58:6:11","a":"وَٱللَّهُ","t":"And Allah","p":"PN","tr":"wal-lahu","f":["NOM"],"r":0,"l":1,"g":[["وَ","CONJ","prefix","w:CONJ"],["ٱللَّهُ","PN","stem","NOM"]]},{"i":"58:6:12","a":"عَلَىٰ","t":"(is) over","p":"P","tr":"ʿalā","l":8},{"i":"58:6:13","a":"كُلِّ","t":"all","p":"N","tr":"kulli","f":["M","GEN"],"r":16,"l":31},{"i":"58:6:14","a":"شَىْءٍۢ","t":"things","p":"N","tr":"shayin","f":["M","INDEF","GEN"],"r":10,"l":41},{"i":"58:6:15","a":"شَهِيدٌ","t":"a Witness","p":"ADJ","tr":"shahīdun","f":["MS","INDEF","NOM"],"r":67,"l":214},{"e":"٦","v":"58:6"}]}],"verses":[{"k":"58:1","t":"Certainly has Allāh heard the speech of the one who argues [i.e., pleads] with you, [O Muḥammad], concerning her husband and directs her complaint to Allāh. And Allāh hears your dialogue; indeed, Allāh is Hearing and Seeing.","j":28,"h":55,"s":58,"a":1,"sd":null},{"k":"58:2","t":"Those who pronounce ẓihār among you [to separate] from their wives - they are not [consequently] their mothers. Their mothers are none but those who gave birth to them. And indeed, they are saying an objectionable statement and a falsehood. But indeed, Allāh is Pardoning and Forgiving.","j":28,"h":55,"s":58,"a":2,"sd":null},{"k":"58:3","t":"And those who pronounce ẓihār from their wives and then [wish to] go back on what they said - then [there must be] the freeing of a slave before they touch one another. That is what you are admonished thereby; and Allāh is Aware of what you do.","j":28,"h":55,"s":58,"a":3,"sd":null},{"k":"58:4","t":"And he who does not find [a slave] - then a fast for two months consecutively before they touch one another; and he who is unable - then the feeding of sixty poor persons. That is for you to believe [completely] in Allāh and His Messenger; and those are the limits [set by] Allāh. And for the disbelievers is a painful punishment.","j":28,"h":55,"s":58,"a":4,"sd":null},{"k":"58:5","t":"Indeed, those who oppose Allāh and His Messenger are abased as those before them were abased. And We have certainly sent down verses of clear evidence. And for the disbelievers is a humiliating punishment","j":28,"h":55,"s":58,"a":5,"sd":null},{"k":"58:6","t":"On the Day when Allāh will resurrect them all and inform them of what they did. Allāh had enumerated it, while they forgot it; and Allāh is, over all things, Witness.","j":28,"h":55,"s":58,"a":6,"sd":null}],"juz":28,"hizb":55,"surahs":[58],"sajdah":false}