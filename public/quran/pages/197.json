":775,"g":[["حَسْبُ","N","stem","M|NOM"],["هُمْ","PRON","suffix","PRON:3MP"]]},{"i":"9:68:12","a":"وَلَعَنَهُمُ","t":"And Allah has cursed them","p":"V","tr":"walaʿanahumu","f":["PERF","3MS"],"r":238,"l":456,"g":[["وَ","CONJ","prefix","w:CONJ"],["لَعَنَ","V","stem","PERF|3MS"],["هُمُ","PRON","suffix","PRON:3MP"]]},{"i":"9:68:13","a":"ٱللَّهُ ۖ","t":"And Allah has cursed them","p":"PN","tr":"l-lahu","f":["NOM"],"r":0,"l":1},{"i":"9:68:14","a":"وَلَهُمْ","t":"and for them","p":"PRON","tr":"walahum","f":["3MP"],"l":11,"g":[["وَ","CONJ","prefix","w:CONJ"],["لَ","P","prefix","l:P"],["هُمْ","PRON","stem","3MP"]]},{"i":"9:68:15","a":"عَذَابٌۭ","t":"(is) a punishment","p":"N","tr":"ʿadhābun","f":["M","INDEF","NOM"],"r":17,"l":36},{"i":"9:68:16","a":"مُّقِيمٌۭ","t":"enduring","p":"N","tr":"muqīmun","f":["ACT","PCPL","(IV)","M","INDEF","NOM"],"r":6,"l":851},{"e":"٦٨","v":"9:68"}]}],"verses":[{"k":"9:62","t":"They swear by Allāh to you [Muslims] to satisfy you. But Allāh and His Messenger are more worthy for them to satisfy, if they were to be believers.","j":10,"h":20,"s":9,"a":62,"sd":null},{"k":"9:63","t":"Do they not know that whoever opposes Allāh and His Messenger - that for him is the fire of Hell, wherein he will abide eternally? That is the great disgrace.","j":10,"h":20,"s":9,"a":63,"sd":null},{"k":"9:64","t":"The hypocrites are apprehensive lest a sūrah be revealed about them, informing them of what is in their hearts. Say, \"Mock [as you wish]; indeed, Allāh will expose that which you fear.\"","j":10,"h":20,"s":9,"a":64,"sd":null},{"k":"9:65","t":"And if you ask them, they will surely say, \"We were only conversing and playing.\" Say, \"Is it Allāh and His verses and His Messenger that you were mocking?\"","j":10,"h":20,"s":9,"a":65,"sd":null},{"k":"9:66","t":"Make no excuse; you have disbelieved [i.e., rejected faith] after your belief. If We pardon one faction of you - We will punish another faction because they were criminals.","j":10,"h":20,"s":9,"a":66,"sd":null},{"k":"9:67","t":"The hypocrite men and hypocrite women are of one another. They enjoin what is wrong and forbid what is right and close their hands. They have forgotten Allāh, so He has forgotten them [accordingly]. Indeed, the hypocrites - it is they who are the defiantly disobedient.","j":10,"h":20,"s":9,"a":67,"sd":null},{"k":"9:68","t":"Allāh has promised the hypocrite men and hypocrite women and the disbelievers the fire of Hell, wherein they will abide eternally. It is sufficient for them. And Allāh has cursed them, and for them is an enduring punishment.","j":10,"h":20,"s":9,"a":68,"sd":null}],"juz":10,"hizb":20,"surahs":[9],"sajdah":false}