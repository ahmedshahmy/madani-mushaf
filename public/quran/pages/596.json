"your breast","p":"N","tr":"ṣadraka","f":["M","ACC"],"r":212,"l":266,"g":[["صَدْرَ","N","stem","M|ACC"],["كَ","PRON","suffix","PRON:2MS"]]},{"e":"١","v":"94:1"},{"i":"94:2:1","a":"وَوَضَعْنَا","t":"And We removed","p":"V","tr":"wawaḍaʿnā","f":["PERF","1P"],"r":341,"l":497,"g":[["وَ","CONJ","prefix","w:CONJ"],["وَضَعْ","V","stem","PERF|1P"],["نَا","PRON","suffix","PRON:1P"]]},{"i":"94:2:2","a":"عَنكَ","t":"from you","p":"P","tr":"ʿanka","l":21,"g":[["عَن","P","stem",""],["كَ","PRON","suffix","PRON:2MS"]]},{"i":"94:2:3","a":"وِزْرَكَ","t":"your burden","p":"N","tr":"wiz'raka","f":["F","ACC"],"r":336,"l":747,"g":[["وِزْرَ","N","stem","F|ACC"],["كَ","PRON","suffix","PRON:2MS"]]},{"e":"٢","v":"94:2"}]}],"verses":[{"k":"92:10","t":"We will ease him toward difficulty.","j":30,"h":60,"s":92,"a":10,"sd":null},{"k":"92:11","t":"And what will his wealth avail him when he falls?","j":30,"h":60,"s":92,"a":11,"sd":null},{"k":"92:12","t":"Indeed, [incumbent] upon Us is guidance.","j":30,"h":60,"s":92,"a":12,"sd":null},{"k":"92:13","t":"And indeed, to us belongs the Hereafter and the first [life].","j":30,"h":60,"s":92,"a":13,"sd":null},{"k":"92:14","t":"So I have warned you of a Fire which is blazing.","j":30,"h":60,"s":92,"a":14,"sd":null},{"k":"92:15","t":"None will [enter to] burn therein except the most wretched one","j":30,"h":60,"s":92,"a":15,"sd":null},{"k":"92:16","t":"Who had denied and turned away.","j":30,"h":60,"s":92,"a":16,"sd":null},{"k":"92:17","t":"But the righteous one will avoid it","j":30,"h":60,"s":92,"a":17,"sd":null},{"k":"92:18","t":"[He] who gives [from] his wealth to purify himself","j":30,"h":60,"s":92,"a":18,"sd":null},{"k":"92:19","t":"And not [giving] for anyone who has [done him] a favor to be rewarded","j":30,"h":60,"s":92,"a":19,"sd":null},{"k":"92:20","t":"But only seeking the face [i.e., acceptance] of his Lord, Most High.","j":30,"h":60,"s":92,"a":20,"sd":null},{"k":"92:21","t":"And he is going to be satisfied.","j":30,"h":60,"s":92,"a":21,"sd":null},{"k":"93:1","t":"By the morning brightness","j":30,"h":60,"s":93,"a":1,"sd":null},{"k":"93:2","t":"And [by] the night when it covers with darkness,","j":30,"h":60,"s":93,"a":2,"sd":null},{"k":"93:3","t":"Your Lord has not taken leave of you, [O Muḥammad], nor has He detested [you].","j":30,"h":60,"s":93,"a":3,"sd":null},{"k":"93:4","t":"And the Hereafter is better for you than the first [life].","j":30,"h":60,"s":93,"a":4,"sd":null},{"k":"93:5","t":"And your Lord is going to give you, and you will be satisfied.","j":30,"h":60,"s":93,"a":5,"sd":null},{"k":"93:6","t":"Did He not find you an orphan and give [you] refuge?","j":30,"h":60,"s":93,"a":6,"sd":null},{"k":"93:7","t":"And He found you lost and guided [you],","j":30,"h":60,"s":93,"a":7,"sd":null},{"k":"93:8","t":"And He found you poor and made [you] self-sufficient.","j":30,"h":60,"s":93,"a":8,"sd":null},{"k":"93:9","t":"So as for the orphan, do not oppress [him].","j":30,"h":60,"s":93,"a":9,"sd":null},{"k":"93:10","t":"And as for the petitioner, do not repel [him].","j":30,"h":60,"s":93,"a":10,"sd":null},{"k":"93:11","t":"But as for the favor of your Lord, report [it].","j":30,"h":60,"s":93,"a":11,"sd":null},{"k":"94:1","t":"Did We not expand for you, [O Muḥammad], your breast?","j":30,"h":60,"s":94,"a":1,"sd":null},{"k":"94:2","t":"And We removed from you your burden","j":30,"h":60,"s":94,"a":2,"sd":null}],"juz":30,"hizb":60,"surahs":[92,93,94],"sajdah":false}