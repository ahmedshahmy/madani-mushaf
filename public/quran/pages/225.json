":23,"s":11,"a":35,"sd":null},{"k":"11:36","t":"And it was revealed to Noah that, \"No one will believe from your people except those who have already believed, so do not be distressed by what they have been doing.","j":12,"h":23,"s":11,"a":36,"sd":null},{"k":"11:37","t":"And construct the ship under Our observation and Our inspiration and do not address Me concerning those who have wronged; indeed, they are [to be] drowned.\"","j":12,"h":23,"s":11,"a":37,"sd":null}],"juz":12,"hizb":23,"surahs":[11],"sajdah":false}