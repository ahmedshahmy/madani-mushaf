ffix","PRON:3MS"]]},{"i":"19:95:3","a":"يَوْمَ","t":"(on the) Day","p":"T","tr":"yawma","f":["M","ACC"],"r":13,"l":25},{"i":"19:95:4","a":"ٱلْقِيَـٰمَةِ","t":"(of) the Resurrection","p":"N","tr":"l-qiyāmati","f":["F","GEN"],"r":6,"l":174,"g":[["ٱلْ","DET","prefix","Al"],["ْقِيَـٰ","N","stem","F|GEN"]]},{"i":"19:95:5","a":"فَرْدًا","t":"alone","p":"N","tr":"fardan","f":["M","INDEF","ACC"],"r":780,"l":1829},{"e":"٩٥","v":"19:95"}]}],"verses":[{"k":"19:77","t":"Then, have you seen he who disbelieved in Our verses and said, \"I will surely be given wealth and children [in the next life]\"?","j":16,"h":31,"s":19,"a":77,"sd":null},{"k":"19:78","t":"Has he looked into the unseen, or has he taken from the Most Merciful a promise?","j":16,"h":31,"s":19,"a":78,"sd":null},{"k":"19:79","t":"No! We will record what he says and extend [i.e., increase] for him from the punishment extensively.","j":16,"h":31,"s":19,"a":79,"sd":null},{"k":"19:80","t":"And We will inherit him [in] what he mentions, and he will come to Us alone.","j":16,"h":31,"s":19,"a":80,"sd":null},{"k":"19:81","t":"And they have taken besides Allāh [false] deities that they would be for them [a source of] honor.","j":16,"h":31,"s":19,"a":81,"sd":null},{"k":"19:82","t":"No! They [i.e., those \"gods\"] will deny their worship of them and will be against them opponents [on the Day of Judgement].","j":16,"h":31,"s":19,"a":82,"sd":null},{"k":"19:83","t":"Do you not see that We have sent the devils upon the disbelievers, inciting them [to evil] with [constant] incitement?","j":16,"h":31,"s":19,"a":83,"sd":null},{"k":"19:84","t":"So be not impatient over them. We only count out [i.e., allow] to them a [limited] number.","j":16,"h":31,"s":19,"a":84,"sd":null},{"k":"19:85","t":"On the Day We will gather the righteous to the Most Merciful as a delegation","j":16,"h":31,"s":19,"a":85,"sd":null},{"k":"19:86","t":"And will drive the criminals to Hell in thirst","j":16,"h":31,"s":19,"a":86,"sd":null},{"k":"19:87","t":"None will have [power of] intercession except he who had taken from the Most Merciful a covenant.","j":16,"h":31,"s":19,"a":87,"sd":null},{"k":"19:88","t":"And they say, \"The Most Merciful has taken [for Himself] a son.\"","j":16,"h":31,"s":19,"a":88,"sd":null},{"k":"19:89","t":"You have done an atrocious thing.","j":16,"h":31,"s":19,"a":89,"sd":null},{"k":"19:90","t":"The heavens almost rupture therefrom and the earth splits open and the mountains collapse in devastation","j":16,"h":31,"s":19,"a":90,"sd":null},{"k":"19:91","t":"That they attribute to the Most Merciful a son.","j":16,"h":31,"s":19,"a":91,"sd":null},{"k":"19:92","t":"And it is not appropriate for the Most Merciful that He should take a son.","j":16,"h":31,"s":19,"a":92,"sd":null},{"k":"19:93","t":"There is no one in the heavens and earth but that he comes to the Most Merciful as a servant.","j":16,"h":31,"s":19,"a":93,"sd":null},{"k":"19:94","t":"He has enumerated them and counted them a [full] counting.","j":16,"h":31,"s":19,"a":94,"sd":null},{"k":"19:95","t":"And all of them are coming to Him on the Day of Resurrection alone.","j":16,"h":31,"s":19,"a":95,"sd":null}],"juz":16,"hizb":31,"surahs":[19],"sajdah":false}