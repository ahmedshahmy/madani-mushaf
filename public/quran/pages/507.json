:"ٱللَّهَ","t":"Allah","p":"PN","tr":"l-laha","f":["ACC"],"r":0,"l":1},{"i":"47:11:4","a":"مَوْلَى","t":"(is the) Protector","p":"N","tr":"mawlā","f":["M","NOM"],"r":41,"l":551},{"i":"47:11:5","a":"ٱلَّذِينَ","t":"(of) those who","p":"REL","tr":"alladhīna","f":["MP"],"l":7},{"i":"47:11:6","a":"ءَامَنُوا۟","t":"believe","p":"V","tr":"āmanū","f":["PERF","(IV)","3MP"],"r":4,"l":18,"g":[["امَنُ","V","stem","PERF|(IV)|3MP"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"47:11:7","a":"وَأَنَّ","t":"and that","p":"ACC","tr":"wa-anna","l":30,"g":[["وَ","CONJ","prefix","w:CONJ"],["أَنَّ","ACC","stem",""]]},{"i":"47:11:8","a":"ٱلْكَـٰفِرِينَ","t":"the disbelievers","p":"N","tr":"l-kāfirīna","f":["ACT","PCPL","MP","ACC"],"r":8,"l":90,"g":[["ٱلْ","DET","prefix","Al"],["ْكَـٰفِ","N","stem","ACT|PCPL|MP|ACC"]]},{"i":"47:11:9","a":"لَا","t":"(there is) no","p":"NEG","tr":"lā","l":4},{"i":"47:11:10","a":"مَوْلَىٰ","t":"protector","p":"N","tr":"mawlā","f":["M","ACC"],"r":41,"l":551},{"i":"47:11:11","a":"لَهُمْ","t":"for them","p":"PRON","tr":"lahum","f":["3MP"],"l":11,"g":[["لَ","P","prefix","l:P"],["هُمْ","PRON","stem","3MP"]]},{"e":"١١","v":"47:11"}]}],"verses":[{"k":"47:1","t":"Those who disbelieve and avert [people] from the way of Allāh - He will waste their deeds.","j":26,"h":51,"s":47,"a":1,"sd":null},{"k":"47:2","t":"And those who believe and do righteous deeds and believe in what has been sent down upon Muḥammad - and it is the truth from their Lord - He will remove from them their misdeeds and amend their condition.","j":26,"h":51,"s":47,"a":2,"sd":null},{"k":"47:3","t":"That is because those who disbelieve follow falsehood, and those who believe follow the truth from their Lord. Thus does Allāh present to the people their comparisons.","j":26,"h":51,"s":47,"a":3,"sd":null},{"k":"47:4","t":"So when you meet those who disbelieve [in battle], strike [their] necks until, when you have inflicted slaughter upon them, then secure [their] bonds, and either [confer] favor afterwards or ransom [them] until the war lays down its burdens. That [is the command]. And if Allāh had willed, He could have taken vengeance upon them [Himself], but [He ordered armed struggle] to test some of you by means of others. And those who are killed in the cause of Allāh - never will He waste their deeds.","j":26,"h":51,"s":47,"a":4,"sd":null},{"k":"47:5","t":"He will guide them and amend their condition","j":26,"h":51,"s":47,"a":5,"sd":null},{"k":"47:6","t":"And admit them to Paradise, which He has made known to them.","j":26,"h":51,"s":47,"a":6,"sd":null},{"k":"47:7","t":"O you who have believed, if you support Allāh, He will support you and plant firmly your feet.","j":26,"h":51,"s":47,"a":7,"sd":null},{"k":"47:8","t":"But those who disbelieve - for them is misery, and He will waste their deeds.","j":26,"h":51,"s":47,"a":8,"sd":null},{"k":"47:9","t":"That is because they disliked what Allāh revealed, so He rendered worthless their deeds.","j":26,"h":51,"s":47,"a":9,"sd":null},{"k":"47:10","t":"Have they not traveled through the land and seen how was the end of those before them? Allāh destroyed [everything] over them, and for the disbelievers is something comparable.","j":26,"h":51,"s":47,"a":10,"sd":null},{"k":"47:11","t":"That is because Allāh is the protector of those who have believed and because the disbelievers have no protector.","j":26,"h":51,"s":47,"a":11,"sd":null}],"juz":26,"hizb":51,"surahs":[47],"sajdah":false}