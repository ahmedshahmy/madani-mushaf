"r":30,"l":63,"g":[["تُكَذِّبَ","V","stem","IMPF|(II)|2D"],["انِ","PRON","suffix","PRON:2D"]]},{"e":"١٨","v":"55:18"}]}],"verses":[{"k":"54:50","t":"And Our command is but one, like a glance of the eye.","j":27,"h":53,"s":54,"a":50,"sd":null},{"k":"54:51","t":"And We have already destroyed your kinds, so is there any who will remember?","j":27,"h":53,"s":54,"a":51,"sd":null},{"k":"54:52","t":"And everything they did is in written records.","j":27,"h":53,"s":54,"a":52,"sd":null},{"k":"54:53","t":"And every small and great [thing] is inscribed.","j":27,"h":53,"s":54,"a":53,"sd":null},{"k":"54:54","t":"Indeed, the righteous will be among gardens and rivers,","j":27,"h":53,"s":54,"a":54,"sd":null},{"k":"54:55","t":"In a seat of honor near a Sovereign, Perfect in Ability.","j":27,"h":53,"s":54,"a":55,"sd":null},{"k":"55:1","t":"The Most Merciful","j":27,"h":54,"s":55,"a":1,"sd":null},{"k":"55:2","t":"Taught the Qur’ān,","j":27,"h":54,"s":55,"a":2,"sd":null},{"k":"55:3","t":"Created man,","j":27,"h":54,"s":55,"a":3,"sd":null},{"k":"55:4","t":"[And] taught him eloquence.","j":27,"h":54,"s":55,"a":4,"sd":null},{"k":"55:5","t":"The sun and the moon [move] by precise calculation,","j":27,"h":54,"s":55,"a":5,"sd":null},{"k":"55:6","t":"And the stars and trees prostrate.","j":27,"h":54,"s":55,"a":6,"sd":null},{"k":"55:7","t":"And the heaven He raised and imposed the balance","j":27,"h":54,"s":55,"a":7,"sd":null},{"k":"55:8","t":"That you not transgress within the balance.","j":27,"h":54,"s":55,"a":8,"sd":null},{"k":"55:9","t":"And establish weight in justice and do not make deficient the balance.","j":27,"h":54,"s":55,"a":9,"sd":null},{"k":"55:10","t":"And the earth He laid [out] for the creatures.","j":27,"h":54,"s":55,"a":10,"sd":null},{"k":"55:11","t":"Therein is fruit and palm trees having sheaths [of dates]","j":27,"h":54,"s":55,"a":11,"sd":null},{"k":"55:12","t":"And grain having husks and scented plants.","j":27,"h":54,"s":55,"a":12,"sd":null},{"k":"55:13","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":13,"sd":null},{"k":"55:14","t":"He created man from clay like [that of] pottery.","j":27,"h":54,"s":55,"a":14,"sd":null},{"k":"55:15","t":"And He created the jinn from a smokeless flame of fire.","j":27,"h":54,"s":55,"a":15,"sd":null},{"k":"55:16","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":16,"sd":null},{"k":"55:17","t":"[He is] Lord of the two sunrises and Lord of the two sunsets.","j":27,"h":54,"s":55,"a":17,"sd":null},{"k":"55:18","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":18,"sd":null}],"juz":27,"hizb":53,"surahs":[54,55],"sajdah":false}