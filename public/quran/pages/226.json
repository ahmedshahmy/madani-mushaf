":12,"h":23,"s":11,"a":44,"sd":null},{"k":"11:45","t":"And Noah called to his Lord and said, \"My Lord, indeed my son is of my family; and indeed, Your promise is true; and You are the most just of judges!\"","j":12,"h":23,"s":11,"a":45,"sd":null}],"juz":12,"hizb":23,"surahs":[11],"sajdah":false}