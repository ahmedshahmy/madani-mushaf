:"V","tr":"hadā","f":["PERF","3MS"],"r":23,"l":79},{"i":"6:90:4","a":"ٱللَّهُ ۖ","t":"(by) Allah","p":"PN","tr":"l-lahu","f":["NOM"],"r":0,"l":1},{"i":"6:90:5","a":"فَبِهُدَىٰهُمُ","t":"so of their guidance","p":"N","tr":"fabihudāhumu","f":["M","GEN"],"r":23,"l":129,"g":[["فَ","REM","prefix","f:REM"],["َ","P","prefix","bi"],["بِهُ","N","stem","M|GEN"],["دَ","PRON","suffix","PRON:3MP"]]},{"i":"6:90:6","a":"ٱقْتَدِهْ ۗ","t":"you follow","p":"V","tr":"iq'tadih","f":["IMPV","(VIII)","2MS"],"r":1190,"l":4825}]},{"l":15,"t":"a","c":0,"w":[{"i":"6:90:7","a":"قُل","t":"Say","p":"V","tr":"qul","f":["IMPV","2MS"],"r":1,"l":6},{"i":"6:90:8","a":"لَّآ","t":"Not","p":"NEG","tr":"lā","l":4},{"i":"6:90:9","a":"أَسْـَٔلُكُمْ","t":"I ask you","p":"V","tr":"asalukum","f":["IMPF","1S"],"r":86,"l":105,"g":[["أَسْـَٔلُ","V","stem","IMPF|1S"],["كُمْ","PRON","suffix","PRON:2MP"]]},{"i":"6:90:10","a":"عَلَيْهِ","t":"for it","p":"P","tr":"ʿalayhi","l":8,"g":[["عَلَيْ","P","stem",""],["هِ","PRON","suffix","PRON:3MS"]]},{"i":"6:90:11","a":"أَجْرًا ۖ","t":"any reward","p":"N","tr":"ajran","f":["M","INDEF","ACC"],"r":103,"l":107},{"i":"6:90:12","a":"إِنْ","t":"Not","p":"NEG","tr":"in","l":14},{"i":"6:90:13","a":"هُوَ","t":"(is) it","p":"PRON","tr":"huwa","f":["3MS"],"l":20},{"i":"6:90:14","a":"إِلَّا","t":"but","p":"RES","tr":"illā","l":15},{"i":"6:90:15","a":"ذِكْرَىٰ","t":"a reminder","p":"N","tr":"dhik'rā","f":["F","NOM"],"r":28,"l":448},{"i":"6:90:16","a":"لِلْعَـٰلَمِينَ","t":"for the worlds","p":"N","tr":"lil'ʿālamīna","f":["MP","GEN"],"r":5,"l":160,"g":[["لِ","P","prefix","l:P"],["ِ","DET","prefix","Al"],["لْعَـٰ","N","stem","MP|GEN"]]},{"e":"٩٠","v":"6:90"}]}],"verses":[{"k":"6:82","t":"They who believe and do not mix their belief with injustice - those will have security, and they are [rightly] guided.","j":7,"h":14,"s":6,"a":82,"sd":null},{"k":"6:83","t":"And that was Our [conclusive] argument which We gave Abraham against his people. We raise by degrees whom We will. Indeed, your Lord is Wise and Knowing.","j":7,"h":14,"s":6,"a":83,"sd":null},{"k":"6:84","t":"And We gave to him [i.e., Abraham] Isaac and Jacob - all [of them] We guided. And Noah, We guided before; and among his descendants, David and Solomon and Job and Joseph and Moses and Aaron. Thus do We reward the doers of good.","j":7,"h":14,"s":6,"a":84,"sd":null},{"k":"6:85","t":"And Zechariah and John and Jesus and Elias - and all were of the righteous.","j":7,"h":14,"s":6,"a":85,"sd":null},{"k":"6:86","t":"And Ishmael and Elisha and Jonah and Lot - and all [of them] We preferred over the worlds.","j":7,"h":14,"s":6,"a":86,"sd":null},{"k":"6:87","t":"And [some] among their fathers and their descendants and their brothers - and We chose them and We guided them to a straight path.","j":7,"h":14,"s":6,"a":87,"sd":null},{"k":"6:88","t":"That is the guidance of Allāh by which He guides whomever He wills of His servants. But if they had associated others with Allāh, then worthless for them would be whatever they were doing.","j":7,"h":14,"s":6,"a":88,"sd":null},{"k":"6:89","t":"Those are the ones to whom We gave the Scripture and authority and prophethood. But if they [i.e., the disbelievers] deny it, then We have entrusted it to a people who are not therein disbelievers.","j":7,"h":14,"s":6,"a":89,"sd":null},{"k":"6:90","t":"Those are the ones whom Allāh has guided, so from their guidance take an example. Say, \"I ask of you for it [i.e., this message] no payment. It is not but a reminder for the worlds.\"","j":7,"h":14,"s":6,"a":90,"sd":null}],"juz":7,"hizb":14,"surahs":[6],"sajdah":false}