ِ","P","prefix","bi"],["ٱلَّ","DET","prefix","Al"],["يْلِ","N","stem","M|GEN"]]},{"i":"2:274:5","a":"وَٱلنَّهَارِ","t":"and day","p":"N","tr":"wal-nahāri","f":["M","GEN"],"r":99,"l":210,"g":[["وَ","CONJ","prefix","w:CONJ"],["ٱل","DET","prefix","Al"],["نَّهَارِ","N","stem","M|GEN"]]},{"i":"2:274:6","a":"سِرًّۭا","t":"secretly","p":"N","tr":"sirran","f":["M","INDEF","ACC"],"r":221,"l":801},{"i":"2:274:7","a":"وَعَلَانِيَةًۭ","t":"and openly","p":"N","tr":"waʿalāniyatan","f":["F","INDEF","ACC"],"r":445,"l":1497,"g":[["وَ","CONJ","prefix","w:CONJ"],["عَلَانِيَةًۭ","N","stem","F|INDEF|ACC"]]},{"i":"2:274:8","a":"فَلَهُمْ","t":"then for them","p":"PRON","tr":"falahum","f":["3MP"],"l":11,"g":[["فَ","SUP","prefix","f:SUP"],["لَ","P","prefix","l:P"],["هُمْ","PRON","stem","3MP"]]},{"i":"2:274:9","a":"أَجْرُهُمْ","t":"(is) their reward","p":"N","tr":"ajruhum","f":["M","NOM"],"r":103,"l":107,"g":[["أَجْرُ","N","stem","M|NOM"],["هُمْ","PRON","suffix","PRON:3MP"]]},{"i":"2:274:10","a":"عِندَ","t":"with","p":"LOC","tr":"ʿinda","f":["ACC"],"r":45,"l":59}]},{"l":15,"t":"a","c":0,"w":[{"i":"2:274:11","a":"رَبِّهِمْ","t":"their Lord","p":"N","tr":"rabbihim","f":["M","GEN"],"r":3,"l":10,"g":[["رَبِّ","N","stem","M|GEN"],["هِمْ","PRON","suffix","PRON:3MP"]]},{"i":"2:274:12","a":"وَلَا","t":"and no","p":"NEG","tr":"walā","l":4,"g":[["وَ","CONJ","prefix","w:CONJ"],["لَا","NEG","stem",""]]},{"i":"2:274:13","a":"خَوْفٌ","t":"fear","p":"N","tr":"khawfun","f":["M","INDEF","NOM"],"r":91,"l":418},{"i":"2:274:14","a":"عَلَيْهِمْ","t":"on them","p":"P","tr":"ʿalayhim","l":8,"g":[["عَلَيْ","P","stem",""],["هِمْ","PRON","suffix","PRON:3MP"]]},{"i":"2:274:15","a":"وَلَا","t":"and not","p":"NEG","tr":"walā","l":4,"g":[["وَ","CONJ","prefix","w:CONJ"],["لَا","NEG","stem",""]]},{"i":"2:274:16","a":"هُمْ","t":"they","p":"PRON","tr":"hum","f":["3MP"],"l":11},{"i":"2:274:17","a":"يَحْزَنُونَ","t":"will grieve","p":"V","tr":"yaḥzanūna","f":["IMPF","3MP"],"r":229,"l":321,"g":[["يَحْزَنُ","V","stem","IMPF|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"e":"٢٧٤","v":"2:274"}]}],"verses":[{"k":"2:270","t":"And whatever you spend of expenditures or make of vows - indeed, Allāh knows of it. And for the wrongdoers there are no helpers.","j":3,"h":5,"s":2,"a":270,"sd":null},{"k":"2:271","t":"If you disclose your charitable expenditures, they are good; but if you conceal them and give them to the poor, it is better for you, and He will remove from you some of your misdeeds [thereby]. And Allāh, of what you do, is [fully] Aware.","j":3,"h":5,"s":2,"a":271,"sd":null},{"k":"2:272","t":"Not upon you, [O Muḥammad], is [responsibility for] their guidance, but Allāh guides whom He wills. And whatever good you [believers] spend is for yourselves, and you do not spend except seeking the face [i.e., approval] of Allāh. And whatever you spend of good - it will be fully repaid to you, and you will not be wronged.","j":3,"h":5,"s":2,"a":272,"sd":null},{"k":"2:273","t":"[Charity is] for the poor who have been restricted for the cause of Allāh, unable to move about in the land. An ignorant [person] would think them self-sufficient because of their restraint, but you will know them by their [characteristic] sign. They do not ask people persistently [or at all]. And whatever you spend of good - indeed, Allāh is Knowing of it.","j":3,"h":5,"s":2,"a":273,"sd":null},{"k":"2:274","t":"Those who spend their wealth [in Allāh's way] by night and by day, secretly and publicly - they will have their reward with their Lord. And no fear will there be concerning them, nor will they grieve.","j":3,"h":5,"s":2,"a":274,"sd":null}],"juz":3,"hizb":5,"surahs":[2],"sajdah":false}