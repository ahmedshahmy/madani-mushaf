e]","p":"PRON","tr":"huwa","f":["3MS"],"l":20},{"i":"51:30:7","a":"ٱلْحَكِيمُ","t":"(is) the All-Wise","p":"N","tr":"l-ḥakīmu","f":["MS","NOM"],"r":43,"l":112,"g":[["ٱلْ","DET","prefix","Al"],["حَكِيمُ","N","stem","MS|NOM"]]},{"i":"51:30:8","a":"ٱلْعَلِيمُ","t":"the All-Knower","p":"ADJ","tr":"l-ʿalīmu","f":["MS","NOM"],"r":5,"l":68,"g":[["ٱلْ","DET","prefix","Al"],["عَلِيمُ","ADJ","stem","MS|NOM"]]},{"e":"٣٠","v":"51:30"}]}],"verses":[{"k":"51:7","t":"By the heaven containing pathways,","j":26,"h":52,"s":51,"a":7,"sd":null},{"k":"51:8","t":"Indeed, you are in differing speech.","j":26,"h":52,"s":51,"a":8,"sd":null},{"k":"51:9","t":"Deluded away from it [i.e., the Qur’ān] is he who is deluded.","j":26,"h":52,"s":51,"a":9,"sd":null},{"k":"51:10","t":"Destroyed are the misinformers","j":26,"h":52,"s":51,"a":10,"sd":null},{"k":"51:11","t":"Who are within a flood [of confusion] and heedless.","j":26,"h":52,"s":51,"a":11,"sd":null},{"k":"51:12","t":"They ask, \"When is the Day of Recompense?\"","j":26,"h":52,"s":51,"a":12,"sd":null},{"k":"51:13","t":"[It is] the Day they will be tormented over the Fire.","j":26,"h":52,"s":51,"a":13,"sd":null},{"k":"51:14","t":"[And will be told], \"Taste your torment. This is that for which you were impatient.\"","j":26,"h":52,"s":51,"a":14,"sd":null},{"k":"51:15","t":"Indeed, the righteous will be among gardens and springs,","j":26,"h":52,"s":51,"a":15,"sd":null},{"k":"51:16","t":"Accepting what their Lord has given them. Indeed, they were before that doers of good.","j":26,"h":52,"s":51,"a":16,"sd":null},{"k":"51:17","t":"They used to sleep but little of the night,","j":26,"h":52,"s":51,"a":17,"sd":null},{"k":"51:18","t":"And in the hours before dawn they would ask forgiveness,","j":26,"h":52,"s":51,"a":18,"sd":null},{"k":"51:19","t":"And from their properties was [given] the right of the [needy] petitioner and the deprived.","j":26,"h":52,"s":51,"a":19,"sd":null},{"k":"51:20","t":"And on the earth are signs for the certain [in faith]","j":26,"h":52,"s":51,"a":20,"sd":null},{"k":"51:21","t":"And in yourselves. Then will you not see?","j":26,"h":52,"s":51,"a":21,"sd":null},{"k":"51:22","t":"And in the heaven is your provision and whatever you are promised.","j":26,"h":52,"s":51,"a":22,"sd":null},{"k":"51:23","t":"Then by the Lord of the heaven and earth, indeed, it is truth - just as [sure as] it is that you are speaking.","j":26,"h":52,"s":51,"a":23,"sd":null},{"k":"51:24","t":"Has there reached you the story of the honored guests of Abraham? -","j":26,"h":52,"s":51,"a":24,"sd":null},{"k":"51:25","t":"When they entered upon him and said, \"[We greet you with] peace.\" He answered, \"[And upon you] peace; [you are] a people unknown.\"","j":26,"h":52,"s":51,"a":25,"sd":null},{"k":"51:26","t":"Then he went to his family and came with a fat [roasted] calf.","j":26,"h":52,"s":51,"a":26,"sd":null},{"k":"51:27","t":"And placed it near them; he said, \"Will you not eat?\"","j":26,"h":52,"s":51,"a":27,"sd":null},{"k":"51:28","t":"And he felt from them apprehension. They said, \"Fear not,\" and gave him good tidings of a learned boy.","j":26,"h":52,"s":51,"a":28,"sd":null},{"k":"51:29","t":"And his wife approached with a cry [of alarm] and struck her face and said, \"[I am] a barren old woman!\"","j":26,"h":52,"s":51,"a":29,"sd":null},{"k":"51:30","t":"They said, \"Thus has said your Lord; indeed, He is the Wise, the Knowing.\"","j":26,"h":52,"s":51,"a":30,"sd":null}],"juz":26,"hizb":52,"surahs":[51],"sajdah":false}