:"فُتِنُوا۟","t":"they had been put to trials","p":"V","tr":"futinū","f":["PERF","PASS","3MP"],"r":180,"l":454,"g":[["فُتِنُ","V","stem","PERF|PASS|3MP"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"16:110:10","a":"ثُمَّ","t":"then","p":"CONJ","tr":"thumma","l":34},{"i":"16:110:11","a":"جَـٰهَدُوا۟","t":"strove hard","p":"V","tr":"jāhadū","f":["PERF","(III)","3MP"],"r":236,"l":400,"g":[["جَـٰ","V","stem","PERF|(III)|3MP"],["وا","PRON","suffix","PRON:3MP"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"16:110:12","a":"وَصَبَرُوٓا۟","t":"and were patient","p":"V","tr":"waṣabarū","f":["PERF","3MP"],"r":109,"l":205,"g":[["وَ","CONJ","prefix","w:CONJ"],["صَبَرُ","V","stem","PERF|3MP"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"16:110:13","a":"إِنَّ","t":"Indeed","p":"ACC","tr":"inna","l":5},{"i":"16:110:14","a":"رَبَّكَ","t":"your Lord","p":"N","tr":"rabbaka","f":["M","ACC"],"r":3,"l":10,"g":[["رَبَّ","N","stem","M|ACC"],["كَ","PRON","suffix","PRON:2MS"]]},{"i":"16:110:15","a":"مِنۢ","t":"after it","p":"P","tr":"min","l":0},{"i":"16:110:16","a":"بَعْدِهَا","t":"after it","p":"N","tr":"baʿdihā","f":["GEN"],"r":39,"l":58,"g":[["بَعْدِ","N","stem","GEN"],["هَا","PRON","suffix","PRON:3FS"]]},{"i":"16:110:17","a":"لَغَفُورٌۭ","t":"surely is Oft-Forgiving","p":"N","tr":"laghafūrun","f":["MS","INDEF","NOM"],"r":40,"l":118,"g":[["لَ","EMPH","prefix","l:EMPH"],["غَفُورٌۭ","N","stem","MS|INDEF|NOM"]]},{"i":"16:110:18","a":"رَّحِيمٌۭ","t":"Most Merciful","p":"ADJ","tr":"raḥīmun","f":["MS","INDEF","NOM"],"r":20,"l":101},{"e":"١١٠","v":"16:110"}]}],"verses":[{"k":"16:103","t":"And We certainly know that they say, \"It is only a human being who teaches him [i.e., the Prophet (ﷺ)].\" The tongue of the one they refer to is foreign, and this [recitation, i.e., Qur’ān] is [in] a clear Arabic language.","j":14,"h":28,"s":16,"a":103,"sd":null},{"k":"16:104","t":"Indeed, those who do not believe in the verses of Allāh - Allāh will not guide them, and for them is a painful punishment.","j":14,"h":28,"s":16,"a":104,"sd":null},{"k":"16:105","t":"They only invent falsehood who do not believe in the verses of Allāh, and it is those who are the liars.","j":14,"h":28,"s":16,"a":105,"sd":null},{"k":"16:106","t":"Whoever disbelieves in [i.e., denies] Allāh after his belief... except for one who is forced [to renounce his religion] while his heart is secure in faith. But those who [willingly] open their breasts to disbelief, upon them is wrath from Allāh, and for them is a great punishment;","j":14,"h":28,"s":16,"a":106,"sd":null},{"k":"16:107","t":"That is because they preferred the worldly life over the Hereafter and that Allāh does not guide the disbelieving people.","j":14,"h":28,"s":16,"a":107,"sd":null},{"k":"16:108","t":"Those are the ones over whose hearts and hearing and vision Allāh has sealed, and it is those who are the heedless.","j":14,"h":28,"s":16,"a":108,"sd":null},{"k":"16:109","t":"Assuredly, it is they, in the Hereafter, who will be the losers.","j":14,"h":28,"s":16,"a":109,"sd":null},{"k":"16:110","t":"Then, indeed your Lord, to those who emigrated after they had been compelled [to say words of disbelief] and thereafter fought [for the cause of Allāh] and were patient - indeed, your Lord, after that, is Forgiving and Merciful","j":14,"h":28,"s":16,"a":110,"sd":null}],"juz":14,"hizb":28,"surahs":[16],"sajdah":false}