ffix","PRON:3MP"]]},{"i":"4:65:13","a":"فِىٓ","t":"in","p":"P","tr":"fī","l":3}]},{"l":15,"t":"a","c":0,"w":[{"i":"4:65:14","a":"أَنفُسِهِمْ","t":"themselves","p":"N","tr":"anfusihim","f":["FP","GEN"],"r":25,"l":39,"g":[["أَنفُسِ","N","stem","FP|GEN"],["هِمْ","PRON","suffix","PRON:3MP"]]},{"i":"4:65:15","a":"حَرَجًۭا","t":"any discomfort","p":"N","tr":"ḥarajan","f":["M","INDEF","ACC"],"r":460,"l":621},{"i":"4:65:16","a":"مِّمَّا","t":"about what","p":"P","tr":"mimmā","l":0,"g":[["مِّ","P","stem",""],["مَّا","REL","stem",""]]},{"i":"4:65:17","a":"قَضَيْتَ","t":"you (have) decided","p":"V","tr":"qaḍayta","f":["PERF","2MS"],"r":174,"l":204,"g":[["قَضَيْ","V","stem","PERF|2MS"],["تَ","PRON","suffix","PRON:2MS"]]},{"i":"4:65:18","a":"وَيُسَلِّمُوا۟","t":"and submit","p":"V","tr":"wayusallimū","f":["IMPF","(II)","3MP","MOOD:SUBJ"],"r":79,"l":1229,"g":[["وَ","CONJ","prefix","w:CONJ"],["يُسَلِّمُ","V","stem","IMPF|(II)|3MP|MOOD:SUBJ"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"4:65:19","a":"تَسْلِيمًۭا","t":"(in full) submission","p":"N","tr":"taslīman","f":["VN","(II)","M","INDEF","ACC"],"r":79,"l":2013},{"e":"٦٥","v":"4:65"}]}],"verses":[{"k":"4:60","t":"Have you not seen those who claim to have believed in what was revealed to you, [O Muḥammad], and what was revealed before you? They wish to refer legislation to ṭāghūt, while they were commanded to reject it; and Satan wishes to lead them far astray.","j":5,"h":9,"s":4,"a":60,"sd":null},{"k":"4:61","t":"And when it is said to them, \"Come to what Allāh has revealed and to the Messenger,\" you see the hypocrites turning away from you in aversion.","j":5,"h":9,"s":4,"a":61,"sd":null},{"k":"4:62","t":"So how [will it be] when disaster strikes them because of what their hands have put forth and then they come to you swearing by Allāh, \"We intended nothing but good conduct and accommodation.\"","j":5,"h":9,"s":4,"a":62,"sd":null},{"k":"4:63","t":"Those are the ones of whom Allāh knows what is in their hearts, so turn away from them but admonish them and speak to them a far-reaching [i.e., effective] word.","j":5,"h":9,"s":4,"a":63,"sd":null},{"k":"4:64","t":"And We did not send any messenger except to be obeyed by permission of Allāh. And if, when they wronged themselves, they had come to you, [O Muḥammad], and asked forgiveness of Allāh and the Messenger had asked forgiveness for them, they would have found Allāh Accepting of Repentance and Merciful.","j":5,"h":9,"s":4,"a":64,"sd":null},{"k":"4:65","t":"But no, by your Lord, they will not [truly] believe until they make you, [O Muḥammad], judge concerning that over which they dispute among themselves and then find within themselves no discomfort from what you have judged and submit in [full, willing] submission.","j":5,"h":9,"s":4,"a":65,"sd":null}],"juz":5,"hizb":9,"surahs":[4],"sajdah":false}