:41,"a":17,"sd":null},{"k":"41:18","t":"And We saved those who believed and used to fear Allāh.","j":24,"h":48,"s":41,"a":18,"sd":null},{"k":"41:19","t":"And [mention, O Muḥammad], the Day when the enemies of Allāh will be gathered to the Fire while they are [driven], assembled in rows,","j":24,"h":48,"s":41,"a":19,"sd":null},{"k":"41:20","t":"Until, when they reach it, their hearing and their eyes and their skins will testify against them of what they used to do.","j":24,"h":48,"s":41,"a":20,"sd":null}],"juz":24,"hizb":48,"surahs":[41],"sajdah":false}