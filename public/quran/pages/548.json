ally Merciful.","j":28,"h":55,"s":59,"a":22,"sd":null},{"k":"59:23","t":"He is Allāh, other than whom there is no deity, the Sovereign, the Pure, the Perfection, the Grantor of Security, the Overseer, the Exalted in Might, the Compeller, the Superior. Exalted is Allāh above whatever they associate with Him.","j":28,"h":55,"s":59,"a":23,"sd":null},{"k":"59:24","t":"He is Allāh, the Creator, the Producer, the Fashioner; to Him belong the best names. Whatever is in the heavens and earth is exalting Him. And He is the Exalted in Might, the Wise.","j":28,"h":55,"s":59,"a":24,"sd":null}],"juz":28,"hizb":55,"surahs":[59],"sajdah":false}