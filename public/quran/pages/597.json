righteousness","p":"N","tr":"bil-taqwā","f":["M","GEN"],"r":35,"l":580,"g":[["بِ","P","prefix","bi"],["ِٱ","DET","prefix","Al"],["لتَّقْ","N","stem","M|GEN"]]},{"e":"١٢","v":"96:12"}]}],"verses":[{"k":"94:3","t":"Which had weighed upon your back","j":30,"h":60,"s":94,"a":3,"sd":null},{"k":"94:4","t":"And raised high for you your repute.","j":30,"h":60,"s":94,"a":4,"sd":null},{"k":"94:5","t":"For indeed, with hardship [will be] ease [i.e., relief].","j":30,"h":60,"s":94,"a":5,"sd":null},{"k":"94:6","t":"Indeed, with hardship [will be] ease.","j":30,"h":60,"s":94,"a":6,"sd":null},{"k":"94:7","t":"So when you have finished [your duties], then stand up [for worship].","j":30,"h":60,"s":94,"a":7,"sd":null},{"k":"94:8","t":"And to your Lord direct [your] longing.","j":30,"h":60,"s":94,"a":8,"sd":null},{"k":"95:1","t":"By the fig and the olive","j":30,"h":60,"s":95,"a":1,"sd":null},{"k":"95:2","t":"And [by] Mount Sinai","j":30,"h":60,"s":95,"a":2,"sd":null},{"k":"95:3","t":"And [by] this secure city [i.e., Makkah],","j":30,"h":60,"s":95,"a":3,"sd":null},{"k":"95:4","t":"We have certainly created man in the best of stature;","j":30,"h":60,"s":95,"a":4,"sd":null},{"k":"95:5","t":"Then We return him to the lowest of the low,","j":30,"h":60,"s":95,"a":5,"sd":null},{"k":"95:6","t":"Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.","j":30,"h":60,"s":95,"a":6,"sd":null},{"k":"95:7","t":"So what yet causes you to deny the Recompense?","j":30,"h":60,"s":95,"a":7,"sd":null},{"k":"95:8","t":"Is not Allāh the most just of judges?","j":30,"h":60,"s":95,"a":8,"sd":null},{"k":"96:1","t":"Recite in the name of your Lord who created","j":30,"h":60,"s":96,"a":1,"sd":null},{"k":"96:2","t":"Created man from a clinging substance.","j":30,"h":60,"s":96,"a":2,"sd":null},{"k":"96:3","t":"Recite, and your Lord is the most Generous -","j":30,"h":60,"s":96,"a":3,"sd":null},{"k":"96:4","t":"Who taught by the pen","j":30,"h":60,"s":96,"a":4,"sd":null},{"k":"96:5","t":"Taught man that which he knew not.","j":30,"h":60,"s":96,"a":5,"sd":null},{"k":"96:6","t":"No! [But] indeed, man transgresses","j":30,"h":60,"s":96,"a":6,"sd":null},{"k":"96:7","t":"Because he sees himself self-sufficient.","j":30,"h":60,"s":96,"a":7,"sd":null},{"k":"96:8","t":"Indeed, to your Lord is the return.","j":30,"h":60,"s":96,"a":8,"sd":null},{"k":"96:9","t":"Have you seen the one who forbids","j":30,"h":60,"s":96,"a":9,"sd":null},{"k":"96:10","t":"A servant when he prays?","j":30,"h":60,"s":96,"a":10,"sd":null},{"k":"96:11","t":"Have you seen if he is upon guidance","j":30,"h":60,"s":96,"a":11,"sd":null},{"k":"96:12","t":"Or enjoins righteousness?","j":30,"h":60,"s":96,"a":12,"sd":null}],"juz":30,"hizb":60,"surahs":[94,95,96],"sajdah":false}