F|(IV)|1S"],["نَّ","EMPH","suffix","+n:EMPH"],["هُمْ","PRON","suffix","PRON:3MP"]]},{"i":"38:82:4","a":"أَجْمَعِينَ","t":"all","p":"N","tr":"ajmaʿīna","f":["MP","ACC"],"r":84,"l":411},{"e":"٨٢","v":"38:82"},{"i":"38:83:1","a":"إِلَّا","t":"Except","p":"RES","tr":"illā","l":15},{"i":"38:83:2","a":"عِبَادَكَ","t":"Your slaves","p":"N","tr":"ʿibādaka","f":["MP","ACC"],"r":32,"l":87,"g":[["عِبَادَ","N","stem","MP|ACC"],["كَ","PRON","suffix","PRON:2MS"]]},{"i":"38:83:3","a":"مِنْهُمُ","t":"among them","p":"P","tr":"min'humu","l":0,"g":[["مِنْ","P","stem",""],["هُمُ","PRON","suffix","PRON:3MP"]]},{"i":"38:83:4","a":"ٱلْمُخْلَصِينَ","t":"the chosen ones","p":"ADJ","tr":"l-mukh'laṣīna","f":["PASS","PCPL","(IV)","MP","ACC"],"r":299,"l":912,"g":[["ٱلْ","DET","prefix","Al"],["مُخْلَصِينَ","ADJ","stem","PASS|PCPL|(IV)|MP|ACC"]]},{"e":"٨٣","v":"38:83"}]}],"verses":[{"k":"38:62","t":"And they will say, \"Why do we not see men whom we used to count among the worst?","j":23,"h":46,"s":38,"a":62,"sd":null},{"k":"38:63","t":"Is it [because] we took them in ridicule, or has [our] vision turned away from them?\"","j":23,"h":46,"s":38,"a":63,"sd":null},{"k":"38:64","t":"Indeed, that is truth [i.e., reality] - the quarreling of the people of the Fire.","j":23,"h":46,"s":38,"a":64,"sd":null},{"k":"38:65","t":"Say, [O Muḥammad], \"I am only a warner, and there is not any deity except Allāh, the One, the Prevailing,","j":23,"h":46,"s":38,"a":65,"sd":null},{"k":"38:66","t":"Lord of the heavens and the earth and whatever is between them, the Exalted in Might, the Perpetual Forgiver.\"","j":23,"h":46,"s":38,"a":66,"sd":null},{"k":"38:67","t":"Say, \"It is great news","j":23,"h":46,"s":38,"a":67,"sd":null},{"k":"38:68","t":"From which you turn away.","j":23,"h":46,"s":38,"a":68,"sd":null},{"k":"38:69","t":"I had no knowledge of the exalted assembly [of angels] when they were disputing [the creation of Adam].","j":23,"h":46,"s":38,"a":69,"sd":null},{"k":"38:70","t":"It has not been revealed to me except that I am a clear warner.\"","j":23,"h":46,"s":38,"a":70,"sd":null},{"k":"38:71","t":"[So mention] when your Lord said to the angels, \"Indeed, I am going to create a human being from clay.","j":23,"h":46,"s":38,"a":71,"sd":null},{"k":"38:72","t":"So when I have proportioned him and breathed into him of My [created] soul, then fall down to him in prostration.\"","j":23,"h":46,"s":38,"a":72,"sd":null},{"k":"38:73","t":"So the angels prostrated - all of them entirely,","j":23,"h":46,"s":38,"a":73,"sd":null},{"k":"38:74","t":"Except Iblees; he was arrogant and became among the disbelievers.","j":23,"h":46,"s":38,"a":74,"sd":null},{"k":"38:75","t":"[Allāh] said, \"O Iblees, what prevented you from prostrating to that which I created with My hands? Were you arrogant [then], or were you [already] among the haughty?\"","j":23,"h":46,"s":38,"a":75,"sd":null},{"k":"38:76","t":"He said, \"I am better than him. You created me from fire and created him from clay.\"","j":23,"h":46,"s":38,"a":76,"sd":null},{"k":"38:77","t":"[Allāh] said, \"Then get out of it [i.e., Paradise], for indeed, you are expelled.","j":23,"h":46,"s":38,"a":77,"sd":null},{"k":"38:78","t":"And indeed, upon you is My curse until the Day of Recompense.\"","j":23,"h":46,"s":38,"a":78,"sd":null},{"k":"38:79","t":"He said, \"My Lord, then reprieve me until the Day they are resurrected.\"","j":23,"h":46,"s":38,"a":79,"sd":null},{"k":"38:80","t":"[Allāh] said, \"So indeed, you are of those reprieved","j":23,"h":46,"s":38,"a":80,"sd":null},{"k":"38:81","t":"Until the Day of the time well-known.\"","j":23,"h":46,"s":38,"a":81,"sd":null},{"k":"38:82","t":"[Iblees] said, \"By Your might, I will surely mislead them all.","j":23,"h":46,"s":38,"a":82,"sd":null},{"k":"38:83","t":"Except, among them, Your chosen servants.\"","j":23,"h":46,"s":38,"a":83,"sd":null}],"juz":23,"hizb":46,"surahs":[38],"sajdah":false}