BJ"]]},{"i":"36:70:6","a":"ٱلْقَوْلُ","t":"the Word","p":"N","tr":"l-qawlu","f":["VN","M","NOM"],"r":1,"l":117,"g":[["ٱلْ","DET","prefix","Al"],["قَوْلُ","N","stem","VN|M|NOM"]]},{"i":"36:70:7","a":"عَلَى","t":"against","p":"P","tr":"ʿalā","l":8},{"i":"36:70:8","a":"ٱلْكَـٰفِرِينَ","t":"the disbelievers","p":"N","tr":"l-kāfirīna","f":["ACT","PCPL","MP","GEN"],"r":8,"l":90,"g":[["ٱلْ","DET","prefix","Al"],["ْكَـٰفِ","N","stem","ACT|PCPL|MP|GEN"]]},{"e":"٧٠","v":"36:70"}]}],"verses":[{"k":"36:55","t":"Indeed the companions of Paradise, that Day, will be amused in [joyful] occupation -","j":23,"h":45,"s":36,"a":55,"sd":null},{"k":"36:56","t":"They and their spouses - in shade, reclining on adorned couches.","j":23,"h":45,"s":36,"a":56,"sd":null},{"k":"36:57","t":"For them therein is fruit, and for them is whatever they request [or wish]","j":23,"h":45,"s":36,"a":57,"sd":null},{"k":"36:58","t":"[And] \"Peace,\" a word from a Merciful Lord.","j":23,"h":45,"s":36,"a":58,"sd":null},{"k":"36:59","t":"[Then He will say], \"But stand apart today, you criminals.","j":23,"h":45,"s":36,"a":59,"sd":null},{"k":"36:60","t":"Did I not enjoin upon you, O children of Adam, that you not worship Satan - [for] indeed, he is to you a clear enemy -","j":23,"h":45,"s":36,"a":60,"sd":null},{"k":"36:61","t":"And that you worship [only] Me? This is a straight path.","j":23,"h":45,"s":36,"a":61,"sd":null},{"k":"36:62","t":"And he had already led astray from among you much of creation, so did you not use reason?","j":23,"h":45,"s":36,"a":62,"sd":null},{"k":"36:63","t":"This is the Hellfire which you were promised.","j":23,"h":45,"s":36,"a":63,"sd":null},{"k":"36:64","t":"[Enter to] burn therein today for what you used to deny.\"","j":23,"h":45,"s":36,"a":64,"sd":null},{"k":"36:65","t":"That Day, We will seal over their mouths, and their hands will speak to Us, and their feet will testify about what they used to earn.","j":23,"h":45,"s":36,"a":65,"sd":null},{"k":"36:66","t":"And if We willed, We could have obliterated their eyes, and they would race to [find] the path, and how could they see?","j":23,"h":45,"s":36,"a":66,"sd":null},{"k":"36:67","t":"And if We willed, We could have deformed them, [paralyzing them] in their places so they would not be able to proceed, nor could they return.","j":23,"h":45,"s":36,"a":67,"sd":null},{"k":"36:68","t":"And he to whom We grant long life We reverse in creation; so will they not understand?","j":23,"h":45,"s":36,"a":68,"sd":null},{"k":"36:69","t":"And We did not give him [i.e., Prophet Muḥammad (ﷺ)] knowledge of poetry, nor is it befitting for him. It is not but a message and a clear Qur’ān","j":23,"h":45,"s":36,"a":69,"sd":null},{"k":"36:70","t":"To warn whoever is alive and justify the word [i.e., decree] against the disbelievers.","j":23,"h":45,"s":36,"a":70,"sd":null}],"juz":23,"hizb":45,"surahs":[36],"sajdah":false}