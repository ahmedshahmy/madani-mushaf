 Unapparent","p":"N","tr":"wal-bāṭinu","f":["ACT","PCPL","M","NOM"],"r":348,"l":1803,"g":[["وَ","CONJ","prefix","w:CONJ"],["ٱلْ","DET","prefix","Al"],["بَاطِنُ","N","stem","ACT|PCPL|M|NOM"]]},{"i":"57:3:6","a":"وَهُوَ","t":"and He","p":"PRON","tr":"wahuwa","f":["3MS"],"l":20,"g":[["وَ","CONJ","prefix","w:CONJ"],["هُوَ","PRON","stem","3MS"]]},{"i":"57:3:7","a":"بِكُلِّ","t":"(is) of every","p":"N","tr":"bikulli","f":["M","GEN"],"r":16,"l":31,"g":[["بِ","P","prefix","bi"],["كُلِّ","N","stem","M|GEN"]]},{"i":"57:3:8","a":"شَىْءٍ","t":"thing","p":"N","tr":"shayin","f":["M","INDEF","GEN"],"r":10,"l":41},{"i":"57:3:9","a":"عَلِيمٌ","t":"All-Knower","p":"ADJ","tr":"ʿalīmun","f":["MS","INDEF","NOM"],"r":5,"l":68},{"e":"٣","v":"57:3"}]}],"verses":[{"k":"56:77","t":"Indeed, it is a noble Qur’ān.","j":27,"h":54,"s":56,"a":77,"sd":null},{"k":"56:78","t":"In a Register well-protected;.","j":27,"h":54,"s":56,"a":78,"sd":null},{"k":"56:79","t":"None touch it except the purified [i.e., the angels].","j":27,"h":54,"s":56,"a":79,"sd":null},{"k":"56:80","t":"[It is] a revelation from the Lord of the worlds.","j":27,"h":54,"s":56,"a":80,"sd":null},{"k":"56:81","t":"Then is it to this statement that you are indifferent","j":27,"h":54,"s":56,"a":81,"sd":null},{"k":"56:82","t":"And make [the thanks for] your provision that you deny [the Provider]?","j":27,"h":54,"s":56,"a":82,"sd":null},{"k":"56:83","t":"Then why, when it [i.e., the soul at death] reaches the throat","j":27,"h":54,"s":56,"a":83,"sd":null},{"k":"56:84","t":"And you are at that time looking on -","j":27,"h":54,"s":56,"a":84,"sd":null},{"k":"56:85","t":"And We [i.e., Our angels] are nearer to him than you, but you do not see -","j":27,"h":54,"s":56,"a":85,"sd":null},{"k":"56:86","t":"Then why do you not, if you are not to be recompensed,","j":27,"h":54,"s":56,"a":86,"sd":null},{"k":"56:87","t":"Bring it back, if you should be truthful?","j":27,"h":54,"s":56,"a":87,"sd":null},{"k":"56:88","t":"And if he [i.e., the deceased] was of those brought near [to Allāh],","j":27,"h":54,"s":56,"a":88,"sd":null},{"k":"56:89","t":"Then [for him is] rest and bounty and a garden of pleasure.","j":27,"h":54,"s":56,"a":89,"sd":null},{"k":"56:90","t":"And if he was of the companions of the right,","j":27,"h":54,"s":56,"a":90,"sd":null},{"k":"56:91","t":"Then [the angels will say], \"Peace for you; [you are] from the companions of the right.\"","j":27,"h":54,"s":56,"a":91,"sd":null},{"k":"56:92","t":"But if he was of the deniers [who were] astray,","j":27,"h":54,"s":56,"a":92,"sd":null},{"k":"56:93","t":"Then [for him is] accommodation of scalding water","j":27,"h":54,"s":56,"a":93,"sd":null},{"k":"56:94","t":"And burning in Hellfire.","j":27,"h":54,"s":56,"a":94,"sd":null},{"k":"56:95","t":"Indeed, this is the true certainty,","j":27,"h":54,"s":56,"a":95,"sd":null},{"k":"56:96","t":"So exalt the name of your Lord, the Most Great.","j":27,"h":54,"s":56,"a":96,"sd":null},{"k":"57:1","t":"Whatever is in the heavens and earth exalts Allāh, and He is the Exalted in Might, the Wise.","j":27,"h":54,"s":57,"a":1,"sd":null},{"k":"57:2","t":"His is the dominion of the heavens and earth. He gives life and causes death, and He is over all things competent.","j":27,"h":54,"s":57,"a":2,"sd":null},{"k":"57:3","t":"He is the First and the Last, the Ascendant and the Intimate, and He is, of all things, Knowing.","j":27,"h":54,"s":57,"a":3,"sd":null}],"juz":27,"hizb":54,"surahs":[56,57],"sajdah":false}