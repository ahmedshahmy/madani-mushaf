for a people who give thought.","j":11,"h":21,"s":10,"a":24,"sd":null},{"k":"10:25","t":"And Allāh invites to the Home of Peace [i.e., Paradise] and guides whom He wills to a straight path.","j":11,"h":21,"s":10,"a":25,"sd":null}],"juz":11,"hizb":21,"surahs":[10],"sajdah":false}