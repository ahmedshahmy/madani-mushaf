|1P|MOOD:SUBJ"],["كُمْ","PRON","suffix","PRON:2MP"]]},{"i":"78:30:4","a":"إِلَّا","t":"except","p":"RES","tr":"illā","l":15},{"i":"78:30:5","a":"عَذَابًا","t":"(in) punishment","p":"N","tr":"ʿadhāban","f":["M","INDEF","ACC"],"r":17,"l":36},{"e":"٣٠","v":"78:30"}]}],"verses":[{"k":"78:1","t":"About what are they asking one another?","j":30,"h":59,"s":78,"a":1,"sd":null},{"k":"78:2","t":"About the great news -","j":30,"h":59,"s":78,"a":2,"sd":null},{"k":"78:3","t":"That over which they are in disagreement.","j":30,"h":59,"s":78,"a":3,"sd":null},{"k":"78:4","t":"No! They are going to know.","j":30,"h":59,"s":78,"a":4,"sd":null},{"k":"78:5","t":"Then, no! They are going to know.","j":30,"h":59,"s":78,"a":5,"sd":null},{"k":"78:6","t":"Have We not made the earth a resting place?","j":30,"h":59,"s":78,"a":6,"sd":null},{"k":"78:7","t":"And the mountains as stakes?","j":30,"h":59,"s":78,"a":7,"sd":null},{"k":"78:8","t":"And We created you in pairs.","j":30,"h":59,"s":78,"a":8,"sd":null},{"k":"78:9","t":"And made your sleep [a means for] rest","j":30,"h":59,"s":78,"a":9,"sd":null},{"k":"78:10","t":"And made the night as clothing.","j":30,"h":59,"s":78,"a":10,"sd":null},{"k":"78:11","t":"And made the day for livelihood.","j":30,"h":59,"s":78,"a":11,"sd":null},{"k":"78:12","t":"And constructed above you seven strong [heavens].","j":30,"h":59,"s":78,"a":12,"sd":null},{"k":"78:13","t":"And made [therein] a burning lamp","j":30,"h":59,"s":78,"a":13,"sd":null},{"k":"78:14","t":"And sent down, from the rain clouds, pouring water.","j":30,"h":59,"s":78,"a":14,"sd":null},{"k":"78:15","t":"That We may bring forth thereby grain and vegetation.","j":30,"h":59,"s":78,"a":15,"sd":null},{"k":"78:16","t":"And gardens of entwined growth.","j":30,"h":59,"s":78,"a":16,"sd":null},{"k":"78:17","t":"Indeed, the Day of Judgement is an appointed time -","j":30,"h":59,"s":78,"a":17,"sd":null},{"k":"78:18","t":"The Day the Horn is blown and you will come forth in multitudes","j":30,"h":59,"s":78,"a":18,"sd":null},{"k":"78:19","t":"And the heaven is opened and will become gateways.","j":30,"h":59,"s":78,"a":19,"sd":null},{"k":"78:20","t":"And the mountains are removed and will be [but] a mirage.","j":30,"h":59,"s":78,"a":20,"sd":null},{"k":"78:21","t":"Indeed, Hell has been lying in wait","j":30,"h":59,"s":78,"a":21,"sd":null},{"k":"78:22","t":"For the transgressors, a place of return,","j":30,"h":59,"s":78,"a":22,"sd":null},{"k":"78:23","t":"In which they will remain for ages [unending].","j":30,"h":59,"s":78,"a":23,"sd":null},{"k":"78:24","t":"They will not taste therein [any] coolness or drink.","j":30,"h":59,"s":78,"a":24,"sd":null},{"k":"78:25","t":"Except scalding water and [foul] purulence -","j":30,"h":59,"s":78,"a":25,"sd":null},{"k":"78:26","t":"An appropriate recompense.","j":30,"h":59,"s":78,"a":26,"sd":null},{"k":"78:27","t":"Indeed, they were not expecting an account","j":30,"h":59,"s":78,"a":27,"sd":null},{"k":"78:28","t":"And denied Our verses with [emphatic] denial.","j":30,"h":59,"s":78,"a":28,"sd":null},{"k":"78:29","t":"But all things We have enumerated in writing.","j":30,"h":59,"s":78,"a":29,"sd":null},{"k":"78:30","t":"\"So taste [the penalty], and never will We increase you except in torment.\"","j":30,"h":59,"s":78,"a":30,"sd":null}],"juz":30,"hizb":59,"surahs":[78],"sajdah":false}