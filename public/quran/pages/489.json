7},{"i":"43:10:2","a":"جَعَلَ","t":"made","p":"V","tr":"jaʿala","f":["PERF","3MS"],"r":19,"l":33},{"i":"43:10:3","a":"لَكُمُ","t":"for you","p":"PRON","tr":"lakumu","f":["2MP"],"l":26,"g":[["لَ","P","prefix","l:P"],["كُمُ","PRON","stem","2MP"]]},{"i":"43:10:4","a":"ٱلْأَرْضَ","t":"the earth","p":"N","tr":"l-arḍa","f":["F","ACC"],"r":12,"l":22,"g":[["ٱلْ","DET","prefix","Al"],["أَرْضَ","N","stem","F|ACC"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"43:10:5","a":"مَهْدًۭا","t":"a bed","p":"N","tr":"mahdan","f":["M","INDEF","ACC"],"r":455,"l":1353},{"i":"43:10:6","a":"وَجَعَلَ","t":"and made","p":"V","tr":"wajaʿala","f":["PERF","3MS"],"r":19,"l":33,"g":[["وَ","CONJ","prefix","w:CONJ"],["جَعَلَ","V","stem","PERF|3MS"]]},{"i":"43:10:7","a":"لَكُمْ","t":"for you","p":"PRON","tr":"lakum","f":["2MP"],"l":26,"g":[["لَ","P","prefix","l:P"],["كُمْ","PRON","stem","2MP"]]},{"i":"43:10:8","a":"فِيهَا","t":"therein","p":"P","tr":"fīhā","l":3,"g":[["فِي","P","stem",""],["هَا","PRON","suffix","PRON:3FS"]]},{"i":"43:10:9","a":"سُبُلًۭا","t":"roads","p":"N","tr":"subulan","f":["MP","INDEF","ACC"],"r":56,"l":64},{"i":"43:10:10","a":"لَّعَلَّكُمْ","t":"so that you may","p":"ACC","tr":"laʿallakum","l":96,"g":[["لَّعَلَّ","ACC","stem",""],["كُمْ","PRON","suffix","PRON:2MP"]]},{"i":"43:10:11","a":"تَهْتَدُونَ","t":"(be) guided","p":"V","tr":"tahtadūna","f":["IMPF","(VIII)","2MP"],"r":23,"l":295,"g":[["تَهْتَدُ","V","stem","IMPF|(VIII)|2MP"],["ونَ","PRON","suffix","PRON:2MP"]]},{"e":"١٠","v":"43:10"}]}],"verses":[{"k":"42:52","t":"And thus We have revealed to you an inspiration of Our command [i.e., the Qur’ān]. You did not know what is the Book or [what is] faith, but We have made it a light by which We guide whom We will of Our servants. And indeed, [O Muḥammad], you guide to a straight path -","j":25,"h":49,"s":42,"a":52,"sd":null},{"k":"42:53","t":"The path of Allāh, to whom belongs whatever is in the heavens and whatever is on the earth. Unquestionably, to Allāh do [all] matters evolve [i.e., return].","j":25,"h":49,"s":42,"a":53,"sd":null},{"k":"43:1","t":"Ḥā, Meem.","j":25,"h":49,"s":43,"a":1,"sd":null},{"k":"43:2","t":"By the clear Book,","j":25,"h":49,"s":43,"a":2,"sd":null},{"k":"43:3","t":"Indeed, We have made it an Arabic Qur’ān that you might understand.","j":25,"h":49,"s":43,"a":3,"sd":null},{"k":"43:4","t":"And indeed it is, in the Mother of the Book with Us, exalted and full of wisdom.","j":25,"h":49,"s":43,"a":4,"sd":null},{"k":"43:5","t":"Then should We turn the message away, disregarding you, because you are a transgressing people?","j":25,"h":49,"s":43,"a":5,"sd":null},{"k":"43:6","t":"And how many a prophet We sent among the former peoples,","j":25,"h":49,"s":43,"a":6,"sd":null},{"k":"43:7","t":"But there would not come to them a prophet except that they used to ridicule him.","j":25,"h":49,"s":43,"a":7,"sd":null},{"k":"43:8","t":"And We destroyed greater than them in [striking] power, and the example of the former peoples has preceded.","j":25,"h":49,"s":43,"a":8,"sd":null},{"k":"43:9","t":"And if you should ask them, \"Who has created the heavens and the earth?\" they would surely say, \"They were created by the Exalted in Might, the Knowing,\"","j":25,"h":49,"s":43,"a":9,"sd":null},{"k":"43:10","t":"[The one] who has made for you the earth a bed and made for you upon it roads that you might be guided","j":25,"h":49,"s":43,"a":10,"sd":null}],"juz":25,"hizb":49,"surahs":[42,43],"sajdah":false}