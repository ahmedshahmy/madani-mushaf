,"c":0,"w":[{"i":"52:48:7","a":"بِحَمْدِ","t":"(the) praise","p":"N","tr":"biḥamdi","f":["M","GEN"],"r":172,"l":271,"g":[["بِ","P","prefix","bi"],["حَمْدِ","N","stem","M|GEN"]]},{"i":"52:48:8","a":"رَبِّكَ","t":"(of) your Lord","p":"N","tr":"rabbika","f":["M","GEN"],"r":3,"l":10,"g":[["رَبِّ","N","stem","M|GEN"],["كَ","PRON","suffix","PRON:2MS"]]},{"i":"52:48:9","a":"حِينَ","t":"when","p":"N","tr":"ḥīna","f":["M","ACC"],"r":263,"l":328},{"i":"52:48:10","a":"تَقُومُ","t":"you arise","p":"V","tr":"taqūmu","f":["IMPF","2MS"],"r":6,"l":348},{"e":"٤٨","v":"52:48"},{"i":"52:49:1","a":"وَمِنَ","t":"And of","p":"P","tr":"wamina","l":0,"g":[["وَ","CONJ","prefix","w:CONJ"],["مِنَ","P","stem",""]]},{"i":"52:49:2","a":"ٱلَّيْلِ","t":"the night","p":"N","tr":"al-layli","f":["M","GEN"],"r":121,"l":132,"g":[["ٱلَّ","DET","prefix","Al"],["يْلِ","N","stem","M|GEN"]]},{"i":"52:49:3","a":"فَسَبِّحْهُ","t":"glorify Him","p":"V","tr":"fasabbiḥ'hu","f":["IMPV","(II)","2MS"],"r":122,"l":276,"g":[["فَ","REM","prefix","f:REM"],["سَبِّحْ","V","stem","IMPV|(II)|2MS"],["هُ","PRON","suffix","PRON:3MS"]]},{"i":"52:49:4","a":"وَإِدْبَـٰرَ","t":"and after","p":"N","tr":"wa-id'bāra","f":["VN","(IV)","M","ACC"],"r":220,"l":2924,"g":[["وَ","CONJ","prefix","w:CONJ"],["َإِدْ","N","stem","VN|(IV)|M|ACC"]]},{"i":"52:49:5","a":"ٱلنُّجُومِ","t":"the stars","p":"N","tr":"l-nujūmi","f":["MP","GEN"],"r":499,"l":694,"g":[["ٱل","DET","prefix","Al"],["نُّجُومِ","N","stem","MP|GEN"]]},{"e":"٤٩","v":"52:49"}]},{"l":15,"t":"s","s":53}],"verses":[{"k":"52:32","t":"Or do their minds command them to [say] this, or are they a transgressing people?","j":27,"h":53,"s":52,"a":32,"sd":null},{"k":"52:33","t":"Or do they say, \"He has made it up\"? Rather, they do not believe.","j":27,"h":53,"s":52,"a":33,"sd":null},{"k":"52:34","t":"Then let them produce a statement like it, if they should be truthful.","j":27,"h":53,"s":52,"a":34,"sd":null},{"k":"52:35","t":"Or were they created by nothing, or were they the creators [of themselves]?","j":27,"h":53,"s":52,"a":35,"sd":null},{"k":"52:36","t":"Or did they create the heavens and the earth? Rather, they are not certain.","j":27,"h":53,"s":52,"a":36,"sd":null},{"k":"52:37","t":"Or have they the depositories [containing the provision] of your Lord? Or are they the controllers [of them]?","j":27,"h":53,"s":52,"a":37,"sd":null},{"k":"52:38","t":"Or have they a stairway [into the heaven] upon which they listen? Then let their listener produce a clear authority [i.e., proof].","j":27,"h":53,"s":52,"a":38,"sd":null},{"k":"52:39","t":"Or has He daughters while you have sons?","j":27,"h":53,"s":52,"a":39,"sd":null},{"k":"52:40","t":"Or do you, [O Muḥammad], ask of them a payment, so they are by debt burdened down?","j":27,"h":53,"s":52,"a":40,"sd":null},{"k":"52:41","t":"Or have they [knowledge of] the unseen, so they write [it] down?","j":27,"h":53,"s":52,"a":41,"sd":null},{"k":"52:42","t":"Or do they intend a plan? But those who disbelieve - they are the object of a plan.","j":27,"h":53,"s":52,"a":42,"sd":null},{"k":"52:43","t":"Or have they a deity other than Allāh? Exalted is Allāh above whatever they associate with Him.","j":27,"h":53,"s":52,"a":43,"sd":null},{"k":"52:44","t":"And if they were to see a fragment from the sky falling, they would say, \"[It is merely] clouds heaped up.\"","j":27,"h":53,"s":52,"a":44,"sd":null},{"k":"52:45","t":"So leave them until they meet their Day in which they will be struck insensible -","j":27,"h":53,"s":52,"a":45,"sd":null},{"k":"52:46","t":"The Day their plan will not avail them at all, nor will they be helped.","j":27,"h":53,"s":52,"a":46,"sd":null},{"k":"52:47","t":"And indeed, for those who have wronged is a punishment before that, but most of them do not know.","j":27,"h":53,"s":52,"a":47,"sd":null},{"k":"52:48","t":"And be patient, [O Muḥammad], for the decision of your Lord, for indeed, you are in Our eyes [i.e., sight]. And exalt [Allāh] with praise of your Lord when you arise","j":27,"h":53,"s":52,"a":48,"sd":null},{"k":"52:49","t":"And in a part of the night exalt Him and after [the setting of] the stars.","j":27,"h":53,"s":52,"a":49,"sd":null}],"juz":27,"hizb":53,"surahs":[52],"sajdah":false}