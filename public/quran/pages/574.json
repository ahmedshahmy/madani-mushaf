,"stem","M|NOM"],["هُۥ","PRON","suffix","PRON:3MS"]]},{"i":"73:18:6","a":"مَفْعُولًا","t":"to be fulfilled","p":"N","tr":"mafʿūlan","f":["PASS","PCPL","M","INDEF","ACC"],"r":104,"l":1084},{"e":"١٨","v":"73:18"}]},{"l":15,"t":"a","c":0,"w":[{"i":"73:19:1","a":"إِنَّ","t":"Indeed","p":"ACC","tr":"inna","l":5},{"i":"73:19:2","a":"هَـٰذِهِۦ","t":"this","p":"DEM","tr":"hādhihi","f":["FS"],"l":37},{"i":"73:19:3","a":"تَذْكِرَةٌۭ ۖ","t":"(is) a Reminder","p":"N","tr":"tadhkiratun","f":["VN","(II)","F","INDEF","NOM"],"r":28,"l":925},{"i":"73:19:4","a":"فَمَن","t":"then whoever","p":"COND","tr":"faman","l":12,"g":[["فَ","REM","prefix","f:REM"],["مَن","COND","stem",""]]},{"i":"73:19:5","a":"شَآءَ","t":"wills","p":"V","tr":"shāa","f":["PERF","3MS"],"r":10,"l":54},{"i":"73:19:6","a":"ٱتَّخَذَ","t":"(let him) take","p":"V","tr":"ittakhadha","f":["PERF","(VIII)","3MS"],"r":33,"l":95},{"i":"73:19:7","a":"إِلَىٰ","t":"to","p":"P","tr":"ilā","l":13},{"i":"73:19:8","a":"رَبِّهِۦ","t":"his Lord","p":"N","tr":"rabbihi","f":["M","GEN"],"r":3,"l":10,"g":[["رَبِّ","N","stem","M|GEN"],["هِۦ","PRON","suffix","PRON:3MS"]]},{"i":"73:19:9","a":"سَبِيلًا","t":"a way","p":"N","tr":"sabīlan","f":["M","INDEF","ACC"],"r":56,"l":64},{"e":"١٩","v":"73:19"}]}],"verses":[{"k":"73:1","t":"O you who wraps himself [in clothing]","j":29,"h":58,"s":73,"a":1,"sd":null},{"k":"73:2","t":"Arise [to pray] the night, except for a little -","j":29,"h":58,"s":73,"a":2,"sd":null},{"k":"73:3","t":"Half of it - or subtract from it a little","j":29,"h":58,"s":73,"a":3,"sd":null},{"k":"73:4","t":"Or add to it, and recite the Qur’ān with measured recitation.","j":29,"h":58,"s":73,"a":4,"sd":null},{"k":"73:5","t":"Indeed, We will cast upon you a heavy word.","j":29,"h":58,"s":73,"a":5,"sd":null},{"k":"73:6","t":"Indeed, the hours of the night are more effective for concurrence [of heart and tongue] and more suitable for words.","j":29,"h":58,"s":73,"a":6,"sd":null},{"k":"73:7","t":"Indeed, for you by day is prolonged occupation.","j":29,"h":58,"s":73,"a":7,"sd":null},{"k":"73:8","t":"And remember the name of your Lord and devote yourself to Him with [complete] devotion.","j":29,"h":58,"s":73,"a":8,"sd":null},{"k":"73:9","t":"[He is] the Lord of the East and the West; there is no deity except Him, so take Him as Disposer of [your] affairs.","j":29,"h":58,"s":73,"a":9,"sd":null},{"k":"73:10","t":"And be patient over what they say and avoid them with gracious avoidance.","j":29,"h":58,"s":73,"a":10,"sd":null},{"k":"73:11","t":"And leave Me with [the matter of] the deniers, those of ease [in life], and allow them respite a little.","j":29,"h":58,"s":73,"a":11,"sd":null},{"k":"73:12","t":"Indeed, with Us [for them] are shackles and burning fire.","j":29,"h":58,"s":73,"a":12,"sd":null},{"k":"73:13","t":"And food that chokes and a painful punishment -","j":29,"h":58,"s":73,"a":13,"sd":null},{"k":"73:14","t":"On the Day the earth and the mountains will convulse and the mountains will become a heap of sand pouring down.","j":29,"h":58,"s":73,"a":14,"sd":null},{"k":"73:15","t":"Indeed, We have sent to you a Messenger as a witness upon you just as We sent to Pharaoh a messenger.","j":29,"h":58,"s":73,"a":15,"sd":null},{"k":"73:16","t":"But Pharaoh disobeyed the messenger, so We seized him with a ruinous seizure.","j":29,"h":58,"s":73,"a":16,"sd":null},{"k":"73:17","t":"Then how can you fear, if you disbelieve, a Day that will make the children white-haired?","j":29,"h":58,"s":73,"a":17,"sd":null},{"k":"73:18","t":"The heaven will break apart therefrom; ever is His promise fulfilled.","j":29,"h":58,"s":73,"a":18,"sd":null},{"k":"73:19","t":"Indeed, this is a reminder, so whoever wills may take to his Lord a way.","j":29,"h":58,"s":73,"a":19,"sd":null}],"juz":29,"hizb":58,"surahs":[73],"sajdah":false}