,"REM","prefix","f:REM"],["قُلْ","V","stem","IMPV|2MS"]]},{"i":"9:129:4","a":"حَسْبِىَ","t":"Sufficient for me","p":"N","tr":"ḥasbiya","f":["M","NOM"],"r":102,"l":775,"g":[["حَسْبِ","N","stem","M|NOM"],["ىَ","PRON","suffix","PRON:1S"]]},{"i":"9:129:5","a":"ٱللَّهُ","t":"(is) Allah","p":"PN","tr":"l-lahu","f":["NOM"],"r":0,"l":1},{"i":"9:129:6","a":"لَآ","t":"(There is) no","p":"NEG","tr":"lā","l":4},{"i":"9:129:7","a":"إِلَـٰهَ","t":"god","p":"N","tr":"ilāha","f":["MS","ACC"],"r":0,"l":74}]},{"l":14,"t":"a","c":0,"w":[{"i":"9:129:8","a":"إِلَّا","t":"except","p":"RES","tr":"illā","l":15},{"i":"9:129:9","a":"هُوَ ۖ","t":"Him","p":"PRON","tr":"huwa","f":["3MS"],"l":20},{"i":"9:129:10","a":"عَلَيْهِ","t":"On Him","p":"P","tr":"ʿalayhi","l":8,"g":[["عَلَيْ","P","stem",""],["هِ","PRON","suffix","PRON:3MS"]]},{"i":"9:129:11","a":"تَوَكَّلْتُ ۖ","t":"I put my trust","p":"V","tr":"tawakkaltu","f":["PERF","(V)","1S"],"r":157,"l":292,"g":[["تَوَكَّلْ","V","stem","PERF|(V)|1S"],["تُ","PRON","suffix","PRON:1S"]]},{"i":"9:129:12","a":"وَهُوَ","t":"And He","p":"PRON","tr":"wahuwa","f":["3MS"],"l":20,"g":[["وَ","CONJ","prefix","w:CONJ"],["هُوَ","PRON","stem","3MS"]]},{"i":"9:129:13","a":"رَبُّ","t":"(is the) Lord","p":"N","tr":"rabbu","f":["M","NOM"],"r":3,"l":10},{"i":"9:129:14","a":"ٱلْعَرْشِ","t":"(of) the Throne","p":"N","tr":"l-ʿarshi","f":["M","GEN"],"r":274,"l":372,"g":[["ٱلْ","DET","prefix","Al"],["عَرْشِ","N","stem","M|GEN"]]},{"i":"9:129:15","a":"ٱلْعَظِيمِ","t":"the Great","p":"ADJ","tr":"l-ʿaẓīmi","f":["MS","GEN"],"r":87,"l":98,"g":[["ٱلْ","DET","prefix","Al"],["عَظِيمِ","ADJ","stem","MS|GEN"]]},{"e":"١٢٩","v":"9:129"}]},{"l":15,"t":"s","s":10}],"verses":[{"k":"9:123","t":"O you who have believed, fight against those adjacent to you of the disbelievers and let them find in you harshness. And know that Allāh is with the righteous.","j":11,"h":21,"s":9,"a":123,"sd":null},{"k":"9:124","t":"And whenever a sūrah is revealed, there are among them [i.e., the hypocrites] those who say, \"Which of you has this increased in faith?\" As for those who believed, it has increased them in faith, while they are rejoicing.","j":11,"h":21,"s":9,"a":124,"sd":null},{"k":"9:125","t":"But as for those in whose hearts is disease, it has [only] increased them in evil [in addition] to their evil. And they will have died while they are disbelievers.","j":11,"h":21,"s":9,"a":125,"sd":null},{"k":"9:126","t":"Do they not see that they are tried every year once or twice but then they do not repent nor do they remember?","j":11,"h":21,"s":9,"a":126,"sd":null},{"k":"9:127","t":"And whenever a sūrah is revealed, they look at each other, [as if saying], \"Does anyone see you?\" and then they dismiss themselves. Allāh has dismissed their hearts because they are a people who do not understand.","j":11,"h":21,"s":9,"a":127,"sd":null},{"k":"9:128","t":"There has certainly come to you a Messenger from among yourselves. Grievous to him is what you suffer; [he is] concerned over you [i.e., your guidance] and to the believers is kind and merciful.","j":11,"h":21,"s":9,"a":128,"sd":null},{"k":"9:129","t":"But if they turn away, [O Muḥammad], say, \"Sufficient for me is Allāh; there is no deity except Him. On Him I have relied, and He is the Lord of the Great Throne.\"","j":11,"h":21,"s":9,"a":129,"sd":null}],"juz":11,"hizb":21,"surahs":[9],"sajdah":false}