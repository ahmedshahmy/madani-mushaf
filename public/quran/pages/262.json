e) a people","p":"N","tr":"qawmun","f":["M","INDEF","NOM"],"r":6,"l":27},{"i":"15:15:8","a":"مَّسْحُورُونَ","t":"bewitched","p":"N","tr":"masḥūrūna","f":["PASS","PCPL","MP","NOM"],"r":175,"l":1601},{"e":"١٥","v":"15:15"}]}],"verses":[{"k":"15:1","t":"Alif, Lām, Rā. These are the verses of the Book and a clear Qur’ān [i.e., recitation].","j":14,"h":27,"s":15,"a":1,"sd":null},{"k":"15:2","t":"Perhaps those who disbelieve will wish that they had been Muslims.","j":14,"h":27,"s":15,"a":2,"sd":null},{"k":"15:3","t":"Let them eat and enjoy themselves and be diverted by [false] hope, for they are going to know.","j":14,"h":27,"s":15,"a":3,"sd":null},{"k":"15:4","t":"And We did not destroy any city but that for it was a known decree.","j":14,"h":27,"s":15,"a":4,"sd":null},{"k":"15:5","t":"No nation will precede its term, nor will they remain thereafter.","j":14,"h":27,"s":15,"a":5,"sd":null},{"k":"15:6","t":"And they say, \"O you upon whom the message has been sent down, indeed you are mad.","j":14,"h":27,"s":15,"a":6,"sd":null},{"k":"15:7","t":"Why do you not bring us the angels, if you should be among the truthful?\"","j":14,"h":27,"s":15,"a":7,"sd":null},{"k":"15:8","t":"We do not send down the angels except with truth; and they [i.e., the disbelievers] would not then be reprieved.","j":14,"h":27,"s":15,"a":8,"sd":null},{"k":"15:9","t":"Indeed, it is We who sent down the message [i.e., the Qur’ān], and indeed, We will be its guardian.","j":14,"h":27,"s":15,"a":9,"sd":null},{"k":"15:10","t":"And We had certainly sent [messengers] before you, [O Muḥammad], among the sects of the former peoples.","j":14,"h":27,"s":15,"a":10,"sd":null},{"k":"15:11","t":"And no messenger would come to them except that they ridiculed him.","j":14,"h":27,"s":15,"a":11,"sd":null},{"k":"15:12","t":"Thus do We insert it [i.e., denial] into the hearts of the criminals.","j":14,"h":27,"s":15,"a":12,"sd":null},{"k":"15:13","t":"They will not believe in it, while there has already occurred the precedent of the former peoples.","j":14,"h":27,"s":15,"a":13,"sd":null},{"k":"15:14","t":"And [even] if We opened to them a gate from the heaven and they continued therein to ascend,","j":14,"h":27,"s":15,"a":14,"sd":null},{"k":"15:15","t":"They would say, \"Our eyes have only been dazzled. Rather, we are a people affected by magic.\"","j":14,"h":27,"s":15,"a":15,"sd":null}],"juz":14,"hizb":27,"surahs":[15],"sajdah":false}