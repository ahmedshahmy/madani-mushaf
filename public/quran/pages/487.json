:[["وَ","CONJ","prefix","w:CONJ"],["تَرَى","V","stem","IMPF|2MS"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"42:44:11","a":"ٱلظَّـٰلِمِينَ","t":"the wrongdoers","p":"N","tr":"l-ẓālimīna","f":["ACT","PCPL","MP","ACC"],"r":24,"l":89,"g":[["ٱل","DET","prefix","Al"],["ظَّـٰلِ","N","stem","ACT|PCPL|MP|ACC"]]},{"i":"42:44:12","a":"لَمَّا","t":"when","p":"T","tr":"lammā","l":71},{"i":"42:44:13","a":"رَأَوُا۟","t":"they see","p":"V","tr":"ra-awū","f":["PERF","3MP"],"r":21,"l":46,"g":[["رَأَ","V","stem","PERF|3MP"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"42:44:14","a":"ٱلْعَذَابَ","t":"the punishment","p":"N","tr":"l-ʿadhāba","f":["M","ACC"],"r":17,"l":36,"g":[["ٱلْ","DET","prefix","Al"],["عَذَابَ","N","stem","M|ACC"]]},{"i":"42:44:15","a":"يَقُولُونَ","t":"saying","p":"V","tr":"yaqūlūna","f":["IMPF","3MP"],"r":1,"l":6,"g":[["يَقُولُ","V","stem","IMPF|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"i":"42:44:16","a":"هَلْ","t":"Is","p":"INTG","tr":"hal","l":115},{"i":"42:44:17","a":"إِلَىٰ","t":"(there) for","p":"P","tr":"ilā","l":13},{"i":"42:44:18","a":"مَرَدٍّۢ","t":"return","p":"N","tr":"maraddin","f":["M","INDEF","GEN"],"r":184,"l":1198},{"i":"42:44:19","a":"مِّن","t":"any","p":"P","tr":"min","l":0},{"i":"42:44:20","a":"سَبِيلٍۢ","t":"way","p":"N","tr":"sabīlin","f":["M","INDEF","GEN"],"r":56,"l":64},{"e":"٤٤","v":"42:44"}]}],"verses":[{"k":"42:32","t":"And of His signs are the ships in the sea, like mountains.","j":25,"h":49,"s":42,"a":32,"sd":null},{"k":"42:33","t":"If He willed, He could still the wind, and they would remain motionless on its surface. Indeed in that are signs for everyone patient and grateful.","j":25,"h":49,"s":42,"a":33,"sd":null},{"k":"42:34","t":"Or He could destroy them for what they earned; but He pardons much.","j":25,"h":49,"s":42,"a":34,"sd":null},{"k":"42:35","t":"And [that is so] those who dispute concerning Our signs may know that for them there is no place of escape.","j":25,"h":49,"s":42,"a":35,"sd":null},{"k":"42:36","t":"So whatever thing you have been given - it is but [for] enjoyment of the worldly life. But what is with Allāh is better and more lasting for those who have believed and upon their Lord rely","j":25,"h":49,"s":42,"a":36,"sd":null},{"k":"42:37","t":"And those who avoid the major sins and immoralities, and when they are angry, they forgive,","j":25,"h":49,"s":42,"a":37,"sd":null},{"k":"42:38","t":"And those who have responded to their Lord and established prayer and whose affair is [determined by] consultation among themselves, and from what We have provided them, they spend,","j":25,"h":49,"s":42,"a":38,"sd":null},{"k":"42:39","t":"And those who, when tyranny strikes them, they retaliate [in a just manner].","j":25,"h":49,"s":42,"a":39,"sd":null},{"k":"42:40","t":"And the retribution for an evil act is an evil one like it, but whoever pardons and makes reconciliation - his reward is [due] from Allāh. Indeed, He does not like wrongdoers.","j":25,"h":49,"s":42,"a":40,"sd":null},{"k":"42:41","t":"And whoever retaliates after having been wronged - those have not upon them any cause [for blame].","j":25,"h":49,"s":42,"a":41,"sd":null},{"k":"42:42","t":"The cause is only against the ones who wrong the people and tyrannize upon the earth without right. Those will have a painful punishment.","j":25,"h":49,"s":42,"a":42,"sd":null},{"k":"42:43","t":"And whoever is patient and forgives - indeed, that is of the matters [worthy] of resolve.","j":25,"h":49,"s":42,"a":43,"sd":null},{"k":"42:44","t":"And he whom Allāh sends astray - for him there is no protector beyond Him. And you will see the wrongdoers, when they see the punishment, saying, \"Is there for return [to the former world] any way?\"","j":25,"h":49,"s":42,"a":44,"sd":null}],"juz":25,"hizb":49,"surahs":[42],"sajdah":false}