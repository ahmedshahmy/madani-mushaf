ge].\" And it is not righteousness to enter houses from the back, but righteousness is [in] one who fears Allāh. And enter houses from their doors. And fear Allāh that you may succeed.","j":2,"h":3,"s":2,"a":189,"sd":null},{"k":"2:190","t":"Fight in the way of Allāh those who fight against you but do not transgress. Indeed, Allāh does not like transgressors.","j":2,"h":3,"s":2,"a":190,"sd":null}],"juz":2,"hizb":3,"surahs":[2],"sajdah":false}