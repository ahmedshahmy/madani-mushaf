:"V","tr":"watuʿazzirūhu","f":["IMPF","(II)","2MP","MOOD:SUBJ"],"r":952,"l":1767,"g":[["وَ","CONJ","prefix","w:CONJ"],["تُعَزِّرُ","V","stem","IMPF|(II)|2MP|MOOD:SUBJ"],["و","PRON","suffix","PRON:2MP"],["هُ","PRON","suffix","PRON:3MS"]]},{"i":"48:9:5","a":"وَتُوَقِّرُوهُ","t":"and respect him","p":"V","tr":"watuwaqqirūhu","f":["IMPF","(II)","2MP","MOOD:SUBJ"],"r":626,"l":4473,"g":[["وَ","CONJ","prefix","w:CONJ"],["تُوَقِّرُ","V","stem","IMPF|(II)|2MP|MOOD:SUBJ"],["و","PRON","suffix","PRON:2MP"],["هُ","PRON","suffix","PRON:3MS"]]},{"i":"48:9:6","a":"وَتُسَبِّحُوهُ","t":"and glorify Him","p":"V","tr":"watusabbiḥūhu","f":["IMPF","(II)","2MP","MOOD:SUBJ"],"r":122,"l":276,"g":[["وَ","CONJ","prefix","w:CONJ"],["تُسَبِّحُ","V","stem","IMPF|(II)|2MP|MOOD:SUBJ"],["و","PRON","suffix","PRON:2MP"],["هُ","PRON","suffix","PRON:3MS"]]},{"i":"48:9:7","a":"بُكْرَةًۭ","t":"morning","p":"T","tr":"buk'ratan","f":["F","INDEF","ACC"],"r":519,"l":1065},{"i":"48:9:8","a":"وَأَصِيلًا","t":"and evening","p":"T","tr":"wa-aṣīlan","f":["M","INDEF","ACC"],"r":567,"l":1033,"g":[["وَ","CONJ","prefix","w:CONJ"],["أَصِيلًا","T","stem","M|INDEF|ACC"]]},{"e":"٩","v":"48:9"}]}],"verses":[{"k":"48:1","t":"Indeed, We have given you, [O Muḥammad], a clear conquest","j":26,"h":51,"s":48,"a":1,"sd":null},{"k":"48:2","t":"That Allāh may forgive for you what preceded of your sin [i.e., errors] and what will follow and complete His favor upon you and guide you to a straight path","j":26,"h":51,"s":48,"a":2,"sd":null},{"k":"48:3","t":"And [that] Allāh may aid you with a mighty victory.","j":26,"h":51,"s":48,"a":3,"sd":null},{"k":"48:4","t":"It is He who sent down tranquility into the hearts of the believers that they would increase in faith along with their [present] faith. And to Allāh belong the soldiers of the heavens and the earth, and ever is Allāh Knowing and Wise.","j":26,"h":51,"s":48,"a":4,"sd":null},{"k":"48:5","t":"[And] that He may admit the believing men and the believing women to gardens beneath which rivers flow to abide therein eternally and remove from them their misdeeds - and ever is that, in the sight of Allāh, a great attainment","j":26,"h":51,"s":48,"a":5,"sd":null},{"k":"48:6","t":"And [that] He may punish the hypocrite men and hypocrite women, and the polytheist men and polytheist women - those who assume about Allāh an assumption of evil nature. Upon them is a misfortune of evil nature; and Allāh has become angry with them and has cursed them and prepared for them Hell, and evil it is as a destination.","j":26,"h":51,"s":48,"a":6,"sd":null},{"k":"48:7","t":"And to Allāh belong the soldiers of the heavens and the earth. And ever is Allāh Exalted in Might and Wise.","j":26,"h":51,"s":48,"a":7,"sd":null},{"k":"48:8","t":"Indeed, We have sent you as a witness and a bringer of good tidings and a warner","j":26,"h":51,"s":48,"a":8,"sd":null},{"k":"48:9","t":"That you [people] may believe in Allāh and His Messenger and honor him and respect him [i.e., the Prophet (ﷺ)] and exalt Him [i.e., Allāh] morning and afternoon.","j":26,"h":51,"s":48,"a":9,"sd":null}],"juz":26,"hizb":51,"surahs":[48],"sajdah":false}