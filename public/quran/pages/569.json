"a":"وَٱلْمَغَـٰرِبِ","t":"and the settings","p":"N","tr":"wal-maghāribi","f":["MP","GEN"],"r":415,"l":844,"g":[["وَ","CONJ","prefix","w:CONJ"],["َٱ","DET","prefix","Al"],["لْمَغَـٰ","N","stem","MP|GEN"]]},{"i":"70:40:6","a":"إِنَّا","t":"that We","p":"ACC","tr":"innā","l":5,"g":[["إِنَّ","ACC","stem",""],["ا","PRON","suffix","PRON:1P"]]},{"i":"70:40:7","a":"لَقَـٰدِرُونَ","t":"(are) surely Able","p":"N","tr":"laqādirūna","f":["ACT","PCPL","MP","NOM"],"r":81,"l":672,"g":[["لَ","EMPH","prefix","l:EMPH"],["َقَـٰدِ","N","stem","ACT|PCPL|MP|NOM"]]},{"e":"٤٠","v":"70:40"}]}],"verses":[{"k":"70:11","t":"They will be shown each other. The criminal will wish that he could be ransomed from the punishment of that Day by his children.","j":29,"h":57,"s":70,"a":11,"sd":null},{"k":"70:12","t":"And his wife and his brother","j":29,"h":57,"s":70,"a":12,"sd":null},{"k":"70:13","t":"And his nearest kindred who shelter him.","j":29,"h":57,"s":70,"a":13,"sd":null},{"k":"70:14","t":"And whoever is on earth entirely [so] then it could save him.","j":29,"h":57,"s":70,"a":14,"sd":null},{"k":"70:15","t":"No! Indeed, it is the Flame [of Hell],","j":29,"h":57,"s":70,"a":15,"sd":null},{"k":"70:16","t":"A remover of exteriors.","j":29,"h":57,"s":70,"a":16,"sd":null},{"k":"70:17","t":"It invites he who turned his back [on truth] and went away [from obedience]","j":29,"h":57,"s":70,"a":17,"sd":null},{"k":"70:18","t":"And collected [wealth] and hoarded.","j":29,"h":57,"s":70,"a":18,"sd":null},{"k":"70:19","t":"Indeed, mankind was created anxious:","j":29,"h":57,"s":70,"a":19,"sd":null},{"k":"70:20","t":"When evil touches him, impatient,","j":29,"h":57,"s":70,"a":20,"sd":null},{"k":"70:21","t":"And when good touches him, withholding [of it],","j":29,"h":57,"s":70,"a":21,"sd":null},{"k":"70:22","t":"Except the observers of prayer -","j":29,"h":57,"s":70,"a":22,"sd":null},{"k":"70:23","t":"Those who are constant in their prayer","j":29,"h":57,"s":70,"a":23,"sd":null},{"k":"70:24","t":"And those within whose wealth is a known right","j":29,"h":57,"s":70,"a":24,"sd":null},{"k":"70:25","t":"For the petitioner and the deprived -","j":29,"h":57,"s":70,"a":25,"sd":null},{"k":"70:26","t":"And those who believe in the Day of Recompense","j":29,"h":57,"s":70,"a":26,"sd":null},{"k":"70:27","t":"And those who are fearful of the punishment of their Lord -","j":29,"h":57,"s":70,"a":27,"sd":null},{"k":"70:28","t":"Indeed, the punishment of their Lord is not that from which one is safe -","j":29,"h":57,"s":70,"a":28,"sd":null},{"k":"70:29","t":"And those who guard their private parts","j":29,"h":57,"s":70,"a":29,"sd":null},{"k":"70:30","t":"Except from their wives or those their right hands possess, for indeed, they are not to be blamed -","j":29,"h":57,"s":70,"a":30,"sd":null},{"k":"70:31","t":"But whoever seeks beyond that, then they are the transgressors -","j":29,"h":57,"s":70,"a":31,"sd":null},{"k":"70:32","t":"And those who are to their trusts and promises attentive.","j":29,"h":57,"s":70,"a":32,"sd":null},{"k":"70:33","t":"And those who are in their testimonies upright","j":29,"h":57,"s":70,"a":33,"sd":null},{"k":"70:34","t":"And those who [carefully] maintain their prayer:","j":29,"h":57,"s":70,"a":34,"sd":null},{"k":"70:35","t":"They will be in gardens, honored.","j":29,"h":57,"s":70,"a":35,"sd":null},{"k":"70:36","t":"So what is [the matter] with those who disbelieve, hastening [from] before you, [O Muḥammad],","j":29,"h":57,"s":70,"a":36,"sd":null},{"k":"70:37","t":"[To sit] on [your] right and [your] left in separate groups?","j":29,"h":57,"s":70,"a":37,"sd":null},{"k":"70:38","t":"Does every person among them aspire to enter a garden of pleasure?","j":29,"h":57,"s":70,"a":38,"sd":null},{"k":"70:39","t":"No! Indeed, We have created them from that which they know.","j":29,"h":57,"s":70,"a":39,"sd":null},{"k":"70:40","t":"So I swear by the Lord of [all] risings and settings that indeed We are able","j":29,"h":57,"s":70,"a":40,"sd":null}],"juz":29,"hizb":57,"surahs":[70],"sajdah":false}