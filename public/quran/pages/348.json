:139,"l":166,"g":[["وُجُوهَ","N","stem","MP|ACC"],["هُمُ","PRON","suffix","PRON:3MP"]]},{"i":"23:104:3","a":"ٱلنَّارُ","t":"the Fire","p":"N","tr":"l-nāru","f":["F","NOM"],"r":49,"l":77,"g":[["ٱل","DET","prefix","Al"],["نَّارُ","N","stem","F|NOM"]]},{"i":"23:104:4","a":"وَهُمْ","t":"and they","p":"PRON","tr":"wahum","f":["3MP"],"l":11,"g":[["وَ","CONJ","prefix","w:CONJ"],["هُمْ","PRON","stem","3MP"]]},{"i":"23:104:5","a":"فِيهَا","t":"in it","p":"P","tr":"fīhā","l":3,"g":[["فِي","P","stem",""],["هَا","PRON","suffix","PRON:3FS"]]},{"i":"23:104:6","a":"كَـٰلِحُونَ","t":"(will) grin with displaced lips","p":"N","tr":"kāliḥūna","f":["ACT","PCPL","MP","NOM"],"r":1455,"l":3562},{"e":"١٠٤","v":"23:104"}]}],"verses":[{"k":"23:90","t":"Rather, We have brought them the truth, and indeed they are liars.","j":18,"h":35,"s":23,"a":90,"sd":null},{"k":"23:91","t":"Allāh has not taken any son, nor has there ever been with Him any deity. [If there had been], then each deity would have taken what it created, and some of them would have [sought to] overcome others. Exalted is Allāh above what they describe [concerning Him].","j":18,"h":35,"s":23,"a":91,"sd":null},{"k":"23:92","t":"[He is] Knower of the unseen and the witnessed, so high is He above what they associate [with Him].","j":18,"h":35,"s":23,"a":92,"sd":null},{"k":"23:93","t":"Say, [O Muḥammad], \"My Lord, if You should show me that which they are promised,","j":18,"h":35,"s":23,"a":93,"sd":null},{"k":"23:94","t":"My Lord, then do not place me among the wrongdoing people.\"","j":18,"h":35,"s":23,"a":94,"sd":null},{"k":"23:95","t":"And indeed, We are Able to show you what We have promised them.","j":18,"h":35,"s":23,"a":95,"sd":null},{"k":"23:96","t":"Repel, by [means of] what is best, [their] evil. We are most knowing of what they describe.","j":18,"h":35,"s":23,"a":96,"sd":null},{"k":"23:97","t":"And say, \"My Lord, I seek refuge in You from the incitements of the devils,","j":18,"h":35,"s":23,"a":97,"sd":null},{"k":"23:98","t":"And I seek refuge in You, my Lord, lest they be present with me.\"","j":18,"h":35,"s":23,"a":98,"sd":null},{"k":"23:99","t":"[For such is the state of the disbelievers] until, when death comes to one of them, he says, \"My Lord, send me back","j":18,"h":35,"s":23,"a":99,"sd":null},{"k":"23:100","t":"That I might do righteousness in that which I left behind.\" No! It is only a word he is saying; and behind them is a barrier until the Day they are resurrected.","j":18,"h":35,"s":23,"a":100,"sd":null},{"k":"23:101","t":"So when the Horn is blown, no relationship will there be among them that Day, nor will they ask about one another.","j":18,"h":35,"s":23,"a":101,"sd":null},{"k":"23:102","t":"And those whose scales are heavy [with good deeds] - it is they who are the successful.","j":18,"h":35,"s":23,"a":102,"sd":null},{"k":"23:103","t":"But those whose scales are light - those are the ones who have lost their souls, [being] in Hell, abiding eternally.","j":18,"h":35,"s":23,"a":103,"sd":null},{"k":"23:104","t":"The Fire will sear their faces, and they therein will have taut smiles.","j":18,"h":35,"s":23,"a":104,"sd":null}],"juz":18,"hizb":35,"surahs":[23],"sajdah":false}