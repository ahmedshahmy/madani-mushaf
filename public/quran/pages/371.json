f":["PERF","3MP"],"r":1,"l":6,"g":[["قَالُ","V","stem","PERF|3MP"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"26:111:2","a":"أَنُؤْمِنُ","t":"Should we believe","p":"V","tr":"anu'minu","f":["IMPF","(IV)","1P"],"r":4,"l":18,"g":[["أَ","INTG","prefix","A:INTG"],["نُؤْمِنُ","V","stem","IMPF|(IV)|1P"]]},{"i":"26:111:3","a":"لَكَ","t":"in you","p":"PRON","tr":"laka","f":["2MS"],"l":138,"g":[["لَ","P","prefix","l:P"],["كَ","PRON","stem","2MS"]]},{"i":"26:111:4","a":"وَٱتَّبَعَكَ","t":"while followed you","p":"V","tr":"wa-ittabaʿaka","f":["PERF","(VIII)","3MS"],"r":57,"l":84,"g":[["وَ","CIRC","prefix","w:CIRC"],["ٱتَّبَعَ","V","stem","PERF|(VIII)|3MS"],["كَ","PRON","suffix","PRON:2MS"]]},{"i":"26:111:5","a":"ٱلْأَرْذَلُونَ","t":"the lowest","p":"N","tr":"l-ardhalūna","f":["MP","NOM"],"r":895,"l":1480,"g":[["ٱلْ","DET","prefix","Al"],["أَرْذَلُونَ","N","stem","MP|NOM"]]},{"e":"١١١","v":"26:111"}]}],"verses":[{"k":"26:84","t":"And grant me a mention [i.e., reputation] of honor among later generations.","j":19,"h":37,"s":26,"a":84,"sd":null},{"k":"26:85","t":"And place me among the inheritors of the Garden of Pleasure.","j":19,"h":37,"s":26,"a":85,"sd":null},{"k":"26:86","t":"And forgive my father. Indeed, he has been of those astray.","j":19,"h":37,"s":26,"a":86,"sd":null},{"k":"26:87","t":"And do not disgrace me on the Day they are [all] resurrected -","j":19,"h":37,"s":26,"a":87,"sd":null},{"k":"26:88","t":"The Day when there will not benefit [anyone] wealth or children","j":19,"h":37,"s":26,"a":88,"sd":null},{"k":"26:89","t":"But only one who comes to Allāh with a sound heart.\"","j":19,"h":37,"s":26,"a":89,"sd":null},{"k":"26:90","t":"And Paradise will be brought near [that Day] to the righteous.","j":19,"h":37,"s":26,"a":90,"sd":null},{"k":"26:91","t":"And Hellfire will be brought forth for the deviators,","j":19,"h":37,"s":26,"a":91,"sd":null},{"k":"26:92","t":"And it will be said to them, \"Where are those you used to worship","j":19,"h":37,"s":26,"a":92,"sd":null},{"k":"26:93","t":"Other than Allāh? Can they help you or help themselves?\"","j":19,"h":37,"s":26,"a":93,"sd":null},{"k":"26:94","t":"So they will be overturned into it [i.e., Hellfire], they and the deviators","j":19,"h":37,"s":26,"a":94,"sd":null},{"k":"26:95","t":"And the soldiers of Iblees, all together.","j":19,"h":37,"s":26,"a":95,"sd":null},{"k":"26:96","t":"They will say while they dispute therein,","j":19,"h":37,"s":26,"a":96,"sd":null},{"k":"26:97","t":"\"By Allāh, we were indeed in manifest error","j":19,"h":37,"s":26,"a":97,"sd":null},{"k":"26:98","t":"When we equated you with the Lord of the worlds.","j":19,"h":37,"s":26,"a":98,"sd":null},{"k":"26:99","t":"And no one misguided us except the criminals.","j":19,"h":37,"s":26,"a":99,"sd":null},{"k":"26:100","t":"So now we have no intercessors","j":19,"h":37,"s":26,"a":100,"sd":null},{"k":"26:101","t":"And not a devoted friend.","j":19,"h":37,"s":26,"a":101,"sd":null},{"k":"26:102","t":"Then if we only had a return [to the world] and could be of the believers...\"","j":19,"h":37,"s":26,"a":102,"sd":null},{"k":"26:103","t":"Indeed in that is a sign, but most of them were not to be believers.","j":19,"h":37,"s":26,"a":103,"sd":null},{"k":"26:104","t":"And indeed, your Lord - He is the Exalted in Might, the Merciful.","j":19,"h":37,"s":26,"a":104,"sd":null},{"k":"26:105","t":"The people of Noah denied the messengers","j":19,"h":37,"s":26,"a":105,"sd":null},{"k":"26:106","t":"When their brother Noah said to them, \"Will you not fear Allāh?","j":19,"h":37,"s":26,"a":106,"sd":null},{"k":"26:107","t":"Indeed, I am to you a trustworthy messenger.","j":19,"h":37,"s":26,"a":107,"sd":null},{"k":"26:108","t":"So fear Allāh and obey me.","j":19,"h":37,"s":26,"a":108,"sd":null},{"k":"26:109","t":"And I do not ask you for it any payment. My payment is only from the Lord of the worlds.","j":19,"h":37,"s":26,"a":109,"sd":null},{"k":"26:110","t":"So fear Allāh and obey me.\"","j":19,"h":37,"s":26,"a":110,"sd":null},{"k":"26:111","t":"They said, \"Should we believe you while you are followed by the lowest [class of people]?\"","j":19,"h":38,"s":26,"a":111,"sd":null}],"juz":19,"hizb":37,"surahs":[26],"sajdah":false}