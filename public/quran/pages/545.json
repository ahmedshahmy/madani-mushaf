":null},{"k":"59:3","t":"And if not that Allāh had decreed for them evacuation, He would have punished them in [this] world, and for them in the Hereafter is the punishment of the Fire.","j":28,"h":55,"s":59,"a":3,"sd":null}],"juz":28,"hizb":55,"surahs":[58,59],"sajdah":false}