:"NEG","tr":"lam","l":32},{"i":"7:11:14","a":"يَكُن","t":"he was","p":"V","tr":"yakun","f":["IMPF","3MS","MOOD:JUS"],"r":2,"l":9},{"i":"7:11:15","a":"مِّنَ","t":"of","p":"P","tr":"mina","l":0},{"i":"7:11:16","a":"ٱلسَّـٰجِدِينَ","t":"those who prostrated","p":"N","tr":"l-sājidīna","f":["ACT","PCPL","MP","GEN"],"r":123,"l":459,"g":[["ٱل","DET","prefix","Al"],["سَّـٰجِ","N","stem","ACT|PCPL|MP|GEN"]]},{"e":"١١","v":"7:11"}]}],"verses":[{"k":"7:1","t":"Alif, Lām, Meem, Ṣād.","j":8,"h":16,"s":7,"a":1,"sd":null},{"k":"7:2","t":"[This is] a Book revealed to you, [O Muḥammad] - so let there not be in your breast distress therefrom - that you may warn thereby and as a reminder to the believers.","j":8,"h":16,"s":7,"a":2,"sd":null},{"k":"7:3","t":"Follow, [O mankind], what has been revealed to you from your Lord and do not follow other than Him any allies. Little do you remember.","j":8,"h":16,"s":7,"a":3,"sd":null},{"k":"7:4","t":"And how many cities have We destroyed, and Our punishment came to them at night or while they were sleeping at noon.","j":8,"h":16,"s":7,"a":4,"sd":null},{"k":"7:5","t":"And their declaration when Our punishment came to them was only that they said, \"Indeed, we were wrongdoers!\"","j":8,"h":16,"s":7,"a":5,"sd":null},{"k":"7:6","t":"Then We will surely question those to whom [a message] was sent, and We will surely question the messengers.","j":8,"h":16,"s":7,"a":6,"sd":null},{"k":"7:7","t":"Then We will surely relate [their deeds] to them with knowledge, and We were not [at all] absent.","j":8,"h":16,"s":7,"a":7,"sd":null},{"k":"7:8","t":"And the weighing [of deeds] that Day will be the truth. So those whose scales are heavy - it is they who will be the successful.","j":8,"h":16,"s":7,"a":8,"sd":null},{"k":"7:9","t":"And those whose scales are light - they are the ones who will lose themselves for what injustice they were doing toward Our verses.","j":8,"h":16,"s":7,"a":9,"sd":null},{"k":"7:10","t":"And We have certainly established you upon the earth and made for you therein ways of livelihood. Little are you grateful.","j":8,"h":16,"s":7,"a":10,"sd":null},{"k":"7:11","t":"And We have certainly created you, [O mankind], and given you [human] form. Then We said to the angels, \"Prostrate to Adam\"; so they prostrated, except for Iblees. He was not of those who prostrated.","j":8,"h":16,"s":7,"a":11,"sd":null}],"juz":8,"hizb":16,"surahs":[7],"sajdah":false}