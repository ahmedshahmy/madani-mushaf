","a":"ٱلَّتِى","t":"which","p":"REL","tr":"allatī","f":["FS"],"l":7},{"i":"52:14:4","a":"كُنتُم","t":"you used to","p":"V","tr":"kuntum","f":["PERF","2MP"],"r":2,"l":9,"g":[["كُن","V","stem","PERF|2MP"],["تُم","PRON","suffix","PRON:2MP"]]},{"i":"52:14:5","a":"بِهَا","t":"[of it]","p":"PRON","tr":"bihā","f":["3FS"],"l":94,"g":[["بِ","P","prefix","bi"],["هَا","PRON","stem","3FS"]]},{"i":"52:14:6","a":"تُكَذِّبُونَ","t":"deny","p":"V","tr":"tukadhibūna","f":["IMPF","(II)","2MP"],"r":30,"l":63,"g":[["تُكَذِّبُ","V","stem","IMPF|(II)|2MP"],["ونَ","PRON","suffix","PRON:2MP"]]},{"e":"١٤","v":"52:14"}]}],"verses":[{"k":"51:52","t":"Similarly, there came not to those before them any messenger except that they said, \"A magician or a madman.\"","j":27,"h":53,"s":51,"a":52,"sd":null},{"k":"51:53","t":"Did they suggest it to them? Rather, they [themselves] are a transgressing people.","j":27,"h":53,"s":51,"a":53,"sd":null},{"k":"51:54","t":"So leave them, [O Muḥammad], for you are not to be blamed.","j":27,"h":53,"s":51,"a":54,"sd":null},{"k":"51:55","t":"And remind, for indeed, the reminder benefits the believers.","j":27,"h":53,"s":51,"a":55,"sd":null},{"k":"51:56","t":"And I did not create the jinn and mankind except to worship Me.","j":27,"h":53,"s":51,"a":56,"sd":null},{"k":"51:57","t":"I do not want from them any provision, nor do I want them to feed Me.","j":27,"h":53,"s":51,"a":57,"sd":null},{"k":"51:58","t":"Indeed, it is Allāh who is the [continual] Provider, the firm possessor of strength.","j":27,"h":53,"s":51,"a":58,"sd":null},{"k":"51:59","t":"And indeed, for those who have wronged is a portion [of punishment] like the portion of their companions [i.e., predecessors], so let them not impatiently urge Me.","j":27,"h":53,"s":51,"a":59,"sd":null},{"k":"51:60","t":"And woe to those who have disbelieved from their Day which they are promised.","j":27,"h":53,"s":51,"a":60,"sd":null},{"k":"52:1","t":"By the mount","j":27,"h":53,"s":52,"a":1,"sd":null},{"k":"52:2","t":"And [by] a Book inscribed","j":27,"h":53,"s":52,"a":2,"sd":null},{"k":"52:3","t":"In parchment spread open","j":27,"h":53,"s":52,"a":3,"sd":null},{"k":"52:4","t":"And [by] the frequented House","j":27,"h":53,"s":52,"a":4,"sd":null},{"k":"52:5","t":"And [by] the ceiling [i.e., heaven] raised high","j":27,"h":53,"s":52,"a":5,"sd":null},{"k":"52:6","t":"And [by] the sea set on fire,","j":27,"h":53,"s":52,"a":6,"sd":null},{"k":"52:7","t":"Indeed, the punishment of your Lord will occur.","j":27,"h":53,"s":52,"a":7,"sd":null},{"k":"52:8","t":"Of it there is no preventer.","j":27,"h":53,"s":52,"a":8,"sd":null},{"k":"52:9","t":"On the Day the heaven will sway with circular motion","j":27,"h":53,"s":52,"a":9,"sd":null},{"k":"52:10","t":"And the mountains will pass on, departing -","j":27,"h":53,"s":52,"a":10,"sd":null},{"k":"52:11","t":"Then woe, that Day, to the deniers,","j":27,"h":53,"s":52,"a":11,"sd":null},{"k":"52:12","t":"Who are in [empty] discourse amusing themselves.","j":27,"h":53,"s":52,"a":12,"sd":null},{"k":"52:13","t":"The Day they are thrust toward the fire of Hell with a [violent] thrust, [its angels will say],","j":27,"h":53,"s":52,"a":13,"sd":null},{"k":"52:14","t":"\"This is the Fire which you used to deny.","j":27,"h":53,"s":52,"a":14,"sd":null}],"juz":27,"hizb":53,"surahs":[51,52],"sajdah":false}