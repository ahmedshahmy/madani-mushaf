{
  "name": "madani-mushaf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive 604-page Madani Mushaf with word-by-word English meaning, roots, derivations, grammar and Qur'anic occurrences.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "python3 scripts/build_data.py && python3 scripts/build_final.py",
    "verify": "python3 scripts/verify_data.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.2"
  }
}
