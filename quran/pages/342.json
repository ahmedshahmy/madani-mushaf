":[["ٱلْ","DET","prefix","Al"],["ْقِيَـٰ","N","stem","F|GEN"]]},{"i":"23:16:5","a":"تُبْعَثُونَ","t":"will be resurrected","p":"V","tr":"tub'ʿathūna","f":["IMPF","PASS","2MP"],"r":162,"l":227,"g":[["تُبْعَثُ","V","stem","IMPF|PASS|2MP"],["ونَ","PRON","suffix","PRON:2MP"]]},{"e":"١٦","v":"23:16"},{"i":"23:17:1","a":"وَلَقَدْ","t":"And indeed","p":"CERT","tr":"walaqad","l":24,"g":[["وَ","CONJ","prefix","w:CONJ"],["لَ","EMPH","prefix","l:EMPH"],["قَدْ","CERT","stem",""]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"23:17:2","a":"خَلَقْنَا","t":"We (have) created","p":"V","tr":"khalaqnā","f":["PERF","1P"],"r":34,"l":60,"g":[["خَلَقْ","V","stem","PERF|1P"],["نَا","PRON","suffix","PRON:1P"]]},{"i":"23:17:3","a":"فَوْقَكُمْ","t":"above you","p":"N","tr":"fawqakum","f":["M","ACC"],"r":225,"l":284,"g":[["فَوْقَ","N","stem","M|ACC"],["كُمْ","PRON","suffix","PRON:2MP"]]},{"i":"23:17:4","a":"سَبْعَ","t":"seven","p":"N","tr":"sabʿa","f":["M","ACC"],"r":322,"l":460},{"i":"23:17:5","a":"طَرَآئِقَ","t":"paths","p":"N","tr":"ṭarāiqa","f":["MP","ACC"],"r":549,"l":1316},{"i":"23:17:6","a":"وَمَا","t":"and not","p":"NEG","tr":"wamā","l":2,"g":[["وَ","CONJ","prefix","w:CONJ"],["مَا","NEG","stem",""]]},{"i":"23:17:7","a":"كُنَّا","t":"We are","p":"V","tr":"kunnā","f":["PERF","1P"],"r":2,"l":9,"g":[["كُ","V","stem","PERF|1P"],["نَّا","PRON","suffix","PRON:1P"]]},{"i":"23:17:8","a":"عَنِ","t":"of","p":"P","tr":"ʿani","l":21},{"i":"23:17:9","a":"ٱلْخَلْقِ","t":"the creation","p":"N","tr":"l-khalqi","f":["M","GEN"],"r":34,"l":229,"g":[["ٱلْ","DET","prefix","Al"],["خَلْقِ","N","stem","M|GEN"]]},{"i":"23:17:10","a":"غَـٰفِلِينَ","t":"unaware","p":"N","tr":"ghāfilīna","f":["ACT","PCPL","MP","ACC"],"r":264,"l":399},{"e":"١٧","v":"23:17"}]}],"verses":[{"k":"23:1","t":"Certainly will the believers have succeeded:","j":18,"h":35,"s":23,"a":1,"sd":null},{"k":"23:2","t":"They who are during their prayer humbly intent","j":18,"h":35,"s":23,"a":2,"sd":null},{"k":"23:3","t":"And they who turn away from ill speech","j":18,"h":35,"s":23,"a":3,"sd":null},{"k":"23:4","t":"And they who are observant of zakāh","j":18,"h":35,"s":23,"a":4,"sd":null},{"k":"23:5","t":"And they who guard their private parts","j":18,"h":35,"s":23,"a":5,"sd":null},{"k":"23:6","t":"Except from their wives or those their right hands possess, for indeed, they will not be blamed -","j":18,"h":35,"s":23,"a":6,"sd":null},{"k":"23:7","t":"But whoever seeks beyond that, then those are the transgressors -","j":18,"h":35,"s":23,"a":7,"sd":null},{"k":"23:8","t":"And they who are to their trusts and their promises attentive","j":18,"h":35,"s":23,"a":8,"sd":null},{"k":"23:9","t":"And they who carefully maintain their prayers -","j":18,"h":35,"s":23,"a":9,"sd":null},{"k":"23:10","t":"Those are the inheritors","j":18,"h":35,"s":23,"a":10,"sd":null},{"k":"23:11","t":"Who will inherit al-Firdaus. They will abide therein eternally.","j":18,"h":35,"s":23,"a":11,"sd":null},{"k":"23:12","t":"And certainly did We create man from an extract of clay.","j":18,"h":35,"s":23,"a":12,"sd":null},{"k":"23:13","t":"Then We placed him as a sperm-drop in a firm lodging [i.e., the womb].","j":18,"h":35,"s":23,"a":13,"sd":null},{"k":"23:14","t":"Then We made the sperm-drop into a clinging clot, and We made the clot into a lump [of flesh], and We made [from] the lump, bones, and We covered the bones with flesh; then We developed him into another creation. So blessed is Allāh, the best of creators.","j":18,"h":35,"s":23,"a":14,"sd":null},{"k":"23:15","t":"Then indeed, after that you are to die.","j":18,"h":35,"s":23,"a":15,"sd":null},{"k":"23:16","t":"Then indeed you, on the Day of Resurrection, will be resurrected.","j":18,"h":35,"s":23,"a":16,"sd":null},{"k":"23:17","t":"And We have created above you seven layered heavens, and never have We been of [Our] creation unaware.","j":18,"h":35,"s":23,"a":17,"sd":null}],"juz":18,"hizb":35,"surahs":[23],"sajdah":false}