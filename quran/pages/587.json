hose","p":"DEM","tr":"ulāika","f":["P"],"l":55},{"i":"83:4:4","a":"أَنَّهُم","t":"that they","p":"ACC","tr":"annahum","l":30,"g":[["أَنَّ","ACC","stem",""],["هُم","PRON","suffix","PRON:3MP"]]},{"i":"83:4:5","a":"مَّبْعُوثُونَ","t":"(will be) resurrected","p":"N","tr":"mabʿūthūna","f":["PASS","PCPL","MP","NOM"],"r":162,"l":913},{"e":"٤","v":"83:4"}]}],"verses":[{"k":"82:1","t":"When the sky breaks apart","j":30,"h":59,"s":82,"a":1,"sd":null},{"k":"82:2","t":"And when the stars fall, scattering,","j":30,"h":59,"s":82,"a":2,"sd":null},{"k":"82:3","t":"And when the seas are erupted","j":30,"h":59,"s":82,"a":3,"sd":null},{"k":"82:4","t":"And when the [contents of] graves are scattered [i.e., exposed],","j":30,"h":59,"s":82,"a":4,"sd":null},{"k":"82:5","t":"A soul will [then] know what it has put forth and kept back.","j":30,"h":59,"s":82,"a":5,"sd":null},{"k":"82:6","t":"O mankind, what has deceived you concerning your Lord, the Generous,","j":30,"h":59,"s":82,"a":6,"sd":null},{"k":"82:7","t":"Who created you, proportioned you, and balanced you?","j":30,"h":59,"s":82,"a":7,"sd":null},{"k":"82:8","t":"In whatever form He willed has He assembled you.","j":30,"h":59,"s":82,"a":8,"sd":null},{"k":"82:9","t":"No! But you deny the Recompense.","j":30,"h":59,"s":82,"a":9,"sd":null},{"k":"82:10","t":"And indeed, [appointed] over you are keepers,","j":30,"h":59,"s":82,"a":10,"sd":null},{"k":"82:11","t":"Noble and recording;","j":30,"h":59,"s":82,"a":11,"sd":null},{"k":"82:12","t":"They know whatever you do.","j":30,"h":59,"s":82,"a":12,"sd":null},{"k":"82:13","t":"Indeed, the righteous will be in pleasure,","j":30,"h":59,"s":82,"a":13,"sd":null},{"k":"82:14","t":"And indeed, the wicked will be in Hellfire.","j":30,"h":59,"s":82,"a":14,"sd":null},{"k":"82:15","t":"They will [enter to] burn therein on the Day of Recompense,","j":30,"h":59,"s":82,"a":15,"sd":null},{"k":"82:16","t":"And never therefrom will they be absent.","j":30,"h":59,"s":82,"a":16,"sd":null},{"k":"82:17","t":"And what can make you know what is the Day of Recompense?","j":30,"h":59,"s":82,"a":17,"sd":null},{"k":"82:18","t":"Then, what can make you know what is the Day of Recompense?","j":30,"h":59,"s":82,"a":18,"sd":null},{"k":"82:19","t":"It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allāh.","j":30,"h":59,"s":82,"a":19,"sd":null},{"k":"83:1","t":"Woe to those who give less [than due],","j":30,"h":59,"s":83,"a":1,"sd":null},{"k":"83:2","t":"Who, when they take a measure from people, take in full.","j":30,"h":59,"s":83,"a":2,"sd":null},{"k":"83:3","t":"But if they give by measure or by weight to them, they cause loss.","j":30,"h":59,"s":83,"a":3,"sd":null},{"k":"83:4","t":"Do they not think that they will be resurrected","j":30,"h":59,"s":83,"a":4,"sd":null}],"juz":30,"hizb":59,"surahs":[82,83],"sajdah":false}