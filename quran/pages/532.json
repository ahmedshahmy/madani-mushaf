J","prefix","w:CONJ"],["ٱلْ","DET","prefix","Al"],["أَقْدَامِ","N","stem","MP|GEN"]]},{"e":"٤١","v":"55:41"}]}],"verses":[{"k":"55:19","t":"He released the two seas, meeting [one another];","j":27,"h":54,"s":55,"a":19,"sd":null},{"k":"55:20","t":"Between them is a barrier so neither of them transgresses.","j":27,"h":54,"s":55,"a":20,"sd":null},{"k":"55:21","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":21,"sd":null},{"k":"55:22","t":"From both of them emerge pearl and coral.","j":27,"h":54,"s":55,"a":22,"sd":null},{"k":"55:23","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":23,"sd":null},{"k":"55:24","t":"And to Him belong the ships [with sails] elevated in the sea like mountains.","j":27,"h":54,"s":55,"a":24,"sd":null},{"k":"55:25","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":25,"sd":null},{"k":"55:26","t":"Everyone upon it [i.e., the earth] will perish,","j":27,"h":54,"s":55,"a":26,"sd":null},{"k":"55:27","t":"And there will remain the Face of your Lord, Owner of Majesty and Honor.","j":27,"h":54,"s":55,"a":27,"sd":null},{"k":"55:28","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":28,"sd":null},{"k":"55:29","t":"Whoever is within the heavens and earth asks Him; every day He is in [i.e., bringing about] a matter.","j":27,"h":54,"s":55,"a":29,"sd":null},{"k":"55:30","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":30,"sd":null},{"k":"55:31","t":"We will attend to you, O prominent beings.","j":27,"h":54,"s":55,"a":31,"sd":null},{"k":"55:32","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":32,"sd":null},{"k":"55:33","t":"O company of jinn and mankind, if you are able to pass beyond the regions of the heavens and the earth, then pass. You will not pass except by authority [from Allāh].","j":27,"h":54,"s":55,"a":33,"sd":null},{"k":"55:34","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":34,"sd":null},{"k":"55:35","t":"There will be sent upon you a flame of fire and smoke, and you will not defend yourselves.","j":27,"h":54,"s":55,"a":35,"sd":null},{"k":"55:36","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":36,"sd":null},{"k":"55:37","t":"And when the heaven is split open and becomes rose-colored like oil -","j":27,"h":54,"s":55,"a":37,"sd":null},{"k":"55:38","t":"So which of the favors of your Lord would you deny? -","j":27,"h":54,"s":55,"a":38,"sd":null},{"k":"55:39","t":"Then on that Day none will be asked about his sin among men or jinn.","j":27,"h":54,"s":55,"a":39,"sd":null},{"k":"55:40","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":40,"sd":null},{"k":"55:41","t":"The criminals will be known by their marks, and they will be seized by the forelocks and the feet.","j":27,"h":54,"s":55,"a":41,"sd":null}],"juz":27,"hizb":54,"surahs":[55],"sajdah":false}