V","(IV)","2MP"],"r":83,"l":163,"g":[["وَ","CONJ","prefix","w:CONJ"],["أَطِيعُ","V","stem","IMPV|(IV)|2MP"],["وا","PRON","suffix","PRON:2MP"]]},{"i":"3:132:2","a":"ٱللَّهَ","t":"Allah","p":"PN","tr":"l-laha","f":["ACC"],"r":0,"l":1},{"i":"3:132:3","a":"وَٱلرَّسُولَ","t":"and the Messenger","p":"N","tr":"wal-rasūla","f":["M","ACC"],"r":11,"l":35,"g":[["وَ","CONJ","prefix","w:CONJ"],["ٱل","DET","prefix","Al"],["رَّسُولَ","N","stem","M|ACC"]]},{"i":"3:132:4","a":"لَعَلَّكُمْ","t":"so that you may","p":"ACC","tr":"laʿallakum","l":96,"g":[["لَعَلَّ","ACC","stem",""],["كُمْ","PRON","suffix","PRON:2MP"]]},{"i":"3:132:5","a":"تُرْحَمُونَ","t":"receive mercy","p":"V","tr":"tur'ḥamūna","f":["IMPF","PASS","2MP"],"r":20,"l":392,"g":[["تُرْحَمُ","V","stem","IMPF|PASS|2MP"],["ونَ","PRON","suffix","PRON:2MP"]]},{"e":"١٣٢","v":"3:132"}]}],"verses":[{"k":"3:122","t":"When two parties among you were about to lose courage, but Allāh was their ally; and upon Allāh the believers should rely.","j":4,"h":7,"s":3,"a":122,"sd":null},{"k":"3:123","t":"And already had Allāh given you victory at [the battle of] Badr while you were weak [i.e., few in number]. Then fear Allāh; perhaps you will be grateful.","j":4,"h":7,"s":3,"a":123,"sd":null},{"k":"3:124","t":"[Remember] when you said to the believers, \"Is it not sufficient for you that your Lord should reinforce you with three thousand angels sent down?","j":4,"h":7,"s":3,"a":124,"sd":null},{"k":"3:125","t":"Yes, if you remain patient and conscious of Allāh and they [i.e., the enemy] come upon you [attacking] in rage, your Lord will reinforce you with five thousand angels having marks [of distinction].\"","j":4,"h":7,"s":3,"a":125,"sd":null},{"k":"3:126","t":"And Allāh made it not except as [a sign of] good tidings for you and to reassure your hearts thereby. And victory is not except from Allāh, the Exalted in Might, the Wise -","j":4,"h":7,"s":3,"a":126,"sd":null},{"k":"3:127","t":"That He might cut down a section of the disbelievers or suppress them so that they turn back disappointed.","j":4,"h":7,"s":3,"a":127,"sd":null},{"k":"3:128","t":"Not for you, [O Muḥammad, but for Allāh], is the decision whether He should [cut them down] or forgive them or punish them, for indeed, they are wrongdoers.","j":4,"h":7,"s":3,"a":128,"sd":null},{"k":"3:129","t":"And to Allāh belongs whatever is in the heavens and whatever is on the earth. He forgives whom He wills and punishes whom He wills. And Allāh is Forgiving and Merciful.","j":4,"h":7,"s":3,"a":129,"sd":null},{"k":"3:130","t":"O you who have believed, do not consume usury, doubled and multiplied, but fear Allāh that you may be successful.","j":4,"h":7,"s":3,"a":130,"sd":null},{"k":"3:131","t":"And fear the Fire, which has been prepared for the disbelievers.","j":4,"h":7,"s":3,"a":131,"sd":null},{"k":"3:132","t":"And obey Allāh and the Messenger that you may obtain mercy.","j":4,"h":7,"s":3,"a":132,"sd":null}],"juz":4,"hizb":7,"surahs":[3],"sajdah":false}