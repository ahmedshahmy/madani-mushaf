"i":"79:46:1","a":"كَأَنَّهُمْ","t":"As though they","p":"ACC","tr":"ka-annahum","l":375,"g":[["كَأَنَّ","ACC","stem",""],["هُمْ","PRON","suffix","PRON:3MP"]]},{"i":"79:46:2","a":"يَوْمَ","t":"(the) Day","p":"T","tr":"yawma","f":["M","ACC"],"r":13,"l":25},{"i":"79:46:3","a":"يَرَوْنَهَا","t":"they see it","p":"V","tr":"yarawnahā","f":["IMPF","3MP"],"r":21,"l":46,"g":[["يَرَ","V","stem","IMPF|3MP"],["وْنَ","PRON","suffix","PRON:3MP"],["هَا","PRON","suffix","PRON:3FS"]]},{"i":"79:46:4","a":"لَمْ","t":"not","p":"NEG","tr":"lam","l":32},{"i":"79:46:5","a":"يَلْبَثُوٓا۟","t":"they had remained","p":"V","tr":"yalbathū","f":["IMPF","3MP","MOOD:JUS"],"r":297,"l":364,"g":[["يَلْبَثُ","V","stem","IMPF|3MP|MOOD:JUS"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"79:46:6","a":"إِلَّا","t":"except","p":"RES","tr":"illā","l":15},{"i":"79:46:7","a":"عَشِيَّةً","t":"an evening","p":"N","tr":"ʿashiyyatan","f":["F","INDEF","ACC"],"r":469,"l":3087},{"i":"79:46:8","a":"أَوْ","t":"or","p":"CONJ","tr":"aw","l":42},{"i":"79:46:9","a":"ضُحَىٰهَا","t":"a morning thereof","p":"N","tr":"ḍuḥāhā","f":["M","ACC"],"r":660,"l":1148,"g":[["ضُحَ","N","stem","M|ACC"],["ىٰ","PRON","suffix","PRON:3FS"]]},{"e":"٤٦","v":"79:46"}]},{"l":15,"t":"s","s":80}],"verses":[{"k":"79:17","t":"\"Go to Pharaoh. Indeed, he has transgressed.","j":30,"h":59,"s":79,"a":17,"sd":null},{"k":"79:18","t":"And say to him, 'Would you [be willing to] purify yourself","j":30,"h":59,"s":79,"a":18,"sd":null},{"k":"79:19","t":"And let me guide you to your Lord so you would fear [Him]?'\"","j":30,"h":59,"s":79,"a":19,"sd":null},{"k":"79:20","t":"And he showed him the greatest sign,","j":30,"h":59,"s":79,"a":20,"sd":null},{"k":"79:21","t":"But he [i.e., Pharaoh] denied and disobeyed.","j":30,"h":59,"s":79,"a":21,"sd":null},{"k":"79:22","t":"Then he turned his back, striving [i.e., plotting].","j":30,"h":59,"s":79,"a":22,"sd":null},{"k":"79:23","t":"And he gathered [his people] and called out.","j":30,"h":59,"s":79,"a":23,"sd":null},{"k":"79:24","t":"And said, \"I am your most exalted lord.\"","j":30,"h":59,"s":79,"a":24,"sd":null},{"k":"79:25","t":"So Allāh seized him in exemplary punishment for the last and the first [transgression]..","j":30,"h":59,"s":79,"a":25,"sd":null},{"k":"79:26","t":"Indeed in that is a lesson [i.e., warning] for whoever would fear [Allāh].","j":30,"h":59,"s":79,"a":26,"sd":null},{"k":"79:27","t":"Are you a more difficult creation or is the heaven? He [i.e., Allāh] constructed it.","j":30,"h":59,"s":79,"a":27,"sd":null},{"k":"79:28","t":"He raised its ceiling and proportioned it.","j":30,"h":59,"s":79,"a":28,"sd":null},{"k":"79:29","t":"And He darkened its night and extracted its brightness.","j":30,"h":59,"s":79,"a":29,"sd":null},{"k":"79:30","t":"And after that He spread the earth.","j":30,"h":59,"s":79,"a":30,"sd":null},{"k":"79:31","t":"He extracted from it its water and its pasture,","j":30,"h":59,"s":79,"a":31,"sd":null},{"k":"79:32","t":"And the mountains He set firmly","j":30,"h":59,"s":79,"a":32,"sd":null},{"k":"79:33","t":"As enjoyment [i.e., provision] for you and your grazing livestock.","j":30,"h":59,"s":79,"a":33,"sd":null},{"k":"79:34","t":"But when there comes the greatest Overwhelming Calamity -","j":30,"h":59,"s":79,"a":34,"sd":null},{"k":"79:35","t":"The Day when man will remember that for which he strove,","j":30,"h":59,"s":79,"a":35,"sd":null},{"k":"79:36","t":"And Hellfire will be exposed for [all] those who see -","j":30,"h":59,"s":79,"a":36,"sd":null},{"k":"79:37","t":"So as for he who transgressed","j":30,"h":59,"s":79,"a":37,"sd":null},{"k":"79:38","t":"And preferred the life of the world,","j":30,"h":59,"s":79,"a":38,"sd":null},{"k":"79:39","t":"Then indeed, Hellfire will be [his] refuge.","j":30,"h":59,"s":79,"a":39,"sd":null},{"k":"79:40","t":"But as for he who feared the position of his Lord and prevented the soul from [unlawful] inclination,","j":30,"h":59,"s":79,"a":40,"sd":null},{"k":"79:41","t":"Then indeed, Paradise will be [his] refuge.","j":30,"h":59,"s":79,"a":41,"sd":null},{"k":"79:42","t":"They ask you, [O Muḥammad], about the Hour: when is its arrival?","j":30,"h":59,"s":79,"a":42,"sd":null},{"k":"79:43","t":"In what [position] are you that you should mention it?","j":30,"h":59,"s":79,"a":43,"sd":null},{"k":"79:44","t":"To your Lord is its finality.","j":30,"h":59,"s":79,"a":44,"sd":null},{"k":"79:45","t":"You are only a warner for those who fear it.","j":30,"h":59,"s":79,"a":45,"sd":null},{"k":"79:46","t":"It will be, on the Day they see it, as though they had not remained [in the world] except for an afternoon or a morning thereof.","j":30,"h":59,"s":79,"a":46,"sd":null}],"juz":30,"hizb":59,"surahs":[79],"sajdah":false}