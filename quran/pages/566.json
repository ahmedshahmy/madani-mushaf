a":"فَهَلْ","t":"Then do","p":"INTG","tr":"fahal","l":115,"g":[["فَ","REM","prefix","f:REM"],["هَلْ","INTG","stem",""]]},{"i":"69:8:2","a":"تَرَىٰ","t":"you see","p":"V","tr":"tarā","f":["IMPF","2MS"],"r":21,"l":46},{"i":"69:8:3","a":"لَهُم","t":"of them","p":"PRON","tr":"lahum","f":["3MP"],"l":11,"g":[["لَ","P","prefix","l:P"],["هُم","PRON","stem","3MP"]]},{"i":"69:8:4","a":"مِّنۢ","t":"any","p":"P","tr":"min","l":0},{"i":"69:8:5","a":"بَاقِيَةٍۢ","t":"remains","p":"N","tr":"bāqiyatin","f":["ACT","PCPL","F","INDEF","GEN"],"r":391,"l":2320},{"e":"٨","v":"69:8"}]}],"verses":[{"k":"68:43","t":"Their eyes humbled, humiliation will cover them. And they used to be invited to prostration while they were sound.","j":29,"h":57,"s":68,"a":43,"sd":null},{"k":"68:44","t":"So leave Me, [O Muḥammad], with [the matter of] whoever denies this statement [i.e., the Qur’ān]. We will progressively lead them [to punishment] from where they do not know.","j":29,"h":57,"s":68,"a":44,"sd":null},{"k":"68:45","t":"And I will give them time. Indeed, My plan is firm.","j":29,"h":57,"s":68,"a":45,"sd":null},{"k":"68:46","t":"Or do you ask of them a payment, so they are by debt burdened down?","j":29,"h":57,"s":68,"a":46,"sd":null},{"k":"68:47","t":"Or have they [knowledge of] the unseen, so they write [it] down?","j":29,"h":57,"s":68,"a":47,"sd":null},{"k":"68:48","t":"Then be patient for the decision of your Lord, [O Muḥammad], and be not like the companion of the fish [i.e., Jonah] when he called out while he was distressed.","j":29,"h":57,"s":68,"a":48,"sd":null},{"k":"68:49","t":"If not that a favor [i.e., mercy] from his Lord overtook him, he would have been thrown onto the naked shore while he was censured.","j":29,"h":57,"s":68,"a":49,"sd":null},{"k":"68:50","t":"And his Lord chose him and made him of the righteous.","j":29,"h":57,"s":68,"a":50,"sd":null},{"k":"68:51","t":"And indeed, those who disbelieve would almost make you slip with their eyes [i.e., looks] when they hear the message, and they say, \"Indeed, he is mad.\"","j":29,"h":57,"s":68,"a":51,"sd":null},{"k":"68:52","t":"But it is not except a reminder to the worlds.","j":29,"h":57,"s":68,"a":52,"sd":null},{"k":"69:1","t":"The Inevitable Reality -","j":29,"h":57,"s":69,"a":1,"sd":null},{"k":"69:2","t":"What is the Inevitable Reality?","j":29,"h":57,"s":69,"a":2,"sd":null},{"k":"69:3","t":"And what can make you know what is the Inevitable Reality?","j":29,"h":57,"s":69,"a":3,"sd":null},{"k":"69:4","t":"Thamūd and ʿAad denied the Striking Calamity [i.e., the Resurrection].","j":29,"h":57,"s":69,"a":4,"sd":null},{"k":"69:5","t":"So as for Thamūd, they were destroyed by the overpowering [blast].","j":29,"h":57,"s":69,"a":5,"sd":null},{"k":"69:6","t":"And as for ʿAad, they were destroyed by a screaming, violent wind","j":29,"h":57,"s":69,"a":6,"sd":null},{"k":"69:7","t":"Which He [i.e., Allāh] imposed upon them for seven nights and eight days in succession, so you would see the people therein fallen as if they were hollow trunks of palm trees.","j":29,"h":57,"s":69,"a":7,"sd":null},{"k":"69:8","t":"Then do you see of them any remains?","j":29,"h":57,"s":69,"a":8,"sd":null}],"juz":29,"hizb":57,"surahs":[68,69],"sajdah":false}