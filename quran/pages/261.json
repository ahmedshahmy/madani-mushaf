P|GEN"]]},{"i":"14:52:4","a":"وَلِيُنذَرُوا۟","t":"that they may be warned","p":"V","tr":"waliyundharū","f":["IMPF","PASS","(IV)","3MP","MOOD:SUBJ"],"r":82,"l":264,"g":[["وَ","CONJ","prefix","w:CONJ"],["لِ","PRP","prefix","l:PRP"],["يُنذَرُ","V","stem","IMPF|PASS|(IV)|3MP|MOOD:SUBJ"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"14:52:5","a":"بِهِۦ","t":"with it","p":"PRON","tr":"bihi","f":["3MS"],"l":16,"g":[["بِ","P","prefix","bi"],["هِۦ","PRON","stem","3MS"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"14:52:6","a":"وَلِيَعْلَمُوٓا۟","t":"and that they may know","p":"V","tr":"waliyaʿlamū","f":["IMPF","3MP","MOOD:SUBJ"],"r":5,"l":29,"g":[["وَ","CONJ","prefix","w:CONJ"],["لِ","PRP","prefix","l:PRP"],["يَعْلَمُ","V","stem","IMPF|3MP|MOOD:SUBJ"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"14:52:7","a":"أَنَّمَا","t":"that only","p":"ACC","tr":"annamā","l":30,"g":[["أَنَّ","ACC","stem",""],["مَا","PREV","stem",""]]},{"i":"14:52:8","a":"هُوَ","t":"He","p":"PRON","tr":"huwa","f":["3MS"],"l":20},{"i":"14:52:9","a":"إِلَـٰهٌۭ","t":"(is) One God","p":"N","tr":"ilāhun","f":["MS","INDEF","NOM"],"r":0,"l":74},{"i":"14:52:10","a":"وَٰحِدٌۭ","t":"(is) One God","p":"ADJ","tr":"wāḥidun","f":["MS","INDEF","NOM"],"r":161,"l":368},{"i":"14:52:11","a":"وَلِيَذَّكَّرَ","t":"and that may take heed","p":"V","tr":"waliyadhakkara","f":["IMPF","(V)","3MS","MOOD:SUBJ"],"r":28,"l":233,"g":[["وَ","CONJ","prefix","w:CONJ"],["لِ","PRP","prefix","l:PRP"],["يَذَّكَّرَ","V","stem","IMPF|(V)|3MS|MOOD:SUBJ"]]},{"i":"14:52:12","a":"أُو۟لُوا۟","t":"men","p":"N","tr":"ulū","f":["MP","NOM"],"r":58,"l":257},{"i":"14:52:13","a":"ٱلْأَلْبَـٰبِ","t":"(of) understanding","p":"N","tr":"l-albābi","f":["MP","GEN"],"r":453,"l":586,"g":[["ٱلْ","DET","prefix","Al"],["ْأَلْ","N","stem","MP|GEN"]]},{"e":"٥٢","v":"14:52"}]}],"verses":[{"k":"14:43","t":"Racing ahead, their heads raised up, their glance does not come back to them, and their hearts are void.","j":13,"h":26,"s":14,"a":43,"sd":null},{"k":"14:44","t":"And, [O Muḥammad], warn the people of a Day when the punishment will come to them and those who did wrong will say, \"Our Lord, delay us for a short term; we will answer Your call and follow the messengers.\" [But it will be said], \"Had you not sworn, before, that for you there would be no cessation?","j":13,"h":26,"s":14,"a":44,"sd":null},{"k":"14:45","t":"And you lived among the dwellings of those who wronged themselves, and it had become clear to you how We dealt with them. And We presented for you [many] examples.\"","j":13,"h":26,"s":14,"a":45,"sd":null},{"k":"14:46","t":"And they had planned their plan, but with Allāh is [recorded] their plan, even if their plan had been [sufficient] to do away with the mountains.","j":13,"h":26,"s":14,"a":46,"sd":null},{"k":"14:47","t":"So never think that Allāh will fail in His promise to His messengers. Indeed, Allāh is Exalted in Might and Owner of Retribution.","j":13,"h":26,"s":14,"a":47,"sd":null},{"k":"14:48","t":"[It will be] on the Day the earth will be replaced by another earth, and the heavens [as well], and they [i.e., all creatures] will come out before Allāh, the One, the Prevailing,","j":13,"h":26,"s":14,"a":48,"sd":null},{"k":"14:49","t":"And you will see the criminals that Day bound together in irons,","j":13,"h":26,"s":14,"a":49,"sd":null},{"k":"14:50","t":"Their garments of liquid pitch and their faces covered by the Fire","j":13,"h":26,"s":14,"a":50,"sd":null},{"k":"14:51","t":"So that Allāh will recompense every soul for what it earned. Indeed, Allāh is swift in account.","j":13,"h":26,"s":14,"a":51,"sd":null},{"k":"14:52","t":"This [Qur’ān] is notification for the people that they may be warned thereby and that they may know that He is but one God and that those of understanding will be reminded.","j":13,"h":26,"s":14,"a":52,"sd":null}],"juz":13,"hizb":26,"surahs":[14],"sajdah":false}