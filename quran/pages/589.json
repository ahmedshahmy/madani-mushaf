"IMPF|(IV)|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"e":"٢٠","v":"84:20"},{"i":"84:21:1","a":"وَإِذَا","t":"And when","p":"T","tr":"wa-idhā","l":23,"g":[["وَ","CONJ","prefix","w:CONJ"],["إِذَا","T","stem",""]]},{"i":"84:21:2","a":"قُرِئَ","t":"is recited","p":"V","tr":"quri-a","f":["PERF","PASS","3MS"],"r":126,"l":601}]},{"l":14,"t":"a","c":0,"w":[{"i":"84:21:3","a":"عَلَيْهِمُ","t":"to them","p":"P","tr":"ʿalayhimu","l":8,"g":[["عَلَيْ","P","stem",""],["هِمُ","PRON","suffix","PRON:3MP"]]},{"i":"84:21:4","a":"ٱلْقُرْءَانُ","t":"the Quran","p":"PN","tr":"l-qur'ānu","f":["M","NOM"],"r":126,"l":175,"g":[["ٱلْ","DET","prefix","Al"],["قُرْءَانُ","PN","stem","M|NOM"]]},{"i":"84:21:5","a":"لَا","t":"not","p":"NEG","tr":"lā","l":4},{"i":"84:21:6","a":"يَسْجُدُونَ ۩","t":"they prostrate","p":"V","tr":"yasjudūna","f":["IMPF","3MP"],"r":123,"l":334,"g":[["يَسْجُدُ","V","stem","IMPF|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"e":"٢١","v":"84:21"},{"i":"84:22:1","a":"بَلِ","t":"Nay","p":"RET","tr":"bali","l":93},{"i":"84:22:2","a":"ٱلَّذِينَ","t":"Those who","p":"REL","tr":"alladhīna","f":["MP"],"l":7},{"i":"84:22:3","a":"كَفَرُوا۟","t":"disbelieved","p":"V","tr":"kafarū","f":["PERF","3MP"],"r":8,"l":40,"g":[["كَفَرُ","V","stem","PERF|3MP"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"84:22:4","a":"يُكَذِّبُونَ","t":"deny","p":"V","tr":"yukadhibūna","f":["IMPF","(II)","3MP"],"r":30,"l":63,"g":[["يُكَذِّبُ","V","stem","IMPF|(II)|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"e":"٢٢","v":"84:22"}]},{"l":15,"t":"a","c":0,"w":[{"i":"84:23:1","a":"وَٱللَّهُ","t":"And Allah","p":"PN","tr":"wal-lahu","f":["NOM"],"r":0,"l":1,"g":[["وَ","REM","prefix","w:REM"],["ٱللَّهُ","PN","stem","NOM"]]},{"i":"84:23:2","a":"أَعْلَمُ","t":"(is) most knowing","p":"N","tr":"aʿlamu","f":["MS","NOM"],"r":5,"l":240},{"i":"84:23:3","a":"بِمَا","t":"of what","p":"REL","tr":"bimā","l":2,"g":[["بِ","P","prefix","bi"],["مَا","REL","stem",""]]},{"i":"84:23:4","a":"يُوعُونَ","t":"they keep within themselves","p":"V","tr":"yūʿūna","f":["IMPF","(IV)","3MP"],"r":687,"l":2199,"g":[["يُوعُ","V","stem","IMPF|(IV)|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"e":"٢٣","v":"84:23"},{"i":"84:24:1","a":"فَبَشِّرْهُم","t":"so give them tidings","p":"V","tr":"fabashir'hum","f":["IMPV","(II)","2MS"],"r":92,"l":307,"g":[["فَ","CAUS","prefix","f:CAUS"],["بَشِّرْ","V","stem","IMPV|(II)|2MS"],["هُم","PRON","suffix","PRON:3MP"]]},{"i":"84:24:2","a":"بِعَذَابٍ","t":"of a punishment","p":"N","tr":"biʿadhābin","f":["M","INDEF","GEN"],"r":17,"l":36,"g":[["بِ","P","prefix","bi"],["عَذَابٍ","N","stem","M|INDEF|GEN"]]},{"i":"84:24:3","a":"أَلِيمٍ","t":"painful","p":"ADJ","tr":"alīmin","f":["MS","INDEF","GEN"],"r":144,"l":164},{"e":"٢٤","v":"84:24"}]}],"verses":[{"k":"83:34","t":"So Today those who believed are laughing at the disbelievers,","j":30,"h":59,"s":83,"a":34,"sd":null},{"k":"83:35","t":"On adorned couches, observing.","j":30,"h":59,"s":83,"a":35,"sd":null},{"k":"83:36","t":"Have the disbelievers [not] been rewarded [this Day] for what they used to do?","j":30,"h":59,"s":83,"a":36,"sd":null},{"k":"84:1","t":"When the sky has split [open]","j":30,"h":59,"s":84,"a":1,"sd":null},{"k":"84:2","t":"And has listened [i.e., responded] to its Lord and was obligated [to do so]","j":30,"h":59,"s":84,"a":2,"sd":null},{"k":"84:3","t":"And when the earth has been extended","j":30,"h":59,"s":84,"a":3,"sd":null},{"k":"84:4","t":"And has cast out that within it and relinquished [it].","j":30,"h":59,"s":84,"a":4,"sd":null},{"k":"84:5","t":"And has listened [i.e., responded] to its Lord and was obligated [to do so] -","j":30,"h":59,"s":84,"a":5,"sd":null},{"k":"84:6","t":"O mankind, indeed you are laboring toward your Lord with [great] exertion and will meet it.","j":30,"h":59,"s":84,"a":6,"sd":null},{"k":"84:7","t":"Then as for he who is given his record in his right hand,","j":30,"h":59,"s":84,"a":7,"sd":null},{"k":"84:8","t":"He will be judged with an easy account","j":30,"h":59,"s":84,"a":8,"sd":null},{"k":"84:9","t":"And return to his people in happiness.","j":30,"h":59,"s":84,"a":9,"sd":null},{"k":"84:10","t":"But as for he who is given his record behind his back,","j":30,"h":59,"s":84,"a":10,"sd":null},{"k":"84:11","t":"He will cry out for destruction","j":30,"h":59,"s":84,"a":11,"sd":null},{"k":"84:12","t":"And [enter to] burn in a Blaze.","j":30,"h":59,"s":84,"a":12,"sd":null},{"k":"84:13","t":"Indeed, he had [once] been among his people in happiness;","j":30,"h":59,"s":84,"a":13,"sd":null},{"k":"84:14","t":"Indeed, he had thought he would never return [to Allāh].","j":30,"h":59,"s":84,"a":14,"sd":null},{"k":"84:15","t":"But yes! Indeed, his Lord was ever, of him, Seeing.","j":30,"h":59,"s":84,"a":15,"sd":null},{"k":"84:16","t":"So I swear by the twilight glow","j":30,"h":59,"s":84,"a":16,"sd":null},{"k":"84:17","t":"And [by] the night and what it envelops","j":30,"h":59,"s":84,"a":17,"sd":null},{"k":"84:18","t":"And [by] the moon when it becomes full","j":30,"h":59,"s":84,"a":18,"sd":null},{"k":"84:19","t":"[That] you will surely embark upon [i.e., experience] state after state.","j":30,"h":59,"s":84,"a":19,"sd":null},{"k":"84:20","t":"So what is [the matter] with them [that] they do not believe,","j":30,"h":59,"s":84,"a":20,"sd":null},{"k":"84:21","t":"And when the Qur’ān is recited to them, they do not prostrate [to Allāh]?","j":30,"h":59,"s":84,"a":21,"sd":13},{"k":"84:22","t":"But those who have disbelieved deny,","j":30,"h":59,"s":84,"a":22,"sd":null},{"k":"84:23","t":"And Allāh is most knowing of what they keep within themselves.","j":30,"h":59,"s":84,"a":23,"sd":null},{"k":"84:24","t":"So give them tidings of a painful punishment,","j":30,"h":59,"s":84,"a":24,"sd":null}],"juz":30,"hizb":59,"surahs":[83,84],"sajdah":true}