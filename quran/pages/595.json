","v":"92:7"},{"i":"92:8:1","a":"وَأَمَّا","t":"But as for","p":"EXL","tr":"wa-ammā","l":217,"g":[["وَ","CONJ","prefix","w:CONJ"],["أَمَّا","EXL","stem",""]]},{"i":"92:8:2","a":"مَنۢ","t":"(him) who","p":"COND","tr":"man","l":12},{"i":"92:8:3","a":"بَخِلَ","t":"withholds","p":"V","tr":"bakhila","f":["PERF","3MS"],"r":520,"l":831},{"i":"92:8:4","a":"وَٱسْتَغْنَىٰ","t":"and considers himself free from need","p":"V","tr":"wa-is'taghnā","f":["PERF","(X)","3MS"],"r":149,"l":1701,"g":[["وَ","CONJ","prefix","w:CONJ"],["َٱسْتَغْ","V","stem","PERF|(X)|3MS"]]},{"e":"٨","v":"92:8"},{"i":"92:9:1","a":"وَكَذَّبَ","t":"And denies","p":"V","tr":"wakadhaba","f":["PERF","(II)","3MS"],"r":30,"l":63,"g":[["وَ","CONJ","prefix","w:CONJ"],["كَذَّبَ","V","stem","PERF|(II)|3MS"]]},{"i":"92:9:2","a":"بِٱلْحُسْنَىٰ","t":"the best","p":"N","tr":"bil-ḥus'nā","f":["FS","GEN"],"r":48,"l":568,"g":[["بِ","P","prefix","bi"],["ِٱ","DET","prefix","Al"],["لْحُسْ","N","stem","FS|GEN"]]},{"e":"٩","v":"92:9"}]}],"verses":[{"k":"90:19","t":"But they who disbelieved in Our signs - those are the companions of the left.","j":30,"h":60,"s":90,"a":19,"sd":null},{"k":"90:20","t":"Over them will be fire closed in.","j":30,"h":60,"s":90,"a":20,"sd":null},{"k":"91:1","t":"By the sun and its brightness","j":30,"h":60,"s":91,"a":1,"sd":null},{"k":"91:2","t":"And [by] the moon when it follows it","j":30,"h":60,"s":91,"a":2,"sd":null},{"k":"91:3","t":"And [by] the day when it displays it","j":30,"h":60,"s":91,"a":3,"sd":null},{"k":"91:4","t":"And [by] the night when it covers [i.e., conceals] it","j":30,"h":60,"s":91,"a":4,"sd":null},{"k":"91:5","t":"And [by] the sky and He who constructed it","j":30,"h":60,"s":91,"a":5,"sd":null},{"k":"91:6","t":"And [by] the earth and He who spread it","j":30,"h":60,"s":91,"a":6,"sd":null},{"k":"91:7","t":"And [by] the soul and He who proportioned it","j":30,"h":60,"s":91,"a":7,"sd":null},{"k":"91:8","t":"And inspired it [with discernment of] its wickedness and its righteousness,","j":30,"h":60,"s":91,"a":8,"sd":null},{"k":"91:9","t":"He has succeeded who purifies it,","j":30,"h":60,"s":91,"a":9,"sd":null},{"k":"91:10","t":"And he has failed who instills it [with corruption].","j":30,"h":60,"s":91,"a":10,"sd":null},{"k":"91:11","t":"Thamūd denied [their prophet] by reason of their transgression,","j":30,"h":60,"s":91,"a":11,"sd":null},{"k":"91:12","t":"When the most wretched of them was sent forth.","j":30,"h":60,"s":91,"a":12,"sd":null},{"k":"91:13","t":"And the messenger of Allāh [i.e., Ṣāliḥ] said to them, \"[Do not harm] the she-camel of Allāh or [prevent her from] her drink.\"","j":30,"h":60,"s":91,"a":13,"sd":null},{"k":"91:14","t":"But they denied him and hamstrung her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].","j":30,"h":60,"s":91,"a":14,"sd":null},{"k":"91:15","t":"And He does not fear the consequence thereof.","j":30,"h":60,"s":91,"a":15,"sd":null},{"k":"92:1","t":"By the night when it covers","j":30,"h":60,"s":92,"a":1,"sd":null},{"k":"92:2","t":"And [by] the day when it appears","j":30,"h":60,"s":92,"a":2,"sd":null},{"k":"92:3","t":"And [by] He who created the male and female,","j":30,"h":60,"s":92,"a":3,"sd":null},{"k":"92:4","t":"Indeed, your efforts are diverse.","j":30,"h":60,"s":92,"a":4,"sd":null},{"k":"92:5","t":"As for he who gives and fears Allāh","j":30,"h":60,"s":92,"a":5,"sd":null},{"k":"92:6","t":"And believes in the best [reward],","j":30,"h":60,"s":92,"a":6,"sd":null},{"k":"92:7","t":"We will ease him toward ease.","j":30,"h":60,"s":92,"a":7,"sd":null},{"k":"92:8","t":"But as for he who withholds and considers himself free of need","j":30,"h":60,"s":92,"a":8,"sd":null},{"k":"92:9","t":"And denies the best [reward],","j":30,"h":60,"s":92,"a":9,"sd":null}],"juz":30,"hizb":60,"surahs":[90,91,92],"sajdah":false}