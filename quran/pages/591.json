:"benefits","p":"V","tr":"nafaʿati","f":["PERF","3FS"],"r":202,"l":358},{"i":"87:9:4","a":"ٱلذِّكْرَىٰ","t":"the reminder","p":"N","tr":"l-dhik'rā","f":["F","NOM"],"r":28,"l":448,"g":[["ٱل","DET","prefix","Al"],["ذِّكْ","N","stem","F|NOM"]]},{"e":"٩","v":"87:9"},{"i":"87:10:1","a":"سَيَذَّكَّرُ","t":"He will pay heed","p":"V","tr":"sayadhakkaru","f":["IMPF","(V)","3MS"],"r":28,"l":233,"g":[["سَ","FUT","prefix","sa"],["يَذَّكَّرُ","V","stem","IMPF|(V)|3MS"]]},{"i":"87:10:2","a":"مَن","t":"(one) who","p":"REL","tr":"man","l":12},{"i":"87:10:3","a":"يَخْشَىٰ","t":"fears (Allah)","p":"V","tr":"yakhshā","f":["IMPF","3MS"],"r":208,"l":294},{"e":"١٠","v":"87:10"}]}],"verses":[{"k":"86:1","t":"By the sky and the night comer","j":30,"h":59,"s":86,"a":1,"sd":null},{"k":"86:2","t":"And what can make you know what is the night comer?","j":30,"h":59,"s":86,"a":2,"sd":null},{"k":"86:3","t":"It is the piercing star","j":30,"h":59,"s":86,"a":3,"sd":null},{"k":"86:4","t":"There is no soul but that it has over it a protector.","j":30,"h":59,"s":86,"a":4,"sd":null},{"k":"86:5","t":"So let man observe from what he was created.","j":30,"h":59,"s":86,"a":5,"sd":null},{"k":"86:6","t":"He was created from a fluid, ejected,","j":30,"h":59,"s":86,"a":6,"sd":null},{"k":"86:7","t":"Emerging from between the backbone and the ribs.","j":30,"h":59,"s":86,"a":7,"sd":null},{"k":"86:8","t":"Indeed, He [i.e., Allāh], to return him [to life], is Able.","j":30,"h":59,"s":86,"a":8,"sd":null},{"k":"86:9","t":"The Day when secrets will be put on trial,","j":30,"h":59,"s":86,"a":9,"sd":null},{"k":"86:10","t":"Then he [i.e., man] will have no power or any helper.","j":30,"h":59,"s":86,"a":10,"sd":null},{"k":"86:11","t":"By the sky which sends back","j":30,"h":59,"s":86,"a":11,"sd":null},{"k":"86:12","t":"And [by] the earth which splits,","j":30,"h":59,"s":86,"a":12,"sd":null},{"k":"86:13","t":"Indeed, it [i.e., the Qur’ān] is a decisive statement,","j":30,"h":59,"s":86,"a":13,"sd":null},{"k":"86:14","t":"And it is not amusement.","j":30,"h":59,"s":86,"a":14,"sd":null},{"k":"86:15","t":"Indeed, they are planning a plan,","j":30,"h":59,"s":86,"a":15,"sd":null},{"k":"86:16","t":"But I am planning a plan.","j":30,"h":59,"s":86,"a":16,"sd":null},{"k":"86:17","t":"So allow time for the disbelievers. Leave them awhile.","j":30,"h":59,"s":86,"a":17,"sd":null},{"k":"87:1","t":"Exalt the name of your Lord, the Most High,","j":30,"h":60,"s":87,"a":1,"sd":null},{"k":"87:2","t":"Who created and proportioned","j":30,"h":60,"s":87,"a":2,"sd":null},{"k":"87:3","t":"And who destined and [then] guided","j":30,"h":60,"s":87,"a":3,"sd":null},{"k":"87:4","t":"And who brings out the pasture","j":30,"h":60,"s":87,"a":4,"sd":null},{"k":"87:5","t":"And [then] makes it black stubble.","j":30,"h":60,"s":87,"a":5,"sd":null},{"k":"87:6","t":"We will make you recite, [O Muḥammad], and you will not forget,","j":30,"h":60,"s":87,"a":6,"sd":null},{"k":"87:7","t":"Except what Allāh should will. Indeed, He knows what is declared and what is hidden.","j":30,"h":60,"s":87,"a":7,"sd":null},{"k":"87:8","t":"And We will ease you toward ease.","j":30,"h":60,"s":87,"a":8,"sd":null},{"k":"87:9","t":"So remind, if the reminder should benefit;","j":30,"h":60,"s":87,"a":9,"sd":null},{"k":"87:10","t":"He who fears [Allāh] will be reminded.","j":30,"h":60,"s":87,"a":10,"sd":null}],"juz":30,"hizb":59,"surahs":[86,87],"sajdah":false}