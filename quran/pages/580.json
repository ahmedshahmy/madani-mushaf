l'mukadhibīna","f":["ACT","PCPL","(II)","MP","GEN"],"r":30,"l":493,"g":[["لِّ","P","prefix","l:P"],["لْ","DET","prefix","Al"],["مُكَذِّبِينَ","N","stem","ACT|PCPL|(II)|MP|GEN"]]},{"e":"١٩","v":"77:19"}]}],"verses":[{"k":"76:26","t":"And during the night prostrate to Him and exalt [i.e., praise] Him a long [part of the] night.","j":29,"h":58,"s":76,"a":26,"sd":null},{"k":"76:27","t":"Indeed, these [disbelievers] love the immediate and leave behind them a grave Day.","j":29,"h":58,"s":76,"a":27,"sd":null},{"k":"76:28","t":"We have created them and strengthened their forms, and when We will, We can change their likenesses with [complete] alteration.","j":29,"h":58,"s":76,"a":28,"sd":null},{"k":"76:29","t":"Indeed, this is a reminder, so he who wills may take to his Lord a way.","j":29,"h":58,"s":76,"a":29,"sd":null},{"k":"76:30","t":"And you do not will except that Allāh wills. Indeed, Allāh is ever Knowing and Wise.","j":29,"h":58,"s":76,"a":30,"sd":null},{"k":"76:31","t":"He admits whom He wills into His mercy; but the wrongdoers - He has prepared for them a painful punishment.","j":29,"h":58,"s":76,"a":31,"sd":null},{"k":"77:1","t":"By those [winds] sent forth in gusts","j":29,"h":58,"s":77,"a":1,"sd":null},{"k":"77:2","t":"And the winds that blow violently","j":29,"h":58,"s":77,"a":2,"sd":null},{"k":"77:3","t":"And [by] the winds that spread [clouds]","j":29,"h":58,"s":77,"a":3,"sd":null},{"k":"77:4","t":"And those [angels] who bring criterion","j":29,"h":58,"s":77,"a":4,"sd":null},{"k":"77:5","t":"And those [angels] who deliver a message.","j":29,"h":58,"s":77,"a":5,"sd":null},{"k":"77:6","t":"As justification or warning,","j":29,"h":58,"s":77,"a":6,"sd":null},{"k":"77:7","t":"Indeed, what you are promised is to occur.","j":29,"h":58,"s":77,"a":7,"sd":null},{"k":"77:8","t":"So when the stars are obliterated","j":29,"h":58,"s":77,"a":8,"sd":null},{"k":"77:9","t":"And when the heaven is opened","j":29,"h":58,"s":77,"a":9,"sd":null},{"k":"77:10","t":"And when the mountains are blown away","j":29,"h":58,"s":77,"a":10,"sd":null},{"k":"77:11","t":"And when the messengers' time has come...","j":29,"h":58,"s":77,"a":11,"sd":null},{"k":"77:12","t":"For what Day was it postponed?","j":29,"h":58,"s":77,"a":12,"sd":null},{"k":"77:13","t":"For the Day of Judgement.","j":29,"h":58,"s":77,"a":13,"sd":null},{"k":"77:14","t":"And what can make you know what is the Day of Judgement?","j":29,"h":58,"s":77,"a":14,"sd":null},{"k":"77:15","t":"Woe, that Day, to the deniers.","j":29,"h":58,"s":77,"a":15,"sd":null},{"k":"77:16","t":"Did We not destroy the former peoples?","j":29,"h":58,"s":77,"a":16,"sd":null},{"k":"77:17","t":"Then We will follow them with the later ones.","j":29,"h":58,"s":77,"a":17,"sd":null},{"k":"77:18","t":"Thus do We deal with the criminals.","j":29,"h":58,"s":77,"a":18,"sd":null},{"k":"77:19","t":"Woe, that Day, to the deniers.","j":29,"h":58,"s":77,"a":19,"sd":null}],"juz":29,"hizb":58,"surahs":[76,77],"sajdah":false}