"N","tr":"khalāifa","f":["MP","ACC"],"r":89,"l":933},{"i":"10:14:4","a":"فِى","t":"in","p":"P","tr":"fī","l":3},{"i":"10:14:5","a":"ٱلْأَرْضِ","t":"the earth","p":"N","tr":"l-arḍi","f":["F","GEN"],"r":12,"l":22,"g":[["ٱلْ","DET","prefix","Al"],["أَرْضِ","N","stem","F|GEN"]]},{"i":"10:14:6","a":"مِنۢ","t":"after them","p":"P","tr":"min","l":0},{"i":"10:14:7","a":"بَعْدِهِمْ","t":"after them","p":"N","tr":"baʿdihim","f":["GEN"],"r":39,"l":58,"g":[["بَعْدِ","N","stem","GEN"],["هِمْ","PRON","suffix","PRON:3MP"]]},{"i":"10:14:8","a":"لِنَنظُرَ","t":"so that We may see","p":"V","tr":"linanẓura","f":["IMPF","1P","MOOD:SUBJ"],"r":85,"l":125,"g":[["لِ","PRP","prefix","l:PRP"],["نَنظُرَ","V","stem","IMPF|1P|MOOD:SUBJ"]]},{"i":"10:14:9","a":"كَيْفَ","t":"how","p":"INTG","tr":"kayfa","r":133,"l":134},{"i":"10:14:10","a":"تَعْمَلُونَ","t":"you do","p":"V","tr":"taʿmalūna","f":["IMPF","2MP"],"r":18,"l":44,"g":[["تَعْمَلُ","V","stem","IMPF|2MP"],["ونَ","PRON","suffix","PRON:2MP"]]},{"e":"١٤","v":"10:14"}]}],"verses":[{"k":"10:7","t":"Indeed, those who do not expect the meeting with Us and are satisfied with the life of this world and feel secure therein and those who are heedless of Our signs -","j":11,"h":21,"s":10,"a":7,"sd":null},{"k":"10:8","t":"For those their refuge will be the Fire because of what they used to earn.","j":11,"h":21,"s":10,"a":8,"sd":null},{"k":"10:9","t":"Indeed, those who have believed and done righteous deeds - their Lord will guide them because of their faith. Beneath them rivers will flow in the Gardens of Pleasure.","j":11,"h":21,"s":10,"a":9,"sd":null},{"k":"10:10","t":"Their call therein will be, \"Exalted are You, O Allāh,\" and their greeting therein will be, \"Peace.\" And the last of their call will be, \"Praise to Allāh, Lord of the worlds!\"","j":11,"h":21,"s":10,"a":10,"sd":null},{"k":"10:11","t":"And if Allāh was to hasten for the people the evil [they invoke] as He hastens for them the good, their term would have been ended for them. But We leave the ones who do not expect the meeting with Us, in their transgression, wandering blindly.","j":11,"h":21,"s":10,"a":11,"sd":null},{"k":"10:12","t":"And when affliction touches man, he calls upon Us, whether lying on his side or sitting or standing; but when We remove from him his affliction, he continues [in disobedience] as if he had never called upon Us to [remove] an affliction that touched him. Thus is made pleasing to the transgressors that which they have been doing.","j":11,"h":21,"s":10,"a":12,"sd":null},{"k":"10:13","t":"And We had already destroyed generations before you when they wronged, and their messengers had come to them with clear proofs, but they were not to believe. Thus do We recompense the criminal people.","j":11,"h":21,"s":10,"a":13,"sd":null},{"k":"10:14","t":"Then We made you successors in the land after them so that We may observe how you will do.","j":11,"h":21,"s":10,"a":14,"sd":null}],"juz":11,"hizb":21,"surahs":[10],"sajdah":false}