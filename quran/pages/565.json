","prefix","Al"],["سُّجُودِ","N","stem","MP|GEN"]]},{"i":"68:42:8","a":"فَلَا","t":"but not","p":"NEG","tr":"falā","l":4,"g":[["فَ","REM","prefix","f:REM"],["لَا","NEG","stem",""]]},{"i":"68:42:9","a":"يَسْتَطِيعُونَ","t":"they will be able","p":"V","tr":"yastaṭīʿūna","f":["IMPF","(X)","3MP"],"r":83,"l":279,"g":[["يَسْتَطِيعُ","V","stem","IMPF|(X)|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"e":"٤٢","v":"68:42"}]}],"verses":[{"k":"68:17","t":"Indeed, We have tried them as We tried the companions of the garden, when they swore to cut its fruit in the [early] morning","j":29,"h":57,"s":68,"a":17,"sd":null},{"k":"68:18","t":"Without making exception.","j":29,"h":57,"s":68,"a":18,"sd":null},{"k":"68:19","t":"So there came upon it [i.e., the garden] an affliction from your Lord while they were asleep.","j":29,"h":57,"s":68,"a":19,"sd":null},{"k":"68:20","t":"And it became as though reaped.","j":29,"h":57,"s":68,"a":20,"sd":null},{"k":"68:21","t":"And they called one another at morning,","j":29,"h":57,"s":68,"a":21,"sd":null},{"k":"68:22","t":"[Saying], \"Go early to your crop if you would cut the fruit.\"","j":29,"h":57,"s":68,"a":22,"sd":null},{"k":"68:23","t":"So they set out, while lowering their voices,","j":29,"h":57,"s":68,"a":23,"sd":null},{"k":"68:24","t":"[Saying], \"There will surely not enter it today upon you [any] poor person.\"","j":29,"h":57,"s":68,"a":24,"sd":null},{"k":"68:25","t":"And they went early in determination, [assuming themselves] able.","j":29,"h":57,"s":68,"a":25,"sd":null},{"k":"68:26","t":"But when they saw it, they said, \"Indeed, we are lost;","j":29,"h":57,"s":68,"a":26,"sd":null},{"k":"68:27","t":"Rather, we have been deprived.\"","j":29,"h":57,"s":68,"a":27,"sd":null},{"k":"68:28","t":"The most moderate of them said, \"Did I not say to you, 'Why do you not exalt [Allāh]?'\"","j":29,"h":57,"s":68,"a":28,"sd":null},{"k":"68:29","t":"They said, \"Exalted is our Lord! Indeed, we were wrongdoers.\"","j":29,"h":57,"s":68,"a":29,"sd":null},{"k":"68:30","t":"Then they approached one another, blaming each other.","j":29,"h":57,"s":68,"a":30,"sd":null},{"k":"68:31","t":"They said, \"O woe to us; indeed we were transgressors.","j":29,"h":57,"s":68,"a":31,"sd":null},{"k":"68:32","t":"Perhaps our Lord will substitute for us [one] better than it. Indeed, we are toward our Lord desirous.\"","j":29,"h":57,"s":68,"a":32,"sd":null},{"k":"68:33","t":"Such is the punishment [of this world]. And the punishment of the Hereafter is greater, if they only knew.","j":29,"h":57,"s":68,"a":33,"sd":null},{"k":"68:34","t":"Indeed, for the righteous with their Lord are the Gardens of Pleasure.","j":29,"h":57,"s":68,"a":34,"sd":null},{"k":"68:35","t":"Then will We treat the Muslims like the criminals?","j":29,"h":57,"s":68,"a":35,"sd":null},{"k":"68:36","t":"What is [the matter] with you? How do you judge?","j":29,"h":57,"s":68,"a":36,"sd":null},{"k":"68:37","t":"Or do you have a scripture in which you learn","j":29,"h":57,"s":68,"a":37,"sd":null},{"k":"68:38","t":"That indeed for you is whatever you choose?","j":29,"h":57,"s":68,"a":38,"sd":null},{"k":"68:39","t":"Or do you have oaths [binding] upon Us, extending until the Day of Resurrection, that indeed for you is whatever you judge?","j":29,"h":57,"s":68,"a":39,"sd":null},{"k":"68:40","t":"Ask them which of them, for that [claim], is responsible.","j":29,"h":57,"s":68,"a":40,"sd":null},{"k":"68:41","t":"Or do they have partners? Then let them bring their partners, if they should be truthful.","j":29,"h":57,"s":68,"a":41,"sd":null},{"k":"68:42","t":"The Day the shin will be uncovered and they are invited to prostration but they [i.e., the disbelievers] will not be able,","j":29,"h":57,"s":68,"a":42,"sd":null}],"juz":29,"hizb":57,"surahs":[68],"sajdah":false}