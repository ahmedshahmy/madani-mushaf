:3","a":"إِلَّا","t":"(is) except","p":"RES","tr":"illā","l":15},{"i":"81:27:4","a":"ذِكْرٌۭ","t":"a reminder","p":"N","tr":"dhik'run","f":["VN","M","INDEF","NOM"],"r":28,"l":149},{"i":"81:27:5","a":"لِّلْعَـٰلَمِينَ","t":"to the worlds","p":"N","tr":"lil'ʿālamīna","f":["MP","GEN"],"r":5,"l":160,"g":[["لِّ","P","prefix","l:P"],["ِّ","DET","prefix","Al"],["ِلْعَـٰ","N","stem","MP|GEN"]]},{"e":"٢٧","v":"81:27"},{"i":"81:28:1","a":"لِمَن","t":"For whoever","p":"REL","tr":"liman","l":12,"g":[["لِ","P","prefix","l:P"],["مَن","REL","stem",""]]},{"i":"81:28:2","a":"شَآءَ","t":"wills","p":"V","tr":"shāa","f":["PERF","3MS"],"r":10,"l":54},{"i":"81:28:3","a":"مِنكُمْ","t":"among you","p":"P","tr":"minkum","l":0,"g":[["مِن","P","stem",""],["كُمْ","PRON","suffix","PRON:2MP"]]},{"i":"81:28:4","a":"أَن","t":"to","p":"SUB","tr":"an","l":17}]},{"l":15,"t":"a","c":0,"w":[{"i":"81:28:5","a":"يَسْتَقِيمَ","t":"take a straight way","p":"V","tr":"yastaqīma","f":["IMPF","(X)","3MS","MOOD:SUBJ"],"r":6,"l":869},{"e":"٢٨","v":"81:28"},{"i":"81:29:1","a":"وَمَا","t":"And not","p":"NEG","tr":"wamā","l":2,"g":[["وَ","REM","prefix","w:REM"],["مَا","NEG","stem",""]]},{"i":"81:29:2","a":"تَشَآءُونَ","t":"you will","p":"V","tr":"tashāūna","f":["IMPF","2MP"],"r":10,"l":54,"g":[["تَشَآ","V","stem","IMPF|2MP"],["ونَ","PRON","suffix","PRON:2MP"]]},{"i":"81:29:3","a":"إِلَّآ","t":"except","p":"RES","tr":"illā","l":15},{"i":"81:29:4","a":"أَن","t":"that","p":"SUB","tr":"an","l":17},{"i":"81:29:5","a":"يَشَآءَ","t":"wills","p":"V","tr":"yashāa","f":["IMPF","3MS","MOOD:SUBJ"],"r":10,"l":54},{"i":"81:29:6","a":"ٱللَّهُ","t":"Allah","p":"PN","tr":"l-lahu","f":["NOM"],"r":0,"l":1},{"i":"81:29:7","a":"رَبُّ","t":"Lord","p":"N","tr":"rabbu","f":["M","NOM"],"r":3,"l":10},{"i":"81:29:8","a":"ٱلْعَـٰلَمِينَ","t":"(of) the worlds","p":"N","tr":"l-ʿālamīna","f":["MP","GEN"],"r":5,"l":160,"g":[["ٱلْ","DET","prefix","Al"],["ْعَـٰلَ","N","stem","MP|GEN"]]},{"e":"٢٩","v":"81:29"}]}],"verses":[{"k":"80:41","t":"Blackness will cover them.","j":30,"h":59,"s":80,"a":41,"sd":null},{"k":"80:42","t":"Those are the disbelievers, the wicked ones.","j":30,"h":59,"s":80,"a":42,"sd":null},{"k":"81:1","t":"When the sun is wrapped up [in darkness]","j":30,"h":59,"s":81,"a":1,"sd":null},{"k":"81:2","t":"And when the stars fall, dispersing,","j":30,"h":59,"s":81,"a":2,"sd":null},{"k":"81:3","t":"And when the mountains are removed","j":30,"h":59,"s":81,"a":3,"sd":null},{"k":"81:4","t":"And when full-term she-camels are neglected","j":30,"h":59,"s":81,"a":4,"sd":null},{"k":"81:5","t":"And when the wild beasts are gathered","j":30,"h":59,"s":81,"a":5,"sd":null},{"k":"81:6","t":"And when the seas are filled with flame","j":30,"h":59,"s":81,"a":6,"sd":null},{"k":"81:7","t":"And when the souls are paired","j":30,"h":59,"s":81,"a":7,"sd":null},{"k":"81:8","t":"And when the girl [who was] buried alive is asked","j":30,"h":59,"s":81,"a":8,"sd":null},{"k":"81:9","t":"For what sin she was killed","j":30,"h":59,"s":81,"a":9,"sd":null},{"k":"81:10","t":"And when the pages are spread [i.e., made public]","j":30,"h":59,"s":81,"a":10,"sd":null},{"k":"81:11","t":"And when the sky is stripped away","j":30,"h":59,"s":81,"a":11,"sd":null},{"k":"81:12","t":"And when Hellfire is set ablaze","j":30,"h":59,"s":81,"a":12,"sd":null},{"k":"81:13","t":"And when Paradise is brought near,","j":30,"h":59,"s":81,"a":13,"sd":null},{"k":"81:14","t":"A soul will [then] know what it has brought [with it].","j":30,"h":59,"s":81,"a":14,"sd":null},{"k":"81:15","t":"So I swear by the retreating stars -","j":30,"h":59,"s":81,"a":15,"sd":null},{"k":"81:16","t":"Those that run [their courses] and disappear [i.e., set]","j":30,"h":59,"s":81,"a":16,"sd":null},{"k":"81:17","t":"And by the night as it closes in","j":30,"h":59,"s":81,"a":17,"sd":null},{"k":"81:18","t":"And by the dawn when it breathes [i.e., stirs]","j":30,"h":59,"s":81,"a":18,"sd":null},{"k":"81:19","t":"[That] indeed, it [i.e., the Qur’ān] is a word [conveyed by] a noble messenger [i.e., Gabriel]","j":30,"h":59,"s":81,"a":19,"sd":null},{"k":"81:20","t":"[Who is] possessed of power and with the Owner of the Throne, secure [in position],","j":30,"h":59,"s":81,"a":20,"sd":null},{"k":"81:21","t":"Obeyed there [in the heavens] and trustworthy.","j":30,"h":59,"s":81,"a":21,"sd":null},{"k":"81:22","t":"And your companion [i.e., Prophet Muḥammad (ﷺ) ] is not [at all] mad.","j":30,"h":59,"s":81,"a":22,"sd":null},{"k":"81:23","t":"And he has already seen him [i.e., Gabriel] in the clear horizon.","j":30,"h":59,"s":81,"a":23,"sd":null},{"k":"81:24","t":"And he [i.e., Muḥammad (ﷺ)] is not a withholder of [knowledge of] the unseen.","j":30,"h":59,"s":81,"a":24,"sd":null},{"k":"81:25","t":"And it [i.e., the Qur’ān] is not the word of a devil, expelled [from the heavens].","j":30,"h":59,"s":81,"a":25,"sd":null},{"k":"81:26","t":"So where are you going?","j":30,"h":59,"s":81,"a":26,"sd":null},{"k":"81:27","t":"It is not except a reminder to the worlds","j":30,"h":59,"s":81,"a":27,"sd":null},{"k":"81:28","t":"For whoever wills among you to take a right course.","j":30,"h":59,"s":81,"a":28,"sd":null},{"k":"81:29","t":"And you do not will except that Allāh wills - Lord of the worlds.","j":30,"h":59,"s":81,"a":29,"sd":null}],"juz":30,"hizb":59,"surahs":[80,81],"sajdah":false}