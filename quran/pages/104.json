وَ","REM","prefix","w:REM"],["إِن","COND","stem",""]]},{"i":"4:170:13","a":"تَكْفُرُوا۟","t":"you disbelieve","p":"V","tr":"takfurū","f":["IMPF","2MP","MOOD:JUS"],"r":8,"l":40,"g":[["تَكْفُرُ","V","stem","IMPF|2MP|MOOD:JUS"],["وا","PRON","suffix","PRON:2MP"]]},{"i":"4:170:14","a":"فَإِنَّ","t":"then indeed","p":"ACC","tr":"fa-inna","l":5,"g":[["فَ","RSLT","prefix","f:RSLT"],["إِنَّ","ACC","stem",""]]},{"i":"4:170:15","a":"لِلَّهِ","t":"to Allah (belongs)","p":"PN","tr":"lillahi","f":["GEN"],"r":0,"l":1,"g":[["لِ","P","prefix","l:P"],["لَّهِ","PN","stem","GEN"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"4:170:16","a":"مَا","t":"whatever","p":"REL","tr":"mā","l":2},{"i":"4:170:17","a":"فِى","t":"(is) in","p":"P","tr":"fī","l":3},{"i":"4:170:18","a":"ٱلسَّمَـٰوَٰتِ","t":"the heavens","p":"N","tr":"l-samāwāti","f":["FP","GEN"],"r":15,"l":38,"g":[["ٱل","DET","prefix","Al"],["سَّمَـٰ","N","stem","FP|GEN"]]},{"i":"4:170:19","a":"وَٱلْأَرْضِ ۚ","t":"and the earth","p":"N","tr":"wal-arḍi","f":["F","GEN"],"r":12,"l":22,"g":[["وَ","CONJ","prefix","w:CONJ"],["ٱلْ","DET","prefix","Al"],["أَرْضِ","N","stem","F|GEN"]]},{"i":"4:170:20","a":"وَكَانَ","t":"And is","p":"V","tr":"wakāna","f":["PERF","3MS"],"r":2,"l":9,"g":[["وَ","REM","prefix","w:REM"],["كَانَ","V","stem","PERF|3MS"]]},{"i":"4:170:21","a":"ٱللَّهُ","t":"Allah","p":"PN","tr":"l-lahu","f":["NOM"],"r":0,"l":1},{"i":"4:170:22","a":"عَلِيمًا","t":"All-Knowing","p":"N","tr":"ʿalīman","f":["MS","INDEF","ACC"],"r":5,"l":68},{"i":"4:170:23","a":"حَكِيمًۭا","t":"All-Wise","p":"ADJ","tr":"ḥakīman","f":["MS","INDEF","ACC"],"r":43,"l":112},{"e":"١٧٠","v":"4:170"}]}],"verses":[{"k":"4:163","t":"Indeed, We have revealed to you, [O Muḥammad], as We revealed to Noah and the prophets after him. And We revealed to Abraham, Ishmael, Isaac, Jacob, the Descendants, Jesus, Job, Jonah, Aaron, and Solomon, and to David We gave the book [of Psalms].","j":6,"h":11,"s":4,"a":163,"sd":null},{"k":"4:164","t":"And [We sent] messengers about whom We have related [their stories] to you before and messengers about whom We have not related to you. And Allāh spoke to Moses with [direct] speech.","j":6,"h":11,"s":4,"a":164,"sd":null},{"k":"4:165","t":"[We sent] messengers as bringers of good tidings and warners so that mankind will have no argument against Allāh after the messengers. And ever is Allāh Exalted in Might and Wise.","j":6,"h":11,"s":4,"a":165,"sd":null},{"k":"4:166","t":"But Allāh bears witness to that which He has revealed to you. He has sent it down with His knowledge, and the angels bear witness [as well]. And sufficient is Allāh as Witness.","j":6,"h":11,"s":4,"a":166,"sd":null},{"k":"4:167","t":"Indeed, those who disbelieve and avert [people] from the way of Allāh have certainly gone far astray.","j":6,"h":11,"s":4,"a":167,"sd":null},{"k":"4:168","t":"Indeed, those who disbelieve and commit wrong [or injustice] - never will Allāh forgive them, nor will He guide them to a path,","j":6,"h":11,"s":4,"a":168,"sd":null},{"k":"4:169","t":"Except the path of Hell; they will abide therein forever. And that, for Allāh, is [always] easy.","j":6,"h":11,"s":4,"a":169,"sd":null},{"k":"4:170","t":"O mankind, the Messenger has come to you with the truth from your Lord, so believe; it is better for you. But if you disbelieve - then indeed, to Allāh belongs whatever is in the heavens and earth. And ever is Allāh Knowing and Wise.","j":6,"h":11,"s":4,"a":170,"sd":null}],"juz":6,"hizb":11,"surahs":[4],"sajdah":false}