"j":27,"h":54,"s":55,"a":70,"sd":null},{"k":"55:71","t":"So which of the favors of your Lord would you deny? -","j":27,"h":54,"s":55,"a":71,"sd":null},{"k":"55:72","t":"Fair ones reserved in pavilions -","j":27,"h":54,"s":55,"a":72,"sd":null},{"k":"55:73","t":"So which of the favors of your Lord would you deny? -","j":27,"h":54,"s":55,"a":73,"sd":null},{"k":"55:74","t":"Untouched before them by man or jinnī -","j":27,"h":54,"s":55,"a":74,"sd":null},{"k":"55:75","t":"So which of the favors of your Lord would you deny? -","j":27,"h":54,"s":55,"a":75,"sd":null},{"k":"55:76","t":"Reclining on green cushions and beautiful fine carpets.","j":27,"h":54,"s":55,"a":76,"sd":null},{"k":"55:77","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":77,"sd":null},{"k":"55:78","t":"Blessed is the name of your Lord, Owner of Majesty and Honor.","j":27,"h":54,"s":55,"a":78,"sd":null},{"k":"56:1","t":"When the Occurrence occurs,","j":27,"h":54,"s":56,"a":1,"sd":null},{"k":"56:2","t":"There is, at its occurrence, no denial.","j":27,"h":54,"s":56,"a":2,"sd":null},{"k":"56:3","t":"It will bring down [some] and raise up [others].","j":27,"h":54,"s":56,"a":3,"sd":null},{"k":"56:4","t":"When the earth is shaken with convulsion","j":27,"h":54,"s":56,"a":4,"sd":null},{"k":"56:5","t":"And the mountains are broken down, crumbling","j":27,"h":54,"s":56,"a":5,"sd":null},{"k":"56:6","t":"And become dust dispersing,","j":27,"h":54,"s":56,"a":6,"sd":null},{"k":"56:7","t":"And you become [of] three kinds:","j":27,"h":54,"s":56,"a":7,"sd":null},{"k":"56:8","t":"Then the companions of the right - what are the companions of the right?","j":27,"h":54,"s":56,"a":8,"sd":null},{"k":"56:9","t":"And the companions of the left - what are companions of the left?","j":27,"h":54,"s":56,"a":9,"sd":null},{"k":"56:10","t":"And the forerunners, the forerunners -","j":27,"h":54,"s":56,"a":10,"sd":null},{"k":"56:11","t":"Those are the ones brought near [to Allāh]","j":27,"h":54,"s":56,"a":11,"sd":null},{"k":"56:12","t":"In the Gardens of Pleasure,","j":27,"h":54,"s":56,"a":12,"sd":null},{"k":"56:13","t":"A [large] company of the former peoples","j":27,"h":54,"s":56,"a":13,"sd":null},{"k":"56:14","t":"And a few of the later peoples,","j":27,"h":54,"s":56,"a":14,"sd":null},{"k":"56:15","t":"On thrones woven [with ornament],","j":27,"h":54,"s":56,"a":15,"sd":null},{"k":"56:16","t":"Reclining on them, facing each other.","j":27,"h":54,"s":56,"a":16,"sd":null}],"juz":27,"hizb":54,"surahs":[55,56],"sajdah":false}