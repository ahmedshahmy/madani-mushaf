","PRON:1P"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"75:17:3","a":"جَمْعَهُۥ","t":"(is) its collection","p":"N","tr":"jamʿahu","f":["M","ACC"],"r":84,"l":688,"g":[["جَمْعَ","N","stem","M|ACC"],["هُۥ","PRON","suffix","PRON:3MS"]]},{"i":"75:17:4","a":"وَقُرْءَانَهُۥ","t":"and its recitation","p":"N","tr":"waqur'ānahu","f":["M","ACC"],"r":126,"l":175,"g":[["وَ","CONJ","prefix","w:CONJ"],["قُرْءَانَ","N","stem","M|ACC"],["هُۥ","PRON","suffix","PRON:3MS"]]},{"e":"١٧","v":"75:17"},{"i":"75:18:1","a":"فَإِذَا","t":"And when","p":"T","tr":"fa-idhā","l":23,"g":[["فَ","REM","prefix","f:REM"],["إِذَا","T","stem",""]]},{"i":"75:18:2","a":"قَرَأْنَـٰهُ","t":"We have recited it","p":"V","tr":"qaranāhu","f":["PERF","1P"],"r":126,"l":601,"g":[["قَرَ","V","stem","PERF|1P"],["َأْ","PRON","suffix","PRON:1P"],["ْ","PRON","suffix","PRON:3MS"]]},{"i":"75:18:3","a":"فَٱتَّبِعْ","t":"then follow","p":"V","tr":"fa-ittabiʿ","f":["IMPV","(VIII)","2MS"],"r":57,"l":84,"g":[["فَ","RSLT","prefix","f:RSLT"],["ٱتَّبِعْ","V","stem","IMPV|(VIII)|2MS"]]},{"i":"75:18:4","a":"قُرْءَانَهُۥ","t":"its recitation","p":"N","tr":"qur'ānahu","f":["M","ACC"],"r":126,"l":175,"g":[["قُرْءَانَ","N","stem","M|ACC"],["هُۥ","PRON","suffix","PRON:3MS"]]},{"e":"١٨","v":"75:18"},{"i":"75:19:1","a":"ثُمَّ","t":"Then","p":"CONJ","tr":"thumma","l":34},{"i":"75:19:2","a":"إِنَّ","t":"indeed","p":"ACC","tr":"inna","l":5},{"i":"75:19:3","a":"عَلَيْنَا","t":"upon Us","p":"P","tr":"ʿalaynā","l":8,"g":[["عَلَيْ","P","stem",""],["نَا","PRON","suffix","PRON:1P"]]},{"i":"75:19:4","a":"بَيَانَهُۥ","t":"(is) its explanation","p":"N","tr":"bayānahu","f":["M","ACC"],"r":9,"l":1815,"g":[["بَيَانَ","N","stem","M|ACC"],["هُۥ","PRON","suffix","PRON:3MS"]]},{"e":"١٩","v":"75:19"}]}],"verses":[{"k":"74:48","t":"So there will not benefit them the intercession of [any] intercessors.","j":29,"h":58,"s":74,"a":48,"sd":null},{"k":"74:49","t":"Then what is [the matter] with them that they are, from the reminder, turning away.","j":29,"h":58,"s":74,"a":49,"sd":null},{"k":"74:50","t":"As if they were alarmed donkeys.","j":29,"h":58,"s":74,"a":50,"sd":null},{"k":"74:51","t":"Fleeing from a lion?","j":29,"h":58,"s":74,"a":51,"sd":null},{"k":"74:52","t":"Rather, every person among them desires that he would be given scriptures spread about.","j":29,"h":58,"s":74,"a":52,"sd":null},{"k":"74:53","t":"No! But they do not fear the Hereafter.","j":29,"h":58,"s":74,"a":53,"sd":null},{"k":"74:54","t":"No! Indeed, it [i.e., the Qur’ān] is a reminder.","j":29,"h":58,"s":74,"a":54,"sd":null},{"k":"74:55","t":"Then whoever wills will remember it.","j":29,"h":58,"s":74,"a":55,"sd":null},{"k":"74:56","t":"And they will not remember except that Allāh wills. He is worthy of fear and adequate for [granting] forgiveness.","j":29,"h":58,"s":74,"a":56,"sd":null},{"k":"75:1","t":"I swear by the Day of Resurrection","j":29,"h":58,"s":75,"a":1,"sd":null},{"k":"75:2","t":"And I swear by the reproaching soul [to the certainty of resurrection].","j":29,"h":58,"s":75,"a":2,"sd":null},{"k":"75:3","t":"Does man think that We will not assemble his bones?","j":29,"h":58,"s":75,"a":3,"sd":null},{"k":"75:4","t":"Yes. [We are] Able [even] to proportion his fingertips.","j":29,"h":58,"s":75,"a":4,"sd":null},{"k":"75:5","t":"But man desires to continue in sin.","j":29,"h":58,"s":75,"a":5,"sd":null},{"k":"75:6","t":"He asks, \"When is the Day of Resurrection?\"","j":29,"h":58,"s":75,"a":6,"sd":null},{"k":"75:7","t":"So when vision is dazzled.","j":29,"h":58,"s":75,"a":7,"sd":null},{"k":"75:8","t":"And the moon darkens.","j":29,"h":58,"s":75,"a":8,"sd":null},{"k":"75:9","t":"And the sun and the moon are joined,","j":29,"h":58,"s":75,"a":9,"sd":null},{"k":"75:10","t":"Man will say on that Day, \"Where is the [place of] escape?\"","j":29,"h":58,"s":75,"a":10,"sd":null},{"k":"75:11","t":"No! There is no refuge.","j":29,"h":58,"s":75,"a":11,"sd":null},{"k":"75:12","t":"To your Lord, that Day, is the [place of] permanence.","j":29,"h":58,"s":75,"a":12,"sd":null},{"k":"75:13","t":"Man will be informed that Day of what he sent ahead and kept back.","j":29,"h":58,"s":75,"a":13,"sd":null},{"k":"75:14","t":"Rather, man, against himself, will be a witness,","j":29,"h":58,"s":75,"a":14,"sd":null},{"k":"75:15","t":"Even if he presents his excuses.","j":29,"h":58,"s":75,"a":15,"sd":null},{"k":"75:16","t":"Move not your tongue with it, [O Muḥammad], to hasten with it [i.e., recitation of the Qur’ān].","j":29,"h":58,"s":75,"a":16,"sd":null},{"k":"75:17","t":"Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation.","j":29,"h":58,"s":75,"a":17,"sd":null},{"k":"75:18","t":"So when We have recited it [through Gabriel], then follow its recitation.","j":29,"h":58,"s":75,"a":18,"sd":null},{"k":"75:19","t":"Then upon Us is its clarification [to you].","j":29,"h":58,"s":75,"a":19,"sd":null}],"juz":29,"hizb":58,"surahs":[74,75],"sajdah":false}