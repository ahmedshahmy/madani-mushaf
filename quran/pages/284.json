l":153},{"i":"17:27:5","a":"ٱلشَّيَـٰطِينِ ۖ","t":"(of) the devils","p":"PN","tr":"l-shayāṭīni","f":["MP","GEN"],"r":125,"l":120,"g":[["ٱل","DET","prefix","Al"],["شَّيَـٰ","PN","stem","MP|GEN"]]},{"i":"17:27:6","a":"وَكَانَ","t":"And is","p":"V","tr":"wakāna","f":["PERF","3MS"],"r":2,"l":9,"g":[["وَ","CONJ","prefix","w:CONJ"],["كَانَ","V","stem","PERF|3MS"]]},{"i":"17:27:7","a":"ٱلشَّيْطَـٰنُ","t":"the Shaitaan","p":"PN","tr":"l-shayṭānu","f":["M","NOM"],"r":125,"l":120,"g":[["ٱل","DET","prefix","Al"],["شَّيْ","PN","stem","M|NOM"]]},{"i":"17:27:8","a":"لِرَبِّهِۦ","t":"to his Lord","p":"N","tr":"lirabbihi","f":["M","GEN"],"r":3,"l":10,"g":[["لِ","P","prefix","l:P"],["رَبِّ","N","stem","M|GEN"],["هِۦ","PRON","suffix","PRON:3MS"]]},{"i":"17:27:9","a":"كَفُورًۭا","t":"ungrateful","p":"ADJ","tr":"kafūran","f":["MS","INDEF","ACC"],"r":8,"l":731},{"e":"٢٧","v":"17:27"}]}],"verses":[{"k":"17:18","t":"Whoever should desire the immediate - We hasten for him from it what We will to whom We intend. Then We have made for him Hell, which he will [enter to] burn, censured and banished.","j":15,"h":29,"s":17,"a":18,"sd":null},{"k":"17:19","t":"But whoever desires the Hereafter and exerts the effort due to it while he is a believer - it is those whose effort is ever appreciated [by Allāh].","j":15,"h":29,"s":17,"a":19,"sd":null},{"k":"17:20","t":"To each [category] We extend - to these and to those - from the gift of your Lord. And never has the gift of your Lord been restricted.","j":15,"h":29,"s":17,"a":20,"sd":null},{"k":"17:21","t":"Look how We have favored [in provision] some of them over others. But the Hereafter is greater in degrees [of difference] and greater in distinction.","j":15,"h":29,"s":17,"a":21,"sd":null},{"k":"17:22","t":"Do not make [as equal] with Allāh another deity and [thereby] become censured and forsaken.","j":15,"h":29,"s":17,"a":22,"sd":null},{"k":"17:23","t":"And your Lord has decreed that you worship not except Him, and to parents, good treatment. Whether one or both of them reach old age [while] with you, say not to them [so much as], \"uff,\" and do not repel them but speak to them a noble word.","j":15,"h":29,"s":17,"a":23,"sd":null},{"k":"17:24","t":"And lower to them the wing of humility out of mercy and say, \"My Lord, have mercy upon them as they brought me up [when I was] small.\"","j":15,"h":29,"s":17,"a":24,"sd":null},{"k":"17:25","t":"Your Lord is most knowing of what is within yourselves. If you should be righteous [in intention] - then indeed He is ever, to the often returning [to Him], Forgiving.","j":15,"h":29,"s":17,"a":25,"sd":null},{"k":"17:26","t":"And give the relative his right, and [also] the poor and the traveler, and do not spend wastefully.","j":15,"h":29,"s":17,"a":26,"sd":null},{"k":"17:27","t":"Indeed, the wasteful are brothers of the devils, and ever has Satan been to his Lord ungrateful.","j":15,"h":29,"s":17,"a":27,"sd":null}],"juz":15,"hizb":29,"surahs":[17],"sajdah":false}