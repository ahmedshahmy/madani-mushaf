"يَوْمَئِذٍۢ","t":"that Day","p":"T","tr":"yawma-idhin","l":177},{"i":"80:38:3","a":"مُّسْفِرَةٌۭ","t":"(will be) bright","p":"N","tr":"mus'firatun","f":["ACT","PCPL","(IV)","F","INDEF","NOM"],"r":532,"l":3989},{"e":"٣٨","v":"80:38"}]},{"l":15,"t":"a","c":0,"w":[{"i":"80:39:1","a":"ضَاحِكَةٌۭ","t":"Laughing","p":"N","tr":"ḍāḥikatun","f":["ACT","PCPL","F","INDEF","NOM"],"r":568,"l":3072},{"i":"80:39:2","a":"مُّسْتَبْشِرَةٌۭ","t":"rejoicing at good news","p":"N","tr":"mus'tabshiratun","f":["ACT","PCPL","(X)","F","INDEF","NOM"],"r":92,"l":3992},{"e":"٣٩","v":"80:39"},{"i":"80:40:1","a":"وَوُجُوهٌۭ","t":"And faces","p":"N","tr":"wawujūhun","f":["MP","INDEF","NOM"],"r":139,"l":166,"g":[["وَ","CONJ","prefix","w:CONJ"],["وُجُوهٌۭ","N","stem","MP|INDEF|NOM"]]},{"i":"80:40:2","a":"يَوْمَئِذٍ","t":"that Day","p":"T","tr":"yawma-idhin","l":177},{"i":"80:40:3","a":"عَلَيْهَا","t":"upon them","p":"P","tr":"ʿalayhā","l":8,"g":[["عَلَيْ","P","stem",""],["هَا","PRON","suffix","PRON:3FS"]]},{"i":"80:40:4","a":"غَبَرَةٌۭ","t":"(will be) dust","p":"N","tr":"ghabaratun","f":["F","INDEF","NOM"],"r":641,"l":3455},{"e":"٤٠","v":"80:40"}]}],"verses":[{"k":"80:1","t":"He [i.e., the Prophet (ﷺ) ] frowned and turned away","j":30,"h":59,"s":80,"a":1,"sd":null},{"k":"80:2","t":"Because there came to him the blind man, [interrupting].","j":30,"h":59,"s":80,"a":2,"sd":null},{"k":"80:3","t":"But what would make you perceive, [O Muḥammad], that perhaps he might be purified","j":30,"h":59,"s":80,"a":3,"sd":null},{"k":"80:4","t":"Or be reminded and the remembrance would benefit him?","j":30,"h":59,"s":80,"a":4,"sd":null},{"k":"80:5","t":"As for he who thinks himself without need,","j":30,"h":59,"s":80,"a":5,"sd":null},{"k":"80:6","t":"To him you give attention.","j":30,"h":59,"s":80,"a":6,"sd":null},{"k":"80:7","t":"And not upon you [is any blame] if he will not be purified.","j":30,"h":59,"s":80,"a":7,"sd":null},{"k":"80:8","t":"But as for he who came to you striving [for knowledge]","j":30,"h":59,"s":80,"a":8,"sd":null},{"k":"80:9","t":"While he fears [Allāh],","j":30,"h":59,"s":80,"a":9,"sd":null},{"k":"80:10","t":"From him you are distracted.","j":30,"h":59,"s":80,"a":10,"sd":null},{"k":"80:11","t":"No! Indeed, they [i.e., these verses] are a reminder;","j":30,"h":59,"s":80,"a":11,"sd":null},{"k":"80:12","t":"So whoever wills may remember it.","j":30,"h":59,"s":80,"a":12,"sd":null},{"k":"80:13","t":"[It is recorded] in honored sheets,","j":30,"h":59,"s":80,"a":13,"sd":null},{"k":"80:14","t":"Exalted and purified,","j":30,"h":59,"s":80,"a":14,"sd":null},{"k":"80:15","t":"[Carried] by the hands of messenger-angels,","j":30,"h":59,"s":80,"a":15,"sd":null},{"k":"80:16","t":"Noble and dutiful.","j":30,"h":59,"s":80,"a":16,"sd":null},{"k":"80:17","t":"Destroyed [i.e., cursed] is man; how disbelieving is he.","j":30,"h":59,"s":80,"a":17,"sd":null},{"k":"80:18","t":"From what thing [i.e., substance] did He create him?","j":30,"h":59,"s":80,"a":18,"sd":null},{"k":"80:19","t":"From a sperm-drop He created him and destined for him;","j":30,"h":59,"s":80,"a":19,"sd":null},{"k":"80:20","t":"Then He eased the way for him;","j":30,"h":59,"s":80,"a":20,"sd":null},{"k":"80:21","t":"Then He causes his death and provides a grave for him.","j":30,"h":59,"s":80,"a":21,"sd":null},{"k":"80:22","t":"Then when He wills, He will resurrect him.","j":30,"h":59,"s":80,"a":22,"sd":null},{"k":"80:23","t":"No! He [i.e., man] has not yet accomplished what He commanded him.","j":30,"h":59,"s":80,"a":23,"sd":null},{"k":"80:24","t":"Then let mankind look at his food -","j":30,"h":59,"s":80,"a":24,"sd":null},{"k":"80:25","t":"How We poured down water in torrents,","j":30,"h":59,"s":80,"a":25,"sd":null},{"k":"80:26","t":"Then We broke open the earth, splitting [it with sprouts],","j":30,"h":59,"s":80,"a":26,"sd":null},{"k":"80:27","t":"And caused to grow within it grain","j":30,"h":59,"s":80,"a":27,"sd":null},{"k":"80:28","t":"And grapes and herbage","j":30,"h":59,"s":80,"a":28,"sd":null},{"k":"80:29","t":"And olive and palm trees","j":30,"h":59,"s":80,"a":29,"sd":null},{"k":"80:30","t":"And gardens of dense shrubbery","j":30,"h":59,"s":80,"a":30,"sd":null},{"k":"80:31","t":"And fruit and grass -","j":30,"h":59,"s":80,"a":31,"sd":null},{"k":"80:32","t":"[As] enjoyment [i.e., provision] for you and your grazing livestock.","j":30,"h":59,"s":80,"a":32,"sd":null},{"k":"80:33","t":"But when there comes the Deafening Blast","j":30,"h":59,"s":80,"a":33,"sd":null},{"k":"80:34","t":"On the Day a man will flee from his brother","j":30,"h":59,"s":80,"a":34,"sd":null},{"k":"80:35","t":"And his mother and his father","j":30,"h":59,"s":80,"a":35,"sd":null},{"k":"80:36","t":"And his wife and his children,","j":30,"h":59,"s":80,"a":36,"sd":null},{"k":"80:37","t":"For every man, that Day, will be a matter adequate for him.","j":30,"h":59,"s":80,"a":37,"sd":null},{"k":"80:38","t":"[Some] faces, that Day, will be bright -","j":30,"h":59,"s":80,"a":38,"sd":null},{"k":"80:39","t":"Laughing, rejoicing at good news.","j":30,"h":59,"s":80,"a":39,"sd":null},{"k":"80:40","t":"And [other] faces, that Day, will have upon them dust.","j":30,"h":59,"s":80,"a":40,"sd":null}],"juz":30,"hizb":59,"surahs":[80],"sajdah":false}