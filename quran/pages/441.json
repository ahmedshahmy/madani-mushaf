َ","t":"I wish","p":"ACC","tr":"yālayta","l":667,"g":[["يَـٰ","VOC","prefix","ya"],["ـٰلَ","ACC","stem",""]]},{"i":"36:26:6","a":"قَوْمِى","t":"my people","p":"N","tr":"qawmī","f":["M","NOM"],"r":6,"l":27,"g":[["قَوْمِ","N","stem","M|NOM"],["ى","PRON","suffix","PRON:1S"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"36:26:7","a":"يَعْلَمُونَ","t":"knew","p":"V","tr":"yaʿlamūna","f":["IMPF","3MP"],"r":5,"l":29,"g":[["يَعْلَمُ","V","stem","IMPF|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"e":"٢٦","v":"36:26"},{"i":"36:27:1","a":"بِمَا","t":"Of how","p":"REL","tr":"bimā","l":2,"g":[["بِ","P","prefix","bi"],["مَا","REL","stem",""]]},{"i":"36:27:2","a":"غَفَرَ","t":"has forgiven","p":"V","tr":"ghafara","f":["PERF","3MS"],"r":40,"l":183},{"i":"36:27:3","a":"لِى","t":"me","p":"PRON","tr":"lī","f":["1S"],"l":146,"g":[["لِ","P","prefix","l:P"],["ى","PRON","stem","1S"]]},{"i":"36:27:4","a":"رَبِّى","t":"my Lord","p":"N","tr":"rabbī","f":["M","NOM"],"r":3,"l":10,"g":[["رَبِّ","N","stem","M|NOM"],["ى","PRON","suffix","PRON:1S"]]},{"i":"36:27:5","a":"وَجَعَلَنِى","t":"and placed me","p":"V","tr":"wajaʿalanī","f":["PERF","3MS"],"r":19,"l":33,"g":[["وَ","CONJ","prefix","w:CONJ"],["جَعَلَ","V","stem","PERF|3MS"],["نِى","PRON","suffix","PRON:1S"]]},{"i":"36:27:6","a":"مِنَ","t":"among","p":"P","tr":"mina","l":0},{"i":"36:27:7","a":"ٱلْمُكْرَمِينَ","t":"the honored ones","p":"N","tr":"l-muk'ramīna","f":["PASS","PCPL","(IV)","MP","GEN"],"r":210,"l":1372,"g":[["ٱلْ","DET","prefix","Al"],["مُكْرَمِينَ","N","stem","PASS|PCPL|(IV)|MP|GEN"]]},{"e":"٢٧","v":"36:27"}]}],"verses":[{"k":"36:13","t":"And present to them an example: the people of the city, when the messengers came to it -","j":22,"h":44,"s":36,"a":13,"sd":null},{"k":"36:14","t":"When We sent to them two but they denied them, so We strengthened [them] with a third, and they said, \"Indeed, we are messengers to you.\"","j":22,"h":44,"s":36,"a":14,"sd":null},{"k":"36:15","t":"They said, \"You are not but human beings like us, and the Most Merciful has not revealed a thing. You are only telling lies.\"","j":22,"h":44,"s":36,"a":15,"sd":null},{"k":"36:16","t":"They said, \"Our Lord knows that we are messengers to you,","j":22,"h":44,"s":36,"a":16,"sd":null},{"k":"36:17","t":"And we are not responsible except for clear notification.\"","j":22,"h":44,"s":36,"a":17,"sd":null},{"k":"36:18","t":"They said, \"Indeed, we consider you a bad omen. If you do not desist, we will surely stone you, and there will surely touch you, from us, a painful punishment.\"","j":22,"h":44,"s":36,"a":18,"sd":null},{"k":"36:19","t":"They said, \"Your omen [i.e., fate] is with yourselves. Is it because you were reminded? Rather, you are a transgressing people.\"","j":22,"h":44,"s":36,"a":19,"sd":null},{"k":"36:20","t":"And there came from the farthest end of the city a man, running. He said, \"O my people, follow the messengers.","j":22,"h":44,"s":36,"a":20,"sd":null},{"k":"36:21","t":"Follow those who do not ask of you [any] payment, and they are [rightly] guided.","j":22,"h":44,"s":36,"a":21,"sd":null},{"k":"36:22","t":"And why should I not worship He who created me and to whom you will be returned?","j":22,"h":44,"s":36,"a":22,"sd":null},{"k":"36:23","t":"Should I take other than Him [false] deities [while], if the Most Merciful intends for me some adversity, their intercession will not avail me at all, nor can they save me?","j":22,"h":44,"s":36,"a":23,"sd":null},{"k":"36:24","t":"Indeed, I would then be in manifest error.","j":22,"h":44,"s":36,"a":24,"sd":null},{"k":"36:25","t":"Indeed, I have believed in your Lord, so listen to me.\"","j":22,"h":44,"s":36,"a":25,"sd":null},{"k":"36:26","t":"It was said, \"Enter Paradise.\" He said, \"I wish my people could know","j":22,"h":44,"s":36,"a":26,"sd":null},{"k":"36:27","t":"Of how my Lord has forgiven me and placed me among the honored.\"","j":22,"h":44,"s":36,"a":27,"sd":null}],"juz":22,"hizb":44,"surahs":[36],"sajdah":false}