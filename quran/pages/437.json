D:SUBJ"],["هُم","PRON","suffix","PRON:3MP"]]},{"i":"35:30:4","a":"مِّن","t":"of","p":"P","tr":"min","l":0},{"i":"35:30:5","a":"فَضْلِهِۦٓ ۚ","t":"His Bounty","p":"N","tr":"faḍlihi","f":["M","GEN"],"r":107,"l":131,"g":[["فَضْلِ","N","stem","M|GEN"],["هِۦٓ","PRON","suffix","PRON:3MS"]]},{"i":"35:30:6","a":"إِنَّهُۥ","t":"Indeed, He","p":"ACC","tr":"innahu","l":5,"g":[["إِنَّ","ACC","stem",""],["هُۥ","PRON","suffix","PRON:3MS"]]},{"i":"35:30:7","a":"غَفُورٌۭ","t":"(is) Oft-Forgiving","p":"N","tr":"ghafūrun","f":["MS","INDEF","NOM"],"r":40,"l":118},{"i":"35:30:8","a":"شَكُورٌۭ","t":"Most Appreciative","p":"ADJ","tr":"shakūrun","f":["MS","INDEF","NOM"],"r":143,"l":810},{"e":"٣٠","v":"35:30"}]}],"verses":[{"k":"35:19","t":"Not equal are the blind and the seeing,","j":22,"h":44,"s":35,"a":19,"sd":null},{"k":"35:20","t":"Nor are the darknesses and the light,","j":22,"h":44,"s":35,"a":20,"sd":null},{"k":"35:21","t":"Nor are the shade and the heat,","j":22,"h":44,"s":35,"a":21,"sd":null},{"k":"35:22","t":"And not equal are the living and the dead. Indeed, Allāh causes to hear whom He wills, but you cannot make hear those in the graves.","j":22,"h":44,"s":35,"a":22,"sd":null},{"k":"35:23","t":"You, [O Muḥammad], are not but a warner.","j":22,"h":44,"s":35,"a":23,"sd":null},{"k":"35:24","t":"Indeed, We have sent you with the truth as a bringer of good tidings and a warner. And there was no nation but that there had passed within it a warner.","j":22,"h":44,"s":35,"a":24,"sd":null},{"k":"35:25","t":"And if they deny you - then already have those before them denied. Their messengers came to them with clear proofs and written ordinances and with the enlightening Scripture.","j":22,"h":44,"s":35,"a":25,"sd":null},{"k":"35:26","t":"Then I seized the ones who disbelieved, and how [terrible] was My reproach.","j":22,"h":44,"s":35,"a":26,"sd":null},{"k":"35:27","t":"Do you not see that Allāh sends down rain from the sky, and We produce thereby fruits of varying colors? And in the mountains are tracts, white and red of varying shades and [some] extremely black.","j":22,"h":44,"s":35,"a":27,"sd":null},{"k":"35:28","t":"And among people and moving creatures and grazing livestock are various colors similarly. Only those fear Allāh, from among His servants, who have knowledge. Indeed, Allāh is Exalted in Might and Forgiving.","j":22,"h":44,"s":35,"a":28,"sd":null},{"k":"35:29","t":"Indeed, those who recite the Book of Allāh and establish prayer and spend [in His cause] out of what We have provided them, secretly and publicly, [can] expect a transaction [i.e., profit] that will never perish -","j":22,"h":44,"s":35,"a":29,"sd":null},{"k":"35:30","t":"That He may give them in full their rewards and increase for them of His bounty. Indeed, He is Forgiving and Appreciative.","j":22,"h":44,"s":35,"a":30,"sd":null}],"juz":22,"hizb":44,"surahs":[35],"sajdah":false}