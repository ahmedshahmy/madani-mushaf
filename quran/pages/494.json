e to inherit for what you used to do.","j":25,"h":50,"s":43,"a":72,"sd":null},{"k":"43:73","t":"For you therein is much fruit from which you will eat.","j":25,"h":50,"s":43,"a":73,"sd":null}],"juz":25,"hizb":50,"surahs":[43],"sajdah":false}