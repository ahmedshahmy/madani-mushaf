sd":null},{"k":"55:50","t":"In both of them are two springs, flowing.","j":27,"h":54,"s":55,"a":50,"sd":null},{"k":"55:51","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":51,"sd":null},{"k":"55:52","t":"In both of them are of every fruit, two kinds.","j":27,"h":54,"s":55,"a":52,"sd":null},{"k":"55:53","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":53,"sd":null},{"k":"55:54","t":"[They are] reclining on beds whose linings are of silk brocade, and the fruit of the two gardens is hanging low.","j":27,"h":54,"s":55,"a":54,"sd":null},{"k":"55:55","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":55,"sd":null},{"k":"55:56","t":"In them are women limiting [their] glances, untouched before them by man or jinnī -","j":27,"h":54,"s":55,"a":56,"sd":null},{"k":"55:57","t":"So which of the favors of your Lord would you deny? -","j":27,"h":54,"s":55,"a":57,"sd":null},{"k":"55:58","t":"As if they were rubies and coral.","j":27,"h":54,"s":55,"a":58,"sd":null},{"k":"55:59","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":59,"sd":null},{"k":"55:60","t":"Is the reward for good [anything] but good?","j":27,"h":54,"s":55,"a":60,"sd":null},{"k":"55:61","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":61,"sd":null},{"k":"55:62","t":"And below them both [in excellence] are two [other] gardens -","j":27,"h":54,"s":55,"a":62,"sd":null},{"k":"55:63","t":"So which of the favors of your Lord would you deny? -","j":27,"h":54,"s":55,"a":63,"sd":null},{"k":"55:64","t":"Dark green [in color].","j":27,"h":54,"s":55,"a":64,"sd":null},{"k":"55:65","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":65,"sd":null},{"k":"55:66","t":"In both of them are two springs, spouting.","j":27,"h":54,"s":55,"a":66,"sd":null},{"k":"55:67","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":67,"sd":null},{"k":"55:68","t":"In both of them are fruit and palm trees and pomegranates.","j":27,"h":54,"s":55,"a":68,"sd":null},{"k":"55:69","t":"So which of the favors of your Lord would you deny?","j":27,"h":54,"s":55,"a":69,"sd":null}],"juz":27,"hizb":54,"surahs":[55],"sajdah":false}