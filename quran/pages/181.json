","p":"N","tr":"l-dīnu","f":["M","NOM"],"r":113,"l":116,"g":[["ٱل","DET","prefix","Al"],["دِّينُ","N","stem","M|NOM"]]},{"i":"8:39:8","a":"كُلُّهُۥ","t":"all of it","p":"N","tr":"kulluhu","f":["M","NOM"],"r":16,"l":31,"g":[["كُلُّ","N","stem","M|NOM"],["هُۥ","PRON","suffix","PRON:3MS"]]},{"i":"8:39:9","a":"لِلَّهِ ۚ","t":"for Allah","p":"PN","tr":"lillahi","f":["GEN"],"r":0,"l":1,"g":[["لِ","P","prefix","l:P"],["لَّهِ","PN","stem","GEN"]]},{"i":"8:39:10","a":"فَإِنِ","t":"But if","p":"COND","tr":"fa-ini","l":14,"g":[["فَ","REM","prefix","f:REM"],["إِنِ","COND","stem",""]]}]},{"l":14,"t":"a","c":0,"w":[{"i":"8:39:11","a":"ٱنتَهَوْا۟","t":"they cease","p":"V","tr":"intahaw","f":["PERF","(VIII)","3MP"],"r":192,"l":610,"g":[["ٱنتَهَ","V","stem","PERF|(VIII)|3MP"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"8:39:12","a":"فَإِنَّ","t":"then indeed","p":"ACC","tr":"fa-inna","l":5,"g":[["فَ","RSLT","prefix","f:RSLT"],["إِنَّ","ACC","stem",""]]},{"i":"8:39:13","a":"ٱللَّهَ","t":"Allah","p":"PN","tr":"l-laha","f":["ACC"],"r":0,"l":1},{"i":"8:39:14","a":"بِمَا","t":"of what","p":"REL","tr":"bimā","l":2,"g":[["بِ","P","prefix","bi"],["مَا","REL","stem",""]]},{"i":"8:39:15","a":"يَعْمَلُونَ","t":"they do","p":"V","tr":"yaʿmalūna","f":["IMPF","3MP"],"r":18,"l":44,"g":[["يَعْمَلُ","V","stem","IMPF|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"i":"8:39:16","a":"بَصِيرٌۭ","t":"(is) All-Seer","p":"N","tr":"baṣīrun","f":["MS","INDEF","NOM"],"r":74,"l":232},{"e":"٣٩","v":"8:39"},{"i":"8:40:1","a":"وَإِن","t":"And if","p":"COND","tr":"wa-in","l":14,"g":[["وَ","CONJ","prefix","w:CONJ"],["إِن","COND","stem",""]]},{"i":"8:40:2","a":"تَوَلَّوْا۟","t":"they turn away","p":"V","tr":"tawallaw","f":["PERF","(V)","3MP"],"r":41,"l":145,"g":[["تَوَلَّ","V","stem","PERF|(V)|3MP"],["وا","PRON","suffix","PRON:3MP"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"8:40:3","a":"فَٱعْلَمُوٓا۟","t":"then know","p":"V","tr":"fa-iʿ'lamū","f":["IMPV","2MP"],"r":5,"l":29,"g":[["فَ","RSLT","prefix","f:RSLT"],["ٱعْلَمُ","V","stem","IMPV|2MP"],["وا","PRON","suffix","PRON:2MP"]]},{"i":"8:40:4","a":"أَنَّ","t":"that","p":"ACC","tr":"anna","l":30},{"i":"8:40:5","a":"ٱللَّهَ","t":"Allah","p":"PN","tr":"l-laha","f":["ACC"],"r":0,"l":1},{"i":"8:40:6","a":"مَوْلَىٰكُمْ ۚ","t":"(is) your Protector","p":"N","tr":"mawlākum","f":["M","NOM"],"r":41,"l":551,"g":[["مَوْلَ","N","stem","M|NOM"],["َىٰ","PRON","suffix","PRON:2MP"]]},{"i":"8:40:7","a":"نِعْمَ","t":"Excellent","p":"V","tr":"niʿ'ma","f":["PERF","3MS"],"r":78,"l":554},{"i":"8:40:8","a":"ٱلْمَوْلَىٰ","t":"(is) the Protector","p":"N","tr":"l-mawlā","f":["M","NOM"],"r":41,"l":551,"g":[["ٱلْ","DET","prefix","Al"],["ْمَوْ","N","stem","M|NOM"]]},{"i":"8:40:9","a":"وَنِعْمَ","t":"and Excellent","p":"V","tr":"waniʿ'ma","f":["PERF","3MS"],"r":78,"l":554,"g":[["وَ","CONJ","prefix","w:CONJ"],["نِعْمَ","V","stem","PERF|3MS"]]},{"i":"8:40:10","a":"ٱلنَّصِيرُ","t":"(is) the Helper","p":"N","tr":"l-naṣīru","f":["MS","NOM"],"r":70,"l":332,"g":[["ٱل","DET","prefix","Al"],["نَّصِيرُ","N","stem","MS|NOM"]]},{"e":"٤٠","v":"8:40"}]}],"verses":[{"k":"8:34","t":"But why should Allāh not punish them while they obstruct [people] from al-Masjid al-Ḥarām and they were not [fit to be] its guardians? Its [true] guardians are not but the righteous, but most of them do not know.","j":9,"h":18,"s":8,"a":34,"sd":null},{"k":"8:35","t":"And their prayer at the House [i.e., the Kaʿbah] was not except whistling and handclapping. So taste the punishment for what you disbelieved [i.e., practiced of deviations].","j":9,"h":18,"s":8,"a":35,"sd":null},{"k":"8:36","t":"Indeed, those who disbelieve spend their wealth to avert [people] from the way of Allāh. So they will spend it; then it will be for them a [source of] regret; then they will be overcome. And those who have disbelieved - unto Hell they will be gathered.","j":9,"h":18,"s":8,"a":36,"sd":null},{"k":"8:37","t":"[It is] so that Allāh may distinguish the wicked from the good and place the wicked some of them upon others and heap them all together and put them into Hell. It is those who are the losers.","j":9,"h":18,"s":8,"a":37,"sd":null},{"k":"8:38","t":"Say to those who have disbelieved [that] if they cease, what has previously occurred will be forgiven for them. But if they return [to hostility] - then the precedent of the former [rebellious] peoples has already taken place.","j":9,"h":18,"s":8,"a":38,"sd":null},{"k":"8:39","t":"And fight against them until there is no fitnah and [until] the religion [i.e., worship], all of it, is for Allāh. And if they cease - then indeed, Allāh is Seeing of what they do.","j":9,"h":18,"s":8,"a":39,"sd":null},{"k":"8:40","t":"But if they turn away - then know that Allāh is your protector. Excellent is the protector, and excellent is the helper.","j":9,"h":18,"s":8,"a":40,"sd":null}],"juz":9,"hizb":18,"surahs":[8],"sajdah":false}