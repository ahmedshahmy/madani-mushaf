,"c":0,"w":[{"i":"40:66:3","a":"نُهِيتُ","t":"[I] have been forbidden","p":"V","tr":"nuhītu","f":["PERF","PASS","1S"],"r":192,"l":353,"g":[["نُهِي","V","stem","PERF|PASS|1S"],["تُ","PRON","suffix","PRON:1S"]]},{"i":"40:66:4","a":"أَنْ","t":"to","p":"SUB","tr":"an","l":17},{"i":"40:66:5","a":"أَعْبُدَ","t":"worship","p":"V","tr":"aʿbuda","f":["IMPF","1S","MOOD:SUBJ"],"r":32,"l":97},{"i":"40:66:6","a":"ٱلَّذِينَ","t":"those whom","p":"REL","tr":"alladhīna","f":["MP"],"l":7},{"i":"40:66:7","a":"تَدْعُونَ","t":"you call","p":"V","tr":"tadʿūna","f":["IMPF","2MP"],"r":42,"l":65,"g":[["تَدْعُ","V","stem","IMPF|2MP"],["ونَ","PRON","suffix","PRON:2MP"]]},{"i":"40:66:8","a":"مِن","t":"besides","p":"P","tr":"min","l":0},{"i":"40:66:9","a":"دُونِ","t":"besides","p":"N","tr":"dūni","f":["GEN"],"r":77,"l":78},{"i":"40:66:10","a":"ٱللَّهِ","t":"Allah","p":"PN","tr":"l-lahi","f":["GEN"],"r":0,"l":1},{"i":"40:66:11","a":"لَمَّا","t":"when","p":"T","tr":"lammā","l":71},{"i":"40:66:12","a":"جَآءَنِىَ","t":"have come to me","p":"V","tr":"jāaniya","f":["PERF","3MS"],"r":31,"l":43,"g":[["جَآ","V","stem","PERF|3MS"],["نِىَ","PRON","suffix","PRON:1S"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"40:66:13","a":"ٱلْبَيِّنَـٰتُ","t":"the clear proofs","p":"N","tr":"l-bayinātu","f":["FP","NOM"],"r":9,"l":171,"g":[["ٱلْ","DET","prefix","Al"],["ْبَيِّ","N","stem","FP|NOM"]]},{"i":"40:66:14","a":"مِن","t":"from","p":"P","tr":"min","l":0},{"i":"40:66:15","a":"رَّبِّى","t":"my Lord","p":"N","tr":"rabbī","f":["M","GEN"],"r":3,"l":10,"g":[["رَّبِّ","N","stem","M|GEN"],["ى","PRON","suffix","PRON:1S"]]},{"i":"40:66:16","a":"وَأُمِرْتُ","t":"and I am commanded","p":"V","tr":"wa-umir'tu","f":["PERF","PASS","1S"],"r":37,"l":147,"g":[["وَ","CONJ","prefix","w:CONJ"],["أُمِرْ","V","stem","PERF|PASS|1S"],["تُ","PRON","suffix","PRON:1S"]]},{"i":"40:66:17","a":"أَنْ","t":"to","p":"SUB","tr":"an","l":17},{"i":"40:66:18","a":"أُسْلِمَ","t":"submit","p":"V","tr":"us'lima","f":["IMPF","(IV)","1S","MOOD:SUBJ"],"r":79,"l":463},{"i":"40:66:19","a":"لِرَبِّ","t":"to (the) Lord","p":"N","tr":"lirabbi","f":["M","GEN"],"r":3,"l":10,"g":[["لِ","P","prefix","l:P"],["رَبِّ","N","stem","M|GEN"]]},{"i":"40:66:20","a":"ٱلْعَـٰلَمِينَ","t":"(of) the worlds","p":"N","tr":"l-ʿālamīna","f":["MP","GEN"],"r":5,"l":160,"g":[["ٱلْ","DET","prefix","Al"],["ْعَـٰلَ","N","stem","MP|GEN"]]},{"e":"٦٦","v":"40:66"}]}],"verses":[{"k":"40:59","t":"Indeed, the Hour is coming - no doubt about it - but most of the people do not believe.","j":24,"h":48,"s":40,"a":59,"sd":null},{"k":"40:60","t":"And your Lord says, \"Call upon Me; I will respond to you.\" Indeed, those who disdain My worship will enter Hell [rendered] contemptible.","j":24,"h":48,"s":40,"a":60,"sd":null},{"k":"40:61","t":"It is Allāh who made for you the night that you may rest therein and the day giving sight. Indeed, Allāh is the possessor of bounty for the people, but most of them are not grateful.","j":24,"h":48,"s":40,"a":61,"sd":null},{"k":"40:62","t":"That is Allāh, your Lord, Creator of all things; there is no deity except Him, so how are you deluded?","j":24,"h":48,"s":40,"a":62,"sd":null},{"k":"40:63","t":"Thus were those [before you] deluded who were rejecting the signs of Allāh.","j":24,"h":48,"s":40,"a":63,"sd":null},{"k":"40:64","t":"It is Allāh who made for you the earth a place of settlement and the sky a structure [i.e., ceiling] and formed you and perfected your forms and provided you with good things. That is Allāh, your Lord; then blessed is Allāh, Lord of the worlds.","j":24,"h":48,"s":40,"a":64,"sd":null},{"k":"40:65","t":"He is the Ever-Living; there is no deity except Him, so call upon Him, [being] sincere to Him in religion. [All] praise is [due] to Allāh, Lord of the worlds.","j":24,"h":48,"s":40,"a":65,"sd":null},{"k":"40:66","t":"Say, [O Muḥammad], \"Indeed, I have been forbidden to worship those you call upon besides Allāh once the clear proofs have come to me from my Lord, and I have been commanded to submit to the Lord of the worlds.\"","j":24,"h":48,"s":40,"a":66,"sd":null}],"juz":24,"hizb":48,"surahs":[40],"sajdah":false}