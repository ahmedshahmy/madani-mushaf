]},{"e":"١٢٦","v":"37:126"}]}],"verses":[{"k":"37:103","t":"And when they had both submitted and he put him down upon his forehead,","j":23,"h":45,"s":37,"a":103,"sd":null},{"k":"37:104","t":"We called to him, \"O Abraham,","j":23,"h":45,"s":37,"a":104,"sd":null},{"k":"37:105","t":"You have fulfilled the vision.\" Indeed, We thus reward the doers of good.","j":23,"h":45,"s":37,"a":105,"sd":null},{"k":"37:106","t":"Indeed, this was the clear trial.","j":23,"h":45,"s":37,"a":106,"sd":null},{"k":"37:107","t":"And We ransomed him with a great sacrifice,","j":23,"h":45,"s":37,"a":107,"sd":null},{"k":"37:108","t":"And We left for him [favorable mention] among later generations:","j":23,"h":45,"s":37,"a":108,"sd":null},{"k":"37:109","t":"\"Peace upon Abraham.\"","j":23,"h":45,"s":37,"a":109,"sd":null},{"k":"37:110","t":"Indeed, We thus reward the doers of good.","j":23,"h":45,"s":37,"a":110,"sd":null},{"k":"37:111","t":"Indeed, he was of Our believing servants.","j":23,"h":45,"s":37,"a":111,"sd":null},{"k":"37:112","t":"And We gave him good tidings of Isaac, a prophet from among the righteous.","j":23,"h":45,"s":37,"a":112,"sd":null},{"k":"37:113","t":"And We blessed him and Isaac. But among their descendants is the doer of good and the clearly unjust to himself [i.e., sinner].","j":23,"h":45,"s":37,"a":113,"sd":null},{"k":"37:114","t":"And We did certainly confer favor upon Moses and Aaron.","j":23,"h":45,"s":37,"a":114,"sd":null},{"k":"37:115","t":"And We saved them and their people from the great affliction,","j":23,"h":45,"s":37,"a":115,"sd":null},{"k":"37:116","t":"And We supported them so it was they who overcame.","j":23,"h":45,"s":37,"a":116,"sd":null},{"k":"37:117","t":"And We gave them the explicit Scripture [i.e., the Torah],","j":23,"h":45,"s":37,"a":117,"sd":null},{"k":"37:118","t":"And We guided them on the straight path.","j":23,"h":45,"s":37,"a":118,"sd":null},{"k":"37:119","t":"And We left for them [favorable mention] among later generations:","j":23,"h":45,"s":37,"a":119,"sd":null},{"k":"37:120","t":"\"Peace upon Moses and Aaron.\"","j":23,"h":45,"s":37,"a":120,"sd":null},{"k":"37:121","t":"Indeed, We thus reward the doers of good.","j":23,"h":45,"s":37,"a":121,"sd":null},{"k":"37:122","t":"Indeed, they were of Our believing servants.","j":23,"h":45,"s":37,"a":122,"sd":null},{"k":"37:123","t":"And indeed, Elias was from among the messengers,","j":23,"h":45,"s":37,"a":123,"sd":null},{"k":"37:124","t":"When he said to his people, \"Will you not fear Allāh?","j":23,"h":45,"s":37,"a":124,"sd":null},{"k":"37:125","t":"Do you call upon Baʿl and leave the best of creators -","j":23,"h":45,"s":37,"a":125,"sd":null},{"k":"37:126","t":"Allāh, your Lord and the Lord of your first forefathers?\"","j":23,"h":45,"s":37,"a":126,"sd":null}],"juz":23,"hizb":45,"surahs":[37],"sajdah":false}