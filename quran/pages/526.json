:"liman","l":12,"g":[["لِ","P","prefix","l:P"],["مَن","REL","stem",""]]},{"i":"53:26:17","a":"يَشَآءُ","t":"He wills","p":"V","tr":"yashāu","f":["IMPF","3MS"],"r":10,"l":54},{"i":"53:26:18","a":"وَيَرْضَىٰٓ","t":"and approves","p":"V","tr":"wayarḍā","f":["IMPF","3MS","MOOD:SUBJ"],"r":150,"l":311,"g":[["وَ","CONJ","prefix","w:CONJ"],["َيَرْ","V","stem","IMPF|3MS|MOOD:SUBJ"]]},{"e":"٢٦","v":"53:26"}]}],"verses":[{"k":"53:1","t":"By the star when it descends,","j":27,"h":53,"s":53,"a":1,"sd":null},{"k":"53:2","t":"Your companion [i.e., Muḥammad] has not strayed, nor has he erred,","j":27,"h":53,"s":53,"a":2,"sd":null},{"k":"53:3","t":"Nor does he speak from [his own] inclination.","j":27,"h":53,"s":53,"a":3,"sd":null},{"k":"53:4","t":"It is not but a revelation revealed,","j":27,"h":53,"s":53,"a":4,"sd":null},{"k":"53:5","t":"Taught to him by one intense in strength [i.e., Gabriel] -","j":27,"h":53,"s":53,"a":5,"sd":null},{"k":"53:6","t":"One of soundness. And he rose to [his] true form","j":27,"h":53,"s":53,"a":6,"sd":null},{"k":"53:7","t":"While he was in the higher [part of the] horizon.","j":27,"h":53,"s":53,"a":7,"sd":null},{"k":"53:8","t":"Then he approached and descended","j":27,"h":53,"s":53,"a":8,"sd":null},{"k":"53:9","t":"And was at a distance of two bow lengths or nearer.","j":27,"h":53,"s":53,"a":9,"sd":null},{"k":"53:10","t":"And he revealed to His Servant what he revealed [i.e., conveyed].","j":27,"h":53,"s":53,"a":10,"sd":null},{"k":"53:11","t":"The heart did not lie [about] what it saw.","j":27,"h":53,"s":53,"a":11,"sd":null},{"k":"53:12","t":"So will you dispute with him over what he saw?","j":27,"h":53,"s":53,"a":12,"sd":null},{"k":"53:13","t":"And he certainly saw him in another descent","j":27,"h":53,"s":53,"a":13,"sd":null},{"k":"53:14","t":"At the Lote Tree of the Utmost Boundary -","j":27,"h":53,"s":53,"a":14,"sd":null},{"k":"53:15","t":"Near it is the Garden of Refuge [i.e., Paradise] -","j":27,"h":53,"s":53,"a":15,"sd":null},{"k":"53:16","t":"When there covered the Lote Tree that which covered [it].","j":27,"h":53,"s":53,"a":16,"sd":null},{"k":"53:17","t":"The sight [of the Prophet (ﷺ)] did not swerve, nor did it transgress [its limit].","j":27,"h":53,"s":53,"a":17,"sd":null},{"k":"53:18","t":"He certainly saw of the greatest signs of his Lord.","j":27,"h":53,"s":53,"a":18,"sd":null},{"k":"53:19","t":"So have you considered al-Lāt and al-ʿUzzā?","j":27,"h":53,"s":53,"a":19,"sd":null},{"k":"53:20","t":"And Manāt, the third - the other one?","j":27,"h":53,"s":53,"a":20,"sd":null},{"k":"53:21","t":"Is the male for you and for Him the female?","j":27,"h":53,"s":53,"a":21,"sd":null},{"k":"53:22","t":"That, then, is an unjust division.","j":27,"h":53,"s":53,"a":22,"sd":null},{"k":"53:23","t":"They are not but [mere] names you have named them - you and your forefathers - for which Allāh has sent down no authority. They follow not except assumption and what [their] souls desire, and there has already come to them from their Lord guidance.","j":27,"h":53,"s":53,"a":23,"sd":null},{"k":"53:24","t":"Or is there for man whatever he wishes?","j":27,"h":53,"s":53,"a":24,"sd":null},{"k":"53:25","t":"Rather, to Allāh belongs the Hereafter and the first [life].","j":27,"h":53,"s":53,"a":25,"sd":null},{"k":"53:26","t":"And how many angels there are in the heavens whose intercession will not avail at all except [only] after Allāh has permitted [it] to whom He wills and approves.","j":27,"h":53,"s":53,"a":26,"sd":null}],"juz":27,"hizb":53,"surahs":[53],"sajdah":false}