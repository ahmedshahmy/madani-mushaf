f":["F","ACC"],"r":114,"l":133,"g":[["ٱل","DET","prefix","Al"],["صَّلَ","N","stem","F|ACC"]]},{"i":"98:5:12","a":"وَيُؤْتُوا۟","t":"and to give","p":"V","tr":"wayu'tū","f":["IMPF","(IV)","3MP","MOOD:SUBJ"],"r":7,"l":45,"g":[["وَ","CONJ","prefix","w:CONJ"],["يُؤْتُ","V","stem","IMPF|(IV)|3MP|MOOD:SUBJ"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"98:5:13","a":"ٱلزَّكَوٰةَ ۚ","t":"the zakah","p":"N","tr":"l-zakata","f":["F","ACC"],"r":185,"l":355,"g":[["ٱل","DET","prefix","Al"],["زَّكَ","N","stem","F|ACC"]]},{"i":"98:5:14","a":"وَذَٰلِكَ","t":"And that","p":"DEM","tr":"wadhālika","f":["MS"],"l":19,"g":[["وَ","REM","prefix","w:REM"],["َذَٰ","DEM","stem","MS"]]},{"i":"98:5:15","a":"دِينُ","t":"(is the) religion","p":"N","tr":"dīnu","f":["M","NOM"],"r":113,"l":116},{"i":"98:5:16","a":"ٱلْقَيِّمَةِ","t":"the correct","p":"N","tr":"l-qayimati","f":["F","GEN"],"r":6,"l":2583,"g":[["ٱلْ","DET","prefix","Al"],["قَيِّمَةِ","N","stem","F|GEN"]]},{"e":"٥","v":"98:5"}]}],"verses":[{"k":"96:13","t":"Have you seen if he denies and turns away -","j":30,"h":60,"s":96,"a":13,"sd":null},{"k":"96:14","t":"Does he not know that Allāh sees?","j":30,"h":60,"s":96,"a":14,"sd":null},{"k":"96:15","t":"No! If he does not desist, We will surely drag him by the forelock","j":30,"h":60,"s":96,"a":15,"sd":null},{"k":"96:16","t":"A lying, sinning forelock.","j":30,"h":60,"s":96,"a":16,"sd":null},{"k":"96:17","t":"Then let him call his associates;","j":30,"h":60,"s":96,"a":17,"sd":null},{"k":"96:18","t":"We will call the angels of Hell.","j":30,"h":60,"s":96,"a":18,"sd":null},{"k":"96:19","t":"No! Do not obey him. But prostrate and draw near [to Allāh].","j":30,"h":60,"s":96,"a":19,"sd":14},{"k":"97:1","t":"Indeed, We sent it [i.e., the Qur’ān] down during the Night of Decree.","j":30,"h":60,"s":97,"a":1,"sd":null},{"k":"97:2","t":"And what can make you know what is the Night of Decree?","j":30,"h":60,"s":97,"a":2,"sd":null},{"k":"97:3","t":"The Night of Decree is better than a thousand months.","j":30,"h":60,"s":97,"a":3,"sd":null},{"k":"97:4","t":"The angels and the Spirit [i.e., Gabriel] descend therein by permission of their Lord for every matter.","j":30,"h":60,"s":97,"a":4,"sd":null},{"k":"97:5","t":"Peace it is until the emergence of dawn.","j":30,"h":60,"s":97,"a":5,"sd":null},{"k":"98:1","t":"Those who disbelieved among the People of the Scripture and the polytheists were not to be parted [from misbelief] until there came to them clear evidence","j":30,"h":60,"s":98,"a":1,"sd":null},{"k":"98:2","t":"A Messenger from Allāh, reciting purified scriptures","j":30,"h":60,"s":98,"a":2,"sd":null},{"k":"98:3","t":"Within which are correct writings [i.e., rulings and laws].","j":30,"h":60,"s":98,"a":3,"sd":null},{"k":"98:4","t":"Nor did those who were given the Scripture become divided until after there had come to them clear evidence.","j":30,"h":60,"s":98,"a":4,"sd":null},{"k":"98:5","t":"And they were not commanded except to worship Allāh, [being] sincere to Him in religion, inclining to truth, and to establish prayer and to give zakāh. And that is the correct religion.","j":30,"h":60,"s":98,"a":5,"sd":null}],"juz":30,"hizb":60,"surahs":[96,97,98],"sajdah":true}