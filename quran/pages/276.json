"],"r":61,"l":286,"g":[["شُرَكَآ","N","stem","MP|ACC"],["هُمْ","PRON","suffix","PRON:3MP"]]},{"i":"16:86:6","a":"قَالُوا۟","t":"They will say","p":"V","tr":"qālū","f":["PERF","3MP"],"r":1,"l":6,"g":[["قَالُ","V","stem","PERF|3MP"],["وا","PRON","suffix","PRON:3MP"]]}]},{"l":13,"t":"a","c":0,"w":[{"i":"16:86:7","a":"رَبَّنَا","t":"Our Lord","p":"N","tr":"rabbanā","f":["M","ACC"],"r":3,"l":10,"g":[["رَبَّ","N","stem","M|ACC"],["نَا","PRON","suffix","PRON:1P"]]},{"i":"16:86:8","a":"هَـٰٓؤُلَآءِ","t":"these","p":"DEM","tr":"hāulāi","f":["P"],"l":37},{"i":"16:86:9","a":"شُرَكَآؤُنَا","t":"(are) our partners","p":"N","tr":"shurakāunā","f":["MP","NOM"],"r":61,"l":286,"g":[["شُرَكَآؤُ","N","stem","MP|NOM"],["نَا","PRON","suffix","PRON:1P"]]},{"i":"16:86:10","a":"ٱلَّذِينَ","t":"those whom","p":"REL","tr":"alladhīna","f":["MP"],"l":7},{"i":"16:86:11","a":"كُنَّا","t":"we used to","p":"V","tr":"kunnā","f":["PERF","1P"],"r":2,"l":9,"g":[["كُ","V","stem","PERF|1P"],["نَّا","PRON","suffix","PRON:1P"]]},{"i":"16:86:12","a":"نَدْعُوا۟","t":"invoke","p":"V","tr":"nadʿū","f":["IMPF","1P"],"r":42,"l":65},{"i":"16:86:13","a":"مِن","t":"besides You","p":"P","tr":"min","l":0},{"i":"16:86:14","a":"دُونِكَ ۖ","t":"besides You","p":"N","tr":"dūnika","f":["GEN"],"r":77,"l":78,"g":[["دُونِ","N","stem","GEN"],["كَ","PRON","suffix","PRON:2MS"]]}]},{"l":14,"t":"a","c":0,"w":[{"i":"16:86:15","a":"فَأَلْقَوْا۟","t":"But they (will) throw back","p":"V","tr":"fa-alqaw","f":["PERF","(IV)","3MP"],"r":76,"l":169,"g":[["فَ","REM","prefix","f:REM"],["أَلْقَ","V","stem","PERF|(IV)|3MP"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"16:86:16","a":"إِلَيْهِمُ","t":"at them","p":"P","tr":"ilayhimu","l":13,"g":[["إِلَيْ","P","stem",""],["هِمُ","PRON","suffix","PRON:3MP"]]},{"i":"16:86:17","a":"ٱلْقَوْلَ","t":"(their) word","p":"N","tr":"l-qawla","f":["VN","M","ACC"],"r":1,"l":117,"g":[["ٱلْ","DET","prefix","Al"],["قَوْلَ","N","stem","VN|M|ACC"]]},{"i":"16:86:18","a":"إِنَّكُمْ","t":"Indeed, you","p":"ACC","tr