|NOM"],["هُۥ","PRON","suffix","PRON:3MS"]]},{"i":"39:67:9","a":"يَوْمَ","t":"(on the) Day","p":"N","tr":"yawma","f":["M","ACC"],"r":13,"l":25},{"i":"39:67:10","a":"ٱلْقِيَـٰمَةِ","t":"(of) the Resurrection","p":"N","tr":"l-qiyāmati","f":["F","GEN"],"r":6,"l":174,"g":[["ٱلْ","DET","prefix","Al"],["ْقِيَـٰ","N","stem","F|GEN"]]},{"i":"39:67:11","a":"وَٱلسَّمَـٰوَٰتُ","t":"and the heavens","p":"N","tr":"wal-samāwātu","f":["FP","NOM"],"r":15,"l":38,"g":[["وَ","CONJ","prefix","w:CONJ"],["َٱ","DET","prefix","Al"],["لسَّمَـٰ","N","stem","FP|NOM"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"39:67:12","a":"مَطْوِيَّـٰتٌۢ","t":"(will be) folded","p":"N","tr":"maṭwiyyātun","f":["PASS","PCPL","FP","INDEF","NOM"],"r":773,"l":3647},{"i":"39:67:13","a":"بِيَمِينِهِۦ ۚ","t":"in His Right Hand","p":"N","tr":"biyamīnihi","f":["M","GEN"],"r":153,"l":184,"g":[["بِ","P","prefix","bi"],["يَمِينِ","N","stem","M|GEN"],["هِۦ","PRON","suffix","PRON:3MS"]]},{"i":"39:67:14","a":"سُبْحَـٰنَهُۥ","t":"Glory be to Him","p":"N","tr":"sub'ḥānahu","f":["M","ACC"],"r":122,"l":285,"g":[["سُبْحَـٰ","N","stem","M|ACC"],["َـٰ","PRON","suffix","PRON:3MS"]]},{"i":"39:67:15","a":"وَتَعَـٰلَىٰ","t":"And High is He","p":"V","tr":"wataʿālā","f":["PERF","3MS"],"r":154,"l":520,"g":[["وَ","CONJ","prefix","w:CONJ"],["َتَعَـٰ","V","stem","PERF|3MS"]]},{"i":"39:67:16","a":"عَمَّا","t":"above what","p":"P","tr":"ʿammā","l":21,"g":[["عَ","P","stem",""],["مَّا","REL","stem",""]]},{"i":"39:67:17","a":"يُشْرِكُونَ","t":"they associate (with Him)","p":"V","tr":"yush'rikūna","f":["IMPF","(IV)","3MP"],"r":61,"l":168,"g":[["يُشْرِكُ","V","stem","IMPF|(IV)|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"e":"٦٧","v":"39:67"}]}],"verses":[{"k":"39:57","t":"Or [lest] it say, \"If only Allāh had guided me, I would have been among the righteous.\"","j":24,"h":47,"s":39,"a":57,"sd":null},{"k":"39:58","t":"Or [lest] it say when it sees the punishment, \"If only I had another turn so I could be among the doers of good.\"","j":24,"h":47,"s":39,"a":58,"sd":null},{"k":"39:59","t":"But yes, there had come to you My verses, but you denied them and were arrogant, and you were among the disbelievers.","j":24,"h":47,"s":39,"a":59,"sd":null},{"k":"39:60","t":"And on the Day of Resurrection you will see those who lied about Allāh [with] their faces blackened. Is there not in Hell a residence for the arrogant?","j":24,"h":47,"s":39,"a":60,"sd":null},{"k":"39:61","t":"And Allāh will save those who feared Him by their attainment; no evil will touch them, nor will they grieve.","j":24,"h":47,"s":39,"a":61,"sd":null},{"k":"39:62","t":"Allāh is the Creator of all things, and He is, over all things, Disposer of affairs.","j":24,"h":47,"s":39,"a":62,"sd":null},{"k":"39:63","t":"To Him belong the keys of the heavens and the earth. And they who disbelieve in the verses of Allāh - it is those who are the losers.","j":24,"h":47,"s":39,"a":63,"sd":null},{"k":"39:64","t":"Say, [O Muḥammad], \"Is it other than Allāh that you order me to worship, O ignorant ones?\"","j":24,"h":47,"s":39,"a":64,"sd":null},{"k":"39:65","t":"And it was already revealed to you and to those before you that if you should associate [anything] with Allāh, your work would surely become worthless, and you would surely be among the losers.","j":24,"h":47,"s":39,"a":65,"sd":null},{"k":"39:66","t":"Rather, worship [only] Allāh and be among the grateful.","j":24,"h":47,"s":39,"a":66,"sd":null},{"k":"39:67","t":"They have not appraised Allāh with true appraisal, while the earth entirely will be [within] His grip on the Day of Resurrection, and the heavens will be folded in His right hand. Exalted is He and high above what they associate with Him.","j":24,"h":47,"s":39,"a":67,"sd":null}],"juz":24,"hizb":47,"surahs":[39],"sajdah":false}