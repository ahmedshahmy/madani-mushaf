":37,"s":26,"a":67,"sd":null},{"k":"26:68","t":"And indeed, your Lord - He is the Exalted in Might, the Merciful.","j":19,"h":37,"s":26,"a":68,"sd":null},{"k":"26:69","t":"And recite to them the news of Abraham,","j":19,"h":37,"s":26,"a":69,"sd":null},{"k":"26:70","t":"When he said to his father and his people, \"What do you worship?\"","j":19,"h":37,"s":26,"a":70,"sd":null},{"k":"26:71","t":"They said, \"We worship idols and remain to them devoted.\"","j":19,"h":37,"s":26,"a":71,"sd":null},{"k":"26:72","t":"He said, \"Do they hear you when you supplicate?","j":19,"h":37,"s":26,"a":72,"sd":null},{"k":"26:73","t":"Or do they benefit you, or do they harm?\"","j":19,"h":37,"s":26,"a":73,"sd":null},{"k":"26:74","t":"They said, \"But we found our fathers doing thus.\"","j":19,"h":37,"s":26,"a":74,"sd":null},{"k":"26:75","t":"He said, \"Then do you see what you have been worshipping,","j":19,"h":37,"s":26,"a":75,"sd":null},{"k":"26:76","t":"You and your ancient forefathers?","j":19,"h":37,"s":26,"a":76,"sd":null},{"k":"26:77","t":"Indeed, they are enemies to me, except the Lord of the worlds,","j":19,"h":37,"s":26,"a":77,"sd":null},{"k":"26:78","t":"Who created me, and He [it is who] guides me.","j":19,"h":37,"s":26,"a":78,"sd":null},{"k":"26:79","t":"And it is He who feeds me and gives me drink.","j":19,"h":37,"s":26,"a":79,"sd":null},{"k":"26:80","t":"And when I am ill, it is He who cures me","j":19,"h":37,"s":26,"a":80,"sd":null},{"k":"26:81","t":"And who will cause me to die and then bring me to life","j":19,"h":37,"s":26,"a":81,"sd":null},{"k":"26:82","t":"And who I aspire that He will forgive me my sin on the Day of Recompense.\"","j":19,"h":37,"s":26,"a":82,"sd":null},{"k":"26:83","t":"[And he said], \"My Lord, grant me authority and join me with the righteous.","j":19,"h":37,"s":26,"a":83,"sd":null}],"juz":19,"hizb":37,"surahs":[26],"sajdah":false}