,"t":"indeed, I am","p":"ACC","tr":"innī","l":5,"g":[["إِنِّ","ACC","stem",""],["ى","PRON","suffix","PRON:1S"]]},{"i":"39:39:7","a":"عَـٰمِلٌۭ ۖ","t":"working","p":"N","tr":"ʿāmilun","f":["ACT","PCPL","M","INDEF","NOM"],"r":18,"l":717},{"i":"39:39:8","a":"فَسَوْفَ","t":"then soon","p":"FUT","tr":"fasawfa","l":278,"g":[["فَ","REM","prefix","f:REM"],["سَوْفَ","FUT","stem",""]]},{"i":"39:39:9","a":"تَعْلَمُونَ","t":"you will know","p":"V","tr":"taʿlamūna","f":["IMPF","2MP"],"r":5,"l":29,"g":[["تَعْلَمُ","V","stem","IMPF|2MP"],["ونَ","PRON","suffix","PRON:2MP"]]},{"e":"٣٩","v":"39:39"}]},{"l":15,"t":"a","c":0,"w":[{"i":"39:40:1","a":"مَن","t":"(Upon) whom","p":"REL","tr":"man","l":12},{"i":"39:40:2","a":"يَأْتِيهِ","t":"will come","p":"V","tr":"yatīhi","f":["IMPF","3MS"],"r":7,"l":48,"g":[["يَأْتِي","V","stem","IMPF|3MS"],["هِ","PRON","suffix","PRON:3MS"]]},{"i":"39:40:3","a":"عَذَابٌۭ","t":"a punishment","p":"N","tr":"ʿadhābun","f":["M","INDEF","NOM"],"r":17,"l":36},{"i":"39:40:4","a":"يُخْزِيهِ","t":"disgracing him","p":"V","tr":"yukh'zīhi","f":["IMPF","(IV)","3MS"],"r":342,"l":716,"g":[["يُخْزِي","V","stem","IMPF|(IV)|3MS"],["هِ","PRON","suffix","PRON:3MS"]]},{"i":"39:40:5","a":"وَيَحِلُّ","t":"and descends","p":"V","tr":"wayaḥillu","f":["IMPF","3MS"],"r":198,"l":655,"g":[["وَ","CONJ","prefix","w:CONJ"],["يَحِلُّ","V","stem","IMPF|3MS"]]},{"i":"39:40:6","a":"عَلَيْهِ","t":"on him","p":"P","tr":"ʿalayhi","l":8,"g":[["عَلَيْ","P","stem",""],["هِ","PRON","suffix","PRON:3MS"]]},{"i":"39:40:7","a":"عَذَابٌۭ","t":"a punishment","p":"N","tr":"ʿadhābun","f":["M","INDEF","NOM"],"r":17,"l":36},{"i":"39:40:8","a":"مُّقِيمٌ","t":"everlasting","p":"N","tr":"muqīmun","f":["ACT","PCPL","(IV)","M","INDEF","NOM"],"r":6,"l":851},{"e":"٤٠","v":"39:40"}]}],"verses":[{"k":"39:32","t":"So who is more unjust than one who lies about Allāh and denies the truth when it has come to him? Is there not in Hell a residence for the disbelievers?","j":24,"h":47,"s":39,"a":32,"sd":null},{"k":"39:33","t":"And the one who has brought the truth [i.e., the Prophet (ﷺ)] and [they who] believed in it - those are the righteous.","j":24,"h":47,"s":39,"a":33,"sd":null},{"k":"39:34","t":"They will have whatever they desire with their Lord. That is the reward of the doers of good -","j":24,"h":47,"s":39,"a":34,"sd":null},{"k":"39:35","t":"That Allāh may remove from them the worst of what they did and reward them their due for the best of what they used to do.","j":24,"h":47,"s":39,"a":35,"sd":null},{"k":"39:36","t":"Is not Allāh sufficient for His Servant [i.e., Prophet Muḥammad (ﷺ)]? And [yet], they threaten you with those [they worship] other than Him. And whoever Allāh leaves astray - for him there is no guide.","j":24,"h":47,"s":39,"a":36,"sd":null},{"k":"39:37","t":"And whoever Allāh guides - for him there is no misleader. Is not Allāh Exalted in Might and Owner of Retribution?","j":24,"h":47,"s":39,"a":37,"sd":null},{"k":"39:38","t":"And if you asked them, \"Who created the heavens and the earth?\" they would surely say, \"Allāh.\" Say, \"Then have you considered what you invoke besides Allāh? If Allāh intended me harm, are they removers of His harm; or if He intended me mercy, are they withholders of His mercy?\" Say, \"Sufficient for me is Allāh; upon Him [alone] rely the [wise] reliers.\"","j":24,"h":47,"s":39,"a":38,"sd":null},{"k":"39:39","t":"Say, \"O my people, work according to your position, [for] indeed, I am working; and you are going to know","j":24,"h":47,"s":39,"a":39,"sd":null},{"k":"39:40","t":"To whom will come a torment disgracing him and on whom will descend an enduring punishment.\"","j":24,"h":47,"s":39,"a":40,"sd":null}],"juz":24,"hizb":47,"surahs":[39],"sajdah":false}