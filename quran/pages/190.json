"PRON:3FS"]]},{"i":"9:26:13","a":"وَعَذَّبَ","t":"and He punished","p":"V","tr":"waʿadhaba","f":["PERF","(II)","3MS"],"r":17,"l":280,"g":[["وَ","CONJ","prefix","w:CONJ"],["عَذَّبَ","V","stem","PERF|(II)|3MS"]]},{"i":"9:26:14","a":"ٱلَّذِينَ","t":"those who","p":"REL","tr":"alladhīna","f":["MP"],"l":7},{"i":"9:26:15","a":"كَفَرُوا۟ ۚ","t":"disbelieved","p":"V","tr":"kafarū","f":["PERF","3MP"],"r":8,"l":40,"g":[["كَفَرُ","V","stem","PERF|3MP"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"9:26:16","a":"وَذَٰلِكَ","t":"And that","p":"DEM","tr":"wadhālika","f":["MS"],"l":19,"g":[["وَ","CONJ","prefix","w:CONJ"],["َذَٰ","DEM","stem","MS"]]},{"i":"9:26:17","a":"جَزَآءُ","t":"(is) the recompense","p":"N","tr":"jazāu","f":["M","NOM"],"r":97,"l":275},{"i":"9:26:18","a":"ٱلْكَـٰفِرِينَ","t":"(of) the disbelievers","p":"N","tr":"l-kāfirīna","f":["ACT","PCPL","MP","GEN"],"r":8,"l":90,"g":[["ٱلْ","DET","prefix","Al"],["ْكَـٰفِ","N","stem","ACT|PCPL|MP|GEN"]]},{"e":"٢٦","v":"9:26"}]}],"verses":[{"k":"9:21","t":"Their Lord gives them good tidings of mercy from Him and approval and of gardens for them wherein is enduring pleasure.","j":10,"h":19,"s":9,"a":21,"sd":null},{"k":"9:22","t":"[They will be] abiding therein forever. Indeed, Allāh has with Him a great reward.","j":10,"h":19,"s":9,"a":22,"sd":null},{"k":"9:23","t":"O you who have believed, do not take your fathers or your brothers as allies if they have preferred disbelief over belief. And whoever does so among you - then it is those who are the wrongdoers.","j":10,"h":19,"s":9,"a":23,"sd":null},{"k":"9:24","t":"Say, [O Muḥammad], \"If your fathers, your sons, your brothers, your wives, your relatives, wealth which you have obtained, commerce wherein you fear decline, and dwellings with which you are pleased are more beloved to you than Allāh and His Messenger and jihād [i.e., striving] in His cause, then wait until Allāh executes His command. And Allāh does not guide the defiantly disobedient people.\"","j":10,"h":19,"s":9,"a":24,"sd":null},{"k":"9:25","t":"Allāh has already given you victory in many regions and [even] on the day of Ḥunayn, when your great number pleased you, but it did not avail you at all, and the earth was confining for you with [i.e., in spite of] its vastness; then you turned back, fleeing.","j":10,"h":19,"s":9,"a":25,"sd":null},{"k":"9:26","t":"Then Allāh sent down His tranquility upon His Messenger and upon the believers and sent down soldiers [i.e., angels] whom you did not see and punished those who disbelieved. And that is the recompense of the disbelievers.","j":10,"h":19,"s":9,"a":26,"sd":null}],"juz":10,"hizb":19,"surahs":[9],"sajdah":false}