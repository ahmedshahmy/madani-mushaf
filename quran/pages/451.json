(VIII)","3MS"],"r":434,"l":754,"g":[["أَ","INTG","prefix","A:INTG"],["صْطَفَى","V","stem","PERF|(VIII)|3MS"]]},{"i":"37:153:2","a":"ٱلْبَنَاتِ","t":"[the] daughters","p":"N","tr":"l-banāti","f":["FP","GEN"],"r":53,"l":570,"g":[["ٱلْ","DET","prefix","Al"],["بَنَاتِ","N","stem","FP|GEN"]]},{"i":"37:153:3","a":"عَلَى","t":"over","p":"P","tr":"ʿalā","l":8},{"i":"37:153:4","a":"ٱلْبَنِينَ","t":"sons","p":"N","tr":"l-banīna","f":["MP","GEN"],"r":53,"l":141,"g":[["ٱلْ","DET","prefix","Al"],["بَنِينَ","N","stem","MP|GEN"]]},{"e":"١٥٣","v":"37:153"}]}],"verses":[{"k":"37:127","t":"And they denied him, so indeed, they will be brought [for punishment],","j":23,"h":45,"s":37,"a":127,"sd":null},{"k":"37:128","t":"Except the chosen servants of Allāh.","j":23,"h":45,"s":37,"a":128,"sd":null},{"k":"37:129","t":"And We left for him [favorable mention] among later generations:","j":23,"h":45,"s":37,"a":129,"sd":null},{"k":"37:130","t":"\"Peace upon Elias.\"","j":23,"h":45,"s":37,"a":130,"sd":null},{"k":"37:131","t":"Indeed, We thus reward the doers of good.","j":23,"h":45,"s":37,"a":131,"sd":null},{"k":"37:132","t":"Indeed, he was of Our believing servants.","j":23,"h":45,"s":37,"a":132,"sd":null},{"k":"37:133","t":"And indeed, Lot was among the messengers.","j":23,"h":45,"s":37,"a":133,"sd":null},{"k":"37:134","t":"[So mention] when We saved him and his family, all,","j":23,"h":45,"s":37,"a":134,"sd":null},{"k":"37:135","t":"Except an old woman [i.e., his wife] among those who remained [with the evildoers].","j":23,"h":45,"s":37,"a":135,"sd":null},{"k":"37:136","t":"Then We destroyed the others.","j":23,"h":45,"s":37,"a":136,"sd":null},{"k":"37:137","t":"And indeed, you pass by them in the morning","j":23,"h":45,"s":37,"a":137,"sd":null},{"k":"37:138","t":"And at night. Then will you not use reason?","j":23,"h":45,"s":37,"a":138,"sd":null},{"k":"37:139","t":"And indeed, Jonah was among the messengers.","j":23,"h":45,"s":37,"a":139,"sd":null},{"k":"37:140","t":"[Mention] when he ran away to the laden ship.","j":23,"h":45,"s":37,"a":140,"sd":null},{"k":"37:141","t":"And he drew lots and was among the losers.","j":23,"h":45,"s":37,"a":141,"sd":null},{"k":"37:142","t":"Then the fish swallowed him, while he was blameworthy.","j":23,"h":45,"s":37,"a":142,"sd":null},{"k":"37:143","t":"And had he not been of those who exalt Allāh,","j":23,"h":45,"s":37,"a":143,"sd":null},{"k":"37:144","t":"He would have remained inside its belly until the Day they are resurrected.","j":23,"h":45,"s":37,"a":144,"sd":null},{"k":"37:145","t":"But We threw him onto the open shore while he was ill.","j":23,"h":46,"s":37,"a":145,"sd":null},{"k":"37:146","t":"And We caused to grow over him a gourd vine.","j":23,"h":46,"s":37,"a":146,"sd":null},{"k":"37:147","t":"And We sent him to [his people of] a hundred thousand or more.","j":23,"h":46,"s":37,"a":147,"sd":null},{"k":"37:148","t":"And they believed, so We gave them enjoyment [of life] for a time.","j":23,"h":46,"s":37,"a":148,"sd":null},{"k":"37:149","t":"So inquire of them, [O Muḥammad], \"Does your Lord have daughters while they have sons?","j":23,"h":46,"s":37,"a":149,"sd":null},{"k":"37:150","t":"Or did We create the angels as females while they were witnesses?\"","j":23,"h":46,"s":37,"a":150,"sd":null},{"k":"37:151","t":"Unquestionably, it is out of their [invented] falsehood that they say,","j":23,"h":46,"s":37,"a":151,"sd":null},{"k":"37:152","t":"\"Allāh has begotten,\" and indeed, they are liars.","j":23,"h":46,"s":37,"a":152,"sd":null},{"k":"37:153","t":"Has He chosen daughters over sons?","j":23,"h":46,"s":37,"a":153,"sd":null}],"juz":23,"hizb":45,"surahs":[37],"sajdah":false}