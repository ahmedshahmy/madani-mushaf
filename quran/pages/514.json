em","IMPF|(IV)|3MS|MOOD:SUBJ"],["هُۥ","PRON","suffix","PRON:3MS"]]},{"i":"48:28:9","a":"عَلَى","t":"over","p":"P","tr":"ʿalā","l":8},{"i":"48:28:10","a":"ٱلدِّينِ","t":"the religions","p":"N","tr":"l-dīni","f":["M","GEN"],"r":113,"l":116,"g":[["ٱل","DET","prefix","Al"],["دِّينِ","N","stem","M|GEN"]]},{"i":"48:28:11","a":"كُلِّهِۦ ۚ","t":"all","p":"N","tr":"kullihi","f":["M","GEN"],"r":16,"l":31,"g":[["كُلِّ","N","stem","M|GEN"],["هِۦ","PRON","suffix","PRON:3MS"]]},{"i":"48:28:12","a":"وَكَفَىٰ","t":"And sufficient is","p":"V","tr":"wakafā","f":["PERF","3MS"],"r":278,"l":352,"g":[["وَ","CONJ","prefix","w:CONJ"],["َكَفَ","V","stem","PERF|3MS"]]},{"i":"48:28:13","a":"بِٱللَّهِ","t":"Allah","p":"PN","tr":"bil-lahi","f":["GEN"],"r":0,"l":1,"g":[["بِ","P","prefix","bi"],["ٱللَّهِ","PN","stem","GEN"]]},{"i":"48:28:14","a":"شَهِيدًۭا","t":"(as) a Witness","p":"ADJ","tr":"shahīdan","f":["MS","INDEF","ACC"],"r":67,"l":214},{"e":"٢٨","v":"48:28"}]}],"verses":[{"k":"48:24","t":"And it is He who withheld their hands from you and your hands from them within [the area of] Makkah after He caused you to overcome them. And ever is Allāh, of what you do, Seeing.","j":26,"h":52,"s":48,"a":24,"sd":null},{"k":"48:25","t":"They are the ones who disbelieved and obstructed you from al-Masjid al-Ḥarām while the offering was prevented from reaching its place of sacrifice. And if not for believing men and believing women whom you did not know - that you might trample [i.e., kill] them and there would befall you because of them dishonor without [your] knowledge - [you would have been permitted to enter Makkah]. [This was so] that Allāh might admit to His mercy whom He willed. If they had been apart [from them], We would have punished those who disbelieved among them with painful punishment","j":26,"h":52,"s":48,"a":25,"sd":null},{"k":"48:26","t":"When those who disbelieved had put into their hearts chauvinism - the chauvinism of the time of ignorance. But Allāh sent down His tranquility upon His Messenger and upon the believers and imposed upon them the word of righteousness, and they were more deserving of it and worthy of it. And ever is Allāh, of all things, Knowing.","j":26,"h":52,"s":48,"a":26,"sd":null},{"k":"48:27","t":"Certainly has Allāh showed to His Messenger the vision [i.e., dream] in truth. You will surely enter al-Masjid al-Ḥarām, if Allāh wills, in safety, with your heads shaved and [hair] shortened, not fearing [anyone]. He knew what you did not know and has arranged before that a conquest near [at hand].","j":26,"h":52,"s":48,"a":27,"sd":null},{"k":"48:28","t":"It is He who sent His Messenger with guidance and the religion of truth to manifest it over all religion. And sufficient is Allāh as Witness.","j":26,"h":52,"s":48,"a":28,"sd":null}],"juz":26,"hizb":52,"surahs":[48],"sajdah":false}