6","a":"وَمَتَـٰعٌ","t":"and an enjoyment","p":"N","tr":"wamatāʿun","f":["M","INDEF","NOM"],"r":156,"l":330,"g":[["وَ","CONJ","prefix","w:CONJ"],["َمَتَـٰ","N","stem","M|INDEF|NOM"]]},{"i":"21:111:7","a":"إِلَىٰ","t":"for","p":"P","tr":"ilā","l":13},{"i":"21:111:8","a":"حِينٍۢ","t":"a time","p":"N","tr":"ḥīnin","f":["M","INDEF","GEN"],"r":263,"l":328},{"e":"١١١","v":"21:111"},{"i":"21:112:1","a":"قَـٰلَ","t":"He said","p":"V","tr":"qāla","f":["PERF","3MS"],"r":1,"l":6},{"i":"21:112:2","a":"رَبِّ","t":"My Lord","p":"N","tr":"rabbi","f":["M","ACC"],"r":3,"l":10,"g":[["رَبِّ","N","stem","M|ACC"],["","PRON","suffix","PRON:1S"]]},{"i":"21:112:3","a":"ٱحْكُم","t":"judge","p":"V","tr":"uḥ'kum","f":["IMPV","2MS"],"r":43,"l":258}]},{"l":14,"t":"a","c":0,"w":[{"i":"21:112:4","a":"بِٱلْحَقِّ ۗ","t":"in truth","p":"N","tr":"bil-ḥaqi","f":["M","GEN"],"r":29,"l":50,"g":[["بِ","P","prefix","bi"],["ٱلْ","DET","prefix","Al"],["حَقِّ","N","stem","M|GEN"]]},{"i":"21:112:5","a":"وَرَبُّنَا","t":"And our Lord","p":"N","tr":"warabbunā","f":["M","NOM"],"r":3,"l":10,"g":[["وَ","CONJ","prefix","w:CONJ"],["رَبُّ","N","stem","M|NOM"],["نَا","PRON","suffix","PRON:1P"]]},{"i":"21:112:6","a":"ٱلرَّحْمَـٰنُ","t":"(is) the Most Gracious","p":"ADJ","tr":"l-raḥmānu","f":["MS","NOM"],"r":20,"l":212,"g":[["ٱل","DET","prefix","Al"],["رَّحْ","ADJ","stem","MS|NOM"]]},{"i":"21:112:7","a":"ٱلْمُسْتَعَانُ","t":"the One Whose help is sought","p":"N","tr":"l-mus'taʿānu","f":["PASS","PCPL","(X)","M","NOM"],"r":543,"l":2505,"g":[["ٱلْ","DET","prefix","Al"],["مُسْتَعَانُ","N","stem","PASS|PCPL|(X)|M|NOM"]]},{"i":"21:112:8","a":"عَلَىٰ","t":"against","p":"P","tr":"ʿalā","l":8},{"i":"21:112:9","a":"مَا","t":"what","p":"REL","tr":"mā","l":2},{"i":"21:112:10","a":"تَصِفُونَ","t":"you attribute","p":"V","tr":"taṣifūna","f":["IMPF","2MP"],"r":479,"l":702,"g":[["تَصِفُ","V","stem","IMPF|2MP"],["ونَ","PRON","suffix","PRON:2MP"]]},{"e":"١١٢","v":"21:112"}]},{"l":15,"t":"s","s":22}],"verses":[{"k":"21:102","t":"They will not hear its sound, while they are, in that which their souls desire, abiding eternally.","j":17,"h":33,"s":21,"a":102,"sd":null},{"k":"21:103","t":"They will not be grieved by the greatest terror, and the angels will meet them, [saying], \"This is your Day which you have been promised\" -","j":17,"h":33,"s":21,"a":103,"sd":null},{"k":"21:104","t":"The Day when We will fold the heaven like the folding of a [written] sheet for the records. As We began the first creation, We will repeat it. [That is] a promise binding upon Us. Indeed, We will do it.","j":17,"h":33,"s":21,"a":104,"sd":null},{"k":"21:105","t":"And We have already written in the book [of Psalms] after the [previous] mention that the land [of Paradise] is inherited by My righteous servants.","j":17,"h":33,"s":21,"a":105,"sd":null},{"k":"21:106","t":"Indeed, in this [Qur’ān] is notification for a worshipping people.","j":17,"h":33,"s":21,"a":106,"sd":null},{"k":"21:107","t":"And We have not sent you, [O Muḥammad], except as a mercy to the worlds.","j":17,"h":33,"s":21,"a":107,"sd":null},{"k":"21:108","t":"Say, \"It is only revealed to me that your god is but one God; so will you be Muslims [in submission to Him]?\"","j":17,"h":33,"s":21,"a":108,"sd":null},{"k":"21:109","t":"But if they turn away, then say, \"I have announced to [all of] you equally. And I know not whether near or far is that which you are promised.","j":17,"h":33,"s":21,"a":109,"sd":null},{"k":"21:110","t":"Indeed, He knows what is declared of speech, and He knows what you conceal.","j":17,"h":33,"s":21,"a":110,"sd":null},{"k":"21:111","t":"And I know not; perhaps it is a trial for you and enjoyment for a time.\"","j":17,"h":33,"s":21,"a":111,"sd":null},{"k":"21:112","t":"[The Prophet (ﷺ)] has said, \"My Lord, judge [between us] in truth. And our Lord is the Most Merciful, the one whose help is sought against that which you describe.\"","j":17,"h":33,"s":21,"a":112,"sd":null}],"juz":17,"hizb":33,"surahs":[21],"sajdah":false}