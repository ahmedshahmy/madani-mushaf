"stem","ACT|PCPL|M|NOM"]]},{"i":"54:6:6","a":"إِلَىٰ","t":"to","p":"P","tr":"ilā","l":13},{"i":"54:6:7","a":"شَىْءٍۢ","t":"a thing","p":"N","tr":"shayin","f":["M","INDEF","GEN"],"r":10,"l":41},{"i":"54:6:8","a":"نُّكُرٍ","t":"terrible","p":"ADJ","tr":"nukurin","f":["MS","INDEF","GEN"],"r":253,"l":4097},{"e":"٦","v":"54:6"}]}],"verses":[{"k":"53:45","t":"And that He creates the two mates - the male and female -","j":27,"h":53,"s":53,"a":45,"sd":null},{"k":"53:46","t":"From a sperm-drop when it is emitted","j":27,"h":53,"s":53,"a":46,"sd":null},{"k":"53:47","t":"And that [incumbent] upon Him is the other [i.e., next] creation.","j":27,"h":53,"s":53,"a":47,"sd":null},{"k":"53:48","t":"And that it is He who enriches and suffices","j":27,"h":53,"s":53,"a":48,"sd":null},{"k":"53:49","t":"And that it is He who is the Lord of Sirius.","j":27,"h":53,"s":53,"a":49,"sd":null},{"k":"53:50","t":"And that He destroyed the first [people of] ʿAad.","j":27,"h":53,"s":53,"a":50,"sd":null},{"k":"53:51","t":"And Thamūd - and He did not spare [them] -","j":27,"h":53,"s":53,"a":51,"sd":null},{"k":"53:52","t":"And the people of Noah before. Indeed, it was they who were [even] more unjust and oppressing.","j":27,"h":53,"s":53,"a":52,"sd":null},{"k":"53:53","t":"And the overturned towns He hurled down.","j":27,"h":53,"s":53,"a":53,"sd":null},{"k":"53:54","t":"And covered them by that which He covered.","j":27,"h":53,"s":53,"a":54,"sd":null},{"k":"53:55","t":"Then which of the favors of your Lord do you doubt?","j":27,"h":53,"s":53,"a":55,"sd":null},{"k":"53:56","t":"This [Prophet (ﷺ)] is a warner from [i.e., like] the former warners.","j":27,"h":53,"s":53,"a":56,"sd":null},{"k":"53:57","t":"The Approaching Day has approached.","j":27,"h":53,"s":53,"a":57,"sd":null},{"k":"53:58","t":"Of it, [from those] besides Allāh, there is no remover.","j":27,"h":53,"s":53,"a":58,"sd":null},{"k":"53:59","t":"Then at this statement do you wonder?","j":27,"h":53,"s":53,"a":59,"sd":null},{"k":"53:60","t":"And you laugh and do not weep","j":27,"h":53,"s":53,"a":60,"sd":null},{"k":"53:61","t":"While you are proudly sporting?","j":27,"h":53,"s":53,"a":61,"sd":null},{"k":"53:62","t":"So prostrate to Allāh and worship [Him].","j":27,"h":53,"s":53,"a":62,"sd":12},{"k":"54:1","t":"The Hour has come near, and the moon has split [in two].","j":27,"h":53,"s":54,"a":1,"sd":null},{"k":"54:2","t":"And if they see a sign [i.e., miracle], they turn away and say, \"Passing magic.\"","j":27,"h":53,"s":54,"a":2,"sd":null},{"k":"54:3","t":"And they denied and followed their inclinations. But for every matter is a [time of] settlement.","j":27,"h":53,"s":54,"a":3,"sd":null},{"k":"54:4","t":"And there has already come to them of information that in which there is deterrence.","j":27,"h":53,"s":54,"a":4,"sd":null},{"k":"54:5","t":"Extensive wisdom - but warning does not avail [them].","j":27,"h":53,"s":54,"a":5,"sd":null},{"k":"54:6","t":"So leave them, [O Muḥammad]. The Day the Caller calls to something forbidding,","j":27,"h":53,"s":54,"a":6,"sd":null}],"juz":27,"hizb":53,"surahs":[53,54],"sajdah":true}