PCPL|FP|GEN"]]},{"i":"40:58:9","a":"وَلَا","t":"and not","p":"NEG","tr":"walā","l":4,"g":[["وَ","CONJ","prefix","w:CONJ"],["لَا","NEG","stem",""]]},{"i":"40:58:10","a":"ٱلْمُسِىٓءُ ۚ","t":"the evildoer","p":"N","tr":"l-musīu","f":["ACT","PCPL","(IV)","M","NOM"],"r":64,"l":3851,"g":[["ٱلْ","DET","prefix","Al"],["مُسِىٓ","N","stem","ACT|PCPL|(IV)|M|NOM"]]},{"i":"40:58:11","a":"قَلِيلًۭا","t":"Little","p":"ADJ","tr":"qalīlan","f":["MS","INDEF","ACC"],"r":142,"l":173},{"i":"40:58:12","a":"مَّا","t":"(is) what","p":"REL","tr":"mā","l":2},{"i":"40:58:13","a":"تَتَذَكَّرُونَ","t":"you take heed","p":"V","tr":"tatadhakkarūna","f":["IMPF","(V)","2MP"],"r":28,"l":233,"g":[["تَتَذَكَّرُ","V","stem","IMPF|(V)|2MP"],["ونَ","PRON","suffix","PRON:2MP"]]},{"e":"٥٨","v":"40:58"}]}],"verses":[{"k":"40:50","t":"They will say, \"Did there not come to you your messengers with clear proofs?\" They will say, \"Yes.\" They will reply, \"Then supplicate [yourselves], but the supplication of the disbelievers is not except in error [i.e., futility].\"","j":24,"h":48,"s":40,"a":50,"sd":null},{"k":"40:51","t":"Indeed, We will support Our messengers and those who believe during the life of this world and on the Day when the witnesses will stand -","j":24,"h":48,"s":40,"a":51,"sd":null},{"k":"40:52","t":"The Day their excuse will not benefit the wrongdoers, and they will have the curse, and they will have the worst home [i.e., Hell].","j":24,"h":48,"s":40,"a":52,"sd":null},{"k":"40:53","t":"And We had certainly given Moses guidance, and We caused the Children of Israel to inherit the Scripture","j":24,"h":48,"s":40,"a":53,"sd":null},{"k":"40:54","t":"As guidance and a reminder for those of understanding.","j":24,"h":48,"s":40,"a":54,"sd":null},{"k":"40:55","t":"So be patient, [O Muḥammad]. Indeed, the promise of Allāh is truth. And ask forgiveness for your sin and exalt [Allāh] with praise of your Lord in the evening and the morning.","j":24,"h":48,"s":40,"a":55,"sd":null},{"k":"40:56","t":"Indeed, those who dispute concerning the signs of Allāh without [any] evidence having come to them - there is not within their breasts except pride, [the extent of] which they cannot reach. So seek refuge in Allāh. Indeed, it is He who is the Hearing, the Seeing.","j":24,"h":48,"s":40,"a":56,"sd":null},{"k":"40:57","t":"The creation of the heavens and earth is greater than the creation of mankind, but most of the people do not know.","j":24,"h":48,"s":40,"a":57,"sd":null},{"k":"40:58","t":"And not equal are the blind and the seeing, nor are those who believe and do righteous deeds and the evildoer. Little do you remember.","j":24,"h":48,"s":40,"a":58,"sd":null}],"juz":24,"hizb":48,"surahs":[40],"sajdah":false}