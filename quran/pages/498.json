"N","tr":"bilisānika","f":["M","GEN"],"r":351,"l":428,"g":[["بِ","P","prefix","bi"],["لِسَانِ","N","stem","M|GEN"],["كَ","PRON","suffix","PRON:2MS"]]}]},{"l":14,"t":"a","c":0,"w":[{"i":"44:58:4","a":"لَعَلَّهُمْ","t":"so that they may","p":"ACC","tr":"laʿallahum","l":96,"g":[["لَعَلَّ","ACC","stem",""],["هُمْ","PRON","suffix","PRON:3MP"]]},{"i":"44:58:5","a":"يَتَذَكَّرُونَ","t":"take heed","p":"V","tr":"yatadhakkarūna","f":["IMPF","(V)","3MP"],"r":28,"l":233,"g":[["يَتَذَكَّرُ","V","stem","IMPF|(V)|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"e":"٥٨","v":"44:58"},{"i":"44:59:1","a":"فَٱرْتَقِبْ","t":"So watch","p":"V","tr":"fa-ir'taqib","f":["IMPV","(VIII)","2MS"],"r":365,"l":1696,"g":[["فَ","REM","prefix","f:REM"],["ٱرْتَقِبْ","V","stem","IMPV|(VIII)|2MS"]]},{"i":"44:59:2","a":"إِنَّهُم","t":"indeed, they","p":"ACC","tr":"innahum","l":5,"g":[["إِنَّ","ACC","stem",""],["هُم","PRON","suffix","PRON:3MP"]]},{"i":"44:59:3","a":"مُّرْتَقِبُونَ","t":"(too are) watching","p":"N","tr":"mur'taqibūna","f":["ACT","PCPL","(VIII)","MP","NOM"],"r":365,"l":3987},{"e":"٥٩","v":"44:59"}]},{"l":15,"t":"s","s":45}],"verses":[{"k":"44:40","t":"Indeed, the Day of Judgement is the appointed time for them all -","j":25,"h":50,"s":44,"a":40,"sd":null},{"k":"44:41","t":"The Day when no relation will avail a relation at all, nor will they be helped -","j":25,"h":50,"s":44,"a":41,"sd":null},{"k":"44:42","t":"Except those [believers] on whom Allāh has mercy. Indeed, He is the Exalted in Might, the Merciful.","j":25,"h":50,"s":44,"a":42,"sd":null},{"k":"44:43","t":"Indeed, the tree of zaqqūm","j":25,"h":50,"s":44,"a":43,"sd":null},{"k":"44:44","t":"Is food for the sinful.","j":25,"h":50,"s":44,"a":44,"sd":null},{"k":"44:45","t":"Like murky oil, it boils within bellies","j":25,"h":50,"s":44,"a":45,"sd":null},{"k":"44:46","t":"Like the boiling of scalding water.","j":25,"h":50,"s":44,"a":46,"sd":null},{"k":"44:47","t":"[It will be commanded], \"Seize him and drag him into the midst of the Hellfire,","j":25,"h":50,"s":44,"a":47,"sd":null},{"k":"44:48","t":"Then pour over his head from the torment of scalding water.\"","j":25,"h":50,"s":44,"a":48,"sd":null},{"k":"44:49","t":"[It will be said], \"Taste! Indeed, you are the honored, the noble!","j":25,"h":50,"s":44,"a":49,"sd":null},{"k":"44:50","t":"Indeed, this is what you used to dispute.\"","j":25,"h":50,"s":44,"a":50,"sd":null},{"k":"44:51","t":"Indeed, the righteous will be in a secure place:","j":25,"h":50,"s":44,"a":51,"sd":null},{"k":"44:52","t":"Within gardens and springs,","j":25,"h":50,"s":44,"a":52,"sd":null},{"k":"44:53","t":"Wearing [garments of] fine silk and brocade, facing each other.","j":25,"h":50,"s":44,"a":53,"sd":null},{"k":"44:54","t":"Thus. And We will marry them to fair women with large, [beautiful] eyes.","j":25,"h":50,"s":44,"a":54,"sd":null},{"k":"44:55","t":"They will call therein for every [kind of] fruit - safe and secure.","j":25,"h":50,"s":44,"a":55,"sd":null},{"k":"44:56","t":"They will not taste death therein except the first death, and He will have protected them from the punishment of Hellfire","j":25,"h":50,"s":44,"a":56,"sd":null},{"k":"44:57","t":"As bounty from your Lord. That is what is the great attainment.","j":25,"h":50,"s":44,"a":57,"sd":null},{"k":"44:58","t":"And indeed, We have eased it [i.e., the Qur’ān] in your tongue that they might be reminded.","j":25,"h":50,"s":44,"a":58,"sd":null},{"k":"44:59","t":"So watch, [O Muḥammad]; indeed, they are watching [for your end].","j":25,"h":50,"s":44,"a":59,"sd":null}],"juz":25,"hizb":50,"surahs":[44],"sajdah":false}