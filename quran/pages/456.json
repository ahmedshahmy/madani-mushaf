g":[["فَ","REM","prefix","f:REM"],["زِدْ","V","stem","IMPV|2MS"],["هُ","PRON","suffix","PRON:3MS"]]},{"i":"38:61:8","a":"عَذَابًۭا","t":"a punishment","p":"N","tr":"ʿadhāban","f":["M","INDEF","ACC"],"r":17,"l":36},{"i":"38:61:9","a":"ضِعْفًۭا","t":"double","p":"ADJ","tr":"ḍiʿ'fan","f":["MS","INDEF","ACC"],"r":196,"l":765},{"i":"38:61:10","a":"فِى","t":"in","p":"P","tr":"fī","l":3},{"i":"38:61:11","a":"ٱلنَّارِ","t":"the Fire","p":"N","tr":"l-nāri","f":["F","GEN"],"r":49,"l":77,"g":[["ٱل","DET","prefix","Al"],["نَّارِ","N","stem","F|GEN"]]},{"e":"٦١","v":"38:61"}]}],"verses":[{"k":"38:43","t":"And We granted him his family and a like [number] with them as mercy from Us and a reminder for those of understanding.","j":23,"h":46,"s":38,"a":43,"sd":null},{"k":"38:44","t":"[We said], \"And take in your hand a bunch [of grass] and strike with it and do not break your oath.\" Indeed, We found him patient, an excellent servant. Indeed, he was one repeatedly turning back [to Allāh].","j":23,"h":46,"s":38,"a":44,"sd":null},{"k":"38:45","t":"And remember Our servants, Abraham, Isaac and Jacob - those of strength and [religious] vision.","j":23,"h":46,"s":38,"a":45,"sd":null},{"k":"38:46","t":"Indeed, We chose them for an exclusive quality: remembrance of the home [of the Hereafter].","j":23,"h":46,"s":38,"a":46,"sd":null},{"k":"38:47","t":"And indeed they are, to Us, among the chosen and outstanding.","j":23,"h":46,"s":38,"a":47,"sd":null},{"k":"38:48","t":"And remember Ishmael, Elisha and Dhul-Kifl, and all are among the outstanding.","j":23,"h":46,"s":38,"a":48,"sd":null},{"k":"38:49","t":"This is a reminder. And indeed, for the righteous is a good place of return -","j":23,"h":46,"s":38,"a":49,"sd":null},{"k":"38:50","t":"Gardens of perpetual residence, whose doors will be opened to them.","j":23,"h":46,"s":38,"a":50,"sd":null},{"k":"38:51","t":"Reclining within them, they will call therein for abundant fruit and drink.","j":23,"h":46,"s":38,"a":51,"sd":null},{"k":"38:52","t":"And with them will be women limiting [their] glances and of equal age.","j":23,"h":46,"s":38,"a":52,"sd":null},{"k":"38:53","t":"This is what you, [the righteous], are promised for the Day of Account.","j":23,"h":46,"s":38,"a":53,"sd":null},{"k":"38:54","t":"Indeed, this is Our provision; for it there is no depletion.","j":23,"h":46,"s":38,"a":54,"sd":null},{"k":"38:55","t":"This [is so]. But indeed, for the transgressors is an evil place of return -","j":23,"h":46,"s":38,"a":55,"sd":null},{"k":"38:56","t":"Hell, which they will [enter to] burn, and wretched is the resting place.","j":23,"h":46,"s":38,"a":56,"sd":null},{"k":"38:57","t":"This - so let them taste it - is scalding water and [foul] purulence.","j":23,"h":46,"s":38,"a":57,"sd":null},{"k":"38:58","t":"And other [punishments] of its type [in various] kinds.","j":23,"h":46,"s":38,"a":58,"sd":null},{"k":"38:59","t":"[Its inhabitants will say], \"This is a company bursting in with you. No welcome for them. Indeed, they will burn in the Fire.\"","j":23,"h":46,"s":38,"a":59,"sd":null},{"k":"38:60","t":"They will say, \"Nor you! No welcome for you. You, [our leaders], brought this upon us, and wretched is the settlement.\"","j":23,"h":46,"s":38,"a":60,"sd":null},{"k":"38:61","t":"They will say, \"Our Lord, whoever brought this upon us - increase for him double punishment in the Fire.\"","j":23,"h":46,"s":38,"a":61,"sd":null}],"juz":23,"hizb":46,"surahs":[38],"sajdah":false}