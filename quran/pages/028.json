],["ا","PRON","suffix","PRON:2MD"],["نِ","PRON","suffix","PRON:1S"]]}]},{"l":15,"t":"a","c":0,"w":[{"i":"2:186:12","a":"فَلْيَسْتَجِيبُوا۟","t":"So let them respond","p":"V","tr":"falyastajībū","f":["IMPF","(X)","3MP","MOOD:JUS"],"r":226,"l":394,"g":[["فَ","REM","prefix","f:REM"],["لْ","IMPV","prefix","l:IMPV"],["يَسْتَجِيبُ","V","stem","IMPF|(X)|3MP|MOOD:JUS"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"2:186:13","a":"لِى","t":"to Me","p":"PRON","tr":"lī","f":["1S"],"l":146,"g":[["لِ","P","prefix","l:P"],["ى","PRON","stem","1S"]]},{"i":"2:186:14","a":"وَلْيُؤْمِنُوا۟","t":"and let them believe","p":"V","tr":"walyu'minū","f":["IMPF","(IV)","3MP","MOOD:JUS"],"r":4,"l":18,"g":[["وَ","CONJ","prefix","w:CONJ"],["لْ","IMPV","prefix","l:IMPV"],["يُؤْمِنُ","V","stem","IMPF|(IV)|3MP|MOOD:JUS"],["وا","PRON","suffix","PRON:3MP"]]},{"i":"2:186:15","a":"بِى","t":"in Me","p":"PRON","tr":"bī","f":["1S"],"l":146,"g":[["بِ","P","prefix","bi"],["ى","PRON","stem","1S"]]},{"i":"2:186:16","a":"لَعَلَّهُمْ","t":"so that they may","p":"ACC","tr":"laʿallahum","l":96,"g":[["لَعَلَّ","ACC","stem",""],["هُمْ","PRON","suffix","PRON:3MP"]]},{"i":"2:186:17","a":"يَرْشُدُونَ","t":"(be) led aright","p":"V","tr":"yarshudūna","f":["IMPF","3MP"],"r":416,"l":4651,"g":[["يَرْشُدُ","V","stem","IMPF|3MP"],["ونَ","PRON","suffix","PRON:3MP"]]},{"e":"١٨٦","v":"2:186"}]}],"verses":[{"k":"2:182","t":"But if one fears from the bequeather [some] error or sin and corrects that which is between them [i.e., the concerned parties], there is no sin upon him. Indeed, Allāh is Forgiving and Merciful.","j":2,"h":3,"s":2,"a":182,"sd":null},{"k":"2:183","t":"O you who have believed, decreed upon you is fasting as it was decreed upon those before you that you may become righteous -","j":2,"h":3,"s":2,"a":183,"sd":null},{"k":"2:184","t":"[Fasting for] a limited number of days. So whoever among you is ill or on a journey [during them] - then an equal number of other days [are to be made up]. And upon those who are able [to fast, but with hardship] - a ransom [as substitute] of feeding a poor person [each day]. And whoever volunteers good [i.e., excess] - it is better for him. But to fast is best for you, if you only knew.","j":2,"h":3,"s":2,"a":184,"sd":null},{"k":"2:185","t":"The month of Ramaḍān [is that] in which was revealed the Qur’ān, a guidance for the people and clear proofs of guidance and criterion. So whoever sights [the crescent of] the month, let him fast it; and whoever is ill or on a journey - then an equal number of other days. Allāh intends for you ease and does not intend for you hardship and [wants] for you to complete the period and to glorify Allāh for that [to] which He has guided you; and perhaps you will be grateful.","j":2,"h":3,"s":2,"a":185,"sd":null},{"k":"2:186","t":"And when My servants ask you, [O Muḥammad], concerning Me - indeed I am near. I respond to the invocation of the supplicant when he calls upon Me. So let them respond to Me [by obedience] and believe in Me that they may be [rightly] guided.","j":2,"h":3,"s":2,"a":186,"sd":null}],"juz":2,"hizb":3,"surahs":[2],"sajdah":false}