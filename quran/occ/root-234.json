[["2:125:19",19,"لِلطَّآئِفِينَ","for those who circumambulate","أَن طَهِّرَا بَيْتِىَ","وَٱلْعَـٰكِفِينَ وَٱلرُّكَّعِ ٱلسُّجُودِ",1525],["2:158:16",24,"يَطَّوَّفَ","he walks","جُنَاحَ عَلَيْهِ أَن","بِهِمَا ۚ وَمَن تَطَوَّعَ",2763],["3:69:2",58,"طَّآئِفَةٌۭ","a group","وَدَّت","مِّنْ أَهْلِ ٱلْكِتَـٰبِ",438],["3:72:2",59,"طَّآئِفَةٌۭ","a group","وَقَالَت","مِّنْ أَهْلِ ٱلْكِتَـٰبِ",438],["3:122:3",66,"طَّآئِفَتَانِ","two parties","إِذْ هَمَّت","مِنكُمْ أَن تَفْشَلَا",438],["3:154:10",70,"طَآئِفَةًۭ","a group","أَمَنَةًۭ نُّعَاسًۭا يَغْشَىٰ","مِّنكُمْ ۖ وَطَآئِفَةٌۭ قَدْ",438],["3:154:12",70,"وَطَآئِفَةٌۭ","while a group","يَغْشَىٰ طَآئِفَةًۭ مِّنكُمْ ۖ","قَدْ أَهَمَّتْهُمْ أَنفُسُهُمْ",438],["4:81:8",91,"طَآئِفَةٌۭ","a group","مِنْ عِندِكَ بَيَّتَ","مِّنْهُمْ غَيْرَ ٱلَّذِى",438],["4:102:8",95,"طَآئِفَةٌۭ","a group","لَهُمُ ٱلصَّلَوٰةَ فَلْتَقُمْ","مِّنْهُم مَّعَكَ وَلْيَأْخُذُوٓا۟",438],["4:102:19",95,"طَآئِفَةٌ","a group","مِن وَرَآئِكُمْ وَلْتَأْتِ","أُخْرَىٰ لَمْ يُصَلُّوا۟",438],["4:113:7",96,"طَّآئِفَةٌۭ","a group","عَلَيْكَ وَرَحْمَتُهُۥ لَهَمَّت","مِّنْهُمْ أَن يُضِلُّوكَ",438],["6:156:7",149,"طَآئِفَتَيْنِ","the two groups","أُنزِلَ ٱلْكِتَـٰبُ عَلَىٰ","مِن قَبْلِنَا وَإِن",438],["7:87:3",161,"طَآئِفَةٌۭ","a group","وَإِن كَانَ","مِّنكُمْ ءَامَنُوا۟ بِٱلَّذِىٓ",438],["7:87:9",161,"وَطَآئِفَةٌۭ","and a group","بِٱلَّذِىٓ أُرْسِلْتُ بِهِۦ","لَّمْ يُؤْمِنُوا۟ فَٱصْبِرُوا۟",438],["7:133:3",166,"ٱلطُّوفَانَ","the flood","فَأَرْسَلْنَا عَلَيْهِمُ","وَٱلْجَرَادَ وَٱلْقُمَّلَ وَٱلضَّفَادِعَ",2314],["7:201:6",176,"طَـٰٓئِفٌۭ","an evil thought","ٱتَّقَوْا۟ إِذَا مَسَّهُمْ","مِّنَ ٱلشَّيْطَـٰنِ تَذَكَّرُوا۟",1525],["8:7:5",177,"ٱلطَّآئِفَتَيْنِ","(of) the two groups","يَعِدُكُمُ ٱللَّهُ إِحْدَى","أَنَّهَا لَكُمْ وَتَوَدُّونَ",438],["9:66:10",197,"طَآئِفَةٍۢ","a party","إِن نَّعْفُ عَن","مِّنكُمْ نُعَذِّبْ طَآئِفَةًۢ",438],["9:66:13",197,"طَآئِفَةًۢ","a party","طَآئِفَةٍۢ مِّنكُمْ نُعَذِّبْ","بِأَنَّهُمْ كَانُوا۟ مُجْرِمِينَ",438],["9:83:5",200,"طَآئِفَةٍۢ","a group","رَّجَعَكَ ٱللَّهُ إِلَىٰ","مِّنْهُمْ فَٱسْتَـْٔذَنُوكَ لِلْخُرُوجِ",438],["9:122:12",206,"طَآئِفَةٌۭ","a party","كُلِّ فِرْقَةٍۢ مِّنْهُمْ","لِّيَتَفَقَّهُوا۟ فِى ٱلدِّينِ",438],["22:26:13",335,"لِلطَّآئِفِينَ","for those who circumambulate","شَيْـًۭٔا وَطَهِّرْ بَيْتِىَ","وَٱلْقَآئِمِينَ وَٱلرُّكَّعِ ٱلسُّجُودِ",1525],["22:29:6",335,"وَلْيَطَّوَّفُوا۟","and circumambulate","تَفَثَهُمْ وَلْيُوفُوا۟ نُذُورَهُمْ","بِٱلْبَيْتِ ٱلْعَتِيقِ",2763],["24:2:24",350,"طَآئِفَةٌۭ","a group","ٱلْـَٔاخِرِ ۖ وَلْيَشْهَدْ عَذَابَهُمَا","مِّنَ ٱلْمُؤْمِنِينَ",438],["24:58:37",357,"طَوَّٰفُونَ","(as) moving about","عَلَيْهِمْ جُنَاحٌۢ بَعْدَهُنَّ ۚ","عَلَيْكُم بَعْضُكُمْ عَلَىٰ",3297],["28:4:10",385,"طَآئِفَةًۭ","a group","أَهْلَهَا شِيَعًۭا يَسْتَضْعِفُ","مِّنْهُمْ يُذَبِّحُ أَبْنَآءَهُمْ",438],["29:14:14",397,"ٱلطُّوفَانُ","the flood","خَمْسِينَ عَامًۭا فَأَخَذَهُمُ","وَهُمْ ظَـٰلِمُونَ",2314],["33:13:3",419,"طَّآئِفَةٌۭ","a party","وَإِذْ قَالَت","مِّنْهُمْ يَـٰٓأَهْلَ يَثْرِبَ",438],["37:45:1",447,"يُطَافُ","Will be circulated","","عَلَيْهِم بِكَأْسٍۢ مِّن",965],["43:71:1",494,"يُطَافُ","Will be circulated","","عَلَيْهِم بِصِحَافٍۢ مِّن",965],["49:9:2",516,"طَآئِفَتَانِ","two parties","وَإِن","مِنَ ٱلْمُؤْمِنِينَ ٱقْتَتَلُوا۟",438],["52:24:1",524,"۞ وَيَطُوفُ","And will circulate","","عَلَيْهِمْ غِلْمَانٌۭ لَّهُمْ",965],["55:44:1",533,"يَطُوفُونَ","They will go around","","بَيْنَهَا وَبَيْنَ حَمِيمٍ",965],["56:17:1",535,"يَطُوفُ","Will circulate","","عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ",965],["61:14:23",552,"طَّآئِفَةٌۭ","a group","أَنصَارُ ٱللَّهِ ۖ فَـَٔامَنَت","مِّنۢ بَنِىٓ إِسْرَٰٓءِيلَ",438],["61:14:28",552,"طَّآئِفَةٌۭ ۖ","a group","بَنِىٓ إِسْرَٰٓءِيلَ وَكَفَرَت","فَأَيَّدْنَا ٱلَّذِينَ ءَامَنُوا۟",438],["68:19:1",565,"فَطَافَ","So there came","","عَلَيْهَا طَآئِفٌۭ مِّن",965],["68:19:3",565,"طَآئِفٌۭ","a visitation","فَطَافَ عَلَيْهَا","مِّن رَّبِّكَ وَهُمْ",1525],["73:20:12",575,"وَطَآئِفَةٌۭ","and (so do) a group","ٱلَّيْلِ وَنِصْفَهُۥ وَثُلُثَهُۥ","مِّنَ ٱلَّذِينَ مَعَكَ ۚ",438],["76:15:1",579,"وَيُطَافُ","And will be circulated","","عَلَيْهِم بِـَٔانِيَةٍۢ مِّن",965],["76:19:1",579,"۞ وَيَطُوفُ","And will circulate","","عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ",965]]