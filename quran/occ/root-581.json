[["2:259:19",43,"مِا۟ئَةَ","(for) a hundred","مَوْتِهَا ۖ فَأَمَاتَهُ ٱللَّهُ","عَامٍۢ ثُمَّ بَعَثَهُۥ ۖ",846],["2:259:35",43,"مِا۟ئَةَ","one hundred","قَالَ بَل لَّبِثْتَ","عَامٍۢ فَٱنظُرْ إِلَىٰ",846],["2:261:16",44,"مِّا۟ئَةُ","hundred","فِى كُلِّ سُنۢبُلَةٍۢ","حَبَّةٍۢ ۗ وَٱللَّهُ يُضَـٰعِفُ",846],["8:65:13",185,"مِا۟ئَتَيْنِ ۚ","two hundred","عِشْرُونَ صَـٰبِرُونَ يَغْلِبُوا۟","وَإِن يَكُن مِّنكُم",846],["8:65:17",185,"مِّا۟ئَةٌۭ","a hundred","وَإِن يَكُن مِّنكُم","يَغْلِبُوٓا۟ أَلْفًۭا مِّنَ",846],["8:66:12",185,"مِّا۟ئَةٌۭ","a hundred","فَإِن يَكُن مِّنكُم","صَابِرَةٌۭ يَغْلِبُوا۟ مِا۟ئَتَيْنِ ۚ",846],["8:66:15",185,"مِا۟ئَتَيْنِ ۚ","two hundred","مِّا۟ئَةٌۭ صَابِرَةٌۭ يَغْلِبُوا۟","وَإِن يَكُن مِّنكُمْ",846],["18:25:5",296,"مِا۟ئَةٍۢ","hundred","فِى كَهْفِهِمْ ثَلَـٰثَ","سِنِينَ وَٱزْدَادُوا۟ تِسْعًۭا",846],["24:2:7",350,"مِا۟ئَةَ","(with) hundred","كُلَّ وَٰحِدٍۢ مِّنْهُمَا","جَلْدَةٍۢ ۖ وَلَا تَأْخُذْكُم",846],["37:147:3",451,"مِا۟ئَةِ","a hundred","وَأَرْسَلْنَـٰهُ إِلَىٰ","أَلْفٍ أَوْ يَزِيدُونَ",846]]