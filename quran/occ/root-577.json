[["2:30:17",6,"ٱلدِّمَآءَ","[the] blood[s]","يُفْسِدُ فِيهَا وَيَسْفِكُ","وَنَحْنُ نُسَبِّحُ بِحَمْدِكَ",832],["2:84:6",13,"دِمَآءَكُمْ","your blood","مِيثَـٰقَكُمْ لَا تَسْفِكُونَ","وَلَا تُخْرِجُونَ أَنفُسَكُم",832],["2:173:5",26,"وَٱلدَّمَ","and [the] blood","حَرَّمَ عَلَيْكُمُ ٱلْمَيْتَةَ","وَلَحْمَ ٱلْخِنزِيرِ وَمَآ",832],["5:3:4",107,"وَٱلدَّمُ","and the blood","حُرِّمَتْ عَلَيْكُمُ ٱلْمَيْتَةُ","وَلَحْمُ ٱلْخِنزِيرِ وَمَآ",832],["6:145:17",147,"دَمًۭا","blood","يَكُونَ مَيْتَةً أَوْ","مَّسْفُوحًا أَوْ لَحْمَ",832],["7:133:7",166,"وَٱلدَّمَ","and the blood","وَٱلْجَرَادَ وَٱلْقُمَّلَ وَٱلضَّفَادِعَ","ءَايَـٰتٍۢ مُّفَصَّلَـٰتٍۢ فَٱسْتَكْبَرُوا۟",832],["12:18:4",237,"بِدَمٍۢ","with false blood","وَجَآءُو عَلَىٰ قَمِيصِهِۦ","كَذِبٍۢ ۚ قَالَ بَلْ",832],["16:66:13",274,"وَدَمٍۢ","and blood","مِنۢ بَيْنِ فَرْثٍۢ","لَّبَنًا خَالِصًۭا سَآئِغًۭا",832],["16:115:5",280,"وَٱلدَّمَ","and the blood","حَرَّمَ عَلَيْكُمُ ٱلْمَيْتَةَ","وَلَحْمَ ٱلْخِنزِيرِ وَمَآ",832],["22:37:6",336,"دِمَآؤُهَا","their blood","ٱللَّهَ لُحُومُهَا وَلَا","وَلَـٰكِن يَنَالُهُ ٱلتَّقْوَىٰ",832]]