[["2:264:23",44,"تُرَابٌۭ","(is) dust","كَمَثَلِ صَفْوَانٍ عَلَيْهِ","فَأَصَابَهُۥ وَابِلٌۭ فَتَرَكَهُۥ",581],["3:59:10",57,"تُرَابٍۢ","dust","ءَادَمَ ۖ خَلَقَهُۥ مِن","ثُمَّ قَالَ لَهُۥ",581],["13:5:7",249,"تُرَٰبًا","dust","قَوْلُهُمْ أَءِذَا كُنَّا","أَءِنَّا لَفِى خَلْقٍۢ",581],["16:59:15",273,"ٱلتُّرَابِ ۗ","the dust","أَمْ يَدُسُّهُۥ فِى","أَلَا سَآءَ مَا",581],["18:37:10",298,"تُرَابٍۢ","dust","بِٱلَّذِى خَلَقَكَ مِن","ثُمَّ مِن نُّطْفَةٍۢ",581],["22:5:12",332,"تُرَابٍۢ","dust","فَإِنَّا خَلَقْنَـٰكُم مِّن","ثُمَّ مِن نُّطْفَةٍۢ",581],["23:35:6",344,"تُرَابًۭا","dust","إِذَا مِتُّمْ وَكُنتُمْ","وَعِظَـٰمًا أَنَّكُم مُّخْرَجُونَ",581],["23:82:5",347,"تُرَابًۭا","dust","أَءِذَا مِتْنَا وَكُنَّا","وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ",581],["27:67:6",383,"تُرَٰبًۭا","dust","كَفَرُوٓا۟ أَءِذَا كُنَّا","وَءَابَآؤُنَآ أَئِنَّا لَمُخْرَجُونَ",581],["30:20:6",406,"تُرَابٍۢ","dust","أَنْ خَلَقَكُم مِّن","ثُمَّ إِذَآ أَنتُم",581],["35:11:4",435,"تُرَابٍۢ","dust","وَٱللَّهُ خَلَقَكُم مِّن","ثُمَّ مِن نُّطْفَةٍۢ",581],["37:16:4",446,"تُرَابًۭا","dust","أَءِذَا مِتْنَا وَكُنَّا","وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ",581],["37:53:4",448,"تُرَابًۭا","dust","أَءِذَا مِتْنَا وَكُنَّا","وَعِظَـٰمًا أَءِنَّا لَمَدِينُونَ",581],["38:52:4",456,"أَتْرَابٌ","well-matched","۞ وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ","",1742],["40:67:5",475,"تُرَابٍۢ","dust","ٱلَّذِى خَلَقَكُم مِّن","ثُمَّ مِن نُّطْفَةٍۢ",581],["50:3:4",518,"تُرَابًۭا ۖ","dust","أَءِذَا مِتْنَا وَكُنَّا","ذَٰلِكَ رَجْعٌۢ بَعِيدٌۭ",581],["56:37:2",535,"أَتْرَابًۭا","equals in age","عُرُبًا","",1742],["56:47:6",535,"تُرَابًۭا","dust","أَئِذَا مِتْنَا وَكُنَّا","وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ",581],["78:33:2",583,"أَتْرَابًۭا","well-matched","وَكَوَاعِبَ","",1742],["78:40:15",583,"تُرَٰبًۢا","dust","ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ","",581],["86:7:5",591,"وَٱلتَّرَآئِبِ","and the ribs","مِنۢ بَيْنِ ٱلصُّلْبِ","",4486],["90:16:4",594,"مَتْرَبَةٍۢ","misery","أَوْ مِسْكِينًۭا ذَا","",3719]]