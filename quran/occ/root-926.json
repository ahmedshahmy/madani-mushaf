[["2:36:1",6,"فَأَزَلَّهُمَا","Then made [both of] them slip","","ٱلشَّيْطَـٰنُ عَنْهَا فَأَخْرَجَهُمَا",3059],["2:209:2",32,"زَلَلْتُم","you slip","فَإِن","مِّنۢ بَعْدِ مَا",2823],["3:155:9",70,"ٱسْتَزَلَّهُمُ","made them slip","ٱلْتَقَى ٱلْجَمْعَانِ إِنَّمَا","ٱلشَّيْطَـٰنُ بِبَعْضِ مَا",4837],["16:94:6",278,"فَتَزِلَّ","lest, should slip","أَيْمَـٰنَكُمْ دَخَلًۢا بَيْنَكُمْ","قَدَمٌۢ بَعْدَ ثُبُوتِهَا",2823]]