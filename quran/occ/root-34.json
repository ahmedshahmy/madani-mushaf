[["2:21:6",4,"خَلَقَكُمْ","created you","ٱعْبُدُوا۟ رَبَّكُمُ ٱلَّذِى","وَٱلَّذِينَ مِن قَبْلِكُمْ",60],["2:29:3",5,"خَلَقَ","created","هُوَ ٱلَّذِى","لَكُم مَّا فِى",60],["2:102:66",16,"خَلَـٰقٍۢ ۚ","share","فِى ٱلْـَٔاخِرَةِ مِنْ","وَلَبِئْسَ مَا شَرَوْا۟",1246],["2:164:3",25,"خَلْقِ","(the) creation","إِنَّ فِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَـٰفِ",229],["2:200:24",31,"خَلَـٰقٍۢ","any share","فِى ٱلْـَٔاخِرَةِ مِنْ","",1246],["2:228:12",36,"خَلَقَ","(has been) created","أَن يَكْتُمْنَ مَا","ٱللَّهُ فِىٓ أَرْحَامِهِنَّ",60],["3:47:13",56,"يَخْلُقُ","creates","قَالَ كَذَٰلِكِ ٱللَّهُ","مَا يَشَآءُ ۚ إِذَا",60],["3:49:12",56,"أَخْلُقُ","[I] design","مِّن رَّبِّكُمْ ۖ أَنِّىٓ","لَكُم مِّنَ ٱلطِّينِ",60],["3:59:8",57,"خَلَقَهُۥ","He created him","ٱللَّهِ كَمَثَلِ ءَادَمَ ۖ","مِن تُرَابٍۢ ثُمَّ",60],["3:77:11",59,"خَلَـٰقَ","share","قَلِيلًا أُو۟لَـٰٓئِكَ لَا","لَهُمْ فِى ٱلْـَٔاخِرَةِ",1246],["3:190:3",75,"خَلْقِ","(the) creation","إِنَّ فِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَـٰفِ",229],["3:191:10",75,"خَلْقِ","(the) creation","جُنُوبِهِمْ وَيَتَفَكَّرُونَ فِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ رَبَّنَا",229],["3:191:15",75,"خَلَقْتَ","You have created","وَٱلْأَرْضِ رَبَّنَا مَا","هَـٰذَا بَـٰطِلًۭا سُبْحَـٰنَكَ",60],["4:1:6",77,"خَلَقَكُم","created you","ٱتَّقُوا۟ رَبَّكُمُ ٱلَّذِى","مِّن نَّفْسٍۢ وَٰحِدَةٍۢ",60],["4:1:10",77,"وَخَلَقَ","and created","مِّن نَّفْسٍۢ وَٰحِدَةٍۢ","مِنْهَا زَوْجَهَا وَبَثَّ",60],["4:28:6",83,"وَخُلِقَ","and was created","أَن يُخَفِّفَ عَنكُمْ ۚ","ٱلْإِنسَـٰنُ ضَعِيفًۭا",60],["4:119:9",97,"خَلْقَ","(the) creation","ٱلْأَنْعَـٰمِ وَلَـَٔامُرَنَّهُمْ فَلَيُغَيِّرُنَّ","ٱللَّهِ ۚ وَمَن يَتَّخِذِ",229],["5:17:35",110,"يَخْلُقُ","He creates","وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ۚ","مَا يَشَآءُ ۚ وَٱللَّهُ",60],["5:18:16",111,"خَلَقَ ۚ","He created","أَنتُم بَشَرٌۭ مِّمَّنْ","يَغْفِرُ لِمَن يَشَآءُ",60],["5:110:28",126,"تَخْلُقُ","you make","وَٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ ۖ وَإِذْ","مِنَ ٱلطِّينِ كَهَيْـَٔةِ",60],["6:1:4",128,"خَلَقَ","created","ٱلْحَمْدُ لِلَّهِ ٱلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَجَعَلَ",60],["6:2:3",128,"خَلَقَكُم","created you","هُوَ ٱلَّذِى","مِّن طِينٍۢ ثُمَّ",60],["6:73:3",136,"خَلَقَ","created","وَهُوَ ٱلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ ۖ",60],["6:94:5",139,"خَلَقْنَـٰكُمْ","We created you","جِئْتُمُونَا فُرَٰدَىٰ كَمَا","أَوَّلَ مَرَّةٍۢ وَتَرَكْتُم",60],["6:100:5",140,"وَخَلَقَهُمْ ۖ","though He has created them","لِلَّهِ شُرَكَآءَ ٱلْجِنَّ","وَخَرَقُوا۟ لَهُۥ بَنِينَ",60],["6:101:12",140,"وَخَلَقَ","and He created","تَكُن لَّهُۥ صَـٰحِبَةٌۭ ۖ","كُلَّ شَىْءٍۢ ۖ وَهُوَ",60],["6:102:8",141,"خَـٰلِقُ","(the) Creator","إِلَـٰهَ إِلَّا هُوَ ۖ","كُلِّ شَىْءٍۢ فَٱعْبُدُوهُ ۚ",748],["7:11:2",151,"خَلَقْنَـٰكُمْ","We created you","وَلَقَدْ","ثُمَّ صَوَّرْنَـٰكُمْ ثُمَّ",60],["7:12:12",152,"خَلَقْتَنِى","You created me","أَنَا۠ خَيْرٌۭ مِّنْهُ","مِن نَّارٍۢ وَخَلَقْتَهُۥ",60],["7:12:15",152,"وَخَلَقْتَهُۥ","and You created him","خَلَقْتَنِى مِن نَّارٍۢ","مِن طِينٍۢ",60],["7:54:5",157,"خَلَقَ","created","رَبَّكُمُ ٱللَّهُ ٱلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ فِى",60],["7:54:27",157,"ٱلْخَلْقُ","(is) the creation","بِأَمْرِهِۦٓ ۗ أَلَا لَهُ","وَٱلْأَمْرُ ۗ تَبَارَكَ ٱللَّهُ",229],["7:69:21",159,"ٱلْخَلْقِ","the stature","نُوحٍۢ وَزَادَكُمْ فِى","بَصْۜطَةًۭ ۖ فَٱذْكُرُوٓا۟ ءَالَآءَ",229],["7:181:2",174,"خَلَقْنَآ","We have created","وَمِمَّنْ","أُمَّةٌۭ يَهْدُونَ بِٱلْحَقِّ",60],["7:185:8",174,"خَلَقَ","has (been) created","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا","ٱللَّهُ مِن شَىْءٍۢ",60],["7:189:3",175,"خَلَقَكُم","created you","۞ هُوَ ٱلَّذِى","مِّن نَّفْسٍۢ وَٰحِدَةٍۢ",60],["7:191:4",175,"يَخْلُقُ","create","أَيُشْرِكُونَ مَا لَا","شَيْـًۭٔا وَهُمْ يُخْلَقُونَ",60],["7:191:7",175,"يُخْلَقُونَ","are created","يَخْلُقُ شَيْـًۭٔا وَهُمْ","",60],["9:36:13",192,"خَلَقَ","He created","كِتَـٰبِ ٱللَّهِ يَوْمَ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ مِنْهَآ",60],["9:69:12",198,"بِخَلَـٰقِهِمْ","their portion","أَمْوَٰلًۭا وَأَوْلَـٰدًۭا فَٱسْتَمْتَعُوا۟","فَٱسْتَمْتَعْتُم بِخَلَـٰقِكُمْ كَمَا",1246],["9:69:14",198,"بِخَلَـٰقِكُمْ","your portion","فَٱسْتَمْتَعُوا۟ بِخَلَـٰقِهِمْ فَٱسْتَمْتَعْتُم","كَمَا ٱسْتَمْتَعَ ٱلَّذِينَ",1246],["9:69:20",198,"بِخَلَـٰقِهِمْ","their portion","ٱلَّذِينَ مِن قَبْلِكُم","وَخُضْتُمْ كَٱلَّذِى خَاضُوٓا۟ ۚ",1246],["10:3:5",208,"خَلَقَ","created","رَبَّكُمُ ٱللَّهُ ٱلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ فِى",60],["10:4:9",208,"ٱلْخَلْقَ","the creation","حَقًّا ۚ إِنَّهُۥ يَبْدَؤُا۟","ثُمَّ يُعِيدُهُۥ لِيَجْزِىَ",229],["10:5:15",208,"خَلَقَ","created","ٱلسِّنِينَ وَٱلْحِسَابَ ۚ مَا","ٱللَّهُ ذَٰلِكَ إِلَّا",60],["10:6:7",208,"خَلَقَ","(has been) created","ٱلَّيْلِ وَٱلنَّهَارِ وَمَا","ٱللَّهُ فِى ٱلسَّمَـٰوَٰتِ",60],["10:34:7",213,"ٱلْخَلْقَ","the creation","شُرَكَآئِكُم مَّن يَبْدَؤُا۟","ثُمَّ يُعِيدُهُۥ ۚ قُلِ",229],["10:34:13",213,"ٱلْخَلْقَ","the creation","قُلِ ٱللَّهُ يَبْدَؤُا۟","ثُمَّ يُعِيدُهُۥ ۖ فَأَنَّىٰ",229],["11:7:3",222,"خَلَقَ","created","وَهُوَ ٱلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ فِى",60],["11:119:6",235,"خَلَقَهُمْ ۗ","He created them","رَّحِمَ رَبُّكَ ۚ وَلِذَٰلِكَ","وَتَمَّتْ كَلِمَةُ رَبِّكَ",60],["13:5:10",249,"خَلْقٍۢ","a creation","تُرَٰبًا أَءِنَّا لَفِى","جَدِيدٍ ۗ أُو۟لَـٰٓئِكَ ٱلَّذِينَ",229],["13:16:33",251,"خَلَقُوا۟","who created","جَعَلُوا۟ لِلَّهِ شُرَكَآءَ","كَخَلْقِهِۦ فَتَشَـٰبَهَ ٱلْخَلْقُ",60],["13:16:34",251,"كَخَلْقِهِۦ","like His creation","لِلَّهِ شُرَكَآءَ خَلَقُوا۟","فَتَشَـٰبَهَ ٱلْخَلْقُ عَلَيْهِمْ ۚ",229],["13:16:36",251,"ٱلْخَلْقُ","the creation","خَلَقُوا۟ كَخَلْقِهِۦ فَتَشَـٰبَهَ","عَلَيْهِمْ ۚ قُلِ ٱللَّهُ",229],["13:16:40",251,"خَـٰلِقُ","(is) the Creator","عَلَيْهِمْ ۚ قُلِ ٱللَّهُ","كُلِّ شَىْءٍۢ وَهُوَ",748],["14:19:5",258,"خَلَقَ","created","تَرَ أَنَّ ٱللَّهَ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ ۚ",60],["14:19:13",258,"بِخَلْقٍۢ","a creation","يَشَأْ يُذْهِبْكُمْ وَيَأْتِ","جَدِيدٍۢ",229],["14:32:3",259,"خَلَقَ","created","ٱللَّهُ ٱلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَأَنزَلَ",60],["15:26:2",263,"خَلَقْنَا","We created","وَلَقَدْ","ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍۢ",60],["15:27:2",263,"خَلَقْنَـٰهُ","We created it","وَٱلْجَآنَّ","مِن قَبْلُ مِن",60],["15:28:6",263,"خَـٰلِقٌۢ","(will) create","رَبُّكَ لِلْمَلَـٰٓئِكَةِ إِنِّى","بَشَرًۭا مِّن صَلْصَـٰلٍۢ",748],["15:33:6",264,"خَلَقْتَهُۥ","whom You created","أَكُن لِّأَسْجُدَ لِبَشَرٍ","مِن صَلْصَـٰلٍۢ مِّنْ",60],["15:85:2",266,"خَلَقْنَا","We created","وَمَا","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا",60],["15:86:4",266,"ٱلْخَلَّـٰقُ","(is) the Creator","إِنَّ رَبَّكَ هُوَ","ٱلْعَلِيمُ",2737],["16:3:1",267,"خَلَقَ","He created","","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ ۚ",60],["16:4:1",267,"خَلَقَ","He created","","ٱلْإِنسَـٰنَ مِن نُّطْفَةٍۢ",60],["16:5:2",267,"خَلَقَهَا ۗ","He created them","وَٱلْأَنْعَـٰمَ","لَكُمْ فِيهَا دِفْءٌۭ",60],["16:8:6",268,"وَيَخْلُقُ","And He creates","وَٱلْحَمِيرَ لِتَرْكَبُوهَا وَزِينَةًۭ ۚ","مَا لَا تَعْلَمُونَ",60],["16:17:2",269,"يَخْلُقُ","creates","أَفَمَن","كَمَن لَّا يَخْلُقُ ۗ",60],["16:17:5",269,"يَخْلُقُ ۗ","create","يَخْلُقُ كَمَن لَّا","أَفَلَا تَذَكَّرُونَ",60],["16:20:7",269,"يَخْلُقُونَ","they create","دُونِ ٱللَّهِ لَا","شَيْـًۭٔا وَهُمْ يُخْلَقُونَ",60],["16:20:10",269,"يُخْلَقُونَ","created","يَخْلُقُونَ شَيْـًۭٔا وَهُمْ","",60],["16:48:5",272,"خَلَقَ","Allah has created","يَرَوْا۟ إِلَىٰ مَا","ٱللَّهُ مِن شَىْءٍۢ",60],["16:70:2",274,"خَلَقَكُمْ","created you","وَٱللَّهُ","ثُمَّ يَتَوَفَّىٰكُمْ ۚ وَمِنكُم",60],["16:81:5",276,"خَلَقَ","He created","جَعَلَ لَكُم مِّمَّا","ظِلَـٰلًۭا وَجَعَلَ لَكُم",60],["17:49:8",286,"خَلْقًۭا","(as) a creation","وَرُفَـٰتًا أَءِنَّا لَمَبْعُوثُونَ","جَدِيدًۭا",229],["17:51:2",287,"خَلْقًۭا","a creation","أَوْ","مِّمَّا يَكْبُرُ فِى",229],["17:61:12",288,"خَلَقْتَ","You created","قَالَ ءَأَسْجُدُ لِمَنْ","طِينًۭا",60],["17:70:16",289,"خَلَقْنَا","We have created","عَلَىٰ كَثِيرٍۢ مِّمَّنْ","تَفْضِيلًۭا",60],["17:98:13",292,"خَلْقًۭا","(as) a creation","وَرُفَـٰتًا أَءِنَّا لَمَبْعُوثُونَ","جَدِيدًا",229],["17:99:6",292,"خَلَقَ","created","أَنَّ ٱللَّهَ ٱلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ قَادِرٌ",60],["17:99:12",292,"يَخْلُقَ","create","قَادِرٌ عَلَىٰٓ أَن","مِثْلَهُمْ وَجَعَلَ لَهُمْ",60],["18:37:8",298,"خَلَقَكَ","created you","يُحَاوِرُهُۥٓ أَكَفَرْتَ بِٱلَّذِى","مِن تُرَابٍۢ ثُمَّ",60],["18:48:8",299,"خَلَقْنَـٰكُمْ","We created you","لَّقَدْ جِئْتُمُونَا كَمَا","أَوَّلَ مَرَّةٍۭ ۚ بَلْ",60],["18:51:3",299,"خَلْقَ","the creation","۞ مَّآ أَشْهَدتُّهُمْ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَلَا",229],["18:51:7",299,"خَلْقَ","the creation","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَلَا","أَنفُسِهِمْ وَمَا كُنتُ",229],["19:9:9",305,"خَلَقْتُكَ","I (have) created you","عَلَىَّ هَيِّنٌۭ وَقَدْ","مِن قَبْلُ وَلَمْ",60],["19:67:5",310,"خَلَقْنَـٰهُ","We created him","يَذْكُرُ ٱلْإِنسَـٰنُ أَنَّا","مِن قَبْلُ وَلَمْ",60],["20:4:3",312,"خَلَقَ","created","تَنزِيلًۭا مِّمَّنْ","ٱلْأَرْضَ وَٱلسَّمَـٰوَٰتِ ٱلْعُلَى",60],["20:50:7",314,"خَلْقَهُۥ","its form","أَعْطَىٰ كُلَّ شَىْءٍ","ثُمَّ هَدَىٰ",229],["20:55:2",315,"خَلَقْنَـٰكُمْ","We created you","۞ مِنْهَا","وَفِيهَا نُعِيدُكُمْ وَمِنْهَا",60],["21:16:2",323,"خَلَقْنَا","We created","وَمَا","ٱلسَّمَآءَ وَٱلْأَرْضَ وَمَا",60],["21:33:3",324,"خَلَقَ","created","وَهُوَ ٱلَّذِى","ٱلَّيْلَ وَٱلنَّهَارَ وَٱلشَّمْسَ",60],["21:37:1",325,"خُلِقَ","Is created","","ٱلْإِنسَـٰنُ مِنْ عَجَلٍۢ ۚ",60],["21:104:10",331,"خَلْقٍۢ","creation","كَمَا بَدَأْنَآ أَوَّلَ","نُّعِيدُهُۥ ۚ وَعْدًا عَلَيْنَآ ۚ",229],["22:5:10",332,"خَلَقْنَـٰكُم","We created you","مِّنَ ٱلْبَعْثِ فَإِنَّا","مِّن تُرَابٍۢ ثُمَّ",60],["22:5:22",332,"مُّخَلَّقَةٍۢ","formed","ثُمَّ مِن مُّضْغَةٍۢ","وَغَيْرِ مُخَلَّقَةٍۢ لِّنُبَيِّنَ",2513],["22:5:24",332,"مُخَلَّقَةٍۢ","and unformed","مُّضْغَةٍۢ مُّخَلَّقَةٍۢ وَغَيْرِ","لِّنُبَيِّنَ لَكُمْ ۚ وَنُقِرُّ",2513],["22:73:14",341,"يَخْلُقُوا۟","create","دُونِ ٱللَّهِ لَن","ذُبَابًۭا وَلَوِ ٱجْتَمَعُوا۟",60],["23:12:2",342,"خَلَقْنَا","We created","وَلَقَدْ","ٱلْإِنسَـٰنَ مِن سُلَـٰلَةٍۢ",60],["23:14:2",342,"خَلَقْنَا","We created","ثُمَّ","ٱلنُّطْفَةَ عَلَقَةًۭ فَخَلَقْنَا",60],["23:14:5",342,"فَخَلَقْنَا","then We created","خَلَقْنَا ٱلنُّطْفَةَ عَلَقَةًۭ","ٱلْعَلَقَةَ مُضْغَةًۭ فَخَلَقْنَا",60],["23:14:8",342,"فَخَلَقْنَا","then We created","فَخَلَقْنَا ٱلْعَلَقَةَ مُضْغَةًۭ","ٱلْمُضْغَةَ عِظَـٰمًۭا فَكَسَوْنَا",60],["23:14:16",342,"خَلْقًا","(as) a creation","لَحْمًۭا ثُمَّ أَنشَأْنَـٰهُ","ءَاخَرَ ۚ فَتَبَارَكَ ٱللَّهُ",229],["23:14:21",342,"ٱلْخَـٰلِقِينَ","(of) the Creators","فَتَبَارَكَ ٱللَّهُ أَحْسَنُ","",748],["23:17:2",342,"خَلَقْنَا","We (have) created","وَلَقَدْ","فَوْقَكُمْ سَبْعَ طَرَآئِقَ",60],["23:17:9",342,"ٱلْخَلْقِ","the creation","وَمَا كُنَّا عَنِ","غَـٰفِلِينَ",229],["23:91:16",348,"خَلَقَ","he created","كُلُّ إِلَـٰهٍۭ بِمَا","وَلَعَلَا بَعْضُهُمْ عَلَىٰ",60],["23:115:3",349,"خَلَقْنَـٰكُمْ","We created you","أَفَحَسِبْتُمْ أَنَّمَا","عَبَثًۭا وَأَنَّكُمْ إِلَيْنَا",60],["24:45:2",356,"خَلَقَ","created","وَٱللَّهُ","كُلَّ دَآبَّةٍۢ مِّن",60],["24:45:22",356,"يَخْلُقُ","Allah creates","يَمْشِى عَلَىٰٓ أَرْبَعٍۢ ۚ","ٱللَّهُ مَا يَشَآءُ ۚ",60],["25:2:15",359,"وَخَلَقَ","and He (has) created","شَرِيكٌۭ فِى ٱلْمُلْكِ","كُلَّ شَىْءٍۢ فَقَدَّرَهُۥ",60],["25:3:6",360,"يَخْلُقُونَ","they create","دُونِهِۦٓ ءَالِهَةًۭ لَّا","شَيْـًۭٔا وَهُمْ يُخْلَقُونَ",60],["25:3:9",360,"يُخْلَقُونَ","are created","يَخْلُقُونَ شَيْـًۭٔا وَهُمْ","وَلَا يَمْلِكُونَ لِأَنفُسِهِمْ",60],["25:49:7",364,"خَلَقْنَآ","(to those) We created","مَّيْتًۭا وَنُسْقِيَهُۥ مِمَّا","أَنْعَـٰمًۭا وَأَنَاسِىَّ كَثِيرًۭا",60],["25:54:3",364,"خَلَقَ","has created","وَهُوَ ٱلَّذِى","مِنَ ٱلْمَآءِ بَشَرًۭا",60],["25:59:2",365,"خَلَقَ","created","ٱلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا",60],["26:78:2",370,"خَلَقَنِى","created me","ٱلَّذِى","فَهُوَ يَهْدِينِ",60],["26:137:4",373,"خُلُقُ","(the) custom","إِنْ هَـٰذَآ إِلَّا","ٱلْأَوَّلِينَ",2749],["26:166:3",374,"خَلَقَ","created","وَتَذَرُونَ مَا","لَكُمْ رَبُّكُم مِّنْ",60],["26:184:3",375,"خَلَقَكُمْ","created you","وَٱتَّقُوا۟ ٱلَّذِى","وَٱلْجِبِلَّةَ ٱلْأَوَّلِينَ",60],["27:60:2",382,"خَلَقَ","has created","أَمَّنْ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَأَنزَلَ",60],["27:64:3",383,"ٱلْخَلْقَ","the creation","أَمَّن يَبْدَؤُا۟","ثُمَّ يُعِيدُهُۥ وَمَن",229],["28:68:2",393,"يَخْلُقُ","creates","وَرَبُّكَ","مَا يَشَآءُ وَيَخْتَارُ ۗ",60],["29:17:7",398,"وَتَخْلُقُونَ","and you create","دُونِ ٱللَّهِ أَوْثَـٰنًۭا","إِفْكًا ۚ إِنَّ ٱلَّذِينَ",60],["29:19:6",398,"ٱلْخَلْقَ","the creation","كَيْفَ يُبْدِئُ ٱللَّهُ","ثُمَّ يُعِيدُهُۥٓ ۚ إِنَّ",229],["29:20:8",398,"ٱلْخَلْقَ ۚ","the creation","فَٱنظُرُوا۟ كَيْفَ بَدَأَ","ثُمَّ ٱللَّهُ يُنشِئُ",229],["29:44:1",401,"خَلَقَ","Allah created","","ٱللَّهُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ",60],["29:61:4",403,"خَلَقَ","created","وَلَئِن سَأَلْتَهُم مَّنْ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَسَخَّرَ",60],["30:8:6",405,"خَلَقَ","Allah (has) created","فِىٓ أَنفُسِهِم ۗ مَّا","ٱللَّهُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ",60],["30:11:3",405,"ٱلْخَلْقَ","the creation","ٱللَّهُ يَبْدَؤُا۟","ثُمَّ يُعِيدُهُۥ ثُمَّ",229],["30:20:4",406,"خَلَقَكُم","He created you","وَمِنْ ءَايَـٰتِهِۦٓ أَنْ","مِّن تُرَابٍۢ ثُمَّ",60],["30:21:4",406,"خَلَقَ","He created","وَمِنْ ءَايَـٰتِهِۦٓ أَنْ","لَكُم مِّنْ أَنفُسِكُمْ",60],["30:22:3",406,"خَلْقُ","(is the) creation","وَمِنْ ءَايَـٰتِهِۦ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَـٰفُ",229],["30:27:4",407,"ٱلْخَلْقَ","the creation","وَهُوَ ٱلَّذِى يَبْدَؤُا۟","ثُمَّ يُعِيدُهُۥ وَهُوَ",229],["30:30:13",407,"لِخَلْقِ","(should there be) in the creation","عَلَيْهَا ۚ لَا تَبْدِيلَ","ٱللَّهِ ۚ ذَٰلِكَ ٱلدِّينُ",229],["30:40:3",408,"خَلَقَكُمْ","created you","ٱللَّهُ ٱلَّذِى","ثُمَّ رَزَقَكُمْ ثُمَّ",60],["30:54:3",410,"خَلَقَكُم","created you","۞ ٱللَّهُ ٱلَّذِى","مِّن ضَعْفٍۢ ثُمَّ",60],["30:54:19",410,"يَخْلُقُ","He creates","قُوَّةٍۢ ضَعْفًۭا وَشَيْبَةًۭ ۚ","مَا يَشَآءُ ۖ وَهُوَ",60],["31:10:1",411,"خَلَقَ","He created","","ٱلسَّمَـٰوَٰتِ بِغَيْرِ عَمَدٍۢ",60],["31:11:2",411,"خَلْقُ","(is the) creation","هَـٰذَا","ٱللَّهِ فَأَرُونِى مَاذَا",229],["31:11:6",411,"خَلَقَ","have created","ٱللَّهِ فَأَرُونِى مَاذَا","ٱلَّذِينَ مِن دُونِهِۦ ۚ",60],["31:25:4",413,"خَلَقَ","created","وَلَئِن سَأَلْتَهُم مَّنْ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ لَيَقُولُنَّ",60],["31:28:2",413,"خَلْقُكُمْ","(is) your creation","مَّا","وَلَا بَعْثُكُمْ إِلَّا",229],["32:4:3",415,"خَلَقَ","created","ٱللَّهُ ٱلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا",60],["32:7:5",415,"خَلَقَهُۥ ۖ","He created","أَحْسَنَ كُلَّ شَىْءٍ","وَبَدَأَ خَلْقَ ٱلْإِنسَـٰنِ",60],["32:7:7",415,"خَلْقَ","(the) creation","شَىْءٍ خَلَقَهُۥ ۖ وَبَدَأَ","ٱلْإِنسَـٰنِ مِن طِينٍۢ",229],["32:10:8",415,"خَلْقٍۢ","a creation","ٱلْأَرْضِ أَءِنَّا لَفِى","جَدِيدٍۭ ۚ بَلْ هُم",229],["34:7:15",428,"خَلْقٍۢ","a creation","مُمَزَّقٍ إِنَّكُمْ لَفِى","جَدِيدٍ",229],["35:1:16",434,"ٱلْخَلْقِ","the creation","وَرُبَـٰعَ ۚ يَزِيدُ فِى","مَا يَشَآءُ ۚ إِنَّ",229],["35:3:9",434,"خَـٰلِقٍ","creator","عَلَيْكُمْ ۚ هَلْ مِنْ","غَيْرُ ٱللَّهِ يَرْزُقُكُم",748],["35:11:2",435,"خَلَقَكُم","created you","وَٱللَّهُ","مِّن تُرَابٍۢ ثُمَّ",60],["35:16:5",436,"بِخَلْقٍۢ","in a creation","يَشَأْ يُذْهِبْكُمْ وَيَأْتِ","جَدِيدٍۢ",229],["35:40:11",439,"خَلَقُوا۟","they have created","ٱللَّهِ أَرُونِى مَاذَا","مِنَ ٱلْأَرْضِ أَمْ",60],["36:36:3",442,"خَلَقَ","created","سُبْحَـٰنَ ٱلَّذِى","ٱلْأَزْوَٰجَ كُلَّهَا مِمَّا",60],["36:42:1",443,"وَخَلَقْنَا","And We created","","لَهُم مِّن مِّثْلِهِۦ",60],["36:68:5",444,"ٱلْخَلْقِ ۖ","the creation","نُّعَمِّرْهُ نُنَكِّسْهُ فِى","أَفَلَا يَعْقِلُونَ",229],["36:71:4",445,"خَلَقْنَا","[We] created","أَوَلَمْ يَرَوْا۟ أَنَّا","لَهُم مِّمَّا عَمِلَتْ",60],["36:77:5",445,"خَلَقْنَـٰهُ","[We] created him","يَرَ ٱلْإِنسَـٰنُ أَنَّا","مِن نُّطْفَةٍۢ فَإِذَا",60],["36:78:5",445,"خَلْقَهُۥ ۖ","his (own) creation","لَنَا مَثَلًۭا وَنَسِىَ","قَالَ مَن يُحْىِ",229],["36:79:9",445,"خَلْقٍ","creation","مَرَّةٍۢ ۖ وَهُوَ بِكُلِّ","عَلِيمٌ",229],["36:81:3",445,"خَلَقَ","created","أَوَلَيْسَ ٱلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِقَـٰدِرٍ",60],["36:81:9",445,"يَخْلُقَ","create","بِقَـٰدِرٍ عَلَىٰٓ أَن","مِثْلَهُم ۚ بَلَىٰ وَهُوَ",60],["36:81:13",445,"ٱلْخَلَّـٰقُ","(is) the Supreme Creator","مِثْلَهُم ۚ بَلَىٰ وَهُوَ","ٱلْعَلِيمُ",2737],["37:11:4",446,"خَلْقًا","creation","فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ","أَم مَّنْ خَلَقْنَآ ۚ",229],["37:11:7",446,"خَلَقْنَآ ۚ","We have created","خَلْقًا أَم مَّنْ","إِنَّا خَلَقْنَـٰهُم مِّن",60],["37:11:9",446,"خَلَقْنَـٰهُم","created them","مَّنْ خَلَقْنَآ ۚ إِنَّا","مِّن طِينٍۢ لَّازِبٍۭ",60],["37:96:2",449,"خَلَقَكُمْ","created you","وَٱللَّهُ","وَمَا تَعْمَلُونَ",60],["37:125:5",450,"ٱلْخَـٰلِقِينَ","(of) Creators","بَعْلًۭا وَتَذَرُونَ أَحْسَنَ","",748],["37:150:2",451,"خَلَقْنَا","did We create","أَمْ","ٱلْمَلَـٰٓئِكَةَ إِنَـٰثًۭا وَهُمْ",60],["38:7:10",453,"ٱخْتِلَـٰقٌ","a fabrication","إِنْ هَـٰذَآ إِلَّا","",4849],["38:27:2",455,"خَلَقْنَا","We created","وَمَا","ٱلسَّمَآءَ وَٱلْأَرْضَ وَمَا",60],["38:71:6",457,"خَـٰلِقٌۢ","going to create","رَبُّكَ لِلْمَلَـٰٓئِكَةِ إِنِّى","بَشَرًۭا مِّن طِينٍۢ",748],["38:75:8",457,"خَلَقْتُ","I created","أَن تَسْجُدَ لِمَا","بِيَدَىَّ ۖ أَسْتَكْبَرْتَ أَمْ",60],["38:76:5",457,"خَلَقْتَنِى","You created me","أَنَا۠ خَيْرٌۭ مِّنْهُ ۖ","مِن نَّارٍۢ وَخَلَقْتَهُۥ",60],["38:76:8",457,"وَخَلَقْتَهُۥ","and You created him","خَلَقْتَنِى مِن نَّارٍۢ","مِن طِينٍۢ",60],["39:4:9",458,"يَخْلُقُ","He creates","وَلَدًۭا لَّٱصْطَفَىٰ مِمَّا","مَا يَشَآءُ ۚ سُبْحَـٰنَهُۥ ۖ",60],["39:5:1",458,"خَلَقَ","He created","","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ ۖ",60],["39:6:1",459,"خَلَقَكُم","He created you","","مِّن نَّفْسٍۢ وَٰحِدَةٍۢ",60],["39:6:15",459,"يَخْلُقُكُمْ","He creates you","ٱلْأَنْعَـٰمِ ثَمَـٰنِيَةَ أَزْوَٰجٍۢ ۚ","فِى بُطُونِ أُمَّهَـٰتِكُمْ",60],["39:6:19",459,"خَلْقًۭا","creation","فِى بُطُونِ أُمَّهَـٰتِكُمْ","مِّنۢ بَعْدِ خَلْقٍۢ",229],["39:6:22",459,"خَلْقٍۢ","creation","خَلْقًۭا مِّنۢ بَعْدِ","فِى ظُلُمَـٰتٍۢ ثَلَـٰثٍۢ ۚ",229],["39:38:4",462,"خَلَقَ","created","وَلَئِن سَأَلْتَهُم مَّنْ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ لَيَقُولُنَّ",60],["39:62:2",465,"خَـٰلِقُ","(is the) Creator","ٱللَّهُ","كُلِّ شَىْءٍۢ ۖ وَهُوَ",748],["40:57:1",473,"لَخَلْقُ","Surely, (the) creation","","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ أَكْبَرُ",229],["40:57:6",473,"خَلْقِ","(the) creation","وَٱلْأَرْضِ أَكْبَرُ مِنْ","ٱلنَّاسِ وَلَـٰكِنَّ أَكْثَرَ",229],["40:62:4",474,"خَـٰلِقُ","(the) Creator","ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ","كُلِّ شَىْءٍۢ لَّآ",748],["40:67:3",475,"خَلَقَكُم","created you","هُوَ ٱلَّذِى","مِّن تُرَابٍۢ ثُمَّ",60],["41:9:5",477,"خَلَقَ","created","أَئِنَّكُمْ لَتَكْفُرُونَ بِٱلَّذِى","ٱلْأَرْضَ فِى يَوْمَيْنِ",60],["41:15:18",478,"خَلَقَهُمْ","created them","أَنَّ ٱللَّهَ ٱلَّذِى","هُوَ أَشَدُّ مِنْهُمْ",60],["41:21:14",479,"خَلَقَكُمْ","created you","كُلَّ شَىْءٍۢ وَهُوَ","أَوَّلَ مَرَّةٍۢ وَإِلَيْهِ",60],["41:37:15",480,"خَلَقَهُنَّ","created them","وَٱسْجُدُوا۟ لِلَّهِ ٱلَّذِى","إِن كُنتُمْ إِيَّاهُ",60],["42:29:3",486,"خَلْقُ","(is the) creation","وَمِنْ ءَايَـٰتِهِۦ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا",229],["42:49:5",488,"يَخْلُقُ","He creates","مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ","مَا يَشَآءُ ۚ يَهَبُ",60],["43:9:4",489,"خَلَقَ","created","وَلَئِن سَأَلْتَهُم مَّنْ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ لَيَقُولُنَّ",60],["43:9:8",489,"خَلَقَهُنَّ","Created them","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ لَيَقُولُنَّ","ٱلْعَزِيزُ ٱلْعَلِيمُ",60],["43:12:2",490,"خَلَقَ","created","وَٱلَّذِى","ٱلْأَزْوَٰجَ كُلَّهَا وَجَعَلَ",60],["43:16:4",490,"يَخْلُقُ","He has created","أَمِ ٱتَّخَذَ مِمَّا","بَنَاتٍۢ وَأَصْفَىٰكُم بِٱلْبَنِينَ",60],["43:19:9",490,"خَلْقَهُمْ ۚ","their creation","ٱلرَّحْمَـٰنِ إِنَـٰثًا ۚ أَشَهِدُوا۟","سَتُكْتَبُ شَهَـٰدَتُهُمْ وَيُسْـَٔلُونَ",229],["43:87:4",495,"خَلَقَهُمْ","created them","وَلَئِن سَأَلْتَهُم مَّنْ","لَيَقُولُنَّ ٱللَّهُ ۖ فَأَنَّىٰ",60],["44:38:2",497,"خَلَقْنَا","We created","وَمَا","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا",60],["44:39:2",497,"خَلَقْنَـٰهُمَآ","We created both of them","مَا","إِلَّا بِٱلْحَقِّ وَلَـٰكِنَّ",60],["45:4:2",499,"خَلْقِكُمْ","your creation","وَفِى","وَمَا يَبُثُّ مِن",229],["45:22:1",500,"وَخَلَقَ","And Allah created","","ٱللَّهُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ",60],["46:3:2",502,"خَلَقْنَا","We created","مَا","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا",60],["46:4:10",502,"خَلَقُوا۟","they have created","ٱللَّهِ أَرُونِى مَاذَا","مِنَ ٱلْأَرْضِ أَمْ",60],["46:33:6",506,"خَلَقَ","created","أَنَّ ٱللَّهَ ٱلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَلَمْ",60],["46:33:11",506,"بِخَلْقِهِنَّ","by their creation","وَٱلْأَرْضَ وَلَمْ يَعْىَ","بِقَـٰدِرٍ عَلَىٰٓ أَن",229],["49:13:4",517,"خَلَقْنَـٰكُم","created you","يَـٰٓأَيُّهَا ٱلنَّاسُ إِنَّا","مِّن ذَكَرٍۢ وَأُنثَىٰ",60],["50:15:2",518,"بِٱلْخَلْقِ","with the creation","أَفَعَيِينَا","ٱلْأَوَّلِ ۚ بَلْ هُمْ",229],["50:15:9",518,"خَلْقٍۢ","a creation","فِى لَبْسٍۢ مِّنْ","جَدِيدٍۢ",229],["50:16:2",519,"خَلَقْنَا","We created","وَلَقَدْ","ٱلْإِنسَـٰنَ وَنَعْلَمُ مَا",60],["50:38:2",520,"خَلَقْنَا","We created","وَلَقَدْ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا",60],["51:49:4",522,"خَلَقْنَا","We have created","وَمِن كُلِّ شَىْءٍ","زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّرُونَ",60],["51:56:2",523,"خَلَقْتُ","I have created","وَمَا","ٱلْجِنَّ وَٱلْإِنسَ إِلَّا",60],["52:35:2",525,"خُلِقُوا۟","they were created","أَمْ","مِنْ غَيْرِ شَىْءٍ",60],["52:35:8",525,"ٱلْخَـٰلِقُونَ","the creators","شَىْءٍ أَمْ هُمُ","",748],["52:36:2",525,"خَلَقُوا۟","(did) they create","أَمْ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ ۚ بَل",60],["53:45:2",528,"خَلَقَ","created","وَأَنَّهُۥ","ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ",60],["54:49:4",530,"خَلَقْنَـٰهُ","We created it","إِنَّا كُلَّ شَىْءٍ","بِقَدَرٍۢ",60],["55:3:1",531,"خَلَقَ","He created","","ٱلْإِنسَـٰنَ",60],["55:14:1",531,"خَلَقَ","He created","","ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍۢ",60],["55:15:1",531,"وَخَلَقَ","And He created","","ٱلْجَآنَّ مِن مَّارِجٍۢ",60],["56:57:2",536,"خَلَقْنَـٰكُمْ","[We] created you","نَحْنُ","فَلَوْلَا تُصَدِّقُونَ",60],["56:59:2",536,"تَخْلُقُونَهُۥٓ","who create it","ءَأَنتُمْ","أَمْ نَحْنُ ٱلْخَـٰلِقُونَ",60],["56:59:5",536,"ٱلْخَـٰلِقُونَ","the Creators","تَخْلُقُونَهُۥٓ أَمْ نَحْنُ","",748],["57:4:3",538,"خَلَقَ","created","هُوَ ٱلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ فِى",60],["59:24:3",548,"ٱلْخَـٰلِقُ","the Creator","هُوَ ٱللَّهُ","ٱلْبَارِئُ ٱلْمُصَوِّرُ ۖ لَهُ",748],["64:2:3",556,"خَلَقَكُمْ","created you","هُوَ ٱلَّذِى","فَمِنكُمْ كَافِرٌۭ وَمِنكُم",60],["64:3:1",556,"خَلَقَ","He created","","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ",60],["65:12:3",559,"خَلَقَ","created","ٱللَّهُ ٱلَّذِى","سَبْعَ سَمَـٰوَٰتٍۢ وَمِنَ",60],["67:2:2",562,"خَلَقَ","created","ٱلَّذِى","ٱلْمَوْتَ وَٱلْحَيَوٰةَ لِيَبْلُوَكُمْ",60],["67:3:2",562,"خَلَقَ","created","ٱلَّذِى","سَبْعَ سَمَـٰوَٰتٍۢ طِبَاقًۭا ۖ",60],["67:3:9",562,"خَلْقِ","(the) creation","مَّا تَرَىٰ فِى","ٱلرَّحْمَـٰنِ مِن تَفَـٰوُتٍۢ ۖ",229],["67:14:4",563,"خَلَقَ","created","أَلَا يَعْلَمُ مَنْ","وَهُوَ ٱللَّطِيفُ ٱلْخَبِيرُ",60],["68:4:3",564,"خُلُقٍ","(of) a moral character","وَإِنَّكَ لَعَلَىٰ","عَظِيمٍۢ",2749],["70:19:3",569,"خُلِقَ","was created","۞ إِنَّ ٱلْإِنسَـٰنَ","هَلُوعًا",60],["70:39:3",569,"خَلَقْنَـٰهُم","[We] have created them","كَلَّآ ۖ إِنَّا","مِّمَّا يَعْلَمُونَ",60],["71:14:2",571,"خَلَقَكُمْ","He created you","وَقَدْ","أَطْوَارًا",60],["71:15:4",571,"خَلَقَ","did create","أَلَمْ تَرَوْا۟ كَيْفَ","ٱللَّهُ سَبْعَ سَمَـٰوَٰتٍۢ",60],["74:11:3",575,"خَلَقْتُ","I created","ذَرْنِى وَمَنْ","وَحِيدًۭا",60],["75:38:4",578,"فَخَلَقَ","then He created","ثُمَّ كَانَ عَلَقَةًۭ","فَسَوَّىٰ",60],["76:2:2",578,"خَلَقْنَا","[We] created","إِنَّا","ٱلْإِنسَـٰنَ مِن نُّطْفَةٍ",60],["76:28:2",580,"خَلَقْنَـٰهُمْ","created them","نَّحْنُ","وَشَدَدْنَآ أَسْرَهُمْ ۖ وَإِذَا",60],["77:20:2",581,"نَخْلُقكُّم","We create you","أَلَمْ","مِّن مَّآءٍۢ مَّهِينٍۢ",60],["78:8:1",582,"وَخَلَقْنَـٰكُمْ","And We created you","","أَزْوَٰجًۭا",60],["79:27:3",584,"خَلْقًا","creation","ءَأَنتُمْ أَشَدُّ","أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",229],["80:18:4",585,"خَلَقَهُۥ","He created him","مِنْ أَىِّ شَىْءٍ","",60],["80:19:3",585,"خَلَقَهُۥ","He created him","مِن نُّطْفَةٍ","فَقَدَّرَهُۥ",60],["82:7:2",587,"خَلَقَكَ","created you","ٱلَّذِى","فَسَوَّىٰكَ فَعَدَلَكَ",60],["86:5:4",591,"خُلِقَ","he is created","فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ","",60],["86:6:1",591,"خُلِقَ","He is created","","مِن مَّآءٍۢ دَافِقٍۢ",60],["87:2:2",591,"خَلَقَ","created","ٱلَّذِى","فَسَوَّىٰ",60],["88:17:6",592,"خُلِقَتْ","they are created","إِلَى ٱلْإِبِلِ كَيْفَ","",60],["89:8:3",593,"يُخْلَقْ","had been created","ٱلَّتِى لَمْ","مِثْلُهَا فِى ٱلْبِلَـٰدِ",60],["90:4:2",594,"خَلَقْنَا","We have created","لَقَدْ","ٱلْإِنسَـٰنَ فِى كَبَدٍ",60],["92:3:2",595,"خَلَقَ","created","وَمَا","ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",60],["95:4:2",597,"خَلَقْنَا","We created","لَقَدْ","ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ",60],["96:1:5",597,"خَلَقَ","created","بِٱسْمِ رَبِّكَ ٱلَّذِى","",60],["96:2:1",597,"خَلَقَ","He created","","ٱلْإِنسَـٰنَ مِنْ عَلَقٍ",60],["113:2:4",604,"خَلَقَ","He created","مِن شَرِّ مَا","",60]]