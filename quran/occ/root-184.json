[["2:85:41",13,"يُرَدُّونَ","they will be sent back","ٱلدُّنْيَا ۖ وَيَوْمَ ٱلْقِيَـٰمَةِ","إِلَىٰٓ أَشَدِّ ٱلْعَذَابِ ۗ",324],["2:109:7",17,"يَرُدُّونَكُم","they could turn you back","أَهْلِ ٱلْكِتَـٰبِ لَوْ","مِّنۢ بَعْدِ إِيمَـٰنِكُمْ",324],["2:217:33",34,"يَرُدُّوكُمْ","they turn you away","يَزَالُونَ يُقَـٰتِلُونَكُمْ حَتَّىٰ","عَن دِينِكُمْ إِنِ",324],["2:217:39",34,"يَرْتَدِدْ","turns away","إِنِ ٱسْتَطَـٰعُوا۟ ۚ وَمَن","مِنكُمْ عَن دِينِهِۦ",1022],["2:228:24",36,"بِرَدِّهِنَّ","to take them back","ٱلْـَٔاخِرِ ۚ وَبُعُولَتُهُنَّ أَحَقُّ","فِى ذَٰلِكَ إِنْ",2602],["3:100:11",62,"يَرُدُّوكُم","they will turn you back","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ","بَعْدَ إِيمَـٰنِكُمْ كَـٰفِرِينَ",324],["3:149:8",69,"يَرُدُّوكُمْ","they will turn you back","تُطِيعُوا۟ ٱلَّذِينَ كَفَرُوا۟","عَلَىٰٓ أَعْقَـٰبِكُمْ فَتَنقَلِبُوا۟",324],["4:47:16",86,"فَنَرُدَّهَا","and turn them","أَن نَّطْمِسَ وُجُوهًۭا","عَلَىٰٓ أَدْبَارِهَآ أَوْ",324],["4:59:15",87,"فَرُدُّوهُ","refer it","تَنَـٰزَعْتُمْ فِى شَىْءٍۢ","إِلَى ٱللَّهِ وَٱلرَّسُولِ",324],["4:83:11",91,"رَدُّوهُ","they (had) referred it","أَذَاعُوا۟ بِهِۦ ۖ وَلَوْ","إِلَى ٱلرَّسُولِ وَإِلَىٰٓ",324],["4:86:8",91,"رُدُّوهَآ ۗ","return it","بِأَحْسَنَ مِنْهَآ أَوْ","إِنَّ ٱللَّهَ كَانَ",324],["4:91:10",92,"رُدُّوٓا۟","they are returned","قَوْمَهُمْ كُلَّ مَا","إِلَى ٱلْفِتْنَةِ أُرْكِسُوا۟",324],["5:21:10",111,"تَرْتَدُّوا۟","turn","ٱللَّهُ لَكُمْ وَلَا","عَلَىٰٓ أَدْبَارِكُمْ فَتَنقَلِبُوا۟",1022],["5:54:5",117,"يَرْتَدَّ","turns back","ٱلَّذِينَ ءَامَنُوا۟ مَن","مِنكُمْ عَن دِينِهِۦ",1022],["5:108:11",125,"تُرَدَّ","will be refuted","أَوْ يَخَافُوٓا۟ أَن","أَيْمَـٰنٌۢ بَعْدَ أَيْمَـٰنِهِمْ ۗ",324],["6:27:9",130,"نُرَدُّ","were sent back","ٱلنَّارِ فَقَالُوا۟ يَـٰلَيْتَنَا","وَلَا نُكَذِّبَ بِـَٔايَـٰتِ",324],["6:28:10",131,"رُدُّوا۟","they were sent back","مِن قَبْلُ ۖ وَلَوْ","لَعَادُوا۟ لِمَا نُهُوا۟",324],["6:62:2",135,"رُدُّوٓا۟","they are returned","ثُمَّ","إِلَى ٱللَّهِ مَوْلَىٰهُمُ",324],["6:71:11",136,"وَنُرَدُّ","and we turn back","يَنفَعُنَا وَلَا يَضُرُّنَا","عَلَىٰٓ أَعْقَابِنَا بَعْدَ",324],["6:147:9",148,"يُرَدُّ","will be turned back","رَحْمَةٍۢ وَٰسِعَةٍۢ وَلَا","بَأْسُهُۥ عَنِ ٱلْقَوْمِ",324],["7:53:25",157,"نُرَدُّ","we are sent back","فَيَشْفَعُوا۟ لَنَآ أَوْ","فَنَعْمَلَ غَيْرَ ٱلَّذِى",324],["9:45:14",194,"يَتَرَدَّدُونَ","they waver","فَهُمْ فِى رَيْبِهِمْ","",4686],["9:94:22",202,"تُرَدُّونَ","you will be brought back","عَمَلَكُمْ وَرَسُولُهُۥ ثُمَّ","إِلَىٰ عَـٰلِمِ ٱلْغَيْبِ",324],["9:101:19",203,"يُرَدُّونَ","they will be returned","سَنُعَذِّبُهُم مَّرَّتَيْنِ ثُمَّ","إِلَىٰ عَذَابٍ عَظِيمٍۢ",324],["9:105:8",203,"وَسَتُرَدُّونَ","And you will be brought back","عَمَلَكُمْ وَرَسُولُهُۥ وَٱلْمُؤْمِنُونَ ۖ","إِلَىٰ عَـٰلِمِ ٱلْغَيْبِ",324],["10:30:7",212,"وَرُدُّوٓا۟","and they will be returned","نَفْسٍۢ مَّآ أَسْلَفَتْ ۚ","إِلَى ٱللَّهِ مَوْلَىٰهُمُ",324],["10:107:14",221,"رَآدَّ","repeller","يُرِدْكَ بِخَيْرٍۢ فَلَا","لِفَضْلِهِۦ ۚ يُصِيبُ بِهِۦ",1969],["11:76:14",230,"مَرْدُودٍۢ","(be) repelled","ءَاتِيهِمْ عَذَابٌ غَيْرُ","",2462],["12:65:6",243,"رُدَّتْ","returned","مَتَـٰعَهُمْ وَجَدُوا۟ بِضَـٰعَتَهُمْ","إِلَيْهِمْ ۖ قَالُوا۟ يَـٰٓأَبَانَا",324],["12:65:14",243,"رُدَّتْ","returned","نَبْغِى ۖ هَـٰذِهِۦ بِضَـٰعَتُنَا","إِلَيْنَا ۖ وَنَمِيرُ أَهْلَنَا",324],["12:96:8",247,"فَٱرْتَدَّ","then returned (his) sight","أَلْقَىٰهُ عَلَىٰ وَجْهِهِۦ","بَصِيرًۭا ۖ قَالَ أَلَمْ",1022],["12:110:15",248,"يُرَدُّ","(can) be repelled","مَن نَّشَآءُ ۖ وَلَا","بَأْسُنَا عَنِ ٱلْقَوْمِ",324],["13:11:28",250,"مَرَدَّ","turning away","بِقَوْمٍۢ سُوٓءًۭا فَلَا","لَهُۥ ۚ وَمَا لَهُم",1198],["14:9:21",256,"فَرَدُّوٓا۟","but they returned","جَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَـٰتِ","أَيْدِيَهُمْ فِىٓ أَفْوَٰهِهِمْ",324],["14:43:5",261,"يَرْتَدُّ","returning","مُقْنِعِى رُءُوسِهِمْ لَا","إِلَيْهِمْ طَرْفُهُمْ ۖ وَأَفْـِٔدَتُهُمْ",1022],["16:70:7",274,"يُرَدُّ","is sent back","يَتَوَفَّىٰكُمْ ۚ وَمِنكُم مَّن","إِلَىٰٓ أَرْذَلِ ٱلْعُمُرِ",324],["16:71:11",274,"بِرَآدِّى","would hand over","فَمَا ٱلَّذِينَ فُضِّلُوا۟","رِزْقِهِمْ عَلَىٰ مَا",4150],["17:6:2",282,"رَدَدْنَا","We gave back","ثُمَّ","لَكُمُ ٱلْكَرَّةَ عَلَيْهِمْ",324],["18:36:6",298,"رُّدِدتُّ","I am brought back","ٱلسَّاعَةَ قَآئِمَةًۭ وَلَئِن","إِلَىٰ رَبِّى لَأَجِدَنَّ",324],["18:64:6",301,"فَٱرْتَدَّا","So they returned","مَا كُنَّا نَبْغِ ۚ","عَلَىٰٓ ءَاثَارِهِمَا قَصَصًۭا",1022],["18:87:8",303,"يُرَدُّ","he will be returned","فَسَوْفَ نُعَذِّبُهُۥ ثُمَّ","إِلَىٰ رَبِّهِۦ فَيُعَذِّبُهُۥ",324],["19:76:13",310,"مَّرَدًّا","(for) return","رَبِّكَ ثَوَابًۭا وَخَيْرٌۭ","",1198],["21:40:7",325,"رَدَّهَا","to repel it","فَتَبْهَتُهُمْ فَلَا يَسْتَطِيعُونَ","وَلَا هُمْ يُنظَرُونَ",2602],["22:5:46",332,"يُرَدُّ","is returned","يُتَوَفَّىٰ وَمِنكُم مَّن","إِلَىٰٓ أَرْذَلِ ٱلْعُمُرِ",324],["27:40:12",380,"يَرْتَدَّ","returns","بِهِۦ قَبْلَ أَن","إِلَيْكَ طَرْفُكَ ۚ فَلَمَّا",1022],["28:7:18",386,"رَآدُّوهُ","(will) restore him","وَلَا تَحْزَنِىٓ ۖ إِنَّا","إِلَيْكِ وَجَاعِلُوهُ مِنَ",1969],["28:13:1",386,"فَرَدَدْنَـٰهُ","So We restored him","","إِلَىٰٓ أُمِّهِۦ كَىْ",324],["28:85:6",396,"لَرَآدُّكَ","(will) surely take you back","فَرَضَ عَلَيْكَ ٱلْقُرْءَانَ","إِلَىٰ مَعَادٍۢ ۚ قُل",1969],["30:43:11",409,"مَرَدَّ","(can be) averted","يَأْتِىَ يَوْمٌۭ لَّا","لَهُۥ مِنَ ٱللَّهِ ۖ",1198],["33:25:1",421,"وَرَدَّ","And Allah turned back","","ٱللَّهُ ٱلَّذِينَ كَفَرُوا۟",324],["38:33:1",455,"رُدُّوهَا","Return them","","عَلَىَّ ۖ فَطَفِقَ مَسْحًۢا",324],["40:43:15",472,"مَرَدَّنَآ","our return","فِى ٱلْـَٔاخِرَةِ وَأَنَّ","إِلَى ٱللَّهِ وَأَنَّ",1198],["41:47:2",482,"يُرَدُّ","is referred","۞ إِلَيْهِ","عِلْمُ ٱلسَّاعَةِ ۚ وَمَا",324],["42:44:18",487,"مَرَدٍّۢ","return","يَقُولُونَ هَلْ إِلَىٰ","مِّن سَبِيلٍۢ",1198],["42:47:9",488,"مَرَدَّ","averting","يَأْتِىَ يَوْمٌۭ لَّا","لَهُۥ مِنَ ٱللَّهِ ۚ",1198],["47:25:3",509,"ٱرْتَدُّوا۟","return","إِنَّ ٱلَّذِينَ","عَلَىٰٓ أَدْبَـٰرِهِم مِّنۢ",1022],["62:8:10",553,"تُرَدُّونَ","you will be sent back","فَإِنَّهُۥ مُلَـٰقِيكُمْ ۖ ثُمَّ","إِلَىٰ عَـٰلِمِ ٱلْغَيْبِ",324],["79:10:3",583,"لَمَرْدُودُونَ","indeed be returned","يَقُولُونَ أَءِنَّا","فِى ٱلْحَافِرَةِ",2462],["95:5:2",597,"رَدَدْنَـٰهُ","We returned him","ثُمَّ","أَسْفَلَ سَـٰفِلِينَ",324]]