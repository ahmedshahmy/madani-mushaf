[["12:49:8",241,"يُغَاثُ","will be given abundant rain","ذَٰلِكَ عَامٌۭ فِيهِ","ٱلنَّاسُ وَفِيهِ يَعْصِرُونَ",4721],["31:34:7",414,"ٱلْغَيْثَ","the rain","عِلْمُ ٱلسَّاعَةِ وَيُنَزِّلُ","وَيَعْلَمُ مَا فِى",1849],["42:28:4",486,"ٱلْغَيْثَ","the rain","وَهُوَ ٱلَّذِى يُنَزِّلُ","مِنۢ بَعْدِ مَا",1849],["57:20:15",540,"غَيْثٍ","(of) a rain","ٱلْأَمْوَٰلِ وَٱلْأَوْلَـٰدِ ۖ كَمَثَلِ","أَعْجَبَ ٱلْكُفَّارَ نَبَاتُهُۥ",1849]]