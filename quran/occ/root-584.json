[["2:30:21",6,"وَنُقَدِّسُ","and we sanctify","وَنَحْنُ نُسَبِّحُ بِحَمْدِكَ","لَكَ ۖ قَالَ إِنِّىٓ",4068],["2:87:16",13,"ٱلْقُدُسِ ۗ","the Holy Spirit","ٱلْبَيِّنَـٰتِ وَأَيَّدْنَـٰهُ بِرُوحِ","أَفَكُلَّمَا جَآءَكُمْ رَسُولٌۢ",1625],["2:253:21",42,"ٱلْقُدُسِ ۗ","[the] Holy","ٱلْبَيِّنَـٰتِ وَأَيَّدْنَـٰهُ بِرُوحِ","وَلَوْ شَآءَ ٱللَّهُ",1625],["5:21:4",111,"ٱلْمُقَدَّسَةَ","the Holy","يَـٰقَوْمِ ٱدْخُلُوا۟ ٱلْأَرْضَ","ٱلَّتِى كَتَبَ ٱللَّهُ",3832],["5:110:15",126,"ٱلْقُدُسِ","the Holy","إِذْ أَيَّدتُّكَ بِرُوحِ","تُكَلِّمُ ٱلنَّاسَ فِى",1625],["16:102:4",278,"ٱلْقُدُسِ","the Holy Spirit","قُلْ نَزَّلَهُۥ رُوحُ","مِن رَّبِّكَ بِٱلْحَقِّ",1625],["20:12:8",312,"ٱلْمُقَدَّسِ","the sacred","نَعْلَيْكَ ۖ إِنَّكَ بِٱلْوَادِ","طُوًۭى",2499],["59:23:9",548,"ٱلْقُدُّوسُ","the Holy One","إِلَّا هُوَ ٱلْمَلِكُ","ٱلسَّلَـٰمُ ٱلْمُؤْمِنُ ٱلْمُهَيْمِنُ",2590],["62:1:10",553,"ٱلْقُدُّوسِ","the Holy","فِى ٱلْأَرْضِ ٱلْمَلِكِ","ٱلْعَزِيزِ ٱلْحَكِيمِ",2590],["79:16:5",583,"ٱلْمُقَدَّسِ","the sacred","نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ","طُوًى",2499]]