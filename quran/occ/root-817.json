[["2:136:14",21,"وَٱلْأَسْبَاطِ","and the descendants","وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ وَيَعْقُوبَ","وَمَآ أُوتِىَ مُوسَىٰ",1280],["2:140:8",21,"وَٱلْأَسْبَاطَ","and the descendants","وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ وَيَعْقُوبَ","كَانُوا۟ هُودًا أَوْ",1280],["3:84:14",61,"وَٱلْأَسْبَاطِ","and the descendents","وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ وَيَعْقُوبَ","وَمَآ أُوتِىَ مُوسَىٰ",1280],["4:163:17",104,"وَٱلْأَسْبَاطِ","and the tribes","وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ وَيَعْقُوبَ","وَعِيسَىٰ وَأَيُّوبَ وَيُونُسَ",1280],["7:160:4",171,"أَسْبَاطًا","tribes","وَقَطَّعْنَـٰهُمُ ٱثْنَتَىْ عَشْرَةَ","أُمَمًۭا ۚ وَأَوْحَيْنَآ إِلَىٰ",1280]]