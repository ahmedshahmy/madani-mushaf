[["2:249:22",41,"ٱغْتَرَفَ","takes","مِنِّىٓ إِلَّا مَنِ","غُرْفَةًۢ بِيَدِهِۦ ۚ فَشَرِبُوا۟",4796],["2:249:23",41,"غُرْفَةًۢ","(in the) hollow","إِلَّا مَنِ ٱغْتَرَفَ","بِيَدِهِۦ ۚ فَشَرِبُوا۟ مِنْهُ",1339],["25:75:3",366,"ٱلْغُرْفَةَ","the Chamber","أُو۟لَـٰٓئِكَ يُجْزَوْنَ","بِمَا صَبَرُوا۟ وَيُلَقَّوْنَ",1339],["29:58:8",403,"غُرَفًۭا","lofty dwellings","لَنُبَوِّئَنَّهُم مِّنَ ٱلْجَنَّةِ","تَجْرِى مِن تَحْتِهَا",1339],["34:37:22",432,"ٱلْغُرُفَـٰتِ","the high dwellings","عَمِلُوا۟ وَهُمْ فِى","ءَامِنُونَ",3479],["39:20:6",460,"غُرَفٌۭ","(are) lofty mansions","ٱتَّقَوْا۟ رَبَّهُمْ لَهُمْ","مِّن فَوْقِهَا غُرَفٌۭ",1339],["39:20:9",460,"غُرَفٌۭ","lofty mansions","غُرَفٌۭ مِّن فَوْقِهَا","مَّبْنِيَّةٌۭ تَجْرِى مِن",1339]]