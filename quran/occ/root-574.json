[["7:195:8",175,"يَبْطِشُونَ","(to) hold","أَمْ لَهُمْ أَيْدٍۢ","بِهَآ ۖ أَمْ لَهُمْ",1319],["26:130:2",372,"بَطَشْتُم","you seize","وَإِذَا","بَطَشْتُمْ جَبَّارِينَ",1319],["26:130:3",372,"بَطَشْتُمْ","you seize","وَإِذَا بَطَشْتُم","جَبَّارِينَ",1319],["28:19:5",387,"يَبْطِشَ","strike","أَنْ أَرَادَ أَن","بِٱلَّذِى هُوَ عَدُوٌّۭ",1319],["43:8:4",489,"بَطْشًۭا","(in) power","فَأَهْلَكْنَآ أَشَدَّ مِنْهُم","وَمَضَىٰ مَثَلُ ٱلْأَوَّلِينَ",1807],["44:16:2",496,"نَبْطِشُ","We will seize","يَوْمَ","ٱلْبَطْشَةَ ٱلْكُبْرَىٰٓ إِنَّا",1319],["44:16:3",496,"ٱلْبَطْشَةَ","(with) the seizure","يَوْمَ نَبْطِشُ","ٱلْكُبْرَىٰٓ إِنَّا مُنتَقِمُونَ",2327],["50:36:9",520,"بَطْشًۭا","(in) power","هُمْ أَشَدُّ مِنْهُم","فَنَقَّبُوا۟ فِى ٱلْبِلَـٰدِ",1807],["54:36:3",530,"بَطْشَتَنَا","(of) Our seizure","وَلَقَدْ أَنذَرَهُم","فَتَمَارَوْا۟ بِٱلنُّذُرِ",2327],["85:12:2",590,"بَطْشَ","(the) Grip","إِنَّ","رَبِّكَ لَشَدِيدٌ",1807]]