[["22:23:19",334,"وَلُؤْلُؤًۭا ۖ","and pearl","أَسَاوِرَ مِن ذَهَبٍۢ","وَلِبَاسُهُمْ فِيهَا حَرِيرٌۭ",1194],["35:33:10",438,"وَلُؤْلُؤًۭا ۖ","and pearls","أَسَاوِرَ مِن ذَهَبٍۢ","وَلِبَاسُهُمْ فِيهَا حَرِيرٌۭ",1194],["52:24:6",524,"لُؤْلُؤٌۭ","pearls","غِلْمَانٌۭ لَّهُمْ كَأَنَّهُمْ","مَّكْنُونٌۭ",1194],["55:22:3",532,"ٱللُّؤْلُؤُ","the pearl","يَخْرُجُ مِنْهُمَا","وَٱلْمَرْجَانُ",1194],["56:23:2",535,"ٱللُّؤْلُؤِ","pearls","كَأَمْثَـٰلِ","ٱلْمَكْنُونِ",1194],["76:19:8",579,"لُؤْلُؤًۭا","(to be) pearls","إِذَا رَأَيْتَهُمْ حَسِبْتَهُمْ","مَّنثُورًۭا",1194]]