[["2:34:8",6,"إِبْلِيسَ","Iblis","لِـَٔادَمَ فَسَجَدُوٓا۟ إِلَّآ","أَبَىٰ وَٱسْتَكْبَرَ وَكَانَ",760],["7:11:12",151,"إِبْلِيسَ","Iblis","لِـَٔادَمَ فَسَجَدُوٓا۟ إِلَّآ","لَمْ يَكُن مِّنَ",760],["15:31:2",263,"إِبْلِيسَ","Iblis","إِلَّآ","أَبَىٰٓ أَن يَكُونَ",760],["15:32:2",264,"يَـٰٓإِبْلِيسُ","O Iblis","قَالَ","مَا لَكَ أَلَّا",760],["17:61:8",288,"إِبْلِيسَ","Iblis","لِـَٔادَمَ فَسَجَدُوٓا۟ إِلَّآ","قَالَ ءَأَسْجُدُ لِمَنْ",760],["18:50:8",299,"إِبْلِيسَ","Iblis","لِـَٔادَمَ فَسَجَدُوٓا۟ إِلَّآ","كَانَ مِنَ ٱلْجِنِّ",760],["20:116:8",320,"إِبْلِيسَ","Iblis","لِـَٔادَمَ فَسَجَدُوٓا۟ إِلَّآ","أَبَىٰ",760],["26:95:2",371,"إِبْلِيسَ","(of) Iblis","وَجُنُودُ","أَجْمَعُونَ",760],["34:20:4",430,"إِبْلِيسُ","Iblis","وَلَقَدْ صَدَّقَ عَلَيْهِمْ","ظَنَّهُۥ فَٱتَّبَعُوهُ إِلَّا",760],["38:74:2",457,"إِبْلِيسَ","Iblis","إِلَّآ","ٱسْتَكْبَرَ وَكَانَ مِنَ",760],["38:75:2",457,"يَـٰٓإِبْلِيسُ","O Iblis","قَالَ","مَا مَنَعَكَ أَن",760]]