[["6:99:14",140,"خَضِرًۭا","green plant","شَىْءٍۢ فَأَخْرَجْنَا مِنْهُ","نُّخْرِجُ مِنْهُ حَبًّۭا",4560],["12:43:13",240,"خُضْرٍۢ","green","عِجَافٌۭ وَسَبْعَ سُنۢبُلَـٰتٍ","وَأُخَرَ يَابِسَـٰتٍۢ ۖ يَـٰٓأَيُّهَا",1423],["12:46:14",241,"خُضْرٍۢ","green","عِجَافٌۭ وَسَبْعِ سُنۢبُلَـٰتٍ","وَأُخَرَ يَابِسَـٰتٍۢ لَّعَلِّىٓ",1423],["18:31:17",297,"خُضْرًۭا","green","ذَهَبٍۢ وَيَلْبَسُونَ ثِيَابًا","مِّن سُندُسٍۢ وَإِسْتَبْرَقٍۢ",1423],["22:63:11",339,"مُخْضَرَّةً ۗ","green","مَآءًۭ فَتُصْبِحُ ٱلْأَرْضُ","إِنَّ ٱللَّهَ لَطِيفٌ",3891],["36:80:6",445,"ٱلْأَخْضَرِ","[the] green","لَكُم مِّنَ ٱلشَّجَرِ","نَارًۭا فَإِذَآ أَنتُم",3054],["55:76:4",534,"خُضْرٍۢ","green","مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ","وَعَبْقَرِىٍّ حِسَانٍۢ",1423],["76:21:4",579,"خُضْرٌۭ","green","عَـٰلِيَهُمْ ثِيَابُ سُندُسٍ","وَإِسْتَبْرَقٌۭ ۖ وَحُلُّوٓا۟ أَسَاوِرَ",1423]]