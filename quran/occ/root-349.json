[["2:245:14",39,"وَيَبْصُۜطُ","and grants abundance","كَثِيرَةًۭ ۚ وَٱللَّهُ يَقْبِضُ","وَإِلَيْهِ تُرْجَعُونَ",591],["2:247:32",40,"بَسْطَةًۭ","abundantly","ٱصْطَفَىٰهُ عَلَيْكُمْ وَزَادَهُۥ","فِى ٱلْعِلْمِ وَٱلْجِسْمِ ۖ",2325],["5:11:12",109,"يَبْسُطُوٓا۟","they stretch","هَمَّ قَوْمٌ أَن","إِلَيْكُمْ أَيْدِيَهُمْ فَكَفَّ",591],["5:28:2",112,"بَسَطتَ","you stretch","لَئِنۢ","إِلَىَّ يَدَكَ لِتَقْتُلَنِى",591],["5:28:8",112,"بِبَاسِطٍۢ","stretch","لِتَقْتُلَنِى مَآ أَنَا۠","يَدِىَ إِلَيْكَ لِأَقْتُلَكَ ۖ",1536],["5:64:13",118,"مَبْسُوطَتَانِ","(are) stretched out","قَالُوا۟ ۘ بَلْ يَدَاهُ","يُنفِقُ كَيْفَ يَشَآءُ ۚ",3654],["6:93:31",139,"بَاسِطُوٓا۟","(are) stretching out","غَمَرَٰتِ ٱلْمَوْتِ وَٱلْمَلَـٰٓئِكَةُ","أَيْدِيهِمْ أَخْرِجُوٓا۟ أَنفُسَكُمُ ۖ",1536],["7:69:22",159,"بَصْۜطَةًۭ ۖ","extensively","وَزَادَكُمْ فِى ٱلْخَلْقِ","فَٱذْكُرُوٓا۟ ءَالَآءَ ٱللَّهِ",2325],["13:14:13",251,"كَبَـٰسِطِ","like one who stretches","لَهُم بِشَىْءٍ إِلَّا","كَفَّيْهِ إِلَى ٱلْمَآءِ",1536],["13:26:2",252,"يَبْسُطُ","extends","ٱللَّهُ","ٱلرِّزْقَ لِمَن يَشَآءُ",591],["17:29:8",285,"تَبْسُطْهَا","extend it","إِلَىٰ عُنُقِكَ وَلَا","كُلَّ ٱلْبَسْطِ فَتَقْعُدَ",591],["17:29:10",285,"ٱلْبَسْطِ","reach","وَلَا تَبْسُطْهَا كُلَّ","فَتَقْعُدَ مَلُومًۭا مَّحْسُورًا",3346],["17:30:3",285,"يَبْسُطُ","extends","إِنَّ رَبَّكَ","ٱلرِّزْقَ لِمَن يَشَآءُ",591],["18:18:11",295,"بَـٰسِطٌۭ","stretched","وَذَاتَ ٱلشِّمَالِ ۖ وَكَلْبُهُم","ذِرَاعَيْهِ بِٱلْوَصِيدِ ۚ لَوِ",1536],["28:82:9",395,"يَبْسُطُ","extends","يَقُولُونَ وَيْكَأَنَّ ٱللَّهَ","ٱلرِّزْقَ لِمَن يَشَآءُ",591],["29:62:2",403,"يَبْسُطُ","extends","ٱللَّهُ","ٱلرِّزْقَ لِمَن يَشَآءُ",591],["30:37:5",408,"يَبْسُطُ","extends","يَرَوْا۟ أَنَّ ٱللَّهَ","ٱلرِّزْقَ لِمَن يَشَآءُ",591],["30:48:7",409,"فَيَبْسُطُهُۥ","then He spreads them","ٱلرِّيَـٰحَ فَتُثِيرُ سَحَابًۭا","فِى ٱلسَّمَآءِ كَيْفَ",591],["34:36:4",432,"يَبْسُطُ","extends","قُلْ إِنَّ رَبِّى","ٱلرِّزْقَ لِمَن يَشَآءُ",591],["34:39:4",432,"يَبْسُطُ","extends","قُلْ إِنَّ رَبِّى","ٱلرِّزْقَ لِمَن يَشَآءُ",591],["39:52:5",464,"يَبْسُطُ","extends","يَعْلَمُوٓا۟ أَنَّ ٱللَّهَ","ٱلرِّزْقَ لِمَن يَشَآءُ",591],["42:12:5",484,"يَبْسُطُ","He extends","مَقَالِيدُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ","ٱلرِّزْقَ لِمَن يَشَآءُ",591],["42:27:2",486,"بَسَطَ","Allah extends","۞ وَلَوْ","ٱللَّهُ ٱلرِّزْقَ لِعِبَادِهِۦ",591],["60:2:6",549,"وَيَبْسُطُوٓا۟","and extend","يَكُونُوا۟ لَكُمْ أَعْدَآءًۭ","إِلَيْكُمْ أَيْدِيَهُمْ وَأَلْسِنَتَهُم",591],["71:19:5",571,"بِسَاطًۭا","an expanse","جَعَلَ لَكُمُ ٱلْأَرْضَ","",3356]]