[["23:75:8",347,"لَّلَجُّوا۟","surely they would persist","بِهِم مِّن ضُرٍّۢ","فِى طُغْيَـٰنِهِمْ يَعْمَهُونَ",2436],["24:40:5",355,"لُّجِّىٍّۢ","deep","كَظُلُمَـٰتٍۢ فِى بَحْرٍۢ","يَغْشَىٰهُ مَوْجٌۭ مِّن",3619],["27:44:8",380,"لُجَّةًۭ","(was) a pool","فَلَمَّا رَأَتْهُ حَسِبَتْهُ","وَكَشَفَتْ عَن سَاقَيْهَا ۚ",3608],["67:21:9",563,"لَّجُّوا۟","they persist","أَمْسَكَ رِزْقَهُۥ ۚ بَل","فِى عُتُوٍّۢ وَنُفُورٍ",2436]]