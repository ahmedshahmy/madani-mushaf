[["3:44:5",55,"نُوحِيهِ","We reveal it","مِنْ أَنۢبَآءِ ٱلْغَيْبِ","إِلَيْكَ ۚ وَمَا كُنتَ",165],["4:163:2",104,"أَوْحَيْنَآ","have revealed","۞ إِنَّآ","إِلَيْكَ كَمَآ أَوْحَيْنَآ",165],["4:163:5",104,"أَوْحَيْنَآ","We revealed","أَوْحَيْنَآ إِلَيْكَ كَمَآ","إِلَىٰ نُوحٍۢ وَٱلنَّبِيِّـۧنَ",165],["4:163:11",104,"وَأَوْحَيْنَآ","and We revealed","وَٱلنَّبِيِّـۧنَ مِنۢ بَعْدِهِۦ ۚ","إِلَىٰٓ إِبْرَٰهِيمَ وَإِسْمَـٰعِيلَ",165],["5:111:2",126,"أَوْحَيْتُ","I inspired","وَإِذْ","إِلَى ٱلْحَوَارِيِّـۧنَ أَنْ",165],["6:19:11",130,"وَأُوحِىَ","and has been revealed","شَهِيدٌۢ بَيْنِى وَبَيْنَكُمْ ۚ","إِلَىَّ هَـٰذَا ٱلْقُرْءَانُ",165],["6:50:20",133,"يُوحَىٰٓ","is revealed","أَتَّبِعُ إِلَّا مَا","إِلَىَّ ۚ قُلْ هَلْ",165],["6:93:10",139,"أُوحِىَ","It has been inspired","كَذِبًا أَوْ قَالَ","إِلَىَّ وَلَمْ يُوحَ",165],["6:93:13",139,"يُوحَ","it was inspired","أُوحِىَ إِلَىَّ وَلَمْ","إِلَيْهِ شَىْءٌۭ وَمَن",165],["6:106:3",141,"أُوحِىَ","has been inspired","ٱتَّبِعْ مَآ","إِلَيْكَ مِن رَّبِّكَ ۖ",165],["6:112:9",142,"يُوحِى","inspiring","شَيَـٰطِينَ ٱلْإِنسِ وَٱلْجِنِّ","بَعْضُهُمْ إِلَىٰ بَعْضٍۢ",165],["6:121:13",143,"لَيُوحُونَ","inspire","لَفِسْقٌۭ ۗ وَإِنَّ ٱلشَّيَـٰطِينَ","إِلَىٰٓ أَوْلِيَآئِهِمْ لِيُجَـٰدِلُوكُمْ ۖ",165],["6:145:6",147,"أُوحِىَ","has been revealed","أَجِدُ فِى مَآ","إِلَىَّ مُحَرَّمًا عَلَىٰ",165],["7:117:1",164,"۞ وَأَوْحَيْنَآ","And We inspired","","إِلَىٰ مُوسَىٰٓ أَنْ",165],["7:160:6",171,"وَأَوْحَيْنَآ","And We inspired","عَشْرَةَ أَسْبَاطًا أُمَمًۭا ۚ","إِلَىٰ مُوسَىٰٓ إِذِ",165],["7:203:12",176,"يُوحَىٰٓ","is revealed","إِنَّمَآ أَتَّبِعُ مَا","إِلَىَّ مِن رَّبِّى ۚ",165],["8:12:2",178,"يُوحِى","inspired","إِذْ","رَبُّكَ إِلَى ٱلْمَلَـٰٓئِكَةِ",165],["10:2:5",208,"أَوْحَيْنَآ","We revealed","لِلنَّاسِ عَجَبًا أَنْ","إِلَىٰ رَجُلٍۢ مِّنْهُمْ",165],["10:15:30",210,"يُوحَىٰٓ","is revealed","أَتَّبِعُ إِلَّا مَا","إِلَىَّ ۖ إِنِّىٓ أَخَافُ",165],["10:87:1",218,"وَأَوْحَيْنَآ","And We inspired","","إِلَىٰ مُوسَىٰ وَأَخِيهِ",165],["10