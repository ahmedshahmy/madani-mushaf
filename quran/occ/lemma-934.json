[["2:113:2",18,"ٱلْيَهُودُ","the Jews","وَقَالَتِ","لَيْسَتِ ٱلنَّصَـٰرَىٰ عَلَىٰ",934],["2:113:10",18,"ٱلْيَهُودُ","the Jews","وَقَالَتِ ٱلنَّصَـٰرَىٰ لَيْسَتِ","عَلَىٰ شَىْءٍۢ وَهُمْ",934],["2:120:4",19,"ٱلْيَهُودُ","the Jews","وَلَن تَرْضَىٰ عَنكَ","وَلَا ٱلنَّصَـٰرَىٰ حَتَّىٰ",934],["3:67:4",58,"يَهُودِيًّۭا","a Jew","مَا كَانَ إِبْرَٰهِيمُ","وَلَا نَصْرَانِيًّۭا وَلَـٰكِن",934],["5:18:2",111,"ٱلْيَهُودُ","the Jews","وَقَالَتِ","وَٱلنَّصَـٰرَىٰ نَحْنُ أَبْنَـٰٓؤُا۟",934],["5:51:6",117,"ٱلْيَهُودَ","the Jews","ءَامَنُوا۟ لَا تَتَّخِذُوا۟","وَٱلنَّصَـٰرَىٰٓ أَوْلِيَآءَ ۘ بَعْضُهُمْ",934],["5:64:2",118,"ٱلْيَهُودُ","the Jews","وَقَالَتِ","يَدُ ٱللَّهِ مَغْلُولَةٌ ۚ",934],["5:82:7",121,"ٱلْيَهُودَ","the Jews","عَدَٰوَةًۭ لِّلَّذِينَ ءَامَنُوا۟","وَٱلَّذِينَ أَشْرَكُوا۟ ۖ وَلَتَجِدَنَّ",934],["9:30:2",191,"ٱلْيَهُودُ","the Jews","وَقَالَتِ","عُزَيْرٌ ٱبْنُ ٱللَّهِ",934]]