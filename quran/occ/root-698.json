[["2:196:6",30,"أُحْصِرْتُمْ","you are held back","وَٱلْعُمْرَةَ لِلَّهِ ۚ فَإِنْ","فَمَا ٱسْتَيْسَرَ مِنَ",2214],["2:273:3",46,"أُحْصِرُوا۟","are wrapped up","لِلْفُقَرَآءِ ٱلَّذِينَ","فِى سَبِيلِ ٱللَّهِ",2214],["3:39:17",55,"وَحَصُورًۭا","and chaste","مِّنَ ٱللَّهِ وَسَيِّدًۭا","وَنَبِيًّۭا مِّنَ ٱلصَّـٰلِحِينَ",3172],["4:90:11",92,"حَصِرَتْ","restraining","مِّيثَـٰقٌ أَوْ جَآءُوكُمْ","صُدُورُهُمْ أَن يُقَـٰتِلُوكُمْ",2269],["9:5:10",187,"وَٱحْصُرُوهُمْ","and besiege them","حَيْثُ وَجَدتُّمُوهُمْ وَخُذُوهُمْ","وَٱقْعُدُوا۟ لَهُمْ كُلَّ",2269],["17:8:11",283,"حَصِيرًا","a prison-bed","وَجَعَلْنَا جَهَنَّمَ لِلْكَـٰفِرِينَ","",3170]]