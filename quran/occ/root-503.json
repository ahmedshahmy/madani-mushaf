[["2:43:5",7,"وَٱرْكَعُوا۟","and bow down","ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ","مَعَ ٱلرَّٰكِعِينَ",1434],["2:43:7",7,"ٱلرَّٰكِعِينَ","those who bow down","ٱلزَّكَوٰةَ وَٱرْكَعُوا۟ مَعَ","",998],["2:125:21",19,"وَٱلرُّكَّعِ","and those who bow down","بَيْتِىَ لِلطَّآئِفِينَ وَٱلْعَـٰكِفِينَ","ٱلسُّجُودِ",998],["3:43:5",55,"وَٱرْكَعِى","and bow down","ٱقْنُتِى لِرَبِّكِ وَٱسْجُدِى","مَعَ ٱلرَّٰكِعِينَ",1434],["3:43:7",55,"ٱلرَّٰكِعِينَ","those who bow down","وَٱسْجُدِى وَٱرْكَعِى مَعَ","",998],["5:55:13",117,"رَٰكِعُونَ","(are) those who bow down","وَيُؤْتُونَ ٱلزَّكَوٰةَ وَهُمْ","",998],["9:112:5",205,"ٱلرَّٰكِعُونَ","those who bow down","ٱلْعَـٰبِدُونَ ٱلْحَـٰمِدُونَ ٱلسَّـٰٓئِحُونَ","ٱلسَّـٰجِدُونَ ٱلْـَٔامِرُونَ بِٱلْمَعْرُوفِ",998],["22:26:15",335,"وَٱلرُّكَّعِ","and those who bow","بَيْتِىَ لِلطَّآئِفِينَ وَٱلْقَآئِمِينَ","ٱلسُّجُودِ",998],["22:77:4",341,"ٱرْكَعُوا۟","Bow","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","وَٱسْجُدُوا۟ وَٱعْبُدُوا۟ رَبَّكُمْ",1434],["38:24:31",454,"رَاكِعًۭا","bowing","فَٱسْتَغْفَرَ رَبَّهُۥ وَخَرَّ","وَأَنَابَ ۩",998],["48:29:12",515,"رُكَّعًۭا","bowing","رُحَمَآءُ بَيْنَهُمْ ۖ تَرَىٰهُمْ","سُجَّدًۭا يَبْتَغُونَ فَضْلًۭا",998],["77:48:4",581,"ٱرْكَعُوا۟","Bow","وَإِذَا قِيلَ لَهُمُ","لَا يَرْكَعُونَ",1434],["77:48:6",581,"يَرْكَعُونَ","they bow","لَهُمُ ٱرْكَعُوا۟ لَا","",1434]]