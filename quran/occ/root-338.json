[["2:90:27",14,"مُّهِينٌۭ","humiliating","غَضَبٍۢ ۚ وَلِلْكَـٰفِرِينَ عَذَابٌۭ","",670],["3:178:17",73,"مُّهِينٌۭ","humiliating","إِثْمًۭا ۚ وَلَهُمْ عَذَابٌۭ","",670],["4:14:13",79,"مُّهِينٌۭ","humiliating","فِيهَا وَلَهُۥ عَذَابٌۭ","",670],["4:37:15",84,"مُّهِينًۭا","humiliating","وَأَعْتَدْنَا لِلْكَـٰفِرِينَ عَذَابًۭا","",670],["4:102:62",95,"مُّهِينًۭا","humiliating","أَعَدَّ لِلْكَـٰفِرِينَ عَذَابًۭا","",670],["4:151:8",102,"مُّهِينًۭا","humiliating","وَأَعْتَدْنَا لِلْكَـٰفِرِينَ عَذَابًۭا","",670],["6:93:38",139,"ٱلْهُونِ","humiliating","ٱلْيَوْمَ تُجْزَوْنَ عَذَابَ","بِمَا كُنتُمْ تَقُولُونَ",1557],["16:59:11",273,"هُونٍ","humiliation","بِهِۦٓ ۚ أَيُمْسِكُهُۥ عَلَىٰ","أَمْ يَدُسُّهُۥ فِى",1557],["19:9:7",305,"هَيِّنٌۭ","(is) easy for Me","رَبُّكَ هُوَ عَلَىَّ","وَقَدْ خَلَقْتُكَ مِن",1850],["19:21:7",306,"هَيِّنٌۭ ۖ","easy","رَبُّكِ هُوَ عَلَىَّ","وَلِنَجْعَلَهُۥٓ ءَايَةًۭ لِّلنَّاسِ",1850],["22:18:27",334,"يُهِنِ","Allah humiliates","عَلَيْهِ ٱلْعَذَابُ ۗ وَمَن","ٱللَّهُ فَمَا لَهُۥ",2169],["22:57:8",339,"مُّهِينٌۭ","humiliating","فَأُو۟لَـٰٓئِكَ لَهُمْ عَذَابٌۭ","",670],["24:15:12",351,"هَيِّنًۭا","(was) insignificant","بِهِۦ عِلْمٌۭ وَتَحْسَبُونَهُۥ","وَهُوَ عِندَ ٱللَّهِ",1850],["25:63:7",365,"هَوْنًۭا","(in) humbleness","يَمْشُونَ عَلَى ٱلْأَرْضِ","وَإِذَا خَاطَبَهُمُ ٱلْجَـٰهِلُونَ",3498],["25:69:8",366,"مُهَانًا","humiliated","ٱلْقِيَـٰمَةِ وَيَخْلُدْ فِيهِۦ","",3805],["30:27:8",407,"أَهْوَنُ","(is) easier","ثُمَّ يُعِيدُهُۥ وَهُوَ","عَلَيْهِ ۚ وَلَهُ ٱلْمَثَلُ",2991],["31:6:18",411,"مُّهِينٌۭ","humiliating","أُو۟لَـٰٓئِكَ لَهُمْ عَذَابٌۭ","",670],["33:57:14",426,"مُّهِينًۭا","humiliating","وَأَعَدَّ لَهُمْ عَذَابًۭا","",670],["34:14:27",429,"ٱلْمُهِينِ","humiliating","لَبِثُوا۟ فِى ٱلْعَذَابِ","",670],["41:17:11",478,"ٱلْهُونِ","humiliating","فَأَخَذَتْهُمْ صَـٰعِقَةُ ٱلْعَذَابِ","بِمَا كَانُوا۟ يَكْسِبُونَ",1557],["44:30:7",497,"ٱلْمُهِينِ","the humiliating","إِسْرَٰٓءِيلَ مِنَ ٱلْعَذَابِ","",670],["45:9:11",499,"مُّهِينٌۭ","humiliating","أُو۟لَـٰٓ