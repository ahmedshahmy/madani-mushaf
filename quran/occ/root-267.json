[["2:233:31",37,"ٱلْوَارِثِ","the (father's) heir","لَّهُۥ بِوَلَدِهِۦ ۚ وَعَلَى","مِثْلُ ذَٰلِكَ ۗ فَإِنْ",1111],["3:180:24",73,"مِيرَٰثُ","(is the) heritage","يَوْمَ ٱلْقِيَـٰمَةِ ۗ وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۗ وَٱللَّهُ",2477],["4:11:39",78,"وَوَرِثَهُۥٓ","and inherit[ed] him","يَكُن لَّهُۥ وَلَدٌۭ","أَبَوَاهُ فَلِأُمِّهِ ٱلثُّلُثُ ۚ",701],["4:12:53",79,"يُورَثُ","(whose wealth) is to be inherited","وَإِن كَانَ رَجُلٌۭ","كَلَـٰلَةً أَوِ ٱمْرَأَةٌۭ",701],["4:19:8",80,"تَرِثُوا۟","you inherit","يَحِلُّ لَكُمْ أَن","ٱلنِّسَآءَ كَرْهًۭا ۖ وَلَا",701],["4:176:20",106,"يَرِثُهَآ","will inherit from her","مَا تَرَكَ ۚ وَهُوَ","إِن لَّمْ يَكُن",701],["7:43:33",155,"أُورِثْتُمُوهَا","you have been made to inherit it","أَن تِلْكُمُ ٱلْجَنَّةُ","بِمَا كُنتُمْ تَعْمَلُونَ",715],["7:100:4",163,"يَرِثُونَ","inherit","أَوَلَمْ يَهْدِ لِلَّذِينَ","ٱلْأَرْضَ مِنۢ بَعْدِ",701],["7:128:10",165,"يُورِثُهَا","He causes to inherit it","إِنَّ ٱلْأَرْضَ لِلَّهِ","مَن يَشَآءُ مِنْ",715],["7:137:1",166,"وَأَوْرَثْنَا","And We made inheritors","","ٱلْقَوْمَ ٱلَّذِينَ كَانُوا۟",715],["7:169:5",172,"وَرِثُوا۟","(who) inherited","مِنۢ بَعْدِهِمْ خَلْفٌۭ","ٱلْكِتَـٰبَ يَأْخُذُونَ عَرَضَ",701],["15:23:6",263,"ٱلْوَٰرِثُونَ","(are) the Inheritors","نُحْىِۦ وَنُمِيتُ وَنَحْنُ","",1111],["19:6:1",305,"يَرِثُنِى","Who will inherit me","","وَيَرِثُ مِنْ ءَالِ",701],["19:6:2",305,"وَيَرِثُ","and inherit","يَرِثُنِى","مِنْ ءَالِ يَعْقُوبَ ۖ",701],["19:40:3",308,"نَرِثُ","[We] will inherit","إِنَّا نَحْنُ","ٱلْأَرْضَ وَمَنْ عَلَيْهَا",701],["19:63:4",309,"نُورِثُ","We give (as) inheritance","تِلْكَ ٱلْجَنَّةُ ٱلَّتِى","مِنْ عِبَادِنَا مَن",715],["19:80:1",311,"وَنَرِثُهُۥ","And We will inherit (from) him","","مَا يَقُولُ وَيَأْتِينَا",701],["21:89:11",329,"ٱلْوَٰرِثِينَ","(of) the inheritors","فَرْدًۭا وَأَنتَ خَيْرُ","",1111],["21:105:10",331,"يَرِثُهَا","will inherit it","ٱلذِّكْرِ أَنَّ ٱلْأَرْضَ","عِبَادِىَ ٱلصَّـٰلِحُونَ",701],["23:10:3",342,"ٱلْوَٰرِثُونَ","(are) the inheritors","أُو۟لَـٰٓئِكَ هُمُ","",1111],["23:11:2",342,"يَرِثُونَ","will inherit","ٱلَّذِينَ","ٱلْفِرْدَوْسَ هُمْ فِيهَا",701],["26:59:2",369,"وَأَوْرَثْنَـٰهَا","And We caused to inherit them","كَذَٰلِكَ","بَنِىٓ إِسْرَٰٓءِيلَ",715],["26:85:3",371,"وَرَثَةِ","(the) inheritors","وَٱجْعَلْنِى مِن","جَنَّةِ ٱلنَّعِيمِ",1111],["27:16:1",378,"وَوَرِثَ","And inherited","","سُلَيْمَـٰنُ دَاوُۥدَ ۖ وَقَالَ",701],["28:5:12",385,"ٱلْوَٰرِثِينَ","the inheritors","وَنَجْعَلَهُمْ أَئِمَّةًۭ وَنَجْعَلَهُمُ","",1111],["28:58:17",392,"ٱلْوَٰرِثِينَ","(are) the inheritors","قَلِيلًۭا ۖ وَكُنَّا نَحْنُ","",1111],["33:27:1",421,"وَأَوْرَثَكُمْ","And He caused you to inherit","","أَرْضَهُمْ وَدِيَـٰرَهُمْ وَأَمْوَٰلَهُمْ",715],["35:32:2",438,"أَوْرَثْنَا","We caused to inherit","ثُمَّ","ٱلْكِتَـٰبَ ٱلَّذِينَ ٱصْطَفَيْنَا",715],["39:74:7",466,"وَأَوْرَثَنَا","and has made us inherit","ٱلَّذِى صَدَقَنَا وَعْدَهُۥ","ٱلْأَرْضَ نَتَبَوَّأُ مِنَ",715],["40:53:5",473,"وَأَوْرَثْنَا","and We caused to inherit","ءَاتَيْنَا مُوسَى ٱلْهُدَىٰ","بَنِىٓ إِسْرَٰٓءِيلَ ٱلْكِتَـٰبَ",715],["42:14:23",484,"أُورِثُوا۟","were made to inherit","بَيْنَهُمْ ۚ وَإِنَّ ٱلَّذِينَ","ٱلْكِتَـٰبَ مِنۢ بَعْدِهِمْ",715],["43:72:4",494,"أُورِثْتُمُوهَا","you are made to inherit","وَتِلْكَ ٱلْجَنَّةُ ٱلَّتِىٓ","بِمَا كُنتُمْ تَعْمَلُونَ",715],["44:28:2",497,"وَأَوْرَثْنَـٰهَا","And We made it (an) inherit(ance)","كَذَٰلِكَ ۖ","قَوْمًا ءَاخَرِينَ",715],["57:10:9",538,"مِيرَٰثُ","(is the) heritage","سَبِيلِ ٱللَّهِ وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ لَا",2477],["89:19:2",593,"ٱلتُّرَاثَ","the inheritance","وَتَأْكُلُونَ","أَكْلًۭا لَّمًّۭا",4491]]