[["14:28:12",259,"ٱلْبَوَارِ","(of) destruction","وَأَحَلُّوا۟ قَوْمَهُمْ دَارَ","",3349],["25:18:21",361,"بُورًۭا","ruined","ٱلذِّكْرَ وَكَانُوا۟ قَوْمًۢا","",2347],["35:10:24",435,"يَبُورُ","(will) perish","وَمَكْرُ أُو۟لَـٰٓئِكَ هُوَ","",2764],["35:29:16",437,"تَبُورَ","it will perish","يَرْجُونَ تِجَـٰرَةًۭ لَّن","",2764],["48:12:20",512,"بُورًۭا","ruined","ٱلسَّوْءِ وَكُنتُمْ قَوْمًۢا","",2347]]