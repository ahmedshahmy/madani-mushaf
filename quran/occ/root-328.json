[["2:60:12",9,"عَشْرَةَ","twelve","فَٱنفَجَرَتْ مِنْهُ ٱثْنَتَا","عَيْنًۭا ۖ قَدْ عَلِمَ",1760],["2:196:57",30,"عَشَرَةٌۭ","(is) ten (days)","إِذَا رَجَعْتُمْ ۗ تِلْكَ","كَامِلَةٌۭ ۗ ذَٰلِكَ لِمَن",2222],["2:234:10",38,"وَعَشْرًۭا ۖ","and ten (days)","بِأَنفُسِهِنَّ أَرْبَعَةَ أَشْهُرٍۢ","فَإِذَا بَلَغْنَ أَجَلَهُنَّ",1045],["4:19:22",80,"وَعَاشِرُوهُنَّ","And live with them","يَأْتِينَ بِفَـٰحِشَةٍۢ مُّبَيِّنَةٍۢ ۚ","بِٱلْمَعْرُوفِ ۚ فَإِن كَرِهْتُمُوهُنَّ",3088],["5:12:10",109,"عَشَرَ","(and) ten","وَبَعَثْنَا مِنْهُمُ ٱثْنَىْ","نَقِيبًۭا ۖ وَقَالَ ٱللَّهُ",1494],["5:89:14",122,"عَشَرَةِ","(of) ten","ٱلْأَيْمَـٰنَ ۖ فَكَفَّـٰرَتُهُۥٓ إِطْعَامُ","مَسَـٰكِينَ مِنْ أَوْسَطِ",2222],["6:128:4",144,"يَـٰمَعْشَرَ","(and will say), \"O assembly","وَيَوْمَ يَحْشُرُهُمْ جَمِيعًۭا","ٱلْجِنِّ قَدِ ٱسْتَكْثَرْتُم",1880],["6:130:1",144,"يَـٰمَعْشَرَ","O assembly","","ٱلْجِنِّ وَٱلْإِنسِ أَلَمْ",1880],["6:160:5",150,"عَشْرُ","(is) ten (times)","جَآءَ بِٱلْحَسَنَةِ فَلَهُۥ","أَمْثَالِهَا ۖ وَمَن جَآءَ",1045],["7:142:6",167,"بِعَشْرٍۢ","with ten (more)","ثَلَـٰثِينَ لَيْلَةًۭ وَأَتْمَمْنَـٰهَا","فَتَمَّ مِيقَـٰتُ رَبِّهِۦٓ",1045],["7:160:3",171,"عَشْرَةَ","(and) ten [i.e. twelve]","وَقَطَّعْنَـٰهُمُ ٱثْنَتَىْ","أَسْبَاطًا أُمَمًۭا ۚ وَأَوْحَيْنَآ",1760],["7:160:19",171,"عَشْرَةَ","(and) ten [i.e. twelve]","فَٱنۢبَجَسَتْ مِنْهُ ٱثْنَتَا","عَيْنًۭا ۖ قَدْ عَلِمَ",1760],["8:65:10",185,"عِشْرُونَ","twenty","إِن يَكُن مِّنكُمْ","صَـٰبِرُونَ يَغْلِبُوا۟ مِا۟ئَتَيْنِ ۚ",3135],["9:24:8",190,"وَعَشِيرَتُكُمْ","and your relatives","وَأَبْنَآؤُكُمْ وَإِخْوَٰنُكُمْ وَأَزْوَٰجُكُمْ","وَأَمْوَٰلٌ ٱقْتَرَفْتُمُوهَا وَتِجَـٰرَةٌۭ",1759],["9:36:7",192,"عَشَرَ","(is) twelve","عِندَ ٱللَّهِ ٱثْنَا","شَهْرًۭا فِى كِتَـٰبِ",1494],["11:13:6",223,"بِعَشْرِ","ten","افْتَرَاهُ ۖ قُلْ فَأْتُوا۟","سُوَرٍۢ مِّثْلِهِۦ مُفْتَرَيَـٰتٍۢ",1045],["12:4:9",235,"عَشَرَ","eleven","إِنِّى رَأَيْتُ أَحَدَ","كَوْكَبًۭا وَٱلشَّمْسَ وَٱلْقَمَرَ",1494],["20:103:6",319,"عَشْرًۭا","ten","إِن لَّبِثْتُمْ إِلَّا","",1045],