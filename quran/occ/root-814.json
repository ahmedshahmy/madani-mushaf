[["3:151:6",69,"ٱلرُّعْبَ","[the] terror","قُلُوبِ ٱلَّذِينَ كَفَرُوا۟","بِمَآ أَشْرَكُوا۟ بِٱللَّهِ",1391],["8:12:16",178,"ٱلرُّعْبَ","the terror","قُلُوبِ ٱلَّذِينَ كَفَرُوا۟","فَٱضْرِبُوا۟ فَوْقَ ٱلْأَعْنَاقِ",1391],["18:18:22",295,"رُعْبًۭا","(with) terror","فِرَارًۭا وَلَمُلِئْتَ مِنْهُمْ","",1391],["33:26:12",421,"ٱلرُّعْبَ","[the] terror","وَقَذَفَ فِى قُلُوبِهِمُ","فَرِيقًۭا تَقْتُلُونَ وَتَأْسِرُونَ",1391],["59:2:32",545,"ٱلرُّعْبَ ۚ","[the] terror","وَقَذَفَ فِى قُلُوبِهِمُ","يُخْرِبُونَ بُيُوتَهُم بِأَيْدِيهِمْ",1391]]