[["16:96:3",278,"يَنفَدُ ۖ","will be exhausted","مَا عِندَكُمْ","وَمَا عِندَ ٱللَّهِ",1612],["18:109:8",304,"لَنَفِدَ","surely (would be) exhausted","مِدَادًۭا لِّكَلِمَـٰتِ رَبِّى","ٱلْبَحْرُ قَبْلَ أَن",1612],["18:109:12",304,"تَنفَدَ","(were) exhausted","ٱلْبَحْرُ قَبْلَ أَن","كَلِمَـٰتُ رَبِّى وَلَوْ",1612],["31:27:15",413,"نَفِدَتْ","would be exhausted","سَبْعَةُ أَبْحُرٍۢ مَّا","كَلِمَـٰتُ ٱللَّهِ ۗ إِنَّ",1612],["38:54:7",456,"نَّفَادٍ","depletion","مَا لَهُۥ مِن","",4087]]