[["2:60:2",9,"ٱسْتَسْقَىٰ","asked (for) water","۞ وَإِذِ","مُوسَىٰ لِقَوْمِهِۦ فَقُلْنَا",2850],["2:71:11",11,"تَسْقِى","water","تُثِيرُ ٱلْأَرْضَ وَلَا","ٱلْحَرْثَ مُسَلَّمَةٌۭ لَّا",742],["7:160:10",171,"ٱسْتَسْقَىٰهُ","asked him for water","إِلَىٰ مُوسَىٰٓ إِذِ","قَوْمُهُۥٓ أَنِ ٱضْرِب",2850],["9:19:2",189,"سِقَايَةَ","the providing of water","۞ أَجَعَلْتُمْ","ٱلْحَآجِّ وَعِمَارَةَ ٱلْمَسْجِدِ",2638],["12:41:5",240,"فَيَسْقِى","he will give drink","ٱلسِّجْنِ أَمَّآ أَحَدُكُمَا","رَبَّهُۥ خَمْرًۭا ۖ وَأَمَّا",742],["12:70:5",244,"ٱلسِّقَايَةَ","the drinking cup","جَهَّزَهُم بِجَهَازِهِمْ جَعَلَ","فِى رَحْلِ أَخِيهِ",2638],["13:4:13",249,"يُسْقَىٰ","watered","صِنْوَانٌۭ وَغَيْرُ صِنْوَانٍۢ","بِمَآءٍۢ وَٰحِدٍۢ وَنُفَضِّلُ",742],["14:16:4",257,"وَيُسْقَىٰ","and he will be made to drink","مِّن وَرَآئِهِۦ جَهَنَّمُ","مِن مَّآءٍۢ صَدِيدٍۢ",742],["15:22:8",263,"فَأَسْقَيْنَـٰكُمُوهُ","and We gave it to you to drink","مِنَ ٱلسَّمَآءِ مَآءًۭ","وَمَآ أَنتُمْ لَهُۥ",955],["16:66:6",274,"نُّسْقِيكُم","We give you to drink","فِى ٱلْأَنْعَـٰمِ لَعِبْرَةًۭ ۖ","مِّمَّا فِى بُطُونِهِۦ",955],["23:21:6",343,"نُّسْقِيكُم","We give you drink","فِى ٱلْأَنْعَـٰمِ لَعِبْرَةًۭ ۖ","مِّمَّا فِى بُطُونِهَا",955],["25:49:5",364,"وَنُسْقِيَهُۥ","and We give drink","بِهِۦ بَلْدَةًۭ مَّيْتًۭا","مِمَّا خَلَقْنَآ أَنْعَـٰمًۭا",955],["26:79:4",370,"وَيَسْقِينِ","and gives me drink","وَٱلَّذِى هُوَ يُطْعِمُنِى","",742],["28:23:10",388,"يَسْقُونَ","watering","أُمَّةًۭ مِّنَ ٱلنَّاسِ","وَوَجَدَ مِن دُونِهِمُ",742],["28:23:21",388,"نَسْقِى","We cannot water","خَطْبُكُمَا ۖ قَالَتَا لَا","حَتَّىٰ يُصْدِرَ ٱلرِّعَآءُ ۖ",742],["28:24:1",388,"فَسَقَىٰ","So he watered","","لَهُمَا ثُمَّ تَوَلَّىٰٓ",742],["28:25:13",388,"سَقَيْتَ","you watered","لِيَجْزِيَكَ أَجْرَ مَا","لَنَا ۚ فَلَمَّا جَآءَهُۥ",742],["47:15:40",508,"وَسُقُوا۟","and they will be given to drink","خَـٰلِدٌۭ فِى ٱلنَّارِ","مَآءً حَمِيمًۭا فَقَطَّعَ",742],["72:16:5",573,"لَأَسْقَيْنَـٰهُم","surely We (would) have given them to drink","ٱسْتَقَـٰمُوا۟ عَلَى ٱلطَّرِيقَةِ","مَّآءً غَدَقًۭا",955],["76:17:1",579,"وَيُسْقَوْنَ","And they will be given to drink","","فِيهَا كَأْسًۭا كَانَ",955],["76:21:10",579,"وَسَقَىٰهُمْ","and will give them to drink","أَسَاوِرَ مِن فِضَّةٍۢ","رَبُّهُمْ شَرَابًۭا طَهُورًا",742],["77:27:5",581,"وَأَسْقَيْنَـٰكُم","and We gave you to drink","فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍۢ","مَّآءًۭ فُرَاتًۭا",955],["83:25:1",588,"يُسْقَوْنَ","They will be given to drink","","مِن رَّحِيقٍۢ مَّخْتُومٍ",955],["88:5:1",592,"تُسْقَىٰ","They will be given to drink","","مِنْ عَيْنٍ ءَانِيَةٍۢ",742],["91:13:7",595,"وَسُقْيَـٰهَا","and her drink","ٱللَّهِ نَاقَةَ ٱللَّهِ","",4281]]