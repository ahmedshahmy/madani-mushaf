[["2:143:39",22,"لِيُضِيعَ","let go waste","وَمَا كَانَ ٱللَّهُ","إِيمَـٰنَكُمْ ۚ إِنَّ ٱللَّهَ",812],["3:171:9",72,"يُضِيعُ","let go waste","وَأَنَّ ٱللَّهَ لَا","أَجْرَ ٱلْمُؤْمِنِينَ",812],["3:195:6",76,"أُضِيعُ","(let go) waste","رَبُّهُمْ أَنِّى لَآ","عَمَلَ عَـٰمِلٍۢ مِّنكُم",812],["7:170:8",172,"نُضِيعُ","[We] let go waste","ٱلصَّلَوٰةَ إِنَّا لَا","أَجْرَ ٱلْمُصْلِحِينَ",812],["9:120:50",206,"يُضِيعُ","allow to be lost","إِنَّ ٱللَّهَ لَا","أَجْرَ ٱلْمُحْسِنِينَ",812],["11:115:5",234,"يُضِيعُ","let go waste","فَإِنَّ ٱللَّهَ لَا","أَجْرَ ٱلْمُحْسِنِينَ",812],["12:56:15",242,"نُضِيعُ","We let go waste","مَن نَّشَآءُ ۖ وَلَا","أَجْرَ ٱلْمُحْسِنِينَ",812],["12:90:21",246,"يُضِيعُ","let go waste","فَإِنَّ ٱللَّهَ لَا","أَجْرَ ٱلْمُحْسِنِينَ",812],["18:30:8",297,"نُضِيعُ","will not let go waste","ٱلصَّـٰلِحَـٰتِ إِنَّا لَا","أَجْرَ مَنْ أَحْسَنَ",812],["19:59:5",309,"أَضَاعُوا۟","who neglected","مِنۢ بَعْدِهِمْ خَلْفٌ","ٱلصَّلَوٰةَ وَٱتَّبَعُوا۟ ٱلشَّهَوَٰتِ ۖ",812]]