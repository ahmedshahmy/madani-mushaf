[["6:6:9",128,"مَّكَّنَّـٰهُمْ","We had established them","قَبْلِهِم مِّن قَرْنٍۢ","فِى ٱلْأَرْضِ مَا",690],["6:6:14",128,"نُمَكِّن","We (have) established","ٱلْأَرْضِ مَا لَمْ","لَّكُمْ وَأَرْسَلْنَا ٱلسَّمَآءَ",690],["7:10:2",151,"مَكَّنَّـٰكُمْ","We established you","وَلَقَدْ","فِى ٱلْأَرْضِ وَجَعَلْنَا",690],["8:71:9",186,"فَأَمْكَنَ","So He gave (you) power","ٱللَّهَ مِن قَبْلُ","مِنْهُمْ ۗ وَٱللَّهُ عَلِيمٌ",3014],["12:21:16",237,"مَكَّنَّا","We established","نَتَّخِذَهُۥ وَلَدًۭا ۚ وَكَذَٰلِكَ","لِيُوسُفَ فِى ٱلْأَرْضِ",690],["12:54:13",242,"مَكِينٌ","firmly established","إِنَّكَ ٱلْيَوْمَ لَدَيْنَا","أَمِينٌۭ",1599],["12:56:2",242,"مَكَّنَّا","We established","وَكَذَٰلِكَ","لِيُوسُفَ فِى ٱلْأَرْضِ",690],["18:84:2",303,"مَكَّنَّا","[We] established","إِنَّا","لَهُۥ فِى ٱلْأَرْضِ",690],["18:95:3",303,"مَكَّنِّى","has established me","قَالَ مَا","فِيهِ رَبِّى خَيْرٌۭ",690],["22:41:3",337,"مَّكَّنَّـٰهُمْ","We establish them","ٱلَّذِينَ إِن","فِى ٱلْأَرْضِ أَقَامُوا۟",690],["23:13:6",342,"مَّكِينٍۢ","firm","نُطْفَةًۭ فِى قَرَارٍۢ","",1599],["24:55:16",357,"وَلَيُمَكِّنَنَّ","and that He will surely establish","ٱلَّذِينَ مِن قَبْلِهِمْ","لَهُمْ دِينَهُمُ ٱلَّذِى",690],["28:6:1",386,"وَنُمَكِّنَ","And [We] establish","","لَهُمْ فِى ٱلْأَرْضِ",690],["28:57:10",392,"نُمَكِّن","We established","مِنْ أَرْضِنَآ ۚ أَوَلَمْ","لَّهُمْ حَرَمًا ءَامِنًۭا",690],["46:26:2",505,"مَكَّنَّـٰهُمْ","We had established them","وَلَقَدْ","فِيمَآ إِن مَّكَّنَّـٰكُمْ",690],["46:26:5",505,"مَّكَّنَّـٰكُمْ","We have established you","مَكَّنَّـٰهُمْ فِيمَآ إِن","فِيهِ وَجَعَلْنَا لَهُمْ",690],["77:21:4",581,"مَّكِينٍ","safe","فَجَعَلْنَـٰهُ فِى قَرَارٍۢ","",1599],["81:20:6",586,"مَكِينٍۢ","secure","عِندَ ذِى ٱلْعَرْشِ","",1599]]