[["11:78:22",230,"ضَيْفِىٓ ۖ","my guests","وَلَا تُخْزُونِ فِى","أَلَيْسَ مِنكُمْ رَجُلٌۭ",1288],["15:51:3",264,"ضَيْفِ","(the) guests","وَنَبِّئْهُمْ عَن","إِبْرَٰهِيمَ",1288],["15:68:4",265,"ضَيْفِى","(are) my guests","قَالَ إِنَّ هَـٰٓؤُلَآءِ","فَلَا تَفْضَحُونِ",1288],["18:77:11",302,"يُضَيِّفُوهُمَا","offer them hospitality","أَهْلَهَا فَأَبَوْا۟ أَن","فَوَجَدَا فِيهَا جِدَارًۭا",4701],["51:24:4",521,"ضَيْفِ","(of the) guests","هَلْ أَتَىٰكَ حَدِيثُ","إِبْرَٰهِيمَ ٱلْمُكْرَمِينَ",1288],["54:37:4",530,"ضَيْفِهِۦ","his guests","وَلَقَدْ رَٰوَدُوهُ عَن","فَطَمَسْنَآ أَعْيُنَهُمْ فَذُوقُوا۟",1288]]