[["2:51:4",8,"أَرْبَعِينَ","forty","وَإِذْ وَٰعَدْنَا مُوسَىٰٓ","لَيْلَةًۭ ثُمَّ ٱتَّخَذْتُمُ",1039],["2:226:6",36,"أَرْبَعَةِ","four","مِن نِّسَآئِهِمْ تَرَبُّصُ","أَشْهُرٍۢ ۖ فَإِن فَآءُو",877],["2:234:8",38,"أَرْبَعَةَ","(for) four","أَزْوَٰجًۭا يَتَرَبَّصْنَ بِأَنفُسِهِنَّ","أَشْهُرٍۢ وَعَشْرًۭا ۖ فَإِذَا",877],["2:260:19",44,"أَرْبَعَةًۭ","four","قَلْبِى ۖ قَالَ فَخُذْ","مِّنَ ٱلطَّيْرِ فَصُرْهُنَّ",877],["4:3:15",77,"وَرُبَـٰعَ ۖ","or four","ٱلنِّسَآءِ مَثْنَىٰ وَثُلَـٰثَ","فَإِنْ خِفْتُمْ أَلَّا",2607],["4:12:16",79,"ٱلرُّبُعُ","(is) the fourth","لَهُنَّ وَلَدٌۭ فَلَكُمُ","مِمَّا تَرَكْنَ ۚ مِنۢ",2615],["4:12:27",79,"ٱلرُّبُعُ","(is) the fourth","أَوْ دَيْنٍۢ ۚ وَلَهُنَّ","مِمَّا تَرَكْتُمْ إِن",2615],["4:15:8",80,"أَرْبَعَةًۭ","four","نِّسَآئِكُمْ فَٱسْتَشْهِدُوا۟ عَلَيْهِنَّ","مِّنكُمْ ۖ فَإِن شَهِدُوا۟",877],["5:26:5",112,"أَرْبَعِينَ","(for) forty","فَإِنَّهَا مُحَرَّمَةٌ عَلَيْهِمْ ۛ","سَنَةًۭ ۛ يَتِيهُونَ فِى",1039],["7:142:10",167,"أَرْبَعِينَ","(of) forty","فَتَمَّ مِيقَـٰتُ رَبِّهِۦٓ","لَيْلَةًۭ ۚ وَقَالَ مُوسَىٰ",1039],["9:2:4",187,"أَرْبَعَةَ","(during) four","فَسِيحُوا۟ فِى ٱلْأَرْضِ","أَشْهُرٍۢ وَٱعْلَمُوٓا۟ أَنَّكُمْ",877],["9:36:17",192,"أَرْبَعَةٌ","four","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ مِنْهَآ","حُرُمٌۭ ۚ ذَٰلِكَ ٱلدِّينُ",877],["18:22:3",296,"رَّابِعُهُمْ","the forth of them","سَيَقُولُونَ ثَلَـٰثَةٌۭ","كَلْبُهُمْ وَيَقُولُونَ خَمْسَةٌۭ",2593],["24:4:7",350,"بِأَرْبَعَةِ","four","ثُمَّ لَمْ يَأْتُوا۟","شُهَدَآءَ فَٱجْلِدُوهُمْ ثَمَـٰنِينَ",877],["24:6:12",350,"أَرْبَعُ","(is) four","أَنفُسُهُمْ فَشَهَـٰدَةُ أَحَدِهِمْ","شَهَـٰدَٰتٍۭ بِٱللَّهِ ۙ إِنَّهُۥ",1039],["24:8:6",350,"أَرْبَعَ","four","ٱلْعَذَابَ أَن تَشْهَدَ","شَهَـٰدَٰتٍۭ بِٱللَّهِ ۙ إِنَّهُۥ",1039],["24:13:4",351,"بِأَرْبَعَةِ","four","لَّوْلَا جَآءُو عَلَيْهِ","شُهَدَآءَ ۚ فَإِذْ لَمْ",877],["24:45:21",356,"أَرْبَعٍۢ ۚ","four","مَّن يَمْشِى عَلَىٰٓ","يَخْلُقُ ٱللَّهُ مَا",1039],["35:1:13",434,"وَرُبَـٰعَ ۚ","or four","أَجْنِحَةٍۢ مَّثْنَىٰ وَثُلَـٰثَ","يَزِيدُ فِى ٱلْخَلْقِ",2607],["41:10:12",477,"أَرْبَعَةِ","four","فِيهَآ أَقْوَٰتَهَا فِىٓ","أَيَّامٍۢ سَوَآءًۭ لِّلسَّآئِلِينَ",877],["46:15:19",504,"أَرْبَعِينَ","forty","بَلَغَ أَشُدَّهُۥ وَبَلَغَ","سَنَةًۭ قَالَ رَبِّ",1039],["58:7:19",543,"رَابِعُهُمْ","(the) fourth of them","ثَلَـٰثَةٍ إِلَّا هُوَ","وَلَا خَمْسَةٍ إِلَّا",2593]]