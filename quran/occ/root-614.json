[["3:122:2",66,"هَمَّت","inclined","إِذْ","طَّآئِفَتَانِ مِنكُمْ أَن",974],["3:154:14",70,"أَهَمَّتْهُمْ","worried [them]","مِّنكُمْ ۖ وَطَآئِفَةٌۭ قَدْ","أَنفُسُهُمْ يَظُنُّونَ بِٱللَّهِ",2989],["4:113:6",96,"لَهَمَّت","surely (had) resolved","ٱللَّهِ عَلَيْكَ وَرَحْمَتُهُۥ","طَّآئِفَةٌۭ مِّنْهُمْ أَن",974],["5:11:9",109,"هَمَّ","determined","ٱللَّهِ عَلَيْكُمْ إِذْ","قَوْمٌ أَن يَبْسُطُوٓا۟",974],["9:13:6",188,"وَهَمُّوا۟","and determined","قَوْمًۭا نَّكَثُوٓا۟ أَيْمَـٰنَهُمْ","بِإِخْرَاجِ ٱلرَّسُولِ وَهُم",974],["9:74:12",199,"وَهَمُّوا۟","and planned","وَكَفَرُوا۟ بَعْدَ إِسْلَـٰمِهِمْ","بِمَا لَمْ يَنَالُوا۟ ۚ",974],["12:24:2",238,"هَمَّتْ","she did desire","وَلَقَدْ","بِهِۦ ۖ وَهَمَّ بِهَا",974],["12:24:4",238,"وَهَمَّ","and he would have desired","وَلَقَدْ هَمَّتْ بِهِۦ ۖ","بِهَا لَوْلَآ أَن",974],["40:5:8",467,"وَهَمَّتْ","and plotted","وَٱلْأَحْزَابُ مِنۢ بَعْدِهِمْ ۖ","كُلُّ أُمَّةٍۭ بِرَسُولِهِمْ",974]]