[["6:31:11",131,"بَغْتَةًۭ","suddenly","إِذَا جَآءَتْهُمُ ٱلسَّاعَةُ","قَالُوا۟ يَـٰحَسْرَتَنَا عَلَىٰ",684],["6:44:17",132,"بَغْتَةًۭ","suddenly","بِمَآ أُوتُوٓا۟ أَخَذْنَـٰهُم","فَإِذَا هُم مُّبْلِسُونَ",684],["6:47:7",133,"بَغْتَةً","suddenly","أَتَىٰكُمْ عَذَابُ ٱللَّهِ","أَوْ جَهْرَةً هَلْ",684],["7:95:15",162,"بَغْتَةًۭ","suddenly","ٱلضَّرَّآءُ وَٱلسَّرَّآءُ فَأَخَذْنَـٰهُم","وَهُمْ لَا يَشْعُرُونَ",684],["7:187:23",174,"بَغْتَةًۭ ۗ","suddenly","لَا تَأْتِيكُمْ إِلَّا","يَسْـَٔلُونَكَ كَأَنَّكَ حَفِىٌّ",684],["12:107:11",248,"بَغْتَةًۭ","suddenly","أَوْ تَأْتِيَهُمُ ٱلسَّاعَةُ","وَهُمْ لَا يَشْعُرُونَ",684],["21:40:3",325,"بَغْتَةًۭ","unexpectedly","بَلْ تَأْتِيهِم","فَتَبْهَتُهُمْ فَلَا يَسْتَطِيعُونَ",684],["22:55:11",338,"بَغْتَةً","suddenly","حَتَّىٰ تَأْتِيَهُمُ ٱلسَّاعَةُ","أَوْ يَأْتِيَهُمْ عَذَابُ",684],["26:202:2",375,"بَغْتَةًۭ","suddenly","فَيَأْتِيَهُم","وَهُمْ لَا يَشْعُرُونَ",684],["29:53:9",403,"بَغْتَةًۭ","suddenly","لَّجَآءَهُمُ ٱلْعَذَابُ وَلَيَأْتِيَنَّهُم","وَهُمْ لَا يَشْعُرُونَ",684],["39:55:13",464,"بَغْتَةًۭ","suddenly","أَن يَأْتِيَكُمُ ٱلْعَذَابُ","وَأَنتُمْ لَا تَشْعُرُونَ",684],["43:66:7",494,"بَغْتَةًۭ","suddenly","ٱلسَّاعَةَ أَن تَأْتِيَهُم","وَهُمْ لَا يَشْعُرُونَ",684],["47:18:7",508,"بَغْتَةًۭ ۖ","suddenly","ٱلسَّاعَةَ أَن تَأْتِيَهُم","فَقَدْ جَآءَ أَشْرَاطُهَا ۚ",684]]