[["5:38:1",114,"وَٱلسَّارِقُ","And (for) the male thief","","وَٱلسَّارِقَةُ فَٱقْطَعُوٓا۟ أَيْدِيَهُمَا",1999],["5:38:2",114,"وَٱلسَّارِقَةُ","and the female thief","وَٱلسَّارِقُ","فَٱقْطَعُوٓا۟ أَيْدِيَهُمَا جَزَآءًۢ",4291],["12:70:15",244,"لَسَـٰرِقُونَ","surely (are) thieves","أَيَّتُهَا ٱلْعِيرُ إِنَّكُمْ","",1999],["12:73:12",244,"سَـٰرِقِينَ","thieves","ٱلْأَرْضِ وَمَا كُنَّا","",1999],["12:77:3",244,"يَسْرِقْ","he steals","۞ قَالُوٓا۟ إِن","فَقَدْ سَرَقَ أَخٌۭ",1640],["12:77:5",244,"سَرَقَ","stole","إِن يَسْرِقْ فَقَدْ","أَخٌۭ لَّهُۥ مِن",1640],["12:81:8",245,"سَرَقَ","has stolen","يَـٰٓأَبَانَآ إِنَّ ٱبْنَكَ","وَمَا شَهِدْنَآ إِلَّا",1640],["15:18:3",263,"ٱسْتَرَقَ","steals","إِلَّا مَنِ","ٱلسَّمْعَ فَأَتْبَعَهُۥ شِهَابٌۭ",4834],["60:12:14",551,"يَسْرِقْنَ","they will steal","بِٱللَّهِ شَيْـًۭٔا وَلَا","وَلَا يَزْنِينَ وَلَا",1640]]