[["2:104:6",16,"رَٰعِنَا","Raina","ءَامَنُوا۟ لَا تَقُولُوا۟","وَقُولُوا۟ ٱنظُرْنَا وَٱسْمَعُوا۟ ۗ",2598],["4:46:14",86,"وَرَٰعِنَا","and \"Raina","وَٱسْمَعْ غَيْرَ مُسْمَعٍۢ","لَيًّۢا بِأَلْسِنَتِهِمْ وَطَعْنًۭا",2598],["20:54:2",315,"وَٱرْعَوْا۟","and pasture","كُلُوا۟","أَنْعَـٰمَكُمْ ۗ إِنَّ فِى",2594],["23:8:5",342,"رَٰعُونَ","(are) observers","هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ","",2599],["28:23:24",388,"ٱلرِّعَآءُ ۖ","the shepherds","نَسْقِى حَتَّىٰ يُصْدِرَ","وَأَبُونَا شَيْخٌۭ كَبِيرٌۭ",4219],["57:27:29",541,"رَعَوْهَا","they observed it","رِضْوَٰنِ ٱللَّهِ فَمَا","حَقَّ رِعَايَتِهَا ۖ فَـَٔاتَيْنَا",2594],["57:27:31",541,"رِعَايَتِهَا ۖ","observance","فَمَا رَعَوْهَا حَقَّ","فَـَٔاتَيْنَا ٱلَّذِينَ ءَامَنُوا۟",4186],["70:32:5",569,"رَٰعُونَ","(are) observers","هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ","",2599],["79:31:4",584,"وَمَرْعَىٰهَا","and its pasture","أَخْرَجَ مِنْهَا مَآءَهَا","",2460],["87:4:3",591,"ٱلْمَرْعَىٰ","the pasture","وَٱلَّذِىٓ أَخْرَجَ","",2460]]