:8:14",405,"وَأَجَلٍۢ","and (for) a term","بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ","مُّسَمًّۭى ۗ وَإِنَّ كَثِيرًۭا",226],["31:29:19",414,"أَجَلٍۢ","a term","كُلٌّۭ يَجْرِىٓ إِلَىٰٓ","مُّسَمًّۭى وَأَنَّ ٱللَّهَ",226],["35:13:14",436,"لِأَجَلٍۢ","for a term","وَٱلْقَمَرَ كُلٌّۭ يَجْرِى","مُّسَمًّۭى ۚ ذَٰلِكُمُ ٱللَّهُ",226],["35:45:16",440,"أَجَلٍۢ","a term","وَلَـٰكِن يُؤَخِّرُهُمْ إِلَىٰٓ","مُّسَمًّۭى ۖ فَإِذَا جَآءَ",226],["35:45:20",440,"أَجَلُهُمْ","their term","مُّسَمًّۭى ۖ فَإِذَا جَآءَ","فَإِنَّ ٱللَّهَ كَانَ",226],["39:5:18",458,"لِأَجَلٍۢ","for a term","وَٱلْقَمَرَ ۖ كُلٌّۭ يَجْرِى","مُّسَمًّى ۗ أَلَا هُوَ",226],["39:42:19",463,"أَجَلٍۢ","a term","وَيُرْسِلُ ٱلْأُخْرَىٰٓ إِلَىٰٓ","مُّسَمًّى ۚ إِنَّ فِى",226],["40:67:27",475,"أَجَلًۭا","a term","مِن قَبْلُ ۖ وَلِتَبْلُغُوٓا۟","مُّسَمًّۭى وَلَعَلَّكُمْ تَعْقِلُونَ",226],["42:14:17",484,"أَجَلٍۢ","a term","مِن رَّبِّكَ إِلَىٰٓ","مُّسَمًّۭى لَّقُضِىَ بَيْنَهُمْ ۚ",226],["46:3:9",502,"وَأَجَلٍۢ","and (for) a term","بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ","مُّسَمًّۭى ۚ وَٱلَّذِينَ كَفَرُوا۟",226],["63:10:16",555,"أَجَلٍۢ","a term","لَوْلَآ أَخَّرْتَنِىٓ إِلَىٰٓ","قَرِيبٍۢ فَأَصَّدَّقَ وَأَكُن",226],["63:11:7",555,"أَجَلُهَا ۚ","its term","نَفْسًا إِذَا جَآءَ","وَٱللَّهُ خَبِيرٌۢ بِمَا",226],["65:2:3",558,"أَجَلَهُنَّ","their term","فَإِذَا بَلَغْنَ","فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ",226],["65:4:17",558,"أَجَلُهُنَّ","their term","يَحِضْنَ ۚ وَأُو۟لَـٰتُ ٱلْأَحْمَالِ","أَن يَضَعْنَ حَمْلَهُنَّ ۚ",226],["71:4:7",570,"أَجَلٍۢ","a term","ذُنُوبِكُمْ وَيُؤَخِّرْكُمْ إِلَىٰٓ","مُّسَمًّى ۚ إِنَّ أَجَلَ",226],["71:4:10",570,"أَجَلَ","(the) term","أَجَلٍۢ مُّسَمًّى ۚ إِنَّ","ٱللَّهِ إِذَا جَآءَ",226],["77:12:3",580,"أُجِّلَتْ","are (these) postponed","لِأَىِّ يَوْمٍ","",2170]]