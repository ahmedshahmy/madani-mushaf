[["2:231:5",37,"أَجَلَهُنَّ","their (waiting) term","طَلَّقْتُمُ ٱلنِّسَآءَ فَبَلَغْنَ","فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ",226],["2:232:5",37,"أَجَلَهُنَّ","their (waiting) term","طَلَّقْتُمُ ٱلنِّسَآءَ فَبَلَغْنَ","فَلَا تَعْضُلُوهُنَّ أَن",226],["2:234:13",38,"أَجَلَهُنَّ","their (specified) term","وَعَشْرًۭا ۖ فَإِذَا بَلَغْنَ","فَلَا جُنَاحَ عَلَيْكُمْ",226],["2:235:34",38,"أَجَلَهُۥ ۚ","its end","حَتَّىٰ يَبْلُغَ ٱلْكِتَـٰبُ","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ",226],["2:282:8",48,"أَجَلٍۢ","a term","تَدَايَنتُم بِدَيْنٍ إِلَىٰٓ","مُّسَمًّۭى فَٱكْتُبُوهُ ۚ وَلْيَكْتُب",226],["2:282:86",48,"أَجَلِهِۦ ۚ","its term","أَوْ كَبِيرًا إِلَىٰٓ","ذَٰلِكُمْ أَقْسَطُ عِندَ",226],["3:145:10",68,"مُّؤَجَّلًۭا ۗ","determined","بِإِذْنِ ٱللَّهِ كِتَـٰبًۭا","وَمَن يُرِدْ ثَوَابَ",3950],["4:77:36",90,"أَجَلٍۢ","a term","لَوْلَآ أَخَّرْتَنَآ إِلَىٰٓ","قَرِيبٍۢ ۗ قُلْ مَتَـٰعُ",226],["5:32:2",113,"أَجْلِ","time","مِنْ","ذَٰلِكَ كَتَبْنَا عَلَىٰ",2995],["6:2:8",128,"أَجَلًۭا ۖ","a term","طِينٍۢ ثُمَّ قَضَىٰٓ","وَأَجَلٌۭ مُّسَمًّى عِندَهُۥ ۖ",226],["6:2:9",128,"وَأَجَلٌۭ","and a term","ثُمَّ قَضَىٰٓ أَجَلًۭا ۖ","مُّسَمًّى عِندَهُۥ ۖ ثُمَّ",226],["6:60:13",135,"أَجَلٌۭ","(the) term","يَبْعَثُكُمْ فِيهِ لِيُقْضَىٰٓ","مُّسَمًّۭى ۖ ثُمَّ إِلَيْهِ",226],["6:128:19",144,"أَجَلَنَا","our term","بَعْضُنَا بِبَعْضٍۢ وَبَلَغْنَآ","ٱلَّذِىٓ أَجَّلْتَ لَنَا ۚ",226],["6:128:21",144,"أَجَّلْتَ","You appointed","وَبَلَغْنَآ أَجَلَنَا ٱلَّذِىٓ","لَنَا ۚ قَالَ ٱلنَّارُ",2170],["7:34:3",154,"أَجَلٌۭ ۖ","(is a fixed) term","وَلِكُلِّ أُمَّةٍ","فَإِذَا جَآءَ أَجَلُهُمْ",226],["7:34:6",154,"أَجَلُهُمْ","their term","أَجَلٌۭ ۖ فَإِذَا جَآءَ","لَا يَسْتَأْخِرُونَ سَاعَةًۭ ۖ",226],["7:135:6",166,"أَجَلٍ","a (fixed) term","عَنْهُمُ ٱلرِّجْزَ إِلَىٰٓ","هُم بَـٰلِغُوهُ إِذَا",226],["7:185:18",174,"أَجَلُهُمْ ۖ","their term","يَكُونَ قَدِ ٱقْتَرَبَ","فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ",226],["10:11:10",209,"أَجَلُهُمْ ۖ","their term","بِٱلْخَيْرِ لَقُضِىَ إِلَيْهِمْ","فَنَذَرُ ٱلَّذِينَ لَا",226],["10:49:14",214,