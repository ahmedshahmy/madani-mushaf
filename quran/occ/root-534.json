[["15:12:2",262,"نَسْلُكُهُۥ","We let it enter","كَذَٰلِكَ","فِى قُلُوبِ ٱلْمُجْرِمِينَ",741],["16:69:6",274,"فَٱسْلُكِى","and follow","مِن كُلِّ ٱلثَّمَرَٰتِ","سُبُلَ رَبِّكِ ذُلُلًۭا ۚ",741],["20:53:6",315,"وَسَلَكَ","and inserted","لَكُمُ ٱلْأَرْضَ مَهْدًۭا","لَكُمْ فِيهَا سُبُلًۭا",741],["23:27:13",343,"فَٱسْلُكْ","then put","أَمْرُنَا وَفَارَ ٱلتَّنُّورُ ۙ","فِيهَا مِن كُلٍّۢ",741],["26:200:2",375,"سَلَكْنَـٰهُ","We have inserted it","كَذَٰلِكَ","فِى قُلُوبِ ٱلْمُجْرِمِينَ",741],["28:32:1",389,"ٱسْلُكْ","Insert","","يَدَكَ فِى جَيْبِكَ",741],["39:21:9",460,"فَسَلَكَهُۥ","and He makes it flow","مِنَ ٱلسَّمَآءِ مَآءًۭ","يَنَـٰبِيعَ فِى ٱلْأَرْضِ",741],["69:32:7",567,"فَٱسْلُكُوهُ","insert him","ذَرْعُهَا سَبْعُونَ ذِرَاعًۭا","",741],["71:20:1",571,"لِّتَسْلُكُوا۟","That you may go along","","مِنْهَا سُبُلًۭا فِجَاجًۭا",741],["72:17:8",573,"يَسْلُكْهُ","He will make him enter","عَن ذِكْرِ رَبِّهِۦ","عَذَابًۭا صَعَدًۭا",741],["72:27:7",573,"يَسْلُكُ","makes to march","مِن رَّسُولٍۢ فَإِنَّهُۥ","مِنۢ بَيْنِ يَدَيْهِ",741],["74:42:2",576,"سَلَكَكُمْ","led you","مَا","فِى سَقَرَ",741]]