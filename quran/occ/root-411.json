[["2:260:22",44,"فَصُرْهُنَّ","and incline them","أَرْبَعَةًۭ مِّنَ ٱلطَّيْرِ","إِلَيْكَ ثُمَّ ٱجْعَلْ",3269],["3:6:3",50,"يُصَوِّرُكُمْ","shapes you","هُوَ ٱلَّذِى","فِى ٱلْأَرْحَامِ كَيْفَ",1524],["6:73:18",136,"ٱلصُّورِ ۚ","the trumpet","يَوْمَ يُنفَخُ فِى","عَـٰلِمُ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ ۚ",827],["7:11:4",151,"صَوَّرْنَـٰكُمْ","We fashioned you","وَلَقَدْ خَلَقْنَـٰكُمْ ثُمَّ","ثُمَّ قُلْنَا لِلْمَلَـٰٓئِكَةِ",1524],["18:99:9",304,"ٱلصُّورِ","the trumpet","بَعْضٍۢ ۖ وَنُفِخَ فِى","فَجَمَعْنَـٰهُمْ جَمْعًۭا",827],["20:102:4",319,"ٱلصُّورِ ۚ","the Trumpet","يَوْمَ يُنفَخُ فِى","وَنَحْشُرُ ٱلْمُجْرِمِينَ يَوْمَئِذٍۢ",827],["23:101:4",348,"ٱلصُّورِ","the trumpet","فَإِذَا نُفِخَ فِى","فَلَآ أَنسَابَ بَيْنَهُمْ",827],["27:87:4",384,"ٱلصُّورِ","the trumpet","وَيَوْمَ يُنفَخُ فِى","فَفَزِعَ مَن فِى",827],["36:51:3",443,"ٱلصُّورِ","the trumpet","وَنُفِخَ فِى","فَإِذَا هُم مِّنَ",827],["39:68:3",466,"ٱلصُّورِ","the trumpet","وَنُفِخَ فِى","فَصَعِقَ مَن فِى",827],["40:64:9",474,"وَصَوَّرَكُمْ","and He formed you","قَرَارًۭا وَٱلسَّمَآءَ بِنَآءًۭ","فَأَحْسَنَ صُوَرَكُمْ وَرَزَقَكُم",1524],["40:64:11",474,"صُوَرَكُمْ","your forms","بِنَآءًۭ وَصَوَّرَكُمْ فَأَحْسَنَ","وَرَزَقَكُم مِّنَ ٱلطَّيِّبَـٰتِ ۚ",1795],["50:20:3",519,"ٱلصُّورِ ۚ","the trumpet","وَنُفِخَ فِى","ذَٰلِكَ يَوْمُ ٱلْوَعِيدِ",827],["59:24:5",548,"ٱلْمُصَوِّرُ ۖ","the Fashioner","ٱللَّهُ ٱلْخَـٰلِقُ ٱلْبَارِئُ","لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ ۚ",3773],["64:3:5",556,"وَصَوَّرَكُمْ","and He formed you","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ","فَأَحْسَنَ صُوَرَكُمْ ۖ وَإِلَيْهِ",1524],["64:3:7",556,"صُوَرَكُمْ ۖ","your forms","بِٱلْحَقِّ وَصَوَّرَكُمْ فَأَحْسَنَ","وَإِلَيْهِ ٱلْمَصِيرُ",1795],["69:13:4",567,"ٱلصُّورِ","the trumpet","فَإِذَا نُفِخَ فِى","نَفْخَةٌۭ وَٰحِدَةٌۭ",827],["78:18:4",582,"ٱلصُّورِ","the trumpet","يَوْمَ يُنفَخُ فِى","فَتَأْتُونَ أَفْوَاجًۭا",827],["82:8:3",587,"صُورَةٍۢ","form","فِىٓ أَىِّ","مَّا شَآءَ رَكَّبَكَ",1795]]