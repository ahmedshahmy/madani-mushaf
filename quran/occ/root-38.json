[["2:8:2",3,"ٱلنَّاسِ","the people","وَمِنَ","مَن يَقُولُ ءَامَنَّا",52],["2:13:7",3,"ٱلنَّاسُ","the people","ءَامِنُوا۟ كَمَآ ءَامَنَ","قَالُوٓا۟ أَنُؤْمِنُ كَمَآ",52],["2:21:2",4,"ٱلنَّاسُ","mankind","يَـٰٓأَيُّهَا","ٱعْبُدُوا۟ رَبَّكُمُ ٱلَّذِى",52],["2:24:10",4,"ٱلنَّاسُ","(is) [the] men","ٱلنَّارَ ٱلَّتِى وَقُودُهَا","وَٱلْحِجَارَةُ ۖ أُعِدَّتْ لِلْكَـٰفِرِينَ",52],["2:44:2",7,"ٱلنَّاسَ","[the] people","۞ أَتَأْمُرُونَ","بِٱلْبِرِّ وَتَنسَوْنَ أَنفُسَكُمْ",52],["2:83:17",12,"لِلنَّاسِ","to [the] people","وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ وَقُولُوا۟","حُسْنًۭا وَأَقِيمُوا۟ ٱلصَّلَوٰةَ",52],["2:94:12",15,"ٱلنَّاسِ","the mankind","خَالِصَةًۭ مِّن دُونِ","فَتَمَنَّوُا۟ ٱلْمَوْتَ إِن",52],["2:96:3",15,"ٱلنَّاسِ","(of) [the] mankind","وَلَتَجِدَنَّهُمْ أَحْرَصَ","عَلَىٰ حَيَوٰةٍۢ وَمِنَ",52],["2:102:15",16,"ٱلنَّاسَ","the people","ٱلشَّيَـٰطِينَ كَفَرُوا۟ يُعَلِّمُونَ","ٱلسِّحْرَ وَمَآ أُنزِلَ",52],["2:124:10",19,"لِلنَّاسِ","for the mankind","قَالَ إِنِّى جَاعِلُكَ","إِمَامًۭا ۖ قَالَ وَمِن",52],["2:125:5",19,"لِّلنَّاسِ","for mankind","جَعَلْنَا ٱلْبَيْتَ مَثَابَةًۭ","وَأَمْنًۭا وَٱتَّخِذُوا۟ مِن",52],["2:142:4",22,"ٱلنَّاسِ","the people","۞ سَيَقُولُ ٱلسُّفَهَآءُ مِنَ","مَا وَلَّىٰهُمْ عَن",52],["2:143:8",22,"ٱلنَّاسِ","the mankind","لِّتَكُونُوا۟ شُهَدَآءَ عَلَى","وَيَكُونَ ٱلرَّسُولُ عَلَيْكُمْ",52],["2:143:43",22,"بِٱلنَّاسِ","(is) to [the] mankind","إِيمَـٰنَكُمْ ۚ إِنَّ ٱللَّهَ","لَرَءُوفٌۭ رَّحِيمٌۭ",52],["2:150:17",23,"لِلنَّاسِ","for the people","شَطْرَهُۥ لِئَلَّا يَكُونَ","عَلَيْكُمْ حُجَّةٌ إِلَّا",52],["2:159:13",24,"لِلنَّاسِ","to the people","بَعْدِ مَا بَيَّنَّـٰهُ","فِى ٱلْكِتَـٰبِ ۙ أُو۟لَـٰٓئِكَ",52],["2:161:12",24,"وَٱلنَّاسِ","and the mankind","لَعْنَةُ ٱللَّهِ وَٱلْمَلَـٰٓئِكَةِ","أَجْمَعِينَ",52],["2:164:16",25,"ٱلنَّاسَ","[the] people","ٱلْبَحْرِ بِمَا يَنفَعُ","وَمَآ أَنزَلَ ٱللَّهُ",52],["2:165:2",25,"ٱلنَّاسِ","the mankind","وَمِنَ","مَن يَتَّخِذُ مِن",52],["2:168:2",25,"ٱلنَّاسُ","mankind","يَـٰٓأَيُّهَا","كُلُوا۟ مِمَّا فِى",52],["2:185:8",28,"لِّلنَّاسِ","for mankind","فِيهِ ٱلْقُرْءَانُ هُدًۭى","وَبَيِّنَـٰتٍۢ مِّنَ ٱلْهُدَىٰ",52],["2:187:63",29,"لِلنَّاسِ","for [the] people","يُبَيِّنُ ٱللَّهُ ءَايَـٰتِهِۦ","لَعَلَّهُمْ يَتَّقُونَ",52],["2:188:14",29,"ٱلنَّاسِ","(of) the people","فَرِيقًۭا مِّنْ أَمْوَٰلِ","بِٱلْإِثْمِ وَأَنتُمْ تَعْلَمُونَ",52],["2:189:7",29,"لِلنَّاسِ","for the people","قُلْ هِىَ مَوَٰقِيتُ","وَٱلْحَجِّ ۗ وَلَيْسَ ٱلْبِرُّ",52],["2:199:6",31,"ٱلنَّاسُ","the people","مِنْ حَيْثُ أَفَاضَ","وَٱسْتَغْفِرُوا۟ ٱللَّهَ ۚ إِنَّ",52],["2:200:12",31,"ٱلنَّاسِ","the people","أَشَدَّ ذِكْرًۭا ۗ فَمِنَ","مَن يَقُولُ رَبَّنَآ",52],["2:204:2",32,"ٱلنَّاسِ","the people","وَمِنَ","مَن يُعْجِبُكَ قَوْلُهُۥ",52],["2:207:2",32,"ٱلنَّاسِ","the people","وَمِنَ","مَن يَشْرِى نَفْسَهُ",52],["2:213:2",33,"ٱلنَّاسُ","mankind","كَانَ","أُمَّةًۭ وَٰحِدَةًۭ فَبَعَثَ",52],["2:213:16",33,"ٱلنَّاسِ","[the] people","بِٱلْحَقِّ لِيَحْكُمَ بَيْنَ","فِيمَا ٱخْتَلَفُوا۟ فِيهِ ۚ",52],["2:219:10",34,"لِلنَّاسِ","for [the] people","إِثْمٌۭ كَبِيرٌۭ وَمَنَـٰفِعُ","وَإِثْمُهُمَآ أَكْبَرُ مِن",52],["2:221:37",35,"لِلنَّاسِ","for the people","بِإِذْنِهِۦ ۖ وَيُبَيِّنُ ءَايَـٰتِهِۦ","لَعَلَّهُمْ يَتَذَكَّرُونَ",52],["2:224:11",35,"ٱلنَّاسِ ۗ","[the] people","وَتَتَّقُوا۟ وَتُصْلِحُوا۟ بَيْنَ","وَٱللَّهُ سَمِيعٌ عَلِيمٌۭ",52],["2:243:23",39,"ٱلنَّاسِ","[the] mankind","لَذُو فَضْلٍ عَلَى","وَلَـٰكِنَّ أَكْثَرَ ٱلنَّاسِ",52],["2:243:26",39,"ٱلنَّاسِ","(of) the people","ٱلنَّاسِ وَلَـٰكِنَّ أَكْثَرَ","لَا يَشْكُرُونَ",52],["2:251:17",41,"ٱلنَّاسَ","[the] people","وَلَوْلَا دَفْعُ ٱللَّهِ","بَعْضَهُم بِبَعْضٍۢ لَّفَسَدَتِ",52],["2:259:48",43,"لِّلنَّاسِ ۖ","for the people","حِمَارِكَ وَلِنَجْعَلَكَ ءَايَةًۭ","وَٱنظُرْ إِلَى ٱلْعِظَامِ",52],["2:264:13",44,"ٱلنَّاسِ","(by) the people","يُنفِقُ مَالَهُۥ رِئَآءَ","وَلَا يُؤْمِنُ بِٱللَّهِ",52],["2:273:21",46,"ٱلنَّاسَ","the people","بِسِيمَـٰهُمْ لَا يَسْـَٔلُونَ","إِلْحَافًۭا ۗ وَمَا تُنفِقُوا۟",52],["3:4:4",50,"لِّلنَّاسِ","for the mankind","مِن قَبْلُ هُدًۭى","وَأَنزَلَ ٱلْفُرْقَانَ ۗ إِنَّ",52],["3:9:4",50,"ٱلنَّاسِ","[the] mankind","رَبَّنَآ إِنَّكَ جَامِعُ","لِيَوْمٍۢ لَّا رَيْبَ",52],["3:14:2",51,"لِلنَّاسِ","for mankind","زُيِّنَ","حُبُّ ٱلشَّهَوَٰتِ مِنَ",52],["3:21:15",52,"ٱلنَّاسِ","the people","يَأْمُرُونَ بِٱلْقِسْطِ مِنَ","فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",52],["3:41:10",55,"ٱلنَّاسَ","(to) the people","ءَايَتُكَ أَلَّا تُكَلِّمَ","ثَلَـٰثَةَ أَيَّامٍ إِلَّا",52],["3:46:2",56,"ٱلنَّاسَ","(to) the people","وَيُكَلِّمُ","فِى ٱلْمَهْدِ وَكَهْلًۭا",52],["3:68:3",58,"ٱلنَّاسِ","(of) people","إِنَّ أَوْلَى","بِإِبْرَٰهِيمَ لَلَّذِينَ ٱتَّبَعُوهُ",52],["3:79:12",60,"لِلنَّاسِ","to the people","وَٱلنُّبُوَّةَ ثُمَّ يَقُولَ","كُونُوا۟ عِبَادًۭا لِّى",52],["3:87:8",61,"وَٱلنَّاسِ","and the people","لَعْنَةَ ٱللَّهِ وَٱلْمَلَـٰٓئِكَةِ","أَجْمَعِينَ",52],["3:96:5",62,"لِلنَّاسِ","for the mankind","أَوَّلَ بَيْتٍۢ وُضِعَ","لَلَّذِى بِبَكَّةَ مُبَارَكًۭا",52],["3:97:12",62,"ٱلنَّاسِ","the mankind","ءَامِنًۭا ۗ وَلِلَّهِ عَلَى","حِجُّ ٱلْبَيْتِ مَنِ",52],["3:110:5",64,"لِلنَّاسِ","for the mankind","خَيْرَ أُمَّةٍ أُخْرِجَتْ","تَأْمُرُونَ بِٱلْمَعْرُوفِ وَتَنْهَوْنَ",52],["3:112:13",64,"ٱلنَّاسِ","the people","ٱللَّهِ وَحَبْلٍۢ مِّنَ","وَبَآءُو بِغَضَبٍۢ مِّنَ",52],["3:134:10",67,"ٱلنَّاسِ ۗ","the people","ٱلْغَيْظَ وَٱلْعَافِينَ عَنِ","وَٱللَّهُ يُحِبُّ ٱلْمُحْسِنِينَ",52],["3:138:3",67,"لِّلنَّاسِ","for the people","هَـٰذَا بَيَانٌۭ","وَهُدًۭى وَمَوْعِظَةٌۭ لِّلْمُتَّقِينَ",52],["3:140:13",67,"ٱلنَّاسِ","the people","ٱلْأَيَّامُ نُدَاوِلُهَا بَيْنَ","وَلِيَعْلَمَ ٱللَّهُ ٱلَّذِينَ",52],["3:173:4",72,"ٱلنَّاسُ","[the people]","ٱلَّذِينَ قَالَ لَهُمُ","إِنَّ ٱلنَّاسَ قَدْ",52],["3:173:6",72,"ٱلنَّاسَ","the people","لَهُمُ ٱلنَّاسُ إِنَّ","قَدْ جَمَعُوا۟ لَكُمْ",52],["3:187:9",75,"لِلنَّاسِ","to the mankind","أُوتُوا۟ ٱلْكِتَـٰبَ لَتُبَيِّنُنَّهُۥ","وَلَا تَكْتُمُونَهُۥ فَنَبَذُوهُ",52],["4:1:2",77,"ٱلنَّاسُ","mankind","يَـٰٓأَيُّهَا","ٱتَّقُوا۟ رَبَّكُمُ ٱلَّذِى",52],["4:37:4",84,"ٱلنَّاسَ","the people","ٱلَّذِينَ يَبْخَلُونَ وَيَأْم