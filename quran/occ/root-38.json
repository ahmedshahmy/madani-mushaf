ُ يَعْصِمُكَ مِنَ","إِنَّ ٱللَّهَ لَا",52],["5:82:3",121,"ٱلنَّاسِ","(of) the people","۞ لَتَجِدَنَّ أَشَدَّ","عَدَٰوَةًۭ لِّلَّذِينَ ءَامَنُوا۟",52],["5:97:7",124,"لِّلنَّاسِ","for mankind","ٱلْبَيْتَ ٱلْحَرَامَ قِيَـٰمًۭا","وَٱلشَّهْرَ ٱلْحَرَامَ وَٱلْهَدْىَ",52],["5:110:17",126,"ٱلنَّاسَ","(to) the people","بِرُوحِ ٱلْقُدُسِ تُكَلِّمُ","فِى ٱلْمَهْدِ وَكَهْلًۭا ۖ",52],["5:116:9",127,"لِلنَّاسِ","to the people","مَرْيَمَ ءَأَنتَ قُلْتَ","ٱتَّخِذُونِى وَأُمِّىَ إِلَـٰهَيْنِ",52],["6:91:25",139,"لِّلنَّاسِ ۖ","for the people","مُوسَىٰ نُورًۭا وَهُدًۭى","تَجْعَلُونَهُۥ قَرَاطِيسَ تُبْدُونَهَا",52],["6:122:11",143,"ٱلنَّاسِ","the people","يَمْشِى بِهِۦ فِى","كَمَن مَّثَلُهُۥ فِى",52],["6:144:32",147,"ٱلنَّاسَ","the people","ٱللَّهِ كَذِبًۭا لِّيُضِلَّ","بِغَيْرِ عِلْمٍ ۗ إِنَّ",52],["7:85:24",161,"ٱلنَّاسَ","[the] people","وَٱلْمِيزَانَ وَلَا تَبْخَسُوا۟","أَشْيَآءَهُمْ وَلَا تُفْسِدُوا۟",52],["7:116:7",164,"ٱلنَّاسِ","(of) the people","أَلْقَوْا۟ سَحَرُوٓا۟ أَعْيُنَ","وَٱسْتَرْهَبُوهُمْ وَجَآءُو بِسِحْرٍ",52],["7:144:6",168,"ٱلنَّاسِ","the people","إِنِّى ٱصْطَفَيْتُكَ عَلَى","بِرِسَـٰلَـٰتِى وَبِكَلَـٰمِى فَخُذْ",52],["7:158:3",170,"ٱلنَّاسُ","mankind","قُلْ يَـٰٓأَيُّهَا","إِنِّى رَسُولُ ٱللَّهِ",52],["7:187:35",174,"ٱلنَّاسِ","(of) the people","ٱللَّهِ وَلَـٰكِنَّ أَكْثَرَ","لَا يَعْلَمُونَ",52],["8:26:11",180,"ٱلنَّاسُ","the men","تَخَافُونَ أَن يَتَخَطَّفَكُمُ","فَـَٔاوَىٰكُمْ وَأَيَّدَكُم بِنَصْرِهِۦ",52],["8:47:9",183,"ٱلنَّاسِ","(to) the people","دِيَـٰرِهِم بَطَرًۭا وَرِئَآءَ","وَيَصُدُّونَ عَن سَبِيلِ",52],["8:48:12",183,"ٱلنَّاسِ","the people","لَكُمُ ٱلْيَوْمَ مِنَ","وَإِنِّى جَارٌۭ لَّكُمْ ۖ",52],["9:3:6",187,"ٱلنَّاسِ","the people","ٱللَّهِ وَرَسُولِهِۦٓ إِلَى","يَوْمَ ٱلْحَجِّ ٱلْأَكْبَرِ",52],["9:34:11",192,"ٱلنَّاسِ","(of) the people","وَٱلرُّهْبَانِ لَيَأْكُلُونَ أَمْوَٰلَ","بِٱلْبَـٰطِلِ وَيَصُدُّونَ عَن",52],["10:2:2",208,"لِلنَّاسِ","for the mankind","أَكَانَ","عَجَبًا أَنْ أَوْحَيْنَآ",52],["10:2:11",208,"ٱلنَّاسَ","the mankind","مِّنْهُمْ أَنْ أَنذِرِ","وَبَشِّرِ ٱلَّذِينَ ءَامَنُوٓا۟",52],["10:11:4",209,"لِلنَّاسِ","for the mankind","۞ وَلَوْ يُعَجِّلُ ٱللَّهُ","ٱلشَّرَّ ٱسْتِعْجَالَهُم بِٱلْخَيْرِ",52],["10:19:3",210,"ٱلنَّاسُ","the mankind","وَمَا كَانَ","إِلَّآ أُمَّةًۭ وَٰحِدَةًۭ",52],["10:21:3",211,"ٱلنَّاسَ","We let [the] mankind taste","وَإِذَآ أَذَقْنَا","رَحْمَةًۭ مِّنۢ بَعْدِ",52],["10:23:11",211,"ٱلنَّاسُ","O mankind","بِغَيْرِ ٱلْحَقِّ ۗ يَـٰٓأَيُّهَا","إِنَّمَا بَغْيُكُمْ عَلَىٰٓ",52],["10:24:15",211,"ٱلنَّاسُ","the men","ٱلْأَرْضِ مِمَّا يَأْكُلُ","وَٱلْأَنْعَـٰمُ حَتَّىٰٓ إِذَآ",52],["10:44:5",214,"ٱلنَّاسَ","the people","ٱللَّهَ لَا يَظْلِمُ","شَيْـًۭٔا وَلَـٰكِنَّ ٱلنَّاسَ",52],["10:44:8",214,"ٱلنَّاسَ","the people","ٱلنَّاسَ شَيْـًۭٔا وَلَـٰكِنَّ","أَنفُسَهُمْ يَظْلِمُونَ",52],["10:57:2",215,"ٱلنَّاسُ","O mankind","يَـٰٓأَيُّهَا","قَدْ جَآءَتْكُم مَّوْعِظَةٌۭ",52],["10:60:15",215,"ٱلنَّاسِ","the mankind","لَذُو فَضْلٍ عَلَى","وَلَـٰكِنَّ أَكْثَرَهُمْ لَا",52],["10:92:11",219,"ٱلنَّاسِ","the mankind","وَإِنَّ كَثِيرًۭا مِّنَ","عَنْ ءَايَـٰتِنَا لَغَـٰفِلُونَ",52],["10:99:12",220,"ٱلنَّاسَ","the mankind","جَمِيعًا ۚ أَفَأَنتَ تُكْرِهُ","حَتَّىٰ يَكُونُوا۟ مُؤْمِنِينَ",52],["10:104:3",220,"ٱلنَّاسُ","O mankind","قُلْ يَـٰٓأَيُّهَا","إِن كُنتُمْ فِى",52],["10:108:3",221,"ٱلنَّاسُ","O mankind","قُلْ يَـٰٓأَيُّهَا","قَدْ جَآءَكُمُ ٱلْحَقُّ",52],["11:17:37",223,"ٱلنَّاسِ","(of) the people","رَّبِّكَ وَلَـٰكِنَّ أَكْثَرَ","لَا يُؤْمِنُونَ",52],["11:85:8",231,"ٱلنَّاسَ","the people","بِٱلْقِسْطِ ۖ وَلَا تَبْخَسُوا۟","أَشْيَآءَهُمْ وَلَا تَعْثَوْا۟",52],["11:103:13",233,"ٱلنَّاسُ","the mankind","يَوْمٌۭ مَّجْمُوعٌۭ لَّهُ","وَذَٰلِكَ يَوْمٌۭ مَّشْهُودٌۭ",52],["11:118:5",235,"ٱلنَّاسَ","the mankind","شَآءَ رَبُّكَ لَجَعَلَ","أُمَّةًۭ وَٰحِدَةًۭ ۖ وَلَا",52],["11:119:14",235,"وَٱلنَّاسِ","and the men","جَهَنَّمَ مِنَ ٱلْجِنَّةِ","أَجْمَعِينَ",52],["12:21:30",237,"ٱلنَّاسِ","(of) the people","أَمْرِهِۦ وَلَـٰكِنَّ أَكْثَرَ","لَا يَعْلَمُونَ",52],["12:38:21",240,"ٱلنَّاسِ","the mankind","ٱللَّهِ عَلَيْنَا وَعَلَى","وَلَـٰكِنَّ أَكْثَرَ ٱلنَّاسِ",52],["12:38:24",240,"ٱلنَّاسِ","(of) the men","ٱلنَّاسِ وَلَـٰكِنَّ أَكْثَرَ","لَا يَشْكُرُونَ",52],["12:40:30",240,"ٱلنَّاسِ","[the] men","ٱلْقَيِّمُ وَلَـٰكِنَّ أَكْثَرَ","لَا يَعْلَمُونَ",52],["12:46:20",241,"ٱلنَّاسِ","the people","لَّعَلِّىٓ أَرْجِعُ إِلَى","لَعَلَّهُمْ يَعْلَمُونَ",52],["12:49:9",241,"ٱلنَّاسُ","the people","عَامٌۭ فِيهِ يُغَاثُ","وَفِيهِ يَعْصِرُونَ",52],["12:68:28",243,"ٱلنَّاسِ","(of) the people","عَلَّمْنَـٰهُ وَلَـٰكِنَّ أَكْثَرَ","لَا يَعْلَمُونَ",52],["12:103:3",247,"ٱلنَّاسِ","(of) the mankind","وَمَآ أَكْثَرُ","وَلَوْ حَرَصْتَ بِمُؤْمِنِينَ",52],["13:1:13",249,"ٱلنَّاسِ","(of) the mankind","ٱلْحَقُّ وَلَـٰكِنَّ أَكْثَرَ","لَا يُؤْمِنُونَ",52],["13:6:14",250,"لِّلنَّاسِ","for mankind","رَبَّكَ لَذُو مَغْفِرَةٍۢ","عَلَىٰ ظُلْمِهِمْ ۖ وَإِنَّ",52],["13:17:35",251,"ٱلنَّاسَ","the mankind","وَأَمَّا مَا يَنفَعُ","فَيَمْكُثُ فِى ٱلْأَرْضِ ۚ",52],["13:31:28",253,"ٱلنَّاسَ","all","يَشَآءُ ٱللَّهُ لَهَدَى","جَمِيعًۭا ۗ وَلَا يَزَالُ",52],["14:1:6",255,"ٱلنَّاسَ","the mankind","أَنزَلْنَـٰهُ إِلَيْكَ لِتُخْرِجَ","مِنَ ٱلظُّلُمَـٰتِ إِلَى",52],["14:25:10",259,"لِلنَّاسِ","for mankind","وَيَضْرِبُ ٱللَّهُ ٱلْأَمْثَالَ","لَعَلَّهُمْ يَتَذَكَّرُونَ",52],["14:36:6",260,"ٱلنَّاسِ ۖ","the mankind","أَضْلَلْنَ كَثِيرًۭا مِّنَ","فَمَن تَبِعَنِى فَإِنَّهُۥ",52],["14:37:19",260,"ٱلنَّاسِ","the men","فَٱجْعَلْ أَفْـِٔدَةًۭ مِّنَ","تَهْوِىٓ إِلَيْهِمْ وَٱرْزُقْهُم",52],["14:44:2",261,"ٱلنَّاسَ","the mankind","وَأَنذِرِ","يَوْمَ يَأْتِيهِمُ ٱلْعَذَابُ",52],["14:52:3",261,"لِّلنَّاسِ","for the mankind","هَـٰذَا بَلَـٰغٌۭ","وَلِيُنذَرُوا۟ بِهِۦ وَلِيَعْلَمُوٓا۟",52],["16:38:16",271,"ٱلنَّاسِ","(of) the mankind","حَقًّۭا وَلَـٰكِنَّ أَكْثَرَ","لَا يَعْلَمُونَ",52],["16:44:7",272,"لِلنَّاسِ","to the mankind","إِلَيْكَ ٱلذِّكْرَ لِتُبَيِّنَ","مَا نُزِّلَ إِلَيْهِمْ",52],["16:61:4",273,"ٱلنَّاسَ","the mankind","وَلَوْ يُؤَاخِذُ ٱللَّهُ","بِظُلْمِهِم مَّا تَرَكَ",52],["16:69:18",274,"لِّلنَّاسِ ۗ","for the mankind","أَلْوَٰنُهُۥ فِيهِ شِفَآءٌۭ","إِنَّ فِى ذَٰلِكَ",52],["17:60:7",288,"بِٱلنَّاسِ ۚ","the mankind","إِنَّ رَبَّكَ أَحَاطَ","وَمَا جَعَلْنَا ٱلرُّءْيَا",52],["17:60:15",288,"لِّلنَّاسِ","for mankind","أَرَيْنَـٰكَ إِلَّا فِتْنَةًۭ","وَٱلشَّجَرَةَ ٱلْمَلْعُونَةَ فِى",52],["17:89:3",291,"لِلنَّاسِ","to mankind","وَلَقَدْ صَرَّفْنَا","فِى هَـٰذَا ٱلْقُرْءَانِ",52],["17:89:12",291,"ٱلنَّاسِ","(of) the mankind","مَثَلٍۢ فَأَبَىٰٓ أَكْثَرُ","إِلَّا كُفُورًۭا",52],["17:94:3",291,"ٱلنَّاسَ","the people","وَمَا مَنَعَ","أَن يُؤْمِنُوٓا۟ إِذْ",52],["17:106:5",293,"ٱلنَّاسِ","the people","فَرَقْنَـٰهُ لِتَقْرَأَهُۥ عَلَى","عَلَىٰ مُكْثٍۢ وَنَزَّلْنَـٰهُ",52],["18:54:6",300,"لِلنَّاسِ","for mankind","فِى هَـٰذَا ٱلْقُرْءَانِ","مِن كُلِّ مَثَلٍۢ ۚ",52],["18:55:3",300,"ٱلنَّاسَ","men","وَمَا مَنَعَ","أَن يُؤْمِنُوٓا۟ إِذْ",52],["19:10:10",305,"ٱلنَّاسَ","(to) the people","ءَايَتُكَ أَلَّا تُكَلِّمَ","ثَلَـٰثَ لَيَالٍۢ سَوِيًّۭا",52],["19:21:10",306,"لِّلنَّاسِ","for the mankind","هَيِّنٌۭ ۖ وَلِنَجْعَلَهُۥٓ ءَايَةًۭ","وَرَحْمَةًۭ مِّنَّا ۚ وَكَانَ",52],["20:59:7",315,"ٱلنَّاسُ","the people","ٱلزِّينَةِ وَأَن يُحْشَرَ","ضُحًۭى",52],["21:1:2",322,"لِلنَّاسِ","for [the] mankind","ٱقْتَرَبَ","حِسَابُهُمْ وَهُمْ فِى",52],["21:61:6",327,"ٱلنَّاسِ","(of) the people","بِهِۦ عَلَىٰٓ أَعْيُنِ","لَعَلَّهُمْ يَشْهَدُونَ",52],["22:1:2",332,"ٱلنَّاسُ","O mankind","يَـٰٓأَيُّهَا","ٱتَّقُوا۟ رَبَّكُمْ ۚ إِنَّ",52],["22:2:14",332,"ٱلنَّاسَ","[the] mankind","حَمْلٍ حَمْلَهَا وَتَرَى","سُكَـٰرَىٰ وَمَا هُم",52],["22:3:2",332,"ٱلنَّاسِ","the mankind","وَمِنَ","مَن يُجَـٰدِلُ فِى",52],["22:5:2",332,"ٱلنَّاسُ","O mankind","يَـٰٓأَيُّهَا","إِن كُنتُمْ فِى",52],["22:8:2",333,"ٱلنَّاسِ","mankind","وَمِنَ","مَن يُجَـٰدِلُ فِى",52],["22:11:2",333,"ٱلنَّاسِ","the mankind","وَمِنَ","مَن يَعْبُدُ ٱللَّهَ",52],["22:18:21",334,"ٱلنَّاسِ ۖ","the people","وَٱلدَّوَآبُّ وَكَثِيرٌۭ مِّنَ","وَكَثِيرٌ حَقَّ عَلَيْهِ",52],["22:25:12",335,"لِلنَّاسِ","for the mankind","ٱلْحَرَامِ ٱلَّذِى جَعَلْنَـٰهُ","سَوَآء