[["2:235:11",38,"أَكْنَنتُمْ","you conceal it","خِطْبَةِ ٱلنِّسَآءِ أَوْ","فِىٓ أَنفُسِكُمْ ۚ عَلِمَ",1735],["6:25:8",130,"أَكِنَّةً","coverings","وَجَعَلْنَا عَلَىٰ قُلُوبِهِمْ","أَن يَفْقَهُوهُ وَفِىٓ",1467],["16:81:11",276,"أَكْنَـٰنًۭا","shelters","لَكُم مِّنَ ٱلْجِبَالِ","وَجَعَلَ لَكُمْ سَرَٰبِيلَ",3001],["17:46:4",286,"أَكِنَّةً","coverings","وَجَعَلْنَا عَلَىٰ قُلُوبِهِمْ","أَن يَفْقَهُوهُ وَفِىٓ",1467],["18:57:17",300,"أَكِنَّةً","coverings","جَعَلْنَا عَلَىٰ قُلُوبِهِمْ","أَن يَفْقَهُوهُ وَفِىٓ",1467],["27:74:5",383,"تُكِنُّ","conceals","رَبَّكَ لَيَعْلَمُ مَا","صُدُورُهُمْ وَمَا يُعْلِنُونَ",1735],["28:69:4",393,"تُكِنُّ","conceals","وَرَبُّكَ يَعْلَمُ مَا","صُدُورُهُمْ وَمَا يُعْلِنُونَ",1735],["37:49:3",447,"مَّكْنُونٌۭ","well protected","كَأَنَّهُنَّ بَيْضٌۭ","",1600],["41:5:4",477,"أَكِنَّةٍۢ","coverings","وَقَالُوا۟ قُلُوبُنَا فِىٓ","مِّمَّا تَدْعُونَآ إِلَيْهِ",1467],["52:24:7",524,"مَّكْنُونٌۭ","well-protected","لَّهُمْ كَأَنَّهُمْ لُؤْلُؤٌۭ","",1600],["56:23:3",535,"ٱلْمَكْنُونِ","well-protected","كَأَمْثَـٰلِ ٱللُّؤْلُؤِ","",1600],["56:78:3",537,"مَّكْنُونٍۢ","well-guarded","فِى كِتَـٰبٍۢ","",1600]]