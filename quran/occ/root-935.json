[["12:13:10",236,"ٱلذِّئْبُ","a wolf","وَأَخَافُ أَن يَأْكُلَهُ","وَأَنتُمْ عَنْهُ غَـٰفِلُونَ",1712],["12:14:4",236,"ٱلذِّئْبُ","the wolf","قَالُوا۟ لَئِنْ أَكَلَهُ","وَنَحْنُ عُصْبَةٌ إِنَّآ",1712],["12:17:11",237,"ٱلذِّئْبُ ۖ","the wolf","عِندَ مَتَـٰعِنَا فَأَكَلَهُ","وَمَآ أَنتَ بِمُؤْمِنٍۢ",1712]]