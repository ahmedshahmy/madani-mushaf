[["3:40:6",55,"غُلَـٰمٌۭ","a son","أَنَّىٰ يَكُونُ لِى","وَقَدْ بَلَغَنِىَ ٱلْكِبَرُ",687],["12:19:10",237,"غُلَـٰمٌۭ ۚ","(is) a boy","قَالَ يَـٰبُشْرَىٰ هَـٰذَا","وَأَسَرُّوهُ بِضَـٰعَةًۭ ۚ وَٱللَّهُ",687],["15:53:6",265,"بِغُلَـٰمٍ","of a boy","تَوْجَلْ إِنَّا نُبَشِّرُكَ","عَلِيمٍۢ",687],["18:74:5",301,"غُلَـٰمًۭا","a boy","حَتَّىٰٓ إِذَا لَقِيَا","فَقَتَلَهُۥ قَالَ أَقَتَلْتَ",687],["18:80:2",302,"ٱلْغُلَـٰمُ","the boy","وَأَمَّا","فَكَانَ أَبَوَاهُ مُؤْمِنَيْنِ",687],["18:82:4",302,"لِغُلَـٰمَيْنِ","for two orphan boys","وَأَمَّا ٱلْجِدَارُ فَكَانَ","يَتِيمَيْنِ فِى ٱلْمَدِينَةِ",687],["19:7:4",305,"بِغُلَـٰمٍ","of a boy","يَـٰزَكَرِيَّآ إِنَّا نُبَشِّرُكَ","ٱسْمُهُۥ يَحْيَىٰ لَمْ",687],["19:8:6",305,"غُلَـٰمٌۭ","a boy","أَنَّىٰ يَكُونُ لِى","وَكَانَتِ ٱمْرَأَتِى عَاقِرًۭا",687],["19:19:8",306,"غُلَـٰمًۭا","a son","رَبِّكِ لِأَهَبَ لَكِ","زَكِيًّۭا",687],["19:20:5",306,"غُلَـٰمٌۭ","a son","أَنَّىٰ يَكُونُ لِى","وَلَمْ يَمْسَسْنِى بَشَرٌۭ",687],["37:101:2",449,"بِغُلَـٰمٍ","of a boy","فَبَشَّرْنَـٰهُ","حَلِيمٍۢ",687],["51:28:8",521,"بِغُلَـٰمٍ","of a son","لَا تَخَفْ ۖ وَبَشَّرُوهُ","عَلِيمٍۢ",687],["52:24:3",524,"غِلْمَانٌۭ","boys","۞ وَيَطُوفُ عَلَيْهِمْ","لَّهُمْ كَأَنَّهُمْ لُؤْلُؤٌۭ",687]]