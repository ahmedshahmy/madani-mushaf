[["2:48:14",7,"يُؤْخَذُ","will be taken","مِنْهَا شَفَـٰعَةٌۭ وَلَا","مِنْهَا عَدْلٌۭ وَلَا",92],["2:51:7",8,"ٱتَّخَذْتُمُ","you took","أَرْبَعِينَ لَيْلَةًۭ ثُمَّ","ٱلْعِجْلَ مِنۢ بَعْدِهِۦ",95],["2:54:9",8,"بِٱتِّخَاذِكُمُ","by your taking","إِنَّكُمْ ظَلَمْتُمْ أَنفُسَكُم","ٱلْعِجْلَ فَتُوبُوٓا۟ إِلَىٰ",4844],["2:55:11",8,"فَأَخَذَتْكُمُ","So seized you","نَرَى ٱللَّهَ جَهْرَةًۭ","ٱلصَّـٰعِقَةُ وَأَنتُمْ تَنظُرُونَ",92],["2:63:2",10,"أَخَذْنَا","We took","وَإِذْ","مِيثَـٰقَكُمْ وَرَفَعْنَا فَوْقَكُمُ",92],["2:63:7",10,"خُذُوا۟","Hold","وَرَفَعْنَا فَوْقَكُمُ ٱلطُّورَ","مَآ ءَاتَيْنَـٰكُم بِقُوَّةٍۢ",92],["2:67:12",10,"أَتَتَّخِذُنَا","Do you take us","تَذْبَحُوا۟ بَقَرَةًۭ ۖ قَالُوٓا۟","هُزُوًۭا ۖ قَالَ أَعُوذُ",95],["2:80:9",12,"أَتَّخَذْتُمْ","Have you taken","أَيَّامًۭا مَّعْدُودَةًۭ ۚ قُلْ","عِندَ ٱللَّهِ عَهْدًۭا",95],["2:83:2",12,"أَخَذْنَا","We took","وَإِذْ","مِيثَـٰقَ بَنِىٓ إِسْرَٰٓءِيلَ",92],["2:84:2",13,"أَخَذْنَا","We took","وَإِذْ","مِيثَـٰقَكُمْ لَا تَسْفِكُونَ",92],["2:92:6",14,"ٱتَّخَذْتُمُ","you took","مُّوسَىٰ بِٱلْبَيِّنَـٰتِ ثُمَّ","ٱلْعِجْلَ مِنۢ بَعْدِهِۦ",95],["2:93:2",14,"أَخَذْنَا","We took","وَإِذْ","مِيثَـٰقَكُمْ وَرَفَعْنَا فَوْقَكُمُ",92],["2:93:7",14,"خُذُوا۟","Hold","وَرَفَعْنَا فَوْقَكُمُ ٱلطُّورَ","مَآ ءَاتَيْنَـٰكُم بِقُوَّةٍۢ",92],["2:116:2",18,"ٱتَّخَذَ","has taken","وَقَالُوا۟","ٱللَّهُ وَلَدًۭا ۗ سُبْحَـٰنَهُۥ ۖ",95],["2:125:7",19,"وَٱتَّخِذُوا۟","and (said), \"Take","مَثَابَةًۭ لِّلنَّاسِ وَأَمْنًۭا","مِن مَّقَامِ إِبْرَٰهِـۧمَ",95],["2:165:4",25,"يَتَّخِذُ","takes","وَمِنَ ٱلنَّاسِ مَن","مِن دُونِ ٱللَّهِ",95],["2:206:6",32,"أَخَذَتْهُ","takes him","لَهُ ٱتَّقِ ٱللَّهَ","ٱلْعِزَّةُ بِٱلْإِثْمِ ۚ فَحَسْبُهُۥ",92],["2:225:2",36,"يُؤَاخِذُكُمُ","will take you to task","لَّا","ٱللَّهُ بِٱللَّغْوِ فِىٓ",940],["2:225:8",36,"يُؤَاخِذُكُم","He takes you to task","فِىٓ أَيْمَـٰنِكُمْ وَلَـٰكِن","بِمَا كَسَبَتْ قُلُوبُكُمْ ۗ",940],["2:229:12",36,"تَأْخُذُوا۟","you take (back)","يَحِلُّ لَكُمْ أَن","مِمَّآ ءَاتَيْتُمُوهُنَّ شَيْـًٔا",92],["2:231:22",37,"تَتَّخِذُوٓا۟","take","ظَلَمَ نَفْسَهُۥ ۚ وَلَا","ءَايَـٰتِ ٱللَّهِ هُزُوًۭا ۚ",95],["2:255:9",42,"تَأْخُذُهُۥ","overtakes Him","ٱلْحَىُّ ٱلْقَيُّومُ ۚ لَا","سِنَةٌۭ وَلَا نَوْمٌۭ ۚ",92],["2:260:18",44,"فَخُذْ","Then take","لِّيَطْمَئِنَّ قَلْبِى ۖ قَالَ","أَرْبَعَةًۭ مِّنَ ٱلطَّيْرِ",92],["2:267:20",45,"بِـَٔاخِذِيهِ","take it","مِنْهُ تُنفِقُونَ وَلَسْتُم","إِلَّآ أَن تُغْمِضُوا۟",1755],["2:286:15",49,"تُؤَاخِذْنَآ","take us to task","ٱكْتَسَبَتْ ۗ رَبَّنَا لَا","إِن نَّسِينَآ أَوْ",940],["3:11:9",51,"فَأَخَذَهُمُ","so seized them","قَبْلِهِمْ ۚ كَذَّبُوا۟ بِـَٔايَـٰتِنَا","ٱللَّهُ بِذُنُوبِهِمْ ۗ وَٱللَّهُ",92],["3:28:2",53,"يَتَّخِذِ","take","لَّا","ٱلْمُؤْمِنُونَ ٱلْكَـٰفِرِينَ أَوْلِيَآءَ",95],["3:64:19",58,"يَتَّخِذَ","take","بِهِۦ شَيْـًۭٔا وَلَا","بَعْضُنَا بَعْضًا أَرْبَابًۭا",95],["3:80:4",60,"تَتَّخِذُوا۟","you take","وَلَا يَأْمُرَكُمْ أَن","ٱلْمَلَـٰٓئِكَةَ وَٱلنَّبِيِّـۧنَ أَرْبَابًا ۗ",95],["3:81:2",60,"أَخَذَ","took","وَإِذْ","ٱللَّهُ مِيثَـٰقَ ٱلنَّبِيِّـۧنَ",92],["3:81:22",60,"وَأَخَذْتُمْ","and take","وَلَتَنصُرُنَّهُۥ ۚ قَالَ ءَأَقْرَرْتُمْ","عَلَىٰ ذَٰلِكُمْ إِصْرِى ۖ",92],["3:118:5",65,"تَتَّخِذُوا۟","take","ٱلَّذِينَ ءَامَنُوا۟ لَا","بِطَانَةًۭ مِّن دُونِكُمْ",95],["3:140:18",67,"وَيَتَّخِذَ","and take","ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟","مِنكُمْ شُهَدَآءَ ۗ وَٱللَّهُ",95],["3:187:2",75,"أَخَذَ","took","وَإِذْ","ٱللَّهُ مِيثَـٰقَ ٱلَّذِينَ",92],["4:20:11",81,"تَأْخُذُوا۟","take away","إِحْدَىٰهُنَّ قِنطَارًۭا فَلَا","مِنْهُ شَيْـًٔا ۚ أَتَأْخُذُونَهُۥ",92],["4:20:14",81,"أَتَأْخُذُونَهُۥ","Would you take it","تَأْخُذُوا۟ مِنْهُ شَيْـًٔا ۚ","بُهْتَـٰنًۭا وَإِثْمًۭا مُّبِينًۭا",92],["4:21:2",81,"تَأْخُذُونَهُۥ","could you take it","وَكَيْفَ","وَقَدْ أَفْضَىٰ بَعْضُكُمْ",92],["4:21:8",81,"وَأَخَذْنَ","and they have taken","بَعْضُكُمْ إِلَىٰ بَعْضٍۢ","مِنكُم مِّيثَـٰقًا غَلِيظًۭا",92],["4:25:33",82,"مُتَّخِذَٰتِ","those who take","غَيْرَ مُسَـٰفِحَـٰتٍۢ وَلَا","أَخْدَانٍۢ ۚ فَإِذَآ أُحْصِنَّ",1917],["4:71:4",89,"خُذُوا۟","Take","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","حِذْرَكُمْ فَٱنفِرُوا۟ ثُبَاتٍ",92],["4:89:9",92,"تَتَّخِذُوا۟","take","فَتَكُونُونَ سَوَآءًۭ ۖ فَلَا","مِنْهُمْ أَوْلِيَآءَ حَتَّىٰ",95],["4:89:19",92,"فَخُذُوهُمْ","seize them","ٱللَّهِ ۚ فَإِن تَوَلَّوْا۟","وَٱقْتُلُوهُمْ حَيْثُ وَجَدتُّمُوهُمْ ۖ",92],["4:89:24",92,"تَتَّخِذُوا۟","take","حَيْثُ وَجَدتُّمُوهُمْ ۖ وَلَا","مِنْهُمْ وَلِيًّۭا وَلَا",95],["4:91:23",92,"فَخُذُوهُمْ","then seize them","ٱلسَّلَمَ وَيَكُفُّوٓا۟ أَيْدِيَهُمْ","وَٱقْتُلُوهُمْ حَيْثُ ثَقِفْتُمُوهُمْ ۚ",92],["4:102:11",95,"وَلْيَأْخُذُوٓا۟","and let them take","طَآئِفَةٌۭ مِّنْهُم مَّعَكَ","أَسْلِحَتَهُمْ فَإِذَا سَجَدُوا۟",92],["4:102:25",95,"وَلْيَأْخُذُوا۟","and let them take","يُصَلُّوا۟ فَلْيُصَلُّوا۟ مَعَكَ","حِذْرَهُمْ وَأَسْلِحَتَهُمْ ۗ وَدَّ",92],["4:102:55",95,"وَخُذُوا۟","but take","أَن تَضَعُوٓا۟ أَسْلِحَتَكُمْ ۖ","حِذْرَكُمْ ۗ إِنَّ ٱللَّهَ",92],["4:118:4",97,"لَأَتَّخِذَنَّ","I will surely take","لَّعَنَهُ ٱللَّهُ ۘ وَقَالَ","مِنْ عِبَادِكَ نَصِيبًۭا",95],["4:119:12",97,"يَتَّخِذِ","takes","خَلْقَ ٱللَّهِ ۚ وَمَن","ٱلشَّيْطَـٰنَ وَلِيًّۭا مِّن",95],["4:125:14",98,"وَٱتَّخَذَ","And was taken","مِلَّةَ إِبْرَٰهِيمَ حَنِيفًۭا ۗ","ٱللَّهُ إِبْرَٰهِيمَ خَلِيلًۭا",95],["4:139:2",100,"يَتَّخِذُونَ","take","ٱلَّذِينَ","ٱلْكَـٰفِرِينَ أَوْلِيَآءَ مِن",95],["4:144:5",101,"تَتَّخِذُوا۟","take","ٱلَّذِينَ ءَامَنُوا۟ لَا","ٱلْكَـٰفِرِينَ أَوْلِيَآءَ مِن",95],["4:150:19",102,"يَتَّخِذُوا۟","they take","بِبَعْضٍۢ وَيُرِيدُونَ أَن","بَيْنَ ذَٰلِكَ سَبِيلًا",95],["4:153:20",102,"فَأَخَذَتْهُمُ","so struck them","أَرِنَا ٱللَّهَ جَهْرَةًۭ","ٱلصَّـٰعِقَةُ بِظُلْمِهِمْ ۚ ثُمَّ",92],["4:153:24",102,"ٱتَّخَذُوا۟","they took","ٱلصَّـٰعِقَةُ بِظُلْمِهِمْ ۚ ثُمَّ","ٱلْعِجْلَ مِنۢ بَعْدِ",95],["4:154:16",102,"وَأَخَذْنَا","And We took","تَعْدُوا۟ فِى ٱلسَّبْتِ","مِنْهُم مِّيثَـٰقًا غَلِيظًۭا",92],["4:161:1",103,"وَأَخْذِهِمُ","And for their taking","","ٱلرِّبَوٰا۟ وَقَدْ نُهُوا۟",1143],["5:5:31",107,"مُتَّخِذِىٓ","ones (who are) taking","غَيْرَ مُسَـٰفِحِينَ وَلَا","أَخْدَانٍۢ ۗ وَمَن يَكْفُرْ",1917],["5:12:2",109,"أَخَذَ","took","۞ وَلَقَدْ","ٱللَّهُ مِيثَـٰقَ بَنِىٓ",92],["5:14:6",110,"أَخَذْنَا","We took","قَالُوٓا۟ إِنَّا نَصَـٰرَىٰٓ","مِيثَـٰقَهُمْ فَنَسُوا۟ حَظًّۭا",92],["5:41:36",114,"فَخُذُوهُ","[so] take it","إِنْ أُوتِيتُمْ هَـٰذَا","وَإِن لَّمْ تُؤْتَوْهُ",92],["5:51:5",117,"تَتَّخِذُوا۟","take","ٱلَّذِينَ ءَامَنُوا۟ لَا","ٱلْيَهُودَ وَٱلنَّصَـٰرَىٰٓ أَوْلِيَآءَ ۘ",95],["5:57:5",117,"تَتَّخِذُوا۟","take","ٱلَّذِينَ ءَامَنُوا۟ لَا","ٱلَّذِينَ ٱتَّخَذُوا۟ دِينَكُمْ",95],["5:57:7",117,"ٱتَّخَذُوا۟","take","لَا تَتَّخِذُوا۟ ٱلَّذِينَ","دِينَكُمْ هُزُوًۭا وَلَعِبًۭا",95],["5:58:5",118,"ٱتَّخَذُوهَا","they take it","نَادَيْتُمْ إِلَى ٱلصَّلَوٰةِ","هُزُوًۭا وَلَعِبًۭا ۚ ذَٰلِكَ",95],["5:70:2",119,"أَخَذْنَا","We took","لَقَدْ","مِيثَـٰقَ بَنِىٓ إِسْرَٰٓءِيلَ",92],["5:81:10",121,"ٱتَّخَذُوهُمْ","they (would have) taken them","أُنزِلَ إِلَيْهِ مَا","أَوْلِيَآءَ وَلَـٰكِنَّ كَثِيرًۭا",95],["5:89:2",122,"يُؤَاخِذُكُمُ","will call you to account","لَا","ٱللَّهُ بِٱللَّغْوِ فِىٓ",940],["5:89:8",122,"يُؤَاخِذُكُم","He will call you to account","فِىٓ أَيْمَـٰنِكُمْ وَلَـٰكِن","بِمَا عَقَّدتُّمُ ٱلْأَيْمَـٰنَ ۖ",940],["5:116:10",127,"ٱتَّخِذُونِى","Take me","ءَأَنتَ قُلْتَ لِلنَّاسِ","وَأُمِّىَ إِلَـٰهَيْنِ مِن",95],["6:14:4",129,"أَتَّخِذُ","I (should) take","قُلْ أَغَيْرَ ٱللَّهِ","وَلِيًّۭا فَاطِرِ ٱلسَّمَـٰوَٰتِ",95],["6:42:7",132,"فَأَخَذْنَـٰهُم","then We seized them","أُمَمٍۢ مِّن قَبْلِكَ","بِٱلْبَأْسَآءِ وَٱلضَّرَّآءِ لَعَلَّهُمْ",92],["6:44:16",132,"أَخَذْنَـٰهُم","We seized them","فَرِحُوا۟ بِمَآ أُوتُوٓا۟","بَغْتَةًۭ فَإِذَا هُم",92],["6:46:4",133,"أَخَذَ","took away","قُلْ أَرَءَيْتُمْ إِنْ","ٱللَّهُ سَمْعَكُمْ وَأَبْصَـٰرَكُمْ",92],["6:70:3",136,"ٱتَّخَذُوا۟","take","وَذَرِ ٱلَّذِينَ","دِينَهُمْ لَعِبًۭا وَلَهْوًۭا",95],["6:70:30",136,"يُؤْخَذْ","will it be taken","كُلَّ عَدْلٍۢ لَّا","مِنْهَآ ۗ أُو۟لَـٰٓئِكَ ٱلَّذِينَ",92],["6:74:6",137,"أَتَتَّخِذُ","Do you take","إِبْرَٰهِيمُ لِأَبِيهِ ءَازَرَ","أَصْنَامًا ءَالِهَةً ۖ إِنِّىٓ",95],["7:30:8",153,"ٱتَّخَذُوا۟","take","عَلَيْهِمُ ٱلضَّلَـٰلَةُ ۗ إِنَّهُمُ","ٱلشَّيَـٰطِينَ أَوْلِيَآءَ مِن",95],["7:31:3",154,"خُذُوا۟","Take","۞ يَـٰبَنِىٓ ءَادَمَ","زِينَتَكُمْ عِندَ كُلِّ",92],["7:51:2",156,"ٱتَّخَذُوا۟","took","ٱلَّذِينَ","دِينَهُمْ لَهْوًۭا وَلَعِبًۭا",95],["7:73:32",159,"فَيَأْخُذَكُمْ","lest seizes you","وَلَا تَمَسُّوهَا بِسُوٓءٍۢ","عَذَابٌ أَلِيمٌۭ",92],["7:74:11",160,"تَتَّخِذُونَ","You take","وَبَوَّأَكُمْ فِى ٱلْأَرْضِ","مِن سُهُولِهَا قُصُورًۭا",95],["7:78:1",160,"فَأَخَذَتْهُمُ","So seized them","","ٱلرَّجْفَةُ فَأَصْبَحُوا۟ فِى",92],["7:91:1",162,"فَأَخَذَتْهُمُ","Then seized them","","ٱلرَّجْفَةُ فَأَصْبَحُوا۟ فِى",92],["7:94:8",162,"أَخَذْنَآ","We seized","مِّن نَّبِىٍّ إِلَّآ","أَهْلَهَا بِٱلْبَأْسَآءِ وَٱلضَّرَّآءِ",92],["7:95:14",162,"فَأَخَذْنَـٰهُم","So We seized them","ءَابَآءَنَا ٱلضَّرَّآءُ وَٱلسَّرَّآءُ","بَغْتَةًۭ وَهُمْ لَا",92],["7:96:15",163,"فَأَخَذْنَـٰهُم","So We seized them","وَٱلْأَرْضِ وَلَـٰكِن كَذَّبُوا۟","بِمَا كَانُوا۟ يَكْسِبُونَ",92],["7:130:2",165,"أَخَذْنَآ","We seized","وَلَقَدْ","ءَالَ فِرْعَوْنَ بِٱلسِّنِينَ",92],["7:144:9",168,"فَخُذْ","So take","ٱلنَّاسِ بِرِسَـٰلَـٰتِى وَبِكَلَـٰمِى","مَآ ءَاتَيْتُكَ وَكُن",92],["7:145:12",168,"فَخُذْهَا","So take them","وَتَفْصِيلًۭا لِّكُلِّ شَىْءٍۢ","بِقُوَّةٍۢ وَأْمُرْ قَوْمَكَ",92],["7:145:16",168,"يَأْخُذُوا۟","(to) take","بِقُوَّةٍۢ وَأْمُرْ قَوْمَكَ","بِأَحْسَنِهَا ۚ سَأُو۟رِيكُمْ دَارَ",92],["7:146:22",168,"يَتَّخِذُوهُ","(will) they take it","سَبِيلَ ٱلرُّشْدِ لَا","سَبِيلًۭا وَإِن يَرَوْا۟",95],["7:146:28",168,"يَتَّخِذُوهُ","they will take it","يَرَوْا۟ سَبِيلَ ٱلْغَىِّ","سَبِيلًۭا ۚ ذَٰلِكَ بِأَنَّهُمْ",95],["7:148:1",168,"وَٱتَّخَذَ","And took","","قَوْمُ مُوسَىٰ مِنۢ",95],["7:148:20",168,"ٱتَّخَذُوهُ","They took it (for worship)","وَلَا يَهْدِيهِمْ سَبِيلًا ۘ","وَكَانُوا۟ ظَـٰلِمِينَ",95],["7:150:18",169,"وَأَخَذَ","and seized","رَبِّكُمْ ۖ وَأَلْقَى ٱلْأَلْوَاحَ","بِرَأْسِ أَخِيهِ يَجُرُّهُۥٓ",92],["7:152:3",169,"ٱتَّخَذُوا۟","took","إِنَّ ٱلَّذِينَ","ٱلْعِجْلَ سَيَنَالُهُمْ غَضَبٌۭ",95],["7:154:6",169,"أَخَذَ","he took (up)","عَن مُّوسَى ٱلْغَضَبُ","ٱلْأَلْوَاحَ ۖ وَفِى نُسْخَتِهَا",92],["7:155:8",169,"أَخَذَتْهُمُ","seized them","رَجُلًۭا لِّمِيقَـٰتِنَا ۖ فَلَمَّآ","ٱلرَّجْفَةُ قَالَ رَبِّ",92],["7:165:11",172,"وَأَخَذْنَا","and We seized","يَنْهَوْنَ عَنِ ٱلسُّوٓءِ","ٱلَّذِينَ ظَلَمُوا۟ بِعَذَابٍۭ",92],["7:169:7",172,"يَأْخُذُونَ","taking","خَلْفٌۭ وَرِثُوا۟ ٱلْكِتَـٰبَ","عَرَضَ هَـٰذَا ٱلْأَدْنَىٰ",92],["7:169:18",172,"يَأْخُذُوهُ ۚ","they will take it","يَأْتِهِمْ عَرَضٌۭ مِّثْلُهُۥ","أَلَمْ يُؤْخَذْ عَلَيْهِم",92],["7:169:20",172,"يُؤْخَذْ","taken","مِّثْلُهُۥ يَأْخُذُوهُ ۚ أَلَمْ","عَلَيْهِم مِّيثَـٰقُ ٱلْكِتَـٰبِ",92],["7:171:11",173,"خُذُوا۟","(We said), \"Take","أَنَّهُۥ وَاقِعٌۢ بِهِمْ","مَآ ءَاتَيْنَـٰكُم بِقُوَّةٍۢ",92],["7:172:2",173,"أَخَذَ","(was) taken","وَإِذْ","رَبُّكَ مِنۢ بَنِىٓ",92],["7:199:1",176,"خُذِ","Hold","","ٱلْعَفْوَ وَأْمُرْ بِٱلْعُرْفِ",92],["8:52:10",183,"فَأَخَذَهُمُ","so seized them","كَفَرُوا۟ بِـَٔايَـٰتِ ٱللَّهِ","ٱللَّهُ بِذُنُوبِهِمْ ۗ إِنَّ",92],["8:68:8",185,"أَخَذْتُمْ","you took","سَبَقَ لَمَسَّكُمْ فِيمَآ","عَذَابٌ عَظِيمٌۭ",92],["8:70:18",186,"أُخِذَ","was taken","يُؤْتِكُمْ خَيْرًۭا مِّمَّآ","مِنكُمْ وَيَغْفِرْ لَكُمْ ۗ",92],["9:5:9",187,"وَخُذُوهُمْ","and seize them","ٱلْمُشْرِكِينَ حَيْثُ وَجَدتُّمُوهُمْ","وَٱحْصُرُوهُمْ وَٱقْعُدُوا۟ لَهُمْ",92],["9:16:12",189,"يَتَّخِذُوا۟","take","جَـٰهَدُوا۟ مِنكُمْ وَلَمْ","مِن دُونِ ٱللَّهِ",95],["9:23:5",190,"تَتَّخِذُوٓا۟","take","ٱلَّذِينَ ءَامَنُوا۟ لَا","ءَابَآءَكُمْ وَإِخْوَٰنَكُمْ أَوْلِيَآءَ",95],["9:31:1",191,"ٱتَّخَذُوٓا۟","They have taken","","أَحْبَارَهُمْ وَرُهْبَـٰنَهُمْ أَرْبَابًۭا",95],["9:50:10",195,"أَخَذْنَآ","we took","مُصِيبَةٌۭ يَقُولُوا۟ قَدْ","أَمْرَنَا مِن قَبْلُ",92],["9:98:4",202,"يَتَّخِذُ","takes","وَمِنَ ٱلْأَعْرَابِ مَن","مَا يُنفِقُ مَغْرَمًۭا",95],["9:99:8",202,"وَيَتَّخِذُ","and takes","بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ","مَا يُنفِقُ قُرُبَـٰتٍ",95],["9:103:1",203,"خُذْ","Take","","مِنْ أَمْوَٰلِهِمْ صَدَقَةًۭ",92],["9:104:10",203,"وَيَأْخُذُ","and takes","ٱلتَّوْبَةَ عَنْ عِبَادِهِۦ","ٱلصَّدَقَـٰتِ وَأَنَّ ٱللَّهَ",92],["9:107:2",204,"ٱتَّخَذُوا۟","take","وَٱلَّذِينَ","مَسْجِدًۭا ضِرَارًۭا وَكُفْرًۭا",95],["10:24:19",211,"أَخَذَتِ","takes","وَٱلْأَنْعَـٰمُ حَتَّىٰٓ إِذَآ","ٱلْأَرْضُ زُخْرُفَهَا وَٱزَّيَّنَتْ",92],["10:68:2",216,"ٱتَّخَذَ","Allah has taken","قَالُوا۟","ٱللَّهُ وَلَدًۭا ۗ سُبْحَـٰنَهُۥ ۖ",95],["11:56:12",228,"ءَاخِذٌۢ","has grasp","دَآبَّةٍ إِلَّا هُوَ","بِنَاصِيَتِهَآ ۚ إِنَّ رَبِّى",1755],["11:64:15",229,"فَيَأْخُذَكُمْ","lest will seize you","وَلَا تَمَسُّوهَا بِسُوٓءٍۢ","عَذَابٌۭ قَرِيبٌۭ",92],["11:67:1",229,"وَأَخَذَ","And seized","","ٱلَّذِينَ ظَلَمُوا۟ ٱلصَّيْحَةُ",92],["11:92:8",232,"وَٱتَّخَذْتُمُوهُ","And you have taken Him","عَلَيْكُم مِّنَ ٱللَّهِ","وَرَآءَكُمْ ظِهْرِيًّا ۖ إِنَّ",95],["11:94:11",232,"وَأَخَذَتِ","And seized","مَعَهُۥ بِرَحْمَةٍۢ مِّنَّا","ٱلَّذِينَ ظَلَمُوا۟ ٱلصَّيْحَةُ",92],["11:102:2",233,"أَخْذُ","(is) the seizure (of) your Lord","وَكَذَٰلِكَ","رَبِّكَ إِذَآ أَخَذَ",1143],["11:102:5",233,"أَخَذَ","He seizes","أَخْذُ رَبِّكَ إِذَآ","ٱلْقُرَىٰ وَهِىَ ظَـٰلِمَةٌ ۚ",92],["11:102:10",233,"أَخْذَهُۥٓ","His seizure","وَهِىَ ظَـٰلِمَةٌ ۚ إِنَّ","أَلِيمٌۭ شَدِيدٌ",1143],["12:21:13",237,"نَتَّخِذَهُۥ","we will take him","أَن يَنفَعَنَآ أَوْ","وَلَدًۭا ۚ وَكَذَٰلِكَ مَكَّنَّا",95],["12:76:16",244,"لِيَأْخُذَ","take","لِيُوسُفَ ۖ مَا كَانَ","أَخَاهُ فِى دِينِ",92],["12:78:9",244,"فَخُذْ","so take","أَبًۭا شَيْخًۭا كَبِيرًۭا","أَحَدَنَا مَكَانَهُۥٓ ۖ إِنَّا",92],["12:79:5",245,"نَّأْخُذَ","we take","مَعَاذَ ٱللَّهِ أَن","إِلَّا مَن وَجَدْنَا",92],["12:80:13",245,"أَخَذَ","has taken","أَنَّ أَبَاكُمْ قَدْ","عَلَيْكُم مَّوْثِقًۭا مِّنَ",92],["13:16:9",251,"أَفَٱتَّخَذْتُم","Have you then taken","قُلِ ٱللَّهُ ۚ قُلْ","مِّن دُونِهِۦٓ أَوْلِيَآءَ",95],["13:32:10",253,"أَخَذْتُهُمْ ۖ","I seized them","لِلَّذِينَ كَفَرُوا۟ ثُمَّ","فَكَيْفَ كَانَ عِقَابِ",92],["15:73:1",266,"فَأَخَذَتْهُمُ","So, seized them","","ٱلصَّيْحَةُ مُشْرِقِينَ",92],["15:83:1",266,"فَأَخَذَتْهُمُ","But seized them","","ٱلصَّيْحَةُ مُصْبِحِينَ",92],["16:46:2",272,"يَأْخُذَهُمْ","that He may seize them","أَوْ","فِى تَقَلُّبِهِمْ فَمَا",92],["16:47:2",272,"يَأْخُذَهُمْ","that He may seize them","أَوْ","عَلَىٰ تَخَوُّفٍۢ فَإِنَّ",92],["16:51:4",272,"تَتَّخِذُوٓا۟","take","۞ وَقَالَ ٱللَّهُ لَا","إِلَـٰهَيْنِ ٱثْنَيْنِ ۖ إِنَّمَا",95],["16:61:2",273,"يُؤَاخِذُ","Allah were to seize","وَلَوْ","ٱللَّهُ ٱلنَّاسَ بِظُلْمِهِم",940],["16:67:5",274,"تَتَّخِذُونَ","you take","ثَمَرَٰتِ ٱلنَّخِيلِ وَٱلْأَعْنَـٰبِ","مِنْهُ سَكَرًۭا وَرِزْقًا",95],["16:68:6",274,"ٱتَّخِذِى","Take","إِلَى ٱلنَّحْلِ أَنِ","مِنَ ٱلْجِبَالِ بُيُوتًۭا",95],["16:92:10",277,"تَتَّخِذُونَ","you take","بَعْدِ قُوَّةٍ أَنكَـٰثًۭا","أَيْمَـٰنَكُمْ دَخَلًۢا بَيْنَكُمْ",95],["16:94:2",278,"تَتَّخِذُوٓا۟","take","وَلَا","أَيْمَـٰنَكُمْ دَخَلًۢا بَيْنَكُمْ",95],["16:113:6",280,"فَأَخَذَهُمُ","so seized them","رَسُولٌۭ مِّنْهُمْ فَكَذَّبُوهُ","ٱلْعَذَابُ وَهُمْ ظَـٰلِمُونَ",92],["17:2:9",282,"تَتَّخِذُوا۟","you take","لِّبَنِىٓ إِسْرَٰٓءِيلَ أَلَّا","مِن دُونِى وَكِيلًۭا",95],["17:40:4",286,"وَٱتَّخَذَ","and He has taken","أَفَأَصْفَىٰكُمْ رَبُّكُم بِٱلْبَنِينَ","مِنَ ٱلْمَلَـٰٓئِكَةِ إِنَـٰثًا ۚ",95],["17:73:12",289,"لَّٱتَّخَذُوكَ","surely they would take you","عَلَيْنَا غَيْرَهُۥ ۖ وَإِذًۭا","خَلِيلًۭا",95],["17:111:6",293,"يَتَّخِذْ","has not taken","لِلَّهِ ٱلَّذِى لَمْ","وَلَدًۭا وَلَمْ يَكُن",95],["18:4:4",293,"ٱتَّخَذَ","Allah has taken","وَيُنذِرَ ٱلَّذِينَ قَالُوا۟","ٱللَّهُ وَلَدًۭا",95],["18:15:3",294,"ٱتَّخَذُوا۟","have taken","هَـٰٓؤُلَآءِ قَوْمُنَا","مِن دُونِهِۦٓ ءَالِهَةًۭ ۖ",95],["18:21:30",296,"لَنَتَّخِذَنَّ","Surely we will take","غَلَبُوا۟ عَلَىٰٓ أَمْرِهِمْ","عَلَيْهِم مَّسْجِدًۭا",95],["18:50:16",299,"أَفَتَتَّخِذُونَهُۥ","Will you then take him","عَنْ أَمْرِ رَبِّهِۦٓ ۗ","وَذُرِّيَّتَهُۥٓ أَوْلِيَآءَ مِن",95],["18:51:11",299,"مُتَّخِذَ","the One to take","أَنفُسِهِمْ وَمَا كُنتُ","ٱلْمُضِلِّينَ عَضُدًۭا",1917],["18:56:14",300,"وَٱتَّخَذُوٓا۟","And they take","لِيُدْحِضُوا۟ بِهِ ٱلْحَقَّ ۖ","ءَايَـٰتِى وَمَآ أُنذِرُوا۟",95],["18:58:6",300,"يُؤَاخِذُهُم","He were to seize them","ذُو ٱلرَّحْمَةِ ۖ لَوْ","بِمَا كَسَبُوا۟ لَعَجَّلَ",940],["18:61:7",300,"فَٱتَّخَذَ","and it took","بَيْنِهِمَا نَسِيَا حُوتَهُمَا","سَبِيلَهُۥ فِى ٱلْبَحْرِ",95],["18:63:16",301,"وَٱتَّخَذَ","And it took","ٱلشَّيْطَـٰنُ أَنْ أَذْكُرَهُۥ ۚ","سَبِيلَهُۥ فِى ٱلْبَحْرِ",95],["18:73:3",301,"تُؤَاخِذْنِى","blame me","قَالَ لَا","بِمَا نَسِيتُ وَلَا",940],["18:77:22",302,"لَتَّخَذْتَ","surely you (could) have taken","قَالَ لَوْ شِئْتَ","عَلَيْهِ أَجْرًۭا",95],["18:79:14",302,"يَأْخُذُ","who seized","وَكَانَ وَرَآءَهُم مَّلِكٌۭ","كُلَّ سَفِينَةٍ غَصْبًۭا",92],["18:86:22",303,"تَتَّخِذَ","you take","تُعَذِّبَ وَإِمَّآ أَن","فِيهِمْ حُسْنًۭا",95],["18:102:5",304,"يَتَّخِذُوا۟","they (can) take","ٱلَّذِينَ كَفَرُوٓا۟ أَن","عِبَادِى مِن دُونِىٓ",95],["18:106:6",304,"وَٱتَّخَذُوٓا۟","and took","جَهَنَّمُ بِمَا كَفَرُوا۟","ءَايَـٰتِى وَرُسُلِى هُزُوًا",95],["19:12:2",306,"خُذِ","Hold","يَـٰيَحْيَىٰ","ٱلْكِتَـٰبَ بِقُوَّةٍۢ ۖ وَءَاتَيْنَـٰهُ",92],["19:17:1",306,"فَٱتَّخَذَتْ","Then she took","","مِن دُونِهِمْ حِجَابًۭا",95],["19:35:5",307,"يَتَّخِذَ","He should take","كَانَ لِلَّهِ أَن","مِن وَلَدٍۢ ۖ سُبْحَـٰنَهُۥٓ ۚ",95],["19:78:4",311,"ٱتَّخَذَ","has he taken","أَطَّلَعَ ٱلْغَيْبَ أَمِ","عِندَ ٱلرَّحْمَـٰنِ عَهْدًۭا",95],["19:81:1",311,"وَٱتَّخَذُوا۟","And they have taken","","مِن دُونِ ٱللَّهِ",95],["19:87:6",311,"ٱتَّخَذَ","has taken","ٱلشَّفَـٰعَةَ إِلَّا مَنِ","عِندَ ٱلرَّحْمَـٰنِ عَهْدًۭا",95],["19:88:2",311,"ٱتَّخَذَ","Has taken","وَقَالُوا۟","ٱلرَّحْمَـٰنُ وَلَدًۭا",95],["19:92:5",311,"يَتَّخِذَ","He should take","يَنۢبَغِى لِلرَّحْمَـٰنِ أَن","وَلَدًا",95],["20:21:2",313,"خُذْهَا","Seize it","قَالَ","وَلَا تَخَفْ ۖ سَنُعِيدُهَا",92],["20:39:11",314,"يَأْخُذْهُ","will take him","فَلْيُلْقِهِ ٱلْيَمُّ بِٱلسَّاحِلِ","عَدُوٌّۭ لِّى وَعَدُوٌّۭ",92],["20:94:4",318,"تَأْخُذْ","seize (me)","قَالَ يَبْنَؤُمَّ لَا","بِلِحْيَتِى وَلَا بِرَأْسِىٓ ۖ",92],["21:17:4",323,"نَّتَّخِذَ","We take","لَوْ أَرَدْنَآ أَن","لَهْوًۭا لَّٱتَّخَذْنَـٰهُ مِن",95],["21:17:6",323,"لَّٱتَّخَذْنَـٰهُ","surely We (could have) taken it","أَن نَّتَّخِذَ لَهْوًۭا","مِن لَّدُنَّآ إِن",95],["21:21:2",323,"ٱتَّخَذُوٓا۟","(have) they taken","أَمِ","ءَالِهَةًۭ مِّنَ ٱلْأَرْضِ",95],["21:24:2",323,"ٱتَّخَذُوا۟","(have) they taken","أَمِ","مِن دُونِهِۦٓ ءَالِهَةًۭ ۖ",95],["21:26:2",324,"ٱتَّخَذَ","Has taken","وَقَالُوا۟","ٱلرَّحْمَـٰنُ وَلَدًۭا ۗ سُبْحَـٰنَهُۥ ۚ",95],["21:36:6",325,"يَتَّخِذُونَكَ","they take you","ٱلَّذِينَ كَفَرُوٓا۟ إِن","إِلَّا هُزُوًا أَهَـٰذَا",95],["22:44:8",337,"أَخَذْتُهُمْ ۖ","I seized them","فَأَمْلَيْتُ لِلْكَـٰفِرِينَ ثُمَّ","فَكَيْفَ كَانَ نَكِيرِ",92],["22:48:9",338,"أَخَذْتُهَا","I seized it","وَهِىَ ظَالِمَةٌۭ ثُمَّ","وَإِلَىَّ ٱلْمَصِيرُ",92],["23:41:1",344,"فَأَخَذَتْهُمُ","So seized them","","ٱلصَّيْحَةُ بِٱلْحَقِّ فَجَعَلْنَـٰهُمْ",92],["23:64:3",346,"أَخَذْنَا","We seize","حَتَّىٰٓ إِذَآ","مُتْرَفِيهِم بِٱلْعَذَابِ إِذَا",92],["23:76:2",347,"أَخَذْنَـٰهُم","We seized them","وَلَقَدْ","بِٱلْعَذَابِ فَمَا ٱسْتَكَانُوا۟",92],["23:91:2",348,"ٱتَّخَذَ","Allah has taken","مَا","ٱللَّهُ مِن وَلَدٍۢ",95],["23:110:1",349,"فَٱتَّخَذْتُمُوهُمْ","But you took them","","سِخْرِيًّا حَتَّىٰٓ أَنسَوْكُمْ",95],["24:2:10",350,"تَأْخُذْكُم","withhold you","مِا۟ئَةَ جَلْدَةٍۢ ۖ وَلَا","بِهِمَا رَأْفَةٌۭ فِى",92],["25:2:7",359,"يَتَّخِذْ","He has taken","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَلَمْ","وَلَدًۭا وَلَمْ يَكُن",95],["25:3:1",360,"وَٱتَّخَذُوا۟","Yet they have taken","","مِن دُونِهِۦٓ ءَالِهَةًۭ",95],["25:18:8",361,"نَّتَّخِذَ","we take","يَنۢبَغِى لَنَآ أَن","مِن دُونِكَ مِنْ",95],["25:27:8",362,"ٱتَّخَذْتُ","I had taken","يَدَيْهِ يَقُولُ يَـٰلَيْتَنِى","مَعَ ٱلرَّسُولِ سَبِيلًۭا",95],["25:28:4",362,"أَتَّخِذْ","I had taken","يَـٰوَيْلَتَىٰ لَيْتَنِى لَمْ","فُلَانًا خَلِيلًۭا",95],["25:30:6",362,"ٱتَّخَذُوا۟","took","يَـٰرَبِّ إِنَّ قَوْمِى","هَـٰذَا ٱلْقُرْءَانَ مَهْجُورًۭا",95],["25:41:4",363,"يَتَّخِذُونَكَ","they take you","وَإِذَا رَأَوْكَ إِن","إِلَّا هُزُوًا أَهَـٰذَا",95],["25:43:3",363,"ٱتَّخَذَ","takes","أَرَءَيْتَ مَنِ","إِلَـٰهَهُۥ هَوَىٰهُ أَفَأَنتَ",95],["25:57:11",365,"يَتَّخِذَ","take","مَن شَآءَ أَن","إِلَىٰ رَبِّهِۦ سَبِيلًۭا",95],["26:29:3",368,"ٱتَّخَذْتَ","you take","قَالَ لَئِنِ","إِلَـٰهًا غَيْرِى لَأَجْعَلَنَّكَ",95],["26:129:1",372,"وَتَتَّخِذُونَ","And take for yourselves","","مَصَانِعَ لَعَلَّكُمْ تَخْلُدُونَ",95],["26:156:4",373,"فَيَأْخُذَكُمْ","lest seize you","وَلَا تَمَسُّوهَا بِسُوٓءٍۢ","عَذَابُ يَوْمٍ عَظِيمٍۢ",92],["26:158:1",373,"فَأَخَذَهُمُ","So seized them","","ٱلْعَذَابُ ۗ إِنَّ فِى",92],["26:189:2",375,"فَأَخَذَهُمْ","so seized them","فَكَذَّبُوهُ","عَذَابُ يَوْمِ ٱلظُّلَّةِ ۚ",92],["28:9:14",386,"نَتَّخِذَهُۥ","we may take him","أَن يَنفَعَنَآ أَوْ","وَلَدًۭا وَهُمْ لَا",95],["28:40:1",390,"فَأَخَذْنَـٰهُ","So We seized him","","وَجُنُودَهُۥ فَنَبَذْنَـٰهُمْ فِى",92],["29:14:13",397,"فَأَخَذَهُمُ","then seized them","إِلَّا خَمْسِينَ عَامًۭا","ٱلطُّوفَانُ وَهُمْ ظَـٰلِمُونَ",92],["29:25:3",399,"ٱتَّخَذْتُم","you have taken","وَقَالَ إِنَّمَا","مِّن دُونِ ٱللَّهِ",95],["29:37:2",400,"فَأَخَذَتْهُمُ","so seized them","فَكَذَّبُوهُ","ٱلرَّجْفَةُ فَأَصْبَحُوا۟ فِى",92],["29:40:2",401,"أَخَذْنَا","We seized","فَكُلًّا","بِذَنۢبِهِۦ ۖ فَمِنْهُم مَّنْ",92],["29:40:11",401,"أَخَذَتْهُ","seized him","حَاصِبًۭا وَمِنْهُم مَّنْ","ٱلصَّيْحَةُ وَمِنْهُم مَّنْ",92],["29:41:3",401,"ٱتَّخَذُوا۟","take","مَثَلُ ٱلَّذِينَ","مِن دُونِ ٱللَّهِ",95],["29:41:10",401,"ٱتَّخَذَتْ","who takes","أَوْلِيَآءَ كَمَثَلِ ٱلْعَنكَبُوتِ","بَيْتًۭا ۖ وَإِنَّ أَوْهَنَ",95],["31:6:13",411,"وَيَتَّخِذَهَا","and takes it","ٱللَّهِ بِغَيْرِ عِلْمٍۢ","هُزُوًا ۚ أُو۟لَـٰٓئِكَ لَهُمْ",95],["33:7:2",419,"أَخَذْنَا","We took","وَإِذْ","مِنَ ٱلنَّبِيِّـۧنَ مِيثَـٰقَهُمْ",92],["33:7:14",419,"وَأَخَذْنَا","And We took","وَعِيسَى ٱبْنِ مَرْيَمَ ۖ","مِنْهُم مِّيثَـٰقًا غَلِيظًۭا",92],["33:61:4",426,"أُخِذُوا۟","they are seized","مَّلْعُونِينَ ۖ أَيْنَمَا ثُقِفُوٓا۟","وَقُتِّلُوا۟ تَقْتِيلًۭا",92],["34:51:7",434,"وَأُخِذُوا۟","and they will be seized","فَزِعُوا۟ فَلَا فَوْتَ","مِن مَّكَانٍۢ قَرِيبٍۢ",92],["35:6:5",435,"فَٱتَّخِذُوهُ","so take him","ٱلشَّيْطَـٰنَ لَكُمْ عَدُوٌّۭ","عَدُوًّا ۚ إِنَّمَا يَدْعُوا۟",95],["35:26:2",437,"أَخَذْتُ","I seized","ثُمَّ","ٱلَّذِينَ كَفَرُوا۟ ۖ فَكَيْفَ",92],["35:45:2",440,"يُؤَاخِذُ","Allah (were to) punish","وَلَوْ","ٱللَّهُ ٱلنَّاسَ بِمَا",940],["36:23:1",441,"ءَأَتَّخِذُ","Should I take","","مِن دُونِهِۦٓ ءَالِهَةً",95],["36:49:6",443,"تَأْخُذُهُمْ","it will seize them","إِلَّا صَيْحَةًۭ وَٰحِدَةًۭ","وَهُمْ يَخِصِّمُونَ",92],["36:74:1",445,"وَٱتَّخَذُوا۟","But they have taken","","مِن دُونِ ٱللَّهِ",95],["38:44:1",456,"وَخُذْ","And take","","بِيَدِكَ ضِغْثًۭا فَٱضْرِب",92],["38:63:1",457,"أَتَّخَذْنَـٰهُمْ","Did we take them","","سِخْرِيًّا أَمْ زَاغَتْ",95],["39:3:6",458,"ٱتَّخَذُوا۟","take","ٱلدِّينُ ٱلْخَالِصُ ۚ وَٱلَّذِينَ","مِن دُونِهِۦٓ أَوْلِيَآءَ",95],["39:4:5",458,"يَتَّخِذَ","take","أَرَادَ ٱللَّهُ أَن","وَلَدًۭا لَّٱصْطَفَىٰ مِمَّا",95],["39:43:2",463,"ٱتَّخَذُوا۟","have they taken","أَمِ","مِن دُونِ ٱللَّهِ",95],["40:5:12",467,"لِيَأْخُذُوهُ ۖ","to seize him","كُلُّ أُمَّةٍۭ بِرَسُولِهِمْ","وَجَـٰدَلُوا۟ بِٱلْبَـٰطِلِ لِيُدْحِضُوا۟",92],["40:5:18",467,"فَأَخَذْتُهُمْ ۖ","So I seized them","لِيُدْحِضُوا۟ بِهِ ٱلْحَقَّ","فَكَيْفَ كَانَ عِقَابِ",92],["40:21:21",469,"فَأَخَذَهُمُ","but Allah seized them","وَءَاثَارًۭا فِى ٱلْأَرْضِ","ٱللَّهُ بِذُنُوبِهِمْ وَمَا",92],["40:22:8",469,"فَأَخَذَهُمُ","So Allah seized them","رُسُلُهُم بِٱلْبَيِّنَـٰتِ فَكَفَرُوا۟","ٱللَّهُ ۚ إِنَّهُۥ قَوِىٌّۭ",92],["41:17:8",478,"فَأَخَذَتْهُمْ","so seized them","ٱلْعَمَىٰ عَلَى ٱلْهُدَىٰ","صَـٰعِقَةُ ٱلْعَذَابِ ٱلْهُونِ",92],["42:6:2",483,"ٱتَّخَذُوا۟","take","وَٱلَّذِينَ","مِن دُونِهِۦٓ أَوْلِيَآءَ",95],["42:9:2",483,"ٱتَّخَذُوا۟","have they taken","أَمِ","مِن دُونِهِۦٓ أَوْلِيَآءَ ۖ",95],["43:16:2",490,"ٱتَّخَذَ","has He taken","أَمِ","مِمَّا يَخْلُقُ بَنَاتٍۢ",95],["43:32:17",491,"لِّيَتَّخِذَ","so that may take","فَوْقَ بَعْضٍۢ دَرَجَـٰتٍۢ","بَعْضُهُم بَعْضًۭا سُخْرِيًّۭا ۗ",95],["43:48:10",493,"وَأَخَذْنَـٰهُم","and We seized them","أَكْبَرُ مِنْ أُخْتِهَا ۖ","بِٱلْعَذَابِ لَعَلَّهُمْ يَرْجِعُونَ",92],["44:47:1",498,"خُذُوهُ","Seize him","","فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ",92],["45:9:6",499,"ٱتَّخَذَهَا","he takes them","مِنْ ءَايَـٰتِنَا شَيْـًٔا","هُزُوًا ۚ أُو۟لَـٰٓئِكَ لَهُمْ",95],["45:10:12",499,"ٱتَّخَذُوا۟","they had taken","شَيْـًۭٔا وَلَا مَا","مِن دُونِ ٱللَّهِ",95],["45:23:3",501,"ٱتَّخَذَ","takes","أَفَرَءَيْتَ مَنِ","إِلَـٰهَهُۥ هَوَىٰهُ وَأَضَلَّهُ",95],["45:35:3",502,"ٱتَّخَذْتُمْ","took","ذَٰلِكُم بِأَنَّكُمُ","ءَايَـٰتِ ٱللَّهِ هُزُوًۭا",95],["46:28:4",505,"ٱتَّخَذُوا۟","they had taken","فَلَوْلَا نَصَرَهُمُ ٱلَّذِينَ","مِن دُونِ ٱللَّهِ",95],["48:15:7",512,"لِتَأْخُذُوهَا","to take it","ٱنطَلَقْتُمْ إِلَىٰ مَغَانِمَ","ذَرُونَا نَتَّبِعْكُمْ ۖ يُرِيدُونَ",92],["48:19:3",513,"يَأْخُذُونَهَا ۗ","that they will take","وَمَغَانِمَ كَثِيرَةًۭ","وَكَانَ ٱللَّهُ عَزِيزًا",92],["48:20:5",513,"تَأْخُذُونَهَا","that you will take it","ٱللَّهُ مَغَانِمَ كَثِيرَةًۭ","فَعَجَّلَ لَكُمْ هَـٰذِهِۦ",92],["51:16:1",521,"ءَاخِذِينَ","Taking","","مَآ ءَاتَىٰهُمْ رَبُّهُمْ ۚ",1755],["51:40:1",522,"فَأَخَذْنَـٰهُ","So We took him","","وَجُنُودَهُۥ فَنَبَذْنَـٰهُمْ فِى",92],["51:44:5",522,"فَأَخَذَتْهُمُ","so seized them","عَنْ أَمْرِ رَبِّهِمْ","ٱلصَّـٰعِقَةُ وَهُمْ يَنظُرُونَ",92],["54:42:4",530,"فَأَخَذْنَـٰهُمْ","so We seized them","كَذَّبُوا۟ بِـَٔايَـٰتِنَا كُلِّهَا","أَخْذَ عَزِيزٍۢ مُّقْتَدِرٍ",92],["54:42:5",530,"أَخْذَ","(with) a seizure","بِـَٔايَـٰتِنَا كُلِّهَا فَأَخَذْنَـٰهُمْ","عَزِيزٍۢ مُّقْتَدِرٍ",1143],["55:41:4",532,"فَيُؤْخَذُ","and will be seized","يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَـٰهُمْ","بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ",92],["57:8:11",538,"أَخَذَ","He has taken","لِتُؤْمِنُوا۟ بِرَبِّكُمْ وَقَدْ","مِيثَـٰقَكُمْ إِن كُنتُم",92],["57:15:3",539,"يُؤْخَذُ","will be accepted","فَٱلْيَوْمَ لَا","مِنكُمْ فِدْيَةٌۭ وَلَا",92],["58:16:1",544,"ٱتَّخَذُوٓا۟","They have taken","","أَيْمَـٰنَهُمْ جُنَّةًۭ فَصَدُّوا۟",95],["59:7:27",546,"فَخُذُوهُ","take it","وَمَآ ءَاتَىٰكُمُ ٱلرَّسُولُ","وَمَا نَهَىٰكُمْ عَنْهُ",92],["60:1:5",549,"تَتَّخِذُوا۟","take","ٱلَّذِينَ ءَامَنُوا۟ لَا","عَدُوِّى وَعَدُوَّكُمْ أَوْلِيَآءَ",95],["63:2:1",554,"ٱتَّخَذُوٓا۟","They take","","أَيْمَـٰنَهُمْ جُنَّةًۭ فَصَدُّوا۟",95],["69:10:4",567,"فَأَخَذَهُمْ","so He seized them","فَعَصَوْا۟ رَسُولَ رَبِّهِمْ","أَخْذَةًۭ رَّابِيَةً",92],["69:10:5",567,"أَخْذَةًۭ","(with) a seizure","رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ","رَّابِيَةً",1143],["69:30:1",567,"خُذُوهُ","Seize him","","فَغُلُّوهُ",92],["69:45:1",568,"لَأَخَذْنَا","Certainly We (would) have seized","","مِنْهُ بِٱلْيَمِينِ",92],["72:3:6",572,"ٱتَّخَذَ","He has taken","جَدُّ رَبِّنَا مَا","صَـٰحِبَةًۭ وَلَا وَلَدًۭا",95],["73:9:8",574,"فَٱتَّخِذْهُ","so take Him","إِلَـٰهَ إِلَّا هُوَ","وَكِيلًۭا",95],["73:16:4",574,"فَأَخَذْنَـٰهُ","so We seized him","فَعَصَىٰ فِرْعَوْنُ ٱلرَّسُولَ","أَخْذًۭا وَبِيلًۭا",92],["73:16:5",574,"أَخْذًۭا","(with) a seizure","فِرْعَوْنُ ٱلرَّسُولَ فَأَخَذْنَـٰهُ","وَبِيلًۭا",1143],["73:19:6",574,"ٱتَّخَذَ","(let him) take","تَذْكِرَةٌۭ ۖ فَمَن شَآءَ","إِلَىٰ رَبِّهِۦ سَبِيلًا",95],["76:29:6",580,"ٱتَّخَذَ","let him take","تَذْكِرَةٌۭ ۖ فَمَن شَآءَ","إِلَىٰ رَبِّهِۦ سَبِيلًۭا",95],["78:39:6",583,"ٱتَّخَذَ","let him take","ٱلْحَقُّ ۖ فَمَن شَآءَ","إِلَىٰ رَبِّهِۦ مَـَٔابًا",95],["79:25:1",584,"فَأَخَذَهُ","So seized him","","ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ",92]]