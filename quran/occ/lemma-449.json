[["2:38:5",7,"فَإِمَّا","and when","ٱهْبِطُوا۟ مِنْهَا جَمِيعًۭا ۖ","يَأْتِيَنَّكُم مِّنِّى هُدًۭى",449],["7:115:3",164,"إِمَّآ","Whether","قَالُوا۟ يَـٰمُوسَىٰٓ","أَن تُلْقِىَ وَإِمَّآ",449],["7:115:6",164,"وَإِمَّآ","or Whether","إِمَّآ أَن تُلْقِىَ","أَن نَّكُونَ نَحْنُ",449],["9:106:5",203,"إِمَّا","whether","مُرْجَوْنَ لِأَمْرِ ٱللَّهِ","يُعَذِّبُهُمْ وَإِمَّا يَتُوبُ",449],["9:106:7",203,"وَإِمَّا","or","ٱللَّهِ إِمَّا يُعَذِّبُهُمْ","يَتُوبُ عَلَيْهِمْ ۗ وَٱللَّهُ",449],["10:46:1",214,"وَإِمَّا","And whether","","نُرِيَنَّكَ بَعْضَ ٱلَّذِى",449],["17:23:9",284,"إِمَّا","Whether","إِيَّاهُ وَبِٱلْوَٰلِدَيْنِ إِحْسَـٰنًا ۚ","يَبْلُغَنَّ عِندَكَ ٱلْكِبَرَ",449],["17:28:1",285,"وَإِمَّا","And if","","تُعْرِضَنَّ عَنْهُمُ ٱبْتِغَآءَ",449],["18:86:17",303,"إِمَّآ","Either","قُلْنَا يَـٰذَا ٱلْقَرْنَيْنِ","أَن تُعَذِّبَ وَإِمَّآ",449],["18:86:20",303,"وَإِمَّآ","or","إِمَّآ أَن تُعَذِّبَ","أَن تَتَّخِذَ فِيهِمْ",449],["19:26:5",307,"فَإِمَّا","And if","وَٱشْرَبِى وَقَرِّى عَيْنًۭا ۖ","تَرَيِنَّ مِنَ ٱلْبَشَرِ",449],["19:75:15",310,"إِمَّا","either","رَأَوْا۟ مَا يُوعَدُونَ","ٱلْعَذَابَ وَإِمَّا ٱلسَّاعَةَ",449],["19:75:17",310,"وَإِمَّا","or","يُوعَدُونَ إِمَّا ٱلْعَذَابَ","ٱلسَّاعَةَ فَسَيَعْلَمُونَ مَنْ",449],["20:65:3",316,"إِمَّآ","Either","قَالُوا۟ يَـٰمُوسَىٰٓ","أَن تُلْقِىَ وَإِمَّآ",449],["20:65:6",316,"وَإِمَّآ","or","إِمَّآ أَن تُلْقِىَ","أَن نَّكُونَ أَوَّلَ",449],["23:93:3",348,"إِمَّا","If","قُل رَّبِّ","تُرِيَنِّى مَا يُوعَدُونَ",449],["40:77:6",475,"فَإِمَّا","And whether","وَعْدَ ٱللَّهِ حَقٌّۭ ۚ","نُرِيَنَّكَ بَعْضَ ٱلَّذِى",449],["41:36:1",480,"وَإِمَّا","And if","","يَنزَغَنَّكَ مِنَ ٱلشَّيْطَـٰنِ",449],["43:41:1",492,"فَإِمَّا","And whether","","نَذْهَبَنَّ بِكَ فَإِنَّا",449],["47:4:12",507,"فَإِمَّا","then either","أَثْخَنتُمُوهُمْ فَشُدُّوا۟ ٱلْوَثَاقَ","مَنًّۢا بَعْدُ وَإِمَّا",449],["47:4:15",507,"وَإِمَّا","or","فَإِمَّا مَنًّۢا بَعْدُ","فِدَآءً حَتَّىٰ تَضَعَ",449],["76:3:4",578,"إِمَّا","whether","إِنَّا هَدَيْنَـٰهُ ٱلسَّبِيلَ","شَاكِرًۭا وَإِمَّا كَفُورًا",449],["76:3:6",578,"وَإِمَّا","and whether","ٱلسَّبِيلَ إِمَّا شَاكِرًۭا","كَفُورًا",449]]