[["2:61:39",9,"ٱلذِّلَّةُ","the humiliation","سَأَلْتُمْ ۗ وَضُرِبَتْ عَلَيْهِمُ","وَٱلْمَسْكَنَةُ وَبَآءُو بِغَضَبٍۢ",1029],["2:71:7",11,"ذَلُولٌۭ","trained","إِنَّهَا بَقَرَةٌۭ لَّا","تُثِيرُ ٱلْأَرْضَ وَلَا",2128],["3:26:16",53,"وَتُذِلُّ","and You humiliate","وَتُعِزُّ مَن تَشَآءُ","مَن تَشَآءُ ۖ بِيَدِكَ",4449],["3:112:3",64,"ٱلذِّلَّةُ","the humiliation","ضُرِبَتْ عَلَيْهِمُ","أَيْنَ مَا ثُقِفُوٓا۟",1029],["3:123:6",66,"أَذِلَّةٌۭ ۖ","weak","ٱللَّهُ بِبَدْرٍۢ وَأَنتُمْ","فَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ",1460],["5:54:15",117,"أَذِلَّةٍ","humble","بِقَوْمٍۢ يُحِبُّهُمْ وَيُحِبُّونَهُۥٓ","عَلَى ٱلْمُؤْمِنِينَ أَعِزَّةٍ",1460],["7:152:9",169,"وَذِلَّةٌۭ","and humiliation","غَضَبٌۭ مِّن رَّبِّهِمْ","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۚ",1029],["10:26:10",212,"ذِلَّةٌ ۚ","humiliation","وُجُوهَهُمْ قَتَرٌۭ وَلَا","أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْجَنَّةِ ۖ",1029],["10:27:8",212,"ذِلَّةٌۭ ۖ","humiliation","سَيِّئَةٍۭ بِمِثْلِهَا وَتَرْهَقُهُمْ","مَّا لَهُم مِّنَ",1029],["16:69:9",274,"ذُلُلًۭا ۚ","made smooth","فَٱسْلُكِى سُبُلَ رَبِّكِ","يَخْرُجُ مِنۢ بُطُونِهَا",2917],["17:24:4",284,"ٱلذُّلِّ","(of) humility","وَٱخْفِضْ لَهُمَا جَنَاحَ","مِنَ ٱلرَّحْمَةِ وَقُل",1713],["17:111:19",293,"ٱلذُّلِّ ۖ","weakness","لَّهُۥ وَلِىٌّۭ مِّنَ","وَكَبِّرْهُ تَكْبِيرًۢا",1713],["20:134:18",321,"نَّذِلَّ","we were humiliated","مِن قَبْلِ أَن","وَنَخْزَىٰ",4072],["27:34:11",379,"أَذِلَّةًۭ ۖ","(the) lowest","وَجَعَلُوٓا۟ أَعِزَّةَ أَهْلِهَآ","وَكَذَٰلِكَ يَفْعَلُونَ",1460],["27:37:11",380,"أَذِلَّةًۭ","(in) humiliation","بِهَا وَلَنُخْرِجَنَّهُم مِّنْهَآ","وَهُمْ صَـٰغِرُونَ",1460],["36:72:1",445,"وَذَلَّلْنَـٰهَا","And We have tamed them","","لَهُمْ فَمِنْهَا رَكُوبُهُمْ",2133],["42:45:6",488,"ٱلذُّلِّ","disgrace","عَلَيْهَا خَـٰشِعِينَ مِنَ","يَنظُرُونَ مِن طَرْفٍ",1713],["58:20:8",544,"ٱلْأَذَلِّينَ","the most humiliated","وَرَسُولَهُۥٓ أُو۟لَـٰٓئِكَ فِى","",2150],["63:8:9",555,"ٱلْأَذَلَّ ۚ","the more humble","لَيُخْرِجَنَّ ٱلْأَعَزُّ مِنْهَا","وَلِلَّهِ ٱلْعِزَّةُ وَلِرَسُولِهِۦ",2150],["67:15:6",563,"ذَلُولًۭا","subservient","جَعَلَ لَكُمُ ٱلْأَرْضَ","فَٱمْشُوا۟ فِى مَنَاكِبِهَا",2128],["68:43:4",566,"ذِلَّةٌۭ ۖ","humiliation","خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ","وَقَدْ كَانُوا۟ يُدْعَوْنَ",1029],["70:44:4",570,"ذِلَّةٌۭ ۚ","humiliation","خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ","ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى",1029],["76:14:4",579,"وَذُلِّلَتْ","and will hang low","وَدَانِيَةً عَلَيْهِمْ ظِلَـٰلُهَا","قُطُوفُهَا تَذْلِيلًۭا",2133],["76:14:6",579,"تَذْلِيلًۭا","dangling low","ظِلَـٰلُهَا وَذُلِّلَتْ قُطُوفُهَا","",4310]]