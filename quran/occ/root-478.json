[["3:151:18",69,"مَثْوَى","(is the) abode","وَمَأْوَىٰهُمُ ٱلنَّارُ ۚ وَبِئْسَ","ٱلظَّـٰلِمِينَ",691],["6:128:25",144,"مَثْوَىٰكُمْ","(is) your abode","لَنَا ۚ قَالَ ٱلنَّارُ","خَـٰلِدِينَ فِيهَآ إِلَّا",691],["12:21:8",237,"مَثْوَىٰهُ","his stay","مِّصْرَ لِٱمْرَأَتِهِۦٓ أَكْرِمِى","عَسَىٰٓ أَن يَنفَعَنَآ",691],["12:23:19",238,"مَثْوَاىَ ۖ","my stay","إِنَّهُۥ رَبِّىٓ أَحْسَنَ","إِنَّهُۥ لَا يُفْلِحُ",691],["16:29:7",270,"مَثْوَى","(is the) abode","خَـٰلِدِينَ فِيهَا ۖ فَلَبِئْسَ","ٱلْمُتَكَبِّرِينَ",691],["28:45:9",391,"ثَاوِيًۭا","a dweller","ٱلْعُمُرُ ۚ وَمَا كُنتَ","فِىٓ أَهْلِ مَدْيَنَ",4493],["29:68:16",404,"مَثْوًۭى","an abode","أَلَيْسَ فِى جَهَنَّمَ","لِّلْكَـٰفِرِينَ",691],["39:32:14",462,"مَثْوًۭى","an abode","أَلَيْسَ فِى جَهَنَّمَ","لِّلْكَـٰفِرِينَ",691],["39:60:13",465,"مَثْوًۭى","an abode","أَلَيْسَ فِى جَهَنَّمَ","لِّلْمُتَكَبِّرِينَ",691],["39:72:8",466,"مَثْوَى","(the) abode","خَـٰلِدِينَ فِيهَا ۖ فَبِئْسَ","ٱلْمُتَكَبِّرِينَ",691],["40:76:7",475,"مَثْوَى","(the) abode","خَـٰلِدِينَ فِيهَا ۖ فَبِئْسَ","ٱلْمُتَكَبِّرِينَ",691],["41:24:4",479,"مَثْوًۭى","(is) an abode","فَإِن يَصْبِرُوا۟ فَٱلنَّارُ","لَّهُمْ ۖ وَإِن يَسْتَعْتِبُوا۟",691],["47:12:21",508,"مَثْوًۭى","(will be) an abode","تَأْكُلُ ٱلْأَنْعَـٰمُ وَٱلنَّارُ","لَّهُمْ",691],["47:19:14",508,"وَمَثْوَىٰكُمْ","and your resting places","وَٱللَّهُ يَعْلَمُ مُتَقَلَّبَكُمْ","",691]]