[["11:91:13",232,"رَهْطُكَ","for your family","فِينَا ضَعِيفًۭا ۖ وَلَوْلَا","لَرَجَمْنَـٰكَ ۖ وَمَآ أَنتَ",1975],["11:92:3",232,"أَرَهْطِىٓ","Is my family","قَالَ يَـٰقَوْمِ","أَعَزُّ عَلَيْكُم مِّنَ",1975],["27:48:5",381,"رَهْطٍۢ","family heads","فِى ٱلْمَدِينَةِ تِسْعَةُ","يُفْسِدُونَ فِى ٱلْأَرْضِ",1975]]