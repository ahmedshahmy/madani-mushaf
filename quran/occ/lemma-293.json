[["2:79:1",12,"فَوَيْلٌۭ","So woe","","لِّلَّذِينَ يَكْتُبُونَ ٱلْكِتَـٰبَ",293],["2:79:16",12,"فَوَيْلٌۭ","So woe","بِهِۦ ثَمَنًۭا قَلِيلًۭا ۖ","لَّهُم مِّمَّا كَتَبَتْ",293],["2:79:21",12,"وَوَيْلٌۭ","and woe","مِّمَّا كَتَبَتْ أَيْدِيهِمْ","لَّهُم مِّمَّا يَكْسِبُونَ",293],["5:31:13",112,"يَـٰوَيْلَتَىٰٓ","Woe to me","سَوْءَةَ أَخِيهِ ۚ قَالَ","أَعَجَزْتُ أَنْ أَكُونَ",293],["11:72:2",230,"يَـٰوَيْلَتَىٰٓ","Woe to me","قَالَتْ","ءَأَلِدُ وَأَنَا۠ عَجُوزٌۭ",293],["14:2:10",255,"وَوَيْلٌۭ","And woe","وَمَا فِى ٱلْأَرْضِ ۗ","لِّلْكَـٰفِرِينَ مِنْ عَذَابٍۢ",293],["18:49:9",299,"يَـٰوَيْلَتَنَا","Oh, woe to us","مِمَّا فِيهِ وَيَقُولُونَ","مَالِ هَـٰذَا ٱلْكِتَـٰبِ",293],["19:37:5",307,"فَوَيْلٌۭ","so woe","ٱلْأَحْزَابُ مِنۢ بَيْنِهِمْ ۖ","لِّلَّذِينَ كَفَرُوا۟ مِن",293],["20:61:4",315,"وَيْلَكُمْ","Woe to you","قَالَ لَهُم مُّوسَىٰ","لَا تَفْتَرُوا۟ عَلَى",293],["21:14:2",323,"يَـٰوَيْلَنَآ","O woe to us","قَالُوا۟","إِنَّا كُنَّا ظَـٰلِمِينَ",293],["21:18:11",323,"ٱلْوَيْلُ","(is) destruction","هُوَ زَاهِقٌۭ ۚ وَلَكُمُ","مِمَّا تَصِفُونَ",293],["21:46:8",326,"يَـٰوَيْلَنَآ","O woe to us","عَذَابِ رَبِّكَ لَيَقُولُنَّ","إِنَّا كُنَّا ظَـٰلِمِينَ",293],["21:97:10",330,"يَـٰوَيْلَنَا","O woe to us","أَبْصَـٰرُ ٱلَّذِينَ كَفَرُوا۟","قَدْ كُنَّا فِى",293],["25:28:1",362,"يَـٰوَيْلَتَىٰ","O woe to me","","لَيْتَنِى لَمْ أَتَّخِذْ",293],["28:80:5",395,"وَيْلَكُمْ","Woe to you","ٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ","ثَوَابُ ٱللَّهِ خَيْرٌۭ",293],["36:52:2",443,"يَـٰوَيْلَنَا","O woe to us","قَالُوا۟","مَنۢ بَعَثَنَا مِن",293],["37:20:2",446,"يَـٰوَيْلَنَا","O woe to us","وَقَالُوا۟","هَـٰذَا يَوْمُ ٱلدِّينِ",293],["38:27:12",455,"فَوَيْلٌۭ","So woe","ظَنُّ ٱلَّذِينَ كَفَرُوا۟ ۚ","لِّلَّذِينَ كَفَرُوا۟ مِنَ",293],["39:22:11",461,"فَوَيْلٌۭ","So woe","نُورٍۢ مِّن رَّبِّهِۦ ۚ","لِّلْقَـٰسِيَةِ قُلُوبُهُم مِّن",293],["41:6:15",477,"وَوَيْلٌۭ","And woe","فَٱسْتَقِيمُوٓا۟ إِلَيْهِ وَٱسْتَغْفِرُوهُ ۗ","لِّلْمُشْرِكِينَ",293],["43:65:5",494,"فَوَيْلٌۭ","so woe","ٱلْأَحْزَابُ مِنۢ بَيْنِهِمْ ۖ","لِّلَّذِينَ ظَلَمُوا۟ مِنْ",293],["45:7:1",499,"وَيْلٌۭ","Woe","","لِّكُلِّ أَفَّاكٍ أَثِيمٍۢ",293],["46:17:17",504,"وَيْلَكَ","Woe to you","وَهُمَا يَسْتَغِيثَانِ ٱللَّهَ","ءَامِنْ إِنَّ وَعْدَ",293],["51:60:1",523,"فَوَيْلٌۭ","Then woe","","لِّلَّذِينَ كَفَرُوا۟ مِن",293],["52:11:1",523,"فَوَيْلٌۭ","Then woe","","يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",293],["68:31:2",565,"يَـٰوَيْلَنَآ","O woe to us","قَالُوا۟","إِنَّا كُنَّا طَـٰغِينَ",293],["77:15:1",580,"وَيْلٌۭ","Woe","","يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",293],["77:19:1",580,"وَيْلٌۭ","Woe","","يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",293],["77:24:1",581,"وَيْلٌۭ","Woe","","يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",293],["77:28:1",581,"وَيْلٌۭ","Woe","","يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",293],["77:34:1",581,"وَيْلٌۭ","Woe","","يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",293],["77:37:1",581,"وَيْلٌۭ","Woe","","يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",293],["77:40:1",581,"وَيْلٌۭ","Woe","","يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",293],["77:45:1",581,"وَيْلٌۭ","Woe","","يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",293],["77:47:1",581,"وَيْلٌۭ","Woe","","يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",293],["77:49:1",581,"وَيْلٌۭ","Woe","","يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",293],["83:1:1",587,"وَيْلٌۭ","Woe","","لِّلْمُطَفِّفِينَ",293],["83:10:1",588,"وَيْلٌۭ","Woe","","يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",293],["104:1:1",601,"وَيْلٌۭ","Woe","","لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ",293],["107:4:1",602,"فَوَيْلٌۭ","So woe","","لِّلْمُصَلِّينَ",293]]