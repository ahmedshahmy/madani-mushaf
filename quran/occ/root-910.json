[["16:26:13",269,"ٱلسَّقْفُ","the roof","ٱلْقَوَاعِدِ فَخَرَّ عَلَيْهِمُ","مِن فَوْقِهِمْ وَأَتَىٰهُمُ",1639],["21:32:3",324,"سَقْفًۭا","a roof","وَجَعَلْنَا ٱلسَّمَآءَ","مَّحْفُوظًۭا ۖ وَهُمْ عَنْ",1639],["43:33:12",491,"سُقُفًۭا","roofs","يَكْفُرُ بِٱلرَّحْمَـٰنِ لِبُيُوتِهِمْ","مِّن فِضَّةٍۢ وَمَعَارِجَ",1639],["52:5:1",523,"وَٱلسَّقْفِ","By the roof","","ٱلْمَرْفُوعِ",1639]]