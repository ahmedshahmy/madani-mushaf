[["20:12:9",312,"طُوًۭى","(of) Tuwa","إِنَّكَ بِٱلْوَادِ ٱلْمُقَدَّسِ","",2311],["21:104:2",331,"نَطْوِى","We will fold","يَوْمَ","ٱلسَّمَآءَ كَطَىِّ ٱلسِّجِلِّ",4018],["21:104:4",331,"كَطَىِّ","like (the) folding","يَوْمَ نَطْوِى ٱلسَّمَآءَ","ٱلسِّجِلِّ لِلْكُتُبِ ۚ كَمَا",3291],["39:67:12",465,"مَطْوِيَّـٰتٌۢ","(will be) folded","يَوْمَ ٱلْقِيَـٰمَةِ وَٱلسَّمَـٰوَٰتُ","بِيَمِينِهِۦ ۚ سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ",3647],["79:16:6",583,"طُوًى","(of) Tuwa","رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ","",2311]]