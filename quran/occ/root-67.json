[["2:23:14",4,"شُهَدَآءَكُم","your witnesses","مِّن مِّثْلِهِۦ وَٱدْعُوا۟","مِّن دُونِ ٱللَّهِ",214],["2:84:15",13,"تَشْهَدُونَ","(were) witnessing","ثُمَّ أَقْرَرْتُمْ وَأَنتُمْ","",263],["2:133:3",20,"شُهَدَآءَ","witnesses","أَمْ كُنتُمْ","إِذْ حَضَرَ يَعْقُوبَ",214],["2:140:22",21,"شَهَـٰدَةً","a testimony","أَظْلَمُ مِمَّن كَتَمَ","عِندَهُۥ مِنَ ٱللَّهِ ۗ",446],["2:143:6",22,"شُهَدَآءَ","witnesses","أُمَّةًۭ وَسَطًۭا لِّتَكُونُوا۟","عَلَى ٱلنَّاسِ وَيَكُونَ",214],["2:143:12",22,"شَهِيدًۭا ۗ","a witness","وَيَكُونَ ٱلرَّسُولُ عَلَيْكُمْ","وَمَا جَعَلْنَا ٱلْقِبْلَةَ",214],["2:185:14",28,"شَهِدَ","witnesses","ٱلْهُدَىٰ وَٱلْفُرْقَانِ ۚ فَمَن","مِنكُمُ ٱلشَّهْرَ فَلْيَصُمْهُ ۖ",263],["2:204:9",32,"وَيُشْهِدُ","and he calls to witness","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا","ٱللَّهَ عَلَىٰ مَا",1032],["2:282:52",48,"وَٱسْتَشْهِدُوا۟","And call for evidence","فَلْيُمْلِلْ وَلِيُّهُۥ بِٱلْعَدْلِ ۚ","شَهِيدَيْنِ مِن رِّجَالِكُمْ ۖ",2843],["2:282:53",48,"شَهِيدَيْنِ","two witnesses","وَلِيُّهُۥ بِٱلْعَدْلِ ۚ وَٱسْتَشْهِدُوا۟","مِن رِّجَالِكُمْ ۖ فَإِن",214],["2:282:65",48,"ٱلشُّهَدَآءِ","[the] witnesses","مِمَّن تَرْضَوْنَ مِنَ","أَن تَضِلَّ إِحْدَىٰهُمَا",214],["2:282:74",48,"ٱلشُّهَدَآءُ","the witnesses","ٱلْأُخْرَىٰ ۚ وَلَا يَأْبَ","إِذَا مَا دُعُوا۟ ۚ",214],["2:282:92",48,"لِلشَّهَـٰدَةِ","for evidence","عِندَ ٱللَّهِ وَأَقْوَمُ","وَأَدْنَىٰٓ أَلَّا تَرْتَابُوٓا۟ ۖ",446],["2:282:108",48,"وَأَشْهِدُوٓا۟","And take witness","جُنَاحٌ أَلَّا تَكْتُبُوهَا ۗ","إِذَا تَبَايَعْتُمْ ۚ وَلَا",1032],["2:282:115",48,"شَهِيدٌۭ ۚ","(the) witness","يُضَآرَّ كَاتِبٌۭ وَلَا","وَإِن تَفْعَلُوا۟ فَإِنَّهُۥ",214],["2:283:23",49,"ٱلشَّهَـٰدَةَ ۚ","the evidence","رَبَّهُۥ ۗ وَلَا تَكْتُمُوا۟","وَمَن يَكْتُمْهَا فَإِنَّهُۥٓ",446],["3:18:1",52,"شَهِدَ","Bears witness","","ٱللَّهُ أَنَّهُۥ لَآ",263],["3:52:18",56,"وَٱشْهَدْ","and bear witness","ٱللَّهِ ءَامَنَّا بِٱللَّهِ","بِأَنَّا مُسْلِمُونَ",263],["3:53:9",57,"ٱلشَّـٰهِدِينَ","the witnesses","ٱلرَّسُولَ فَٱكْتُبْنَا مَعَ","",481],["3:64:29",58,"ٱشْهَدُوا۟","Bear witness","فَإِن تَوَلَّوْا۟ فَقُولُوا۟","بِأَنَّا مُسْلِمُونَ",263],["3:70:8",58,"تَشْهَدُونَ","bear witness","بِـَٔايَـٰتِ ٱللَّهِ وَأَنتُمْ","",263],["3:81:29",60,"فَٱشْهَدُوا۟","Then bear witness","قَالُوٓا۟ أَقْرَرْنَا ۚ قَالَ","وَأَنَا۠ مَعَكُم مِّنَ",263],["3:81:33",60,"ٱلشَّـٰهِدِينَ","the witnesses","وَأَنَا۠ مَعَكُم مِّنَ","",481],["3:86:8",61,"وَشَهِدُوٓا۟","and (had) witnessed","كَفَرُوا۟ بَعْدَ إِيمَـٰنِهِمْ","أَنَّ ٱلرَّسُولَ حَقٌّۭ",263],["3:98:9",62,"شَهِيدٌ","(is) a Witness","بِـَٔايَـٰتِ ٱللَّهِ وَٱللَّهُ","عَلَىٰ مَا تَعْمَلُونَ",214],["3:99:14",62,"شُهَدَآءُ ۗ","(are) witnesses","تَبْغُونَهَا عِوَجًۭا وَأَنتُمْ","وَمَا ٱللَّهُ بِغَـٰفِلٍ",214],["3:140:20",67,"شُهَدَآءَ ۗ","martyrs","ءَامَنُوا۟ وَيَتَّخِذَ مِنكُمْ","وَٱللَّهُ لَا يُحِبُّ",214],["4:6:33",77,"فَأَشْهِدُوا۟","then take witnesses","دَفَعْتُمْ إِلَيْهِمْ أَمْوَٰلَهُمْ","عَلَيْهِمْ ۚ وَكَفَىٰ بِٱللَّهِ",1032],["4:15:6",80,"فَٱسْتَشْهِدُوا۟","then call to witness","ٱلْفَـٰحِشَةَ مِن نِّسَآئِكُمْ","عَلَيْهِنَّ أَرْبَعَةًۭ مِّنكُمْ ۖ",2843],["4:15:11",80,"شَهِدُوا۟","they testify","أَرْبَعَةًۭ مِّنكُمْ ۖ فَإِن","فَأَمْسِكُوهُنَّ فِى ٱلْبُيُوتِ",263],["4:33:19",83,"شَهِيدًا","a Witness","عَلَىٰ كُلِّ شَىْءٍۢ","",214],["4:41:7",85,"بِشَهِيدٍۢ","a witness","مِن كُلِّ أُمَّةٍۭ","وَجِئْنَا بِكَ عَلَىٰ",214],["4:41:12",85,"شَهِيدًۭا","(as) a witness","بِكَ عَلَىٰ هَـٰٓؤُلَآءِ","",214],["4:69:14",89,"وَٱلشُّهَدَآءِ","and the martyrs","مِّنَ ٱلنَّبِيِّـۧنَ وَٱلصِّدِّيقِينَ","وَٱلصَّـٰلِحِينَ ۚ وَحَسُنَ أُو۟لَـٰٓئِكَ",214],["4:72:17",89,"شَهِيدًۭا","present","لَمْ أَكُن مَّعَهُمْ","",214],["4:79:18",90,"شَهِيدًۭا","(as) a Witness","رَسُولًۭا ۚ وَكَفَىٰ بِٱللَّهِ","",214],["4:135:7",100,"شُهَدَآءَ","(as) witnesses","كُونُوا۟ قَوَّٰمِينَ بِٱلْقِسْطِ","لِلَّهِ وَلَوْ عَلَىٰٓ",214],["4:159:14",103,"شَهِيدًۭا","a witness","ٱلْقِيَـٰمَةِ يَكُونُ عَلَيْهِمْ","",214],["4:166:3",104,"يَشْهَدُ","bears witness","لَّـٰكِنِ ٱللَّهُ","بِمَآ أَنزَلَ إِلَيْكَ ۖ",263],["4:166:10",104,"يَشْهَدُونَ ۚ","bear witness","أَنزَلَهُۥ بِعِلْمِهِۦ ۖ وَٱلْمَلَـٰٓئِكَةُ","وَكَفَىٰ بِٱللَّهِ شَهِيدًا",263],["4:166:13",104,"شَهِيدًا","(as) a Witness","يَشْهَدُونَ ۚ وَكَفَىٰ بِٱللَّهِ","",214],["5:8:7",108,"شُهَدَآءَ","(as) witnesses","كُونُوا۟ قَوَّٰمِينَ لِلَّهِ","بِٱلْقِسْطِ ۖ وَلَا يَجْرِمَنَّكُمْ",214],["5:44:23",115,"شُهَدَآءَ ۚ","witnesses","ٱللَّهِ وَكَانُوا۟ عَلَيْهِ","فَلَا تَخْشَوُا۟ ٱلنَّاسَ",214],["5:83:21",121,"ٱلشَّـٰهِدِينَ","the witnesses","ءَامَنَّا فَٱكْتُبْنَا مَعَ","",481],["5:106:4",125,"شَهَـٰدَةُ","(Take) testimony","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","بَيْنِكُمْ إِذَا حَضَرَ",446],["5:106:46",125,"شَهَـٰدَةَ","testimony","قُرْبَىٰ ۙ وَلَا نَكْتُمُ","ٱللَّهِ إِنَّآ إِذًۭا",446],["5:107:17",125,"لَشَهَـٰدَتُنَآ","Surely our testimony","ٱلْأَوْلَيَـٰنِ فَيُقْسِمَانِ بِٱللَّهِ","أَحَقُّ مِن شَهَـٰدَتِهِمَا",446],["5:107:20",125,"شَهَـٰدَتِهِمَا","testimony of the other two","لَشَهَـٰدَتُنَآ أَحَقُّ مِن","وَمَا ٱعْتَدَيْنَآ إِنَّآ",446],["5:108:5",125,"بِٱلشَّهَـٰدَةِ","the testimony","أَدْنَىٰٓ أَن يَأْتُوا۟","عَلَىٰ وَجْهِهَآ أَوْ",446],["5:111:11",126,"وَٱشْهَدْ","and bear witness","وَبِرَسُولِى قَالُوٓا۟ ءَامَنَّا","بِأَنَّنَا مُسْلِمُونَ",263],["5:113:15",126,"ٱلشَّـٰهِدِينَ","the witnesses","وَنَكُونَ عَلَيْهَا مِنَ","",481],["5:117:15",127,"شَهِيدًۭا","a witness","وَرَبَّكُمْ ۚ وَكُنتُ عَلَيْهِمْ","مَّا دُمْتُ فِيهِمْ ۖ",214],["5:117:29",127,"شَهِيدٌ","a Witness","عَلَىٰ كُلِّ شَىْءٍۢ","",214],["6:19:5",130,"شَهَـٰدَةًۭ ۖ","(as) a testimony","أَىُّ شَىْءٍ أَكْبَرُ","قُلِ ٱللَّهُ ۖ شَهِيدٌۢ",446],["6:19:8",130,"شَهِيدٌۢ","(is) Witness","شَهَـٰدَةًۭ ۖ قُلِ ٱللَّهُ ۖ","بَيْنِى وَبَيْنَكُمْ ۚ وَأُوحِىَ",214],["6:19:20",130,"لَتَشْهَدُونَ","testify","وَمَنۢ بَلَغَ ۚ أَئِنَّكُمْ","أَنَّ مَعَ ٱللَّهِ",263],["6:19:28",130,"أَشْهَدُ ۚ","(do) I testify","أُخْرَىٰ ۚ قُل لَّآ","قُلْ إِنَّمَا هُوَ",263],["6:73:21",136,"وَٱلشَّهَـٰدَةِ ۚ","and the seen","ٱلصُّورِ ۚ عَـٰلِمُ ٱلْغَيْبِ","وَهُوَ ٱلْحَكِيمُ ٱلْخَبِيرُ",446],["6:130:16",144,"شَهِدْنَا","We bear witness","يَوْمِكُمْ هَـٰذَا ۚ قَالُوا۟","عَلَىٰٓ أَنفُسِنَا ۖ وَغَرَّتْهُمُ",263],["6:130:22",144,"وَشَهِدُوا۟","and they will bear witness","وَغَرَّتْهُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا","عَلَىٰٓ أَنفُسِهِمْ أَنَّهُمْ",263],["6:144:19",147,"شُهَدَآءَ","witnesses","ٱلْأُنثَيَيْنِ ۖ أَمْ كُنتُمْ","إِذْ وَصَّىٰكُمُ ٱللَّهُ",214],["6:150:3",148,"شُهَدَآءَكُمُ","your witnesses","قُلْ هَلُمَّ","ٱلَّذِينَ يَشْهَدُونَ أَنَّ",214],["6:150:5",148,"يَشْهَدُونَ","testify","هَلُمَّ شُهَدَآءَكُمُ ٱلَّذِينَ","أَنَّ ٱللَّهَ حَرَّمَ",263],["6:150:11",148,"شَهِدُوا۟","they testify","حَرَّمَ هَـٰذَا ۖ فَإِن","فَلَا تَشْهَدْ مَعَهُمْ ۚ",263],["6:150:13",148,"تَشْهَدْ","testify","فَإِن شَهِدُوا۟ فَلَا","مَعَهُمْ ۚ وَلَا تَتَّبِعْ",263],["7:37:32",154,"وَشَهِدُوا۟","and they (will) testify","قَالُوا۟ ضَلُّوا۟ عَنَّا","عَلَىٰٓ أَنفُسِهِمْ أَنَّهُمْ",263],["7:172:10",173,"وَأَشْهَدَهُمْ","and made them testify","مِن ظُهُورِهِمْ ذُرِّيَّتَهُمْ","عَلَىٰٓ أَنفُسِهِمْ أَلَسْتُ",1032],["7:172:17",173,"شَهِدْنَآ ۛ","we have testified","بِرَبِّكُمْ ۖ قَالُوا۟ بَلَىٰ ۛ","أَن تَقُولُوا۟ يَوْمَ",263],["9:17:8",189,"شَـٰهِدِينَ","(while) witnessing","يَعْمُرُوا۟ مَسَـٰجِدَ ٱللَّهِ","عَلَىٰٓ أَنفُسِهِم بِٱلْكُفْرِ ۚ",481],["9:94:26",202,"وَٱلشَّهَـٰدَةِ","and the seen","إِلَىٰ عَـٰلِمِ ٱلْغَيْبِ","فَيُنَبِّئُكُم بِمَا كُنتُمْ",446],["9:105:12",203,"وَٱلشَّهَـٰدَةِ","and the seen","إِلَىٰ عَـٰلِمِ ٱلْغَيْبِ","فَيُنَبِّئُكُم بِمَا كُنتُمْ",446],["9:107:22",204,"يَشْهَدُ","bears witness","إِلَّا ٱلْحُسْنَىٰ ۖ وَٱللَّهُ","إِنَّهُمْ لَكَـٰذِبُونَ",263],["10:29:3",212,"شَهِيدًۢا","(as) a witness","فَكَفَىٰ بِٱللَّهِ","بَيْنَنَا وَبَيْنَكُمْ إِن",214],["10:46:12",214,"شَهِيدٌ","(is) a Witness","مَرْجِعُهُمْ ثُمَّ ٱللَّهُ","عَلَىٰ مَا يَفْعَلُونَ",214],["10:61:17",215,"شُهُودًا","witnesses","إِلَّا كُنَّا عَلَيْكُمْ","إِذْ تُفِيضُونَ فِيهِ ۚ",481],["11:17:8",223,"شَاهِدٌۭ","a witness","مِّن رَّبِّهِۦ وَيَتْلُوهُ","مِّنْهُ وَمِن قَبْلِهِۦ",481],["11:18:13",223,"ٱلْأَشْهَـٰدُ","the witnesses","عَلَىٰ رَبِّهِمْ وَيَقُولُ","هَـٰٓؤُلَآءِ ٱلَّذِينَ كَذَبُوا۟",481],["11:54:10",228,"أُشْهِدُ","[I] call Allah to witness","بِسُوٓءٍۢ ۗ قَالَ إِنِّىٓ","ٱللَّهَ وَٱشْهَدُوٓا۟ أَنِّى",1032],["11:54:12",228,"وَٱشْهَدُوٓا۟","and (you) bear witness","إِنِّىٓ أُشْهِدُ ٱللَّهَ","أَنِّى بَرِىٓءٌۭ مِّمَّا",263],["11:103:16",233,"مَّشْهُودٌۭ","witnessed","ٱلنَّاسُ وَذَٰلِكَ يَوْمٌۭ","",1876],["12:26:6",238,"وَشَهِدَ","And testified","رَٰوَدَتْنِى عَن نَّفْسِى ۚ","شَاهِدٌۭ مِّنْ أَهْلِهَآ",263],["12:26:7",238,"شَاهِدٌۭ","a witness","عَن نَّفْسِى ۚ وَشَهِدَ","مِّنْ أَهْلِهَآ إِن",481],["12:81:10",245,"شَهِدْنَآ","we testify","ٱبْنَكَ سَرَقَ وَمَا","إِلَّا بِمَا عَلِمْنَا",263],["13:9:3",250,"وَٱلشَّهَـٰدَةِ","and the witnessed","عَـٰلِمُ ٱلْغَيْبِ","ٱلْكَبِيرُ ٱلْمُتَعَالِ",446],["13:43:9",255,"شَهِيدًۢا","(as) a Witness","قُلْ كَفَىٰ بِٱللَّهِ","بَيْنِى وَبَيْنَكُمْ وَمَنْ",214],["16:84:6",276,"شَهِيدًۭا","a witness","مِن كُلِّ أُمَّةٍۢ","ثُمَّ لَا يُؤْذَنُ",214],["16:89:6",277,"شَهِيدًا","a witness","فِى كُلِّ أُمَّةٍۢ","عَلَيْهِم مِّنْ أَنفُسِهِمْ ۖ",214],["16:89:12",277,"شَهِيدًا","(as) a witness","أَنفُسِهِمْ ۖ وَجِئْنَا بِكَ","عَلَىٰ هَـٰٓؤُلَآءِ ۚ وَنَزَّلْنَا",214],["17:78:14",290,"مَشْهُودًۭا","ever witnessed","قُرْءَانَ ٱلْفَجْرِ كَانَ","",1876],["17:96:4",291,"شَهِيدًۢا","(as) a witness","قُلْ كَفَىٰ بِٱللَّهِ","بَيْنِى وَبَيْنَكُمْ ۚ إِنَّهُۥ",214],["18:51:2",299,"أَشْهَدتُّهُمْ","I made them witness","۞ مَّآ","خَلْقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ",1032],["19:37:9",307,"مَّشْهَدِ","(the) witnessing","لِّلَّذِينَ كَفَرُوا۟ مِن","يَوْمٍ عَظِيمٍ",3901],["21:56:13",326,"ٱلشَّـٰهِدِينَ","the witnesses","عَلَىٰ ذَٰلِكُم مِّنَ","",481],["21:61:8",327,"يَشْهَدُونَ","bear witness","أَعْيُنِ ٱلنَّاسِ لَعَلَّهُمْ","",263],["21:78:14",328,"شَـٰهِدِينَ","witness","ٱلْقَوْمِ وَكُنَّا لِحُكْمِهِمْ","",481],["22:17:22",334,"شَهِيدٌ","(is) a Witness","عَلَىٰ كُلِّ شَىْءٍۢ","",214],["22:28:1",335,"لِّيَشْهَدُوا۟","That they may witness","","مَنَـٰفِعَ لَهُمْ وَيَذْكُرُوا۟",263],["22:78:27",341,"شَهِيدًا","a witness","هَـٰذَا لِيَكُونَ ٱلرَّسُولُ","عَلَيْكُمْ وَتَكُونُوا۟ شُهَدَآءَ",214],["22:78:30",341,"شُهَدَآءَ","witnesses","شَهِيدًا عَلَيْكُمْ وَتَكُونُوا۟","عَلَى ٱلنَّاسِ ۚ فَأَقِيمُوا۟",214],["23:92:3",348,"وَٱلشَّهَـٰدَةِ","and the witnessed","عَـٰلِمِ ٱلْغَيْبِ","فَتَعَـٰلَىٰ عَمَّا يُشْرِكُونَ",446],["24:2:22",350,"وَلْيَشْهَدْ","And let witness","بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۖ","عَذَابَهُمَا طَآئِفَةٌۭ مِّنَ",263],["24:4:8",350,"شُهَدَآءَ","witnesses","لَمْ يَأْتُوا۟ بِأَرْبَعَةِ","فَٱجْلِدُوهُمْ ثَمَـٰنِينَ جَلْدَةًۭ",214],["24:4:15",350,"شَهَـٰدَةً","testimony","وَلَا تَقْبَلُوا۟ لَهُمْ","أَبَدًۭا ۚ وَأُو۟لَـٰٓئِكَ هُمُ",446],["24:6:7",350,"شُهَدَآءُ","witnesses","وَلَمْ يَكُن لَّهُمْ","إِلَّآ أَنفُسُهُمْ فَشَهَـٰدَةُ",214],["24:6:10",350,"فَشَهَـٰدَةُ","then (the) testimony","شُهَدَآءُ إِلَّآ أَنفُسُهُمْ","أَحَدِهِمْ أَرْبَعُ شَهَـٰدَٰتٍۭ",446],["24:6:13",350,"شَهَـٰدَٰتٍۭ","testimonies","فَشَهَـٰدَةُ أَحَدِهِمْ أَرْبَعُ","بِٱللَّهِ ۙ إِنَّهُۥ لَمِنَ",1704],["24:8:5",350,"تَشْهَدَ","she bears witness","عَنْهَا ٱلْعَذَابَ أَن","أَرْبَعَ شَهَـٰدَٰتٍۭ بِٱللَّهِ ۙ",263],["24:8:7",350,"شَهَـٰدَٰتٍۭ","testimonies","أَن تَشْهَدَ أَرْبَعَ","بِٱللَّهِ ۙ إِنَّهُۥ لَمِنَ",1704],["24:13:5",351,"شُهَدَآءَ ۚ","witnesses","جَآءُو عَلَيْهِ بِأَرْبَعَةِ","فَإِذْ لَمْ يَأْتُوا۟",214],["24:13:9",351,"بِٱلشُّهَدَآءِ","the witnesses","فَإِذْ لَمْ يَأْتُوا۟","فَأُو۟لَـٰٓئِكَ عِندَ ٱللَّهِ",214],["24:24:2",352,"تَشْهَدُ","will bear witness","يَوْمَ","عَلَيْهِمْ أَلْسِنَتُهُمْ وَأَيْدِيهِمْ",263],["25:72:3",366,"يَشْهَدُونَ","bear witness","وَٱلَّذِينَ لَا","ٱلزُّورَ وَإِذَا مَرُّوا۟",263],["27:32:12",379,"تَشْهَدُونِ","you are present with me","قَاطِعَةً أَمْرًا حَتَّىٰ","",263],["27:49:10",381,"شَهِدْنَا","we witnessed","لَنَقُولَنَّ لِوَلِيِّهِۦ مَا","مَهْلِكَ أَهْلِهِۦ وَإِنَّا",263],["28:44:13",391,"ٱلشَّـٰهِدِينَ","the witnesses","وَمَا كُنتَ مِنَ","",481],["28:75:5",394,"شَهِيدًۭا","a witness","مِن كُلِّ أُمَّةٍۢ","فَقُلْنَا هَاتُوا۟ بُرْهَـٰنَكُمْ",214],["29:52:6",402,"شَهِيدًۭا ۖ","(as) a Witness","بِٱللَّهِ بَيْنِى وَبَيْنَكُمْ","يَعْلَمُ مَا فِى",214],["32:6:4",415,"وَٱلشَّهَـٰدَةِ","and the witnessed","ذَٰلِكَ عَـٰلِمُ ٱلْغَيْبِ","ٱلْعَزِيزُ ٱلرَّحِيمُ",446],["33:45:5",424,"شَـٰهِدًۭا","(as) a witness","ٱلنَّبِىُّ إِنَّآ أَرْسَلْنَـٰكَ","وَمُبَشِّرًۭا وَنَذِيرًۭا",481],["33:55:30",426,"شَهِيدًا","a Witness","عَلَىٰ كُلِّ شَىْءٍۢ","",214],["34:47:17",433,"شَهِيدٌۭ","a Witness","عَلَىٰ كُلِّ شَىْءٍۢ","",214],["36:65:7",444,"وَتَشْهَدُ","and will bear witness","أَفْوَٰهِهِمْ وَتُكَلِّمُنَآ أَيْدِيهِمْ","أَرْجُلُهُم بِمَا كَانُوا۟",263],["37:150:6",451,"شَـٰهِدُونَ","(were) witnesses","ٱلْمَلَـٰٓئِكَةَ إِنَـٰثًۭا وَهُمْ","",481],["39:46:8",463,"وَٱلشَّهَـٰدَةِ","and the witnessed","وَٱلْأَرْضِ عَـٰلِمَ ٱلْغَيْبِ","أَنتَ تَحْكُمُ بَيْنَ",446],["39:69:9",466,"وَٱلشُّهَدَآءِ","and the witnesses","ٱلْكِتَـٰبُ وَجِا۟ىٓءَ بِٱلنَّبِيِّـۧنَ","وَقُضِىَ بَيْنَهُم بِٱلْحَقِّ",214],["40:51:11",473,"ٱلْأَشْهَـٰدُ","the witnesses","ٱلدُّنْيَا وَيَوْمَ يَقُومُ","",481],["41:20:5",478,"شَهِدَ","(will) testify","إِذَا مَا جَآءُوهَا","عَلَيْهِمْ سَمْعُهُمْ وَأَبْصَـٰرُهُمْ",263],["41:21:4",479,"شَهِدتُّمْ","you testify","وَقَالُوا۟ لِجُلُودِهِمْ لِمَ","عَلَيْنَا ۖ قَالُوٓا۟ أَنطَقَنَا",263],["41:22:5",479,"يَشْهَدَ","testify","كُنتُمْ تَسْتَتِرُونَ أَن","عَلَيْكُمْ سَمْعُكُمْ وَلَآ",263],["41:47:28",482,"شَهِيدٍۢ","witness","مَا مِنَّا مِن","",214],["41:53:19",482,"شَهِيدٌ","a Witness","عَلَىٰ كُلِّ شَىْءٍۢ","",214],["43:19:8",490,"أَشَهِدُوا۟","Did they witness","عِبَـٰدُ ٱلرَّحْمَـٰنِ إِنَـٰثًا ۚ","خَلْقَهُمْ ۚ سَتُكْتَبُ شَهَـٰدَتُهُمْ",263],["43:19:11",490,"شَهَـٰدَتُهُمْ","their testimony","أَشَهِدُوا۟ خَلْقَهُمْ ۚ سَتُكْتَبُ","وَيُسْـَٔلُونَ",446],["43:86:10",495,"شَهِدَ","testifies","ٱلشَّفَـٰعَةَ إِلَّا مَن","بِٱلْحَقِّ وَهُمْ يَعْلَمُونَ",263],["46:8:20",503,"شَهِيدًۢا","(as) a Witness","فِيهِ ۖ كَفَىٰ بِهِۦ","بَيْنِى وَبَيْنَكُمْ ۖ وَهُوَ",214],["46:10:10",503,"وَشَهِدَ","and testifies","ٱللَّهِ وَكَفَرْتُم بِهِۦ","شَاهِدٌۭ مِّنۢ بَنِىٓ",263],["46:10:11",503,"شَاهِدٌۭ","a witness","وَكَفَرْتُم بِهِۦ وَشَهِدَ","مِّنۢ بَنِىٓ إِسْرَٰٓءِيلَ",481],["48:8:3",511,"شَـٰهِدًۭا","(as) a witness","إِنَّآ أَرْسَلْنَـٰكَ","وَمُبَشِّرًۭا وَنَذِيرًۭا",481],["48:28:14",514,"شَهِيدًۭا","(as) a Witness","كُلِّهِۦ ۚ وَكَفَىٰ بِٱللَّهِ","",214],["50:21:6",519,"وَشَهِيدٌۭ","and a witness","نَفْسٍۢ مَّعَهَا سَآئِقٌۭ","",214],["50:37:13",520,"شَهِيدٌۭ","(is) a witness","أَلْقَى ٱلسَّمْعَ وَهُوَ","",214],["57:19:8",540,"وَٱلشُّهَدَآءُ","and the martyrs","أُو۟لَـٰٓئِكَ هُمُ ٱلصِّدِّيقُونَ ۖ","عِندَ رَبِّهِمْ لَهُمْ",214],["58:6:15",542,"شَهِيدٌ","a Witness","عَلَىٰ كُلِّ شَىْءٍۢ","",214],["59:11:26",547,"يَشْهَدُ","bears witness","قُوتِلْتُمْ لَنَنصُرَنَّكُمْ وَٱللَّهُ","إِنَّهُمْ لَكَـٰذِبُونَ",263],["59:22:10",548,"وَٱلشَّهَـٰدَةِ ۖ","and the witnessed","هُوَ ۖ عَـٰلِمُ ٱلْغَيْبِ","هُوَ ٱلرَّحْمَـٰنُ ٱلرَّحِيمُ",446],["62:8:14",553,"وَٱلشَّهَـٰدَةِ","and the witnessed","إِلَىٰ عَـٰلِمِ ٱلْغَيْبِ","فَيُنَبِّئُكُم بِمَا كُنتُمْ",446],["63:1:5",554,"نَشْهَدُ","We testify","جَآءَكَ ٱلْمُنَـٰفِقُونَ قَالُوا۟","إِنَّكَ لَرَسُولُ ٱللَّهِ ۗ",263],["63:1:14",554,"يَشْهَدُ","testifies","إِنَّكَ لَرَسُولُهُۥ وَٱللَّهُ","إِنَّ ٱلْمُنَـٰفِقِينَ لَكَـٰذِبُونَ",263],["64:18:3",557,"وَٱلشَّهَـٰدَةِ","and the witnessed","عَـٰلِمُ ٱلْغَيْبِ","ٱلْعَزِيزُ ٱلْحَكِيمُ",446],["65:2:9",558,"وَأَشْهِدُوا۟","And take witness","أَوْ فَارِقُوهُنَّ بِمَعْرُوفٍۢ","ذَوَىْ عَدْلٍۢ مِّنكُمْ",1032],["65:2:14",558,"ٱلشَّهَـٰدَةَ","the testimony","عَدْلٍۢ مِّنكُمْ وَأَقِيمُوا۟","لِلَّهِ ۚ ذَٰلِكُمْ يُوعَظُ",446],["70:33:3",569,"بِشَهَـٰدَٰتِهِمْ","in their testimonies","وَٱلَّذِينَ هُم","قَآئِمُونَ",1704],["73:15:5",574,"شَـٰهِدًا","(as) a witness","أَرْسَلْنَآ إِلَيْكُمْ رَسُولًۭا","عَلَيْكُمْ كَمَآ أَرْسَلْنَآ",481],["74:13:2",575,"شُهُودًۭا","present","وَبَنِينَ","",481],["83:21:1",588,"يَشْهَدُهُ","Witness it","","ٱلْمُقَرَّبُونَ",263],["85:3:1",590,"وَشَاهِدٍۢ","And (the) witness","","وَمَشْهُودٍۢ",481],["85:3:2",590,"وَمَشْهُودٍۢ","and what is witnessed","وَشَاهِدٍۢ","",1876],["85:7:6",590,"شُهُودٌۭ","witnesses","مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ","",481],["85:9:10",590,"شَهِيدٌ","(is) a Witness","عَلَىٰ كُلِّ شَىْءٍۢ","",214],["100:7:4",600,"لَشَهِيدٌۭ","surely (is) a witness","وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ","",214]]