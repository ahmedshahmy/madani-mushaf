[["2:51:5",8,"لَيْلَةًۭ","nights","وَٰعَدْنَا مُوسَىٰٓ أَرْبَعِينَ","ثُمَّ ٱتَّخَذْتُمُ ٱلْعِجْلَ",982],["2:164:7",25,"ٱلَّيْلِ","of the night","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَـٰفِ","وَٱلنَّهَارِ وَٱلْفُلْكِ ٱلَّتِى",132],["2:187:3",29,"لَيْلَةَ","(in the) nights","أُحِلَّ لَكُمْ","ٱلصِّيَامِ ٱلرَّفَثُ إِلَىٰ",982],["2:187:47",29,"ٱلَّيْلِ ۚ","the night","أَتِمُّوا۟ ٱلصِّيَامَ إِلَى","وَلَا تُبَـٰشِرُوهُنَّ وَأَنتُمْ",132],["2:274:4",46,"بِٱلَّيْلِ","by night","ٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُم","وَٱلنَّهَارِ سِرًّۭا وَعَلَانِيَةًۭ",132],["3:27:2",53,"ٱلَّيْلَ","the night","تُولِجُ","فِى ٱلنَّهَارِ وَتُولِجُ",132],["3:27:8",53,"ٱلَّيْلِ ۖ","the night","وَتُولِجُ ٱلنَّهَارَ فِى","وَتُخْرِجُ ٱلْحَىَّ مِنَ",132],["3:113:12",64,"ٱلَّيْلِ","(of) the night","ءَايَـٰتِ ٱللَّهِ ءَانَآءَ","وَهُمْ يَسْجُدُونَ",132],["3:190:7",75,"ٱلَّيْلِ","(of) the night","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَـٰفِ","وَٱلنَّهَارِ لَـَٔايَـٰتٍۢ لِّأُو۟لِى",132],["6:13:5",129,"ٱلَّيْلِ","the night","مَا سَكَنَ فِى","وَٱلنَّهَارِ ۚ وَهُوَ ٱلسَّمِيعُ",132],["6:60:4",135,"بِٱلَّيْلِ","by the night","وَهُوَ ٱلَّذِى يَتَوَفَّىٰكُم","وَيَعْلَمُ مَا جَرَحْتُم",132],["6:76:4",137,"ٱلَّيْلُ","the night","فَلَمَّا جَنَّ عَلَيْهِ","رَءَا كَوْكَبًۭا ۖ قَالَ",132],["6:96:4",140,"ٱلَّيْلَ","the night","فَالِقُ ٱلْإِصْبَاحِ وَجَعَلَ","سَكَنًۭا وَٱلشَّمْسَ وَٱلْقَمَرَ",132],["7:54:16",157,"ٱلَّيْلَ","the night","عَلَى ٱلْعَرْشِ يُغْشِى","ٱلنَّهَارَ يَطْلُبُهُۥ حَثِيثًۭا",132],["7:142:4",167,"لَيْلَةًۭ","nights","۞ وَوَٰعَدْنَا مُوسَىٰ ثَلَـٰثِينَ","وَأَتْمَمْنَـٰهَا بِعَشْرٍۢ فَتَمَّ",982],["7:142:11",167,"لَيْلَةًۭ ۚ","night(s)","مِيقَـٰتُ رَبِّهِۦٓ أَرْبَعِينَ","وَقَالَ مُوسَىٰ لِأَخِيهِ",982],["10:6:4",208,"ٱلَّيْلِ","(of) the night","إِنَّ فِى ٱخْتِلَـٰفِ","وَٱلنَّهَارِ وَمَا خَلَقَ",132],["10:24:30",211,"لَيْلًا","(by) night","عَلَيْهَآ أَتَىٰهَآ أَمْرُنَا","أَوْ نَهَارًۭا فَجَعَلْنَـٰهَا",132],["10:27:20",212,"ٱلَّيْلِ","the darkness (of) night","وُجُوهُهُمْ قِطَعًۭا مِّنَ","مُظْلِمًا ۚ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ",132],["10:67:5",216,"ٱلَّيْلَ","the night","ٱلَّذِى جَعَلَ لَكُمُ","لِتَسْكُنُوا۟ فِيهِ وَٱلنَّهَارَ",132],["11:81:13",230,"ٱلَّيْلِ","the night","بِأَهْلِكَ بِقِطْعٍۢ مِّنَ","وَلَا يَلْتَفِتْ مِنكُمْ",132],["11:114:7",234,"ٱلَّيْلِ ۚ","the night","ٱلنَّهَارِ وَزُلَفًۭا مِّنَ","إِنَّ ٱلْحَسَنَـٰتِ يُذْهِبْنَ",132],["13:3:17",249,"ٱلَّيْلَ","the night","زَوْجَيْنِ ٱثْنَيْنِ ۖ يُغْشِى","ٱلنَّهَارَ ۚ إِنَّ فِى",132],["13:10:12",250,"بِٱلَّيْلِ","by night","وَمَنْ هُوَ مُسْتَخْفٍۭ","وَسَارِبٌۢ بِٱلنَّهَارِ",132],["14:33:8",259,"ٱلَّيْلَ","the night","دَآئِبَيْنِ ۖ وَسَخَّرَ لَكُمُ","وَٱلنَّهَارَ",132],["15:65:5",265,"ٱلَّيْلِ","the night","بِأَهْلِكَ بِقِطْعٍۢ مِّنَ","وَٱتَّبِعْ أَدْبَـٰرَهُمْ وَلَا",132],["16:12:3",268,"ٱلَّيْلَ","the night","وَسَخَّرَ لَكُمُ","وَٱلنَّهَارَ وَٱلشَّمْسَ وَٱلْقَمَرَ ۖ",132],["17:1:5",282,"لَيْلًۭا","(by) night","ٱلَّذِىٓ أَسْرَىٰ بِعَبْدِهِۦ","مِّنَ ٱلْمَسْجِدِ ٱلْحَرَامِ",132],["17:12:2",283,"ٱلَّيْلَ","the night","وَجَعَلْنَا","وَٱلنَّهَارَ ءَايَتَيْنِ ۖ فَمَحَوْنَآ",132],["17:12:7",283,"ٱلَّيْلِ","(of) the night","ءَايَتَيْنِ ۖ فَمَحَوْنَآ ءَايَةَ","وَجَعَلْنَآ ءَايَةَ ٱلنَّهَارِ",132],["17:78:7",290,"ٱلَّيْلِ","(of) the night","ٱلشَّمْسِ إِلَىٰ غَسَقِ","وَقُرْءَانَ ٱلْفَجْرِ ۖ إِنَّ",132],["17:79:2",290,"ٱلَّيْلِ","the night","وَمِنَ","فَتَهَجَّدْ بِهِۦ نَافِلَةًۭ",132],["19:10:12",305,"لَيَالٍۢ","nights","تُكَلِّمَ ٱلنَّاسَ ثَلَـٰثَ","سَوِيًّۭا",132],["20:130:15",321,"ٱلَّيْلِ","(of) the night","غُرُوبِهَا ۖ وَمِنْ ءَانَآئِ","فَسَبِّحْ وَأَطْرَافَ ٱلنَّهَارِ",132],["21:20:2",323,"ٱلَّيْلَ","[the] night","يُسَبِّحُونَ","وَٱلنَّهَارَ لَا يَفْتُرُونَ",132],["21:33:4",324,"ٱلَّيْلَ","the night","وَهُوَ ٱلَّذِى خَلَقَ","وَٱلنَّهَارَ وَٱلشَّمْسَ وَٱلْقَمَرَ ۖ",132],["21:42:4",325,"بِٱلَّيْلِ","in the night","قُلْ مَن يَكْلَؤُكُم","وَٱلنَّهَارِ مِنَ ٱلرَّحْمَـٰنِ ۗ",132],["22:61:5",339,"ٱلَّيْلَ","the night","بِأَنَّ ٱللَّهَ يُولِجُ","فِى ٱلنَّهَارِ وَيُولِجُ",132],["22:61:11",339,"ٱلَّيْلِ","the night","وَيُولِجُ ٱلنّ