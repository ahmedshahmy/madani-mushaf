كَوِّرُ ٱلنَّهَارَ عَلَى","وَسَخَّرَ ٱلشَّمْسَ وَٱلْقَمَرَ ۖ",132],["39:9:5",459,"ٱلَّيْلِ","(of) the night","هُوَ قَـٰنِتٌ ءَانَآءَ","سَاجِدًۭا وَقَآئِمًۭا يَحْذَرُ",132],["40:61:5",474,"ٱلَّيْلَ","the night","ٱلَّذِى جَعَلَ لَكُمُ","لِتَسْكُنُوا۟ فِيهِ وَٱلنَّهَارَ",132],["41:37:3",480,"ٱلَّيْلُ","(are) the night","وَمِنْ ءَايَـٰتِهِ","وَٱلنَّهَارُ وَٱلشَّمْسُ وَٱلْقَمَرُ ۚ",132],["41:38:8",480,"بِٱلَّيْلِ","by night","رَبِّكَ يُسَبِّحُونَ لَهُۥ","وَٱلنَّهَارِ وَهُمْ لَا",132],["44:3:4",496,"لَيْلَةٍۢ","a Night","إِنَّآ أَنزَلْنَـٰهُ فِى","مُّبَـٰرَكَةٍ ۚ إِنَّا كُنَّا",982],["44:23:3",497,"لَيْلًا","(by) night","فَأَسْرِ بِعِبَادِى","إِنَّكُم مُّتَّبَعُونَ",132],["45:5:2",499,"ٱلَّيْلِ","(of) the night","وَٱخْتِلَـٰفِ","وَٱلنَّهَارِ وَمَآ أَنزَلَ",132],["50:40:2",520,"ٱلَّيْلِ","the night","وَمِنَ","فَسَبِّحْهُ وَأَدْبَـٰرَ ٱلسُّجُودِ",132],["51:17:4",521,"ٱلَّيْلِ","the night","كَانُوا۟ قَلِيلًۭا مِّنَ","مَا يَهْجَعُونَ",132],["52:49:2",525,"ٱلَّيْلِ","the night","وَمِنَ","فَسَبِّحْهُ وَإِدْبَـٰرَ ٱلنُّجُومِ",132],["57:6:2",538,"ٱلَّيْلَ","the night","يُولِجُ","فِى ٱلنَّهَارِ وَيُولِجُ",132],["57:6:8",538,"ٱلَّيْلِ ۚ","the night","وَيُولِجُ ٱلنَّهَارَ فِى","وَهُوَ عَلِيمٌۢ بِذَاتِ",132],["69:7:4",566,"لَيَالٍۢ","nights","سَخَّرَهَا عَلَيْهِمْ سَبْعَ","وَثَمَـٰنِيَةَ أَيَّامٍ حُسُومًۭا",132],["71:5:6",570,"لَيْلًۭا","night","إِنِّى دَعَوْتُ قَوْمِى","وَنَهَارًۭا",132],["73:2:2",574,"ٱلَّيْلَ","(in) the night","قُمِ","إِلَّا قَلِيلًۭا",132],["73:6:3",574,"ٱلَّيْلِ","(at) the night","إِنَّ نَاشِئَةَ","هِىَ أَشَدُّ وَطْـًۭٔا",132],["73:20:9",575,"ٱلَّيْلِ","(of) the night","أَدْنَىٰ مِن ثُلُثَىِ","وَنِصْفَهُۥ وَثُلُثَهُۥ وَطَآئِفَةٌۭ",132],["73:20:18",575,"ٱلَّيْلَ","the night","مَعَكَ ۚ وَٱللَّهُ يُقَدِّرُ","وَٱلنَّهَارَ ۚ عَلِمَ أَن",132],["74:33:1",576,"وَٱلَّيْلِ","And the night","","إِذْ أَدْبَرَ",132],["76:26:2",580,"ٱلَّيْلِ","the night","وَمِنَ","فَٱسْجُدْ لَهُۥ وَسَبِّحْهُ",132],["76:26:6",580,"لَيْلًۭا","a night","فَٱسْجُدْ لَهُۥ وَسَبِّحْهُ","طَوِيلًا",132],["78:10:2",582,"ٱلَّيْلَ","the night","وَجَعَلْنَا","لِبَاسًۭا",132],["79:29:2",584,"لَيْلَهَا","its night","وَأَغْطَشَ","وَأَخْرَجَ ضُحَىٰهَا",132],["81:17:1",586,"وَٱلَّيْلِ","And the night","","إِذَا عَسْعَسَ",132],["84:17:1",589,"وَٱلَّيْلِ","And the night","","وَمَا وَسَقَ",132],["89:2:1",593,"وَلَيَالٍ","And the nights","","عَشْرٍۢ",132],["89:4:1",593,"وَٱلَّيْلِ","And the night","","إِذَا يَسْرِ",132],["91:4:1",595,"وَٱلَّيْلِ","And the night","","إِذَا يَغْشَىٰهَا",132],["92:1:1",595,"وَٱلَّيْلِ","By the night","","إِذَا يَغْشَىٰ",132],["93:2:1",596,"وَٱلَّيْلِ","And the night","","إِذَا سَجَىٰ",132],["97:1:4",598,"لَيْلَةِ","(the) Night","إِنَّآ أَنزَلْنَـٰهُ فِى","ٱلْقَدْرِ",982],["97:2:4",598,"لَيْلَةُ","(the) Night","وَمَآ أَدْرَىٰكَ مَا","ٱلْقَدْرِ",982],["97:3:1",598,"لَيْلَةُ","(The) Night","","ٱلْقَدْرِ خَيْرٌۭ مِّنْ",982]]