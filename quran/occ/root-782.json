[["3:153:18",69,"فَاتَكُمْ","escaped you","تَحْزَنُوا۟ عَلَىٰ مَا","وَلَا مَآ أَصَـٰبَكُمْ ۗ",1825],["34:51:6",434,"فَوْتَ","escape","إِذْ فَزِعُوا۟ فَلَا","وَأُخِذُوا۟ مِن مَّكَانٍۢ",3431],["57:23:5",540,"فَاتَكُمْ","has escaped you","تَأْسَوْا۟ عَلَىٰ مَا","وَلَا تَفْرَحُوا۟ بِمَآ",1825],["60:11:2",550,"فَاتَكُمْ","have gone from you","وَإِن","شَىْءٌۭ مِّنْ أَزْوَٰجِكُمْ",1825],["67:3:12",562,"تَفَـٰوُتٍۢ ۖ","fault","خَلْقِ ٱلرَّحْمَـٰنِ مِن","فَٱرْجِعِ ٱلْبَصَرَ هَلْ",4365]]