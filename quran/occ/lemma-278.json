[["4:30:6",83,"فَسَوْفَ","then soon","ذَٰلِكَ عُدْوَٰنًۭا وَظُلْمًۭا","نُصْلِيهِ نَارًۭا ۚ وَكَانَ",278],["4:56:5",87,"سَوْفَ","soon","ٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا","نُصْلِيهِمْ نَارًۭا كُلَّمَا",278],["4:74:18",89,"فَسَوْفَ","then soon","فَيُقْتَلْ أَوْ يَغْلِبْ","نُؤْتِيهِ أَجْرًا عَظِيمًۭا",278],["4:114:23",97,"فَسَوْفَ","then soon","ٱبْتِغَآءَ مَرْضَاتِ ٱللَّهِ","نُؤْتِيهِ أَجْرًا عَظِيمًۭا",278],["4:146:13",101,"وَسَوْفَ","And soon","فَأُو۟لَـٰٓئِكَ مَعَ ٱلْمُؤْمِنِينَ ۖ","يُؤْتِ ٱللَّهُ ٱلْمُؤْمِنِينَ",278],["4:152:11",102,"سَوْفَ","soon","أَحَدٍۢ مِّنْهُمْ أُو۟لَـٰٓئِكَ","يُؤْتِيهِمْ أُجُورَهُمْ ۗ وَكَانَ",278],["5:14:20",110,"وَسَوْفَ","And soon","إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ ۚ","يُنَبِّئُهُمُ ٱللَّهُ بِمَا",278],["5:54:9",117,"فَسَوْفَ","then soon","مِنكُمْ عَن دِينِهِۦ","يَأْتِى ٱللَّهُ بِقَوْمٍۢ",278],["6:5:6",128,"فَسَوْفَ","but soon","بِٱلْحَقِّ لَمَّا جَآءَهُمْ ۖ","يَأْتِيهِمْ أَنۢبَـٰٓؤُا۟ مَا",278],["6:67:4",135,"وَسَوْفَ","and soon","لِّكُلِّ نَبَإٍۢ مُّسْتَقَرٌّۭ ۚ","تَعْلَمُونَ",278],["6:135:8",145,"فَسَوْفَ","And soon","مَكَانَتِكُمْ إِنِّى عَامِلٌۭ ۖ","تَعْلَمُونَ مَن تَكُونُ",278],["7:123:18",165,"فَسَوْفَ","But soon","لِتُخْرِجُوا۟ مِنْهَآ أَهْلَهَا ۖ","تَعْلَمُونَ",278],["7:143:22",167,"فَسَوْفَ","then","فَإِنِ ٱسْتَقَرَّ مَكَانَهُۥ","تَرَىٰنِى ۚ فَلَمَّا تَجَلَّىٰ",278],["9:28:17",191,"فَسَوْفَ","then soon","وَإِنْ خِفْتُمْ عَيْلَةًۭ","يُغْنِيكُمُ ٱللَّهُ مِن",278],["11:39:1",226,"فَسَوْفَ","And soon","","تَعْلَمُونَ مَن يَأْتِيهِ",278],["11:93:7",232,"سَوْفَ","Soon","مَكَانَتِكُمْ إِنِّى عَـٰمِلٌۭ ۖ","تَعْلَمُونَ مَن يَأْتِيهِ",278],["12:98:2",247,"سَوْفَ","Soon","قَالَ","أَسْتَغْفِرُ لَكُمْ رَبِّىٓ ۖ",278],["15:3:6",262,"فَسَوْفَ","then soon","وَيَتَمَتَّعُوا۟ وَيُلْهِهِمُ ٱلْأَمَلُ ۖ","يَعْلَمُونَ",278],["15:96:7",267,"فَسَوْفَ","But soon","ٱللَّهِ إِلَـٰهًا ءَاخَرَ ۚ","يَعْلَمُونَ",278],["16:55:5",273,"فَسَوْفَ","soon","بِمَآ ءَاتَيْنَـٰهُمْ ۚ فَتَمَتَّعُوا۟ ۖ","تَعْلَمُونَ",278],["18:87:5",303,"فَسَوْفَ","then soon","أَمَّا مَن ظَلَمَ","نُعَذِّبُهُۥ ثُمَّ يُرَدُّ",278],["19:59:9",309,"فَسَوْفَ","so soon","ٱلصَّلَوٰةَ وَٱتَّبَعُوا۟ ٱلشَّهَوَٰتِ ۖ","يَلْقَوْنَ غَيًّا",278],["19:66:6",310,"لَسَوْفَ","surely will","أَءِذَا مَا مِتُّ","أُخْرَجُ حَيًّا",278],["25:42:10",363,"وَسَوْفَ","And soon","أَن صَبَرْنَا عَلَيْهَا ۚ","يَعْلَمُونَ حِينَ يَرَوْنَ",278],["25:77:10",366,"فَسَوْفَ","so soon","دُعَآؤُكُمْ ۖ فَقَدْ كَذَّبْتُمْ","يَكُونُ لِزَامًۢا",278],["26:49:13",369,"فَلَسَوْفَ","so surely soon","ٱلَّذِى عَلَّمَكُمُ ٱلسِّحْرَ","تَعْلَمُونَ ۚ لَأُقَطِّعَنَّ أَيْدِيَكُمْ",278],["29:66:5",404,"فَسَوْفَ","But soon","بِمَآ ءَاتَيْنَـٰهُمْ وَلِيَتَمَتَّعُوا۟ ۖ","يَعْلَمُونَ",278],["30:34:5",408,"فَسَوْفَ","but soon","بِمَآ ءَاتَيْنَـٰهُمْ ۚ فَتَمَتَّعُوا۟","تَعْلَمُونَ",278],["37:170:3",452,"فَسَوْفَ","so soon","فَكَفَرُوا۟ بِهِۦ ۖ","يَعْلَمُونَ",278],["37:175:2",452,"فَسَوْفَ","so soon","وَأَبْصِرْهُمْ","يُبْصِرُونَ",278],["37:179:2",452,"فَسَوْفَ","so soon","وَأَبْصِرْ","يُبْصِرُونَ",278],["39:39:8",462,"فَسَوْفَ","then soon","مَكَانَتِكُمْ إِنِّى عَـٰمِلٌۭ ۖ","تَعْلَمُونَ",278],["40:70:8",475,"فَسَوْفَ","but soon","أَرْسَلْنَا بِهِۦ رُسُلَنَا ۖ","يَعْلَمُونَ",278],["43:44:5",492,"وَسَوْفَ","and soon","لَذِكْرٌۭ لَّكَ وَلِقَوْمِكَ ۖ","تُسْـَٔلُونَ",278],["43:89:5",495,"فَسَوْفَ","But soon","عَنْهُمْ وَقُلْ سَلَـٰمٌۭ ۚ","يَعْلَمُونَ",278],["53:40:3",527,"سَوْفَ","will soon","وَأَنَّ سَعْيَهُۥ","يُرَىٰ",278],["84:8:1",589,"فَسَوْفَ","Then soon","","يُحَاسَبُ حِسَابًۭا يَسِيرًۭا",278],["84:11:1",589,"فَسَوْفَ","Then soon","","يَدْعُوا۟ ثُبُورًۭا",278],["92:21:1",596,"وَلَسَوْفَ","And soon, surely","","يَرْضَىٰ",278],["93:5:1",596,"وَلَسَوْفَ","And soon","","يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ",278],["102:3:2",600,"سَوْفَ","Soon","كَلَّا","تَعْلَمُونَ",278],["102:4:3",600,"سَوْفَ","Soon","ثُمَّ كَلَّا","تَعْلَمُونَ",278]]