[["15:14:9",262,"يَعْرُجُونَ","(to) ascend","ٱلسَّمَآءِ فَظَلُّوا۟ فِيهِ","",1427],["24:61:7",358,"ٱلْأَعْرَجِ","the lame","حَرَجٌۭ وَلَا عَلَى","حَرَجٌۭ وَلَا عَلَى",2158],["32:5:8",415,"يَعْرُجُ","it will ascend","إِلَى ٱلْأَرْضِ ثُمَّ","إِلَيْهِ فِى يَوْمٍۢ",1427],["34:2:14",428,"يَعْرُجُ","ascends","مِنَ ٱلسَّمَآءِ وَمَا","فِيهَا ۚ وَهُوَ ٱلرَّحِيمُ",1427],["43:33:15",491,"وَمَعَارِجَ","and stairways","سُقُفًۭا مِّن فِضَّةٍۢ","عَلَيْهَا يَظْهَرُونَ",2442],["48:17:7",513,"ٱلْأَعْرَجِ","the lame","حَرَجٌۭ وَلَا عَلَى","حَرَجٌۭ وَلَا عَلَى",2158],["57:4:26",538,"يَعْرُجُ","ascends","مِنَ ٱلسَّمَآءِ وَمَا","فِيهَا ۖ وَهُوَ مَعَكُمْ",1427],["70:3:4",568,"ٱلْمَعَارِجِ","(of) the ways of ascent","مِّنَ ٱللَّهِ ذِى","",2442],["70:4:1",568,"تَعْرُجُ","Ascend","","ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ",1427]]