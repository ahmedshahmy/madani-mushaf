[["7:44:20",156,"نَعَمْ ۚ","Yes","رَبُّكُمْ حَقًّۭا ۖ قَالُوا۟","فَأَذَّنَ مُؤَذِّنٌۢ بَيْنَهُمْ",1609],["7:114:2",164,"نَعَمْ","Yes","قَالَ","وَإِنَّكُمْ لَمِنَ ٱلْمُقَرَّبِينَ",1609],["26:42:2",369,"نَعَمْ","Yes","قَالَ","وَإِنَّكُمْ إِذًۭا لَّمِنَ",1609],["37:18:2",446,"نَعَمْ","Yes","قُلْ","وَأَنتُمْ دَٰخِرُونَ",1609]]