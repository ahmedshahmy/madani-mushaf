[["2:188:6",29,"وَتُدْلُوا۟","and present","أَمْوَٰلَكُم بَيْنَكُم بِٱلْبَـٰطِلِ","بِهَآ إِلَى ٱلْحُكَّامِ",2166],["12:19:5",237,"فَأَدْلَىٰ","then he let down","سَيَّارَةٌۭ فَأَرْسَلُوا۟ وَارِدَهُمْ","دَلْوَهُۥ ۖ قَالَ يَـٰبُشْرَىٰ",2166],["12:19:6",237,"دَلْوَهُۥ ۖ","his bucket","فَأَرْسَلُوا۟ وَارِدَهُمْ فَأَدْلَىٰ","قَالَ يَـٰبُشْرَىٰ هَـٰذَا",3374],["53:8:3",526,"فَتَدَلَّىٰ","and came down","ثُمَّ دَنَا","",4361]]