[["2:81:1",12,"بَلَىٰ","Yes","","مَن كَسَبَ سَيِّئَةًۭ",464],["2:112:1",17,"بَلَىٰ","Yes","","مَنْ أَسْلَمَ وَجْهَهُۥ",464],["2:260:13",44,"بَلَىٰ","Yes","أَوَلَمْ تُؤْمِن ۖ قَالَ","وَلَـٰكِن لِّيَطْمَئِنَّ قَلْبِى ۖ",464],["3:76:1",59,"بَلَىٰ","Nay","","مَنْ أَوْفَىٰ بِعَهْدِهِۦ",464],["3:125:1",66,"بَلَىٰٓ ۚ","Yes","","إِن تَصْبِرُوا۟ وَتَتَّقُوا۟",464],["6:30:12",131,"بَلَىٰ","Yes","هَـٰذَا بِٱلْحَقِّ ۚ قَالُوا۟","وَرَبِّنَا ۚ قَالَ فَذُوقُوا۟",464],["7:172:16",173,"بَلَىٰ ۛ","Yes","أَلَسْتُ بِرَبِّكُمْ ۖ قَالُوا۟","شَهِدْنَآ ۛ أَن تَقُولُوا۟",464],["16:28:13",270,"بَلَىٰٓ","Nay","نَعْمَلُ مِن سُوٓءٍۭ ۚ","إِنَّ ٱللَّهَ عَلِيمٌۢ",464],["16:38:10",271,"بَلَىٰ","Nay","ٱللَّهُ مَن يَمُوتُ ۚ","وَعْدًا عَلَيْهِ حَقًّۭا",464],["34:3:8",428,"بَلَىٰ","Nay","تَأْتِينَا ٱلسَّاعَةُ ۖ قُلْ","وَرَبِّى لَتَأْتِيَنَّكُمْ عَـٰلِمِ",464],["36:81:11",445,"بَلَىٰ","Yes, indeed","أَن يَخْلُقَ مِثْلَهُم ۚ","وَهُوَ ٱلْخَلَّـٰقُ ٱلْعَلِيمُ",464],["39:59:1",465,"بَلَىٰ","Yes","","قَدْ جَآءَتْكَ ءَايَـٰتِى",464],["39:71:28",466,"بَلَىٰ","Yes","يَوْمِكُمْ هَـٰذَا ۚ قَالُوا۟","وَلَـٰكِنْ حَقَّتْ كَلِمَةُ",464],["40:50:8",473,"بَلَىٰ ۚ","Yes","رُسُلُكُم بِٱلْبَيِّنَـٰتِ ۖ قَالُوا۟","قَالُوا۟ فَٱدْعُوا۟ ۗ وَمَا",464],["43:80:8",495,"بَلَىٰ","Nay","نَسْمَعُ سِرَّهُمْ وَنَجْوَىٰهُم ۚ","وَرُسُلُنَا لَدَيْهِمْ يَكْتُبُونَ",464],["46:33:17",506,"بَلَىٰٓ","Yes","أَن يُحْـِۧىَ ٱلْمَوْتَىٰ ۚ","إِنَّهُۥ عَلَىٰ كُلِّ",464],["46:34:11",506,"بَلَىٰ","Yes","هَـٰذَا بِٱلْحَقِّ ۖ قَالُوا۟","وَرَبِّنَا ۚ قَالَ فَذُوقُوا۟",464],["57:14:6",539,"بَلَىٰ","Yes","نَكُن مَّعَكُمْ ۖ قَالُوا۟","وَلَـٰكِنَّكُمْ فَتَنتُمْ أَنفُسَكُمْ",464],["64:7:8",556,"بَلَىٰ","Yes","لَّن يُبْعَثُوا۟ ۚ قُلْ","وَرَبِّى لَتُبْعَثُنَّ ثُمَّ",464],["67:9:2",562,"بَلَىٰ","Yes","قَالُوا۟","قَدْ جَآءَنَا نَذِيرٌۭ",464],["75:4:1",577,"بَلَىٰ","Nay","","قَـٰدِرِينَ عَلَىٰٓ أَن",464],["84:15:1",589,"بَلَىٰٓ","Yes","","إِنَّ رَبَّهُۥ كَانَ",464]]