[["2:208:7",32,"كَآفَّةًۭ","completely","ٱدْخُلُوا۟ فِى ٱلسِّلْمِ","وَلَا تَتَّبِعُوا۟ خُطُوَٰتِ",1346],["4:77:7",90,"كُفُّوٓا۟","Restrain","ٱلَّذِينَ قِيلَ لَهُمْ","أَيْدِيَكُمْ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ",979],["4:84:14",91,"يَكُفَّ","restrain","عَسَى ٱللَّهُ أَن","بَأْسَ ٱلَّذِينَ كَفَرُوا۟ ۚ",979],["4:91:21",92,"وَيَكُفُّوٓا۟","and they restrain","وَيُلْقُوٓا۟ إِلَيْكُمُ ٱلسَّلَمَ","أَيْدِيَهُمْ فَخُذُوهُمْ وَٱقْتُلُوهُمْ",979],["5:11:15",109,"فَكَفَّ","but He restrained","يَبْسُطُوٓا۟ إِلَيْكُمْ أَيْدِيَهُمْ","أَيْدِيَهُمْ عَنكُمْ ۖ وَٱتَّقُوا۟",979],["5:110:48",126,"كَفَفْتُ","I restrained","ٱلْمَوْتَىٰ بِإِذْنِى ۖ وَإِذْ","بَنِىٓ إِسْرَٰٓءِيلَ عَنكَ",979],["9:36:28",192,"كَآفَّةًۭ","all together","أَنفُسَكُمْ ۚ وَقَـٰتِلُوا۟ ٱلْمُشْرِكِينَ","كَمَا يُقَـٰتِلُونَكُمْ كَآفَّةًۭ ۚ",1346],["9:36:31",192,"كَآفَّةًۭ ۚ","all together","كَآفَّةًۭ كَمَا يُقَـٰتِلُونَكُمْ","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ",1346],["9:122:5",206,"كَآفَّةًۭ ۚ","all together","كَانَ ٱلْمُؤْمِنُونَ لِيَنفِرُوا۟","فَلَوْلَا نَفَرَ مِن",1346],["13:14:14",251,"كَفَّيْهِ","his hands","بِشَىْءٍ إِلَّا كَبَـٰسِطِ","إِلَى ٱلْمَآءِ لِيَبْلُغَ",2416],["18:42:5",298,"كَفَّيْهِ","his hands","بِثَمَرِهِۦ فَأَصْبَحَ يُقَلِّبُ","عَلَىٰ مَآ أَنفَقَ",2416],["21:39:7",325,"يَكُفُّونَ","they will avert","كَفَرُوا۟ حِينَ لَا","عَن وُجُوهِهِمُ ٱلنَّارَ",979],["34:28:4",431,"كَآفَّةًۭ","comprehensively","وَمَآ أَرْسَلْنَـٰكَ إِلَّا","لِّلنَّاسِ بَشِيرًۭا وَنَذِيرًۭا",1346],["48:20:9",513,"وَكَفَّ","and has withheld","فَعَجَّلَ لَكُمْ هَـٰذِهِۦ","أَيْدِىَ ٱلنَّاسِ عَنكُمْ",979],["48:24:3",514,"كَفَّ","withheld","وَهُوَ ٱلَّذِى","أَيْدِيَهُمْ عَنكُمْ وَأَيْدِيَكُمْ",979]]