[["2:125:3",19,"ٱلْبَيْتَ","the House","وَإِذْ جَعَلْنَا","مَثَابَةًۭ لِّلنَّاسِ وَأَمْنًۭا",182],["2:125:18",19,"بَيْتِىَ","My House","وَإِسْمَـٰعِيلَ أَن طَهِّرَا","لِلطَّآئِفِينَ وَٱلْعَـٰكِفِينَ وَٱلرُّكَّعِ",182],["2:127:6",20,"ٱلْبَيْتِ","the House","إِبْرَٰهِـۧمُ ٱلْقَوَاعِدَ مِنَ","وَإِسْمَـٰعِيلُ رَبَّنَا تَقَبَّلْ",182],["2:158:9",24,"ٱلْبَيْتَ","(of) the House","ٱللَّهِ ۖ فَمَنْ حَجَّ","أَوِ ٱعْتَمَرَ فَلَا",182],["2:189:13",29,"ٱلْبُيُوتَ","(to) the houses","ٱلْبِرُّ بِأَن تَأْتُوا۟","مِن ظُهُورِهَا وَلَـٰكِنَّ",182],["2:189:21",29,"ٱلْبُيُوتَ","(to) the houses","مَنِ ٱتَّقَىٰ ۗ وَأْتُوا۟","مِنْ أَبْوَٰبِهَا ۚ وَٱتَّقُوا۟",182],["3:49:37",56,"بُيُوتِكُمْ ۚ","your houses","وَمَا تَدَّخِرُونَ فِى","إِنَّ فِى ذَٰلِكَ",182],["3:96:3",62,"بَيْتٍۢ","House","إِنَّ أَوَّلَ","وُضِعَ لِلنَّاسِ لَلَّذِى",182],["3:97:14",62,"ٱلْبَيْتِ","(of) the House","عَلَى ٱلنَّاسِ حِجُّ","مَنِ ٱسْتَطَاعَ إِلَيْهِ",182],["3:154:55",70,"بُيُوتِكُمْ","your houses","لَّوْ كُنتُمْ فِى","لَبَرَزَ ٱلَّذِينَ كُتِبَ",182],["4:15:14",80,"ٱلْبُيُوتِ","their houses","شَهِدُوا۟ فَأَمْسِكُوهُنَّ فِى","حَتَّىٰ يَتَوَفَّىٰهُنَّ ٱلْمَوْتُ",182],["4:81:7",91,"بَيَّتَ","plan by night","بَرَزُوا۟ مِنْ عِندِكَ","طَآئِفَةٌۭ مِّنْهُمْ غَيْرَ",1538],["4:81:16",91,"يُبَيِّتُونَ ۖ","they plan by night","وَٱللَّهُ يَكْتُبُ مَا","فَأَعْرِضْ عَنْهُمْ وَتَوَكَّلْ",1538],["4:100:15",94,"بَيْتِهِۦ","his home","وَمَن يَخْرُجْ مِنۢ","مُهَاجِرًا إِلَى ٱللَّهِ",182],["4:108:11",96,"يُبَيِّتُونَ","they plot by night","وَهُوَ مَعَهُمْ إِذْ","مَا لَا يَرْضَىٰ",1538],["5:2:17",106,"ٱلْبَيْتَ","(to) the House","ٱلْقَلَـٰٓئِدَ وَلَآ ءَآمِّينَ","ٱلْحَرَامَ يَبْتَغُونَ فَضْلًۭا",182],["5:97:4",124,"ٱلْبَيْتَ","the House","۞ جَعَلَ ٱللَّهُ ٱلْكَعْبَةَ","ٱلْحَرَامَ قِيَـٰمًۭا لِّلنَّاسِ",182],["7:4:7",151,"بَيَـٰتًا","(at) night","أَهْلَكْنَـٰهَا فَجَآءَهَا بَأْسُنَا","أَوْ هُمْ قَآئِلُونَ",1816],["7:74:17",160,"بُيُوتًۭا ۖ","(as) homes","قُصُورًۭا وَتَنْحِتُونَ ٱلْجِبَالَ","فَٱذْكُرُوٓا۟ ءَالَآءَ ٱللَّهِ",182],["7:97:7",163,"بَيَـٰتًۭا","(at) night","أَن يَأْتِيَهُم بَأْسُنَا","وَهُمْ نَآئِمُونَ",1816],["8:5:5",177,"بَيْتِكَ","your home","أَخْرَجَكَ رَبُّكَ مِنۢ","بِٱلْحَقِّ وَإِنَّ فَرِيقًۭا",182],["8:35:5",181,"ٱلْبَيْتِ","the House","كَانَ صَلَاتُهُمْ عِندَ","إِلَّا مُكَآءًۭ وَتَصْدِيَةًۭ ۚ",182],["10:50:6",214,"بَيَـٰتًا","(by) night","إِنْ أَتَىٰكُمْ عَذَابُهُۥ","أَوْ نَهَارًۭا مَّاذَا",1816],["10:87:9",218,"بُيُوتًۭا","(in) houses","تَبَوَّءَا لِقَوْمِكُمَا بِمِصْرَ","وَٱجْعَلُوا۟ بُيُوتَكُمْ قِبْلَةًۭ",182],["10:87:11",218,"بُيُوتَكُمْ","your houses","بِمِصْرَ بُيُوتًۭا وَٱجْعَلُوا۟","قِبْلَةًۭ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ ۗ",182],["11:73:11",230,"ٱلْبَيْتِ ۚ","(of) the house","وَبَرَكَـٰتُهُۥ عَلَيْكُمْ أَهْلَ","إِنَّهُۥ حَمِيدٌۭ مَّجِيدٌۭ",182],["12:23:5",238,"بَيْتِهَا","her house","ٱلَّتِى هُوَ فِى","عَن نَّفْسِهِۦ وَغَلَّقَتِ",182],["14:37:11",260,"بَيْتِكَ","Your Sacred House","ذِى زَرْعٍ عِندَ","ٱلْمُحَرَّمِ رَبَّنَا لِيُقِيمُوا۟",182],["15:82:5",266,"بُيُوتًا","houses","يَنْحِتُونَ مِنَ ٱلْجِبَالِ","ءَامِنِينَ",182],["16:68:9",274,"بُيُوتًۭا","houses","ٱتَّخِذِى مِنَ ٱلْجِبَالِ","وَمِنَ ٱلشَّجَرِ وَمِمَّا",182],["16:80:5",276,"بُيُوتِكُمْ","your homes","جَعَلَ لَكُم مِّنۢ","سَكَنًۭا وَجَعَلَ لَكُم",182],["16:80:12",276,"بُيُوتًۭا","tents","مِّن جُلُودِ ٱلْأَنْعَـٰمِ","تَسْتَخِفُّونَهَا يَوْمَ ظَعْنِكُمْ",182],["17:93:4",291,"بَيْتٌۭ","a house","أَوْ يَكُونَ لَكَ","مِّن زُخْرُفٍ أَوْ",182],["22:26:5",335,"ٱلْبَيْتِ","(of) the House","بَوَّأْنَا لِإِبْرَٰهِيمَ مَكَانَ","أَن لَّا تُشْرِكْ",182],["22:26:12",335,"بَيْتِىَ","My House","بِى شَيْـًۭٔا وَطَهِّرْ","لِلطَّآئِفِينَ وَٱلْقَآئِمِينَ وَٱلرُّكَّعِ",182],["22:29:7",335,"بِٱلْبَيْتِ","the House","وَلْيُوفُوا۟ نُذُورَهُمْ وَلْيَطَّوَّفُوا۟","ٱلْعَتِيقِ",182],["22:33:10",336,"ٱلْبَيْتِ","the House","ثُمَّ مَحِلُّهَآ إِلَى","ٱلْعَتِيقِ",182],["24:27:6",352,"بُيُوتًا","houses","ءَامَنُوا۟ لَا تَدْخُلُوا۟","غَيْرَ بُيُوتِكُمْ حَتَّىٰ",182],["24:27:8",352,"بُيُوتِكُمْ","your houses","تَدْخُلُوا۟ بُيُوتًا غَيْرَ","حَتَّىٰ تَسْتَأْنِسُوا۟ وَتُسَلِّمُوا۟",182],["24:29:6",353,"بُيُوتًا","houses","جُنَاحٌ أَن تَدْخُلُوا۟","غَيْرَ مَسْكُونَةٍۢ فِيهَا",182],["24:36:2",354,"بُيُوتٍ","houses","فِى","أَذِنَ ٱللَّهُ أَن",182],["24:61:19",358,"بُيُوتِكُمْ","your houses","أَن تَأْكُلُوا۟ مِنۢ","أَوْ بُيُوتِ ءَابَآئِكُمْ",182],["24:61:21",358,"بُيُوتِ","houses","مِنۢ بُيُوتِكُمْ أَوْ","ءَابَآئِكُمْ أَوْ بُيُوتِ",182],["24:61:24",358,"بُيُوتِ","houses","بُيُوتِ ءَابَآئِكُمْ أَوْ","أُمَّهَـٰتِكُمْ أَوْ بُيُوتِ",182],["24:61:27",358,"بُيُوتِ","houses","بُيُوتِ أُمَّهَـٰتِكُمْ أَوْ","إِخْوَٰنِكُمْ أَوْ بُيُوتِ",182],["24:61:30",358,"بُيُوتِ","houses","بُيُوتِ إِخْوَٰنِكُمْ أَوْ","أَخَوَٰتِكُمْ أَوْ بُيُوتِ",182],["24:61:33",358,"بُيُوتِ","houses","بُيُوتِ أَخَوَٰتِكُمْ أَوْ","أَعْمَـٰمِكُمْ أَوْ بُيُوتِ",182],["24:61:36",358,"بُيُوتِ","houses","بُيُوتِ أَعْمَـٰمِكُمْ أَوْ","عَمَّـٰتِكُمْ أَوْ بُيُوتِ",182],["24:61:39",358,"بُيُوتِ","houses","بُيُوتِ عَمَّـٰتِكُمْ أَوْ","أَخْوَٰلِكُمْ أَوْ بُيُوتِ",182],["24:61:42",358,"بُيُوتِ","houses","بُيُوتِ أَخْوَٰلِكُمْ أَوْ","خَـٰلَـٰتِكُمْ أَوْ مَا",182],["24:61:60",358,"بُيُوتًۭا","houses","أَشْتَاتًۭا ۚ فَإِذَا دَخَلْتُم","فَسَلِّمُوا۟ عَلَىٰٓ أَنفُسِكُمْ",182],["25:64:2",365,"يَبِيتُونَ","spend (the) night","وَٱلَّذِينَ","لِرَبِّهِمْ سُجَّدًۭا وَقِيَـٰمًۭا",4624],["26:149:4",373,"بُيُوتًۭا","houses","وَتَنْحِتُونَ مِنَ ٱلْجِبَالِ","فَـٰرِهِينَ",182],["27:49:4",381,"لَنُبَيِّتَنَّهُۥ","surely, we will attack him by night","قَالُوا۟ تَقَاسَمُوا۟ بِٱللَّهِ","وَأَهْلَهُۥ ثُمَّ لَنَقُولَنَّ",1538],["27:52:2",381,"بُيُوتُهُمْ","(are) their houses","فَتِلْكَ","خَاوِيَةًۢ بِمَا ظَلَمُوٓا۟ ۗ",182],["28:12:11",386,"بَيْتٍۢ","(of) a house","أَدُلُّكُمْ عَلَىٰٓ أَهْلِ","يَكْفُلُونَهُۥ لَكُمْ وَهُمْ",182],["29:41:11",401,"بَيْتًۭا ۖ","a house","كَمَثَلِ ٱلْعَنكَبُوتِ ٱتَّخَذَتْ","وَإِنَّ أَوْهَنَ ٱلْبُيُوتِ",182],["29:41:14",401,"ٱلْبُيُوتِ","(of) houses","بَيْتًۭا ۖ وَإِنَّ أَوْهَنَ","لَبَيْتُ ٱلْعَنكَبُوتِ ۖ لَوْ",182],["29:41:15",401,"لَبَيْتُ","(is) surely (the) house","وَإِنَّ أَوْهَنَ ٱلْبُيُوتِ","ٱلْعَنكَبُوتِ ۖ لَوْ كَانُوا۟",182],["33:13:17",419,"بُيُوتَنَا","our houses","ٱلنَّبِىَّ يَقُولُونَ إِنَّ","عَوْرَةٌۭ وَمَا هِىَ",182],["33:33:3",422,"بُيُوتِكُنَّ","your houses","وَقَرْنَ فِى","وَلَا تَبَرَّجْنَ تَبَرُّجَ",182],["33:33:23",422,"ٱلْبَيْتِ","(of) the House","عَنكُمُ ٱلرِّجْسَ أَهْلَ","وَيُطَهِّرَكُمْ تَطْهِيرًۭا",182],["33:34:5",422,"بُيُوتِكُنَّ","your houses","مَا يُتْلَىٰ فِى","مِنْ ءَايَـٰتِ ٱللَّهِ",182],["33:53:6",425,"بُيُوتَ","(the) houses","ءَامَنُوا۟ لَا تَدْخُلُوا۟","ٱلنَّبِىِّ إِلَّآ أَن",182],["43:33:11",491,"لِبُيُوتِهِمْ","for their houses","لِمَن يَكْفُرُ بِٱلرَّحْمَـٰنِ","سُقُفًۭا مِّن فِضَّةٍۢ",182],["43:34:1",492,"وَلِبُيُوتِهِمْ","And for their houses","","أَبْوَٰبًۭا وَسُرُرًا عَلَيْهَا",182],["51:36:5",522,"بَيْتٍۢ","a house","وَجَدْنَا فِيهَا غَيْرَ","مِّنَ ٱلْمُسْلِمِينَ",182],["52:4:1",523,"وَٱلْبَيْتِ","By the House","","ٱلْمَعْمُورِ",182],["59:2:34",545,"بُيُوتَهُم","their houses","قُلُوبِهِمُ ٱلرُّعْبَ ۚ يُخْرِبُونَ","بِأَيْدِيهِمْ وَأَيْدِى ٱلْمُؤْمِنِينَ",182],["65:1:16",558,"بُيُوتِهِنَّ","their houses","لَا تُخْرِجُوهُنَّ مِنۢ","وَلَا يَخْرُجْنَ إِلَّآ",182],["66:11:14",561,"بَيْتًۭا","a house","ٱبْنِ لِى عِندَكَ","فِى ٱلْجَنَّةِ وَنَجِّنِى",182],["71:28:7",571,"بَيْتِىَ","my house","وَلِوَٰلِدَىَّ وَلِمَن دَخَلَ","مُؤْمِنًۭا وَلِلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ",182],["106:3:4",602,"ٱلْبَيْتِ","House","فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا","",182]]