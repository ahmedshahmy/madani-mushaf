[["2:250:2",41,"بَرَزُوا۟","they went forth","وَلَمَّا","لِجَالُوتَ وَجُنُودِهِۦ قَالُوا۟",1323],["3:154:56",70,"لَبَرَزَ","surely (would have) come out","كُنتُمْ فِى بُيُوتِكُمْ","ٱلَّذِينَ كُتِبَ عَلَيْهِمُ",1323],["4:81:4",91,"بَرَزُوا۟","they leave","وَيَقُولُونَ طَاعَةٌۭ فَإِذَا","مِنْ عِندِكَ بَيَّتَ",1323],["14:21:1",258,"وَبَرَزُوا۟","And they will come forth","","لِلَّهِ جَمِيعًۭا فَقَالَ",1323],["14:48:7",261,"وَبَرَزُوا۟","and they will come forth","غَيْرَ ٱلْأَرْضِ وَٱلسَّمَـٰوَٰتُ ۖ","لِلَّهِ ٱلْوَٰحِدِ ٱلْقَهَّارِ",1323],["18:47:6",299,"بَارِزَةًۭ","(as) a leveled plain","ٱلْجِبَالَ وَتَرَى ٱلْأَرْضَ","وَحَشَرْنَـٰهُمْ فَلَمْ نُغَادِرْ",3318],["26:91:1",371,"وَبُرِّزَتِ","And (will be) made manifest","","ٱلْجَحِيمُ لِلْغَاوِينَ",2346],["40:16:3",468,"بَـٰرِزُونَ ۖ","come forth","يَوْمَ هُم","لَا يَخْفَىٰ عَلَى",3332],["79:36:1",584,"وَبُرِّزَتِ","And will be made manifest","","ٱلْجَحِيمُ لِمَن يَرَىٰ",2346]]