8],["3:160:14",71,"بَعْدِهِۦ ۗ","after Him","ٱلَّذِى يَنصُرُكُم مِّنۢ","وَعَلَى ٱللَّهِ فَلْيَتَوَكَّلِ",58],["3:172:6",72,"بَعْدِ","after","لِلَّهِ وَٱلرَّسُولِ مِنۢ","مَآ أَصَابَهُمُ ٱلْقَرْحُ ۚ",58],["4:11:50",78,"بَعْدِ","after","فَلِأُمِّهِ ٱلسُّدُسُ ۚ مِنۢ","وَصِيَّةٍۢ يُوصِى بِهَآ",58],["4:12:20",79,"بَعْدِ","after","مِمَّا تَرَكْنَ ۚ مِنۢ","وَصِيَّةٍۢ يُوصِينَ بِهَآ",58],["4:12:44",79,"بَعْدِ","after","مِمَّا تَرَكْتُم ۚ مِّنۢ","وَصِيَّةٍۢ تُوصُونَ بِهَآ",58],["4:12:75",79,"بَعْدِ","after","فِى ٱلثُّلُثِ ۚ مِنۢ","وَصِيَّةٍۢ يُوصَىٰ بِهَآ",58],["4:24:36",82,"بَعْدِ","beyond","تَرَٰضَيْتُم بِهِۦ مِنۢ","ٱلْفَرِيضَةِ ۚ إِنَّ ٱللَّهَ",58],["4:60:30",88,"بَعِيدًۭا","far away","أَن يُضِلَّهُمْ ضَلَـٰلًۢا","",424],["4:115:5",97,"بَعْدِ","after","يُشَاقِقِ ٱلرَّسُولَ مِنۢ","مَا تَبَيَّنَ لَهُ",58],["4:116:20",97,"بَعِيدًا","far away","فَقَدْ ضَلَّ ضَلَـٰلًۢا","",424],["4:136:28",100,"بَعِيدًا","far away","فَقَدْ ضَلَّ ضَلَـٰلًۢا","",424],["4:153:27",102,"بَعْدِ","after","ٱتَّخَذُوا۟ ٱلْعِجْلَ مِنۢ","مَا جَآءَتْهُمُ ٱلْبَيِّنَـٰتُ",58],["4:163:10",104,"بَعْدِهِۦ ۚ","after him","نُوحٍۢ وَٱلنَّبِيِّـۧنَ مِنۢ","وَأَوْحَيْنَآ إِلَىٰٓ إِبْرَٰهِيمَ",58],["4:165:10",104,"بَعْدَ","after","عَلَى ٱللَّهِ حُجَّةٌۢ","ٱلرُّسُلِ ۚ وَكَانَ ٱللَّهُ",58],["4:167:11",104,"بَعِيدًا","far away","قَدْ ضَلُّوا۟ ضَلَـٰلًۢا","",424],["5:12:39",109,"بَعْدَ","after","ٱلْأَنْهَـٰرُ ۚ فَمَن كَفَرَ","ذَٰلِكَ مِنكُمْ فَقَدْ",58],["5:32:36",113,"بَعْدَ","after","إِنَّ كَثِيرًۭا مِّنْهُم","ذَٰلِكَ فِى ٱلْأَرْضِ",58],["5:39:4",114,"بَعْدِ","after","فَمَن تَابَ مِنۢ","ظُلْمِهِۦ وَأَصْلَحَ فَإِنَّ",58],["5:41:30",114,"بَعْدِ","after","يُحَرِّفُونَ ٱلْكَلِمَ مِنۢ","مَوَاضِعِهِۦ ۖ يَقُولُونَ إِنْ",58],["5:43:11",115,"بَعْدِ","after","ثُمَّ يَتَوَلَّوْنَ مِنۢ","ذَٰلِكَ ۚ وَمَآ أُو۟لَـٰٓئِكَ",58],["5:94:19",123,"بَعْدَ","after","بِٱلْغَيْبِ ۚ فَمَنِ ٱعْتَدَىٰ","ذَٰلِكَ فَلَهُۥ عَذَابٌ",58],["5:106:30",125,"بَعْدِ","after","ٱلْمَوْتِ ۚ تَحْبِسُونَهُمَا مِنۢ","ٱلصَّلَوٰةِ فَيُقْسِمَانِ بِٱللَّهِ",58]