دِ","after","ٱلْأَرْضِ وَهُم مِّنۢ","غَلَبِهِمْ سَيَغْلِبُونَ",58],["30:4:9",404,"بَعْدُ ۚ","and after","مِن قَبْلُ وَمِنۢ","وَيَوْمَئِذٍۢ يَفْرَحُ ٱلْمُؤْمِنُونَ",58],["30:19:11",406,"بَعْدَ","after","ٱلْحَىِّ وَيُحْىِ ٱلْأَرْضَ","مَوْتِهَا ۚ وَكَذَٰلِكَ تُخْرَجُونَ",58],["30:24:14",406,"بَعْدَ","after","فَيُحْىِۦ بِهِ ٱلْأَرْضَ","مَوْتِهَآ ۚ إِنَّ فِى",58],["30:50:9",409,"بَعْدَ","after","كَيْفَ يُحْىِ ٱلْأَرْضَ","مَوْتِهَآ ۚ إِنَّ ذَٰلِكَ",58],["30:51:8",410,"بَعْدِهِۦ","after it","مُصْفَرًّۭا لَّظَلُّوا۟ مِنۢ","يَكْفُرُونَ",58],["30:54:9",410,"بَعْدِ","after","ثُمَّ جَعَلَ مِنۢ","ضَعْفٍۢ قُوَّةًۭ ثُمَّ",58],["30:54:15",410,"بَعْدِ","after","ثُمَّ جَعَلَ مِنۢ","قُوَّةٍۢ ضَعْفًۭا وَشَيْبَةًۭ ۚ",58],["31:27:11",413,"بَعْدِهِۦ","after it","وَٱلْبَحْرُ يَمُدُّهُۥ مِنۢ","سَبْعَةُ أَبْحُرٍۢ مَّا",58],["33:52:6",425,"بَعْدُ","after (this)","لَكَ ٱلنِّسَآءُ مِنۢ","وَلَآ أَن تَبَدَّلَ",58],["33:53:62",425,"بَعْدِهِۦٓ","after him","تَنكِحُوٓا۟ أَزْوَٰجَهُۥ مِنۢ","أَبَدًا ۚ إِنَّ ذَٰلِكُمْ",58],["34:8:16",429,"ٱلْبَعِيدِ","far","فِى ٱلْعَذَابِ وَٱلضَّلَـٰلِ","",424],["34:19:3",430,"بَـٰعِدْ","lengthen (the distance)","فَقَالُوا۟ رَبَّنَا","بَيْنَ أَسْفَارِنَا وَظَلَمُوٓا۟",3331],["34:32:10",432,"بَعْدَ","after","صَدَدْنَـٰكُمْ عَنِ ٱلْهُدَىٰ","إِذْ جَآءَكُم ۖ بَلْ",58],["34:52:9",434,"بَعِيدٍۢ","far off","ٱلتَّنَاوُشُ مِن مَّكَانٍۭ","",424],["34:53:10",434,"بَعِيدٍۢ","far off","بِٱلْغَيْبِ مِن مَّكَانٍۭ","",424],["35:2:16",434,"بَعْدِهِۦ ۚ","thereafter","مُرْسِلَ لَهُۥ مِنۢ","وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ",58],["35:9:14",435,"بَعْدَ","after","فَأَحْيَيْنَا بِهِ ٱلْأَرْضَ","مَوْتِهَا ۚ كَذَٰلِكَ ٱلنُّشُورُ",58],["35:41:15",439,"بَعْدِهِۦٓ ۚ","after Him","مِنْ أَحَدٍۢ مِّنۢ","إِنَّهُۥ كَانَ حَلِيمًا",58],["36:28:6",442,"بَعْدِهِۦ","after him","عَلَىٰ قَوْمِهِۦ مِنۢ","مِن جُندٍۢ مِّنَ",58],["38:35:12",455,"بَعْدِىٓ ۖ","after me","يَنۢبَغِى لِأَحَدٍۢ مِّنۢ","إِنَّكَ أَنتَ ٱلْوَهَّابُ",58],["38:88:3",458,"بَعْدَ","after","وَلَتَعْلَمُنَّ نَبَأَهُۥ","حِينٍۭ",58],["39:6:21",45