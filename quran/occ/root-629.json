[["3:7:18",50,"زَيْغٌۭ","(is) perversity","ٱلَّذِينَ فِى قُلُوبِهِمْ","فَيَتَّبِعُونَ مَا تَشَـٰبَهَ",4763],["3:8:3",50,"تُزِغْ","deviate","رَبَّنَا لَا","قُلُوبَنَا بَعْدَ إِذْ",2212],["9:117:17",205,"يَزِيغُ","deviated","بَعْدِ مَا كَادَ","قُلُوبُ فَرِيقٍۢ مِّنْهُمْ",1258],["33:10:9",419,"زَاغَتِ","grew wild","أَسْفَلَ مِنكُمْ وَإِذْ","ٱلْأَبْصَـٰرُ وَبَلَغَتِ ٱلْقُلُوبُ",1258],["34:12:20",429,"يَزِغْ","deviated","بِإِذْنِ رَبِّهِۦ ۖ وَمَن","مِنْهُمْ عَنْ أَمْرِنَا",1258],["38:63:4",457,"زَاغَتْ","has turned away","أَتَّخَذْنَـٰهُمْ سِخْرِيًّا أَمْ","عَنْهُمُ ٱلْأَبْصَـٰرُ",1258],["53:17:2",526,"زَاغَ","swerved","مَا","ٱلْبَصَرُ وَمَا طَغَىٰ",1258],["61:5:15",551,"زَاغُوٓا۟","they deviated","ٱللَّهِ إِلَيْكُمْ ۖ فَلَمَّا","أَزَاغَ ٱللَّهُ قُلُوبَهُمْ ۚ",1258],["61:5:16",551,"أَزَاغَ","(was caused to) deviate","إِلَيْكُمْ ۖ فَلَمَّا زَاغُوٓا۟","ٱللَّهُ قُلُوبَهُمْ ۚ وَٱللَّهُ",2212]]