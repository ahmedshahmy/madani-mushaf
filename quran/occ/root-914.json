[["3:162:7",71,"بِسَخَطٍۢ","on (himself) wrath","ٱللَّهِ كَمَنۢ بَآءَ","مِّنَ ٱللَّهِ وَمَأْوَىٰهُ",4261],["5:80:13",121,"سَخِطَ","became angry","لَهُمْ أَنفُسُهُمْ أَن","ٱللَّهُ عَلَيْهِمْ وَفِى",2632],["9:58:16",196,"يَسْخَطُونَ","(are) enraged","مِنْهَآ إِذَا هُمْ","",2632],["47:28:5",509,"أَسْخَطَ","angered","بِأَنَّهُمُ ٱتَّبَعُوا۟ مَآ","ٱللَّهَ وَكَرِهُوا۟ رِضْوَٰنَهُۥ",3040]]