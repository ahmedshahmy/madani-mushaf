[["2:187:8",29,"هُنَّ","They","ٱلرَّفَثُ إِلَىٰ نِسَآئِكُمْ ۚ","لِبَاسٌۭ لَّكُمْ وَأَنتُمْ",409],["2:187:13",29,"لَّهُنَّ ۗ","for them","لَّكُمْ وَأَنتُمْ لِبَاسٌۭ","عَلِمَ ٱللَّهُ أَنَّكُمْ",409],["2:228:8",36,"لَهُنَّ","for them","قُرُوٓءٍۢ ۚ وَلَا يَحِلُّ","أَن يَكْتُمْنَ مَا",409],["2:228:30",36,"وَلَهُنَّ","And for them","إِنْ أَرَادُوٓا۟ إِصْلَـٰحًۭا ۚ","مِثْلُ ٱلَّذِى عَلَيْهِنَّ",409],["2:236:12",38,"لَهُنَّ","for them","تَمَسُّوهُنَّ أَوْ تَفْرِضُوا۟","فَرِيضَةًۭ ۚ وَمَتِّعُوهُنَّ عَلَى",409],["2:237:9",38,"لَهُنَّ","for them","تَمَسُّوهُنَّ وَقَدْ فَرَضْتُمْ","فَرِيضَةًۭ فَنِصْفُ مَا",409],["3:7:9",50,"هُنَّ","they (are)","مِنْهُ ءَايَـٰتٌۭ مُّحْكَمَـٰتٌ","أُمُّ ٱلْكِتَـٰبِ وَأُخَرُ",409],["4:11:14",78,"فَلَهُنَّ","then for them","نِسَآءًۭ فَوْقَ ٱثْنَتَيْنِ","ثُلُثَا مَا تَرَكَ ۖ",409],["4:12:9",79,"لَّهُنَّ","for them","إِن لَّمْ يَكُن","وَلَدٌۭ ۚ فَإِن كَانَ",409],["4:12:13",79,"لَهُنَّ","for them","وَلَدٌۭ ۚ فَإِن كَانَ","وَلَدٌۭ فَلَكُمُ ٱلرُّبُعُ",409],["4:12:26",79,"وَلَهُنَّ","And for them","بِهَآ أَوْ دَيْنٍۢ ۚ","ٱلرُّبُعُ مِمَّا تَرَكْتُمْ",409],["4:12:39",79,"فَلَهُنَّ","then for them","كَانَ لَكُمْ وَلَدٌۭ","ٱلثُّمُنُ مِمَّا تَرَكْتُم ۚ",409],["4:15:21",80,"لَهُنَّ","for them","أَوْ يَجْعَلَ ٱللَّهُ","سَبِيلًۭا",409],["4:23:28",81,"بِهِنَّ","with them","نِّسَآئِكُمُ ٱلَّـٰتِى دَخَلْتُم","فَإِن لَّمْ تَكُونُوا۟",409],["4:23:33",81,"بِهِنَّ","with them","لَّمْ تَكُونُوا۟ دَخَلْتُم","فَلَا جُنَاحَ عَلَيْكُمْ",409],["4:127:21",98,"لَهُنَّ","for them","تُؤْتُونَهُنَّ مَا كُتِبَ","وَتَرْغَبُونَ أَن تَنكِحُوهُنَّ",409],["11:78:14",230,"هُنَّ","they","يَـٰقَوْمِ هَـٰٓؤُلَآءِ بَنَاتِى","أَطْهَرُ لَكُمْ ۖ فَٱتَّقُوا۟",409],["12:31:7",239,"لَهُنَّ","for them","أَرْسَلَتْ إِلَيْهِنَّ وَأَعْتَدَتْ","مُتَّكَـًۭٔا وَءَاتَتْ كُلَّ",409],["12:48:11",241,"لَهُنَّ","for them","يَأْكُلْنَ مَا قَدَّمْتُمْ","إِلَّا قَلِيلًۭا مِّمَّا",409],["24:60:20",358,"لَّهُنَّ ۗ","for them","وَأَن يَسْتَعْفِفْنَ خَيْرٌۭ","وَٱللَّهُ سَمِيعٌ عَلِيمٌۭ",409],["33:52:10",425,"بِهِنَّ","them","وَلَآ أَن تَبَدَّلَ","مِنْ أَزْوَٰجٍۢ وَلَوْ",409],["39:38:21",462,"هُنَّ","they","ٱللَّهُ بِضُرٍّ هَلْ","كَـٰشِفَـٰتُ ضُرِّهِۦٓ أَوْ",409],["39:38:28",462,"هُنَّ","they","أَرَادَنِى بِرَحْمَةٍ هَلْ","مُمْسِكَـٰتُ رَحْمَتِهِۦ ۚ قُلْ",409],["58:2:7",542,"هُنَّ","they","مِّن نِّسَآئِهِم مَّا","أُمَّهَـٰتِهِمْ ۖ إِنْ أُمَّهَـٰتُهُمْ",409],["60:10:20",550,"هُنَّ","they","إِلَى ٱلْكُفَّارِ ۖ لَا","حِلٌّۭ لَّهُمْ وَلَا",409],["60:10:26",550,"لَهُنَّ ۖ","for them","وَلَا هُمْ يَحِلُّونَ","وَءَاتُوهُم مَّآ أَنفَقُوا۟ ۚ",409],["60:12:33",551,"لَهُنَّ","for them","مَعْرُوفٍۢ ۙ فَبَايِعْهُنَّ وَٱسْتَغْفِرْ","ٱللَّهَ ۖ إِنَّ ٱللَّهَ",409]]