[["2:52:2",8,"عَفَوْنَا","We forgave","ثُمَّ","عَنكُم مِّنۢ بَعْدِ",397],["2:109:22",17,"فَٱعْفُوا۟","So forgive","تَبَيَّنَ لَهُمُ ٱلْحَقُّ ۖ","وَٱصْفَحُوا۟ حَتَّىٰ يَأْتِىَ",397],["2:178:16",27,"عُفِىَ","is pardoned","وَٱلْأُنثَىٰ بِٱلْأُنثَىٰ ۚ فَمَنْ","لَهُۥ مِنْ أَخِيهِ",397],["2:187:22",29,"وَعَفَا","and He forgave","أَنفُسَكُمْ فَتَابَ عَلَيْكُمْ","عَنكُمْ ۖ فَٱلْـَٔـٰنَ بَـٰشِرُوهُنَّ",397],["2:219:19",34,"ٱلْعَفْوَ ۗ","The surplus","مَاذَا يُنفِقُونَ قُلِ","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ",2236],["2:237:16",38,"يَعْفُونَ","they (women) forgo (it)","فَرَضْتُمْ إِلَّآ أَن","أَوْ يَعْفُوَا۟ ٱلَّذِى",397],["2:237:18",38,"يَعْفُوَا۟","forgoes","أَن يَعْفُونَ أَوْ","ٱلَّذِى بِيَدِهِۦ عُقْدَةُ",397],["2:237:24",38,"تَعْفُوٓا۟","you forgo","عُقْدَةُ ٱلنِّكَاحِ ۚ وَأَن","أَقْرَبُ لِلتَّقْوَىٰ ۚ وَلَا",397],["2:286:39",49,"وَٱعْفُ","And pardon","طَاقَةَ لَنَا بِهِۦ ۖ","عَنَّا وَٱغْفِرْ لَنَا",397],["3:134:8",67,"وَٱلْعَافِينَ","and those who pardon","وَٱلضَّرَّآءِ وَٱلْكَـٰظِمِينَ ٱلْغَيْظَ","عَنِ ٱلنَّاسِ ۗ وَٱللَّهُ",3095],["3:152:34",69,"عَفَا","He forgave","عَنْهُمْ لِيَبْتَلِيَكُمْ ۖ وَلَقَدْ","عَنكُمْ ۗ وَٱللَّهُ ذُو",397],["3:155:15",70,"عَفَا","forgave","مَا كَسَبُوا۟ ۖ وَلَقَدْ","ٱللَّهُ عَنْهُمْ ۗ إِنَّ",397],["3:159:15",71,"فَٱعْفُ","Then pardon","لَٱنفَضُّوا۟ مِنْ حَوْلِكَ ۖ","عَنْهُمْ وَٱسْتَغْفِرْ لَهُمْ",397],["4:43:47",85,"عَفُوًّا","Oft-Pardoning","إِنَّ ٱللَّهَ كَانَ","غَفُورًا",1290],["4:99:5",94,"يَعْفُوَ","pardon","عَسَى ٱللَّهُ أَن","عَنْهُمْ ۚ وَكَانَ ٱللَّهُ",397],["4:99:9",94,"عَفُوًّا","Oft-Pardoning","عَنْهُمْ ۚ وَكَانَ ٱللَّهُ","غَفُورًۭا",1290],["4:149:7",102,"تَعْفُوا۟","pardon","أَوْ تُخْفُوهُ أَوْ","عَن سُوٓءٍۢ فَإِنَّ",397],["4:149:13",102,"عَفُوًّۭا","Oft-Pardoning","فَإِنَّ ٱللَّهَ كَانَ","قَدِيرًا",1290],["4:153:31",102,"فَعَفَوْنَا","then We forgave them","مَا جَآءَتْهُمُ ٱلْبَيِّنَـٰتُ","عَن ذَٰلِكَ ۚ وَءَاتَيْنَا",397],["5:13:26",109,"فَٱعْفُ","But forgive","إِلَّا قَلِيلًۭا مِّنْهُمْ ۖ","عَنْهُمْ وَٱصْفَحْ ۚ إِنَّ",397],["5:15:14",110,"وَيَعْفُوا۟","and overlooking","تُخْفُونَ مِنَ ٱلْكِتَـٰبِ","عَن كَثِيرٍۢ ۚ قَدْ",397],["5:95:38",123,"عَفَا","Pardoned","لِّيَذُوقَ وَبَالَ أَمْرِهِۦ ۗ","ٱللَّهُ عَمَّا سَلَفَ ۚ",397],["5:101:20",124,"عَفَا","has (been) pardoned","ٱلْقُرْءَانُ تُبْدَ لَكُمْ","ٱللَّهُ عَنْهَا ۗ وَٱللَّهُ",397],["7:95:7",162,"عَفَوا۟","they increased","ٱلسَّيِّئَةِ ٱلْحَسَنَةَ حَتَّىٰ","وَّقَالُوا۟ قَدْ مَسَّ",397],["7:199:2",176,"ٱلْعَفْوَ","(to) forgiveness","خُذِ","وَأْمُرْ بِٱلْعُرْفِ وَأَعْرِضْ",2236],["9:43:1",194,"عَفَا","(May) Allah forgive","","ٱللَّهُ عَنكَ لِمَ",397],["9:66:8",197,"نَّعْفُ","We pardon","بَعْدَ إِيمَـٰنِكُمْ ۚ إِن","عَن طَآئِفَةٍۢ مِّنكُمْ",397],["22:60:15",339,"لَعَفُوٌّ","(is) surely Oft-Pardoning","ٱللَّهُ ۗ إِنَّ ٱللَّهَ","غَفُورٌۭ",1290],["24:22:16",352,"وَلْيَعْفُوا۟","And let them pardon","فِى سَبِيلِ ٱللَّهِ ۖ","وَلْيَصْفَحُوٓا۟ ۗ أَلَا تُحِبُّونَ",397],["42:25:7",486,"وَيَعْفُوا۟","and pardons","ٱلتَّوْبَةَ عَنْ عِبَادِهِۦ","عَنِ ٱلسَّيِّـَٔاتِ وَيَعْلَمُ",397],["42:30:8",486,"وَيَعْفُوا۟","But He pardons","فَبِمَا كَسَبَتْ أَيْدِيكُمْ","عَن كَثِيرٍۢ",397],["42:34:5",487,"وَيَعْفُ","but He pardons","يُوبِقْهُنَّ بِمَا كَسَبُوا۟","عَن كَثِيرٍۢ",397],["42:40:6",487,"عَفَا","pardons","سَيِّئَةٌۭ مِّثْلُهَا ۖ فَمَنْ","وَأَصْلَحَ فَأَجْرُهُۥ عَلَى",397],["58:2:22",542,"لَعَفُوٌّ","(is) surely, Oft-Pardoning","وَزُورًۭا ۚ وَإِنَّ ٱللَّهَ","غَفُورٌۭ",1290],["64:14:12",557,"تَعْفُوا۟","you pardon","لَّكُمْ فَٱحْذَرُوهُمْ ۚ وَإِن","وَتَصْفَحُوا۟ وَتَغْفِرُوا۟ فَإِنَّ",397]]