[["5:31:14",112,"أَعَجَزْتُ","Am I unable","أَخِيهِ ۚ قَالَ يَـٰوَيْلَتَىٰٓ","أَنْ أَكُونَ مِثْلَ",3112],["6:134:7",145,"بِمُعْجِزِينَ","escape (it)","لَـَٔاتٍۢ ۖ وَمَآ أَنتُم","",734],["8:59:8",184,"يُعْجِزُونَ","escape","سَبَقُوٓا۟ ۚ إِنَّهُمْ لَا","",1678],["9:2:9",187,"مُعْجِزِى","escape","وَٱعْلَمُوٓا۟ أَنَّكُمْ غَيْرُ","ٱللَّهِ ۙ وَأَنَّ ٱللَّهَ",734],["9:3:26",187,"مُعْجِزِى","escape","فَٱعْلَمُوٓا۟ أَنَّكُمْ غَيْرُ","ٱللَّهِ ۗ وَبَشِّرِ ٱلَّذِينَ",734],["10:53:11",214,"بِمُعْجِزِينَ","(can) escape (it)","لَحَقٌّۭ ۖ وَمَآ أَنتُم","",734],["11:20:4",224,"مُعْجِزِينَ","(able to) escape","أُو۟لَـٰٓئِكَ لَمْ يَكُونُوا۟","فِى ٱلْأَرْضِ وَمَا",734],["11:33:10",225,"بِمُعْجِزِينَ","one who (can) escape (it)","شَآءَ وَمَآ أَنتُم","",734],["11:72:5",230,"عَجُوزٌۭ","an old woman","يَـٰوَيْلَتَىٰٓ ءَأَلِدُ وَأَنَا۠","وَهَـٰذَا بَعْلِى شَيْخًا ۖ",1496],["16:46:7",272,"بِمُعْجِزِينَ","will be able to escape","تَقَلُّبِهِمْ فَمَا هُم","",734],["22:51:5",338,"مُعَـٰجِزِينَ","(to) cause failure","سَعَوْا۟ فِىٓ ءَايَـٰتِنَا","أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْجَحِيمِ",1901],["24:57:5",357,"مُعْجِزِينَ","(can) escape","تَحْسَبَنَّ ٱلَّذِينَ كَفَرُوا۟","فِى ٱلْأَرْضِ ۚ وَمَأْوَىٰهُمُ",734],["26:171:2",374,"عَجُوزًۭا","an old woman","إِلَّا","فِى ٱلْغَـٰبِرِينَ",1496],["29:22:3",398,"بِمُعْجِزِينَ","can escape","وَمَآ أَنتُم","فِى ٱلْأَرْضِ وَلَا",734],["34:5:5",428,"مُعَـٰجِزِينَ","(to) cause failure","سَعَوْ فِىٓ ءَايَـٰتِنَا","أُو۟لَـٰٓئِكَ لَهُمْ عَذَابٌۭ",1901],["34:38:5",432,"مُعَـٰجِزِينَ","(to) cause failure","يَسْعَوْنَ فِىٓ ءَايَـٰتِنَا","أُو۟لَـٰٓئِكَ فِى ٱلْعَذَابِ",1901],["35:44:19",439,"لِيُعْجِزَهُۥ","that can escape (from) Him","وَمَا كَانَ ٱللَّهُ","مِن شَىْءٍۢ فِى",1678],["37:135:2",451,"عَجُوزًۭا","an old woman","إِلَّا","فِى ٱلْغَـٰبِرِينَ",1496],["39:51:15",464,"بِمُعْجِزِينَ","will be able to escape","كَسَبُوا۟ وَمَا هُم","",734],["42:31:3",486,"بِمُعْجِزِينَ","(can) escape","وَمَآ أَنتُم","فِى ٱلْأَرْضِ ۖ وَمَا",734],["46:32:7",506,"بِمُعْجِزٍۢ","he can escape","دَاعِىَ ٱللَّهِ فَلَيْسَ","فِى ٱلْأَرْضِ وَلَيْسَ",734],["51:29:8",521,"عَجُوزٌ","An old woman","فَصَكَّتْ وَجْهَهَا وَقَالَتْ","عَقِيمٌۭ",1496],["54:20:4",529,"أَعْجَازُ","trunks","تَنزِعُ ٱلنَّاسَ كَأَنَّهُمْ","نَخْلٍۢ مُّنقَعِرٍۢ",2154],["69:7:13",566,"أَعْجَازُ","trunks","فِيهَا صَرْعَىٰ كَأَنَّهُمْ","نَخْلٍ خَاوِيَةٍۢ",2154],["72:12:5",572,"نُّعْجِزَ","we will cause failure","ظَنَنَّآ أَن لَّن","ٱللَّهَ فِى ٱلْأَرْضِ",1678],["72:12:10",572,"نُّعْجِزَهُۥ","we can escape Him","فِى ٱلْأَرْضِ وَلَن","هَرَبًۭا",1678]]