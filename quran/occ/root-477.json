[["7:187:5",174,"مُرْسَىٰهَا ۖ","its appointed time","عَنِ ٱلسَّاعَةِ أَيَّانَ","قُلْ إِنَّمَا عِلْمُهَا",1915],["11:41:7",226,"وَمُرْسَىٰهَآ ۚ","and its anchorage","بِسْمِ ٱللَّهِ مَجْر۪ىٰهَا","إِنَّ رَبِّى لَغَفُورٌۭ",1915],["13:3:7",249,"رَوَٰسِىَ","firm mountains","ٱلْأَرْضَ وَجَعَلَ فِيهَا","وَأَنْهَـٰرًۭا ۖ وَمِن كُلِّ",856],["15:19:5",263,"رَوَٰسِىَ","firm mountains","مَدَدْنَـٰهَا وَأَلْقَيْنَا فِيهَا","وَأَنۢبَتْنَا فِيهَا مِن",856],["16:15:4",269,"رَوَٰسِىَ","firm mountains","وَأَلْقَىٰ فِى ٱلْأَرْضِ","أَن تَمِيدَ بِكُمْ",856],["21:31:4",324,"رَوَٰسِىَ","firmly set mountains","وَجَعَلْنَا فِى ٱلْأَرْضِ","أَن تَمِيدَ بِهِمْ",856],["27:61:10",382,"رَوَٰسِىَ","firm mountains","أَنْهَـٰرًۭا وَجَعَلَ لَهَا","وَجَعَلَ بَيْنَ ٱلْبَحْرَيْنِ",856],["31:10:9",411,"رَوَٰسِىَ","firm mountains","وَأَلْقَىٰ فِى ٱلْأَرْضِ","أَن تَمِيدَ بِكُمْ",856],["34:13:11",429,"رَّاسِيَـٰتٍ ۚ","fixed","وَجِفَانٍۢ كَٱلْجَوَابِ وَقُدُورٍۢ","ٱعْمَلُوٓا۟ ءَالَ دَاوُۥدَ",856],["41:10:3",477,"رَوَٰسِىَ","firmly-set mountains","وَجَعَلَ فِيهَا","مِن فَوْقِهَا وَبَـٰرَكَ",856],["50:7:5",518,"رَوَٰسِىَ","firmly set mountains","مَدَدْنَـٰهَا وَأَلْقَيْنَا فِيهَا","وَأَنۢبَتْنَا فِيهَا مِن",856],["77:27:3",581,"رَوَٰسِىَ","firmly set mountains","وَجَعَلْنَا فِيهَا","شَـٰمِخَـٰتٍۢ وَأَسْقَيْنَـٰكُم مَّآءًۭ",856],["79:32:2",584,"أَرْسَىٰهَا","He made them firm","وَٱلْجِبَالَ","",3033],["79:42:5",584,"مُرْسَىٰهَا","(is) its arrival","عَنِ ٱلسَّاعَةِ أَيَّانَ","",1915]]