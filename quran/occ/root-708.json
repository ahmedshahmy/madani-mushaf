[["2:19:8",4,"وَبَرْقٌۭ","and lightning","فِيهِ ظُلُمَـٰتٌۭ وَرَعْدٌۭ","يَجْعَلُونَ أَصَـٰبِعَهُمْ فِىٓ",1324],["2:20:2",4,"ٱلْبَرْقُ","the lightning","يَكَادُ","يَخْطَفُ أَبْصَـٰرَهُمْ ۖ كُلَّمَآ",1324],["13:12:4",250,"ٱلْبَرْقَ","the lightning","هُوَ ٱلَّذِى يُرِيكُمُ","خَوْفًۭا وَطَمَعًۭا وَيُنشِئُ",1324],["24:43:36",355,"بَرْقِهِۦ","(of) its lighting","يَشَآءُ ۖ يَكَادُ سَنَا","يَذْهَبُ بِٱلْأَبْصَـٰرِ",1324],["30:24:4",406,"ٱلْبَرْقَ","the lightning","وَمِنْ ءَايَـٰتِهِۦ يُرِيكُمُ","خَوْفًۭا وَطَمَعًۭا وَيُنَزِّلُ",1324],["75:7:2",577,"بَرِقَ","is dazzled","فَإِذَا","ٱلْبَصَرُ",3344]]