[["3:146:1",68,"وَكَأَيِّن","And how many","","مِّن نَّبِىٍّۢ قَـٰتَلَ",1079],["12:105:1",248,"وَكَأَيِّن","And how many","","مِّنْ ءَايَةٍۢ فِى",1079],["22:45:1",337,"فَكَأَيِّن","And how many","","مِّن قَرْيَةٍ أَهْلَكْنَـٰهَا",1079],["22:48:1",338,"وَكَأَيِّن","And how many","","مِّن قَرْيَةٍ أَمْلَيْتُ",1079],["29:60:1",403,"وَكَأَيِّن","And how many","","مِّن دَآبَّةٍۢ لَّا",1079],["47:13:1",508,"وَكَأَيِّن","And how many","","مِّن قَرْيَةٍ هِىَ",1079],["65:8:1",559,"وَكَأَيِّن","And how many","","مِّن قَرْيَةٍ عَتَتْ",1079]]