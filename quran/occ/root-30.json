[["2:10:12",3,"يَكْذِبُونَ","[they] lie","أَلِيمٌۢ بِمَا كَانُوا۟","",785],["2:39:3",7,"وَكَذَّبُوا۟","and deny","وَٱلَّذِينَ كَفَرُوا۟","بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ",63],["2:87:26",13,"كَذَّبْتُمْ","you denied","أَنفُسُكُمُ ٱسْتَكْبَرْتُمْ فَفَرِيقًۭا","وَفَرِيقًۭا تَقْتُلُونَ",63],["3:11:7",51,"كَذَّبُوا۟","They denied","وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ","بِـَٔايَـٰتِنَا فَأَخَذَهُمُ ٱللَّهُ",63],["3:61:25",57,"ٱلْكَـٰذِبِينَ","the liars","لَّعْنَتَ ٱللَّهِ عَلَى","",351],["3:75:34",59,"ٱلْكَذِبَ","the lie","وَيَقُولُونَ عَلَى ٱللَّهِ","وَهُمْ يَعْلَمُونَ",345],["3:78:27",60,"ٱلْكَذِبَ","the lie","وَيَقُولُونَ عَلَى ٱللَّهِ","وَهُمْ يَعْلَمُونَ",345],["3:94:5",62,"ٱلْكَذِبَ","[the] lie","ٱفْتَرَىٰ عَلَى ٱللَّهِ","مِنۢ بَعْدِ ذَٰلِكَ",345],["3:137:13",67,"ٱلْمُكَذِّبِينَ","(of) the deniers","كَيْفَ كَانَ عَـٰقِبَةُ","",493],["3:184:2",74,"كَذَّبُوكَ","they reject you","فَإِن","فَقَدْ كُذِّبَ رُسُلٌۭ",63],["3:184:4",74,"كُذِّبَ","were rejected","فَإِن كَذَّبُوكَ فَقَدْ","رُسُلٌۭ مِّن قَبْلِكَ",63],["4:50:6",86,"ٱلْكَذِبَ ۖ","[the] lie","يَفْتَرُونَ عَلَى ٱللَّهِ","وَكَفَىٰ بِهِۦٓ إِثْمًۭا",345],["5:10:3",109,"وَكَذَّبُوا۟","and deny","وَٱلَّذِينَ كَفَرُوا۟","بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ",63],["5:41:21",114,"لِلْكَذِبِ","to falsehood","ٱلَّذِينَ هَادُوا۟ ۛ سَمَّـٰعُونَ","سَمَّـٰعُونَ لِقَوْمٍ ءَاخَرِينَ",345],["5:42:2",115,"لِلْكَذِبِ","to [the] falsehood","سَمَّـٰعُونَ","أَكَّـٰلُونَ لِلسُّحْتِ ۚ فَإِن",345],["5:70:17",119,"كَذَّبُوا۟","they denied","تَهْوَىٰٓ أَنفُسُهُمْ فَرِيقًۭا","وَفَرِيقًۭا يَقْتُلُونَ",63],["5:86:3",122,"وَكَذَّبُوا۟","and denied","وَٱلَّذِينَ كَفَرُوا۟","بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ",63],["5:103:18",124,"ٱلْكَذِبَ ۖ","the lie","يَفْتَرُونَ عَلَى ٱللَّهِ","وَأَكْثَرُهُمْ لَا يَعْقِلُونَ",345],["6:5:2",128,"كَذَّبُوا۟","they denied","فَقَدْ","بِٱلْحَقِّ لَمَّا جَآءَهُمْ ۖ",63],["6:11:10",129,"ٱلْمُكَذِّبِينَ","(of) the rejecters","كَيْفَ كَانَ عَـٰقِبَةُ","",493],["6:21:7",130,"كَذِبًا","a lie","ٱفْتَرَىٰ عَلَى ٱللَّهِ","أَوْ كَذَّبَ بِـَٔايَـٰتِهِۦٓ ۗ",345],["6:21:9",130,"كَذَّبَ","rejects","ٱللَّهِ كَذِبًا أَوْ","بِـَٔايَـٰتِهِۦٓ ۗ إِنَّهُۥ لَا",63],["6:24:3",130,"كَذَبُوا۟","they lied","ٱنظُرْ كَيْفَ","عَلَىٰٓ أَنفُسِهِمْ ۚ وَضَلَّ",785],["6:27:11",130,"نُكَذِّبَ","we would deny","يَـٰلَيْتَنَا نُرَدُّ وَلَا","بِـَٔايَـٰتِ رَبِّنَا وَنَكُونَ",63],["6:28:16",131,"لَكَـٰذِبُونَ","certainly are liars","نُهُوا۟ عَنْهُ وَإِنَّهُمْ","",351],["6:31:4",131,"كَذَّبُوا۟","denied","قَدْ خَسِرَ ٱلَّذِينَ","بِلِقَآءِ ٱللَّهِ ۖ حَتَّىٰٓ",63],["6:33:9",131,"يُكَذِّبُونَكَ","deny you","يَقُولُونَ ۖ فَإِنَّهُمْ لَا","وَلَـٰكِنَّ ٱلظَّـٰلِمِينَ بِـَٔايَـٰتِ",63],["6:34:2",131,"كُذِّبَتْ","were rejected","وَلَقَدْ","رُسُلٌۭ مِّن قَبْلِكَ",63],["6:34:9",131,"كُذِّبُوا۟","they were rejected","فَصَبَرُوا۟ عَلَىٰ مَا","وَأُوذُوا۟ حَتَّىٰٓ أَتَىٰهُمْ",63],["6:39:2",132,"كَذَّبُوا۟","rejected","وَٱلَّذِينَ","بِـَٔايَـٰتِنَا صُمٌّۭ وَبُكْمٌۭ",63],["6:49:2",133,"كَذَّبُوا۟","denied","وَٱلَّذِينَ","بِـَٔايَـٰتِنَا يَمَسُّهُمُ ٱلْعَذَابُ",63],["6:57:7",134,"وَكَذَّبْتُم","while you deny","بَيِّنَةٍۢ مِّن رَّبِّى","بِهِۦ ۚ مَا عِندِى",63],["6:66:1",135,"وَكَذَّبَ","But denied","","بِهِۦ قَوْمُكَ وَهُوَ",63],["6:93:7",139,"كَذِبًا","a lie","ٱفْتَرَىٰ عَلَى ٱللَّهِ","أَوْ قَالَ أُوحِىَ",345],["6:144:30",147,"كَذِبًۭا","a lie","ٱفْتَرَىٰ عَلَى ٱللَّهِ","لِّيُضِلَّ ٱلنَّاسَ بِغَيْرِ",345],["6:147:2",148,"كَذَّبُوكَ","they deny you","فَإِن","فَقُل رَّبُّكُمْ ذُو",63],["6:148:16",148,"كَذَّبَ","denied","مِن شَىْءٍۢ ۚ كَذَٰلِكَ","ٱلَّذِينَ مِن قَبْلِهِمْ",63],["6:150:19",148,"كَذَّبُوا۟","denied","تَتَّبِعْ أَهْوَآءَ ٱلَّذِينَ","بِـَٔايَـٰتِنَا وَٱلَّذِينَ لَا",63],["6:157:21",149,"كَذَّبَ","denies","فَمَنْ أَظْلَمُ مِمَّن","بِـَٔايَـٰتِ ٱللَّهِ وَصَدَفَ",63],["7:36:2",154,"كَذَّبُوا۟","deny","وَٱلَّذِينَ","بِـَٔايَـٰتِنَا وَٱسْتَكْبَرُوا۟ عَنْهَآ",63],["7:37:7",154,"كَذِبًا","a lie","ٱفْتَرَىٰ عَلَى ٱللَّهِ","أَوْ كَذَّبَ بِـَٔايَـٰتِهِۦٓ ۚ",345],["7:37:9",154,"كَذَّبَ","denies","ٱللَّهِ كَذِبًا أَوْ","بِـَٔايَـٰتِهِۦٓ ۚ أُو۟لَـٰٓئِكَ يَنَالُهُمْ",63],["7:40:3",155,"كَذَّبُوا۟","denied","إِنَّ ٱلَّذِينَ","بِـَٔايَـٰتِنَا وَٱسْتَكْبَرُوا۟ عَنْهَا",63],["7:64:1",158,"فَكَذَّبُوهُ","But they denied him","","فَأَنجَيْنَـٰهُ وَٱلَّذِينَ مَعَهُۥ",63],["7:64:9",158,"كَذَّبُوا۟","denied","ٱلْفُلْكِ وَأَغْرَقْنَا ٱلَّذِينَ","بِـَٔايَـٰتِنَآ ۚ إِنَّهُمْ كَانُوا۟",63],["7:66:14",158,"ٱلْكَـٰذِبِينَ","the liars","وَإِنَّا لَنَظُنُّكَ مِنَ","",351],["7:72:9",159,"كَذَّبُوا۟","denied","وَقَطَعْنَا دَابِرَ ٱلَّذِينَ","بِـَٔايَـٰتِنَا ۖ وَمَا كَانُوا۟",63],["7:89:5",162,"كَذِبًا","a lie","ٱفْتَرَيْنَا عَلَى ٱللَّهِ","إِنْ عُدْنَا فِى",345],["7:92:2",162,"كَذَّبُوا۟","denied","ٱلَّذِينَ","شُعَيْبًۭا كَأَن لَّمْ",63],["7:92:9",162,"كَذَّبُوا۟","denied","يَغْنَوْا۟ فِيهَا ۚ ٱلَّذِينَ","شُعَيْبًۭا كَانُوا۟ هُمُ",63],["7:96:14",163,"كَذَّبُوا۟","they denied","ٱلسَّمَآءِ وَٱلْأَرْضِ وَلَـٰكِن","فَأَخَذْنَـٰهُم بِمَا كَانُوا۟",63],["7:101:15",163,"كَذَّبُوا۟","they (had) denied","كَانُوا۟ لِيُؤْمِنُوا۟ بِمَا","مِن قَبْلُ ۚ كَذَٰلِكَ",63],["7:136:7",166,"كَذَّبُوا۟","denied","فِى ٱلْيَمِّ بِأَنَّهُمْ","بِـَٔايَـٰتِنَا وَكَانُوا۟ عَنْهَا",63],["7:146:32",168,"كَذَّبُوا۟","denied","سَبِيلًۭا ۚ ذَٰلِكَ بِأَنَّهُمْ","بِـَٔايَـٰتِنَا وَكَانُوا۟ عَنْهَا",63],["7:147:2",168,"كَذَّبُوا۟","denied","وَٱلَّذِينَ","بِـَٔايَـٰتِنَا وَلِقَآءِ ٱلْـَٔاخِرَةِ",63],["7:176:25",173,"كَذَّبُوا۟","denied","مَثَلُ ٱلْقَوْمِ ٱلَّذِينَ","بِـَٔايَـٰتِنَا ۚ فَٱقْصُصِ ٱلْقَصَصَ",63],["7:177:5",173,"كَذَّبُوا۟","denied","مَثَلًا ٱلْقَوْمُ ٱلَّذِينَ","بِـَٔايَـٰتِنَا وَأَنفُسَهُمْ كَانُوا۟",63],["7:182:2",174,"كَذَّبُوا۟","denied","وَٱلَّذِينَ","بِـَٔايَـٰتِنَا سَنَسْتَدْرِجُهُم مِّنْ",63],["8:54:7",184,"كَذَّبُوا۟","They denied","وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ","بِـَٔايَـٰتِ رَبِّهِمْ فَأَهْلَكْنَـٰهُم",63],["9:42:23",194,"لَكَـٰذِبُونَ","(are) surely liars","وَٱللَّهُ يَعْلَمُ إِنَّهُمْ","",351],["9:43:13",194,"ٱلْكَـٰذِبِينَ","the liars","ٱلَّذِينَ صَدَقُوا۟ وَتَعْلَمَ","",351],["9:77:15",199,"يَكْذِبُونَ","lie","وَعَدُوهُ وَبِمَا كَانُوا۟","",785],["9:90:9",201,"كَذَبُوا۟","lied","لَهُمْ وَقَعَدَ ٱلَّذِينَ","ٱللَّهَ وَرَسُولَهُۥ ۚ سَيُصِيبُ",785],["9:107:24",204,"لَكَـٰذِبُونَ","(are) surely liars","وَٱللَّهُ يَشْهَدُ إِنَّهُمْ","",351],["10:17:7",210,"كَذِبًا","a lie","ٱفْتَرَىٰ عَلَى ٱللَّهِ","أَوْ كَذَّبَ بِـَٔايَـٰتِهِۦٓ ۚ",345],["10:17:9",210,"كَذَّبَ","denies","ٱللَّهِ كَذِبًا أَوْ","بِـَٔايَـٰتِهِۦٓ ۚ إِنَّهُۥ لَا",63],["10:39:2",213,"كَذَّبُوا۟","they denied","بَلْ","بِمَا لَمْ يُحِيطُوا۟",63],["10:39:11",213,"كَذَّبَ","denied","يَأْتِهِمْ تَأْوِيلُهُۥ ۚ كَذَٰلِكَ","ٱلَّذِينَ مِن قَبْلِهِمْ ۖ",63],["10:41:2",213,"كَذَّبُوكَ","they deny you","وَإِن","فَقُل لِّى عَمَلِى",63],["10:45:15",214,"كَذَّبُوا۟","denied","قَدْ خَسِرَ ٱلَّذِينَ","بِلِقَآءِ ٱللَّهِ وَمَا",63],["10:60:7",215,"ٱلْكَذِبَ","the lie","يَفْتَرُونَ عَلَى ٱللَّهِ","يَوْمَ ٱلْقِيَـٰمَةِ ۗ إِنَّ",345],["10:69:7",216,"ٱلْكَذِبَ","the lie","يَفْتَرُونَ عَلَى ٱللَّهِ","لَا يُفْلِحُونَ",345],["10:73:1",217,"فَكَذَّبُوهُ","But they denied him","","فَنَجَّيْنَـٰهُ وَمَن مَّعَهُۥ",63],["10:73:11",217,"كَذَّبُوا۟","denied","خَلَـٰٓئِفَ وَأَغْرَقْنَا ٱلَّذِينَ","بِـَٔايَـٰتِنَا ۖ فَٱنظُرْ كَيْفَ",63],["10:74:14",217,"كَذَّبُوا۟","they had denied","كَانُوا۟ لِيُؤْمِنُوا۟ بِمَا","بِهِۦ مِن قَبْلُ ۚ",63],["10:95:5",219,"كَذَّبُوا۟","deny","تَكُونَنَّ مِنَ ٱلَّذِينَ","بِـَٔايَـٰتِ ٱللَّهِ فَتَكُونَ",63],["11:18:7",223,"كَذِبًا ۚ","a lie","ٱفْتَرَىٰ عَلَى ٱللَّهِ","أُو۟لَـٰٓئِكَ يُعْرَضُونَ عَلَىٰ",345],["11:18:16",223,"كَذَبُوا۟","lied","ٱلْأَشْهَـٰدُ هَـٰٓؤُلَآءِ ٱلَّذِينَ","عَلَىٰ رَبِّهِمْ ۚ أَلَا",785],["11:27:29",224,"كَـٰذِبِينَ","(are) liars","فَضْلٍۭ بَلْ نَظُنُّكُمْ","",351],["11:65:11",229,"مَكْذُوبٍۢ","(to) be belied","ذَٰلِكَ وَعْدٌ غَيْرُ","",3674],["11:93:15",232,"كَـٰذِبٌۭ ۖ","(is) a liar","يُخْزِيهِ وَمَنْ هُوَ","وَٱرْتَقِبُوٓا۟ إِنِّى مَعَكُمْ",351],["12:18:5",237,"كَذِبٍۢ ۚ","with false blood","عَلَىٰ قَمِيصِهِۦ بِدَمٍۢ","قَالَ بَلْ سَوَّلَتْ",345],["12:26:19",238,"ٱلْكَـٰذِبِينَ","the liars","فَصَدَقَتْ وَهُوَ مِنَ","",351],["12:27:7",238,"فَكَذَبَتْ","then she has lied","قُدَّ مِن دُبُرٍۢ","وَهُوَ مِنَ ٱلصَّـٰدِقِينَ",785],["12:74:6",244,"كَـٰذِبِينَ","liars","جَزَٰٓؤُهُۥٓ إِن كُنتُمْ","",351],["12:110:8",248,"كُذِبُوا۟","were denied","وَظَنُّوٓا۟ أَنَّهُمْ قَدْ","جَآءَهُمْ نَصْرُنَا فَنُجِّىَ",785],["15:80:2",266,"كَذَّبَ","denied","وَلَقَدْ","أَصْحَـٰبُ ٱلْحِجْرِ ٱلْمُرْسَلِينَ",63],["16:36:28",271,"ٱلْمُكَذِّبِينَ","(of) the deniers","كَيْفَ كَانَ عَـٰقِبَةُ","",493],["16:39:11",271,"كَـٰذِبِينَ","liars","كَفَرُوٓا۟ أَنَّهُمْ كَانُوا۟","",351],["16:62:7",273,"ٱلْكَذِبَ","the lie","يَكْرَهُونَ وَتَصِفُ أَلْسِنَتُهُمُ","أَنَّ لَهُمُ ٱلْحُسْنَىٰ ۖ",345],["16:86:19",276,"لَكَـٰذِبُونَ","(are) surely liars","إِلَيْهِمُ ٱلْقَوْلَ إِنَّكُمْ","",351],["16:105:3",279,"ٱلْكَذِبَ","the falsehood","إِنَّمَا يَفْتَرِى","ٱلَّذِينَ لَا يُؤْمِنُونَ",345],["16:105:11",279,"ٱلْكَـٰذِبُونَ","(are) the liars","ٱللَّهِ ۖ وَأُو۟لَـٰٓئِكَ هُمُ","",351],["16:113:5",280,"فَكَذَّبُوهُ","but they denied him","جَآءَهُمْ رَسُولٌۭ مِّنْهُمْ","فَأَخَذَهُمُ ٱلْعَذَابُ وَهُمْ",63],["16:116:6",280,"ٱلْكَذِبَ","the lie","لِمَا تَصِفُ أَلْسِنَتُكُمُ","هَـٰذَا حَلَـٰلٌۭ وَهَـٰذَا",345],["16:116:14",280,"ٱلْكَذِبَ ۚ","the lie","لِّتَفْتَرُوا۟ عَلَى ٱللَّهِ","إِنَّ ٱلَّذِينَ يَفْتَرُونَ",345],["16:116:20",280,"ٱلْكَذِبَ","the lie","يَفْتَرُونَ عَلَى ٱللَّهِ","لَا يُفْلِحُونَ",345],["17:59:8",288,"كَذَّبَ","denied","بِٱلْـَٔايَـٰتِ إِلَّآ أَن","بِهَا ٱلْأَوَّلُونَ ۚ وَءَاتَيْنَا",63],["18:5:16",294,"كَذِبًۭا","a lie","إِن يَقُولُونَ إِلَّا","",345],["18:15:18",294,"كَذِبًۭا","a lie","ٱفْتَرَىٰ عَلَى ٱللَّهِ","",345],["20:48:9",314,"كَذَّبَ","denies","ٱلْعَذَابَ عَلَىٰ مَن","وَتَوَلَّىٰ",63],["20:56:5",315,"فَكَذَّبَ","but he denied","أَرَيْنَـٰهُ ءَايَـٰتِنَا كُلَّهَا","وَأَبَىٰ",63],["20:61:9",315,"كَذِبًۭا","a lie","تَفْتَرُوا۟ عَلَى ٱللَّهِ","فَيُسْحِتَكُم بِعَذَابٍۢ ۖ وَقَدْ",345],["21:77:5",328,"كَذَّبُوا۟","denied","مِنَ ٱلْقَوْمِ ٱلَّذِينَ","بِـَٔايَـٰتِنَآ ۚ إِنَّهُمْ كَانُوا۟",63],["22:42:2",337,"يُكَذِّبُوكَ","they deny you","وَإِن","فَقَدْ كَذَّبَتْ قَبْلَهُمْ",63],["22:42:4",337,"كَذَّبَتْ","denied","وَإِن يُكَذِّبُوكَ فَقَدْ","قَبْلَهُمْ قَوْمُ نُوحٍۢ",63],["22:44:3",337,"وَكُذِّبَ","And Musa was denied","وَأَصْحَـٰبُ مَدْيَنَ ۖ","مُوسَىٰ فَأَمْلَيْتُ لِلْكَـٰفِرِينَ",63],["22:57:3",339,"وَكَذَّبُوا۟","and denied","وَٱلَّذِينَ كَفَرُوا۟","بِـَٔايَـٰتِنَا فَأُو۟لَـٰٓئِكَ لَهُمْ",63],["23:26:5",343,"كَذَّبُونِ","they deny me","رَبِّ ٱنصُرْنِى بِمَا","",63],["23:33:7",344,"وَكَذَّبُوا۟","and denied","قَوْمِهِ ٱلَّذِينَ كَفَرُوا۟","بِلِقَآءِ ٱلْـَٔاخِرَةِ وَأَتْرَفْنَـٰهُمْ",63],["23:38:8",344,"كَذِبًۭا","a lie","ٱفْتَرَىٰ عَلَى ٱللَّهِ","وَمَا نَحْنُ لَهُۥ",345],["23:39:5",344,"كَذَّبُونِ","they deny me","رَبِّ ٱنصُرْنِى بِمَا","",63],["23:44:10",345,"كَذَّبُوهُ ۚ","they denied him","جَآءَ أُمَّةًۭ رَّسُولُهَا","فَأَتْبَعْنَا بَعْضَهُم بَعْضًۭا",63],["23:48:1",345,"فَكَذَّبُوهُمَا","So they denied them","","فَكَانُوا۟ مِنَ ٱلْمُهْلَكِينَ",63],["23:90:5",348,"لَكَـٰذِبُونَ","surely, (are) liars","أَتَيْنَـٰهُم بِٱلْحَقِّ وَإِنَّهُمْ","",351],["23:105:8",349,"تُكَذِّبُونَ","deny them","عَلَيْكُمْ فَكُنتُم بِهَا","",63],["24:7:9",350,"ٱلْكَـٰذِبِينَ","the liars","إِن كَانَ مِنَ","",351],["24:8:11",350,"ٱلْكَـٰذِبِينَ","the liars","بِٱللَّهِ ۙ إِنَّهُۥ لَمِنَ","",351],["24:13:14",351,"ٱلْكَـٰذِبُونَ","(are) the liars","عِندَ ٱللَّهِ هُمُ","",351],["25:11:2",360,"كَذَّبُوا۟","they deny","بَلْ","بِٱلسَّاعَةِ ۖ وَأَعْتَدْنَا لِمَن",63],["25:11:6",360,"كَذَّبَ","deny","بِٱلسَّاعَةِ ۖ وَأَعْتَدْنَا لِمَن","بِٱلسَّاعَةِ سَعِيرًا",63],["25:19:2",361,"كَذَّبُوكُم","they deny you","فَقَدْ","بِمَا تَقُولُونَ فَمَا",63],["25:36:6",363,"كَذَّبُوا۟","have denied","إِلَى ٱلْقَوْمِ ٱلَّذِينَ","بِـَٔايَـٰتِنَا فَدَمَّرْنَـٰهُمْ تَدْمِيرًۭا",63],["25:37:4",363,"كَذَّبُوا۟","they denied","وَقَوْمَ نُوحٍۢ لَّمَّا","ٱلرُّسُلَ أَغْرَقْنَـٰهُمْ وَجَعَلْنَـٰهُمْ",63],["25:77:9",366,"كَذَّبْتُمْ","you have denied","لَوْلَا دُعَآؤُكُمْ ۖ فَقَدْ","فَسَوْفَ يَكُونُ لِزَامًۢا",63],["26:6:2",367,"كَذَّبُوا۟","they have denied","فَقَدْ","فَسَيَأْتِيهِمْ أَنۢبَـٰٓؤُا۟ مَا",63],["26:12:6",367,"يُكَذِّبُونِ","they will deny me","إِنِّىٓ أَخَافُ أَن","",63],["26:105:1",371,"كَذَّبَتْ","Denied","","قَوْمُ نُوحٍ ٱلْمُرْسَلِينَ",63],["26:117:5",372,"كَذَّبُونِ","have denied me","رَبِّ إِنَّ قَوْمِى","",63],["26:123:1",372,"كَذَّبَتْ","Denied","","عَادٌ ٱلْمُرْسَلِينَ",63],["26:139:1",373,"فَكَذَّبُوهُ","So they denied him","","فَأَهْلَكْنَـٰهُمْ ۗ إِنَّ فِى",63],["26:141:1",373,"كَذَّبَتْ","Denied","","ثَمُودُ ٱلْمُرْسَلِينَ",63],["26:160:1",374,"كَذَّبَتْ","Denied","","قَوْمُ لُوطٍ ٱلْمُرْسَلِينَ",63],["26:176:1",374,"كَذَّبَ","Denied","","أَصْحَـٰبُ لْـَٔيْكَةِ ٱلْمُرْسَلِينَ",63],["26:186:9",375,"ٱلْكَـٰذِبِينَ","the liars","وَإِن نَّظُنُّكَ لَمِنَ","",351],["26:189:1",375,"فَكَذَّبُوهُ","But they denied him","","فَأَخَذَهُمْ عَذَابُ يَوْمِ",63],["26:223:4",376,"كَـٰذِبُونَ","(are) liars","يُلْقُونَ ٱلسَّمْعَ وَأَكْثَرُهُمْ","",351],["27:27:7",379,"ٱلْكَـٰذِبِينَ","the liars","أَمْ كُنتَ مِنَ","",351],["27:83:8",384,"يُكَذِّبُ","deny","أُمَّةٍۢ فَوْجًۭا مِّمَّن","بِـَٔايَـٰتِنَا فَهُمْ يُوزَعُونَ",63],["27:84:5",384,"أَكَذَّبْتُم","Did you deny","إِذَا جَآءُو قَالَ","بِـَٔايَـٰتِى وَلَمْ تُحِيطُوا۟",63],["28:34:14",389,"يُكَذِّبُونِ","they will deny me","إِنِّىٓ أَخَافُ أَن","",63],["28:38:27",390,"ٱلْكَـٰذِبِينَ","the liars","وَإِنِّى لَأَظُنُّهُۥ مِنَ","",351],["29:3:11",396,"ٱلْكَـٰذِبِينَ","the liars","ٱلَّذِينَ صَدَقُوا۟ وَلَيَعْلَمَنَّ","",351],["29:12:18",397,"لَكَـٰذِبُونَ","(are) surely liars","مِّن شَىْءٍ ۖ إِنَّهُمْ","",351],["29:18:2",398,"تُكَذِّبُوا۟","you deny","وَإِن","فَقَدْ كَذَّبَ أُمَمٌۭ",63],["29:18:4",398,"كَذَّبَ","denied","وَإِن تُكَذِّبُوا۟ فَقَدْ","أُمَمٌۭ مِّن قَبْلِكُمْ ۖ",63],["29:37:1",400,"فَكَذَّبُوهُ","But they denied him","","فَأَخَذَتْهُمُ ٱلرَّجْفَةُ فَأَصْبَحُوا۟",63],["29:68:7",404,"كَذِبًا","a lie","ٱفْتَرَىٰ عَلَى ٱللَّهِ","أَوْ كَذَّبَ بِٱلْحَقِّ",345],["29:68:9",404,"كَذَّبَ","denies","