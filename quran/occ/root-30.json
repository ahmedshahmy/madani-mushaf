2,"وَكَذَّبَ","and denies","كَذَبَ عَلَى ٱللَّهِ","بِٱلصِّدْقِ إِذْ جَآءَهُۥٓ ۚ",63],["39:59:5",465,"فَكَذَّبْتَ","but you denied","قَدْ جَآءَتْكَ ءَايَـٰتِى","بِهَا وَٱسْتَكْبَرْتَ وَكُنتَ",63],["39:60:5",465,"كَذَبُوا۟","lied","ٱلْقِيَـٰمَةِ تَرَى ٱلَّذِينَ","عَلَى ٱللَّهِ وُجُوهُهُم",785],["40:5:1",467,"كَذَّبَتْ","Denied","","قَبْلَهُمْ قَوْمُ نُوحٍۢ",63],["40:24:7",469,"كَذَّابٌۭ","a liar","وَقَـٰرُونَ فَقَالُوا۟ سَـٰحِرٌۭ","",1345],["40:28:22",470,"كَـٰذِبًۭا","a liar","رَّبِّكُمْ ۖ وَإِن يَكُ","فَعَلَيْهِ كَذِبُهُۥ ۖ وَإِن",351],["40:28:24",470,"كَذِبُهُۥ ۖ","(is) his lie","يَكُ كَـٰذِبًۭا فَعَلَيْهِ","وَإِن يَكُ صَادِقًۭا",345],["40:28:39",470,"كَذَّابٌۭ","a liar","مَنْ هُوَ مُسْرِفٌۭ","",1345],["40:37:9",471,"كَـٰذِبًۭا ۚ","(to be) a liar","مُوسَىٰ وَإِنِّى لَأَظُنُّهُۥ","وَكَذَٰلِكَ زُيِّنَ لِفِرْعَوْنَ",351],["40:70:2",475,"كَذَّبُوا۟","deny","ٱلَّذِينَ","بِٱلْكِتَـٰبِ وَبِمَآ أَرْسَلْنَا",63],["42:24:6",486,"كَذِبًۭا ۖ","a lie","ٱفْتَرَىٰ عَلَى ٱللَّهِ","فَإِن يَشَإِ ٱللَّهُ",345],["43:25:7",491,"ٱلْمُكَذِّبِينَ","(of) the deniers","كَيْفَ كَانَ عَـٰقِبَةُ","",493],["50:5:2",518,"كَذَّبُوا۟","they denied","بَلْ","بِٱلْحَقِّ لَمَّا جَآءَهُمْ",63],["50:12:1",518,"كَذَّبَتْ","Denied","","قَبْلَهُمْ قَوْمُ نُوحٍۢ",63],["50:14:6",518,"كَذَّبَ","denied","وَقَوْمُ تُبَّعٍۢ ۚ كُلٌّۭ","ٱلرُّسُلَ فَحَقَّ وَعِيدِ",63],["52:11:3",523,"لِّلْمُكَذِّبِينَ","to the deniers","فَوَيْلٌۭ يَوْمَئِذٍۢ","",493],["52:14:6",523,"تُكَذِّبُونَ","deny","ٱلَّتِى كُنتُم بِهَا","",63],["53:11:2",526,"كَذَبَ","lied","مَا","ٱلْفُؤَادُ مَا رَأَىٰٓ",785],["54:3:1",528,"وَكَذَّبُوا۟","And they denied","","وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ",63],["54:9:1",529,"۞ كَذَّبَتْ","Denied","","قَبْلَهُمْ قَوْمُ نُوحٍۢ",63],["54:9:5",529,"فَكَذَّبُوا۟","and they denied","قَبْلَهُمْ قَوْمُ نُوحٍۢ","عَبْدَنَا وَقَالُوا۟ مَجْنُونٌۭ",63],["54:18:1",529,"كَذَّبَتْ","Denied","","عَادٌۭ فَكَيْفَ كَانَ",63],["54:23:1",529,"كَذَّبَتْ","Denied","","ثَمُودُ بِٱلنُّذُرِ",63],["54:25:8",529,"كَذَّابٌ",