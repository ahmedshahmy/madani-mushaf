[["2:42:4",7,"بِٱلْبَـٰطِلِ","with [the] falsehood","وَلَا تَلْبِسُوا۟ ٱلْحَقَّ","وَتَكْتُمُوا۟ ٱلْحَقَّ وَأَنتُمْ",412],["2:188:5",29,"بِٱلْبَـٰطِلِ","wrongfully","تَأْكُلُوٓا۟ أَمْوَٰلَكُم بَيْنَكُم","وَتُدْلُوا۟ بِهَآ إِلَى",412],["2:264:5",44,"تُبْطِلُوا۟","render in vain","ٱلَّذِينَ ءَامَنُوا۟ لَا","صَدَقَـٰتِكُم بِٱلْمَنِّ وَٱلْأَذَىٰ",1683],["3:71:6",59,"بِٱلْبَـٰطِلِ","with the falsehood","لِمَ تَلْبِسُونَ ٱلْحَقَّ","وَتَكْتُمُونَ ٱلْحَقَّ وَأَنتُمْ",412],["3:191:17",75,"بَـٰطِلًۭا","(in) vain","مَا خَلَقْتَ هَـٰذَا","سُبْحَـٰنَكَ فَقِنَا عَذَابَ",412],["4:29:8",83,"بِٱلْبَـٰطِلِ","unjustly","تَأْكُلُوٓا۟ أَمْوَٰلَكُم بَيْنَكُم","إِلَّآ أَن تَكُونَ",412],["4:161:9",103,"بِٱلْبَـٰطِلِ ۚ","wrongfully","وَأَكْلِهِمْ أَمْوَٰلَ ٱلنَّاسِ","وَأَعْتَدْنَا لِلْكَـٰفِرِينَ مِنْهُمْ",412],["7:118:3",164,"وَبَطَلَ","and became futile","فَوَقَعَ ٱلْحَقُّ","مَا كَانُوا۟ يَعْمَلُونَ",3327],["7:139:7",167,"وَبَـٰطِلٌۭ","and vain","مَّا هُمْ فِيهِ","مَّا كَانُوا۟ يَعْمَلُونَ",412],["7:173:15",173,"ٱلْمُبْطِلُونَ","the falsifiers","أَفَتُهْلِكُنَا بِمَا فَعَلَ","",1362],["8:8:3",177,"وَيُبْطِلَ","and prove false","لِيُحِقَّ ٱلْحَقَّ","ٱلْبَـٰطِلَ وَلَوْ كَرِهَ",1683],["8:8:4",177,"ٱلْبَـٰطِلَ","the falsehood","لِيُحِقَّ ٱلْحَقَّ وَيُبْطِلَ","وَلَوْ كَرِهَ ٱلْمُجْرِمُونَ",412],["9:34:12",192,"بِٱلْبَـٰطِلِ","in falsehood","لَيَأْكُلُونَ أَمْوَٰلَ ٱلنَّاسِ","وَيَصُدُّونَ عَن سَبِيلِ",412],["10:81:11",218,"سَيُبْطِلُهُۥٓ ۖ","will nullify it","ٱلسِّحْرُ ۖ إِنَّ ٱللَّهَ","إِنَّ ٱللَّهَ لَا",1683],["11:16:13",223,"وَبَـٰطِلٌۭ","and (is) worthless","مَا صَنَعُوا۟ فِيهَا","مَّا كَانُوا۟ يَعْمَلُونَ",412],["13:17:27",251,"وَٱلْبَـٰطِلَ ۚ","and the falsehood","يَضْرِبُ ٱللَّهُ ٱلْحَقَّ","فَأَمَّا ٱلزَّبَدُ فَيَذْهَبُ",412],["16:72:16",274,"أَفَبِٱلْبَـٰطِلِ","Then in falsehood do","وَرَزَقَكُم مِّنَ ٱلطَّيِّبَـٰتِ ۚ","يُؤْمِنُونَ وَبِنِعْمَتِ ٱللَّهِ",412],["17:81:5",290,"ٱلْبَـٰطِلُ ۚ","the falsehood","جَآءَ ٱلْحَقُّ وَزَهَقَ","إِنَّ ٱلْبَـٰطِلَ كَانَ",412],["17:81:7",290,"ٱلْبَـٰطِلَ","the falsehood","وَزَهَقَ ٱلْبَـٰطِلُ ۚ إِنَّ","كَانَ زَهُوقًۭا",412],["18:56:10",300,"بِٱلْبَـٰطِلِ","with falsehood","وَيُجَـٰدِلُ ٱلَّذِينَ كَفَرُوا۟","لِيُدْحِضُوا۟ بِهِ ٱلْحَقَّ ۖ",412],["21:18:5",323,"ٱلْبَـٰطِلِ","[the] falsehood","نَقْذِفُ بِٱلْحَقِّ عَلَى","فَيَدْمَغُهُۥ فَإِذَا هُوَ",412],["22:62:12",339,"ٱلْبَـٰطِلُ","(is) the falsehood","مِن دُونِهِۦ هُوَ","وَأَنَّ ٱللَّهَ هُوَ",412],["29:48:13",402,"ٱلْمُبْطِلُونَ","the falsifiers","بِيَمِينِكَ ۖ إِذًۭا لَّٱرْتَابَ","",1362],["29:52:14",402,"بِٱلْبَـٰطِلِ","in [the] falsehood","وَٱلْأَرْضِ ۗ وَٱلَّذِينَ ءَامَنُوا۟","وَكَفَرُوا۟ بِٱللَّهِ أُو۟لَـٰٓئِكَ",412],["29:67:11",404,"أَفَبِٱلْبَـٰطِلِ","Then do in (the) falsehood","ٱلنَّاسُ مِنْ حَوْلِهِمْ ۚ","يُؤْمِنُونَ وَبِنِعْمَةِ ٱللَّهِ",412],["30:58:19",410,"مُبْطِلُونَ","falsifiers","إِنْ أَنتُمْ إِلَّا","",1362],["31:30:11",414,"ٱلْبَـٰطِلُ","(is) [the] falsehood","يَدْعُونَ مِن دُونِهِ","وَأَنَّ ٱللَّهَ هُوَ",412],["34:49:6",434,"ٱلْبَـٰطِلُ","the falsehood","ٱلْحَقُّ وَمَا يُبْدِئُ","وَمَا يُعِيدُ",412],["38:27:7",455,"بَـٰطِلًۭا ۚ","without purpose","وَٱلْأَرْضَ وَمَا بَيْنَهُمَا","ذَٰلِكَ ظَنُّ ٱلَّذِينَ",412],["40:5:14",467,"بِٱلْبَـٰطِلِ","by falsehood","بِرَسُولِهِمْ لِيَأْخُذُوهُ ۖ وَجَـٰدَلُوا۟","لِيُدْحِضُوا۟ بِهِ ٱلْحَقَّ",412],["40:78:32",476,"ٱلْمُبْطِلُونَ","the falsifiers","بِٱلْحَقِّ وَخَسِرَ هُنَالِكَ","",1362],["41:42:3",481,"ٱلْبَـٰطِلُ","the falsehood","لَّا يَأْتِيهِ","مِنۢ بَيْنِ يَدَيْهِ",412],["42:24:15",486,"ٱلْبَـٰطِلَ","the falsehood","قَلْبِكَ ۗ وَيَمْحُ ٱللَّهُ","وَيُحِقُّ ٱلْحَقَّ بِكَلِمَـٰتِهِۦٓ ۚ",412],["45:27:10",501,"ٱلْمُبْطِلُونَ","the falsifiers","ٱلسَّاعَةُ يَوْمَئِذٍۢ يَخْسَرُ","",1362],["47:3:6",507,"ٱلْبَـٰطِلَ","falsehood","ٱلَّذِينَ كَفَرُوا۟ ٱتَّبَعُوا۟","وَأَنَّ ٱلَّذِينَ ءَامَنُوا۟",412],["47:33:9",510,"تُبْطِلُوٓا۟","make vain","وَأَطِيعُوا۟ ٱلرَّسُولَ وَلَا","أَعْمَـٰلَكُمْ",1683]]