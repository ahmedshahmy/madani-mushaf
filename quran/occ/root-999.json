[["13:39:1",254,"يَمْحُوا۟","(Is) eliminated","","ٱللَّهُ مَا يَشَآءُ",1882],["17:12:5",283,"فَمَحَوْنَآ","Then We erased","ٱلَّيْلَ وَٱلنَّهَارَ ءَايَتَيْنِ ۖ","ءَايَةَ ٱلَّيْلِ وَجَعَلْنَآ",1882],["42:24:13",486,"وَيَمْحُ","And Allah eliminates","يَخْتِمْ عَلَىٰ قَلْبِكَ ۗ","ٱللَّهُ ٱلْبَـٰطِلَ وَيُحِقُّ",1882]]