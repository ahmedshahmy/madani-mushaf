[["2:234:4",38,"وَيَذَرُونَ","and leave behind","وَٱلَّذِينَ يُتَوَفَّوْنَ مِنكُمْ","أَزْوَٰجًۭا يَتَرَبَّصْنَ بِأَنفُسِهِنَّ",262],["2:240:4",39,"وَيَذَرُونَ","and leave behind","وَٱلَّذِينَ يُتَوَفَّوْنَ مِنكُمْ","أَزْوَٰجًۭا وَصِيَّةًۭ لِّأَزْوَٰجِهِم",262],["2:278:6",47,"وَذَرُوا۟","and give up","ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ","مَا بَقِىَ مِنَ",262],["3:179:4",73,"لِيَذَرَ","to leave","مَّا كَانَ ٱللَّهُ","ٱلْمُؤْمِنِينَ عَلَىٰ مَآ",262],["4:129:13",99,"فَتَذَرُوهَا","and leave her (the other)","تَمِيلُوا۟ كُلَّ ٱلْمَيْلِ","كَٱلْمُعَلَّقَةِ ۚ وَإِن تُصْلِحُوا۟",262],["6:70:1",136,"وَذَرِ","And leave","","ٱلَّذِينَ ٱتَّخَذُوا۟ دِينَهُمْ",262],["6:91:41",139,"ذَرْهُمْ","leave them","قُلِ ٱللَّهُ ۖ ثُمَّ","فِى خَوْضِهِمْ يَلْعَبُونَ",262],["6:110:10",141,"وَنَذَرُهُمْ","And We will leave them","بِهِۦٓ أَوَّلَ مَرَّةٍۢ","فِى طُغْيَـٰنِهِمْ يَعْمَهُونَ",262],["6:112:21",142,"فَذَرْهُمْ","so leave them","رَبُّكَ مَا فَعَلُوهُ ۖ","وَمَا يَفْتَرُونَ",262],["6:120:1",143,"وَذَرُوا۟","Forsake","","ظَـٰهِرَ ٱلْإِثْمِ وَبَاطِنَهُۥٓ ۚ",262],["6:137:18",145,"فَذَرْهُمْ","So leave them","ٱللَّهُ مَا فَعَلُوهُ ۖ","وَمَا يَفْتَرُونَ",262],["7:70:6",159,"وَنَذَرَ","and we forsake","لِنَعْبُدَ ٱللَّهَ وَحْدَهُۥ","مَا كَانَ يَعْبُدُ",262],["7:73:24",159,"فَذَرُوهَا","So you leave her","ٱللَّهِ لَكُمْ ءَايَةًۭ ۖ","تَأْكُلْ فِىٓ أَرْضِ",262],["7:127:6",165,"أَتَذَرُ","Will you leave","مِن قَوْمِ فِرْعَوْنَ","مُوسَىٰ وَقَوْمَهُۥ لِيُفْسِدُوا۟",262],["7:127:12",165,"وَيَذَرَكَ","and forsake you","لِيُفْسِدُوا۟ فِى ٱلْأَرْضِ","وَءَالِهَتَكَ ۚ قَالَ سَنُقَتِّلُ",262],["7:180:6",174,"وَذَرُوا۟","And leave","ٱلْحُسْنَىٰ فَٱدْعُوهُ بِهَا ۖ","ٱلَّذِينَ يُلْحِدُونَ فِىٓ",262],["7:186:7",174,"وَيَذَرُهُمْ","And He leaves them","فَلَا هَادِىَ لَهُۥ ۚ","فِى طُغْيَـٰنِهِمْ يَعْمَهُونَ",262],["9:86:15",200,"ذَرْنَا","Leave us","ٱلطَّوْلِ مِنْهُمْ وَقَالُوا۟","نَكُن مَّعَ ٱلْقَـٰعِدِينَ",262],["10:11:11",209,"فَنَذَرُ","But We leave","لَقُضِىَ إِلَيْهِمْ أَجَلُهُمْ ۖ","ٱلَّذِينَ لَا يَرْجُونَ",262],["11:64:7",229,"فَذَرُوهَا","so leave her","ٱللَّهِ لَكُمْ ءَايَةًۭ","تَأْكُلْ فِىٓ أَرْضِ",262],["12:47:8",241,"فَذَرُوهُ","so leave it","دَأَبًۭا فَمَا حَصَدتُّمْ","فِى سُنۢبُلِهِۦٓ إِلَّا",262],["15:3:1",262,"ذَرْهُمْ","Leave them","","يَأْكُلُوا۟ وَيَتَمَتَّعُوا۟ وَيُلْهِهِمُ",262],["19:72:5",310,"وَّنَذَرُ","and We will leave","نُنَجِّى ٱلَّذِينَ ٱتَّقَوا۟","ٱلظَّـٰلِمِينَ فِيهَا جِثِيًّۭا",262],["20:106:1",319,"فَيَذَرُهَا","Then He will leave it","","قَاعًۭا صَفْصَفًۭا",262],["21:89:7",329,"تَذَرْنِى","leave me","رَبَّهُۥ رَبِّ لَا","فَرْدًۭا وَأَنتَ خَيْرُ",262],["23:54:1",345,"فَذَرْهُمْ","So leave them","","فِى غَمْرَتِهِمْ حَتَّىٰ",262],["26:166:1",374,"وَتَذَرُونَ","And you leave","","مَا خَلَقَ لَكُمْ",262],["37:125:3",450,"وَتَذَرُونَ","and you forsake","أَتَدْعُونَ بَعْلًۭا","أَحْسَنَ ٱلْخَـٰلِقِينَ",262],["40:26:3",470,"ذَرُونِىٓ","Leave me","وَقَالَ فِرْعَوْنُ","أَقْتُلْ مُوسَىٰ وَلْيَدْعُ",262],["43:83:1",495,"فَذَرْهُمْ","So leave them","","يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ",262],["48:15:8",512,"ذَرُونَا","Allow us","إِلَىٰ مَغَانِمَ لِتَأْخُذُوهَا","نَتَّبِعْكُمْ ۖ يُرِيدُونَ أَن",262],["51:42:2",522,"تَذَرُ","it left","مَا","مِن شَىْءٍ أَتَتْ",262],["52:45:1",525,"فَذَرْهُمْ","So leave them","","حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ",262],["62:9:14",554,"وَذَرُوا۟","and leave","إِلَىٰ ذِكْرِ ٱللَّهِ","ٱلْبَيْعَ ۚ ذَٰلِكُمْ خَيْرٌۭ",262],["68:44:1",566,"فَذَرْنِى","So leave Me","","وَمَن يُكَذِّبُ بِهَـٰذَا",262],["70:42:1",570,"فَذَرْهُمْ","So leave them","","يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ",262],["71:23:3",571,"تَذَرُنَّ","leave","وَقَالُوا۟ لَا","ءَالِهَتَكُمْ وَلَا تَذَرُنَّ",262],["71:23:6",571,"تَذَرُنَّ","leave","تَذَرُنَّ ءَالِهَتَكُمْ وَلَا","وَدًّۭا وَلَا سُوَاعًۭا",262],["71:26:5",571,"تَذَرْ","leave","نُوحٌۭ رَّبِّ لَا","عَلَى ٱلْأَرْضِ مِنَ",262],["71:27:3",571,"تَذَرْهُمْ","You leave them","إِنَّكَ إِن","يُضِلُّوا۟ عِبَادَكَ وَلَا",262],["73:11:1",574,"وَذَرْنِى","And leave Me","","وَٱلْمُكَذِّبِينَ أُو۟لِى ٱلنَّعْمَةِ",262],["74:11:1",575,"ذَرْنِى","Leave Me","","وَمَنْ خَلَقْتُ وَحِيدًۭا",262],["74:28:4",576,"تَذَرُ","it leaves","لَا تُبْقِى وَلَا","",262],["75:21:1",578,"وَتَذَرُونَ","And leave","","ٱلْـَٔاخِرَةَ",262],["76:27:5",580,"وَيَذَرُونَ","and leave","هَـٰٓؤُلَآءِ يُحِبُّونَ ٱلْعَاجِلَةَ","وَرَآءَهُمْ يَوْمًۭا ثَقِيلًۭا",262]]