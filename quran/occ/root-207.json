[["2:95:5",15,"قَدَّمَتْ","(of what) sent ahead","يَتَمَنَّوْهُ أَبَدًۢا بِمَا","أَيْدِيهِمْ ۗ وَٱللَّهُ عَلِيمٌۢ",405],["2:110:6",17,"تُقَدِّمُوا۟","you send forth","وَءَاتُوا۟ ٱلزَّكَوٰةَ ۚ وَمَا","لِأَنفُسِكُم مِّنْ خَيْرٍۢ",405],["2:223:8",35,"وَقَدِّمُوا۟","and send forth (good deeds)","حَرْثَكُمْ أَنَّىٰ شِئْتُمْ ۖ","لِأَنفُسِكُمْ ۚ وَٱتَّقُوا۟ ٱللَّهَ",405],["2:250:11",41,"أَقْدَامَنَا","our feet","عَلَيْنَا صَبْرًۭا وَثَبِّتْ","وَٱنصُرْنَا عَلَى ٱلْقَوْمِ",996],["3:147:15",68,"أَقْدَامَنَا","our feet","فِىٓ أَمْرِنَا وَثَبِّتْ","وَٱنصُرْنَا عَلَى ٱلْقَوْمِ",996],["3:182:3",74,"قَدَّمَتْ","(of what) sent forth","ذَٰلِكَ بِمَا","أَيْدِيكُمْ وَأَنَّ ٱللَّهَ",405],["4:62:6",88,"قَدَّمَتْ","sent forth","أَصَـٰبَتْهُم مُّصِيبَةٌۢ بِمَا","أَيْدِيهِمْ ثُمَّ جَآءُوكَ",405],["5:80:9",121,"قَدَّمَتْ","sent forth","كَفَرُوا۟ ۚ لَبِئْسَ مَا","لَهُمْ أَنفُسُهُمْ أَن",405],["7:34:11",154,"يَسْتَقْدِمُونَ","seek to advance (it)","يَسْتَأْخِرُونَ سَاعَةًۭ ۖ وَلَا","",1672],["8:11:22",178,"ٱلْأَقْدَامَ","your feet","قُلُوبِكُمْ وَيُثَبِّتَ بِهِ","",996],["8:51:3",183,"قَدَّمَتْ","sent forth","ذَٰلِكَ بِمَا","أَيْدِيكُمْ وَأَنَّ ٱللَّهَ",405],["10:2:17",208,"قَدَمَ","(will be) a respectable position","ءَامَنُوٓا۟ أَنَّ لَهُمْ","صِدْقٍ عِندَ رَبِّهِمْ ۗ",996],["10:49:22",214,"يَسْتَقْدِمُونَ","they can precede (it)","يَسْتَـْٔخِرُونَ سَاعَةًۭ ۖ وَلَا","",1672],["11:98:1",233,"يَقْدُمُ","He will precede","","قَوْمَهُۥ يَوْمَ ٱلْقِيَـٰمَةِ",2578],["12:48:10",241,"قَدَّمْتُمْ","you advanced","شِدَادٌۭ يَأْكُلْنَ مَا","لَهُنَّ إِلَّا قَلِيلًۭا",405],["12:95:6",246,"ٱلْقَدِيمِ","old","إِنَّكَ لَفِى ضَلَـٰلِكَ","",1956],["15:24:3",263,"ٱلْمُسْتَقْدِمِينَ","the preceding ones","وَلَقَدْ عَلِمْنَا","مِنكُمْ وَلَقَدْ عَلِمْنَا",3861],["16:61:23",273,"يَسْتَقْدِمُونَ","they can advance (it)","يَسْتَـْٔخِرُونَ سَاعَةًۭ ۖ وَلَا","",1672],["16:94:7",278,"قَدَمٌۢ","a foot","دَخَلًۢا بَيْنَكُمْ فَتَزِلَّ","بَعْدَ ثُبُوتِهَا وَتَذُوقُوا۟",996],["18:57:11",300,"قَدَّمَتْ","have sent forth","عَنْهَا وَنَسِىَ مَا","يَدَاهُ ۚ إِنَّا جَعَلْنَا",405],["22:10:3",333,"قَدَّمَتْ","have sent forth","ذَٰلِكَ بِمَا","يَدَاكَ وَأَنَّ ٱللَّهَ",405],["25:23:1",362,"وَقَدِمْنَآ","And We will proceed","","إِلَىٰ مَا عَمِلُوا۟",2578],["26:76:3",370,"ٱلْأَقْدَمُونَ","and your forefathers","أَنتُمْ وَءَابَآؤُكُمُ","",3027],["28:47:6",391,"قَدَّمَتْ","had sent forth","تُصِيبَهُم مُّصِيبَةٌۢ بِمَا","أَيْدِيهِمْ فَيَقُولُوا۟ رَبَّنَا",405],["30:36:11",408,"قَدَّمَتْ","have sent forth","تُصِبْهُمْ سَيِّئَةٌۢ بِمَا","أَيْدِيهِمْ إِذَا هُمْ",405],["34:30:10",431,"تَسْتَقْدِمُونَ","(can) you precede (it)","عَنْهُ سَاعَةًۭ وَلَا","",1672],["36:12:7",440,"قَدَّمُوا۟","they have sent before","ٱلْمَوْتَىٰ وَنَكْتُبُ مَا","وَءَاثَـٰرَهُمْ ۚ وَكُلَّ شَىْءٍ",405],["36:39:7",442,"ٱلْقَدِيمِ","the old","حَتَّىٰ عَادَ كَٱلْعُرْجُونِ","",1956],["38:60:8",456,"قَدَّمْتُمُوهُ","brought this","مَرْحَبًۢا بِكُمْ ۖ أَنتُمْ","لَنَا ۖ فَبِئْسَ ٱلْقَرَارُ",405],["38:61:4",456,"قَدَّمَ","brought","قَالُوا۟ رَبَّنَا مَن","لَنَا هَـٰذَا فَزِدْهُ",405],["41:29:13",479,"أَقْدَامِنَا","our feet","وَٱلْإِنسِ نَجْعَلْهُمَا تَحْتَ","لِيَكُونَا مِنَ ٱلْأَسْفَلِينَ",996],["42:48:23",488,"قَدَّمَتْ","have sent forth","تُصِبْهُمْ سَيِّئَةٌۢ بِمَا","أَيْدِيهِمْ فَإِنَّ ٱلْإِنسَـٰنَ",405],["46:11:19",503,"قَدِيمٌۭ","ancient","فَسَيَقُولُونَ هَـٰذَآ إِفْكٌۭ","",1956],["47:7:9",507,"أَقْدَامَكُمْ","your feet","ٱللَّهَ يَنصُرْكُمْ وَيُثَبِّتْ","",996],["48:2:5",511,"تَقَدَّمَ","preceded","لَكَ ٱللَّهُ مَا","مِن ذَنۢبِكَ وَمَا",2674],["49:1:5",515,"تُقَدِّمُوا۟","put (yourselves) forward","ٱلَّذِينَ ءَامَنُوا۟ لَا","بَيْنَ يَدَىِ ٱللَّهِ",405],["50:28:6",519,"قَدَّمْتُ","I sent forth","تَخْتَصِمُوا۟ لَدَىَّ وَقَدْ","إِلَيْكُم بِٱلْوَعِيدِ",405],["55:41:6",532,"وَٱلْأَقْدَامِ","and the feet","بِسِيمَـٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى","",996],["58:12:7",544,"فَقَدِّمُوا۟","then offer","إِذَا نَـٰجَيْتُمُ ٱلرَّسُولَ","بَيْنَ يَدَىْ نَجْوَىٰكُمْ",405],["58:13:3",544,"تُقَدِّمُوا۟","offer","ءَأَشْفَقْتُمْ أَن","بَيْنَ يَدَىْ نَجْوَىٰكُمْ",405],["59:18:9",548,"قَدَّمَتْ","it has sent forth","وَلْتَنظُرْ نَفْسٌۭ مَّا","لِغَدٍۢ ۖ وَٱتَّقُوا۟ ٱللَّهَ ۚ",405],["62:7:5",553,"قَدَّمَتْ","(have) sent forth","يَتَمَنَّوْنَهُۥٓ أَبَدًۢا بِمَا","أَيْدِيهِمْ ۚ وَٱللَّهُ عَلِيمٌۢ",405],["73:20:62",575,"تُقَدِّمُوا۟","you send forth","قَرْضًا حَسَنًۭا ۚ وَمَا","لِأَنفُسِكُم مِّنْ خَيْرٍۢ",405],["74:37:5",576,"يَتَقَدَّمَ","proceed","شَآءَ مِنكُمْ أَن","أَوْ يَتَأَخَّرَ",2674],["75:13:5",577,"قَدَّمَ","he sent forth","ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا","وَأَخَّرَ",405],["78:40:9",583,"قَدَّمَتْ","have sent forth","يَنظُرُ ٱلْمَرْءُ مَا","يَدَاهُ وَيَقُولُ ٱلْكَافِرُ",405],["82:5:4",587,"قَدَّمَتْ","it has sent forth","عَلِمَتْ نَفْسٌۭ مَّا","وَأَخَّرَتْ",405],["89:24:3",594,"قَدَّمْتُ","I had sent forth","يَقُولُ يَـٰلَيْتَنِى","لِحَيَاتِى",405]]