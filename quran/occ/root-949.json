[["2:256:17",42,"بِٱلْعُرْوَةِ","the handhold","بِٱللَّهِ فَقَدِ ٱسْتَمْسَكَ","ٱلْوُثْقَىٰ لَا ٱنفِصَامَ",2260],["11:54:4",228,"ٱعْتَرَىٰكَ","have seized you","إِن نَّقُولُ إِلَّا","بَعْضُ ءَالِهَتِنَا بِسُوٓءٍۢ ۗ",4784],["31:22:10",413,"بِٱلْعُرْوَةِ","the handhold","مُحْسِنٌۭ فَقَدِ ٱسْتَمْسَكَ","ٱلْوُثْقَىٰ ۗ وَإِلَى ٱللَّهِ",2260]]