[["2:143:44",22,"لَرَءُوفٌۭ","Full of Kindness","إِنَّ ٱللَّهَ بِٱلنَّاسِ","رَّحِيمٌۭ",799],["2:207:10",32,"رَءُوفٌۢ","(is) full of Kindness","مَرْضَاتِ ٱللَّهِ ۗ وَٱللَّهُ","بِٱلْعِبَادِ",799],["3:30:25",54,"رَءُوفٌۢ","(is) Most Kind","ٱللَّهُ نَفْسَهُۥ ۗ وَٱللَّهُ","بِٱلْعِبَادِ",799],["9:117:26",205,"رَءُوفٌۭ","(is) Most Kind","عَلَيْهِمْ ۚ إِنَّهُۥ بِهِمْ","رَّحِيمٌۭ",799],["9:128:13",207,"رَءُوفٌۭ","(he is) kind","حَرِيصٌ عَلَيْكُم بِٱلْمُؤْمِنِينَ","رَّحِيمٌۭ",799],["16:7:13",268,"لَرَءُوفٌۭ","surely is Most Kind","ٱلْأَنفُسِ ۚ إِنَّ رَبَّكُمْ","رَّحِيمٌۭ",799],["16:47:7",272,"لَرَءُوفٌۭ","(is) surely Full of Kindness","تَخَوُّفٍۢ فَإِنَّ رَبَّكُمْ","رَّحِيمٌ",799],["22:65:26",340,"لَرَءُوفٌۭ","(is) Full of Kindness","إِنَّ ٱللَّهَ بِٱلنَّاسِ","رَّحِيمٌۭ",799],["24:2:12",350,"رَأْفَةٌۭ","pity for them","وَلَا تَأْخُذْكُم بِهِمَا","فِى دِينِ ٱللَّهِ",2592],["24:20:8",351,"رَءُوفٌۭ","(is) Full of Kindness","وَرَحْمَتُهُۥ وَأَنَّ ٱللَّهَ","رَّحِيمٌۭ",799],["57:9:16",538,"لَرَءُوفٌۭ","(is the) Most Kind","وَإِنَّ ٱللَّهَ بِكُمْ","رَّحِيمٌۭ",799],["57:27:17",541,"رَأْفَةًۭ","compassion","قُلُوبِ ٱلَّذِينَ ٱتَّبَعُوهُ","وَرَحْمَةًۭ وَرَهْبَانِيَّةً ٱبْتَدَعُوهَا",2592],["59:10:22",547,"رَءُوفٌۭ","(are) Full of Kindness","ءَامَنُوا۟ رَبَّنَآ إِنَّكَ","رَّحِيمٌ",799]]