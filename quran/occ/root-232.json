[["2:63:10",10,"بِقُوَّةٍۢ","with strength","خُذُوا۟ مَآ ءَاتَيْنَـٰكُم","وَٱذْكُرُوا۟ مَا فِيهِ",366],["2:93:10",14,"بِقُوَّةٍۢ","with firmness","خُذُوا۟ مَآ ءَاتَيْنَـٰكُم","وَٱسْمَعُوا۟ ۖ قَالُوا۟ سَمِعْنَا",366],["2:165:25",25,"ٱلْقُوَّةَ","the power","يَرَوْنَ ٱلْعَذَابَ أَنَّ","لِلَّهِ جَمِيعًۭا وَأَنَّ",366],["7:145:13",168,"بِقُوَّةٍۢ","with firmness","لِّكُلِّ شَىْءٍۢ فَخُذْهَا","وَأْمُرْ قَوْمَكَ يَأْخُذُوا۟",366],["7:171:14",173,"بِقُوَّةٍۢ","with strength","خُذُوا۟ مَآ ءَاتَيْنَـٰكُم","وَٱذْكُرُوا۟ مَا فِيهِ",366],["8:52:15",183,"قَوِىٌّۭ","(is) All-Strong","بِذُنُوبِهِمْ ۗ إِنَّ ٱللَّهَ","شَدِيدُ ٱلْعِقَابِ",798],["8:60:6",184,"قُوَّةٍۢ","force","مَّا ٱسْتَطَعْتُم مِّن","وَمِن رِّبَاطِ ٱلْخَيْلِ",366],["9:69:7",198,"قُوَّةًۭ","(in) strength","كَانُوٓا۟ أَشَدَّ مِنكُمْ","وَأَكْثَرَ أَمْوَٰلًۭا وَأَوْلَـٰدًۭا",366],["11:52:12",227,"قُوَّةً","(in) strength","عَلَيْكُم مِّدْرَارًۭا وَيَزِدْكُمْ","إِلَىٰ قُوَّتِكُمْ وَلَا",366],["11:52:14",227,"قُوَّتِكُمْ","your strength","وَيَزِدْكُمْ قُوَّةً إِلَىٰ","وَلَا تَتَوَلَّوْا۟ مُجْرِمِينَ",366],["11:66:17",229,"ٱلْقَوِىُّ","(is) All-Strong","إِنَّ رَبَّكَ هُوَ","ٱلْعَزِيزُ",798],["11:80:6",230,"قُوَّةً","power","أَنَّ لِى بِكُمْ","أَوْ ءَاوِىٓ إِلَىٰ",366],["16:92:8",277,"قُوَّةٍ","strength","غَزْلَهَا مِنۢ بَعْدِ","أَنكَـٰثًۭا تَتَّخِذُونَ أَيْمَـٰنَكُمْ",366],["18:39:10",298,"قُوَّةَ","power","شَآءَ ٱللَّهُ لَا","إِلَّا بِٱللَّهِ ۚ إِن",366],["18:95:8",303,"بِقُوَّةٍ","with strength","رَبِّى خَيْرٌۭ فَأَعِينُونِى","أَجْعَلْ بَيْنَكُمْ وَبَيْنَهُمْ",366],["19:12:4",306,"بِقُوَّةٍۢ ۖ","with strength","يَـٰيَحْيَىٰ خُذِ ٱلْكِتَـٰبَ","وَءَاتَيْنَـٰهُ ٱلْحُكْمَ صَبِيًّۭا",366],["22:40:34",337,"لَقَوِىٌّ","(is) surely All-Strong","يَنصُرُهُۥٓ ۗ إِنَّ ٱللَّهَ","عَزِيزٌ",798],["22:74:8",341,"لَقَوِىٌّ","(is) surely All-Strong","قَدْرِهِۦٓ ۗ إِنَّ ٱللَّهَ","عَزِيزٌ",798],["27:33:4",379,"قُوَّةٍۢ","(of) strength","قَالُوا۟ نَحْنُ أُو۟لُوا۟","وَأُو۟لُوا۟ بَأْسٍۢ شَدِيدٍۢ",366],["27:39:15",380,"لَقَوِىٌّ","surely, strong","مَّقَامِكَ ۖ وَإِنِّى عَلَيْهِ","أَمِينٌۭ",798],["28:26:9",388,"ٱلْقَوِىُّ","(is) the strong","خَيْرَ مَنِ ٱسْتَـْٔجَرْتَ","ٱلْأَمِينُ",798],["28:76:18",394,"ٱلْقُوَّةِ","possessors of great strength","لَتَنُوٓأُ بِٱلْعُصْبَةِ أُو۟لِى","إِذْ قَالَ لَهُۥ",366],["28:78:21",395,"قُوَّةًۭ","(in) strength","هُوَ أَشَدُّ مِنْهُ","وَأَكْثَرُ جَمْعًۭا ۚ وَلَا",366],["30:9:15",405,"قُوَّةًۭ","(in) strength","كَانُوٓا۟ أَشَدَّ مِنْهُمْ","وَأَثَارُوا۟ ٱلْأَرْضَ وَعَمَرُوهَآ",366],["30:54:11",410,"قُوَّةًۭ","strength","مِنۢ بَعْدِ ضَعْفٍۢ","ثُمَّ جَعَلَ مِنۢ",366],["30:54:16",410,"قُوَّةٍۢ","strength","جَعَلَ مِنۢ بَعْدِ","ضَعْفًۭا وَشَيْبَةًۭ ۚ يَخْلُقُ",366],["33:25:15",421,"قَوِيًّا","All-Strong","ٱلْقِتَالَ ۚ وَكَانَ ٱللَّهُ","عَزِيزًۭا",798],["35:44:15",439,"قُوَّةًۭ ۚ","(in) power","وَكَانُوٓا۟ أَشَدَّ مِنْهُمْ","وَمَا كَانَ ٱللَّهُ",366],["40:21:17",469,"قُوَّةًۭ","(in) strength","هُمْ أَشَدَّ مِنْهُمْ","وَءَاثَارًۭا فِى ٱلْأَرْضِ",366],["40:22:11",469,"قَوِىٌّۭ","(is) All-Strong","فَأَخَذَهُمُ ٱللَّهُ ۚ إِنَّهُۥ","شَدِيدُ ٱلْعِقَابِ",798],["40:82:16",476,"قُوَّةًۭ","(in) strength","أَكْثَرَ مِنْهُمْ وَأَشَدَّ","وَءَاثَارًۭا فِى ٱلْأَرْضِ",366],["41:15:12",478,"قُوَّةً ۖ","(in) strength","مَنْ أَشَدُّ مِنَّا","أَوَلَمْ يَرَوْا۟ أَنَّ",366],["41:15:22",478,"قُوَّةًۭ ۖ","(in) strength","هُوَ أَشَدُّ مِنْهُمْ","وَكَانُوا۟ بِـَٔايَـٰتِنَا يَجْحَدُونَ",366],["42:19:8",485,"ٱلْقَوِىُّ","(is) the All-Strong","مَن يَشَآءُ ۖ وَهُوَ","ٱلْعَزِيزُ",798],["47:13:6",508,"قُوَّةًۭ","(in) strength","قَرْيَةٍ هِىَ أَشَدُّ","مِّن قَرْيَتِكَ ٱلَّتِىٓ",366],["51:58:6",523,"ٱلْقُوَّةِ","(of) Power","هُوَ ٱلرَّزَّاقُ ذُو","ٱلْمَتِينُ",366],["53:5:3",526,"ٱلْقُوَىٰ","(in) power","عَلَّمَهُۥ شَدِيدُ","",366],["56:73:5",536,"لِّلْمُقْوِينَ","for the wayfarers in the desert","جَعَلْنَـٰهَا تَذْكِرَةًۭ وَمَتَـٰعًۭا","",3840],["57:25:27",541,"قَوِىٌّ","(is) All-Strong","بِٱلْغَيْبِ ۚ إِنَّ ٱللَّهَ","عَزِيزٌۭ",798],["58:21:8",544,"قَوِىٌّ","(is) All-Strong","وَرُسُلِىٓ ۚ إِنَّ ٱللَّهَ","عَزِيزٌۭ",798],["81:20:2",586,"قُوَّةٍ","power","ذِى","عِندَ ذِى ٱلْعَرْشِ",366],["86:10:4",591,"قُوَّةٍۢ","power","فَمَا لَهُۥ مِن","وَلَا نَاصِرٍۢ",366]]