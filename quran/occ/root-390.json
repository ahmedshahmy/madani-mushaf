[["6:70:40",136,"حَمِيمٍۢ","boiling water","لَهُمْ شَرَابٌۭ مِّنْ","وَعَذَابٌ أَلِيمٌۢ بِمَا",507],["10:4:23",208,"حَمِيمٍۢ","boiling fluids","لَهُمْ شَرَابٌۭ مِّنْ","وَعَذَابٌ أَلِيمٌۢ بِمَا",507],["22:19:17",334,"ٱلْحَمِيمُ","[the] scalding water","مِن فَوْقِ رُءُوسِهِمُ","",507],["26:101:3",371,"حَمِيمٍۢ","close","وَلَا صَدِيقٍ","",507],["37:67:7",448,"حَمِيمٍۢ","boiling water","عَلَيْهَا لَشَوْبًۭا مِّنْ","",507],["38:57:3",456,"حَمِيمٌۭ","boiling fluid","هَـٰذَا فَلْيَذُوقُوهُ","وَغَسَّاقٌۭ",507],["40:18:12",469,"حَمِيمٍۢ","intimate friend","مَا لِلظَّـٰلِمِينَ مِنْ","وَلَا شَفِيعٍۢ يُطَاعُ",507],["40:72:2",475,"ٱلْحَمِيمِ","the boiling water","فِى","ثُمَّ فِى ٱلنَّارِ",507],["41:34:17",480,"حَمِيمٌۭ","intimate","عَدَٰوَةٌۭ كَأَنَّهُۥ وَلِىٌّ","",507],["44:46:2",498,"ٱلْحَمِيمِ","(of) scalding water","كَغَلْىِ","",507],["44:48:7",498,"ٱلْحَمِيمِ","(of) the scalding water","رَأْسِهِۦ مِنْ عَذَابِ","",507],["47:15:42",508,"حَمِيمًۭا","boiling","ٱلنَّارِ وَسُقُوا۟ مَآءً","فَقَطَّعَ أَمْعَآءَهُمْ",507],["55:44:4",533,"حَمِيمٍ","scalding water","يَطُوفُونَ بَيْنَهَا وَبَيْنَ","ءَانٍۢ",507],["56:42:3",535,"وَحَمِيمٍۢ","and scalding water","فِى سَمُومٍۢ","",507],["56:43:3",535,"يَحْمُومٍۢ","black smoke","وَظِلٍّۢ مِّن","",4611],["56:54:4",536,"ٱلْحَمِيمِ","the scalding water","فَشَـٰرِبُونَ عَلَيْهِ مِنَ","",507],["56:93:3",537,"حَمِيمٍۢ","(the) scalding water","فَنُزُلٌۭ مِّنْ","",507],["69:35:5",567,"حَمِيمٌۭ","any devoted friend","لَهُ ٱلْيَوْمَ هَـٰهُنَا","",507],["70:10:3",568,"حَمِيمٌ","a friend","وَلَا يَسْـَٔلُ","حَمِيمًۭا",507],["70:10:4",568,"حَمِيمًۭا","(about) a friend","وَلَا يَسْـَٔلُ حَمِيمٌ","",507],["78:25:2",582,"حَمِيمًۭا","scalding water","إِلَّا","وَغَسَّاقًۭا",507]]