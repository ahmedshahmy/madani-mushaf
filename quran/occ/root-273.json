[["2:18:3",4,"عُمْىٌۭ","blind","صُمٌّۢ بُكْمٌ","فَهُمْ لَا يَرْجِعُونَ",483],["2:171:15",26,"عُمْىٌۭ","(and) blind","وَنِدَآءًۭ ۚ صُمٌّۢ بُكْمٌ","فَهُمْ لَا يَعْقِلُونَ",483],["5:71:5",120,"فَعَمُوا۟","so they became blind","أَلَّا تَكُونَ فِتْنَةٌۭ","وَصَمُّوا۟ ثُمَّ تَابَ",1048],["5:71:12",120,"عَمُوا۟","they became blind","ٱللَّهُ عَلَيْهِمْ ثُمَّ","وَصَمُّوا۟ كَثِيرٌۭ مِّنْهُمْ ۚ",1048],["6:50:25",133,"ٱلْأَعْمَىٰ","the blind","قُلْ هَلْ يَسْتَوِى","وَٱلْبَصِيرُ ۚ أَفَلَا تَتَفَكَّرُونَ",483],["6:104:10",141,"عَمِىَ","(is) blind","أَبْصَرَ فَلِنَفْسِهِۦ ۖ وَمَنْ","فَعَلَيْهَا ۚ وَمَآ أَنَا۠",1048],["7:64:14",158,"عَمِينَ","blind","إِنَّهُمْ كَانُوا۟ قَوْمًا","",2239],["10:43:7",214,"ٱلْعُمْىَ","the blind","إِلَيْكَ ۚ أَفَأَنتَ تَهْدِى","وَلَوْ كَانُوا۟ لَا",483],["11:24:3",224,"كَٱلْأَعْمَىٰ","(is) like the blind","۞ مَثَلُ ٱلْفَرِيقَيْنِ","وَٱلْأَصَمِّ وَٱلْبَصِيرِ وَٱلسَّمِيعِ ۚ",483],["11:28:14",224,"فَعُمِّيَتْ","but (it) has been obscured","رَحْمَةًۭ مِّنْ عِندِهِۦ","عَلَيْكُمْ أَنُلْزِمُكُمُوهَا وَأَنتُمْ",3149],["13:16:22",251,"ٱلْأَعْمَىٰ","the blind","قُلْ هَلْ يَسْتَوِى","وَٱلْبَصِيرُ أَمْ هَلْ",483],["13:19:11",252,"أَعْمَىٰٓ ۚ","(is) blind","ٱلْحَقُّ كَمَنْ هُوَ","إِنَّمَا يَتَذَكَّرُ أُو۟لُوا۟",483],["17:72:5",289,"أَعْمَىٰ","blind","كَانَ فِى هَـٰذِهِۦٓ","فَهُوَ فِى ٱلْـَٔاخِرَةِ",483],["17:72:9",289,"أَعْمَىٰ","(will be) blind","فَهُوَ فِى ٱلْـَٔاخِرَةِ","وَأَضَلُّ سَبِيلًۭا",483],["17:97:19",292,"عُمْيًۭا","blind","ٱلْقِيَـٰمَةِ عَلَىٰ وُجُوهِهِمْ","وَبُكْمًۭا وَصُمًّۭا ۖ مَّأْوَىٰهُمْ",483],["20:124:12",320,"أَعْمَىٰ","blind","وَنَحْشُرُهُۥ يَوْمَ ٱلْقِيَـٰمَةِ","",483],["20:125:5",320,"أَعْمَىٰ","blind","رَبِّ لِمَ حَشَرْتَنِىٓ","وَقَدْ كُنتُ بَصِيرًۭا",483],["22:46:16",337,"تَعْمَى","(are) blinded","بِهَا ۖ فَإِنَّهَا لَا","ٱلْأَبْصَـٰرُ وَلَـٰكِن تَعْمَى",1048],["22:46:19",337,"تَعْمَى","(are) blinded","تَعْمَى ٱلْأَبْصَـٰرُ وَلَـٰكِن","ٱلْقُلُوبُ ٱلَّتِى فِى",1048],["24:61:3",358,"ٱلْأَعْمَىٰ","the blind","لَّيْسَ عَلَى","حَرَجٌۭ وَلَا عَلَى",483],["25:73:10",366,"وَعُمْيَانًۭا","and blind","يَخِرُّوا۟ عَلَيْهَا صُمًّۭا","",483],["27:66:14",383,"عَمُونَ","(are) blind","بَلْ هُم مِّنْهَا","",2239],["27:81:4",384,"ٱلْعُمْىِ","the blind","وَمَآ أَنتَ بِهَـٰدِى","عَن ضَلَـٰلَتِهِمْ ۖ إِن",483],["28:66:1",393,"فَعَمِيَتْ","But (will) be obscure","","عَلَيْهِمُ ٱلْأَنۢبَآءُ يَوْمَئِذٍۢ",1048],["30:53:4",410,"ٱلْعُمْىِ","the blind","وَمَآ أَنتَ بِهَـٰدِ","عَن ضَلَـٰلَتِهِمْ ۖ إِن",483],["35:19:3",437,"ٱلْأَعْمَىٰ","(are) the blind","وَمَا يَسْتَوِى","وَٱلْبَصِيرُ",483],["40:58:3",473,"ٱلْأَعْمَىٰ","the blind","وَمَا يَسْتَوِى","وَٱلْبَصِيرُ وَٱلَّذِينَ ءَامَنُوا۟",483],["41:17:5",478,"ٱلْعَمَىٰ","[the] blindness","ثَمُودُ فَهَدَيْنَـٰهُمْ فَٱسْتَحَبُّوا۟","عَلَى ٱلْهُدَىٰ فَأَخَذَتْهُمْ",2238],["41:44:25",481,"عَمًى ۚ","blindness","وَقْرٌۭ وَهُوَ عَلَيْهِمْ","أُو۟لَـٰٓئِكَ يُنَادَوْنَ مِن",2238],["43:40:6",492,"ٱلْعُمْىَ","the blind","ٱلصُّمَّ أَوْ تَهْدِى","وَمَن كَانَ فِى",483],["47:23:6",509,"وَأَعْمَىٰٓ","and blinded","لَعَنَهُمُ ٱللَّهُ فَأَصَمَّهُمْ","أَبْصَـٰرَهُمْ",1048],["48:17:3",513,"ٱلْأَعْمَىٰ","the blind","لَّيْسَ عَلَى","حَرَجٌۭ وَلَا عَلَى",483],["80:2:3",585,"ٱلْأَعْمَىٰ","the blind man","أَن جَآءَهُ","",483]]