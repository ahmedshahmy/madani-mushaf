[["6:65:17",135,"شِيَعًۭا","(into) sects","أَرْجُلِكُمْ أَوْ يَلْبِسَكُمْ","وَيُذِيقَ بَعْضَكُم بَأْسَ",757],["6:159:6",150,"شِيَعًۭا","sects","فَرَّقُوا۟ دِينَهُمْ وَكَانُوا۟","لَّسْتَ مِنْهُمْ فِى",757],["15:10:6",262,"شِيَعِ","the sects","مِن قَبْلِكَ فِى","ٱلْأَوَّلِينَ",757],["19:69:5",310,"شِيعَةٍ","sect","لَنَنزِعَنَّ مِن كُلِّ","أَيُّهُمْ أَشَدُّ عَلَى",757],["24:19:5",351,"تَشِيعَ","(should) spread","ٱلَّذِينَ يُحِبُّونَ أَن","ٱلْفَـٰحِشَةُ فِى ٱلَّذِينَ",4304],["28:4:8",385,"شِيَعًۭا","(into) sects","ٱلْأَرْضِ وَجَعَلَ أَهْلَهَا","يَسْتَضْعِفُ طَآئِفَةًۭ مِّنْهُمْ",757],["28:15:14",387,"شِيعَتِهِۦ","his party","يَقْتَتِلَانِ هَـٰذَا مِن","وَهَـٰذَا مِنْ عَدُوِّهِۦ ۖ",757],["28:15:21",387,"شِيعَتِهِۦ","his party","فَٱسْتَغَـٰثَهُ ٱلَّذِى مِن","عَلَى ٱلَّذِى مِنْ",757],["30:32:6",407,"شِيَعًۭا ۖ","sects","فَرَّقُوا۟ دِينَهُمْ وَكَانُوا۟","كُلُّ حِزْبٍۭ بِمَا",757],["34:54:8",434,"بِأَشْيَاعِهِم","with their kind","يَشْتَهُونَ كَمَا فُعِلَ","مِّن قَبْلُ ۚ إِنَّهُمْ",757],["37:83:3",449,"شِيعَتِهِۦ","his kind","۞ وَإِنَّ مِن","لَإِبْرَٰهِيمَ",757],["54:51:3",531,"أَشْيَاعَكُمْ","your kinds","وَلَقَدْ أَهْلَكْنَآ","فَهَلْ مِن مُّدَّكِرٍۢ",757]]