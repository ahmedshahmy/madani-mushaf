[["5:12:23",109,"وَعَزَّرْتُمُوهُمْ","and you assist them","ٱلزَّكَوٰةَ وَءَامَنتُم بِرُسُلِى","وَأَقْرَضْتُمُ ٱللَّهَ قَرْضًا",1767],["7:157:34",170,"وَعَزَّرُوهُ","and honor him","فَٱلَّذِينَ ءَامَنُوا۟ بِهِۦ","وَنَصَرُوهُ وَٱتَّبَعُوا۟ ٱلنُّورَ",1767],["48:9:4",511,"وَتُعَزِّرُوهُ","and (may) honor him","لِّتُؤْمِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ","وَتُوَقِّرُوهُ وَتُسَبِّحُوهُ بُكْرَةًۭ",1767]]