[["2:263:10",44,"غَنِىٌّ","(is) All-Sufficient","يَتْبَعُهَآ أَذًۭى ۗ وَٱللَّهُ","حَلِيمٌۭ",440],["2:267:28",45,"غَنِىٌّ","(is) Self-Sufficient","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","حَمِيدٌ",440],["2:273:14",46,"أَغْنِيَآءَ","(that they are) self-sufficient","ٱلْأَرْضِ يَحْسَبُهُمُ ٱلْجَاهِلُ","مِنَ ٱلتَّعَفُّفِ تَعْرِفُهُم",440],["3:10:5",51,"تُغْنِىَ","will avail","ٱلَّذِينَ كَفَرُوا۟ لَن","عَنْهُمْ أَمْوَٰلُهُمْ وَلَآ",383],["3:97:23",62,"غَنِىٌّ","(is) free from need","كَفَرَ فَإِنَّ ٱللَّهَ","عَنِ ٱلْعَـٰلَمِينَ",440],["3:116:5",65,"تُغْنِىَ","will avail","ٱلَّذِينَ كَفَرُوا۟ لَن","عَنْهُمْ أَمْوَٰلُهُمْ وَلَآ",383],["3:181:11",74,"أَغْنِيَآءُ ۘ","(are) rich","ٱللَّهَ فَقِيرٌۭ وَنَحْنُ","سَنَكْتُبُ مَا قَالُوا۟",440],["4:6:22",77,"غَنِيًّۭا","rich","يَكْبَرُوا۟ ۚ وَمَن كَانَ","فَلْيَسْتَعْفِفْ ۖ وَمَن كَانَ",440],["4:130:3",99,"يُغْنِ","will be enriched","وَإِن يَتَفَرَّقَا","ٱللَّهُ كُلًّۭا مِّن",383],["4:131:31",99,"غَنِيًّا","Free of need","ٱلْأَرْضِ ۚ وَكَانَ ٱللَّهُ","حَمِيدًۭا",440],["4:135:17",100,"غَنِيًّا","rich","وَٱلْأَقْرَبِينَ ۚ إِن يَكُنْ","أَوْ فَقِيرًۭا فَٱللَّهُ",440],["6:133:2",145,"ٱلْغَنِىُّ","(is) the Self-Sufficient","وَرَبُّكَ","ذُو ٱلرَّحْمَةِ ۚ إِن",440],["7:48:9",156,"أَغْنَىٰ","(has) availed","بِسِيمَىٰهُمْ قَالُوا۟ مَآ","عَنكُمْ جَمْعُكُمْ وَمَا",616],["7:92:6",162,"يَغْنَوْا۟","they (had) lived","شُعَيْبًۭا كَأَن لَّمْ","فِيهَا ۚ ٱلَّذِينَ كَذَّبُوا۟",616],["8:19:15",179,"تُغْنِىَ","will avail","تَعُودُوا۟ نَعُدْ وَلَن","عَنكُمْ فِئَتُكُمْ شَيْـًۭٔا",383],["9:25:13",190,"تُغْنِ","availed","أَعْجَبَتْكُمْ كَثْرَتُكُمْ فَلَمْ","عَنكُمْ شَيْـًۭٔا وَضَاقَتْ",383],["9:28:18",191,"يُغْنِيكُمُ","Allah will enrich you","خِفْتُمْ عَيْلَةًۭ فَسَوْفَ","ٱللَّهُ مِن فَضْلِهِۦٓ",383],["9:74:20",199,"أَغْنَىٰهُمُ","Allah had enriched them","نَقَمُوٓا۟ إِلَّآ أَنْ","ٱللَّهُ وَرَسُولُهُۥ مِن",616],["9:93:7",201,"أَغْنِيَآءُ ۚ","(are) rich","ٱلَّذِينَ يَسْتَـْٔذِنُونَكَ وَهُمْ","رَضُوا۟ بِأَن يَكُونُوا۟",440],["10:24:37",211,"تَغْنَ","it had flourished","حَصِيدًۭا كَأَن لَّمْ","بِٱلْأَمْسِ ۚ كَذَٰلِكَ نُفَصِّلُ",616],["10:36:9",213,"يُغْنِى","avail","إِنَّ ٱلظَّنَّ لَا","مِنَ ٱلْحَقِّ شَيْـًٔا ۚ",383],["10:68:7",216,"ٱلْغَنِىُّ ۖ","(is) the Self-sufficient","وَلَدًۭا ۗ سُبْحَـٰنَهُۥ ۖ هُوَ","لَهُۥ مَا فِى",440],["10:101:8",220,"تُغْنِى","will avail","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَمَا","ٱلْـَٔايَـٰتُ وَٱلنُّذُرُ عَن",383],["11:68:3",229,"يَغْنَوْا۟","they (had) prospered","كَأَن لَّمْ","فِيهَآ ۗ أَلَآ إِنَّ",616],["11:95:3",232,"يَغْنَوْا۟","they (had) prospered","كَأَن لَّمْ","فِيهَآ ۗ أَلَا بُعْدًۭا",616],["11:101:7",233,"أَغْنَتْ","availed","ظَلَمُوٓا۟ أَنفُسَهُمْ ۖ فَمَآ","عَنْهُمْ ءَالِهَتُهُمُ ٱلَّتِى",383],["12:67:13",243,"أُغْنِى","I can avail","أَبْوَٰبٍۢ مُّتَفَرِّقَةٍۢ ۖ وَمَآ","عَنكُم مِّنَ ٱللَّهِ",383],["12:68:9",243,"يُغْنِى","avail(ed)","أَبُوهُم مَّا كَانَ","عَنْهُم مِّنَ ٱللَّهِ",383],["14:8:12",256,"لَغَنِىٌّ","certainly (is) Free of need","جَمِيعًۭا فَإِنَّ ٱللَّهَ","حَمِيدٌ",440],["14:21:14",258,"مُّغْنُونَ","the one who avails","تَبَعًۭا فَهَلْ أَنتُم","عَنَّا مِنْ عَذَابِ",2538],["15:84:2",266,"أَغْنَىٰ","availed","فَمَآ","عَنْهُم مَّا كَانُوا۟",616],["19:42:13",308,"يُغْنِى","benefits","وَلَا يُبْصِرُ وَلَا","عَنكَ شَيْـًۭٔا",383],["22:64:11",339,"ٱلْغَنِىُّ","(is) Free of need","وَإِنَّ ٱللَّهَ لَهُوَ","ٱلْحَمِيدُ",440],["24:32:11",354,"يُغْنِهِمُ","Allah will enrich them","إِن يَكُونُوا۟ فُقَرَآءَ","ٱللَّهُ مِن فَضْلِهِۦ ۗ",383],["24:33:7",354,"يُغْنِيَهُمُ","Allah enriches them","يَجِدُونَ نِكَاحًا حَتَّىٰ","ٱللَّهُ مِن فَضْلِهِۦ ۗ",383],["26:207:2",376,"أَغْنَىٰ","(will) avail","مَآ","عَنْهُم مَّا كَانُوا۟",616],["27:40:37",380,"غَنِىٌّۭ","(is) Self-sufficient","كَفَرَ فَإِنَّ رَبِّى","كَرِيمٌۭ",440],["29:6:8",396,"لَغَنِىٌّ","(is) Free from need","لِنَفْسِهِۦٓ ۚ إِنَّ ٱللَّهَ","عَنِ ٱلْعَـٰلَمِينَ",440],["31:12:17",412,"غَنِىٌّ","(is) Free of need","كَفَرَ فَإِنَّ ٱللَّهَ","حَمِيدٌۭ",440],["31:26:9",413,"ٱلْغَنِىُّ","(is) Free of need","إِنَّ ٱللَّهَ هُوَ","ٱلْحَمِيدُ",440],["35:15:9",436,"ٱلْغَنِىُّ","(is) Free of need","ٱللَّهِ ۖ وَٱللَّهُ هُوَ","ٱلْحَمِيدُ",440],["36:23:10",441,"تُغْنِ","will avail","ٱلرَّحْمَـٰنُ بِضُرٍّۢ لَّا","عَنِّى شَفَـٰعَتُهُمْ شَيْـًۭٔا",383],["39:7:5",459,"غَنِىٌّ","(is) free from need","تَكْفُرُوا۟ فَإِنَّ ٱللَّهَ","عَنكُمْ ۖ وَلَا يَرْضَىٰ",440],["39:50:7",464,"أَغْنَىٰ","avail","مِن قَبْلِهِمْ فَمَآ","عَنْهُم مَّا كَانُوا۟",616],["40:47:15",472,"مُّغْنُونَ","avert","تَبَعًۭا فَهَلْ أَنتُم","عَنَّا نَصِيبًۭا مِّنَ",2538],["40:82:21",476,"أَغْنَىٰ","availed","فِى ٱلْأَرْضِ فَمَآ","عَنْهُم مَّا كَانُوا۟",616],["44:41:3",498,"يُغْنِى","will avail","يَوْمَ لَا","مَوْلًى عَن مَّوْلًۭى",383],["45:10:5",499,"يُغْنِى","will avail","وَرَآئِهِمْ جَهَنَّمُ ۖ وَلَا","عَنْهُم مَّا كَسَبُوا۟",383],["45:19:3",500,"يُغْنُوا۟","will avail","إِنَّهُمْ لَن","عَنكَ مِنَ ٱللَّهِ",383],["46:26:13",505,"أَغْنَىٰ","availed","وَأَبْصَـٰرًۭا وَأَفْـِٔدَةًۭ فَمَآ","عَنْهُمْ سَمْعُهُمْ وَلَآ",616],["47:38:18",510,"ٱلْغَنِىُّ","(is) Free of need","عَن نَّفْسِهِۦ ۚ وَٱللَّهُ","وَأَنتُمُ ٱلْفُقَرَآءُ ۚ وَإِن",440],["52:46:3",525,"يُغْنِى","will avail","يَوْمَ لَا","عَنْهُمْ كَيْدُهُمْ شَيْـًۭٔا",383],["53:26:7",526,"تُغْنِى","will avail","فِى ٱلسَّمَـٰوَٰتِ لَا","شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا",383],["53:28:13",527,"يُغْنِى","avail","وَإِنَّ ٱلظَّنَّ لَا","مِنَ ٱلْحَقِّ شَيْـًۭٔا",383],["53:48:3",528,"أَغْنَىٰ","enriches","وَأَنَّهُۥ هُوَ","وَأَقْنَىٰ",616],["54:5:4",528,"تُغْنِ","will avail","حِكْمَةٌۢ بَـٰلِغَةٌۭ ۖ فَمَا","ٱلنُّذُرُ",383],["57:24:11",540,"ٱلْغَنِىُّ","(is) Free of need","فَإِنَّ ٱللَّهَ هُوَ","ٱلْحَمِيدُ",440],["58:17:2",544,"تُغْنِىَ","will avail","لَّن","عَنْهُمْ أَمْوَٰلُهُمْ وَلَآ",383],["59:7:22",546,"ٱلْأَغْنِيَآءِ","the rich","يَكُونَ دُولَةًۢ بَيْنَ","مِنكُمْ ۚ وَمَآ ءَاتَىٰكُمُ",440],["60:6:18",550,"ٱلْغَنِىُّ","(is) Free of need","فَإِنَّ ٱللَّهَ هُوَ","ٱلْحَمِيدُ",440],["64:6:12",556,"وَّٱسْتَغْنَى","And can do without them","يَهْدُونَنَا فَكَفَرُوا۟ وَتَوَلَّوا۟ ۚ","ٱللَّهُ ۚ وَٱللَّهُ غَنِىٌّ",1701],["64:6:15",556,"غَنِىٌّ","(is) Self-sufficient","وَّٱسْتَغْنَى ٱللَّهُ ۚ وَٱللَّهُ","حَمِيدٌۭ",440],["66:10:18",561,"يُغْنِيَا","they availed","صَـٰلِحَيْنِ فَخَانَتَاهُمَا فَلَمْ","عَنْهُمَا مِنَ ٱللَّهِ",383],["69:28:2",567,"أَغْنَىٰ","has availed","مَآ","عَنِّى مَالِيَهْ ۜ",616],["77:31:4",581,"يُغْنِى","availing","لَّا ظَلِيلٍۢ وَلَا","مِنَ ٱللَّهَبِ",383],["80:5:3",585,"ٱسْتَغْنَىٰ","considers himself free from need","أَمَّا مَنِ","",1701],["80:37:6",585,"يُغْنِيهِ","occupying him","مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ","",383],["88:7:4",592,"يُغْنِى","it avails","لَّا يُسْمِنُ وَلَا","مِن جُوعٍۢ",383],["92:8:4",595,"وَٱسْتَغْنَىٰ","and considers himself free from need","وَأَمَّا مَنۢ بَخِلَ","",1701],["92:11:2",596,"يُغْنِى","will avail","وَمَا","عَنْهُ مَالُهُۥٓ إِذَا",383],["93:8:3",596,"فَأَغْنَىٰ","so He made self-sufficient","وَوَجَدَكَ عَآئِلًۭا","",616],["96:7:3",597,"ٱسْتَغْنَىٰٓ","self-sufficient","أَن رَّءَاهُ","",1701],["111:2:2",603,"أَغْنَىٰ","(will) avail","مَآ","عَنْهُ مَالُهُۥ وَمَا",616]]