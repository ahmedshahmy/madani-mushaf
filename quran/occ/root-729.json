[["2:22:21",4,"أَندَادًۭا","rivals","فَلَا تَجْعَلُوا۟ لِلَّهِ","وَأَنتُمْ تَعْلَمُونَ",1137],["2:165:8",25,"أَندَادًۭا","equals","مِن دُونِ ٱللَّهِ","يُحِبُّونَهُمْ كَحُبِّ ٱللَّهِ ۖ",1137],["14:30:3",259,"أَندَادًۭا","equals","وَجَعَلُوا۟ لِلَّهِ","لِّيُضِلُّوا۟ عَن سَبِيلِهِۦ ۗ",1137],["34:33:17",432,"أَندَادًۭا ۚ","equals","بِٱللَّهِ وَنَجْعَلَ لَهُۥٓ","وَأَسَرُّوا۟ ٱلنَّدَامَةَ لَمَّا",1137],["39:8:23",459,"أَندَادًۭا","rivals","قَبْلُ وَجَعَلَ لِلَّهِ","لِّيُضِلَّ عَن سَبِيلِهِۦ ۚ",1137],["41:9:11",477,"أَندَادًۭا ۚ","rivals","يَوْمَيْنِ وَتَجْعَلُونَ لَهُۥٓ","ذَٰلِكَ رَبُّ ٱلْعَـٰلَمِينَ",1137]]