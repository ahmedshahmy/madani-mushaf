[["3:40:11",55,"عَاقِرٌۭ ۖ","(is) [a] barren","بَلَغَنِىَ ٱلْكِبَرُ وَٱمْرَأَتِى","قَالَ كَذَٰلِكَ ٱللَّهُ",1763],["7:77:1",160,"فَعَقَرُوا۟","Then they hamstrung","","ٱلنَّاقَةَ وَعَتَوْا۟ عَنْ",1295],["11:65:1",229,"فَعَقَرُوهَا","But they hamstrung her","","فَقَالَ تَمَتَّعُوا۟ فِى",1295],["19:5:8",305,"عَاقِرًۭا","barren","وَرَآءِى وَكَانَتِ ٱمْرَأَتِى","فَهَبْ لِى مِن",1763],["19:8:9",305,"عَاقِرًۭا","barren","غُلَـٰمٌۭ وَكَانَتِ ٱمْرَأَتِى","وَقَدْ بَلَغْتُ مِنَ",1763],["26:157:1",373,"فَعَقَرُوهَا","But they hamstrung her","","فَأَصْبَحُوا۟ نَـٰدِمِينَ",1295],["54:29:4",530,"فَعَقَرَ","and hamstrung","فَنَادَوْا۟ صَاحِبَهُمْ فَتَعَاطَىٰ","",1295],["91:14:2",595,"فَعَقَرُوهَا","and they hamstrung her","فَكَذَّبُوهُ","فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم",1295]]