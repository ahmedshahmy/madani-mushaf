[["6:95:3",140,"فَالِقُ","(is the) Cleaver","۞ إِنَّ ٱللَّهَ","ٱلْحَبِّ وَٱلنَّوَىٰ ۖ يُخْرِجُ",2360],["6:96:1",140,"فَالِقُ","(He is the) Cleaver","","ٱلْإِصْبَاحِ وَجَعَلَ ٱلَّيْلَ",2360],["26:63:8",370,"فَٱنفَلَقَ","So it parted","ٱضْرِب بِّعَصَاكَ ٱلْبَحْرَ ۖ","فَكَانَ كُلُّ فِرْقٍۢ",4817],["113:1:4",604,"ٱلْفَلَقِ","(of) the dawn","قُلْ أَعُوذُ بِرَبِّ","",3415]]