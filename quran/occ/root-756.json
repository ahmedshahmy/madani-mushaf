[["4:23:6",81,"وَعَمَّـٰتُكُمْ","and your father's sisters","أُمَّهَـٰتُكُمْ وَبَنَاتُكُمْ وَأَخَوَٰتُكُمْ","وَخَـٰلَـٰتُكُمْ وَبَنَاتُ ٱلْأَخِ",1765],["24:61:34",358,"أَعْمَـٰمِكُمْ","(of) your paternal uncles","أَخَوَٰتِكُمْ أَوْ بُيُوتِ","أَوْ بُيُوتِ عَمَّـٰتِكُمْ",2240],["24:61:37",358,"عَمَّـٰتِكُمْ","(of) your paternal aunts","أَعْمَـٰمِكُمْ أَوْ بُيُوتِ","أَوْ بُيُوتِ أَخْوَٰلِكُمْ",1765],["33:50:18",424,"عَمِّكَ","(of) your paternal uncles","ٱللَّهُ عَلَيْكَ وَبَنَاتِ","وَبَنَاتِ عَمَّـٰتِكَ وَبَنَاتِ",2240],["33:50:20",424,"عَمَّـٰتِكَ","(of) your paternal aunts","وَبَنَاتِ عَمِّكَ وَبَنَاتِ","وَبَنَاتِ خَالِكَ وَبَنَاتِ",1765]]