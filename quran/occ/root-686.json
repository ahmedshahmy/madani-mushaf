[["17:101:4",292,"تِسْعَ","nine","وَلَقَدْ ءَاتَيْنَا مُوسَىٰ","ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ ۖ فَسْـَٔلْ",1406],["18:25:8",296,"تِسْعًۭا","nine","مِا۟ئَةٍۢ سِنِينَ وَٱزْدَادُوا۟","",1406],["27:12:11",377,"تِسْعِ","nine","غَيْرِ سُوٓءٍۢ ۖ فِى","ءَايَـٰتٍ إِلَىٰ فِرْعَوْنَ",1406],["27:48:4",381,"تِسْعَةُ","nine","وَكَانَ فِى ٱلْمَدِينَةِ","رَهْطٍۢ يُفْسِدُونَ فِى",2690],["38:23:5",454,"تِسْعٌۭ","ninety-nine","هَـٰذَآ أَخِى لَهُۥ","وَتِسْعُونَ نَعْجَةًۭ وَلِىَ",1406],["38:23:6",454,"وَتِسْعُونَ","ninety-nine","أَخِى لَهُۥ تِسْعٌۭ","نَعْجَةًۭ وَلِىَ نَعْجَةٌۭ",1406],["74:30:2",576,"تِسْعَةَ","(are) nine","عَلَيْهَا","عَشَرَ",2690]]