[["2:19:18",4,"مُحِيطٌۢ","(is) [the One Who] encompasses","حَذَرَ ٱلْمَوْتِ ۚ وَٱللَّهُ","بِٱلْكَـٰفِرِينَ",910],["2:81:5",12,"وَأَحَـٰطَتْ","and surrounded him","مَن كَسَبَ سَيِّئَةًۭ","بِهِۦ خَطِيٓـَٔتُهُۥ فَأُو۟لَـٰٓئِكَ",561],["2:255:34",42,"يُحِيطُونَ","they encompass","وَمَا خَلْفَهُمْ ۖ وَلَا","بِشَىْءٍۢ مِّنْ عِلْمِهِۦٓ",561],["3:120:21",65,"مُحِيطٌۭ","(is) All-Encompassing","ٱللَّهَ بِمَا يَعْمَلُونَ","",910],["4:108:21",96,"مُحِيطًا","All-Encompassing","ٱللَّهُ بِمَا يَعْمَلُونَ","",910],["4:126:12",98,"مُّحِيطًۭا","All-Encompassing","ٱللَّهُ بِكُلِّ شَىْءٍۢ","",910],["8:47:17",183,"مُحِيطٌۭ","(is) All-Encompassing","وَٱللَّهُ بِمَا يَعْمَلُونَ","",910],["9:49:14",195,"لَمُحِيطَةٌۢ","(will) surely surround","سَقَطُوا۟ ۗ وَإِنَّ جَهَنَّمَ","بِٱلْكَـٰفِرِينَ",2481],["10:22:28",211,"أُحِيطَ","are surrounded","مَكَانٍۢ وَظَنُّوٓا۟ أَنَّهُمْ","بِهِمْ ۙ دَعَوُا۟ ٱللَّهَ",561],["10:39:5",213,"يُحِيطُوا۟","they could encompass","كَذَّبُوا۟ بِمَا لَمْ","بِعِلْمِهِۦ وَلَمَّا يَأْتِهِمْ",561],["11:84:26",231,"مُّحِيطٍۢ","all-encompassing","عَلَيْكُمْ عَذَابَ يَوْمٍۢ","",910],["11:92:15",232,"مُحِيطٌۭ","(is) All-Encompassing","رَبِّى بِمَا تَعْمَلُونَ","",910],["12:66:14",243,"يُحَاطَ","you are surrounded","بِهِۦٓ إِلَّآ أَن","بِكُمْ ۖ فَلَمَّآ ءَاتَوْهُ",561],["17:60:6",288,"أَحَاطَ","has encompassed","لَكَ إِنَّ رَبَّكَ","بِٱلنَّاسِ ۚ وَمَا جَعَلْنَا",561],["18:29:15",297,"أَحَاطَ","will surround","أَعْتَدْنَا لِلظَّـٰلِمِينَ نَارًا","بِهِمْ سُرَادِقُهَا ۚ وَإِن",561],["18:42:1",298,"وَأُحِيطَ","And were surrounded","","بِثَمَرِهِۦ فَأَصْبَحَ يُقَلِّبُ",561],["18:68:6",301,"تُحِطْ","you encompass","عَلَىٰ مَا لَمْ","بِهِۦ خُبْرًۭا",561],["18:91:3",303,"أَحَطْنَا","We encompassed","كَذَٰلِكَ وَقَدْ","بِمَا لَدَيْهِ خُبْرًۭا",561],["20:110:8",319,"يُحِيطُونَ","they encompass","وَمَا خَلْفَهُمْ وَلَا","بِهِۦ عِلْمًۭا",561],["27:22:5",378,"أَحَطتُ","I have encompassed","غَيْرَ بَعِيدٍۢ فَقَالَ","بِمَا لَمْ تُحِطْ",561],["27:22:8",378,"تُحِطْ","you have encompassed","أَحَطتُ بِمَا لَمْ","بِهِۦ وَجِئْتُكَ مِن",561],["27:84:8",384,"تُحِيطُوا۟","you encompassed","أَكَذَّبْتُم بِـَٔايَـٰتِى وَلَمْ","بِهَا عِلْمًا أَمَّاذَا",561],["29:54:5",403,"لَمُحِيطَةٌۢ","will surely, encompass","بِٱلْعَذَابِ وَإِنَّ جَهَنَّمَ","بِٱلْكَـٰفِرِينَ",2481],["41:54:12",482,"مُّحِيطٌۢ","encompassing","إِنَّهُۥ بِكُلِّ شَىْءٍۢ","",910],["48:21:6",513,"أَحَاطَ","Allah encompassed","تَقْدِرُوا۟ عَلَيْهَا قَدْ","ٱللَّهُ بِهَا ۚ وَكَانَ",561],["65:12:22",559,"أَحَاطَ","encompasses","وَأَنَّ ٱللَّهَ قَدْ","بِكُلِّ شَىْءٍ عِلْمًۢا",561],["72:28:7",573,"وَأَحَاطَ","and He has encompassed","أَبْلَغُوا۟ رِسَـٰلَـٰتِ رَبِّهِمْ","بِمَا لَدَيْهِمْ وَأَحْصَىٰ",561],["85:20:4",590,"مُّحِيطٌۢ","encompasses","وَٱللَّهُ مِن وَرَآئِهِم","",910]]