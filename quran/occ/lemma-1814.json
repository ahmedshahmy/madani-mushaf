[["23:100:13",348,"بَرْزَخٌ","(is) a barrier","قَآئِلُهَا ۖ وَمِن وَرَآئِهِم","إِلَىٰ يَوْمِ يُبْعَثُونَ",1814],["25:53:13",364,"بَرْزَخًۭا","a barrier","أُجَاجٌۭ وَجَعَلَ بَيْنَهُمَا","وَحِجْرًۭا مَّحْجُورًۭا",1814],["55:20:2",532,"بَرْزَخٌۭ","(is) a barrier","بَيْنَهُمَا","لَّا يَبْغِيَانِ",1814]]