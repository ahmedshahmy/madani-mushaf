[["6:14:6",129,"فَاطِرِ","Creator","ٱللَّهِ أَتَّخِذُ وَلِيًّۭا","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَهُوَ",1174],["6:79:5",137,"فَطَرَ","created","وَجَّهْتُ وَجْهِىَ لِلَّذِى","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ حَنِيفًۭا ۖ",833],["11:51:11",227,"فَطَرَنِىٓ ۚ","created me","إِلَّا عَلَى ٱلَّذِى","أَفَلَا تَعْقِلُونَ",833],["12:101:10",247,"فَاطِرَ","Creator","مِن تَأْوِيلِ ٱلْأَحَادِيثِ ۚ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ أَنتَ",1174],["14:10:6",256,"فَاطِرِ","(the) Creator","أَفِى ٱللَّهِ شَكٌّۭ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ يَدْعُوكُمْ",1174],["17:51:12",287,"فَطَرَكُمْ","created you","يُعِيدُنَا ۖ قُلِ ٱلَّذِى","أَوَّلَ مَرَّةٍۢ ۚ فَسَيُنْغِضُونَ",833],["19:90:3",311,"يَتَفَطَّرْنَ","get torn","تَكَادُ ٱلسَّمَـٰوَٰتُ","مِنْهُ وَتَنشَقُّ ٱلْأَرْضُ",833],["20:72:10",316,"فَطَرَنَا ۖ","created us","مِنَ ٱلْبَيِّنَـٰتِ وَٱلَّذِى","فَٱقْضِ مَآ أَنتَ",833],["21:56:8",326,"فَطَرَهُنَّ","created them","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ٱلَّذِى","وَأَنَا۠ عَلَىٰ ذَٰلِكُم",833],["30:30:5",407,"فِطْرَتَ","Nature","وَجْهَكَ لِلدِّينِ حَنِيفًۭا ۚ","ٱللَّهِ ٱلَّتِى فَطَرَ",3434],["30:30:8",407,"فَطَرَ","He has created","فِطْرَتَ ٱللَّهِ ٱلَّتِى","ٱلنَّاسَ عَلَيْهَا ۚ لَا",833],["35:1:3",434,"فَاطِرِ","Originator","ٱلْحَمْدُ لِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ جَاعِلِ",1174],["36:22:6",441,"فَطَرَنِى","created me","لَآ أَعْبُدُ ٱلَّذِى","وَإِلَيْهِ تُرْجَعُونَ",833],["39:46:3",463,"فَاطِرَ","Creator","قُلِ ٱللَّهُمَّ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ عَـٰلِمَ",1174],["42:5:3",483,"يَتَفَطَّرْنَ","break up","تَكَادُ ٱلسَّمَـٰوَٰتُ","مِن فَوْقِهِنَّ ۚ وَٱلْمَلَـٰٓئِكَةُ",833],["42:11:1",484,"فَاطِرُ","(The) Creator","","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ جَعَلَ",1174],["43:27:3",491,"فَطَرَنِى","created me","إِلَّا ٱلَّذِى","فَإِنَّهُۥ سَيَهْدِينِ",833],["67:3:18",562,"فُطُورٍۢ","flaw","هَلْ تَرَىٰ مِن","",3440],["73:18:2",574,"مُنفَطِرٌۢ","(will) break apart","ٱلسَّمَآءُ","بِهِۦ ۚ كَانَ وَعْدُهُۥ",3826],["82:1:3",587,"ٱنفَطَرَتْ","(is) cleft asunder","إِذَا ٱلسَّمَآءُ","",4815]]