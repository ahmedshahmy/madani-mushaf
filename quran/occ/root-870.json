[["12:59:2",242,"جَهَّزَهُم","he had furnished them","وَلَمَّا","بِجَهَازِهِمْ قَالَ ٱئْتُونِى",2397],["12:59:3",242,"بِجَهَازِهِمْ","with their supplies","وَلَمَّا جَهَّزَهُم","قَالَ ٱئْتُونِى بِأَخٍۢ",2396],["12:70:2",244,"جَهَّزَهُم","he had furnished them","فَلَمَّا","بِجَهَازِهِمْ جَعَلَ ٱلسِّقَايَةَ",2397],["12:70:3",244,"بِجَهَازِهِمْ","with their supplies","فَلَمَّا جَهَّزَهُم","جَعَلَ ٱلسِّقَايَةَ فِى",2396]]