[["2:30:22",6,"لَكَ ۖ","[to] You","نُسَبِّحُ بِحَمْدِكَ وَنُقَدِّسُ","قَالَ إِنِّىٓ أَعْلَمُ",138],["2:55:6",8,"لَكَ","in you","يَـٰمُوسَىٰ لَن نُّؤْمِنَ","حَتَّىٰ نَرَى ٱللَّهَ",138],["2:120:25",19,"لَكَ","for you","مِنَ ٱلْعِلْمِ ۙ مَا","مِنَ ٱللَّهِ مِن",138],["2:128:4",20,"لَكَ","to You","رَبَّنَا وَٱجْعَلْنَا مُسْلِمَيْنِ","وَمِن ذُرِّيَّتِنَآ أُمَّةًۭ",138],["2:128:9",20,"لَّكَ","to You","ذُرِّيَّتِنَآ أُمَّةًۭ مُّسْلِمَةًۭ","وَأَرِنَا مَنَاسِكَنَا وَتُبْ",138],["3:35:8",54,"لَكَ","to You","رَبِّ إِنِّى نَذَرْتُ","مَا فِى بَطْنِى",138],["3:36:20",54,"بِكَ","in You","مَرْيَمَ وَإِنِّىٓ أُعِيذُهَا","وَذُرِّيَّتَهَا مِنَ ٱلشَّيْطَـٰنِ",138],["3:37:21",54,"لَكِ","for you","قَالَ يَـٰمَرْيَمُ أَنَّىٰ","هَـٰذَا ۖ قَالَتْ هُوَ",138],["3:128:2",66,"لَكَ","for you","لَيْسَ","مِنَ ٱلْأَمْرِ شَىْءٌ",138],["3:154:40",70,"لَكَ ۖ","to you","مَّا لَا يُبْدُونَ","يَقُولُونَ لَوْ كَانَ",138],["4:41:9",85,"بِكَ","you","أُمَّةٍۭ بِشَهِيدٍۢ وَجِئْنَا","عَلَىٰ هَـٰٓؤُلَآءِ شَهِيدًۭا",138],["7:13:6",152,"لَكَ","for you","مِنْهَا فَمَا يَكُونُ","أَن تَتَكَبَّرَ فِيهَا",138],["7:132:11",166,"لَكَ","(will be) in you","بِهَا فَمَا نَحْنُ","بِمُؤْمِنِينَ",138],["7:134:18",166,"لَكَ","[for] you","عَنَّا ٱلرِّجْزَ لَنُؤْمِنَنَّ","وَلَنُرْسِلَنَّ مَعَكَ بَنِىٓ",138],["8:30:3",180,"بِكَ","against you","وَإِذْ يَمْكُرُ","ٱلَّذِينَ كَفَرُوا۟ لِيُثْبِتُوكَ",138],["9:43:9",194,"لَكَ","to you","لَهُمْ حَتَّىٰ يَتَبَيَّنَ","ٱلَّذِينَ صَدَقُوا۟ وَتَعْلَمَ",138],["9:48:7",195,"لَكَ","for you","مِن قَبْلُ وَقَلَّبُوا۟","ٱلْأُمُورَ حَتَّىٰ جَآءَ",138],["11:46:15",227,"لَكَ","you have","تَسْـَٔلْنِ مَا لَيْسَ","بِهِۦ عِلْمٌ ۖ إِنِّىٓ",138],["11:47:5",227,"بِكَ","in You","رَبِّ إِنِّىٓ أَعُوذُ","أَنْ أَسْـَٔلَكَ مَا",138],["11:53:14",227,"لَكَ","in you","قَوْلِكَ وَمَا نَحْنُ","بِمُؤْمِنِينَ",138],["12:5:9",236,"لَكَ","against you","عَلَىٰٓ إِخْوَتِكَ فَيَكِيدُوا۟","كَيْدًا ۖ إِنَّ ٱلشَّيْطَـٰنَ",138],["12:11:4",236,"لَكَ","(do) you","قَالُوا۟ يَـٰٓأَبَانَا مَا","لَا تَأْمَ۫نَّا عَلَىٰ",138],["12:23:12",238,"لَكَ ۚ","you","ٱلْأَبْوَٰبَ وَقَالَتْ هَيْتَ","قَالَ مَعَاذَ ٱللَّهِ ۖ",138],["13:37:13",254,"لَكَ","for you","مِنَ ٱلْعِلْمِ مَا","مِنَ ٱللَّهِ مِن",138],["15:32:4",264,"لَكَ","(is) for you","قَالَ يَـٰٓإِبْلِيسُ مَا","أَلَّا تَكُونَ مَعَ",138],["15:42:4",264,"لَكَ","you have","إِنَّ عِبَادِى لَيْسَ","عَلَيْهِمْ سُلْطَـٰنٌ إِلَّا",138],["16:89:11",277,"بِكَ","you","مِّنْ أَنفُسِهِمْ ۖ وَجِئْنَا","شَهِيدًا عَلَىٰ هَـٰٓؤُلَآءِ ۚ",138],["17:36:5",285,"لَكَ","you have","تَقْفُ مَا لَيْسَ","بِهِۦ عِلْمٌ ۚ إِنَّ",138],["17:48:4",286,"لَكَ","for you","ٱنظُرْ كَيْفَ ضَرَبُوا۟","ٱلْأَمْثَالَ فَضَلُّوا۟ فَلَا",138],["17:60:3",288,"لَكَ","to you","وَإِذْ قُلْنَا","إِنَّ رَبَّكَ أَحَاطَ",138],["17:65:4",288,"لَكَ","for you","إِنَّ عِبَادِى لَيْسَ","عَلَيْهِمْ سُلْطَـٰنٌۭ ۚ وَكَفَىٰ",138],["17:75:10",289,"لَكَ","for you","ثُمَّ لَا تَجِدُ","عَلَيْنَا نَصِيرًۭا",138],["17:79:6",290,"لَّكَ","for you","فَتَهَجَّدْ بِهِۦ نَافِلَةًۭ","عَسَىٰٓ أَن يَبْعَثَكَ",138],["17:86:10",290,"لَكَ","for you","ثُمَّ لَا تَجِدُ","بِهِۦ عَلَيْنَا وَكِيلًا",138],["17:90:4",291,"لَكَ","in you","وَقَالُوا۟ لَن نُّؤْمِنَ","حَتَّىٰ تَفْجُرَ لَنَا",138],["17:91:3",291,"لَكَ","for you","أَوْ تَكُونَ","جَنَّةٌۭ مِّن نَّخِيلٍۢ",138],["17:93:3",291,"لَكَ","for you","أَوْ يَكُونَ","بَيْتٌۭ مِّن زُخْرُفٍ",138],["18:69:9",301,"لَكَ","your","صَابِرًۭا وَلَآ أَعْصِى","أَمْرًۭا",138],["18:70:10",301,"لَكَ","to you","شَىْءٍ حَتَّىٰٓ أُحْدِثَ","مِنْهُ ذِكْرًۭا",138],["18:75:4",302,"لَّكَ","to you","۞ قَالَ أَلَمْ أَقُل","إِنَّكَ لَن تَسْتَطِيعَ",138],["18:94:12",303,"لَكَ","for you","ٱلْأَرْضِ فَهَلْ نَجْعَلُ","خَرْجًا عَلَىٰٓ أَن",138],["19:19:7",306,"لَكِ","on you","رَسُولُ رَبِّكِ لِأَهَبَ","غُلَـٰمًۭا زَكِيًّۭا",138],["19:47:5",308,"لَكَ","for you","سَلَـٰمٌ عَلَيْكَ ۖ سَأَسْتَغْفِرُ","رَبِّىٓ ۖ إِنَّهُۥ كَانَ",138],["20:97:4",318,"لَكَ","for you","قَالَ فَٱذْهَبْ فَإِنَّ","فِى ٱلْحَيَوٰةِ أَن",138],["20:97:12",318,"لَكَ","for you","لَا مِسَاسَ ۖ وَإِنَّ","مَوْعِدًۭا لَّن تُخْلَفَهُۥ ۖ",138],["20:117:6",320,"لَّكَ","to you","إِنَّ هَـٰذَا عَدُوٌّۭ","وَلِزَوْجِكَ فَلَا يُخْرِجَنَّكُمَا",138],["20:118:2",320,"لَكَ","for you","إِنَّ","أَلَّا تَجُوعَ فِيهَا",138],["23:97:4",348,"بِكَ","in You","وَقُل رَّبِّ أَعُوذُ","مِنْ هَمَزَٰتِ ٱلشَّيَـٰطِينِ",138],["23:98:2",348,"بِكَ","in You","وَأَعُوذُ","رَبِّ أَن يَحْضُرُونِ",138],["25:9:4",360,"لَكَ","for you","ٱنظُرْ كَيْفَ ضَرَبُوا۟","ٱلْأَمْثَـٰلَ فَضَلُّوا۟ فَلَا",138],["25:10:6",360,"لَكَ","for you","إِن شَآءَ جَعَلَ","خَيْرًۭا مِّن ذَٰلِكَ",138],["25:10:16",360,"لَّكَ","for you","تَحْتِهَا ٱلْأَنْهَـٰرُ وَيَجْعَل","قُصُورًۢا",138],["26:111:3",371,"لَكَ","in you","۞ قَالُوٓا۟ أَنُؤْمِنُ","وَٱتَّبَعَكَ ٱلْأَرْذَلُونَ",138],["27:47:3",381,"بِكَ","We consider you a bad omen","قَالُوا۟ ٱطَّيَّرْنَا","وَبِمَن مَّعَكَ ۚ قَالَ",138],["28:9:7",386,"وَلَكَ ۖ","and for you","قُرَّتُ عَيْنٍۢ لِّى","لَا تَقْتُلُوهُ عَسَىٰٓ",138],["28:20:12",387,"بِكَ","about you","إِنَّ ٱلْمَلَأَ يَأْتَمِرُونَ","لِيَقْتُلُوكَ فَٱخْرُجْ إِنِّى",138],["28:20:16",387,"لَكَ","to you","لِيَقْتُلُوكَ فَٱخْرُجْ إِنِّى","مِنَ ٱلنَّـٰصِحِينَ",138],["28:50:4",391,"لَكَ","to you","فَإِن لَّمْ يَسْتَجِيبُوا۟","فَٱعْلَمْ أَنَّمَا يَتَّبِعُونَ",138],["29:8:11",397,"لَكَ","you have","بِى مَا لَيْسَ","بِهِۦ عِلْمٌۭ فَلَا",138],["31:15:9",412,"لَكَ","you have","بِى مَا لَيْسَ","بِهِۦ عِلْمٌۭ فَلَا",138],["33:50:5",424,"لَكَ","to you","ٱلنَّبِىُّ إِنَّآ أَحْلَلْنَا","أَزْوَٰجَكَ ٱلَّـٰتِىٓ ءَاتَيْتَ",138],["33:50:40",424,"لَّكَ","for you","أَن يَسْتَنكِحَهَا خَالِصَةًۭ","مِن دُونِ ٱلْمُؤْمِنِينَ ۗ",138],["33:52:3",425,"لَكَ","for you","لَّا يَحِلُّ","ٱلنِّسَآءُ مِنۢ بَعْدُ",138],["41:43:3",481,"لَكَ","to you","مَّا يُقَالُ","إِلَّا مَا قَدْ",138],["43:41:3",492,"بِكَ","We take you away","فَإِمَّا نَذْهَبَنَّ","فَإِنَّا مِنْهُم مُّنتَقِمُونَ",138],["43:44:3",492,"لَّكَ","for you","وَإِنَّهُۥ لَذِكْرٌۭ","وَلِقَوْمِكَ ۖ وَسَوْفَ تُسْـَٔلُونَ",138],["43:58:8",493,"لَكَ","to you","هُوَ ۚ مَا ضَرَبُوهُ","إِلَّا جَدَلًۢا ۚ بَلْ",138],["48:1:3",511,"لَكَ","to you","إِنَّا فَتَحْنَا","فَتْحًۭا مُّبِينًۭا",138],["48:2:2",511,"لَكَ","for you","لِّيَغْفِرَ","ٱللَّهُ مَا تَقَدَّمَ",138],["48:11:2",512,"لَكَ","to you","سَيَقُولُ","ٱلْمُخَلَّفُونَ مِنَ ٱلْأَعْرَابِ",138],["56:91:2",537,"لَّكَ","for you","فَسَلَـٰمٌۭ","مِنْ أَصْحَـٰبِ ٱلْيَمِينِ",138],["60:4:38",549,"لَكَ","for you","إِبْرَٰهِيمَ لِأَبِيهِ لَأَسْتَغْفِرَنَّ","وَمَآ أَمْلِكُ لَكَ",138],["60:4:41",549,"لَكَ","for you","لَكَ وَمَآ أَمْلِكُ","مِنَ ٱللَّهِ مِن",138],["66:1:8",560,"لَكَ ۖ","for you","مَآ أَحَلَّ ٱللَّهُ","تَبْتَغِى مَرْضَاتَ أَزْوَٰجِكَ ۚ",138],["68:3:2",564,"لَكَ","for you","وَإِنَّ","لَأَجْرًا غَيْرَ مَمْنُونٍۢ",138],["73:7:2",574,"لَكَ","for you","إِنَّ","فِى ٱلنَّهَارِ سَبْحًۭا",138],["75:34:2",578,"لَكَ","to you","أَوْلَىٰ","فَأَوْلَىٰ",138],["75:35:3",578,"لَكَ","to you","ثُمَّ أَوْلَىٰ","فَأَوْلَىٰٓ",138],["79:18:3",584,"لَّكَ","[for] you","فَقُلْ هَل","إِلَىٰٓ أَن تَزَكَّىٰ",138],["93:4:3",596,"لَّكَ","for you","وَلَلْـَٔاخِرَةُ خَيْرٌۭ","مِنَ ٱلْأُولَىٰ",138],["94:1:3",596,"لَكَ","for you","أَلَمْ نَشْرَحْ","صَدْرَكَ",138],["94:4:2",597,"لَكَ","for you","وَرَفَعْنَا","ذِكْرَكَ",138]]