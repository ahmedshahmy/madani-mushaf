[["10:24:38",211,"بِٱلْأَمْسِ ۚ","yesterday","كَأَن لَّمْ تَغْنَ","كَذَٰلِكَ نُفَصِّلُ ٱلْـَٔايَـٰتِ",1475],["28:18:9",387,"بِٱلْأَمْسِ","the previous day","فَإِذَا ٱلَّذِى ٱسْتَنصَرَهُۥ","يَسْتَصْرِخُهُۥ ۚ قَالَ لَهُۥ",1475],["28:19:18",387,"بِٱلْأَمْسِ ۖ","yesterday","كَمَا قَتَلْتَ نَفْسًۢا","إِن تُرِيدُ إِلَّآ",1475],["28:82:5",395,"بِٱلْأَمْسِ","the day before","ٱلَّذِينَ تَمَنَّوْا۟ مَكَانَهُۥ","يَقُولُونَ وَيْكَأَنَّ ٱللَّهَ",1475]]