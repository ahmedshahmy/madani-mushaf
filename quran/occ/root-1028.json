[["23:12:5",342,"سُلَـٰلَةٍۢ","an essence","خَلَقْنَا ٱلْإِنسَـٰنَ مِن","مِّن طِينٍۢ",2643],["24:63:13",359,"يَتَسَلَّلُونَ","slip away","يَعْلَمُ ٱللَّهُ ٱلَّذِينَ","مِنكُمْ لِوَاذًۭا ۚ فَلْيَحْذَرِ",4687],["32:8:5",415,"سُلَـٰلَةٍۢ","an extract","جَعَلَ نَسْلَهُۥ مِن","مِّن مَّآءٍۢ مَّهِينٍۢ",2643]]