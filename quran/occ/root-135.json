[["2:25:30",5,"أَزْوَٰجٌۭ","spouses","مُتَشَـٰبِهًۭا ۖ وَلَهُمْ فِيهَآ","مُّطَهَّرَةٌۭ ۖ وَهُمْ فِيهَا",152],["2:35:5",6,"وَزَوْجُكَ","and your spouse","يَـٰٓـَٔادَمُ ٱسْكُنْ أَنتَ","ٱلْجَنَّةَ وَكُلَا مِنْهَا",152],["2:102:42",16,"وَزَوْجِهِۦ ۚ","and his spouse","بِهِۦ بَيْنَ ٱلْمَرْءِ","وَمَا هُم بِضَآرِّينَ",152],["2:230:10",36,"زَوْجًا","a spouse","بَعْدُ حَتَّىٰ تَنكِحَ","غَيْرَهُۥ ۗ فَإِن طَلَّقَهَا",152],["2:232:10",37,"أَزْوَٰجَهُنَّ","their husbands","تَعْضُلُوهُنَّ أَن يَنكِحْنَ","إِذَا تَرَٰضَوْا۟ بَيْنَهُم",152],["2:234:5",38,"أَزْوَٰجًۭا","wives","يُتَوَفَّوْنَ مِنكُمْ وَيَذَرُونَ","يَتَرَبَّصْنَ بِأَنفُسِهِنَّ أَرْبَعَةَ",152],["2:240:5",39,"أَزْوَٰجًۭا","(their) wives","يُتَوَفَّوْنَ مِنكُمْ وَيَذَرُونَ","وَصِيَّةًۭ لِّأَزْوَٰجِهِم مَّتَـٰعًا",152],["2:240:7",39,"لِّأَزْوَٰجِهِم","for their wives","وَيَذَرُونَ أَزْوَٰجًۭا وَصِيَّةًۭ","مَّتَـٰعًا إِلَى ٱلْحَوْلِ",152],["3:15:17",51,"وَأَزْوَٰجٌۭ","and spouses","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا","مُّطَهَّرَةٌۭ وَرِضْوَٰنٌۭ مِّنَ",152],["4:1:12",77,"زَوْجَهَا","its mate","وَٰحِدَةٍۢ وَخَلَقَ مِنْهَا","وَبَثَّ مِنْهُمَا رِجَالًۭا",152],["4:12:5",79,"أَزْوَٰجُكُمْ","by your wives","نِصْفُ مَا تَرَكَ","إِن لَّمْ يَكُن",152],["4:20:4",81,"زَوْجٍۢ","a wife","وَإِنْ أَرَدتُّمُ ٱسْتِبْدَالَ","مَّكَانَ زَوْجٍۢ وَءَاتَيْتُمْ",152],["4:20:6",81,"زَوْجٍۢ","(of) a wife","ٱسْتِبْدَالَ زَوْجٍۢ مَّكَانَ","وَءَاتَيْتُمْ إِحْدَىٰهُنَّ قِنطَارًۭا",152],["4:57:16",87,"أَزْوَٰجٌۭ","(are) spouses","أَبَدًۭا ۖ لَّهُمْ فِيهَآ","مُّطَهَّرَةٌۭ ۖ وَنُدْخِلُهُمْ ظِلًّۭا",152],["6:139:11",146,"أَزْوَٰجِنَا ۖ","our spouses","لِّذُكُورِنَا وَمُحَرَّمٌ عَلَىٰٓ","وَإِن يَكُن مَّيْتَةًۭ",152],["6:143:2",147,"أَزْوَٰجٍۢ ۖ","pairs","ثَمَـٰنِيَةَ","مِّنَ ٱلضَّأْنِ ٱثْنَيْنِ",152],["7:19:4",152,"وَزَوْجُكَ","and your wife","وَيَـٰٓـَٔادَمُ ٱسْكُنْ أَنتَ","ٱلْجَنَّةَ فَكُلَا مِنْ",152],["7:189:9",175,"زَوْجَهَا","its mate","وَٰحِدَةٍۢ وَجَعَلَ مِنْهَا","لِيَسْكُنَ إِلَيْهَا ۖ فَلَمَّا",152],["9:24:7",190,"وَأَزْوَٰجُكُمْ","and your spouse