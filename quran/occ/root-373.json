[["2:202:7",31,"سَرِيعُ","(is) swift","مِّمَّا كَسَبُوا۟ ۚ وَٱللَّهُ","ٱلْحِسَابِ",859],["3:19:25",52,"سَرِيعُ","(is) swift","ٱللَّهِ فَإِنَّ ٱللَّهَ","ٱلْحِسَابِ",859],["3:114:10",64,"وَيُسَـٰرِعُونَ","and they hasten","وَيَنْهَوْنَ عَنِ ٱلْمُنكَرِ","فِى ٱلْخَيْرَٰتِ وَأُو۟لَـٰٓئِكَ",942],["3:133:1",67,"۞ وَسَارِعُوٓا۟","And hasten","","إِلَىٰ مَغْفِرَةٍۢ مِّن",942],["3:176:4",73,"يُسَـٰرِعُونَ","hasten","وَلَا يَحْزُنكَ ٱلَّذِينَ","فِى ٱلْكُفْرِ ۚ إِنَّهُمْ",942],["3:199:29",76,"سَرِيعُ","(is) swift","رَبِّهِمْ ۗ إِنَّ ٱللَّهَ","ٱلْحِسَابِ",859],["5:4:30",107,"سَرِيعُ","is swift","ٱللَّهَ ۚ إِنَّ ٱللَّهَ","ٱلْحِسَابِ",859],["5:41:6",114,"يُسَـٰرِعُونَ","hasten","لَا يَحْزُنكَ ٱلَّذِينَ","فِى ٱلْكُفْرِ مِنَ",942],["5:52:6",117,"يُسَـٰرِعُونَ","they hasten","فِى قُلُوبِهِم مَّرَضٌۭ","فِيهِمْ يَقُولُونَ نَخْشَىٰٓ",942],["5:62:4",118,"يُسَـٰرِعُونَ","hastening","وَتَرَىٰ كَثِيرًۭا مِّنْهُمْ","فِى ٱلْإِثْمِ وَٱلْعُدْوَٰنِ",942],["6:62:11",135,"أَسْرَعُ","(is) swiftest","لَهُ ٱلْحُكْمُ وَهُوَ","ٱلْحَـٰسِبِينَ",2193],["6:165:17",150,"سَرِيعُ","(is) swift","ءَاتَىٰكُمْ ۗ إِنَّ رَبَّكَ","ٱلْعِقَابِ وَإِنَّهُۥ لَغَفُورٌۭ",859],["7:167:15",172,"لَسَرِيعُ","(is) surely swift","ٱلْعَذَابِ ۗ إِنَّ رَبَّكَ","ٱلْعِقَابِ ۖ وَإِنَّهُۥ لَغَفُورٌۭ",859],["10:21:16",211,"أَسْرَعُ","(is) more swift","ءَايَاتِنَا ۚ قُلِ ٱللَّهُ","مَكْرًا ۚ إِنَّ رُسُلَنَا",2193],["13:41:15",254,"سَرِيعُ","(is) Swift","مُعَقِّبَ لِحُكْمِهِۦ ۚ وَهُوَ","ٱلْحِسَابِ",859],["14:51:9",261,"سَرِيعُ","(is) Swift","كَسَبَتْ ۚ إِنَّ ٱللَّهَ","ٱلْحِسَابِ",859],["21:90:11",329,"يُسَـٰرِعُونَ","hasten","زَوْجَهُۥٓ ۚ إِنَّهُمْ كَانُوا۟","فِى ٱلْخَيْرَٰتِ وَيَدْعُونَنَا",942],["23:56:1",345,"نُسَارِعُ","We hasten","","لَهُمْ فِى ٱلْخَيْرَٰتِ ۚ",942],["23:61:2",346,"يُسَـٰرِعُونَ","who hasten","أُو۟لَـٰٓئِكَ","فِى ٱلْخَيْرَٰتِ وَهُمْ",942],["24:39:21",355,"سَرِيعُ","(is) swift","فَوَفَّىٰهُ حِسَابَهُۥ ۗ وَٱللَّهُ","ٱلْحِسَابِ",859],["40:17:12",469,"سَرِيعُ","(is) Swift","ٱلْيَوْمَ ۚ إِنَّ ٱللَّهَ","ٱلْحِسَابِ",859],["50:44:5",520,"سِرَاعًۭا ۚ","hurrying","تَشَقَّقُ ٱلْأَرْضُ عَنْهُمْ","ذَٰلِكَ حَشْرٌ عَلَيْنَا",2639],["70:43:5",570,"سِرَاعًۭا","rapidly","يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ","كَأَنَّهُمْ إِلَىٰ نُصُبٍۢ",2639]]