َ حَلَّافٍۢ مَّهِينٍ",163],["68:42:9",565,"يَسْتَطِيعُونَ","they will be able","إِلَى ٱلسُّجُودِ فَلَا","",279],["71:3:5",570,"وَأَطِيعُونِ","and obey me","ٱعْبُدُوا۟ ٱللَّهَ وَٱتَّقُوهُ","",163],["76:24:5",579,"تُطِعْ","obey","لِحُكْمِ رَبِّكَ وَلَا","مِنْهُمْ ءَاثِمًا أَوْ",163],["81:21:1",586,"مُّطَاعٍۢ","One to be obeyed","","ثَمَّ أَمِينٍۢ",3960],["96:19:3",598,"تُطِعْهُ","obey him","كَلَّا لَا","وَٱسْجُدْ وَٱقْتَرِب ۩",163]]