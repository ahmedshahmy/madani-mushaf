[["2:158:19",24,"تَطَوَّعَ","voluntarily does","يَطَّوَّفَ بِهِمَا ۚ وَمَن","خَيْرًۭا فَإِنَّ ٱللَّهَ",2658],["2:184:21",28,"تَطَوَّعَ","volunteers","طَعَامُ مِسْكِينٍۢ ۖ فَمَن","خَيْرًۭا فَهُوَ خَيْرٌۭ",2658],["2:217:37",34,"ٱسْتَطَـٰعُوا۟ ۚ","they are able","عَن دِينِكُمْ إِنِ","وَمَن يَرْتَدِدْ مِنكُمْ",279],["2:273:8",46,"يَسْتَطِيعُونَ","they are able","سَبِيلِ ٱللَّهِ لَا","ضَرْبًۭا فِى ٱلْأَرْضِ",279],["2:282:45",48,"يَسْتَطِيعُ","capable","ضَعِيفًا أَوْ لَا","أَن يُمِلَّ هُوَ",279],["2:285:23",49,"وَأَطَعْنَا ۖ","and we obeyed","رُّسُلِهِۦ ۚ وَقَالُوا۟ سَمِعْنَا","غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ",163],["3:32:2",54,"أَطِيعُوا۟","Obey","قُلْ","ٱللَّهَ وَٱلرَّسُولَ ۖ فَإِن",163],["3:50:19",56,"وَأَطِيعُونِ","and obey me","رَّبِّكُمْ فَٱتَّقُوا۟ ٱللَّهَ","",163],["3:83:11",60,"طَوْعًۭا","willingly","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","وَكَرْهًۭا وَإِلَيْهِ يُرْجَعُونَ",1530],["3:97:16",62,"ٱسْتَطَاعَ","is able","حِجُّ ٱلْبَيْتِ مَنِ","إِلَيْهِ سَبِيلًۭا ۚ وَمَن",279],["3:100:5",62,"تُطِيعُوا۟","you obey","ٱلَّذِينَ ءَامَنُوٓا۟ إِن","فَرِيقًۭا مِّنَ ٱلَّذِينَ",163],["3:132:1",66,"وَأَطِيعُوا۟","And obey","","ٱللَّهَ وَٱلرَّسُولَ لَعَلَّكُمْ",163],["3:149:5",69,"تُطِيعُوا۟","you obey","ٱلَّذِينَ ءَامَنُوٓا۟ إِن","ٱلَّذِينَ كَفَرُوا۟ يَرُدُّوكُمْ",163],["3:168:6",72,"أَطَاعُونَا","they (had) obeyed us","لِإِخْوَٰنِهِمْ وَقَعَدُوا۟ لَوْ","مَا قُتِلُوا۟ ۗ قُلْ",163],["4:13:5",79,"يُطِعِ","obeys","حُدُودُ ٱللَّهِ ۚ وَمَن","ٱللَّهَ وَرَسُولَهُۥ يُدْخِلْهُ",163],["4:25:3",82,"يَسْتَطِعْ","able to","وَمَن لَّمْ","مِنكُمْ طَوْلًا أَن",279],["4:34:31",84,"أَطَعْنَكُمْ","they obey you","ٱلْمَضَاجِعِ وَٱضْرِبُوهُنَّ ۖ فَإِنْ","فَلَا تَبْغُوا۟ عَلَيْهِنَّ",163],["4:46:24",86,"وَأَطَعْنَا","and we obey[ed]","أَنَّهُمْ قَالُوا۟ سَمِعْنَا","وَٱسْمَعْ وَٱنظُرْنَا لَكَانَ",163],["4:59:4",87,"أَطِيعُوا۟","Obey","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟","ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ",163],["4:59:6",87,"وَأَطِيعُوا۟","and obey","ءَامَنُوٓا۟ أَطِيعُوا۟ ٱللَّهَ","ٱلرَّسُولَ وَأُو۟لِى ٱلْأَ