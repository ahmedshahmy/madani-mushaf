"ٱسْتَطَعْنَا","we were able","وَسَيَحْلِفُونَ بِٱللَّهِ لَوِ","لَخَرَجْنَا مَعَكُمْ يُهْلِكُونَ",279],["9:53:3",195,"طَوْعًا","willingly","قُلْ أَنفِقُوا۟","أَوْ كَرْهًۭا لَّن",1530],["9:71:15",198,"وَيُطِيعُونَ","and they obey","ٱلصَّلَوٰةَ وَيُؤْتُونَ ٱلزَّكَوٰةَ","ٱللَّهَ وَرَسُولَهُۥٓ ۚ أُو۟لَـٰٓئِكَ",163],["9:79:3",199,"ٱلْمُطَّوِّعِينَ","the ones who give willingly","ٱلَّذِينَ يَلْمِزُونَ","مِنَ ٱلْمُؤْمِنِينَ فِى",3782],["10:38:10",213,"ٱسْتَطَعْتُم","you can","مِّثْلِهِۦ وَٱدْعُوا۟ مَنِ","مِّن دُونِ ٱللَّهِ",279],["11:13:12",223,"ٱسْتَطَعْتُم","you can","مُفْتَرَيَـٰتٍۢ وَٱدْعُوا۟ مَنِ","مِّن دُونِ ٱللَّهِ",279],["11:20:20",224,"يَسْتَطِيعُونَ","able","ٱلْعَذَابُ ۚ مَا كَانُوا۟","ٱلسَّمْعَ وَمَا كَانُوا۟",279],["11:88:27",231,"ٱسْتَطَعْتُ ۚ","as much as I am able","إِلَّا ٱلْإِصْلَـٰحَ مَا","وَمَا تَوْفِيقِىٓ إِلَّا",279],["13:15:7",251,"طَوْعًۭا","willingly","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","وَكَرْهًۭا وَظِلَـٰلُهُم بِٱلْغُدُوِّ",1530],["16:73:15",275,"يَسْتَطِيعُونَ","they are able","وَٱلْأَرْضِ شَيْـًۭٔا وَلَا","",279],["17:48:8",286,"يَسْتَطِيعُونَ","they can","ٱلْأَمْثَالَ فَضَلُّوا۟ فَلَا","سَبِيلًۭا",279],["17:64:3",288,"ٱسْتَطَعْتَ","you can","وَٱسْتَفْزِزْ مَنِ","مِنْهُم بِصَوْتِكَ وَأَجْلِبْ",279],["18:28:20",297,"تُطِعْ","obey","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ وَلَا","مَنْ أَغْفَلْنَا قَلْبَهُۥ",163],["18:41:6",298,"تَسْتَطِيعَ","you will be able","مَآؤُهَا غَوْرًۭا فَلَن","لَهُۥ طَلَبًۭا",279],["18:67:4",301,"تَسْتَطِيعَ","will be able","قَالَ إِنَّكَ لَن","مَعِىَ صَبْرًۭا",279],["18:72:6",301,"تَسْتَطِيعَ","will be able","أَقُلْ إِنَّكَ لَن","مَعِىَ صَبْرًۭا",279],["18:75:7",302,"تَسْتَطِيعَ","will be able","لَّكَ إِنَّكَ لَن","مَعِىَ صَبْرًۭا",279],["18:78:10",302,"تَسْتَطِع","you were able","بِتَأْوِيلِ مَا لَمْ","عَّلَيْهِ صَبْرًا",279],["18:82:33",302,"تَسْطِع","you were able","تَأْوِيلُ مَا لَمْ","عَّلَيْهِ صَبْرًۭا",279],["18:97:2",303,"ٱسْطَـٰعُوٓا۟","they were able","فَمَا","أَن يَظْهَرُوهُ وَمَا",279],["18:97:6",303,"ٱسْتَطَـٰعُوا۟","they were able","أَن يَظْهَرُوهُ وَمَا","لَهُۥ نَقْبًۭا",279],["18:101:10",304,"يَسْتَطِيعُونَ","able","ذِكْرِى وَكَانُوا۟ لَا","سَمْعًا",279],["20:90:15",318,"وَأَطِيعُوٓا۟","and obey","رَبَّكُمُ ٱلرَّحْمَـٰنُ فَٱتَّبِعُونِى","أَمْرِى",163],["21:40:6",325,"يَسْتَطِيعُونَ","they will be able","بَغْتَةًۭ فَتَبْهَتُهُمْ فَلَا","رَدَّهَا وَلَا هُمْ",279],["21:43:8",325,"يَسْتَطِيعُونَ","they are able","مِّن دُونِنَا ۚ لَا","نَصْرَ أَنفُسِهِمْ وَلَا",279],["23:34:2",344,"أَطَعْتُم","you obey","وَلَئِنْ","بَشَرًۭا مِّثْلَكُمْ إِنَّكُمْ",163],["24:47:5",356,"وَأَطَعْنَا","and we obey","ءَامَنَّا بِٱللَّهِ وَبِٱلرَّسُولِ","ثُمَّ يَتَوَلَّىٰ فَرِيقٌۭ",163],["24:51:15",356,"وَأَطَعْنَا ۚ","and we obey","أَن يَقُولُوا۟ سَمِعْنَا","وَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ",163],["24:52:2",356,"يُطِعِ","obeys","وَمَن","ٱللَّهَ وَرَسُولَهُۥ وَيَخْشَ",163],["24:53:11",356,"طَاعَةٌۭ","Obedience","قُل لَّا تُقْسِمُوا۟ ۖ","مَّعْرُوفَةٌ ۚ إِنَّ ٱللَّهَ",1797],["24:54:2",357,"أَطِيعُوا۟","Obey","قُلْ","ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ ۖ",163],["24:54:4",357,"وَأَطِيعُوا۟","and obey","قُلْ أَطِيعُوا۟ ٱللَّهَ","ٱلرَّسُولَ ۖ فَإِن تَوَلَّوْا۟",163],["24:54:16",357,"تُطِيعُوهُ","you obey him","مَّا حُمِّلْتُمْ ۖ وَإِن","تَهْتَدُوا۟ ۚ وَمَا عَلَى",163],["24:56:5",357,"وَأَطِيعُوا۟","and obey","ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ","ٱلرَّسُولَ لَعَلَّكُمْ تُرْحَمُونَ",163],["25:9:8",360,"يَسْتَطِيعُونَ","they are able (to find)","ٱلْأَمْثَـٰلَ فَضَلُّوا۟ فَلَا","سَبِيلًۭا",279],["25:19:6",361,"تَسْتَطِيعُونَ","you are able","بِمَا تَقُولُونَ فَمَا","صَرْفًۭا وَلَا نَصْرًۭا ۚ",279],["25:52:2",364,"تُطِعِ","obey","فَلَا","ٱلْكَـٰفِرِينَ وَجَـٰهِدْهُم بِهِۦ",163],["26:108:3",371,"وَأَطِيعُونِ","and obey me","فَٱتَّقُوا۟ ٱللَّهَ","",163],["26:110:3",371,"وَأَطِيعُونِ","and obey me","فَٱتَّقُوا۟ ٱللَّهَ","",163],["26:126:3",372,"وَأَطِيعُونِ","and obey me","فَٱتَّقُوا۟ ٱللَّهَ","",163],["26:131:3",372,"وَأَطِيعُونِ","and obey me","فَٱتَّقُوا۟ ٱللَّهَ","",163],["26:144:3",373,"وَأَطِيعُونِ","and obey me","فَٱتَّقُوا۟ ٱللَّهَ","",163],["26:150:3",373,"وَأَطِيعُونِ","and obey me","فَٱتَّقُوا۟ ٱللَّهَ","",163],["26:151:2",373,"تُطِيعُوٓا۟","obey","وَلَا","أَمْرَ ٱلْمُسْرِفِينَ",163],["26:163:3",374,"وَأَطِيعُونِ","and obey me","فَٱتَّقُوا۟ ٱللَّهَ","",163],["26:179:3",374,"وَأَطِيعُونِ","and obey me","فَٱتَّقُوا۟ ٱللَّهَ","",163],["26:211:5",376,"يَسْتَطِيعُونَ","they are able","يَنۢبَغِى لَهُمْ وَمَا","",279],["29:8:15",397,"تُطِعْهُمَآ ۚ","obey both of them","بِهِۦ عِلْمٌۭ فَلَا","إِلَىَّ مَرْجِعُكُمْ فَأُنَبِّئُكُم",163],["31:15:13",412,"تُطِعْهُمَا ۖ","obey both of them","بِهِۦ عِلْمٌۭ فَلَا","وَصَاحِبْهُمَا فِى ٱلدُّنْيَا",163],["33:1:6",418,"تُطِعِ","obey","ٱتَّقِ ٱللَّهَ وَلَا","ٱلْكَـٰفِرِينَ وَٱلْمُنَـٰفِقِينَ ۗ إِنَّ",163],["33:33:13",422,"وَأَطِعْنَ","and obey","ٱلصَّلَوٰةَ وَءَاتِينَ ٱلزَّكَوٰةَ","ٱللَّهَ وَرَسُولَهُۥٓ ۚ إِنَّمَا",163],["33:48:2",424,"تُطِعِ","obey","وَلَا","ٱلْكَـٰفِرِينَ وَٱلْمُنَـٰفِقِينَ وَدَعْ",163],["33:66:8",427,"أَطَعْنَا","we (had) obeyed","ٱلنَّارِ يَقُولُونَ يَـٰلَيْتَنَآ","ٱللَّهَ وَأَطَعْنَا ٱلرَّسُولَا۠",163],["33:66:10",427,"وَأَطَعْنَا","and obeyed","يَـٰلَيْتَنَآ أَطَعْنَا ٱللَّهَ","ٱلرَّسُولَا۠",163],["33:67:4",427,"أَطَعْنَا","[we] obeyed","وَقَالُوا۟ رَبَّنَآ إِنَّآ","سَادَتَنَا وَكُبَرَآءَنَا فَأَضَلُّونَا",163],["33:71:8",427,"يُطِعِ","obeys","لَكُمْ ذُنُوبَكُمْ ۗ وَمَن","ٱللَّهَ وَرَسُولَهُۥ فَقَدْ",163],["36:50:2",443,"يَسْتَطِيعُونَ","they will be able","فَلَا","تَوْصِيَةًۭ وَلَآ إِلَىٰٓ",279],["36:67:7",444,"ٱسْتَطَـٰعُوا۟","they would have been able","عَلَىٰ مَكَانَتِهِمْ فَمَا","مُضِيًّۭا وَلَا يَرْجِعُونَ",279],["36:75:2",445,"يَسْتَطِيعُونَ","they are able","لَا","نَصْرَهُمْ وَهُمْ لَهُمْ",279],["40:18:15",469,"يُطَاعُ","(who) is obeyed","حَمِيمٍۢ وَلَا شَفِيعٍۢ","",2802],["41:11:11",477,"طَوْعًا","willingly","لَهَا وَلِلْأَرْضِ ٱئْتِيَا","أَوْ كَرْهًۭا قَالَتَآ",1530],["41:11:16",477,"طَآئِعِينَ","willingly","كَرْهًۭا قَالَتَآ أَتَيْنَا","",3286],["43:54:3",493,"فَأَطَاعُوهُ ۚ","and they obeyed him","فَٱسْ