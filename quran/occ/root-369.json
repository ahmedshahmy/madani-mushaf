[["2:50:6",8,"وَأَغْرَقْنَآ","and We drowned","بِكُمُ ٱلْبَحْرَ فَأَنجَيْنَـٰكُمْ","ءَالَ فِرْعَوْنَ وَأَنتُمْ",565],["7:64:7",158,"وَأَغْرَقْنَا","And We drowned","مَعَهُۥ فِى ٱلْفُلْكِ","ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَآ ۚ",565],["7:136:3",166,"فَأَغْرَقْنَـٰهُمْ","and We drowned them","فَٱنتَقَمْنَا مِنْهُمْ","فِى ٱلْيَمِّ بِأَنَّهُمْ",565],["8:54:12",184,"وَأَغْرَقْنَآ","and We drowned","رَبِّهِمْ فَأَهْلَكْنَـٰهُم بِذُنُوبِهِمْ","ءَالَ فِرْعَوْنَ ۚ وَكُلٌّۭ",565],["10:73:9",217,"وَأَغْرَقْنَا","and We drowned","ٱلْفُلْكِ وَجَعَلْنَـٰهُمْ خَلَـٰٓئِفَ","ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا ۖ",565],["10:90:13",219,"ٱلْغَرَقُ","the drowning","حَتَّىٰٓ إِذَآ أَدْرَكَهُ","قَالَ ءَامَنتُ أَنَّهُۥ",3464],["11:37:11",225,"مُّغْرَقُونَ","the ones (to be) drowned","ٱلَّذِينَ ظَلَمُوٓا۟ ۚ إِنَّهُم","",1603],["11:43:23",226,"ٱلْمُغْرَقِينَ","the drowned","ٱلْمَوْجُ فَكَانَ مِنَ","",1603],["17:69:13",289,"فَيُغْرِقَكُم","and drown you","قَاصِفًۭا مِّنَ ٱلرِّيحِ","بِمَا كَفَرْتُمْ ۙ ثُمَّ",565],["17:103:6",292,"فَأَغْرَقْنَـٰهُ","but We drowned him","يَسْتَفِزَّهُم مِّنَ ٱلْأَرْضِ","وَمَن مَّعَهُۥ جَمِيعًۭا",565],["18:71:10",301,"لِتُغْرِقَ","to drown","خَرَقَهَا ۖ قَالَ أَخَرَقْتَهَا","أَهْلَهَا لَقَدْ جِئْتَ",565],["21:77:11",328,"فَأَغْرَقْنَـٰهُمْ","so We drowned them","كَانُوا۟ قَوْمَ سَوْءٍۢ","أَجْمَعِينَ",565],["23:27:32",343,"مُّغْرَقُونَ","(are) the ones to be drowned","ٱلَّذِينَ ظَلَمُوٓا۟ ۖ إِنَّهُم","",1603],["25:37:6",363,"أَغْرَقْنَـٰهُمْ","We drowned them","لَّمَّا كَذَّبُوا۟ ٱلرُّسُلَ","وَجَعَلْنَـٰهُمْ لِلنَّاسِ ءَايَةًۭ ۖ",565],["26:66:2",370,"أَغْرَقْنَا","We drowned","ثُمَّ","ٱلْـَٔاخَرِينَ",565],["26:120:2",372,"أَغْرَقْنَا","We drowned","ثُمَّ","بَعْدُ ٱلْبَاقِينَ",565],["29:40:20",401,"أَغْرَقْنَا ۚ","We drowned","ٱلْأَرْضَ وَمِنْهُم مَّنْ","وَمَا كَانَ ٱللَّهُ",565],["36:43:3",443,"نُغْرِقْهُمْ","We could drown them","وَإِن نَّشَأْ","فَلَا صَرِيخَ لَهُمْ",565],["37:82:2",449,"أَغْرَقْنَا","We drowned","ثُمَّ","ٱلْـَٔاخَرِينَ",565],["43:55:5",493,"فَأَغْرَقْنَـٰهُمْ","and We drowned them","ءَاسَفُونَا ٱنتَقَمْنَا مِنْهُمْ","أَجْمَعِينَ",565],["44:24:6",497,"مُّغْرَقُونَ","(to be) drowned","رَهْوًا ۖ إِنَّهُمْ جُندٌۭ","",1603],["71:25:3",571,"أُغْرِقُوا۟","they were drowned","مِّمَّا خَطِيٓـَٔـٰتِهِمْ","فَأُدْخِلُوا۟ نَارًۭا فَلَمْ",565],["79:1:2",583,"غَرْقًۭا","violently","وَٱلنَّـٰزِعَـٰتِ","",3467]]