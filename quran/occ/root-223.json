[["2:203:25",32,"تُحْشَرُونَ","will be gathered","وَٱعْلَمُوٓا۟ أَنَّكُمْ إِلَيْهِ","",313],["3:12:5",51,"وَتُحْشَرُونَ","and you will be gathered","لِّلَّذِينَ كَفَرُوا۟ سَتُغْلَبُونَ","إِلَىٰ جَهَنَّمَ ۚ وَبِئْسَ",313],["3:158:7",71,"تُحْشَرُونَ","you will be gathered","قُتِلْتُمْ لَإِلَى ٱللَّهِ","",313],["4:172:16",105,"فَسَيَحْشُرُهُمْ","then He will gather them","عَنْ عِبَادَتِهِۦ وَيَسْتَكْبِرْ","إِلَيْهِ جَمِيعًۭا",313],["5:96:20",124,"تُحْشَرُونَ","you will be gathered","ٱللَّهَ ٱلَّذِىٓ إِلَيْهِ","",313],["6:22:2",130,"نَحْشُرُهُمْ","We will gather them","وَيَوْمَ","جَمِيعًۭا ثُمَّ نَقُولُ",313],["6:38:22",132,"يُحْشَرُونَ","they will be gathered","ثُمَّ إِلَىٰ رَبِّهِمْ","",313],["6:51:6",133,"يُحْشَرُوٓا۟","they will be gathered","ٱلَّذِينَ يَخَافُونَ أَن","إِلَىٰ رَبِّهِمْ ۙ لَيْسَ",313],["6:72:8",136,"تُحْشَرُونَ","you will be gathered","وَهُوَ ٱلَّذِىٓ إِلَيْهِ","",313],["6:111:8",142,"وَحَشَرْنَا","and We gathered","ٱلْمَلَـٰٓئِكَةَ وَكَلَّمَهُمُ ٱلْمَوْتَىٰ","عَلَيْهِمْ كُلَّ شَىْءٍۢ",313],["6:128:2",144,"يَحْشُرُهُمْ","He will gather them","وَيَوْمَ","جَمِيعًۭا يَـٰمَعْشَرَ ٱلْجِنِّ",313],["7:111:7",164,"حَـٰشِرِينَ","gatherers","وَأَرْسِلْ فِى ٱلْمَدَآئِنِ","",1775],["8:24:20",179,"تُحْشَرُونَ","you will be gathered","وَقَلْبِهِۦ وَأَنَّهُۥٓ إِلَيْهِ","",313],["8:36:21",181,"يُحْشَرُونَ","they will be gathered","كَفَرُوٓا۟ إِلَىٰ جَهَنَّمَ","",313],["10:28:2",212,"نَحْشُرُهُمْ","We will gather them","وَيَوْمَ","جَمِيعًۭا ثُمَّ نَقُولُ",313],["10:45:2",214,"يَحْشُرُهُمْ","He will gather them","وَيَوْمَ","كَأَن لَّمْ يَلْبَثُوٓا۟",313],["15:25:4",263,"يَحْشُرُهُمْ ۚ","will gather them","وَإِنَّ رَبَّكَ هُوَ","إِنَّهُۥ حَكِيمٌ عَلِيمٌۭ",313],["17:97:14",292,"وَنَحْشُرُهُمْ","And We will gather them","أَوْلِيَآءَ مِن دُونِهِۦ ۖ","يَوْمَ ٱلْقِيَـٰمَةِ عَلَىٰ",313],["18:47:7",299,"وَحَشَرْنَـٰهُمْ","and We will gather them","وَتَرَى ٱلْأَرْضَ بَارِزَةًۭ","فَلَمْ نُغَادِرْ مِنْهُمْ",313],["19:68:2",310,"لَنَحْشُرَنَّهُمْ","surely, We will gather them","فَوَرَبِّكَ","وَٱلشَّيَـٰطِينَ ثُمَّ لَنُحْضِرَنَّهُمْ",313],["19:85:2",311,"نَحْشُرُ","We will gather","يَوْمَ","ٱلْمُتَّقِينَ إِلَى ٱلرَّحْمَـٰنِ",313],["20:59:6",315,"يُحْشَرَ","will be assembled","يَوْمُ ٱلزِّينَةِ وَأَن","ٱلنَّاسُ ضُحًۭى",313],["20:102:5",319,"وَنَحْشُرُ","and We will gather","يُنفَخُ فِى ٱلصُّورِ ۚ","ٱلْمُجْرِمِينَ يَوْمَئِذٍۢ زُرْقًۭا",313],["20:124:9",320,"وَنَحْشُرُهُۥ","and We will gather him","لَهُۥ مَعِيشَةًۭ ضَنكًۭا","يَوْمَ ٱلْقِيَـٰمَةِ أَعْمَىٰ",313],["20:125:4",320,"حَشَرْتَنِىٓ","You raised me","قَالَ رَبِّ لِمَ","أَعْمَىٰ وَقَدْ كُنتُ",313],["23:79:7",347,"تُحْشَرُونَ","you will be gathered","فِى ٱلْأَرْضِ وَإِلَيْهِ","",313],["25:17:2",361,"يَحْشُرُهُمْ","He will gather them","وَيَوْمَ","وَمَا يَعْبُدُونَ مِن",313],["25:34:2",363,"يُحْشَرُونَ","will be gathered","ٱلَّذِينَ","عَلَىٰ وُجُوهِهِمْ إِلَىٰ",313],["26:36:7",368,"حَـٰشِرِينَ","gatherers","وَٱبْعَثْ فِى ٱلْمَدَآئِنِ","",1775],["26:53:5",369,"حَـٰشِرِينَ","gatherers","فِرْعَوْنُ فِى ٱلْمَدَآئِنِ","",1775],["27:17:1",378,"وَحُشِرَ","And were gathered","","لِسُلَيْمَـٰنَ جُنُودُهُۥ مِنَ",313],["27:83:2",384,"نَحْشُرُ","We will gather","وَيَوْمَ","مِن كُلِّ أُمَّةٍۢ",313],["34:40:2",433,"يَحْشُرُهُمْ","He will gather them","وَيَوْمَ","جَمِيعًۭا ثُمَّ يَقُولُ",313],["37:22:1",446,"۞ ٱحْشُرُوا۟","Gather","","ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ",313],["38:19:2",454,"مَحْشُورَةًۭ ۖ","assembled","وَٱلطَّيْرَ","كُلٌّۭ لَّهُۥٓ أَوَّابٌۭ",3637],["41:19:2",478,"يُحْشَرُ","will be gathered","وَيَوْمَ","أَعْدَآءُ ٱللَّهِ إِلَى",313],["46:6:2",503,"حُشِرَ","are gathered","وَإِذَا","ٱلنَّاسُ كَانُوا۟ لَهُمْ",313],["50:44:7",520,"حَشْرٌ","(is) a gathering","عَنْهُمْ سِرَاعًۭا ۚ ذَٰلِكَ","عَلَيْنَا يَسِيرٌۭ",2263],["58:9:19",543,"تُحْشَرُونَ","you will be gathered","ٱللَّهَ ٱلَّذِىٓ إِلَيْهِ","",313],["59:2:12",545,"ٱلْحَشْرِ ۚ","gathering","مِن دِيَـٰرِهِمْ لِأَوَّلِ","مَا ظَنَنتُمْ أَن",2263],["67:24:8",563,"تُحْشَرُونَ","you will be gathered","فِى ٱلْأَرْضِ وَإِلَيْهِ","",313],["79:23:1",584,"فَحَشَرَ","And he gathered","","فَنَادَىٰ",313],["81:5:3",586,"حُشِرَتْ","are gathered","وَإِذَا ٱلْوُحُوشُ","",313]]