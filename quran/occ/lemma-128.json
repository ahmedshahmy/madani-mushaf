[["2:11:10",3,"نَحْنُ","we","ٱلْأَرْضِ قَالُوٓا۟ إِنَّمَا","مُصْلِحُونَ",128],["2:14:15",3,"نَحْنُ","we","إِنَّا مَعَكُمْ إِنَّمَا","مُسْتَهْزِءُونَ",128],["2:30:18",6,"وَنَحْنُ","while we","فِيهَا وَيَسْفِكُ ٱلدِّمَآءَ","نُسَبِّحُ بِحَمْدِكَ وَنُقَدِّسُ",128],["2:102:31",16,"نَحْنُ","we","حَتَّىٰ يَقُولَآ إِنَّمَا","فِتْنَةٌۭ فَلَا تَكْفُرْ ۖ",128],["2:133:25",20,"وَنَحْنُ","And we","وَإِسْحَـٰقَ إِلَـٰهًۭا وَٰحِدًۭا","لَهُۥ مُسْلِمُونَ",128],["2:136:29",21,"وَنَحْنُ","And we","بَيْنَ أَحَدٍۢ مِّنْهُمْ","لَهُۥ مُسْلِمُونَ",128],["2:138:8",21,"وَنَحْنُ","And we","مِنَ ٱللَّهِ صِبْغَةًۭ ۖ","لَهُۥ عَـٰبِدُونَ",128],["2:139:12",21,"وَنَحْنُ","and we","أَعْمَـٰلُنَا وَلَكُمْ أَعْمَـٰلُكُمْ","لَهُۥ مُخْلِصُونَ",128],["2:247:17",40,"وَنَحْنُ","while we","لَهُ ٱلْمُلْكُ عَلَيْنَا","أَحَقُّ بِٱلْمُلْكِ مِنْهُ",128],["3:52:13",56,"نَحْنُ","We","ٱللَّهِ ۖ قَالَ ٱلْحَوَارِيُّونَ","أَنصَارُ ٱللَّهِ ءَامَنَّا",128],["3:84:27",61,"وَنَحْنُ","and we","بَيْنَ أَحَدٍۢ مِّنْهُمْ","لَهُۥ مُسْلِمُونَ",128],["3:181:10",74,"وَنَحْنُ","while we","إِنَّ ٱللَّهَ فَقِيرٌۭ","أَغْنِيَآءُ ۘ سَنَكْتُبُ مَا",128],["5:18:4",111,"نَحْنُ","We (are)","وَقَالَتِ ٱلْيَهُودُ وَٱلنَّصَـٰرَىٰ","أَبْنَـٰٓؤُا۟ ٱللَّهِ وَأَحِبَّـٰٓؤُهُۥ ۚ",128],["6:29:8",131,"نَحْنُ","we","حَيَاتُنَا ٱلدُّنْيَا وَمَا","بِمَبْعُوثِينَ",128],["6:151:19",148,"نَّحْنُ","We","أَوْلَـٰدَكُم مِّنْ إِمْلَـٰقٍۢ ۖ","نَرْزُقُكُمْ وَإِيَّاهُمْ ۖ وَلَا",128],["7:113:10",164,"نَحْنُ","[we]","لَأَجْرًا إِن كُنَّا","ٱلْغَـٰلِبِينَ",128],["7:115:9",164,"نَحْنُ","[we]","وَإِمَّآ أَن نَّكُونَ","ٱلْمُلْقِينَ",128],["7:132:10",166,"نَحْنُ","we","لِّتَسْحَرَنَا بِهَا فَمَا","لَكَ بِمُؤْمِنِينَ",128],["9:52:8",195,"وَنَحْنُ","while we","إِلَّآ إِحْدَى ٱلْحُسْنَيَيْنِ ۖ","نَتَرَبَّصُ بِكُمْ أَن",128],["9:101:14",203,"نَحْنُ","We","ٱلنِّفَاقِ لَا تَعْلَمُهُمْ ۖ","نَعْلَمُهُمْ ۚ سَنُعَذِّبُهُم مَّرَّتَيْنِ",128],["10:78:14",217,"نَحْنُ","And we (are) not","فِى ٱلْأَرْضِ وَمَا","لَكُمَا بِمُؤْمِنِينَ",128],["11:53:7",227,"نَحْنُ","we","جِئْتَنَا 