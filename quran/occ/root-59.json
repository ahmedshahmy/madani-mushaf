[["2:54:14",8,"فَٱقْتُلُوٓا۟","and kill","فَتُوبُوٓا۟ إِلَىٰ بَارِئِكُمْ","أَنفُسَكُمْ ذَٰلِكُمْ خَيْرٌۭ",135],["2:61:51",9,"وَيَقْتُلُونَ","and kill","يَكْفُرُونَ بِـَٔايَـٰتِ ٱللَّهِ","ٱلنَّبِيِّـۧنَ بِغَيْرِ ٱلْحَقِّ ۗ",135],["2:72:2",11,"قَتَلْتُمْ","you killed","وَإِذْ","نَفْسًۭا فَٱدَّٰرَْٰٔتُمْ فِيهَا ۖ",135],["2:85:4",13,"تَقْتُلُونَ","(who) kill","ثُمَّ أَنتُمْ هَـٰٓؤُلَآءِ","أَنفُسَكُمْ وَتُخْرِجُونَ فَرِيقًۭا",135],["2:87:28",13,"تَقْتُلُونَ","you kill(ed)","فَفَرِيقًۭا كَذَّبْتُمْ وَفَرِيقًۭا","",135],["2:91:23",14,"تَقْتُلُونَ","(did) you kill","مَعَهُمْ ۗ قُلْ فَلِمَ","أَنۢبِيَآءَ ٱللَّهِ مِن",135],["2:154:4",24,"يُقْتَلُ","are slain","وَلَا تَقُولُوا۟ لِمَن","فِى سَبِيلِ ٱللَّهِ",135],["2:178:8",27,"ٱلْقَتْلَى ۖ","(the matter of) the murdered","عَلَيْكُمُ ٱلْقِصَاصُ فِى","ٱلْحُرُّ بِٱلْحُرِّ وَٱلْعَبْدُ",4131],["2:190:1",29,"وَقَـٰتِلُوا۟","And fight","","فِى سَبِيلِ ٱللَّهِ",222],["2:190:6",29,"يُقَـٰتِلُونَكُمْ","fight you","سَبِيلِ ٱللَّهِ ٱلَّذِينَ","وَلَا تَعْتَدُوٓا۟ ۚ إِنَّ",222],["2:191:1",30,"وَٱقْتُلُوهُمْ","And kill them","","حَيْثُ ثَقِفْتُمُوهُمْ وَأَخْرِجُوهُم",135],["2:191:11",30,"ٱلْقَتْلِ ۚ","[the] killing","وَٱلْفِتْنَةُ أَشَدُّ مِنَ","وَلَا تُقَـٰتِلُوهُمْ عِندَ",855],["2:191:13",30,"تُقَـٰتِلُوهُمْ","fight them","مِنَ ٱلْقَتْلِ ۚ وَلَا","عِندَ ٱلْمَسْجِدِ ٱلْحَرَامِ",222],["2:191:18",30,"يُقَـٰتِلُوكُمْ","they fight you","ٱلْمَسْجِدِ ٱلْحَرَامِ حَتَّىٰ","فِيهِ ۖ فَإِن قَـٰتَلُوكُمْ",222],["2:191:21",30,"قَـٰتَلُوكُمْ","they fight you","يُقَـٰتِلُوكُمْ فِيهِ ۖ فَإِن","فَٱقْتُلُوهُمْ ۗ كَذَٰلِكَ جَزَآءُ",222],["2:191:22",30,"فَٱقْتُلُوهُمْ ۗ","then kill them","فِيهِ ۖ فَإِن قَـٰتَلُوكُمْ","كَذَٰلِكَ جَزَآءُ ٱلْكَـٰفِرِينَ",135],["2:193:1",30,"وَقَـٰتِلُوهُمْ","And fight (against) them","","حَتَّىٰ لَا تَكُونَ",222],["2:216:3",34,"ٱلْقِتَالُ","[the] fighting","كُتِبَ عَلَيْكُمُ","وَهُوَ كُرْهٌۭ لَّكُمْ ۖ",695],["2:217:5",34,"قِتَالٍۢ","(concerning) fighting","عَنِ ٱلشَّهْرِ ٱلْحَرَامِ","فِيهِ ۖ قُلْ قِتَالٌۭ",695],["2:217:8",34,"قِتَالٌۭ","Fighting","قِتَالٍۢ فِيهِ ۖ قُلْ","فِيهِ كَبِيرٌۭ ۖ وَصَدٌّ",695],["2:217:28",34,"ٱلْقَتْلِ ۗ","[the] killing","وَٱلْفِتْنَةُ أَكْبَرُ مِنَ","وَلَا يَزَالُونَ يُقَـٰتِلُونَكُمْ",855],["2:217:31",34,"يُقَـٰتِلُونَكُمْ","(to) fight with you","ٱلْقَتْلِ ۗ وَلَا يَزَالُونَ","حَتَّىٰ يَرُدُّوكُمْ عَن",222],["2:244:1",39,"وَقَـٰتِلُوا۟","And fight","","فِى سَبِيلِ ٱللَّهِ",222],["2:246:18",40,"نُّقَـٰتِلْ","we may fight","ٱبْعَثْ لَنَا مَلِكًۭا","فِى سَبِيلِ ٱللَّهِ ۖ",222],["2:246:28",40,"ٱلْقِتَالُ","[the] fighting","إِن كُتِبَ عَلَيْكُمُ","أَلَّا تُقَـٰتِلُوا۟ ۖ قَالُوا۟",695],["2:246:30",40,"تُقَـٰتِلُوا۟ ۖ","you fight","عَلَيْكُمُ ٱلْقِتَالُ أَلَّا","قَالُوا۟ وَمَا لَنَآ",222],["2:246:35",40,"نُقَـٰتِلَ","we fight","وَمَا لَنَآ أَلَّا","فِى سَبِيلِ ٱللَّهِ",222],["2:246:47",40,"ٱلْقِتَالُ","the fighting","فَلَمَّا كُتِبَ عَلَيْهِمُ","تَوَلَّوْا۟ إِلَّا قَلِيلًۭا",695],["2:251:4",41,"وَقَتَلَ","and killed","فَهَزَمُوهُم بِإِذْنِ ٱللَّهِ","دَاوُۥدُ جَالُوتَ وَءَاتَىٰهُ",135],["2:253:26",42,"ٱقْتَتَلَ","(would have) fought each other","شَآءَ ٱللَّهُ مَا","ٱلَّذِينَ مِنۢ بَعْدِهِم",1695],["2:253:47",42,"ٱقْتَتَلُوا۟","they (would have) fought each other","شَآءَ ٱللَّهُ مَا","وَلَـٰكِنَّ ٱللَّهَ يَفْعَلُ",1695],["3:13:9",51,"تُقَـٰتِلُ","fighting","فِئَتَيْنِ ٱلْتَقَتَا ۖ فِئَةٌۭ","فِى سَبِيلِ ٱللَّهِ",222],["3:21:6",52,"وَيَقْتُلُونَ","and they kill","يَكْفُرُونَ بِـَٔايَـٰتِ ٱللَّهِ","ٱلنَّبِيِّـۧنَ بِغَيْرِ حَقٍّۢ",135],["3:21:10",52,"وَيَقْتُلُونَ","and they kill","ٱلنَّبِيِّـۧنَ بِغَيْرِ حَقٍّۢ","ٱلَّذِينَ يَأْمُرُونَ بِٱلْقِسْطِ",135],["3:111:6",64,"يُقَـٰتِلُوكُمْ","they fight you","إِلَّآ أَذًۭى ۖ وَإِن","يُوَلُّوكُمُ ٱلْأَدْبَارَ ثُمَّ",222],["3:112:27",64,"وَيَقْتُلُونَ","and they killed","يَكْفُرُونَ بِـَٔايَـٰتِ ٱللَّهِ","ٱلْأَنۢبِيَآءَ بِغَيْرِ حَقٍّۢ ۚ",135],["3:121:8",65,"لِلْقِتَالِ ۗ","for the battle","تُبَوِّئُ ٱلْمُؤْمِنِينَ مَقَـٰعِدَ","وَٱللَّهُ سَمِيعٌ عَلِيمٌ",695],["3:144:13",68,"قُتِلَ","is slain","أَفَإِي۟ن مَّاتَ أَوْ","ٱنقَلَبْتُمْ عَلَىٰٓ أَعْقَـٰبِكُمْ ۚ",135],["3:146:4",68,"قَـٰتَلَ","fought","وَكَأَيِّن مِّن نَّبِىٍّۢ","مَعَهُۥ رِبِّيُّونَ كَثِيرٌۭ",222],["3:154:49",70,"قُتِلْنَا","we would have been killed","ٱلْأَمْرِ شَىْءٌۭ مَّا","هَـٰهُنَا ۗ قُل لَّوْ",135],["3:154:60",70,"ٱلْقَتْلُ","[the] death","ٱلَّذِينَ كُتِبَ عَلَيْهِمُ","إِلَىٰ مَضَاجِعِهِمْ ۖ وَلِيَبْتَلِىَ",855],["3:156:23",70,"قُتِلُوا۟","they (would have) been killed","مَا مَاتُوا۟ وَمَا","لِيَجْعَلَ ٱللَّهُ ذَٰلِكَ",135],["3:157:2",70,"قُتِلْتُمْ","you are killed","وَلَئِن","فِى سَبِيلِ ٱللَّهِ",135],["3:158:4",71,"قُتِلْتُمْ","are killed","وَلَئِن مُّتُّمْ أَوْ","لَإِلَى ٱللَّهِ تُحْشَرُونَ",135],["3:167:7",72,"قَـٰتِلُوا۟","fight","وَقِيلَ لَهُمْ تَعَالَوْا۟","فِى سَبِيلِ ٱللَّهِ",222],["3:167:16",72,"قِتَالًۭا","fighting","قَالُوا۟ لَوْ نَعْلَمُ","لَّٱتَّبَعْنَـٰكُمْ ۗ هُمْ لِلْكُفْرِ",695],["3:168:8",72,"قُتِلُوا۟ ۗ","they would have been killed","لَوْ أَطَاعُونَا مَا","قُلْ فَٱدْرَءُوا۟ عَنْ",135],["3:169:4",72,"قُتِلُوا۟","are killed","وَلَا تَحْسَبَنَّ ٱلَّذِينَ","فِى سَبِيلِ ٱللَّهِ",135],["3:181:15",74,"وَقَتْلَهُمُ","and their killing","سَنَكْتُبُ مَا قَالُوا۟","ٱلْأَنۢبِيَآءَ بِغَيْرِ حَقٍّۢ",855],["3:183:25",74,"قَتَلْتُمُوهُمْ","you killed them","وَبِٱلَّذِى قُلْتُمْ فَلِمَ","إِن كُنتُمْ صَـٰدِقِينَ",135],["3:195:25",76,"وَقَـٰتَلُوا۟","and fought","وَأُوذُوا۟ فِى سَبِيلِى","وَقُتِلُوا۟ لَأُكَفِّرَنَّ عَنْهُمْ",222],["3:195:26",76,"وَقُتِلُوا۟","and were killed","فِى سَبِيلِى وَقَـٰتَلُوا۟","لَأُكَفِّرَنَّ عَنْهُمْ سَيِّـَٔاتِهِمْ",135],["4:29:17",83,"تَقْتُلُوٓا۟","kill","تَرَاضٍۢ مِّنكُمْ ۚ وَلَا","أَنفُسَكُمْ ۚ إِنَّ ٱللَّهَ",135],["4:66:6",89,"ٱقْتُلُوٓا۟","Kill","كَتَبْنَا عَلَيْهِمْ أَنِ","أَنفُسَكُمْ أَوِ ٱخْرُجُوا۟",135],["4:74:1",89,"۞ فَلْيُقَـٰتِلْ","So let fight","","فِى سَبِيلِ ٱللَّهِ",222],["4:74:11",89,"يُقَـٰتِلْ","fights","ٱلدُّنْيَا بِٱلْـَٔاخِرَةِ ۚ وَمَن","فِى سَبِيلِ ٱللَّهِ",222],["4:74:15",89,"فَيُقْتَلْ","then he is killed","فِى سَبِيلِ ٱللَّهِ","أَوْ يَغْلِبْ فَسَوْفَ",135],["4:75:4",90,"تُقَـٰتِلُونَ","you fight","وَمَا لَكُمْ لَا","فِى سَبِيلِ ٱللَّهِ",222],["4:76:3",90,"يُقَـٰتِلُونَ","they fight","ٱلَّذِينَ ءَامَنُوا۟","فِى سَبِيلِ ٱللَّهِ ۖ",222],["4:76:9",90,"يُقَـٰتِلُونَ","they fight","ٱللَّهِ ۖ وَٱلَّذِينَ كَفَرُوا۟","فِى سَبِيلِ ٱلطَّـٰغُوتِ",222],["4:76:13",90,"فَقَـٰتِلُوٓا۟","So fight (against)","فِى سَبِيلِ ٱلطَّـٰغُوتِ","أَوْلِيَآءَ ٱلشَّيْطَـٰنِ ۖ إِنَّ",222],["4:77:16",90,"ٱلْقِتَالُ","the fighting","فَلَمَّا كُتِبَ عَلَيْهِمُ","إِذَا فَرِيقٌۭ مِّنْهُمْ",695],["4:77:32",90,"ٱلْقِتَالَ","[the] fighting","لِمَ كَتَبْتَ عَلَيْنَا","لَوْلَآ أَخَّرْتَنَآ إِلَىٰٓ",695],["4:84:1",91,"فَقَـٰتِلْ","So fight","","فِى سَبِيلِ ٱللَّهِ",222],["4:89:20",92,"وَٱقْتُلُوهُمْ","and kill them","فَإِن تَوَلَّوْا۟ فَخُذُوهُمْ","حَيْثُ وَجَدتُّمُوهُمْ ۖ وَلَا",135],["4:90:14",92,"يُقَـٰتِلُوكُمْ","they fight you","حَصِرَتْ صُدُورُهُمْ أَن","أَوْ يُقَـٰتِلُوا۟ قَوْمَهُمْ ۚ",222],["4:90:16",92,"يُقَـٰتِلُوا۟","they fight","أَن يُقَـٰتِلُوكُمْ أَوْ","قَوْمَهُمْ ۚ وَلَوْ شَآءَ",222],["4:90:23",92,"فَلَقَـٰتَلُوكُمْ ۚ","and surely they (would have) fought you","ٱللَّهُ لَسَلَّطَهُمْ عَلَيْكُمْ","فَإِنِ ٱعْتَزَلُوكُمْ فَلَمْ",222],["4:90:27",92,"يُقَـٰتِلُوكُمْ","fight against you","فَإِنِ ٱعْتَزَلُوكُمْ فَلَمْ","وَأَلْقَوْا۟ إِلَيْكُمُ ٱلسَّلَمَ",222],["4:91:24",92,"وَٱقْتُلُوهُمْ","and kill them","وَيَكُفُّوٓا۟ أَيْدِيَهُمْ فَخُذُوهُمْ","حَيْثُ ثَقِفْتُمُوهُمْ ۚ وَأُو۟لَـٰٓئِكُمْ",135],["4:92:5",93,"يَقْتُلَ","he kills","كَانَ لِمُؤْمِنٍ أَن","مُؤْمِنًا إِلَّا خَطَـًۭٔا ۚ",135],["4:92:10",93,"قَتَلَ","killed","إِلَّا خَطَـًۭٔا ۚ وَمَن","مُؤْمِنًا خَطَـًۭٔا فَتَحْرِيرُ",135],["4:93:2",93,"يَقْتُلْ","kills","وَمَن","مُؤْمِنًۭا مُّتَعَمِّدًۭا فَجَزَآؤُهُۥ",135],["4:155:7",103,"وَقَتْلِهِمُ","and their killing","وَكُفْرِهِم بِـَٔايَـٰتِ ٱللَّهِ","ٱلْأَنۢبِيَآءَ بِغَيْرِ حَقٍّۢ",855],["4:157:3",103,"قَتَلْنَا","killed","وَقَوْلِهِمْ إِنَّا","ٱلْمَسِيحَ عِيسَى ٱبْنَ",135],["4:157:11",103,"قَتَلُوهُ","they killed him","رَسُولَ ٱللَّهِ وَمَا","وَمَا صَلَبُوهُ وَلَـٰكِن",135],["4:157:33",103,"قَتَلُوهُ","they killed him","ٱتِّبَاعَ ٱلظَّنِّ ۚ وَمَا","يَقِينًۢا",135],["5:24:13",112,"فَقَـٰتِلَآ","and you both fight","فَٱذْهَبْ أَنتَ وَرَبُّكَ","إِنَّا هَـٰهُنَا قَـٰعِدُونَ",222],["5:27:18",112,"لَأَقْتُلَنَّكَ ۖ","Surely I will kill you","مِنَ ٱلْـَٔاخَرِ قَالَ","قَالَ إِنَّمَا يَتَقَبَّلُ",135],["5:28:5",112,"لِتَقْتُلَنِى","to kill me","بَسَطتَ إِلَىَّ يَدَكَ","مَآ أَنَا۠ بِبَاسِطٍۢ",135],["5:28:11",112,"لِأَقْتُلَكَ ۖ","to kill you","بِبَاسِطٍۢ يَدِىَ إِلَيْكَ","إِنِّىٓ أَخَافُ ٱللَّهَ",135],["5:30:4",112,"قَتْلَ","(to) kill","فَطَوَّعَتْ لَهُۥ نَفْسُهُۥ","أَخِيهِ فَقَتَلَهُۥ فَأَصْبَحَ",855],["5:30:6",112,"فَقَتَلَهُۥ","so he killed him","نَفْسُهُۥ قَتْلَ أَخِيهِ","فَأَصْبَحَ مِنَ ٱلْخَـٰسِرِينَ",135],["5:32:10",113,"قَتَلَ","kills","إِسْرَٰٓءِيلَ أَنَّهُۥ مَن","نَفْسًۢا بِغَيْرِ نَفْسٍ",135],["5:32:19",113,"قَتَلَ","he has killed","فِى ٱلْأَرْضِ فَكَأَنَّمَا","ٱلنَّاسَ جَمِيعًۭا وَمَنْ",135],["5:33:12",113,"يُقَتَّلُوٓا۟","they be killed","ٱلْأَرْضِ فَسَادًا أَن","أَوْ يُصَلَّبُوٓا۟ أَوْ",1627],["5:70:19",119,"يَقْتُلُونَ","they kill","فَرِيقًۭا كَذَّبُوا۟ وَفَرِيقًۭا","",135],["5:95:5",123,"تَقْتُلُوا۟","kill","ٱلَّذِينَ ءَامَنُوا۟ لَا","ٱلصَّيْدَ وَأَنتُمْ حُرُمٌۭ ۚ",135],["5:95:10",123,"قَتَلَهُۥ","killed it","وَأَنتُمْ حُرُمٌۭ ۚ وَمَن","مِنكُم مُّتَعَمِّدًۭا فَجَزَآءٌۭ",135],["5:95:16",123,"قَتَلَ","he killed","فَجَزَآءٌۭ مِّثْلُ مَا","مِنَ ٱلنَّعَمِ يَحْكُمُ",135],["6:137:6",145,"قَتْلَ","(the) killing","لِكَثِيرٍۢ مِّنَ ٱلْمُشْرِكِينَ","أَوْلَـٰدِهِمْ شُرَكَآؤُهُمْ لِيُرْدُوهُمْ",855],["6:140:4",146,"قَتَلُوٓا۟","killed","قَدْ خَسِرَ ٱلَّذِينَ","أَوْلَـٰدَهُمْ سَفَهًۢا بِغَيْرِ",135],["6:151:15",148,"تَقْتُلُوٓا۟","kill","وَبِٱلْوَٰلِدَيْنِ إِحْسَـٰنًۭا ۖ وَلَا","أَوْلَـٰدَكُم مِّنْ إِمْلَـٰقٍۢ ۖ",135],["6:151:31",148,"تَقْتُلُوا۟","kill","وَمَا بَطَنَ ۖ وَلَا","ٱلنَّفْسَ ٱلَّتِى حَرَّمَ",135],["7:127:15",165,"سَنُقَتِّلُ","We will kill","وَيَذَرَكَ وَءَالِهَتَكَ ۚ قَالَ","أَبْنَآءَهُمْ وَنَسْتَحْىِۦ نِسَآءَهُمْ",1627],["7:141:9",167,"يُقَتِّلُونَ","they were killing","يَسُومُونَكُمْ سُوٓءَ ٱلْعَذَابِ ۖ","أَبْنَآءَكُمْ وَيَسْتَحْيُونَ نِسَآءَكُمْ ۚ",1627],["7:150:30",169,"يَقْتُلُونَنِى","kill me","ٱلْقَوْمَ ٱسْتَضْعَفُونِى وَكَادُوا۟","فَلَا تُشْمِتْ بِىَ",135],["8:16:7",178,"لِّقِتَالٍ","of war","دُبُرَهُۥٓ إِلَّا مُتَحَرِّفًۭا","أَوْ مُتَحَيِّزًا إِلَىٰ",695],["8:17:2",179,"تَقْتُلُوهُمْ","you kill them","فَلَمْ","وَلَـٰكِنَّ ٱللَّهَ قَتَلَهُمْ ۚ",135],["8:17:5",179,"قَتَلَهُمْ ۚ","killed them","تَقْتُلُوهُمْ وَلَـٰكِنَّ ٱللَّهَ","وَمَا رَمَيْتَ إِذْ",135],["8:30:8",180,"يَقْتُلُوكَ","kill you","كَفَرُوا۟ لِيُثْبِتُوكَ أَوْ","أَوْ يُخْرِجُوكَ ۚ وَيَمْكُرُونَ",135],["8:39:1",181,"وَقَـٰتِلُوهُمْ","And fight them","","حَتَّىٰ لَا تَكُونَ",222],["8:65:6",185,"ٱلْقِتَالِ ۚ","[the] fight","حَرِّضِ ٱلْمُؤْمِنِينَ عَلَى","إِن يَكُن مِّنكُمْ",695],["9:5:5",187,"فَٱقْتُلُوا۟","then kill","ٱنسَلَخَ ٱلْأَشْهُرُ ٱلْحُرُمُ","ٱلْمُشْرِكِينَ حَيْثُ وَجَدتُّمُوهُمْ",135],["9:12:10",188,"فَقَـٰتِلُوٓا۟","then fight","وَطَعَنُوا۟ فِى دِينِكُمْ","أَئِمَّةَ ٱلْكُفْرِ ۙ إِنَّهُمْ",222],["9:13:2",188,"تُقَـٰتِلُونَ","you fight","أَلَا","قَوْمًۭا نَّكَثُوٓا۟ أَيْمَـٰنَهُمْ",222],["9:14:1",189,"قَـٰتِلُوهُمْ","Fight them","","يُعَذِّبْهُمُ ٱللَّهُ بِأَيْدِيكُمْ",222],["9:29:1",191,"قَـٰتِلُوا۟","Fight","","ٱلَّذِينَ لَا يُؤْمِنُونَ",222],["9:30:20",191,"قَـٰتَلَهُمُ","(May) Allah destroy them","كَفَرُوا۟ مِن قَبْلُ ۚ","ٱللَّهُ ۚ أَنَّىٰ يُؤْفَكُونَ",222],["9:36:26",192,"وَقَـٰتِلُوا۟","And fight","تَظْلِمُوا۟ فِيهِنَّ أَنفُسَكُمْ ۚ","ٱلْمُشْرِكِينَ كَآفَّةًۭ كَمَا",222],["9:36:30",192,"يُقَـٰتِلُونَكُمْ","they fight you","ٱلْمُشْرِكِينَ كَآفَّةًۭ كَمَا","كَآفَّةًۭ ۚ وَٱعْلَمُوٓا۟ أَنَّ",222],["9:83:15",200,"تُقَـٰتِلُوا۟","will you fight","مَعِىَ أَبَدًۭا وَلَن","مَعِىَ عَدُوًّا ۖ إِنَّكُمْ",222],["9:111:11",204,"يُقَـٰتِلُونَ","They fight","بِأَنَّ لَهُمُ ٱلْجَنَّةَ ۚ","فِى سَبِيلِ ٱللَّهِ",222],["9:111:15",204,"فَيَقْتُلُونَ","they slay","فِى سَبِيلِ ٱللَّهِ","وَيُقْتَلُونَ ۖ وَعْدًا عَلَيْهِ",135],["9:111:16",204,"وَيُقْتَلُونَ ۖ","and they are slain","سَبِيلِ ٱللَّهِ فَيَقْتُلُونَ","وَعْدًا عَلَيْهِ حَقًّۭا",135],["9:123:4",207,"قَـٰتِلُوا۟","Fight","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","ٱلَّذِينَ يَلُونَكُم مِّنَ",222],["12:9:1",236,"ٱقْتُلُوا۟","Kill","","يُوسُفَ أَوِ ٱطْرَحُوهُ",135],["12:10:5",236,"تَقْتُلُوا۟","kill","قَآئِلٌۭ مِّنْهُمْ لَا","يُوسُفَ وَأَلْقُوهُ فِى",135],["17:31:2",285,"تَقْتُلُوٓا۟","kill","وَلَا","أَوْلَـٰدَكُمْ خَشْيَةَ إِمْلَـٰقٍۢ ۖ",135],["17:31:10",285,"قَتْلَهُمْ","their killing","نَرْزُقُهُمْ وَإِيَّاكُمْ ۚ إِنَّ","كَانَ خِطْـًۭٔا كَبِيرًۭا",855],["17:33:2",285,"تَقْتُلُوا۟","kill","وَلَا","ٱلنَّفْسَ ٱلَّتِى حَرَّمَ",135],["17:33:10",285,"قُتِلَ","(is) killed","إِلَّا بِٱلْحَقِّ ۗ وَمَن","مَظْلُومًۭا فَقَدْ جَعَلْنَا",135],["17:33:19",285,"ٱلْقَتْلِ ۖ","the killing","فَلَا يُسْرِف فِّى","إِنَّهُۥ كَانَ مَنصُورًۭا",855],["18:74:6",301,"فَقَتَلَهُۥ","then he killed him","إِذَا لَقِيَا غُلَـٰمًۭا","قَالَ أَقَتَلْتَ نَفْسًۭا",135],["18:74:8",301,"أَقَتَلْتَ","Have you killed","غُلَـٰمًۭا فَقَتَلَهُۥ قَالَ","نَفْسًۭا زَكِيَّةًۢ بِغَيْرِ",135],["20:40:18",314,"وَقَتَلْتَ","And you killed","عَيْنُهَا وَلَا تَحْزَنَ ۚ","نَفْسًۭا فَنَجَّيْنَـٰكَ مِنَ",135],["22:39:3",337,"يُقَـٰتَلُونَ","are being fought","أُذِنَ لِلَّذِينَ","بِأَنَّهُمْ ظُلِمُوا۟ ۚ وَإِنَّ",222],["22:58:7",339,"قُتِلُوٓا۟","were killed","سَبِيلِ ٱللَّهِ ثُمَّ","أَوْ مَاتُوا۟ لَيَرْزُقَنَّهُمُ",135],["25:68:9",366,"يَقْتُلُونَ","[they] kill","إِلَـٰهًا ءَاخَرَ وَلَا","ٱلنَّفْسَ ٱلَّتِى حَرَّمَ",135],["26:14:6",367,"يَقْتُلُونِ","they will kill me","ذَنۢبٌۭ فَأَخَافُ أَن","",135],["28:9:9",386,"تَقْتُلُوهُ","kill him","لِّى وَلَكَ ۖ لَا","عَسَىٰٓ أَن يَنفَعَنَآ",135],["28:15:11",387,"يَقْتَتِلَانِ","fighting each other","فَوَجَدَ فِيهَا رَجُلَيْنِ","هَـٰذَا مِن شِيعَتِهِۦ",1695],["28:19:14",387,"تَقْتُلَنِى","kill me","يَـٰمُوسَىٰٓ أَتُرِيدُ أَن","كَمَا قَتَلْتَ نَفْسًۢا",135],["28:19:16",387,"قَتَلْتَ","you killed","أَن تَقْتُلَنِى كَمَا","نَفْسًۢا بِٱلْأَمْسِ ۖ إِن",135],["28:20:13",387,"لِيَقْتُلُوكَ","to kill you","ٱلْمَلَأَ يَأْتَمِرُونَ بِكَ","فَٱخْرُجْ إِنِّى لَكَ",135],["28:33:4",389,"قَتَلْتُ","I killed","قَالَ رَبِّ إِنِّى","مِنْهُمْ نَفْسًۭا فَأَخَافُ",135],["28:33:9",389,"يَقْتُلُونِ","they will kill me","نَفْسًۭا فَأَخَافُ أَن","",135],["29:24:8",399,"ٱقْتُلُوهُ","Kill him","إِلَّآ أَن قَالُوا۟","أَوْ حَرِّقُوهُ فَأَنجَىٰهُ",135],["33:16:10",420,"ٱلْقَتْلِ","killing","مِّنَ ٱلْمَوْتِ أَوِ","وَإِذًۭا لَّا تُمَتَّعُونَ",855],["33:20:21",420,"قَـٰتَلُوٓا۟","they would fight","كَانُوا۟ فِيكُم مَّا","إِلَّا قَلِيلًۭا",222],["33:25:12",421,"ٱلْقِتَالَ ۚ","(in) the battle","وَكَفَى ٱللَّهُ ٱلْمُؤْمِنِينَ","وَكَانَ ٱللَّهُ قَوِيًّا",695],["33:26:14",421,"تَقْتُلُونَ","you killed","قُلُوبِهِمُ ٱلرُّعْبَ فَرِيقًۭا","وَتَأْسِرُونَ فَرِيقًۭا",135],["33:61:5",426,"وَقُتِّلُوا۟","and massacred completely","أَيْنَمَا ثُقِفُوٓا۟ أُخِذُوا۟","تَقْتِيلًۭا",1627],["33:61:6",426,"تَقْتِيلًۭا","and massacred completely","ثُقِفُوٓا۟ أُخِذُوا۟ وَقُتِّلُوا۟","",4408],["40:25:7",469,"ٱقْتُلُوٓا۟","Kill","مِنْ عِندِنَا قَالُوا۟","أَبْنَآءَ ٱلَّذِينَ ءَامَنُوا۟",135],["40:26:4",470,"أَقْتُلْ","(so that) I kill","وَقَالَ فِرْعَوْنُ ذَرُونِىٓ","مُوسَىٰ وَلْيَدْعُ رَبَّهُۥٓ ۖ",135],["40:28:9",470,"أَتَقْتُلُونَ","Will you kill","فِرْعَوْنَ يَكْتُمُ إِيمَـٰنَهُۥٓ","رَجُلًا أَن يَقُولَ",135],["47:4:32",507,"قُتِلُوا۟","are killed","بَعْضَكُم بِبَعْضٍۢ ۗ وَٱلَّذِينَ","فِى سَبِيلِ ٱللَّهِ",135],["47:20:13",509,"ٱلْقِتَالُ ۙ","the fighting","مُّحْكَمَةٌۭ وَذُكِرَ فِيهَا","رَأَيْتَ ٱلَّذِينَ فِى",695],["48:16:11",513,"تُقَـٰتِلُونَهُمْ","you will fight them","أُو۟لِى بَأْسٍۢ شَدِيدٍۢ","أَوْ يُسْلِمُونَ ۖ فَإِن",222],["48:22:2",513,"قَـٰتَلَكُمُ","fight you","وَلَوْ","ٱلَّذِينَ كَفَرُوا۟ لَوَلَّوُا۟",222],["49:9:5",516,"ٱقْتَتَلُوا۟","fight","طَآئِفَتَانِ مِنَ ٱلْمُؤْمِنِينَ","فَأَصْلِحُوا۟ بَيْنَهُمَا ۖ فَإِنۢ",1695],["49:9:13",516,"فَقَـٰتِلُوا۟","then fight","إِحْدَىٰهُمَا عَلَى ٱلْأُخْرَىٰ","ٱلَّتِى تَبْغِى حَتَّىٰ",222],["51:10:1",521,"قُتِلَ","Cursed be","","ٱلْخَرَّٰصُونَ",135],["57:10:20",538,"وَقَـٰتَلَ ۚ","and fought","مِن قَبْلِ ٱلْفَتْحِ","أُو۟لَـٰٓئِكَ أَعْظَمُ دَرَجَةًۭ",222],["57:10:29",538,"وَقَـٰتَلُوا۟ ۚ","and fought","أَنفَقُوا۟ مِنۢ بَعْدُ","وَكُلًّۭا وَعَدَ ٱللَّهُ",222],["59:11:23",547,"قُوتِلْتُمْ","you are fought","أَحَدًا أَبَدًۭا وَإِن","لَنَنصُرَنَّكُمْ وَٱللَّهُ يَشْهَدُ",222],["59:12:7",547,"قُوتِلُوا۟","they are fought","يَخْرُجُونَ مَعَهُمْ وَلَئِن","لَا يَنصُرُونَهُمْ وَلَئِن",222],["59:14:2",547,"يُقَـٰتِلُونَكُمْ","will they fight you","لَا","جَمِيعًا إِلَّا فِى",222],["60:8:7",550,"يُقَـٰتِلُوكُمْ","fight you","عَنِ ٱلَّذِينَ لَمْ","فِى ٱلدِّينِ وَلَمْ",222],["60:9:6",550,"قَـٰتَلُوكُمْ","fight you","ٱللَّهُ عَنِ ٱلَّذِينَ","فِى ٱلدِّينِ وَأَخْرَجُوكُم",222],["60:12:18",551,"يَقْتُلْنَ","they will kill","وَلَا يَزْنِينَ وَلَا","أَوْلَـٰدَهُنَّ وَلَا يَأْتِينَ",135],["61:4:5",551,"يُقَـٰتِلُونَ","fight","ٱللَّهَ يُحِبُّ ٱلَّذِينَ","فِى سَبِيلِهِۦ صَفًّۭا",222],["63:4:19",554,"قَـٰتَلَهُمُ","May destroy them","هُمُ ٱلْعَدُوُّ فَٱحْذَرْهُمْ ۚ","ٱللَّهُ ۖ أَنَّىٰ يُؤْفَكُونَ",222],["73:20:45",575,"يُقَـٰتِلُونَ","fighting","فَضْلِ ٱللَّهِ ۙ وَءَاخَرُونَ","فِى سَبِيلِ ٱللَّهِ ۖ",222],["74:19:1",576,"فَقُتِلَ","So may he be destroyed","","كَيْفَ قَدَّرَ",135],["74:20:2",576,"قُتِلَ","may he be destroyed","ثُمَّ","كَيْفَ قَدَّرَ",135],["80:17:1",585,"قُتِلَ","Is destroyed","","ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ",135],["81:9:3",586,"قُتِلَتْ","she was killed","بِأَىِّ ذَنۢبٍۢ","",135],["85:4:1",590,"قُتِلَ","Destroyed were","","أَصْحَـٰبُ ٱلْأُخْدُودِ",135]]