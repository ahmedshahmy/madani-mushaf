[["1:7:9",1,"ٱلضَّآلِّينَ","(of) those who go astray","ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا","",652],["2:16:4",3,"ٱلضَّلَـٰلَةَ","[the] astraying","أُو۟لَـٰٓئِكَ ٱلَّذِينَ ٱشْتَرَوُا۟","بِٱلْهُدَىٰ فَمَا رَبِحَت",881],["2:26:29",5,"يُضِلُّ","He lets go astray","ٱللَّهُ بِهَـٰذَا مَثَلًۭا ۘ","بِهِۦ كَثِيرًۭا وَيَهْدِى",185],["2:26:36",5,"يُضِلُّ","He lets go astray","بِهِۦ كَثِيرًۭا ۚ وَمَا","بِهِۦٓ إِلَّا ٱلْفَـٰسِقِينَ",185],["2:108:16",17,"ضَلَّ","he went astray (from)","ٱلْكُفْرَ بِٱلْإِيمَـٰنِ فَقَدْ","سَوَآءَ ٱلسَّبِيلِ",223],["2:175:4",26,"ٱلضَّلَـٰلَةَ","[the] astraying","أُو۟لَـٰٓئِكَ ٱلَّذِينَ ٱشْتَرَوُا۟","بِٱلْهُدَىٰ وَٱلْعَذَابَ بِٱلْمَغْفِرَةِ ۚ",881],["2:198:26",31,"ٱلضَّآلِّينَ","those who went astray","مِّن قَبْلِهِۦ لَمِنَ","",652],["2:282:67",48,"تَضِلَّ","[she] errs","مِنَ ٱلشُّهَدَآءِ أَن","إِحْدَىٰهُمَا فَتُذَكِّرَ إِحْدَىٰهُمَا",223],["3:69:7",58,"يُضِلُّونَكُمْ","they could lead you astray","أَهْلِ ٱلْكِتَـٰبِ لَوْ","وَمَا يُضِلُّونَ إِلَّآ",185],["3:69:9",58,"يُضِلُّونَ","they lead astray","لَوْ يُضِلُّونَكُمْ وَمَا","إِلَّآ أَنفُسَهُمْ وَمَا",185],["3:90:14",61,"ٱلضَّآلُّونَ","(are) those who have gone astray","تَوْبَتُهُمْ وَأُو۟لَـٰٓئِكَ هُمُ","",652],["3:164:24",71,"ضَلَـٰلٍۢ","(the) error","مِن قَبْلُ لَفِى","مُّبِينٍ",306],["4:44:10",85,"ٱلضَّلَـٰلَةَ","[the] error","مِّنَ ٱلْكِتَـٰبِ يَشْتَرُونَ","وَيُرِيدُونَ أَن تَضِلُّوا۟",881],["4:44:13",85,"تَضِلُّوا۟","you stray","ٱلضَّلَـٰلَةَ وَيُرِيدُونَ أَن","ٱلسَّبِيلَ",223],["4:60:28",88,"يُضِلَّهُمْ","mislead them","وَيُرِيدُ ٱلشَّيْطَـٰنُ أَن","ضَلَـٰلًۢا بَعِيدًۭا",185],["4:60:29",88,"ضَلَـٰلًۢا","astray","ٱلشَّيْطَـٰنُ أَن يُضِلَّهُمْ","بَعِيدًۭا",306],["4:88:14",92,"أَضَلَّ","is let astray","أَن تَهْدُوا۟ مَنْ","ٱللَّهُ ۖ وَمَن يُضْلِلِ",185],["4:88:17",92,"يُضْلِلِ","is let astray","أَضَلَّ ٱللَّهُ ۖ وَمَن","ٱللَّهُ فَلَن تَجِدَ",185],["4:113:10",96,"يُضِلُّوكَ","mislead you","طَّآئِفَةٌۭ مِّنْهُمْ أَن","وَمَا يُضِلُّونَ إِلَّآ",185],["4:113:12",96,"يُضِلُّونَ","they mislead","أَن يُضِلُّوكَ وَمَا","إِلَّآ أَنفُسَهُمْ ۖ وَمَا",185],["4:116:18",97,"ضَلَّ","he lost (the) way","يُشْرِكْ بِٱللَّهِ فَقَدْ","ضَلَـٰلًۢا بَعِيدًا",223],["4:116:19",97,"ضَلَـٰلًۢا","straying","بِٱللَّهِ فَقَدْ ضَلَّ","بَعِيدًا",306],["4:119:1",97,"وَلَأُضِلَّنَّهُمْ","And I will surely mislead them","","وَلَأُمَنِّيَنَّهُمْ وَلَـَٔامُرَنَّهُمْ فَلَيُبَتِّكُنَّ",185],["4:136:26",100,"ضَلَّ","he (has) lost (the) way","وَٱلْيَوْمِ ٱلْـَٔاخِرِ فَقَدْ","ضَلَـٰلًۢا بَعِيدًا",223],["4:136:27",100,"ضَلَـٰلًۢا","straying","ٱلْـَٔاخِرِ فَقَدْ ضَلَّ","بَعِيدًا",306],["4:143:11",101,"يُضْلِلِ","has been lead astray","إِلَىٰ هَـٰٓؤُلَآءِ ۚ وَمَن","ٱللَّهُ فَلَن تَجِدَ",185],["4:167:9",104,"ضَلُّوا۟","they have strayed","سَبِيلِ ٱللَّهِ قَدْ","ضَلَـٰلًۢا بَعِيدًا",223],["4:167:10",104,"ضَلَـٰلًۢا","straying","ٱللَّهِ قَدْ ضَلُّوا۟","بَعِيدًا",306],["4:176:46",106,"تَضِلُّوا۟ ۗ","you go astray","ٱللَّهُ لَكُمْ أَن","وَٱللَّهُ بِكُلِّ شَىْءٍ",223],["5:12:43",109,"ضَلَّ","he strayed","ذَٰلِكَ مِنكُمْ فَقَدْ","سَوَآءَ ٱلسَّبِيلِ",223],["5:60:24",118,"وَأَضَلُّ","and farthest astray","أُو۟لَـٰٓئِكَ شَرٌّۭ مَّكَانًۭا","عَن سَوَآءِ ٱلسَّبِيلِ",873],["5:77:15",120,"ضَلُّوا۟","who went astray","أَهْوَآءَ قَوْمٍۢ قَدْ","مِن قَبْلُ وَأَضَلُّوا۟",223],["5:77:18",120,"وَأَضَلُّوا۟","and they misled","ضَلُّوا۟ مِن قَبْلُ","كَثِيرًۭا وَضَلُّوا۟ عَن",185],["5:77:20",120,"وَضَلُّوا۟","and they have strayed","قَبْلُ وَأَضَلُّوا۟ كَثِيرًۭا","عَن سَوَآءِ ٱلسَّبِيلِ",223],["5:105:9",125,"ضَلَّ","(have gone) astray","لَا يَضُرُّكُم مَّن","إِذَا ٱهْتَدَيْتُمْ ۚ إِلَى",223],["6:24:6",130,"وَضَلَّ","And lost","كَذَبُوا۟ عَلَىٰٓ أَنفُسِهِمْ ۚ","عَنْهُم مَّا كَانُوا۟",223],["6:39:11",132,"يُضْلِلْهُ","He lets him go astray","مَن يَشَإِ ٱللَّهُ","وَمَن يَشَأْ يَجْعَلْهُ",185],["6:56:16",134,"ضَلَلْتُ","I would go astray","أَتَّبِعُ أَهْوَآءَكُمْ ۙ قَدْ","إِذًۭا وَمَآ أَنَا۠",223],["6:74:13",137,"ضَلَـٰلٍۢ","error","أَرَىٰكَ وَقَوْمَكَ فِى","مُّبِينٍۢ",306],["6:77:18",137,"ٱلضَّآلِّينَ","who went astray","لَأَكُونَنَّ مِنَ ٱلْقَوْمِ","",652],["6:94:25",139,"وَضَلَّ","and is lost","لَقَد تَّقَطَّعَ بَيْنَكُمْ","عَنكُم مَّا كُنتُمْ",223],["6:116:7",142,"يُضِلُّوكَ","they will mislead you","مَن فِى ٱلْأَرْضِ","عَن سَبِيلِ ٱللَّهِ ۚ",185],["6:117:6",142,"يَضِلُّ","strays","هُوَ أَعْلَمُ مَن","عَن سَبِيلِهِۦ ۖ وَهُوَ",223],["6:119:22",143,"لَّيُضِلُّونَ","surely lead astray","إِلَيْهِ ۗ وَإِنَّ كَثِيرًۭا","بِأَهْوَآئِهِم بِغَيْرِ عِلْمٍ ۗ",185],["6:125:12",144,"يُضِلَّهُۥ","He lets him go astray","وَمَن يُرِدْ أَن","يَجْعَلْ صَدْرَهُۥ ضَيِّقًا",185],["6:140:17",146,"ضَلُّوا۟","they have gone astray","عَلَى ٱللَّهِ ۚ قَدْ","وَمَا كَانُوا۟ مُهْتَدِينَ",223],["6:144:31",147,"لِّيُضِلَّ","to mislead","عَلَى ٱللَّهِ كَذِبًۭا","ٱلنَّاسَ بِغَيْرِ عِلْمٍ ۗ",185],["7:30:6",153,"ٱلضَّلَـٰلَةُ ۗ","the astraying","وَفَرِيقًا حَقَّ عَلَيْهِمُ","إِنَّهُمُ ٱتَّخَذُوا۟ ٱلشَّيَـٰطِينَ",881],["7:37:30",154,"ضَلُّوا۟","They strayed","دُونِ ٱللَّهِ ۖ قَالُوا۟","عَنَّا وَشَهِدُوا۟ عَلَىٰٓ",223],["7:38:29",155,"أَضَلُّونَا","misled us","لِأُولَىٰهُمْ رَبَّنَا هَـٰٓؤُلَآءِ","فَـَٔاتِهِمْ عَذَابًۭا ضِعْفًۭا",185],["7:53:34",157,"وَضَلَّ","and strayed","قَدْ خَسِرُوٓا۟ أَنفُسَهُمْ","عَنْهُم مَّا كَانُوا۟",223],["7:60:8",158,"ضَلَـٰلٍۢ","error","إِنَّا لَنَرَىٰكَ فِى","مُّبِينٍۢ",306],["7:61:5",158,"ضَلَـٰلَةٌۭ","error","يَـٰقَوْمِ لَيْسَ بِى","وَلَـٰكِنِّى رَسُولٌۭ مِّن",881],["7:149:8",168,"ضَلُّوا۟","gone astray","وَرَأَوْا۟ أَنَّهُمْ قَدْ","قَالُوا۟ لَئِن لَّمْ",223],["7:155:27",169,"تُضِلُّ","You let go astray","هِىَ إِلَّا فِتْنَتُكَ","بِهَا مَن تَشَآءُ",185],["7:178:7",173,"يُضْلِلْ","He lets go astray","فَهُوَ ٱلْمُهْتَدِى ۖ وَمَن","فَأُو۟لَـٰٓئِكَ هُمُ ٱلْخَـٰسِرُونَ",185],["7:179:27",174,"أَضَلُّ ۚ","(are) more astray","كَٱلْأَنْعَـٰمِ بَلْ هُمْ","أُو۟لَـٰٓئِكَ هُمُ ٱلْغَـٰفِلُونَ",873],["7:186:2",174,"يُضْلِلِ","(is) let go astray","مَن","ٱللَّهُ فَلَا هَادِىَ",185],["9:37:6",193,"يُضَلُّ","are led astray","زِيَادَةٌۭ فِى ٱلْكُفْرِ ۖ","بِهِ ٱلَّذِينَ كَفَرُوا۟",223],["9:115:4",205,"لِيُضِلَّ","that He lets go astray","وَمَا كَانَ ٱللَّهُ","قَوْمًۢا بَعْدَ إِذْ",185],["10:30:12",212,"وَضَلَّ","and will be lost","ٱللَّهِ مَوْلَىٰهُمُ ٱلْحَقِّ ۖ","عَنْهُم مَّا كَانُوا۟",223],["10:32:9",212,"ٱلضَّلَـٰلُ ۖ","the error","بَعْدَ ٱلْحَقِّ إِلَّا","فَأَنَّىٰ تُصْرَفُونَ",306],["10:88:14",218,"لِيُضِلُّوا۟","That they may lead astray","ٱلْحَيَوٰةِ ٱلدُّنْيَا رَبَّنَا","عَن سَبِيلِكَ ۖ رَبَّنَا",185],["10:108:15",221,"ضَلَّ","goes astray","يَهْتَدِى لِنَفْسِهِۦ ۖ وَمَن","فَإِنَّمَا يَضِلُّ عَلَيْهَا ۖ",223],["10:108:17",221,"يَضِلُّ","he strays","وَمَن ضَلَّ فَإِنَّمَا","عَلَيْهَا ۖ وَمَآ أَنَا۠",223],["11:21:5",224,"وَضَلَّ","and lost","ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُمْ","عَنْهُم مَّا كَانُوا۟",223],["12:8:14",236,"ضَلَـٰلٍۢ","an error","إِنَّ أَبَانَا لَفِى","مُّبِينٍ",306],["12:30:17",238,"ضَلَـٰلٍۢ","an error","إِنَّا لَنَرَىٰهَا فِى","مُّبِينٍۢ",306],["12:95:5",246,"ضَلَـٰلِكَ","your error","تَٱللَّهِ إِنَّكَ لَفِى","ٱلْقَدِيمِ",306],["13:14:27",251,"ضَلَـٰلٍۢ","error","ٱلْكَـٰفِرِينَ إِلَّا فِى","",306],["13:27:13",252,"يُضِلُّ","lets go astray","قُلْ إِنَّ ٱللَّهَ","مَن يَشَآءُ وَيَهْدِىٓ",185],["13:33:34",253,"يُضْلِلِ","(by) Allah","عَنِ ٱلسَّبِيلِ ۗ وَمَن","ٱللَّهُ فَمَا لَهُۥ",185],["14:3:15",255,"ضَلَـٰلٍۭ","(are) far astray","عِوَجًا ۚ أُو۟لَـٰٓئِكَ فِى","بَعِيدٍۢ",306],["14:4:10",255,"فَيُضِلُّ","Then Allah lets go astray","قَوْمِهِۦ لِيُبَيِّنَ لَهُمْ ۖ","ٱللَّهُ مَن يَشَآءُ",185],["14:18:21",257,"ٱلضَّلَـٰلُ","(is) the straying","شَىْءٍۢ ۚ ذَٰلِكَ هُوَ","ٱلْبَعِيدُ",306],["14:27:12",259,"وَيُضِلُّ","And Allah lets go astray","ٱلدُّنْيَا وَفِى ٱلْـَٔاخِرَةِ ۖ","ٱللَّهُ ٱلظَّـٰلِمِينَ ۚ وَيَفْعَلُ",185],["14:30:4",259,"لِّيُضِلُّوا۟","so that they mislead","وَجَعَلُوا۟ لِلَّهِ أَندَادًۭا","عَن سَبِيلِهِۦ ۗ قُلْ",185],["14:36:3",260,"أَضْلَلْنَ","have led astray","رَبِّ إِنَّهُنَّ","كَثِيرًۭا مِّنَ ٱلنَّاسِ ۖ",185],["15:56:8",265,"ٱلضَّآلُّونَ","those who are astray","رَّحْمَةِ رَبِّهِۦٓ إِلَّا","",652],["16:25:9",269,"يُضِلُّونَهُم","they misled [them]","وَمِنْ أَوْزَارِ ٱلَّذِينَ","بِغَيْرِ عِلْمٍ ۗ أَلَا",185],["16:36:20",271,"ٱلضَّلَـٰلَةُ ۚ","the straying","مَّنْ حَقَّتْ عَلَيْهِ","فَسِيرُوا۟ فِى ٱلْأَرْضِ",881],["16:37:10",271,"يُضِلُّ ۖ","He lets go astray","لَا يَهْدِى مَن","وَمَا لَهُم مِّن",185],["16:87:6",276,"وَضَلَّ","and (is) lost","ٱللَّهِ يَوْمَئِذٍ ٱلسَّلَمَ ۖ","عَنْهُم مَّا كَانُوا۟",223],["16:93:8",277,"يُضِلُّ","He lets go astray","أُمَّةًۭ وَٰحِدَةًۭ وَلَـٰكِن","مَن يَشَآءُ وَيَهْدِى",185],["16:125:17",281,"ضَلَّ","has strayed","هُوَ أَعْلَمُ بِمَن","عَن سَبِيلِهِۦ ۖ وَهُوَ",223],["17:15:7",283,"ضَلَّ","goes astray","يَهْتَدِى لِنَفْسِهِۦ ۖ وَمَن","فَإِنَّمَا يَضِلُّ عَلَيْهَا ۚ",223],["17:15:9",283,"يَضِلُّ","he goes astray","وَمَن ضَلَّ فَإِنَّمَا","عَلَيْهَا ۚ وَلَا تَزِرُ",223],["17:48:6",286,"فَضَلُّوا۟","but they have gone astray","ضَرَبُوا۟ لَكَ ٱلْأَمْثَالَ","فَلَا يَسْتَطِيعُونَ سَبِيلًۭا",223],["17:67:6",289,"ضَلَّ","lost","ٱلضُّرُّ فِى ٱلْبَحْرِ","مَن تَدْعُونَ إِلَّآ",223],["17:72:10",289,"وَأَضَلُّ","and more astray","فِى ٱلْـَٔاخِرَةِ أَعْمَىٰ","سَبِيلًۭا",873],["17:97:7",292,"يُضْلِلْ","He lets go astray","فَهُوَ ٱلْمُهْتَدِ ۖ وَمَن","فَلَن تَجِدَ لَهُمْ",185],["18:17:29",295,"يُضْلِلْ","He lets go astray","فَهُوَ ٱلْمُهْتَدِ ۖ وَمَن","فَلَن تَجِدَ لَهُۥ",185],["18:51:12",299,"ٱلْمُضِلِّينَ","the misleaders","وَمَا كُنتُ مُتَّخِذَ","عَضُدًۭا",1929],["18:104:2",304,"ضَلَّ","is lost","ٱلَّذِينَ","سَعْيُهُمْ فِى ٱلْحَيَوٰةِ",223],["19:38:10",307,"ضَلَـٰلٍۢ","error","ٱلظَّـٰلِمُونَ ٱلْيَوْمَ فِى","مُّبِينٍۢ",306],["19:75:5",310,"ٱلضَّلَـٰلَةِ","[the] error","مَن كَانَ فِى","فَلْيَمْدُدْ لَهُ ٱلرَّحْمَـٰنُ",881],["20:52:8",315,"يَضِلُّ","errs","فِى كِتَـٰبٍۢ ۖ لَّا","رَبِّى وَلَا يَنسَى",223],["20:79:1",317,"وَأَضَلَّ","And led astray","","فِرْعَوْنُ قَوْمَهُۥ وَمَا",185],["20:85:8",317,"وَأَضَلَّهُمُ","and has led them astray","قَوْمَكَ مِنۢ بَعْدِكَ","ٱلسَّامِرِىُّ",185],["20:92:7",318,"ضَلُّوٓا۟","going astray","مَنَعَكَ إِذْ رَأَيْتَهُمْ","",223],["20:123:16",320,"يَضِلُّ","he will go astray","ٱتَّبَعَ هُدَاىَ فَلَا","وَلَا يَشْقَىٰ",223],["21:54:7",326,"ضَلَـٰلٍۢ","an error","أَنتُمْ وَءَابَآؤُكُمْ فِى","مُّبِينٍۢ",306],["22:4:7",332,"يُضِلُّهُۥ","will misguide him","مَن تَوَلَّاهُ فَأَنَّهُۥ","وَيَهْدِيهِ إِلَىٰ عَذَابِ",185],["22:9:3",333,"لِيُضِلَّ","to mislead","ثَانِىَ عِطْفِهِۦ","عَن سَبِيلِ ٱللَّهِ ۖ",185],["22:12:13",333,"ٱلضَّلَـٰلُ","(is) the straying","يَنفَعُهُۥ ۚ ذَٰلِكَ هُوَ","ٱلْبَعِيدُ",306],["23:106:8",349,"ضَآلِّينَ","astray","شِقْوَتُنَا وَكُنَّا قَوْمًۭا","",652],["25:9:6",360,"فَضَلُّوا۟","but they have gone astray","ضَرَبُوا۟ لَكَ ٱلْأَمْثَـٰلَ","فَلَا يَسْتَطِيعُونَ سَبِيلًۭا",223],["25:17:10",361,"أَضْلَلْتُمْ","[you] mislead","ٱللَّهِ فَيَقُولُ ءَأَنتُمْ","عِبَادِى هَـٰٓؤُلَآءِ أَمْ",185],["25:17:15",361,"ضَلُّوا۟","went astray","هَـٰٓؤُلَآءِ أَمْ هُمْ","ٱلسَّبِيلَ",223],["25:29:2",362,"أَضَلَّنِى","he led me astray","لَّقَدْ","عَنِ ٱلذِّكْرِ بَعْدَ",185],["25:34:10",363,"وَأَضَلُّ","and most astray","أُو۟لَـٰٓئِكَ شَرٌّۭ مَّكَانًۭا","سَبِيلًۭا",873],["25:42:3",363,"لَيُضِلُّنَا","[surely] misled us","إِن كَادَ","عَنْ ءَالِهَتِنَا لَوْلَآ",185],["25:42:16",363,"أَضَلُّ","(is) more astray","يَرَوْنَ ٱلْعَذَابَ مَنْ","سَبِيلًا",873],["25:44:14",364,"أَضَلُّ","(are) more astray","كَٱلْأَنْعَـٰمِ ۖ بَلْ هُمْ","سَبِيلًا",873],["26:20:6",368,"ٱلضَّآلِّينَ","those who are astray","إِذًۭا وَأَنَا۠ مِنَ","",652],["26:86:6",371,"ٱلضَّآلِّينَ","those astray","إِنَّهُۥ كَانَ مِنَ","",652],["26:97:5",371,"ضَلَـٰلٍۢ","error","إِن كُنَّا لَفِى","مُّبِينٍ",306],["26:99:2",371,"أَضَلَّنَآ","misguided us","وَمَآ","إِلَّا ٱلْمُجْرِمُونَ",185],["27:81:6",384,"ضَلَـٰلَتِهِمْ ۖ","their error","بِهَـٰدِى ٱلْعُمْىِ عَن","إِن تُسْمِعُ إِلَّا",881],["27:92:10",385,"ضَلَّ","goes astray","يَهْتَدِى لِنَفْسِهِۦ ۖ وَمَن","فَقُلْ إِنَّمَآ أَنَا۠",223],["28:15:37",387,"مُّضِلٌّۭ","one who misleads","ٱلشَّيْطَـٰنِ ۖ إِنَّهُۥ عَدُوٌّۭ","مُّبِينٌۭ",1929],["28:50:10",391,"أَضَلُّ","(is) more astray","يَتَّبِعُونَ أَهْوَآءَهُمْ ۚ وَمَنْ","مِمَّنِ ٱتَّبَعَ هَوَىٰهُ",873],["28:75:13",394,"وَضَلَّ","and (will be) lost","أَنَّ ٱلْحَقَّ لِلَّهِ","عَنْهُم مَّا كَانُوا۟",223],["28:85:18",396,"ضَلَـٰلٍۢ","an error","وَمَنْ هُوَ فِى","مُّبِينٍۢ",306],["30:29:11",407,"أَضَلَّ","Allah has let go astray","فَمَن يَهْدِى مَنْ","ٱللَّهُ ۖ وَمَا لَهُم",185],["30:53:6",410,"ضَلَـٰلَتِهِمْ ۖ","their error","بِهَـٰدِ ٱلْعُمْىِ عَن","إِن تُسْمِعُ إِلَّا",881],["31:6:7",411,"لِيُضِلَّ","to mislead","يَشْتَرِى لَهْوَ ٱلْحَدِيثِ","عَن سَبِيلِ ٱللَّهِ",185],["31:11:13",411,"ضَلَـٰلٍۢ","error","بَلِ ٱلظَّـٰلِمُونَ فِى","مُّبِينٍۢ",306],["32:10:3",415,"ضَلَلْنَا","we are lost","وَقَالُوٓا۟ أَءِذَا","فِى ٱلْأَرْضِ أَءِنَّا",223],["33:36:22",423,"ضَلَّ","he (has) strayed","ٱللَّهَ وَرَسُولَهُۥ فَقَدْ","ضَلَـٰلًۭا مُّبِينًۭا",223],["33:36:23",423,"ضَلَـٰلًۭا","(into) error","وَرَسُولَهُۥ فَقَدْ ضَلَّ","مُّبِينًۭا",306],["33:67:7",427,"فَأَضَلُّونَا","and they misled us","أَطَعْنَا سَادَتَنَا وَكُبَرَآءَنَا","ٱلسَّبِيلَا۠",185],["34:8:15",429,"وَٱلضَّلَـٰلِ","and error","بِٱلْـَٔاخِرَةِ فِى ٱلْعَذَابِ","ٱلْبَعِيدِ",306],["34:24:16",431,"ضَلَـٰلٍۢ","error","هُدًى أَوْ فِى","مُّبِينٍۢ",306],["34:50:3",434,"ضَلَلْتُ","I err","قُلْ إِن","فَإِنَّمَآ أَضِلُّ عَلَىٰ",223],["34:50:5",434,"أَضِلُّ","I will err","إِن ضَلَلْتُ فَإِنَّمَآ","عَلَىٰ نَفْسِى ۖ وَإِنِ",223],["35:8:10",435,"يُضِلُّ","lets go astray","حَسَنًۭا ۖ فَإِنَّ ٱللَّهَ","مَن يَشَآءُ وَيَهْدِى",185],["36:24:4",441,"ضَلَـٰلٍۢ","an error","إِنِّىٓ إِذًۭا لَّفِى","مُّبِينٍ",306],["36:47:23",443,"ضَلَـٰلٍۢ","an error","أَنتُمْ إِلَّا فِى","مُّبِينٍۢ",306],["36:62:2",444,"أَضَلَّ","he led astray","وَلَقَدْ","مِنكُمْ جِبِلًّۭا كَثِيرًا ۖ",185],["37:69:4",448,"ضَآلِّينَ","astray","إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ","",652],["37:71:2",448,"ضَلَّ","went astray","وَلَقَدْ","قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ",223],["38:26:14",454,"فَيُضِلَّكَ","for it will lead you astray","وَلَا تَتَّبِعِ ٱلْهَوَىٰ","عَن سَبِيلِ ٱللَّهِ ۚ",185],["38:26:20",454,"يَضِلُّونَ","go astray","ٱللَّهِ ۚ إِنَّ ٱلَّذِينَ","عَن سَبِيلِ ٱللَّهِ",223],["39:8:24",459,"لِّيُضِلَّ","to mislead","وَجَعَلَ لِلَّهِ أَندَادًۭا","عَن سَبِيلِهِۦ ۚ قُلْ",185],["39:22:19",461,"ضَلَـٰلٍۢ","error","ٱللَّهِ ۚ أُو۟لَـٰٓئِكَ فِى","مُّبِينٍ",306],["39:23:29",461,"يُضْلِلِ","Allah lets go astray","مَن يَشَآءُ ۚ وَمَن","ٱللَّهُ فَمَا لَهُۥ",185],["39:36:10",462,"يُضْلِلِ","Allah lets go astray","مِن دُونِهِۦ ۚ وَمَن","ٱللَّهُ فَمَا لَهُۥ",185],["39:37:7",462,"مُّضِلٍّ ۗ","misleader","فَمَا لَهُۥ مِن","أَلَيْسَ ٱللَّهُ بِعَزِيزٍۢ",1929],["39:41:11",463,"ضَلَّ","goes astray","ٱهْتَدَىٰ فَلِنَفْسِهِۦ ۖ وَمَن","فَإِنَّمَا يَضِلُّ عَلَيْهَا ۖ",223],["39:41:13",463,"يَضِلُّ","he strays","وَمَن ضَلَّ فَإِنَّمَا","عَلَيْهَا ۖ وَمَآ أَنتَ",223],["40:25:19",469,"ضَلَـٰلٍۢ","error","ٱلْكَـٰفِرِينَ إِلَّا فِى","",306],["40:33:11",470,"يُضْلِلِ","Allah lets go astray","مِنْ عَاصِمٍۢ ۗ وَمَن","ٱللَّهُ فَمَا لَهُۥ",185],["40:34:25",471,"يُضِلُّ","Allah lets go astray","بَعْدِهِۦ رَسُولًۭا ۚ كَذَٰلِكَ","ٱللَّهُ مَنْ هُوَ",185],["40:50:16",473,"ضَلَـٰلٍ","error","ٱلْكَـٰفِرِينَ إِلَّا فِى","",306],["40:74:5",475,"ضَلُّوا۟","They have departed","دُونِ ٱللَّهِ ۖ قَالُوا۟","عَنَّا بَل لَّمْ",223],["40:74:15",475,"يُضِلُّ","Allah lets go astray","قَبْلُ شَيْـًۭٔا ۚ كَذَٰلِكَ","ٱللَّهُ ٱلْكَـٰفِرِينَ",185],["41:29:7",479,"أَضَلَّانَا","misled us","رَبَّنَآ أَرِنَا ٱلَّذَيْنِ","مِنَ ٱلْجِنِّ وَٱلْإِنسِ",185],["41:48:1",482,"وَضَلَّ","And lost","","عَنْهُم مَّا كَانُوا۟",223],["41:52:12",482,"أَضَلُّ","(is) more astray","كَفَرْتُم بِهِۦ مَنْ","مِمَّنْ هُوَ فِى",873],["42:18:21",485,"ضَلَـٰلٍۭ","error","فِى ٱلسَّاعَةِ لَفِى","بَعِيدٍ",306],["42:44:2",487,"يُضْلِلِ","Allah lets go astray","وَمَن","ٱللَّهُ فَمَا لَهُۥ",185],["42:46:11",488,"يُضْلِلِ","Allah lets go astray","دُونِ ٱللَّهِ ۗ وَمَن","ٱللَّهُ فَمَا لَهُۥ",185],["43:40:10",492,"ضَلَـٰلٍۢ","an error","وَمَن كَانَ فِى","مُّبِينٍۢ",306],["45:23:6",501,"وَأَضَلَّهُ","and Allah lets him go astray","ٱتَّخَذَ إِلَـٰهَهُۥ هَوَىٰهُ","ٱللّ