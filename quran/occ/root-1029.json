[["40:71:5",475,"وَٱلسَّلَـٰسِلُ","and the chains","ٱلْأَغْلَـٰلُ فِىٓ أَعْنَـٰقِهِمْ","يُسْحَبُونَ",1994],["69:32:3",567,"سِلْسِلَةٍۢ","a chain","ثُمَّ فِى","ذَرْعُهَا سَبْعُونَ ذِرَاعًۭا",1994],["76:4:4",578,"سَلَـٰسِلَا۟","chains","إِنَّآ أَعْتَدْنَا لِلْكَـٰفِرِينَ","وَأَغْلَـٰلًۭا وَسَعِيرًا",1994]]