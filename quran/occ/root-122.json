[["2:30:19",6,"نُسَبِّحُ","[we] glorify (You)","وَيَسْفِكُ ٱلدِّمَآءَ وَنَحْنُ","بِحَمْدِكَ وَنُقَدِّسُ لَكَ ۖ",276],["2:32:2",6,"سُبْحَـٰنَكَ","Glory be to You","قَالُوا۟","لَا عِلْمَ لَنَآ",285],["2:116:5",18,"سُبْحَـٰنَهُۥ ۖ","Glory be to Him","ٱتَّخَذَ ٱللَّهُ وَلَدًۭا ۗ","بَل لَّهُۥ مَا",285],["3:41:18",55,"وَسَبِّحْ","and glorify (Him)","وَٱذْكُر رَّبَّكَ كَثِيرًۭا","بِٱلْعَشِىِّ وَٱلْإِبْكَـٰرِ",276],["3:191:18",75,"سُبْحَـٰنَكَ","Glory be to You","خَلَقْتَ هَـٰذَا بَـٰطِلًۭا","فَقِنَا عَذَابَ ٱلنَّارِ",285],["4:171:39",105,"سُبْحَـٰنَهُۥٓ","Glory be to Him","ٱللَّهُ إِلَـٰهٌۭ وَٰحِدٌۭ ۖ","أَن يَكُونَ لَهُۥ",285],["5:116:17",127,"سُبْحَـٰنَكَ","Glory be to You","دُونِ ٱللَّهِ ۖ قَالَ","مَا يَكُونُ لِىٓ",285],["6:100:12",140,"سُبْحَـٰنَهُۥ","Glorified is He","وَبَنَـٰتٍۭ بِغَيْرِ عِلْمٍۢ ۚ","وَتَعَـٰلَىٰ عَمَّا يَصِفُونَ",285],["7:143:36",167,"سُبْحَـٰنَكَ","Glory be to You","فَلَمَّآ أَفَاقَ قَالَ","تُبْتُ إِلَيْكَ وَأَنَا۠",285],["7:206:9",176,"وَيُسَبِّحُونَهُۥ","And they glorify Him","يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِۦ","وَلَهُۥ يَسْجُدُونَ ۩",276],["9:31:21",191,"سُبْحَـٰنَهُۥ","Glory be to Him","إِلَـٰهَ إِلَّا هُوَ ۚ","عَمَّا يُشْرِكُونَ",285],["10:10:3",209,"سُبْحَـٰنَكَ","(will be), \"Glory be to You","دَعْوَىٰهُمْ فِيهَا","ٱللَّهُمَّ وَتَحِيَّتُهُمْ فِيهَا",285],["10:18:26",210,"سُبْحَـٰنَهُۥ","Glorified is He","وَلَا فِى ٱلْأَرْضِ ۚ","وَتَعَـٰلَىٰ عَمَّا يُشْرِكُونَ",285],["10:68:5",216,"سُبْحَـٰنَهُۥ ۖ","Glory be to Him","ٱتَّخَذَ ٱللَّهُ وَلَدًۭا ۗ","هُوَ ٱلْغَنِىُّ ۖ لَهُۥ",285],["12:108:12",248,"وَسُبْحَـٰنَ","And Glory be","أَنَا۠ وَمَنِ ٱتَّبَعَنِى ۖ","ٱللَّهِ وَمَآ أَنَا۠",285],["13:13:1",250,"وَيُسَبِّحُ","And glorifies","","ٱلرَّعْدُ بِحَمْدِهِۦ وَٱلْمَلَـٰٓئِكَةُ",276],["15:98:1",267,"فَسَبِّحْ","So glorify","","بِحَمْدِ رَبِّكَ وَكُن",276],["16:1:6",267,"سُبْحَـٰنَهُۥ","Glorified is He","ٱللَّهِ فَلَا تَسْتَعْجِلُوهُ ۚ","وَتَعَـٰلَىٰ عَمَّا يُشْرِكُونَ",285],["16:57:4",273,"سُبْحَـٰنَهُۥ ۙ","Glory be to Him","وَيَجْعَلُونَ لِلَّهِ ٱلْبَنَـٰتِ","وَلَهُم مَّا يَشْتَهُونَ",285],["17:1:1",282,"سُبْحَـٰنَ","Exalted","","ٱلَّذِىٓ أَسْرَىٰ بِعَبْدِهِۦ",285],["17:43:1",286,"سُبْحَـٰنَهُۥ","Glorified is He","","وَتَعَـٰلَىٰ عَمَّا يَقُولُونَ",285],["17:44:1",286,"تُسَبِّحُ","Glorify","","لَهُ ٱلسَّمَـٰوَٰتُ ٱلسَّبْعُ",276],["17:44:12",286,"يُسَبِّحُ","glorifies","مِّن شَىْءٍ إِلَّا","بِحَمْدِهِۦ وَلَـٰكِن لَّا",276],["17:44:17",286,"تَسْبِيحَهُمْ ۗ","their glorification","وَلَـٰكِن لَّا تَفْقَهُونَ","إِنَّهُۥ كَانَ حَلِيمًا",2682],["17:93:20",291,"سُبْحَانَ","Glorified (is)","كِتَـٰبًۭا نَّقْرَؤُهُۥ ۗ قُلْ","رَبِّى هَلْ كُنتُ",285],["17:108:2",293,"سُبْحَـٰنَ","Glory be to","وَيَقُولُونَ","رَبِّنَآ إِن كَانَ",285],["19:11:9",305,"سَبِّحُوا۟","glorify (Allah)","فَأَوْحَىٰٓ إِلَيْهِمْ أَن","بُكْرَةًۭ وَعَشِيًّۭا",276],["19:35:8",307,"سُبْحَـٰنَهُۥٓ ۚ","Glory be to Him","يَتَّخِذَ مِن وَلَدٍۢ ۖ","إِذَا قَضَىٰٓ أَمْرًۭا",285],["20:33:2",313,"نُسَبِّحَكَ","we may glorify You","كَىْ","كَثِيرًۭا",276],["20:130:5",321,"وَسَبِّحْ","and glorify","عَلَىٰ مَا يَقُولُونَ","بِحَمْدِ رَبِّكَ قَبْلَ",276],["20:130:16",321,"فَسَبِّحْ","and glorify","وَمِنْ ءَانَآئِ ٱلَّيْلِ","وَأَطْرَافَ ٱلنَّهَارِ لَعَلَّكَ",276],["21:20:1",323,"يُسَبِّحُونَ","They glorify (Him)","","ٱلَّيْلَ وَٱلنَّهَارَ لَا",276],["21:22:8",323,"فَسُبْحَـٰنَ","So glorified","إِلَّا ٱللَّهُ لَفَسَدَتَا ۚ","ٱللَّهِ رَبِّ ٱلْعَرْشِ",285],["21:26:5",324,"سُبْحَـٰنَهُۥ ۚ","Glorified is He","ٱتَّخَذَ ٱلرَّحْمَـٰنُ وَلَدًۭا ۗ","بَلْ عِبَادٌۭ مُّكْرَمُونَ",285],["21:33:11",324,"يَسْبَحُونَ","floating","كُلٌّۭ فِى فَلَكٍۢ","",2778],["21:79:11",328,"يُسَبِّحْنَ","(to) glorify Our praises","مَعَ دَاوُۥدَ ٱلْجِبَالَ","وَٱلطَّيْرَ ۚ وَكُنَّا فَـٰعِلِينَ",276],["21:87:19",329,"سُبْحَـٰنَكَ","Glory be to You","إِلَـٰهَ إِلَّآ أَنتَ","إِنِّى كُنتُ مِنَ",285],["23:91:21",348,"سُبْحَـٰنَ","Glory be","بَعْضُهُمْ عَلَىٰ بَعْضٍۢ ۚ","ٱللَّهِ عَمَّا يَصِفُونَ",285],["24:16:11",351,"سُبْحَـٰنَكَ","Glory be to You","أَن نَّتَكَلَّمَ بِهَـٰذَا","هَـٰذَا بُهْتَـٰنٌ عَظِيمٌۭ",285],["24:36:10",354,"يُسَبِّحُ","Glorify","وَيُذْكَرَ فِيهَا ٱسْمُهُۥ","لَهُۥ فِيهَا بِٱلْغُدُوِّ",276],["24:41:5",355,"يُسَبِّحُ","glorify","تَرَ أَنَّ ٱللَّهَ","لَهُۥ مَن فِى",276],["24:41:17",355,"وَتَسْبِيحَهُۥ ۗ","and its glorification","قَدْ عَلِمَ صَلَاتَهُۥ","وَٱللَّهُ عَلِيمٌۢ بِمَا",2682],["25:18:2",361,"سُبْحَـٰنَكَ","Glory be to You","قَالُوا۟","مَا كَانَ يَنۢبَغِى",285],["25:58:7",365,"وَسَبِّحْ","and glorify","ٱلَّذِى لَا يَمُوتُ","بِحَمْدِهِۦ ۚ وَكَفَىٰ بِهِۦ",276],["27:8:11",377,"وَسُبْحَـٰنَ","And glory be","ٱلنَّارِ وَمَنْ حَوْلَهَا","ٱللَّهِ رَبِّ ٱلْعَـٰلَمِينَ",285],["28:68:10",393,"سُبْحَـٰنَ","Glory be","كَانَ لَهُمُ ٱلْخِيَرَةُ ۚ","ٱللَّهِ وَتَعَـٰلَىٰ عَمَّا",285],["30:17:1",406,"فَسُبْحَـٰنَ","So glory be to","","ٱللَّهِ حِينَ تُمْسُونَ",285],["30:40:19",408,"سُبْحَـٰنَهُۥ","Glory be to Him","ذَٰلِكُم مِّن شَىْءٍۢ ۚ","وَتَعَـٰلَىٰ عَمَّا يُشْرِكُونَ",285],["32:15:10",416,"وَسَبَّحُوا۟","and glorify","بِهَا خَرُّوا۟ سُجَّدًۭا","بِحَمْدِ رَبِّهِمْ وَهُمْ",276],["33:42:1",423,"وَسَبِّحُوهُ","And glorify Him","","بُكْرَةًۭ وَأَصِيلًا",276],["34:41:2",433,"سُبْحَـٰنَكَ","Glory be to You","قَالُوا۟","أَنتَ وَلِيُّنَا مِن",285],["36:36:1",442,"سُبْحَـٰنَ","Glory be","","ٱلَّذِى خَلَقَ ٱلْأَزْوَٰجَ",285],["36:40:15",442,"يَسْبَحُونَ","they are floating","وَكُلٌّۭ فِى فَلَكٍۢ","",2778],["36:83:1",445,"فَسُبْحَـٰنَ","So glory be","","ٱلَّذِى بِيَدِهِۦ مَلَكُوتُ",285],["37:143:5",451,"ٱلْمُسَبِّحِينَ","those who glorify","أَنَّهُۥ كَانَ مِنَ","",2503],["37:159:1",452,"سُبْحَـٰنَ","Glory be","","ٱللَّهِ عَمَّا يَصِفُونَ",285],["37:166:3",452,"ٱلْمُسَبِّحُونَ","glorify (Allah)","وَإِنَّا لَنَحْنُ","",2503],["37:180:1",452,"سُبْحَـٰنَ","Glory","","رَبِّكَ رَبِّ ٱلْعِزَّةِ",285],["38:18:5",454,"يُسَبِّحْنَ","glorifying","سَخَّرْنَا ٱلْجِبَالَ مَعَهُۥ","بِٱلْعَشِىِّ وَٱلْإِشْرَاقِ",276],["39:4:12",458,"سُبْحَـٰنَهُۥ ۖ","Glory be to Him","يَخْلُقُ مَا يَشَآءُ ۚ","هُوَ ٱللَّهُ ٱلْوَٰحِدُ",285],["39:67:14",465,"سُبْحَـٰنَهُۥ","Glory be to Him","وَٱلسَّمَـٰوَٰتُ مَطْوِيَّـٰتٌۢ بِيَمِينِهِۦ ۚ","وَتَعَـٰلَىٰ عَمَّا يُشْرِكُونَ",285],["39:75:7",467,"يُسَبِّحُونَ","glorifying","مِنْ حَوْلِ ٱلْعَرْشِ","بِحَمْدِ رَبِّهِمْ ۖ وَقُضِىَ",276],["40:7:6",467,"يُسَبِّحُونَ","glorify","ٱلْعَرْشَ وَمَنْ حَوْلَهُۥ","بِحَمْدِ رَبِّهِمْ وَيُؤْمِنُونَ",276],["40:55:8",473,"وَسَبِّحْ","and glorify","حَقٌّۭ وَٱسْتَغْفِرْ لِذَنۢبِكَ","بِحَمْدِ رَبِّكَ بِٱلْعَشِىِّ",276],["41:38:6",480,"يُسَبِّحُونَ","glorify","فَٱلَّذِينَ عِندَ رَبِّكَ","لَهُۥ بِٱلَّيْلِ وَٱلنَّهَارِ",276],["42:5:7",483,"يُسَبِّحُونَ","glorify","مِن فَوْقِهِنَّ ۚ وَٱلْمَلَـٰٓئِكَةُ","بِحَمْدِ رَبِّهِمْ وَيَسْتَغْفِرُونَ",276],["43:13:12",490,"سُبْحَـٰنَ","Glory be (to)","ٱسْتَوَيْتُمْ عَلَيْهِ وَتَقُولُوا۟","ٱلَّذِى سَخَّرَ لَنَا",285],["43:82:1",495,"سُبْحَـٰنَ","Glory be","","رَبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ",285],["48:9:6",511,"وَتُسَبِّحُوهُ","and glorify Him","وَرَسُولِهِۦ وَتُعَزِّرُوهُ وَتُوَقِّرُوهُ","بُكْرَةًۭ وَأَصِيلًا",276],["50:39:5",520,"وَسَبِّحْ","and glorify","عَلَىٰ مَا يَقُولُونَ","بِحَمْدِ رَبِّكَ قَبْلَ",276],["50:40:3",520,"فَسَبِّحْهُ","glorify Him","وَمِنَ ٱلَّيْلِ","وَأَدْبَـٰرَ ٱلسُّجُودِ",276],["52:43:6",525,"سُبْحَـٰنَ","Glory be","إِلَـٰهٌ غَيْرُ ٱللَّهِ ۚ","ٱللَّهِ عَمَّا يُشْرِكُونَ",285],["52:48:6",525,"وَسَبِّحْ","And glorify","رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا ۖ","بِحَمْدِ رَبِّكَ حِينَ",276],["52:49:3",525,"فَسَبِّحْهُ","glorify Him","وَمِنَ ٱلَّيْلِ","وَإِدْبَـٰرَ ٱلنُّجُومِ",276],["56:74:1",536,"فَسَبِّحْ","So glorify","","بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",276],["56:96:1",537,"فَسَبِّحْ","So glorify","","بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",276],["57:1:1",537,"سَبَّحَ","Glorifies","","لِلَّهِ مَا فِى",276],["59:1:1",545,"سَبَّحَ","Glorifies","","لِلَّهِ مَا فِى",276],["59:23:16",548,"سُبْحَـٰنَ","Glory (be to)","ٱلْعَزِيزُ ٱلْجَبَّارُ ٱلْمُتَكَبِّرُ ۚ","ٱللَّهِ عَمَّا يُشْرِكُونَ",285],["59:24:9",548,"يُسَبِّحُ","Glorifies","لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ ۚ","لَهُۥ مَا فِى",276],["61:1:1",551,"سَبَّحَ","Glorifies","","لِلَّهِ مَا فِى",276],["62:1:1",553,"يُسَبِّحُ","Glorifies","","لِلَّهِ مَا فِى",276],["64:1:1",556,"يُسَبِّحُ","Glorifies","","لِلَّهِ مَا فِى",276],["68:28:7",565,"تُسَبِّحُونَ","you glorify (Allah)?'","أَقُل لَّكُمْ لَوْلَا","",276],["68:29:2",565,"سُبْحَـٰنَ","Glory be","قَالُوا۟","رَبِّنَآ إِنَّا كُنَّا",285],["69:52:1",568,"فَسَبِّحْ","So glorify","","بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",276],["73:7:5",574,"سَبْحًۭا","(is) occupation","لَكَ فِى ٱلنَّهَارِ","طَوِيلًۭا",2620],["76:26:5",580,"وَسَبِّحْهُ","and glorify Him","ٱلَّيْلِ فَٱسْجُدْ لَهُۥ","لَيْلًۭا طَوِيلًا",276],["79:3:1",583,"وَٱلسَّـٰبِحَـٰتِ","And those who glide","","سَبْحًۭا",4293],["79:3:2",583,"سَبْحًۭا","swimming","وَٱلسَّـٰبِحَـٰتِ","",2620],["87:1:1",591,"سَبِّحِ","Glorify","","ٱسْمَ رَبِّكَ ٱلْأَعْلَى",276],["110:3:1",603,"فَسَبِّحْ","Then glorify","","بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ",276]]