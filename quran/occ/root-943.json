[["5:45:9",115,"وَٱلْأَنفَ","and the nose","بِٱلنَّفْسِ وَٱلْعَيْنَ بِٱلْعَيْنِ","بِٱلْأَنفِ وَٱلْأُذُنَ بِٱلْأُذُنِ",2182],["5:45:10",115,"بِٱلْأَنفِ","for the nose","وَٱلْعَيْنَ بِٱلْعَيْنِ وَٱلْأَنفَ","وَٱلْأُذُنَ بِٱلْأُذُنِ وَٱلسِّنَّ",2182],["47:16:16",508,"ءَانِفًا ۚ","just now","ٱلْعِلْمَ مَاذَا قَالَ","أُو۟لَـٰٓئِكَ ٱلَّذِينَ طَبَعَ",2908]]