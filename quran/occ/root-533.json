[["12:25:20",238,"يُسْجَنَ","he be imprisoned","سُوٓءًا إِلَّآ أَن","أَوْ عَذَابٌ أَلِيمٌۭ",2086],["12:32:16",239,"لَيُسْجَنَنَّ","surely, he will be imprisoned","يَفْعَلْ مَآ ءَامُرُهُۥ","وَلَيَكُونًۭا مِّنَ ٱلصَّـٰغِرِينَ",2086],["12:33:3",239,"ٱلسِّجْنُ","the prison","قَالَ رَبِّ","أَحَبُّ إِلَىَّ مِمَّا",1233],["12:35:9",239,"لَيَسْجُنُنَّهُۥ","surely they should imprison him","مَا رَأَوُا۟ ٱلْـَٔايَـٰتِ","حَتَّىٰ حِينٍۢ",2086],["12:36:3",239,"ٱلسِّجْنَ","(in) the prison","وَدَخَلَ مَعَهُ","فَتَيَانِ ۖ قَالَ أَحَدُهُمَآ",1233],["12:39:2",240,"ٱلسِّجْنِ","(of) the prison","يَـٰصَـٰحِبَىِ","ءَأَرْبَابٌۭ مُّتَفَرِّقُونَ خَيْرٌ",1233],["12:41:2",240,"ٱلسِّجْنِ","(of) the prison","يَـٰصَـٰحِبَىِ","أَمَّآ أَحَدُكُمَا فَيَسْقِى",1233],["12:42:16",240,"ٱلسِّجْنِ","the prison","رَبِّهِۦ فَلَبِثَ فِى","بِضْعَ سِنِينَ",1233],["12:100:25",247,"ٱلسِّجْنِ","the prison","إِذْ أَخْرَجَنِى مِنَ","وَجَآءَ بِكُم مِّنَ",1233],["26:29:8",368,"ٱلْمَسْجُونِينَ","those imprisoned","غَيْرِى لَأَجْعَلَنَّكَ مِنَ","",3716],["83:7:6",588,"سِجِّينٍۢ","Sijjin","كِتَـٰبَ ٱلْفُجَّارِ لَفِى","",2637],["83:8:4",588,"سِجِّينٌۭ","(is) Sijjin","وَمَآ أَدْرَىٰكَ مَا","",2637]]