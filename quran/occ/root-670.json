[["9:82:3",200,"وَلْيَبْكُوا۟","and let them weep","فَلْيَضْحَكُوا۟ قَلِيلًۭا","كَثِيرًۭا جَزَآءًۢ بِمَا",1321],["12:16:4",237,"يَبْكُونَ","weeping","وَجَآءُوٓ أَبَاهُمْ عِشَآءًۭ","",1321],["17:109:3",293,"يَبْكُونَ","weeping","وَيَخِرُّونَ لِلْأَذْقَانِ","وَيَزِيدُهُمْ خُشُوعًۭا ۩",1321],["19:58:29",309,"وَبُكِيًّۭا ۩","and weeping","ٱلرَّحْمَـٰنِ خَرُّوا۟ سُجَّدًۭا","",3360],["44:29:2",497,"بَكَتْ","wept","فَمَا","عَلَيْهِمُ ٱلسَّمَآءُ وَٱلْأَرْضُ",1321],["53:43:4",527,"وَأَبْكَىٰ","and makes (one) weep","وَأَنَّهُۥ هُوَ أَضْحَكَ","",2977],["53:60:3",528,"تَبْكُونَ","weep","وَتَضْحَكُونَ وَلَا","",1321]]