[["2:224:5",35,"لِّأَيْمَـٰنِكُمْ","in your oaths","تَجْعَلُوا۟ ٱللَّهَ عُرْضَةًۭ","أَن تَبَرُّوا۟ وَتَتَّقُوا۟",184],["2:225:6",36,"أَيْمَـٰنِكُمْ","your oaths","ٱللَّهُ بِٱللَّغْوِ فِىٓ","وَلَـٰكِن يُؤَاخِذُكُم بِمَا",184],["3:77:6",59,"وَأَيْمَـٰنِهِمْ","and their oaths","يَشْتَرُونَ بِعَهْدِ ٱللَّهِ","ثَمَنًۭا قَلِيلًا أُو۟لَـٰٓئِكَ",184],["4:3:24",77,"أَيْمَـٰنُكُمْ ۚ","your right hand","أَوْ مَا مَلَكَتْ","ذَٰلِكَ أَدْنَىٰٓ أَلَّا",184],["4:24:7",82,"أَيْمَـٰنُكُمْ ۖ","rightfully","إِلَّا مَا مَلَكَتْ","كِتَـٰبَ ٱللَّهِ عَلَيْكُمْ ۚ",184],["4:25:13",82,"أَيْمَـٰنُكُم","your right hands","فَمِن مَّا مَلَكَتْ","مِّن فَتَيَـٰتِكُمُ ٱلْمُؤْمِنَـٰتِ ۚ",184],["4:33:10",83,"أَيْمَـٰنُكُمْ","your right hands","وَٱلْأَقْرَبُونَ ۚ وَٱلَّذِينَ عَقَدَتْ","فَـَٔاتُوهُمْ نَصِيبَهُمْ ۚ إِنَّ",184],["4:36:24",84,"أَيْمَـٰنُكُمْ ۗ","your right hands","ٱلسَّبِيلِ وَمَا مَلَكَتْ","إِنَّ ٱللَّهَ لَا",184],["5:53:9",117,"أَيْمَـٰنِهِمْ ۙ","(of) their oaths","أَقْسَمُوا۟ بِٱللَّهِ جَهْدَ","إِنَّهُمْ لَمَعَكُمْ ۚ حَبِطَتْ",184],["5:89:6",122,"أَيْمَـٰنِكُمْ","your oaths","ٱللَّهُ بِٱللَّغْوِ فِىٓ","وَلَـٰكِن يُؤَاخِذُكُم بِمَا",184],["5:89:11",122,"ٱلْأَيْمَـٰنَ ۖ","(of) the oath","يُؤَاخِذُكُم بِمَا عَقَّدتُّمُ","فَكَفَّـٰرَتُهُۥٓ إِطْعَامُ عَشَرَةِ",184],["5:89:34",122,"أَيْمَـٰنِكُمْ","(of) your oaths","أَيَّامٍۢ ۚ ذَٰلِكَ كَفَّـٰرَةُ","إِذَا حَلَفْتُمْ ۚ وَٱحْفَظُوٓا۟",184],["5:89:38",122,"أَيْمَـٰنَكُمْ ۚ","your oaths","إِذَا حَلَفْتُمْ ۚ وَٱحْفَظُوٓا۟","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ",184],["5:108:12",125,"أَيْمَـٰنٌۢ","their oaths","يَخَافُوٓا۟ أَن تُرَدَّ","بَعْدَ أَيْمَـٰنِهِمْ ۗ وَٱتَّقُوا۟",184],["5:108:14",125,"أَيْمَـٰنِهِمْ ۗ","their (others) oaths","تُرَدَّ أَيْمَـٰنٌۢ بَعْدَ","وَٱتَّقُوا۟ ٱللَّهَ وَٱسْمَعُوا۟ ۗ",184],["6:109:4",141,"أَيْمَـٰنِهِمْ","(of) their oaths","وَأَقْسَمُوا۟ بِٱللَّهِ جَهْدَ","لَئِن جَآءَتْهُمْ ءَايَةٌۭ",184],["7:17:9",152,"أَيْمَـٰنِهِمْ","their right","وَمِنْ خَلْفِهِمْ وَعَنْ","وَعَن شَمَآئِلِهِمْ ۖ وَلَا",184],["9:12:3",188,"أَيْمَـٰنَهُم","their oaths","وَإِن نَّكَثُوٓا۟","مِّنۢ بَعْدِ عَهْدِهِمْ",184],["9:12:15",188,"أَيْمَـٰنَ","oaths","ٱلْكُفْرِ ۙ إِنَّهُمْ لَآ","لَهُمْ لَعَلَّهُمْ يَنتَهُونَ",184],["9:13:5",188,"أَيْمَـٰنَهُمْ","their oaths","تُقَـٰتِلُونَ قَوْمًۭا نَّكَثُوٓا۟","وَهَمُّوا۟ بِإِخْرَاجِ ٱلرَّسُولِ",184],["16:38:4",271,"أَيْمَـٰنِهِمْ ۙ","(of) their oaths","وَأَقْسَمُوا۟ بِٱللَّهِ جَهْدَ","لَا يَبْعَثُ ٱللَّهُ",184],["16:48:12",272,"ٱلْيَمِينِ","the right","يَتَفَيَّؤُا۟ ظِلَـٰلُهُۥ عَنِ","وَٱلشَّمَآئِلِ سُجَّدًۭا لِّلَّهِ",184],["16:71:16",274,"أَيْمَـٰنُهُمْ","their right hands","عَلَىٰ مَا مَلَكَتْ","فَهُمْ فِيهِ سَوَآءٌ ۚ",184],["16:91:8",277,"ٱلْأَيْمَـٰنَ","oaths","عَـٰهَدتُّمْ وَلَا تَنقُضُوا۟","بَعْدَ تَوْكِيدِهَا وَقَدْ",184],["16:92:11",277,"أَيْمَـٰنَكُمْ","your oaths","قُوَّةٍ أَنكَـٰثًۭا تَتَّخِذُونَ","دَخَلًۢا بَيْنَكُمْ أَن",184],["16:94:3",278,"أَيْمَـٰنَكُمْ","your oaths","وَلَا تَتَّخِذُوٓا۟","دَخَلًۢا بَيْنَكُمْ فَتَزِلَّ",184],["17:71:9",289,"بِيَمِينِهِۦ","in his right hand","فَمَنْ أُوتِىَ كِتَـٰبَهُۥ","فَأُو۟لَـٰٓئِكَ يَقْرَءُونَ كِتَـٰبَهُمْ",184],["18:17:9",295,"ٱلْيَمِينِ","the right","عَن كَهْفِهِمْ ذَاتَ","وَإِذَا غَرَبَت تَّقْرِضُهُمْ",184],["18:18:7",295,"ٱلْيَمِينِ","the right","رُقُودٌۭ ۚ وَنُقَلِّبُهُمْ ذَاتَ","وَذَاتَ ٱلشِّمَالِ ۖ وَكَلْبُهُم",184],["19:52:5",309,"ٱلْأَيْمَنِ","the right","مِن جَانِبِ ٱلطُّورِ","وَقَرَّبْنَـٰهُ نَجِيًّۭا",1748],["20:17:3",313,"بِيَمِينِكَ","in your right hand","وَمَا تِلْكَ","يَـٰمُوسَىٰ",184],["20:69:4",316,"يَمِينِكَ","your right hand","وَأَلْقِ مَا فِى","تَلْقَفْ مَا صَنَعُوٓا۟ ۖ",184],["20:80:10",317,"ٱلْأَيْمَنَ","the right","وَوَٰعَدْنَـٰكُمْ جَانِبَ ٱلطُّورِ","وَنَزَّلْنَا عَلَيْكُمُ ٱلْمَنَّ",1748],["23:6:7",342,"أَيْمَـٰنُهُمْ","their right hands","أَوْ مَا مَلَكَتْ","فَإِنَّهُمْ غَيْرُ مَلُومِينَ",184],["24:31:47",353,"أَيْمَـٰنُهُنَّ","their right hands","أَوْ مَا مَلَكَتْ","أَوِ ٱلتَّـٰبِعِينَ غَيْرِ",184],["24:33:16",354,"أَيْمَـٰنُكُمْ","your right hands","ٱلْكِتَـٰبَ مِمَّا مَلَكَتْ","فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ",184],["24:53:4",356,"أَيْمَـٰنِهِمْ","their oaths","۞ وَأَقْسَمُوا۟ بِٱللَّهِ جَهْدَ","لَئِنْ أَمَرْتَهُمْ لَيَخْرُجُنَّ ۖ",184],["24:58:7",357,"أَيْمَـٰنُكُمْ","your right hands","لِيَسْتَـْٔذِنكُمُ ٱلَّذِينَ مَلَكَتْ","وَٱلَّذِينَ لَمْ يَبْلُغُوا۟",184],["28:30:7",389,"ٱلْأَيْمَنِ","the right","مِن شَـٰطِئِ ٱلْوَادِ","فِى ٱلْبُقْعَةِ ٱلْمُبَـٰرَكَةِ",1748],["29:48:10",402,"بِيَمِينِكَ ۖ","with your right hand","كِتَـٰبٍۢ وَلَا تَخُطُّهُۥ","إِذًۭا لَّٱرْتَابَ ٱلْمُبْطِلُونَ",184],["30:28:11",407,"أَيْمَـٰنُكُم","your right hands","مِّن مَّا مَلَكَتْ","مِّن شُرَكَآءَ فِى",184],["33:50:12",424,"يَمِينُكَ","you rightfully possess","أُجُورَهُنَّ وَمَا مَلَكَتْ","مِمَّآ أَفَآءَ ٱللَّهُ",184],["33:50:53",424,"أَيْمَـٰنُهُمْ","they rightfully possess","أَزْوَٰجِهِمْ وَمَا مَلَكَتْ","لِكَيْلَا يَكُونَ عَلَيْكَ",184],["33:52:19",425,"يَمِينُكَ ۗ","you rightfully possess","إِلَّا مَا مَلَكَتْ","وَكَانَ ٱللَّهُ عَلَىٰ",184],["33:55:21",426,"أَيْمَـٰنُهُنَّ ۗ","they rightfully possess","وَلَا مَا مَلَكَتْ","وَٱتَّقِينَ ٱللَّهَ ۚ إِنَّ",184],["34:15:9",430,"يَمِينٍۢ","(the) right","ءَايَةٌۭ ۖ جَنَّتَانِ عَن","وَشِمَالٍۢ ۖ كُلُوا۟ مِن",184],["35:42:4",439,"أَيْمَـٰنِهِمْ","(of) their oaths","وَأَقْسَمُوا۟ بِٱللَّهِ جَهْدَ","لَئِن جَآءَهُمْ نَذِيرٌۭ",184],["37:28:6",447,"ٱلْيَمِينِ","the right","كُنتُمْ تَأْتُونَنَا عَنِ","",184],["37:93:4",449,"بِٱلْيَمِينِ","with the right hand","فَرَاغَ عَلَيْهِمْ ضَرْبًۢا","",184],["39:67:13",465,"بِيَمِينِهِۦ ۚ","in His Right Hand","ٱلْقِيَـٰمَةِ وَٱلسَّمَـٰوَٰتُ مَطْوِيَّـٰتٌۢ","سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ عَمَّا",184],["50:17:5",519,"ٱلْيَمِينِ","the right","يَتَلَقَّى ٱلْمُتَلَقِّيَانِ عَنِ","وَعَنِ ٱلشِّمَالِ قَعِيدٌۭ",184],["56:8:2",534,"ٱلْمَيْمَنَةِ","(of) the right","فَأَصْحَـٰبُ","مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",1894],["56:8:5",534,"ٱلْمَيْمَنَةِ","(of) the right","ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ","",1894],["56:27:2",535,"ٱلْيَمِينِ","(of) the right","وَأَصْحَـٰبُ","مَآ أَصْحَـٰبُ ٱلْيَمِينِ",184],["56:27:5",535,"ٱلْيَمِينِ","(of) the right","ٱلْيَمِينِ مَآ أَصْحَـٰبُ","",184],["56:38:2",535,"ٱلْيَمِينِ","(of) the right","لِّأَصْحَـٰبِ","",184],["56:90:6",537,"ٱلْيَمِينِ","(of) the right","كَانَ مِنْ أَصْحَـٰبِ","",184],["56:91:5",537,"ٱلْيَمِينِ","(of) the right","لَّكَ مِنْ أَصْحَـٰبِ","",184],["57:12:9",539,"وَبِأَيْمَـٰنِهِم","and on their right","نُورُهُم بَيْنَ أَيْدِيهِمْ","بُشْرَىٰكُمُ ٱلْيَوْمَ جَنَّـٰتٌۭ",184],["58:16:2",544,"أَيْمَـٰنَهُمْ","their oaths","ٱتَّخَذُوٓا۟","جُنَّةًۭ فَصَدُّوا۟ عَن",184],["63:2:2",554,"أَيْمَـٰنَهُمْ","their oaths","ٱتَّخَذُوٓا۟","جُنَّةًۭ فَصَدُّوا۟ عَن",184],["66:2:6",560,"أَيْمَـٰنِكُمْ ۚ","(of) your oaths","ٱللَّهُ لَكُمْ تَحِلَّةَ","وَٱللَّهُ مَوْلَىٰكُمْ ۖ وَهُوَ",184],["66:8:33",561,"وَبِأَيْمَـٰنِهِمْ","and on their right","يَسْعَىٰ بَيْنَ أَيْدِيهِمْ","يَقُولُونَ رَبَّنَآ أَتْمِمْ",184],["68:39:3",565,"أَيْمَـٰنٌ","oaths","أَمْ لَكُمْ","عَلَيْنَا بَـٰلِغَةٌ إِلَىٰ",184],["69:19:5",567,"بِيَمِينِهِۦ","in his right hand","مَنْ أُوتِىَ كِتَـٰبَهُۥ","فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟",184],["69:45:3",568,"بِٱلْيَمِينِ","by the right hand","لَأَخَذْنَا مِنْهُ","",184],["70:30:7",569,"أَيْمَـٰنُهُمْ","rightfully","أَوْ مَا مَلَكَتْ","فَإِنَّهُمْ غَيْرُ مَلُومِينَ",184],["70:37:2",569,"ٱلْيَمِينِ","the right","عَنِ","وَعَنِ ٱلشِّمَالِ عِزِينَ",184],["74:39:3",576,"ٱلْيَمِينِ","(of) the right","إِلَّآ أَصْحَـٰبَ","",184],["84:7:5",589,"بِيَمِينِهِۦ","in his right (hand)","مَنْ أُوتِىَ كِتَـٰبَهُۥ","",184],["90:18:3",594,"ٱلْمَيْمَنَةِ","(of) the right (hand)","أُو۟لَـٰٓئِكَ أَصْحَـٰبُ","",1894]]