[["2:90:10",14,"بَغْيًا","grudging","بِمَآ أَنزَلَ ٱللَّهُ","أَن يُنَزِّلَ ٱللَّهُ",778],["2:173:16",26,"بَاغٍۢ","(being) disobedient","فَمَنِ ٱضْطُرَّ غَيْرَ","وَلَا عَادٍۢ فَلَآ",1804],["2:187:26",29,"وَٱبْتَغُوا۟","and seek","عَنكُمْ ۖ فَٱلْـَٔـٰنَ بَـٰشِرُوهُنَّ","مَا كَتَبَ ٱللَّهُ",341],["2:198:5",31,"تَبْتَغُوا۟","you seek","عَلَيْكُمْ جُنَاحٌ أَن","فَضْلًۭا مِّن رَّبِّكُمْ ۚ",341],["2:207:6",32,"ٱبْتِغَآءَ","seeking","مَن يَشْرِى نَفْسَهُ","مَرْضَاتِ ٱللَّهِ ۗ وَٱللَّهُ",675],["2:213:31",33,"بَغْيًۢا","(out of) jealousy","مَا جَآءَتْهُمُ ٱلْبَيِّنَـٰتُ","بَيْنَهُمْ ۖ فَهَدَى ٱللَّهُ",778],["2:265:5",45,"ٱبْتِغَآءَ","seeking","ٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُمُ","مَرْضَاتِ ٱللَّهِ وَتَثْبِيتًۭا",675],["2:272:17",46,"ٱبْتِغَآءَ","seeking","وَمَا تُنفِقُونَ إِلَّا","وَجْهِ ٱللَّهِ ۚ وَمَا",675],["3:7:23",50,"ٱبْتِغَآءَ","seeking","مَا تَشَـٰبَهَ مِنْهُ","ٱلْفِتْنَةِ وَٱبْتِغَآءَ تَأْوِيلِهِۦ ۗ",675],["3:7:25",50,"وَٱبْتِغَآءَ","and seeking","مِنْهُ ٱبْتِغَآءَ ٱلْفِتْنَةِ","تَأْوِيلِهِۦ ۗ وَمَا يَعْلَمُ",675],["3:19:17",52,"بَغْيًۢا","out of envy","مَا جَآءَهُمُ ٱلْعِلْمُ","بَيْنَهُمْ ۗ وَمَن يَكْفُرْ",778],["3:83:4",60,"يَبْغُونَ","they seek","أَفَغَيْرَ دِينِ ٱللَّهِ","وَلَهُۥٓ أَسْلَمَ مَن",425],["3:85:2",61,"يَبْتَغِ","seeks","وَمَن","غَيْرَ ٱلْإِسْلَـٰمِ دِينًۭا",341],["3:99:11",62,"تَبْغُونَهَا","seeking (to make) it","ٱللَّهِ مَنْ ءَامَنَ","عِوَجًۭا وَأَنتُمْ شُهَدَآءُ ۗ",425],["4:24:17",82,"تَبْتَغُوا۟","you seek","وَرَآءَ ذَٰلِكُمْ أَن","بِأَمْوَٰلِكُم مُّحْصِنِينَ غَيْرَ",341],["4:34:33",84,"تَبْغُوا۟","seek","فَإِنْ أَطَعْنَكُمْ فَلَا","عَلَيْهِنَّ سَبِيلًا ۗ إِنَّ",425],["4:94:18",93,"تَبْتَغُونَ","seeking","ٱلسَّلَـٰمَ لَسْتَ مُؤْمِنًۭا","عَرَضَ ٱلْحَيَوٰةِ ٱلدُّنْيَا",341],["4:104:4",95,"ٱبْتِغَآءِ","pursuit","وَلَا تَهِنُوا۟ فِى","ٱلْقَوْمِ ۖ إِن تَكُونُوا۟",675],["4:114:20",97,"ٱبْتِغَآءَ","seeking","وَمَن يَفْعَلْ ذَٰلِكَ","مَرْضَاتِ ٱللَّهِ فَسَوْفَ",675],["4:139:8",100,"أَيَبْتَغُونَ","Do they seek","مِن دُونِ ٱلْمُؤْمِنِينَ ۚ","عِندَهُمُ ٱلْعِزَّةَ فَإِنَّ",341],["5:2:19",106,"يَبْتَغُونَ","seeking","ءَآمِّينَ ٱلْبَيْتَ ٱلْحَرَامَ","فَضْلًۭا مِّن رَّبِّهِمْ",341],["5:35:6",113,"وَٱبْتَغُوٓا۟","and seek","ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ","إِلَيْهِ ٱلْوَسِيلَةَ وَجَـٰهِدُوا۟",341],["5:50:3",116,"يَبْغُونَ ۚ","they seek","أَفَحُكْمَ ٱلْجَـٰهِلِيَّةِ","وَمَنْ أَحْسَنُ مِنَ",425],["6:35:9",131,"تَبْتَغِىَ","seek","فَإِنِ ٱسْتَطَعْتَ أَن","نَفَقًۭا فِى ٱلْأَرْضِ",341],["6:114:3",142,"أَبْتَغِى","I seek","أَفَغَيْرَ ٱللَّهِ","حَكَمًۭا وَهُوَ ٱلَّذِىٓ",341],["6:145:33",147,"بَاغٍۢ","desiring","فَمَنِ ٱضْطُرَّ غَيْرَ","وَلَا عَادٍۢ فَإِنَّ",1804],["6:146:26",147,"بِبَغْيِهِمْ ۖ","for their rebellion","بِعَظْمٍۢ ۚ ذَٰلِكَ جَزَيْنَـٰهُم","وَإِنَّا لَصَـٰدِقُونَ",778],["6:164:4",150,"أَبْغِى","I (should) seek","قُلْ أَغَيْرَ ٱللَّهِ","رَبًّۭا وَهُوَ رَبُّ",425],["7:33:12",154,"وَٱلْبَغْىَ","and the oppression","وَمَا بَطَنَ وَٱلْإِثْمَ","بِغَيْرِ ٱلْحَقِّ وَأَن",778],["7:45:6",156,"وَيَبْغُونَهَا","and seek in it","عَن سَبِيلِ ٱللَّهِ","عِوَجًۭا وَهُم بِٱلْـَٔاخِرَةِ",425],["7:86:13",161,"وَتَبْغُونَهَا","and seeking (to make) it","مَنْ ءَامَنَ بِهِۦ","عِوَجًۭا ۚ وَٱذْكُرُوٓا۟ إِذْ",425],["7:140:4",167,"أَبْغِيكُمْ","I seek for you","قَالَ أَغَيْرَ ٱللَّهِ","إِلَـٰهًۭا وَهُوَ فَضَّلَكُمْ",425],["9:47:10",194,"يَبْغُونَكُمُ","seeking (for) you","خَبَالًۭا وَلَأَوْضَعُوا۟ خِلَـٰلَكُمْ","ٱلْفِتْنَةَ وَفِيكُمْ سَمَّـٰعُونَ",425],["9:48:2",195,"ٱبْتَغَوُا۟","they had sought","لَقَدِ","ٱلْفِتْنَةَ مِن قَبْلُ",341],["10:23:5",211,"يَبْغُونَ","rebel","أَنجَىٰهُمْ إِذَا هُمْ","فِى ٱلْأَرْضِ بِغَيْرِ",425],["10:23:13",211,"بَغْيُكُمْ","your rebellion","يَـٰٓأَيُّهَا ٱلنَّاسُ إِنَّمَا","عَلَىٰٓ أَنفُسِكُم ۖ مَّتَـٰعَ",778],["10:90:8",219,"بَغْيًۭا","(in) rebellion","فَأَتْبَعَهُمْ فِرْعَوْنُ وَجُنُودُهُۥ","وَعَدْوًا ۖ حَتَّىٰٓ إِذَآ",778],["11:19:6",223,"وَيَبْغُونَهَا","and seek (in) it","عَن سَبِيلِ ٱللَّهِ","عِوَجًۭا وَهُم بِٱلْـَٔاخِرَةِ",425],["12:65:11",243,"نَبْغِى ۖ","(could) we desire","قَالُوا۟ يَـٰٓأَبَانَا مَا","هَـٰذِهِۦ بِضَـٰعَتُنَا رُدَّتْ",425],["13:17:17",251,"ٱبْتِغَآءَ","in order to make","عَلَيْهِ فِى ٱلنَّارِ","حِلْيَةٍ أَوْ مَتَـٰعٍۢ",675],["13:22:3",252,"ٱبْتِغَآءَ","seeking","وَٱلَّذِينَ صَبَرُوا۟","وَجْهِ رَبِّهِمْ وَأَقَامُوا۟",675],["14:3:11",255,"وَيَبْغُونَهَا","and seek in it","عَن سَبِيلِ ٱللَّهِ","عِوَجًا ۚ أُو۟لَـٰٓئِكَ فِى",425],["16:14:17",268,"وَلِتَبْتَغُوا۟","and that you may seek","ٱلْفُلْكَ مَوَاخِرَ فِيهِ","مِن فَضْلِهِۦ وَلَعَلَّكُمْ",341],["16:90:13",277,"وَٱلْبَغْىِ ۚ","and the oppression","عَنِ ٱلْفَحْشَآءِ وَٱلْمُنكَرِ","يَعِظُكُمْ لَعَلَّكُمْ تَذَكَّرُونَ",778],["16:115:16",280,"بَاغٍۢ","disobedient","فَمَنِ ٱضْطُرَّ غَيْرَ","وَلَا عَادٍۢ فَإِنَّ",1804],["17:12:12",283,"لِّتَبْتَغُوا۟","that you may seek","ءَايَةَ ٱلنَّهَارِ مُبْصِرَةًۭ","فَضْلًۭا مِّن رَّبِّكُمْ",341],["17:28:4",285,"ٱبْتِغَآءَ","seeking","وَإِمَّا تُعْرِضَنَّ عَنْهُمُ","رَحْمَةٍۢ مِّن رَّبِّكَ",675],["17:42:9",286,"لَّٱبْتَغَوْا۟","surely they (would) have sought","كَمَا يَقُولُونَ إِذًۭا","إِلَىٰ ذِى ٱلْعَرْشِ",341],["17:57:4",287,"يَبْتَغُونَ","seek","أُو۟لَـٰٓئِكَ ٱلَّذِينَ يَدْعُونَ","إِلَىٰ رَبِّهِمُ ٱلْوَسِيلَةَ",341],["17:66:8",288,"لِتَبْتَغُوا۟","that you may seek","ٱلْفُلْكَ فِى ٱلْبَحْرِ","مِن فَضْلِهِۦٓ ۚ إِنَّهُۥ",341],["17:110:19",293,"وَٱبْتَغِ","but seek","وَلَا تُخَافِتْ بِهَا","بَيْنَ ذَٰلِكَ سَبِيلًۭا",341],["18:64:5",301,"نَبْغِ ۚ","seeking","ذَٰلِكَ مَا كُنَّا","فَٱرْتَدَّا عَلَىٰٓ ءَاثَارِهِمَا",425],["18:108:4",304,"يَبْغُونَ","they will desire","خَـٰلِدِينَ فِيهَا لَا","عَنْهَا حِوَلًۭا",425],["19:20:11",306,"بَغِيًّۭا","unchaste","بَشَرٌۭ وَلَمْ أَكُ","",2332],["19:28:11",307,"بَغِيًّۭا","unchaste","وَمَا كَانَتْ أُمُّكِ","",2332],["19:92:2",311,"يَنۢبَغِى","is appropriate","وَمَا","لِلرَّحْمَـٰنِ أَن يَتَّخِذَ",1252],["22:60:9",339,"بُغِىَ","he was oppressed","عُوقِبَ بِهِۦ ثُمَّ","عَلَيْهِ لَيَنصُرَنَّهُ ٱللَّهُ ۗ",425],["23:7:2",342,"ٱبْتَغَىٰ","seeks","فَمَنِ","وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ",341],["24:33:12",354,"يَبْتَغُونَ","seek","مِن فَضْلِهِۦ ۗ وَٱلَّذِينَ","ٱلْكِتَـٰبَ مِمَّا مَلَكَتْ",341],["24:33:32",354,"ٱلْبِغَآءِ","[the] prostitution","تُكْرِهُوا۟ فَتَيَـٰتِكُمْ عَلَى","إِنْ أَرَدْنَ تَحَصُّنًۭا",3354],["24:33:36",354,"لِّتَبْتَغُوا۟","that you may seek","إِنْ أَرَدْنَ تَحَصُّنًۭا","عَرَضَ ٱلْحَيَوٰةِ ٱلدُّنْيَا ۚ",341],["25:18:5",361,"يَنۢبَغِى","it was proper","سُبْحَـٰنَكَ مَا كَانَ","لَنَآ أَن نَّتَّخِذَ",1252],["26:211:2",376,"يَنۢبَغِى","(it) suits","وَمَا","لَهُمْ وَمَا يَسْتَطِيعُونَ",1252],["28:55:14",392,"نَبْتَغِى","we seek","سَلَـٰمٌ عَلَيْكُمْ لَا","ٱلْجَـٰهِلِينَ",341],["28:73:9",394,"وَلِتَبْتَغُوا۟","and that you may seek","وَٱلنَّهَارَ لِتَسْكُنُوا۟ فِيهِ","مِن فَضْلِهِۦ وَلَعَلَّكُمْ",341],["28:76:7",394,"فَبَغَىٰ","but he oppressed","مِن قَوْمِ مُوسَىٰ","عَلَيْهِمْ ۖ وَءَاتَيْنَـٰهُ مِنَ",425],["28:77:1",394,"وَٱبْتَغِ","But seek","","فِيمَآ ءَاتَىٰكَ ٱللَّهُ",341],["28:77:18",394,"تَبْغِ","seek","ٱللَّهُ إِلَيْكَ ۖ وَلَا","ٱلْفَسَادَ فِى ٱلْأَرْضِ ۖ",425],["29:17:19",398,"فَٱبْتَغُوا۟","So seek","يَمْلِكُونَ لَكُمْ رِزْقًۭا","عِندَ ٱللَّهِ ٱلرِّزْقَ",341],["30:23:6",406,"وَٱبْتِغَآؤُكُم","[and] your seeking","مَنَامُكُم بِٱلَّيْلِ وَٱلنَّهَارِ","مِّن فَضْلِهِۦٓ ۚ إِنَّ",675],["30:46:13",409,"وَلِتَبْتَغُوا۟","and that you may seek","وَلِتَجْرِىَ ٱلْفُلْكُ بِأَمْرِهِۦ","مِن فَضْلِهِۦ وَلَعَلَّكُمْ",341],["33:51:10",425,"ٱبْتَغَيْتَ","you desire","مَن تَشَآءُ ۖ وَمَنِ","مِمَّنْ عَزَلْتَ فَلَا",341],["35:12:24",436,"لِتَبْتَغُوا۟","so that you may seek","ٱلْفُلْكَ فِيهِ مَوَاخِرَ","مِن فَضْلِهِۦ وَلَعَلَّكُمْ",341],["36:40:3",442,"يَنۢبَغِى","is permitted","لَا ٱلشَّمْسُ","لَهَآ أَن تُدْرِكَ",1252],["36:69:5",444,"يَنۢبَغِى","it is befitting","عَلَّمْنَـٰهُ ٱلشِّعْرَ وَمَا","لَهُۥٓ ۚ إِنْ هُوَ",1252],["38:22:11",454,"بَغَىٰ","has wronged","لَا تَخَفْ ۖ خَصْمَانِ","بَعْضُنَا عَلَىٰ بَعْضٍۢ",425],["38:24:12",454,"لَيَبْغِى","certainly oppress","كَثِيرًۭا مِّنَ ٱلْخُلَطَآءِ","بَعْضُهُمْ عَلَىٰ بَعْضٍ",425],["38:35:9",455,"يَنۢبَغِى","(will) belong","لِى مُلْكًۭا لَّا","لِأَحَدٍۢ مِّنۢ بَعْدِىٓ ۖ",1252],["42:14:9",484,"بَغْيًۢا","(out of) rivalry","مَا جَآءَهُمُ ٱلْعِلْمُ","بَيْنَهُمْ ۚ وَلَوْلَا كَلِمَةٌۭ",778],["42:27:6",486,"لَبَغَوْا۟","surely they would rebel","ٱللَّهُ ٱلرِّزْقَ لِعِبَادِهِۦ","فِى ٱلْأَرْضِ وَلَـٰكِن",425],["42:39:4",487,"ٱلْبَغْىُ","tyranny","وَٱلَّذِينَ إِذَآ أَصَابَهُمُ","هُمْ يَنتَصِرُونَ",778],["42:42:7",487,"وَيَبْغُونَ","and rebel","ٱلَّذِينَ يَظْلِمُونَ ٱلنَّاسَ","فِى ٱلْأَرْضِ بِغَيْرِ",425],["45:12:10",499,"وَلِتَبْتَغُوا۟","and that you may seek","ٱلْفُلْكُ فِيهِ بِأَمْرِهِۦ","مِن فَضْلِهِۦ وَلَعَلَّكُمْ",341],["45:17:13",500,"بَغْيًۢا","(out of) envy","مَا جَآءَهُمُ ٱلْعِلْمُ","بَيْنَهُمْ ۚ إِنَّ رَبَّكَ",778],["48:29:14",515,"يَبْتَغُونَ","seeking","تَرَىٰهُمْ رُكَّعًۭا سُجَّدًۭا","فَضْلًۭا مِّنَ ٱللَّهِ",341],["49:9:9",516,"بَغَتْ","oppresses","فَأَصْلِحُوا۟ بَيْنَهُمَا ۖ فَإِنۢ","إِحْدَىٰهُمَا عَلَى ٱلْأُخْرَىٰ",425],["49:9:15",516,"تَبْغِى","oppresses","ٱلْأُخْرَىٰ فَقَـٰتِلُوا۟ ٱلَّتِى","حَتَّىٰ تَفِىٓءَ إِلَىٰٓ",425],["55:20:4",532,"يَبْغِيَانِ","they transgress","بَيْنَهُمَا بَرْزَخٌۭ لَّا","",425],["57:27:25",541,"ٱبْتِغَآءَ","seeking","كَتَبْنَـٰهَا عَلَيْهِمْ إِلَّا","رِضْوَٰنِ ٱللَّهِ فَمَا",675],["59:8:8",546,"يَبْتَغُونَ","seeking","مِن دِيَـٰرِهِمْ وَأَمْوَٰلِهِمْ","فَضْلًۭا مِّنَ ٱللَّهِ",341],["60:1:31",549,"وَٱبْتِغَآءَ","and (to) seek","جِهَـٰدًۭا فِى سَبِيلِى","مَرْضَاتِى ۚ تُسِرُّونَ إِلَيْهِم",675],["62:10:7",554,"وَٱبْتَغُوا۟","and seek","فَٱنتَشِرُوا۟ فِى ٱلْأَرْضِ","مِن فَضْلِ ٱللَّهِ",341],["66:1:9",560,"تَبْتَغِى","seeking","أَحَلَّ ٱللَّهُ لَكَ ۖ","مَرْضَاتَ أَزْوَٰجِكَ ۚ وَٱللَّهُ",341],["70:31:2",569,"ٱبْتَغَىٰ","seeks","فَمَنِ","وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ",341],["73:20:40",575,"يَبْتَغُونَ","seeking","يَضْرِبُونَ فِى ٱلْأَرْضِ","مِن فَضْلِ ٱللَّهِ ۙ",341],["92:20:2",596,"ٱبْتِغَآءَ","seeking","إِلَّا","وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",675]]