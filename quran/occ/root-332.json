[["2:57:6",8,"ٱلْمَنَّ","[the] manna","ٱلْغَمَامَ وَأَنزَلْنَا عَلَيْكُمُ","وَٱلسَّلْوَىٰ ۖ كُلُوا۟ مِن",1196],["2:262:12",44,"مَنًّۭا","(with) reminders of generosity","يُتْبِعُونَ مَآ أَنفَقُوا۟","وَلَآ أَذًۭى ۙ لَّهُمْ",1196],["2:264:7",44,"بِٱلْمَنِّ","with reminders (of it)","لَا تُبْطِلُوا۟ صَدَقَـٰتِكُم","وَٱلْأَذَىٰ كَٱلَّذِى يُنفِقُ",1196],["3:164:2",71,"مَنَّ","bestowed a Favor","لَقَدْ","ٱللَّهُ عَلَى ٱلْمُؤْمِنِينَ",597],["4:94:30",93,"فَمَنَّ","then conferred favor","كُنتُم مِّن قَبْلُ","ٱللَّهُ عَلَيْكُمْ فَتَبَيَّنُوٓا۟ ۚ",597],["6:53:7",134,"مَنَّ","(whom has been) favored","بِبَعْضٍۢ لِّيَقُولُوٓا۟ أَهَـٰٓؤُلَآءِ","ٱللَّهُ عَلَيْهِم مِّنۢ",597],["7:160:31",171,"ٱلْمَنَّ","the manna","ٱلْغَمَـٰمَ وَأَنزَلْنَا عَلَيْهِمُ","وَٱلسَّلْوَىٰ ۖ كُلُوا۟ مِن",1196],["12:90:11",246,"مَنَّ","Allah has been gracious","وَهَـٰذَآ أَخِى ۖ قَدْ","ٱللَّهُ عَلَيْنَآ ۖ إِنَّهُۥ",597],["14:11:11",257,"يَمُنُّ","bestows His Grace","مِّثْلُكُمْ وَلَـٰكِنَّ ٱللَّهَ","عَلَىٰ مَن يَشَآءُ",597],["20:37:2",313,"مَنَنَّا","We conferred a favor","وَلَقَدْ","عَلَيْكَ مَرَّةً أُخْرَىٰٓ",597],["20:80:13",317,"ٱلْمَنَّ","the Manna","ٱلْأَيْمَنَ وَنَزَّلْنَا عَلَيْكُمُ","وَٱلسَّلْوَىٰ",1196],["26:22:3",368,"تَمُنُّهَا","with which you reproach","وَتِلْكَ نِعْمَةٌۭ","عَلَىَّ أَنْ عَبَّدتَّ",597],["28:5:3",385,"نَّمُنَّ","bestow a favor","وَنُرِيدُ أَن","عَلَى ٱلَّذِينَ ٱسْتُضْعِفُوا۟",597],["28:82:18",395,"مَّنَّ","Allah had favored","وَيَقْدِرُ ۖ لَوْلَآ أَن","ٱللَّهُ عَلَيْنَا لَخَسَفَ",597],["37:114:2",450,"مَنَنَّا","We conferred Favor","وَلَقَدْ","عَلَىٰ مُوسَىٰ وَهَـٰرُونَ",597],["38:39:3",455,"فَٱمْنُنْ","so grant","هَـٰذَا عَطَآؤُنَا","أَوْ أَمْسِكْ بِغَيْرِ",597],["41:8:9",477,"مَمْنُونٍۢ","never ending","لَهُمْ أَجْرٌ غَيْرُ","",1578],["47:4:13",507,"مَنًّۢا","a favor","فَشُدُّوا۟ ٱلْوَثَاقَ فَإِمَّا","بَعْدُ وَإِمَّا فِدَآءً",1196],["49:17:1",517,"يَمُنُّونَ","They consider (it) a favor","","عَلَيْكَ أَنْ أَسْلَمُوا۟ ۖ",597],["49:17:7",517,"تَمُنُّوا۟","consider a favor","أَسْلَمُوا۟ ۖ قُل لَّا","عَلَىَّ إِسْلَـٰمَكُم ۖ بَلِ",597],["49:17:12",517,"يَمُنُّ","has conferred a favor","إِسْلَـٰمَكُم ۖ بَلِ ٱللَّهُ","عَلَيْكُمْ أَنْ هَدَىٰكُمْ",597],["52:27:1",524,"فَمَنَّ","But Allah conferred favor","","ٱللَّهُ عَلَيْنَا وَوَقَىٰنَا",597],["52:30:7",524,"ٱلْمَنُونِ","a misfortune of time","نَّتَرَبَّصُ بِهِۦ رَيْبَ","",3691],["68:3:5",564,"مَمْنُونٍۢ","end","لَكَ لَأَجْرًا غَيْرَ","",1578],["74:6:2",575,"تَمْنُن","confer favor","وَلَا","تَسْتَكْثِرُ",597],["84:25:9",590,"مَمْنُونٍۭ","ending","لَهُمْ أَجْرٌ غَيْرُ","",1578],["95:6:9",597,"مَمْنُونٍۢ","ending","فَلَهُمْ أَجْرٌ غَيْرُ","",1578]]