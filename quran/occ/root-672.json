[["2:282:32",48,"يَبْخَسْ","diminish","ٱللَّهَ رَبَّهُۥ وَلَا","مِنْهُ شَيْـًۭٔا ۚ فَإِن",1430],["7:85:23",161,"تَبْخَسُوا۟","deprive","ٱلْكَيْلَ وَٱلْمِيزَانَ وَلَا","ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا",1430],["11:15:14",223,"يُبْخَسُونَ","will not be lessened","وَهُمْ فِيهَا لَا","",1430],["11:85:7",231,"تَبْخَسُوا۟","deprive","وَٱلْمِيزَانَ بِٱلْقِسْطِ ۖ وَلَا","ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا",1430],["12:20:3",237,"بَخْسٍۢ","very low","وَشَرَوْهُ بِثَمَنٍۭ","دَرَٰهِمَ مَعْدُودَةٍۢ وَكَانُوا۟",2340],["26:183:2",374,"تَبْخَسُوا۟","deprive","وَلَا","ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا",1430],["72:13:12",572,"بَخْسًۭا","any loss","بِرَبِّهِۦ فَلَا يَخَافُ","وَلَا رَهَقًۭا",2340]]