[["2:22:12",4,"فَأَخْرَجَ","then brought forth","مِنَ ٱلسَّمَآءِ مَآءًۭ","بِهِۦ مِنَ ٱلثَّمَرَٰتِ",111],["2:36:4",6,"فَأَخْرَجَهُمَا","and he got [both of] them out","فَأَزَلَّهُمَا ٱلشَّيْطَـٰنُ عَنْهَا","مِمَّا كَانَا فِيهِ ۖ",111],["2:61:12",9,"يُخْرِجْ","to bring forth","فَٱدْعُ لَنَا رَبَّكَ","لَنَا مِمَّا تُنۢبِتُ",111],["2:72:7",11,"مُخْرِجٌۭ","(is) the One Who brought forth","فَٱدَّٰرَْٰٔتُمْ فِيهَا ۖ وَٱللَّهُ","مَّا كُنتُمْ تَكْتُمُونَ",1918],["2:74:23",11,"فَيَخْرُجُ","so comes out","مِنْهَا لَمَا يَشَّقَّقُ","مِنْهُ ٱلْمَآءُ ۚ وَإِنَّ",225],["2:84:8",13,"تُخْرِجُونَ","(will) evict","تَسْفِكُونَ دِمَآءَكُمْ وَلَا","أَنفُسَكُم مِّن دِيَـٰرِكُمْ",111],["2:85:6",13,"وَتُخْرِجُونَ","and evict","هَـٰٓؤُلَآءِ تَقْتُلُونَ أَنفُسَكُمْ","فَرِيقًۭا مِّنكُم مِّن",111],["2:85:22",13,"إِخْرَاجُهُمْ ۚ","their eviction","وَهُوَ مُحَرَّمٌ عَلَيْكُمْ","أَفَتُؤْمِنُونَ بِبَعْضِ ٱلْكِتَـٰبِ",1134],["2:149:3",23,"خَرَجْتَ","you start forth","وَمِنْ حَيْثُ","فَوَلِّ وَجْهَكَ شَطْرَ",225],["2:150:3",23,"خَرَجْتَ","you start forth","وَمِنْ حَيْثُ","فَوَلِّ وَجْهَكَ شَطْرَ",225],["2:167:21",25,"بِخَـٰرِجِينَ","will come out","عَلَيْهِمْ ۖ وَمَا هُم","مِنَ ٱلنَّارِ",2035],["2:191:4",30,"وَأَخْرِجُوهُم","and drive them out","وَٱقْتُلُوهُمْ حَيْثُ ثَقِفْتُمُوهُمْ","مِّنْ حَيْثُ أَخْرَجُوكُمْ ۚ",111],["2:191:7",30,"أَخْرَجُوكُمْ ۚ","they drove you out","وَأَخْرِجُوهُم مِّنْ حَيْثُ","وَٱلْفِتْنَةُ أَشَدُّ مِنَ",111],["2:217:19",34,"وَإِخْرَاجُ","and driving out","بِهِۦ وَٱلْمَسْجِدِ ٱلْحَرَامِ","أَهْلِهِۦ مِنْهُ أَكْبَرُ",1134],["2:240:12",39,"إِخْرَاجٍۢ ۚ","driving (them) out","إِلَى ٱلْحَوْلِ غَيْرَ","فَإِنْ خَرَجْنَ فَلَا",1134],["2:240:14",39,"خَرَجْنَ","they leave","غَيْرَ إِخْرَاجٍۢ ۚ فَإِنْ","فَلَا جُنَاحَ عَلَيْكُمْ",225],["2:243:5",39,"خَرَجُوا۟","went out","تَرَ إِلَى ٱلَّذِينَ","مِن دِيَـٰرِهِمْ وَهُمْ",225],["2:246:40",40,"أُخْرِجْنَا","we have been driven","سَبِيلِ ٱللَّهِ وَقَدْ","مِن دِيَـٰرِنَا وَأَبْنَآئِنَا ۖ",111],["2:257:5",43,"يُخْرِجُهُم","He brings them out","وَلِىُّ ٱلَّذِينَ ءَامَنُوا۟","مِّنَ ٱلظُّلُمَـٰتِ إِلَى",111],["2:257:14",43,"يُخْرِجُونَهُم","they bring them out","كَفَرُوٓا۟ أَوْلِيَآؤُهُمُ ٱلطَّـٰغُوتُ","مِّنَ ٱلنُّورِ إِلَى",111],["2:267:10",45,"أَخْرَجْنَا","We brought forth","مَا كَسَبْتُمْ وَمِمَّآ","لَكُم مِّنَ ٱلْأَرْضِ ۖ",111],["3:27:9",53,"وَتُخْرِجُ","and You bring forth","ٱلنَّهَارَ فِى ٱلَّيْلِ ۖ","ٱلْحَىَّ مِنَ ٱلْمَيِّتِ",111],["3:27:13",53,"وَتُخْرِجُ","and You bring forth","ٱلْحَىَّ مِنَ ٱلْمَيِّتِ","ٱلْمَيِّتَ مِنَ ٱلْحَىِّ ۖ",111],["3:110:4",64,"أُخْرِجَتْ","raised","كُنتُمْ خَيْرَ أُمَّةٍ","لِلنَّاسِ تَأْمُرُونَ بِٱلْمَعْرُوفِ",111],["3:195:19",76,"وَأُخْرِجُوا۟","and were driven out","بَعْضٍۢ ۖ فَٱلَّذِينَ هَاجَرُوا۟","مِن دِيَـٰرِهِمْ وَأُوذُوا۟",111],["4:66:9",89,"ٱخْرُجُوا۟","Go forth","ٱقْتُلُوٓا۟ أَنفُسَكُمْ أَوِ","مِن دِيَـٰرِكُم مَّا",225],["4:75:16",90,"أَخْرِجْنَا","take us out","ٱلَّذِينَ يَقُولُونَ رَبَّنَآ","مِنْ هَـٰذِهِ ٱلْقَرْيَةِ",111],["4:100:13",94,"يَخْرُجْ","leaves","كَثِيرًۭا وَسَعَةًۭ ۚ وَمَن","مِنۢ بَيْتِهِۦ مُهَاجِرًا",225],["5:16:9",110,"وَيُخْرِجُهُم","and brings them out","رِضْوَٰنَهُۥ سُبُلَ ٱلسَّلَـٰمِ","مِّنَ ٱلظُّلُمَـٰتِ إِلَى",111],["5:22:11",111,"يَخْرُجُوا۟","they leave","لَن نَّدْخُلَهَا حَتَّىٰ","مِنْهَا فَإِن يَخْرُجُوا۟",225],["5:22:14",111,"يَخْرُجُوا۟","they leave","يَخْرُجُوا۟ مِنْهَا فَإِن","مِنْهَا فَإِنَّا دَٰخِلُونَ",225],["5:37:3",114,"يَخْرُجُوا۟","they come out","يُرِيدُونَ أَن","مِنَ ٱلنَّارِ وَمَا",225],["5:37:8",114,"بِخَـٰرِجِينَ","will come out","ٱلنَّارِ وَمَا هُم","مِنْهَا ۖ وَلَهُمْ عَذَابٌۭ",2035],["5:61:10",118,"خَرَجُوا۟","went out","بِٱلْكُفْرِ وَهُمْ قَدْ","بِهِۦ ۚ وَٱللَّهُ أَعْلَمُ",225],["5:110:44",126,"تُخْرِجُ","you bring forth","وَٱلْأَبْرَصَ بِإِذْنِى ۖ وَإِذْ","ٱلْمَوْتَىٰ بِإِذْنِى ۖ وَإِذْ",111],["6:93:33",139,"أَخْرِجُوٓا۟","Discharge","وَٱلْمَلَـٰٓئِكَةُ بَاسِطُوٓا۟ أَيْدِيهِمْ","أَنفُسَكُمُ ۖ ٱلْيَوْمَ تُجْزَوْنَ",111],["6:95:6",140,"يُخْرِجُ","He brings forth","فَالِقُ ٱلْحَبِّ وَٱلنَّوَىٰ ۖ","ٱلْحَىَّ مِنَ ٱلْمَيِّتِ",111],["6:95:10",140,"وَمُخْرِجُ","and brings forth","ٱلْحَىَّ مِنَ ٱلْمَيِّتِ","ٱلْمَيِّتِ مِنَ ٱلْحَىِّ ۚ",1918],["6:99:7",140,"فَأَخْرَجْنَا","then We bring forth","مِنَ ٱلسَّمَآءِ مَآءًۭ","بِهِۦ نَبَاتَ كُلِّ",111],["6:99:12",140,"فَأَخْرَجْنَا","Then We bring forth","نَبَاتَ كُلِّ شَىْءٍۢ","مِنْهُ خَضِرًۭا نُّخْرِجُ",111],["6:99:15",140,"نُّخْرِجُ","We bring forth","فَأَخْرَجْنَا مِنْهُ خَضِرًۭا","مِنْهُ حَبًّۭا مُّتَرَاكِبًۭا",111],["6:122:17",143,"بِخَارِجٍۢ","he comes out","فِى ٱلظُّلُمَـٰتِ لَيْسَ","مِّنْهَا ۚ كَذَٰلِكَ زُيِّنَ",2035],["6:148:28",148,"فَتُخْرِجُوهُ","then produce it","عِندَكُم مِّنْ عِلْمٍۢ","لَنَآ ۖ إِن تَتَّبِعُونَ",111],["7:13:10",152,"فَٱخْرُجْ","So get out","أَن تَتَكَبَّرَ فِيهَا","إِنَّكَ مِنَ ٱلصَّـٰغِرِينَ",225],["7:18:2",152,"ٱخْرُجْ","Get out","قَالَ","مِنْهَا مَذْءُومًۭا مَّدْحُورًۭا ۖ",225],["7:25:7",153,"تُخْرَجُونَ","you will be brought forth","وَفِيهَا تَمُوتُونَ وَمِنْهَا","",111],["7:27:7",153,"أَخْرَجَ","he drove out","يَفْتِنَنَّكُمُ ٱلشَّيْطَـٰنُ كَمَآ","أَبَوَيْكُم مِّنَ ٱلْجَنَّةِ",111],["7:32:7",154,"أَخْرَجَ","He has brought forth","زِينَةَ ٱللَّهِ ٱلَّتِىٓ","لِعِبَادِهِۦ وَٱلطَّيِّبَـٰتِ مِنَ",111],["7:57:20",157,"فَأَخْرَجْنَا","then We bring forth","فَأَنزَلْنَا بِهِ ٱلْمَآءَ","بِهِۦ مِن كُلِّ",111],["7:57:26",157,"نُخْرِجُ","We will bring forth","كُلِّ ٱلثَّمَرَٰتِ ۚ كَذَٰلِكَ","ٱلْمَوْتَىٰ لَعَلَّكُمْ تَذَكَّرُونَ",111],["7:58:3",158,"يَخْرُجُ","comes forth","وَٱلْبَلَدُ ٱلطَّيِّبُ","نَبَاتُهُۥ بِإِذْنِ رَبِّهِۦ ۖ",225],["7:58:10",158,"يَخْرُجُ","come forth","وَٱلَّذِى خَبُثَ لَا","إِلَّا نَكِدًۭا ۚ كَذَٰلِكَ",225],["7:82:8",161,"أَخْرِجُوهُم","Drive them out","إِلَّآ أَن قَالُوٓا۟","مِّن قَرْيَتِكُمْ ۖ إِنَّهُمْ",111],["7:88:7",162,"لَنُخْرِجَنَّكَ","We will surely drive you out","ٱسْتَكْبَرُوا۟ مِن قَوْمِهِۦ","يَـٰشُعَيْبُ وَٱلَّذِينَ ءَامَنُوا۟",111],["7:110:3",164,"يُخْرِجَكُم","drive you out","يُرِيدُ أَن","مِّنْ أَرْضِكُمْ ۖ فَمَاذَا",111],["7:123:15",165,"لِتُخْرِجُوا۟","so that you may drive out","مَّكَرْتُمُوهُ فِى ٱلْمَدِينَةِ","مِنْهَآ أَهْلَهَا ۖ فَسَوْفَ",111],["8:5:2",177,"أَخْرَجَكَ","brought you out","كَمَآ","رَبُّكَ مِنۢ بَيْتِكَ",111],["8:30:10",180,"يُخْرِجُوكَ ۚ","drive you out","أَوْ يَقْتُلُوكَ أَوْ","وَيَمْكُرُونَ وَيَمْكُرُ ٱللَّهُ ۖ",111],["8:47:4",183,"خَرَجُوا۟","came forth","وَلَا تَكُونُوا۟ كَٱلَّذِينَ","مِن دِيَـٰرِهِم بَطَرًۭا",225],["9:13:7",188,"بِإِخْرَاجِ","to drive out","نَّكَثُوٓا۟ أَيْمَـٰنَهُمْ وَهَمُّوا۟","ٱلرَّسُولِ وَهُم بَدَءُوكُمْ",1134],["9:40:7",193,"أَخْرَجَهُ","drove him out","نَصَرَهُ ٱللَّهُ إِذْ","ٱلَّذِينَ كَفَرُوا۟ ثَانِىَ",111],["9:42:16",194,"لَخَرَجْنَا","certainly we (would) have come forth","بِٱللَّهِ لَوِ ٱسْتَطَعْنَا","مَعَكُمْ يُهْلِكُونَ أَنفُسَهُمْ",225],["9:46:3",194,"ٱلْخُرُوجَ","(to) go forth","۞ وَلَوْ أَرَادُوا۟","لَأَعَدُّوا۟ لَهُۥ عُدَّةًۭ",1425],["9:47:2",194,"خَرَجُوا۟","they (had) gone forth","لَوْ","فِيكُم مَّا زَادُوكُمْ",225],["9:64:15",197,"مُخْرِجٌۭ","(will) bring forth","ٱسْتَهْزِءُوٓا۟ إِنَّ ٱللَّهَ","مَّا تَحْذَرُونَ",1918],["9:83:8",200,"لِلْخُرُوجِ","to go out","طَآئِفَةٍۢ مِّنْهُمْ فَٱسْتَـْٔذَنُوكَ","فَقُل لَّن تَخْرُجُوا۟",1425],["9:83:11",200,"تَخْرُجُوا۟","will you come out","لِلْخُرُوجِ فَقُل لَّن","مَعِىَ أَبَدًۭا وَلَن",225],["10:31:12",212,"يُخْرِجُ","brings out","ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ وَمَن","ٱلْحَىَّ مِنَ ٱلْمَيِّتِ",111],["10:31:16",212,"وَيُخْرِجُ","and brings forth","ٱلْحَىَّ مِنَ ٱلْمَيِّتِ","ٱلْمَيِّتَ مِنَ ٱلْحَىِّ",111],["12:31:15",239,"ٱخْرُجْ","Come out","مِّنْهُنَّ سِكِّينًۭا وَقَالَتِ","عَلَيْهِنَّ ۖ فَلَمَّا رَأَيْنَهُۥٓ",225],["12:76:7",244,"ٱسْتَخْرَجَهَا","he brought it out","وِعَآءِ أَخِيهِ ثُمَّ","مِن وِعَآءِ أَخِيهِ ۚ",1702],["12:100:23",247,"أَخْرَجَنِى","He took me out","أَحْسَنَ بِىٓ إِذْ","مِنَ ٱلسِّجْنِ وَجَآءَ",111],["14:1:5",255,"لِتُخْرِجَ","so that you may bring out","كِتَـٰبٌ أَنزَلْنَـٰهُ إِلَيْكَ","ٱلنَّاسَ مِنَ ٱلظُّلُمَـٰتِ",111],["14:5:6",255,"أَخْرِجْ","Bring out","مُوسَىٰ بِـَٔايَـٰتِنَآ أَنْ","قَوْمَكَ مِنَ ٱلظُّلُمَـٰتِ",111],["14:13:5",257,"لَنُخْرِجَنَّكُم","Surely we will drive you out","ٱلَّذِينَ كَفَرُوا۟ لِرُسُلِهِمْ","مِّنْ أَرْضِنَآ أَوْ",111],["14:32:10",259,"فَأَخْرَجَ","then brought forth","مِنَ ٱلسَّمَآءِ مَآءًۭ","بِهِۦ مِنَ ٱلثَّمَرَٰتِ",111],["15:34:2",264,"فَٱخْرُجْ","Then get out","قَالَ","مِنْهَا فَإِنَّكَ رَجِيمٌۭ",225],["15:48:8",264,"بِمُخْرَجِينَ","will be removed","وَمَا هُم مِّنْهَا","",1368],["16:14:9",268,"وَتَسْتَخْرِجُوا۟","and that you bring forth","مِنْهُ لَحْمًۭا طَرِيًّۭا","مِنْهُ حِلْيَةًۭ تَلْبَسُونَهَا",1702],["16:69:10",274,"يَخْرُجُ","Comes forth","سُبُلَ رَبِّكِ ذُلُلًۭا ۚ","مِنۢ بُطُونِهَا شَرَابٌۭ",225],["16:78:2",275,"أَخْرَجَكُم","brought you forth","وَٱللَّهُ","مِّنۢ بُطُونِ أُمَّهَـٰتِكُمْ",111],["17:13:7",283,"وَنُخْرِجُ","and We will bring forth","طَـٰٓئِرَهُۥ فِى عُنُقِهِۦ ۖ","لَهُۥ يَوْمَ ٱلْقِيَـٰمَةِ",111],["17:76:6",290,"لِيُخْرِجُوكَ","that they evict you","لَيَسْتَفِزُّونَكَ مِنَ ٱلْأَرْضِ","مِنْهَا ۖ وَإِذًۭا لَّا",111],["17:80:6",290,"وَأَخْرِجْنِى","and cause me to exit","أَدْخِلْنِى مُدْخَلَ صِدْقٍۢ","مُخْرَجَ صِدْقٍۢ وَٱجْعَل",111],["17:80:7",290,"مُخْرَجَ","an exit","مُدْخَلَ صِدْقٍۢ وَأَخْرِجْنِى","صِدْقٍۢ وَٱجْعَل لِّى",1368],["18:5:10",294,"تَخْرُجُ","(that) comes out","لِـَٔابَآئِهِمْ ۚ كَبُرَتْ كَلِمَةًۭ","مِنْ أَفْوَٰهِهِمْ ۚ إِن",225],["18:82:20",302,"وَيَسْتَخْرِجَا","and bring forth","أَن يَبْلُغَآ أَشُدَّهُمَا","كَنزَهُمَا رَحْمَةًۭ مِّن",1702],["18:94:13",303,"خَرْجًا","an expenditure","فَهَلْ نَجْعَلُ لَكَ","عَلَىٰٓ أَن تَجْعَلَ",2740],["19:11:1",305,"فَخَرَجَ","Then he came out","","عَلَىٰ قَوْمِهِۦ مِنَ",225],["19:66:7",310,"أُخْرَجُ","I be brought forth","مَا مِتُّ لَسَوْفَ","حَيًّا",111],["20:22:5",313,"تَخْرُجْ","it will come out","يَدَكَ إِلَىٰ جَنَاحِكَ","بَيْضَآءَ مِنْ غَيْرِ",225],["20:53:14",315,"فَأَخْرَجْنَا","then We (have) brought forth","مِنَ ٱلسَّمَآءِ مَآءًۭ","بِهِۦٓ أَزْوَٰجًۭا مِّن",111],["20:55:6",315,"نُخْرِجُكُمْ","We will bring you out","وَفِيهَا نُعِيدُكُمْ وَمِنْهَا","تَارَةً أُخْرَىٰ",111],["20:57:3",315,"لِتُخْرِجَنَا","to drive us out","قَالَ أَجِئْتَنَا","مِنْ أَرْضِنَا بِسِحْرِكَ",111],["20:63:7",315,"يُخْرِجَاكُم","they drive you out","لَسَـٰحِرَٰنِ يُرِيدَانِ أَن","مِّنْ أَرْضِكُم بِسِحْرِهِمَا",111],["20:88:1",318,"فَأَخْرَجَ","Then he brought forth","","لَهُمْ عِجْلًۭا جَسَدًۭا",111],["20:117:9",320,"يُخْرِجَنَّكُمَا","(let) him drive you both","لَّكَ وَلِزَوْجِكَ فَلَا","مِنَ ٱلْجَنَّةِ فَتَشْقَىٰٓ",111],["22:5:36",332,"نُخْرِجُكُمْ","We bring you out","أَجَلٍۢ مُّسَمًّۭى ثُمَّ","طِفْلًۭا ثُمَّ لِتَبْلُغُوٓا۟",111],["22:22:4",334,"يَخْرُجُوا۟","come out","كُلَّمَآ أَرَادُوٓا۟ أَن","مِنْهَا مِنْ غَمٍّ",225],["22:40:2",337,"أُخْرِجُوا۟","have been evicted","ٱلَّذِينَ","مِن دِيَـٰرِهِم بِغَيْرِ",111],["23:20:2",343,"تَخْرُجُ","(that) springs forth","وَشَجَرَةًۭ","مِن طُورِ سَيْنَآءَ",225],["23:35:9",344,"مُّخْرَجُونَ","(will be) brought forth","تُرَابًۭا وَعِظَـٰمًا أَنَّكُم","",1368],["23:72:3",346,"خَرْجًۭا","(for) a payment","أَمْ تَسْـَٔلُهُمْ","فَخَرَاجُ رَبِّكَ خَيْرٌۭ ۖ",2740],["23:72:4",346,"فَخَرَاجُ","But the payment","أَمْ تَسْـَٔلُهُمْ خَرْجًۭا","رَبِّكَ خَيْرٌۭ ۖ وَهُوَ",4578],["23:107:2",349,"أَخْرِجْنَا","Bring us out","رَبَّنَآ","مِنْهَا فَإِنْ عُدْنَا",111],["24:40:19",355,"أَخْرَجَ","he puts out","فَوْقَ بَعْضٍ إِذَآ","يَدَهُۥ لَمْ يَكَدْ",111],["24:43:15",355,"يَخْرُجُ","come forth","رُكَامًۭا فَتَرَى ٱلْوَدْقَ","مِنْ خِلَـٰلِهِۦ وَيُنَزِّلُ",225],["24:53:7",356,"لَيَخْرُجُنَّ ۖ","surely they (would) go forth","أَيْمَـٰنِهِمْ لَئِنْ أَمَرْتَهُمْ","قُل لَّا تُقْسِمُوا۟ ۖ",225],["26:35:3",368,"يُخْرِجَكُم","drive you out","يُرِيدُ أَن","مِّنْ أَرْضِكُم بِسِحْرِهِۦ",111],["26:57:1",369,"فَأَخْرَجْنَـٰهُم","So We expelled them","","مِّن جَنَّـٰتٍۢ وَعُيُونٍۢ",111],["26:167:8",374,"ٱلْمُخْرَجِينَ","the ones driven out","يَـٰلُوطُ لَتَكُونَنَّ مِنَ","",1368],["27:12:5",377,"تَخْرُجْ","it will come forth","يَدَكَ فِى جَيْبِكَ","بَيْضَآءَ مِنْ غَيْرِ",225],["27:25:5",379,"يُخْرِجُ","brings forth","يَسْجُدُوا۟ لِلَّهِ ٱلَّذِى","ٱلْخَبْءَ فِى ٱلسَّمَـٰوَٰتِ",111],["27:37:9",380,"وَلَنُخْرِجَنَّهُم","and surely, we will drive them out","قِبَلَ لَهُم بِهَا","مِّنْهَآ أَذِلَّةًۭ وَهُمْ",111],["27:56:8",382,"أَخْرِجُوٓا۟","Drive out","إِلَّآ أَن قَالُوٓا۟","ءَالَ لُوطٍۢ مِّن",111],["27:67:9",383,"لَمُخْرَجُونَ","surely be brought out","تُرَٰبًۭا وَءَابَآؤُنَآ أَئِنَّا","",1368],["27:82:5",384,"أَخْرَجْنَا","We will bring forth","وَقَعَ ٱلْقَوْلُ عَلَيْهِمْ","لَهُمْ دَآبَّةًۭ مِّنَ",111],["28:20:14",387,"فَٱخْرُجْ","so leave","يَأْتَمِرُونَ بِكَ لِيَقْتُلُوكَ","إِنِّى لَكَ مِنَ",225],["28:21:1",387,"فَخَرَجَ","So he left","","مِنْهَا خَآئِفًۭا يَتَرَقَّبُ ۖ",225],["28:32:5",389,"تَخْرُجْ","it will come forth","يَدَكَ فِى جَيْبِكَ","بَيْضَآءَ مِنْ غَيْرِ",225],["28:79:1",395,"فَخَرَجَ","So he went forth","","عَلَىٰ قَوْمِهِۦ فِى",225],["30:19:1",406,"يُخْرِجُ","He brings forth","","ٱلْحَىَّ مِنَ ٱلْمَيِّتِ",111],["30:19:5",406,"وَيُخْرِجُ","and He brings forth","ٱلْحَىَّ مِنَ ٱلْمَيِّتِ","ٱلْمَيِّتَ مِنَ ٱلْحَىِّ",111],["30:19:14",406,"تُخْرَجُونَ","you will be brought forth","بَعْدَ مَوْتِهَا ۚ وَكَذَٰلِكَ","",111],["30:25:16",407,"تَخْرُجُونَ","will come forth","ٱلْأَرْضِ إِذَآ أَنتُمْ","",225],["30:48:16",409,"يَخْرُجُ","coming forth","كِسَفًۭا فَتَرَى ٱلْوَدْقَ","مِنْ خِلَـٰلِهِۦ ۖ فَإِذَآ",225],["32:20:9",416,"يَخْرُجُوا۟","come out","كُلَّمَآ أَرَادُوٓا۟ أَن","مِنْهَآ أُعِيدُوا۟ فِيهَا",225],["32:27:9",417,"فَنُخْرِجُ","then We bring forth","إِلَى ٱلْأَرْضِ ٱلْجُرُزِ","بِهِۦ زَرْعًۭا تَأْكُلُ",111],["33:43:6",423,"لِيُخْرِجَكُم","so that He may bring you out","يُصَلِّى عَلَيْكُمْ وَمَلَـٰٓئِكَتُهُۥ","مِّنَ ٱلظُّلُمَـٰتِ إِلَى",111],["34:2:7",428,"يَخْرُجُ","comes out","فِى ٱلْأَرْضِ وَمَا","مِنْهَا وَمَا يَنزِلُ",225],["35:12:17",436,"وَتَسْتَخْرِجُونَ","and you extract","تَأْكُلُونَ لَحْمًۭا طَرِيًّۭا","حِلْيَةًۭ تَلْبَسُونَهَا ۖ وَتَرَى",1702],["35:27:9",437,"فَأَخْرَجْنَا","then We bring forth","مِنَ ٱلسَّمَآءِ مَآءًۭ","بِهِۦ ثَمَرَٰتٍۢ مُّخْتَلِفًا",111],["35:37:5",438,"أَخْرِجْنَا","Bring us out","يَصْطَرِخُونَ فِيهَا رَبَّنَآ","نَعْمَلْ صَـٰلِحًا غَيْرَ",111],["36:33:6",442,"وَأَخْرَجْنَا","and We bring forth","ٱلْأَرْضُ ٱلْمَيْتَةُ أَحْيَيْنَـٰهَا","مِنْهَا حَبًّۭا فَمِنْهُ",111],["37:64:3",448,"تَخْرُجُ","that grows","إِنَّهَا شَجَرَةٌۭ","فِىٓ أَصْلِ ٱلْجَحِيمِ",225],["38:77:2",457,"فَٱخْرُجْ","Then get out","قَالَ","مِنْهَا فَإِنَّكَ رَجِيمٌۭ",225],["39:21:14",460,"يُخْرِجُ","He produces","فِى ٱلْأَرْضِ ثُمَّ","بِهِۦ زَرْعًۭا مُّخْتَلِفًا",111],["40:11:11",468,"خُرُوجٍۢ","get out","بِذُنُوبِنَا فَهَلْ إِلَىٰ","مِّن سَبِيلٍۢ",1425],["40:67:13",475,"يُخْرِجُكُمْ","He brings you out","مِنْ عَلَقَةٍۢ ثُمَّ","طِفْلًۭا ثُمَّ لِتَبْلُغُوٓا۟",111],["41:47:6",482,"تَخْرُجُ","comes out","عِلْمُ ٱلسَّاعَةِ ۚ وَمَا","مِن ثَمَرَٰتٍۢ مِّنْ",225],["43:11:12",490,"تُخْرَجُونَ","you will be brought forth","بَلْدَةًۭ مَّيْتًۭا ۚ كَذَٰلِكَ","",111],["45:35:12",502,"يُخْرَجُونَ","they will be brought forth","ٱلدُّنْيَا ۚ فَٱلْيَوْمَ لَا","مِنْهَا وَلَا هُمْ",111],["46:17:8",504,"أُخْرَجَ","I will be brought forth","لَّكُمَآ أَتَعِدَانِنِىٓ أَنْ","وَقَدْ خَلَتِ ٱلْقُرُونُ",111],["47:13:10",508,"أَخْرَجَتْكَ","has driven you out","مِّن قَرْيَتِكَ ٱلَّتِىٓ","أَهْلَكْنَـٰهُمْ فَلَا نَاصِرَ",111],["47:16:7",508,"خَرَجُوا۟","they depart","إِلَيْكَ حَتَّىٰٓ إِذَا","مِنْ عِندِكَ قَالُوا۟",225],["47:29:9",509,"يُخْرِجَ","will Allah bring forth","مَّرَضٌ أَن لَّن","ٱللَّهُ أَضْغَـٰنَهُمْ",111],["47:37:5",510,"وَيُخْرِجْ","and He will bring forth","يَسْـَٔلْكُمُوهَا فَيُحْفِكُمْ تَبْخَلُوا۟","أَضْغَـٰنَكُمْ",111],["48:29:33",515,"أَخْرَجَ","(which) sends forth","فِى ٱلْإِنجِيلِ كَزَرْعٍ","شَطْـَٔهُۥ فَـَٔازَرَهُۥ فَٱسْتَغْلَظَ",111],["49:5:5",516,"تَخْرُجَ","you came out","أَنَّهُمْ صَبَرُوا۟ حَتَّىٰ","إِلَيْهِمْ لَكَانَ خَيْرًۭا",225],["50:11:8",518,"ٱلْخُرُوجُ","(will be) the coming forth","بَلْدَةًۭ مَّيْتًۭا ۚ كَذَٰلِكَ","",1425],["50:42:7",520,"ٱلْخُرُوجِ","(of) coming forth","بِٱلْحَقِّ ۚ ذَٰلِكَ يَوْمُ","",1425],["51:35:1",522,"فَأَخْرَجْنَا","Then We brought out","","مَن كَانَ فِيهَا",111],["54:7:3",529,"يَخْرُجُونَ","they will come forth","خُشَّعًا أَبْصَـٰرُهُمْ","مِنَ ٱلْأَجْدَاثِ كَأَنَّهُمْ",225],["55:22:1",532,"يَخْرُجُ","Come forth","","مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ",225],["57:4:19",538,"يَخْرُجُ","comes forth","فِى ٱلْأَرْضِ وَمَا","مِنْهَا وَمَا يَنزِلُ",225],["57:9:8",538,"لِّيُخْرِجَكُم","that He may bring you out","عَبْدِهِۦٓ ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ","مِّنَ ٱلظُّلُمَـٰتِ إِلَى",111],["59:2:3",545,"أَخْرَجَ","expelled","هُوَ ٱلَّذِىٓ","ٱلَّذِينَ كَفَرُوا۟ مِنْ",111],["59:2:16",545,"يَخْرُجُوا۟ ۖ","they would leave","مَا ظَنَنتُمْ أَن","وَظَنُّوٓا۟ أَنَّهُم مَّانِعَتُهُمْ",225],["59:8:4",546,"أُخْرِجُوا۟","were expelled","لِلْفُقَرَآءِ ٱلْمُهَـٰجِرِينَ ٱلَّذِينَ","مِن دِيَـٰرِهِمْ وَأَمْوَٰلِهِمْ",111],["59:11:14",547,"أُخْرِجْتُمْ","you are expelled","أَهْلِ ٱلْكِتَـٰبِ لَئِنْ","لَنَخْرُجَنَّ مَعَكُمْ وَلَا",111],["59:11:15",547,"لَنَخْرُجَنَّ","surely we will leave","ٱلْكِتَـٰبِ لَئِنْ أُخْرِجْتُمْ","مَعَكُمْ وَلَا نُطِيعُ",225],["59:12:2",547,"أُخْرِجُوا۟","they are expelled","لَئِنْ","لَا يَخْرُجُونَ مَعَهُمْ",111],["59:12:4",547,"يَخْرُجُونَ","they will leave","لَئِنْ أُخْرِجُوا۟ لَا","مَعَهُمْ وَلَئِن قُوتِلُوا۟",225],["60:1:18",549,"يُخْرِجُونَ","driving out","جَآءَكُم مِّنَ ٱلْحَقِّ","ٱلرَّسُولَ وَإِيَّاكُمْ ۙ أَن",111],["60:1:27",549,"خَرَجْتُمْ","come forth","رَبِّكُمْ إِن كُنتُمْ","جِهَـٰدًۭا فِى سَبِيلِى",225],["60:8:11",550,"يُخْرِجُوكُم","drive you out","فِى ٱلدِّينِ وَلَمْ","مِّن دِيَـٰرِكُمْ أَن",111],["60:9:9",550,"وَأَخْرَجُوكُم","and drive you out","قَـٰتَلُوكُمْ فِى ٱلدِّينِ","مِّن دِيَـٰرِكُمْ وَظَـٰهَرُوا۟",111],["60:9:14",550,"إِخْرَاجِكُمْ","your expulsion","دِيَـٰرِكُمْ وَظَـٰهَرُوا۟ عَلَىٰٓ","أَن تَوَلَّوْهُمْ ۚ وَمَن",1134],["63:8:6",555,"لَيُخْرِجَنَّ","surely, will expel","رَّجَعْنَآ إِلَى ٱلْمَدِينَةِ","ٱلْأَعَزُّ مِنْهَا ٱلْأَذَلَّ ۚ",111],["65:1:14",558,"تُخْرِجُوهُنَّ","expel them","ٱللَّهَ رَبَّكُمْ ۖ لَا","مِنۢ بُيُوتِهِنَّ وَلَا",111],["65:1:18",558,"يَخْرُجْنَ","they should leave","مِنۢ بُيُوتِهِنَّ وَلَا","إِلَّآ أَن يَأْتِينَ",225],["65:2:30",558,"مَخْرَجًۭا","a way out","ٱللَّهَ يَجْعَل لَّهُۥ","",3735],["65:11:7",559,"لِّيُخْرِجَ","that he may bring out","ءَايَـٰتِ ٱللَّهِ مُبَيِّنَـٰتٍۢ","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",111],["70:43:2",570,"يَخْرُجُونَ","they will come out","يَوْمَ","مِنَ ٱلْأَجْدَاثِ سِرَاعًۭا",225],["71:18:4",571,"وَيُخْرِجُكُمْ","and bring you forth","ثُمَّ يُعِيدُكُمْ فِيهَا","إِخْرَاجًۭا",111],["71:18:5",571,"إِخْرَاجًۭا","(a new) bringing forth","يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ","",1134],["78:15:1",582,"لِّنُخْرِجَ","That We may bring forth","","بِهِۦ حَبًّۭا وَنَبَاتًۭا",111],["79:29:3",584,"وَأَخْرَجَ","and brought out","وَأَغْطَشَ لَيْلَهَا","ضُحَىٰهَا",111],["79:31:1",584,"أَخْرَجَ","He brought forth","","مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",111],["86:7:1",591,"يَخْرُجُ","Coming forth","","مِنۢ بَيْنِ ٱلصُّلْبِ",225],["87:4:2",591,"أَخْرَجَ","brings forth","وَٱلَّذِىٓ","ٱلْمَرْعَىٰ",111],["99:2:1",599,"وَأَخْرَجَتِ","And brings forth","","ٱلْأَرْضُ أَثْقَالَهَا",111]]