[["7:20:1",152,"فَوَسْوَسَ","Then whispered","","لَهُمَا ٱلشَّيْطَـٰنُ لِيُبْدِىَ",1660],["20:120:1",320,"فَوَسْوَسَ","Then whispered","","إِلَيْهِ ٱلشَّيْطَـٰنُ قَالَ",1660],["50:16:6",519,"تُوَسْوِسُ","whispers","ٱلْإِنسَـٰنَ وَنَعْلَمُ مَا","بِهِۦ نَفْسُهُۥ ۖ وَنَحْنُ",1660],["114:4:3",604,"ٱلْوَسْوَاسِ","(of) the whisperer","مِن شَرِّ","ٱلْخَنَّاسِ",4540],["114:5:2",604,"يُوَسْوِسُ","whispers","ٱلَّذِى","فِى صُدُورِ ٱلنَّاسِ",1660]]