[["2:14:8",3,"خَلَوْا۟","they are alone","قَالُوٓا۟ ءَامَنَّا وَإِذَا","إِلَىٰ شَيَـٰطِينِهِمْ قَالُوٓا۟",431],["2:76:8",11,"خَلَا","meet in private","قَالُوٓا۟ ءَامَنَّا وَإِذَا","بَعْضُهُمْ إِلَىٰ بَعْضٍۢ",431],["2:134:4",20,"خَلَتْ ۖ","has passed away","تِلْكَ أُمَّةٌۭ قَدْ","لَهَا مَا كَسَبَتْ",431],["2:141:4",21,"خَلَتْ ۖ","has passed away","تِلْكَ أُمَّةٌۭ قَدْ","لَهَا مَا كَسَبَتْ",431],["2:214:10",33,"خَلَوْا۟","passed away","يَأْتِكُم مَّثَلُ ٱلَّذِينَ","مِن قَبْلِكُم ۖ مَّسَّتْهُمُ",431],["3:119:14",65,"خَلَوْا۟","they are alone","قَالُوٓا۟ ءَامَنَّا وَإِذَا","عَضُّوا۟ عَلَيْكُمُ ٱلْأَنَامِلَ",431],["3:137:2",67,"خَلَتْ","passed","قَدْ","مِن قَبْلِكُمْ سُنَنٌۭ",431],["3:144:6",68,"خَلَتْ","passed away","إِلَّا رَسُولٌۭ قَدْ","مِن قَبْلِهِ ٱلرُّسُلُ ۚ",431],["5:75:8",120,"خَلَتْ","had passed","إِلَّا رَسُولٌۭ قَدْ","مِن قَبْلِهِ ٱلرُّسُلُ",431],["7:38:6",155,"خَلَتْ","passed away","فِىٓ أُمَمٍۢ قَدْ","مِن قَبْلِكُم مِّنَ",431],["9:5:21",187,"فَخَلُّوا۟","then leave","ٱلصَّلَوٰةَ وَءَاتَوُا۟ ٱلزَّكَوٰةَ","سَبِيلَهُمْ ۚ إِنَّ ٱللَّهَ",4574],["10:102:7",220,"خَلَوْا۟","passed away","مِثْلَ أَيَّامِ ٱلَّذِينَ","مِن قَبْلِهِمْ ۚ قُلْ",431],["12:9:6",236,"يَخْلُ","so will be free","أَوِ ٱطْرَحُوهُ أَرْضًۭا","لَكُمْ وَجْهُ أَبِيكُمْ",431],["13:6:6",250,"خَلَتْ","has occurred","قَبْلَ ٱلْحَسَنَةِ وَقَدْ","مِن قَبْلِهِمُ ٱلْمَثُلَـٰتُ ۗ",431],["13:30:6",253,"خَلَتْ","have passed away","فِىٓ أُمَّةٍۢ قَدْ","مِن قَبْلِهَآ أُمَمٌۭ",431],["15:13:5",262,"خَلَتْ","have passed","يُؤْمِنُونَ بِهِۦ ۖ وَقَدْ","سُنَّةُ ٱلْأَوَّلِينَ",431],["24:34:9",354,"خَلَوْا۟","passed away","وَمَثَلًۭا مِّنَ ٱلَّذِينَ","مِن قَبْلِكُمْ وَمَوْعِظَةًۭ",431],["33:38:15",423,"خَلَوْا۟","passed away","ٱللَّهِ فِى ٱلَّذِينَ","مِن قَبْلُ ۚ وَكَانَ",431],["33:62:5",426,"خَلَوْا۟","passed away","ٱللَّهِ فِى ٱلَّذِينَ","مِن قَبْلُ ۖ وَلَن",431],["35:24:10",437,"خَلَا","had passed","مِّنْ أُمَّةٍ إِلَّا","فِيهَا نَذِيرٌۭ",431],["40:85:12",476,"خَلَتْ","preceded","ٱللَّهِ ٱلَّتِى قَدْ","فِى عِبَادِهِۦ ۖ وَخَسِرَ",431],["41:25:17",479,"خَلَتْ","(that have) passed away","فِىٓ أُمَمٍۢ قَدْ","مِن قَبْلِهِم مِّنَ",431],["46:17:10",504,"خَلَتِ","and have already passed away","أَنْ أُخْرَجَ وَقَدْ","ٱلْقُرُونُ مِن قَبْلِى",431],["46:18:9",504,"خَلَتْ","(that) already passed away","فِىٓ أُمَمٍۢ قَدْ","مِن قَبْلِهِم مِّنَ",431],["46:21:9",505,"خَلَتِ","and had already passed away","قَوْمَهُۥ بِٱلْأَحْقَافِ وَقَدْ","ٱلنُّذُرُ مِنۢ بَيْنِ",431],["48:23:5",513,"خَلَتْ","passed away","ٱللَّهِ ٱلَّتِى قَدْ","مِن قَبْلُ ۖ وَلَن",431],["69:24:8",567,"ٱلْخَالِيَةِ","past","أَسْلَفْتُمْ فِى ٱلْأَيَّامِ","",4557],["84:4:4",589,"وَتَخَلَّتْ","and becomes empty","وَأَلْقَتْ مَا فِيهَا","",4435]]