[["2:223:6",35,"أَنَّىٰ","when","لَّكُمْ فَأْتُوا۟ حَرْثَكُمْ","شِئْتُمْ ۖ وَقَدِّمُوا۟ لِأَنفُسِكُمْ ۚ",384],["2:247:12",40,"أَنَّىٰ","How","طَالُوتَ مَلِكًۭا ۚ قَالُوٓا۟","يَكُونُ لَهُ ٱلْمُلْكُ",384],["2:259:11",43,"أَنَّىٰ","How","عَلَىٰ عُرُوشِهَا قَالَ","يُحْىِۦ هَـٰذِهِ ٱللَّهُ",384],["3:37:20",54,"أَنَّىٰ","From where","رِزْقًۭا ۖ قَالَ يَـٰمَرْيَمُ","لَكِ هَـٰذَا ۖ قَالَتْ",384],["3:40:3",55,"أَنَّىٰ","how","قَالَ رَبِّ","يَكُونُ لِى غُلَـٰمٌۭ",384],["3:47:3",56,"أَنَّىٰ","how","قَالَتْ رَبِّ","يَكُونُ لِى وَلَدٌۭ",384],["3:113:11",64,"ءَانَآءَ","(in the) hours","يَتْلُونَ ءَايَـٰتِ ٱللَّهِ","ٱلَّيْلِ وَهُمْ يَسْجُدُونَ",1709],["3:165:8",71,"أَنَّىٰ","From where","أَصَبْتُم مِّثْلَيْهَا قُلْتُمْ","هَـٰذَا ۖ قُلْ هُوَ",384],["5:75:24",120,"أَنَّىٰ","how","ٱلْـَٔايَـٰتِ ثُمَّ ٱنظُرْ","يُؤْفَكُونَ",384],["6:95:16",140,"فَأَنَّىٰ","so how","ٱلْحَىِّ ۚ ذَٰلِكُمُ ٱللَّهُ ۖ","تُؤْفَكُونَ",384],["6:101:4",140,"أَنَّىٰ","How","بَدِيعُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ","يَكُونُ لَهُۥ وَلَدٌۭ",384],["9:30:22",191,"أَنَّىٰ","How","قَبْلُ ۚ قَـٰتَلَهُمُ ٱللَّهُ ۚ","يُؤْفَكُونَ",384],["10:32:10",212,"فَأَنَّىٰ","So how","ٱلْحَقِّ إِلَّا ٱلضَّلَـٰلُ ۖ","تُصْرَفُونَ",384],["10:34:16",213,"فَأَنَّىٰ","So how","ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ ۖ","تُؤْفَكُونَ",384],["19:8:3",305,"أَنَّىٰ","How","قَالَ رَبِّ","يَكُونُ لِى غُلَـٰمٌۭ",384],["19:20:2",306,"أَنَّىٰ","How","قَالَتْ","يَكُونُ لِى غُلَـٰمٌۭ",384],["20:130:14",321,"ءَانَآئِ","(the) hours","وَقَبْلَ غُرُوبِهَا ۖ وَمِنْ","ٱلَّيْلِ فَسَبِّحْ وَأَطْرَافَ",1709],["23:89:4",347,"فَأَنَّىٰ","Then how","سَيَقُولُونَ لِلَّهِ ۚ قُلْ","تُسْحَرُونَ",384],["29:61:12",403,"فَأَنَّىٰ","Then how","وَٱلْقَمَرَ لَيَقُولُنَّ ٱللَّهُ ۖ","يُؤْفَكُونَ",384],["33:53:16",425,"إِنَىٰهُ","its preparation","طَعَامٍ غَيْرَ نَـٰظِرِينَ","وَلَـٰكِنْ إِذَا دُعِيتُمْ",2933],["34:52:4",434,"وَأَنَّىٰ","But how","وَقَالُوٓا۟ ءَامَنَّا بِهِۦ","لَهُمُ ٱلتَّنَاوُشُ مِن",384],["35:3:20",434,"فَأَنَّىٰ","Then, how","إِلَـٰهَ إِلَّا هُوَ ۖ","تُؤْفَكُونَ",384],["36:66:8",444,"فَأَنَّىٰ","then how","أَعْيُنِهِمْ فَٱسْتَبَقُوا۟ ٱلصِّرَٰطَ","يُبْصِرُونَ",384],["39:6:35",459,"فَأَنَّىٰ","Then how","إِلَـٰهَ إِلَّا هُوَ ۖ","تُصْرَفُونَ",384],["39:9:4",459,"ءَانَآءَ","(during) hours","أَمَّنْ هُوَ قَـٰنِتٌ","ٱلَّيْلِ سَاجِدًۭا وَقَآئِمًۭا",1709],["40:62:11",474,"فَأَنَّىٰ","So how","إِلَـٰهَ إِلَّا هُوَ ۖ","تُؤْفَكُونَ",384],["40:69:9",475,"أَنَّىٰ","How","فِىٓ ءَايَـٰتِ ٱللَّهِ","يُصْرَفُونَ",384],["43:87:7",495,"فَأَنَّىٰ","Then how","خَلَقَهُمْ لَيَقُولُنَّ ٱللَّهُ ۖ","يُؤْفَكُونَ",384],["44:13:1",496,"أَنَّىٰ","How can","","لَهُمُ ٱلذِّكْرَىٰ وَقَدْ",384],["47:18:11",508,"فَأَنَّىٰ","Then how","فَقَدْ جَآءَ أَشْرَاطُهَا ۚ","لَهُمْ إِذَا جَآءَتْهُمْ",384],["55:44:5",533,"ءَانٍۢ","heated","بَيْنَهَا وَبَيْنَ حَمِيمٍ","",2907],["57:16:2",539,"يَأْنِ","come (the) time","۞ أَلَمْ","لِلَّذِينَ ءَامَنُوٓا۟ أَن",4600],["63:4:21",554,"أَنَّىٰ","How","فَٱحْذَرْهُمْ ۚ قَـٰتَلَهُمُ ٱللَّهُ ۖ","يُؤْفَكُونَ",384],["76:15:3",579,"بِـَٔانِيَةٍۢ","vessels","وَيُطَافُ عَلَيْهِم","مِّن فِضَّةٍۢ وَأَكْوَابٍۢ",2125],["88:5:4",592,"ءَانِيَةٍۢ","boiling","تُسْقَىٰ مِنْ عَيْنٍ","",2125],["89:23:7",594,"وَأَنَّىٰ","but how","يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَـٰنُ","لَهُ ٱلذِّكْرَىٰ",384]]