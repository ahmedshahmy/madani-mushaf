[["2:45:8",7,"ٱلْخَـٰشِعِينَ","the humble ones","لَكَبِيرَةٌ إِلَّا عَلَى","",674],["3:199:14",76,"خَـٰشِعِينَ","humbly submissive","وَمَآ أُنزِلَ إِلَيْهِمْ","لِلَّهِ لَا يَشْتَرُونَ",674],["17:109:5",293,"خُشُوعًۭا ۩","(in) humility","لِلْأَذْقَانِ يَبْكُونَ وَيَزِيدُهُمْ","",4588],["20:108:7",319,"وَخَشَعَتِ","And (will be) humbled","لَا عِوَجَ لَهُۥ ۖ","ٱلْأَصْوَاتُ لِلرَّحْمَـٰنِ فَلَا",2723],["21:90:19",329,"خَـٰشِعِينَ","humbly submissive","وَرَهَبًۭا ۖ وَكَانُوا۟ لَنَا","",674],["23:2:5",342,"خَـٰشِعُونَ","(are) humbly submissive","هُمْ فِى صَلَاتِهِمْ","",674],["33:35:12",422,"وَٱلْخَـٰشِعِينَ","and the humble men","وَٱلصَّـٰدِقَـٰتِ وَٱلصَّـٰبِرِينَ وَٱلصَّـٰبِرَٰتِ","وَٱلْخَـٰشِعَـٰتِ وَٱلْمُتَصَدِّقِينَ وَٱلْمُتَصَدِّقَـٰتِ",674],["33:35:13",422,"وَٱلْخَـٰشِعَـٰتِ","and the humble women","وَٱلصَّـٰبِرِينَ وَٱلصَّـٰبِرَٰتِ وَٱلْخَـٰشِعِينَ","وَٱلْمُتَصَدِّقِينَ وَٱلْمُتَصَدِّقَـٰتِ وَٱلصَّـٰٓئِمِينَ",674],["41:39:6",481,"خَـٰشِعَةًۭ","barren","أَنَّكَ تَرَى ٱلْأَرْضَ","فَإِذَآ أَنزَلْنَا عَلَيْهَا",674],["42:45:4",488,"خَـٰشِعِينَ","humbled","وَتَرَىٰهُمْ يُعْرَضُونَ عَلَيْهَا","مِنَ ٱلذُّلِّ يَنظُرُونَ",674],["54:7:1",529,"خُشَّعًا","(Will be) humbled","","أَبْصَـٰرُهُمْ يَخْرُجُونَ مِنَ",674],["57:16:6",539,"تَخْشَعَ","become humble","لِلَّذِينَ ءَامَنُوٓا۟ أَن","قُلُوبُهُمْ لِذِكْرِ ٱللَّهِ",2723],["59:21:8",548,"خَـٰشِعًۭا","humbled","عَلَىٰ جَبَلٍۢ لَّرَأَيْتَهُۥ","مُّتَصَدِّعًۭا مِّنْ خَشْيَةِ",674],["68:43:1",566,"خَـٰشِعَةً","Humbled","","أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۖ",674],["70:44:1",570,"خَـٰشِعَةً","Humbled","","أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۚ",674],["79:9:2",583,"خَـٰشِعَةٌۭ","humbled","أَبْصَـٰرُهَا","",674],["88:2:3",592,"خَـٰشِعَةٌ","(will be) humbled","وُجُوهٌۭ يَوْمَئِذٍ","",674]]