[["2:2:4",2,"رَيْبَ ۛ","doubt","ذَٰلِكَ ٱلْكِتَـٰبُ لَا","فِيهِ ۛ هُدًۭى لِّلْمُتَّقِينَ",556],["2:23:4",4,"رَيْبٍۢ","doubt","وَإِن كُنتُمْ فِى","مِّمَّا نَزَّلْنَا عَلَىٰ",556],["2:282:95",48,"تَرْتَابُوٓا۟ ۖ","you (have) doubt","لِلشَّهَـٰدَةِ وَأَدْنَىٰٓ أَلَّا","إِلَّآ أَن تَكُونَ",946],["3:9:7",50,"رَيْبَ","doubt","ٱلنَّاسِ لِيَوْمٍۢ لَّا","فِيهِ ۚ إِنَّ ٱللَّهَ",556],["3:25:6",53,"رَيْبَ","doubt","جَمَعْنَـٰهُمْ لِيَوْمٍۢ لَّا","فِيهِ وَوُفِّيَتْ كُلُّ",556],["4:87:11",92,"رَيْبَ","doubt","يَوْمِ ٱلْقِيَـٰمَةِ لَا","فِيهِ ۗ وَمَنْ أَصْدَقُ",556],["5:106:35",125,"ٱرْتَبْتُمْ","you doubt","فَيُقْسِمَانِ بِٱللَّهِ إِنِ","لَا نَشْتَرِى بِهِۦ",946],["6:12:18",129,"رَيْبَ","doubt","يَوْمِ ٱلْقِيَـٰمَةِ لَا","فِيهِ ۚ ٱلَّذِينَ خَسِرُوٓا۟",556],["9:45:9",194,"وَٱرْتَابَتْ","and (are in) doubts","بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ","قُلُوبُهُمْ فَهُمْ فِى",946],["9:45:13",194,"رَيْبِهِمْ","their doubts","قُلُوبُهُمْ فَهُمْ فِى","يَتَرَدَّدُونَ",556],["9:110:6",204,"رِيبَةًۭ","a (cause of) doubt","بُنْيَـٰنُهُمُ ٱلَّذِى بَنَوْا۟","فِى قُلُوبِهِمْ إِلَّآ",4196],["10:37:18",213,"رَيْبَ","doubt","وَتَفْصِيلَ ٱلْكِتَـٰبِ لَا","فِيهِ مِن رَّبِّ",556],["11:62:21",228,"مُرِيبٍۢ","suspicious","مِّمَّا تَدْعُونَآ إِلَيْهِ","",1087],["11:110:18",234,"مُرِيبٍۢ","suspicious","لَفِى شَكٍّۢ مِّنْهُ","",1087],["14:9:37",256,"مُرِيبٍۢ","suspicious","مِّمَّا تَدْعُونَنَآ إِلَيْهِ","",1087],["17:99:18",292,"رَيْبَ","doubt","لَهُمْ أَجَلًۭا لَّا","فِيهِ فَأَبَى ٱلظَّـٰلِمُونَ",556],["18:21:12",296,"رَيْبَ","doubt","وَأَنَّ ٱلسَّاعَةَ لَا","فِيهَآ إِذْ يَتَنَـٰزَعُونَ",556],["22:5:6",332,"رَيْبٍۢ","doubt","إِن كُنتُمْ فِى","مِّنَ ٱلْبَعْثِ فَإِنَّا",556],["22:7:5",333,"رَيْبَ","doubt","ٱلسَّاعَةَ ءَاتِيَةٌۭ لَّا","فِيهَا وَأَنَّ ٱللَّهَ",556],["24:50:5",356,"ٱرْتَابُوٓا۟","do they doubt","قُلُوبِهِم مَّرَضٌ أَمِ","أَمْ يَخَافُونَ أَن",946],["29:48:12",402,"لَّٱرْتَابَ","surely (would) have doubted","تَخُطُّهُۥ بِيَمِينِكَ ۖ إِذًۭا","ٱلْمُبْطِلُونَ",946],["32:2:4",415,"رَيْبَ","doubt","تَنزِيلُ ٱلْكِتَـٰبِ لَا","فِيهِ مِن رَّبِّ",556],["34:54:15",434,"مُّرِيبٍۭ","disquieting","كَانُوا۟ فِى شَكٍّۢ","",1087],["40:34:30",471,"مُّرْتَابٌ","a doubter","مَنْ هُوَ مُسْرِفٌۭ","",3986],["40:59:5",474,"رَيْبَ","doubt","ٱلسَّاعَةَ لَـَٔاتِيَةٌۭ لَّا","فِيهَا وَلَـٰكِنَّ أَكْثَرَ",556],["41:45:18",481,"مُرِيبٍۢ","disquieting","لَفِى شَكٍّۢ مِّنْهُ","",1087],["42:7:15",483,"رَيْبَ","doubt","يَوْمَ ٱلْجَمْعِ لَا","فِيهِ ۚ فَرِيقٌۭ فِى",556],["42:14:30",484,"مُرِيبٍۢ","disquieting","لَفِى شَكٍّۢ مِّنْهُ","",1087],["45:26:12",501,"رَيْبَ","doubt","يَوْمِ ٱلْقِيَـٰمَةِ لَا","فِيهِ وَلَـٰكِنَّ أَكْثَرَ",556],["45:32:9",501,"رَيْبَ","doubt","حَقٌّۭ وَٱلسَّاعَةُ لَا","فِيهَا قُلْتُم مَّا",556],["49:15:9",517,"يَرْتَابُوا۟","doubt","وَرَسُولِهِۦ ثُمَّ لَمْ","وَجَـٰهَدُوا۟ بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ",946],["50:25:4",519,"مُّرِيبٍ","doubter","مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍۢ","",1087],["52:30:6",524,"رَيْبَ","a misfortune of time","شَاعِرٌۭ نَّتَرَبَّصُ بِهِۦ","ٱلْمَنُونِ",556],["57:14:11",539,"وَٱرْتَبْتُمْ","and you doubted","فَتَنتُمْ أَنفُسَكُمْ وَتَرَبَّصْتُمْ","وَغَرَّتْكُمُ ٱلْأَمَانِىُّ حَتَّىٰ",946],["65:4:8",558,"ٱرْتَبْتُمْ","you doubt","مِن نِّسَآئِكُمْ إِنِ","فَعِدَّتُهُنَّ ثَلَـٰثَةُ أَشْهُرٍۢ",946],["74:31:23",576,"يَرْتَابَ","may doubt","ءَامَنُوٓا۟ إِيمَـٰنًۭا ۙ وَلَا","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ",946]]