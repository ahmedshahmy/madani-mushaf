[["1:5:4",1,"نَسْتَعِينُ","we ask for help","إِيَّاكَ نَعْبُدُ وَإِيَّاكَ","",1698],["2:45:1",7,"وَٱسْتَعِينُوا۟","And seek help","","بِٱلصَّبْرِ وَٱلصَّلَوٰةِ ۚ وَإِنَّهَا",1698],["2:68:18",10,"عَوَانٌۢ","middle aged","فَارِضٌۭ وَلَا بِكْرٌ","بَيْنَ ذَٰلِكَ ۖ فَٱفْعَلُوا۟",3129],["2:153:4",23,"ٱسْتَعِينُوا۟","Seek help","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","بِٱلصَّبْرِ وَٱلصَّلَوٰةِ ۚ إِنَّ",1698],["5:2:38",106,"وَتَعَاوَنُوا۟","And help one another","ٱلْحَرَامِ أَن تَعْتَدُوا۟ ۘ","عَلَى ٱلْبِرِّ وَٱلتَّقْوَىٰ ۖ",2653],["5:2:43",106,"تَعَاوَنُوا۟","help one another","ٱلْبِرِّ وَٱلتَّقْوَىٰ ۖ وَلَا","عَلَى ٱلْإِثْمِ وَٱلْعُدْوَٰنِ ۚ",2653],["7:128:4",165,"ٱسْتَعِينُوا۟","Seek help","قَالَ مُوسَىٰ لِقَوْمِهِ","بِٱللَّهِ وَٱصْبِرُوٓا۟ ۖ إِنَّ",1698],["12:18:15",237,"ٱلْمُسْتَعَانُ","(is) the One sought for help","فَصَبْرٌۭ جَمِيلٌۭ ۖ وَٱللَّهُ","عَلَىٰ مَا تَصِفُونَ",2505],["18:95:7",303,"فَأَعِينُونِى","but assist me","فِيهِ رَبِّى خَيْرٌۭ","بِقُوَّةٍ أَجْعَلْ بَيْنَكُمْ",2153],["21:112:7",331,"ٱلْمُسْتَعَانُ","the One Whose help is sought","بِٱلْحَقِّ ۗ وَرَبُّنَا ٱلرَّحْمَـٰنُ","عَلَىٰ مَا تَصِفُونَ",2505],["25:4:9",360,"وَأَعَانَهُۥ","and helped him","إِلَّآ إِفْكٌ ٱفْتَرَىٰهُ","عَلَيْهِ قَوْمٌ ءَاخَرُونَ ۖ",2153]]