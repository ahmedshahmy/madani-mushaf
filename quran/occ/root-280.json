[["2:61:57",9,"عَصَوا۟","they disobeyed","ٱلْحَقِّ ۗ ذَٰلِكَ بِمَا","وَّكَانُوا۟ يَعْتَدُونَ",396],["2:93:14",14,"وَعَصَيْنَا","and we disobeyed","وَٱسْمَعُوا۟ ۖ قَالُوا۟ سَمِعْنَا","وَأُشْرِبُوا۟ فِى قُلُوبِهِمُ",396],["3:112:33",64,"عَصَوا۟","they disobeyed","حَقٍّۢ ۚ ذَٰلِكَ بِمَا","وَّكَانُوا۟ يَعْتَدُونَ",396],["3:152:14",69,"وَعَصَيْتُم","and you disobeyed","وَتَنَـٰزَعْتُمْ فِى ٱلْأَمْرِ","مِّنۢ بَعْدِ مَآ",396],["4:14:2",79,"يَعْصِ","disobeys","وَمَن","ٱللَّهَ وَرَسُولَهُۥ وَيَتَعَدَّ",396],["4:42:5",85,"وَعَصَوُا۟","and disobeyed","يَوَدُّ ٱلَّذِينَ كَفَرُوا۟","ٱلرَّسُولَ لَوْ تُسَوَّىٰ",396],["4:46:10",86,"وَعَصَيْنَا","and we disobey[ed]","مَّوَاضِعِهِۦ وَيَقُولُونَ سَمِعْنَا","وَٱسْمَعْ غَيْرَ مُسْمَعٍۢ",396],["5:78:15",121,"عَصَوا۟","they disobeyed","مَرْيَمَ ۚ ذَٰلِكَ بِمَا","وَّكَانُوا۟ يَعْتَدُونَ",396],["6:15:5",129,"عَصَيْتُ","I disobeyed","إِنِّىٓ أَخَافُ إِنْ","رَبِّى عَذَابَ يَوْمٍ",396],["10:15:35",210,"عَصَيْتُ","I were to disobey","إِنِّىٓ أَخَافُ إِنْ","رَبِّى عَذَابَ يَوْمٍ",396],["10:91:3",219,"عَصَيْتَ","you (had) disobeyed","ءَآلْـَٔـٰنَ وَقَدْ","قَبْلُ وَكُنتَ مِنَ",396],["11:59:6",228,"وَعَصَوْا۟","and disobeyed","جَحَدُوا۟ بِـَٔايَـٰتِ رَبِّهِمْ","رُسُلَهُۥ وَٱتَّبَعُوٓا۟ أَمْرَ",396],["11:63:18",229,"عَصَيْتُهُۥ ۖ","I (were to) disobey Him","مِنَ ٱللَّهِ إِنْ","فَمَا تَزِيدُونَنِى غَيْرَ",396],["14:36:12",260,"عَصَانِى","disobeys me","فَإِنَّهُۥ مِنِّى ۖ وَمَنْ","فَإِنَّكَ غَفُورٌۭ رَّحِيمٌۭ",396],["18:69:8",301,"أَعْصِى","I will disobey","ٱللَّهُ صَابِرًۭا وَلَآ","لَكَ أَمْرًۭا",396],["19:14:6",306,"عَصِيًّۭا","disobedient","وَلَمْ يَكُن جَبَّارًا","",2230],["19:44:9",308,"عَصِيًّۭا","disobedient","ٱلشَّيْطَـٰنَ كَانَ لِلرَّحْمَـٰنِ","",2230],["20:93:3",318,"أَفَعَصَيْتَ","Then, have you disobeyed","أَلَّا تَتَّبِعَنِ ۖ","أَمْرِى",396],["20:121:12",320,"وَعَصَىٰٓ","And Adam disobeyed","مِن وَرَقِ ٱلْجَنَّةِ ۚ","ءَادَمُ رَبَّهُۥ فَغَوَىٰ",396],["26:216:2",376,"عَصَوْكَ","they disobey you","فَإِنْ","فَقُلْ إِنِّى بَرِىٓءٌۭ",396],["33:36:18",423,"يَعْصِ","disobeys","مِنْ أَمْرِهِمْ ۗ وَمَن","ٱللَّهَ وَرَسُولَهُۥ فَقَدْ",396],["39:13:5",460,"عَصَيْتُ","I disobey","إِنِّىٓ أَخَافُ إِنْ","رَبِّى عَذَابَ يَوْمٍ",396],["49:7:25",516,"وَٱلْعِصْيَانَ ۚ","and disobedience","إِلَيْكُمُ ٱلْكُفْرَ وَٱلْفُسُوقَ","أُو۟لَـٰٓئِكَ هُمُ ٱلرَّٰشِدُونَ",3138],["58:8:16",543,"وَمَعْصِيَتِ","and disobedience","وَيَتَنَـٰجَوْنَ بِٱلْإِثْمِ وَٱلْعُدْوَٰنِ","ٱلرَّسُولِ وَإِذَا جَآءُوكَ",2444],["58:9:10",543,"وَمَعْصِيَتِ","and disobedience","تَتَنَـٰجَوْا۟ بِٱلْإِثْمِ وَٱلْعُدْوَٰنِ","ٱلرَّسُولِ وَتَنَـٰجَوْا۟ بِٱلْبِرِّ",2444],["60:12:28",551,"يَعْصِينَكَ","they will disobey you","أَيْدِيهِنَّ وَأَرْجُلِهِنَّ وَلَا","فِى مَعْرُوفٍۢ ۙ فَبَايِعْهُنَّ",396],["66:6:16",560,"يَعْصُونَ","they disobey","غِلَاظٌۭ شِدَادٌۭ لَّا","ٱللَّهَ مَآ أَمَرَهُمْ",396],["69:10:1",567,"فَعَصَوْا۟","And they disobeyed","","رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ",396],["71:21:5",571,"عَصَوْنِى","disobeyed me","نُوحٌۭ رَّبِّ إِنَّهُمْ","وَٱتَّبَعُوا۟ مَن لَّمْ",396],["72:23:7",573,"يَعْصِ","disobeys","ٱللَّهِ وَرِسَـٰلَـٰتِهِۦ ۚ وَمَن","ٱللَّهَ وَرَسُولَهُۥ فَإِنَّ",396],["73:16:1",574,"فَعَصَىٰ","But disobeyed","","فِرْعَوْنُ ٱلرَّسُولَ فَأَخَذْنَـٰهُ",396],["79:21:2",584,"وَعَصَىٰ","and disobeyed","فَكَذَّبَ","",396]]