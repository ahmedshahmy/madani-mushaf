[["2:35:7",6,"وَكُلَا","and [you both] eat","أَنتَ وَزَوْجُكَ ٱلْجَنَّةَ","مِنْهَا رَغَدًا حَيْثُ",114],["2:57:8",8,"كُلُوا۟","Eat","عَلَيْكُمُ ٱلْمَنَّ وَٱلسَّلْوَىٰ ۖ","مِن طَيِّبَـٰتِ مَا",114],["2:58:6",9,"فَكُلُوا۟","then eat","ٱدْخُلُوا۟ هَـٰذِهِ ٱلْقَرْيَةَ","مِنْهَا حَيْثُ شِئْتُمْ",114],["2:60:19",9,"كُلُوا۟","Eat","كُلُّ أُنَاسٍۢ مَّشْرَبَهُمْ ۖ","وَٱشْرَبُوا۟ مِن رِّزْقِ",114],["2:168:3",25,"كُلُوا۟","Eat","يَـٰٓأَيُّهَا ٱلنَّاسُ","مِمَّا فِى ٱلْأَرْضِ",114],["2:172:4",26,"كُلُوا۟","Eat","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","مِن طَيِّبَـٰتِ مَا",114],["2:174:15",26,"يَأْكُلُونَ","they eat","قَلِيلًا ۙ أُو۟لَـٰٓئِكَ مَا","فِى بُطُونِهِمْ إِلَّا",114],["2:187:31",29,"وَكُلُوا۟","And eat","كَتَبَ ٱللَّهُ لَكُمْ ۚ","وَٱشْرَبُوا۟ حَتَّىٰ يَتَبَيَّنَ",114],["2:188:2",29,"تَأْكُلُوٓا۟","eat","وَلَا","أَمْوَٰلَكُم بَيْنَكُم بِٱلْبَـٰطِلِ",114],["2:188:10",29,"لِتَأْكُلُوا۟","so that you may eat","بِهَآ إِلَى ٱلْحُكَّامِ","فَرِيقًۭا مِّنْ أَمْوَٰلِ",114],["2:265:17",45,"أُكُلَهَا","its harvest","أَصَابَهَا وَابِلٌۭ فَـَٔاتَتْ","ضِعْفَيْنِ فَإِن لَّمْ",1041],["2:275:2",47,"يَأْكُلُونَ","consume","ٱلَّذِينَ","ٱلرِّبَوٰا۟ لَا يَقُومُونَ",114],["3:49:33",56,"تَأْكُلُونَ","you eat","ٱللَّهِ ۖ وَأُنَبِّئُكُم بِمَا","وَمَا تَدَّخِرُونَ فِى",114],["3:130:5",66,"تَأْكُلُوا۟","eat","ٱلَّذِينَ ءَامَنُوا۟ لَا","ٱلرِّبَوٰٓا۟ أَضْعَـٰفًۭا مُّضَـٰعَفَةًۭ ۖ",114],["3:183:13",74,"تَأْكُلُهُ","consumes it","حَتَّىٰ يَأْتِيَنَا بِقُرْبَانٍۢ","ٱلنَّارُ ۗ قُلْ قَدْ",114],["4:2:9",77,"تَأْكُلُوٓا۟","consume","ٱلْخَبِيثَ بِٱلطَّيِّبِ ۖ وَلَا","أَمْوَٰلَهُمْ إِلَىٰٓ أَمْوَٰلِكُمْ ۚ",114],["4:4:12",77,"فَكُلُوهُ","then eat it","شَىْءٍۢ مِّنْهُ نَفْسًۭا","هَنِيٓـًۭٔا مَّرِيٓـًۭٔا",114],["4:6:15",77,"تَأْكُلُوهَآ","eat it","إِلَيْهِمْ أَمْوَٰلَهُمْ ۖ وَلَا","إِسْرَافًۭا وَبِدَارًا أَن",114],["4:6:27",77,"فَلْيَأْكُلْ","then let him eat (of it)","وَمَن كَانَ فَقِيرًۭا","بِٱلْمَعْرُوفِ ۚ فَإِذَا دَفَعْتُمْ",114],["4:10:3",78,"يَأْكُلُونَ","consume","إِنَّ ٱلَّذِينَ","أَمْوَٰلَ ٱلْيَتَـٰمَىٰ ظُلْمًا",114],["4:10:8",78,"يَأْكُلُونَ","they consume","ٱلْيَتَـٰمَىٰ ظُلْمًا إِنَّمَا","فِى بُطُونِهِمْ نَارًۭا ۖ",114],["4:29:5",83,"تَأْكُلُوٓا۟","eat","ٱلَّذِينَ ءَامَنُوا۟ لَا","أَمْوَٰلَكُم بَيْنَكُم بِٱلْبَـٰطِلِ",114],["4:161:6",103,"وَأَكْلِهِمْ","and (for) their consuming","وَقَدْ نُهُوا۟ عَنْهُ","أَمْوَٰلَ ٱلنَّاسِ بِٱلْبَـٰطِلِ ۚ",1468],["5:3:17",107,"أَكَلَ","ate (it)","وَٱلْمُتَرَدِّيَةُ وَٱلنَّطِيحَةُ وَمَآ","ٱلسَّبُعُ إِلَّا مَا",114],["5:4:18",107,"فَكُلُوا۟","So eat","مِمَّا عَلَّمَكُمُ ٱللَّهُ ۖ","مِمَّآ أَمْسَكْنَ عَلَيْكُمْ",114],["5:42:3",115,"أَكَّـٰلُونَ","devourers","سَمَّـٰعُونَ لِلْكَذِبِ","لِلسُّحْتِ ۚ فَإِن جَآءُوكَ",3002],["5:62:8",118,"وَأَكْلِهِمُ","and eating","فِى ٱلْإِثْمِ وَٱلْعُدْوَٰنِ","ٱلسُّحْتَ ۚ لَبِئْسَ مَا",1468],["5:63:8",118,"وَأَكْلِهِمُ","and their eating","عَن قَوْلِهِمُ ٱلْإِثْمَ","ٱلسُّحْتَ ۚ لَبِئْسَ مَا",1468],["5:66:11",119,"لَأَكَلُوا۟","surely they (would have) eaten","إِلَيْهِم مِّن رَّبِّهِمْ","مِن فَوْقِهِمْ وَمِن",114],["5:75:15",120,"يَأْكُلَانِ","eat","وَأُمُّهُۥ صِدِّيقَةٌۭ ۖ كَانَا","ٱلطَّعَامَ ۗ ٱنظُرْ كَيْفَ",114],["5:88:1",122,"وَكُلُوا۟","And eat","","مِمَّا رَزَقَكُمُ ٱللَّهُ",114],["5:113:4",126,"نَّأْكُلَ","we eat","قَالُوا۟ نُرِيدُ أَن","مِنْهَا وَتَطْمَئِنَّ قُلُوبُنَا",114],["6:118:1",142,"فَكُلُوا۟","So eat","","مِمَّا ذُكِرَ ٱسْمُ",114],["6:119:4",143,"تَأْكُلُوا۟","you eat","وَمَا لَكُمْ أَلَّا","مِمَّا ذُكِرَ ٱسْمُ",114],["6:121:2",143,"تَأْكُلُوا۟","eat","وَلَا","مِمَّا لَمْ يُذْكَرِ",114],["6:141:11",146,"أُكُلُهُۥ","(are) its taste","وَٱلنَّخْلَ وَٱلزَّرْعَ مُخْتَلِفًا","وَٱلزَّيْتُونَ وَٱلرُّمَّانَ مُتَشَـٰبِهًۭا",1041],["6:141:17",146,"كُلُوا۟","Eat","مُتَشَـٰبِهًۭا وَغَيْرَ مُتَشَـٰبِهٍۢ ۚ","مِن ثَمَرِهِۦٓ إِذَآ",114],["6:142:5",146,"كُلُوا۟","Eat","ٱلْأَنْعَـٰمِ حَمُولَةًۭ وَفَرْشًۭا ۚ","مِمَّا رَزَقَكُمُ ٱللَّهُ",114],["7:19:6",152,"فَكُلَا","and you both eat","أَنتَ وَزَوْجُكَ ٱلْجَنَّةَ","مِنْ حَيْثُ شِئْتُمَا",114],["7:31:8",154,"وَكُلُوا۟","and eat","عِندَ كُلِّ مَسْجِدٍۢ","وَٱشْرَبُوا۟ وَلَا تُسْرِفُوٓا۟ ۚ",114],["7:73:25",159,"تَأْكُلْ","(to) eat","لَكُمْ ءَايَةًۭ ۖ فَذَرُوهَا","فِىٓ أَرْضِ ٱللَّهِ ۖ",114],["7:160:33",171,"كُلُوا۟","Eat","عَلَيْهِمُ ٱلْمَنَّ وَٱلسَّلْوَىٰ ۖ","مِن طَيِّبَـٰتِ مَا",114],["7:161:7",171,"وَكُلُوا۟","and eat","ٱسْكُنُوا۟ هَـٰذِهِ ٱلْقَرْيَةَ","مِنْهَا حَيْثُ شِئْتُمْ",114],["8:69:1",185,"فَكُلُوا۟","So eat","","مِمَّا غَنِمْتُمْ حَلَـٰلًۭا",114],["9:34:9",192,"لَيَأْكُلُونَ","surely eat","مِّنَ ٱلْأَحْبَارِ وَٱلرُّهْبَانِ","أَمْوَٰلَ ٱلنَّاسِ بِٱلْبَـٰطِلِ",114],["10:24:14",211,"يَأْكُلُ","eat","نَبَاتُ ٱلْأَرْضِ مِمَّا","ٱلنَّاسُ وَٱلْأَنْعَـٰمُ حَتَّىٰٓ",114],["11:64:8",229,"تَأْكُلْ","to eat","لَكُمْ ءَايَةًۭ فَذَرُوهَا","فِىٓ أَرْضِ ٱللَّهِ",114],["12:13:9",236,"يَأْكُلَهُ","would eat him","بِهِۦ وَأَخَافُ أَن","ٱلذِّئْبُ وَأَنتُمْ عَنْهُ",114],["12:14:3",236,"أَكَلَهُ","eats him","قَالُوا۟ لَئِنْ","ٱلذِّئْبُ وَنَحْنُ عُصْبَةٌ",114],["12:17:10",237,"فَأَكَلَهُ","and ate him","يُوسُفَ عِندَ مَتَـٰعِنَا","ٱلذِّئْبُ ۖ وَمَآ أَنتَ",114],["12:36:19",239,"تَأْكُلُ","(were) eating","فَوْقَ رَأْسِى خُبْزًۭا","ٱلطَّيْرُ مِنْهُ ۖ نَبِّئْنَا",114],["12:41:11",240,"فَتَأْكُلُ","and will eat","وَأَمَّا ٱلْـَٔاخَرُ فَيُصْلَبُ","ٱلطَّيْرُ مِن رَّأْسِهِۦ ۚ",114],["12:43:8",240,"يَأْكُلُهُنَّ","eating them","سَبْعَ بَقَرَٰتٍۢ سِمَانٍۢ","سَبْعٌ عِجَافٌۭ وَسَبْعَ",114],["12:46:9",241,"يَأْكُلُهُنَّ","eating them","سَبْعِ بَقَرَٰتٍۢ سِمَانٍۢ","سَبْعٌ عِجَافٌۭ وَسَبْعِ",114],["12:47:14",241,"تَأْكُلُونَ","you (will) eat","إِلَّا قَلِيلًۭا مِّمَّا","",114],["12:48:8",241,"يَأْكُلْنَ","(which will) consume","ذَٰلِكَ سَبْعٌۭ شِدَادٌۭ","مَا قَدَّمْتُمْ لَهُنَّ",114],["13:4:21",249,"ٱلْأُكُلِ ۚ","the fruit","عَلَىٰ بَعْضٍۢ فِى","إِنَّ فِى ذَٰلِكَ",1041],["13:35:10",254,"أُكُلُهَا","Its food","مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۖ","دَآئِمٌۭ وَظِلُّهَا ۚ تِلْكَ",1041],["14:25:2",259,"أُكُلَهَا","its fruit","تُؤْتِىٓ","كُلَّ حِينٍۭ بِإِذْنِ",1041],["15:3:2",262,"يَأْكُلُوا۟","(to) eat","ذَرْهُمْ","وَيَتَمَتَّعُوا۟ وَيُلْهِهِمُ ٱلْأَمَلُ ۖ",114],["16:5:8",267,"تَأْكُلُونَ","you eat","دِفْءٌۭ وَمَنَـٰفِعُ وَمِنْهَا","",114],["16:14:5",268,"لِتَأْكُلُوا۟","for you to eat","ٱلَّذِى سَخَّرَ ٱلْبَحْرَ","مِنْهُ لَحْمًۭا طَرِيًّۭا",114],["16:69:2",274,"كُلِى","eat","ثُمَّ","مِن كُلِّ ٱلثَّمَرَٰتِ",114],["16:114:1",280,"فَكُلُوا۟","So eat","","مِمَّا رَزَقَكُمُ ٱللَّهُ",114],["18:33:4",297,"أُكُلَهَا","its produce","كِلْتَا ٱلْجَنَّتَيْنِ ءَاتَتْ","وَلَمْ تَظْلِم مِّنْهُ",1041],["19:26:1",307,"فَكُلِى","So eat","","وَٱشْرَبِى وَقَرِّى عَيْنًۭا ۖ",114],["20:54:1",315,"كُلُوا۟","Eat","","وَٱرْعَوْا۟ أَنْعَـٰمَكُمْ ۗ إِنَّ",114],["20:81:1",317,"كُلُوا۟","Eat","","مِن طَيِّبَـٰتِ مَا",114],["20:121:1",320,"فَأَكَلَا","Then they both ate","","مِنْهَا فَبَدَتْ لَهُمَا",114],["21:8:5",322,"يَأْكُلُونَ","eating","جَعَلْنَـٰهُمْ جَسَدًۭا لَّا","ٱلطَّعَامَ وَمَا كَانُوا۟",114],["22:28:16",335,"فَكُلُوا۟","So eat","مِّنۢ بَهِيمَةِ ٱلْأَنْعَـٰمِ ۖ","مِنْهَا وَأَطْعِمُوا۟ ٱلْبَآئِسَ",114],["22:36:18",336,"فَكُلُوا۟","then eat","فَإِذَا وَجَبَتْ جُنُوبُهَا","مِنْهَا وَأَطْعِمُوا۟ ٱلْقَانِعَ",114],["23:19:13",343,"تَأْكُلُونَ","you eat","فَوَٰكِهُ كَثِيرَةٌۭ وَمِنْهَا","",114],["23:20:9",343,"لِّلْـَٔاكِلِينَ","for those who eat","تَنۢبُتُ بِٱلدُّهْنِ وَصِبْغٍۢ","",1708],["23:21:15",343,"تَأْكُلُونَ","you eat","مَنَـٰفِعُ كَثِيرَةٌۭ وَمِنْهَا","",114],["23:33:19",344,"يَأْكُلُ","He eats","إِلَّا بَشَرٌۭ مِّثْلُكُمْ","مِمَّا تَأْكُلُونَ مِنْهُ",114],["23:33:21",344,"تَأْكُلُونَ","you eat","مِّثْلُكُمْ يَأْكُلُ مِمَّا","مِنْهُ وَيَشْرَبُ مِمَّا",114],["23:51:3",345,"كُلُوا۟","Eat","يَـٰٓأَيُّهَا ٱلرُّسُلُ","مِنَ ٱلطَّيِّبَـٰتِ وَٱعْمَلُوا۟",114],["24:61:17",358,"تَأْكُلُوا۟","you eat","عَلَىٰٓ أَنفُسِكُمْ أَن","مِنۢ بُيُوتِكُمْ أَوْ",114],["24:61:54",358,"تَأْكُلُوا۟","you eat","عَلَيْكُمْ جُنَاحٌ أَن","جَمِيعًا أَوْ أَشْتَاتًۭا ۚ",114],["25:7:5",360,"يَأْكُلُ","eat","مَالِ هَـٰذَا ٱلرَّسُولِ","ٱلطَّعَامَ وَيَمْشِى فِى",114],["25:8:9",360,"يَأْكُلُ","he may eat","تَكُونُ لَهُۥ جَنَّةٌۭ","مِنْهَا ۚ وَقَالَ ٱلظَّـٰلِمُونَ",114],["25:20:8",361,"لَيَأْكُلُونَ","[surely] ate","ٱلْمُرْسَلِينَ إِلَّآ إِنَّهُمْ","ٱلطَّعَامَ وَيَمْشُونَ فِى",114],["32:27:12",417,"تَأْكُلُ","eat","فَنُخْرِجُ بِهِۦ زَرْعًۭا","مِنْهُ أَنْعَـٰمُهُمْ وَأَنفُسُهُمْ ۖ",114],["34:14:12",429,"تَأْكُلُ","eating","إِلَّا دَآبَّةُ ٱلْأَرْضِ","مِنسَأَتَهُۥ ۖ فَلَمَّا خَرَّ",114],["34:15:11",430,"كُلُوا۟","Eat","عَن يَمِينٍۢ وَشِمَالٍۢ ۖ","مِن رِّزْقِ رَبِّكُمْ",114],["34:16:10",430,"أُكُلٍ","producing fruit","بِجَنَّتَيْهِمْ جَنَّتَيْنِ ذَوَاتَىْ","خَمْطٍۢ وَأَثْلٍۢ وَشَىْءٍۢ",1041],["35:12:14",436,"تَأْكُلُونَ","you eat","أُجَاجٌۭ ۖ وَمِن كُلٍّۢ","لَحْمًۭا طَرِيًّۭا وَتَسْتَخْرِجُونَ",114],["36:33:10",442,"يَأْكُلُونَ","they eat","مِنْهَا حَبًّۭا فَمِنْهُ","",114],["36:35:1",442,"لِيَأْكُلُوا۟","That they may eat","","مِن ثَمَرِهِۦ وَمَا",114],["36:72:6",445,"يَأْكُلُونَ","they eat","فَمِنْهَا رَكُوبُهُمْ وَمِنْهَا","",114],["37:66:2",448,"لَـَٔاكِلُونَ","(will) surely eat","فَإِنَّهُمْ","مِنْهَا فَمَالِـُٔونَ مِنْهَا",1708],["37:91:6",449,"تَأْكُلُونَ","you eat","ءَالِهَتِهِمْ فَقَالَ أَلَا","",114],["40:79:9",476,"تَأْكُلُونَ","you eat","لِتَرْكَبُوا۟ مِنْهَا وَمِنْهَا","",114],["43:73:6",494,"تَأْكُلُونَ","you will eat","فَـٰكِهَةٌۭ كَثِيرَةٌۭ مِّنْهَا","",114],["47:12:16",508,"وَيَأْكُلُونَ","and eat","وَٱلَّذِينَ كَفَرُوا۟ يَتَمَتَّعُونَ","كَمَا تَأْكُلُ ٱلْأَنْعَـٰمُ",114],["47:12:18",508,"تَأْكُلُ","eat","يَتَمَتَّعُونَ وَيَأْكُلُونَ كَمَا","ٱلْأَنْعَـٰمُ وَٱلنَّارُ مَثْوًۭى",114],["49:12:21",517,"يَأْكُلَ","eat","أَيُحِبُّ أَحَدُكُمْ أَن","لَحْمَ أَخِيهِ مَيْتًۭا",114],["51:27:5",521,"تَأْكُلُونَ","you eat","إِلَيْهِمْ قَالَ أَلَا","",114],["52:19:1",524,"كُلُوا۟","Eat","","وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا",114],["56:52:1",536,"لَـَٔاكِلُونَ","Will surely eat","","مِن شَجَرٍۢ مِّن",1708],["67:15:10",563,"وَكُلُوا۟","and eat","فَٱمْشُوا۟ فِى مَنَاكِبِهَا","مِن رِّزْقِهِۦ ۖ وَإِلَيْهِ",114],["69:24:1",567,"كُلُوا۟","Eat","","وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ",114],["69:37:2",568,"يَأْكُلُهُۥٓ","will eat it","لَّ