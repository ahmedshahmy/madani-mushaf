[["2:49:9",8,"يُذَبِّحُونَ","slaughtering","يَسُومُونَكُمْ سُوٓءَ ٱلْعَذَابِ","أَبْنَآءَكُمْ وَيَسْتَحْيُونَ نِسَآءَكُمْ ۚ",2074],["2:67:9",10,"تَذْبَحُوا۟","you slaughter","ٱللَّهَ يَأْمُرُكُمْ أَن","بَقَرَةًۭ ۖ قَالُوٓا۟ أَتَتَّخِذُنَا",1269],["2:71:21",11,"فَذَبَحُوهَا","So they slaughtered it","ٱلْـَٔـٰنَ جِئْتَ بِٱلْحَقِّ ۚ","وَمَا كَادُوا۟ يَفْعَلُونَ",1269],["5:3:23",107,"ذُبِحَ","is sacrificed","مَا ذَكَّيْتُمْ وَمَا","عَلَى ٱلنُّصُبِ وَأَن",1269],["14:6:17",256,"وَيُذَبِّحُونَ","and were slaughtering","يَسُومُونَكُمْ سُوٓءَ ٱلْعَذَابِ","أَبْنَآءَكُمْ وَيَسْتَحْيُونَ نِسَآءَكُمْ ۚ",2074],["27:21:5",378,"لَأَا۟ذْبَحَنَّهُۥٓ","I will surely slaughter him","عَذَابًۭا شَدِيدًا أَوْ","أَوْ لَيَأْتِيَنِّى بِسُلْطَـٰنٍۢ",1269],["28:4:12",385,"يُذَبِّحُ","slaughtering","يَسْتَضْعِفُ طَآئِفَةًۭ مِّنْهُمْ","أَبْنَآءَهُمْ وَيَسْتَحْىِۦ نِسَآءَهُمْ ۚ",2074],["37:102:12",449,"أَذْبَحُكَ","sacrificing you","فِى ٱلْمَنَامِ أَنِّىٓ","فَٱنظُرْ مَاذَا تَرَىٰ ۚ",1269],["37:107:2",450,"بِذِبْحٍ","with a sacrifice","وَفَدَيْنَـٰهُ","عَظِيمٍۢ",2916]]