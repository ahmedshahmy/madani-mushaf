[["2:12:1",3,"أَلَآ","Beware","","إِنَّهُمْ هُمُ ٱلْمُفْسِدُونَ",299],["2:13:13",3,"أَلَآ","Beware","كَمَآ ءَامَنَ ٱلسُّفَهَآءُ ۗ","إِنَّهُمْ هُمُ ٱلسُّفَهَآءُ",299],["2:214:26",33,"أَلَآ","Unquestionably","مَتَىٰ نَصْرُ ٱللَّهِ ۗ","إِنَّ نَصْرَ ٱللَّهِ",299],["6:31:23",131,"أَلَا","Unquestionably","أَوْزَارَهُمْ عَلَىٰ ظُهُورِهِمْ ۚ","سَآءَ مَا يَزِرُونَ",299],["6:62:7",135,"أَلَا","Unquestionably","ٱللَّهِ مَوْلَىٰهُمُ ٱلْحَقِّ ۚ","لَهُ ٱلْحُكْمُ وَهُوَ",299],["7:54:25",157,"أَلَا","Unquestionably","وَٱلنُّجُومَ مُسَخَّرَٰتٍۭ بِأَمْرِهِۦٓ ۗ","لَهُ ٱلْخَلْقُ وَٱلْأَمْرُ ۗ",299],["7:131:14",166,"أَلَآ","Behold","بِمُوسَىٰ وَمَن مَّعَهُۥٓ ۗ","إِنَّمَا طَـٰٓئِرُهُمْ عِندَ",299],["9:49:8",195,"أَلَا","Surely","لِّى وَلَا تَفْتِنِّىٓ ۚ","فِى ٱلْفِتْنَةِ سَقَطُوا۟ ۗ",299],["9:99:16",202,"أَلَآ","Behold","ٱللَّهِ وَصَلَوَٰتِ ٱلرَّسُولِ ۚ","إِنَّهَا قُرْبَةٌۭ لَّهُمْ ۚ",299],["10:55:1",215,"أَلَآ","No doubt","","إِنَّ لِلَّهِ مَا",299],["10:55:8",215,"أَلَآ","No doubt","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۗ","إِنَّ وَعْدَ ٱللَّهِ",299],["10:62:1",216,"أَلَآ","No doubt","","إِنَّ أَوْلِيَآءَ ٱللَّهِ",299],["10:66:1",216,"أَلَآ","No doubt","","إِنَّ لِلَّهِ مَن",299],["11:5:1",221,"أَلَآ","No doubt","","إِنَّهُمْ يَثْنُونَ صُدُورَهُمْ",299],["11:5:7",221,"أَلَا","Surely","صُدُورَهُمْ لِيَسْتَخْفُوا۟ مِنْهُ ۚ","حِينَ يَسْتَغْشُونَ ثِيَابَهُمْ",299],["11:8:11",222,"أَلَا","No doubt","لَّيَقُولُنَّ مَا يَحْبِسُهُۥٓ ۗ","يَوْمَ يَأْتِيهِمْ لَيْسَ",299],["11:18:19",223,"أَلَا","No doubt","كَذَبُوا۟ عَلَىٰ رَبِّهِمْ ۚ","لَعْنَةُ ٱللَّهِ عَلَى",299],["11:60:8",228,"أَلَآ","No doubt","لَعْنَةًۭ وَيَوْمَ ٱلْقِيَـٰمَةِ ۗ","إِنَّ عَادًۭا كَفَرُوا۟",299],["11:60:13",228,"أَلَا","So","عَادًۭا كَفَرُوا۟ رَبَّهُمْ ۗ","بُعْدًۭا لِّعَادٍۢ قَوْمِ",299],["11:68:5",229,"أَلَآ","No doubt","لَّمْ يَغْنَوْا۟ فِيهَآ ۗ","إِنَّ ثَمُودَا۟ كَفَرُوا۟",299],["11:68:10",229,"أَلَا","so","ثَمُودَا۟ كَفَرُوا۟ رَبَّهُمْ ۗ","بُعْدًۭا لِّثَمُودَ",299],["11:95:5",232,"أَلَا","So","لَّمْ يَغْنَوْا۟ ف