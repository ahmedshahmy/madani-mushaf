[["2:152:4",23,"لِى","to Me","فَٱذْكُرُونِىٓ أَذْكُرْكُمْ وَٱشْكُرُوا۟","وَلَا تَكْفُرُونِ",146],["2:186:13",28,"لِى","to Me","إِذَا دَعَانِ ۖ فَلْيَسْتَجِيبُوا۟","وَلْيُؤْمِنُوا۟ بِى لَعَلَّهُمْ",146],["2:186:15",28,"بِى","in Me","فَلْيَسْتَجِيبُوا۟ لِى وَلْيُؤْمِنُوا۟","لَعَلَّهُمْ يَرْشُدُونَ",146],["3:38:8",55,"لِى","[for] me","قَالَ رَبِّ هَبْ","مِن لَّدُنكَ ذُرِّيَّةًۭ",146],["3:40:5",55,"لِى","for me","رَبِّ أَنَّىٰ يَكُونُ","غُلَـٰمٌۭ وَقَدْ بَلَغَنِىَ",146],["3:41:4",55,"لِّىٓ","for me","قَالَ رَبِّ ٱجْعَل","ءَايَةًۭ ۖ قَالَ ءَايَتُكَ",146],["3:47:5",56,"لِى","for me","رَبِّ أَنَّىٰ يَكُونُ","وَلَدٌۭ وَلَمْ يَمْسَسْنِى",146],["3:79:15",60,"لِّى","of me","لِلنَّاسِ كُونُوا۟ عِبَادًۭا","مِن دُونِ ٱللَّهِ",146],["5:111:7",126,"بِى","in Me","ٱلْحَوَارِيِّـۧنَ أَنْ ءَامِنُوا۟","وَبِرَسُولِى قَالُوٓا۟ ءَامَنَّا",146],["5:116:20",127,"لِىٓ","for me","سُبْحَـٰنَكَ مَا يَكُونُ","أَنْ أَقُولَ مَا",146],["5:116:25",127,"لِى","I","أَقُولَ مَا لَيْسَ","بِحَقٍّ ۚ إِن كُنتُ",146],["7:61:4",158,"بِى","in me","قَالَ يَـٰقَوْمِ لَيْسَ","ضَلَـٰلَةٌۭ وَلَـٰكِنِّى رَسُولٌۭ",146],["7:67:4",158,"بِى","in me","قَالَ يَـٰقَوْمِ لَيْسَ","سَفَاهَةٌۭ وَلَـٰكِنِّى رَسُولٌۭ",146],["7:150:33",169,"بِىَ","over me","يَقْتُلُونَنِى فَلَا تُشْمِتْ","ٱلْأَعْدَآءَ وَلَا تَجْعَلْنِى",146],["7:151:4",169,"لِى","me","قَالَ رَبِّ ٱغْفِرْ","وَلِأَخِى وَأَدْخِلْنَا فِى",146],["9:49:5",195,"لِّى","Grant me leave","مَّن يَقُولُ ٱئْذَن","وَلَا تَفْتِنِّىٓ ۚ أَلَا",146],["10:15:20",210,"لِىٓ","for me","قُلْ مَا يَكُونُ","أَنْ أُبَدِّلَهُۥ مِن",146],["10:41:4",213,"لِّى","For me","وَإِن كَذَّبُوكَ فَقُل","عَمَلِى وَلَكُمْ عَمَلُكُمْ ۖ",146],["11:47:10",227,"لِى","I have","أَسْـَٔلَكَ مَا لَيْسَ","بِهِۦ عِلْمٌۭ ۖ وَإِلَّا",146],["11:47:15",227,"لِى","me","عِلْمٌۭ ۖ وَإِلَّا تَغْفِرْ","وَتَرْحَمْنِىٓ أَكُن مِّنَ",146],["11:80:4",230,"لِى","I had","قَالَ لَوْ أَنَّ","بِكُمْ قُوَّةً أَوْ",146],["12:4:14",235,"لِى","to me","وَٱلشَّمْسَ وَٱلْقَمَرَ رَأَيْتُهُمْ","سَـٰجِدِينَ",146],["12:80:29",245,"لِىٓ","me","ٱلْأَرْضَ حَتَّىٰ يَأْذَنَ","أَبِىٓ أَوْ يَحْكُمَ",146],["12:80:34",245,"لِى ۖ","for me","أَوْ يَحْكُمَ ٱللَّهُ","وَهُوَ خَيْرُ ٱلْحَـٰكِمِينَ",146],["12:100:21",247,"بِىٓ","to me","حَقًّۭا ۖ وَقَدْ أَحْسَنَ","إِذْ أَخْرَجَنِى مِنَ",146],["14:22:15",258,"لِىَ","I had","فَأَخْلَفْتُكُمْ ۖ وَمَا كَانَ","عَلَيْكُم مِّن سُلْطَـٰنٍ",146],["14:22:23",258,"لِى ۖ","to me","أَن دَعَوْتُكُمْ فَٱسْتَجَبْتُمْ","فَلَا تَلُومُونِى وَلُومُوٓا۟",146],["14:39:5",260,"لِى","me","لِلَّهِ ٱلَّذِى وَهَبَ","عَلَى ٱلْكِبَرِ إِسْمَـٰعِيلَ",146],["14:41:3",260,"لِى","me","رَبَّنَا ٱغْفِرْ","وَلِوَٰلِدَىَّ وَلِلْمُؤْمِنِينَ يَوْمَ",146],["17:80:10",290,"لِّى","for me","مُخْرَجَ صِدْقٍۢ وَٱجْعَل","مِن لَّدُنكَ سُلْطَـٰنًۭا",146],["19:5:10",305,"لِى","[to] me","ٱمْرَأَتِى عَاقِرًۭا فَهَبْ","مِن لَّدُنكَ وَلِيًّۭا",146],["19:8:5",305,"لِى","I have","رَبِّ أَنَّىٰ يَكُونُ","غُلَـٰمٌۭ وَكَانَتِ ٱمْرَأَتِى",146],["19:10:4",305,"لِّىٓ","for me","قَالَ رَبِّ ٱجْعَل","ءَايَةًۭ ۚ قَالَ ءَايَتُكَ",146],["19:20:4",306,"لِى","for me","قَالَتْ أَنَّىٰ يَكُونُ","غُلَـٰمٌۭ وَلَمْ يَمْسَسْنِى",146],["19:47:9",308,"بِى","to me","رَبِّىٓ ۖ إِنَّهُۥ كَانَ","حَفِيًّۭا",146],["20:18:10",313,"وَلِىَ","and for me","بِهَا عَلَىٰ غَنَمِى","فِيهَا مَـَٔارِبُ أُخْرَىٰ",146],["20:25:4",313,"لِى","for me","قَالَ رَبِّ ٱشْرَحْ","صَدْرِى",146],["20:26:2",313,"لِىٓ","for me","وَيَسِّرْ","أَمْرِى",146],["20:29:2",313,"لِّى","for me","وَٱجْعَل","وَزِيرًۭا مِّنْ أَهْلِى",146],["20:39:13",314,"لِّى","to Me","بِٱلسَّاحِلِ يَأْخُذْهُ عَدُوٌّۭ","وَعَدُوٌّۭ لَّهُۥ ۚ وَأَلْقَيْتُ",146],["20:96:15",318,"لِى","to me","فَنَبَذْتُهَا وَكَذَٰلِكَ سَوَّلَتْ","نَفْسِى",146],["22:26:9",335,"بِى","with Me","أَن لَّا تُشْرِكْ","شَيْـًۭٔا وَطَهِّرْ بَيْتِىَ",146],["24:55:30",357,"بِى","with Me","يَعْبُدُونَنِى لَا يُشْرِكُونَ","شَيْـًۭٔا ۚ وَمَن كَفَرَ",146],["26:21:6",368,"لِى","to me","لَمَّا خِفْتُكُمْ فَوَهَبَ","رَبِّى حُكْمًۭا وَجَعَلَنِى",146],["26:77:3",370,"لِّىٓ","to me","فَإِنَّهُمْ عَدُوٌّۭ","إِلَّا رَبَّ ٱلْعَـٰلَمِينَ",146],["26:82:5",370,"لِى","for me","أَطْمَعُ أَن يَغْفِرَ","خَطِيٓـَٔتِى يَوْمَ ٱلدِّينِ",146],["26:83:3",370,"لِى","[for] me","رَبِّ هَبْ","حُكْمًۭا وَأَلْحِقْنِى بِٱلصَّـٰلِحِينَ",146],["26:84:2",371,"لِّى","[for] me","وَٱجْعَل","لِسَانَ صِدْقٍۢ فِى",146],["27:20:5",378,"لِىَ","Why","ٱلطَّيْرَ فَقَالَ مَا","لَآ أَرَى ٱلْهُدْهُدَ",146],["28:9:6",386,"لِّى","for me","فِرْعَوْنَ قُرَّتُ عَيْنٍۢ","وَلَكَ ۖ لَا تَقْتُلُوهُ",146],["28:16:7",387,"لِى","[for] me","ظَلَمْتُ نَفْسِى فَٱغْفِرْ","فَغَفَرَ لَهُۥٓ ۚ إِنَّهُۥ",146],["28:38:12",390,"لِى","for me","إِلَـٰهٍ غَيْرِى فَأَوْقِدْ","يَـٰهَـٰمَـٰنُ عَلَى ٱلطِّينِ",146],["28:38:17",390,"لِّى","for me","عَلَى ٱلطِّينِ فَٱجْعَل","صَرْحًۭا لَّعَلِّىٓ أَطَّلِعُ",146],["29:8:8",397,"بِى","with Me","وَإِن جَـٰهَدَاكَ لِتُشْرِكَ","مَا لَيْسَ لَكَ",146],["31:14:14",412,"لِى","to Me","عَامَيْنِ أَنِ ٱشْكُرْ","وَلِوَٰلِدَيْكَ إِلَىَّ ٱلْمَصِيرُ",146],["31:15:6",412,"بِى","with Me","عَلَىٰٓ أَن تُشْرِكَ","مَا لَيْسَ لَكَ",146],["36:22:2",441,"لِىَ","(is) for me","وَمَا","لَآ أَعْبُدُ ٱلَّذِى",146],["36:27:3",441,"لِى","me","بِمَا غَفَرَ","رَبِّى وَجَعَلَنِى مِنَ",146],["37:51:6",447,"لِى","for me","مِّنْهُمْ إِنِّى كَانَ","قَرِينٌۭ",146],["37:100:3",449,"لِى","me","رَبِّ هَبْ","مِنَ ٱلصَّـٰلِحِينَ",146],["38:23:8",454,"وَلِىَ","while I have","تِسْعٌۭ وَتِسْعُونَ نَعْجَةًۭ","نَعْجَةٌۭ وَٰحِدَةٌۭ فَقَالَ",146],["38:35:4",455,"لِى","me","قَالَ رَبِّ ٱغْفِرْ","وَهَبْ لِى مُلْكًۭا",146],["38:35:6",455,"لِى","me","ٱغْفِرْ لِى وَهَبْ","مُلْكًۭا لَّا يَنۢبَغِى",146],["38:69:3",457,"لِىَ","for me","مَا كَانَ","مِنْ عِلْمٍۭ بِٱلْمَلَإِ",146],["39:58:8",465,"لِى","for me","ٱلْعَذَابَ لَوْ أَنَّ","كَرَّةًۭ فَأَكُونَ مِنَ",146],["40:36:5",471,"لِى","for me","فِرْعَوْنُ يَـٰهَـٰمَـٰنُ ٱبْنِ","صَرْحًۭا لَّعَلِّىٓ أَبْلُغُ",146],["40:41:3",472,"لِىٓ","for me","۞ وَيَـٰقَوْمِ مَا","أَدْعُوكُمْ إِلَى ٱلنَّجَوٰةِ",146],["40:42:8",472,"لِى","for me","بِهِۦ مَا لَيْسَ","بِهِۦ عِلْمٌۭ وَأَنَا۠",146],["41:50:11",482,"لِى","(due) to me","مَسَّتْهُ لَيَقُولَنَّ هَـٰذَا","وَمَآ أَظُنُّ ٱلسَّاعَةَ",146],["41:50:21",482,"لِى","for me","إِلَىٰ رَبِّىٓ إِنَّ","عِندَهُۥ لَلْحُسْنَىٰ ۚ فَلَنُنَبِّئَنَّ",146],["43:51:8",493,"لِى","for me","قَالَ يَـٰقَوْمِ أَلَيْسَ","مُلْكُ مِصْرَ وَهَـٰذِهِ",146],["44:21:4",497,"لِى","me","وَإِن لَّمْ تُؤْمِنُوا۟","فَٱعْتَزِلُونِ",146],["46:8:9",503,"لِى","for me","ٱفْتَرَيْتُهُۥ فَلَا تَمْلِكُونَ","مِنَ ٱللَّهِ شَيْـًٔا ۖ",146],["46:9:11",503,"بِى","with me","أَدْرِى مَا يُفْعَلُ","وَلَا بِكُمْ ۖ إِنْ",146],["46:15:37",504,"لِى","for me","صَـٰلِحًۭا تَرْضَىٰهُ وَأَصْلِحْ","فِى ذُرِّيَّتِىٓ ۖ إِنِّى",146],["66:11:12",561,"لِى","for me","قَالَتْ رَبِّ ٱبْنِ","عِندَكَ بَيْتًۭا فِى",146],["71:28:3",571,"لِى","me","رَّبِّ ٱغْفِرْ","وَلِوَٰلِدَىَّ وَلِمَن دَخَلَ",146],["109:6:3",603,"وَلِىَ","and for me","لَكُمْ دِينُكُمْ","دِينِ",146]]