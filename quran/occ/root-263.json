[["2:36:19",6,"حِينٍۢ","a period","مُسْتَقَرٌّۭ وَمَتَـٰعٌ إِلَىٰ","",328],["2:177:44",27,"وَحِينَ","and (the) time","فِى ٱلْبَأْسَآءِ وَٱلضَّرَّآءِ","ٱلْبَأْسِ ۗ أُو۟لَـٰٓئِكَ ٱلَّذِينَ",328],["5:101:15",124,"حِينَ","when","وَإِن تَسْـَٔلُوا۟ عَنْهَا","يُنَزَّلُ ٱلْقُرْءَانُ تُبْدَ",328],["5:106:10",125,"حِينَ","(at the) time (of making)","حَضَرَ أَحَدَكُمُ ٱلْمَوْتُ","ٱلْوَصِيَّةِ ٱثْنَانِ ذَوَا",328],["7:24:12",153,"حِينٍۢ","a time","مُسْتَقَرٌّۭ وَمَتَـٰعٌ إِلَىٰ","",328],["10:98:21",220,"حِينٍۢ","a time","ٱلدُّنْيَا وَمَتَّعْنَـٰهُمْ إِلَىٰ","",328],["11:5:8",221,"حِينَ","when","لِيَسْتَخْفُوا۟ مِنْهُ ۚ أَلَا","يَسْتَغْشُونَ ثِيَابَهُمْ يَعْلَمُ",328],["12:35:11",239,"حِينٍۢ","a time","ٱلْـَٔايَـٰتِ لَيَسْجُنُنَّهُۥ حَتَّىٰ","",328],["14:25:4",259,"حِينٍۭ","time","تُؤْتِىٓ أُكُلَهَا كُلَّ","بِإِذْنِ رَبِّهَا ۗ وَيَضْرِبُ",328],["16:6:4",267,"حِينَ","when","وَلَكُمْ فِيهَا جَمَالٌ","تُرِيحُونَ وَحِينَ تَسْرَحُونَ",328],["16:6:6",267,"وَحِينَ","and when","جَمَالٌ حِينَ تُرِيحُونَ","تَسْرَحُونَ",328],["16:80:25",276,"حِينٍۢ","a time","أَثَـٰثًۭا وَمَتَـٰعًا إِلَىٰ","",328],["21:39:5",325,"حِينَ","(the) time","يَعْلَمُ ٱلَّذِينَ كَفَرُوا۟","لَا يَكُفُّونَ عَن",328],["21:111:8",331,"حِينٍۢ","a time","لَّكُمْ وَمَتَـٰعٌ إِلَىٰ","",328],["23:25:10",343,"حِينٍۢ","a time","فَتَرَبَّصُوا۟ بِهِۦ حَتَّىٰ","",328],["23:54:5",345,"حِينٍ","a time","فِى غَمْرَتِهِمْ حَتَّىٰ","",328],["24:58:19",357,"وَحِينَ","and when","قَبْلِ صَلَوٰةِ ٱلْفَجْرِ","تَضَعُونَ ثِيَابَكُم مِّنَ",328],["25:42:12",363,"حِينَ","when","عَلَيْهَا ۚ وَسَوْفَ يَعْلَمُونَ","يَرَوْنَ ٱلْعَذَابَ مَنْ",328],["26:218:3",376,"حِينَ","when","ٱلَّذِى يَرَىٰكَ","تَقُومُ",328],["28:15:4",387,"حِينِ","a time","وَدَخَلَ ٱلْمَدِينَةَ عَلَىٰ","غَفْلَةٍۢ مِّنْ أَهْلِهَا",328],["30:17:3",406,"حِينَ","when","فَسُبْحَـٰنَ ٱللَّهِ","تُمْسُونَ وَحِينَ تُصْبِحُونَ",328],["30:17:5",406,"وَحِينَ","and when","ٱللَّهِ حِينَ تُمْسُونَ","تُصْبِحُونَ",328],["30:18:7",406,"وَحِينَ","and when","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَعَشِيًّۭ