[["6:125:6",144,"يَشْرَحْ","He expands","ٱللَّهُ أَن يَهْدِيَهُۥ","صَدْرَهُۥ لِلْإِسْلَـٰمِ ۖ وَمَن",1264],["16:106:15",279,"شَرَحَ","opens","بِٱلْإِيمَـٰنِ وَلَـٰكِن مَّن","بِٱلْكُفْرِ صَدْرًۭا فَعَلَيْهِمْ",1264],["20:25:3",313,"ٱشْرَحْ","Expand","قَالَ رَبِّ","لِى صَدْرِى",1264],["39:22:2",461,"شَرَحَ","Allah has expanded","أَفَمَن","ٱللَّهُ صَدْرَهُۥ لِلْإِسْلَـٰمِ",1264],["94:1:2",596,"نَشْرَحْ","We expanded","أَلَمْ","لَكَ صَدْرَكَ",1264]]