[["2:17:10",4,"ذَهَبَ","took away","أَضَآءَتْ مَا حَوْلَهُۥ","ٱللَّهُ بِنُورِهِمْ وَتَرَكَهُمْ",326],["2:20:17",4,"لَذَهَبَ","He would certainly have taken away","وَلَوْ شَآءَ ٱللَّهُ","بِسَمْعِهِمْ وَأَبْصَـٰرِهِمْ ۚ إِنَّ",326],["3:14:11",51,"ٱلذَّهَبِ","[the] gold","وَٱلْقَنَـٰطِيرِ ٱلْمُقَنطَرَةِ مِنَ","وَٱلْفِضَّةِ وَٱلْخَيْلِ ٱلْمُسَوَّمَةِ",948],["3:91:13",61,"ذَهَبًۭا","(of) gold","أَحَدِهِم مِّلْءُ ٱلْأَرْضِ","وَلَوِ ٱفْتَدَىٰ بِهِۦٓ ۗ",948],["4:19:13",80,"لِتَذْهَبُوا۟","so that you may take","كَرْهًۭا ۖ وَلَا تَعْضُلُوهُنَّ","بِبَعْضِ مَآ ءَاتَيْتُمُوهُنَّ",326],["4:133:3",99,"يُذْهِبْكُمْ","He can take you away","إِن يَشَأْ","أَيُّهَا ٱلنَّاسُ وَيَأْتِ",761],["5:24:10",112,"فَٱذْهَبْ","So go","مَّا دَامُوا۟ فِيهَا ۖ","أَنتَ وَرَبُّكَ فَقَـٰتِلَآ",326],["6:133:7",145,"يُذْهِبْكُمْ","He can take you away","ٱلرَّحْمَةِ ۚ إِن يَشَأْ","وَيَسْتَخْلِفْ مِنۢ بَعْدِكُم",761],["8:11:13",178,"وَيُذْهِبَ","and take away","مَآءًۭ لِّيُطَهِّرَكُم بِهِۦ","عَنكُمْ رِجْزَ ٱلشَّيْطَـٰنِ",761],["8:46:7",183,"وَتَذْهَبَ","and (would) depart","وَلَا تَنَـٰزَعُوا۟ فَتَفْشَلُوا۟","رِيحُكُمْ ۖ وَٱصْبِرُوٓا۟ ۚ إِنَّ",326],["9:15:1",189,"وَيُذْهِبْ","And remove","","غَيْظَ قُلُوبِهِمْ ۗ وَيَتُوبُ",761],["9:34:19",192,"ٱلذَّهَبَ","the gold","ٱللَّهِ ۗ وَٱلَّذِينَ يَكْنِزُونَ","وَٱلْفِضَّةَ وَلَا يُنفِقُونَهَا",948],["11:10:8",222,"ذَهَبَ","Have gone","ضَرَّآءَ مَسَّتْهُ لَيَقُولَنَّ","ٱلسَّيِّـَٔاتُ عَنِّىٓ ۚ إِنَّهُۥ",326],["11:74:2",230,"ذَهَبَ","(had) gone away","فَلَمَّا","عَنْ إِبْرَٰهِيمَ ٱلرَّوْعُ",326],["11:114:10",234,"يُذْهِبْنَ","remove","ٱلَّيْلِ ۚ إِنَّ ٱلْحَسَنَـٰتِ","ٱلسَّيِّـَٔاتِ ۚ ذَٰلِكَ ذِكْرَىٰ",761],["12:13:5",236,"تَذْهَبُوا۟","you should take him","إِنِّى لَيَحْزُنُنِىٓ أَن","بِهِۦ وَأَخَافُ أَن",326],["12:15:2",237,"ذَهَبُوا۟","they took him","فَلَمَّا","بِهِۦ وَأَجْمَعُوٓا۟ أَن",326],["12:17:4",237,"ذَهَبْنَا","[we] went","قَالُوا۟ يَـٰٓأَبَانَآ إِنَّا","نَسْتَبِقُ وَتَرَكْنَا يُوسُفَ",326],["12:87:2",246,"ٱذْهَبُوا۟","Go","يَـٰبَنِىَّ","فَتَحَسَّسُوا۟ مِن يُوسُفَ",326],["12:93:1",246,"ٱذْهَبُوا۟","Go","","بِقَمِيصِى هَـٰذَا فَأَلْقُوهُ",326],["13:17:30",251,"فَيَذْهَبُ","it passes away","وَٱلْبَـٰطِلَ ۚ فَأَمَّا ٱلزَّبَدُ","جُفَآءًۭ ۖ وَأَمَّا مَا",326],["14:19:11",258,"يُذْهِبْكُمْ","He can remove you","بِٱلْحَقِّ ۚ إِن يَشَأْ","وَيَأْتِ بِخَلْقٍۢ جَدِيدٍۢ",761],["17:63:2",288,"ٱذْهَبْ","Go","قَالَ","فَمَن تَبِعَكَ مِنْهُمْ",326],["17:86:3",290,"لَنَذْهَبَنَّ","We (would) have surely taken away","وَلَئِن شِئْنَا","بِٱلَّذِىٓ أَوْحَيْنَآ إِلَيْكَ",326],["18:31:14",297,"ذَهَبٍۢ","gold","مِنْ أَسَاوِرَ مِن","وَيَلْبَسُونَ ثِيَابًا خُضْرًۭا",948],["20:24:1",313,"ٱذْهَبْ","Go","","إِلَىٰ فِرْعَوْنَ إِنَّهُۥ",326],["20:42:1",314,"ٱذْهَبْ","Go","","أَنتَ وَأَخُوكَ بِـَٔايَـٰتِى",326],["20:43:1",314,"ٱذْهَبَآ","Go, both of you","","إِلَىٰ فِرْعَوْنَ إِنَّهُۥ",326],["20:63:11",315,"وَيَذْهَبَا","and do away","مِّنْ أَرْضِكُم بِسِحْرِهِمَا","بِطَرِيقَتِكُمُ ٱلْمُثْلَىٰ",326],["20:97:2",318,"فَٱذْهَبْ","Then go","قَالَ","فَإِنَّ لَكَ فِى",326],["21:87:4",329,"ذَّهَبَ","he went","وَذَا ٱلنُّونِ إِذ","مُغَـٰضِبًۭا فَظَنَّ أَن",326],["22:15:19",333,"يُذْهِبَنَّ","will remove","لْيَقْطَعْ فَلْيَنظُرْ هَلْ","كَيْدُهُۥ مَا يَغِيظُ",761],["22:23:18",334,"ذَهَبٍۢ","gold","مِنْ أَسَاوِرَ مِن","وَلُؤْلُؤًۭا ۖ وَلِبَاسُهُمْ فِيهَا",948],["23:18:11",343,"ذَهَابٍۭ","taking it away","ٱلْأَرْضِ ۖ وَإِنَّا عَلَىٰ","بِهِۦ لَقَـٰدِرُونَ",2913],["23:91:12",348,"لَّذَهَبَ","surely (would have) taken away","مِنْ إِلَـٰهٍ ۚ إِذًۭا","كُلُّ إِلَـٰهٍۭ بِمَا",326],["24:43:37",355,"يَذْهَبُ","takes away","يَكَادُ سَنَا بَرْقِهِۦ","بِٱلْأَبْصَـٰرِ",326],["24:62:14",359,"يَذْهَبُوا۟","they go","أَمْرٍۢ جَامِعٍۢ لَّمْ","حَتَّىٰ يَسْتَـْٔذِنُوهُ ۚ إِنَّ",326],["25:36:2",363,"ٱذْهَبَآ","Go both of you","فَقُلْنَا","إِلَى ٱلْقَوْمِ ٱلَّذِينَ",326],["26:15:3",367,"فَٱذْهَبَا","go both of you","قَالَ كَلَّا ۖ","بِـَٔايَـٰتِنَآ ۖ إِنَّا مَعَكُم",326],["27:28:1",379,"ٱذْهَب","Go","","بِّكِتَـٰبِى هَـٰذَا فَأَلْقِهْ",326],["33:19:17",420,"ذَهَبَ","departs","مِنَ ٱلْمَوْتِ ۖ فَإِذَا","ٱلْخَوْفُ سَلَقُوكُم بِأَلْسِنَةٍ",326],["33:20:4",420,"يَذْهَبُوا۟ ۖ","withdrawn","يَحْسَبُونَ ٱلْأَحْزَابَ لَمْ","وَإِن يَأْتِ ٱلْأَحْزَابُ",326],["33:33:19",422,"لِيُذْهِبَ","to remove","إِنَّمَا يُرِيدُ ٱللَّهُ","عَنكُمُ ٱلرِّجْسَ أَهْلَ",761],["35:8:17",435,"تَذْهَبْ","go out","مَن يَشَآءُ ۖ فَلَا","نَفْسُكَ عَلَيْهِمْ حَسَرَٰتٍ ۚ",326],["35:16:3",436,"يُذْهِبْكُمْ","He (can) do away with you","إِن يَشَأْ","وَيَأْتِ بِخَلْقٍۢ جَدِيدٍۢ",761],["35:33:9",438,"ذَهَبٍۢ","gold","مِنْ أَسَاوِرَ مِن","وَلُؤْلُؤًۭا ۖ وَلِبَاسُهُمْ فِيهَا",948],["35:34:5",438,"أَذْهَبَ","(has) removed","ٱلْحَمْدُ لِلَّهِ ٱلَّذِىٓ","عَنَّا ٱلْحَزَنَ ۖ إِنَّ",761],["37:99:3",449,"ذَاهِبٌ","going","وَقَالَ إِنِّى","إِلَىٰ رَبِّى سَيَهْدِينِ",2911],["43:41:2",492,"نَذْهَبَنَّ","We take you away","فَإِمَّا","بِكَ فَإِنَّا مِنْهُم",326],["43:53:6",493,"ذَهَبٍ","gold","عَلَيْهِ أَسْوِرَةٌۭ مِّن","أَوْ جَآءَ مَعَهُ",948],["43:71:5",494,"ذَهَبٍۢ","gold","عَلَيْهِم بِصِحَافٍۢ مِّن","وَأَكْوَابٍۢ ۖ وَفِيهَا مَا",948],["46:20:7",504,"أَذْهَبْتُمْ","You exhausted","كَفَرُوا۟ عَلَى ٱلنَّارِ","طَيِّبَـٰتِكُمْ فِى حَيَاتِكُمُ",761],["60:11:11",550,"ذَهَبَتْ","have gone","فَعَاقَبْتُمْ فَـَٔاتُوا۟ ٱلَّذِينَ","أَزْوَٰجُهُم مِّثْلَ مَآ",326],["75:33:2",578,"ذَهَبَ","he went","ثُمَّ","إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ",326],["79:17:1",584,"ٱذْهَبْ","Go","","إِلَىٰ فِرْعَوْنَ إِنَّهُۥ",326],["81:26:2",586,"تَذْهَبُونَ","are you going","فَأَيْنَ","",326]]