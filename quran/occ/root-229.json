[["2:38:17",7,"يَحْزَنُونَ","will grieve","عَلَيْهِمْ وَلَا هُمْ","",321],["2:62:24",10,"يَحْزَنُونَ","will grieve","عَلَيْهِمْ وَلَا هُمْ","",321],["2:112:17",17,"يَحْزَنُونَ","(will) grieve","عَلَيْهِمْ وَلَا هُمْ","",321],["2:262:24",44,"يَحْزَنُونَ","will grieve","عَلَيْهِمْ وَلَا هُمْ","",321],["2:274:17",46,"يَحْزَنُونَ","will grieve","عَلَيْهِمْ وَلَا هُمْ","",321],["2:277:19",47,"يَحْزَنُونَ","will grieve","عَلَيْهِمْ وَلَا هُمْ","",321],["3:139:4",67,"تَحْزَنُوا۟","grieve","وَلَا تَهِنُوا۟ وَلَا","وَأَنتُمُ ٱلْأَعْلَوْنَ إِن",321],["3:153:15",69,"تَحْزَنُوا۟","you grieve","غَمًّۢا بِغَمٍّۢ لِّكَيْلَا","عَلَىٰ مَا فَاتَكُمْ",321],["3:170:19",72,"يَحْزَنُونَ","will grieve","عَلَيْهِمْ وَلَا هُمْ","",321],["3:176:2",73,"يَحْزُنكَ","grieve you","وَلَا","ٱلَّذِينَ يُسَـٰرِعُونَ فِى",321],["5:41:4",114,"يَحْزُنكَ","grieve you","۞ يَـٰٓأَيُّهَا ٱلرَّسُولُ لَا","ٱلَّذِينَ يُسَـٰرِعُونَ فِى",321],["5:69:20",119,"يَحْزَنُونَ","will grieve","عَلَيْهِمْ وَلَا هُمْ","",321],["6:33:4",131,"لَيَحْزُنُكَ","grieves you","قَدْ نَعْلَمُ إِنَّهُۥ","ٱلَّذِى يَقُولُونَ ۖ فَإِنَّهُمْ",321],["6:48:15",133,"يَحْزَنُونَ","will grieve","عَلَيْهِمْ وَلَا هُمْ","",321],["7:35:18",154,"يَحْزَنُونَ","will grieve","عَلَيْهِمْ وَلَا هُمْ","",321],["7:49:15",156,"تَحْزَنُونَ","will grieve","عَلَيْكُمْ وَلَآ أَنتُمْ","",321],["9:40:20",193,"تَحْزَنْ","grieve","يَقُولُ لِصَـٰحِبِهِۦ لَا","إِنَّ ٱللَّهَ مَعَنَا ۖ",321],["9:92:19",201,"حَزَنًا","(of) sorrow","تَفِيضُ مِنَ ٱلدَّمْعِ","أَلَّا يَجِدُوا۟ مَا",1786],["10:62:10",216,"يَحْزَنُونَ","will grieve","عَلَيْهِمْ وَلَا هُمْ","",321],["10:65:2",216,"يَحْزُنكَ","grieve you","وَلَا","قَوْلُهُمْ ۘ إِنَّ ٱلْعِزَّةَ",321],["12:13:3",236,"لَيَحْزُنُنِىٓ","it surely saddens me","قَالَ إِنِّى","أَن تَذْهَبُوا۟ بِهِۦ",321],["12:84:10",245,"ٱلْحُزْنِ","the grief","وَٱبْيَضَّتْ عَيْنَاهُ مِنَ","فَهُوَ كَظِيمٌۭ",2284],["12:86:5",245,"وَحُزْنِىٓ","and my grief","إِنَّمَآ أَشْكُوا۟ بَثِّى","إِلَى ٱللَّهِ وَأَعْلَمُ",2284],["15:88:11",266,"تَحْزَنْ","grieve","أَزْوَٰجًۭا مِّنْهُمْ وَلَا","عَلَيْهِمْ وَٱخْفِضْ جَنَاحَكَ",321],["16:127:7",281,"تَحْزَنْ","grieve","إِلَّا بِٱللَّهِ ۚ وَلَا","عَلَيْهِمْ وَلَا تَكُ",321],["19:24:5",306,"تَحْزَنِى","grieve","مِن تَحْتِهَآ أَلَّا","قَدْ جَعَلَ رَبُّكِ",321],["20:40:17",314,"تَحْزَنَ ۚ","she grieves","تَقَرَّ عَيْنُهَا وَلَا","وَقَتَلْتَ نَفْسًۭا فَنَجَّيْنَـٰكَ",321],["21:103:2",331,"يَحْزُنُهُمُ","will grieve them","لَا","ٱلْفَزَعُ ٱلْأَكْبَرُ وَتَتَلَقَّىٰهُمُ",321],["27:70:2",383,"تَحْزَنْ","grieve","وَلَا","عَلَيْهِمْ وَلَا تَكُن",321],["28:7:16",386,"تَحْزَنِىٓ ۖ","grieve","وَلَا تَخَافِى وَلَا","إِنَّا رَآدُّوهُ إِلَيْكِ",321],["28:8:7",386,"وَحَزَنًا ۗ","and a grief","لِيَكُونَ لَهُمْ عَدُوًّۭا","إِنَّ فِرْعَوْنَ وَهَـٰمَـٰنَ",1786],["28:13:8",386,"تَحْزَنَ","she may grieve","تَقَرَّ عَيْنُهَا وَلَا","وَلِتَعْلَمَ أَنَّ وَعْدَ",321],["29:33:15",400,"تَحْزَنْ ۖ","grieve","لَا تَخَفْ وَلَا","إِنَّا مُنَجُّوكَ وَأَهْلَكَ",321],["31:23:4",413,"يَحْزُنكَ","grieve you","وَمَن كَفَرَ فَلَا","كُفْرُهُۥٓ ۚ إِلَيْنَا مَرْجِعُهُمْ",321],["33:51:22",425,"يَحْزَنَّ","they grieve","تَقَرَّ أَعْيُنُهُنَّ وَلَا","وَيَرْضَيْنَ بِمَآ ءَاتَيْتَهُنَّ",321],["35:34:7",438,"ٱلْحَزَنَ ۖ","the sorrow","ٱلَّذِىٓ أَذْهَبَ عَنَّا","إِنَّ رَبَّنَا لَغَفُورٌۭ",1786],["36:76:2",445,"يَحْزُنكَ","grieve you","فَلَا","قَوْلُهُمْ ۘ إِنَّا نَعْلَمُ",321],["39:61:11",465,"يَحْزَنُونَ","will grieve","ٱلسُّوٓءُ وَلَا هُمْ","",321],["41:30:14",480,"تَحْزَنُوا۟","grieve","أَلَّا تَخَافُوا۟ وَلَا","وَأَبْشِرُوا۟ بِٱلْجَنَّةِ ٱلَّتِى",321],["43:68:8",494,"تَحْزَنُونَ","will grieve","ٱلْيَوْمَ وَلَآ أَنتُمْ","",321],["46:13:13",503,"يَحْزَنُونَ","will grieve","عَلَيْهِمْ وَلَا هُمْ","",321],["58:10:5",543,"لِيَحْزُنَ","that he may grieve","ٱلنَّجْوَىٰ مِنَ ٱلشَّيْطَـٰنِ","ٱلَّذِينَ ءَامَنُوا۟ وَلَيْسَ",321]]