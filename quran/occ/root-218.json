[["2:238:1",39,"حَـٰفِظُوا۟","Guard strictly","","عَلَى ٱلصَّلَوَٰتِ وَٱلصَّلَوٰةِ",1679],["2:255:47",42,"حِفْظُهُمَا ۚ","(the) guarding of both of them","وَٱلْأَرْضَ ۖ وَلَا يَـُٔودُهُۥ","وَهُوَ ٱلْعَلِىُّ ٱلْعَظِيمُ",1788],["4:34:17",84,"حَـٰفِظَـٰتٌۭ","guarding","أَمْوَٰلِهِمْ ۚ فَٱلصَّـٰلِحَـٰتُ قَـٰنِتَـٰتٌ","لِّلْغَيْبِ بِمَا حَفِظَ",2272],["4:34:20",84,"حَفِظَ","(orders) them to guard","حَـٰفِظَـٰتٌۭ لِّلْغَيْبِ بِمَا","ٱللَّهُ ۚ وَٱلَّـٰتِى تَخَافُونَ",1055],["4:80:12",91,"حَفِيظًۭا","(as) a guardian","فَمَآ أَرْسَلْنَـٰكَ عَلَيْهِمْ","",720],["5:44:17",115,"ٱسْتُحْفِظُوا۟","they were entrusted","وَٱلرَّبَّـٰنِيُّونَ وَٱلْأَحْبَارُ بِمَا","مِن كِتَـٰبِ ٱللَّهِ",4842],["5:89:37",122,"وَٱحْفَظُوٓا۟","And guard","أَيْمَـٰنِكُمْ إِذَا حَلَفْتُمْ ۚ","أَيْمَـٰنَكُمْ ۚ كَذَٰلِكَ يُبَيِّنُ",1055],["6:61:7",135,"حَفَظَةً","guardians","عِبَادِهِۦ ۖ وَيُرْسِلُ عَلَيْكُمْ","حَتَّىٰٓ إِذَا جَآءَ",720],["6:92:22",139,"يُحَافِظُونَ","(are) guarding","وَهُمْ عَلَىٰ صَلَاتِهِمْ","",1679],["6:104:15",141,"بِحَفِيظٍۢ","a guardian","وَمَآ أَنَا۠ عَلَيْكُم","",720],["6:107:9",141,"حَفِيظًۭا ۖ","a guardian","وَمَا جَعَلْنَـٰكَ عَلَيْهِمْ","وَمَآ أَنتَ عَلَيْهِم",720],["9:112:12",205,"وَٱلْحَـٰفِظُونَ","and those who observe","وَٱلنَّاهُونَ عَنِ ٱلْمُنكَرِ","لِحُدُودِ ٱللَّهِ ۗ وَبَشِّرِ",680],["11:57:21",228,"حَفِيظٌۭ","a Guardian","عَلَىٰ كُلِّ شَىْءٍ","",720],["11:86:11",231,"بِحَفِيظٍۢ","a guardian","وَمَآ أَنَا۠ عَلَيْكُم","",720],["12:12:8",236,"لَحَـٰفِظُونَ","(will) surely (be) guardians","وَيَلْعَبْ وَإِنَّا لَهُۥ","",680],["12:55:7",242,"حَفِيظٌ","(will be) a guardian","خَزَآئِنِ ٱلْأَرْضِ ۖ إِنِّى","عَلِيمٌۭ",720],["12:63:16",242,"لَحَـٰفِظُونَ","(will) surely (be) guardians","نَكْتَلْ وَإِنَّا لَهُۥ","",680],["12:64:14",243,"حَـٰفِظًۭا ۖ","Guardian","قَبْلُ ۖ فَٱللَّهُ خَيْرٌ","وَهُوَ أَرْحَمُ ٱلرَّٰحِمِينَ",680],["12:65:18",243,"وَنَحْفَظُ","and we will protect","إِلَيْنَا ۖ وَنَمِيرُ أَهْلَنَا","أَخَانَا وَنَزْدَادُ كَيْلَ",1055],["12:81:17",245,"حَـٰفِظِينَ","guardians","وَمَا كُنَّا لِلْغَيْبِ","",680],["13:11:8",250,"يَحْفَظُونَهُۥ","who guard him","يَدَيْهِ وَمِنْ خَلْفِهِۦ","مِنْ أَمْرِ ٱللَّهِ ۗ",1055],["15:9:7",262,"لَحَـٰفِظُونَ","(are) surely Guardians","ٱلذِّكْرَ وَإِنَّا لَهُۥ","",680],["15:17:1",263,"وَحَفِظْنَـٰهَا","And We have protected it","","مِن كُلِّ شَيْطَـٰنٍۢ",1055],["21:32:4",324,"مَّحْفُوظًۭا ۖ","protected","وَجَعَلْنَا ٱلسَّمَآءَ سَقْفًۭا","وَهُمْ عَنْ ءَايَـٰتِهَا",2518],["21:82:12",329,"حَـٰفِظِينَ","Guardians","ذَٰلِكَ ۖ وَكُنَّا لَهُمْ","",680],["23:5:4",342,"حَـٰفِظُونَ","(are) guardians","وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ","",680],["23:9:5",342,"يُحَافِظُونَ","they guard","هُمْ عَلَىٰ صَلَوَٰتِهِمْ","",1679],["24:30:6",353,"وَيَحْفَظُوا۟","and they should guard","يَغُضُّوا۟ مِنْ أَبْصَـٰرِهِمْ","فُرُوجَهُمْ ۚ ذَٰلِكَ أَزْكَىٰ",1055],["24:31:6",353,"وَيَحْفَظْنَ","and they should guard","يَغْضُضْنَ مِنْ أَبْصَـٰرِهِنَّ","فُرُوجَهُنَّ وَلَا يُبْدِينَ",1055],["33:35:18",422,"وَٱلْحَـٰفِظِينَ","and the men who guard","وَٱلْمُتَصَدِّقَـٰتِ وَٱلصَّـٰٓئِمِينَ وَٱلصَّـٰٓئِمَـٰتِ","فُرُوجَهُمْ وَٱلْحَـٰفِظَـٰتِ وَٱلذَّٰكِرِينَ",680],["33:35:20",422,"وَٱلْحَـٰفِظَـٰتِ","and the women who guard (it)","وَٱلصَّـٰٓئِمَـٰتِ وَٱلْحَـٰفِظِينَ فُرُوجَهُمْ","وَٱلذَّٰكِرِينَ ٱللَّهَ كَثِيرًۭا",2272],["34:21:21",430,"حَفِيظٌۭ","(is) a Guardian","عَلَىٰ كُلِّ شَىْءٍ","",720],["37:7:1",446,"وَحِفْظًۭا","And (to) guard","","مِّن كُلِّ شَيْطَـٰنٍۢ",1788],["41:12:15",478,"وَحِفْظًۭا ۚ","and (to) guard","ٱلسَّمَآءَ ٱلدُّنْيَا بِمَصَـٰبِيحَ","ذَٰلِكَ تَقْدِيرُ ٱلْعَزِيزِ",1788],["42:6:7",483,"حَفِيظٌ","(is) a Guardian","دُونِهِۦٓ أَوْلِيَآءَ ٱللَّهُ","عَلَيْهِمْ وَمَآ أَنتَ",720],["42:48:6",488,"حَفِيظًا ۖ","(as) a guardian","فَمَآ أَرْسَلْنَـٰكَ عَلَيْهِمْ","إِنْ عَلَيْكَ إِلَّا",720],["50:4:9",518,"حَفِيظٌۢ","guarded","مِنْهُمْ ۖ وَعِندَنَا كِتَـٰبٌ","",720],["50:32:6",519,"حَفِيظٍۢ","(and) who keeps","تُوعَدُونَ لِكُلِّ أَوَّابٍ","",720],["70:29:4",569,"حَـٰفِظُونَ","(are) guardians","وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ","",680],["70:34:5",569,"يُحَافِظُونَ","keep a guard","هُمْ عَلَىٰ صَلَاتِهِمْ","",1679],["82:10:3",587,"لَحَـٰفِظِينَ","(are) surely guardians","وَإِنَّ عَلَيْكُمْ","",680],["83:33:4",588,"حَـٰفِظِينَ","(as) guardians","وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ","",680],["85:22:3",590,"مَّحْفُوظٍۭ","Guarded","فِى لَوْحٍۢ","",2518],["86:4:6",591,"حَافِظٌۭ","(is) a protector","نَفْسٍۢ لَّمَّا عَلَيْهَا","",680]]