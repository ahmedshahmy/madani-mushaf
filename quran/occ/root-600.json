[["2:259:20",43,"عَامٍۢ","year(s)","فَأَمَاتَهُ ٱللَّهُ مِا۟ئَةَ","ثُمَّ بَعَثَهُۥ ۖ قَالَ",883],["2:259:36",43,"عَامٍۢ","year(s)","بَل لَّبِثْتَ مِا۟ئَةَ","فَٱنظُرْ إِلَىٰ طَعَامِكَ",883],["9:28:12",191,"عَامِهِمْ","this, their (final) year","ٱلْمَسْجِدَ ٱلْحَرَامَ بَعْدَ","هَـٰذَا ۚ وَإِنْ خِفْتُمْ",883],["9:37:11",193,"عَامًۭا","one year","ٱلَّذِينَ كَفَرُوا۟ يُحِلُّونَهُۥ","وَيُحَرِّمُونَهُۥ عَامًۭا لِّيُوَاطِـُٔوا۟",883],["9:37:13",193,"عَامًۭا","(another) year","يُحِلُّونَهُۥ عَامًۭا وَيُحَرِّمُونَهُۥ","لِّيُوَاطِـُٔوا۟ عِدَّةَ مَا",883],["9:126:7",207,"عَامٍۢ","year","يُفْتَنُونَ فِى كُلِّ","مَّرَّةً أَوْ مَرَّتَيْنِ",883],["12:49:6",241,"عَامٌۭ","a year","مِنۢ بَعْدِ ذَٰلِكَ","فِيهِ يُغَاثُ ٱلنَّاسُ",883],["29:14:12",397,"عَامًۭا","year(s)","سَنَةٍ إِلَّا خَمْسِينَ","فَأَخَذَهُمُ ٱلطُّوفَانُ وَهُمْ",883],["31:14:11",412,"عَامَيْنِ","two years","وَهْنٍۢ وَفِصَـٰلُهُۥ فِى","أَنِ ٱشْكُرْ لِى",883]]