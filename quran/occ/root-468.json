[["2:49:6",8,"يَسُومُونَكُمْ","(who were) afflicting you (with)","مِّنْ ءَالِ فِرْعَوْنَ","سُوٓءَ ٱلْعَذَابِ يُذَبِّحُونَ",1673],["2:273:18",46,"بِسِيمَـٰهُمْ","by their mark","مِنَ ٱلتَّعَفُّفِ تَعْرِفُهُم","لَا يَسْـَٔلُونَ ٱلنَّاسَ",1230],["3:14:14",51,"ٱلْمُسَوَّمَةِ","[the] branded","ٱلذَّهَبِ وَٱلْفِضَّةِ وَٱلْخَيْلِ","وَٱلْأَنْعَـٰمِ وَٱلْحَرْثِ ۗ ذَٰلِكَ",1937],["3:125:15",66,"مُسَوِّمِينَ","[the ones] having marks","ءَالَـٰفٍۢ مِّنَ ٱلْمَلَـٰٓئِكَةِ","",3849],["7:46:8",156,"بِسِيمَىٰهُمْ ۚ","by their marks","رِجَالٌۭ يَعْرِفُونَ كُلًّۢا","وَنَادَوْا۟ أَصْحَـٰبَ ٱلْجَنَّةِ",1230],["7:48:6",156,"بِسِيمَىٰهُمْ","by their marks","ٱلْأَعْرَافِ رِجَالًۭا يَعْرِفُونَهُم","قَالُوا۟ مَآ أَغْنَىٰ",1230],["7:141:6",167,"يَسُومُونَكُمْ","who were afflicting you","مِّنْ ءَالِ فِرْعَوْنَ","سُوٓءَ ٱلْعَذَابِ ۖ يُقَتِّلُونَ",1673],["7:167:10",172,"يَسُومُهُمْ","would afflict them","يَوْمِ ٱلْقِيَـٰمَةِ مَن","سُوٓءَ ٱلْعَذَابِ ۗ إِنَّ",1673],["11:83:1",231,"مُّسَوَّمَةً","Marked","","عِندَ رَبِّكَ ۖ وَمَا",1937],["14:6:14",256,"يَسُومُونَكُمْ","they were afflicting you","مِّنْ ءَالِ فِرْعَوْنَ","سُوٓءَ ٱلْعَذَابِ وَيُذَبِّحُونَ",1673],["16:10:13",268,"تُسِيمُونَ","you pasture your cattle","وَمِنْهُ شَجَرٌۭ فِيهِ","",4471],["47:30:5",510,"بِسِيمَـٰهُمْ ۚ","by their marks","نَشَآءُ لَأَرَيْنَـٰكَهُمْ فَلَعَرَفْتَهُم","وَلَتَعْرِفَنَّهُمْ فِى لَحْنِ",1230],["48:29:19",515,"سِيمَاهُمْ","Their mark","مِّنَ ٱللَّهِ وَرِضْوَٰنًۭا ۖ","فِى وُجُوهِهِم مِّنْ",1230],["51:34:1",522,"مُّسَوَّمَةً","Marked","","عِندَ رَبِّكَ لِلْمُسْرِفِينَ",1937],["55:41:3",532,"بِسِيمَـٰهُمْ","by their marks","يُعْرَفُ ٱلْمُجْرِمُونَ","فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ",1230]]