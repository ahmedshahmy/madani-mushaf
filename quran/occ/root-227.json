[["3:54:1",57,"وَمَكَرُوا۟","And they schemed","","وَمَكَرَ ٱللَّهُ ۖ وَٱللَّهُ",470],["3:54:2",57,"وَمَكَرَ","and planned","وَمَكَرُوا۟","ٱللَّهُ ۖ وَٱللَّهُ خَيْرُ",470],["3:54:6",57,"ٱلْمَـٰكِرِينَ","(of) the planners","ٱللَّهُ ۖ وَٱللَّهُ خَيْرُ","",2446],["6:123:8",143,"لِيَمْكُرُوا۟","so that they plot","قَرْيَةٍ أَكَـٰبِرَ مُجْرِمِيهَا","فِيهَا ۖ وَمَا يَمْكُرُونَ",470],["6:123:11",143,"يَمْكُرُونَ","they plot","لِيَمْكُرُوا۟ فِيهَا ۖ وَمَا","إِلَّا بِأَنفُسِهِمْ وَمَا",470],["6:124:29",143,"يَمْكُرُونَ","plot","شَدِيدٌۢ بِمَا كَانُوا۟","",470],["7:99:2",163,"مَكْرَ","(from the) plan","أَفَأَمِنُوا۟","ٱللَّهِ ۚ فَلَا يَأْمَنُ",527],["7:99:6",163,"مَكْرَ","(from the) plan","ٱللَّهِ ۚ فَلَا يَأْمَنُ","ٱللَّهِ إِلَّا ٱلْقَوْمُ",527],["7:123:11",165,"لَمَكْرٌۭ","(is) surely a plot","لَكُمْ ۖ إِنَّ هَـٰذَا","مَّكَرْتُمُوهُ فِى ٱلْمَدِينَةِ",527],["7:123:12",165,"مَّكَرْتُمُوهُ","you have plotted it","إِنَّ هَـٰذَا لَمَكْرٌۭ","فِى ٱلْمَدِينَةِ لِتُخْرِجُوا۟",470],["8:30:2",180,"يَمْكُرُ","plotted","وَإِذْ","بِكَ ٱلَّذِينَ كَفَرُوا۟",470],["8:30:11",180,"وَيَمْكُرُونَ","And they were planning","يَقْتُلُوكَ أَوْ يُخْرِجُوكَ ۚ","وَيَمْكُرُ ٱللَّهُ ۖ وَٱللَّهُ",470],["8:30:12",180,"وَيَمْكُرُ","and (also) was planning","أَوْ يُخْرِجُوكَ ۚ وَيَمْكُرُونَ","ٱللَّهُ ۖ وَٱللَّهُ خَيْرُ",470],["8:30:16",180,"ٱلْمَـٰكِرِينَ","(of) the Planners","ٱللَّهُ ۖ وَٱللَّهُ خَيْرُ","",2446],["10:21:11",211,"مَّكْرٌۭ","a plot","مَسَّتْهُمْ إِذَا لَهُم","فِىٓ ءَايَاتِنَا ۚ قُلِ",527],["10:21:17",211,"مَكْرًا ۚ","(in) planning","قُلِ ٱللَّهُ أَسْرَعُ","إِنَّ رُسُلَنَا يَكْتُبُونَ",527],["10:21:22",211,"تَمْكُرُونَ","you plot","رُسُلَنَا يَكْتُبُونَ مَا","",470],["12:31:3",239,"بِمَكْرِهِنَّ","of their scheming","فَلَمَّا سَمِعَتْ","أَرْسَلَتْ إِلَيْهِنَّ وَأَعْتَدَتْ",527],["12:102:14",247,"يَمْكُرُونَ","(were) plotting","أَجْمَعُوٓا۟ أَمْرَهُمْ وَهُمْ","",470],["13:33:29",253,"مَكْرُهُمْ","their plotting","زُيِّنَ لِلَّذِينَ كَفَرُوا۟","وَصُدُّوا۟ عَنِ ٱلسَّبِيلِ ۗ",527],["13:42:2",254,"مَكَرَ","plotted","وَقَدْ","ٱلَّذِينَ مِن قَبْلِهِمْ",470],["13:42:7",254,"ٱلْمَكْرُ","(is) the plot","مِن قَبْلِهِمْ فَلِلَّهِ","جَمِيعًۭا ۖ يَعْلَمُ مَا",527],["14:46:2",261,"مَكَرُوا۟","they planned","وَقَدْ","مَكْرَهُمْ وَعِندَ ٱللَّهِ",470],["14:46:3",261,"مَكْرَهُمْ","their plan","وَقَدْ مَكَرُوا۟","وَعِندَ ٱللَّهِ مَكْرُهُمْ",527],["14:46:6",261,"مَكْرُهُمْ","(was) their plan","مَكْرَهُمْ وَعِندَ ٱللَّهِ","وَإِن كَانَ مَكْرُهُمْ",527],["14:46:9",261,"مَكْرُهُمْ","their plan","مَكْرُهُمْ وَإِن كَانَ","لِتَزُولَ مِنْهُ ٱلْجِبَالُ",527],["16:26:2",269,"مَكَرَ","plotted","قَدْ","ٱلَّذِينَ مِن قَبْلِهِمْ",470],["16:45:3",272,"مَكَرُوا۟","plotted","أَفَأَمِنَ ٱلَّذِينَ","ٱلسَّيِّـَٔاتِ أَن يَخْسِفَ",470],["16:127:14",281,"يَمْكُرُونَ","they plot","فِى ضَيْقٍۢ مِّمَّا","",470],["27:50:1",381,"وَمَكَرُوا۟","So they plotted","","مَكْرًۭا وَمَكَرْنَا مَكْرًۭا",470],["27:50:2",381,"مَكْرًۭا","a plot","وَمَكَرُوا۟","وَمَكَرْنَا مَكْرًۭا وَهُمْ",527],["27:50:3",381,"وَمَكَرْنَا","and We planned","وَمَكَرُوا۟ مَكْرًۭا","مَكْرًۭا وَهُمْ لَا",470],["27:50:4",381,"مَكْرًۭا","a plan","وَمَكَرُوا۟ مَكْرًۭا وَمَكَرْنَا","وَهُمْ لَا يَشْعُرُونَ",527],["27:51:5",381,"مَكْرِهِمْ","(of) their plot","كَيْفَ كَانَ عَـٰقِبَةُ","أَنَّا دَمَّرْنَـٰهُمْ وَقَوْمَهُمْ",527],["27:70:9",383,"يَمْكُرُونَ","they plot","فِى ضَيْقٍۢ مِّمَّا","",470],["34:33:7",432,"مَكْرُ","(it was) a plot","لِلَّذِينَ ٱسْتَكْبَرُوا۟ بَلْ","ٱلَّيْلِ وَٱلنَّهَارِ إِذْ",527],["35:10:16",435,"يَمْكُرُونَ","plot","ٱلصَّـٰلِحُ يَرْفَعُهُۥ ۚ وَٱلَّذِينَ","ٱلسَّيِّـَٔاتِ لَهُمْ عَذَابٌۭ",470],["35:10:21",435,"وَمَكْرُ","and (the) plotting","لَهُمْ عَذَابٌۭ شَدِيدٌۭ ۖ","أُو۟لَـٰٓئِكَ هُوَ يَبُورُ",527],["35:43:4",439,"وَمَكْرَ","and plotting","ٱسْتِكْبَارًۭا فِى ٱلْأَرْضِ","ٱلسَّيِّئِ ۚ وَلَا يَحِيقُ",527],["35:43:8",439,"ٱلْمَكْرُ","the plot","ٱلسَّيِّئِ ۚ وَلَا يَحِيقُ","ٱلسَّيِّئُ إِلَّا بِأَهْلِهِۦ ۚ",527],["40:45:5",472,"مَكَرُوا۟ ۖ","they plotted","ٱللَّهُ سَيِّـَٔاتِ مَا","وَحَاقَ بِـَٔالِ فِرْعَوْنَ",470],["71:22:1",571,"وَمَكَرُوا۟","And they have planned","","مَكْرًۭا كُبَّارًۭا",470],["71:22:2",571,"مَكْرًۭا","a plan","وَمَكَرُوا۟","كُبَّارًۭا",527]]