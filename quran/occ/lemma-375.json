[["2:101:20",15,"كَأَنَّهُمْ","as if they","ٱللَّهِ وَرَآءَ ظُهُورِهِمْ","لَا يَعْلَمُونَ",375],["5:32:18",113,"فَكَأَنَّمَا","then (it) is as if","فَسَادٍۢ فِى ٱلْأَرْضِ","قَتَلَ ٱلنَّاسَ جَمِيعًۭا",375],["5:32:24",113,"فَكَأَنَّمَآ","then (it) is as if","جَمِيعًۭا وَمَنْ أَحْيَاهَا","أَحْيَا ٱلنَّاسَ جَمِيعًۭا ۚ",375],["6:125:17",144,"كَأَنَّمَا","as though","صَدْرَهُۥ ضَيِّقًا حَرَجًۭا","يَصَّعَّدُ فِى ٱلسَّمَآءِ ۚ",375],["7:171:5",173,"كَأَنَّهُۥ","as if it was","نَتَقْنَا ٱلْجَبَلَ فَوْقَهُمْ","ظُلَّةٌۭ وَظَنُّوٓا۟ أَنَّهُۥ",375],["7:187:25",174,"كَأَنَّكَ","as if you","إِلَّا بَغْتَةًۭ ۗ يَسْـَٔلُونَكَ","حَفِىٌّ عَنْهَا ۖ قُلْ",375],["8:6:6",177,"كَأَنَّمَا","as if","ٱلْحَقِّ بَعْدَ مَا تَبَيَّنَ","يُسَاقُونَ إِلَى ٱلْمَوْتِ",375],["10:27:15",212,"كَأَنَّمَآ","As if","ٱللَّهِ مِنْ عَاصِمٍۢ ۖ","أُغْشِيَتْ وُجُوهُهُمْ قِطَعًۭا",375],["22:31:9",336,"فَكَأَنَّمَا","then (it is) as though","وَمَن يُشْرِكْ بِٱللَّهِ","خَرَّ مِنَ ٱلسَّمَآءِ",375],["24:35:14",354,"كَأَنَّهَا","as if it were","فِى زُجَاجَةٍ ۖ ٱلزُّجَاجَةُ","كَوْكَبٌۭ دُرِّىٌّۭ يُوقَدُ",375],["27:10:6",377,"كَأَنَّهَا","as if it","فَلَمَّا رَءَاهَا تَهْتَزُّ","جَآنٌّۭ وَلَّىٰ مُدْبِرًۭا",375],["27:42:7",380,"كَأَنَّهُۥ","It is like","أَهَـٰكَذَا عَرْشُكِ ۖ قَالَتْ","هُوَ ۚ وَأُوتِينَا ٱلْعِلْمَ",375],["28:31:7",389,"كَأَنَّهَا","as if it","فَلَمَّا رَءَاهَا تَهْتَزُّ","جَآنٌّۭ وَلَّىٰ مُدْبِرًۭا",375],["31:7:10",411,"كَأَنَّ","as if","كَأَن لَّمْ يَسْمَعْهَا","فِىٓ أُذُنَيْهِ وَقْرًۭا ۖ",375],["37:49:1",447,"كَأَنَّهُنَّ","As if they were","","بَيْضٌۭ مَّكْنُونٌۭ",375],["37:65:2",448,"كَأَنَّهُۥ","(is) as if it","طَلْعُهَا","رُءُوسُ ٱلشَّيَـٰطِينِ",375],["41:34:15",480,"كَأَنَّهُۥ","(will become) as if he","بَيْنَكَ وَبَيْنَهُۥ عَدَٰوَةٌۭ","وَلِىٌّ حَمِيمٌۭ",375],["46:35:11",506,"كَأَنَّهُمْ","As if they had","وَلَا تَسْتَعْجِل لَّهُمْ ۚ","يَوْمَ يَرَوْنَ مَا",375],["52:24:5",524,"كَأَنَّهُمْ","as if they (were)","عَلَيْهِمْ غِلْمَانٌۭ لَّهُمْ","لُؤْلُؤٌۭ مَّكْنُونٌۭ",375],["54:7:6",529,"كَأَنَّهُمْ","as if they (were)","يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ","جَرَادٌۭ مُّنتَشِرٌۭ",375],["54:20:3",529,"كَأَنَّهُمْ","as if they (were)","تَنزِعُ ٱلنَّاسَ","أَعْجَازُ نَخْلٍۢ مُّنقَعِرٍۢ",375],["55:58:1",533,"كَأَنَّهُنَّ","As if they were","","ٱلْيَاقُوتُ وَٱلْمَرْجَانُ",375],["61:4:9",551,"كَأَنَّهُم","as if they","فِى سَبِيلِهِۦ صَفًّۭا","بُنْيَـٰنٌۭ مَّرْصُوصٌۭ",375],["63:4:9",554,"كَأَنَّهُمْ","as if they (were)","يَقُولُوا۟ تَسْمَعْ لِقَوْلِهِمْ ۖ","خُشُبٌۭ مُّسَنَّدَةٌۭ ۖ يَحْسَبُونَ",375],["69:7:12",566,"كَأَنَّهُمْ","as if they were","ٱلْقَوْمَ فِيهَا صَرْعَىٰ","أَعْجَازُ نَخْلٍ خَاوِيَةٍۢ",375],["70:43:6",570,"كَأَنَّهُمْ","as if they (were)","مِنَ ٱلْأَجْدَاثِ سِرَاعًۭا","إِلَىٰ نُصُبٍۢ يُوفِضُونَ",375],["74:50:1",577,"كَأَنَّهُمْ","As if they (were)","","حُمُرٌۭ مُّسْتَنفِرَةٌۭ",375],["77:33:1",581,"كَأَنَّهُۥ","As if they (were)","","جِمَـٰلَتٌۭ صُفْرٌۭ",375],["79:46:1",584,"كَأَنَّهُمْ","As though they","","يَوْمَ يَرَوْنَهَا لَمْ",375]]