[["20:97:25",318,"لَنَنسِفَنَّهُۥ","certainly we will scatter it","عَاكِفًۭا ۖ لَّنُحَرِّقَنَّهُۥ ثُمَّ","فِى ٱلْيَمِّ نَسْفًا",1949],["20:97:28",318,"نَسْفًا","(in) particles","لَنَنسِفَنَّهُۥ فِى ٱلْيَمِّ","",2559],["20:105:5",319,"يَنسِفُهَا","Will blast them","عَنِ ٱلْجِبَالِ فَقُلْ","رَبِّى نَسْفًۭا",1949],["20:105:7",319,"نَسْفًۭا","(into) particles","فَقُلْ يَنسِفُهَا رَبِّى","",2559],["77:10:3",580,"نُسِفَتْ","are blown away","وَإِذَا ٱلْجِبَالُ","",1949]]