[["3:117:11",65,"صِرٌّ","(is) frost","كَمَثَلِ رِيحٍۢ فِيهَا","أَصَابَتْ حَرْثَ قَوْمٍۢ",3265],["3:135:18",67,"يُصِرُّوا۟","they persist","إِلَّا ٱللَّهُ وَلَمْ","عَلَىٰ مَا فَعَلُوا۟",1463],["45:8:7",499,"يُصِرُّ","persists","تُتْلَىٰ عَلَيْهِ ثُمَّ","مُسْتَكْبِرًۭا كَأَن لَّمْ",1463],["51:29:4",521,"صَرَّةٍۢ","a loud voice","فَأَقْبَلَتِ ٱمْرَأَتُهُۥ فِى","فَصَكَّتْ وَجْهَهَا وَقَالَتْ",3253],["56:46:2",535,"يُصِرُّونَ","persisting","وَكَانُوا۟","عَلَى ٱلْحِنثِ ٱلْعَظِيمِ",1463],["71:7:12",570,"وَأَصَرُّوا۟","and persisted","ءَاذَانِهِمْ وَٱسْتَغْشَوْا۟ ثِيَابَهُمْ","وَٱسْتَكْبَرُوا۟ ٱسْتِكْبَارًۭا",1463]]