[["2:197:13",31,"جِدَالَ","quarrelling","وَلَا فُسُوقَ وَلَا","فِى ٱلْحَجِّ ۗ وَمَا",2404],["4:107:2",96,"تُجَـٰدِلْ","argue","وَلَا","عَنِ ٱلَّذِينَ يَخْتَانُونَ",426],["4:109:3",96,"جَـٰدَلْتُمْ","[you] argue","هَـٰٓأَنتُمْ هَـٰٓؤُلَآءِ","عَنْهُمْ فِى ٱلْحَيَوٰةِ",426],["4:109:9",96,"يُجَـٰدِلُ","will argue","ٱلْحَيَوٰةِ ٱلدُّنْيَا فَمَن","ٱللَّهَ عَنْهُمْ يَوْمَ",426],["6:25:24",130,"يُجَـٰدِلُونَكَ","and argue with you","حَتَّىٰٓ إِذَا جَآءُوكَ","يَقُولُ ٱلَّذِينَ كَفَرُوٓا۟",426],["6:121:16",143,"لِيُجَـٰدِلُوكُمْ ۖ","so that they dispute with you","لَيُوحُونَ إِلَىٰٓ أَوْلِيَآئِهِمْ","وَإِنْ أَطَعْتُمُوهُمْ إِنَّكُمْ",426],["7:71:9",159,"أَتُجَـٰدِلُونَنِى","Do you dispute with me","رَّبِّكُمْ رِجْسٌۭ وَغَضَبٌ ۖ","فِىٓ أَسْمَآءٍۢ سَمَّيْتُمُوهَآ",426],["8:6:1",177,"يُجَـٰدِلُونَكَ","They dispute with you","","فِى ٱلْحَقِّ بَعْدَ مَا",426],["11:32:4",225,"جَـٰدَلْتَنَا","you disputed with us","قَالُوا۟ يَـٰنُوحُ قَدْ","فَأَكْثَرْتَ جِدَٰلَنَا فَأْتِنَا",426],["11:32:6",225,"جِدَٰلَنَا","(in) dispute with us","قَدْ جَـٰدَلْتَنَا فَأَكْثَرْتَ","فَأْتِنَا بِمَا تَعِدُنَآ",2404],["11:74:8",230,"يُجَـٰدِلُنَا","he argued with Us","ٱلرَّوْعُ وَجَآءَتْهُ ٱلْبُشْرَىٰ","فِى قَوْمِ لُوطٍ",426],["13:13:14",250,"يُجَـٰدِلُونَ","dispute","مَن يَشَآءُ وَهُمْ","فِى ٱللَّهِ وَهُوَ",426],["16:111:5",280,"تُجَـٰدِلُ","pleading","تَأْتِى كُلُّ نَفْسٍۢ","عَن نَّفْسِهَا وَتُوَفَّىٰ",426],["16:125:8",281,"وَجَـٰدِلْهُم","and discuss with them","بِٱلْحِكْمَةِ وَٱلْمَوْعِظَةِ ٱلْحَسَنَةِ ۖ","بِٱلَّتِى هِىَ أَحْسَنُ ۚ",426],["18:54:14",300,"جَدَلًۭا","quarrelsome","ٱلْإِنسَـٰنُ أَكْثَرَ شَىْءٍۢ","",2395],["18:56:7",300,"وَيُجَـٰدِلُ","And dispute","إِلَّا مُبَشِّرِينَ وَمُنذِرِينَ ۚ","ٱلَّذِينَ كَفَرُوا۟ بِٱلْبَـٰطِلِ",426],["22:3:4",332,"يُجَـٰدِلُ","disputes","وَمِنَ ٱلنَّاسِ مَن","فِى ٱللَّهِ بِغَيْرِ",426],["22:8:4",333,"يُجَـٰدِلُ","disputes","وَمِنَ ٱلنَّاسِ مَن","فِى ٱللَّهِ بِغَيْرِ",426],["22:68:2",340,"جَـٰدَلُوكَ","they argue (with) you","وَإِن","فَقُلِ ٱللَّهُ أَعْلَمُ",426],["29:46:2",402,"تُجَـٰدِلُوٓا۟","argue","۞ وَلَا","أَهْلَ ٱلْكِتَـٰبِ إِلَّا",426],["31:20:21",413,"يُجَـٰدِلُ","disputes","وَمِنَ ٱلنَّاسِ مَن","فِى ٱللَّهِ بِغَيْرِ",426],["40:4:2",467,"يُجَـٰدِلُ","dispute","مَا","فِىٓ ءَايَـٰتِ ٱللَّهِ",426],["40:5:13",467,"وَجَـٰدَلُوا۟","and they disputed","أُمَّةٍۭ بِرَسُولِهِمْ لِيَأْخُذُوهُ ۖ","بِٱلْبَـٰطِلِ لِيُدْحِضُوا۟ بِهِ",426],["40:35:2",471,"يُجَـٰدِلُونَ","dispute","ٱلَّذِينَ","فِىٓ ءَايَـٰتِ ٱللَّهِ",426],["40:56:3",473,"يُجَـٰدِلُونَ","dispute","إِنَّ ٱلَّذِينَ","فِىٓ ءَايَـٰتِ ٱللَّهِ",426],["40:69:5",475,"يُجَـٰدِلُونَ","dispute","تَرَ إِلَى ٱلَّذِينَ","فِىٓ ءَايَـٰتِ ٱللَّهِ",426],["42:35:3",487,"يُجَـٰدِلُونَ","dispute","وَيَعْلَمَ ٱلَّذِينَ","فِىٓ ءَايَـٰتِنَا مَا",426],["43:58:10",493,"جَدَلًۢا ۚ","(for) argument","ضَرَبُوهُ لَكَ إِلَّا","بَلْ هُمْ قَوْمٌ",2395],["58:1:6",542,"تُجَـٰدِلُكَ","disputes with you","ٱللَّهُ قَوْلَ ٱلَّتِى","فِى زَوْجِهَا وَتَشْتَكِىٓ",426]]