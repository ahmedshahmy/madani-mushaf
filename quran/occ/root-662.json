[["4:129:14",99,"كَٱلْمُعَلَّقَةِ ۚ","like the suspended one","كُلَّ ٱلْمَيْلِ فَتَذَرُوهَا","وَإِن تُصْلِحُوا۟ وَتَتَّقُوا۟",3759],["22:5:18",332,"عَلَقَةٍۢ","a clinging substance","نُّطْفَةٍۢ ثُمَّ مِنْ","ثُمَّ مِن مُّضْغَةٍۢ",1294],["23:14:4",342,"عَلَقَةًۭ","(into) a clinging substance","ثُمَّ خَلَقْنَا ٱلنُّطْفَةَ","فَخَلَقْنَا ٱلْعَلَقَةَ مُضْغَةًۭ",1294],["23:14:6",342,"ٱلْعَلَقَةَ","the clinging substance","ٱلنُّطْفَةَ عَلَقَةًۭ فَخَلَقْنَا","مُضْغَةًۭ فَخَلَقْنَا ٱلْمُضْغَةَ",1294],["40:67:11",475,"عَلَقَةٍۢ","a clinging substance","نُّطْفَةٍۢ ثُمَّ مِنْ","ثُمَّ يُخْرِجُكُمْ طِفْلًۭا",1294],["75:38:3",578,"عَلَقَةًۭ","a clinging substance","ثُمَّ كَانَ","فَخَلَقَ فَسَوَّىٰ",1294],["96:2:4",597,"عَلَقٍ","a clinging substance","خَلَقَ ٱلْإِنسَـٰنَ مِنْ","",3115]]