ِذْ","And when","","زَيَّنَ لَهُمُ ٱلشَّيْطَـٰنُ",53],["8:49:1",183,"إِذْ","When","","يَقُولُ ٱلْمُنَـٰفِقُونَ وَٱلَّذِينَ",53],["8:50:3",183,"إِذْ","when","وَلَوْ تَرَىٰٓ","يَتَوَفَّى ٱلَّذِينَ كَفَرُوا۟ ۙ",53],["9:25:9",190,"إِذْ","when","كَثِيرَةٍۢ ۙ وَيَوْمَ حُنَيْنٍ ۙ","أَعْجَبَتْكُمْ كَثْرَتُكُمْ فَلَمْ",53],["9:40:6",193,"إِذْ","when","فَقَدْ نَصَرَهُ ٱللَّهُ","أَخْرَجَهُ ٱلَّذِينَ كَفَرُوا۟",53],["9:40:12",193,"إِذْ","when","كَفَرُوا۟ ثَانِىَ ٱثْنَيْنِ","هُمَا فِى ٱلْغَارِ",53],["9:40:16",193,"إِذْ","when","هُمَا فِى ٱلْغَارِ","يَقُولُ لِصَـٰحِبِهِۦ لَا",53],["9:115:7",205,"إِذْ","[when]","لِيُضِلَّ قَوْمًۢا بَعْدَ","هَدَىٰهُمْ حَتَّىٰ يُبَيِّنَ",53],["10:61:18",215,"إِذْ","when","كُنَّا عَلَيْكُمْ شُهُودًا","تُفِيضُونَ فِيهِ ۚ وَمَا",53],["10:71:5",217,"إِذْ","when","عَلَيْهِمْ نَبَأَ نُوحٍ","قَالَ لِقَوْمِهِۦ يَـٰقَوْمِ",53],["12:4:1",235,"إِذْ","When","","قَالَ يُوسُفُ لِأَبِيهِ",53],["12:8:1",236,"إِذْ","When","","قَالُوا۟ لَيُوسُفُ وَأَخُوهُ",53],["12:51:4",241,"إِذْ","when","قَالَ مَا خَطْبُكُنَّ","رَٰوَدتُّنَّ يُوسُفَ عَن",53],["12:89:8",246,"إِذْ","when","فَعَلْتُم بِيُوسُفَ وَأَخِيهِ","أَنتُمْ جَـٰهِلُونَ",53],["12:100:22",247,"إِذْ","when","وَقَدْ أَحْسَنَ بِىٓ","أَخْرَجَنِى مِنَ ٱلسِّجْنِ",53],["12:102:10",247,"إِذْ","when","وَمَا كُنتَ لَدَيْهِمْ","أَجْمَعُوٓا۟ أَمْرَهُمْ وَهُمْ",53],["14:6:1",256,"وَإِذْ","And when","","قَالَ مُوسَىٰ لِقَوْمِهِ",53],["14:6:9",256,"إِذْ","when","نِعْمَةَ ٱللَّهِ عَلَيْكُمْ","أَنجَىٰكُم مِّنْ ءَالِ",53],["14:7:1",256,"وَإِذْ","And when","","تَأَذَّنَ رَبُّكُمْ لَئِن",53],["14:35:1",260,"وَإِذْ","And when","","قَالَ إِبْرَٰهِيمُ رَبِّ",53],["15:28:1",263,"وَإِذْ","And when","","قَالَ رَبُّكَ لِلْمَلَـٰٓئِكَةِ",53],["15:52:1",265,"إِذْ","When","","دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟",53],["17:47:6",286,"إِذْ","when","بِمَا يَسْتَمِعُونَ بِهِۦٓ","يَسْتَمِعُونَ إِلَيْكَ وَإِذْ",53],["17:47:9",286,"وَإِذْ","and when","إِذْ يَسْتَمِعُونَ إِلَيْكَ","هُمْ نَجْوَىٰٓ إِذْ",53],["17:47:12",286,"إِذْ","when","وَإِذْ هُمْ نَجْوَىٰٓ"