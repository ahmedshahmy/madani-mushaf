[["6:59:14",134,"تَسْقُطُ","falls","ٱلْبَرِّ وَٱلْبَحْرِ ۚ وَمَا","مِن وَرَقَةٍ إِلَّا",1997],["7:149:2",168,"سُقِطَ","(it was made to) fall","وَلَمَّا","فِىٓ أَيْدِيهِمْ وَرَأَوْا۟",1997],["9:49:11",195,"سَقَطُوا۟ ۗ","they have fallen","أَلَا فِى ٱلْفِتْنَةِ","وَإِنَّ جَهَنَّمَ لَمُحِيطَةٌۢ",1997],["17:92:2",291,"تُسْقِطَ","you cause to fall","أَوْ","ٱلسَّمَآءَ كَمَا زَعَمْتَ",2020],["19:25:5",306,"تُسَـٰقِطْ","it will drop","إِلَيْكِ بِجِذْعِ ٱلنَّخْلَةِ","عَلَيْكِ رُطَبًۭا جَنِيًّۭا",4469],["26:187:1",375,"فَأَسْقِطْ","Then cause to fall","","عَلَيْنَا كِسَفًۭا مِّنَ",2020],["34:9:18",429,"نُسْقِطْ","cause to fall","بِهِمُ ٱلْأَرْضَ أَوْ","عَلَيْهِمْ كِسَفًۭا مِّنَ",2020],["52:44:6",525,"سَاقِطًۭا","falling","كِسْفًۭا مِّنَ ٱلسَّمَآءِ","يَقُولُوا۟ سَحَابٌۭ مَّرْكُومٌۭ",4234]]