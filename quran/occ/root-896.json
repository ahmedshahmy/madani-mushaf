[["9:25:20",190,"رَحُبَتْ","(in spite) of its vastness","عَلَيْكُمُ ٱلْأَرْضُ بِمَا","ثُمَّ وَلَّيْتُم مُّدْبِرِينَ",2596],["9:118:11",206,"رَحُبَتْ","it was vast","عَلَيْهِمُ ٱلْأَرْضُ بِمَا","وَضَاقَتْ عَلَيْهِمْ أَنفُسُهُمْ",2596],["38:59:6",456,"مَرْحَبًۢا","welcome","مُّقْتَحِمٌۭ مَّعَكُمْ ۖ لَا","بِهِمْ ۚ إِنَّهُمْ صَالُوا۟",2461],["38:60:5",456,"مَرْحَبًۢا","welcome","بَلْ أَنتُمْ لَا","بِكُمْ ۖ أَنتُمْ قَدَّمْتُمُوهُ",2461]]