[["2:41:6",7,"مَعَكُمْ","(is) with you","أَنزَلْتُ مُصَدِّقًۭا لِّمَا","وَلَا تَكُونُوٓا۟ أَوَّلَ",1352],["2:43:6",7,"مَعَ","with","وَءَاتُوا۟ ٱلزَّكَوٰةَ وَٱرْكَعُوا۟","ٱلرَّٰكِعِينَ",1352],["2:91:20",14,"مَعَهُمْ ۗ","(is) with them","ٱلْحَقُّ مُصَدِّقًۭا لِّمَا","قُلْ فَلِمَ تَقْتُلُونَ",1352],["94:5:2",597,"مَعَ","with","فَإِنَّ","ٱلْعُسْرِ يُسْرًا",1352],["94:6:2",597,"مَعَ","with","إِنَّ","ٱلْعُسْرِ يُسْرًۭا",1352]]