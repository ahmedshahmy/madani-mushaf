[["2:15:4",3,"وَيَمُدُّهُمْ","and prolongs them","ٱللَّهُ يَسْتَهْزِئُ بِهِمْ","فِى طُغْيَـٰنِهِمْ يَعْمَهُونَ",689],["3:124:7",66,"يُمِدَّكُمْ","reinforces you","أَلَن يَكْفِيَكُمْ أَن","رَبُّكُم بِثَلَـٰثَةِ ءَالَـٰفٍۢ",816],["3:125:9",66,"يُمْدِدْكُمْ","will reinforce you","مِّن فَوْرِهِمْ هَـٰذَا","رَبُّكُم بِخَمْسَةِ ءَالَـٰفٍۢ",816],["7:202:2",176,"يَمُدُّونَهُمْ","they plunge them","وَإِخْوَٰنُهُمْ","فِى ٱلْغَىِّ ثُمَّ",689],["8:9:7",178,"مُمِدُّكُم","going to reinforce you","فَٱسْتَجَابَ لَكُمْ أَنِّى","بِأَلْفٍۢ مِّنَ ٱلْمَلَـٰٓئِكَةِ",3816],["9:4:18",187,"مُدَّتِهِمْ ۚ","their term","إِلَيْهِمْ عَهْدَهُمْ إِلَىٰ","إِنَّ ٱللَّهَ يُحِبُّ",3794],["13:3:3",249,"مَدَّ","spread","وَهُوَ ٱلَّذِى","ٱلْأَرْضَ وَجَعَلَ فِيهَا",689],["15:19:2",263,"مَدَدْنَـٰهَا","We have spread it","وَٱلْأَرْضَ","وَأَلْقَيْنَا فِيهَا رَوَٰسِىَ",689],["15:88:2",266,"تَمُدَّنَّ","extend","لَا","عَيْنَيْكَ إِلَىٰ مَا",689],["17:6:6",282,"وَأَمْدَدْنَـٰكُم","And We reinforced you","لَكُمُ ٱلْكَرَّةَ عَلَيْهِمْ","بِأَمْوَٰلٍۢ وَبَنِينَ وَجَعَلْنَـٰكُمْ",816],["17:20:2",284,"نُّمِدُّ","We extend","كُلًّۭا","هَـٰٓؤُلَآءِ وَهَـٰٓؤُلَآءِ مِنْ",816],["18:109:5",304,"مِدَادًۭا","ink","لَّوْ كَانَ ٱلْبَحْرُ","لِّكَلِمَـٰتِ رَبِّى لَنَفِدَ",3740],["18:109:18",304,"مَدَدًۭا","(as) a supplement","وَلَوْ جِئْنَا بِمِثْلِهِۦ","",3657],["19:75:6",310,"فَلْيَمْدُدْ","then surely will extend","كَانَ فِى ٱلضَّلَـٰلَةِ","لَهُ ٱلرَّحْمَـٰنُ مَدًّا ۚ",689],["19:75:9",310,"مَدًّا ۚ","an extension","فَلْيَمْدُدْ لَهُ ٱلرَّحْمَـٰنُ","حَتَّىٰٓ إِذَا رَأَوْا۟",2448],["19:79:5",311,"وَنَمُدُّ","and We will extend","سَنَكْتُبُ مَا يَقُولُ","لَهُۥ مِنَ ٱلْعَذَابِ",689],["19:79:9",311,"مَدًّۭا","extensively","لَهُۥ مِنَ ٱلْعَذَابِ","",2448],["20:131:2",321,"تَمُدَّنَّ","extend","وَلَا","عَيْنَيْكَ إِلَىٰ مَا",689],["22:15:11",333,"فَلْيَمْدُدْ","then let him extend","فِى ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ","بِسَبَبٍ إِلَى ٱلسَّمَآءِ",689],["23:55:3",345,"نُمِدُّهُم","We extend to them","أَيَحْسَبُونَ أَنَّمَا","بِهِۦ مِن مَّالٍۢ",816],["25:45:6",364,"مَدَّ","He extends","إِلَىٰ رَبِّكَ كَيْفَ","ٱلظِّلَّ وَلَوْ شَآءَ",689],["26:132:3",372,"أَمَدَّكُم","has aided you","وَٱتَّقُوا۟ ٱلَّذِىٓ","بِمَا تَعْلَمُونَ",816],["26:133:1",372,"أَمَدَّكُم","He has aided you","","بِأَنْعَـٰمٍۢ وَبَنِينَ",816],["27:36:5",380,"أَتُمِدُّونَنِ","Will you provide me","جَآءَ سُلَيْمَـٰنَ قَالَ","بِمَالٍۢ فَمَآ ءَاتَىٰنِۦَ",816],["31:27:9",413,"يَمُدُّهُۥ","(to) add to it","شَجَرَةٍ أَقْلَـٰمٌۭ وَٱلْبَحْرُ","مِنۢ بَعْدِهِۦ سَبْعَةُ",689],["50:7:2",518,"مَدَدْنَـٰهَا","We have spread it out","وَٱلْأَرْضَ","وَأَلْقَيْنَا فِيهَا رَوَٰسِىَ",689],["52:22:1",524,"وَأَمْدَدْنَـٰهُم","And We will provide them","","بِفَـٰكِهَةٍۢ وَلَحْمٍۢ مِّمَّا",816],["56:30:2",535,"مَّمْدُودٍۢ","extended","وَظِلٍّۢ","",2524],["71:12:1",571,"وَيُمْدِدْكُم","And provide you","","بِأَمْوَٰلٍۢ وَبَنِينَ وَيَجْعَل",816],["74:12:4",575,"مَّمْدُودًۭا","extensive","وَجَعَلْتُ لَهُۥ مَالًۭا","",2524],["84:3:3",589,"مُدَّتْ","is spread","وَإِذَا ٱلْأَرْضُ","",689],["104:9:3",601,"مُّمَدَّدَةٍۭ","extended","فِى عَمَدٍۢ","",3969]]