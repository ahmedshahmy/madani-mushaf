[["2:85:17",13,"أُسَـٰرَىٰ","(as) captives","وَٱلْعُدْوَٰنِ وَإِن يَأْتُوكُمْ","تُفَـٰدُوهُمْ وَهُوَ مُحَرَّمٌ",1482],["8:67:7",185,"أَسْرَىٰ","prisoners of war","أَن يَكُونَ لَهُۥٓ","حَتَّىٰ يُثْخِنَ فِى",1482],["8:70:8",186,"ٱلْأَسْرَىٰٓ","the captives","فِىٓ أَيْدِيكُم مِّنَ","إِن يَعْلَمِ ٱللَّهُ",1482],["33:26:15",421,"وَتَأْسِرُونَ","and you took captive","ٱلرُّعْبَ فَرِيقًۭا تَقْتُلُونَ","فَرِيقًۭا",4314],["76:8:7",579,"وَأَسِيرًا","and (the) captive","حُبِّهِۦ مِسْكِينًۭا وَيَتِيمًۭا","",1482],["76:28:4",580,"أَسْرَهُمْ ۖ","their forms","نَّحْنُ خَلَقْنَـٰهُمْ وَشَدَدْنَآ","وَإِذَا شِئْنَا بَدَّلْنَآ",3037]]