[["2:178:19",27,"أَخِيهِ","his brother","عُفِىَ لَهُۥ مِنْ","شَىْءٌۭ فَٱتِّبَاعٌۢ بِٱلْمَعْرُوفِ",153],["2:220:13",35,"فَإِخْوَٰنُكُمْ ۚ","then they (are) your brothers","خَيْرٌۭ ۖ وَإِن تُخَالِطُوهُمْ","وَٱللَّهُ يَعْلَمُ ٱلْمُفْسِدَ",153],["3:103:19",63,"إِخْوَٰنًۭا","brothers","قُلُوبِكُمْ فَأَصْبَحْتُم بِنِعْمَتِهِۦٓ","وَكُنتُمْ عَلَىٰ شَفَا",153],["3:156:9",70,"لِإِخْوَٰنِهِمْ","about their brothers","كَٱلَّذِينَ كَفَرُوا۟ وَقَالُوا۟","إِذَا ضَرَبُوا۟ فِى",153],["3:168:3",72,"لِإِخْوَٰنِهِمْ","about their brothers","ٱلَّذِينَ قَالُوا۟","وَقَعَدُوا۟ لَوْ أَطَاعُونَا",153],["4:11:46",78,"إِخْوَةٌۭ","brothers and sisters","فَإِن كَانَ لَهُۥٓ","فَلِأُمِّهِ ٱلسُّدُسُ ۚ مِنۢ",1031],["4:12:58",79,"أَخٌ","(is) a brother","أَوِ ٱمْرَأَةٌۭ وَلَهُۥٓ","أَوْ أُخْتٌۭ فَلِكُلِّ",153],["4:12:60",79,"أُخْتٌۭ","a sister","وَلَهُۥٓ أَخٌ أَوْ","فَلِكُلِّ وَٰحِدٍۢ مِّنْهُمَا",651],["4:23:5",81,"وَأَخَوَٰتُكُمْ","and your sisters","عَلَيْكُمْ أُمَّهَـٰتُكُمْ وَبَنَاتُكُمْ","وَعَمَّـٰتُكُمْ وَخَـٰلَـٰتُكُمْ وَبَنَاتُ",651],["4:23:9",81,"ٱلْأَخِ","(of) brothers","وَعَمَّـٰتُكُمْ وَخَـٰلَـٰتُكُمْ وَبَنَاتُ","وَبَنَاتُ ٱلْأُخْتِ وَأُمَّهَـٰتُكُمُ",153],["4:23:11",81,"ٱلْأُخْتِ","(of) sisters","وَبَنَاتُ ٱلْأَخِ وَبَنَاتُ","وَأُمَّهَـٰتُكُمُ ٱلَّـٰتِىٓ أَرْضَعْنَكُمْ",651],["4:23:15",81,"وَأَخَوَٰتُكُم","and your sisters","وَأُمَّهَـٰتُكُمُ ٱلَّـٰتِىٓ أَرْضَعْنَكُمْ","مِّنَ ٱلرَّضَـٰعَةِ وَأُمَّهَـٰتُ",651],["4:23:45",81,"ٱلْأُخْتَيْنِ","two sisters","وَأَن تَجْمَعُوا۟ بَيْنَ","إِلَّا مَا قَدْ",651],["4:176:14",106,"أُخْتٌۭ","a sister","لَهُۥ وَلَدٌۭ وَلَهُۥٓ","فَلَهَا نِصْفُ مَا",651],["4:176:35",106,"إِخْوَةًۭ","brothers and sisters","تَرَكَ ۚ وَإِن كَانُوٓا۟","رِّجَالًۭا وَنِسَآءًۭ فَلِلذَّكَرِ",1031],["5:25:8",112,"وَأَخِى ۖ","and my brother","أَمْلِكُ إِلَّا نَفْسِى","فَٱفْرُقْ بَيْنَنَا وَبَيْنَ",153],["5:30:5",112,"أَخِيهِ","his brother","لَهُۥ نَفْسُهُۥ قَتْلَ","فَقَتَلَهُۥ فَأَصْبَحَ مِنَ",153],["5:31:11",112,"أَخِيهِ ۚ","(of) his brother","كَيْفَ يُوَٰرِى سَوْءَةَ","قَالَ يَـٰوَيْلَتَىٰٓ أَعَجَزْتُ",153],["5:31:22",112,"أَخِى ۖ","(of) my brother","ٱلْغُرَابِ فَأُوَٰرِىَ سَوْءَةَ","فَأَصْبَحَ مِنَ ٱلنَّـٰدِمِينَ",153],["6:87:4",138,"وَإِخْوَٰنِهِمْ ۖ","and their brothers","وَمِنْ ءَابَآئِهِمْ وَذُرِّيَّـٰتِهِمْ","وَٱجْتَبَيْنَـٰهُمْ وَهَدَيْنَـٰهُمْ إِلَىٰ",153],["7:38:18",155,"أُخْتَهَا ۖ","its sister (nation)","دَخَلَتْ أُمَّةٌۭ لَّعَنَتْ","حَتَّىٰٓ إِذَا ٱدَّارَكُوا۟",651],["7:65:3",158,"أَخَاهُمْ","(We sent) their brother","۞ وَإِلَىٰ عَادٍ","هُودًۭا ۗ قَالَ يَـٰقَوْمِ",153],["7:73:3",159,"أَخَاهُمْ","(We sent) their brother","وَإِلَىٰ ثَمُودَ","صَـٰلِحًۭا ۗ قَالَ يَـٰقَوْمِ",153],["7:85:3",161,"أَخَاهُمْ","his brother","وَإِلَىٰ مَدْيَنَ","شُعَيْبًۭا ۗ قَالَ يَـٰقَوْمِ",153],["7:111:3",164,"وَأَخَاهُ","and his brother","قَالُوٓا۟ أَرْجِهْ","وَأَرْسِلْ فِى ٱلْمَدَآئِنِ",153],["7:142:14",167,"لِأَخِيهِ","to his brother","لَيْلَةًۭ ۚ وَقَالَ مُوسَىٰ","هَـٰرُونَ ٱخْلُفْنِى فِى",153],["7:150:20",169,"أَخِيهِ","his brother","ٱلْأَلْوَاحَ وَأَخَذَ بِرَأْسِ","يَجُرُّهُۥٓ إِلَيْهِ ۚ قَالَ",153],["7:151:5",169,"وَلِأَخِى","and my brother","رَبِّ ٱغْفِرْ لِى","وَأَدْخِلْنَا فِى رَحْمَتِكَ ۖ",153],["7:202:1",176,"وَإِخْوَٰنُهُمْ","But their brothers","","يَمُدُّونَهُمْ فِى ٱلْغَىِّ",153],["9:11:7",188,"فَإِخْوَٰنُكُمْ","then (they are) your brothers","ٱلصَّلَوٰةَ وَءَاتَوُا۟ ٱلزَّكَوٰةَ","فِى ٱلدِّينِ ۗ وَنُفَصِّلُ",153],["9:23:7",190,"وَإِخْوَٰنَكُمْ","and your brothers","لَا تَتَّخِذُوٓا۟ ءَابَآءَكُمْ","أَوْلِيَآءَ إِنِ ٱسْتَحَبُّوا۟",153],["9:24:6",190,"وَإِخْوَٰنُكُمْ","and your brothers","كَانَ ءَابَآؤُكُمْ وَأَبْنَآؤُكُمْ","وَأَزْوَٰجُكُمْ وَعَشِيرَتُكُمْ وَأَمْوَٰلٌ",153],["10:87:4",218,"وَأَخِيهِ","and his brother","وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰ","أَن تَبَوَّءَا لِقَوْمِكُمَا",153],["11:50:3",227,"أَخَاهُمْ","(We sent) their brother","وَإِلَىٰ عَادٍ","هُودًۭا ۚ قَالَ يَـٰقَوْمِ",153],["11:61:3",228,"أَخَاهُمْ","(We sent) their brother","۞ وَإِلَىٰ ثَمُودَ","صَـٰلِحًۭا ۚ قَالَ يَـٰقَوْمِ",153],["11:84:3",231,"أَخَاهُمْ","their brother","۞ وَإِلَىٰ مَدْيَنَ","شُعَيْبًۭا ۚ قَالَ يَـٰقَوْمِ",153],["12:5:7",236,"إِخْوَتِكَ","your brothers","تَقْصُصْ رُءْيَاكَ عَلَىٰٓ","فَيَكِيدُوا۟ لَكَ كَيْدًا ۖ",1031],["12:7:5",236,"وَإِخْوَتِهِۦٓ","and his brothers","كَانَ فِى يُوسُفَ","ءَايَـٰتٌۭ لِّلسَّآئِلِينَ",1031],["12:8:4",236,"وَأَخُوهُ","and his brother","إِذْ قَالُوا۟ لَيُوسُفُ","أَحَبُّ إِلَىٰٓ أَبِينَا",153],["12:58:2",242,"إِخْوَةُ","(the) brothers","وَجَآءَ","يُوسُفَ فَدَخَلُوا۟ عَلَيْهِ",1031],["12:59:6",242,"بِأَخٍۢ","a brother","بِجَهَازِهِمْ قَالَ ٱئْتُونِى","لَّكُم مِّنْ أَبِيكُمْ ۚ",153],["12:63:12",242,"أَخَانَا","our brother","ٱلْكَيْلُ فَأَرْسِلْ مَعَنَآ","نَكْتَلْ وَإِنَّا لَهُۥ",153],["12:64:9",243,"أَخِيهِ","his brother","كَمَآ أَمِنتُكُمْ عَلَىٰٓ","مِن قَبْلُ ۖ فَٱللَّهُ",153],["12:65:19",243,"أَخَانَا","our brother","وَنَمِيرُ أَهْلَنَا وَنَحْفَظُ","وَنَزْدَادُ كَيْلَ بَعِيرٍۢ ۖ",153],["12:69:7",243,"أَخَاهُ ۖ","his brother","يُوسُفَ ءَاوَىٰٓ إِلَيْهِ","قَالَ إِنِّىٓ أَنَا۠",153],["12:69:11",243,"أَخُوكَ","your brother","قَالَ إِنِّىٓ أَنَا۠","فَلَا تَبْتَئِسْ بِمَا",153],["12:70:8",244,"أَخِيهِ","(of) his brother","ٱلسِّقَايَةَ فِى رَحْلِ","ثُمَّ أَذَّنَ مُؤَذِّنٌ",153],["12:76:5",244,"أَخِيهِ","(of) his brother","بِأَوْعِيَتِهِمْ قَبْلَ وِعَآءِ","ثُمَّ ٱسْتَخْرَجَهَا مِن",153],["12:76:10",244,"أَخِيهِ ۚ","(of) his brother","ٱسْتَخْرَجَهَا مِن وِعَآءِ","كَذَٰلِكَ كِدْنَا لِيُوسُفَ ۖ",153],["12:76:17",244,"أَخَاهُ","his brother","مَا كَانَ لِيَأْخُذَ","فِى دِينِ ٱلْمَلِكِ",153],["12:77:6",244,"أَخٌۭ","a brother","يَسْرِقْ فَقَدْ سَرَقَ","لَّهُۥ مِن قَبْلُ ۚ",153],["12:87:6",246,"وَأَخِيهِ","and his brother","فَتَحَسَّسُوا۟ مِن يُوسُفَ","وَلَا تَا۟يْـَٔسُوا۟ مِن",153],["12:89:7",246,"وَأَخِيهِ","and his brother","مَّا فَعَلْتُم بِيُوسُفَ","إِذْ أَنتُمْ جَـٰهِلُونَ",153],["12:90:9",246,"أَخِى ۖ","(is) my brother","أَنَا۠ يُوسُفُ وَهَـٰذَآ","قَدْ مَنَّ ٱللَّهُ",153],["12:100:37",247,"إِخْوَتِىٓ ۚ","my brothers","ٱلشَّيْطَـٰنُ بَيْنِى وَبَيْنَ","إِنَّ رَبِّى لَطِيفٌۭ",1031],["15:47:7",264,"إِخْوَٰنًا","(they will be) brothers","صُدُورِهِم مِّنْ غِلٍّ","عَلَىٰ سُرُرٍۢ مُّتَقَـٰبِلِينَ",153],["17:27:4",284,"إِخْوَٰنَ","brothers","إِنَّ ٱلْمُبَذِّرِينَ كَانُوٓا۟","ٱلشَّيَـٰطِينِ ۖ وَكَانَ ٱلشَّيْطَـٰنُ",153],["19:28:1",307,"يَـٰٓأُخْتَ","O sister","","هَـٰرُونَ مَا كَانَ",651],["19:53:5",309,"أَخَاهُ","his brother","لَهُۥ مِن رَّحْمَتِنَآ","هَـٰرُونَ نَبِيًّۭا",153],["20:30:2",313,"أَخِى","my brother","هَـٰرُونَ","",153],["20:40:3",314,"أُخْتُكَ","your sister","إِذْ تَمْشِىٓ","فَتَقُولُ هَلْ أَدُلُّكُمْ",651],["20:42:3",314,"وَأَخُوكَ","and your brother","ٱذْهَبْ أَنتَ","بِـَٔايَـٰتِى وَلَا تَنِيَا",153],["23:45:4",345,"وَأَخَاهُ","and his brother","ثُمَّ أَرْسَلْنَا مُوسَىٰ","هَـٰرُونَ بِـَٔايَـٰتِنَا وَسُلْطَـٰنٍۢ",153],["24:31:35",353,"إِخْوَٰنِهِنَّ","their brothers","أَبْنَآءِ بُعُولَتِهِنَّ أَوْ","أَوْ بَنِىٓ إِخْوَٰنِهِنَّ",153],["24:31:38",353,"إِخْوَٰنِهِنَّ","(of) their brothers","إِخْوَٰنِهِنَّ أَوْ بَنِىٓ","أَوْ بَنِىٓ أَخَوَٰتِهِنَّ",153],["24:31:41",353,"أَخَوَٰتِهِنَّ","(of) their sisters","إِخْوَٰنِهِنَّ أَوْ بَنِىٓ","أَوْ نِسَآئِهِنَّ أَوْ",651],["24:61:28",358,"إِخْوَٰنِكُمْ","(of) your brothers","أُمَّهَـٰتِكُمْ أَوْ بُيُوتِ","أَوْ بُيُوتِ أَخَوَٰتِكُمْ",153],["24:61:31",358,"أَخَوَٰتِكُمْ","(of) your sisters","إِخْوَٰنِكُمْ أَوْ بُيُوتِ","أَوْ بُيُوتِ أَعْمَـٰمِكُمْ",651],["25:35:7",363,"أَخَاهُ","his brother","ٱلْكِتَـٰبَ وَجَعَلْنَا مَعَهُۥٓ","هَـٰرُونَ وَزِيرًۭا",153],["26:36:3",368,"وَأَخَاهُ","and his brother","قَالُوٓا۟ أَرْجِهْ","وَٱبْعَثْ فِى ٱلْمَدَآئِنِ",153],["26:106:4",371,"أَخُوهُمْ","their brother","إِذْ قَالَ لَهُمْ","نُوحٌ أَلَا تَتَّقُونَ",153],["26:124:4",372,"أَخُوهُمْ","their brother","إِذْ قَالَ لَهُمْ","هُودٌ أَلَا تَتَّقُونَ",153],["26:142:4",373,"أَخُوهُمْ","their brother","إِذْ قَالَ لَهُمْ","صَـٰلِحٌ أَلَا تَتَّقُونَ",153],["26:161:4",374,"أَخُوهُمْ","their brother","إِذْ قَالَ لَهُمْ","لُوطٌ أَلَا تَتَّقُونَ",153],["27:45:5",381,"أَخَاهُمْ","their brother","أَرْسَلْنَآ إِلَىٰ ثَمُودَ","صَـٰلِحًا أَنِ ٱعْبُدُوا۟",153],["28:11:2",386,"لِأُخْتِهِۦ","to his sister","وَقَالَتْ","قُصِّيهِ ۖ فَبَصُرَتْ بِهِۦ",651],["28:34:1",389,"وَأَخِى","And my brother","","هَـٰرُونُ هُوَ أَفْصَحُ",153],["28:35:4",389,"بِأَخِيكَ","through your brother","قَالَ سَنَشُدُّ عَضُدَكَ","وَنَجْعَلُ لَكُمَا سُلْطَـٰنًۭا",153],["29:36:3",400,"أَخَاهُمْ","their brother","وَإِلَىٰ مَدْيَنَ","شُعَيْبًۭا فَقَالَ يَـٰقَوْمِ",153],["33:5:11",418,"فَإِخْوَٰنُكُمْ","then (they are) your brothers","لَّمْ تَعْلَمُوٓا۟ ءَابَآءَهُمْ","فِى ٱلدِّينِ وَمَوَٰلِيكُمْ ۚ",153],["33:18:7",420,"لِإِخْوَٰنِهِمْ","to their brothers","ٱلْمُعَوِّقِينَ مِنكُمْ وَٱلْقَآئِلِينَ","هَلُمَّ إِلَيْنَا ۖ وَلَا",153],["33:55:9",426,"إِخْوَٰنِهِنَّ","their brothers","وَلَآ أَبْنَآئِهِنَّ وَلَآ","وَلَآ أَبْنَآءِ إِخْوَٰنِهِنَّ",153],["33:55:12",426,"إِخْوَٰنِهِنَّ","(of) their brothers","إِخْوَٰنِهِنَّ وَلَآ أَبْنَآءِ","وَلَآ أَبْنَآءِ أَخَوَٰتِهِنَّ",153],["33:55:15",426,"أَخَوَٰتِهِنَّ","(of) their sisters","إِخْوَٰنِهِنَّ وَلَآ أَبْنَآءِ","وَلَا نِسَآئِهِنَّ وَلَا",651],["38:23:3",454,"أَخِى","(is) my brother","إِنَّ هَـٰذَآ","لَهُۥ تِسْعٌۭ وَتِسْعُونَ",153],["43:48:9",493,"أُخْتِهَا ۖ","its sister","هِىَ أَكْبَرُ مِنْ","وَأَخَذْنَـٰهُم بِٱلْعَذَابِ لَعَلَّهُمْ",651],["46:21:2",505,"أَخَا","(the) brother","۞ وَٱذْكُرْ","عَادٍ إِذْ أَنذَرَ",153],["49:10:3",516,"إِخْوَةٌۭ","(are) brothers","إِنَّمَا ٱلْمُؤْمِنُونَ","فَأَصْلِحُوا۟ بَيْنَ أَخَوَيْكُمْ ۚ",1031],["49:10:6",516,"أَخَوَيْكُمْ ۚ","your brothers","إِخْوَةٌۭ فَأَصْلِحُوا۟ بَيْنَ","وَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ",153],["49:12:23",517,"أَخِيهِ","(of) his brother","أَن يَأْكُلَ لَحْمَ","مَيْتًۭا فَكَرِهْتُمُوهُ ۚ وَٱتَّقُوا۟",153],["50:13:3",518,"وَإِخْوَٰنُ","and (the) brothers","وَعَادٌۭ وَفِرْعَوْنُ","لُوطٍۢ",153],["58:22:19",545,"إِخْوَٰنَهُمْ","their brothers","أَوْ أَبْنَآءَهُمْ أَوْ","أَوْ عَشِيرَتَهُمْ ۚ أُو۟لَـٰٓئِكَ",153],["59:10:9",547,"وَلِإِخْوَٰنِنَا","and our brothers","رَبَّنَا ٱغْفِرْ لَنَا","ٱلَّذِينَ سَبَقُونَا بِٱلْإِيمَـٰنِ",153],["59:11:7",547,"لِإِخْوَٰنِهِمُ","to their brothers","ٱلَّذِينَ نَافَقُوا۟ يَقُولُونَ","ٱلَّذِينَ كَفَرُوا۟ مِنْ",153],["70:12:2",569,"وَأَخِيهِ","and his brother","وَصَـٰحِبَتِهِۦ","",153],["80:34:5",585,"أَخِيهِ","his brother","يَفِرُّ ٱلْمَرْءُ مِنْ","",153]]