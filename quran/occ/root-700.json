[["5:44:15",115,"وَٱلْأَحْبَارُ","and the scholars","لِلَّذِينَ هَادُوا۟ وَٱلرَّبَّـٰنِيُّونَ","بِمَا ٱسْتُحْفِظُوا۟ مِن",1461],["5:63:4",118,"وَٱلْأَحْبَارُ","and the religious scholars","لَوْلَا يَنْهَىٰهُمُ ٱلرَّبَّـٰنِيُّونَ","عَن قَوْلِهِمُ ٱلْإِثْمَ",1461],["9:31:2",191,"أَحْبَارَهُمْ","their rabbis","ٱتَّخَذُوٓا۟","وَرُهْبَـٰنَهُمْ أَرْبَابًۭا مِّن",1461],["9:34:7",192,"ٱلْأَحْبَارِ","the rabbis","إِنَّ كَثِيرًۭا مِّنَ","وَٱلرُّهْبَانِ لَيَأْكُلُونَ أَمْوَٰلَ",1461],["30:15:9",405,"يُحْبَرُونَ","will be delighted","فَهُمْ فِى رَوْضَةٍۢ","",2801],["43:70:5",494,"تُحْبَرُونَ","delighted","ٱلْجَنَّةَ أَنتُمْ وَأَزْوَٰجُكُمْ","",2801]]