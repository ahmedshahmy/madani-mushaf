[["7:200:2",176,"يَنزَغَنَّكَ","an evil suggestion comes to you","وَإِمَّا","مِنَ ٱلشَّيْطَـٰنِ نَزْغٌۭ",1615],["7:200:5",176,"نَزْغٌۭ","[an evil suggestion]","يَنزَغَنَّكَ مِنَ ٱلشَّيْطَـٰنِ","فَٱسْتَعِذْ بِٱللَّهِ ۚ إِنَّهُۥ",2562],["12:100:33",247,"نَّزَغَ","had caused discord","مِنۢ بَعْدِ أَن","ٱلشَّيْطَـٰنُ بَيْنِى وَبَيْنَ",1615],["17:53:9",287,"يَنزَغُ","sows discord","أَحْسَنُ ۚ إِنَّ ٱلشَّيْطَـٰنَ","بَيْنَهُمْ ۚ إِنَّ ٱلشَّيْطَـٰنَ",1615],["41:36:2",480,"يَنزَغَنَّكَ","whisper comes to you","وَإِمَّا","مِنَ ٱلشَّيْطَـٰنِ نَزْغٌۭ",1615],["41:36:5",480,"نَزْغٌۭ","an evil suggestion","يَنزَغَنَّكَ مِنَ ٱلشَّيْطَـٰنِ","فَٱسْتَعِذْ بِٱللَّهِ ۖ إِنَّهُۥ",2562]]