[["14:34:11",260,"تُحْصُوهَآ ۗ","you will (be able to) count them","نِعْمَتَ ٱللَّهِ لَا","إِنَّ ٱلْإِنسَـٰنَ لَظَلُومٌۭ",815],["16:18:6",269,"تُحْصُوهَآ ۗ","you could enumerate them","نِعْمَةَ ٱللَّهِ لَا","إِنَّ ٱللَّهَ لَغَفُورٌۭ",815],["18:12:6",294,"أَحْصَىٰ","best calculated","لِنَعْلَمَ أَىُّ ٱلْحِزْبَيْنِ","لِمَا لَبِثُوٓا۟ أَمَدًۭا",2957],["18:49:19",299,"أَحْصَىٰهَا ۚ","has enumerated it","وَلَا كَبِيرَةً إِلَّآ","وَوَجَدُوا۟ مَا عَمِلُوا۟",815],["19:94:2",311,"أَحْصَىٰهُمْ","He has enumerated them","لَّقَدْ","وَعَدَّهُمْ عَدًّۭا",815],["36:12:11",440,"أَحْصَيْنَـٰهُ","We have enumerated it","وَءَاثَـٰرَهُمْ ۚ وَكُلَّ شَىْءٍ","فِىٓ إِمَامٍۢ مُّبِينٍۢ",815],["58:6:8",542,"أَحْصَىٰهُ","Allah has recorded it","فَيُنَبِّئُهُم بِمَا عَمِلُوٓا۟ ۚ","ٱللَّهُ وَنَسُوهُ ۚ وَٱللَّهُ",815],["65:1:8",558,"وَأَحْصُوا۟","and keep count","ٱلنِّسَآءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ","ٱلْعِدَّةَ ۖ وَٱتَّقُوا۟ ٱللَّهَ",815],["72:28:10",573,"وَأَحْصَىٰ","and He takes account","وَأَحَاطَ بِمَا لَدَيْهِمْ","كُلَّ شَىْءٍ عَدَدًۢا",815],["73:20:23",575,"تُحْصُوهُ","you count it","عَلِمَ أَن لَّن","فَتَابَ عَلَيْكُمْ ۖ فَٱقْرَءُوا۟",815],["78:29:3",582,"أَحْصَيْنَـٰهُ","We have enumerated it","وَكُلَّ شَىْءٍ","كِتَـٰبًۭا",815]]