[["25:32:14",362,"وَرَتَّلْنَـٰهُ","and We have recited it","لِنُثَبِّتَ بِهِۦ فُؤَادَكَ ۖ","تَرْتِيلًۭا",2606],["25:32:15",362,"تَرْتِيلًۭا","(with distinct) recitation","بِهِۦ فُؤَادَكَ ۖ وَرَتَّلْنَـٰهُ","",2681],["73:4:4",574,"وَرَتِّلِ","and recite","أَوْ زِدْ عَلَيْهِ","ٱلْقُرْءَانَ تَرْتِيلًا",2606],["73:4:6",574,"تَرْتِيلًا","(with) measured rhythmic recitation","عَلَيْهِ وَرَتِّلِ ٱلْقُرْءَانَ","",2681]]