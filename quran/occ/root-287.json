[["2:91:15",14,"وَرَآءَهُۥ","(is) besides it","عَلَيْنَا وَيَكْفُرُونَ بِمَا","وَهُوَ ٱلْحَقُّ مُصَدِّقًۭا",445],["2:101:18",15,"وَرَآءَ","behind","ٱلْكِتَـٰبَ كِتَـٰبَ ٱللَّهِ","ظُهُورِهِمْ كَأَنَّهُمْ لَا",445],["3:187:13",75,"وَرَآءَ","behind","وَلَا تَكْتُمُونَهُۥ فَنَبَذُوهُ","ظُهُورِهِمْ وَٱشْتَرَوْا۟ بِهِۦ",445],["4:24:14",82,"وَرَآءَ","(is) beyond","وَأُحِلَّ لَكُم مَّا","ذَٰلِكُمْ أَن تَبْتَغُوا۟",445],["4:102:17",95,"وَرَآئِكُمْ","behind you","سَجَدُوا۟ فَلْيَكُونُوا۟ مِن","وَلْتَأْتِ طَآئِفَةٌ أُخْرَىٰ",445],["5:31:9",112,"يُوَٰرِى","to hide","ٱلْأَرْضِ لِيُرِيَهُۥ كَيْفَ","سَوْءَةَ أَخِيهِ ۚ قَالَ",1661],["5:31:20",112,"فَأُوَٰرِىَ","and hide","مِثْلَ هَـٰذَا ٱلْغُرَابِ","سَوْءَةَ أَخِى ۖ فَأَصْبَحَ",1661],["6:94:11",139,"وَرَآءَ","behind","وَتَرَكْتُم مَّا خَوَّلْنَـٰكُمْ","ظُهُورِكُمْ ۖ وَمَا نَرَىٰ",445],["7:20:7",152,"وُۥرِىَ","was concealed","لِيُبْدِىَ لَهُمَا مَا","عَنْهُمَا مِن سَوْءَٰتِهِمَا",1661],["7:26:7",153,"يُوَٰرِى","it covers","أَنزَلْنَا عَلَيْكُمْ لِبَاسًۭا","سَوْءَٰتِكُمْ وَرِيشًۭا ۖ وَلِبَاسُ",1661],["11:71:7",229,"وَرَآءِ","and after","فَبَشَّرْنَـٰهَا بِإِسْحَـٰقَ وَمِن","إِسْحَـٰقَ يَعْقُوبَ",445],["11:92:9",232,"وَرَآءَكُمْ","behind your","مِّنَ ٱللَّهِ وَٱتَّخَذْتُمُوهُ","ظِهْرِيًّا ۖ إِنَّ رَبِّى",445],["14:16:2",257,"وَرَآئِهِۦ","Ahead","مِّن","جَهَنَّمُ وَيُسْقَىٰ مِن",445],["14:17:14",257,"وَرَآئِهِۦ","And ahead of him","هُوَ بِمَيِّتٍۢ ۖ وَمِن","عَذَابٌ غَلِيظٌۭ",445],["16:59:1",273,"يَتَوَٰرَىٰ","He hides himself","","مِنَ ٱلْقَوْمِ مِن",2685],["18:79:12",302,"وَرَآءَهُم","after them","أَنْ أَعِيبَهَا وَكَانَ","مَّلِكٌۭ يَأْخُذُ كُلَّ",445],["19:5:5",305,"وَرَآءِى","after me","خِفْتُ ٱلْمَوَٰلِىَ مِن","وَكَانَتِ ٱمْرَأَتِى عَاقِرًۭا",445],["23:7:3",342,"وَرَآءَ","beyond","فَمَنِ ٱبْتَغَىٰ","ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ",445],["23:100:12",348,"وَرَآئِهِم","and before them","هُوَ قَآئِلُهَا ۖ وَمِن","بَرْزَخٌ إِلَىٰ يَوْمِ",445],["33:53:44",425,"وَرَآءِ","behind","مَتَـٰعًۭا فَسْـَٔلُوهُنَّ مِن","حِجَابٍۢ ۚ ذَٰلِكُمْ أَطْهَرُ",445],["38:32:10",455,"تَوَارَتْ","they were hidden","ذِكْرِ رَبِّى حَتَّىٰ","بِٱلْحِجَابِ",2685],["42:51:11",488,"وَرَآئِ","behind","وَحْيًا أَوْ مِن","حِجَابٍ أَوْ يُرْسِلَ",445],["45:10:2",499,"وَرَآئِهِمْ","Before them","مِّن","جَهَنَّمُ ۖ وَلَا يُغْنِى",445],["49:4:5",515,"وَرَآءِ","behind","ٱلَّذِينَ يُنَادُونَكَ مِن","ٱلْحُجُرَٰتِ أَكْثَرُهُمْ لَا",445],["56:71:4",536,"تُورُونَ","you ignite","أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى","",4474],["57:13:13",539,"وَرَآءَكُمْ","behind you","نُّورِكُمْ قِيلَ ٱرْجِعُوا۟","فَٱلْتَمِسُوا۟ نُورًۭا فَضُرِبَ",445],["59:14:10",547,"وَرَآءِ","behind","مُّحَصَّنَةٍ أَوْ مِن","جُدُرٍۭ ۚ بَأْسُهُم بَيْنَهُمْ",445],["70:31:3",569,"وَرَآءَ","beyond","فَمَنِ ٱبْتَغَىٰ","ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ",445],["76:27:6",580,"وَرَآءَهُمْ","behind them","يُحِبُّونَ ٱلْعَاجِلَةَ وَيَذَرُونَ","يَوْمًۭا ثَقِيلًۭا",445],["84:10:5",589,"وَرَآءَ","behind","مَنْ أُوتِىَ كِتَـٰبَهُۥ","ظَهْرِهِۦ",445],["85:20:3",590,"وَرَآئِهِم","behind them","وَٱللَّهُ مِن","مُّحِيطٌۢ",445],["100:2:1",599,"فَٱلْمُورِيَـٰتِ","And the producers of sparks","","قَدْحًۭا",3890]]