[["2:49:12",8,"نِسَآءَكُمْ ۚ","your women","يُذَبِّحُونَ أَبْنَآءَكُمْ وَيَسْتَحْيُونَ","وَفِى ذَٰلِكُم بَلَآءٌۭ",203],["2:187:7",29,"نِسَآئِكُمْ ۚ","your wives","ٱلصِّيَامِ ٱلرَّفَثُ إِلَىٰ","هُنَّ لِبَاسٌۭ لَّكُمْ",203],["2:222:8",35,"ٱلنِّسَآءَ","[the] women","هُوَ أَذًۭى فَٱعْتَزِلُوا۟","فِى ٱلْمَحِيضِ ۖ وَلَا",203],["2:223:1",35,"نِسَآؤُكُمْ","Your wives","","حَرْثٌۭ لَّكُمْ فَأْتُوا۟",203],["2:226:4",36,"نِّسَآئِهِمْ","their wives","لِّلَّذِينَ يُؤْلُونَ مِن","تَرَبُّصُ أَرْبَعَةِ أَشْهُرٍۢ ۖ",203],["2:231:3",37,"ٱلنِّسَآءَ","the women","وَإِذَا طَلَّقْتُمُ","فَبَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ",203],["2:232:3",37,"ٱلنِّسَآءَ","[the] women","وَإِذَا طَلَّقْتُمُ","فَبَلَغْنَ أَجَلَهُنَّ فَلَا",203],["2:235:9",38,"ٱلنِّسَآءِ","[to] the women","بِهِۦ مِنْ خِطْبَةِ","أَوْ أَكْنَنتُمْ فِىٓ",203],["2:236:6",38,"ٱلنِّسَآءَ","[the] women","عَلَيْكُمْ إِن طَلَّقْتُمُ","مَا لَمْ تَمَسُّوهُنَّ",203],["3:14:6",51,"ٱلنِّسَآءِ","[the] women","حُبُّ ٱلشَّهَوَٰتِ مِنَ","وَٱلْبَنِينَ وَٱلْقَنَـٰطِيرِ ٱلْمُقَنطَرَةِ",203],["3:42:11",55,"نِسَآءِ","(the) women","وَطَهَّرَكِ وَٱصْطَفَىٰكِ عَلَىٰ","ٱلْعَـٰلَمِينَ",203],["3:61:15",57,"وَنِسَآءَنَا","and our women","نَدْعُ أَبْنَآءَنَا وَأَبْنَآءَكُمْ","وَنِسَآءَكُمْ وَأَنفُسَنَا وَأَنفُسَكُمْ",203],["3:61:16",57,"وَنِسَآءَكُمْ","and your women","أَبْنَآءَنَا وَأَبْنَآءَكُمْ وَنِسَآءَنَا","وَأَنفُسَنَا وَأَنفُسَكُمْ ثُمَّ",203],["4:1:17",77,"وَنِسَآءًۭ ۚ","and women","مِنْهُمَا رِجَالًۭا كَثِيرًۭا","وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِى",203],["4:3:12",77,"ٱلنِّسَآءِ","the women","طَابَ لَكُم مِّنَ","مَثْنَىٰ وَثُلَـٰثَ وَرُبَـٰعَ ۖ",203],["4:4:2",77,"ٱلنِّسَآءَ","the women","وَءَاتُوا۟","صَدُقَـٰتِهِنَّ نِحْلَةًۭ ۚ فَإِن",203],["4:7:7",78,"وَلِلنِّسَآءِ","and for the women","تَرَكَ ٱلْوَٰلِدَانِ وَٱلْأَقْرَبُونَ","نَصِيبٌۭ مِّمَّا تَرَكَ",203],["4:11:11",78,"نِسَآءًۭ","(only) women","ٱلْأُنثَيَيْنِ ۚ فَإِن كُنَّ","فَوْقَ ٱثْنَتَيْنِ فَلَهُنَّ",203],["4:15:5",80,"نِّسَآئِكُمْ","your women","يَأْتِينَ ٱلْفَـٰحِشَةَ مِن","فَٱسْتَشْهِدُوا۟ عَلَيْهِنَّ أَرْبَعَةًۭ",203],["4:19:9",80,"ٱلنِّسَآءَ","the women","لَكُمْ أَن تَرِثُوا۟","كَرْهًۭا ۖ وَلَا تَعْضُلُوهُنَّ",203],["4:22:7",81,"ٱلنِّسَآءِ","the women","نَكَحَ ءَابَآؤُكُم مِّنَ","إِلَّا مَا قَدْ",203],["4:23:19",81,"نِسَآئِكُمْ","(of) your wives","مِّنَ ٱلرَّضَـٰعَةِ وَأُمَّهَـٰتُ","وَرَبَـٰٓئِبُكُمُ ٱلَّـٰتِى فِى",203],["4:23:25",81,"نِّسَآئِكُمُ","your women","فِى حُجُورِكُم مِّن","ٱلَّـٰتِى دَخَلْتُم بِهِنَّ",203],["4:24:3",82,"ٱلنِّسَآءِ","the women","۞ وَٱلْمُحْصَنَـٰتُ مِنَ","إِلَّا مَا مَلَكَتْ",203],["4:32:14",83,"وَلِلنِّسَآءِ","and for women","نَصِيبٌۭ مِّمَّا ٱكْتَسَبُوا۟ ۖ","نَصِيبٌۭ مِّمَّا ٱكْتَسَبْنَ ۚ",203],["4:34:4",84,"ٱلنِّسَآءِ","the women","ٱلرِّجَالُ قَوَّٰمُونَ عَلَى","بِمَا فَضَّلَ ٱللَّهُ",203],["4:43:34",85,"ٱلنِّسَآءَ","the women","ٱلْغَآئِطِ أَوْ لَـٰمَسْتُمُ","فَلَمْ تَجِدُوا۟ مَآءًۭ",203],["4:75:11",90,"وَٱلنِّسَآءِ","and the women","وَٱلْمُسْتَضْعَفِينَ مِنَ ٱلرِّجَالِ","وَٱلْوِلْدَٰنِ ٱلَّذِينَ يَقُولُونَ",203],["4:98:5",94,"وَٱلنِّسَآءِ","and the women","ٱلْمُسْتَضْعَفِينَ مِنَ ٱلرِّجَالِ","وَٱلْوِلْدَٰنِ لَا يَسْتَطِيعُونَ",203],["4:127:3",98,"ٱلنِّسَآءِ ۖ","the women","وَيَسْتَفْتُونَكَ فِى","قُلِ ٱللَّهُ يُفْتِيكُمْ",203],["4:127:15",98,"ٱلنِّسَآءِ","(of) girls","ٱلْكِتَـٰبِ فِى يَتَـٰمَى","ٱلَّـٰتِى لَا تُؤْتُونَهُنَّ",203],["4:129:6",99,"ٱلنِّسَآءِ","[the] women","أَن تَعْدِلُوا۟ بَيْنَ","وَلَوْ حَرَصْتُمْ ۖ فَلَا",203],["4:176:37",106,"وَنِسَآءًۭ","and women","كَانُوٓا۟ إِخْوَةًۭ رِّجَالًۭا","فَلِلذَّكَرِ مِثْلُ حَظِّ",203],["5:6:36",108,"ٱلنِّسَآءَ","(with) the women","ٱلْغَآئِطِ أَوْ لَـٰمَسْتُمُ","فَلَمْ تَجِدُوا۟ مَآءًۭ",203],["7:81:7",160,"ٱلنِّسَآءِ ۚ","the women","شَهْوَةًۭ مِّن دُونِ","بَلْ أَنتُمْ قَوْمٌۭ",203],["7:127:18",165,"نِسَآءَهُمْ","their women","سَنُقَتِّلُ أَبْنَآءَهُمْ وَنَسْتَحْىِۦ","وَإِنَّا فَوْقَهُمْ قَـٰهِرُونَ",203],["7:141:12",167,"نِسَآءَكُمْ ۚ","your women","يُقَتِّلُونَ أَبْنَآءَكُمْ وَيَسْتَحْيُونَ","وَفِى ذَٰلِكُم بَلَآءٌۭ",203],["12:30:2",238,"نِسْوَةٌۭ","women","۞ وَقَالَ","فِى ٱلْمَدِينَةِ ٱمْرَأَتُ",203],["12:50:15",241,"ٱلنِّسْوَةِ","(of) the women","فَسْـَٔلْهُ مَا بَالُ","ٱلَّـٰتِى قَطَّعْنَ أَيْدِيَهُنَّ ۚ",203],["14:6:20",256,"نِسَآءَكُمْ ۚ","your women","وَيُذَبِّحُونَ أَبْنَآءَكُمْ وَيَسْتَحْيُونَ","وَفِى ذَٰلِكُم بَلَآءٌۭ",203],["24:31:43",353,"نِسَآئِهِنَّ","their women","بَنِىٓ أَخَوَٰتِهِنَّ أَوْ","أَوْ مَا مَلَكَتْ",203],["24:31:62",353,"ٱلنِّسَآءِ ۖ","(of) the women","يَظْهَرُوا۟ عَلَىٰ عَوْرَٰتِ","وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ",203],["24:60:3",358,"ٱلنِّسَآءِ","the women","وَٱلْقَوَٰعِدُ مِنَ","ٱلَّـٰتِى لَا يَرْجُونَ",203],["27:55:7",381,"ٱلنِّسَآءِ ۚ","the women","شَهْوَةًۭ مِّن دُونِ","بَلْ أَنتُمْ قَوْمٌۭ",203],["28:4:15",385,"نِسَآءَهُمْ ۚ","their women","يُذَبِّحُ أَبْنَآءَهُمْ وَيَسْتَحْىِۦ","إِنَّهُۥ كَانَ مِنَ",203],["33:30:1",421,"يَـٰنِسَآءَ","O wives","","ٱلنَّبِىِّ مَن يَأْتِ",203],["33:32:1",422,"يَـٰنِسَآءَ","O wives","","ٱلنَّبِىِّ لَسْتُنَّ كَأَحَدٍۢ",203],["33:32:6",422,"ٱلنِّسَآءِ ۚ","the women","لَسْتُنَّ كَأَحَدٍۢ مِّنَ","إِنِ ٱتَّقَيْتُنَّ فَلَا",203],["33:52:4",425,"ٱلنِّسَآءُ","(to marry) women","لَّا يَحِلُّ لَكَ","مِنۢ بَعْدُ وَلَآ",203],["33:55:17",426,"نِسَآئِهِنَّ","their women","أَبْنَآءِ أَخَوَٰتِهِنَّ وَلَا","وَلَا مَا مَلَكَتْ",203],["33:59:6",426,"وَنِسَآءِ","and (the) women","قُل لِّأَزْوَٰجِكَ وَبَنَاتِكَ","ٱلْمُؤْمِنِينَ يُدْنِينَ عَلَيْهِنَّ",203],["40:25:13",469,"نِسَآءَهُمْ ۚ","their women","ءَامَنُوا۟ مَعَهُۥ وَٱسْتَحْيُوا۟","وَمَا كَيْدُ ٱلْكَـٰفِرِينَ",203],["48:25:16",514,"وَنِسَآءٌۭ","and women","وَلَوْلَا رِجَالٌۭ مُّؤْمِنُونَ","مُّؤْمِنَـٰتٌۭ لَّمْ تَعْلَمُوهُمْ",203],["49:11:15",516,"نِسَآءٌۭ","women","خَيْرًۭا مِّنْهُمْ وَلَا","مِّن نِّسَآءٍ عَسَىٰٓ",203],["49:11:17",516,"نِّسَآءٍ","(other) women","وَلَا نِسَآءٌۭ مِّن","عَسَىٰٓ أَن يَكُنَّ",203],["58:2:5",542,"نِّسَآئِهِم","(to) their wives","يُظَـٰهِرُونَ مِنكُم مِّن","مَّا هُنَّ أُمَّهَـٰتِهِمْ ۖ",203],["58:3:4",542,"نِّسَآئِهِمْ","(to) their wives","وَٱلَّذِينَ يُظَـٰهِرُونَ مِن","ثُمَّ يَعُودُونَ لِمَا",203],["65:1:5",558,"ٱلنِّسَآءَ","[the] women","ٱلنَّبِىُّ إِذَا طَلَّقْتُمُ","فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ وَأَحْصُوا۟",203],["65:4:6",558,"نِّسَآئِكُمْ","your women","مِنَ ٱلْمَحِيضِ مِن","إِنِ ٱرْتَبْتُمْ فَعِدَّتُهُنَّ",203]]