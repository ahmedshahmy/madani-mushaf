[["2:117:1",18,"بَدِيعُ","(The) Originator","","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ وَإِذَا",2331],["6:101:1",140,"بَدِيعُ","Originator","","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ أَنَّىٰ",2331],["46:9:4",503,"بِدْعًۭا","a new (one)","قُلْ مَا كُنتُ","مِّنَ ٱلرُّسُلِ وَمَآ",3353],["57:27:20",541,"ٱبْتَدَعُوهَا","they innovated","رَأْفَةًۭ وَرَحْمَةًۭ وَرَهْبَانِيَّةً","مَا كَتَبْنَـٰهَا عَلَيْهِمْ",4792]]