[["7:73:20",159,"نَاقَةُ","(is) a she-camel","مِّن رَّبِّكُمْ ۖ هَـٰذِهِۦ","ٱللَّهِ لَكُمْ ءَايَةًۭ ۖ",1091],["7:77:2",160,"ٱلنَّاقَةَ","the she-camel","فَعَقَرُوا۟","وَعَتَوْا۟ عَنْ أَمْرِ",1091],["11:64:3",229,"نَاقَةُ","she-camel","وَيَـٰقَوْمِ هَـٰذِهِۦ","ٱللَّهِ لَكُمْ ءَايَةًۭ",1091],["17:59:13",288,"ٱلنَّاقَةَ","the she-camel","ٱلْأَوَّلُونَ ۚ وَءَاتَيْنَا ثَمُودَ","مُبْصِرَةًۭ فَظَلَمُوا۟ بِهَا ۚ",1091],["26:155:3",373,"نَاقَةٌۭ","(is) a she-camel","قَالَ هَـٰذِهِۦ","لَّهَا شِرْبٌۭ وَلَكُمْ",1091],["54:27:3",529,"ٱلنَّاقَةِ","the she-camel","إِنَّا مُرْسِلُوا۟","فِتْنَةًۭ لَّهُمْ فَٱرْتَقِبْهُمْ",1091],["91:13:5",595,"نَاقَةَ","(It is the) she-camel","لَهُمْ رَسُولُ ٱللَّهِ","ٱللَّهِ وَسُقْيَـٰهَا",1091]]