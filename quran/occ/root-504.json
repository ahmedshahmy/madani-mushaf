[["2:189:6",29,"مَوَٰقِيتُ","(are) indicators of periods","ٱلْأَهِلَّةِ ۖ قُلْ هِىَ","لِلنَّاسِ وَٱلْحَجِّ ۗ وَلَيْسَ",985],["4:103:20",95,"مَّوْقُوتًۭا","(at) fixed times","عَلَى ٱلْمُؤْمِنِينَ كِتَـٰبًۭا","",3940],["7:142:8",167,"مِيقَـٰتُ","(the) set term","وَأَتْمَمْنَـٰهَا بِعَشْرٍۢ فَتَمَّ","رَبِّهِۦٓ أَرْبَعِينَ لَيْلَةًۭ ۚ",985],["7:143:4",167,"لِمِيقَـٰتِنَا","to Our appointed place","وَلَمَّا جَآءَ مُوسَىٰ","وَكَلَّمَهُۥ رَبُّهُۥ قَالَ",985],["7:155:6",169,"لِّمِيقَـٰتِنَا ۖ","for Our appointment","قَوْمَهُۥ سَبْعِينَ رَجُلًۭا","فَلَمَّآ أَخَذَتْهُمُ ٱلرَّجْفَةُ",985],["7:187:13",174,"لِوَقْتِهَآ","its time","رَبِّى ۖ لَا يُجَلِّيهَا","إِلَّا هُوَ ۚ ثَقُلَتْ",2027],["15:38:3",264,"ٱلْوَقْتِ","(of) the time","إِلَىٰ يَوْمِ","ٱلْمَعْلُومِ",2027],["26:38:3",368,"لِمِيقَـٰتِ","for (the) appointment","فَجُمِعَ ٱلسَّحَرَةُ","يَوْمٍۢ مَّعْلُومٍۢ",985],["38:81:3",457,"ٱلْوَقْتِ","(of) the time","إِلَىٰ يَوْمِ","ٱلْمَعْلُومِ",2027],["44:40:4",498,"مِيقَـٰتُهُمْ","(is) an appointed term for them","إِنَّ يَوْمَ ٱلْفَصْلِ","أَجْمَعِينَ",985],["56:50:3",535,"مِيقَـٰتِ","(the) appointment","لَمَجْمُوعُونَ إِلَىٰ","يَوْمٍۢ مَّعْلُومٍۢ",985],["77:11:3",580,"أُقِّتَتْ","are gathered to their appointed time","وَإِذَا ٱلرُّسُلُ","",3066],["78:17:5",582,"مِيقَـٰتًۭا","an appointed time","يَوْمَ ٱلْفَصْلِ كَانَ","",985]]