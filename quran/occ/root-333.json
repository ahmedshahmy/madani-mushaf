[["2:229:3",36,"فَإِمْسَاكٌۢ","Then to retain","ٱلطَّلَـٰقُ مَرَّتَانِ ۖ","بِمَعْرُوفٍ أَوْ تَسْرِيحٌۢ",2931],["2:231:6",37,"فَأَمْسِكُوهُنَّ","then retain them","ٱلنِّسَآءَ فَبَلَغْنَ أَجَلَهُنَّ","بِمَعْرُوفٍ أَوْ سَرِّحُوهُنَّ",539],["2:231:12",37,"تُمْسِكُوهُنَّ","retain them","سَرِّحُوهُنَّ بِمَعْرُوفٍۢ ۚ وَلَا","ضِرَارًۭا لِّتَعْتَدُوا۟ ۚ وَمَن",539],["2:256:16",42,"ٱسْتَمْسَكَ","he grasped","وَيُؤْمِنۢ بِٱللَّهِ فَقَدِ","بِٱلْعُرْوَةِ ٱلْوُثْقَىٰ لَا",2108],["4:15:12",80,"فَأَمْسِكُوهُنَّ","then confine them","مِّنكُمْ ۖ فَإِن شَهِدُوا۟","فِى ٱلْبُيُوتِ حَتَّىٰ",539],["5:4:20",107,"أَمْسَكْنَ","they catch","ٱللَّهُ ۖ فَكُلُوا۟ مِمَّآ","عَلَيْكُمْ وَٱذْكُرُوا۟ ٱسْمَ",539],["7:170:2",172,"يُمَسِّكُونَ","hold fast","وَٱلَّذِينَ","بِٱلْكِتَـٰبِ وَأَقَامُوا۟ ٱلصَّلَوٰةَ",4725],["16:59:9",273,"أَيُمْسِكُهُۥ","Should he keep it","مَا بُشِّرَ بِهِۦٓ ۚ","عَلَىٰ هُونٍ أَمْ",539],["16:79:10",275,"يُمْسِكُهُنَّ","holds them up","جَوِّ ٱلسَّمَآءِ مَا","إِلَّا ٱللَّهُ ۗ إِنَّ",539],["17:100:9",292,"لَّأَمْسَكْتُمْ","surely you would withhold","رَحْمَةِ رَبِّىٓ إِذًۭا","خَشْيَةَ ٱلْإِنفَاقِ ۚ وَكَانَ",539],["22:65:15",340,"وَيُمْسِكُ","And He withholds","فِى ٱلْبَحْرِ بِأَمْرِهِۦ","ٱلسَّمَآءَ أَن تَقَعَ",539],["31:22:9",413,"ٱسْتَمْسَكَ","he has grasped","وَهُوَ مُحْسِنٌۭ فَقَدِ","بِٱلْعُرْوَةِ ٱلْوُثْقَىٰ ۗ وَإِلَى",2108],["33:37:9",423,"أَمْسِكْ","Keep","عَلَيْهِ وَأَنْعَمْتَ عَلَيْهِ","عَلَيْكَ زَوْجَكَ وَٱتَّقِ",539],["35:2:8",434,"مُمْسِكَ","(can) withhold","مِن رَّحْمَةٍۢ فَلَا","لَهَا ۖ وَمَا يُمْسِكْ",3817],["35:2:11",434,"يُمْسِكْ","He withholds","مُمْسِكَ لَهَا ۖ وَمَا","فَلَا مُرْسِلَ لَهُۥ",539],["35:41:3",439,"يُمْسِكُ","upholds","۞ إِنَّ ٱللَّهَ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ أَن",539],["35:41:11",439,"أَمْسَكَهُمَا","can uphold them","وَلَئِن زَالَتَآ إِنْ","مِنْ أَحَدٍۢ مِّنۢ",539],["38:39:5",455,"أَمْسِكْ","withhold","عَطَآؤُنَا فَٱمْنُنْ أَوْ","بِغَيْرِ حِسَابٍۢ",539],["39:38:29",462,"مُمْسِكَـٰتُ","withholders","بِرَحْمَةٍ هَلْ هُنَّ","رَحْمَتِهِۦ ۚ قُلْ حَسْبِىَ",3818],["39:42:11",463,"فَيُمْسِكُ","Then He keeps","تَمُتْ فِى مَنَامِهَا ۖ","ٱلَّتِى قَضَىٰ عَلَيْهَا",539],["43:21:8",490,"مُسْتَمْسِكُونَ","(are) holding fast","قَبْلِهِۦ فَهُم بِهِۦ","",3860],["43:43:1",492,"فَٱسْتَمْسِكْ","So hold fast","","بِٱلَّذِىٓ أُوحِىَ إِلَيْكَ ۖ",2108],["60:10:39",550,"تُمْسِكُوا۟","hold","ءَاتَيْتُمُوهُنَّ أُجُورَهُنَّ ۚ وَلَا","بِعِصَمِ ٱلْكَوَافِرِ وَسْـَٔلُوا۟",539],["65:2:4",558,"فَأَمْسِكُوهُنَّ","then retain them","فَإِذَا بَلَغْنَ أَجَلَهُنَّ","بِمَعْرُوفٍ أَوْ فَارِقُوهُنَّ",539],["67:19:9",563,"يُمْسِكُهُنَّ","holds them","صَـٰٓفَّـٰتٍۢ وَيَقْبِضْنَ ۚ مَا","إِلَّا ٱلرَّحْمَـٰنُ ۚ إِنَّهُۥ",539],["67:21:6",563,"أَمْسَكَ","He withheld","ٱلَّذِى يَرْزُقُكُمْ إِنْ","رِزْقَهُۥ ۚ بَل لَّجُّوا۟",539],["83:26:2",588,"مِسْكٌۭ ۚ","(will be of) musk","خِتَـٰمُهُۥ","وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ",3746]]