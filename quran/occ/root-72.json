[["1:7:5",1,"غَيْرِ","not (of)","ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ","ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا",75],["2:59:5",9,"غَيْرَ","other (than)","ٱلَّذِينَ ظَلَمُوا۟ قَوْلًا","ٱلَّذِى قِيلَ لَهُمْ",75],["2:61:53",9,"بِغَيْرِ","without (any)","ٱللَّهِ وَيَقْتُلُونَ ٱلنَّبِيِّـۧنَ","ٱلْحَقِّ ۗ ذَٰلِكَ بِمَا",75],["2:173:11",26,"لِغَيْرِ","to other than","وَمَآ أُهِلَّ بِهِۦ","ٱللَّهِ ۖ فَمَنِ ٱضْطُرَّ",75],["2:173:15",26,"غَيْرَ","without","ٱللَّهِ ۖ فَمَنِ ٱضْطُرَّ","بَاغٍۢ وَلَا عَادٍۢ",75],["2:212:19",33,"بِغَيْرِ","without","يَرْزُقُ مَن يَشَآءُ","حِسَابٍۢ",75],["2:230:11",36,"غَيْرَهُۥ ۗ","other than him","حَتَّىٰ تَنكِحَ زَوْجًا","فَإِن طَلَّقَهَا فَلَا",75],["2:240:11",39,"غَيْرَ","without","مَّتَـٰعًا إِلَى ٱلْحَوْلِ","إِخْرَاجٍۢ ۚ فَإِنْ خَرَجْنَ",75],["3:21:8",52,"بِغَيْرِ","without","ٱللَّهِ وَيَقْتُلُونَ ٱلنَّبِيِّـۧنَ","حَقٍّۢ وَيَقْتُلُونَ ٱلَّذِينَ",75],["3:27:20",53,"بِغَيْرِ","without","وَتَرْزُقُ مَن تَشَآءُ","حِسَابٍۢ",75],["3:37:33",54,"بِغَيْرِ","without","يَرْزُقُ مَن يَشَآءُ","حِسَابٍ",75],["3:83:1",60,"أَفَغَيْرَ","So is (it) other than","","دِينِ ٱللَّهِ يَبْغُونَ",75],["3:85:3",61,"غَيْرَ","other than","وَمَن يَبْتَغِ","ٱلْإِسْلَـٰمِ دِينًۭا فَلَن",75],["3:112:29",64,"بِغَيْرِ","without","ٱللَّهِ وَيَقْتُلُونَ ٱلْأَنۢبِيَآءَ","حَقٍّۢ ۚ ذَٰلِكَ بِمَا",75],["3:154:18",70,"غَيْرَ","other than","أَنفُسُهُمْ يَظُنُّونَ بِٱللَّهِ","ٱلْحَقِّ ظَنَّ ٱلْجَـٰهِلِيَّةِ ۖ",75],["3:181:17",74,"بِغَيْرِ","without","قَالُوا۟ وَقَتْلَهُمُ ٱلْأَنۢبِيَآءَ","حَقٍّۢ وَنَقُولُ ذُوقُوا۟",75],["4:12:81",79,"غَيْرَ","without","بِهَآ أَوْ دَيْنٍ","مُضَآرٍّۢ ۚ وَصِيَّةًۭ مِّنَ",75],["4:24:20",82,"غَيْرَ","not","تَبْتَغُوا۟ بِأَمْوَٰلِكُم مُّحْصِنِينَ","مُسَـٰفِحِينَ ۚ فَمَا ٱسْتَمْتَعْتُم",75],["4:25:30",82,"غَيْرَ","not","أُجُورَهُنَّ بِٱلْمَعْرُوفِ مُحْصَنَـٰتٍ","مُسَـٰفِحَـٰتٍۢ وَلَا مُتَّخِذَٰتِ",75],["4:46:12",86,"غَيْرَ","not","سَمِعْنَا وَعَصَيْنَا وَٱسْمَعْ","مُسْمَعٍۢ وَرَٰعِنَا لَيًّۢا",75],["4:56:13",87,"غَيْرَهَا","for other (than) that","جُلُودُهُم بَدَّلْنَـٰهُمْ جُلُودًا","لِيَذُوقُوا۟ ٱلْعَذَابَ ۗ إِنَّ",75],["4:81:10",91,"غَيْرَ","other than","بَيَّتَ طَآئِفَةٌۭ مِّنْهُمْ","ٱلَّذِى تَقُولُ ۖ وَٱللَّهُ",75],["4:82:8",91,"غَيْرِ","other than","كَانَ مِنْ عِندِ","ٱللَّهِ لَوَجَدُوا۟ فِيهِ",75],["4:95:6",94,"غَيْرُ","other than","ٱلْقَـٰعِدُونَ مِنَ ٱلْمُؤْمِنِينَ","أُو۟لِى ٱلضَّرَرِ وَٱلْمُجَـٰهِدُونَ",75],["4:115:11",97,"غَيْرَ","other than","لَهُ ٱلْهُدَىٰ وَيَتَّبِعْ","سَبِيلِ ٱلْمُؤْمِنِينَ نُوَلِّهِۦ",75],["4:119:8",97,"فَلَيُغَيِّرُنَّ","so they will surely change","ءَاذَانَ ٱلْأَنْعَـٰمِ وَلَـَٔامُرَنَّهُمْ","خَلْقَ ٱللَّهِ ۚ وَمَن",1685],["4:140:22",100,"غَيْرِهِۦٓ ۚ","other than that","يَخُوضُوا۟ فِى حَدِيثٍ","إِنَّكُمْ إِذًۭا مِّثْلُهُمْ ۗ",75],["4:155:9",103,"بِغَيْرِ","without","ٱللَّهِ وَقَتْلِهِمُ ٱلْأَنۢبِيَآءَ","حَقٍّۢ وَقَوْلِهِمْ قُلُوبُنَا",75],["5:1:14",106,"غَيْرَ","not","مَا يُتْلَىٰ عَلَيْكُمْ","مُحِلِّى ٱلصَّيْدِ وَأَنتُمْ",75],["5:3:9",107,"لِغَيْرِ","to other than","ٱلْخِنزِيرِ وَمَآ أُهِلَّ","ٱللَّهِ بِهِۦ وَٱلْمُنْخَنِقَةُ",75],["5:3:55",107,"غَيْرَ","(and) not","ٱضْطُرَّ فِى مَخْمَصَةٍ","مُتَجَانِفٍۢ لِّإِثْمٍۢ ۙ فَإِنَّ",75],["5:5:28",107,"غَيْرَ","not","ءَاتَيْتُمُوهُنَّ أُجُورَهُنَّ مُحْصِنِينَ","مُسَـٰفِحِينَ وَلَا مُتَّخِذِىٓ",75],["5:32:12",113,"بِغَيْرِ","other than","مَن قَتَلَ نَفْسًۢا","نَفْسٍ أَوْ فَسَادٍۢ",75],["5:77:8",120,"غَيْرَ","other than","تَغْلُوا۟ فِى دِينِكُمْ","ٱلْحَقِّ وَلَا تَتَّبِعُوٓا۟",75],["5:106:19",125,"غَيْرِكُمْ","other than you","أَوْ ءَاخَرَانِ مِنْ","إِنْ أَنتُمْ ضَرَبْتُمْ",75],["6:14:2",129,"أَغَيْرَ","Is it other than","قُلْ","ٱللَّهِ أَتَّخِذُ وَلِيًّۭا",75],["6:40:10",132,"أَغَيْرَ","is it other","أَوْ أَتَتْكُمُ ٱلسَّاعَةُ","ٱللَّهِ تَدْعُونَ إِن",75],["6:46:13",133,"غَيْرُ","other than","قُلُوبِكُم مَّنْ إِلَـٰهٌ","ٱللَّهِ يَأْتِيكُم بِهِ ۗ",75],["6:68:13",135,"غَيْرِهِۦ ۚ","other than it","يَخُوضُوا۟ فِى حَدِيثٍ","وَإِمَّا يُنسِيَنَّكَ ٱلشَّيْطَـٰنُ",75],["6:93:44",139,"غَيْرَ","other than","تَقُولُونَ عَلَى ٱللَّهِ","ٱلْحَقِّ وَكُنتُمْ عَنْ",75],["6:99:31",140,"وَغَيْرَ","and not","وَٱلزَّيْتُونَ وَٱلرُّمَّانَ مُشْتَبِهًۭا","مُتَشَـٰبِهٍ ۗ ٱنظُرُوٓا۟ إِلَىٰ",75],["6:100:10",140,"بِغَيْرِ","without","لَهُۥ بَنِينَ وَبَنَـٰتٍۭ","عِلْمٍۢ ۚ سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ",75],["6:108:11",141,"بِغَيْرِ","without","فَيَسُبُّوا۟ ٱللَّهَ عَدْوًۢا","عِلْمٍۢ ۗ كَذَٰلِكَ زَيَّنَّا",75],["6:114:1",142,"أَفَغَيْرَ","Then is (it) other than","","ٱللَّهِ أَبْتَغِى حَكَمًۭا",75],["6:119:24",143,"بِغَيْرِ","without","كَثِيرًۭا لَّيُضِلُّونَ بِأَهْوَآئِهِم","عِلْمٍ ۗ إِنَّ رَبَّكَ",75],["6:140:7",146,"بِغَيْرِ","without","قَتَلُوٓا۟ أَوْلَـٰدَهُمْ سَفَهًۢا","عِلْمٍۢ وَحَرَّمُوا۟ مَا",75],["6:141:6",146,"وَغَيْرَ","and other than","أَنشَأَ جَنَّـٰتٍۢ مَّعْرُوشَـٰتٍۢ","مَعْرُوشَـٰتٍۢ وَٱلنَّخْلَ وَٱلزَّرْعَ",75],["6:141:15",146,"وَغَيْرَ","and other than","وَٱلزَّيْتُونَ وَٱلرُّمَّانَ مُتَشَـٰبِهًۭا","مُتَشَـٰبِهٍۢ ۚ كُلُوا۟ مِن",75],["6:144:33",147,"بِغَيْرِ","without","كَذِبًۭا لِّيُضِلَّ ٱلنَّاسَ","عِلْمٍ ۗ إِنَّ ٱللَّهَ",75],["6:145:27",147,"لِغَيْرِ","to other than","أَوْ فِسْقًا أُهِلَّ","ٱللَّهِ بِهِۦ ۚ فَمَنِ",75],["6:145:32",147,"غَيْرَ","not","بِهِۦ ۚ فَمَنِ ٱضْطُرَّ","بَاغٍۢ وَلَا عَادٍۢ",75],["6:164:2",150,"أَغَيْرَ","Is (it) other than","قُلْ","ٱللَّهِ أَبْغِى رَبًّۭا",75],["7:33:13",154,"بِغَيْرِ","without","بَطَنَ وَٱلْإِثْمَ وَٱلْبَغْىَ","ٱلْحَقِّ وَأَن تُشْرِكُوا۟",75],["7:53:27",157,"غَيْرَ","other than","أَوْ نُرَدُّ فَنَعْمَلَ","ٱلَّذِى كُنَّا نَعْمَلُ ۚ",75],["7:59:14",158,"غَيْرُهُۥٓ","other than Him","لَكُم مِّنْ إِلَـٰهٍ","إِنِّىٓ أَخَافُ عَلَيْكُمْ",75],["7:65:13",158,"غَيْرُهُۥٓ ۚ","other than Him","لَكُم مِّنْ إِلَـٰهٍ","أَفَلَا تَتَّقُونَ",75],["7:73:13",159,"غَيْرُهُۥ ۖ","other than Him","لَكُم مِّنْ إِلَـٰهٍ","قَدْ جَآءَتْكُم بَيِّنَةٌۭ",75],["7:85:13",161,"غَيْرُهُۥ ۖ","other than Him","لَكُم مِّنْ إِلَـٰهٍ","قَدْ جَآءَتْكُم بَيِّنَةٌۭ",75],["7:140:2",167,"أَغَيْرَ","Should other than","قَالَ","ٱللَّهِ أَبْغِيكُمْ إِلَـٰهًۭا",75],["7:146:8",168,"بِغَيْرِ","without","يَتَكَبَّرُونَ فِى ٱلْأَرْضِ","ٱلْحَقِّ وَإِن يَرَوْا۟",75],["7:162:6",171,"غَيْرَ","other than","ظَلَمُوا۟ مِنْهُمْ قَوْلًا","ٱلَّذِى قِيلَ لَهُمْ",75],["8:7:10",177,"غَيْرَ","(one) other than","لَكُمْ وَتَوَدُّونَ أَنَّ","ذَاتِ ٱلشَّوْكَةِ تَكُونُ",75],["8:53:6",184,"مُغَيِّرًۭا","One Who changes","ٱللَّهَ لَمْ يَكُ","نِّعْمَةً أَنْعَمَهَا عَلَىٰ",3801],["8:53:12",184,"يُغَيِّرُوا۟","they change","عَلَىٰ قَوْمٍ حَتَّىٰ","مَا بِأَنفُسِهِمْ ۙ وَأَنَّ",1685],["9:2:8",187,"غَيْرُ","(can) not","أَشْهُرٍۢ وَٱعْلَمُوٓا۟ أَنَّكُمْ","مُعْجِزِى ٱللَّهِ ۙ وَأَنَّ",75],["9:3:25",187,"غَيْرُ","(can) not","تَوَلَّيْتُمْ فَٱعْلَمُوٓا۟ أَنَّكُمْ","مُعْجِزِى ٱللَّهِ ۗ وَبَشِّرِ",75],["9:39:8",193,"غَيْرَكُمْ","other than you","أَلِيمًۭا وَيَسْتَبْدِلْ قَوْمًا","وَلَا تَضُرُّوهُ شَيْـًۭٔا ۗ",75],["10:15:13",210,"غَيْرِ","other (than)","لِقَآءَنَا ٱئْتِ بِقُرْءَانٍ","هَـٰذَآ أَوْ بَدِّلْهُ ۚ",75],["10:23:8",211,"بِغَيْرِ","without","يَبْغُونَ فِى ٱلْأَرْضِ","ٱلْحَقِّ ۗ يَـٰٓأَيُّهَا ٱلنَّاسُ",75],["11:46:9",227,"غَيْرُ","(is) other than","أَهْلِكَ ۖ إِنَّهُۥ عَمَلٌ","صَـٰلِحٍۢ ۖ فَلَا تَسْـَٔلْنِ",75],["11:50:13",227,"غَيْرُهُۥٓ ۖ","other than Him","لَكُم مِّنْ إِلَـٰهٍ","إِنْ أَنتُمْ إِلَّا",75],["11:57:12",228,"غَيْرَكُمْ","other than you","وَيَسْتَخْلِفُ رَبِّى قَوْمًا","وَلَا تَضُرُّونَهُۥ شَيْـًٔا ۚ",75],["11:61:13",228,"غَيْرُهُۥ ۖ","other than Him","لَكُم مِّنْ إِلَـٰهٍ","هُوَ أَنشَأَكُم مِّنَ",75],["11:63:21",229,"غَيْرَ","but","عَصَيْتُهُۥ ۖ فَمَا تَزِيدُونَنِى","تَخْسِيرٍۢ",75],["11:65:10",229,"غَيْرُ","not","أَيَّامٍۢ ۖ ذَٰلِكَ وَعْدٌ","مَكْذُوبٍۢ",75],["11:76:13",230,"غَيْرُ","(which) cannot","وَإِنَّهُمْ ءَاتِيهِمْ عَذَابٌ","مَرْدُودٍۢ",75],["11:84:13",231,"غَيْرُهُۥ ۖ","other than Him","لَكُم مِّنْ إِلَـٰهٍ","وَلَا تَنقُصُوا۟ ٱلْمِكْيَالَ",75],["11:101:23",233,"غَيْرَ","other than","رَبِّكَ ۖ وَمَا زَادُوهُمْ","تَتْبِيبٍۢ",75],["11:108:17",233,"غَيْرَ","not","شَآءَ رَبُّكَ ۖ عَطَآءً","مَجْذُوذٍۢ",75],["11:109:19",234,"غَيْرَ","without","وَإِنَّا لَمُوَفُّوهُمْ نَصِيبَهُمْ","مَنقُوصٍۢ",75],["13:2:5",249,"بِغَيْرِ","without","ٱلَّذِى رَفَعَ ٱلسَّمَـٰوَٰتِ","عَمَدٍۢ تَرَوْنَهَا ۖ ثُمَّ",75],["13:4:11",249,"وَغَيْرُ","and not","وَزَرْعٌۭ وَنَخِيلٌۭ صِنْوَانٌۭ","صِنْوَانٍۢ يُسْقَىٰ بِمَآءٍۢ",75],["13:11:15",250,"يُغَيِّرُ","change","إِنَّ ٱللَّهَ لَا","مَا بِقَوْمٍ حَتَّىٰ",1685],["13:11:19",250,"يُغَيِّرُوا۟","they change","مَا بِقَوْمٍ حَتَّىٰ","مَا بِأَنفُسِهِمْ ۗ وَإِذَآ",1685],["14:37:7",260,"غَيْرِ","not","مِن ذُرِّيَّتِى بِوَادٍ","ذِى زَرْعٍ عِندَ",75],["14:48:4",261,"غَيْرَ","(to) other (than)","يَوْمَ تُبَدَّلُ ٱلْأَرْضُ","ٱلْأَرْضِ وَٱلسَّمَـٰوَٰتُ ۖ وَبَرَزُوا۟",75],["16:21:2",269,"غَيْرُ","not alive","أَمْوَٰتٌ","أَحْيَآءٍۢ ۖ وَمَا يَشْعُرُونَ",75],["16:25:10",269,"بِغَيْرِ","without","أَوْزَارِ ٱلَّذِينَ يُضِلُّونَهُم","عِلْمٍ ۗ أَلَا سَآءَ",75],["16:52:9",272,"أَفَغَيْرَ","Then is it other (than)","وَلَهُ ٱلدِّينُ وَاصِبًا ۚ","ٱللَّهِ تَتَّقُونَ",75],["16:115:10",280,"لِغَيْرِ","to other (than)","ٱلْخِنزِيرِ وَمَآ أُهِلَّ","ٱللَّهِ بِهِۦ ۖ فَمَنِ",75],["16:115:15",280,"غَيْرَ","without (being)","بِهِۦ ۖ فَمَنِ ٱضْطُرَّ","بَاغٍۢ وَلَا عَادٍۢ",75],["17:73:10",289,"غَيْرَهُۥ ۖ","other (than) it","إِلَيْكَ لِتَفْتَرِىَ عَلَيْنَا","وَإِذًۭا لَّٱتَّخَذُوكَ خَلِيلًۭا",75],["18:74:11",301,"بِغَيْرِ","for other than","أَقَتَلْتَ نَفْسًۭا زَكِيَّةًۢ","نَفْسٍۢ لَّقَدْ جِئْتَ",75],["20:22:8",313,"غَيْرِ","without any","تَخْرُجْ بَيْضَآءَ مِنْ","سُوٓءٍ ءَايَةً أُخْرَىٰ",75],["22:3:7",332,"بِغَيْرِ","without","يُجَـٰدِلُ فِى ٱللَّهِ","عِلْمٍۢ وَيَتَّبِعُ كُلَّ",75],["22:5:23",332,"وَغَيْرِ","and unformed","مِن مُّضْغَةٍۢ مُّخَلَّقَةٍۢ","مُخَلَّقَةٍۢ لِّنُبَيِّنَ لَكُمْ ۚ",75],["22:8:7",333,"بِغَيْرِ","without","يُجَـٰدِلُ فِى ٱللَّهِ","عِلْمٍۢ وَلَا هُدًۭى",75],["22:31:3",336,"غَيْرَ","not","حُنَفَآءَ لِلَّهِ","مُشْرِكِينَ بِهِۦ ۚ وَمَن",75],["22:40:5",337,"بِغَيْرِ","without","أُخْرِجُوا۟ مِن دِيَـٰرِهِم","حَقٍّ إِلَّآ أَن",75],["23:6:9",342,"غَيْرُ","(are) not","مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ","مَلُومِينَ",75],["23:23:14",343,"غَيْرُهُۥٓ ۖ","other than Him","لَكُم مِّنْ إِلَـٰهٍ","أَفَلَا تَتَّقُونَ",75],["23:32:12",344,"غَيْرُهُۥٓ ۖ","other than Him","لَكُم مِّنْ إِلَـٰهٍ","أَفَلَا تَتَّقُونَ",75],["24:27:7",352,"غَيْرَ","other (than)","لَا تَدْخُلُوا۟ بُيُوتًا","بُيُوتِكُمْ حَتَّىٰ تَسْتَأْنِسُوا۟",75],["24:29:7",353,"غَيْرَ","not","أَن تَدْخُلُوا۟ بُيُوتًا","مَسْكُونَةٍۢ فِيهَا مَتَـٰعٌۭ",75],["24:31:50",353,"غَيْرِ","having no physical desire","أَيْمَـٰنُهُنَّ أَوِ ٱلتَّـٰبِعِينَ","أُو۟لِى ٱلْإِرْبَةِ مِنَ",75],["24:38:13",355,"بِغَيْرِ","without","يَرْزُقُ مَن يَشَآءُ","حِسَابٍۢ",75],["24:60:14",358,"غَيْرَ","not","أَن يَضَعْنَ ثِيَابَهُنَّ","مُتَبَرِّجَـٰتٍۭ بِزِينَةٍۢ ۖ وَأَن",75],["26:29:5",368,"غَيْرِى","other than me","لَئِنِ ٱتَّخَذْتَ إِلَـٰهًا","لَأَجْعَلَنَّكَ مِنَ ٱلْمَسْجُونِينَ",75],["27:12:8",377,"غَيْرِ","without","تَخْرُجْ بَيْضَآءَ مِنْ","سُوٓءٍۢ ۖ فِى تِسْعِ",75],["27:22:2",378,"غَيْرَ","not","فَمَكَثَ","بَعِيدٍۢ فَقَالَ أَحَطتُ",75],["28:32:8",389,"غَيْرِ","without","تَخْرُجْ بَيْضَآءَ مِنْ","سُوٓءٍۢ وَٱضْمُمْ إِلَيْكَ",75],["28:38:10",390,"غَيْرِى","other than me","لَكُم مِّنْ إِلَـٰهٍ","فَأَوْقِدْ لِى يَـٰهَـٰمَـٰنُ",75],["28:39:6",390,"بِغَيْرِ","without","وَجُنُودُهُۥ فِى ٱلْأَرْضِ","ٱلْحَقِّ وَظَنُّوٓا۟ أَنَّهُمْ",75],["28:50:14",391,"بِغَيْرِ","without","مِمَّنِ ٱتَّبَعَ هَوَىٰهُ","هُدًۭى مِّنَ ٱللَّهِ ۚ",75],["28:71:14",394,"غَيْرُ","besides","ٱلْقِيَـٰمَةِ مَنْ إِلَـٰهٌ","ٱللَّهِ يَأْتِيكُم بِضِيَآءٍ ۖ",75],["28:72:14",394,"غَيْرُ","besides","ٱلْقِيَـٰمَةِ مَنْ إِلَـٰهٌ","ٱللَّهِ يَأْتِيكُم بِلَيْلٍۢ",75],["30:29:6",407,"بِغَيْرِ","without","ٱلَّذِينَ ظَلَمُوٓا۟ أَهْوَآءَهُم","عِلْمٍۢ ۖ فَمَن يَهْدِى",75],["30:55:8",410,"غَيْرَ","but","ٱلْمُجْرِمُونَ مَا لَبِثُوا۟","سَاعَةٍۢ ۚ كَذَٰلِكَ كَانُوا۟",75],["31:6:11",411,"بِغَيْرِ","without","عَن سَبِيلِ ٱللَّهِ","عِلْمٍۢ وَيَتَّخِذَهَا هُزُوًا ۚ",75],["31:10:3",411,"بِغَيْرِ","without","خَلَقَ ٱلسَّمَـٰوَٰتِ","عَمَدٍۢ تَرَوْنَهَا ۖ وَأَلْقَىٰ",75],["31:20:24",413,"بِغَيْرِ","without","يُجَـٰدِلُ فِى ٱللَّهِ","عِلْمٍۢ وَلَا هُدًۭى",75],["33:53:14",425,"غَيْرَ","without","لَكُمْ إِلَىٰ طَعَامٍ","نَـٰظِرِينَ إِنَىٰهُ وَلَـٰكِنْ",75],["33:58:5",426,"بِغَيْرِ","for other than","يُؤْذُونَ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ","مَا ٱكْتَسَبُوا۟ فَقَدِ",75],["35:3:10",434,"غَيْرُ","other (than) Allah","هَلْ مِنْ خَـٰلِقٍ","ٱللَّهِ يَرْزُقُكُم مِّنَ",75],["35:37:8",438,"غَيْرَ","other than","أَخْرِجْنَا نَعْمَلْ صَـٰلِحًا","ٱلَّذِى كُنَّا نَعْمَلُ ۚ",75],["38:39:6",455,"بِغَيْرِ","without","فَٱمْنُنْ أَوْ أَمْسِكْ","حِسَابٍۢ",75],["39:10:20",459,"بِغَيْرِ","without","يُوَفَّى ٱلصَّـٰبِرُونَ أَجْرَهُم","حِسَابٍۢ",75],["39:28:3",461,"غَيْرَ","without","قُرْءَانًا عَرَبِيًّا","ذِى عِوَجٍۢ لَّعَلَّهُمْ",75],["39:64:2",465,"أَفَغَيْرَ","Is (it) other than","قُلْ","ٱللَّهِ تَأْمُرُوٓنِّىٓ أَعْبُدُ",75],["40:35:6",471,"بِغَيْرِ","without","فِىٓ ءَايَـٰتِ ٱللَّهِ","سُلْطَـٰنٍ أَتَىٰهُمْ ۖ كَبُرَ",75],["40:40:22",471,"بِغَيْرِ","without","ٱلْجَنَّةَ يُرْزَقُونَ فِيهَا","حِسَابٍۢ",75],["40:56:7",473,"بِغَيْرِ","without","فِىٓ ءَايَـٰتِ ٱللَّهِ","سُلْطَـٰنٍ أَتَىٰهُمْ ۙ إِن",75],["40:75:7",475,"بِغَيْرِ","without","تَفْرَحُونَ فِى ٱلْأَرْضِ","ٱلْحَقِّ وَبِمَا كُنتُمْ",75],["41:8:8",477,"غَيْرُ","never ending","ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ","مَمْنُونٍۢ",75],["41:15:6",478,"بِغَيْرِ","without","فَٱسْتَكْبَرُوا۟ فِى ٱلْأَرْضِ","ٱلْحَقِّ وَقَالُوا۟ مَنْ",75],["42:42:10",487,"بِغَيْرِ","without","وَيَبْغُونَ فِى ٱلْأَرْضِ","ٱلْحَقِّ ۚ أُو۟لَـٰٓئِكَ لَهُمْ",75],["43:18:8",490,"غَيْرُ","(is) not","وَهُوَ فِى ٱلْخِصَامِ","مُبِينٍۢ",75],["46:20:23",504,"بِغَيْرِ","without","تَسْتَكْبِرُونَ فِى ٱلْأَرْضِ","ٱلْحَقِّ وَبِمَا كُنتُمْ",75],["47:15:10",508,"غَيْرِ","not","أَنْهَـٰرٌۭ مِّن مَّآءٍ","ءَاسِنٍۢ وَأَنْهَـٰرٌۭ مِّن",75],["47:15:16",508,"يَتَغَيَّرْ","changes","مِّن لَّبَنٍۢ لَّمْ","طَعْمُهُۥ وَأَنْهَـٰرٌۭ مِّنْ",4677],["47:38:25",510,"غَيْرَكُمْ","other than you","تَتَوَلَّوْا۟ يَسْتَبْدِلْ قَوْمًا","ثُمَّ لَا يَكُونُوٓا۟",75],["48:25:25",514,"بِغَيْرِ","without","فَتُصِيبَكُم مِّنْهُم مَّعَرَّةٌۢ","عِلْمٍۢ ۖ لِّيُدْخِلَ ٱللَّهُ",75],["50:31:4",519,"غَيْرَ","not","وَأُزْلِفَتِ ٱلْجَنَّةُ لِلْمُتَّقِينَ","بَعِيدٍ",75],["51:36:4",522,"غَيْرَ","other than","فَمَا وَجَدْنَا فِيهَا","بَيْتٍۢ مِّنَ ٱلْمُسْلِمِينَ",75],["52:35:4",525,"غَيْرِ","nothing","أَمْ خُلِقُوا۟ مِنْ","شَىْءٍ أَمْ هُمُ",75],["52:43:4",525,"غَيْرُ","other than","أَمْ لَهُمْ إِلَـٰهٌ","ٱللَّهِ ۚ سُبْحَـٰنَ ٱللَّهِ",75],["56:86:4",537,"غَيْرَ","not","فَلَوْلَآ إِن كُنتُمْ","مَدِينِينَ",75],["68:3:4",564,"غَيْرَ","without","وَإِنَّ لَكَ لَأَجْرًا","مَمْنُونٍۢ",75],["70:28:4",569,"غَيْرُ","(is) not","إِنَّ عَذَابَ رَبِّهِمْ","مَأْمُونٍۢ",75],["70:30:9",569,"غَيْرُ","(are) not","مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ","مَلُومِينَ",75],["74:10:3",575,"غَيْرُ","not","عَلَى ٱلْكَـٰفِرِينَ","يَسِيرٍۢ",75],["84:25:8",590,"غَيْرُ","never","ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ","مَمْنُونٍۭ",75],["95:6:8",597,"غَيْرُ","never","ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ","مَمْنُونٍۢ",75],["100:3:1",599,"فَٱلْمُغِيرَٰتِ","And the chargers","","صُبْحًۭا",3802]]