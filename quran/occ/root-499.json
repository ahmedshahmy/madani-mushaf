[["6:97:5",140,"ٱلنُّجُومَ","the stars","ٱلَّذِى جَعَلَ لَكُمُ","لِتَهْتَدُوا۟ بِهَا فِى",694],["7:54:22",157,"وَٱلنُّجُومَ","and the stars","حَثِيثًۭا وَٱلشَّمْسَ وَٱلْقَمَرَ","مُسَخَّرَٰتٍۭ بِأَمْرِهِۦٓ ۗ أَلَا",694],["16:12:7",268,"وَٱلنُّجُومُ","and the stars","وَٱلنَّهَارَ وَٱلشَّمْسَ وَٱلْقَمَرَ ۖ","مُسَخَّرَٰتٌۢ بِأَمْرِهِۦٓ ۗ إِنَّ",694],["16:16:2",269,"وَبِٱلنَّجْمِ","And by the stars","وَعَلَـٰمَـٰتٍۢ ۚ","هُمْ يَهْتَدُونَ",694],["22:18:15",334,"وَٱلنُّجُومُ","and the stars","ٱلْأَرْضِ وَٱلشَّمْسُ وَٱلْقَمَرُ","وَٱلْجِبَالُ وَٱلشَّجَرُ وَٱلدَّوَآبُّ",694],["37:88:4",449,"ٱلنُّجُومِ","the stars","فَنَظَرَ نَظْرَةًۭ فِى","",694],["52:49:5",525,"ٱلنُّجُومِ","the stars","ٱلَّيْلِ فَسَبِّحْهُ وَإِدْبَـٰرَ","",694],["53:1:1",526,"وَٱلنَّجْمِ","By the star","","إِذَا هَوَىٰ",694],["55:6:1",531,"وَٱلنَّجْمُ","And the stars","","وَٱلشَّجَرُ يَسْجُدَانِ",694],["56:75:4",536,"ٱلنُّجُومِ","(of) the stars","۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ","",694],["77:8:2",580,"ٱلنُّجُومُ","the stars","فَإِذَا","طُمِسَتْ",694],["81:2:2",586,"ٱلنُّجُومُ","the stars","وَإِذَا","ٱنكَدَرَتْ",694],["86:3:1",591,"ٱلنَّجْمُ","(It is) the star","","ٱلثَّاقِبُ",694]]