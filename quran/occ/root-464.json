[["2:254:13",42,"بَيْعٌۭ","bargaining","يَأْتِىَ يَوْمٌۭ لَّا","فِيهِ وَلَا خُلَّةٌۭ",1063],["2:275:18",47,"ٱلْبَيْعُ","the trade","بِأَنَّهُمْ قَالُوٓا۟ إِنَّمَا","مِثْلُ ٱلرِّبَوٰا۟ ۗ وَأَحَلَّ",1063],["2:275:23",47,"ٱلْبَيْعَ","[the] trade","ٱلرِّبَوٰا۟ ۗ وَأَحَلَّ ٱللَّهُ","وَحَرَّمَ ٱلرِّبَوٰا۟ ۚ فَمَن",1063],["2:282:110",48,"تَبَايَعْتُمْ ۚ","you make commercial transaction","تَكْتُبُوهَا ۗ وَأَشْهِدُوٓا۟ إِذَا","وَلَا يُضَآرَّ كَاتِبٌۭ",4350],["9:111:30",204,"بِبَيْعِكُمُ","in your transaction","مِنَ ٱللَّهِ ۚ فَٱسْتَبْشِرُوا۟","ٱلَّذِى بَايَعْتُم بِهِۦ ۚ",1063],["9:111:32",204,"بَايَعْتُم","you have contracted","فَٱسْتَبْشِرُوا۟ بِبَيْعِكُمُ ٱلَّذِى","بِهِۦ ۚ وَذَٰلِكَ هُوَ",1166],["14:31:18",259,"بَيْعٌۭ","any trade","يَأْتِىَ يَوْمٌۭ لَّا","فِيهِ وَلَا خِلَـٰلٌ",1063],["22:40:20",337,"وَبِيَعٌۭ","and churches","بِبَعْضٍۢ لَّهُدِّمَتْ صَوَٰمِعُ","وَصَلَوَٰتٌۭ وَمَسَـٰجِدُ يُذْكَرُ",3357],["24:37:6",355,"بَيْعٌ","sale","تُلْهِيهِمْ تِجَـٰرَةٌۭ وَلَا","عَن ذِكْرِ ٱللَّهِ",1063],["48:10:3",512,"يُبَايِعُونَكَ","pledge allegiance to you","إِنَّ ٱلَّذِينَ","إِنَّمَا يُبَايِعُونَ ٱللَّهَ",1166],["48:10:5",512,"يُبَايِعُونَ","they pledge allegiance","ٱلَّذِينَ يُبَايِعُونَكَ إِنَّمَا","ٱللَّهَ يَدُ ٱللَّهِ",1166],["48:18:7",513,"يُبَايِعُونَكَ","they pledged allegiance to you","عَنِ ٱلْمُؤْمِنِينَ إِذْ","تَحْتَ ٱلشَّجَرَةِ فَعَلِمَ",1166],["60:12:6",551,"يُبَايِعْنَكَ","pledging to you","إِذَا جَآءَكَ ٱلْمُؤْمِنَـٰتُ","عَلَىٰٓ أَن لَّا",1166],["60:12:31",551,"فَبَايِعْهُنَّ","then accept their pledge","يَعْصِينَكَ فِى مَعْرُوفٍۢ ۙ","وَٱسْتَغْفِرْ لَهُنَّ ٱللَّهَ ۖ",1166],["62:9:15",554,"ٱلْبَيْعَ ۚ","the business","ذِكْرِ ٱللَّهِ وَذَرُوا۟","ذَٰلِكُمْ خَيْرٌۭ لَّكُمْ",1063]]