[["12:70:13",244,"ٱلْعِيرُ","(in) the caravan","أَذَّنَ مُؤَذِّنٌ أَيَّتُهَا","إِنَّكُمْ لَسَـٰرِقُونَ",1769],["12:82:6",245,"وَٱلْعِيرَ","and the caravan","ٱلَّتِى كُنَّا فِيهَا","ٱلَّتِىٓ أَقْبَلْنَا فِيهَا ۖ",1769],["12:94:3",246,"ٱلْعِيرُ","the caravan","وَلَمَّا فَصَلَتِ","قَالَ أَبُوهُمْ إِنِّى",1769]]