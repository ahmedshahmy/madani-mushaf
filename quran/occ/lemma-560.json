[["2:133:22",20,"وَإِسْحَـٰقَ","and Isaac","ءَابَآئِكَ إِبْرَٰهِـۧمَ وَإِسْمَـٰعِيلَ","إِلَـٰهًۭا وَٰحِدًۭا وَنَحْنُ",560],["2:136:12",21,"وَإِسْحَـٰقَ","and Isaac","إِلَىٰٓ إِبْرَٰهِـۧمَ وَإِسْمَـٰعِيلَ","وَيَعْقُوبَ وَٱلْأَسْبَاطِ وَمَآ",560],["2:140:6",21,"وَإِسْحَـٰقَ","and Isaac","إِنَّ إِبْرَٰهِـۧمَ وَإِسْمَـٰعِيلَ","وَيَعْقُوبَ وَٱلْأَسْبَاطَ كَانُوا۟",560],["3:84:12",61,"وَإِسْحَـٰقَ","and Isaac","عَلَىٰٓ إِبْرَٰهِيمَ وَإِسْمَـٰعِيلَ","وَيَعْقُوبَ وَٱلْأَسْبَاطِ وَمَآ",560],["4:163:15",104,"وَإِسْحَـٰقَ","and Isaac","إِلَىٰٓ إِبْرَٰهِيمَ وَإِسْمَـٰعِيلَ","وَيَعْقُوبَ وَٱلْأَسْبَاطِ وَعِيسَىٰ",560],["6:84:3",138,"إِسْحَـٰقَ","Isaac","وَوَهَبْنَا لَهُۥٓ","وَيَعْقُوبَ ۚ كُلًّا هَدَيْنَا ۚ",560],["11:71:5",229,"بِإِسْحَـٰقَ","of Isaac","قَآئِمَةٌۭ فَضَحِكَتْ فَبَشَّرْنَـٰهَا","وَمِن وَرَآءِ إِسْحَـٰقَ",560],["11:71:8",229,"إِسْحَـٰقَ","Isaac","بِإِسْحَـٰقَ وَمِن وَرَآءِ","يَعْقُوبَ",560],["12:6:21",236,"وَإِسْحَـٰقَ ۚ","and Isaac","مِن قَبْلُ إِبْرَٰهِيمَ","إِنَّ رَبَّكَ عَلِيمٌ",560],["12:38:5",240,"وَإِسْحَـٰقَ","and Isaac","مِلَّةَ ءَابَآءِىٓ إِبْرَٰهِيمَ","وَيَعْقُوبَ ۚ مَا كَانَ",560],["14:39:9",260,"وَإِسْحَـٰقَ ۚ","and Isaac","عَلَى ٱلْكِبَرِ إِسْمَـٰعِيلَ","إِنَّ رَبِّى لَسَمِيعُ",560],["19:49:10",308,"إِسْحَـٰقَ","Isaac","ٱللَّهِ وَهَبْنَا لَهُۥٓ","وَيَعْقُوبَ ۖ وَكُلًّۭا جَعَلْنَا",560],["21:72:3",327,"إِسْحَـٰقَ","Isaac","وَوَهَبْنَا لَهُۥٓ","وَيَعْقُوبَ نَافِلَةًۭ ۖ وَكُلًّۭا",560],["29:27:3",399,"إِسْحَـٰقَ","Isaac","وَوَهَبْنَا لَهُۥٓ","وَيَعْقُوبَ وَجَعَلْنَا فِى",560],["37:112:2",450,"بِإِسْحَـٰقَ","of Isaac","وَبَشَّرْنَـٰهُ","نَبِيًّۭا مِّنَ ٱلصَّـٰلِحِينَ",560],["37:113:4",450,"إِسْحَـٰقَ ۚ","Isaac","وَبَـٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ","وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌۭ",560],["38:45:4",456,"وَإِسْحَـٰقَ","and Isaac","وَٱذْكُرْ عِبَـٰدَنَآ إِبْرَٰهِيمَ","وَيَعْقُوبَ أُو۟لِى ٱلْأَيْدِى",560]]