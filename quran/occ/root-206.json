[["2:61:7",9,"طَعَامٍۢ","food","لَن نَّصْبِرَ عَلَىٰ","وَٰحِدٍۢ فَٱدْعُ لَنَا",439],["2:184:18",28,"طَعَامُ","(of) feeding","ٱلَّذِينَ يُطِيقُونَهُۥ فِدْيَةٌۭ","مِسْكِينٍۢ ۖ فَمَن تَطَوَّعَ",439],["2:249:17",41,"يَطْعَمْهُ","taste it","مِنِّى وَمَن لَّمْ","فَإِنَّهُۥ مِنِّىٓ إِلَّا",1313],["2:259:39",43,"طَعَامِكَ","your food","عَامٍۢ فَٱنظُرْ إِلَىٰ","وَشَرَابِكَ لَمْ يَتَسَنَّهْ ۖ",439],["3:93:2",62,"ٱلطَّعَامِ","[the] food","۞ كُلُّ","كَانَ حِلًّۭا لِّبَنِىٓ",439],["5:5:5",107,"وَطَعَامُ","and (the) food","أُحِلَّ لَكُمُ ٱلطَّيِّبَـٰتُ ۖ","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ",439],["5:5:11",107,"وَطَعَامُكُمْ","and your food","ٱلْكِتَـٰبَ حِلٌّۭ لَّكُمْ","حِلٌّۭ لَّهُمْ ۖ وَٱلْمُحْصَنَـٰتُ",439],["5:75:16",120,"ٱلطَّعَامَ ۗ","[the] food","صِدِّيقَةٌۭ ۖ كَانَا يَأْكُلَانِ","ٱنظُرْ كَيْفَ نُبَيِّنُ",439],["5:89:13",122,"إِطْعَامُ","(is) feeding","عَقَّدتُّمُ ٱلْأَيْمَـٰنَ ۖ فَكَفَّـٰرَتُهُۥٓ","عَشَرَةِ مَسَـٰكِينَ مِنْ",1715],["5:89:19",122,"تُطْعِمُونَ","you feed","مِنْ أَوْسَطِ مَا","أَهْلِيكُمْ أَوْ كِسْوَتُهُمْ",677],["5:93:9",123,"طَعِمُوٓا۟","they ate","ٱلصَّـٰلِحَـٰتِ جُنَاحٌۭ فِيمَا","إِذَا مَا ٱتَّقَوا۟",1313],["5:95:29",123,"طَعَامُ","feeding","ٱلْكَعْبَةِ أَوْ كَفَّـٰرَةٌۭ","مَسَـٰكِينَ أَوْ عَدْلُ",439],["5:96:5",124,"وَطَعَامُهُۥ","and its food","لَكُمْ صَيْدُ ٱلْبَحْرِ","مَتَـٰعًۭا لَّكُمْ وَلِلسَّيَّارَةِ ۖ",439],["6:14:10",129,"يُطْعِمُ","Who feeds","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَهُوَ","وَلَا يُطْعَمُ ۗ قُلْ",677],["6:14:12",129,"يُطْعَمُ ۗ","He is fed","وَهُوَ يُطْعِمُ وَلَا","قُلْ إِنِّىٓ أُمِرْتُ",677],["6:138:7",146,"يَطْعَمُهَآ","can eat them","وَحَرْثٌ حِجْرٌۭ لَّا","إِلَّا مَن نَّشَآءُ",1313],["6:145:10",147,"طَاعِمٍۢ","an eater","إِلَىَّ مُحَرَّمًا عَلَىٰ","يَطْعَمُهُۥٓ إِلَّآ أَن",3285],["6:145:11",147,"يَطْعَمُهُۥٓ","who eats it","مُحَرَّمًا عَلَىٰ طَاعِمٍۢ","إِلَّآ أَن يَكُونَ",1313],["12:37:4",239,"طَعَامٌۭ","food","قَالَ لَا يَأْتِيكُمَا","تُرْزَقَانِهِۦٓ إِلَّا نَبَّأْتُكُمَا",439],["18:19:30",295,"طَعَامًۭا","food","فَلْيَنظُرْ أَيُّهَآ أَزْكَىٰ","فَلْيَأْتِكُم بِرِزْقٍۢ مِّنْهُ",439],["18:77:7",302,"ٱسْتَطْعَمَآ","they asked for food","أَتَيَآ أَهْلَ قَرْيَةٍ","أَهْلَهَا فَأَبَوْا۟ أَن",4829],["21:8:6",322,"ٱلطَّعَامَ","the food","جَسَدًۭا لَّا يَأْكُلُونَ","وَمَا كَانُوا۟ خَـٰلِدِينَ",439],["22:28:18",335,"وَأَطْعِمُوا۟","and feed","ٱلْأَنْعَـٰمِ ۖ فَكُلُوا۟ مِنْهَا","ٱلْبَآئِسَ ٱلْفَقِيرَ",677],["22:36:20",336,"وَأَطْعِمُوا۟","and feed","جُنُوبُهَا فَكُلُوا۟ مِنْهَا","ٱلْقَانِعَ وَٱلْمُعْتَرَّ ۚ كَذَٰلِكَ",677],["25:7:6",360,"ٱلطَّعَامَ","[the] food","هَـٰذَا ٱلرَّسُولِ يَأْكُلُ","وَيَمْشِى فِى ٱلْأَسْوَاقِ ۙ",439],["25:20:9",361,"ٱلطَّعَامَ","food","إِلَّآ إِنَّهُمْ لَيَأْكُلُونَ","وَيَمْشُونَ فِى ٱلْأَسْوَاقِ ۗ",439],["26:79:3",370,"يُطْعِمُنِى","gives me food","وَٱلَّذِى هُوَ","وَيَسْقِينِ",677],["33:53:13",425,"طَعَامٍ","a meal","يُؤْذَنَ لَكُمْ إِلَىٰ","غَيْرَ نَـٰظِرِينَ إِنَىٰهُ",439],["33:53:22",425,"طَعِمْتُمْ","you have eaten","دُعِيتُمْ فَٱدْخُلُوا۟ فَإِذَا","فَٱنتَشِرُوا۟ وَلَا مُسْتَـْٔنِسِينَ",1313],["36:47:13",443,"أَنُطْعِمُ","Should we feed","كَفَرُوا۟ لِلَّذِينَ ءَامَنُوٓا۟","مَن لَّوْ يَشَآءُ",677],["36:47:18",443,"أَطْعَمَهُۥٓ","He would have fed him","لَّوْ يَشَآءُ ٱللَّهُ","إِنْ أَنتُمْ إِلَّا",677],["44:44:1",498,"طَعَامُ","(Will be) food","","ٱلْأَثِيمِ",439],["47:15:17",508,"طَعْمُهُۥ","its taste","لَّبَنٍۢ لَّمْ يَتَغَيَّرْ","وَأَنْهَـٰرٌۭ مِّنْ خَمْرٍۢ",3288],["51:57:9",523,"يُطْعِمُونِ","they (should) feed Me","وَمَآ أُرِيدُ أَن","",677],["58:4:14",542,"فَإِطْعَامُ","then (the) feeding","فَمَن لَّمْ يَسْتَطِعْ","سِتِّينَ مِسْكِينًۭا ۚ ذَٰلِكَ",1715],["69:34:4",567,"طَعَامِ","(the) feeding","وَلَا يَحُضُّ عَلَىٰ","ٱلْمِسْكِينِ",439],["69:36:2",568,"طَعَامٌ","any food","وَلَا","إِلَّا مِنْ غِسْلِينٍۢ",439],["73:13:1",574,"وَطَعَامًۭا","And food","","ذَا غُصَّةٍۢ وَعَذَابًا",439],["74:44:3",576,"نُطْعِمُ","feed","وَلَمْ نَكُ","ٱلْمِسْكِينَ",677],["76:8:1",579,"وَيُطْعِمُونَ","And they feed","","ٱلطَّعَامَ عَلَىٰ حُبِّهِۦ",677],["76:8:2",579,"ٱلطَّعَامَ","the food","وَيُطْعِمُونَ","عَلَىٰ حُبِّهِۦ مِسْكِينًۭا",439],["76:9:2",579,"نُطْعِمُكُمْ","we feed you","إِنَّمَا","لِوَجْهِ ٱللَّهِ لَا",677],["80:24:4",585,"طَعَامِهِۦٓ","his food","فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ","",439],["88:6:3",592,"طَعَامٌ","food","لَّيْسَ لَهُمْ","إِلَّا مِن ضَرِيعٍۢ",439],["89:18:4",593,"طَعَامِ","feed","وَلَا تَحَـٰٓضُّونَ عَلَىٰ","ٱلْمِسْكِينِ",439],["90:14:2",594,"إِطْعَـٰمٌۭ","feeding","أَوْ","فِى يَوْمٍۢ ذِى",1715],["106:4:2",602,"أَطْعَمَهُم","feeds them","ٱلَّذِىٓ","مِّن جُوعٍۢ وَءَامَنَهُم",677],["107:3:4",602,"طَعَامِ","feed","وَلَا يَحُضُّ عَلَىٰ","ٱلْمِسْكِينِ",439]]