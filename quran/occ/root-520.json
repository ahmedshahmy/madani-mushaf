[["3:180:4",73,"يَبْخَلُونَ","withhold","وَلَا يَحْسَبَنَّ ٱلَّذِينَ","بِمَآ ءَاتَىٰهُمُ ٱللَّهُ",831],["3:180:19",73,"بَخِلُوا۟","they withheld","لَّهُمْ ۖ سَيُطَوَّقُونَ مَا","بِهِۦ يَوْمَ ٱلْقِيَـٰمَةِ ۗ",831],["4:37:2",84,"يَبْخَلُونَ","are stingy","ٱلَّذِينَ","وَيَأْمُرُونَ ٱلنَّاسَ بِٱلْبُخْلِ",831],["4:37:5",84,"بِٱلْبُخْلِ","[of] stinginess","يَبْخَلُونَ وَيَأْمُرُونَ ٱلنَّاسَ","وَيَكْتُمُونَ مَآ ءَاتَىٰهُمُ",2348],["9:76:5",199,"بَخِلُوا۟","they became stingy","ءَاتَىٰهُم مِّن فَضْلِهِۦ","بِهِۦ وَتَوَلَّوا۟ وَّهُم",831],["47:37:4",510,"تَبْخَلُوا۟","you will withhold","إِن يَسْـَٔلْكُمُوهَا فَيُحْفِكُمْ","وَيُخْرِجْ أَضْغَـٰنَكُمْ",831],["47:38:10",510,"يَبْخَلُ ۖ","withhold","ٱللَّهِ فَمِنكُم مَّن","وَمَن يَبْخَلْ فَإِنَّمَا",831],["47:38:12",510,"يَبْخَلْ","withholds","مَّن يَبْخَلُ ۖ وَمَن","فَإِنَّمَا يَبْخَلُ عَن",831],["47:38:14",510,"يَبْخَلُ","he withholds","وَمَن يَبْخَلْ فَإِنَّمَا","عَن نَّفْسِهِۦ ۚ وَٱللَّهُ",831],["57:24:2",540,"يَبْخَلُونَ","are stingy","ٱلَّذِينَ","وَيَأْمُرُونَ ٱلنَّاسَ بِٱلْبُخْلِ ۗ",831],["57:24:5",540,"بِٱلْبُخْلِ ۗ","stinginess","يَبْخَلُونَ وَيَأْمُرُونَ ٱلنَّاسَ","وَمَن يَتَوَلَّ فَإِنَّ",2348],["92:8:3",595,"بَخِلَ","withholds","وَأَمَّا مَنۢ","وَٱسْتَغْنَىٰ",831]]