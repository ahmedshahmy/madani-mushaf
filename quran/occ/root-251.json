[["2:36:16",6,"مُسْتَقَرٌّۭ","(is) a dwelling place","وَلَكُمْ فِى ٱلْأَرْضِ","وَمَتَـٰعٌ إِلَىٰ حِينٍۢ",847],["2:84:13",13,"أَقْرَرْتُمْ","you ratified","مِّن دِيَـٰرِكُمْ ثُمَّ","وَأَنتُمْ تَشْهَدُونَ",1478],["3:81:21",60,"ءَأَقْرَرْتُمْ","Do you affirm","بِهِۦ وَلَتَنصُرُنَّهُۥ ۚ قَالَ","وَأَخَذْتُمْ عَلَىٰ ذَٰلِكُمْ",1478],["3:81:27",60,"أَقْرَرْنَا ۚ","We affirm","ذَٰلِكُمْ إِصْرِى ۖ قَالُوٓا۟","قَالَ فَٱشْهَدُوا۟ وَأَنَا۠",1478],["6:67:3",135,"مُّسْتَقَرٌّۭ ۚ","(is) a fixed time","لِّكُلِّ نَبَإٍۢ","وَسَوْفَ تَعْلَمُونَ",847],["6:98:7",140,"فَمُسْتَقَرٌّۭ","so (there is) a place of dwelling","مِّن نَّفْسٍۢ وَٰحِدَةٍۢ","وَمُسْتَوْدَعٌۭ ۗ قَدْ فَصَّلْنَا",847],["7:24:9",153,"مُسْتَقَرٌّۭ","(is) a dwelling place","وَلَكُمْ فِى ٱلْأَرْضِ","وَمَتَـٰعٌ إِلَىٰ حِينٍۢ",847],["7:143:20",167,"ٱسْتَقَرَّ","it remains","إِلَى ٱلْجَبَلِ فَإِنِ","مَكَانَهُۥ فَسَوْفَ تَرَىٰنِى ۚ",4833],["11:6:11",222,"مُسْتَقَرَّهَا","its dwelling place","ٱللَّهِ رِزْقُهَا وَيَعْلَمُ","وَمُسْتَوْدَعَهَا ۚ كُلٌّۭ فِى",847],["14:26:13",259,"قَرَارٍۢ","stability","مَا لَهَا مِن","",917],["14:29:4",259,"ٱلْقَرَارُ","place to settle","جَهَنَّمَ يَصْلَوْنَهَا ۖ وَبِئْسَ","",917],["19:26:3",307,"وَقَرِّى","and cool","فَكُلِى وَٱشْرَبِى","عَيْنًۭا ۖ فَإِمَّا تَرَيِنَّ",1403],["20:40:14",314,"تَقَرَّ","may be cooled","إِلَىٰٓ أُمِّكَ كَىْ","عَيْنُهَا وَلَا تَحْزَنَ ۚ",1403],["22:5:27",332,"وَنُقِرُّ","And We cause to remain","مُخَلَّقَةٍۢ لِّنُبَيِّنَ لَكُمْ ۚ","فِى ٱلْأَرْحَامِ مَا",1478],["23:13:5",342,"قَرَارٍۢ","a resting place","جَعَلْنَـٰهُ نُطْفَةًۭ فِى","مَّكِينٍۢ",917],["23:50:10",345,"قَرَارٍۢ","of tranquility","إِلَىٰ رَبْوَةٍۢ ذَاتِ","وَمَعِينٍۢ",917],["25:24:5",362,"مُّسْتَقَرًّۭا","abode","ٱلْجَنَّةِ يَوْمَئِذٍ خَيْرٌۭ","وَأَحْسَنُ مَقِيلًۭا",847],["25:66:3",365,"مُسْتَقَرًّۭا","abode","إِنَّهَا سَآءَتْ","وَمُقَامًۭا",847],["25:74:9",366,"قُرَّةَ","comfort","مِنْ أَزْوَٰجِنَا وَذُرِّيَّـٰتِنَا","أَعْيُنٍۢ وَٱجْعَلْنَا لِلْمُتَّقِينَ",1968],["25:76:4",366,"مُسْتَقَرًّۭا","(is) the settlement","خَـٰلِدِينَ فِيهَا ۚ حَسُنَتْ","وَمُقَامًۭا",847],["27:40:17",380,"مُسْتَقِرًّا","placed","طَرْفُكَ ۚ فَلَمَّا رَءَاهُ","عِندَهُۥ قَالَ هَـٰذَا",1938],["27:44:17",380,"قَوَارِيرَ ۗ","glass","صَرْحٌۭ مُّمَرَّدٌۭ مِّن","قَالَتْ رَبِّ إِنِّى",1960],["27:61:4",382,"قَرَارًۭا","a firm abode","أَمَّن جَعَلَ ٱلْأَرْضَ","وَجَعَلَ خِلَـٰلَهَآ أَنْهَـٰرًۭا",917],["28:9:4",386,"قُرَّتُ","A comfort","وَقَالَتِ ٱمْرَأَتُ فِرْعَوْنَ","عَيْنٍۢ لِّى وَلَكَ ۖ",1968],["28:13:5",386,"تَقَرَّ","might be comforted","إِلَىٰٓ أُمِّهِۦ كَىْ","عَيْنُهَا وَلَا تَحْزَنَ",1403],["32:17:8",416,"قُرَّةِ","(the) comfort","أُخْفِىَ لَهُم مِّن","أَعْيُنٍۢ جَزَآءًۢ بِمَا",1968],["33:33:1",422,"وَقَرْنَ","And stay","","فِى بُيُوتِكُنَّ وَلَا",1403],["33:51:19",425,"تَقَرَّ","may be cooled","ذَٰلِكَ أَدْنَىٰٓ أَن","أَعْيُنُهُنَّ وَلَا يَحْزَنَّ",1403],["36:38:3",442,"لِمُسْتَقَرٍّۢ","to a term appointed","وَٱلشَّمْسُ تَجْرِى","لَّهَا ۚ ذَٰلِكَ تَقْدِيرُ",847],["38:60:11",456,"ٱلْقَرَارُ","the settlement","قَدَّمْتُمُوهُ لَنَا ۖ فَبِئْسَ","",917],["40:39:11",471,"ٱلْقَرَارِ","(of) settlement","ٱلْـَٔاخِرَةَ هِىَ دَارُ","",917],["40:64:6",474,"قَرَارًۭا","a place of settlement","جَعَلَ لَكُمُ ٱلْأَرْضَ","وَٱلسَّمَآءَ بِنَآءًۭ وَصَوَّرَكُمْ",917],["54:3:6",528,"مُّسْتَقِرٌّۭ","(will be a) settlement","أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍۢ","",1938],["54:38:5",530,"مُّسْتَقِرٌّۭ","abiding","صَبَّحَهُم بُكْرَةً عَذَابٌۭ","",1938],["75:12:4",577,"ٱلْمُسْتَقَرُّ","(is) the place of rest","إِلَىٰ رَبِّكَ يَوْمَئِذٍ","",847],["76:15:8",579,"قَوَارِيرَا۠","(of) crystal","فِضَّةٍۢ وَأَكْوَابٍۢ كَانَتْ","",1960],["76:16:1",579,"قَوَارِيرَا۟","Crystal-clear","","مِن فِضَّةٍۢ قَدَّرُوهَا",1960],["77:21:3",581,"قَرَارٍۢ","an abode","فَجَعَلْنَـٰهُ فِى","مَّكِينٍ",917]]