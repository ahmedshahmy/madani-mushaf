[["2:249:53",41,"غَلَبَتْ","overcame","مِّن فِئَةٍۢ قَلِيلَةٍ","فِئَةًۭ كَثِيرَةًۢ بِإِذْنِ",628],["3:12:4",51,"سَتُغْلَبُونَ","You will be overcome","قُل لِّلَّذِينَ كَفَرُوا۟","وَتُحْشَرُونَ إِلَىٰ جَهَنَّمَ ۚ",628],["3:160:5",71,"غَالِبَ","(can) overcome","يَنصُرْكُمُ ٱللَّهُ فَلَا","لَكُمْ ۖ وَإِن يَخْذُلْكُمْ",686],["4:74:17",89,"يَغْلِبْ","achieves victory","ٱللَّهِ فَيُقْتَلْ أَوْ","فَسَوْفَ نُؤْتِيهِ أَجْرًا",628],["5:23:15",111,"غَـٰلِبُونَ ۚ","victorious","فَإِذَا دَخَلْتُمُوهُ فَإِنَّكُمْ","وَعَلَى ٱللَّهِ فَتَوَكَّلُوٓا۟",686],["5:56:11",117,"ٱلْغَـٰلِبُونَ","(are) the victorious","حِزْبَ ٱللَّهِ هُمُ","",686],["7:113:11",164,"ٱلْغَـٰلِبِينَ","the victors","إِن كُنَّا نَحْنُ","",686],["7:119:1",164,"فَغُلِبُوا۟","So they were defeated","","هُنَالِكَ وَٱنقَلَبُوا۟ صَـٰغِرِينَ",628],["8:36:16",181,"يُغْلَبُونَ ۗ","they will be overcome","عَلَيْهِمْ حَسْرَةًۭ ثُمَّ","وَٱلَّذِينَ كَفَرُوٓا۟ إِلَىٰ",628],["8:48:8",183,"غَالِبَ","(can) overcome","أَعْمَـٰلَهُمْ وَقَالَ لَا","لَكُمُ ٱلْيَوْمَ مِنَ",686],["8:65:12",185,"يَغْلِبُوا۟","they will overcome","مِّنكُمْ عِشْرُونَ صَـٰبِرُونَ","مِا۟ئَتَيْنِ ۚ وَإِن يَكُن",628],["8:65:18",185,"يَغْلِبُوٓا۟","they will overcome","يَكُن مِّنكُم مِّا۟ئَةٌۭ","أَلْفًۭا مِّنَ ٱلَّذِينَ",628],["8:66:14",185,"يَغْلِبُوا۟","they will overcome","مِّنكُم مِّا۟ئَةٌۭ صَابِرَةٌۭ","مِا۟ئَتَيْنِ ۚ وَإِن يَكُن",628],["8:66:20",185,"يَغْلِبُوٓا۟","they will overcome","يَكُن مِّنكُمْ أَلْفٌۭ","أَلْفَيْنِ بِإِذْنِ ٱللَّهِ ۗ",628],["12:21:25",237,"غَالِبٌ","(is) Predominant","تَأْوِيلِ ٱلْأَحَادِيثِ ۚ وَٱللَّهُ","عَلَىٰٓ أَمْرِهِۦ وَلَـٰكِنَّ",686],["18:21:27",296,"غَلَبُوا۟","prevailed","بِهِمْ ۚ قَالَ ٱلَّذِينَ","عَلَىٰٓ أَمْرِهِمْ لَنَتَّخِذَنَّ",628],["21:44:18",325,"ٱلْغَـٰلِبُونَ","(who will be) overcoming","مِنْ أَطْرَافِهَآ ۚ أَفَهُمُ","",686],["23:106:3",349,"غَلَبَتْ","Overcame","قَالُوا۟ رَبَّنَا","عَلَيْنَا شِقْوَتُنَا وَكُنَّا",628],["26:40:7",369,"ٱلْغَـٰلِبِينَ","the victorious","إِن كَانُوا۟ هُمُ","",686],["26:41:12",369,"ٱلْغَـٰلِبِينَ","the victorious","إِن كُنَّا نَحْنُ","",686],["26:44:9",369,"ٱلْغَـٰلِبُونَ","(are) the victorious","فِرْعَوْنَ إِنَّا لَنَحْنُ","",686],["28:35:15",389,"ٱلْغَـٰلِبُونَ","(will) be the dominant","أَنتُمَا وَمَنِ ٱتَّبَعَكُمَا","",686],["30:2:1",404,"غُلِبَتِ","Have been defeated","","ٱلرُّومُ",628],["30:3:7",404,"غَلَبِهِمْ","their defeat","وَهُم مِّنۢ بَعْدِ","سَيَغْلِبُونَ",3458],["30:3:8",404,"سَيَغْلِبُونَ","will overcome","مِّنۢ بَعْدِ غَلَبِهِمْ","",628],["37:116:4",450,"ٱلْغَـٰلِبِينَ","the victors","وَنَصَرْنَـٰهُمْ فَكَانُوا۟ هُمُ","",686],["37:173:4",452,"ٱلْغَـٰلِبُونَ","(will be) those who overcome","وَإِنَّ جُندَنَا لَهُمُ","",686],["41:26:11",479,"تَغْلِبُونَ","overcome","وَٱلْغَوْا۟ فِيهِ لَعَلَّكُمْ","",628],["54:10:4",529,"مَغْلُوبٌۭ","one overpowered","فَدَعَا رَبَّهُۥٓ أَنِّى","فَٱنتَصِرْ",3664],["58:21:3",544,"لَأَغْلِبَنَّ","Surely, I will overcome","كَتَبَ ٱللَّهُ","أَنَا۠ وَرُسُلِىٓ ۚ إِنَّ",628],["80:30:2",585,"غُلْبًۭا","(of) thick foliage","وَحَدَآئِقَ","",3477]]