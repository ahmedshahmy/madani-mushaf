ٰفِرُونَ",59],["10:18:13",210,"عِندَ","with","وَيَقُولُونَ هَـٰٓؤُلَآءِ شُفَعَـٰٓؤُنَا","ٱللَّهِ ۚ قُلْ أَتُنَبِّـُٔونَ",59],["10:68:16",216,"عِندَكُم","you have","فِى ٱلْأَرْضِ ۚ إِنْ","مِّن سُلْطَـٰنٍۭ بِهَـٰذَآ ۚ",59],["10:76:5",217,"عِندِنَا","from Us","جَآءَهُمُ ٱلْحَقُّ مِنْ","قَالُوٓا۟ إِنَّ هَـٰذَا",59],["11:28:13",224,"عِندِهِۦ","Himself","وَءَاتَىٰنِى رَحْمَةًۭ مِّنْ","فَعُمِّيَتْ عَلَيْكُمْ أَنُلْزِمُكُمُوهَا",59],["11:31:4",225,"عِندِى","(that) with me","وَلَآ أَقُولُ لَكُمْ","خَزَآئِنُ ٱللَّهِ وَلَآ",59],["11:59:12",228,"عَنِيدٍۢ","obstinate","أَمْرَ كُلِّ جَبَّارٍ","",1500],["11:83:2",231,"عِندَ","from","مُّسَوَّمَةً","رَبِّكَ ۖ وَمَا هِىَ",59],["12:17:8",237,"عِندَ","with","نَسْتَبِقُ وَتَرَكْنَا يُوسُفَ","مَتَـٰعِنَا فَأَكَلَهُ ٱلذِّئْبُ ۖ",59],["12:42:8",240,"عِندَ","to","نَاجٍۢ مِّنْهُمَا ٱذْكُرْنِى","رَبِّكَ فَأَنسَىٰهُ ٱلشَّيْطَـٰنُ",59],["12:60:8",242,"عِندِى","from me","فَلَا كَيْلَ لَكُمْ","وَلَا تَقْرَبُونِ",59],["12:79:10",245,"عِندَهُۥٓ","with him","مَن وَجَدْنَا مَتَـٰعَنَا","إِنَّآ إِذًۭا لَّظَـٰلِمُونَ",59],["13:8:14",250,"عِندَهُۥ","with Him","تَزْدَادُ ۖ وَكُلُّ شَىْءٍ","بِمِقْدَارٍ",59],["13:39:6",254,"وَعِندَهُۥٓ","and with Him","مَا يَشَآءُ وَيُثْبِتُ ۖ","أُمُّ ٱلْكِتَـٰبِ",59],["13:43:13",255,"عِندَهُۥ","[he] has","بَيْنِى وَبَيْنَكُمْ وَمَنْ","عِلْمُ ٱلْكِتَـٰبِ",59],["14:15:5",257,"عَنِيدٍۢ","obstinate","وَخَابَ كُلُّ جَبَّارٍ","",1500],["14:37:10",260,"عِندَ","near","غَيْرِ ذِى زَرْعٍ","بَيْتِكَ ٱلْمُحَرَّمِ رَبَّنَا",59],["14:46:4",261,"وَعِندَ","but with","وَقَدْ مَكَرُوا۟ مَكْرَهُمْ","ٱللَّهِ مَكْرُهُمْ وَإِن",59],["15:21:5",263,"عِندَنَا","with Us","مِّن شَىْءٍ إِلَّا","خَزَآئِنُهُۥ وَمَا نُنَزِّلُهُۥٓ",59],["16:95:8",278,"عِندَ","(is) with","ثَمَنًۭا قَلِيلًا ۚ إِنَّمَا","ٱللَّهِ هُوَ خَيْرٌۭ",59],["16:96:2",278,"عِندَكُمْ","(is) with you","مَا","يَنفَدُ ۖ وَمَا عِندَ",59],["16:96:5",278,"عِندَ","(is) with","عِندَكُمْ يَنفَدُ ۖ وَمَا","ٱللَّهِ بَاقٍۢ ۗ وَلَنَجْزِيَنَّ",59],["17:23:11",284,"عِندَكَ","with you","إِحْسَـٰنًا ۚ إِمَّا يَبْلُغَنَّ","ٱلْكِبَرَ أَحَدُهُمَآ أَوْ",59],["17:38:5",285,"عِندَ","near","ذَٰلِكَ كَانَ سَيِّئُهُۥ","رَبِّكَ مَكْرُوهًۭا",59],["18:46:9",299,"عِندَ","near","وَٱلْبَـٰقِيَـٰتُ ٱلصَّـٰلِحَـٰتُ خَيْرٌ","رَبِّكَ ثَوَابًۭا وَخَيْرٌ",59],["18:65:8",301,"عِندِنَا","Us","ءَاتَيْنَـٰهُ رَحْمَةًۭ مِّنْ","وَعَلَّمْنَـٰهُ مِن لَّدُنَّا",59],["18:86:12",303,"عِندَهَا","near it","عَيْنٍ حَمِئَةٍۢ وَوَجَدَ","قَوْمًۭا ۗ قُلْنَا يَـٰذَا",59],["19:55:7",309,"عِندَ","near","بِٱلصَّلَوٰةِ وَٱلزَّكَوٰةِ وَكَانَ","رَبِّهِۦ مَرْضِيًّۭا",59],["19:76:9",310,"عِندَ","near","وَٱلْبَـٰقِيَـٰتُ ٱلصَّـٰلِحَـٰتُ خَيْرٌ","رَبِّكَ ثَوَابًۭا وَخَيْرٌۭ",59],["19:78:5",311,"عِندَ","from","ٱلْغَيْبَ أَمِ ٱتَّخَذَ","ٱلرَّحْمَـٰنِ عَهْدًۭا",59],["19:87:7",311,"عِندَ","from","إِلَّا مَنِ ٱتَّخَذَ","ٱلرَّحْمَـٰنِ عَهْدًۭا",59],["20:52:3",315,"عِندَ","(is) with","قَالَ عِلْمُهَا","رَبِّى فِى كِتَـٰبٍۢ ۖ",59],["21:19:7",323,"عِندَهُۥ","(are) near Him","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَمَنْ","لَا يَسْتَكْبِرُونَ عَنْ",59],["21:84:14",329,"عِندِنَا","from Ourselves","مَّعَهُمْ رَحْمَةًۭ مِّنْ","وَذِكْرَىٰ لِلْعَـٰبِدِينَ",59],["22:30:9",335,"عِندَ","near","فَهُوَ خَيْرٌۭ لَّهُۥ","رَبِّهِۦ ۗ وَأُحِلَّتْ لَكُمُ",59],["22:47:9",338,"عِندَ","with","وَعْدَهُۥ ۚ وَإِنَّ يَوْمًا","رَبِّكَ كَأَلْفِ سَنَةٍۢ",59],["23:117:13",349,"عِندَ","(is) with","بِهِۦ فَإِنَّمَا حِسَابُهُۥ","رَبِّهِۦٓ ۚ إِنَّهُۥ لَا",59],["24:13:11",351,"عِندَ","near Allah","يَأْتُوا۟ بِٱلشُّهَدَآءِ فَأُو۟لَـٰٓئِكَ","ٱللَّهِ هُمُ ٱلْكَـٰذِبُونَ",59],["24:15:14",351,"عِندَ","(was) near Allah","وَتَحْسَبُونَهُۥ هَيِّنًۭا وَهُوَ","ٱللَّهِ عَظِيمٌۭ",59],["24:39:17",355,"عِندَهُۥ","before him","شَيْـًۭٔا وَوَجَدَ ٱللَّهَ","فَوَفَّىٰهُ حِسَابَهُۥ ۗ وَٱللَّهُ",59],["24:61:66",358,"عِندِ","from","أَنفُسِكُمْ تَحِيَّةًۭ مِّنْ","ٱللَّهِ مُبَـٰرَكَةًۭ طَيِّبَةًۭ ۚ",59],["27:40:3",380,"عِندَهُۥ","with him","قَالَ ٱلَّذِى","عِلْمٌۭ مِّنَ ٱلْكِتَـٰبِ",59],["27:40:18",380,"عِندَهُۥ","before him","فَلَمَّا رَءَاهُ مُسْتَقِرًّا","قَالَ هَـٰذَا مِن",59],["27:47:8",381,"عِندَ","(is) with","مَّعَكَ ۚ قَالَ طَـٰٓئِرُكُمْ","ٱللَّهِ ۖ بَلْ أَنتُمْ",59],["28:27:18",388,"عِندِكَ ۖ","you","أَتْمَمْتَ عَشْرًۭا فَمِنْ","وَمَآ أُرِيدُ أَنْ",59],["28:37:9",390,"عِندِهِۦ","from Him","جَآءَ بِٱلْهُدَىٰ مِنْ","وَمَن تَكُونُ لَهُۥ",59],["28:48:5",391,"عِندِنَا","from Us","جَآءَهُمُ ٱلْحَقُّ مِنْ","قَالُوا۟ لَوْلَآ أُوتِىَ",59],["28:49:5",391,"عِندِ","from Allah","فَأْتُوا۟ بِكِتَـٰبٍۢ مِّنْ","ٱللَّهِ هُوَ أَهْدَىٰ",59],["28:60:10",393,"عِندَ","(is) with","ٱلدُّنْيَا وَزِينَتُهَا ۚ وَمَا","ٱللَّهِ خَيْرٌۭ وَأَبْقَىٰٓ ۚ",59],["28:78:6",395,"عِندِىٓ ۚ","I have","أُوتِيتُهُۥ عَلَىٰ عِلْمٍ","أَوَلَمْ يَعْلَمْ أَنَّ",59],["29:17:20",398,"عِندَ","from","لَكُمْ رِزْقًۭا فَٱبْتَغُوا۟","ٱللَّهِ ٱلرِّزْقَ وَٱعْبُدُوهُ",59],["29:50:11",402,"عِندَ","(are) with","قُلْ إِنَّمَا ٱلْـَٔايَـٰتُ","ٱللَّهِ وَإِنَّمَآ أَنَا۠",59],["30:39:11",408,"عِندَ","with","ٱلنَّاسِ فَلَا يَرْبُوا۟","ٱللَّهِ ۖ وَمَآ ءَاتَيْتُم",59],["31:34:3",414,"عِندَهُۥ","with Him","إِنَّ ٱللَّهَ","عِلْمُ ٱلسَّاعَةِ وَيُنَزِّلُ",59],["32:12:7",416,"عِندَ","before","ٱلْمُجْرِمُونَ نَاكِسُوا۟ رُءُوسِهِمْ","رَبِّهِمْ رَبَّنَآ أَبْصَرْنَا",59],["33:5:5",418,"عِندَ","near","لِـَٔابَآئِهِمْ هُوَ أَقْسَطُ","ٱللَّهِ ۚ فَإِن لَّمْ",59],["33:53:67",425,"عِندَ","near","إِنَّ ذَٰلِكُمْ كَانَ","ٱللَّهِ عَظِيمًا",59],["33:63:8",427,"عِندَ","(is) with","قُلْ إِنَّمَا عِلْمُهَا","ٱللَّهِ ۚ وَمَا يُدْرِيكَ",59],["33:69:14",427,"عِندَ","near","مِمَّا قَالُوا۟ ۚ وَكَانَ","ٱللَّهِ وَجِيهًۭا",59],["34:23:4",431,"عِندَهُۥٓ","with Him","وَلَا تَنفَعُ ٱلشَّفَـٰعَةُ","إِلَّا لِمَنْ أَذِنَ",59],["34:31:17",431,"عِندَ","before","إِذِ ٱلظَّـٰلِمُونَ مَوْقُوفُونَ","رَبِّهِمْ يَرْجِعُ بَعْضُهُمْ",59],["34:37:7",432,"عِندَنَا","to Us","أَوْلَـٰدُكُم بِٱلَّتِى تُقَرِّبُكُمْ","زُلْفَىٰٓ إِلَّا مَنْ",59],["35:39:15",439,"عِندَ","near","يَزِيدُ ٱلْكَـٰفِرِينَ كُفْرُهُمْ","رَبِّهِمْ إِلَّا مَقْتًۭا ۖ",59],["37:48:1",447,"وَعِندَهُمْ","And with them","","قَـٰصِرَٰتُ ٱلطَّرْفِ عِينٌۭ",59],["37:168:3",452,"عِندَنَا","we had","لَوْ أَنَّ","ذِكْرًۭا مِّنَ ٱلْأَوَّلِينَ",59],["38:9:2",453,"عِندَهُمْ","have they","أَمْ","خَزَآئِنُ رَحْمَةِ رَبِّكَ",59],["38:25:6",454,"عِندَنَا","with Us","ذَٰلِكَ ۖ وَإِنَّ لَهُۥ","لَزُلْفَىٰ وَحُسْنَ مَـَٔابٍۢ",59],["38:40:3",455,"عِندَنَا","with Us","وَإِنَّ لَهُۥ","لَزُلْفَىٰ وَحُسْنَ مَـَٔابٍۢ",59],["38:47:2",456,"عِندَنَا","to Us","وَإِنَّهُمْ","لَمِنَ ٱلْمُصْطَفَيْنَ ٱلْأَخْيَارِ",59],["38:52:1",456,"۞ وَعِندَهُمْ","And with them","","قَـٰصِرَٰتُ ٱلطَّرْفِ أَتْرَابٌ",59],["39:31:5",461,"عِندَ","before","إِنَّكُمْ يَوْمَ ٱلْقِيَـٰمَةِ","رَبِّكُمْ تَخْتَصِمُونَ",59],["39:34:4",462,"عِندَ","with","لَهُم مَّا يَشَآءُونَ","رَبِّهِمْ ۚ ذَٰلِكَ جَزَآءُ",59],["40:25:5",469,"عِندِنَا","Us","جَآءَهُم بِٱلْحَقِّ مِنْ","قَالُوا۟ ٱقْتُلُوٓا۟ أَبْنَآءَ",59],["40:35:11",471,"عِندَ","near Allah","أَتَىٰهُمْ ۖ كَبُرَ مَقْتًا","ٱللَّهِ وَعِندَ ٱلَّذِينَ",59],["40:35:13",471,"وَعِندَ","and near","مَقْتًا عِندَ ٱللَّهِ","ٱلَّذِينَ ءَامَنُوا۟ ۚ كَذَٰلِكَ",59],["40:83:7",476,"عِندَهُم","they had","بِٱلْبَيِّنَـٰتِ فَرِحُوا۟ بِمَا","مِّنَ ٱلْعِلْمِ وَحَاقَ",59],["41:38:4",480,"عِندَ","(are) near","فَإِنِ ٱسْتَكْبَرُوا۟ فَٱلَّذِينَ","رَبِّكَ يُسَبِّحُونَ لَهُۥ",59],["41:50:22",482,"عِندَهُۥ","with Him","رَبِّىٓ إِنَّ لِى","لَلْحُسْنَىٰ ۚ فَلَنُنَبِّئَنَّ ٱلَّذِينَ",59],["41:52:6",482,"عِندِ","from","إِن كَانَ مِنْ","ٱللَّهِ ثُمَّ كَفَرْتُم",59],["42:16:12",485,"عِندَ","with","لَهُۥ حُجَّتُهُمْ دَاحِضَةٌ","رَبِّهِمْ وَعَلَيْهِمْ غَضَبٌۭ",59],["42:22:19",485,"عِندَ","with","لَهُم مَّا يَشَآءُونَ","رَبِّهِمْ ۚ ذَٰلِكَ هُوَ",59],["42:36:9",487,"عِندَ","(is) with","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ وَمَا","ٱللَّهِ خَيْرٌۭ وَأَبْقَىٰ",59],["43:35:10",492,"عِندَ","with","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۚ وَٱلْـَٔاخِرَةُ","رَبِّكَ لِلْمُتَّقِينَ",59],["43:49:9",493,"عِندَكَ","with you","رَبَّكَ بِمَا عَهِدَ","إِنَّنَا لَمُهْتَدُونَ",59],["43:85:9",495,"وَعِندَهُۥ","and with Him","وَٱلْأَرْضِ وَمَا بَيْنَهُمَا","عِلْمُ ٱلسَّاعَةِ وَإِلَيْهِ",59],["44:5:3",496,"عِندِنَآ ۚ","Us","أَمْرًۭا مِّنْ","إِنَّا كُنَّا مُرْسِلِينَ",59],["46:10:6",503,"عِندِ","from Allah","إِن كَانَ مِنْ","ٱللَّهِ وَكَفَرْتُم بِهِۦ",59],["46:23:4",505,"عِندَ","(is) with Allah","قَالَ إِنَّمَا ٱلْعِلْمُ","ٱللَّهِ وَأُبَلِّغُكُم مَّآ",59],["47:16:9",508,"عِندِكَ","you","إِذَا خَرَجُوا۟ مِنْ","قَالُوا۟ لِلَّذِينَ أُوتُوا۟",59],["48:5:16",511,"عِندَ","with","سَيِّـَٔاتِهِمْ ۚ وَكَانَ ذَٰلِكَ","ٱللَّهِ فَوْزًا عَظِيمًۭا",59],["49:3:5",515,"عِندَ","(in) presence","ٱلَّذِينَ يَغُضُّونَ أَصْوَٰتَهُمْ","رَسُولِ ٱللَّهِ أُو۟لَـٰٓئِكَ",59],["49:13:14",517,"عِندَ","near","لِتَعَارَفُوٓا۟ ۚ إِنَّ أَكْرَمَكُمْ","ٱللَّهِ أَتْقَىٰكُمْ ۚ إِنَّ",59],["50:4:7",518,"وَعِندَنَا","and with Us","تَنقُصُ ٱلْأَرْضُ مِنْهُمْ ۖ","كِتَـٰبٌ حَفِيظٌۢ",59],["50:24:6",519,"عَنِيدٍۢ","stubborn","جَهَنَّمَ كُلَّ كَفَّارٍ","",1500],["51:34:2",522,"عِندَ","by your Lord","مُّسَوَّمَةً","رَبِّكَ لِلْمُسْرِفِينَ",59],["52:37:2",525,"عِندَهُمْ","with them","أَمْ","خَزَآئِنُ رَبِّكَ أَمْ",59],["52:41:2",525,"عِندَهُمُ","with them","أَمْ","ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ",59],["53:14:1",526,"عِندَ","Near","","سِدْرَةِ ٱلْمُنتَهَىٰ",59],["53:15:1",526,"عِندَهَا","Near it","","جَنَّةُ ٱلْمَأْوَىٰٓ",59],["53:35:1",527,"أَعِندَهُۥ","Is with him","","عِلْمُ ٱلْغَيْبِ فَهُوَ",59],["54:35:3",530,"عِندِنَا ۚ","Us","نِّعْمَةًۭ مِّنْ","كَذَٰلِكَ نَجْزِى مَن",59],["54:55:4",531,"عِندَ","near","فِى مَقْعَدِ صِدْقٍ","مَلِيكٍۢ مُّقْتَدِرٍۭ",59],["57:19:9",540,"عِندَ","(are) with","هُمُ ٱلصِّدِّيقُونَ ۖ وَٱلشُّهَدَآءُ","رَبِّهِمْ لَهُمْ أَجْرُهُمْ",59],["61:3:3",551,"عِندَ","with","كَبُرَ مَقْتًا","ٱللَّهِ أَن تَقُولُوا۟",59],["62:11:12",554,"عِندَ","(is) with","قَآئِمًۭا ۚ قُلْ مَا","ٱللَّهِ خَيْرٌۭ مِّنَ",59],["63:7:8",555,"عِندَ","(are) with","تُنفِقُوا۟ عَلَىٰ مَنْ","رَسُولِ ٱللَّهِ حَتَّىٰ",59],["64:15:6",557,"عِندَهُۥٓ","with Him","وَأَوْلَـٰدُكُمْ فِتْنَةٌۭ ۚ وَٱللَّهُ","أَجْرٌ عَظِيمٌۭ",59],["66:11:13",561,"عِندَكَ","near You","رَبِّ ٱبْنِ لِى","بَيْتًۭا فِى ٱلْجَنَّةِ",59],["67:26:4",563,"عِندَ","(is) with","قُلْ إِنَّمَا ٱلْعِلْمُ","ٱللَّهِ وَإِنَّمَآ أَنَا۠",59],["68:34:3",565,"عِندَ","with","إِنَّ لِلْمُتَّقِينَ","رَبِّهِمْ جَنَّـٰتِ ٱلنَّعِيمِ",59],["68:47:2",566,"عِندَهُمُ","(is) with them","أَمْ","ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ",59],["73:20:67",575,"عِندَ","with","مِّنْ خَيْرٍۢ تَجِدُوهُ","ٱللَّهِ هُوَ خَيْرًۭا",59],["74:16:5",575,"عَنِيدًۭا","stubborn","إِنَّهُۥ كَانَ لِـَٔايَـٰتِنَا","",1500],["81:20:3",586,"عِندَ","with","ذِى قُوَّةٍ","ذِى ٱلْعَرْشِ مَكِينٍۢ",59],["92:19:3",596,"عِندَهُۥ","with him","وَمَا لِأَحَدٍ","مِن نِّعْمَةٍۢ تُجْزَىٰٓ",59],["98:8:2",599,"عِندَ","(is) with","جَزَآؤُهُمْ","رَبِّهِمْ جَنَّـٰتُ عَدْنٍۢ",59]]