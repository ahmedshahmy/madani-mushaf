[["2:54:19",8,"عِندَ","with","ذَٰلِكُمْ خَيْرٌۭ لَّكُمْ","بَارِئِكُمْ فَتَابَ عَلَيْكُمْ ۚ",59],["2:62:17",10,"عِندَ","(is) with","صَـٰلِحًۭا فَلَهُمْ أَجْرُهُمْ","رَبِّهِمْ وَلَا خَوْفٌ",59],["2:76:20",11,"عِندَ","before","عَلَيْكُمْ لِيُحَآجُّوكُم بِهِۦ","رَبِّكُمْ ۚ أَفَلَا تَعْقِلُونَ",59],["2:79:10",12,"عِندِ","from","يَقُولُونَ هَـٰذَا مِنْ","ٱللَّهِ لِيَشْتَرُوا۟ بِهِۦ",59],["2:80:10",12,"عِندَ","from","مَّعْدُودَةًۭ ۚ قُلْ أَتَّخَذْتُمْ","ٱللَّهِ عَهْدًۭا فَلَن",59],["2:89:5",14,"عِندِ","from","جَآءَهُمْ كِتَـٰبٌۭ مِّنْ","ٱللَّهِ مُصَدِّقٌۭ لِّمَا",59],["2:94:7",15,"عِندَ","with","لَكُمُ ٱلدَّارُ ٱلْـَٔاخِرَةُ","ٱللَّهِ خَالِصَةًۭ مِّن",59],["2:101:5",15,"عِندِ","from","جَآءَهُمْ رَسُولٌۭ مِّنْ","ٱللَّهِ مُصَدِّقٌۭ لِّمَا",59],["2:103:7",16,"عِندِ","from","وَٱتَّقَوْا۟ لَمَثُوبَةٌۭ مِّنْ","ٱللَّهِ خَيْرٌۭ ۖ لَّوْ",59],["2:109:14",17,"عِندِ","(of)","كُفَّارًا حَسَدًۭا مِّنْ","أَنفُسِهِم مِّنۢ بَعْدِ",59],["2:110:11",17,"عِندَ","with","مِّنْ خَيْرٍۢ تَجِدُوهُ","ٱللَّهِ ۗ إِنَّ ٱللَّهَ",59],["2:112:10",17,"عِندَ","with","مُحْسِنٌۭ فَلَهُۥٓ أَجْرُهُۥ","رَبِّهِۦ وَلَا خَوْفٌ",59],["2:140:23",21,"عِندَهُۥ","(that) he has","مِمَّن كَتَمَ شَهَـٰدَةً","مِنَ ٱللَّهِ ۗ وَمَا",59],["2:191:14",30,"عِندَ","near","ٱلْقَتْلِ ۚ وَلَا تُقَـٰتِلُوهُمْ","ٱلْمَسْجِدِ ٱلْحَرَامِ حَتَّىٰ",59],["2:198:15",31,"عِندَ","near","عَرَفَـٰتٍۢ فَٱذْكُرُوا۟ ٱللَّهَ","ٱلْمَشْعَرِ ٱلْحَرَامِ ۖ وَٱذْكُرُوهُ",59],["2:217:23",34,"عِندَ","near","أَهْلِهِۦ مِنْهُ أَكْبَرُ","ٱللَّهِ ۚ وَٱلْفِتْنَةُ أَكْبَرُ",59],["2:255:24",42,"عِندَهُۥٓ","with Him","ذَا ٱلَّذِى يَشْفَعُ","إِلَّا بِإِذْنِهِۦ ۚ يَعْلَمُ",59],["2:262:17",44,"عِندَ","(is) with","أَذًۭى ۙ لَّهُمْ أَجْرُهُمْ","رَبِّهِمْ وَلَا خَوْفٌ",59],["2:274:10",46,"عِندَ","with","وَعَلَانِيَةًۭ فَلَهُمْ أَجْرُهُمْ","رَبِّهِمْ وَلَا خَوْفٌ",59],["2:277:12",47,"عِندَ","(is) with","ٱلزَّكَوٰةَ لَهُمْ أَجْرُهُمْ","رَبِّهِمْ وَلَا خَوْفٌ",59],["2:282:89",48,"عِندَ","near","أَجَلِهِۦ ۚ ذَٰلِكُمْ أَقْسَطُ","ٱللَّهِ وَأَقْوَمُ لِلشَّهَـٰدَةِ",59],["3:7: