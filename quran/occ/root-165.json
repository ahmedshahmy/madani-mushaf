[["2:40:8",7,"وَأَوْفُوا۟","and fulfill","ٱلَّتِىٓ أَنْعَمْتُ عَلَيْكُمْ","بِعَهْدِىٓ أُوفِ بِعَهْدِكُمْ",541],["2:40:10",7,"أُوفِ","I will fulfill","عَلَيْكُمْ وَأَوْفُوا۟ بِعَهْدِىٓ","بِعَهْدِكُمْ وَإِيَّـٰىَ فَٱرْهَبُونِ",541],["2:177:36",27,"وَٱلْمُوفُونَ","and those who fulfill","ٱلصَّلَوٰةَ وَءَاتَى ٱلزَّكَوٰةَ","بِعَهْدِهِمْ إِذَا عَـٰهَدُوا۟ ۖ",3887],["2:234:2",38,"يُتَوَفَّوْنَ","pass away","وَٱلَّذِينَ","مِنكُمْ وَيَذَرُونَ أَزْوَٰجًۭا",443],["2:240:2",39,"يُتَوَفَّوْنَ","die","وَٱلَّذِينَ","مِنكُمْ وَيَذَرُونَ أَزْوَٰجًۭا",443],["2:272:24",46,"يُوَفَّ","will be repaid in full","تُنفِقُوا۟ مِنْ خَيْرٍۢ","إِلَيْكُمْ وَأَنتُمْ لَا",559],["2:281:8",47,"تُوَفَّىٰ","(will be) repaid in full","إِلَى ٱللَّهِ ۖ ثُمَّ","كُلُّ نَفْسٍۢ مَّا",559],["3:25:8",53,"وَوُفِّيَتْ","And will be paid in full","لَّا رَيْبَ فِيهِ","كُلُّ نَفْسٍۢ مَّا",559],["3:55:6",57,"مُتَوَفِّيكَ","(will) take you","ٱللَّهُ يَـٰعِيسَىٰٓ إِنِّى","وَرَافِعُكَ إِلَىَّ وَمُطَهِّرُكَ",3879],["3:57:6",57,"فَيُوَفِّيهِمْ","then He will grant them in full","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","أُجُورَهُمْ ۗ وَٱللَّهُ لَا",559],["3:76:3",59,"أَوْفَىٰ","fulfills","بَلَىٰ مَنْ","بِعَهْدِهِۦ وَٱتَّقَىٰ فَإِنَّ",541],["3:161:14",71,"تُوَفَّىٰ","is repaid in full","يَوْمَ ٱلْقِيَـٰمَةِ ۚ ثُمَّ","كُلُّ نَفْسٍۢ مَّا",559],["3:185:6",74,"تُوَفَّوْنَ","you will be paid in full","ذَآئِقَةُ ٱلْمَوْتِ ۗ وَإِنَّمَا","أُجُورَكُمْ يَوْمَ ٱلْقِيَـٰمَةِ ۖ",559],["3:193:18",75,"وَتَوَفَّنَا","and cause us to die","وَكَفِّرْ عَنَّا سَيِّـَٔاتِنَا","مَعَ ٱلْأَبْرَارِ",443],["4:15:16",80,"يَتَوَفَّىٰهُنَّ","comes to them","فِى ٱلْبُيُوتِ حَتَّىٰ","ٱلْمَوْتُ أَوْ يَجْعَلَ",443],["4:97:3",94,"تَوَفَّىٰهُمُ","take them (in death)","إِنَّ ٱلَّذِينَ","ٱلْمَلَـٰٓئِكَةُ ظَالِمِىٓ أَنفُسِهِمْ",443],["4:173:6",105,"فَيُوَفِّيهِمْ","then He will give them in full","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","أُجُورَهُمْ وَيَزِيدُهُم مِّن",559],["5:1:4",106,"أَوْفُوا۟","Fulfil","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟","بِٱلْعُقُودِ ۚ أُحِلَّتْ لَكُم",541],["5:117:20",127,"تَوَفَّيْتَنِى","You raised me","دُمْتُ فِيهِمْ ۖ فَلَمَّا","كُنتَ أَنتَ ٱلرَّقِيبَ",443],["6:60:3",135,"يَتَوَفَّىٰكُم","takes your (soul)","وَهُوَ ٱلَّذِى","بِٱلَّيْلِ وَيَعْلَمُ مَا",443],["6:61:13",135,"تَوَفَّتْهُ","take him","جَآءَ أَحَدَكُمُ ٱلْمَوْتُ","رُسُلُنَا وَهُمْ لَا",443],["6:152:12",149,"وَأَوْفُوا۟","And give full","حَتَّىٰ يَبْلُغَ أَشُدَّهُۥ ۖ","ٱلْكَيْلَ وَٱلْمِيزَانَ بِٱلْقِسْطِ ۖ",541],["6:152:30",149,"أَوْفُوا۟ ۚ","fulfil","قُرْبَىٰ ۖ وَبِعَهْدِ ٱللَّهِ","ذَٰلِكُمْ وَصَّىٰكُم بِهِۦ",541],["7:37:20",154,"يَتَوَفَّوْنَهُمْ","(to) take them in death","إِذَا جَآءَتْهُمْ رُسُلُنَا","قَالُوٓا۟ أَيْنَ مَا",443],["7:85:19",161,"فَأَوْفُوا۟","So give full","بَيِّنَةٌۭ مِّن رَّبِّكُمْ ۖ","ٱلْكَيْلَ وَٱلْمِيزَانَ وَلَا",541],["7:126:15",165,"وَتَوَفَّنَا","and cause us to die","أَفْرِغْ عَلَيْنَا صَبْرًۭا","مُسْلِمِينَ",443],["8:50:4",183,"يَتَوَفَّى","take away souls","وَلَوْ تَرَىٰٓ إِذْ","ٱلَّذِينَ كَفَرُوا۟ ۙ ٱلْمَلَـٰٓئِكَةُ",443],["8:60:29",184,"يُوَفَّ","it will be fully repaid","فِى سَبِيلِ ٱللَّهِ","إِلَيْكُمْ وَأَنتُمْ لَا",559],["9:111:25",204,"أَوْفَىٰ","(is) more faithful","وَٱلْإِنجِيلِ وَٱلْقُرْءَانِ ۚ وَمَنْ","بِعَهْدِهِۦ مِنَ ٱللَّهِ ۚ",2201],["10:46:7",214,"نَتَوَفَّيَنَّكَ","We cause you to die","ٱلَّذِى نَعِدُهُمْ أَوْ","فَإِلَيْنَا مَرْجِعُهُمْ ثُمَّ",443],["10:104:21",220,"يَتَوَفَّىٰكُمْ ۖ","causes you to die","أَعْبُدُ ٱللَّهَ ٱلَّذِى","وَأُمِرْتُ أَنْ أَكُونَ",443],["11:15:7",223,"نُوَفِّ","We will repay in full","ٱلْحَيَوٰةَ ٱلدُّنْيَا وَزِينَتَهَا","إِلَيْهِمْ أَعْمَـٰلَهُمْ فِيهَا",559],["11:85:2",231,"أَوْفُوا۟","Give full","وَيَـٰقَوْمِ","ٱلْمِكْيَالَ وَٱلْمِيزَانَ بِٱلْقِسْطِ ۖ",541],["11:109:17",234,"لَمُوَفُّوهُمْ","will surely pay them in full","مِّن قَبْلُ ۚ وَإِنَّا","نَصِيبَهُمْ غَيْرَ مَنقُوصٍۢ",3885],["11:111:4",234,"لَيُوَفِّيَنَّهُمْ","surely will pay them in full","وَإِنَّ كُلًّۭا لَّمَّا","رَبُّكَ أَعْمَـٰلَهُمْ ۚ إِنَّهُۥ",559],["12:59:13",242,"أُوفِى","[I] give full","أَلَا تَرَوْنَ أَنِّىٓ","ٱلْكَيْلَ وَأَنَا۠ خَيْرُ",541],["12:88:13",246,"فَأَوْفِ","but pay (in) full","وَجِئْنَا بِبِضَـٰعَةٍۢ مُّزْجَىٰةٍۢ","لَنَا ٱلْكَيْلَ وَتَصَدَّقْ",541],["12:101:18",247,"تَوَفَّنِى","Cause me to die","فِى ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ ۖ","مُسْلِمًۭا وَأَلْحِقْنِى بِٱلصَّـٰلِحِينَ",443],["13:20:2",252,"يُوفُونَ","fulfill","ٱلَّذِينَ","بِعَهْدِ ٱللَّهِ وَلَا",541],["13:40:8",254,"نَتَوَفَّيَنَّكَ","We cause you to die","ٱلَّذِى نَعِدُهُمْ أَوْ","فَإِنَّمَا عَلَيْكَ ٱلْبَلَـٰغُ",443],["16:28:2",270,"تَتَوَفَّىٰهُمُ","take them in death","ٱلَّذِينَ","ٱلْمَلَـٰٓئِكَةُ ظَالِمِىٓ أَنفُسِهِمْ ۖ",443],["16:32:2",270,"تَتَوَفَّىٰهُمُ","take them in death","ٱلَّذِينَ","ٱلْمَلَـٰٓئِكَةُ طَيِّبِينَ ۙ يَقُولُونَ",443],["16:70:4",274,"يَتَوَفَّىٰكُمْ ۚ","will cause you to die","وَٱللَّهُ خَلَقَكُمْ ثُمَّ","وَمِنكُم مَّن يُرَدُّ",443],["16:91:1",277,"وَأَوْفُوا۟","And fulfil","","بِعَهْدِ ٱللَّهِ إِذَا",541],["16:111:8",280,"وَتُوَفَّىٰ","and will be paid in full","تُجَـٰدِلُ عَن نَّفْسِهَا","كُلُّ نَفْسٍۢ مَّا",559],["17:34:12",285,"وَأَوْفُوا۟","And fulfil","حَتَّىٰ يَبْلُغَ أَشُدَّهُۥ ۚ","بِٱلْعَهْدِ ۖ إِنَّ ٱلْعَهْدَ",541],["17:35:1",285,"وَأَوْفُوا۟","And give full","","ٱلْكَيْلَ إِذَا كِلْتُمْ",541],["22:5:43",332,"يُتَوَفَّىٰ","dies","أَشُدَّكُمْ ۖ وَمِنكُم مَّن","وَمِنكُم مَّن يُرَدُّ",443],["22:29:4",335,"وَلْيُوفُوا۟","and fulfil","ثُمَّ لْيَقْضُوا۟ تَفَثَهُمْ","نُذُورَهُمْ وَلْيَطَّوَّفُوا۟ بِٱلْبَيْتِ",541],["24:25:2",352,"يُوَفِّيهِمُ","Allah will pay them in full","يَوْمَئِذٍۢ","ٱللَّهُ دِينَهُمُ ٱلْحَقَّ",559],["24:39:18",355,"فَوَفَّىٰهُ","He will pay him in full","وَوَجَدَ ٱللَّهَ عِندَهُۥ","حِسَابَهُۥ ۗ وَٱللَّهُ سَرِيعُ",559],["26:181:1",374,"۞ أَوْفُوا۟","Give full","","ٱلْكَيْلَ وَلَا تَكُونُوا۟",541],["32:11:2",415,"يَتَوَفَّىٰكُم","Will take your soul","۞ قُلْ","مَّلَكُ ٱلْمَوْتِ ٱلَّذِى",443],["35:30:1",437,"لِيُوَفِّيَهُمْ","That He may give them in full","","أُجُورَهُمْ وَيَزِيدَهُم مِّن",559],["39:10:17",459,"يُوَفَّى","will be paid back in full","ٱللَّهِ وَٰسِعَةٌ ۗ إِنَّمَا","ٱلصَّـٰبِرُونَ أَجْرَهُم بِغَيْرِ",559],["39:42:2",463,"يَتَوَفَّى","takes","ٱللَّهُ","ٱلْأَنفُسَ حِينَ مَوْتِهَا",443],["39:70:1",466,"وَوُفِّيَتْ","And (will) be paid in full","","كُلُّ نَفْسٍۢ مَّا",559],["40:67:23",475,"يُتَوَفَّىٰ","dies","شُيُوخًۭا ۚ وَمِنكُم مَّن","مِن قَبْلُ ۖ وَلِتَبْلُغُوٓا۟",443],["40:77:12",475,"نَتَوَفَّيَنَّكَ","We cause you to die","ٱلَّذِى نَعِدُهُمْ أَوْ","فَإِلَيْنَا يُرْجَعُونَ",443],["46:19:5",504,"وَلِيُوَفِّيَهُمْ","and that He may fully compensate them","دَرَجَـٰتٌۭ مِّمَّا عَمِلُوا۟ ۖ","أَعْمَـٰلَهُمْ وَهُمْ لَا",559],["47:27:3",509,"تَوَفَّتْهُمُ","take them in death","فَكَيْفَ إِذَا","ٱلْمَلَـٰٓئِكَةُ يَضْرِبُونَ وُجُوهَهُمْ",443],["48:10:18",512,"أَوْفَىٰ","fulfils","عَلَىٰ نَفْسِهِۦ ۖ وَمَنْ","بِمَا عَـٰهَدَ عَلَيْهُ",541],["53:37:3",527,"وَفَّىٰٓ","fulfilled","وَإِبْرَٰهِيمَ ٱلَّذِى","",559],["53:41:4",527,"ٱلْأَوْفَىٰ","the fullest","ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ","",2201],["76:7:1",579,"يُوفُونَ","They fulfill","","بِٱلنَّذْرِ وَيَخَافُونَ يَوْمًۭا",541],["83:2:6",587,"يَسْتَوْفُونَ","they take in full","ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ","",4668]]