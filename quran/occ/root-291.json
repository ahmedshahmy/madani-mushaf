[["2:35:10",6,"حَيْثُ","(from) wherever","وَكُلَا مِنْهَا رَغَدًا","شِئْتُمَا وَلَا تَقْرَبَا",373],["2:58:8",9,"حَيْثُ","wherever","ٱلْقَرْيَةَ فَكُلُوا۟ مِنْهَا","شِئْتُمْ رَغَدًۭا وَٱدْخُلُوا۟",373],["2:144:15",22,"وَحَيْثُ","and wherever","شَطْرَ ٱلْمَسْجِدِ ٱلْحَرَامِ ۚ","مَا كُنتُمْ فَوَلُّوا۟",2279],["2:149:2",23,"حَيْثُ","wherever","وَمِنْ","خَرَجْتَ فَوَلِّ وَجْهَكَ",373],["2:150:2",23,"حَيْثُ","wherever","وَمِنْ","خَرَجْتَ فَوَلِّ وَجْهَكَ",373],["2:150:9",23,"وَحَيْثُ","And wherever","شَطْرَ ٱلْمَسْجِدِ ٱلْحَرَامِ ۚ","مَا كُنتُمْ فَوَلُّوا۟",2279],["2:191:2",30,"حَيْثُ","wherever","وَٱقْتُلُوهُمْ","ثَقِفْتُمُوهُمْ وَأَخْرِجُوهُم مِّنْ",373],["2:191:6",30,"حَيْثُ","wherever","ثَقِفْتُمُوهُمْ وَأَخْرِجُوهُم مِّنْ","أَخْرَجُوكُمْ ۚ وَٱلْفِتْنَةُ أَشَدُّ",373],["2:199:4",31,"حَيْثُ","wherever","ثُمَّ أَفِيضُوا۟ مِنْ","أَفَاضَ ٱلنَّاسُ وَٱسْتَغْفِرُوا۟",373],["2:222:19",35,"حَيْثُ","where","تَطَهَّرْنَ فَأْتُوهُنَّ مِنْ","أَمَرَكُمُ ٱللَّهُ ۚ إِنَّ",373],["4:89:21",92,"حَيْثُ","wherever","تَوَلَّوْا۟ فَخُذُوهُمْ وَٱقْتُلُوهُمْ","وَجَدتُّمُوهُمْ ۖ وَلَا تَتَّخِذُوا۟",373],["4:91:25",92,"حَيْثُ","wherever","أَيْدِيَهُمْ فَخُذُوهُمْ وَٱقْتُلُوهُمْ","ثَقِفْتُمُوهُمْ ۚ وَأُو۟لَـٰٓئِكُمْ جَعَلْنَا",373],["6:124:16",143,"حَيْثُ","where","ٱللَّهِ ۘ ٱللَّهُ أَعْلَمُ","يَجْعَلُ رِسَالَتَهُۥ ۗ سَيُصِيبُ",373],["7:19:8",152,"حَيْثُ","wherever","ٱلْجَنَّةَ فَكُلَا مِنْ","شِئْتُمَا وَلَا تَقْرَبَا",373],["7:27:21",153,"حَيْثُ","where","هُوَ وَقَبِيلُهُۥ مِنْ","لَا تَرَوْنَهُمْ ۗ إِنَّا",373],["7:161:9",171,"حَيْثُ","wherever","ٱلْقَرْيَةَ وَكُلُوا۟ مِنْهَا","شِئْتُمْ وَقُولُوا۟ حِطَّةٌۭ",373],["7:182:6",174,"حَيْثُ","where","بِـَٔايَـٰتِنَا سَنَسْتَدْرِجُهُم مِّنْ","لَا يَعْلَمُونَ",373],["9:5:7",187,"حَيْثُ","wherever","ٱلْحُرُمُ فَٱقْتُلُوا۟ ٱلْمُشْرِكِينَ","وَجَدتُّمُوهُمْ وَخُذُوهُمْ وَٱحْصُرُوهُمْ",373],["12:56:8",242,"حَيْثُ","where ever","ٱلْأَرْضِ يَتَبَوَّأُ مِنْهَا","يَشَآءُ ۚ نُصِيبُ بِرَحْمَتِنَا",373],["12:68:4",243,"حَيْثُ","where","وَلَمَّا دَخَلُوا۟ مِنْ","