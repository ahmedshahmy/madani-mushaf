[["2:135:11",21,"حَنِيفًۭا ۖ","(the) upright","بَلْ مِلَّةَ إِبْرَٰهِـۧمَ","وَمَا كَانَ مِنَ",722],["3:67:9",58,"حَنِيفًۭا","a true","نَصْرَانِيًّۭا وَلَـٰكِن كَانَ","مُّسْلِمًۭا وَمَا كَانَ",722],["3:95:7",62,"حَنِيفًۭا","(the) upright","فَٱتَّبِعُوا۟ مِلَّةَ إِبْرَٰهِيمَ","وَمَا كَانَ مِنَ",722],["4:125:13",98,"حَنِيفًۭا ۗ","(the) upright","وَٱتَّبَعَ مِلَّةَ إِبْرَٰهِيمَ","وَٱتَّخَذَ ٱللَّهُ إِبْرَٰهِيمَ",722],["6:79:8",137,"حَنِيفًۭا ۖ","(as) a true monotheist","فَطَرَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","وَمَآ أَنَا۠ مِنَ",722],["6:161:12",150,"حَنِيفًۭا ۚ","a true monotheist","قِيَمًۭا مِّلَّةَ إِبْرَٰهِيمَ","وَمَا كَانَ مِنَ",722],["10:105:5",220,"حَنِيفًۭا","upright","أَقِمْ وَجْهَكَ لِلدِّينِ","وَلَا تَكُونَنَّ مِنَ",722],["16:120:7",281,"حَنِيفًۭا","upright","أُمَّةًۭ قَانِتًۭا لِّلَّهِ","وَلَمْ يَكُ مِنَ",722],["16:123:8",281,"حَنِيفًۭا ۖ","upright","ٱتَّبِعْ مِلَّةَ إِبْرَٰهِيمَ","وَمَا كَانَ مِنَ",722],["22:31:1",336,"حُنَفَآءَ","Being upright","","لِلَّهِ غَيْرَ مُشْرِكِينَ",722],["30:30:4",407,"حَنِيفًۭا ۚ","upright","فَأَقِمْ وَجْهَكَ لِلدِّينِ","فِطْرَتَ ٱللَّهِ ٱلَّتِى",722],["98:5:9",598,"حُنَفَآءَ","upright","مُخْلِصِينَ لَهُ ٱلدِّينَ","وَيُقِيمُوا۟ ٱلصَّلَوٰةَ وَيُؤْتُوا۟",722]]