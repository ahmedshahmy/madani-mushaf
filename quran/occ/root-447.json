[["2:217:47",34,"حَبِطَتْ","became worthless","وَهُوَ كَافِرٌۭ فَأُو۟لَـٰٓئِكَ","أَعْمَـٰلُهُمْ فِى ٱلدُّنْيَا",719],["3:22:3",52,"حَبِطَتْ","became worthless","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","أَعْمَـٰلُهُمْ فِى ٱلدُّنْيَا",719],["5:5:37",107,"حَبِطَ","(are) wasted","يَكْفُرْ بِٱلْإِيمَـٰنِ فَقَدْ","عَمَلُهُۥ وَهُوَ فِى",719],["5:53:12",117,"حَبِطَتْ","Became worthless","أَيْمَـٰنِهِمْ ۙ إِنَّهُمْ لَمَعَكُمْ ۚ","أَعْمَـٰلُهُمْ فَأَصْبَحُوا۟ خَـٰسِرِينَ",719],["6:88:12",138,"لَحَبِطَ","surely (would be) worthless","عِبَادِهِۦ ۚ وَلَوْ أَشْرَكُوا۟","عَنْهُم مَّا كَانُوا۟",719],["7:147:6",168,"حَبِطَتْ","worthless","بِـَٔايَـٰتِنَا وَلِقَآءِ ٱلْـَٔاخِرَةِ","أَعْمَـٰلُهُمْ ۚ هَلْ يُجْزَوْنَ",719],["9:17:13",189,"حَبِطَتْ","worthless","أَنفُسِهِم بِٱلْكُفْرِ ۚ أُو۟لَـٰٓئِكَ","أَعْمَـٰلُهُمْ وَفِى ٱلنَّارِ",719],["9:69:25",198,"حَبِطَتْ","worthless","كَٱلَّذِى خَاضُوٓا۟ ۚ أُو۟لَـٰٓئِكَ","أَعْمَـٰلُهُمْ فِى ٱلدُّنْيَا",719],["11:16:9",223,"وَحَبِطَ","And (has) gone in vain","ٱلْـَٔاخِرَةِ إِلَّا ٱلنَّارُ ۖ","مَا صَنَعُوا۟ فِيهَا",719],["18:105:7",304,"فَحَبِطَتْ","So (are) vain","بِـَٔايَـٰتِ رَبِّهِمْ وَلِقَآئِهِۦ","أَعْمَـٰلُهُمْ فَلَا نُقِيمُ",719],["33:19:28",420,"فَأَحْبَطَ","so Allah made worthless","أُو۟لَـٰٓئِكَ لَمْ يُؤْمِنُوا۟","ٱللَّهُ أَعْمَـٰلَهُمْ ۚ وَكَانَ",1462],["39:65:10",465,"لَيَحْبَطَنَّ","surely, will become worthless","قَبْلِكَ لَئِنْ أَشْرَكْتَ","عَمَلُكَ وَلَتَكُونَنَّ مِنَ",719],["47:9:7",507,"فَأَحْبَطَ","so He has made worthless","مَآ أَنزَلَ ٱللَّهُ","أَعْمَـٰلَهُمْ",1462],["47:28:9",509,"فَأَحْبَطَ","so He made worthless","ٱللَّهَ وَكَرِهُوا۟ رِضْوَٰنَهُۥ","أَعْمَـٰلَهُمْ",1462],["47:32:20",510,"وَسَيُحْبِطُ","and He will make worthless","يَضُرُّوا۟ ٱللَّهَ شَيْـًۭٔا","أَعْمَـٰلَهُمْ",1462],["49:2:18",515,"تَحْبَطَ","become worthless","بَعْضِكُمْ لِبَعْضٍ أَن","أَعْمَـٰلُكُمْ وَأَنتُمْ لَا",719]]