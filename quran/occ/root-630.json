[["6:42:11",132,"يَتَضَرَّعُونَ","humble themselves","بِٱلْبَأْسَآءِ وَٱلضَّرَّآءِ لَعَلَّهُمْ","",2070],["6:43:5",132,"تَضَرَّعُوا۟","they humbled themselves","إِذْ جَآءَهُم بَأْسُنَا","وَلَـٰكِن قَسَتْ قُلُوبُهُمْ",4315],["6:63:9",135,"تَضَرُّعًۭا","humbly","ٱلْبَرِّ وَٱلْبَحْرِ تَدْعُونَهُۥ","وَخُفْيَةًۭ لَّئِنْ أَنجَىٰنَا",2006],["7:55:3",157,"تَضَرُّعًۭا","humbly","ٱدْعُوا۟ رَبَّكُمْ","وَخُفْيَةً ۚ إِنَّهُۥ لَا",2006],["7:94:13",162,"يَضَّرَّعُونَ","(become) humble","بِٱلْبَأْسَآءِ وَٱلضَّرَّآءِ لَعَلَّهُمْ","",2070],["7:205:5",176,"تَضَرُّعًۭا","humbly","رَّبَّكَ فِى نَفْسِكَ","وَخِيفَةًۭ وَدُونَ ٱلْجَهْرِ",2006],["23:76:8",347,"يَتَضَرَّعُونَ","they supplicate humbly","ٱسْتَكَانُوا۟ لِرَبِّهِمْ وَمَا","",2070],["88:6:6",592,"ضَرِيعٍۢ","a bitter thorny plant","طَعَامٌ إِلَّا مِن","",3078]]