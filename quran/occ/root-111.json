[["2:19:12",4,"ءَاذَانِهِم","their ears","يَجْعَلُونَ أَصَـٰبِعَهُمْ فِىٓ","مِّنَ ٱلصَّوَٰعِقِ حَذَرَ",542],["2:97:10",15,"بِإِذْنِ","by (the) permission","نَزَّلَهُۥ عَلَىٰ قَلْبِكَ","ٱللَّهِ مُصَدِّقًۭا لِّمَا",298],["2:102:50",16,"بِإِذْنِ","by permission","مِنْ أَحَدٍ إِلَّا","ٱللَّهِ ۚ وَيَتَعَلَّمُونَ مَا",298],["2:213:42",33,"بِإِذْنِهِۦ ۗ","with His permission","فِيهِ مِنَ ٱلْحَقِّ","وَٱللَّهُ يَهْدِى مَن",298],["2:221:34",35,"بِإِذْنِهِۦ ۖ","by His permission","إِلَى ٱلْجَنَّةِ وَٱلْمَغْفِرَةِ","وَيُبَيِّنُ ءَايَـٰتِهِۦ لِلنَّاسِ",298],["2:249:56",41,"بِإِذْنِ","by (the) permission","غَلَبَتْ فِئَةًۭ كَثِيرَةًۢ","ٱللَّهِ ۗ وَٱللَّهُ مَعَ",298],["2:251:2",41,"بِإِذْنِ","by (the) permission","فَهَزَمُوهُم","ٱللَّهِ وَقَتَلَ دَاوُۥدُ",298],["2:255:26",42,"بِإِذْنِهِۦ ۚ","by His permission","يَشْفَعُ عِندَهُۥٓ إِلَّا","يَعْلَمُ مَا بَيْنَ",298],["2:279:4",47,"فَأْذَنُوا۟","then be informed","فَإِن لَّمْ تَفْعَلُوا۟","بِحَرْبٍۢ مِّنَ ٱللَّهِ",450],["3:49:22",56,"بِإِذْنِ","by (the) permission","فِيهِ فَيَكُونُ طَيْرًۢا","ٱللَّهِ ۖ وَأُبْرِئُ ٱلْأَكْمَهَ",298],["3:49:29",56,"بِإِذْنِ","by (the) permission","وَٱلْأَبْرَصَ وَأُحْىِ ٱلْمَوْتَىٰ","ٱللَّهِ ۖ وَأُنَبِّئُكُم بِمَا",298],["3:145:7",68,"بِإِذْنِ","by (the) permission","أَن تَمُوتَ إِلَّا","ٱللَّهِ كِتَـٰبًۭا مُّؤَجَّلًۭا ۗ",298],["3:152:7",69,"بِإِذْنِهِۦ ۖ","by His permission","وَعْدَهُۥٓ إِذْ تَحُسُّونَهُم","حَتَّىٰٓ إِذَا فَشِلْتُمْ",298],["3:166:6",72,"فَبِإِذْنِ","(was) by (the) permission","يَوْمَ ٱلْتَقَى ٱلْجَمْعَانِ","ٱللَّهِ وَلِيَعْلَمَ ٱلْمُؤْمِنِينَ",298],["4:25:24",82,"بِإِذْنِ","with (the) permission","مِّنۢ بَعْضٍۢ ۚ فَٱنكِحُوهُنَّ","أَهْلِهِنَّ وَءَاتُوهُنَّ أُجُورَهُنَّ",298],["4:64:7",88,"بِإِذْنِ","by (the) permission","رَّسُولٍ إِلَّا لِيُطَاعَ","ٱللَّهِ ۚ وَلَوْ أَنَّهُمْ",298],["4:119:5",97,"ءَاذَانَ","(the) ears","وَلَأُمَنِّيَنَّهُمْ وَلَـَٔامُرَنَّهُمْ فَلَيُبَتِّكُنَّ","ٱلْأَنْعَـٰمِ وَلَـَٔامُرَنَّهُمْ فَلَيُغَيِّرُنَّ",542],["5:16:14",110,"بِإِذْنِهِۦ","by His permission","ٱلظُّلُمَـٰتِ إِلَى ٱلنُّورِ","وَيَهْدِيهِمْ إِلَىٰ صِرَٰطٍۢ",298],["5:45:11",115,"وَٱلْأُذُنَ","and the ear","بِٱلْعَيْنِ وَٱلْأَنفَ بِٱلْأَنفِ","بِٱلْأُذُنِ وَٱلسِّنَّ بِٱلسِّنِّ",542],["5:45:12",115,"بِٱلْأُذُنِ","for the ear","وَٱلْأَنفَ بِٱلْأَنفِ وَٱلْأُذُنَ","وَٱلسِّنَّ بِٱلسِّنِّ وَٱلْجُرُوحَ",542],["5:110:33",126,"بِإِذْنِى","by My permission","ٱلطِّينِ كَهَيْـَٔةِ ٱلطَّيْرِ","فَتَنفُخُ فِيهَا فَتَكُونُ",298],["5:110:38",126,"بِإِذْنِى ۖ","by My permission","فِيهَا فَتَكُونُ طَيْرًۢا","وَتُبْرِئُ ٱلْأَكْمَهَ وَٱلْأَبْرَصَ",298],["5:110:42",126,"بِإِذْنِى ۖ","by My permission","وَتُبْرِئُ ٱلْأَكْمَهَ وَٱلْأَبْرَصَ","وَإِذْ تُخْرِجُ ٱلْمَوْتَىٰ",298],["5:110:46",126,"بِإِذْنِى ۖ","by My permission","وَإِذْ تُخْرِجُ ٱلْمَوْتَىٰ","وَإِذْ كَفَفْتُ بَنِىٓ",298],["6:25:12",130,"ءَاذَانِهِمْ","their ears","أَن يَفْقَهُوهُ وَفِىٓ","وَقْرًۭا ۚ وَإِن يَرَوْا۟",542],["7:44:21",156,"فَأَذَّنَ","Then will announce","حَقًّۭا ۖ قَالُوا۟ نَعَمْ ۚ","مُؤَذِّنٌۢ بَيْنَهُمْ أَن",1720],["7:44:22",156,"مُؤَذِّنٌۢ","an announcer","قَالُوا۟ نَعَمْ ۚ فَأَذَّنَ","بَيْنَهُمْ أَن لَّعْنَةُ",2480],["7:58:5",158,"بِإِذْنِ","by (the) permission","ٱلطَّيِّبُ يَخْرُجُ نَبَاتُهُۥ","رَبِّهِۦ ۖ وَٱلَّذِى خَبُثَ",298],["7:123:7",165,"ءَاذَنَ","I give permission","بِهِۦ قَبْلَ أَنْ","لَكُمْ ۖ إِنَّ هَـٰذَا",450],["7:167:2",172,"تَأَذَّنَ","declared","وَإِذْ","رَبُّكَ لَيَبْعَثَنَّ عَلَيْهِمْ",2650],["7:179:19",174,"ءَاذَانٌۭ","(are) ears","يُبْصِرُونَ بِهَا وَلَهُمْ","لَّا يَسْمَعُونَ بِهَآ ۚ",542],["7:195:17",175,"ءَاذَانٌۭ","ears","بِهَآ ۖ أَمْ لَهُمْ","يَسْمَعُونَ بِهَا ۗ قُلِ",542],["8:66:22",185,"بِإِذْنِ","with (the) permission","أَلْفٌۭ يَغْلِبُوٓا۟ أَلْفَيْنِ","ٱللَّهِ ۗ وَٱللَّهُ مَعَ",298],["9:3:1",187,"وَأَذَٰنٌۭ","And an announcement","","مِّنَ ٱللَّهِ وَرَسُولِهِۦٓ",2948],["9:43:5",194,"أَذِنتَ","you grant leave","ٱللَّهُ عَنكَ لِمَ","لَهُمْ حَتَّىٰ يَتَبَيَّنَ",450],["9:44:2",194,"يَسْتَـْٔذِنُكَ","(Would) not ask your permission","لَا","ٱلَّذِينَ يُؤْمِنُونَ بِٱللَّهِ",755],["9:45:2",194,"يَسْتَـْٔذِنُكَ","ask your leave","إِنَّمَا","ٱلَّذِينَ لَا يُؤْمِنُونَ",755],["9:49:4",195,"ٱئْذَن","Grant me leave","وَمِنْهُم مَّن يَقُولُ","لِّى وَلَا تَفْتِنِّىٓ ۚ",450],["9:61:7",196,"أُذُنٌۭ ۚ","(all) ear","ٱلنَّبِىَّ وَيَقُولُونَ هُوَ","قُلْ أُذُنُ خَيْرٍۢ",542],["9:61:9",196,"أُذُنُ","An ear","هُوَ أُذُنٌۭ ۚ قُلْ","خَيْرٍۢ لَّكُمْ يُؤْمِنُ",542],["9:83:7",200,"فَٱسْتَـْٔذَنُوكَ","and they ask you permission","إِلَىٰ طَآئِفَةٍۢ مِّنْهُمْ","لِلْخُرُوجِ فَقُل لَّن",755],["9:86:10",200,"ٱسْتَـْٔذَنَكَ","ask your permission","وَجَـٰهِدُوا۟ مَعَ رَسُولِهِ","أُو۟لُوا۟ ٱلطَّوْلِ مِنْهُمْ",755],["9:90:5",201,"لِيُؤْذَنَ","that permission be granted","ٱلْمُعَذِّرُونَ مِنَ ٱلْأَعْرَابِ","لَهُمْ وَقَعَدَ ٱلَّذِينَ",450],["9:93:5",201,"يَسْتَـْٔذِنُونَكَ","ask your permission","ٱلسَّبِيلُ عَلَى ٱلَّذِينَ","وَهُمْ أَغْنِيَآءُ ۚ رَضُوا۟",755],["10:3:23",208,"إِذْنِهِۦ ۚ","His permission","إِلَّا مِنۢ بَعْدِ","ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ",298],["10:59:15",215,"أَذِنَ","permitted","وَحَلَـٰلًۭا قُلْ ءَآللَّهُ","لَكُمْ ۖ أَمْ عَلَى",450],["10:100:7",220,"بِإِذْنِ","by (the) permission","أَن تُؤْمِنَ إِلَّا","ٱللَّهِ ۚ وَيَجْعَلُ ٱلرِّجْسَ",298],["11:105:7",233,"بِإِذْنِهِۦ ۚ","by His leave","تَكَلَّمُ نَفْسٌ إِلَّا","فَمِنْهُمْ شَقِىٌّۭ وَسَعِيدٌۭ",298],["12:70:10",244,"أَذَّنَ","called out","رَحْلِ أَخِيهِ ثُمَّ","مُؤَذِّنٌ أَيَّتُهَا ٱلْعِيرُ",1720],["12:70:11",244,"مُؤَذِّنٌ","an announcer","أَخِيهِ ثُمَّ أَذَّنَ","أَيَّتُهَا ٱلْعِيرُ إِنَّكُمْ",2480],["12:80:28",245,"يَأْذَنَ","permits","أَبْرَحَ ٱلْأَرْضَ حَتَّىٰ","لِىٓ أَبِىٓ أَوْ",450],["13:38:17",254,"بِإِذْنِ","by the leave","يَأْتِىَ بِـَٔايَةٍ إِلَّا","ٱللَّهِ ۗ لِكُلِّ أَجَلٍۢ",298],["14:1:11",255,"بِإِذْنِ","by the permission","ٱلظُّلُمَـٰتِ إِلَى ٱلنُّورِ","رَبِّهِمْ إِلَىٰ صِرَٰطِ",298],["14:7:2",256,"تَأَذَّنَ","proclaimed","وَإِذْ","رَبُّكُمْ لَئِن شَكَرْتُمْ",2650],["14:11:24",257,"بِإِذْنِ","by the permission of Allah","نَّأْتِيَكُم بِسُلْطَـٰنٍ إِلَّا","ٱللَّهِ ۚ وَعَلَى ٱللَّهِ",298],["14:23:13",258,"بِإِذْنِ","by the permission","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا","رَبِّهِمْ ۖ تَحِيَّتُهُمْ فِيهَا",298],["14:25:5",259,"بِإِذْنِ","by the permission","أُكُلَهَا كُلَّ حِينٍۭ","رَبِّهَا ۗ وَيَضْرِبُ ٱللَّهُ",298],["16:84:9",276,"يُؤْذَنُ","will be permitted","شَهِيدًۭا ثُمَّ لَا","لِلَّذِينَ كَفَرُوا۟ وَلَا",450],["17:46:8",286,"ءَاذَانِهِمْ","their ears","أَن يَفْقَهُوهُ وَفِىٓ","وَقْرًۭا ۚ وَإِذَا ذَكَرْتَ",542],["18:11:3",294,"ءَاذَانِهِمْ","their ears","فَضَرَبْنَا عَلَىٰٓ","فِى ٱلْكَهْفِ سِنِينَ",542],["18:57:21",300,"ءَاذَانِهِمْ","their ears","أَن يَفْقَهُوهُ وَفِىٓ","وَقْرًۭا ۖ وَإِن تَدْعُهُمْ",542],["20:71:6",316,"ءَاذَنَ","I gave permission","لَهُۥ قَبْلَ أَنْ","لَكُمْ ۖ إِنَّهُۥ لَكَبِيرُكُمُ",450],["20:109:7",319,"أَذِنَ","has given permission","ٱلشَّفَـٰعَةُ إِلَّا مَنْ","لَهُ ٱلرَّحْمَـٰنُ وَرَضِىَ",450],["21:109:4",331,"ءَاذَنتُكُمْ","I (have) announced to you","فَإِن تَوَلَّوْا۟ فَقُلْ","عَلَىٰ سَوَآءٍۢ ۖ وَإِنْ",2124],["22:27:1",335,"وَأَذِّن","And proclaim","","فِى ٱلنَّاسِ بِٱلْحَجِّ",1720],["22:39:1",337,"أُذِنَ","Permission is given","","لِلَّذِينَ يُقَـٰتَلُونَ بِأَنَّهُمْ",450],["22:46:11",337,"ءَاذَانٌۭ","ears","يَعْقِلُونَ بِهَآ أَوْ","يَسْمَعُونَ بِهَا ۖ فَإِنَّهَا",542],["22:65:22",340,"بِإِذْنِهِۦٓ ۗ","by His permission","عَلَى ٱلْأَرْضِ إِلَّا","إِنَّ ٱللَّهَ بِٱلنَّاسِ",298],["24:28:9",353,"يُؤْذَنَ","permission has been given","فَلَا تَدْخُلُوهَا حَتَّىٰ","لَكُمْ ۖ وَإِن قِيلَ",450],["24:36:3",354,"أَذِنَ","(which) Allah ordered","فِى بُيُوتٍ","ٱللَّهُ أَن تُرْفَعَ",450],["24:58:4",357,"لِيَسْتَـْٔذِنكُمُ","Let ask your permission","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","ٱلَّذِينَ مَلَكَتْ أَيْمَـٰنُكُمْ",755],["24:59:6",358,"فَلْيَسْتَـْٔذِنُوا۟","then let them ask permission","ٱلْأَطْفَـٰلُ مِنكُمُ ٱلْحُلُمَ","كَمَا ٱسْتَـْٔذَنَ ٱلَّذِينَ",755],["24:59:8",358,"ٱسْتَـْٔذَنَ","asked permission","ٱلْحُلُمَ فَلْيَسْتَـْٔذِنُوا۟ كَمَا","ٱلَّذِينَ مِن قَبْلِهِمْ ۚ",755],["24:62:16",359,"يَسْتَـْٔذِنُوهُ ۚ","they (have) asked his permission","لَّمْ يَذْهَبُوا۟ حَتَّىٰ","إِنَّ ٱلَّذِينَ يَسْتَـْٔذِنُونَكَ",755],["24:62:19",359,"يَسْتَـْٔذِنُونَكَ","ask your permission","يَسْتَـْٔذِنُوهُ ۚ إِنَّ ٱلَّذِينَ","أُو۟لَـٰٓئِكَ ٱلَّذِينَ يُؤْمِنُونَ",755],["24:62:26",359,"ٱسْتَـْٔذَنُوكَ","they ask your permission","بِٱللَّهِ وَرَسُولِهِۦ ۚ فَإِذَا","لِبَعْضِ شَأْنِهِمْ فَأْذَن",755],["24:62:29",359,"فَأْذَن","then give permission","ٱسْتَـْٔذَنُوكَ لِبَعْضِ شَأْنِهِمْ","لِّمَن شِئْتَ مِنْهُمْ",450],["26:49:6",369,"ءَاذَنَ","I gave permission","لَهُۥ قَبْلَ أَنْ","لَكُمْ ۖ إِنَّهُۥ لَكَبِيرُكُمُ",450],["31:7:12",411,"أُذُنَيْهِ","his ears","يَسْمَعْهَا كَأَنَّ فِىٓ","وَقْرًۭا ۖ فَبَشِّرْهُ بِعَذَابٍ",542],["33:13:11",419,"وَيَسْتَـْٔذِنُ","And asked permission","مُقَامَ لَكُمْ فَٱرْجِعُوا۟ ۚ","فَرِيقٌۭ مِّنْهُمُ ٱلنَّبِىَّ",755],["33:46:4",424,"بِإِذْنِهِۦ","by His permission","وَدَاعِيًا إِلَى ٱللَّهِ","وَسِرَاجًۭا مُّنِيرًۭا",298],["33:53:10",425,"يُؤْذَنَ","permission is given","ٱلنَّبِىِّ إِلَّآ أَن","لَكُمْ إِلَىٰ طَعَامٍ",450],["34:12:17",429,"بِإِذْنِ","by the permission","يَعْمَلُ بَيْنَ يَدَيْهِ","رَبِّهِۦ ۖ وَمَن يَزِغْ",298],["34:23:7",431,"أَذِنَ","He permits","عِندَهُۥٓ إِلَّا لِمَنْ","لَهُۥ ۚ حَتَّىٰٓ إِذَا",450],["35:32:16",438,"بِإِذْنِ","by permission","وَمِنْهُمْ سَابِقٌۢ بِٱلْخَيْرَٰتِ","ٱللَّهِ ۚ ذَٰلِكَ هُوَ",298],["40:78:22",476,"بِإِذْنِ","by (the) permission","يَأْتِىَ بِـَٔايَةٍ إِلَّا","ٱللَّهِ ۚ فَإِذَا جَآءَ",298],["41:5:9",477,"ءَاذَانِنَا","our ears","تَدْعُونَآ إِلَيْهِ وَفِىٓ","وَقْرٌۭ وَمِنۢ بَيْنِنَا",542],["41:44:21",481,"ءَاذَانِهِمْ","their ears","لَا يُؤْمِنُونَ فِىٓ","وَقْرٌۭ وَهُوَ عَلَيْهِمْ",542],["41:47:24",482,"ءَاذَنَّـٰكَ","We announce (to) You","أَيْنَ شُرَكَآءِى قَالُوٓا۟","مَا مِنَّا مِن",2124],["42:21:10",485,"يَأْذَنۢ","Allah has given permission of it","ٱلدِّينِ مَا لَمْ","بِهِ ٱللَّهُ ۚ وَلَوْلَا",450],["42:51:17",488,"بِإِذْنِهِۦ","by His permission","يُرْسِلَ رَسُولًۭا فَيُوحِىَ","مَا يَشَآءُ ۚ إِنَّهُۥ",298],["53:26:14",526,"يَأْذَنَ","Allah has given permission","مِنۢ بَعْدِ أَن","ٱللَّهُ لِمَن يَشَآءُ",450],["58:10:12",543,"بِإِذْنِ","by Allah's permission","بِضَآرِّهِمْ شَيْـًٔا إِلَّا","ٱللَّهِ ۚ وَعَلَى ٱللَّهِ",298],["59:5:10",546,"فَبِإِذْنِ","it (was) by the permission","قَآئِمَةً عَلَىٰٓ أُصُولِهَا","ٱللَّهِ وَلِيُخْزِىَ ٱلْفَـٰسِقِينَ",298],["64:11:6",557,"بِإِذْنِ","by (the) permission","مِن مُّصِيبَةٍ إِلَّا","ٱللَّهِ ۗ وَمَن يُؤْمِنۢ",298],["69:12:5",567,"أُذُنٌۭ","an ear","لَكُمْ تَذْكِرَةًۭ وَتَعِيَهَآ","وَٰعِيَةٌۭ",542],["71:7:9",570,"ءَاذَانِهِمْ","their ears","جَعَلُوٓا۟ أَصَـٰبِعَهُمْ فِىٓ","وَٱسْتَغْشَوْا۟ ثِيَابَهُمْ وَأَصَرُّوا۟",542],["77:36:2",581,"يُؤْذَنُ","will it be permitted","وَلَا","لَهُمْ فَيَعْتَذِرُونَ",450],["78:38:10",583,"أَذِنَ","permits","يَتَكَلَّمُونَ إِلَّا مَنْ","لَهُ ٱلرَّحْمَـٰنُ وَقَالَ",450],["84:2:1",589,"وَأَذِنَتْ","And has listened","","لِرَبِّهَا وَحُقَّتْ",450],["84:5:1",589,"وَأَذِنَتْ","And has listened","","لِرَبِّهَا وَحُقَّتْ",450],["97:4:5",598,"بِإِذْنِ","by (the) permission","ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ فِيهَا","رَبِّهِم مِّن كُلِّ",298]]