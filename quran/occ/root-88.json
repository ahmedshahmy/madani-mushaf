[["2:105:6",16,"أَهْلِ","(the) People","ٱلَّذِينَ كَفَرُوا۟ مِنْ","ٱلْكِتَـٰبِ وَلَا ٱلْمُشْرِكِينَ",91],["2:109:4",17,"أَهْلِ","(the) People","وَدَّ كَثِيرٌۭ مِّنْ","ٱلْكِتَـٰبِ لَوْ يَرُدُّونَكُم",91],["2:126:10",19,"أَهْلَهُۥ","its people","بَلَدًا ءَامِنًۭا وَٱرْزُقْ","مِنَ ٱلثَّمَرَٰتِ مَنْ",91],["2:196:63",30,"أَهْلُهُۥ","his family","لِمَن لَّمْ يَكُنْ","حَاضِرِى ٱلْمَسْجِدِ ٱلْحَرَامِ ۚ",91],["2:217:20",34,"أَهْلِهِۦ","its people","وَٱلْمَسْجِدِ ٱلْحَرَامِ وَإِخْرَاجُ","مِنْهُ أَكْبَرُ عِندَ",91],["3:64:2",58,"يَـٰٓأَهْلَ","O People","قُلْ","ٱلْكِتَـٰبِ تَعَالَوْا۟ إِلَىٰ",91],["3:65:1",58,"يَـٰٓأَهْلَ","O People","","ٱلْكِتَـٰبِ لِمَ تُحَآجُّونَ",91],["3:69:4",58,"أَهْلِ","(the) People","وَدَّت طَّآئِفَةٌۭ مِّنْ","ٱلْكِتَـٰبِ لَوْ يُضِلُّونَكُمْ",91],["3:70:1",58,"يَـٰٓأَهْلَ","O People","","ٱلْكِتَـٰبِ لِمَ تَكْفُرُونَ",91],["3:71:1",59,"يَـٰٓأَهْلَ","O People","","ٱلْكِتَـٰبِ لِمَ تَلْبِسُونَ",91],["3:72:4",59,"أَهْلِ","(the) People","وَقَالَت طَّآئِفَةٌۭ مِّنْ","ٱلْكِتَـٰبِ ءَامِنُوا۟ بِٱلَّذِىٓ",91],["3:75:2",59,"أَهْلِ","(the) People","۞ وَمِنْ","ٱلْكِتَـٰبِ مَنْ إِن",91],["3:98:2",62,"يَـٰٓأَهْلَ","O People","قُلْ","ٱلْكِتَـٰبِ لِمَ تَكْفُرُونَ",91],["3:99:2",62,"يَـٰٓأَهْلَ","O People","قُلْ","ٱلْكِتَـٰبِ لِمَ تَصُدُّونَ",91],["3:110:15",64,"أَهْلُ","(the) People","بِٱللَّهِ ۗ وَلَوْ ءَامَنَ","ٱلْكِتَـٰبِ لَكَانَ خَيْرًۭا",91],["3:113:4",64,"أَهْلِ","(the) People","۞ لَيْسُوا۟ سَوَآءًۭ ۗ مِّنْ","ٱلْكِتَـٰبِ أُمَّةٌۭ قَآئِمَةٌۭ",91],["3:121:4",65,"أَهْلِكَ","your household","وَإِذْ غَدَوْتَ مِنْ","تُبَوِّئُ ٱلْمُؤْمِنِينَ مَقَـٰعِدَ",91],["3:199:3",76,"أَهْلِ","(the) People","وَإِنَّ مِنْ","ٱلْكِتَـٰبِ لَمَن يُؤْمِنُ",91],["4:25:25",82,"أَهْلِهِنَّ","(of) their family","بَعْضٍۢ ۚ فَٱنكِحُوهُنَّ بِإِذْنِ","وَءَاتُوهُنَّ أُجُورَهُنَّ بِٱلْمَعْرُوفِ",91],["4:35:8",84,"أَهْلِهِۦ","his family","فَٱبْعَثُوا۟ حَكَمًۭا مِّنْ","وَحَكَمًۭا مِّنْ أَهْلِهَآ",91],["4:35:11",84,"أَهْلِهَآ","her family","أَهْلِهِۦ وَحَكَمًۭا مِّنْ","إِن يُرِيدَآ إِصْلَـٰحًۭا",91],["4:58:8",87,"أَهْلِهَا","their owners","تُؤَدُّوا۟ ٱلْأَمَـٰنَـٰتِ إِلَىٰٓ","وَإِذَا حَكَمْتُم بَيْنَ",91],["4:75:21",90,"أَهْلُهَا","(are) its people","هَـٰذِهِ ٱلْقَرْيَةِ ٱلظَّالِمِ","وَٱجْعَل لَّنَا مِن",91],["4:92:19",93,"أَهْلِهِۦٓ","his family","وَدِيَةٌۭ مُّسَلَّمَةٌ إِلَىٰٓ","إِلَّآ أَن يَصَّدَّقُوا۟ ۚ",91],["4:92:44",93,"أَهْلِهِۦ","his family","فَدِيَةٌۭ مُّسَلَّمَةٌ إِلَىٰٓ","وَتَحْرِيرُ رَقَبَةٍۢ مُّؤْمِنَةٍۢ ۖ",91],["4:123:5",98,"أَهْلِ","(of the) People","بِأَمَانِيِّكُمْ وَلَآ أَمَانِىِّ","ٱلْكِتَـٰبِ ۗ مَن يَعْمَلْ",91],["4:153:2",102,"أَهْلُ","(the) People","يَسْـَٔلُكَ","ٱلْكِتَـٰبِ أَن تُنَزِّلَ",91],["4:159:3",103,"أَهْلِ","(the) People","وَإِن مِّنْ","ٱلْكِتَـٰبِ إِلَّا لَيُؤْمِنَنَّ",91],["4:171:1",105,"يَـٰٓأَهْلَ","O People","","ٱلْكِتَـٰبِ لَا تَغْلُوا۟",91],["5:15:1",110,"يَـٰٓأَهْلَ","O People","","ٱلْكِتَـٰبِ قَدْ جَآءَكُمْ",91],["5:19:1",111,"يَـٰٓأَهْلَ","O People","","ٱلْكِتَـٰبِ قَدْ جَآءَكُمْ",91],["5:47:2",116,"أَهْلُ","(the) People","وَلْيَحْكُمْ","ٱلْإِنجِيلِ بِمَآ أَنزَلَ",91],["5:59:2",118,"يَـٰٓأَهْلَ","O People","قُلْ","ٱلْكِتَـٰبِ هَلْ تَنقِمُونَ",91],["5:65:3",119,"أَهْلَ","(the) People","وَلَوْ أَنَّ","ٱلْكِتَـٰبِ ءَامَنُوا۟ وَٱتَّقَوْا۟",91],["5:68:2",119,"يَـٰٓأَهْلَ","O People","قُلْ","ٱلْكِتَـٰبِ لَسْتُمْ عَلَىٰ",91],["5:77:2",120,"يَـٰٓأَهْلَ","O People","قُلْ","ٱلْكِتَـٰبِ لَا تَغْلُوا۟",91],["5:89:20",122,"أَهْلِيكُمْ","your families","أَوْسَطِ مَا تُطْعِمُونَ","أَوْ كِسْوَتُهُمْ أَوْ",91],["6:131:9",145,"وَأَهْلُهَا","while their people","مُهْلِكَ ٱلْقُرَىٰ بِظُلْمٍۢ","غَـٰفِلُونَ",91],["7:83:2",161,"وَأَهْلَهُۥٓ","and his family","فَأَنجَيْنَـٰهُ","إِلَّا ٱمْرَأَتَهُۥ كَانَتْ",91],["7:94:9",162,"أَهْلَهَا","its people","نَّبِىٍّ إِلَّآ أَخَذْنَآ","بِٱلْبَأْسَآءِ وَٱلضَّرَّآءِ لَعَلَّهُمْ",91],["7:96:3",163,"أَهْلَ","people","وَلَوْ أَنَّ","ٱلْقُرَىٰٓ ءَامَنُوا۟ وَٱتَّقَوْا۟",91],["7:97:2",163,"أَهْلُ","(the) people","أَفَأَمِنَ","ٱلْقُرَىٰٓ أَن يَأْتِيَهُم",91],["7:98:2",163,"أَهْلُ","(the) people","أَوَأَمِنَ","ٱلْقُرَىٰٓ أَن يَأْتِيَهُم",91],["7:100:8",163,"أَهْلِهَآ","its people","ٱلْأَرْضَ مِنۢ بَعْدِ","أَن لَّوْ نَشَآءُ",91],["7:123:17",165,"أَهْلَهَا ۖ","its people","ٱلْمَدِينَةِ لِتُخْرِجُوا۟ مِنْهَآ","فَسَوْفَ تَعْلَمُونَ",91],["9:101:7",203,"أَهْلِ","people","ٱلْأَعْرَابِ مُنَـٰفِقُونَ ۖ وَمِنْ","ٱلْمَدِينَةِ ۖ مَرَدُوا۟ عَلَى",91],["9:120:3",206,"لِأَهْلِ","(for) the people","مَا كَانَ","ٱلْمَدِينَةِ وَمَنْ حَوْلَهُم",91],["10:24:24",211,"أَهْلُهَآ","its people","زُخْرُفَهَا وَٱزَّيَّنَتْ وَظَنَّ","أَنَّهُمْ قَـٰدِرُونَ عَلَيْهَآ",91],["11:40:14",226,"وَأَهْلَكَ","and your family","كُلٍّۢ زَوْجَيْنِ ٱثْنَيْنِ","إِلَّا مَن سَبَقَ",91],["11:45:9",226,"أَهْلِى","my family","إِنَّ ٱبْنِى مِنْ","وَإِنَّ وَعْدَكَ ٱلْحَقُّ",91],["11:46:6",227,"أَهْلِكَ ۖ","your family","إِنَّهُۥ لَيْسَ مِنْ","إِنَّهُۥ عَمَلٌ غَيْرُ",91],["11:73:10",230,"أَهْلَ","people","ٱللَّهِ وَبَرَكَـٰتُهُۥ عَلَيْكُمْ","ٱلْبَيْتِ ۚ إِنَّهُۥ حَمِيدٌۭ",91],["11:81:10",230,"بِأَهْلِكَ","with your family","يَصِلُوٓا۟ إِلَيْكَ ۖ فَأَسْرِ","بِقِطْعٍۢ مِّنَ ٱلَّيْلِ",91],["11:117:7",234,"وَأَهْلُهَا","while its people","لِيُهْلِكَ ٱلْقُرَىٰ بِظُلْمٍۢ","مُصْلِحُونَ",91],["12:25:16",238,"بِأَهْلِكَ","for your wife","جَزَآءُ مَنْ أَرَادَ","سُوٓءًا إِلَّآ أَن",91],["12:26:9",238,"أَهْلِهَآ","her family","وَشَهِدَ شَاهِدٌۭ مِّنْ","إِن كَانَ قَمِيصُهُۥ",91],["12:62:12",242,"أَهْلِهِمْ","their people","إِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ","لَعَلَّهُمْ يَرْجِعُونَ",91],["12:65:17",243,"أَهْلَنَا","(for) our family","رُدَّتْ إِلَيْنَا ۖ وَنَمِيرُ","وَنَحْفَظُ أَخَانَا وَنَزْدَادُ",91],["12:88:8",246,"وَأَهْلَنَا","and our family","يَـٰٓأَيُّهَا ٱلْعَزِيزُ مَسَّنَا","ٱلضُّرُّ وَجِئْنَا بِبِضَـٰعَةٍۢ",91],["12:93:11",246,"بِأَهْلِكُمْ","your family","يَأْتِ بَصِيرًۭا وَأْتُونِى","أَجْمَعِينَ",91],["12:109:10",248,"أَهْلِ","(the) people","نُّوحِىٓ إِلَيْهِم مِّنْ","ٱلْقُرَىٰٓ ۗ أَفَلَمْ يَسِيرُوا۟",91],["15:65:2",265,"بِأَهْلِكَ","with your family","فَأَسْرِ","بِقِطْعٍۢ مِّنَ ٱلَّيْلِ",91],["15:67:2",265,"أَهْلُ","(the) people","وَجَآءَ","ٱلْمَدِينَةِ يَسْتَبْشِرُونَ",91],["16:43:10",272,"أَهْلَ","(the) people","نُّوحِىٓ إِلَيْهِمْ ۚ فَسْـَٔلُوٓا۟","ٱلذِّكْرِ إِن كُنتُمْ",91],["18:71:11",301,"أَهْلَهَا","its people","قَالَ أَخَرَقْتَهَا لِتُغْرِقَ","لَقَدْ جِئْتَ شَيْـًٔا",91],["18:77:5",302,"أَهْلَ","(to the) people","حَتَّىٰٓ إِذَآ أَتَيَآ","قَرْيَةٍ ٱسْتَطْعَمَآ أَهْلَهَا",91],["18:77:8",302,"أَهْلَهَا","(from) its people","أَهْلَ قَرْيَةٍ ٱسْتَطْعَمَآ","فَأَبَوْا۟ أَن يُضَيِّفُوهُمَا",91],["19:16:8",306,"أَهْلِهَا","her family","إِذِ ٱنتَبَذَتْ مِنْ","مَكَانًۭا شَرْقِيًّۭا",91],["19:55:3",309,"أَهْلَهُۥ","(on) his people","وَكَانَ يَأْمُرُ","بِٱلصَّلَوٰةِ وَٱلزَّكَوٰةِ وَكَانَ",91],["20:10:5",312,"لِأَهْلِهِ","to his family","رَءَا نَارًۭا فَقَالَ","ٱمْكُثُوٓا۟ إِنِّىٓ ءَانَسْتُ",91],["20:29:5",313,"أَهْلِى","my family","لِّى وَزِيرًۭا مِّنْ","",91],["20:40:28",314,"أَهْلِ","(the) people","فَلَبِثْتَ سِنِينَ فِىٓ","مَدْيَنَ ثُمَّ جِئْتَ",91],["20:132:2",321,"أَهْلَكَ","(on) your family","وَأْمُرْ","بِٱلصَّلَوٰةِ وَٱصْطَبِرْ عَلَيْهَا ۖ",91],["21:7:9",322,"أَهْلَ","(the) people","نُّوحِىٓ إِلَيْهِمْ ۖ فَسْـَٔلُوٓا۟","ٱلذِّكْرِ إِن كُنتُمْ",91],["21:76:9",328,"وَأَهْلَهُۥ","and his family","فَٱسْتَجَبْنَا لَهُۥ فَنَجَّيْنَـٰهُ","مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ",91],["21:84:9",329,"أَهْلَهُۥ","his family","مِن ضُرٍّۢ ۖ وَءَاتَيْنَـٰهُ","وَمِثْلَهُم مَّعَهُمْ رَحْمَةًۭ",91],["23:27:19",343,"وَأَهْلَكَ","and your family","كُلٍّۢ زَوْجَيْنِ ٱثْنَيْنِ","إِلَّا مَن سَبَقَ",91],["24:27:13",352,"أَهْلِهَا ۚ","its inhabitants","تَسْتَأْنِسُوا۟ وَتُسَلِّمُوا۟ عَلَىٰٓ","ذَٰلِكُمْ خَيْرٌۭ لَّكُمْ",91],["26:169:3",374,"وَأَهْلِى","and my family","رَبِّ نَجِّنِى","مِمَّا يَعْمَلُونَ",91],["26:170:2",374,"وَأَهْلَهُۥٓ","and his family","فَنَجَّيْنَـٰهُ","أَجْمَعِينَ",91],["27:7:4",377,"لِأَهْلِهِۦٓ","to his family","إِذْ قَالَ مُوسَىٰ","إِنِّىٓ ءَانَسْتُ نَارًۭا",91],["27:34:10",379,"أَهْلِهَآ","(of) its people","أَفْسَدُوهَا وَجَعَلُوٓا۟ أَعِزَّةَ","أَذِلَّةًۭ ۖ وَكَذَٰلِكَ يَفْعَلُونَ",91],["27:49:5",381,"وَأَهْلَهُۥ","and his family","تَقَاسَمُوا۟ بِٱللَّهِ لَنُبَيِّتَنَّهُۥ","ثُمَّ لَنَقُولَنَّ لِوَلِيِّهِۦ",91],["27:49:12",381,"أَهْلِهِۦ","(of) his family","مَا شَهِدْنَا مَهْلِكَ","وَإِنَّا لَصَـٰدِقُونَ",91],["27:57:2",382,"وَأَهْلَهُۥٓ","and his family","فَأَنجَيْنَـٰهُ","إِلَّا ٱمْرَأَتَهُۥ قَدَّرْنَـٰهَا",91],["28:4:7",385,"أَهْلَهَا","its people","فِى ٱلْأَرْضِ وَجَعَلَ","شِيَعًۭا يَسْتَضْعِفُ طَآئِفَةًۭ",91],["28:12:10",386,"أَهْلِ","(the) people","هَلْ أَدُلُّكُمْ عَلَىٰٓ","بَيْتٍۢ يَكْفُلُونَهُۥ لَكُمْ",91],["28:15:7",387,"أَهْلِهَا","its people","حِينِ غَفْلَةٍۢ مِّنْ","فَوَجَدَ فِيهَا رَجُلَيْنِ",91],["28:29:6",389,"بِأَهْلِهِۦٓ","with his family","مُوسَى ٱلْأَجَلَ وَسَارَ","ءَانَسَ مِن جَانِبِ",91],["28:29:13",389,"لِأَهْلِهِ","to his family","ٱلطُّورِ نَارًۭا قَالَ","ٱمْكُثُوٓا۟ إِنِّىٓ ءَانَسْتُ",91],["28:45:11",391,"أَهْلِ","(the) people","كُنتَ ثَاوِيًۭا فِىٓ","مَدْيَنَ تَتْلُوا۟ عَلَيْهِمْ",91],["28:59:19",392,"وَأَهْلُهَا","while their people","مُهْلِكِى ٱلْقُرَىٰٓ إِلَّا","ظَـٰلِمُونَ",91],["29:31:9",400,"أَهْلِ","(the) people","قَالُوٓا۟ إِنَّا مُهْلِكُوٓا۟","هَـٰذِهِ ٱلْقَرْيَةِ ۖ إِنَّ",91],["29:31:13",400,"أَهْلَهَا","its people","هَـٰذِهِ ٱلْقَرْيَةِ ۖ إِنَّ","كَانُوا۟ ظَـٰلِمِينَ",91],["29:32:11",400,"وَأَهْلَهُۥٓ","and his family","بِمَن فِيهَا ۖ لَنُنَجِّيَنَّهُۥ","إِلَّا ٱمْرَأَتَهُۥ كَانَتْ",91],["29:33:18",400,"وَأَهْلَكَ","and your family","تَحْزَنْ ۖ إِنَّا مُنَجُّوكَ","إِلَّا ٱمْرَأَتَكَ كَانَتْ",91],["29:34:4",400,"أَهْلِ","(the) people","إِنَّا مُنزِلُونَ عَلَىٰٓ","هَـٰذِهِ ٱلْقَرْيَةِ رِجْزًۭا",91],["29:46:3",402,"أَهْلَ","(with the) People of the Book","۞ وَلَا تُجَـٰدِلُوٓا۟","ٱلْكِتَـٰبِ إِلَّا بِٱلَّتِى",91],["33:13:5",419,"يَـٰٓأَهْلَ","O People","قَالَت طَّآئِفَةٌۭ مِّنْهُمْ","يَثْرِبَ لَا مُقَامَ",91],["33:26:5",421,"أَهْلِ","(the) People","ٱلَّذِينَ ظَـٰهَرُوهُم مِّنْ","ٱلْكِتَـٰبِ مِن صَيَاصِيهِمْ",91],["33:33:22",422,"أَهْلَ","(O) People","لِيُذْهِبَ عَنكُمُ ٱلرِّجْسَ","ٱلْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًۭا",91],["35:43:11",439,"بِأَهْلِهِۦ ۚ","its own people","ٱلْمَكْرُ ٱلسَّيِّئُ إِلَّا","فَهَلْ يَنظُرُونَ إِلَّا",91],["36:50:6",443,"أَهْلِهِمْ","their people","تَوْصِيَةًۭ وَلَآ إِلَىٰٓ","يَرْجِعُونَ",91],["37:76:2",448,"وَأَهْلَهُۥ","and his family","وَنَجَّيْنَـٰهُ","مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ",91],["37:134:3",451,"وَأَهْلَهُۥٓ","and his family","إِذْ نَجَّيْنَـٰهُ","أَجْمَعِينَ",91],["38:43:3",456,"أَهْلَهُۥ","his family","وَوَهَبْنَا لَهُۥٓ","وَمِثْلَهُم مَّعَهُمْ رَحْمَةًۭ",91],["38:64:5",457,"أَهْلِ","(of the) people","ذَٰلِكَ لَحَقٌّۭ تَخَاصُمُ","ٱلنَّارِ",91],["39:15:12",460,"وَأَهْلِيهِمْ","and their families","ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُمْ","يَوْمَ ٱلْقِيَـٰمَةِ ۗ أَلَا",91],["42:45:19",488,"وَأَهْلِيهِمْ","and their families","ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُمْ","يَوْمَ ٱلْقِيَـٰمَةِ ۗ أَلَآ",91],["48:11:8",512,"وَأَهْلُونَا","and our families","ٱلْأَعْرَابِ شَغَلَتْنَآ أَمْوَٰلُنَا","فَٱسْتَغْفِرْ لَنَا ۚ يَقُولُونَ",91],["48:12:9",512,"أَهْلِيهِمْ","their families","ٱلرَّسُولُ وَٱلْمُؤْمِنُونَ إِلَىٰٓ","أَبَدًۭا وَزُيِّنَ ذَٰلِكَ",91],["48:26:23",514,"وَأَهْلَهَا ۚ","and worthy of it","وَكَانُوٓا۟ أَحَقَّ بِهَا","وَكَانَ ٱللَّهُ بِكُلِّ",91],["51:26:3",521,"أَهْلِهِۦ","his household","فَرَاغَ إِلَىٰٓ","فَجَآءَ بِعِجْلٍۢ سَمِينٍۢ",91],["52:26:6",524,"أَهْلِنَا","our families","كُنَّا قَبْلُ فِىٓ","مُشْفِقِينَ",91],["57:29:3",541,"أَهْلُ","(the) People","لِّئَلَّا يَعْلَمَ","ٱلْكِتَـٰبِ أَلَّا يَقْدِرُونَ",91],["59:2:7",545,"أَهْلِ","(the) People","ٱلَّذِينَ كَفَرُوا۟ مِنْ","ٱلْكِتَـٰبِ مِن دِيَـٰرِهِمْ",91],["59:7:7",546,"أَهْلِ","(the) people","عَلَىٰ رَسُولِهِۦ مِنْ","ٱلْقُرَىٰ فَلِلَّهِ وَلِلرَّسُولِ",91],["59:11:11",547,"أَهْلِ","the People","ٱلَّذِينَ كَفَرُوا۟ مِنْ","ٱلْكِتَـٰبِ لَئِنْ أُخْرِجْتُمْ",91],["66:6:6",560,"وَأَهْلِيكُمْ","and your families","ءَامَنُوا۟ قُوٓا۟ أَنفُسَكُمْ","نَارًۭا وَقُودُهَا ٱلنَّاسُ",91],["74:56:8",577,"أَهْلُ","(is) worthy","يَشَآءَ ٱللَّهُ ۚ هُوَ","ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ",91],["74:56:10",577,"وَأَهْلُ","and worthy","هُوَ أَهْلُ ٱلتَّقْوَىٰ","ٱلْمَغْفِرَةِ",91],["75:33:4",578,"أَهْلِهِۦ","his family","ثُمَّ ذَهَبَ إِلَىٰٓ","يَتَمَطَّىٰٓ",91],["83:31:4",588,"أَهْلِهِمُ","their people","وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ","ٱنقَلَبُوا۟ فَكِهِينَ",91],["84:9:3",589,"أَهْلِهِۦ","his people","وَيَنقَلِبُ إِلَىٰٓ","مَسْرُورًۭا",91],["84:13:4",589,"أَهْلِهِۦ","his people","إِنَّهُۥ كَانَ فِىٓ","مَسْرُورًا",91],["98:1:6",598,"أَهْلِ","(the) People","ٱلَّذِينَ كَفَرُوا۟ مِنْ","ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ",91],["98:6:5",599,"أَهْلِ","(the) People","ٱلَّذِينَ كَفَرُوا۟ مِنْ","ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ فِى",91]]