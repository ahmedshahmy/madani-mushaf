[["36:51:7",443,"ٱلْأَجْدَاثِ","the graves","فَإِذَا هُم مِّنَ","إِلَىٰ رَبِّهِمْ يَنسِلُونَ",1734],["54:7:5",529,"ٱلْأَجْدَاثِ","the graves","أَبْصَـٰرُهُمْ يَخْرُجُونَ مِنَ","كَأَنَّهُمْ جَرَادٌۭ مُّنتَشِرٌۭ",1734],["70:43:4",570,"ٱلْأَجْدَاثِ","the graves","يَوْمَ يَخْرُجُونَ مِنَ","سِرَاعًۭا كَأَنَّهُمْ إِلَىٰ",1734]]