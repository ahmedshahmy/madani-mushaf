[["2:51:2",8,"وَٰعَدْنَا","We appointed","وَإِذْ","مُوسَىٰٓ أَرْبَعِينَ لَيْلَةًۭ",1656],["2:235:20",38,"تُوَاعِدُوهُنَّ","promise them (widows)","سَتَذْكُرُونَهُنَّ وَلَـٰكِن لَّا","سِرًّا إِلَّآ أَن",1656],["2:268:2",45,"يَعِدُكُمُ","promises you","ٱلشَّيْطَـٰنُ","ٱلْفَقْرَ وَيَأْمُرُكُم بِٱلْفَحْشَآءِ ۖ",176],["2:268:7",45,"يَعِدُكُم","promises you","وَيَأْمُرُكُم بِٱلْفَحْشَآءِ ۖ وَٱللَّهُ","مَّغْفِرَةًۭ مِّنْهُ وَفَضْلًۭا ۗ",176],["3:9:13",50,"ٱلْمِيعَادَ","the Promise","ٱللَّهَ لَا يُخْلِفُ","",1208],["3:152:4",69,"وَعْدَهُۥٓ","His promise","وَلَقَدْ صَدَقَكُمُ ٱللَّهُ","إِذْ تَحُسُّونَهُم بِإِذْنِهِۦ ۖ",245],["3:194:4",75,"وَعَدتَّنَا","You promised us","رَبَّنَا وَءَاتِنَا مَا","عَلَىٰ رُسُلِكَ وَلَا",176],["3:194:14",75,"ٱلْمِيعَادَ","the promise","إِنَّكَ لَا تُخْلِفُ","",1208],["4:95:24",94,"وَعَدَ","promised","ٱلْقَـٰعِدِينَ دَرَجَةًۭ ۚ وَكُلًّۭا","ٱللَّهُ ٱلْحُسْنَىٰ ۚ وَفَضَّلَ",176],["4:120:1",97,"يَعِدُهُمْ","He promises them","","وَيُمَنِّيهِمْ ۖ وَمَا يَعِدُهُمُ",176],["4:120:4",97,"يَعِدُهُمُ","promises them","يَعِدُهُمْ وَيُمَنِّيهِمْ ۖ وَمَا","ٱلشَّيْطَـٰنُ إِلَّا غُرُورًا",176],["4:122:14",98,"وَعْدَ","A Promise","خَـٰلِدِينَ فِيهَآ أَبَدًۭا ۖ","ٱللَّهِ حَقًّۭا ۚ وَمَنْ",245],["5:9:1",108,"وَعَدَ","Has promised","","ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟",176],["6:134:3",145,"تُوعَدُونَ","you are promised","إِنَّ مَا","لَـَٔاتٍۢ ۖ وَمَآ أَنتُم",176],["7:44:10",156,"وَعَدَنَا","(had) promised us","قَدْ وَجَدْنَا مَا","رَبُّنَا حَقًّۭا فَهَلْ",176],["7:44:16",156,"وَعَدَ","(was) promised","فَهَلْ وَجَدتُّم مَّا","رَبُّكُمْ حَقًّۭا ۖ قَالُوا۟",176],["7:70:13",159,"تَعِدُنَآ","you promise us","ءَابَآؤُنَا ۖ فَأْتِنَا بِمَا","إِن كُنتَ مِنَ",176],["7:77:11",160,"تَعِدُنَآ","you promise us","يَـٰصَـٰلِحُ ٱئْتِنَا بِمَا","إِن كُنتَ مِنَ",176],["7:86:5",161,"تُوعِدُونَ","threatening","تَقْعُدُوا۟ بِكُلِّ صِرَٰطٍۢ","وَتَصُدُّونَ عَن سَبِيلِ",4472],["7:142:1",167,"۞ وَوَٰعَدْنَا","And We appointed","","مُوسَىٰ ثَلَـٰثِينَ لَيْلَةًۭ",1656],["8:7:2",177,"يَعِدُكُمُ","promised you","وَإِذْ","ٱللَّهُ إِحْدَى ٱلطَّآئِفَتَيْنِ",176],["8:42:12",182,"تَوَاعَدتُّمْ","you (had) made an appointment","أَسْفَلَ مِنكُمْ ۚ وَلَوْ","لَٱخْتَلَفْتُمْ فِى ٱلْمِيعَـٰدِ ۙ",4430],["8:42:15",182,"ٱلْمِيعَـٰدِ ۙ","the appointment","تَوَاعَدتُّمْ لَٱخْتَلَفْتُمْ فِى","وَلَـٰكِن لِّيَقْضِىَ ٱللَّهُ",1208],["9:68:1",197,"وَعَدَ","Allah has promised","","ٱللَّهُ ٱلْمُنَـٰفِقِينَ وَٱلْمُنَـٰفِقَـٰتِ",176],["9:72:1",198,"وَعَدَ","(Has been) promised","","ٱللَّهُ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ",176],["9:77:12",199,"وَعَدُوهُ","they had promised Him","أَخْلَفُوا۟ ٱللَّهَ مَا","وَبِمَا كَانُوا۟ يَكْذِبُونَ",176],["9:111:17",204,"وَعْدًا","A promise","ٱللَّهِ فَيَقْتُلُونَ وَيُقْتَلُونَ ۖ","عَلَيْهِ حَقًّۭا فِى",245],["9:114:8",205,"مَّوْعِدَةٍۢ","(of) a promise","لِأَبِيهِ إِلَّا عَن","وَعَدَهَآ إِيَّاهُ فَلَمَّا",3937],["9:114:9",205,"وَعَدَهَآ","he had promised it","إِلَّا عَن مَّوْعِدَةٍۢ","إِيَّاهُ فَلَمَّا تَبَيَّنَ",176],["10:4:4",208,"وَعْدَ","Promise","إِلَيْهِ مَرْجِعُكُمْ جَمِيعًۭا ۖ","ٱللَّهِ حَقًّا ۚ إِنَّهُۥ",245],["10:46:5",214,"نَعِدُهُمْ","We promised them","نُرِيَنَّكَ بَعْضَ ٱلَّذِى","أَوْ نَتَوَفَّيَنَّكَ فَإِلَيْنَا",176],["10:48:4",214,"ٱلْوَعْدُ","the promise (be fulfilled)","وَيَقُولُونَ مَتَىٰ هَـٰذَا","إِن كُنتُمْ صَـٰدِقِينَ",245],["10:55:10",215,"وَعْدَ","(the) Promise of Allah","وَٱلْأَرْضِ ۗ أَلَآ إِنَّ","ٱللَّهِ حَقٌّۭ وَلَـٰكِنَّ",245],["11:17:25",223,"مَوْعِدُهُۥ ۚ","(will be) his promised (meeting) place","مِنَ ٱلْأَحْزَابِ فَٱلنَّارُ","فَلَا تَكُ فِى",736],["11:32:9",225,"تَعِدُنَآ","you threaten us (with)","جِدَٰلَنَا فَأْتِنَا بِمَا","إِن كُنتَ مِنَ",176],["11:45:11",226,"وَعْدَكَ","Your promise","مِنْ أَهْلِى وَإِنَّ","ٱلْحَقُّ وَأَنتَ أَحْكَمُ",245],["11:65:9",229,"وَعْدٌ","(is) a promise","ثَلَـٰثَةَ أَيَّامٍۢ ۖ ذَٰلِكَ","غَيْرُ مَكْذُوبٍۢ",245],["11:81:25",230,"مَوْعِدَهُمُ","their appointed time","مَآ أَصَابَهُمْ ۚ إِنَّ","ٱلصُّبْحُ ۚ أَلَيْسَ ٱلصُّبْحُ",736],["13:31:45",253,"وَعْدُ","(the) promise","دَارِهِمْ حَتَّىٰ يَأْتِىَ","ٱللَّهِ ۚ إِنَّ ٱللَّهَ",245],["13:31:51",253,"ٱلْمِيعَادَ","(in) the Promise","ٱللَّهَ لَا يُخْلِفُ","",1208],["13:35:4",254,"وُعِدَ","(is) promised","۞ مَّثَلُ ٱلْجَنَّةِ ٱلَّتِى","ٱلْمُتَّقُونَ ۖ تَجْرِى مِن",176],["13:40:6",254,"نَعِدُهُمْ","We have promised them","نُرِيَنَّكَ بَعْضَ ٱلَّذِى","أَوْ نَتَوَفَّيَنَّكَ فَإِنَّمَا",176],["14:14:10",257,"وَعِيدِ","My Threat","خَافَ مَقَامِى وَخَافَ","",1241],["14:22:8",258,"وَعَدَكُمْ","promised you","ٱلْأَمْرُ إِنَّ ٱللَّهَ","وَعْدَ ٱلْحَقِّ وَوَعَدتُّكُمْ",176],["14:22:9",258,"وَعْدَ","a promise","إِنَّ ٱللَّهَ وَعَدَكُمْ","ٱلْحَقِّ وَوَعَدتُّكُمْ فَأَخْلَفْتُكُمْ ۖ",245],["14:22:11",258,"وَوَعَدتُّكُمْ","And I promised you","وَعَدَكُمْ وَعْدَ ٱلْحَقِّ","فَأَخْلَفْتُكُمْ ۖ وَمَا كَانَ",176],["14:47:5",261,"وَعْدِهِۦ","(to) keep His Promise","تَحْسَبَنَّ ٱللَّهَ مُخْلِفَ","رُسُلَهُۥٓ ۗ إِنَّ ٱللَّهَ",245],["15:43:3",264,"لَمَوْعِدُهُمْ","(is) surely the promised place for them","وَإِنَّ جَهَنَّمَ","أَجْمَعِينَ",736],["16:38:11",271,"وَعْدًا","(it is) a promise","مَن يَمُوتُ ۚ بَلَىٰ","عَلَيْهِ حَقًّۭا وَلَـٰكِنَّ",245],["17:5:3",282,"وَعْدُ","(the) promise","فَإِذَا جَآءَ","أُولَىٰهُمَا بَعَثْنَا عَلَيْكُمْ",245],["17:5:16",282,"وَعْدًۭا","a promise","خِلَـٰلَ ٱلدِّيَارِ ۚ وَكَانَ","مَّفْعُولًۭا",245],["17:7:10",282,"وَعْدُ","promise","فَلَهَا ۚ فَإِذَا جَآءَ","ٱلْـَٔاخِرَةِ لِيَسُـۥٓـُٔوا۟ وُجُوهَكُمْ",245],["17:64:14",288,"وَعِدْهُمْ ۚ","and promise them","فِى ٱلْأَمْوَٰلِ وَٱلْأَوْلَـٰدِ","وَمَا يَعِدُهُمُ ٱلشَّيْطَـٰنُ",176],["17:64:16",288,"يَعِدُهُمُ","promises them","وَٱلْأَوْلَـٰدِ وَعِدْهُمْ ۚ وَمَا","ٱلشَّيْطَـٰنُ إِلَّا غُرُورًا",176],["17:104:10",292,"وَعْدُ","(the) promise","ٱلْأَرْضَ فَإِذَا جَآءَ","ٱلْـَٔاخِرَةِ جِئْنَا بِكُمْ",245],["17:108:6",293,"وَعْدُ","(the) promise","رَبِّنَآ إِن كَانَ","رَبِّنَا لَمَفْعُولًۭا",245],["18:21:6",296,"وَعْدَ","(the) Promise","عَلَيْهِمْ لِيَعْلَمُوٓا۟ أَنَّ","ٱللَّهِ حَقٌّۭ وَأَنَّ",245],["18:48:16",299,"مَّوْعِدًۭا","an appointment","أَلَّن نَّجْعَلَ لَكُم","",736],["18:58:14",300,"مَّوْعِدٌۭ","(is) an appointment","ٱلْعَذَابَ ۚ بَل لَّهُم","لَّن يَجِدُوا۟ مِن",736],["18:59:8",300,"مَّوْعِدًۭا","an appointed time","ظَلَمُوا۟ وَجَعَلْنَا لِمَهْلِكِهِم","",736],["18:98:8",304,"وَعْدُ","(the) Promise","رَّبِّى ۖ فَإِذَا جَآءَ","رَبِّى جَعَلَهُۥ دَكَّآءَ ۖ",245],["18:98:13",304,"وَعْدُ","(the) Promise","جَعَلَهُۥ دَكَّآءَ ۖ وَكَانَ","رَبِّى حَقًّۭا",245],["19:54:8",309,"ٱلْوَعْدِ","(to his) promise","إِنَّهُۥ كَانَ صَادِقَ","وَكَانَ رَسُولًۭا نَّبِيًّۭا",245],["19:61:4",309,"وَعَدَ","promised","جَنَّـٰتِ عَدْنٍ ٱلَّتِى","ٱلرَّحْمَـٰنُ عِبَادَهُۥ بِٱلْغَيْبِ ۚ",176],["19:61:10",309,"وَعْدُهُۥ","His promise","بِٱلْغَيْبِ ۚ إِنَّهُۥ كَانَ","مَأْتِيًّۭا",245],["19:75:14",310,"يُوعَدُونَ","they were promised","إِذَا رَأَوْا۟ مَا","إِمَّا ٱلْعَذَابَ وَإِمَّا",176],["20:58:7",315,"مَوْعِدًۭا","an appointment","فَٱجْعَلْ بَيْنَنَا وَبَيْنَكَ","لَّا نُخْلِفُهُۥ نَحْنُ",736],["20:59:2",315,"مَوْعِدُكُمْ","Your appointment","قَالَ","يَوْمُ ٱلزِّينَةِ وَأَن",736],["20:80:7",317,"وَوَٰعَدْنَـٰكُمْ","and We made a covenant with you","أَنجَيْنَـٰكُم مِّنْ عَدُوِّكُمْ","جَانِبَ ٱلطُّورِ ٱلْأَيْمَنَ",1656],["20:86:10",317,"يَعِدْكُمْ","promise you","قَالَ يَـٰقَوْمِ أَلَمْ","رَبُّكُمْ وَعْدًا حَسَنًا ۚ",176],["20:86:12",317,"وَعْدًا","a promise","أَلَمْ يَعِدْكُمْ رَبُّكُمْ","حَسَنًا ۚ أَفَطَالَ عَلَيْكُمُ",245],["20:86:26",317,"مَّوْعِدِى","(the) promise to me","مِّن رَّبِّكُمْ فَأَخْلَفْتُم","",736],["20:87:4",317,"مَوْعِدَكَ","promise to you","قَالُوا۟ مَآ أَخْلَفْنَا","بِمَلْكِنَا وَلَـٰكِنَّا حُمِّلْنَآ",736],["20:97:13",318,"مَوْعِدًۭا","(is) an appointment","مِسَاسَ ۖ وَإِنَّ لَكَ","لَّن تُخْلَفَهُۥ ۖ وَٱنظُرْ",736],["20:113:8",319,"ٱلْوَعِيدِ","the warnings","وَصَرَّفْنَا فِيهِ مِنَ","لَعَلَّهُمْ يَتَّقُونَ أَوْ",1241],["21:9:3",322,"ٱلْوَعْدَ","the promise","ثُمَّ صَدَقْنَـٰهُمُ","فَأَنجَيْنَـٰهُمْ وَمَن نَّشَآءُ",245],["21:38:4",325,"ٱلْوَعْدُ","promise","وَيَقُولُونَ مَتَىٰ هَـٰذَا","إِن كُنتُمْ 