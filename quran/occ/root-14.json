[["2:39:4",7,"بِـَٔايَـٰتِنَآ","Our Signs","وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟","أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ ۖ",28],["2:41:14",7,"بِـَٔايَـٰتِى","My Signs (for)","بِهِۦ ۖ وَلَا تَشْتَرُوا۟","ثَمَنًۭا قَلِيلًۭا وَإِيَّـٰىَ",28],["2:61:49",9,"بِـَٔايَـٰتِ","in (the) Signs","بِأَنَّهُمْ كَانُوا۟ يَكْفُرُونَ","ٱللَّهِ وَيَقْتُلُونَ ٱلنَّبِيِّـۧنَ",28],["2:73:9",11,"ءَايَـٰتِهِۦ","His Signs","ٱللَّهُ ٱلْمَوْتَىٰ وَيُرِيكُمْ","لَعَلَّكُمْ تَعْقِلُونَ",28],["2:99:4",15,"ءَايَـٰتٍۭ","Verses","وَلَقَدْ أَنزَلْنَآ إِلَيْكَ","بَيِّنَـٰتٍۢ ۖ وَمَا يَكْفُرُ",28],["2:106:4",17,"ءَايَةٍ","a sign","۞ مَا نَنسَخْ مِنْ","أَوْ نُنسِهَا نَأْتِ",28],["2:118:10",18,"ءَايَةٌۭ ۗ","a sign","ٱللَّهُ أَوْ تَأْتِينَآ","كَذَٰلِكَ قَالَ ٱلَّذِينَ",28],["2:118:22",18,"ٱلْـَٔايَـٰتِ","the signs","قُلُوبُهُمْ ۗ قَدْ بَيَّنَّا","لِقَوْمٍۢ يُوقِنُونَ",28],["2:129:8",20,"ءَايَـٰتِكَ","Your Verses","مِّنْهُمْ يَتْلُوا۟ عَلَيْهِمْ","وَيُعَلِّمُهُمُ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ",28],["2:145:7",22,"ءَايَةٍۢ","(the) signs","أُوتُوا۟ ٱلْكِتَـٰبَ بِكُلِّ","مَّا تَبِعُوا۟ قِبْلَتَكَ ۚ",28],["2:151:8",23,"ءَايَـٰتِنَا","Our verses","مِّنكُمْ يَتْلُوا۟ عَلَيْكُمْ","وَيُزَكِّيكُمْ وَيُعَلِّمُكُمُ ٱلْكِتَـٰبَ",28],["2:164:41",25,"لَـَٔايَـٰتٍۢ","surely (are) Signs","بَيْنَ ٱلسَّمَآءِ وَٱلْأَرْضِ","لِّقَوْمٍۢ يَعْقِلُونَ",28],["2:187:62",29,"ءَايَـٰتِهِۦ","His verses","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ","لِلنَّاسِ لَعَلَّهُمْ يَتَّقُونَ",28],["2:211:7",33,"ءَايَةٍۭ","(the) Sign(s)","كَمْ ءَاتَيْنَـٰهُم مِّنْ","بَيِّنَةٍۢ ۗ وَمَن يُبَدِّلْ",28],["2:219:24",34,"ٱلْـَٔايَـٰتِ","[the] Verses","يُبَيِّنُ ٱللَّهُ لَكُمُ","لَعَلَّكُمْ تَتَفَكَّرُونَ",28],["2:221:36",35,"ءَايَـٰتِهِۦ","His Verses","وَٱلْمَغْفِرَةِ بِإِذْنِهِۦ ۖ وَيُبَيِّنُ","لِلنَّاسِ لَعَلَّهُمْ يَتَذَكَّرُونَ",28],["2:231:23",37,"ءَايَـٰتِ","(the) Verses","نَفْسَهُۥ ۚ وَلَا تَتَّخِذُوٓا۟","ٱللَّهِ هُزُوًۭا ۚ وَٱذْكُرُوا۟",28],["2:242:5",39,"ءَايَـٰتِهِۦ","His Verses","يُبَيِّنُ ٱللَّهُ لَكُمْ","لَعَلَّكُمْ تَعْقِلُونَ",28],["2:248:5",40,"ءَايَةَ","a si