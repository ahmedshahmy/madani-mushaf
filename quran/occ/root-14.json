Sign","وَمَا تَأْتِيهِم مِّنْ","مِّنْ ءَايَـٰتِ رَبِّهِمْ",28],["36:46:6",443,"ءَايَـٰتِ","(the) Signs","مِّنْ ءَايَةٍۢ مِّنْ","رَبِّهِمْ إِلَّا كَانُوا۟",28],["37:14:3",446,"ءَايَةًۭ","a Sign","وَإِذَا رَأَوْا۟","يَسْتَسْخِرُونَ",28],["38:29:6",455,"ءَايَـٰتِهِۦ","(over) its Verses","إِلَيْكَ مُبَـٰرَكٌۭ لِّيَدَّبَّرُوٓا۟","وَلِيَتَذَكَّرَ أُو۟لُوا۟ ٱلْأَلْبَـٰبِ",28],["39:42:24",463,"لَـَٔايَـٰتٍۢ","surely (are) signs","إِنَّ فِى ذَٰلِكَ","لِّقَوْمٍۢ يَتَفَكَّرُونَ",28],["39:52:13",464,"لَـَٔايَـٰتٍۢ","surely (are) signs","إِنَّ فِى ذَٰلِكَ","لِّقَوْمٍۢ يُؤْمِنُونَ",28],["39:59:4",465,"ءَايَـٰتِى","My Verses","بَلَىٰ قَدْ جَآءَتْكَ","فَكَذَّبْتَ بِهَا وَٱسْتَكْبَرْتَ",28],["39:63:7",465,"بِـَٔايَـٰتِ","in (the) Verses","وَٱلْأَرْضِ ۗ وَٱلَّذِينَ كَفَرُوا۟","ٱللَّهِ أُو۟لَـٰٓئِكَ هُمُ",28],["39:71:21",466,"ءَايَـٰتِ","(the) Verses","مِّنكُمْ يَتْلُونَ عَلَيْكُمْ","رَبِّكُمْ وَيُنذِرُونَكُمْ لِقَآءَ",28],["40:4:4",467,"ءَايَـٰتِ","(the) Verses","مَا يُجَـٰدِلُ فِىٓ","ٱللَّهِ إِلَّا ٱلَّذِينَ",28],["40:13:4",468,"ءَايَـٰتِهِۦ","His Signs","هُوَ ٱلَّذِى يُرِيكُمْ","وَيُنَزِّلُ لَكُم مِّنَ",28],["40:23:4",469,"بِـَٔايَـٰتِنَا","with Our Signs","وَلَقَدْ أَرْسَلْنَا مُوسَىٰ","وَسُلْطَـٰنٍۢ مُّبِينٍ",28],["40:35:4",471,"ءَايَـٰتِ","(the) Signs","ٱلَّذِينَ يُجَـٰدِلُونَ فِىٓ","ٱللَّهِ بِغَيْرِ سُلْطَـٰنٍ",28],["40:56:5",473,"ءَايَـٰتِ","(the) Signs","ٱلَّذِينَ يُجَـٰدِلُونَ فِىٓ","ٱللَّهِ بِغَيْرِ سُلْطَـٰنٍ",28],["40:63:5",474,"بِـَٔايَـٰتِ","(the) Signs","يُؤْفَكُ ٱلَّذِينَ كَانُوا۟","ٱللَّهِ يَجْحَدُونَ",28],["40:69:7",475,"ءَايَـٰتِ","(the) Signs","ٱلَّذِينَ يُجَـٰدِلُونَ فِىٓ","ٱللَّهِ أَنَّىٰ يُصْرَفُونَ",28],["40:78:20",476,"بِـَٔايَةٍ","a Sign","لِرَسُولٍ أَن يَأْتِىَ","إِلَّا بِإِذْنِ ٱللَّهِ ۚ",28],["40:81:2",476,"ءَايَـٰتِهِۦ","His Signs","وَيُرِيكُمْ","فَأَىَّ ءَايَـٰتِ ٱللَّهِ",28],["40:81:4",476,"ءَايَـٰتِ","(of the) Signs","وَيُرِيكُمْ ءَايَـٰتِهِۦ فَأَىَّ","ٱللَّهِ تُنكِرُونَ",28],["41:3:3",477,"ءَايَـٰتُهُۥ","its Verses","كِتَـٰبٌۭ فُصِّلَتْ","قُرْءَانً