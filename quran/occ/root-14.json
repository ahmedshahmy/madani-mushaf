ِكُمْ",28],["13:3:22",249,"لَـَٔايَـٰتٍۢ","surely (are) Signs","إِنَّ فِى ذَٰلِكَ","لِّقَوْمٍۢ يَتَفَكَّرُونَ",28],["13:4:25",249,"لَـَٔايَـٰتٍۢ","surely (are) Signs","إِنَّ فِى ذَٰلِكَ","لِّقَوْمٍۢ يَعْقِلُونَ",28],["13:7:7",250,"ءَايَةٌۭ","a sign","لَوْلَآ أُنزِلَ عَلَيْهِ","مِّن رَّبِّهِۦٓ ۗ إِنَّمَآ",28],["13:27:7",252,"ءَايَةٌۭ","a Sign","لَوْلَآ أُنزِلَ عَلَيْهِ","مِّن رَّبِّهِۦ ۗ قُلْ",28],["13:38:15",254,"بِـَٔايَةٍ","with a sign","لِرَسُولٍ أَن يَأْتِىَ","إِلَّا بِإِذْنِ ٱللَّهِ ۗ",28],["14:5:4",255,"بِـَٔايَـٰتِنَآ","with Our Signs","وَلَقَدْ أَرْسَلْنَا مُوسَىٰ","أَنْ أَخْرِجْ قَوْمَكَ",28],["14:5:18",255,"لَـَٔايَـٰتٍۢ","surely (are) the signs","إِنَّ فِى ذَٰلِكَ","لِّكُلِّ صَبَّارٍۢ شَكُورٍۢ",28],["15:1:3",262,"ءَايَـٰتُ","(are) the Verses","الٓر ۚ تِلْكَ","ٱلْكِتَـٰبِ وَقُرْءَانٍۢ مُّبِينٍۢ",28],["15:75:4",266,"لَـَٔايَـٰتٍۢ","(are) the Signs","إِنَّ فِى ذَٰلِكَ","لِّلْمُتَوَسِّمِينَ",28],["15:77:4",266,"لَـَٔايَةًۭ","surely (is) a Sign","إِنَّ فِى ذَٰلِكَ","لِّلْمُؤْمِنِينَ",28],["15:81:2",266,"ءَايَـٰتِنَا","Our Signs","وَءَاتَيْنَـٰهُمْ","فَكَانُوا۟ عَنْهَا مُعْرِضِينَ",28],["16:11:14",268,"لَـَٔايَةًۭ","surely (is) a sign","إِنَّ فِى ذَٰلِكَ","لِّقَوْمٍۢ يَتَفَكَّرُونَ",28],["16:12:13",268,"لَـَٔايَـٰتٍۢ","surely (are) signs","إِنَّ فِى ذَٰلِكَ","لِّقَوْمٍۢ يَعْقِلُونَ",28],["16:13:11",268,"لَـَٔايَةًۭ","surely (is) a sign","إِنَّ فِى ذَٰلِكَ","لِّقَوْمٍۢ يَذَّكَّرُونَ",28],["16:65:14",274,"لَـَٔايَةًۭ","(is) surely a Sign","إِنَّ فِى ذَٰلِكَ","لِّقَوْمٍۢ يَسْمَعُونَ",28],["16:67:13",274,"لَـَٔايَةًۭ","(is) surely a Sign","إِنَّ فِى ذَٰلِكَ","لِّقَوْمٍۢ يَعْقِلُونَ",28],["16:69:22",274,"لَـَٔايَةًۭ","(is) surely a Sign","إِنَّ فِى ذَٰلِكَ","لِّقَوْمٍۢ يَتَفَكَّرُونَ",28],["16:79:16",275,"لَـَٔايَـٰتٍۢ","(are) Signs","إِنَّ فِى ذَٰلِكَ","لِّقَوْمٍۢ يُؤْمِنُونَ",28],["16:101:3",278,"ءَايَةًۭ","a Verse","وَإِذَا بَدَّلْنَآ","مَّكَانَ ءَايَةٍۢ ۙ وَٱللَّهُ",28],["16:101:5",278,"ءَايَةٍۢ ۙ","(of) a Verse","بَدَّلْنَآ ءَايَةًۭ مَّكَانَ","وَٱللَّهُ أ