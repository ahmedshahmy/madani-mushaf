ِهِۦ","and His Verses","حَدِيثٍۭ بَعْدَ ٱللَّهِ","يُؤْمِنُونَ",28],["45:8:2",499,"ءَايَـٰتِ","(the) Verses","يَسْمَعُ","ٱللَّهِ تُتْلَىٰ عَلَيْهِ",28],["45:9:4",499,"ءَايَـٰتِنَا","Our Verses","وَإِذَا عَلِمَ مِنْ","شَيْـًٔا ٱتَّخَذَهَا هُزُوًا ۚ",28],["45:11:5",499,"بِـَٔايَـٰتِ","in (the) Verses","هُدًۭى ۖ وَٱلَّذِينَ كَفَرُوا۟","رَبِّهِمْ لَهُمْ عَذَابٌۭ",28],["45:13:14",499,"لَـَٔايَـٰتٍۢ","surely are Signs","إِنَّ فِى ذَٰلِكَ","لِّقَوْمٍۢ يَتَفَكَّرُونَ",28],["45:25:4",501,"ءَايَـٰتُنَا","Our Verses","وَإِذَا تُتْلَىٰ عَلَيْهِمْ","بَيِّنَـٰتٍۢ مَّا كَانَ",28],["45:31:6",501,"ءَايَـٰتِى","My Verses","كَفَرُوٓا۟ أَفَلَمْ تَكُنْ","تُتْلَىٰ عَلَيْكُمْ فَٱسْتَكْبَرْتُمْ",28],["45:35:4",502,"ءَايَـٰتِ","(the) Verses","ذَٰلِكُم بِأَنَّكُمُ ٱتَّخَذْتُمْ","ٱللَّهِ هُزُوًۭا وَغَرَّتْكُمُ",28],["46:7:4",503,"ءَايَـٰتُنَا","Our Verses","وَإِذَا تُتْلَىٰ عَلَيْهِمْ","بَيِّنَـٰتٍۢ قَالَ ٱلَّذِينَ",28],["46:26:25",505,"بِـَٔايَـٰتِ","(the) Signs","إِذْ كَانُوا۟ يَجْحَدُونَ","ٱللَّهِ وَحَاقَ بِهِم",28],["46:27:8",505,"ٱلْـَٔايَـٰتِ","the Signs","مِّنَ ٱلْقُرَىٰ وَصَرَّفْنَا","لَعَلَّهُمْ يَرْجِعُونَ",28],["48:20:14",513,"ءَايَةًۭ","a sign","ٱلنَّاسِ عَنكُمْ وَلِتَكُونَ","لِّلْمُؤْمِنِينَ وَيَهْدِيَكُمْ صِرَٰطًۭا",28],["51:20:3",521,"ءَايَـٰتٌۭ","(are) signs","وَفِى ٱلْأَرْضِ","لِّلْمُوقِنِينَ",28],["51:37:3",522,"ءَايَةًۭ","a Sign","وَتَرَكْنَا فِيهَآ","لِّلَّذِينَ يَخَافُونَ ٱلْعَذَابَ",28],["53:18:4",526,"ءَايَـٰتِ","(the) Signs","لَقَدْ رَأَىٰ مِنْ","رَبِّهِ ٱلْكُبْرَىٰٓ",28],["54:2:3",528,"ءَايَةًۭ","a Sign","وَإِن يَرَوْا۟","يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌۭ",28],["54:15:3",529,"ءَايَةًۭ","(as) a Sign","وَلَقَد تَّرَكْنَـٰهَآ","فَهَلْ مِن مُّدَّكِرٍۢ",28],["54:42:2",530,"بِـَٔايَـٰتِنَا","Our Signs","كَذَّبُوا۟","كُلِّهَا فَأَخَذْنَـٰهُمْ أَخْذَ",28],["57:9:6",538,"ءَايَـٰتٍۭ","Verses","يُنَزِّلُ عَلَىٰ عَبْدِهِۦٓ","بَيِّنَـٰتٍۢ لِّيُخْرِجَكُم مِّنَ",28],["57:17:11",539,"ٱلْـَٔايَـٰتِ","the Signs","قَدْ بَيَّنَّا لَكُمُ","لَعَلَّكُمْ تَعْقِلُونَ",28],["57:19:17",540,"بِـَٔايَـٰتِنَآ","Our Verses","وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟","أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْجَحِيمِ",28],["58:5:14",542,"ءَايَـٰتٍۭ","Verses","قَبْلِهِمْ ۚ وَقَدْ أَنزَلْنَآ","بَيِّنَـٰتٍۢ ۚ وَلِلْكَـٰفِرِينَ عَذَابٌۭ",28],["62:2:10",553,"ءَايَـٰتِهِۦ","His Verses","مِّنْهُمْ يَتْلُوا۟ عَلَيْهِمْ","وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ ٱلْكِتَـٰبَ",28],["62:5:17",553,"بِـَٔايَـٰتِ","(the) Signs","ٱلْقَوْمِ ٱلَّذِينَ كَذَّبُوا۟","ٱللَّهِ ۚ وَٱللَّهُ لَا",28],["64:10:4",557,"بِـَٔايَـٰتِنَآ","[in] Our Verses","وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟","أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ",28],["65:11:4",559,"ءَايَـٰتِ","(the) Verses","رَّسُولًۭا يَتْلُوا۟ عَلَيْكُمْ","ٱللَّهِ مُبَيِّنَـٰتٍۢ لِّيُخْرِجَ",28],["68:15:4",564,"ءَايَـٰتُنَا","Our Verses","إِذَا تُتْلَىٰ عَلَيْهِ","قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",28],["74:16:4",575,"لِـَٔايَـٰتِنَا","to Our Verses","كَلَّآ ۖ إِنَّهُۥ كَانَ","عَنِيدًۭا",28],["78:28:2",582,"بِـَٔايَـٰتِنَا","Our Signs","وَكَذَّبُوا۟","كِذَّابًۭا",28],["79:20:2",584,"ٱلْـَٔايَةَ","the sign","فَأَرَىٰهُ","ٱلْكُبْرَىٰ",28],["83:13:4",588,"ءَايَـٰتُنَا","Our Verses","إِذَا تُتْلَىٰ عَلَيْهِ","قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",28],["90:19:3",595,"بِـَٔايَـٰتِنَا","in Our Verses","وَٱلَّذِينَ كَفَرُوا۟","هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",28]]