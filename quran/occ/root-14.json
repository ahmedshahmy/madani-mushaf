ٰتِنَا","Our Signs","ٱلْقَوْمُ ٱلَّذِينَ كَذَّبُوا۟","وَأَنفُسَهُمْ كَانُوا۟ يَظْلِمُونَ",28],["7:182:3",174,"بِـَٔايَـٰتِنَا","Our Signs","وَٱلَّذِينَ كَذَّبُوا۟","سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ",28],["7:203:4",176,"بِـَٔايَةٍۢ","a Sign","وَإِذَا لَمْ تَأْتِهِم","قَالُوا۟ لَوْلَا ٱجْتَبَيْتَهَا ۚ",28],["8:2:12",177,"ءَايَـٰتُهُۥ","His Verses","وَإِذَا تُلِيَتْ عَلَيْهِمْ","زَادَتْهُمْ إِيمَـٰنًۭا وَعَلَىٰ",28],["8:31:4",180,"ءَايَـٰتُنَا","Our Verses","وَإِذَا تُتْلَىٰ عَلَيْهِمْ","قَالُوا۟ قَدْ سَمِعْنَا",28],["8:52:8",183,"بِـَٔايَـٰتِ","in (the) Signs","مِن قَبْلِهِمْ ۚ كَفَرُوا۟","ٱللَّهِ فَأَخَذَهُمُ ٱللَّهُ",28],["8:54:8",184,"بِـَٔايَـٰتِ","(the) Signs","مِن قَبْلِهِمْ ۚ كَذَّبُوا۟","رَبِّهِمْ فَأَهْلَكْنَـٰهُم بِذُنُوبِهِمْ",28],["9:9:2",188,"بِـَٔايَـٰتِ","[with] the Verses of Allah","ٱشْتَرَوْا۟","ٱللَّهِ ثَمَنًۭا قَلِيلًۭا",28],["9:11:11",188,"ٱلْـَٔايَـٰتِ","the Verses","فِى ٱلدِّينِ ۗ وَنُفَصِّلُ","لِقَوْمٍۢ يَعْلَمُونَ",28],["9:65:10",197,"وَءَايَـٰتِهِۦ","and His Verses","وَنَلْعَبُ ۚ قُلْ أَبِٱللَّهِ","وَرَسُولِهِۦ كُنتُمْ تَسْتَهْزِءُونَ",28],["10:1:3",208,"ءَايَـٰتُ","(are the) verses","الٓر ۚ تِلْكَ","ٱلْكِتَـٰبِ ٱلْحَكِيمِ",28],["10:5:21",208,"ٱلْـَٔايَـٰتِ","the Signs","إِلَّا بِٱلْحَقِّ ۚ يُفَصِّلُ","لِقَوْمٍۢ يَعْلَمُونَ",28],["10:6:12",208,"لَـَٔايَـٰتٍۢ","(are) Signs","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","لِّقَوْمٍۢ يَتَّقُونَ",28],["10:7:14",209,"ءَايَـٰتِنَا","Our Signs","وَٱلَّذِينَ هُمْ عَنْ","غَـٰفِلُونَ",28],["10:15:4",210,"ءَايَاتُنَا","Our Verses","وَإِذَا تُتْلَىٰ عَلَيْهِمْ","بَيِّنَـٰتٍۢ ۙ قَالَ ٱلَّذِينَ",28],["10:17:10",210,"بِـَٔايَـٰتِهِۦٓ ۚ","His Signs","كَذِبًا أَوْ كَذَّبَ","إِنَّهُۥ لَا يُفْلِحُ",28],["10:20:5",210,"ءَايَةٌۭ","a Sign","لَوْلَآ أُنزِلَ عَلَيْهِ","مِّن رَّبِّهِۦ ۖ فَقُلْ",28],["10:21:13",211,"ءَايَاتِنَا ۚ","Our Verses","لَهُم مَّكْرٌۭ فِىٓ","قُلِ ٱللَّهُ أَسْرَعُ",28],["10:24:41",211,"ٱلْـَٔايَـٰتِ","the Signs","بِٱلْأَمْسِ ۚ كَذَٰلِكَ نُفَصِّلُ","لِقَوْمٍۢ يَتَفَكَّرُونَ",28],["10:67:13",216,"لَـَٔايَـٰتٍۢ",