[["2:51:8",8,"ٱلْعِجْلَ","the calf","لَيْلَةًۭ ثُمَّ ٱتَّخَذْتُمُ","مِنۢ بَعْدِهِۦ وَأَنتُمْ",820],["2:54:10",8,"ٱلْعِجْلَ","the calf","ظَلَمْتُمْ أَنفُسَكُم بِٱتِّخَاذِكُمُ","فَتُوبُوٓا۟ إِلَىٰ بَارِئِكُمْ",820],["2:92:7",14,"ٱلْعِجْلَ","the calf","بِٱلْبَيِّنَـٰتِ ثُمَّ ٱتَّخَذْتُمُ","مِنۢ بَعْدِهِۦ وَأَنتُمْ",820],["2:93:18",14,"ٱلْعِجْلَ","(love of) the calf","وَأُشْرِبُوا۟ فِى قُلُوبِهِمُ","بِكُفْرِهِمْ ۚ قُلْ بِئْسَمَا",820],["2:203:7",32,"تَعَجَّلَ","hurries","أَيَّامٍۢ مَّعْدُودَٰتٍۢ ۚ فَمَن","فِى يَوْمَيْنِ فَلَآ",4320],["4:153:25",102,"ٱلْعِجْلَ","the calf (for worship)","بِظُلْمِهِمْ ۚ ثُمَّ ٱتَّخَذُوا۟","مِنۢ بَعْدِ مَا",820],["6:57:12",134,"تَسْتَعْجِلُونَ","you seek to hasten","مَا عِندِى مَا","بِهِۦٓ ۚ إِنِ ٱلْحُكْمُ",535],["6:58:6",134,"تَسْتَعْجِلُونَ","you seek to hasten","أَنَّ عِندِى مَا","بِهِۦ لَقُضِىَ ٱلْأَمْرُ",535],["7:148:8",168,"عِجْلًۭا","a calf","بَعْدِهِۦ مِنْ حُلِيِّهِمْ","جَسَدًۭا لَّهُۥ خُوَارٌ ۚ",820],["7:150:13",169,"أَعَجِلْتُمْ","Were you impatient","خَلَفْتُمُونِى مِنۢ بَعْدِىٓ ۖ","أَمْرَ رَبِّكُمْ ۖ وَأَلْقَى",1292],["7:152:4",169,"ٱلْعِجْلَ","the calf","إِنَّ ٱلَّذِينَ ٱتَّخَذُوا۟","سَيَنَالُهُمْ غَضَبٌۭ مِّن",820],["10:11:2",209,"يُعَجِّلُ","hastens","۞ وَلَوْ","ٱللَّهُ لِلنَّاسِ ٱلشَّرَّ",1293],["10:11:6",209,"ٱسْتِعْجَالَهُم","(as) He hastens for them","ٱللَّهُ لِلنَّاسِ ٱلشَّرَّ","بِٱلْخَيْرِ لَقُضِىَ إِلَيْهِمْ",4838],["10:50:10",214,"يَسْتَعْجِلُ","of it would (wish to) hasten","أَوْ نَهَارًۭا مَّاذَا","مِنْهُ ٱلْمُجْرِمُونَ",535],["10:51:11",214,"تَسْتَعْجِلُونَ","seeking to hasten it","وَقَدْ كُنتُم بِهِۦ","",535],["11:69:14",229,"بِعِجْلٍ","a calf","لَبِثَ أَن جَآءَ","حَنِيذٍۢ",820],["13:6:1",250,"وَيَسْتَعْجِلُونَكَ","And they ask you to hasten","","بِٱلسَّيِّئَةِ قَبْلَ ٱلْحَسَنَةِ",535],["16:1:5",267,"تَسْتَعْجِلُوهُ ۚ","(be) impatient for it","أَمْرُ ٱللَّهِ فَلَا","سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ عَمَّا",535],["17:11:8",283,"عَجُولًۭا","ever hasty","بِٱلْخَيْرِ ۖ وَكَانَ ٱلْإِنسَـٰنُ","",3113],["17:18:4",284,"ٱلْعَاجِلَةَ","the immediate","مَّن كَانَ يُرِيدُ","عَجَّلْنَا لَهُۥ فِيهَا",1762],["17:18:5",284,"عَجَّلْنَا","We hasten","كَانَ يُرِيدُ ٱلْعَاجِلَةَ","لَهُۥ فِيهَا مَا",1293],["18:58:9",300,"لَعَجَّلَ","surely, He (would) have hastened","يُؤَاخِذُهُم بِمَا كَسَبُوا۟","لَهُمُ ٱلْعَذَابَ ۚ بَل",1293],["19:84:2",311,"تَعْجَلْ","make haste","فَلَا","عَلَيْهِمْ ۖ إِنَّمَا نَعُدُّ",1292],["20:83:2",317,"أَعْجَلَكَ","made you hasten","۞ وَمَآ","عَن قَوْمِكَ يَـٰمُوسَىٰ",2951],["20:84:6",317,"وَعَجِلْتُ","and I hastened","أُو۟لَآءِ عَلَىٰٓ أَثَرِى","إِلَيْكَ رَبِّ لِتَرْضَىٰ",1292],["20:88:3",318,"عِجْلًۭا","a calf's","فَأَخْرَجَ لَهُمْ","جَسَدًۭا لَّهُۥ خُوَارٌۭ",820],["20:114:6",320,"تَعْجَلْ","hasten","ٱلْمَلِكُ ٱلْحَقُّ ۗ وَلَا","بِٱلْقُرْءَانِ مِن قَبْلِ",1292],["21:37:4",325,"عَجَلٍۢ ۚ","haste","خُلِقَ ٱلْإِنسَـٰنُ مِنْ","سَأُو۟رِيكُمْ ءَايَـٰتِى فَلَا",3111],["21:37:8",325,"تَسْتَعْجِلُونِ","ask Me to hasten","سَأُو۟رِيكُمْ ءَايَـٰتِى فَلَا","",535],["22:47:1",338,"وَيَسْتَعْجِلُونَكَ","And they ask you to hasten","","بِٱلْعَذَابِ وَلَن يُخْلِفَ",535],["26:204:2",375,"يَسْتَعْجِلُونَ","they wish to hasten","أَفَبِعَذَابِنَا","",535],["27:46:4",381,"تَسْتَعْجِلُونَ","(do) you seek to hasten","قَالَ يَـٰقَوْمِ لِمَ","بِٱلسَّيِّئَةِ قَبْلَ ٱلْحَسَنَةِ ۖ",535],["27:72:9",383,"تَسْتَعْجِلُونَ","you seek to hasten","لَكُم بَعْضُ ٱلَّذِى","",535],["29:53:1",403,"وَيَسْتَعْجِلُونَكَ","And they ask you to hasten","","بِٱلْعَذَابِ ۚ وَلَوْلَآ أَجَلٌۭ",535],["29:54:1",403,"يَسْتَعْجِلُونَكَ","They ask you to hasten","","بِٱلْعَذَابِ وَإِنَّ جَهَنَّمَ",535],["37:176:2",452,"يَسْتَعْجِلُونَ","they hasten","أَفَبِعَذَابِنَا","",535],["38:16:3",453,"عَجِّل","Hasten","وَقَالُوا۟ رَبَّنَا","لَّنَا قِطَّنَا قَبْلَ",1293],["42:18:1",485,"يَسْتَعْجِلُ","Seek to hasten","","بِهَا ٱلَّذِينَ لَا",535],["46:24:13",505,"ٱسْتَعْجَلْتُم","you were asking it to be hastened","بَلْ هُوَ مَا","بِهِۦ ۖ رِيحٌۭ فِيهَا",535],["46:35:9",506,"تَسْتَعْجِل","seek to hasten","مِنَ ٱلرُّسُلِ وَلَا","لَّهُمْ ۚ كَأَنَّهُمْ يَوْمَ",535],["48:20:6",513,"فَعَجَّلَ","and He has hastened","مَغَانِمَ كَثِيرَةًۭ تَأْخُذُونَهَا","لَكُمْ هَـٰذِهِۦ وَكَفَّ",1293],["51:14:7",521,"تَسْتَعْجِلُونَ","seeking to hasten","ٱلَّذِى كُنتُم بِهِۦ","",535],["51:26:5",521,"بِعِجْلٍۢ","with a calf","إِلَىٰٓ أَهْلِهِۦ فَجَآءَ","سَمِينٍۢ",820],["51:59:9",523,"يَسْتَعْجِلُونِ","so let them not ask Me to hasten","ذَنُوبِ أَصْحَـٰبِهِمْ فَلَا","",535],["75:16:5",577,"لِتَعْجَلَ","to hasten","تُحَرِّكْ بِهِۦ لِسَانَكَ","بِهِۦٓ",1292],["75:20:4",578,"ٱلْعَاجِلَةَ","the immediate","كَلَّا بَلْ تُحِبُّونَ","",1762],["76:27:4",580,"ٱلْعَاجِلَةَ","the immediate","إِنَّ هَـٰٓؤُلَآءِ يُحِبُّونَ","وَيَذَرُونَ وَرَآءَهُمْ يَوْمًۭا",1762]]