[["12:25:3",238,"وَقَدَّتْ","and she tore","وَٱسْتَبَقَا ٱلْبَابَ","قَمِيصَهُۥ مِن دُبُرٍۢ",1626],["12:26:13",238,"قُدَّ","(is) torn","إِن كَانَ قَمِيصُهُۥ","مِن قُبُلٍۢ فَصَدَقَتْ",1626],["12:27:4",238,"قُدَّ","(is) torn","وَإِن كَانَ قَمِيصُهُۥ","مِن دُبُرٍۢ فَكَذَبَتْ",1626],["12:28:4",238,"قُدَّ","torn","فَلَمَّا رَءَا قَمِيصَهُۥ","مِن دُبُرٍۢ قَالَ",1626],["72:11:9",572,"قِدَدًۭا","different","ذَٰلِكَ ۖ كُنَّا طَرَآئِقَ","",4137]]