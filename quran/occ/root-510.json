[["11:105:9",233,"شَقِىٌّۭ","(will be the) wretched","إِلَّا بِإِذْنِهِۦ ۚ فَمِنْهُمْ","وَسَعِيدٌۭ",1452],["11:106:3",233,"شَقُوا۟","were wretched","فَأَمَّا ٱلَّذِينَ","فَفِى ٱلنَّارِ لَهُمْ",1453],["19:4:14",305,"شَقِيًّۭا","unblessed","أَكُنۢ بِدُعَآئِكَ رَبِّ","",1452],["19:32:6",307,"شَقِيًّۭا","unblessed","وَلَمْ يَجْعَلْنِى جَبَّارًۭا","",1452],["19:48:14",308,"شَقِيًّۭا","unblessed","أَكُونَ بِدُعَآءِ رَبِّى","",1452],["20:2:5",312,"لِتَشْقَىٰٓ","that you be distressed","أَنزَلْنَا عَلَيْكَ ٱلْقُرْءَانَ","",1453],["20:117:12",320,"فَتَشْقَىٰٓ","so (that) you would suffer","يُخْرِجَنَّكُمَا مِنَ ٱلْجَنَّةِ","",1453],["20:123:18",320,"يَشْقَىٰ","suffer","فَلَا يَضِلُّ وَلَا","",1453],["23:106:5",349,"شِقْوَتُنَا","our wretchedness","رَبَّنَا غَلَبَتْ عَلَيْنَا","وَكُنَّا قَوْمًۭا ضَآلِّينَ",2880],["87:11:2",592,"ٱلْأَشْقَى","the wretched one","وَيَتَجَنَّبُهَا","",1718],["91:12:3",595,"أَشْقَىٰهَا","(the) most wicked of them","إِذِ ٱنۢبَعَثَ","",1718],["92:15:4",596,"ٱلْأَشْقَى","the most wretched","لَا يَصْلَىٰهَآ إِلَّا","",1718]]