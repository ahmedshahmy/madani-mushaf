[["3:8:11",50,"لَّدُنكَ","Yourself","وَهَبْ لَنَا مِن","رَحْمَةً ۚ إِنَّكَ أَنتَ",550],["3:38:10",55,"لَّدُنكَ","Yourself","هَبْ لِى مِن","ذُرِّيَّةًۭ طَيِّبَةً ۖ إِنَّكَ",550],["4:40:13",85,"لَّدُنْهُ","near Him","يُضَـٰعِفْهَا وَيُؤْتِ مِن","أَجْرًا عَظِيمًۭا",550],["4:67:4",89,"لَّدُنَّآ","Ourselves","وَإِذًۭا لَّـَٔاتَيْنَـٰهُم مِّن","أَجْرًا عَظِيمًۭا",550],["4:75:25",90,"لَّدُنكَ","Yourself","وَٱجْعَل لَّنَا مِن","وَلِيًّۭا وَٱجْعَل لَّنَا",550],["4:75:30",90,"لَّدُنكَ","Yourself","وَٱجْعَل لَّنَا مِن","نَصِيرًا",550],["11:1:8",221,"لَّدُنْ","from (he One Who)","ثُمَّ فُصِّلَتْ مِن","حَكِيمٍ خَبِيرٍ",550],["17:80:12",290,"لَّدُنكَ","near You","وَٱجْعَل لِّى مِن","سُلْطَـٰنًۭا نَّصِيرًۭا",550],["18:2:6",293,"لَّدُنْهُ","near Him","بَأْسًۭا شَدِيدًۭا مِّن","وَيُبَشِّرَ ٱلْمُؤْمِنِينَ ٱلَّذِينَ",550],["18:10:10",294,"لَّدُنكَ","Yourself","رَبَّنَآ ءَاتِنَا مِن","رَحْمَةًۭ وَهَيِّئْ لَنَا",550],["18:65:11",301,"لَّدُنَّا","Us","عِندِنَا وَعَلَّمْنَـٰهُ مِن","عِلْمًۭا",550],["18:76:12",302,"لَّدُنِّى","from me","قَدْ بَلَغْتَ مِن","عُذْرًۭا",550],["19:5:12",305,"لَّدُنكَ","Yourself","فَهَبْ لِى مِن","وَلِيًّۭا",550],["19:13:3",306,"لَّدُنَّا","Us","وَحَنَانًۭا مِّن","وَزَكَوٰةًۭ ۖ وَكَانَ تَقِيًّۭا",550],["20:99:12",319,"لَّدُنَّا","Us","وَقَدْ ءَاتَيْنَـٰكَ مِن","ذِكْرًۭا",550],["21:17:8",323,"لَّدُنَّآ","Us","لَهْوًۭا لَّٱتَّخَذْنَـٰهُ مِن","إِن كُنَّا فَـٰعِلِينَ",550],["27:6:5",377,"لَّدُنْ","from [near]","لَتُلَقَّى ٱلْقُرْءَانَ مِن","حَكِيمٍ عَلِيمٍ",550],["28:57:21",392,"لَّدُنَّا","Us","شَىْءٍۢ رِّزْقًۭا مِّن","وَلَـٰكِنَّ أَكْثَرَهُمْ لَا",550]]