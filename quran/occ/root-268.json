[["2:14:16",3,"مُسْتَهْزِءُونَ","(are) mockers","مَعَكُمْ إِنَّمَا نَحْنُ","",2506],["2:15:2",3,"يَسْتَهْزِئُ","mocks","ٱللَّهُ","بِهِمْ وَيَمُدُّهُمْ فِى",499],["2:67:13",10,"هُزُوًۭا ۖ","(in) ridicule","بَقَرَةًۭ ۖ قَالُوٓا۟ أَتَتَّخِذُنَا","قَالَ أَعُوذُ بِٱللَّهِ",784],["2:231:25",37,"هُزُوًۭا ۚ","(in) jest","تَتَّخِذُوٓا۟ ءَايَـٰتِ ٱللَّهِ","وَٱذْكُرُوا۟ نِعْمَتَ ٱللَّهِ",784],["4:140:13",100,"وَيُسْتَهْزَأُ","and ridiculed","ٱللَّهِ يُكْفَرُ بِهَا","بِهَا فَلَا تَقْعُدُوا۟",499],["5:57:9",117,"هُزُوًۭا","(in) ridicule","ٱلَّذِينَ ٱتَّخَذُوا۟ دِينَكُمْ","وَلَعِبًۭا مِّنَ ٱلَّذِينَ",784],["5:58:6",118,"هُزُوًۭا","(in) ridicule","إِلَى ٱلصَّلَوٰةِ ٱتَّخَذُوهَا","وَلَعِبًۭا ۚ ذَٰلِكَ بِأَنَّهُمْ",784],["6:5:12",128,"يَسْتَهْزِءُونَ","mock","مَا كَانُوا۟ بِهِۦ","",499],["6:10:2",129,"ٱسْتُهْزِئَ","were mocked","وَلَقَدِ","بِرُسُلٍۢ مِّن قَبْلِكَ",499],["6:10:13",129,"يَسْتَهْزِءُونَ","mock","مَّا كَانُوا۟ بِهِۦ","",499],["9:64:12",197,"ٱسْتَهْزِءُوٓا۟","Mock","فِى قُلُوبِهِمْ ۚ قُلِ","إِنَّ ٱللَّهَ مُخْرِجٌۭ",499],["9:65:13",197,"تَسْتَهْزِءُونَ","mocking","وَءَايَـٰتِهِۦ وَرَسُولِهِۦ كُنتُمْ","",499],["11:8:22",222,"يَسْتَهْزِءُونَ","mock at [it]","مَّا كَانُوا۟ بِهِۦ","",499],["13:32:2",253,"ٱسْتُهْزِئَ","were mocked","وَلَقَدِ","بِرُسُلٍۢ مِّن قَبْلِكَ",499],["15:11:8",262,"يَسْتَهْزِءُونَ","mock","إِلَّا كَانُوا۟ بِهِۦ","",499],["15:95:3",267,"ٱلْمُسْتَهْزِءِينَ","(against) the mockers","إِنَّا كَفَيْنَـٰكَ","",2506],["16:34:10",270,"يَسْتَهْزِءُونَ","mock","مَّا كَانُوا۟ بِهِۦ","",499],["18:56:18",300,"هُزُوًۭا","(in) ridicule","ءَايَـٰتِى وَمَآ أُنذِرُوا۟","",784],["18:106:9",304,"هُزُوًا","(in) ridicule","وَٱتَّخَذُوٓا۟ ءَايَـٰتِى وَرُسُلِى","",784],["21:36:8",325,"هُزُوًا","(in) ridicule","إِن يَتَّخِذُونَكَ إِلَّا","أَهَـٰذَا ٱلَّذِى يَذْكُرُ",784],["21:41:2",325,"ٱسْتُهْزِئَ","were mocked","وَلَقَدِ","بِرُسُلٍۢ مِّن قَبْلِكَ",499],["21:41:13",325,"يَسْتَهْزِءُونَ","(to) mock","مَّا كَانُوا۟ بِهِۦ","",499],["25:41:6",363,"هُزُوًا","(in) mockery","إِن يَتَّخِذُونَكَ إِلَّا","أَهَـٰذَا ٱلَّذِى بَعَثَ",784],["26:6:8",367,"يَسْتَهْزِءُونَ","(to) mock","مَا كَانُوا۟ بِهِۦ","",499],["30:10:13",405,"يَسْتَهْزِءُونَ","making mockery","ٱللَّهِ وَكَانُوا۟ بِهَا","",499],["31:6:14",411,"هُزُوًا ۚ","(in) ridicule","بِغَيْرِ عِلْمٍۢ وَيَتَّخِذَهَا","أُو۟لَـٰٓئِكَ لَهُمْ عَذَابٌۭ",784],["36:30:11",442,"يَسْتَهْزِءُونَ","mock at him","إِلَّا كَانُوا۟ بِهِۦ","",499],["39:48:11",464,"يَسْتَهْزِءُونَ","mock","مَّا كَانُوا۟ بِهِۦ","",499],["40:83:15",476,"يَسْتَهْزِءُونَ","mock","مَّا كَانُوا۟ بِهِۦ","",499],["43:7:8",489,"يَسْتَهْزِءُونَ","mock at him","إِلَّا كَانُوا۟ بِهِۦ","",499],["45:9:7",499,"هُزُوًا ۚ","(in) ridicule","ءَايَـٰتِنَا شَيْـًٔا ٱتَّخَذَهَا","أُو۟لَـٰٓئِكَ لَهُمْ عَذَابٌۭ",784],["45:33:11",502,"يَسْتَهْزِءُونَ","(to) mock","مَّا كَانُوا۟ بِهِۦ","",499],["45:35:6",502,"هُزُوًۭا","(in) ridicule","ٱتَّخَذْتُمْ ءَايَـٰتِ ٱللَّهِ","وَغَرَّتْكُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا ۚ",784],["46:26:32",505,"يَسْتَهْزِءُونَ","ridicule","مَّا كَانُوا۟ بِهِۦ","",499]]