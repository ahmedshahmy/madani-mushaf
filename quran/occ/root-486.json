[["4:62:10",88,"يَحْلِفُونَ","swearing","أَيْدِيهِمْ ثُمَّ جَآءُوكَ","بِٱللَّهِ إِنْ أَرَدْنَآ",721],["5:89:36",122,"حَلَفْتُمْ ۚ","you have sworn","كَفَّـٰرَةُ أَيْمَـٰنِكُمْ إِذَا","وَٱحْفَظُوٓا۟ أَيْمَـٰنَكُمْ ۚ كَذَٰلِكَ",721],["9:42:12",194,"وَسَيَحْلِفُونَ","And they will swear","بَعُدَتْ عَلَيْهِمُ ٱلشُّقَّةُ ۚ","بِٱللَّهِ لَوِ ٱسْتَطَعْنَا",721],["9:56:1",196,"وَيَحْلِفُونَ","And they swear","","بِٱللَّهِ إِنَّهُمْ لَمِنكُمْ",721],["9:62:1",197,"يَحْلِفُونَ","They swear","","بِٱللَّهِ لَكُمْ لِيُرْضُوكُمْ",721],["9:74:1",199,"يَحْلِفُونَ","They swear","","بِٱللَّهِ مَا قَالُوا۟",721],["9:95:1",202,"سَيَحْلِفُونَ","They will swear","","بِٱللَّهِ لَكُمْ إِذَا",721],["9:96:1",202,"يَحْلِفُونَ","They swear","","لَكُمْ لِتَرْضَوْا۟ عَنْهُمْ ۖ",721],["9:107:16",204,"وَلَيَحْلِفُنَّ","And surely they will swear","وَرَسُولَهُۥ مِن قَبْلُ ۚ","إِنْ أَرَدْنَآ إِلَّا",721],["58:14:15",544,"وَيَحْلِفُونَ","and they swear","مِّنكُمْ وَلَا مِنْهُمْ","عَلَى ٱلْكَذِبِ وَهُمْ",721],["58:18:5",544,"فَيَحْلِفُونَ","then they will swear","يَبْعَثُهُمُ ٱللَّهُ جَمِيعًۭا","لَهُۥ كَمَا يَحْلِفُونَ",721],["58:18:8",544,"يَحْلِفُونَ","they swear","فَيَحْلِفُونَ لَهُۥ كَمَا","لَكُمْ ۖ وَيَحْسَبُونَ أَنَّهُمْ",721],["68:10:4",564,"حَلَّافٍۢ","habitual swearer","وَلَا تُطِعْ كُلَّ","مَّهِينٍ",3184]]