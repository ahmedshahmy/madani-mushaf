[["3:96:8",62,"مُبَارَكًۭا","blessed","لِلنَّاسِ لَلَّذِى بِبَكَّةَ","وَهُدًۭى لِّلْعَـٰلَمِينَ",988],["6:92:4",139,"مُبَارَكٌۭ","blessed","وَهَـٰذَا كِتَـٰبٌ أَنزَلْنَـٰهُ","مُّصَدِّقُ ٱلَّذِى بَيْنَ",988],["6:155:4",149,"مُبَارَكٌۭ","blessed","وَهَـٰذَا كِتَـٰبٌ أَنزَلْنَـٰهُ","فَٱتَّبِعُوهُ وَٱتَّقُوا۟ لَعَلَّكُمْ",988],["7:54:29",157,"تَبَارَكَ","blessed","لَهُ ٱلْخَلْقُ وَٱلْأَمْرُ ۗ","ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",926],["7:96:9",163,"بَرَكَـٰتٍۢ","blessings","وَٱتَّقَوْا۟ لَفَتَحْنَا عَلَيْهِم","مِّنَ ٱلسَّمَآءِ وَٱلْأَرْضِ",1813],["7:137:10",166,"بَـٰرَكْنَا","We blessed","ٱلْأَرْضِ وَمَغَـٰرِبَهَا ٱلَّتِى","فِيهَا ۖ وَتَمَّتْ كَلِمَتُ",969],["11:48:6",227,"وَبَرَكَـٰتٍ","and blessings","ٱهْبِطْ بِسَلَـٰمٍۢ مِّنَّا","عَلَيْكَ وَعَلَىٰٓ أُمَمٍۢ",1813],["11:73:8",230,"وَبَرَكَـٰتُهُۥ","and His blessings","ٱللَّهِ ۖ رَحْمَتُ ٱللَّهِ","عَلَيْكُمْ أَهْلَ ٱلْبَيْتِ ۚ",1813],["17:1:13",282,"بَـٰرَكْنَا","We blessed","ٱلْمَسْجِدِ ٱلْأَقْصَا ٱلَّذِى","حَوْلَهُۥ لِنُرِيَهُۥ مِنْ",969],["19:31:2",307,"مُبَارَكًا","blessed","وَجَعَلَنِى","أَيْنَ مَا كُنتُ",988],["21:50:3",326,"مُّبَارَكٌ","blessed","وَهَـٰذَا ذِكْرٌۭ","أَنزَلْنَـٰهُ ۚ أَفَأَنتُمْ لَهُۥ",988],["21:71:6",327,"بَـٰرَكْنَا","We (had) blessed","إِلَى ٱلْأَرْضِ ٱلَّتِى","فِيهَا لِلْعَـٰلَمِينَ",969],["21:81:9",328,"بَـٰرَكْنَا","We blessed","إِلَى ٱلْأَرْضِ ٱلَّتِى","فِيهَا ۚ وَكُنَّا بِكُلِّ",969],["23:14:18",342,"فَتَبَارَكَ","So blessed is","أَنشَأْنَـٰهُ خَلْقًا ءَاخَرَ ۚ","ٱللَّهُ أَحْسَنُ ٱلْخَـٰلِقِينَ",926],["23:29:5",344,"مُّبَارَكًۭا","blessed","رَّبِّ أَنزِلْنِى مُنزَلًۭا","وَأَنتَ خَيْرُ ٱلْمُنزِلِينَ",988],["24:35:20",354,"مُّبَـٰرَكَةٍۢ","blessed","يُوقَدُ مِن شَجَرَةٍۢ","زَيْتُونَةٍۢ لَّا شَرْقِيَّةٍۢ",1602],["24:61:68",358,"مُبَـٰرَكَةًۭ","blessed","مِّنْ عِندِ ٱللَّهِ","طَيِّبَةًۭ ۚ كَذَٰلِكَ يُبَيِّنُ",1602],["25:1:1",359,"تَبَارَكَ","Blessed is He","","ٱلَّذِى نَزَّلَ ٱلْفُرْقَانَ",926],["25:10:1",360,"تَبَارَكَ","Blessed is He","","ٱلَّذِىٓ إِن شَآءَ",926],["25:61:1",365,"تَبَارَكَ","Blessed is He","","ٱلَّذِى جَعَلَ فِى",926],["27:8:5",377,"بُورِكَ","Blessed is","جَآءَهَا نُودِىَ أَنۢ","مَن فِى ٱلنَّارِ",969],["28:30:10",389,"ٱلْمُبَـٰرَكَةِ","blessed","ٱلْأَيْمَنِ فِى ٱلْبُقْعَةِ","مِنَ ٱلشَّجَرَةِ أَن",1602],["34:18:6",430,"بَـٰرَكْنَا","We had blessed","وَبَيْنَ ٱلْقُرَى ٱلَّتِى","فِيهَا قُرًۭى ظَـٰهِرَةًۭ",969],["37:113:1",450,"وَبَـٰرَكْنَا","And We blessed","","عَلَيْهِ وَعَلَىٰٓ إِسْحَـٰقَ ۚ",969],["38:29:4",455,"مُبَـٰرَكٌۭ","blessed","كِتَـٰبٌ أَنزَلْنَـٰهُ إِلَيْكَ","لِّيَدَّبَّرُوٓا۟ ءَايَـٰتِهِۦ وَلِيَتَذَكَّرَ",988],["40:64:18",474,"فَتَبَارَكَ","Then blessed (is)","ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ ۖ","ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",926],["41:10:6",477,"وَبَـٰرَكَ","and He blessed","رَوَٰسِىَ مِن فَوْقِهَا","فِيهَا وَقَدَّرَ فِيهَآ",969],["43:85:1",495,"وَتَبَارَكَ","And blessed (is)","","ٱلَّذِى لَهُۥ مُلْكُ",926],["44:3:5",496,"مُّبَـٰرَكَةٍ ۚ","Blessed","أَنزَلْنَـٰهُ فِى لَيْلَةٍۢ","إِنَّا كُنَّا مُنذِرِينَ",1602],["50:9:5",518,"مُّبَـٰرَكًۭا","blessed","مِنَ ٱلسَّمَآءِ مَآءًۭ","فَأَنۢبَتْنَا بِهِۦ جَنَّـٰتٍۢ",988],["55:78:1",534,"تَبَـٰرَكَ","Blessed is","","ٱسْمُ رَبِّكَ ذِى",926],["67:1:1",562,"تَبَـٰرَكَ","Blessed is","","ٱلَّذِى بِيَدِهِ ٱلْمُلْكُ",926]]