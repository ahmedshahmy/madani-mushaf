[["37:46:2",447,"لَذَّةٍۢ","delicious","بَيْضَآءَ","لِّلشَّـٰرِبِينَ",2428],["43:71:11",494,"وَتَلَذُّ","and delights","مَا تَشْتَهِيهِ ٱلْأَنفُسُ","ٱلْأَعْيُنُ ۖ وَأَنتُمْ فِيهَا",4384],["47:15:21",508,"لَّذَّةٍۢ","delicious","وَأَنْهَـٰرٌۭ مِّنْ خَمْرٍۢ","لِّلشَّـٰرِبِينَ وَأَنْهَـٰرٌۭ مِّنْ",2428]]