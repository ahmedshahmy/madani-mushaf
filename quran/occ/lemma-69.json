[["2:14:13",3,"مَعَكُمْ","(are) with you","شَيَـٰطِينِهِمْ قَالُوٓا۟ إِنَّا","إِنَّمَا نَحْنُ مُسْتَهْزِءُونَ",69],["2:89:9",14,"مَعَهُمْ","with them","ٱللَّهِ مُصَدِّقٌۭ لِّمَا","وَكَانُوا۟ مِن قَبْلُ",69],["2:101:9",15,"مَعَهُمْ","(was) with them","ٱللَّهِ مُصَدِّقٌۭ لِّمَا","نَبَذَ فَرِيقٌۭ مِّنَ",69],["2:153:9",23,"مَعَ","(is) with","وَٱلصَّلَوٰةِ ۚ إِنَّ ٱللَّهَ","ٱلصَّـٰبِرِينَ",69],["2:194:21",30,"مَعَ","(is) with","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","ٱلْمُتَّقِينَ",69],["2:213:11",33,"مَعَهُمُ","with them","مُبَشِّرِينَ وَمُنذِرِينَ وَأَنزَلَ","ٱلْكِتَـٰبَ بِٱلْحَقِّ لِيَحْكُمَ",69],["2:214:22",33,"مَعَهُۥ","with him","ٱلرَّسُولُ وَٱلَّذِينَ ءَامَنُوا۟","مَتَىٰ نَصْرُ ٱللَّهِ ۗ",69],["2:249:35",41,"مَعَهُۥ","with him","هُوَ وَٱلَّذِينَ ءَامَنُوا۟","قَالُوا۟ لَا طَاقَةَ",69],["2:249:59",41,"مَعَ","(is) with","بِإِذْنِ ٱللَّهِ ۗ وَٱللَّهُ","ٱلصَّـٰبِرِينَ",69],["3:43:6",55,"مَعَ","with","لِرَبِّكِ وَٱسْجُدِى وَٱرْكَعِى","ٱلرَّٰكِعِينَ",69],["3:53:8",57,"مَعَ","among","وَٱتَّبَعْنَا ٱلرَّسُولَ فَٱكْتُبْنَا","ٱلشَّـٰهِدِينَ",69],["3:81:16",60,"مَعَكُمْ","(is) with you","رَسُولٌۭ مُّصَدِّقٌۭ لِّمَا","لَتُؤْمِنُنَّ بِهِۦ وَلَتَنصُرُنَّهُۥ ۚ",69],["3:81:31",60,"مَعَكُم","with you","قَالَ فَٱشْهَدُوا۟ وَأَنَا۠","مِّنَ ٱلشَّـٰهِدِينَ",69],["3:146:5",68,"مَعَهُۥ","with him","مِّن نَّبِىٍّۢ قَـٰتَلَ","رِبِّيُّونَ كَثِيرٌۭ فَمَا",69],["3:193:19",75,"مَعَ","with","عَنَّا سَيِّـَٔاتِنَا وَتَوَفَّنَا","ٱلْأَبْرَارِ",69],["4:47:10",86,"مَعَكُم","with you","نَزَّلْنَا مُصَدِّقًۭا لِّمَا","مِّن قَبْلِ أَن",69],["4:69:6",89,"مَعَ","(will be) with","ٱللَّهَ وَٱلرَّسُولَ فَأُو۟لَـٰٓئِكَ","ٱلَّذِينَ أَنْعَمَ ٱللَّهُ",69],["4:72:16",89,"مَّعَهُمْ","with them","إِذْ لَمْ أَكُن","شَهِيدًۭا",69],["4:73:15",89,"مَعَهُمْ","with them","مَوَدَّةٌۭ يَـٰلَيْتَنِى كُنتُ","فَأَفُوزَ فَوْزًا عَظِيمًۭا",69],["4:102:10",95,"مَّعَكَ","with you","فَلْتَقُمْ طَآئِفَةٌۭ مِّنْهُم","وَلْيَأْخُذُوٓا۟ أَسْلِحَتَهُمْ فَإِذَا",69],["4:102:24",95,"مَعَكَ","with you","لَمْ يُصَلُّوا۟ فَلْيُصَلُّوا۟","وَلْيَأْخُذُوا۟ حِذْرَهُمْ وَأَسْلِحَتَهُمْ ۗ",69],["4:108:9",96,"مَعَهُمْ","(is) with them","مِنَ ٱللَّهِ وَهُوَ","إِذْ يُبَيِّتُونَ مَا",69],["4:140:17",100,"مَعَهُمْ","with them","بِهَا فَلَا تَقْعُدُوا۟","حَتَّىٰ يَخُوضُوا۟ فِى",69],["4:141:13",101,"مَّعَكُمْ","with you","قَالُوٓا۟ أَلَمْ نَكُن","وَإِن كَانَ لِلْكَـٰفِرِينَ",69],["4:146:11",101,"مَعَ","with","دِينَهُمْ لِلَّهِ فَأُو۟لَـٰٓئِكَ","ٱلْمُؤْمِنِينَ ۖ وَسَوْفَ يُؤْتِ",69],["5:12:15",109,"مَعَكُمْ ۖ","with you","وَقَالَ ٱللَّهُ إِنِّى","لَئِنْ أَقَمْتُمُ ٱلصَّلَوٰةَ",69],["5:36:12",113,"مَعَهُۥ","with it","ٱلْأَرْضِ جَمِيعًۭا وَمِثْلَهُۥ","لِيَفْتَدُوا۟ بِهِۦ مِنْ",69],["5:53:11",117,"لَمَعَكُمْ ۚ","(were) with you","جَهْدَ أَيْمَـٰنِهِمْ ۙ إِنَّهُمْ","حَبِطَتْ أَعْمَـٰلُهُمْ فَأَصْبَحُوا۟",69],["5:83:20",121,"مَعَ","with","رَبَّنَآ ءَامَنَّا فَٱكْتُبْنَا","ٱلشَّـٰهِدِينَ",69],["5:84:14",122,"مَعَ","with","أَن يُدْخِلَنَا رَبُّنَا","ٱلْقَوْمِ ٱلصَّـٰلِحِينَ",69],["6:19:22",130,"مَعَ","with","أَئِنَّكُمْ لَتَشْهَدُونَ أَنَّ","ٱللَّهِ ءَالِهَةً أُخْرَىٰ ۚ",69],["6:68:21",135,"مَعَ","with","تَقْعُدْ بَعْدَ ٱلذِّكْرَىٰ","ٱلْقَوْمِ ٱلظَّـٰلِمِينَ",69],["6:94:15",139,"مَعَكُمْ","with you","ظُهُورِكُمْ ۖ وَمَا نَرَىٰ","شُفَعَآءَكُمُ ٱلَّذِينَ زَعَمْتُمْ",69],["6:150:14",148,"مَعَهُمْ ۚ","with them","شَهِدُوا۟ فَلَا تَشْهَدْ","وَلَا تَتَّبِعْ أَهْوَآءَ",69],["7:47:11",156,"مَعَ","with","رَبَّنَا لَا تَجْعَلْنَا","ٱلْقَوْمِ ٱلظَّـٰلِمِينَ",69],["7:64:4",158,"مَعَهُۥ","(were) with him","فَكَذَّبُوهُ فَأَنجَيْنَـٰهُ وَٱلَّذِينَ","فِى ٱلْفُلْكِ وَأَغْرَقْنَا",69],["7:71:23",159,"مَعَكُم","with you","سُلْطَـٰنٍۢ ۚ فَٱنتَظِرُوٓا۟ إِنِّى","مِّنَ ٱلْمُنتَظِرِينَ",69],["7:72:3",159,"مَعَهُۥ","with him","فَأَنجَيْنَـٰهُ وَٱلَّذِينَ","بِرَحْمَةٍۢ مِّنَّا وَقَطَعْنَا",69],["7:88:11",162,"مَعَكَ","with you","يَـٰشُعَيْبُ وَٱلَّذِينَ ءَامَنُوا۟","مِن قَرْيَتِنَآ أَوْ",69],["7:105:16",164,"مَعِىَ","with me","مِّن رَّبِّكُمْ فَأَرْسِلْ","بَنِىٓ إِسْرَٰٓءِيلَ",69],["7:131:13",166,"مَّعَهُۥٓ ۗ","(were) with him","يَطَّيَّرُوا۟ بِمُوسَىٰ وَمَن","أَلَآ إِنَّمَا طَـٰٓئِرُهُمْ",69],["7:134:20",166,"مَعَكَ","with you","لَنُؤْمِنَنَّ لَكَ وَلَنُرْسِلَنَّ","بَنِىٓ إِسْرَٰٓءِيلَ",69],["7:150:37",169,"مَعَ","with","ٱلْأَعْدَآءَ وَلَا تَجْعَلْنِى","ٱلْقَوْمِ ٱلظَّـٰلِمِينَ",69],["7:157:40",170,"مَعَهُۥٓ ۙ","with him","ٱلنُّورَ ٱلَّذِىٓ أُنزِلَ","أُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ",69],["8:12:7",178,"مَعَكُمْ","with you","إِلَى ٱلْمَلَـٰٓئِكَةِ أَنِّى","فَثَبِّتُوا۟ ٱلَّذِينَ ءَامَنُوا۟ ۚ",69],["8:19:23",179,"مَعَ","(is) with","كَثُرَتْ وَأَنَّ ٱللَّهَ","ٱلْمُؤْمِنِينَ",69],["8:46:12",183,"مَعَ","(is) with","وَٱصْبِرُوٓا۟ ۚ إِنَّ ٱللَّهَ","ٱلصَّـٰبِرِينَ",69],["8:66:25",185,"مَعَ","(is) with","بِإِذْنِ ٱللَّهِ ۗ وَٱللَّهُ","ٱلصَّـٰبِرِينَ",69],["8:75:7",186,"مَعَكُمْ","with you","بَعْدُ وَهَاجَرُوا۟ وَجَـٰهَدُوا۟","فَأُو۟لَـٰٓئِكَ مِنكُمْ ۚ وَأُو۟لُوا۟",69],["9:36:35",192,"مَعَ","(is) with","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","ٱلْمُتَّقِينَ",69],["9:40:23",193,"مَعَنَا ۖ","(is) with us","تَحْزَنْ إِنَّ ٱللَّهَ","فَأَنزَلَ ٱللَّهُ سَكِينَتَهُۥ",69],["9:42:17",194,"مَعَكُمْ","with you","لَوِ ٱسْتَطَعْنَا لَخَرَجْنَا","يُهْلِكُونَ أَنفُسَهُمْ وَٱللَّهُ",69],["9:46:14",194,"مَعَ","with","فَثَبَّطَهُمْ وَقِيلَ ٱقْعُدُوا۟","ٱلْقَـٰعِدِينَ",69],["9:52:21",195,"مَعَكُم","with you","بِأَيْدِينَا ۖ فَتَرَبَّصُوٓا۟ إِنَّا","مُّتَرَبِّصُونَ",69],["9:83:12",200,"مَعِىَ","with me","فَقُل لَّن تَخْرُجُوا۟","أَبَدًۭا وَلَن تُقَـٰتِلُوا۟",69],["9:83:16",200,"مَعِىَ","with me","أَبَدًۭا وَلَن تُقَـٰتِلُوا۟","عَدُوًّا ۖ إِنَّكُمْ رَضِيتُم",69],["9:83:24",200,"مَعَ","with","أَوَّلَ مَرَّةٍۢ فَٱقْعُدُوا۟","ٱلْخَـٰلِفِينَ",69],["9:86:8",200,"مَعَ","with","ءَامِنُوا۟ بِٱللَّهِ وَجَـٰهِدُوا۟","رَسُولِهِ ٱسْتَـْٔذَنَكَ أُو۟لُوا۟",69],["9:86:17",200,"مَّعَ","with","وَقَالُوا۟ ذَرْنَا نَكُن","ٱلْقَـٰعِدِينَ",69],["9:87:4",201,"مَعَ","with","رَضُوا۟ بِأَن يَكُونُوا۟","ٱلْخَوَالِفِ وَطُبِعَ عَلَىٰ",69],["9:88:5",201,"مَعَهُۥ","with him","ٱلرَّسُولُ وَٱلَّذِينَ ءَامَنُوا۟","جَـٰهَدُوا۟ بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ ۚ",69],["9:93:11",201,"مَعَ","with","رَضُوا۟ بِأَن يَكُونُوا۟","ٱلْخَوَالِفِ وَطَبَعَ ٱللَّهُ",69],["9:119:7",206,"مَعَ","with","ٱتَّقُوا۟ ٱللَّهَ وَكُونُوا۟","ٱلصَّـٰدِقِينَ",69],["9:123:15",207,"مَعَ","(is) with","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","ٱلْمُتَّقِينَ",69],["10:20:14",210,"مَعَكُم","with you","لِلَّهِ فَٱنتَظِرُوٓا۟ إِنِّى","مِّنَ ٱلْمُنتَظِرِينَ",69],["10:73:4",217,"مَّعَهُۥ","(were) with him","فَكَذَّبُوهُ فَنَجَّيْنَـٰهُ وَمَن","فِى ٱلْفُلْكِ وَجَعَلْنَـٰهُمْ",69],["10:102:13",220,"مَعَكُم","with you","قُلْ فَٱنتَظِرُوٓا۟ إِنِّى","مِّنَ ٱلْمُنتَظِرِينَ",69],["11:12:18",222,"مَعَهُۥ","with him","كَنزٌ أَوْ جَآءَ","مَلَكٌ ۚ إِنَّمَآ أَنتَ",69],["11:40:24",226,"مَعَهُۥٓ","with him","ءَامَنَ ۚ وَمَآ ءَامَنَ","إِلَّا قَلِيلٌۭ",69],["11:42:15",226,"مَّعَنَا","with us","مَعْزِلٍۢ يَـٰبُنَىَّ ٱرْكَب","وَلَا تَكُن مَّعَ",69],["11:42:18",226,"مَّعَ","with","مَّعَنَا وَلَا تَكُن","ٱلْكَـٰفِرِينَ",69],["11:48:11",227,"مَّعَكَ ۚ","with you","وَعَلَىٰٓ أُمَمٍۢ مِّمَّن","وَأُمَمٌۭ سَنُمَتِّعُهُمْ ثُمَّ",69],["11:58:8",228,"مَعَهُۥ","with him","هُودًۭا وَٱلَّذِينَ ءَامَنُوا۟","بِرَحْمَةٍۢ مِّنَّا وَنَجَّيْنَـٰهُم",69],["11:66:8",229,"مَعَهُۥ","with him","صَـٰلِحًۭا وَٱلَّذِينَ ءَامَنُوا۟","بِرَحْمَةٍۢ مِّنَّا وَمِنْ",69],["11:93:18",232,"مَعَكُمْ","with you","كَـٰذِبٌۭ ۖ وَٱرْتَقِبُوٓا۟ إِنِّى","رَقِيبٌۭ",69],["11:94:8",232,"مَعَهُۥ","with him","شُعَيْبًۭا وَٱلَّذِينَ ءَامَنُوا۟","بِرَحْمَةٍۢ مِّنَّا وَأَخَذَتِ",69],["11:112:6",234,"مَعَكَ","with you","أُمِرْتَ وَمَن تَابَ","وَلَا تَطْغَوْا۟ ۚ إِنَّهُۥ",69],["12:12:2",236,"مَعَنَا","with us","أَرْسِلْهُ","غَدًۭا يَرْتَعْ وَيَلْعَبْ",69],["12:36:2",239,"مَعَهُ","with him","وَدَخَلَ","ٱلسِّجْنَ فَتَيَانِ ۖ قَالَ",69],["12:63:11",242,"مَعَنَآ","with us","مِنَّا ٱلْكَيْلُ فَأَرْسِلْ","أَخَانَا نَكْتَلْ وَإِنَّا",69],["12:66:4",243,"مَعَكُمْ","with you","قَالَ لَنْ أُرْسِلَهُۥ","حَتَّىٰ تُؤْتُونِ مَوْثِقًۭا",69],["13:18:17",251,"مَعَهُۥ","with it","ٱلْأَرْضِ جَمِيعًۭا وَمِثْلَهُۥ","لَٱفْتَدَوْا۟ بِهِۦٓ ۚ أُو۟لَـٰٓئِكَ",69],["15:31:6",263,"مَعَ","with","أَبَىٰٓ أَن يَكُونَ","ٱلسَّـٰجِدِينَ",69],["15:32:7",264,"مَعَ","with","لَكَ أَلَّا تَكُونَ","ٱلسَّـٰجِدِينَ",69],["15:96:3",267,"مَعَ","with","ٱلَّذِينَ يَجْعَلُونَ","ٱللَّهِ إِلَـٰهًا ءَاخَرَ ۚ",69],["16:128:3",281,"مَعَ","(is) with","إِنَّ ٱللَّهَ","ٱلَّذِينَ ٱتَّقَوا۟ وَّٱلَّذِينَ",69],["17:3:4",282,"مَعَ","with","ذُرِّيَّةَ مَنْ حَمَلْنَا","نُوحٍ ۚ إِنَّهُۥ كَانَ",69],["17:22:3",284,"مَعَ","with","لَّا تَجْعَلْ","ٱللَّهِ إِلَـٰهًا ءَاخَرَ",69],["17:39:10",286,"مَعَ","with","ٱلْحِكْمَةِ ۗ وَلَا تَجْعَلْ","ٱللَّهِ إِلَـٰهًا ءَاخَرَ",69],["17:42:4",286,"مَعَهُۥٓ","with Him","قُل لَّوْ كَانَ","ءَالِهَةٌۭ كَمَا يَقُولُونَ",69],["17:103:8",292,"مَّعَهُۥ","(were) with him","ٱلْأَرْضِ فَأَغْرَقْنَـٰهُ وَمَن","جَمِيعًۭا",69],["18:28:3",297,"مَعَ","with","وَٱصْبِرْ نَفْسَكَ","ٱلَّذِينَ يَدْعُونَ رَبَّهُم",69],["18:67:5",301,"مَعِىَ","with me","إِنَّكَ لَن تَسْتَطِيعَ","صَبْرًۭا",69],["18:72:7",301,"مَعِىَ","with me","إِنَّكَ لَن تَسْتَطِيعَ","صَبْرًۭا",69],["18:75:8",302,"مَعِىَ","with me","إِنَّكَ لَن تَسْتَطِيعَ","صَبْرًۭا",69],["19:58:13",309,"مَعَ","with","ءَادَمَ وَمِمَّنْ حَمَلْنَا","نُوحٍۢ وَمِن ذُرِّيَّةِ",69],["20:46:5",314,"مَعَكُمَآ","with you both","لَا تَخَافَآ ۖ إِنَّنِى","أَسْمَعُ وَأَرَىٰ",69],["20:47:7",314,"مَعَنَا","with us","رَسُولَا رَبِّكَ فَأَرْسِلْ","بَنِىٓ إِسْرَٰٓءِيلَ وَلَا",69],["21:24:12",323,"مَّعِىَ","(are) with me","هَـٰذَا ذِكْرُ مَن","وَذِكْرُ مَن قَبْلِى ۗ",69],["21:79:8",328,"مَعَ","with","حُكْمًۭا وَعِلْمًۭا ۚ وَسَخَّرْنَا","دَاوُۥدَ ٱلْجِبَالَ يُسَبِّحْنَ",69],["21:84:11",329,"مَّعَهُمْ","with them","وَءَاتَيْنَـٰهُ أَهْلَهُۥ وَمِثْلَهُم","رَحْمَةًۭ مِّنْ عِندِنَا",69],["23:28:5",344,"مَّعَكَ","(is) with you","ٱسْتَوَيْتَ أَنتَ وَمَن","عَلَى ٱلْفُلْكِ فَقُلِ",69],["23:91:8",348,"مَعَهُۥ","with Him","وَلَدٍۢ وَمَا كَانَ","مِنْ إِلَـٰهٍ ۚ إِذًۭا",69],["23:117:3",349,"مَعَ","with","وَمَن يَدْعُ","ٱللَّهِ إِلَـٰهًا ءَاخَرَ",69],["24:62:9",359,"مَعَهُۥ","with him","وَرَسُولِهِۦ وَإِذَا كَانُوا۟","عَلَىٰٓ أَمْرٍۢ جَامِعٍۢ",69],["25:7:15",360,"مَعَهُۥ","with him","إِلَيْهِ مَلَكٌۭ فَيَكُونَ","نَذِيرًا",69],["25:27:9",362,"مَعَ","with","يَقُولُ يَـٰلَيْتَنِى ٱتَّخَذْتُ","ٱلرَّسُولِ سَبِيلًۭا",69],["25:35:6",363,"مَعَهُۥٓ","with him","مُوسَى ٱلْكِتَـٰبَ وَجَعَلْنَا","أَخَاهُ هَـٰرُونَ وَزِيرًۭا",69],["25:68:4",366,"مَعَ","with","وَٱلَّذِينَ لَا يَدْعُونَ","ٱللَّهِ إِلَـٰهًا ءَاخَرَ",69],["26:15:6",367,"مَعَكُم","(are) with you","فَٱذْهَبَا بِـَٔايَـٰتِنَآ ۖ إِنَّا","مُّسْتَمِعُونَ",69],["26:17:3",367,"مَعَنَا","with us","أَنْ أَرْسِلْ","بَنِىٓ إِسْرَٰٓءِيلَ",69],["26:62:4",370,"مَعِىَ","with me","قَالَ كَلَّآ ۖ إِنَّ","رَبِّى سَيَهْدِينِ",69],["26:65:4",370,"مَّعَهُۥٓ","(were) with him","وَأَنجَيْنَا مُوسَىٰ وَمَن","أَجْمَعِينَ",69],["26:118:7",372,"مَّعِىَ","(are) with me","فَتْحًۭا وَنَجِّنِى وَمَن","مِنَ ٱلْمُؤْمِنِينَ",69],["26:119:3",372,"مَّعَهُۥ","(were) with him","فَأَنجَيْنَـٰهُ وَمَن","فِى ٱلْفُلْكِ ٱلْمَشْحُونِ",69],["26:213:3",376,"مَعَ","with","فَلَا تَدْعُ","ٱللَّهِ إِلَـٰهًا ءَاخَرَ",69],["27:44:24",380,"مَعَ","with","ظَلَمْتُ نَفْسِى وَأَسْلَمْتُ","سُلَيْمَـٰنَ لِلَّهِ رَبِّ",69],["27:47:5",381,"مَّعَكَ ۚ","with you","ٱطَّيَّرْنَا بِكَ وَبِمَن","قَالَ طَـٰٓئِرُكُمْ عِندَ",69],["27:60:22",382,"مَّعَ","with","تُنۢبِتُوا۟ شَجَرَهَآ ۗ أَءِلَـٰهٌۭ","ٱللَّهِ ۚ بَلْ هُمْ",69],["27:61:16",382,"مَّعَ","with","ٱلْبَحْرَيْنِ حَاجِزًا ۗ أَءِلَـٰهٌۭ","ٱللَّهِ ۚ بَلْ أَكْثَرُهُمْ",69],["27:62:12",382,"مَّعَ","with","خُلَفَآءَ ٱلْأَرْضِ ۗ أَءِلَـٰهٌۭ","ٱللَّهِ ۚ قَلِيلًۭا مَّا",69],["27:63:15",382,"مَّعَ","with","يَدَىْ رَحْمَتِهِۦٓ ۗ أَءِلَـٰهٌۭ","ٱللَّهِ ۚ تَعَـٰلَى ٱللَّهُ",69],["27:64:12",383,"مَّعَ","with","ٱلسَّمَآءِ وَٱلْأَرْضِ ۗ أَءِلَـٰهٌۭ","ٱللَّهِ ۚ قُلْ هَاتُوا۟",69],["28:34:8",389,"مَعِىَ","with me","مِنِّى لِسَانًۭا فَأَرْسِلْهُ","رِدْءًۭا يُصَدِّقُنِىٓ ۖ إِنِّىٓ",69],["28:57:5",392,"مَعَكَ","with you","إِن نَّتَّبِعِ ٱلْهُدَىٰ","نُتَخَطَّفْ مِنْ أَرْضِنَآ ۚ",69],["28:88:3",396,"مَعَ","with","وَلَا تَدْعُ","ٱللَّهِ إِلَـٰهًا ءَاخَرَ ۘ",69],["29:10:24",397,"مَعَكُمْ ۚ","with you","لَيَقُولُنَّ إِنَّا كُنَّا","أَوَلَيْسَ ٱللَّهُ بِأَعْلَمَ",69],["29:13:4",397,"مَّعَ","with","وَلَيَحْمِلُنَّ أَثْقَالَهُمْ وَأَثْقَالًۭا","أَثْقَالِهِمْ ۖ وَلَيُسْـَٔلُنَّ يَوْمَ",69],["29:69:8",404,"لَمَعَ","surely (is) with","سُبُلَنَا ۚ وَإِنَّ ٱللَّهَ","ٱلْمُحْسِنِينَ",69],["33:50:27",424,"مَعَكَ","with you","خَـٰلَـٰتِكَ ٱلَّـٰتِى هَاجَرْنَ","وَٱمْرَأَةًۭ مُّؤْمِنَةً إِن",69],["34:10:8",429,"مَعَهُۥ","with him","فَضْلًۭا ۖ يَـٰجِبَالُ أَوِّبِى","وَٱلطَّيْرَ ۖ وَأَلَنَّا لَهُ",69],["36:19:3",441,"مَّعَكُمْ ۚ","(be) with you","قَالُوا۟ طَـٰٓئِرُكُم","أَئِن ذُكِّرْتُم ۚ بَلْ",69],["37:102:3",449,"مَعَهُ","the (age of) working with him","فَلَمَّا بَلَغَ","ٱلسَّعْىَ قَالَ يَـٰبُنَىَّ",69],["38:18:4",454,"مَعَهُۥ","with him","إِنَّا سَخَّرْنَا ٱلْجِبَالَ","يُسَبِّحْنَ بِٱلْعَشِىِّ وَٱلْإِشْرَاقِ",69],["38:43:5",456,"مَّعَهُمْ","with them","لَهُۥٓ أَهْلَهُۥ وَمِثْلَهُم","رَحْمَةًۭ مِّنَّا وَذِكْرَىٰ",69],["38:59:4",456,"مَّعَكُمْ ۖ","(in) with you","هَـٰذَا فَوْجٌۭ مُّقْتَحِمٌۭ","لَا مَرْحَبًۢا بِهِمْ ۚ",69],["39:47:10",463,"مَعَهُۥ","with it","ٱلْأَرْضِ جَمِيعًۭا وَمِثْلَهُۥ","لَٱفْتَدَوْا۟ بِهِۦ مِن",69],["40:25:11",469,"مَعَهُۥ","with him","أَبْنَآءَ ٱلَّذِينَ ءَامَنُوا۟","وَٱسْتَحْيُوا۟ نِسَآءَهُمْ ۚ وَمَا",69],["43:53:9",493,"مَعَهُ","with him","ذَهَبٍ أَوْ جَآءَ","ٱلْمَلَـٰٓئِكَةُ مُقْتَرِنِينَ",69],["47:35:9",510,"مَعَكُمْ","(is) with you","وَأَنتُمُ ٱلْأَعْلَوْنَ وَٱللَّهُ","وَلَن يَتِرَكُمْ أَعْمَـٰلَكُمْ",69],["48:4:10",511,"مَّعَ","with","ٱلْمُؤْمِنِينَ لِيَزْدَادُوٓا۟ إِيمَـٰنًۭا","إِيمَـٰنِهِمْ ۗ وَلِلَّهِ جُنُودُ",69],["48:29:5",515,"مَعَهُۥٓ","(are) with him","رَّسُولُ ٱللَّهِ ۚ وَٱلَّذِينَ","أَشِدَّآءُ عَلَى ٱلْكُفَّارِ",69],["50:21:4",519,"مَّعَهَا","with it","وَجَآءَتْ كُلُّ نَفْسٍۢ","سَآئِقٌۭ وَشَهِيدٌۭ",69],["50:26:3",519,"مَعَ","with","ٱلَّذِى جَعَلَ","ٱللَّهِ إِلَـٰهًا ءَاخَرَ",69],["51:51:3",522,"مَعَ","with","وَلَا تَجْعَلُوا۟","ٱللَّهِ إِلَـٰهًا ءَاخَرَ ۖ",69],["52:31:4",524,"مَعَكُم","with you","قُلْ تَرَبَّصُوا۟ فَإِنِّى","مِّنَ ٱلْمُتَرَبِّصِينَ",69],["57:4:29",538,"مَعَكُمْ","(is) with you","يَعْرُجُ فِيهَا ۖ وَهُوَ","أَيْنَ مَا كُنتُمْ ۚ",69],["57:14:4",539,"مَّعَكُمْ ۖ","with you","يُنَادُونَهُمْ أَلَمْ نَكُن","قَالُوا۟ بَلَىٰ وَلَـٰكِنَّكُمْ",69],["57:25:6",541,"مَعَهُمُ","with them","رُسُلَنَا بِٱلْبَيِّنَـٰتِ وَأَنزَلْنَا","ٱلْكِتَـٰبَ وَٱلْمِيزَانَ لِيَقُومَ",69],["58:7:33",543,"مَعَهُمْ","(is) with them","أَكْثَرَ إِلَّا هُوَ","أَيْنَ مَا كَانُوا۟ ۖ",69],["59:11:16",547,"مَعَكُمْ","with you","لَئِنْ أُخْرِجْتُمْ لَنَخْرُجَنَّ","وَلَا نُطِيعُ فِيكُمْ",69],["59:12:5",547,"مَعَهُمْ","with them","أُخْرِجُوا۟ لَا يَخْرُجُونَ","وَلَئِن قُوتِلُوا۟ لَا",69],["60:4:9",549,"مَعَهُۥٓ","with him","فِىٓ إِبْرَٰهِيمَ وَٱلَّذِينَ","إِذْ قَالُوا۟ لِقَوْمِهِمْ",69],["66:8:28",561,"مَعَهُۥ ۖ","with him","ٱلنَّبِىَّ وَٱلَّذِينَ ءَامَنُوا۟","نُورُهُمْ يَسْعَىٰ بَيْنَ",69],["66:10:26",561,"مَعَ","with","وَقِيلَ ٱدْخُلَا ٱلنَّارَ","ٱلدَّٰخِلِينَ",69],["67:28:7",564,"مَّعِىَ","(is) with me","أَهْلَكَنِىَ ٱللَّهُ وَمَن","أَوْ رَحِمَنَا فَمَن",69],["72:18:6",573,"مَعَ","with","لِلَّهِ فَلَا تَدْعُوا۟","ٱللَّهِ أَحَدًۭا",69],["73:20:15",575,"مَعَكَ ۚ","(are) with you","وَطَآئِفَةٌۭ مِّنَ ٱلَّذِينَ","وَٱللَّهُ يُقَدِّرُ ٱلَّيْلَ",69],["74:45:3",576,"مَعَ","with","وَكُنَّا نَخُوضُ","ٱلْخَآئِضِينَ",69]]