[["16:48:17",272,"دَٰخِرُونَ","(are) humble","سُجَّدًۭا لِّلَّهِ وَهُمْ","",1544],["27:87:18",384,"دَٰخِرِينَ","humbled","ٱللَّهُ ۚ وَكُلٌّ أَتَوْهُ","",1544],["37:18:4",446,"دَٰخِرُونَ","(will be) humiliated","قُلْ نَعَمْ وَأَنتُمْ","",1544],["40:60:13",474,"دَاخِرِينَ","(in) humiliation","عِبَادَتِى سَيَدْخُلُونَ جَهَنَّمَ","",1544]]