[["6:84:16",138,"وَيُوسُفَ","and Yusuf","دَاوُۥدَ وَسُلَيْمَـٰنَ وَأَيُّوبَ","وَمُوسَىٰ وَهَـٰرُونَ ۚ وَكَذَٰلِكَ",408],["12:4:3",235,"يُوسُفُ","Yusuf","إِذْ قَالَ","لِأَبِيهِ يَـٰٓأَبَتِ إِنِّى",408],["12:7:4",236,"يُوسُفَ","Yusuf","۞ لَّقَدْ كَانَ فِى","وَإِخْوَتِهِۦٓ ءَايَـٰتٌۭ لِّلسَّآئِلِينَ",408],["12:8:3",236,"لَيُوسُفُ","Surely Yusuf","إِذْ قَالُوا۟","وَأَخُوهُ أَحَبُّ إِلَىٰٓ",408],["12:9:2",236,"يُوسُفَ","Yusuf","ٱقْتُلُوا۟","أَوِ ٱطْرَحُوهُ أَرْضًۭا",408],["12:10:6",236,"يُوسُفَ","Yusuf","مِّنْهُمْ لَا تَقْتُلُوا۟","وَأَلْقُوهُ فِى غَيَـٰبَتِ",408],["12:11:8",236,"يُوسُفَ","Yusuf","لَا تَأْمَ۫نَّا عَلَىٰ","وَإِنَّا لَهُۥ لَنَـٰصِحُونَ",408],["12:17:7",237,"يُوسُفَ","Yusuf","ذَهَبْنَا نَسْتَبِقُ وَتَرَكْنَا","عِندَ مَتَـٰعِنَا فَأَكَلَهُ",408],["12:21:17",237,"لِيُوسُفَ","Yusuf","وَلَدًۭا ۚ وَكَذَٰلِكَ مَكَّنَّا","فِى ٱلْأَرْضِ وَلِنُعَلِّمَهُۥ",408],["12:29:1",238,"يُوسُفُ","Yusuf","","أَعْرِضْ عَنْ هَـٰذَا ۚ",408],["12:46:1",241,"يُوسُفُ","Yusuf","","أَيُّهَا ٱلصِّدِّيقُ أَفْتِنَا",408],["12:51:6",241,"يُوسُفَ","Yusuf","خَطْبُكُنَّ إِذْ رَٰوَدتُّنَّ","عَن نَّفْسِهِۦ ۚ قُلْنَ",408],["12:56:3",242,"لِيُوسُفَ","[to] Yusuf","وَكَذَٰلِكَ مَكَّنَّا","فِى ٱلْأَرْضِ يَتَبَوَّأُ",408],["12:58:3",242,"يُوسُفَ","(of) Yusuf","وَجَآءَ إِخْوَةُ","فَدَخَلُوا۟ عَلَيْهِ فَعَرَفَهُمْ",408],["12:69:4",243,"يُوسُفَ","Yusuf","وَلَمَّا دَخَلُوا۟ عَلَىٰ","ءَاوَىٰٓ إِلَيْهِ أَخَاهُ ۖ",408],["12:76:13",244,"لِيُوسُفَ ۖ","for Yusuf","أَخِيهِ ۚ كَذَٰلِكَ كِدْنَا","مَا كَانَ لِيَأْخُذَ",408],["12:77:11",244,"يُوسُفُ","But Yusuf kept it secret","مِن قَبْلُ ۚ فَأَسَرَّهَا","فِى نَفْسِهِۦ وَلَمْ",408],["12:80:23",245,"يُوسُفَ ۖ","Yusuf","مَا فَرَّطتُمْ فِى","فَلَنْ أَبْرَحَ ٱلْأَرْضَ",408],["12:84:6",245,"يُوسُفَ","Yusuf","وَقَالَ يَـٰٓأَسَفَىٰ عَلَىٰ","وَٱبْيَضَّتْ عَيْنَاهُ مِنَ",408],["12:85:5",245,"يُوسُفَ","Yusuf","تَٱللَّهِ تَفْتَؤُا۟ تَذْكُرُ","حَتَّىٰ تَكُونَ حَرَضًا",408],["12:87:5",246,"يُوسُفَ","Yusuf","ٱذْهَبُوا۟ فَتَحَسَّسُوا۟ مِن","وَأَخِيهِ وَلَا تَا۟يْـَٔسُوا۟",408],["12:89:6",246,"بِيُوسُفَ","with Yusuf","عَلِمْتُم مَّا فَعَلْتُم","وَأَخِيهِ إِذْ أَنتُمْ",408],["12:90:4",246,"يُوسُفُ ۖ","Yusuf","قَالُوٓا۟ أَءِنَّكَ لَأَنتَ","قَالَ أَنَا۠ يُوسُفُ",408],["12:90:7",246,"يُوسُفُ","Yusuf","يُوسُفُ ۖ قَالَ أَنَا۠","وَهَـٰذَآ أَخِى ۖ قَدْ",408],["12:94:9",246,"يُوسُفَ ۖ","(of) Yusuf","إِنِّى لَأَجِدُ رِيحَ","لَوْلَآ أَن تُفَنِّدُونِ",408],["12:99:4",247,"يُوسُفَ","Yusuf","فَلَمَّا دَخَلُوا۟ عَلَىٰ","ءَاوَىٰٓ إِلَيْهِ أَبَوَيْهِ",408],["40:34:3",471,"يُوسُفُ","Yusuf","وَلَقَدْ جَآءَكُمْ","مِن قَبْلُ بِٱلْبَيِّنَـٰتِ",408]]