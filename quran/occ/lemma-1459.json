[["18:31:20",297,"وَإِسْتَبْرَقٍۢ","and heavy brocade","خُضْرًۭا مِّن سُندُسٍۢ","مُّتَّكِـِٔينَ فِيهَا عَلَى",1459],["44:53:4",498,"وَإِسْتَبْرَقٍۢ","and heavy silk","يَلْبَسُونَ مِن سُندُسٍۢ","مُّتَقَـٰبِلِينَ",1459],["55:54:6",533,"إِسْتَبْرَقٍۢ ۚ","brocade","فُرُشٍۭ بَطَآئِنُهَا مِنْ","وَجَنَى ٱلْجَنَّتَيْنِ دَانٍۢ",1459],["76:21:5",579,"وَإِسْتَبْرَقٌۭ ۖ","and heavy brocade","ثِيَابُ سُندُسٍ خُضْرٌۭ","وَحُلُّوٓا۟ أَسَاوِرَ مِن",1459]]