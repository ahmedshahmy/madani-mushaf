[["2:17:9",4,"حَوْلَهُۥ","(was) around him","فَلَمَّآ أَضَآءَتْ مَا","ذَهَبَ ٱللَّهُ بِنُورِهِمْ",567],["2:233:4",37,"حَوْلَيْنِ","(for) two years","۞ وَٱلْوَٰلِدَٰتُ يُرْضِعْنَ أَوْلَـٰدَهُنَّ","كَامِلَيْنِ ۖ لِمَنْ أَرَادَ",567],["2:240:10",39,"ٱلْحَوْلِ","the year","لِّأَزْوَٰجِهِم مَّتَـٰعًا إِلَى","غَيْرَ إِخْرَاجٍۢ ۚ فَإِنْ",567],["3:159:14",71,"حَوْلِكَ ۖ","around you","ٱلْقَلْبِ لَٱنفَضُّوا۟ مِنْ","فَٱعْفُ عَنْهُمْ وَٱسْتَغْفِرْ",567],["4:98:9",94,"حِيلَةًۭ","plan","وَٱلْوِلْدَٰنِ لَا يَسْتَطِيعُونَ","وَلَا يَهْتَدُونَ سَبِيلًۭا",3213],["6:92:13",139,"حَوْلَهَا ۚ","(are) around it","أُمَّ ٱلْقُرَىٰ وَمَنْ","وَٱلَّذِينَ يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ",567],["8:24:14",179,"يَحُولُ","comes","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","بَيْنَ ٱلْمَرْءِ وَقَلْبِهِۦ",1773],["9:101:2",203,"حَوْلَكُم","around you","وَمِمَّنْ","مِّنَ ٱلْأَعْرَابِ مُنَـٰفِقُونَ ۖ",567],["9:120:6",206,"حَوْلَهُم","were around them","لِأَهْلِ ٱلْمَدِينَةِ وَمَنْ","مِّنَ ٱلْأَعْرَابِ أَن",567],["11:43:18",226,"وَحَالَ","And came","إِلَّا مَن رَّحِمَ ۚ","بَيْنَهُمَا ٱلْمَوْجُ فَكَانَ",1773],["17:1:14",282,"حَوْلَهُۥ","its surroundings","ٱلْأَقْصَا ٱلَّذِى بَـٰرَكْنَا","لِنُرِيَهُۥ مِنْ ءَايَـٰتِنَآ ۚ",567],["17:56:13",287,"تَحْوِيلًا","(to) transfer (it)","ٱلضُّرِّ عَنكُمْ وَلَا","",2007],["17:77:11",290,"تَحْوِيلًا","any alteration","وَلَا تَجِدُ لِسُنَّتِنَا","",2007],["18:108:6",304,"حِوَلًۭا","any transfer","لَا يَبْغُونَ عَنْهَا","",3212],["19:68:6",310,"حَوْلَ","around","وَٱلشَّيَـٰطِينَ ثُمَّ لَنُحْضِرَنَّهُمْ","جَهَنَّمَ جِثِيًّۭا",567],["26:25:3",368,"حَوْلَهُۥٓ","around him","قَالَ لِمَنْ","أَلَا تَسْتَمِعُونَ",567],["26:34:3",368,"حَوْلَهُۥٓ","around him","قَالَ لِلْمَلَإِ","إِنَّ هَـٰذَا لَسَـٰحِرٌ",567],["27:8:10",377,"حَوْلَهَا","(is) around it","فِى ٱلنَّارِ وَمَنْ","وَسُبْحَـٰنَ ٱللَّهِ رَبِّ",567],["29:67:10",404,"حَوْلِهِمْ ۚ","around them","وَيُتَخَطَّفُ ٱلنَّاسُ مِنْ","أَفَبِٱلْبَـٰطِلِ يُؤْمِنُونَ وَبِنِعْمَةِ",567],["34:54:1",434,"وَحِيلَ","And a barrier will be placed","","بَيْنَهُمْ وَبَيْنَ مَا",1773],["35:43:26",439,"تَحْوِيلًا","any alteration","تَجِدَ لِسُنَّتِ ٱللَّهِ","",2007],["39:75:5",467,"حَوْلِ","around","ٱلْمَلَـٰٓئِكَةَ حَآفِّينَ مِنْ","ٱلْعَرْشِ يُسَبِّحُونَ بِحَمْدِ",567],["40:7:5",467,"حَوْلَهُۥ","(are) around it","يَحْمِلُونَ ٱلْعَرْشَ وَمَنْ","يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ",567],["42:7:10",483,"حَوْلَهَا","(is) around it","أُمَّ ٱلْقُرَىٰ وَمَنْ","وَتُنذِرَ يَوْمَ ٱلْجَمْعِ",567],["46:27:4",505,"حَوْلَكُم","surrounds you","وَلَقَدْ أَهْلَكْنَا مَا","مِّنَ ٱلْقُرَىٰ وَصَرَّفْنَا",567]]