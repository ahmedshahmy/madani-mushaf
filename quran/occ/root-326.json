[["2:4:12",2,"يُوقِنُونَ","firmly believe","قَبْلِكَ وَبِٱلْـَٔاخِرَةِ هُمْ","",752],["2:118:24",18,"يُوقِنُونَ","(who) firmly believe","بَيَّنَّا ٱلْـَٔايَـٰتِ لِقَوْمٍۢ","",752],["4:157:34",103,"يَقِينًۢا","certainly","ٱلظَّنِّ ۚ وَمَا قَتَلُوهُ","",1017],["5:50:10",116,"يُوقِنُونَ","(who) firmly believe","ٱللَّهِ حُكْمًۭا لِّقَوْمٍۢ","",752],["6:75:9",137,"ٱلْمُوقِنِينَ","the ones who are certain","وَٱلْأَرْضِ وَلِيَكُونَ مِنَ","",1374],["13:2:26",249,"تُوقِنُونَ","believe with certainty","لَعَلَّكُم بِلِقَآءِ رَبِّكُمْ","",752],["15:99:5",267,"ٱلْيَقِينُ","the certainty","رَبَّكَ حَتَّىٰ يَأْتِيَكَ","",1017],["26:24:9",368,"مُّوقِنِينَ","convinced","بَيْنَهُمَآ ۖ إِن كُنتُم","",1374],["27:3:9",377,"يُوقِنُونَ","believe with certainty","وَهُم بِٱلْـَٔاخِرَةِ هُمْ","",752],["27:14:3",378,"وَٱسْتَيْقَنَتْهَآ","though were convinced with them (signs)","وَجَحَدُوا۟ بِهَا","أَنفُسُهُمْ ظُلْمًۭا وَعُلُوًّۭا ۚ",2852],["27:22:14",378,"يَقِينٍ","certain","مِن سَبَإٍۭ بِنَبَإٍۢ","",1017],["27:82:16",384,"يُوقِنُونَ","certain","كَانُوا۟ بِـَٔايَـٰتِنَا لَا","",752],["30:60:10",410,"يُوقِنُونَ","certain in faith","يَسْتَخِفَّنَّكَ ٱلَّذِينَ لَا","",752],["31:4:9",411,"يُوقِنُونَ","believe firmly","وَهُم بِٱلْـَٔاخِرَةِ هُمْ","",752],["32:12:16",416,"مُوقِنُونَ","(are now) certain","نَعْمَلْ صَـٰلِحًا إِنَّا","",1374],["32:24:10",417,"يُوقِنُونَ","certain","صَبَرُوا۟ ۖ وَكَانُوا۟ بِـَٔايَـٰتِنَا","",752],["44:7:8",496,"مُّوقِنِينَ","certain","بَيْنَهُمَآ ۖ إِن كُنتُم","",1374],["45:4:9",499,"يُوقِنُونَ","who are certain","دَآبَّةٍ ءَايَـٰتٌۭ لِّقَوْمٍۢ","",752],["45:20:7",500,"يُوقِنُونَ","who are certain","وَهُدًۭى وَرَحْمَةٌۭ لِّقَوْمٍۢ","",752],["45:32:22",501,"بِمُسْتَيْقِنِينَ","(are) convinced","ظَنًّۭا وَمَا نَحْنُ","",3864],["51:20:4",521,"لِّلْمُوقِنِينَ","for those who are certain","وَفِى ٱلْأَرْضِ ءَايَـٰتٌۭ","",1374],["52:36:7",525,"يُوقِنُونَ","they are certain","وَٱلْأَرْضَ ۚ بَل لَّا","",752],["56:95:5",537,"ٱلْيَقِينِ","certain","هَـٰذَا لَهُوَ حَقُّ","",1017],["69:51:3",568,"ٱلْيَقِينِ","(of) certainty","وَإِنَّهُۥ لَحَقُّ","",1017],["74:31:14",576,"لِيَسْتَيْقِنَ","that may be certain","فِتْنَةًۭ لِّلَّذِينَ كَفَرُوا۟","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ",2852],["74:47:3",576,"ٱلْيَقِينُ","the certainty","حَتَّىٰٓ أَتَىٰنَا","",1017],["102:5:5",600,"ٱلْيَقِينِ","(of) certainty","لَوْ تَعْلَمُونَ عِلْمَ","",1017],["102:7:4",600,"ٱلْيَقِينِ","(of) certainty","ثُمَّ لَتَرَوُنَّهَا عَيْنَ","",1017]]