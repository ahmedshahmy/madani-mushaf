[["7:175:7",173,"فَٱنسَلَخَ","but he detached","ٱلَّذِىٓ ءَاتَيْنَـٰهُ ءَايَـٰتِنَا","مِنْهَا فَأَتْبَعَهُ ٱلشَّيْطَـٰنُ",2841],["9:5:2",187,"ٱنسَلَخَ","have passed","فَإِذَا","ٱلْأَشْهُرُ ٱلْحُرُمُ فَٱقْتُلُوا۟",2841],["36:37:4",442,"نَسْلَخُ","We withdraw","وَءَايَةٌۭ لَّهُمُ ٱلَّيْلُ","مِنْهُ ٱلنَّهَارَ فَإِذَا",4048]]