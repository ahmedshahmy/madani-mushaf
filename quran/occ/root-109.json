[["2:45:2",7,"بِٱلصَّبْرِ","through patience","وَٱسْتَعِينُوا۟","وَٱلصَّلَوٰةِ ۚ وَإِنَّهَا لَكَبِيرَةٌ",622],["2:61:5",9,"نَّصْبِرَ","we endure","قُلْتُمْ يَـٰمُوسَىٰ لَن","عَلَىٰ طَعَامٍۢ وَٰحِدٍۢ",205],["2:153:5",23,"بِٱلصَّبْرِ","through patience","ٱلَّذِينَ ءَامَنُوا۟ ٱسْتَعِينُوا۟","وَٱلصَّلَوٰةِ ۚ إِنَّ ٱللَّهَ",622],["2:153:10",23,"ٱلصَّـٰبِرِينَ","the patient ones","إِنَّ ٱللَّهَ مَعَ","",511],["2:155:12",24,"ٱلصَّـٰبِرِينَ","(to) the patient ones","وَٱلْأَنفُسِ وَٱلثَّمَرَٰتِ ۗ وَبَشِّرِ","",511],["2:175:9",26,"أَصْبَرَهُمْ","their endurance","وَٱلْعَذَابَ بِٱلْمَغْفِرَةِ ۚ فَمَآ","عَلَى ٱلنَّارِ",205],["2:177:40",27,"وَٱلصَّـٰبِرِينَ","and those who are patient","بِعَهْدِهِمْ إِذَا عَـٰهَدُوا۟ ۖ","فِى ٱلْبَأْسَآءِ وَٱلضَّرَّآءِ",511],["2:249:60",41,"ٱلصَّـٰبِرِينَ","the patient ones","ٱللَّهِ ۗ وَٱللَّهُ مَعَ","",511],["2:250:9",41,"صَبْرًۭا","patience","رَبَّنَآ أَفْرِغْ عَلَيْنَا","وَثَبِّتْ أَقْدَامَنَا وَٱنصُرْنَا",622],["3:17:1",52,"ٱلصَّـٰبِرِينَ","The patient","","وَٱلصَّـٰدِقِينَ وَٱلْقَـٰنِتِينَ وَٱلْمُنفِقِينَ",511],["3:120:11",65,"تَصْبِرُوا۟","you are patient","يَفْرَحُوا۟ بِهَا ۖ وَإِن","وَتَتَّقُوا۟ لَا يَضُرُّكُمْ",205],["3:125:3",66,"تَصْبِرُوا۟","you are patient","بَلَىٰٓ ۚ إِن","وَتَتَّقُوا۟ وَيَأْتُوكُم مِّن",205],["3:142:13",68,"ٱلصَّـٰبِرِينَ","the steadfast","جَـٰهَدُوا۟ مِنكُمْ وَيَعْلَمَ","",511],["3:146:21",68,"ٱلصَّـٰبِرِينَ","the patient ones","ٱسْتَكَانُوا۟ ۗ وَٱللَّهُ يُحِبُّ","",511],["3:186:18",74,"تَصْبِرُوا۟","you are patient","أَذًۭى كَثِيرًۭا ۚ وَإِن","وَتَتَّقُوا۟ فَإِنَّ ذَٰلِكَ",205],["3:200:4",76,"ٱصْبِرُوا۟","Be steadfast","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","وَصَابِرُوا۟ وَرَابِطُوا۟ وَٱتَّقُوا۟",205],["3:200:5",76,"وَصَابِرُوا۟","and [be] patient","ٱلَّذِينَ ءَامَنُوا۟ ٱصْبِرُوا۟","وَرَابِطُوا۟ وَٱتَّقُوا۟ ٱللَّهَ",3230],["4:25:53",82,"تَصْبِرُوا۟","you be patient","ٱلْعَنَتَ مِنكُمْ ۚ وَأَن","خَيْرٌۭ لَّكُمْ ۗ وَٱللَّهُ",205],["6:34:6",131,"فَصَبَرُوا۟","but they were patient","رُسُلٌۭ مِّن قَبْلِكَ","عَلَىٰ مَا كُذِّبُوا۟",205],["7:87:12",161,"فَٱصْبِرُوا۟","then be patient","وَطَآئِفَةٌۭ لَّمْ يُؤْمِنُوا۟","حَتَّىٰ يَحْكُمَ ٱللَّهُ",205],["7:126:14",165,"صَبْرًۭا","patience","رَبَّنَآ أَفْرِغْ عَلَيْنَا","وَتَوَفَّنَا مُسْلِمِينَ",622],["7:128:6",165,"وَٱصْبِرُوٓا۟ ۖ","and be patient","لِقَوْمِهِ ٱسْتَعِينُوا۟ بِٱللَّهِ","إِنَّ ٱلْأَرْضَ لِلَّهِ",205],["7:137:20",166,"صَبَرُوا۟ ۖ","they were patient","بَنِىٓ إِسْرَٰٓءِيلَ بِمَا","وَدَمَّرْنَا مَا كَانَ",205],["8:46:9",183,"وَٱصْبِرُوٓا۟ ۚ","and be patient","فَتَفْشَلُوا۟ وَتَذْهَبَ رِيحُكُمْ ۖ","إِنَّ ٱللَّهَ مَعَ",205],["8:46:13",183,"ٱلصَّـٰبِرِينَ","the patient ones","إِنَّ ٱللَّهَ مَعَ","",511],["8:65:11",185,"صَـٰبِرُونَ","steadfast","يَكُن مِّنكُمْ عِشْرُونَ","يَغْلِبُوا۟ مِا۟ئَتَيْنِ ۚ وَإِن",511],["8:66:13",185,"صَابِرَةٌۭ","steadfast","يَكُن مِّنكُم مِّا۟ئَةٌۭ","يَغْلِبُوا۟ مِا۟ئَتَيْنِ ۚ وَإِن",3229],["8:66:26",185,"ٱلصَّـٰبِرِينَ","the steadfast","ٱللَّهِ ۗ وَٱللَّهُ مَعَ","",511],["10:109:5",221,"وَٱصْبِرْ","and be patient","مَا يُوحَىٰٓ إِلَيْكَ","حَتَّىٰ يَحْكُمَ ٱللَّهُ ۚ",205],["11:11:3",222,"صَبَرُوا۟","(are) patient","إِلَّا ٱلَّذِينَ","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ",205],["11:49:16",227,"فَٱصْبِرْ ۖ","So be patient","مِن قَبْلِ هَـٰذَا ۖ","إِنَّ ٱلْعَـٰقِبَةَ لِلْمُتَّقِينَ",205],["11:115:1",234,"وَٱصْبِرْ","And be patient","","فَإِنَّ ٱللَّهَ لَا",205],["12:18:12",237,"فَصَبْرٌۭ","so patience","لَكُمْ أَنفُسُكُمْ أَمْرًۭا ۖ","جَمِيلٌۭ ۖ وَٱللَّهُ ٱلْمُسْتَعَانُ",622],["12:83:7",245,"فَصَبْرٌۭ","so patience","لَكُمْ أَنفُسُكُمْ أَمْرًۭا ۖ","جَمِيلٌ ۖ عَسَى ٱللَّهُ",622],["12:90:17",246,"وَيَصْبِرْ","and (is) patient","إِنَّهُۥ مَن يَتَّقِ","فَإِنَّ ٱللَّهَ لَا",205],["13:22:2",252,"صَبَرُوا۟","(are) patient","وَٱلَّذِينَ","ٱبْتِغَآءَ وَجْهِ رَبِّهِمْ",205],["13:24:4",252,"صَبَرْتُمْ ۚ","you patiently endured","سَلَـٰمٌ عَلَيْكُم بِمَا","فَنِعْمَ عُقْبَى ٱلدَّارِ",205],["14:5:20",255,"صَبَّارٍۢ","patient","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّكُلِّ","شَكُورٍۢ",1520],["14:12:10",257,"وَلَنَصْبِرَنَّ","And surely we will bear with patience","وَقَدْ هَدَىٰنَا سُبُلَنَا ۚ","عَلَىٰ مَآ ءَاذَيْتُمُونَا ۚ",205],["14:21:30",258,"صَبَرْنَا","we are patient","عَلَيْنَآ أَجَزِعْنَآ أَمْ","مَا لَنَا مِن",205],["16:42:2",271,"صَبَرُوا۟","(are) patient","ٱلَّذِينَ","وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ",205],["16:96:10",278,"صَبَرُوٓا۟","(are) patient","بَاقٍۢ ۗ وَلَنَجْزِيَنَّ ٱلَّذِينَ","أَجْرَهُم بِأَحْسَنِ مَا",205],["16:110:12",279,"وَصَبَرُوٓا۟","and were patient","فُتِنُوا۟ ثُمَّ جَـٰهَدُوا۟","إِنَّ رَبَّكَ مِنۢ",205],["16:126:9",281,"صَبَرْتُمْ","you are patient","عُوقِبْتُم بِهِۦ ۖ وَلَئِن","لَهُوَ خَيْرٌۭ لِّلصَّـٰبِرِينَ",205],["16:126:12",281,"لِّلصَّـٰبِرِينَ","for those who are patient","صَبَرْتُمْ لَهُوَ خَيْرٌۭ","",511],["16:127:1",281,"وَٱصْبِرْ","And be patient","","وَمَا صَبْرُكَ إِلَّا",205],["16:127:3",281,"صَبْرُكَ","(is) your patience","وَٱصْبِرْ وَمَا","إِلَّا بِٱللَّهِ ۚ وَلَا",622],["18:28:1",297,"وَٱصْبِرْ","And be patient","","نَفْسَكَ مَعَ ٱلَّذِينَ",205],["18:67:6",301,"صَبْرًۭا","(to have) patience","لَن تَسْتَطِيعَ مَعِىَ","",622],["18:68:2",301,"تَصْبِرُ","you have patience","وَكَيْفَ","عَلَىٰ مَا لَمْ",205],["18:69:6",301,"صَابِرًۭا","patient","إِن شَآءَ ٱللَّهُ","وَلَآ أَعْصِى لَكَ",511],["18:72:8",301,"صَبْرًۭا","(to have) patience","لَن تَسْتَطِيعَ مَعِىَ","",622],["18:75:9",302,"صَبْرًۭا","(to have) patience","لَن تَسْتَطِيعَ مَعِىَ","",622],["18:78:12",302,"صَبْرًا","(to have) patience","لَمْ تَسْتَطِع عَّلَيْهِ","",622],["18:82:35",302,"صَبْرًۭا","(to have) patience","لَمْ تَسْطِع عَّلَيْهِ","",622],["19:65:7",310,"وَٱصْطَبِرْ","and be constant","وَمَا بَيْنَهُمَا فَٱعْبُدْهُ","لِعِبَـٰدَتِهِۦ ۚ هَلْ تَعْلَمُ",2099],["20:130:1",321,"فَٱصْبِرْ","So be patient","","عَلَىٰ مَا يَقُولُونَ",205],["20:132:4",321,"وَٱصْطَبِرْ","and be steadfast","وَأْمُرْ أَهْلَكَ بِٱلصَّلَوٰةِ","عَلَيْهَا ۖ لَا نَسْـَٔلُكَ",2099],["21:85:7",329,"ٱلصَّـٰبِرِينَ","the patient ones","ٱلْكِفْلِ ۖ كُلٌّۭ مِّنَ","",511],["22:35:7",336,"وَٱلصَّـٰبِرِينَ","and those who are patient","ٱللَّهُ وَجِلَتْ قُلُوبُهُمْ","عَلَىٰ مَآ أَصَابَهُمْ",511],["23:111:5",349,"صَبَرُوٓا۟","they were patient","جَزَيْتُهُمُ ٱلْيَوْمَ بِمَا","أَنَّهُمْ هُمُ ٱلْفَآئِزُونَ",205],["25:20:17",361,"أَتَصْبِرُونَ ۗ","will you have patience","بَعْضَكُمْ لِبَعْضٍۢ فِتْنَةً","وَكَانَ رَبُّكَ بَصِيرًۭا",205],["25:42:8",363,"صَبَرْنَا","we had been steadfast","ءَالِهَتِنَا لَوْلَآ أَن","عَلَيْهَا ۚ وَسَوْفَ يَعْلَمُونَ",205],["25:75:5",366,"صَبَرُوا۟","they were patient","يُجْزَوْنَ ٱلْغُرْفَةَ بِمَا","وَيُلَقَّوْنَ فِيهَا تَحِيَّةًۭ",205],["28:54:6",392,"صَبَرُوا۟","they are patient","أَجْرَهُم مَّرَّتَيْنِ بِمَا","وَيَدْرَءُونَ بِٱلْحَسَنَةِ ٱلسَّيِّئَةَ",205],["28:80:16",395,"ٱلصَّـٰبِرُونَ","(to) the patient ones","وَلَا يُلَقَّىٰهَآ إِلَّا","",511],["29:59:2",403,"صَبَرُوا۟","(are) patient","ٱلَّذِينَ","وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ",205],["30:60:1",410,"فَٱصْبِرْ","So be patient","","إِنَّ وَعْدَ ٱللَّهِ",205],["31:17:9",412,"وَٱصْبِرْ","and be patient","وَٱنْهَ عَنِ ٱلْمُنكَرِ","عَلَىٰ مَآ أَصَابَكَ ۖ",205],["31:31:18",414,"صَبَّارٍۢ","(who is) patient","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّكُلِّ","شَكُورٍۢ",1520],["32:24:7",417,"صَبَرُوا۟ ۖ","they were patient","يَهْدُونَ بِأَمْرِنَا لَمَّا","وَكَانُوا۟ بِـَٔايَـٰتِنَا يُوقِنُونَ",205],["33:35:10",422,"وَٱلصَّـٰبِرِينَ","and the patient men","وَٱلْقَـٰنِتَـٰتِ وَٱلصَّـٰدِقِينَ وَٱلصَّـٰدِقَـٰتِ","وَٱلصَّـٰبِرَٰتِ وَٱلْخَـٰشِعِينَ وَٱلْخَـٰشِعَـٰتِ",511],["33:35:11",422,"وَٱلصَّـٰبِرَٰتِ","and the patient women","وَٱلصَّـٰدِقِينَ وَٱلصَّـٰدِقَـٰتِ وَٱلصَّـٰبِرِينَ","وَٱلْخَـٰشِعِينَ وَٱلْخَـٰشِعَـٰتِ وَٱلْمُتَصَدِّقِينَ",3275],["34:19:18",430,"صَبَّارٍۢ","patient","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّكُلِّ","شَكُورٍۢ",1520],["37:102:26",449,"ٱلصَّـٰبِرِينَ","the patient ones","شَآءَ ٱللَّهُ مِنَ","",511],["38:6:6",453,"وَٱصْبِرُوا۟","and be patient","مِنْهُمْ أَنِ ٱمْشُوا۟","عَلَىٰٓ ءَالِهَتِكُمْ ۖ إِنَّ",205],["38:17:1",454,"ٱصْبِرْ","Be patient","","عَلَىٰ مَا يَقُولُونَ",205],["38:44:10",456,"صَابِرًۭا ۚ","patient","تَحْنَثْ ۗ إِنَّا وَجَدْنَـٰهُ","نِّعْمَ ٱلْعَبْدُ ۖ إِنَّهُۥٓ",511],["39:10:18",459,"ٱلصَّـٰبِرُونَ","the patient ones","وَٰسِعَةٌ ۗ إِنَّمَا يُوَفَّى","أَجْرَهُم بِغَيْرِ حِسَابٍۢ",511],["40:55:1",473,"فَٱصْبِرْ","So be patient","","إِنَّ وَعْدَ ٱللَّهِ",205],["40:77:1",475,"فَٱصْبِرْ","So be patient","","إِنَّ وَعْدَ ٱللَّهِ",205],["41:24:2",479,"يَصْبِرُوا۟","they endure","فَإِن","فَٱلنَّارُ مَثْوًۭى لَّهُمْ ۖ",205],["41:35:5",480,"صَبَرُوا۟","(are) patient","يُلَقَّىٰهَآ إِلَّا ٱلَّذِينَ","وَمَا يُلَقَّىٰهَآ إِلَّا",205],["42:33:14",487,"صَبَّارٍۢ","patient","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّكُلِّ","شَكُورٍ",1520],["42:43:2",487,"صَبَرَ","(is) patient","وَلَمَن","وَغَفَرَ إِنَّ ذَٰلِكَ",205],["46:35:1",506,"فَٱصْبِرْ","So be patient","","كَمَا صَبَرَ أُو۟لُوا۟",205],["46:35:3",506,"صَبَرَ","had patience","فَٱصْبِرْ كَمَا","أُو۟لُوا۟ ٱلْعَزْمِ مِنَ",205],["47:31:6",510,"وَٱلصَّـٰبِرِينَ","and the patient ones","نَعْلَمَ ٱلْمُجَـٰهِدِينَ مِنكُمْ","وَنَبْلُوَا۟ أَخْبَارَكُمْ",511],["49:5:3",516,"صَبَرُوا۟","had been patient","وَلَوْ أَنَّهُمْ","حَتَّىٰ تَخْرُجَ إِلَيْهِمْ",205],["50:39:1",520,"فَٱصْبِرْ","So be patient","","عَلَىٰ مَا يَقُولُونَ",205],["52:16:2",524,"فَٱصْبِرُوٓا۟","then be patient","ٱصْلَوْهَا","أَوْ لَا تَصْبِرُوا۟",205],["52:16:5",524,"تَصْبِرُوا۟","be patient","فَٱصْبِرُوٓا۟ أَوْ لَا","سَوَآءٌ عَلَيْكُمْ ۖ إِنَّمَا",205],["52:48:1",525,"وَٱصْبِرْ","So be patient","","لِحُكْمِ رَبِّكَ فَإِنَّكَ",205],["54:27:7",529,"وَٱصْطَبِرْ","and be patient","فِتْنَةًۭ لَّهُمْ فَٱرْتَقِبْهُمْ","",2099],["68:48:1",566,"فَٱصْبِرْ","So be patient","","لِحُكْمِ رَبِّكَ وَلَا",205],["70:5:1",568,"فَٱصْبِرْ","So be patient","","صَبْرًۭا جَمِيلًا",205],["70:5:2",568,"صَبْرًۭا","a patience","فَٱصْبِرْ","جَمِيلًا",622],["73:10:1",574,"وَٱصْبِرْ","And be patient","","عَلَىٰ مَا يَقُولُونَ",205],["74:7:2",575,"فَٱصْبِرْ","be patient","وَلِرَبِّكَ","",205],["76:12:3",579,"صَبَرُوا۟","they were patient","وَجَزَىٰهُم بِمَا","جَنَّةًۭ وَحَرِيرًۭا",205],["76:24:1",579,"فَٱصْبِرْ","So be patient","","لِحُكْمِ رَبِّكَ وَلَا",205],["90:17:7",594,"بِٱلصَّبْرِ","to patience","ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟","وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",622],["103:3:9",601,"بِٱلصَّبْرِ","to [the] patience","وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟","",622]]