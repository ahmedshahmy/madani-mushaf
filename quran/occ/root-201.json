[["2:11:5",3,"تُفْسِدُوا۟","spread corruption","قِيلَ لَهُمْ لَا","فِى ٱلْأَرْضِ قَالُوٓا۟",615],["2:12:4",3,"ٱلْمُفْسِدُونَ","(are) the ones who spread corruption","أَلَآ إِنَّهُمْ هُمُ","وَلَـٰكِن لَّا يَشْعُرُونَ",491],["2:27:15",5,"وَيُفْسِدُونَ","and [they] spread corruption","بِهِۦٓ أَن يُوصَلَ","فِى ٱلْأَرْضِ ۚ أُو۟لَـٰٓئِكَ",615],["2:30:14",6,"يُفْسِدُ","will spread corruption","أَتَجْعَلُ فِيهَا مَن","فِيهَا وَيَسْفِكُ ٱلدِّمَآءَ",615],["2:60:28",9,"مُفْسِدِينَ","spreading corruption","تَعْثَوْا۟ فِى ٱلْأَرْضِ","",491],["2:205:6",32,"لِيُفْسِدَ","to spread corruption","سَعَىٰ فِى ٱلْأَرْضِ","فِيهَا وَيُهْلِكَ ٱلْحَرْثَ",615],["2:205:14",32,"ٱلْفَسَادَ","[the] corruption","وَٱللَّهُ لَا يُحِبُّ","",781],["2:220:16",35,"ٱلْمُفْسِدَ","the corrupter","فَإِخْوَٰنُكُمْ ۚ وَٱللَّهُ يَعْلَمُ","مِنَ ٱلْمُصْلِحِ ۚ وَلَوْ",491],["2:251:20",41,"لَّفَسَدَتِ","certainly (would have) corrupted","ٱلنَّاسَ بَعْضَهُم بِبَعْضٍۢ","ٱلْأَرْضُ وَلَـٰكِنَّ ٱللَّهَ",1830],["3:63:6",58,"بِٱلْمُفْسِدِينَ","of the corrupters","فَإِنَّ ٱللَّهَ عَلِيمٌۢ","",491],["5:32:15",113,"فَسَادٍۢ","(for) spreading corruption","بِغَيْرِ نَفْسٍ أَوْ","فِى ٱلْأَرْضِ فَكَأَنَّمَا",781],["5:33:10",113,"فَسَادًا","spreading corruption","وَيَسْعَوْنَ فِى ٱلْأَرْضِ","أَن يُقَتَّلُوٓا۟ أَوْ",781],["5:64:43",118,"فَسَادًۭا ۚ","spreading corruption","وَيَسْعَوْنَ فِى ٱلْأَرْضِ","وَٱللَّهُ لَا يُحِبُّ",781],["5:64:47",118,"ٱلْمُفْسِدِينَ","the corrupters","وَٱللَّهُ لَا يُحِبُّ","",491],["7:56:2",157,"تُفْسِدُوا۟","cause corruption","وَلَا","فِى ٱلْأَرْضِ بَعْدَ",615],["7:74:25",160,"مُفْسِدِينَ","spreading corruption","تَعْثَوْا۟ فِى ٱلْأَرْضِ","",491],["7:85:27",161,"تُفْسِدُوا۟","cause corruption","ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا","فِى ٱلْأَرْضِ بَعْدَ",615],["7:86:24",161,"ٱلْمُفْسِدِينَ","(of) the corrupters","كَيْفَ كَانَ عَـٰقِبَةُ","",491],["7:103:16",163,"ٱلْمُفْسِدِينَ","(of) the corrupters","كَيْفَ كَانَ عَـٰقِبَةُ","",491],["7:127:9",165,"لِيُفْسِدُوا۟","so that they cause corruption","أَتَذَرُ مُوسَىٰ وَقَوْمَهُۥ","فِى ٱلْأَرْضِ وَيَذَرَكَ",615],["7:142:23",167,"ٱلْمُفْسِدِينَ","(of) the corrupters","وَلَا تَتَّبِعْ سَبِيلَ","",491],["8:73:12",186,"وَفَسَادٌۭ","and corruption","فِتْنَةٌۭ فِى ٱلْأَرْضِ","كَبِيرٌۭ",781],["10:40:12",213,"بِٱلْمُفْسِدِينَ","of the corrupters","بِهِۦ ۚ وَرَبُّكَ أَعْلَمُ","",491],["10:81:17",218,"ٱلْمُفْسِدِينَ","(of) the corrupters","لَا يُصْلِحُ عَمَلَ","",491],["10:91:7",219,"ٱلْمُفْسِدِينَ","the corrupters","قَبْلُ وَكُنتَ مِنَ","",491],["11:85:14",231,"مُفْسِدِينَ","spreading corruption","تَعْثَوْا۟ فِى ٱلْأَرْضِ","",491],["11:116:11",234,"ٱلْفَسَادِ","the corruption","بَقِيَّةٍۢ يَنْهَوْنَ عَنِ","فِى ٱلْأَرْضِ إِلَّا",781],["12:73:7",244,"لِنُفْسِدَ","that we cause corruption","عَلِمْتُم مَّا جِئْنَا","فِى ٱلْأَرْضِ وَمَا",615],["13:25:15",252,"وَيُفْسِدُونَ","and spread corruption","بِهِۦٓ أَن يُوصَلَ","فِى ٱلْأَرْضِ ۙ أُو۟لَـٰٓئِكَ",615],["16:88:13",277,"يُفْسِدُونَ","spread corruption","ٱلْعَذَابِ بِمَا كَانُوا۟","",615],["17:4:7",282,"لَتُفْسِدُنَّ","Surely you will cause corruption","إِسْرَٰٓءِيلَ فِى ٱلْكِتَـٰبِ","فِى ٱلْأَرْضِ مَرَّتَيْنِ",615],["18:94:7",303,"مُفْسِدُونَ","(are) corrupters","إِنَّ يَأْجُوجَ وَمَأْجُوجَ","فِى ٱلْأَرْضِ فَهَلْ",491],["21:22:7",323,"لَفَسَدَتَا ۚ","surely they (would) have been ruined","ءَالِهَةٌ إِلَّا ٱللَّهُ","فَسُبْحَـٰنَ ٱللَّهِ رَبِّ",1830],["23:71:5",346,"لَفَسَدَتِ","surely (would) have been corrupted","ٱتَّبَعَ ٱلْحَقُّ أَهْوَآءَهُمْ","ٱلسَّمَـٰوَٰتُ وَٱلْأَرْضُ وَمَن",1830],["26:152:2",373,"يُفْسِدُونَ","spread corruption","ٱلَّذِينَ","فِى ٱلْأَرْضِ وَلَا",615],["26:183:9",374,"مُفْسِدِينَ","spreading corruption","تَعْثَوْا۟ فِى ٱلْأَرْضِ","",491],["27:14:11",378,"ٱلْمُفْسِدِينَ","(of) the corrupters","كَيْفَ كَانَ عَـٰقِبَةُ","",491],["27:34:7",379,"أَفْسَدُوهَا","they ruin it","إِذَا دَخَلُوا۟ قَرْيَةً","وَجَعَلُوٓا۟ أَعِزَّةَ أَهْلِهَآ",615],["27:48:6",381,"يُفْسِدُونَ","they were spreading corruption","ٱلْمَدِينَةِ تِسْعَةُ رَهْطٍۢ","فِى ٱلْأَرْضِ وَلَا",615],["28:4:19",385,"ٱلْمُفْسِدِينَ","the corrupters","إِنَّهُۥ كَانَ مِنَ","",491],["28:77:19",394,"ٱلْفَسَادَ","corruption","إِلَيْكَ ۖ وَلَا تَبْغِ","فِى ٱلْأَرْضِ ۖ إِنَّ",781],["28:77:26",394,"ٱلْمُفْسِدِينَ","the corrupters","ٱللَّهَ لَا يُحِبُّ","",491],["28:83:12",395,"فَسَادًۭا ۚ","corruption","فِى ٱلْأَرْضِ وَلَا","وَٱلْعَـٰقِبَةُ لِلْمُتَّقِينَ",781],["29:30:6",399,"ٱلْمُفْسِدِينَ","the corrupters","ٱنصُرْنِى عَلَى ٱلْقَوْمِ","",491],["29:36:16",400,"مُفْسِدِينَ","(as) corrupters","تَعْثَوْا۟ فِى ٱلْأَرْضِ","",491],["30:41:2",408,"ٱلْفَسَادُ","the corruption","ظَهَرَ","فِى ٱلْبَرِّ وَٱلْبَحْرِ",781],["38:28:7",455,"كَٱلْمُفْسِدِينَ","like those who spread corruption","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","فِى ٱلْأَرْضِ أَمْ",491],["40:26:18",470,"ٱلْفَسَادَ","the corruption","يُظْهِرَ فِى ٱلْأَرْضِ","",781],["47:22:6",509,"تُفْسِدُوا۟","you cause corruption","إِن تَوَلَّيْتُمْ أَن","فِى ٱلْأَرْضِ وَتُقَطِّعُوٓا۟",615],["89:12:3",593,"ٱلْفَسَادَ","corruption","فَأَكْثَرُوا۟ فِيهَا","",781]]