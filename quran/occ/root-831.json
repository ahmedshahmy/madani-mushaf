[["3:127:9",66,"خَآئِبِينَ","disappointed","أَوْ يَكْبِتَهُمْ فَيَنقَلِبُوا۟","",4554],["14:15:2",257,"وَخَابَ","and disappointed","وَٱسْتَفْتَحُوا۟","كُلُّ جَبَّارٍ عَنِيدٍۢ",1662],["20:61:13",315,"خَابَ","he failed","فَيُسْحِتَكُم بِعَذَابٍۢ ۖ وَقَدْ","مَنِ ٱفْتَرَىٰ",1662],["20:111:6",319,"خَابَ","will have failed","لِلْحَىِّ ٱلْقَيُّومِ ۖ وَقَدْ","مَنْ حَمَلَ ظُلْمًۭا",1662],["91:10:2",595,"خَابَ","he fails","وَقَدْ","مَن دَسَّىٰهَا",1662]]