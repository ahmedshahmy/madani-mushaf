[["3:121:2",65,"غَدَوْتَ","you left early morning","وَإِذْ","مِنْ أَهْلِكَ تُبَوِّئُ",1844],["6:52:6",133,"بِٱلْغَدَوٰةِ","in the morning","ٱلَّذِينَ يَدْعُونَ رَبَّهُم","وَٱلْعَشِىِّ يُرِيدُونَ وَجْهَهُۥ ۖ",2372],["7:205:11",176,"بِٱلْغُدُوِّ","in the mornings","ٱلْجَهْرِ مِنَ ٱلْقَوْلِ","وَٱلْـَٔاصَالِ وَلَا تَكُن",1338],["12:12:3",236,"غَدًۭا","tomorrow","أَرْسِلْهُ مَعَنَا","يَرْتَعْ وَيَلْعَبْ وَإِنَّا",1334],["13:15:10",251,"بِٱلْغُدُوِّ","in the mornings","طَوْعًۭا وَكَرْهًۭا وَظِلَـٰلُهُم","وَٱلْـَٔاصَالِ ۩",1338],["18:23:7",296,"غَدًا","tomorrow","إِنِّى فَاعِلٌۭ ذَٰلِكَ","",1334],["18:28:7",297,"بِٱلْغَدَوٰةِ","in the morning","ٱلَّذِينَ يَدْعُونَ رَبَّهُم","وَٱلْعَشِىِّ يُرِيدُونَ وَجْهَهُۥ ۖ",2372],["18:62:6",301,"غَدَآءَنَا","our morning meal","قَالَ لِفَتَىٰهُ ءَاتِنَا","لَقَدْ لَقِينَا مِن",3456],["24:36:13",354,"بِٱلْغُدُوِّ","in the mornings","يُسَبِّحُ لَهُۥ فِيهَا","وَٱلْـَٔاصَالِ",1338],["31:34:17",414,"غَدًۭا ۖ","tomorrow","نَفْسٌۭ مَّاذَا تَكْسِبُ","وَمَا تَدْرِى نَفْسٌۢ",1334],["34:12:3",429,"غُدُوُّهَا","its morning course","وَلِسُلَيْمَـٰنَ ٱلرِّيحَ","شَهْرٌۭ وَرَوَاحُهَا شَهْرٌۭ ۖ",1338],["40:46:4",472,"غُدُوًّۭا","morning","ٱلنَّارُ يُعْرَضُونَ عَلَيْهَا","وَعَشِيًّۭا ۖ وَيَوْمَ تَقُومُ",1338],["54:26:2",529,"غَدًۭا","tomorrow","سَيَعْلَمُونَ","مَّنِ ٱلْكَذَّابُ ٱلْأَشِرُ",1334],["59:18:10",548,"لِغَدٍۢ ۖ","for tomorrow","نَفْسٌۭ مَّا قَدَّمَتْ","وَٱتَّقُوا۟ ٱللَّهَ ۚ إِنَّ",1334],["68:22:2",565,"ٱغْدُوا۟","Go early","أَنِ","عَلَىٰ حَرْثِكُمْ إِن",1844],["68:25:1",565,"وَغَدَوْا۟","And they went early","","عَلَىٰ حَرْدٍۢ قَـٰدِرِينَ",1844]]