[["2:69:17",10,"تَسُرُّ","pleasing","صَفْرَآءُ فَاقِعٌۭ لَّوْنُهَا","ٱلنَّـٰظِرِينَ",4424],["2:77:7",12,"يُسِرُّونَ","they conceal","ٱللَّهَ يَعْلَمُ مَا","وَمَا يُعْلِنُونَ",540],["2:235:21",38,"سِرًّا","secretly","وَلَـٰكِن لَّا تُوَاعِدُوهُنَّ","إِلَّآ أَن تَقُولُوا۟",801],["2:274:6",46,"سِرًّۭا","secretly","أَمْوَٰلَهُم بِٱلَّيْلِ وَٱلنَّهَارِ","وَعَلَانِيَةًۭ فَلَهُمْ أَجْرُهُمْ",801],["3:134:4",67,"ٱلسَّرَّآءِ","[the] ease","ٱلَّذِينَ يُنفِقُونَ فِى","وَٱلضَّرَّآءِ وَٱلْكَـٰظِمِينَ ٱلْغَيْظَ",2648],["5:52:25",117,"أَسَرُّوا۟","they had concealed","فَيُصْبِحُوا۟ عَلَىٰ مَآ","فِىٓ أَنفُسِهِمْ نَـٰدِمِينَ",540],["6:3:8",128,"سِرَّكُمْ","your secret","وَفِى ٱلْأَرْضِ ۖ يَعْلَمُ","وَجَهْرَكُمْ وَيَعْلَمُ مَا",801],["7:95:13",162,"وَٱلسَّرَّآءُ","and the ease","مَسَّ ءَابَآءَنَا ٱلضَّرَّآءُ","فَأَخَذْنَـٰهُم بَغْتَةًۭ وَهُمْ",2648],["9:78:6",199,"سِرَّهُمْ","their secret","أَنَّ ٱللَّهَ يَعْلَمُ","وَنَجْوَىٰهُمْ وَأَنَّ ٱللَّهَ",801],["10:54:11",215,"وَأَسَرُّوا۟","and they (will) confide","ٱلْأَرْضِ لَٱفْتَدَتْ بِهِۦ ۗ","ٱلنَّدَامَةَ لَمَّا رَأَوُا۟",540],["11:5:13",221,"يُسِرُّونَ","they conceal","ثِيَابَهُمْ يَعْلَمُ مَا","وَمَا يُعْلِنُونَ ۚ إِنَّهُۥ",540],["12:19:11",237,"وَأَسَرُّوهُ","And they hid him","يَـٰبُشْرَىٰ هَـٰذَا غُلَـٰمٌۭ ۚ","بِضَـٰعَةًۭ ۚ وَٱللَّهُ عَلِيمٌۢ",540],["12:77:10",244,"فَأَسَرَّهَا","But Yusuf kept it secret","لَّهُۥ مِن قَبْلُ ۚ","يُوسُفُ فِى نَفْسِهِۦ",540],["13:10:4",250,"أَسَرَّ","conceals","سَوَآءٌۭ مِّنكُم مَّنْ","ٱلْقَوْلَ وَمَن جَهَرَ",540],["13:22:11",252,"سِرًّۭا","secretly","وَأَنفَقُوا۟ مِمَّا رَزَقْنَـٰهُمْ","وَعَلَانِيَةًۭ وَيَدْرَءُونَ بِٱلْحَسَنَةِ",801],["14:31:10",259,"سِرًّۭا","secretly","وَيُنفِقُوا۟ مِمَّا رَزَقْنَـٰهُمْ","وَعَلَانِيَةًۭ مِّن قَبْلِ",801],["15:47:9",264,"سُرُرٍۢ","thrones","غِلٍّ إِخْوَٰنًا عَلَىٰ","مُّتَقَـٰبِلِينَ",1231],["16:19:4",269,"تُسِرُّونَ","you conceal","وَٱللَّهُ يَعْلَمُ مَا","وَمَا تُعْلِنُونَ",540],["16:23:7",269,"يُسِرُّونَ","they conceal","ٱللَّهَ يَعْلَمُ مَا","وَمَا يُعْلِنُونَ ۚ إِنَّهُۥ",540],["16:75:18",275,"سِرًّۭا","secretly","فَهُوَ يُنفِقُ مِنْهُ","وَجَهْرًا ۖ هَلْ يَسْتَوُۥنَ ۚ",801],["20:7:6",312,"ٱلسِّرَّ","the secret","بِٱلْقَوْلِ فَإِنَّهُۥ يَعْلَمُ","وَأَخْفَى",801],["20:62:4",315,"وَأَسَرُّوا۟","and they kept secret","فَتَنَـٰزَعُوٓا۟ أَمْرَهُم بَيْنَهُمْ","ٱلنَّجْوَىٰ",540],["21:3:3",322,"وَأَسَرُّوا۟","And they conceal","لَاهِيَةًۭ قُلُوبُهُمْ ۗ","ٱلنَّجْوَى ٱلَّذِينَ ظَلَمُوا۟",540],["25:6:5",360,"ٱلسِّرَّ","the secret","أَنزَلَهُ ٱلَّذِى يَعْلَمُ","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ",801],["34:33:18",432,"وَأَسَرُّوا۟","But they will conceal","وَنَجْعَلَ لَهُۥٓ أَندَادًۭا ۚ","ٱلنَّدَامَةَ لَمَّا رَأَوُا۟",540],["35:29:11",437,"سِرًّۭا","secretly","وَأَنفَقُوا۟ مِمَّا رَزَقْنَـٰهُمْ","وَعَلَانِيَةًۭ يَرْجُونَ تِجَـٰرَةًۭ",801],["36:76:7",445,"يُسِرُّونَ","they conceal","إِنَّا نَعْلَمُ مَا","وَمَا يُعْلِنُونَ",540],["37:44:2",447,"سُرُرٍۢ","thrones","عَلَىٰ","مُّتَقَـٰبِلِينَ",1231],["43:34:3",492,"وَسُرُرًا","and couches","وَلِبُيُوتِهِمْ أَبْوَٰبًۭا","عَلَيْهَا يَتَّكِـُٔونَ",1231],["43:80:6",495,"سِرَّهُمْ","their secret(s)","أَنَّا لَا نَسْمَعُ","وَنَجْوَىٰهُم ۚ بَلَىٰ وَرُسُلُنَا",801],["47:26:15",509,"إِسْرَارَهُمْ","their secrets","ٱلْأَمْرِ ۖ وَٱللَّهُ يَعْلَمُ","",2146],["52:20:3",524,"سُرُرٍۢ","thrones","مُتَّكِـِٔينَ عَلَىٰ","مَّصْفُوفَةٍۢ ۖ وَزَوَّجْنَـٰهُم بِحُورٍ",1231],["56:15:2",534,"سُرُرٍۢ","thrones","عَلَىٰ","مَّوْضُونَةٍۢ",1231],["60:1:33",549,"تُسِرُّونَ","You confide","سَبِيلِى وَٱبْتِغَآءَ مَرْضَاتِى ۚ","إِلَيْهِم بِٱلْمَوَدَّةِ وَأَنَا۠",540],["64:4:8",556,"تُسِرُّونَ","you conceal","وَٱلْأَرْضِ وَيَعْلَمُ مَا","وَمَا تُعْلِنُونَ ۚ وَٱللَّهُ",540],["66:3:2",560,"أَسَرَّ","confided","وَإِذْ","ٱلنَّبِىُّ إِلَىٰ بَعْضِ",540],["67:13:1",563,"وَأَسِرُّوا۟","And conceal","","قَوْلَكُمْ أَوِ ٱجْهَرُوا۟",540],["71:9:5",570,"وَأَسْرَرْتُ","and I confided","إِنِّىٓ أَعْلَنتُ لَهُمْ","لَهُمْ إِسْرَارًۭا",540],["71:9:7",570,"إِسْرَارًۭا","secretly","لَهُمْ وَأَسْرَرْتُ لَهُمْ","",2146],["76:11:8",579,"وَسُرُورًۭا","and happiness","ٱلْيَوْمِ وَلَقَّىٰهُمْ نَضْرَةًۭ","",4283],["84:9:4",589,"مَسْرُورًۭا","happily","وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ","",2466],["84:13:5",589,"مَسْرُورًا","happy","كَانَ فِىٓ أَهْلِهِۦ","",2466],["86:9:3",591,"ٱلسَّرَآئِرُ","the secrets","يَوْمَ تُبْلَى","",4297],["88:13:2",592,"سُرُرٌۭ","(will be) thrones","فِيهَا","مَّرْفُوعَةٌۭ",1231]]