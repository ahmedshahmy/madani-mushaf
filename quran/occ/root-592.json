[["11:114:5",234,"وَزُلَفًۭا","and (at) the approach","ٱلصَّلَوٰةَ طَرَفَىِ ٱلنَّهَارِ","مِّنَ ٱلَّيْلِ ۚ إِنَّ",2827],["26:64:1",370,"وَأَزْلَفْنَا","And We brought near","","ثَمَّ ٱلْـَٔاخَرِينَ",1492],["26:90:1",371,"وَأُزْلِفَتِ","And (will be) brought near","","ٱلْجَنَّةُ لِلْمُتَّقِينَ",1492],["34:37:8",432,"زُلْفَىٰٓ","(in) position","بِٱلَّتِى تُقَرِّبُكُمْ عِندَنَا","إِلَّا مَنْ ءَامَنَ",1688],["38:25:7",454,"لَزُلْفَىٰ","surely is a near access","وَإِنَّ لَهُۥ عِندَنَا","وَحُسْنَ مَـَٔابٍۢ",1688],["38:40:4",455,"لَزُلْفَىٰ","surely is a near access","وَإِنَّ لَهُۥ عِندَنَا","وَحُسْنَ مَـَٔابٍۢ",1688],["39:3:16",458,"زُلْفَىٰٓ","(in) nearness","لِيُقَرِّبُونَآ إِلَى ٱللَّهِ","إِنَّ ٱللَّهَ يَحْكُمُ",1688],["50:31:1",519,"وَأُزْلِفَتِ","And will be brought near","","ٱلْجَنَّةُ لِلْمُتَّقِينَ غَيْرَ",1492],["67:27:3",564,"زُلْفَةًۭ","approaching","فَلَمَّا رَأَوْهُ","سِيٓـَٔتْ وُجُوهُ ٱلَّذِينَ",2827],["81:13:3",586,"أُزْلِفَتْ","is brought near","وَإِذَا ٱلْجَنَّةُ","",1492]]