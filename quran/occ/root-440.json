[["7:57:14",157,"سُقْنَـٰهُ","We drive them","أَقَلَّتْ سَحَابًۭا ثِقَالًۭا","لِبَلَدٍۢ مَّيِّتٍۢ فَأَنزَلْنَا",1105],["8:6:7",177,"يُسَاقُونَ","they were driven","بَعْدَ مَا تَبَيَّنَ كَأَنَّمَا","إِلَى ٱلْمَوْتِ وَهُمْ",1105],["19:86:1",311,"وَنَسُوقُ","And We will drive","","ٱلْمُجْرِمِينَ إِلَىٰ جَهَنَّمَ",1105],["25:7:9",360,"ٱلْأَسْوَاقِ ۙ","the markets","ٱلطَّعَامَ وَيَمْشِى فِى","لَوْلَآ أُنزِلَ إِلَيْهِ",1644],["25:20:12",361,"ٱلْأَسْوَاقِ ۗ","the markets","ٱلطَّعَامَ وَيَمْشُونَ فِى","وَجَعَلْنَا بَعْضَكُمْ لِبَعْضٍۢ",1644],["27:44:11",380,"سَاقَيْهَا ۚ","her shins","لُجَّةًۭ وَكَشَفَتْ عَن","قَالَ إِنَّهُۥ صَرْحٌۭ",1633],["32:27:4",417,"نَسُوقُ","drive","أَوَلَمْ يَرَوْا۟ أَنَّا","ٱلْمَآءَ إِلَى ٱلْأَرْضِ",1105],["35:9:7",435,"فَسُقْنَـٰهُ","and We drive them","ٱلرِّيَـٰحَ فَتُثِيرُ سَحَابًۭا","إِلَىٰ بَلَدٍۢ مَّيِّتٍۢ",1105],["38:33:5",455,"بِٱلسُّوقِ","over the legs","عَلَىَّ ۖ فَطَفِقَ مَسْحًۢا","وَٱلْأَعْنَاقِ",1644],["39:71:1",466,"وَسِيقَ","And (will) be driven","","ٱلَّذِينَ كَفَرُوٓا۟ إِلَىٰ",1105],["39:73:1",466,"وَسِيقَ","And (will) be driven","","ٱلَّذِينَ ٱتَّقَوْا۟ رَبَّهُمْ",1105],["48:29:39",515,"سُوقِهِۦ","its stem","فَٱسْتَغْلَظَ فَٱسْتَوَىٰ عَلَىٰ","يُعْجِبُ ٱلزُّرَّاعَ لِيَغِيظَ",1644],["50:21:5",519,"سَآئِقٌۭ","a driver","كُلُّ نَفْسٍۢ مَّعَهَا","وَشَهِيدٌۭ",4229],["68:42:4",565,"سَاقٍۢ","the shin","يَوْمَ يُكْشَفُ عَن","وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ",1633],["75:29:2",578,"ٱلسَّاقُ","the leg","وَٱلْتَفَّتِ","بِٱلسَّاقِ",1633],["75:29:3",578,"بِٱلسَّاقِ","about the leg","وَٱلْتَفَّتِ ٱلسَّاقُ","",1633],["75:30:4",578,"ٱلْمَسَاقُ","(will be) the driving","إِلَىٰ رَبِّكَ يَوْمَئِذٍ","",3712]]