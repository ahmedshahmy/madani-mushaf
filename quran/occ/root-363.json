[["2:20:1",4,"يَكَادُ","Almost","","ٱلْبَرْقُ يَخْطَفُ أَبْصَـٰرَهُمْ ۖ",441],["2:71:23",11,"كَادُوا۟","they were near","بِٱلْحَقِّ ۚ فَذَبَحُوهَا وَمَا","يَفْعَلُونَ",441],["4:78:34",90,"يَكَادُونَ","do they seem","هَـٰٓؤُلَآءِ ٱلْقَوْمِ لَا","يَفْقَهُونَ حَدِيثًۭا",441],["7:150:29",169,"وَكَادُوا۟","and were about to","إِنَّ ٱلْقَوْمَ ٱسْتَضْعَفُونِى","يَقْتُلُونَنِى فَلَا تُشْمِتْ",441],["9:117:16",205,"كَادَ","had nearly","مِنۢ بَعْدِ مَا","يَزِيغُ قُلُوبُ فَرِيقٍۢ",441],["14:17:3",257,"يَكَادُ","he will be near","يَتَجَرَّعُهُۥ وَلَا","يُسِيغُهُۥ وَيَأْتِيهِ ٱلْمَوْتُ",441],["17:73:2",289,"كَادُوا۟","they were about (to)","وَإِن","لَيَفْتِنُونَكَ عَنِ ٱلَّذِىٓ",441],["17:74:5",289,"كِدتَّ","you almost","أَن ثَبَّتْنَـٰكَ لَقَدْ","تَرْكَنُ إِلَيْهِمْ شَيْـًۭٔا",441],["17:76:2",290,"كَادُوا۟","they were about","وَإِن","لَيَسْتَفِزُّونَكَ مِنَ ٱلْأَرْضِ",441],["18:93:11",303,"يَكَادُونَ","who would almost","دُونِهِمَا قَوْمًۭا لَّا","يَفْقَهُونَ قَوْلًۭا",441],["19:90:1",311,"تَكَادُ","Almost","","ٱلسَّمَـٰوَٰتُ يَتَفَطَّرْنَ مِنْهُ",441],["20:15:4",313,"أَكَادُ","I almost","إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ","أُخْفِيهَا لِتُجْزَىٰ كُلُّ",441],["22:72:12",340,"يَكَادُونَ","They almost","ٱلَّذِينَ كَفَرُوا۟ ٱلْمُنكَرَ ۖ","يَسْطُونَ بِٱلَّذِينَ يَتْلُونَ",441],["24:35:26",354,"يَكَادُ","would almost","شَرْقِيَّةٍۢ وَلَا غَرْبِيَّةٍۢ","زَيْتُهَا يُضِىٓءُ وَلَوْ",441],["24:40:22",355,"يَكَدْ","hardly","أَخْرَجَ يَدَهُۥ لَمْ","يَرَىٰهَا ۗ وَمَن لَّمْ",441],["24:43:34",355,"يَكَادُ","Nearly","عَن مَّن يَشَآءُ ۖ","سَنَا بَرْقِهِۦ يَذْهَبُ",441],["25:42:2",363,"كَادَ","He would have almost","إِن","لَيُضِلُّنَا عَنْ ءَالِهَتِنَا",441],["28:10:7",386,"كَادَتْ","she was near","مُوسَىٰ فَـٰرِغًا ۖ إِن","لَتُبْدِى بِهِۦ لَوْلَآ",441],["37:56:4",448,"كِدتَّ","you almost","قَالَ تَٱللَّهِ إِن","لَتُرْدِينِ",441],["42:5:1",483,"تَكَادُ","Almost","","ٱلسَّمَـٰوَٰتُ يَتَفَطَّرْنَ مِن",441],["43:52:10",493,"يَكَادُ","and hardly","هُوَ مَهِينٌۭ وَلَا","يُبِينُ",441],["67:8:1",562,"تَكَادُ","It almost","","تَمَيَّزُ مِنَ ٱلْغَيْظِ ۖ",441],["68:51:2",566,"يَكَادُ","would almost","وَإِن","ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ",441],["72:19:7",573,"كَادُوا۟","they almost","عَبْدُ ٱللَّهِ يَدْعُوهُ","يَكُونُونَ عَلَيْهِ لِبَدًۭا",441]]