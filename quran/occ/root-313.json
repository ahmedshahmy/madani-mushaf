[["2:63:4",10,"وَرَفَعْنَا","and We raised","وَإِذْ أَخَذْنَا مِيثَـٰقَكُمْ","فَوْقَكُمُ ٱلطُّورَ خُذُوا۟",473],["2:93:4",14,"وَرَفَعْنَا","and We raised","وَإِذْ أَخَذْنَا مِيثَـٰقَكُمْ","فَوْقَكُمُ ٱلطُّورَ خُذُوا۟",473],["2:127:2",20,"يَرْفَعُ","(was) raising","وَإِذْ","إِبْرَٰهِـۧمُ ٱلْقَوَاعِدَ مِنَ",473],["2:253:11",42,"وَرَفَعَ","and He raised","مَّن كَلَّمَ ٱللَّهُ ۖ","بَعْضَهُمْ دَرَجَـٰتٍۢ ۚ وَءَاتَيْنَا",473],["3:55:7",57,"وَرَافِعُكَ","and raise you","يَـٰعِيسَىٰٓ إِنِّى مُتَوَفِّيكَ","إِلَىَّ وَمُطَهِّرُكَ مِنَ",4152],["4:154:1",102,"وَرَفَعْنَا","And We raised","","فَوْقَهُمُ ٱلطُّورَ بِمِيثَـٰقِهِمْ",473],["4:158:2",103,"رَّفَعَهُ","he was raised","بَل","ٱللَّهُ إِلَيْهِ ۚ وَكَانَ",473],["6:83:7",138,"نَرْفَعُ","We raise","إِبْرَٰهِيمَ عَلَىٰ قَوْمِهِۦ ۚ","دَرَجَـٰتٍۢ مَّن نَّشَآءُ ۗ",473],["6:165:6",150,"وَرَفَعَ","and raised","جَعَلَكُمْ خَلَـٰٓئِفَ ٱلْأَرْضِ","بَعْضَكُمْ فَوْقَ بَعْضٍۢ",473],["7:176:3",173,"لَرَفَعْنَـٰهُ","surely, We (could) have raised him","وَلَوْ شِئْنَا","بِهَا وَلَـٰكِنَّهُۥٓ أَخْلَدَ",473],["12:76:25",244,"نَرْفَعُ","We raise","أَن يَشَآءَ ٱللَّهُ ۚ","دَرَجَـٰتٍۢ مَّن نَّشَآءُ ۗ",473],["12:100:1",247,"وَرَفَعَ","And he raised","","أَبَوَيْهِ عَلَى ٱلْعَرْشِ",473],["13:2:3",249,"رَفَعَ","raised","ٱللَّهُ ٱلَّذِى","ٱلسَّمَـٰوَٰتِ بِغَيْرِ عَمَدٍۢ",473],["19:57:1",309,"وَرَفَعْنَـٰهُ","And We raised him","","مَكَانًا عَلِيًّا",473],["24:36:6",354,"تُرْفَعَ","they be raised","أَذِنَ ٱللَّهُ أَن","وَيُذْكَرَ فِيهَا ٱسْمُهُۥ",473],["35:10:14",435,"يَرْفَعُهُۥ ۚ","raises it","ٱلطَّيِّبُ وَٱلْعَمَلُ ٱلصَّـٰلِحُ","وَٱلَّذِينَ يَمْكُرُونَ ٱلسَّيِّـَٔاتِ",473],["40:15:1",468,"رَفِيعُ","Possessor of the Highest Ranks","","ٱلدَّرَجَـٰتِ ذُو ٱلْعَرْشِ",4161],["43:32:12",491,"وَرَفَعْنَا","and We raise","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۚ","بَعْضَهُمْ فَوْقَ بَعْضٍۢ",473],["49:2:5",515,"تَرْفَعُوٓا۟","raise","ٱلَّذِينَ ءَامَنُوا۟ لَا","أَصْوَٰتَكُمْ فَوْقَ صَوْتِ",473],["52:5:2",523,"ٱلْمَرْفُوعِ","raised high","وَٱلسَّقْفِ","",3705],["55:7:2",531,"رَفَعَهَا","He raised it","وَٱلسَّمَآءَ","وَوَضَعَ ٱلْمِيزَانَ",473],["56:3:2",534,"رَّافِعَةٌ","raising up","خَافِضَةٌۭ","",4210],["56:34:2",535,"مَّرْفُوعَةٍ","raised","وَفُرُشٍۢ","",1924],["58:11:18",543,"يَرْفَعِ","Allah will raise","قِيلَ ٱنشُزُوا۟ فَٱنشُزُوا۟","ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟",473],["79:28:1",584,"رَفَعَ","He raised","","سَمْكَهَا فَسَوَّىٰهَا",473],["80:14:1",585,"مَّرْفُوعَةٍۢ","Exalted","","مُّطَهَّرَةٍۭ",1924],["88:13:3",592,"مَّرْفُوعَةٌۭ","raised high","فِيهَا سُرُرٌۭ","",1924],["88:18:4",592,"رُفِعَتْ","it is raised","وَإِلَى ٱلسَّمَآءِ كَيْفَ","",473],["94:4:1",597,"وَرَفَعْنَا","And We raised high","","لَكَ ذِكْرَكَ",473]]