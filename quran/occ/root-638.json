[["2:111:15",17,"بُرْهَـٰنَكُمْ","your proof","أَمَانِيُّهُمْ ۗ قُلْ هَاتُوا۟","إِن كُنتُمْ صَـٰدِقِينَ",971],["4:174:5",105,"بُرْهَـٰنٌۭ","a convincing proof","ٱلنَّاسُ قَدْ جَآءَكُم","مِّن رَّبِّكُمْ وَأَنزَلْنَآ",971],["12:24:9",238,"بُرْهَـٰنَ","the proof","لَوْلَآ أَن رَّءَا","رَبِّهِۦ ۚ كَذَٰلِكَ لِنَصْرِفَ",971],["21:24:8",323,"بُرْهَـٰنَكُمْ ۖ","your proof","ءَالِهَةًۭ ۖ قُلْ هَاتُوا۟","هَـٰذَا ذِكْرُ مَن",971],["23:117:8",349,"بُرْهَـٰنَ","proof","إِلَـٰهًا ءَاخَرَ لَا","لَهُۥ بِهِۦ فَإِنَّمَا",971],["27:64:16",383,"بُرْهَـٰنَكُمْ","your proof","ٱللَّهِ ۚ قُلْ هَاتُوا۟","إِن كُنتُمْ صَـٰدِقِينَ",971],["28:32:16",389,"بُرْهَـٰنَانِ","(are) two evidences","مِنَ ٱلرَّهْبِ ۖ فَذَٰنِكَ","مِن رَّبِّكَ إِلَىٰ",971],["28:75:8",394,"بُرْهَـٰنَكُمْ","your proof","شَهِيدًۭا فَقُلْنَا هَاتُوا۟","فَعَلِمُوٓا۟ أَنَّ ٱلْحَقَّ",971]]