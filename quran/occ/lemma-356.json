[["2:145:30",22,"إِذًۭا","(would) then","مِنَ ٱلْعِلْمِ ۙ إِنَّكَ","لَّمِنَ ٱلظَّـٰلِمِينَ",356],["4:53:6",87,"فَإِذًۭا","Then","نَصِيبٌۭ مِّنَ ٱلْمُلْكِ","لَّا يُؤْتُونَ ٱلنَّاسَ",356],["4:67:1",89,"وَإِذًۭا","And then","","لَّـَٔاتَيْنَـٰهُم مِّن لَّدُنَّآ",356],["4:140:24",100,"إِذًۭا","then","حَدِيثٍ غَيْرِهِۦٓ ۚ إِنَّكُمْ","مِّثْلُهُمْ ۗ إِنَّ ٱللَّهَ",356],["5:106:49",125,"إِذًۭا","then","شَهَـٰدَةَ ٱللَّهِ إِنَّآ","لَّمِنَ ٱلْـَٔاثِمِينَ",356],["5:107:24",125,"إِذًۭا","then","وَمَا ٱعْتَدَيْنَآ إِنَّآ","لَّمِنَ ٱلظَّـٰلِمِينَ",356],["6:56:17",134,"إِذًۭا","then","أَهْوَآءَكُمْ ۙ قَدْ ضَلَلْتُ","وَمَآ أَنَا۠ مِنَ",356],["7:90:11",162,"إِذًۭا","then","ٱتَّبَعْتُمْ شُعَيْبًا إِنَّكُمْ","لَّخَـٰسِرُونَ",356],["10:106:14",220,"إِذًۭا","then (will be)","فَإِن فَعَلْتَ فَإِنَّكَ","مِّنَ ٱلظَّـٰلِمِينَ",356],["11:31:29",225,"إِذًۭا","then","فِىٓ أَنفُسِهِمْ  ۖ إِنِّىٓ","لَّمِنَ ٱلظَّـٰلِمِينَ",356],["12:14:8",236,"إِذًۭا","then","وَنَحْنُ عُصْبَةٌ إِنَّآ","لَّخَـٰسِرُونَ",356],["12:79:12",245,"إِذًۭا","then","مَتَـٰعَنَا عِندَهُۥٓ إِنَّآ","لَّظَـٰلِمُونَ",356],["15:8:8",262,"إِذًۭا","then","بِٱلْحَقِّ وَمَا كَانُوٓا۟","مُّنظَرِينَ",356],["17:42:8",286,"إِذًۭا","then","ءَالِهَةٌۭ كَمَا يَقُولُونَ","لَّٱبْتَغَوْا۟ إِلَىٰ ذِى",356],["17:73:11",289,"وَإِذًۭا","And then","لِتَفْتَرِىَ عَلَيْنَا غَيْرَهُۥ ۖ","لَّٱتَّخَذُوكَ خَلِيلًۭا",356],["17:75:1",289,"إِذًۭا","Then","","لَّأَذَقْنَـٰكَ ضِعْفَ ٱلْحَيَوٰةِ",356],["17:76:8",290,"وَإِذًۭا","But then","ٱلْأَرْضِ لِيُخْرِجُوكَ مِنْهَا ۖ","لَّا يَلْبَثُونَ خِلَـٰفَكَ",356],["17:100:8",292,"إِذًۭا","then","خَزَآئِنَ رَحْمَةِ رَبِّىٓ","لَّأَمْسَكْتُمْ خَشْيَةَ ٱلْإِنفَاقِ ۚ",356],["18:14:18",294,"إِذًۭا","then","إِلَـٰهًۭا ۖ لَّقَدْ قُلْنَآ","شَطَطًا",356],["18:20:12",295,"إِذًا","then","مِلَّتِهِمْ وَلَن تُفْلِحُوٓا۟","أَبَدًۭا",356],["18:57:29",300,"إِذًا","then","ٱلْهُدَىٰ فَلَن يَهْتَدُوٓا۟","أَبَدًۭا",356],["23:34:6",344,"إِذًۭا","then","بَشَرًۭا مِّثْلَكُمْ إِنَّكُمْ","لَّخَـٰسِرُونَ",356],["23:91:11",348,"إِذًۭا","Then","مَعَهُۥ مِنْ إِلَـٰهٍ ۚ","لَّذَهَبَ كُلُّ إِلَـٰهٍۭ",356],["26:20:3",368,"إِذًۭا","when","قَالَ فَعَلْتُهَآ","وَأَنَا۠ مِنَ ٱلضَّآلِّينَ",356],["26:42:4",369,"إِذًۭا","then","قَالَ نَعَمْ وَإِنَّكُمْ","لَّمِنَ ٱلْمُقَرَّبِينَ",356],["29:48:11",402,"إِذًۭا","in that case","وَلَا تَخُطُّهُۥ بِيَمِينِكَ ۖ","لَّٱرْتَابَ ٱلْمُبْطِلُونَ",356],["33:16:11",420,"وَإِذًۭا","and then","ٱلْمَوْتِ أَوِ ٱلْقَتْلِ","لَّا تُمَتَّعُونَ إِلَّا",356],["36:24:2",441,"إِذًۭا","then","إِنِّىٓ","لَّفِى ضَلَـٰلٍۢ مُّبِينٍ",356],["53:22:2",526,"إِذًۭا","then","تِلْكَ","قِسْمَةٌۭ ضِيزَىٰٓ",356],["54:24:7",529,"إِذًۭا","then","وَٰحِدًۭا نَّتَّبِعُهُۥٓ إِنَّآ","لَّفِى ضَلَـٰلٍۢ وَسُعُرٍ",356],["79:12:3",583,"إِذًۭا","then","قَالُوا۟ تِلْكَ","كَرَّةٌ خَاسِرَةٌۭ",356]]