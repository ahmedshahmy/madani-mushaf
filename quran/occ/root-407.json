[["2:266:8",45,"نَّخِيلٍۢ","date-palms","لَهُۥ جَنَّةٌۭ مِّن","وَأَعْنَابٍۢ تَجْرِى مِن",1093],["6:99:20",140,"ٱلنَّخْلِ","the date-palm","حَبًّۭا مُّتَرَاكِبًۭا وَمِنَ","مِن طَلْعِهَا قِنْوَانٌۭ",796],["6:141:8",146,"وَٱلنَّخْلَ","and the date-palm","مَّعْرُوشَـٰتٍۢ وَغَيْرَ مَعْرُوشَـٰتٍۢ","وَٱلزَّرْعَ مُخْتَلِفًا أُكُلُهُۥ",796],["13:4:9",249,"وَنَخِيلٌۭ","and date-palms","مِّنْ أَعْنَـٰبٍۢ وَزَرْعٌۭ","صِنْوَانٌۭ وَغَيْرُ صِنْوَانٍۢ",1093],["16:11:6",268,"وَٱلنَّخِيلَ","and the date-palms","بِهِ ٱلزَّرْعَ وَٱلزَّيْتُونَ","وَٱلْأَعْنَـٰبَ وَمِن كُلِّ",1093],["16:67:3",274,"ٱلنَّخِيلِ","the date-palm","وَمِن ثَمَرَٰتِ","وَٱلْأَعْنَـٰبِ تَتَّخِذُونَ مِنْهُ",1093],["17:91:6",291,"نَّخِيلٍۢ","date-palms","لَكَ جَنَّةٌۭ مِّن","وَعِنَبٍۢ فَتُفَجِّرَ ٱلْأَنْهَـٰرَ",1093],["18:32:11",297,"بِنَخْلٍۢ","with date-palms","مِنْ أَعْنَـٰبٍۢ وَحَفَفْنَـٰهُمَا","وَجَعَلْنَا بَيْنَهُمَا زَرْعًۭا",796],["19:23:5",306,"ٱلنَّخْلَةِ","(of) the date-palm","ٱلْمَخَاضُ إِلَىٰ جِذْعِ","قَالَتْ يَـٰلَيْتَنِى مِتُّ",2571],["19:25:4",306,"ٱلنَّخْلَةِ","(of) the date-palm","وَهُزِّىٓ إِلَيْكِ بِجِذْعِ","تُسَـٰقِطْ عَلَيْكِ رُطَبًۭا",2571],["20:71:21",316,"ٱلنَّخْلِ","(of) date-palms","وَلَأُصَلِّبَنَّكُمْ فِى جُذُوعِ","وَلَتَعْلَمُنَّ أَيُّنَآ أَشَدُّ",796],["23:19:6",343,"نَّخِيلٍۢ","of date-palms","بِهِۦ جَنَّـٰتٍۢ مِّن","وَأَعْنَـٰبٍۢ لَّكُمْ فِيهَا",1093],["26:148:2",373,"وَنَخْلٍۢ","and date-palms","وَزُرُوعٍۢ","طَلْعُهَا هَضِيمٌۭ",796],["36:34:5",442,"نَّخِيلٍۢ","date-palms","فِيهَا جَنَّـٰتٍۢ مِّن","وَأَعْنَـٰبٍۢ وَفَجَّرْنَا فِيهَا",1093],["50:10:1",518,"وَٱلنَّخْلَ","And the palms trees","","بَاسِقَـٰتٍۢ لَّهَا طَلْعٌۭ",796],["54:20:5",529,"نَخْلٍۢ","(of) date-palms","ٱلنَّاسَ كَأَنَّهُمْ أَعْجَازُ","مُّنقَعِرٍۢ",796],["55:11:3",531,"وَٱلنَّخْلُ","and date-palms","فِيهَا فَـٰكِهَةٌۭ","ذَاتُ ٱلْأَكْمَامِ",796],["55:68:3",533,"وَنَخْلٌۭ","and date-palms","فِيهِمَا فَـٰكِهَةٌۭ","وَرُمَّانٌۭ",796],["69:7:14",566,"نَخْلٍ","(of) date-palms","صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ","خَاوِيَةٍۢ",796],["80:29:2",585,"وَنَخْلًۭا","and date-palms","وَزَيْتُونًۭا","",796]]