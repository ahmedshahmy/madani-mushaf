[["2:164:37",25,"ٱلْمُسَخَّرِ","[the] controlled","وَتَصْرِيفِ ٱلرِّيَـٰحِ وَٱلسَّحَابِ","بَيْنَ ٱلسَّمَآءِ وَٱلْأَرْضِ",3850],["2:212:6",33,"وَيَسْخَرُونَ","and they ridicule","كَفَرُوا۟ ٱلْحَيَوٰةُ ٱلدُّنْيَا","مِنَ ٱلَّذِينَ ءَامَنُوا۟ ۘ",800],["6:10:8",129,"سَخِرُوا۟","scoffed","قَبْلِكَ فَحَاقَ بِٱلَّذِينَ","مِنْهُم مَّا كَانُوا۟",800],["7:54:23",157,"مُسَخَّرَٰتٍۭ","subjected","وَٱلشَّمْسَ وَٱلْقَمَرَ وَٱلنُّجُومَ","بِأَمْرِهِۦٓ ۗ أَلَا لَهُ",1916],["9:79:13",199,"فَيَسْخَرُونَ","so they ridicule","يَجِدُونَ إِلَّا جُهْدَهُمْ","مِنْهُمْ ۙ سَخِرَ ٱللَّهُ",800],["9:79:15",199,"سَخِرَ","Allah will ridicule","جُهْدَهُمْ فَيَسْخَرُونَ مِنْهُمْ ۙ","ٱللَّهُ مِنْهُمْ وَلَهُمْ",800],["11:38:9",226,"سَخِرُوا۟","they ridiculed","مَلَأٌۭ مِّن قَوْمِهِۦ","مِنْهُ ۚ قَالَ إِن",800],["11:38:13",226,"تَسْخَرُوا۟","you ridicule","مِنْهُ ۚ قَالَ إِن","مِنَّا فَإِنَّا نَسْخَرُ",800],["11:38:16",226,"نَسْخَرُ","can ridicule","تَسْخَرُوا۟ مِنَّا فَإِنَّا","مِنكُمْ كَمَا تَسْخَرُونَ",800],["11:38:19",226,"تَسْخَرُونَ","you ridicule","نَسْخَرُ مِنكُمْ كَمَا","",800],["13:2:12",249,"وَسَخَّرَ","and subjected","ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ ۖ","ٱلشَّمْسَ وَٱلْقَمَرَ ۖ كُلٌّۭ",476],["14:32:16",259,"وَسَخَّرَ","and subjected","ٱلثَّمَرَٰتِ رِزْقًۭا لَّكُمْ ۖ","لَكُمُ ٱلْفُلْكَ لِتَجْرِىَ",476],["14:32:23",259,"وَسَخَّرَ","and subjected","فِى ٱلْبَحْرِ بِأَمْرِهِۦ ۖ","لَكُمُ ٱلْأَنْهَـٰرَ",476],["14:33:1",259,"وَسَخَّرَ","And He subjected","","لَكُمُ ٱلشَّمْسَ وَٱلْقَمَرَ",476],["14:33:6",259,"وَسَخَّرَ","and subjected","ٱلشَّمْسَ وَٱلْقَمَرَ دَآئِبَيْنِ ۖ","لَكُمُ ٱلَّيْلَ وَٱلنَّهَارَ",476],["16:12:1",268,"وَسَخَّرَ","And He has subjected","","لَكُمُ ٱلَّيْلَ وَٱلنَّهَارَ",476],["16:12:8",268,"مُسَخَّرَٰتٌۢ","(are) subjected","وَٱلشَّمْسَ وَٱلْقَمَرَ ۖ وَٱلنُّجُومُ","بِأَمْرِهِۦٓ ۗ إِنَّ فِى",1916],["16:14:3",268,"سَخَّرَ","subjected","وَهُوَ ٱلَّذِى","ٱلْبَحْرَ لِتَأْكُلُوا۟ مِنْهُ",476],["16:79:5",275,"مُسَخَّرَٰتٍۢ","controlled","يَرَوْا۟ إِلَى ٱلطَّيْرِ","فِى جَوِّ ٱلسَّمَآءِ",1916],["21:41:8",325,"سَخِرُوا۟","mocked","قَبْلِكَ فَحَاقَ بِٱلَّذِينَ","مِنْهُم مَّا كَانُوا۟",800],["21:79:7",328,"وَسَخَّرْنَا","And We subjected","ءَاتَيْنَا حُكْمًۭا وَعِلْمًۭا ۚ","مَعَ دَاوُۥدَ ٱلْجِبَالَ",476],["22:36:24",336,"سَخَّرْنَـٰهَا","We have subjected them","ٱلْقَانِعَ وَٱلْمُعْتَرَّ ۚ كَذَٰلِكَ","لَكُمْ لَعَلَّكُمْ تَشْكُرُونَ",476],["22:37:12",336,"سَخَّرَهَا","He subjected them","ٱلتَّقْوَىٰ مِنكُمْ ۚ كَذَٰلِكَ","لَكُمْ لِتُكَبِّرُوا۟ ٱللَّهَ",476],["22:65:5",340,"سَخَّرَ","(has) subjected","تَرَ أَنَّ ٱللَّهَ","لَكُم مَّا فِى",476],["23:110:2",349,"سِخْرِيًّا","(in) mockery","فَٱتَّخَذْتُمُوهُمْ","حَتَّىٰٓ أَنسَوْكُمْ ذِكْرِى",2640],["29:61:7",403,"وَسَخَّرَ","and subjected","خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","ٱلشَّمْسَ وَٱلْقَمَرَ لَيَقُولُنَّ",476],["31:20:5",413,"سَخَّرَ","has subjected","تَرَوْا۟ أَنَّ ٱللَّهَ","لَكُم مَّا فِى",476],["31:29:13",414,"وَسَخَّرَ","and has subjected","ٱلنَّهَارَ فِى ٱلَّيْلِ","ٱلشَّمْسَ وَٱلْقَمَرَ كُلٌّۭ",476],["35:13:9",436,"وَسَخَّرَ","and He has subjected","ٱلنَّهَارَ فِى ٱلَّيْلِ","ٱلشَّمْسَ وَٱلْقَمَرَ كُلٌّۭ",476],["37:12:3",446,"وَيَسْخَرُونَ","while they mock","بَلْ عَجِبْتَ","",800],["37:14:4",446,"يَسْتَسْخِرُونَ","they mock","وَإِذَا رَأَوْا۟ ءَايَةًۭ","",4666],["38:18:2",454,"سَخَّرْنَا","subjected","إِنَّا","ٱلْجِبَالَ مَعَهُۥ يُسَبِّحْنَ",476],["38:36:1",455,"فَسَخَّرْنَا","Then We subjected","","لَهُ ٱلرِّيحَ تَجْرِى",476],["38:63:2",457,"سِخْرِيًّا","(in) ridicule","أَتَّخَذْنَـٰهُمْ","أَمْ زَاغَتْ عَنْهُمُ",2640],["39:5:13",458,"وَسَخَّرَ","And He subjected","ٱلنَّهَارَ عَلَى ٱلَّيْلِ ۖ","ٱلشَّمْسَ وَٱلْقَمَرَ ۖ كُلٌّۭ",476],["39:56:14",464,"ٱلسَّـٰخِرِينَ","the mockers","وَإِن كُنتُ لَمِنَ","",4295],["43:13:14",490,"سَخَّرَ","(has) subjected","وَتَقُولُوا۟ سُبْحَـٰنَ ٱلَّذِى","لَنَا هَـٰذَا وَمَا",476],["43:32:20",491,"سُخْرِيًّۭا ۗ","(for) service","لِّيَتَّخِذَ بَعْضُهُم بَعْضًۭا","وَرَحْمَتُ رَبِّكَ خَيْرٌۭ",4288],["45:12:3",499,"سَخَّرَ","subjected","۞ ٱللَّهُ ٱلَّذِى","لَكُمُ ٱلْبَحْرَ لِتَجْرِىَ",476],["45:13:1",499,"وَسَخَّرَ","And He has subjected","","لَكُم مَّا فِى",476],["49:11:5",516,"يَسْخَرْ","ridicule","ٱلَّذِينَ ءَامَنُوا۟ لَا","قَوْمٌۭ مِّن قَوْمٍ",800],["69:7:1",566,"سَخَّرَهَا","Which He imposed","","عَلَيْهِمْ سَبْعَ لَيَالٍۢ",476]]