[["2:191:3",30,"ثَقِفْتُمُوهُمْ","you find them","وَٱقْتُلُوهُمْ حَيْثُ","وَأَخْرِجُوهُم مِّنْ حَيْثُ",1237],["3:112:6",64,"ثُقِفُوٓا۟","they are found","ٱلذِّلَّةُ أَيْنَ مَا","إِلَّا بِحَبْلٍۢ مِّنَ",1237],["4:91:26",92,"ثَقِفْتُمُوهُمْ ۚ","you find them","فَخُذُوهُمْ وَٱقْتُلُوهُمْ حَيْثُ","وَأُو۟لَـٰٓئِكُمْ جَعَلْنَا لَكُمْ",1237],["8:57:2",184,"تَثْقَفَنَّهُمْ","you gain dominance over them","فَإِمَّا","فِى ٱلْحَرْبِ فَشَرِّدْ",1237],["33:61:3",426,"ثُقِفُوٓا۟","they are found","مَّلْعُونِينَ ۖ أَيْنَمَا","أُخِذُوا۟ وَقُتِّلُوا۟ تَقْتِيلًۭا",1237],["60:2:2",549,"يَثْقَفُوكُمْ","they gain dominance over you","إِن","يَكُونُوا۟ لَكُمْ أَعْدَآءًۭ",1237]]