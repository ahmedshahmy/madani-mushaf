[["2:83:10",12,"وَبِٱلْوَٰلِدَيْنِ","and with [the] parents","تَعْبُدُونَ إِلَّا ٱللَّهَ","إِحْسَانًۭا وَذِى ٱلْقُرْبَىٰ",673],["2:116:4",18,"وَلَدًۭا ۗ","a son","وَقَالُوا۟ ٱتَّخَذَ ٱللَّهُ","سُبْحَـٰنَهُۥ ۖ بَل لَّهُۥ",216],["2:180:11",27,"لِلْوَٰلِدَيْنِ","for the parents","تَرَكَ خَيْرًا ٱلْوَصِيَّةُ","وَٱلْأَقْرَبِينَ بِٱلْمَعْرُوفِ ۖ حَقًّا",673],["2:215:9",33,"فَلِلْوَٰلِدَيْنِ","(is) for parents","أَنفَقْتُم مِّنْ خَيْرٍۢ","وَٱلْأَقْرَبِينَ وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ",673],["2:233:1",37,"۞ وَٱلْوَٰلِدَٰتُ","And the mothers","","يُرْضِعْنَ أَوْلَـٰدَهُنَّ حَوْلَيْنِ",4519],["2:233:3",37,"أَوْلَـٰدَهُنَّ","their children","۞ وَٱلْوَٰلِدَٰتُ يُرْضِعْنَ","حَوْلَيْنِ كَامِلَيْنِ ۖ لِمَنْ",216],["2:233:12",37,"ٱلْمَوْلُودِ","the father","يُتِمَّ ٱلرَّضَاعَةَ ۚ وَعَلَى","لَهُۥ رِزْقُهُنَّ وَكِسْوَتُهُنَّ",1892],["2:233:24",37,"وَٰلِدَةٌۢ","(the) mother","وُسْعَهَا ۚ لَا تُضَآرَّ","بِوَلَدِهَا وَلَا مَوْلُودٌۭ",2707],["2:233:25",37,"بِوَلَدِهَا","because of her child","لَا تُضَآرَّ وَٰلِدَةٌۢ","وَلَا مَوْلُودٌۭ لَّهُۥ",216],["2:233:27",37,"مَوْلُودٌۭ","(the) father","وَٰلِدَةٌۢ بِوَلَدِهَا وَلَا","لَّهُۥ بِوَلَدِهِۦ ۚ وَعَلَى",1892],["2:233:29",37,"بِوَلَدِهِۦ ۚ","because of his child","وَلَا مَوْلُودٌۭ لَّهُۥ","وَعَلَى ٱلْوَارِثِ مِثْلُ",216],["2:233:48",37,"أَوْلَـٰدَكُمْ","your child","أَرَدتُّمْ أَن تَسْتَرْضِعُوٓا۟","فَلَا جُنَاحَ عَلَيْكُمْ",216],["3:10:9",51,"أَوْلَـٰدُهُم","their children","عَنْهُمْ أَمْوَٰلُهُمْ وَلَآ","مِّنَ ٱللَّهِ شَيْـًۭٔا ۖ",216],["3:47:6",56,"وَلَدٌۭ","a boy","أَنَّىٰ يَكُونُ لِى","وَلَمْ يَمْسَسْنِى بَشَرٌۭ ۖ",216],["3:116:9",65,"أَوْلَـٰدُهُم","their children","عَنْهُمْ أَمْوَٰلُهُمْ وَلَآ","مِّنَ ٱللَّهِ شَيْـًۭٔا ۖ",216],["4:7:5",78,"ٱلْوَٰلِدَانِ","(by) the parents","نَصِيبٌۭ مِّمَّا تَرَكَ","وَٱلْأَقْرَبُونَ وَلِلنِّسَآءِ نَصِيبٌۭ",673],["4:7:11",78,"ٱلْوَٰلِدَانِ","(by) parents","نَصِيبٌۭ مِّمَّا تَرَكَ","وَٱلْأَقْرَبُونَ مِمَّا قَلَّ",673],["4:11:4",78,"أَوْلَـٰدِكُمْ ۖ","your children","يُوصِيكُمُ ٱللَّهُ فِىٓ","لِلذَّكَرِ مِثْلُ حَظِّ",216],["4:11:33",78,"وَلَدٌۭ ۚ","a child","إِن كَانَ لَهُۥ","فَإِن لَّمْ يَكُن",216],["4:11:38",78,"وَلَدٌۭ","any child","لَّمْ يَكُن لَّهُۥ","وَوَرِثَهُۥٓ أَبَوَاهُ فَلِأُمِّهِ",216],["4:12:10",79,"وَلَدٌۭ ۚ","a child","لَّمْ يَكُن لَّهُنَّ","فَإِن كَانَ لَهُنَّ",216],["4:12:14",79,"وَلَدٌۭ","a child","فَإِن كَانَ لَهُنَّ","فَلَكُمُ ٱلرُّبُعُ مِمَّا",216],["4:12:34",79,"وَلَدٌۭ ۚ","a child","لَّمْ يَكُن لَّكُمْ","فَإِن كَانَ لَكُمْ",216],["4:12:38",79,"وَلَدٌۭ","a child","فَإِن كَانَ لَكُمْ","فَلَهُنَّ ٱلثُّمُنُ مِمَّا",216],["4:33:6",83,"ٱلْوَٰلِدَانِ","(by) the parents","مَوَٰلِىَ مِمَّا تَرَكَ","وَٱلْأَقْرَبُونَ ۚ وَٱلَّذِينَ عَقَدَتْ",673],["4:36:7",84,"وَبِٱلْوَٰلِدَيْنِ","and to the parents","تُشْرِكُوا۟ بِهِۦ شَيْـًۭٔا ۖ","إِحْسَـٰنًۭا وَبِذِى ٱلْقُرْبَىٰ",673],["4:75:12",90,"وَٱلْوِلْدَٰنِ","and the children","مِنَ ٱلرِّجَالِ وَٱلنِّسَآءِ","ٱلَّذِينَ يَقُولُونَ رَبَّنَآ",1112],["4:98:6",94,"وَٱلْوِلْدَٰنِ","and the children","مِنَ ٱلرِّجَالِ وَٱلنِّسَآءِ","لَا يَسْتَطِيعُونَ حِيلَةًۭ",1112],["4:127:27",98,"ٱلْوِلْدَٰنِ","the children","تَنكِحُوهُنَّ وَٱلْمُسْتَضْعَفِينَ مِنَ","وَأَن تَقُومُوا۟ لِلْيَتَـٰمَىٰ",1112],["4:135:13",100,"ٱلْوَٰلِدَيْنِ","the parents","عَلَىٰٓ أَنفُسِكُمْ أَوِ","وَٱلْأَقْرَبِينَ ۚ إِن يَكُنْ",673],["4:171:43",105,"وَلَدٌۭ ۘ","a son","أَن يَكُونَ لَهُۥ","لَّهُۥ مَا فِى",216],["4:176:12",106,"وَلَدٌۭ","a child","هَلَكَ لَيْسَ لَهُۥ","وَلَهُۥٓ أُخْتٌۭ فَلَهَا",216],["4:176:25",106,"وَلَدٌۭ ۚ","a child","لَّمْ يَكُن لَّهَا","فَإِن كَانَتَا ٱثْنَتَيْنِ",216],["5:110:11",126,"وَٰلِدَتِكَ","your mother","نِعْمَتِى عَلَيْكَ وَعَلَىٰ","إِذْ أَيَّدتُّكَ بِرُوحِ",2707],["6:101:7",140,"وَلَدٌۭ","a son","أَنَّىٰ يَكُونُ لَهُۥ","وَلَمْ تَكُن لَّهُۥ",216],["6:137:7",145,"أَوْلَـٰدِهِمْ","(of) their children","مِّنَ ٱلْمُشْرِكِينَ قَتْلَ","شُرَكَآؤُهُمْ لِيُرْدُوهُمْ وَلِيَلْبِسُوا۟",216],["6:140:5",146,"أَوْلَـٰدَهُمْ","their children","خَسِرَ ٱلَّذِينَ قَتَلُوٓا۟","سَفَهًۢا بِغَيْرِ عِلْمٍۢ",216],["6:151:12",148,"وَبِٱلْوَٰلِدَيْنِ","and with the parents","تُشْرِكُوا۟ بِهِۦ شَيْـًۭٔا ۖ","إِحْسَـٰنًۭا ۖ وَلَا تَقْتُلُوٓا۟",673],["6:151:16",148,"أَوْلَـٰدَكُم","your children","إِحْسَـٰنًۭا ۖ وَلَا تَقْتُلُوٓا۟","مِّنْ إِمْلَـٰقٍۢ ۖ نَّحْنُ",216],["8:28:4",180,"وَأَوْلَـٰدُكُمْ","and your children","وَٱعْلَمُوٓا۟ أَنَّمَآ أَمْوَٰلُكُمْ","فِتْنَةٌۭ وَأَنَّ ٱللَّهَ",216],["9:55:5",196,"أَوْلَـٰدُهُمْ ۚ","their children","تُعْجِبْكَ أَمْوَٰلُهُمْ وَلَآ","إِنَّمَا يُرِيدُ ٱللَّهُ",216],["9:69:10",198,"وَأَوْلَـٰدًۭا","and children","قُوَّةًۭ وَأَكْثَرَ أَمْوَٰلًۭا","فَٱسْتَمْتَعُوا۟ بِخَلَـٰقِهِمْ فَٱسْتَمْتَعْتُم",216],["9:85:4",200,"وَأَوْلَـٰدُهُمْ ۚ","and their children","وَلَا تُعْجِبْكَ أَمْوَٰلُهُمْ","إِنَّمَا يُرِيدُ ٱللَّهُ",216],["10:68:4",216,"وَلَدًۭا ۗ","a son","قَالُوا۟ ٱتَّخَذَ ٱللَّهُ","سُبْحَـٰنَهُۥ ۖ هُوَ ٱلْغَنِىُّ ۖ",216],["11:72:3",230,"ءَأَلِدُ","Shall I bear a child","قَالَتْ يَـٰوَيْلَتَىٰٓ","وَأَنَا۠ عَجُوزٌۭ وَهَـٰذَا",930],["12:21:14",237,"وَلَدًۭا ۚ","(as) a son","يَنفَعَنَآ أَوْ نَتَّخِذَهُۥ","وَكَذَٰلِكَ مَكَّنَّا لِيُوسُفَ",216],["14:41:4",260,"وَلِوَٰلِدَىَّ","and my parents","رَبَّنَا ٱغْفِرْ لِى","وَلِلْمُؤْمِنِينَ يَوْمَ يَقُومُ",863],["17:23:7",284,"وَبِٱلْوَٰلِدَيْنِ","and to the parents","تَعْبُدُوٓا۟ إِلَّآ إِيَّاهُ","إِحْسَـٰنًا ۚ إِمَّا يَبْلُغَنَّ",673],["17:31:3",285,"أَوْلَـٰدَكُمْ","your children","وَلَا تَقْتُلُوٓا۟","خَشْيَةَ إِمْلَـٰقٍۢ ۖ نَّحْنُ",216],["17:64:13",288,"وَٱلْأَوْلَـٰدِ","and the children","وَشَارِكْهُمْ فِى ٱلْأَمْوَٰلِ","وَعِدْهُمْ ۚ وَمَا يَعِدُهُمُ",216],["17:111:7",293,"وَلَدًۭا","a son","ٱلَّذِى لَمْ يَتَّخِذْ","وَلَمْ يَكُن لَّهُۥ",216],["18:4:6",293,"وَلَدًۭا","a son","قَالُوا۟ ٱتَّخَذَ ٱللَّهُ","",216],["18:39:19",298,"وَوَلَدًۭا","and children","أَقَلَّ مِنكَ مَالًۭا","",216],["19:14:2",306,"بِوَٰلِدَيْهِ","to his parents","وَبَرًّۢا","وَلَمْ يَكُن جَبَّارًا",863],["19:15:4",306,"وُلِدَ","he was born","وَسَلَـٰمٌ عَلَيْهِ يَوْمَ","وَيَوْمَ يَمُوتُ وَيَوْمَ",930],["19:32:2",307,"بِوَٰلِدَتِى","to my mother","وَبَرًّۢا","وَلَمْ يَجْعَلْنِى جَبَّارًۭا",673],["19:33:4",307,"وُلِدتُّ","I was born","وَٱلسَّلَـٰمُ عَلَىَّ يَوْمَ","وَيَوْمَ أَمُوتُ وَيَوْمَ",930],["19:35:7",307,"وَلَدٍۢ ۖ","any son","أَن يَتَّخِذَ مِن","سُبْحَـٰنَهُۥٓ ۚ إِذَا قَضَىٰٓ",216],["19:77:8",311,"وَوَلَدًا","and children","وَقَالَ لَأُوتَيَنَّ مَالًۭا","",216],["19:88:4",311,"وَلَدًۭا","a son","وَقَالُوا۟ ٱتَّخَذَ ٱلرَّحْمَـٰنُ","",216],["19:91:4",311,"وَلَدًۭا","a son","أَن دَعَوْا۟ لِلرَّحْمَـٰنِ","",216],["19:92:6",311,"وَلَدًا","a son","لِلرَّحْمَـٰنِ أَن يَتَّخِذَ","",216],["21:26:4",324,"وَلَدًۭا ۗ","a son","وَقَالُوا۟ ٱتَّخَذَ ٱلرَّحْمَـٰنُ","سُبْحَـٰنَهُۥ ۚ بَلْ عِبَادٌۭ",216],["23:91:5",348,"وَلَدٍۢ","son","ٱتَّخَذَ ٱللَّهُ مِن","وَمَا كَانَ مَعَهُۥ",216],["25:2:8",359,"وَلَدًۭا","a son","وَٱلْأَرْضِ وَلَمْ يَتَّخِذْ","وَلَمْ يَكُن لَّهُۥ",216],["26:18:5",367,"وَلِيدًۭا","(as) a child","أَلَمْ نُرَبِّكَ فِينَا","وَلَبِثْتَ فِينَا مِنْ",1112],["27:19:15",378,"وَٰلِدَىَّ","my parents","أَنْعَمْتَ عَلَىَّ وَعَلَىٰ","وَأَنْ أَعْمَلَ صَـٰلِحًۭا",863],["28:9:15",386,"وَلَدًۭا","(as) a son","يَنفَعَنَآ أَوْ نَتَّخِذَهُۥ","وَهُمْ لَا يَشْعُرُونَ",216],["29:8:3",397,"بِوَٰلِدَيْهِ","goodness to his parents","وَوَصَّيْنَا ٱلْإِنسَـٰنَ","حُسْنًۭا ۖ وَإِن جَـٰهَدَاكَ",863],["31:14:3",412,"بِوَٰلِدَيْهِ","for his parents","وَوَصَّيْنَا ٱلْإِنسَـٰنَ","حَمَلَتْهُ أُمُّهُۥ وَهْنًا",863],["31:14:15",412,"وَلِوَٰلِدَيْكَ","and to your parents","أَنِ ٱشْكُرْ لِى","إِلَىَّ ٱلْمَصِيرُ",863],["31:33:9",414,"وَالِدٌ","a father","يَوْمًۭا لَّا يَجْزِى","عَن وَلَدِهِۦ وَلَا",673],["31:33:11",414,"وَلَدِهِۦ","his son","يَجْزِى وَالِدٌ عَن","وَلَا مَوْلُودٌ هُوَ",216],["31:33:13",414,"مَوْلُودٌ","a son","عَن وَلَدِهِۦ وَلَا","هُوَ جَازٍ عَن",1892],["31:33:17",414,"وَالِدِهِۦ","his father","هُوَ جَازٍ عَن","شَيْـًٔا ۚ إِنَّ وَعْدَ",673],["34:35:5",432,"وَأَوْلَـٰدًۭا","and children","نَحْنُ أَكْثَرُ أَمْوَٰلًۭا","وَمَا نَحْنُ بِمُعَذَّبِينَ",216],["34:37:4",432,"أَوْلَـٰدُكُم","your children","وَمَآ أَمْوَٰلُكُمْ وَلَآ","بِٱلَّتِى تُقَرِّبُكُمْ عِندَنَا",216],["37:152:1",451,"وَلَدَ","Allah has begotten","","ٱللَّهُ وَإِنَّهُمْ لَكَـٰذِبُونَ",930],["39:4:6",458,"وَلَدًۭا","a son","ٱللَّهُ أَن يَتَّخِذَ","لَّٱصْطَفَىٰ مِمَّا يَخْلُقُ",216],["43:81:5",495,"وَلَدٌۭ","a son","إِن كَانَ لِلرَّحْمَـٰنِ","فَأَنَا۠ أَوَّلُ ٱلْعَـٰبِدِينَ",216],["46:15:3",504,"بِوَٰلِدَيْهِ","to his parents","وَوَصَّيْنَا ٱلْإِنسَـٰنَ","إِحْسَـٰنًا ۖ حَمَلَتْهُ أُمُّهُۥ",863],["46:15:31",504,"وَٰلِدَىَّ","my parents","أَنْعَمْتَ عَلَىَّ وَعَلَىٰ","وَأَنْ أَعْمَلَ صَـٰلِحًۭا",863],["46:17:3",504,"لِوَٰلِدَيْهِ","to his parents","وَٱلَّذِى قَالَ","أُفٍّۢ لَّكُمَآ أَتَعِدَانِنِىٓ",863],["56:17:3",535,"وِلْدَٰنٌۭ","boys","يَطُوفُ عَلَيْهِمْ","مُّخَلَّدُونَ",1112],["57:20:13",540,"وَٱلْأَوْلَـٰدِ ۖ","and the children","وَتَكَاثُرٌۭ فِى ٱلْأَمْوَٰلِ","كَمَثَلِ غَيْثٍ أَعْجَبَ",216],["58:2:13",542,"وَلَدْنَهُمْ ۚ","gave them birth","أُمَّهَـٰتُهُمْ إِلَّا ٱلَّـٰٓـِٔى","وَإِنَّهُمْ لَيَقُولُونَ مُنكَرًۭا",930],["58:17:6",544,"أَوْلَـٰدُهُم","their children","عَنْهُمْ أَمْوَٰلُهُمْ وَلَآ","مِّنَ ٱللَّهِ شَيْـًٔا ۚ",216],["60:3:5",549,"أَوْلَـٰدُكُمْ ۚ","your children","تَنفَعَكُمْ أَرْحَامُكُمْ وَلَآ","يَوْمَ ٱلْقِيَـٰمَةِ يَفْصِلُ",216],["60:12:19",551,"أَوْلَـٰدَهُنَّ","their children","يَزْنِينَ وَلَا يَقْتُلْنَ","وَلَا يَأْتِينَ بِبُهْتَـٰنٍۢ",216],["63:9:8",555,"أَوْلَـٰدُكُمْ","your children","تُلْهِكُمْ أَمْوَٰلُكُمْ وَلَآ","عَن ذِكْرِ ٱللَّهِ ۚ",216],["64:14:7",557,"وَأَوْلَـٰدِكُمْ","and your children","إِنَّ مِنْ أَزْوَٰجِكُمْ","عَدُوًّۭا لَّكُمْ فَٱحْذَرُوهُمْ ۚ",216],["64:15:3",557,"وَأَوْلَـٰدُكُمْ","and your children","إِنَّمَآ أَمْوَٰلُكُمْ","فِتْنَةٌۭ ۚ وَٱللَّهُ عِندَهُۥٓ",216],["71:21:11",571,"وَوَلَدُهُۥٓ","and his children","لَّمْ يَزِدْهُ مَالُهُۥ","إِلَّا خَسَارًۭا",216],["71:27:7",571,"يَلِدُوٓا۟","they will beget","يُضِلُّوا۟ عِبَادَكَ وَلَا","إِلَّا فَاجِرًۭا كَفَّارًۭا",930],["71:28:4",571,"وَلِوَٰلِدَىَّ","and my parents","رَّبِّ ٱغْفِرْ لِى","وَلِمَن دَخَلَ بَيْتِىَ",863],["72:3:9",572,"وَلَدًۭا","a son","ٱتَّخَذَ صَـٰحِبَةًۭ وَلَا","",216],["73:17:7",574,"ٱلْوِلْدَٰنَ","the children","كَفَرْتُمْ يَوْمًۭا يَجْعَلُ","شِيبًا",1112],["76:19:3",579,"وِلْدَٰنٌۭ","young boys","۞ وَيَطُوفُ عَلَيْهِمْ","مُّخَلَّدُونَ إِذَا رَأَيْتَهُمْ",1112],["90:3:1",594,"وَوَالِدٍۢ","And the begetter","","وَمَا وَلَدَ",673],["90:3:3",594,"وَلَدَ","he begot","وَوَالِدٍۢ وَمَا","",930],["112:3:2",604,"يَلِدْ","He begets","لَمْ","وَلَمْ يُولَدْ",930],["112:3:4",604,"يُولَدْ","He is begotten","لَمْ يَلِدْ وَلَمْ","",930]]