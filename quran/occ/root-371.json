[["2:20:8",4,"مَّشَوْا۟","they walk","كُلَّمَآ أَضَآءَ لَهُم","فِيهِ وَإِذَآ أَظْلَمَ",492],["6:122:8",143,"يَمْشِى","he walks","وَجَعَلْنَا لَهُۥ نُورًۭا","بِهِۦ فِى ٱلنَّاسِ",492],["7:195:3",175,"يَمْشُونَ","(to) walk","أَلَهُمْ أَرْجُلٌۭ","بِهَآ ۖ أَمْ لَهُمْ",492],["17:37:2",285,"تَمْشِ","walk","وَلَا","فِى ٱلْأَرْضِ مَرَحًا ۖ",492],["17:95:7",291,"يَمْشُونَ","walking","فِى ٱلْأَرْضِ مَلَـٰٓئِكَةٌۭ","مُطْمَئِنِّينَ لَنَزَّلْنَا عَلَيْهِم",492],["20:40:2",314,"تَمْشِىٓ","was going","إِذْ","أُخْتُكَ فَتَقُولُ هَلْ",492],["20:128:9",321,"يَمْشُونَ","(as) they walk","قَبْلَهُم مِّنَ ٱلْقُرُونِ","فِى مَسَـٰكِنِهِمْ ۗ إِنَّ",492],["24:45:9",356,"يَمْشِى","walks","مَّآءٍۢ ۖ فَمِنْهُم مَّن","عَلَىٰ بَطْنِهِۦ وَمِنْهُم",492],["24:45:14",356,"يَمْشِى","walks","بَطْنِهِۦ وَمِنْهُم مَّن","عَلَىٰ رِجْلَيْنِ وَمِنْهُم",492],["24:45:19",356,"يَمْشِى","walks","رِجْلَيْنِ وَمِنْهُم مَّن","عَلَىٰٓ أَرْبَعٍۢ ۚ يَخْلُقُ",492],["25:7:7",360,"وَيَمْشِى","and walk","ٱلرَّسُولِ يَأْكُلُ ٱلطَّعَامَ","فِى ٱلْأَسْوَاقِ ۙ لَوْلَآ",492],["25:20:10",361,"وَيَمْشُونَ","and walked","إِنَّهُمْ لَيَأْكُلُونَ ٱلطَّعَامَ","فِى ٱلْأَسْوَاقِ ۗ وَجَعَلْنَا",492],["25:63:4",365,"يَمْشُونَ","walk","وَعِبَادُ ٱلرَّحْمَـٰنِ ٱلَّذِينَ","عَلَى ٱلْأَرْضِ هَوْنًۭا",492],["28:25:3",388,"تَمْشِى","walking","فَجَآءَتْهُ إِحْدَىٰهُمَا","عَلَى ٱسْتِحْيَآءٍۢ قَالَتْ",492],["31:18:6",412,"تَمْشِ","walk","خَدَّكَ لِلنَّاسِ وَلَا","فِى ٱلْأَرْضِ مَرَحًا ۖ",492],["31:19:3",412,"مَشْيِكَ","your pace","وَٱقْصِدْ فِى","وَٱغْضُضْ مِن صَوْتِكَ ۚ",3622],["32:26:10",417,"يَمْشُونَ","they walk about","قَبْلِهِم مِّنَ ٱلْقُرُونِ","فِى مَسَـٰكِنِهِمْ ۚ إِنَّ",492],["38:6:5",453,"ٱمْشُوا۟","Continue","ٱلْمَلَأُ مِنْهُمْ أَنِ","وَٱصْبِرُوا۟ عَلَىٰٓ ءَالِهَتِكُمْ ۖ",492],["57:28:15",541,"تَمْشُونَ","you will walk","وَيَجْعَل لَّكُمْ نُورًۭا","بِهِۦ وَيَغْفِرْ لَكُمْ ۚ",492],["67:15:7",563,"فَٱمْشُوا۟","so walk","لَكُمُ ٱلْأَرْضَ ذَلُولًۭا","فِى مَنَاكِبِهَا وَكُلُوا۟",492],["67:22:2",563,"يَمْشِى","walks","أَفَمَن","مُكِبًّا عَلَىٰ وَجْهِهِۦٓ",492],["67:22:8",563,"يَمْشِى","walks","وَجْهِهِۦٓ أَهْدَىٰٓ أَمَّن","سَوِيًّا عَلَىٰ صِرَٰطٍۢ",492],["68:11:2",564,"مَّشَّآءٍۭ","going about","هَمَّازٍۢ","بِنَمِيمٍۢ",3902]]