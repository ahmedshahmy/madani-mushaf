[["2:20:14",4,"وَلَوْ","And if","أَظْلَمَ عَلَيْهِمْ قَامُوا۟ ۚ","شَآءَ ٱللَّهُ لَذَهَبَ",57],["2:96:11",15,"لَوْ","if","أَشْرَكُوا۟ ۚ يَوَدُّ أَحَدُهُمْ","يُعَمَّرُ أَلْفَ سَنَةٍۢ",57],["2:102:72",16,"لَوْ","if","شَرَوْا۟ بِهِۦٓ أَنفُسَهُمْ ۚ","كَانُوا۟ يَعْلَمُونَ",57],["2:103:1",16,"وَلَوْ","And if","","أَنَّهُمْ ءَامَنُوا۟ وَٱتَّقَوْا۟",57],["2:103:10",16,"لَّوْ","if","عِندِ ٱللَّهِ خَيْرٌۭ ۖ","كَانُوا۟ يَعْلَمُونَ",57],["2:109:6",17,"لَوْ","if","مِّنْ أَهْلِ ٱلْكِتَـٰبِ","يَرُدُّونَكُم مِّنۢ بَعْدِ",57],["2:165:17",25,"وَلَوْ","And if","أَشَدُّ حُبًّۭا لِّلَّهِ ۗ","يَرَى ٱلَّذِينَ ظَلَمُوٓا۟",57],["2:167:4",25,"لَوْ","(Only) if","وَقَالَ ٱلَّذِينَ ٱتَّبَعُوا۟","أَنَّ لَنَا كَرَّةًۭ",57],["2:170:15",26,"أَوَلَوْ","Even though","أَلْفَيْنَا عَلَيْهِ ءَابَآءَنَآ ۗ","كَانَ ءَابَآؤُهُمْ لَا",57],["2:220:19",35,"وَلَوْ","And if","ٱلْمُفْسِدَ مِنَ ٱلْمُصْلِحِ ۚ","شَآءَ ٱللَّهُ لَأَعْنَتَكُمْ ۚ",57],["2:221:11",35,"وَلَوْ","[and] even if","خَيْرٌۭ مِّن مُّشْرِكَةٍۢ","أَعْجَبَتْكُمْ ۗ وَلَا تُنكِحُوا۟",57],["2:221:23",35,"وَلَوْ","[and] even if","خَيْرٌۭ مِّن مُّشْرِكٍۢ","أَعْجَبَكُمْ ۗ أُو۟لَـٰٓئِكَ يَدْعُونَ",57],["2:253:22",42,"وَلَوْ","And if","وَأَيَّدْنَـٰهُ بِرُوحِ ٱلْقُدُسِ ۗ","شَآءَ ٱللَّهُ مَا",57],["2:253:43",42,"وَلَوْ","And if","وَمِنْهُم مَّن كَفَرَ ۚ","شَآءَ ٱللَّهُ مَا",57],["3:30:15",54,"لَوْ","[if]","مِن سُوٓءٍۢ تَوَدُّ","أَنَّ بَيْنَهَا وَبَيْنَهُۥٓ",57],["3:69:6",58,"لَوْ","if","مِّنْ أَهْلِ ٱلْكِتَـٰبِ","يُضِلُّونَكُمْ وَمَا يُضِلُّونَ",57],["3:91:14",61,"وَلَوِ","[and] (even) if","مِّلْءُ ٱلْأَرْضِ ذَهَبًۭا","ٱفْتَدَىٰ بِهِۦٓ ۗ أُو۟لَـٰٓئِكَ",57],["3:110:13",64,"وَلَوْ","And if","ٱلْمُنكَرِ وَتُؤْمِنُونَ بِٱللَّهِ ۗ","ءَامَنَ أَهْلُ ٱلْكِتَـٰبِ",57],["3:154:42",70,"لَوْ","If","يُبْدُونَ لَكَ ۖ يَقُولُونَ","كَانَ لَنَا مِنَ",57],["3:154:52",70,"لَّوْ","If","قُتِلْنَا هَـٰهُنَا ۗ قُل","كُنتُمْ فِى بُيُوتِكُمْ",57],["3:156:17",70,"لَّوْ","If","أَوْ كَانُوا۟ غُزًّۭى","كَانُوا۟ عِندَنَا مَا",57],["3:159:7",71,"وَلَوْ","And if","ٱللَّهِ لِنتَ لَهُمْ ۖ","كُنتَ فَظًّا غَلِيظَ",57],["3:167:14",72,"لَوْ","If","أَوِ ٱدْفَعُوا۟ ۖ قَالُوا۟","نَعْلَمُ قِتَالًۭا لَّٱتَّبَعْنَـٰكُمْ ۗ",57],["3:168:5",72,"لَوْ","If","قَالُوا۟ لِإِخْوَٰنِهِمْ وَقَعَدُوا۟","أَطَاعُونَا مَا قُتِلُوا۟ ۗ",57],["4:9:3",78,"لَوْ","if","وَلْيَخْشَ ٱلَّذِينَ","تَرَكُوا۟ مِنْ خَلْفِهِمْ",57],["4:39:3",85,"لَوْ","if","وَمَاذَا عَلَيْهِمْ","ءَامَنُوا۟ بِٱللَّهِ وَٱلْيَوْمِ",57],["4:42:7",85,"لَوْ","if","كَفَرُوا۟ وَعَصَوُا۟ ٱلرَّسُولَ","تُسَوَّىٰ بِهِمُ ٱلْأَرْضُ",57],["4:46:20",86,"وَلَوْ","And if","وَطَعْنًۭا فِى ٱلدِّينِ ۚ","أَنَّهُمْ قَالُوا۟ سَمِعْنَا",57],["4:64:9",88,"وَلَوْ","And if","لِيُطَاعَ بِإِذْنِ ٱللَّهِ ۚ","أَنَّهُمْ إِذ ظَّلَمُوٓا۟",57],["4:66:1",89,"وَلَوْ","And if","","أَنَّا كَتَبْنَا عَلَيْهِمْ",57],["4:66:17",89,"وَلَوْ","But if","إِلَّا قَلِيلٌۭ مِّنْهُمْ ۖ","أَنَّهُمْ فَعَلُوا۟ مَا",57],["4:78:5",90,"وَلَوْ","even if","تَكُونُوا۟ يُدْرِككُّمُ ٱلْمَوْتُ","كُنتُمْ فِى بُرُوجٍۢ",57],["4:82:4",91,"وَلَوْ","And if","أَفَلَا يَتَدَبَّرُونَ ٱلْقُرْءَانَ ۚ","كَانَ مِنْ عِندِ",57],["4:83:10",91,"وَلَوْ","But if","ٱلْخَوْفِ أَذَاعُوا۟ بِهِۦ ۖ","رَدُّوهُ إِلَى ٱلرَّسُولِ",57],["4:89:2",92,"لَوْ","if","وَدُّوا۟","تَكْفُرُونَ كَمَا كَفَرُوا۟",57],["4:90:18",92,"وَلَوْ","And if","أَوْ يُقَـٰتِلُوا۟ قَوْمَهُمْ ۚ","شَآءَ ٱللَّهُ لَسَلَّطَهُمْ",57],["4:102:31",95,"لَوْ","if","وَدَّ ٱلَّذِينَ كَفَرُوا۟","تَغْفُلُونَ عَنْ أَسْلِحَتِكُمْ",57],["4:129:7",99,"وَلَوْ","even if","تَعْدِلُوا۟ بَيْنَ ٱلنِّسَآءِ","حَرَصْتُمْ ۖ فَلَا تَمِيلُوا۟",57],["4:135:9",100,"وَلَوْ","even if","بِٱلْقِسْطِ شُهَدَآءَ لِلَّهِ","عَلَىٰٓ أَنفُسِكُمْ أَوِ",57],["5:36:4",113,"لَوْ","if","إِنَّ ٱلَّذِينَ كَفَرُوا۟","أَنَّ لَهُم مَّا",57],["5:48:30",116,"وَلَوْ","And if","مِنكُمْ شِرْعَةًۭ وَمِنْهَاجًۭا ۚ","شَآءَ ٱللَّهُ لَجَعَلَكُمْ",57],["5:65:1",119,"وَلَوْ","And if","","أَنَّ أَهْلَ ٱلْكِتَـٰبِ",57],["5:66:1",119,"وَلَوْ","And if","","أَنَّهُمْ أَقَامُوا۟ ٱلتَّوْرَىٰةَ",57],["5:81:1",121,"وَلَوْ","And if","","كَانُوا۟ يُؤْمِنُونَ بِٱللَّهِ",57],["5:100:6",124,"وَلَوْ","even if","يَسْتَوِى ٱلْخَبِيثُ وَٱلطَّيِّبُ","أَعْجَبَكَ كَثْرَةُ ٱلْخَبِيثِ ۚ",57],["5:104:17",125,"أَوَلَوْ","Even though","وَجَدْنَا عَلَيْهِ ءَابَآءَنَآ ۚ","كَانَ ءَابَآؤُهُمْ لَا",57],["5:106:40",125,"وَلَوْ","even if","نَشْتَرِى بِهِۦ ثَمَنًۭا","كَانَ ذَا قُرْبَىٰ ۙ",57],["6:7:1",128,"وَلَوْ","And (even) if","","نَزَّلْنَا عَلَيْكَ كِتَـٰبًۭا",57],["6:8:6",128,"وَلَوْ","And if","أُنزِلَ عَلَيْهِ مَلَكٌۭ ۖ","أَنزَلْنَا مَلَكًۭا لَّقُضِىَ",57],["6:9:1",129,"وَلَوْ","And if","","جَعَلْنَـٰهُ مَلَكًۭا لَّجَعَلْنَـٰهُ",57],["6:27:1",130,"وَلَوْ","And if","","تَرَىٰٓ إِذْ وُقِفُوا۟",57],["6:28:9",131,"وَلَوْ","And if","يُخْفُونَ مِن قَبْلُ ۖ","رُدُّوا۟ لَعَادُوا۟ لِمَا",57],["6:30:1",131,"وَلَوْ","And if","","تَرَىٰٓ إِذْ وُقِفُوا۟",57],["6:35:19",131,"وَلَوْ","But if","ٱلسَّمَآءِ فَتَأْتِيَهُم بِـَٔايَةٍۢ ۚ","شَآءَ ٱللَّهُ لَجَمَعَهُمْ",57],["6:58:2",134,"لَّوْ","If","قُل","أَنَّ عِندِى مَا",57],["6:88:10",138,"وَلَوْ","But if","يَشَآءُ مِنْ عِبَادِهِۦ ۚ","أَشْرَكُوا۟ لَحَبِطَ عَنْهُم",57],["6:93:23",139,"وَلَوْ","And if","مَآ أَنزَلَ ٱللَّهُ ۗ","تَرَىٰٓ إِذِ ٱلظَّـٰلِمُونَ",57],["6:107:1",141,"وَلَوْ","And if","","شَآءَ ٱللَّهُ مَآ",57],["6:111:1",142,"۞ وَلَوْ","And (even) if","","أَنَّنَا نَزَّلْنَآ إِلَيْهِمُ",57],["6:112:16",142,"وَلَوْ","But if","زُخْرُفَ ٱلْقَوْلِ غُرُورًۭا ۚ","شَآءَ رَبُّكَ مَا",57],["6:137:13",145,"وَلَوْ","And if","وَلِيَلْبِسُوا۟ عَلَيْهِمْ دِينَهُمْ ۖ","شَآءَ ٱللَّهُ مَا",57],["6:148:4",148,"لَوْ","If","سَيَقُولُ ٱلَّذِينَ أَشْرَكُوا۟","شَآءَ ٱللَّهُ مَآ",57],["6:149:5",148,"فَلَوْ","And if","فَلِلَّهِ ٱلْحُجَّةُ ٱلْبَـٰلِغَةُ ۖ","شَآءَ لَهَدَىٰكُمْ أَجْمَعِينَ",57],["6:152:24",149,"وَلَوْ","even if","وَإِذَا قُلْتُمْ فَٱعْدِلُوا۟","كَانَ ذَا قُرْبَىٰ ۖ",57],["6:157:3",149,"لَوْ","If","أَوْ تَقُولُوا۟","أَنَّآ أُنزِلَ عَلَيْنَا",57],["7:88:19",162,"أَوَلَوْ","Even if","فِى مِلَّتِنَا ۚ قَالَ","كُنَّا كَـٰرِهِينَ",57],["7:96:1",163,"وَلَوْ","And if","","أَنَّ أَهْلَ ٱلْقُرَىٰٓ",57],["7:100:10",163,"لَّوْ","if","بَعْدِ أَهْلِهَآ أَن","نَشَآءُ أَصَبْنَـٰهُم بِذُنُوبِهِمْ ۚ",57],["7:155:12",169,"لَوْ","If","ٱلرَّجْفَةُ قَالَ رَبِّ","شِئْتَ أَهْلَكْتَهُم مِّن",57],["7:176:1",173,"وَلَوْ","And if","","شِئْنَا لَرَفَعْنَـٰهُ بِهَا",57],["7:188:12",175,"وَلَوْ","And if","مَا شَآءَ ٱللَّهُ ۚ","كُنتُ أَعْلَمُ ٱلْغَيْبَ",57],["8:8:5",177,"وَلَوْ","even if","ٱلْحَقَّ وَيُبْطِلَ ٱلْبَـٰطِلَ","كَرِهَ ٱلْمُجْرِمُونَ",57],["8:19:19",179,"وَلَوْ","even if","عَنكُمْ فِئَتُكُمْ شَيْـًۭٔا","كَثُرَتْ وَأَنَّ ٱللَّهَ",57],["8:23:1",179,"وَلَوْ","And if","","عَلِمَ ٱللَّهُ فِيهِمْ",57],["8:23:7",179,"وَلَوْ","And if","فِيهِمْ خَيْرًۭا لَّأَسْمَعَهُمْ ۖ","أَسْمَعَهُمْ لَتَوَلَّوا۟ وَّهُم",57],["8:31:8",180,"لَوْ","if","قَالُوا۟ قَدْ سَمِعْنَا","نَشَآءُ لَقُلْنَا مِثْلَ",57],["8:42:11",182,"وَلَوْ","And if","وَٱلرَّكْبُ أَسْفَلَ مِنكُمْ ۚ","تَوَاعَدتُّمْ لَٱخْتَلَفْتُمْ فِى",57],["8:43:7",182,"وَلَوْ","and if","فِى مَنَامِكَ قَلِيلًۭا ۖ","أَرَىٰكَهُمْ كَثِيرًۭا لَّفَشِلْتُمْ",57],["8:50:1",183,"وَلَوْ","And if","","تَرَىٰٓ إِذْ يَتَوَفَّى",57],["8:63:4",185,"لَوْ","If","وَأَلَّفَ بَيْنَ قُلُوبِهِمْ ۚ","أَنفَقْتَ مَا فِى",57],["9:32:13",192,"وَلَوْ","even if","أَن يُتِمَّ نُورَهُۥ","كَرِهَ ٱلْكَـٰفِرُونَ",57],["9:33:12",192,"وَلَوْ","Even if","عَلَى ٱلدِّينِ كُلِّهِۦ","كَرِهَ ٱلْمُشْرِكُونَ",57],["9:42:1",194,"لَوْ","If","","كَانَ عَرَضًۭا قَرِيبًۭا",57],["9:42:14",194,"لَوِ","If","ٱلشُّقَّةُ ۚ وَسَيَحْلِفُونَ بِٱللَّهِ","ٱسْتَطَعْنَا لَخَرَجْنَا مَعَكُمْ",57],["9:46:1",194,"۞ وَلَوْ","And if","","أَرَادُوا۟ ٱلْخُرُوجَ لَأَعَدُّوا۟",57],["9:47:1",194,"لَوْ","If","","خَرَجُوا۟ فِيكُم مَّا",57],["9:57:1",196,"لَوْ","If","","يَجِدُونَ مَلْجَـًٔا أَوْ",57],["9:59:1",196,"وَلَوْ","And if","","أَنَّهُمْ رَضُوا۟ مَآ",57],["9:81:25",200,"لَّوْ","If (only)","جَهَنَّمَ أَشَدُّ حَرًّۭا ۚ","كَانُوا۟ يَفْقَهُونَ",57],["9:113:9",205,"وَلَوْ","even though","أَن يَسْتَغْفِرُوا۟ لِلْمُشْرِكِينَ","كَانُوٓا۟ أُو۟لِى قُرْبَىٰ",57],["10:11:1",209,"۞ وَلَوْ","And if","","يُعَجِّلُ ٱللَّهُ لِلنَّاسِ",57],["10:16:2",2