[["2:22:22",4,"وَأَنتُمْ","while you","تَجْعَلُوا۟ لِلَّهِ أَندَادًۭا","تَعْلَمُونَ",85],["2:42:7",7,"وَأَنتُمْ","while you","بِٱلْبَـٰطِلِ وَتَكْتُمُوا۟ ٱلْحَقَّ","تَعْلَمُونَ",85],["2:44:6",7,"وَأَنتُمْ","while you","بِٱلْبِرِّ وَتَنسَوْنَ أَنفُسَكُمْ","تَتْلُونَ ٱلْكِتَـٰبَ ۚ أَفَلَا",85],["2:50:9",8,"وَأَنتُمْ","while you","وَأَغْرَقْنَآ ءَالَ فِرْعَوْنَ","تَنظُرُونَ",85],["2:51:11",8,"وَأَنتُمْ","and you","ٱلْعِجْلَ مِنۢ بَعْدِهِۦ","ظَـٰلِمُونَ",85],["2:55:13",8,"وَأَنتُمْ","while you","جَهْرَةًۭ فَأَخَذَتْكُمُ ٱلصَّـٰعِقَةُ","تَنظُرُونَ",85],["2:83:28",12,"وَأَنتُم","and you (were)","إِلَّا قَلِيلًۭا مِّنكُمْ","مُّعْرِضُونَ",85],["2:84:14",13,"وَأَنتُمْ","while you","دِيَـٰرِكُمْ ثُمَّ أَقْرَرْتُمْ","تَشْهَدُونَ",85],["2:85:2",13,"أَنتُمْ","you","ثُمَّ","هَـٰٓؤُلَآءِ تَقْتُلُونَ أَنفُسَكُمْ",85],["2:92:10",14,"وَأَنتُمْ","and you","ٱلْعِجْلَ مِنۢ بَعْدِهِۦ","ظَـٰلِمُونَ",85],["2:132:15",20,"وَأَنتُم","while you","فَلَا تَمُوتُنَّ إِلَّا","مُّسْلِمُونَ",85],["2:140:14",21,"ءَأَنتُمْ","Are you","أَوْ نَصَـٰرَىٰ ۗ قُلْ","أَعْلَمُ أَمِ ٱللَّهُ ۗ",85],["2:187:11",29,"وَأَنتُمْ","and you","هُنَّ لِبَاسٌۭ لَّكُمْ","لِبَاسٌۭ لَّهُنَّ ۗ عَلِمَ",85],["2:187:50",29,"وَأَنتُمْ","while you","ٱلَّيْلِ ۚ وَلَا تُبَـٰشِرُوهُنَّ","عَـٰكِفُونَ فِى ٱلْمَسَـٰجِدِ ۗ",85],["2:188:16",29,"وَأَنتُمْ","while you","أَمْوَٰلِ ٱلنَّاسِ بِٱلْإِثْمِ","تَعْلَمُونَ",85],["2:216:23",34,"وَأَنتُمْ","while you","لَّكُمْ ۗ وَٱللَّهُ يَعْلَمُ","لَا تَعْلَمُونَ",85],["2:232:31",37,"وَأَنتُمْ","and you","وَأَطْهَرُ ۗ وَٱللَّهُ يَعْلَمُ","لَا تَعْلَمُونَ",85],["2:272:26",46,"وَأَنتُمْ","and you","خَيْرٍۢ يُوَفَّ إِلَيْكُمْ","لَا تُظْلَمُونَ",85],["3:66:1",58,"هَـٰٓأَنتُمْ","Here you are","","هَـٰٓؤُلَآءِ حَـٰجَجْتُمْ فِيمَا",85],["3:66:17",58,"وَأَنتُمْ","while you","عِلْمٌۭ ۚ وَٱللَّهُ يَعْلَمُ","لَا تَعْلَمُونَ",85],["3:70:7",58,"وَأَنتُمْ","while you","تَكْفُرُونَ بِـَٔايَـٰتِ ٱللَّهِ","تَشْهَدُونَ",85],["3:71:9",59,"وَأَنتُمْ","while you","بِٱلْبَـٰطِلِ وَتَكْتُمُونَ ٱلْحَقَّ","تَعْلَمُونَ",85],["3:80:12",60,"أَنتُم","you (have become)","بِٱلْكُفْرِ بَعْدَ إِذْ","مُّسْلِمُونَ",85],["3:99:13",62,"وَأَنتُمْ","while you","ءَامَنَ تَبْغُونَهَا عِوَجًۭا","شُهَدَآءُ ۗ وَمَا ٱللَّهُ",85],["3:101:3",63,"وَأَنتُمْ","while [you]","وَكَيْفَ تَكْفُرُونَ","تُتْلَىٰ عَلَيْكُمْ ءَايَـٰتُ",85],["3:102:11",63,"وَأَنتُم","[while you]","وَلَا تَمُوتُنَّ إِلَّا","مُّسْلِمُونَ",85],["3:119:1",65,"هَـٰٓأَنتُمْ","Lo! You are","","أُو۟لَآءِ تُحِبُّونَهُمْ وَلَا",85],["3:123:5",66,"وَأَنتُمْ","while you (were)","نَصَرَكُمُ ٱللَّهُ بِبَدْرٍۢ","أَذِلَّةٌۭ ۖ فَٱتَّقُوا۟ ٱللَّهَ",85],["3:139:5",67,"وَأَنتُمُ","and you (will be)","تَهِنُوا۟ وَلَا تَحْزَنُوا۟","ٱلْأَعْلَوْنَ إِن كُنتُم",85],["3:143:11",68,"وَأَنتُمْ","while you (were)","تَلْقَوْهُ فَقَدْ رَأَيْتُمُوهُ","تَنظُرُونَ",85],["3:179:8",73,"أَنتُمْ","you (are)","ٱلْمُؤْمِنِينَ عَلَىٰ مَآ","عَلَيْهِ حَتَّىٰ يَمِيزَ",85],["4:43:7",85,"وَأَنتُمْ","while you","لَا تَقْرَبُوا۟ ٱلصَّلَوٰةَ","سُكَـٰرَىٰ حَتَّىٰ تَعْلَمُوا۟",85],["4:109:1",96,"هَـٰٓأَنتُمْ","Here you are","","هَـٰٓؤُلَآءِ جَـٰدَلْتُمْ عَنْهُمْ",85],["5:1:17",106,"وَأَنتُمْ","while you","غَيْرَ مُحِلِّى ٱلصَّيْدِ","حُرُمٌ ۗ إِنَّ ٱللَّهَ",85],["5:18:13",111,"أَنتُم","you (are)","يُعَذِّبُكُم بِذُنُوبِكُم ۖ بَلْ","بَشَرٌۭ مِّمَّنْ خَلَقَ ۚ",85],["5:88:10",122,"أَنتُم","you (are)","وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ","بِهِۦ مُؤْمِنُونَ",85],["5:91:19",123,"أَنتُم","you","وَعَنِ ٱلصَّلَوٰةِ ۖ فَهَلْ","مُّنتَهُونَ",85],["5:95:7",123,"وَأَنتُمْ","while you","لَا تَقْتُلُوا۟ ٱلصَّيْدَ","حُرُمٌۭ ۚ وَمَن قَتَلَهُۥ",85],["5:106:21",125,"أَنتُمْ","you","مِنْ غَيْرِكُمْ إِنْ","ضَرَبْتُمْ فِى ٱلْأَرْضِ",85],["6:2:13",128,"أَنتُمْ","you","مُّسَمًّى عِندَهُۥ ۖ ثُمَّ","تَمْتَرُونَ",85],["6:64:9",135,"أَنتُمْ","you","كُلِّ كَرْبٍۢ ثُمَّ","تُشْرِكُونَ",85],["6:91:35",139,"أَنتُمْ","you","مَّا لَمْ تَعْلَمُوٓا۟","وَلَآ ءَابَآؤُكُمْ ۖ قُلِ",85],["6:134:6",145,"أَنتُم","(can) you","تُوعَدُونَ لَـَٔاتٍۢ ۖ وَمَآ","بِمُعْجِزِينَ",85],["6:148:35",148,"أَنتُمْ","you (do)","إِلَّا ٱلظَّنَّ وَإِنْ","إِلَّا تَخْرُصُونَ",85],["7:49:14",156,"أَنتُمْ","you","خَوْفٌ عَلَيْكُمْ وَلَآ","تَحْزَنُونَ",85],["7:71:13",159,"أَنتُمْ","you","فِىٓ أَسْمَآءٍۢ سَمَّيْتُمُوهَآ","وَءَابَآؤُكُم مَّا نَزَّلَ",85],["7:81:9",160,"أَنتُمْ","you","دُونِ ٱلنِّسَآءِ ۚ بَلْ","قَوْمٌۭ مُّسْرِفُونَ",85],["7:193:11",175,"أَنتُمْ","you","عَلَيْكُمْ أَدَعَوْتُمُوهُمْ أَمْ","صَـٰمِتُونَ",85],["8:20:10",179,"وَأَنتُمْ","while you","وَلَا تَوَلَّوْا۟ عَنْهُ","تَسْمَعُونَ",85],["8:26:3",180,"أَنتُمْ","you","وَٱذْكُرُوٓا۟ إِذْ","قَلِيلٌۭ مُّسْتَضْعَفُونَ فِى",85],["8:27:10",180,"وَأَنتُمْ","while you","وَٱلرَّسُولَ وَتَخُونُوٓا۟ أَمَـٰنَـٰتِكُمْ","تَعْلَمُونَ",85],["8:42:2",182,"أَنتُم","you (were)","إِذْ","بِٱلْعُدْوَةِ ٱلدُّنْيَا وَهُم",85],["8:60:31",184,"وَأَنتُمْ","and you","ٱللَّهِ يُوَفَّ إِلَيْكُمْ","لَا تُظْلَمُونَ",85],["10:28:9",212,"أَنتُمْ","you","لِلَّذِينَ أَشْرَكُوا۟ مَكَانَكُمْ","وَشُرَكَآؤُكُمْ ۚ فَزَيَّلْنَا بَيْنَهُمْ ۖ",85],["10:41:8",213,"أَنتُم","You","عَمَلِى وَلَكُمْ عَمَلُكُمْ ۖ","بَرِيٓـُٔونَ مِمَّآ أَعْمَلُ",85],["10:53:10",214,"أَنتُم","you","إِنَّهُۥ لَحَقٌّۭ ۖ وَمَآ","بِمُعْجِزِينَ",85],["10:80:9",218,"أَنتُم","you","مُّوسَىٰٓ أَلْقُوا۟ مَآ","مُّلْقُونَ",85],["11:14:15",223,"أَنتُم","you","إِلَّا هُوَ ۖ فَهَلْ","مُّسْلِمُونَ",85],["11:28:17",224,"وَأَنتُمْ","while you (are)","فَعُمِّيَتْ عَلَيْكُمْ أَنُلْزِمُكُمُوهَا","لَهَا كَـٰرِهُونَ",85],["11:33:9",225,"أَنتُم","you (are)","إِن شَآءَ وَمَآ","بِمُعْجِزِينَ",85],["11:50:15",227,"أَنتُمْ","you","إِلَـٰهٍ غَيْرُهُۥٓ ۖ إِنْ","إِلَّا مُفْتَرُونَ",85],["12:13:11",236,"وَأَنتُمْ","while you","أَن يَأْكُلَهُ ٱلذِّئْبُ","عَنْهُ غَـٰفِلُونَ",85],["12:40:8",240,"أَنتُمْ","you","إِلَّآ أَسْمَآءًۭ سَمَّيْتُمُوهَآ","وَءَابَآؤُكُم مَّآ أَنزَلَ",85],["12:77:18",244,"أَنتُمْ","You","يُبْدِهَا لَهُمْ ۚ قَالَ","شَرٌّۭ مَّكَانًۭا ۖ وَٱللَّهُ",85],["12:89:9",246,"أَنتُمْ","you were","بِيُوسُفَ وَأَخِيهِ إِذْ","جَـٰهِلُونَ",85],["14:8:5",256,"أَنتُمْ","you","مُوسَىٰٓ إِن تَكْفُرُوٓا۟","وَمَن فِى ٱلْأَرْضِ",85],["14:10:20",256,"أَنتُمْ","you","مُّسَمًّۭى ۚ قَالُوٓا۟ إِنْ","إِلَّا بَشَرٌۭ مِّثْلُنَا",85],["14:21:13",258,"أَنتُم","you (be)","لَكُمْ تَبَعًۭا فَهَلْ","مُّغْنُونَ عَنَّا مِنْ",85],["14:22:32",258,"أَنتُم","you (can)","أَنَا۠ بِمُصْرِخِكُمْ وَمَآ","بِمُصْرِخِىَّ ۖ إِنِّى كَفَرْتُ",85],["15:22:10",263,"أَنتُمْ","you","مَآءًۭ فَأَسْقَيْنَـٰكُمُوهُ وَمَآ","لَهُۥ بِخَـٰزِنِينَ",85],["16:74:8",275,"وَأَنتُمْ","and you","إِنَّ ٱللَّهَ يَعْلَمُ","لَا تَعْلَمُونَ",85],["17:100:3",292,"أَنتُمْ","you","قُل لَّوْ","تَمْلِكُونَ خَزَآئِنَ رَحْمَةِ",85],["21:3:14",322,"وَأَنتُمْ","while you","مِّثْلُكُمْ ۖ أَفَتَأْتُونَ ٱلسِّحْرَ","تُبْصِرُونَ",85],["21:50:5",326,"أَفَأَنتُمْ","Then are you","ذِكْرٌۭ مُّبَارَكٌ أَنزَلْنَـٰهُ ۚ","لَهُۥ مُنكِرُونَ",85],["21:52:9",326,"أَنتُمْ","you","هَـٰذِهِ ٱلتَّمَاثِيلُ ٱلَّتِىٓ","لَهَا عَـٰكِفُونَ",85],["21:54:4",326,"أَنتُمْ","[you]","قَالَ لَقَدْ كُنتُمْ","وَءَابَآؤُكُمْ فِى ضَلَـٰلٍۢ",85],["21:64:6",327,"أَنتُمُ","[you]","أَنفُسِهِمْ فَقَالُوٓا۟ إِنَّكُمْ","ٱلظَّـٰلِمُونَ",85],["21:80:9",328,"أَنتُمْ","you","مِّنۢ بَأْسِكُمْ ۖ فَهَلْ","شَـٰكِرُونَ",85],["21:98:9",330,"أَنتُمْ","You","ٱللَّهِ حَصَبُ جَهَنَّمَ","لَهَا وَٰرِدُونَ",85],["21:108:10",331,"أَنتُم","you","إِلَـٰهٌۭ وَٰحِدٌۭ ۖ فَهَلْ","مُّسْلِمُونَ",85],["24:19:18",351,"وَأَنتُمْ","while you","وَٱلْـَٔاخِرَةِ ۚ وَٱللَّهُ يَعْلَمُ","لَا تَعْلَمُونَ",85],["24:64:11",359,"أَنتُمْ","you","قَدْ يَعْلَمُ مَآ","عَلَيْهِ وَيَوْمَ يُرْجَعُونَ",85],["25:17:9",361,"ءَأَنتُمْ","Did you","دُونِ ٱللَّهِ فَيَقُولُ","أَضْلَلْتُمْ عِبَادِى هَـٰٓؤُلَآءِ",85],["26:39:4",368,"أَنتُم","you","وَقِيلَ لِلنَّاسِ هَلْ","مُّجْتَمِعُونَ",85],["26:43:6",369,"أَنتُم","you","مُّوسَىٰٓ أَلْقُوا۟ مَآ","مُّلْقُونَ",85],["26:76:1",370,"أَنتُمْ","You","","وَءَابَآؤُكُمُ ٱلْأَقْدَمُونَ",85],["26:166:9",374,"أَنتُمْ","you","مِّنْ أَزْوَٰجِكُم ۚ بَلْ","قَوْمٌ عَادُونَ",85],["27:36:14",380,"أَنتُم","you","مِّمَّآ ءَاتَىٰكُم بَلْ","بِهَدِيَّتِكُمْ تَفْرَحُونَ",85],["27:47:11",381,"أَنتُمْ","you","عِندَ ٱللَّهِ 