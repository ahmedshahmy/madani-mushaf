[["3:36:24",54,"ٱلرَّجِيمِ","the rejected","وَذُرِّيَّتَهَا مِنَ ٱلشَّيْطَـٰنِ","",1222],["11:91:14",232,"لَرَجَمْنَـٰكَ ۖ","surely we would have stoned you","ضَعِيفًۭا ۖ وَلَوْلَا رَهْطُكَ","وَمَآ أَنتَ عَلَيْنَا",1389],["15:17:5",263,"رَّجِيمٍ","accursed","مِن كُلِّ شَيْطَـٰنٍۢ","",1222],["15:34:5",264,"رَجِيمٌۭ","(are) expelled","فَٱخْرُجْ مِنْهَا فَإِنَّكَ","",1222],["16:98:8",278,"ٱلرَّجِيمِ","the accursed","بِٱللَّهِ مِنَ ٱلشَّيْطَـٰنِ","",1222],["18:20:5",295,"يَرْجُمُوكُمْ","they will stone you","إِن يَظْهَرُوا۟ عَلَيْكُمْ","أَوْ يُعِيدُوكُمْ فِى",1389],["18:22:9",296,"رَجْمًۢا","guessing","خَمْسَةٌۭ سَادِسُهُمْ كَلْبُهُمْ","بِٱلْغَيْبِ ۖ وَيَقُولُونَ سَبْعَةٌۭ",4172],["19:46:10",308,"لَأَرْجُمَنَّكَ ۖ","surely, I will stone you","لَئِن لَّمْ تَنتَهِ","وَٱهْجُرْنِى مَلِيًّۭا",1389],["26:116:8",372,"ٱلْمَرْجُومِينَ","those who are stoned","يَـٰنُوحُ لَتَكُونَنَّ مِنَ","",3707],["36:18:8",441,"لَنَرْجُمَنَّكُمْ","surely, we will stone you","لَئِن لَّمْ تَنتَهُوا۟","وَلَيَمَسَّنَّكُم مِّنَّا عَذَابٌ",1389],["38:77:5",457,"رَجِيمٌۭ","(are) accursed","فَٱخْرُجْ مِنْهَا فَإِنَّكَ","",1222],["44:20:6",497,"تَرْجُمُونِ","you stone me","بِرَبِّى وَرَبِّكُمْ أَن","",1389],["67:5:7",562,"رُجُومًۭا","(as) missiles","ٱلدُّنْيَا بِمَصَـٰبِيحَ وَجَعَلْنَـٰهَا","لِّلشَّيَـٰطِينِ ۖ وَأَعْتَدْنَا لَهُمْ",4199],["81:25:5",586,"رَّجِيمٍۢ","accursed","هُوَ بِقَوْلِ شَيْطَـٰنٍۢ","",1222]]