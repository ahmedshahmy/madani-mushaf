[["2:22:3",4,"لَكُمُ","for you","ٱلَّذِى جَعَلَ","ٱلْأَرْضَ فِرَٰشًۭا وَٱلسَّمَآءَ",26],["2:22:17",4,"لَّكُمْ ۖ","for you","مِنَ ٱلثَّمَرَٰتِ رِزْقًۭا","فَلَا تَجْعَلُوا۟ لِلَّهِ",26],["2:29:4",5,"لَكُم","for you","هُوَ ٱلَّذِى خَلَقَ","مَّا فِى ٱلْأَرْضِ",26],["2:33:11",6,"لَّكُمْ","to you","قَالَ أَلَمْ أَقُل","إِنِّىٓ أَعْلَمُ غَيْبَ",26],["2:36:13",6,"وَلَكُمْ","and for you","بَعْضُكُمْ لِبَعْضٍ عَدُوٌّۭ ۖ","فِى ٱلْأَرْضِ مُسْتَقَرٌّۭ",26],["2:50:3",8,"بِكُمُ","for you","وَإِذْ فَرَقْنَا","ٱلْبَحْرَ فَأَنجَيْنَـٰكُمْ وَأَغْرَقْنَآ",26],["2:54:18",8,"لَّكُمْ","for you","أَنفُسَكُمْ ذَٰلِكُمْ خَيْرٌۭ","عِندَ بَارِئِكُمْ فَتَابَ",26],["2:58:17",9,"لَكُمْ","for you","وَقُولُوا۟ حِطَّةٌۭ نَّغْفِرْ","خَطَـٰيَـٰكُمْ ۚ وَسَنَزِيدُ ٱلْمُحْسِنِينَ",26],["2:61:34",9,"لَكُم","for you","ٱهْبِطُوا۟ مِصْرًۭا فَإِنَّ","مَّا سَأَلْتُمْ ۗ وَضُرِبَتْ",26],["2:75:4",11,"لَكُمْ","[for] you","۞ أَفَتَطْمَعُونَ أَن يُؤْمِنُوا۟","وَقَدْ كَانَ فَرِيقٌۭ",26],["2:94:4",15,"لَكُمُ","for you","قُلْ إِن كَانَتْ","ٱلدَّارُ ٱلْـَٔاخِرَةُ عِندَ",26],["2:107:10",17,"لَكُم","(is) for you","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۗ وَمَا","مِّن دُونِ ٱللَّهِ",26],["2:132:10",20,"لَكُمُ","for you","إِنَّ ٱللَّهَ ٱصْطَفَىٰ","ٱلدِّينَ فَلَا تَمُوتُنَّ",26],["2:134:8",20,"وَلَكُم","and for you","لَهَا مَا كَسَبَتْ","مَّا كَسَبْتُمْ ۖ وَلَا",26],["2:139:10",21,"وَلَكُمْ","and for you","وَرَبُّكُمْ وَلَنَآ أَعْمَـٰلُنَا","أَعْمَـٰلُكُمْ وَنَحْنُ لَهُۥ",26],["2:141:8",21,"وَلَكُم","and for you","لَهَا مَا كَسَبَتْ","مَّا كَسَبْتُمْ ۖ وَلَا",26],["2:148:11",23,"بِكُمُ","you","مَا تَكُونُوا۟ يَأْتِ","ٱللَّهُ جَمِيعًا ۚ إِنَّ",26],["2:168:14",25,"لَكُمْ","(is) to you","خُطُوَٰتِ ٱلشَّيْطَـٰنِ ۚ إِنَّهُۥ","عَدُوٌّۭ مُّبِينٌ",26],["2:179:1",27,"وَلَكُمْ","And for you","","فِى ٱلْقِصَاصِ حَيَوٰةٌۭ",26],["2:184:29",28,"لَّكُمْ ۖ","for you","وَأَن تَصُومُوا۟ خَيْرٌۭ","إِن كُنتُمْ تَعْلَمُونَ",26],["2:185:30",28,"بِكُمُ","for you","أُخَرَ ۗ يُرِيدُ ٱللَّهُ","ٱلْيُسْرَ وَلَا يُرِيدُ",26],["2:185:34",28,"بِكُمُ","for you","ٱلْيُسْرَ وَلَا يُرِيدُ","ٱلْعُسْرَ وَلِتُكْمِلُوا۟ ٱلْعِدَّةَ",26],["2:187:2",29,"لَكُمْ","for you","أُحِلَّ","لَيْلَةَ ٱلصِّيَامِ ٱلرَّفَثُ",26],["2:187:10",29,"لَّكُمْ","for you","نِسَآئِكُمْ ۚ هُنَّ لِبَاسٌۭ","وَأَنتُمْ لِبَاسٌۭ لَّهُنَّ ۗ",26],["2:187:30",29,"لَكُمْ ۚ","for you","مَا كَتَبَ ٱللَّهُ","وَكُلُوا۟ وَٱشْرَبُوا۟ حَتَّىٰ",26],["2:187:35",29,"لَكُمُ","to you","وَٱشْرَبُوا۟ حَتَّىٰ يَتَبَيَّنَ","ٱلْخَيْطُ ٱلْأَبْيَضُ مِنَ",26],["2:208:13",32,"لَكُمْ","(is) for you","خُطُوَٰتِ ٱلشَّيْطَـٰنِ ۚ إِنَّهُۥ","عَدُوٌّۭ مُّبِينٌۭ",26],["2:216:6",34,"لَّكُمْ ۖ","to you","ٱلْقِتَالُ وَهُوَ كُرْهٌۭ","وَعَسَىٰٓ أَن تَكْرَهُوا۟",26],["2:216:13",34,"لَّكُمْ ۖ","for you","شَيْـًۭٔا وَهُوَ خَيْرٌۭ","وَعَسَىٰٓ أَن تُحِبُّوا۟",26],["2:216:20",34,"لَّكُمْ ۗ","for you","شَيْـًۭٔا وَهُوَ شَرٌّۭ","وَٱللَّهُ يَعْلَمُ وَأَنتُمْ",26],["2:219:23",34,"لَكُمُ","to you","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ","ٱلْـَٔايَـٰتِ لَعَلَّكُمْ تَتَفَكَّرُونَ",26],["2:223:3",35,"لَّكُمْ","for you","نِسَآؤُكُمْ حَرْثٌۭ","فَأْتُوا۟ حَرْثَكُمْ أَنَّىٰ",26],["2:229:10",36,"لَكُمْ","for you","بِإِحْسَـٰنٍۢ ۗ وَلَا يَحِلُّ","أَن تَأْخُذُوا۟ مِمَّآ",26],["2:232:27",37,"لَكُمْ","for you","ٱلْـَٔاخِرِ ۗ ذَٰلِكُمْ أَزْكَىٰ","وَأَطْهَرُ ۗ وَٱللَّهُ يَعْلَمُ",26],["2:242:4",39,"لَكُمْ","for you","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ","ءَايَـٰتِهِۦ لَعَلَّكُمْ تَعْقِلُونَ",26],["2:247:8",40,"لَكُمْ","for you","ٱللَّهَ قَدْ بَعَثَ","طَالُوتَ مَلِكًۭا ۚ قَالُوٓا۟",26],["2:248:27",40,"لَّكُمْ","for you","فِى ذَٰلِكَ لَـَٔايَةًۭ","إِن كُنتُم مُّؤْمِنِينَ",26],["2:266:32",45,"لَكُمُ","for you","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ","ٱلْـَٔايَـٰتِ لَعَلَّكُمْ تَتَفَكَّرُونَ",26],["2:267:11",45,"لَكُم","for you","كَسَبْتُمْ وَمِمَّآ أَخْرَجْنَا","مِّنَ ٱلْأَرْضِ ۖ وَلَا",26],["2:271:12",46,"لَّكُمْ ۚ","for you","ٱلْفُقَرَآءَ فَهُوَ خَيْرٌۭ","وَيُكَفِّرُ عَنكُم مِّن",26],["2:279:11",47,"فَلَكُمْ","then for you","وَرَسُولِهِۦ ۖ وَإِن تُبْتُمْ","رُءُوسُ أَمْوَٰلِكُمْ لَا",26],["2:280:11",47,"لَّكُمْ ۖ","for you","وَأَن تَصَدَّقُوا۟ خَيْرٌۭ","إِن كُنتُمْ تَعْلَمُونَ",26],["2:282:120",48,"بِكُمْ ۗ","for you","تَفْعَلُوا۟ فَإِنَّهُۥ فُسُوقٌۢ","وَٱتَّقُوا۟ ٱللَّهَ ۖ وَيُعَلِّمُكُمُ",26],["3:13:3",51,"لَكُمْ","for you","قَدْ كَانَ","ءَايَةٌۭ فِى فِئَتَيْنِ",26],["3:31:10",54,"لَكُمْ","for you","يُحْبِبْكُمُ ٱللَّهُ وَيَغْفِرْ","ذُنُوبَكُمْ ۗ وَٱللَّهُ غَفُورٌۭ",26],["3:49:13",56,"لَكُم","for you","رَّبِّكُمْ ۖ أَنِّىٓ أَخْلُقُ","مِّنَ ٱلطِّينِ كَهَيْـَٔةِ",26],["3:49:42",56,"لَّكُمْ","for you","فِى ذَٰلِكَ لَـَٔايَةًۭ","إِن كُنتُم مُّؤْمِنِينَ",26],["3:50:8",56,"لَكُم","for you","مِنَ ٱلتَّوْرَىٰةِ وَلِأُحِلَّ","بَعْضَ ٱلَّذِى حُرِّمَ",26],["3:66:5",58,"لَكُم","[for] you","هَـٰٓؤُلَآءِ حَـٰجَجْتُمْ فِيمَا","بِهِۦ عِلْمٌۭ فَلِمَ",26],["3:66:12",58,"لَكُم","for you","تُحَآجُّونَ فِيمَا لَيْسَ","بِهِۦ عِلْمٌۭ ۚ وَٱللَّهُ",26],["3:103:31",63,"لَكُمْ","for you","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ","ءَايَـٰتِهِۦ لَعَلَّكُمْ تَهْتَدُونَ",26],["3:118:26",65,"لَكُمُ","for you","أَكْبَرُ ۚ قَدْ بَيَّنَّا","ٱلْـَٔايَـٰتِ ۖ إِن كُنتُمْ",26],["3:126:6",66,"لَكُمْ","for you","ٱللَّهُ إِلَّا بُشْرَىٰ","وَلِتَطْمَئِنَّ قُلُوبُكُم بِهِۦ ۗ",26],["3:160:6",71,"لَكُمْ ۖ","[for] you","ٱللَّهُ فَلَا غَالِبَ","وَإِن يَخْذُلْكُمْ فَمَن",26],["3:173:9",72,"لَكُمْ","against you","ٱلنَّاسَ قَدْ جَمَعُوا۟","فَٱخْشَوْهُمْ فَزَادَهُمْ إِيمَـٰنًۭا",26],["3:179:34",73,"فَلَكُمْ","then for you","وَإِن تُؤْمِنُوا۟ وَتَتَّقُوا۟","أَجْرٌ عَظِيمٌۭ",26],["4:3:10",77,"لَكُم","to you","فَٱنكِحُوا۟ مَا طَابَ","مِّنَ ٱلنِّسَآءِ مَثْنَىٰ",26],["4:4:7",77,"لَكُمْ","to you","نِحْلَةًۭ ۚ فَإِن طِبْنَ","عَن شَىْءٍۢ مِّنْهُ",26],["4:5:8",77,"لَكُمْ","for you","ٱلَّتِى جَعَلَ ٱللَّهُ","قِيَـٰمًۭا وَٱرْزُقُوهُمْ فِيهَا",26],["4:11:62",78,"لَكُمْ","to you","تَدْرُونَ أَيُّهُمْ أَقْرَبُ","نَفْعًۭا ۚ فَرِيضَةًۭ مِّنَ",26],["4:12:1",79,"۞ وَلَكُمْ","And for you","","نِصْفُ مَا تَرَكَ",26],["4:12:15",79,"فَلَكُمُ","then for you","كَانَ لَهُنَّ وَلَدٌۭ","ٱلرُّبُعُ مِمَّا تَرَكْنَ ۚ",26],["4:12:33",79,"لَّكُمْ","for you","إِن لَّمْ يَكُن","وَلَدٌۭ ۚ فَإِن كَانَ",26],["4:12:37",79,"لَكُمْ","for you","وَلَدٌۭ ۚ فَإِن كَانَ","وَلَدٌۭ فَلَهُنَّ ٱلثُّمُنُ",26],["4:19:6",80,"لَكُمْ","for you","ءَامَنُوا۟ لَا يَحِلُّ","أَن تَرِثُوا۟ ٱلنِّسَآءَ",26],["4:24:12",82,"لَكُم","to you","ٱللَّهِ عَلَيْكُمْ ۚ وَأُحِلَّ","مَّا وَرَآءَ ذَٰلِكُمْ",26],["4:25:55",82,"لَّكُمْ ۗ","for you","وَأَن تَصْبِرُوا۟ خَيْرٌۭ","وَٱللَّهُ غَفُورٌۭ رَّحِيمٌۭ",26],["4:26:4",82,"لَكُمْ","to you","يُرِيدُ ٱللَّهُ لِيُبَيِّنَ","وَيَهْدِيَكُمْ سُنَنَ ٱلَّذِينَ",26],["4:29:22",83,"بِكُمْ","to you","إِنَّ ٱللَّهَ كَانَ","رَحِيمًۭا",26],["4:75:2",90,"لَكُمْ","for you","وَمَا","لَا تُقَـٰتِلُونَ فِى",26],["4:88:2",92,"لَكُمْ","(is the matter) with you","۞ فَمَا","فِى ٱلْمُنَـٰفِقِينَ فِئَتَيْنِ",26],["4:90:34",92,"لَكُمْ","for you","فَمَا جَعَلَ ٱللَّهُ","عَلَيْهِمْ سَبِيلًۭا",26],["4:91:29",92,"لَكُمْ","for you","ثَقِفْتُمُوهُمْ ۚ وَأُو۟لَـٰٓئِكُمْ جَعَلْنَا","عَلَيْهِمْ سُلْطَـٰنًۭا مُّبِينًۭا",26],["4:92:28",93,"لَّكُمْ","to you","مِن قَوْمٍ عَدُوٍّۢ","وَهُوَ مُؤْمِنٌۭ فَتَحْرِيرُ",26],["4:101:21",94,"لَكُمْ","for you","إِنَّ ٱلْكَـٰفِرِينَ كَانُوا۟","عَدُوًّۭا مُّبِينًۭا",26],["4:102:45",95,"بِكُمْ","with you","عَلَيْكُمْ إِن كَانَ","أَذًۭى مِّن مَّطَرٍ",26],["4:141:3",101,"بِكُمْ","for you","ٱلَّذِينَ يَتَرَبَّصُونَ","فَإِن كَانَ لَكُمْ",26],["4:141:6",101,"لَكُمْ","for you","بِكُمْ فَإِن كَانَ","فَتْحٌۭ مِّنَ ٱللَّهِ",26],["4:170:11",104,"لَّكُمْ ۚ","for you","رَّبِّكُمْ فَـَٔامِنُوا۟ خَيْرًۭا","وَإِن تَكْفُرُوا۟ فَإِنَّ",26],["4:171:34",105,"لَّكُمْ ۚ","for you","ثَلَـٰثَةٌ ۚ ٱنتَهُوا۟ خَيْرًۭا","إِنَّمَا ٱللَّهُ إِلَـٰهٌۭ",26],["4:176:44",106,"لَكُمْ","to you","ٱلْأُنثَيَيْنِ ۗ يُبَيِّنُ ٱللَّهُ","أَن تَضِلُّوا۟ ۗ وَٱللَّهُ",26],["5:1:7",106,"لَكُم","for you","أَوْفُوا۟ بِٱلْعُقُودِ ۚ أُحِلَّتْ","بَهِيمَةُ ٱلْأَنْعَـٰمِ إِلَّا",26],["5:3:42",107,"لَكُمْ","for you","وَٱخْشَوْنِ ۚ ٱلْيَوْمَ أَكْمَلْتُ","دِينَكُمْ وَأَتْمَمْتُ عَلَيْكُمْ",26],["5:3:48",107,"لَكُمُ","for you","عَلَيْكُمْ نِعْمَتِى وَرَضِيتُ","ٱلْإِسْلَـٰمَ دِينًۭا ۚ فَمَنِ",26],["5:4:7",107,"لَكُمُ","for you","لَهُمْ ۖ قُلْ أُحِلَّ","ٱلطَّيِّبَـٰتُ ۙ وَمَا عَلَّمْتُم",26],["5:5:3",107,"لَكُمُ","for you","ٱلْيَوْمَ أُحِلَّ","ٱلطَّيِّبَـٰتُ ۖ وَطَعَامُ ٱلَّذِينَ",26],["5:5:10",107,"لَّكُمْ","for you","أُوتُوا۟ ٱلْكِتَـٰبَ حِلٌّۭ","وَطَعَامُكُمْ حِلٌّۭ لَّهُمْ ۖ",26],["5:15:7",110,"لَكُمْ","to you","جَآءَكُمْ رَسُولُنَا يُبَيِّنُ","كَثِيرًۭا مِّمَّا كُنتُمْ",26],["5:19:7",111,"لَكُمْ","to you","جَآءَكُمْ رَسُولُنَا يُبَيِّنُ","عَلَىٰ فَتْرَةٍۢ مِّنَ",26],["5:21:8",111,"لَكُمْ","for you","ٱلَّتِى كَتَبَ ٱللَّهُ","وَلَا تَرْتَدُّوا۟ عَلَىٰٓ",26],["5:76:9",120,"لَكُمْ","to (cause) you","مَا لَا يَمْلِكُ","ضَرًّۭا وَلَا نَفْعًۭا ۚ",26],["5:87:10",122,"لَكُمْ","for you","مَآ أَحَلَّ ٱللَّهُ","وَلَا تَعْتَدُوٓا۟ ۚ إِنَّ",26],["5:89:42",122,"لَكُمْ","to you","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ","ءَايَـٰتِهِۦ لَعَلَّكُمْ تَشْكُرُونَ",26],["5:96:2",124,"لَكُمْ","for you","أُحِلَّ","صَيْدُ ٱلْبَحْرِ وَطَعَامُهُۥ",26],["5:96:7",124,"لَّكُمْ","for you","ٱلْبَحْرِ وَطَعَامُهُۥ مَتَـٰعًۭا","وَلِلسَّيَّارَةِ ۖ وَحُرِّمَ عَلَيْكُمْ",26],["5:101:10",124,"لَكُمْ","to you","أَشْيَآءَ إِن تُبْدَ","تَسُؤْكُمْ وَإِن تَسْـَٔلُوا۟",26],["5:101:19",124,"لَكُمْ","to you","يُنَزَّلُ ٱلْقُرْءَانُ تُبْدَ","عَفَا ٱللَّهُ عَنْهَا ۗ",26],["6:6:15",128,"لَّكُمْ","for you","مَا لَمْ نُمَكِّن","وَأَرْسَلْنَا ٱلسَّمَآءَ عَلَيْهِم",26],["6:50:4",133,"لَكُمْ","to you","قُل لَّآ أَقُولُ","عِندِى خَزَآئِنُ ٱللَّهِ",26],["6:50:13",133,"لَكُمْ","to you","ٱلْغَيْبَ وَلَآ أَقُولُ","إِنِّى مَلَكٌ ۖ إِنْ",26],["6:97:4",140,"لَكُمُ","for you","وَهُوَ ٱلَّذِى جَعَلَ","ٱلنُّجُومَ لِتَهْتَدُوا۟ بِهَا",26],["6:119:2",143,"لَكُمْ","for you","وَمَا","أَلَّا تَأْكُلُوا۟ مِمَّا",26],["6:119:12",143,"لَكُم","to you","عَلَيْهِ وَقَدْ فَصَّلَ","مَّا حَرَّمَ عَلَيْكُمْ",26],["6:142:14",146,"لَكُمْ","(is) to you","خُطُوَٰتِ ٱلشَّيْطَـٰنِ ۚ إِنَّهُۥ","عَدُوٌّۭ مُّبِينٌۭ",26],["6:153:10",149,"بِكُمْ","you","تَتَّبِعُوا۟ ٱلسُّبُلَ فَتَفَرَّقَ","عَن سَبِيلِهِۦ ۚ ذَٰلِكُمْ",26],["7:10:6",151,"لَكُمْ","for you","فِى ٱلْأَرْضِ وَجَعَلْنَا","فِيهَا مَعَـٰيِشَ ۗ قَلِيلًۭا",26],["7:24:6",153,"وَلَكُمْ","And for you","بَعْضُكُمْ لِبَعْضٍ عَدُوٌّۭ ۖ","فِى ٱلْأَرْضِ مُسْتَقَرٌّۭ",26],["7:39:6",155,"لَكُمْ","for you","لِأُخْرَىٰهُمْ فَمَا كَانَ","عَلَيْنَا مِن فَضْلٍۢ",26],["7:59:11",158,"لَكُم","for you","ٱعْبُدُوا۟ ٱللَّهَ مَا","مِّنْ إِلَـٰهٍ غَيْرُهُۥٓ",26],["7:62:5",158,"لَكُمْ","[to] you","رِسَـٰلَـٰتِ رَبِّى وَأَنصَحُ","وَأَعْلَمُ مِنَ ٱللَّهِ",26],["7:65:10",158,"لَكُم","for you","ٱعْبُدُوا۟ ٱللَّهَ مَا","مِّنْ إِلَـٰهٍ غَيْرُهُۥٓ ۚ",26],["7:68:5",159,"لَكُمْ","to you","رِسَـٰلَـٰتِ رَبِّى وَأَنَا۠","نَاصِحٌ أَمِينٌ",26],["7:73:10",159,"لَكُم","for you","ٱعْبُدُوا۟ ٱللَّهَ مَا","مِّنْ إِلَـٰهٍ غَيْرُهُۥ ۖ",26],["7:73:22",159,"لَكُمْ","(it is) for you","هَـٰذِهِۦ نَاقَةُ ٱللَّهِ","ءَايَةًۭ ۖ فَذَرُوهَا تَأْكُلْ",26],["7:79:10",160,"لَكُمْ","[to] you","رِسَالَةَ رَبِّى وَنَصَحْتُ","وَلَـٰكِن لَّا تُحِبُّونَ",26],["7:85:10",161,"لَكُم","for you","ٱعْبُدُوا۟ ٱللَّهَ مَا","مِّنْ إِلَـٰهٍ غَيْرُهُۥ ۖ",26],["7:85:34",161,"لَّكُمْ","for you","إِصْلَـٰحِهَا ۚ ذَٰلِكُمْ خَيْرٌۭ","إِن كُنتُم مُّؤْمِنِينَ",26],["7:93:10",162,"لَكُمْ ۖ","[to] you","رِسَـٰلَـٰتِ رَبِّى وَنَصَحْتُ","فَكَيْفَ ءَاسَىٰ عَلَىٰ",26],["7:123:8",165,"لَكُمْ ۖ","to you","قَبْلَ أَنْ ءَاذَنَ","إِنَّ هَـٰذَا لَمَكْرٌۭ",26],["7:161:17",171,"لَكُمْ","for you","ٱلْبَابَ سُجَّدًۭا نَّغْفِرْ","خَطِيٓـَٔـٰتِكُمْ ۚ سَنَزِيدُ ٱلْمُحْسِنِينَ",26],["7:194:11",175,"لَكُمْ","to you","أَمْثَالُكُمْ ۖ فَٱدْعُوهُمْ فَلْيَسْتَجِيبُوا۟","إِن كُنتُمْ صَـٰدِقِينَ",26],["8:7:7",177,"لَكُمْ","for you","إِحْدَى ٱلطَّآئِفَتَيْنِ أَنَّهَا","وَتَوَدُّونَ أَنَّ غَيْرَ",26],["8:7:14",177,"لَكُمْ","for you","ذَاتِ ٱلشَّوْكَةِ تَكُونُ","وَيُرِيدُ ٱللَّهُ أَن",26],["8:9:5",178,"لَكُمْ","[to] you","تَسْتَغِيثُونَ رَبَّكُمْ فَٱسْتَجَابَ","أَنِّى مُمِدُّكُم بِأَلْفٍۢ",26],["8:19:10",179,"لَّكُمْ ۖ","for you","تَنتَهُوا۟ فَهُوَ خَيْرٌۭ","وَإِن تَعُودُوا۟ نَعُدْ",26],["8:29:8",180,"لَّكُمْ","you","تَتَّقُوا۟ ٱللَّهَ يَجْعَل","فُرْقَانًۭا وَيُكَفِّرْ عَنكُمْ",26],["8:29:14",180,"لَكُمْ ۗ","you","عَنكُمْ سَيِّـَٔاتِكُمْ وَيَغْفِرْ","وَٱللَّهُ ذُو ٱلْفَضْلِ",26],["8:48:9",183,"لَكُمُ","[to] you","وَقَالَ لَا غَالِبَ","ٱلْيَوْمَ مِنَ ٱلنَّاسِ",26],["8:48:15",183,"لَّكُمْ ۖ","for you","ٱلنَّاسِ وَإِنِّى جَارٌۭ","فَلَمَّا تَرَآءَتِ ٱلْفِئَتَانِ",26],["8:70:21",186,"لَكُمْ ۗ","you","أُخِذَ مِنكُمْ وَيَغْفِرْ","وَٱللَّهُ غَفُورٌۭ رَّحِيمٌۭ",26],["8:72:23",186,"لَكُم","for you","وَلَمْ يُهَاجِرُوا۟ مَا","مِّن وَلَـٰيَتِهِم مِّن",26],["9:3:20",187,"لَّكُمْ ۖ","for you","تُبْتُمْ فَهُوَ خَيْرٌۭ","وَإِن تَوَلَّيْتُمْ فَٱعْلَمُوٓا۟",26],["9:7:17",188,"لَكُمْ","to you","ٱلْحَرَامِ ۖ فَمَا ٱسْتَقَـٰمُوا۟","فَٱسْتَقِيمُوا۟ لَهُمْ ۚ إِنَّ",26],["9:38:5",193,"لَكُمْ","(is the matter) with you","ٱلَّذِينَ ءَامَنُوا۟ مَا","إِذَا قِيلَ لَكُمُ",26],["9:38:8",193,"لَكُمُ","to you","لَكُمْ إِذَا قِيلَ","ٱنفِرُوا۟ فِى سَبِيلِ",26],["9:41:12",194,"لَّكُمْ","for you","ٱللَّهِ ۚ ذَٰلِكُمْ خَيْرٌۭ","إِن كُنتُمْ تَعْلَمُونَ",26],["9:52:10",195,"بِكُمْ","for you","ٱلْحُسْنَيَيْنِ ۖ وَنَحْنُ نَتَرَبَّصُ","أَن يُصِيبَكُمُ ٱللَّهُ",26],["9:61:11",196,"لَّكُمْ","for you","قُلْ أُذُنُ خَيْرٍۢ","يُؤْمِنُ بِٱللَّهِ وَيُؤْمِنُ",26],["9:62:3",197,"لَكُمْ","to you","يَحْلِفُونَ بِٱللَّهِ","لِيُرْضُوكُمْ وَٱللَّهُ وَرَسُولُهُۥٓ",26],["9:94:11",202,"لَكُمْ","you","تَعْتَذِرُوا۟ لَن نُّؤْمِنَ","قَدْ نَبَّأَنَا ٱللَّهُ",26],["9:95:3",202,"لَكُمْ","to you","سَيَحْلِفُونَ بِٱللَّهِ","إِذَا ٱنقَلَبْتُمْ إِلَيْهِمْ",26],["9:96:2",202,"لَكُمْ","to you","يَحْلِفُونَ","لِتَرْضَوْا۟ عَنْهُمْ ۖ فَإِن",26],["9:98:9",202,"بِكُمُ","for you","يُنفِقُ مَغْرَمًۭا وَيَتَرَبَّصُ","ٱلدَّوَآئِرَ ۚ عَلَيْهِمْ دَآئِرَةُ",26],["9:116:10",205,"لَكُم","for you","يُحْىِۦ وَيُمِيتُ ۚ وَمَا","مِّن دُونِ ٱللَّهِ",26],["10:35:27",213,"لَكُمْ","(is) for you","أَن يُهْدَىٰ ۖ فَمَا","كَيْفَ تَحْكُمُونَ",26],["10:41:6",213,"وَلَكُمْ","and for you","فَقُل لِّى عَمَلِى","عَمَلُكُمْ ۖ أَنتُم بَرِيٓـُٔونَ",26],["10:59:6",215,"لَكُم","for you","مَّآ أَنزَلَ ٱللَّهُ","مِّن رِّزْقٍۢ فَجَعَلْتُم",26],["10:59:16",215,"لَكُمْ ۖ","[to] you","قُلْ ءَآللَّهُ أَذِنَ","أَمْ عَلَى ٱللَّهِ",26],["10:67:4",216,"لَكُمُ","for you","هُوَ ٱلَّذِى جَعَلَ","ٱلَّيْلَ لِتَسْكُنُوا۟ فِيهِ",26],["11:2:6",221,"لَكُم","to you","إِلَّا ٱللَّهَ ۚ إِنَّنِى","مِّنْهُ نَذِيرٌۭ وَبَشِيرٌۭ",26],["11:14:3",223,"لَكُمْ","to you","فَإِلَّمْ يَسْتَجِيبُوا۟","فَٱعْلَمُوٓا۟ أَنَّمَآ أُنزِلَ",26],["11:25:7",224,"لَكُمْ","to you","إِلَىٰ قَوْمِهِۦٓ إِنِّى","نَذِيرٌۭ مُّبِينٌ",26],["11:27:23",224,"لَكُمْ","in you","ٱلرَّأْىِ وَمَا نَرَىٰ","عَلَيْنَا مِن فَضْلٍۭ",26],["11:31:3",225,"لَكُمْ","to you","وَلَآ أَقُولُ","عِندِى خَزَآئِنُ ٱللَّهِ",26],["11:34:8",225,"لَكُمْ","[to] you","أَرَدتُّ أَنْ أَنصَحَ","إِن كَانَ ٱللَّهُ",26],["11:50:10",227,"لَكُم","(is) for you","ٱعْبُدُوا۟ ٱللَّهَ مَا","مِّنْ إِلَـٰهٍ غَيْرُهُۥٓ ۖ",26],["11:61:10",228,"لَكُم","you have","ٱعْبُدُوا۟ ٱللَّهَ مَا","مِّنْ إِلَـٰهٍ غَيْرُهُۥ ۖ",26],["11:64:5",229,"لَكُمْ","(is) for you","هَـٰذِهِۦ نَاقَةُ ٱللَّهِ","ءَايَةًۭ فَذَرُوهَا تَأْكُلْ",26],["11:78:16",230,"لَكُمْ ۖ","for you","بَنَاتِى هُنَّ أَطْهَرُ","فَٱتَّقُوا۟ ٱللَّهَ وَلَا",26],["11:80:5",230,"بِكُمْ","over you","لَوْ أَنَّ لِى","قُوَّةً أَوْ ءَاوِىٓ",26],["11:84:10",231,"لَكُم","(is) for you","ٱعْبُدُوا۟ ٱللَّهَ مَا","مِّنْ إِلَـٰهٍ غَيْرُهُۥ ۖ",26],["11:86:4",231,"لَّكُمْ","for you","بَقِيَّتُ ٱللَّهِ خَيْرٌۭ","إِن كُنتُم مُّؤْمِنِينَ ۚ",26],["11:113:9",234,"لَكُم","(is) for you","فَتَمَسَّكُمُ ٱلنَّارُ وَمَا","مِّن دُونِ ٱللَّهِ",26],["12:9:7",236,"لَكُمْ","for you","ٱطْرَحُوهُ أَرْضًۭا يَخْلُ","وَجْهُ أَبِيكُمْ وَتَكُونُوا۟",26],["12:18:9",237,"لَكُمْ","has enticed you","قَالَ بَلْ سَوَّلَتْ","أَنفُسُكُمْ أَمْرًۭا ۖ فَصَبْرٌۭ",26],["12:59:7",242,"لَّكُم","of yours","قَالَ ٱئْتُونِى بِأَخٍۢ","مِّنْ أَبِيكُمْ ۚ أَلَا",26],["12:60:7",242,"لَكُمْ","for you","بِهِۦ فَلَا كَيْلَ","عِندِى وَلَا تَقْرَبُونِ",26],["12:66:15",243,"بِكُمْ ۖ","you are surrounded","إِلَّآ أَن يُحَاطَ","فَلَمَّآ ءَاتَوْهُ مَوْثِقَهُمْ",26],["12:83:4",245,"لَكُمْ","you","قَالَ بَلْ سَوَّلَتْ","أَنفُسُكُمْ أَمْرًۭا ۖ فَصَبْرٌۭ",26],["12:92:8",246,"لَكُمْ ۖ","you","ٱلْيَوْمَ ۖ يَغْفِرُ ٱللَّهُ","وَهُوَ أَرْحَمُ ٱلرَّٰحِمِينَ",26],["12:96:13",247,"لَّكُمْ","to you","قَالَ أَلَمْ أَقُل","إِنِّىٓ أَعْلَمُ مِنَ",26],["12:98:4",247,"لَكُمْ","for you","قَالَ سَوْفَ أَسْتَغْفِرُ","رَبِّىٓ ۖ إِنَّهُۥ هُوَ",26],["12:100:27",247,"بِكُم","you","مِنَ ٱلسِّجْنِ وَجَآءَ","مِّنَ ٱلْبَدْوِ مِنۢ",26],["14:10:11",256,"لَكُم","for you","وَٱلْأَرْضِ ۖ يَدْعُوكُمْ لِيَغْفِرَ","مِّن ذُنُوبِكُمْ وَيُؤَخِّرَكُمْ",26],["14:21:10",258,"لَكُمْ","your","ٱسْتَكْبَرُوٓا۟ إِنَّا كُنَّا","تَبَعًۭا فَهَلْ أَنتُم",26],["14:32:15",259,"لَّكُمْ ۖ","for you","مِنَ ٱلثَّمَرَٰتِ رِزْقًۭا","وَسَخَّرَ لَكُمُ ٱلْفُلْكَ",26],["14:32:17",259,"لَكُمُ","for you","رِزْقًۭا لَّكُمْ ۖ وَسَخَّرَ","ٱلْفُلْكَ لِتَجْرِىَ فِى",26],["14:32:24",259,"لَكُمُ","for you","ٱلْبَحْرِ بِأَمْرِهِۦ ۖ وَسَخَّرَ","ٱلْأَنْهَـٰرَ",26],["14:33:2",259,"لَكُمُ","for you","وَسَخَّرَ","ٱلشَّمْسَ وَٱلْقَمَرَ دَآئِبَيْنِ ۖ",26],["14:33:7",259,"لَكُمُ","for you","وَٱلْقَمَرَ دَآئِبَيْنِ ۖ وَسَخَّرَ","ٱلَّيْلَ وَٱلنَّهَارَ",26],["14:44:24",261,"لَكُم","for you","مِّن قَبْلُ مَا","مِّن زَوَالٍۢ",26],["14:45:8",261,"لَكُمْ","to you","ظَلَمُوٓا۟ أَنفُسَهُمْ وَتَبَيَّنَ","كَيْفَ فَعَلْنَا بِهِمْ",26],["14:45:13",261,"لَكُمُ","for you","فَعَلْنَا بِهِمْ وَضَرَبْنَا","ٱلْأَمْثَالَ",26],["15:20:2",263,"لَكُمْ","for you","وَجَعَلْنَا","فِيهَا مَعَـٰيِشَ وَمَن",26],["16:5:3",267,"لَكُمْ","for you","وَٱلْأَنْعَـٰمَ خَلَقَهَا ۗ","فِيهَا دِفْءٌۭ وَمَنَـٰفِعُ",26],["16:6:1",267,"وَلَكُمْ","And for you","","فِيهَا جَمَالٌ حِينَ",26],["16:10:7",268,"لَّكُم","for you","مِنَ ٱلسَّمَآءِ مَآءًۭ ۖ","مِّنْهُ شَرَابٌۭ وَمِنْهُ",26],["16:11:2",268,"لَكُم","for you","يُنۢبِتُ","بِهِ ٱلزَّرْعَ وَٱلزَّيْتُونَ",26],["16:12:2",268,"لَكُمُ","for you","وَسَخَّرَ","ٱلَّيْلَ وَٱلنَّهَارَ وَٱلشَّمْسَ",26],["16:13:3",268,"لَكُمْ","for you","وَمَا ذَرَأَ","فِى ٱلْأَرْضِ مُخْتَلِفًا",26],["16:15:7",269,"بِكُمْ","with you","رَوَٰسِىَ أَن تَمِيدَ","وَأَنْهَـٰرًۭا وَسُبُلًۭا لَّعَلَّكُمْ",26],["16:53:2",272,"بِكُم","you have","وَمَا","مِّن نِّعْمَةٍۢ فَمِنَ",26],["16:66:2",274,"لَكُمْ","for you","وَإِنَّ","فِى ٱلْأَنْعَـٰمِ لَعِبْرَةًۭ ۖ",26],["16:72:3",274,"لَكُم","for you","وَٱللَّهُ جَعَلَ","مِّنْ أَنفُسِكُمْ أَزْوَٰجًۭا",26],["16:72:8",274,"لَكُم","for you","أَنفُسِكُمْ أَزْوَٰجًۭا وَجَعَلَ","مِّنْ أَزْوَٰجِكُم بَنِينَ",26],["16:78:10",275,"لَكُمُ","for you","تَعْلَمُونَ شَيْـًۭٔا وَجَعَلَ","ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ وَٱلْأَفْـِٔدَةَ ۙ",26],["16:80:3",276,"لَكُم","for you","وَٱللَّهُ جَعَلَ","مِّنۢ بُيُوتِكُمْ سَكَنًۭا",26],["16:80:8",276,"لَكُم","for you","بُيُوتِكُمْ سَكَنًۭا وَجَعَلَ","مِّن جُلُودِ ٱلْأَنْعَـٰمِ",26],["16:81:3",276,"لَكُم","for you","وَٱللَّهُ جَعَلَ","مِّمَّا خَلَقَ ظِلَـٰلًۭا",26],["16:81:8",276,"لَكُم","for you","خَلَقَ ظِلَـٰلًۭا وَجَعَلَ","مِّنَ ٱلْجِبَالِ أَكْنَـٰنًۭا",26],["16:81:13",276,"لَكُمْ","for you","ٱلْجِبَالِ أَكْنَـٰنًۭا وَجَعَلَ","سَرَٰبِيلَ تَقِيكُمُ ٱلْحَرَّ",26],["16:92:26",277,"لَكُمْ","to you","ٱللَّهُ بِهِۦ ۚ وَلَيُبَيِّنَنَّ","يَوْمَ ٱلْقِيَـٰمَةِ مَا",26],["16:94:17",278,"وَلَكُمْ","and for you","عَن سَبِيلِ ٱللَّهِ ۖ","عَذَابٌ عَظِيمٌۭ",26],["16:95:12",278,"لَّكُمْ","for you","ٱللَّهِ هُوَ خَيْرٌۭ","إِن كُنتُمْ تَعْلَمُونَ",26],["17:6:3",282,"لَكُمُ","to you","ثُمَّ رَدَدْنَا","ٱلْكَرَّةَ عَلَيْهِمْ وَأَمْدَدْنَـٰكُم",26],["17:54:3",287,"بِكُمْ ۖ","of you","رَّبُّكُمْ أَعْلَمُ","إِن يَشَأْ يَرْحَمْكُمْ",26],["17:66:4",288,"لَكُمُ","for you","رَّبُّكُمُ ٱلَّذِى يُزْجِى","ٱلْفُلْكَ فِى ٱلْبَحْرِ",26],["17:66:13",288,"بِكُمْ","to you","فَضْلِهِۦٓ ۚ إِنَّهُۥ كَانَ","رَحِيمًۭا",26],["17:68:4",289,"بِكُمْ","you","أَفَأَمِنتُمْ أَن يَخْسِفَ","جَانِبَ ٱلْبَرِّ أَوْ",26],["17:68:14",289,"لَكُمْ","for you","ثُمَّ لَا تَجِدُوا۟","وَكِيلًا",26],["17:69:19",289,"لَكُمْ","for you","ثُمَّ لَا تَجِدُوا۟","عَلَيْنَا بِهِۦ تَبِيعًۭا",26],["17:104:13",292,"بِكُمْ","you","وَعْدُ ٱلْـَٔاخِرَةِ جِئْنَا","لَفِيفًۭا",26],["18:16:11",295,"لَكُمْ","for you","إِلَى ٱلْكَهْفِ يَنشُرْ","رَبُّكُم مِّن رَّحْمَتِهِۦ",26],["18:16:16",295,"لَكُم","for you","مِّن رَّحْمَتِهِۦ وَيُهَيِّئْ","مِّنْ أَمْرِكُم مِّرْفَقًۭا",26],["18:19:37",295,"بِكُمْ","about you","وَلْيَتَلَطَّفْ وَلَا يُشْعِرَنَّ","أَحَدًا",26],["18:48:15",299,"لَكُم","for you","زَعَمْتُمْ أَلَّن نَّجْعَلَ","مَّوْعِدًۭا",26],["18:50:22",299,"لَكُمْ","(are) to you","مِن دُونِى وَهُمْ","عَدُوٌّۢ ۚ بِئْسَ لِلظَّـٰلِمِينَ",26],["20:53:3",315,"لَكُمُ","for you","ٱلَّذِى جَعَلَ","ٱلْأَرْضَ مَهْدًۭا وَسَلَكَ",26],["20:53:7",315,"لَكُمْ","for you","ٱلْأَرْضَ مَهْدًۭا وَسَلَكَ","فِيهَا سُبُلًۭا وَأَنزَلَ",26],["20:71:7",316,"لَكُمْ ۖ","to you","قَبْلَ أَنْ ءَاذَنَ","إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِى",26],["21:18:10",323,"وَلَكُمُ","And for you","فَإِذَا هُوَ زَاهِقٌۭ ۚ","ٱلْوَيْلُ مِمَّا تَصِفُونَ",26],["21:67:2",327,"لَّكُمْ","to you","أُفٍّۢ","وَلِمَا تَعْبُدُونَ مِن",26],["21:80:4",328,"لَّكُمْ","for you","وَعَلَّمْنَـٰهُ صَنْعَةَ لَبُوسٍۢ","لِتُحْصِنَكُم مِّنۢ بَأْسِكُمْ ۖ",26],["21:111:5",331,"لَّكُمْ","for you","أَدْرِى لَعَلَّهُۥ فِتْنَةٌۭ","وَمَتَـٰعٌ إِلَىٰ حِينٍۢ",26],["22:5:26",332,"لَكُمْ ۚ","to you","وَغَيْرِ مُخَلَّقَةٍۢ لِّنُبَيِّنَ","وَنُقِرُّ فِى ٱلْأَرْحَامِ",26],["22:30:12",335,"لَكُمُ","to you","عِندَ رَبِّهِۦ ۗ وَأُحِلَّتْ","ٱلْأَنْعَـٰمُ إِلَّا مَا",26],["22:33:1",336,"لَكُمْ","For you","","فِيهَا مَنَـٰفِعُ إِلَىٰٓ",26],["22:36:3",336,"لَكُم","for you","وَٱلْبُدْنَ جَعَلْنَـٰهَا","مِّن شَعَـٰٓئِرِ ٱللَّهِ",26],["22:36:7",336,"لَكُمْ","for you","مِّن شَعَـٰٓئِرِ ٱللَّهِ","فِيهَا خَيْرٌۭ ۖ فَٱذْكُرُوا۟",26],["22:36:25",336,"لَكُمْ","to you","وَٱلْمُعْتَرَّ ۚ كَذَٰلِكَ سَخَّرْنَـٰهَا","لَعَلَّكُمْ تَشْكُرُونَ",26],["22:37:13",336,"لَكُمْ","to you","مِنكُمْ ۚ كَذَٰلِكَ سَخَّرَهَا","لِتُكَبِّرُوا۟ ٱللَّهَ عَلَىٰ",26],["22:49:6",338,"لَكُمْ","to you","ٱلنَّاسُ إِنَّمَآ أَنَا۠","نَذِيرٌۭ مُّبِينٌۭ",26],["22:65:6",340,"لَكُم","to you","أَنَّ ٱللَّهَ سَخَّرَ","مَّا فِى ٱلْأَرْضِ",26],["23:19:2",343,"لَكُم","for you","فَأَنشَأْنَا","بِهِۦ جَنَّـٰتٍۢ مِّن",26],["23:19:8",343,"لَّكُمْ","for you","مِّن نَّخِيلٍۢ وَأَعْنَـٰبٍۢ","فِيهَا فَوَٰكِهُ كَثِيرَةٌۭ",26],["23:21:2",343,"لَكُمْ","for you","وَإِنَّ","فِى ٱلْأَنْعَـٰمِ لَعِبْرَةًۭ ۖ",26],["23:21:10",343,"وَلَكُمْ","and for you","مِّمَّا فِى بُطُونِهَا","فِيهَا مَنَـٰفِعُ كَثِيرَةٌۭ",26],["23:23:11",343,"لَكُم","for you","ٱعْبُدُوا۟ ٱللَّهَ مَا","مِّنْ إِلَـٰهٍ غَيْرُهُۥٓ ۖ",26],["23:32:9",344,"لَكُم","for you","ٱعْبُدُوا۟ ٱللَّهَ مَا","مِّنْ إِلَـٰهٍ غَيْرُهُۥٓ ۖ",26],["23:78:4",347,"لَكُمُ","for you","وَهُوَ ٱلَّذِىٓ أَنشَأَ","ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ وَٱلْأَفْـِٔدَةَ ۚ",26],["24:11:10",351,"لَّكُم ۖ","for you","لَا تَحْسَبُوهُ شَرًّۭا","بَلْ هُوَ خَيْرٌۭ",26],["24:11:14",351,"لَّكُمْ ۚ","for you","بَلْ هُوَ خَيْرٌۭ","لِكُلِّ ٱمْرِئٍۢ مِّنْهُم",26],["24:15:8",351,"لَكُم","for you","بِأَفْوَاهِكُم مَّا لَيْسَ","بِهِۦ عِلْمٌۭ وَتَحْسَبُونَهُۥ",26],["24:18:3",351,"لَكُمُ","to you","وَيُبَيِّنُ ٱللَّهُ","ٱلْـَٔايَـٰتِ ۚ وَٱللَّهُ عَلِيمٌ",26],["24:22:23",352,"لَكُمْ ۗ","you","أَن يَغْفِرَ ٱللَّهُ","وَٱللَّهُ غَفُورٌۭ رَّحِيمٌ",26],["24:27:16",352,"لَّكُمْ","for you","أَهْلِهَا ۚ ذَٰلِكُمْ خَيْرٌۭ","لَعَلَّكُمْ تَذَكَّرُونَ",26],["24:28:10",353,"لَكُمْ ۖ","to you","تَدْخُلُوهَا حَتَّىٰ يُؤْذَنَ","وَإِن قِيلَ لَكُمُ",26],["24:28:13",353,"لَكُمُ","to you","لَكُمْ ۖ وَإِن قِيلَ","ٱرْجِعُوا۟ فَٱرْجِعُوا۟ ۖ هُوَ",26],["24:28:18",353,"لَكُمْ ۚ","for you","فَٱرْجِعُوا۟ ۖ هُوَ أَزْكَىٰ","وَٱللَّهُ بِمَا تَعْمَلُونَ",26],["24:29:11",353,"لَّكُمْ ۚ","for you","مَسْكُونَةٍۢ فِيهَا مَتَـٰعٌۭ","وَٱللَّهُ يَعْلَمُ مَا",26],["24:58:30",357,"لَّكُمْ ۚ","for you","ٱلْعِشَآءِ ۚ ثَلَـٰثُ عَوْرَٰتٍۢ","لَيْسَ عَلَيْكُمْ وَلَا",26],["24:58:45",357,"لَكُمُ","for you","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ","ٱلْـَٔايَـٰتِ ۗ وَٱللَّهُ عَلِيمٌ",26],["24:59:15",358,"لَكُمْ","for you","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ","ءَايَـٰتِهِۦ ۗ وَٱللَّهُ عَلِيمٌ",26],["24:61:73",358,"لَكُمُ","for you","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ","ٱلْـَٔايَـٰتِ لَعَلَّكُمْ تَعْقِلُونَ",26],["25:47:4",364,"لَكُمُ","for you","وَهُوَ ٱلَّذِى جَعَلَ","ٱلَّيْلَ لِبَاسًۭا وَٱلنَّوْمَ",26],["25:77:4",366,"بِكُمْ","for you","قُلْ مَا يَعْبَؤُا۟","رَبِّى لَوْلَا دُعَآؤُكُمْ ۖ",26],["26:49:7",369,"لَكُمْ ۖ","to you","قَبْلَ أَنْ ءَاذَنَ","إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِى",26],["26:107:2",371,"لَكُمْ","to you","إِنِّى","رَسُولٌ أَمِينٌۭ",26],["26:125:2",372,"لَكُمْ","to you","إِنِّى","رَسُولٌ أَمِينٌۭ",26],["26:143:2",373,"لَكُمْ","to you","إِنِّى","رَسُولٌ أَمِينٌۭ",26],["26:155:6",373,"وَلَكُمْ","and for you","نَاقَةٌۭ لَّهَا شِرْبٌۭ","شِرْبُ يَوْمٍۢ مَّعْلُومٍۢ",26],["26:162:2",374,"لَكُمْ","to you","إِنِّى","رَسُولٌ أَمِينٌۭ",26],["26:166:4",374,"لَكُمْ","for you","وَتَذَرُونَ مَا خَلَقَ","رَبُّكُم مِّنْ أَزْوَٰجِكُم ۚ",26],["26:178:2",374,"لَكُمْ","to you","إِنِّى","رَسُولٌ أَمِينٌۭ",26],["27:60:6",382,"لَكُم","for you","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَأَنزَلَ","مِّنَ ٱلسَّمَآءِ مَآءًۭ",26],["27:60:17",382,"لَكُمْ","for you","بَهْجَةٍۢ مَّا كَانَ","أَن تُنۢبِتُوا۟ شَجَرَهَآ ۗ",26],["27:72:6",383,"لَكُم","you","أَن يَكُونَ رَدِفَ","بَعْضُ ٱلَّذِى تَسْتَعْجِلُونَ",26],["28:12:13",386,"لَكُمْ","for you","أَهْلِ بَيْتٍۢ يَكْفُلُونَهُۥ","وَهُمْ لَهُۥ نَـٰصِحُونَ",26],["28:38:7",390,"لَكُم","for you","ٱلْمَلَأُ مَا عَلِمْتُ","مِّنْ إِلَـٰهٍ غَيْرِى",26],["28:55:9",392,"وَلَكُمْ","and for you","وَقَالُوا۟ لَنَآ أَعْمَـٰلُنَا","أَعْمَـٰلُكُمْ سَلَـٰمٌ عَلَيْكُمْ",26],["28:73:4",394,"لَكُمُ","for you","وَمِن رَّحْمَتِهِۦ جَعَلَ","ٱلَّيْلَ وَٱلنَّهَارَ لِتَسْكُنُوا۟",26],["29:16:10",398,"لَّكُمْ","for you","وَٱتَّقُوهُ ۖ ذَٰلِكُمْ خَيْرٌۭ","إِن كُنتُمْ تَعْلَمُونَ",26],["29:17:17",398,"لَكُمْ","for you","ٱللَّهِ لَا يَمْلِكُونَ","رِزْقًۭا فَٱبْتَغُوا۟ عِندَ",26],["29:22:10",398,"لَكُم","for you","فِى ٱلسَّمَآءِ ۖ وَمَا","مِّن دُونِ ٱللَّهِ",26],["29:25:25",399,"لَكُم","for you","وَمَأْوَىٰكُمُ ٱلنَّارُ وَمَا","مِّن نَّـٰصِرِينَ",26],["29:38:5",400,"لَكُم","to you","وَثَمُودَا۟ وَقَد تَّبَيَّنَ","مِّن مَّسَـٰكِنِهِمْ ۖ وَزَيَّنَ",26],["30:21:5",406,"لَكُم","for you","ءَايَـٰتِهِۦٓ أَنْ خَلَقَ","مِّنْ أَنفُسِكُمْ أَزْوَٰجًۭا",26],["30:28:2",407,"لَكُم","to you","ضَرَبَ","مَّثَلًۭا مِّنْ أَنفُسِكُمْ ۖ",26],["30:28:7",407,"لَّكُم","for you","مِّنْ أَنفُسِكُمْ ۖ هَل","مِّن مَّا مَلَكَتْ",26],["31:10:12",411,"بِكُمْ","with you","رَوَٰسِىَ أَن تَمِيدَ","وَبَثَّ فِيهَا مِن",26],["31:20:6",413,"لَكُم","to you","أَنَّ ٱللَّهَ سَخَّرَ","مَّا فِى ٱلسَّمَـٰوَٰتِ",26],["32:4:16",415,"لَكُم","for you","عَلَى ٱلْعَرْشِ ۖ مَا","مِّن دُونِهِۦ مِن",26],["32:9:8",415,"لَكُمُ","for you","مِن رُّوحِهِۦ ۖ وَجَعَلَ","ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ وَٱلْأَفْـِٔدَةَ ۚ",26],["32:11:7",415,"بِكُمْ","of you","ٱلْمَوْتِ ٱلَّذِى وُكِّلَ","ثُمَّ إِلَىٰ رَبِّكُمْ",26],["33:13:9",419,"لَكُمْ","for you","يَثْرِبَ لَا مُقَامَ","فَٱرْجِعُوا۟ ۚ وَيَسْتَـْٔذِنُ فَرِيقٌۭ",26],["33:17:10",420,"بِكُمْ","for you","ٱللَّهِ إِنْ أَرَادَ","سُوٓءًا أَوْ أَرَادَ",26],["33:17:14",420,"بِكُمْ","for you","سُوٓءًا أَوْ أَرَادَ","رَحْمَةًۭ ۚ وَلَا يَجِدُونَ",26],["33:21:3",420,"لَكُمْ","for you","لَّقَدْ كَانَ","فِى رَسُولِ ٱللَّهِ",26],["33:49:14",424,"لَكُمْ","for you","أَن تَمَسُّوهُنَّ فَمَا","عَلَيْهِنَّ مِنْ عِدَّةٍۢ",26],["33:53:11",425,"لَكُمْ","to you","إِلَّآ أَن يُؤْذَنَ","إِلَىٰ طَعَامٍ غَيْرَ",26],["33:53:52",425,"لَكُمْ","for you","وَقُلُوبِهِنَّ ۚ وَمَا كَانَ","أَن تُؤْذُوا۟ رَسُولَ",26],["33:71:2",427,"لَكُمْ","for you","يُصْلِحْ","أَعْمَـٰلَكُمْ وَيَغْفِرْ لَكُمْ",26],["33:71:5",427,"لَكُمْ","for you","لَكُمْ أَعْمَـٰلَكُمْ وَيَغْفِرْ","ذُنُوبَكُمْ ۗ وَمَن يُطِعِ",26],["34:30:2",431,"لَّكُم","For you","قُل","مِّيعَادُ يَوْمٍۢ لَّا",26],["34:46:20",433,"لَّكُم","for you","هُوَ إِلَّا نَذِيرٌۭ","بَيْنَ يَدَىْ عَذَابٍۢ",26],["34:47:7",433,"لَكُمْ ۖ","for you","مِّنْ أَجْرٍۢ فَهُوَ","إِنْ أَجْرِىَ إِلَّا",26],["35:6:3",435,"لَكُمْ","(is) to you","إِنَّ ٱلشَّيْطَـٰنَ","عَدُوٌّۭ فَٱتَّخِذُوهُ عَدُوًّا ۚ",26],["35:14:10",436,"لَكُمْ ۖ","to you","سَمِعُوا۟ مَا ٱسْتَجَابُوا۟","وَيَوْمَ ٱلْقِيَـٰمَةِ يَكْفُرُونَ",26],["36:18:4",441,"بِكُمْ ۖ","from you","قَالُوٓا۟ إِنَّا تَطَيَّرْنَا","لَئِن لَّمْ تَنتَهُوا۟",26],["36:60:11",444,"لَكُمْ","(is) for you","تَعْبُدُوا۟ ٱلشَّيْطَـٰنَ ۖ إِنَّهُۥ","عَدُوٌّۭ مُّبِينٌۭ",26],["36:80:3",445,"لَكُم","for you","ٱلَّذِى جَعَلَ","مِّنَ ٱلشَّجَرِ ٱلْأَخْضَرِ",26],["37:25:2",447,"لَكُمْ","(is) for you","مَا","لَا تَنَاصَرُونَ",26],["37:92:2",449,"لَكُمْ","for you","مَا","لَا تَنطِقُونَ",26],["37:154:2",452,"لَكُمْ","What is with you","مَا","كَيْفَ تَحْكُمُونَ",26],["37:156:2",452,"لَكُمْ","(is) for you","أَمْ","سُلْطَـٰنٌۭ مُّبِينٌۭ",26],["38:60:6",456,"بِكُمْ ۖ","for you","أَنتُمْ لَا مَرْحَبًۢا","أَنتُمْ قَدَّمْتُمُوهُ لَنَا ۖ",26],["39:6:10",459,"لَكُم","for you","مِنْهَا زَوْجَهَا وَأَنزَلَ","مِّنَ ٱلْأَنْعَـٰمِ ثَمَـٰنِيَةَ",26],["39:7:14",459,"لَكُمْ ۗ","in you","وَإِن تَشْكُرُوا۟ يَرْضَهُ","وَلَا تَزِرُ وَازِرَةٌۭ",26],["40:13:6",468,"لَكُم","for you","يُرِيكُمْ ءَايَـٰتِهِۦ وَيُنَزِّلُ","مِّنَ ٱلسَّمَآءِ رِزْقًۭا ۚ",26],["40:29:2",470,"لَكُمُ","For you","يَـٰقَوْمِ","ٱلْمُلْكُ ٱلْيَوْمَ ظَـٰهِرِينَ",26],["40:33:5",470,"لَكُم","for you","تُوَلُّونَ مُدْبِرِينَ مَا","مِّنَ ٱللَّهِ مِنْ",26],["40:44:4",472,"لَكُمْ ۚ","to you","فَسَتَذْكُرُونَ مَآ أَقُولُ","وَأُفَوِّضُ أَمْرِىٓ إِلَى",26],["40:47:11",472,"لَكُمْ","for you","ٱسْتَكْبَرُوٓا۟ إِنَّا كُنَّا","تَبَعًۭا فَهَلْ أَنتُم",26],["40:60:5",474,"لَكُمْ ۚ","to you","رَبُّكُمُ ٱدْعُونِىٓ أَسْتَجِبْ","إِنَّ ٱلَّذِينَ يَسْتَكْبِرُونَ",26],["40:61:4",474,"لَكُمُ","for you","ٱللَّهُ ٱلَّذِى جَعَلَ","ٱلَّيْلَ لِتَسْكُنُوا۟ فِيهِ",26],["40:64:4",474,"لَكُمُ","for you","ٱللَّهُ ٱلَّذِى جَعَلَ","ٱلْأَرْضَ قَرَارًۭا وَٱلسَّمَآءَ",26],["40:79:4",476,"لَكُمُ","for you","ٱللَّهُ ٱلَّذِى جَعَلَ","ٱلْأَنْعَـٰمَ لِتَرْكَبُوا۟ مِنْهَا",26],["40:80:1",476,"وَلَكُمْ","And for you","","فِيهَا مَنَـٰفِعُ وَلِتَبْلُغُوا۟",26],["41:31:8",480,"وَلَكُمْ","And for you","ٱلدُّنْيَا وَفِى ٱلْـَٔاخِرَةِ ۖ","فِيهَا مَا تَشْتَهِىٓ",26],["41:31:13",480,"وَلَكُمْ","and for you","مَا تَشْتَهِىٓ أَنفُسُكُمْ","فِيهَا مَا تَدَّعُونَ",26],["42:11:5",484,"لَكُم","for you","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ جَعَلَ","مِّنْ أَنفُسِكُمْ أَزْوَٰجًۭا",26],["42:13:2",484,"لَكُم","for you","۞ شَرَعَ","مِّنَ ٱلدِّينِ مَا",26],["42:15:24",484,"وَلَكُمْ","and for you","وَرَبُّكُمْ ۖ لَنَآ أَعْمَـٰلُنَا","أَعْمَـٰلُكُمْ ۖ لَا حُجَّةَ",26],["42:31:7",486,"لَكُم","for you","فِى ٱلْأَرْضِ ۖ وَمَا","مِّن دُونِ ٱللَّهِ",26],["42:47:14",488,"لَكُم","(is) for you","مِنَ ٱللَّهِ ۚ مَا","مِّن مَّلْجَإٍۢ يَوْمَئِذٍۢ",26],["42:47:19",488,"لَكُم","for you","مَّلْجَإٍۢ يَوْمَئِذٍۢ وَمَا","مِّن نَّكِيرٍۢ",26],["43:10:3",489,"لَكُمُ","for you","ٱلَّذِى جَعَلَ","ٱلْأَرْضَ مَهْدًۭا وَجَعَلَ",26],["43:10:7",489,"لَكُمْ","for you","ٱلْأَرْضَ مَهْدًۭا وَجَعَلَ","فِيهَا سُبُلًۭا لَّعَلَّكُمْ",26],["43:12:6",490,"لَكُم","for you","ٱلْأَزْوَٰجَ كُلَّهَا وَجَعَلَ","مِّنَ ٱلْفُلْكِ وَٱلْأَنْعَـٰمِ",26],["43:62:5",494,"لَكُمْ","(is) for you","يَصُدَّنَّكُمُ ٱلشَّيْطَـٰنُ ۖ إِنَّهُۥ","عَدُوٌّۭ مُّبِينٌۭ",26],["43:63:10",494,"لَكُم","to you","جِئْتُكُم بِٱلْحِكْمَةِ وَلِأُبَيِّنَ","بَعْضَ ٱلَّذِى تَخْتَلِفُونَ",26],["43:73:1",494,"لَكُمْ","For you","","فِيهَا فَـٰكِهَةٌۭ كَثِيرَةٌۭ",26],["44:18:7",496,"لَكُمْ","to you","عِبَادَ ٱللَّهِ ۖ إِنِّى","رَسُولٌ أَمِينٌۭ",26],["45:12:4",499,"لَكُمُ","to you","۞ ٱللَّهُ ٱلَّذِى سَخَّرَ","ٱلْبَحْرَ لِتَجْرِىَ ٱلْفُلْكُ",26],["45:13:2",499,"لَكُم","to you","وَسَخَّرَ","مَّا فِى ٱلسَّمَـٰوَٰتِ",26],["45:34:12",502,"لَكُم","for you","وَمَأْوَىٰكُمُ ٱلنَّارُ وَمَا","مِّن نَّـٰصِرِينَ",26],["46:9:13",503,"بِكُمْ ۖ","with you","يُفْعَلُ بِى وَلَا","إِنْ أَتَّبِعُ إِلَّا",26],["46:31:8",506,"لَكُم","for you","وَءَامِنُوا۟ بِهِۦ يَغْفِرْ","مِّن ذُنُوبِكُمْ وَيُجِرْكُم",26],["48:11:20",512,"لَكُم","for you","قُلْ فَمَن يَمْلِكُ","مِّنَ ٱللَّهِ شَيْـًٔا",26],["48:11:26",512,"بِكُمْ","for you","شَيْـًٔا إِنْ أَرَادَ","ضَرًّا أَوْ أَرَادَ",26],["48:11:30",512,"بِكُمْ","for you","ضَرًّا أَوْ أَرَادَ","نَفْعًۢا ۚ بَلْ كَانَ",26],["48:20:7",513,"لَكُمْ","for you","كَثِيرَةًۭ تَأْخُذُونَهَا فَعَجَّلَ","هَـٰذِهِۦ وَكَفَّ أَيْدِىَ",26],["51:50:5",522,"لَكُم","to you","إِلَى ٱللَّهِ ۖ إِنِّى","مِّنْهُ نَذِيرٌۭ مُّبِينٌۭ",26],["51:51:8",522,"لَكُم","to you","إِلَـٰهًا ءَاخَرَ ۖ إِنِّى","مِّنْهُ نَذِيرٌۭ مُّبِينٌۭ",26],["52:39:4",525,"وَلَكُمُ","while for you","أَمْ لَهُ ٱلْبَنَـٰتُ","ٱلْبَنُونَ",26],["53:21:1",526,"أَلَكُمُ","Is for you","","ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ",26],["53:32:14",527,"بِكُمْ","(is) most knowing about you","ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ","إِذْ أَنشَأَكُم مِّنَ",26],["54:43:6",530,"لَكُم","for you","مِّنْ أُو۟لَـٰٓئِكُمْ أَمْ","بَرَآءَةٌۭ فِى ٱلزُّبُرِ",26],["55:31:2",532,"لَكُمْ","to you","سَنَفْرُغُ","أَيُّهَ ٱلثَّقَلَانِ",26],["57:8:2",538,"لَكُمْ","(is) for you","وَمَا","لَا تُؤْمِنُونَ بِٱللَّهِ ۙ",26],["57:9:15",538,"بِكُمْ","to you","ٱلنُّورِ ۚ وَإِنَّ ٱللَّهَ","لَرَءُوفٌۭ رَّحِيمٌۭ",26],["57:10:2",538,"لَكُمْ","(is) for you","وَمَا","أَلَّا تُنفِقُوا۟ فِى",26],["57:17:10",539,"لَكُمُ","to you","مَوْتِهَا ۚ قَدْ بَيَّنَّا","ٱلْـَٔايَـٰتِ لَعَلَّكُمْ تَعْقِلُونَ",26],["57:28:13",541,"لَّكُمْ","for you","مِن رَّحْمَتِهِۦ وَيَجْعَل","نُورًۭا تَمْشُونَ بِهِۦ",26],["57:28:18",541,"لَكُمْ ۚ","you","تَمْشُونَ بِهِۦ وَيَغْفِرْ","وَٱللَّهُ غَفُورٌۭ رَّحِيمٌۭ",26],["58:11:6",543,"لَكُمْ","to you","ءَامَنُوٓا۟ إِذَا قِيلَ","تَفَسَّحُوا۟ فِى ٱلْمَجَـٰلِسِ",26],["58:11:13",543,"لَكُمْ ۖ","for you","فَٱفْسَحُوا۟ يَفْسَحِ ٱللَّهُ","وَإِذَا قِيلَ ٱنشُزُوا۟",26],["58:12:14",544,"لَّكُمْ","for you","صَدَقَةًۭ ۚ ذَٰلِكَ خَيْرٌۭ","وَأَطْهَرُ ۚ فَإِن لَّمْ",26],["58:18:9",544,"لَكُمْ ۖ","to you","لَهُۥ كَمَا يَحْلِفُونَ","وَيَحْسَبُونَ أَنَّهُمْ عَلَىٰ",26],["60:2:4",549,"لَكُمْ","to you","إِن يَثْقَفُوكُمْ يَكُونُوا۟","أَعْدَآءًۭ وَيَبْسُطُوٓا۟ إِلَيْكُمْ",26],["60:4:3",549,"لَكُمْ","for you","قَدْ كَانَتْ","أُسْوَةٌ حَسَنَةٌۭ فِىٓ",26],["60:4:22",549,"بِكُمْ","you","دُونِ ٱللَّهِ كَفَرْنَا","وَبَدَا بَيْنَنَا وَبَيْنَكُمُ",26],["60:6:3",550,"لَكُمْ","for you","لَقَدْ كَانَ","فِيهِمْ أُسْوَةٌ حَسَنَةٌۭ",26],["61:11:12",552,"لَّكُمْ","for you","وَأَنفُسِكُمْ ۚ ذَٰلِكُمْ خَيْرٌۭ","إِن كُنتُمْ تَعْلَمُونَ",26],["61:12:2",552,"لَكُمْ","for you","يَغْفِرْ","ذُنُوبَكُمْ وَيُدْخِلْكُمْ جَنَّـٰتٍۢ",26],["62:9:18",554,"لَّكُمْ","for you","ٱلْبَيْعَ ۚ ذَٰلِكُمْ خَيْرٌۭ","إِن كُنتُمْ تَعْلَمُونَ",26],["63:5:6",555,"لَكُمْ","for you","لَهُمْ تَعَالَوْا۟ يَسْتَغْفِرْ","رَسُولُ ٱللَّهِ لَوَّوْا۟",26],["64:14:9",557,"لَّكُمْ","to you","أَزْوَٰجِكُمْ وَأَوْلَـٰدِكُمْ عَدُوًّۭا","فَٱحْذَرُوهُمْ ۚ وَإِن تَعْفُوا۟",26],["64:17:7",557,"لَكُمْ","for you","قَرْضًا حَسَنًۭا يُضَـٰعِفْهُ","وَيَغْفِرْ لَكُمْ ۚ وَٱللَّهُ",26],["64:17:9",557,"لَكُمْ ۚ","you","يُضَـٰعِفْهُ لَكُمْ وَيَغْفِرْ","وَٱللَّهُ شَكُورٌ حَلِيمٌ",26],["65:6:22",559,"لَكُمْ","for you","حَمْلَهُنَّ ۚ فَإِنْ أَرْضَعْنَ","فَـَٔاتُوهُنَّ أُجُورَهُنَّ ۖ وَأْتَمِرُوا۟",26],["66:2:4",560,"لَكُمْ","for you","قَدْ فَرَضَ ٱللَّهُ","تَحِلَّةَ أَيْمَـٰنِكُمْ ۚ وَٱللَّهُ",26],["67:15:4",563,"لَكُمُ","for you","هُوَ ٱلَّذِى جَعَلَ","ٱلْأَرْضَ ذَلُولًۭا فَٱمْشُوا۟",26],["67:16:7",563,"بِكُمُ","you","ٱلسَّمَآءِ أَن يَخْسِفَ","ٱلْأَرْضَ فَإِذَا هِىَ",26],["67:20:6",563,"لَّكُمْ","for you","ٱلَّذِى هُوَ جُندٌۭ","يَنصُرُكُم مِّن دُونِ",26],["67:23:6",563,"لَكُمُ","for you","ٱلَّذِىٓ أَنشَأَكُمْ وَجَعَلَ","ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ وَٱلْأَفْـِٔدَةَ ۖ",26],["68:28:5",565,"لَّكُمْ","you","أَوْسَطُهُمْ أَلَمْ أَقُل","لَوْلَا تُسَبِّحُونَ",26],["68:36:2",565,"لَكُمْ","(is) for you","مَا","كَيْفَ تَحْكُمُونَ",26],["68:37:2",565,"لَكُمْ","(is) for you","أَمْ","كِتَـٰبٌۭ فِيهِ تَدْرُسُونَ",26],["68:38:2",565,"لَكُمْ","for you","إِنَّ","فِيهِ لَمَا تَخَيَّرُونَ",26],["68:39:2",565,"لَكُمْ","for you","أَمْ","أَيْمَـٰنٌ عَلَيْنَا بَـٰلِغَةٌ",26],["68:39:10",565,"لَكُمْ","for you","يَوْمِ ٱلْقِيَـٰمَةِ ۙ إِنَّ","لَمَا تَحْكُمُونَ",26],["69:12:2",567,"لَكُمْ","for you","لِنَجْعَلَهَا","تَذْكِرَةًۭ وَتَعِيَهَآ أُذُنٌۭ",26],["71:2:4",570,"لَكُمْ","to you","قَالَ يَـٰقَوْمِ إِنِّى","نَذِيرٌۭ مُّبِينٌ",26],["71:4:2",570,"لَكُم","for you","يَغْفِرْ","مِّن ذُنُوبِكُمْ وَيُؤَخِّرْكُمْ",26],["71:12:5",571,"لَّكُمْ","for you","بِأَمْوَٰلٍۢ وَبَنِينَ وَيَجْعَل","جَنَّـٰتٍۢ وَيَجْعَل لَّكُمْ",26],["71:12:8",571,"لَّكُمْ","for you","لَّكُمْ جَنَّـٰتٍۢ وَيَجْعَل","أَنْهَـٰرًۭا",26],["71:13:2",571,"لَكُمْ","(is) for you","مَّا","لَا تَرْجُونَ لِلَّهِ",26],["71:19:3",571,"لَكُمُ","for you","وَٱللَّهُ جَعَلَ","ٱلْأَرْضَ بِسَاطًۭا",26],["72:21:5",573,"لَكُمْ","for you","إِنِّى لَآ أَمْلِكُ","ضَرًّۭا وَلَا رَشَدًۭا",26],["76:22:4",579,"لَكُمْ","for you","إِنَّ هَـٰذَا كَانَ","جَزَآءًۭ وَكَانَ سَعْيُكُم",26],["77:39:3",581,"لَكُمْ","for you","فَإِن كَانَ","كَيْدٌۭ فَكِيدُونِ",26],["79:33:2",584,"لَّكُمْ","for you","مَتَـٰعًۭا","وَلِأَنْعَـٰمِكُمْ",26],["80:32:2",585,"لَّكُمْ","for you","مَّتَـٰعًۭا","وَلِأَنْعَـٰمِكُمْ",26],["109:6:1",603,"لَكُمْ","For you","","دِينُكُمْ وَلِىَ دِينِ",26]]