[["6:136:4",145,"ذَرَأَ","He produced","وَجَعَلُوا۟ لِلَّهِ مِمَّا","مِنَ ٱلْحَرْثِ وَٱلْأَنْعَـٰمِ",1132],["7:179:2",174,"ذَرَأْنَا","We have created","وَلَقَدْ","لِجَهَنَّمَ كَثِيرًۭا مِّنَ",1132],["16:13:2",268,"ذَرَأَ","He multiplied","وَمَا","لَكُمْ فِى ٱلْأَرْضِ",1132],["23:79:3",347,"ذَرَأَكُمْ","multiplied you","وَهُوَ ٱلَّذِى","فِى ٱلْأَرْضِ وَإِلَيْهِ",1132],["42:11:12",484,"يَذْرَؤُكُمْ","He multiplies you","وَمِنَ ٱلْأَنْعَـٰمِ أَزْوَٰجًۭا ۖ","فِيهِ ۚ لَيْسَ كَمِثْلِهِۦ",1132],["67:24:4",563,"ذَرَأَكُمْ","multiplied you","قُلْ هُوَ ٱلَّذِى","فِى ٱلْأَرْضِ وَإِلَيْهِ",1132]]