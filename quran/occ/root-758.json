[["16:84:14",276,"يُسْتَعْتَبُونَ","will be asked to make amends","كَفَرُوا۟ وَلَا هُمْ","",1671],["30:57:9",410,"يُسْتَعْتَبُونَ","will be allowed to make amends","مَعْذِرَتُهُمْ وَلَا هُمْ","",1671],["41:24:7",479,"يَسْتَعْتِبُوا۟","they ask for favor","مَثْوًۭى لَّهُمْ ۖ وَإِن","فَمَا هُم مِّنَ",1671],["41:24:11",479,"ٱلْمُعْتَبِينَ","those who receive favor","فَمَا هُم مِّنَ","",3764],["45:35:16",502,"يُسْتَعْتَبُونَ","will be asked to appease","مِنْهَا وَلَا هُمْ","",1671]]