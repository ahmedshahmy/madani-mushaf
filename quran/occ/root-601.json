[["2:227:2",36,"عَزَمُوا۟","they resolve","وَإِنْ","ٱلطَّلَـٰقَ فَإِنَّ ٱللَّهَ",1504],["2:235:28",38,"تَعْزِمُوا۟","resolve (on)","قَوْلًۭا مَّعْرُوفًۭا ۚ وَلَا","عُقْدَةَ ٱلنِّكَاحِ حَتَّىٰ",1504],["3:159:23",71,"عَزَمْتَ","you have decided","فِى ٱلْأَمْرِ ۖ فَإِذَا","فَتَوَكَّلْ عَلَى ٱللَّهِ ۚ",1504],["3:186:23",74,"عَزْمِ","the matters","فَإِنَّ ذَٰلِكَ مِنْ","ٱلْأُمُورِ",1297],["20:115:11",320,"عَزْمًۭا","determination","وَلَمْ نَجِدْ لَهُۥ","",1297],["31:17:16",412,"عَزْمِ","the matters requiring determination","إِنَّ ذَٰلِكَ مِنْ","ٱلْأُمُورِ",1297],["42:43:7",487,"عَزْمِ","matters of determination","إِنَّ ذَٰلِكَ لَمِنْ","ٱلْأُمُورِ",1297],["46:35:5",506,"ٱلْعَزْمِ","those of determination","كَمَا صَبَرَ أُو۟لُوا۟","مِنَ ٱلرُّسُلِ وَلَا",1297],["47:21:5",509,"عَزَمَ","(is) determined","وَقَوْلٌۭ مَّعْرُوفٌۭ ۚ فَإِذَا","ٱلْأَمْرُ فَلَوْ صَدَقُوا۟",1504]]