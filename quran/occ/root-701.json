[["2:259:45",43,"حِمَارِكَ","your donkey","يَتَسَنَّهْ ۖ وَٱنظُرْ إِلَىٰ","وَلِنَجْعَلَكَ ءَايَةًۭ لِّلنَّاسِ ۖ",1305],["16:8:3",268,"وَٱلْحَمِيرَ","and donkeys","وَٱلْخَيْلَ وَٱلْبِغَالَ","لِتَرْكَبُوهَا وَزِينَةًۭ ۚ وَيَخْلُقُ",1305],["31:19:11",412,"ٱلْحَمِيرِ","(of) the donkeys","أَنكَرَ ٱلْأَصْوَٰتِ لَصَوْتُ","",1305],["35:27:18",437,"وَحُمْرٌۭ","and red","ٱلْجِبَالِ جُدَدٌۢ بِيضٌۭ","مُّخْتَلِفٌ أَلْوَٰنُهَا وَغَرَابِيبُ",3223],["62:5:9",553,"ٱلْحِمَارِ","the donkey","لَمْ يَحْمِلُوهَا كَمَثَلِ","يَحْمِلُ أَسْفَارًۢا ۚ بِئْسَ",1305],["74:50:2",577,"حُمُرٌۭ","donkeys","كَأَنَّهُمْ","مُّسْتَنفِرَةٌۭ",1305]]