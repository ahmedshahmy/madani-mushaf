[["2:111:14",17,"هَاتُوا۟","Bring","تِلْكَ أَمَانِيُّهُمْ ۗ قُلْ","بُرْهَـٰنَكُمْ إِن كُنتُمْ",1554],["21:24:7",323,"هَاتُوا۟","Bring","دُونِهِۦٓ ءَالِهَةًۭ ۖ قُلْ","بُرْهَـٰنَكُمْ ۖ هَـٰذَا ذِكْرُ",1554],["27:64:15",383,"هَاتُوا۟","Bring forth","مَّعَ ٱللَّهِ ۚ قُلْ","بُرْهَـٰنَكُمْ إِن كُنتُمْ",1554],["28:75:7",394,"هَاتُوا۟","Bring","أُمَّةٍۢ شَهِيدًۭا فَقُلْنَا","بُرْهَـٰنَكُمْ فَعَلِمُوٓا۟ أَنَّ",1554]]