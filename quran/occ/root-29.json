[["2:26:17",5,"ٱلْحَقُّ","(is) the truth","ءَامَنُوا۟ فَيَعْلَمُونَ أَنَّهُ","مِن رَّبِّهِمْ ۖ وَأَمَّا",50],["2:42:3",7,"ٱلْحَقَّ","the Truth","وَلَا تَلْبِسُوا۟","بِٱلْبَـٰطِلِ وَتَكْتُمُوا۟ ٱلْحَقَّ",50],["2:42:6",7,"ٱلْحَقَّ","the Truth","ٱلْحَقَّ بِٱلْبَـٰطِلِ وَتَكْتُمُوا۟","وَأَنتُمْ تَعْلَمُونَ",50],["2:61:54",9,"ٱلْحَقِّ ۗ","[the] right","وَيَقْتُلُونَ ٱلنَّبِيِّـۧنَ بِغَيْرِ","ذَٰلِكَ بِمَا عَصَوا۟",50],["2:71:20",11,"بِٱلْحَقِّ ۚ","with the truth","قَالُوا۟ ٱلْـَٔـٰنَ جِئْتَ","فَذَبَحُوهَا وَمَا كَادُوا۟",50],["2:91:17",14,"ٱلْحَقُّ","(is) the truth","بِمَا وَرَآءَهُۥ وَهُوَ","مُصَدِّقًۭا لِّمَا مَعَهُمْ ۗ",50],["2:109:21",17,"ٱلْحَقُّ ۖ","the truth","مَا تَبَيَّنَ لَهُمُ","فَٱعْفُوا۟ وَٱصْفَحُوا۟ حَتَّىٰ",50],["2:119:3",18,"بِٱلْحَقِّ","with the truth","إِنَّآ أَرْسَلْنَـٰكَ","بَشِيرًۭا وَنَذِيرًۭا ۖ وَلَا",50],["2:121:5",19,"حَقَّ","(as it has the) right","ءَاتَيْنَـٰهُمُ ٱلْكِتَـٰبَ يَتْلُونَهُۥ","تِلَاوَتِهِۦٓ أُو۟لَـٰٓئِكَ يُؤْمِنُونَ",50],["2:144:27",22,"ٱلْحَقُّ","(is) the truth","ٱلْكِتَـٰبَ لَيَعْلَمُونَ أَنَّهُ","مِن رَّبِّهِمْ ۗ وَمَا",50],["2:146:12",23,"ٱلْحَقَّ","the Truth","فَرِيقًۭا مِّنْهُمْ لَيَكْتُمُونَ","وَهُمْ يَعْلَمُونَ",50],["2:147:1",23,"ٱلْحَقُّ","The Truth","","مِن رَّبِّكَ ۖ فَلَا",50],["2:149:10",23,"لَلْحَقُّ","(is) surely the truth","ٱلْمَسْجِدِ ٱلْحَرَامِ ۖ وَإِنَّهُۥ","مِن رَّبِّكَ ۗ وَمَا",50],["2:176:6",26,"بِٱلْحَقِّ ۗ","with [the] Truth","ٱللَّهَ نَزَّلَ ٱلْكِتَـٰبَ","وَإِنَّ ٱلَّذِينَ ٱخْتَلَفُوا۟",50],["2:180:14",27,"حَقًّا","a duty","لِلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَ بِٱلْمَعْرُوفِ ۖ","عَلَى ٱلْمُتَّقِينَ",50],["2:213:13",33,"بِٱلْحَقِّ","in [the] truth","وَأَنزَلَ مَعَهُمُ ٱلْكِتَـٰبَ","لِيَحْكُمَ بَيْنَ ٱلنَّاسِ",50],["2:213:41",33,"ٱلْحَقِّ","the Truth","ٱخْتَلَفُوا۟ فِيهِ مِنَ","بِإِذْنِهِۦ ۗ وَٱللَّهُ يَهْدِى",50],["2:228:23",36,"أَحَقُّ","(have) better right","وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۚ وَبُعُولَتُهُنَّ","بِرَدِّهِنَّ فِى ذَٰلِكَ",814],["2:236:23",38,"حَقًّا","a duty","قَدَرُهُۥ مَتَـٰعًۢا بِٱلْمَعْرُوفِ ۖ","عَلَى ٱلْمُحْسِنِينَ",50],["2:241:4",39,"حَقًّا","a duty","وَلِلْمُطَلَّقَـٰتِ مَتَـٰعٌۢ بِٱلْمَعْرُوفِ ۖ","عَلَى ٱلْمُتَّقِينَ",50],["2:247:18",40,"أَحَقُّ","(are) more entitled","ٱلْمُلْكُ عَلَيْنَا وَنَحْنُ","بِٱلْمُلْكِ مِنْهُ وَلَمْ",814],["2:252:6",41,"بِٱلْحَقِّ ۚ","in [the] truth","ٱللَّهِ نَتْلُوهَا عَلَيْكَ","وَإِنَّكَ لَمِنَ ٱلْمُرْسَلِينَ",50],["2:282:27",48,"ٱلْحَقُّ","(is) the right","وَلْيُمْلِلِ ٱلَّذِى عَلَيْهِ","وَلْيَتَّقِ ٱللَّهَ رَبَّهُۥ",50],["2:282:39",48,"ٱلْحَقُّ","(is) the right","كَانَ ٱلَّذِى عَلَيْهِ","سَفِيهًا أَوْ ضَعِيفًا",50],["3:3:4",50,"بِٱلْحَقِّ","in [the] truth","نَزَّلَ عَلَيْكَ ٱلْكِتَـٰبَ","مُصَدِّقًۭا لِّمَا بَيْنَ",50],["3:21:9",52,"حَقٍّۢ","right","وَيَقْتُلُونَ ٱلنَّبِيِّـۧنَ بِغَيْرِ","وَيَقْتُلُونَ ٱلَّذِينَ يَأْمُرُونَ",50],["3:60:1",57,"ٱلْحَقُّ","The truth","","مِن رَّبِّكَ فَلَا",50],["3:62:5",58,"ٱلْحَقُّ ۚ","[the] true","هَـٰذَا لَهُوَ ٱلْقَصَصُ","وَمَا مِنْ إِلَـٰهٍ",50],["3:71:5",59,"ٱلْحَقَّ","the truth","ٱلْكِتَـٰبِ لِمَ تَلْبِسُونَ","بِٱلْبَـٰطِلِ وَتَكْتُمُونَ ٱلْحَقَّ",50],["3:71:8",59,"ٱلْحَقَّ","the truth","ٱلْحَقَّ بِٱلْبَـٰطِلِ وَتَكْتُمُونَ","وَأَنتُمْ تَعْلَمُونَ",50],["3:86:11",61,"حَقٌّۭ","(is) true","وَشَهِدُوٓا۟ أَنَّ ٱلرَّسُولَ","وَجَآءَهُمُ ٱلْبَيِّنَـٰتُ ۚ وَٱللَّهُ",50],["3:102:6",63,"حَقَّ","(as is His) right","ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ","تُقَاتِهِۦ وَلَا تَمُوتُنَّ",50],["3:108:6",63,"بِٱلْحَقِّ ۗ","in truth","ٱللَّهِ نَتْلُوهَا عَلَيْكَ","وَمَا ٱللَّهُ يُرِيدُ",50],["3:112:30",64,"حَقٍّۢ ۚ","right","وَيَقْتُلُونَ ٱلْأَنۢبِيَآءَ بِغَيْرِ","ذَٰلِكَ بِمَا عَصَوا۟",50],["3:154:19",70,"ٱلْحَقِّ","the truth","يَظُنُّونَ بِٱللَّهِ غَيْرَ","ظَنَّ ٱلْجَـٰهِلِيَّةِ ۖ يَقُولُونَ",50],["3:181:18",74,"حَقٍّۢ","(any) right","وَقَتْلَهُمُ ٱلْأَنۢبِيَآءَ بِغَيْرِ","وَنَقُولُ ذُوقُوا۟ عَذَابَ",50],["4:105:5",95,"بِٱلْحَقِّ","with the truth","أَنزَلْنَآ إِلَيْكَ ٱلْكِتَـٰبَ","لِتَحْكُمَ بَيْنَ ٱلنَّاسِ",50],["4:122:16",98,"حَقًّۭا ۚ","(in) truth","أَبَدًۭا ۖ وَعْدَ ٱللَّهِ","وَمَنْ أَصْدَقُ مِنَ",50],["4:151:4",102,"حَقًّۭا ۚ","truly","أُو۟لَـٰٓئِكَ هُمُ ٱلْكَـٰفِرُونَ","وَأَعْتَدْنَا لِلْكَـٰفِرِينَ عَذَابًۭا",50],["4:155:10",103,"حَقٍّۢ","any right","وَقَتْلِهِمُ ٱلْأَنۢبِيَآءَ بِغَيْرِ","وَقَوْلِهِمْ قُلُوبُنَا غُلْفٌۢ ۚ",50],["4:170:6",104,"بِٱلْحَقِّ","with the truth","قَدْ جَآءَكُمُ ٱلرَّسُولُ","مِن رَّبِّكُمْ فَـَٔامِنُوا۟",50],["4:171:12",105,"ٱلْحَقَّ ۚ","the truth","عَلَى ٱللَّهِ إِلَّا","إِنَّمَا ٱلْمَسِيحُ عِيسَى",50],["5:27:6",112,"بِٱلْحَقِّ","in truth","نَبَأَ ٱبْنَىْ ءَادَمَ","إِذْ قَرَّبَا قُرْبَانًۭا",50],["5:48:4",116,"بِٱلْحَقِّ","in [the] truth","وَأَنزَلْنَآ إِلَيْكَ ٱلْكِتَـٰبَ","مُصَدِّقًۭا لِّمَا بَيْنَ",50],["5:48:24",116,"ٱلْحَقِّ ۚ","the truth","عَمَّا جَآءَكَ مِنَ","لِكُلٍّۢ جَعَلْنَا مِنكُمْ",50],["5:77:9",120,"ٱلْحَقِّ","the truth","فِى دِينِكُمْ غَيْرَ","وَلَا تَتَّبِعُوٓا۟ أَهْوَآءَ",50],["5:83:15",121,"ٱلْحَقِّ ۖ","the truth","مِمَّا عَرَفُوا۟ مِنَ","يَقُولُونَ رَبَّنَآ ءَامَنَّا",50],["5:84:9",122,"ٱلْحَقِّ","the truth","وَمَا جَآءَنَا مِنَ","وَنَطْمَعُ أَن يُدْخِلَنَا",50],["5:107:5",125,"ٱسْتَحَقَّآ","(were) guilty","عُثِرَ عَلَىٰٓ أَنَّهُمَا","إِثْمًۭا فَـَٔاخَرَانِ يَقُومَانِ",2844],["5:107:12",125,"ٱسْتَحَقَّ","have a lawful right","مَقَامَهُمَا مِنَ ٱلَّذِينَ","عَلَيْهِمُ ٱلْأَوْلَيَـٰنِ فَيُقْسِمَانِ",2844],["5:107:18",125,"أَحَقُّ","(is) truer","فَيُقْسِمَانِ بِٱللَّهِ لَشَهَـٰدَتُنَآ","مِن شَهَـٰدَتِهِمَا وَمَا",814],["5:116:26",127,"بِحَقٍّ ۚ","(had) right","مَا لَيْسَ لِى","إِن كُنتُ قُلْتُهُۥ",50],["6:5:3",128,"بِٱلْحَقِّ","the truth","فَقَدْ كَذَّبُوا۟","لَمَّا جَآءَهُمْ ۖ فَسَوْفَ",50],["6:30:10",131,"بِٱلْحَقِّ ۚ","the truth","قَالَ أَلَيْسَ هَـٰذَا","قَالُوا۟ بَلَىٰ وَرَبِّنَا ۚ",50],["6:57:19",134,"ٱلْحَقَّ ۖ","the truth","إِلَّا لِلَّهِ ۖ يَقُصُّ","وَهُوَ خَيْرُ ٱلْفَـٰصِلِينَ",50],["6:62:6",135,"ٱلْحَقِّ ۚ","[the] True","إِلَى ٱللَّهِ مَوْلَىٰهُمُ","أَلَا لَهُ ٱلْحُكْمُ",50],["6:66:5",135,"ٱلْحَقُّ ۚ","(is) the truth","بِهِۦ قَوْمُكَ وَهُوَ","قُل لَّسْتُ عَلَيْكُم",50],["6:73:6",136,"بِٱلْحَقِّ ۖ","in truth","خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","وَيَوْمَ يَقُولُ كُن",50],["6:73:12",136,"ٱلْحَقُّ ۚ","(is) the truth","كُن فَيَكُونُ ۚ قَوْلُهُ","وَلَهُ ٱلْمُلْكُ يَوْمَ",50],["6:81:18",137,"أَحَقُّ","has more right","سُلْطَـٰنًۭا ۚ فَأَىُّ ٱلْفَرِيقَيْنِ","بِٱلْأَمْنِ ۖ إِن كُنتُمْ",814],["6:91:4",139,"حَقَّ","(with) true","وَمَا قَدَرُوا۟ ٱللَّهَ","قَدْرِهِۦٓ إِذْ قَالُوا۟",50],["6:93:45",139,"ٱلْحَقِّ","the truth","عَلَى ٱللَّهِ غَيْرَ","وَكُنتُمْ عَنْ ءَايَـٰتِهِۦ",50],["6:114:19",142,"بِٱلْحَقِّ ۖ","in truth","مُنَزَّلٌۭ مِّن رَّبِّكَ","فَلَا تَكُونَنَّ مِنَ",50],["6:141:23",146,"حَقَّهُۥ","its due","إِذَآ أَثْمَرَ وَءَاتُوا۟","يَوْمَ حَصَادِهِۦ ۖ وَلَا",50],["6:151:37",148,"بِٱلْحَقِّ ۚ","by (legal) right","حَرَّمَ ٱللَّهُ إِلَّا","ذَٰلِكُمْ وَصَّىٰكُم بِهِۦ",50],["7:8:3",151,"ٱلْحَقُّ ۚ","(will be) the truth","وَٱلْوَزْنُ يَوْمَئِذٍ","فَمَن ثَقُلَتْ مَوَٰزِينُهُۥ",50],["7:30:4",153,"حَقَّ","deserved","فَرِيقًا هَدَىٰ وَفَرِيقًا","عَلَيْهِمُ ٱلضَّلَـٰلَةُ ۗ إِنَّهُمُ",508],["7:33:14",154,"ٱلْحَقِّ","[the] right","وَٱلْإِثْمَ وَٱلْبَغْىَ بِغَيْرِ","وَأَن تُشْرِكُوا۟ بِٱللَّهِ",50],["7:43:28",155,"بِٱلْحَقِّ ۖ","with the truth","جَآءَتْ رُسُلُ رَبِّنَا","وَنُودُوٓا۟ أَن تِلْكُمُ",50],["7:44:12",156,"حَقًّۭا","true","مَا وَعَدَنَا رَبُّنَا","فَهَلْ وَجَدتُّم مَّا",50],["7:44:18",156,"حَقًّۭا ۖ","(to be) true","مَّا وَعَدَ رَبُّكُمْ","قَالُوا۟ نَعَمْ ۚ فَأَذَّنَ",50],["7:53:17",157,"بِٱلْحَقِّ","with the truth","جَآءَتْ رُسُلُ رَبِّنَا","فَهَل لَّنَا مِن",50],["7:89:39",162,"بِٱلْحَقِّ","in truth","بَيْنَنَا وَبَيْنَ قَوْمِنَا","وَأَنتَ خَيْرُ ٱلْفَـٰتِحِينَ",50],["7:105:1",164,"حَقِيقٌ","Obligated","","عَلَىٰٓ أَن لَّآ",3190],["7:105:9",164,"ٱلْحَقَّ ۚ","the truth","عَلَى ٱللَّهِ إِلَّا","قَدْ جِئْتُكُم بِبَيِّنَةٍۢ",50],["7:118:2",164,"ٱلْحَقُّ","the truth","فَوَقَعَ","وَبَطَلَ مَا كَانُوا۟",50],["7:146:9",168,"ٱلْحَقِّ","[the] right","فِى ٱلْأَرْضِ بِغَيْرِ","وَإِن يَرَوْا۟ كُلَّ",50],["7:159:6",170,"بِٱلْحَقِّ","with truth","مُوسَىٰٓ أُمَّةٌۭ يَهْدُونَ","وَبِهِۦ يَعْدِلُونَ",50],["7:169:30",172,"ٱلْحَقَّ","the truth","عَلَى ٱللَّهِ إِلَّا","وَدَرَسُوا۟ مَا فِيهِ ۗ",50],["7:181:5",174,"بِٱلْحَقِّ","with the truth","خَلَقْنَآ أُمَّةٌۭ يَهْدُونَ","وَبِهِۦ يَعْدِلُونَ",50],["8:4:4",177,"حَقًّۭا ۚ","(in) truth","أُو۟لَـٰٓئِكَ هُمُ ٱلْمُؤْمِنُونَ","لَّهُمْ دَرَجَـٰتٌ عِندَ",50],["8:5:6",177,"بِٱلْحَقِّ","in truth","رَبُّكَ مِنۢ بَيْتِكَ","وَإِنَّ فَرِيقًۭا مِّنَ",50],["8:6:3",177,"ٱلْحَقِّ","the truth","يُجَـٰدِلُونَكَ فِى","بَعْدَ مَا تَبَيَّنَ كَأَنَّمَا",50],["8:7:18",177,"يُحِقَّ","justify","وَيُرِيدُ ٱللَّهُ أَن","ٱلْحَقَّ بِكَلِمَـٰتِهِۦ وَيَقْطَعَ",1681],["8:7:19",177,"ٱلْحَقَّ","the truth","ٱللَّهُ أَن يُحِقَّ","بِكَلِمَـٰتِهِۦ وَيَقْطَعَ دَابِرَ",50],["8:8:1",177,"لِيُحِقَّ","That He might justify","","ٱلْحَقَّ وَيُبْطِلَ ٱلْبَـٰطِلَ",1681],["8:8:2",177,"ٱلْحَقَّ","the truth","لِيُحِقَّ","وَيُبْطِلَ ٱلْبَـٰطِلَ وَلَوْ",50],["8:32:8",180,"ٱلْحَقَّ","the truth","كَانَ هَـٰذَا هُوَ","مِنْ عِندِكَ فَأَمْطِرْ",50],["8:74:14",186,"حَقًّۭا ۚ","(in) truth","أُو۟لَـٰٓئِكَ هُمُ ٱلْمُؤْمِنُونَ","لَّهُم مَّغْفِرَةٌۭ وَرِزْقٌۭ",50],["9:13:15",188,"أَحَقُّ","(has) more right","مَرَّةٍ ۚ أَتَخْشَوْنَهُمْ ۚ فَٱللَّهُ","أَن تَخْشَوْهُ إِن",814],["9:29:18",191,"ٱلْحَقِّ","(of) the truth","وَلَا يَدِينُونَ دِينَ","مِنَ ٱلَّذِينَ أُوتُوا۟",50],["9:33:7",192,"ٱلْحَقِّ","(of) [the] truth","رَسُولَهُۥ بِٱلْهُدَىٰ وَدِينِ","لِيُظْهِرَهُۥ عَلَى ٱلدِّينِ",50],["9:48:11",195,"ٱلْحَقُّ","the truth","ٱلْأُمُورَ حَتَّىٰ جَآءَ","وَظَهَرَ أَمْرُ ٱللَّهِ",50],["9:62:7",197,"أَحَقُّ","(have) more right","لِيُرْضُوكُمْ وَٱللَّهُ وَرَسُولُهُۥٓ","أَن يُرْضُوهُ إِن",814],["9:108:12",204,"أَحَقُّ","(is) more worthy","مِنْ أَوَّلِ يَوْمٍ","أَن تَقُومَ فِيهِ ۚ",814],["9:111:19",204,"حَقًّۭا","true","وَيُقْتَلُونَ ۖ وَعْدًا عَلَيْهِ","فِى ٱلتَّوْرَىٰةِ وَٱلْإِنجِيلِ",50],["10:4:6",208,"حَقًّا ۚ","(is) true","جَمِيعًۭا ۖ وَعْدَ ٱللَّهِ","إِنَّهُۥ يَبْدَؤُا۟ ٱلْخَلْقَ",50],["10:5:19",208,"بِٱلْحَقِّ ۚ","in truth","ٱللَّهُ ذَٰلِكَ إِلَّا","يُفَصِّلُ ٱلْـَٔايَـٰتِ لِقَوْمٍۢ",50],["10:23:9",211,"ٱلْحَقِّ ۗ","[the] right","فِى ٱلْأَرْضِ بِغَيْرِ","يَـٰٓأَيُّهَا ٱلنَّاسُ إِنَّمَا",50],["10:30:11",212,"ٱلْحَقِّ ۖ","the true","إِلَى ٱللَّهِ مَوْلَىٰهُمُ","وَضَلَّ عَنْهُم مَّا",50],["10:32:4",212,"ٱلْحَقُّ ۖ","the true","فَذَٰلِكُمُ ٱللَّهُ رَبُّكُمُ","فَمَاذَا بَعْدَ ٱلْحَقِّ",50],["10:32:7",212,"ٱلْحَقِّ","the truth","ٱلْحَقُّ ۖ فَمَاذَا بَعْدَ","إِلَّا ٱلضَّلَـٰلُ ۖ فَأَنَّىٰ",50],["10:33:2",212,"حَقَّتْ","(is) proved true","كَذَٰلِكَ","كَلِمَتُ رَبِّكَ عَلَى",508],["10:35:8",213,"ٱلْحَقِّ ۚ","the truth","مَّن يَهْدِىٓ إِلَى","قُلِ ٱللَّهُ يَهْدِى",50],["10:35:12",213,"لِلْحَقِّ ۗ","to the truth","قُلِ ٱللَّهُ يَهْدِى","أَفَمَن يَهْدِىٓ إِلَى",50],["10:35:16",213,"ٱلْحَقِّ","the truth","أَفَمَن يَهْدِىٓ إِلَى","أَحَقُّ أَن يُتَّبَعَ",50],["10:35:17",213,"أَحَقُّ","more worthy","يَهْدِىٓ إِلَى ٱلْحَقِّ","أَن يُتَّبَعَ أَمَّن",814],["10:36:11",213,"ٱلْحَقِّ","the truth","لَا يُغْنِى مِنَ","شَيْـًٔا ۚ إِنَّ ٱللَّهَ",50],["10:53:2",214,"أَحَقٌّ","Is it true","۞ وَيَسْتَنۢبِـُٔونَكَ","هُوَ ۖ قُلْ إِى",50],["10:53:8",214,"لَحَقٌّۭ ۖ","(is) surely the truth","إِى وَرَبِّىٓ إِنَّهُۥ","وَمَآ أَنتُم بِمُعْجِزِينَ",50],["10:55:12",215,"حَقٌّۭ","(is) true","إِنَّ وَعْدَ ٱللَّهِ","وَلَـٰكِنَّ أَكْثَرَهُمْ لَا",50],["10:76:3",217,"ٱلْحَقُّ","the truth","فَلَمَّا جَآءَهُمُ","مِنْ عِندِنَا قَالُوٓا۟",50],["10:77:4",217,"لِلْحَقِّ","about the truth","قَالَ مُوسَىٰٓ أَتَقُولُونَ","لَمَّا جَآءَكُمْ ۖ أَسِحْرٌ",50],["10:82:1",218,"وَيُحِقُّ","And Allah will establish","","ٱللَّهُ ٱلْحَقَّ بِكَلِمَـٰتِهِۦ",1681],["10:82:3",218,"ٱلْحَقَّ","the truth","وَيُحِقُّ ٱللَّهُ","بِكَلِمَـٰتِهِۦ وَلَوْ كَرِهَ",50],["10:94:16",219,"ٱلْحَقُّ","the truth","قَبْلِكَ ۚ لَقَدْ جَآءَكَ","مِن رَّبِّكَ فَلَا",50],["10:96:3",219,"حَقَّتْ","has become due","إِنَّ ٱلَّذِينَ","عَلَيْهِمْ كَلِمَتُ رَبِّكَ",508],["10:103:7",220,"حَقًّا","(it is) an obligation","وَٱلَّذِينَ ءَامَنُوا۟ ۚ كَذَٰلِكَ","عَلَيْنَا نُنجِ ٱلْمُؤْمِنِينَ",50],["10:108:6",221,"ٱلْحَقُّ","the truth","ٱلنَّاسُ قَدْ جَآءَكُمُ","مِن رَّبِّكُمْ ۖ فَمَنِ",50],["11:17:32",223,"ٱلْحَقُّ","(is) the truth","مِرْيَةٍۢ مِّنْهُ ۚ إِنَّهُ","مِن رَّبِّكَ وَلَـٰكِنَّ",50],["11:45:12",226,"ٱلْحَقُّ","(is) true","أَهْلِى وَإِنَّ وَعْدَكَ","وَأَنتَ أَحْكَمُ ٱلْحَـٰكِمِينَ",50],["11:79:9",230,"حَقٍّۢ","right","فِى بَنَاتِكَ مِنْ","وَإِنَّكَ لَتَعْلَمُ مَا",50],["11:120:14",235,"ٱلْحَقُّ","the truth","وَجَآءَكَ فِى هَـٰذِهِ","وَمَوْعِظَةٌۭ وَذِكْرَىٰ لِلْمُؤْمِنِينَ",50],["12:51:22",241,"ٱلْحَقُّ","the truth","ٱلْعَزِيزِ ٱلْـَٔـٰنَ حَصْحَصَ","أَنَا۠ رَٰوَدتُّهُۥ عَن",50],["12:100:18",247,"حَقًّۭا ۖ","true","قَدْ جَعَلَهَا رَبِّى","وَقَدْ أَحْسَنَ بِىٓ",50],["13:1:10",249,"ٱلْحَقُّ","(is) the truth","إِلَيْكَ مِن رَّبِّكَ","وَلَـٰكِنَّ أَكْثَرَ ٱلنَّاسِ",50],["13:14:3",251,"ٱلْحَقِّ ۖ","(of) the truth","لَهُۥ دَعْوَةُ","وَٱلَّذِينَ يَدْعُونَ مِن",50],["13:17:26",251,"ٱلْحَقَّ","the truth","كَذَٰلِكَ يَضْرِبُ ٱللَّهُ","وَٱلْبَـٰطِلَ ۚ فَأَمَّا ٱلزَّبَدُ",50],["13:19:8",252,"ٱلْحَقُّ","(is) the truth","إِلَيْكَ مِن رَّبِّكَ","كَمَنْ هُوَ أَعْمَىٰٓ ۚ",50],["14:19:8",258,"بِٱلْحَقِّ ۚ","in truth","خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","إِن يَشَأْ يُذْهِبْكُمْ",50],["14:22:10",258,"ٱلْحَقِّ","(of) truth","ٱللَّهَ وَعَدَكُمْ وَعْدَ","وَوَعَدتُّكُمْ فَأَخْلَفْتُكُمْ ۖ وَمَا",50],["15:8:5",262,"بِٱلْحَقِّ","with the truth","نُنَزِّلُ ٱلْمَلَـٰٓئِكَةَ إِلَّا","وَمَا كَانُوٓا۟ إِذًۭا",50],["15:55:3",265,"بِٱلْحَقِّ","in truth","قَالُوا۟ بَشَّرْنَـٰكَ","فَلَا تَكُن مِّنَ",50],["15:64:2",265,"بِٱلْحَقِّ","with the truth","وَأَتَيْنَـٰكَ","وَإِنَّا لَصَـٰدِقُونَ",50],["15:85:8",266,"بِٱلْحَقِّ ۗ","in truth","وَمَا بَيْنَهُمَآ إِلَّا","وَإِنَّ ٱلسَّاعَةَ لَـَٔاتِيَةٌۭ ۖ",50],["16:3:4",267,"بِٱلْحَقِّ ۚ","in truth","خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","تَعَـٰلَىٰ عَمَّا يُشْرِكُونَ",50],["16:36:18",271,"حَقَّتْ","was justified","ٱللَّهُ وَمِنْهُم مَّنْ","عَلَيْهِ ٱلضَّلَـٰلَةُ ۚ فَسِيرُوا۟",508],["16:38:13",271,"حَقًّۭا","(in) truth","بَلَىٰ وَعْدًا عَلَيْهِ","وَلَـٰكِنَّ أَكْثَرَ ٱلنَّاسِ",50],["16:102:7",278,"بِٱلْحَقِّ","in truth","ٱلْقُدُسِ مِن رَّبِّكَ","لِيُثَبِّتَ ٱلَّذِينَ ءَامَنُوا۟",50],["17:16:10",283,"فَحَقَّ","so (is) proved true","مُتْرَفِيهَا فَفَسَقُوا۟ فِيهَا","عَلَيْهَا ٱلْقَوْلُ فَدَمَّرْنَـٰهَا",508],["17:26:4",284,"حَقَّهُۥ","his right","وَءَاتِ ذَا ٱلْقُرْبَىٰ","وَٱلْمِسْكِينَ وَٱبْنَ ٱلسَّبِيلِ",50],["17:33:8",285,"بِٱلْحَقِّ ۗ","by right","حَرَّمَ ٱللَّهُ إِلَّا","وَمَن قُتِلَ مَظْلُومًۭا",50],["17:81:3",290,"ٱلْحَقُّ","the truth","وَقُلْ جَآءَ","وَزَهَقَ ٱلْبَـٰطِلُ ۚ إِنَّ",50],["17:105:1",293,"وَبِٱلْحَقِّ","And with the truth","","أَنزَلْنَـٰهُ وَبِٱلْحَقِّ نَزَلَ ۗ",50],["17:105:3",293,"وَبِٱلْحَقِّ","and with the truth","وَبِٱلْحَقِّ أَنزَلْنَـٰهُ","نَزَلَ ۗ وَمَآ أَرْسَلْنَـٰكَ",50],["18:13:5",294,"بِٱلْحَقِّ ۚ","in truth","نَقُصُّ عَلَيْكَ نَبَأَهُم","إِنَّهُمْ فِتْيَةٌ ءَامَنُوا۟",50],["18:21:8",296,"حَقٌّۭ","(is) true","أَنَّ وَعْدَ ٱللَّهِ","وَأَنَّ ٱلسَّاعَةَ لَا",50],["18:29:2",297,"ٱلْحَقُّ","The truth","وَقُلِ","مِن رَّبِّكُمْ ۖ فَمَن",50],["18:44:4",298,"ٱلْحَقِّ ۚ","the True","هُنَالِكَ ٱلْوَلَـٰيَةُ لِلَّهِ","هُوَ خَيْرٌۭ ثَوَابًۭا",50],["18:56:13",300,"ٱلْحَقَّ ۖ","the truth","بِٱلْبَـٰطِلِ لِيُدْحِضُوا۟ بِهِ","وَٱتَّخَذُوٓا۟ ءَايَـٰتِى وَمَآ",50],["18:98:15",304,"حَقًّۭا","true","وَكَانَ وَعْدُ رَبِّى","",50],["19:34:6",307,"ٱلْحَقِّ","(of) truth","ٱبْنُ مَرْيَمَ ۚ قَوْلَ","ٱلَّذِى فِيهِ يَمْتَرُونَ",50],["20:114:4",320,"ٱلْحَقُّ ۗ","the True","فَتَعَـٰلَى ٱللَّهُ ٱلْمَلِكُ","وَلَا تَعْجَلْ بِٱلْقُرْءَانِ",50],["21:18:3",323,"بِٱلْحَقِّ","the truth","بَلْ نَقْذِفُ","عَلَى ٱلْبَـٰطِلِ فَيَدْمَغُهُۥ",50],["21:24:20",323,"ٱلْحَقَّ ۖ","the truth","أَكْثَرُهُمْ لَا يَعْلَمُونَ","فَهُم مُّعْرِضُونَ",50],["21:55:3",326,"بِٱلْحَقِّ","with the truth","قَالُوٓا۟ أَجِئْتَنَا","أَمْ أَنتَ مِنَ",50],["21:97:3",330,"ٱلْحَقُّ","[the] true","وَٱقْتَرَبَ ٱلْوَعْدُ","فَإِذَا هِىَ شَـٰخِصَةٌ",50],["21:112:4",331,"بِٱلْحَقِّ ۗ","in truth","قَـٰلَ رَبِّ ٱحْكُم","وَرَبُّنَا ٱلرَّحْمَـٰنُ ٱلْمُسْتَعَانُ",50],["22:6:5",333,"ٱلْحَقُّ","(is) the Truth","بِأَنَّ ٱللَّهَ هُوَ","وَأَنَّهُۥ يُحْىِ ٱلْمَوْتَىٰ",50],["22:18:23",334,"حَقَّ","(is) justly due","مِّنَ ٱلنَّاسِ ۖ وَكَثِيرٌ","عَلَيْهِ ٱلْعَذَابُ ۗ وَمَن",508],["22:40:6",337,"حَقٍّ","right","مِن دِيَـٰرِهِم بِغَيْرِ","إِلَّآ أَن يَقُولُوا۟",50],["22:54:6",338,"ٱلْحَقُّ","(is) the truth","أُوتُوا۟ ٱلْعِلْمَ أَنَّهُ","مِن رَّبِّكَ فَيُؤْمِنُوا۟",50],["22:62:5",339,"ٱلْحَقُّ","(is) the Truth","بِأَنَّ ٱللَّهَ هُوَ","وَأَنَّ مَا يَدْعُونَ",50],["22:74:4",341,"حَقَّ","(with) due","مَا قَدَرُوا۟ ٱللَّهَ","قَدْرِهِۦٓ ۗ إِنَّ ٱللَّهَ",50],["22:78:4",341,"حَقَّ","(with the) striving due (to) Him","وَجَـٰهِدُوا۟ فِى ٱللَّهِ","جِهَادِهِۦ ۚ هُوَ ٱجْتَبَىٰكُمْ",50],["23:41:3",344,"بِٱلْحَقِّ","in truth","فَأَخَذَتْهُمُ ٱلصَّيْحَةُ","فَجَعَلْنَـٰهُمْ غُثَآءًۭ ۚ فَبُعْدًۭا",50],["23:62:9",346,"بِٱلْحَقِّ ۚ","with the truth","وَلَدَيْنَا كِتَـٰبٌۭ يَنطِقُ","وَهُمْ لَا يُظْلَمُونَ",50],["23:70:7",346,"بِٱلْحَقِّ","the truth","جِنَّةٌۢ ۚ بَلْ جَآءَهُم","وَأَكْثَرُهُمْ لِلْحَقِّ كَـٰرِهُونَ",50],["23:70:9",346,"لِلْحَقِّ","to the truth","جَآءَهُم بِٱلْحَقِّ وَأَكْثَرُهُمْ","كَـٰرِهُونَ",50],["23:71:3",346,"ٱلْحَقُّ","the truth","وَلَوِ ٱتَّبَعَ","أَهْوَآءَهُمْ لَفَسَدَتِ ٱلسَّمَـٰوَٰتُ",50],["23:90:3",348,"بِٱلْحَقِّ","the truth","بَلْ أَتَيْنَـٰهُم","وَإِنَّهُمْ لَكَـٰذِبُونَ",50],["23:116:4",349,"ٱلْحَقُّ ۖ","the Truth","فَتَعَـٰلَى ٱللَّهُ ٱلْمَلِكُ","لَآ إِلَـٰهَ إِلَّا",50],["24:25:5",352,"ٱلْحَقَّ","the due","يُوَفِّيهِمُ ٱللَّهُ دِينَهُمُ","وَيَعْلَمُونَ أَنَّ ٱللَّهَ",50],["24:25:10",352,"ٱلْحَقُّ","(is) the Truth","أَنَّ ٱللَّهَ هُوَ","ٱلْمُبِينُ",50],["24:49:4",356,"ٱلْحَقُّ","the truth","وَإِن يَكُن لَّهُمُ","يَأْتُوٓا۟ إِلَيْهِ مُذْعِنِينَ",50],["25:26:3",362,"ٱلْحَقُّ","(will be) truly","ٱلْمُلْكُ يَوْمَئِذٍ","لِلرَّحْمَـٰنِ ۚ وَكَانَ يَوْمًا",50],["25:33:6",363,"بِٱلْحَقِّ","the truth","بِمَثَلٍ إِلَّا جِئْنَـٰكَ","وَأَحْسَنَ تَفْسِيرًا",50],["25:68:15",366,"بِٱلْحَقِّ","by right","حَرَّمَ ٱللَّهُ إِلَّا","وَلَا يَزْنُونَ ۚ وَمَن",50],["27:79:6",384,"ٱلْحَقِّ","the truth","ٱللَّهِ ۖ إِنَّكَ عَلَى","ٱلْمُبِينِ",50],["28:3:7",385,"بِٱلْحَقِّ","in truth","نَّبَإِ مُوسَىٰ وَفِرْعَوْنَ","لِقَوْمٍۢ يُؤْمِنُونَ",50],["28:13:13",386,"حَقٌّۭ","(is) true","أَنَّ وَعْدَ ٱللَّهِ","وَلَـٰكِنَّ أَكْثَرَهُمْ لَا",50],["28:39:7",390,"ٱلْحَقِّ","right","فِى ٱلْأَرْضِ بِغَيْرِ","وَظَنُّوٓا۟ أَنَّهُمْ إِلَيْنَا",50],["28:48:3",391,"ٱلْحَقُّ","the truth","فَلَمَّا جَآءَهُمُ","مِنْ عِندِنَا قَالُوا۟",50],["28:53:8",392,"ٱلْحَقُّ","(is) the truth","ءَامَنَّا بِهِۦٓ إِنَّهُ","مِن رَّبِّنَآ إِنَّا",50],["28:63:3",393,"حَقَّ","(has) come true","قَالَ ٱلَّذِينَ","عَلَيْهِمُ ٱلْقَوْلُ رَبَّنَا",508],["28:75:11",394,"ٱلْحَقَّ","the truth","بُرْهَـٰنَكُمْ فَعَلِمُوٓا۟ أَنَّ","لِلَّهِ وَضَلَّ عَنْهُم",50],["29:44:5",401,"بِٱلْحَقِّ ۚ","in truth","ٱللَّهُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","إِنَّ فِى ذَٰلِكَ",50],["29:68:10",404,"بِٱلْحَقِّ","the truth","كَذِبًا أَوْ كَذَّبَ","لَمَّا جَآءَهُۥٓ ۚ أَلَيْسَ",50],["30:8:13",405,"بِٱلْحَقِّ","in truth","وَمَا بَيْنَهُمَآ إِلَّا","وَأَجَلٍۢ مُّسَمًّۭى ۗ وَإِنَّ",50],["30:38:4",408,"حَقَّهُۥ","his right","فَـَٔاتِ ذَا ٱلْقُرْبَىٰ","وَٱلْمِسْكِينَ وَٱبْنَ ٱلسَّبِيلِ ۚ",50],["30:47:15",409,"حَقًّا","incumbent","ٱلَّذِينَ أَجْرَمُوا۟ ۖ وَكَانَ","عَلَيْنَا نَصْرُ ٱلْمُؤْمِنِينَ",50],["30:60:5",410,"حَقٌّۭ ۖ","(is) true","إِنَّ وَعْدَ ٱللَّهِ","وَلَا يَسْتَخِفَّنَّكَ ٱلَّذِينَ",50],["31:9:5",411,"حَقًّۭا ۚ","(is) true","فِيهَا ۖ وَعْدَ ٱللَّهِ","وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ",50],["31:30:5",414,"ٱلْحَقُّ","(is) the Truth","بِأَنَّ ٱللَّهَ هُوَ","وَأَنَّ مَا يَدْعُونَ",50],["31:33:22",414,"حَقٌّۭ ۖ","(is) True","إِنَّ وَعْدَ ٱللَّهِ","فَلَا تَغُرَّنَّكُمُ ٱلْحَيَوٰةُ",50],["32:3:6",415,"ٱلْحَقُّ","(is) the truth","ٱفْتَرَىٰهُ ۚ بَلْ هُوَ","مِن رَّبِّكَ لِتُنذِرَ",50],["32:13:8",416,"حَقَّ","(is) true","نَفْسٍ هُدَىٰهَا وَلَـٰكِنْ","ٱلْقَوْلُ مِنِّى لَأَمْلَأَنَّ",508],["33:4:25",418,"ٱلْحَقَّ","the truth","بِأَفْوَٰهِكُمْ ۖ وَٱللَّهُ يَقُولُ","وَهُوَ يَهْدِى ٱلسَّبِيلَ",50],["33:37:23",423,"أَحَقُّ","has more right","وَتَخْشَى ٱلنَّاسَ وَٱللَّهُ","أَن تَخْشَىٰهُ ۖ فَلَمَّا",814],["33:53:38",425,"ٱلْحَقِّ ۚ","the truth","لَا يَسْتَحْىِۦ مِنَ","وَإِذَا سَأَلْتُمُوهُنَّ مَتَـٰعًۭا",50],["34:6:11",428,"ٱلْحَقَّ","(is) the Truth","مِن رَّبِّكَ هُوَ","وَيَهْدِىٓ إِلَىٰ صِرَٰطِ",50],["34:23:19",431,"ٱلْحَقَّ ۖ","The truth","قَالَ رَبُّكُمْ ۖ قَالُوا۟","وَهُوَ ٱلْعَلِىُّ ٱلْكَبِيرُ",50],["34:26:8",431,"بِٱلْحَقِّ","in truth","ثُمَّ يَفْتَحُ بَيْنَنَا","وَهُوَ ٱلْفَتَّاحُ ٱلْعَلِيمُ",50],["34:43:27",433,"لِلْحَقِّ","about the truth","وَقَالَ ٱلَّذِينَ كَفَرُوا۟","لَمَّا جَآءَهُمْ إِنْ",50],["34:48:5",433,"بِٱلْحَقِّ","the truth","إِنَّ رَبِّى يَقْذِفُ","عَلَّـٰمُ ٱلْغُيُوبِ",50],["34:49:3",434,"ٱلْحَقُّ","the truth","قُلْ جَآءَ","وَمَا يُبْدِئُ ٱلْبَـٰطِلُ",50],["35:5:6",435,"حَقٌّۭ ۖ","(is) true","إِنَّ وَعْدَ ٱللَّهِ","فَلَا تَغُرَّنَّكُمُ ٱلْحَيَوٰةُ",50],["35:24:3",437,"بِٱلْحَقِّ","with the truth","إِنَّآ أَرْسَلْنَـٰكَ","بَشِيرًۭا وَنَذِيرًۭا ۚ وَإِن",50],["35:31:7",438,"ٱلْحَقُّ","(is) the truth","مِنَ ٱلْكِتَـٰبِ هُوَ","مُصَدِّقًۭا لِّمَا بَيْنَ",50],["36:7:2",440,"حَقَّ","(has) proved true","لَقَدْ","ٱلْقَوْلُ عَلَىٰٓ أَكْثَرِهِمْ",508],["36:70:5",444,"وَيَحِقَّ","and may be proved true","مَن كَانَ حَيًّۭا","ٱلْقَوْلُ عَلَى ٱلْكَـٰفِرِينَ",508],["37:31:1",447,"فَحَقَّ","So has been proved true","","عَلَيْنَا قَوْلُ رَبِّنَآ ۖ",508],["37:37:3",447,"بِٱلْحَقِّ","the truth","بَلْ جَآءَ","وَصَدَّقَ ٱلْمُرْسَلِينَ",50],["38:14:6",453,"فَحَقَّ","so (was) just","إِلَّا كَذَّبَ ٱلرُّسُلَ","عِقَابِ",508],["38:22:17",454,"بِٱلْحَقِّ","in truth","بَعْضٍۢ فَٱحْكُم بَيْنَنَا","وَلَا تُشْطِطْ وَٱهْدِنَآ",50],["38:26:10",454,"بِٱلْحَقِّ","in truth","فَٱحْكُم بَيْنَ ٱلنَّاسِ","وَلَا تَتَّبِعِ ٱلْهَوَىٰ",50],["38:64:3",457,"لَحَقٌّۭ","(is) surely (the) truth","إِنَّ ذَٰلِكَ","تَخَاصُمُ أَهْلِ ٱلنَّارِ",50],["38:84:2",458,"فَٱلْحَقُّ","Then (it is) the truth","قَالَ","وَٱلْحَقَّ أَقُولُ",50],["38:84:3",458,"وَٱلْحَقَّ","and the truth","قَالَ فَٱلْحَقُّ","أَقُولُ",50],["39:2:5",458,"بِٱلْحَقِّ","in truth","أَنزَلْنَآ إِلَيْكَ ٱلْكِتَـٰبَ","فَٱعْبُدِ ٱللَّهَ مُخْلِصًۭا",50],["39:5:4",458,"بِٱلْحَقِّ ۖ","in [the] truth","خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","يُكَوِّرُ ٱلَّيْلَ عَلَى",50],["39:19:2",460,"حَقَّ","became due","أَفَمَنْ","عَلَيْهِ كَلِمَةُ ٱلْعَذَابِ",508],["39:41:6",463,"بِٱلْحَقِّ ۖ","in truth","عَلَيْكَ ٱلْكِتَـٰبَ لِلنَّاسِ","فَمَنِ ٱهْتَدَىٰ فَلِنَفْسِهِۦ ۖ",50],["39:67:4",465,"حَقَّ","(with) true","وَمَا قَدَرُوا۟ ٱللَّهَ","قَدْرِهِۦ وَٱلْأَرْضُ جَمِيعًۭا",50],["39:69:12",466,"بِٱلْحَقِّ","in truth","وَٱلشُّهَدَآءِ وَقُضِىَ بَيْنَهُم","وَهُمْ لَا يُظْلَمُونَ",50],["39:71:30",466,"حَقَّتْ","has been justified","قَالُوا۟ بَلَىٰ وَلَـٰكِنْ","كَلِمَةُ ٱلْعَذَابِ عَلَى",508],["39:75:12",467,"بِٱلْحَقِّ","in truth","رَبِّهِمْ ۖ وَقُضِىَ بَيْنَهُم","وَقِيلَ ٱلْحَمْدُ لِلَّهِ",50],["40:5:17",467,"ٱلْحَقَّ","the truth","بِٱلْبَـٰطِلِ لِيُدْحِضُوا۟ بِهِ","فَأَخَذْتُهُمْ ۖ فَكَيْفَ كَانَ",50],["40:6:2",467,"حَقَّتْ","has been justified","وَكَذَٰلِكَ","كَلِمَتُ رَبِّكَ عَلَى",508],["40:20:3",469,"بِٱلْحَقِّ ۖ","in truth","وَٱللَّهُ يَقْضِى","وَٱلَّذِينَ يَدْعُونَ مِن",50],["40:25:3",469,"بِٱلْحَقِّ","the truth","فَلَمَّا جَآءَهُم","مِنْ عِندِنَا قَالُوا۟",50],["40:55:5",473,"حَقٌّۭ","(is) true","إِنَّ وَعْدَ ٱللَّهِ","وَٱسْتَغْفِرْ لِذَنۢبِكَ وَسَبِّحْ",50],["40:75:8",475,"ٱلْحَقِّ","right","فِى ٱلْأَرْضِ بِغَيْرِ","وَبِمَا كُنتُمْ تَمْرَحُونَ",50],["40:77:5",475,"حَقٌّۭ ۚ","(is) true","إِنَّ وَعْدَ ٱللَّهِ","فَإِمَّا نُرِيَنَّكَ بَعْضَ",50],["40:78:29",476,"بِٱلْحَقِّ","in truth","أَمْرُ ٱللَّهِ قُضِىَ","وَخَسِرَ هُنَالِكَ ٱلْمُبْطِلُونَ",50],["41:15:7",478,"ٱلْحَقِّ","[the] right","فِى ٱلْأَرْضِ بِغَيْرِ","وَقَالُوا۟ مَنْ أَشَدُّ",50],["41:25:11",479,"وَحَقَّ","and (is) justified","أَيْدِيهِمْ وَمَا خَلْفَهُمْ","عَلَيْهِمُ ٱلْقَوْلُ فِىٓ",508],["41:53:11",482,"ٱلْحَقُّ ۗ","(is) the truth","يَتَبَيَّنَ لَهُمْ أَنَّهُ","أَوَلَمْ يَكْفِ بِرَبِّكَ",50],["42:17:5",485,"بِٱلْحَقِّ","in truth","ٱلَّذِىٓ أَنزَلَ ٱلْكِتَـٰبَ","وَٱلْمِيزَانَ ۗ وَمَا يُدْرِيكَ",50],["42:18:13",485,"ٱلْحَقُّ ۗ","(is) the truth","مِنْهَا وَيَعْلَمُونَ أَنَّهَا","أَلَآ إِنَّ ٱلَّذِينَ",50],["42:24:16",486,"وَيُحِقُّ","and establishes","وَيَمْحُ ٱللَّهُ ٱلْبَـٰطِلَ","ٱلْحَقَّ بِكَلِمَـٰتِهِۦٓ ۚ إِنَّهُۥ",1681],["42:24:17",486,"ٱلْحَقَّ","the truth","ٱللَّهُ ٱلْبَـٰطِلَ وَيُحِقُّ","بِكَلِمَـٰتِهِۦٓ ۚ إِنَّهُۥ عَلِيمٌۢ",50],["42:42:11",487,"ٱلْحَقِّ ۚ","right","فِى ٱلْأَرْضِ بِغَيْرِ","أُو۟لَـٰٓئِكَ لَهُمْ عَذَابٌ",50],["43:29:7",491,"ٱلْحَقُّ","the truth","وَءَابَآءَهُمْ حَتَّىٰ جَآءَهُمُ","وَرَسُولٌۭ مُّبِينٌۭ",50],["43:30:3",491,"ٱلْحَقُّ","the truth","وَلَمَّا جَآءَهُمُ","قَالُوا۟ هَـٰذَا سِحْرٌۭ",50],["43:78:3",495,"بِٱلْحَقِّ","the truth","لَقَدْ جِئْنَـٰكُم","وَلَـٰكِنَّ أَكْثَرَكُمْ لِلْحَقِّ",50],["43:78:6",495,"لِلْحَقِّ","to the truth","بِٱلْحَقِّ وَلَـٰكِنَّ أَكْثَرَكُمْ","كَـٰرِهُونَ",50],["43:86:11",495,"بِٱلْحَقِّ","to the truth","إِلَّا مَن شَهِدَ","وَهُمْ يَعْلَمُونَ",50],["44:39:4",497,"بِٱلْحَقِّ","in [the] truth","مَا خَلَقْنَـٰهُمَآ إِلَّا","وَلَـٰكِنَّ أَكْثَرَهُمْ لَا",50],["45:6:6",499,"بِٱلْحَقِّ ۖ","in truth","ٱللَّهِ نَتْلُوهَا عَلَيْكَ","فَبِأَىِّ حَدِيثٍۭ بَعْدَ",50],["45:22:5",500,"بِٱلْحَقِّ","in truth","ٱللَّهُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","وَلِتُجْزَىٰ كُلُّ نَفْسٍۭ",50],["45:29:5",501,"بِٱلْحَقِّ ۚ","in truth","كِتَـٰبُنَا يَنطِقُ عَلَيْكُم","إِنَّا كُنَّا نَسْتَنسِخُ",50],["45:32:6",501,"حَقٌّۭ","(is) true","إِنَّ وَعْدَ ٱللَّهِ","وَٱلسَّاعَةُ لَا رَيْبَ",50],["46:3:8",502,"بِٱلْحَقِّ","in truth","وَمَا بَيْنَهُمَآ إِلَّا","وَأَجَلٍۢ مُّسَمًّۭى ۚ وَٱلَّذِينَ",50],["46:7:9",503,"لِلْحَقِّ","of the truth","قَالَ ٱلَّذِينَ كَفَرُوا۟","لَمَّا جَآءَهُمْ هَـٰذَا",50],["46:17:22",504,"حَقٌّۭ","(is) true","إِنَّ وَعْدَ ٱللَّهِ","فَيَقُولُ مَا هَـٰذَآ",50],["46:18:3",504,"حَقَّ","(has) proved true","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","عَلَيْهِمُ ٱلْقَوْلُ فِىٓ",508],["46:20:24",504,"ٱلْحَقِّ","[the] right","فِى ٱلْأَرْضِ بِغَيْرِ","وَبِمَا كُنتُمْ تَفْسُقُونَ",50],["46:30:16",506,"ٱلْحَقِّ","the truth","يَدَيْهِ يَهْدِىٓ إِلَى","وَإِلَىٰ طَرِيقٍۢ مُّسْتَقِيمٍۢ",50],["46:34:9",506,"بِٱلْحَقِّ ۖ","the truth","ٱلنَّارِ أَلَيْسَ هَـٰذَا","قَالُوا۟ بَلَىٰ وَرَبِّنَا ۚ",50],["47:2:11",507,"ٱلْحَقُّ","(is) the truth","عَلَىٰ مُحَمَّدٍۢ وَهُوَ","مِن رَّبِّهِمْ ۙ كَفَّرَ",50],["47:3:11",507,"ٱلْحَقَّ","(the) truth","ٱلَّذِينَ ءَامَنُوا۟ ٱتَّبَعُوا۟","مِن رَّبِّهِمْ ۚ كَذَٰلِكَ",50],["48:26:21",514,"أَحَقَّ","more deserving","كَلِمَةَ ٱلتَّقْوَىٰ وَكَانُوٓا۟","بِهَا وَأَهْلَهَا ۚ وَكَانَ",814],["48:27:6",514,"بِٱلْحَقِّ ۖ","in truth","ٱللَّهُ رَسُولَهُ ٱلرُّءْيَا","لَتَدْخُلُنَّ ٱلْمَسْجِدَ ٱلْحَرَامَ",50],["48:28:7",514,"ٱلْحَقِّ","the true","رَسُولَهُۥ بِٱلْهُدَىٰ وَدِينِ","لِيُظْهِرَهُۥ عَلَى ٱلدِّينِ",50],["50:5:3",518,"بِٱلْحَقِّ","the truth","بَلْ كَذَّبُوا۟","لَمَّا جَآءَهُمْ فَهُمْ",50],["50:14:8",518,"فَحَقَّ","so was fulfilled","كُلٌّۭ كَذَّبَ ٱلرُّسُلَ","وَعِيدِ",508],["50:19:4",519,"بِٱلْحَقِّ ۖ","in truth","وَجَآءَتْ سَكْرَةُ ٱلْمَوْتِ","ذَٰلِكَ مَا كُنتَ",50],["50:42:4",520,"بِٱلْحَقِّ ۚ","in truth","يَوْمَ يَسْمَعُونَ ٱلصَّيْحَةَ","ذَٰلِكَ يَوْمُ ٱلْخُرُوجِ",50],["51:19:3",521,"حَقٌّۭ","(was the) right","وَفِىٓ أَمْوَٰلِهِمْ","لِّلسَّآئِلِ وَٱلْمَحْرُومِ",50],["51:23:5",521,"لَحَقٌّۭ","(is) surely (the) truth","ٱلسَّمَآءِ وَٱلْأَرْضِ إِنَّهُۥ","مِّثْلَ مَآ أَنَّكُمْ",50],["53:28:15",527,"ٱلْحَقِّ","the truth","لَا يُغْنِى مِنَ","شَيْـًۭٔا",50],["56:95:4",537,"حَقُّ","(is the) truth","إِنَّ هَـٰذَا لَهُوَ","ٱلْيَقِينِ",50],["57:16:13",539,"ٱلْحَقِّ","the truth","وَمَا نَزَلَ مِنَ","وَلَا يَكُونُوا۟ كَٱلَّذِينَ",50],["57:27:30",541,"حَقَّ","(with) right","ٱللَّهِ فَمَا رَعَوْهَا","رِعَايَتِهَا ۖ فَـَٔاتَيْنَا ٱلَّذِينَ",50],["60:1:17",549,"ٱلْحَقِّ","the truth","بِمَا جَآءَكُم مِّنَ","يُخْرِجُونَ ٱلرَّسُولَ وَإِيَّاكُمْ ۙ",50],["61:9:7",552,"ٱلْحَقِّ","(of) the truth","رَسُولَهُۥ بِٱلْهُدَىٰ وَدِينِ","لِيُظْهِرَهُۥ عَلَى ٱلدِّينِ",50],["64:3:4",556,"بِٱلْحَقِّ","with truth","خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ ۖ",50],["69:1:1",566,"ٱلْحَآقَّةُ","The Inevitable Reality","","",1771],["69:2:2",566,"ٱلْحَآقَّةُ","(is) the Inevitable Reality","مَا","",1771],["69:3:4",566,"ٱلْحَآقَّةُ","(is) the Inevitable Reality","وَمَآ أَدْرَىٰكَ مَا","",1771],["69:51:2",568,"لَحَقُّ","surely (the) truth","وَإِنَّهُۥ","ٱلْيَقِينِ",50],["70:24:4",569,"حَقٌّۭ","(is) a right","وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ","مَّعْلُومٌۭ",50],["78:39:3",583,"ٱلْحَقُّ ۖ","the True","ذَٰلِكَ ٱلْيَوْمُ","فَمَن شَآءَ ٱتَّخَذَ",50],["84:2:3",589,"وَحُقَّتْ","and was obligated","وَأَذِنَتْ لِرَبِّهَا","",508],["84:5:3",589,"وَحُقَّتْ","and was obligated","وَأَذِنَتْ لِرَبِّهَا","",508],["103:3:7",601,"بِٱلْحَقِّ","to the truth","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟","وَتَوَاصَوْا۟ بِٱلصَّبْرِ",50]]