[["4:168:12",104,"طَرِيقًا","(to) a way","لَهُمْ وَلَا لِيَهْدِيَهُمْ","",1529],["4:169:2",104,"طَرِيقَ","(the) way","إِلَّا","جَهَنَّمَ خَـٰلِدِينَ فِيهَآ",1529],["20:63:12",315,"بِطَرِيقَتِكُمُ","with your way","أَرْضِكُم بِسِحْرِهِمَا وَيَذْهَبَا","ٱلْمُثْلَىٰ",1316],["20:77:10",317,"طَرِيقًۭا","a path","بِعِبَادِى فَٱضْرِبْ لَهُمْ","فِى ٱلْبَحْرِ يَبَسًۭا",1529],["20:104:8",319,"طَرِيقَةً","(in) conduct","إِذْ يَقُولُ أَمْثَلُهُمْ","إِن لَّبِثْتُمْ إِلَّا",1316],["23:17:5",342,"طَرَآئِقَ","paths","خَلَقْنَا فَوْقَكُمْ سَبْعَ","وَمَا كُنَّا عَنِ",1316],["46:30:18",506,"طَرِيقٍۢ","a Path","إِلَى ٱلْحَقِّ وَإِلَىٰ","مُّسْتَقِيمٍۢ",1529],["72:11:8",572,"طَرَآئِقَ","(are on) ways","دُونَ ذَٰلِكَ ۖ كُنَّا","قِدَدًۭا",1316],["72:16:4",573,"ٱلطَّرِيقَةِ","the Way","وَأَلَّوِ ٱسْتَقَـٰمُوا۟ عَلَى","لَأَسْقَيْنَـٰهُم مَّآءً غَدَقًۭا",1316],["86:1:2",591,"وَٱلطَّارِقِ","and the night comer","وَٱلسَّمَآءِ","",2312],["86:2:4",591,"ٱلطَّارِقُ","the night comer (is)","وَمَآ أَدْرَىٰكَ مَا","",2312]]