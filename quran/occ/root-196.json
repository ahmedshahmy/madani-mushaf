[["2:245:8",39,"فَيُضَـٰعِفَهُۥ","so (that) He multiplies it","ٱللَّهَ قَرْضًا حَسَنًۭا","لَهُۥٓ أَضْعَافًۭا كَثِيرَةًۭ ۚ",941],["2:245:10",39,"أَضْعَافًۭا","manifolds","حَسَنًۭا فَيُضَـٰعِفَهُۥ لَهُۥٓ","كَثِيرَةًۭ ۚ وَٱللَّهُ يَقْبِضُ",765],["2:261:19",44,"يُضَـٰعِفُ","gives manifold","مِّا۟ئَةُ حَبَّةٍۢ ۗ وَٱللَّهُ","لِمَن يَشَآءُ ۗ وَٱللَّهُ",941],["2:265:18",45,"ضِعْفَيْنِ","double","وَابِلٌۭ فَـَٔاتَتْ أُكُلَهَا","فَإِن لَّمْ يُصِبْهَا",765],["2:266:23",45,"ضُعَفَآءُ","(are) weak","ٱلْكِبَرُ وَلَهُۥ ذُرِّيَّةٌۭ","فَأَصَابَهَآ إِعْصَارٌۭ فِيهِ",957],["2:282:42",48,"ضَعِيفًا","weak","ٱلْحَقُّ سَفِيهًا أَوْ","أَوْ لَا يَسْتَطِيعُ",957],["3:130:7",66,"أَضْعَـٰفًۭا","doubled","لَا تَأْكُلُوا۟ ٱلرِّبَوٰٓا۟","مُّضَـٰعَفَةًۭ ۖ وَٱتَّقُوا۟ ٱللَّهَ",765],["3:130:8",66,"مُّضَـٰعَفَةًۭ ۖ","multiplied","تَأْكُلُوا۟ ٱلرِّبَوٰٓا۟ أَضْعَـٰفًۭا","وَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ",3952],["3:146:16",68,"ضَعُفُوا۟","they weakened","سَبِيلِ ٱللَّهِ وَمَا","وَمَا ٱسْتَكَانُوا۟ ۗ وَٱللَّهُ",2218],["4:9:8",78,"ضِعَـٰفًا","weak","مِنْ خَلْفِهِمْ ذُرِّيَّةًۭ","خَافُوا۟ عَلَيْهِمْ فَلْيَتَّقُوا۟",3080],["4:28:8",83,"ضَعِيفًۭا","weak","عَنكُمْ ۚ وَخُلِقَ ٱلْإِنسَـٰنُ","",957],["4:40:10",85,"يُضَـٰعِفْهَا","He doubles it","وَإِن تَكُ حَسَنَةًۭ","وَيُؤْتِ مِن لَّدُنْهُ",941],["4:75:8",90,"وَٱلْمُسْتَضْعَفِينَ","and (for) those who are weak","فِى سَبِيلِ ٱللَّهِ","مِنَ ٱلرِّجَالِ وَٱلنِّسَآءِ",1373],["4:76:20",90,"ضَعِيفًا","weak","كَيْدَ ٱلشَّيْطَـٰنِ كَانَ","",957],["4:97:12",94,"مُسْتَضْعَفِينَ","oppressed","كُنتُمْ ۖ قَالُوا۟ كُنَّا","فِى ٱلْأَرْضِ ۚ قَالُوٓا۟",1373],["4:98:2",94,"ٱلْمُسْتَضْعَفِينَ","the oppressed","إِلَّا","مِنَ ٱلرِّجَالِ وَٱلنِّسَآءِ",1373],["4:127:25",98,"وَٱلْمُسْتَضْعَفِينَ","and the ones who are weak","وَتَرْغَبُونَ أَن تَنكِحُوهُنَّ","مِنَ ٱلْوِلْدَٰنِ وَأَن",1373],["7:38:32",155,"ضِعْفًۭا","double","أَضَلُّونَا فَـَٔاتِهِمْ عَذَابًۭا","مِّنَ ٱلنَّارِ ۖ قَالَ",765],["7:38:37",155,"ضِعْفٌۭ","(is) a double","ٱلنَّارِ ۖ قَالَ لِكُلٍّۢ","وَلَـٰكِن لَّا تَعْلَمُونَ",765],["7:75:8",160,"ٱسْتُضْعِفُوا۟","were oppressed","مِن قَوْمِهِۦ لِلَّذِينَ","لِمَنْ ءَامَنَ مِنْهُمْ",1023],["7:137:5",166,"يُسْتَضْعَفُونَ","considered weak","ٱلْقَوْمَ ٱلَّذِينَ كَانُوا۟","مَشَـٰرِقَ ٱلْأَرْضِ وَمَغَـٰرِبَهَا",1023],["7:150:28",169,"ٱسْتَضْعَفُونِى","considered me weak","أُمَّ إِنَّ ٱلْقَوْمَ","وَكَادُوا۟ يَقْتُلُونَنِى فَلَا",1023],["8:26:5",180,"مُّسْتَضْعَفُونَ","(and) deemed weak","إِذْ أَنتُمْ قَلِيلٌۭ","فِى ٱلْأَرْضِ تَخَافُونَ",1373],["8:66:8",185,"ضَعْفًۭا ۚ","(there) is weakness","وَعَلِمَ أَنَّ فِيكُمْ","فَإِن يَكُن مِّنكُم",1493],["9:91:3",201,"ٱلضُّعَفَآءِ","the weak","لَّيْسَ عَلَى","وَلَا عَلَى ٱلْمَرْضَىٰ",957],["11:20:15",224,"يُضَـٰعَفُ","And will be doubled","ٱللَّهِ مِنْ أَوْلِيَآءَ ۘ","لَهُمُ ٱلْعَذَابُ ۚ مَا",941],["11:91:11",232,"ضَعِيفًۭا ۖ","weak","وَإِنَّا لَنَرَىٰكَ فِينَا","وَلَوْلَا رَهْطُكَ لَرَجَمْنَـٰكَ ۖ",957],["14:21:5",258,"ٱلضُّعَفَـٰٓؤُا۟","the weak","لِلَّهِ جَمِيعًۭا فَقَالَ","لِلَّذِينَ ٱسْتَكْبَرُوٓا۟ إِنَّا",957],["17:75:3",289,"ضِعْفَ","double","إِذًۭا لَّأَذَقْنَـٰكَ","ٱلْحَيَوٰةِ وَضِعْفَ ٱلْمَمَاتِ",765],["17:75:5",289,"وَضِعْفَ","and double","لَّأَذَقْنَـٰكَ ضِعْفَ ٱلْحَيَوٰةِ","ٱلْمَمَاتِ ثُمَّ لَا",765],["19:75:24",310,"وَأَضْعَفُ","and weaker","هُوَ شَرٌّۭ مَّكَانًۭا","جُندًۭا",2151],["22:73:26",341,"ضَعُفَ","So weak","لَّا يَسْتَنقِذُوهُ مِنْهُ ۚ","ٱلطَّالِبُ وَٱلْمَطْلُوبُ",2218],["25:69:1",366,"يُضَـٰعَفْ","Will be doubled","","لَهُ ٱلْعَذَابُ يَوْمَ",941],["28:4:9",385,"يَسْتَضْعِفُ","oppressing","وَجَعَلَ أَهْلَهَا شِيَعًۭا","طَآئِفَةًۭ مِّنْهُمْ يُذَبِّحُ",1023],["28:5:6",385,"ٱسْتُضْعِفُوا۟","were oppressed","نَّمُنَّ عَلَى ٱلَّذِينَ","فِى ٱلْأَرْضِ وَنَجْعَلَهُمْ",1023],["30:39:22",408,"ٱلْمُضْعِفُونَ","(will) get manifold","ٱللَّهِ فَأُو۟لَـٰٓئِكَ هُمُ","",3755],["30:54:5",410,"ضَعْفٍۢ","weakness","ٱلَّذِى خَلَقَكُم مِّن","ثُمَّ جَعَلَ مِنۢ",1493],["30:54:10",410,"ضَعْفٍۢ","weakness","جَعَلَ مِنۢ بَعْدِ","قُوَّةًۭ ثُمَّ جَعَلَ",1493],["30:54:17",410,"ضَعْفًۭا","weakness","مِنۢ بَعْدِ قُوَّةٍۢ","وَشَيْبَةًۭ ۚ يَخْلُقُ مَا",1493],["33:30:8",421,"يُضَـٰعَفْ","will be doubled","مِنكُنَّ بِفَـٰحِشَةٍۢ مُّبَيِّنَةٍۢ","لَهَا ٱلْعَذَابُ ضِعْفَيْنِ ۚ",941],["33:30:11",421,"ضِعْفَيْنِ ۚ","two fold","يُضَـٰعَفْ لَهَا ٱلْعَذَابُ","وَكَانَ ذَٰلِكَ عَلَى",765],["33:68:3",427,"ضِعْفَيْنِ","double","رَبَّنَآ ءَاتِهِمْ","مِنَ ٱلْعَذَابِ وَٱلْعَنْهُمْ",765],["34:31:26",431,"ٱسْتُضْعِفُوا۟","were oppressed","ٱلْقَوْلَ يَقُولُ ٱلَّذِينَ","لِلَّذِينَ ٱسْتَكْبَرُوا۟ لَوْلَآ",1023],["34:32:5",432,"ٱسْتُضْعِفُوٓا۟","who were oppressed","ٱلَّذِينَ ٱسْتَكْبَرُوا۟ لِلَّذِينَ","أَنَحْنُ صَدَدْنَـٰكُمْ عَنِ",1023],["34:33:3",432,"ٱسْتُضْعِفُوا۟","were oppressed","وَقَالَ ٱلَّذِينَ","لِلَّذِينَ ٱسْتَكْبَرُوا۟ بَلْ",1023],["34:37:17",432,"ٱلضِّعْفِ","two-fold","فَأُو۟لَـٰٓئِكَ لَهُمْ جَزَآءُ","بِمَا عَمِلُوا۟ وَهُمْ",765],["38:61:9",456,"ضِعْفًۭا","double","هَـٰذَا فَزِدْهُ عَذَابًۭا","فِى ٱلنَّارِ",765],["40:47:6",472,"ٱلضُّعَفَـٰٓؤُا۟","the weak","فِى ٱلنَّارِ فَيَقُولُ","لِلَّذِينَ ٱسْتَكْبَرُوٓا۟ إِنَّا",957],["57:11:8",538,"فَيُضَـٰعِفَهُۥ","so He will multiply it","ٱللَّهَ قَرْضًا حَسَنًۭا","لَهُۥ وَلَهُۥٓ أَجْرٌۭ",941],["57:18:8",539,"يُضَـٰعَفُ","it will be multiplied","ٱللَّهَ قَرْضًا حَسَنًۭا","لَهُمْ وَلَهُمْ أَجْرٌۭ",941],["64:17:6",557,"يُضَـٰعِفْهُ","He will multiply it","ٱللَّهَ قَرْضًا حَسَنًۭا","لَكُمْ وَيَغْفِرْ لَكُمْ ۚ",941],["72:24:8",573,"أَضْعَفُ","(is) weaker","يُوعَدُونَ فَسَيَعْلَمُونَ مَنْ","نَاصِرًۭا وَأَقَلُّ عَدَدًۭا",2151]]