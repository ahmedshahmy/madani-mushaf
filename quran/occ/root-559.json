[["2:164:36",25,"وَٱلسَّحَابِ","and the clouds","دَآبَّةٍۢ وَتَصْرِيفِ ٱلرِّيَـٰحِ","ٱلْمُسَخَّرِ بَيْنَ ٱلسَّمَآءِ",922],["7:57:12",157,"سَحَابًۭا","clouds","حَتَّىٰٓ إِذَآ أَقَلَّتْ","ثِقَالًۭا سُقْنَـٰهُ لِبَلَدٍۢ",922],["13:12:8",250,"ٱلسَّحَابَ","the clouds","خَوْفًۭا وَطَمَعًۭا وَيُنشِئُ","ٱلثِّقَالَ",922],["24:40:13",355,"سَحَابٌۭ ۚ","a cloud","مَوْجٌۭ مِّن فَوْقِهِۦ","ظُلُمَـٰتٌۢ بَعْضُهَا فَوْقَ",922],["24:43:6",355,"سَحَابًۭا","clouds","أَنَّ ٱللَّهَ يُزْجِى","ثُمَّ يُؤَلِّفُ بَيْنَهُۥ",922],["27:88:8",384,"ٱلسَّحَابِ ۚ","(of) the clouds","وَهِىَ تَمُرُّ مَرَّ","صُنْعَ ٱللَّهِ ٱلَّذِىٓ",922],["30:48:6",409,"سَحَابًۭا","(the) clouds","يُرْسِلُ ٱلرِّيَـٰحَ فَتُثِيرُ","فَيَبْسُطُهُۥ فِى ٱلسَّمَآءِ",922],["35:9:6",435,"سَحَابًۭا","(the) clouds","أَرْسَلَ ٱلرِّيَـٰحَ فَتُثِيرُ","فَسُقْنَـٰهُ إِلَىٰ بَلَدٍۢ",922],["40:71:6",475,"يُسْحَبُونَ","they will be dragged","فِىٓ أَعْنَـٰقِهِمْ وَٱلسَّلَـٰسِلُ","",2813],["52:44:8",525,"سَحَابٌۭ","Clouds","ٱلسَّمَآءِ سَاقِطًۭا يَقُولُوا۟","مَّرْكُومٌۭ",922],["54:48:2",530,"يُسْحَبُونَ","they will be dragged","يَوْمَ","فِى ٱلنَّارِ عَلَىٰ",2813]]