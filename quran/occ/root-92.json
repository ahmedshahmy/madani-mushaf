[["2:25:1",5,"وَبَشِّرِ","And give good news","","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",307],["2:97:17",15,"وَبُشْرَىٰ","and glad tiding(s)","بَيْنَ يَدَيْهِ وَهُدًۭى","لِلْمُؤْمِنِينَ",627],["2:119:4",18,"بَشِيرًۭا","(as) a bearer of good news","إِنَّآ أَرْسَلْنَـٰكَ بِٱلْحَقِّ","وَنَذِيرًۭا ۖ وَلَا تُسْـَٔلُ",895],["2:155:11",24,"وَبَشِّرِ","but give good news","ٱلْأَمْوَٰلِ وَٱلْأَنفُسِ وَٱلثَّمَرَٰتِ ۗ","ٱلصَّـٰبِرِينَ",307],["2:187:25",29,"بَـٰشِرُوهُنَّ","have relations with them","وَعَفَا عَنكُمْ ۖ فَٱلْـَٔـٰنَ","وَٱبْتَغُوا۟ مَا كَتَبَ",2328],["2:187:49",29,"تُبَـٰشِرُوهُنَّ","have relations with them","إِلَى ٱلَّيْلِ ۚ وَلَا","وَأَنتُمْ عَـٰكِفُونَ فِى",2328],["2:213:8",33,"مُبَشِّرِينَ","(as) bearers of glad tidings","فَبَعَثَ ٱللَّهُ ٱلنَّبِيِّـۧنَ","وَمُنذِرِينَ وَأَنزَلَ مَعَهُمُ",911],["2:223:15",35,"وَبَشِّرِ","And give glad tidings","وَٱعْلَمُوٓا۟ أَنَّكُم مُّلَـٰقُوهُ ۗ","ٱلْمُؤْمِنِينَ",307],["3:21:16",52,"فَبَشِّرْهُم","then give them tidings","بِٱلْقِسْطِ مِنَ ٱلنَّاسِ","بِعَذَابٍ أَلِيمٍ",307],["3:39:10",55,"يُبَشِّرُكَ","gives you glad tidings","ٱلْمِحْرَابِ أَنَّ ٱللَّهَ","بِيَحْيَىٰ مُصَدِّقًۢا بِكَلِمَةٍۢ",307],["3:45:7",55,"يُبَشِّرُكِ","gives you glad tidings","يَـٰمَرْيَمُ إِنَّ ٱللَّهَ","بِكَلِمَةٍۢ مِّنْهُ ٱسْمُهُ",307],["3:47:9",56,"بَشَرٌۭ ۖ","any man","وَلَدٌۭ وَلَمْ يَمْسَسْنِى","قَالَ كَذَٰلِكِ ٱللَّهُ",315],["3:79:3",60,"لِبَشَرٍ","for a human","مَا كَانَ","أَن يُؤْتِيَهُ ٱللَّهُ",315],["3:126:5",66,"بُشْرَىٰ","(as) good news","جَعَلَهُ ٱللَّهُ إِلَّا","لَكُمْ وَلِتَطْمَئِنَّ قُلُوبُكُم",627],["3:170:7",72,"وَيَسْتَبْشِرُونَ","and they receive good tidings","ٱللَّهُ مِن فَضْلِهِۦ","بِٱلَّذِينَ لَمْ يَلْحَقُوا۟",1114],["3:171:1",72,"۞ يَسْتَبْشِرُونَ","They receive good tidings","","بِنِعْمَةٍۢ مِّنَ ٱللَّهِ",1114],["4:138:1",100,"بَشِّرِ","Give tidings","","ٱلْمُنَـٰفِقِينَ بِأَنَّ لَهُمْ",307],["4:165:2",104,"مُّبَشِّرِينَ","bearers of glad tidings","رُّسُلًۭا","وَمُنذِرِينَ لِئَلَّا يَكُونَ",911],["5:18:14",111,"بَشَرٌۭ","human beings","بِذُنُوبِكُم ۖ بَلْ أَنتُم","مِّمَّنْ خَلَقَ ۚ يَغْفِرُ",315],["5:19:17",111,"بَشِيرٍۢ","bearer of glad tidings","مَا جَآءَنَا مِنۢ","وَلَا نَذِيرٍۢ ۖ فَقَدْ",895],["5:19:22",111,"بَشِيرٌۭ","a bearer of glad tidings","نَذِيرٍۢ ۖ فَقَدْ جَآءَكُم","وَنَذِيرٌۭ ۗ وَٱللَّهُ عَلَىٰ",895],["6:48:5",133,"مُبَشِّرِينَ","(as) bearer of glad tidings","نُرْسِلُ ٱلْمُرْسَلِينَ إِلَّا","وَمُنذِرِينَ ۖ فَمَنْ ءَامَنَ",911],["6:91:12",139,"بَشَرٍۢ","a human being","أَنزَلَ ٱللَّهُ عَلَىٰ","مِّن شَىْءٍۢ ۗ قُلْ",315],["7:57:5",157,"بُشْرًۢا","(as) glad tidings","ٱلَّذِى يُرْسِلُ ٱلرِّيَـٰحَ","بَيْنَ يَدَىْ رَحْمَتِهِۦ ۖ",1818],["7:188:26",175,"وَبَشِيرٌۭ","and a bearer of good tidings","أَنَا۠ إِلَّا نَذِيرٌۭ","لِّقَوْمٍۢ يُؤْمِنُونَ",895],["8:10:5",178,"بُشْرَىٰ","good tidings","جَعَلَهُ ٱللَّهُ إِلَّا","وَلِتَطْمَئِنَّ بِهِۦ قُلُوبُكُمْ ۚ",627],["9:3:28",187,"وَبَشِّرِ","And give glad tidings","غَيْرُ مُعْجِزِى ٱللَّهِ ۗ","ٱلَّذِينَ كَفَرُوا۟ بِعَذَابٍ",307],["9:21:1",190,"يُبَشِّرُهُمْ","Their Lord gives them glad tidings","","رَبُّهُم بِرَحْمَةٍۢ مِّنْهُ",307],["9:34:26",192,"فَبَشِّرْهُم","[so] give them tidings","فِى سَبِيلِ ٱللَّهِ","بِعَذَابٍ أَلِيمٍۢ",307],["9:111:29",204,"فَٱسْتَبْشِرُوا۟","So rejoice","بِعَهْدِهِۦ مِنَ ٱللَّهِ ۚ","بِبَيْعِكُمُ ٱلَّذِى بَايَعْتُم",1114],["9:112:15",205,"وَبَشِّرِ","And give glad tidings","وَٱلْحَـٰفِظُونَ لِحُدُودِ ٱللَّهِ ۗ","ٱلْمُؤْمِنِينَ",307],["9:124:18",207,"يَسْتَبْشِرُونَ","rejoice","فَزَادَتْهُمْ إِيمَـٰنًۭا وَهُمْ","",1114],["10:2:12",208,"وَبَشِّرِ","and give glad tidings","أَنْ أَنذِرِ ٱلنَّاسَ","ٱلَّذِينَ ءَامَنُوٓا۟ أَنَّ",307],["10:64:2",216,"ٱلْبُشْرَىٰ","(are) the glad tidings","لَهُمُ","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا",627],["10:87:15",218,"وَبَشِّرِ","And give glad tidings","قِبْلَةًۭ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ ۗ","ٱلْمُؤْمِنِينَ",307],["11:2:9",221,"وَبَشِيرٌۭ","and a bearer of glad tidings","لَكُم مِّنْهُ نَذِيرٌۭ","",895],["11:27:10",224,"بَشَرًۭا","a man","مَا نَرَىٰكَ إِلَّا","مِّثْلَنَا وَمَا نَرَىٰكَ",315],["11:69:5",229,"بِٱلْبُشْرَىٰ","with glad tidings","جَآءَتْ رُسُلُنَآ إِبْرَٰهِيمَ","قَالُوا۟ سَلَـٰمًۭا ۖ قَالَ",627],["11:71:4",229,"فَبَشَّرْنَـٰهَا","Then We gave her glad tidings","وَٱمْرَأَتُهُۥ قَآئِمَةٌۭ فَضَحِكَتْ","بِإِسْحَـٰقَ وَمِن وَرَآءِ",307],["11:74:7",230,"ٱلْبُشْرَىٰ","the glad tidings","إِبْرَٰهِيمَ ٱلرَّوْعُ وَجَآءَتْهُ","يُجَـٰدِلُنَا فِى قَوْمِ",627],["12:19:8",237,"يَـٰبُشْرَىٰ","O good news","فَأَدْلَىٰ دَلْوَهُۥ ۖ قَالَ","هَـٰذَا غُلَـٰمٌۭ ۚ وَأَسَرُّوهُ",627],["12:31:27",239,"بَشَرًا","a man","لِلَّهِ مَا هَـٰذَا","إِنْ هَـٰذَآ إِلَّا",315],["12:96:4",247,"ٱلْبَشِيرُ","the bearer of glad tidings","فَلَمَّآ أَن جَآءَ","أَلْقَىٰهُ عَلَىٰ وَجْهِهِۦ",895],["14:10:22",256,"بَشَرٌۭ","a human","إِنْ أَنتُمْ إِلَّا","مِّثْلُنَا تُرِيدُونَ أَن",315],["14:11:7",257,"بَشَرٌۭ","a human","إِن نَّحْنُ إِلَّا","مِّثْلُكُمْ وَلَـٰكِنَّ ٱللَّهَ",315],["15:28:7",263,"بَشَرًۭا","a human being","لِلْمَلَـٰٓئِكَةِ إِنِّى خَـٰلِقٌۢ","مِّن صَلْصَـٰلٍۢ مِّنْ",315],["15:33:5",264,"لِبَشَرٍ","to a human","لَمْ أَكُن لِّأَسْجُدَ","خَلَقْتَهُۥ مِن صَلْصَـٰلٍۢ",315],["15:53:5",265,"نُبَشِّرُكَ","[we] bring glad tidings to you","لَا تَوْجَلْ إِنَّا","بِغُلَـٰمٍ عَلِيمٍۢ",307],["15:54:2",265,"أَبَشَّرْتُمُونِى","Do you give me glad tidings","قَالَ","عَلَىٰٓ أَن مَّسَّنِىَ",307],["15:54:8",265,"تُبَشِّرُونَ","you give glad tidings","مَّسَّنِىَ ٱلْكِبَرُ فَبِمَ","",307],["15:55:2",265,"بَشَّرْنَـٰكَ","We give you glad tidings","قَالُوا۟","بِٱلْحَقِّ فَلَا تَكُن",307],["15:67:4",265,"يَسْتَبْشِرُونَ","rejoicing","وَجَآءَ أَهْلُ ٱلْمَدِينَةِ","",1114],["16:58:2",273,"بُشِّرَ","is given good news","وَإِذَا","أَحَدُهُم بِٱلْأُنثَىٰ ظَلَّ",307],["16:59:7",273,"بُشِّرَ","he has been given good news","مِن سُوٓءِ مَا","بِهِۦٓ ۚ أَيُمْسِكُهُۥ عَلَىٰ",307],["16:89:23",277,"وَبُشْرَىٰ","and glad tidings","شَىْءٍۢ وَهُدًۭى وَرَحْمَةًۭ","لِلْمُسْلِمِينَ",627],["16:102:12",278,"وَبُشْرَىٰ","and glad tidings","ٱلَّذِينَ ءَامَنُوا۟ وَهُدًۭى","لِلْمُسْلِمِينَ",627],["16:103:7",279,"بَشَرٌۭ ۗ","a human being","يَقُولُونَ إِنَّمَا يُعَلِّمُهُۥ","لِّسَانُ ٱلَّذِى يُلْحِدُونَ",315],["17:9:8",283,"وَيُبَشِّرُ","and gives glad tidings","لِلَّتِى هِىَ أَقْوَمُ","ٱلْمُؤْمِنِينَ ٱلَّذِينَ يَعْمَلُونَ",307],["17:93:25",291,"بَشَرًۭا","a human","هَلْ كُنتُ إِلَّا","رَّسُولًۭا",315],["17:94:14",291,"بَشَرًۭا","a human","قَالُوٓا۟ أَبَعَثَ ٱللَّهُ","رَّسُولًۭا",315],["17:105:8",293,"مُبَشِّرًۭا","(as) a bearer of glad tidings","وَمَآ أَرْسَلْنَـٰكَ إِلَّا","وَنَذِيرًۭا",911],["18:2:7",293,"وَيُبَشِّرَ","and give glad tidings","شَدِيدًۭا مِّن لَّدُنْهُ","ٱلْمُؤْمِنِينَ ٱلَّذِينَ يَعْمَلُونَ",307],["18:56:5",300,"مُبَشِّرِينَ","(as) bearers of glad tidings","نُرْسِلُ ٱلْمُرْسَلِينَ إِلَّا","وَمُنذِرِينَ ۚ وَيُجَـٰدِلُ ٱلَّذِينَ",911],["18:110:4",304,"بَشَرٌۭ","(am) a man","قُلْ إِنَّمَآ أَنَا۠","مِّثْلُكُمْ يُوحَىٰٓ إِلَىَّ",315],["19:7:3",305,"نُبَشِّرُكَ","[We] give you glad tidings","يَـٰزَكَرِيَّآ إِنَّا","بِغُلَـٰمٍ ٱسْمُهُۥ يَحْيَىٰ",307],["19:17:10",306,"بَشَرًۭا","(of) a man","رُوحَنَا فَتَمَثَّلَ لَهَا","سَوِيًّۭا",315],["19:20:8",306,"بَشَرٌۭ","a man","غُلَـٰمٌۭ وَلَمْ يَمْسَسْنِى","وَلَمْ أَكُ بَغِيًّۭا",315],["19:26:8",307,"ٱلْبَشَرِ","human being","فَإِمَّا تَرَيِنَّ مِنَ","أَحَدًۭا فَقُولِىٓ إِنِّى",315],["19:97:4",312,"لِتُبَشِّرَ","that you may give glad tidings","فَإِنَّمَا يَسَّرْنَـٰهُ بِلِسَانِكَ","بِهِ ٱلْمُتَّقِينَ وَتُنذِرَ",307],["21:3:10",322,"بَشَرٌۭ","a human being","هَلْ هَـٰذَآ إِلَّا","مِّثْلُكُمْ ۖ أَفَتَأْتُونَ ٱلسِّحْرَ",315],["21:34:3",324,"لِبَشَرٍۢ","for any man","وَمَا جَعَلْنَا","مِّن قَبْلِكَ ٱلْخُلْدَ ۖ",315],["22:34:19",336,"وَبَشِّرِ","And give glad tidings","وَٰحِدٌۭ فَلَهُۥٓ أَسْلِمُوا۟ ۗ","ٱلْمُخْبِتِينَ",307],["22:37:19",336,"وَبَشِّرِ","And give glad tidings","عَلَىٰ مَا هَدَىٰكُمْ ۗ","ٱلْمُحْسِنِينَ",307],["23:24:10",343,"بَشَرٌۭ","a man","مَا هَـٰذَآ إِلَّا","مِّثْلُكُمْ يُرِيدُ أَن",315],["23:33:17",344,"بَشَرٌۭ","a man","مَا هَـٰذَآ إِلَّا","مِّثْلُكُمْ يَأْكُلُ مِمَّا",315],["23:34:3",344,"بَشَرًۭا","a man","وَلَئِنْ أَطَعْتُم","مِّثْلَكُمْ إِنَّكُمْ إِذًۭا",315],["23:47:3",345,"لِبَشَرَيْنِ","(in) two men","فَقَالُوٓا۟ أَنُؤْمِنُ","مِثْلِنَا وَقَوْمُهُمَا لَنَا",315],["25:22:5",362,"بُشْرَىٰ","glad tidings","يَرَوْنَ ٱلْمَلَـٰٓئِكَةَ لَا","يَوْمَئِذٍۢ لِّلْمُجْرِمِينَ وَيَقُولُونَ",627],["25:48:5",364,"بُشْرًۢا","(as) glad tidings","ٱلَّذِىٓ أَرْسَلَ ٱلرِّيَـٰحَ","بَيْنَ يَدَىْ رَحْمَتِهِۦ ۚ",1818],["25:54:6",364,"بَشَرًۭا","human being","خَلَقَ مِنَ ٱلْمَآءِ","فَجَعَلَهُۥ نَسَبًۭا وَصِهْرًۭا ۗ",315],["25:56:4",365,"مُبَشِّرًۭا","(as) a bearer of glad tidings","وَمَآ أَرْسَلْنَـٰكَ إِلَّا","وَنَذِيرًۭا",911],["26:154:4",373,"بَشَرٌۭ","a man","مَآ أَنتَ إِلَّا","مِّثْلُنَا فَأْتِ بِـَٔايَةٍ",315],["26:186:4",375,"بَشَرٌۭ","a man","وَمَآ أَنتَ إِلَّا","مِّثْلُنَا وَإِن نَّظُنُّكَ",315],["27:2:2",377,"وَبُشْرَىٰ","and glad tidings","هُدًۭى","لِلْمُؤْمِنِينَ",627],["27:63:10",382,"بُشْرًۢا","(as) glad tidings","وَمَن يُرْسِلُ ٱلرِّيَـٰحَ","بَيْنَ يَدَىْ رَحْمَتِهِۦٓ ۗ",1818],["29:31:5",400,"بِٱلْبُشْرَىٰ","with the glad tidings","جَآءَتْ رُسُلُنَآ إِبْرَٰهِيمَ","قَالُوٓا۟ إِنَّا مُهْلِكُوٓا۟",627],["30:20:10",406,"بَشَرٌۭ","(are) human beings","ثُمَّ إِذَآ أَنتُم","تَنتَشِرُونَ",315],["30:46:6",409,"مُبَشِّرَٰتٍۢ","(as) bearers of glad tidings","أَن يُرْسِلَ ٱلرِّيَاحَ","وَلِيُذِيقَكُم مِّن رَّحْمَتِهِۦ",3783],["30:48:28",409,"يَسْتَبْشِرُونَ","rejoice","عِبَادِهِۦٓ إِذَا هُمْ","",1114],["31:7:14",411,"فَبَشِّرْهُ","So give him tidings","فِىٓ أُذُنَيْهِ وَقْرًۭا ۖ","بِعَذَابٍ أَلِيمٍ",307],["33:45:6",424,"وَمُبَشِّرًۭا","and a bearer of glad tidings","إِنَّآ أَرْسَلْنَـٰكَ شَـٰهِدًۭا","وَنَذِيرًۭا",911],["33:47:1",424,"وَبَشِّرِ","And give glad tidings","","ٱلْمُؤْمِنِينَ بِأَنَّ لَهُم",307],["34:28:6",431,"بَشِيرًۭا","(as) a giver of glad tidings","إِلَّا كَآفَّةًۭ لِّلنَّاسِ","وَنَذِيرًۭا وَلَـٰكِنَّ أَكْثَرَ",895],["35:24:4",437,"بَشِيرًۭا","(as) a bearer of glad tidings","إِنَّآ أَرْسَلْنَـٰكَ بِٱلْحَقِّ","وَنَذِيرًۭا ۚ وَإِن مِّنْ",895],["36:11:9",440,"فَبَشِّرْهُ","So give him glad tidings","وَخَشِىَ ٱلرَّحْمَـٰنَ بِٱلْغَيْبِ ۖ","بِمَغْفِرَةٍۢ وَأَجْرٍۢ كَرِيمٍ",307],["36:15:5",441,"بَشَرٌۭ","human beings","مَآ أَنتُمْ إِلَّا","مِّثْلُنَا وَمَآ أَنزَلَ",315],["37:101:1",449,"فَبَشَّرْنَـٰهُ","So We gave him the glad tidings","","بِغُلَـٰمٍ حَلِيمٍۢ",307],["37:112:1",450,"وَبَشَّرْنَـٰهُ","And We gave him glad tidings","","بِإِسْحَـٰقَ نَبِيًّۭا مِّنَ",307],["38:71:7",457,"بَشَرًۭا","a human being","لِلْمَلَـٰٓئِكَةِ إِنِّى خَـٰلِقٌۢ","مِّن طِينٍۢ",315],["39:17:10",460,"ٱلْبُشْرَىٰ ۚ","(are) glad tidings","إِلَى ٱللَّهِ لَهُمُ","فَبَشِّرْ عِبَادِ",627],["39:17:11",460,"فَبَشِّرْ","So give glad tidings","ٱللَّهِ لَهُمُ ٱلْبُشْرَىٰ ۚ","عِبَادِ",307],["39:45:18",463,"يَسْتَبْشِرُونَ","rejoice","دُونِهِۦٓ إِذَا هُمْ","",1114],["41:4:1",477,"بَشِيرًۭا","A giver of glad tidings","","وَنَذِيرًۭا فَأَعْرَضَ أَكْثَرُهُمْ",895],["41:6:4",477,"بَشَرٌۭ","a man","قُلْ إِنَّمَآ أَنَا۠","مِّثْلُكُمْ يُوحَىٰٓ إِلَىَّ",315],["41:30:15",480,"وَأَبْشِرُوا۟","but receive the glad tidings","تَخَافُوا۟ وَلَا تَحْزَنُوا۟","بِٱلْجَنَّةِ ٱلَّتِى كُنتُمْ",2976],["42:23:3",486,"يُبَشِّرُ","Allah gives glad tidings","ذَٰلِكَ ٱلَّذِى","ٱللَّهُ عِبَادَهُ ٱلَّذِينَ",307],["42:51:3",488,"لِبَشَرٍ","for any human","۞ وَمَا كَانَ","أَن يُكَلِّمَهُ ٱللَّهُ",315],["43:17:2",490,"بُشِّرَ","is given good news","وَإِذَا","أَحَدُهُم بِمَا ضَرَبَ",307],["45:8:12",499,"فَبَشِّرْهُ","So give him tidings","كَأَن لَّمْ يَسْمَعْهَا ۖ","بِعَذَابٍ أَلِيمٍۢ",307],["46:12:15",503,"وَبُشْرَىٰ","and (as) glad tidings","لِّيُنذِرَ ٱلَّذِينَ ظَلَمُوا۟","لِلْمُحْسِنِينَ",627],["48:8:4",511,"وَمُبَشِّرًۭا","and (as) a bearer of glad tidings","إِنَّآ أَرْسَلْنَـٰكَ شَـٰهِدًۭا","وَنَذِيرًۭا",911],["51:28:7",521,"وَبَشَّرُوهُ","and they gave him glad tidings","قَالُوا۟ لَا تَخَفْ ۖ","بِغُلَـٰمٍ عَلِيمٍۢ",307],["54:24:2",529,"أَبَشَرًۭا","Is (it) a human being","فَقَالُوٓا۟","مِّنَّا وَٰحِدًۭا نَّتَّبِعُهُۥٓ",315],["57:12:10",539,"بُشْرَىٰكُمُ","Glad tidings for you","بَيْنَ أَيْدِيهِمْ وَبِأَيْمَـٰنِهِم","ٱلْيَوْمَ جَنَّـٰتٌۭ تَجْرِى",627],["61:6:18",552,"وَمُبَشِّرًۢا","and bringing glad tidings","يَدَىَّ مِنَ ٱلتَّوْرَىٰةِ","بِرَسُولٍۢ يَأْتِى مِنۢ",911],["61:13:8",552,"وَبَشِّرِ","and give glad tidings","ٱللَّهِ وَفَتْحٌۭ قَرِيبٌۭ ۗ","ٱلْمُؤْمِنِينَ",307],["64:6:8",556,"أَبَشَرٌۭ","Shall human beings","رُسُلُهُم بِٱلْبَيِّنَـٰتِ فَقَالُوٓا۟","يَهْدُونَنَا فَكَفَرُوا۟ وَتَوَلَّوا۟ ۚ",315],["74:25:5",576,"ٱلْبَشَرِ","(of) a human being","هَـٰذَآ إِلَّا قَوْلُ","",315],["74:29:2",576,"لِّلْبَشَرِ","the human (skin)","لَوَّاحَةٌۭ","",315],["74:31:57",576,"لِلْبَشَرِ","to (the) human beings","هِىَ إِلَّا ذِكْرَىٰ","",315],["74:36:2",576,"لِّلْبَشَرِ","to (the) human being","نَذِيرًۭا","",315],["80:39:2",585,"مُّسْتَبْشِرَةٌۭ","rejoicing at good news","ضَاحِكَةٌۭ","",3992],["84:24:1",589,"فَبَشِّرْهُم","so give them tidings","","بِعَذَابٍ أَلِيمٍ",307]]