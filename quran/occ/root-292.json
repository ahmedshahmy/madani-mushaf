[["2:25:31",5,"مُّطَهَّرَةٌۭ ۖ","purified","وَلَهُمْ فِيهَآ أَزْوَٰجٌۭ","وَهُمْ فِيهَا خَـٰلِدُونَ",1371],["2:125:17",19,"طَهِّرَا","[You both] purify","إِبْرَٰهِـۧمَ وَإِسْمَـٰعِيلَ أَن","بَيْتِىَ لِلطَّآئِفِينَ وَٱلْعَـٰكِفِينَ",891],["2:222:14",35,"يَطْهُرْنَ ۖ","they are cleansed","وَلَا تَقْرَبُوهُنَّ حَتَّىٰ","فَإِذَا تَطَهَّرْنَ فَأْتُوهُنَّ",4620],["2:222:16",35,"تَطَهَّرْنَ","they are purified","حَتَّىٰ يَطْهُرْنَ ۖ فَإِذَا","فَأْتُوهُنَّ مِنْ حَيْثُ",1399],["2:222:27",35,"ٱلْمُتَطَهِّرِينَ","those who purify themselves","يُحِبُّ ٱلتَّوَّٰبِينَ وَيُحِبُّ","",3870],["2:232:28",37,"وَأَطْهَرُ ۗ","and more purer","ذَٰلِكُمْ أَزْكَىٰ لَكُمْ","وَٱللَّهُ يَعْلَمُ وَأَنتُمْ",1464],["3:15:18",51,"مُّطَهَّرَةٌۭ","pure","خَـٰلِدِينَ فِيهَا وَأَزْوَٰجٌۭ","وَرِضْوَٰنٌۭ مِّنَ ٱللَّهِ ۗ",1371],["3:42:8",55,"وَطَهَّرَكِ","and purified you","إِنَّ ٱللَّهَ ٱصْطَفَىٰكِ","وَٱصْطَفَىٰكِ عَلَىٰ نِسَآءِ",891],["3:55:9",57,"وَمُطَهِّرُكَ","and purify you","مُتَوَفِّيكَ وَرَافِعُكَ إِلَىَّ","مِنَ ٱلَّذِينَ كَفَرُوا۟",3780],["4:57:17",87,"مُّطَهَّرَةٌۭ ۖ","pure","لَّهُمْ فِيهَآ أَزْوَٰجٌۭ","وَنُدْخِلُهُمْ ظِلًّۭا ظَلِيلًا",1371],["5:6:21",108,"فَٱطَّهَّرُوا۟ ۚ","then purify yourselves","وَإِن كُنتُمْ جُنُبًۭا","وَإِن كُنتُم مَّرْضَىٰٓ",1399],["5:6:56",108,"لِيُطَهِّرَكُمْ","to purify you","حَرَجٍۢ وَلَـٰكِن يُرِيدُ","وَلِيُتِمَّ نِعْمَتَهُۥ عَلَيْكُمْ",891],["5:41:57",114,"يُطَهِّرَ","He purifies","يُرِدِ ٱللَّهُ أَن","قُلُوبَهُمْ ۚ لَهُمْ فِى",891],["7:82:13",161,"يَتَطَهَّرُونَ","who keep themselves pure","قَرْيَتِكُمْ ۖ إِنَّهُمْ أُنَاسٌۭ","",1399],["8:11:11",178,"لِّيُطَهِّرَكُم","so that He may purify you","مِّنَ ٱلسَّمَآءِ مَآءًۭ","بِهِۦ وَيُذْهِبَ عَنكُمْ",891],["9:103:5",203,"تُطَهِّرُهُمْ","purifying them","مِنْ أَمْوَٰلِهِمْ صَدَقَةًۭ","وَتُزَكِّيهِم بِهَا وَصَلِّ",891],["9:108:20",204,"يَتَطَهَّرُوا۟ ۚ","purify themselves","رِجَالٌۭ يُحِبُّونَ أَن","وَٱللَّهُ يُحِبُّ ٱلْمُطَّهِّرِينَ",1399],["9:108:23",204,"ٱلْمُطَّهِّرِينَ","the ones who purify themselves","يَتَطَهَّرُوا۟ ۚ وَٱللَّهُ يُحِبُّ","",3781],["11:78:15",230,"أَطْهَرُ","(are) purer","هَـٰٓؤُلَآءِ بَنَاتِى هُنَّ","لَكُمْ ۖ فَٱتَّقُوا۟ ٱللَّهَ",1464],["22:26:11",335,"وَطَهِّرْ","and purify","تُشْرِكْ بِى شَيْـًۭٔا","بَيْتِىَ لِلطَّآئِفِينَ وَٱلْقَآئِمِينَ",891],["25:48:13",364,"طَهُورًۭا","pure","مِنَ ٱلسَّمَآءِ مَآءًۭ","",2306],["27:56:15",382,"يَتَطَهَّرُونَ","who keep clean and pure","قَرْيَتِكُمْ ۖ إِنَّهُمْ أُنَاسٌۭ","",1399],["33:33:24",422,"وَيُطَهِّرَكُمْ","And to purify you","ٱلرِّجْسَ أَهْلَ ٱلْبَيْتِ","تَطْهِيرًۭا",891],["33:33:25",422,"تَطْهِيرًۭا","(with thorough) purification","أَهْلَ ٱلْبَيْتِ وَيُطَهِّرَكُمْ","",4345],["33:53:47",425,"أَطْهَرُ","(is) purer","وَرَآءِ حِجَابٍۢ ۚ ذَٰلِكُمْ","لِقُلُوبِكُمْ وَقُلُوبِهِنَّ ۚ وَمَا",1464],["56:79:4",537,"ٱلْمُطَهَّرُونَ","the purified","لَّا يَمَسُّهُۥٓ إِلَّا","",3779],["58:12:15",544,"وَأَطْهَرُ ۚ","and purer","ذَٰلِكَ خَيْرٌۭ لَّكُمْ","فَإِن لَّمْ تَجِدُوا۟",1464],["74:4:2",575,"فَطَهِّرْ","purify","وَثِيَابَكَ","",891],["76:21:13",579,"طَهُورًا","pure","وَسَقَىٰهُمْ رَبُّهُمْ شَرَابًۭا","",2306],["80:14:2",585,"مُّطَهَّرَةٍۭ","purified","مَّرْفُوعَةٍۢ","",1371],["98:2:6",598,"مُّطَهَّرَةًۭ","purified","ٱللَّهِ يَتْلُوا۟ صُحُفًۭا","",1371]]