[["2:64:6",10,"فَلَوْلَا","So if not","مِّنۢ بَعْدِ ذَٰلِكَ ۖ","فَضْلُ ٱللَّهِ عَلَيْكُمْ",154],["2:118:5",18,"لَوْلَا","Why not","ٱلَّذِينَ لَا يَعْلَمُونَ","يُكَلِّمُنَا ٱللَّهُ أَوْ",154],["2:251:14",41,"وَلَوْلَا","And if not","وَعَلَّمَهُۥ مِمَّا يَشَآءُ ۗ","دَفْعُ ٱللَّهِ ٱلنَّاسَ",154],["4:77:33",90,"لَوْلَآ","Why not","كَتَبْتَ عَلَيْنَا ٱلْقِتَالَ","أَخَّرْتَنَآ إِلَىٰٓ أَجَلٍۢ",154],["4:83:22",91,"وَلَوْلَا","And if not","ٱلَّذِينَ يَسْتَنۢبِطُونَهُۥ مِنْهُمْ ۗ","فَضْلُ ٱللَّهِ عَلَيْكُمْ",154],["4:113:1",96,"وَلَوْلَا","And if not","","فَضْلُ ٱللَّهِ عَلَيْكَ",154],["5:63:1",118,"لَوْلَا","Why (do) not","","يَنْهَىٰهُمُ ٱلرَّبَّـٰنِيُّونَ وَٱلْأَحْبَارُ",154],["6:8:2",128,"لَوْلَآ","Why has not been","وَقَالُوا۟","أُنزِلَ عَلَيْهِ مَلَكٌۭ ۖ",154],["6:37:2",132,"لَوْلَا","Why (is) not","وَقَالُوا۟","نُزِّلَ عَلَيْهِ ءَايَةٌۭ",154],["6:43:1",132,"فَلَوْلَآ","Then why not","","إِذْ جَآءَهُم بَأْسُنَا",154],["7:43:20",155,"لَوْلَآ","if not","وَمَا كُنَّا لِنَهْتَدِىَ","أَنْ هَدَىٰنَا ٱللَّهُ ۖ",154],["7:203:6",176,"لَوْلَا","Why (have) not","تَأْتِهِم بِـَٔايَةٍۢ قَالُوا۟","ٱجْتَبَيْتَهَا ۚ قُلْ إِنَّمَآ",154],["8:68:1",185,"لَّوْلَا","Had not","","كِتَـٰبٌۭ مِّنَ ٱللَّهِ",154],["9:122:6",206,"فَلَوْلَا","So if not","ٱلْمُؤْمِنُونَ لِيَنفِرُوا۟ كَآفَّةًۭ ۚ","نَفَرَ مِن كُلِّ",154],["10:19:8",210,"وَلَوْلَا","And had (it) not been","أُمَّةًۭ وَٰحِدَةًۭ فَٱخْتَلَفُوا۟ ۚ","كَلِمَةٌۭ سَبَقَتْ مِن",154],["10:20:2",210,"لَوْلَآ","Why not","وَيَقُولُونَ","أُنزِلَ عَلَيْهِ ءَايَةٌۭ",154],["10:98:1",220,"فَلَوْلَا","So why not","","كَانَتْ قَرْيَةٌ ءَامَنَتْ",154],["11:12:12",222,"لَوْلَآ","Why not","صَدْرُكَ أَن يَقُولُوا۟","أُنزِلَ عَلَيْهِ كَنزٌ",154],["11:91:12",232,"وَلَوْلَا","And if not","لَنَرَىٰكَ فِينَا ضَعِيفًۭا ۖ","رَهْطُكَ لَرَجَمْنَـٰكَ ۖ وَمَآ",154],["11:110:7",234,"وَلَوْلَا","And if not","ٱلْكِتَـٰبَ فَٱخْتُلِفَ فِيهِ ۚ","كَلِمَةٌۭ سَبَقَتْ مِن",154],["11:116:1",234,"فَلَوْلَا","So why not","","كَانَ مِنَ ٱلْقُرُونِ",154],["12:24:6",238,"لَوْلَآ","if not","بِهِۦ ۖ وَهَمَّ بِهَا","أَن رَّءَا بُرْهَـٰنَ",154],["12:94:10",246,"لَوْلَآ","if not","لَأَجِدُ رِيحَ يُوسُفَ ۖ","أَن تُفَنِّدُونِ",154],["13:7:4",250,"لَوْلَآ","Why not","وَيَقُولُ ٱلَّذِينَ كَفَرُوا۟","أُنزِلَ عَلَيْهِ ءَايَةٌۭ",154],["13:27:4",252,"لَوْلَآ","Why has not","وَيَقُولُ ٱلَّذِينَ كَفَرُوا۟","أُنزِلَ عَلَيْهِ ءَايَةٌۭ",154],["17:74:1",289,"وَلَوْلَآ","And if not","","أَن ثَبَّتْنَـٰكَ لَقَدْ",154],["18:15:7",294,"لَّوْلَا","Why not","مِن دُونِهِۦٓ ءَالِهَةًۭ ۖ","يَأْتُونَ عَلَيْهِم بِسُلْطَـٰنٍۭ",154],["18:39:1",298,"وَلَوْلَآ","And why (did you) not","","إِذْ دَخَلْتَ جَنَّتَكَ",154],["20:129:1",321,"وَلَوْلَا","And if not","","كَلِمَةٌۭ سَبَقَتْ مِن",154],["20:133:2",321,"لَوْلَا","Why not","وَقَالُوا۟","يَأْتِينَا بِـَٔايَةٍۢ مِّن",154],["20:134:9",321,"لَوْلَآ","why not","قَبْلِهِۦ لَقَالُوا۟ رَبَّنَا","أَرْسَلْتَ إِلَيْنَا رَسُولًۭا",154],["22:40:12",337,"وَلَوْلَا","And if not","يَقُولُوا۟ رَبُّنَا ٱللَّهُ ۗ","دَفْعُ ٱللَّهِ ٱلنَّاسَ",154],["24:10:1",350,"وَلَوْلَا","And if not","","فَضْلُ ٱللَّهِ عَلَيْكُمْ",154],["24:12:1",351,"لَّوْلَآ","Why not","","إِذْ سَمِعْتُمُوهُ ظَنَّ",154],["24:13:1",351,"لَّوْلَا","Why (did) not","","جَآءُو عَلَيْهِ بِأَرْبَعَةِ",154],["24:14:1",351,"وَلَوْلَا","And if not","","فَضْلُ ٱللَّهِ عَلَيْكُمْ",154],["24:16:1",351,"وَلَوْلَآ","And why not","","إِذْ سَمِعْتُمُوهُ قُلْتُم",154],["24:20:1",351,"وَلَوْلَا","And if not","","فَضْلُ ٱللَّهِ عَلَيْكُمْ",154],["24:21:16",352,"وَلَوْلَا","And if not","يَأْمُرُ بِٱلْفَحْشَآءِ وَٱلْمُنكَرِ ۚ","فَضْلُ ٱللَّهِ عَلَيْكُمْ",154],["25:7:10",360,"لَوْلَآ","Why not","وَيَمْشِى فِى ٱلْأَسْوَاقِ ۙ","أُنزِلَ إِلَيْهِ مَلَكٌۭ",154],["25:21:6",362,"لَوْلَآ","Why not","لَا يَرْجُونَ لِقَآءَنَا","أُنزِلَ عَلَيْنَا ٱلْمَلَـٰٓئِكَةُ",154],["25:32:4",362,"لَوْلَا","Why not","وَقَالَ ٱلَّذِينَ كَفَرُوا۟","نُزِّلَ عَلَيْهِ ٱلْقُرْءَانُ",154],["25:42:6",363,"لَوْلَآ","if not","لَيُضِلُّنَا عَنْ ءَالِهَتِنَا","أَن صَبَرْنَا عَلَيْهَا ۚ",154],["25:77:6",366,"لَوْلَا","if not","يَعْبَؤُا۟ بِكُمْ رَبِّى","دُعَآؤُكُمْ ۖ فَقَدْ كَذَّبْتُمْ",154],["27:46:8",381,"لَوْلَا","Why not","بِٱلسَّيِّئَةِ قَبْلَ ٱلْحَسَنَةِ ۖ","تَسْتَغْفِرُونَ ٱللَّهَ لَعَلَّكُمْ",154],["28:10:10",386,"لَوْلَآ","if not","كَادَتْ لَتُبْدِى بِهِۦ","أَن رَّبَطْنَا عَلَىٰ",154],["28:47:1",391,"وَلَوْلَآ","And if not","","أَن تُصِيبَهُم مُّصِيبَةٌۢ",154],["28:47:10",391,"لَوْلَآ","Why not","أَيْدِيهِمْ فَيَقُولُوا۟ رَبَّنَا","أَرْسَلْتَ إِلَيْنَا رَسُولًۭا",154],["28:48:7",391,"لَوْلَآ","Why not","مِنْ عِندِنَا قَالُوا۟","أُوتِىَ مِثْلَ مَآ",154],["28:82:16",395,"لَوْلَآ","If not","مِنْ عِبَادِهِۦ وَيَقْدِرُ ۖ","أَن مَّنَّ ٱللَّهُ",154],["29:50:2",402,"لَوْلَآ","Why not","وَقَالُوا۟","أُنزِلَ عَلَيْهِ ءَايَـٰتٌۭ",154],["29:53:3",403,"وَلَوْلَآ","And if not","وَيَسْتَعْجِلُونَكَ بِٱلْعَذَابِ ۚ","أَجَلٌۭ مُّسَمًّۭى لَّجَآءَهُمُ",154],["34:31:29",431,"لَوْلَآ","If not","ٱسْتُضْعِفُوا۟ لِلَّذِينَ ٱسْتَكْبَرُوا۟","أَنتُمْ لَكُنَّا مُؤْمِنِينَ",154],["37:57:1",448,"وَلَوْلَا","And if not","","نِعْمَةُ رَبِّى لَكُنتُ",154],["37:143:1",451,"فَلَوْلَآ","And if not","","أَنَّهُۥ كَانَ مِنَ",154],["41:44:6",481,"لَوْلَا","Why not","قُرْءَانًا أَعْجَمِيًّۭا لَّقَالُوا۟","فُصِّلَتْ ءَايَـٰتُهُۥٓ ۖ ءَا۬عْجَمِىٌّۭ",154],["41:45:7",481,"وَلَوْلَا","And had it not been","ٱلْكِتَـٰبَ فَٱخْتُلِفَ فِيهِ ۗ","كَلِمَةٌۭ سَبَقَتْ مِن",154],["42:14:11",484,"وَلَوْلَا","And if not","ٱلْعِلْمُ بَغْيًۢا بَيْنَهُمْ ۚ","كَلِمَةٌۭ سَبَقَتْ مِن",154],["42:21:13",485,"وَلَوْلَا","And if not","يَأْذَنۢ بِهِ ٱللَّهُ ۚ","كَلِمَةُ ٱلْفَصْلِ لَقُضِىَ",154],["43:31:2",491,"لَوْلَا","Why not","وَقَالُوا۟","نُزِّلَ هَـٰذَا ٱلْقُرْءَانُ",154],["43:33:1",491,"وَلَوْلَآ","And if not","","أَن يَكُونَ ٱلنَّاسُ",154],["43:53:1",493,"فَلَوْلَآ","Then why not","","أُلْقِىَ عَلَيْهِ أَسْوِرَةٌۭ",154],["46:28:1",505,"فَلَوْلَا","Then why (did) not","","نَصَرَهُمُ ٱلَّذِينَ ٱتَّخَذُوا۟",154],["47:20:4",509,"لَوْلَا","Why not","وَيَقُولُ ٱلَّذِينَ ءَامَنُوا۟","نُزِّلَتْ سُورَةٌۭ ۖ فَإِذَآ",154],["48:25:13",514,"وَلَوْلَا","And if not","أَن يَبْلُغَ مَحِلَّهُۥ ۚ","رِجَالٌۭ مُّؤْمِنُونَ وَنِسَآءٌۭ",154],["56:57:3",536,"فَلَوْلَا","so why (do) not","نَحْنُ خَلَقْنَـٰكُمْ","تُصَدِّقُونَ",154],["56:62:5",536,"فَلَوْلَا","so why not","عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ","تَذَكَّرُونَ",154],["56:70:5",536,"فَلَوْلَا","then why are you not grateful","نَشَآءُ جَعَلْنَـٰهُ أُجَاجًۭا","تَشْكُرُونَ",154],["56:83:1",537,"فَلَوْلَآ","Then why not","","إِذَا بَلَغَتِ ٱلْحُلْقُومَ",154],["56:86:1",537,"فَلَوْلَآ","Then why not","","إِن كُنتُمْ غَيْرَ",154],["58:8:29",543,"لَوْلَا","Why (does) not","وَيَقُولُونَ فِىٓ أَنفُسِهِمْ","يُعَذِّبُنَا ٱللَّهُ بِمَا",154],["59:3:1",545,"وَلَوْلَآ","And if not","","أَن كَتَبَ ٱللَّهُ",154],["63:10:13",555,"لَوْلَآ","Why not","ٱلْمَوْتُ فَيَقُولَ رَبِّ","أَخَّرْتَنِىٓ إِلَىٰٓ أَجَلٍۢ",154],["68:28:6",565,"لَوْلَا","'Why not","أَلَمْ أَقُل لَّكُمْ","تُسَبِّحُونَ",154],["68:49:1",566,"لَّوْلَآ","If not","","أَن تَدَٰرَكَهُۥ نِعْمَةٌۭ",154]]