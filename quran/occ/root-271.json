[["2:271:7",46,"تُخْفُوهَا","you keep it secret","فَنِعِمَّا هِىَ ۖ وَإِن","وَتُؤْتُوهَا ٱلْفُقَرَآءَ فَهُوَ",544],["2:284:14",49,"تُخْفُوهُ","you conceal it","فِىٓ أَنفُسِكُمْ أَوْ","يُحَاسِبْكُم بِهِ ٱللَّهُ ۖ",544],["3:5:4",50,"يَخْفَىٰ","is hidden","إِنَّ ٱللَّهَ لَا","عَلَيْهِ شَىْءٌۭ فِى",1256],["3:29:3",53,"تُخْفُوا۟","you conceal","قُلْ إِن","مَا فِى صُدُورِكُمْ",544],["3:118:21",65,"تُخْفِى","conceals","مِنْ أَفْوَٰهِهِمْ وَمَا","صُدُورُهُمْ أَكْبَرُ ۚ قَدْ",544],["3:154:34",70,"يُخْفُونَ","They hide","ٱلْأَمْرَ كُلَّهُۥ لِلَّهِ ۗ","فِىٓ أَنفُسِهِم مَّا",544],["4:108:1",96,"يَسْتَخْفُونَ","They seek to hide","","مِنَ ٱلنَّاسِ وَلَا",2069],["4:108:5",96,"يَسْتَخْفُونَ","(can) they hide","مِنَ ٱلنَّاسِ وَلَا","مِنَ ٱللَّهِ وَهُوَ",2069],["4:149:5",102,"تُخْفُوهُ","you conceal it","تُبْدُوا۟ خَيْرًا أَوْ","أَوْ تَعْفُوا۟ عَن",544],["5:15:11",110,"تُخْفُونَ","conceal","كَثِيرًۭا مِّمَّا كُنتُمْ","مِنَ ٱلْكِتَـٰبِ وَيَعْفُوا۟",544],["6:28:6",131,"يُخْفُونَ","conceal","لَهُم مَّا كَانُوا۟","مِن قَبْلُ ۖ وَلَوْ",544],["6:63:10",135,"وَخُفْيَةًۭ","and secretly","وَٱلْبَحْرِ تَدْعُونَهُۥ تَضَرُّعًۭا","لَّئِنْ أَنجَىٰنَا مِنْ",2748],["6:91:29",139,"وَتُخْفُونَ","and you conceal","تَجْعَلُونَهُۥ قَرَاطِيسَ تُبْدُونَهَا","كَثِيرًۭا ۖ وَعُلِّمْتُم مَّا",544],["7:55:4",157,"وَخُفْيَةً ۚ","and privately","ٱدْعُوا۟ رَبَّكُمْ تَضَرُّعًۭا","إِنَّهُۥ لَا يُحِبُّ",2748],["11:5:5",221,"لِيَسْتَخْفُوا۟","that they may hide","إِنَّهُمْ يَثْنُونَ صُدُورَهُمْ","مِنْهُ ۚ أَلَا حِينَ",2069],["13:10:11",250,"مُسْتَخْفٍۭ","(is) hidden","بِهِۦ وَمَنْ هُوَ","بِٱلَّيْلِ وَسَارِبٌۢ بِٱلنَّهَارِ",3863],["14:38:5",260,"نُخْفِى","we conceal","إِنَّكَ تَعْلَمُ مَا","وَمَا نُعْلِنُ ۗ وَمَا",544],["14:38:9",260,"يَخْفَىٰ","(is) hidden","وَمَا نُعْلِنُ ۗ وَمَا","عَلَى ٱللَّهِ مِن",1256],["19:3:5",305,"خَفِيًّۭا","secret","نَادَىٰ رَبَّهُۥ نِدَآءً","",2735],["20:7:7",312,"وَأَخْفَى","and the more hidden","فَإِنَّهُۥ يَعْلَمُ ٱلسِّرَّ","",3055],["20:15:5",313,"أُخْفِيهَا","[I] hide it","ٱلسَّاعَةَ ءَاتِيَةٌ أَكَادُ","لِتُجْزَىٰ كُلُّ نَفْسٍۭ",544],["24:31:68",353,"يُخْفِينَ","they conceal","بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا","مِن زِينَتِهِنَّ ۚ وَتُوبُوٓا۟",544],["27:25:12",379,"تُخْفُونَ","you conceal","وَٱلْأَرْضِ وَيَعْلَمُ مَا","وَمَا تُعْلِنُونَ",544],["32:17:5",416,"أُخْفِىَ","is hidden","تَعْلَمُ نَفْسٌۭ مَّآ","لَهُم مِّن قُرَّةِ",544],["33:37:14",423,"وَتُخْفِى","But you concealed","زَوْجَكَ وَٱتَّقِ ٱللَّهَ","فِى نَفْسِكَ مَا",544],["33:54:5",425,"تُخْفُوهُ","conceal it","تُبْدُوا۟ شَيْـًٔا أَوْ","فَإِنَّ ٱللَّهَ كَانَ",544],["40:16:5",468,"يَخْفَىٰ","is hidden","هُم بَـٰرِزُونَ ۖ لَا","عَلَى ٱللَّهِ مِنْهُمْ",1256],["40:19:5",469,"تُخْفِى","conceal","خَآئِنَةَ ٱلْأَعْيُنِ وَمَا","ٱلصُّدُورُ",544],["41:40:7",481,"يَخْفَوْنَ","hidden","فِىٓ ءَايَـٰتِنَا لَا","عَلَيْنَآ ۗ أَفَمَن يُلْقَىٰ",1256],["42:45:10",488,"خَفِىٍّۢ ۗ","stealthy","يَنظُرُونَ مِن طَرْفٍ","وَقَالَ ٱلَّذِينَ ءَامَنُوٓا۟",2735],["60:1:39",549,"أَخْفَيْتُمْ","you conceal","وَأَنَا۠ أَعْلَمُ بِمَآ","وَمَآ أَعْلَنتُمْ ۚ وَمَن",544],["69:18:4",567,"تَخْفَىٰ","will be hidden","يَوْمَئِذٍۢ تُعْرَضُونَ لَا","مِنكُمْ خَافِيَةٌۭ",1256],["69:18:6",567,"خَافِيَةٌۭ","any secret","لَا تَخْفَىٰ مِنكُمْ","",4556],["87:7:9",591,"يَخْفَىٰ","is hidden","يَعْلَمُ ٱلْجَهْرَ وَمَا","",1256]]