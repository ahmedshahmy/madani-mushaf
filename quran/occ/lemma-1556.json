[["3:154:50",70,"هَـٰهُنَا ۗ","here","شَىْءٌۭ مَّا قُتِلْنَا","قُل لَّوْ كُنتُمْ",1556],["5:24:15",112,"هَـٰهُنَا","are [here]","وَرَبُّكَ فَقَـٰتِلَآ إِنَّا","قَـٰعِدُونَ",1556],["26:146:4",373,"هَـٰهُنَآ","(is) here","أَتُتْرَكُونَ فِى مَا","ءَامِنِينَ",1556],["69:35:4",567,"هَـٰهُنَا","here","فَلَيْسَ لَهُ ٱلْيَوْمَ","حَمِيمٌۭ",1556]]