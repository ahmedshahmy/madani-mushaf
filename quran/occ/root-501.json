[["2:245:4",39,"يُقْرِضُ","will lend","مَّن ذَا ٱلَّذِى","ٱللَّهَ قَرْضًا حَسَنًۭا",1138],["2:245:6",39,"قَرْضًا","a loan","ٱلَّذِى يُقْرِضُ ٱللَّهَ","حَسَنًۭا فَيُضَـٰعِفَهُۥ لَهُۥٓ",1221],["5:12:24",109,"وَأَقْرَضْتُمُ","and you loan","وَءَامَنتُم بِرُسُلِى وَعَزَّرْتُمُوهُمْ","ٱللَّهَ قَرْضًا حَسَنًۭا",1138],["5:12:26",109,"قَرْضًا","a loan","وَعَزَّرْتُمُوهُمْ وَأَقْرَضْتُمُ ٱللَّهَ","حَسَنًۭا لَّأُكَفِّرَنَّ عَنكُمْ",1221],["18:17:12",295,"تَّقْرِضُهُمْ","passing away from them","ٱلْيَمِينِ وَإِذَا غَرَبَت","ذَاتَ ٱلشِّمَالِ وَهُمْ",4485],["57:11:4",538,"يُقْرِضُ","will loan","مَّن ذَا ٱلَّذِى","ٱللَّهَ قَرْضًا حَسَنًۭا",1138],["57:11:6",538,"قَرْضًا","a loan","ٱلَّذِى يُقْرِضُ ٱللَّهَ","حَسَنًۭا فَيُضَـٰعِفَهُۥ لَهُۥ",1221],["57:18:4",539,"وَأَقْرَضُوا۟","and who lend","إِنَّ ٱلْمُصَّدِّقِينَ وَٱلْمُصَّدِّقَـٰتِ","ٱللَّهَ قَرْضًا حَسَنًۭا",1138],["57:18:6",539,"قَرْضًا","a loan","وَٱلْمُصَّدِّقَـٰتِ وَأَقْرَضُوا۟ ٱللَّهَ","حَسَنًۭا يُضَـٰعَفُ لَهُمْ",1221],["64:17:2",557,"تُقْرِضُوا۟","you loan","إِن","ٱللَّهَ قَرْضًا حَسَنًۭا",1138],["64:17:4",557,"قَرْضًا","a loan","إِن تُقْرِضُوا۟ ٱللَّهَ","حَسَنًۭا يُضَـٰعِفْهُ لَكُمْ",1221],["73:20:57",575,"وَأَقْرِضُوا۟","and loan","ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ","ٱللَّهَ قَرْضًا حَسَنًۭا ۚ",1138],["73:20:59",575,"قَرْضًا","a loan","ٱلزَّكَوٰةَ وَأَقْرِضُوا۟ ٱللَّهَ","حَسَنًۭا ۚ وَمَا تُقَدِّمُوا۟",1221]]