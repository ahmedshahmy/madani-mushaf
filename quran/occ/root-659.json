[["5:26:11",112,"تَأْسَ","grieve","فِى ٱلْأَرْضِ ۚ فَلَا","عَلَى ٱلْقَوْمِ ٱلْفَـٰسِقِينَ",1646],["5:68:27",119,"تَأْسَ","grieve","طُغْيَـٰنًۭا وَكُفْرًۭا ۖ فَلَا","عَلَى ٱلْقَوْمِ ٱلْكَـٰفِرِينَ",1646],["7:93:12",162,"ءَاسَىٰ","I grieve","وَنَصَحْتُ لَكُمْ ۖ فَكَيْفَ","عَلَىٰ قَوْمٍۢ كَـٰفِرِينَ",1646],["33:21:7",420,"أُسْوَةٌ","an excellent example","فِى رَسُولِ ٱللَّهِ","حَسَنَةٌۭ لِّمَن كَانَ",1752],["57:23:2",540,"تَأْسَوْا۟","grieve","لِّكَيْلَا","عَلَىٰ مَا فَاتَكُمْ",1646],["60:4:4",549,"أُسْوَةٌ","an example","قَدْ كَانَتْ لَكُمْ","حَسَنَةٌۭ فِىٓ إِبْرَٰهِيمَ",1752],["60:6:5",550,"أُسْوَةٌ","an example","كَانَ لَكُمْ فِيهِمْ","حَسَنَةٌۭ لِّمَن كَانَ",1752]]