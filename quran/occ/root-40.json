[["2:58:16",9,"نَّغْفِرْ","We will forgive","سُجَّدًۭا وَقُولُوا۟ حِطَّةٌۭ","لَكُمْ خَطَـٰيَـٰكُمْ ۚ وَسَنَزِيدُ",183],["2:173:24",26,"غَفُورٌۭ","(is) Oft-Forgiving","عَلَيْهِ ۚ إِنَّ ٱللَّهَ","رَّحِيمٌ",118],["2:175:7",26,"بِٱلْمَغْفِرَةِ ۚ","for [the] forgiveness","ٱلضَّلَـٰلَةَ بِٱلْهُدَىٰ وَٱلْعَذَابَ","فَمَآ أَصْبَرَهُمْ عَلَى",390],["2:182:15",28,"غَفُورٌۭ","(is) Oft-Forgiving","عَلَيْهِ ۚ إِنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["2:192:5",30,"غَفُورٌۭ","(is) Oft-Forgiving","ٱنتَهَوْا۟ فَإِنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["2:199:7",31,"وَٱسْتَغْفِرُوا۟","and ask forgiveness","حَيْثُ أَفَاضَ ٱلنَّاسُ","ٱللَّهَ ۚ إِنَّ ٱللَّهَ",296],["2:199:11",31,"غَفُورٌۭ","(is) Oft-Forgiving","ٱللَّهَ ۚ إِنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["2:218:15",34,"غَفُورٌۭ","(is) Oft-Forgiving","رَحْمَتَ ٱللَّهِ ۚ وَٱللَّهُ","رَّحِيمٌۭ",118],["2:221:33",35,"وَٱلْمَغْفِرَةِ","and [the] forgiveness","يَدْعُوٓا۟ إِلَى ٱلْجَنَّةِ","بِإِذْنِهِۦ ۖ وَيُبَيِّنُ ءَايَـٰتِهِۦ",390],["2:225:13",36,"غَفُورٌ","(is) Oft-Forgiving","كَسَبَتْ قُلُوبُكُمْ ۗ وَٱللَّهُ","حَلِيمٌۭ",118],["2:226:12",36,"غَفُورٌۭ","(is) Oft-Forgiving","فَآءُو فَإِنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["2:235:46",38,"غَفُورٌ","(is) Oft-Forgiving","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","حَلِيمٌۭ",118],["2:263:3",44,"وَمَغْفِرَةٌ","and (seeking) forgiveness","۞ قَوْلٌۭ مَّعْرُوفٌۭ","خَيْرٌۭ مِّن صَدَقَةٍۢ",390],["2:268:8",45,"مَّغْفِرَةًۭ","forgiveness","بِٱلْفَحْشَآءِ ۖ وَٱللَّهُ يَعِدُكُم","مِّنْهُ وَفَضْلًۭا ۗ وَٱللَّهُ",390],["2:284:18",49,"فَيَغْفِرُ","Then, He will forgive","يُحَاسِبْكُم بِهِ ٱللَّهُ ۖ","لِمَن يَشَآءُ وَيُعَذِّبُ",183],["2:285:24",49,"غُفْرَانَكَ","(Grant) us Your forgiveness","وَقَالُوا۟ سَمِعْنَا وَأَطَعْنَا ۖ","رَبَّنَا وَإِلَيْكَ ٱلْمَصِيرُ",3476],["2:286:41",49,"وَٱغْفِرْ","and forgive","بِهِۦ ۖ وَٱعْفُ عَنَّا","لَنَا وَٱرْحَمْنَآ ۚ أَنتَ",183],["3:16:6",52,"فَٱغْفِرْ","so forgive","رَبَّنَآ إِنَّنَآ ءَامَنَّا","لَنَا ذُنُوبَنَا وَقِنَا",183],["3:17:5",52,"وَٱلْمُسْتَغْفِرِينَ","and those who seek forgiveness","وَٱلصَّـٰدِقِينَ وَٱلْقَـٰنِتِينَ وَٱلْمُنفِقِينَ","بِٱلْأَسْحَارِ",3859],["3:31:9",54,"وَيَغْفِرْ","and He will forgive","فَٱتَّبِعُونِى يُحْبِبْكُمُ ٱللَّهُ","لَكُمْ ذُنُوبَكُمْ ۗ وَٱللَّهُ",183],["3:31:13",54,"غَفُورٌۭ","(is) Oft-Forgiving","لَكُمْ ذُنُوبَكُمْ ۗ وَٱللَّهُ","رَّحِيمٌۭ",118],["3:89:10",61,"غَفُورٌۭ","(is) Oft-Forgiving","وَأَصْلَحُوا۟ فَإِنَّ ٱللَّهَ","رَّحِيمٌ",118],["3:129:8",66,"يَغْفِرُ","He forgives","وَمَا فِى ٱلْأَرْضِ ۚ","لِمَن يَشَآءُ وَيُعَذِّبُ",183],["3:129:15",66,"غَفُورٌۭ","(is) Oft-Forgiving","مَن يَشَآءُ ۚ وَٱللَّهُ","رَّحِيمٌۭ",118],["3:133:3",67,"مَغْفِرَةٍۢ","forgiveness","۞ وَسَارِعُوٓا۟ إِلَىٰ","مِّن رَّبِّكُمْ وَجَنَّةٍ",390],["3:135:10",67,"فَٱسْتَغْفَرُوا۟","then ask forgiveness","أَنفُسَهُمْ ذَكَرُوا۟ ٱللَّهَ","لِذُنُوبِهِمْ وَمَن يَغْفِرُ",296],["3:135:13",67,"يَغْفِرُ","(can) forgive","فَٱسْتَغْفَرُوا۟ لِذُنُوبِهِمْ وَمَن","ٱلذُّنُوبَ إِلَّا ٱللَّهُ",183],["3:136:3",67,"مَّغْفِرَةٌۭ","(is) forgiveness","أُو۟لَـٰٓئِكَ جَزَآؤُهُم","مِّن رَّبِّهِمْ وَجَنَّـٰتٌۭ",390],["3:147:8",68,"ٱغْفِرْ","forgive","أَن قَالُوا۟ رَبَّنَا","لَنَا ذُنُوبَنَا وَإِسْرَافَنَا",183],["3:155:20",70,"غَفُورٌ","(is) Oft-Forgiving","عَنْهُمْ ۗ إِنَّ ٱللَّهَ","حَلِيمٌۭ",118],["3:157:8",70,"لَمَغْفِرَةٌۭ","certainly forgiveness","ٱللَّهِ أَوْ مُتُّمْ","مِّنَ ٱللَّهِ وَرَحْمَةٌ",390],["3:159:17",71,"وَٱسْتَغْفِرْ","and ask forgiveness","حَوْلِكَ ۖ فَٱعْفُ عَنْهُمْ","لَهُمْ وَشَاوِرْهُمْ فِى",296],["3:193:12",75,"فَٱغْفِرْ","so forgive","بِرَبِّكُمْ فَـَٔامَنَّا ۚ رَبَّنَا","لَنَا ذُنُوبَنَا وَكَفِّرْ",183],["4:23:53",81,"غَفُورًۭا","Oft-Forgiving","إِنَّ ٱللَّهَ كَانَ","رَّحِيمًۭا",118],["4:25:57",82,"غَفُورٌۭ","(is) Oft-Forgiving","خَيْرٌۭ لَّكُمْ ۗ وَٱللَّهُ","رَّحِيمٌۭ",118],["4:43:48",85,"غَفُورًا","Oft-Forgiving","ٱللَّهَ كَانَ عَفُوًّا","",118],["4:48:4",86,"يَغْفِرُ","forgive","إِنَّ ٱللَّهَ لَا","أَن يُشْرَكَ بِهِۦ",183],["4:48:8",86,"وَيَغْفِرُ","but He forgives","أَن يُشْرَكَ بِهِۦ","مَا دُونَ ذَٰلِكَ",183],["4:64:15",88,"فَٱسْتَغْفَرُوا۟","and asked forgiveness","ظَّلَمُوٓا۟ أَنفُسَهُمْ جَآءُوكَ","ٱللَّهَ وَٱسْتَغْفَرَ لَهُمُ",296],["4:64:17",88,"وَٱسْتَغْفَرَ","and asked forgiveness","جَآءُوكَ فَٱسْتَغْفَرُوا۟ ٱللَّهَ","لَهُمُ ٱلرَّسُولُ لَوَجَدُوا۟",296],["4:96:3",94,"وَمَغْفِرَةًۭ","and forgiveness","دَرَجَـٰتٍۢ مِّنْهُ","وَرَحْمَةًۭ ۚ وَكَانَ ٱللَّهُ",390],["4:96:7",94,"غَفُورًۭا","Oft-Forgiving","وَرَحْمَةًۭ ۚ وَكَانَ ٱللَّهُ","رَّحِيمًا",118],["4:99:10",94,"غَفُورًۭا","Oft-Forgiving","وَكَانَ ٱللَّهُ عَفُوًّا","",118],["4:100:30",94,"غَفُورًۭا","Oft-Forgiving","ٱللَّهِ ۗ وَكَانَ ٱللَّهُ","رَّحِيمًۭا",118],["4:106:1",96,"وَٱسْتَغْفِرِ","And seek forgiveness","","ٱللَّهَ ۖ إِنَّ ٱللَّهَ",296],["4:106:6",96,"غَفُورًۭا","Oft-Forgiving","إِنَّ ٱللَّهَ كَانَ","رَّحِيمًۭا",118],["4:110:8",96,"يَسْتَغْفِرِ","seeks forgiveness","يَظْلِمْ نَفْسَهُۥ ثُمَّ","ٱللَّهَ يَجِدِ ٱللَّهَ",296],["4:110:12",96,"غَفُورًۭا","Oft-Forgiving","ٱللَّهَ يَجِدِ ٱللَّهَ","رَّحِيمًۭا",118],["4:116:4",97,"يَغْفِرُ","forgive","إِنَّ ٱللَّهَ لَا","أَن يُشْرَكَ بِهِۦ",183],["4:116:8",97,"وَيَغْفِرُ","but He forgives","أَن يُشْرَكَ بِهِۦ","مَا دُونَ ذَٰلِكَ",183],["4:129:21",99,"غَفُورًۭا","Oft-Forgiving","فَإِنَّ ٱللَّهَ كَانَ","رَّحِيمًۭا",118],["4:137:16",100,"لِيَغْفِرَ","forgive","لَّمْ يَكُنِ ٱللَّهُ","لَهُمْ وَلَا لِيَهْدِيَهُمْ",183],["4:152:16",102,"غَفُورًۭا","Oft-Forgiving","أُجُورَهُمْ ۗ وَكَانَ ٱللَّهُ","رَّحِيمًۭا",118],["4:168:8",104,"لِيَغْفِرَ","[to] forgive","لَمْ يَكُنِ ٱللَّهُ","لَهُمْ وَلَا لِيَهْدِيَهُمْ",183],["5:3:60",107,"غَفُورٌۭ","(is) Oft-Forgiving","لِّإِثْمٍۢ ۙ فَإِنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["5:9:8",108,"مَّغْفِرَةٌۭ","(is) forgiveness","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ ۙ لَهُم","وَأَجْرٌ عَظِيمٌۭ",390],["5:18:17",111,"يَغْفِرُ","He forgives","بَشَرٌۭ مِّمَّنْ خَلَقَ ۚ","لِمَن يَشَآءُ وَيُعَذِّبُ",183],["5:34:12",113,"غَفُورٌۭ","(is) Oft-Forgiving","فَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["5:39:13",114,"غَفُورٌۭ","(is) Oft-Forgiving","عَلَيْهِ ۗ إِنَّ ٱللَّهَ","رَّحِيمٌ",118],["5:40:12",114,"وَيَغْفِرُ","and He forgives","يُعَذِّبُ مَن يَشَآءُ","لِمَن يَشَآءُ ۗ وَٱللَّهُ",183],["5:74:5",120,"وَيَسْتَغْفِرُونَهُۥ ۚ","and seek His forgiveness","يَتُوبُونَ إِلَى ٱللَّهِ","وَٱللَّهُ غَفُورٌۭ رَّحِيمٌۭ",296],["5:74:7",120,"غَفُورٌۭ","(is) Oft-Forgiving","ٱللَّهِ وَيَسْتَغْفِرُونَهُۥ ۚ وَٱللَّهُ","رَّحِيمٌۭ",118],["5:98:8",124,"غَفُورٌۭ","(is) Oft-Forgiving","ٱلْعِقَابِ وَأَنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["5:101:24",124,"غَفُورٌ","(is) Oft-Forgiving","ٱللَّهُ عَنْهَا ۗ وَٱللَّهُ","حَلِيمٌۭ",118],["5:118:6",127,"تَغْفِرْ","You forgive","فَإِنَّهُمْ عِبَادُكَ ۖ وَإِن","لَهُمْ فَإِنَّكَ أَنتَ",183],["6:54:26",134,"غَفُورٌۭ","(is) Oft-Forgiving","بَعْدِهِۦ وَأَصْلَحَ فَأَنَّهُۥ","رَّحِيمٌۭ",118],["6:145:38",147,"غَفُورٌۭ","(is) Oft-Forgiving","عَادٍۢ فَإِنَّ رَبَّكَ","رَّحِيمٌۭ",118],["6:165:20",150,"لَغَفُورٌۭ","[certainly], Oft-Forgiving","سَرِيعُ ٱلْعِقَابِ وَإِنَّهُۥ","رَّحِيمٌۢ",118],["7:23:7",153,"تَغْفِرْ","You forgive","أَنفُسَنَا وَإِن لَّمْ","لَنَا وَتَرْحَمْنَا لَنَكُونَنَّ",183],["7:149:14",168,"وَيَغْفِرْ","and forgive","لَّمْ يَرْحَمْنَا رَبُّنَا","لَنَا لَنَكُونَنَّ مِنَ",183],["7:151:3",169,"ٱغْفِرْ","Forgive","قَالَ رَبِّ","لِى وَلِأَخِى وَأَدْخِلْنَا",183],["7:153:13",169,"لَغَفُورٌۭ","(is) surely Oft-Forgiving","رَبَّكَ مِنۢ بَعْدِهَا","رَّحِيمٌۭ",118],["7:155:36",169,"فَٱغْفِرْ","so forgive","تَشَآءُ ۖ أَنتَ وَلِيُّنَا","لَنَا وَٱرْحَمْنَا ۖ وَأَنتَ",183],["7:155:41",169,"ٱلْغَـٰفِرِينَ","(of) Forgivers","وَٱرْحَمْنَا ۖ وَأَنتَ خَيْرُ","",2370],["7:161:16",171,"نَّغْفِرْ","We will forgive","وَٱدْخُلُوا۟ ٱلْبَابَ سُجَّدًۭا","لَكُمْ خَطِيٓـَٔـٰتِكُمْ ۚ سَنَزِيدُ",183],["7:167:18",172,"لَغَفُورٌۭ","(is) surely Oft-Forgiving","لَسَرِيعُ ٱلْعِقَابِ ۖ وَإِنَّهُۥ","رَّحِيمٌۭ",118],["7:169:12",172,"سَيُغْفَرُ","It will be forgiven","هَـٰذَا ٱلْأَدْنَىٰ وَيَقُولُونَ","لَنَا وَإِن يَأْتِهِمْ",183],["8:4:9",177,"وَمَغْفِرَةٌۭ","and forgiveness","دَرَجَـٰتٌ عِندَ رَبِّهِمْ","وَرِزْقٌۭ كَرِيمٌۭ",390],["8:29:13",180,"وَيَغْفِرْ","and forgive","وَيُكَفِّرْ عَنكُمْ سَيِّـَٔاتِكُمْ","لَكُمْ ۗ وَٱللَّهُ ذُو",183],["8:33:12",180,"يَسْتَغْفِرُونَ","seek forgiveness","ٱللَّهُ مُعَذِّبَهُمْ وَهُمْ","",296],["8:38:6",181,"يُغْفَرْ","will be forgiven","كَفَرُوٓا۟ إِن يَنتَهُوا۟","لَهُم مَّا قَدْ",183],["8:69:10",185,"غَفُورٌۭ","(is) Oft-Forgiving","ٱللَّهَ ۚ إِنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["8:70:20",186,"وَيَغْفِرْ","and He will forgive","مِّمَّآ أُخِذَ مِنكُمْ","لَكُمْ ۗ وَٱللَّهُ غَفُورٌۭ",183],["8:70:23",186,"غَفُورٌۭ","(is) Oft-Forgiving","وَيَغْفِرْ لَكُمْ ۗ وَٱللَّهُ","رَّحِيمٌۭ",118],["8:74:16",186,"مَّغْفِرَةٌۭ","(is) forgiveness","ٱلْمُؤْمِنُونَ حَقًّۭا ۚ لَّهُم","وَرِزْقٌۭ كَرِيمٌۭ",390],["9:5:25",187,"غَفُورٌۭ","(is) Oft-Forgiving","سَبِيلَهُمْ ۚ إِنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["9:27:11",191,"غَفُورٌۭ","(is) Oft-Forgiving","مَن يَشَآءُ ۗ وَٱللَّهُ","رَّحِيمٌۭ",118],["9:80:1",200,"ٱسْتَغْفِرْ","Ask forgiveness","","لَهُمْ أَوْ لَا",296],["9:80:5",200,"تَسْتَغْفِرْ","ask forgiveness","لَهُمْ أَوْ لَا","لَهُمْ إِن تَسْتَغْفِرْ",296],["9:80:8",200,"تَسْتَغْفِرْ","you ask forgiveness","تَسْتَغْفِرْ لَهُمْ إِن","لَهُمْ سَبْعِينَ مَرَّةًۭ",296],["9:80:13",200,"يَغْفِرَ","will Allah forgive","سَبْعِينَ مَرَّةًۭ فَلَن","ٱللَّهُ لَهُمْ ۚ ذَٰلِكَ",183],["9:91:25",201,"غَفُورٌۭ","(is) Oft-Forgiving","مِن سَبِيلٍۢ ۚ وَٱللَّهُ","رَّحِيمٌۭ",118],["9:99:26",202,"غَفُورٌۭ","(is) Oft-Forgiving","رَحْمَتِهِۦٓ ۗ إِنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["9:102:16",203,"غَفُورٌۭ","(is) Oft-Forgiving","عَلَيْهِمْ ۚ إِنَّ ٱللَّهَ","رَّحِيمٌ",118],["9:113:7",205,"يَسْتَغْفِرُوا۟","they ask forgiveness","وَٱلَّذِينَ ءَامَنُوٓا۟ أَن","لِلْمُشْرِكِينَ وَلَوْ كَانُوٓا۟",296],["9:114:3",205,"ٱسْتِغْفَارُ","(the) asking of forgiveness","وَمَا كَانَ","إِبْرَٰهِيمَ لِأَبِيهِ إِلَّا",4841],["10:107:23",221,"ٱلْغَفُورُ","(is) the Oft-Forgiving","مِنْ عِبَادِهِۦ ۚ وَهُوَ","ٱلرَّحِيمُ",118],["11:3:2",221,"ٱسْتَغْفِرُوا۟","Seek forgiveness","وَأَنِ","رَبَّكُمْ ثُمَّ تُوبُوٓا۟",296],["11:11:8",222,"مَّغْفِرَةٌۭ","(will be) forgiveness","ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ لَهُم","وَأَجْرٌۭ كَبِيرٌۭ",390],["11:41:10",226,"لَغَفُورٌۭ","(is) certainly Oft-Forgiving","وَمُرْسَىٰهَآ ۚ إِنَّ رَبِّى","رَّحِيمٌۭ",118],["11:47:14",227,"تَغْفِرْ","You forgive","بِهِۦ عِلْمٌۭ ۖ وَإِلَّا","لِى وَتَرْحَمْنِىٓ أَكُن",183],["11:52:2",227,"ٱسْتَغْفِرُوا۟","Ask forgiveness","وَيَـٰقَوْمِ","رَبَّكُمْ ثُمَّ تُوبُوٓا۟",296],["11:61:20",228,"فَٱسْتَغْفِرُوهُ","So ask forgiveness of Him","ٱلْأَرْضِ وَٱسْتَعْمَرَكُمْ فِيهَا","ثُمَّ تُوبُوٓا۟ إِلَيْهِ ۚ",296],["11:90:1",232,"وَٱسْتَغْفِرُوا۟","And ask forgiveness","","رَبَّكُمْ ثُمَّ تُوبُوٓا۟",296],["12:29:5",238,"وَٱسْتَغْفِرِى","And ask forgiveness","أَعْرِضْ عَنْ هَـٰذَا ۚ","لِذَنۢبِكِ ۖ إِنَّكِ كُنتِ",296],["12:53:14",242,"غَفُورٌۭ","(is) Oft-Forgiving","رَبِّىٓ ۚ إِنَّ رَبِّى","رَّحِيمٌۭ",118],["12:92:6",246,"يَغْفِرُ","Allah will forgive","تَثْرِيبَ عَلَيْكُمُ ٱلْيَوْمَ ۖ","ٱللَّهُ لَكُمْ ۖ وَهُوَ",183],["12:97:3",247,"ٱسْتَغْفِرْ","Ask forgiveness","قَالُوا۟ يَـٰٓأَبَانَا","لَنَا ذُنُوبَنَآ إِنَّا",296],["12:98:3",247,"أَسْتَغْفِرُ","I will ask forgiveness","قَالَ سَوْفَ","لَكُمْ رَبِّىٓ ۖ إِنَّهُۥ",296],["12:98:8",247,"ٱلْغَفُورُ","(is) the Oft-Forgiving","رَبِّىٓ ۖ إِنَّهُۥ هُوَ","ٱلرَّحِيمُ",118],["13:6:13",250,"مَغْفِرَةٍۢ","(of) forgiveness","وَإِنَّ رَبَّكَ لَذُو","لِّلنَّاسِ عَلَىٰ ظُلْمِهِمْ ۖ",390],["14:10:10",256,"لِيَغْفِرَ","so that He may forgive","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ يَدْعُوكُمْ","لَكُم مِّن ذُنُوبِكُمْ",183],["14:36:14",260,"غَفُورٌۭ","(are) Oft-Forgiving","وَمَنْ عَصَانِى فَإِنَّكَ","رَّحِيمٌۭ",118],["14:41:2",260,"ٱغْفِرْ","Forgive","رَبَّنَا","لِى وَلِوَٰلِدَىَّ وَلِلْمُؤْمِنِينَ",183],["15:49:5",264,"ٱلْغَفُورُ","the Oft-Forgiving","عِبَادِىٓ أَنِّىٓ أَنَا","ٱلرَّحِيمُ",118],["16:18:9",269,"لَغَفُورٌۭ","(is) Oft-Forgiving","تُحْصُوهَآ ۗ إِنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["16:110:17",279,"لَغَفُورٌۭ","surely is Oft-Forgiving","رَبَّكَ مِنۢ بَعْدِهَا","رَّحِيمٌۭ",118],["16:115:21",280,"غَفُورٌۭ","(is) Oft-Forgiving","عَادٍۢ فَإِنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["16:119:18",281,"لَغَفُورٌۭ","(is) surely Oft-Forgiving","رَبَّكَ مِنۢ بَعْدِهَا","رَّحِيمٌ",118],["17:25:12",284,"غَفُورًۭا","Most Forgiving","فَإِنَّهُۥ كَانَ لِلْأَوَّٰبِينَ","",118],["17:44:21",286,"غَفُورًۭا","Oft-Forgiving","إِنَّهُۥ كَانَ حَلِيمًا","",118],["18:55:9",300,"وَيَسْتَغْفِرُوا۟","and they ask forgiveness","إِذْ جَآءَهُمُ ٱلْهُدَىٰ","رَبَّهُمْ إِلَّآ أَن",296],["18:58:2",300,"ٱلْغَفُورُ","(is) the Most Forgiving","وَرَبُّكَ","ذُو ٱلرَّحْمَةِ ۖ لَوْ",118],["19:47:4",308,"سَأَسْتَغْفِرُ","I will ask forgiveness","قَالَ سَلَـٰمٌ عَلَيْكَ ۖ","لَكَ رَبِّىٓ ۖ إِنَّهُۥ",296],["20:73:4",316,"لِيَغْفِرَ","that He may forgive","إِنَّآ ءَامَنَّا بِرَبِّنَا","لَنَا خَطَـٰيَـٰنَا وَمَآ",183],["20:82:2",317,"لَغَفَّارٌۭ","the Perpetual Forgiver","وَإِنِّى","لِّمَن تَابَ وَءَامَنَ",1336],["22:50:6",338,"مَّغْفِرَةٌۭ","(is) forgiveness","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُم","وَرِزْقٌۭ كَرِيمٌۭ",390],["22:60:16",339,"غَفُورٌۭ","Oft-Forgiving","إِنَّ ٱللَّهَ لَعَفُوٌّ","",118],["23:109:9",349,"فَٱغْفِرْ","so forgive","يَقُولُونَ رَبَّنَآ ءَامَنَّا","لَنَا وَٱرْحَمْنَا وَأَنتَ",183],["23:118:3",349,"ٱغْفِرْ","Forgive","وَقُل رَّبِّ","وَٱرْحَمْ وَأَنتَ خَيْرُ",183],["24:5:10",350,"غَفُورٌۭ","(is) Oft-Forgiving","وَأَصْلَحُوا۟ فَإِنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["24:22:21",352,"يَغْفِرَ","Allah should forgive","أَلَا تُحِبُّونَ أَن","ٱللَّهُ لَكُمْ ۗ وَٱللَّهُ",183],["24:22:25",352,"غَفُورٌۭ","(is) Oft-Forgiving","ٱللَّهُ لَكُمْ ۗ وَٱللَّهُ","رَّحِيمٌ",118],["24:26:14",352,"مَّغْفِرَةٌۭ","(is) forgiveness","مِمَّا يَقُولُونَ ۖ لَهُم","وَرِزْقٌۭ كَرِيمٌۭ",390],["24:33:47",354,"غَفُورٌۭ","(is) Oft-Forgiving","مِنۢ بَعْدِ إِكْرَٰهِهِنَّ","رَّحِيمٌۭ",118],["24:62:33",359,"وَٱسْتَغْفِرْ","and ask forgiveness","لِّمَن شِئْتَ مِنْهُمْ","لَهُمُ ٱللَّهَ ۚ إِنَّ",296],["24:62:38",359,"غَفُورٌۭ","(is) Oft-Forgiving","ٱللَّهَ ۚ إِنَّ ٱللَّهَ","رَّحِيمٌۭ",118],["25:6:11",360,"غَفُورًۭا","Oft-Forgiving","وَٱلْأَرْضِ ۚ إِنَّهُۥ كَانَ","رَّحِيمًۭا",118],["25:70:15",366,"غَفُورًۭا","Oft-Forgiving","حَسَنَـٰتٍۢ ۗ وَكَانَ ٱللَّهُ","رَّحِيمًۭا",118],["26:51:4",369,"يَغْفِرَ","will forgive","إِنَّا نَطْمَعُ أَن","لَنَا رَبُّنَا خَطَـٰيَـٰنَآ",183],["26:82:4",370,"يَغْفِرَ","He will forgive","وَٱلَّذِىٓ أَطْمَعُ أَن","لِى خَطِيٓـَٔتِى يَوْمَ",183],["26:86:1",371,"وَٱغْفِرْ","And forgive","","لِأَبِىٓ إِنَّهُۥ كَانَ",183],["27:11:10",377,"غَفُورٌۭ","Oft-Forgiving","بَعْدَ سُوٓءٍۢ فَإِنِّى","رَّحِيمٌۭ",118],["27:46:9",381,"تَسْتَغْفِرُونَ","you ask forgiveness","قَبْلَ ٱلْحَسَنَةِ ۖ لَوْلَا","ٱللَّهَ لَعَلَّكُمْ تُرْحَمُونَ",296],["28:16:6",387,"فَٱغْفِرْ","so forgive","إِنِّى ظَلَمْتُ نَفْسِى","لِى فَغَفَرَ لَهُۥٓ ۚ",183],["28:16:8",387,"فَغَفَرَ","Then He forgave","نَفْسِى فَٱغْفِرْ لِى","لَهُۥٓ ۚ إِنَّهُۥ هُوَ",183],["28:16:12",387,"ٱلْغَفُورُ","the Oft-Forgiving","لَهُۥٓ ۚ إِنَّهُۥ هُوَ","ٱلرَّحِيمُ",118],["33:5:27",418,"غَفُورًۭا","(is) Oft-Forgiving","قُلُوبُكُمْ ۚ وَكَانَ ٱللَّهُ","رَّحِيمًا",118],["33:24:15",421,"غَفُورًۭا","Oft-Forgiving","إِنَّ ٱللَّهَ كَانَ","رَّحِيمًۭا",118],["33:35:28",422,"مَّغْفِرَةًۭ","forgiveness","أَعَدَّ ٱللَّهُ لَهُم","وَأَجْرًا عَظِيمًۭا",390],["33:50:60",424,"غَفُورًۭا","Oft-Forgiving","حَرَجٌۭ ۗ وَكَانَ ٱللَّهُ","رَّحِيمًۭا",118],["33:59:20",426,"غَفُورًۭا","Oft-Forgiving","يُؤْذَيْنَ ۗ وَكَانَ ٱللَّهُ","رَّحِيمًۭا",118],["33:71:4",427,"وَيَغْفِرْ","and forgive","يُصْلِحْ لَكُمْ أَعْمَـٰلَكُمْ","لَكُمْ ذُنُوبَكُمْ ۗ وَمَن",183],["33:73:14",427,"غَفُورًۭا","Oft-Forgiving","وَٱلْمُؤْمِنَـٰتِ ۗ وَكَانَ ٱللَّهُ","رَّحِيمًۢا",118],["34:2:18",428,"ٱلْغَفُورُ","the Oft-Forgiving","فِيهَا ۚ وَهُوَ ٱلرَّحِيمُ","",118],["34:4:8",428,"مَّغْفِرَةٌۭ","(will be) forgiveness","ٱلصَّـٰلِحَـٰتِ ۚ أُو۟لَـٰٓئِكَ لَهُم","وَرِزْقٌۭ كَرِيمٌۭ",390],["34:15:20",430,"غَفُورٌۭ","Oft-Forgiving","بَلْدَةٌۭ طَيِّبَةٌۭ وَرَبٌّ","",118],["35:7:11",435,"مَّغْفِرَةٌۭ","(will be) forgiveness","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُم","وَأَجْرٌۭ كَبِيرٌ",390],["35:28:17",437,"غَفُورٌ","Oft-Forgiving","إِنَّ ٱللَّهَ عَزِيزٌ","",118],["35:30:7",437,"غَفُورٌۭ","(is) Oft-Forgiving","مِّن فَضْلِهِۦٓ ۚ إِنَّهُۥ","شَكُورٌۭ",118],["35:34:10",438,"لَغَفُورٌۭ","(is) surely Oft-Forgiving","ٱلْحَزَنَ ۖ إِنَّ رَبَّنَا","شَكُورٌ",118],["35:41:19",439,"غَفُورًۭا","Oft-Forgiving","إِنَّهُۥ كَانَ حَلِيمًا","",118],["36:11:10",440,"بِمَغْفِرَةٍۢ","of forgiveness","ٱلرَّحْمَـٰنَ بِٱلْغَيْبِ ۖ فَبَشِّرْهُ","وَأَجْرٍۢ كَرِيمٍ",390],["36:27:2",441,"غَفَرَ","has forgiven","بِمَا","لِى رَبِّى وَجَعَلَنِى",183],["38:24:28",454,"فَٱسْتَغْفَرَ","and he asked forgiveness","دَاوُۥدُ أَنَّمَا فَتَنَّـٰهُ","رَبَّهُۥ وَخَرَّ رَاكِعًۭا",296],["38:25:1",454,"فَغَفَرْنَا","So We forgave","","لَهُۥ ذَٰلِكَ ۖ وَإِنَّ",183],["38:35:3",455,"ٱغْفِرْ","Forgive","قَالَ رَبِّ","لِى وَهَبْ لِى",183],["38:66:7",457,"ٱلْغَفَّـٰرُ","the Oft-Forgiving","وَمَا بَيْنَهُمَا ٱلْعَزِيزُ","",1336],["39:5:23",458,"ٱلْغَفَّـٰرُ","the Oft-Forgiving","أَلَا هُوَ ٱلْعَزِيزُ","",1336],["39:53:14",464,"يَغْفِرُ","forgives","ٱللَّهِ ۚ إِنَّ ٱللَّهَ","ٱلذُّنُوبَ جَمِيعًا ۚ إِنَّهُۥ",183],["39:53:19",464,"ٱلْغَفُورُ","(is) the Oft-Forgiving","جَمِيعًا ۚ إِنَّهُۥ هُوَ","ٱلرَّحِيمُ",118],["40:3:1",467,"غَافِرِ","(The) Forgiver","","ٱلذَّنۢبِ وَقَابِلِ ٱلتَّوْبِ",2370],["40:7:11",467,"وَيَسْتَغْفِرُونَ","and ask forgiveness","رَبِّهِمْ وَيُؤْمِنُونَ بِهِۦ","لِلَّذِينَ ءَامَنُوا۟ رَبَّنَا",296],["40:7:20",467,"فَٱغْفِرْ","so forgive","شَىْءٍۢ رَّحْمَةًۭ وَعِلْمًۭا","لِلَّذِينَ تَابُوا۟ وَٱتَّبَعُوا۟",183],["40:42:15",472,"ٱلْغَفَّـٰرِ","the Oft-Forgiving","أَدْعُوكُمْ إِلَى ٱلْعَزِيزِ","",1336],["40:55:6",473,"وَٱسْتَغْفِرْ","And ask forgiveness","وَعْدَ ٱللَّهِ حَقٌّۭ","لِذَنۢبِكَ وَسَبِّحْ بِحَمْدِ",296],["41:6:14",477,"وَٱسْتَغْفِرُوهُ ۗ","and ask His forgiveness","وَٰحِدٌۭ فَٱسْتَقِيمُوٓا۟ إِلَيْهِ","وَوَيْلٌۭ لِّلْمُشْرِكِينَ",296],["41:32:3",480,"غَفُورٍۢ","(the) Oft-Forgiving","نُزُلًۭا مِّنْ","رَّحِيمٍۢ",118],["41:43:14",481,"مَغْفِرَةٍۢ","(of) forgiveness","إِنَّ رَبَّكَ لَذُو","وَذُو عِقَابٍ أَلِيمٍۢ",390],["42:5:10",483,"وَيَسْتَغْفِرُونَ","and ask for forgiveness","يُسَبِّحُونَ ب