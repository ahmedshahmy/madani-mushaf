57,"وَيَغْفِرْ","and will forgive","حَسَنًۭا يُضَـٰعِفْهُ لَكُمْ","لَكُمْ ۚ وَٱللَّهُ شَكُورٌ",183],["66:1:13",560,"غَفُورٌۭ","(is) Oft-Forgiving","مَرْضَاتَ أَزْوَٰجِكَ ۚ وَٱللَّهُ","رَّحِيمٌۭ",118],["66:8:39",561,"وَٱغْفِرْ","and grant forgiveness","أَتْمِمْ لَنَا نُورَنَا","لَنَآ ۖ إِنَّكَ عَلَىٰ",183],["67:2:11",562,"ٱلْغَفُورُ","the Oft-Forgiving","عَمَلًۭا ۚ وَهُوَ ٱلْعَزِيزُ","",118],["67:12:7",562,"مَّغْفِرَةٌۭ","(is) forgiveness","رَبَّهُم بِٱلْغَيْبِ لَهُم","وَأَجْرٌۭ كَبِيرٌۭ",390],["71:4:1",570,"يَغْفِرْ","He will forgive","","لَكُم مِّن ذُنُوبِكُمْ",183],["71:7:4",570,"لِتَغْفِرَ","that You may forgive","وَإِنِّى كُلَّمَا دَعَوْتُهُمْ","لَهُمْ جَعَلُوٓا۟ أَصَـٰبِعَهُمْ",183],["71:10:2",570,"ٱسْتَغْفِرُوا۟","Ask forgiveness","فَقُلْتُ","رَبَّكُمْ إِنَّهُۥ كَانَ",296],["71:10:6",570,"غَفَّارًۭا","Oft-Forgiving","رَبَّكُمْ إِنَّهُۥ كَانَ","",1336],["71:28:2",571,"ٱغْفِرْ","Forgive","رَّبِّ","لِى وَلِوَٰلِدَىَّ وَلِمَن",183],["73:20:73",575,"وَٱسْتَغْفِرُوا۟","And seek forgiveness","خَيْرًۭا وَأَعْظَمَ أَجْرًۭا ۚ","ٱللَّهَ ۖ إِنَّ ٱللَّهَ",296],["73:20:77",575,"غَفُورٌۭ","(is) Oft-Forgiving","ٱللَّهَ ۖ إِنَّ ٱللَّهَ","رَّحِيمٌۢ",118],["74:56:11",577,"ٱلْمَغْفِرَةِ","to forgive","أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ","",390],["85:14:2",590,"ٱلْغَفُورُ","(is) the Oft-Forgiving","وَهُوَ","ٱلْوَدُودُ",118],["110:3:4",603,"وَٱسْتَغْفِرْهُ ۚ","and ask His forgiveness","فَسَبِّحْ بِحَمْدِ رَبِّكَ","إِنَّهُۥ كَانَ تَوَّابًۢا",296]]