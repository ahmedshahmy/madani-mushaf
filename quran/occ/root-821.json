[["2:71:8",11,"تُثِيرُ","to plough","بَقَرَةٌۭ لَّا ذَلُولٌۭ","ٱلْأَرْضَ وَلَا تَسْقِى",1282],["30:9:16",405,"وَأَثَارُوا۟","and they dug","أَشَدَّ مِنْهُمْ قُوَّةًۭ","ٱلْأَرْضَ وَعَمَرُوهَآ أَكْثَرَ",1282],["30:48:5",409,"فَتُثِيرُ","so they raise","ٱلَّذِى يُرْسِلُ ٱلرِّيَـٰحَ","سَحَابًۭا فَيَبْسُطُهُۥ فِى",1282],["35:9:5",435,"فَتُثِيرُ","so that they raise","ٱلَّذِىٓ أَرْسَلَ ٱلرِّيَـٰحَ","سَحَابًۭا فَسُقْنَـٰهُ إِلَىٰ",1282],["100:4:1",599,"فَأَثَرْنَ","Then raise","","بِهِۦ نَقْعًۭا",1282]]