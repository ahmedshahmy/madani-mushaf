[["3:120:8",65,"يَفْرَحُوا۟","they rejoice","وَإِن تُصِبْكُمْ سَيِّئَةٌۭ","بِهَا ۖ وَإِن تَصْبِرُوا۟",593],["3:170:1",72,"فَرِحِينَ","Rejoicing","","بِمَآ ءَاتَىٰهُمُ ٱللَّهُ",1176],["3:188:4",75,"يَفْرَحُونَ","rejoice","لَا تَحْسَبَنَّ ٱلَّذِينَ","بِمَآ أَتَوا۟ وَّيُحِبُّونَ",593],["6:44:13",132,"فَرِحُوا۟","they rejoiced","شَىْءٍ حَتَّىٰٓ إِذَا","بِمَآ أُوتُوٓا۟ أَخَذْنَـٰهُم",593],["9:50:16",195,"فَرِحُونَ","(are) rejoicing","قَبْلُ وَيَتَوَلَّوا۟ وَّهُمْ","",1176],["9:81:1",200,"فَرِحَ","Rejoice","","ٱلْمُخَلَّفُونَ بِمَقْعَدِهِمْ خِلَـٰفَ",593],["10:22:16",211,"وَفَرِحُوا۟","and they rejoice","بِهِم بِرِيحٍۢ طَيِّبَةٍۢ","بِهَا جَآءَتْهَا رِيحٌ",593],["10:58:6",215,"فَلْيَفْرَحُوا۟","let them rejoice","ٱللَّهِ وَبِرَحْمَتِهِۦ فَبِذَٰلِكَ","هُوَ خَيْرٌۭ مِّمَّا",593],["11:10:12",222,"لَفَرِحٌۭ","(is) exultant","ٱلسَّيِّـَٔاتُ عَنِّىٓ ۚ إِنَّهُۥ","فَخُورٌ",1176],["13:26:7",252,"وَفَرِحُوا۟","And they rejoice","لِمَن يَشَآءُ وَيَقْدِرُ ۚ","بِٱلْحَيَوٰةِ ٱلدُّنْيَا وَمَا",593],["13:36:4",254,"يَفْرَحُونَ","rejoice","وَٱلَّذِينَ ءَاتَيْنَـٰهُمُ ٱلْكِتَـٰبَ","بِمَآ أُنزِلَ إِلَيْكَ ۖ",593],["23:53:9",345,"فَرِحُونَ","rejoicing","حِزْبٍۭ بِمَا لَدَيْهِمْ","",1176],["27:36:16",380,"تَفْرَحُونَ","rejoice","بَلْ أَنتُم بِهَدِيَّتِكُمْ","",593],["28:76:24",394,"تَفْرَحْ ۖ","exult","لَهُۥ قَوْمُهُۥ لَا","إِنَّ ٱللَّهَ لَا",593],["28:76:29",394,"ٱلْفَرِحِينَ","the exultant","ٱللَّهَ لَا يُحِبُّ","",1176],["30:4:11",404,"يَفْرَحُ","will rejoice","وَمِنۢ بَعْدُ ۚ وَيَوْمَئِذٍۢ","ٱلْمُؤْمِنُونَ",593],["30:32:11",407,"فَرِحُونَ","rejoicing","حِزْبٍۭ بِمَا لَدَيْهِمْ","",1176],["30:36:5",408,"فَرِحُوا۟","they rejoice","أَذَقْنَا ٱلنَّاسَ رَحْمَةًۭ","بِهَا ۖ وَإِن تُصِبْهُمْ",593],["40:75:4",475,"تَفْرَحُونَ","rejoice","ذَٰلِكُم بِمَا كُنتُمْ","فِى ٱلْأَرْضِ بِغَيْرِ",593],["40:83:5",476,"فَرِحُوا۟","they rejoiced","جَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَـٰتِ","بِمَا عِندَهُم مِّنَ",593],["42:48:17",488,"فَرِحَ","he rejoices","ٱلْإِنسَـٰنَ مِنَّا رَحْمَةًۭ","بِهَا ۖ وَإِن تُصِبْهُمْ",593],["57:23:7",540,"تَفْرَحُوا۟","exult","مَا فَاتَكُمْ وَلَا","بِمَآ ءَاتَىٰكُمْ ۗ وَٱللَّهُ",593]]