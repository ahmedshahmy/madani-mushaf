[["2:95:3",15,"أَبَدًۢا","ever","وَلَن يَتَمَنَّوْهُ","بِمَا قَدَّمَتْ أَيْدِيهِمْ ۗ",382],["4:57:13",87,"أَبَدًۭا ۖ","forever","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ","لَّهُمْ فِيهَآ أَزْوَٰجٌۭ",382],["4:122:13",98,"أَبَدًۭا ۖ","forever","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ","وَعْدَ ٱللَّهِ حَقًّۭا ۚ",382],["4:169:6",104,"أَبَدًۭا ۚ","forever","جَهَنَّمَ خَـٰلِدِينَ فِيهَآ","وَكَانَ ذَٰلِكَ عَلَى",382],["5:24:6",112,"أَبَدًۭا","ever","إِنَّا لَن نَّدْخُلَهَآ","مَّا دَامُوا۟ فِيهَا ۖ",382],["5:119:16",127,"أَبَدًۭا ۚ","forever","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ","رَّضِىَ ٱللَّهُ عَنْهُمْ",382],["9:22:3",190,"أَبَدًا ۚ","forever","خَـٰلِدِينَ فِيهَآ","إِنَّ ٱللَّهَ عِندَهُۥٓ",382],["9:83:13",200,"أَبَدًۭا","ever","لَّن تَخْرُجُوا۟ مَعِىَ","وَلَن تُقَـٰتِلُوا۟ مَعِىَ",382],["9:84:7",200,"أَبَدًۭا","ever","أَحَدٍۢ مِّنْهُم مَّاتَ","وَلَا تَقُمْ عَلَىٰ",382],["9:100:22",203,"أَبَدًۭا ۚ","forever","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ","ذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ",382],["9:108:4",204,"أَبَدًۭا ۚ","ever","لَا تَقُمْ فِيهِ","لَّمَسْجِدٌ أُسِّسَ عَلَى",382],["18:3:3",293,"أَبَدًۭا","forever","مَّـٰكِثِينَ فِيهِ","",382],["18:20:13",295,"أَبَدًۭا","ever","وَلَن تُفْلِحُوٓا۟ إِذًا","",382],["18:35:12",298,"أَبَدًۭا","ever","أَن تَبِيدَ هَـٰذِهِۦٓ","",382],["18:57:30",300,"أَبَدًۭا","ever","فَلَن يَهْتَدُوٓا۟ إِذًا","",382],["24:4:16",350,"أَبَدًۭا ۚ","ever","تَقْبَلُوا۟ لَهُمْ شَهَـٰدَةً","وَأُو۟لَـٰٓئِكَ هُمُ ٱلْفَـٰسِقُونَ",382],["24:17:6",351,"أَبَدًا","ever","أَن تَعُودُوا۟ لِمِثْلِهِۦٓ","إِن كُنتُم مُّؤْمِنِينَ",382],["24:21:26",352,"أَبَدًۭا","ever","مِنكُم مِّنْ أَحَدٍ","وَلَـٰكِنَّ ٱللَّهَ يُزَكِّى",382],["33:53:63",425,"أَبَدًا ۚ","ever","أَزْوَٰجَهُۥ مِنۢ بَعْدِهِۦٓ","إِنَّ ذَٰلِكُمْ كَانَ",382],["33:65:3",427,"أَبَدًۭا ۖ","forever","خَـٰلِدِينَ فِيهَآ","لَّا يَجِدُونَ وَلِيًّۭا",382],["48:12:10",512,"أَبَدًۭا","ever","وَٱلْمُؤْمِنُونَ إِلَىٰٓ أَهْلِيهِمْ","وَزُيِّنَ ذَٰلِكَ فِى",382],["59:11:21",547,"أَبَدًۭا","ever","نُطِيعُ فِيكُمْ أَحَدًا","وَإِن قُوتِلْتُمْ لَنَنصُرَنَّكُمْ",382],["60:4:28",549,"أَبَدًا","forever","وَبَيْنَكُمُ ٱلْعَدَٰوَةُ وَٱلْبَغْضَآءُ","حَتَّىٰ تُؤْمِنُوا۟ بِٱللَّهِ",382],["62:7:3",553,"أَبَدًۢا","ever","وَلَا يَتَمَنَّوْنَهُۥٓ","بِمَا قَدَّمَتْ أَيْدِيهِمْ ۚ",382],["64:9:24",556,"أَبَدًۭا ۚ","forever","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ","ذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ",382],["65:11:29",559,"أَبَدًۭا ۖ","forever","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ","قَدْ أَحْسَنَ ٱللَّهُ",382],["72:23:16",573,"أَبَدًا","forever","جَهَنَّمَ خَـٰلِدِينَ فِيهَآ","",382],["98:8:12",599,"أَبَدًۭا ۖ","forever","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ","رَّضِىَ ٱللَّهُ عَنْهُمْ",382]]