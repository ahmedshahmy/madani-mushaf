[["11:28:16",224,"أَنُلْزِمُكُمُوهَا","should We compel you (to accept) it","عِندِهِۦ فَعُمِّيَتْ عَلَيْكُمْ","وَأَنتُمْ لَهَا كَـٰرِهُونَ",1737],["17:13:3",283,"أَلْزَمْنَـٰهُ","We have fastened to him","وَكُلَّ إِنسَـٰنٍ","طَـٰٓئِرَهُۥ فِى عُنُقِهِۦ ۖ",1737],["20:129:7",321,"لِزَامًۭا","an obligation","مِن رَّبِّكَ لَكَانَ","وَأَجَلٌۭ مُّسَمًّۭى",2432],["25:77:12",366,"لِزَامًۢا","the inevitable (punishment)","كَذَّبْتُمْ فَسَوْفَ يَكُونُ","",2432],["48:26:17",514,"وَأَلْزَمَهُمْ","and made them adhere","رَسُولِهِۦ وَعَلَى ٱلْمُؤْمِنِينَ","كَلِمَةَ ٱلتَّقْوَىٰ وَكَانُوٓا۟",1737]]