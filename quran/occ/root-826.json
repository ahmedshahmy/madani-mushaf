[["2:168:11",25,"خُطُوَٰتِ","(the) footsteps (of)","طَيِّبًۭا وَلَا تَتَّبِعُوا۟","ٱلشَّيْطَـٰنِ ۚ إِنَّهُۥ لَكُمْ",1424],["2:208:10",32,"خُطُوَٰتِ","footsteps","كَآفَّةًۭ وَلَا تَتَّبِعُوا۟","ٱلشَّيْطَـٰنِ ۚ إِنَّهُۥ لَكُمْ",1424],["6:142:11",146,"خُطُوَٰتِ","(the) footsteps","ٱللَّهُ وَلَا تَتَّبِعُوا۟","ٱلشَّيْطَـٰنِ ۚ إِنَّهُۥ لَكُمْ",1424],["24:21:6",352,"خُطُوَٰتِ","(the) footsteps","ءَامَنُوا۟ لَا تَتَّبِعُوا۟","ٱلشَّيْطَـٰنِ ۚ وَمَن يَتَّبِعْ",1424],["24:21:10",352,"خُطُوَٰتِ","(the) footsteps","ٱلشَّيْطَـٰنِ ۚ وَمَن يَتَّبِعْ","ٱلشَّيْطَـٰنِ فَإِنَّهُۥ يَأْمُرُ",1424]]