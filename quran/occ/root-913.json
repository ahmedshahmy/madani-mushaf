[["12:18:8",237,"سَوَّلَتْ","has enticed you","كَذِبٍۢ ۚ قَالَ بَلْ","لَكُمْ أَنفُسُكُمْ أَمْرًۭا ۖ",1641],["12:83:3",245,"سَوَّلَتْ","have enticed","قَالَ بَلْ","لَكُمْ أَنفُسُكُمْ أَمْرًۭا ۖ",1641],["20:96:14",318,"سَوَّلَتْ","suggested","ٱلرَّسُولِ فَنَبَذْتُهَا وَكَذَٰلِكَ","لِى نَفْسِى",1641],["47:25:13",509,"سَوَّلَ","enticed","لَهُمُ ٱلْهُدَى ۙ ٱلشَّيْطَـٰنُ","لَهُمْ وَأَمْلَىٰ لَهُمْ",1641]]