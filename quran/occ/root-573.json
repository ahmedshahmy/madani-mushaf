[["4:25:5",82,"طَوْلًا","afford","لَّمْ يَسْتَطِعْ مِنكُمْ","أَن يَنكِحَ ٱلْمُحْصَنَـٰتِ",1802],["9:86:12",200,"ٱلطَّوْلِ","(of) wealth","رَسُولِهِ ٱسْتَـْٔذَنَكَ أُو۟لُوا۟","مِنْهُمْ وَقَالُوا۟ ذَرْنَا",1802],["17:37:13",285,"طُولًۭا","(in) height","وَلَن تَبْلُغَ ٱلْجِبَالَ","",3299],["20:86:14",317,"أَفَطَالَ","Then, did seem long","رَبُّكُمْ وَعْدًا حَسَنًا ۚ","عَلَيْكُمُ ٱلْعَهْدُ أَمْ",1799],["21:44:6",325,"طَالَ","grew long","هَـٰٓؤُلَآءِ وَءَابَآءَهُمْ حَتَّىٰ","عَلَيْهِمُ ٱلْعُمُرُ ۗ أَفَلَا",1799],["28:45:4",391,"فَتَطَاوَلَ","and prolonged","وَلَـٰكِنَّآ أَنشَأْنَا قُرُونًۭا","عَلَيْهِمُ ٱلْعُمُرُ ۚ وَمَا",4344],["40:3:8",467,"ٱلطَّوْلِ ۖ","Owner (of) the abundance","شَدِيدِ ٱلْعِقَابِ ذِى","لَآ إِلَـٰهَ إِلَّا",1802],["57:16:21",539,"فَطَالَ","(and) was prolonged","ٱلْكِتَـٰبَ مِن قَبْلُ","عَلَيْهِمُ ٱلْأَمَدُ فَقَسَتْ",1799],["73:7:6",574,"طَوِيلًۭا","prolonged","فِى ٱلنَّهَارِ سَبْحًۭا","",2309],["76:26:7",580,"طَوِيلًا","long","لَهُۥ وَسَبِّحْهُ لَيْلًۭا","",2309]]