[["3:30:19",54,"أَمَدًۢا","(was) a distance","أَنَّ بَيْنَهَا وَبَيْنَهُۥٓ","بَعِيدًۭا ۗ وَيُحَذِّرُكُمُ ٱللَّهُ",1474],["18:12:9",294,"أَمَدًۭا","(in) time","أَحْصَىٰ لِمَا لَبِثُوٓا۟","",1474],["57:16:23",539,"ٱلْأَمَدُ","the term","قَبْلُ فَطَالَ عَلَيْهِمُ","فَقَسَتْ قُلُوبُهُمْ ۖ وَكَثِيرٌۭ",1474],["72:25:11",573,"أَمَدًا","a (distant) term","يَجْعَلُ لَهُۥ رَبِّىٓ","",1474]]