[["22:19:13",334,"يُصَبُّ","Will be poured","ثِيَابٌۭ مِّن نَّارٍۢ","مِن فَوْقِ رُءُوسِهِمُ",1519],["44:48:2",498,"صُبُّوا۟","pour","ثُمَّ","فَوْقَ رَأْسِهِۦ مِنْ",1519],["80:25:2",585,"صَبَبْنَا","[We] poured","اَنَّا","ٱلْمَآءَ صَبًّۭا",1519],["80:25:4",585,"صَبًّۭا","(in) abundance","اَنَّا صَبَبْنَا ٱلْمَآءَ","",3238],["89:13:1",593,"فَصَبَّ","So poured","","عَلَيْهِمْ رَبُّكَ سَوْطَ",1519]]