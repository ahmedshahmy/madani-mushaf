 ٱللَّهُ ءَايَـٰتِهِۦ ۗ",34],["22:58:6",339,"ثُمَّ","then","فِى سَبِيلِ ٱللَّهِ","قُتِلُوٓا۟ أَوْ مَاتُوا۟",34],["22:60:8",339,"ثُمَّ","then","مَا عُوقِبَ بِهِۦ","بُغِىَ عَلَيْهِ لَيَنصُرَنَّهُ",34],["22:66:4",340,"ثُمَّ","then","وَهُوَ ٱلَّذِىٓ أَحْيَاكُمْ","يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ ۗ",34],["22:66:6",340,"ثُمَّ","then","أَحْيَاكُمْ ثُمَّ يُمِيتُكُمْ","يُحْيِيكُمْ ۗ إِنَّ ٱلْإِنسَـٰنَ",34],["23:13:1",342,"ثُمَّ","Then","","جَعَلْنَـٰهُ نُطْفَةًۭ فِى",34],["23:14:1",342,"ثُمَّ","Then","","خَلَقْنَا ٱلنُّطْفَةَ عَلَقَةًۭ",34],["23:14:14",342,"ثُمَّ","then","فَكَسَوْنَا ٱلْعِظَـٰمَ لَحْمًۭا","أَنشَأْنَـٰهُ خَلْقًا ءَاخَرَ ۚ",34],["23:15:1",342,"ثُمَّ","Then","","إِنَّكُم بَعْدَ ذَٰلِكَ",34],["23:16:1",342,"ثُمَّ","Then","","إِنَّكُمْ يَوْمَ ٱلْقِيَـٰمَةِ",34],["23:31:1",344,"ثُمَّ","Then","","أَنشَأْنَا مِنۢ بَعْدِهِمْ",34],["23:42:1",344,"ثُمَّ","Then","","أَنشَأْنَا مِنۢ بَعْدِهِمْ",34],["23:44:1",345,"ثُمَّ","Then","","أَرْسَلْنَا رُسُلَنَا تَتْرَا ۖ",34],["23:45:1",345,"ثُمَّ","Then","","أَرْسَلْنَا مُوسَىٰ وَأَخَاهُ",34],["24:4:4",350,"ثُمَّ","then","وَٱلَّذِينَ يَرْمُونَ ٱلْمُحْصَنَـٰتِ","لَمْ يَأْتُوا۟ بِأَرْبَعَةِ",34],["24:43:7",355,"ثُمَّ","then","ٱللَّهَ يُزْجِى سَحَابًۭا","يُؤَلِّفُ بَيْنَهُۥ ثُمَّ",34],["24:43:10",355,"ثُمَّ","then","ثُمَّ يُؤَلِّفُ بَيْنَهُۥ","يَجْعَلُهُۥ رُكَامًۭا فَتَرَى",34],["24:47:6",356,"ثُمَّ","Then","بِٱللَّهِ وَبِٱلرَّسُولِ وَأَطَعْنَا","يَتَوَلَّىٰ فَرِيقٌۭ مِّنْهُم",34],["25:45:12",364,"ثُمَّ","Then","شَآءَ لَجَعَلَهُۥ سَاكِنًۭا","جَعَلْنَا ٱلشَّمْسَ عَلَيْهِ",34],["25:46:1",364,"ثُمَّ","Then","","قَبَضْنَـٰهُ إِلَيْنَا قَبْضًۭا",34],["25:59:10",365,"ثُمَّ","then","فِى سِتَّةِ أَيَّامٍۢ","ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ ۚ",34],["26:66:1",370,"ثُمَّ","Then","","أَغْرَقْنَا ٱلْـَٔاخَرِينَ",34],["26:81:3",370,"ثُمَّ","then","وَٱلَّذِى يُمِيتُنِى","يُحْيِينِ",34],["26:120:1",372,"ثُمَّ","Then","","أَغْرَقْنَا بَعْدُ ٱلْبَاقِينَ",34],["26:172:1",374,"ثُمَّ","Then","","دَمَّرْنَا ٱلْـَٔاخَرِينَ",34],["26:206:1",375,"ثُمَّ","Then","","جَآءَهُم مَّا كَانُوا۟",34],["27:11:4",377,"ثُمَّ","then","إِلَّا مَن ظَلَمَ","بَدَّلَ حُسْنًۢا بَعْدَ",34],["27:28:6",379,"ثُمَّ","Then","هَـٰذَا فَأَلْقِهْ إِلَيْهِمْ","تَوَلَّ عَنْهُمْ فَٱنظُرْ",34],["27:49:6",381,"ثُمَّ","Then","بِٱللَّهِ لَنُبَيِّتَنَّهُۥ وَأَهْلَهُۥ","لَنَقُولَنَّ لِوَلِيِّهِۦ مَا",34],["27:64:4",383,"ثُمَّ","then","أَمَّن يَبْدَؤُا۟ ٱلْخَلْقَ","يُعِيدُهُۥ وَمَن يَرْزُقُكُم",34],["28:24:3",388,"ثُمَّ","Then","فَسَقَىٰ لَهُمَا","تَوَلَّىٰٓ إِلَى ٱلظِّلِّ",34],["28:61:12",393,"ثُمَّ","then","مَتَـٰعَ ٱلْحَيَوٰةِ ٱلدُّنْيَا","هُوَ يَوْمَ ٱلْقِيَـٰمَةِ",34],["29:19:7",398,"ثُمَّ","then","يُبْدِئُ ٱللَّهُ ٱلْخَلْقَ","يُعِيدُهُۥٓ ۚ إِنَّ ذَٰلِكَ",34],["29:20:9",398,"ثُمَّ","Then","كَيْفَ بَدَأَ ٱلْخَلْقَ ۚ","ٱللَّهُ يُنشِئُ ٱلنَّشْأَةَ",34],["29:25:13",399,"ثُمَّ","Then","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ","يَوْمَ ٱلْقِيَـٰمَةِ يَكْفُرُ",34],["29:57:5",403,"ثُمَّ","Then","نَفْسٍۢ ذَآئِقَةُ ٱلْمَوْتِ ۖ","إِلَيْنَا تُرْجَعُونَ",34],["30:10:1",405,"ثُمَّ","Then","","كَانَ عَـٰقِبَةَ ٱلَّذِينَ",34],["30:11:4",405,"ثُمَّ","then","ٱللَّهُ يَبْدَؤُا۟ ٱلْخَلْقَ","يُعِيدُهُۥ ثُمَّ إِلَيْهِ",34],["30:11:6",405,"ثُمَّ","then","ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ","إِلَيْهِ تُرْجَعُونَ",34],["30:20:7",406,"ثُمَّ","then","خَلَقَكُم مِّن تُرَابٍۢ","إِذَآ أَنتُم بَشَرٌۭ",34],["30:25:8",407,"ثُمَّ","Then","ٱلسَّمَآءُ وَٱلْأَرْضُ بِأَمْرِهِۦ ۚ","إِذَا دَعَاكُمْ دَعْوَةًۭ",34],["30:27:5",407,"ثُمَّ","then","ٱلَّذِى يَبْدَؤُا۟ ٱلْخَلْقَ","يُعِيدُهُۥ وَهُوَ أَهْوَنُ",34],["30:33:9",408,"ثُمَّ","Then","رَبَّهُم مُّنِيبِينَ إِلَيْهِ","إِذَآ أَذَاقَهُم مِّنْهُ",34],["30:40:4",408,"ثُمَّ","then","ٱللَّهُ ٱلَّذِى خَلَقَكُمْ","رَزَقَكُمْ ثُمَّ يُمِيتُكُمْ",34],["30:40:6",408,"ثُمَّ","then","خَلَقَكُمْ ثُمَّ رَزَقَكُمْ","يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ ۖ",34],["30:40:8",408,"ثُمَّ","then","رَزَقَكُمْ ثُمَّ يُمِيتُكُمْ","يُحْيِيكُمْ ۖ هَلْ مِن",34],["30:54:6",410,"ثُمَّ","then","خَلَقَكُم مِّن ضَعْفٍۢ","جَعَلَ مِنۢ بَعْدِ",34],["30:54:12",410,"ثُمَّ","then","بَعْدِ ضَعْفٍۢ قُوَّةًۭ","جَعَلَ مِنۢ بَعْدِ",34],["31:15:23",412,"ثُمَّ","Then","مَنْ أَنَابَ إِلَىَّ ۚ","إِلَىَّ مَرْجِعُكُمْ فَأُنَبِّئُكُم",34],["31:24:3",413,"ثُمَّ","then","نُمَتِّعُهُمْ قَلِيلًۭا","نَضْطَرُّهُمْ إِلَىٰ عَذَابٍ",34],["32:4:11",415,"ثُمَّ","Then","فِى سِتَّةِ أَيَّامٍۢ","ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ ۖ",34],["32:5:7",415,"ثُمَّ","then","ٱلسَّمَآءِ إِلَى ٱلْأَرْضِ","يَعْرُجُ إِلَيْهِ فِى",34],["32:8:1",415,"ثُمَّ","Then","","جَعَلَ نَسْلَهُۥ مِن",34],["32:9:1",415,"ثُمَّ","Then","","سَوَّىٰهُ وَنَفَخَ فِيهِ",34],["32:11:8",415,"ثُمَّ","Then","ٱلَّذِى وُكِّلَ بِكُمْ","إِلَىٰ رَبِّكُمْ تُرْجَعُونَ",34],["32:22:7",417,"ثُمَّ","then","ذُكِّرَ بِـَٔايَـٰتِ رَبِّهِۦ","أَعْرَضَ عَنْهَآ ۚ إِنَّا",34],["33:14:6",419,"ثُمَّ","then","عَلَيْهِم مِّنْ أَقْطَارِهَا","سُئِلُوا۟ ٱلْفِتْنَةَ لَـَٔاتَوْهَا",34],["33:49:7",424,"ثُمَّ","and then","إِذَا نَكَحْتُمُ ٱلْمُؤْمِنَـٰتِ","طَلَّقْتُمُوهُنَّ مِن قَبْلِ",34],["33:60:14",426,"ثُمَّ","then","ٱلْمَدِينَةِ لَنُغْرِيَنَّكَ بِهِمْ","لَا يُجَاوِرُونَكَ فِيهَآ",34],["34:26:5",431,"ثُمَّ","then","يَجْمَعُ بَيْنَنَا رَبُّنَا","يَفْتَحُ بَيْنَنَا بِٱلْحَقِّ",34],["34:40:4",433,"ثُمَّ","then","وَيَوْمَ يَحْشُرُهُمْ جَمِيعًۭا","يَقُولُ لِلْمَلَـٰٓئِكَةِ أَهَـٰٓؤُلَآءِ",34],["34:46:10",433,"ثُمَّ","then","لِلَّهِ مَثْنَىٰ وَفُرَٰدَىٰ","تَتَفَكَّرُوا۟ ۚ مَا بِصَاحِبِكُم",34],["35:11:5",435,"ثُمَّ","then","خَلَقَكُم مِّن تُرَابٍۢ","مِن نُّطْفَةٍۢ ثُمَّ",34],["35:11:8",435,"ثُمَّ","then","ثُمَّ مِن نُّطْفَةٍۢ","جَعَلَكُمْ أَزْوَٰجًۭا ۚ وَمَا",34],["35:26:1",437,"ثُمَّ","Then","","أَخَذْتُ ٱلَّذِينَ كَفَرُوا۟ ۖ",34],["35:32:1",438,"ثُمَّ","Then","","أَوْرَثْنَا ٱلْكِتَـٰبَ ٱلَّذِينَ",34],["37:67:1",448,"ثُمَّ","Then","","إِنَّ لَهُمْ عَلَيْهَا",34],["37:68:1",448,"ثُمَّ","Then","","إِنَّ مَرْجِعَهُمْ لَإِلَى",34],["37:82:1",449,"ثُمَّ","Then","","أَغْرَقْنَا ٱلْـَٔاخَرِينَ",34],["37:136:1",451,"ثُمَّ","Then","","دَمَّرْنَا ٱلْـَٔاخَرِينَ",34],["38:34:8",455,"ثُمَّ","then","عَلَىٰ كُرْسِيِّهِۦ جَسَدًۭا","أَنَابَ",34],["39:6:5",459,"ثُمَّ","Then","مِّن نَّفْسٍۢ وَٰحِدَةٍۢ","جَعَلَ مِنْهَا زَوْجَهَا",34],["39:7:20",459,"ثُمَّ","Then","وَازِرَةٌۭ وِزْرَ أُخْرَىٰ ۗ","إِلَىٰ رَبِّكُم مَّرْجِعُكُمْ",34],["39:8:9",459,"ثُمَّ","then","رَبَّهُۥ مُنِيبًا إِلَيْهِ","إِذَا خَوَّلَهُۥ نِعْمَةًۭ",34],["39:21:13",460,"ثُمَّ","then","يَنَـٰبِيعَ فِى ٱلْأَرْضِ","يُخْرِجُ بِهِۦ زَرْعًۭا",34],["39:21:19",460,"ثُمَّ","then","زَرْعًۭا مُّخْتَلِفًا أَلْوَٰنُهُۥ","يَهِيجُ فَتَرَىٰهُ مُصْفَرًّۭا",34],["39:21:23",460,"ثُمَّ","then","يَهِيجُ فَتَرَىٰهُ مُصْفَرًّۭا","يَجْعَلُهُۥ حُطَـٰمًا ۚ إِنَّ",34],["39:23:14",461,"ثُمَّ","then","ٱلَّذِينَ يَخْشَوْنَ رَبَّهُمْ","تَلِينُ جُلُودُهُمْ وَقُلُوبُهُمْ",34],["39:31:1",461,"ثُمَّ","Then","","إِنَّكُمْ يَوْمَ ٱلْقِيَـٰمَةِ",34],["39:44:9",463,"ثُمَّ","Then","مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ","إِلَيْهِ تُرْجَعُونَ",34],["39:49:6",464,"ثُمَّ","then","ٱلْإِنسَـٰنَ ضُرٌّۭ دَعَانَا","إِذَا خَوَّلْنَـٰهُ نِعْمَةًۭ",34],["39:54:11",464,"ثُمَّ","then","أَن يَأْتِيَكُمُ ٱلْعَذَابُ","لَا تُنصَرُونَ",34],["39:68:15",466,"ثُمَّ","Then","مَن شَآءَ ٱللَّهُ ۖ","نُفِخَ فِيهِ أُخْرَىٰ",34],["40:67:6",475,"ثُمَّ","then","خَلَقَكُم مِّن تُرَابٍۢ","مِن نُّطْفَةٍۢ ثُمَّ",34],["40:67:9",475,"ثُمَّ","then","ثُمَّ مِن نُّطْفَةٍۢ","مِنْ عَلَقَةٍۢ ثُمَّ",34],["40:67:12",475,"ثُمَّ","then","ثُمَّ مِنْ عَلَقَةٍۢ","يُخْرِجُكُمْ طِفْلًۭا ثُمَّ",34],["40:67:15",475,"ثُمَّ","then","ثُمَّ يُخْرِجُكُمْ طِفْلًۭا","لِتَبْلُغُوٓا۟ أَشُدَّكُمْ ثُمَّ",34],["40:67:18",475,"ثُمَّ","then","ثُمَّ لِتَبْلُغُوٓا۟ أَشُدَّكُمْ","لِتَكُونُوا۟ شُيُوخًۭا ۚ وَمِنكُم",34],["40:72:3",475,"ثُمَّ","then","فِى ٱلْحَمِيمِ","فِى ٱلنَّارِ يُسْجَرُونَ",34],["40:73:1",475,"ثُمَّ","Then","","قِيلَ لَهُمْ أَيْنَ",34],["41:11:1",477,"ثُمَّ","Then","","ٱسْتَوَىٰٓ إِلَى ٱلسَّمَآءِ",34],["41:30:6",480,"ثُمَّ","then","قَالُوا۟ رَبُّنَا ٱللَّهُ","ٱسْتَقَـٰمُوا۟ تَتَنَزَّلُ عَلَيْهِمُ",34],["41:52:8",482,"ثُمَّ","then","مِنْ عِندِ ٱللَّهِ","كَفَرْتُم بِهِۦ مَنْ",34],["43:13:4",490,"ثُمَّ","then","لِتَسْتَوُۥا۟ عَلَىٰ ظُهُورِهِۦ","تَذْكُرُوا۟ نِعْمَةَ رَبِّكُمْ",34],["44:14:1",496,"ثُمَّ","Then","","تَوَلَّوْا۟ عَنْهُ وَقَالُوا۟",34],["44:48:1",498,"ثُمَّ","Then","","صُبُّوا۟ فَوْقَ رَأْسِهِۦ",34],["45:8:6",499,"ثُمَّ","then","ٱللَّهِ تُتْلَىٰ عَلَيْهِ","يُصِرُّ مُسْتَكْبِرًۭا كَأَن",34],["45:15:8",500,"ثُمَّ","Then","وَمَنْ أَسَآءَ فَعَلَيْهَا ۖ","إِلَىٰ رَبِّكُمْ تُرْجَعُونَ",34],["45:18:1",500,"ثُمَّ","Then","","جَعَلْنَـٰكَ عَلَىٰ شَرِيعَةٍۢ",34],["45:26:4",501,"ثُمَّ","then","قُلِ ٱللَّهُ يُحْيِيكُمْ","يُمِيتُكُمْ ثُمَّ يَجْمَعُكُمْ",34],["45:26:6",501,"ثُمَّ","then","يُحْيِيكُمْ ثُمَّ يُمِيتُكُمْ","يَجْمَعُكُمْ إِلَىٰ يَوْمِ",34],["46:13:6",503,"ثُمَّ","then","قَالُوا۟ رَبُّنَا ٱللَّهُ","ٱسْتَقَـٰمُوا۟ فَلَا خَوْفٌ",34],["47:34:8",510,"ثُمَّ","then","عَن سَبِيلِ ٱللَّهِ","مَاتُوا۟ وَهُمْ كُفَّارٌۭ",34],["47:38:26",510,"ثُمَّ","then","يَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ","لَا يَكُونُوٓا۟ أَمْثَـٰلَكُم",34],["48:22:7",513,"ثُمَّ","Then","كَفَرُوا۟ لَوَلَّوُا۟ ٱلْأَدْبَـٰرَ","لَا يَجِدُونَ وَلِيًّۭا",34],["49:15:7",517,"ثُمَّ","then","ءَامَنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ","لَمْ يَرْتَابُوا۟ وَجَـٰهَدُوا۟",34],["53:8:1",526,"ثُمَّ","Then","","دَنَا فَتَدَلَّىٰ",34],["53:41:1",527,"ثُمَّ","Then","","يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ",34],["56:51:1",536,"ثُمَّ","Then","","إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ",34],["57:4:9",538,"ثُمَّ","then","فِى سِتَّةِ أَيَّامٍۢ","ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ ۚ",34],["57:20:19",540,"ثُمَّ","then","أَعْجَبَ ٱلْكُفَّارَ نَبَاتُهُۥ","يَهِيجُ فَتَرَىٰهُ مُصْفَرًّۭا",34],["57:20:23",540,"ثُمَّ","then","يَهِيجُ فَتَرَىٰهُ مُصْفَرًّۭا","يَكُونُ حُطَـٰمًۭا ۖ وَفِى",34],["57:27:1",541,"ثُمَّ","Then","","قَفَّيْنَا عَلَىٰٓ ءَاثَـٰرِهِم",34],["58:3:5",542,"ثُمَّ","then","يُظَـٰهِرُونَ مِن نِّسَآئِهِمْ","يَعُودُونَ لِمَا قَالُوا۟",34],["58:7:37",543,"ثُمَّ","Then","أَيْنَ مَا كَانُوا۟ ۖ","يُنَبِّئُهُم بِمَا عَمِلُوا۟",34],["58:8:8",543,"ثُمَّ","then","نُهُوا۟ عَنِ ٱلنَّجْوَىٰ","يَعُودُونَ لِمَا نُهُوا۟",34],["59:12:14",547,"ثُمَّ","then","نَّصَرُوهُمْ لَيُوَلُّنَّ ٱلْأَدْبَـٰرَ","لَا يُنصَرُونَ",34],["62:5:5",553,"ثُمَّ","then","ٱلَّذِينَ حُمِّلُوا۟ ٱلتَّوْرَىٰةَ","لَمْ يَحْمِلُوهَا كَمَثَلِ",34],["62:8:9",553,"ثُمَّ","Then","مِنْهُ فَإِنَّهُۥ مُلَـٰقِيكُمْ ۖ","تُرَدُّونَ إِلَىٰ عَـٰلِمِ",34],["63:3:4",554,"ثُمَّ","then","ذَٰلِكَ بِأَنَّهُمْ ءَامَنُوا۟","كَفَرُوا۟ فَطُبِعَ عَلَىٰ",34],["64:7:11",556,"ثُمَّ","then","بَلَىٰ وَرَبِّى لَتُبْعَثُنَّ","لَتُنَبَّؤُنَّ بِمَا عَمِلْتُمْ ۚ",34],["67:4:1",562,"ثُمَّ","Then","","ٱرْجِعِ ٱلْبَصَرَ كَرَّتَيْنِ",34],["69:31:1",567,"ثُمَّ","Then","","ٱلْجَحِيمَ صَلُّوهُ",34],["69:32:1",567,"ثُمَّ","Then","","فِى سِلْسِلَةٍۢ ذَرْعُهَا",34],["69:46:1",568,"ثُمَّ","Then","","لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ",34],["70:14:5",569,"ثُمَّ","then","فِى ٱلْأَرْضِ جَمِيعًۭا","يُنجِيهِ",34],["71:8:1",570,"ثُمَّ","Then","","إِنِّى دَعَوْتُهُمْ جِهَارًۭا",34],["71:9:1",570,"ثُمَّ","Then","","إِنِّىٓ أَعْلَنتُ لَهُمْ",34],["71:18:1",571,"ثُمَّ","Then","","يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ",34],["74:15:1",575,"ثُمَّ","Then","","يَطْمَعُ أَنْ أَزِيدَ",34],["74:20:1",576,"ثُمَّ","Then","","قُتِلَ كَيْفَ قَدَّرَ",34],["74:21:1",576,"ثُمَّ","Then","","نَظَرَ",34],["74:22:1",576,"ثُمَّ","Then","","عَبَسَ وَبَسَرَ",34],["74:23:1",576,"ثُمَّ","Then","","أَدْبَرَ وَٱسْتَكْبَرَ",34],["75:19:1",577,"ثُمَّ","Then","","إِنَّ عَلَيْنَا بَيَانَهُۥ",34],["75:33:1",578,"ثُمَّ","Then","","ذَهَبَ إِلَىٰٓ أَهْلِهِۦ",34],["75:35:1",578,"ثُمَّ","Then","","أَوْلَىٰ لَكَ فَأَوْلَىٰٓ",34],["75:38:1",578,"ثُمَّ","Then","","كَانَ عَلَقَةًۭ فَخَلَقَ",34],["77:17:1",580,"ثُمَّ","Then","","نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",34],["78:5:1",582,"ثُمَّ","Then","","كَلَّا سَيَعْلَمُونَ",34],["79:22:1",584,"ثُمَّ","Then","","أَدْبَرَ يَسْعَىٰ",34],["80:20:1",585,"ثُمَّ","Then","","ٱلسَّبِيلَ يَسَّرَهُۥ",34],["80:21:1",585,"ثُمَّ","Then","","أَمَاتَهُۥ فَأَقْبَرَهُۥ",34],["80:22:1",585,"ثُمَّ","Then","","إِذَا شَآءَ أَنشَرَهُۥ",34],["80:26:1",585,"ثُمَّ","Then","","شَقَقْنَا ٱلْأَرْضَ شَقًّۭا",34],["82:18:1",587,"ثُمَّ","Then","","مَآ أَدْرَىٰكَ مَا",34],["83:16:1",588,"ثُمَّ","Then","","إِنَّه