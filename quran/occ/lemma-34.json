[["2:28:7",5,"ثُمَّ","then","وَكُنتُمْ أَمْوَٰتًۭا فَأَحْيَـٰكُمْ ۖ","يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ",34],["2:28:9",5,"ثُمَّ","then","فَأَحْيَـٰكُمْ ۖ ثُمَّ يُمِيتُكُمْ","يُحْيِيكُمْ ثُمَّ إِلَيْهِ",34],["2:28:11",5,"ثُمَّ","then","يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ","إِلَيْهِ تُرْجَعُونَ",34],["2:29:9",5,"ثُمَّ","Moreover","فِى ٱلْأَرْضِ جَمِيعًۭا","ٱسْتَوَىٰٓ إِلَى ٱلسَّمَآءِ",34],["2:31:5",6,"ثُمَّ","Then","ءَادَمَ ٱلْأَسْمَآءَ كُلَّهَا","عَرَضَهُمْ عَلَى ٱلْمَلَـٰٓئِكَةِ",34],["2:51:6",8,"ثُمَّ","Then","مُوسَىٰٓ أَرْبَعِينَ لَيْلَةًۭ","ٱتَّخَذْتُمُ ٱلْعِجْلَ مِنۢ",34],["2:52:1",8,"ثُمَّ","Then","","عَفَوْنَا عَنكُم مِّنۢ",34],["2:56:1",8,"ثُمَّ","Then","","بَعَثْنَـٰكُم مِّنۢ بَعْدِ",34],["2:64:1",10,"ثُمَّ","Then","","تَوَلَّيْتُم مِّنۢ بَعْدِ",34],["2:74:1",11,"ثُمَّ","Then","","قَسَتْ قُلُوبُكُم مِّنۢ",34],["2:75:12",11,"ثُمَّ","then","يَسْمَعُونَ كَلَـٰمَ ٱللَّهِ","يُحَرِّفُونَهُۥ مِنۢ بَعْدِ",34],["2:79:6",12,"ثُمَّ","then","يَكْتُبُونَ ٱلْكِتَـٰبَ بِأَيْدِيهِمْ","يَقُولُونَ هَـٰذَا مِنْ",34],["2:83:23",12,"ثُمَّ","Then","ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ","تَوَلَّيْتُمْ إِلَّا قَلِيلًۭا",34],["2:84:12",13,"ثُمَّ","then","أَنفُسَكُم مِّن دِيَـٰرِكُمْ","أَقْرَرْتُمْ وَأَنتُمْ تَشْهَدُونَ",34],["2:85:1",13,"ثُمَّ","Then","","أَنتُمْ هَـٰٓؤُلَآءِ تَقْتُلُونَ",34],["2:92:5",14,"ثُمَّ","then","جَآءَكُم مُّوسَىٰ بِٱلْبَيِّنَـٰتِ","ٱتَّخَذْتُمُ ٱلْعِجْلَ مِنۢ",34],["2:126:24",19,"ثُمَّ","then","كَفَرَ فَأُمَتِّعُهُۥ قَلِيلًۭا","أَضْطَرُّهُۥٓ إِلَىٰ عَذَابِ",34],["2:187:43",29,"ثُمَّ","Then","ٱلْأَسْوَدِ مِنَ ٱلْفَجْرِ ۖ","أَتِمُّوا۟ ٱلصِّيَامَ إِلَى",34],["2:199:1",31,"ثُمَّ","Then","","أَفِيضُوا۟ مِنْ حَيْثُ",34],["2:243:16",39,"ثُمَّ","then","لَهُمُ ٱللَّهُ مُوتُوا۟","أَحْيَـٰهُمْ ۚ إِنَّ ٱللَّهَ",34],["2:259:21",43,"ثُمَّ","then","ٱللَّهُ مِا۟ئَةَ عَامٍۢ","بَعَثَهُۥ ۖ قَالَ كَمْ",34],["2:259:54",43,"ثُمَّ","then","ٱلْعِظَامِ كَيْفَ نُنشِزُهَا","نَكْسُوهَا لَحْمًۭا ۚ فَلَمَّا",34],["2:260:24",44,"ثُمَّ","then","ٱلطَّيْرِ فَصُرْهُنَّ إِلَيْكَ","ٱجْعَلْ عَلَىٰ كُلِّ",34],["2:260:31",44,"ثُمَّ","then","جَبَلٍۢ مِّنْهُنَّ جُزْءًۭا","ٱدْعُهُنَّ يَأْتِينَكَ سَعْيًۭا ۚ",34],["2:262:7",44,"ثُمَّ","then","فِى سَبِيلِ ٱللَّهِ","لَا يُتْبِعُونَ مَآ",34],["2:281:7",47,"ثُمَّ","Then","فِيهِ إِلَى ٱللَّهِ ۖ","تُوَفَّىٰ كُلُّ نَفْسٍۢ",34],["3:23:15",53,"ثُمَّ","then","ٱللَّهِ لِيَحْكُمَ بَيْنَهُمْ","يَتَوَلَّىٰ فَرِيقٌۭ مِّنْهُمْ",34],["3:55:22",57,"ثُمَّ","Then","إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ ۖ","إِلَىَّ مَرْجِعُكُمْ فَأَحْكُمُ",34],["3:59:11",57,"ثُمَّ","then","خَلَقَهُۥ مِن تُرَابٍۢ","قَالَ لَهُۥ كُن",34],["3:61:19",57,"ثُمَّ","then","وَنِسَآءَكُمْ وَأَنفُسَنَا وَأَنفُسَكُمْ","نَبْتَهِلْ فَنَجْعَل لَّعْنَتَ",34],["3:79:10",60,"ثُمَّ","then","ٱلْكِتَـٰبَ وَٱلْحُكْمَ وَٱلنُّبُوَّةَ","يَقُولَ لِلنَّاسِ كُونُوا۟",34],["3:81:11",60,"ثُمَّ","then","مِّن كِتَـٰبٍۢ وَحِكْمَةٍۢ","جَآءَكُمْ رَسُولٌۭ مُّصَدِّقٌۭ",34],["3:90:6",61,"ثُمَّ","then","كَفَرُوا۟ بَعْدَ إِيمَـٰنِهِمْ","ٱزْدَادُوا۟ كُفْرًۭا لَّن",34],["3:111:9",64,"ثُمَّ","then","يُقَـٰتِلُوكُمْ يُوَلُّوكُمُ ٱلْأَدْبَارَ","لَا يُنصَرُونَ",34],["3:152:29",69,"ثُمَّ","Then","مَّن يُرِيدُ ٱلْـَٔاخِرَةَ ۚ","صَرَفَكُمْ عَنْهُمْ لِيَبْتَلِيَكُمْ ۖ",34],["3:154:1",70,"ثُمَّ","Then","","أَنزَلَ عَلَيْكُم مِّنۢ",34],["3:161:13",71,"ثُمَّ","Then","غَلَّ يَوْمَ ٱلْقِيَـٰمَةِ ۚ","تُوَفَّىٰ كُلُّ نَفْسٍۢ",34],["3:197:3",76,"ثُمَّ","then","مَتَـٰعٌۭ قَلِيلٌۭ","مَأْوَىٰهُمْ جَهَنَّمُ ۚ وَبِئْسَ",34],["4:17:9",80,"ثُمَّ","then","يَعْمَلُونَ ٱلسُّوٓءَ بِجَهَـٰلَةٍۢ","يَتُوبُونَ مِن قَرِيبٍۢ",34],["4:62:8",88,"ثُمَّ","then","بِمَا قَدَّمَتْ أَيْدِيهِمْ","جَآءُوكَ يَحْلِفُونَ بِٱللَّهِ",34],["4:65:10",88,"ثُمَّ","then","فِيمَا شَجَرَ بَيْنَهُمْ","لَا يَجِدُوا۟ فِىٓ",34],["4:100:20",94,"ثُمَّ","then","إِلَى ٱللَّهِ وَرَسُولِهِۦ","يُدْرِكْهُ ٱلْمَوْتُ فَقَدْ",34],["4:110:7",96,"ثُمَّ","then","أَوْ يَظْلِمْ نَفْسَهُۥ","يَسْتَغْفِرِ ٱللَّهَ يَجِدِ",34],["4:112:6",96,"ثُمَّ","then","خَطِيٓـَٔةً أَوْ إِثْمًۭا","يَرْمِ بِهِۦ بَرِيٓـًۭٔا",34],["4:137:4",100,"ثُمَّ","then","إِنَّ ٱلَّذِينَ ءَامَنُوا۟","كَفَرُوا۟ ثُمَّ ءَامَنُوا۟",34],["4:137:6",100,"ثُمَّ","then","ءَامَنُوا۟ ثُمَّ كَفَرُوا۟","ءَامَنُوا۟ ثُمَّ كَفَرُوا۟",34],["4:137:8",100,"ثُمَّ","then","كَفَرُوا۟ ثُمَّ ءَامَنُوا۟","كَفَرُوا۟ ثُمَّ ٱزْدَادُوا۟",34],["4:137:10",100,"ثُمَّ","then","ءَامَنُوا۟ ثُمَّ كَفَرُوا۟","ٱزْدَادُوا۟ كُفْرًۭا لَّمْ",34],["4:153:23",102,"ثُمَّ","Then","فَأَخَذَتْهُمُ ٱلصَّـٰعِقَةُ بِظُلْمِهِمْ ۚ","ٱتَّخَذُوا۟ ٱلْعِجْلَ مِنۢ",34],["5:32:32",113,"ثُمَّ","yet","جَآءَتْهُمْ رُسُلُنَا بِٱلْبَيِّنَـٰتِ","إِنَّ كَثِيرًۭا مِّنْهُم",34],["5:43:8",115,"ثُمَّ","Then","فِيهَا حُكْمُ ٱللَّهِ","يَتَوَلَّوْنَ مِنۢ بَعْدِ",34],["5:71:7",120,"ثُمَّ","Then","فِتْنَةٌۭ فَعَمُوا۟ وَصَمُّوا۟","تَابَ ٱللَّهُ عَلَيْهِمْ",34],["5:71:11",120,"ثُمَّ","then (again)","تَابَ ٱللَّهُ عَلَيْهِمْ","عَمُوا۟ وَصَمُّوا۟ كَثِيرٌۭ",34],["5:75:22",120,"ثُمَّ","then","نُبَيِّنُ لَهُمُ ٱلْـَٔايَـٰتِ","ٱنظُرْ أَنَّىٰ يُؤْفَكُونَ",34],["5:93:16",123,"ثُمَّ","then","وَّءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","ٱتَّقَوا۟ وَّءَامَنُوا۟ ثُمَّ",34],["5:93:19",123,"ثُمَّ","then","ثُمَّ ٱتَّقَوا۟ وَّءَامَنُوا۟","ٱتَّقَوا۟ وَّأَحْسَنُوا۟ ۗ وَٱللَّهُ",34],["5:102:6",124,"ثُمَّ","then","قَوْمٌۭ مِّن قَبْلِكُمْ","أَصْبَحُوا۟ بِهَا كَـٰفِرِينَ",34],["6:1:10",128,"ثُمَّ","Then","وَجَعَلَ ٱلظُّلُمَـٰتِ وَٱلنُّورَ ۖ","ٱلَّذِينَ كَفَرُوا۟ بِرَبِّهِمْ",34],["6:2:6",128,"ثُمَّ","then","خَلَقَكُم مِّن طِينٍۢ","قَضَىٰٓ أَجَلًۭا ۖ وَأَجَلٌۭ",34],["6:2:12",128,"ثُمَّ","yet","وَأَجَلٌۭ مُّسَمًّى عِندَهُۥ ۖ","أَنتُمْ تَمْتَرُونَ",34],["6:8:11",128,"ثُمَّ","then","مَلَكًۭا لَّقُضِىَ ٱلْأَمْرُ","لَا يُنظَرُونَ",34],["6:11:5",129,"ثُمَّ","and","سِيرُوا۟ فِى ٱلْأَرْضِ","ٱنظُرُوا۟ كَيْفَ كَانَ",34],["6:22:4",130,"ثُمَّ","then","وَيَوْمَ نَحْشُرُهُمْ جَمِيعًۭا","نَقُولُ لِلَّذِينَ أَشْرَكُوٓا۟",34],["6:23:1",130,"ثُمَّ","Then","","لَمْ تَكُن فِتْنَتُهُمْ",34],["6:36:8",132,"ثُمَّ","then","وَٱلْمَوْتَىٰ يَبْعَثُهُمُ ٱللَّهُ","إِلَيْهِ يُرْجَعُونَ",34],["6:38:19",132,"ثُمَّ","then","ٱلْكِتَـٰبِ مِن شَىْءٍۢ ۚ","إِلَىٰ رَبِّهِمْ يُحْشَرُونَ",34],["6:46:21",133,"ثُمَّ","yet","كَيْفَ نُصَرِّفُ ٱلْـَٔايَـٰتِ","هُمْ يَصْدِفُونَ",34],["6:54:20",134,"ثُمَّ","then","مِنكُمْ سُوٓءًۢا بِجَهَـٰلَةٍۢ","تَابَ مِنۢ بَعْدِهِۦ",34],["6:60:9",135,"ثُمَّ","Then","مَا جَرَحْتُم بِٱلنَّهَارِ","يَبْعَثُكُمْ فِيهِ لِيُقْضَىٰٓ",34],["6:60:15",135,"ثُمَّ","Then","لِيُقْضَىٰٓ أَجَلٌۭ مُّسَمًّۭى ۖ","إِلَيْهِ مَرْجِعُكُمْ ثُمَّ",34],["6:60:18",135,"ثُمَّ","then","ثُمَّ إِلَيْهِ مَرْجِعُكُمْ","يُنَبِّئُكُم بِمَا كُنتُمْ",34],["6:62:1",135,"ثُمَّ","Then","","رُدُّوٓا۟ إِلَى ٱللَّهِ",34],["6:64:8",135,"ثُمَّ","yet","وَمِن كُلِّ كَرْبٍۢ","أَنتُمْ تُشْرِكُونَ",34],["6:91:40",139,"ثُمَّ","Then","ءَابَآؤُكُمْ ۖ قُلِ ٱللَّهُ ۖ","ذَرْهُمْ فِى خَوْضِهِمْ",34],["6:108:18",141,"ثُمَّ","Then","لِكُلِّ أُمَّةٍ عَمَلَهُمْ","إِلَىٰ رَبِّهِم مَّرْجِعُهُمْ",34],["6:154:1",149,"ثُمَّ","Moreover","","ءَاتَيْنَا مُوسَى ٱلْكِتَـٰبَ",34],["6:159:15",150,"ثُمَّ","then","أَمْرُهُمْ إِلَى ٱللَّهِ","يُنَبِّئُهُم بِمَا كَانُوا۟",34],["6:164:21",150,"ثُمَّ","Then","وَازِرَةٌۭ وِزْرَ أُخْرَىٰ ۚ","إِلَىٰ رَبِّكُم مَّرْجِعُكُمْ",34],["7:11:3",151,"ثُمَّ","then","وَلَقَدْ خَلَقْنَـٰكُمْ","صَوَّرْنَـٰكُمْ ثُمَّ قُلْنَا",34],["7:11:5",151,"ثُمَّ","Then","خَلَقْنَـٰكُمْ ثُمَّ صَوَّرْنَـٰكُمْ","قُلْنَا لِلْمَلَـٰٓئِكَةِ ٱسْجُدُوا۟",34],["7:17:1",152,"ثُمَّ","Then","","لَـَٔاتِيَنَّهُم مِّنۢ بَيْنِ",34],["7:54:11",157,"ثُمَّ","then","فِى سِتَّةِ أَيَّامٍۢ","ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ",34],["7:95:1",162,"ثُمَّ","Then","","بَدَّلْنَا مَكَانَ ٱلسَّيِّئَةِ",34],["7:103:1",163,"ثُمَّ","Then","","بَعَثْنَا مِنۢ بَعْدِهِم",34],["7:124:6",165,"ثُمَّ","Then","وَأَرْجُلَكُم مِّنْ خِلَـٰفٍۢ","لَأُصَلِّبَنَّكُمْ أَجْمَعِينَ",34],["7:153:4",169,"ثُمَّ","then","وَٱلَّذِينَ عَمِلُوا۟ ٱلسَّيِّـَٔاتِ","تَابُوا۟ مِنۢ بَعْدِهَا",34],["7:195:23",175,"ثُمَّ","then","قُلِ ٱدْعُوا۟ شُرَكَآءَكُمْ","كِيدُونِ فَلَا تُنظِرُونِ",34],["7:202:5",176,"ثُمَّ","then","يَمُدُّونَهُمْ فِى ٱلْغَىِّ","لَا يُقْصِرُونَ",34],["8:36:11",181,"ثُمَّ","then","سَبِيلِ ٱللَّهِ ۚ فَسَيُنفِقُونَهَا","تَكُونُ عَلَيْهِمْ حَسْرَةًۭ",34],["8:36:15",181,"ثُمَّ","then","تَكُونُ عَلَيْهِمْ حَسْرَةًۭ","يُغْلَبُونَ ۗ وَٱلَّذِينَ كَفَرُوٓا۟",34],["8:56:4",184,"ثُمَّ","then","ٱلَّذِينَ عَـٰهَدتَّ مِنْهُمْ","يَنقُضُونَ عَهْدَهُمْ فِى",34],["9:4:6",187,"ثُمَّ","then","عَـٰهَدتُّم مِّنَ ٱلْمُشْرِكِينَ","لَمْ يَنقُصُوكُمْ شَيْـًۭٔا",34],["9:6:11",187,"ثُمَّ","Then","يَسْمَعَ كَلَـٰمَ ٱللَّهِ","أَبْلِغْهُ مَأْمَنَهُۥ ۚ ذَٰلِكَ",34],["9:25:21",190,"ثُمَّ","then","ٱلْأَرْضُ بِمَا رَحُبَتْ","وَلَّيْتُم مُّدْبِرِينَ",34],["9:26:1",190,"ثُمَّ","Then","","أَنزَلَ ٱللَّهُ سَكِينَتَهُۥ",34],["9:27:1",191,"ثُمَّ","Then","","يَتُوبُ ٱللَّهُ مِنۢ",34],["9:94:21",202,"ثُمَّ","Then","ٱللَّهُ عَمَلَكُمْ وَرَسُولُهُۥ","تُرَدُّونَ إِلَىٰ عَـٰلِمِ",34],["9:101:18",203,"ثُمَّ","then","نَعْلَمُهُمْ ۚ سَنُعَذِّبُهُم مَّرَّتَيْنِ","يُرَدُّونَ إِلَىٰ عَذَابٍ",34],["9:117:21",205,"ثُمَّ","then","قُلُوبُ فَرِيقٍۢ مِّنْهُمْ","تَابَ عَلَيْهِمْ ۚ إِنَّهُۥ",34],["9:118:23",206,"ثُمَّ","Then","ٱللَّهِ إِلَّآ إِلَيْهِ","تَابَ عَلَيْهِمْ لِيَتُوبُوٓا۟ ۚ",34],["9:126:11",207,"ثُمَّ","Yet","مَّرَّةً أَوْ مَرَّتَيْنِ","لَا يَتُوبُونَ وَلَا",34],["9:127:13",207,"ثُمَّ","Then","يَرَىٰكُم مِّنْ أَحَدٍۢ","ٱنصَرَفُوا۟ ۚ صَرَفَ ٱللَّهُ",34],["10:3:11",208,"ثُمَّ","then","فِى سِتَّةِ أَيَّامٍۢ","ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ ۖ",34],["10:4:10",208,"ثُمَّ","then","إِنَّهُۥ يَبْدَؤُا۟ ٱلْخَلْقَ","يُعِيدُهُۥ لِيَجْزِىَ ٱلَّذِينَ",34],["10:14:1",209,"ثُمَّ","Then","","جَعَلْنَـٰكُمْ خَلَـٰٓئِفَ فِى",34],["10:23:19",211,"ثُمَّ","Then","مَّتَـٰعَ ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ","إِلَيْنَا مَرْجِعُكُمْ فَنُنَبِّئُكُم",34],["10:28:4",212,"ثُمَّ","then","وَيَوْمَ نَحْشُرُهُمْ جَمِيعًۭا","نَقُولُ لِلَّذِينَ أَشْرَكُوا۟",34],["10:34:8",213,"ثُمَّ","then","مَّن يَبْدَؤُا۟ ٱلْخَلْقَ","يُعِيدُهُۥ ۚ قُلِ ٱللَّهُ",34],["10:34:14",213,"ثُمَّ","then","ٱللَّهُ يَبْدَؤُا۟ ٱلْخَلْقَ","يُعِيدُهُۥ ۖ فَأَنَّىٰ تُؤْفَكُونَ",34],["10:46:10",214,"ثُمَّ","then","نَتَوَفَّيَنَّكَ فَإِلَيْنَا مَرْجِعُهُمْ","ٱللَّهُ شَهِيدٌ عَلَىٰ",34],["10:51:1",214,"أَثُمَّ","Is (it) then","","إِذَا مَا و