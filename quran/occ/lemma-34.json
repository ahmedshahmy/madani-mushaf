َ","then","فَأَمْلَيْتُ لِلَّذِينَ كَفَرُوا۟","أَخَذْتُهُمْ ۖ فَكَيْفَ كَانَ",34],["16:27:1",270,"ثُمَّ","Then","","يَوْمَ ٱلْقِيَـٰمَةِ يُخْزِيهِمْ",34],["16:53:7",272,"ثُمَّ","Then","نِّعْمَةٍۢ فَمِنَ ٱللَّهِ ۖ","إِذَا مَسَّكُمُ ٱلضُّرُّ",34],["16:54:1",272,"ثُمَّ","Then","","إِذَا كَشَفَ ٱلضُّرَّ",34],["16:69:1",274,"ثُمَّ","Then","","كُلِى مِن كُلِّ",34],["16:70:3",274,"ثُمَّ","then","وَٱللَّهُ خَلَقَكُمْ","يَتَوَفَّىٰكُمْ ۚ وَمِنكُم مَّن",34],["16:83:4",276,"ثُمَّ","then","يَعْرِفُونَ نِعْمَتَ ٱللَّهِ","يُنكِرُونَهَا وَأَكْثَرُهُمُ ٱلْكَـٰفِرُونَ",34],["16:84:7",276,"ثُمَّ","then","كُلِّ أُمَّةٍۢ شَهِيدًۭا","لَا يُؤْذَنُ لِلَّذِينَ",34],["16:110:1",279,"ثُمَّ","Then","","إِنَّ رَبَّكَ لِلَّذِينَ",34],["16:110:10",279,"ثُمَّ","then","بَعْدِ مَا فُتِنُوا۟","جَـٰهَدُوا۟ وَصَبَرُوٓا۟ إِنَّ",34],["16:119:1",281,"ثُمَّ","Then","","إِنَّ رَبَّكَ لِلَّذِينَ",34],["16:119:8",281,"ثُمَّ","then","عَمِلُوا۟ ٱلسُّوٓءَ بِجَهَـٰلَةٍۢ","تَابُوا۟ مِنۢ بَعْدِ",34],["16:123:1",281,"ثُمَّ","Then","","أَوْحَيْنَآ إِلَيْكَ أَنِ",34],["17:6:1",282,"ثُمَّ","Then","","رَدَدْنَا لَكُمُ ٱلْكَرَّةَ",34],["17:18:12",284,"ثُمَّ","Then","نَشَآءُ لِمَن نُّرِيدُ","جَعَلْنَا لَهُۥ جَهَنَّمَ",34],["17:68:11",289,"ثُمَّ","Then","يُرْسِلَ عَلَيْكُمْ حَاصِبًۭا","لَا تَجِدُوا۟ لَكُمْ",34],["17:69:16",289,"ثُمَّ","Then","فَيُغْرِقَكُم بِمَا كَفَرْتُمْ ۙ","لَا تَجِدُوا۟ لَكُمْ",34],["17:75:7",289,"ثُمَّ","Then","ٱلْحَيَوٰةِ وَضِعْفَ ٱلْمَمَاتِ","لَا تَجِدُ لَكَ",34],["17:86:7",290,"ثُمَّ","Then","بِٱلَّذِىٓ أَوْحَيْنَآ إِلَيْكَ","لَا تَجِدُ لَكَ",34],["18:12:1",294,"ثُمَّ","Then","","بَعَثْنَـٰهُمْ لِنَعْلَمَ أَىُّ",34],["18:37:11",298,"ثُمَّ","then","خَلَقَكَ مِن تُرَابٍۢ","مِن نُّطْفَةٍۢ ثُمَّ",34],["18:37:14",298,"ثُمَّ","then","ثُمَّ مِن نُّطْفَةٍۢ","سَوَّىٰكَ رَجُلًۭا",34],["18:87:7",303,"ثُمَّ","Then","ظَلَمَ فَسَوْفَ نُعَذِّبُهُۥ","يُرَدُّ إِلَىٰ رَبِّهِۦ",34],["18:89:1",303,"ثُمَّ","Then","","أَتْبَعَ سَبَبًا",34],["18:92:1",303,"ثُمَّ","Then","","أَتْبَعَ سَبَبًا",34],["19:68:4",310,"ثُمَّ