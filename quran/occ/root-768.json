[["2:69:14",10,"صَفْرَآءُ","yellow","يَقُولُ إِنَّهَا بَقَرَةٌۭ","فَاقِعٌۭ لَّوْنُهَا تَسُرُّ",3243],["30:51:5",410,"مُصْفَرًّۭا","turn yellow","أَرْسَلْنَا رِيحًۭا فَرَأَوْهُ","لَّظَلُّوا۟ مِنۢ بَعْدِهِۦ",1904],["39:21:22",460,"مُصْفَرًّۭا","turn yellow","ثُمَّ يَهِيجُ فَتَرَىٰهُ","ثُمَّ يَجْعَلُهُۥ حُطَـٰمًا ۚ",1904],["57:20:22",540,"مُصْفَرًّۭا","turning yellow","ثُمَّ يَهِيجُ فَتَرَىٰهُ","ثُمَّ يَكُونُ حُطَـٰمًۭا ۖ",1904],["77:33:3",581,"صُفْرٌۭ","yellow","كَأَنَّهُۥ جِمَـٰلَتٌۭ","",3268]]