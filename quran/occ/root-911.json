[["13:10:13",250,"وَسَارِبٌۢ","or goes freely","هُوَ مُسْتَخْفٍۭ بِٱلَّيْلِ","بِٱلنَّهَارِ",4235],["18:61:11",300,"سَرَبًۭا","slipping away","سَبِيلَهُۥ فِى ٱلْبَحْرِ","",4258],["24:39:4",355,"كَسَرَابٍۭ","(are) like a mirage","وَٱلَّذِينَ كَفَرُوٓا۟ أَعْمَـٰلُهُمْ","بِقِيعَةٍۢ يَحْسَبُهُ ٱلظَّمْـَٔانُ",2629],["78:20:4",582,"سَرَابًا","a mirage","وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ","",2629]]