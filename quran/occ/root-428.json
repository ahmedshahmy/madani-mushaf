[["2:196:13",30,"رُءُوسَكُمْ","your heads","ٱلْهَدْىِ ۖ وَلَا تَحْلِقُوا۟","حَتَّىٰ يَبْلُغَ ٱلْهَدْىُ",555],["2:196:26",30,"رَّأْسِهِۦ","his head","بِهِۦٓ أَذًۭى مِّن","فَفِدْيَةٌۭ مِّن صِيَامٍ",555],["2:279:12",47,"رُءُوسُ","(is)","وَإِن تُبْتُمْ فَلَكُمْ","أَمْوَٰلِكُمْ لَا تَظْلِمُونَ",555],["5:6:14",108,"بِرُءُوسِكُمْ","your heads","إِلَى ٱلْمَرَافِقِ وَٱمْسَحُوا۟","وَأَرْجُلَكُمْ إِلَى ٱلْكَعْبَيْنِ ۚ",555],["7:150:19",169,"بِرَأْسِ","by head","وَأَلْقَى ٱلْأَلْوَاحَ وَأَخَذَ","أَخِيهِ يَجُرُّهُۥٓ إِلَيْهِ ۚ",555],["12:36:17",239,"رَأْسِى","my head","أَرَىٰنِىٓ أَحْمِلُ فَوْقَ","خُبْزًۭا تَأْكُلُ ٱلطَّيْرُ",555],["12:41:14",240,"رَّأْسِهِۦ ۚ","his head","فَتَأْكُلُ ٱلطَّيْرُ مِن","قُضِىَ ٱلْأَمْرُ ٱلَّذِى",555],["14:43:3",261,"رُءُوسِهِمْ","their heads","مُهْطِعِينَ مُقْنِعِى","لَا يَرْتَدُّ إِلَيْهِمْ",555],["17:51:17",287,"رُءُوسَهُمْ","their heads","مَرَّةٍۢ ۚ فَسَيُنْغِضُونَ إِلَيْكَ","وَيَقُولُونَ مَتَىٰ هُوَ ۖ",555],["19:4:8",305,"ٱلرَّأْسُ","(my) head","ٱلْعَظْمُ مِنِّى وَٱشْتَعَلَ","شَيْبًۭا وَلَمْ أَكُنۢ",555],["20:94:7",318,"بِرَأْسِىٓ ۖ","by my head","تَأْخُذْ بِلِحْيَتِى وَلَا","إِنِّى خَشِيتُ أَن",555],["21:65:4",327,"رُءُوسِهِمْ","their heads","ثُمَّ نُكِسُوا۟ عَلَىٰ","لَقَدْ عَلِمْتَ مَا",555],["22:19:16",334,"رُءُوسِهِمُ","their heads","يُصَبُّ مِن فَوْقِ","ٱلْحَمِيمُ",555],["32:12:6",416,"رُءُوسِهِمْ","their heads","إِذِ ٱلْمُجْرِمُونَ نَاكِسُوا۟","عِندَ رَبِّهِمْ رَبَّنَآ",555],["37:65:3",448,"رُءُوسُ","(was) heads","طَلْعُهَا كَأَنَّهُۥ","ٱلشَّيَـٰطِينِ",555],["44:48:4",498,"رَأْسِهِۦ","his head","ثُمَّ صُبُّوا۟ فَوْقَ","مِنْ عَذَابِ ٱلْحَمِيمِ",555],["48:27:15",514,"رُءُوسَكُمْ","your heads","ٱللَّهُ ءَامِنِينَ مُحَلِّقِينَ","وَمُقَصِّرِينَ لَا تَخَافُونَ ۖ",555],["63:5:10",555,"رُءُوسَهُمْ","their heads","رَسُولُ ٱللَّهِ لَوَّوْا۟","وَرَأَيْتَهُمْ يَصُدُّونَ وَهُم",555]]