[["17:68:10",289,"حَاصِبًۭا","a storm of stones","أَوْ يُرْسِلَ عَلَيْكُمْ","ثُمَّ لَا تَجِدُوا۟",1509],["21:98:7",330,"حَصَبُ","(are) firewood","مِن دُونِ ٱللَّهِ","جَهَنَّمَ أَنتُمْ لَهَا",3168],["29:40:8",401,"حَاصِبًۭا","a violent storm","مَّنْ أَرْسَلْنَا عَلَيْهِ","وَمِنْهُم مَّنْ أَخَذَتْهُ",1509],["54:34:4",530,"حَاصِبًا","a storm of stones","إِنَّآ أَرْسَلْنَا عَلَيْهِمْ","إِلَّآ ءَالَ لُوطٍۢ ۖ",1509],["67:17:9",563,"حَاصِبًۭا ۖ","a storm of stones","أَن يُرْسِلَ عَلَيْكُمْ","فَسَتَعْلَمُونَ كَيْفَ نَذِيرِ",1509]]