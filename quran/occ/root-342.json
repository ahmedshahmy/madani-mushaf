[["2:85:35",13,"خِزْىٌۭ","disgrace","ذَٰلِكَ مِنكُمْ إِلَّا","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ",805],["2:114:25",18,"خِزْىٌۭ","(is) disgrace","لَهُمْ فِى ٱلدُّنْيَا","وَلَهُمْ فِى ٱلْـَٔاخِرَةِ",805],["3:192:7",75,"أَخْزَيْتَهُۥ ۖ","You (have) disgraced him","تُدْخِلِ ٱلنَّارَ فَقَدْ","وَمَا لِلظَّـٰلِمِينَ مِنْ",716],["3:194:8",75,"تُخْزِنَا","disgrace us","عَلَىٰ رُسُلِكَ وَلَا","يَوْمَ ٱلْقِيَـٰمَةِ ۗ إِنَّكَ",716],["5:33:27",113,"خِزْىٌۭ","disgrace","ٱلْأَرْضِ ۚ ذَٰلِكَ لَهُمْ","فِى ٱلدُّنْيَا ۖ وَلَهُمْ",805],["5:41:62",114,"خِزْىٌۭ ۖ","(is) disgrace","لَهُمْ فِى ٱلدُّنْيَا","وَلَهُمْ فِى ٱلْـَٔاخِرَةِ",805],["9:2:13",187,"مُخْزِى","(is) the One Who (will) disgrace","ٱللَّهِ ۙ وَأَنَّ ٱللَّهَ","ٱلْكَـٰفِرِينَ",3895],["9:14:5",189,"وَيُخْزِهِمْ","and disgrace them","يُعَذِّبْهُمُ ٱللَّهُ بِأَيْدِيكُمْ","وَيَنصُرْكُمْ عَلَيْهِمْ وَيَشْفِ",716],["9:63:15",197,"ٱلْخِزْىُ","(is) the disgrace","خَـٰلِدًۭا فِيهَا ۚ ذَٰلِكَ","ٱلْعَظِيمُ",805],["10:98:15",220,"ٱلْخِزْىِ","(of) the disgrace","كَشَفْنَا عَنْهُمْ عَذَابَ","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا",805],["11:39:6",226,"يُخْزِيهِ","(that) will disgrace him","مَن يَأْتِيهِ عَذَابٌۭ","وَيَحِلُّ عَلَيْهِ عَذَابٌۭ",716],["11:66:12",229,"خِزْىِ","(the) disgrace","بِرَحْمَةٍۢ مِّنَّا وَمِنْ","يَوْمِئِذٍ ۗ إِنَّ رَبَّكَ",805],["11:78:20",230,"تُخْزُونِ","disgrace me","فَٱتَّقُوا۟ ٱللَّهَ وَلَا","فِى ضَيْفِىٓ ۖ أَلَيْسَ",716],["11:93:12",232,"يُخْزِيهِ","(that will) disgrace him","مَن يَأْتِيهِ عَذَابٌۭ","وَمَنْ هُوَ كَـٰذِبٌۭ ۖ",716],["15:69:4",265,"تُخْزُونِ","disgrace me","وَٱتَّقُوا۟ ٱللَّهَ وَلَا","",716],["16:27:4",270,"يُخْزِيهِمْ","He will disgrace them","ثُمَّ يَوْمَ ٱلْقِيَـٰمَةِ","وَيَقُولُ أَيْنَ شُرَكَآءِىَ",716],["16:27:17",270,"ٱلْخِزْىَ","the disgrace","أُوتُوا۟ ٱلْعِلْمَ إِنَّ","ٱلْيَوْمَ وَٱلسُّوٓءَ عَلَى",805],["20:134:19",321,"وَنَخْزَىٰ","and disgraced","قَبْلِ أَن نَّذِلَّ","",4054],["22:9:10",333,"خِزْىٌۭ ۖ","(is) disgrace","لَهُۥ فِى ٱلدُّنْيَا","وَنُذِيقُهُۥ يَوْمَ ٱلْقِيَـٰمَةِ",805],["26:87:2",371,"تُخْزِنِى","disgrace me","وَلَا","يَوْمَ يُبْعَثُونَ",716],["39:26:3",461,"ٱلْخِزْىَ","the disgrace","فَأَذَاقَهُمُ ٱللَّهُ","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ",805],["39:40:4",462,"يُخْزِيهِ","disgracing him","مَن يَأْتِيهِ عَذَابٌۭ","وَيَحِلُّ عَلَيْهِ عَذَابٌۭ",716],["41:16:10",478,"ٱلْخِزْىِ","(of) disgrace","نَّحِسَاتٍۢ لِّنُذِيقَهُمْ عَذَابَ","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ",805],["41:16:16",478,"أَخْزَىٰ ۖ","(is) more disgracing","ٱلدُّنْيَا ۖ وَلَعَذَابُ ٱلْـَٔاخِرَةِ","وَهُمْ لَا يُنصَرُونَ",3056],["59:5:12",546,"وَلِيُخْزِىَ","and that He may disgrace","أُصُولِهَا فَبِإِذْنِ ٱللَّهِ","ٱلْفَـٰسِقِينَ",716],["66:8:23",561,"يُخْزِى","will be disgraced","ٱلْأَنْهَـٰرُ يَوْمَ لَا","ٱللَّهُ ٱلنَّبِىَّ وَٱلَّذِينَ",716]]