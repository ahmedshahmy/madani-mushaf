[["2:77:9",12,"يُعْلِنُونَ","they declare","مَا يُسِرُّونَ وَمَا","",710],["2:274:7",46,"وَعَلَانِيَةًۭ","and openly","بِٱلَّيْلِ وَٱلنَّهَارِ سِرًّۭا","فَلَهُمْ أَجْرُهُمْ عِندَ",1497],["11:5:15",221,"يُعْلِنُونَ ۚ","they reveal","مَا يُسِرُّونَ وَمَا","إِنَّهُۥ عَلِيمٌۢ بِذَاتِ",710],["13:22:12",252,"وَعَلَانِيَةًۭ","and publicly","مِمَّا رَزَقْنَـٰهُمْ سِرًّۭا","وَيَدْرَءُونَ بِٱلْحَسَنَةِ ٱلسَّيِّئَةَ",1497],["14:31:11",259,"وَعَلَانِيَةًۭ","and publicly","مِمَّا رَزَقْنَـٰهُمْ سِرًّۭا","مِّن قَبْلِ أَن",1497],["14:38:7",260,"نُعْلِنُ ۗ","we proclaim","مَا نُخْفِى وَمَا","وَمَا يَخْفَىٰ عَلَى",710],["16:19:6",269,"تُعْلِنُونَ","you reveal","مَا تُسِرُّونَ وَمَا","",710],["16:23:9",269,"يُعْلِنُونَ ۚ","they reveal","مَا يُسِرُّونَ وَمَا","إِنَّهُۥ لَا يُحِبُّ",710],["27:25:14",379,"تُعْلِنُونَ","you declare","مَا تُخْفُونَ وَمَا","",710],["27:74:8",383,"يُعْلِنُونَ","they declare","تُكِنُّ صُدُورُهُمْ وَمَا","",710],["28:69:7",393,"يُعْلِنُونَ","they declare","تُكِنُّ صُدُورُهُمْ وَمَا","",710],["35:29:12",437,"وَعَلَانِيَةًۭ","and openly","مِمَّا رَزَقْنَـٰهُمْ سِرًّۭا","يَرْجُونَ تِجَـٰرَةًۭ لَّن",1497],["36:76:9",445,"يُعْلِنُونَ","they declare","مَا يُسِرُّونَ وَمَا","",710],["60:1:41",549,"أَعْلَنتُمْ ۚ","you declare","بِمَآ أَخْفَيْتُمْ وَمَآ","وَمَن يَفْعَلْهُ مِنكُمْ",710],["64:4:10",556,"تُعْلِنُونَ ۚ","you declare","مَا تُسِرُّونَ وَمَا","وَٱللَّهُ عَلِيمٌۢ بِذَاتِ",710],["71:9:3",570,"أَعْلَنتُ","announced","ثُمَّ إِنِّىٓ","لَهُمْ وَأَسْرَرْتُ لَهُمْ",710]]