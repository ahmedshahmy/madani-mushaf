[["2:248:21",40,"تَحْمِلُهُ","will carry it","مُوسَىٰ وَءَالُ هَـٰرُونَ","ٱلْمَلَـٰٓئِكَةُ ۚ إِنَّ فِى",282],["2:286:22",49,"تَحْمِلْ","lay","أَخْطَأْنَا ۚ رَبَّنَا وَلَا","عَلَيْنَآ إِصْرًۭا كَمَا",282],["2:286:26",49,"حَمَلْتَهُۥ","(which) You laid [it]","عَلَيْنَآ إِصْرًۭا كَمَا","عَلَى ٱلَّذِينَ مِن",282],["2:286:33",49,"تُحَمِّلْنَا","lay on us","قَبْلِنَا ۚ رَبَّنَا وَلَا","مَا لَا طَاقَةَ",1306],["4:112:11",96,"ٱحْتَمَلَ","he (has) burdened (himself)","بِهِۦ بَرِيٓـًۭٔا فَقَدِ","بُهْتَـٰنًۭا وَإِثْمًۭا مُّبِينًۭا",2098],["6:31:19",131,"يَحْمِلُونَ","will bear","فَرَّطْنَا فِيهَا وَهُمْ","أَوْزَارَهُمْ عَلَىٰ ظُهُورِهِمْ ۚ",282],["6:142:3",146,"حَمُولَةًۭ","(are some for) burden","وَمِنَ ٱلْأَنْعَـٰمِ","وَفَرْشًۭا ۚ كُلُوا۟ مِمَّا",3186],["6:146:16",147,"حَمَلَتْ","carried","شُحُومَهُمَآ إِلَّا مَا","ظُهُورُهُمَآ أَوِ ٱلْحَوَايَآ",282],["7:176:15",173,"تَحْمِلْ","you attack","كَمَثَلِ ٱلْكَلْبِ إِن","عَلَيْهِ يَلْهَثْ أَوْ",282],["7:189:14",175,"حَمَلَتْ","she carries","إِلَيْهَا ۖ فَلَمَّا تَغَشَّىٰهَا","حَمْلًا خَفِيفًۭا فَمَرَّتْ",282],["7:189:15",175,"حَمْلًا","a burden","فَلَمَّا تَغَشَّىٰهَا حَمَلَتْ","خَفِيفًۭا فَمَرَّتْ بِهِۦ ۖ",1056],["9:92:7",201,"لِتَحْمِلَهُمْ","that you provide them with mounts","إِذَا مَآ أَتَوْكَ","قُلْتَ لَآ أَجِدُ",282],["9:92:12",201,"أَحْمِلُكُمْ","to mount you","لَآ أَجِدُ مَآ","عَلَيْهِ تَوَلَّوا۟ وَّأَعْيُنُهُمْ",282],["11:40:8",226,"ٱحْمِلْ","Load","وَفَارَ ٱلتَّنُّورُ قُلْنَا","فِيهَا مِن كُلٍّۢ",282],["12:36:15",239,"أَحْمِلُ","[I am] carrying","ٱلْـَٔاخَرُ إِنِّىٓ أَرَىٰنِىٓ","فَوْقَ رَأْسِى خُبْزًۭا",282],["12:72:8",244,"حِمْلُ","(is) a load","وَلِمَن جَآءَ بِهِۦ","بَعِيرٍۢ وَأَنَا۠ بِهِۦ",1789],["13:8:4",250,"تَحْمِلُ","carries","ٱللَّهُ يَعْلَمُ مَا","كُلُّ أُنثَىٰ وَمَا",282],["13:17:8",251,"فَٱحْتَمَلَ","and carries","فَسَالَتْ أَوْدِيَةٌۢ بِقَدَرِهَا","ٱلسَّيْلُ زَبَدًۭا رَّابِيًۭا ۚ",2098],["16:7:1",268,"وَتَحْمِلُ","And they carry","","أَثْقَالَكُمْ إِلَىٰ بَلَدٍۢ",282],["16:25:1",269,"لِيَحْمِلُوٓا۟","That they may bear","","أَوْزَارَهُمْ كَامِلَةًۭ يَوْمَ",282],["17:3:3",282,"حَمَلْنَا","We carried","ذُرِّيَّةَ مَنْ","مَعَ نُوحٍ ۚ إِنَّهُۥ",282],["17:70:5",289,"وَحَمَلْنَـٰهُمْ","and We carried them","كَرَّمْنَا بَنِىٓ ءَادَمَ","فِى ٱلْبَرِّ وَٱلْبَحْرِ",282],["19:22:1",306,"۞ فَحَمَلَتْهُ","So she conceived him","","فَٱنتَبَذَتْ بِهِۦ مَكَانًۭا",282],["19:27:4",307,"تَحْمِلُهُۥ ۖ","carrying him","فَأَتَتْ بِهِۦ قَوْمَهَا","قَالُوا۟ يَـٰمَرْيَمُ لَقَدْ",282],["19:58:12",309,"حَمَلْنَا","We carried","ذُرِّيَّةِ ءَادَمَ وَمِمَّنْ","مَعَ نُوحٍۢ وَمِن",282],["20:87:7",317,"حُمِّلْنَآ","[we] were made to carry","مَوْعِدَكَ بِمَلْكِنَا وَلَـٰكِنَّا","أَوْزَارًۭا مِّن زِينَةِ",1306],["20:100:5",319,"يَحْمِلُ","will bear","أَعْرَضَ عَنْهُ فَإِنَّهُۥ","يَوْمَ ٱلْقِيَـٰمَةِ وِزْرًا",282],["20:101:7",319,"حِمْلًۭا","(as) a load","لَهُمْ يَوْمَ ٱلْقِيَـٰمَةِ","",1789],["20:111:8",319,"حَمَلَ","carried","وَقَدْ خَابَ مَنْ","ظُلْمًۭا",282],["22:2:11",332,"حَمْلٍ","pregnant woman","وَتَضَعُ كُلُّ ذَاتِ","حَمْلَهَا وَتَرَى ٱلنَّاسَ",1056],["22:2:12",332,"حَمْلَهَا","her load","كُلُّ ذَاتِ حَمْلٍ","وَتَرَى ٱلنَّاسَ سُكَـٰرَىٰ",1056],["23:22:4",343,"تُحْمَلُونَ","you are carried","وَعَلَيْهَا وَعَلَى ٱلْفُلْكِ","",282],["24:54:11",357,"حُمِّلَ","(is) placed on him","فَإِنَّمَا عَلَيْهِ مَا","وَعَلَيْكُم مَّا حُمِّلْتُمْ ۖ",1306],["24:54:14",357,"حُمِّلْتُمْ ۖ","(is) placed on you","حُمِّلَ وَعَلَيْكُم مَّا","وَإِن تُطِيعُوهُ تَهْتَدُوا۟ ۚ",1306],["29:12:8",397,"وَلْنَحْمِلْ","and we will carry","ءَامَنُوا۟ ٱتَّبِعُوا۟ سَبِيلَنَا","خَطَـٰيَـٰكُمْ وَمَا هُم",282],["29:12:12",397,"بِحَـٰمِلِينَ","(are) going to carry","خَطَـٰيَـٰكُمْ وَمَا هُم","مِنْ خَطَـٰيَـٰهُم مِّن",3177],["29:13:1",397,"وَلَيَحْمِلُنَّ","But surely they will carry","","أَثْقَالَهُمْ وَأَثْقَالًۭا مَّعَ",282],["29:60:5",403,"تَحْمِلُ","carry","مِّن دَآبَّةٍۢ لَّا","رِزْقَهَا ٱللَّهُ يَرْزُقُهَا",282],["31:14:4",412,"حَمَلَتْهُ","carried him","وَوَصَّيْنَا ٱلْإِنسَـٰنَ بِوَٰلِدَيْهِ","أُمُّهُۥ وَهْنًا عَلَىٰ",282],["33:58:9",426,"ٱحْتَمَلُوا۟","they bear","مَا ٱكْتَسَبُوا۟ فَقَدِ","بُهْتَـٰنًۭا وَإِثْمًۭا مُّبِينًۭا",2098],["33:72:10",427,"يَحْمِلْنَهَا","bear it","وَٱلْجِبَالِ فَأَبَيْنَ أَن","وَأَشْفَقْنَ مِنْهَا وَحَمَلَهَا",282],["33:72:13",427,"وَحَمَلَهَا","but bore it","يَحْمِلْنَهَا وَأَشْفَقْنَ مِنْهَا","ٱلْإِنسَـٰنُ ۖ إِنَّهُۥ كَانَ",282],["35:11:12",435,"تَحْمِلُ","conceives","جَعَلَكُمْ أَزْوَٰجًۭا ۚ وَمَا","مِنْ أُنثَىٰ وَلَا",282],["35:18:10",436,"حِمْلِهَا","(carry) its load","تَدْعُ مُثْقَلَةٌ إِلَىٰ","لَا يُحْمَلْ مِنْهُ",1789],["35:18:12",436,"يُحْمَلْ","will be carried","إِلَىٰ حِمْلِهَا لَا","مِنْهُ شَىْءٌۭ وَلَوْ",282],["36:41:4",443,"حَمَلْنَا","We carried","وَءَايَةٌۭ لَّهُمْ أَنَّا","ذُرِّيَّتَهُمْ فِى ٱلْفُلْكِ",282],["40:7:2",467,"يَحْمِلُونَ","bear","ٱلَّذِينَ","ٱلْعَرْشَ وَمَنْ حَوْلَهُۥ",282],["40:80:12",476,"تُحْمَلُونَ","you are carried","وَعَلَيْهَا وَعَلَى ٱلْفُلْكِ","",282],["41:47:12",482,"تَحْمِلُ","bears","مِّنْ أَكْمَامِهَا وَمَا","مِنْ أُنثَىٰ وَلَا",282],["46:15:5",504,"حَمَلَتْهُ","Carried him","ٱلْإِنسَـٰنَ بِوَٰلِدَيْهِ إِحْسَـٰنًا ۖ","أُمُّهُۥ كُرْهًۭا وَوَضَعَتْهُ",282],["46:15:10",504,"وَحَمْلُهُۥ","And (the) bearing of him","كُرْهًۭا وَوَضَعَتْهُ كُرْهًۭا ۖ","وَفِصَـٰلُهُۥ ثَلَـٰثُونَ شَهْرًا ۚ",1056],["51:2:1",520,"فَٱلْحَـٰمِلَـٰتِ","And those carrying","","وِقْرًۭا",3176],["54:13:1",529,"وَحَمَلْنَـٰهُ","And We carried him","","عَلَىٰ ذَاتِ أَلْوَٰحٍۢ",282],["62:5:3",553,"حُمِّلُوا۟","were entrusted","مَثَلُ ٱلَّذِينَ","ٱلتَّوْرَىٰةَ ثُمَّ لَمْ",1306],["62:5:7",553,"يَحْمِلُوهَا","they bore it","ٱلتَّوْرَىٰةَ ثُمَّ لَمْ","كَمَثَلِ ٱلْحِمَارِ يَحْمِلُ",282],["62:5:10",553,"يَحْمِلُ","who carries","يَحْمِلُوهَا كَمَثَلِ ٱلْحِمَارِ","أَسْفَارًۢا ۚ بِئْسَ مَثَلُ",282],["65:4:16",558,"ٱلْأَحْمَالِ","pregnant","لَمْ يَحِضْنَ ۚ وَأُو۟لَـٰتُ","أَجَلُهُنَّ أَن يَضَعْنَ",2958],["65:4:20",558,"حَمْلَهُنَّ ۚ","their burdens","أَجَلُهُنَّ أَن يَضَعْنَ","وَمَن يَتَّقِ ٱللَّهَ",1056],["65:6:14",559,"حَمْلٍۢ","pregnant","وَإِن كُنَّ أُو۟لَـٰتِ","فَأَنفِقُوا۟ عَلَيْهِنَّ حَتَّىٰ",1056],["65:6:19",559,"حَمْلَهُنَّ ۚ","their burden","عَلَيْهِنَّ حَتَّىٰ يَضَعْنَ","فَإِنْ أَرْضَعْنَ لَكُمْ",1056],["69:11:5",567,"حَمَلْنَـٰكُمْ","We carried you","لَمَّا طَغَا ٱلْمَآءُ","فِى ٱلْجَارِيَةِ",282],["69:14:1",567,"وَحُمِلَتِ","And are lifted","","ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا",282],["69:17:4",567,"وَيَحْمِلُ","and will bear","وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ","عَرْشَ رَبِّكَ فَوْقَهُمْ",282],["111:4:2",603,"حَمَّالَةَ","(the) carrier","وَٱمْرَأَتُهُۥ","ٱلْحَطَبِ",3187]]