[["2:69:8",10,"لَوْنُهَا ۚ","(is) its color","يُبَيِّن لَّنَا مَا","قَالَ إِنَّهُۥ يَقُولُ",907],["2:69:16",10,"لَّوْنُهَا","(in) its color","بَقَرَةٌۭ صَفْرَآءُ فَاقِعٌۭ","تَسُرُّ ٱلنَّـٰظِرِينَ",907],["16:13:7",268,"أَلْوَٰنُهُۥٓ ۗ","colors","فِى ٱلْأَرْضِ مُخْتَلِفًا","إِنَّ فِى ذَٰلِكَ",907],["16:69:15",274,"أَلْوَٰنُهُۥ","colors","بُطُونِهَا شَرَابٌۭ مُّخْتَلِفٌ","فِيهِ شِفَآءٌۭ لِّلنَّاسِ ۗ",907],["30:22:8",406,"وَأَلْوَٰنِكُمْ ۚ","and your colors","وَٱلْأَرْضِ وَٱخْتِلَـٰفُ أَلْسِنَتِكُمْ","إِنَّ فِى ذَٰلِكَ",907],["35:27:13",437,"أَلْوَٰنُهَا ۚ","[their] colors","بِهِۦ ثَمَرَٰتٍۢ مُّخْتَلِفًا","وَمِنَ ٱلْجِبَالِ جُدَدٌۢ",907],["35:27:20",437,"أَلْوَٰنُهَا","[their] colors","بِيضٌۭ وَحُمْرٌۭ مُّخْتَلِفٌ","وَغَرَابِيبُ سُودٌۭ",907],["35:28:6",437,"أَلْوَٰنُهُۥ","[their] colors","وَٱلدَّوَآبِّ وَٱلْأَنْعَـٰمِ مُخْتَلِفٌ","كَذَٰلِكَ ۗ إِنَّمَا يَخْشَى",907],["39:21:18",460,"أَلْوَٰنُهُۥ","colors","بِهِۦ زَرْعًۭا مُّخْتَلِفًا","ثُمَّ يَهِيجُ فَتَرَىٰهُ",907]]