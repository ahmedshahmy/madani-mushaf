[["2:84:11",13,"دِيَـٰرِكُمْ","your homes","تُخْرِجُونَ أَنفُسَكُم مِّن","ثُمَّ أَقْرَرْتُمْ وَأَنتُمْ",248],["2:85:10",13,"دِيَـٰرِهِمْ","their homes","فَرِيقًۭا مِّنكُم مِّن","تَظَـٰهَرُونَ عَلَيْهِم بِٱلْإِثْمِ",248],["2:94:5",15,"ٱلدَّارُ","the home","إِن كَانَتْ لَكُمُ","ٱلْـَٔاخِرَةُ عِندَ ٱللَّهِ",248],["2:243:7",39,"دِيَـٰرِهِمْ","their homes","ٱلَّذِينَ خَرَجُوا۟ مِن","وَهُمْ أُلُوفٌ حَذَرَ",248],["2:246:42",40,"دِيَـٰرِنَا","our homes","وَقَدْ أُخْرِجْنَا مِن","وَأَبْنَآئِنَا ۖ فَلَمَّا كُتِبَ",248],["2:282:101",48,"تُدِيرُونَهَا","you carry out","تَكُونَ تِجَـٰرَةً حَاضِرَةًۭ","بَيْنَكُمْ فَلَيْسَ عَلَيْكُمْ",4457],["3:195:21",76,"دِيَـٰرِهِمْ","their homes","هَاجَرُوا۟ وَأُخْرِجُوا۟ مِن","وَأُوذُوا۟ فِى سَبِيلِى",248],["4:66:11",89,"دِيَـٰرِكُم","your homes","أَوِ ٱخْرُجُوا۟ مِن","مَّا فَعَلُوهُ إِلَّا",248],["5:52:12",117,"دَآئِرَ ةٌۭ ۚ","a misfortune","نَخْشَىٰٓ أَن تُصِيبَنَا","فَعَسَى ٱللَّهُ أَن",1819],["6:32:7",131,"وَلَلدَّارُ","but the home","إِلَّا لَعِبٌۭ وَلَهْوٌۭ ۖ","ٱلْـَٔاخِرَةُ خَيْرٌۭ لِّلَّذِينَ",248],["6:127:2",144,"دَارُ","(will be) home","۞ لَهُمْ","ٱلسَّلَـٰمِ عِندَ رَبِّهِمْ ۖ",248],["6:135:14",145,"ٱلدَّارِ ۗ","(a good) home","تَكُونُ لَهُۥ عَـٰقِبَةُ","إِنَّهُۥ لَا يُفْلِحُ",248],["7:78:5",160,"دَارِهِمْ","their homes","ٱلرَّجْفَةُ فَأَصْبَحُوا۟ فِى","جَـٰثِمِينَ",248],["7:91:5",162,"دَارِهِمْ","their home(s)","ٱلرَّجْفَةُ فَأَصْبَحُوا۟ فِى","جَـٰثِمِينَ",248],["7:145:19",168,"دَارَ","(the) home","يَأْخُذُوا۟ بِأَحْسَنِهَا ۚ سَأُو۟رِيكُمْ","ٱلْفَـٰسِقِينَ",248],["7:169:34",172,"وَٱلدَّارُ","And the home","وَدَرَسُوا۟ مَا فِيهِ ۗ","ٱلْـَٔاخِرَةُ خَيْرٌۭ لِّلَّذِينَ",248],["8:47:6",183,"دِيَـٰرِهِم","their homes","كَٱلَّذِينَ خَرَجُوا۟ مِن","بَطَرًۭا وَرِئَآءَ ٱلنَّاسِ",248],["9:98:10",202,"ٱلدَّوَآئِرَ ۚ","the turns (of misfortune)","مَغْرَمًۭا وَيَتَرَبَّصُ بِكُمُ","عَلَيْهِمْ دَآئِرَةُ ٱلسَّوْءِ ۗ",3390],["9:98:12",202,"دَآئِرَةُ","(will be) the turn","بِكُمُ ٱلدَّوَآئِرَ ۚ عَلَيْهِمْ","ٱلسَّوْءِ ۗ وَٱللَّهُ سَمِيعٌ",1819],["10:25:4",211,"دَارِ","(the) Home","وَٱللَّهُ يَدْعُوٓا۟ إِلَىٰ","ٱلسَّلَـٰمِ وَيَهْدِى مَن",248],["11:65:5",229,"دَارِكُمْ","your home(s)","فَقَالَ تَمَتَّعُوا۟ فِى","ثَلَـٰثَةَ أَيَّامٍۢ ۖ ذَٰلِكَ",248],["11:67:7",229,"دِيَـٰرِهِمْ","their homes","ٱلصَّيْحَةُ فَأَصْبَحُوا۟ فِى","جَـٰثِمِينَ",248],["11:94:17",232,"دِيَـٰرِهِمْ","their homes","ٱلصَّيْحَةُ فَأَصْبَحُوا۟ فِى","جَـٰثِمِينَ",248],["12:109:23",248,"وَلَدَارُ","And surely the home","ٱلَّذِينَ مِن قَبْلِهِمْ ۗ","ٱلْـَٔاخِرَةِ خَيْرٌۭ لِّلَّذِينَ",248],["13:22:19",252,"ٱلدَّارِ","(of) the Home","أُو۟لَـٰٓئِكَ لَهُمْ عُقْبَى","",248],["13:24:7",252,"ٱلدَّارِ","(of) the Home","صَبَرْتُمْ ۚ فَنِعْمَ عُقْبَى","",248],["13:25:23",252,"ٱلدَّارِ","home","ٱللَّعْنَةُ وَلَهُمْ سُوٓءُ","",248],["13:31:42",253,"دَارِهِمْ","their homes","تَحُلُّ قَرِيبًۭا مِّن","حَتَّىٰ يَأْتِىَ وَعْدُ",248],["13:42:18",254,"ٱلدَّارِ","the home","ٱلْكُفَّـٰرُ لِمَنْ عُقْبَى","",248],["14:28:11",259,"دَارَ","(to the) house","كُفْرًۭا وَأَحَلُّوا۟ قَوْمَهُمْ","ٱلْبَوَارِ",248],["16:30:15",270,"وَلَدَارُ","and the home","هَـٰذِهِ ٱلدُّنْيَا حَسَنَةٌۭ ۚ","ٱلْـَٔاخِرَةِ خَيْرٌۭ ۚ وَلَنِعْمَ",248],["16:30:19",270,"دَارُ","(is) the home","ٱلْـَٔاخِرَةِ خَيْرٌۭ ۚ وَلَنِعْمَ","ٱلْمُتَّقِينَ",248],["17:5:14",282,"ٱلدِّيَارِ ۚ","(of) the homes","شَدِيدٍۢ فَجَاسُوا۟ خِلَـٰلَ","وَكَانَ وَعْدًۭا مَّفْعُولًۭا",248],["22:40:4",337,"دِيَـٰرِهِم","their homes","ٱلَّذِينَ أُخْرِجُوا۟ مِن","بِغَيْرِ حَقٍّ إِلَّآ",248],["28:37:14",390,"ٱلدَّارِ ۖ","the good end in the Hereafter","تَكُونُ لَهُۥ عَـٰقِبَةُ","إِنَّهُۥ لَا يُفْلِحُ",248],["28:77:5",394,"ٱلدَّارَ","the home","فِيمَآ ءَاتَىٰكَ ٱللَّهُ","ٱلْـَٔاخِرَةَ ۖ وَلَا تَنسَ",248],["28:81:3",395,"وَبِدَارِهِ","and his home","فَخَسَفْنَا بِهِۦ","ٱلْأَرْضَ فَمَا كَانَ",248],["28:83:2",395,"ٱلدَّارُ","the Home","تِلْكَ","ٱلْـَٔاخِرَةُ نَجْعَلُهَا لِلَّذِينَ",248],["29:37:6",400,"دَارِهِمْ","their home","ٱلرَّجْفَةُ فَأَصْبَحُوا۟ فِى","جَـٰثِمِينَ",248],["29:64:9",404,"ٱلدَّارَ","the Home","لَهْوٌۭ وَلَعِبٌۭ ۚ وَإِنَّ","ٱلْـَٔاخِرَةَ لَهِىَ ٱلْحَيَوَانُ ۚ",248],["33:19:9",420,"تَدُورُ","revolving","رَأَيْتَهُمْ يَنظُرُونَ إِلَيْكَ","أَعْيُنُهُمْ كَٱلَّذِى يُغْشَىٰ",4362],["33:27:3",421,"وَدِيَـٰرَهُمْ","and their houses","وَأَوْرَثَكُمْ أَرْضَهُمْ","وَأَمْوَٰلَهُمْ وَأَرْضًۭا لَّمْ",248],["33:29:6",421,"وَٱلدَّارَ","and the Home","تُرِدْنَ ٱللَّهَ وَرَسُولَهُۥ","ٱلْـَٔاخِرَةَ فَإِنَّ ٱللَّهَ",248],["35:35:3",438,"دَارَ","(in) a Home","ٱلَّذِىٓ أَحَلَّنَا","ٱلْمُقَامَةِ مِن فَضْلِهِۦ",248],["38:46:5",456,"ٱلدَّارِ","(of) the Home","أَخْلَصْنَـٰهُم بِخَالِصَةٍۢ ذِكْرَى","",248],["40:39:10",471,"دَارُ","(is the) home","وَإِنَّ ٱلْـَٔاخِرَةَ هِىَ","ٱلْقَرَارِ",248],["40:52:10",473,"ٱلدَّارِ","home","ٱللَّعْنَةُ وَلَهُمْ سُوٓءُ","",248],["41:28:8",479,"دَارُ","(is the) home","ٱلنَّارُ ۖ لَهُمْ فِيهَا","ٱلْخُلْدِ ۖ جَزَآءًۢ بِمَا",248],["48:6:11",511,"دَآئِرَةُ","(is) a turn","ظَنَّ ٱلسَّوْءِ ۚ عَلَيْهِمْ","ٱلسَّوْءِ ۖ وَغَضِبَ ٱللَّهُ",1819],["59:2:10",545,"دِيَـٰرِهِمْ","their homes","أَهْلِ ٱلْكِتَـٰبِ مِن","لِأَوَّلِ ٱلْحَشْرِ ۚ مَا",248],["59:8:6",546,"دِيَـٰرِهِمْ","their homes","ٱلَّذِينَ أُخْرِجُوا۟ مِن","وَأَمْوَٰلِهِمْ يَبْتَغُونَ فَضْلًۭا",248],["59:9:3",546,"ٱلدَّارَ","(in) the home","وَٱلَّذِينَ تَبَوَّءُو","وَٱلْإِيمَـٰنَ مِن قَبْلِهِمْ",248],["60:8:13",550,"دِيَـٰرِكُمْ","your homes","وَلَمْ يُخْرِجُوكُم مِّن","أَن تَبَرُّوهُمْ وَتُقْسِطُوٓا۟",248],["60:9:11",550,"دِيَـٰرِكُمْ","your homes","ٱلدِّينِ وَأَخْرَجُوكُم مِّن","وَظَـٰهَرُوا۟ عَلَىٰٓ إِخْرَاجِكُمْ",248],["71:26:10",571,"دَيَّارًا","(as) an inhabitant","ٱلْأَرْضِ مِنَ ٱلْكَـٰفِرِينَ","",3379]]