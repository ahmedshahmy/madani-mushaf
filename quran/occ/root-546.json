[["2:19:14",4,"ٱلصَّوَٰعِقِ","the thunderclaps","فِىٓ ءَاذَانِهِم مِّنَ","حَذَرَ ٱلْمَوْتِ ۚ وَٱللَّهُ",961],["2:55:12",8,"ٱلصَّـٰعِقَةُ","the thunderbolt","ٱللَّهَ جَهْرَةًۭ فَأَخَذَتْكُمُ","وَأَنتُمْ تَنظُرُونَ",961],["4:153:21",102,"ٱلصَّـٰعِقَةُ","the thunderbolt","ٱللَّهَ جَهْرَةًۭ فَأَخَذَتْهُمُ","بِظُلْمِهِمْ ۚ ثُمَّ ٱتَّخَذُوا۟",961],["7:143:32",167,"صَعِقًۭا ۚ","unconscious","دَكًّۭا وَخَرَّ مُوسَىٰ","فَلَمَّآ أَفَاقَ قَالَ",3233],["13:13:8",250,"ٱلصَّوَٰعِقَ","the thunderbolts","مِنْ خِيفَتِهِۦ وَيُرْسِلُ","فَيُصِيبُ بِهَا مَن",961],["39:68:4",466,"فَصَعِقَ","then (will) fall dead","وَنُفِخَ فِى ٱلصُّورِ","مَن فِى ٱلسَّمَـٰوَٰتِ",2286],["41:13:5",478,"صَـٰعِقَةًۭ","(of) a thunderbolt","أَعْرَضُوا۟ فَقُلْ أَنذَرْتُكُمْ","مِّثْلَ صَـٰعِقَةِ عَادٍۢ",961],["41:13:7",478,"صَـٰعِقَةِ","(the) thunderbolt","أَنذَرْتُكُمْ صَـٰعِقَةًۭ مِّثْلَ","عَادٍۢ وَثَمُودَ",961],["41:17:9",478,"صَـٰعِقَةُ","a thunderbolt","عَلَى ٱلْهُدَىٰ فَأَخَذَتْهُمْ","ٱلْعَذَابِ ٱلْهُونِ بِمَا",961],["51:44:6",522,"ٱلصَّـٰعِقَةُ","the thunderbolt","أَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ","وَهُمْ يَنظُرُونَ",961],["52:45:7",525,"يُصْعَقُونَ","they will faint","يَوْمَهُمُ ٱلَّذِى فِيهِ","",2286]]