[["12:18:3",237,"قَمِيصِهِۦ","his shirt","وَجَآءُو عَلَىٰ","بِدَمٍۢ كَذِبٍۢ ۚ قَالَ",1220],["12:25:4",238,"قَمِيصَهُۥ","his shirt","وَٱسْتَبَقَا ٱلْبَابَ وَقَدَّتْ","مِن دُبُرٍۢ وَأَلْفَيَا",1220],["12:26:12",238,"قَمِيصُهُۥ","his shirt","أَهْلِهَآ إِن كَانَ","قُدَّ مِن قُبُلٍۢ",1220],["12:27:3",238,"قَمِيصُهُۥ","his shirt","وَإِن كَانَ","قُدَّ مِن دُبُرٍۢ",1220],["12:28:3",238,"قَمِيصَهُۥ","his shirt","فَلَمَّا رَءَا","قُدَّ مِن دُبُرٍۢ",1220],["12:93:2",246,"بِقَمِيصِى","with this shirt of mine","ٱذْهَبُوا۟","هَـٰذَا فَأَلْقُوهُ عَلَىٰ",1220]]