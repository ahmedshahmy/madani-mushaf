[["21:91:3",330,"فَرْجَهَا","her chastity","وَٱلَّتِىٓ أَحْصَنَتْ","فَنَفَخْنَا فِيهَا مِن",973],["23:5:3",342,"لِفُرُوجِهِمْ","of their modesty","وَٱلَّذِينَ هُمْ","حَـٰفِظُونَ",973],["24:30:7",353,"فُرُوجَهُمْ ۚ","their chastity","مِنْ أَبْصَـٰرِهِمْ وَيَحْفَظُوا۟","ذَٰلِكَ أَزْكَىٰ لَهُمْ ۗ",973],["24:31:7",353,"فُرُوجَهُنَّ","their chastity","مِنْ أَبْصَـٰرِهِنَّ وَيَحْفَظْنَ","وَلَا يُبْدِينَ زِينَتَهُنَّ",973],["33:35:19",422,"فُرُوجَهُمْ","their chastity","وَٱلصَّـٰٓئِمِينَ وَٱلصَّـٰٓئِمَـٰتِ وَٱلْحَـٰفِظِينَ","وَٱلْحَـٰفِظَـٰتِ وَٱلذَّٰكِرِينَ ٱللَّهَ",973],["50:6:12",518,"فُرُوجٍۢ","rifts","وَمَا لَهَا مِن","",973],["66:12:6",561,"فَرْجَهَا","her chastity","عِمْرَٰنَ ٱلَّتِىٓ أَحْصَنَتْ","فَنَفَخْنَا فِيهِ مِن",973],["70:29:3",569,"لِفُرُوجِهِمْ","their modesty","وَٱلَّذِينَ هُمْ","حَـٰفِظُونَ",973],["77:9:3",580,"فُرِجَتْ","is cleft asunder","وَإِذَا ٱلسَّمَآءُ","",3443]]