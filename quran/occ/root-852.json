[["18:56:11",300,"لِيُدْحِضُوا۟","to refute","ٱلَّذِينَ كَفَرُوا۟ بِٱلْبَـٰطِلِ","بِهِ ٱلْحَقَّ ۖ وَٱتَّخَذُوٓا۟",2804],["37:141:4",451,"ٱلْمُدْحَضِينَ","the losers","فَسَاهَمَ فَكَانَ مِنَ","",3791],["40:5:15",467,"لِيُدْحِضُوا۟","to refute","لِيَأْخُذُوهُ ۖ وَجَـٰدَلُوا۟ بِٱلْبَـٰطِلِ","بِهِ ٱلْحَقَّ فَأَخَذْتُهُمْ ۖ",2804],["42:16:11",485,"دَاحِضَةٌ","(is) invalid","ٱسْتُجِيبَ لَهُۥ حُجَّتُهُمْ","عِندَ رَبِّهِمْ وَعَلَيْهِمْ",3364]]