[["14:50:3",261,"قَطِرَانٍۢ","tar","سَرَابِيلُهُم مِّن","وَتَغْشَىٰ وُجُوهَهُمُ ٱلنَّارُ",4116],["18:96:19",303,"قِطْرًۭا","molten copper","ءَاتُونِىٓ أُفْرِغْ عَلَيْهِ","",2586],["33:14:5",419,"أَقْطَارِهَا","all its sides","دُخِلَتْ عَلَيْهِم مِّنْ","ثُمَّ سُئِلُوا۟ ٱلْفِتْنَةَ",2185],["34:12:10",429,"ٱلْقِطْرِ ۖ","(of) molten copper","وَأَسَلْنَا لَهُۥ عَيْنَ","وَمِنَ ٱلْجِنِّ مَن",2586],["55:33:9",532,"أَقْطَارِ","(the) regions","أَن تَنفُذُوا۟ مِنْ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ",2185]]