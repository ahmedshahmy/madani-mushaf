[["2:228:37",36,"دَرَجَةٌۭ ۗ","(is) a degree","بِٱلْمَعْرُوفِ ۚ وَلِلرِّجَالِ عَلَيْهِنَّ","وَٱللَّهُ عَزِيزٌ حَكِيمٌ",548],["2:253:13",42,"دَرَجَـٰتٍۢ ۚ","(in) degrees","ٱللَّهُ ۖ وَرَفَعَ بَعْضَهُمْ","وَءَاتَيْنَا عِيسَى ٱبْنَ",548],["3:163:2",71,"دَرَجَـٰتٌ","(are in varying) degrees","هُمْ","عِندَ ٱللَّهِ ۗ وَٱللَّهُ",548],["4:95:22",94,"دَرَجَةًۭ ۚ","(in) rank","وَأَنفُسِهِمْ عَلَى ٱلْقَـٰعِدِينَ","وَكُلًّۭا وَعَدَ ٱللَّهُ",548],["4:96:1",94,"دَرَجَـٰتٍۢ","Ranks","","مِّنْهُ وَمَغْفِرَةًۭ وَرَحْمَةًۭ ۚ",548],["6:83:8",138,"دَرَجَـٰتٍۢ","(by) degrees","عَلَىٰ قَوْمِهِۦ ۚ نَرْفَعُ","مَّن نَّشَآءُ ۗ إِنَّ",548],["6:132:2",145,"دَرَجَـٰتٌۭ","(will be) degrees","وَلِكُلٍّۢ","مِّمَّا عَمِلُوا۟ ۚ وَمَا",548],["6:165:10",150,"دَرَجَـٰتٍۢ","(in) ranks","بَعْضَكُمْ فَوْقَ بَعْضٍۢ","لِّيَبْلُوَكُمْ فِى مَآ",548],["7:182:4",174,"سَنَسْتَدْرِجُهُم","We will gradually lead them","وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا","مِّنْ حَيْثُ لَا",2561],["8:4:6",177,"دَرَجَـٰتٌ","(are) ranks","ٱلْمُؤْمِنُونَ حَقًّۭا ۚ لَّهُمْ","عِندَ رَبِّهِمْ وَمَغْفِرَةٌۭ",548],["9:20:11",189,"دَرَجَةً","(in) rank","بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ أَعْظَمُ","عِندَ ٱللَّهِ ۚ وَأُو۟لَـٰٓئِكَ",548],["12:76:26",244,"دَرَجَـٰتٍۢ","(in) degrees","يَشَآءَ ٱللَّهُ ۚ نَرْفَعُ","مَّن نَّشَآءُ ۗ وَفَوْقَ",548],["17:21:9",284,"دَرَجَـٰتٍۢ","(in) degrees","بَعْضٍۢ ۚ وَلَلْـَٔاخِرَةُ أَكْبَرُ","وَأَكْبَرُ تَفْضِيلًۭا",548],["20:75:9",316,"ٱلدَّرَجَـٰتُ","(will be) the ranks","ٱلصَّـٰلِحَـٰتِ فَأُو۟لَـٰٓئِكَ لَهُمُ","ٱلْعُلَىٰ",548],["40:15:2",468,"ٱلدَّرَجَـٰتِ","Possessor of the Highest Ranks","رَفِيعُ","ذُو ٱلْعَرْشِ يُلْقِى",548],["43:32:16",491,"دَرَجَـٰتٍۢ","(in) degrees","بَعْضَهُمْ فَوْقَ بَعْضٍۢ","لِّيَتَّخِذَ بَعْضُهُم بَعْضًۭا",548],["46:19:2",504,"دَرَجَـٰتٌۭ","(are) degrees","وَلِكُلٍّۢ","مِّمَّا عَمِلُوا۟ ۖ وَلِيُوَفِّيَهُمْ",548],["57:10:23",538,"دَرَجَةًۭ","(in) degree","وَقَـٰتَلَ ۚ أُو۟لَـٰٓئِكَ أَعْظَمُ","مِّنَ ٱلَّذِينَ أَنفَقُوا۟",548],["58:11:26",543,"دَرَجَـٰتٍۢ ۚ","(in) degrees","وَٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ","وَٱللَّهُ بِمَا تَعْمَلُونَ",548],["68:44:6",566,"سَنَسْتَدْرِجُهُم","We will progressively lead them","يُكَذِّبُ بِهَـٰذَا ٱلْحَدِيثِ ۖ","مِّنْ حَيْثُ لَا",2561]]