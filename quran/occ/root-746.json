[["15:18:6",263,"شِهَابٌۭ","a burning flame","ٱسْتَرَقَ ٱلسَّمْعَ فَأَتْبَعَهُۥ","مُّبِينٌۭ",1457],["27:7:13",377,"بِشِهَابٍۢ","a torch","بِخَبَرٍ أَوْ ءَاتِيكُم","قَبَسٍۢ لَّعَلَّكُمْ تَصْطَلُونَ",1457],["37:10:6",446,"شِهَابٌۭ","a burning flame","خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ","ثَاقِبٌۭ",1457],["72:8:8",572,"وَشُهُبًۭا","and flaming fires","مُلِئَتْ حَرَسًۭا شَدِيدًۭا","",2891],["72:9:12",572,"شِهَابًۭا","a flaming fire","ٱلْـَٔانَ يَجِدْ لَهُۥ","رَّصَدًۭا",1457]]