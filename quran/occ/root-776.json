[["21:69:4",327,"بَرْدًۭا","cool[ness]","قُلْنَا يَـٰنَارُ كُونِى","وَسَلَـٰمًا عَلَىٰٓ إِبْرَٰهِيمَ",2338],["24:43:25",355,"بَرَدٍۢ","(is) hail","جِبَالٍۢ فِيهَا مِنۢ","فَيُصِيبُ بِهِۦ مَن",3343],["38:42:5",455,"بَارِدٌۭ","cool","بِرِجْلِكَ ۖ هَـٰذَا مُغْتَسَلٌۢ","وَشَرَابٌۭ",2322],["56:44:2",535,"بَارِدٍۢ","cool","لَّا","وَلَا كَرِيمٍ",2322],["78:24:4",582,"بَرْدًۭا","coolness","لَّا يَذُوقُونَ فِيهَا","وَلَا شَرَابًا",2338]]