[["6:152:13",149,"ٱلْكَيْلَ","[the] measure","يَبْلُغَ أَشُدَّهُۥ ۖ وَأَوْفُوا۟","وَٱلْمِيزَانَ بِٱلْقِسْطِ ۖ لَا",840],["7:85:20",161,"ٱلْكَيْلَ","[the] measure","مِّن رَّبِّكُمْ ۖ فَأَوْفُوا۟","وَٱلْمِيزَانَ وَلَا تَبْخَسُوا۟",840],["11:84:16",231,"ٱلْمِكْيَالَ","(from) the measure","غَيْرُهُۥ ۖ وَلَا تَنقُصُوا۟","وَٱلْمِيزَانَ ۚ إِنِّىٓ أَرَىٰكُم",2474],["11:85:3",231,"ٱلْمِكْيَالَ","measure","وَيَـٰقَوْمِ أَوْفُوا۟","وَٱلْمِيزَانَ بِٱلْقِسْطِ ۖ وَلَا",2474],["12:59:14",242,"ٱلْكَيْلَ","[the] measure","تَرَوْنَ أَنِّىٓ أُوفِى","وَأَنَا۠ خَيْرُ ٱلْمُنزِلِينَ",840],["12:60:6",242,"كَيْلَ","measure","تَأْتُونِى بِهِۦ فَلَا","لَكُمْ عِندِى وَلَا",840],["12:63:9",242,"ٱلْكَيْلُ","the measure","يَـٰٓأَبَانَا مُنِعَ مِنَّا","فَأَرْسِلْ مَعَنَآ أَخَانَا",840],["12:63:13",242,"نَكْتَلْ","(that) we will get measure","فَأَرْسِلْ مَعَنَآ أَخَانَا","وَإِنَّا لَهُۥ لَحَـٰفِظُونَ",2836],["12:65:21",243,"كَيْلَ","measure","وَنَحْفَظُ أَخَانَا وَنَزْدَادُ","بَعِيرٍۢ ۖ ذَٰلِكَ كَيْلٌۭ",840],["12:65:24",243,"كَيْلٌۭ","(is) a measurement","كَيْلَ بَعِيرٍۢ ۖ ذَٰلِكَ","يَسِيرٌۭ",840],["12:88:15",246,"ٱلْكَيْلَ","the measure","مُّزْجَىٰةٍۢ فَأَوْفِ لَنَا","وَتَصَدَّقْ عَلَيْنَآ ۖ إِنَّ",840],["17:35:2",285,"ٱلْكَيْلَ","[the] measure","وَأَوْفُوا۟","إِذَا كِلْتُمْ وَزِنُوا۟",840],["17:35:4",285,"كِلْتُمْ","you measure","وَأَوْفُوا۟ ٱلْكَيْلَ إِذَا","وَزِنُوا۟ بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ ۚ",2412],["26:181:2",374,"ٱلْكَيْلَ","measure","۞ أَوْفُوا۟","وَلَا تَكُونُوا۟ مِنَ",840],["83:2:3",587,"ٱكْتَالُوا۟","they take a measure","ٱلَّذِينَ إِذَا","عَلَى ٱلنَّاسِ يَسْتَوْفُونَ",2836],["83:3:2",587,"كَالُوهُمْ","they give by measure (to) them","وَإِذَا","أَو وَّزَنُوهُمْ يُخْسِرُونَ",2412]]