[["4:128:20",99,"ٱلشُّحَّ ۚ","(by) greed","خَيْرٌۭ ۗ وَأُحْضِرَتِ ٱلْأَنفُسُ","وَإِن تُحْسِنُوا۟ وَتَتَّقُوا۟",1266],["33:19:1",420,"أَشِحَّةً","Miserly","","عَلَيْكُمْ ۖ فَإِذَا جَآءَ",1266],["33:19:22",420,"أَشِحَّةً","miserly","سَلَقُوكُم بِأَلْسِنَةٍ حِدَادٍ","عَلَى ٱلْخَيْرِ ۚ أُو۟لَـٰٓئِكَ",1266],["59:9:27",546,"شُحَّ","(from) stinginess","خَصَاصَةٌۭ ۚ وَمَن يُوقَ","نَفْسِهِۦ فَأُو۟لَـٰٓئِكَ هُمُ",1266],["64:16:12",557,"شُحَّ","(from the) greediness","لِّأَنفُسِكُمْ ۗ وَمَن يُوقَ","نَفْسِهِۦ فَأُو۟لَـٰٓئِكَ هُمُ",1266]]