َـٰهُنَا وَإِلَـٰهُكُمْ","وَنَحْنُ لَهُۥ مُسْلِمُونَ",368],["31:28:7",413,"وَٰحِدَةٍ ۗ","single","بَعْثُكُمْ إِلَّا كَنَفْسٍۢ","إِنَّ ٱللَّهَ سَمِيعٌۢ",359],["34:46:4",433,"بِوَٰحِدَةٍ ۖ","for one (thing)","۞ قُلْ إِنَّمَآ أَعِظُكُم","أَن تَقُومُوا۟ لِلَّهِ",359],["36:29:5",442,"وَٰحِدَةًۭ","one","كَانَتْ إِلَّا صَيْحَةًۭ","فَإِذَا هُمْ خَـٰمِدُونَ",359],["36:49:5",443,"وَٰحِدَةًۭ","one","يَنظُرُونَ إِلَّا صَيْحَةًۭ","تَأْخُذُهُمْ وَهُمْ يَخِصِّمُونَ",359],["36:53:5",443,"وَٰحِدَةًۭ","single","كَانَتْ إِلَّا صَيْحَةًۭ","فَإِذَا هُمْ جَمِيعٌۭ",359],["37:4:3",446,"لَوَٰحِدٌۭ","(is) surely One","إِنَّ إِلَـٰهَكُمْ","",368],["37:19:4",446,"وَٰحِدَةٌۭ","single","فَإِنَّمَا هِىَ زَجْرَةٌۭ","فَإِذَا هُمْ يَنظُرُونَ",359],["38:5:4",453,"وَٰحِدًا ۖ","(into) one god","أَجَعَلَ ٱلْـَٔالِهَةَ إِلَـٰهًۭا","إِنَّ هَـٰذَا لَشَىْءٌ",368],["38:15:6",453,"وَٰحِدَةًۭ","one","هَـٰٓؤُلَآءِ إِلَّا صَيْحَةًۭ","مَّا لَهَا مِن",359],["38:23:10",454,"وَٰحِدَةٌۭ","one","نَعْجَةًۭ وَلِىَ نَعْجَةٌۭ","فَقَالَ أَكْفِلْنِيهَا وَعَزَّنِى",359],["38:65:10",457,"ٱلْوَٰحِدُ","the One","إِلَـٰهٍ إِلَّا ٱللَّهُ","ٱلْقَهَّارُ",368],["39:4:15",458,"ٱلْوَٰحِدُ","the One","سُبْحَـٰنَهُۥ ۖ هُوَ ٱللَّهُ","ٱلْقَهَّارُ",368],["39:6:4",459,"وَٰحِدَةٍۢ","single","خَلَقَكُم مِّن نَّفْسٍۢ","ثُمَّ جَعَلَ مِنْهَا",359],["39:45:4",463,"وَحْدَهُ","Alone","وَإِذَا ذُكِرَ ٱللَّهُ","ٱشْمَأَزَّتْ قُلُوبُ ٱلَّذِينَ",1243],["40:12:6",468,"وَحْدَهُۥ","Alone","إِذَا دُعِىَ ٱللَّهُ","كَفَرْتُمْ ۖ وَإِن يُشْرَكْ",1243],["40:16:14",468,"ٱلْوَٰحِدِ","the One","ٱلْمُلْكُ ٱلْيَوْمَ ۖ لِلَّهِ","ٱلْقَهَّارِ",368],["40:84:7",476,"وَحْدَهُۥ","Alone","قَالُوٓا۟ ءَامَنَّا بِٱللَّهِ","وَكَفَرْنَا بِمَا كُنَّا",1243],["41:6:11",477,"وَٰحِدٌۭ","One","أَنَّمَآ إِلَـٰهُكُمْ إِلَـٰهٌۭ","فَٱسْتَقِيمُوٓا۟ إِلَيْهِ وَٱسْتَغْفِرُوهُ ۗ",368],["42:8:6",483,"وَٰحِدَةًۭ","one","ٱللَّهُ لَجَعَلَهُمْ أُمَّةًۭ","وَلَـٰكِن يُدْخِلُ مَن",359],["43:33:6",491,"وَٰحِدَةًۭ","one","يَكُونَ ٱلنَّاسُ أُمَّةًۭ","لَّجَعَلْنَا لِمَن يَكْفُرُ",359],["54:24:4",529,"وَٰحِدًۭا","one","فَقَالُوٓا۟ أَبَشَرًۭا مِّنَّا","نَّتَّبِعُهُۥٓ إِنَّآ إِذًۭا",368],["54:31:5",530,"وَٰحِدَةًۭ","single","أَرْسَلْنَا عَلَيْهِمْ صَيْحَةًۭ","فَكَانُوا۟ كَهَشِيمِ ٱلْمُحْتَظِرِ",359],["54:50:4",531,"وَٰحِدَةٌۭ","one","وَمَآ أَمْرُنَآ إِلَّا","كَلَمْحٍۭ بِٱلْبَصَرِ",359],["60:4:32",549,"وَحْدَهُۥٓ","Alone","حَتَّىٰ تُؤْمِنُوا۟ بِٱللَّهِ","إِلَّا قَوْلَ إِبْرَٰهِيمَ",1243],["69:13:6",567,"وَٰحِدَةٌۭ","single","فِى ٱلصُّورِ نَفْخَةٌۭ","",359],["69:14:6",567,"وَٰحِدَةًۭ","single","وَٱلْجِبَالُ فَدُكَّتَا دَكَّةًۭ","",359],["74:11:4",575,"وَحِيدًۭا","alone","ذَرْنِى وَمَنْ خَلَقْتُ","",4511],["79:13:4",583,"وَٰحِدَةٌۭ","single","فَإِنَّمَا هِىَ زَجْرَةٌۭ","",359]]