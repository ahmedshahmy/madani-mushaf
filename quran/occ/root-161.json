[["2:61:8",9,"وَٰحِدٍۢ","(of) one (kind)","نَّصْبِرَ عَلَىٰ طَعَامٍۢ","فَٱدْعُ لَنَا رَبَّكَ",368],["2:133:24",20,"وَٰحِدًۭا","One","وَإِسْمَـٰعِيلَ وَإِسْحَـٰقَ إِلَـٰهًۭا","وَنَحْنُ لَهُۥ مُسْلِمُونَ",368],["2:163:3",24,"وَٰحِدٌۭ ۖ","one (only)","وَإِلَـٰهُكُمْ إِلَـٰهٌۭ","لَّآ إِلَـٰهَ إِلَّا",368],["2:213:4",33,"وَٰحِدَةًۭ","single","كَانَ ٱلنَّاسُ أُمَّةًۭ","فَبَعَثَ ٱللَّهُ ٱلنَّبِيِّـۧنَ",359],["4:1:9",77,"وَٰحِدَةٍۢ","single","خَلَقَكُم مِّن نَّفْسٍۢ","وَخَلَقَ مِنْهَا زَوْجَهَا",359],["4:3:20",77,"فَوَٰحِدَةً","then (marry) one","خِفْتُمْ أَلَّا تَعْدِلُوا۟","أَوْ مَا مَلَكَتْ",359],["4:11:20",78,"وَٰحِدَةًۭ","(only) one","تَرَكَ ۖ وَإِن كَانَتْ","فَلَهَا ٱلنِّصْفُ ۚ وَلِأَبَوَيْهِ",359],["4:11:25",78,"وَٰحِدٍۢ","one","ٱلنِّصْفُ ۚ وَلِأَبَوَيْهِ لِكُلِّ","مِّنْهُمَا ٱلسُّدُسُ مِمَّا",368],["4:12:62",79,"وَٰحِدٍۢ","one","أَوْ أُخْتٌۭ فَلِكُلِّ","مِّنْهُمَا ٱلسُّدُسُ ۚ فَإِن",368],["4:102:39",95,"وَٰحِدَةًۭ ۚ","single","فَيَمِيلُونَ عَلَيْكُم مَّيْلَةًۭ","وَلَا جُنَاحَ عَلَيْكُمْ",359],["4:171:38",105,"وَٰحِدٌۭ ۖ","One","إِنَّمَا ٱللَّهُ إِلَـٰهٌۭ","سُبْحَـٰنَهُۥٓ أَن يَكُونَ",368],["5:48:35",116,"وَٰحِدَةًۭ","one","ٱللَّهُ لَجَعَلَكُمْ أُمَّةًۭ","وَلَـٰكِن لِّيَبْلُوَكُمْ فِى",359],["5:73:14",120,"وَٰحِدٌۭ ۚ","(the) One","إِلَـٰهٍ إِلَّآ إِلَـٰهٌۭ","وَإِن لَّمْ يَنتَهُوا۟",368],["6:19:33",130,"وَٰحِدٌۭ","One","إِنَّمَا هُوَ إِلَـٰهٌۭ","وَإِنَّنِى بَرِىٓءٌۭ مِّمَّا",368],["6:98:6",140,"وَٰحِدَةٍۢ","single","أَنشَأَكُم مِّن نَّفْسٍۢ","فَمُسْتَقَرٌّۭ وَمُسْتَوْدَعٌۭ ۗ قَدْ",359],["7:70:5",159,"وَحْدَهُۥ","Alone","أَجِئْتَنَا لِنَعْبُدَ ٱللَّهَ","وَنَذَرَ مَا كَانَ",1243],["7:189:6",175,"وَٰحِدَةٍۢ","single","خَلَقَكُم مِّن نَّفْسٍۢ","وَجَعَلَ مِنْهَا زَوْجَهَا",359],["9:31:16",191,"وَٰحِدًۭا ۖ","One God","إِلَّا لِيَعْبُدُوٓا۟ إِلَـٰهًۭا","لَّآ إِلَـٰهَ إِلَّا",368],["10:19:6",210,"وَٰحِدَةًۭ","one","ٱلنَّاسُ إِلَّآ أُمَّةًۭ","فَٱخْتَلَفُوا۟ ۚ وَلَوْلَا كَلِمَةٌۭ",359],["11:118:7",235,"وَٰحِدَةًۭ ۖ","one community","لَجَعَلَ ٱلنَّاسَ أُمَّةًۭ","وَلَا يَزَال