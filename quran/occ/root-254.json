[["2:148:5",23,"فَٱسْتَبِقُوا۟","so race","وِجْهَةٌ هُوَ مُوَلِّيهَا ۖ","ٱلْخَيْرَٰتِ ۚ أَيْنَ مَا",1447],["5:48:41",116,"فَٱسْتَبِقُوا۟","so race","فِى مَآ ءَاتَىٰكُمْ ۖ","ٱلْخَيْرَٰتِ ۚ إِلَى ٱللَّهِ",1447],["7:80:8",160,"سَبَقَكُم","has preceded you","أَتَأْتُونَ ٱلْفَـٰحِشَةَ مَا","بِهَا مِنْ أَحَدٍۢ",519],["8:59:5",184,"سَبَقُوٓا۟ ۚ","they can outstrip","يَحْسَبَنَّ ٱلَّذِينَ كَفَرُوا۟","إِنَّهُمْ لَا يُعْجِزُونَ",519],["8:68:5",185,"سَبَقَ","preceded","كِتَـٰبٌۭ مِّنَ ٱللَّهِ","لَمَسَّكُمْ فِيمَآ أَخَذْتُمْ",519],["9:100:1",203,"وَٱلسَّـٰبِقُونَ","And the forerunners","","ٱلْأَوَّلُونَ مِنَ ٱلْمُهَـٰجِرِينَ",1100],["10:19:10",210,"سَبَقَتْ","(that) preceded","فَٱخْتَلَفُوا۟ ۚ وَلَوْلَا كَلِمَةٌۭ","مِن رَّبِّكَ لَقُضِىَ",519],["11:40:17",226,"سَبَقَ","has preceded","وَأَهْلَكَ إِلَّا مَن","عَلَيْهِ ٱلْقَوْلُ وَمَنْ",519],["11:110:9",234,"سَبَقَتْ","(that) preceded","فِيهِ ۚ وَلَوْلَا كَلِمَةٌۭ","مِن رَّبِّكَ لَقُضِىَ",519],["12:17:5",237,"نَسْتَبِقُ","racing each other","يَـٰٓأَبَانَآ إِنَّا ذَهَبْنَا","وَتَرَكْنَا يُوسُفَ عِندَ",1447],["12:25:1",238,"وَٱسْتَبَقَا","And they both raced","","ٱلْبَابَ وَقَدَّتْ قَمِيصَهُۥ",1447],["15:5:2",262,"تَسْبِقُ","(can) advance","مَّا","مِنْ أُمَّةٍ أَجَلَهَا",519],["20:99:8",319,"سَبَقَ ۚ","has preceded","أَنۢبَآءِ مَا قَدْ","وَقَدْ ءَاتَيْنَـٰكَ مِن",519],["20:129:3",321,"سَبَقَتْ","(that) preceded","وَلَوْلَا كَلِمَةٌۭ","مِن رَّبِّكَ لَكَانَ",519],["21:27:2",324,"يَسْبِقُونَهُۥ","they (can) precede Him","لَا","بِٱلْقَوْلِ وَهُم بِأَمْرِهِۦ",519],["21:101:3",330,"سَبَقَتْ","has gone forth","إِنَّ ٱلَّذِينَ","لَهُم مِّنَّا ٱلْحُسْنَىٰٓ",519],["23:27:22",343,"سَبَقَ","(has) preceded","وَأَهْلَكَ إِلَّا مَن","عَلَيْهِ ٱلْقَوْلُ مِنْهُمْ ۖ",519],["23:43:2",345,"تَسْبِقُ","can precede","مَا","مِنْ أُمَّةٍ أَجَلَهَا",519],["23:61:7",346,"سَـٰبِقُونَ","(are) foremost","ٱلْخَيْرَٰتِ وَهُمْ لَهَا","",1100],["29:4:7",396,"يَسْبِقُونَا ۚ","they can outrun Us","يَعْمَلُونَ ٱلسَّيِّـَٔاتِ أَن","سَآءَ مَا يَحْكُمُونَ",519],["29:28:9",399,"سَبَقَكُم","has preceded you","لَتَأْتُونَ ٱلْفَـٰحِشَةَ مَا","بِهَا مِنْ أَحَدٍۢ",519],["29:39:13",401,"سَـٰبِقِينَ","outstrip Us","ٱلْأَرْضِ وَمَا كَانُوا۟","",1100],["35:32:14",438,"سَابِقٌۢ","(is he who is) foremost","وَمِنْهُم مُّقْتَصِدٌۭ وَمِنْهُمْ","بِٱلْخَيْرَٰتِ بِإِذْنِ ٱللَّهِ ۚ",1100],["36:40:10",442,"سَابِقُ","(can) outstrip","ٱلْقَمَرَ وَلَا ٱلَّيْلُ","ٱلنَّهَارِ ۚ وَكُلٌّۭ فِى",1100],["36:66:6",444,"فَٱسْتَبَقُوا۟","then they (would) race","لَطَمَسْنَا عَلَىٰٓ أَعْيُنِهِمْ","ٱلصِّرَٰطَ فَأَنَّىٰ يُبْصِرُونَ",1447],["37:171:2",452,"سَبَقَتْ","has preceded","وَلَقَدْ","كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ",519],["41:45:9",481,"سَبَقَتْ","(that) preceded","فِيهِ ۗ وَلَوْلَا كَلِمَةٌۭ","مِن رَّبِّكَ لَقُضِىَ",519],["42:14:13",484,"سَبَقَتْ","(that) preceded","بَيْنَهُمْ ۚ وَلَوْلَا كَلِمَةٌۭ","مِن رَّبِّكَ إِلَىٰٓ",519],["46:11:10",503,"سَبَقُونَآ","they (would) have preceded us","كَانَ خَيْرًۭا مَّا","إِلَيْهِ ۚ وَإِذْ لَمْ",519],["56:10:1",534,"وَٱلسَّـٰبِقُونَ","And the foremost","","ٱلسَّـٰبِقُونَ",1100],["56:10:2",534,"ٱلسَّـٰبِقُونَ","(are) the foremost","وَٱلسَّـٰبِقُونَ","",1100],["56:60:7",536,"بِمَسْبُوقِينَ","(are) outrun","ٱلْمَوْتَ وَمَا نَحْنُ","",2464],["57:21:1",540,"سَابِقُوٓا۟","Race","","إِلَىٰ مَغْفِرَةٍۢ مِّن",4230],["59:10:11",547,"سَبَقُونَا","preceded us","لَنَا وَلِإِخْوَٰنِنَا ٱلَّذِينَ","بِٱلْإِيمَـٰنِ وَلَا تَجْعَلْ",519],["70:41:8",570,"بِمَسْبُوقِينَ","(are) to be outrun","مِّنْهُمْ وَمَا نَحْنُ","",2464],["79:4:1",583,"فَٱلسَّـٰبِقَـٰتِ","And those who race each other","","سَبْقًۭا",4294],["79:4:2",583,"سَبْقًۭا","(in) a race","فَٱلسَّـٰبِقَـٰتِ","",4245]]