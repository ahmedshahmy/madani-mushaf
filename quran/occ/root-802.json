[["2:259:53",43,"نُنشِزُهَا","We raise them","إِلَى ٱلْعِظَامِ كَيْفَ","ثُمَّ نَكْسُوهَا لَحْمًۭا ۚ",4066],["4:34:24",84,"نُشُوزَهُنَّ","their ill-conduct","ٱللَّهُ ۚ وَٱلَّـٰتِى تَخَافُونَ","فَعِظُوهُنَّ وَٱهْجُرُوهُنَّ فِى",2564],["4:128:6",99,"نُشُوزًا","ill-conduct","خَافَتْ مِنۢ بَعْلِهَا","أَوْ إِعْرَاضًۭا فَلَا",2564],["58:11:16",543,"ٱنشُزُوا۟","Rise up","لَكُمْ ۖ وَإِذَا قِيلَ","فَٱنشُزُوا۟ يَرْفَعِ ٱللَّهُ",2840],["58:11:17",543,"فَٱنشُزُوا۟","then rise up","وَإِذَا قِيلَ ٱنشُزُوا۟","يَرْفَعِ ٱللَّهُ ٱلَّذِينَ",2840]]