[["2:3:7",2,"رَزَقْنَـٰهُمْ","We have provided them","وَيُقِيمُونَ ٱلصَّلَوٰةَ وَمِمَّا","يُنفِقُونَ",198],["2:22:16",4,"رِزْقًۭا","(as) provision","بِهِۦ مِنَ ٱلثَّمَرَٰتِ","لَّكُمْ ۖ فَلَا تَجْعَلُوا۟",219],["2:25:14",5,"رُزِقُوا۟","they are provided","تَحْتِهَا ٱلْأَنْهَـٰرُ ۖ كُلَّمَا","مِنْهَا مِن ثَمَرَةٍۢ",198],["2:25:18",5,"رِّزْقًۭا ۙ","(as) provision","مِنْهَا مِن ثَمَرَةٍۢ","قَالُوا۟ هَـٰذَا ٱلَّذِى",219],["2:25:22",5,"رُزِقْنَا","we were provided","قَالُوا۟ هَـٰذَا ٱلَّذِى","مِن قَبْلُ ۖ وَأُتُوا۟",198],["2:57:12",8,"رَزَقْنَـٰكُمْ ۖ","We have provided you","مِن طَيِّبَـٰتِ مَا","وَمَا ظَلَمُونَا وَلَـٰكِن",198],["2:60:22",9,"رِّزْقِ","(the) provision (of)","كُلُوا۟ وَٱشْرَبُوا۟ مِن","ٱللَّهِ وَلَا تَعْثَوْا۟",219],["2:126:9",19,"وَٱرْزُقْ","and provide","هَـٰذَا بَلَدًا ءَامِنًۭا","أَهْلَهُۥ مِنَ ٱلثَّمَرَٰتِ",198],["2:172:8",26,"رَزَقْنَـٰكُمْ","We have provided you","مِن طَيِّبَـٰتِ مَا","وَٱشْكُرُوا۟ لِلَّهِ إِن",198],["2:212:16",33,"يَرْزُقُ","provides","يَوْمَ ٱلْقِيَـٰمَةِ ۗ وَٱللَّهُ","مَن يَشَآءُ بِغَيْرِ",198],["2:233:14",37,"رِزْقُهُنَّ","(is) their provision","وَعَلَى ٱلْمَوْلُودِ لَهُۥ","وَكِسْوَتُهُنَّ بِٱلْمَعْرُوفِ ۚ لَا",219],["2:254:6",42,"رَزَقْنَـٰكُم","We (have) provided you","ءَامَنُوٓا۟ أَنفِقُوا۟ مِمَّا","مِّن قَبْلِ أَن",198],["3:27:17",53,"وَتَرْزُقُ","and You give provision","ٱلْمَيِّتَ مِنَ ٱلْحَىِّ ۖ","مَن تَشَآءُ بِغَيْرِ",198],["3:37:17",54,"رِزْقًۭا ۖ","provision","ٱلْمِحْرَابَ وَجَدَ عِندَهَا","قَالَ يَـٰمَرْيَمُ أَنَّىٰ",219],["3:37:30",54,"يَرْزُقُ","gives provision","ٱللَّهِ ۖ إِنَّ ٱللَّهَ","مَن يَشَآءُ بِغَيْرِ",198],["3:169:13",72,"يُرْزَقُونَ","they are given provision","أَحْيَآءٌ عِندَ رَبِّهِمْ","",198],["4:5:10",77,"وَٱرْزُقُوهُمْ","(but) provide (for) them","ٱللَّهُ لَكُمْ قِيَـٰمًۭا","فِيهَا وَٱكْسُوهُمْ وَقُولُوا۟",198],["4:8:8",78,"فَٱرْزُقُوهُم","then provide them","ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينُ","مِّنْهُ وَقُولُوا۟ لَهُمْ",198],["4:39:10",85,"رَزَقَهُمُ","(has) provided them","ٱلْـَٔاخِرِ وَأَنفَقُوا۟ مِمَّا","ٱللَّهُ ۚ وَكَانَ ٱللَّهُ",198],["5:88:3",122,"رَزَقَكُمُ","has provided you","وَكُلُوا۟ مِمَّا","ٱللَّهُ حَلَـٰلًۭا طَيِّبًۭا ۚ",198],["5:114:19",127,"وَٱرْزُقْنَا","And provide us","وَءَاخِرِنَا وَءَايَةًۭ مِّنكَ ۖ","وَأَنتَ خَيْرُ ٱلرَّٰزِقِينَ",198],["5:114:22",127,"ٱلرَّٰزِقِينَ","(of) the providers","وَٱرْزُقْنَا وَأَنتَ خَيْرُ","",1226],["6:140:11",146,"رَزَقَهُمُ","(bas been) provided (to) them","عِلْمٍۢ وَحَرَّمُوا۟ مَا","ٱللَّهُ ٱفْتِرَآءً عَلَى",198],["6:142:7",146,"رَزَقَكُمُ","(has been) provided (to) you","وَفَرْشًۭا ۚ كُلُوا۟ مِمَّا","ٱللَّهُ وَلَا تَتَّبِعُوا۟",198],["6:151:20",148,"نَرْزُقُكُمْ","provide for you","مِّنْ إِمْلَـٰقٍۢ ۖ نَّحْنُ","وَإِيَّاهُمْ ۖ وَلَا تَقْرَبُوا۟",198],["7:32:11",154,"ٱلرِّزْقِ ۚ","sustenance","لِعِبَادِهِۦ وَٱلطَّيِّبَـٰتِ مِنَ","قُلْ هِىَ لِلَّذِينَ",219],["7:50:13",156,"رَزَقَكُمُ","(has been) provided (to) you","ٱلْمَآءِ أَوْ مِمَّا","ٱللَّهُ ۚ قَالُوٓا۟ إِنَّ",198],["7:160:37",171,"رَزَقْنَـٰكُمْ ۚ","We have provided you","مِن طَيِّبَـٰتِ مَا","وَمَا ظَلَمُونَا وَلَـٰكِن",198],["8:3:5",177,"رَزَقْنَـٰهُمْ","We have provided them","يُقِيمُونَ ٱلصَّلَوٰةَ وَمِمَّا","يُنفِقُونَ",198],["8:4:10",177,"وَرِزْقٌۭ","and a provision","عِندَ رَبِّهِمْ وَمَغْفِرَةٌۭ","كَرِيمٌۭ",219],["8:26:15",180,"وَرَزَقَكُم","and provided you","فَـَٔاوَىٰكُمْ وَأَيَّدَكُم بِنَصْرِهِۦ","مِّنَ ٱلطَّيِّبَـٰتِ لَعَلَّكُمْ",198],["8:74:17",186,"وَرِزْقٌۭ","and a provision","حَقًّۭا ۚ لَّهُم مَّغْفِرَةٌۭ","كَرِيمٌۭ",219],["10:31:3",212,"يَرْزُقُكُم","provides for you","قُلْ مَن","مِّنَ ٱلسَّمَآءِ وَٱلْأَرْضِ",198],["10:59:8",215,"رِّزْقٍۢ","(the) provision","ٱللَّهُ لَكُم مِّن","فَجَعَلْتُم مِّنْهُ حَرَامًۭا",219],["10:93:7",219,"وَرَزَقْنَـٰهُم","and We provided them","إِسْرَٰٓءِيلَ مُبَوَّأَ صِدْقٍۢ","مِّنَ ٱلطَّيِّبَـٰتِ فَمَا",198],["11:6:9",222,"رِزْقُهَا","(is) its provision","إِلَّا عَلَى ٱللَّهِ","وَيَعْلَمُ مُسْتَقَرَّهَا وَمُسْتَوْدَعَهَا ۚ",219],["11:88:10",231,"وَرَزَقَنِى","and He has provided me","بَيِّنَةٍۢ مِّن رَّبِّى","مِنْهُ رِزْقًا حَسَنًۭا ۚ",198],["11:88:12",231,"رِزْقًا","a good provision","رَّبِّى وَرَزَقَنِى مِنْهُ","حَسَنًۭا ۚ وَمَآ أُرِيدُ",219],["12:37:5",239,"تُرْزَقَانِهِۦٓ","you are provided with","لَا يَأْتِيكُمَا طَعَامٌۭ","إِلَّا نَبَّأْتُكُمَا بِتَأْوِيلِهِۦ",198],["13:22:10",252,"رَزَقْنَـٰهُمْ","We have provided them","ٱلصَّلَوٰةَ وَأَنفَقُوا۟ مِمَّا","سِرًّۭا وَعَلَانِيَةًۭ وَيَدْرَءُونَ",198],["13:26:3",252,"ٱلرِّزْقَ","the provision","ٱللَّهُ يَبْسُطُ","لِمَن يَشَآءُ وَيَقْدِرُ ۚ",219],["14:31:9",259,"رَزَقْنَـٰهُمْ","We have provided them","ٱلصَّلَوٰةَ وَيُنفِقُوا۟ مِمَّا","سِرًّۭا وَعَلَانِيَةًۭ مِّن",198],["14:32:14",259,"رِزْقًۭا","(as) a provision","بِهِۦ مِنَ ٱلثَّمَرَٰتِ","لَّكُمْ ۖ وَسَخَّرَ لَكُمُ",219],["14:37:22",260,"وَٱرْزُقْهُم","and provide them","ٱلنَّاسِ تَهْوِىٓ إِلَيْهِمْ","مِّنَ ٱلثَّمَرَٰتِ لَعَلَّهُمْ",198],["15:20:8",263,"بِرَٰزِقِينَ","providers","وَمَن لَّسْتُمْ لَهُۥ","",1226],["16:56:7",273,"رَزَقْنَـٰهُمْ ۗ","We have provided them","يَعْلَمُونَ نَصِيبًۭا مِّمَّا","تَٱللَّهِ لَتُسْـَٔلُنَّ عَمَّا",198],["16:67:8",274,"وَرِزْقًا","and a provision","تَتَّخِذُونَ مِنْهُ سَكَرًۭا","حَسَنًا ۗ إِنَّ فِى",219],["16:71:7",274,"ٱلرِّزْقِ ۚ","[the] provision","عَلَىٰ بَعْضٍۢ فِى","فَمَا ٱلَّذِينَ فُضِّلُوا۟",219],["16:71:12",274,"رِزْقِهِمْ","their provision","ٱلَّذِينَ فُضِّلُوا۟ بِرَآدِّى","عَلَىٰ مَا مَلَكَتْ",219],["16:72:13",274,"وَرَزَقَكُم","and has provided for you","أَزْوَٰجِكُم بَنِينَ وَحَفَدَةًۭ","مِّنَ ٱلطَّيِّبَـٰتِ ۚ أَفَبِٱلْبَـٰطِلِ",198],["16:73:9",275,"رِزْقًۭا","any provision","لَا يَمْلِكُ لَهُمْ","مِّنَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ",219],["16:75:11",275,"رَّزَقْنَـٰهُ","We provided him","عَلَىٰ شَىْءٍۢ وَمَن","مِنَّا رِزْقًا حَسَنًۭا",198],["16:75:13",275,"رِزْقًا","a provision","وَمَن رَّزَقْنَـٰهُ مِنَّا","حَسَنًۭا فَهُوَ يُنفِقُ",219],["16:112:9",280,"رِزْقُهَا","its provision","ءَامِنَةًۭ مُّطْمَئِنَّةًۭ يَأْتِيهَا","رَغَدًۭا مِّن كُلِّ",219],["16:114:3",280,"رَزَقَكُمُ","Allah has provided you","فَكُلُوا۟ مِمَّا","ٱللَّهُ حَلَـٰلًۭا طَيِّبًۭا",198],["17:30:4",285,"ٱلرِّزْقَ","the provision","إِنَّ رَبَّكَ يَبْسُطُ","لِمَن يَشَآءُ وَيَقْدِرُ ۚ",219],["17:31:7",285,"نَرْزُقُهُمْ","(We) provide for them","خَشْيَةَ إِمْلَـٰقٍۢ ۖ نَّحْنُ","وَإِيَّاكُمْ ۚ إِنَّ قَتْلَهُمْ",198],["17:70:9",289,"وَرَزَقْنَـٰهُم","and We have provided them","فِى ٱلْبَرِّ وَٱلْبَحْرِ","مِّنَ ٱلطَّيِّبَـٰتِ وَفَضَّلْنَـٰهُمْ",198],["18:19:32",295,"بِرِزْقٍۢ","provision","أَزْكَىٰ طَعَامًۭا فَلْيَأْتِكُم","مِّنْهُ وَلْيَتَلَطَّفْ وَلَا",219],["19:62:8",309,"رِزْقُهُمْ","(is) their provision","إِلَّا سَلَـٰمًۭا ۖ وَلَهُمْ","فِيهَا بُكْرَةًۭ وَعَشِيًّۭا",219],["20:81:5",317,"رَزَقْنَـٰكُمْ","We have provided you","مِن طَيِّبَـٰتِ مَا","وَلَا تَطْغَوْا۟ فِيهِ",198],["20:131:15",321,"وَرِزْقُ","And (the) provision","ٱلدُّنْيَا لِنَفْتِنَهُمْ فِيهِ ۚ","رَبِّكَ خَيْرٌۭ وَأَبْقَىٰ",219],["20:132:8",321,"رِزْقًۭا ۖ","(for) provision","عَلَيْهَا ۖ لَا نَسْـَٔلُكَ","نَّحْنُ نَرْزُقُكَ ۗ وَٱلْعَـٰقِبَةُ",219],["20:132:10",321,"نَرْزُقُكَ ۗ","provide (for) you","نَسْـَٔلُكَ رِزْقًۭا ۖ نَّحْنُ","وَٱلْعَـٰقِبَةُ لِلتَّقْوَىٰ",198],["22:28:12",335,"رَزَقَهُم","He has provided them","مَّعْلُومَـٰتٍ عَلَىٰ مَا","مِّنۢ بَهِيمَةِ ٱلْأَنْعَـٰمِ ۖ",198],["22:34:10",336,"رَزَقَهُم","He (has) provided them","ٱللَّهِ عَلَىٰ مَا","مِّنۢ بَهِيمَةِ ٱلْأَنْعَـٰمِ ۗ",198],["22:35:14",336,"رَزَقْنَـٰهُمْ","We have provided them","وَٱلْمُقِيمِى ٱلصَّلَوٰةِ وَمِمَّا","يُنفِقُونَ",198],["22:50:7",338,"وَرِزْقٌۭ","and a provision","ٱلصَّـٰلِحَـٰتِ لَهُم مَّغْفِرَةٌۭ","كَرِيمٌۭ",219],["22:58:10",339,"لَيَرْزُقَنَّهُمُ","surely, Allah will provide them","قُتِلُوٓا۟ أَوْ مَاتُوا۟","ٱللَّهُ رِزْقًا حَسَنًۭا ۚ",198],["22:58:12",339,"رِزْقًا","a provision","مَاتُوا۟ لَيَرْزُقَنَّهُمُ ٱللَّهُ","حَسَنًۭا ۚ وَإِنَّ ٱللَّهَ",219],["22:58:18",339,"ٱلرَّٰزِقِينَ","(of) the Providers","ٱللَّهَ لَهُوَ خَيْرُ","",1226],["23:72:9",346,"ٱلرَّٰزِقِينَ","(of) the Providers","خَيْرٌۭ ۖ وَهُوَ خَيْرُ","",1226],["24:26:15",352,"وَرِزْقٌۭ","and a provision","يَقُولُونَ ۖ لَهُم مَّغْفِرَةٌۭ","كَرِيمٌۭ",219],["24:38:10",355,"يَرْزُقُ","provides","مِّن فَضْلِهِۦ ۗ وَٱللَّهُ","مَن يَشَآءُ بِغَيْرِ",198],["27:64:7",383,"يَرْزُقُكُم","provides you","ثُمَّ يُعِيدُهُۥ وَمَن","مِّنَ ٱلسَّمَآءِ وَٱلْأَرْضِ ۗ",198],["28:54:11",392,"رَزَقْنَـٰهُمْ","We have provided them","بِٱلْحَسَنَةِ ٱلسَّيِّئَةَ وَمِمَّا","يُنفِقُونَ",198],["28:57:19",392,"رِّزْقًۭا","a provision","ثَمَرَٰتُ كُلِّ شَىْءٍۢ","مِّن لَّدُنَّا وَلَـٰكِنَّ",219],["28:82:10",395,"ٱلرِّزْقَ","the provision","وَيْكَأَنَّ ٱللَّهَ يَبْسُطُ","لِمَن يَشَآءُ مِنْ",219],["29:17:18",398,"رِزْقًۭا","any provision","لَا يَمْلِكُونَ لَكُمْ","فَٱبْتَغُوا۟ عِندَ ٱللَّهِ",219],["29:17:22",398,"ٱلرِّزْقَ","the provision","فَٱبْتَغُوا۟ عِندَ ٱللَّهِ","وَٱعْبُدُوهُ وَٱشْكُرُوا۟ لَهُۥٓ ۖ",219],["29:60:6",403,"رِزْقَهَا","its provision","دَآبَّةٍۢ لَّا تَحْمِلُ","ٱللَّهُ يَرْزُقُهَا وَإِيَّاكُمْ ۚ",219],["29:60:8",403,"يَرْزُقُهَا","provides (for) it","تَحْمِلُ رِزْقَهَا ٱللَّهُ","وَإِيَّاكُمْ ۚ وَهُوَ ٱلسَّمِيعُ",198],["29:62:3",403,"ٱلرِّزْقَ","the provision","ٱللَّهُ يَبْسُطُ","لِمَن يَشَآءُ مِنْ",219],["30:28:16",407,"رَزَقْنَـٰكُمْ","We have provided you","شُرَكَآءَ فِى مَا","فَأَنتُمْ فِيهِ سَوَآءٌۭ",198],["30:37:6",408,"ٱلرِّزْقَ","the provision","أَنَّ ٱللَّهَ يَبْسُطُ","لِمَن يَشَآءُ وَيَقْدِرُ ۚ",219],["30:40:5",408,"رَزَقَكُمْ","He provided (for) you","ٱلَّذِى خَلَقَكُمْ ثُمَّ","ثُمَّ يُمِيتُكُمْ ثُمَّ",198],["32:16:10",416,"رَزَقْنَـٰهُمْ","We have provided them","خَوْفًۭا وَطَمَعًۭا وَمِمَّا","يُنفِقُونَ",198],["33:31:13",422,"رِزْقًۭا","a provision","مَرَّتَيْنِ وَأَعْتَدْنَا لَهَا","كَرِيمًۭا",219],["34:4:9",428,"وَرِزْقٌۭ","and a provision","أُو۟لَـٰٓئِكَ لَهُم مَّغْفِرَةٌۭ","كَرِيمٌۭ",219],["34:15:13",430,"رِّزْقِ","(the) provision","وَشِمَالٍۢ ۖ كُلُوا۟ مِن","رَبِّكُمْ وَٱشْكُرُوا۟ لَهُۥ ۚ",219],["34:24:3",431,"يَرْزُقُكُم","provides (for) you","۞ قُلْ مَن","مِّنَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ",198],["34:36:5",432,"ٱلرِّزْقَ","the provision","إِنَّ رَبِّى يَبْسُطُ","لِمَن يَشَآءُ وَيَقْدِرُ",219],["34:39:5",432,"ٱلرِّزْقَ","the provision","إِنَّ رَبِّى يَبْسُطُ","لِمَن يَشَآءُ مِنْ",219],["34:39:20",432,"ٱلرَّٰزِقِينَ","(of) the Providers","يُخْلِفُهُۥ ۖ وَهُوَ خَيْرُ","",1226],["35:3:12",434,"يَرْزُقُكُم","who provides for you","خَـٰلِقٍ غَيْرُ ٱللَّهِ","مِّنَ ٱلسَّمَآءِ وَٱلْأَرْضِ ۚ",198],["35:29:10",437,"رَزَقْنَـٰهُمْ","We have provided them","ٱلصَّلَوٰةَ وَأَنفَقُوا۟ مِمَّا","سِرًّۭا وَعَلَانِيَةًۭ يَرْجُونَ",198],["36:47:6",443,"رَزَقَكُمُ","(has) provided you","لَهُمْ أَنفِقُوا۟ مِمَّا","ٱللَّهُ قَالَ ٱلَّذِينَ",198],["37:41:3",447,"رِزْقٌۭ","(will be) a provision","أُو۟لَـٰٓئِكَ لَهُمْ","مَّعْلُومٌۭ",219],["38:54:3",456,"لَرِزْقُنَا","(is) surely Our provision","إِنَّ هَـٰذَا","مَا لَهُۥ مِن",219],["39:52:6",464,"ٱلرِّزْقَ","the provision","أَنَّ ٱللَّهَ يَبْسُطُ","لِمَن يَشَآءُ وَيَقْدِرُ ۚ",219],["40:13:9",468,"رِزْقًۭا ۚ","provision","لَكُم مِّنَ ٱلسَّمَآءِ","وَمَا يَتَذَكَّرُ إِلَّا",219],["40:40:20",471,"يُرْزَقُونَ","they will be given provision","فَأُو۟لَـٰٓئِكَ يَدْخُلُونَ ٱلْجَنَّةَ","فِيهَا بِغَيْرِ حِسَابٍۢ",198],["40:64:12",474,"وَرَزَقَكُم","and provided you","وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ","مِّنَ ٱلطَّيِّبَـٰتِ ۚ ذَٰلِكُمُ",198],["42:12:6",484,"ٱلرِّزْقَ","the provision","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ يَبْسُطُ","لِمَن يَشَآءُ وَيَقْدِرُ ۚ",219],["42:19:4",485,"يَرْزُقُ","He gives provision","ٱللَّهُ لَطِيفٌۢ بِعِبَادِهِۦ","مَن يَشَآءُ ۖ وَهُوَ",198],["42:27:4",486,"ٱلرِّزْقَ","the provision","۞ وَلَوْ بَسَطَ ٱللَّهُ","لِعِبَادِهِۦ لَبَغَوْا۟ فِى",219],["42:38:10",487,"رَزَقْنَـٰهُمْ","We have provided them","شُورَىٰ بَيْنَهُمْ وَمِمَّا","يُنفِقُونَ",198],["45:5:10",499,"رِّزْقٍۢ","(the) provision","مِنَ ٱلسَّمَآءِ مِن","فَأَحْيَا بِهِ ٱلْأَرْضَ",219],["45:16:8",500,"وَرَزَقْنَـٰهُم","and We provided them","ٱلْكِتَـٰبَ وَٱلْحُكْمَ وَٱلنُّبُوَّةَ","مِّنَ ٱلطَّيِّبَـٰتِ وَفَضَّلْنَـٰهُمْ",198],["50:11:1",518,"رِّزْقًۭا","A provision","","لِّلْعِبَادِ ۖ وَأَحْيَيْنَا بِهِۦ",219],["51:22:3",521,"رِزْقُكُمْ","(is) your provision","وَفِى ٱلسَّمَآءِ","وَمَا تُوعَدُونَ",219],["51:57:5",523,"رِّزْقٍۢ","provision","أُرِيدُ مِنْهُم مِّن","وَمَآ أُرِيدُ أَن",219],["51:58:4",523,"ٱلرَّزَّاقُ","(is) the All-Provider","إِنَّ ٱللَّهَ هُوَ","ذُو ٱلْقُوَّةِ ٱلْمَتِينُ",4218],["56:82:2",537,"رِزْقَكُمْ","your provision","وَتَجْعَلُونَ","أَنَّكُمْ تُكَذِّبُونَ",219],["62:11:21",554,"ٱلرَّٰزِقِينَ","(of) the Providers","ٱلتِّجَـٰرَةِ ۚ وَٱللَّهُ خَيْرُ","",1226],["63:10:4",555,"رَزَقْنَـٰكُم","We have provided you","وَأَنفِقُوا۟ مِن مَّا","مِّن قَبْلِ أَن",198],["65:3:1",558,"وَيَرْزُقْهُ","And He will provide for him","","مِنْ حَيْثُ لَا",198],["65:7:9",559,"رِزْقُهُۥ","his provision","وَمَن قُدِرَ عَلَيْهِ","فَلْيُنفِقْ مِمَّآ ءَاتَىٰهُ",219],["65:11:34",559,"رِزْقًا","provision","أَحْسَنَ ٱللَّهُ لَهُۥ","",219],["67:15:12",563,"رِّزْقِهِۦ ۖ","His provision","مَنَاكِبِهَا وَكُلُوا۟ مِن","وَإِلَيْهِ ٱلنُّشُورُ",219],["67:21:4",563,"يَرْزُقُكُمْ","to provide you","أَمَّنْ هَـٰذَا ٱلَّذِى","إِنْ أَمْسَكَ رِزْقَهُۥ ۚ",198],["67:21:7",563,"رِزْقَهُۥ ۚ","His provision","يَرْزُقُكُمْ إِنْ أَمْسَكَ","بَل لَّجُّوا۟ فِى",219],["89:16:7",593,"رِزْقَهُۥ","his provision","ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ","فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ",219]]