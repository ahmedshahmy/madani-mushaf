[["2:254:16",42,"خُلَّةٌۭ","friendship","بَيْعٌۭ فِيهِ وَلَا","وَلَا شَفَـٰعَةٌۭ ۗ وَٱلْكَـٰفِرُونَ",4592],["4:125:17",98,"خَلِيلًۭا","(as) a friend","وَٱتَّخَذَ ٱللَّهُ إِبْرَٰهِيمَ","",1664],["9:47:9",194,"خِلَـٰلَكُمْ","in your midst","إِلَّا خَبَالًۭا وَلَأَوْضَعُوا۟","يَبْغُونَكُمُ ٱلْفِتْنَةَ وَفِيكُمْ",1012],["14:31:21",259,"خِلَـٰلٌ","any friendship","بَيْعٌۭ فِيهِ وَلَا","",1012],["17:5:13",282,"خِلَـٰلَ","the inner most part","بَأْسٍۢ شَدِيدٍۢ فَجَاسُوا۟","ٱلدِّيَارِ ۚ وَكَانَ وَعْدًۭا",1012],["17:73:13",289,"خَلِيلًۭا","(as) a friend","غَيْرَهُۥ ۖ وَإِذًۭا لَّٱتَّخَذُوكَ","",1664],["17:91:10",291,"خِلَـٰلَهَا","within them","وَعِنَبٍۢ فَتُفَجِّرَ ٱلْأَنْهَـٰرَ","تَفْجِيرًا",1012],["18:33:10",297,"خِلَـٰلَهُمَا","within them","مِّنْهُ شَيْـًۭٔا ۚ وَفَجَّرْنَا","نَهَرًۭا",1012],["24:43:17",355,"خِلَـٰلِهِۦ","their midst","ٱلْوَدْقَ يَخْرُجُ مِنْ","وَيُنَزِّلُ مِنَ ٱلسَّمَآءِ",1012],["25:28:6",362,"خَلِيلًۭا","(as) a friend","لَمْ أَتَّخِذْ فُلَانًا","",1664],["27:61:6",382,"خِلَـٰلَهَآ","(in) its midst","ٱلْأَرْضَ قَرَارًۭا وَجَعَلَ","أَنْهَـٰرًۭا وَجَعَلَ لَهَا",1012],["30:48:18",409,"خِلَـٰلِهِۦ ۖ","their midst","ٱلْوَدْقَ يَخْرُجُ مِنْ","فَإِذَآ أَصَابَ بِهِۦ",1012],["43:67:1",494,"ٱلْأَخِلَّآءُ","Friends","","يَوْمَئِذٍۭ بَعْضُهُمْ لِبَعْضٍ",1664]]