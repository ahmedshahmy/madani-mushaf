[["2:202:3",31,"نَصِيبٌۭ","(is) a share","أُو۟لَـٰٓئِكَ لَهُمْ","مِّمَّا كَسَبُوا۟ ۚ وَٱللَّهُ",495],["3:23:6",53,"نَصِيبًۭا","a portion","إِلَى ٱلَّذِينَ أُوتُوا۟","مِّنَ ٱلْكِتَـٰبِ يُدْعَوْنَ",495],["4:7:2",78,"نَصِيبٌۭ","a portion","لِّلرِّجَالِ","مِّمَّا تَرَكَ ٱلْوَٰلِدَانِ",495],["4:7:8",78,"نَصِيبٌۭ","a portion","ٱلْوَٰلِدَانِ وَٱلْأَقْرَبُونَ وَلِلنِّسَآءِ","مِّمَّا تَرَكَ ٱلْوَٰلِدَانِ",495],["4:7:18",78,"نَصِيبًۭا","a portion","مِنْهُ أَوْ كَثُرَ ۚ","مَّفْرُوضًۭا",495],["4:32:11",83,"نَصِيبٌۭ","(is) a share","عَلَىٰ بَعْضٍۢ ۚ لِّلرِّجَالِ","مِّمَّا ٱكْتَسَبُوا۟ ۖ وَلِلنِّسَآءِ",495],["4:32:15",83,"نَصِيبٌۭ","(is) a share","مِّمَّا ٱكْتَسَبُوا۟ ۖ وَلِلنِّسَآءِ","مِّمَّا ٱكْتَسَبْنَ ۚ وَسْـَٔلُوا۟",495],["4:33:12",83,"نَصِيبَهُمْ ۚ","their share","عَقَدَتْ أَيْمَـٰنُكُمْ فَـَٔاتُوهُمْ","إِنَّ ٱللَّهَ كَانَ",495],["4:44:6",85,"نَصِيبًۭا","a portion","إِلَى ٱلَّذِينَ أُوتُوا۟","مِّنَ ٱلْكِتَـٰبِ يَشْتَرُونَ",495],["4:51:6",86,"نَصِيبًۭا","a portion","إِلَى ٱلَّذِينَ أُوتُوا۟","مِّنَ ٱلْكِتَـٰبِ يُؤْمِنُونَ",495],["4:53:3",87,"نَصِيبٌۭ","(is) a share","أَمْ لَهُمْ","مِّنَ ٱلْمُلْكِ فَإِذًۭا",495],["4:85:7",91,"نَصِيبٌۭ","a share","حَسَنَةًۭ يَكُن لَّهُۥ","مِّنْهَا ۖ وَمَن يَشْفَعْ",495],["4:118:7",97,"نَصِيبًۭا","a portion","لَأَتَّخِذَنَّ مِنْ عِبَادِكَ","مَّفْرُوضًۭا",495],["4:141:17",101,"نَصِيبٌۭ","a chance","وَإِن كَانَ لِلْكَـٰفِرِينَ","قَالُوٓا۟ أَلَمْ نَسْتَحْوِذْ",495],["5:3:25",107,"ٱلنُّصُبِ","the stone altars","وَمَا ذُبِحَ عَلَى","وَأَن تَسْتَقْسِمُوا۟ بِٱلْأَزْلَـٰمِ ۚ",1948],["5:90:7",122,"وَٱلْأَنصَابُ","and (sacrifices at) altars","إِنَّمَا ٱلْخَمْرُ وَٱلْمَيْسِرُ","وَٱلْأَزْلَـٰمُ رِجْسٌۭ مِّنْ",1948],["6:136:8",145,"نَصِيبًۭا","a share","مِنَ ٱلْحَرْثِ وَٱلْأَنْعَـٰمِ","فَقَالُوا۟ هَـٰذَا لِلَّهِ",495],["7:37:13",154,"نَصِيبُهُم","their portion","بِـَٔايَـٰتِهِۦٓ ۚ أُو۟لَـٰٓئِكَ يَنَالُهُمْ","مِّنَ ٱلْكِتَـٰبِ ۖ حَتَّىٰٓ",495],["9:120:25",206,"نَصَبٌۭ","fatigue","يُصِيبُهُمْ ظَمَأٌۭ وَلَا","وَلَا مَخْمَصَةٌۭ فِى",1611],["11:109:18",234,"نَصِيبَهُمْ","their share","قَبْلُ ۚ وَإِنَّا لَمُوَفُّوهُمْ","غَيْرَ مَنقُوصٍۢ",495],["15:48:4",264,"نَصَبٌۭ","fatigue","لَا يَمَسُّهُمْ فِيهَا","وَمَا هُم مِّنْهَا",1611],["16:56:5",273,"نَصِيبًۭا","a portion","لِمَا لَا يَعْلَمُونَ","مِّمَّا رَزَقْنَـٰهُمْ ۗ تَٱللَّهِ",495],["18:62:12",301,"نَصَبًۭا","fatigue","مِن سَفَرِنَا هَـٰذَا","",1611],["28:77:9",394,"نَصِيبَكَ","your share","ٱلْـَٔاخِرَةَ ۖ وَلَا تَنسَ","مِنَ ٱلدُّنْيَا ۖ وَأَحْسِن",495],["35:35:10",438,"نَصَبٌۭ","any fatigue","لَا يَمَسُّنَا فِيهَا","وَلَا يَمَسُّنَا فِيهَا",1611],["38:41:10",455,"بِنُصْبٍۢ","with distress","أَنِّى مَسَّنِىَ ٱلشَّيْطَـٰنُ","وَعَذَابٍ",4062],["40:47:17",472,"نَصِيبًۭا","a portion","أَنتُم مُّغْنُونَ عَنَّا","مِّنَ ٱلنَّارِ",495],["42:20:22",485,"نَّصِيبٍ","share","فِى ٱلْـَٔاخِرَةِ مِن","",495],["70:43:8",570,"نُصُبٍۢ","a goal","سِرَاعًۭا كَأَنَّهُمْ إِلَىٰ","يُوفِضُونَ",1948],["88:3:2",592,"نَّاصِبَةٌۭ","exhausted","عَامِلَةٌۭ","",4075],["88:19:4",592,"نُصِبَتْ","they are fixed","وَإِلَى ٱلْجِبَالِ كَيْفَ","",2565],["94:7:3",597,"فَٱنصَبْ","then labor hard","فَإِذَا فَرَغْتَ","",2565]]