[["5:56:8",117,"حِزْبَ","(the) party","وَٱلَّذِينَ ءَامَنُوا۟ فَإِنَّ","ٱللَّهِ هُمُ ٱلْغَـٰلِبُونَ",510],["11:17:23",223,"ٱلْأَحْزَابِ","the sects","يَكْفُرْ بِهِۦ مِنَ","فَٱلنَّارُ مَوْعِدُهُۥ ۚ فَلَا",510],["13:36:9",254,"ٱلْأَحْزَابِ","the groups","أُنزِلَ إِلَيْكَ ۖ وَمِنَ","مَن يُنكِرُ بَعْضَهُۥ ۚ",510],["18:12:5",294,"ٱلْحِزْبَيْنِ","(of) the two parties","بَعَثْنَـٰهُمْ لِنَعْلَمَ أَىُّ","أَحْصَىٰ لِمَا لَبِثُوٓا۟",510],["19:37:2",307,"ٱلْأَحْزَابُ","the sects","فَٱخْتَلَفَ","مِنۢ بَيْنِهِمْ ۖ فَوَيْلٌۭ",510],["23:53:6",345,"حِزْبٍۭ","faction","بَيْنَهُمْ زُبُرًۭا ۖ كُلُّ","بِمَا لَدَيْهِمْ فَرِحُونَ",510],["30:32:8",407,"حِزْبٍۭ","party","وَكَانُوا۟ شِيَعًۭا ۖ كُلُّ","بِمَا لَدَيْهِمْ فَرِحُونَ",510],["33:20:2",420,"ٱلْأَحْزَابَ","the confederates","يَحْسَبُونَ","لَمْ يَذْهَبُوا۟ ۖ وَإِن",510],["33:20:7",420,"ٱلْأَحْزَابُ","the confederates","يَذْهَبُوا۟ ۖ وَإِن يَأْتِ","يَوَدُّوا۟ لَوْ أَنَّهُم",510],["33:22:4",420,"ٱلْأَحْزَابَ","the confederates","وَلَمَّا رَءَا ٱلْمُؤْمِنُونَ","قَالُوا۟ هَـٰذَا مَا",510],["35:6:9",435,"حِزْبَهُۥ","his party","عَدُوًّا ۚ إِنَّمَا يَدْعُوا۟","لِيَكُونُوا۟ مِنْ أَصْحَـٰبِ",510],["38:11:6",453,"ٱلْأَحْزَابِ","the companies","هُنَالِكَ مَهْزُومٌۭ مِّنَ","",510],["38:13:7",453,"ٱلْأَحْزَابُ","(were) the companies","وَأَصْحَـٰبُ لْـَٔيْكَةِ ۚ أُو۟لَـٰٓئِكَ","",510],["40:5:5",467,"وَٱلْأَحْزَابُ","and the factions","قَبْلَهُمْ قَوْمُ نُوحٍۢ","مِنۢ بَعْدِهِمْ ۖ وَهَمَّتْ",510],["40:30:10",470,"ٱلْأَحْزَابِ","(of) the companies","عَلَيْكُم مِّثْلَ يَوْمِ","",510],["43:65:2",494,"ٱلْأَحْزَابُ","the factions","فَٱخْتَلَفَ","مِنۢ بَيْنِهِمْ ۖ فَوَيْلٌۭ",510],["58:19:8",544,"حِزْبُ","(are the) party","ذِكْرَ ٱللَّهِ ۚ أُو۟لَـٰٓئِكَ","ٱلشَّيْطَـٰنِ ۚ أَلَآ إِنَّ",510],["58:19:12",544,"حِزْبَ","(the) party","ٱلشَّيْطَـٰنِ ۚ أَلَآ إِنَّ","ٱلشَّيْطَـٰنِ هُمُ ٱلْخَـٰسِرُونَ",510],["58:22:44",545,"حِزْبُ","(are the) party","وَرَضُوا۟ عَنْهُ ۚ أُو۟لَـٰٓئِكَ","ٱللَّهِ ۚ أَلَآ إِنَّ",510],["58:22:48",545,"حِزْبَ","(the) party","ٱللَّهِ ۚ أَلَآ إِنَّ","ٱللَّهِ هُمُ ٱلْمُفْلِحُونَ",510]]