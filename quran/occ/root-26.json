[["2:4:9",2,"قَبْلِكَ","before you","وَمَآ أُنزِلَ مِن","وَبِٱلْـَٔاخِرَةِ هُمْ يُوقِنُونَ",51],["2:21:9",4,"قَبْلِكُمْ","before you","خَلَقَكُمْ وَٱلَّذِينَ مِن","لَعَلَّكُمْ تَتَّقُونَ",51],["2:25:24",5,"قَبْلُ ۖ","before","ٱلَّذِى رُزِقْنَا مِن","وَأُتُوا۟ بِهِۦ مُتَشَـٰبِهًۭا ۖ",51],["2:48:10",7,"يُقْبَلُ","will be accepted","نَّفْسٍۢ شَيْـًۭٔا وَلَا","مِنْهَا شَفَـٰعَةٌۭ وَلَا",937],["2:89:12",14,"قَبْلُ","before","مَعَهُمْ وَكَانُوا۟ مِن","يَسْتَفْتِحُونَ عَلَى ٱلَّذِينَ",51],["2:91:27",14,"قَبْلُ","before","أَنۢبِيَآءَ ٱللَّهِ مِن","إِن كُنتُم مُّؤْمِنِينَ",51],["2:108:10",17,"قَبْلُ ۗ","before","سُئِلَ مُوسَىٰ مِن","وَمَن يَتَبَدَّلِ ٱلْكُفْرَ",51],["2:118:15",18,"قَبْلِهِم","before them","قَالَ ٱلَّذِينَ مِن","مِّثْلَ قَوْلِهِمْ ۘ تَشَـٰبَهَتْ",51],["2:123:10",19,"يُقْبَلُ","will be accepted","نَّفْسٍۢ شَيْـًۭٔا وَلَا","مِنْهَا عَدْلٌۭ وَلَا",937],["2:127:9",20,"تَقَبَّلْ","Accept","ٱلْبَيْتِ وَإِسْمَـٰعِيلُ رَبَّنَا","مِنَّآ ۖ إِنَّكَ أَنتَ",861],["2:142:8",22,"قِبْلَتِهِمُ","their direction of prayer","مَا وَلَّىٰهُمْ عَن","ٱلَّتِى كَانُوا۟ عَلَيْهَا ۚ",1096],["2:143:15",22,"ٱلْقِبْلَةَ","the direction of prayer","شَهِيدًۭا ۗ وَمَا جَعَلْنَا","ٱلَّتِى كُنتَ عَلَيْهَآ",1096],["2:144:8",22,"قِبْلَةًۭ","(to the) direction of prayer","فِى ٱلسَّمَآءِ ۖ فَلَنُوَلِّيَنَّكَ","تَرْضَىٰهَا ۚ فَوَلِّ وَجْهَكَ",1096],["2:145:10",22,"قِبْلَتَكَ ۚ","your direction of prayer","ءَايَةٍۢ مَّا تَبِعُوا۟","وَمَآ أَنتَ بِتَابِعٍۢ",1096],["2:145:14",22,"قِبْلَتَهُمْ ۚ","(of) their direction of prayer","وَمَآ أَنتَ بِتَابِعٍۢ","وَمَا بَعْضُهُم بِتَابِعٍۢ",1096],["2:145:18",22,"قِبْلَةَ","(of the) direction of prayer","وَمَا بَعْضُهُم بِتَابِعٍۢ","بَعْضٍۢ ۚ وَلَئِنِ ٱتَّبَعْتَ",1096],["2:177:6",27,"قِبَلَ","towards","أَن تُوَلُّوا۟ وُجُوهَكُمْ","ٱلْمَشْرِقِ وَٱلْمَغْرِبِ وَلَـٰكِنَّ",1622],["2:183:12",28,"قَبْلِكُمْ","before you","عَلَى ٱلَّذِينَ مِن","لَعَلَّكُمْ تَتَّقُونَ",51],["2:198:24",31,"قَبْلِهِۦ","before [it]","وَإِن كُنتُم مِّن","لَمِنَ ٱلضَّآلِّينَ",51],["2:214:12",33,"قَبْلِكُم ۖ","before you","ٱلَّذِينَ خَلَوْا۟ مِن","مَّسَّتْهُمُ ٱلْبَأْسَآءُ وَٱلضَّرَّآءُ",51],["2:237:4",38,"قَبْلِ","before","وَإِن طَلَّقْتُمُوهُنَّ مِن","أَن تَمَسُّوهُنَّ وَقَدْ",51],["2:254:8",42,"قَبْلِ","before","مِمَّا رَزَقْنَـٰكُم مِّن","أَن يَأْتِىَ يَوْمٌۭ",51],["2:286:30",49,"قَبْلِنَا ۚ","before us","عَلَى ٱلَّذِينَ مِن","رَبَّنَا وَلَا تُحَمِّلْنَا",51],["3:4:2",50,"قَبْلُ","before (this)","مِن","هُدًۭى لِّلنَّاسِ وَأَنزَلَ",51],["3:11:6",51,"قَبْلِهِمْ ۚ","before them","فِرْعَوْنَ وَٱلَّذِينَ مِن","كَذَّبُوا۟ بِـَٔايَـٰتِنَا فَأَخَذَهُمُ",51],["3:35:13",54,"فَتَقَبَّلْ","so accept","فِى بَطْنِى مُحَرَّرًۭا","مِنِّىٓ ۖ إِنَّكَ أَنتَ",861],["3:37:1",54,"فَتَقَبَّلَهَا","So accepted her","","رَبُّهَا بِقَبُولٍ حَسَنٍۢ",861],["3:37:3",54,"بِقَبُولٍ","with acceptance","فَتَقَبَّلَهَا رَبُّهَا","حَسَنٍۢ وَأَنۢبَتَهَا نَبَاتًا",4120],["3:85:7",61,"يُقْبَلَ","will be accepted","ٱلْإِسْلَـٰمِ دِينًۭا فَلَن","مِنْهُ وَهُوَ فِى",937],["3:90:10",61,"تُقْبَلَ","will be accepted","ٱزْدَادُوا۟ كُفْرًۭا لَّن","تَوْبَتُهُمْ وَأُو۟لَـٰٓئِكَ هُمُ",937],["3:91:8",61,"يُقْبَلَ","will be accepted","وَهُمْ كُفَّارٌۭ فَلَن","مِنْ أَحَدِهِم مِّلْءُ",937],["3:93:14",62,"قَبْلِ","before","عَلَىٰ نَفْسِهِۦ مِن","أَن تُنَزَّلَ ٱلتَّوْرَىٰةُ ۗ",51],["3:137:4",67,"قَبْلِكُمْ","before you","قَدْ خَلَتْ مِن","سُنَنٌۭ فَسِيرُوا۟ فِى",51],["3:143:6",68,"قَبْلِ","before","تَمَنَّوْنَ ٱلْمَوْتَ مِن","أَن تَلْقَوْهُ فَقَدْ",51],["3:144:8",68,"قَبْلِهِ","before him","قَدْ خَلَتْ مِن","ٱلرُّسُلُ ۚ أَفَإِي۟ن مَّاتَ",51],["3:164:22",71,"قَبْلُ","before (that)","وَإِن كَانُوا۟ مِن","لَفِى ضَلَـٰلٍۢ مُّبِينٍ",51],["3:183:20",74,"قَبْلِى","before me","جَآءَكُمْ رُسُلٌۭ مِّن","بِٱلْبَيِّنَـٰتِ وَبِٱلَّذِى قُلْتُمْ",51],["3:184:7",74,"قَبْلِكَ","before you","كُذِّبَ رُسُلٌۭ مِّن","جَآءُو بِٱلْبَيِّنَـٰتِ وَٱلزُّبُرِ",51],["3:186:11",74,"قَبْلِكُمْ","before you","أُوتُوا۟ ٱلْكِتَـٰبَ مِن","وَمِنَ ٱلَّذِينَ أَشْرَكُوٓا۟",51],["4:26:9",82,"قَبْلِكُمْ","before you","سُنَنَ ٱلَّذِينَ مِن","وَيَتُوبَ عَلَيْكُمْ ۗ وَٱللَّهُ",51],["4:47:12",86,"قَبْلِ","before","لِّمَا مَعَكُم مِّن","أَن نَّطْمِسَ وُجُوهًۭا",51],["4:60:14",88,"قَبْلِكَ","before you","وَمَآ أُنزِلَ مِن","يُرِيدُونَ أَن يَتَحَاكَمُوٓا۟",51],["4:94:29",93,"قَبْلُ","before","كَذَٰلِكَ كُنتُم مِّن","فَمَنَّ ٱللَّهُ عَلَيْكُمْ",51],["4:131:14",99,"قَبْلِكُمْ","before you","أُوتُوا۟ ٱلْكِتَـٰبَ مِن","وَإِيَّاكُمْ أَنِ ٱتَّقُوا۟",51],["4:136:16",100,"قَبْلُ ۚ","before","ٱلَّذِىٓ أَنزَلَ مِن","وَمَن يَكْفُرْ بِٱللَّهِ",51],["4:159:8",103,"قَبْلَ","before","إِلَّا لَيُؤْمِنَنَّ بِهِۦ","مَوْتِهِۦ ۖ وَيَوْمَ ٱلْقِيَـٰمَةِ",51],["4:162:14",103,"قَبْلِكَ ۚ","before you","وَمَآ أُنزِلَ مِن","وَٱلْمُقِيمِينَ ٱلصَّلَوٰةَ ۚ وَٱلْمُؤْتُونَ",51],["4:164:6",104,"قَبْلُ","before","قَصَصْنَـٰهُمْ عَلَيْكَ مِن","وَرُسُلًۭا لَّمْ نَقْصُصْهُمْ",51],["5:5:23",107,"قَبْلِكُمْ","before you","أُوتُوا۟ ٱلْكِتَـٰبَ مِن","إِذَآ ءَاتَيْتُمُوهُنَّ أُجُورَهُنَّ",51],["5:27:10",112,"فَتُقُبِّلَ","and it was accepted","إِذْ قَرَّبَا قُرْبَانًۭا","مِنْ أَحَدِهِمَا وَلَمْ",861],["5:27:14",112,"يُتَقَبَّلْ","was accepted","مِنْ أَحَدِهِمَا وَلَمْ","مِنَ ٱلْـَٔاخَرِ قَالَ",861],["5:27:21",112,"يَتَقَبَّلُ","accepts","لَأَقْتُلَنَّكَ ۖ قَالَ إِنَّمَا","ٱللَّهُ مِنَ ٱلْمُتَّقِينَ",861],["5:34:5",113,"قَبْلِ","before","ٱلَّذِينَ تَابُوا۟ مِن","أَن تَقْدِرُوا۟ عَلَيْهِمْ ۖ",51],["5:36:20",113,"تُقُبِّلَ","will be accepted","يَوْمِ ٱلْقِيَـٰمَةِ مَا","مِنْهُمْ ۖ وَلَهُمْ عَذَابٌ",861],["5:57:16",117,"قَبْلِكُمْ","before you","أُوتُوا۟ ٱلْكِتَـٰبَ مِن","وَٱلْكُفَّارَ أَوْلِيَآءَ ۚ وَٱتَّقُوا۟",51],["5:59:17",118,"قَبْلُ","before","وَمَآ أُنزِلَ مِن","وَأَنَّ أَكْثَرَكُمْ فَـٰسِقُونَ",51],["5:75:10",120,"قَبْلِهِ","before him","قَدْ خَلَتْ مِن","ٱلرُّسُلُ وَأُمُّهُۥ صِدِّيقَةٌۭ ۖ",51],["5:77:17",120,"قَبْلُ","before","قَدْ ضَلُّوا۟ مِن","وَأَضَلُّوا۟ كَثِيرًۭا وَضَلُّوا۟",51],["5:102:5",124,"قَبْلِكُمْ","before you","سَأَلَهَا قَوْمٌۭ مِّن","ثُمَّ أَصْبَحُوا۟ بِهَا",51],["6:6:6",128,"قَبْلِهِم","before them","كَمْ أَهْلَكْنَا مِن","مِّن قَرْنٍۢ مَّكَّنَّـٰهُمْ",51],["6:10:5",129,"قَبْلِكَ","before you","ٱسْتُهْزِئَ بِرُسُلٍۢ مِّن","فَحَاقَ بِٱلَّذِينَ سَخِرُوا۟",51],["6:28:8",131,"قَبْلُ ۖ","before","كَانُوا۟ يُخْفُونَ مِن","وَلَوْ رُدُّوا۟ لَعَادُوا۟",51],["6:34:5",131,"قَبْلِكَ","before you","كُذِّبَتْ رُسُلٌۭ مِّن","فَصَبَرُوا۟ عَلَىٰ مَا",51],["6:42:6",132,"قَبْلِكَ","before you","إِلَىٰٓ أُمَمٍۢ مِّن","فَأَخَذْنَـٰهُم بِٱلْبَأْسَآءِ وَٱلضَّرَّآءِ",51],["6:84:10",138,"قَبْلُ ۖ","before","وَنُوحًا هَدَيْنَا مِن","وَمِن ذُرِّيَّتِهِۦ دَاوُۥدَ",51],["6:111:12",142,"قُبُلًۭا","face to face","عَلَيْهِمْ كُلَّ شَىْءٍۢ","مَّا كَانُوا۟ لِيُؤْمِنُوٓا۟",1966],["6:148:19",148,"قَبْلِهِمْ","before them","كَذَّبَ ٱلَّذِينَ مِن","حَتَّىٰ ذَاقُوا۟ بَأْسَنَا ۗ",51],["6:156:9",149,"قَبْلِنَا","before us","عَلَىٰ طَآئِفَتَيْنِ مِن","وَإِن كُنَّا عَن",51],["6:158:28",150,"قَبْلُ","before","تَكُنْ ءَامَنَتْ مِن","أَوْ كَسَبَتْ فِىٓ",51],["7:27:19",153,"وَقَبِيلُهُۥ","and his tribe","إِنَّهُۥ يَرَىٰكُمْ هُوَ","مِنْ حَيْثُ لَا",2576],["7:38:8",155,"قَبْلِكُم","before you","قَدْ خَلَتْ مِن","مِّنَ ٱلْجِنِّ وَٱلْإِنسِ",51],["7:53:12",157,"قَبْلُ","before","ٱلَّذِينَ نَسُوهُ مِن","قَدْ جَآءَتْ رُسُلُ",51],["7:101:17",163,"قَبْلُ ۚ","before","بِمَا كَذَّبُوا۟ مِن","كَذَٰلِكَ يَطْبَعُ ٱللَّهُ",51],["7:123:5",165,"قَبْلَ","before","فِرْعَوْنُ ءَامَنتُم بِهِۦ","أَنْ ءَاذَنَ لَكُمْ ۖ",51],["7:129:4",165,"قَبْلِ","before","قَالُوٓا۟ أُوذِينَا مِن","أَن تَأْتِيَنَا وَمِنۢ",51],["7:155:16",169,"قَبْلُ","before","شِئْتَ أَهْلَكْتَهُم مِّن","وَإِيَّـٰىَ ۖ أَتُهْلِكُنَا بِمَا",51],["7:173:7",173,"قَبْلُ","before (us)","أَشْرَكَ ءَابَآؤُنَا مِن","وَكُنَّا ذُرِّيَّةًۭ مِّنۢ",51],["8:52:6",183,"قَبْلِهِمْ ۚ","before them","فِرْعَوْنَ ۙ وَٱلَّذِينَ مِن","كَفَرُوا۟ بِـَٔايَـٰتِ ٱللَّهِ",51],["8:54:6",184,"قَبْلِهِمْ ۚ","before them","فِرْعَوْنَ ۙ وَٱلَّذِينَ مِن","كَذَّبُوا۟ بِـَٔايَـٰتِ رَبِّهِمْ",51],["8:71:8",186,"قَبْلُ","before","خَانُوا۟ ٱللَّهَ مِن","فَأَمْكَنَ مِنْهُمْ ۗ وَٱللَّهُ",51],["9:30:19",191,"قَبْلُ ۚ","before","ٱلَّذِينَ كَفَرُوا۟ مِن","قَـٰتَلَهُمُ ٱللَّهُ ۚ أَنَّىٰ",51],["9:48:5",195,"قَبْلُ","before","ٱبْتَغَوُا۟ ٱلْفِتْنَةَ مِن","وَقَلَّبُوا۟ لَكَ ٱلْأُمُورَ",51],["9:50:13",195,"قَبْلُ","before","أَخَذْنَآ أَمْرَنَا مِن","وَيَتَوَلَّوا۟ وَّهُمْ فَرِحُونَ",51],["9:53:7",195,"يُتَقَبَّلَ","will be accepted","أَوْ كَرْهًۭا لَّن","مِنكُمْ ۖ إِنَّكُمْ كُنتُمْ",861],["9:54:4",195,"تُقْبَلَ","is accepted","وَمَا مَنَعَهُمْ أَن","مِنْهُمْ نَفَقَـٰتُهُمْ إِلَّآ",937],["9:69:3",198,"قَبْلِكُمْ","before you","كَٱلَّذِينَ مِن","كَانُوٓا۟ أَشَدَّ مِنكُمْ",51],["9:69:19",198,"قَبْلِكُم","before you","ٱسْتَمْتَعَ ٱلَّذِينَ مِن","بِخَلَـٰقِهِمْ وَخُضْتُمْ كَٱلَّذِى",51],["9:70:6",198,"قَبْلِهِمْ","(were) before them","نَبَأُ ٱلَّذِينَ مِن","قَوْمِ نُوحٍۢ وَعَادٍۢ",51],["9:104:6",203,"يَقْبَلُ","(Who) accepts","أَنَّ ٱللَّهَ هُوَ","ٱلتَّوْبَةَ عَنْ عِبَادِهِۦ",937],["9:107:15",204,"قَبْلُ ۚ","before","ٱللَّهَ وَرَسُولَهُۥ مِن","وَلَيَحْلِفُنَّ إِنْ أَرَدْنَآ",51],["10:13:5",209,"قَبْلِكُمْ","before you","أَهْلَكْنَا ٱلْقُرُونَ مِن","لَمَّا ظَلَمُوا۟ ۙ وَجَآءَتْهُمْ",51],["10:16:16",210,"قَبْلِهِۦٓ ۚ","before it","فِيكُمْ عُمُرًۭا مِّن","أَفَلَا تَعْقِلُونَ",51],["10:39:14",213,"قَبْلِهِمْ ۖ","before them","كَذَّبَ ٱلَّذِينَ مِن","فَٱنظُرْ كَيْفَ كَانَ",51],["10:74:17",217,"قَبْلُ ۚ","before","كَذَّبُوا۟ بِهِۦ مِن","كَذَٰلِكَ نَطْبَعُ عَلَىٰ",51],["10:87:12",218,"قِبْلَةًۭ","(as) places of worship","بُيُوتًۭا وَٱجْعَلُوا۟ بُيُوتَكُمْ","وَأَقِيمُوا۟ ٱلصَّلَوٰةَ ۗ وَبَشِّرِ",1096],["10:91:4",219,"قَبْلُ","before","ءَآلْـَٔـٰنَ وَقَدْ عَصَيْتَ","وَكُنتَ مِنَ ٱلْمُفْسِدِينَ",51],["10:94:13",219,"قَبْلِكَ ۚ","before you","يَقْرَءُونَ ٱلْكِتَـٰبَ مِن","لَقَدْ جَآءَكَ ٱلْحَقُّ",51],["10:102:9",220,"قَبْلِهِمْ ۚ","before them","ٱلَّذِينَ خَلَوْا۟ مِن","قُلْ فَٱنتَظِرُوٓا۟ إِنِّى",51],["11:17:11",223,"قَبْلِهِۦ","and before it","شَاهِدٌۭ مِّنْهُ وَمِن","كِتَـٰبُ مُوسَىٰٓ إِمَامًۭا",51],["11:49:14",227,"قَبْلِ","before","وَلَا قَوْمُكَ مِن","هَـٰذَا ۖ فَٱصْبِرْ ۖ إِنَّ",51],["11:62:7",228,"قَبْلَ","before","كُنتَ فِينَا مَرْجُوًّۭا","هَـٰذَآ ۖ أَتَنْهَىٰنَآ أَن",51],["11:78:6",230,"قَبْلُ","and before","يُهْرَعُونَ إِلَيْهِ وَمِن","كَانُوا۟ يَعْمَلُونَ ٱلسَّيِّـَٔاتِ ۚ",51],["11:109:15",234,"قَبْلُ ۚ","before","يَعْبُدُ ءَابَآؤُهُم مِّن","وَإِنَّا لَمُوَفُّوهُمْ نَصِيبَهُمْ",51],["11:116:6",234,"قَبْلِكُمْ","before you","مِنَ ٱلْقُرُونِ مِن","أُو۟لُوا۟ بَقِيَّةٍۢ يَنْهَوْنَ",51],["12:3:14",235,"قَبْلِهِۦ","before it","وَإِن كُنتَ مِن","لَمِنَ ٱلْغَـٰفِلِينَ",51],["12:6:19",236,"قَبْلُ","before","عَلَىٰٓ أَبَوَيْكَ مِن","إِبْرَٰهِيمَ وَإِسْحَـٰقَ ۚ إِنَّ",51],["12:26:15",238,"قُبُلٍۢ","the front","قَمِيصُهُۥ قُدَّ مِن","فَصَدَقَتْ وَهُوَ مِنَ",1966],["12:37:9",239,"قَبْلَ","before","إِلَّا نَبَّأْتُكُمَا بِتَأْوِيلِهِۦ","أَن يَأْتِيَكُمَا ۚ ذَٰلِكُمَا",51],["12:64:11",243,"قَبْلُ ۖ","before","عَلَىٰٓ أَخِيهِ مِن","فَٱللَّهُ خَيْرٌ حَـٰفِظًۭا ۖ",51],["12:71:2",244,"وَأَقْبَلُوا۟","turning towards","قَالُوا۟","عَلَيْهِم مَّاذَا تَفْقِدُونَ",876],["12:76:3",244,"قَبْلَ","before","فَبَدَأَ بِأَوْعِيَتِهِمْ","وِعَآءِ أَخِيهِ ثُمَّ",51],["12:77:9",244,"قَبْلُ ۚ","before","أَخٌۭ لَّهُۥ مِن","فَأَسَرَّهَا يُوسُفُ فِى",51],["12:80:19",245,"قَبْلُ","and before","مِّنَ ٱللَّهِ وَمِن","مَا فَرَّطتُمْ فِى",51],["12:82:8",245,"أَقْبَلْنَا","we returned","فِيهَا وَٱلْعِيرَ ٱلَّتِىٓ","فِيهَا ۖ وَإِنَّا لَصَـٰدِقُونَ",876],["12:100:14",247,"قَبْلُ","(of) before","تَأْوِيلُ رُءْيَـٰىَ مِن","قَدْ جَعَلَهَا رَبِّى",51],["12:109:4",248,"قَبْلِكَ","before you","وَمَآ أَرْسَلْنَا مِن","إِلَّا رِجَالًۭا نُّوحِىٓ",51],["12:109:22",248,"قَبْلِهِمْ ۗ","(were) before them","عَـٰقِبَةُ ٱلَّذِينَ مِن","وَلَدَارُ ٱلْـَٔاخِرَةِ خَيْرٌۭ",51],["13:6:3",250,"قَبْلَ","before","وَيَسْتَعْجِلُونَكَ بِٱلسَّيِّئَةِ","ٱلْحَسَنَةِ وَقَدْ خَلَتْ",51],["13:6:8",250,"قَبْلِهِمُ","before them","وَقَدْ خَلَتْ مِن","ٱلْمَثُلَـٰتُ ۗ وَإِنَّ رَبَّكَ",51],["13:30:8",253,"قَبْلِهَآ","before it","قَدْ خَلَتْ مِن","أُمَمٌۭ لِّتَتْلُوَا۟ عَلَيْهِمُ",51],["13:32:5",253,"قَبْلِكَ","before you","ٱسْتُهْزِئَ بِرُسُلٍۢ مِّن","فَأَمْلَيْتُ لِلَّذِينَ كَفَرُوا۟",51],["13:38:5",254,"قَبْلِكَ","before you","أَرْسَلْنَا رُسُلًۭا مِّن","وَجَعَلْنَا لَهُمْ أَزْوَٰجًۭا",51],["13:42:5",254,"قَبْلِهِمْ","before them","مَكَرَ ٱلَّذِينَ مِن","فَلِلَّهِ ٱلْمَكْرُ جَمِيعًۭا ۖ",51],["14:9:6",256,"قَبْلِكُمْ","(were) before you","نَبَؤُا۟ ٱلَّذِينَ مِن","قَوْمِ نُوحٍۢ وَعَادٍۢ",51],["14:22:39",258,"قَبْلُ ۗ","before","بِمَآ أَشْرَكْتُمُونِ مِن","إِنَّ ٱلظَّـٰلِمِينَ لَهُمْ",51],["14:31:13",259,"قَبْلِ","before","سِرًّۭا وَعَلَانِيَةًۭ مِّن","أَن يَأْتِىَ يَوْمٌۭ",51],["14:40:8",260,"وَتَقَبَّلْ","and accept","وَمِن ذُرِّيَّتِى ۚ رَبَّنَا","دُعَآءِ",861],["14:44:22",261,"قَبْلُ","before","تَكُونُوٓا۟ أَقْسَمْتُم مِّن","مَا لَكُم مِّن",51],["15:10:4",262,"قَبْلِكَ","before you","وَلَقَدْ أَرْسَلْنَا مِن","فِى شِيَعِ ٱلْأَوَّلِينَ",51],["15:27:4",263,"قَبْلُ","before","وَٱلْجَآنَّ خَلَقْنَـٰهُ مِن","مِن نَّارِ ٱلسَّمُومِ",51],["15:47:10",264,"مُّتَقَـٰبِلِينَ","facing each other","إِخْوَٰنًا عَلَىٰ سُرُرٍۢ","",1607],["16:26:5",269,"قَبْلِهِمْ","(were) before them","مَكَرَ ٱلَّذِينَ مِن","فَأَتَى ٱللَّهُ بُنْيَـٰنَهُم",51],["16:33:15",270,"قَبْلِهِمْ ۚ","(were) before them","فَعَلَ ٱلَّذِينَ مِن","وَمَا ظَلَمَهُمُ ٱللَّهُ",51],["16:35:26",271,"قَبْلِهِمْ ۚ","(were) before them","فَعَلَ ٱلَّذِينَ مِن","فَهَلْ عَلَى ٱلرُّسُلِ",51],["16:43:4",272,"قَبْلِكَ","before you","وَمَآ أَرْسَلْنَا مِن","إِلَّا رِجَالًۭا نُّوحِىٓ",51],["16:63:7",273,"قَبْلِكَ","before you","إِلَىٰٓ أُمَمٍۢ مِّن","فَزَيَّنَ لَهُمُ ٱلشَّيْطَـٰنُ",51],["16:118:9",280,"قَبْلُ ۖ","before","قَصَصْنَا عَلَيْكَ مِن","وَمَا ظَلَمْنَـٰهُمْ وَلَـٰكِن",51],["17:58:7",287,"قَبْلَ","before","إِلَّا نَحْنُ مُهْلِكُوهَا","يَوْمِ ٱلْقِيَـٰمَةِ أَوْ",51],["17:77:5",290,"قَبْلَكَ","before you","مَن قَدْ أَرْسَلْنَا","مِن رُّسُلِنَا ۖ وَلَا",51],["17:92:12",291,"قَبِيلًا","before (us)","تَأْتِىَ بِٱللَّهِ وَٱلْمَلَـٰٓئِكَةِ","",2576],["17:107:12",293,"قَبْلِهِۦٓ","before it","أُوتُوا۟ ٱلْعِلْمَ مِن","إِذَا يُتْلَىٰ عَلَيْهِمْ",51],["18:55:19",300,"قُبُلًۭا","before (them)","أَوْ يَأْتِيَهُمُ ٱلْعَذَابُ","",1966],["18:109:10",304,"قَبْلَ","before","رَبِّى لَنَفِدَ ٱلْبَحْرُ","أَن تَنفَدَ كَلِمَـٰتُ",51],["19:7:11",305,"قَبْلُ","before","نَجْعَل لَّهُۥ مِن","سَمِيًّۭا",51],["19:9:11",305,"قَبْلُ","before","وَقَدْ خَلَقْتُكَ مِن","وَلَمْ تَكُ شَيْـًۭٔا",51],["19:23:9",306,"قَبْلَ","before","قَالَتْ يَـٰلَيْتَنِى مِتُّ","هَـٰذَا وَكُنتُ نَسْيًۭا",51],["19:67:7",310,"قَبْلُ","before","أَنَّا خَلَقْنَـٰهُ مِن","وَلَمْ يَكُ شَيْـًۭٔا",51],["19:74:3",310,"قَبْلَهُم","before them","وَكَمْ أَهْلَكْنَا","مِّن قَرْنٍ هُمْ",51],["19:98:3",312,"قَبْلَهُم","before them","وَكَمْ أَهْلَكْنَا","مِّن قَرْنٍ هَلْ",51],["20:71:4",316,"قَبْلَ","before","قَالَ ءَامَنتُمْ لَهُۥ","أَنْ ءَاذَنَ لَكُمْ ۖ",51],["20:90:6",318,"قَبْلُ","before","لَهُمْ هَـٰرُونُ مِن","يَـٰقَوْمِ إِنَّمَا فُتِنتُم",51],["20:114:9",320,"قَبْلِ","before","تَعْجَلْ بِٱلْقُرْءَانِ مِن","أَن يُقْضَىٰٓ إِلَيْكَ",51],["20:115:6",320,"قَبْلُ","before","إِلَىٰٓ ءَادَمَ مِن","فَنَسِىَ وَلَمْ نَجِدْ",51],["20:128:6",321,"قَبْلَهُم","before them","لَهُمْ كَمْ أَهْلَكْنَا","مِّنَ ٱلْقُرُونِ يَمْشُونَ",51],["20:130:8",321,"قَبْلَ","before","وَسَبِّحْ بِحَمْدِ رَبِّكَ","طُلُوعِ ٱلشَّمْسِ وَقَبْلَ",51],["20:130:11",321,"وَقَبْلَ","and before","قَبْلَ طُلُوعِ ٱلشَّمْسِ","غُرُوبِهَا ۖ وَمِنْ ءَانَآئِ",51],["20:134:6",321,"قَبْلِهِۦ","before him","أَهْلَكْنَـٰهُم بِعَذَابٍۢ مِّن","لَقَالُوا۟ رَبَّنَا لَوْلَآ",51],["20:134:16",321,"قَبْلِ","before","فَنَتَّبِعَ ءَايَـٰتِكَ مِن","أَن نَّذِلَّ وَنَخْزَىٰ",51],["21:6:3",322,"قَبْلَهُم","before them","مَآ ءَامَنَتْ","مِّن قَرْيَةٍ أَهْلَكْنَـٰهَآ ۖ",51],["21:7:3",322,"قَبْلَكَ","before you","وَمَآ أَرْسَلْنَا","إِلَّا رِجَالًۭا نُّوحِىٓ",51],["21:24:15",323,"قَبْلِى ۗ","(were) before me","مَّعِىَ وَذِكْرُ مَن","بَلْ أَكْثَرُهُمْ لَا",51],["21:25:4",324,"قَبْلِكَ","before you","وَمَآ أَرْسَلْنَا مِن","مِن رَّسُولٍ إِلَّا",51],["21:34:5",324,"قَبْلِكَ","before you","جَعَلْنَا لِبَشَرٍۢ مِّن","ٱلْخُلْدَ ۖ أَفَإِي۟ن مِّتَّ",51],["21:41:5",325,"قَبْلِكَ","before you","ٱسْتُهْزِئَ بِرُسُلٍۢ مِّن","فَحَاقَ بِٱلَّذِينَ سَخِرُوا۟",51],["21:51:6",326,"قَبْلُ","before","إِبْرَٰهِيمَ رُشْدَهُۥ مِن","وَكُنَّا بِهِۦ عَـٰلِمِينَ",51],["21:76:5",328,"قَبْلُ","before","إِذْ نَادَىٰ مِن","فَٱسْتَجَبْنَا لَهُۥ فَنَجَّيْنَـٰهُ",51],["22:42:5",337,"قَبْلَهُمْ","before them","يُكَذِّبُوكَ فَقَدْ كَذَّبَتْ","قَوْمُ نُوحٍۢ وَعَادٌۭ",51],["22:52:4",338,"قَبْلِكَ","before you","وَمَآ أَرْسَلْنَا مِن","مِن رَّسُولٍۢ وَلَا",51],["22:78:22",341,"قَبْلُ","before","سَمَّىٰكُمُ ٱلْمُسْلِمِينَ مِن","وَفِى هَـٰذَا لِيَكُونَ",51],["23:83:7",347,"قَبْلُ","before","وَءَابَآؤُنَا هَـٰذَا مِن","إِنْ هَـٰذَآ إِلَّآ",51],["24:4:13",350,"تَقْبَلُوا۟","accept","ثَمَـٰنِينَ جَلْدَةًۭ وَلَا","لَهُمْ شَهَـٰدَةً أَبَدًۭا ۚ",937],["24:34:11",354,"قَبْلِكُمْ","before you","ٱلَّذِينَ خَلَوْا۟ مِن","وَمَوْعِظَةًۭ لِّلْمُتَّقِينَ",51],["24:55:15",357,"قَبْلِهِمْ","(were) before them","ٱسْتَخْلَفَ ٱلَّذِينَ مِن","وَلَيُمَكِّنَنَّ لَهُمْ دِينَهُمُ",51],["24:58:16",357,"قَبْلِ","before","ثَلَـٰثَ مَرَّٰتٍۢ ۚ مِّن","صَلَوٰةِ ٱلْفَجْرِ وَحِينَ",51],["24:59:11",358,"قَبْلِهِمْ ۚ","(were) before them","ٱسْتَـْٔذَنَ ٱلَّذِينَ مِن","كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ",51],["25:20:3",361,"قَبْلَكَ","before you","وَمَآ أَرْسَلْنَا","مِنَ ٱلْمُرْسَلِينَ إِلَّآ",51],["26:49:4",369,"قَبْلَ","before","قَالَ ءَامَنتُمْ لَهُۥ","أَنْ ءَاذَنَ لَكُمْ ۖ",51],["27:37:6",380,"قِبَلَ","(is) resistance","فَلَنَأْتِيَنَّهُم بِجُنُودٍۢ لَّا","لَهُم بِهَا وَلَنُخْرِجَنَّهُم",1622],["27:38:7",380,"قَبْلَ","before","أَيُّكُمْ يَأْتِينِى بِعَرْشِهَا","أَن يَأْتُونِى مُسْلِمِينَ",51],["27:39:8",380,"قَبْلَ","before","أَنَا۠ ءَاتِيكَ بِهِۦ","أَن تَقُومَ مِن",51],["27:40:10",380,"قَبْلَ","before","أَنَا۠ ءَاتِيكَ بِهِۦ","أَن يَرْتَدَّ إِلَيْكَ",51],["27:42:12",380,"قَبْلِهَا","before her","وَأُوتِينَا ٱلْعِلْمَ مِن","وَكُنَّا مُسْلِمِينَ",51],["27:46:6",381,"قَبْلَ","before","لِمَ تَسْتَعْجِلُونَ بِٱلسَّيِّئَةِ","ٱلْحَسَنَةِ ۖ لَوْلَا تَ