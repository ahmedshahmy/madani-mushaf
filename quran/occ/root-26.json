1],["33:38:17",423,"قَبْلُ ۚ","before","ٱلَّذِينَ خَلَوْا۟ مِن","وَكَانَ أَمْرُ ٱللَّهِ",51],["33:49:10",424,"قَبْلِ","before","ثُمَّ طَلَّقْتُمُوهُنَّ مِن","أَن تَمَسُّوهُنَّ فَمَا",51],["33:62:7",426,"قَبْلُ ۖ","before","ٱلَّذِينَ خَلَوْا۟ مِن","وَلَن تَجِدَ لِسُنَّةِ",51],["34:44:9",433,"قَبْلَكَ","before you","وَمَآ أَرْسَلْنَآ إِلَيْهِمْ","مِن نَّذِيرٍۢ",51],["34:45:4",433,"قَبْلِهِمْ","(were) before them","وَكَذَّبَ ٱلَّذِينَ مِن","وَمَا بَلَغُوا۟ مِعْشَارَ",51],["34:53:5",434,"قَبْلُ ۖ","before","كَفَرُوا۟ بِهِۦ مِن","وَيَقْذِفُونَ بِٱلْغَيْبِ مِن",51],["34:54:10",434,"قَبْلُ ۚ","before","فُعِلَ بِأَشْيَاعِهِم مِّن","إِنَّهُمْ كَانُوا۟ فِى",51],["35:4:7",435,"قَبْلِكَ ۚ","before you","كُذِّبَتْ رُسُلٌۭ مِّن","وَإِلَى ٱللَّهِ تُرْجَعُ",51],["35:25:7",437,"قَبْلِهِمْ","(were) before them","كَذَّبَ ٱلَّذِينَ مِن","جَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَـٰتِ",51],["35:44:11",439,"قَبْلِهِمْ","(were) before them","عَـٰقِبَةُ ٱلَّذِينَ مِن","وَكَانُوٓا۟ أَشَدَّ مِنْهُمْ",51],["36:31:5",442,"قَبْلَهُم","before them","يَرَوْا۟ كَمْ أَهْلَكْنَا","مِّنَ ٱلْقُرُونِ أَنَّهُمْ",51],["37:27:1",447,"وَأَقْبَلَ","And will approach","","بَعْضُهُمْ عَلَىٰ بَعْضٍۢ",876],["37:44:3",447,"مُّتَقَـٰبِلِينَ","facing each other","عَلَىٰ سُرُرٍۢ","",1607],["37:50:1",447,"فَأَقْبَلَ","And (will) approach","","بَعْضُهُمْ عَلَىٰ بَعْضٍۢ",876],["37:71:3",448,"قَبْلَهُمْ","before them","وَلَقَدْ ضَلَّ","أَكْثَرُ ٱلْأَوَّلِينَ",51],["37:94:1",449,"فَأَقْبَلُوٓا۟","Then they advanced","","إِلَيْهِ يَزِفُّونَ",876],["38:3:4",453,"قَبْلِهِم","before them","كَمْ أَهْلَكْنَا مِن","مِّن قَرْنٍۢ فَنَادَوا۟",51],["38:12:2",453,"قَبْلَهُمْ","before them","كَذَّبَتْ","قَوْمُ نُوحٍۢ وَعَادٌۭ",51],["38:16:6",453,"قَبْلَ","before","عَجِّل لَّنَا قِطَّنَا","يَوْمِ ٱلْحِسَابِ",51],["39:8:20",459,"قَبْلُ","before","يَدْعُوٓا۟ إِلَيْهِ مِن","وَجَعَلَ لِلَّهِ أَندَادًۭا",51],["39:25:4",461,"قَبْلِهِمْ","(were) before them","كَذَّبَ ٱلَّذِينَ مِن","فَأَتَىٰهُمُ ٱلْعَذَابُ مِنْ",51],["39:50:5",464,"قَبْلِهِمْ","before them","قَالَهَا ٱلَّذِينَ مِن","فَمَآ أَغْنَىٰ عَنْهُم",51],["39:54:7",464,"قَبْلِ","before","وَأَسْلِمُوا۟ لَهُۥ مِن","أَن يَأْتِيَكُمُ ٱلْعَذَابُ",51],["39:55:9",464,"قَبْلِ","before","مِّن رَّبِّكُم مِّن","أَن يَأْتِيَكُمُ ٱلْعَذَابُ",51],["39:65:7",465,"قَبْلِكَ","(were) before you","وَإِلَى ٱلَّذِينَ مِن","لَئِنْ أَشْرَكْتَ لَيَحْبَطَنَّ",51],["40:3:3",467,"وَقَابِلِ","and (the) Acceptor","غَافِرِ ٱلذَّنۢبِ","ٱلتَّوْبِ شَدِيدِ ٱلْعِقَابِ",4107],["40:5:2",467,"قَبْلَهُمْ","before them","كَذَّبَتْ","قَوْمُ نُوحٍۢ وَٱلْأَحْزَابُ",51],["40:21:12",469,"قَبْلِهِمْ ۚ","before them","ٱلَّذِينَ كَانُوا۟ مِن","كَانُوا۟ هُمْ أَشَدَّ",51],["40:34:5",471,"قَبْلُ","before","جَآءَكُمْ يُوسُفُ مِن","بِٱلْبَيِّنَـٰتِ فَمَا زِلْتُمْ",51],["40:67:25",475,"قَبْلُ ۖ","before","مَّن يُتَوَفَّىٰ مِن","وَلِتَبْلُغُوٓا۟ أَجَلًۭا مُّسَمًّۭى",51],["40:74:12",475,"قَبْلُ","before","نَكُن نَّدْعُوا۟ مِن","شَيْـًۭٔا ۚ كَذَٰلِكَ يُضِلُّ",51],["40:78:5",476,"قَبْلِكَ","before you","أَرْسَلْنَا رُسُلًۭا مِّن","مِنْهُم مَّن قَصَصْنَا",51],["40:82:11",476,"قَبْلِهِمْ ۚ","(were) before them","عَـٰقِبَةُ ٱلَّذِينَ مِن","كَانُوٓا۟ أَكْثَرَ مِنْهُمْ",51],["41:25:19",479,"قَبْلِهِم","before them","قَدْ خَلَتْ مِن","مِّنَ ٱلْجِنِّ وَٱلْإِنسِ ۖ",51],["41:43:10",481,"قَبْلِكَ ۚ","before you","قِيلَ لِلرُّسُلِ مِن","إِنَّ رَبَّكَ لَذُو",51],["41:48:7",482,"قَبْلُ ۖ","before","كَانُوا۟ يَدْعُونَ مِن","وَظَنُّوا۟ مَا لَهُم",51],["42:3:7",483,"قَبْلِكَ","before you","وَإِلَى ٱلَّذِينَ مِن","ٱللَّهُ ٱلْعَزِيزُ ٱلْحَكِيمُ",51],["42:25:3",486,"يَقْبَلُ","accepts","وَهُوَ ٱلَّذِى","ٱلتَّوْبَةَ عَنْ عِبَادِهِۦ",937],["42:47:4",488,"قَبْلِ","before","ٱسْتَجِيبُوا۟ لِرَبِّكُم مِّن","أَن يَأْتِىَ يَوْمٌۭ",51],["43:21:5",490,"قَبْلِهِۦ","before it","ءَاتَيْنَـٰهُمْ كِتَـٰبًۭا مِّن","فَهُم بِهِۦ مُسْتَمْسِكُونَ",51],["43:23:5",491,"قَبْلِكَ","before you","مَآ أَرْسَلْنَا مِن","فِى قَرْيَةٍۢ مِّن",51],["43:45:5",492,"قَبْلِكَ","before you","مَنْ أَرْسَلْنَا مِن","مِن رُّسُلِنَآ أَجَعَلْنَا",51],["44:17:3",496,"قَبْلَهُمْ","before them","۞ وَلَقَدْ فَتَنَّا","قَوْمَ فِرْعَوْنَ وَجَآءَهُمْ",51],["44:37:8",497,"قَبْلِهِمْ ۚ","before them","تُبَّعٍۢ وَٱلَّذِينَ مِن","أَهْلَكْنَـٰهُمْ ۖ إِنَّهُمْ كَانُوا۟",51],["44:53:5",498,"مُّتَقَـٰبِلِينَ","facing each other","مِن سُندُسٍۢ وَإِسْتَبْرَقٍۢ","",1607],["46:4:21",502,"قَبْلِ","before","ٱئْتُونِى بِكِتَـٰبٍۢ مِّن","هَـٰذَآ أَوْ أَثَـٰرَةٍۢ",51],["46:12:2",503,"قَبْلِهِۦ","And before it","وَمِن","كِتَـٰبُ مُوسَىٰٓ إِمَامًۭا",51],["46:16:3",504,"نَتَقَبَّلُ","We will accept","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","عَنْهُمْ أَحْسَنَ مَا",861],["46:17:13",504,"قَبْلِى","before me","خَلَتِ ٱلْقُرُونُ مِن","وَهُمَا يَسْتَغِيثَانِ ٱللَّهَ",51],["46:18:11",504,"قَبْلِهِم","before them","قَدْ خَلَتْ مِن","مِّنَ ٱلْجِنِّ وَٱلْإِنسِ ۖ",51],["46:24:4",505,"مُّسْتَقْبِلَ","approaching","فَلَمَّا رَأَوْهُ عَارِضًۭا","أَوْدِيَتِهِمْ قَالُوا۟ هَـٰذَا",3994],["47:10:11",507,"قَبْلِهِمْ ۚ","before them","عَـٰقِبَةُ ٱلَّذِينَ مِن","دَمَّرَ ٱللَّهُ عَلَيْهِمْ ۖ",51],["48:15:22",512,"قَبْلُ ۖ","before","قَالَ ٱللَّهُ مِن","فَسَيَقُولُونَ بَلْ تَحْسُدُونَنَا ۚ",51],["48:16:25",513,"قَبْلُ","before","كَمَا تَوَلَّيْتُم مِّن","يُعَذِّبْكُمْ عَذَابًا أَلِيمًۭا",51],["48:23:7",513,"قَبْلُ ۖ","before","قَدْ خَلَتْ مِن","وَلَن تَجِدَ لِسُنَّةِ",51],["49:13:10",517,"وَقَبَآئِلَ","and tribes","وَأُنثَىٰ وَجَعَلْنَـٰكُمْ شُعُوبًۭا","لِتَعَارَفُوٓا۟ ۚ إِنَّ أَكْرَمَكُمْ",4118],["50:12:2",518,"قَبْلَهُمْ","before them","كَذَّبَتْ","قَوْمُ نُوحٍۢ وَأَصْحَـٰبُ",51],["50:36:3",520,"قَبْلَهُم","before them","وَكَمْ أَهْلَكْنَا","مِّن قَرْنٍ هُمْ",51],["50:39:8",520,"قَبْلَ","before","وَسَبِّحْ بِحَمْدِ رَبِّكَ","طُلُوعِ ٱلشَّمْسِ وَقَبْلَ",51],["50:39:11",520,"وَقَبْلَ","and before","قَبْلَ طُلُوعِ ٱلشَّمْسِ","ٱلْغُرُوبِ",51],["51:16:7",521,"قَبْلَ","before","رَبُّهُمْ ۚ إِنَّهُمْ كَانُوا۟","ذَٰلِكَ مُحْسِنِينَ",51],["51:29:1",521,"فَأَقْبَلَتِ","Then came forward","","ٱمْرَأَتُهُۥ فِى صَرَّةٍۢ",876],["51:46:4",522,"قَبْلُ ۖ","before","وَقَوْمَ نُوحٍۢ مِّن","إِنَّهُمْ كَانُوا۟ قَوْمًۭا",51],["51:52:6",523,"قَبْلِهِم","before them","أَتَى ٱلَّذِينَ مِن","مِّن رَّسُولٍ إِلَّا",51],["52:25:1",524,"وَأَقْبَلَ","And will approach","","بَعْضُهُمْ عَلَىٰ بَعْضٍۢ",876],["52:26:4",524,"قَبْلُ","before","قَالُوٓا۟ إِنَّا كُنَّا","فِىٓ أَهْلِنَا مُشْفِقِينَ",51],["52:28:4",524,"قَبْلُ","before","إِنَّا كُنَّا مِن","نَدْعُوهُ ۖ إِنَّهُۥ هُوَ",51],["53:52:4",528,"قَبْلُ ۖ","before","وَقَوْمَ نُوحٍۢ مِّن","إِنَّهُمْ كَانُوا۟ هُمْ",51],["54:9:2",529,"قَبْلَهُمْ","before them","۞ كَذَّبَتْ","قَوْمُ نُوحٍۢ فَكَذَّبُوا۟",51],["55:56:7",533,"قَبْلَهُمْ","before them","لَمْ يَطْمِثْهُنَّ إِنسٌۭ","وَلَا جَآنٌّۭ",51],["55:74:4",534,"قَبْلَهُمْ","before them","لَمْ يَطْمِثْهُنَّ إِنسٌۭ","وَلَا جَآنٌّۭ",51],["56:16:3",534,"مُتَقَـٰبِلِينَ","facing each other","مُّتَّكِـِٔينَ عَلَيْهَا","",1607],["56:45:3",535,"قَبْلَ","before","إِنَّهُمْ كَانُوا۟","ذَٰلِكَ مُتْرَفِينَ",51],["57:10:18",538,"قَبْلِ","before","مَّنْ أَنفَقَ مِن","ٱلْفَتْحِ وَقَـٰتَلَ ۚ أُو۟لَـٰٓئِكَ",51],["57:13:26",539,"قِبَلِهِ","facing towards [it]","ٱلرَّحْمَةُ وَظَـٰهِرُهُۥ مِن","ٱلْعَذَابُ",1622],["57:16:20",539,"قَبْلُ","before","أُوتُوا۟ ٱلْكِتَـٰبَ مِن","فَطَالَ عَلَيْهِمُ ٱلْأَمَدُ",51],["57:22:14",540,"قَبْلِ","before","فِى كِتَـٰبٍۢ مِّن","أَن نَّبْرَأَهَآ ۚ إِنَّ",51],["58:3:12",542,"قَبْلِ","before","فَتَحْرِيرُ رَقَبَةٍۢ مِّن","أَن يَتَمَآسَّا ۚ ذَٰلِكُمْ",51],["58:4:8",542,"قَبْلِ","before","شَهْرَيْنِ مُتَتَابِعَيْنِ مِن","أَن يَتَمَآسَّا ۖ فَمَن",51],["58:5:11",542,"قَبْلِهِمْ ۚ","before them","كُبِتَ ٱلَّذِينَ مِن","وَقَدْ أَنزَلْنَآ ءَايَـٰتٍۭ",51],["59:9:6",546,"قَبْلِهِمْ","before them","ٱلدَّارَ وَٱلْإِيمَـٰنَ مِن","يُحِبُّونَ مَنْ هَاجَرَ",51],["59:15:4",547,"قَبْلِهِمْ","before them","كَمَثَلِ ٱلَّذِينَ مِن","قَرِيبًۭا ۖ ذَاقُوا۟ وَبَالَ",51],["62:2:18",553,"قَبْلُ","before","وَإِن كَانُوا۟ مِن","لَفِى ضَلَـٰلٍۢ مُّبِينٍۢ",51],["63:10:6",555,"قَبْلِ","before","مَّا رَزَقْنَـٰكُم مِّن","أَن يَأْتِىَ أَحَدَكُمُ",51],["64:5:7",556,"قَبْلُ","before","ٱلَّذِينَ كَفَرُوا۟ مِن","فَذَاقُوا۟ وَبَالَ أَمْرِهِمْ",51],["67:18:5",563,"قَبْلِهِمْ","before them","كَذَّبَ ٱلَّذِينَ مِن","فَكَيْفَ كَانَ نَكِيرِ",51],["68:30:1",565,"فَأَقْبَلَ","Then approached","","بَعْضُهُمْ عَلَىٰ بَعْضٍۢ",876],["69:9:4",567,"قَبْلَهُۥ","before him","وَجَآءَ فِرْعَوْنُ وَمَن","وَٱلْمُؤْتَفِكَـٰتُ بِٱلْخَاطِئَةِ",51],["70:36:4",569,"قِبَلَكَ","before you","فَمَالِ ٱلَّذِينَ كَفَرُوا۟","مُهْطِعِينَ",1622],["71:1:10",570,"قَبْلِ","before","أَنذِرْ قَوْمَكَ مِن","أَن يَأْتِيَهُمْ عَذَابٌ",51]]