َ ذَٰلِكَ فَلَهُۥ",643],["5:107:22",125,"ٱعْتَدَيْنَآ","we have transgressed","مِن شَهَـٰدَتِهِمَا وَمَا","إِنَّآ إِذًۭا لَّمِنَ",643],["6:108:10",141,"عَدْوًۢا","(in) enmity","ٱللَّهِ فَيَسُبُّوا۟ ٱللَّهَ","بِغَيْرِ عِلْمٍۢ ۗ كَذَٰلِكَ",2234],["6:112:5",142,"عَدُوًّۭا","an enemy","جَعَلْنَا لِكُلِّ نَبِىٍّ","شَيَـٰطِينَ ٱلْإِنسِ وَٱلْجِنِّ",235],["6:119:30",143,"بِٱلْمُعْتَدِينَ","of the transgressors","رَبَّكَ هُوَ أَعْلَمُ","",1201],["6:142:15",146,"عَدُوٌّۭ","an enemy","ٱلشَّيْطَـٰنِ ۚ إِنَّهُۥ لَكُمْ","مُّبِينٌۭ",235],["6:145:35",147,"عَادٍۢ","transgressing","غَيْرَ بَاغٍۢ وَلَا","فَإِنَّ رَبَّكَ غَفُورٌۭ",1149],["7:22:27",152,"عَدُوٌّۭ","(is) an enemy","إِنَّ ٱلشَّيْطَـٰنَ لَكُمَا","مُّبِينٌۭ",235],["7:24:5",153,"عَدُوٌّۭ ۖ","(as) enemy","ٱهْبِطُوا۟ بَعْضُكُمْ لِبَعْضٍ","وَلَكُمْ فِى ٱلْأَرْضِ",235],["7:55:8",157,"ٱلْمُعْتَدِينَ","the transgressors","إِنَّهُۥ لَا يُحِبُّ","",1201],["7:129:16",165,"عَدُوَّكُمْ","your enemy","رَبُّكُمْ أَن يُهْلِكَ","وَيَسْتَخْلِفَكُمْ فِى ٱلْأَرْضِ",235],["7:150:34",169,"ٱلْأَعْدَآءَ","the enemies","فَلَا تُشْمِتْ بِىَ","وَلَا تَجْعَلْنِى مَعَ",235],["7:163:9",171,"يَعْدُونَ","they transgressed","حَاضِرَةَ ٱلْبَحْرِ إِذْ","فِى ٱلسَّبْتِ إِذْ",2049],["8:42:3",182,"بِٱلْعُدْوَةِ","on side of the valley","إِذْ أَنتُم","ٱلدُّنْيَا وَهُم بِٱلْعُدْوَةِ",2257],["8:42:6",182,"بِٱلْعُدْوَةِ","(were) on the side","بِٱلْعُدْوَةِ ٱلدُّنْيَا وَهُم","ٱلْقُصْوَىٰ وَٱلرَّكْبُ أَسْفَلَ",2257],["8:60:12",184,"عَدُوَّ","(the) enemy","ٱلْخَيْلِ تُرْهِبُونَ بِهِۦ","ٱللَّهِ وَعَدُوَّكُمْ وَءَاخَرِينَ",235],["8:60:14",184,"وَعَدُوَّكُمْ","and your enemy","بِهِۦ عَدُوَّ ٱللَّهِ","وَءَاخَرِينَ مِن دُونِهِمْ",235],["9:10:10",188,"ٱلْمُعْتَدُونَ","(are) the transgressors","ذِمَّةًۭ ۚ وَأُو۟لَـٰٓئِكَ هُمُ","",1201],["9:83:17",200,"عَدُوًّا ۖ","any enemy","وَلَن تُقَـٰتِلُوا۟ مَعِىَ","إِنَّكُمْ رَضِيتُم بِٱلْقُعُودِ",235],["9:114:15",205,"عَدُوٌّۭ","(was) an enemy","تَبَيَّنَ لَهُۥٓ أَنَّهُۥ","لِّلَّهِ تَبَرَّأَ مِنْهُ ۚ",235],["9:120:39",206,"عَدُوٍّۢ","an enemy","وَلَا يَنَالُونَ مِنْ","نَّيْلًا إِلَّا كُتِبَ",235],["10:74:22",217,"ٱلْمُعْتَدِينَ","(of) the transgressors","نَطْبَعُ عَلَىٰ قُلُوبِ","",1201],["10:90:9",219,"وَعَدْوًا ۖ","and enmity","فِرْعَوْنُ وَجُنُودُهُۥ بَغْيًۭا","حَتَّىٰٓ إِذَآ أَدْرَكَهُ",2234],["12:5:14",236,"عَدُوٌّۭ","an enemy","إِنَّ ٱلشَّيْطَـٰنَ لِلْإِنسَـٰنِ","مُّبِينٌۭ",235],["16:115:18",280,"عَادٍۢ","a transgressor","غَيْرَ بَاغٍۢ وَلَا","فَإِنَّ ٱللَّهَ غَفُورٌۭ",1149],["17:53:15",287,"عَدُوًّۭا","an enemy","ٱلشَّيْطَـٰنَ كَانَ لِلْإِنسَـٰنِ","مُّبِينًۭا",235],["18:28:12",297,"تَعْدُ","pass beyond","يُرِيدُونَ وَجْهَهُۥ ۖ وَلَا","عَيْنَاكَ عَنْهُمْ تُرِيدُ",2049],["18:50:23",299,"عَدُوٌّۢ ۚ","enemies","دُونِى وَهُمْ لَكُمْ","بِئْسَ لِلظَّـٰلِمِينَ بَدَلًۭا",235],["20:39:12",314,"عَدُوٌّۭ","an enemy","ٱلْيَمُّ بِٱلسَّاحِلِ يَأْخُذْهُ","لِّى وَعَدُوٌّۭ لَّهُۥ ۚ",235],["20:39:14",314,"وَعَدُوٌّۭ","and an enemy","يَأْخُذْهُ عَدُوٌّۭ لِّى","لَّهُۥ ۚ وَأَلْقَيْتُ عَلَيْكَ",235],["20:80:6",317,"عَدُوِّكُمْ","your enemy","قَدْ أَنجَيْنَـٰكُم مِّنْ","وَوَٰعَدْنَـٰكُمْ جَانِبَ ٱلطُّورِ",235],["20:117:5",320,"عَدُوٌّۭ","(is) an enemy","يَـٰٓـَٔادَمُ إِنَّ هَـٰذَا","لَّكَ وَلِزَوْجِكَ فَلَا",235],["20:123:7",320,"عَدُوٌّۭ ۖ","(as) enemy","جَمِيعًۢا ۖ بَعْضُكُمْ لِبَعْضٍ","فَإِمَّا يَأْتِيَنَّكُم مِّنِّى",235],["23:7:7",342,"ٱلْعَادُونَ","(are) the transgressors","ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ","",1149],["25:31:5",362,"عَدُوًّۭا","an enemy","جَعَلْنَا لِكُلِّ نَبِىٍّ","مِّنَ ٱلْمُجْرِمِينَ ۗ وَكَفَىٰ",235],["26:77:2",370,"عَدُوٌّۭ","(are) enemies","فَإِنَّهُمْ","لِّىٓ إِلَّا رَبَّ",235],["26:166:11",374,"عَادُونَ","transgressing","بَلْ أَنتُمْ قَوْمٌ","",1149],["28:8:6",386,"عَدُوًّۭا","an enemy","فِرْعَوْنَ لِيَكُونَ لَهُمْ","وَحَزَنًا ۗ إِنَّ فِرْعَوْنَ",235],["28:15:17",387,"عَدُوِّهِۦ ۖ","his enemy","شِيعَتِهِۦ وَهَـٰذَا مِنْ","فَٱسْتَغَـٰثَهُ ٱلَّذِى مِن",235],["28:15:25",387,"عَدُوِّهِۦ","his enemy","عَلَى ٱلَّذِى مِنْ","فَوَكَزَهُۥ مُوسَىٰ فَقَضَىٰ",235],["28:15:36",387,"عَدُوٌّۭ","(is) an enemy","عَمَلِ ٱلشَّيْطَـٰنِ ۖ إِنَّهُۥ","مُّضِلٌّۭ مُّبِينٌۭ",235],["28:19:8",387,"عَدُوٌّۭ","an enemy","يَبْطِشَ بِٱلَّذِى هُوَ","لَّهُمَا قَالَ يَـٰمُوسَىٰٓ",235],["28:28:9",388,"عُدْوَٰنَ","injustice","ٱلْأَجَلَيْنِ قَضَيْتُ فَلَا","عَلَىَّ ۖ وَٱللَّهُ عَلَىٰ",960],["35:6:4",435,"عَدُوٌّۭ","an enemy","إِنَّ ٱلشَّيْطَـٰنَ لَكُمْ","فَٱتَّخِذُوهُ عَدُوًّا ۚ إِنَّمَا",235],["35:6:6",435,"عَدُوًّا ۚ","(as) an enemy","لَكُمْ عَدُوٌّۭ فَٱتَّخِذُوهُ","إِنَّمَا يَدْعُوا۟ حِزْبَهُۥ",235],["36:60:12",444,"عَدُوٌّۭ","an enemy","ٱلشَّيْطَـٰنَ ۖ إِنَّهُۥ لَكُمْ","مُّبِينٌۭ",235],["41:19:3",478,"أَعْدَآءُ","(the) enemies","وَيَوْمَ يُحْشَرُ","ٱللَّهِ إِلَى ٱلنَّارِ",235],["41:28:3",479,"أَعْدَآءِ","(of the) enemies","ذَٰلِكَ جَزَآءُ","ٱللَّهِ ٱلنَّارُ ۖ لَهُمْ",235],["41:34:14",480,"عَدَٰوَةٌۭ","(was) enmity","ٱلَّذِى بَيْنَكَ وَبَيْنَهُۥ","كَأَنَّهُۥ وَلِىٌّ حَمِيمٌۭ",1151],["43:62:6",494,"عَدُوٌّۭ","an enemy","ٱلشَّيْطَـٰنُ ۖ إِنَّهُۥ لَكُمْ","مُّبِينٌۭ",235],["43:67:5",494,"عَدُوٌّ","(will be) enemies","يَوْمَئِذٍۭ بَعْضُهُمْ لِبَعْضٍ","إِلَّا ٱلْمُتَّقِينَ",235],["46:6:6",503,"أَعْدَآءًۭ","enemies","ٱلنَّاسُ كَانُوا۟ لَهُمْ","وَكَانُوا۟ بِعِبَادَتِهِمْ كَـٰفِرِينَ",235],["50:25:3",519,"مُعْتَدٍۢ","transgressor","مَّنَّاعٍۢ لِّلْخَيْرِ","مُّرِيبٍ",1902],["58:8:15",543,"وَٱلْعُدْوَٰنِ","and aggression","عَنْهُ وَيَتَنَـٰجَوْنَ بِٱلْإِثْمِ","وَمَعْصِيَتِ ٱلرَّسُولِ وَإِذَا",960],["58:9:9",543,"وَٱلْعُدْوَٰنِ","and aggression","فَلَا تَتَنَـٰجَوْا۟ بِٱلْإِثْمِ","وَمَعْصِيَتِ ٱلرَّسُولِ وَتَنَـٰجَوْا۟",960],["60:1:6",549,"عَدُوِّى","My enemies","ءَامَنُوا۟ لَا تَتَّخِذُوا۟","وَعَدُوَّكُمْ أَوْلِيَآءَ تُلْقُونَ",235],["60:1:7",549,"وَعَدُوَّكُمْ","and your enemies","لَا تَتَّخِذُوا۟ عَدُوِّى","أَوْلِيَآءَ تُلْقُونَ إِلَيْهِم",235],["60:2:5",549,"أَعْدَآءًۭ","enemies","يَثْقَفُوكُمْ يَكُونُوا۟ لَكُمْ","وَيَبْسُطُوٓا۟ إِلَيْكُمْ أَيْدِيَهُمْ",235],["60:4:26",549,"ٱلْعَدَٰوَةُ","enmity","وَبَدَا بَيْنَنَا وَبَيْنَكُمُ","وَٱلْبَغْضَآءُ أَبَدًا حَتَّىٰ",1151],["60:7:8",550,"عَادَيْتُم","you have been enemies","بَيْنَكُمْ وَبَيْنَ ٱلَّذِينَ","مِّنْهُم مَّوَدَّةًۭ ۚ وَٱللَّهُ",3094],["61:14:33",552,"عَدُوِّهِمْ","their enemy","ٱلَّذِينَ ءَامَنُوا۟ عَلَىٰ","فَأَصْبَحُوا۟ ظَـٰهِرِينَ",235],["63:4:17",554,"ٱلْعَدُوُّ","(are) the enemy","صَيْحَةٍ عَلَيْهِمْ ۚ هُمُ","فَٱحْذَرْهُمْ ۚ قَـٰتَلَهُمُ ٱللَّهُ ۖ",235],["64:14:8",557,"عَدُوًّۭا","(are) enemies","مِنْ أَزْوَٰجِكُمْ وَأَوْلَـٰدِكُمْ","لَّكُمْ فَٱحْذَرُوهُمْ ۚ وَإِن",235],["65:1:28",558,"يَتَعَدَّ","transgresses","حُدُودُ ٱللَّهِ ۚ وَمَن","حُدُودَ ٱللَّهِ فَقَدْ",2071],["68:12:3",564,"مُعْتَدٍ","transgressor","مَّنَّاعٍۢ لِّلْخَيْرِ","أَثِيمٍ",1902],["70:31:7",569,"ٱلْعَادُونَ","(are) the transgressors","ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ","",1149],["83:12:6",588,"مُعْتَدٍ","transgressor","بِهِۦٓ إِلَّا كُلُّ","أَثِيمٍ",1902],["100:1:1",599,"وَٱلْعَـٰدِيَـٰتِ","By the racers","","ضَبْحًۭا",3104]]