[["2:36:12",6,"عَدُوٌّۭ ۖ","(as) enemy","ٱهْبِطُوا۟ بَعْضُكُمْ لِبَعْضٍ","وَلَكُمْ فِى ٱلْأَرْضِ",235],["2:61:59",9,"يَعْتَدُونَ","transgressing","بِمَا عَصَوا۟ وَّكَانُوا۟","",643],["2:65:4",10,"ٱعْتَدَوْا۟","transgressed","وَلَقَدْ عَلِمْتُمُ ٱلَّذِينَ","مِنكُمْ فِى ٱلسَّبْتِ",643],["2:85:14",13,"وَٱلْعُدْوَٰنِ","and [the] transgression","تَظَـٰهَرُونَ عَلَيْهِم بِٱلْإِثْمِ","وَإِن يَأْتُوكُمْ أُسَـٰرَىٰ",960],["2:97:4",15,"عَدُوًّۭا","an enemy","قُلْ مَن كَانَ","لِّجِبْرِيلَ فَإِنَّهُۥ نَزَّلَهُۥ",235],["2:98:3",15,"عَدُوًّۭا","an enemy","مَن كَانَ","لِّلَّهِ وَمَلَـٰٓئِكَتِهِۦ وَرُسُلِهِۦ",235],["2:98:11",15,"عَدُوٌّۭ","(is) an enemy","وَمِيكَىٰلَ فَإِنَّ ٱللَّهَ","لِّلْكَـٰفِرِينَ",235],["2:168:15",25,"عَدُوٌّۭ","an enemy","ٱلشَّيْطَـٰنِ ۚ إِنَّهُۥ لَكُمْ","مُّبِينٌ",235],["2:173:18",26,"عَادٍۢ","transgressor","غَيْرَ بَاغٍۢ وَلَا","فَلَآ إِثْمَ عَلَيْهِ ۚ",1149],["2:178:32",27,"ٱعْتَدَىٰ","transgresses","رَّبِّكُمْ وَرَحْمَةٌۭ ۗ فَمَنِ","بَعْدَ ذَٰلِكَ فَلَهُۥ",643],["2:190:8",29,"تَعْتَدُوٓا۟ ۚ","transgress","ٱلَّذِينَ يُقَـٰتِلُونَكُمْ وَلَا","إِنَّ ٱللَّهَ لَا",643],["2:190:13",29,"ٱلْمُعْتَدِينَ","the transgressors","ٱللَّهَ لَا يُحِبُّ","",1201],["2:193:12",30,"عُدْوَٰنَ","hostility","فَإِنِ ٱنتَهَوْا۟ فَلَا","إِلَّا عَلَى ٱلظَّـٰلِمِينَ",960],["2:194:8",30,"ٱعْتَدَىٰ","transgressed","وَٱلْحُرُمَـٰتُ قِصَاصٌۭ ۚ فَمَنِ","عَلَيْكُمْ فَٱعْتَدُوا۟ عَلَيْهِ",643],["2:194:10",30,"فَٱعْتَدُوا۟","then you transgress","فَمَنِ ٱعْتَدَىٰ عَلَيْكُمْ","عَلَيْهِ بِمِثْلِ مَا",643],["2:194:14",30,"ٱعْتَدَىٰ","he transgressed","عَلَيْهِ بِمِثْلِ مَا","عَلَيْكُمْ ۚ وَٱتَّقُوا۟ ٱللَّهَ",643],["2:208:14",32,"عَدُوٌّۭ","an enemy","ٱلشَّيْطَـٰنِ ۚ إِنَّهُۥ لَكُمْ","مُّبِينٌۭ",235],["2:229:39",36,"تَعْتَدُوهَا ۚ","transgress them","حُدُودُ ٱللَّهِ فَلَا","وَمَن يَتَعَدَّ حُدُودَ",643],["2:229:41",36,"يَتَعَدَّ","transgresses","فَلَا تَعْتَدُوهَا ۚ وَمَن","حُدُودَ ٱللَّهِ فَأُو۟لَـٰٓئِكَ",2071],["2:231:14",37,"لِّتَعْتَدُوا۟ ۚ","so that you transgress","وَلَا تُمْسِكُوهُنَّ ضِ