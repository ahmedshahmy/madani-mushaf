[["2:60:9",9,"فَٱنفَجَرَتْ","Then gushed forth","ٱضْرِب بِّعَصَاكَ ٱلْحَجَرَ ۖ","مِنْهُ ٱثْنَتَا عَشْرَةَ",4816],["2:74:16",11,"يَتَفَجَّرُ","gush forth","مِنَ ٱلْحِجَارَةِ لَمَا","مِنْهُ ٱلْأَنْهَـٰرُ ۚ وَإِنَّ",4673],["2:187:42",29,"ٱلْفَجْرِ ۖ","[the] dawn","ٱلْخَيْطِ ٱلْأَسْوَدِ مِنَ","ثُمَّ أَتِمُّوا۟ ٱلصِّيَامَ",1175],["17:78:9",290,"ٱلْفَجْرِ ۖ","at dawn","غَسَقِ ٱلَّيْلِ وَقُرْءَانَ","إِنَّ قُرْءَانَ ٱلْفَجْرِ",1175],["17:78:12",290,"ٱلْفَجْرِ","(at) the dawn","ٱلْفَجْرِ ۖ إِنَّ قُرْءَانَ","كَانَ مَشْهُودًۭا",1175],["17:90:6",291,"تَفْجُرَ","you cause to gush forth","نُّؤْمِنَ لَكَ حَتَّىٰ","لَنَا مِنَ ٱلْأَرْضِ",2766],["17:91:8",291,"فَتُفَجِّرَ","and cause to gush forth","مِّن نَّخِيلٍۢ وَعِنَبٍۢ","ٱلْأَنْهَـٰرَ خِلَـٰلَهَا تَفْجِيرًا",1180],["17:91:11",291,"تَفْجِيرًا","abundantly","فَتُفَجِّرَ ٱلْأَنْهَـٰرَ خِلَـٰلَهَا","",2668],["18:33:9",297,"وَفَجَّرْنَا","And We caused to gush forth","تَظْلِم مِّنْهُ شَيْـًۭٔا ۚ","خِلَـٰلَهُمَا نَهَرًۭا",1180],["24:58:18",357,"ٱلْفَجْرِ","(of) dawn","مِّن قَبْلِ صَلَوٰةِ","وَحِينَ تَضَعُونَ ثِيَابَكُم",1175],["36:34:7",442,"وَفَجَّرْنَا","and We caused to gush forth","مِّن نَّخِيلٍۢ وَأَعْنَـٰبٍۢ","فِيهَا مِنَ ٱلْعُيُونِ",1180],["38:28:13",455,"كَٱلْفُجَّارِ","like the wicked","أَمْ نَجْعَلُ ٱلْمُتَّقِينَ","",1549],["54:12:1",529,"وَفَجَّرْنَا","And We caused to burst","","ٱلْأَرْضَ عُيُونًۭا فَٱلْتَقَى",1180],["71:27:9",571,"فَاجِرًۭا","a wicked","وَلَا يَلِدُوٓا۟ إِلَّا","كَفَّارًۭا",3394],["75:5:4",577,"لِيَفْجُرَ","to give (the) lie","بَلْ يُرِيدُ ٱلْإِنسَـٰنُ","أَمَامَهُۥ",2766],["76:6:6",579,"يُفَجِّرُونَهَا","causing it to gush forth","بِهَا عِبَادُ ٱللَّهِ","تَفْجِيرًۭا",1180],["76:6:7",579,"تَفْجِيرًۭا","abundantly","عِبَادُ ٱللَّهِ يُفَجِّرُونَهَا","",2668],["80:42:4",586,"ٱلْفَجَرَةُ","the wicked ones","أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ","",1549],["82:3:3",587,"فُجِّرَتْ","are made to gush forth","وَإِذَا ٱلْبِحَارُ","",1180],["82:14:2",587,"ٱلْفُجَّارَ","the wicked","وَإِنَّ","لَفِى جَحِيمٍۢ",1549],["83:7:4",588,"ٱلْفُجَّارِ","(of) the wicked","كَلَّآ إِنَّ كِتَـٰبَ","لَفِى سِجِّينٍۢ",1549],["89:1:1",593,"وَٱلْفَجْرِ","By the dawn","","",1175],["91:8:2",595,"فُجُورَهَا","(to distinguish) its wickedness","فَأَلْهَمَهَا","وَتَقْوَىٰهَا",3441],["97:5:5",598,"ٱلْفَجْرِ","(of) the dawn","هِىَ حَتَّىٰ مَطْلَعِ","",1175]]