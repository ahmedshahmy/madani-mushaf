[["9:5:14",187,"مَرْصَدٍۢ ۚ","place of ambush","وَٱقْعُدُوا۟ لَهُمْ كُلَّ","فَإِن تَابُوا۟ وَأَقَامُوا۟",3704],["9:107:9",204,"وَإِرْصَادًۭا","and (as) a station","وَتَفْرِيقًۢا بَيْنَ ٱلْمُؤْمِنِينَ","لِّمَنْ حَارَبَ ٱللَّهَ",2938],["72:9:13",572,"رَّصَدًۭا","waiting","يَجِدْ لَهُۥ شِهَابًۭا","",2597],["72:27:13",573,"رَصَدًۭا","a guard","يَدَيْهِ وَمِنْ خَلْفِهِۦ","",2597],["78:21:4",582,"مِرْصَادًۭا","lying in wait","إِنَّ جَهَنَّمَ كَانَتْ","",2476],["89:14:3",593,"لَبِٱلْمِرْصَادِ","(is) surely Ever Watchful","إِنَّ رَبَّكَ","",2476]]