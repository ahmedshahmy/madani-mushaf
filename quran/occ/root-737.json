[["7:139:3",167,"مُتَبَّرٌۭ","destroyed","إِنَّ هَـٰٓؤُلَآءِ","مَّا هُمْ فِيهِ",3872],["17:7:20",282,"وَلِيُتَبِّرُوا۟","and to destroy","دَخَلُوهُ أَوَّلَ مَرَّةٍۢ","مَا عَلَوْا۟ تَتْبِيرًا",2664],["17:7:23",282,"تَتْبِيرًا","(with) destruction","وَلِيُتَبِّرُوا۟ مَا عَلَوْا۟","",2683],["25:39:6",363,"تَبَّرْنَا","We destroyed","لَهُ ٱلْأَمْثَـٰلَ ۖ وَكُلًّۭا","تَتْبِيرًۭا",2664],["25:39:7",363,"تَتْبِيرًۭا","(with) destruction","ٱلْأَمْثَـٰلَ ۖ وَكُلًّۭا تَبَّرْنَا","",2683],["71:28:15",571,"تَبَارًۢا","(in) destruction","تَزِدِ ٱلظَّـٰلِمِينَ إِلَّا","",4349]]