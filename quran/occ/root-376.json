[["2:83:14",12,"وَٱلْيَتَـٰمَىٰ","and [the] orphans","إِحْسَانًۭا وَذِى ٱلْقُرْبَىٰ","وَٱلْمَسَـٰكِينِ وَقُولُوا۟ لِلنَّاسِ",461],["2:177:25",27,"وَٱلْيَتَـٰمَىٰ","and the orphans","حُبِّهِۦ ذَوِى ٱلْقُرْبَىٰ","وَٱلْمَسَـٰكِينَ وَٱبْنَ ٱلسَّبِيلِ",461],["2:215:11",33,"وَٱلْيَتَـٰمَىٰ","and the orphans","خَيْرٍۢ فَلِلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَ","وَٱلْمَسَـٰكِينِ وَٱبْنِ ٱلسَّبِيلِ ۗ",461],["2:220:6",35,"ٱلْيَتَـٰمَىٰ ۖ","the orphans","وَٱلْـَٔاخِرَةِ ۗ وَيَسْـَٔلُونَكَ عَنِ","قُلْ إِصْلَاحٌۭ لَّهُمْ",461],["4:2:2",77,"ٱلْيَتَـٰمَىٰٓ","(to) the orphans","وَءَاتُوا۟","أَمْوَٰلَهُمْ ۖ وَلَا تَتَبَدَّلُوا۟",461],["4:3:6",77,"ٱلْيَتَـٰمَىٰ","the orphans","أَلَّا تُقْسِطُوا۟ فِى","فَٱنكِحُوا۟ مَا طَابَ",461],["4:6:2",77,"ٱلْيَتَـٰمَىٰ","the orphans","وَٱبْتَلُوا۟","حَتَّىٰٓ إِذَا بَلَغُوا۟",461],["4:8:6",78,"وَٱلْيَتَـٰمَىٰ","and the orphans","ٱلْقِسْمَةَ أُو۟لُوا۟ ٱلْقُرْبَىٰ","وَٱلْمَسَـٰكِينُ فَٱرْزُقُوهُم مِّنْهُ",461],["4:10:5",78,"ٱلْيَتَـٰمَىٰ","(of) the orphans","ٱلَّذِينَ يَأْكُلُونَ أَمْوَٰلَ","ظُلْمًا إِنَّمَا يَأْكُلُونَ",461],["4:36:11",84,"وَٱلْيَتَـٰمَىٰ","and the orphans","إِحْسَـٰنًۭا وَبِذِى ٱلْقُرْبَىٰ","وَٱلْمَسَـٰكِينِ وَٱلْجَارِ ذِى",461],["4:127:14",98,"يَتَـٰمَى","orphans","فِى ٱلْكِتَـٰبِ فِى","ٱلنِّسَآءِ ٱلَّـٰتِى لَا",461],["4:127:30",98,"لِلْيَتَـٰمَىٰ","for orphans","ٱلْوِلْدَٰنِ وَأَن تَقُومُوا۟","بِٱلْقِسْطِ ۚ وَمَا تَفْعَلُوا۟",461],["6:152:4",149,"ٱلْيَتِيمِ","(of) the orphans","وَلَا تَقْرَبُوا۟ مَالَ","إِلَّا بِٱلَّتِى هِىَ",461],["8:41:12",182,"وَٱلْيَتَـٰمَىٰ","and the orphans","وَلِلرَّسُولِ وَلِذِى ٱلْقُرْبَىٰ","وَٱلْمَسَـٰكِينِ وَٱبْنِ ٱلسَّبِيلِ",461],["17:34:4",285,"ٱلْيَتِيمِ","(of) the orphan","وَلَا تَقْرَبُوا۟ مَالَ","إِلَّا بِٱلَّتِى هِىَ",461],["18:82:5",302,"يَتِيمَيْنِ","for two orphan boys","ٱلْجِدَارُ فَكَانَ لِغُلَـٰمَيْنِ","فِى ٱلْمَدِينَةِ وَكَانَ",461],["59:7:13",546,"وَٱلْيَتَـٰمَىٰ","and the orphans","وَلِلرَّسُولِ وَلِذِى ٱلْقُرْبَىٰ","وَٱلْمَسَـٰكِينِ وَٱبْنِ ٱلسَّبِيلِ",461],["76:8:6",579,"وَيَتِيمًۭا","and (the) orphan","عَلَىٰ حُبِّهِۦ مِسْكِينًۭا","وَأَسِيرًا",461],["89:17:5",593,"ٱلْيَتِيمَ","the orphan","بَل لَّا تُكْرِمُونَ","",461],["90:15:1",594,"يَتِيمًۭا","An orphan","","ذَا مَقْرَبَةٍ",461],["93:6:3",596,"يَتِيمًۭا","an orphan","أَلَمْ يَجِدْكَ","فَـَٔاوَىٰ",461],["93:9:2",596,"ٱلْيَتِيمَ","the orphan","فَأَمَّا","فَلَا تَقْهَرْ",461],["107:2:4",602,"ٱلْيَتِيمَ","the orphan","فَذَٰلِكَ ٱلَّذِى يَدُعُّ","",461]]