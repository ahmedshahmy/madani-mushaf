[["2:46:2",7,"يَظُنُّونَ","believe","ٱلَّذِينَ","أَنَّهُم مُّلَـٰقُوا۟ رَبِّهِمْ",251],["2:78:11",12,"يَظُنُّونَ","guess","وَإِنْ هُمْ إِلَّا","",251],["2:230:20",36,"ظَنَّآ","they believe","أَن يَتَرَاجَعَآ إِن","أَن يُقِيمَا حُدُودَ",251],["2:249:45",41,"يَظُنُّونَ","were certain","وَجُنُودِهِۦ ۚ قَالَ ٱلَّذِينَ","أَنَّهُم مُّلَـٰقُوا۟ ٱللَّهِ",251],["3:154:16",70,"يَظُنُّونَ","thinking","قَدْ أَهَمَّتْهُمْ أَنفُسُهُمْ","بِٱللَّهِ غَيْرَ ٱلْحَقِّ",251],["3:154:20",70,"ظَنَّ","(the) thought","بِٱللَّهِ غَيْرَ ٱلْحَقِّ","ٱلْجَـٰهِلِيَّةِ ۖ يَقُولُونَ هَل",488],["4:157:31",103,"ٱلظَّنِّ ۚ","(of) assumption","عِلْمٍ إِلَّا ٱتِّبَاعَ","وَمَا قَتَلُوهُ يَقِينًۢا",488],["6:116:14",142,"ٱلظَّنَّ","[the] assumption","إِن يَتَّبِعُونَ إِلَّا","وَإِنْ هُمْ إِلَّا",488],["6:148:33",148,"ٱلظَّنَّ","the assumption","إِن تَتَّبِعُونَ إِلَّا","وَإِنْ أَنتُمْ إِلَّا",488],["7:66:12",158,"لَنَظُنُّكَ","[we] think you","فِى سَفَاهَةٍۢ وَإِنَّا","مِنَ ٱلْكَـٰذِبِينَ",251],["7:171:7",173,"وَظَنُّوٓا۟","and they thought","فَوْقَهُمْ كَأَنَّهُۥ ظُلَّةٌۭ","أَنَّهُۥ وَاقِعٌۢ بِهِمْ",251],["9:118:15",206,"وَظَنُّوٓا۟","and they were certain","وَضَاقَتْ عَلَيْهِمْ أَنفُسُهُمْ","أَن لَّا مَلْجَأَ",251],["10:22:26",211,"وَظَنُّوٓا۟","and they assume","مِن كُلِّ مَكَانٍۢ","أَنَّهُمْ أُحِيطَ بِهِمْ ۙ",251],["10:24:23",211,"وَظَنَّ","and think","ٱلْأَرْضُ زُخْرُفَهَا وَٱزَّيَّنَتْ","أَهْلُهَآ أَنَّهُمْ قَـٰدِرُونَ",251],["10:36:5",213,"ظَنًّا ۚ","assumption","يَتَّبِعُ أَكْثَرُهُمْ إِلَّا","إِنَّ ٱلظَّنَّ لَا",488],["10:36:7",213,"ٱلظَّنَّ","the assumption","إِلَّا ظَنًّا ۚ إِنَّ","لَا يُغْنِى مِنَ",488],["10:60:2",215,"ظَنُّ","(will be the) assumption","وَمَا","ٱلَّذِينَ يَفْتَرُونَ عَلَى",488],["10:66:21",216,"ٱلظَّنَّ","the assumption","إِن يَتَّبِعُونَ إِلَّا","وَإِنْ هُمْ إِلَّا",488],["11:27:28",224,"نَظُنُّكُمْ","we think you","مِن فَضْلٍۭ بَلْ","كَـٰذِبِينَ",251],["12:42:3",240,"ظَنَّ","he thought","وَقَالَ لِلَّذِى","أَنَّهُۥ نَاجٍۢ مِّنْهُمَا",251],["12:110:5",248,"وَظَنُّوٓا۟","and thought","إِذَا ٱسْتَيْـَٔسَ ٱلرُّسُلُ","أَنَّهُمْ قَدْ كُذِبُوا۟",251],["17:52:5",287,"وَتَظُنُّونَ","and you will think","يَدْعُوكُمْ فَتَسْتَجِيبُونَ بِحَمْدِهِۦ","إِن لَّبِثْتُمْ إِلَّا",251],["17:101:16",292,"لَأَظُنُّكَ","[I] think you","لَهُۥ فِرْعَوْنُ إِنِّى","يَـٰمُوسَىٰ مَسْحُورًۭا",251],["17:102:13",292,"لَأَظُنُّكَ","[I] surely think you","وَٱلْأَرْضِ بَصَآئِرَ وَإِنِّى","يَـٰفِرْعَوْنُ مَثْبُورًۭا",251],["18:35:8",298,"أَظُنُّ","I think","لِّنَفْسِهِۦ قَالَ مَآ","أَن تَبِيدَ هَـٰذِهِۦٓ",251],["18:36:2",298,"أَظُنُّ","I think","وَمَآ","ٱلسَّاعَةَ قَآئِمَةًۭ وَلَئِن",251],["18:53:4",299,"فَظَنُّوٓا۟","and they (will be) certain","وَرَءَا ٱلْمُجْرِمُونَ ٱلنَّارَ","أَنَّهُم مُّوَاقِعُوهَا وَلَمْ",251],["21:87:6",329,"فَظَنَّ","and thought","إِذ ذَّهَبَ مُغَـٰضِبًۭا","أَن لَّن نَّقْدِرَ",251],["22:15:3",333,"يَظُنُّ","thinks","مَن كَانَ","أَن لَّن يَنصُرَهُ",251],["24:12:4",351,"ظَنَّ","think","لَّوْلَآ إِذْ سَمِعْتُمُوهُ","ٱلْمُؤْمِنُونَ وَٱلْمُؤْمِنَـٰتُ بِأَنفُسِهِمْ",251],["26:186:7",375,"نَّظُنُّكَ","we think you","بَشَرٌۭ مِّثْلُنَا وَإِن","لَمِنَ ٱلْكَـٰذِبِينَ",251],["28:38:25",390,"لَأَظُنُّهُۥ","[I] think that he","إِلَـٰهِ مُوسَىٰ وَإِنِّى","مِنَ ٱلْكَـٰذِبِينَ",251],["28:39:8",390,"وَظَنُّوٓا۟","and they thought","ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّ","أَنَّهُمْ إِلَيْنَا لَا",251],["33:10:14",419,"وَتَظُنُّونَ","and you assumed","وَبَلَغَتِ ٱلْقُلُوبُ ٱلْحَنَاجِرَ","بِٱللَّهِ ٱلظُّنُونَا۠",251],["33:10:16",419,"ٱلظُّنُونَا۠","the assumptions","ٱلْحَنَاجِرَ وَتَظُنُّونَ بِٱللَّهِ","",488],["34:20:5",430,"ظَنَّهُۥ","his assumption","صَدَّقَ عَلَيْهِمْ إِبْلِيسُ","فَٱتَّبَعُوهُ إِلَّا فَرِيقًۭا",488],["37:87:2",449,"ظَنُّكُم","(do) you think","فَمَا","بِرَبِّ ٱلْعَـٰلَمِينَ",488],["38:24:24",454,"وَظَنَّ","And became certain","وَقَلِيلٌۭ مَّا هُمْ ۗ","دَاوُۥدُ أَنَّمَا فَتَنَّـٰهُ",251],["38:27:9",455,"ظَنُّ","(is the) assumption","بَيْنَهُمَا بَـٰطِلًۭا ۚ ذَٰلِكَ","ٱلَّذِينَ كَفَرُوا۟ ۚ فَوَيْلٌۭ",488],["40:37:8",471,"لَأَظُنُّهُۥ","[I] surely think him","إِلَـٰهِ مُوسَىٰ وَإِنِّى","كَـٰذِبًۭا ۚ وَكَذَٰلِكَ زُيِّنَ",251],["41:22:13",479,"ظَنَنتُمْ","you assumed","وَلَا جُلُودُكُمْ وَلَـٰكِن","أَنَّ ٱللَّهَ لَا",251],["41:23:2",479,"ظَنُّكُمُ","(was) your assumption","وَذَٰلِكُمْ","ٱلَّذِى ظَنَنتُم بِرَبِّكُمْ",488],["41:23:4",479,"ظَنَنتُم","you assumed","وَذَٰلِكُمْ ظَنُّكُمُ ٱلَّذِى","بِرَبِّكُمْ أَرْدَىٰكُمْ فَأَصْبَحْتُم",251],["41:48:8",482,"وَظَنُّوا۟","and they (will) be certain","يَدْعُونَ مِن قَبْلُ ۖ","مَا لَهُم مِّن",251],["41:50:13",482,"أَظُنُّ","I think","هَـٰذَا لِى وَمَآ","ٱلسَّاعَةَ قَآئِمَةًۭ وَلَئِن",251],["45:24:21",501,"يَظُنُّونَ","guess","إِنْ هُمْ إِلَّا","",251],["45:32:17",501,"نَّظُنُّ","we think","مَا ٱلسَّاعَةُ إِن","إِلَّا ظَنًّۭا وَمَا",251],["45:32:19",501,"ظَنًّۭا","an assumption","إِن نَّظُنُّ إِلَّا","وَمَا نَحْنُ بِمُسْتَيْقِنِينَ",488],["48:6:6",511,"ٱلظَّآنِّينَ","who assume","وَٱلْمُنَـٰفِقَـٰتِ وَٱلْمُشْرِكِينَ وَٱلْمُشْرِكَـٰتِ","بِٱللَّهِ ظَنَّ ٱلسَّوْءِ ۚ",3308],["48:6:8",511,"ظَنَّ","an assumption","وَٱلْمُشْرِكَـٰتِ ٱلظَّآنِّينَ بِٱللَّهِ","ٱلسَّوْءِ ۚ عَلَيْهِمْ دَآئِرَةُ",488],["48:12:2",512,"ظَنَنتُمْ","you thought","بَلْ","أَن لَّن يَنقَلِبَ",251],["48:12:15",512,"وَظَنَنتُمْ","And you assumed","ذَٰلِكَ فِى قُلُوبِكُمْ","ظَنَّ ٱلسَّوْءِ وَكُنتُمْ",251],["48:12:16",512,"ظَنَّ","an assumption","فِى قُلُوبِكُمْ وَظَنَنتُمْ","ٱلسَّوْءِ وَكُنتُمْ قَوْمًۢا",488],["49:12:7",517,"ٱلظَّنِّ","the assumption","ٱجْتَنِبُوا۟ كَثِيرًۭا مِّنَ","إِنَّ بَعْضَ ٱلظَّنِّ",488],["49:12:10",517,"ٱلظَّنِّ","assumption","ٱلظَّنِّ إِنَّ بَعْضَ","إِثْمٌۭ ۖ وَلَا تَجَسَّسُوا۟",488],["53:23:17",526,"ٱلظَّنَّ","assumption","إِن يَتَّبِعُونَ إِلَّا","وَمَا تَهْوَى ٱلْأَنفُسُ ۖ",488],["53:28:9",527,"ٱلظَّنَّ ۖ","assumption","إِن يَتَّبِعُونَ إِلَّا","وَإِنَّ ٱلظَّنَّ لَا",488],["53:28:11",527,"ٱلظَّنَّ","the assumption","إِلَّا ٱلظَّنَّ ۖ وَإِنَّ","لَا يُغْنِى مِنَ",488],["59:2:14",545,"ظَنَنتُمْ","you think","لِأَوَّلِ ٱلْحَشْرِ ۚ مَا","أَن يَخْرُجُوا۟ ۖ وَظَنُّوٓا۟",251],["59:2:17",545,"وَظَنُّوٓا۟","and they thought","ظَنَنتُمْ أَن يَخْرُجُوا۟ ۖ","أَنَّهُم مَّانِعَتُهُمْ حُصُونُهُم",251],["69:20:2",567,"ظَنَنتُ","was certain","إِنِّى","أَنِّى مُلَـٰقٍ حِسَابِيَهْ",251],["72:5:2",572,"ظَنَنَّآ","thought","وَأَنَّا","أَن لَّن تَقُولَ",251],["72:7:2",572,"ظَنُّوا۟","thought","وَأَنَّهُمْ","كَمَا ظَنَنتُمْ أَن",251],["72:7:4",572,"ظَنَنتُمْ","you thought","وَأَنَّهُمْ ظَنُّوا۟ كَمَا","أَن لَّن يَبْعَثَ",251],["72:12:2",572,"ظَنَنَّآ","[we] have become certain","وَأَنَّا","أَن لَّن نُّعْجِزَ",251],["75:25:1",578,"تَظُنُّ","Thinking","","أَن يُفْعَلَ بِهَا",251],["75:28:1",578,"وَظَنَّ","And he is certain","","أَنَّهُ ٱلْفِرَاقُ",251],["83:4:2",587,"يَظُنُّ","think","أَلَا","أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ",251],["84:14:2",589,"ظَنَّ","(had) thought","إِنَّهُۥ","أَن لَّن يَحُورَ",251]]