[["2:125:20",19,"وَٱلْعَـٰكِفِينَ","and those who seclude themselves for devotion and prayer","طَهِّرَا بَيْتِىَ لِلطَّآئِفِينَ","وَٱلرُّكَّعِ ٱلسُّجُودِ",1046],["2:187:51",29,"عَـٰكِفُونَ","(are) secluded","وَلَا تُبَـٰشِرُوهُنَّ وَأَنتُمْ","فِى ٱلْمَسَـٰجِدِ ۗ تِلْكَ",1046],["7:138:8",167,"يَعْكُفُونَ","devoted","فَأَتَوْا۟ عَلَىٰ قَوْمٍۢ","عَلَىٰٓ أَصْنَامٍۢ لَّهُمْ ۚ",4606],["20:91:5",318,"عَـٰكِفِينَ","being devoted to it","لَن نَّبْرَحَ عَلَيْهِ","حَتَّىٰ يَرْجِعَ إِلَيْنَا",1046],["20:97:22",318,"عَاكِفًۭا ۖ","devoted","ٱلَّذِى ظَلْتَ عَلَيْهِ","لَّنُحَرِّقَنَّهُۥ ثُمَّ لَنَنسِفَنَّهُۥ",1046],["21:52:11",326,"عَـٰكِفُونَ","(are) devoted","ٱلَّتِىٓ أَنتُمْ لَهَا","",1046],["22:25:14",335,"ٱلْعَـٰكِفُ","(are) the resident","جَعَلْنَـٰهُ لِلنَّاسِ سَوَآءً","فِيهِ وَٱلْبَادِ ۚ وَمَن",1046],["26:71:6",370,"عَـٰكِفِينَ","devoted","أَصْنَامًۭا فَنَظَلُّ لَهَا","",1046],["48:25:9",514,"مَعْكُوفًا","(was) prevented","ٱلْمَسْجِدِ ٱلْحَرَامِ وَٱلْهَدْىَ","أَن يَبْلُغَ مَحِلَّهُۥ ۚ",3631]]