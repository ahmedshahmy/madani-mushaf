[["2:133:5",20,"حَضَرَ","came to","كُنتُمْ شُهَدَآءَ إِذْ","يَعْقُوبَ ٱلْمَوْتُ إِذْ",1050],["2:180:4",27,"حَضَرَ","approaches","كُتِبَ عَلَيْكُمْ إِذَا","أَحَدَكُمُ ٱلْمَوْتُ إِن",1050],["2:196:64",30,"حَاضِرِى","present","لَّمْ يَكُنْ أَهْلُهُۥ","ٱلْمَسْجِدِ ٱلْحَرَامِ ۚ وَٱتَّقُوا۟",3160],["2:282:100",48,"حَاضِرَةًۭ","present","أَن تَكُونَ تِجَـٰرَةً","تُدِيرُونَهَا بَيْنَكُمْ فَلَيْسَ",2265],["3:30:9",54,"مُّحْضَرًۭا","presented","عَمِلَتْ مِنْ خَيْرٍۢ","وَمَا عَمِلَتْ مِن",849],["4:8:2",78,"حَضَرَ","present","وَإِذَا","ٱلْقِسْمَةَ أُو۟لُوا۟ ٱلْقُرْبَىٰ",1050],["4:18:8",80,"حَضَرَ","approaches","ٱلسَّيِّـَٔاتِ حَتَّىٰٓ إِذَا","أَحَدَهُمُ ٱلْمَوْتُ قَالَ",1050],["4:128:18",99,"وَأُحْضِرَتِ","And are swayed","صُلْحًۭا ۚ وَٱلصُّلْحُ خَيْرٌۭ ۗ","ٱلْأَنفُسُ ٱلشُّحَّ ۚ وَإِن",1727],["5:106:7",125,"حَضَرَ","approaches","شَهَـٰدَةُ بَيْنِكُمْ إِذَا","أَحَدَكُمُ ٱلْمَوْتُ حِينَ",1050],["7:163:6",171,"حَاضِرَةَ","situated","ٱلْقَرْيَةِ ٱلَّتِى كَانَتْ","ٱلْبَحْرِ إِذْ يَعْدُونَ",2265],["18:49:23",299,"حَاضِرًۭا ۗ","presented","وَوَجَدُوا۟ مَا عَمِلُوا۟","وَلَا يَظْلِمُ رَبُّكَ",3159],["19:68:5",310,"لَنُحْضِرَنَّهُمْ","surely, We will bring them","لَنَحْشُرَنَّهُمْ وَٱلشَّيَـٰطِينَ ثُمَّ","حَوْلَ جَهَنَّمَ جِثِيًّۭا",1727],["23:98:5",348,"يَحْضُرُونِ","they be present with me","بِكَ رَبِّ أَن","",1050],["28:61:17",393,"ٱلْمُحْضَرِينَ","those presented","يَوْمَ ٱلْقِيَـٰمَةِ مِنَ","",849],["30:16:11",406,"مُحْضَرُونَ","(will be) brought forth","فَأُو۟لَـٰٓئِكَ فِى ٱلْعَذَابِ","",849],["34:38:9",432,"مُحْضَرُونَ","(will be) brought","أُو۟لَـٰٓئِكَ فِى ٱلْعَذَابِ","",849],["36:32:6",442,"مُحْضَرُونَ","(will be) brought","لَّمَّا جَمِيعٌۭ لَّدَيْنَا","",849],["36:53:10",443,"مُحْضَرُونَ","(will be) brought","هُمْ جَمِيعٌۭ لَّدَيْنَا","",849],["36:75:7",445,"مُّحْضَرُونَ","(who will) be brought","وَهُمْ لَهُمْ جُندٌۭ","",849],["37:57:6",448,"ٱلْمُحْضَرِينَ","those brought","رَبِّى لَكُنتُ مِنَ","",849],["37:127:3",451,"لَمُحْضَرُونَ","(will) surely be brought","فَكَذَّبُوهُ فَإِنَّهُمْ","",849],["37:158:10",452,"لَمُحْضَرُونَ","(will) surely be brought","عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ","",849],["46:29:10",506,"حَضَرُوهُ","they attended it","يَسْتَمِعُونَ ٱلْقُرْءَانَ فَلَمَّا","قَالُوٓا۟ أَنصِتُوا۟ ۖ فَلَمَّا",1050],["54:28:8",530,"مُّحْتَضَرٌۭ","attended","بَيْنَهُمْ ۖ كُلُّ شِرْبٍۢ","",3958],["81:14:4",586,"أَحْضَرَتْ","it has brought","عَلِمَتْ نَفْسٌۭ مَّآ","",1727]]