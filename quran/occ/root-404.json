[["5:57:10",117,"وَلَعِبًۭا","and fun","ٱتَّخَذُوا۟ دِينَكُمْ هُزُوًۭا","مِّنَ ٱلَّذِينَ أُوتُوا۟",981],["5:58:7",118,"وَلَعِبًۭا ۚ","and fun","ٱلصَّلَوٰةِ ٱتَّخَذُوهَا هُزُوًۭا","ذَٰلِكَ بِأَنَّهُمْ قَوْمٌۭ",981],["6:32:5",131,"لَعِبٌۭ","a play","ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا","وَلَهْوٌۭ ۖ وَلَلدَّارُ ٱلْـَٔاخِرَةُ",981],["6:70:5",136,"لَعِبًۭا","(as) a play","ٱلَّذِينَ ٱتَّخَذُوا۟ دِينَهُمْ","وَلَهْوًۭا وَغَرَّتْهُمُ ٱلْحَيَوٰةُ",981],["6:91:44",139,"يَلْعَبُونَ","playing","ذَرْهُمْ فِى خَوْضِهِمْ","",935],["7:51:5",156,"وَلَعِبًۭا","and play","ٱتَّخَذُوا۟ دِينَهُمْ لَهْوًۭا","وَغَرَّتْهُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا ۚ",981],["7:98:9",163,"يَلْعَبُونَ","(were) playing","بَأْسُنَا ضُحًۭى وَهُمْ","",935],["9:65:7",197,"وَنَلْعَبُ ۚ","and playing","إِنَّمَا كُنَّا نَخُوضُ","قُلْ أَبِٱللَّهِ وَءَايَـٰتِهِۦ",935],["12:12:5",236,"وَيَلْعَبْ","and play","مَعَنَا غَدًۭا يَرْتَعْ","وَإِنَّا لَهُۥ لَحَـٰفِظُونَ",935],["21:2:11",322,"يَلْعَبُونَ","(are at) play","إِلَّا ٱسْتَمَعُوهُ وَهُمْ","",935],["21:16:7",323,"لَـٰعِبِينَ","(for) playing","وَٱلْأَرْضَ وَمَا بَيْنَهُمَا","",1870],["21:55:7",326,"ٱللَّـٰعِبِينَ","those who play","أَمْ أَنتَ مِنَ","",1870],["29:64:7",404,"وَلَعِبٌۭ ۚ","and play","ٱلدُّنْيَآ إِلَّا لَهْوٌۭ","وَإِنَّ ٱلدَّارَ ٱلْـَٔاخِرَةَ",981],["43:83:3",495,"وَيَلْعَبُوا۟","and play","فَذَرْهُمْ يَخُوضُوا۟","حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ",935],["44:9:5",496,"يَلْعَبُونَ","playing","هُمْ فِى شَكٍّۢ","",935],["44:38:7",497,"لَـٰعِبِينَ","(in) play","وَٱلْأَرْضَ وَمَا بَيْنَهُمَا","",1870],["47:36:4",510,"لَعِبٌۭ","(is) play","إِنَّمَا ٱلْحَيَوٰةُ ٱلدُّنْيَا","وَلَهْوٌۭ ۚ وَإِن تُؤْمِنُوا۟",981],["52:12:5",523,"يَلْعَبُونَ","are playing","هُمْ فِى خَوْضٍۢ","",935],["57:20:5",540,"لَعِبٌۭ","(is) play","أَنَّمَا ٱلْحَيَوٰةُ ٱلدُّنْيَا","وَلَهْوٌۭ وَزِينَةٌۭ وَتَفَاخُرٌۢ",981],["70:42:3",570,"وَيَلْعَبُوا۟","and amuse themselves","فَذَرْهُمْ يَخُوضُوا۟","حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ",935]]