[["2:155:6",24,"وَنَقْصٍۢ","and loss","مِّنَ ٱلْخَوْفِ وَٱلْجُوعِ","مِّنَ ٱلْأَمْوَٰلِ وَٱلْأَنفُسِ",2558],["7:130:6",165,"وَنَقْصٍۢ","and a deficit","ءَالَ فِرْعَوْنَ بِٱلسِّنِينَ","مِّنَ ٱلثَّمَرَٰتِ لَعَلَّهُمْ",2558],["9:4:8",187,"يَنقُصُوكُمْ","they have failed you","ٱلْمُشْرِكِينَ ثُمَّ لَمْ","شَيْـًۭٔا وَلَمْ يُظَـٰهِرُوا۟",1117],["11:84:15",231,"تَنقُصُوا۟","decrease","إِلَـٰهٍ غَيْرُهُۥ ۖ وَلَا","ٱلْمِكْيَالَ وَٱلْمِيزَانَ ۚ إِنِّىٓ",1117],["11:109:20",234,"مَنقُوصٍۢ","being diminished","لَمُوَفُّوهُمْ نَصِيبَهُمْ غَيْرَ","",3689],["13:41:6",254,"نَنقُصُهَا","reducing it","أَنَّا نَأْتِى ٱلْأَرْضَ","مِنْ أَطْرَافِهَا ۚ وَٱللَّهُ",1117],["21:44:14",325,"نَنقُصُهَا","We reduce it","أَنَّا نَأْتِى ٱلْأَرْضَ","مِنْ أَطْرَافِهَآ ۚ أَفَهُمُ",1117],["35:11:24",435,"يُنقَصُ","is lessened","مِن مُّعَمَّرٍۢ وَلَا","مِنْ عُمُرِهِۦٓ إِلَّا",1117],["50:4:4",518,"تَنقُصُ","diminishes","قَدْ عَلِمْنَا مَا","ٱلْأَرْضُ مِنْهُمْ ۖ وَعِندَنَا",1117],["73:3:3",574,"ٱنقُصْ","lessen","نِّصْفَهُۥٓ أَوِ","مِنْهُ قَلِيلًا",1117]]