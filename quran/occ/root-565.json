[["2:267:15",45,"تَيَمَّمُوا۟","aim (at)","مِّنَ ٱلْأَرْضِ ۖ وَلَا","ٱلْخَبِيثَ مِنْهُ تُنفِقُونَ",2014],["4:43:38",85,"فَتَيَمَّمُوا۟","then do tayammum","فَلَمْ تَجِدُوا۟ مَآءًۭ","صَعِيدًۭا طَيِّبًۭا فَٱمْسَحُوا۟",2014],["5:6:40",108,"فَتَيَمَّمُوا۟","then do tayyammum","فَلَمْ تَجِدُوا۟ مَآءًۭ","صَعِيدًۭا طَيِّبًۭا فَٱمْسَحُوا۟",2014],["7:136:5",166,"ٱلْيَمِّ","the sea","مِنْهُمْ فَأَغْرَقْنَـٰهُمْ فِى","بِأَنَّهُمْ كَذَّبُوا۟ بِـَٔايَـٰتِنَا",1015],["20:39:7",314,"ٱلْيَمِّ","the river","ٱلتَّابُوتِ فَٱقْذِفِيهِ فِى","فَلْيُلْقِهِ ٱلْيَمُّ بِٱلسَّاحِلِ",1015],["20:39:9",314,"ٱلْيَمُّ","the river","فِى ٱلْيَمِّ فَلْيُلْقِهِ","بِٱلسَّاحِلِ يَأْخُذْهُ عَدُوٌّۭ",1015],["20:78:6",317,"ٱلْيَمِّ","the sea","بِجُنُودِهِۦ فَغَشِيَهُم مِّنَ","مَا غَشِيَهُمْ",1015],["20:97:27",318,"ٱلْيَمِّ","the sea","ثُمَّ لَنَنسِفَنَّهُۥ فِى","نَسْفًا",1015],["28:7:12",386,"ٱلْيَمِّ","the river","عَلَيْهِ فَأَلْقِيهِ فِى","وَلَا تَخَافِى وَلَا",1015],["28:40:5",390,"ٱلْيَمِّ ۖ","the sea","وَجُنُودَهُۥ فَنَبَذْنَـٰهُمْ فِى","فَٱنظُرْ كَيْفَ كَانَ",1015],["51:40:5",522,"ٱلْيَمِّ","the sea","وَجُنُودَهُۥ فَنَبَذْنَـٰهُمْ فِى","وَهُوَ مُلِيمٌۭ",1015]]