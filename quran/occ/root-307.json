[["2:260:21",44,"ٱلطَّيْرِ","the birds","فَخُذْ أَرْبَعَةًۭ مِّنَ","فَصُرْهُنَّ إِلَيْكَ ثُمَّ",525],["3:49:17",56,"ٱلطَّيْرِ","(of) the bird","مِّنَ ٱلطِّينِ كَهَيْـَٔةِ","فَأَنفُخُ فِيهِ فَيَكُونُ",525],["3:49:21",56,"طَيْرًۢا","a bird","فَأَنفُخُ فِيهِ فَيَكُونُ","بِإِذْنِ ٱللَّهِ ۖ وَأُبْرِئُ",525],["5:110:32",126,"ٱلطَّيْرِ","(of) the bird","مِنَ ٱلطِّينِ كَهَيْـَٔةِ","بِإِذْنِى فَتَنفُخُ فِيهَا",525],["5:110:37",126,"طَيْرًۢا","a bird","فَتَنفُخُ فِيهَا فَتَكُونُ","بِإِذْنِى ۖ وَتُبْرِئُ ٱلْأَكْمَهَ",525],["6:38:7",132,"طَـٰٓئِرٍۢ","a bird","فِى ٱلْأَرْضِ وَلَا","يَطِيرُ بِجَنَاحَيْهِ إِلَّآ",1314],["6:38:8",132,"يَطِيرُ","(that) flies","ٱلْأَرْضِ وَلَا طَـٰٓئِرٍۢ","بِجَنَاحَيْهِ إِلَّآ أُمَمٌ",4619],["7:131:10",166,"يَطَّيَّرُوا۟","they ascribe evil omens","وَإِن تُصِبْهُمْ سَيِّئَةٌۭ","بِمُوسَىٰ وَمَن مَّعَهُۥٓ ۗ",2100],["7:131:16",166,"طَـٰٓئِرُهُمْ","their evil omens","مَّعَهُۥٓ ۗ أَلَآ إِنَّمَا","عِندَ ٱللَّهِ وَلَـٰكِنَّ",1314],["12:36:20",239,"ٱلطَّيْرُ","the birds","رَأْسِى خُبْزًۭا تَأْكُلُ","مِنْهُ ۖ نَبِّئْنَا بِتَأْوِيلِهِۦٓ ۖ",525],["12:41:12",240,"ٱلطَّيْرُ","the birds","ٱلْـَٔاخَرُ فَيُصْلَبُ فَتَأْكُلُ","مِن رَّأْسِهِۦ ۚ قُضِىَ",525],["16:79:4",275,"ٱلطَّيْرِ","the birds","أَلَمْ يَرَوْا۟ إِلَى","مُسَخَّرَٰتٍۢ فِى جَوِّ",525],["17:13:4",283,"طَـٰٓئِرَهُۥ","his fate","وَكُلَّ إِنسَـٰنٍ أَلْزَمْنَـٰهُ","فِى عُنُقِهِۦ ۖ وَنُخْرِجُ",1314],["21:79:12",328,"وَٱلطَّيْرَ ۚ","and the birds","دَاوُۥدَ ٱلْجِبَالَ يُسَبِّحْنَ","وَكُنَّا فَـٰعِلِينَ",525],["22:31:14",336,"ٱلطَّيْرُ","the birds","مِنَ ٱلسَّمَآءِ فَتَخْطَفُهُ","أَوْ تَهْوِى بِهِ",525],["24:41:11",355,"وَٱلطَّيْرُ","and the birds","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","صَـٰٓفَّـٰتٍۢ ۖ كُلٌّۭ قَدْ",525],["27:16:9",378,"ٱلطَّيْرِ","(of) the birds","ٱلنَّاسُ عُلِّمْنَا مَنطِقَ","وَأُوتِينَا مِن كُلِّ",525],["27:17:7",378,"وَٱلطَّيْرِ","and the birds","مِنَ ٱلْجِنِّ وَٱلْإِنسِ","فَهُمْ يُوزَعُونَ",525],["27:20:2",378,"ٱلطَّيْرَ","the birds","وَتَفَقَّدَ","فَقَالَ مَا لِىَ",525],["27:47:2",381,"ٱطَّيَّرْنَا","We consider you a bad omen","قَالُوا۟","بِكَ وَبِمَن مَّعَكَ ۚ",2100],["27:47:7",381,"طَـٰٓئِرُكُمْ","Your bad omen","وَبِمَن مَّعَكَ ۚ قَالَ","عِندَ ٱللَّهِ ۖ بَلْ",1314],["34:10:9",429,"وَٱلطَّيْرَ ۖ","and the birds","يَـٰجِبَالُ أَوِّبِى مَعَهُۥ","وَأَلَنَّا لَهُ ٱلْحَدِيدَ",525],["36:18:3",441,"تَطَيَّرْنَا","[we] see an evil omen","قَالُوٓا۟ إِنَّا","بِكُمْ ۖ لَئِن لَّمْ",2100],["36:19:2",441,"طَـٰٓئِرُكُم","Your evil omen","قَالُوا۟","مَّعَكُمْ ۚ أَئِن ذُكِّرْتُم ۚ",1314],["38:19:1",454,"وَٱلطَّيْرَ","And the birds","","مَحْشُورَةًۭ ۖ كُلٌّۭ لَّهُۥٓ",525],["56:21:2",535,"طَيْرٍۢ","(of) fowls","وَلَحْمِ","مِّمَّا يَشْتَهُونَ",525],["67:19:4",563,"ٱلطَّيْرِ","the birds","أَوَلَمْ يَرَوْا۟ إِلَى","فَوْقَهُمْ صَـٰٓفَّـٰتٍۢ وَيَقْبِضْنَ ۚ",525],["76:7:7",579,"مُسْتَطِيرًۭا","widespread","يَوْمًۭا كَانَ شَرُّهُۥ","",3854],["105:3:3",601,"طَيْرًا","birds","وَأَرْسَلَ عَلَيْهِمْ","أَبَابِيلَ",525]]