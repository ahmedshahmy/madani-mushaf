[["3:33:5",54,"وَنُوحًۭا","and Nuh","ٱللَّهَ ٱصْطَفَىٰٓ ءَادَمَ","وَءَالَ إِبْرَٰهِيمَ وَءَالَ",272],["4:163:7",104,"نُوحٍۢ","Nuh","كَمَآ أَوْحَيْنَآ إِلَىٰ","وَٱلنَّبِيِّـۧنَ مِنۢ بَعْدِهِۦ ۚ",272],["6:84:7",138,"وَنُوحًا","And Nuh","وَيَعْقُوبَ ۚ كُلًّا هَدَيْنَا ۚ","هَدَيْنَا مِن قَبْلُ ۖ",272],["7:59:3",158,"نُوحًا","Nuh","لَقَدْ أَرْسَلْنَا","إِلَىٰ قَوْمِهِۦ فَقَالَ",272],["7:69:18",159,"نُوحٍۢ","(of) Nuh","مِنۢ بَعْدِ قَوْمِ","وَزَادَكُمْ فِى ٱلْخَلْقِ",272],["9:70:8",198,"نُوحٍۢ","(of) Nuh","مِن قَبْلِهِمْ قَوْمِ","وَعَادٍۢ وَثَمُودَ وَقَوْمِ",272],["10:71:4",217,"نُوحٍ","(of) Nuh","۞ وَٱتْلُ عَلَيْهِمْ نَبَأَ","إِذْ قَالَ لِقَوْمِهِۦ",272],["11:25:3",224,"نُوحًا","Nuh","وَلَقَدْ أَرْسَلْنَا","إِلَىٰ قَوْمِهِۦٓ إِنِّى",272],["11:32:2",225,"يَـٰنُوحُ","O Nuh","قَالُوا۟","قَدْ جَـٰدَلْتَنَا فَأَكْثَرْتَ",272],["11:36:3",225,"نُوحٍ","Nuh","وَأُوحِىَ إِلَىٰ","أَنَّهُۥ لَن يُؤْمِنَ",272],["11:42:8",226,"نُوحٌ","and Nuh called out","مَوْجٍۢ كَٱلْجِبَالِ وَنَادَىٰ","ٱبْنَهُۥ وَكَانَ فِى",272],["11:45:2",226,"نُوحٌۭ","And Nuh called","وَنَادَىٰ","رَّبَّهُۥ فَقَالَ رَبِّ",272],["11:46:2",227,"يَـٰنُوحُ","O Nuh","قَالَ","إِنَّهُۥ لَيْسَ مِنْ",272],["11:48:2",227,"يَـٰنُوحُ","O Nuh","قِيلَ","ٱهْبِطْ بِسَلَـٰمٍۢ مِّنَّا",272],["11:89:11",232,"نُوحٍ","(the) people of Nuh","مَآ أَصَابَ قَوْمَ","أَوْ قَوْمَ هُودٍ",272],["14:9:8",256,"نُوحٍۢ","of Nuh","مِن قَبْلِكُمْ قَوْمِ","وَعَادٍۢ وَثَمُودَ ۛ وَٱلَّذِينَ",272],["17:3:5",282,"نُوحٍ ۚ","Nuh","مَنْ حَمَلْنَا مَعَ","إِنَّهُۥ كَانَ عَبْدًۭا",272],["17:17:7",283,"نُوحٍۢ ۗ","Nuh","ٱلْقُرُونِ مِنۢ بَعْدِ","وَكَفَىٰ بِرَبِّكَ بِذُنُوبِ",272],["19:58:14",309,"نُوحٍۢ","Nuh","وَمِمَّنْ حَمَلْنَا مَعَ","وَمِن ذُرِّيَّةِ إِبْرَٰهِيمَ",272],["21:76:1",328,"وَنُوحًا","And Nuh","","إِذْ نَادَىٰ مِن",272],["22:42:7",337,"نُوحٍۢ","(of) Nuh","كَذَّبَتْ قَبْلَهُمْ قَوْمُ","وَعَادٌۭ وَثَمُودُ",272],["23:23:3",343,"نُوحًا","Nuh","وَلَقَدْ أَرْسَلْنَا","إِلَىٰ قَوْمِهِۦ فَقَالَ",272],["25:37:2",363,"نُوحٍۢ","(of) Nuh","وَقَوْمَ","لَّمَّا كَذَّبُوا۟ ٱلرُّسُلَ",272],["26:105:3",371,"نُوحٍ","(of) Nuh","كَذَّبَتْ قَوْمُ","ٱلْمُرْسَلِينَ",272],["26:106:5",371,"نُوحٌ","Nuh","قَالَ لَهُمْ أَخُوهُمْ","أَلَا تَتَّقُونَ",272],["26:116:5",372,"يَـٰنُوحُ","O Nuh","لَئِن لَّمْ تَنتَهِ","لَتَكُونَنَّ مِنَ ٱلْمَرْجُومِينَ",272],["29:14:3",397,"نُوحًا","Nuh","وَلَقَدْ أَرْسَلْنَا","إِلَىٰ قَوْمِهِۦ فَلَبِثَ",272],["33:7:8",419,"نُّوحٍۢ","Nuh","مِيثَـٰقَهُمْ وَمِنكَ وَمِن","وَإِبْرَٰهِيمَ وَمُوسَىٰ وَعِيسَى",272],["37:75:3",448,"نُوحٌۭ","Nuh","وَلَقَدْ نَادَىٰنَا","فَلَنِعْمَ ٱلْمُجِيبُونَ",272],["37:79:3",449,"نُوحٍۢ","Nuh","سَلَـٰمٌ عَلَىٰ","فِى ٱلْعَـٰلَمِينَ",272],["38:12:4",453,"نُوحٍۢ","(of) Nuh","كَذَّبَتْ قَبْلَهُمْ قَوْمُ","وَعَادٌۭ وَفِرْعَوْنُ ذُو",272],["40:5:4",467,"نُوحٍۢ","(of) Nuh","كَذَّبَتْ قَبْلَهُمْ قَوْمُ","وَٱلْأَحْزَابُ مِنۢ بَعْدِهِمْ ۖ",272],["40:31:4",470,"نُوحٍۢ","(of) Nuh","مِثْلَ دَأْبِ قَوْمِ","وَعَادٍۢ وَثَمُودَ وَٱلَّذِينَ",272],["42:13:8",484,"نُوحًۭا","Nuh","مَا وَصَّىٰ بِهِۦ","وَٱلَّذِىٓ أَوْحَيْنَآ إِلَيْكَ",272],["50:12:4",518,"نُوحٍۢ","(of) Nuh","كَذَّبَتْ قَبْلَهُمْ قَوْمُ","وَأَصْحَـٰبُ ٱلرَّسِّ وَثَمُودُ",272],["51:46:2",522,"نُوحٍۢ","(of) Nuh","وَقَوْمَ","مِّن قَبْلُ ۖ إِنَّهُمْ",272],["53:52:2",528,"نُوحٍۢ","(of) Nuh","وَقَوْمَ","مِّن قَبْلُ ۖ إِنَّهُمْ",272],["54:9:4",529,"نُوحٍۢ","(of) Nuh","۞ كَذَّبَتْ قَبْلَهُمْ قَوْمُ","فَكَذَّبُوا۟ عَبْدَنَا وَقَالُوا۟",272],["57:26:3",541,"نُوحًۭا","Nuh","وَلَقَدْ أَرْسَلْنَا","وَإِبْرَٰهِيمَ وَجَعَلْنَا فِى",272],["66:10:7",561,"نُوحٍۢ","(of) Nuh","لِّلَّذِينَ كَفَرُوا۟ ٱمْرَأَتَ","وَٱمْرَأَتَ لُوطٍۢ ۖ كَانَتَا",272],["71:1:3",570,"نُوحًا","Nuh","إِنَّآ أَرْسَلْنَا","إِلَىٰ قَوْمِهِۦٓ أَنْ",272],["71:21:2",571,"نُوحٌۭ","Nuh","قَالَ","رَّبِّ إِنَّهُمْ عَصَوْنِى",272],["71:26:2",571,"نُوحٌۭ","Nuh","وَقَالَ","رَّبِّ لَا تَذَرْ",272]]