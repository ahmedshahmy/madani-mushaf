[["6:31:10",131,"ٱلسَّاعَةُ","the Hour","حَتَّىٰٓ إِذَا جَآءَتْهُمُ","بَغْتَةًۭ قَالُوا۟ يَـٰحَسْرَتَنَا",250],["6:40:9",132,"ٱلسَّاعَةُ","the Hour","ٱللَّهِ أَوْ أَتَتْكُمُ","أَغَيْرَ ٱللَّهِ تَدْعُونَ",250],["7:34:9",154,"سَاعَةًۭ ۖ","an hour","أَجَلُهُمْ لَا يَسْتَأْخِرُونَ","وَلَا يَسْتَقْدِمُونَ",250],["7:187:3",174,"ٱلسَّاعَةِ","the Hour","يَسْـَٔلُونَكَ عَنِ","أَيَّانَ مُرْسَىٰهَا ۖ قُلْ",250],["9:117:11",205,"سَاعَةِ","(the) hour","ٱلَّذِينَ ٱتَّبَعُوهُ فِى","ٱلْعُسْرَةِ مِنۢ بَعْدِ",250],["10:45:7",214,"سَاعَةًۭ","an hour","لَّمْ يَلْبَثُوٓا۟ إِلَّا","مِّنَ ٱلنَّهَارِ يَتَعَارَفُونَ",250],["10:49:20",214,"سَاعَةًۭ ۖ","an hour","أَجَلُهُمْ فَلَا يَسْتَـْٔخِرُونَ","وَلَا يَسْتَقْدِمُونَ",250],["12:107:10",248,"ٱلسَّاعَةُ","the Hour","ٱللَّهِ أَوْ تَأْتِيَهُمُ","بَغْتَةًۭ وَهُمْ لَا",250],["15:85:10",266,"ٱلسَّاعَةَ","the Hour","إِلَّا بِٱلْحَقِّ ۗ وَإِنَّ","لَـَٔاتِيَةٌۭ ۖ فَٱصْفَحِ ٱلصَّفْحَ",250],["16:61:21",273,"سَاعَةًۭ ۖ","an hour","أَجَلُهُمْ لَا يَسْتَـْٔخِرُونَ","وَلَا يَسْتَقْدِمُونَ",250],["16:77:7",275,"ٱلسَّاعَةِ","(of) the Hour","وَٱلْأَرْضِ ۚ وَمَآ أَمْرُ","إِلَّا كَلَمْحِ ٱلْبَصَرِ",250],["18:21:10",296,"ٱلسَّاعَةَ","(about) the Hour","ٱللَّهِ حَقٌّۭ وَأَنَّ","لَا رَيْبَ فِيهَآ",250],["18:36:3",298,"ٱلسَّاعَةَ","the Hour","وَمَآ أَظُنُّ","قَآئِمَةًۭ وَلَئِن رُّدِدتُّ",250],["19:75:18",310,"ٱلسَّاعَةَ","the Hour","إِمَّا ٱلْعَذَابَ وَإِمَّا","فَسَيَعْلَمُونَ مَنْ هُوَ",250],["20:15:2",313,"ٱلسَّاعَةَ","the Hour","إِنَّ","ءَاتِيَةٌ أَكَادُ أُخْفِيهَا",250],["21:49:7",326,"ٱلسَّاعَةِ","the Hour","بِٱلْغَيْبِ وَهُم مِّنَ","مُشْفِقُونَ",250],["22:1:7",332,"ٱلسَّاعَةِ","(of) the Hour","رَبَّكُمْ ۚ إِنَّ زَلْزَلَةَ","شَىْءٌ عَظِيمٌۭ",250],["22:7:2",333,"ٱلسَّاعَةَ","the Hour","وَأَنَّ","ءَاتِيَةٌۭ لَّا رَيْبَ",250],["22:55:10",338,"ٱلسَّاعَةُ","the Hour","مِّنْهُ حَتَّىٰ تَأْتِيَهُمُ","بَغْتَةً أَوْ يَأْتِيَهُمْ",250],["25:11:3",360,"بِٱلسَّاعَةِ ۖ","the Hour","بَلْ كَذَّبُوا۟","وَأَعْتَدْنَا لِمَن كَذَّبَ",250],["25:11:7",360,"بِٱلسَّاعَةِ","the Hour","وَأَعْتَدْنَا لِمَن كَذَّبَ","سَعِيرًا",250],["30:12:3",405,"ٱلسَّاعَةُ","the Hour","وَيَوْمَ تَقُومُ","يُبْلِسُ ٱلْمُجْرِمُونَ",250],["30:14:3",405,"ٱلسَّاعَةُ","the Hour","وَيَوْمَ تَقُومُ","يَوْمَئِذٍۢ يَتَفَرَّقُونَ",250],["30:55:3",410,"ٱلسَّاعَةُ","the Hour","وَيَوْمَ تَقُومُ","يُقْسِمُ ٱلْمُجْرِمُونَ مَا",250],["30:55:9",410,"سَاعَةٍۢ ۚ","an hour","مَا لَبِثُوا۟ غَيْرَ","كَذَٰلِكَ كَانُوا۟ يُؤْفَكُونَ",250],["31:34:5",414,"ٱلسَّاعَةِ","(of) the Hour","ٱللَّهَ عِندَهُۥ عِلْمُ","وَيُنَزِّلُ ٱلْغَيْثَ وَيَعْلَمُ",250],["33:63:4",427,"ٱلسَّاعَةِ ۖ","the Hour","يَسْـَٔلُكَ ٱلنَّاسُ عَنِ","قُلْ إِنَّمَا عِلْمُهَا",250],["33:63:13",427,"ٱلسَّاعَةَ","the Hour","وَمَا يُدْرِيكَ لَعَلَّ","تَكُونُ قَرِيبًا",250],["34:3:6",428,"ٱلسَّاعَةُ ۖ","the Hour","كَفَرُوا۟ لَا تَأْتِينَا","قُلْ بَلَىٰ وَرَبِّى",250],["34:30:8",431,"سَاعَةًۭ","(for) an hour","لَّا تَسْتَـْٔخِرُونَ عَنْهُ","وَلَا تَسْتَقْدِمُونَ",250],["40:46:8",472,"ٱلسَّاعَةُ","the Hour","وَعَشِيًّۭا ۖ وَيَوْمَ تَقُومُ","أَدْخِلُوٓا۟ ءَالَ فِرْعَوْنَ",250],["40:59:2",474,"ٱلسَّاعَةَ","the Hour","إِنَّ","لَـَٔاتِيَةٌۭ لَّا رَيْبَ",250],["41:47:4",482,"ٱلسَّاعَةِ ۚ","(of) the Hour","۞ إِلَيْهِ يُرَدُّ عِلْمُ","وَمَا تَخْرُجُ مِن",250],["41:50:14",482,"ٱلسَّاعَةَ","the Hour","لِى وَمَآ أَظُنُّ","قَآئِمَةًۭ وَلَئِن رُّجِعْتُ",250],["42:17:10",485,"ٱلسَّاعَةَ","the Hour","وَمَا يُدْرِيكَ لَعَلَّ","قَرِيبٌۭ",250],["42:18:19",485,"ٱلسَّاعَةِ","the Hour","ٱلَّذِينَ يُمَارُونَ فِى","لَفِى ضَلَـٰلٍۭ بَعِيدٍ",250],["43:61:3",494,"لِّلسَّاعَةِ","of the Hour","وَإِنَّهُۥ لَعِلْمٌۭ","فَلَا تَمْتَرُنَّ بِهَا",250],["43:66:4",494,"ٱلسَّاعَةَ","(for) the Hour","هَلْ يَنظُرُونَ إِلَّا","أَن تَأْتِيَهُم بَغْتَةًۭ",250],["43:85:11",495,"ٱلسَّاعَةِ","(of) the Hour","بَيْنَهُمَا وَعِندَهُۥ عِلْمُ","وَإِلَيْهِ تُرْجَعُونَ",250],["45:27:7",501,"ٱلسَّاعَةُ","the Hour","وَٱلْأَرْضِ ۚ وَيَوْمَ تَقُومُ","يَوْمَئِذٍۢ يَخْسَرُ ٱلْمُبْطِلُونَ",250],["45:32:7",501,"وَٱلسَّاعَةُ","and the Hour","وَعْدَ ٱللَّهِ حَقٌّۭ","لَا رَيْبَ فِيهَا