[["2:286:24",49,"إِصْرًۭا","a burden","وَلَا تَحْمِلْ عَلَيْنَآ","كَمَا حَمَلْتَهُۥ عَلَى",1714],["3:81:25",60,"إِصْرِى ۖ","My Covenant","وَأَخَذْتُمْ عَلَىٰ ذَٰلِكُمْ","قَالُوٓا۟ أَقْرَرْنَا ۚ قَالَ",1714],["7:157:26",170,"إِصْرَهُمْ","their burden","ٱلْخَبَـٰٓئِثَ وَيَضَعُ عَنْهُمْ","وَٱلْأَغْلَـٰلَ ٱلَّتِى كَانَتْ",1714]]