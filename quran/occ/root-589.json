[["2:59:13",9,"رِجْزًۭا","a punishment","عَلَى ٱلَّذِينَ ظَلَمُوا۟","مِّنَ ٱلسَّمَآءِ بِمَا",921],["7:134:4",166,"ٱلرِّجْزُ","the punishment","وَلَمَّا وَقَعَ عَلَيْهِمُ","قَالُوا۟ يَـٰمُوسَى ٱدْعُ",921],["7:134:16",166,"ٱلرِّجْزَ","the punishment","لَئِن كَشَفْتَ عَنَّا","لَنُؤْمِنَنَّ لَكَ وَلَنُرْسِلَنَّ",921],["7:135:4",166,"ٱلرِّجْزَ","the punishment","فَلَمَّا كَشَفْنَا عَنْهُمُ","إِلَىٰٓ أَجَلٍ هُم",921],["7:162:12",171,"رِجْزًۭا","torment","لَهُمْ فَأَرْسَلْنَا عَلَيْهِمْ","مِّنَ ٱلسَّمَآءِ بِمَا",921],["8:11:15",178,"رِجْزَ","evil (suggestions)","بِهِۦ وَيُذْهِبَ عَنكُمْ","ٱلشَّيْطَـٰنِ وَلِيَرْبِطَ عَلَىٰ",921],["29:34:7",400,"رِجْزًۭا","a punishment","أَهْلِ هَـٰذِهِ ٱلْقَرْيَةِ","مِّنَ ٱلسَّمَآءِ بِمَا",921],["34:5:10",428,"رِّجْزٍ","foul nature","لَهُمْ عَذَابٌۭ مِّن","أَلِيمٌۭ",921],["45:11:10",499,"رِّجْزٍ","filth","لَهُمْ عَذَابٌۭ مِّن","أَلِيمٌ",921],["74:5:1",575,"وَٱلرُّجْزَ","And uncleanliness","","فَٱهْجُرْ",4225]]