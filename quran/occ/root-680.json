[["7:135:11",166,"يَنكُثُونَ","broke (the word)","بَـٰلِغُوهُ إِذَا هُمْ","",1215],["9:12:2",188,"نَّكَثُوٓا۟","they break","وَإِن","أَيْمَـٰنَهُم مِّنۢ بَعْدِ",1215],["9:13:4",188,"نَّكَثُوٓا۟","who broke","أَلَا تُقَـٰتِلُونَ قَوْمًۭا","أَيْمَـٰنَهُمْ وَهَمُّوا۟ بِإِخْرَاجِ",1215],["16:92:9",277,"أَنكَـٰثًۭا","(into) untwisted strands","مِنۢ بَعْدِ قُوَّةٍ","تَتَّخِذُونَ أَيْمَـٰنَكُمْ دَخَلًۢا",3021],["43:50:7",493,"يَنكُثُونَ","broke (their word)","ٱلْعَذَابَ إِذَا هُمْ","",1215],["48:10:12",512,"نَّكَثَ","breaks (his oath)","فَوْقَ أَيْدِيهِمْ ۚ فَمَن","فَإِنَّمَا يَنكُثُ عَلَىٰ",1215],["48:10:14",512,"يَنكُثُ","he breaks","فَمَن نَّكَثَ فَإِنَّمَا","عَلَىٰ نَفْسِهِۦ ۖ وَمَنْ",1215]]