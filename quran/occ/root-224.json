[["2:233:36",37,"فِصَالًا","weaning","ذَٰلِكَ ۗ فَإِنْ أَرَادَا","عَن تَرَاضٍۢ مِّنْهُمَا",1835],["2:249:2",41,"فَصَلَ","set out","فَلَمَّا","طَالُوتُ بِٱلْجُنُودِ قَالَ",1330],["6:55:2",134,"نُفَصِّلُ","We explain","وَكَذَٰلِكَ","ٱلْـَٔايَـٰتِ وَلِتَسْتَبِينَ سَبِيلُ",572],["6:57:22",134,"ٱلْفَـٰصِلِينَ","(of) the Deciders","ٱلْحَقَّ ۖ وَهُوَ خَيْرُ","",3403],["6:97:13",140,"فَصَّلْنَا","We have made clear","ٱلْبَرِّ وَٱلْبَحْرِ ۗ قَدْ","ٱلْـَٔايَـٰتِ لِقَوْمٍۢ يَعْلَمُونَ",572],["6:98:10",140,"فَصَّلْنَا","We have made clear","فَمُسْتَقَرٌّۭ وَمُسْتَوْدَعٌۭ ۗ قَدْ","ٱلْـَٔايَـٰتِ لِقَوْمٍۢ يَفْقَهُونَ",572],["6:114:10",142,"مُفَصَّلًۭا ۚ","explained in detail","أَنزَلَ إِلَيْكُمُ ٱلْكِتَـٰبَ","وَٱلَّذِينَ ءَاتَيْنَـٰهُمُ ٱلْكِتَـٰبَ",3797],["6:119:11",143,"فَصَّلَ","He (has) explained in detail","ٱللَّهِ عَلَيْهِ وَقَدْ","لَكُم مَّا حَرَّمَ",572],["6:126:6",144,"فَصَّلْنَا","We have detailed","رَبِّكَ مُسْتَقِيمًۭا ۗ قَدْ","ٱلْـَٔايَـٰتِ لِقَوْمٍۢ يَذَّكَّرُونَ",572],["6:154:9",149,"وَتَفْصِيلًۭا","and an explanation","عَلَى ٱلَّذِىٓ أَحْسَنَ","لِّكُلِّ شَىْءٍۢ وَهُدًۭى",1401],["7:32:23",154,"نُفَصِّلُ","We explain","يَوْمَ ٱلْقِيَـٰمَةِ ۗ كَذَٰلِكَ","ٱلْـَٔايَـٰتِ لِقَوْمٍۢ يَعْلَمُونَ",572],["7:52:4",157,"فَصَّلْنَـٰهُ","which We have explained","وَلَقَدْ جِئْنَـٰهُم بِكِتَـٰبٍۢ","عَلَىٰ عِلْمٍ هُدًۭى",572],["7:133:9",166,"مُّفَصَّلَـٰتٍۢ","manifest","وَٱلضَّفَادِعَ وَٱلدَّمَ ءَايَـٰتٍۢ","فَٱسْتَكْبَرُوا۟ وَكَانُوا۟ قَوْمًۭا",3963],["7:145:9",168,"وَتَفْصِيلًۭا","and explanation","كُلِّ شَىْءٍۢ مَّوْعِظَةًۭ","لِّكُلِّ شَىْءٍۢ فَخُذْهَا",1401],["7:174:2",173,"نُفَصِّلُ","We explain","وَكَذَٰلِكَ","ٱلْـَٔايَـٰتِ وَلَعَلَّهُمْ يَرْجِعُونَ",572],["9:11:10",188,"وَنُفَصِّلُ","And We explain in detail","فَإِخْوَٰنُكُمْ فِى ٱلدِّينِ ۗ","ٱلْـَٔايَـٰتِ لِقَوْمٍۢ يَعْلَمُونَ",572],["10:5:20",208,"يُفَصِّلُ","He explains","ذَٰلِكَ إِلَّا بِٱلْحَقِّ ۚ","ٱلْـَٔايَـٰتِ لِقَوْمٍۢ يَعْلَمُونَ",572],["10:24:40",211,"نُفَصِّلُ","We explain","تَغْنَ بِٱلْأَمْسِ ۚ كَذَٰلِكَ","ٱلْـَٔايَـٰتِ لِقَوْمٍۢ يَتَفَكَّرُونَ",572],["10:37:15",213,"وَتَفْصِيلَ","and a detailed explanation","ٱلَّذِى بَيْنَ يَدَيْهِ","ٱلْكِتَـٰبِ لَا رَيْبَ",1401],["11:1:6",221,"فُصِّلَتْ","explained in detail","أُحْكِمَتْ ءَايَـٰتُهُۥ ثُمَّ","مِن لَّدُنْ حَكِيمٍ",572],["12:94:2",246,"فَصَلَتِ","departed","وَلَمَّا","ٱلْعِيرُ قَالَ أَبُوهُمْ",1330],["12:111:17",248,"وَتَفْصِيلَ","and a detailed explanation","ٱلَّذِى بَيْنَ يَدَيْهِ","كُلِّ شَىْءٍۢ وَهُدًۭى",1401],["13:2:21",249,"يُفَصِّلُ","He details","مُّسَمًّۭى ۚ يُدَبِّرُ ٱلْأَمْرَ","ٱلْـَٔايَـٰتِ لَعَلَّكُم بِلِقَآءِ",572],["17:12:22",283,"فَصَّلْنَـٰهُ","We have explained it","وَٱلْحِسَابَ ۚ وَكُلَّ شَىْءٍۢ","تَفْصِيلًۭا",572],["17:12:23",283,"تَفْصِيلًۭا","(in) detail","وَكُلَّ شَىْءٍۢ فَصَّلْنَـٰهُ","",1401],["22:17:13",334,"يَفْصِلُ","will judge","أَشْرَكُوٓا۟ إِنَّ ٱللَّهَ","بَيْنَهُمْ يَوْمَ ٱلْقِيَـٰمَةِ ۚ",1330],["30:28:24",407,"نُفَصِّلُ","We explain","كَخِيفَتِكُمْ أَنفُسَكُمْ ۚ كَذَٰلِكَ","ٱلْـَٔايَـٰتِ لِقَوْمٍۢ يَعْقِلُونَ",572],["31:14:9",412,"وَفِصَـٰلُهُۥ","and his weaning","وَهْنًا عَلَىٰ وَهْنٍۢ","فِى عَامَيْنِ أَنِ",1835],["32:25:4",417,"يَفْصِلُ","will judge","إِنَّ رَبَّكَ هُوَ","بَيْنَهُمْ يَوْمَ ٱلْقِيَـٰمَةِ",1330],["37:21:3",446,"ٱلْفَصْلِ","(of) Judgment","هَـٰذَا يَوْمُ","ٱلَّذِى كُنتُم بِهِۦ",897],["38:20:5",454,"وَفَصْلَ","and decisive","مُلْكَهُۥ وَءَاتَيْنَـٰهُ ٱلْحِكْمَةَ","ٱلْخِطَابِ",897],["41:3:2",477,"فُصِّلَتْ","are detailed","كِتَـٰبٌۭ","ءَايَـٰتُهُۥ قُرْءَانًا عَرَبِيًّۭا",572],["41:44:7",481,"فُصِّلَتْ","are explained in detail","أَعْجَمِيًّۭا لَّقَالُوا۟ لَوْلَا","ءَايَـٰتُهُۥٓ ۖ ءَا۬عْجَمِىٌّۭ وَعَرَبِىٌّۭ ۗ",572],["42:21:15",485,"ٱلْفَصْلِ","decisive","ٱللَّهُ ۚ وَلَوْلَا كَلِمَةُ","لَقُضِىَ بَيْنَهُمْ ۗ وَإِنَّ",897],["44:40:3",498,"ٱلْفَصْلِ","(the) Day of Judgment","إِنَّ يَوْمَ","مِيقَـٰتُهُمْ أَجْمَعِينَ",897],["46:15:11",504,"وَفِصَـٰلُهُۥ","and (the) weaning of him","وَوَضَعَتْهُ كُرْهًۭا ۖ وَحَمْلُهُۥ","ثَلَـٰثُونَ شَهْرًا ۚ حَتَّىٰٓ",1835],["60:3:8",549,"يَفْصِلُ","He will judge","أَوْلَـٰدُكُمْ ۚ يَوْمَ ٱلْقِيَـٰمَةِ","بَيْنَكُمْ ۚ وَٱللَّهُ بِمَا",1330],["70:13:1",569,"وَفَصِيلَتِهِ","And his nearest kindred","","ٱلَّتِى تُـْٔوِيهِ",3401],["77:13:2",580,"ٱلْفَصْلِ","(of) Judgment","لِيَوْمِ","",897],["77:14:5",580,"ٱلْفَصْلِ","(of) the Judgment","أَدْرَىٰكَ مَا يَوْمُ","",897],["77:38:3",581,"ٱلْفَصْلِ ۖ","(of) Judgment","هَـٰذَا يَوْمُ","جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ",897],["78:17:3",582,"ٱلْفَصْلِ","(of) the Judgment","إِنَّ يَوْمَ","كَانَ مِيقَـٰتًۭا",897],["86:13:3",591,"فَصْلٌۭ","decisive","إِنَّهُۥ لَقَوْلٌۭ","",897]]