[["2:178:13",27,"وَٱلْأُنثَىٰ","and the female","بِٱلْحُرِّ وَٱلْعَبْدُ بِٱلْعَبْدِ","بِٱلْأُنثَىٰ ۚ فَمَنْ عُفِىَ",435],["2:178:14",27,"بِٱلْأُنثَىٰ ۚ","for the female","وَٱلْعَبْدُ بِٱلْعَبْدِ وَٱلْأُنثَىٰ","فَمَنْ عُفِىَ لَهُۥ",435],["3:36:7",54,"أُنثَىٰ","a female","رَبِّ إِنِّى وَضَعْتُهَآ","وَٱللَّهُ أَعْلَمُ بِمَا",435],["3:36:14",54,"كَٱلْأُنثَىٰ ۖ","like the female","وَضَعَتْ وَلَيْسَ ٱلذَّكَرُ","وَإِنِّى سَمَّيْتُهَا مَرْيَمَ",435],["3:195:13",76,"أُنثَىٰ ۖ","female","مِّن ذَكَرٍ أَوْ","بَعْضُكُم مِّنۢ بَعْضٍۢ ۖ",435],["4:11:8",78,"ٱلْأُنثَيَيْنِ ۚ","(of) two females","لِلذَّكَرِ مِثْلُ حَظِّ","فَإِن كُنَّ نِسَآءًۭ",1147],["4:117:6",97,"إِنَـٰثًۭا","female (deities)","مِن دُونِهِۦٓ إِلَّآ","وَإِن يَدْعُونَ إِلَّا",435],["4:124:8",98,"أُنثَىٰ","female","مِن ذَكَرٍ أَوْ","وَهُوَ مُؤْمِنٌۭ فَأُو۟لَـٰٓئِكَ",435],["4:176:41",106,"ٱلْأُنثَيَيْنِ ۗ","(of) the two females","فَلِلذَّكَرِ مِثْلُ حَظِّ","يُبَيِّنُ ٱللَّهُ لَكُمْ",1147],["6:143:13",147,"ٱلْأُنثَيَيْنِ","the two females","ءَآلذَّكَرَيْنِ حَرَّمَ أَمِ","أَمَّا ٱشْتَمَلَتْ عَلَيْهِ",1147],["6:143:18",147,"ٱلْأُنثَيَيْنِ ۖ","(of) the two females","ٱشْتَمَلَتْ عَلَيْهِ أَرْحَامُ","نَبِّـُٔونِى بِعِلْمٍ إِن",1147],["6:144:11",147,"ٱلْأُنثَيَيْنِ","the two females","ءَآلذَّكَرَيْنِ حَرَّمَ أَمِ","أَمَّا ٱشْتَمَلَتْ عَلَيْهِ",1147],["6:144:16",147,"ٱلْأُنثَيَيْنِ ۖ","(of) the two females","ٱشْتَمَلَتْ عَلَيْهِ أَرْحَامُ","أَمْ كُنتُمْ شُهَدَآءَ",1147],["13:8:6",250,"أُنثَىٰ","female","مَا تَحْمِلُ كُلُّ","وَمَا تَغِيضُ ٱلْأَرْحَامُ",435],["16:58:4",273,"بِٱلْأُنثَىٰ","of a female","وَإِذَا بُشِّرَ أَحَدُهُم","ظَلَّ وَجْهُهُۥ مُسْوَدًّۭا",435],["16:97:7",278,"أُنثَىٰ","female","مِّن ذَكَرٍ أَوْ","وَهُوَ مُؤْمِنٌۭ فَلَنُحْيِيَنَّهُۥ",435],["17:40:7",286,"إِنَـٰثًا ۚ","daughters","وَٱتَّخَذَ مِنَ ٱلْمَلَـٰٓئِكَةِ","إِنَّكُمْ لَتَقُولُونَ قَوْلًا",435],["35:11:14",435,"أُنثَىٰ","female","وَمَا تَحْمِلُ مِنْ","وَلَا تَضَعُ إِلَّا",435],["37:150:4",451,"إِنَـٰثًۭا","females","أَمْ خَلَقْنَا ٱلْمَلَـٰٓئِكَةَ","وَهُمْ شَـٰهِدُونَ",435],["40:40:14",471,"أُنثَىٰ","female","مِّن ذَكَرٍ أَوْ","وَهُوَ مُؤْمِنٌۭ فَأُو۟لَـٰٓئِكَ",435],["41:47:14",482,"أُنثَىٰ","female","وَمَا تَحْمِلُ مِنْ","وَلَا تَضَعُ إِلَّا",435],["42:49:11",488,"إِنَـٰثًۭا","females","يَهَبُ لِمَن يَشَآءُ","وَيَهَبُ لِمَن يَشَآءُ",435],["42:50:4",488,"وَإِنَـٰثًۭا ۖ","and females","أَوْ يُزَوِّجُهُمْ ذُكْرَانًۭا","وَيَجْعَلُ مَن يَشَآءُ",435],["43:19:7",490,"إِنَـٰثًا ۚ","females","هُمْ عِبَـٰدُ ٱلرَّحْمَـٰنِ","أَشَهِدُوا۟ خَلْقَهُمْ ۚ سَتُكْتَبُ",435],["49:13:7",517,"وَأُنثَىٰ","and a female","خَلَقْنَـٰكُم مِّن ذَكَرٍۢ","وَجَعَلْنَـٰكُمْ شُعُوبًۭا وَقَبَآئِلَ",435],["53:21:4",526,"ٱلْأُنثَىٰ","the female","أَلَكُمُ ٱلذَّكَرُ وَلَهُ","",435],["53:27:9",527,"ٱلْأُنثَىٰ","(of) female","لَيُسَمُّونَ ٱلْمَلَـٰٓئِكَةَ تَسْمِيَةَ","",435],["53:45:5",528,"وَٱلْأُنثَىٰ","and the female","خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ","",435],["75:39:5",578,"وَٱلْأُنثَىٰٓ","and the female","مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ","",435],["92:3:4",595,"وَٱلْأُنثَىٰٓ","and the female","وَمَا خَلَقَ ٱلذَّكَرَ","",435]]