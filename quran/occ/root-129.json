[["2:155:8",24,"ٱلْأَمْوَٰلِ","[the] wealth","وَٱلْجُوعِ وَنَقْصٍۢ مِّنَ","وَٱلْأَنفُسِ وَٱلثَّمَرَٰتِ ۗ وَبَشِّرِ",126],["2:177:20",27,"ٱلْمَالَ","the wealth","وَٱلْكِتَـٰبِ وَٱلنَّبِيِّـۧنَ وَءَاتَى","عَلَىٰ حُبِّهِۦ ذَوِى",126],["2:188:3",29,"أَمْوَٰلَكُم","your properties","وَلَا تَأْكُلُوٓا۟","بَيْنَكُم بِٱلْبَـٰطِلِ وَتُدْلُوا۟",126],["2:188:13",29,"أَمْوَٰلِ","(the) wealth","لِتَأْكُلُوا۟ فَرِيقًۭا مِّنْ","ٱلنَّاسِ بِٱلْإِثْمِ وَأَنتُمْ",126],["2:247:25",40,"ٱلْمَالِ ۚ","[the] wealth","يُؤْتَ سَعَةًۭ مِّنَ","قَالَ إِنَّ ٱللَّهَ",126],["2:261:4",44,"أَمْوَٰلَهُمْ","their wealth","مَّثَلُ ٱلَّذِينَ يُنفِقُونَ","فِى سَبِيلِ ٱللَّهِ",126],["2:262:3",44,"أَمْوَٰلَهُمْ","their wealth","ٱلَّذِينَ يُنفِقُونَ","فِى سَبِيلِ ٱللَّهِ",126],["2:264:11",44,"مَالَهُۥ","his wealth","وَٱلْأَذَىٰ كَٱلَّذِى يُنفِقُ","رِئَآءَ ٱلنَّاسِ وَلَا",126],["2:265:4",45,"أَمْوَٰلَهُمُ","their wealth","وَمَثَلُ ٱلَّذِينَ يُنفِقُونَ","ٱبْتِغَآءَ مَرْضَاتِ ٱللَّهِ",126],["2:274:3",46,"أَمْوَٰلَهُم","their wealth","ٱلَّذِينَ يُنفِقُونَ","بِٱلَّيْلِ وَٱلنَّهَارِ سِرًّۭا",126],["2:279:13",47,"أَمْوَٰلِكُمْ","your capital","تُبْتُمْ فَلَكُمْ رُءُوسُ","لَا تَظْلِمُونَ وَلَا",126],["3:10:7",51,"أَمْوَٰلُهُمْ","their wealth","لَن تُغْنِىَ عَنْهُمْ","وَلَآ أَوْلَـٰدُهُم مِّنَ",126],["3:116:7",65,"أَمْوَٰلُهُمْ","their wealth","لَن تُغْنِىَ عَنْهُمْ","وَلَآ أَوْلَـٰدُهُم مِّنَ",126],["3:186:3",74,"أَمْوَٰلِكُمْ","your wealth","۞ لَتُبْلَوُنَّ فِىٓ","وَأَنفُسِكُمْ وَلَتَسْمَعُنَّ مِنَ",126],["4:2:3",77,"أَمْوَٰلَهُمْ ۖ","their wealth","وَءَاتُوا۟ ٱلْيَتَـٰمَىٰٓ","وَلَا تَتَبَدَّلُوا۟ ٱلْخَبِيثَ",126],["4:2:10",77,"أَمْوَٰلَهُمْ","their wealth","بِٱلطَّيِّبِ ۖ وَلَا تَأْكُلُوٓا۟","إِلَىٰٓ أَمْوَٰلِكُمْ ۚ إِنَّهُۥ",126],["4:2:12",77,"أَمْوَٰلِكُمْ ۚ","your wealth","تَأْكُلُوٓا۟ أَمْوَٰلَهُمْ إِلَىٰٓ","إِنَّهُۥ كَانَ حُوبًۭا",126],["4:5:4",77,"أَمْوَٰلَكُمُ","your wealth","وَلَا تُؤْتُوا۟ ٱلسُّفَهَآءَ","ٱلَّتِى جَعَلَ ٱللَّهُ",126],["4:6:13",77,"أَمْوَٰلَهُمْ ۖ","their wealth","رُشْدًۭا فَٱدْفَعُوٓا۟ إِلَيْهِمْ","وَلَا تَأْكُلُوهَآ إِسْرَافًۭا",126],["4:6:32",77,"أَمْوَٰلَهُمْ","their wealth","فَإِذَا دَفَعْتُمْ إِلَيْهِمْ","فَأَشْهِدُوا۟ عَلَيْهِمْ ۚ وَكَفَىٰ",126],["4:10:4",78,"أَمْوَٰلَ","wealth","إِنَّ ٱلَّذِينَ يَأْكُلُونَ","ٱلْيَتَـٰمَىٰ ظُلْمًا إِنَّمَا",126],["4:24:18",82,"بِأَمْوَٰلِكُم","with your wealth","ذَٰلِكُمْ أَن تَبْتَغُوا۟","مُّحْصِنِينَ غَيْرَ مُسَـٰفِحِينَ ۚ",126],["4:29:6",83,"أَمْوَٰلَكُم","your wealth","ءَامَنُوا۟ لَا تَأْكُلُوٓا۟","بَيْنَكُم بِٱلْبَـٰطِلِ إِلَّآ",126],["4:34:14",84,"أَمْوَٰلِهِمْ ۚ","their wealth","وَبِمَآ أَنفَقُوا۟ مِنْ","فَٱلصَّـٰلِحَـٰتُ قَـٰنِتَـٰتٌ حَـٰفِظَـٰتٌۭ",126],["4:38:3",85,"أَمْوَٰلَهُمْ","their wealth","وَٱلَّذِينَ يُنفِقُونَ","رِئَآءَ ٱلنَّاسِ وَلَا",126],["4:95:13",94,"بِأَمْوَٰلِهِمْ","with their wealth","فِى سَبِيلِ ٱللَّهِ","وَأَنفُسِهِمْ ۚ فَضَّلَ ٱللَّهُ",126],["4:95:18",94,"بِأَمْوَٰلِهِمْ","with their wealth","فَضَّلَ ٱللَّهُ ٱلْمُجَـٰهِدِينَ","وَأَنفُسِهِمْ عَلَى ٱلْقَـٰعِدِينَ",126],["4:161:7",103,"أَمْوَٰلَ","wealth","نُهُوا۟ عَنْهُ وَأَكْلِهِمْ","ٱلنَّاسِ بِٱلْبَـٰطِلِ ۚ وَأَعْتَدْنَا",126],["6:152:3",149,"مَالَ","wealth","وَلَا تَقْرَبُوا۟","ٱلْيَتِيمِ إِلَّا بِٱلَّتِى",126],["8:28:3",180,"أَمْوَٰلُكُمْ","your wealth","وَٱعْلَمُوٓا۟ أَنَّمَآ","وَأَوْلَـٰدُكُمْ فِتْنَةٌۭ وَأَنَّ",126],["8:36:5",181,"أَمْوَٰلَهُمْ","their wealth","ٱلَّذِينَ كَفَرُوا۟ يُنفِقُونَ","لِيَصُدُّوا۟ عَن سَبِيلِ",126],["8:72:6",186,"بِأَمْوَٰلِهِمْ","with their wealth","ءَامَنُوا۟ وَهَاجَرُوا۟ وَجَـٰهَدُوا۟","وَأَنفُسِهِمْ فِى سَبِيلِ",126],["9:20:8",189,"بِأَمْوَٰلِهِمْ","with their wealth","فِى سَبِيلِ ٱللَّهِ","وَأَنفُسِهِمْ أَعْظَمُ دَرَجَةً",126],["9:24:9",190,"وَأَمْوَٰلٌ","and wealth","وَإِخْوَٰنُكُمْ وَأَزْوَٰجُكُمْ وَعَشِيرَتُكُمْ","ٱقْتَرَفْتُمُوهَا وَتِجَـٰرَةٌۭ تَخْشَوْنَ",126],["9:34:10",192,"أَمْوَٰلَ","(the) wealth","ٱلْأَحْبَارِ وَٱلرُّهْبَانِ لَيَأْكُلُونَ","ٱلنَّاسِ بِٱلْبَـٰطِلِ وَيَصُدُّونَ",126],["9:41:5",194,"بِأَمْوَٰلِكُمْ","with your wealth","خِفَافًۭا وَثِقَالًۭا وَجَـٰهِدُوا۟","وَأَنفُسِكُمْ فِى سَبِيلِ",126],["9:44:10",194,"بِأَمْوَٰلِهِمْ","with their wealth","ٱلْـَٔاخِرِ أَن يُجَـٰهِدُوا۟","وَأَنفُسِهِمْ ۗ وَٱللَّهُ عَلِيمٌۢ",126],["9:55:3",196,"أَمْوَٰلُهُمْ","their wealth","فَلَا تُعْجِبْكَ","وَلَآ أَوْلَـٰدُهُمْ ۚ إِنَّمَا",126],["9:69:9",198,"أَمْوَٰلًۭا","(in) wealth","مِنكُمْ قُوَّةًۭ وَأَكْثَرَ","وَأَوْلَـٰدًۭا فَٱسْتَمْتَعُوا۟ بِخَلَـٰقِهِمْ",126],["9:81:10",200,"بِأَمْوَٰلِهِمْ","with their wealth","وَكَرِهُوٓا۟ أَن يُجَـٰهِدُوا۟","وَأَنفُسِهِمْ فِى سَبِيلِ",126],["9:85:3",200,"أَمْوَٰلُهُمْ","their wealth","وَلَا تُعْجِبْكَ","وَأَوْلَـٰدُهُمْ ۚ إِنَّمَا يُرِيدُ",126],["9:88:7",201,"بِأَمْوَٰلِهِمْ","with their wealth","ءَامَنُوا۟ مَعَهُۥ جَـٰهَدُوا۟","وَأَنفُسِهِمْ ۚ وَأُو۟لَـٰٓئِكَ لَهُمُ",126],["9:103:3",203,"أَمْوَٰلِهِمْ","their wealth","خُذْ مِنْ","صَدَقَةًۭ تُطَهِّرُهُمْ وَتُزَكِّيهِم",126],["9:111:7",204,"وَأَمْوَٰلَهُم","and their wealth","مِنَ ٱلْمُؤْمِنِينَ أَنفُسَهُمْ","بِأَنَّ لَهُمُ ٱلْجَنَّةَ ۚ",126],["10:88:9",218,"وَأَمْوَٰلًۭا","and wealth","فِرْعَوْنَ وَمَلَأَهُۥ زِينَةًۭ","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا",126],["10:88:20",218,"أَمْوَٰلِهِمْ","their wealth","رَبَّنَا ٱطْمِسْ عَلَىٰٓ","وَٱشْدُدْ عَلَىٰ قُلُوبِهِمْ",126],["11:29:5",225,"مَالًا ۖ","any wealth","لَآ أَسْـَٔلُكُمْ عَلَيْهِ","إِنْ أَجْرِىَ إِلَّا",126],["11:87:14",231,"أَمْوَٰلِنَا","our wealth","أَن نَّفْعَلَ فِىٓ","مَا نَشَـٰٓؤُا۟ ۖ إِنَّكَ",126],["17:6:7",282,"بِأَمْوَٰلٍۢ","with the wealth","ٱلْكَرَّةَ عَلَيْهِمْ وَأَمْدَدْنَـٰكُم","وَبَنِينَ وَجَعَلْنَـٰكُمْ أَكْثَرَ",126],["17:34:3",285,"مَالَ","(the) wealth","وَلَا تَقْرَبُوا۟","ٱلْيَتِيمِ إِلَّا بِٱلَّتِى",126],["17:64:12",288,"ٱلْأَمْوَٰلِ","the wealth","وَرَجِلِكَ وَشَارِكْهُمْ فِى","وَٱلْأَوْلَـٰدِ وَعِدْهُمْ ۚ وَمَا",126],["18:34:11",297,"مَالًۭا","(in) wealth","أَنَا۠ أَكْثَرُ مِنكَ","وَأَعَزُّ نَفَرًۭا",126],["18:39:18",298,"مَالًۭا","(in) wealth","أَنَا۠ أَقَلَّ مِنكَ","وَوَلَدًۭا",126],["18:46:1",299,"ٱلْمَالُ","The wealth","","وَٱلْبَنُونَ زِينَةُ ٱلْحَيَوٰةِ",126],["19:77:7",311,"مَالًۭا","wealth","بِـَٔايَـٰتِنَا وَقَالَ لَأُوتَيَنَّ","وَوَلَدًا",126],["23:55:6",345,"مَّالٍۢ","wealth","نُمِدُّهُم بِهِۦ مِن","وَبَنِينَ",126],["24:33:24",354,"مَّالِ","the wealth of Allah","خَيْرًۭا ۖ وَءَاتُوهُم مِّن","ٱللَّهِ ٱلَّذِىٓ ءَاتَىٰكُمْ ۚ",126],["26:88:4",371,"مَالٌۭ","wealth","يَوْمَ لَا يَنفَعُ","وَلَا بَنُونَ",126],["27:36:6",380,"بِمَالٍۢ","with wealth","سُلَيْمَـٰنَ قَالَ أَتُمِدُّونَنِ","فَمَآ ءَاتَىٰنِۦَ ٱللَّهُ",126],["30:39:7",408,"أَمْوَٰلِ","(the) wealth","رِّبًۭا لِّيَرْبُوَا۟ فِىٓ","ٱلنَّاسِ فَلَا يَرْبُوا۟",126],["33:27:4",421,"وَأَمْوَٰلَهُمْ","and their properties","وَأَوْرَثَكُمْ أَرْضَهُمْ وَدِيَـٰرَهُمْ","وَأَرْضًۭا لَّمْ تَطَـُٔوهَا ۚ",126],["34:35:4",432,"أَمْوَٰلًۭا","wealth","وَقَالُوا۟ نَحْنُ أَكْثَرُ","وَأَوْلَـٰدًۭا وَمَا نَحْنُ",126],["34:37:2",432,"أَمْوَٰلُكُمْ","your wealth","وَمَآ","وَلَآ أَوْلَـٰدُكُم بِٱلَّتِى",126],["47:36:13",510,"أَمْوَٰلَكُمْ","(for) your wealth","أُجُورَكُمْ وَلَا يَسْـَٔلْكُمْ","",126],["48:11:7",512,"أَمْوَٰلُنَا","our properties","مِنَ ٱلْأَعْرَابِ شَغَلَتْنَآ","وَأَهْلُونَا فَٱسْتَغْفِرْ لَنَا ۚ",126],["49:15:11",517,"بِأَمْوَٰلِهِمْ","with their wealth","لَمْ يَرْتَابُوا۟ وَجَـٰهَدُوا۟","وَأَنفُسِهِمْ فِى سَبِيلِ",126],["51:19:2",521,"أَمْوَٰلِهِمْ","their wealth","وَفِىٓ","حَقٌّۭ لِّلسَّآئِلِ وَٱلْمَحْرُومِ",126],["57:20:12",540,"ٱلْأَمْوَٰلِ","the wealth","بَيْنَكُمْ وَتَكَاثُرٌۭ فِى","وَٱلْأَوْلَـٰدِ ۖ كَمَثَلِ غَيْثٍ",126],["58:17:4",544,"أَمْوَٰلُهُمْ","their wealth","لَّن تُغْنِىَ عَنْهُمْ","وَلَآ أَوْلَـٰدُهُم مِّنَ",126],["59:8:7",546,"وَأَمْوَٰلِهِمْ","and their properties","أُخْرِجُوا۟ مِن دِيَـٰرِهِمْ","يَبْتَغُونَ فَضْلًۭا مِّنَ",126],["61:11:8",552,"بِأَمْوَٰلِكُمْ","with your wealth","فِى سَبِيلِ ٱللَّهِ","وَأَنفُسِكُمْ ۚ ذَٰلِكُمْ خَيْرٌۭ",126],["63:9:6",555,"أَمْوَٰلُكُمْ","your wealth","ءَامَنُوا۟ لَا تُلْهِكُمْ","وَلَآ أَوْلَـٰدُكُمْ عَن",126],["64:15:2",557,"أَمْوَٰلُكُمْ","your wealth","إِنَّمَآ","وَأَوْلَـٰدُكُمْ فِتْنَةٌۭ ۚ وَٱللَّهُ",126],["68:14:4",564,"مَالٍۢ","(of) wealth","أَن كَانَ ذَا","وَبَنِينَ",126],["69:28:4",567,"مَالِيَهْ ۜ","my wealth","مَآ أَغْنَىٰ عَنِّى","",126],["70:24:3",569,"أَمْوَٰلِهِمْ","their wealth","وَٱلَّذِينَ فِىٓ","حَقٌّۭ مَّعْلُومٌۭ",126],["71:12:2",571,"بِأَمْوَٰلٍۢ","with wealth","وَيُمْدِدْكُم","وَبَنِينَ وَيَجْعَل لَّكُمْ",126],["71:21:10",571,"مَالُهُۥ","his wealth","مَن لَّمْ يَزِدْهُ","وَوَلَدُهُۥٓ إِلَّا خَسَارًۭا",126],["74:12:3",575,"مَالًۭا","wealth","وَجَعَلْتُ لَهُۥ","مَّمْدُودًۭا",126],["89:20:2",593,"ٱلْمَالَ","wealth","وَتُحِبُّونَ","حُبًّۭا جَمًّۭا",126],["90:6:3",594,"مَالًۭا","wealth","يَقُولُ أَهْلَكْتُ","لُّبَدًا",126],["92:11:4",596,"مَالُهُۥٓ","his wealth","وَمَا يُغْنِى عَنْهُ","إِذَا تَرَدَّىٰٓ",126],["92:18:3",596,"مَالَهُۥ","his wealth","ٱلَّذِى يُؤْتِى","يَتَزَكَّىٰ",126],["104:2:3",601,"مَالًۭا","wealth","ٱلَّذِى جَمَعَ","وَعَدَّدَهُۥ",126],["104:3:3",601,"مَالَهُۥٓ","his wealth","يَحْسَبُ أَنَّ","أَخْلَدَهُۥ",126],["111:2:4",603,"مَالُهُۥ","his wealth","مَآ أَغْنَىٰ عَنْهُ","وَمَا كَسَبَ",126]]