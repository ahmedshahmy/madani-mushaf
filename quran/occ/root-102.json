,"",1791],["58:8:34",543,"حَسْبُهُمْ","Sufficient (for) them","ٱللَّهُ بِمَا نَقُولُ ۚ","جَهَنَّمُ يَصْلَوْنَهَا ۖ فَبِئْسَ",775],["58:18:10",544,"وَيَحْسَبُونَ","And they think","كَمَا يَحْلِفُونَ لَكُمْ ۖ","أَنَّهُمْ عَلَىٰ شَىْءٍ ۚ",265],["59:2:28",545,"يَحْتَسِبُوا۟ ۖ","they expected","مِنْ حَيْثُ لَمْ","وَقَذَفَ فِى قُلُوبِهِمُ",2050],["59:14:15",547,"تَحْسَبُهُمْ","You think they","بَأْسُهُم بَيْنَهُمْ شَدِيدٌۭ ۚ","جَمِيعًۭا وَقُلُوبُهُمْ شَتَّىٰ ۚ",265],["63:4:12",554,"يَحْسَبُونَ","They think","كَأَنَّهُمْ خُشُبٌۭ مُّسَنَّدَةٌۭ ۖ","كُلَّ صَيْحَةٍ عَلَيْهِمْ ۚ",265],["65:3:5",558,"يَحْتَسِبُ ۚ","he thinks","مِنْ حَيْثُ لَا","وَمَن يَتَوَكَّلْ عَلَى",2050],["65:3:11",558,"حَسْبُهُۥٓ ۚ","(is) sufficient for him","عَلَى ٱللَّهِ فَهُوَ","إِنَّ ٱللَّهَ بَـٰلِغُ",775],["65:8:9",559,"فَحَاسَبْنَـٰهَا","so We took it to account","أَمْرِ رَبِّهَا وَرُسُلِهِۦ","حِسَابًۭا شَدِيدًۭا وَعَذَّبْنَـٰهَا",1774],["65:8:10",559,"حِسَابًۭا","an account","رَبِّهَا وَرُسُلِهِۦ فَحَاسَبْنَـٰهَا","شَدِيدًۭا وَعَذَّبْنَـٰهَا عَذَابًۭا",301],["69:20:5",567,"حِسَابِيَهْ","my account","ظَنَنتُ أَنِّى مُلَـٰقٍ","",301],["69:26:4",567,"حِسَابِيَهْ","(is) my account","وَلَمْ أَدْرِ مَا","",301],["75:3:1",577,"أَيَحْسَبُ","Does think","","ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ",265],["75:36:1",578,"أَيَحْسَبُ","Does think","","ٱلْإِنسَـٰنُ أَن يُتْرَكَ",265],["76:19:7",579,"حَسِبْتَهُمْ","you would think them","مُّخَلَّدُونَ إِذَا رَأَيْتَهُمْ","لُؤْلُؤًۭا مَّنثُورًۭا",265],["78:27:5",582,"حِسَابًۭا","an account","كَانُوا۟ لَا يَرْجُونَ","",301],["78:36:5",583,"حِسَابًۭا","(according to) account","مِّن رَّبِّكَ عَطَآءً","",301],["84:8:2",589,"يُحَاسَبُ","his account will be taken","فَسَوْفَ","حِسَابًۭا يَسِيرًۭا",1774],["84:8:3",589,"حِسَابًۭا","an account","فَسَوْفَ يُحَاسَبُ","يَسِيرًۭا",301],["88:26:4",593,"حِسَابَهُم","(is) their account","ثُمَّ إِنَّ عَلَيْنَا","",301],["90:5:1",594,"أَيَحْسَبُ","Does he think","","أَن لَّن يَقْدِرَ",265],["90:7:1",594,"أَيَحْسَبُ","Does he think","","أَن لَّم