[["2:202:8",31,"ٱلْحِسَابِ","(in taking) account","كَسَبُوا۟ ۚ وَٱللَّهُ سَرِيعُ","",301],["2:206:9",32,"فَحَسْبُهُۥ","Then enough for him","أَخَذَتْهُ ٱلْعِزَّةُ بِٱلْإِثْمِ ۚ","جَهَنَّمُ ۚ وَلَبِئْسَ ٱلْمِهَادُ",775],["2:212:20",33,"حِسَابٍۢ","measure","مَن يَشَآءُ بِغَيْرِ","",301],["2:214:2",33,"حَسِبْتُمْ","(do) you think","أَمْ","أَن تَدْخُلُوا۟ ٱلْجَنَّةَ",265],["2:273:12",46,"يَحْسَبُهُمُ","Think (about) them","ضَرْبًۭا فِى ٱلْأَرْضِ","ٱلْجَاهِلُ أَغْنِيَآءَ مِنَ",265],["2:284:15",49,"يُحَاسِبْكُم","will call you to account","أَنفُسِكُمْ أَوْ تُخْفُوهُ","بِهِ ٱللَّهُ ۖ فَيَغْفِرُ",1774],["3:19:26",52,"ٱلْحِسَابِ","(in taking) account","فَإِنَّ ٱللَّهَ سَرِيعُ","",301],["3:27:21",53,"حِسَابٍۢ","measure","مَن تَشَآءُ بِغَيْرِ","",301],["3:37:34",54,"حِسَابٍ","measure","مَن يَشَآءُ بِغَيْرِ","",301],["3:78:7",60,"لِتَحْسَبُوهُ","so that you may think it","يَلْوُۥنَ أَلْسِنَتَهُم بِٱلْكِتَـٰبِ","مِنَ ٱلْكِتَـٰبِ وَمَا",265],["3:142:2",68,"حَسِبْتُمْ","do you think","أَمْ","أَن تَدْخُلُوا۟ ٱلْجَنَّةَ",265],["3:169:2",72,"تَحْسَبَنَّ","think","وَلَا","ٱلَّذِينَ قُتِلُوا۟ فِى",265],["3:173:14",72,"حَسْبُنَا","Sufficient for us","فَزَادَهُمْ إِيمَـٰنًۭا وَقَالُوا۟","ٱللَّهُ وَنِعْمَ ٱلْوَكِيلُ",775],["3:178:2",73,"يَحْسَبَنَّ","think","وَلَا","ٱلَّذِينَ كَفَرُوٓا۟ أَنَّمَا",265],["3:180:2",73,"يَحْسَبَنَّ","think","وَلَا","ٱلَّذِينَ يَبْخَلُونَ بِمَآ",265],["3:188:2",75,"تَحْسَبَنَّ","think","لَا","ٱلَّذِينَ يَفْرَحُونَ بِمَآ",265],["3:188:14",75,"تَحْسَبَنَّهُم","think (that) they","لَمْ يَفْعَلُوا۟ فَلَا","بِمَفَازَةٍۢ مِّنَ ٱلْعَذَابِ ۖ",265],["3:199:30",76,"ٱلْحِسَابِ","(in taking) the account","إِنَّ ٱللَّهَ سَرِيعُ","",301],["4:6:37",77,"حَسِيبًۭا","(as) a Reckoner","عَلَيْهِمْ ۚ وَكَفَىٰ بِٱللَّهِ","",1512],["4:86:15",91,"حَسِيبًا","an Accountant","عَلَىٰ كُلِّ شَىْءٍ","",1512],["5:4:31",107,"ٱلْحِسَابِ","(in taking) account","إِنَّ ٱللَّهَ سَرِيعُ","",301],["5:71:1",120,"وَحَسِبُوٓا۟","And they thought","","أَلَّا تَكُونَ فِتْنَةٌۭ",265],["5:104:12",125,"حَسْبُنَا","Sufficient for us","وَإِلَى ٱلرَّسُولِ قَالُوا۟","مَا وَجَدْنَا عَلَيْهِ",775],["6:52:13",133,"حِسَابِهِم","their account","مَا عَلَيْكَ مِنْ","مِّن شَىْءٍۢ وَمَا",301],["6:52:18",133,"حِسَابِكَ","your account","شَىْءٍۢ وَمَا مِنْ","عَلَيْهِم مِّن شَىْءٍۢ",301],["6:62:12",135,"ٱلْحَـٰسِبِينَ","(of) the Reckoners","ٱلْحُكْمُ وَهُوَ أَسْرَعُ","",2273],["6:69:6",136,"حِسَابِهِم","their account","ٱلَّذِينَ يَتَّقُونَ مِنْ","مِّن شَىْءٍۢ وَلَـٰكِن",301],["6:96:8",140,"حُسْبَانًۭا ۚ","(for) reckoning","سَكَنًۭا وَٱلشَّمْسَ وَٱلْقَمَرَ","ذَٰلِكَ تَقْدِيرُ ٱلْعَزِيزِ",1791],["7:30:14",153,"وَيَحْسَبُونَ","while they think","مِن دُونِ ٱللَّهِ","أَنَّهُم مُّهْتَدُونَ",265],["8:59:2",184,"يَحْسَبَنَّ","think","وَلَا","ٱلَّذِينَ كَفَرُوا۟ سَبَقُوٓا۟ ۚ",265],["8:62:6",185,"حَسْبَكَ","is sufficient for you","أَن يَخْدَعُوكَ فَإِنَّ","ٱللَّهُ ۚ هُوَ ٱلَّذِىٓ",775],["8:64:3",185,"حَسْبُكَ","Sufficient for you","يَـٰٓأَيُّهَا ٱلنَّبِىُّ","ٱللَّهُ وَمَنِ ٱتَّبَعَكَ",775],["9:16:2",189,"حَسِبْتُمْ","(do) you think","أَمْ","أَن تُتْرَكُوا۟ وَلَمَّا",265],["9:59:9",196,"حَسْبُنَا","Sufficient for us","ٱللَّهُ وَرَسُولُهُۥ وَقَالُوا۟","ٱللَّهُ سَيُؤْتِينَا ٱللَّهُ",775],["9:68:11",197,"حَسْبُهُمْ ۚ","sufficient for them","خَـٰلِدِينَ فِيهَا ۚ هِىَ","وَلَعَنَهُمُ ٱللَّهُ ۖ وَلَهُمْ",775],["9:129:4",207,"حَسْبِىَ","Sufficient for me","فَإِن تَوَلَّوْا۟ فَقُلْ","ٱللَّهُ لَآ إِلَـٰهَ",775],["10:5:13",208,"وَٱلْحِسَابَ ۚ","and the count (of time)","لِتَعْلَمُوا۟ عَدَدَ ٱلسِّنِينَ","مَا خَلَقَ ٱللَّهُ",301],["13:18:23",251,"ٱلْحِسَابِ","reckoning","أُو۟لَـٰٓئِكَ لَهُمْ سُوٓءُ","وَمَأْوَىٰهُمْ جَهَنَّمُ ۖ وَبِئْسَ",301],["13:21:13",252,"ٱلْحِسَابِ","the account","رَبَّهُمْ وَيَخَافُونَ سُوٓءَ","",301],["13:40:13",254,"ٱلْحِسَابُ","(is) the reckoning","عَلَيْكَ ٱلْبَلَـٰغُ وَعَلَيْنَا","",301],["13:41:16",254,"ٱلْحِسَابِ","(in) the reckoning","لِحُكْمِهِۦ ۚ وَهُوَ سَرِيعُ","",301],["14:41:8",260,"ٱلْحِسَابُ","the account","وَلِلْمُؤْمِنِينَ يَوْمَ يَقُومُ","",301],["14:42:2",260,"تَحْسَبَنَّ","think","وَلَا","ٱللَّهَ غَـٰفِلًا عَمَّا",265],["14:47:2",261,"تَحْسَبَنَّ","think","فَلَا","ٱللَّهَ مُخْلِفَ وَعْدِهِۦ",265],["14:51:10",261,"ٱلْحِسَابِ","(in) the reckoning","إِنَّ ٱللَّهَ سَرِيعُ","",301],["17:12:19",283,"وَٱلْحِسَابَ ۚ","and the account","وَلِتَعْلَمُوا۟ عَدَدَ ٱلسِّنِينَ","وَكُلَّ شَىْءٍۢ فَصَّلْنَـٰهُ",301],["17:14:7",283,"حَسِيبًۭا","(as) accountant","بِنَفْسِكَ ٱلْيَوْمَ عَلَيْكَ","",1512],["18:9:2",294,"حَسِبْتَ","have you thought","أَمْ","أَنَّ أَصْحَـٰبَ ٱلْكَهْفِ",265],["18:18:1",295,"وَتَحْسَبُهُمْ","And you (would) think them","","أَيْقَاظًۭا وَهُمْ رُقُودٌۭ ۚ",265],["18:40:10",298,"حُسْبَانًۭا","a calamity","جَنَّتِكَ وَيُرْسِلَ عَلَيْهَا","مِّنَ ٱلسَّمَآءِ فَتُصْبِحَ",1791],["18:102:1",304,"أَفَحَسِبَ","Do then think","","ٱلَّذِينَ كَفَرُوٓا۟ أَن",265],["18:104:8",304,"يَحْسَبُونَ","think","ٱلْحَيَوٰةِ ٱلدُّنْيَا وَهُمْ","أَنَّهُمْ يُحْسِنُونَ صُنْعًا",265],["21:1:3",322,"حِسَابُهُمْ","their account","ٱقْتَرَبَ لِلنَّاسِ","وَهُمْ فِى غَفْلَةٍۢ",301],["21:47:20",326,"حَـٰسِبِينَ","(as) Reckoners","بِهَا ۗ وَكَفَىٰ بِنَا","",2273],["23:55:1",345,"أَيَحْسَبُونَ","Do they think","","أَنَّمَا نُمِدُّهُم بِهِۦ",265],["23:115:1",349,"أَفَحَسِبْتُمْ","Then did you think","","أَنَّمَا خَلَقْنَـٰكُمْ عَبَثًۭا",265],["23:117:12",349,"حِسَابُهُۥ","his account","لَهُۥ بِهِۦ فَإِنَّمَا","عِندَ رَبِّهِۦٓ ۚ إِنَّهُۥ",301],["24:11:8",351,"تَحْسَبُوهُ","think it","عُصْبَةٌۭ مِّنكُمْ ۚ لَا","شَرًّۭا لَّكُم ۖ بَلْ",265],["24:15:11",351,"وَتَحْسَبُونَهُۥ","and you thought it","لَكُم بِهِۦ عِلْمٌۭ","هَيِّنًۭا وَهُوَ عِندَ",265],["24:38:14",355,"حِسَابٍۢ","measure","مَن يَشَآءُ بِغَيْرِ","",301],["24:39:6",355,"يَحْسَبُهُ","thinks it","أَعْمَـٰلُهُمْ كَسَرَابٍۭ بِقِيعَةٍۢ","ٱلظَّمْـَٔانُ مَآءً حَتَّىٰٓ",265],["24:39:19",355,"حِسَابَهُۥ ۗ","his due","ٱللَّهَ عِندَهُۥ فَوَفَّىٰهُ","وَٱللَّهُ سَرِيعُ ٱلْحِسَابِ",301],["24:39:22",355,"ٱلْحِسَابِ","(in) the account","حِسَابَهُۥ ۗ وَٱللَّهُ سَرِيعُ","",301],["24:57:2",357,"تَحْسَبَنَّ","think",