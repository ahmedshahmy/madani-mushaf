[["2:54:13",8,"بَارِئِكُمْ","your Creator","ٱلْعِجْلَ فَتُوبُوٓا۟ إِلَىٰ","فَٱقْتُلُوٓا۟ أَنفُسَكُمْ ذَٰلِكُمْ",1805],["2:54:20",8,"بَارِئِكُمْ","your Creator","خَيْرٌۭ لَّكُمْ عِندَ","فَتَابَ عَلَيْكُمْ ۚ إِنَّهُۥ",1805],["2:166:2",25,"تَبَرَّأَ","will disown","إِذْ","ٱلَّذِينَ ٱتُّبِعُوا۟ مِنَ",1400],["2:167:8",25,"فَنَتَبَرَّأَ","then we will disown","أَنَّ لَنَا كَرَّةًۭ","مِنْهُمْ كَمَا تَبَرَّءُوا۟",1400],["2:167:11",25,"تَبَرَّءُوا۟","they disown","فَنَتَبَرَّأَ مِنْهُمْ كَمَا","مِنَّا ۗ كَذَٰلِكَ يُرِيهِمُ",1400],["3:49:24",56,"وَأُبْرِئُ","And I cure","طَيْرًۢا بِإِذْنِ ٱللَّهِ ۖ","ٱلْأَكْمَهَ وَٱلْأَبْرَصَ وَأُحْىِ",2692],["4:112:9",96,"بَرِيٓـًۭٔا","(on) an innocent","ثُمَّ يَرْمِ بِهِۦ","فَقَدِ ٱحْتَمَلَ بُهْتَـٰنًۭا",727],["5:110:39",126,"وَتُبْرِئُ","and you heal","فَتَكُونُ طَيْرًۢا بِإِذْنِى ۖ","ٱلْأَكْمَهَ وَٱلْأَبْرَصَ بِإِذْنِى ۖ",2692],["6:19:35",130,"بَرِىٓءٌۭ","free","إِلَـٰهٌۭ وَٰحِدٌۭ وَإِنَّنِى","مِّمَّا تُشْرِكُونَ",727],["6:78:15",137,"بَرِىٓءٌۭ","free","قَالَ يَـٰقَوْمِ إِنِّى","مِّمَّا تُشْرِكُونَ",727],["8:48:24",183,"بَرِىٓءٌۭ","free","عَقِبَيْهِ وَقَالَ إِنِّى","مِّنكُمْ إِنِّىٓ أَرَىٰ",727],["9:1:1",187,"بَرَآءَةٌۭ","Freedom from obligations","","مِّنَ ٱللَّهِ وَرَسُولِهِۦٓ",2336],["9:3:12",187,"بَرِىٓءٌۭ","(is) free from obligations","ٱلْأَكْبَرِ أَنَّ ٱللَّهَ","مِّنَ ٱلْمُشْرِكِينَ ۙ وَرَسُولُهُۥ ۚ",727],["9:114:17",205,"تَبَرَّأَ","he disassociated","أَنَّهُۥ عَدُوٌّۭ لِّلَّهِ","مِنْهُ ۚ إِنَّ إِبْرَٰهِيمَ",1400],["10:41:9",213,"بَرِيٓـُٔونَ","(are) disassociated","وَلَكُمْ عَمَلُكُمْ ۖ أَنتُم","مِمَّآ أَعْمَلُ وَأَنَا۠",727],["10:41:13",213,"بَرِىٓءٌۭ","disassociated","مِمَّآ أَعْمَلُ وَأَنَا۠","مِّمَّا تَعْمَلُونَ",727],["11:35:10",225,"بَرِىٓءٌۭ","innocent","فَعَلَىَّ إِجْرَامِى وَأَنَا۠","مِّمَّا تُجْرِمُونَ",727],["11:54:14",228,"بَرِىٓءٌۭ","innocent","ٱللَّهَ وَٱشْهَدُوٓا۟ أَنِّى","مِّمَّا تُشْرِكُونَ",727],["12:53:2",242,"أُبَرِّئُ","I absolve","۞ وَمَآ","نَفْسِىٓ ۚ إِنَّ ٱلنَّفْسَ",2339],["24:26:10",352,"مُبَرَّءُونَ","(are) innocent","وَٱلطَّيِّبُونَ لِلطَّيِّبَـٰتِ ۚ أُو۟لَـٰٓئِكَ","مِمَّا يَقُولُونَ ۖ لَهُم",3785],["26:216:5",376,"بَرِىٓءٌۭ","innocent","عَصَوْكَ فَقُلْ إِنِّى","مِّمَّا تَعْمَلُونَ",727],["28:63:13",393,"تَبَرَّأْنَآ","We declare our innocence","أَغْوَيْنَـٰهُمْ كَمَا غَوَيْنَا ۖ","إِلَيْكَ ۖ مَا كَانُوٓا۟",1400],["33:69:9",427,"فَبَرَّأَهُ","then Allah cleared him","كَٱلَّذِينَ ءَاذَوْا۟ مُوسَىٰ","ٱللَّهُ مِمَّا قَالُوا۟ ۚ",2339],["43:26:7",491,"بَرَآءٌۭ","disassociated","لِأَبِيهِ وَقَوْمِهِۦٓ إِنَّنِى","مِّمَّا تَعْبُدُونَ",3342],["54:43:7",530,"بَرَآءَةٌۭ","(is) an exemption","أُو۟لَـٰٓئِكُمْ أَمْ لَكُم","فِى ٱلزُّبُرِ",2336],["57:22:16",540,"نَّبْرَأَهَآ ۚ","We bring it into existence","مِّن قَبْلِ أَن","إِنَّ ذَٰلِكَ عَلَى",4086],["59:16:11",547,"بَرِىٓءٌۭ","disassociated","كَفَرَ قَالَ إِنِّى","مِّنكَ إِنِّىٓ أَخَافُ",727],["59:24:4",548,"ٱلْبَارِئُ","the Inventor","هُوَ ٱللَّهُ ٱلْخَـٰلِقُ","ٱلْمُصَوِّرُ ۖ لَهُ ٱلْأَسْمَآءُ",1805],["60:4:14",549,"بُرَءَٰٓؤُا۟","(are) disassociated","قَالُوا۟ لِقَوْمِهِمْ إِنَّا","مِنكُمْ وَمِمَّا تَعْبُدُونَ",727],["98:6:16",599,"ٱلْبَرِيَّةِ","(of) the creatures","أُو۟لَـٰٓئِكَ هُمْ شَرُّ","",2337],["98:7:9",599,"ٱلْبَرِيَّةِ","(of) the creatures","أُو۟لَـٰٓئِكَ هُمْ خَيْرُ","",2337]]