[["2:11:11",3,"مُصْلِحُونَ","(are) reformers","قَالُوٓا۟ إِنَّمَا نَحْنُ","",1361],["2:25:5",5,"ٱلصَّـٰلِحَـٰتِ","[the] righteous deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","أَنَّ لَهُمْ جَنَّـٰتٍۢ",195],["2:62:14",10,"صَـٰلِحًۭا","righteous deeds","وَٱلْيَوْمِ ٱلْـَٔاخِرِ وَعَمِلَ","فَلَهُمْ أَجْرُهُمْ عِندَ",181],["2:82:4",12,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْجَنَّةِ ۖ",195],["2:130:18",20,"ٱلصَّـٰلِحِينَ","the righteous","فِى ٱلْـَٔاخِرَةِ لَمِنَ","",181],["2:160:4",24,"وَأَصْلَحُوا۟","and reform[ed]","إِلَّا ٱلَّذِينَ تَابُوا۟","وَبَيَّنُوا۟ فَأُو۟لَـٰٓئِكَ أَتُوبُ",381],["2:182:8",28,"فَأَصْلَحَ","then reconciles","جَنَفًا أَوْ إِثْمًۭا","بَيْنَهُمْ فَلَآ إِثْمَ",381],["2:220:8",35,"إِصْلَاحٌۭ","Setting right (their affairs)","عَنِ ٱلْيَتَـٰمَىٰ ۖ قُلْ","لَّهُمْ خَيْرٌۭ ۖ وَإِن",1030],["2:220:18",35,"ٱلْمُصْلِحِ ۚ","the amender","يَعْلَمُ ٱلْمُفْسِدَ مِنَ","وَلَوْ شَآءَ ٱللَّهُ",1361],["2:224:9",35,"وَتُصْلِحُوا۟","and make peace","أَن تَبَرُّوا۟ وَتَتَّقُوا۟","بَيْنَ ٱلنَّاسِ ۗ وَٱللَّهُ",381],["2:228:29",36,"إِصْلَـٰحًۭا ۚ","(for) reconciliation","ذَٰلِكَ إِنْ أَرَادُوٓا۟","وَلَهُنَّ مِثْلُ ٱلَّذِى",1030],["2:277:5",47,"ٱلصَّـٰلِحَـٰتِ","good deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","وَأَقَامُوا۟ ٱلصَّلَوٰةَ وَءَاتَوُا۟",195],["3:39:20",55,"ٱلصَّـٰلِحِينَ","the righteous","وَحَصُورًۭا وَنَبِيًّۭا مِّنَ","",181],["3:46:7",56,"ٱلصَّـٰلِحِينَ","the righteous","ٱلْمَهْدِ وَكَهْلًۭا وَمِنَ","",181],["3:57:5",57,"ٱلصَّـٰلِحَـٰتِ","[the] righteous deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","فَيُوَفِّيهِمْ أُجُورَهُمْ ۗ وَٱللَّهُ",195],["3:89:7",61,"وَأَصْلَحُوا۟","and reform[ed] themselves","مِنۢ بَعْدِ ذَٰلِكَ","فَإِنَّ ٱللَّهَ غَفُورٌۭ",381],["3:114:15",64,"ٱلصَّـٰلِحِينَ","the righteous","ٱلْخَيْرَٰتِ وَأُو۟لَـٰٓئِكَ مِنَ","",181],["4:16:7",80,"وَأَصْلَحَا","and correct themselves","فَـَٔاذُوهُمَا ۖ فَإِن تَابَا","فَأَعْرِضُوا۟ عَنْهُمَآ ۗ إِنَّ",381],["4:34:15",84,"فَٱلصَّـٰلِحَـٰتُ","So the righteous women","أَنفَقُوا۟ مِنْ أَمْوَٰلِهِمْ ۚ","قَـٰنِتَـٰتٌ حَـٰفِظَـٰتٌۭ لِّلْغَيْبِ",195],["4:35:14",84,"إِصْلَـٰحًۭا","reconciliation","أَهْلِهَآ إِن يُرِيدَآ","يُوَفِّقِ ٱللَّهُ بَيْنَهُمَآ ۗ",1030],["4:57:4",87,"ٱلصَّـٰلِحَـٰتِ","the good deeds","وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","سَنُدْخِلُهُمْ جَنَّـٰتٍۢ تَجْرِى",195],["4:69:15",89,"وَٱلصَّـٰلِحِينَ ۚ","and the righteous","ٱلنَّبِيِّـۧنَ وَٱلصِّدِّيقِينَ وَٱلشُّهَدَآءِ","وَحَسُنَ أُو۟لَـٰٓئِكَ رَفِيقًۭا",181],["4:114:14",97,"إِصْلَـٰحٍۭ","conciliation","أَوْ مَعْرُوفٍ أَوْ","بَيْنَ ٱلنَّاسِ ۚ وَمَن",1030],["4:122:4",98,"ٱلصَّـٰلِحَـٰتِ","[the] righteous deeds","وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","سَنُدْخِلُهُمْ جَنَّـٰتٍۢ تَجْرِى",195],["4:124:4",98,"ٱلصَّـٰلِحَـٰتِ","[the] righteous deeds","وَمَن يَعْمَلْ مِنَ","مِن ذَكَرٍ أَوْ",195],["4:128:13",99,"يُصْلِحَا","they make terms of peace","جُنَاحَ عَلَيْهِمَآ أَن","بَيْنَهُمَا صُلْحًۭا ۚ وَٱلصُّلْحُ",381],["4:128:15",99,"صُلْحًۭا ۚ","a reconciliation","أَن يُصْلِحَا بَيْنَهُمَا","وَٱلصُّلْحُ خَيْرٌۭ ۗ وَأُحْضِرَتِ",2300],["4:128:16",99,"وَٱلصُّلْحُ","and [the] reconciliation","يُصْلِحَا بَيْنَهُمَا صُلْحًۭا ۚ","خَيْرٌۭ ۗ وَأُحْضِرَتِ ٱلْأَنفُسُ",2300],["4:129:16",99,"تُصْلِحُوا۟","you reconcile","فَتَذَرُوهَا كَٱلْمُعَلَّقَةِ ۚ وَإِن","وَتَتَّقُوا۟ فَإِنَّ ٱللَّهَ",381],["4:146:4",101,"وَأَصْلَحُوا۟","and correct (themselves)","إِلَّا ٱلَّذِينَ تَابُوا۟","وَٱعْتَصَمُوا۟ بِٱللَّهِ وَأَخْلَصُوا۟",381],["4:173:5",105,"ٱلصَّـٰلِحَـٰتِ","the righteous deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","فَيُوَفِّيهِمْ أُجُورَهُمْ وَيَزِيدُهُم",195],["5:9:6",108,"ٱلصَّـٰلِحَـٰتِ ۙ","the righteous deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","لَهُم مَّغْفِرَةٌۭ وَأَجْرٌ",195],["5:39:6",114,"وَأَصْلَحَ","and reforms","مِنۢ بَعْدِ ظُلْمِهِۦ","فَإِنَّ ٱللَّهَ يَتُوبُ",381],["5:69:14",119,"صَـٰلِحًۭا","good deeds","وَٱلْيَوْمِ ٱلْـَٔاخِرِ وَعَمِلَ","فَلَا خَوْفٌ عَلَيْهِمْ",181],["5:84:16",122,"ٱلصَّـٰلِحِينَ","the righteous","رَبُّنَا مَعَ ٱلْقَوْمِ","",181],["5:93:6",123,"ٱلصَّـٰلِحَـٰتِ","the good deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","جُنَاحٌۭ فِيمَا طَعِمُوٓا۟",195],["5:93:15",123,"ٱلصَّـٰلِحَـٰتِ","[the] good deeds","ٱتَّقَوا۟ وَّءَامَنُوا۟ وَعَمِلُوا۟","ثُمَّ ٱتَّقَوا۟ وَّءَامَنُوا۟",195],["6:48:9",133,"وَأَصْلَحَ","and reformed","وَمُنذِرِينَ ۖ فَمَنْ ءَامَنَ","فَلَا خَوْفٌ عَلَيْهِمْ",381],["6:54:24",134,"وَأَصْلَحَ","and reforms","تَابَ مِنۢ بَعْدِهِۦ","فَأَنَّهُۥ غَفُورٌۭ رَّحِيمٌۭ",381],["6:85:7",138,"ٱلصَّـٰلِحِينَ","the righteous","وَإِلْيَاسَ ۖ كُلٌّۭ مِّنَ","",181],["7:35:12",154,"وَأَصْلَحَ","and reforms","ءَايَـٰتِى ۙ فَمَنِ ٱتَّقَىٰ","فَلَا خَوْفٌ عَلَيْهِمْ",381],["7:42:4",155,"ٱلصَّـٰلِحَـٰتِ","[the] righteous deeds","وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","لَا نُكَلِّفُ نَفْسًا",195],["7:56:6",157,"إِصْلَـٰحِهَا","its reformation","فِى ٱلْأَرْضِ بَعْدَ","وَٱدْعُوهُ خَوْفًۭا وَطَمَعًا ۚ",1030],["7:73:4",159,"صَـٰلِحًۭا ۗ","Salih","وَإِلَىٰ ثَمُودَ أَخَاهُمْ","قَالَ يَـٰقَوْمِ ٱعْبُدُوا۟",889],["7:75:14",160,"صَـٰلِحًۭا","Salih","مِنْهُمْ أَتَعْلَمُونَ أَنَّ","مُّرْسَلٌۭ مِّن رَّبِّهِۦ ۚ",889],["7:77:8",160,"يَـٰصَـٰلِحُ","O Salih","أَمْرِ رَبِّهِمْ وَقَالُوا۟","ٱئْتِنَا بِمَا تَعِدُنَآ",889],["7:85:31",161,"إِصْلَـٰحِهَا ۚ","its reformation","فِى ٱلْأَرْضِ بَعْدَ","ذَٰلِكُمْ خَيْرٌۭ لَّكُمْ",1030],["7:142:19",167,"وَأَصْلِحْ","and do right","ٱخْلُفْنِى فِى قَوْمِى","وَلَا تَتَّبِعْ سَبِيلَ",381],["7:168:6",172,"ٱلصَّـٰلِحُونَ","(are) the righteous","ٱلْأَرْضِ أُمَمًۭا ۖ مِّنْهُمُ","وَمِنْهُمْ دُونَ ذَٰلِكَ ۖ",181],["7:170:10",172,"ٱلْمُصْلِحِينَ","(of) the reformers","لَا نُضِيعُ أَجْرَ","",1361],["7:189:26",175,"صَـٰلِحًۭا","a righteous (child)","رَبَّهُمَا لَئِنْ ءَاتَيْتَنَا","لَّنَكُونَنَّ مِنَ ٱلشَّـٰكِرِينَ",181],["7:190:3",175,"صَـٰلِحًۭا","a good, (child)","فَلَمَّآ ءَاتَىٰهُمَا","جَعَلَا لَهُۥ شُرَكَآءَ",181],["7:196:9",176,"ٱلصَّـٰلِحِينَ","the righteous","ٱلْكِتَـٰبَ ۖ وَهُوَ يَتَوَلَّى","",181],["8:1:10",177,"وَأَصْلِحُوا۟","and set right","وَٱلرَّسُولِ ۖ فَٱتَّقُوا۟ ٱللَّهَ","ذَاتَ بَيْنِكُمْ ۖ وَأَطِيعُوا۟",381],["9:75:12",199,"ٱلصَّـٰلِحِينَ","the righteous","لَنَصَّدَّقَنَّ وَلَنَكُونَنَّ مِنَ","",181],["9:102:6",203,"صَـٰلِحًۭا","righteous","بِذُنُوبِهِمْ خَلَطُوا۟ عَمَلًۭا","وَءَاخَرَ سَيِّئًا عَسَى",181],["9:120:46",206,"صَـٰلِحٌ ۚ","righteous","لَهُم بِهِۦ عَمَلٌۭ","إِنَّ ٱللَّهَ لَا",181],["10:4:16",208,"ٱلصَّـٰلِحَـٰتِ","the good deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","بِٱلْقِسْطِ ۚ وَٱلَّذِينَ كَفَرُوا۟",195],["10:9:5",209,"ٱلصَّـٰلِحَـٰتِ","good deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","يَهْدِيهِمْ رَبُّهُم بِإِيمَـٰنِهِمْ ۖ",195],["10:81:15",218,"يُصْلِحُ","amend","إِنَّ ٱللَّهَ لَا","عَمَلَ ٱلْمُفْسِدِينَ",381],["11:11:5",222,"ٱلصَّـٰلِحَـٰتِ","the good deeds","ٱلَّذِينَ صَبَرُوا۟ وَعَمِلُوا۟","أُو۟لَـٰٓئِكَ لَهُم مَّغْفِرَةٌۭ",195],["11:23:5",224,"ٱلصَّـٰلِحَـٰتِ","good deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","وَأَخْبَتُوٓا۟ إِلَىٰ رَبِّهِمْ",195],["11:46:10",227,"صَـٰلِحٍۢ ۖ","righteous","إِنَّهُۥ عَمَلٌ غَيْرُ","فَلَا تَسْـَٔلْنِ مَا",181],["11:61:4",228,"صَـٰلِحًۭا ۚ","Salih","۞ وَإِلَىٰ ثَمُودَ أَخَاهُمْ","قَالَ يَـٰقَوْمِ ٱعْبُدُوا۟",889],["11:62:2",228,"يَـٰصَـٰلِحُ","O Salih","قَالُوا۟","قَدْ كُنتَ فِينَا",889],["11:66:5",229,"صَـٰلِحًۭا","Salih","جَآءَ أَمْرُنَا نَجَّيْنَا","وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ",889],["11:88:25",231,"ٱلْإِصْلَـٰحَ","the reform","إِنْ أُرِيدُ إِلَّا","مَا ٱسْتَطَعْتُ ۚ وَمَا",1030],["11:89:17",232,"صَـٰلِحٍۢ ۚ","people of Salih","هُودٍ أَوْ قَوْمَ","وَمَا قَوْمُ لُوطٍۢ",889],["11:117:8",234,"مُصْلِحُونَ","(were) reformers","ٱلْقُرَىٰ بِظُلْمٍۢ وَأَهْلُهَا","",1361],["12:9:14",236,"صَـٰلِحِينَ","righteous","مِنۢ بَعْدِهِۦ قَوْمًۭا","",181],["12:101:21",247,"بِٱلصَّـٰلِحِينَ","with the righteous","تَوَفَّنِى مُسْلِمًۭا وَأَلْحِقْنِى","",181],["13:23:5",252,"صَلَحَ","(were) righteous","عَدْنٍۢ يَدْخُلُونَهَا وَمَن","مِنْ ءَابَآئِهِمْ وَأَزْوَٰجِهِمْ",2294],["13:29:4",253,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","طُوبَىٰ لَهُمْ وَحُسْنُ",195],["14:23:5",258,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","جَنَّـٰتٍۢ تَجْرِى مِن",195],["16:97:3",278,"صَـٰلِحًۭا","righteous deeds","مَنْ عَمِلَ","مِّن ذَكَرٍ أَوْ",181],["16:119:13",281,"وَأَصْلَحُوٓا۟","and corrected themselves","مِنۢ بَعْدِ ذَٰلِكَ","إِنَّ رَبَّكَ مِنۢ",381],["16:122:9",281,"ٱلصَّـٰلِحِينَ","the righteous","فِى ٱلْـَٔاخِرَةِ لَمِنَ","",181],["17:9:12",283,"ٱلصَّـٰلِحَـٰتِ","the righteous deeds","ٱلْمُؤْمِنِينَ ٱلَّذِينَ يَعْمَلُونَ","أَنَّ لَهُمْ أَجْرًۭا",195],["17:25:8",284,"صَـٰلِحِينَ","righteous","نُفُوسِكُمْ ۚ إِن تَكُونُوا۟","فَإِنَّهُۥ كَانَ لِلْأَوَّٰبِينَ",181],["18:2:11",293,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","ٱلْمُؤْمِنِينَ ٱلَّذِينَ يَعْمَلُونَ","أَنَّ لَهُمْ أَجْرًا",195],["18:30:5",297,"ٱلصَّـٰلِحَـٰتِ","the good deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","إِنَّا لَا نُضِيعُ",195],["18:46:7",299,"ٱلصَّـٰلِحَـٰتُ","good deeds","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ وَٱلْبَـٰقِيَـٰتُ","خَيْرٌ عِندَ رَبِّكَ",195],["18:82:14",302,"صَـٰلِحًۭا","righteous","لَّهُمَا وَكَانَ أَبُوهُمَا","فَأَرَادَ رَبُّكَ أَن",181],["18:88:5",303,"صَـٰلِحًۭا","righteous (deeds)","مَنْ ءَامَنَ وَعَمِلَ","فَلَهُۥ جَزَآءً ٱلْحُسْنَىٰ ۖ",181],["18:107:5",304,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","كَانَتْ لَهُمْ جَنَّـٰتُ",195],["18:110:19",304,"صَـٰلِحًۭا","righteous","رَبِّهِۦ فَلْيَعْمَلْ عَمَلًۭا","وَلَا يُشْرِكْ بِعِبَادَةِ",181],["19:60:6",309,"صَـٰلِحًۭا","good (deeds)","تَابَ وَءَامَنَ وَعَمِلَ","فَأُو۟لَـٰٓئِكَ يَدْخُلُونَ ٱلْجَنَّةَ",181],["19:76:7",310,"ٱلصَّـٰلِحَـٰتُ","good deeds","ٱهْتَدَوْا۟ هُدًۭى ۗ وَٱلْبَـٰقِيَـٰتُ","خَيْرٌ عِندَ رَبِّكَ",195],["19:96:5",312,"ٱلصَّـٰلِحَـٰتِ","good deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","سَيَجْعَلُ لَهُمُ ٱلرَّحْمَـٰنُ",195],["20:75:6",316,"ٱلصَّـٰلِحَـٰتِ","the righteous deeds","مُؤْمِنًۭا قَدْ عَمِلَ","فَأُو۟لَـٰٓئِكَ لَهُمُ ٱلدَّرَجَـٰتُ",195],["20:82:7",317,"صَـٰلِحًۭا","righteous (deeds)","تَابَ وَءَامَنَ وَعَمِلَ","ثُمَّ ٱهْتَدَىٰ",181],["20:112:4",319,"ٱلصَّـٰلِحَـٰتِ","the righteous deeds","وَمَن يَعْمَلْ مِنَ","وَهُوَ مُؤْمِنٌۭ فَلَا",195],["21:72:8",327,"صَـٰلِحِينَ","righteous","نَافِلَةًۭ ۖ وَكُلًّۭا جَعَلْنَا","",181],["21:75:6",328,"ٱلصَّـٰلِحِينَ","the righteous","رَحْمَتِنَآ ۖ إِنَّهُۥ مِنَ","",181],["21:86:6",329,"ٱلصَّـٰلِحِينَ","the righteous","رَحْمَتِنَآ ۖ إِنَّهُم مِّنَ","",181],["21:90:6",329,"وَأَصْلَحْنَا","and We cured","وَوَهَبْنَا لَهُۥ يَحْيَىٰ","لَهُۥ زَوْجَهُۥٓ ۚ إِنَّهُمْ",381],["21:94:4",330,"ٱلصَّـٰلِحَـٰتِ","[the] righteous deeds","فَمَن يَعْمَلْ مِنَ","وَهُوَ مُؤْمِنٌۭ فَلَا",195],["21:105:12",331,"ٱلصَّـٰلِحُونَ","the righteous","ٱلْأَرْضَ يَرِثُهَا عِبَادِىَ","",181],["22:14:7",333,"ٱلصَّـٰلِحَـٰتِ","the righteous deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","جَنَّـٰتٍۢ تَجْرِى مِن",195],["22:23:7",334,"ٱلصَّـٰلِحَـٰتِ","the righteous deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","جَنَّـٰتٍۢ تَجْرِى مِن",195],["22:50:4",338,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","فَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","لَهُم مَّغْفِرَةٌۭ وَرِزْقٌۭ",195],["22:56:9",339,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","فَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","فِى جَنَّـٰتِ ٱلنَّعِيمِ",195],["23:51:7",345,"صَـٰلِحًا ۖ","righteous (deeds)","مِنَ ٱلطَّيِّبَـٰتِ وَٱعْمَلُوا۟","إِنِّى بِمَا تَعْمَلُونَ",181],["23:100:3",348,"صَـٰلِحًۭا","righteous (deeds)","لَعَلِّىٓ أَعْمَلُ","فِيمَا تَرَكْتُ ۚ كَلَّآ ۚ",181],["24:5:7",350,"وَأَصْلَحُوا۟","and reform","مِنۢ بَعْدِ ذَٰلِكَ","فَإِنَّ ٱللَّهَ غَفُورٌۭ",381],["24:32:4",354,"وَٱلصَّـٰلِحِينَ","and the righteous","وَأَنكِحُوا۟ ٱلْأَيَـٰمَىٰ مِنكُمْ","مِنْ عِبَادِكُمْ وَإِمَآئِكُمْ ۚ",181],["24:55:7",357,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","ءَامَنُوا۟ مِنكُمْ وَعَمِلُوا۟","لَيَسْتَخْلِفَنَّهُمْ فِى ٱلْأَرْضِ",195],["25:70:7",366,"صَـٰلِحًۭا","righteous deeds","وَءَامَنَ وَعَمِلَ عَمَلًۭا","فَأُو۟لَـٰٓئِكَ يُبَدِّلُ ٱللَّهُ",181],["25:71:4",366,"صَـٰلِحًۭا","righteous (deeds)","وَمَن تَابَ وَعَمِلَ","فَإِنَّهُۥ يَتُوبُ إِلَى",181],["26:83:6",370,"بِٱلصَّـٰلِحِينَ","with the righteous","لِى حُكْمًۭا وَأَلْحِقْنِى","",181],["26:142:5",373,"صَـٰلِحٌ","Salih","قَالَ لَهُمْ أَخُوهُمْ","أَلَا تَتَّقُونَ",889],["26:152:6",373,"يُصْلِحُونَ","reform","فِى ٱلْأَرْضِ وَلَا","",381],["26:227:5",376,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","وَذَكَرُوا۟ ٱللَّهَ كَثِيرًۭا",195],["27:19:18",378,"صَـٰلِحًۭا","righteous (deeds)","وَٰلِدَىَّ وَأَنْ أَعْمَلَ","تَرْضَىٰهُ وَأَدْخِلْنِى بِرَحْمَتِكَ",181],["27:19:24",378,"ٱلصَّـٰلِحِينَ","righteous","بِرَحْمَتِكَ فِى عِبَادِكَ","",181],["27:45:6",381,"صَـٰلِحًا","Salih","إِلَىٰ ثَمُودَ أَخَاهُمْ","أَنِ ٱعْبُدُوا۟ ٱللَّهَ",889],["27:48:10",381,"يُصْلِحُونَ","reforming","فِى ٱلْأَرْضِ وَلَا","",381],["28:19:32",387,"ٱلْمُصْلِحِينَ","the reformers","أَن تَكُونَ مِنَ","",1361],["28:27:29",388,"ٱلصَّـٰلِحِينَ","the righteous","شَآءَ ٱللَّهُ مِنَ","",181],["28:67:6",393,"صَـٰلِحًۭا","righteousness","تَابَ وَءَامَنَ وَعَمِلَ","فَعَسَىٰٓ أَن يَكُونَ",181],["28:80:12",395,"صَـٰلِحًۭا","righteous (deeds)","لِّمَنْ ءَامَنَ وَعَمِلَ","وَلَا يُلَقَّىٰهَآ إِلَّا",181],["29:7:4",397,"ٱلصَّـٰلِحَـٰتِ","righteous (deeds)","وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","لَنُكَفِّرَنَّ عَنْهُمْ سَيِّـَٔاتِهِمْ",195],["29:9:4",397,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","لَنُدْخِلَنَّهُمْ فِى ٱلصَّـٰلِحِينَ",195],["29:9:7",397,"ٱلصَّـٰلِحِينَ","the righteous","ٱلصَّـٰلِحَـٰتِ لَنُدْخِلَنَّهُمْ فِى","",181],["29:27:18",399,"ٱلصَّـٰلِحِينَ","the righteous","فِى ٱلْـَٔاخِرَةِ لَمِنَ","",181],["29:58:4",403,"ٱلصَّـٰلِحَـٰتِ","[the] righteous deeds","وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","لَنُبَوِّئَنَّهُم مِّنَ ٱلْجَنَّةِ",195],["30:15:5",405,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","فَهُمْ فِى رَوْضَةٍۢ",195],["30:44:7",409,"صَـٰلِحًۭا","righteousness","كُفْرُهُۥ ۖ وَمَنْ عَمِلَ","فَلِأَنفُسِهِمْ يَمْهَدُونَ",181],["30:45:5",409,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟","مِن فَضْلِهِۦٓ ۚ إِنَّهُۥ",195],["31:8:5",411,"ٱلصَّـٰلِحَـٰتِ","righteous deeds","ٱلَّذِينَ