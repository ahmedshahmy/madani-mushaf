[["2:233:18",37,"تُكَلَّفُ","is burdened","وَكِسْوَتُهُنَّ بِٱلْمَعْرُوفِ ۚ لَا","نَفْسٌ إِلَّا وُسْعَهَا ۚ",1116],["2:286:2",49,"يُكَلِّفُ","burden","لَا","ٱللَّهُ نَفْسًا إِلَّا",1116],["4:84:6",91,"تُكَلَّفُ","are you responsible","سَبِيلِ ٱللَّهِ لَا","إِلَّا نَفْسَكَ ۚ وَحَرِّضِ",1116],["6:152:17",149,"نُكَلِّفُ","We burden","وَٱلْمِيزَانَ بِٱلْقِسْطِ ۖ لَا","نَفْسًا إِلَّا وُسْعَهَا ۖ",1116],["7:42:6",155,"نُكَلِّفُ","We burden","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَا","نَفْسًا إِلَّا وُسْعَهَآ",1116],["23:62:2",346,"نُكَلِّفُ","We burden","وَلَا","نَفْسًا إِلَّا وُسْعَهَا ۖ",1116],["38:86:10",458,"ٱلْمُتَكَلِّفِينَ","the ones who pretend","وَمَآ أَنَا۠ مِنَ","",3874],["65:7:15",559,"يُكَلِّفُ","burden","ءَاتَىٰهُ ٱللَّهُ ۚ لَا","ٱللَّهُ نَفْسًا إِلَّا",1116]]