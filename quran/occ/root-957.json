[["4:84:9",91,"وَحَرِّضِ","And encourage","تُكَلَّفُ إِلَّا نَفْسَكَ ۚ","ٱلْمُؤْمِنِينَ ۖ عَسَى ٱللَّهُ",2278],["8:65:3",185,"حَرِّضِ","Urge","يَـٰٓأَيُّهَا ٱلنَّبِىُّ","ٱلْمُؤْمِنِينَ عَلَى ٱلْقِتَالِ ۚ",2278],["12:85:8",245,"حَرَضًا","fatally ill","يُوسُفَ حَتَّىٰ تَكُونَ","أَوْ تَكُونَ مِنَ",3191]]