[["7:85:2",161,"مَدْيَنَ","Madyan","وَإِلَىٰ","أَخَاهُمْ شُعَيْبًۭا ۗ قَالَ",843],["9:70:14",198,"مَدْيَنَ","(of) Madyan","وَقَوْمِ إِبْرَٰهِيمَ وَأَصْحَـٰبِ","وَٱلْمُؤْتَفِكَـٰتِ ۚ أَتَتْهُمْ رُسُلُهُم",843],["11:84:2",231,"مَدْيَنَ","Madyan","۞ وَإِلَىٰ","أَخَاهُمْ شُعَيْبًۭا ۚ قَالَ",843],["11:95:7",232,"لِّمَدْيَنَ","with Madyan","فِيهَآ ۗ أَلَا بُعْدًۭا","كَمَا بَعِدَتْ ثَمُودُ",843],["20:40:29",314,"مَدْيَنَ","(of) Madyan","سِنِينَ فِىٓ أَهْلِ","ثُمَّ جِئْتَ عَلَىٰ",843],["22:44:2",337,"مَدْيَنَ ۖ","(of) Madyan","وَأَصْحَـٰبُ","وَكُذِّبَ مُوسَىٰ فَأَمْلَيْتُ",843],["28:22:4",388,"مَدْيَنَ","Madyan","وَلَمَّا تَوَجَّهَ تِلْقَآءَ","قَالَ عَسَىٰ رَبِّىٓ",843],["28:23:4",388,"مَدْيَنَ","(of) Madyan","وَلَمَّا وَرَدَ مَآءَ","وَجَدَ عَلَيْهِ أُمَّةًۭ",843],["28:45:12",391,"مَدْيَنَ","(of) Madyan","ثَاوِيًۭا فِىٓ أَهْلِ","تَتْلُوا۟ عَلَيْهِمْ ءَايَـٰتِنَا",843],["29:36:2",400,"مَدْيَنَ","Madyan","وَإِلَىٰ","أَخَاهُمْ شُعَيْبًۭا فَقَالَ",843]]