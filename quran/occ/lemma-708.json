[["3:3:11",50,"وَٱلْإِنجِيلَ","and the Injeel","يَدَيْهِ وَأَنزَلَ ٱلتَّوْرَىٰةَ","",708],["3:48:5",56,"وَٱلْإِنجِيلَ","and the Injeel","ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ وَٱلتَّوْرَىٰةَ","",708],["3:65:10",58,"وَٱلْإِنجِيلُ","and the Injeel","وَمَآ أُنزِلَتِ ٱلتَّوْرَىٰةُ","إِلَّا مِنۢ بَعْدِهِۦٓ ۚ",708],["5:46:14",116,"ٱلْإِنجِيلَ","the Injeel","مِنَ ٱلتَّوْرَىٰةِ ۖ وَءَاتَيْنَـٰهُ","فِيهِ هُدًۭى وَنُورٌۭ",708],["5:47:3",116,"ٱلْإِنجِيلِ","(of) the Injeel","وَلْيَحْكُمْ أَهْلُ","بِمَآ أَنزَلَ ٱللَّهُ",708],["5:66:5",119,"وَٱلْإِنجِيلَ","and the Injeel","أَنَّهُمْ أَقَامُوا۟ ٱلتَّوْرَىٰةَ","وَمَآ أُنزِلَ إِلَيْهِم",708],["5:68:10",119,"وَٱلْإِنجِيلَ","and the Injeel","حَتَّىٰ تُقِيمُوا۟ ٱلتَّوْرَىٰةَ","وَمَآ أُنزِلَ إِلَيْكُم",708],["5:110:26",126,"وَٱلْإِنجِيلَ ۖ","and the Injeel","ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ وَٱلتَّوْرَىٰةَ","وَإِذْ تَخْلُقُ مِنَ",708],["7:157:12",170,"وَٱلْإِنجِيلِ","and the Injeel","عِندَهُمْ فِى ٱلتَّوْرَىٰةِ","يَأْمُرُهُم بِٱلْمَعْرُوفِ وَيَنْهَىٰهُمْ",708],["9:111:22",204,"وَٱلْإِنجِيلِ","and the Injeel","حَقًّۭا فِى ٱلتَّوْرَىٰةِ","وَٱلْقُرْءَانِ ۚ وَمَنْ أَوْفَىٰ",708],["48:29:31",515,"ٱلْإِنجِيلِ","the Injeel","ٱلتَّوْرَىٰةِ ۚ وَمَثَلُهُمْ فِى","كَزَرْعٍ أَخْرَجَ شَطْـَٔهُۥ",708],["57:27:11",541,"ٱلْإِنجِيلَ","the Injeel","ٱبْنِ مَرْيَمَ وَءَاتَيْنَـٰهُ","وَجَعَلْنَا فِى قُلُوبِ",708]]