[["3:49:16",56,"كَهَيْـَٔةِ","like the form","لَكُم مِّنَ ٱلطِّينِ","ٱلطَّيْرِ فَأَنفُخُ فِيهِ",2391],["5:110:31",126,"كَهَيْـَٔةِ","like the shape","تَخْلُقُ مِنَ ٱلطِّينِ","ٱلطَّيْرِ بِإِذْنِى فَتَنفُخُ",2391],["18:10:12",294,"وَهَيِّئْ","and facilitate","مِن لَّدُنكَ رَحْمَةًۭ","لَنَا مِنْ أَمْرِنَا",2807],["18:16:15",295,"وَيُهَيِّئْ","and will facilitate","رَبُّكُم مِّن رَّحْمَتِهِۦ","لَكُم مِّنْ أَمْرِكُم",2807]]