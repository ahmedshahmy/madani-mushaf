[["6:110:2",141,"أَفْـِٔدَتَهُمْ","their hearts","وَنُقَلِّبُ","وَأَبْصَـٰرَهُمْ كَمَا لَمْ",595],["6:113:3",142,"أَفْـِٔدَةُ","hearts","وَلِتَصْغَىٰٓ إِلَيْهِ","ٱلَّذِينَ لَا يُؤْمِنُونَ",595],["11:120:10",235,"فُؤَادَكَ ۚ","your heart","مَا نُثَبِّتُ بِهِۦ","وَجَآءَكَ فِى هَـٰذِهِ",595],["14:37:17",260,"أَفْـِٔدَةًۭ","hearts","لِيُقِيمُوا۟ ٱلصَّلَوٰةَ فَٱجْعَلْ","مِّنَ ٱلنَّاسِ تَهْوِىٓ",595],["14:43:8",261,"وَأَفْـِٔدَتُهُمْ","and their hearts","يَرْتَدُّ إِلَيْهِمْ طَرْفُهُمْ ۖ","هَوَآءٌۭ",595],["16:78:13",275,"وَٱلْأَفْـِٔدَةَ ۙ","and the hearts","لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ","لَعَلَّكُمْ تَشْكُرُونَ",595],["17:36:11",285,"وَٱلْفُؤَادَ","and the heart","إِنَّ ٱلسَّمْعَ وَٱلْبَصَرَ","كُلُّ أُو۟لَـٰٓئِكَ كَانَ",595],["23:78:7",347,"وَٱلْأَفْـِٔدَةَ ۚ","and the feeling","لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ","قَلِيلًۭا مَّا تَشْكُرُونَ",595],["25:32:13",362,"فُؤَادَكَ ۖ","your heart","كَذَٰلِكَ لِنُثَبِّتَ بِهِۦ","وَرَتَّلْنَـٰهُ تَرْتِيلًۭا",595],["28:10:2",386,"فُؤَادُ","(the) heart","وَأَصْبَحَ","أُمِّ مُوسَىٰ فَـٰرِغًا ۖ",595],["32:9:11",415,"وَٱلْأَفْـِٔدَةَ ۚ","and feelings","لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ","قَلِيلًۭا مَّا تَشْكُرُونَ",595],["46:26:11",505,"وَأَفْـِٔدَةًۭ","and hearts","لَهُمْ سَمْعًۭا وَأَبْصَـٰرًۭا","فَمَآ أَغْنَىٰ عَنْهُمْ",595],["46:26:19",505,"أَفْـِٔدَتُهُم","their hearts","وَلَآ أَبْصَـٰرُهُمْ وَلَآ","مِّن شَىْءٍ إِذْ",595],["53:11:3",526,"ٱلْفُؤَادُ","the heart","مَا كَذَبَ","مَا رَأَىٰٓ",595],["67:23:9",563,"وَٱلْأَفْـِٔدَةَ ۖ","and the feelings","لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ","قَلِيلًۭا مَّا تَشْكُرُونَ",595],["104:7:4",601,"ٱلْأَفْـِٔدَةِ","the hearts","ٱلَّتِى تَطَّلِعُ عَلَى","",595]]