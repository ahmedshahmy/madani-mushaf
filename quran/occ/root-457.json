[["2:267:16",45,"ٱلْخَبِيثَ","the bad","ٱلْأَرْضِ ۖ وَلَا تَيَمَّمُوا۟","مِنْهُ تُنفِقُونَ وَلَسْتُم",932],["3:179:12",73,"ٱلْخَبِيثَ","the evil","عَلَيْهِ حَتَّىٰ يَمِيزَ","مِنَ ٱلطَّيِّبِ ۗ وَمَا",932],["4:2:6",77,"ٱلْخَبِيثَ","the bad","أَمْوَٰلَهُمْ ۖ وَلَا تَتَبَدَّلُوا۟","بِٱلطَّيِّبِ ۖ وَلَا تَأْكُلُوٓا۟",932],["5:100:4",124,"ٱلْخَبِيثُ","the evil","قُل لَّا يَسْتَوِى","وَٱلطَّيِّبُ وَلَوْ أَعْجَبَكَ",932],["5:100:9",124,"ٱلْخَبِيثِ ۚ","(of) the evil","وَلَوْ أَعْجَبَكَ كَثْرَةُ","فَٱتَّقُوا۟ ٱللَّهَ يَـٰٓأُو۟لِى",932],["7:58:8",158,"خَبُثَ","is bad","بِإِذْنِ رَبِّهِۦ ۖ وَٱلَّذِى","لَا يَخْرُجُ إِلَّا",4570],["7:157:23",170,"ٱلْخَبَـٰٓئِثَ","the impure things","ٱلطَّيِّبَـٰتِ وَيُحَرِّمُ عَلَيْهِمُ","وَيَضَعُ عَنْهُمْ إِصْرَهُمْ",1663],["8:37:3",181,"ٱلْخَبِيثَ","the wicked","لِيَمِيزَ ٱللَّهُ","مِنَ ٱلطَّيِّبِ وَيَجْعَلَ",932],["8:37:7",181,"ٱلْخَبِيثَ","the wicked","مِنَ ٱلطَّيِّبِ وَيَجْعَلَ","بَعْضَهُۥ عَلَىٰ بَعْضٍۢ",932],["14:26:3",259,"خَبِيثَةٍۢ","evil","وَمَثَلُ كَلِمَةٍ","كَشَجَرَةٍ خَبِيثَةٍ ٱجْتُثَّتْ",1663],["14:26:5",259,"خَبِيثَةٍ","evil","كَلِمَةٍ خَبِيثَةٍۢ كَشَجَرَةٍ","ٱجْتُثَّتْ مِن فَوْقِ",1663],["21:74:11",328,"ٱلْخَبَـٰٓئِثَ ۗ","wicked deeds","ٱلَّتِى كَانَت تَّعْمَلُ","إِنَّهُمْ كَانُوا۟ قَوْمَ",1663],["24:26:1",352,"ٱلْخَبِيثَـٰتُ","Evil women","","لِلْخَبِيثِينَ وَٱلْخَبِيثُونَ لِلْخَبِيثَـٰتِ ۖ",2734],["24:26:2",352,"لِلْخَبِيثِينَ","(are) for evil men","ٱلْخَبِيثَـٰتُ","وَٱلْخَبِيثُونَ لِلْخَبِيثَـٰتِ ۖ وَٱلطَّيِّبَـٰتُ",932],["24:26:3",352,"وَٱلْخَبِيثُونَ","and evil men","ٱلْخَبِيثَـٰتُ لِلْخَبِيثِينَ","لِلْخَبِيثَـٰتِ ۖ وَٱلطَّيِّبَـٰتُ لِلطَّيِّبِينَ",932],["24:26:4",352,"لِلْخَبِيثَـٰتِ ۖ","(are) for evil women","ٱلْخَبِيثَـٰتُ لِلْخَبِيثِينَ وَٱلْخَبِيثُونَ","وَٱلطَّيِّبَـٰتُ لِلطَّيِّبِينَ وَٱلطَّيِّبُونَ",2734]]