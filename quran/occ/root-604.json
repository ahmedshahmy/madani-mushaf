[["3:153:2",69,"تُصْعِدُونَ","you were running uphill","۞ إِذْ","وَلَا تَلْوُۥنَ عَلَىٰٓ",4454],["4:43:39",85,"صَعِيدًۭا","(with) earth","تَجِدُوا۟ مَآءًۭ فَتَيَمَّمُوا۟","طَيِّبًۭا فَٱمْسَحُوا۟ بِوُجُوهِكُمْ",1517],["5:6:41",108,"صَعِيدًۭا","(with) earth","تَجِدُوا۟ مَآءًۭ فَتَيَمَّمُوا۟","طَيِّبًۭا فَٱمْسَحُوا۟ بِوُجُوهِكُمْ",1517],["6:125:18",144,"يَصَّعَّدُ","he (were) climbing","ضَيِّقًا حَرَجًۭا كَأَنَّمَا","فِى ٱلسَّمَآءِ ۚ كَذَٰلِكَ",4617],["18:8:5",294,"صَعِيدًۭا","soil","لَجَـٰعِلُونَ مَا عَلَيْهَا","جُرُزًا",1517],["18:40:14",298,"صَعِيدًۭا","ground","مِّنَ ٱلسَّمَآءِ فَتُصْبِحَ","زَلَقًا",1517],["35:10:9",435,"يَصْعَدُ","ascends","ٱلْعِزَّةُ جَمِيعًا ۚ إِلَيْهِ","ٱلْكَلِمُ ٱلطَّيِّبُ وَٱلْعَمَلُ",4613],["72:17:10",573,"صَعَدًۭا","severe","رَبِّهِۦ يَسْلُكْهُ عَذَابًۭا","",3232],["74:17:2",575,"صَعُودًا","(with) a laborious punishment","سَأُرْهِقُهُۥ","",3234]]