[["9:8:10",188,"ذِمَّةًۭ ۚ","covenant of protection","فِيكُمْ إِلًّۭا وَلَا","يُرْضُونَكُم بِأَفْوَٰهِهِمْ وَتَأْبَىٰ",2130],["9:10:7",188,"ذِمَّةًۭ ۚ","covenant of protection","مُؤْمِنٍ إِلًّۭا وَلَا","وَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُعْتَدُونَ",2130],["17:18:17",284,"مَذْمُومًۭا","disgraced","لَهُۥ جَهَنَّمَ يَصْلَىٰهَا","مَّدْحُورًۭا",1877],["17:22:8",284,"مَذْمُومًۭا","disgraced","إِلَـٰهًا ءَاخَرَ فَتَقْعُدَ","مَّخْذُولًۭا",1877],["68:49:10",566,"مَذْمُومٌۭ","(was) blamed","لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ","",1877]]