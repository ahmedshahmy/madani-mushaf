[["2:268:3",45,"ٱلْفَقْرَ","[the] poverty","ٱلشَّيْطَـٰنُ يَعِدُكُمُ","وَيَأْمُرُكُم بِٱلْفَحْشَآءِ ۖ وَٱللَّهُ",3416],["2:271:9",46,"ٱلْفُقَرَآءَ","(to) the poor","وَإِن تُخْفُوهَا وَتُؤْتُوهَا","فَهُوَ خَيْرٌۭ لَّكُمْ ۚ",728],["2:273:1",46,"لِلْفُقَرَآءِ","For the poor","","ٱلَّذِينَ أُحْصِرُوا۟ فِى",728],["3:181:9",74,"فَقِيرٌۭ","(is) poor","قَالُوٓا۟ إِنَّ ٱللَّهَ","وَنَحْنُ أَغْنِيَآءُ ۘ سَنَكْتُبُ",728],["4:6:26",77,"فَقِيرًۭا","poor","فَلْيَسْتَعْفِفْ ۖ وَمَن كَانَ","فَلْيَأْكُلْ بِٱلْمَعْرُوفِ ۚ فَإِذَا",728],["4:135:19",100,"فَقِيرًۭا","poor","يَكُنْ غَنِيًّا أَوْ","فَٱللَّهُ أَوْلَىٰ بِهِمَا ۖ",728],["9:60:3",196,"لِلْفُقَرَآءِ","(are) for the poor","۞ إِنَّمَا ٱلصَّدَقَـٰتُ","وَٱلْمَسَـٰكِينِ وَٱلْعَـٰمِلِينَ عَلَيْهَا",728],["22:28:20",335,"ٱلْفَقِيرَ","the poor","مِنْهَا وَأَطْعِمُوا۟ ٱلْبَآئِسَ","",728],["24:32:10",354,"فُقَرَآءَ","poor","وَإِمَآئِكُمْ ۚ إِن يَكُونُوا۟","يُغْنِهِمُ ٱللَّهُ مِن",728],["28:24:15",388,"فَقِيرٌۭ","(in) need","إِلَىَّ مِنْ خَيْرٍۢ","",728],["35:15:4",436,"ٱلْفُقَرَآءُ","(are) those in need","۞ يَـٰٓأَيُّهَا ٱلنَّاسُ أَنتُمُ","إِلَى ٱللَّهِ ۖ وَٱللَّهُ",728],["47:38:20",510,"ٱلْفُقَرَآءُ ۚ","(are) the needy","وَٱللَّهُ ٱلْغَنِىُّ وَأَنتُمُ","وَإِن تَتَوَلَّوْا۟ يَسْتَبْدِلْ",728],["59:8:1",546,"لِلْفُقَرَآءِ","For the poor","","ٱلْمُهَـٰجِرِينَ ٱلَّذِينَ أُخْرِجُوا۟",728],["75:25:5",578,"فَاقِرَةٌۭ","backbreaking","أَن يُفْعَلَ بِهَا","",3397]]