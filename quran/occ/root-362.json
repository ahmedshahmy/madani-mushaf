[["2:67:20",10,"ٱلْجَـٰهِلِينَ","the ignorant","أَنْ أَكُونَ مِنَ","",836],["2:273:13",46,"ٱلْجَاهِلُ","the ignorant one","فِى ٱلْأَرْضِ يَحْسَبُهُمُ","أَغْنِيَآءَ مِنَ ٱلتَّعَفُّفِ",836],["3:154:21",70,"ٱلْجَـٰهِلِيَّةِ ۖ","(of) [the] ignorance","غَيْرَ ٱلْحَقِّ ظَنَّ","يَقُولُونَ هَل لَّنَا",3513],["4:17:8",80,"بِجَهَـٰلَةٍۢ","in ignorance","لِلَّذِينَ يَعْمَلُونَ ٱلسُّوٓءَ","ثُمَّ يَتُوبُونَ مِن",1559],["5:50:2",116,"ٱلْجَـٰهِلِيَّةِ","(of the time of) ignorance","أَفَحُكْمَ","يَبْغُونَ ۚ وَمَنْ أَحْسَنُ",1855],["6:35:28",131,"ٱلْجَـٰهِلِينَ","the ignorant","فَلَا تَكُونَنَّ مِنَ","",836],["6:54:19",134,"بِجَهَـٰلَةٍۢ","in ignorance","عَمِلَ مِنكُمْ سُوٓءًۢا","ثُمَّ تَابَ مِنۢ",1559],["6:111:22",142,"يَجْهَلُونَ","(are) ignorant","ٱللَّهُ وَلَـٰكِنَّ أَكْثَرَهُمْ","",1431],["7:138:23",167,"تَجْهَلُونَ","ignorant","قَالَ إِنَّكُمْ قَوْمٌۭ","",1431],["7:199:7",176,"ٱلْجَـٰهِلِينَ","the ignorant","بِٱلْعُرْفِ وَأَعْرِضْ عَنِ","",836],["11:29:22",225,"تَجْهَلُونَ","ignorant","وَلَـٰكِنِّىٓ أَرَىٰكُمْ قَوْمًۭا","",1431],["11:46:23",227,"ٱلْجَـٰهِلِينَ","the ignorant","أَن تَكُونَ مِنَ","",836],["12:33:17",239,"ٱلْجَـٰهِلِينَ","the ignorant","إِلَيْهِنَّ وَأَكُن مِّنَ","",836],["12:89:10",246,"جَـٰهِلُونَ","ignorant","وَأَخِيهِ إِذْ أَنتُمْ","",836],["16:119:7",281,"بِجَهَـٰلَةٍۢ","in ignorance","لِلَّذِينَ عَمِلُوا۟ ٱلسُّوٓءَ","ثُمَّ تَابُوا۟ مِنۢ",1559],["25:63:10",365,"ٱلْجَـٰهِلُونَ","the ignorant ones","هَوْنًۭا وَإِذَا خَاطَبَهُمُ","قَالُوا۟ سَلَـٰمًۭا",836],["27:55:11",381,"تَجْهَلُونَ","ignorant","بَلْ أَنتُمْ قَوْمٌۭ","",1431],["28:55:15",392,"ٱلْجَـٰهِلِينَ","the ignorant","عَلَيْكُمْ لَا نَبْتَغِى","",836],["33:33:7",422,"ٱلْجَـٰهِلِيَّةِ","(of the times of) ignorance","وَلَا تَبَرَّجْنَ تَبَرُّجَ","ٱلْأُولَىٰ ۖ وَأَقِمْنَ ٱلصَّلَوٰةَ",1855],["33:72:18",427,"جَهُولًۭا","ignorant","إِنَّهُۥ كَانَ ظَلُومًۭا","",3517],["39:64:7",465,"ٱلْجَـٰهِلُونَ","ignorant ones","تَأْمُرُوٓنِّىٓ أَعْبُدُ أَيُّهَا","",836],["46:23:13",505,"تَجْهَلُونَ","ignorant","وَلَـٰكِنِّىٓ أَرَىٰكُمْ قَوْمًۭا","",1431],["48:26:9",514,"ٱلْجَـٰهِلِيَّةِ","(of the time of) ignorance","قُلُوبِهِمُ ٱلْحَمِيَّةَ حَمِيَّةَ","فَأَنزَلَ ٱللَّهُ سَكِينَتَهُۥ",1855],["49:6:12",516,"بِجَهَـٰلَةٍۢ","in ignorance","أَن تُصِيبُوا۟ قَوْمًۢا","فَتُصْبِحُوا۟ عَلَىٰ مَا",1559]]