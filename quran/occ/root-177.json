[["2:80:3",12,"تَمَسَّنَا","will touch us","وَقَالُوا۟ لَن","ٱلنَّارُ إِلَّآ أَيَّامًۭا",215],["2:214:13",33,"مَّسَّتْهُمُ","Touched them","خَلَوْا۟ مِن قَبْلِكُم ۖ","ٱلْبَأْسَآءُ وَٱلضَّرَّآءُ وَزُلْزِلُوا۟",215],["2:236:9",38,"تَمَسُّوهُنَّ","you have touched","ٱلنِّسَآءَ مَا لَمْ","أَوْ تَفْرِضُوا۟ لَهُنَّ",215],["2:237:6",38,"تَمَسُّوهُنَّ","you (have) touched them","مِن قَبْلِ أَن","وَقَدْ فَرَضْتُمْ لَهُنَّ",215],["2:275:13",47,"ٱلْمَسِّ ۚ","(his) touch","يَتَخَبَّطُهُ ٱلشَّيْطَـٰنُ مِنَ","ذَٰلِكَ بِأَنَّهُمْ قَالُوٓا۟",2467],["3:24:5",53,"تَمَسَّنَا","will touch us","بِأَنَّهُمْ قَالُوا۟ لَن","ٱلنَّارُ إِلَّآ أَيَّامًۭا",215],["3:47:8",56,"يَمْسَسْنِى","touch(ed) me","لِى وَلَدٌۭ وَلَمْ","بَشَرٌۭ ۖ قَالَ كَذَٰلِكِ",215],["3:120:2",65,"تَمْسَسْكُمْ","touches you","إِن","حَسَنَةٌۭ تَسُؤْهُمْ وَإِن",215],["3:140:2",67,"يَمْسَسْكُمْ","touched you","إِن","قَرْحٌۭ فَقَدْ مَسَّ",215],["3:140:5",67,"مَسَّ","(has) touched","يَمْسَسْكُمْ قَرْحٌۭ فَقَدْ","ٱلْقَوْمَ قَرْحٌۭ مِّثْلُهُۥ ۚ",215],["3:174:7",73,"يَمْسَسْهُمْ","touched them","ٱللَّهِ وَفَضْلٍۢ لَّمْ","سُوٓءٌۭ وَٱتَّبَعُوا۟ رِضْوَٰنَ",215],["5:73:20",120,"لَيَمَسَّنَّ","surely will afflict","يَنتَهُوا۟ عَمَّا يَقُولُونَ","ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ",215],["6:17:2",129,"يَمْسَسْكَ","touches you","وَإِن","ٱللَّهُ بِضُرٍّۢ فَلَا",215],["6:17:11",129,"يَمْسَسْكَ","He touches you","إِلَّا هُوَ ۖ وَإِن","بِخَيْرٍۢ فَهُوَ عَلَىٰ",215],["6:49:4",133,"يَمَسُّهُمُ","will touch them","وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا","ٱلْعَذَابُ بِمَا كَانُوا۟",215],["7:73:30",159,"تَمَسُّوهَا","touch her","أَرْضِ ٱللَّهِ ۖ وَلَا","بِسُوٓءٍۢ فَيَأْخُذَكُمْ عَذَابٌ",215],["7:95:10",162,"مَسَّ","(had) touched","عَفَوا۟ وَّقَالُوا۟ قَدْ","ءَابَآءَنَا ٱلضَّرَّآءُ وَٱلسَّرَّآءُ",215],["7:188:20",175,"مَسَّنِىَ","(could) have touched me","مِنَ ٱلْخَيْرِ وَمَا","ٱلسُّوٓءُ ۚ إِنْ أَنَا۠",215],["7:201:5",176,"مَسَّهُمْ","touches them","ٱلَّذِينَ ٱتَّقَوْا۟ إِذَا","طَـٰٓئِفٌۭ مِّنَ ٱلشَّيْطَـٰنِ",215],["8:68:6",185,"لَمَسَّكُمْ","surely (would) have touched you","مِّنَ ٱللَّهِ سَبَقَ","فِيمَآ أَخَذْتُمْ عَذَابٌ",215],["10:12:2",209,"مَسَّ","touches","وَإِذَا","ٱلْإِنسَـٰنَ ٱلضُّرُّ دَعَانَا",215],["10:12:21",209,"مَّسَّهُۥ ۚ","(that) touched him","يَدْعُنَآ إِلَىٰ ضُرٍّۢ","كَذَٰلِكَ زُيِّنَ لِلْمُسْرِفِينَ",215],["10:21:8",211,"مَسَّتْهُمْ","has touched them","مِّنۢ بَعْدِ ضَرَّآءَ","إِذَا لَهُم مَّكْرٌۭ",215],["10:107:2",221,"يَمْسَسْكَ","Allah touches you","وَإِن","ٱللَّهُ بِضُرٍّۢ فَلَا",215],["11:10:6",222,"مَسَّتْهُ","(has) touched him","نَعْمَآءَ بَعْدَ ضَرَّآءَ","لَيَقُولَنَّ ذَهَبَ ٱلسَّيِّـَٔاتُ",215],["11:48:15",227,"يَمَسُّهُم","will touch them","وَأُمَمٌۭ سَنُمَتِّعُهُمْ ثُمَّ","مِّنَّا عَذَابٌ أَلِيمٌۭ",215],["11:64:13",229,"تَمَسُّوهَا","touch her","أَرْضِ ٱللَّهِ وَلَا","بِسُوٓءٍۢ فَيَأْخُذَكُمْ عَذَابٌۭ",215],["11:113:6",234,"فَتَمَسَّكُمُ","lest touches you","إِلَى ٱلَّذِينَ ظَلَمُوا۟","ٱلنَّارُ وَمَا لَكُم",215],["12:88:7",246,"مَسَّنَا","Has touched us","قَالُوا۟ يَـٰٓأَيُّهَا ٱلْعَزِيزُ","وَأَهْلَنَا ٱلضُّرُّ وَجِئْنَا",215],["15:48:2",264,"يَمَسُّهُمْ","will touch them","لَا","فِيهَا نَصَبٌۭ وَمَا",215],["15:54:5",265,"مَّسَّنِىَ","has overtaken me","أَبَشَّرْتُمُونِى عَلَىٰٓ أَن","ٱلْكِبَرُ فَبِمَ تُبَشِّرُونَ",215],["16:53:9",272,"مَسَّكُمُ","touches you","ٱللَّهِ ۖ ثُمَّ إِذَا","ٱلضُّرُّ فَإِلَيْهِ تَجْـَٔرُونَ",215],["17:67:2",289,"مَسَّكُمُ","touches you","وَإِذَا","ٱلضُّرُّ فِى ٱلْبَحْرِ",215],["17:83:9",290,"مَسَّهُ","touches him","وَنَـَٔا بِجَانِبِهِۦ ۖ وَإِذَا","ٱلشَّرُّ كَانَ يَـُٔوسًۭا",215],["19:20:7",306,"يَمْسَسْنِى","has touched me","لِى غُلَـٰمٌۭ وَلَمْ","بَشَرٌۭ وَلَمْ أَكُ",215],["19:45:5",308,"يَمَسَّكَ","will touch you","إِنِّىٓ أَخَافُ أَن","عَذَابٌۭ مِّنَ ٱلرَّحْمَـٰنِ",215],["20:97:10",318,"مِسَاسَ ۖ","touch","أَن تَقُولَ لَا","وَإِنَّ لَكَ مَوْعِدًۭا",3745],["21:46:2",326,"مَّسَّتْهُمْ","touches them","وَلَئِن","نَفْحَةٌۭ مِّنْ عَذَابِ",215],["21:83:6",329,"مَسَّنِىَ","has touched me","نَادَىٰ رَبَّهُۥٓ أَنِّى","ٱلضُّرُّ وَأَنتَ أَرْحَمُ",215],["24:14:9",351,"لَمَسَّكُمْ","surely would have touched you","فِى ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ","فِى مَآ أَفَضْتُمْ",215],["24:35:31",354,"تَمْسَسْهُ","touched it","يُضِىٓءُ وَلَوْ لَمْ","نَارٌۭ ۚ نُّورٌ عَلَىٰ",215],["26:156:2",373,"تَمَسُّوهَا","touch her","وَلَا","بِسُوٓءٍۢ فَيَأْخُذَكُمْ عَذَابُ",215],["30:33:2",408,"مَسَّ","touches","وَإِذَا","ٱلنَّاسَ ضُرٌّۭ دَعَوْا۟",215],["33:49:12",424,"تَمَسُّوهُنَّ","you have touched them","مِن قَبْلِ أَن","فَمَا لَكُمْ عَلَيْهِنَّ",215],["35:35:8",438,"يَمَسُّنَا","touches us","مِن فَضْلِهِۦ لَا","فِيهَا نَصَبٌۭ وَلَا",215],["35:35:12",438,"يَمَسُّنَا","touches","فِيهَا نَصَبٌۭ وَلَا","فِيهَا لُغُوبٌۭ",215],["36:18:9",441,"وَلَيَمَسَّنَّكُم","and surely will touch you","لَّمْ تَنتَهُوا۟ لَنَرْجُمَنَّكُمْ","مِّنَّا عَذَابٌ أَلِيمٌۭ",215],["38:41:8",455,"مَسَّنِىَ","(has) touched me","نَادَىٰ رَبَّهُۥٓ أَنِّى","ٱلشَّيْطَـٰنُ بِنُصْبٍۢ وَعَذَابٍ",215],["39:8:2",459,"مَسَّ","touches","۞ وَإِذَا","ٱلْإِنسَـٰنَ ضُرٌّۭ دَعَا",215],["39:49:2",464,"مَسَّ","touches","فَإِذَا","ٱلْإِنسَـٰنَ ضُرٌّۭ دَعَانَا",215],["39:61:7",465,"يَمَسُّهُمُ","will touch them","ٱتَّقَوْا۟ بِمَفَازَتِهِمْ لَا","ٱلسُّوٓءُ وَلَا هُمْ",215],["41:49:8",482,"مَّسَّهُ","touches him","دُعَآءِ ٱلْخَيْرِ وَإِن","ٱلشَّرُّ فَيَـُٔوسٌۭ قَنُوطٌۭ",215],["41:50:8",482,"مَسَّتْهُ","(has) touched him","مِنۢ بَعْدِ ضَرَّآءَ","لَيَقُولَنَّ هَـٰذَا لِى",215],["41:51:9",482,"مَسَّهُ","touches him","وَنَـَٔا بِجَانِبِهِۦ وَإِذَا","ٱلشَّرُّ فَذُو دُعَآءٍ",215],["50:38:11",520,"مَسَّنَا","touch Us","سِتَّةِ أَيَّامٍۢ وَمَا","مِن لُّغُوبٍۢ",215],["54:48:8",530,"مَسَّ","(the) touch","عَلَىٰ وُجُوهِهِمْ ذُوقُوا۟","سَقَرَ",2467],["56:79:2",537,"يَمَسُّهُۥٓ","touch it","لَّا","إِلَّا ٱلْمُطَهَّرُونَ",215],["58:3:14",542,"يَتَمَآسَّا ۚ","they touch each other","مِّن قَبْلِ أَن","ذَٰلِكُمْ تُوعَظُونَ بِهِۦ ۚ",2784],["58:4:10",542,"يَتَمَآسَّا ۖ","they both touch each other","مِن قَبْلِ أَن","فَمَن لَّمْ يَسْتَطِعْ",2784],["70:20:2",569,"مَسَّهُ","touches him","إِذَا","ٱلشَّرُّ جَزُوعًۭا",215],["70:21:2",569,"مَسَّهُ","touches him","وَإِذَا","ٱلْخَيْرُ مَنُوعًا",215]]