[["2:216:7",34,"وَعَسَىٰٓ","But perhaps","وَهُوَ كُرْهٌۭ لَّكُمْ ۖ","أَن تَكْرَهُوا۟ شَيْـًۭٔا",361],["2:216:14",34,"وَعَسَىٰٓ","and perhaps","وَهُوَ خَيْرٌۭ لَّكُمْ ۖ","أَن تُحِبُّوا۟ شَيْـًۭٔا",361],["2:246:24",40,"عَسَيْتُمْ","you perhaps","ٱللَّهِ ۖ قَالَ هَلْ","إِن كُتِبَ عَلَيْكُمُ",361],["4:19:26",80,"فَعَسَىٰٓ","then perhaps","بِٱلْمَعْرُوفِ ۚ فَإِن كَرِهْتُمُوهُنَّ","أَن تَكْرَهُوا۟ شَيْـًۭٔا",361],["4:84:11",91,"عَسَى","perhaps","نَفْسَكَ ۚ وَحَرِّضِ ٱلْمُؤْمِنِينَ ۖ","ٱللَّهُ أَن يَكُفَّ",361],["4:99:2",94,"عَسَى","may be","فَأُو۟لَـٰٓئِكَ","ٱللَّهُ أَن يَعْفُوَ",361],["5:52:13",117,"فَعَسَى","But perhaps","أَن تُصِيبَنَا دَآئِرَ ةٌۭ ۚ","ٱللَّهُ أَن يَأْتِىَ",361],["7:129:12",165,"عَسَىٰ","Perhaps","مَا جِئْتَنَا ۚ قَالَ","رَبُّكُمْ أَن يُهْلِكَ",361],["7:185:13",174,"عَسَىٰٓ","perhaps","مِن شَىْءٍۢ وَأَنْ","أَن يَكُونَ قَدِ",361],["9:18:18",189,"فَعَسَىٰٓ","Then perhaps","يَخْشَ إِلَّا ٱللَّهَ ۖ","أُو۟لَـٰٓئِكَ أَن يَكُونُوا۟",361],["9:102:9",203,"عَسَى","Perhaps","صَـٰلِحًۭا وَءَاخَرَ سَيِّئًا","ٱللَّهُ أَن يَتُوبَ",361],["12:21:9",237,"عَسَىٰٓ","Perhaps","لِٱمْرَأَتِهِۦٓ أَكْرِمِى مَثْوَىٰهُ","أَن يَنفَعَنَآ أَوْ",361],["12:83:9",245,"عَسَى","Perhaps","أَمْرًۭا ۖ فَصَبْرٌۭ جَمِيلٌ ۖ","ٱللَّهُ أَن يَأْتِيَنِى",361],["17:8:1",283,"عَسَىٰ","(It) may be","","رَبُّكُمْ أَن يَرْحَمَكُمْ ۚ",361],["17:51:22",287,"عَسَىٰٓ","Perhaps","مَتَىٰ هُوَ ۖ قُلْ","أَن يَكُونَ قَرِيبًۭا",361],["17:79:7",290,"عَسَىٰٓ","it may be","بِهِۦ نَافِلَةًۭ لَّكَ","أَن يَبْعَثَكَ رَبُّكَ",361],["18:24:10",296,"عَسَىٰٓ","Perhaps","إِذَا نَسِيتَ وَقُلْ","أَن يَهْدِيَنِ رَبِّى",361],["18:40:1",298,"فَعَسَىٰ","It may be","","رَبِّىٓ أَن يُؤْتِيَنِ",361],["19:48:9",308,"عَسَىٰٓ","May be","ٱللَّهِ وَأَدْعُوا۟ رَبِّى","أَلَّآ أَكُونَ بِدُعَآءِ",361],["27:72:2",383,"عَسَىٰٓ","Perhaps","قُلْ","أَن يَكُونَ رَدِفَ",361],["28:9:10",386,"عَسَىٰٓ","perhaps","وَلَكَ ۖ لَا تَقْتُلُوهُ","أَن يَنفَعَنَآ أَوْ",361],["28:22:6",388,"عَسَىٰ","Perhaps","تِلْقَآءَ مَدْيَنَ قَالَ","رَبِّىٓ أَن يَهْدِيَنِى",361],["28:67:7",393,"فَعَسَىٰٓ","then perhaps","وَءَامَنَ وَعَمِلَ صَـٰلِحًۭا","أَن يَكُونَ مِنَ",361],["47:22:2",509,"عَسَيْتُمْ","you perhaps","فَهَلْ","إِن تَوَلَّيْتُمْ أَن",361],["49:11:9",516,"عَسَىٰٓ","perhaps","قَوْمٌۭ مِّن قَوْمٍ","أَن يَكُونُوا۟ خَيْرًۭا",361],["49:11:18",516,"عَسَىٰٓ","perhaps","نِسَآءٌۭ مِّن نِّسَآءٍ","أَن يَكُنَّ خَيْرًۭا",361],["60:7:1",550,"۞ عَسَى","Perhaps","","ٱللَّهُ أَن يَجْعَلَ",361],["66:5:1",560,"عَسَىٰ","Perhaps","","رَبُّهُۥٓ إِن طَلَّقَكُنَّ",361],["66:8:9",561,"عَسَىٰ","Perhaps","ٱللَّهِ تَوْبَةًۭ نَّصُوحًا","رَبُّكُمْ أَن يُكَفِّرَ",361],["68:32:1",565,"عَسَىٰ","Perhaps","","رَبُّنَآ أَن يُبْدِلَنَا",361]]