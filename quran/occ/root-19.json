[["2:19:9",4,"يَجْعَلُونَ","They put","ظُلُمَـٰتٌۭ وَرَعْدٌۭ وَبَرْقٌۭ","أَصَـٰبِعَهُمْ فِىٓ ءَاذَانِهِم",33],["2:22:2",4,"جَعَلَ","made","ٱلَّذِى","لَكُمُ ٱلْأَرْضَ فِرَٰشًۭا",33],["2:22:19",4,"تَجْعَلُوا۟","set up","رِزْقًۭا لَّكُمْ ۖ فَلَا","لِلَّهِ أَندَادًۭا وَأَنتُمْ",33],["2:30:6",6,"جَاعِلٌۭ","going to place","رَبُّكَ لِلْمَلَـٰٓئِكَةِ إِنِّى","فِى ٱلْأَرْضِ خَلِيفَةًۭ ۖ",1186],["2:30:11",6,"أَتَجْعَلُ","Will You place","ٱلْأَرْضِ خَلِيفَةًۭ ۖ قَالُوٓا۟","فِيهَا مَن يُفْسِدُ",33],["2:66:1",10,"فَجَعَلْنَـٰهَا","So We made it","","نَكَـٰلًۭا لِّمَا بَيْنَ",33],["2:124:9",19,"جَاعِلُكَ","(am) the One to make you","فَأَتَمَّهُنَّ ۖ قَالَ إِنِّى","لِلنَّاسِ إِمَامًۭا ۖ قَالَ",1186],["2:125:2",19,"جَعَلْنَا","We made","وَإِذْ","ٱلْبَيْتَ مَثَابَةًۭ لِّلنَّاسِ",33],["2:126:5",19,"ٱجْعَلْ","make","قَالَ إِبْرَٰهِـۧمُ رَبِّ","هَـٰذَا بَلَدًا ءَامِنًۭا",33],["2:128:2",20,"وَٱجْعَلْنَا","[and] Make us","رَبَّنَا","مُسْلِمَيْنِ لَكَ وَمِن",33],["2:143:2",22,"جَعَلْنَـٰكُمْ","We made you","وَكَذَٰلِكَ","أُمَّةًۭ وَسَطًۭا لِّتَكُونُوا۟",33],["2:143:14",22,"جَعَلْنَا","We made","عَلَيْكُمْ شَهِيدًۭا ۗ وَمَا","ٱلْقِبْلَةَ ٱلَّتِى كُنتَ",33],["2:224:2",35,"تَجْعَلُوا۟","make","وَلَا","ٱللَّهَ عُرْضَةًۭ لِّأَيْمَـٰنِكُمْ",33],["2:259:46",43,"وَلِنَجْعَلَكَ","and We will make you","وَٱنظُرْ إِلَىٰ حِمَارِكَ","ءَايَةًۭ لِّلنَّاسِ ۖ وَٱنظُرْ",33],["2:260:25",44,"ٱجْعَلْ","put","فَصُرْهُنَّ إِلَيْكَ ثُمَّ","عَلَىٰ كُلِّ جَبَلٍۢ",33],["3:41:3",55,"ٱجْعَل","make","قَالَ رَبِّ","لِّىٓ ءَايَةًۭ ۖ قَالَ",33],["3:55:13",57,"وَجَاعِلُ","and I will make","مِنَ ٱلَّذِينَ كَفَرُوا۟","ٱلَّذِينَ ٱتَّبَعُوكَ فَوْقَ",1186],["3:61:21",57,"فَنَجْعَل","and [we] invoke","وَأَنفُسَكُمْ ثُمَّ نَبْتَهِلْ","لَّعْنَتَ ٱللَّهِ عَلَى",33],["3:126:2",66,"جَعَلَهُ","made it","وَمَا","ٱللَّهُ إِلَّا بُشْرَىٰ",33],["3:156:24",70,"لِيَجْعَلَ","So makes","مَاتُوا۟ وَمَا قُتِلُوا۟","ٱللَّهُ ذَٰلِكَ حَسْرَةًۭ",33],["3:176:15",73,"يَجْعَلَ","He will set","يُرِيدُ ٱللَّهُ أَلَّا","لَهُمْ حَظًّۭا فِى",33],["4:5:6",77,"جَعَلَ","(was) made","ٱلسُّفَهَآءَ أَمْوَٰلَكُمُ ٱلَّتِى","ٱللَّهُ لَكُمْ قِيَـٰمًۭا",33],["4:15:19",80,"يَجْعَلَ","makes","يَتَوَفَّىٰهُنَّ ٱلْمَوْتُ أَوْ","ٱللَّهُ لَهُنَّ سَبِيلًۭا",33],["4:19:30",80,"وَيَجْعَلَ","and has placed","أَن تَكْرَهُوا۟ شَيْـًۭٔا","ٱللَّهُ فِيهِ خَيْرًۭا",33],["4:33:2",83,"جَعَلْنَا","We (have) made","وَلِكُلٍّۢ","مَوَٰلِىَ مِمَّا تَرَكَ",33],["4:75:22",90,"وَٱجْعَل","and appoint","ٱلْقَرْيَةِ ٱلظَّالِمِ أَهْلُهَا","لَّنَا مِن لَّدُنكَ",33],["4:75:27",90,"وَٱجْعَل","and appoint","مِن لَّدُنكَ وَلِيًّۭا","لَّنَا مِن لَّدُنكَ",33],["4:90:32",92,"جَعَلَ","(has) made","إِلَيْكُمُ ٱلسَّلَمَ فَمَا","ٱللَّهُ لَكُمْ عَلَيْهِمْ",33],["4:91:28",92,"جَعَلْنَا","We made","حَيْثُ ثَقِفْتُمُوهُمْ ۚ وَأُو۟لَـٰٓئِكُمْ","لَكُمْ عَلَيْهِمْ سُلْطَـٰنًۭا",33],["4:141:31",101,"يَجْعَلَ","will make","يَوْمَ ٱلْقِيَـٰمَةِ ۗ وَلَن","ٱللَّهُ لِلْكَـٰفِرِينَ عَلَى",33],["4:144:13",101,"تَجْعَلُوا۟","you make","ٱلْمُؤْمِنِينَ ۚ أَتُرِيدُونَ أَن","لِلَّهِ عَلَيْكُمْ سُلْطَـٰنًۭا",33],["5:6:50",108,"لِيَجْعَلَ","to make","مَا يُرِيدُ ٱللَّهُ","عَلَيْكُم مِّنْ حَرَجٍۢ",33],["5:13:5",109,"وَجَعَلْنَا","and We made","نَقْضِهِم مِّيثَـٰقَهُمْ لَعَنَّـٰهُمْ","قُلُوبَهُمْ قَـٰسِيَةًۭ ۖ يُحَرِّفُونَ",33],["5:20:11",111,"جَعَلَ","He placed","ٱللَّهِ عَلَيْكُمْ إِذْ","فِيكُمْ أَنۢبِيَآءَ وَجَعَلَكُم",33],["5:20:14",111,"وَجَعَلَكُم","and made you","جَعَلَ فِيكُمْ أَنۢبِيَآءَ","مُّلُوكًۭا وَءَاتَىٰكُم مَّا",33],["5:48:26",116,"جَعَلْنَا","We have made","مِنَ ٱلْحَقِّ ۚ لِكُلٍّۢ","مِنكُمْ شِرْعَةًۭ وَمِنْهَاجًۭا ۚ",33],["5:48:33",116,"لَجَعَلَكُمْ","He (would have) made you","وَلَوْ شَآءَ ٱللَّهُ","أُمَّةًۭ وَٰحِدَةًۭ وَلَـٰكِن",33],["5:60:15",118,"وَجَعَلَ","and made","ٱللَّهُ وَغَضِبَ عَلَيْهِ","مِنْهُمُ ٱلْقِرَدَةَ وَٱلْخَنَازِيرَ",33],["5:97:1",124,"۞ جَعَلَ","Has (been) made","","ٱللَّهُ ٱلْكَعْبَةَ ٱلْبَيْتَ",33],["5:103:2",124,"جَعَلَ","has (been) made","مَا","ٱللَّهُ مِنۢ بَحِيرَةٍۢ",33],["6:1:7",128,"وَجَعَلَ","and made","خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","ٱلظُّلُمَـٰتِ وَٱلنُّورَ ۖ ثُمَّ",33],["6:6:20",128,"وَجَعَلْنَا","and We made","ٱلسَّمَآءَ عَلَيْهِم مِّدْرَارًۭا","ٱلْأَنْهَـٰرَ تَجْرِى مِن",33],["6:9:2",129,"جَعَلْنَـٰهُ","We had made him","وَلَوْ","مَلَكًۭا لَّجَعَلْنَـٰهُ رَجُلًۭا",33],["6:9:4",129,"لَّجَعَلْنَـٰهُ","certainly We (would) have made him","وَلَوْ جَعَلْنَـٰهُ مَلَكًۭا","رَجُلًۭا وَلَلَبَسْنَا عَلَيْهِم",33],["6:25:5",130,"وَجَعَلْنَا","but We have placed","مَّن يَسْتَمِعُ إِلَيْكَ ۖ","عَلَىٰ قُلُوبِهِمْ أَكِنَّةً",33],["6:39:14",132,"يَجْعَلْهُ","He places him","يُضْلِلْهُ وَمَن يَشَأْ","عَلَىٰ صِرَٰطٍۢ مُّسْتَقِيمٍۢ",33],["6:91:26",139,"تَجْعَلُونَهُۥ","You make it","نُورًۭا وَهُدًۭى لِّلنَّاسِ ۖ","قَرَاطِيسَ تُبْدُونَهَا وَتُخْفُونَ",33],["6:96:3",140,"وَجَعَلَ","and He has made","فَالِقُ ٱلْإِصْبَاحِ","ٱلَّيْلَ سَكَنًۭا وَٱلشَّمْسَ",33],["6:97:3",140,"جَعَلَ","made","وَهُوَ ٱلَّذِى","لَكُمُ ٱلنُّجُومَ لِتَهْتَدُوا۟",33],["6:100:1",140,"وَجَعَلُوا۟","And they make","","لِلَّهِ شُرَكَآءَ ٱلْجِنَّ",33],["6:107:7",141,"جَعَلْنَـٰكَ","We have made you","مَآ أَشْرَكُوا۟ ۗ وَمَا","عَلَيْهِمْ حَفِيظًۭا ۖ وَمَآ",33],["6:112:2",142,"جَعَلْنَا","We made","وَكَذَٰلِكَ","لِكُلِّ نَبِىٍّ عَدُوًّۭا",33],["6:122:5",143,"وَجَعَلْنَا","and We made","كَانَ مَيْتًۭا فَأَحْيَيْنَـٰهُ","لَهُۥ نُورًۭا يَمْشِى",33],["6:123:2",143,"جَعَلْنَا","We placed","وَكَذَٰلِكَ","فِى كُلِّ قَرْيَةٍ",33],["6:124:17",143,"يَجْعَلُ","He places","ٱللَّهُ أَعْلَمُ حَيْثُ","رِسَالَتَهُۥ ۗ سَيُصِيبُ ٱلَّذِينَ",33],["6:125:13",144,"يَجْعَلْ","He makes","يُرِدْ أَن يُضِلَّهُۥ","صَدْرَهُۥ ضَيِّقًا حَرَجًۭا",33],["6:125:22",144,"يَجْعَلُ","places","فِى ٱلسَّمَآءِ ۚ كَذَٰلِكَ","ٱللَّهُ ٱلرِّجْسَ عَلَى",33],["6:136:1",145,"وَجَعَلُوا۟","And they assign","","لِلَّهِ مِمَّا ذَرَأَ",33],["6:165:3",150,"جَعَلَكُمْ","(has) made you","وَهُوَ ٱلَّذِى","خَلَـٰٓئِفَ ٱلْأَرْضِ وَرَفَعَ",33],["7:10:5",151,"وَجَعَلْنَا","and We made","مَكَّنَّـٰكُمْ فِى ٱلْأَرْضِ","لَكُمْ فِيهَا مَعَـٰيِشَ ۗ",33],["7:27:25",153,"جَعَلْنَا","We have made","لَا تَرَوْنَهُمْ ۗ إِنَّا","ٱلشَّيَـٰطِينَ أَوْلِيَآءَ لِلَّذِينَ",33],["7:47:10",156,"تَجْعَلْنَا","place us","قَالُوا۟ رَبَّنَا لَا","مَعَ ٱلْقَوْمِ ٱلظَّـٰلِمِينَ",33],["7:69:13",159,"جَعَلَكُمْ","He made you","لِيُنذِرَكُمْ ۚ وَٱذْكُرُوٓا۟ إِذْ","خُلَفَآءَ مِنۢ بَعْدِ",33],["7:74:3",160,"جَعَلَكُمْ","He made you","وَٱذْكُرُوٓا۟ إِذْ","خُلَفَآءَ مِنۢ بَعْدِ",33],["7:138:14",167,"ٱجْعَل","Make","لَّهُمْ ۚ قَالُوا۟ يَـٰمُوسَى","لَّنَآ إِلَـٰهًۭا كَمَا",33],["7:143:28",167,"جَعَلَهُۥ","He made it","تَجَلَّىٰ رَبُّهُۥ لِلْجَبَلِ","دَكًّۭا وَخَرَّ مُوسَىٰ",33],["7:150:36",169,"تَجْعَلْنِى","place me","بِىَ ٱلْأَعْدَآءَ وَلَا","مَعَ ٱلْقَوْمِ ٱلظَّـٰلِمِينَ",33],["7:189:7",175,"وَجَعَلَ","and made","مِّن نَّفْسٍۢ وَٰحِدَةٍۢ","مِنْهَا زَوْجَهَا لِيَسْكُنَ",33],["7:190:4",175,"جَعَلَا","they make","فَلَمَّآ ءَاتَىٰهُمَا صَـٰلِحًۭا","لَهُۥ شُرَكَآءَ فِيمَآ",33],["8:10:2",178,"جَعَلَهُ","(it was) made","وَمَا","ٱللَّهُ إِلَّا بُشْرَىٰ",33],["8:29:7",180,"يَجْعَل","He will grant","إِن تَتَّقُوا۟ ٱللَّهَ","لَّكُمْ فُرْقَانًۭا وَيُكَفِّرْ",33],["8:37:6",181,"وَيَجْعَلَ","and place","ٱلْخَبِيثَ مِنَ ٱلطَّيِّبِ","ٱلْخَبِيثَ بَعْضَهُۥ عَلَىٰ",33],["8:37:13",181,"فَيَجْعَلَهُۥ","and put them","بَعْضٍۢ فَيَرْكُمَهُۥ جَمِيعًۭا","فِى جَهَنَّمَ ۚ أُو۟لَـٰٓئِكَ",33],["9:19:1",189,"۞ أَجَعَلْتُمْ","Do you make","","سِقَايَةَ ٱلْحَآجِّ وَعِمَارَةَ",33],["9:40:32",193,"وَجَعَلَ","and made","بِجُنُودٍۢ لَّمْ تَرَوْهَا","كَلِمَةَ ٱلَّذِينَ كَفَرُوا۟",33],["10:5:3",208,"جَعَلَ","made","هُوَ ٱلَّذِى","ٱلشَّمْسَ ضِيَآءًۭ وَٱلْقَمَرَ",33],["10:14:2",209,"جَعَلْنَـٰكُمْ","We made you","ثُمَّ","خَلَـٰٓئِفَ فِى ٱلْأَرْضِ",33],["10:24:33",211,"فَجَعَلْنَـٰهَا","and We make it","لَيْلًا أَوْ نَهَارًۭا","حَصِيدًۭا كَأَن لَّمْ",33],["10:59:9",215,"فَجَعَلْتُم","and you have made","لَكُم مِّن رِّزْقٍۢ","مِّنْهُ حَرَامًۭا وَحَلَـٰلًۭا",33],["10:67:3",216,"جَعَلَ","made","هُوَ ٱلَّذِى","لَكُمُ ٱلَّيْلَ لِتَسْكُنُوا۟",33],["10:73:7",217,"وَجَعَلْنَـٰهُمْ","and We made them","مَّعَهُۥ فِى ٱلْفُلْكِ","خَلَـٰٓئِفَ وَأَغْرَقْنَا ٱلَّذِينَ",33],["10:85:7",218,"تَجْعَلْنَا","make us","تَوَكَّلْنَا رَبَّنَا لَا","فِتْنَةًۭ لِّلْقَوْمِ ٱلظَّـٰلِمِينَ",33],["10:87:10",218,"وَٱجْعَلُوا۟","and make","لِقَوْمِكُمَا بِمِصْرَ بُيُوتًۭا","بُيُوتَكُمْ قِبْلَةًۭ وَأَقِيمُوا۟",33],["10:100:9",220,"وَيَجْعَلُ","And He will place","إِلَّا بِإِذْنِ ٱللَّهِ ۚ","ٱلرِّجْسَ عَلَى ٱلَّذِينَ",33],["11:82:4",231,"جَعَلْنَا","We made","فَلَمَّا جَآءَ أَمْرُنَا","عَـٰلِيَهَا سَافِلَهَا وَأَمْطَرْنَا",33],["11:118:4",235,"لَجَعَلَ","surely He (could) have made","وَلَوْ شَآءَ رَبُّكَ","ٱلنَّاسَ أُمَّةًۭ وَٰحِدَةًۭ ۖ",33],["12:15:6",237,"يَجْعَلُوهُ","they put him","بِهِۦ وَأَجْمَعُوٓا۟ أَن","فِى غَيَـٰبَتِ ٱلْجُبِّ ۚ",33],["12:55:2",242,"ٱجْعَلْنِى","Appoint me","قَالَ","عَلَىٰ خَزَآئِنِ ٱلْأَرْضِ ۖ",33],["12:62:3",242,"ٱجْعَلُوا۟","Put","وَقَالَ لِفِتْيَـٰنِهِ","بِضَـٰعَتَهُمْ فِى رِحَالِهِمْ",33],["12:70:4",244,"جَعَلَ","he put","فَلَمَّا جَهَّزَهُم بِجَهَازِهِمْ","ٱلسِّقَايَةَ فِى رَحْلِ",33],["12:100:16",247,"جَعَلَهَا","has made it","مِن قَبْلُ قَدْ","رَبِّى حَقًّۭا ۖ وَقَدْ",33],["13:3:5",249,"وَجَعَلَ","and placed","ٱلَّذِى مَدَّ ٱلْأَرْضَ","فِيهَا رَوَٰسِىَ وَأَنْهَـٰرًۭا ۖ",33],["13:3:12",249,"جَعَلَ","He made","وَمِن كُلِّ ٱلثَّمَرَٰتِ","فِيهَا زَوْجَيْنِ ٱثْنَيْنِ ۖ",33],["13:16:30",251,"جَعَلُوا۟","they attribute","ٱلظُّلُمَـٰتُ وَٱلنُّورُ ۗ أَمْ","لِلَّهِ شُرَكَآءَ خَلَقُوا۟",33],["13:33:9",253,"وَجَعَلُوا۟","Yet they ascribe","نَفْسٍۭ بِمَا كَسَبَتْ ۗ","لِلَّهِ شُرَكَآءَ قُلْ",33],["13:38:6",254,"وَجَعَلْنَا","and We made","رُسُلًۭا مِّن قَبْلِكَ","لَهُمْ أَزْوَٰجًۭا وَذُرِّيَّةًۭ ۚ",33],["14:30:1",259,"وَجَعَلُوا۟","And they set up","","لِلَّهِ أَندَادًۭا لِّيُضِلُّوا۟",33],["14:35:5",260,"ٱجْعَلْ","Make","قَالَ إِبْرَٰهِيمُ رَبِّ","هَـٰذَا ٱلْبَلَدَ ءَامِنًۭا",33],["14:37:16",260,"فَٱجْعَلْ","So make","رَبَّنَا لِيُقِيمُوا۟ ٱلصَّلَوٰةَ","أَفْـِٔدَةًۭ مِّنَ ٱلنَّاسِ",33],["14:40:2",260,"ٱجْعَلْنِى","Make me","رَبِّ","مُقِيمَ ٱلصَّلَوٰةِ وَمِن",33],["15:16:2",263,"جَعَلْنَا","We have placed","وَلَقَدْ","فِى ٱلسَّمَآءِ بُرُوجًۭا",33],["15:20:1",263,"وَجَعَلْنَا","And We have made","","لَكُمْ فِيهَا مَعَـٰيِشَ",33],["15:74:1",266,"فَجَعَلْنَا","And We made","","عَـٰلِيَهَا سَافِلَهَا وَأَمْطَرْنَا",33],["15:91:2",267,"جَعَلُوا۟","have made","ٱلَّذِينَ","ٱلْقُرْءَانَ عِضِينَ",33],["15:96:2",267,"يَجْعَلُونَ","set up","ٱلَّذِينَ","مَعَ ٱللَّهِ إِلَـٰهًا",33],["16:56:1",273,"وَيَجْعَلُونَ","And they assign","","لِمَا لَا يَعْلَمُونَ",33],["16:57:1",273,"وَيَجْعَلُونَ","And they assign","","لِلَّهِ ٱلْبَنَـٰتِ سُبْحَـٰنَهُۥ ۙ",33],["16:62:1",273,"وَيَجْعَلُونَ","And they assign","","لِلَّهِ مَا يَكْرَهُونَ",33],["16:72:2",274,"جَعَلَ","(has) made","وَٱللَّهُ","لَكُم مِّنْ أَنفُسِكُمْ",33],["16:72:7",274,"وَجَعَلَ","and has made","مِّنْ أَنفُسِكُمْ أَزْوَٰجًۭا","لَكُم مِّنْ أَزْوَٰجِكُم",33],["16:78:9",275,"وَجَعَلَ","and made","لَا تَعْلَمُونَ شَيْـًۭٔا","لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ",33],["16:80:2",276,"جَعَلَ","(has) made","وَٱللَّهُ","لَكُم مِّنۢ بُيُوتِكُمْ",33],["16:80:7",276,"وَجَعَلَ","and made","مِّنۢ بُيُوتِكُمْ سَكَنًۭا","لَكُم مِّن جُلُودِ",33],["16:81:2",276,"جَعَلَ","(has) made","وَٱللَّهُ","لَكُم مِّمَّا خَلَقَ",33],["16:81:7",276,"وَجَعَلَ","and (has) made","مِّمَّا خَلَقَ ظِلَـٰلًۭا","لَكُم مِّنَ ٱلْجِبَالِ",33],["16:81:12",276,"وَجَعَلَ","and (has) made","مِّنَ ٱلْجِبَالِ أَكْنَـٰنًۭا","لَكُمْ سَرَٰبِيلَ تَقِيكُمُ",33],["16:91:12",277,"جَعَلْتُمُ","you have made","بَعْدَ تَوْكِيدِهَا وَقَدْ","ٱللَّهَ عَلَيْكُمْ كَفِيلًا ۚ",33],["16:93:4",277,"لَجَعَلَكُمْ","surely He (could) have made you","وَلَوْ شَآءَ ٱللَّهُ","أُمَّةًۭ وَٰحِدَةًۭ وَلَـٰكِن",33],["16:124:2",281,"جُعِلَ","was appointed","إِنَّمَا","ٱلسَّبْتُ عَلَى ٱلَّذِينَ",33],["17:2:4",282,"وَجَعَلْنَـٰهُ","and made it","وَءَاتَيْنَا مُوسَى ٱلْكِتَـٰبَ","هُدًۭى لِّبَنِىٓ إِسْرَٰٓءِيلَ",33],["17:6:9",282,"وَجَعَلْنَـٰكُمْ","and made you","وَأَمْدَدْنَـٰكُم بِأَمْوَٰلٍۢ وَبَنِينَ","أَكْثَرَ نَفِيرًا",33],["17:8:8",283,"وَجَعَلْنَا","And We have made","وَإِنْ عُدتُّمْ عُدْنَا ۘ","جَهَنَّمَ لِلْكَـٰفِرِينَ حَصِيرًا",33],["17:12:1",283,"وَجَعَلْنَا","And We have made","","ٱلَّيْلَ وَٱلنَّهَارَ ءَايَتَيْنِ ۖ",33],["17:12:8",283,"وَجَعَلْنَآ","and We made","فَمَحَوْنَآ ءَايَةَ ٱلَّيْلِ","ءَايَةَ ٱلنَّهَارِ مُبْصِرَةًۭ",33],["17:18:13",284,"جَعَلْنَا","We have made","لِمَن نُّرِيدُ ثُمَّ","لَهُۥ جَهَنَّمَ يَصْلَىٰهَا",33],["17:22:2",284,"تَجْعَلْ","make","لَّا","مَعَ ٱللَّهِ إِلَـٰهًا",33],["17:29:2",285,"تَجْعَلْ","make","وَلَا","يَدَكَ مَغْلُولَةً إِلَىٰ",33],["17:33:13",285,"جَعَلْنَا","We have made","قُتِلَ مَظْلُومًۭا فَقَدْ","لِوَلِيِّهِۦ سُلْطَـٰنًۭا فَلَا",33],["17:39:9",286,"تَجْعَلْ","make","مِنَ ٱلْحِكْمَةِ ۗ وَلَا","مَعَ ٱللَّهِ إِلَـٰهًا",33],["17:45:4",286,"جَعَلْنَا","We place","وَإِذَا قَرَأْتَ ٱلْقُرْءَانَ","بَيْنَكَ وَبَيْنَ ٱلَّذِينَ",33],["17:46:1",286,"وَجَعَلْنَا","And We have placed","","عَلَىٰ قُلُوبِهِمْ أَكِنَّةً",33],["17:60:9",288,"جَعَلْنَا","We made","أَحَاطَ بِٱلنَّاسِ ۚ وَمَا","ٱلرُّءْيَا ٱلَّتِىٓ أَرَيْنَـٰكَ",33],["17:80:9",290,"وَٱجْعَل","and make","وَأَخْرِجْنِى مُخْرَجَ صِدْقٍۢ","لِّى مِن لَّدُنكَ",33],["17:99:14",292,"وَجَعَلَ","And He has made","أَن يَخْلُقَ مِثْلَهُمْ","لَهُمْ أَجَلًۭا لَّا",33],["18:1:9",293,"يَجْعَل","(has) made","عَبْدِهِ ٱلْكِتَـٰبَ وَلَمْ","لَّهُۥ عِوَجَاۜ",33],["18:7:2",294,"جَعَلْنَا","We have made","إِنَّا","مَا عَلَى ٱلْأَرْضِ",33],["18:8:2",294,"لَجَـٰعِلُونَ","(will) surely make","وَإِنَّا","مَا عَلَيْهَا صَعِيدًۭا",1186],["18:32:5",297,"جَعَلْنَا","We provided","لَهُم مَّثَلًۭا رَّجُلَيْنِ","لِأَحَدِهِمَا جَنَّتَيْنِ مِنْ",33],["18:32:12",297,"وَجَعَلْنَا","and We placed","أَعْنَـٰبٍۢ وَحَفَفْنَـٰهُمَا بِنَخْلٍۢ","بَيْنَهُمَا زَرْعًۭا",33],["18:48:14",299,"نَّجْعَلَ","We made","بَلْ زَعَمْتُمْ أَلَّن","لَكُم مَّوْعِدًۭا",33],["18:52:11",299,"وَجَعَلْنَا","And We will make","فَلَمْ يَسْتَجِيبُوا۟ لَهُمْ","بَيْنَهُم مَّوْبِقًۭا",33],["18:57:14",300,"جَعَلْنَا","[We] have placed","قَدَّمَتْ يَدَاهُ ۚ إِنَّا","عَلَىٰ قُلُوبِهِمْ أَكِنَّةً",33],["18:59:6",300,"وَجَعَلْنَا","and We made","أَهْلَكْنَـٰهُمْ لَمَّا ظَلَمُوا۟","لِمَهْلِكِهِم مَّوْعِدًۭا",33],["18:90:11",303,"نَجْعَل","We made","عَلَىٰ قَوْمٍۢ لَّمْ","لَّهُم مِّن دُونِهَا",33],["18:94:11",303,"نَجْعَلُ","we make","فِى ٱلْأَرْضِ فَهَلْ","لَكَ خَرْجًا عَلَىٰٓ",33],["18:94:16",303,"تَجْعَلَ","you make","خَرْجًا عَلَىٰٓ أَن","بَيْنَنَا وَبَيْنَهُمْ سَدًّۭا",33],["18:95:9",303,"أَجْعَلْ","I will make","خَيْرٌۭ فَأَعِينُونِى بِقُوَّةٍ","بَيْنَكُمْ وَبَيْنَهُمْ رَدْمًا",33],["18:96:13",303,"جَعَلَهُۥ","he made it","ٱنفُخُوا۟ ۖ حَتَّىٰٓ إِذَا","نَارًۭا قَالَ ءَاتُونِىٓ",33],["18:98:10",304,"جَعَلَهُۥ","He will make it","جَآءَ وَعْدُ رَبِّى","دَكَّآءَ ۖ وَكَانَ وَعْدُ",33],["19:6:6",305,"وَٱجْعَلْهُ","And make him","مِنْ ءَالِ يَعْقُوبَ ۖ","رَبِّ رَضِيًّۭا",33],["19:7:8",305,"نَجْعَل","We (have) assigned","ٱسْمُهُۥ يَحْيَىٰ لَمْ","لَّهُۥ مِن قَبْلُ",33],["19:10:3",305,"ٱجْعَل","Make","قَالَ رَبِّ","لِّىٓ ءَايَةًۭ ۚ قَالَ",33],["19:21:8",306,"وَلِنَجْعَلَهُۥٓ","and so that We will make him","هُوَ عَلَىَّ هَيِّنٌۭ ۖ","ءَايَةًۭ لِّلنَّاسِ وَرَحْمَةًۭ",33],["19:24:7",306,"جَعَلَ","(has) placed","أَلَّا تَحْزَنِى قَدْ","رَبُّكِ تَحْتَكِ سَرِيًّۭا",33],["19:30:7",307,"وَجَعَلَنِى","and made me","ٱللَّهِ ءَاتَىٰنِىَ ٱلْكِتَـٰبَ","نَبِيًّۭا",33],["19:31:1",307,"وَجَعَلَنِى","And He (has) made me","","مُبَارَكًا أَيْنَ مَا",33],["19:32:4",307,"يَجْعَلْنِى","He (has) made me","وَبَرًّۢا بِوَٰلِدَتِى وَلَمْ","جَبَّارًۭا شَقِيًّۭا",33],["19:49:13",308,"جَعَلْنَا","We made","إِسْحَـٰقَ وَيَعْقُوبَ ۖ وَكُلًّۭا","نَبِيًّۭا",33],["19:50:5",308,"وَجَعَلْنَا","and We made","لَهُم مِّن رَّحْمَتِنَا","لَهُمْ لِسَانَ صِدْقٍ",33],["19:96:6",312,"سَيَجْعَلُ","will bestow","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","لَهُمُ ٱلرَّحْمَـٰنُ وُدًّۭا",33],["20:29:1",313,"وَٱجْعَل","And appoint","","لِّى وَزِيرًۭا مِّنْ",33],["20:53:2",315,"جَعَلَ","made","ٱلَّذِى","لَكُمُ ٱلْأَرْضَ مَهْدًۭا",33],["20:58:4",315,"فَٱجْعَلْ","So make","فَلَنَأْتِيَنَّكَ بِسِحْرٍۢ مِّثْلِهِۦ","بَيْنَنَا وَبَيْنَكَ مَوْعِدًۭا",33],["21:8:2",322,"جَعَلْنَـٰهُمْ","We made them","وَمَا","جَسَدًۭا لَّا يَأْكُلُونَ",33],["21:15:6",323,"جَعَلْنَـٰهُمْ","We made them","تِّلْكَ دَعْوَىٰهُمْ حَتَّىٰ","حَصِيدًا خَـٰمِدِينَ",33],["21:30:11",324,"وَجَعَلْنَا","and We made","كَانَتَا رَتْقًۭا فَفَتَقْنَـٰهُمَا ۖ","مِنَ ٱلْمَآءِ كُلَّ",33],["21:31:1",324,"وَجَعَلْنَا","And We (have) placed","","فِى ٱلْأَرْضِ رَوَٰسِىَ",33],["21:31:8",324,"وَجَعَلْنَا","and We made","أَن تَمِيدَ بِهِمْ","فِيهَا فِجَاجًۭا سُبُلًۭا",33],["21:32:1",324,"وَجَعَلْنَا","And We made","","ٱلسَّمَآءَ سَقْفًۭا مَّحْفُوظًۭا ۖ",33],["21:34:2",324,"جَعَلْنَا","We made","وَمَا","لِبَشَرٍۢ مِّن قَبْلِكَ",33],["21:58:1",327,"فَجَعَلَهُمْ","So he made them","","جُذَٰذًا إِلَّا كَبِيرًۭا",33],["21:70:4",327,"فَجَعَلْنَـٰهُمُ","but We made them","وَأَرَادُوا۟ بِهِۦ كَيْدًۭا","ٱلْأَخْسَرِينَ",33],["21:72:7",327,"جَعَلْنَا","We made","وَيَعْقُوبَ نَافِلَةًۭ ۖ وَكُلًّۭا","صَـٰلِحِينَ",33],["21:73:1",328,"وَجَعَلْنَـٰهُمْ","And We made them","","أَئِمَّةًۭ يَهْدُونَ بِأَمْرِنَا",33],["21:91:8",330,"وَجَعَلْنَـٰهَا","and We made her","فِيهَا مِن رُّوحِنَا","وَٱبْنَهَآ ءَايَةًۭ لِّلْعَـٰلَمِينَ",33],["22:25:11",335,"جَعَلْنَـٰهُ","We made it","وَٱلْمَسْجِدِ ٱلْحَرَامِ ٱلَّذِى","لِلنَّاسِ سَوَآءً ٱلْعَـٰكِفُ",33],["22:34:3",336,"جَعَلْنَا","We have appointed","وَلِكُلِّ أُمَّةٍۢ","مَنسَكًۭا لِّيَذْكُرُوا۟ ٱسْمَ",33],["22:36:2",336,"جَعَلْنَـٰهَا","We have made them","وَٱلْبُدْنَ","لَكُم مِّن شَعَـٰٓئِرِ",33],["22:53:1",338,"لِّيَجْعَلَ","That He may make","","مَا يُلْقِى ٱلشَّيْطَـٰنُ",33],["22:67:3",340,"جَعَلْنَا","We have made","لِّكُلِّ أُمَّةٍۢ","مَنسَكًا هُمْ نَاسِكُوهُ ۖ",33],["22:78:9",341,"جَعَلَ","placed","هُوَ ٱجْتَبَىٰكُمْ وَمَا","عَلَيْكُمْ فِى ٱلدِّينِ",33],["23:13:2",342,"جَعَلْنَـٰهُ","We placed him","ثُمَّ","نُطْفَةًۭ فِى قَرَارٍۢ",33],["23:41:4",344,"فَجَعَلْنَـٰهُمْ","and We made them","فَأَخَذَتْهُمُ ٱلصَّيْحَةُ بِٱلْحَقِّ","غُثَآءًۭ ۚ فَبُعْدًۭا لِّلْقَوْمِ",33],["23:44:14",345,"وَجَعَلْنَـٰهُمْ","and We made them","فَأَتْبَعْنَا بَعْضَهُم بَعْضًۭا","أَحَادِيثَ ۚ فَبُعْدًۭا لِّقَوْمٍۢ",33],["23:50:1",345,"وَجَعَلْنَا","And We made","","ٱبْنَ مَرْيَمَ وَأُمَّهُۥٓ",33],["23:94:3",348,"تَجْعَلْنِى","place me","رَبِّ فَلَا","فِى ٱلْقَوْمِ ٱلظَّـٰلِمِينَ",33],["24:40:26",355,"يَجْعَلِ","Allah (has) made","يَرَىٰهَا ۗ وَمَن لَّمْ","ٱللَّهُ لَهُۥ نُورًۭا",33],["24:43:11",355,"يَجْعَلُهُۥ","makes them","يُؤَلِّفُ بَيْنَهُۥ ثُمَّ","رُكَامًۭا فَتَرَى ٱلْوَدْقَ",33],["24:63:2",359,"تَجْعَلُوا۟","make","لَّا","دُعَآءَ ٱلرَّسُولِ بَيْنَكُمْ",33],["25:10:5",360,"جَعَلَ","(could have) made","ٱلَّذِىٓ إِن شَآءَ","لَكَ خَيْرًۭا مِّن",33],["25:10:15",360,"وَيَجْعَل","and He (could) make","مِن تَحْتِهَا ٱلْأَنْهَـٰرُ","لَّكَ قُصُورًۢا",33],["25:20:13",361,"وَجَعَلْنَا","And We have made","وَيَمْشُونَ فِى ٱلْأَسْوَاقِ ۗ","بَعْضَكُمْ لِبَعْضٍۢ فِتْنَةً",33],["25:23:7",362,"فَجَعَلْنَـٰهُ","and We will make them","عَمِلُوا۟ مِنْ عَمَلٍۢ","هَبَآءًۭ مَّنثُورًا",33],["25:31:2",362,"جَعَلْنَا","We have made","وَكَذَٰلِكَ","لِكُلِّ نَبِىٍّ عَدُوًّۭا",33],["25:35:5",363,"وَجَعَلْنَا","and We appointed","ءَاتَيْنَا مُوسَى ٱلْكِتَـٰبَ","مَعَهُۥٓ أَخَاهُ هَـٰرُونَ",33],["25:37:7",363,"وَجَعَلْنَـٰهُمْ","and We made them","كَذَّبُوا۟ ٱلرُّسُلَ أَغْرَقْنَـٰهُمْ","لِلنَّاسِ ءَايَةًۭ ۖ وَأَعْتَدْنَا",33],["25:45:10",364,"لَجَعَلَهُۥ","surely He (could) have made it","ٱلظِّلَّ وَلَوْ شَآءَ","سَاكِنًۭا ثُمَّ جَعَلْنَا",33],["25:45:13",364,"جَعَلْنَا","We made","لَجَعَلَهُۥ سَاكِنًۭا ثُمَّ","ٱلشَّمْسَ عَلَيْهِ دَلِيلًۭا",33],["25:47:3",364,"جَعَلَ","made","وَهُوَ ٱلَّذِى","لَكُمُ ٱلَّيْلَ لِبَاسًۭا",33],["25:47:9",364,"وَجَعَلَ","and made","لِبَاسًۭا وَٱلنَّوْمَ سُبَاتًۭا","ٱلنَّهَارَ نُشُورًۭا",33],["25:53:11",364,"وَجَعَلَ","and He has made","وَهَـٰذَا مِلْحٌ أُجَاجٌۭ","بَيْنَهُمَا بَرْزَخًۭا وَحِجْرًۭا",33],["25:54:7",364,"فَجَعَلَهُۥ","and has made (for) him","مِنَ ٱلْمَآءِ بَشَرًۭا","نَسَبًۭا وَصِهْرًۭا ۗ وَكَانَ",33],["25:61:3",365,"جَعَلَ","has placed","تَبَارَكَ ٱلَّذِى","فِى ٱلسَّمَآءِ بُرُوجًۭا",33],["25:61:7",365,"وَجَعَلَ","and has placed","فِى ٱلسَّمَآءِ بُرُوجًۭا","فِيهَا سِرَٰجًۭا وَقَمَرًۭا",33],["25:62:3",365,"جَعَلَ","made","وَهُوَ ٱلَّذِى","ٱلَّيْلَ وَٱلنَّهَارَ خِلْفَةًۭ",33],["25:74:11",366,"وَٱجْعَلْنَا","and make us","وَذُرِّيَّـٰتِنَا قُرَّةَ أَعْيُنٍۢ","لِلْمُتَّقِينَ إِمَامًا",33],["26:21:9",368,"وَجَعَلَنِى","and made me","لِى رَبِّى حُكْمًۭا","مِنَ ٱلْمُرْسَلِينَ",33],["26:29:6",368,"لَأَجْعَلَنَّكَ","I will surely make you","ٱتَّخَذْتَ إِلَـٰهًا غَيْرِى","مِنَ ٱلْمَسْجُونِينَ",33],["26:84:1",371,"وَٱجْعَل","And grant","","لِّى لِسَانَ صِدْقٍۢ",33],["26:85:1",371,"وَٱجْعَلْنِى","And make me","","مِن وَرَثَةِ جَنَّةِ",33],["27:34:8",379,"وَجَعَلُوٓا۟","and make","دَخَلُوا۟ قَرْيَةً أَفْسَدُوهَا","أَعِزَّةَ أَهْلِهَآ أَذِلَّةًۭ ۖ",33],["27:61:2",382,"جَعَلَ","made","أَمَّن","ٱلْأَرْضَ قَرَارًۭا وَجَعَلَ",33],["27:61:5",382,"وَجَعَلَ","and made","جَعَلَ ٱلْأَرْضَ قَرَارًۭا","خِلَـٰلَهَآ أَنْهَـٰرًۭا وَجَعَلَ",33],["27:61:8",382,"وَجَعَلَ","and made","وَجَعَلَ خِلَـٰلَهَآ أَنْهَـٰرًۭا","لَهَا رَوَٰسِىَ وَجَعَلَ",33],["27:61:11",382,"وَجَعَلَ","and made","وَجَعَلَ لَهَا رَوَٰسِىَ","بَيْنَ ٱلْبَحْرَيْنِ حَاجِزًا ۗ",33],["27:62:8",382,"وَيَجْعَلُكُمْ","and makes you","دَعَاهُ وَيَكْشِفُ ٱلسُّوٓءَ","خُلَفَآءَ ٱلْأَرْضِ ۗ أَءِلَـٰهٌۭ",33],["27:86:4",384,"جَعَلْنَا","[We] have made","أَلَمْ يَرَوْا۟ أَنَّا","ٱلَّيْلَ لِيَسْكُنُوا۟ فِيهِ",33],["28:4:6",385,"وَجَعَلَ","and made","عَلَا فِى ٱلْأَرْضِ","أَهْلَهَا شِيَعًۭا يَسْتَضْعِفُ",33],["28:5:9",385,"وَنَجْعَلَهُمْ","and make them","ٱسْتُضْعِفُوا۟ فِى ٱلْأَرْضِ","أَئِمَّةًۭ وَنَجْعَلَهُمُ ٱلْوَٰرِثِينَ",33],["28:5:11",385,"وَنَجْعَلَهُمُ","and make them","ٱلْأَرْضِ وَنَجْعَلَهُمْ أَئِمَّةًۭ","ٱلْوَٰرِثِينَ",33],["28:7:20",386,"وَجَاعِلُوهُ","and (will) make him","إِنَّا رَآدُّوهُ إِلَيْكِ","مِنَ ٱلْمُرْسَلِينَ",1186],["28:35:5",389,"وَنَجْعَلُ","and We will make","سَنَشُدُّ عَضُدَكَ بِأَخِيكَ","لَكُمَا سُلْطَـٰنًۭا فَلَا",33],["28:38:16",390,"فَٱجْعَل","and make","يَـٰهَـٰمَـٰنُ عَلَى ٱلطِّينِ","لِّى صَرْحًۭا لَّعَلِّىٓ",33],["28:41:1",390,"وَجَعَلْنَـٰهُمْ","And We made them","","أَئِمَّةًۭ يَدْعُونَ إِلَى",33],["28:71:4",394,"جَعَلَ","Allah made","قُلْ أَرَءَيْتُمْ إِن","ٱللَّهُ عَلَيْكُمُ ٱلَّيْلَ",33],["28:72:4",394,"جَعَلَ","Allah made","قُلْ أَرَءَيْتُمْ إِن","ٱللَّهُ عَلَيْكُمُ ٱلنَّهَارَ",33],["28:73:3",394,"جَعَلَ","He made","وَمِن رَّحْمَتِهِۦ","لَكُمُ ٱلَّيْلَ وَٱلنَّهَارَ",33],["28:83:4",395,"نَجْعَلُهَا","We assign it","تِلْكَ ٱلدَّارُ ٱلْـَٔاخِرَةُ","لِلَّذِينَ لَا يُرِيدُونَ",33],["29:10:11",397,"جَعَلَ","he considers","أُوذِىَ فِى ٱللَّهِ","فِتْنَةَ ٱلنَّاسِ كَعَذَابِ",33],["29:15:4",398,"وَجَعَلْنَـٰهَآ","and We made it","فَأَنجَيْنَـٰهُ وَأَصْحَـٰبَ ٱلسَّفِينَةِ","ءَايَةًۭ لِّلْعَـٰلَمِينَ",33],["29:27:5",399,"وَجَعَلْنَا","and We placed","لَهُۥٓ إِسْحَـٰقَ وَيَعْقُوبَ","فِى ذُرِّيَّتِهِ ٱلنُّبُوَّةَ",33],["29:67:4",404,"جَعَلْنَا","have made","أَوَلَمْ يَرَوْا۟ أَنَّا","حَرَمًا ءَامِنًۭا وَيُتَخَطَّفُ",33],["30:21:11",406,"وَجَعَلَ","and He placed","أَزْوَٰجًۭا لِّتَسْكُنُوٓا۟ إِلَيْهَا","بَيْنَكُم مَّوَدَّةًۭ وَرَحْمَةً ۚ",33],["30:48:12",409,"وَيَجْعَلُهُۥ","and He makes them","ٱلسَّمَآءِ كَيْفَ يَشَآءُ","كِسَفًۭا فَتَرَى ٱلْوَدْقَ",33],["30:54:7",410,"جَعَلَ","made","مِّن ضَعْفٍۢ ثُمَّ","مِنۢ بَعْدِ ضَعْفٍۢ",33],["30:54:13",410,"جَعَلَ","made","ضَعْفٍۢ قُوَّةًۭ ثُمَّ","مِنۢ بَعْدِ قُوَّةٍۢ",33],["32:8:2",415,"جَعَلَ","He made","ثُمَّ","نَسْلَهُۥ مِن سُلَـٰلَةٍۢ",33],["32:9:7",415,"وَجَعَلَ","and made","فِيهِ مِن رُّوحِهِۦ ۖ","لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ",33],["32:23:11",417,"وَجَعَلْنَـٰهُ","And We made it","مِرْيَةٍۢ مِّن لِّقَآئِهِۦ ۖ","هُدًۭى لِّبَنِىٓ إِسْرَٰٓءِيلَ",33],["32:24:1",417,"وَجَعَلْنَا","And We made","","مِنْهُمْ أَئِمَّةًۭ يَهْدُونَ",33],["33:4:2",418,"جَعَلَ","Allah (has) made","مَّا","ٱللَّهُ لِرَجُلٍۢ مِّن",33],["33:4:10",418,"جَعَلَ","He (has) made","فِى جَوْفِهِۦ ۚ وَمَا","أَزْوَٰجَكُمُ ٱلَّـٰٓـِٔى تُظَـٰهِرُونَ",33],["33:4:17",418,"جَعَلَ","He has made","مِنْهُنَّ أُمَّهَـٰتِكُمْ ۚ وَمَا","أَدْعِيَآءَكُمْ أَبْنَآءَكُمْ ۚ ذَٰلِكُمْ",33],["34:18:1",430,"وَجَعَلْنَا","And We made","","بَيْنَهُمْ وَبَيْنَ ٱلْقُرَى",33],["34:19:8",430,"فَجَعَلْنَـٰهُمْ","so We made them","أَسْفَارِنَا وَظَلَمُوٓا۟ أَنفُسَهُمْ","أَحَادِيثَ وَمَزَّقْنَـٰهُمْ كُلَّ",33],["34:33:15",432,"وَنَجْعَلَ","and we set up","أَن نَّكْفُرَ بِٱللَّهِ","لَهُۥٓ أَندَادًۭا ۚ وَأَسَرُّوا۟",33],["34:33:23",432,"وَجَعَلْنَا","And We will put","لَمَّا رَأَوُا۟ ٱلْعَذَابَ","ٱلْأَغْلَـٰلَ فِىٓ أَعْنَاقِ",33],["35:1:6",434,"جَاعِلِ","(Who) makes","فَاطِرِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","ٱلْمَلَـٰٓئِكَةِ رُسُلًا أُو۟لِىٓ",1186],["35:11:9",435,"جَعَلَكُمْ","He made you","مِن نُّطْفَةٍۢ ثُمَّ","أَزْوَٰجًۭا ۚ وَمَا تَحْمِلُ",33],["35:39:3",439,"جَعَلَكُمْ","made you","هُوَ ٱلَّذِى","خَلَـٰٓئِفَ فِى ٱلْأَرْضِ ۚ",33],["36:8:2",440,"جَعَلْنَا","[We] have placed","إِنَّا","فِىٓ أَعْنَـٰقِهِمْ أَغْلَـٰلًۭا",33],["36:9:1",440,"وَجَعَلْنَا","And We have made","","مِنۢ بَيْنِ أَيْدِيهِمْ",33],["36:27:5",441,"وَجَعَلَنِى","and placed me","غَفَرَ لِى رَبِّى","مِنَ ٱلْمُكْرَمِينَ",33],["36:34:1",442,"وَجَعَلْنَا","And We placed","","فِيهَا جَنَّـٰتٍۢ مِّن",33],["36:80:2",445,"جَعَلَ","made","ٱلَّذِى","لَكُم مِّنَ ٱلشَّجَرِ",33],["37:63:2",448,"جَعَلْنَـٰهَا","[We] have made it","إِنَّا","فِتْنَةًۭ لِّلظَّـٰلِمِينَ",33],["37:77:1",449,"وَجَعَلْنَا","And We made","","ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ",33],["37:98:4",449,"فَجَعَلْنَـٰهُمُ","but We made them","فَأَرَادُوا۟ بِهِۦ كَيْدًۭا","ٱلْأَسْفَلِينَ",33],["37:158:1",452,"وَجَعَلُوا۟","And they have made","","بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ",33],["38:5:1",453,"أَجَعَلَ","Has he made","","ٱلْـَٔالِهَةَ إِلَـٰهًۭا وَٰحِدًا ۖ",33],["38:26:3",454,"جَعَلْنَـٰكَ","[We] have made you","يَـٰدَاوُۥدُ إِنَّا","خَلِيفَةًۭ فِى ٱلْأَرْضِ",33],["38:28:2",455,"نَجْعَلُ","should We treat","أَمْ","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",33],["38:28:11",455,"نَجْعَلُ","should We treat","فِى ٱلْأَرْضِ أَمْ","ٱلْمُتَّقِينَ كَٱلْفُجَّارِ",33],["39:6:6",459,"جَعَلَ","He made","نَّفْسٍۢ وَٰحِدَةٍۢ ثُمَّ","مِنْهَا زَوْجَهَا وَأَنزَلَ",33],["39:8:21",459,"وَجَعَلَ","and he sets up","إِلَيْهِ مِن قَبْلُ","لِلَّهِ أَندَادًۭا لِّيُضِلَّ",33],["39:21:24",460,"يَجْعَلُهُۥ","He makes them","فَتَرَىٰهُ مُصْفَرًّۭا ثُمَّ","حُطَـٰمًا ۚ إِنَّ فِى",33],["40:61:3",474,"جَعَلَ","made","ٱللَّهُ ٱلَّذِى","لَكُمُ ٱلَّيْلَ لِتَسْكُنُوا۟",33],["40:64:3",474,"جَعَلَ","made","ٱللَّهُ ٱلَّذِى","لَكُمُ ٱلْأَرْضَ قَرَارًۭا",33],["40:79:3",476,"جَعَلَ","made","ٱللَّهُ ٱلَّذِى","لَكُمُ ٱلْأَنْعَـٰمَ لِتَرْكَبُوا۟",33],["41:9:9",477,"وَتَجْعَلُونَ","and you set up","ٱلْأَرْضَ فِى يَوْمَيْنِ","لَهُۥٓ أَندَادًۭا ۚ ذَٰلِكَ",33],["41:10:1",477,"وَجَعَلَ","And He placed","","فِيهَا رَوَٰسِىَ مِن",33],["41:29:11",479,"نَجْعَلْهُمَا","(so) we may put them","مِنَ ٱلْجِنِّ وَٱلْإِنسِ","تَحْتَ أَقْدَامِنَا لِيَكُونَا",33],["41:44:2",481,"جَعَلْنَـٰهُ","We (had) made it","وَلَوْ","قُرْءَانًا أَعْجَمِيًّۭا لَّقَالُوا۟",33],["42:8:4",483,"لَجَعَلَهُمْ","He could have made them","وَلَوْ شَآءَ ٱللَّهُ","أُمَّةًۭ وَٰحِدَةًۭ وَلَـٰكِن",33],["42:11:4",484,"جَعَلَ","He made","فَاطِرُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ","لَكُم مِّنْ أَنفُسِكُمْ",33],["42:50:5",488,"وَيَجْعَلُ","and He makes","يُزَوِّجُهُمْ ذُكْرَانًۭا وَإِنَـٰثًۭا ۖ","مَن يَشَآءُ عَقِيمًا ۚ",33],["42:52:15",489,"جَعَلْنَـٰهُ","We have made it","وَلَا ٱلْإِيمَـٰنُ وَلَـٰكِن","نُورًۭا نَّهْدِى بِهِۦ",33],["43:3:2",489,"جَعَلْنَـٰهُ","(have) made it","إِنَّا","قُرْءَٰنًا عَرَبِيًّۭا لَّعَلَّكُمْ",33],["43:10:2",489,"جَعَلَ","made","ٱلَّذِى","لَكُمُ ٱلْأَرْضَ مَهْدًۭا",33],["43:10:6",489,"وَجَعَلَ","and made","لَكُمُ ٱلْأَرْضَ مَهْدًۭا","لَكُمْ فِيهَا سُبُلًۭا",33],["43:12:5",490,"وَجَعَلَ","and made","خَلَقَ ٱلْأَزْوَٰجَ كُلَّهَا","لَكُم مِّنَ ٱلْفُلْكِ",33],["43:15:1",490,"وَجَعَلُوا۟","But they attribute","","لَهُۥ مِنْ عِبَادِهِۦ",33],["43:19:1",490,"وَجَعَلُوا۟","And they made","","ٱلْمَلَـٰٓئِكَةَ ٱلَّذِينَ هُمْ",33],["43:28:1",491,"وَجَعَلَهَا","And he made it","","كَلِمَةًۢ بَاقِيَةًۭ فِى",33],["43:33:7",491,"لَّجَعَلْنَا","We (would have) made","ٱلنَّاسُ أُمَّةًۭ وَٰحِدَةًۭ","لِمَن يَكْفُرُ بِٱلرَّحْمَـٰنِ",33],["43:45:8",492,"أَجَعَلْنَا","did We make","قَبْلِكَ مِن رُّسُلِنَآ","مِن دُونِ ٱلرَّحْمَـٰنِ",33],["43:56:1",493,"فَجَعَلْنَـٰهُمْ","And We made them","","سَلَفًۭا وَمَثَلًۭا لِّلْـَٔاخِرِينَ",33],["43:59:7",493,"وَجَعَلْنَـٰهُ","and We made him","عَبْدٌ أَنْعَمْنَا عَلَيْهِ","مَثَلًۭا لِّبَنِىٓ إِسْرَٰٓءِيلَ",33],["43:60:3",493,"لَجَعَلْنَا","surely We (could have) made","وَلَوْ نَشَآءُ","مِنكُم مَّلَـٰٓئِكَةًۭ فِى",33],["45:18:2",500,"جَعَلْنَـٰكَ","We put you","ثُمَّ","عَلَىٰ شَرِيعَةٍۢ مِّنَ",33],["45:21:7",500,"نَّجْعَلَهُمْ","We will make them","ٱجْتَرَحُوا۟ ٱلسَّيِّـَٔاتِ أَن","كَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",33],["45:23:14",501,"وَجَعَلَ","and puts","عَلَىٰ سَمْعِهِۦ وَقَلْبِهِۦ","عَلَىٰ بَصَرِهِۦ غِشَـٰوَةًۭ",33],["46:26:7",505,"وَجَعَلْنَا","and We made","إِن مَّكَّنَّـٰكُمْ فِيهِ","لَهُمْ سَمْعًۭا وَأَبْصَـٰرًۭا",33],["48:26:2",514,"جَعَلَ","had put","إِذْ","ٱلَّذِينَ كَفَرُوا۟ فِى",33],["48:27:23",514,"فَجَعَلَ","and He made","مَا لَمْ تَعْلَمُوا۟","مِن دُونِ ذَٰلِكَ",33],["49:13:8",517,"وَجَعَلْنَـٰكُمْ","and We made you","مِّن ذَكَرٍۢ وَأُنثَىٰ","شُعُوبًۭا وَقَبَآئِلَ لِتَعَارَفُوٓا۟ ۚ",33],["50:26:2",519,"جَعَلَ","made","ٱلَّذِى","مَعَ ٱللَّهِ إِلَـٰهًا",33],["51:42:8",522,"جَعَلَتْهُ","it made it","أَتَتْ عَلَيْهِ إِلَّا","كَٱلرَّمِيمِ",33],["51:51:2",522,"تَجْعَلُوا۟","make","وَلَا","مَعَ ٱللَّهِ إِلَـٰهًا",33],["56:36:1",535,"فَجَعَلْنَـٰهُنَّ","And We have made them","","أَبْكَارًا",33],["56:65:3",536,"لَجَعَلْنَـٰهُ","We (would) surely, make it","لَوْ نَشَآءُ","حُطَـٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ",33],["56:70:3",536,"جَعَلْنَـٰهُ","We (could) make it","لَوْ نَشَآءُ","أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ",33],["56:73:2",536,"جَعَلْنَـٰهَا","have made it","نَحْنُ","تَذْكِرَةًۭ وَمَتَـٰعًۭا لِّلْمُقْوِينَ",33],["56:82:1",537,"وَتَجْعَلُونَ","And you make","","رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ",33],["57:7:6",538,"جَعَلَكُم","He has made you","وَرَسُولِهِۦ وَأَنفِقُوا۟ مِمَّا","مُّسْتَخْلَفِينَ فِيهِ ۖ فَٱلَّذِينَ",33],["57:26:5",541,"وَجَعَلْنَا","and We placed","أَرْسَلْنَا نُوحًۭا وَإِبْرَٰهِيمَ","فِى ذُرِّيَّتِهِمَا ٱلنُّبُوَّةَ",33],["57:27:12",541,"وَجَعَلْنَا","And We placed","مَرْيَمَ وَءَاتَيْنَـٰهُ ٱلْإِنجِيلَ","فِى قُلُوبِ ٱلَّذِينَ",33],["57:28:12",541,"وَيَجْعَل","and He will make","كِفْلَيْنِ مِن رَّحْمَتِهِۦ","لَّكُمْ نُورًۭا تَمْشُونَ",33],["59:10:14",547,"تَجْعَلْ","put","سَبَقُونَا بِٱلْإِيمَـٰنِ وَلَا","فِى قُلُوبِنَا غِلًّۭا",33],["60:5:3",549,"تَجْعَلْنَا","make us","رَبَّنَا لَا","فِتْنَةًۭ لِّلَّذِينَ كَفَرُوا۟",33],["60:7:4",550,"يَجْعَلَ","will put","۞ عَسَى ٱللَّهُ أَن","بَيْنَكُمْ وَبَيْنَ ٱلَّذِينَ",33],["65:2:28",558,"يَجْعَل","He will make","وَمَن يَتَّقِ ٱللَّهَ","لَّهُۥ مَخْرَجًۭا",33],["65:3:17",558,"جَعَلَ","has set","بَـٰلِغُ أَمْرِهِۦ ۚ قَدْ","ٱللَّهُ لِكُلِّ شَىْءٍۢ",33],["65:4:24",558,"يَجْعَل","He will make","وَمَن يَتَّقِ ٱللَّهَ","لَّهُۥ مِنْ أَمْرِهِۦ",33],["65:7:21",559,"سَيَجْعَلُ","Will bring about","إِلَّا مَآ ءَاتَىٰهَا ۚ","ٱللَّهُ بَعْدَ عُسْرٍۢ",33],["67:5:6",562,"وَجَعَلْنَـٰهَا","and We have made them","ٱلسَّمَآءَ ٱلدُّنْيَا بِمَصَـٰبِيحَ","رُجُومًۭا لِّلشَّيَـٰطِينِ ۖ وَأَعْتَدْنَا",33],["67:15:3",563,"جَعَلَ","made","هُوَ ٱلَّذِى","لَكُمُ ٱلْأَرْضَ ذَلُولًۭا",33],["67:23:5",563,"وَجَعَلَ","and made","هُوَ ٱلَّذِىٓ أَنشَأَكُمْ","لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ",33],["68:35:1",565,"أَفَنَجْعَلُ","Then will We treat","","ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ",33],["68:50:3",566,"فَجَعَلَهُۥ","and made him","فَٱجْتَبَـٰهُ رَبُّهُۥ","مِنَ ٱلصَّـٰلِحِينَ",33],["69:12:1",567,"لِنَجْعَلَهَا","That We might make it","","لَكُمْ تَذْكِرَةًۭ وَتَعِيَهَآ",33],["71:7:6",570,"جَعَلُوٓا۟","they put","دَعَوْتُهُمْ لِتَغْفِرَ لَهُمْ","أَصَـٰبِعَهُمْ فِىٓ ءَاذَانِهِمْ",33],["71:12:4",571,"وَيَجْعَل","and make","وَيُمْدِدْكُم بِأَمْوَٰلٍۢ وَبَنِينَ","لَّكُمْ جَنَّـٰتٍۢ وَيَجْعَل",33],["71:12:7",571,"وَيَجْعَل","and make","وَيَجْعَل لَّكُمْ جَنَّـٰتٍۢ","لَّكُمْ أَنْهَـٰرًۭا",33],["71:16:1",571,"وَجَعَلَ","And made","","ٱلْقَمَرَ فِيهِنَّ نُورًۭا",33],["71:16:5",571,"وَجَعَلَ","and made","ٱلْقَمَرَ فِيهِنَّ نُورًۭا","ٱلشَّمْسَ سِرَاجًۭا",33],["71:19:2",571,"جَعَلَ","made","وَٱللَّهُ","لَكُمُ ٱلْأَرْضَ بِسَاطًۭا",33],["72:25:8",573,"يَجْعَلُ","will appoint","مَّا تُوعَدُونَ أَمْ","لَهُۥ رَبِّىٓ أَمَدًا",33],["73:17:6",574,"يَجْعَلُ","(that) will make","إِن كَفَرْتُمْ يَوْمًۭا","ٱلْوِلْدَٰنَ شِيبًا",33],["74:12:1",575,"وَجَعَلْتُ","And I granted","","لَهُۥ مَالًۭا مَّمْدُودًۭا",33],["74:31:2",576,"جَعَلْنَآ","We have made","وَمَا","أَصْحَـٰبَ ٱلنَّارِ إِلَّا",33],["74:31:8",576,"جَعَلْنَا","We have made","إِلَّا مَلَـٰٓئِكَةًۭ ۙ وَمَا","عِدَّتَهُمْ إِلَّا فِتْنَةًۭ",33],["75:39:1",578,"فَجَعَلَ","Then made","","مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ",33],["76:2:8",578,"فَجَعَلْنَـٰهُ","so We made (for) him","نُّطْفَةٍ أَمْشَاجٍۢ نَّبْتَلِيهِ","سَمِيعًۢا بَصِيرًا",33],["77:21:1",581,"فَجَعَلْنَـٰهُ","Then We placed it","","فِى قَرَارٍۢ مَّكِينٍ",33],["77:25:2",581,"نَجْعَلِ","We made","أَلَمْ","ٱلْأَرْضَ كِفَاتًا",33],["77:27:1",581,"وَجَعَلْنَا","And We made","","فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍۢ",33],["78:6:2",582,"نَجْعَلِ","We made","أَلَمْ","ٱلْأَرْضَ مِهَـٰدًۭا",33],["78:9:1",582,"وَجَعَلْنَا","And We made","","نَوْمَكُمْ سُبَاتًۭا",33],["78:10:1",582,"وَجَعَلْنَا","And We made","","ٱلَّيْلَ لِبَاسًۭا",33],["78:11:1",582,"وَجَعَلْنَا","And We made","","ٱلنَّهَارَ مَعَاشًۭا",33],["78:13:1",582,"وَجَعَلْنَا","And We placed","","سِرَاجًۭا وَهَّاجًۭا",33],["87:5:1",591,"فَجَعَلَهُۥ","And then makes it","","غُثَآءً أَحْوَىٰ",33],["90:8:2",594,"نَجْعَل","We made","أَلَمْ","لَّهُۥ عَيْنَيْنِ",33],["105:2:2",601,"يَجْعَلْ","He make","أَلَمْ","كَيْدَهُمْ فِى تَضْلِيلٍۢ",33],["105:5:1",601,"فَجَعَلَهُمْ","Then He made them","","كَعَصْفٍۢ مَّأْكُولٍۭ",33]]