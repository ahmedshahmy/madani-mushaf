[["2:47:9",7,"فَضَّلْتُكُمْ","[I] preferred you","أَنْعَمْتُ عَلَيْكُمْ وَأَنِّى","عَلَى ٱلْعَـٰلَمِينَ",571],["2:64:7",10,"فَضْلُ","(for the) Grace","بَعْدِ ذَٰلِكَ ۖ فَلَوْلَا","ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ",131],["2:90:15",14,"فَضْلِهِۦ","His Grace","يُنَزِّلَ ٱللَّهُ مِن","عَلَىٰ مَن يَشَآءُ",131],["2:105:24",16,"ٱلْفَضْلِ","(of) [the] Bounty","يَشَآءُ ۚ وَٱللَّهُ ذُو","ٱلْعَظِيمِ",131],["2:122:9",19,"فَضَّلْتُكُمْ","[I] preferred you","أَنْعَمْتُ عَلَيْكُمْ وَأَنِّى","عَلَى ٱلْعَـٰلَمِينَ",571],["2:198:6",31,"فَضْلًۭا","bounty","جُنَاحٌ أَن تَبْتَغُوا۟","مِّن رَّبِّكُمْ ۚ فَإِذَآ",131],["2:237:29",38,"ٱلْفَضْلَ","the graciousness","لِلتَّقْوَىٰ ۚ وَلَا تَنسَوُا۟","بَيْنَكُمْ ۚ إِنَّ ٱللَّهَ",131],["2:243:21",39,"فَضْلٍ","(of) bounty","إِنَّ ٱللَّهَ لَذُو","عَلَى ٱلنَّاسِ وَلَـٰكِنَّ",131],["2:251:25",41,"فَضْلٍ","(of) bounty","وَلَـٰكِنَّ ٱللَّهَ ذُو","عَلَى ٱلْعَـٰلَمِينَ",131],["2:253:3",42,"فَضَّلْنَا","We (have) preferred","۞ تِلْكَ ٱلرُّسُلُ","بَعْضَهُمْ عَلَىٰ بَعْضٍۢ ۘ",571],["2:268:10",45,"وَفَضْلًۭا ۗ","and bounty","يَعِدُكُم مَّغْفِرَةًۭ مِّنْهُ","وَٱللَّهُ وَٰسِعٌ عَلِيمٌۭ",131],["3:73:24",59,"ٱلْفَضْلَ","the Bounty","رَبِّكُمْ ۗ قُلْ إِنَّ","بِيَدِ ٱللَّهِ يُؤْتِيهِ",131],["3:74:7",59,"ٱلْفَضْلِ","(of) Bounty","يَشَآءُ ۗ وَٱللَّهُ ذُو","ٱلْعَظِيمِ",131],["3:152:38",69,"فَضْلٍ","(of) Bounty","عَنكُمْ ۗ وَٱللَّهُ ذُو","عَلَى ٱلْمُؤْمِنِينَ",131],["3:170:6",72,"فَضْلِهِۦ","His Bounty","ءَاتَىٰهُمُ ٱللَّهُ مِن","وَيَسْتَبْشِرُونَ بِٱلَّذِينَ لَمْ",131],["3:171:5",72,"وَفَضْلٍۢ","and Bounty","بِنِعْمَةٍۢ مِّنَ ٱللَّهِ","وَأَنَّ ٱللَّهَ لَا",131],["3:174:5",73,"وَفَضْلٍۢ","and Bounty","بِنِعْمَةٍۢ مِّنَ ٱللَّهِ","لَّمْ يَمْسَسْهُمْ سُوٓءٌۭ",131],["3:174:14",73,"فَضْلٍ","(of) Bounty","ٱللَّهِ ۗ وَٱللَّهُ ذُو","عَظِيمٍ",131],["3:180:9",73,"فَضْلِهِۦ","His Bounty","ءَاتَىٰهُمُ ٱللَّهُ مِن","هُوَ خَيْرًۭا لَّهُم ۖ",131],["4:32:4",83,"فَضَّلَ","(has) bestowed","وَلَا تَتَمَنَّوْا۟ مَا","ٱللَّهُ بِهِۦ بَعْضَكُمْ",571],["4:32:21",83,"فَضْلِهِۦٓ ۗ","His bounty","وَسْـَٔلُوا۟ ٱللَّهَ مِن","إِنَّ ٱللَّهَ كَانَ",131],["4:34:6",84,"فَضَّلَ","(has) bestowed","عَلَى ٱلنِّسَآءِ بِمَا","ٱللَّهُ بَعْضَهُمْ عَلَىٰ",571],["4:37:11",84,"فَضْلِهِۦ ۗ","His Bounty","ءَاتَىٰهُمُ ٱللَّهُ مِن","وَأَعْتَدْنَا لِلْكَـٰفِرِينَ عَذَابًۭا",131],["4:54:9",87,"فَضْلِهِۦ ۖ","His Bounty","ءَاتَىٰهُمُ ٱللَّهُ مِن","فَقَدْ ءَاتَيْنَآ ءَالَ",131],["4:70:2",89,"ٱلْفَضْلُ","(is) the Bounty","ذَٰلِكَ","مِنَ ٱللَّهِ ۚ وَكَفَىٰ",131],["4:73:3",89,"فَضْلٌۭ","bounty","وَلَئِنْ أَصَـٰبَكُمْ","مِّنَ ٱللَّهِ لَيَقُولَنَّ",131],["4:83:23",91,"فَضْلُ","(had been the) bounty","يَسْتَنۢبِطُونَهُۥ مِنْهُمْ ۗ وَلَوْلَا","ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ",131],["4:95:15",94,"فَضَّلَ","Preferred","ٱللَّهِ بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ ۚ","ٱللَّهُ ٱلْمُجَـٰهِدِينَ بِأَمْوَٰلِهِمْ",571],["4:95:27",94,"وَفَضَّلَ","preferred","وَعَدَ ٱللَّهُ ٱلْحُسْنَىٰ ۚ","ٱللَّهُ ٱلْمُجَـٰهِدِينَ عَلَى",571],["4:113:2",96,"فَضْلُ","(for the) Grace","وَلَوْلَا","ٱللَّهِ عَلَيْكَ وَرَحْمَتُهُۥ",131],["4:113:30",96,"فَضْلُ","(the) Grace","تَكُن تَعْلَمُ ۚ وَكَانَ","ٱللَّهِ عَلَيْكَ عَظِيمًۭا",131],["4:173:10",105,"فَضْلِهِۦ ۖ","His Bounty","أُجُورَهُمْ وَيَزِيدُهُم مِّن","وَأَمَّا ٱلَّذِينَ ٱسْتَنكَفُوا۟",131],["4:175:11",105,"وَفَضْلٍۢ","and Bounty","فِى رَحْمَةٍۢ مِّنْهُ","وَيَهْدِيهِمْ إِلَيْهِ صِرَٰطًۭا",131],["5:2:20",106,"فَضْلًۭا","Bounty","ٱلْبَيْتَ ٱلْحَرَامَ يَبْتَغُونَ","مِّن رَّبِّهِمْ وَرِضْوَٰنًۭا ۚ",131],["5:54:30",117,"فَضْلُ","(is the) Grace","لَوْمَةَ لَآئِمٍۢ ۚ ذَٰلِكَ","ٱللَّهِ يُؤْتِيهِ مَن",131],["6:86:6",138,"فَضَّلْنَا","We preferred","وَيُونُسَ وَلُوطًۭا ۚ وَكُلًّۭا","عَلَى ٱلْعَـٰلَمِينَ",571],["7:39:9",155,"فَضْلٍۢ","superiority","لَكُمْ عَلَيْنَا مِن","فَذُوقُوا۟ ٱلْعَذَابَ بِمَا",131],["7:140:7",167,"فَضَّلَكُمْ","has preferred you","أَبْغِيكُمْ إِلَـٰهًۭا وَهُوَ","عَلَى ٱلْعَـٰلَمِينَ",571],["8:29:17",180,"ٱلْفَضْلِ","(of) Bounty","لَكُمْ ۗ وَٱللَّهُ ذُو","ٱلْعَظِيمِ",131],["9:28:21",191,"فَضْلِهِۦٓ","His Bounty","يُغْنِيكُمُ ٱللَّهُ مِن","إِن شَآءَ ۚ