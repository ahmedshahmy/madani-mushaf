[["4:23:41",81,"أَصْلَـٰبِكُمْ","your loins","أَبْنَآئِكُمُ ٱلَّذِينَ مِنْ","وَأَن تَجْمَعُوا۟ بَيْنَ",2302],["4:157:13",103,"صَلَبُوهُ","they crucified him","وَمَا قَتَلُوهُ وَمَا","وَلَـٰكِن شُبِّهَ لَهُمْ ۚ",2295],["5:33:14",113,"يُصَلَّبُوٓا۟","they be crucified","أَن يُقَتَّلُوٓا۟ أَوْ","أَوْ تُقَطَّعَ أَيْدِيهِمْ",1682],["7:124:7",165,"لَأُصَلِّبَنَّكُمْ","I will surely crucify you","مِّنْ خِلَـٰفٍۢ ثُمَّ","أَجْمَعِينَ",1682],["12:41:10",240,"فَيُصْلَبُ","he will be crucified","خَمْرًۭا ۖ وَأَمَّا ٱلْـَٔاخَرُ","فَتَأْكُلُ ٱلطَّيْرُ مِن",2295],["20:71:18",316,"وَلَأُصَلِّبَنَّكُمْ","and surely I will crucify you","وَأَرْجُلَكُم مِّنْ خِلَـٰفٍۢ","فِى جُذُوعِ ٱلنَّخْلِ",1682],["26:49:20",369,"وَلَأُصَلِّبَنَّكُمْ","and I will surely crucify you","وَأَرْجُلَكُم مِّنْ خِلَـٰفٍۢ","أَجْمَعِينَ",1682],["86:7:4",591,"ٱلصُّلْبِ","the backbone","يَخْرُجُ مِنۢ بَيْنِ","وَٱلتَّرَآئِبِ",2302]]