[["19:25:1",306,"وَهُزِّىٓ","And shake","","إِلَيْكِ بِجِذْعِ ٱلنَّخْلَةِ",3505],["22:5:63",332,"ٱهْتَزَّتْ","it gets stirred","أَنزَلْنَا عَلَيْهَا ٱلْمَآءَ","وَرَبَتْ وَأَنۢبَتَتْ مِن",1691],["27:10:5",377,"تَهْتَزُّ","moving","عَصَاكَ ۚ فَلَمَّا رَءَاهَا","كَأَنَّهَا جَآنٌّۭ وَلَّىٰ",1691],["28:31:6",389,"تَهْتَزُّ","moving","عَصَاكَ ۖ فَلَمَّا رَءَاهَا","كَأَنَّهَا جَآنٌّۭ وَلَّىٰ",1691],["41:39:11",481,"ٱهْتَزَّتْ","it is stirred (to life)","أَنزَلْنَا عَلَيْهَا ٱلْمَآءَ","وَرَبَتْ ۚ إِنَّ ٱلَّذِىٓ",1691]]