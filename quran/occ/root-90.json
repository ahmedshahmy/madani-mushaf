[["2:58:3",9,"ٱدْخُلُوا۟","Enter","وَإِذْ قُلْنَا","هَـٰذِهِ ٱلْقَرْيَةَ فَكُلُوا۟",151],["2:58:11",9,"وَٱدْخُلُوا۟","and enter","حَيْثُ شِئْتُمْ رَغَدًۭا","ٱلْبَابَ سُجَّدًۭا وَقُولُوا۟",151],["2:111:3",17,"يَدْخُلَ","will enter","وَقَالُوا۟ لَن","ٱلْجَنَّةَ إِلَّا مَن",151],["2:114:19",18,"يَدْخُلُوهَآ","they enter them","كَانَ لَهُمْ أَن","إِلَّا خَآئِفِينَ ۚ لَهُمْ",151],["2:208:4",32,"ٱدْخُلُوا۟","Enter","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","فِى ٱلسِّلْمِ كَآفَّةًۭ",151],["2:214:4",33,"تَدْخُلُوا۟","you will enter","أَمْ حَسِبْتُمْ أَن","ٱلْجَنَّةَ وَلَمَّا يَأْتِكُم",151],["3:37:11",54,"دَخَلَ","entered","وَكَفَّلَهَا زَكَرِيَّا ۖ كُلَّمَا","عَلَيْهَا زَكَرِيَّا ٱلْمِحْرَابَ",151],["3:97:7",62,"دَخَلَهُۥ","enters it","مَّقَامُ إِبْرَٰهِيمَ ۖ وَمَن","كَانَ ءَامِنًۭا ۗ وَلِلَّهِ",151],["3:142:4",68,"تَدْخُلُوا۟","you will enter","أَمْ حَسِبْتُمْ أَن","ٱلْجَنَّةَ وَلَمَّا يَعْلَمِ",151],["3:185:14",74,"وَأُدْخِلَ","and admitted","زُحْزِحَ عَنِ ٱلنَّارِ","ٱلْجَنَّةَ فَقَدْ فَازَ ۗ",274],["3:192:4",75,"تُدْخِلِ","You admit","رَبَّنَآ إِنَّكَ مَن","ٱلنَّارَ فَقَدْ أَخْزَيْتَهُۥ ۖ",274],["3:195:30",76,"وَلَأُدْخِلَنَّهُمْ","and surely I will admit them","لَأُكَفِّرَنَّ عَنْهُمْ سَيِّـَٔاتِهِمْ","جَنَّـٰتٍۢ تَجْرِى مِن",274],["4:13:8",79,"يُدْخِلْهُ","He will admit him","يُطِعِ ٱللَّهَ وَرَسُولَهُۥ","جَنَّـٰتٍۢ تَجْرِى مِن",274],["4:14:7",79,"يُدْخِلْهُ","He will admit him","وَرَسُولَهُۥ وَيَتَعَدَّ حُدُودَهُۥ","نَارًا خَـٰلِدًۭا فِيهَا",274],["4:23:27",81,"دَخَلْتُم","you had relations","مِّن نِّسَآئِكُمُ ٱلَّـٰتِى","بِهِنَّ فَإِن لَّمْ",151],["4:23:32",81,"دَخَلْتُم","relations","فَإِن لَّمْ تَكُونُوا۟","بِهِنَّ فَلَا جُنَاحَ",151],["4:31:10",83,"وَنُدْخِلْكُم","and We will admit you","نُكَفِّرْ عَنكُمْ سَيِّـَٔاتِكُمْ","مُّدْخَلًۭا كَرِيمًۭا",274],["4:31:11",83,"مُّدْخَلًۭا","(to) an entrance","عَنكُمْ سَيِّـَٔاتِكُمْ وَنُدْخِلْكُم","كَرِيمًۭا",1932],["4:57:5",87,"سَنُدْخِلُهُمْ","We will admit them","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","جَنَّـٰتٍۢ تَجْرِى مِن",274],["4:57:18",87,"وَنُدْخِلُهُمْ","and We will admit them","فِيهَآ أَزْوَٰجٌۭ مُّطَهَّرَةٌۭ ۖ","ظِلًّۭا ظَلِيلًا",274],["4:122:5",98,"سَنُدْخِلُهُمْ","We will admit them","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","جَنَّـٰتٍۢ تَجْرِى مِن",274],["4:124:12",98,"يَدْخُلُونَ","will enter","وَهُوَ مُؤْمِنٌۭ فَأُو۟لَـٰٓئِكَ","ٱلْجَنَّةَ وَلَا يُظْلَمُونَ",151],["4:154:7",102,"ٱدْخُلُوا۟","Enter","بِمِيثَـٰقِهِمْ وَقُلْنَا لَهُمُ","ٱلْبَابَ سُجَّدًۭا وَقُلْنَا",151],["4:175:7",105,"فَسَيُدْخِلُهُمْ","then He will admit them","بِٱللَّهِ وَٱعْتَصَمُوا۟ بِهِۦ","فِى رَحْمَةٍۢ مِّنْهُ",274],["5:12:31",109,"وَلَأُدْخِلَنَّكُمْ","and I will surely admit you","لَّأُكَفِّرَنَّ عَنكُمْ سَيِّـَٔاتِكُمْ","جَنَّـٰتٍۢ تَجْرِى مِن",274],["5:21:2",111,"ٱدْخُلُوا۟","Enter","يَـٰقَوْمِ","ٱلْأَرْضَ ٱلْمُقَدَّسَةَ ٱلَّتِى",151],["5:22:9",111,"نَّدْخُلَهَا","will enter it","جَبَّارِينَ وَإِنَّا لَن","حَتَّىٰ يَخْرُجُوا۟ مِنْهَا",151],["5:22:17",111,"دَٰخِلُونَ","enter (it)","يَخْرُجُوا۟ مِنْهَا فَإِنَّا","",2351],["5:23:9",111,"ٱدْخُلُوا۟","Enter","أَنْعَمَ ٱللَّهُ عَلَيْهِمَا","عَلَيْهِمُ ٱلْبَابَ فَإِذَا",151],["5:23:13",111,"دَخَلْتُمُوهُ","you have entered it","عَلَيْهِمُ ٱلْبَابَ فَإِذَا","فَإِنَّكُمْ غَـٰلِبُونَ ۚ وَعَلَى",151],["5:24:5",112,"نَّدْخُلَهَآ","will enter it","يَـٰمُوسَىٰٓ إِنَّا لَن","أَبَدًۭا مَّا دَامُوا۟",151],["5:61:6",118,"دَّخَلُوا۟","they entered","قَالُوٓا۟ ءَامَنَّا وَقَد","بِٱلْكُفْرِ وَهُمْ قَدْ",151],["5:65:10",119,"وَلَأَدْخَلْنَـٰهُمْ","and surely We (would have) admitted them","لَكَفَّرْنَا عَنْهُمْ سَيِّـَٔاتِهِمْ","جَنَّـٰتِ ٱلنَّعِيمِ",274],["5:84:12",122,"يُدْخِلَنَا","will admit us","ٱلْحَقِّ وَنَطْمَعُ أَن","رَبُّنَا مَعَ ٱلْقَوْمِ",274],["7:38:2",155,"ٱدْخُلُوا۟","Enter","قَالَ","فِىٓ أُمَمٍۢ قَدْ",151],["7:38:15",155,"دَخَلَتْ","entered","فِى ٱلنَّارِ ۖ كُلَّمَا","أُمَّةٌۭ لَّعَنَتْ أُخْتَهَا ۖ",151],["7:40:13",155,"يَدْخُلُونَ","they will enter","أَبْوَٰبُ ٱلسَّمَآءِ وَلَا","ٱلْجَنَّةَ حَتَّىٰ يَلِجَ",151],["7:46:16",156,"يَدْخُلُوهَا","they have entered it","سَلَـٰمٌ عَلَيْكُمْ ۚ لَمْ","وَهُمْ يَطْمَعُونَ",151],["7:49:8",156,"ٱدْخُلُوا۟","Enter","يَنَالُهُمُ ٱللَّهُ بِرَحْمَةٍ ۚ","ٱلْجَنَّةَ لَا خَوْفٌ",151],["7:151:6",169,"وَأَدْخِلْنَا","and admit us","ٱغْفِرْ لِى وَلِأَخِى","فِى رَحْمَتِكَ ۖ وَأَنتَ",274],["7:161:13",171,"وَٱدْخُلُوا۟","and enter","شِئْتُمْ وَقُولُوا۟ حِطَّةٌۭ","ٱلْبَابَ سُجَّدًۭا نَّغْفِرْ",151],["9:57:7",196,"مُدَّخَلًۭا","a place to enter","أَوْ مَغَـٰرَٰتٍ أَوْ","لَّوَلَّوْا۟ إِلَيْهِ وَهُمْ",3796],["9:99:20",202,"سَيُدْخِلُهُمُ","Allah will admit them","إِنَّهَا قُرْبَةٌۭ لَّهُمْ ۚ","ٱللَّهُ فِى رَحْمَتِهِۦٓ ۗ",274],["12:36:1",239,"وَدَخَلَ","And entered","","مَعَهُ ٱلسِّجْنَ فَتَيَانِ ۖ",151],["12:58:4",242,"فَدَخَلُوا۟","and they entered","وَجَآءَ إِخْوَةُ يُوسُفَ","عَلَيْهِ فَعَرَفَهُمْ وَهُمْ",151],["12:67:4",243,"تَدْخُلُوا۟","enter","وَقَالَ يَـٰبَنِىَّ لَا","مِنۢ بَابٍۢ وَٰحِدٍۢ",151],["12:67:8",243,"وَٱدْخُلُوا۟","but enter","مِنۢ بَابٍۢ وَٰحِدٍۢ","مِنْ أَبْوَٰبٍۢ مُّتَفَرِّقَةٍۢ ۖ",151],["12:68:2",243,"دَخَلُوا۟","they entered","وَلَمَّا","مِنْ حَيْثُ أَمَرَهُمْ",151],["12:69:2",243,"دَخَلُوا۟","they entered","وَلَمَّا","عَلَىٰ يُوسُفَ ءَاوَىٰٓ",151],["12:88:2",246,"دَخَلُوا۟","they entered","فَلَمَّا","عَلَيْهِ قَالُوا۟ يَـٰٓأَيُّهَا",151],["12:99:2",247,"دَخَلُوا۟","they entered","فَلَمَّا","عَلَىٰ يُوسُفَ ءَاوَىٰٓ",151],["12:99:9",247,"ٱدْخُلُوا۟","Enter","إِلَيْهِ أَبَوَيْهِ وَقَالَ","مِصْرَ إِن شَآءَ",151],["13:23:3",252,"يَدْخُلُونَهَا","they will enter them","جَنَّـٰتُ عَدْنٍۢ","وَمَن صَلَحَ مِنْ",151],["13:23:11",252,"يَدْخُلُونَ","will enter","وَأَزْوَٰجِهِمْ وَذُرِّيَّـٰتِهِمْ ۖ وَٱلْمَلَـٰٓئِكَةُ","عَلَيْهِم مِّن كُلِّ",151],["14:23:1",258,"وَأُدْخِلَ","And will be admitted","","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",274],["15:46:1",264,"ٱدْخُلُوهَا","Enter it","","بِسَلَـٰمٍ ءَامِنِينَ",151],["15:52:2",265,"دَخَلُوا۟","they entered","إِذْ","عَلَيْهِ فَقَالُوا۟ سَلَـٰمًۭا",151],["16:29:1",270,"فَٱدْخُلُوٓا۟","So enter","","أَبْوَٰبَ جَهَنَّمَ خَـٰلِدِينَ",151],["16:31:3",270,"يَدْخُلُونَهَا","which they will enter","جَنَّـٰتُ عَدْنٍۢ","تَجْرِى مِن تَحْتِهَا",151],["16:32:8",270,"ٱدْخُلُوا۟","Enter","يَقُولُونَ سَلَـٰمٌ عَلَيْكُمُ","ٱلْجَنَّةَ بِمَا كُنتُمْ",151],["16:92:12",277,"دَخَلًۢا","(as) a deception","أَنكَـٰثًۭا تَتَّخِذُونَ أَيْمَـٰنَكُمْ","بَيْنَكُمْ أَن تَكُونَ",2354],["16:94:4",278,"دَخَلًۢا","(as) a deception","وَلَا تَتَّخِذُوٓا۟ أَيْمَـٰنَكُمْ","بَيْنَكُمْ فَتَزِلَّ قَدَمٌۢ",2354],["17:7:14",282,"وَلِيَدْخُلُوا۟","and to enter","ٱلْـَٔاخِرَةِ لِيَسُـۥٓـُٔوا۟ وُجُوهَكُمْ","ٱلْمَسْجِدَ كَمَا دَخَلُوهُ",151],["17:7:17",282,"دَخَلُوهُ","they (had) entered it","وَلِيَدْخُلُوا۟ ٱلْمَسْجِدَ كَمَا","أَوَّلَ مَرَّةٍۢ وَلِيُتَبِّرُوا۟",151],["17:80:3",290,"أَدْخِلْنِى","Cause me to enter","وَقُل رَّبِّ","مُدْخَلَ صِدْقٍۢ وَأَخْرِجْنِى",274],["17:80:4",290,"مُدْخَلَ","an entrance","وَقُل رَّبِّ أَدْخِلْنِى","صِدْقٍۢ وَأَخْرِجْنِى مُخْرَجَ",1932],["18:35:1",298,"وَدَخَلَ","And he entered","","جَنَّتَهُۥ وَهُوَ ظَالِمٌۭ",151],["18:39:3",298,"دَخَلْتَ","you entered","وَلَوْلَآ إِذْ","جَنَّتَكَ قُلْتَ مَا",151],["19:60:8",309,"يَدْخُلُونَ","will enter","وَعَمِلَ صَـٰلِحًۭا فَأُو۟لَـٰٓئِكَ","ٱلْجَنَّةَ وَلَا يُظْلَمُونَ",151],["21:75:1",328,"وَأَدْخَلْنَـٰهُ","And We admitted him","","فِى رَحْمَتِنَآ ۖ إِنَّهُۥ",274],["21:86:1",329,"وَأَدْخَلْنَـٰهُمْ","And We admitted them","","فِى رَحْمَتِنَآ ۖ إِنَّهُم",274],["22:14:3",333,"يُدْخِلُ","will admit","إِنَّ ٱللَّهَ","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",274],["22:23:3",334,"يُدْخِلُ","will admit","إِنَّ ٱللَّهَ","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",274],["22:59:1",339,"لَيُدْخِلَنَّهُم","Surely, He will admit them","","مُّدْخَلًۭا يَرْضَوْنَهُۥ ۗ وَإِنَّ",274],["22:59:2",339,"مُّدْخَلًۭا","(to) an entrance","لَيُدْخِلَنَّهُم","يَرْضَوْنَهُۥ ۗ وَإِنَّ ٱللَّهَ",1932],["24:27:5",352,"تَدْخُلُوا۟","enter","ٱلَّذِينَ ءَامَنُوا۟ لَا","بُيُوتًا غَيْرَ بُيُوتِكُمْ",151],["24:28:7",353,"تَدْخُلُوهَا","enter it","فِيهَآ أَحَدًۭا فَلَا","حَتَّىٰ يُؤْذَنَ لَكُمْ ۖ",151],["24:29:5",353,"تَدْخُلُوا۟","you enter","عَلَيْكُمْ جُنَاحٌ أَن","بُيُوتًا غَيْرَ مَسْكُونَةٍۢ",151],["24:61:59",358,"دَخَلْتُم","you enter","أَوْ أَشْتَاتًۭا ۚ فَإِذَا","بُيُوتًۭا فَسَلِّمُوا۟ عَلَىٰٓ",151],["27:12:1",377,"وَأَدْخِلْ","And enter","","يَدَكَ فِى جَيْبِكَ",274],["27:18:11",378,"ٱدْخُلُوا۟","Enter","نَمْلَةٌۭ يَـٰٓأَيُّهَا ٱلنَّمْلُ","مَسَـٰكِنَكُمْ لَا يَحْطِمَنَّكُمْ",151],["27:19:20",378,"وَأَدْخِلْنِى","And admit me","أَعْمَلَ صَـٰلِحًۭا تَرْضَىٰهُ","بِرَحْمَتِكَ فِى عِبَادِكَ",274],["27:34:5",379,"دَخَلُوا۟","they enter","إِنَّ ٱلْمُلُوكَ إِذَا","قَرْيَةً أَفْسَدُوهَا وَجَعَلُوٓا۟",151],["27:44:3",380,"ٱدْخُلِى","Enter","قِيلَ لَهَا","ٱلصَّرْحَ ۖ فَلَمَّا رَأَتْهُ",151],["28:15:1",387,"وَدَخَلَ","And he entered","","ٱلْمَدِينَةَ عَلَىٰ حِينِ",151],["29:9:5",397,"لَنُدْخِلَنَّهُمْ","We will surely admit them","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","فِى ٱلصَّـٰلِحِينَ",274],["33:14:2",419,"دُخِلَتْ","had been entered","وَلَوْ","عَلَيْهِم مِّنْ أَقْطَارِهَا",151],["33:53:5",425,"تَدْخُلُوا۟","enter","ٱلَّذِينَ ءَامَنُوا۟ لَا","بُيُوتَ ٱلنَّبِىِّ إِلَّآ",151],["33:53:20",425,"فَٱدْخُلُوا۟","then enter","وَلَـٰكِنْ إِذَا دُعِيتُمْ","فَإِذَا طَعِمْتُمْ فَٱنتَشِرُوا۟",151],["35:33:3",438,"يَدْخُلُونَهَا","they will enter them","جَنَّـٰتُ عَدْنٍۢ","يُحَلَّوْنَ فِيهَا مِنْ",151],["36:26:2",441,"ٱدْخُلِ","Enter","قِيلَ","ٱلْجَنَّةَ ۖ قَالَ يَـٰلَيْتَ",151],["38:22:2",454,"دَخَلُوا۟","they entered","إِذْ","عَلَىٰ دَاوُۥدَ فَفَزِعَ",151],["39:72:2",466,"ٱدْخُلُوٓا۟","Enter","قِيلَ","أَبْوَٰبَ جَهَنَّمَ خَـٰلِدِينَ",151],["39:73:19",466,"فَٱدْخُلُوهَا","so enter it","سَلَـٰمٌ عَلَيْكُمْ طِبْتُمْ","خَـٰلِدِينَ",151],["40:8:2",468,"وَأَدْخِلْهُمْ","And admit them","رَبَّنَا","جَنَّـٰتِ عَدْنٍ ٱلَّتِى",274],["40:40:18",471,"يَدْخُلُونَ","will enter","وَهُوَ مُؤْمِنٌۭ فَأُو۟لَـٰٓئِكَ","ٱلْجَنَّةَ يُرْزَقُونَ فِيهَا",151],["40:46:9",472,"أَدْخِلُوٓا۟","Cause to enter","وَيَوْمَ تَقُومُ ٱلسَّاعَةُ","ءَالَ فِرْعَوْنَ أَشَدَّ",274],["40:60:11",474,"سَيَدْخُلُونَ","will enter","يَسْتَكْبِرُونَ عَنْ عِبَادَتِى","جَهَنَّمَ دَاخِرِينَ",151],["40:76:1",475,"ٱدْخُلُوٓا۟","Enter","","أَبْوَٰبَ جَهَنَّمَ خَـٰلِدِينَ",151],["42:8:8",483,"يُدْخِلُ","He admits","أُمَّةًۭ وَٰحِدَةًۭ وَلَـٰكِن","مَن يَشَآءُ فِى",274],["43:70:1",494,"ٱدْخُلُوا۟","Enter","","ٱلْجَنَّةَ أَنتُمْ وَأَزْوَٰجُكُمْ",151],["45:30:6",501,"فَيُدْخِلُهُمْ","will admit them","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","رَبُّهُمْ فِى رَحْمَتِهِۦ ۚ",274],["47:6:1",507,"وَيُدْخِلُهُمُ","And admit them","","ٱلْجَنَّةَ عَرَّفَهَا لَهُمْ",274],["47:12:3",508,"يُدْخِلُ","will admit","إِنَّ ٱللَّهَ","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",274],["48:5:1",511,"لِّيُدْخِلَ","That He may admit","","ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ جَنَّـٰتٍۢ",274],["48:17:17",513,"يُدْخِلْهُ","He will admit him","يُطِعِ ٱللَّهَ وَرَسُولَهُۥ","جَنَّـٰتٍۢ تَجْرِى مِن",274],["48:25:27",514,"لِّيُدْخِلَ","That Allah may admit","مَّعَرَّةٌۢ بِغَيْرِ عِلْمٍۢ ۖ","ٱللَّهُ فِى رَحْمَتِهِۦ",274],["48:27:7",514,"لَتَدْخُلُنَّ","Surely, you will enter","رَسُولَهُ ٱلرُّءْيَا بِٱلْحَقِّ ۖ","ٱلْمَسْجِدَ ٱلْحَرَامَ إِن",151],["49:14:11",517,"يَدْخُلِ","entered","قُولُوٓا۟ أَسْلَمْنَا وَلَمَّا","ٱلْإِيمَـٰنُ فِى قُلُوبِكُمْ ۖ",151],["50:34:1",519,"ٱدْخُلُوهَا","Enter it","","بِسَلَـٰمٍۢ ۖ ذَٰلِكَ يَوْمُ",151],["51:25:2",521,"دَخَلُوا۟","they entered","إِذْ","عَلَيْهِ فَقَالُوا۟ سَلَـٰمًۭا ۖ",151],["58:22:30",545,"وَيُدْخِلُهُمْ","And He will admit them","وَأَيَّدَهُم بِرُوحٍۢ مِّنْهُ ۖ","جَنَّـٰتٍۢ تَجْرِى مِن",274],["61:12:4",552,"وَيُدْخِلْكُمْ","and admit you","يَغْفِرْ لَكُمْ ذُنُوبَكُمْ","جَنَّـٰتٍۢ تَجْرِى مِن",274],["64:9:16",556,"وَيُدْخِلْهُ","and He will admit him","يُكَفِّرْ عَنْهُ سَيِّـَٔاتِهِۦ","جَنَّـٰتٍۢ تَجْرِى مِن",274],["65:11:21",559,"يُدْخِلْهُ","He will admit him","بِٱللَّهِ وَيَعْمَلْ صَـٰلِحًۭا","جَنَّـٰتٍۢ تَجْرِى مِن",274],["66:8:15",561,"وَيُدْخِلَكُمْ","and admit you","يُكَفِّرَ عَنكُمْ سَيِّـَٔاتِكُمْ","جَنَّـٰتٍۢ تَجْرِى مِن",274],["66:10:24",561,"ٱدْخُلَا","Enter","ٱللَّهِ شَيْـًۭٔا وَقِيلَ","ٱلنَّارَ مَعَ ٱلدَّٰخِلِينَ",151],["66:10:27",561,"ٱلدَّٰخِلِينَ","those who enter","ٱدْخُلَا ٱلنَّارَ مَعَ","",2351],["68:24:3",565,"يَدْخُلَنَّهَا","will enter it","أَن لَّا","ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌۭ",151],["70:38:6",569,"يُدْخَلَ","he enters","ٱمْرِئٍۢ مِّنْهُمْ أَن","جَنَّةَ نَعِيمٍۢ",274],["71:25:4",571,"فَأُدْخِلُوا۟","then made to enter","مِّمَّا خَطِيٓـَٔـٰتِهِمْ أُغْرِقُوا۟","نَارًۭا فَلَمْ يَجِدُوا۟",274],["71:28:6",571,"دَخَلَ","enters","لِى وَلِوَٰلِدَىَّ وَلِمَن","بَيْتِىَ مُؤْمِنًۭا وَلِلْمُؤْمِنِينَ",151],["76:31:1",580,"يُدْخِلُ","He admits","","مَن يَشَآءُ فِى",274],["89:29:1",594,"فَٱدْخُلِى","So enter","","فِى عِبَـٰدِى",151],["89:30:1",594,"وَٱدْخُلِى","And enter","","جَنَّتِى",151],["110:2:3",603,"يَدْخُلُونَ","entering","وَرَأَيْتَ ٱلنَّاسَ","فِى دِينِ ٱللَّهِ",151]]