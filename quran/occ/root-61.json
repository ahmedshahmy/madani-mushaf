[["2:96:8",15,"أَشْرَكُوا۟ ۚ","associate[d] partners (with Allah)","حَيَوٰةٍۢ وَمِنَ ٱلَّذِينَ","يَوَدُّ أَحَدُهُمْ لَوْ",168],["2:105:9",16,"ٱلْمُشْرِكِينَ","those who associate partners (with Allah)","أَهْلِ ٱلْكِتَـٰبِ وَلَا","أَن يُنَزَّلَ عَلَيْكُم",268],["2:135:15",21,"ٱلْمُشْرِكِينَ","those who associated partners (with Allah)","وَمَا كَانَ مِنَ","",268],["2:221:3",35,"ٱلْمُشْرِكَـٰتِ","[the] polytheistic women","وَلَا تَنكِحُوا۟","حَتَّىٰ يُؤْمِنَّ ۚ وَلَأَمَةٌۭ",1898],["2:221:10",35,"مُّشْرِكَةٍۢ","a polytheistic woman","مُّؤْمِنَةٌ خَيْرٌۭ مِّن","وَلَوْ أَعْجَبَتْكُمْ ۗ وَلَا",2478],["2:221:15",35,"ٱلْمُشْرِكِينَ","(to) [the] polytheistic men","أَعْجَبَتْكُمْ ۗ وَلَا تُنكِحُوا۟","حَتَّىٰ يُؤْمِنُوا۟ ۚ وَلَعَبْدٌۭ",268],["2:221:22",35,"مُّشْرِكٍۢ","a polytheistic man","مُّؤْمِنٌ خَيْرٌۭ مِّن","وَلَوْ أَعْجَبَكُمْ ۗ أُو۟لَـٰٓئِكَ",268],["3:64:15",58,"نُشْرِكَ","we associate partners","إِلَّا ٱللَّهَ وَلَا","بِهِۦ شَيْـًۭٔا وَلَا",168],["3:67:14",58,"ٱلْمُشْرِكِينَ","the polytheists","وَمَا كَانَ مِنَ","",268],["3:95:11",62,"ٱلْمُشْرِكِينَ","the polytheists","وَمَا كَانَ مِنَ","",268],["3:151:8",69,"أَشْرَكُوا۟","they associated partners","كَفَرُوا۟ ٱلرُّعْبَ بِمَآ","بِٱللَّهِ مَا لَمْ",168],["3:186:14",74,"أَشْرَكُوٓا۟","associate partners with Allah","قَبْلِكُمْ وَمِنَ ٱلَّذِينَ","أَذًۭى كَثِيرًۭا ۚ وَإِن",168],["4:12:71",79,"شُرَكَآءُ","(are) partners","مِن ذَٰلِكَ فَهُمْ","فِى ٱلثُّلُثِ ۚ مِنۢ",286],["4:36:4",84,"تُشْرِكُوا۟","associate","۞ وَٱعْبُدُوا۟ ٱللَّهَ وَلَا","بِهِۦ شَيْـًۭٔا ۖ وَبِٱلْوَٰلِدَيْنِ",168],["4:48:6",86,"يُشْرَكَ","partners be associated","لَا يَغْفِرُ أَن","بِهِۦ وَيَغْفِرُ مَا",168],["4:48:15",86,"يُشْرِكْ","associates partners","لِمَن يَشَآءُ ۚ وَمَن","بِٱللَّهِ فَقَدِ ٱفْتَرَىٰٓ",168],["4:116:6",97,"يُشْرَكَ","partners be associated","لَا يَغْفِرُ أَن","بِهِۦ وَيَغْفِرُ مَا",168],["4:116:15",97,"يُشْرِكْ","associates partners","لِمَن يَشَآءُ ۚ وَمَن","بِٱللَّهِ فَقَدْ ضَلَّ",168],["5:72:21",120,"يُشْرِكْ","associates partners","وَرَبَّكُمْ ۖ إِنَّهُۥ مَن","بِٱللَّهِ فَقَدْ حَرَّمَ",168],["5:82:9",121,"أَشْرَكُوا۟ ۖ","(are) polytheists","ءَامَنُوا۟ ٱلْيَهُودَ وَٱلَّذِينَ","وَلَتَجِدَنَّ أَقْرَبَهُم مَّوَدَّةًۭ",168],["6:14:24",129,"ٱلْمُشْرِكِينَ","the polytheists","وَلَا تَكُونَنَّ مِنَ","",268],["6:19:37",130,"تُشْرِكُونَ","you associate (with Him)","وَإِنَّنِى بَرِىٓءٌۭ مِّمَّا","",168],["6:22:7",130,"أَشْرَكُوٓا۟","associated others with Allah","ثُمَّ نَقُولُ لِلَّذِينَ","أَيْنَ شُرَكَآؤُكُمُ ٱلَّذِينَ",168],["6:22:9",130,"شُرَكَآؤُكُمُ","your partners","لِلَّذِينَ أَشْرَكُوٓا۟ أَيْنَ","ٱلَّذِينَ كُنتُمْ تَزْعُمُونَ",286],["6:23:12",130,"مُشْرِكِينَ","those who associated others (with Allah)","رَبِّنَا مَا كُنَّا","",268],["6:41:12",132,"تُشْرِكُونَ","you associate (with Him)","شَآءَ وَتَنسَوْنَ مَا","",168],["6:64:10",135,"تُشْرِكُونَ","associate partners (with Allah)","كَرْبٍۢ ثُمَّ أَنتُمْ","",168],["6:78:17",137,"تُشْرِكُونَ","you associate (with Allah)","إِنِّى بَرِىٓءٌۭ مِّمَّا","",168],["6:79:12",137,"ٱلْمُشْرِكِينَ","the polytheists","وَمَآ أَنَا۠ مِنَ","",268],["6:80:12",137,"تُشْرِكُونَ","you associate","وَلَآ أَخَافُ مَا","بِهِۦٓ إِلَّآ أَن",168],["6:81:4",137,"أَشْرَكْتُمْ","you associate (with Allah)","وَكَيْفَ أَخَافُ مَآ","وَلَا تَخَافُونَ أَنَّكُمْ",168],["6:81:8",137,"أَشْرَكْتُم","have associated","وَلَا تَخَافُونَ أَنَّكُمْ","بِٱللَّهِ مَا لَمْ",168],["6:88:11",138,"أَشْرَكُوا۟","they (had) associated partners (with Allah)","مِنْ عِبَادِهِۦ ۚ وَلَوْ","لَحَبِطَ عَنْهُم مَّا",168],["6:94:21",139,"شُرَكَـٰٓؤُا۟ ۚ","partners (with Allah)","زَعَمْتُمْ أَنَّهُمْ فِيكُمْ","لَقَد تَّقَطَّعَ بَيْنَكُمْ",286],["6:100:3",140,"شُرَكَآءَ","partners","وَجَعَلُوا۟ لِلَّهِ","ٱلْجِنَّ وَخَلَقَهُمْ ۖ وَخَرَقُوا۟",286],["6:106:13",141,"ٱلْمُشْرِكِينَ","the polytheists","هُوَ ۖ وَأَعْرِضْ عَنِ","",268],["6:107:5",141,"أَشْرَكُوا۟ ۗ","associated partners (with Him)","شَآءَ ٱللَّهُ مَآ","وَمَا جَعَلْنَـٰكَ عَلَيْهِمْ",168],["6:121:20",143,"لَمُشْرِكُونَ","(would) be the polytheists","وَإِنْ أَطَعْتُمُوهُمْ إِنَّكُمْ","",268],["6:136:14",145,"لِشُرَكَآئِنَا ۖ","(is) for our partners","لِلَّهِ بِزَعْمِهِمْ وَهَـٰذَا","فَمَا كَانَ لِشُرَكَآئِهِمْ",286],["6:136:17",145,"لِشُرَكَآئِهِمْ","for their partners","لِشُرَكَآئِنَا ۖ فَمَا كَانَ","فَلَا يَصِلُ إِلَى",286],["6:136:28",145,"شُرَكَآئِهِمْ ۗ","their partners","فَهُوَ يَصِلُ إِلَىٰ","سَآءَ مَا يَحْكُمُونَ",286],["6:137:5",145,"ٱلْمُشْرِكِينَ","the polytheists","زَيَّنَ لِكَثِيرٍۢ مِّنَ","قَتْلَ أَوْلَـٰدِهِمْ شُرَكَآؤُهُمْ",268],["6:137:8",145,"شُرَكَآؤُهُمْ","their partners","ٱلْمُشْرِكِينَ قَتْلَ أَوْلَـٰدِهِمْ","لِيُرْدُوهُمْ وَلِيَلْبِسُوا۟ عَلَيْهِمْ",286],["6:139:17",146,"شُرَكَآءُ ۚ","(are) partners","مَّيْتَةًۭ فَهُمْ فِيهِ","سَيَجْزِيهِمْ وَصْفَهُمْ ۚ إِنَّهُۥ",286],["6:148:3",148,"أَشْرَكُوا۟","associate partners (with Allah)","سَيَقُولُ ٱلَّذِينَ","لَوْ شَآءَ ٱللَّهُ",168],["6:148:8",148,"أَشْرَكْنَا","we (would) have associated partners (with Allah)","شَآءَ ٱللَّهُ مَآ","وَلَآ ءَابَآؤُنَا وَلَا",168],["6:151:9",148,"تُشْرِكُوا۟","associate","رَبُّكُمْ عَلَيْكُمْ ۖ أَلَّا","بِهِۦ شَيْـًۭٔا ۖ وَبِٱلْوَٰلِدَيْنِ",168],["6:161:16",150,"ٱلْمُشْرِكِينَ","the polytheists","وَمَا كَانَ مِنَ","",268],["6:163:2",150,"شَرِيكَ","partners","لَا","لَهُۥ ۖ وَبِذَٰلِكَ أُمِرْتُ",286],["7:33:16",154,"تُشْرِكُوا۟","you associate (others)","بِغَيْرِ ٱلْحَقِّ وَأَن","بِٱللَّهِ مَا لَمْ",168],["7:173:4",173,"أَشْرَكَ","partners (were) associated (with Allah)","أَوْ تَقُولُوٓا۟ إِنَّمَآ","ءَابَآؤُنَا مِن قَبْلُ",168],["7:190:6",175,"شُرَكَآءَ","partners","صَـٰلِحًۭا جَعَلَا لَهُۥ","فِيمَآ ءَاتَىٰهُمَا ۚ فَتَعَـٰلَى",286],["7:190:12",175,"يُشْرِكُونَ","they associate (with Him)","فَتَعَـٰلَى ٱللَّهُ عَمَّا","",168],["7:191:1",175,"أَيُشْرِكُونَ","Do they associate","","مَا لَا يَخْلُقُ",168],["7:195:22",175,"شُرَكَآءَكُمْ","your partners","بِهَا ۗ قُلِ ٱدْعُوا۟","ثُمَّ كِيدُونِ فَلَا",286],["9:1:9",187,"ٱلْمُشْرِكِينَ","the polytheists","ٱلَّذِينَ عَـٰهَدتُّم مِّنَ","",268],["9:3:14",187,"ٱلْمُشْرِكِينَ ۙ","(to) the polytheists","ٱللَّهَ بَرِىٓءٌۭ مِّنَ","وَرَسُولُهُۥ ۚ فَإِن تُبْتُمْ",268],["9:4:5",187,"ٱلْمُشْرِكِينَ","the polytheists","ٱلَّذِينَ عَـٰهَدتُّم مِّنَ","ثُمَّ لَمْ يَنقُصُوكُمْ",268],["9:5:6",187,"ٱلْمُشْرِكِينَ","the polytheists","ٱلْأَشْهُرُ ٱلْحُرُمُ فَٱقْتُلُوا۟","حَيْثُ وَجَدتُّمُوهُمْ وَخُذُوهُمْ",268],["9:6:4",187,"ٱلْمُشْرِكِينَ","the polytheists","وَإِنْ أَحَدٌۭ مِّنَ","ٱسْتَجَارَكَ فَأَجِرْهُ حَتَّىٰ",268],["9:7:3",188,"لِلْمُشْرِكِينَ","for the polytheists","كَيْفَ يَكُونُ","عَهْدٌ عِندَ ٱللَّهِ",268],["9:17:3",189,"لِلْمُشْرِكِينَ","for the polytheists","مَا كَانَ","أَن يَعْمُرُوا۟ مَسَـٰجِدَ",268],["9:28:5",191,"ٱلْمُشْرِكُونَ","the polytheists","ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّمَا","نَجَسٌۭ فَلَا يَقْرَبُوا۟",268],["9:31:23",191,"يُشْرِكُونَ","they associate (with Him)","هُوَ ۚ سُبْحَـٰنَهُۥ عَمَّا","",168],["9:33:14",192,"ٱلْمُشْرِكُونَ","the polytheists","كُلِّهِۦ وَلَوْ كَرِهَ","",268],["9:36:27",192,"ٱلْمُشْرِكِينَ","the polytheists","فِيهِنَّ أَنفُسَكُمْ ۚ وَقَـٰتِلُوا۟","كَآفَّةًۭ كَمَا يُقَـٰتِلُونَكُمْ",268],["9:113:8",205,"لِلْمُشْرِكِينَ","for the polytheists","ءَامَنُوٓا۟ أَن يَسْتَغْفِرُوا۟","وَلَوْ كَانُوٓا۟ أُو۟لِى",268],["10:18:29",210,"يُشْرِكُونَ","they associate (with Him)","سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ عَمَّا","",168],["10:28:7",212,"أَشْرَكُوا۟","associate partners (with Allah)","ثُمَّ نَقُولُ لِلَّذِينَ","مَكَانَكُمْ أَنتُمْ وَشُرَكَآؤُكُمْ ۚ",168],["10:28:10",212,"وَشُرَكَآؤُكُمْ ۚ","and your partners","أَشْرَكُوا۟ مَكَانَكُمْ أَنتُمْ","فَزَيَّلْنَا بَيْنَهُمْ ۖ وَقَالَ",286],["10:28:14",212,"شُرَكَآؤُهُم","their partners","فَزَيَّلْنَا بَيْنَهُمْ ۖ وَقَالَ","مَّا كُنتُمْ إِيَّانَا",286],["10:34:4",213,"شُرَكَآئِكُم","your partners","قُلْ هَلْ مِن","مَّن يَبْدَؤُا۟ ٱلْخَلْقَ",286],["10:35:4",213,"شُرَكَآئِكُم","your partners","قُلْ هَلْ مِن","مَّن يَهْدِىٓ إِلَى",286],["10:66:17",216,"شُرَكَآءَ ۚ","partners","مِن دُونِ ٱللَّهِ","إِن يَتَّبِعُونَ إِلَّا",286],["10:71:22",217,"وَشُرَكَآءَكُمْ","and your partners","تَوَكَّلْتُ فَأَجْمِعُوٓا۟ أَمْرَكُمْ","ثُمَّ لَا يَكُنْ",286],["10:105:9",220,"ٱلْمُشْرِكِينَ","the polytheists","وَلَا تَكُونَنَّ مِنَ","",268],["11:54:16",228,"تُشْرِكُونَ","you associate","أَنِّى بَرِىٓءٌۭ مِّمَّا","",168],["12:38:11",240,"نُّشْرِكَ","we associate","كَانَ لَنَآ أَن","بِٱللَّهِ مِن شَىْءٍۢ ۚ",168],["12:106:7",248,"مُّشْرِكُونَ","associate partners with Him","بِٱللَّهِ إِلَّا وَهُم","",268],["12:108:17",248,"ٱلْمُشْرِكِينَ","the polytheists","وَمَآ أَنَا۠ مِنَ","",268],["13:16:32",251,"شُرَكَآءَ","partners","أَمْ جَعَلُوا۟ لِلَّهِ","خَلَقُوا۟ كَخَلْقِهِۦ فَتَشَـٰبَهَ",286],["13:33:11",253,"شُرَكَآءَ","partners","كَسَبَتْ ۗ وَجَعَلُوا۟ لِلَّهِ","قُلْ سَمُّوهُمْ ۚ أَمْ",286],["13:36:20",254,"أُشْرِكَ","I associate partners","أَعْبُدَ ٱللَّهَ وَلَآ","بِهِۦٓ ۚ إِلَيْهِ أَدْعُوا۟",168],["14:22:37",258,"أَشْرَكْتُمُونِ","your association of me (with Allah)","إِنِّى كَفَرْتُ بِمَآ","مِن قَبْلُ ۗ إِنَّ",168],["15:94:6",267,"ٱلْمُشْرِكِينَ","the polytheists","تُؤْمَرُ وَأَعْرِضْ عَنِ","",268],["16:1:9",267,"يُشْرِكُونَ","they associate","سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ عَمَّا","",168],["16:3:7",267,"يُشْرِكُونَ","they associate","بِٱلْحَقِّ ۚ تَعَـٰلَىٰ عَمَّا","",168],["16:27:7",270,"شُرَكَآءِىَ","(are) My partners","يُخْزِيهِمْ وَيَقُولُ أَيْنَ","ٱلَّذِينَ كُنتُمْ تُشَـٰٓقُّونَ",286],["16:35:3",271,"أَشْرَكُوا۟","associate partners (with Allah)","وَقَالَ ٱلَّذِينَ","لَوْ شَآءَ ٱللَّهُ",168],["16:54:10",272,"يُشْرِكُونَ","associate others","فَرِيقٌۭ مِّنكُم بِرَبِّهِمْ","",168],["16:86:4",276,"أَشْرَكُوا۟","associated partners with Allah","وَإِذَا رَءَا ٱلَّذِينَ","شُرَكَآءَهُمْ قَالُوا۟ رَبَّنَا",168],["16:86:5",276,"شُرَكَآءَهُمْ","their partners","رَءَا ٱلَّذِينَ أَشْرَكُوا۟","قَالُوا۟ رَبَّنَا هَـٰٓؤُلَآءِ",286],["16:86:9",276,"شُرَكَآؤُنَا","(are) our partners","قَالُوا۟ رَبَّنَا هَـٰٓؤُلَآءِ","ٱلَّذِينَ كُنَّا نَدْعُوا۟",286],["16:100:9",278,"مُشْرِكُونَ","associate partners","وَٱلَّذِينَ هُم بِهِۦ","",268],["16:120:11",281,"ٱلْمُشْرِكِينَ","the polytheists","وَلَمْ يَكُ مِنَ","",268],["16:123:12",281,"ٱلْمُشْرِكِينَ","the polytheists","وَمَا كَانَ مِنَ","",268],["17:64:10",288,"وَشَارِكْهُمْ","and be a partner","عَلَيْهِم بِخَيْلِكَ وَرَجِلِكَ","فِى ٱلْأَمْوَٰلِ وَٱلْأَوْلَـٰدِ",2860],["17:111:11",293,"شَرِيكٌۭ","a partner","وَلَمْ يَكُن لَّهُۥ","فِى ٱلْمُلْكِ وَلَمْ",286],["18:26:20",296,"يُشْرِكُ","He shares","مِن وَلِىٍّۢ وَلَا","فِى حُكْمِهِۦٓ أَحَدًۭا",168],["18:38:6",298,"أُشْرِكُ","I associate","ٱللَّهُ رَبِّى وَلَآ","بِرَبِّىٓ أَحَدًۭا",168],["18:42:17",298,"أُشْرِكْ","I had not associated","وَيَقُولُ يَـٰلَيْتَنِى لَمْ","بِرَبِّىٓ أَحَدًۭا",168],["18:52:4",299,"شُرَكَآءِىَ","My partners","وَيَوْمَ يَقُولُ نَادُوا۟","ٱلَّذِينَ زَعَمْتُمْ فَدَعَوْهُمْ",286],["18:110:21",304,"يُشْرِكْ","associate","عَمَلًۭا صَـٰلِحًۭا وَلَا","بِعِبَادَةِ رَبِّهِۦٓ أَحَدًۢا",168],["20:32:1",313,"وَأَشْرِكْهُ","And make him share","","فِىٓ أَمْرِى",168],["22:17:10",334,"أَشْرَكُوٓا۟","(are) polytheists","وَٱلنَّصَـٰرَىٰ وَٱلْمَجُوسَ وَٱلَّذِينَ","إِنَّ ٱللَّهَ يَفْصِلُ",168],["22:26:8",335,"تُشْرِكْ","associate","ٱلْبَيْتِ أَن لَّا","بِى شَيْـًۭٔا وَطَهِّرْ",168],["22:31:4",336,"مُشْرِكِينَ","associating partners","حُنَفَآءَ لِلَّهِ غَيْرَ","بِهِۦ ۚ وَمَن يُشْرِكْ",268],["22:31:7",336,"يُشْرِكْ","associates partners","مُشْرِكِينَ بِهِۦ ۚ وَمَن","بِٱللَّهِ فَكَأَنَّمَا خَرَّ",168],["23:59:5",345,"يُشْرِكُونَ","associate partners","هُم بِرَبِّهِمْ لَا","",168],["23:92:6",348,"يُشْرِكُونَ","they associate","وَٱلشَّهَـٰدَةِ فَتَعَـٰلَىٰ عَمَّا","",168],["24:3:7",350,"مُشْرِكَةًۭ","a polytheist woman","إِلَّا زَانِيَةً أَوْ","وَٱلزَّانِيَةُ لَا يَنكِحُهَآ",2478],["24:3:14",350,"مُشْرِكٌۭ ۚ","a polytheist man","إِلَّا زَانٍ أَوْ","وَحُرِّمَ ذَٰلِكَ عَلَى",268],["24:55:29",357,"يُشْرِكُونَ","they associate","أَمْنًۭا ۚ يَعْبُدُونَنِى لَا","بِى شَيْـًۭٔا ۚ وَمَن",168],["25:2:12",359,"شَرِيكٌۭ","a partner","وَلَمْ يَكُن لَّهُۥ","فِى ٱلْمُلْكِ وَخَلَقَ",286],["27:59:12",382,"يُشْرِكُونَ","they associate (with Him)","ءَآللَّهُ خَيْرٌ أَمَّا","",168],["27:63:20",382,"يُشْرِكُونَ","they associate (with Him)","تَعَـٰلَى ٱللَّهُ عَمَّا","",168],["28:62:5",393,"شُرَكَآءِىَ","(are) My partners","يُنَادِيهِمْ فَيَقُولُ أَيْنَ","ٱلَّذِينَ كُنتُمْ تَزْعُمُونَ",286],["28:64:3",393,"شُرَكَآءَكُمْ","your partners","وَقِيلَ ٱدْعُوا۟","فَدَعَوْهُمْ فَلَمْ يَسْتَجِيبُوا۟",286],["28:68:14",393,"يُشْرِكُونَ","they associate (with Him)","ٱللَّهِ وَتَعَـٰلَىٰ عَمَّا","",168],["28:74:5",394,"شُرَكَآءِىَ","(are) My partners","يُنَادِيهِمْ فَيَقُولُ أَيْنَ","ٱلَّذِينَ كُنتُمْ تَزْعُمُونَ",286],["28:87:16",396,"ٱلْمُشْرِكِينَ","the polytheists","وَلَا تَكُونَنَّ مِنَ","",268],["29:8:7",397,"لِتُشْرِكَ","to make you associate","حُسْنًۭا ۖ وَإِن جَـٰهَدَاكَ","بِى مَا لَيْسَ",168],["29:65:16",404,"يُشْرِكُونَ","associate partners (with Him)","ٱلْبَرِّ إِذَا هُمْ","",168],["30:13:5",405,"شُرَكَآئِهِمْ","theirs partners","يَكُن لَّهُم مِّن","شُفَعَـٰٓؤُا۟ وَكَانُوا۟ بِشُرَكَآئِهِمْ",286],["30:13:8",405,"بِشُرَكَآئِهِمْ","in their partners","شُرَكَآئِهِمْ شُفَعَـٰٓؤُا۟ وَكَانُوا۟","كَـٰفِرِينَ",286],["30:28:13",407,"شُرَكَآءَ","partners","مَلَكَتْ أَيْمَـٰنُكُم مِّن","فِى مَا رَزَقْنَـٰكُمْ",286],["30:31:9",407,"ٱلْمُشْرِكِينَ","the polytheists","وَلَا تَكُونُوا۟ مِنَ","",268],["30:33:18",408,"يُشْرِكُونَ","associate partners","فَرِيقٌۭ مِّنْهُم بِرَبِّهِمْ","",168],["30:35:10",408,"يُشْرِكُونَ","associating","بِمَا كَانُوا۟ بِهِۦ","",168],["30:40:12",408,"شُرَكَآئِكُم","(of) your partners","يُحْيِيكُمْ ۖ هَلْ مِن","مَّن يَفْعَلُ مِن",286],["30:40:22",408,"يُشْرِكُونَ","they associate","سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ عَمَّا","",168],["30:42:14",409,"مُّشْرِكِينَ","polytheists","قَبْلُ ۚ كَانَ أَكْثَرُهُم","",268],["31:13:9",412,"تُشْرِكْ","associate partners","يَعِظُهُۥ يَـٰبُنَىَّ لَا","بِٱللَّهِ ۖ إِنَّ ٱلشِّرْكَ",168],["31:13:12",412,"ٱلشِّرْكَ","associating partners","تُشْرِكْ بِٱللَّهِ ۖ إِنَّ","لَظُلْمٌ عَظِيمٌۭ",1265],["31:15:5",412,"تُشْرِكَ","you associate partners","جَـٰهَدَاكَ عَلَىٰٓ أَن","بِى مَا لَيْسَ",168],["33:73:5",427,"وَٱلْمُشْرِكِينَ","and the polytheist men","ٱللَّهُ ٱلْمُنَـٰفِقِينَ وَٱلْمُنَـٰفِقَـٰتِ","وَٱلْمُشْرِكَـٰتِ وَيَتُوبَ ٱللَّهُ",268],["33:73:6",427,"وَٱلْمُشْرِكَـٰتِ","and the polytheist women","ٱلْمُنَـٰفِقِينَ وَٱلْمُنَـٰفِقَـٰتِ وَٱلْمُشْرِكِينَ","وَيَتُوبَ ٱللَّهُ عَلَى",1898],["34:22:21",430,"شِرْكٍۢ","partnership","لَهُمْ فِيهِمَا مِن","وَمَا لَهُۥ مِنْهُم",1265],["34:27:6",431,"شُرَكَآءَ ۖ","(as) partners","ٱلَّذِينَ أَلْحَقْتُم بِهِۦ","كَلَّا ۚ بَلْ هُوَ",286],["35:14:14",436,"بِشِرْكِكُمْ ۚ","your association","وَيَوْمَ ٱلْقِيَـٰمَةِ يَكْفُرُونَ","وَلَا يُنَبِّئُكَ مِثْلُ",1265],["35:40:3",439,"شُرَكَآءَكُمُ","your partners","قُلْ أَرَءَيْتُمْ","ٱلَّذِينَ تَدْعُونَ مِن",286],["35:40:16",439,"شِرْكٌۭ","(is) a share","ٱلْأَرْضِ أَمْ لَهُمْ","فِى ٱلسَّمَـٰوَٰتِ أَمْ",1265],["37:33:5",447,"مُشْتَرِكُونَ","(will be) sharers","يَوْمَئِذٍۢ فِى ٱلْعَذَابِ","",2479],["39:29:6",461,"شُرَكَآءُ","partners","مَثَلًۭا رَّجُلًۭا فِيهِ","مُتَشَـٰكِسُونَ وَرَجُلًۭا سَلَمًۭا",286],["39:65:9",465,"أَشْرَكْتَ","you associate (with Allah)","مِن قَبْلِكَ لَئِنْ","لَيَحْبَطَنَّ عَمَلُكَ وَلَتَكُونَنَّ",168],["39:67:17",465,"يُشْرِكُونَ","they associate (with Him)","سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ عَمَّا","",168],["40:12:9",468,"يُشْرَكْ","(others) were associated","وَحْدَهُۥ كَفَرْتُمْ ۖ وَإِن","بِهِۦ تُؤْمِنُوا۟ ۚ فَٱلْحُكْمُ",168],["40:42:4",472,"وَأُشْرِكَ","and (to) associate","تَدْعُونَنِى لِأَكْفُرَ بِٱللَّهِ","بِهِۦ مَا لَيْسَ",168],["40:73:7",475,"تُشْرِكُونَ","associate","أَيْنَ مَا كُنتُمْ","",168],["40:84:12",476,"مُشْرِكِينَ","associate","بِمَا كُنَّا بِهِۦ","",268],["41:6:16",477,"لِّلْمُشْرِكِينَ","to the polytheists","إِلَيْهِ وَٱسْتَغْفِرُوهُ ۗ وَوَيْلٌۭ","",268],["41:47:22",482,"شُرَكَآءِى","My partners","وَيَوْمَ يُنَادِيهِمْ أَيْنَ","قَالُوٓا۟ ءَاذَنَّـٰكَ مَا",286],["42:13:26",484,"ٱلْمُشْرِكِينَ","the polytheists","فِيهِ ۚ كَبُرَ عَلَى","مَا تَدْعُوهُمْ إِلَيْهِ ۚ",268],["42:21:3",485,"شُرَكَـٰٓؤُا۟","(are) partners","أَمْ لَهُمْ","شَرَعُوا۟ لَهُم مِّنَ",286],["43:39:9",492,"مُشْتَرِكُونَ","sharing","أَنَّكُمْ فِى ٱلْعَذَابِ","",2479],["46:4:15",502,"شِرْكٌۭ","(is) any share","ٱلْأَرْضِ أَمْ لَهُمْ","فِى ٱلسَّمَـٰوَٰتِ ۖ ٱئْتُونِى",1265],["48:6:4",511,"وَٱلْمُشْرِكِينَ","and the polytheist men","وَيُعَذِّبَ ٱلْمُنَـٰفِقِينَ وَٱلْمُنَـٰفِقَـٰتِ","وَٱلْمُشْرِكَـٰتِ ٱلظَّآنِّينَ بِٱللَّهِ",268],["48:6:5",511,"وَٱلْمُشْرِكَـٰتِ","and the polytheist women","ٱلْمُنَـٰفِقِينَ وَٱلْمُنَـٰفِقَـٰتِ وَٱلْمُشْرِكِينَ","ٱلظَّآنِّينَ بِٱللَّهِ ظَنَّ",1898],["52:43:9",525,"يُشْرِكُونَ","they associate (with Him)","سُبْحَـٰنَ ٱللَّهِ عَمَّا","",168],["59:23:19",548,"يُشْرِكُونَ","they associate (with Him)","سُبْحَـٰنَ ٱللَّهِ عَمَّا","",168],["60:12:10",551,"يُشْرِكْنَ","they will associate","عَلَىٰٓ أَن لَّا","بِٱللَّهِ شَيْـًۭٔا وَلَا",168],["61:9:14",552,"ٱلْمُشْرِكُونَ","the polytheists","كُلِّهِۦ وَلَوْ كَرِهَ","",268],["68:41:3",565,"شُرَكَآءُ","partners","أَمْ لَهُمْ","فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن",286],["68:41:5",565,"بِشُرَكَآئِهِمْ","their partners","لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟","إِن كَانُوا۟ صَـٰدِقِينَ",286],["72:2:7",572,"نُّشْرِكَ","we will associate","فَـَٔامَنَّا بِهِۦ ۖ وَلَن","بِرَبِّنَآ أَحَدًۭا",168],["72:20:6",573,"أُشْرِكُ","I associate","أَدْعُوا۟ رَبِّى وَلَآ","بِهِۦٓ أَحَدًۭا",168],["98:1:8",598,"وَٱلْمُشْرِكِينَ","and the polytheists","مِنْ أَهْلِ ٱلْكِتَـٰبِ","مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ",268],["98:6:7",599,"وَٱلْمُشْرِكِينَ","and the polytheists","مِنْ أَهْلِ ٱلْكِتَـٰبِ","فِى نَارِ جَهَنَّمَ",268]]