[["2:178:23",27,"وَأَدَآءٌ","[and] payment","شَىْءٌۭ فَٱتِّبَاعٌۢ بِٱلْمَعْرُوفِ","إِلَيْهِ بِإِحْسَـٰنٍۢ ۗ ذَٰلِكَ",2981],["2:283:14",49,"فَلْيُؤَدِّ","then let discharge","أَمِنَ بَعْضُكُم بَعْضًۭا","ٱلَّذِى ٱؤْتُمِنَ أَمَـٰنَتَهُۥ",1435],["3:75:8",59,"يُؤَدِّهِۦٓ","he will return it","إِن تَأْمَنْهُ بِقِنطَارٍۢ","إِلَيْكَ وَمِنْهُم مَّنْ",1435],["3:75:16",59,"يُؤَدِّهِۦٓ","he will return it","تَأْمَنْهُ بِدِينَارٍۢ لَّا","إِلَيْكَ إِلَّا مَا",1435],["4:58:5",87,"تُؤَدُّوا۟","render","ٱللَّهَ يَأْمُرُكُمْ أَن","ٱلْأَمَـٰنَـٰتِ إِلَىٰٓ أَهْلِهَا",1435],["44:18:2",496,"أَدُّوٓا۟","Deliver","أَنْ","إِلَىَّ عِبَادَ ٱللَّهِ ۖ",1435]]