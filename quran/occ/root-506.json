[["6:50:6",133,"خَزَآئِنُ","(are the) treasures","أَقُولُ لَكُمْ عِندِى","ٱللَّهِ وَلَآ أَعْلَمُ",1011],["11:31:5",225,"خَزَآئِنُ","(are the) treasures","أَقُولُ لَكُمْ عِندِى","ٱللَّهِ وَلَآ أَعْلَمُ",1011],["12:55:4",242,"خَزَآئِنِ","(the) treasuries","قَالَ ٱجْعَلْنِى عَلَىٰ","ٱلْأَرْضِ ۖ إِنِّى حَفِيظٌ",1011],["15:21:6",263,"خَزَآئِنُهُۥ","(are) its treasures","شَىْءٍ إِلَّا عِندَنَا","وَمَا نُنَزِّلُهُۥٓ إِلَّا",1011],["15:22:12",263,"بِخَـٰزِنِينَ","(are) retainers","وَمَآ أَنتُمْ لَهُۥ","",4567],["17:100:5",292,"خَزَآئِنَ","the treasures","لَّوْ أَنتُمْ تَمْلِكُونَ","رَحْمَةِ رَبِّىٓ إِذًۭا",1011],["38:9:3",453,"خَزَآئِنُ","(the) treasures","أَمْ عِندَهُمْ","رَحْمَةِ رَبِّكَ ٱلْعَزِيزِ",1011],["39:71:14",466,"خَزَنَتُهَآ","its keepers","أَبْوَٰبُهَا وَقَالَ لَهُمْ","أَلَمْ يَأْتِكُمْ رُسُلٌۭ",1666],["39:73:15",466,"خَزَنَتُهَا","its keepers","أَبْوَٰبُهَا وَقَالَ لَهُمْ","سَلَـٰمٌ عَلَيْكُمْ طِبْتُمْ",1666],["40:49:5",472,"لِخَزَنَةِ","to (the) keepers","ٱلَّذِينَ فِى ٱلنَّارِ","جَهَنَّمَ ٱدْعُوا۟ رَبَّكُمْ",1666],["52:37:3",525,"خَزَآئِنُ","(are the) treasures","أَمْ عِندَهُمْ","رَبِّكَ أَمْ هُمُ",1011],["63:7:14",555,"خَزَآئِنُ","(are the) treasures","حَتَّىٰ يَنفَضُّوا۟ ۗ وَلِلَّهِ","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَلَـٰكِنَّ",1011],["67:8:10",562,"خَزَنَتُهَآ","its keepers","فِيهَا فَوْجٌۭ سَأَلَهُمْ","أَلَمْ يَأْتِكُمْ نَذِيرٌۭ",1666]]