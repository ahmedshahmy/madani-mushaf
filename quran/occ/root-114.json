[["2:3:5",2,"ٱلصَّلَوٰةَ","the prayer","يُؤْمِنُونَ بِٱلْغَيْبِ وَيُقِيمُونَ","وَمِمَّا رَزَقْنَـٰهُمْ يُنفِقُونَ",133],["2:43:2",7,"ٱلصَّلَوٰةَ","the prayer","وَأَقِيمُوا۟","وَءَاتُوا۟ ٱلزَّكَوٰةَ وَٱرْكَعُوا۟",133],["2:45:3",7,"وَٱلصَّلَوٰةِ ۚ","and the prayer","وَٱسْتَعِينُوا۟ بِٱلصَّبْرِ","وَإِنَّهَا لَكَبِيرَةٌ إِلَّا",133],["2:83:20",12,"ٱلصَّلَوٰةَ","the prayer","لِلنَّاسِ حُسْنًۭا وَأَقِيمُوا۟","وَءَاتُوا۟ ٱلزَّكَوٰةَ ثُمَّ",133],["2:110:2",17,"ٱلصَّلَوٰةَ","the prayer","وَأَقِيمُوا۟","وَءَاتُوا۟ ٱلزَّكَوٰةَ ۚ وَمَا",133],["2:125:11",19,"مُصَلًّۭى ۖ","(as) a place of prayer","مِن مَّقَامِ إِبْرَٰهِـۧمَ","وَعَهِدْنَآ إِلَىٰٓ إِبْرَٰهِـۧمَ",3772],["2:153:6",23,"وَٱلصَّلَوٰةِ ۚ","and the prayer","ءَامَنُوا۟ ٱسْتَعِينُوا۟ بِٱلصَّبْرِ","إِنَّ ٱللَّهَ مَعَ",133],["2:157:3",24,"صَلَوَٰتٌۭ","(are) blessings","أُو۟لَـٰٓئِكَ عَلَيْهِمْ","مِّن رَّبِّهِمْ وَرَحْمَةٌۭ ۖ",133],["2:177:33",27,"ٱلصَّلَوٰةَ","the prayer","وَفِى ٱلرِّقَابِ وَأَقَامَ","وَءَاتَى ٱلزَّكَوٰةَ وَٱلْمُوفُونَ",133],["2:238:3",39,"ٱلصَّلَوَٰتِ","the prayers","حَـٰفِظُوا۟ عَلَى","وَٱلصَّلَوٰةِ ٱلْوُسْطَىٰ وَقُومُوا۟",133],["2:238:4",39,"وَٱلصَّلَوٰةِ","and the prayer","حَـٰفِظُوا۟ عَلَى ٱلصَّلَوَٰتِ","ٱلْوُسْطَىٰ وَقُومُوا۟ لِلَّهِ",133],["2:277:7",47,"ٱلصَّلَوٰةَ","the prayer","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَأَقَامُوا۟","وَءَاتَوُا۟ ٱلزَّكَوٰةَ لَهُمْ",133],["3:39:5",55,"يُصَلِّى","praying","ٱلْمَلَـٰٓئِكَةُ وَهُوَ قَآئِمٌۭ","فِى ٱلْمِحْرَابِ أَنَّ",723],["4:43:6",85,"ٱلصَّلَوٰةَ","the prayer","ءَامَنُوا۟ لَا تَقْرَبُوا۟","وَأَنتُمْ سُكَـٰرَىٰ حَتَّىٰ",133],["4:77:10",90,"ٱلصَّلَوٰةَ","the prayer","كُفُّوٓا۟ أَيْدِيَكُمْ وَأَقِيمُوا۟","وَءَاتُوا۟ ٱلزَّكَوٰةَ فَلَمَّا",133],["4:101:11",94,"ٱلصَّلَوٰةِ","the prayer","أَن تَقْصُرُوا۟ مِنَ","إِنْ خِفْتُمْ أَن",133],["4:102:6",95,"ٱلصَّلَوٰةَ","the prayer","فِيهِمْ فَأَقَمْتَ لَهُمُ","فَلْتَقُمْ طَآئِفَةٌۭ مِّنْهُم",133],["4:102:22",95,"يُصَلُّوا۟","prayed","طَآئِفَةٌ أُخْرَىٰ لَمْ","فَلْيُصَلُّوا۟ مَعَكَ وَلْيَأْخُذُوا۟",723],["4:102:23",95,"فَلْيُصَلُّوا۟","and let them pray","أُخْرَىٰ لَمْ يُصَلُّوا۟","مَعَكَ وَلْيَأْخُذُوا۟ حِذْرَهُمْ",723],["4:103:3",95,"ٱلصَّلَوٰةَ","the prayer","فَإِذَا قَضَيْتُمُ","فَٱذْكُرُوا۟ ٱللَّهَ قِيَـٰمًۭا",133],["4:103:13",95,"ٱلصَّلَوٰةَ ۚ","the (regular) prayer","فَإِذَا ٱطْمَأْنَنتُمْ فَأَقِيمُوا۟","إِنَّ ٱلصَّلَوٰةَ كَانَتْ",133],["4:103:15",95,"ٱلصَّلَوٰةَ","the prayer","فَأَقِيمُوا۟ ٱلصَّلَوٰةَ ۚ إِنَّ","كَانَتْ عَلَى ٱلْمُؤْمِنِينَ",133],["4:142:10",101,"ٱلصَّلَوٰةِ","the prayer","وَإِذَا قَامُوٓا۟ إِلَى","قَامُوا۟ كُسَالَىٰ يُرَآءُونَ",133],["4:162:16",103,"ٱلصَّلَوٰةَ ۚ","the prayer","مِن قَبْلِكَ ۚ وَٱلْمُقِيمِينَ","وَٱلْمُؤْتُونَ ٱلزَّكَوٰةَ وَٱلْمُؤْمِنُونَ",133],["5:6:7",108,"ٱلصَّلَوٰةِ","the prayer","إِذَا قُمْتُمْ إِلَى","فَٱغْسِلُوا۟ وُجُوهَكُمْ وَأَيْدِيَكُمْ",133],["5:12:18",109,"ٱلصَّلَوٰةَ","the prayer","مَعَكُمْ ۖ لَئِنْ أَقَمْتُمُ","وَءَاتَيْتُمُ ٱلزَّكَوٰةَ وَءَامَنتُم",133],["5:55:9",117,"ٱلصَّلَوٰةَ","the prayer","ءَامَنُوا۟ ٱلَّذِينَ يُقِيمُونَ","وَيُؤْتُونَ ٱلزَّكَوٰةَ وَهُمْ",133],["5:58:4",118,"ٱلصَّلَوٰةِ","the prayer","وَإِذَا نَادَيْتُمْ إِلَى","ٱتَّخَذُوهَا هُزُوًۭا وَلَعِبًۭا ۚ",133],["5:91:17",123,"ٱلصَّلَوٰةِ ۖ","the prayer","ذِكْرِ ٱللَّهِ وَعَنِ","فَهَلْ أَنتُم مُّنتَهُونَ",133],["5:106:31",125,"ٱلصَّلَوٰةِ","the prayer","تَحْبِسُونَهُمَا مِنۢ بَعْدِ","فَيُقْسِمَانِ بِٱللَّهِ إِنِ",133],["6:72:3",136,"ٱلصَّلَوٰةَ","the prayer","وَأَنْ أَقِيمُوا۟","وَٱتَّقُوهُ ۚ وَهُوَ ٱلَّذِىٓ",133],["6:92:21",139,"صَلَاتِهِمْ","their prayers","بِهِۦ ۖ وَهُمْ عَلَىٰ","يُحَافِظُونَ",133],["6:162:3",150,"صَلَاتِى","my prayer","قُلْ إِنَّ","وَنُسُكِى وَمَحْيَاىَ وَمَمَاتِى",133],["7:170:5",172,"ٱلصَّلَوٰةَ","the prayer","يُمَسِّكُونَ بِٱلْكِتَـٰبِ وَأَقَامُوا۟","إِنَّا لَا نُضِيعُ",133],["8:3:3",177,"ٱلصَّلَوٰةَ","the prayer","ٱلَّذِينَ يُقِيمُونَ","وَمِمَّا رَزَقْنَـٰهُمْ يُنفِقُونَ",133],["8:35:3",181,"صَلَاتُهُمْ","their prayer","وَمَا كَانَ","عِندَ ٱلْبَيْتِ إِلَّا",133],["9:5:18",187,"ٱلصَّلَوٰةَ","the prayer","فَإِن تَابُوا۟ وَأَقَامُوا۟","وَءَاتَوُا۟ ٱلزَّكَوٰةَ فَخَلُّوا۟",133],["9:11:4",188,"ٱلصَّلَوٰةَ","the prayer","فَإِن تَابُوا۟ وَأَقَامُوا۟","وَءَاتَوُا۟ ٱلزَّكَوٰةَ فَإِخْوَٰنُكُمْ",133],["9:18:11",189,"ٱلصَّلَوٰةَ","the prayer","وَٱلْيَوْمِ ٱلْـَٔاخِرِ وَأَقَامَ","وَءَاتَى ٱلزَّكَوٰةَ وَلَمْ",133],["9:54:14",195,"ٱلصَّلَوٰةَ","(to) the prayer","وَبِرَسُولِهِۦ وَلَا يَأْتُونَ","إِلَّا وَهُمْ كُسَالَىٰ",133],["9:71:12",198,"ٱلصَّلَوٰةَ","the prayer","عَنِ ٱلْمُنكَرِ وَيُقِيمُونَ","وَيُؤْتُونَ ٱلزَّكَوٰةَ وَيُطِيعُونَ",133],["9:84:2",200,"تُصَلِّ","you pray","وَلَا","عَلَىٰٓ أَحَدٍۢ مِّنْهُم",723],["9:99:14",202,"وَصَلَوَٰتِ","and blessings","قُرُبَـٰتٍ عِندَ ٱللَّهِ","ٱلرَّسُولِ ۚ أَلَآ إِنَّهَا",133],["9:103:8",203,"وَصَلِّ","and bless","تُطَهِّرُهُمْ وَتُزَكِّيهِم بِهَا","عَلَيْهِمْ ۖ إِنَّ صَلَوٰتَكَ",723],["9:103:11",203,"صَلَوٰتَكَ","your blessings","وَصَلِّ عَلَيْهِمْ ۖ إِنَّ","سَكَنٌۭ لَّهُمْ ۗ وَٱللَّهُ",133],["10:87:14",218,"ٱلصَّلَوٰةَ ۗ","the prayer","بُيُوتَكُمْ قِبْلَةًۭ وَأَقِيمُوا۟","وَبَشِّرِ ٱلْمُؤْمِنِينَ",133],["11:87:3",231,"أَصَلَوٰتُكَ","Does your prayer","قَالُوا۟ يَـٰشُعَيْبُ","تَأْمُرُكَ أَن نَّتْرُكَ",133],["11:114:2",234,"ٱلصَّلَوٰةَ","the prayer","وَأَقِمِ","طَرَفَىِ ٱلنَّهَارِ وَزُلَفًۭا",133],["13:22:7",252,"ٱلصَّلَوٰةَ","the prayer","وَجْهِ رَبِّهِمْ وَأَقَامُوا۟","وَأَنفَقُوا۟ مِمَّا رَزَقْنَـٰهُمْ",133],["14:31:6",259,"ٱلصَّلَوٰةَ","the prayers","ٱلَّذِينَ ءَامَنُوا۟ يُقِيمُوا۟","وَيُنفِقُوا۟ مِمَّا رَزَقْنَـٰهُمْ",133],["14:37:15",260,"ٱلصَّلَوٰةَ","the prayers","ٱلْمُحَرَّمِ رَبَّنَا لِيُقِيمُوا۟","فَٱجْعَلْ أَفْـِٔدَةًۭ مِّنَ",133],["14:40:4",260,"ٱلصَّلَوٰةِ","(of) the prayer","رَبِّ ٱجْعَلْنِى مُقِيمَ","وَمِن ذُرِّيَّتِى ۚ رَبَّنَا",133],["17:78:2",290,"ٱلصَّلَوٰةَ","the prayer","أَقِمِ","لِدُلُوكِ ٱلشَّمْسِ إِلَىٰ",133],["17:110:15",293,"بِصَلَاتِكَ","in your prayers","ٱلْحُسْنَىٰ ۚ وَلَا تَجْهَرْ","وَلَا تُخَافِتْ بِهَا",133],["19:31:7",307,"بِٱلصَّلَوٰةِ","[of] the prayer","مَا كُنتُ وَأَوْصَـٰنِى","وَٱلزَّكَوٰةِ مَا دُمْتُ",133],["19:55:4",309,"بِٱلصَّلَوٰةِ","the prayer","وَكَانَ يَأْمُرُ أَهْلَهُۥ","وَٱلزَّكَوٰةِ وَكَانَ عِندَ",133],["19:59:6",309,"ٱلصَّلَوٰةَ","the prayer","بَعْدِهِمْ خَلْفٌ أَضَاعُوا۟","وَٱتَّبَعُوا۟ ٱلشَّهَوَٰتِ ۖ فَسَوْفَ",133],["20:14:10",313,"ٱلصَّلَوٰةَ","the prayer","أَنَا۠ فَٱعْبُدْنِى وَأَقِمِ","لِذِكْرِىٓ",133],["20:132:3",321,"بِٱلصَّلَوٰةِ","the prayer","وَأْمُرْ أَهْلَكَ","وَٱصْطَبِرْ عَلَيْهَا ۖ لَا",133],["21:73:10",328,"ٱلصَّلَوٰةِ","(of) the prayer","فِعْلَ ٱلْخَيْرَٰتِ وَإِقَامَ","وَإِيتَآءَ ٱلزَّكَوٰةِ ۖ وَكَانُوا۟",133],["22:35:12",336,"ٱلصَّلَوٰةِ","the prayer","مَآ أَصَابَهُمْ وَٱلْمُقِيمِى","وَمِمَّا رَزَقْنَـٰهُمْ يُنفِقُونَ",133],["22:40:21",337,"وَصَلَوَٰتٌۭ","and synagogues","لَّهُدِّمَتْ صَوَٰمِعُ وَبِيَعٌۭ","وَمَسَـٰجِدُ يُذْكَرُ فِيهَا",133],["22:41:7",337,"ٱلصَّلَوٰةَ","the prayer","فِى ٱلْأَرْضِ أَقَامُوا۟","وَءَاتَوُا۟ ٱلزَّكَوٰةَ وَأَمَرُوا۟",133],["22:78:34",341,"ٱلصَّلَوٰةَ","the prayer","عَلَى ٱلنَّاسِ ۚ فَأَقِيمُوا۟","وَءَاتُوا۟ ٱلزَّكَوٰةَ وَٱعْتَصِمُوا۟",133],["23:2:4",342,"صَلَاتِهِمْ","their prayers","ٱلَّذِينَ هُمْ فِى","خَـٰشِعُونَ",133],["23:9:4",342,"صَلَوَٰتِهِمْ","their prayers","وَٱلَّذِينَ هُمْ عَلَىٰ","يُحَافِظُونَ",133],["24:37:11",355,"ٱلصَّلَوٰةِ","the prayer","ذِكْرِ ٱللَّهِ وَإِقَامِ","وَإِيتَآءِ ٱلزَّكَوٰةِ ۙ يَخَافُونَ",133],["24:41:16",355,"صَلَاتَهُۥ","its prayer","كُلٌّۭ قَدْ عَلِمَ","وَتَسْبِيحَهُۥ ۗ وَٱللَّهُ عَلِيمٌۢ",133],["24:56:2",357,"ٱلصَّلَوٰةَ","the prayer","وَأَقِيمُوا۟","وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَطِيعُوا۟",133],["24:58:17",357,"صَلَوٰةِ","(the) prayer","مَرَّٰتٍۢ ۚ مِّن قَبْلِ","ٱلْفَجْرِ وَحِينَ تَضَعُونَ",133],["24:58:26",357,"صَلَوٰةِ","(the) prayer","ٱلظَّهِيرَةِ وَمِنۢ بَعْدِ","ٱلْعِشَآءِ ۚ ثَلَـٰثُ عَوْرَٰتٍۢ",133],["27:3:3",377,"ٱلصَّلَوٰةَ","the prayer","ٱلَّذِينَ يُقِيمُونَ","وَيُؤْتُونَ ٱلزَّكَوٰةَ وَهُم",133],["29:45:8",401,"ٱلصَّلَوٰةَ ۖ","the prayer","مِنَ ٱلْكِتَـٰبِ وَأَقِمِ","إِنَّ ٱلصَّلَوٰةَ تَنْهَىٰ",133],["29:45:10",401,"ٱلصَّلَوٰةَ","the prayer","وَأَقِمِ ٱلصَّلَوٰةَ ۖ إِنَّ","تَنْهَىٰ عَنِ ٱلْفَحْشَآءِ",133],["30:31:5",407,"ٱلصَّلَوٰةَ","the prayer","إِلَيْهِ وَٱتَّقُوهُ وَأَقِيمُوا۟","وَلَا تَكُونُوا۟ مِنَ",133],["31:4:3",411,"ٱلصَّلَوٰةَ","the prayer","ٱلَّذِينَ يُقِيمُونَ","وَيُؤْتُونَ ٱلزَّكَوٰةَ وَهُم",133],["31:17:3",412,"ٱلصَّلَوٰةَ","the prayer","يَـٰبُنَىَّ أَقِمِ","وَأْمُرْ بِٱلْمَعْرُوفِ وَٱنْهَ",133],["33:33:10",422,"ٱلصَّلَوٰةَ","the prayer","ٱلْجَـٰهِلِيَّةِ ٱلْأُولَىٰ ۖ وَأَقِمْنَ","وَءَاتِينَ ٱلزَّكَوٰةَ وَأَطِعْنَ",133],["33:43:3",423,"يُصَلِّى","sends His blessings","هُوَ ٱلَّذِى","عَلَيْكُمْ وَمَلَـٰٓئِكَتُهُۥ لِيُخْرِجَكُم",723],["33:56:4",426,"يُصَلُّونَ","send blessings","إِنَّ ٱللَّهَ وَمَلَـٰٓئِكَتَهُۥ","عَلَى ٱلنَّبِىِّ ۚ يَـٰٓأَيُّهَا",723],["33:56:10",426,"صَلُّوا۟","Send blessings","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","عَلَيْهِ وَسَلِّمُوا۟ تَسْلِيمًا",723],["35:18:26",436,"ٱلصَّلَوٰةَ ۚ","the prayer","رَبَّهُم بِٱلْغَيْبِ وَأَقَامُوا۟","وَمَن تَزَكَّىٰ فَإِنَّمَا",133],["35:29:7",437,"ٱلصَّلَوٰةَ","the prayer","كِتَـٰبَ ٱللَّهِ وَأَقَامُوا۟","وَأَنفَقُوا۟ مِمَّا رَزَقْنَـٰهُمْ",133],["42:38:5",487,"ٱلصَّلَوٰةَ","prayer","ٱسْتَجَابُوا۟ لِرَبِّهِمْ وَأَقَامُوا۟","وَأَمْرُهُمْ شُورَىٰ بَيْنَهُمْ",133],["58:13:15",544,"ٱلصَّلَوٰةَ","the prayer","ٱللَّهُ عَلَيْكُمْ فَأَقِيمُوا۟","وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَطِيعُوا۟",133],["62:9:6",554,"لِلصَّلَوٰةِ","for (the) prayer","ءَامَنُوٓا۟ إِذَا نُودِىَ","مِن يَوْمِ ٱلْجُمُعَةِ",133],["62:10:3",554,"ٱلصَّلَوٰةُ","the prayer","فَإِذَا قُضِيَتِ","فَٱنتَشِرُوا۟ فِى ٱلْأَرْضِ",133],["70:22:2",569,"ٱلْمُصَلِّينَ","those who pray","إِلَّا","",1903],["70:23:4",569,"صَلَاتِهِمْ","their prayer","ٱلَّذِينَ هُمْ عَلَىٰ","دَآئِمُونَ",133],["70:34:4",569,"صَلَاتِهِمْ","their prayer","وَٱلَّذِينَ هُمْ عَلَىٰ","يُحَافِظُونَ",133],["73:20:54",575,"ٱلصَّلَوٰةَ","the prayer","تَيَسَّرَ مِنْهُ ۚ وَأَقِيمُوا۟","وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَقْرِضُوا۟",133],["74:43:5",576,"ٱلْمُصَلِّينَ","those who prayed","لَمْ نَكُ مِنَ","",1903],["75:31:4",578,"صَلَّىٰ","he prayed","فَلَا صَدَّقَ وَلَا","",723],["87:15:4",592,"فَصَلَّىٰ","and prays","وَذَكَرَ ٱسْمَ رَبِّهِۦ","",723],["96:10:3",597,"صَلَّىٰٓ","he prays","عَبْدًا إِذَا","",723],["98:5:11",598,"ٱلصَّلَوٰةَ","the prayer","ٱلدِّينَ حُنَفَآءَ وَيُقِيمُوا۟","وَيُؤْتُوا۟ ٱلزَّكَوٰةَ ۚ وَذَٰلِكَ",133],["107:4:2",602,"لِّلْمُصَلِّينَ","to those who pray","فَوَيْلٌۭ","",1903],["107:5:4",602,"صَلَاتِهِمْ","their prayers","ٱلَّذِينَ هُمْ عَن","سَاهُونَ",133],["108:2:1",602,"فَصَلِّ","So pray","","لِرَبِّكَ وَٱنْحَرْ",723]]