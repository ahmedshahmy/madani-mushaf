[["9:90:4",201,"ٱلْأَعْرَابِ","the bedouins","وَجَآءَ ٱلْمُعَذِّرُونَ مِنَ","لِيُؤْذَنَ لَهُمْ وَقَعَدَ",813],["9:97:1",202,"ٱلْأَعْرَابُ","The bedouins","","أَشَدُّ كُفْرًۭا وَنِفَاقًۭا",813],["9:98:2",202,"ٱلْأَعْرَابِ","the bedouins","وَمِنَ","مَن يَتَّخِذُ مَا",813],["9:99:2",202,"ٱلْأَعْرَابِ","the bedouins","وَمِنَ","مَن يُؤْمِنُ بِٱللَّهِ",813],["9:101:4",203,"ٱلْأَعْرَابِ","the bedouins","وَمِمَّنْ حَوْلَكُم مِّنَ","مُنَـٰفِقُونَ ۖ وَمِنْ أَهْلِ",813],["9:120:8",206,"ٱلْأَعْرَابِ","the bedouins","وَمَنْ حَوْلَهُم مِّنَ","أَن يَتَخَلَّفُوا۟ عَن",813],["12:2:4",235,"عَرَبِيًّۭا","(as) a Quran in Arabic","إِنَّآ أَنزَلْنَـٰهُ قُرْءَٰنًا","لَّعَلَّكُمْ تَعْقِلُونَ",771],["13:37:4",254,"عَرَبِيًّۭا ۚ","(in) Arabic","وَكَذَٰلِكَ أَنزَلْنَـٰهُ حُكْمًا","وَلَئِنِ ٱتَّبَعْتَ أَهْوَآءَهُم",771],["16:103:15",279,"عَرَبِىٌّۭ","Arabic","أَعْجَمِىٌّۭ وَهَـٰذَا لِسَانٌ","مُّبِينٌ",771],["20:113:4",319,"عَرَبِيًّۭا","(in) Arabic","وَكَذَٰلِكَ أَنزَلْنَـٰهُ قُرْءَانًا","وَصَرَّفْنَا فِيهِ مِنَ",771],["26:195:2",375,"عَرَبِىٍّۢ","Arabic","بِلِسَانٍ","مُّبِينٍۢ",771],["33:20:13",420,"ٱلْأَعْرَابِ","the Bedouins","أَنَّهُم بَادُونَ فِى","يَسْـَٔلُونَ عَنْ أَنۢبَآئِكُمْ ۖ",813],["39:28:2",461,"عَرَبِيًّا","(in) Arabic","قُرْءَانًا","غَيْرَ ذِى عِوَجٍۢ",771],["41:3:5",477,"عَرَبِيًّۭا","(in) Arabic","فُصِّلَتْ ءَايَـٰتُهُۥ قُرْءَانًا","لِّقَوْمٍۢ يَعْلَمُونَ",771],["41:44:10",481,"وَعَرَبِىٌّۭ ۗ","and an Arab","فُصِّلَتْ ءَايَـٰتُهُۥٓ ۖ ءَا۬عْجَمِىٌّۭ","قُلْ هُوَ لِلَّذِينَ",771],["42:7:5",483,"عَرَبِيًّۭا","(in) Arabic","أَوْحَيْنَآ إِلَيْكَ قُرْءَانًا","لِّتُنذِرَ أُمَّ ٱلْقُرَىٰ",771],["43:3:4",489,"عَرَبِيًّۭا","(in) Arabic","إِنَّا جَعَلْنَـٰهُ قُرْءَٰنًا","لَّعَلَّكُمْ تَعْقِلُونَ",771],["46:12:11",503,"عَرَبِيًّۭا","Arabic","كِتَـٰبٌۭ مُّصَدِّقٌۭ لِّسَانًا","لِّيُنذِرَ ٱلَّذِينَ ظَلَمُوا۟",771],["48:11:5",512,"ٱلْأَعْرَابِ","the Bedouins","لَكَ ٱلْمُخَلَّفُونَ مِنَ","شَغَلَتْنَآ أَمْوَٰلُنَا وَأَهْلُونَا",813],["48:16:4",513,"ٱلْأَعْرَابِ","the Bedouins","قُل لِّلْمُخَلَّفِينَ مِنَ","سَتُدْعَوْنَ إِلَىٰ قَوْمٍ",813],["49:14:2",517,"ٱلْأَعْرَابُ","the Bedouins","۞ قَالَتِ","ءَامَنَّا ۖ قُل لَّمْ",813],["56:37:1",535,"عُرُبًا","Devoted","","أَتْرَابًۭا",3154]]