[["2:212:1",33,"زُيِّنَ","Beautified","","لِلَّذِينَ كَفَرُوا۟ ٱلْحَيَوٰةُ",419],["3:14:1",51,"زُيِّنَ","Beautified","","لِلنَّاسِ حُبُّ ٱلشَّهَوَٰتِ",419],["6:43:9",132,"وَزَيَّنَ","and made fair-seeming","وَلَـٰكِن قَسَتْ قُلُوبُهُمْ","لَهُمُ ٱلشَّيْطَـٰنُ مَا",419],["6:108:14",141,"زَيَّنَّا","We have made fair-seeming","بِغَيْرِ عِلْمٍۢ ۗ كَذَٰلِكَ","لِكُلِّ أُمَّةٍ عَمَلَهُمْ",419],["6:122:20",143,"زُيِّنَ","is made fair-seeming","بِخَارِجٍۢ مِّنْهَا ۚ كَذَٰلِكَ","لِلْكَـٰفِرِينَ مَا كَانُوا۟",419],["6:137:2",145,"زَيَّنَ","made pleasing","وَكَذَٰلِكَ","لِكَثِيرٍۢ مِّنَ ٱلْمُشْرِكِينَ",419],["7:31:4",154,"زِينَتَكُمْ","your adornment","۞ يَـٰبَنِىٓ ءَادَمَ خُذُوا۟","عِندَ كُلِّ مَسْجِدٍۢ",534],["7:32:4",154,"زِينَةَ","(the) adornment","قُلْ مَنْ حَرَّمَ","ٱللَّهِ ٱلَّتِىٓ أَخْرَجَ",534],["8:48:2",183,"زَيَّنَ","made fair-seeming","وَإِذْ","لَهُمُ ٱلشَّيْطَـٰنُ أَعْمَـٰلَهُمْ",419],["9:37:23",193,"زُيِّنَ","Is made fair-seeming","مَا حَرَّمَ ٱللَّهُ ۚ","لَهُمْ سُوٓءُ أَعْمَـٰلِهِمْ ۗ",419],["10:12:23",209,"زُيِّنَ","(it) is made fair seeming","ضُرٍّۢ مَّسَّهُۥ ۚ كَذَٰلِكَ","لِلْمُسْرِفِينَ مَا كَانُوا۟",419],["10:24:22",211,"وَٱزَّيَّنَتْ","and is beautified","أَخَذَتِ ٱلْأَرْضُ زُخْرُفَهَا","وَظَنَّ أَهْلُهَآ أَنَّهُمْ",4851],["10:88:8",218,"زِينَةًۭ","splendor","ءَاتَيْتَ فِرْعَوْنَ وَمَلَأَهُۥ","وَأَمْوَٰلًۭا فِى ٱلْحَيَوٰةِ",534],["11:15:6",223,"وَزِينَتَهَا","and its adornments","يُرِيدُ ٱلْحَيَوٰةَ ٱلدُّنْيَا","نُوَفِّ إِلَيْهِمْ أَعْمَـٰلَهُمْ",534],["13:33:26",253,"زُيِّنَ","(is) made fair-seeming","مِّنَ ٱلْقَوْلِ ۗ بَلْ","لِلَّذِينَ كَفَرُوا۟ مَكْرُهُمْ",419],["15:16:6",263,"وَزَيَّنَّـٰهَا","and We have beautified it","فِى ٱلسَّمَآءِ بُرُوجًۭا","لِلنَّـٰظِرِينَ",419],["15:39:5",264,"لَأُزَيِّنَنَّ","surely, I will make (evil) fair-seeming","رَبِّ بِمَآ أَغْوَيْتَنِى","لَهُمْ فِى ٱلْأَرْضِ",419],["16:8:5",268,"وَزِينَةًۭ ۚ","and (as) adornment","وَٱلْبِغَالَ وَٱلْحَمِيرَ لِتَرْكَبُوهَا","وَيَخْلُقُ مَا لَا",534],["16:63:8",273,"فَزَيَّنَ","but made fair-seeming","أُمَمٍۢ مِّن قَبْلِكَ","لَهُمُ ٱلشَّيْطَـٰنُ أَعْمَـٰلَهُمْ",419],["18:7:6",294,"زِينَةًۭ","adornment","مَا عَلَى ٱلْأَرْضِ","لَّهَا لِنَبْلُوَهُمْ أَيُّهُمْ",534],["18:28:16",297,"زِينَةَ","adornment","عَيْنَاكَ عَنْهُمْ تُرِيدُ","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ وَلَا",534],["18:46:3",299,"زِينَةُ","(are) adornment","ٱلْمَالُ وَٱلْبَنُونَ","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ وَٱلْبَـٰقِيَـٰتُ",534],["20:59:4",315,"ٱلزِّينَةِ","(of) the festival","قَالَ مَوْعِدُكُمْ يَوْمُ","وَأَن يُحْشَرَ ٱلنَّاسُ",534],["20:87:10",317,"زِينَةِ","ornaments","حُمِّلْنَآ أَوْزَارًۭا مِّن","ٱلْقَوْمِ فَقَذَفْنَـٰهَا فَكَذَٰلِكَ",534],["24:31:10",353,"زِينَتَهُنَّ","their adornment","فُرُوجَهُنَّ وَلَا يُبْدِينَ","إِلَّا مَا ظَهَرَ",534],["24:31:21",353,"زِينَتَهُنَّ","their adornment","جُيُوبِهِنَّ ۖ وَلَا يُبْدِينَ","إِلَّا لِبُعُولَتِهِنَّ أَوْ",534],["24:31:70",353,"زِينَتِهِنَّ ۚ","their adornment","مَا يُخْفِينَ مِن","وَتُوبُوٓا۟ إِلَى ٱللَّهِ",534],["24:60:16",358,"بِزِينَةٍۢ ۖ","their adornment","ثِيَابَهُنَّ غَيْرَ مُتَبَرِّجَـٰتٍۭ","وَأَن يَسْتَعْفِفْنَ خَيْرٌۭ",534],["27:4:6",377,"زَيَّنَّا","We have made fair-seeming","لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ","لَهُمْ أَعْمَـٰلَهُمْ فَهُمْ",419],["27:24:8",379,"وَزَيَّنَ","and has made fair-seeming","مِن دُونِ ٱللَّهِ","لَهُمُ ٱلشَّيْطَـٰنُ أَعْمَـٰلَهُمْ",419],["28:60:8",393,"وَزِينَتُهَا ۚ","and its adornment","فَمَتَـٰعُ ٱلْحَيَوٰةِ ٱلدُّنْيَا","وَمَا عِندَ ٱللَّهِ",534],["28:79:5",395,"زِينَتِهِۦ ۖ","his adornment","عَلَىٰ قَوْمِهِۦ فِى","قَالَ ٱلَّذِينَ يُرِيدُونَ",534],["29:38:8",400,"وَزَيَّنَ","And made fair-seeming","لَكُم مِّن مَّسَـٰكِنِهِمْ ۖ","لَهُمُ ٱلشَّيْطَـٰنُ أَعْمَـٰلَهُمْ",419],["33:28:10",421,"وَزِينَتَهَا","and its adornment","تُرِدْنَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","فَتَعَالَيْنَ أُمَتِّعْكُنَّ وَأُسَرِّحْكُنَّ",534],["35:8:2",435,"زُيِّنَ","is made fair-seeming","أَفَمَن","لَهُۥ سُوٓءُ عَمَلِهِۦ",419],["37:6:2",446,"زَيَّنَّا","[We] adorned","إِنَّا","ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ",419],["37:6:5",446,"بِزِينَةٍ","with an adornment","زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا","ٱلْكَوَاكِبِ",534],["40:37:11",471,"زُيِّنَ","was made fair-seeming","لَأَظُنُّهُۥ كَـٰذِبًۭا ۚ وَكَذَٰلِكَ","لِفِرْعَوْنَ سُوٓءُ عَمَلِهِۦ",419],["41:12:11",478,"وَزَيَّنَّا","And We adorned","كُلِّ سَمَآءٍ أَمْرَهَا ۚ","ٱلسَّمَآءَ ٱلدُّنْيَا بِمَصَـٰبِيحَ",419],["41:25:4",479,"فَزَيَّنُوا۟","(who) made fair-seeming","۞ وَقَيَّضْنَا لَهُمْ قُرَنَآءَ","لَهُم مَّا بَيْنَ",419],["47:14:8",508,"زُيِّنَ","is made attractive","مِّن رَّبِّهِۦ كَمَن","لَهُۥ سُوٓءُ عَمَلِهِۦ",419],["48:12:11",512,"وَزُيِّنَ","that was made fair-seeming","إِلَىٰٓ أَهْلِيهِمْ أَبَدًۭا","ذَٰلِكَ فِى قُلُوبِكُمْ",419],["49:7:18",516,"وَزَيَّنَهُۥ","and has made it pleasing","حَبَّبَ إِلَيْكُمُ ٱلْإِيمَـٰنَ","فِى قُلُوبِكُمْ وَكَرَّهَ",419],["50:6:8",518,"وَزَيَّنَّـٰهَا","and adorned it","فَوْقَهُمْ كَيْفَ بَنَيْنَـٰهَا","وَمَا لَهَا مِن",419],["57:20:7",540,"وَزِينَةٌۭ","and adornment","ٱلدُّنْيَا لَعِبٌۭ وَلَهْوٌۭ","وَتَفَاخُرٌۢ بَيْنَكُمْ وَتَكَاثُرٌۭ",534],["67:5:2",562,"زَيَّنَّا","We have beautified","وَلَقَدْ","ٱلسَّمَآءَ ٱلدُّنْيَا بِمَصَـٰبِيحَ",419]]