[["2:279:5",47,"بِحَرْبٍۢ","of a war","لَّمْ تَفْعَلُوا۟ فَأْذَنُوا۟","مِّنَ ٱللَّهِ وَرَسُولِهِۦ ۖ",1511],["3:37:14",54,"ٱلْمِحْرَابَ","[the] prayer chamber","دَخَلَ عَلَيْهَا زَكَرِيَّا","وَجَدَ عِندَهَا رِزْقًۭا ۖ",1583],["3:39:7",55,"ٱلْمِحْرَابِ","the prayer chamber","قَآئِمٌۭ يُصَلِّى فِى","أَنَّ ٱللَّهَ يُبَشِّرُكَ",1583],["5:33:4",113,"يُحَارِبُونَ","wage war","إِنَّمَا جَزَٰٓؤُا۟ ٱلَّذِينَ","ٱللَّهَ وَرَسُولَهُۥ وَيَسْعَوْنَ",2268],["5:64:37",118,"لِّلْحَرْبِ","of [the] war","كُلَّمَآ أَوْقَدُوا۟ نَارًۭا","أَطْفَأَهَا ٱللَّهُ ۚ وَيَسْعَوْنَ",1511],["8:57:4",184,"ٱلْحَرْبِ","the war","فَإِمَّا تَثْقَفَنَّهُمْ فِى","فَشَرِّدْ بِهِم مَّنْ",1511],["9:107:11",204,"حَارَبَ","warred","ٱلْمُؤْمِنِينَ وَإِرْصَادًۭا لِّمَنْ","ٱللَّهَ وَرَسُولَهُۥ مِن",2268],["19:11:5",305,"ٱلْمِحْرَابِ","the prayer chamber","عَلَىٰ قَوْمِهِۦ مِنَ","فَأَوْحَىٰٓ إِلَيْهِمْ أَن",1583],["34:13:6",429,"مَّحَـٰرِيبَ","elevated chambers","مَا يَشَآءُ مِن","وَتَمَـٰثِيلَ وَجِفَانٍۢ كَٱلْجَوَابِ",3911],["38:21:7",454,"ٱلْمِحْرَابَ","(of) the chamber","ٱلْخَصْمِ إِذْ تَسَوَّرُوا۟","",1583],["47:4:19",507,"ٱلْحَرْبُ","the war","فِدَآءً حَتَّىٰ تَضَعَ","أَوْزَارَهَا ۚ ذَٰلِكَ وَلَوْ",1511]]