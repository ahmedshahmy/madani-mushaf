[["2:250:10",41,"وَثَبِّتْ","and make firm","أَفْرِغْ عَلَيْنَا صَبْرًۭا","أَقْدَامَنَا وَٱنصُرْنَا عَلَى",862],["2:265:8",45,"وَتَثْبِيتًۭا","and certainty","ٱبْتِغَآءَ مَرْضَاتِ ٱللَّهِ","مِّنْ أَنفُسِهِمْ كَمَثَلِ",2684],["3:147:14",68,"وَثَبِّتْ","and make firm","وَإِسْرَافَنَا فِىٓ أَمْرِنَا","أَقْدَامَنَا وَٱنصُرْنَا عَلَى",862],["4:66:27",89,"تَثْبِيتًۭا","strengthen(ing)","خَيْرًۭا لَّهُمْ وَأَشَدَّ","",2684],["8:11:20",178,"وَيُثَبِّتَ","and make firm","وَلِيَرْبِطَ عَلَىٰ قُلُوبِكُمْ","بِهِ ٱلْأَقْدَامَ",862],["8:12:8",178,"فَثَبِّتُوا۟","so strengthen","ٱلْمَلَـٰٓئِكَةِ أَنِّى مَعَكُمْ","ٱلَّذِينَ ءَامَنُوا۟ ۚ سَأُلْقِى",862],["8:30:6",180,"لِيُثْبِتُوكَ","that they restrain you","بِكَ ٱلَّذِينَ كَفَرُوا۟","أَوْ يَقْتُلُوكَ أَوْ",2815],["8:45:7",182,"فَٱثْبُتُوا۟","then be firm","إِذَا لَقِيتُمْ فِئَةًۭ","وَٱذْكُرُوا۟ ٱللَّهَ كَثِيرًۭا",4845],["11:120:8",235,"نُثَبِّتُ","We may make firm","أَنۢبَآءِ ٱلرُّسُلِ مَا","بِهِۦ فُؤَادَكَ ۚ وَجَآءَكَ",862],["13:39:5",254,"وَيُثْبِتُ ۖ","and confirms","ٱللَّهُ مَا يَشَآءُ","وَعِندَهُۥٓ أُمُّ ٱلْكِتَـٰبِ",2815],["14:24:12",258,"ثَابِتٌۭ","(is) firm","كَشَجَرَةٍۢ طَيِّبَةٍ أَصْلُهَا","وَفَرْعُهَا فِى ٱلسَّمَآءِ",2698],["14:27:1",259,"يُثَبِّتُ","Allah keeps firm","","ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟",862],["14:27:6",259,"ٱلثَّابِتِ","with the firm word","ٱلَّذِينَ ءَامَنُوا۟ بِٱلْقَوْلِ","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا",2698],["16:94:9",278,"ثُبُوتِهَا","it is firmly planted","فَتَزِلَّ قَدَمٌۢ بَعْدَ","وَتَذُوقُوا۟ ٱلسُّوٓءَ بِمَا",4501],["16:102:8",278,"لِيُثَبِّتَ","to make firm","مِن رَّبِّكَ بِٱلْحَقِّ","ٱلَّذِينَ ءَامَنُوا۟ وَهُدًۭى",862],["17:74:3",289,"ثَبَّتْنَـٰكَ","We (had) strengthened you","وَلَوْلَآ أَن","لَقَدْ كِدتَّ تَرْكَنُ",862],["25:32:11",362,"لِنُثَبِّتَ","that We may strengthen","جُمْلَةًۭ وَٰحِدَةًۭ ۚ كَذَٰلِكَ","بِهِۦ فُؤَادَكَ ۖ وَرَتَّلْنَـٰهُ",862],["47:7:8",507,"وَيُثَبِّتْ","and make firm","تَنصُرُوا۟ ٱللَّهَ يَنصُرْكُمْ","أَقْدَامَكُمْ",862]]