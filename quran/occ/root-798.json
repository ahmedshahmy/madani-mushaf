[["8:38:14",181,"مَضَتْ","preceded","وَإِن يَعُودُوا۟ فَقَدْ","سُنَّتُ ٱلْأَوَّلِينَ",1573],["15:65:12",265,"وَٱمْضُوا۟","and go on","يَلْتَفِتْ مِنكُمْ أَحَدٌۭ","حَيْثُ تُؤْمَرُونَ",1573],["18:60:12",300,"أَمْضِىَ","I continue","مَجْمَعَ ٱلْبَحْرَيْنِ أَوْ","حُقُبًۭا",1573],["36:67:8",444,"مُضِيًّۭا","to proceed","مَكَانَتِهِمْ فَمَا ٱسْتَطَـٰعُوا۟","وَلَا يَرْجِعُونَ",3754],["43:8:5",489,"وَمَضَىٰ","and has passed","أَشَدَّ مِنْهُم بَطْشًۭا","مَثَلُ ٱلْأَوَّلِينَ",1573]]