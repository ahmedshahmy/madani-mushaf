[["3:103:26",63,"فَأَنقَذَكُم","then He saved you","حُفْرَةٍۢ مِّنَ ٱلنَّارِ","مِّنْهَا ۗ كَذَٰلِكَ يُبَيِّنُ",1477],["22:73:24",341,"يَسْتَنقِذُوهُ","they (could) take it back","ٱلذُّبَابُ شَيْـًۭٔا لَّا","مِنْهُ ۚ ضَعُفَ ٱلطَّالِبُ",4665],["36:23:15",441,"يُنقِذُونِ","they (can) save me","شَفَـٰعَتُهُمْ شَيْـًۭٔا وَلَا","",1477],["36:43:9",443,"يُنقَذُونَ","would be saved","لَهُمْ وَلَا هُمْ","",1477],["39:19:7",460,"تُنقِذُ","save","كَلِمَةُ ٱلْعَذَابِ أَفَأَنتَ","مَن فِى ٱلنَّارِ",1477]]