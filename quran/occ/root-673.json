[["7:143:29",167,"دَكًّۭا","crumbled to dust","رَبُّهُۥ لِلْجَبَلِ جَعَلَهُۥ","وَخَرَّ مُوسَىٰ صَعِقًۭا ۚ",1821],["18:98:11",304,"دَكَّآءَ ۖ","level","وَعْدُ رَبِّى جَعَلَهُۥ","وَكَانَ وَعْدُ رَبِّى",3371],["69:14:4",567,"فَدُكَّتَا","and crushed","وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ","دَكَّةًۭ وَٰحِدَةًۭ",2356],["69:14:5",567,"دَكَّةًۭ","(with) a crushing","ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا","وَٰحِدَةًۭ",3372],["89:21:3",593,"دُكَّتِ","is leveled","كَلَّآ إِذَا","ٱلْأَرْضُ دَكًّۭا دَكًّۭا",2356],["89:21:5",593,"دَكًّۭا","pounded","إِذَا دُكَّتِ ٱلْأَرْضُ","دَكًّۭا",1821],["89:21:6",593,"دَكًّۭا","(and) crushed","دُكَّتِ ٱلْأَرْضُ دَكًّۭا","",1821]]