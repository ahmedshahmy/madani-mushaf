[["14:22:30",258,"بِمُصْرِخِكُمْ","(be) your helper","أَنفُسَكُم ۖ مَّآ أَنَا۠","وَمَآ أَنتُم بِمُصْرِخِىَّ ۖ",2485],["14:22:33",258,"بِمُصْرِخِىَّ ۖ","(be) my helper","بِمُصْرِخِكُمْ وَمَآ أَنتُم","إِنِّى كَفَرْتُ بِمَآ",2485],["28:18:10",387,"يَسْتَصْرِخُهُۥ ۚ","cried out to him for help","ٱلَّذِى ٱسْتَنصَرَهُۥ بِٱلْأَمْسِ","قَالَ لَهُۥ مُوسَىٰٓ",4661],["35:37:2",438,"يَصْطَرِخُونَ","will cry","وَهُمْ","فِيهَا رَبَّنَآ أَخْرِجْنَا",4614],["36:43:5",443,"صَرِيخَ","(would be) a responder to a cry","نَّشَأْ نُغْرِقْهُمْ فَلَا","لَهُمْ وَلَا هُمْ",3250]]