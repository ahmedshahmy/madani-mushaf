[["3:119:19",65,"ٱلْغَيْظِ ۚ","[the] rage","عَلَيْكُمُ ٱلْأَنَامِلَ مِنَ","قُلْ مُوتُوا۟ بِغَيْظِكُمْ ۗ",1184],["3:119:22",65,"بِغَيْظِكُمْ ۗ","in your rage","ٱلْغَيْظِ ۚ قُلْ مُوتُوا۟","إِنَّ ٱللَّهَ عَلِيمٌۢ",1184],["3:134:7",67,"ٱلْغَيْظَ","the anger","ٱلسَّرَّآءِ وَٱلضَّرَّآءِ وَٱلْكَـٰظِمِينَ","وَٱلْعَافِينَ عَنِ ٱلنَّاسِ ۗ",1184],["9:15:2",189,"غَيْظَ","(the) anger","وَيُذْهِبْ","قُلُوبِهِمْ ۗ وَيَتُوبُ ٱللَّهُ",1184],["9:120:34",206,"يَغِيظُ","that angers","وَلَا يَطَـُٔونَ مَوْطِئًۭا","ٱلْكُفَّارَ وَلَا يَنَالُونَ",2054],["22:15:22",333,"يَغِيظُ","enrages","يُذْهِبَنَّ كَيْدُهُۥ مَا","",2054],["25:12:8",361,"تَغَيُّظًۭا","raging","بَعِيدٍۢ سَمِعُوا۟ لَهَا","وَزَفِيرًۭا",4375],["26:55:3",369,"لَغَآئِظُونَ","(are) surely enraging","وَإِنَّهُمْ لَنَا","",3448],["33:25:5",421,"بِغَيْظِهِمْ","in their rage","ٱللَّهُ ٱلَّذِينَ كَفَرُوا۟","لَمْ يَنَالُوا۟ خَيْرًۭا ۚ",1184],["48:29:42",515,"لِيَغِيظَ","that He (may) enrage","سُوقِهِۦ يُعْجِبُ ٱلزُّرَّاعَ","بِهِمُ ٱلْكُفَّارَ ۗ وَعَدَ",2054],["67:8:4",562,"ٱلْغَيْظِ ۖ","rage","تَكَادُ تَمَيَّزُ مِنَ","كُلَّمَآ أُلْقِىَ فِيهَا",1184]]