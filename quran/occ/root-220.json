[["3:111:8",64,"ٱلْأَدْبَارَ","the backs","وَإِن يُقَـٰتِلُوكُمْ يُوَلُّوكُمُ","ثُمَّ لَا يُنصَرُونَ",549],["4:47:18",86,"أَدْبَارِهَآ","their backs","وُجُوهًۭا فَنَرُدَّهَا عَلَىٰٓ","أَوْ نَلْعَنَهُمْ كَمَا",549],["4:82:2",91,"يَتَدَبَّرُونَ","they ponder","أَفَلَا","ٱلْقُرْءَانَ ۚ وَلَوْ كَانَ",1675],["5:21:12",111,"أَدْبَارِكُمْ","your backs","وَلَا تَرْتَدُّوا۟ عَلَىٰٓ","فَتَنقَلِبُوا۟ خَـٰسِرِينَ",549],["6:45:2",133,"دَابِرُ","(the) remnant","فَقُطِعَ","ٱلْقَوْمِ ٱلَّذِينَ ظَلَمُوا۟ ۚ",1542],["7:72:7",159,"دَابِرَ","the roots","بِرَحْمَةٍۢ مِّنَّا وَقَطَعْنَا","ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا ۖ",1542],["8:7:22",177,"دَابِرَ","(the) roots","ٱلْحَقَّ بِكَلِمَـٰتِهِۦ وَيَقْطَعَ","ٱلْكَـٰفِرِينَ",1542],["8:15:11",178,"ٱلْأَدْبَارَ","the backs","زَحْفًۭا فَلَا تُوَلُّوهُمُ","",549],["8:16:4",178,"دُبُرَهُۥٓ","his back","وَمَن يُوَلِّهِمْ يَوْمَئِذٍۢ","إِلَّا مُتَحَرِّفًۭا لِّقِتَالٍ",549],["8:50:10",183,"وَأَدْبَـٰرَهُمْ","and their backs","ٱلْمَلَـٰٓئِكَةُ يَضْرِبُونَ وُجُوهَهُمْ","وَذُوقُوا۟ عَذَابَ ٱلْحَرِيقِ",549],["9:25:23",190,"مُّدْبِرِينَ","fleeing","رَحُبَتْ ثُمَّ وَلَّيْتُم","",989],["10:3:15",208,"يُدَبِّرُ","disposing","ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ ۖ","ٱلْأَمْرَ ۖ مَا مِن",1684],["10:31:21",212,"يُدَبِّرُ","disposes","مِنَ ٱلْحَىِّ وَمَن","ٱلْأَمْرَ ۚ فَسَيَقُولُونَ ٱللَّهُ ۚ",1684],["12:25:6",238,"دُبُرٍۢ","the back","وَقَدَّتْ قَمِيصَهُۥ مِن","وَأَلْفَيَا سَيِّدَهَا لَدَا",549],["12:27:6",238,"دُبُرٍۢ","(the) back","قَمِيصُهُۥ قُدَّ مِن","فَكَذَبَتْ وَهُوَ مِنَ",549],["12:28:6",238,"دُبُرٍۢ","(the) back","قَمِيصَهُۥ قُدَّ مِن","قَالَ إِنَّهُۥ مِن",549],["13:2:19",249,"يُدَبِّرُ","He arranges","يَجْرِى لِأَجَلٍۢ مُّسَمًّۭى ۚ","ٱلْأَمْرَ يُفَصِّلُ ٱلْـَٔايَـٰتِ",1684],["15:65:7",265,"أَدْبَـٰرَهُمْ","their backs","مِّنَ ٱلَّيْلِ وَٱتَّبِعْ","وَلَا يَلْتَفِتْ مِنكُمْ",549],["15:66:6",265,"دَابِرَ","(the) root","ذَٰلِكَ ٱلْأَمْرَ أَنَّ","هَـٰٓؤُلَآءِ مَقْطُوعٌۭ مُّصْبِحِينَ",1542],["17:46:18",286,"أَدْبَـٰرِهِمْ","their backs","وَحْدَهُۥ وَلَّوْا۟ عَلَىٰٓ","نُفُورًۭا",549],["21:57:7",326,"مُدْبِرِينَ","turning (your) backs","بَعْدَ أَن تُوَلُّوا۟","",989],["23:68:2",346,"يَدَّبَّرُوا۟","they ponder","أَفَلَمْ","ٱلْقَوْلَ أَمْ جَآءَهُم",1675],["27:10:9",377,"مُدْبِرًۭا","(in) flight","كَأَنَّهَا جَآنٌّۭ وَلَّىٰ","وَلَمْ يُعَقِّبْ ۚ يَـٰمُوسَىٰ",989],["27:80:11",384,"مُدْبِرِينَ","retreating","ٱلدُّعَآءَ إِذَا وَلَّوْا۟","",989],["28:31:10",389,"مُدْبِرًۭا","(in) flight","كَأَنَّهَا جَآنٌّۭ وَلَّىٰ","وَلَمْ يُعَقِّبْ ۚ يَـٰمُوسَىٰٓ",989],["30:52:11",410,"مُدْبِرِينَ","retreating","ٱلدُّعَآءَ إِذَا وَلَّوْا۟","",989],["32:5:1",415,"يُدَبِّرُ","He regulates","","ٱلْأَمْرَ مِنَ ٱلسَّمَآءِ",1684],["33:15:9",419,"ٱلْأَدْبَـٰرَ ۚ","their backs","قَبْلُ لَا يُوَلُّونَ","وَكَانَ عَهْدُ ٱللَّهِ",549],["37:90:3",449,"مُدْبِرِينَ","departing","فَتَوَلَّوْا۟ عَنْهُ","",989],["38:29:5",455,"لِّيَدَّبَّرُوٓا۟","that they may ponder","أَنزَلْنَـٰهُ إِلَيْكَ مُبَـٰرَكٌۭ","ءَايَـٰتِهِۦ وَلِيَتَذَكَّرَ أُو۟لُوا۟",1675],["40:33:3",470,"مُدْبِرِينَ","fleeing","يَوْمَ تُوَلُّونَ","مَا لَكُم مِّنَ",989],["47:24:2",509,"يَتَدَبَّرُونَ","they ponder","أَفَلَا","ٱلْقُرْءَانَ أَمْ عَلَىٰ",1675],["47:25:5",509,"أَدْبَـٰرِهِم","their backs","ٱلَّذِينَ ٱرْتَدُّوا۟ عَلَىٰٓ","مِّنۢ بَعْدِ مَا",549],["47:27:7",509,"وَأَدْبَـٰرَهُمْ","and their backs","ٱلْمَلَـٰٓئِكَةُ يَضْرِبُونَ وُجُوهَهُمْ","",549],["48:22:6",513,"ٱلْأَدْبَـٰرَ","the backs","ٱلَّذِينَ كَفَرُوا۟ لَوَلَّوُا۟","ثُمَّ لَا يَجِدُونَ",549],["50:40:4",520,"وَأَدْبَـٰرَ","and after","وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ","ٱلسُّجُودِ",549],["52:49:4",525,"وَإِدْبَـٰرَ","and after","وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ","ٱلنُّجُومِ",2924],["54:45:4",530,"ٱلدُّبُرَ","(their) backs","سَيُهْزَمُ ٱلْجَمْعُ وَيُوَلُّونَ","",549],["59:12:13",547,"ٱلْأَدْبَـٰرَ","(their) backs","وَلَئِن نَّصَرُوهُمْ لَيُوَلُّنَّ","ثُمَّ لَا يُنصَرُونَ",549],["70:17:3",569,"أَدْبَرَ","turned his back","تَدْعُوا۟ مَنْ","وَتَوَلَّىٰ",1465],["74:23:2",576,"أَدْبَرَ","he turned back","ثُمَّ","وَٱسْتَكْبَرَ",1465],["74:33:3",576,"أَدْبَرَ","it departs","وَٱلَّيْلِ إِذْ","",1465],["79:5:1",583,"فَٱلْمُدَبِّرَٰتِ","And those who arrange","","أَمْرًۭا",3790],["79:22:2",584,"أَدْبَرَ","he turned his back","ثُمَّ","يَسْعَىٰ",1465]]