[["18:17:5",295,"تَّزَٰوَرُ","inclining away","ٱلشَّمْسَ إِذَا طَلَعَت","عَن كَهْفِهِمْ ذَاتَ",4489],["22:30:24",335,"ٱلزُّورِ","false","ٱلْأَوْثَـٰنِ وَٱجْتَنِبُوا۟ قَوْلَ","",1690],["25:4:16",360,"وَزُورًۭا","and a lie","فَقَدْ جَآءُو ظُلْمًۭا","",1690],["25:72:4",366,"ٱلزُّورَ","(to) the falsehood","وَٱلَّذِينَ لَا يَشْهَدُونَ","وَإِذَا مَرُّوا۟ بِٱللَّغْوِ",1690],["58:2:19",542,"وَزُورًۭا ۚ","and a lie","مُنكَرًۭا مِّنَ ٱلْقَوْلِ","وَإِنَّ ٱللَّهَ لَعَفُوٌّ",1690],["102:2:2",600,"زُرْتُمُ","you visit","حَتَّىٰ","ٱلْمَقَابِرَ",4769]]