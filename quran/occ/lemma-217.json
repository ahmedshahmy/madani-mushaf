[["2:26:12",5,"فَأَمَّا","Then as for","بَعُوضَةًۭ فَمَا فَوْقَهَا ۚ","ٱلَّذِينَ ءَامَنُوا۟ فَيَعْلَمُونَ",217],["2:26:20",5,"وَأَمَّا","And as for","ٱلْحَقُّ مِن رَّبِّهِمْ ۖ","ٱلَّذِينَ كَفَرُوا۟ فَيَقُولُونَ",217],["3:7:14",50,"فَأَمَّا","Then as for","ٱلْكِتَـٰبِ وَأُخَرُ مُتَشَـٰبِهَـٰتٌۭ ۖ","ٱلَّذِينَ فِى قُلُوبِهِمْ",217],["3:56:1",57,"فَأَمَّا","Then as for","","ٱلَّذِينَ كَفَرُوا۟ فَأُعَذِّبُهُمْ",217],["3:57:1",57,"وَأَمَّا","And as for","","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",217],["3:106:6",63,"فَأَمَّا","As for","وُجُوهٌۭ وَتَسْوَدُّ وُجُوهٌۭ ۚ","ٱلَّذِينَ ٱسْوَدَّتْ وُجُوهُهُمْ",217],["3:107:1",63,"وَأَمَّا","But as for","","ٱلَّذِينَ ٱبْيَضَّتْ وُجُوهُهُمْ",217],["4:173:1",105,"فَأَمَّا","Then as for","","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",217],["4:173:11",105,"وَأَمَّا","And as for","وَيَزِيدُهُم مِّن فَضْلِهِۦ ۖ","ٱلَّذِينَ ٱسْتَنكَفُوا۟ وَٱسْتَكْبَرُوا۟",217],["4:175:1",105,"فَأَمَّا","So as for","","ٱلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ",217],["9:124:12",207,"فَأَمَّا","As for","زَادَتْهُ هَـٰذِهِۦٓ إِيمَـٰنًۭا ۚ","ٱلَّذِينَ ءَامَنُوا۟ فَزَادَتْهُمْ",217],["9:125:1",207,"وَأَمَّا","But as for","","ٱلَّذِينَ فِى قُلُوبِهِم",217],["11:106:1",233,"فَأَمَّا","As for","","ٱلَّذِينَ شَقُوا۟ فَفِى",217],["11:108:1",233,"۞ وَأَمَّا","And as for","","ٱلَّذِينَ سُعِدُوا۟ فَفِى",217],["12:41:3",240,"أَمَّآ","As for","يَـٰصَـٰحِبَىِ ٱلسِّجْنِ","أَحَدُكُمَا فَيَسْقِى رَبَّهُۥ",217],["12:41:8",240,"وَأَمَّا","and as for","فَيَسْقِى رَبَّهُۥ خَمْرًۭا ۖ","ٱلْـَٔاخَرُ فَيُصْلَبُ فَتَأْكُلُ",217],["13:17:28",251,"فَأَمَّا","Then as for","ٱللَّهُ ٱلْحَقَّ وَٱلْبَـٰطِلَ ۚ","ٱلزَّبَدُ فَيَذْهَبُ جُفَآءًۭ ۖ",217],["13:17:32",251,"وَأَمَّا","and as for","ٱلزَّبَدُ فَيَذْهَبُ جُفَآءًۭ ۖ","مَا يَنفَعُ ٱلنَّاسَ",217],["18:79:1",302,"أَمَّا","As for","","ٱلسَّفِينَةُ فَكَانَتْ لِمَسَـٰكِينَ",217],["18:80:1",302,"وَأَمَّا","And as for","","ٱلْغُلَـٰمُ فَكَانَ أَبَوَاهُ",217],["18:82:1",302,"وَأَمَّا","And as for","","ٱلْجِدَارُ فَكَانَ لِغُلَـٰمَيْنِ",217],["18:87:2",303,"أَمَّا","As for","قَالَ","مَن ظَلَمَ فَسَوْفَ",217],["18:88:1",303,"وَأَمَّا","But as for","","مَنْ ءَامَنَ وَعَمِلَ",217],["28:67:1",393,"فَأَمَّا","But as for","","مَن تَابَ وَءَامَنَ",217],["30:15:1",405,"فَأَمَّا","Then as for","","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",217],["30:16:1",406,"وَأَمَّا","But as for","","ٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟",217],["32:19:1",416,"أَمَّا","As for","","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",217],["32:20:1",416,"وَأَمَّا","But as for","","ٱلَّذِينَ فَسَقُوا۟ فَمَأْوَىٰهُمُ",217],["41:15:1",478,"فَأَمَّا","Then as for","","عَادٌۭ فَٱسْتَكْبَرُوا۟ فِى",217],["41:17:1",478,"وَأَمَّا","And as for","","ثَمُودُ فَهَدَيْنَـٰهُمْ فَٱسْتَحَبُّوا۟",217],["45:30:1",501,"فَأَمَّا","Then as for","","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",217],["45:31:1",501,"وَأَمَّا","But as for","","ٱلَّذِينَ كَفَرُوٓا۟ أَفَلَمْ",217],["56:88:1",537,"فَأَمَّآ","Then","","إِن كَانَ مِنَ",217],["56:90:1",537,"وَأَمَّآ","And","","إِن كَانَ مِنْ",217],["56:92:1",537,"وَأَمَّآ","But","","إِن كَانَ مِنَ",217],["69:5:1",566,"فَأَمَّا","So as for","","ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ",217],["69:6:1",566,"وَأَمَّا","And as for","","عَادٌۭ فَأُهْلِكُوا۟ بِرِيحٍۢ",217],["69:19:1",567,"فَأَمَّا","Then as for","","مَنْ أُوتِىَ كِتَـٰبَهُۥ",217],["69:25:1",567,"وَأَمَّا","But as for","","مَنْ أُوتِىَ كِتَـٰبَهُۥ",217],["72:15:1",573,"وَأَمَّا","And as for","","ٱلْقَـٰسِطُونَ فَكَانُوا۟ لِجَهَنَّمَ",217],["79:37:1",584,"فَأَمَّا","Then as for","","مَن طَغَىٰ",217],["79:40:1",584,"وَأَمَّا","But as for","","مَنْ خَافَ مَقَامَ",217],["80:5:1",585,"أَمَّا","As for","","مَنِ ٱسْتَغْنَىٰ",217],["80:8:1",585,"وَأَمَّا","But as for","","مَن جَآءَكَ يَسْعَىٰ",217],["84:7:1",589,"فَأَمَّا","Then as for","","مَنْ أُوتِىَ كِتَـٰبَهُۥ",217],["84:10:1",589,"وَأَمَّا","But as for","","مَنْ أُوتِىَ كِتَـٰبَهُۥ",217],["89:15:1",593,"فَأَمَّا","And as for","","ٱلْإِنسَـٰنُ إِذَا مَا",217],["89:16:1",593,"وَأَمَّآ","But","","إِذَا مَا ٱبْتَلَىٰهُ",217],["92:5:1",595,"فَأَمَّا","Then as for","","مَنْ أَعْطَىٰ وَٱتَّقَىٰ",217],["92:8:1",595,"وَأَمَّا","But as for","","مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",217],["93:9:1",596,"فَأَمَّا","So as for","","ٱلْيَتِيمَ فَلَا تَقْهَرْ",217],["93:10:1",596,"وَأَمَّا","And as for","","ٱلسَّآئِلَ فَلَا تَنْهَرْ",217],["93:11:1",596,"وَأَمَّا","But as for","","بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",217],["101:6:1",600,"فَأَمَّا","Then as for","","مَن ثَقُلَتْ مَوَٰزِينُهُۥ",217],["101:8:1",600,"وَأَمَّا","But as for","","مَنْ خَفَّتْ مَوَٰزِينُهُۥ",217]]