[["3:13:27",51,"لَعِبْرَةًۭ","surely (is) a lesson","إِنَّ فِى ذَٰلِكَ","لِّأُو۟لِى ٱلْأَبْصَـٰرِ",1155],["4:43:16",85,"عَابِرِى","(when) passing","وَلَا جُنُبًا إِلَّا","سَبِيلٍ حَتَّىٰ تَغْتَسِلُوا۟ ۚ",3093],["12:43:24",240,"تَعْبُرُونَ","interpret","إِن كُنتُمْ لِلرُّءْيَا","",4324],["12:111:5",248,"عِبْرَةٌۭ","a lesson","كَانَ فِى قَصَصِهِمْ","لِّأُو۟لِى ٱلْأَلْبَـٰبِ ۗ مَا",1155],["16:66:5",274,"لَعِبْرَةًۭ ۖ","(is) a lesson","لَكُمْ فِى ٱلْأَنْعَـٰمِ","نُّسْقِيكُم مِّمَّا فِى",1155],["23:21:5",343,"لَعِبْرَةًۭ ۖ","surely, (is) a lesson","لَكُمْ فِى ٱلْأَنْعَـٰمِ","نُّسْقِيكُم مِّمَّا فِى",1155],["24:44:8",356,"لَعِبْرَةًۭ","surely is a lesson","إِنَّ فِى ذَٰلِكَ","لِّأُو۟لِى ٱلْأَبْصَـٰرِ",1155],["59:2:38",545,"فَٱعْتَبِرُوا۟","So take a lesson","بِأَيْدِيهِمْ وَأَيْدِى ٱلْمُؤْمِنِينَ","يَـٰٓأُو۟لِى ٱلْأَبْصَـٰرِ",4782],["79:26:4",584,"لَعِبْرَةًۭ","surely (is) a lesson","إِنَّ فِى ذَٰلِكَ","لِّمَن يَخْشَىٰٓ",1155]]