[["2:90:1",14,"بِئْسَمَا","Evil (is) that","","ٱشْتَرَوْا۟ بِهِۦٓ أَنفُسَهُمْ",289],["2:93:21",14,"بِئْسَمَا","Evil (is) that","ٱلْعِجْلَ بِكُفْرِهِمْ ۚ قُلْ","يَأْمُرُكُم بِهِۦٓ إِيمَـٰنُكُمْ",289],["2:102:67",16,"وَلَبِئْسَ","And surely evil","ٱلْـَٔاخِرَةِ مِنْ خَلَـٰقٍۢ ۚ","مَا شَرَوْا۟ بِهِۦٓ",289],["2:126:29",19,"وَبِئْسَ","and evil","إِلَىٰ عَذَابِ ٱلنَّارِ ۖ","ٱلْمَصِيرُ",289],["2:177:42",27,"ٱلْبَأْسَآءِ","[the] suffering","عَـٰهَدُوا۟ ۖ وَٱلصَّـٰبِرِينَ فِى","وَٱلضَّرَّآءِ وَحِينَ ٱلْبَأْسِ ۗ",1533],["2:177:45",27,"ٱلْبَأْسِ ۗ","(of) [the] stress","ٱلْبَأْسَآءِ وَٱلضَّرَّآءِ وَحِينَ","أُو۟لَـٰٓئِكَ ٱلَّذِينَ صَدَقُوا۟ ۖ",423],["2:206:11",32,"وَلَبِئْسَ","[and] surely an evil","بِٱلْإِثْمِ ۚ فَحَسْبُهُۥ جَهَنَّمُ ۚ","ٱلْمِهَادُ",289],["2:214:14",33,"ٱلْبَأْسَآءُ","[the] adversity","مِن قَبْلِكُم ۖ مَّسَّتْهُمُ","وَٱلضَّرَّآءُ وَزُلْزِلُوا۟ حَتَّىٰ",1533],["3:12:8",51,"وَبِئْسَ","[and] an evil","وَتُحْشَرُونَ إِلَىٰ جَهَنَّمَ ۚ","ٱلْمِهَادُ",289],["3:151:17",69,"وَبِئْسَ","and wretched","سُلْطَـٰنًۭا ۖ وَمَأْوَىٰهُمُ ٱلنَّارُ ۚ","مَثْوَى ٱلظَّـٰلِمِينَ",289],["3:162:12",71,"وَبِئْسَ","and wretched","ٱللَّهِ وَمَأْوَىٰهُ جَهَنَّمُ ۚ","ٱلْمَصِيرُ",289],["3:187:19",75,"فَبِئْسَ","And wretched","بِهِۦ ثَمَنًۭا قَلِيلًۭا ۖ","مَا يَشْتَرُونَ",289],["3:197:6",76,"وَبِئْسَ","[and] a wretched","ثُمَّ مَأْوَىٰهُمْ جَهَنَّمُ ۚ","ٱلْمِهَادُ",289],["4:84:15",91,"بَأْسَ","(the) might","ٱللَّهُ أَن يَكُفَّ","ٱلَّذِينَ كَفَرُوا۟ ۚ وَٱللَّهُ",423],["4:84:20",91,"بَأْسًۭا","(in) Might","كَفَرُوا۟ ۚ وَٱللَّهُ أَشَدُّ","وَأَشَدُّ تَنكِيلًۭا",423],["5:62:10",118,"لَبِئْسَ","Surely evil","وَٱلْعُدْوَٰنِ وَأَكْلِهِمُ ٱلسُّحْتَ ۚ","مَا كَانُوا۟ يَعْمَلُونَ",289],["5:63:10",118,"لَبِئْسَ","Surely, evil","ٱلْإِثْمَ وَأَكْلِهِمُ ٱلسُّحْتَ ۚ","مَا كَانُوا۟ يَصْنَعُونَ",289],["5:79:7",121,"لَبِئْسَ","Surely, evil","عَن مُّنكَرٍۢ فَعَلُوهُ ۚ","مَا كَانُوا۟ يَفْعَلُونَ",289],["5:80:7",121,"لَبِئْسَ","Surely evil","يَتَوَلَّوْنَ ٱلَّذِينَ كَفَرُوا۟ ۚ","مَا قَدَّمَتْ لَهُمْ",289],["6:42:8",132,"بِٱلْبَأْسَآءِ","with adversity","مِّن قَبْلِكَ فَأَخَذْنَـٰهُم","وَٱلضَّرَّآءِ لَعَلَّهُمْ يَتَضَرَّعُونَ",1533],["6:43:4",132,"بَأْسُنَا","Our punishment","فَلَوْلَآ إِذْ جَآءَهُم","تَضَرَّعُوا۟ وَلَـٰكِن قَسَتْ",423],["6:65:20",135,"بَأْسَ","violence","شِيَعًۭا وَيُذِيقَ بَعْضَكُم","بَعْضٍ ۗ ٱنظُرْ كَيْفَ",423],["6:147:10",148,"بَأْسُهُۥ","His wrath","وَٰسِعَةٍۢ وَلَا يُرَدُّ","عَنِ ٱلْقَوْمِ ٱلْمُجْرِمِينَ",423],["6:148:22",148,"بَأْسَنَا ۗ","Our wrath","قَبْلِهِمْ حَتَّىٰ ذَاقُوا۟","قُلْ هَلْ عِندَكُم",423],["7:4:6",151,"بَأْسُنَا","Our punishment","قَرْيَةٍ أَهْلَكْنَـٰهَا فَجَآءَهَا","بَيَـٰتًا أَوْ هُمْ",423],["7:5:6",151,"بَأْسُنَآ","Our punishment","دَعْوَىٰهُمْ إِذْ جَآءَهُم","إِلَّآ أَن قَالُوٓا۟",423],["7:94:10",162,"بِٱلْبَأْسَآءِ","with adversity","إِلَّآ أَخَذْنَآ أَهْلَهَا","وَٱلضَّرَّآءِ لَعَلَّهُمْ يَضَّرَّعُونَ",1533],["7:97:6",163,"بَأْسُنَا","Our punishment","ٱلْقُرَىٰٓ أَن يَأْتِيَهُم","بَيَـٰتًۭا وَهُمْ نَآئِمُونَ",423],["7:98:6",163,"بَأْسُنَا","Our punishment","ٱلْقُرَىٰٓ أَن يَأْتِيَهُم","ضُحًۭى وَهُمْ يَلْعَبُونَ",423],["7:150:9",169,"بِئْسَمَا","Evil is what","غَضْبَـٰنَ أَسِفًۭا قَالَ","خَلَفْتُمُونِى مِنۢ بَعْدِىٓ ۖ",289],["7:165:15",172,"بَـِٔيسٍۭ","wretched","ٱلَّذِينَ ظَلَمُوا۟ بِعَذَابٍۭ","بِمَا كَانُوا۟ يَفْسُقُونَ",3330],["8:16:19",178,"وَبِئْسَ","a wretched","ٱللَّهِ وَمَأْوَىٰهُ جَهَنَّمُ ۖ","ٱلْمَصِيرُ",289],["9:73:10",199,"وَبِئْسَ","and wretched","عَلَيْهِمْ ۚ وَمَأْوَىٰهُمْ جَهَنَّمُ ۖ","ٱلْمَصِيرُ",289],["11:36:14",225,"تَبْتَئِسْ","(be) distressed","قَدْ ءَامَنَ فَلَا","بِمَا كَانُوا۟ يَفْعَلُونَ",2662],["11:98:7",233,"وَبِئْسَ","And wretched","ٱلْقِيَـٰمَةِ فَأَوْرَدَهُمُ ٱلنَّارَ ۖ","ٱلْوِرْدُ ٱلْمَوْرُودُ",289],["11:99:7",233,"بِئْسَ","Wretched","لَعْنَةًۭ وَيَوْمَ ٱلْقِيَـٰمَةِ ۚ","ٱلرِّفْدُ ٱلْمَرْفُودُ",289],["12:69:13",243,"تَبْتَئِسْ","grieve","أَنَا۠ أَخُوكَ فَلَا","بِمَا كَانُوا۟ يَعْمَلُونَ",2662],["12:110:16",248,"بَأْسُنَا","Our punishment","نَّشَآءُ ۖ وَلَا يُرَدُّ","عَنِ ٱلْقَوْمِ ٱلْمُجْرِمِينَ",423],["13:18:26",251,"وَبِئْسَ","and wretched","ٱلْحِسَابِ وَمَأْوَىٰهُمْ جَهَنَّمُ ۖ","ٱلْمِهَادُ",289],["14:29:3",259,"وَبِئْسَ","and a wretched","جَهَنَّمَ يَصْلَوْنَهَا ۖ","ٱلْقَرَارُ",289],["16:29:6",270,"فَلَبِئْسَ","Surely, wretched","جَهَنَّمَ خَـٰلِدِينَ فِيهَا ۖ","مَثْوَى ٱلْمُتَكَبِّرِينَ",289],["16:81:19",276,"بَأْسَكُمْ ۚ","from your (mutual) violence","ٱلْحَرَّ وَسَرَٰبِيلَ تَقِيكُم","كَذَٰلِكَ يُتِمُّ نِعْمَتَهُۥ",423],["17:5:10",282,"بَأْسٍۢ","those of great military might","عِبَادًۭا لَّنَآ أُو۟لِى","شَدِيدٍۢ فَجَاسُوا۟ خِلَـٰلَ",423],["18:2:3",293,"بَأْسًۭا","(of) a punishment","قَيِّمًۭا لِّيُنذِرَ","شَدِيدًۭا مِّن لَّدُنْهُ",423],["18:29:25",297,"بِئْسَ","Wretched","كَٱلْمُهْلِ يَشْوِى ٱلْوُجُوهَ ۚ","ٱلشَّرَابُ وَسَآءَتْ مُرْتَفَقًا",289],["18:50:24",299,"بِئْسَ","Wretched","وَهُمْ لَكُمْ عَدُوٌّۢ ۚ","لِلظَّـٰلِمِينَ بَدَلًۭا",289],["21:12:3",323,"بَأْسَنَآ","Our torment","فَلَمَّآ أَحَسُّوا۟","إِذَا هُم مِّنْهَا",423],["21:80:7",328,"بَأْسِكُمْ ۖ","your battle","لَّكُمْ لِتُحْصِنَكُم مِّنۢ","فَهَلْ أَنتُمْ شَـٰكِرُونَ",423],["22:13:7",333,"لَبِئْسَ","Surely, an evil","أَقْرَبُ مِن نَّفْعِهِۦ ۚ","ٱلْمَوْلَىٰ وَلَبِئْسَ ٱلْعَشِيرُ",289],["22:13:9",333,"وَلَبِئْسَ","and surely an evil","نَّفْعِهِۦ ۚ لَبِئْسَ ٱلْمَوْلَىٰ","ٱلْعَشِيرُ",289],["22:28:19",335,"ٱلْبَآئِسَ","the miserable","فَكُلُوا۟ مِنْهَا وَأَطْعِمُوا۟","ٱلْفَقِيرَ",3312],["22:72:28",340,"وَبِئْسَ","and wretched","ٱللَّهُ ٱلَّذِينَ كَفَرُوا۟ ۖ","ٱلْمَصِيرُ",289],["24:57:10",357,"وَلَبِئْسَ","and wretched is","ٱلْأَرْضِ ۚ وَمَأْوَىٰهُمُ ٱلنَّارُ ۖ","ٱلْمَصِيرُ",289],["27:33:6",379,"بَأْسٍۢ","(of) might","أُو۟لُوا۟ قُوَّةٍۢ وَأُو۟لُوا۟","شَدِيدٍۢ وَٱلْأَمْرُ إِلَيْكِ",423],["33:18:12",420,"ٱلْبَأْسَ","(to) the battle","إِلَيْنَا ۖ وَلَا يَأْتُونَ","إِلَّا قَلِيلًا",423],["38:56:3",456,"فَبِئْسَ","and wretched (is)","جَهَنَّمَ يَصْلَوْنَهَا","ٱلْمِهَادُ",289],["38:60:10",456,"فَبِئْسَ","So wretched (is)","أَنتُمْ قَدَّمْتُمُوهُ لَنَا ۖ","ٱلْقَرَارُ",289],["39:72:7",466,"فَبِئْسَ","and wretched is","جَهَنَّمَ خَـٰلِدِينَ فِيهَا ۖ","مَثْوَى ٱلْمُتَكَبِّرِينَ",289],["40:29:11",470,"بَأْسِ","(the) punishment","فَمَن يَنصُرُنَا مِنۢ","ٱللَّهِ إِن جَآءَنَا ۚ",423],["40:76:6",475,"فَبِئْسَ","and wretched is","جَهَنَّمَ خَـٰلِدِينَ فِيهَا ۖ","مَثْوَى ٱلْمُتَكَبِّرِينَ",289],["40:84:3",476,"بَأْسَنَا","Our punishment","فَلَمَّا رَأَوْا۟","قَالُوٓا۟ ءَامَنَّا بِٱللَّهِ",423],["40:85:7",476,"بَأْسَنَا ۖ","Our punishment","إِيمَـٰنُهُمْ لَمَّا رَأَوْا۟","سُنَّتَ ٱللَّهِ ٱلَّتِى",423],["43:38:10",492,"فَبِئْسَ","How wretched is","وَبَيْنَكَ بُعْدَ ٱلْمَشْرِقَيْنِ","ٱلْقَرِينُ",289],["48:16:9",513,"بَأْسٍۢ","possessors of military might","إِلَىٰ قَوْمٍ أُو۟لِى","شَدِيدٍۢ تُقَـٰتِلُونَهُمْ أَوْ",423],["49:11:29",516,"بِئْسَ","Wretched is","وَلَا تَنَابَزُوا۟ بِٱلْأَلْقَـٰبِ ۖ","ٱلِٱسْمُ ٱلْفُسُوقُ بَعْدَ",289],["57:15:14",539,"وَبِئْسَ","and wretched is","ٱلنَّارُ ۖ هِىَ مَوْلَىٰكُمْ ۖ","ٱلْمَصِيرُ",289],["57:25:15",541,"بَأْسٌۭ","(is) power","وَأَنزَلْنَا ٱلْحَدِيدَ فِيهِ","شَدِيدٌۭ وَمَنَـٰفِعُ لِلنَّاسِ",423],["58:8:37",543,"فَبِئْسَ","and worst is","حَسْبُهُمْ جَهَنَّمُ يَصْلَوْنَهَا ۖ","ٱلْمَصِيرُ",289],["59:14:12",547,"بَأْسُهُم","Their violence","مِن وَرَآءِ جُدُرٍۭ ۚ","بَيْنَهُمْ شَدِيدٌۭ ۚ تَحْسَبُهُمْ",423],["62:5:12",553,"بِئْسَ","Wretched is","ٱلْحِمَارِ يَحْمِلُ أَسْفَارًۢا ۚ","مَثَلُ ٱلْقَوْمِ ٱلَّذِينَ",289],["64:10:10",557,"وَبِئْسَ","And wretched is","ٱلنَّارِ خَـٰلِدِينَ فِيهَا ۖ","ٱلْمَصِيرُ",289],["66:9:10",561,"وَبِئْسَ","and wretched is","عَلَيْهِمْ ۚ وَمَأْوَىٰهُمْ جَهَنَّمُ ۖ","ٱلْمَصِيرُ",289],["67:6:6",562,"وَبِئْسَ","and wretched is","بِرَبِّهِمْ عَذَابُ جَهَنَّمَ ۖ","ٱلْمَصِيرُ",289]]