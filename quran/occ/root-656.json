[["16:45:6",272,"يَخْسِفَ","Allah will cave","مَكَرُوا۟ ٱلسَّيِّـَٔاتِ أَن","ٱللَّهُ بِهِمُ ٱلْأَرْضَ",1010],["17:68:3",289,"يَخْسِفَ","He will cause to swallow","أَفَأَمِنتُمْ أَن","بِكُمْ جَانِبَ ٱلْبَرِّ",1010],["28:81:1",395,"فَخَسَفْنَا","Then We caused to swallow up","","بِهِۦ وَبِدَارِهِ ٱلْأَرْضَ",1010],["28:82:21",395,"لَخَسَفَ","He would have caused it to swallow us","مَّنَّ ٱللَّهُ عَلَيْنَا","بِنَا ۖ وَيْكَأَنَّهُۥ لَا",1010],["29:40:15",401,"خَسَفْنَا","We caused to swallow","ٱلصَّيْحَةُ وَمِنْهُم مَّنْ","بِهِ ٱلْأَرْضَ وَمِنْهُم",1010],["34:9:14",429,"نَخْسِفْ","We (could) cause to swallow them","وَٱلْأَرْضِ ۚ إِن نَّشَأْ","بِهِمُ ٱلْأَرْضَ أَوْ",1010],["67:16:6",563,"يَخْسِفَ","He will cause to swallow","فِى ٱلسَّمَآءِ أَن","بِكُمُ ٱلْأَرْضَ فَإِذَا",1010],["75:8:1",577,"وَخَسَفَ","And becomes dark","","ٱلْقَمَرُ",1010]]