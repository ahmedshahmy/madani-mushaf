[["12:19:12",237,"بِضَـٰعَةًۭ ۚ","(as) a merchandise","هَـٰذَا غُلَـٰمٌۭ ۚ وَأَسَرُّوهُ","وَٱللَّهُ عَلِيمٌۢ بِمَا",1326],["12:42:17",240,"بِضْعَ","several","فَلَبِثَ فِى ٱلسِّجْنِ","سِنِينَ",2341],["12:62:4",242,"بِضَـٰعَتَهُمْ","their merchandise","وَقَالَ لِفِتْيَـٰنِهِ ٱجْعَلُوا۟","فِى رِحَالِهِمْ لَعَلَّهُمْ",1326],["12:65:5",243,"بِضَـٰعَتَهُمْ","their merchandise","فَتَحُوا۟ مَتَـٰعَهُمْ وَجَدُوا۟","رُدَّتْ إِلَيْهِمْ ۖ قَالُوا۟",1326],["12:65:13",243,"بِضَـٰعَتُنَا","(is) our merchandise","مَا نَبْغِى ۖ هَـٰذِهِۦ","رُدَّتْ إِلَيْنَا ۖ وَنَمِيرُ",1326],["12:88:11",246,"بِبِضَـٰعَةٍۢ","with goods","وَأَهْلَنَا ٱلضُّرُّ وَجِئْنَا","مُّزْجَىٰةٍۢ فَأَوْفِ لَنَا",1326],["30:4:2",404,"بِضْعِ","a few","فِى","سِنِينَ ۗ لِلَّهِ ٱلْأَمْرُ",2341]]