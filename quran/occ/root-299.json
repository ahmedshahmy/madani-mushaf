[["2:94:9",15,"خَالِصَةًۭ","exclusively","ٱلْـَٔاخِرَةُ عِندَ ٱللَّهِ","مِّن دُونِ ٱلنَّاسِ",1413],["2:139:14",21,"مُخْلِصُونَ","(are) sincere","أَعْمَـٰلُكُمْ وَنَحْنُ لَهُۥ","",791],["4:146:7",101,"وَأَخْلَصُوا۟","and are sincere","وَأَصْلَحُوا۟ وَٱعْتَصَمُوا۟ بِٱللَّهِ","دِينَهُمْ لِلَّهِ فَأُو۟لَـٰٓئِكَ",2208],["6:139:7",146,"خَالِصَةٌۭ","(is) exclusively","بُطُونِ هَـٰذِهِ ٱلْأَنْعَـٰمِ","لِّذُكُورِنَا وَمُحَرَّمٌ عَلَىٰٓ",1413],["7:29:11",153,"مُخْلِصِينَ","(being) sincere","كُلِّ مَسْجِدٍۢ وَٱدْعُوهُ","لَهُ ٱلدِّينَ ۚ كَمَا",791],["7:32:19",154,"خَالِصَةًۭ","exclusively (for them)","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا","يَوْمَ ٱلْقِيَـٰمَةِ ۗ كَذَٰلِكَ",1413],["10:22:32",211,"مُخْلِصِينَ","sincerely","بِهِمْ ۙ دَعَوُا۟ ٱللَّهَ","لَهُ ٱلدِّينَ لَئِنْ",791],["12:24:19",238,"ٱلْمُخْلَصِينَ","the sincere","إِنَّهُۥ مِنْ عِبَادِنَا","",912],["12:54:5",242,"أَسْتَخْلِصْهُ","I will select him","ٱلْمَلِكُ ٱئْتُونِى بِهِۦٓ","لِنَفْسِى ۖ فَلَمَّا كَلَّمَهُۥ",3038],["12:80:4",245,"خَلَصُوا۟","they secluded themselves","فَلَمَّا ٱسْتَيْـَٔسُوا۟ مِنْهُ","نَجِيًّۭا ۖ قَالَ كَبِيرُهُمْ",4572],["15:40:4",264,"ٱلْمُخْلَصِينَ","the ones who are sincere","إِلَّا عِبَادَكَ مِنْهُمُ","",912],["16:66:15",274,"خَالِصًۭا","pure","فَرْثٍۢ وَدَمٍۢ لَّبَنًا","سَآئِغًۭا لِّلشَّـٰرِبِينَ",2727],["19:51:7",308,"مُخْلَصًۭا","chosen","مُوسَىٰٓ ۚ إِنَّهُۥ كَانَ","وَكَانَ رَسُولًۭا نَّبِيًّۭا",912],["29:65:7",404,"مُخْلِصِينَ","(being) sincere","ٱلْفُلْكِ دَعَوُا۟ ٱللَّهَ","لَهُ ٱلدِّينَ فَلَمَّا",791],["31:32:7",414,"مُخْلِصِينَ","(being) sincere","كَٱلظُّلَلِ دَعَوُا۟ ٱللَّهَ","لَهُ ٱلدِّينَ فَلَمَّا",791],["33:50:39",424,"خَالِصَةًۭ","only","ٱلنَّبِىُّ أَن يَسْتَنكِحَهَا","لَّكَ مِن دُونِ",1413],["37:40:4",447,"ٱلْمُخْلَصِينَ","the chosen ones","إِلَّا عِبَادَ ٱللَّهِ","",912],["37:74:4",448,"ٱلْمُخْلَصِينَ","the chosen ones","إِلَّا عِبَادَ ٱللَّهِ","",912],["37:128:4",451,"ٱلْمُخْلَصِينَ","the chosen ones","إِلَّا عِبَادَ ٱللَّهِ","",912],["37:160:4",452,"ٱلْمُخْلَصِينَ","the chosen","إِلَّا عِبَادَ ٱللَّهِ","",912],["37:169:4",452,"ٱلْمُخْلَصِينَ","the chosen","لَكُنَّا عِبَادَ ٱللَّهِ","",912],["38:46:2",456,"أَخْلَصْنَـٰهُم","[We] chose them","إِنَّآ","بِخَالِصَةٍۢ ذِكْرَى ٱلدَّارِ",2208],["38:46:3",456,"بِخَالِصَةٍۢ","for an exclusive (quality)","إِنَّآ أَخْلَصْنَـٰهُم","ذِكْرَى ٱلدَّارِ",1413],["38:83:4",457,"ٱلْمُخْلَصِينَ","the chosen ones","إِلَّا عِبَادَكَ مِنْهُمُ","",912],["39:2:8",458,"مُخْلِصًۭا","(being) sincere","بِٱلْحَقِّ فَٱعْبُدِ ٱللَّهَ","لَّهُ ٱلدِّينَ",791],["39:3:4",458,"ٱلْخَالِصُ ۚ","the pure","أَلَا لِلَّهِ ٱلدِّينُ","وَٱلَّذِينَ ٱتَّخَذُوا۟ مِن",2727],["39:11:7",460,"مُخْلِصًۭا","(being) sincere","أَنْ أَعْبُدَ ٱللَّهَ","لَّهُ ٱلدِّينَ",791],["39:14:4",460,"مُخْلِصًۭا","(being) sincere","قُلِ ٱللَّهَ أَعْبُدُ","لَّهُۥ دِينِى",791],["40:14:3",468,"مُخْلِصِينَ","(being) sincere","فَٱدْعُوا۟ ٱللَّهَ","لَهُ ٱلدِّينَ وَلَوْ",791],["40:65:8",474,"مُخْلِصِينَ","(being) sincere","إِلَّا هُوَ فَٱدْعُوهُ","لَهُ ٱلدِّينَ ۗ ٱلْحَمْدُ",791],["98:5:6",598,"مُخْلِصِينَ","(being) sincere","إِلَّا لِيَعْبُدُوا۟ ٱللَّهَ","لَهُ ٱلدِّينَ حُنَفَآءَ",791]]