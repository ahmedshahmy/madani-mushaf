[["5:3:14",107,"وَٱلْمُتَرَدِّيَةُ","and that which has a fatal fall","بِهِۦ وَٱلْمُنْخَنِقَةُ وَٱلْمَوْقُوذَةُ","وَٱلنَّطِيحَةُ وَمَآ أَكَلَ",3878],["6:137:9",145,"لِيُرْدُوهُمْ","so that they may ruin them","قَتْلَ أَوْلَـٰدِهِمْ شُرَكَآؤُهُمْ","وَلِيَلْبِسُوا۟ عَلَيْهِمْ دِينَهُمْ ۖ",1740],["20:16:10",313,"فَتَرْدَىٰ","lest you perish","بِهَا وَٱتَّبَعَ هَوَىٰهُ","",4412],["37:56:5",448,"لَتُرْدِينِ","ruined me","تَٱللَّهِ إِن كِدتَّ","",1740],["41:23:6",479,"أَرْدَىٰكُمْ","It has ruined you","ٱلَّذِى ظَنَنتُم بِرَبِّكُمْ","فَأَصْبَحْتُم مِّنَ ٱلْخَـٰسِرِينَ",1740],["92:11:6",596,"تَرَدَّىٰٓ","he falls","عَنْهُ مَالُهُۥٓ إِذَا","",4411]]