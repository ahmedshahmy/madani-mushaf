[["2:109:12",17,"حَسَدًۭا","(out of) jealousy","بَعْدِ إِيمَـٰنِكُمْ كُفَّارًا","مِّنْ عِندِ أَنفُسِهِم",3197],["4:54:2",87,"يَحْسُدُونَ","are they jealous","أَمْ","ٱلنَّاسَ عَلَىٰ مَآ",1783],["48:15:25",512,"تَحْسُدُونَنَا ۚ","you envy us","قَبْلُ ۖ فَسَيَقُولُونَ بَلْ","بَلْ كَانُوا۟ لَا",1783],["113:5:3",604,"حَاسِدٍ","(of) an envier","وَمِن شَرِّ","إِذَا حَسَدَ",3166],["113:5:5",604,"حَسَدَ","he envies","شَرِّ حَاسِدٍ إِذَا","",1783]]