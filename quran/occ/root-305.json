[["2:114:11",18,"وَسَعَىٰ","and strives","يُذْكَرَ فِيهَا ٱسْمُهُۥ","فِى خَرَابِهَآ ۚ أُو۟لَـٰٓئِكَ",518],["2:205:3",32,"سَعَىٰ","he strives","وَإِذَا تَوَلَّىٰ","فِى ٱلْأَرْضِ لِيُفْسِدَ",518],["2:260:34",44,"سَعْيًۭا ۚ","(in) haste","ثُمَّ ٱدْعُهُنَّ يَأْتِينَكَ","وَٱعْلَمْ أَنَّ ٱللَّهَ",858],["5:33:7",113,"وَيَسْعَوْنَ","and strive","يُحَارِبُونَ ٱللَّهَ وَرَسُولَهُۥ","فِى ٱلْأَرْضِ فَسَادًا",518],["5:64:40",118,"وَيَسْعَوْنَ","And they strive","لِّلْحَرْبِ أَطْفَأَهَا ٱللَّهُ ۚ","فِى ٱلْأَرْضِ فَسَادًۭا ۚ",518],["17:19:4",284,"وَسَعَىٰ","and exerts","وَمَنْ أَرَادَ ٱلْـَٔاخِرَةَ","لَهَا سَعْيَهَا وَهُوَ",518],["17:19:6",284,"سَعْيَهَا","the effort","ٱلْـَٔاخِرَةَ وَسَعَىٰ لَهَا","وَهُوَ مُؤْمِنٌۭ فَأُو۟لَـٰٓئِكَ",858],["17:19:11",284,"سَعْيُهُم","their effort","مُؤْمِنٌۭ فَأُو۟لَـٰٓئِكَ كَانَ","مَّشْكُورًۭا",858],["18:104:3",304,"سَعْيُهُمْ","their effort","ٱلَّذِينَ ضَلَّ","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا",858],["20:15:10",313,"تَسْعَىٰ","it strives","كُلُّ نَفْسٍۭ بِمَا","",518],["20:20:5",313,"تَسْعَىٰ","moving swiftly","فَإِذَا هِىَ حَيَّةٌۭ","",518],["20:66:12",316,"تَسْعَىٰ","(were) moving","مِن سِحْرِهِمْ أَنَّهَا","",518],["21:94:9",330,"لِسَعْيِهِۦ","[of] his effort","مُؤْمِنٌۭ فَلَا كُفْرَانَ","وَإِنَّا لَهُۥ كَـٰتِبُونَ",858],["22:51:2",338,"سَعَوْا۟","strove","وَٱلَّذِينَ","فِىٓ ءَايَـٰتِنَا مُعَـٰجِزِينَ",518],["28:20:6",387,"يَسْعَىٰ","running","مِّنْ أَقْصَا ٱلْمَدِينَةِ","قَالَ يَـٰمُوسَىٰٓ إِنَّ",518],["34:5:2",428,"سَعَوْ","strive","وَٱلَّذِينَ","فِىٓ ءَايَـٰتِنَا مُعَـٰجِزِينَ",518],["34:38:2",432,"يَسْعَوْنَ","strive","وَٱلَّذِينَ","فِىٓ ءَايَـٰتِنَا مُعَـٰجِزِينَ",518],["36:20:6",441,"يَسْعَىٰ","running","أَقْصَا ٱلْمَدِينَةِ رَجُلٌۭ","قَالَ يَـٰقَوْمِ ٱتَّبِعُوا۟",518],["37:102:4",449,"ٱلسَّعْىَ","the (age of) working with him","فَلَمَّا بَلَغَ مَعَهُ","قَالَ يَـٰبُنَىَّ إِنِّىٓ",858],["53:39:6",527,"سَعَىٰ","he strives (for)","لِلْإِنسَـٰنِ إِلَّا مَا","",518],["53:40:2",527,"سَعْيَهُۥ","his striving","وَأَنَّ","سَوْفَ يُرَىٰ",858],["57:12:5",539,"يَسْعَىٰ","running","تَرَى ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ","نُورُهُم بَيْنَ أَيْدِيهِمْ",518],["62:9:10",554,"فَٱسْعَوْا۟","then hasten","مِن يَوْمِ ٱلْجُمُعَةِ","إِلَىٰ ذِكْرِ ٱللَّهِ",518],["66:8:30",561,"يَسْعَىٰ","will run","ءَامَنُوا۟ مَعَهُۥ ۖ نُورُهُمْ","بَيْنَ أَيْدِيهِمْ وَبِأَيْمَـٰنِهِمْ",518],["76:22:7",579,"سَعْيُكُم","your effort","لَكُمْ جَزَآءًۭ وَكَانَ","مَّشْكُورًا",858],["79:22:3",584,"يَسْعَىٰ","striving","ثُمَّ أَدْبَرَ","",518],["79:35:5",584,"سَعَىٰ","he strove (for)","يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا","",518],["80:8:4",585,"يَسْعَىٰ","striving","وَأَمَّا مَن جَآءَكَ","",518],["88:9:1",592,"لِّسَعْيِهَا","With their effort","","رَاضِيَةٌۭ",858],["92:4:2",595,"سَعْيَكُمْ","your efforts","إِنَّ","لَشَتَّىٰ",858]]