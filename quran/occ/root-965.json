[["5:64:38",118,"أَطْفَأَهَا","it (was) extinguished","أَوْقَدُوا۟ نَارًۭا لِّلْحَرْبِ","ٱللَّهُ ۚ وَيَسْعَوْنَ فِى",1729],["9:32:3",192,"يُطْفِـُٔوا۟","extinguish","يُرِيدُونَ أَن","نُورَ ٱللَّهِ بِأَفْوَٰهِهِمْ",1729],["61:8:2",552,"لِيُطْفِـُٔوا۟","to put out","يُرِيدُونَ","نُورَ ٱللَّهِ بِأَفْوَٰهِهِمْ",1729]]