[["3:52:2",56,"أَحَسَّ","perceived","۞ فَلَمَّآ","عِيسَىٰ مِنْهُمُ ٱلْكُفْرَ",1726],["3:152:6",69,"تَحُسُّونَهُم","you were killing them","ٱللَّهُ وَعْدَهُۥٓ إِذْ","بِإِذْنِهِۦ ۖ حَتَّىٰٓ إِذَا",4339],["12:87:3",246,"فَتَحَسَّسُوا۟","and inquire","يَـٰبَنِىَّ ٱذْهَبُوا۟","مِن يُوسُفَ وَأَخِيهِ",4333],["19:98:7",312,"تُحِسُّ","you perceive","مِّن قَرْنٍ هَلْ","مِنْهُم مِّنْ أَحَدٍ",1726],["21:12:2",323,"أَحَسُّوا۟","they perceived","فَلَمَّآ","بَأْسَنَآ إِذَا هُم",1726],["21:102:3",331,"حَسِيسَهَا ۖ","(the) slightest sound of it","لَا يَسْمَعُونَ","وَهُمْ فِى مَا",3199]]