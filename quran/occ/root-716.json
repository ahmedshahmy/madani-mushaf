[["37:45:3",447,"بِكَأْسٍۢ","a cup","يُطَافُ عَلَيْهِم","مِّن مَّعِينٍۭ",1187],["52:23:3",524,"كَأْسًۭا","a cup","يَتَنَـٰزَعُونَ فِيهَا","لَّا لَغْوٌۭ فِيهَا",1187],["56:18:3",535,"وَكَأْسٍۢ","and a cup","بِأَكْوَابٍۢ وَأَبَارِيقَ","مِّن مَّعِينٍۢ",1187],["76:5:5",578,"كَأْسٍۢ","a cup","ٱلْأَبْرَارَ يَشْرَبُونَ مِن","كَانَ مِزَاجُهَا كَافُورًا",1187],["76:17:3",579,"كَأْسًۭا","a cup","وَيُسْقَوْنَ فِيهَا","كَانَ مِزَاجُهَا زَنجَبِيلًا",1187],["78:34:1",583,"وَكَأْسًۭا","And a cup","","دِهَاقًۭا",1187]]