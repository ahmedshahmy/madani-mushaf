","قَالَ رَبِّ","عَلَى ٱلْقَوْمِ ٱلْمُفْسِدِينَ",202],["30:5:1",404,"بِنَصْرِ","With (the) help","","ٱللَّهِ ۚ يَنصُرُ مَن",472],["30:5:3",404,"يَنصُرُ","He helps","بِنَصْرِ ٱللَّهِ ۚ","مَن يَشَآءُ ۖ وَهُوَ",202],["30:29:16",407,"نَّـٰصِرِينَ","helpers","وَمَا لَهُم مِّن","",793],["30:47:17",409,"نَصْرُ","(to) help","وَكَانَ حَقًّا عَلَيْنَا","ٱلْمُؤْمِنِينَ",472],["33:17:24",420,"نَصِيرًۭا","any helper","ٱللَّهِ وَلِيًّۭا وَلَا","",332],["33:65:8",427,"نَصِيرًۭا","any helper","يَجِدُونَ وَلِيًّۭا وَلَا","",332],["35:37:25",438,"نَّصِيرٍ","helper","فَمَا لِلظَّـٰلِمِينَ مِن","",332],["36:74:7",445,"يُنصَرُونَ","be helped","ٱللَّهِ ءَالِهَةًۭ لَّعَلَّهُمْ","",202],["36:75:3",445,"نَصْرَهُمْ","to help them","لَا يَسْتَطِيعُونَ","وَهُمْ لَهُمْ جُندٌۭ",472],["37:25:4",447,"تَنَاصَرُونَ","you help one another","مَا لَكُمْ لَا","",4396],["37:116:1",450,"وَنَصَرْنَـٰهُمْ","And We helped them","","فَكَانُوا۟ هُمُ ٱلْغَـٰلِبِينَ",202],["37:172:3",452,"ٱلْمَنصُورُونَ","(would be) the victorious","إِنَّهُمْ لَهُمُ","",2455],["39:54:13",464,"تُنصَرُونَ","you will be helped","ٱلْعَذَابُ ثُمَّ لَا","",202],["40:29:9",470,"يَنصُرُنَا","will help us","فِى ٱلْأَرْضِ فَمَن","مِنۢ بَأْسِ ٱللَّهِ",202],["40:51:2",473,"لَنَنصُرُ","We will surely help","إِنَّا","رُسُلَنَا وَٱلَّذِينَ ءَامَنُوا۟",202],["41:16:19",478,"يُنصَرُونَ","will not be helped","أَخْزَىٰ ۖ وَهُمْ لَا","",202],["42:8:19",483,"نَصِيرٍ","any helper","مِّن وَلِىٍّۢ وَلَا","",332],["42:31:14",486,"نَصِيرٍۢ","any helper","مِن وَلِىٍّۢ وَلَا","",332],["42:39:6",487,"يَنتَصِرُونَ","defend themselves","أَصَابَهُمُ ٱلْبَغْىُ هُمْ","",1125],["42:41:2",487,"ٱنتَصَرَ","defends himself","وَلَمَنِ","بَعْدَ ظُلْمِهِۦ فَأُو۟لَـٰٓئِكَ",1125],["42:46:6",488,"يَنصُرُونَهُم","(who) will help them","لَهُم مِّنْ أَوْلِيَآءَ","مِّن دُونِ ٱللَّهِ ۗ",202],["44:41:10",498,"يُنصَرُونَ","will be helped","شَيْـًۭٔا وَلَا هُمْ","",202],["45:34:14",502,"نَّـٰصِرِينَ","helpers","وَمَا لَكُم مِّن","",793],["46:28:2",505,"نَصَرَهُمُ","help them","فَلَوْلَا","ٱلَّذِينَ ٱتَّخَذُوا۟ مِن",202],["47:4:25",507,"لَٱنتَصَرَ","surely, He could have taken retribution","وَلَوْ يَشَآءُ ٱللَّهُ","مِنْهُمْ وَلَـٰكِن لِّيَبْلُوَا۟",1125],["47:7:5",507,"تَنصُرُوا۟","you help","ٱلَّذِينَ ءَامَنُوٓا۟ إِن","ٱللَّهَ يَنصُرْكُمْ وَيُثَبِّتْ",202],["47:7:7",507,"يَنصُرْكُمْ","He will help you","إِن تَنصُرُوا۟ ٱللَّهَ","وَيُثَبِّتْ أَقْدَامَكُمْ",202],["47:13:13",508,"نَاصِرَ","helper","أَخْرَجَتْكَ أَهْلَكْنَـٰهُمْ فَلَا","لَهُمْ",793],["48:3:1",511,"وَيَنصُرَكَ","And Allah may help you","","ٱللَّهُ نَصْرًا عَزِيزًا",202],["48:3:3",511,"نَصْرًا","(with) a help","وَيَنصُرَكَ ٱللَّهُ","عَزِيزًا",472],["48:22:12",513,"نَصِيرًۭا","any helper","يَجِدُونَ وَلِيًّۭا وَلَا","",332],["51:45:7",522,"مُنتَصِرِينَ","help themselves","قِيَامٍۢ وَمَا كَانُوا۟","",1605],["52:46:9",525,"يُنصَرُونَ","will be helped","شَيْـًۭٔا وَلَا هُمْ","",202],["54:10:5",529,"فَٱنتَصِرْ","so help","رَبَّهُۥٓ أَنِّى مَغْلُوبٌۭ","",1125],["54:44:5",530,"مُّنتَصِرٌۭ","helping (each other)","يَقُولُونَ نَحْنُ جَمِيعٌۭ","",1605],["55:35:8",532,"تَنتَصِرَانِ","you will (be able to) defend yourselves","نَّارٍۢ وَنُحَاسٌۭ فَلَا","",1125],["57:25:22",541,"يَنصُرُهُۥ","helps Him","وَلِيَعْلَمَ ٱللَّهُ مَن","وَرُسُلَهُۥ بِٱلْغَيْبِ ۚ إِنَّ",202],["59:8:13",546,"وَيَنصُرُونَ","and helping","مِّنَ ٱللَّهِ وَرِضْوَٰنًۭا","ٱللَّهَ وَرَسُولَهُۥٓ ۚ أُو۟لَـٰٓئِكَ",202],["59:11:24",547,"لَنَنصُرَنَّكُمْ","certainly we will help you","أَبَدًۭا وَإِن قُوتِلْتُمْ","وَٱللَّهُ يَشْهَدُ إِنَّهُمْ",202],["59:12:9",547,"يَنصُرُونَهُمْ","they will help them","وَلَئِن قُوتِلُوا۟ لَا","وَلَئِن نَّصَرُوهُمْ لَيُوَلُّنَّ",202],["59:12:11",547,"نَّصَرُوهُمْ","they help them","لَا يَنصُرُونَهُمْ وَلَئِن","لَيُوَلُّنَّ ٱلْأَدْبَـٰرَ ثُمَّ",202],["59:12:16",547,"يُنصَرُونَ","they will be helped","ٱلْأَدْبَـٰرَ ثُمَّ لَا","",202],["61:13:3",552,"نَصْرٌۭ","a help","وَأُخْرَىٰ تُحِبُّونَهَا ۖ","مِّنَ ٱللَّهِ وَفَتْحٌۭ",472],["61:14:5",552,"أَنصَارَ","helpers","ٱلَّذِينَ ءَامَنُوا۟ كُونُوٓا۟","ٱللَّهِ كَمَا قَالَ",332],["61:14:14",552,"أَنصَارِىٓ","(are) my helpers","مَرْيَمَ لِلْحَوَارِيِّـۧنَ مَنْ","إِلَى ٱللَّهِ ۖ قَالَ",332],["61:14:20",552,"أَنصَارُ","(are) the helpers","قَالَ ٱلْحَوَارِيُّونَ نَحْنُ","ٱللَّهِ ۖ فَـَٔامَنَت طَّآئِفَةٌۭ",332],["67:20:7",563,"يَنصُرُكُم","to help you","هُوَ جُندٌۭ لَّكُمْ","مِّن دُونِ ٱلرَّحْمَـٰنِ ۚ",202],["71:25:12",571,"أَنصَارًۭا","any helpers","مِّن دُونِ ٱللَّهِ","",332],["72:24:9",573,"نَاصِرًۭا","(in) helpers","فَسَيَعْلَمُونَ مَنْ أَضْعَفُ","وَأَقَلُّ عَدَدًۭا",793],["86:10:6",591,"نَاصِرٍۢ","any helper","مِن قُوَّةٍۢ وَلَا","",793],["110:1:3",603,"نَصْرُ","(the) Help","إِذَا جَآءَ","ٱللَّهِ وَٱلْفَتْحُ",472]]