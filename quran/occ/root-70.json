","وَٱلَّذِينَ هَادُوا۟ وَٱلصَّـٰبِـُٔونَ","مَنْ ءَامَنَ بِٱللَّهِ",635],["5:72:33",120,"أَنصَارٍۢ","helpers","وَمَا لِلظَّـٰلِمِينَ مِنْ","",332],["5:82:18",121,"نَصَـٰرَىٰ ۚ","(are) Christians","ٱلَّذِينَ قَالُوٓا۟ إِنَّا","ذَٰلِكَ بِأَنَّ مِنْهُمْ",635],["6:34:13",131,"نَصْرُنَا ۚ","Our help","وَأُوذُوا۟ حَتَّىٰٓ أَتَىٰهُمْ","وَلَا مُبَدِّلَ لِكَلِمَـٰتِ",472],["7:157:35",170,"وَنَصَرُوهُ","and help him","ءَامَنُوا۟ بِهِۦ وَعَزَّرُوهُ","وَٱتَّبَعُوا۟ ٱلنُّورَ ٱلَّذِىٓ",202],["7:192:4",175,"نَصْرًۭا","any help","وَلَا يَسْتَطِيعُونَ لَهُمْ","وَلَآ أَنفُسَهُمْ يَنصُرُونَ",472],["7:192:7",175,"يَنصُرُونَ","can they help","نَصْرًۭا وَلَآ أَنفُسَهُمْ","",202],["7:197:7",176,"نَصْرَكُمْ","(to) help you","دُونِهِۦ لَا يَسْتَطِيعُونَ","وَلَآ أَنفُسَهُمْ يَنصُرُونَ",472],["7:197:10",176,"يَنصُرُونَ","can they help","نَصْرَكُمْ وَلَآ أَنفُسَهُمْ","",202],["8:10:10",178,"ٱلنَّصْرُ","[the] victory","بِهِۦ قُلُوبُكُمْ ۚ وَمَا","إِلَّا مِنْ عِندِ",472],["8:26:14",180,"بِنَصْرِهِۦ","with His help","ٱلنَّاسُ فَـَٔاوَىٰكُمْ وَأَيَّدَكُم","وَرَزَقَكُم مِّنَ ٱلطَّيِّبَـٰتِ",472],["8:40:10",181,"ٱلنَّصِيرُ","(is) the Helper","نِعْمَ ٱلْمَوْلَىٰ وَنِعْمَ","",332],["8:62:11",185,"بِنَصْرِهِۦ","with His help","هُوَ ٱلَّذِىٓ أَيَّدَكَ","وَبِٱلْمُؤْمِنِينَ",472],["8:72:13",186,"وَّنَصَرُوٓا۟","and helped","ٱللَّهِ وَٱلَّذِينَ ءَاوَوا۟","أُو۟لَـٰٓئِكَ بَعْضُهُمْ أَوْلِيَآءُ",202],["8:72:31",186,"ٱسْتَنصَرُوكُمْ","they seek your help","حَتَّىٰ يُهَاجِرُوا۟ ۚ وَإِنِ","فِى ٱلدِّينِ فَعَلَيْكُمُ",2849],["8:72:35",186,"ٱلنَّصْرُ","(is to) help them","فِى ٱلدِّينِ فَعَلَيْكُمُ","إِلَّا عَلَىٰ قَوْمٍۭ",472],["8:74:10",186,"وَّنَصَرُوٓا۟","and helped","ٱللَّهِ وَٱلَّذِينَ ءَاوَوا۟","أُو۟لَـٰٓئِكَ هُمُ ٱلْمُؤْمِنُونَ",202],["9:14:6",189,"وَيَنصُرْكُمْ","and give you victory","ٱللَّهُ بِأَيْدِيكُمْ وَيُخْزِهِمْ","عَلَيْهِمْ وَيَشْفِ صُدُورَ",202],["9:25:2",190,"نَصَرَكُمُ","Allah helped you","لَقَدْ","ٱللَّهُ فِى مَوَاطِنَ",202],["9:30:7",191,"ٱلنَّصَـٰرَى","the Christians","ٱبْنُ ٱللَّهِ وَقَ