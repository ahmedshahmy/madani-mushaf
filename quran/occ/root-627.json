[["3:14:13",51,"وَٱلْخَيْلِ","and [the] horses","مِنَ ٱلذَّهَبِ وَٱلْفِضَّةِ","ٱلْمُسَوَّمَةِ وَٱلْأَنْعَـٰمِ وَٱلْحَرْثِ ۗ",1421],["4:36:31",84,"مُخْتَالًۭا","[a] proud","يُحِبُّ مَن كَانَ","فَخُورًا",1919],["8:60:9",184,"ٱلْخَيْلِ","horses","قُوَّةٍۢ وَمِن رِّبَاطِ","تُرْهِبُونَ بِهِۦ عَدُوَّ",1421],["16:8:1",268,"وَٱلْخَيْلَ","And horses","","وَٱلْبِغَالَ وَٱلْحَمِيرَ لِتَرْكَبُوهَا",1421],["17:64:8",288,"بِخَيْلِكَ","with your cavalry","بِصَوْتِكَ وَأَجْلِبْ عَلَيْهِم","وَرَجِلِكَ وَشَارِكْهُمْ فِى",1421],["20:66:7",316,"يُخَيَّلُ","seemed","فَإِذَا حِبَالُهُمْ وَعِصِيُّهُمْ","إِلَيْهِ مِن سِحْرِهِمْ",4744],["31:18:15",412,"مُخْتَالٍۢ","self-conceited","لَا يُحِبُّ كُلَّ","فَخُورٍۢ",1919],["57:23:14",540,"مُخْتَالٍۢ","self-deluded","لَا يُحِبُّ كُلَّ","فَخُورٍ",1919],["59:6:11",546,"خَيْلٍۢ","horses","أَوْجَفْتُمْ عَلَيْهِ مِنْ","وَلَا رِكَابٍۢ وَلَـٰكِنَّ",1421]]