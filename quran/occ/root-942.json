[["25:53:10",364,"أُجَاجٌۭ","(and) bitter","فُرَاتٌۭ وَهَـٰذَا مِلْحٌ","وَجَعَلَ بَيْنَهُمَا بَرْزَخًۭا",1751],["35:12:11",436,"أُجَاجٌۭ ۖ","(and) bitter","شَرَابُهُۥ وَهَـٰذَا مِلْحٌ","وَمِن كُلٍّۢ تَأْكُلُونَ",1751],["56:70:4",536,"أُجَاجًۭا","salty","لَوْ نَشَآءُ جَعَلْنَـٰهُ","فَلَوْلَا تَشْكُرُونَ",1751]]