[["3:37:8",54,"وَكَفَّلَهَا","and put her in (the) care","وَأَنۢبَتَهَا نَبَاتًا حَسَنًۭا","زَكَرِيَّا ۖ كُلَّمَا دَخَلَ",3566],["3:44:14",55,"يَكْفُلُ","takes charge (of)","يُلْقُونَ أَقْلَـٰمَهُمْ أَيُّهُمْ","مَرْيَمَ وَمَا كُنتَ",2057],["4:85:15",91,"كِفْلٌۭ","a portion","سَيِّئَةًۭ يَكُن لَّهُۥ","مِّنْهَا ۗ وَكَانَ ٱللَّهُ",1570],["16:91:15",277,"كَفِيلًا ۚ","a surety","جَعَلْتُمُ ٱللَّهَ عَلَيْكُمْ","إِنَّ ٱللَّهَ يَعْلَمُ",3565],["20:40:9",314,"يَكْفُلُهُۥ ۖ","will nurse and rear him","أَدُلُّكُمْ عَلَىٰ مَن","فَرَجَعْنَـٰكَ إِلَىٰٓ أُمِّكَ",2057],["21:85:4",329,"ٱلْكِفْلِ ۖ","and Dhul-Kifl","وَإِسْمَـٰعِيلَ وَإِدْرِيسَ وَذَا","كُلٌّۭ مِّنَ ٱلصَّـٰبِرِينَ",1570],["28:12:12",386,"يَكْفُلُونَهُۥ","who will rear him","عَلَىٰٓ أَهْلِ بَيْتٍۢ","لَكُمْ وَهُمْ لَهُۥ",2057],["38:23:12",454,"أَكْفِلْنِيهَا","Entrust her to me","نَعْجَةٌۭ وَٰحِدَةٌۭ فَقَالَ","وَعَزَّنِى فِى ٱلْخِطَابِ",3000],["38:48:5",456,"ٱلْكِفْلِ ۖ","and Dhul-kifl","إِسْمَـٰعِيلَ وَٱلْيَسَعَ وَذَا","وَكُلٌّۭ مِّنَ ٱلْأَخْيَارِ",1570],["57:28:9",541,"كِفْلَيْنِ","double portion","وَءَامِنُوا۟ بِرَسُولِهِۦ يُؤْتِكُمْ","مِن رَّحْمَتِهِۦ وَيَجْعَل",1570]]