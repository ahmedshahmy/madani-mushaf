[["6:152:14",149,"وَٱلْمِيزَانَ","and the weight","أَشُدَّهُۥ ۖ وَأَوْفُوا۟ ٱلْكَيْلَ","بِٱلْقِسْطِ ۖ لَا نُكَلِّفُ",599],["7:8:1",151,"وَٱلْوَزْنُ","And the weighing","","يَوْمَئِذٍ ٱلْحَقُّ ۚ فَمَن",2028],["7:8:6",151,"مَوَٰزِينُهُۥ","his scales","ٱلْحَقُّ ۚ فَمَن ثَقُلَتْ","فَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ",599],["7:9:3",151,"مَوَٰزِينُهُۥ","his scales","وَمَنْ خَفَّتْ","فَأُو۟لَـٰٓئِكَ ٱلَّذِينَ خَسِرُوٓا۟",599],["7:85:21",161,"وَٱلْمِيزَانَ","and the weight","رَّبِّكُمْ ۖ فَأَوْفُوا۟ ٱلْكَيْلَ","وَلَا تَبْخَسُوا۟ ٱلنَّاسَ",599],["11:84:17",231,"وَٱلْمِيزَانَ ۚ","and the scale","وَلَا تَنقُصُوا۟ ٱلْمِكْيَالَ","إِنِّىٓ أَرَىٰكُم بِخَيْرٍۢ",599],["11:85:4",231,"وَٱلْمِيزَانَ","and weight","وَيَـٰقَوْمِ أَوْفُوا۟ ٱلْمِكْيَالَ","بِٱلْقِسْطِ ۖ وَلَا تَبْخَسُوا۟",599],["15:19:11",263,"مَّوْزُونٍۢ","well-balanced","مِن كُلِّ شَىْءٍۢ","",3941],["17:35:5",285,"وَزِنُوا۟","and weigh","ٱلْكَيْلَ إِذَا كِلْتُمْ","بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ ۚ ذَٰلِكَ",2031],["18:105:14",304,"وَزْنًۭا","any weight","لَهُمْ يَوْمَ ٱلْقِيَـٰمَةِ","",2028],["21:47:2",326,"ٱلْمَوَٰزِينَ","the scales","وَنَضَعُ","ٱلْقِسْطَ لِيَوْمِ ٱلْقِيَـٰمَةِ",599],["23:102:3",348,"مَوَٰزِينُهُۥ","his scales","فَمَن ثَقُلَتْ","فَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ",599],["23:103:3",348,"مَوَٰزِينُهُۥ","his scales","وَمَنْ خَفَّتْ","فَأُو۟لَـٰٓئِكَ ٱلَّذِينَ خَسِرُوٓا۟",599],["26:182:1",374,"وَزِنُوا۟","And weigh","","بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ",2031],["42:17:6",485,"وَٱلْمِيزَانَ ۗ","and the Balance","أَنزَلَ ٱلْكِتَـٰبَ بِٱلْحَقِّ","وَمَا يُدْرِيكَ لَعَلَّ",599],["55:7:4",531,"ٱلْمِيزَانَ","the balance","وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ","",599],["55:8:4",531,"ٱلْمِيزَانِ","the balance","أَلَّا تَطْغَوْا۟ فِى","",599],["55:9:2",531,"ٱلْوَزْنَ","the weight","وَأَقِيمُوا۟","بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟",2028],["55:9:6",531,"ٱلْمِيزَانَ","the balance","بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟","",599],["57:25:8",541,"وَٱلْمِيزَانَ","and the Balance","وَأَنزَلْنَا مَعَهُمُ ٱلْكِتَـٰبَ","لِيَقُومَ ٱلنَّاسُ بِٱلْقِسْطِ