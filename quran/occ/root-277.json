[["3:191:7",75,"جُنُوبِهِمْ","their sides","قِيَـٰمًۭا وَقُعُودًۭا وَعَلَىٰ","وَيَتَفَكَّرُونَ فِى خَلْقِ",977],["4:31:2",83,"تَجْتَنِبُوا۟","you avoid","إِن","كَبَآئِرَ مَا تُنْهَوْنَ",944],["4:36:17",84,"ٱلْجُنُبِ","(who is) farther away","ذِى ٱلْقُرْبَىٰ وَٱلْجَارِ","وَٱلصَّاحِبِ بِٱلْجَنۢبِ وَٱبْنِ",1563],["4:36:19",84,"بِٱلْجَنۢبِ","by your side","وَٱلْجَارِ ٱلْجُنُبِ وَٱلصَّاحِبِ","وَٱبْنِ ٱلسَّبِيلِ وَمَا",977],["4:43:14",85,"جُنُبًا","(when you are) impure","مَا تَقُولُونَ وَلَا","إِلَّا عَابِرِى سَبِيلٍ",1563],["4:103:9",95,"جُنُوبِكُمْ ۚ","your sides","قِيَـٰمًۭا وَقُعُودًۭا وَعَلَىٰ","فَإِذَا ٱطْمَأْنَنتُمْ فَأَقِيمُوا۟",977],["5:6:20",108,"جُنُبًۭا","(in) a state of ceremonial impurity","ٱلْكَعْبَيْنِ ۚ وَإِن كُنتُمْ","فَٱطَّهَّرُوا۟ ۚ وَإِن كُنتُم",1563],["5:90:13",122,"فَٱجْتَنِبُوهُ","so avoid it","مِّنْ عَمَلِ ٱلشَّيْطَـٰنِ","لَعَلَّكُمْ تُفْلِحُونَ",944],["9:35:10",192,"وَجُنُوبُهُمْ","and their flanks","فَتُكْوَىٰ بِهَا جِبَاهُهُمْ","وَظُهُورُهُمْ ۖ هَـٰذَا مَا",977],["10:12:6",209,"لِجَنۢبِهِۦٓ","(lying) on his side","ٱلْإِنسَـٰنَ ٱلضُّرُّ دَعَانَا","أَوْ قَاعِدًا أَوْ",977],["14:35:9",260,"وَٱجْنُبْنِى","and keep me away","هَـٰذَا ٱلْبَلَدَ ءَامِنًۭا","وَبَنِىَّ أَن نَّعْبُدَ",4797],["16:36:10",271,"وَٱجْتَنِبُوا۟","and avoid","أَنِ ٱعْبُدُوا۟ ٱللَّهَ","ٱلطَّـٰغُوتَ ۖ فَمِنْهُم مَّنْ",944],["17:68:5",289,"جَانِبَ","side","أَن يَخْسِفَ بِكُمْ","ٱلْبَرِّ أَوْ يُرْسِلَ",904],["17:83:7",290,"بِجَانِبِهِۦ ۖ","on his side","ٱلْإِنسَـٰنِ أَعْرَضَ وَنَـَٔا","وَإِذَا مَسَّهُ ٱلشَّرُّ",904],["19:52:3",309,"جَانِبِ","(the) side","وَنَـٰدَيْنَـٰهُ مِن","ٱلطُّورِ ٱلْأَيْمَنِ وَقَرَّبْنَـٰهُ",904],["20:80:8",317,"جَانِبَ","on (the) side","مِّنْ عَدُوِّكُمْ وَوَٰعَدْنَـٰكُمْ","ٱلطُّورِ ٱلْأَيْمَنَ وَنَزَّلْنَا",904],["22:30:18",335,"فَٱجْتَنِبُوا۟","So avoid","مَا يُتْلَىٰ عَلَيْكُمْ ۖ","ٱلرِّجْسَ مِنَ ٱلْأَوْثَـٰنِ",944],["22:30:22",335,"وَٱجْتَنِبُوا۟","and avoid","ٱلرِّجْسَ مِنَ ٱلْأَوْثَـٰنِ","قَوْلَ ٱلزُّورِ",944],["22:36:17",336,"جُنُوبُهَا","their sides","صَوَآفَّ ۖ فَإِذَا وَجَبَتْ","فَكُلُوا۟ مِنْهَا وَأَطْعِمُوا۟",977],["28:11:7",386,"جُنُبٍۢ","a distance","فَبَصُرَتْ بِهِۦ عَن","وَهُمْ لَا يَشْعُرُونَ",1563],["28:29:9",389,"جَانِبِ","(the) direction","بِأَهْلِهِۦٓ ءَانَسَ مِن","ٱلطُّورِ نَارًۭا قَالَ",904],["28:44:3",391,"بِجَانِبِ","on (the) side","وَمَا كُنتَ","ٱلْغَرْبِىِّ إِذْ قَضَيْنَآ",904],["28:46:3",391,"بِجَانِبِ","at (the) side","وَمَا كُنتَ","ٱلطُّورِ إِذْ نَادَيْنَا",904],["32:16:2",416,"جُنُوبُهُمْ","their sides","تَتَجَافَىٰ","عَنِ ٱلْمَضَاجِعِ يَدْعُونَ",977],["37:8:9",446,"جَانِبٍۢ","side","وَيُقْذَفُونَ مِن كُلِّ","",904],["39:17:2",460,"ٱجْتَنَبُوا۟","avoid","وَٱلَّذِينَ","ٱلطَّـٰغُوتَ أَن يَعْبُدُوهَا",944],["39:56:9",464,"جَنۢبِ","regard (to)","مَا فَرَّطتُ فِى","ٱللَّهِ وَإِن كُنتُ",977],["41:51:7",482,"بِجَانِبِهِۦ","and distances himself","ٱلْإِنسَـٰنِ أَعْرَضَ وَنَـَٔا","وَإِذَا مَسَّهُ ٱلشَّرُّ",904],["42:37:2",487,"يَجْتَنِبُونَ","avoid","وَٱلَّذِينَ","كَبَـٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ",944],["49:12:4",517,"ٱجْتَنِبُوا۟","Avoid","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","كَثِيرًۭا مِّنَ ٱلظَّنِّ",944],["53:32:2",527,"يَجْتَنِبُونَ","avoid","ٱلَّذِينَ","كَبَـٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ",944],["87:11:1",592,"وَيَتَجَنَّبُهَا","And will avoid it","","ٱلْأَشْقَى",4678],["92:17:1",596,"وَسَيُجَنَّبُهَا","But will be removed from it","","ٱلْأَتْقَى",4723]]