[["2:214:16",33,"وَزُلْزِلُوا۟","and they were shaken","مَّسَّتْهُمُ ٱلْبَأْسَآءُ وَٱلضَّرَّآءُ","حَتَّىٰ يَقُولَ ٱلرَّسُولُ",2096],["22:1:6",332,"زَلْزَلَةَ","(the) convulsion","ٱتَّقُوا۟ رَبَّكُمْ ۚ إِنَّ","ٱلسَّاعَةِ شَىْءٌ عَظِيمٌۭ",4756],["33:11:4",419,"وَزُلْزِلُوا۟","and shaken","هُنَالِكَ ٱبْتُلِىَ ٱلْمُؤْمِنُونَ","زِلْزَالًۭا شَدِيدًۭا",2096],["33:11:5",419,"زِلْزَالًۭا","(with a) shake","ٱبْتُلِىَ ٱلْمُؤْمِنُونَ وَزُلْزِلُوا۟","شَدِيدًۭا",2824],["99:1:2",599,"زُلْزِلَتِ","is shaken","إِذَا","ٱلْأَرْضُ زِلْزَالَهَا",2096],["99:1:4",599,"زِلْزَالَهَا","(with) its earthquake","إِذَا زُلْزِلَتِ ٱلْأَرْضُ","",2824]]