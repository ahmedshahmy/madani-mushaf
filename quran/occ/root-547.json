[["4:155:15",103,"طَبَعَ","(has) set a seal","قُلُوبُنَا غُلْفٌۢ ۚ بَلْ","ٱللَّهُ عَلَيْهَا بِكُفْرِهِمْ",776],["7:100:14",163,"وَنَطْبَعُ","and We put a seal","نَشَآءُ أَصَبْنَـٰهُم بِذُنُوبِهِمْ ۚ","عَلَىٰ قُلُوبِهِمْ فَهُمْ",776],["7:101:19",163,"يَطْبَعُ","(has been) put a seal","مِن قَبْلُ ۚ كَذَٰلِكَ","ٱللَّهُ عَلَىٰ قُلُوبِ",776],["9:87:6",201,"وَطُبِعَ","and were sealed","يَكُونُوا۟ مَعَ ٱلْخَوَالِفِ","عَلَىٰ قُلُوبِهِمْ فَهُمْ",776],["9:93:13",201,"وَطَبَعَ","and Allah sealed","يَكُونُوا۟ مَعَ ٱلْخَوَالِفِ","ٱللَّهُ عَلَىٰ قُلُوبِهِمْ",776],["10:74:19",217,"نَطْبَعُ","We seal","مِن قَبْلُ ۚ كَذَٰلِكَ","عَلَىٰ قُلُوبِ ٱلْمُعْتَدِينَ",776],["16:108:3",279,"طَبَعَ","Allah has set a seal","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","ٱللَّهُ عَلَىٰ قُلُوبِهِمْ",776],["30:59:2",410,"يَطْبَعُ","Allah seals","كَذَٰلِكَ","ٱللَّهُ عَلَىٰ قُلُوبِ",776],["40:35:17",471,"يَطْبَعُ","Allah sets a seal","ٱلَّذِينَ ءَامَنُوا۟ ۚ كَذَٰلِكَ","ٱللَّهُ عَلَىٰ كُلِّ",776],["47:16:19",508,"طَبَعَ","Allah has set a seal","ءَانِفًا ۚ أُو۟لَـٰٓئِكَ ٱلَّذِينَ","ٱللَّهُ عَلَىٰ قُلُوبِهِمْ",776],["63:3:6",554,"فَطُبِعَ","so were sealed","ءَامَنُوا۟ ثُمَّ كَفَرُوا۟","عَلَىٰ قُلُوبِهِمْ فَهُمْ",776]]