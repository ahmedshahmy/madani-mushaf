[["2:158:17",24,"بِهِمَا ۚ","between [both of] them","عَلَيْهِ أَن يَطَّوَّفَ","وَمَن تَطَوَّعَ خَيْرًۭا",612],["4:135:22",100,"بِهِمَا ۖ","to both of them","فَقِيرًۭا فَٱللَّهُ أَوْلَىٰ","فَلَا تَتَّبِعُوا۟ ٱلْهَوَىٰٓ",612],["4:176:29",106,"فَلَهُمَا","then for them","فَإِن كَانَتَا ٱثْنَتَيْنِ","ٱلثُّلُثَانِ مِمَّا تَرَكَ ۚ",612],["7:20:2",152,"لَهُمَا","to both of them","فَوَسْوَسَ","ٱلشَّيْطَـٰنُ لِيُبْدِىَ لَهُمَا",612],["7:20:5",152,"لَهُمَا","to both of them","لَهُمَا ٱلشَّيْطَـٰنُ لِيُبْدِىَ","مَا وُۥرِىَ عَنْهُمَا",612],["7:22:7",152,"لَهُمَا","to both of them","ذَاقَا ٱلشَّجَرَةَ بَدَتْ","سَوْءَٰتُهُمَا وَطَفِقَا يَخْصِفَانِ",612],["9:40:13",193,"هُمَا","they both","ثَانِىَ ٱثْنَيْنِ إِذْ","فِى ٱلْغَارِ إِذْ",612],["17:23:18",284,"لَّهُمَآ","to both of them","كِلَاهُمَا فَلَا تَقُل","أُفٍّۢ وَلَا تَنْهَرْهُمَا",612],["17:23:23",284,"لَّهُمَا","to them","وَلَا تَنْهَرْهُمَا وَقُل","قَوْلًۭا كَرِيمًۭا",612],["17:24:2",284,"لَهُمَا","to them","وَٱخْفِضْ","جَنَاحَ ٱلذُّلِّ مِنَ",612],["18:82:11",302,"لَّهُمَا","for them","وَكَانَ تَحْتَهُۥ كَنزٌۭ","وَكَانَ أَبُوهُمَا صَـٰلِحًۭا",612],["20:121:4",320,"لَهُمَا","to them","فَأَكَلَا مِنْهَا فَبَدَتْ","سَوْءَٰتُهُمَا وَطَفِقَا يَخْصِفَانِ",612],["24:2:11",350,"بِهِمَا","pity for them","جَلْدَةٍۢ ۖ وَلَا تَأْخُذْكُم","رَأْفَةٌۭ فِى دِينِ",612],["28:19:9",387,"لَّهُمَا","to both of them","بِٱلَّذِى هُوَ عَدُوٌّۭ","قَالَ يَـٰمُوسَىٰٓ أَتُرِيدُ",612],["28:24:2",388,"لَهُمَا","for them","فَسَقَىٰ","ثُمَّ تَوَلَّىٰٓ إِلَى",612],["46:17:14",504,"وَهُمَا","And they both","ٱلْقُرُونُ مِن قَبْلِى","يَسْتَغِيثَانِ ٱللَّهَ وَيْلَكَ",612]]