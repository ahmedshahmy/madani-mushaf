[["10:22:20",211,"عَاصِفٌۭ","stormy","بِهَا جَآءَتْهَا رِيحٌ","وَجَآءَهُمُ ٱلْمَوْجُ مِن",2224],["14:18:12",257,"عَاصِفٍۢ ۖ","stormy","ٱلرِّيحُ فِى يَوْمٍ","لَّا يَقْدِرُونَ مِمَّا",2224],["21:81:3",328,"عَاصِفَةًۭ","forcefully","وَلِسُلَيْمَـٰنَ ٱلرِّيحَ","تَجْرِى بِأَمْرِهِۦٓ إِلَى",3089],["55:12:3",531,"ٱلْعَصْفِ","husk","وَٱلْحَبُّ ذُو","وَٱلرَّيْحَانُ",2231],["77:2:1",580,"فَٱلْعَـٰصِفَـٰتِ","And the winds that blow","","عَصْفًۭا",3102],["77:2:2",580,"عَصْفًۭا","violently","فَٱلْعَـٰصِفَـٰتِ","",3100],["105:5:2",601,"كَعَصْفٍۢ","like straw","فَجَعَلَهُمْ","مَّأْكُولٍۭ",2231]]