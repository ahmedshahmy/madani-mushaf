[["2:41:9",7,"أَوَّلَ","(the) first","مَعَكُمْ وَلَا تَكُونُوٓا۟","كَافِرٍۭ بِهِۦ ۖ وَلَا",137],["2:49:4",8,"ءَالِ","(the) people","وَإِذْ نَجَّيْنَـٰكُم مِّنْ","فِرْعَوْنَ يَسُومُونَكُمْ سُوٓءَ",410],["2:50:7",8,"ءَالَ","(the) people","ٱلْبَحْرَ فَأَنجَيْنَـٰكُمْ وَأَغْرَقْنَآ","فِرْعَوْنَ وَأَنتُمْ تَنظُرُونَ",410],["2:179:5",27,"يَـٰٓأُو۟لِى","O men","فِى ٱلْقِصَاصِ حَيَوٰةٌۭ","ٱلْأَلْبَـٰبِ لَعَلَّكُمْ تَتَّقُونَ",257],["2:197:28",31,"يَـٰٓأُو۟لِى","O men","ٱلزَّادِ ٱلتَّقْوَىٰ ۚ وَٱتَّقُونِ","ٱلْأَلْبَـٰبِ",257],["2:248:17",40,"ءَالُ","(by the) family","وَبَقِيَّةٌۭ مِّمَّا تَرَكَ","مُوسَىٰ وَءَالُ هَـٰرُونَ",410],["2:248:19",40,"وَءَالُ","and family","تَرَكَ ءَالُ مُوسَىٰ","هَـٰرُونَ تَحْمِلُهُ ٱلْمَلَـٰٓئِكَةُ ۚ",410],["2:269:15",45,"أُو۟لُوا۟","those","وَمَا يَذَّكَّرُ إِلَّآ","ٱلْأَلْبَـٰبِ",257],["3:7:26",50,"تَأْوِيلِهِۦ ۗ","its interpretation","ٱبْتِغَآءَ ٱلْفِتْنَةِ وَٱبْتِغَآءَ","وَمَا يَعْلَمُ تَأْوِيلَهُۥٓ",579],["3:7:29",50,"تَأْوِيلَهُۥٓ","its interpretation","تَأْوِيلِهِۦ ۗ وَمَا يَعْلَمُ","إِلَّا ٱللَّهُ ۗ وَٱلرَّٰسِخُونَ",579],["3:7:45",50,"أُو۟لُوا۟","men","وَمَا يَذَّكَّرُ إِلَّآ","ٱلْأَلْبَـٰبِ",257],["3:11:2",51,"ءَالِ","(of the) people","كَدَأْبِ","فِرْعَوْنَ وَٱلَّذِينَ مِن",410],["3:13:28",51,"لِّأُو۟لِى","for the owners","فِى ذَٰلِكَ لَعِبْرَةًۭ","ٱلْأَبْصَـٰرِ",257],["3:18:9",52,"وَأُو۟لُوا۟","and owners","إِلَّا هُوَ وَٱلْمَلَـٰٓئِكَةُ","ٱلْعِلْمِ قَآئِمًۢا بِٱلْقِسْطِ ۚ",257],["3:33:6",54,"وَءَالَ","and (the) family","ٱصْطَفَىٰٓ ءَادَمَ وَنُوحًۭا","إِبْرَٰهِيمَ وَءَالَ عِمْرَٰنَ",410],["3:33:8",54,"وَءَالَ","and (the) family","وَنُوحًۭا وَءَالَ إِبْرَٰهِيمَ","عِمْرَٰنَ عَلَى ٱلْعَـٰلَمِينَ",410],["3:96:2",62,"أَوَّلَ","(the) First","إِنَّ","بَيْتٍۢ وُضِعَ لِلنَّاسِ",137],["3:190:10",75,"لِّأُو۟لِى","for men","ٱلَّيْلِ وَٱلنَّهَارِ لَـَٔايَـٰتٍۢ","ٱلْأَلْبَـٰبِ",257],["4:8:4",78,"أُو۟لُوا۟","(of)","وَإِذَا حَضَرَ ٱلْقِسْمَةَ","ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينُ",257],["4:54:12",87,"ءَالَ","(the) family","فَضْلِهِۦ ۖ فَقَدْ ءَاتَيْنَآ","إِبْرَٰهِيمَ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ",410],["4:59:8",87,"وَأُو۟لِى","and those","ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ","ٱلْأَمْرِ مِنكُمْ ۖ فَإِن",257],["4:59:28",87,"تَأْوِيلًا","(for final) determination","ذَٰلِكَ خَيْرٌۭ وَأَحْسَنُ","",579],["4:83:15",91,"أُو۟لِى","those","إِلَى ٱلرَّسُولِ وَإِلَىٰٓ","ٱلْأَمْرِ مِنْهُمْ لَعَلِمَهُ",257],["4:95:7",94,"أُو۟لِى","the ones (who are)","مِنَ ٱلْمُؤْمِنِينَ غَيْرُ","ٱلضَّرَرِ وَٱلْمُجَـٰهِدُونَ فِى",257],["5:100:12",124,"يَـٰٓأُو۟لِى","O men","ٱلْخَبِيثِ ۚ فَٱتَّقُوا۟ ٱللَّهَ","ٱلْأَلْبَـٰبِ لَعَلَّكُمْ تُفْلِحُونَ",257],["5:114:15",127,"لِّأَوَّلِنَا","for first of us","تَكُونُ لَنَا عِيدًۭا","وَءَاخِرِنَا وَءَايَةًۭ مِّنكَ ۖ",137],["6:14:18",129,"أَوَّلَ","(the) first","أُمِرْتُ أَنْ أَكُونَ","مَنْ أَسْلَمَ ۖ وَلَا",137],["6:25:32",130,"ٱلْأَوَّلِينَ","(of) the former (people)","هَـٰذَآ إِلَّآ أَسَـٰطِيرُ","",137],["6:94:6",139,"أَوَّلَ","(the) first","فُرَٰدَىٰ كَمَا خَلَقْنَـٰكُمْ","مَرَّةٍۢ وَتَرَكْتُم مَّا",137],["6:110:8",141,"أَوَّلَ","(the) first","لَمْ يُؤْمِنُوا۟ بِهِۦٓ","مَرَّةٍۢ وَنَذَرُهُمْ فِى",137],["6:163:7",150,"أَوَّلُ","(the) first","وَبِذَٰلِكَ أُمِرْتُ وَأَنَا۠","ٱلْمُسْلِمِينَ",137],["7:38:26",155,"لِأُولَىٰهُمْ","about the first of them","جَمِيعًۭا قَالَتْ أُخْرَىٰهُمْ","رَبَّنَا هَـٰٓؤُلَآءِ أَضَلُّونَا",137],["7:39:2",155,"أُولَىٰهُمْ","(the) first of them","وَقَالَتْ","لِأُخْرَىٰهُمْ فَمَا كَانَ",137],["7:53:4",157,"تَأْوِيلَهُۥ ۚ","(for) its fulfillment","هَلْ يَنظُرُونَ إِلَّا","يَوْمَ يَأْتِى تَأْوِيلُهُۥ",579],["7:53:7",157,"تَأْوِيلُهُۥ","its fulfillment","تَأْوِيلَهُۥ ۚ يَوْمَ يَأْتِى","يَقُولُ ٱلَّذِينَ نَسُوهُ",579],["7:130:3",165,"ءَالَ","(the) people","وَلَقَدْ أَخَذْنَآ","فِرْعَوْنَ بِٱلسِّنِينَ وَنَقْصٍۢ",410],["7:141:4",167,"ءَالِ","(the) people","وَإِذْ أَنجَيْنَـٰكُم مِّنْ","فِرْعَوْنَ يَسُومُونَكُمْ سُوٓءَ",410],["7:143:40",167,"أَوَّلُ","(the) first","تُبْتُ إِلَيْكَ وَأَنَا۠","ٱلْمُؤْمِنِينَ",137],["8:31:17",180,"ٱلْأَوَّلِينَ","(of) the former (people)","هَـٰذَآ إِلَّآ أَسَـٰطِيرُ","",137],["8:38:16",181,"ٱلْأَوَّلِينَ","(of) the former (people)","فَقَدْ مَضَتْ سُنَّتُ","",137],["8:52:2",183,"ءَالِ","(of) people","كَدَأْبِ","فِرْعَوْنَ ۙ وَٱلَّذِينَ مِن",410],["8:54:2",184,"ءَالِ","(of) people","كَدَأْبِ","فِرْعَوْنَ ۙ وَٱلَّذِينَ مِن",410],["8:54:13",184,"ءَالَ","(the) people","فَأَهْلَكْنَـٰهُم بِذُنُوبِهِمْ وَأَغْرَقْنَآ","فِرْعَوْنَ ۚ وَكُلٌّۭ كَانُوا۟",410],["8:75:10",186,"وَأُو۟لُوا۟","But those","مَعَكُمْ فَأُو۟لَـٰٓئِكَ مِنكُمْ ۚ","ٱلْأَرْحَامِ بَعْضُهُمْ أَوْلَىٰ",257],["9:13:11",188,"أَوَّلَ","first","ٱلرَّسُولِ وَهُم بَدَءُوكُمْ","مَرَّةٍ ۚ أَتَخْشَوْنَهُمْ ۚ فَٱللَّهُ",137],["9:83:21",200,"أَوَّلَ","(the) first","إِنَّكُمْ رَضِيتُم بِٱلْقُعُودِ","مَرَّةٍۢ فَٱقْعُدُوا۟ مَعَ",137],["9:86:11",200,"أُو۟لُوا۟","(the) men","مَعَ رَسُولِهِ ٱسْتَـْٔذَنَكَ","ٱلطَّوْلِ مِنْهُمْ وَقَالُوا۟",257],["9:100:2",203,"ٱلْأَوَّلُونَ","the first","وَٱلسَّـٰبِقُونَ","مِنَ ٱلْمُهَـٰجِرِينَ وَٱلْأَنصَارِ",137],["9:108:10",204,"أَوَّلِ","(the) first","عَلَى ٱلتَّقْوَىٰ مِنْ","يَوْمٍ أَحَقُّ أَن",137],["9:113:11",205,"أُو۟لِى","near of kin","لِلْمُشْرِكِينَ وَلَوْ كَانُوٓا۟","قُرْبَىٰ مِنۢ بَعْدِ",257],["10:39:9",213,"تَأْوِيلُهُۥ ۚ","its interpretation","بِعِلْمِهِۦ وَلَمَّا يَأْتِهِمْ","كَذَٰلِكَ كَذَّبَ ٱلَّذِينَ",579],["11:116:7",234,"أُو۟لُوا۟","those possessing a remnant","ٱلْقُرُونِ مِن قَبْلِكُمْ","بَقِيَّةٍۢ يَنْهَوْنَ عَنِ",257],["12:6:6",236,"تَأْوِيلِ","(the) interpretation","رَبُّكَ وَيُعَلِّمُكَ مِن","ٱلْأَحَادِيثِ وَيُتِمُّ نِعْمَتَهُۥ",579],["12:6:12",236,"ءَالِ","(the) family","نِعْمَتَهُۥ عَلَيْكَ وَعَلَىٰٓ","يَعْقُوبَ كَمَآ أَتَمَّهَا",410],["12:21:22",237,"تَأْوِيلِ","(the) interpretation of","ٱلْأَرْضِ وَلِنُعَلِّمَهُۥ مِن","ٱلْأَحَادِيثِ ۚ وَٱللَّهُ غَالِبٌ",579],["12:36:23",239,"بِتَأْوِيلِهِۦٓ ۖ","of its interpretation","ٱلطَّيْرُ مِنْهُ ۖ نَبِّئْنَا","إِنَّا نَرَىٰكَ مِنَ",579],["12:37:8",239,"بِتَأْوِيلِهِۦ","of its interpretation","تُرْزَقَانِهِۦٓ إِلَّا نَبَّأْتُكُمَا","قَبْلَ أَن يَأْتِيَكُمَا ۚ",579],["12:44:6",241,"بِتَأْوِيلِ","(are) in the interpretation","أَحْلَـٰمٍۢ ۖ وَمَا نَحْنُ","ٱلْأَحْلَـٰمِ بِعَـٰلِمِينَ",579],["12:45:10",241,"بِتَأْوِيلِهِۦ","of its interpretation","أُمَّةٍ أَنَا۠ أُنَبِّئُكُم","فَأَرْسِلُونِ",579],["12:100:11",247,"تَأْوِيلُ","(is the) interpretation","وَقَالَ يَـٰٓأَبَتِ هَـٰذَا","رُءْيَـٰىَ مِن قَبْلُ",579],["12:101:8",247,"تَأْوِيلِ","the interpretation","ٱلْمُلْكِ وَعَلَّمْتَنِى مِن","ٱلْأَحَادِيثِ ۚ فَاطِرَ ٱلسَّمَـٰوَٰتِ",579],["12:111:6",248,"لِّأُو۟لِى","for men","فِى قَصَصِهِمْ عِبْرَةٌۭ","ٱلْأَلْبَـٰبِ ۗ مَا كَانَ",257],["13:19:14",252,"أُو۟لُوا۟","men","أَعْمَىٰٓ ۚ إِنَّمَا يَتَذَكَّرُ","ٱلْأَلْبَـٰبِ",257],["14:6:12",256,"ءَالِ","(the) people","إِذْ أَنجَىٰكُم مِّنْ","فِرْعَوْنَ يَسُومُونَكُمْ سُوٓءَ",410],["14:52:12",261,"أُو۟لُوا۟","men","إِلَـٰهٌۭ وَٰحِدٌۭ وَلِيَذَّكَّرَ","ٱلْأَلْبَـٰبِ",257],["15:10:7",262,"ٱلْأَوَّلِينَ","(of) the former (people)","قَبْلِكَ فِى شِيَعِ","",137],["15:13:7",262,"ٱلْأَوَّلِينَ","(of) the former (people)","وَقَدْ خَلَتْ سُنَّةُ","",137],["15:59:2",265,"ءَالَ","the family","إِلَّآ","لُوطٍ إِنَّا لَمُنَجُّوهُمْ",410],["15:61:3",265,"ءَالَ","(to the) family","فَلَمَّا جَآءَ","لُوطٍ ٱلْمُرْسَلُونَ",410],["16:24:9",269,"ٱلْأَوَّلِينَ","(of) the ancient","رَبُّكُمْ ۙ قَالُوٓا۟ أَسَـٰطِيرُ","",137],["17:5:4",282,"أُولَىٰهُمَا","(for) the first of the two","فَإِذَا جَآءَ وَعْدُ","بَعَثْنَا عَلَيْكُمْ عِبَادًۭا",137],["17:5:9",282,"أُو۟لِى","those of great military might","عَلَيْكُمْ عِبَادًۭا لَّنَآ","بَأْسٍۢ شَدِيدٍۢ فَجَاسُوا۟",257],["17:7:18",282,"أَوَّلَ","first","ٱلْمَسْجِدَ كَمَا دَخَلُوهُ","مَرَّةٍۢ وَلِيُتَبِّرُوا۟ مَا",137],["17:35:11",285,"تَأْوِيلًۭا","(in) result","ذَٰلِكَ خَيْرٌۭ وَأَحْسَنُ","",579],["17:51:13",287,"أَوَّلَ","(the) first","قُلِ ٱلَّذِى فَطَرَكُمْ","مَرَّةٍۢ ۚ فَسَيُنْغِضُونَ إِلَيْكَ",137],["17:59:10",288,"ٱلْأَوَّلُونَ ۚ","the former (people)","أَن كَذَّبَ بِهَا","وَءَاتَيْنَا ثَمُودَ ٱلنَّاقَةَ",137],["18:48:9",299,"أَوَّلَ","the first","جِئْتُمُونَا كَمَا خَلَقْنَـٰكُمْ","مَرَّةٍۭ ۚ بَلْ زَعَمْتُمْ",137],["18:55:15",300,"ٱلْأَوَّلِينَ","(of) the former (people)","أَن تَأْتِيَهُمْ سُنَّةُ","أَوْ يَأْتِيَهُمُ ٱلْعَذَابُ",137],["18:78:7",302,"بِتَأْوِيلِ","of (the) interpretation","بَيْنِى وَبَيْنِكَ ۚ سَأُنَبِّئُكَ","مَا لَمْ تَسْتَطِع",579],["18:82:30",302,"تَأْوِيلُ","(is the) interpretation","عَنْ أَمْرِى ۚ ذَٰلِكَ","مَا لَمْ تَسْطِع",579],["19:6:4",305,"ءَالِ","(the) family","يَرِثُنِى وَيَرِثُ مِنْ","يَعْقُوبَ ۖ وَٱجْعَلْهُ رَبِّ",410],["20:21:7",313,"ٱلْأُولَىٰ","the former","تَخَفْ ۖ سَنُعِيدُهَا سِيرَتَهَا","",137],["20:51:5",314,"ٱلْأُولَىٰ","(of) the former","فَمَا بَالُ ٱلْقُرُونِ","",137],["20:54:8",315,"لِّأُو۟لِى","for possessors","فِى ذَٰلِكَ لَـَٔايَـٰتٍۢ","ٱلنُّهَىٰ",257],["20:65:9",316,"أَوَّلَ","the first","وَإِمَّآ أَن نَّكُونَ","مَنْ أَلْقَىٰ",137],["20:128:16",321,"لِّأُو۟لِى","for possessors","فِى ذَٰلِكَ لَـَٔايَـٰتٍۢ","ٱلنُّهَىٰ",257],["20:133:13",321,"ٱلْأُولَىٰ","the former","مَا فِى ٱلصُّحُفِ","",137],["21:5:14",322,"ٱلْأَوَّلُونَ","(to) the former","بِـَٔايَةٍۢ كَمَآ أُرْسِلَ","",137],["21:104:9",331,"أَوَّلَ","(the) first","لِلْكُتُبِ ۚ كَمَا بَدَأْنَآ","خَلْقٍۢ نُّعِيدُهُۥ ۚ وَعْدًا",137],["23:24:26",343,"ٱلْأَوَّلِينَ","our forefathers","بِهَـٰذَا فِىٓ ءَابَآئِنَا","",137],["23:68:10",346,"ٱلْأَوَّلِينَ","(to) their forefathers","لَمْ يَأْتِ ءَابَآءَهُمُ","",137],["23:81:6",347,"ٱلْأَوَّلُونَ","the former (people)","مِثْلَ مَا قَالَ","",137],["23:83:12",347,"ٱلْأَوَّلِينَ","(of) the former (people)","هَـٰذَآ إِلَّآ أَسَـٰطِيرُ","",137],["24:22:3",352,"أُو۟لُوا۟","those of virtue","وَلَا يَأْتَلِ","ٱلْفَضْلِ مِنكُمْ وَٱلسَّعَةِ",257],["24:22:9",352,"أُو۟لِى","(to) the near of kin","وَٱلسَّعَةِ أَن يُؤْتُوٓا۟","ٱلْقُرْبَىٰ وَٱلْمَسَـٰكِينَ وَٱلْمُهَـٰجِرِينَ",257],["24:31:51",353,"أُو۟لِى","having no physical desire","أَوِ ٱلتَّـٰبِعِينَ غَيْرِ","ٱلْإِرْبَةِ مِنَ ٱلرِّجَالِ",257],["24:44:9",356,"لِّأُو۟لِى","for those who have vision","فِى ذَٰلِكَ لَعِبْرَةًۭ","ٱلْأَبْصَـٰرِ",257],["25:5:3",360,"ٱلْأَوَّلِينَ","(of) the former people","وَقَالُوٓا۟ أَسَـٰطِيرُ","ٱكْتَتَبَهَا فَهِىَ تُمْلَىٰ",137],["26:26:5",368,"ٱلْأَوَّلِينَ","(of) your forefathers","رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ","",137],["26:51:10",369,"أَوَّلَ","(the) first","خَطَـٰيَـٰنَآ أَن كُنَّآ","ٱلْمُؤْمِنِينَ",137],["26:137:5",373,"ٱلْأَوَّلِينَ","(of) the former (people)","هَـٰذَآ إِلَّا خُلُقُ","",137],["26:184:5",375,"ٱلْأَوَّلِينَ","the former","ٱلَّذِى خَلَقَكُمْ وَٱلْجِبِلَّةَ","",137],["26:196:4",375,"ٱلْأَوَّلِينَ","(of) the former (people)","وَإِنَّهُۥ لَفِى زُبُرِ","",137],["27:33:3",379,"أُو۟لُوا۟","(are) possessors","قَالُوا۟ نَحْنُ","قُوَّةٍۢ وَأُو۟لُوا۟ بَأْسٍۢ",257],["27:33:5",379,"وَأُو۟لُوا۟","and possessors","نَحْنُ أُو۟لُوا۟ قُوَّةٍۢ","بَأْسٍۢ شَدِيدٍۢ وَٱلْأَمْرُ",257],["27:56:9",382,"ءَالَ","(the) family","أَن قَالُوٓا۟ أَخْرِجُوٓا۟","لُوطٍۢ مِّن قَرْيَتِكُمْ ۖ",410],["27:68:12",383,"ٱلْأَوَّلِينَ","(of) the former (people)","هَـٰذَآ إِلَّآ أَسَـٰطِيرُ","",137],["28:8:2",386,"ءَالُ","(the) family","فَٱلْتَقَطَهُۥٓ","فِرْعَوْنَ لِيَكُونَ لَهُمْ",410],["28:36:17",390,"ٱلْأَوَّلِينَ","our forefathers","بِهَـٰذَا فِىٓ ءَابَآئِنَا","",137],["28:43:10",390,"ٱلْأُولَىٰ","former","مَآ أَهْلَكْنَا ٱلْقُرُونَ","بَصَآئِرَ لِلنَّاسِ وَهُدًۭى",137],["28:70:10",393,"ٱلْأُولَىٰ","the first","لَهُ ٱلْحَمْدُ فِى","وَٱلْـَٔاخِرَةِ ۖ وَلَهُ ٱلْحُكْمُ",137],["28:76:17",394,"أُو۟لِى","possessors of great strength","مَفَاتِحَهُۥ لَتَنُوٓأُ بِٱلْعُصْبَةِ","ٱلْقُوَّةِ إِذْ قَالَ",257],["33:6:8",418,"وَأُو۟لُوا۟","And possessors","أَنفُسِهِمْ ۖ وَأَزْوَٰجُهُۥٓ أُمَّهَـٰتُهُمْ ۗ","ٱلْأَرْحَامِ بَعْضُهُمْ أَوْلَىٰ",257],["33:33:8",422,"ٱلْأُولَىٰ ۖ","the former","تَبَرَّجْنَ تَبَرُّجَ ٱلْجَـٰهِلِيَّةِ","وَأَقِمْنَ ٱلصَّلَوٰةَ وَءَاتِينَ",137],["34:13:13",429,"ءَالَ","O family","وَقُدُورٍۢ رَّاسِيَـٰتٍ ۚ ٱعْمَلُوٓا۟","دَاوُۥدَ شُكْرًۭا ۚ وَقَلِيلٌۭ",410],["35:1:9",434,"أُو۟لِىٓ","having wings","جَاعِلِ ٱلْمَلَـٰٓئِكَةِ رُسُلًا","أَجْنِحَةٍۢ مَّثْنَىٰ وَثُلَـٰثَ",257],["35:43:16",439,"ٱلْأَوَّلِينَ ۚ","(of) the former (people)","يَنظُرُونَ إِلَّا سُنَّتَ","فَلَن تَجِدَ لِسُنَّتِ",137],["36:79:5",445,"أَوَّلَ","(the) first","يُحْيِيهَا ٱلَّذِىٓ أَنشَأَهَآ","مَرَّةٍۢ ۖ وَهُوَ بِكُلِّ",137],["37:17:2",446,"ٱلْأَوَّلُونَ","former","أَوَءَابَآؤُنَا","",137],["37:59:3",448,"ٱلْأُولَىٰ","the first","إِلَّا مَوْتَتَنَا","وَمَا نَحْنُ بِمُعَذَّبِينَ",137],["37:71:5",448,"ٱلْأَوَّلِينَ","(of) the former (people)","ضَلَّ قَبْلَهُمْ أَكْثَرُ","",137],["37:126:5",450,"ٱلْأَوَّلِينَ","(of) your forefathers","رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ","",137],["37:168:6",452,"ٱلْأَوَّلِينَ","the former (people)","عِندَنَا ذِكْرًۭا مِّنَ","",137],["38:29:8",455,"أُو۟لُوا۟","those of understanding","لِّيَدَّبَّرُوٓا۟ ءَايَـٰتِهِۦ وَلِيَتَذَكَّرَ","ٱلْأَلْبَـٰبِ",257],["38:43:9",456,"لِأُو۟لِى","for those of understanding","رَحْمَةًۭ مِّنَّا وَذِكْرَىٰ","ٱلْأَلْبَـٰبِ",257],["38:45:6",456,"أُو۟لِى","possessors","إِبْرَٰهِيمَ وَإِسْحَـٰقَ وَيَعْقُوبَ","ٱلْأَيْدِى وَٱلْأَبْصَـٰرِ",257],["39:9:23",459,"أُو۟لُوا۟","those of understanding","يَعْلَمُونَ ۗ إِنَّمَا يَتَذَكَّرُ","ٱلْأَلْبَـٰبِ",257],["39:12:4",460,"أَوَّلَ","(the) first","وَأُمِرْتُ لِأَنْ أَكُونَ","ٱلْمُسْلِمِينَ",137],["39:18:12",460,"أُو۟لُوا۟","the men of understanding","ٱللَّهُ ۖ وَأُو۟لَـٰٓئِكَ هُمْ","ٱلْأَلْبَـٰبِ",257],["39:21:30",460,"لِأُو۟لِى","for those of understanding","فِى ذَٰلِكَ لَذِكْرَىٰ","ٱلْأَلْبَـٰبِ",257],["40:28:5",470,"ءَالِ","(the) family","رَجُلٌۭ مُّؤْمِنٌۭ مِّنْ","فِرْعَوْنَ يَكْتُمُ إِيمَـٰنَهُۥٓ",410],["40:45:7",472,"بِـَٔالِ","(the) people","مَا مَكَرُوا۟ ۖ وَحَاقَ","فِرْعَوْنَ سُوٓءُ ٱلْعَذَابِ",410],["40:46:10",472,"ءَالَ","(the) people","تَقُومُ ٱلسَّاعَةُ أَدْخِلُوٓا۟","فِرْعَوْنَ أَشَدَّ ٱلْعَذَابِ",410],["40:54:3",473,"لِأُو۟لِى","for those","هُدًۭى وَذِكْرَىٰ","ٱلْأَلْبَـٰبِ",257],["41:21:15",479,"أَوَّلَ","(the) first","شَىْءٍۢ وَهُوَ خَلَقَكُمْ","مَرَّةٍۢ وَإِلَيْهِ تُرْجَعُونَ",137],["43:6:6",489,"ٱلْأَوَّلِينَ","the former (people)","مِن نَّبِىٍّۢ فِى","",137],["4