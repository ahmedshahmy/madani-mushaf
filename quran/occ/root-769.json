[["6:74:7",137,"أَصْنَامًا","idols","لِأَبِيهِ ءَازَرَ أَتَتَّخِذُ","ءَالِهَةً ۖ إِنِّىٓ أَرَىٰكَ",1271],["7:138:10",167,"أَصْنَامٍۢ","idols","قَوْمٍۢ يَعْكُفُونَ عَلَىٰٓ","لَّهُمْ ۚ قَالُوا۟ يَـٰمُوسَى",1271],["14:35:13",260,"ٱلْأَصْنَامَ","the idols","وَبَنِىَّ أَن نَّعْبُدَ","",1271],["21:57:3",326,"أَصْنَـٰمَكُم","(against) your idols","وَتَٱللَّهِ لَأَكِيدَنَّ","بَعْدَ أَن تُوَلُّوا۟",1271],["26:71:3",370,"أَصْنَامًۭا","idols","قَالُوا۟ نَعْبُدُ","فَنَظَلُّ لَهَا عَـٰكِفِينَ",1271]]