[["22:5:21",332,"مُّضْغَةٍۢ","an embryonic lump","عَلَقَةٍۢ ثُمَّ مِن","مُّخَلَّقَةٍۢ وَغَيْرِ مُخَلَّقَةٍۢ",1900],["23:14:7",342,"مُضْغَةًۭ","(into) an embryonic lump","عَلَقَةًۭ فَخَلَقْنَا ٱلْعَلَقَةَ","فَخَلَقْنَا ٱلْمُضْغَةَ عِظَـٰمًۭا",1900],["23:14:9",342,"ٱلْمُضْغَةَ","the embryonic lump","ٱلْعَلَقَةَ مُضْغَةًۭ فَخَلَقْنَا","عِظَـٰمًۭا فَكَسَوْنَا ٱلْعِظَـٰمَ",1900]]