[["1:6:2",1,"ٱلصِّرَٰطَ","(to) the path","ٱهْدِنَا","ٱلْمُسْتَقِيمَ",259],["1:7:1",1,"صِرَٰطَ","(The) path","","ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ",259],["2:142:20",22,"صِرَٰطٍۢ","a path","مَن يَشَآءُ إِلَىٰ","مُّسْتَقِيمٍۢ",259],["2:213:48",33,"صِرَٰطٍۢ","a path","مَن يَشَآءُ إِلَىٰ","مُّسْتَقِيمٍ",259],["3:51:7",56,"صِرَٰطٌۭ","(is) the path","وَرَبُّكُمْ فَٱعْبُدُوهُ ۗ هَـٰذَا","مُّسْتَقِيمٌۭ",259],["3:101:16",63,"صِرَٰطٍۢ","a path","فَقَدْ هُدِىَ إِلَىٰ","مُّسْتَقِيمٍۢ",259],["4:68:2",89,"صِرَٰطًۭا","(to the) way","وَلَهَدَيْنَـٰهُمْ","مُّسْتَقِيمًۭا",259],["4:175:14",105,"صِرَٰطًۭا","(on) a way","وَفَضْلٍۢ وَيَهْدِيهِمْ إِلَيْهِ","مُّسْتَقِيمًۭا",259],["5:16:17",110,"صِرَٰطٍۢ","(the) way","بِإِذْنِهِۦ وَيَهْدِيهِمْ إِلَىٰ","مُّسْتَقِيمٍۢ",259],["6:39:16",132,"صِرَٰطٍۢ","(the) way","يَشَأْ يَجْعَلْهُ عَلَىٰ","مُّسْتَقِيمٍۢ",259],["6:87:8",138,"صِرَٰطٍۢ","a path","وَٱجْتَبَيْنَـٰهُمْ وَهَدَيْنَـٰهُمْ إِلَىٰ","مُّسْتَقِيمٍۢ",259],["6:126:2",144,"صِرَٰطُ","(is the) way","وَهَـٰذَا","رَبِّكَ مُسْتَقِيمًۭا ۗ قَدْ",259],["6:153:3",149,"صِرَٰطِى","(is) My path","وَأَنَّ هَـٰذَا","مُسْتَقِيمًۭا فَٱتَّبِعُوهُ ۖ وَلَا",259],["6:161:6",150,"صِرَٰطٍۢ","a path","هَدَىٰنِى رَبِّىٓ إِلَىٰ","مُّسْتَقِيمٍۢ دِينًۭا قِيَمًۭا",259],["7:16:6",152,"صِرَٰطَكَ","(on) Your path","أَغْوَيْتَنِى لَأَقْعُدَنَّ لَهُمْ","ٱلْمُسْتَقِيمَ",259],["7:86:4",161,"صِرَٰطٍۢ","path","وَلَا تَقْعُدُوا۟ بِكُلِّ","تُوعِدُونَ وَتَصُدُّونَ عَن",259],["10:25:10",211,"صِرَٰطٍۢ","(the) straight path","مَن يَشَآءُ إِلَىٰ","مُّسْتَقِيمٍۢ",259],["11:56:17",228,"صِرَٰطٍۢ","a path","إِنَّ رَبِّى عَلَىٰ","مُّسْتَقِيمٍۢ",259],["14:1:14",255,"صِرَٰطِ","the Path","بِإِذْنِ رَبِّهِمْ إِلَىٰ","ٱلْعَزِيزِ ٱلْحَمِيدِ",259],["15:41:3",264,"صِرَٰطٌ","(is) the way","قَالَ هَـٰذَا","عَلَىَّ مُسْتَقِيمٌ",259],["16:76:28",275,"صِرَٰطٍۢ","a path","بِٱلْعَدْلِ ۙ وَهُوَ عَلَىٰ","مُّسْتَقِيمٍۢ",259],["16:121:6",281,"صِرَٰطٍۢ","the way","ٱجْتَبَىٰهُ وَهَدَىٰهُ إِلَىٰ","مُّسْتَقِيمٍۢ",259],["19:36:7",307,"صِرَٰطٌۭ","(is) a path","وَرَبُّكُمْ فَٱعْبُدُوهُ ۚ هَـٰذَا","مُّسْتَقِيمٌۭ",259],["19:43:12",308,"صِرَٰطًۭا","(to) the path","يَأْتِكَ فَٱتَّبِعْنِىٓ أَهْدِكَ","سَوِيًّۭا",259],["20:135:8",321,"ٱلصِّرَٰطِ","(of) the way","فَسَتَعْلَمُونَ مَنْ أَصْحَـٰبُ","ٱلسَّوِىِّ وَمَنِ ٱهْتَدَىٰ",259],["22:24:8",335,"صِرَٰطِ","(the) path","ٱلْقَوْلِ وَهُدُوٓا۟ إِلَىٰ","ٱلْحَمِيدِ",259],["22:54:20",338,"صِرَٰطٍۢ","a Path","ٱلَّذِينَ ءَامَنُوٓا۟ إِلَىٰ","مُّسْتَقِيمٍۢ",259],["23:73:4",346,"صِرَٰطٍۢ","(the) Path","وَإِنَّكَ لَتَدْعُوهُمْ إِلَىٰ","مُّسْتَقِيمٍۢ",259],["23:74:7",346,"ٱلصِّرَٰطِ","the path","يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ عَنِ","لَنَـٰكِبُونَ",259],["24:46:10",356,"صِرَٰطٍۢ","a path","مَن يَشَآءُ إِلَىٰ","مُّسْتَقِيمٍۢ",259],["34:6:14",428,"صِرَٰطِ","(the) Path","ٱلْحَقَّ وَيَهْدِىٓ إِلَىٰ","ٱلْعَزِيزِ ٱلْحَمِيدِ",259],["36:4:2",440,"صِرَٰطٍۢ","a Path","عَلَىٰ","مُّسْتَقِيمٍۢ",259],["36:61:4",444,"صِرَٰطٌۭ","(is) a Path","وَأَنِ ٱعْبُدُونِى ۚ هَـٰذَا","مُّسْتَقِيمٌۭ",259],["36:66:7",444,"ٱلصِّرَٰطَ","(to find) the path","عَلَىٰٓ أَعْيُنِهِمْ فَٱسْتَبَقُوا۟","فَأَنَّىٰ يُبْصِرُونَ",259],["37:23:6",446,"صِرَٰطِ","(the) Path","ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ","ٱلْجَحِيمِ",259],["37:118:2",450,"ٱلصِّرَٰطَ","(to) the Path","وَهَدَيْنَـٰهُمَا","ٱلْمُسْتَقِيمَ",259],["38:22:23",454,"ٱلصِّرَٰطِ","[the] path","وَٱهْدِنَآ إِلَىٰ سَوَآءِ","",259],["42:52:26",489,"صِرَٰطٍۢ","(the) Path","وَإِنَّكَ لَتَهْدِىٓ إِلَىٰ","مُّسْتَقِيمٍۢ",259],["42:53:1",489,"صِرَٰطِ","(The) path","","ٱللَّهِ ٱلَّذِى لَهُۥ",259],["43:43:7",492,"صِرَٰطٍۢ","a Path","إِلَيْكَ ۖ إِنَّكَ عَلَىٰ","مُّسْتَقِيمٍۢ",259],["43:61:9",494,"صِرَٰطٌۭ","(is the) Path","بِهَا وَٱتَّبِعُونِ ۚ هَـٰذَا","مُّسْتَقِيمٌۭ",259],["43:64:8",494,"صِرَٰطٌۭ","(is) a Path","وَرَبُّكُمْ فَٱعْبُدُوهُ ۚ هَـٰذَا","مُّسْتَقِيمٌۭ",259],["48:2:14",511,"صِرَٰطًۭا","(to) a Path","نِعْمَتَهُۥ عَلَيْكَ وَيَهْدِيَكَ","مُّسْتَقِيمًۭا",259],["48:20:17",513,"صِرَٰطًۭا","(to the) Path","ءَايَةًۭ لِّلْمُؤْمِنِينَ وَيَهْدِيَكُمْ","مُّسْتَقِيمًۭا",259],["67:22:11",563,"صِرَٰطٍۢ","(the) Path","يَمْشِى سَوِيًّا عَلَىٰ","مُّسْتَقِيمٍۢ",259]]