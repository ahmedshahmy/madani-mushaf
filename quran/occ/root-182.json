[["2:85:11",13,"تَظَـٰهَرُونَ","you support one another","مِّنكُم مِّن دِيَـٰرِهِمْ","عَلَيْهِم بِٱلْإِثْمِ وَٱلْعُدْوَٰنِ",2659],["2:101:19",15,"ظُهُورِهِمْ","their backs","كِتَـٰبَ ٱللَّهِ وَرَآءَ","كَأَنَّهُمْ لَا يَعْلَمُونَ",625],["2:189:15",29,"ظُهُورِهَا","their backs","تَأْتُوا۟ ٱلْبُيُوتَ مِن","وَلَـٰكِنَّ ٱلْبِرَّ مَنِ",625],["3:187:14",75,"ظُهُورِهِمْ","their backs","تَكْتُمُونَهُۥ فَنَبَذُوهُ وَرَآءَ","وَٱشْتَرَوْا۟ بِهِۦ ثَمَنًۭا",625],["6:31:22",131,"ظُهُورِهِمْ ۚ","their backs","يَحْمِلُونَ أَوْزَارَهُمْ عَلَىٰ","أَلَا سَآءَ مَا",625],["6:94:12",139,"ظُهُورِكُمْ ۖ","your backs","مَّا خَوَّلْنَـٰكُمْ وَرَآءَ","وَمَا نَرَىٰ مَعَكُمْ",625],["6:120:2",143,"ظَـٰهِرَ","open","وَذَرُوا۟","ٱلْإِثْمِ وَبَاطِنَهُۥٓ ۚ إِنَّ",967],["6:138:14",146,"ظُهُورُهَا","(are) their backs","بِزَعْمِهِمْ وَأَنْعَـٰمٌ حُرِّمَتْ","وَأَنْعَـٰمٌۭ لَّا يَذْكُرُونَ",625],["6:146:17",147,"ظُهُورُهُمَآ","their backs","إِلَّا مَا حَمَلَتْ","أَوِ ٱلْحَوَايَآ أَوْ",625],["6:151:26",148,"ظَهَرَ","(is) apparent","تَقْرَبُوا۟ ٱلْفَوَٰحِشَ مَا","مِنْهَا وَمَا بَطَنَ ۖ",830],["7:33:7",154,"ظَهَرَ","(is) apparent","رَبِّىَ ٱلْفَوَٰحِشَ مَا","مِنْهَا وَمَا بَطَنَ",830],["7:172:8",173,"ظُهُورِهِمْ","their loins","بَنِىٓ ءَادَمَ مِن","ذُرِّيَّتَهُمْ وَأَشْهَدَهُمْ عَلَىٰٓ",625],["9:4:11",187,"يُظَـٰهِرُوا۟","they have supported","يَنقُصُوكُمْ شَيْـًۭٔا وَلَمْ","عَلَيْكُمْ أَحَدًۭا فَأَتِمُّوٓا۟",1162],["9:8:3",188,"يَظْهَرُوا۟","they gain dominance","كَيْفَ وَإِن","عَلَيْكُمْ لَا يَرْقُبُوا۟",830],["9:33:8",192,"لِيُظْهِرَهُۥ","to manifest it","بِٱلْهُدَىٰ وَدِينِ ٱلْحَقِّ","عَلَى ٱلدِّينِ كُلِّهِۦ",952],["9:35:11",192,"وَظُهُورُهُمْ ۖ","and their backs","بِهَا جِبَاهُهُمْ وَجُنُوبُهُمْ","هَـٰذَا مَا كَنَزْتُمْ",625],["9:48:12",195,"وَظَهَرَ","and became manifest","حَتَّىٰ جَآءَ ٱلْحَقُّ","أَمْرُ ٱللَّهِ وَهُمْ",830],["11:92:10",232,"ظِهْرِيًّا ۖ","backs","ٱللَّهِ وَٱتَّخَذْتُمُوهُ وَرَآءَكُمْ","إِنَّ رَبِّى بِمَا",3306],["13:33:22",253,"بِظَـٰهِرٍۢ","of the apparent","فِى ٱلْأَرْضِ أَم","مِّنَ ٱلْقَوْلِ ۗ بَلْ",967],["17:88:19",291,"ظَهِيرًۭا","assistants","كَانَ بَعْضُهُمْ لِبَعْضٍۢ","",1163],["18:20:3",295,"يَظْهَرُوا۟","they come to know","إِنَّهُمْ إِن","عَلَيْكُمْ يَرْجُمُوكُمْ أَوْ",830],["18:22:28",296,"ظَـٰهِرًۭا","obvious","فِيهِمْ إِلَّا مِرَآءًۭ","وَلَا تَسْتَفْتِ فِيهِم",967],["18:97:4",303,"يَظْهَرُوهُ","scale it","فَمَا ٱسْطَـٰعُوٓا۟ أَن","وَمَا ٱسْتَطَـٰعُوا۟ لَهُۥ",830],["21:39:13",325,"ظُهُورِهِمْ","their backs","ٱلنَّارَ وَلَا عَن","وَلَا هُمْ يُنصَرُونَ",625],["24:31:13",353,"ظَهَرَ","is apparent","زِينَتَهُنَّ إِلَّا مَا","مِنْهَا ۖ وَلْيَضْرِبْنَ بِخُمُرِهِنَّ",830],["24:31:59",353,"يَظْهَرُوا۟","aware","ٱلطِّفْلِ ٱلَّذِينَ لَمْ","عَلَىٰ عَوْرَٰتِ ٱلنِّسَآءِ ۖ",830],["24:58:23",357,"ٱلظَّهِيرَةِ","noon","تَضَعُونَ ثِيَابَكُم مِّنَ","وَمِنۢ بَعْدِ صَلَوٰةِ",3309],["25:55:14",364,"ظَهِيرًۭا","a helper","ٱلْكَافِرُ عَلَىٰ رَبِّهِۦ","",1163],["28:17:8",387,"ظَهِيرًۭا","a supporter","عَلَىَّ فَلَنْ أَكُونَ","لِّلْمُجْرِمِينَ",1163],["28:48:22",391,"تَظَـٰهَرَا","supporting each other","قَبْلُ ۖ قَالُوا۟ سِحْرَانِ","وَقَالُوٓا۟ إِنَّا بِكُلٍّۢ",952],["28:86:14",396,"ظَهِيرًۭا","an assistant","رَّبِّكَ ۖ فَلَا تَكُونَنَّ","لِّلْكَـٰفِرِينَ",1163],["30:7:2",405,"ظَـٰهِرًۭا","(the) apparent","يَعْلَمُونَ","مِّنَ ٱلْحَيَوٰةِ ٱلدُّنْيَا",967],["30:18:8",406,"تُظْهِرُونَ","you are at noon","وَٱلْأَرْضِ وَعَشِيًّۭا وَحِينَ","",952],["30:41:1",408,"ظَهَرَ","Has appeared","","ٱلْفَسَادُ فِى ٱلْبَرِّ",830],["31:20:16",413,"ظَـٰهِرَةًۭ","apparent","وَأَسْبَغَ عَلَيْكُمْ نِعَمَهُۥ","وَبَاطِنَةًۭ ۗ وَمِنَ ٱلنَّاسِ",2316],["33:4:13",418,"تُظَـٰهِرُونَ","you declare unlawful","جَعَلَ أَزْوَٰجَكُمُ ٱلَّـٰٓـِٔى","مِنْهُنَّ أُمَّهَـٰتِكُمْ ۚ وَمَا",1162],["33:26:3",421,"ظَـٰهَرُوهُم","backed them","وَأَنزَلَ ٱلَّذِينَ","مِّنْ أَهْلِ ٱلْكِتَـٰبِ",1162],["34:18:9",430,"ظَـٰهِرَةًۭ","visible","بَـٰرَكْنَا فِيهَا قُرًۭى","وَقَدَّرْنَا فِيهَا ٱلسَّيْرَ ۖ",2316],["34:22:26",430,"ظَهِيرٍۢ","supporter","لَهُۥ مِنْهُم مِّن","",1163],["35:45:10",440,"ظَهْرِهَا","its back","مَا تَرَكَ عَلَىٰ","مِن دَآبَّةٍۢ وَلَـٰكِن",625],["40:26:15",470,"يُظْهِرَ","he may cause to appear","دِينَكُمْ أَوْ أَن","فِى ٱلْأَرْضِ ٱلْفَسَادَ",952],["40:29:5",470,"ظَـٰهِرِينَ","dominant","لَكُمُ ٱلْمُلْكُ ٱلْيَوْمَ","فِى ٱلْأَرْضِ فَمَن",967],["42:33:8",487,"ظَهْرِهِۦٓ ۚ","its back","فَيَظْلَلْنَ رَوَاكِدَ عَلَىٰ","إِنَّ فِى ذَٰلِكَ",625],["43:13:3",490,"ظُهُورِهِۦ","their backs","لِتَسْتَوُۥا۟ عَلَىٰ","ثُمَّ تَذْكُرُوا۟ نِعْمَةَ",625],["43:33:17",491,"يَظْهَرُونَ","they mount","فِضَّةٍۢ وَمَعَارِجَ عَلَيْهَا","",830],["48:28:8",514,"لِيُظْهِرَهُۥ","that He (may) make it prevail","بِٱلْهُدَىٰ وَدِينِ ٱلْحَقِّ","عَلَى ٱلدِّينِ كُلِّهِۦ ۚ",952],["57:3:4",537,"وَٱلظَّـٰهِرُ","and the Apparent","هُوَ ٱلْأَوَّلُ وَٱلْـَٔاخِرُ","وَٱلْبَاطِنُ ۖ وَهُوَ بِكُلِّ",967],["57:13:24",539,"وَظَـٰهِرُهُۥ","but its exterior","بَاطِنُهُۥ فِيهِ ٱلرَّحْمَةُ","مِن قِبَلِهِ ٱلْعَذَابُ",967],["58:2:2",542,"يُظَـٰهِرُونَ","pronounce zihar","ٱلَّذِينَ","مِنكُم مِّن نِّسَآئِهِم",1162],["58:3:2",542,"يُظَـٰهِرُونَ","pronounce zihar","وَٱلَّذِينَ","مِن نِّسَآئِهِمْ ثُمَّ",1162],["60:9:12",550,"وَظَـٰهَرُوا۟","and support","وَأَخْرَجُوكُم مِّن دِيَـٰرِكُمْ","عَلَىٰٓ إِخْرَاجِكُمْ أَن",1162],["61:9:8",552,"لِيُظْهِرَهُۥ","to make it prevail","بِٱلْهُدَىٰ وَدِينِ ٱلْحَقِّ","عَلَى ٱلدِّينِ كُلِّهِۦ",952],["61:14:35",552,"ظَـٰهِرِينَ","dominant","عَلَىٰ عَدُوِّهِمْ فَأَصْبَحُوا۟","",967],["66:3:11",560,"وَأَظْهَرَهُ","and made it apparent","فَلَمَّا نَبَّأَتْ بِهِۦ","ٱللَّهُ عَلَيْهِ عَرَّفَ",952],["66:4:9",560,"تَظَـٰهَرَا","you backup each other","صَغَتْ قُلُوبُكُمَا ۖ وَإِن","عَلَيْهِ فَإِنَّ ٱللَّهَ",2659],["66:4:21",560,"ظَهِيرٌ","(are his) assistants","وَٱلْمَلَـٰٓئِكَةُ بَعْدَ ذَٰلِكَ","",1163],["72:26:4",573,"يُظْهِرُ","He reveals","عَـٰلِمُ ٱلْغَيْبِ فَلَا","عَلَىٰ غَيْبِهِۦٓ أَحَدًا",952],["84:10:6",589,"ظَهْرِهِۦ","his back","أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ","",625],["94:3:3",597,"ظَهْرَكَ","your back","ٱلَّذِىٓ أَنقَضَ","",625]]