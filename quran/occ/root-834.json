[["2:233:40",37,"وَتَشَاوُرٍۢ","and consultation","عَن تَرَاضٍۢ مِّنْهُمَا","فَلَا جُنَاحَ عَلَيْهِمَا ۗ",4303],["3:159:19",71,"وَشَاوِرْهُمْ","and consult them","عَنْهُمْ وَٱسْتَغْفِرْ لَهُمْ","فِى ٱلْأَمْرِ ۖ فَإِذَا",2861],["19:29:1",307,"فَأَشَارَتْ","Then she pointed","","إِلَيْهِ ۖ قَالُوا۟ كَيْفَ",2942],["42:38:7",487,"شُورَىٰ","(are conducted by) consultation","وَأَقَامُوا۟ ٱلصَّلَوٰةَ وَأَمْرُهُمْ","بَيْنَهُمْ وَمِمَّا رَزَقْنَـٰهُمْ",2896]]