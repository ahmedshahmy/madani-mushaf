246,"أَجْرَ","(the) reward","ٱللَّهَ لَا يُضِيعُ","ٱلْمُحْسِنِينَ",107],["12:104:5",248,"أَجْرٍ ۚ","reward","تَسْـَٔلُهُمْ عَلَيْهِ مِنْ","إِنْ هُوَ إِلَّا",107],["16:41:13",271,"وَلَأَجْرُ","but surely the reward","فِى ٱلدُّنْيَا حَسَنَةًۭ ۖ","ٱلْـَٔاخِرَةِ أَكْبَرُ ۚ لَوْ",107],["16:96:11",278,"أَجْرَهُم","their reward","وَلَنَجْزِيَنَّ ٱلَّذِينَ صَبَرُوٓا۟","بِأَحْسَنِ مَا كَانُوا۟",107],["16:97:14",278,"أَجْرَهُم","their reward","حَيَوٰةًۭ طَيِّبَةًۭ ۖ وَلَنَجْزِيَنَّهُمْ","بِأَحْسَنِ مَا كَانُوا۟",107],["17:9:15",283,"أَجْرًۭا","(is) a reward","ٱلصَّـٰلِحَـٰتِ أَنَّ لَهُمْ","كَبِيرًۭا",107],["18:2:14",293,"أَجْرًا","(is) a good reward","ٱلصَّـٰلِحَـٰتِ أَنَّ لَهُمْ","حَسَنًۭا",107],["18:30:9",297,"أَجْرَ","(the) reward","إِنَّا لَا نُضِيعُ","مَنْ أَحْسَنَ عَمَلًا",107],["18:77:24",302,"أَجْرًۭا","a payment","شِئْتَ لَتَّخَذْتَ عَلَيْهِ","",107],["25:57:6",365,"أَجْرٍ","payment","أَسْـَٔلُكُمْ عَلَيْهِ مِنْ","إِلَّا مَن شَآءَ",107],["26:41:8",369,"لَأَجْرًا","a reward","لِفِرْعَوْنَ أَئِنَّ لَنَا","إِن كُنَّا نَحْنُ",107],["26:109:5",371,"أَجْرٍ ۖ","payment","أَسْـَٔلُكُمْ عَلَيْهِ مِنْ","إِنْ أَجْرِىَ إِلَّا",107],["26:109:7",371,"أَجْرِىَ","(is) my payment","مِنْ أَجْرٍ ۖ إِنْ","إِلَّا عَلَىٰ رَبِّ",107],["26:127:5",372,"أَجْرٍ ۖ","payment","أَسْـَٔلُكُمْ عَلَيْهِ مِنْ","إِنْ أَجْرِىَ إِلَّا",107],["26:127:7",372,"أَجْرِىَ","(is) my payment","مِنْ أَجْرٍ ۖ إِنْ","إِلَّا عَلَىٰ رَبِّ",107],["26:145:5",373,"أَجْرٍ ۖ","payment","أَسْـَٔلُكُمْ عَلَيْهِ مِنْ","إِنْ أَجْرِىَ إِلَّا",107],["26:145:7",373,"أَجْرِىَ","(is) my payment","مِنْ أَجْرٍ ۖ إِنْ","إِلَّا عَلَىٰ رَبِّ",107],["26:164:5",374,"أَجْرٍ ۖ","payment","أَسْـَٔلُكُمْ عَلَيْهِ مِنْ","إِنْ أَجْرِىَ إِلَّا",107],["26:164:7",374,"أَجْرِىَ","(is) my payment","مِنْ أَجْرٍ ۖ إِنْ","إِلَّا عَلَىٰ رَبِّ",107],["26:180:5",374,"أَجْرٍ ۖ","payment","أَسْـَٔلُكُمْ عَلَيْهِ مِنْ","إِنْ أَجْرِىَ إِلَّا",107],["26:180:7",374,"أَجْرِىَ","(is) my payment","مِنْ أَجْرٍ ۖ إِنْ","إِلَّا عَلَىٰ رَبِّ",107],["28:25:11",388,"أَجْرَ","(the) reward","أَبِى يَدْعُوكَ لِيَجْزِيَكَ","مَا سَقَيْتَ لَنَا ۚ",107],["28:26:4",388,"ٱسْتَـْٔجِرْهُ ۖ","Hire him","قَالَتْ إِحْدَىٰهُمَا يَـٰٓأَبَتِ","إِنَّ خَيْرَ مَنِ",2846],["28:26:8",388,"ٱسْتَـْٔجَرْتَ","you (can) hire","إِنَّ خَيْرَ مَنِ","ٱلْقَوِىُّ ٱلْأَمِينُ",2846],["28:27:11",388,"تَأْجُرَنِى","you serve me","هَـٰتَيْنِ عَلَىٰٓ أَن","ثَمَـٰنِىَ حِجَجٍۢ ۖ فَإِنْ",4313],["28:54:3",392,"أَجْرَهُم","their reward","أُو۟لَـٰٓئِكَ يُؤْتَوْنَ","مَّرَّتَيْنِ بِمَا صَبَرُوا۟",107],["29:27:11",399,"أَجْرَهُۥ","his reward","ٱلنُّبُوَّةَ وَٱلْكِتَـٰبَ وَءَاتَيْنَـٰهُ","فِى ٱلدُّنْيَا ۖ وَإِنَّهُۥ",107],["29:58:16",403,"أَجْرُ","(the) reward","خَـٰلِدِينَ فِيهَا ۚ نِعْمَ","ٱلْعَـٰمِلِينَ",107],["33:29:13",421,"أَجْرًا","a reward","أَعَدَّ لِلْمُحْسِنَـٰتِ مِنكُنَّ","عَظِيمًۭا",107],["33:31:9",422,"أَجْرَهَا","her reward","وَتَعْمَلْ صَـٰلِحًۭا نُّؤْتِهَآ","مَرَّتَيْنِ وَأَعْتَدْنَا لَهَا",107],["33:35:29",422,"وَأَجْرًا","and a reward","ٱللَّهُ لَهُم مَّغْفِرَةًۭ","عَظِيمًۭا",107],["33:44:7",424,"أَجْرًۭا","a reward","سَلَـٰمٌۭ ۚ وَأَعَدَّ لَهُمْ","كَرِيمًۭا",107],["33:50:9",424,"أُجُورَهُنَّ","their bridal money","أَزْوَٰجَكَ ٱلَّـٰتِىٓ ءَاتَيْتَ","وَمَا مَلَكَتْ يَمِينُكَ",107],["34:47:5",433,"أَجْرٍۢ","any payment","مَا سَأَلْتُكُم مِّنْ","فَهُوَ لَكُمْ ۖ إِنْ",107],["34:47:9",433,"أَجْرِىَ","(is) my payment","فَهُوَ لَكُمْ ۖ إِنْ","إِلَّا عَلَى ٱللَّهِ ۖ",107],["35:7:12",435,"وَأَجْرٌۭ","and a reward","ٱلصَّـٰلِحَـٰتِ لَهُم مَّغْفِرَةٌۭ","كَبِيرٌ",107],["35:30:2",437,"أُجُورَهُمْ","their rewards","لِيُوَفِّيَهُمْ","وَيَزِيدَهُم مِّن فَضْلِهِۦٓ ۚ",107],["36:11:11",440,"وَأَجْرٍۢ","and a reward","بِٱلْغَيْبِ ۖ فَبَشِّرْهُ بِمَغْفِرَةٍۢ","كَرِيمٍ",107],["36:21:5",441,"أَجْرًۭا","any payment","مَن لَّا يَسْـَٔلُكُمْ","وَهُم مُّهْتَدُونَ",107],["38:86:6",458,"أَجْرٍۢ","payment","أَسْـَٔلُكُمْ عَلَيْهِ مِنْ","وَمَآ أَنَا۠ مِنَ",107],["39:10:19",459,"أَجْرَهُم","their reward","إِنَّمَا يُوَفَّى ٱلصَّـٰبِرُونَ","بِغَيْرِ حِسَابٍۢ",107],["39:35:8",462,"أَجْرَه