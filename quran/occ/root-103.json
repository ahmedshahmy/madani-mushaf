[["2:62:16",10,"أَجْرُهُمْ","their reward","وَعَمِلَ صَـٰلِحًۭا فَلَهُمْ","عِندَ رَبِّهِمْ وَلَا",107],["2:112:9",17,"أَجْرُهُۥ","(is) his reward","وَهُوَ مُحْسِنٌۭ فَلَهُۥٓ","عِندَ رَبِّهِۦ وَلَا",107],["2:262:16",44,"أَجْرُهُمْ","their reward","وَلَآ أَذًۭى ۙ لَّهُمْ","عِندَ رَبِّهِمْ وَلَا",107],["2:274:9",46,"أَجْرُهُمْ","(is) their reward","سِرًّۭا وَعَلَانِيَةًۭ فَلَهُمْ","عِندَ رَبِّهِمْ وَلَا",107],["2:277:11",47,"أَجْرُهُمْ","their reward","وَءَاتَوُا۟ ٱلزَّكَوٰةَ لَهُمْ","عِندَ رَبِّهِمْ وَلَا",107],["3:57:7",57,"أُجُورَهُمْ ۗ","their reward","وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَيُوَفِّيهِمْ","وَٱللَّهُ لَا يُحِبُّ",107],["3:136:14",67,"أَجْرُ","reward","خَـٰلِدِينَ فِيهَا ۚ وَنِعْمَ","ٱلْعَـٰمِلِينَ",107],["3:171:10",72,"أَجْرَ","(the) reward","ٱللَّهَ لَا يُضِيعُ","ٱلْمُؤْمِنِينَ",107],["3:172:14",72,"أَجْرٌ","(is) a reward","أَحْسَنُوا۟ مِنْهُمْ وَٱتَّقَوْا۟","عَظِيمٌ",107],["3:179:35",73,"أَجْرٌ","(is a) reward","تُؤْمِنُوا۟ وَتَتَّقُوا۟ فَلَكُمْ","عَظِيمٌۭ",107],["3:185:7",74,"أُجُورَكُمْ","your reward","ٱلْمَوْتِ ۗ وَإِنَّمَا تُوَفَّوْنَ","يَوْمَ ٱلْقِيَـٰمَةِ ۖ فَمَن",107],["3:199:24",76,"أَجْرُهُمْ","their reward","قَلِيلًا ۗ أُو۟لَـٰٓئِكَ لَهُمْ","عِندَ رَبِّهِمْ ۗ إِنَّ",107],["4:24:27",82,"أُجُورَهُنَّ","their bridal due","بِهِۦ مِنْهُنَّ فَـَٔاتُوهُنَّ","فَرِيضَةًۭ ۚ وَلَا جُنَاحَ",107],["4:25:27",82,"أُجُورَهُنَّ","their bridal due","بِإِذْنِ أَهْلِهِنَّ وَءَاتُوهُنَّ","بِٱلْمَعْرُوفِ مُحْصَنَـٰتٍ غَيْرَ",107],["4:40:14",85,"أَجْرًا","a reward","وَيُؤْتِ مِن لَّدُنْهُ","عَظِيمًۭا",107],["4:67:5",89,"أَجْرًا","a reward","لَّـَٔاتَيْنَـٰهُم مِّن لَّدُنَّآ","عَظِيمًۭا",107],["4:74:20",89,"أَجْرًا","a reward","يَغْلِبْ فَسَوْفَ نُؤْتِيهِ","عَظِيمًۭا",107],["4:95:32",94,"أَجْرًا","(with) a reward","ٱلْمُجَـٰهِدِينَ عَلَى ٱلْقَـٰعِدِينَ","عَظِيمًۭا",107],["4:100:25",94,"أَجْرُهُۥ","his reward","ٱلْمَوْتُ فَقَدْ وَقَعَ","عَلَى ٱللَّهِ ۗ وَكَانَ",107],["4:114:25",97,"أَجْرًا","a reward","ٱللَّهِ فَسَوْفَ نُؤْتِيهِ","عَظِيمًۭا",107],["4:146:17",101,"أَجْرً