[["7:78:2",160,"ٱلرَّجْفَةُ","the earthquake","فَأَخَذَتْهُمُ","فَأَصْبَحُوا۟ فِى دَارِهِمْ",1632],["7:91:2",162,"ٱلرَّجْفَةُ","the earthquake","فَأَخَذَتْهُمُ","فَأَصْبَحُوا۟ فِى دَارِهِمْ",1632],["7:155:9",169,"ٱلرَّجْفَةُ","the earthquake","لِّمِيقَـٰتِنَا ۖ فَلَمَّآ أَخَذَتْهُمُ","قَالَ رَبِّ لَوْ",1632],["29:37:3",400,"ٱلرَّجْفَةُ","the earthquake","فَكَذَّبُوهُ فَأَخَذَتْهُمُ","فَأَصْبَحُوا۟ فِى دَارِهِمْ",1632],["33:60:9",426,"وَٱلْمُرْجِفُونَ","and those who spread rumors","فِى قُلُوبِهِم مَّرَضٌۭ","فِى ٱلْمَدِينَةِ لَنُغْرِيَنَّكَ",3845],["73:14:2",574,"تَرْجُفُ","will quake","يَوْمَ","ٱلْأَرْضُ وَٱلْجِبَالُ وَكَانَتِ",2679],["79:6:2",583,"تَرْجُفُ","will quake","يَوْمَ","ٱلرَّاجِفَةُ",2679],["79:6:3",583,"ٱلرَّاجِفَةُ","the quaking one","يَوْمَ تَرْجُفُ","",4211]]