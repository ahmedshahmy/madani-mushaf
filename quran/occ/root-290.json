[["2:216:19",34,"شَرٌّۭ","(is) bad","تُحِبُّوا۟ شَيْـًۭٔا وَهُوَ","لَّكُمْ ۗ وَٱللَّهُ يَعْلَمُ",360],["3:180:15",73,"شَرٌّۭ","(is) bad","لَّهُم ۖ بَلْ هُوَ","لَّهُمْ ۖ سَيُطَوَّقُونَ مَا",360],["5:60:4",118,"بِشَرٍّۢ","(of) worse","قُلْ هَلْ أُنَبِّئُكُم","مِّن ذَٰلِكَ مَثُوبَةً",360],["5:60:22",118,"شَرٌّۭ","(are) worse","وَعَبَدَ ٱلطَّـٰغُوتَ ۚ أُو۟لَـٰٓئِكَ","مَّكَانًۭا وَأَضَلُّ عَن",360],["8:22:2",179,"شَرَّ","worst","۞ إِنَّ","ٱلدَّوَآبِّ عِندَ ٱللَّهِ",360],["8:55:2",184,"شَرَّ","(the) worst","إِنَّ","ٱلدَّوَآبِّ عِندَ ٱللَّهِ",360],["10:11:5",209,"ٱلشَّرَّ","the evil","يُعَجِّلُ ٱللَّهُ لِلنَّاسِ","ٱسْتِعْجَالَهُم بِٱلْخَيْرِ لَقُضِىَ",360],["12:77:19",244,"شَرٌّۭ","(are the) worse","لَهُمْ ۚ قَالَ أَنتُمْ","مَّكَانًۭا ۖ وَٱللَّهُ أَعْلَمُ",360],["17:11:3",283,"بِٱلشَّرِّ","for evil","وَيَدْعُ ٱلْإِنسَـٰنُ","دُعَآءَهُۥ بِٱلْخَيْرِ ۖ وَكَانَ",360],["17:83:10",290,"ٱلشَّرُّ","the evil","بِجَانِبِهِۦ ۖ وَإِذَا مَسَّهُ","كَانَ يَـُٔوسًۭا",360],["19:75:22",310,"شَرٌّۭ","(is) worst","فَسَيَعْلَمُونَ مَنْ هُوَ","مَّكَانًۭا وَأَضْعَفُ جُندًۭا",360],["21:35:6",324,"بِٱلشَّرِّ","with [the] bad","ذَآئِقَةُ ٱلْمَوْتِ ۗ وَنَبْلُوكُم","وَٱلْخَيْرِ فِتْنَةًۭ ۖ وَإِلَيْنَا",360],["22:72:20",340,"بِشَرٍّۢ","of worse","ءَايَـٰتِنَا ۗ قُلْ أَفَأُنَبِّئُكُم","مِّن ذَٰلِكُمُ ۗ ٱلنَّارُ",360],["24:11:9",351,"شَرًّۭا","bad","مِّنكُمْ ۚ لَا تَحْسَبُوهُ","لَّكُم ۖ بَلْ هُوَ",360],["25:34:8",363,"شَرٌّۭ","(are the) worst","إِلَىٰ جَهَنَّمَ أُو۟لَـٰٓئِكَ","مَّكَانًۭا وَأَضَلُّ سَبِيلًۭا",360],["38:55:4",456,"لَشَرَّ","surely (is) an evil","هَـٰذَا ۚ وَإِنَّ لِلطَّـٰغِينَ","مَـَٔابٍۢ",360],["38:62:10",457,"ٱلْأَشْرَارِ","the bad ones","كُنَّا نَعُدُّهُم مِّنَ","",360],["41:49:9",482,"ٱلشَّرُّ","the evil","ٱلْخَيْرِ وَإِن مَّسَّهُ","فَيَـُٔوسٌۭ قَنُوطٌۭ",360],["41:51:10",482,"ٱلشَّرُّ","the evil","بِجَانِبِهِۦ وَإِذَا مَسَّهُ","فَذُو دُعَآءٍ عَرِيضٍۢ",360],["70:20:3",569,"ٱلشَّرُّ","the evil","إِذَا مَسَّهُ","جَزُوعًۭا",360],["72:10:4",572,"أَشَرٌّ","whether evil","وَأَنَّا لَا نَ