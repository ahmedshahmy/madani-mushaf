[["3:159:10",71,"غَلِيظَ","(and) harsh","وَلَوْ كُنتَ فَظًّا","ٱلْقَلْبِ لَٱنفَضُّوا۟ مِنْ",900],["4:21:11",81,"غَلِيظًۭا","strong","وَأَخَذْنَ مِنكُم مِّيثَـٰقًا","",900],["4:154:19",102,"غَلِيظًۭا","solemn","وَأَخَذْنَا مِنْهُم مِّيثَـٰقًا","",900],["9:73:6",199,"وَٱغْلُظْ","and be stern","جَـٰهِدِ ٱلْكُفَّارَ وَٱلْمُنَـٰفِقِينَ","عَلَيْهِمْ ۚ وَمَأْوَىٰهُمْ جَهَنَّمُ ۖ",2833],["9:123:11",207,"غِلْظَةًۭ ۚ","harshness","ٱلْكُفَّارِ وَلْيَجِدُوا۟ فِيكُمْ","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ",3473],["11:58:14",228,"غَلِيظٍۢ","severe","وَنَجَّيْنَـٰهُم مِّنْ عَذَابٍ","",900],["14:17:16",257,"غَلِيظٌۭ","harsh","وَمِن وَرَآئِهِۦ عَذَابٌ","",900],["31:24:7",413,"غَلِيظٍۢ","severe","نَضْطَرُّهُمْ إِلَىٰ عَذَابٍ","",900],["33:7:17",419,"غَلِيظًۭا","strong","وَأَخَذْنَا مِنْهُم مِّيثَـٰقًا","",900],["41:50:32",482,"غَلِيظٍۢ","severe","وَلَنُذِيقَنَّهُم مِّنْ عَذَابٍ","",900],["48:29:36",515,"فَٱسْتَغْلَظَ","then it becomes thick","أَخْرَجَ شَطْـَٔهُۥ فَـَٔازَرَهُۥ","فَٱسْتَوَىٰ عَلَىٰ سُوقِهِۦ",4830],["66:6:13",560,"غِلَاظٌۭ","stern","وَٱلْحِجَارَةُ عَلَيْهَا مَلَـٰٓئِكَةٌ","شِدَادٌۭ لَّا يَعْصُونَ",900],["66:9:6",561,"وَٱغْلُظْ","and be stern","جَـٰهِدِ ٱلْكُفَّارَ وَٱلْمُنَـٰفِقِينَ","عَلَيْهِمْ ۚ وَمَأْوَىٰهُمْ جَهَنَّمُ ۖ",2833]]