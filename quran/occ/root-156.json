[["2:36:17",6,"وَمَتَـٰعٌ","and a provision","فِى ٱلْأَرْضِ مُسْتَقَرٌّۭ","إِلَىٰ حِينٍۢ",330],["2:126:22",19,"فَأُمَتِّعُهُۥ","[then] I will grant him enjoyment","قَالَ وَمَن كَفَرَ","قَلِيلًۭا ثُمَّ أَضْطَرُّهُۥٓ",553],["2:196:37",30,"تَمَتَّعَ","took advantage","فَإِذَآ أَمِنتُمْ فَمَن","بِٱلْعُمْرَةِ إِلَى ٱلْحَجِّ",802],["2:236:14",38,"وَمَتِّعُوهُنَّ","And make provision for them","تَفْرِضُوا۟ لَهُنَّ فَرِيضَةًۭ ۚ","عَلَى ٱلْمُوسِعِ قَدَرُهُۥ",553],["2:236:21",38,"مَتَـٰعًۢا","a provision","وَعَلَى ٱلْمُقْتِرِ قَدَرُهُۥ","بِٱلْمَعْرُوفِ ۖ حَقًّا عَلَى",330],["2:240:8",39,"مَّتَـٰعًا","provision","أَزْوَٰجًۭا وَصِيَّةًۭ لِّأَزْوَٰجِهِم","إِلَى ٱلْحَوْلِ غَيْرَ",330],["2:241:2",39,"مَتَـٰعٌۢ","(is) a provision","وَلِلْمُطَلَّقَـٰتِ","بِٱلْمَعْرُوفِ ۖ حَقًّا عَلَى",330],["3:14:18",51,"مَتَـٰعُ","(is) provision","وَٱلْأَنْعَـٰمِ وَٱلْحَرْثِ ۗ ذَٰلِكَ","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ وَٱللَّهُ",330],["3:185:22",74,"مَتَـٰعُ","enjoyment","ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا","ٱلْغُرُورِ",330],["3:197:1",76,"مَتَـٰعٌۭ","An enjoyment","","قَلِيلٌۭ ثُمَّ مَأْوَىٰهُمْ",330],["4:24:23",82,"ٱسْتَمْتَعْتُم","you benefit[ed]","غَيْرَ مُسَـٰفِحِينَ ۚ فَمَا","بِهِۦ مِنْهُنَّ فَـَٔاتُوهُنَّ",1260],["4:77:39",90,"مَتَـٰعُ","Enjoyment","أَجَلٍۢ قَرِيبٍۢ ۗ قُلْ","ٱلدُّنْيَا قَلِيلٌۭ وَٱلْـَٔاخِرَةُ",330],["4:102:35",95,"وَأَمْتِعَتِكُمْ","and your baggage","تَغْفُلُونَ عَنْ أَسْلِحَتِكُمْ","فَيَمِيلُونَ عَلَيْكُم مَّيْلَةًۭ",330],["5:96:6",124,"مَتَـٰعًۭا","(as) provision","صَيْدُ ٱلْبَحْرِ وَطَعَامُهُۥ","لَّكُمْ وَلِلسَّيَّارَةِ ۖ وَحُرِّمَ",330],["6:128:15",144,"ٱسْتَمْتَعَ","profited","مِّنَ ٱلْإِنسِ رَبَّنَا","بَعْضُنَا بِبَعْضٍۢ وَبَلَغْنَآ",1260],["7:24:10",153,"وَمَتَـٰعٌ","and livelihood","فِى ٱلْأَرْضِ مُسْتَقَرٌّۭ","إِلَىٰ حِينٍۢ",330],["9:38:22",193,"مَتَـٰعُ","(is the) enjoyment","مِنَ ٱلْـَٔاخِرَةِ ۚ فَمَا","ٱلْحَيَوٰةِ ٱلدُّنْيَا فِى",330],["9:69:11",198,"فَٱسْتَمْتَعُوا۟","So they enjoyed","وَأَكْثَرَ أَمْوَٰلًۭا وَأَوْلَـٰدًۭا","بِخَلَـٰقِهِمْ فَٱسْتَمْتَعْتُم بِخَلَـٰقِكُمْ",1260],["9:69:13",198,"فَٱسْتَمْتَعْتُم","and you have enjoyed","وَأَوْلَـٰدًۭا فَٱسْتَمْتَعُوا۟ بِخَلَـٰقِهِمْ","بِخَلَـٰقِكُمْ كَمَا ٱسْتَمْتَعَ",1260],["9:69:16",198,"ٱسْتَمْتَعَ","enjoyed","فَٱسْتَمْتَعْتُم بِخَلَـٰقِكُمْ كَمَا","ٱلَّذِينَ مِن قَبْلِكُم",1260],["10:23:16",211,"مَّتَـٰعَ","(the) enjoyment","بَغْيُكُمْ عَلَىٰٓ أَنفُسِكُم ۖ","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ ثُمَّ",330],["10:70:1",216,"مَتَـٰعٌۭ","An enjoyment","","فِى ٱلدُّنْيَا ثُمَّ",330],["10:98:19",220,"وَمَتَّعْنَـٰهُمْ","and We granted them enjoyment","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا","إِلَىٰ حِينٍۢ",553],["11:3:7",221,"يُمَتِّعْكُم","He will let you","ثُمَّ تُوبُوٓا۟ إِلَيْهِ","مَّتَـٰعًا حَسَنًا إِلَىٰٓ",553],["11:3:8",221,"مَّتَـٰعًا","enjoy","تُوبُوٓا۟ إِلَيْهِ يُمَتِّعْكُم","حَسَنًا إِلَىٰٓ أَجَلٍۢ",330],["11:48:13",227,"سَنُمَتِّعُهُمْ","We will grant enjoyment","مِّمَّن مَّعَكَ ۚ وَأُمَمٌۭ","ثُمَّ يَمَسُّهُم مِّنَّا",553],["11:65:3",229,"تَمَتَّعُوا۟","Enjoy (yourselves)","فَعَقَرُوهَا فَقَالَ","فِى دَارِكُمْ ثَلَـٰثَةَ",802],["12:17:9",237,"مَتَـٰعِنَا","our possessions","وَتَرَكْنَا يُوسُفَ عِندَ","فَأَكَلَهُ ٱلذِّئْبُ ۖ وَمَآ",330],["12:65:3",243,"مَتَـٰعَهُمْ","their baggage","وَلَمَّا فَتَحُوا۟","وَجَدُوا۟ بِضَـٰعَتَهُمْ رُدَّتْ",330],["12:79:9",245,"مَتَـٰعَنَا","our possession","إِلَّا مَن وَجَدْنَا","عِندَهُۥٓ إِنَّآ إِذًۭا",330],["13:17:20",251,"مَتَـٰعٍۢ","utensils","ٱبْتِغَآءَ حِلْيَةٍ أَوْ","زَبَدٌۭ مِّثْلُهُۥ ۚ كَذَٰلِكَ",330],["13:26:16",252,"مَتَـٰعٌۭ","an enjoyment","فِى ٱلْـَٔاخِرَةِ إِلَّا","",330],["14:30:8",259,"تَمَتَّعُوا۟","Enjoy","عَن سَبِيلِهِۦ ۗ قُلْ","فَإِنَّ مَصِيرَكُمْ إِلَى",802],["15:3:3",262,"وَيَتَمَتَّعُوا۟","and enjoy","ذَرْهُمْ يَأْكُلُوا۟","وَيُلْهِهِمُ ٱلْأَمَلُ ۖ فَسَوْفَ",802],["15:88:6",266,"مَتَّعْنَا","We have bestowed","عَيْنَيْكَ إِلَىٰ مَا","بِهِۦٓ أَزْوَٰجًۭا مِّنْهُمْ",553],["16:55:4",273,"فَتَمَتَّعُوا۟ ۖ","Then enjoy yourselves","لِيَكْفُرُوا۟ بِمَآ ءَاتَيْنَـٰهُمْ ۚ","فَسَوْفَ تَعْلَمُونَ",802],["16:80:23",276,"وَمَتَـٰعًا","and a provision","وَأَوْبَارِهَا وَأَشْعَارِهَآ أَثَـٰثًۭا","إِلَىٰ حِينٍۢ",330],["16:117:1",280,"مَتَـٰعٌۭ","An enjoyment","","قَلِيلٌۭ وَلَهُمْ عَذَابٌ",330],["20:131:6",321,"مَتَّعْنَا","We have given for enjoyment","عَيْنَيْكَ إِلَىٰ مَا","بِهِۦٓ أَزْوَٰجًۭا مِّنْهُمْ",553],["21:44:2",325,"مَتَّعْنَا","We gave provision","بَلْ","هَـٰٓؤُلَآءِ وَءَابَآءَهُمْ حَتَّىٰ",553],["21:111:6",331,"وَمَتَـٰعٌ","and an enjoyment","لَعَلَّهُۥ فِتْنَةٌۭ لَّكُمْ","إِلَىٰ حِينٍۢ",330],["24:29:10",353,"مَتَـٰعٌۭ","(is) a provision","غَيْرَ مَسْكُونَةٍۢ فِيهَا","لَّكُمْ ۚ وَٱللَّهُ يَعْلَمُ",330],["25:18:14",361,"مَّتَّعْتَهُمْ","You gave them comforts","مِنْ أَوْلِيَآءَ وَلَـٰكِن","وَءَابَآءَهُمْ حَتَّىٰ نَسُوا۟",553],["26:205:3",375,"مَّتَّعْنَـٰهُمْ","We let them enjoy","أَفَرَءَيْتَ إِن","سِنِينَ",553],["26:207:6",376,"يُمَتَّعُونَ","enjoyment they were given","عَنْهُم مَّا كَانُوا۟","",553],["28:60:5",393,"فَمَتَـٰعُ","(is) an enjoyment","أُوتِيتُم مِّن شَىْءٍۢ","ٱلْحَيَوٰةِ ٱلدُّنْيَا وَزِينَتُهَا ۚ",330],["28:61:8",393,"مَّتَّعْنَـٰهُ","We provided him","فَهُوَ لَـٰقِيهِ كَمَن","مَتَـٰعَ ٱلْحَيَوٰةِ ٱلدُّنْيَا",553],["28:61:9",393,"مَتَـٰعَ","enjoyment","لَـٰقِيهِ كَمَن مَّتَّعْنَـٰهُ","ٱلْحَيَوٰةِ ٱلدُّنْيَا ثُمَّ",330],["29:66:4",404,"وَلِيَتَمَتَّعُوا۟ ۖ","and they may enjoy (themselves)","لِيَكْفُرُوا۟ بِمَآ ءَاتَيْنَـٰهُمْ","فَسَوْفَ يَعْلَمُونَ",802],["30:34:4",408,"فَتَمَتَّعُوا۟","Then enjoy","لِيَكْفُرُوا۟ بِمَآ ءَاتَيْنَـٰهُمْ ۚ","فَسَوْفَ تَعْلَمُونَ",802],["31:24:1",413,"نُمَتِّعُهُمْ","We grant them enjoyment","","قَلِيلًۭا ثُمَّ نَضْطَرُّهُمْ",553],["33:16:13",420,"تُمَتَّعُونَ","you will be allowed to enjoy","ٱلْقَتْلِ وَإِذًۭا لَّا","إِلَّا قَلِيلًۭا",553],["33:28:12",421,"أُمَتِّعْكُنَّ","I will provide for you","ٱلدُّنْيَا وَزِينَتَهَا فَتَعَالَيْنَ","وَأُسَرِّحْكُنَّ سَرَاحًۭا جَمِيلًۭا",553],["33:49:19",424,"فَمَتِّعُوهُنَّ","So provide for them","مِنْ عِدَّةٍۢ تَعْتَدُّونَهَا ۖ","وَسَرِّحُوهُنَّ سَرَاحًۭا جَمِيلًۭا",553],["33:53:41",425,"مَتَـٰعًۭا","(for) anything","ٱلْحَقِّ ۚ وَإِذَا سَأَلْتُمُوهُنَّ","فَسْـَٔلُوهُنَّ مِن وَرَآءِ",330],["36:44:4",443,"وَمَتَـٰعًا","and provision","إِلَّا رَحْمَةًۭ مِّنَّا","إِلَىٰ حِينٍۢ",330],["37:148:2",451,"فَمَتَّعْنَـٰهُمْ","so We gave them enjoyment","فَـَٔامَنُوا۟","إِلَىٰ حِينٍۢ",553],["39:8:28",459,"تَمَتَّعْ","Enjoy","عَن سَبِيلِهِۦ ۚ قُلْ","بِكُفْرِكَ قَلِيلًا ۖ إِنَّكَ",802],["40:39:6",471,"مَتَـٰعٌۭ","(is) enjoyment","هَـٰذِهِ ٱلْحَيَوٰةُ ٱلدُّنْيَا","وَإِنَّ ٱلْـَٔاخِرَةَ هِىَ",330],["42:36:5",487,"فَمَتَـٰعُ","(is) but a passing enjoyment","أُوتِيتُم مِّن شَىْءٍۢ","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ وَمَا",330],["43:29:2",491,"مَتَّعْتُ","I gave enjoyment","بَلْ","هَـٰٓؤُلَآءِ وَءَابَآءَهُمْ حَتَّىٰ",553],["43:35:6",492,"مَتَـٰعُ","an enjoyment","كُلُّ ذَٰلِكَ لَمَّا","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۚ وَٱلْـَٔاخِرَةُ",330],["46:20:12",504,"وَٱسْتَمْتَعْتُم","and you took your pleasures","فِى حَيَاتِكُمُ ٱلدُّنْيَا","بِهَا فَٱلْيَوْمَ تُجْزَوْنَ",1260],["47:12:15",508,"يَتَمَتَّعُونَ","they enjoy","ٱلْأَنْهَـٰرُ ۖ وَٱلَّذِينَ كَفَرُوا۟","وَيَأْكُلُونَ كَمَا تَأْكُلُ",802],["51:43:6",522,"تَمَتَّعُوا۟","Enjoy (yourselves)","إِذْ قِيلَ لَهُمْ","حَتَّىٰ حِينٍۢ",802],["56:73:4",536,"وَمَتَـٰعًۭا","and a provision","نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةًۭ","لِّلْمُقْوِينَ",330],["57:20:38",540,"مَتَـٰعُ","(the) enjoyment","ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا","ٱلْغُرُورِ",330],["77:46:2",581,"وَتَمَتَّعُوا۟","and enjoy yourselves","كُلُوا۟","قَلِيلًا إِنَّكُم مُّجْرِمُونَ",802],["79:33:1",584,"مَتَـٰعًۭا","(As) a provision","","لَّكُمْ وَلِأَنْعَـٰمِكُمْ",330],["80:32:1",585,"مَّتَـٰعًۭا","(As) a provision","","لَّكُمْ وَلِأَنْعَـٰمِكُمْ",330]]