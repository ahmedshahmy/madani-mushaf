[["2:124:17",19,"يَنَالُ","reach","ذُرِّيَّتِى ۖ قَالَ لَا","عَهْدِى ٱلظَّـٰلِمِينَ",806],["3:92:2",62,"تَنَالُوا۟","will you attain","لَن","ٱلْبِرَّ حَتَّىٰ تُنفِقُوا۟",806],["5:94:9",123,"تَنَالُهُۥٓ","can reach it","بِشَىْءٍۢ مِّنَ ٱلصَّيْدِ","أَيْدِيكُمْ وَرِمَاحُكُمْ لِيَعْلَمَ",806],["7:37:12",154,"يَنَالُهُمْ","will reach them","كَذَّبَ بِـَٔايَـٰتِهِۦٓ ۚ أُو۟لَـٰٓئِكَ","نَصِيبُهُم مِّنَ ٱلْكِتَـٰبِ ۖ",806],["7:49:5",156,"يَنَالُهُمُ","(will) grant them","ٱلَّذِينَ أَقْسَمْتُمْ لَا","ٱللَّهُ بِرَحْمَةٍ ۚ ٱدْخُلُوا۟",806],["7:152:5",169,"سَيَنَالُهُمْ","will reach them","ٱلَّذِينَ ٱتَّخَذُوا۟ ٱلْعِجْلَ","غَضَبٌۭ مِّن رَّبِّهِمْ",806],["9:74:15",199,"يَنَالُوا۟ ۚ","they could attain","وَهَمُّوا۟ بِمَا لَمْ","وَمَا نَقَمُوٓا۟ إِلَّآ",806],["9:120:37",206,"يَنَالُونَ","they inflict","يَغِيظُ ٱلْكُفَّارَ وَلَا","مِنْ عَدُوٍّۢ نَّيْلًا",806],["9:120:40",206,"نَّيْلًا","an infliction","يَنَالُونَ مِنْ عَدُوٍّۢ","إِلَّا كُتِبَ لَهُم",4096],["22:37:2",336,"يَنَالَ","reach","لَن","ٱللَّهَ لُحُومُهَا وَلَا",806],["22:37:8",336,"يَنَالُهُ","reaches Him","وَلَا دِمَآؤُهَا وَلَـٰكِن","ٱلتَّقْوَىٰ مِنكُمْ ۚ كَذَٰلِكَ",806],["33:25:7",421,"يَنَالُوا۟","they obtained","كَفَرُوا۟ بِغَيْظِهِمْ لَمْ","خَيْرًۭا ۚ وَكَفَى ٱللَّهُ",806]]