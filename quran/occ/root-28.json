[["2:40:3",7,"ٱذْكُرُوا۟","Remember","يَـٰبَنِىٓ إِسْرَٰٓءِيلَ","نِعْمَتِىَ ٱلَّتِىٓ أَنْعَمْتُ",130],["2:47:3",7,"ٱذْكُرُوا۟","Remember","يَـٰبَنِىٓ إِسْرَٰٓءِيلَ","نِعْمَتِىَ ٱلَّتِىٓ أَنْعَمْتُ",130],["2:63:11",10,"وَٱذْكُرُوا۟","and remember","مَآ ءَاتَيْنَـٰكُم بِقُوَّةٍۢ","مَا فِيهِ لَعَلَّكُمْ",130],["2:114:8",18,"يُذْكَرَ","be mentioned","مَسَـٰجِدَ ٱللَّهِ أَن","فِيهَا ٱسْمُهُۥ وَسَعَىٰ",130],["2:122:3",19,"ٱذْكُرُوا۟","Remember","يَـٰبَنِىٓ إِسْرَٰٓءِيلَ","نِعْمَتِىَ ٱلَّتِىٓ أَنْعَمْتُ",130],["2:152:1",23,"فَٱذْكُرُونِىٓ","So remember Me","","أَذْكُرْكُمْ وَٱشْكُرُوا۟ لِى",130],["2:152:2",23,"أَذْكُرْكُمْ","I will remember you","فَٱذْكُرُونِىٓ","وَٱشْكُرُوا۟ لِى وَلَا",130],["2:198:13",31,"فَٱذْكُرُوا۟","then remember","أَفَضْتُم مِّنْ عَرَفَـٰتٍۢ","ٱللَّهَ عِندَ ٱلْمَشْعَرِ",130],["2:198:18",31,"وَٱذْكُرُوهُ","And remember Him","عِندَ ٱلْمَشْعَرِ ٱلْحَرَامِ ۖ","كَمَا هَدَىٰكُمْ وَإِن",130],["2:200:4",31,"فَٱذْكُرُوا۟","then remember","فَإِذَا قَضَيْتُم مَّنَـٰسِكَكُمْ","ٱللَّهَ كَذِكْرِكُمْ ءَابَآءَكُمْ",130],["2:200:6",31,"كَذِكْرِكُمْ","as you remember","مَّنَـٰسِكَكُمْ فَٱذْكُرُوا۟ ٱللَّهَ","ءَابَآءَكُمْ أَوْ أَشَدَّ",149],["2:200:10",31,"ذِكْرًۭا ۗ","remembrance","ءَابَآءَكُمْ أَوْ أَشَدَّ","فَمِنَ ٱلنَّاسِ مَن",149],["2:203:1",32,"۞ وَٱذْكُرُوا۟","And remember","","ٱللَّهَ فِىٓ أَيَّامٍۢ",130],["2:221:39",35,"يَتَذَكَّرُونَ","take heed","ءَايَـٰتِهِۦ لِلنَّاسِ لَعَلَّهُمْ","",233],["2:231:26",37,"وَٱذْكُرُوا۟","and remember","ءَايَـٰتِ ٱللَّهِ هُزُوًۭا ۚ","نِعْمَتَ ٱللَّهِ عَلَيْكُمْ",130],["2:235:17",38,"سَتَذْكُرُونَهُنَّ","will mention them","عَلِمَ ٱللَّهُ أَنَّكُمْ","وَلَـٰكِن لَّا تُوَاعِدُوهُنَّ",130],["2:239:8",39,"فَٱذْكُرُوا۟","then remember","رُكْبَانًۭا ۖ فَإِذَآ أَمِنتُمْ","ٱللَّهَ كَمَا عَلَّمَكُم",130],["2:269:13",45,"يَذَّكَّرُ","remembers","خَيْرًۭا كَثِيرًۭا ۗ وَمَا","إِلَّآ أُو۟لُوا۟ ٱلْأَلْبَـٰبِ",233],["2:282:69",48,"فَتُذَكِّرَ","then will remind","أَن تَضِلَّ إِحْدَىٰهُمَا","إِحْدَىٰهُمَا ٱلْأُخْرَىٰ ۚ وَلَا",537],["3:7:43",50,"يَذَّكَّرُ","will take heed","عِندِ رَبِّنَا ۗ وَمَا","إِلَّآ أُو۟لُوا۟ ٱلْأَلْبَـٰبِ",233],["3:36:13",54,"ٱلذَّكَرُ","the male","بِمَا وَضَعَتْ وَلَيْسَ","كَٱلْأُنثَىٰ ۖ وَإِنِّى سَمَّيْتُهَا",536],["3:41:15",55,"وَٱذْكُر","And remember","أَيَّامٍ إِلَّا رَمْزًۭا ۗ","رَّبَّكَ كَثِيرًۭا وَسَبِّحْ",130],["3:58:6",57,"وَٱلذِّكْرِ","and the Reminder","عَلَيْكَ مِنَ ٱلْـَٔايَـٰتِ","ٱلْحَكِيمِ",149],["3:103:7",63,"وَٱذْكُرُوا۟","And remember","جَمِيعًۭا وَلَا تَفَرَّقُوا۟ ۚ","نِعْمَتَ ٱللَّهِ عَلَيْكُمْ",130],["3:135:8",67,"ذَكَرُوا۟","they remember","أَوْ ظَلَمُوٓا۟ أَنفُسَهُمْ","ٱللَّهَ فَٱسْتَغْفَرُوا۟ لِذُنُوبِهِمْ",130],["3:191:2",75,"يَذْكُرُونَ","remember","ٱلَّذِينَ","ٱللَّهَ قِيَـٰمًۭا وَقُعُودًۭا",130],["3:195:11",76,"ذَكَرٍ","(whether) male","عَـٰمِلٍۢ مِّنكُم مِّن","أَوْ أُنثَىٰ ۖ بَعْضُكُم",536],["4:11:5",78,"لِلذَّكَرِ","for the male","ٱللَّهُ فِىٓ أَوْلَـٰدِكُمْ ۖ","مِثْلُ حَظِّ ٱلْأُنثَيَيْنِ ۚ",536],["4:103:4",95,"فَٱذْكُرُوا۟","then remember","فَإِذَا قَضَيْتُمُ ٱلصَّلَوٰةَ","ٱللَّهَ قِيَـٰمًۭا وَقُعُودًۭا",130],["4:124:6",98,"ذَكَرٍ","(the) male","مِنَ ٱلصَّـٰلِحَـٰتِ مِن","أَوْ أُنثَىٰ وَهُوَ",536],["4:142:16",101,"يَذْكُرُونَ","they remember","يُرَآءُونَ ٱلنَّاسَ وَلَا","ٱللَّهَ إِلَّا قَلِيلًۭا",130],["4:176:38",106,"فَلِلذَّكَرِ","then the male will have","إِخْوَةًۭ رِّجَالًۭا وَنِسَآءًۭ","مِثْلُ حَظِّ ٱلْأُنثَيَيْنِ ۗ",536],["5:4:22",107,"وَٱذْكُرُوا۟","but mention","مِمَّآ أَمْسَكْنَ عَلَيْكُمْ","ٱسْمَ ٱللَّهِ عَلَيْهِ ۖ",130],["5:7:1",108,"وَٱذْكُرُوا۟","And remember","","نِعْمَةَ ٱللَّهِ عَلَيْكُمْ",130],["5:11:4",109,"ٱذْكُرُوا۟","Remember","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","نِعْمَتَ ٱللَّهِ عَلَيْكُمْ",130],["5:13:15",109,"ذُكِّرُوا۟","they were reminded","وَنَسُوا۟ حَظًّۭا مِّمَّا","بِهِۦ ۚ وَلَا تَزَالُ",537],["5:14:11",110,"ذُكِّرُوا۟","they were reminded","فَنَسُوا۟ حَظًّۭا مِّمَّا","بِهِۦ فَأَغْرَيْنَا بَيْنَهُمُ",537],["5:20:6",111,"ٱذْكُرُوا۟","remember","مُوسَىٰ لِقَوْمِهِۦ يَـٰقَوْمِ","نِعْمَةَ ٱللَّهِ عَلَيْكُمْ",130],["5:91:14",123,"ذِكْرِ","(the) remembrance","وَٱلْمَيْسِرِ وَيَصُدَّكُمْ عَن","ٱللَّهِ وَعَنِ ٱلصَّلَوٰةِ ۖ",149],["5:110:7",126,"ٱذْكُرْ","Remember","يَـٰعِيسَى ٱبْنَ مَرْيَمَ","نِعْمَتِى عَلَيْكَ وَعَلَىٰ",130],["6:44:4",132,"ذُكِّرُوا۟","they were reminded","فَلَمَّا نَسُوا۟ مَا","بِهِۦ فَتَحْنَا عَلَيْهِمْ",537],["6:68:20",135,"ٱلذِّكْرَىٰ","the reminder","فَلَا تَقْعُدْ بَعْدَ","مَعَ ٱلْقَوْمِ ٱلظَّـٰلِمِينَ",448],["6:69:10",136,"ذِكْرَىٰ","(for) reminder","مِّن شَىْءٍۢ وَلَـٰكِن","لَعَلَّهُمْ يَتَّقُونَ",448],["6:70:10",136,"وَذَكِّرْ","But remind","وَغَرَّتْهُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا ۚ","بِهِۦٓ أَن تُبْسَلَ",537],["6:80:25",137,"تَتَذَكَّرُونَ","you take heed","شَىْءٍ عِلْمًا ۗ أَفَلَا","",233],["6:90:15",138,"ذِكْرَىٰ","a reminder","إِنْ هُوَ إِلَّا","لِلْعَـٰلَمِينَ",448],["6:118:3",142,"ذُكِرَ","(is) mentioned","فَكُلُوا۟ مِمَّا","ٱسْمُ ٱللَّهِ عَلَيْهِ",130],["6:119:6",143,"ذُكِرَ","has been mentioned","أَلَّا تَأْكُلُوا۟ مِمَّا","ٱسْمُ ٱللَّهِ عَلَيْهِ",130],["6:121:5",143,"يُذْكَرِ","has been mentioned","تَأْكُلُوا۟ مِمَّا لَمْ","ٱسْمُ ٱللَّهِ عَلَيْهِ",130],["6:126:9",144,"يَذَّكَّرُونَ","who take heed","فَصَّلْنَا ٱلْـَٔايَـٰتِ لِقَوْمٍۢ","",233],["6:138:17",146,"يَذْكُرُونَ","they mention","ظُهُورُهَا وَأَنْعَـٰمٌۭ لَّا","ٱسْمَ ٱللَّهِ عَلَيْهَا",130],["6:139:8",146,"لِّذُكُورِنَا","for our males","هَـٰذِهِ ٱلْأَنْعَـٰمِ خَالِصَةٌۭ","وَمُحَرَّمٌ عَلَىٰٓ أَزْوَٰجِنَا ۖ",536],["6:143:10",147,"ءَآلذَّكَرَيْنِ","(Are) the two males","ٱلْمَعْزِ ٱثْنَيْنِ ۗ قُلْ","حَرَّمَ أَمِ ٱلْأُنثَيَيْنِ",536],["6:144:8",147,"ءَآلذَّكَرَيْنِ","(Is it) the two males","ٱلْبَقَرِ ٱثْنَيْنِ ۗ قُلْ","حَرَّمَ أَمِ ٱلْأُنثَيَيْنِ",536],["6:152:35",149,"تَذَكَّرُونَ","remember","وَصَّىٰكُم بِهِۦ لَعَلَّكُمْ","",233],["7:2:12",151,"وَذِكْرَىٰ","and a reminder","مِّنْهُ لِتُنذِرَ بِهِۦ","لِلْمُؤْمِنِينَ",448],["7:3:14",151,"تَذَكَّرُونَ","you remember","أَوْلِيَآءَ ۗ قَلِيلًۭا مَّا","",233],["7:26:19",153,"يَذَّكَّرُونَ","remember","ءَايَـٰتِ ٱللَّهِ لَعَلَّهُمْ","",233],["7:57:29",157,"تَذَكَّرُونَ","take heed","نُخْرِجُ ٱلْمَوْتَىٰ لَعَلَّكُمْ","",233],["7:63:4",158,"ذِكْرٌۭ","a reminder","أَوَعَجِبْتُمْ أَن جَآءَكُمْ","مِّن رَّبِّكُمْ عَلَىٰ",149],["7:69:4",159,"ذِكْرٌۭ","a reminder","أَوَعَجِبْتُمْ أَن جَآءَكُمْ","مِّن رَّبِّكُمْ عَلَىٰ",149],["7:69:11",159,"وَٱذْكُرُوٓا۟","And remember","رَجُلٍۢ مِّنكُمْ لِيُنذِرَكُمْ ۚ","إِذْ جَعَلَكُمْ خُلَفَآءَ",130],["7:69:23",159,"فَٱذْكُرُوٓا۟","So remember","فِى ٱلْخَلْقِ بَصْۜطَةًۭ ۖ","ءَالَآءَ ٱللَّهِ لَعَلَّكُمْ",130],["7:74:1",160,"وَٱذْكُرُوٓا۟","And remember","","إِذْ جَعَلَكُمْ خُلَفَآءَ",130],["7:74:18",160,"فَٱذْكُرُوٓا۟","So remember","وَتَنْحِتُونَ ٱلْجِبَالَ بُيُوتًۭا ۖ","ءَالَآءَ ٱللَّهِ وَلَا",130],["7:86:15",161,"وَٱذْكُرُوٓا۟","And remember","بِهِۦ وَتَبْغُونَهَا عِوَجًۭا ۚ","إِذْ كُنتُمْ قَلِيلًۭا",130],["7:130:10",165,"يَذَّكَّرُونَ","receive admonition","مِّنَ ٱلثَّمَرَٰتِ لَعَلَّهُمْ","",233],["7:165:4",172,"ذُكِّرُوا۟","they had been reminded","فَلَمَّا نَسُوا۟ مَا","بِهِۦٓ أَنجَيْنَا ٱلَّذِينَ",537],["7:171:15",173,"وَٱذْكُرُوا۟","and remember","مَآ ءَاتَيْنَـٰكُم بِقُوَّةٍۢ","مَا فِيهِ لَعَلَّكُمْ",130],["7:201:9",176,"تَذَكَّرُوا۟","they remember (Allah)","طَـٰٓئِفٌۭ مِّنَ ٱلشَّيْطَـٰنِ","فَإِذَا هُم مُّبْصِرُونَ",233],["7:205:1",176,"وَٱذْكُر","And remember","","رَّبَّكَ فِى نَفْسِكَ",130],["8:2:5",177,"ذُكِرَ","is mentioned","ٱلْمُؤْمِنُونَ ٱلَّذِينَ إِذَا","ٱللَّهُ وَجِلَتْ قُلُوبُهُمْ",130],["8:26:1",180,"وَٱذْكُرُوٓا۟","And remember","","إِذْ أَنتُمْ قَلِيلٌۭ",130],["8:45:8",182,"وَٱذْكُرُوا۟","and remember","لَقِيتُمْ فِئَةًۭ فَٱثْبُتُوا۟","ٱللَّهَ كَثِيرًۭا لَّعَلَّكُمْ",130],["8:57:10",184,"يَذَّكَّرُونَ","take heed","مَّنْ خَلْفَهُمْ لَعَلَّهُمْ","",233],["9:126:16",207,"يَذَّكَّرُونَ","pay heed","يَتُوبُونَ وَلَا هُمْ","",233],["10:3:29",208,"تَذَكَّرُونَ","you remember","رَبُّكُمْ فَٱعْبُدُوهُ ۚ أَفَلَا","",233],["10:71:14",217,"وَتَذْكِيرِى","and my reminding","كَبُرَ عَلَيْكُم مَّقَامِى","بِـَٔايَـٰتِ ٱللَّهِ فَعَلَى",4309],["11:24:11",224,"تَذَكَّرُونَ","you take heed","يَسْتَوِيَانِ مَثَلًا ۚ أَفَلَا","",233],["11:30:9",225,"تَذَكَّرُونَ","you take heed","إِن طَرَدتُّهُمْ ۚ أَفَلَا","",233],["11:114:13",234,"ذِكْرَىٰ","(is) a reminder","يُذْهِبْنَ ٱلسَّيِّـَٔاتِ ۚ ذَٰلِكَ","لِلذَّٰكِرِينَ",448],["11:114:14",234,"لِلذَّٰكِرِينَ","for those who remember","ٱلسَّيِّـَٔاتِ ۚ ذَٰلِكَ ذِكْرَىٰ","",2134],["11:120:16",235,"وَذِكْرَىٰ","and a reminder","هَـٰذِهِ ٱلْحَقُّ وَمَوْعِظَةٌۭ","لِلْمُؤْمِنِينَ",448],["12:42:7",240,"ٱذْكُرْنِى","Mention me","أَنَّهُۥ نَاجٍۢ مِّنْهُمَا","عِندَ رَبِّكَ فَأَنسَىٰهُ",130],["12:42:12",240,"ذِكْرَ","(the) mention","رَبِّكَ فَأَنسَىٰهُ ٱلشَّيْطَـٰنُ","رَبِّهِۦ فَلَبِثَ فِى",149],["12:45:5",241,"وَٱدَّكَرَ","and remembered","ٱلَّذِى نَجَا مِنْهُمَا","بَعْدَ أُمَّةٍ أَنَا۠",4794],["12:85:4",245,"تَذْكُرُ","remembering","قَالُوا۟ تَٱللَّهِ تَفْتَؤُا۟","يُوسُفَ حَتَّىٰ تَكُونَ",130],["12:104:9",248,"ذِكْرٌۭ","a reminder","إِنْ هُوَ إِلَّا","لِّلْعَـٰلَمِينَ",149],["13:19:13",252,"يَتَذَكَّرُ","pay heed","هُوَ أَعْمَىٰٓ ۚ إِنَّمَا","أُو۟لُوا۟ ٱلْأَلْبَـٰبِ",233],["13:28:5",252,"بِذِكْرِ","in the remembrance","ءَامَنُوا۟ وَتَطْمَئِنُّ قُلُوبُهُم","ٱللَّهِ ۗ أَلَا بِذِكْرِ",149],["13:28:8",252,"بِذِكْرِ","in the remembrance","بِذِكْرِ ٱللَّهِ ۗ أَلَا","ٱللَّهِ تَطْمَئِنُّ ٱلْقُلُوبُ",149],["14:5:12",255,"وَذَكِّرْهُم","And remind them","ٱلظُّلُمَـٰتِ إِلَى ٱلنُّورِ","بِأَيَّىٰمِ ٱللَّهِ ۚ إِنَّ",537],["14:6:5",256,"ٱذْكُرُوا۟","Remember","قَالَ مُوسَىٰ لِقَوْمِهِ","نِعْمَةَ ٱللَّهِ عَلَيْكُمْ",130],["14:25:12",259,"يَتَذَكَّرُونَ","remember","ٱلْأَمْثَالَ لِلنَّاسِ لَعَلَّهُمْ","",233],["14:52:11",261,"وَلِيَذَّكَّرَ","and that may take heed","هُوَ إِلَـٰهٌۭ وَٰحِدٌۭ","أُو۟لُوا۟ ٱلْأَلْبَـٰبِ",233],["15:6:6",262,"ٱلذِّكْرُ","the Reminder","ٱلَّذِى نُزِّلَ عَلَيْهِ","إِنَّكَ لَمَجْنُونٌۭ",149],["15:9:4",262,"ٱلذِّكْرَ","the Reminder","إِنَّا نَحْنُ نَزَّلْنَا","وَإِنَّا لَهُۥ لَحَـٰفِظُونَ",149],["16:13:13",268,"يَذَّكَّرُونَ","who remember","ذَٰلِكَ لَـَٔايَةًۭ لِّقَوْمٍۢ","",233],["16:17:7",269,"تَذَكَّرُونَ","remember","لَّا يَخْلُقُ ۗ أَفَلَا","",233],["16:43:11",272,"ٱلذِّكْرِ","(of) the Reminder","إِلَيْهِمْ ۚ فَسْـَٔلُوٓا۟ أَهْلَ","إِن كُنتُمْ لَا",149],["16:44:5",272,"ٱلذِّكْرَ","the Remembrance","وَٱلزُّبُرِ ۗ وَأَنزَلْنَآ إِلَيْكَ","لِتُبَيِّنَ لِلنَّاسِ مَا",149],["16:90:16",277,"تَذَكَّرُونَ","take heed","وَٱلْبَغْىِ ۚ يَعِظُكُمْ لَعَلَّكُمْ","",233],["16:97:5",278,"ذَكَرٍ","male","عَمِلَ صَـٰلِحًۭا مِّن","أَوْ أُنثَىٰ وَهُوَ",536],["17:41:6",286,"لِيَذَّكَّرُوا۟","that they may take heed","فِى هَـٰذَا ٱلْقُرْءَانِ","وَمَا يَزِيدُهُمْ إِلَّا",233],["17:46:11",286,"ذَكَرْتَ","you mention","ءَاذَانِهِمْ وَقْرًۭا ۚ وَإِذَا","رَبَّكَ فِى ٱلْقُرْءَانِ",130],["18:24:5",296,"وَٱذْكُر","And remember","أَن يَشَآءَ ٱللَّهُ ۚ","رَّبَّكَ إِذَا نَسِيتَ",130],["18:28:25",297,"ذِكْرِنَا","Our remembrance","أَغْفَلْنَا قَلْبَهُۥ عَن","وَٱتَّبَعَ هَوَىٰهُ وَكَانَ",149],["18:57:4",300,"ذُكِّرَ","is reminded","وَمَنْ أَظْلَمُ مِمَّن","بِـَٔايَـٰتِ رَبِّهِۦ فَأَعْرَضَ",537],["18:63:15",301,"أَذْكُرَهُۥ ۚ","I mention it","إِلَّا ٱلشَّيْطَـٰنُ أَنْ","وَٱتَّخَذَ سَبِيلَهُۥ فِى",130],["18:70:12",301,"ذِكْرًۭا","a mention","أُحْدِثَ لَكَ مِنْهُ","",149],["18:83:9",302,"ذِكْرًا","a remembrance","سَأَتْلُوا۟ عَلَيْكُم مِّنْهُ","",149],["18:101:7",304,"ذِكْرِى","My remembrance","فِى غِطَآءٍ عَن","وَكَانُوا۟ لَا يَسْتَطِيعُونَ",149],["19:2:1",305,"ذِكْرُ","(A) mention","","رَحْمَتِ رَبِّكَ عَبْدَهُۥ",149],["19:16:1",306,"وَٱذْكُرْ","And mention","","فِى ٱلْكِتَـٰبِ مَرْيَمَ",130],["19:41:1",308,"وَٱذْكُرْ","And mention","","فِى ٱلْكِتَـٰبِ إِبْرَٰهِيمَ ۚ",130],["19:51:1",308,"وَٱذْكُرْ","And mention","","فِى ٱلْكِتَـٰبِ مُوسَىٰٓ ۚ",130],["19:54:1",309,"وَٱذْكُرْ","And mention","","فِى ٱلْكِتَـٰبِ إِسْمَـٰعِيلَ ۚ",130],["19:56:1",309,"وَٱذْكُرْ","And mention","","فِى ٱلْكِتَـٰبِ إِدْرِيسَ ۚ",130],["19:67:2",310,"يَذْكُرُ","remember","أَوَلَا","ٱلْإِنسَـٰنُ أَنَّا خَلَقْنَـٰهُ",130],["20:3:2",312,"تَذْكِرَةًۭ","(as) a reminder","إِلَّا","لِّمَن يَخْشَىٰ",925],["20:14:11",313,"لِذِكْرِىٓ","for My remembrance","فَٱعْبُدْنِى وَأَقِمِ ٱلصَّلَوٰةَ","",149],["20:34:1",313,"وَنَذْكُرَكَ","And [we] remember You","","كَثِيرًا",130],["20:42:8",314,"ذِكْرِى","My remembrance","وَلَا تَنِيَا فِى","",149],["20:44:6",314,"يَتَذَكَّرُ","may take heed","قَوْلًۭا لَّيِّنًۭا لَّعَلَّهُۥ","أَوْ يَخْشَىٰ",233],["20:99:13",319,"ذِكْرًۭا","a Reminder","ءَاتَيْنَـٰكَ مِن لَّدُنَّا","",149],["20:113:14",319,"ذِكْرًۭا","remembrance","أَوْ يُحْدِثُ لَهُمْ","",149],["20:124:4",320,"ذِكْرِى","My remembrance","وَمَنْ أَعْرَضَ عَن","فَإِنَّ لَهُۥ مَعِيشَةًۭ",149],["21:2:4",322,"ذِكْرٍۢ","a Reminder","مَا يَأْتِيهِم مِّن","مِّن رَّبِّهِم مُّحْدَثٍ",149],["21:7:10",322,"ٱلذِّكْرِ","(of) the Reminder","إِلَيْهِمْ ۖ فَسْـَٔلُوٓا۟ أَهْلَ","إِن كُنتُمْ لَا",149],["21:10:6",322,"ذِكْرُكُمْ ۖ","(is) your mention","إِلَيْكُمْ كِتَـٰبًۭا فِيهِ","أَفَلَا تَعْقِلُونَ",149],["21:24:10",323,"ذِكْرُ","(is) a Reminder","هَاتُوا۟ بُرْهَـٰنَكُمْ ۖ هَـٰذَا","مَن مَّعِىَ وَذِكْرُ",149],["21:24:13",323,"وَذِكْرُ","and a Reminder","ذِكْرُ مَن مَّعِىَ","مَن قَبْلِى ۗ بَلْ",149],["21:36:11",325,"يَذْكُرُ","mentions","هُزُوًا أَهَـٰذَا ٱلَّذِى","ءَالِهَتَكُمْ وَهُم بِذِكْرِ",130],["21:36:14",325,"بِذِكْرِ","at (the) mention","يَذْكُرُ ءَالِهَتَكُمْ وَهُم","ٱلرَّحْمَـٰنِ هُمْ كَـٰفِرُونَ",149],["21:42:11",325,"ذِكْرِ","(the) remembrance","بَلْ هُمْ عَن","رَبِّهِم مُّعْرِضُونَ",149],["21:48:7",326,"وَذِكْرًۭا","and a Reminder","وَهَـٰرُونَ ٱلْفُرْقَانَ وَضِيَآءًۭ","لِّلْمُتَّقِينَ",149],["21:50:2",326,"ذِكْرٌۭ","(is) a Reminder","وَهَـٰذَا","مُّبَارَكٌ أَنزَلْنَـٰهُ ۚ أَفَأَنتُمْ",149],["21:60:4",327,"يَذْكُرُهُمْ","mention them","قَالُوا۟ سَمِعْنَا فَتًۭى","يُقَالُ لَهُۥٓ إِبْرَٰهِيمُ",130],["21:84:15",329,"وَذِكْرَىٰ","and a reminder","رَحْمَةًۭ مِّنْ عِندِنَا","لِلْعَـٰبِدِينَ",448],["21:105:7",331,"ٱلذِّكْرِ","the mention","ٱلزَّبُورِ مِنۢ بَعْدِ","أَنَّ ٱلْأَرْضَ يَرِثُهَا",149],["22:28:4",335,"وَيَذْكُرُوا۟","and mention","لِّيَشْهَدُوا۟ مَنَـٰفِعَ لَهُمْ","ٱسْمَ ٱللَّهِ فِىٓ",130],["22:34:5",336,"لِّيَذْكُرُوا۟","that they may mention","أُمَّةٍۢ جَعَلْنَا مَنسَكًۭا","ٱسْمَ ٱللَّهِ عَلَىٰ",130],["22:35:3",336,"ذُكِرَ","is mentioned","ٱلَّذِينَ إِذَا","ٱللَّهُ وَجِلَتْ قُلُوبُهُمْ",130],["22:36:10",336,"فَٱذْكُرُوا۟","So mention","لَكُمْ فِيهَا خَيْرٌۭ ۖ","ٱسْمَ ٱللَّهِ عَلَيْهَا",130],["22:40:23",337,"يُذْكَرُ","is mentioned","وَبِيَعٌۭ وَصَلَوَٰتٌۭ وَمَسَـٰجِدُ","فِيهَا ٱسْمُ ٱللَّهِ",130],["23:71:12",346,"بِذِكْرِهِمْ","their reminder","فِيهِنَّ ۚ بَلْ أَتَيْنَـٰهُم","فَهُمْ عَن ذِكْرِهِم",149],["23:71:15",346,"ذِكْرِهِم","their reminder","بِذِكْرِهِمْ فَهُمْ عَن","مُّعْرِضُونَ",149],["23:85:5",347,"تَذَكَّرُونَ","you remember","لِلَّهِ ۚ قُلْ أَفَلَا","",233],["23:110:5",349,"ذِكْرِى","My remembrance","سِخْرِيًّا حَتَّىٰٓ أَنسَوْكُمْ","وَكُنتُم مِّنْهُمْ تَضْحَكُونَ",149],["24:1:9",350,"تَذَكَّرُونَ","take heed","ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ لَّعَلَّكُمْ","",233],["24:27:18",352,"تَذَكَّرُونَ","pay heed","خَيْرٌۭ لَّكُمْ لَعَلَّكُمْ","",233],["24:36:7",354,"وَيُذْكَرَ","and be mentioned","ٱللَّهُ أَن تُرْفَعَ","فِيهَا ٱسْمُهُۥ يُسَبِّحُ",130],["24:37:8",355,"ذِكْرِ","(the) remembrance of Allah","وَلَا بَيْعٌ عَن","ٱللَّهِ وَإِقَامِ ٱلصَّلَوٰةِ",149],["25:18:18",361,"ٱلذِّكْرَ","the Message","وَءَابَآءَهُمْ حَتَّىٰ نَسُوا۟","وَكَانُوا۟ قَوْمًۢا بُورًۭا",149],["25:29:4",362,"ٱلذِّكْرِ","the Reminder","لَّقَدْ أَضَلَّنِى عَنِ","بَعْدَ إِذْ جَآءَنِى ۗ",149],["25:50:4",364,"لِيَذَّكَّرُوا۟","that they may remember","وَلَقَدْ صَرَّفْنَـٰهُ بَيْنَهُمْ","فَأَبَىٰٓ أَكْثَرُ ٱلنَّاسِ",233],["25:62:10",365,"يَذَّكَّرَ","remember","لِّمَنْ أَرَادَ أَن","أَوْ أَرَادَ شُكُورًۭا",233],["25:73:3",366,"ذُكِّرُوا۟","they are reminded","وَٱلَّذِينَ إِذَا","بِـَٔايَـٰتِ رَبِّهِمْ لَمْ",537],["26:5:4",367,"ذِكْرٍۢ","reminder","وَمَا يَأْتِيهِم مِّن","مِّنَ ٱلرَّحْمَـٰنِ مُحْدَثٍ",149],["26:165:2",374,"ٱلذُّكْرَانَ","the males","أَتَأْتُونَ","مِنَ ٱلْعَـٰلَمِينَ",536],["26:209:1",376,"ذِكْرَىٰ","(To) remind","","وَمَا كُنَّا ظَـٰلِمِينَ",448],["26:227:6",376,"وَذَكَرُوا۟","and remember","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","ٱللَّهَ كَثِيرًۭا وَٱنتَصَرُوا۟",130],["27:62:16",382,"تَذَكَّرُونَ","you remember","ٱللَّهِ ۚ قَلِيلًۭا مَّا","",233],["28:43:16",390,"يَتَذَكَّرُونَ","remember","وَهُدًۭى وَرَحْمَةًۭ لَّعَلَّهُمْ","",233],["28:46:20",391,"يَتَذَكَّرُونَ","remember","مِّن قَبْلِكَ لَعَلَّهُمْ","",233],["28:51:6",392,"يَتَذَكَّرُونَ","remember","لَهُمُ ٱلْقَوْلَ لَعَلَّهُمْ","",233],["29:45:15",401,"وَلَذِكْرُ","and surely (the) remembrance","عَنِ ٱلْفَحْشَآءِ وَٱلْمُنكَرِ ۗ","ٱللَّهِ أَكْبَرُ ۗ وَٱللَّهُ",149],["29:51:13",402,"وَذِكْرَىٰ","and a reminder","فِى ذَٰلِكَ لَرَحْمَةًۭ","لِقَوْمٍۢ يُؤْمِنُونَ",448],["32:4:24",415,"تَتَذَكَّرُونَ","you take heed","وَلَا شَفِيعٍ ۚ أَفَلَا","",233],["32:15:6",416,"ذُكِّرُوا۟","they are reminded","بِـَٔايَـٰتِنَا ٱلَّذِينَ إِذَا","بِهَا خَرُّوا۟ سُجَّدًۭا",537],["32:22:4",417,"ذُكِّرَ","is reminded","وَمَنْ أَظْلَمُ مِمَّن","بِـَٔايَـٰتِ رَبِّهِۦ ثُمَّ",537],["33:9:4",419,"ٱذْكُرُوا۟","Remember","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","نِعْمَةَ ٱللَّهِ عَلَيْكُمْ",130],["33:21:15",420,"وَذَكَرَ","and remembers","ٱللَّهَ وَٱلْيَوْمَ ٱلْـَٔاخِرَ","ٱللَّهَ كَثِيرًۭا",130],["33:34:1",422,"وَٱذْكُرْنَ","And remember","","مَا يُتْلَىٰ فِى",130],["33:35:21",422,"وَٱلذَّٰكِرِينَ","and the men who remember","وَٱلْحَـٰفِظِينَ فُرُوجَهُمْ وَٱلْحَـٰفِظَـٰتِ","ٱللَّهَ كَثِيرًۭا وَٱلذَّٰكِرَٰتِ",2134],["33:35:24",422,"وَٱلذَّٰكِرَٰتِ","and the women who remember","وَٱلذَّٰكِرِينَ ٱللَّهَ كَثِيرًۭا","أَعَدَّ ٱللَّهُ لَهُم",2918],["33:41:4",423,"ٱذْكُرُوا۟","Remember","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","ٱللَّهَ ذِكْرًۭا كَثِيرًۭا",130],["33:41:6",423,"ذِكْرًۭا","(with) remembrance","ءَامَنُوا۟ ٱذْكُرُوا۟ ٱللَّهَ","كَثِيرًۭا",149],["35:3:3",434,"ٱذْكُرُوا۟","Remember","يَـٰٓأَيُّهَا ٱلنَّاسُ","نِعْمَتَ ٱللَّهِ عَلَيْكُمْ ۚ",130],["35:37:15",438,"يَتَذَكَّرُ","(would) receive admonition","أَوَلَمْ نُعَمِّرْكُم مَّا","فِيهِ مَن تَذَكَّرَ",233],["35:37:18",438,"تَذَكَّرَ","receives admonition","يَتَذَكَّرُ فِيهِ مَن","وَجَآءَكُمُ ٱلنَّذِيرُ ۖ فَذُوقُوا۟",233],["36:11:5",440,"ٱلذِّكْرَ","the Reminder","تُنذِرُ مَنِ ٱتَّبَعَ","وَخَشِىَ ٱلرَّحْمَـٰنَ بِٱلْغَيْبِ ۖ",149],["36:19:5",441,"ذُكِّرْتُم ۚ","you are admonished","طَـٰٓئِرُكُم مَّعَكُمْ ۚ أَئِن","بَلْ أَنتُمْ قَوْمٌۭ",537],["36:69:10",444,"ذِكْرٌۭ","a Reminder","إِنْ هُوَ إِلَّا","وَقُرْءَانٌۭ مُّبِينٌۭ",149],["37:3:2",446,"ذِكْرًا","(the) Message","فَٱلتَّـٰلِيَـٰتِ","",149],["37:13:2",446,"ذُكِّرُوا۟","they are reminded","وَإِذَا","لَا يَذْكُرُونَ",537],["37:13:4",446,"يَذْكُرُونَ","they receive admonition","وَإِذَا ذُكِّرُوا۟ لَا","",130],["37:155:2",452,"تَذَكَّرُونَ","you pay heed","أَفَلَا","",233],["37:168:4",452,"ذِكْرًۭا","a reminder","لَوْ أَنَّ عِندَنَا","مِّنَ ٱلْأَوَّلِينَ",149],["38:1:4",453,"ٱلذِّكْرِ","full (of) reminder","صٓ ۚ وَٱلْقُرْءَانِ ذِى","",149],["38:8:3",453,"ٱلذِّكْرُ","the Message","أَءُنزِلَ عَلَيْهِ","مِنۢ بَيْنِنَا ۚ بَلْ",149],["38:8:11",453,"ذِكْرِى ۖ","My Message","فِى شَكٍّۢ مِّن","بَل لَّمَّا يَذُوقُوا۟",149],["38:17:5",454,"وَٱذْكُرْ","and remember","عَلَىٰ مَا يَقُولُونَ","عَبْدَنَا دَاوُۥدَ ذَا",130],["38:29:7",455,"وَلِيَتَذَكَّرَ","and may be reminded","مُبَـٰرَكٌۭ لِّيَدَّبَّرُوٓا۟ ءَايَـٰتِهِۦ","أُو۟لُوا۟ ٱلْأَلْبَـٰبِ",233],["38:32:7",455,"ذِكْرِ","(the) remembrance","حُبَّ ٱلْخَيْرِ عَن","رَبِّى حَتَّىٰ تَوَارَتْ",149],["38:41:1",455,"وَٱذْكُرْ","And remember","","عَبْدَنَآ أَيُّوبَ إِذْ",130],["38:43:8",456,"وَذِكْرَىٰ","and a Reminder","مَّعَهُمْ رَحْمَةًۭ مِّنَّا","لِأُو۟لِى ٱلْأَلْبَـٰبِ",448],["38:45:1",456,"وَٱذْكُرْ","And remember","","عِبَـٰدَنَآ إِبْرَٰهِيمَ وَإِسْحَـٰقَ",130],["38:46:4",456,"ذِكْرَى","remembrance","إِنَّآ أَخْلَصْنَـٰهُم بِخَالِصَةٍۢ","ٱلدَّارِ",448],["38:48:1",456,"وَٱذْكُرْ","And remember","","إِسْمَـٰعِيلَ وَٱلْيَسَعَ وَذَا",130],["38:49:2",456,"ذِكْرٌۭ ۚ","(is) a Reminder","هَـٰذَا","وَإِنَّ لِلْمُتَّقِينَ لَحُسْنَ",149],["38:87:4",458,"ذِكْرٌۭ","a Reminder","إِنْ هُوَ إِلَّا","لِّلْعَـٰلَمِينَ",149],["39:9:22",459,"يَتَذَكَّرُ","will take heed","لَا يَعْلَمُونَ ۗ إِنَّمَا","أُو۟لُوا۟ ٱلْأَلْبَـٰبِ",233],["39:21:29",460,"لَذِكْرَىٰ","surely, (is) a reminder","إِنَّ فِى ذَٰلِكَ","لِأُو۟لِى ٱلْأَلْبَـٰبِ",448],["39:22:15",461,"ذِكْرِ","(the) remembrance of Allah","لِّلْقَـٰسِيَةِ قُلُوبُهُم مِّن","ٱللَّهِ ۚ أُو۟لَـٰٓئِكَ فِى",149],["39:23:19",461,"ذِكْرِ","(the) remembrance","جُلُودُهُمْ وَقُلُوبُهُمْ إِلَىٰ","ٱللَّهِ ۚ ذَٰلِكَ هُدَى",149],["39:27:11",461,"يَتَذَكَّرُونَ","take heed","كُلِّ مَثَلٍۢ لَّعَلَّهُمْ","",233],["39:45:2",463,"ذُكِرَ","Allah is mentioned","وَإِذَا","ٱللَّهُ وَحْدَهُ ٱشْمَأَزَّتْ",130],["39:45:12",463,"ذُكِرَ","are mentioned","يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ ۖ وَإِذَا","ٱلَّذِينَ مِن دُونِهِۦٓ",130],["40:13:11",468,"يَتَذَكَّرُ","take heed","ٱلسَّمَآءِ رِزْقًۭا ۚ وَمَا","إِلَّا مَن يُنِيبُ",233],["40:40:12",471,"ذَكَرٍ","male","عَمِلَ صَـٰلِحًۭا مِّن","أَوْ أُنثَىٰ وَهُوَ",536],["40:44:1",472,"فَسَتَذْكُرُونَ","And you will remember","","مَآ أَقُولُ لَكُمْ ۚ",130],["40:54:2",473,"وَذِكْرَىٰ","and a reminder","هُدًۭى","لِأُو۟لِى ٱلْأَلْبَـٰبِ",448],["40:58:13",473,"تَتَذَكَّرُونَ","you take heed","ٱلْمُسِىٓءُ ۚ قَلِيلًۭا مَّا","",233],["41:41:4",481,"بِٱلذِّكْرِ","in the Reminder","إِنَّ ٱلَّذِينَ كَفَرُوا۟","لَمَّا جَآءَهُمْ ۖ وَإِنَّهُۥ",149],["42:49:15",488,"ٱلذُّكُورَ","[the] males","وَيَهَبُ لِمَن يَشَآءُ","",536],["42:50:3",488,"ذُكْرَانًۭا","males","أَوْ يُزَوِّجُهُمْ","وَإِنَـٰثًۭا ۖ وَيَجْعَلُ مَن",536],["43:5:3",489,"ٱلذِّكْرَ","the Reminder","أَفَنَضْرِبُ عَنكُمُ","صَفْحًا أَن كُنتُمْ",149],["43:13:5",490,"تَذْكُرُوا۟","remember","عَلَىٰ ظُهُورِهِۦ ثُمَّ","نِعْمَةَ رَبِّكُمْ إِذَا",130],["43:36:4",492,"ذِكْرِ","(the) remembrance","وَمَن يَعْشُ عَن","ٱلرَّحْمَـٰنِ نُقَيِّضْ لَهُۥ",149],["43:44:2",492,"لَذِكْرٌۭ","(is) surely, a Reminder","وَإِنَّهُۥ","لَّكَ وَلِقَوْمِكَ ۖ وَسَوْفَ",149],["44:13:3",496,"ٱلذِّكْرَىٰ","the reminder","أَنَّىٰ لَهُمُ","وَقَدْ جَآءَهُمْ رَسُولٌۭ",448],["44:58:5",498,"يَتَذَكَّرُونَ","take heed","يَسَّرْنَـٰهُ بِلِسَانِكَ لَعَلَّهُمْ","",233],["45:23:24",501,"تَذَكَّرُونَ","you receive admonition","بَعْدِ ٱللَّهِ ۚ أَفَلَا","",233],["46:21:1",505,"۞ وَٱذْكُرْ","And mention","","أَخَا عَادٍ إِذْ",130],["47:18:15",508,"ذِكْرَىٰهُمْ","their reminder","لَهُمْ إِذَا جَآءَتْهُمْ","",448],["47:20:11",509,"وَذُكِرَ","and is mentioned","أُنزِلَتْ سُورَةٌۭ مُّحْكَمَةٌۭ","فِيهَا ٱلْقِتَالُ ۙ رَأَيْتَ",130],["49:13:6",517,"ذَكَرٍۢ","a male","إِنَّا خَلَقْنَـٰكُم مِّن","وَأُنثَىٰ وَجَعَلْنَـٰكُمْ شُعُوبًۭا",536],["50:8:2",518,"وَذِكْرَىٰ","and a reminder","تَبْصِرَةًۭ","لِكُلِّ عَبْدٍۢ مُّنِيبٍۢ",448],["50:37:4",520,"لَذِكْرَىٰ","surely, is a reminder","إِنَّ فِى ذَٰلِكَ","لِمَن كَانَ لَهُۥ",448],["50:45:9",520,"فَذَكِّرْ","But remind","أَنتَ عَلَيْهِم بِجَبَّارٍۢ ۖ","بِٱلْقُرْءَانِ مَن يَخَافُ",537],["51:49:7",522,"تَذَكَّرُونَ","remember","خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ","",233],["51:55:1",523,"وَذَكِّرْ","And remind","","فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ",537],["51:55:3",523,"ٱلذِّكْرَىٰ","the reminder","وَذَكِّرْ فَإِنَّ","تَنفَعُ ٱلْمُؤْمِنِينَ",448],["52:29:1",524,"فَذَكِّرْ","Therefore remind","","فَمَآ أَنتَ بِنِعْمَتِ",537],["53:21:2",526,"ٱلذَّكَرُ","the male","أَلَكُمُ","وَلَهُ ٱلْأُنثَىٰ",536],["53:29:6",527,"ذِكْرِنَا","Our Reminder","مَّن تَوَلَّىٰ عَن","وَلَمْ يُرِدْ إِلَّا",149],["53:45:4",528,"ٱلذَّكَرَ","the male","وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ","وَٱلْأُنثَىٰ",536],["54:15:6",529,"مُّدَّكِرٍۢ","who will receive admonition","ءَايَةًۭ فَهَلْ مِن","",1210],["54:17:4",529,"لِلذِّكْرِ","for remembrance","وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ","فَهَلْ مِن مُّدَّكِرٍۢ",149],["54:17:7",529,"مُّدَّكِرٍۢ","who will receive admonition","لِلذِّكْرِ فَهَلْ مِن","",1210],["54:22:4",529,"لِلذِّكْرِ","for remembrance","وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ","فَهَلْ مِن مُّدَّكِرٍۢ",149],["54:22:7",529,"مُّدَّكِرٍۢ","who will receive admonition","لِلذِّكْرِ فَهَلْ مِن","",1210],["54:25:2",529,"ٱلذِّكْرُ","the Reminder","أَءُلْقِىَ","عَلَيْهِ مِنۢ بَيْنِنَا",149],["54:32:4",530,"لِلذِّكْرِ","for remembrance","وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ","فَهَلْ مِن مُّدَّكِرٍۢ",149],["54:32:7",530,"مُّدَّكِرٍۢ","who will receive admonition","لِلذِّكْرِ فَهَلْ مِن","",1210],["54:40:4",530,"لِلذِّكْرِ","for remembrance","وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ","فَهَلْ مِن مُّدَّكِرٍۢ",149],["54:40:7",530,"مُّدَّكِرٍۢ","who will receive admonition","لِلذِّكْرِ فَهَلْ مِن","",1210],["54:51:6",531,"مُّدَّكِرٍۢ","who will receive admonition","أَشْيَاعَكُمْ فَهَلْ مِن","",1210],["56:62:6",536,"تَذَكَّرُونَ","you take heed","ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا","",233],["56:73:3",536,"تَذْكِرَةًۭ","a reminder","نَحْنُ جَعَلْنَـٰهَا","وَمَتَـٰعًۭا لِّلْمُقْوِينَ",925],["57:16:8",539,"لِذِكْرِ","at (the) remembrance (of) Allah","أَن تَخْشَعَ قُلُوبُهُمْ","ٱللَّهِ وَمَا نَزَلَ",149],["58:19:5",544,"ذِكْرَ","(the) remembrance","عَلَيْهِمُ ٱلشَّيْطَـٰنُ فَأَنسَىٰهُمْ","ٱللَّهِ ۚ أُو۟لَـٰٓئِكَ حِزْبُ",149],["62:9:12",554,"ذِكْرِ","(the) remembrance","ٱلْجُمُعَةِ فَٱسْعَوْا۟ إِلَىٰ","ٱللَّهِ وَذَرُوا۟ ٱلْبَيْعَ ۚ",149],["62:10:11",554,"وَٱذْكُرُوا۟","and remember","مِن فَضْلِ ٱللَّهِ","ٱللَّهَ كَثِيرًۭا لَّعَلَّكُمْ",130],["63:9:10",555,"ذِكْرِ","(the) remembrance","وَلَآ أَوْلَـٰدُكُمْ عَن","ٱللَّهِ ۚ وَمَن يَفْعَلْ",149],["65:10:16",559,"ذِكْرًۭا","a Message","أَنزَلَ ٱللَّهُ إِلَيْكُمْ","",149],["68:51:9",566,"ٱلذِّكْرَ","the Message","بِأَبْصَـٰرِهِمْ لَمَّا سَمِعُوا۟","وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌۭ",149],["68:52:4",566,"ذِكْرٌۭ","a Reminder","وَمَا هُوَ إِلَّا","لِّلْعَـٰلَمِينَ",149],["69:12:3",567,"تَذْكِرَةًۭ","a reminder","لِنَجْعَلَهَا لَكُمْ","وَتَعِيَهَآ أُذُنٌۭ وَٰعِيَةٌۭ",925],["69:42:6",568,"تَذَكَّرُونَ","you take heed","كَاهِنٍۢ ۚ قَلِيلًۭا مَّا","",233],["69:48:2",568,"لَتَذْكِرَةٌۭ","(is) surely a reminder","وَإِنَّهُۥ","لِّلْمُتَّقِينَ",925],["72:17:6",573,"ذِكْرِ","the Remembrance","وَمَن يُعْرِضْ عَن","رَبِّهِۦ يَسْلُكْهُ عَذَابًۭا",149],["73:8:1",574,"وَٱذْكُرِ","And remember","","ٱسْمَ رَبِّكَ وَتَبَتَّلْ",130],["73:19:3",574,"تَذْكِرَةٌۭ ۖ","(is) a Reminder","إِنَّ هَـٰذِهِۦ","فَمَن شَآءَ ٱتَّخَذَ",925],["74:31:56",576,"ذِكْرَىٰ","a reminder","وَمَا هِىَ إِلَّا","لِلْبَشَرِ",448],["74:49:4",577,"ٱلتَّذْكِرَةِ","the Reminder","فَمَا لَهُمْ عَنِ","مُعْرِضِينَ",925],["74:54:3",577,"تَذْكِرَةٌۭ","(is) a Reminder","كَلَّآ إِنَّهُۥ","",925],["74:55:3",577,"ذَكَرَهُۥ","(may) pay heed to it","فَمَن شَآءَ","",130],["74:56:2",577,"يَذْكُرُونَ","will pay heed","وَمَا","إِلَّآ أَن يَشَآءَ",130],["75:39:4",578,"ٱلذَّكَرَ","(the) male","فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ","وَٱلْأُنثَىٰٓ",536],["76:1:11",578,"مَّذْكُورًا","mentioned","لَمْ يَكُن شَيْـًۭٔا","",3903],["76:25:1",579,"وَٱذْكُرِ","And remember","","ٱسْمَ رَبِّكَ بُكْرَةًۭ",130],["76:29:3",580,"تَذْكِرَةٌۭ ۖ","(is) a reminder","إِنَّ هَـٰذِهِۦ","فَمَن شَآءَ ٱتَّخَذَ",925],["77:5:2",580,"ذِكْرًا","(the) Reminder","فَٱلْمُلْقِيَـٰتِ","",149],["79:35:2",584,"يَتَذَكَّرُ","will remember","يَوْمَ","ٱلْإِنسَـٰنُ مَا سَعَىٰ",233],["79:43:4",584,"ذِكْرَىٰهَآ","(to) mention it","فِيمَ أَنتَ مِن","",448],["80:4:2",585,"يَذَّكَّرُ","be reminded","أَوْ","فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",233],["80:4:4",585,"ٱلذِّكْرَىٰٓ","the reminder","أَوْ يَذَّكَّرُ فَتَنفَعَهُ","",448],["80:11:3",585,"تَذْكِرَةٌۭ","(is) a reminder","كَلَّآ إِنَّهَا","",925],["80:12:3",585,"ذَكَرَهُۥ","may remember it","فَمَن شَآءَ","",130],["81:27:4",586,"ذِكْرٌۭ","a reminder","إِنْ هُوَ إِلَّا","لِّلْعَـٰلَمِينَ",149],["87:9:1",591,"فَذَكِّرْ","So remind","","إِن نَّفَعَتِ ٱلذِّكْرَىٰ",537],["87:9:4",591,"ٱلذِّكْرَىٰ","the reminder","فَذَكِّرْ إِن نَّفَعَتِ","",448],["87:10:1",591,"سَيَذَّكَّرُ","He will pay heed","","مَن يَخْشَىٰ",233],["87:15:1",592,"وَذَكَرَ","And remembers","","ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",130],["88:21:1",592,"فَذَكِّرْ","So remind","","إِنَّمَآ أَنتَ مُذَكِّرٌۭ",537],["88:21:4",592,"مُذَكِّرٌۭ","(are) a reminder","فَذَكِّرْ إِنَّمَآ أَنتَ","",3751],["89:23:5",594,"يَتَذَكَّرُ","will remember","يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ","ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ",233],["89:23:9",594,"ٱلذِّكْرَىٰ","the remembrance","ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ","",448],["92:3:3",595,"ٱلذَّكَرَ","the male","وَمَا خَلَقَ","وَٱلْأُنثَىٰٓ",536],["94:4:3",597,"ذِكْرَكَ","your reputation","وَرَفَعْنَا لَكَ","",149]]