[["7:145:4",168,"ٱلْأَلْوَاحِ","the tablets","وَكَتَبْنَا لَهُۥ فِى","مِن كُلِّ شَىْءٍۢ",1351],["7:150:17",169,"ٱلْأَلْوَاحَ","the tablets","أَمْرَ رَبِّكُمْ ۖ وَأَلْقَى","وَأَخَذَ بِرَأْسِ أَخِيهِ",1351],["7:154:7",169,"ٱلْأَلْوَاحَ ۖ","the tablets","مُّوسَى ٱلْغَضَبُ أَخَذَ","وَفِى نُسْخَتِهَا هُدًۭى",1351],["54:13:4",529,"أَلْوَٰحٍۢ","(ark) made of planks","وَحَمَلْنَـٰهُ عَلَىٰ ذَاتِ","وَدُسُرٍۢ",1351],["74:29:1",576,"لَوَّاحَةٌۭ","Scorching","","لِّلْبَشَرِ",3603],["85:22:2",590,"لَوْحٍۢ","a Tablet","فِى","مَّحْفُوظٍۭ",1351]]