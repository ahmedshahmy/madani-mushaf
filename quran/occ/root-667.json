[["3:103:2",63,"بِحَبْلِ","to (the) rope","وَٱعْتَصِمُوا۟","ٱللَّهِ جَمِيعًۭا وَلَا",1053],["3:112:8",64,"بِحَبْلٍۢ","with a rope","مَا ثُقِفُوٓا۟ إِلَّا","مِّنَ ٱللَّهِ وَحَبْلٍۢ",1053],["3:112:11",64,"وَحَبْلٍۢ","and a rope","بِحَبْلٍۢ مِّنَ ٱللَّهِ","مِّنَ ٱلنَّاسِ وَبَآءُو",1053],["20:66:5",316,"حِبَالُهُمْ","Their ropes","بَلْ أَلْقُوا۟ ۖ فَإِذَا","وَعِصِيُّهُمْ يُخَيَّلُ إِلَيْهِ",1053],["26:44:2",369,"حِبَالَهُمْ","their ropes","فَأَلْقَوْا۟","وَعِصِيَّهُمْ وَقَالُوا۟ بِعِزَّةِ",1053],["50:16:13",519,"حَبْلِ","(his) jugular vein","أَقْرَبُ إِلَيْهِ مِنْ","ٱلْوَرِيدِ",1053],["111:5:3",603,"حَبْلٌۭ","(will be) a rope","فِى جِيدِهَا","مِّن مَّسَدٍۭ",1053]]