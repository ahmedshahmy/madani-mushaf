[["2:10:3",3,"مَّرَضٌۭ","(is) a disease","فِى قُلُوبِهِم","فَزَادَهُمُ ٱللَّهُ مَرَضًۭا ۖ",693],["2:10:6",3,"مَرَضًۭا ۖ","(in) disease","مَّرَضٌۭ فَزَادَهُمُ ٱللَّهُ","وَلَهُمْ عَذَابٌ أَلِيمٌۢ",693],["2:184:6",28,"مَّرِيضًا","sick","فَمَن كَانَ مِنكُم","أَوْ عَلَىٰ سَفَرٍۢ",848],["2:185:20",28,"مَرِيضًا","sick","فَلْيَصُمْهُ ۖ وَمَن كَانَ","أَوْ عَلَىٰ سَفَرٍۢ",848],["2:196:21",30,"مَّرِيضًا","ill","فَمَن كَانَ مِنكُم","أَوْ بِهِۦٓ أَذًۭى",848],["4:43:22",85,"مَّرْضَىٰٓ","ill","تَغْتَسِلُوا۟ ۚ وَإِن كُنتُم","أَوْ عَلَىٰ سَفَرٍ",848],["4:102:51",95,"مَّرْضَىٰٓ","sick","مَّطَرٍ أَوْ كُنتُم","أَن تَضَعُوٓا۟ أَسْلِحَتَكُمْ ۖ",848],["5:6:24",108,"مَّرْضَىٰٓ","ill","فَٱطَّهَّرُوا۟ ۚ وَإِن كُنتُم","أَوْ عَلَىٰ سَفَرٍ",848],["5:52:5",117,"مَّرَضٌۭ","(is) a disease","ٱلَّذِينَ فِى قُلُوبِهِم","يُسَـٰرِعُونَ فِيهِمْ يَقُولُونَ",693],["8:49:7",183,"مَّرَضٌ","(was) a disease","وَٱلَّذِينَ فِى قُلُوبِهِم","غَرَّ هَـٰٓؤُلَآءِ دِينُهُمْ ۗ",693],["9:91:6",201,"ٱلْمَرْضَىٰ","the sick","ٱلضُّعَفَآءِ وَلَا عَلَى","وَلَا عَلَى ٱلَّذِينَ",848],["9:125:5",207,"مَّرَضٌۭ","(is) a disease","ٱلَّذِينَ فِى قُلُوبِهِم","فَزَادَتْهُمْ رِجْسًا إِلَىٰ",693],["22:53:9",338,"مَّرَضٌۭ","(is) a disease","لِّلَّذِينَ فِى قُلُوبِهِم","وَٱلْقَاسِيَةِ قُلُوبُهُمْ ۗ وَإِنَّ",693],["24:50:3",356,"مَّرَضٌ","a disease","أَفِى قُلُوبِهِم","أَمِ ٱرْتَابُوٓا۟ أَمْ",693],["24:61:11",358,"ٱلْمَرِيضِ","the sick","حَرَجٌۭ وَلَا عَلَى","حَرَجٌۭ وَلَا عَلَىٰٓ",848],["26:80:2",370,"مَرِضْتُ","I am ill","وَإِذَا","فَهُوَ يَشْفِينِ",3701],["33:12:7",419,"مَّرَضٌۭ","(was) a disease","وَٱلَّذِينَ فِى قُلُوبِهِم","مَّا وَعَدَنَا ٱللَّهُ",693],["33:32:16",422,"مَرَضٌۭ","(is) a disease","ٱلَّذِى فِى قَلْبِهِۦ","وَقُلْنَ قَوْلًۭا مَّعْرُوفًۭا",693],["33:60:8",426,"مَّرَضٌۭ","(is) a disease","وَٱلَّذِينَ فِى قُلُوبِهِم","وَٱلْمُرْجِفُونَ فِى ٱلْمَدِينَةِ",693],["47:20:18",509,"مَّرَضٌۭ","(is) a disease","ٱلَّذِينَ فِى قُلُوبِهِم","يَنظُرُونَ إِلَيْكَ نَظَرَ",693],["47:29:6",509,"مَّرَضٌ","(is) a disease","ٱلَّذِينَ فِى قُلُ