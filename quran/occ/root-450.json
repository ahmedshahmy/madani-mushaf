[["3:161:5",71,"يَغُلَّ ۚ","he defrauds","كَانَ لِنَبِىٍّ أَن","وَمَن يَغْلُلْ يَأْتِ",1337],["3:161:7",71,"يَغْلُلْ","defrauds","أَن يَغُلَّ ۚ وَمَن","يَأْتِ بِمَا غَلَّ",1337],["3:161:10",71,"غَلَّ","he had defrauded","يَغْلُلْ يَأْتِ بِمَا","يَوْمَ ٱلْقِيَـٰمَةِ ۚ ثُمَّ",1337],["5:64:5",118,"مَغْلُولَةٌ ۚ","(is) chained","ٱلْيَهُودُ يَدُ ٱللَّهِ","غُلَّتْ أَيْدِيهِمْ وَلُعِنُوا۟",2450],["5:64:6",118,"غُلَّتْ","Are chained","يَدُ ٱللَّهِ مَغْلُولَةٌ ۚ","أَيْدِيهِمْ وَلُعِنُوا۟ بِمَا",1337],["7:43:6",155,"غِلٍّۢ","malice","فِى صُدُورِهِم مِّنْ","تَجْرِى مِن تَحْتِهِمُ",901],["7:157:27",170,"وَٱلْأَغْلَـٰلَ","and the fetters","وَيَضَعُ عَنْهُمْ إِصْرَهُمْ","ٱلَّتِى كَانَتْ عَلَيْهِمْ ۚ",901],["13:5:17",249,"ٱلْأَغْلَـٰلُ","the iron chains","كَفَرُوا۟ بِرَبِّهِمْ ۖ وَأُو۟لَـٰٓئِكَ","فِىٓ أَعْنَاقِهِمْ ۖ وَأُو۟لَـٰٓئِكَ",901],["15:47:6",264,"غِلٍّ","rancor","فِى صُدُورِهِم مِّنْ","إِخْوَٰنًا عَلَىٰ سُرُرٍۢ",901],["17:29:4",285,"مَغْلُولَةً","chained","وَلَا تَجْعَلْ يَدَكَ","إِلَىٰ عُنُقِكَ وَلَا",2450],["34:33:24",432,"ٱلْأَغْلَـٰلَ","shackles","رَأَوُا۟ ٱلْعَذَابَ وَجَعَلْنَا","فِىٓ أَعْنَاقِ ٱلَّذِينَ",901],["36:8:5",440,"أَغْلَـٰلًۭا","iron collars","جَعَلْنَا فِىٓ أَعْنَـٰقِهِمْ","فَهِىَ إِلَى ٱلْأَذْقَانِ",901],["40:71:2",475,"ٱلْأَغْلَـٰلُ","the iron collars","إِذِ","فِىٓ أَعْنَـٰقِهِمْ وَٱلسَّلَـٰسِلُ",901],["59:10:17",547,"غِلًّۭا","any rancor","تَجْعَلْ فِى قُلُوبِنَا","لِّلَّذِينَ ءَامَنُوا۟ رَبَّنَآ",901],["69:30:2",567,"فَغُلُّوهُ","and shackle him","خُذُوهُ","",1337],["76:4:5",578,"وَأَغْلَـٰلًۭا","and shackles","أَعْتَدْنَا لِلْكَـٰفِرِينَ سَلَـٰسِلَا۟","وَسَعِيرًا",901]]