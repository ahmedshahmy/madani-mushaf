[["2:61:32",9,"مِصْرًۭا","(to) a city","هُوَ خَيْرٌ ۚ ٱهْبِطُوا۟","فَإِنَّ لَكُم مَّا",1358],["10:87:8",218,"بِمِصْرَ","in Egypt","أَن تَبَوَّءَا لِقَوْمِكُمَا","بُيُوتًۭا وَٱجْعَلُوا۟ بُيُوتَكُمْ",1358],["12:21:5",237,"مِّصْرَ","Egypt","ٱلَّذِى ٱشْتَرَىٰهُ مِن","لِٱمْرَأَتِهِۦٓ أَكْرِمِى مَثْوَىٰهُ",1358],["12:99:10",247,"مِصْرَ","Egypt","أَبَوَيْهِ وَقَالَ ٱدْخُلُوا۟","إِن شَآءَ ٱللَّهُ",1358],["43:51:10",493,"مِصْرَ","(of) Egypt","أَلَيْسَ لِى مُلْكُ","وَهَـٰذِهِ ٱلْأَنْهَـٰرُ تَجْرِى",1358]]