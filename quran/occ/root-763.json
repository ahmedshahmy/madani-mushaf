[["7:163:14",171,"حِيتَانُهُمْ","their fish","ٱلسَّبْتِ إِذْ تَأْتِيهِمْ","يَوْمَ سَبْتِهِمْ شُرَّعًۭا",1307],["18:61:6",300,"حُوتَهُمَا","their fish","مَجْمَعَ بَيْنِهِمَا نَسِيَا","فَٱتَّخَذَ سَبِيلَهُۥ فِى",1307],["18:63:9",301,"ٱلْحُوتَ","the fish","ٱلصَّخْرَةِ فَإِنِّى نَسِيتُ","وَمَآ أَنسَىٰنِيهُ إِلَّا",1307],["37:142:2",451,"ٱلْحُوتُ","the fish","فَٱلْتَقَمَهُ","وَهُوَ مُلِيمٌۭ",1307],["68:48:7",566,"ٱلْحُوتِ","(of) the fish","وَلَا تَكُن كَصَاحِبِ","إِذْ نَادَىٰ وَهُوَ",1307]]