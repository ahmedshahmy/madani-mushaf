يُبْدِلَنَا","مِّنْهَآ إِنَّآ إِلَىٰ",62],["68:38:5",565,"تَخَيَّرُونَ","you choose","لَكُمْ فِيهِ لَمَا","",2787],["70:21:3",569,"ٱلْخَيْرُ","the good","وَإِذَا مَسَّهُ","مَنُوعًا",62],["70:41:4",570,"خَيْرًۭا","(with) better","عَلَىٰٓ أَن نُّبَدِّلَ","مِّنْهُمْ وَمَا نَحْنُ",62],["73:20:65",575,"خَيْرٍۢ","good","تُقَدِّمُوا۟ لِأَنفُسِكُم مِّنْ","تَجِدُوهُ عِندَ ٱللَّهِ",62],["73:20:70",575,"خَيْرًۭا","(will be) better","عِندَ ٱللَّهِ هُوَ","وَأَعْظَمَ أَجْرًۭا ۚ وَٱسْتَغْفِرُوا۟",62],["87:17:2",592,"خَيْرٌۭ","(is) better","وَٱلْـَٔاخِرَةُ","وَأَبْقَىٰٓ",62],["93:4:2",596,"خَيْرٌۭ","(is) better","وَلَلْـَٔاخِرَةُ","لَّكَ مِنَ ٱلْأُولَىٰ",62],["97:3:3",598,"خَيْرٌۭ","(is) better","لَيْلَةُ ٱلْقَدْرِ","مِّنْ أَلْفِ شَهْرٍۢ",62],["98:7:8",599,"خَيْرُ","(are the) best","ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ هُمْ","ٱلْبَرِيَّةِ",62],["99:7:5",599,"خَيْرًۭا","good","يَعْمَلْ مِثْقَالَ ذَرَّةٍ","يَرَهُۥ",62],["100:8:3",600,"ٱلْخَيْرِ","(of) wealth","وَإِنَّهُۥ لِحُبِّ","لَشَدِيدٌ",62]]