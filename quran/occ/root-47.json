[["2:54:17",8,"خَيْرٌۭ","(is) better","فَٱقْتُلُوٓا۟ أَنفُسَكُمْ ذَٰلِكُمْ","لَّكُمْ عِندَ بَارِئِكُمْ",62],["2:61:30",9,"خَيْرٌ ۚ","(is) better","أَدْنَىٰ بِٱلَّذِى هُوَ","ٱهْبِطُوا۟ مِصْرًۭا فَإِنَّ",62],["2:103:9",16,"خَيْرٌۭ ۖ","(would have been) better","مِّنْ عِندِ ٱللَّهِ","لَّوْ كَانُوا۟ يَعْلَمُونَ",62],["2:105:14",16,"خَيْرٍۢ","good","يُنَزَّلَ عَلَيْكُم مِّنْ","مِّن رَّبِّكُمْ ۗ وَٱللَّهُ",62],["2:106:8",17,"بِخَيْرٍۢ","better","أَوْ نُنسِهَا نَأْتِ","مِّنْهَآ أَوْ مِثْلِهَآ ۗ",62],["2:110:9",17,"خَيْرٍۢ","good (deeds)","تُقَدِّمُوا۟ لِأَنفُسِكُم مِّنْ","تَجِدُوهُ عِندَ ٱللَّهِ ۗ",62],["2:148:6",23,"ٱلْخَيْرَٰتِ ۚ","(to) the good","هُوَ مُوَلِّيهَا ۖ فَٱسْتَبِقُوا۟","أَيْنَ مَا تَكُونُوا۟",864],["2:158:20",24,"خَيْرًۭا","good","بِهِمَا ۚ وَمَن تَطَوَّعَ","فَإِنَّ ٱللَّهَ شَاكِرٌ",62],["2:180:9",27,"خَيْرًا","good","ٱلْمَوْتُ إِن تَرَكَ","ٱلْوَصِيَّةُ لِلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَ",62],["2:184:22",28,"خَيْرًۭا","good","مِسْكِينٍۢ ۖ فَمَن تَطَوَّعَ","فَهُوَ خَيْرٌۭ لَّهُۥ ۚ",62],["2:184:24",28,"خَيْرٌۭ","(is) better","تَطَوَّعَ خَيْرًۭا فَهُوَ","لَّهُۥ ۚ وَأَن تَصُومُوا۟",62],["2:184:28",28,"خَيْرٌۭ","(is) better","لَّهُۥ ۚ وَأَن تَصُومُوا۟","لَّكُمْ ۖ إِن كُنتُمْ",62],["2:197:19",31,"خَيْرٍۢ","good","وَمَا تَفْعَلُوا۟ مِنْ","يَعْلَمْهُ ٱللَّهُ ۗ وَتَزَوَّدُوا۟",62],["2:197:24",31,"خَيْرَ","(the) best","ٱللَّهُ ۗ وَتَزَوَّدُوا۟ فَإِنَّ","ٱلزَّادِ ٱلتَّقْوَىٰ ۚ وَٱتَّقُونِ",62],["2:215:8",33,"خَيْرٍۢ","good","مَآ أَنفَقْتُم مِّنْ","فَلِلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَ وَٱلْيَتَـٰمَىٰ",62],["2:215:18",33,"خَيْرٍۢ","good","وَمَا تَفْعَلُوا۟ مِنْ","فَإِنَّ ٱللَّهَ بِهِۦ",62],["2:216:12",34,"خَيْرٌۭ","(is) good","تَكْرَهُوا۟ شَيْـًۭٔا وَهُوَ","لَّكُمْ ۖ وَعَسَىٰٓ أَن",62],["2:220:10",35,"خَيْرٌۭ ۖ","(is) best","قُلْ إِصْلَاحٌۭ لَّهُمْ","وَإِن تُخَالِطُوهُمْ فَإِخْوَٰنُكُمْ ۚ",62],["2:221:8",35,"خَيْرٌۭ","(is) better","يُؤْمِنَّ ۚ وَلَأَمَةٌۭ مُّؤْمِنَةٌ","مِّن مُّشْرِكَةٍۢ وَلَوْ",62],["2:221:20",35,"خَيْرٌۭ","(is) better","يُؤْمِنُوا۟ ۚ وَلَعَبْدٌۭ مُّؤْمِنٌ","مِّن مُّشْرِكٍۢ وَلَوْ",62],["2:263:4",44,"خَيْرٌۭ","(are) better","۞ قَوْلٌۭ مَّعْرُوفٌۭ وَمَغْفِرَةٌ","مِّن صَدَقَةٍۢ يَتْبَعُهَآ",62],["2:269:10",45,"خَيْرًۭا","good","ٱلْحِكْمَةَ فَقَدْ أُوتِىَ","كَثِيرًۭا ۗ وَمَا يَذَّكَّرُ",62],["2:271:11",46,"خَيْرٌۭ","(is) better","وَتُؤْتُوهَا ٱلْفُقَرَآءَ فَهُوَ","لَّكُمْ ۚ وَيُكَفِّرُ عَنكُم",62],["2:272:12",46,"خَيْرٍۢ","good","وَمَا تُنفِقُوا۟ مِنْ","فَلِأَنفُسِكُمْ ۚ وَمَا تُنفِقُونَ",62],["2:272:23",46,"خَيْرٍۢ","good","وَمَا تُنفِقُوا۟ مِنْ","يُوَفَّ إِلَيْكُمْ وَأَنتُمْ",62],["2:273:26",46,"خَيْرٍۢ","good","وَمَا تُنفِقُوا۟ مِنْ","فَإِنَّ ٱللَّهَ بِهِۦ",62],["2:280:10",47,"خَيْرٌۭ","(it is) better","مَيْسَرَةٍۢ ۚ وَأَن تَصَدَّقُوا۟","لَّكُمْ ۖ إِن كُنتُمْ",62],["3:15:3",51,"بِخَيْرٍۢ","of better","۞ قُلْ أَؤُنَبِّئُكُم","مِّن ذَٰلِكُمْ ۚ لِلَّذِينَ",62],["3:26:20",53,"ٱلْخَيْرُ ۖ","(is all) the good","مَن تَشَآءُ ۖ بِيَدِكَ","إِنَّكَ عَلَىٰ كُلِّ",62],["3:30:8",54,"خَيْرٍۢ","good","مَّا عَمِلَتْ مِنْ","مُّحْضَرًۭا وَمَا عَمِلَتْ",62],["3:54:5",57,"خَيْرُ","(is the) best","وَمَكَرَ ٱللَّهُ ۖ وَٱللَّهُ","ٱلْمَـٰكِرِينَ",62],["3:104:6",63,"ٱلْخَيْرِ","the good","أُمَّةٌۭ يَدْعُونَ إِلَى","وَيَأْمُرُونَ بِٱلْمَعْرُوفِ وَيَنْهَوْنَ",62],["3:110:2",64,"خَيْرَ","(the) best","كُنتُمْ","أُمَّةٍ أُخْرِجَتْ لِلنَّاسِ",62],["3:110:18",64,"خَيْرًۭا","good","أَهْلُ ٱلْكِتَـٰبِ لَكَانَ","لَّهُم ۚ مِّنْهُمُ ٱلْمُؤْمِنُونَ",62],["3:114:12",64,"ٱلْخَيْرَٰتِ","the good deeds","ٱلْمُنكَرِ وَيُسَـٰرِعُونَ فِى","وَأُو۟لَـٰٓئِكَ مِنَ ٱلصَّـٰلِحِينَ",864],["3:115:4",64,"خَيْرٍۢ","a good","وَمَا يَفْعَلُوا۟ مِنْ","فَلَن يُكْفَرُوهُ ۗ وَٱللَّهُ",62],["3:150:5",69,"خَيْرُ","(is the) best","ٱللَّهُ مَوْلَىٰكُمْ ۖ وَهُوَ","ٱلنَّـٰصِرِينَ",62],["3:157:12",70,"خَيْرٌۭ","(are) better","مِّنَ ٱللَّهِ وَرَحْمَةٌ","مِّمَّا يَجْمَعُونَ",62],["3:178:8",73,"خَيْرٌۭ","(is) good","أَنَّمَا نُمْلِى لَهُمْ","لِّأَنفُسِهِمْ ۚ إِنَّمَا نُمْلِى",62],["3:180:11",73,"خَيْرًۭا","(is) good","مِن فَضْلِهِۦ هُوَ","لَّهُم ۖ بَلْ هُوَ",62],["3:198:20",76,"خَيْرٌۭ","(is) best","وَمَا عِندَ ٱللَّهِ","لِّلْأَبْرَارِ",62],["4:19:33",80,"خَيْرًۭا","good","وَيَجْعَلَ ٱللَّهُ فِيهِ","كَثِيرًۭا",62],["4:25:54",82,"خَيْرٌۭ","(is) better","مِنكُمْ ۚ وَأَن تَصْبِرُوا۟","لَّكُمْ ۗ وَٱللَّهُ غَفُورٌۭ",62],["4:46:28",86,"خَيْرًۭا","better","وَٱسْمَعْ وَٱنظُرْنَا لَكَانَ","لَّهُمْ وَأَقْوَمَ وَلَـٰكِن",62],["4:59:26",87,"خَيْرٌۭ","(is) best","وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۚ ذَٰلِكَ","وَأَحْسَنُ تَأْوِيلًا",62],["4:66:24",89,"خَيْرًۭا","better","يُوعَظُونَ بِهِۦ لَكَانَ","لَّهُمْ وَأَشَدَّ تَثْبِيتًۭا",62],["4:77:43",90,"خَيْرٌۭ","(is) better","ٱلدُّنْيَا قَلِيلٌۭ وَٱلْـَٔاخِرَةُ","لِّمَنِ ٱتَّقَىٰ وَلَا",62],["4:114:2",97,"خَيْرَ","good","۞ لَّا","فِى كَثِيرٍۢ مِّن",62],["4:127:35",98,"خَيْرٍۢ","good","وَمَا تَفْعَلُوا۟ مِنْ","فَإِنَّ ٱللَّهَ كَانَ",62],["4:128:17",99,"خَيْرٌۭ ۗ","(is) best","بَيْنَهُمَا صُلْحًۭا ۚ وَٱلصُّلْحُ","وَأُحْضِرَتِ ٱلْأَنفُسُ ٱلشُّحَّ ۚ",62],["4:149:3",102,"خَيْرًا","a good","إِن تُبْدُوا۟","أَوْ تُخْفُوهُ أَوْ",62],["4:170:10",104,"خَيْرًۭا","(it is) better","مِن رَّبِّكُمْ فَـَٔامِنُوا۟","لَّكُمْ ۚ وَإِن تَكْفُرُوا۟",62],["4:171:33",105,"خَيْرًۭا","(it is) better","تَقُولُوا۟ ثَلَـٰثَةٌ ۚ ٱنتَهُوا۟","لَّكُمْ ۚ إِنَّمَا ٱللَّهُ",62],["5:48:42",116,"ٱلْخَيْرَٰتِ ۚ","(to) the good","مَآ ءَاتَىٰكُمْ ۖ فَٱسْتَبِقُوا۟","إِلَى ٱللَّهِ مَرْجِعُكُمْ",864],["5:114:21",127,"خَيْرُ","(are) best","مِّنكَ ۖ وَٱرْزُقْنَا وَأَنتَ","ٱلرَّٰزِقِينَ",62],["6:17:12",129,"بِخَيْرٍۢ","with good","هُوَ ۖ وَإِن يَمْسَسْكَ","فَهُوَ عَلَىٰ كُلِّ",62],["6:32:9",131,"خَيْرٌۭ","(is) best","وَلَهْوٌۭ ۖ وَلَلدَّارُ ٱلْـَٔاخِرَةُ","لِّلَّذِينَ يَتَّقُونَ ۗ أَفَلَا",62],["6:57:21",134,"خَيْرُ","(is the) best","يَقُصُّ ٱلْحَقَّ ۖ وَهُوَ","ٱلْفَـٰصِلِينَ",62],["6:158:33",150,"خَيْرًۭا ۗ","any good","كَسَبَتْ فِىٓ إِيمَـٰنِهَا","قُلِ ٱنتَظِرُوٓا۟ إِنَّا",62],["7:12:10",152,"خَيْرٌۭ","better","أَمَرْتُكَ ۖ قَالَ أَنَا۠","مِّنْهُ خَلَقْتَنِى مِن",62],["7:26:13",153,"خَيْرٌۭ ۚ","(is) best","وَلِبَاسُ ٱلتَّقْوَىٰ ذَٰلِكَ","ذَٰلِكَ مِنْ ءَايَـٰتِ",62],["7:85:33",161,"خَيْرٌۭ","(is) better","بَعْدَ إِصْلَـٰحِهَا ۚ ذَٰلِكُمْ","لَّكُمْ إِن كُنتُم",62],["7:87:18",161,"خَيْرُ","(is the) Best","ٱللَّهُ بَيْنَنَا ۚ وَهُوَ","ٱلْحَـٰكِمِينَ",62],["7:89:41",162,"خَيْرُ","(are the) Best","قَوْمِنَا بِٱلْحَقِّ وَأَنتَ","ٱلْفَـٰتِحِينَ",62],["7:155:1",169,"وَٱخْتَارَ","And chose","","مُوسَىٰ قَوْمَهُۥ سَبْعِينَ",1703],["7:155:40",169,"خَيْرُ","(are) Best","لَنَا وَٱرْحَمْنَا ۖ وَأَنتَ","ٱلْغَـٰفِرِينَ",62],["7:169:36",172,"خَيْرٌۭ","(is) better","فِيهِ ۗ وَٱلدَّارُ ٱلْـَٔاخِرَةُ","لِّلَّذِينَ يَتَّقُونَ ۗ أَفَلَا",62],["7:188:18",175,"ٱلْخَيْرِ","the good","ٱلْغَيْبَ لَٱسْتَكْثَرْتُ مِنَ","وَمَا مَسَّنِىَ ٱلسُّوٓءُ ۚ",62],["8:19:9",179,"خَيْرٌۭ","good","وَإِن تَنتَهُوا۟ فَهُوَ","لَّكُمْ ۖ وَإِن تَعُودُوا۟",62],["8:23:5",179,"خَيْرًۭا","any good","عَلِمَ ٱللَّهُ فِيهِمْ","لَّأَسْمَعَهُمْ ۖ وَلَوْ أَسْمَعَهُمْ",62],["8:30:15",180,"خَيْرُ","is (the) Best","وَيَمْكُرُ ٱللَّهُ ۖ وَٱللَّهُ","ٱلْمَـٰكِرِينَ",62],["8:70:14",186,"خَيْرًۭا","any good","ٱللَّهُ فِى قُلُوبِكُمْ","يُؤْتِكُمْ خَيْرًۭا مِّمَّآ",62],["8:70:16",186,"خَيْرًۭا","better","قُلُوبِكُمْ خَيْرًۭا يُؤْتِكُمْ","مِّمَّآ أُخِذَ مِنكُمْ",62],["9:3:19",187,"خَيْرٌۭ","best","فَإِن تُبْتُمْ فَهُوَ","لَّكُمْ ۖ وَإِن تَوَلَّيْتُمْ",62],["9:41:11",194,"خَيْرٌۭ","(is) better","سَبِيلِ ٱللَّهِ ۚ ذَٰلِكُمْ","لَّكُمْ إِن كُنتُمْ",62],["9:61:10",196,"خَيْرٍۢ","(of) goodness","أُذُنٌۭ ۚ قُلْ أُذُنُ","لَّكُمْ يُؤْمِنُ بِٱللَّهِ",62],["9:74:28",199,"خَيْرًۭا","better","فَإِن يَتُوبُوا۟ يَكُ","لَّهُمْ ۖ وَإِن يَتَوَلَّوْا۟",62],["9:88:11",201,"ٱلْخَيْرَٰتُ ۖ","(are) the good things","وَأَنفُسِهِمْ ۚ وَأُو۟لَـٰٓئِكَ لَهُمُ","وَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ",864],["9:109:9",204,"خَيْرٌ","better","مِنَ ٱللَّهِ وَرِضْوَٰنٍ","أَم مَّنْ أَسَّسَ",62],["10:11:7",209,"بِٱلْخَيْرِ","the good","لِلنَّاسِ ٱلشَّرَّ ٱسْتِعْجَالَهُم","لَقُضِىَ إِلَيْهِمْ أَجَلُهُمْ ۖ",62],["10:58:8",215,"خَيْرٌۭ","(is) better","فَبِذَٰلِكَ فَلْيَفْرَحُوا۟ هُوَ","مِّمَّا يَجْمَعُونَ",62],["10:107:12",221,"بِخَيْرٍۢ","any good","هُوَ ۖ وَإِن يُرِدْكَ","فَلَا رَآدَّ لِفَضْلِهِۦ ۚ",62],["10:109:10",221,"خَيْرُ","(is) the Best","يَحْكُمَ ٱللَّهُ ۚ وَهُوَ","ٱلْحَـٰكِمِينَ",62],["11:31:22",225,"خَيْرًا ۖ","any good","لَن يُؤْتِيَهُمُ ٱللَّهُ","ٱللَّهُ أَعْلَمُ بِمَا",62],["11:84:20",231,"بِخَيْرٍۢ","in prosperity","وَٱلْمِيزَانَ ۚ إِنِّىٓ أَرَىٰكُم","وَإِنِّىٓ أَخَافُ عَلَيْكُمْ",62],["11:86:3",231,"خَيْرٌۭ","(is) best","بَقِيَّتُ ٱللَّهِ","لَّكُمْ إِن كُنتُم",62],["12:39:5",240,"خَيْرٌ","better","ٱلسِّجْنِ ءَأَرْبَابٌۭ مُّتَفَرِّقُونَ","أَمِ ٱللَّهُ ٱلْوَٰحِدُ",62],["12:57:3",242,"خَيْرٌۭ","(is) better","وَلَأَجْرُ ٱلْـَٔاخِرَةِ","لِّلَّذِينَ ءَامَنُوا۟ وَكَانُوا۟",62],["12:59:16",242,"خَيْرُ","(the) best","أُوفِى ٱلْكَيْلَ وَأَنَا۠","ٱلْمُنزِلِينَ",62],["12:64:13",243,"خَيْرٌ","(is) the best","مِن قَبْلُ ۖ فَٱللَّهُ","حَـٰفِظًۭا ۖ وَهُوَ أَرْحَمُ",62],["12:80:36",245,"خَيْرُ","(is) the Best","ٱللَّهُ لِى ۖ وَهُوَ","ٱلْحَـٰكِمِينَ",62],["12:109:25",248,"خَيْرٌۭ","(is) best","قَبْلِهِمْ ۗ وَلَدَارُ ٱلْـَٔاخِرَةِ","لِّلَّذِينَ ٱتَّقَوْا۟ ۗ أَفَلَا",62],["16:30:8",270,"خَيْرًۭا ۗ","Good","أَنزَلَ رَبُّكُمْ ۚ قَالُوا۟","لِّلَّذِينَ أَحْسَنُوا۟ فِى",62],["16:30:17",270,"خَيْرٌۭ ۚ","(is) better","حَسَنَةٌۭ ۚ وَلَدَارُ ٱلْـَٔاخِرَةِ","وَلَنِعْمَ دَارُ ٱلْمُتَّقِينَ",62],["16:76:19",275,"بِخَيْرٍ ۖ","with any good","يُوَجِّههُّ لَا يَأْتِ","هَلْ يَسْتَوِى هُوَ",62],["16:95:11",278,"خَيْرٌۭ","(is) better","عِندَ ٱللَّهِ هُوَ","لَّكُمْ إِن كُنتُمْ",62],["16:126:11",281,"خَيْرٌۭ","better","وَلَئِن صَبَرْتُمْ لَهُوَ","لِّلصَّـٰبِرِينَ",62],["17:11:5",283,"بِٱلْخَيْرِ ۖ","for the good","ٱلْإِنسَـٰنُ بِٱلشَّرِّ دُعَآءَهُۥ","وَكَانَ ٱلْإِنسَـٰنُ عَجُولًۭا",62],["17:35:9",285,"خَيْرٌۭ","(is) good","بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ ۚ ذَٰلِكَ","وَأَحْسَنُ تَأْوِيلًۭا",62],["18:36:10",298,"خَيْرًۭا","better","إِلَىٰ رَبِّى لَأَجِدَنَّ","مِّنْهَا مُنقَلَبًۭا",62],["18:40:5",298,"خَيْرًۭا","better","رَبِّىٓ أَن يُؤْتِيَنِ","مِّن جَنَّتِكَ وَيُرْسِلَ",62],["18:44:6",298,"خَيْرٌۭ","(is the) best","لِلَّهِ ٱلْحَقِّ ۚ هُوَ","ثَوَابًۭا وَخَيْرٌ عُقْبًۭا",62],["18:44:8",298,"وَخَيْرٌ","and (the) best","هُوَ خَيْرٌۭ ثَوَابًۭا","عُقْبًۭا",62],["18:46:8",299,"خَيْرٌ","(are) better","ٱلدُّنْيَا ۖ وَٱلْبَـٰقِيَـٰتُ ٱلصَّـٰلِحَـٰتُ","عِندَ رَبِّكَ ثَوَابًۭا",62],["18:46:12",299,"وَخَيْرٌ","and better","عِندَ رَبِّكَ ثَوَابًۭا","أَمَلًۭا",62],["18:81:5",302,"خَيْرًۭا","a better","أَن يُبْدِلَهُمَا رَبُّهُمَا","مِّنْهُ زَكَوٰةًۭ وَأَقْرَبَ",62],["18:95:6",303,"خَيْرٌۭ","(is) better","مَكَّنِّى فِيهِ رَبِّى","فَأَعِينُونِى بِقُوَّةٍ أَجْعَلْ",62],["19:73:13",310,"خَيْرٌۭ","(is) better","ءَامَنُوٓا۟ أَىُّ ٱلْفَرِيقَيْنِ","مَّقَامًۭا وَأَحْسَنُ نَدِيًّۭا",62],["19:76:8",310,"خَيْرٌ","(are) better","هُدًۭى ۗ وَٱلْبَـٰقِيَـٰتُ ٱلصَّـٰلِحَـٰتُ","عِندَ رَبِّكَ ثَوَابًۭا",62],["19:76:12",310,"وَخَيْرٌۭ","and better","عِندَ رَبِّكَ ثَوَابًۭا","مَّرَدًّا",62],["20:13:2",313,"ٱخْتَرْتُكَ","(have) chosen you","وَأَنَا","فَٱسْتَمِعْ لِمَا يُوحَىٰٓ",1703],["20:73:13",316,"خَيْرٌۭ","(is) Best","مِنَ ٱلسِّحْرِ ۗ وَٱللَّهُ","وَأَبْقَىٰٓ",62],["20:131:17",321,"خَيْرٌۭ","(is) better","فِيهِ ۚ وَرِزْقُ رَبِّكَ","وَأَبْقَىٰ",62],["21:35:7",324,"وَٱلْخَيْرِ","and [the] good","ٱلْمَوْتِ ۗ وَنَبْلُوكُم بِٱلشَّرِّ","فِتْنَةًۭ ۖ وَإِلَيْنَا تُرْجَعُونَ",62],["21:73:8",328,"ٱلْخَيْرَٰتِ","(of) good deeds","وَأَوْحَيْنَآ إِلَيْهِمْ فِعْلَ","وَإِقَامَ ٱلصَّلَوٰةِ وَإِيتَآءَ",864],["21:89:10",329,"خَيْرُ","(are) [the] Best","تَذَرْنِى فَرْدًۭا وَأَنتَ","ٱلْوَٰرِثِينَ",62],["21:90:13",329,"ٱلْخَيْرَٰتِ","good deeds","كَانُوا۟ يُسَـٰرِعُونَ فِى","وَيَدْعُونَنَا رَغَبًۭا وَرَهَبًۭا ۖ",864],["22:11:10",333,"خَيْرٌ","good","حَرْفٍۢ ۖ فَإِنْ أَصَابَهُۥ","ٱطْمَأَنَّ بِهِۦ ۖ وَإِنْ",62],["22:30:7",335,"خَيْرٌۭ","(is) best","حُرُمَـٰتِ ٱللَّهِ فَهُوَ","لَّهُۥ عِندَ رَبِّهِۦ ۗ",62],["22:36:9",336,"خَيْرٌۭ ۖ","(is) good","ٱللَّهِ لَكُمْ فِيهَا","فَٱذْكُرُوا۟ ٱسْمَ ٱللَّهِ",62],["22:58:17",339,"خَيْرُ","(is the) Best","وَإِنَّ ٱللَّهَ لَهُوَ","ٱلرَّٰزِقِينَ",62],["22:77:9",341,"ٱلْخَيْرَ","[the] good","وَٱعْبُدُوا۟ رَبَّكُمْ وَٱفْعَلُوا۟","لَعَلَّكُمْ تُفْلِحُونَ ۩",62],["23:29:7",344,"خَيْرُ","(are) the Best","مُنزَلًۭا مُّبَارَكًۭا وَأَنتَ","ٱلْمُنزِلِينَ",62],["23:56:4",345,"ٱلْخَيْرَٰتِ ۚ","the good","نُسَارِعُ لَهُمْ فِى","بَل لَّا يَشْعُرُونَ",864],["23:61:4",346,"ٱلْخَيْرَٰتِ","the good (deeds)","أُو۟لَـٰٓئِكَ يُسَـٰرِعُونَ فِى","وَهُمْ لَهَا سَـٰبِقُونَ",864],["23:72:6",346,"خَيْرٌۭ ۖ","(is) best","خَرْجًۭا فَخَرَاجُ رَبِّكَ","وَهُوَ خَيْرُ ٱلرَّٰزِقِينَ",62],["23:72:8",346,"خَيْرُ","(is) the Best","رَبِّكَ خَيْرٌۭ ۖ وَهُوَ","ٱلرَّٰزِقِينَ",62],["23:109:13",349,"خَيْرُ","(are) best","لَنَا وَٱرْحَمْنَا وَأَنتَ","ٱلرَّٰحِمِينَ",62],["23:118:6",349,"خَيْرُ","(are the) Best","ٱغْفِرْ وَٱرْحَمْ وَأَنتَ","ٱلرَّٰحِمِينَ",62],["24:11:13",351,"خَيْرٌۭ","(is) good","لَّكُم ۖ بَلْ هُوَ","لَّكُمْ ۚ لِكُلِّ ٱمْرِئٍۢ",62],["24:12:8",351,"خَيْرًۭا","good of themselves","ٱلْمُؤْمِنُونَ وَٱلْمُؤْمِنَـٰتُ بِأَنفُسِهِمْ","وَقَالُوا۟ هَـٰذَآ إِفْكٌۭ",62],["24:27:15",352,"خَيْرٌۭ","(is) best","عَلَىٰٓ أَهْلِهَا ۚ ذَٰلِكُمْ","لَّكُمْ لَعَلَّكُمْ تَذَكَّرُونَ",62],["24:33:21",354,"خَيْرًۭا ۖ","any good","إِنْ عَلِمْتُمْ فِيهِمْ","وَءَاتُوهُم مِّن مَّالِ",62],["24:60:19",358,"خَيْرٌۭ","(is) better","بِزِينَةٍۢ ۖ وَأَن يَسْتَعْفِفْنَ","لَّهُنَّ ۗ وَٱللَّهُ سَمِيعٌ",62],["25:10:7",360,"خَيْرًۭا","better","شَآءَ جَعَلَ لَكَ","مِّن ذَٰلِكَ جَنَّـٰتٍۢ",62],["25:15:3",361,"خَيْرٌ","better","قُلْ أَذَٰلِكَ","أَمْ جَنَّةُ ٱلْخُلْدِ",62],["25:24:4",362,"خَيْرٌۭ","(will be in) a better","أَصْحَـٰبُ ٱلْجَنَّةِ يَوْمَئِذٍ","مُّسْتَقَرًّۭا وَأَحْسَنُ مَقِيلًۭا",62],["27:36:10",380,"خَيْرٌۭ","(is) better","فَمَآ ءَاتَىٰنِۦَ ٱللَّهُ","مِّمَّآ ءَاتَىٰكُم بَلْ",62],["27:59:10",382,"خَيْرٌ","better","ٱلَّذِينَ ٱصْطَفَىٰٓ ۗ ءَآللَّهُ","أَمَّا يُشْرِكُونَ",62],["27:89:5",385,"خَيْرٌۭ","(will be) better","جَآءَ بِٱلْحَسَنَةِ فَلَهُۥ","مِّنْهَا وَهُم مِّن",62],["28:24:14",388,"خَيْرٍۢ","good","أَنزَلْتَ إِلَىَّ مِنْ","فَقِيرٌۭ",62],["28:26:6",388,"خَيْرَ","(the) best","يَـٰٓأَبَتِ ٱسْتَـْٔجِرْهُ ۖ إِنَّ","مَنِ ٱسْتَـْٔجَرْتَ ٱلْقَوِىُّ",62],["28:60:12",393,"خَيْرٌۭ","(is) better","وَمَا عِندَ ٱللَّهِ","وَأَبْقَىٰٓ ۚ أَفَلَا تَعْقِلُونَ",62],["28:68:5",393,"وَيَخْتَارُ ۗ","and chooses","يَخْلُقُ مَا يَشَآءُ","مَا كَانَ لَهُمُ",1703],["28:68:9",393,"ٱلْخِيَرَةُ ۚ","the choice","مَا كَانَ لَهُمُ","سُبْحَـٰنَ ٱللَّهِ وَتَعَـٰلَىٰ",2746],["28:80:8",395,"خَيْرٌۭ","(is) better","وَيْلَكُمْ ثَوَابُ ٱللَّهِ","لِّمَنْ ءَامَنَ وَعَمِلَ",62],["28:84:5",395,"خَيْرٌۭ","(will be) better","جَآءَ بِٱلْحَسَنَةِ فَلَهُۥ","مِّنْهَا ۖ وَمَن جَآءَ",62],["29:16:9",398,"خَيْرٌۭ","(is) better","ٱللَّهَ وَٱتَّقُوهُ ۖ ذَٰلِكُمْ","لَّكُمْ إِن كُنتُمْ",62],["30:38:9",408,"خَيْرٌۭ","(is) best","وَٱبْنَ ٱلسَّبِيلِ ۚ ذَٰلِكَ","لِّلَّذِينَ يُرِيدُونَ وَجْهَ",62],["33:19:24",420,"ٱلْخَيْرِ ۚ","the good","حِدَادٍ أَشِحَّةً عَلَى","أُو۟لَـٰٓئِكَ لَمْ يُؤْمِنُوا۟",62],["33:25:8",421,"خَيْرًۭا ۚ","any good","بِغَيْظِهِمْ لَمْ يَنَالُوا۟","وَكَفَى ٱللَّهُ ٱلْمُؤْمِنِينَ",62],["33:36:14",423,"ٱلْخِيَرَةُ","(any) choice","أَن يَكُونَ لَهُمُ","مِنْ أَمْرِهِمْ ۗ وَمَن",2746],["34:39:19",432,"خَيْرُ","(is the) Best","فَهُوَ يُخْلِفُهُۥ ۖ وَهُوَ","ٱلرَّٰزِقِينَ",62],["35:32:15",438,"بِٱلْخَيْرَٰتِ","in good deeds","مُّقْتَصِدٌۭ وَمِنْهُمْ سَابِقٌۢ","بِإِذْنِ ٱللَّهِ ۚ ذَٰلِكَ",864],["37:62:2",448,"خَيْرٌۭ","better","أَذَٰلِكَ","نُّزُلًا أَمْ شَجَرَةُ",62],["38:32:5",455,"ٱلْخَيْرِ","(of) the good","إِنِّىٓ أَحْبَبْتُ حُبَّ","عَن ذِكْرِ رَبِّى",62],["38:47:5",456,"ٱلْأَخْيَارِ","the best","عِندَنَا لَمِنَ ٱلْمُصْطَفَيْنَ","",62],["38:48:8",456,"ٱلْأَخْيَارِ","the best","ٱلْكِفْلِ ۖ وَكُلٌّۭ مِّنَ","",62],["38:76:3",457,"خَيْرٌۭ","better","قَالَ أَنَا۠","مِّنْهُ ۖ خَلَقْتَنِى مِن",62],["41:40:13",481,"خَيْرٌ","better","يُلْقَىٰ فِى ٱلنَّارِ","أَم مَّن يَأْتِىٓ",62],["41:49:6",482,"ٱلْخَيْرِ","(for) the good","ٱلْإِنسَـٰنُ مِن دُعَآءِ","وَإِن مَّسَّهُ ٱلشَّرُّ",62],["42:36:11",487,"خَيْرٌۭ","(is) better","وَمَا عِندَ ٱللَّهِ","وَأَبْقَىٰ لِلَّذِينَ ءَامَنُوا۟",62],["43:32:23",491,"خَيْرٌۭ","(is) better","سُخْر