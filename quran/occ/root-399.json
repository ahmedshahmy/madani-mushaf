[["5:14:25",110,"يَصْنَعُونَ","do","ٱللَّهُ بِمَا كَانُوا۟","",624],["5:63:13",118,"يَصْنَعُونَ","do","لَبِئْسَ مَا كَانُوا۟","",624],["7:137:24",166,"يَصْنَعُ","make","وَدَمَّرْنَا مَا كَانَ","فِرْعَوْنُ وَقَوْمُهُۥ وَمَا",624],["11:16:11",223,"صَنَعُوا۟","they did","ٱلنَّارُ ۖ وَحَبِطَ مَا","فِيهَا وَبَـٰطِلٌۭ مَّا",624],["11:37:1",225,"وَٱصْنَعِ","And construct","","ٱلْفُلْكَ بِأَعْيُنِنَا وَوَحْيِنَا",624],["11:38:1",226,"وَيَصْنَعُ","And he was constructing","","ٱلْفُلْكَ وَكُلَّمَا مَرَّ",624],["13:31:36",253,"صَنَعُوا۟","they did","كَفَرُوا۟ تُصِيبُهُم بِمَا","قَارِعَةٌ أَوْ تَحُلُّ",624],["16:112:24",280,"يَصْنَعُونَ","do","وَٱلْخَوْفِ بِمَا كَانُوا۟","",624],["18:104:11",304,"صُنْعًا","(in) work","يَحْسَبُونَ أَنَّهُمْ يُحْسِنُونَ","",2301],["20:39:20",314,"وَلِتُصْنَعَ","and that you may be brought up","عَلَيْكَ مَحَبَّةًۭ مِّنِّى","عَلَىٰ عَيْنِىٓ",624],["20:41:1",314,"وَٱصْطَنَعْتُكَ","And I (have) chosen you","","لِنَفْسِى",4788],["20:69:7",316,"صَنَعُوٓا۟ ۖ","they have made","يَمِينِكَ تَلْقَفْ مَا","إِنَّمَا صَنَعُوا۟ كَيْدُ",624],["20:69:9",316,"صَنَعُوا۟","they (have) made","مَا صَنَعُوٓا۟ ۖ إِنَّمَا","كَيْدُ سَـٰحِرٍۢ ۖ وَلَا",624],["21:80:2",328,"صَنْعَةَ","(the) making","وَعَلَّمْنَـٰهُ","لَبُوسٍۢ لَّكُمْ لِتُحْصِنَكُم",3249],["23:27:4",343,"ٱصْنَعِ","construct","فَأَوْحَيْنَآ إِلَيْهِ أَنِ","ٱلْفُلْكَ بِأَعْيُنِنَا وَوَحْيِنَا",624],["24:30:15",353,"يَصْنَعُونَ","they do","ٱللَّهَ خَبِيرٌۢ بِمَا","",624],["26:129:2",372,"مَصَانِعَ","strongholds","وَتَتَّخِذُونَ","لَعَلَّكُمْ تَخْلُدُونَ",3641],["27:88:9",384,"صُنْعَ","(The) Work","تَمُرُّ مَرَّ ٱلسَّحَابِ ۚ","ٱللَّهِ ٱلَّذِىٓ أَتْقَنَ",2301],["29:45:21",401,"تَصْنَعُونَ","you do","وَٱللَّهُ يَعْلَمُ مَا","",624],["35:8:25",435,"يَصْنَعُونَ","they do","ٱللَّهَ عَلِيمٌۢ بِمَا","",624]]