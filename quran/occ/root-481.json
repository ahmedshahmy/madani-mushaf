[["6:141:9",146,"وَٱلزَّرْعَ","and the crops","وَغَيْرَ مَعْرُوشَـٰتٍۢ وَٱلنَّخْلَ","مُخْتَلِفًا أُكُلُهُۥ وَٱلزَّيْتُونَ",867],["12:47:2",241,"تَزْرَعُونَ","You will sow","قَالَ","سَبْعَ سِنِينَ دَأَبًۭا",2688],["13:4:8",249,"وَزَرْعٌۭ","and crops","وَجَنَّـٰتٌۭ مِّنْ أَعْنَـٰبٍۢ","وَنَخِيلٌۭ صِنْوَانٌۭ وَغَيْرُ",867],["14:37:9",260,"زَرْعٍ","cultivation","بِوَادٍ غَيْرِ ذِى","عِندَ بَيْتِكَ ٱلْمُحَرَّمِ",867],["16:11:4",268,"ٱلزَّرْعَ","the crops","يُنۢبِتُ لَكُم بِهِ","وَٱلزَّيْتُونَ وَٱلنَّخِيلَ وَٱلْأَعْنَـٰبَ",867],["18:32:14",297,"زَرْعًۭا","crops","بِنَخْلٍۢ وَجَعَلْنَا بَيْنَهُمَا","",867],["26:148:1",373,"وَزُرُوعٍۢ","And cornfields","","وَنَخْلٍۢ طَلْعُهَا هَضِيمٌۭ",867],["32:27:11",417,"زَرْعًۭا","crops","ٱلْجُرُزِ فَنُخْرِجُ بِهِۦ","تَأْكُلُ مِنْهُ أَنْعَـٰمُهُمْ",867],["39:21:16",460,"زَرْعًۭا","crops","ثُمَّ يُخْرِجُ بِهِۦ","مُّخْتَلِفًا أَلْوَٰنُهُۥ ثُمَّ",867],["44:26:1",497,"وَزُرُوعٍۢ","And cornfields","","وَمَقَامٍۢ كَرِيمٍۢ",867],["48:29:32",515,"كَزَرْعٍ","(is) like a seed","وَمَثَلُهُمْ فِى ٱلْإِنجِيلِ","أَخْرَجَ شَطْـَٔهُۥ فَـَٔازَرَهُۥ",867],["48:29:41",515,"ٱلزُّرَّاعَ","the sowers","عَلَىٰ سُوقِهِۦ يُعْجِبُ","لِيَغِيظَ بِهِمُ ٱلْكُفَّارَ ۗ",4777],["56:64:2",536,"تَزْرَعُونَهُۥٓ","cause it to grow","ءَأَنتُمْ","أَمْ نَحْنُ ٱلزَّٰرِعُونَ",2688],["56:64:5",536,"ٱلزَّٰرِعُونَ","the Ones Who grow","تَزْرَعُونَهُۥٓ أَمْ نَحْنُ","",4774]]