[["9:37:14",193,"لِّيُوَاطِـُٔوا۟","to adjust","عَامًۭا وَيُحَرِّمُونَهُۥ عَامًۭا","عِدَّةَ مَا حَرَّمَ",4738],["9:120:32",206,"يَطَـُٔونَ","they step","سَبِيلِ ٱللَّهِ وَلَا","مَوْطِئًۭا يَغِيظُ ٱلْكُفَّارَ",2051],["9:120:33",206,"مَوْطِئًۭا","any step","ٱللَّهِ وَلَا يَطَـُٔونَ","يَغِيظُ ٱلْكُفَّارَ وَلَا",3728],["33:27:7",421,"تَطَـُٔوهَا ۚ","you (had) trodden","وَأَمْوَٰلَهُمْ وَأَرْضًۭا لَّمْ","وَكَانَ ٱللَّهُ عَلَىٰ",2051],["48:25:21",514,"تَطَـُٔوهُمْ","you may trample them","لَّمْ تَعْلَمُوهُمْ أَن","فَتُصِيبَكُم مِّنْهُم مَّعَرَّةٌۢ",2051],["73:6:6",574,"وَطْـًۭٔا","and most potent","ٱلَّيْلِ هِىَ أَشَدُّ","وَأَقْوَمُ قِيلًا",4516]]