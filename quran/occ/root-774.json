[["3:118:17",65,"ٱلْبَغْضَآءُ","the hatred","عَنِتُّمْ قَدْ بَدَتِ","مِنْ أَفْوَٰهِهِمْ وَمَا",1320],["5:14:16",110,"وَٱلْبَغْضَآءَ","and [the] hatred","فَأَغْرَيْنَا بَيْنَهُمُ ٱلْعَدَاوَةَ","إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ ۚ",1320],["5:64:30",118,"وَٱلْبَغْضَآءَ","and [the] hatred","وَأَلْقَيْنَا بَيْنَهُمُ ٱلْعَدَٰوَةَ","إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ ۚ",1320],["5:91:8",123,"وَٱلْبَغْضَآءَ","and [the] hatred","يُوقِعَ بَيْنَكُمُ ٱلْعَدَٰوَةَ","فِى ٱلْخَمْرِ وَٱلْمَيْسِرِ",1320],["60:4:27",549,"وَٱلْبَغْضَآءُ","and hatred","بَيْنَنَا وَبَيْنَكُمُ ٱلْعَدَٰوَةُ","أَبَدًا حَتَّىٰ تُؤْمِنُوا۟",1320]]