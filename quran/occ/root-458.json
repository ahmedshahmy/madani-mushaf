[["2:187:18",29,"تَخْتَانُونَ","deceive","ٱللَّهُ أَنَّكُمْ كُنتُمْ","أَنفُسَكُمْ فَتَابَ عَلَيْكُمْ",2791],["4:105:14",95,"لِّلْخَآئِنِينَ","for the deceitful","ٱللَّهُ ۚ وَلَا تَكُن","خَصِيمًۭا",2034],["4:107:5",96,"يَخْتَانُونَ","deceive","تُجَـٰدِلْ عَنِ ٱلَّذِينَ","أَنفُسَهُمْ ۚ إِنَّ ٱللَّهَ",2791],["4:107:13",96,"خَوَّانًا","treacherous","يُحِبُّ مَن كَانَ","أَثِيمًۭا",2743],["5:13:21",109,"خَآئِنَةٍۢ","treachery","تَزَالُ تَطَّلِعُ عَلَىٰ","مِّنْهُمْ إِلَّا قَلِيلًۭا",2725],["8:27:5",180,"تَخُونُوا۟","betray","ٱلَّذِينَ ءَامَنُوا۟ لَا","ٱللَّهَ وَٱلرَّسُولَ وَتَخُونُوٓا۟",1414],["8:27:8",180,"وَتَخُونُوٓا۟","or betray","تَخُونُوا۟ ٱللَّهَ وَٱلرَّسُولَ","أَمَـٰنَـٰتِكُمْ وَأَنتُمْ تَعْلَمُونَ",1414],["8:58:5",184,"خِيَانَةًۭ","betrayal","تَخَافَنَّ مِن قَوْمٍ","فَٱنۢبِذْ إِلَيْهِمْ عَلَىٰ",2745],["8:58:14",184,"ٱلْخَآئِنِينَ","the traitors","ٱللَّهَ لَا يُحِبُّ","",2034],["8:71:3",186,"خِيَانَتَكَ","(to) betray you","وَإِن يُرِيدُوا۟","فَقَدْ خَانُوا۟ ٱللَّهَ",2745],["8:71:5",186,"خَانُوا۟","they have betrayed","يُرِيدُوا۟ خِيَانَتَكَ فَقَدْ","ٱللَّهَ مِن قَبْلُ",1414],["12:52:5",241,"أَخُنْهُ","[I] betray him","لِيَعْلَمَ أَنِّى لَمْ","بِٱلْغَيْبِ وَأَنَّ ٱللَّهَ",1414],["12:52:12",241,"ٱلْخَآئِنِينَ","(of) the betrayers","لَا يَهْدِى كَيْدَ","",2034],["22:38:12",336,"خَوَّانٍۢ","treacherous","لَا يُحِبُّ كُلَّ","كَفُورٍ",2743],["40:19:2",469,"خَآئِنَةَ","(the) stealthy glance","يَعْلَمُ","ٱلْأَعْيُنِ وَمَا تُخْفِى",2725],["66:10:16",561,"فَخَانَتَاهُمَا","but they both betrayed them","مِنْ عِبَادِنَا صَـٰلِحَيْنِ","فَلَمْ يُغْنِيَا عَنْهُمَا",1414]]