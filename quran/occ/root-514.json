[["2:185:35",28,"ٱلْعُسْرَ","[the] hardship","وَلَا يُرِيدُ بِكُمُ","وَلِتُكْمِلُوا۟ ٱلْعِدَّةَ وَلِتُكَبِّرُوا۟",1298],["2:280:4",47,"عُسْرَةٍۢ","in difficulty","وَإِن كَانَ ذُو","فَنَظِرَةٌ إِلَىٰ مَيْسَرَةٍۢ ۚ",2261],["9:117:12",205,"ٱلْعُسْرَةِ","(of) difficulty","ٱتَّبَعُوهُ فِى سَاعَةِ","مِنۢ بَعْدِ مَا",2261],["18:73:10",301,"عُسْرًۭا","(raising) difficulty","تُرْهِقْنِى مِنْ أَمْرِى","",1298],["25:26:9",362,"عَسِيرًۭا","difficult","يَوْمًا عَلَى ٱلْكَـٰفِرِينَ","",2245],["54:8:8",529,"عَسِرٌۭ","difficult","ٱلْكَـٰفِرُونَ هَـٰذَا يَوْمٌ","",3127],["65:6:29",559,"تَعَاسَرْتُمْ","you disagree","بَيْنَكُم بِمَعْرُوفٍۢ ۖ وَإِن","فَسَتُرْضِعُ لَهُۥٓ أُخْرَىٰ",4319],["65:7:24",559,"عُسْرٍۢ","hardship","سَيَجْعَلُ ٱللَّهُ بَعْدَ","يُسْرًۭا",1298],["74:9:4",575,"عَسِيرٌ","difficult","فَذَٰلِكَ يَوْمَئِذٍۢ يَوْمٌ","",2245],["92:10:2",596,"لِلْعُسْرَىٰ","towards [the] difficulty","فَسَنُيَسِّرُهُۥ","",3155],["94:5:3",597,"ٱلْعُسْرِ","the hardship","فَإِنَّ مَعَ","يُسْرًا",1298],["94:6:3",597,"ٱلْعُسْرِ","the hardship","إِنَّ مَعَ","يُسْرًۭا",1298]]