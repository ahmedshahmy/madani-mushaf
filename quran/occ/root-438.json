[["3:4:18",50,"ٱنتِقَامٍ","(of) retribution","وَٱللَّهُ عَزِيزٌۭ ذُو","",1693],["5:59:5",118,"تَنقِمُونَ","you resent","يَـٰٓأَهْلَ ٱلْكِتَـٰبِ هَلْ","مِنَّآ إِلَّآ أَنْ",1614],["5:95:44",123,"فَيَنتَقِمُ","then will take retribution","سَلَفَ ۚ وَمَنْ عَادَ","ٱللَّهُ مِنْهُ ۗ وَٱللَّهُ",1259],["5:95:50",123,"ٱنتِقَامٍ","(of) Retribution","وَٱللَّهُ عَزِيزٌۭ ذُو","",1693],["7:126:2",165,"تَنقِمُ","you take revenge","وَمَا","مِنَّآ إِلَّآ أَنْ",1614],["7:136:1",166,"فَٱنتَقَمْنَا","So We took retribution","","مِنْهُمْ فَأَغْرَقْنَـٰهُمْ فِى",1259],["9:74:17",199,"نَقَمُوٓا۟","they were resentful","لَمْ يَنَالُوا۟ ۚ وَمَا","إِلَّآ أَنْ أَغْنَىٰهُمُ",1614],["14:47:11",261,"ٱنتِقَامٍۢ","Owner (of) Retribution","ٱللَّهَ عَزِيزٌۭ ذُو","",1693],["15:79:1",266,"فَٱنتَقَمْنَا","So We took retribution","","مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍۢ",1259],["30:47:10",409,"فَٱنتَقَمْنَا","then We took retribution","قَوْمِهِمْ فَجَآءُوهُم بِٱلْبَيِّنَـٰتِ","مِنَ ٱلَّذِينَ أَجْرَمُوا۟ ۖ",1259],["32:22:13",417,"مُنتَقِمُونَ","(will) take retribution","إِنَّا مِنَ ٱلْمُجْرِمِينَ","",1912],["39:37:12",462,"ٱنتِقَامٍۢ","All-Able of retribution","ٱللَّهُ بِعَزِيزٍۢ ذِى","",1693],["43:25:1",491,"فَٱنتَقَمْنَا","So We took retribution","","مِنْهُمْ ۖ فَٱنظُرْ كَيْفَ",1259],["43:41:6",492,"مُّنتَقِمُونَ","(will) take retribution","بِكَ فَإِنَّا مِنْهُم","",1912],["43:55:3",493,"ٱنتَقَمْنَا","We took retribution","فَلَمَّآ ءَاسَفُونَا","مِنْهُمْ فَأَغْرَقْنَـٰهُمْ أَجْمَعِينَ",1259],["44:16:6",496,"مُنتَقِمُونَ","(will) take retribution","ٱلْبَطْشَةَ ٱلْكُبْرَىٰٓ إِنَّا","",1912],["85:8:2",590,"نَقَمُوا۟","they resented","وَمَا","مِنْهُمْ إِلَّآ أَن",1614]]