[["2:60:17",9,"أُنَاسٍۢ","(the) people","قَدْ عَلِمَ كُلُّ","مَّشْرَبَهُمْ ۖ كُلُوا۟ وَٱشْرَبُوا۟",167],["4:6:8",77,"ءَانَسْتُم","you perceive","بَلَغُوا۟ ٱلنِّكَاحَ فَإِنْ","مِّنْهُمْ رُشْدًۭا فَٱدْفَعُوٓا۟",1268],["4:28:7",83,"ٱلْإِنسَـٰنُ","the mankind","يُخَفِّفَ عَنكُمْ ۚ وَخُلِقَ","ضَعِيفًۭا",167],["6:112:7",142,"ٱلْإِنسِ","(from) the mankind","نَبِىٍّ عَدُوًّۭا شَيَـٰطِينَ","وَٱلْجِنِّ يُوحِى بَعْضُهُمْ",538],["6:128:9",144,"ٱلْإِنسِ ۖ","the mankind","قَدِ ٱسْتَكْثَرْتُم مِّنَ","وَقَالَ أَوْلِيَآؤُهُم مِّنَ",538],["6:128:13",144,"ٱلْإِنسِ","the men","وَقَالَ أَوْلِيَآؤُهُم مِّنَ","رَبَّنَا ٱسْتَمْتَعَ بَعْضُنَا",538],["6:130:3",144,"وَٱلْإِنسِ","and [the] men","يَـٰمَعْشَرَ ٱلْجِنِّ","أَلَمْ يَأْتِكُمْ رُسُلٌۭ",538],["7:38:11",155,"وَٱلْإِنسِ","and the men","قَبْلِكُم مِّنَ ٱلْجِنِّ","فِى ٱلنَّارِ ۖ كُلَّمَا",538],["7:82:12",161,"أُنَاسٌۭ","(are) people","مِّن قَرْيَتِكُمْ ۖ إِنَّهُمْ","يَتَطَهَّرُونَ",167],["7:160:24",171,"أُنَاسٍۢ","people","قَدْ عَلِمَ كُلُّ","مَّشْرَبَهُمْ ۚ وَظَلَّلْنَا عَلَيْهِمُ",167],["7:179:7",174,"وَٱلْإِنسِ ۖ","and men","كَثِيرًۭا مِّنَ ٱلْجِنِّ","لَهُمْ قُلُوبٌۭ لَّا",538],["10:12:3",209,"ٱلْإِنسَـٰنَ","the man","وَإِذَا مَسَّ","ٱلضُّرُّ دَعَانَا لِجَنۢبِهِۦٓ",167],["11:9:3",222,"ٱلْإِنسَـٰنَ","We give man a taste","وَلَئِنْ أَذَقْنَا","مِنَّا رَحْمَةًۭ ثُمَّ",167],["12:5:13",236,"لِلْإِنسَـٰنِ","(is) to man","كَيْدًا ۖ إِنَّ ٱلشَّيْطَـٰنَ","عَدُوٌّۭ مُّبِينٌۭ",167],["14:34:13",260,"ٱلْإِنسَـٰنَ","the mankind","لَا تُحْصُوهَآ ۗ إِنَّ","لَظَلُومٌۭ كَفَّارٌۭ",167],["15:26:3",263,"ٱلْإِنسَـٰنَ","humankind","وَلَقَدْ خَلَقْنَا","مِن صَلْصَـٰلٍۢ مِّنْ",167],["16:4:2",267,"ٱلْإِنسَـٰنَ","the human kind","خَلَقَ","مِن نُّطْفَةٍۢ فَإِذَا",167],["17:11:2",283,"ٱلْإِنسَـٰنُ","the man","وَيَدْعُ","بِٱلشَّرِّ دُعَآءَهُۥ بِٱلْخَيْرِ ۖ",167],["17:11:7",283,"ٱلْإِنسَـٰنُ","the man","دُعَآءَهُۥ بِٱلْخَيْرِ ۖ وَكَانَ","عَجُولًۭا",167],["17:13:2",283,"إِنسَـٰنٍ","man","وَكُلَّ","أَلْزَمْنَـٰهُ طَـٰٓئِرَهُۥ فِى",167],["17:53:14",287,"لِلْإِنسَـ