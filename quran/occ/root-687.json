[["12:76:2",244,"بِأَوْعِيَتِهِمْ","with their bags","فَبَدَأَ","قَبْلَ وِعَآءِ أَخِيهِ",2029],["12:76:4",244,"وِعَآءِ","(the) bag","فَبَدَأَ بِأَوْعِيَتِهِمْ قَبْلَ","أَخِيهِ ثُمَّ ٱسْتَخْرَجَهَا",2029],["12:76:9",244,"وِعَآءِ","(the) bag","ثُمَّ ٱسْتَخْرَجَهَا مِن","أَخِيهِ ۚ كَذَٰلِكَ كِدْنَا",2029],["69:12:4",567,"وَتَعِيَهَآ","and would be conscious of it","لِنَجْعَلَهَا لَكُمْ تَذْكِرَةًۭ","أُذُنٌۭ وَٰعِيَةٌۭ",4322],["69:12:6",567,"وَٰعِيَةٌۭ","conscious","تَذْكِرَةًۭ وَتَعِيَهَآ أُذُنٌۭ","",4518],["70:18:2",569,"فَأَوْعَىٰٓ","and hoarded","وَجَمَعَ","",2199],["84:23:4",589,"يُوعُونَ","they keep within themselves","وَٱللَّهُ أَعْلَمُ بِمَا","",2199]]