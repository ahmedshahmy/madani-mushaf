[["2:4:4",2,"أُنزِلَ","(is) sent down","وَٱلَّذِينَ يُؤْمِنُونَ بِمَآ","إِلَيْكَ وَمَآ أُنزِلَ",61],["2:4:7",2,"أُنزِلَ","was sent down","أُنزِلَ إِلَيْكَ وَمَآ","مِن قَبْلِكَ وَبِٱلْـَٔاخِرَةِ",61],["2:22:8",4,"وَأَنزَلَ","and sent down","فِرَٰشًۭا وَٱلسَّمَآءَ بِنَآءًۭ","مِنَ ٱلسَّمَآءِ مَآءًۭ",61],["2:23:6",4,"نَزَّلْنَا","We have revealed","فِى رَيْبٍۢ مِّمَّا","عَلَىٰ عَبْدِنَا فَأْتُوا۟",197],["2:41:3",7,"أَنزَلْتُ","I have sent down","وَءَامِنُوا۟ بِمَآ","مُصَدِّقًۭا لِّمَا مَعَكُمْ",61],["2:57:4",8,"وَأَنزَلْنَا","and We sent down","وَظَلَّلْنَا عَلَيْكُمُ ٱلْغَمَامَ","عَلَيْكُمُ ٱلْمَنَّ وَٱلسَّلْوَىٰ ۖ",61],["2:59:9",9,"فَأَنزَلْنَا","so We sent down","ٱلَّذِى قِيلَ لَهُمْ","عَلَى ٱلَّذِينَ ظَلَمُوا۟",61],["2:90:8",14,"أَنزَلَ","has revealed","أَن يَكْفُرُوا۟ بِمَآ","ٱللَّهُ بَغْيًا أَن",61],["2:90:12",14,"يُنَزِّلَ","sends down","ٱللَّهُ بَغْيًا أَن","ٱللَّهُ مِن فَضْلِهِۦ",197],["2:91:6",14,"أَنزَلَ","has revealed","لَهُمْ ءَامِنُوا۟ بِمَآ","ٱللَّهُ قَالُوا۟ نُؤْمِنُ",61],["2:91:11",14,"أُنزِلَ","was revealed","قَالُوا۟ نُؤْمِنُ بِمَآ","عَلَيْنَا وَيَكْفُرُونَ بِمَا",61],["2:97:7",15,"نَزَّلَهُۥ","brought it down","عَدُوًّۭا لِّجِبْرِيلَ فَإِنَّهُۥ","عَلَىٰ قَلْبِكَ بِإِذْنِ",197],["2:99:2",15,"أَنزَلْنَآ","We revealed","وَلَقَدْ","إِلَيْكَ ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ ۖ",61],["2:102:18",16,"أُنزِلَ","was sent down","ٱلنَّاسَ ٱلسِّحْرَ وَمَآ","عَلَى ٱلْمَلَكَيْنِ بِبَابِلَ",61],["2:105:11",16,"يُنَزَّلَ","(there should) be sent down","وَلَا ٱلْمُشْرِكِينَ أَن","عَلَيْكُم مِّنْ خَيْرٍۢ",197],["2:136:5",21,"أُنزِلَ","(is) revealed","ءَامَنَّا بِٱللَّهِ وَمَآ","إِلَيْنَا وَمَآ أُنزِلَ",61],["2:136:8",21,"أُنزِلَ","was revealed","أُنزِلَ إِلَيْنَا وَمَآ","إِلَىٰٓ إِبْرَٰهِـۧمَ وَإِسْمَـٰعِيلَ",61],["2:159:5",24,"أَنزَلْنَا","We revealed","ٱلَّذِينَ يَكْتُمُونَ مَآ","مِنَ ٱلْبَيِّنَـٰتِ وَٱلْهُدَىٰ",61],["2:164:18",25,"أَنزَلَ","(has) sent down","يَنفَعُ ٱلنَّاسَ وَمَآ","ٱللَّهُ مِنَ ٱلسَّمَآءِ",61],["2:170:6",26,"أَنزَلَ","has revealed","لَهُمُ ٱتَّبِعُوا۟ مَآ","ٱللَّهُ قَالُوا۟ بَلْ",61],["2:174:5",26,"أَنزَلَ","(has) revealed","ٱلَّذِينَ يَكْتُمُونَ مَآ","ٱللَّهُ مِنَ ٱلْكِتَـٰبِ",61],["2:176:4",26,"نَزَّلَ","revealed","ذَٰلِكَ بِأَنَّ ٱللَّهَ","ٱلْكِتَـٰبَ بِٱلْحَقِّ ۗ وَإِنَّ",197],["2:185:4",28,"أُنزِلَ","was revealed","شَهْرُ رَمَضَانَ ٱلَّذِىٓ","فِيهِ ٱلْقُرْءَانُ هُدًۭى",61],["2:213:10",33,"وَأَنزَلَ","and sent down","ٱلنَّبِيِّـۧنَ مُبَشِّرِينَ وَمُنذِرِينَ","مَعَهُمُ ٱلْكِتَـٰبَ بِٱلْحَقِّ",61],["2:231:31",37,"أَنزَلَ","(is) revealed","ٱللَّهِ عَلَيْكُمْ وَمَآ","عَلَيْكُم مِّنَ ٱلْكِتَـٰبِ",61],["2:285:4",49,"أُنزِلَ","was revealed","ءَامَنَ ٱلرَّسُولُ بِمَآ","إِلَيْهِ مِن رَّبِّهِۦ",61],["3:3:1",50,"نَزَّلَ","He revealed","","عَلَيْكَ ٱلْكِتَـٰبَ بِٱلْحَقِّ",197],["3:3:9",50,"وَأَنزَلَ","and He revealed","لِّمَا بَيْنَ يَدَيْهِ","ٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ",61],["3:4:5",50,"وَأَنزَلَ","And (He) revealed","قَبْلُ هُدًۭى لِّلنَّاسِ","ٱلْفُرْقَانَ ۗ إِنَّ ٱلَّذِينَ",61],["3:7:3",50,"أَنزَلَ","revealed","هُوَ ٱلَّذِىٓ","عَلَيْكَ ٱلْكِتَـٰبَ مِنْهُ",61],["3:53:4",57,"أَنزَلْتَ","You revealed","رَبَّنَآ ءَامَنَّا بِمَآ","وَٱتَّبَعْنَا ٱلرَّسُولَ فَٱكْتُبْنَا",61],["3:65:8",58,"أُنزِلَتِ","was revealed","فِىٓ إِبْرَٰهِيمَ وَمَآ","ٱلتَّوْرَىٰةُ وَٱلْإِنجِيلُ إِلَّا",61],["3:72:8",59,"أُنزِلَ","was revealed","ٱلْكِتَـٰبِ ءَامِنُوا۟ بِٱلَّذِىٓ","عَلَى ٱلَّذِينَ ءَامَنُوا۟",61],["3:84:5",61,"أُنزِلَ","(is) revealed","ءَامَنَّا بِٱللَّهِ وَمَآ","عَلَيْنَا وَمَآ أُنزِلَ",61],["3:84:8",61,"أُنزِلَ","was revealed","أُنزِلَ عَلَيْنَا وَمَآ","عَلَىٰٓ إِبْرَٰهِيمَ وَإِسْمَـٰعِيلَ",61],["3:93:16",62,"تُنَزَّلَ","(was) revealed","مِن قَبْلِ أَن","ٱلتَّوْرَىٰةُ ۗ قُلْ فَأْتُوا۟",197],["3:124:13",66,"مُنزَلِينَ","[the ones] sent down","ءَالَـٰفٍۢ مِّنَ ٱلْمَلَـٰٓئِكَةِ","",2498],["3:151:12",69,"يُنَزِّلْ","He sent down","بِٱللَّهِ مَا لَمْ","بِهِۦ سُلْطَـٰنًۭا ۖ وَمَأْوَىٰهُمُ",197],["3:154:2",70,"أَنزَلَ","He sent down","ثُمَّ","عَلَيْكُم مِّنۢ بَعْدِ",61],["3:198:13",76,"نُزُلًۭا","a hospitality","ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا","مِّنْ عِندِ ٱللَّهِ ۗ",994],["3:199:9",76,"أُنزِلَ","was revealed","يُؤْمِنُ بِٱللَّهِ وَمَآ","إِلَيْكُمْ وَمَآ أُنزِلَ",61],["3:199:12",76,"أُنزِلَ","was revealed","أُنزِلَ إِلَيْكُمْ وَمَآ","إِلَيْهِمْ خَـٰشِعِينَ لِلَّهِ",61],["4:47:7",86,"نَزَّلْنَا","We (have) revealed","ٱلْكِتَـٰبَ ءَامِنُوا۟ بِمَا","مُصَدِّقًۭا لِّمَا مَعَكُم",197],["4:60:9",88,"أُنزِلَ","(is) revealed","أَنَّهُمْ ءَامَنُوا۟ بِمَآ","إِلَيْكَ وَمَآ أُنزِلَ",61],["4:60:12",88,"أُنزِلَ","was revealed","أُنزِلَ إِلَيْكَ وَمَآ","مِن قَبْلِكَ يُرِيدُونَ",61],["4:61:7",88,"أَنزَلَ","(has) revealed","تَعَالَوْا۟ إِلَىٰ مَآ","ٱللَّهُ وَإِلَى ٱلرَّسُولِ",61],["4:105:2",95,"أَنزَلْنَآ","We (have) sent down","إِنَّآ","إِلَيْكَ ٱلْكِتَـٰبَ بِٱلْحَقِّ",61],["4:113:19",96,"وَأَنزَلَ","And has sent down","يَضُرُّونَكَ مِن شَىْءٍۢ ۚ","ٱللَّهُ عَلَيْكَ ٱلْكِتَـٰبَ",61],["4:136:9",100,"نَزَّلَ","He revealed","وَرَسُولِهِۦ وَٱلْكِتَـٰبِ ٱلَّذِى","عَلَىٰ رَسُولِهِۦ وَٱلْكِتَـٰبِ",197],["4:136:14",100,"أَنزَلَ","He revealed","رَسُولِهِۦ وَٱلْكِتَـٰبِ ٱلَّذِىٓ","مِن قَبْلُ ۚ وَمَن",61],["4:140:2",100,"نَزَّلَ","He has revealed","وَقَدْ","عَلَيْكُمْ فِى ٱلْكِتَـٰبِ",197],["4:153:5",102,"تُنَزِّلَ","you bring down","أَهْلُ ٱلْكِتَـٰبِ أَن","عَلَيْهِمْ كِتَـٰبًۭا مِّنَ",197],["4:162:9",103,"أُنزِلَ","(is) revealed","وَٱلْمُؤْمِنُونَ يُؤْمِنُونَ بِمَآ","إِلَيْكَ وَمَآ أُنزِلَ",61],["4:162:12",103,"أُنزِلَ","was revealed","أُنزِلَ إِلَيْكَ وَمَآ","مِن قَبْلِكَ ۚ وَٱلْمُقِيمِينَ",61],["4:166:5",104,"أَنزَلَ","He (has) revealed","ٱللَّهُ يَشْهَدُ بِمَآ","إِلَيْكَ ۖ أَنزَلَهُۥ بِعِلْمِهِۦ ۖ",61],["4:166:7",104,"أَنزَلَهُۥ","He has sent it down","بِمَآ أَنزَلَ إِلَيْكَ ۖ","بِعِلْمِهِۦ ۖ وَٱلْمَلَـٰٓئِكَةُ يَشْهَدُونَ ۚ",61],["4:174:8",105,"وَأَنزَلْنَآ","and We (have) sent down","بُرْهَـٰنٌۭ مِّن رَّبِّكُمْ","إِلَيْكُمْ نُورًۭا مُّبِينًۭا",61],["5:44:2",115,"أَنزَلْنَا","We revealed","إِنَّآ","ٱلتَّوْرَىٰةَ فِيهَا هُدًۭى",61],["5:44:37",115,"أَنزَلَ","has revealed","لَّمْ يَحْكُم بِمَآ","ٱللَّهُ فَأُو۟لَـٰٓئِكَ هُمُ",61],["5:45:27",115,"أَنزَلَ","has revealed","لَّمْ يَحْكُم بِمَآ","ٱللَّهُ فَأُو۟لَـٰٓئِكَ هُمُ",61],["5:47:5",116,"أَنزَلَ","has revealed","أَهْلُ ٱلْإِنجِيلِ بِمَآ","ٱللَّهُ فِيهِ ۚ وَمَن",61],["5:47:12",116,"أَنزَلَ","has revealed","لَّمْ يَحْكُم بِمَآ","ٱللَّهُ فَأُو۟لَـٰٓئِكَ هُمُ",61],["5:48:1",116,"وَأَنزَلْنَآ","And We revealed","","إِلَيْكَ ٱلْكِتَـٰبَ بِٱلْحَقِّ",61],["5:48:16",116,"أَنزَلَ","has revealed","فَٱحْكُم بَيْنَهُم بِمَآ","ٱللَّهُ ۖ وَلَا تَتَّبِعْ",61],["5:49:5",116,"أَنزَلَ","(has) revealed","ٱحْكُم بَيْنَهُم بِمَآ","ٱللَّهُ وَلَا تَتَّبِعْ",61],["5:49:16",116,"أَنزَلَ","has revealed","عَنۢ بَعْضِ مَآ","ٱللَّهُ إِلَيْكَ ۖ فَإِن",61],["5:59:12",118,"أُنزِلَ","has been revealed","ءَامَنَّا بِٱللَّهِ وَمَآ","إِلَيْنَا وَمَآ أُنزِلَ",61],["5:59:15",118,"أُنزِلَ","was revealed","أُنزِلَ إِلَيْنَا وَمَآ","مِن قَبْلُ وَأَنَّ",61],["5:64:21",118,"أُنزِلَ","has been revealed","كَثِيرًۭا مِّنْهُم مَّآ","إِلَيْكَ مِن رَّبِّكَ",61],["5:66:7",119,"أُنزِلَ","was revealed","ٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ وَمَآ","إِلَيْهِم مِّن رَّبِّهِمْ",61],["5:67:5",119,"أُنزِلَ","has been revealed","ٱلرَّسُولُ بَلِّغْ مَآ","إِلَيْكَ مِن رَّبِّكَ ۖ",61],["5:68:12",119,"أُنزِلَ","has been revealed","ٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ وَمَآ","إِلَيْكُم مِّن رَّبِّكُمْ ۗ",61],["5:68:20",119,"أُنزِلَ","has been revealed","كَثِيرًۭا مِّنْهُم مَّآ","إِلَيْكَ مِن رَّبِّكَ",61],["5:81:7",121,"أُنزِلَ","has been revealed","بِٱللَّهِ وَٱلنَّبِىِّ وَمَآ","إِلَيْهِ مَا ٱتَّخَذُوهُمْ",61],["5:83:4",121,"أُنزِلَ","has been revealed","وَإِذَا سَمِعُوا۟ مَآ","إِلَى ٱلرَّسُولِ تَرَىٰٓ",61],["5:101:16",124,"يُنَزَّلُ","is being revealed","تَسْـَٔلُوا۟ عَنْهَا حِينَ","ٱلْقُرْءَانُ تُبْدَ لَكُمْ",197],["5:104:7",125,"أَنزَلَ","has (been) revealed","تَعَالَوْا۟ إِلَىٰ مَآ","ٱللَّهُ وَإِلَى ٱلرَّسُولِ",61],["5:112:11",126,"يُنَزِّلَ","send down","يَسْتَطِيعُ رَبُّكَ أَن","عَلَيْنَا مَآئِدَةًۭ مِّنَ",197],["5:114:7",127,"أَنزِلْ","send down","مَرْيَمَ ٱللَّهُمَّ رَبَّنَآ","عَلَيْنَا مَآئِدَةًۭ مِّنَ",61],["5:115:4",127,"مُنَزِّلُهَا","(will) send it down","قَالَ ٱللَّهُ إِنِّى","عَلَيْكُمْ ۖ فَمَن يَكْفُرْ",3825],["6:7:2",128,"نَزَّلْنَا","We (had) sent down","وَلَوْ","عَلَيْكَ كِتَـٰبًۭا فِى",197],["6:8:3",128,"أُنزِلَ","sent down","وَقَالُوا۟ لَوْلَآ","عَلَيْهِ مَلَكٌۭ ۖ وَلَوْ",61],["6:8:7",128,"أَنزَلْنَا","We (had) sent down","عَلَيْهِ مَلَكٌۭ ۖ وَلَوْ","مَلَكًۭا لَّقُضِىَ ٱلْأَمْرُ",61],["6:37:3",132,"نُزِّلَ","sent down","وَقَالُوا۟ لَوْلَا","عَلَيْهِ ءَايَةٌۭ مِّن",197],["6:37:14",132,"يُنَزِّلَ","send down","قَادِرٌ عَلَىٰٓ أَن","ءَايَةًۭ وَلَـٰكِنَّ أَكْثَرَهُمْ",197],["6:81:12",137,"يُنَزِّلْ","did He send down","بِٱللَّهِ مَا لَمْ","بِهِۦ عَلَيْكُمْ سُلْطَـٰنًۭا ۚ",197],["6:91:9",139,"أَنزَلَ","revealed","إِذْ قَالُوا۟ مَآ","ٱللَّهُ عَلَىٰ بَشَرٍۢ",61],["6:91:17",139,"أَنزَلَ","revealed","شَىْءٍۢ ۗ قُلْ مَنْ","ٱلْكِتَـٰبَ ٱلَّذِى جَآءَ",61],["6:92:3",139,"أَنزَلْنَـٰهُ","We have revealed it","وَهَـٰذَا كِتَـٰبٌ","مُبَارَكٌۭ مُّصَدِّقُ ٱلَّذِى",61],["6:93:18",139,"سَأُنزِلُ","I will reveal","شَىْءٌۭ وَمَن قَالَ","مِثْلَ مَآ أَنزَلَ",61],["6:93:21",139,"أَنزَلَ","(has been) revealed","سَأُنزِلُ مِثْلَ مَآ","ٱللَّهُ ۗ وَلَوْ تَرَىٰٓ",61],["6:99:3",140,"أَنزَلَ","sends down","وَهُوَ ٱلَّذِىٓ","مِنَ ٱلسَّمَآءِ مَآءًۭ",61],["6:111:3",142,"نَزَّلْنَآ","[We] sent down","۞ وَلَوْ أَنَّنَا","إِلَيْهِمُ ٱلْمَلَـٰٓئِكَةَ وَكَلَّمَهُمُ",197],["6:114:7",142,"أَنزَلَ","has revealed","حَكَمًۭا وَهُوَ ٱلَّذِىٓ","إِلَيْكُمُ ٱلْكِتَـٰبَ مُفَصَّلًۭا ۚ",61],["6:114:16",142,"مُنَزَّلٌۭ","(is) sent down","ٱلْكِتَـٰبَ يَعْلَمُونَ أَنَّهُۥ","مِّن رَّبِّكَ بِٱلْحَقِّ ۖ",3824],["6:155:3",149,"أَنزَلْنَـٰهُ","We have revealed it","وَهَـٰذَا كِتَـٰبٌ","مُبَارَكٌۭ فَٱتَّبِعُوهُ وَٱتَّقُوا۟",61],["6:156:4",149,"أُنزِلَ","was revealed","أَن تَقُولُوٓا۟ إِنَّمَآ","ٱلْكِتَـٰبُ عَلَىٰ طَآئِفَتَيْنِ",61],["6:157:5",149,"أُنزِلَ","was revealed","تَقُولُوا۟ لَوْ أَنَّآ","عَلَيْنَا ٱلْكِتَـٰبُ لَكُنَّآ",61],["7:2:2",151,"أُنزِلَ","revealed","كِتَـٰبٌ","إِلَيْكَ فَلَا يَكُن",61],["7:3:3",151,"أُنزِلَ","has been revealed","ٱتَّبِعُوا۟ مَآ","إِلَيْكُم مِّن رَّبِّكُمْ",61],["7:26:4",153,"أَنزَلْنَا","We have sent down","يَـٰبَنِىٓ ءَادَمَ قَدْ","عَلَيْكُمْ لِبَاسًۭا يُوَٰرِى",61],["7:33:20",154,"يُنَزِّلْ","He (has) sent down","بِٱللَّهِ مَا لَمْ","بِهِۦ سُلْطَـٰنًۭا وَأَن",197],["7:57:17",157,"فَأَنزَلْنَا","then We send down","سُقْنَـٰهُ لِبَلَدٍۢ مَّيِّتٍۢ","بِهِ ٱلْمَآءَ فَأَخْرَجْنَا",61],["7:71:16",159,"نَزَّلَ","(has been) sent down","أَنتُمْ وَءَابَآؤُكُم مَّا","ٱللَّهُ بِهَا مِن",197],["7:157:39",170,"أُنزِلَ","has been sent down","وَٱتَّبَعُوا۟ ٱلنُّورَ ٱلَّذِىٓ","مَعَهُۥٓ ۙ أُو۟لَـٰٓئِكَ هُمُ",61],["7:160:29",171,"وَأَنزَلْنَا","and We sent down","وَظَلَّلْنَا عَلَيْهِمُ ٱلْغَمَـٰمَ","عَلَيْهِمُ ٱلْمَنَّ وَٱلسَّلْوَىٰ ۖ",61],["7:196:5",176,"نَزَّلَ","revealed","وَلِـِّۧىَ ٱللَّهُ ٱلَّذِى","ٱلْكِتَـٰبَ ۖ وَهُوَ يَتَوَلَّى",197],["8:11:6",178,"وَيُنَزِّلُ","and sent down","ٱلنُّعَاسَ أَمَنَةًۭ مِّنْهُ","عَلَيْكُم مِّنَ ٱلسَّمَآءِ",197],["8:41:21",182,"أَنزَلْنَا","We sent down","ءَامَنتُم بِٱللَّهِ وَمَآ","عَلَىٰ عَبْدِنَا يَوْمَ",61],["9:26:2",190,"أَنزَلَ","Allah sent down","ثُمَّ","ٱللَّهُ سَكِينَتَهُۥ عَلَىٰ",61],["9:26:9",190,"وَأَنزَلَ","and sent down","رَسُولِهِۦ وَعَلَى ٱلْمُؤْمِنِينَ","جُنُودًۭا لَّمْ تَرَوْهَا",61],["9:40:24",193,"فَأَنزَلَ","Then Allah sent down","إِنَّ ٱللَّهَ مَعَنَا ۖ","ٱللَّهُ سَكِينَتَهُۥ عَلَيْهِ",61],["9:64:4",197,"تُنَزَّلَ","be revealed","يَحْذَرُ ٱلْمُنَـٰفِقُونَ أَن","عَلَيْهِمْ سُورَةٌۭ تُنَبِّئُهُم",197],["9:86:2",200,"أُنزِلَتْ","was revealed","وَإِذَآ","سُورَةٌ أَنْ ءَامِنُوا۟",61],["9:97:10",202,"أَنزَلَ","Allah (has) revealed","يَعْلَمُوا۟ حُدُودَ مَآ","ٱللَّهُ عَلَىٰ رَسُولِهِۦ ۗ",61],["9:124:3",207,"أُنزِلَتْ","is revealed","وَإِذَا مَآ","سُورَةٌۭ فَمِنْهُم مَّن",61],["9:127:3",207,"أُنزِلَتْ","is revealed","وَإِذَا مَآ","سُورَةٌۭ نَّظَرَ بَعْضُهُمْ",61],["10:5:9",208,"مَنَازِلَ","phases","وَٱلْقَمَرَ نُورًۭا وَقَدَّرَهُۥ","لِتَعْلَمُوا۟ عَدَدَ ٱلسِّنِينَ",2456],["10:20:3",210,"أُنزِلَ","is sent down","وَيَقُولُونَ لَوْلَآ","عَلَيْهِ ءَايَةٌۭ مِّن",61],["10:24:6",211,"أَنزَلْنَـٰهُ","which We sent down","ٱلْحَيَوٰةِ ٱلدُّنْيَا كَمَآءٍ","مِنَ ٱلسَّمَآءِ فَٱخْتَلَطَ",61],["10:59:4",215,"أَنزَلَ","(has been) sent down","قُلْ أَرَءَيْتُم مَّآ","ٱللَّهُ لَكُم مِّن",61],["10:94:6",219,"أَنزَلْنَآ","We have revealed","فِى شَكٍّۢ مِّمَّآ","إِلَيْكَ فَسْـَٔلِ ٱلَّذِينَ",61],["11:12:13",222,"أُنزِلَ","is sent down","أَن يَقُولُوا۟ لَوْلَآ","عَلَيْهِ كَنزٌ أَوْ",61],["11:14:6",223,"أُنزِلَ","it was sent down","لَكُمْ فَٱعْلَمُوٓا۟ أَنَّمَآ","بِعِلْمِ ٱللَّهِ وَأَن",61],["12:2:2",235,"أَنزَلْنَـٰهُ","We have sent it down","إِنَّآ","قُرْءَٰنًا عَرَبِيًّۭا لَّعَلَّكُمْ",61],["12:40:11",240,"أَنزَلَ","(has) sent down","أَنتُمْ وَءَابَآؤُكُم مَّآ","ٱللَّهُ بِهَا مِن",61],["12:59:17",242,"ٱلْمُنزِلِينَ","(of) the hosts","ٱلْكَيْلَ وَأَنَا۠ خَيْرُ","",1366],["13:1:6",249,"أُنزِلَ","has been revealed","ءَايَـٰتُ ٱلْكِتَـٰبِ ۗ وَٱلَّذِىٓ","إِلَيْكَ مِن رَّبِّكَ",61],["13:7:5",250,"أُنزِلَ","has been sent down","ٱلَّذِينَ كَفَرُوا۟ لَوْلَآ","عَلَيْهِ ءَايَةٌۭ مِّن",61],["13:17:1",251,"أَنزَلَ","He sends down","","مِنَ ٱلسَّمَآءِ مَآءًۭ",61],["13:19:4",252,"أُنزِلَ","has been revealed","۞ أَفَمَن يَعْلَمُ أَنَّمَآ","إِلَيْكَ مِن رَّبِّكَ",61],["13:27:5",252,"أُنزِلَ","been sent down","ٱلَّذِينَ كَفَرُوا۟ لَوْلَآ","عَلَيْهِ ءَايَةٌۭ مِّن",61],["13:36:6",254,"أُنزِلَ","has been revealed","ٱلْكِتَـٰبَ يَفْرَحُونَ بِمَآ","إِلَيْكَ ۖ وَمِنَ ٱلْأَحْزَابِ",61],["13:37:2",254,"أَنزَلْنَـٰهُ","We have revealed it","وَكَذَٰلِكَ","حُكْمًا عَرَبِيًّۭا ۚ وَلَئِنِ",61],["14:1:3",255,"أَنزَلْنَـٰهُ","which We have revealed","الٓر ۚ كِتَـٰبٌ","إِلَيْكَ لِتُخْرِجَ ٱلنَّاسَ",61],["14:32:6",259,"وَأَنزَلَ","and sent down","خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","مِنَ ٱلسَّمَآءِ مَآءًۭ",61],["15:6:4",262,"نُزِّلَ","has been sent down","وَقَالُوا۟ يَـٰٓأَيُّهَا ٱلَّذِى","عَلَيْهِ ٱلذِّكْرُ إِنَّكَ",197],["15:8:2",262,"نُنَزِّلُ","We send down","مَا","ٱلْمَلَـٰٓئِكَةَ إِلَّا بِٱلْحَقِّ",197],["15:9:3",262,"نَزَّلْنَا","have sent down","إِنَّا نَحْنُ","ٱلذِّكْرَ وَإِنَّا لَهُۥ",197],["15:21:8",263,"نُنَزِّلُهُۥٓ","We send it down","عِندَنَا خَزَآئِنُهُۥ وَمَا","إِلَّا بِقَدَرٍۢ مَّعْلُومٍۢ",197],["15:22:4",263,"فَأَنزَلْنَا","and We sent down","وَأَرْسَلْنَا ٱلرِّيَـٰحَ لَوَٰقِحَ","مِنَ ٱلسَّمَآءِ مَآءًۭ",61],["15:90:2",266,"أَنزَلْنَا","We sent down","كَمَآ","عَلَى ٱلْمُقْتَسِمِينَ",61],["16:2:1",267,"يُنَزِّلُ","He sends down","","ٱلْمَلَـٰٓئِكَةَ بِٱلرُّوحِ مِنْ",197],["16:10:3",268,"أَنزَلَ","sends down","هُوَ ٱلَّذِىٓ","مِنَ ٱلسَّمَآءِ مَآءًۭ ۖ",61],["16:24:5",269,"أَنزَلَ","has your Lord sent down","قِيلَ لَهُم مَّاذَآ","رَبُّكُمْ ۙ قَالُوٓا۟ أَسَـٰطِيرُ",61],["16:30:5",270,"أَنزَلَ","has your Lord sent down","لِلَّذِينَ ٱتَّقَوْا۟ مَاذَآ","رَبُّكُمْ ۚ قَالُوا۟ خَيْرًۭا ۗ",61],["16:44:3",272,"وَأَنزَلْنَآ","And We sent down","بِٱلْبَيِّنَـٰتِ وَٱلزُّبُرِ ۗ","إِلَيْكَ ٱلذِّكْرَ لِتُبَيِّنَ",61],["16:44:9",272,"نُزِّلَ","has been sent down","لِتُبَيِّنَ لِلنَّاسِ مَا","إِلَيْهِمْ وَلَعَلَّهُمْ يَتَفَكَّرُونَ",197],["16:64:2",273,"أَنزَلْنَا","We revealed","وَمَآ","عَلَيْكَ ٱلْكِتَـٰبَ إِلَّا",61],["16:65:2",274,"أَنزَلَ","has sent down","وَٱللَّهُ","مِنَ ٱلسَّمَآءِ مَآءًۭ",61],["16:89:15",277,"وَنَزَّلْنَا","And We sent down","شَهِيدًا عَلَىٰ هَـٰٓؤُلَآءِ ۚ","عَلَيْكَ ٱلْكِتَـٰبَ تِبْيَـٰنًۭا",197],["16:101:9",278,"يُنَزِّلُ","He sends down","وَٱللَّهُ أَعْلَمُ بِمَا","قَالُوٓا۟ إِنَّمَآ أَنتَ",197],["16:102:2",278,"نَزَّلَهُۥ","Has brought it down","قُلْ","رُوحُ ٱلْقُدُسِ مِن",197],["17:82:1",290,"وَنُنَزِّلُ","And We reveal","","مِنَ ٱلْقُرْءَانِ مَا",197],["17:93:15",291,"تُنَزِّلَ","you bring down","نُّؤْمِنَ لِرُقِيِّكَ حَتَّىٰ","عَلَيْنَا كِتَـٰبًۭا نَّقْرَؤُهُۥ ۗ",197],["17:95:9",291,"لَنَزَّلْنَا","surely We (would) have sent down","مَلَـٰٓئِكَةٌۭ يَمْشُونَ مُطْمَئِنِّينَ","عَلَيْهِم مِّنَ ٱلسَّمَآءِ",197],["17:102:5",292,"أَنزَلَ","has sent down","لَقَدْ عَلِمْتَ مَآ","هَـٰٓؤُلَآءِ إِلَّا رَبُّ",61],["17:105:2",293,"أَنزَلْنَـٰهُ","We sent it down","وَبِٱلْحَقِّ","وَبِٱلْحَقِّ نَزَلَ ۗ وَمَآ",61],["17:105:4",293,"نَزَلَ ۗ","it descended","وَبِٱلْحَقِّ أَنزَلْنَـٰهُ وَبِٱلْحَقِّ","وَمَآ أَرْسَلْنَـٰكَ إِلَّا",1214],["17:106:8",293,"وَنَزَّلْنَـٰهُ","And We have revealed it","ٱلنَّاسِ عَلَىٰ مُكْثٍۢ","تَنزِيلًۭا",197],["17:106:9",293,"تَنزِيلًۭا","(in) stages","عَلَىٰ مُكْثٍۢ وَنَزَّلْنَـٰهُ","",639],["18:1:4",293,"أَنزَلَ","(has) revealed","ٱلْحَمْدُ لِلَّهِ ٱلَّذِىٓ","عَلَىٰ عَبْدِهِ ٱلْكِتَـٰبَ",61],["18:45:7",298,"أَنزَلْنَـٰهُ","which We send down","ٱلْحَيَوٰةِ ٱلدُّنْيَا كَمَآءٍ","مِنَ ٱلسَّمَآءِ فَٱخْتَلَطَ",61],["18:102:14",304,"نُزُلًۭا","(as) a lodging","أَعْتَدْنَا جَهَنَّمَ لِلْكَـٰفِرِينَ","",994],["18:107:10",304,"نُزُلًا","(as) a lodging","لَهُمْ جَنَّـٰتُ ٱلْفِرْدَوْسِ","",994],["19:64:2",309,"نَتَنَزَّلُ","we descend","وَمَا","إِلَّا بِأَمْرِ رَبِّكَ ۖ",1108],["20:2:2",312,"أَنزَلْنَا","We (have) sent down","مَآ","عَلَيْكَ ٱلْقُرْءَانَ لِتَشْقَىٰٓ",61],["20:4:1",312,"تَنزِيلًۭا","A revelation","","مِّمَّنْ خَلَقَ ٱلْأَرْضَ",639],["20:53:10",315,"وَأَنزَلَ","and sent down","لَكُمْ فِيهَا سُبُلًۭا","مِنَ ٱلسَّمَآءِ مَآءًۭ",61],["20:80:11",317,"وَنَزَّلْنَا","and We sent down","جَانِبَ ٱلطُّورِ ٱلْأَيْمَنَ","عَلَيْكُمُ ٱلْمَنَّ وَٱلسَّلْوَىٰ",197],["20:113:2",319,"أَنزَلْنَـٰهُ","We have sent it down","وَكَذَٰلِكَ","قُرْءَانًا عَرَبِيًّۭا وَصَرَّفْنَا",61],["21:10:2",322,"أَنزَلْنَآ","We (have) sent down","لَقَدْ","إِلَيْكُمْ كِتَـٰبًۭا فِيهِ",61],["21:50:4",326,"أَنزَلْنَـٰهُ ۚ","which We (have) revealed","وَهَـٰذَا ذِكْرٌۭ مُّبَارَكٌ","أَفَأَنتُمْ لَهُۥ مُنكِرُونَ",61],["22:5:60",332,"أَنزَلْنَا","We send down","ٱلْأَرْضَ هَامِدَةًۭ فَإِذَآ","عَلَيْهَا ٱلْمَآءَ ٱهْتَزَّتْ",61],["22:16:2",334,"أَنزَلْنَـٰهُ","We sent it down","وَكَذَٰلِكَ","ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ وَأَنَّ",61],["22:63:5",339,"أَنزَلَ","sends down","تَرَ أَنَّ ٱللَّهَ","مِنَ ٱلسَّمَآءِ مَآءًۭ",61],["22:71:7",340,"يُنَزِّلْ","He (has) sent down","ٱللَّهِ مَا لَمْ","بِهِۦ سُلْطَـٰنًۭا وَمَا",197],["23:18:1",343,"وَأَنزَلْنَا","And We send down","","مِنَ ٱلسَّمَآءِ مَآءًۢ",61],["23:24:19",343,"لَأَنزَلَ","surely He (would have) sent down","وَلَوْ شَآءَ ٱللَّهُ","مَلَـٰٓئِكَةًۭ مَّا سَمِعْنَا",61],["23:29:3",344,"أَنزِلْنِى","cause me to land","وَقُل رَّبِّ","مُنزَلًۭا مُّبَارَكًۭا وَأَنتَ",61],["23:29:4",344,"مُنزَلًۭا","(at) a landing place","وَقُل رَّبِّ أَنزِلْنِى","مُّبَارَكًۭا وَأَنتَ خَيْرُ",2498],["23:29:8",344,"ٱلْمُنزِلِينَ","(of) those who cause to land.'","مُّبَارَكًۭا وَأَنتَ خَيْرُ","",1366],["24:1:2",350,"أَنزَلْنَـٰهَا","We (have) sent it down","سُورَةٌ","وَفَرَضْنَـٰهَا وَأَنزَلْنَا فِيهَآ",61],["24:1:4",350,"وَأَنزَلْنَا","and We (have) revealed","سُورَةٌ أَنزَلْنَـٰهَا وَفَرَضْنَـٰهَا","فِيهَآ ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ",61],["24:34:2",354,"أَنزَلْنَآ","We have sent down","وَلَقَدْ","إِلَيْكُمْ ءَايَـٰتٍۢ مُّبَيِّنَـٰتٍۢ",61],["24:43:18",355,"وَيُنَزِّلُ","And He sends down","يَخْرُجُ مِنْ خِلَـٰلِهِۦ","مِنَ ٱلسَّمَآءِ مِن",197],["24:46:2",356,"أَنزَلْنَآ","We have sent down","لَّقَدْ","ءَايَـٰتٍۢ مُّبَيِّنَـٰتٍۢ ۚ وَٱللَّهُ",61],["25:1:3",359,"نَزَّلَ","sent down","تَبَارَكَ ٱلَّذِى","ٱلْفُرْقَانَ عَلَىٰ عَبْدِهِۦ",197],["25:6:2",360,"أَنزَلَهُ","Has sent it down","قُلْ","ٱلَّذِى يَعْلَمُ ٱلسِّرَّ",61],["25:7:11",360,"أُنزِلَ","is sent down","فِى ٱلْأَسْوَاقِ ۙ لَوْلَآ","إِلَيْهِ مَلَكٌۭ فَيَكُونَ",61],["25:21:7",362,"أُنزِلَ","are sent down","يَرْجُونَ لِقَآءَنَا لَوْلَآ","عَلَيْنَا ٱلْمَلَـٰٓئِكَةُ أَوْ",61],["25:25:5",362,"وَنُزِّلَ","and (will be) sent down","تَشَقَّقُ ٱلسَّمَآءُ بِٱلْغَمَـٰمِ","ٱلْمَلَـٰٓئِكَةُ تَنزِيلًا",197],["25:25:7",362,"تَنزِيلًا","descending","بِٱلْغَمَـٰمِ وَنُزِّلَ ٱلْمَلَـٰٓئِكَةُ","",639],["25:32:5",362,"نُزِّلَ","was revealed","ٱلَّذِينَ كَفَرُوا۟ لَوْلَا","عَلَيْهِ ٱلْقُرْءَانُ جُمْلَةًۭ",197],["25:48:9",364,"وَأَنزَلْنَا","and We send down","بَيْنَ يَدَىْ رَحْمَتِهِۦ ۚ","مِنَ ٱلسَّمَآءِ مَآءًۭ",61],["26:4:3",367,"نُنَزِّلْ","We can send down","إِن نَّشَأْ","عَلَيْهِم مِّنَ ٱلسَّمَآءِ",197],["26:192:2",375,"لَتَنزِيلُ","surely, is a Revelation","وَإِنَّهُۥ","رَبِّ ٱلْعَـٰلَمِينَ",639],["26:193:1",375,"نَزَلَ","Has brought it down","","بِهِ ٱلرُّوحُ ٱلْأَمِينُ",1214],["26:198:2",375,"نَزَّلْنَـٰهُ","We (had) revealed it","وَلَوْ","عَلَىٰ بَعْضِ ٱلْأَعْجَمِينَ",197],["26:210:2",376,"تَنَزَّلَتْ","have brought it down","وَمَا","بِهِ ٱلشَّيَـٰطِينُ",1108],["26:221:5",376,"تَنَزَّلُ","descend","أُنَبِّئُكُمْ عَلَىٰ مَن","ٱلشَّيَـٰطِينُ",1108],["26:222:1",376,"تَنَزَّلُ","They descend","","عَلَىٰ كُلِّ أَفَّاكٍ",1108],["27:60:5",382,"وَأَنزَلَ","and sent down","خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ","لَكُم مِّنَ ٱلسَّمَآءِ",61],["28:24:11",388,"أَنزَلْتَ","You send","رَبِّ إِنِّى لِمَآ","إِلَىَّ مِنْ خَيْرٍۢ",61],["28:87:8",396,"أُنزِلَتْ","they have been revealed","ٱللَّهِ بَعْدَ إِذْ","إِلَيْكَ ۖ وَٱدْعُ إِلَىٰ",61],["29:34:2",400,"مُنزِلُونَ","(will) bring down","إِنَّا","عَلَىٰٓ أَهْلِ هَـٰذِهِ",1366],["29:46:16",402,"أُنزِلَ","has been revealed","وَقُولُوٓا۟ ءَامَنَّا بِٱلَّذِىٓ","إِلَيْنَا وَأُنزِلَ إِلَيْكُمْ",61],["29:46:18",402,"وَأُنزِلَ","and was revealed","بِٱلَّذِىٓ أُنزِلَ إِلَيْنَا","إِلَيْكُمْ وَإِلَـٰهُنَا وَإِلَـٰهُكُمْ",61],["29:47:2",402,"أَنزَلْنَآ","We (have) revealed","وَكَذَٰلِكَ","إِلَيْكَ ٱلْكِتَـٰبَ ۚ فَٱلَّذِينَ",61],["29:50:3",402,"أُنزِلَ","are sent down","وَقَالُوا۟ لَوْلَآ","عَلَيْهِ ءَايَـٰتٌۭ مِّن",61],["29:51:4",402,"أَنزَلْنَا","revealed","أَوَلَمْ يَكْفِهِمْ أَنَّآ","عَلَيْكَ ٱلْكِتَـٰبَ يُتْلَىٰ",61],["29:63:4",403,"نَّزَّلَ","sends down","وَلَئِن سَأَلْتَهُم مَّن","مِنَ ٱلسَّمَآءِ مَآءًۭ",197],["30:24:7",406,"وَيُنَزِّلُ","and He sends down","ٱلْبَرْقَ خَوْفًۭا وَطَمَعًۭا","مِنَ ٱلسَّمَآءِ مَآءًۭ",197],["30:35:2",408,"أَنزَلْنَا","have We sent","أَمْ","عَلَيْهِمْ سُلْطَـٰنًۭا فَهُوَ",61],["30:49:6",409,"يُنَزَّلَ","it was sent down","مِن قَبْلِ أَن","عَلَيْهِم مِّن قَبْلِهِۦ",197],["31:10:18",411,"وَأَنزَلْنَا","And We sent down","مِن كُلِّ دَآبَّةٍۢ ۚ","مِنَ ٱلسَّمَآءِ مَآءًۭ",61],["31:21:6",413,"أَنزَلَ","Allah (has) revealed","لَهُمُ ٱتَّبِعُوا۟ مَآ","ٱللَّهُ قَالُوا۟ بَلْ",61],["31:34:6",414,"وَيُنَزِّلُ","and He sends down","عِندَهُۥ عِلْمُ ٱلسَّاعَةِ","ٱلْغَيْثَ وَيَعْلَمُ مَا",197],["32:2:1",415,"تَنزِيلُ","(The) revelation","","ٱلْكِتَـٰبِ لَا رَيْبَ",639],["32:19:9",416,"نُزُلًۢا","(as) hospitality","فَلَهُمْ جَنَّـٰتُ ٱلْمَأْوَىٰ","بِمَا كَانُوا۟ يَعْمَلُونَ",994],["33:26:1",421,"وَأَنزَلَ","And He brought down","","ٱلَّذِينَ ظَـٰهَرُوهُم مِّنْ",61],["34:2:10",428,"يَنزِلُ","descends","يَخْرُجُ مِنْهَا وَمَا","مِنَ ٱلسَّمَآءِ وَمَا",1214],["34:6:6",428,"أُنزِلَ","is revealed","أُوتُوا۟ ٱلْعِلْمَ ٱلَّذِىٓ","إِلَيْكَ مِن رَّبِّكَ",61],["35:27:5",437,"أَنزَلَ","sends down","تَرَ أَنَّ ٱللَّهَ","مِنَ ٱلسَّمَآءِ مَآءًۭ",61],["36:5:1",440,"تَنزِيلَ","A revelation","","ٱلْعَزِيزِ ٱلرَّحِيمِ",639],["36:15:8",441,"أَنزَلَ","has revealed","بَشَرٌۭ مِّثْلُنَا وَمَآ","ٱلرَّحْمَـٰنُ مِن شَىْءٍ",61],["36:28:2",442,"أَنزَلْنَا","We sent down","۞ وَمَآ","عَلَىٰ قَوْمِهِۦ مِنۢ",61],["36:28:13",442,"مُنزِلِينَ","(to) send down","ٱلسَّمَآءِ وَمَا كُنَّا","",1366],["36:39:3",442,"مَنَازِلَ","phases","وَٱلْقَمَرَ قَدَّرْنَـٰهُ","حَتَّىٰ عَادَ كَٱلْعُرْجُونِ",2456],["37:62:3",448,"نُّزُلًا","(as) hospitality","أَذَٰلِكَ خَيْرٌۭ","أَمْ شَجَرَةُ ٱلزَّقُّومِ",994],["37:177:2",452,"نَزَلَ","it descends","فَإِذَا","بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ",1214],["38:8:1",453,"أَءُنزِلَ","Has been revealed","","عَلَيْهِ ٱلذِّكْرُ مِنۢ",61],["38:29:2",455,"أَنزَلْنَـٰهُ","We have revealed it","كِتَـٰبٌ","إِلَيْكَ مُبَـٰرَكٌۭ لِّيَدَّبَّرُوٓا۟",61],["39:1:1",458,"تَنزِيلُ","(The) revelation","","ٱلْكِتَـٰبِ مِنَ ٱللَّهِ",639],["39:2:2",458,"أَنزَلْنَآ","[We] have revealed","إِنَّآ","إِلَيْكَ ٱلْكِتَـٰبَ بِٱلْحَقِّ",61],["39:6:9",459,"وَأَنزَلَ","And He sent down","جَعَلَ مِنْهَا زَوْجَهَا","لَكُم مِّنَ ٱلْأَنْعَـٰمِ",61],["39:21:5",460,"أَنزَلَ","sends down","تَرَ أَنَّ ٱللَّهَ","مِنَ ٱلسَّمَآءِ مَآءًۭ",61],["39:23:2",461,"نَزَّلَ","has revealed","ٱللَّهُ","أَحْسَنَ ٱلْحَدِيثِ كِتَـٰبًۭا",197],["39:41:2",463,"أَنزَلْنَا","We revealed","إِنَّآ","عَلَيْكَ ٱلْكِتَـٰبَ لِلنَّاسِ",61],["39:55:4",464,"أُنزِلَ","is revealed","وَٱتَّبِعُوٓا۟ أَحْسَنَ مَآ","إِلَيْكُم مِّن رَّبِّكُم",61],["40:2:1",467,"تَنزِيلُ","(The) revelation","","ٱلْكِتَـٰبِ مِنَ ٱللَّهِ",639],["40:13:5",468,"وَيُنَزِّلُ","and sends down","ٱلَّذِى يُرِيكُمْ ءَايَـٰتِهِۦ","لَكُم مِّنَ ٱلسَّمَآءِ",197],["41:2:1",477,"تَنزِيلٌۭ","A revelation","","مِّنَ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",639],["41:14:17",478,"لَأَنزَلَ","surely, He (would have) sent down","لَوْ شَآءَ رَبُّنَا","مَلَـٰٓئِكَةًۭ فَإِنَّا بِمَآ",61],["41:30:8",480,"تَتَنَزَّلُ","will descend","ٱللَّهُ ثُمَّ ٱسْتَقَـٰمُوا۟","عَلَيْهِمُ ٱلْمَلَـٰٓئِكَةُ أَلَّا",1108],["41:32:1",480,"نُزُلًۭا","A hospitable gift","","مِّنْ غَفُورٍۢ رَّحِيمٍۢ",994],["41:39:8",481,"أَنزَلْنَا","We send down","ٱلْأَرْضَ خَـٰشِعَةًۭ فَإِذَآ","عَلَيْهَا ٱلْمَآءَ ٱهْتَزَّتْ",61],["41:42:10",481,"تَنزِيلٌۭ","A Revelation","وَلَا مِنْ خَلْفِهِۦ ۖ","مِّنْ حَكِيمٍ حَمِيدٍۢ",639],["42:15:12",484,"أَنزَلَ","Allah has sent down","وَقُلْ ءَامَنتُ بِمَآ","ٱللَّهُ مِن كِتَـٰبٍۢ ۖ",61],["42:17:3",485,"أَنزَلَ","(has) sent down","ٱللَّهُ ٱلَّذِىٓ","ٱلْكِتَـٰبَ بِٱلْحَقِّ وَٱلْمِيزَانَ ۗ",61],["42:27:10",486,"يُنَزِّلُ","He sends down","فِى ٱلْأَرْضِ وَلَـٰكِن","بِقَدَرٍۢ مَّا يَشَآءُ ۚ",197],["42:28:3",486,"يُنَزِّلُ","sends down","وَهُوَ ٱلَّذِى","ٱلْغَيْثَ مِنۢ بَعْدِ",197],["43:11:2",490,"نَزَّلَ","sends down","وَٱلَّذِى","مِنَ ٱلسَّمَآءِ مَآءًۢ",197],["43:31:3",491,"نُزِّلَ","was sent down","وَقَالُوا۟ لَوْلَا","هَـٰذَا ٱلْقُرْءَانُ عَلَىٰ",197],["44:3:2",496,"أَنزَلْنَـٰهُ","revealed it","إِنَّآ","فِى لَيْلَةٍۢ مُّبَـٰرَكَةٍ ۚ",61],["45:2:1",499,"تَنزِيلُ","(The) revelation","","ٱلْكِتَـٰبِ مِنَ ٱللَّهِ",639],["45:5:5",499,"أَنزَلَ","Allah sends down","ٱلَّيْلِ وَٱلنَّهَارِ وَمَآ","ٱللَّهُ مِنَ ٱلسَّمَآءِ",61],["46:2:1",502,"تَنزِيلُ","(The) revelation","","ٱلْكِتَـٰبِ مِنَ ٱللَّهِ",639],["46:30:6",506,"أُنزِلَ","revealed","إِنَّا سَمِعْنَا كِتَـٰبًا","مِنۢ بَعْدِ مُوسَىٰ",61],["47:2:7",507,"نُزِّلَ","is revealed","ٱلصَّـٰلِحَـٰتِ وَءَامَنُوا۟ بِمَا","عَلَىٰ مُحَمَّدٍۢ وَهُوَ",197],["47:9:5",507,"أَنزَلَ","Allah has revealed","بِأَنَّهُمْ كَرِهُوا۟ مَآ","ٱللَّهُ فَأَحْبَطَ أَعْمَـٰلَهُمْ",61],["47:20:5",509,"نُزِّلَتْ","has been revealed","ٱلَّذِينَ ءَامَنُوا۟ لَوْلَا","سُورَةٌۭ ۖ فَإِذَآ أُنزِلَتْ",197],["47:20:8",509,"أُنزِلَتْ","is revealed","نُزِّلَتْ سُورَةٌۭ ۖ فَإِذَآ","سُورَةٌۭ مُّحْكَمَةٌۭ وَذُكِرَ",61],["47:26:7",509,"نَزَّلَ","Allah has revealed","لِلَّذِينَ كَرِهُوا۟ مَا","ٱللَّهُ سَنُطِيعُكُمْ فِى",197],["48:4:3",511,"أَنزَلَ","sent down","هُوَ ٱلَّذِىٓ","ٱلسَّكِينَةَ فِى قُلُوبِ",61],["48:18:14",513,"فَأَنزَلَ","so He sent down","مَا فِى قُلُوبِهِمْ","ٱلسَّكِينَةَ عَلَيْهِمْ وَأَثَـٰبَهُمْ",61],["48:26:10",514,"فَأَنزَلَ","Then Allah sent down","ٱلْحَمِيَّةَ حَمِيَّةَ ٱلْجَـٰهِلِيَّةِ","ٱللَّهُ سَكِينَتَهُۥ عَلَىٰ",61],["50:9:1",518,"وَنَزَّلْنَا","And We have sent down","","مِنَ ٱلسَّمَآءِ مَآءًۭ",197],["53:13:3",526,"نَزْلَةً","(in) descent","وَلَقَدْ رَءَاهُ","أُخْرَىٰ",4055],["53:23:9",526,"أَنزَلَ","has Allah sent down","أَنتُمْ وَءَابَآؤُكُم مَّآ","ٱللَّهُ بِهَا مِن",61],["56:56:2",536,"نُزُلُهُمْ","(is) their hospitality","هَـٰذَا","يَوْمَ ٱلدِّينِ",994],["56:69:2",536,"أَنزَلْتُمُوهُ","who send it down","ءَأَنتُمْ","مِنَ ٱلْمُزْنِ أَمْ",61],["56:69:7",536,"ٱلْمُنزِلُونَ","(are) the Ones to send","ٱلْمُزْنِ أَمْ نَحْنُ","",1366],["56:80:1",537,"تَنزِيلٌۭ","A Revelation","","مِّن رَّبِّ ٱلْعَـٰلَمِينَ",639],["56:93:1",537,"فَنُزُلٌۭ","Then, hospitality","","مِّنْ حَمِيمٍۢ",994],["57:4:22",538,"يَنزِلُ","descends","يَخْرُجُ مِنْهَا وَمَا","مِنَ ٱلسَّمَآءِ وَمَا",1214],["57:9:3",538,"يُنَزِّلُ","sends down","هُوَ ٱلَّذِى","عَلَىٰ عَبْدِهِۦٓ ءَايَـٰتٍۭ",197],["57:16:11",539,"نَزَلَ","has come down","لِذِكْرِ ٱللَّهِ وَمَا","مِنَ ٱلْحَقِّ وَلَا",1214],["57:25:5",541,"وَأَنزَلْنَا","and We sent down","أَرْسَلْنَا رُسُلَنَا بِٱلْبَيِّنَـٰتِ","مَعَهُمُ ٱلْكِتَـٰبَ وَٱلْمِيزَانَ",61],["57:25:12",541,"وَأَنزَلْنَا","And We sent down","لِيَقُومَ ٱلنَّاسُ بِٱلْقِسْطِ ۖ","ٱلْحَدِيدَ فِيهِ بَأْسٌۭ",61],["58:5:13",542,"أَنزَلْنَآ","We have sent down","مِن قَبْلِهِمْ ۚ وَقَدْ","ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ ۚ وَلِلْكَـٰفِرِينَ",61],["59:21:2",548,"أَنزَلْنَا","We (had) sent down","لَوْ","هَـٰذَا ٱلْقُرْءَانَ عَلَىٰ",61],["64:8:6",556,"أَنزَلْنَا ۚ","We have sent down","وَرَسُولِهِۦ وَٱلنُّورِ ٱلَّذِىٓ","وَٱللَّهُ بِمَا تَعْمَلُونَ",61],["65:5:4",558,"أَنزَلَهُۥٓ","which He has sent down","ذَٰلِكَ أَمْرُ ٱللَّهِ","إِلَيْكُمْ ۚ وَمَن يَتَّقِ",61],["65:10:13",559,"أَنزَلَ","Has sent down","ٱلَّذِينَ ءَامَنُوا۟ ۚ قَدْ","ٱللَّهُ إِلَيْكُمْ ذِكْرًۭا",61],["65:12:9",559,"يَتَنَزَّلُ","Descends","وَمِنَ ٱلْأَرْضِ مِثْلَهُنَّ","ٱلْأَمْرُ بَيْنَهُنَّ لِتَعْلَمُوٓا۟",1108],["67:9:9",562,"نَزَّلَ","has sent down","فَكَذَّبْنَا وَقُلْنَا مَا","ٱللَّهُ مِن شَىْءٍ",197],["69:43:1",568,"تَنزِيلٌۭ","(It is) a revelation","","مِّن رَّبِّ ٱلْعَـٰلَمِينَ",639],["76:23:3",579,"نَزَّلْنَا","[We] revealed","إِنَّا نَحْنُ","عَلَيْكَ ٱلْقُرْءَانَ تَنزِيلًۭا",197],["76:23:6",579,"تَنزِيلًۭا","progressively","نَزَّلْنَا عَلَيْكَ ٱلْقُرْءَانَ","",639],["78:14:1",582,"وَأَنزَلْنَا","And We sent down","","مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ",61],["97:1:2",598,"أَنزَلْنَـٰهُ","revealed it","إِنَّآ","فِى لَيْلَةِ ٱلْقَدْرِ",61],["97:4:1",598,"تَنَزَّلُ","Descend","","ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ فِيهَا",1108]]