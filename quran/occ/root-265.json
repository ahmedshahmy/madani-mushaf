[["3:120:15",65,"كَيْدُهُمْ","their plot","وَتَتَّقُوا۟ لَا يَضُرُّكُمْ","شَيْـًٔا ۗ إِنَّ ٱللَّهَ",414],["4:76:17",90,"كَيْدَ","(the) strategy","أَوْلِيَآءَ ٱلشَّيْطَـٰنِ ۖ إِنَّ","ٱلشَّيْطَـٰنِ كَانَ ضَعِيفًا",414],["7:183:4",174,"كَيْدِى","My plan","وَأُمْلِى لَهُمْ ۚ إِنَّ","مَتِينٌ",414],["7:195:24",175,"كِيدُونِ","scheme against me","ٱدْعُوا۟ شُرَكَآءَكُمْ ثُمَّ","فَلَا تُنظِرُونِ",980],["8:18:5",179,"كَيْدِ","(the) plan","وَأَنَّ ٱللَّهَ مُوهِنُ","ٱلْكَـٰفِرِينَ",414],["11:55:3",228,"فَكِيدُونِى","So plot against me","مِن دُونِهِۦ ۖ","جَمِيعًۭا ثُمَّ لَا",980],["12:5:8",236,"فَيَكِيدُوا۟","lest they plan","رُءْيَاكَ عَلَىٰٓ إِخْوَتِكَ","لَكَ كَيْدًا ۖ إِنَّ",980],["12:5:10",236,"كَيْدًا ۖ","a plot","إِخْوَتِكَ فَيَكِيدُوا۟ لَكَ","إِنَّ ٱلشَّيْطَـٰنَ لِلْإِنسَـٰنِ",414],["12:28:10",238,"كَيْدِكُنَّ ۖ","your plot","قَالَ إِنَّهُۥ مِن","إِنَّ كَيْدَكُنَّ عَظِيمٌۭ",414],["12:28:12",238,"كَيْدَكُنَّ","your plot","مِن كَيْدِكُنَّ ۖ إِنَّ","عَظِيمٌۭ",414],["12:33:12",239,"كَيْدَهُنَّ","their plot","وَإِلَّا تَصْرِفْ عَنِّى","أَصْبُ إِلَيْهِنَّ وَأَكُن",414],["12:34:6",239,"كَيْدَهُنَّ ۚ","their plot","رَبُّهُۥ فَصَرَفَ عَنْهُ","إِنَّهُۥ هُوَ ٱلسَّمِيعُ",414],["12:50:21",241,"بِكَيْدِهِنَّ","of their plot","أَيْدِيَهُنَّ ۚ إِنَّ رَبِّى","عَلِيمٌۭ",414],["12:52:11",241,"كَيْدَ","(the) plan","ٱللَّهَ لَا يَهْدِى","ٱلْخَآئِنِينَ",414],["12:76:12",244,"كِدْنَا","(did) We plan","وِعَآءِ أَخِيهِ ۚ كَذَٰلِكَ","لِيُوسُفَ ۖ مَا كَانَ",980],["20:60:4",315,"كَيْدَهُۥ","his plan","فَتَوَلَّىٰ فِرْعَوْنُ فَجَمَعَ","ثُمَّ أَتَىٰ",414],["20:64:2",315,"كَيْدَكُمْ","your plan","فَأَجْمِعُوا۟","ثُمَّ ٱئْتُوا۟ صَفًّۭا ۚ",414],["20:69:10",316,"كَيْدُ","a trick","صَنَعُوٓا۟ ۖ إِنَّمَا صَنَعُوا۟","سَـٰحِرٍۢ ۖ وَلَا يُفْلِحُ",414],["21:57:2",326,"لَأَكِيدَنَّ","surely, I will plan","وَتَٱللَّهِ","أَصْنَـٰمَكُم بَعْدَ أَن",980],["21:70:3",327,"كَيْدًۭا","a plan","وَأَرَادُوا۟ بِهِۦ","فَجَعَلْنَـٰهُمُ ٱلْأَخْسَرِينَ",414],["22:15:20",333,"كَيْدُهُۥ","his plan","فَلْيَنظُرْ هَلْ يُذْهِبَنَّ","مَا يَغِيظُ",414],["37:98:3",449,"كَيْدًۭا","a plot","فَأَرَادُوا۟ بِهِۦ","فَجَعَلْنَـٰهُمُ ٱلْأَسْفَلِينَ",414],["40:25:15",469,"كَيْدُ","(is the) plot","وَٱسْتَحْيُوا۟ نِسَآءَهُمْ ۚ وَمَا","ٱلْكَـٰفِرِينَ إِلَّا فِى",414],["40:37:19",471,"كَيْدُ","(was the) plot","عَنِ ٱلسَّبِيلِ ۚ وَمَا","فِرْعَوْنَ إِلَّا فِى",414],["52:42:3",525,"كَيْدًۭا ۖ","a plot","أَمْ يُرِيدُونَ","فَٱلَّذِينَ كَفَرُوا۟ هُمُ",414],["52:42:7",525,"ٱلْمَكِيدُونَ","(are in) the plot","فَٱلَّذِينَ كَفَرُوا۟ هُمُ","",3673],["52:46:5",525,"كَيْدُهُمْ","their plotting","لَا يُغْنِى عَنْهُمْ","شَيْـًۭٔا وَلَا هُمْ",414],["68:45:4",566,"كَيْدِى","My plan","وَأُمْلِى لَهُمْ ۚ إِنَّ","مَتِينٌ",414],["77:39:4",581,"كَيْدٌۭ","a plan","فَإِن كَانَ لَكُمْ","فَكِيدُونِ",414],["77:39:5",581,"فَكِيدُونِ","then plan against Me","كَانَ لَكُمْ كَيْدٌۭ","",980],["86:15:2",591,"يَكِيدُونَ","are plotting","إِنَّهُمْ","كَيْدًۭا",980],["86:15:3",591,"كَيْدًۭا","a plot","إِنَّهُمْ يَكِيدُونَ","",414],["86:16:1",591,"وَأَكِيدُ","But I am planning","","كَيْدًۭا",980],["86:16:2",591,"كَيْدًۭا","a plan","وَأَكِيدُ","",414],["105:2:3",601,"كَيْدَهُمْ","their plan","أَلَمْ يَجْعَلْ","فِى تَضْلِيلٍۢ",414]]