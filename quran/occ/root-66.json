[["2:34:10",6,"وَٱسْتَكْبَرَ","and was arrogant","إِلَّآ إِبْلِيسَ أَبَىٰ","وَكَانَ مِنَ ٱلْكَـٰفِرِينَ",297],["2:45:5",7,"لَكَبِيرَةٌ","(is) surely difficult","بِٱلصَّبْرِ وَٱلصَّلَوٰةِ ۚ وَإِنَّهَا","إِلَّا عَلَى ٱلْخَـٰشِعِينَ",1081],["2:87:24",13,"ٱسْتَكْبَرْتُمْ","you acted arrogantly","لَا تَهْوَىٰٓ أَنفُسُكُمُ","فَفَرِيقًۭا كَذَّبْتُمْ وَفَرِيقًۭا",297],["2:143:30",22,"لَكَبِيرَةً","certainly a great (test)","عَقِبَيْهِ ۚ وَإِن كَانَتْ","إِلَّا عَلَى ٱلَّذِينَ",1081],["2:185:38",28,"وَلِتُكَبِّرُوا۟","and that you magnify","ٱلْعُسْرَ وَلِتُكْمِلُوا۟ ٱلْعِدَّةَ","ٱللَّهَ عَلَىٰ مَا",1565],["2:217:10",34,"كَبِيرٌۭ ۖ","(is) a great (sin)","قُلْ قِتَالٌۭ فِيهِ","وَصَدٌّ عَن سَبِيلِ",290],["2:217:22",34,"أَكْبَرُ","(is) greater (sin)","وَإِخْرَاجُ أَهْلِهِۦ مِنْهُ","عِندَ ٱللَّهِ ۚ وَٱلْفِتْنَةُ",434],["2:217:26",34,"أَكْبَرُ","(is) greater","عِندَ ٱللَّهِ ۚ وَٱلْفِتْنَةُ","مِنَ ٱلْقَتْلِ ۗ وَلَا",434],["2:219:8",34,"كَبِيرٌۭ","great","قُلْ فِيهِمَآ إِثْمٌۭ","وَمَنَـٰفِعُ لِلنَّاسِ وَإِثْمُهُمَآ",290],["2:219:12",34,"أَكْبَرُ","(is) greater","وَمَنَـٰفِعُ لِلنَّاسِ وَإِثْمُهُمَآ","مِن نَّفْعِهِمَا ۗ وَيَسْـَٔلُونَكَ",434],["2:266:20",45,"ٱلْكِبَرُ","[the] old age","كُلِّ ٱلثَّمَرَٰتِ وَأَصَابَهُ","وَلَهُۥ ذُرِّيَّةٌۭ ضُعَفَآءُ",1192],["2:282:84",48,"كَبِيرًا","large","تَكْتُبُوهُ صَغِيرًا أَوْ","إِلَىٰٓ أَجَلِهِۦ ۚ ذَٰلِكُمْ",290],["3:40:9",55,"ٱلْكِبَرُ","[the] old age","غُلَـٰمٌۭ وَقَدْ بَلَغَنِىَ","وَٱمْرَأَتِى عَاقِرٌۭ ۖ قَالَ",1192],["3:118:23",65,"أَكْبَرُ ۚ","(is) greater","وَمَا تُخْفِى صُدُورُهُمْ","قَدْ بَيَّنَّا لَكُمُ",434],["4:2:16",77,"كَبِيرًۭا","great","إِنَّهُۥ كَانَ حُوبًۭا","",290],["4:6:19",77,"يَكْبَرُوا۟ ۚ","they will grow up","إِسْرَافًۭا وَبِدَارًا أَن","وَمَن كَانَ غَنِيًّۭا",978],["4:31:3",83,"كَبَآئِرَ","great (sins)","إِن تَجْتَنِبُوا۟","مَا تُنْهَوْنَ عَنْهُ",1081],["4:34:40",84,"كَبِيرًۭا","Most Great","ٱللَّهَ كَانَ عَلِيًّۭا","",290],["4:153:13",102,"أَكْبَرَ","greater","فَقَدْ سَأَلُوا۟ مُوسَىٰٓ","مِن ذَٰلِكَ فَقَالُوٓا۟",434],["4:172:15",105,"وَيَسْتَكْبِرْ","and is arrogant","يَسْتَنكِفْ عَنْ عِبَادَتِهِۦ","فَسَيَحْشُرُهُمْ إِلَيْهِ جَمِيعًۭا",297],["4:173:14",105,"وَٱسْتَكْبَرُوا۟","and were arrogant","وَأَمَّا ٱلَّذِينَ ٱسْتَنكَفُوا۟","فَيُعَذِّبُهُمْ عَذَابًا أَلِيمًۭا",297],["5:82:26",121,"يَسْتَكْبِرُونَ","arrogant","وَرُهْبَانًۭا وَأَنَّهُمْ لَا","",297],["6:19:4",130,"أَكْبَرُ","(is) greatest","قُلْ أَىُّ شَىْءٍ","شَهَـٰدَةًۭ ۖ قُلِ ٱللَّهُ ۖ",434],["6:35:3",131,"كَبُرَ","difficult","وَإِن كَانَ","عَلَيْكَ إِعْرَاضُهُمْ فَإِنِ",978],["6:78:9",137,"أَكْبَرُ ۖ","greater","هَـٰذَا رَبِّى هَـٰذَآ","فَلَمَّآ أَفَلَتْ قَالَ",434],["6:93:49",139,"تَسْتَكْبِرُونَ","being arrogant","وَكُنتُمْ عَنْ ءَايَـٰتِهِۦ","",297],["6:123:6",143,"أَكَـٰبِرَ","greatest","فِى كُلِّ قَرْيَةٍ","مُجْرِمِيهَا لِيَمْكُرُوا۟ فِيهَا ۖ",434],["7:13:8",152,"تَتَكَبَّرَ","you be arrogant","يَكُونُ لَكَ أَن","فِيهَا فَٱخْرُجْ إِنَّكَ",2783],["7:36:4",154,"وَٱسْتَكْبَرُوا۟","and (are) arrogant","وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا","عَنْهَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ",297],["7:40:5",155,"وَٱسْتَكْبَرُوا۟","and (were) arrogant","ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا","عَنْهَا لَا تُفَتَّحُ",297],["7:48:14",156,"تَسْتَكْبِرُونَ","arrogant (about)","جَمْعُكُمْ وَمَا كُنتُمْ","",297],["7:75:4",160,"ٱسْتَكْبَرُوا۟","(who) were arrogant","قَالَ ٱلْمَلَأُ ٱلَّذِينَ","مِن قَوْمِهِۦ لِلَّذِينَ",297],["7:76:3",160,"ٱسْتَكْبَرُوٓا۟","were arrogant","قَالَ ٱلَّذِينَ","إِنَّا بِٱلَّذِىٓ ءَامَنتُم",297],["7:88:4",162,"ٱسْتَكْبَرُوا۟","were arrogant","۞ قَالَ ٱلْمَلَأُ ٱلَّذِينَ","مِن قَوْمِهِۦ لَنُخْرِجَنَّكَ",297],["7:133:10",166,"فَٱسْتَكْبَرُوا۟","but they showed arrogance","وَٱلدَّمَ ءَايَـٰتٍۢ مُّفَصَّلَـٰتٍۢ","وَكَانُوا۟ قَوْمًۭا مُّجْرِمِينَ",297],["7:146:5",168,"يَتَكَبَّرُونَ","are arrogant","عَنْ ءَايَـٰتِىَ ٱلَّذِينَ","فِى ٱلْأَرْضِ بِغَيْرِ",2783],["7:206:6",176,"يَسْتَكْبِرُونَ","(do) they turn away in pride","عِندَ رَبِّكَ لَا","عَنْ عِبَادَتِهِۦ وَيُسَبِّحُونَهُۥ",297],["8:73:13",186,"كَبِيرٌۭ","great","فِى ٱلْأَرْضِ وَفَسَادٌۭ","",290],["9:3:9",187,"ٱلْأَكْبَرِ","(of) the greater Pilgrimage","ٱلنَّاسِ يَوْمَ ٱلْحَجِّ","أَنَّ ٱللَّهَ بَرِىٓءٌۭ",434],["9:72:20",198,"أَكْبَرُ ۚ","(is) greater","وَرِضْوَٰنٌۭ مِّنَ ٱللَّهِ","ذَٰلِكَ هُوَ ٱلْفَوْزُ",434],["9:121:6",206,"كَبِيرَةًۭ","big","نَفَقَةًۭ صَغِيرَةًۭ وَلَا","وَلَا يَقْطَعُونَ وَادِيًا",1081],["10:61:38",215,"أَكْبَرَ","greater","مِن ذَٰلِكَ وَلَآ","إِلَّا فِى كِتَـٰبٍۢ",434],["10:71:11",217,"كَبُرَ","hard","يَـٰقَوْمِ إِن كَانَ","عَلَيْكُم مَّقَامِى وَتَذْكِيرِى",978],["10:75:11",217,"فَٱسْتَكْبَرُوا۟","but they were arrogant","فِرْعَوْنَ وَمَلَإِي۟هِۦ بِـَٔايَـٰتِنَا","وَكَانُوا۟ قَوْمًۭا مُّجْرِمِينَ",297],["10:78:10",217,"ٱلْكِبْرِيَآءُ","the greatness","ءَابَآءَنَا وَتَكُونَ لَكُمَا","فِى ٱلْأَرْضِ وَمَا",2424],["11:3:25",221,"كَبِيرٍ","(of) a Great Day","عَلَيْكُمْ عَذَابَ يَوْمٍۢ","",290],["11:11:10",222,"كَبِيرٌۭ","great","لَهُم مَّغْفِرَةٌۭ وَأَجْرٌۭ","",290],["12:31:19",239,"أَكْبَرْنَهُۥ","they greatly admired him","عَلَيْهِنَّ ۖ فَلَمَّا رَأَيْنَهُۥٓ","وَقَطَّعْنَ أَيْدِيَهُنَّ وَقُلْنَ",2997],["12:78:8",244,"كَبِيرًۭا","[great]","لَهُۥٓ أَبًۭا شَيْخًۭا","فَخُذْ أَحَدَنَا مَكَانَهُۥٓ ۖ",290],["12:80:7",245,"كَبِيرُهُمْ","the eldest among them","خَلَصُوا۟ نَجِيًّۭا ۖ قَالَ","أَلَمْ تَعْلَمُوٓا۟ أَنَّ",290],["13:9:4",250,"ٱلْكَبِيرُ","the Most Great","عَـٰلِمُ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ","ٱلْمُتَعَالِ",290],["14:21:7",258,"ٱسْتَكْبَرُوٓا۟","were arrogant","فَقَالَ ٱلضُّعَفَـٰٓؤُا۟ لِلَّذِينَ","إِنَّا كُنَّا لَكُمْ",297],["14:39:7",260,"ٱلْكِبَرِ","the old age","وَهَبَ لِى عَلَى","إِسْمَـٰعِيلَ وَإِسْحَـٰقَ ۚ إِنَّ",1192],["15:54:6",265,"ٱلْكِبَرُ","old age","عَلَىٰٓ أَن مَّسَّنِىَ","فَبِمَ تُبَشِّرُونَ",1192],["16:22:11",269,"مُّسْتَكْبِرُونَ","(are) arrogant","قُلُوبُهُم مُّنكِرَةٌۭ وَهُم","",1205],["16:23:13",269,"ٱلْمُسْتَكْبِرِينَ","the arrogant ones","إِنَّهُۥ لَا يُحِبُّ","",1205],["16:29:8",270,"ٱلْمُتَكَبِّرِينَ","(of) the arrogant","فِيهَا ۖ فَلَبِئْسَ مَثْوَى","",1088],["16:41:15",271,"أَكْبَرُ ۚ","(is) greater","حَسَنَةًۭ ۖ وَلَأَجْرُ ٱلْـَٔاخِرَةِ","لَوْ كَانُوا۟ يَعْلَمُونَ",434],["16:49:14",272,"يَسْتَكْبِرُونَ","arrogant","وَٱلْمَلَـٰٓئِكَةُ وَهُمْ لَا","",297],["17:4:13",282,"كَبِيرًۭا","great","مَرَّتَيْنِ وَلَتَعْلُنَّ عُلُوًّۭا","",290],["17:9:16",283,"كَبِيرًۭا","great","أَنَّ لَهُمْ أَجْرًۭا","",290],["17:21:8",284,"أَكْبَرُ","(is) greater","عَلَىٰ بَعْضٍۢ ۚ وَلَلْـَٔاخِرَةُ","دَرَجَـٰتٍۢ وَأَكْبَرُ تَفْضِيلًۭا",434],["17:21:10",284,"وَأَكْبَرُ","and greater","وَلَلْـَٔاخِرَةُ أَكْبَرُ دَرَجَـٰتٍۢ","تَفْضِيلًۭا",434],["17:23:12",284,"ٱلْكِبَرَ","the old age","إِمَّا يَبْلُغَنَّ عِندَكَ","أَحَدُهُمَآ أَوْ كِلَاهُمَا",1192],["17:31:13",285,"كَبِيرًۭا","great","قَتْلَهُمْ كَانَ خِطْـًۭٔا","",290],["17:43:6",286,"كَبِيرًۭا","great","عَمَّا يَقُولُونَ عُلُوًّۭا","",290],["17:51:4",287,"يَكْبُرُ","(is) great","أَوْ خَلْقًۭا مِّمَّا","فِى صُدُورِكُمْ ۚ فَسَيَقُولُونَ",978],["17:60:25",288,"كَبِيرًۭا","great","يَزِيدُهُمْ إِلَّا طُغْيَـٰنًۭا","",290],["17:87:9",291,"كَبِيرًۭا","great","فَضْلَهُۥ كَانَ عَلَيْكَ","",290],["17:111:20",293,"وَكَبِّرْهُ","And magnify Him","وَلِىٌّۭ مِّنَ ٱلذُّلِّ ۖ","تَكْبِيرًۢا",1565],["17:111:21",293,"تَكْبِيرًۢا","(with all) magnificence","مِّنَ ٱلذُّلِّ ۖ وَكَبِّرْهُ","",4382],["18:5:8",294,"كَبُرَتْ","Grave (is)","عِلْمٍۢ وَلَا لِـَٔابَآئِهِمْ ۚ","كَلِمَةًۭ تَخْرُجُ مِنْ",978],["18:49:17",299,"كَبِيرَةً","a great","يُغَادِرُ صَغِيرَةًۭ وَلَا","إِلَّآ أَحْصَىٰهَا ۚ وَوَجَدُوا۟",1081],["19:8:13",305,"ٱلْكِبَرِ","the old age","وَقَدْ بَلَغْتُ مِنَ","عِتِيًّۭا",1192],["20:23:4",313,"ٱلْكُبْرَى","the Greatest","لِنُرِيَكَ مِنْ ءَايَـٰتِنَا","",1082],["20:71:9",316,"لَكَبِيرُكُمُ","(is) your chief","ءَاذَنَ لَكُمْ ۖ إِنَّهُۥ","ٱلَّذِى عَلَّمَكُمُ ٱلسِّحْرَ ۖ",290],["21:19:9",323,"يَسْتَكْبِرُونَ","they are arrogant","وَمَنْ عِندَهُۥ لَا","عَنْ عِبَادَتِهِۦ وَلَا",297],["21:58:4",327,"كَبِيرًۭا","a large (one)","فَجَعَلَهُمْ جُذَٰذًا إِلَّا","لَّهُمْ لَعَلَّهُمْ إِلَيْهِ",290],["21:63:4",327,"كَبِيرُهُمْ","Their chief","قَالَ بَلْ فَعَلَهُۥ","هَـٰذَا فَسْـَٔلُوهُمْ إِن",290],["21:103:4",331,"ٱلْأَكْبَرُ","[the] greatest","لَا يَحْزُنُهُمُ ٱلْفَزَعُ","وَتَتَلَقَّىٰهُمُ ٱلْمَلَـٰٓئِكَةُ هَـٰذَا",434],["22:37:14",336,"لِتُكَبِّرُوا۟","so that you may magnify","كَذَٰلِكَ سَخَّرَهَا لَكُمْ","ٱللَّهَ عَلَىٰ مَا",1565],["22:62:17",339,"ٱلْكَبِيرُ","the Most Great","ٱللَّهَ هُوَ ٱلْعَلِىُّ","",290],["23:46:4",345,"فَٱسْتَكْبَرُوا۟","but they behaved arrogantly","إِلَىٰ فِرْعَوْنَ وَمَلَإِي۟هِۦ","وَكَانُوا۟ قَوْمًا عَالِينَ",297],["23:67:1",346,"مُسْتَكْبِرِينَ","(Being) arrogant","","بِهِۦ سَـٰمِرًۭا تَهْجُرُونَ",1205],["24:11:24",351,"كِبْرَهُۥ","took upon himself a greater share of it","ٱلْإِثْمِ ۚ وَٱلَّذِى تَوَلَّىٰ","مِنْهُمْ لَهُۥ عَذَابٌ",2423],["25:19:15",361,"كَبِيرًۭا","great","مِّنكُمْ نُذِقْهُ عَذَابًۭا","",290],["25:21:14",362,"ٱسْتَكْبَرُوا۟","they have become arrogant","نَرَىٰ رَبَّنَا ۗ لَقَدِ","فِىٓ أَنفُسِهِمْ وَعَتَوْ",297],["25:21:19",362,"كَبِيرًۭا","great","أَنفُسِهِمْ وَعَتَوْ عُتُوًّۭا","",290],["25:52:7",364,"كَبِيرًۭا","great","وَجَـٰهِدْهُم بِهِۦ جِهَادًۭا","",290],["26:49:9",369,"لَكَبِيرُكُمُ","(is) surely your chief","ءَاذَنَ لَكُمْ ۖ إِنَّهُۥ","ٱلَّذِى عَلَّمَكُمُ ٱلسِّحْرَ",290],["28:23:27",388,"كَبِيرٌۭ","(is) a very old man","ٱلرِّعَآءُ ۖ وَأَبُونَا شَيْخٌۭ","",290],["28:39:1",390,"وَٱسْتَكْبَرَ","And he was arrogant","","هُوَ وَجُنُودُهُۥ فِى",297],["29:39:8",401,"فَٱسْتَكْبَرُوا۟","but they were arrogant","جَآءَهُم مُّوسَىٰ بِٱلْبَيِّنَـٰتِ","فِى ٱلْأَرْضِ وَمَا",297],["29:45:17",401,"أَكْبَرُ ۗ","(is) greatest","وَٱلْمُنكَرِ ۗ وَلَذِكْرُ ٱللَّهِ","وَٱللَّهُ يَعْلَمُ مَا",434],["31:7:6",411,"مُسْتَكْبِرًۭا","arrogantly","عَلَيْهِ ءَايَـٰتُنَا وَلَّىٰ","كَأَن لَّمْ يَسْمَعْهَا",1205],["31:30:16",414,"ٱلْكَبِيرُ","the Most Great","ٱللَّهَ هُوَ ٱلْعَلِىُّ","",290],["32:15:15",416,"يَسْتَكْبِرُونَ ۩","are not arrogant","رَبِّهِمْ وَهُمْ لَا","",297],["32:21:7",417,"ٱلْأَكْبَرِ","the greater","ٱلْأَدْنَىٰ دُونَ ٱلْعَذَابِ","لَعَلَّهُمْ يَرْجِعُونَ",434],["33:47:8",424,"كَبِيرًۭا","great","مِّنَ ٱللَّهِ فَضْلًۭا","",290],["33:67:6",427,"وَكُبَرَآءَنَا","and our great men","إِنَّآ أَطَعْنَا سَادَتَنَا","فَأَضَلُّونَا ٱلسَّبِيلَا۠",3582],["33:68:8",427,"كَبِيرًۭا","great","ٱلْعَذَابِ وَٱلْعَنْهُمْ لَعْنًۭا","",290],["34:3:28",428,"أَكْبَرُ","greater","مِن ذَٰلِكَ وَلَآ","إِلَّا فِى كِتَـٰبٍۢ",434],["34:23:22",431,"ٱلْكَبِيرُ","the Most Great","ٱلْحَقَّ ۖ وَهُوَ ٱلْعَلِىُّ","",290],["34:31:28",431,"ٱسْتَكْبَرُوا۟","were arrogant","ٱلَّذِينَ ٱسْتُضْعِفُوا۟ لِلَّذِينَ","لَوْلَآ أَنتُمْ لَكُنَّا",297],["34:32:3",432,"ٱسْتَكْبَرُوا۟","were arrogant","قَالَ ٱلَّذِينَ","لِلَّذِينَ ٱسْتُضْعِفُوٓا۟ أَنَحْنُ",297],["34:33:5",432,"ٱسْتَكْبَرُوا۟","were arrogant","ٱلَّذِينَ ٱسْتُضْعِفُوا۟ لِلَّذِينَ","بَلْ مَكْرُ ٱلَّيْلِ",297],["35:7:13",435,"كَبِيرٌ","great","لَهُم مَّغْفِرَةٌۭ وَأَجْرٌۭ","",290],["35:32:21",438,"ٱلْكَبِيرُ","the great","ذَٰلِكَ هُوَ ٱلْفَضْلُ","",290],["35:43:1",439,"ٱسْتِكْبَارًۭا","(Due to) arrogance","","فِى ٱلْأَرْضِ وَمَكْرَ",2854],["37:35:10",447,"يَسْتَكْبِرُونَ","were arrogant","إِلَـٰهَ إِلَّا ٱللَّهُ","",297],["38:74:3",457,"ٱسْتَكْبَرَ","he was arrogant","إِلَّآ إِبْلِيسَ","وَكَانَ مِنَ ٱلْكَـٰفِرِينَ",297],["38:75:10",457,"أَسْتَكْبَرْتَ","Are you arrogant","لِمَا خَلَقْتُ بِيَدَىَّ ۖ","أَمْ كُنتَ مِنَ",297],["39:26:9",461,"أَكْبَرُ ۚ","(is) greater","ٱلدُّنْيَا ۖ وَلَعَذَابُ ٱلْـَٔاخِرَةِ","لَوْ كَانُوا۟ يَعْلَمُونَ",434],["39:59:7",465,"وَٱسْتَكْبَرْتَ","and were arrogant","ءَايَـٰتِى فَكَذَّبْتَ بِهَا","وَكُنتَ مِنَ ٱلْكَـٰفِرِينَ",297],["39:60:14",465,"لِّلْمُتَكَبِّرِينَ","for the arrogant","فِى جَهَنَّمَ مَثْوًۭى","",1088],["39:72:9",466,"ٱلْمُتَكَبِّرِينَ","(of) the arrogant","فِيهَا ۖ فَبِئْسَ مَثْوَى","",1088],["40:10:7",468,"أَكْبَرُ","(was) greater","يُنَادَوْنَ لَمَقْتُ ٱللَّهِ","مِن مَّقْتِكُمْ أَنفُسَكُمْ",434],["40:12:15",468,"ٱلْكَبِيرِ","the Most Great","فَٱلْحُكْمُ لِلَّهِ ٱلْعَلِىِّ","",290],["40:27:9",470,"مُتَكَبِّرٍۢ","arrogant one","وَرَبِّكُم مِّن كُلِّ","لَّا يُؤْمِنُ بِيَوْمِ",1088],["40:35:9",471,"كَبُرَ","(it) is greatly","بِغَيْرِ سُلْطَـٰنٍ أَتَىٰهُمْ ۖ","مَقْتًا عِندَ ٱللَّهِ",978],["40:35:22",471,"مُتَكَبِّرٍۢ","(of) an arrogant","عَلَىٰ كُلِّ قَلْبِ","جَبَّارٍۢ",1088],["40:47:8",472,"ٱسْتَكْبَرُوٓا۟","were arrogant","فَيَقُولُ ٱلضُّعَفَـٰٓؤُا۟ لِلَّذِينَ","إِنَّا كُنَّا لَكُمْ",297],["40:48:3",472,"ٱسْتَكْبَرُوٓا۟","(were) arrogant","قَالَ ٱلَّذِينَ","إِنَّا كُلٌّۭ فِيهَآ",297],["40:56:14",473,"كِبْرٌۭ","greatness","فِى صُدُورِهِمْ إِلَّا","مَّا هُم بِبَـٰلِغِيهِ ۚ",2423],["40:57:4",473,"أَكْبَرُ","(is) greater","لَخَلْقُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","مِنْ خَلْقِ ٱلنَّاسِ",434],["40:60:8",474,"يَسْتَكْبِرُونَ","(are) proud","لَكُمْ ۚ إِنَّ ٱلَّذِينَ","عَنْ عِبَادَتِى سَيَدْخُلُونَ",297],["40:76:8",475,"ٱلْمُتَكَبِّرِينَ","(of) the arrogant","فِيهَا ۖ فَبِئْسَ مَثْوَى","",1088],["41:15:3",478,"فَٱسْتَكْبَرُوا۟","they were arrogant","فَأَمَّا عَادٌۭ","فِى ٱلْأَرْضِ بِغَيْرِ",297],["41:38:2",480,"ٱسْتَكْبَرُوا۟","they are arrogant","فَإِنِ","فَٱلَّذِينَ عِندَ رَبِّكَ",297],["42:13:24",484,"كَبُرَ","Is difficult","وَلَا تَتَفَرَّقُوا۟ فِيهِ ۚ","عَلَى ٱلْمُشْرِكِينَ مَا",978],["42:22:24",485,"ٱلْكَبِيرُ","the Great","ذَٰلِكَ هُوَ ٱلْفَضْلُ","",290],["42:37:3",487,"كَبَـٰٓئِرَ","(the) greater","وَٱلَّذِينَ يَجْتَنِبُونَ","ٱلْإِثْمِ وَٱلْفَوَٰحِشَ وَإِذَا",1081],["43:48:7",493,"أَكْبَرُ","(was) greater","ءَايَةٍ إِلَّا هِىَ","مِنْ أُخْتِهَا ۖ وَأَخَذْنَـٰهُم",434],["44:16:4",496,"ٱلْكُبْرَىٰٓ","the greatest","يَوْمَ نَبْطِشُ ٱلْبَطْشَةَ","إِنَّا مُنتَقِمُونَ",1082],["45:8:8",499,"مُسْتَكْبِرًۭا","arrogantly","عَلَيْهِ ثُمَّ يُصِرُّ","كَأَن لَّمْ يَسْمَعْهَا ۖ",1205],["45:31:9",501,"فَٱسْتَكْبَرْتُمْ","but you were proud","ءَايَـٰتِى تُتْلَىٰ عَلَيْكُمْ","وَكُنتُمْ قَوْمًۭا مُّجْرِمِينَ",297],["45:37:2",502,"ٱلْكِبْرِيَآءُ","(is) the greatness","وَلَهُ","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ",2424],["46:10:18",503,"وَٱسْتَكْبَرْتُمْ ۖ","while you are arrogant","عَلَىٰ مِثْلِهِۦ فَـَٔامَنَ","إِنَّ ٱللَّهَ لَا",297],["46:20:20",504,"تَسْتَكْبِرُونَ","arrogant","ٱلْهُونِ بِمَا كُنتُمْ","فِى ٱلْأَرْضِ بِغَيْرِ",297],["53:18:6",526,"ٱلْكُبْرَىٰٓ","the Greatest","مِنْ ءَايَـٰتِ رَبِّهِ","",1082],["53:32:3",527,"كَبَـٰٓئِرَ","great","ٱلَّذِينَ يَجْتَنِبُونَ","ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا",1081],["54:53:3",531,"وَكَبِيرٍۢ","and big","وَكُلُّ صَغِيرٍۢ","مُّسْتَطَرٌ",290],["57:7:15",538,"كَبِيرٌۭ","great","وَأَنفَقُوا۟ لَهُمْ أَجْرٌۭ","",290],["59:23:15",548,"ٱلْمُتَكَبِّرُ ۚ","the Supreme","ٱلْمُهَيْمِنُ ٱلْعَزِيزُ ٱلْجَبَّارُ","سُبْحَـٰنَ ٱللَّهِ عَمَّا",1088],["61:3:1",551,"كَبُرَ","Great is","","مَقْتًا عِندَ ٱللَّهِ",978],["63:5:14",555,"مُّسْتَكْبِرُونَ","(are) arrogant","وَرَأَيْتَهُمْ يَصُدُّونَ وَهُم","",1205],["67:9:18",562,"كَبِيرٍۢ","great","إِلَّا فِى ضَلَـٰلٍۢ","",290],["67:12:9",562,"كَبِيرٌۭ","great","لَهُم مَّغْفِرَةٌۭ وَأَجْرٌۭ","",290],["68:33:5",565,"أَكْبَرُ ۚ","(is) greater","ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْـَٔاخِرَةِ","لَوْ كَانُوا۟ يَعْلَمُونَ",434],["71:7:13",570,"وَٱسْتَكْبَرُوا۟","and were arrogant","وَٱسْتَغْشَوْا۟ ثِيَابَهُمْ وَأَصَرُّوا۟","ٱسْتِكْبَارًۭا",297],["71:7:14",570,"ٱسْتِكْبَارًۭا","(with) pride","ثِيَابَهُمْ وَأَصَرُّوا۟ وَٱسْتَكْبَرُوا۟","",2854],["71:22:3",571,"كُبَّارًۭا","great","وَمَكَرُوا۟ مَكْرًۭا","",3584],["74:3:2",575,"فَكَبِّرْ","magnify","وَرَبَّكَ","",1565],["74:23:3",576,"وَٱسْتَكْبَرَ","and was proud","ثُمَّ أَدْبَرَ","",297],["74:35:3",576,"ٱلْكُبَرِ","(of) the greatest","إِنَّهَا لَإِحْدَى","",1082],["76:20:7",579,"كَبِيرًا","great","رَأَيْتَ نَعِيمًۭا وَمُلْكًۭا","",290],["79:20:3",584,"ٱلْكُبْرَىٰ","the great","فَأَرَىٰهُ ٱلْـَٔايَةَ","",1082],["79:34:4",584,"ٱلْكُبْرَىٰ","the great","فَإِذَا جَآءَتِ ٱلطَّآمَّةُ","",1082],["85:11:14",590,"ٱلْكَبِيرُ","the great","ٱلْأَنْهَـٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ","",290],["87:12:4",592,"ٱلْكُبْرَىٰ","[the] great","ٱلَّذِى يَصْلَى ٱلنَّارَ","",1082],["88:24:4",593,"ٱلْأَكْبَرَ","greatest","فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ","",434]]