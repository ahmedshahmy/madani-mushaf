[["2:15:6",3,"طُغْيَـٰنِهِمْ","their transgression","بِهِمْ وَيَمُدُّهُمْ فِى","يَعْمَهُونَ",893],["2:256:12",42,"بِٱلطَّـٰغُوتِ","in false deities","ٱلْغَىِّ ۚ فَمَن يَكْفُرْ","وَيُؤْمِنۢ بِٱللَّهِ فَقَدِ",966],["2:257:13",43,"ٱلطَّـٰغُوتُ","(are) the evil ones","وَٱلَّذِينَ كَفَرُوٓا۟ أَوْلِيَآؤُهُمُ","يُخْرِجُونَهُم مِّنَ ٱلنُّورِ",966],["4:51:11",86,"وَٱلطَّـٰغُوتِ","and the false deities","ٱلْكِتَـٰبِ يُؤْمِنُونَ بِٱلْجِبْتِ","وَيَقُولُونَ لِلَّذِينَ كَفَرُوا۟",966],["4:60:19",88,"ٱلطَّـٰغُوتِ","the false deities","أَن يَتَحَاكَمُوٓا۟ إِلَى","وَقَدْ أُمِرُوٓا۟ أَن",966],["4:76:12",90,"ٱلطَّـٰغُوتِ","(of) the false deities","يُقَـٰتِلُونَ فِى سَبِيلِ","فَقَـٰتِلُوٓا۟ أَوْلِيَآءَ ٱلشَّيْطَـٰنِ ۖ",966],["5:60:20",118,"ٱلطَّـٰغُوتَ ۚ","the false deities","ٱلْقِرَدَةَ وَٱلْخَنَازِيرَ وَعَبَدَ","أُو۟لَـٰٓئِكَ شَرٌّۭ مَّكَانًۭا",966],["5:64:25",118,"طُغْيَـٰنًۭا","(in) rebellion","إِلَيْكَ مِن رَّبِّكَ","وَكُفْرًۭا ۚ وَأَلْقَيْنَا بَيْنَهُمُ",893],["5:68:24",119,"طُغْيَـٰنًۭا","(in) rebellion","إِلَيْكَ مِن رَّبِّكَ","وَكُفْرًۭا ۖ فَلَا تَأْسَ",893],["6:110:12",141,"طُغْيَـٰنِهِمْ","their transgression","مَرَّةٍۢ وَنَذَرُهُمْ فِى","يَعْمَهُونَ",893],["7:186:9",174,"طُغْيَـٰنِهِمْ","their transgression","لَهُۥ ۚ وَيَذَرُهُمْ فِى","يَعْمَهُونَ",893],["10:11:17",209,"طُغْيَـٰنِهِمْ","their transgression","يَرْجُونَ لِقَآءَنَا فِى","يَعْمَهُونَ",893],["11:112:8",234,"تَطْغَوْا۟ ۚ","transgress","تَابَ مَعَكَ وَلَا","إِنَّهُۥ بِمَا تَعْمَلُونَ",724],["16:36:11",271,"ٱلطَّـٰغُوتَ ۖ","the false deities","ٱعْبُدُوا۟ ٱللَّهَ وَٱجْتَنِبُوا۟","فَمِنْهُم مَّنْ هَدَى",966],["17:60:24",288,"طُغْيَـٰنًۭا","(in) transgression","فَمَا يَزِيدُهُمْ إِلَّا","كَبِيرًۭا",893],["18:80:9",302,"طُغْيَـٰنًۭا","(by) transgression","فَخَشِينَآ أَن يُرْهِقَهُمَا","وَكُفْرًۭا",893],["20:24:5",313,"طَغَىٰ","(has) transgressed","إِلَىٰ فِرْعَوْنَ إِنَّهُۥ","",724],["20:43:5",314,"طَغَىٰ","(has) transgressed","إِلَىٰ فِرْعَوْنَ إِنَّهُۥ","",724],["20:45:10",314,"يَطْغَىٰ","he will transgress","عَلَيْنَآ أَوْ أَن","",724],["20:81:7",317,"تَطْغَوْا۟","transgress","مَا رَزَقْنَـٰكُمْ وَلَا","فِيهِ فَيَحِلَّ عَلَيْكُمْ",724],["23:75:10",347,"طُغْيَـٰنِهِمْ","their transgression","ضُرٍّۢ لَّلَجُّوا۟ فِى","يَعْمَهُونَ",893],["37:30:10",447,"طَـٰغِينَ","transgressing","بَلْ كُنتُمْ قَوْمًۭا","",1160],["38:55:3",456,"لِلطَّـٰغِينَ","for the transgressors","هَـٰذَا ۚ وَإِنَّ","لَشَرَّ مَـَٔابٍۢ",1160],["39:17:3",460,"ٱلطَّـٰغُوتَ","the false gods","وَٱلَّذِينَ ٱجْتَنَبُوا۟","أَن يَعْبُدُوهَا وَأَنَابُوٓا۟",966],["50:27:5",519,"أَطْغَيْتُهُۥ","I made him transgress","قَرِينُهُۥ رَبَّنَا مَآ","وَلَـٰكِن كَانَ فِى",2969],["51:53:6",523,"طَاغُونَ","transgressing","بَلْ هُمْ قَوْمٌۭ","",1160],["52:32:8",525,"طَاغُونَ","transgressing","أَمْ هُمْ قَوْمٌۭ","",1160],["53:17:5",526,"طَغَىٰ","it transgressed","زَاغَ ٱلْبَصَرُ وَمَا","",724],["53:52:9",528,"وَأَطْغَىٰ","and more rebellious","كَانُوا۟ هُمْ أَظْلَمَ","",2968],["55:8:2",531,"تَطْغَوْا۟","you may transgress","أَلَّا","فِى ٱلْمِيزَانِ",724],["68:31:5",565,"طَـٰغِينَ","transgressors","يَـٰوَيْلَنَآ إِنَّا كُنَّا","",1160],["69:5:4",566,"بِٱلطَّاغِيَةِ","by the overpowering (blast)","فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟","",3301],["69:11:3",567,"طَغَا","overflowed","إِنَّا لَمَّا","ٱلْمَآءُ حَمَلْنَـٰكُمْ فِى",724],["78:22:1",582,"لِّلطَّـٰغِينَ","For the transgressors","","مَـَٔابًۭا",1160],["79:17:5",584,"طَغَىٰ","(has) transgressed","إِلَىٰ فِرْعَوْنَ إِنَّهُۥ","",724],["79:37:3",584,"طَغَىٰ","transgressed","فَأَمَّا مَن","",724],["89:11:2",593,"طَغَوْا۟","transgressed","ٱلَّذِينَ","فِى ٱلْبِلَـٰدِ",724],["91:11:3",595,"بِطَغْوَىٰهَآ","by their transgression","كَذَّبَتْ ثَمُودُ","",3292],["96:6:4",597,"لَيَطْغَىٰٓ","surely transgresses","كَلَّآ إِنَّ ٱلْإِنسَـٰنَ","",724]]