[["5:1:8",106,"بَهِيمَةُ","the quadruped","بِٱلْعُقُودِ ۚ أُحِلَّتْ لَكُم","ٱلْأَنْعَـٰمِ إِلَّا مَا",1809],["22:28:14",335,"بَهِيمَةِ","(the) beast","مَا رَزَقَهُم مِّنۢ","ٱلْأَنْعَـٰمِ ۖ فَكُلُوا۟ مِنْهَا",1809],["22:34:12",336,"بَهِيمَةِ","(the) beast","مَا رَزَقَهُم مِّنۢ","ٱلْأَنْعَـٰمِ ۗ فَإِلَـٰهُكُمْ إِلَـٰهٌۭ",1809]]