[["4:47:14",86,"نَّطْمِسَ","We efface","مِّن قَبْلِ أَن","وُجُوهًۭا فَنَرُدَّهَا عَلَىٰٓ",1317],["10:88:18",218,"ٱطْمِسْ","Destroy","عَن سَبِيلِكَ ۖ رَبَّنَا","عَلَىٰٓ أَمْوَٰلِهِمْ وَٱشْدُدْ",1317],["36:66:3",444,"لَطَمَسْنَا","We (would have) surely obliterated","وَلَوْ نَشَآءُ","عَلَىٰٓ أَعْيُنِهِمْ فَٱسْتَبَقُوا۟",1317],["54:37:5",530,"فَطَمَسْنَآ","so We blinded","رَٰوَدُوهُ عَن ضَيْفِهِۦ","أَعْيُنَهُمْ فَذُوقُوا۟ عَذَابِى",1317],["77:8:3",580,"طُمِسَتْ","are obliterated","فَإِذَا ٱلنُّجُومُ","",1317]]