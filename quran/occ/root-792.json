[["2:233:15",37,"وَكِسْوَتُهُنَّ","and their clothing","ٱلْمَوْلُودِ لَهُۥ رِزْقُهُنَّ","بِٱلْمَعْرُوفِ ۚ لَا تُكَلَّفُ",2425],["2:259:55",43,"نَكْسُوهَا","We cover them","كَيْفَ نُنشِزُهَا ثُمَّ","لَحْمًۭا ۚ فَلَمَّا تَبَيَّنَ",1865],["4:5:12",77,"وَٱكْسُوهُمْ","and clothe them","قِيَـٰمًۭا وَٱرْزُقُوهُمْ فِيهَا","وَقُولُوا۟ لَهُمْ قَوْلًۭا",1865],["5:89:22",122,"كِسْوَتُهُمْ","clothing them","تُطْعِمُونَ أَهْلِيكُمْ أَوْ","أَوْ تَحْرِيرُ رَقَبَةٍۢ ۖ",2425],["23:14:11",342,"فَكَسَوْنَا","then We clothed","فَخَلَقْنَا ٱلْمُضْغَةَ عِظَـٰمًۭا","ٱلْعِظَـٰمَ لَحْمًۭا ثُمَّ",1865]]