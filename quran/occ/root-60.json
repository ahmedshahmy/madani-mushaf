[["2:17:1",4,"مَثَلُهُمْ","Their example","","كَمَثَلِ ٱلَّذِى ٱسْتَوْقَدَ",123],["2:17:2",4,"كَمَثَلِ","(is) like (the) example","مَثَلُهُمْ","ٱلَّذِى ٱسْتَوْقَدَ نَارًۭا",123],["2:23:12",4,"مِّثْلِهِۦ","like it","فَأْتُوا۟ بِسُورَةٍۢ مِّن","وَٱدْعُوا۟ شُهَدَآءَكُم مِّن",155],["2:26:7",5,"مَثَلًۭا","an example","يَسْتَحْىِۦٓ أَن يَضْرِبَ","مَّا بَعُوضَةًۭ فَمَا",123],["2:26:28",5,"مَثَلًۭا ۘ","example","أَرَادَ ٱللَّهُ بِهَـٰذَا","يُضِلُّ بِهِۦ كَثِيرًۭا",123],["2:106:11",17,"مِثْلِهَآ ۗ","similar (to) it","بِخَيْرٍۢ مِّنْهَآ أَوْ","أَلَمْ تَعْلَمْ أَنَّ",155],["2:113:21",18,"مِثْلَ","similar","ٱلَّذِينَ لَا يَعْلَمُونَ","قَوْلِهِمْ ۚ فَٱللَّهُ يَحْكُمُ",155],["2:118:16",18,"مِّثْلَ","similar","ٱلَّذِينَ مِن قَبْلِهِم","قَوْلِهِمْ ۘ تَشَـٰبَهَتْ قُلُوبُهُمْ ۗ",155],["2:137:3",21,"بِمِثْلِ","in (the) like","فَإِنْ ءَامَنُوا۟","مَآ ءَامَنتُم بِهِۦ",155],["2:171:1",26,"وَمَثَلُ","And (the) example","","ٱلَّذِينَ كَفَرُوا۟ كَمَثَلِ",123],["2:171:4",26,"كَمَثَلِ","(is) like (the) example","وَمَثَلُ ٱلَّذِينَ كَفَرُوا۟","ٱلَّذِى يَنْعِقُ بِمَا",123],["2:194:12",30,"بِمِثْلِ","in (the) same manner","عَلَيْكُمْ فَٱعْتَدُوا۟ عَلَيْهِ","مَا ٱعْتَدَىٰ عَلَيْكُمْ ۚ",155],["2:214:8",33,"مَّثَلُ","like (came to)","ٱلْجَنَّةَ وَلَمَّا يَأْتِكُم","ٱلَّذِينَ خَلَوْا۟ مِن",123],["2:228:31",36,"مِثْلُ","(is the) like","أَرَادُوٓا۟ إِصْلَـٰحًۭا ۚ وَلَهُنَّ","ٱلَّذِى عَلَيْهِنَّ بِٱلْمَعْرُوفِ ۚ",155],["2:233:32",37,"مِثْلُ","(is a duty) like","بِوَلَدِهِۦ ۚ وَعَلَى ٱلْوَارِثِ","ذَٰلِكَ ۗ فَإِنْ أَرَادَا",155],["2:261:1",44,"مَّثَلُ","Example","","ٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُمْ",123],["2:261:8",44,"كَمَثَلِ","(is) like","فِى سَبِيلِ ٱللَّهِ","حَبَّةٍ أَنۢبَتَتْ سَبْعَ",123],["2:264:19",44,"فَمَثَلُهُۥ","Then his example","بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۖ","كَمَثَلِ صَفْوَانٍ عَلَيْهِ",123],["2:264:20",44,"كَمَثَلِ","(is) like","وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۖ فَمَثَلُهُۥ","صَفْوَانٍ عَلَيْهِ تُرَابٌۭ",123],["2:265:1",45,"وَمَثَلُ","And (the) example","","ٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُمُ",123],["2:265:11",45,"كَمَثَلِ","(is) like","وَتَثْبِيتًۭا مِّنْ أَنفُسِهِمْ","جَنَّةٍۭ بِرَبْوَةٍ أَصَابَهَا",123],["2:275:19",47,"مِثْلُ","(is) like","قَالُوٓا۟ إِنَّمَا ٱلْبَيْعُ","ٱلرِّبَوٰا۟ ۗ وَأَحَلَّ ٱللَّهُ",155],["3:13:16",51,"مِّثْلَيْهِمْ","twice of them","وَأُخْرَىٰ كَافِرَةٌۭ يَرَوْنَهُم","رَأْىَ ٱلْعَيْنِ ۚ وَٱللَّهُ",155],["3:59:2",57,"مَثَلَ","(the) likeness","إِنَّ","عِيسَىٰ عِندَ ٱللَّهِ",123],["3:59:6",57,"كَمَثَلِ","(is) like (the) likeness","عِيسَىٰ عِندَ ٱللَّهِ","ءَادَمَ ۖ خَلَقَهُۥ مِن",123],["3:73:15",59,"مِّثْلَ","(the) like","أَن يُؤْتَىٰٓ أَحَدٌۭ","مَآ أُوتِيتُمْ أَوْ",155],["3:117:1",65,"مَثَلُ","Example","","مَا يُنفِقُونَ فِى",123],["3:117:8",65,"كَمَثَلِ","(is) like (the) example","هَـٰذِهِ ٱلْحَيَوٰةِ ٱلدُّنْيَا","رِيحٍۢ فِيهَا صِرٌّ",123],["3:140:8",67,"مِّثْلُهُۥ ۚ","like it","مَسَّ ٱلْقَوْمَ قَرْحٌۭ","وَتِلْكَ ٱلْأَيَّامُ نُدَاوِلُهَا",155],["3:165:6",71,"مِّثْلَيْهَا","twice of it","مُّصِيبَةٌۭ قَدْ أَصَبْتُم","قُلْتُمْ أَنَّىٰ هَـٰذَا ۖ",155],["4:11:6",78,"مِثْلُ","like","فِىٓ أَوْلَـٰدِكُمْ ۖ لِلذَّكَرِ","حَظِّ ٱلْأُنثَيَيْنِ ۚ فَإِن",155],["4:140:25",100,"مِّثْلُهُمْ ۗ","(would be) like them","غَيْرِهِۦٓ ۚ إِنَّكُمْ إِذًۭا","إِنَّ ٱللَّهَ جَامِعُ",155],["4:176:39",106,"مِثْلُ","like","رِّجَالًۭا وَنِسَآءًۭ فَلِلذَّكَرِ","حَظِّ ٱلْأُنثَيَيْنِ ۗ يُبَيِّنُ",155],["5:31:17",112,"مِثْلَ","like","أَعَجَزْتُ أَنْ أَكُونَ","هَـٰذَا ٱلْغُرَابِ فَأُوَٰرِىَ",155],["5:36:11",113,"وَمِثْلَهُۥ","and the like of it","فِى ٱلْأَرْضِ جَمِيعًۭا","مَعَهُۥ لِيَفْتَدُوا۟ بِهِۦ",155],["5:95:14",123,"مِّثْلُ","(is) similar","مِنكُم مُّتَعَمِّدًۭا فَجَزَآءٌۭ","مَا قَتَلَ مِنَ",155],["6:38:12",132,"أَمْثَالُكُم ۚ","like you","بِجَنَاحَيْهِ إِلَّآ أُمَمٌ","مَّا فَرَّطْنَا فِى",123],["6:93:19",139,"مِثْلَ","like","وَمَن قَالَ سَأُنزِلُ","مَآ أَنزَلَ ٱللَّهُ ۗ",155],["6:122:13",143,"مَّثَلُهُۥ","[similar to him]","فِى ٱلنَّاسِ كَمَن","فِى ٱلظُّلُمَـٰتِ لَيْسَ",123],["6:124:9",143,"مِثْلَ","like","نُّؤْمِنَ حَتَّىٰ نُؤْتَىٰ","مَآ أُوتِىَ رُسُلُ",155],["6:160:6",150,"أَمْثَالِهَا ۖ","the like of it","بِٱلْحَسَنَةِ فَلَهُۥ عَشْرُ","وَمَن جَآءَ بِٱلسَّيِّئَةِ",123],["6:160:13",150,"مِثْلَهَا","the like of it","فَلَا يُجْزَىٰٓ إِلَّا","وَهُمْ لَا يُظْلَمُونَ",155],["7:169:17",172,"مِّثْلُهُۥ","similar to it","وَإِن يَأْتِهِمْ عَرَضٌۭ","يَأْخُذُوهُ ۚ أَلَمْ يُؤْخَذْ",155],["7:176:11",173,"فَمَثَلُهُۥ","So his example","ٱلْأَرْضِ وَٱتَّبَعَ هَوَىٰهُ ۚ","كَمَثَلِ ٱلْكَلْبِ إِن",123],["7:176:12",173,"كَمَثَلِ","(is) like (the) example","وَٱتَّبَعَ هَوَىٰهُ ۚ فَمَثَلُهُۥ","ٱلْكَلْبِ إِن تَحْمِلْ",123],["7:176:22",173,"مَثَلُ","(is the) example","تَتْرُكْهُ يَلْهَث ۚ ذَّٰلِكَ","ٱلْقَوْمِ ٱلَّذِينَ كَذَّبُوا۟",123],["7:177:2",173,"مَثَلًا","(as) an example","سَآءَ","ٱلْقَوْمُ ٱلَّذِينَ كَذَّبُوا۟",123],["7:194:8",175,"أَمْثَالُكُمْ ۖ","like you","دُونِ ٱللَّهِ عِبَادٌ","فَٱدْعُوهُمْ فَلْيَسْتَجِيبُوا۟ لَكُمْ",123],["8:31:11",180,"مِثْلَ","like","لَوْ نَشَآءُ لَقُلْنَا","هَـٰذَآ ۙ إِنْ هَـٰذَآ",155],["10:24:2",211,"مَثَلُ","(the) example","إِنَّمَا","ٱلْحَيَوٰةِ ٱلدُّنْيَا كَمَآءٍ",123],["10:27:6",212,"بِمِثْلِهَا","(is) like it","ٱلسَّيِّـَٔاتِ جَزَآءُ سَيِّئَةٍۭ","وَتَرْهَقُهُمْ ذِلَّةٌۭ ۖ مَّا",155],["10:38:7",213,"مِّثْلِهِۦ","like it","قُلْ فَأْتُوا۟ بِسُورَةٍۢ","وَٱدْعُوا۟ مَنِ ٱسْتَطَعْتُم",155],["10:102:4",220,"مِثْلَ","like","فَهَلْ يَنتَظِرُونَ إِلَّا","أَيَّامِ ٱلَّذِينَ خَلَوْا۟",155],["11:13:8",223,"مِّثْلِهِۦ","like it","فَأْتُوا۟ بِعَشْرِ سُوَرٍۢ","مُفْتَرَيَـٰتٍۢ وَٱدْعُوا۟ مَنِ",155],["11:24:1",224,"۞ مَثَلُ","(The) example","","ٱلْفَرِيقَيْنِ كَٱلْأَعْمَىٰ وَٱلْأَصَمِّ",123],["11:24:9",224,"مَثَلًا ۚ","(in) comparison","وَٱلسَّمِيعِ ۚ هَلْ يَسْتَوِيَانِ","أَفَلَا تَذَكَّرُونَ",123],["11:27:11",224,"مِّثْلَنَا","like us","نَرَىٰكَ إِلَّا بَشَرًۭا","وَمَا نَرَىٰكَ ٱتَّبَعَكَ",155],["11:89:7",232,"مِّثْلُ","similar","شِقَاقِىٓ أَن يُصِيبَكُم","مَآ أَصَابَ قَوْمَ",155],["13:6:9",250,"ٱلْمَثُلَـٰتُ ۗ","[the] similar punishments","خَلَتْ مِن قَبْلِهِمُ","وَإِنَّ رَبَّكَ لَذُو",3722],["13:17:22",251,"مِّثْلُهُۥ ۚ","like it","أَوْ مَتَـٰعٍۢ زَبَدٌۭ","كَذَٰلِكَ يَضْرِبُ ٱللَّهُ",155],["13:17:42",251,"ٱلْأَمْثَالَ","the examples","كَذَٰلِكَ يَضْرِبُ ٱللَّهُ","",123],["13:18:16",251,"وَمِثْلَهُۥ","and like of it","فِى ٱلْأَرْضِ جَمِيعًۭا","مَعَهُۥ لَٱفْتَدَوْا۟ بِهِۦٓ ۚ",155],["13:35:1",254,"۞ مَّثَلُ","The example","","ٱلْجَنَّةِ ٱلَّتِى وُعِدَ",123],["14:10:23",256,"مِّثْلُنَا","like us","أَنتُمْ إِلَّا بَشَرٌۭ","تُرِيدُونَ أَن تَصُدُّونَا",155],["14:11:8",257,"مِّثْلُكُمْ","like you","نَّحْنُ إِلَّا بَشَرٌۭ","وَلَـٰكِنَّ ٱللَّهَ يَمُنُّ",155],["14:18:1",257,"مَّثَلُ","(The) example","","ٱلَّذِينَ كَفَرُوا۟ بِرَبِّهِمْ ۖ",123],["14:24:6",258,"مَثَلًۭا","the example","كَيْفَ ضَرَبَ ٱللَّهُ","كَلِمَةًۭ طَيِّبَةًۭ كَشَجَرَةٍۢ",123],["14:25:9",259,"ٱلْأَمْثَالَ","the examples","رَبِّهَا ۗ وَيَضْرِبُ ٱللَّهُ","لِلنَّاسِ لَعَلَّهُمْ يَتَذَكَّرُونَ",123],["14:26:1",259,"وَمَثَلُ","And (the) example","","كَلِمَةٍ خَبِيثَةٍۢ كَشَجَرَةٍ",123],["14:45:14",261,"ٱلْأَمْثَالَ","the examples","بِهِمْ وَضَرَبْنَا لَكُمُ","",123],["16:60:5",273,"مَثَلُ","(is) a similitude","لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ","ٱلسَّوْءِ ۖ وَلِلَّهِ ٱلْمَثَلُ",123],["16:60:8",273,"ٱلْمَثَلُ","(is) the similitude","مَثَلُ ٱلسَّوْءِ ۖ وَلِلَّهِ","ٱلْأَعْلَىٰ ۚ وَهُوَ ٱلْعَزِيزُ",123],["16:74:4",275,"ٱلْأَمْثَالَ ۚ","the similitude","فَلَا تَضْرِبُوا۟ لِلَّهِ","إِنَّ ٱللَّهَ يَعْلَمُ",123],["16:75:3",275,"مَثَلًا","the example","۞ ضَرَبَ ٱللَّهُ","عَبْدًۭا مَّمْلُوكًۭا لَّا",123],["16:76:3",275,"مَثَلًۭا","an example","وَضَرَبَ ٱللَّهُ","رَّجُلَيْنِ أَحَدُهُمَآ أَبْكَمُ",123],["16:112:3",280,"مَثَلًۭا","a similitude","وَضَرَبَ ٱللَّهُ","قَرْيَةًۭ كَانَتْ ءَامِنَةًۭ",123],["16:126:4",281,"بِمِثْلِ","with the like","وَإِنْ عَاقَبْتُمْ فَعَاقِبُوا۟","مَا عُوقِبْتُم بِهِۦ ۖ",155],["17:48:5",286,"ٱلْأَمْثَالَ","the examples","كَيْفَ ضَرَبُوا۟ لَكَ","فَضَلُّوا۟ فَلَا يَسْتَطِيعُونَ",123],["17:88:9",291,"بِمِثْلِ","the like","عَلَىٰٓ أَن يَأْتُوا۟","هَـٰذَا ٱلْقُرْءَانِ لَا",155],["17:88:14",291,"بِمِثْلِهِۦ","the like of it","ٱلْقُرْءَانِ لَا يَأْتُونَ","وَلَوْ كَانَ بَعْضُهُمْ",155],["17:89:9",291,"مَثَلٍۢ","example","ٱلْقُرْءَانِ مِن كُلِّ","فَأَبَىٰٓ أَكْثَرُ ٱلنَّاسِ",123],["17:99:13",292,"مِثْلَهُمْ","the like of them","عَلَىٰٓ أَن يَخْلُقَ","وَجَعَلَ لَهُمْ أَجَلًۭا",155],["18:32:3",297,"مَّثَلًۭا","the example","۞ وَٱضْرِبْ لَهُم","رَّجُلَيْنِ جَعَلْنَا لِأَحَدِهِمَا",123],["18:45:3",298,"مَّثَلَ","the example","وَٱضْرِبْ لَهُم","ٱلْحَيَوٰةِ ٱلدُّنْيَا كَمَآءٍ",123],["18:54:9",300,"مَثَلٍۢ ۚ","example","لِلنَّاسِ مِن كُلِّ","وَكَانَ ٱلْإِنسَـٰنُ أَكْثَرَ",123],["18:109:17",304,"بِمِثْلِهِۦ","(the) like (of) it","رَبِّى وَلَوْ جِئْنَا","مَدَدًۭا",155],["18:110:5",304,"مِّثْلُكُمْ","like you","إِنَّمَآ أَنَا۠ بَشَرٌۭ","يُوحَىٰٓ إِلَىَّ أَنَّمَآ",155],["19:17:8",306,"فَتَمَثَّلَ","then he assumed for her the likeness","فَأَرْسَلْنَآ إِلَيْهَا رُوحَنَا","لَهَا بَشَرًۭا سَوِيًّۭا",4391],["20:58:3",315,"مِّثْلِهِۦ","like it","فَلَنَأْتِيَنَّكَ بِسِحْرٍۢ","فَٱجْعَلْ بَيْنَنَا وَبَيْنَكَ",155],["20:63:13",315,"ٱلْمُثْلَىٰ","the exemplary","بِسِحْرِهِمَا وَيَذْهَبَا بِطَرِيقَتِكُمُ","",3883],["20:104:7",319,"أَمْثَلُهُمْ","(the) best of them","يَقُولُونَ إِذْ يَقُولُ","طَرِيقَةً إِن لَّبِثْتُمْ",3016],["21:3:11",322,"مِّثْلُكُمْ ۖ","like you","هَـٰذَآ إِلَّا بَشَرٌۭ","أَفَتَأْتُونَ ٱلسِّحْرَ وَأَنتُمْ",155],["21:52:7",326,"ٱلتَّمَاثِيلُ","[the] statues","وَقَوْمِهِۦ مَا هَـٰذِهِ","ٱلَّتِىٓ أَنتُمْ لَهَا",2696],["21:84:10",329,"وَمِثْلَهُم","and (the) like thereof","ضُرٍّۢ ۖ وَءَاتَيْنَـٰهُ أَهْلَهُۥ","مَّعَهُمْ رَحْمَةًۭ مِّنْ",155],["22:60:4",339,"بِمِثْلِ","with the like","۞ ذَٰلِكَ وَمَنْ عَاقَبَ","مَا عُوقِبَ بِهِۦ",155],["22:73:4",341,"مَثَلٌۭ","an example","يَـٰٓأَيُّهَا ٱلنَّاسُ ضُرِبَ","فَٱسْتَمِعُوا۟ لَهُۥٓ ۚ إِنَّ",123],["23:24:11",343,"مِّثْلُكُمْ","like you","هَـٰذَآ إِلَّا بَشَرٌۭ","يُرِيدُ أَن يَتَفَضَّلَ",155],["23:33:18",344,"مِّثْلُكُمْ","like you","هَـٰذَآ إِلَّا بَشَرٌۭ","يَأْكُلُ مِمَّا تَأْكُلُونَ",155],["23:34:4",344,"مِّثْلَكُمْ","like you","وَلَئِنْ أَطَعْتُم بَشَرًۭا","إِنَّكُمْ إِذًۭا لَّخَـٰسِرُونَ",155],["23:47:4",345,"مِثْلِنَا","like ourselves","فَقَالُوٓا۟ أَنُؤْمِنُ لِبَشَرَيْنِ","وَقَوْمُهُمَا لَنَا عَـٰبِدُونَ",155],["23:81:3",347,"مِثْلَ","(the) like","بَلْ قَالُوا۟","مَا قَالَ ٱلْأَوَّلُونَ",155],["24:17:5",351,"لِمِثْلِهِۦٓ","(to the) like of it","ٱللَّهُ أَن تَعُودُوا۟","أَبَدًا إِن كُنتُم",155],["24:34:6",354,"وَمَثَلًۭا","and an example","إِلَيْكُمْ ءَايَـٰتٍۢ مُّبَيِّنَـٰتٍۢ","مِّنَ ٱلَّذِينَ خَلَوْا۟",123],["24:35:5",354,"مَثَلُ","(The) example","نُورُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ","نُورِهِۦ كَمِشْكَوٰةٍۢ فِيهَا",123],["24:35:43",354,"ٱلْأَمْثَـٰلَ","the examples","يَشَآءُ ۚ وَيَضْرِبُ ٱللَّهُ","لِلنَّاسِ ۗ وَٱللَّهُ بِكُلِّ",123],["25:9:5",360,"ٱلْأَمْثَـٰلَ","the similitudes","كَيْفَ ضَرَبُوا۟ لَكَ","فَضَلُّوا۟ فَلَا يَسْتَطِيعُونَ",123],["25:33:3",363,"بِمَثَلٍ","with an example","وَلَا يَأْتُونَكَ","إِلَّا جِئْنَـٰكَ بِٱلْحَقِّ",123],["25:39:4",363,"ٱلْأَمْثَـٰلَ ۖ","the examples","وَكُلًّۭا ضَرَبْنَا لَهُ","وَكُلًّۭا تَبَّرْنَا تَتْبِيرًۭا",123],["26:154:5",373,"مِّثْلُنَا","like us","أَنتَ إِلَّا بَشَرٌۭ","فَأْتِ بِـَٔايَةٍ إِن",155],["26:186:5",375,"مِّثْلُنَا","like us","أَنتَ إِلَّا بَشَرٌۭ","وَإِن نَّظُنُّكَ لَمِنَ",155],["28:48:9",391,"مِثْلَ","(the) like","قَالُوا۟ لَوْلَآ أُوتِىَ","مَآ أُوتِىَ مُوسَىٰٓ ۚ",155],["28:79:13",395,"مِثْلَ","(the) like","ٱلدُّنْيَا يَـٰلَيْتَ لَنَا","مَآ أُوتِىَ قَـٰرُونُ",155],["29:41:1",401,"مَثَلُ","(The) example","","ٱلَّذِينَ ٱتَّخَذُوا۟ مِن",123],["29:41:8",401,"كَمَثَلِ","(is) like","دُونِ ٱللَّهِ أَوْلِيَآءَ","ٱلْعَنكَبُوتِ ٱتَّخَذَتْ بَيْتًۭا ۖ",123],["29:43:2",401,"ٱلْأَمْثَـٰلُ","examples","وَتِلْكَ","نَضْرِبُهَا لِلنَّاسِ ۖ وَمَا",123],["30:27:11",407,"ٱلْمَثَلُ","(is) the description","أَهْوَنُ عَلَيْهِ ۚ وَلَهُ","ٱلْأَعْلَىٰ فِى ٱلسَّمَـٰوَٰتِ",123],["30:28:3",407,"مَّثَلًۭا","an example","ضَرَبَ لَكُم","مِّنْ أَنفُسِكُمْ ۖ هَل",123],["30:58:9",410,"مَثَلٍۢ ۚ","example","ٱلْقُرْءَانِ مِن كُلِّ","وَلَئِن جِئْتَهُم بِـَٔايَةٍۢ",123],["34:13:7",429,"وَتَمَـٰثِيلَ","and statues","يَشَآءُ مِن مَّحَـٰرِيبَ","وَجِفَانٍۢ كَٱلْجَوَابِ وَقُدُورٍۢ",2696],["35:14:17",436,"مِثْلُ","like","بِشِرْكِكُمْ ۚ وَلَا يُنَبِّئُكَ","خَبِيرٍۢ",155],["36:13:3",441,"مَّثَلًا","an example","وَٱضْرِبْ لَهُم","أَصْحَـٰبَ ٱلْقَرْيَةِ إِذْ",123],["36:15:6",441,"مِّثْلُنَا","like us","أَنتُمْ إِلَّا بَشَرٌۭ","وَمَآ أَنزَلَ ٱلرَّحْمَـٰنُ",155],["36:42:4",443,"مِّثْلِهِۦ","(the) likes of it","وَخَلَقْنَا لَهُم مِّن","مَا يَرْكَبُونَ",155],["36:78:3",445,"مَثَلًۭا","an example","وَضَرَبَ لَنَا","وَنَسِىَ خَلْقَهُۥ ۖ قَالَ",123],["36:81:10",445,"مِثْلَهُم ۚ","(the) like of them","عَلَىٰٓ أَن يَخْلُقَ","بَلَىٰ وَهُوَ ٱلْخَلَّـٰقُ",155],["37:61:1",448,"لِمِثْلِ","For (the) like","","هَـٰذَا فَلْيَعْمَلِ ٱلْعَـٰمِلُونَ",155],["38:43:4",456,"وَمِثْلَهُم","and a like of them","وَوَهَبْنَا لَهُۥٓ أَهْلَهُۥ","مَّعَهُمْ رَحْمَةًۭ مِّنَّا",155],["39:27:9",461,"مَثَلٍۢ","example","ٱلْقُرْءَانِ مِن كُلِّ","لَّعَلَّهُمْ يَتَذَكَّرُونَ",123],["39:29:3",461,"مَثَلًۭا","an example","ضَرَبَ ٱللَّهُ","رَّجُلًۭا فِيهِ شُرَكَآءُ",123],["39:29:13",461,"مَثَلًا ۚ","(in) comparison","لِّرَجُلٍ هَلْ يَسْتَوِيَانِ","ٱلْحَمْدُ لِلَّهِ ۚ بَلْ",123],["39:47:9",463,"وَمِثْلَهُۥ","and (the) like of it","فِى ٱلْأَرْضِ جَمِيعًۭا","مَعَهُۥ لَٱفْتَدَوْا۟ بِهِۦ",155],["40:30:8",470,"مِّثْلَ","like","إِنِّىٓ أَخَافُ عَلَيْكُم","يَوْمِ ٱلْأَحْزَابِ",155],["40:31:1",470,"مِثْلَ","Like","","دَأْبِ قَوْمِ نُوحٍۢ",155],["40:40:7",471,"مِثْلَهَا ۖ","(the) like thereof","فَلَا يُجْزَىٰٓ إِلَّا","وَمَنْ عَمِلَ صَـٰلِحًۭا",155],["41:6:5",477,"مِّثْلُكُمْ","like you","إِنَّمَآ أَنَا۠ بَشَرٌۭ","يُوحَىٰٓ إِلَىَّ أَنَّمَآ",155],["41:13:6",478,"مِّثْلَ","like","فَقُلْ أَنذَرْتُكُمْ صَـٰعِقَةًۭ","صَـٰعِقَةِ عَادٍۢ وَثَمُودَ",155],["42:11:15",484,"كَمِثْلِهِۦ","like Him","يَذْرَؤُكُمْ فِيهِ ۚ لَيْسَ","شَىْءٌۭ ۖ وَهُوَ ٱلسَّمِيعُ",155],["42:40:4",487,"مِّثْلُهَا ۖ","like it","وَجَزَٰٓؤُا۟ سَيِّئَةٍۢ سَيِّئَةٌۭ","فَمَنْ عَفَا وَأَصْلَحَ",155],["43:8:6",489,"مَثَلُ","(the) example","مِنْهُم بَطْشًۭا وَمَضَىٰ","ٱلْأَوَّلِينَ",123],["43:17:7",490,"مَثَلًۭا","(as) a likeness","بِمَا ضَرَبَ لِلرَّحْمَـٰنِ","ظَلَّ وَجْهُهُۥ مُسْوَدًّۭا",123],["43:56:3",493,"وَمَثَلًۭا","and an example","فَجَعَلْنَـٰهُمْ سَلَفًۭا","لِّلْـَٔاخِرِينَ",123],["43:57:5",493,"مَثَلًا","(as) an example","ضُرِبَ ٱبْنُ مَرْيَمَ","إِذَا قَوْمُكَ مِنْهُ",123],["43:59:8",493,"مَثَلًۭا","an example","أَنْعَمْنَا عَلَيْهِ وَجَعَلْنَـٰهُ","لِّبَنِىٓ إِسْرَٰٓءِيلَ",123],["46:10:16",503,"مِثْلِهِۦ","(the) like thereof","بَنِىٓ إِسْرَٰٓءِيلَ عَلَىٰ","فَـَٔامَنَ وَٱسْتَكْبَرْتُمْ ۖ إِنَّ",155],["47:3:18",507,"أَمْثَـٰلَهُمْ","their similitudes","يَضْرِبُ ٱللَّهُ لِلنَّاسِ","",123],["47:10:16",507,"أَمْثَـٰلُهَا","its likeness","ٱللَّهُ عَلَيْهِمْ ۖ وَلِلْكَـٰفِرِينَ","",123],["47:15:1",508,"مَّثَلُ","A parable","","ٱلْجَنَّةِ ٱلَّتِى وُعِدَ",123],["47:38:29",510,"أَمْثَـٰلَكُم","(the) likes of you","ثُمَّ لَا يَكُونُوٓا۟","",123],["48:29:26",515,"مَثَلُهُمْ","(is) their similitude","أَثَرِ ٱلسُّجُودِ ۚ ذَٰلِكَ","فِى ٱلتَّوْرَىٰةِ ۚ وَمَثَلُهُمْ",123],["48:29:29",515,"وَمَثَلُهُمْ","And their similitude","مَثَلُهُمْ فِى ٱلتَّوْرَىٰةِ ۚ","فِى ٱلْإِنجِيلِ كَزَرْعٍ",123],["51:23:6",521,"مِّثْلَ","(just) as","وَٱلْأَرْضِ إِنَّهُۥ لَحَقٌّۭ","مَآ أَنَّكُمْ تَنطِقُونَ",155],["51:59:5",523,"مِّثْلَ","like","لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًۭا","ذَنُوبِ أَصْحَـٰبِهِمْ فَلَا",155],["52:34:3",525,"مِّثْلِهِۦٓ","like it","فَلْيَأْتُوا۟ بِحَدِيثٍۢ","إِن كَانُوا۟ صَـٰدِقِينَ",155],["56:23:1",535,"كَأَمْثَـٰلِ","Like","","ٱللُّؤْلُؤِ ٱلْمَكْنُونِ",123],["56:61:4",536,"أَمْثَـٰلَكُمْ","your likeness[es]","عَلَىٰٓ أَن نُّبَدِّلَ","وَنُنشِئَكُمْ فِى مَا",123],["57:20:14",540,"كَمَثَلِ","like (the) example","فِى ٱلْأَمْوَٰلِ وَٱلْأَوْلَـٰدِ ۖ","غَيْثٍ أَعْجَبَ ٱلْكُفَّارَ",123],["59:15:1",547,"كَمَثَلِ","Like (the) example","","ٱلَّذِينَ مِن قَبْلِهِمْ",123],["59:16:1",547,"كَمَثَلِ","Like (the) example","","ٱلشَّيْطَـٰنِ إِذْ قَالَ",123],["59:21:14",548,"ٱلْأَمْثَـٰلُ","examples","خَشْيَةِ ٱللَّهِ ۚ وَتِلْكَ","نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ",123],["60:11:13",550,"مِّثْلَ","(the) like","ٱلَّذِينَ ذَهَبَتْ أَزْوَٰجُهُم","مَآ أَنفَقُوا۟ ۚ وَٱتَّقُوا۟",155],["62:5:1",553,"مَثَلُ","(The) likeness","","ٱلَّذِينَ حُمِّلُوا۟ ٱلتَّوْرَىٰةَ",123],["62:5:8",553,"كَمَثَلِ","(is) like","ثُمَّ لَمْ يَحْمِلُوهَا","ٱلْحِمَارِ يَحْمِلُ أَسْفَارًۢا ۚ",123],["62:5:13",553,"مَثَلُ","(the) example","يَحْمِلُ أَسْفَارًۢا ۚ بِئْسَ","ٱلْقَوْمِ ٱلَّذِينَ كَذَّبُوا۟",123],["65:12:8",559,"مِثْلَهُنَّ","(the) like of them","سَمَـٰوَٰتٍۢ وَمِنَ ٱلْأَرْضِ","يَتَنَزَّلُ ٱلْأَمْرُ بَيْنَهُنَّ",155],["66:10:3",561,"مَثَلًۭا","an example","ضَرَبَ ٱللَّهُ","لِّلَّذِينَ كَفَرُوا۟ ٱمْرَأَتَ",123],["66:11:3",561,"مَثَلًۭا","an example","وَضَرَبَ ٱللَّهُ","لِّلَّذِينَ ءَامَنُوا۟ ٱمْرَأَتَ",123],["74:31:38",576,"مَثَلًۭا ۚ","example","أَرَادَ ٱللَّهُ بِهَـٰذَا","كَذَٰلِكَ يُضِلُّ ٱللَّهُ",123],["76:28:8",580,"أَمْثَـٰلَهُمْ","their likeness[es]","وَإِذَا شِئْنَا بَدَّلْنَآ","تَبْدِيلًا",123],["89:8:4",593,"مِثْلُهَا","like them","ٱلَّتِى لَمْ يُخْلَقْ","فِى ٱلْبِلَـٰدِ",155]]