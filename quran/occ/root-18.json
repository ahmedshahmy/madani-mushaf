ونَ","you do","كُنتُمْ ۚ وَٱللَّهُ بِمَا","بَصِيرٌۭ",44],["57:10:36",538,"تَعْمَلُونَ","you do","ٱلْحُسْنَىٰ ۚ وَٱللَّهُ بِمَا","خَبِيرٌۭ",44],["58:3:20",542,"تَعْمَلُونَ","you do","بِهِۦ ۚ وَٱللَّهُ بِمَا","خَبِيرٌۭ",44],["58:6:7",542,"عَمِلُوٓا۟ ۚ","they did","جَمِيعًۭا فَيُنَبِّئُهُم بِمَا","أَحْصَىٰهُ ٱللَّهُ وَنَسُوهُ ۚ",44],["58:7:40",543,"عَمِلُوا۟","they did","ثُمَّ يُنَبِّئُهُم بِمَا","يَوْمَ ٱلْقِيَـٰمَةِ ۚ إِنَّ",44],["58:11:29",543,"تَعْمَلُونَ","you do","دَرَجَـٰتٍۢ ۚ وَٱللَّهُ بِمَا","خَبِيرٌۭ",44],["58:13:24",544,"تَعْمَلُونَ","you do","وَٱللَّهُ خَبِيرٌۢ بِمَا","",44],["58:15:10",544,"يَعْمَلُونَ","do","سَآءَ مَا كَانُوا۟","",44],["59:18:17",548,"تَعْمَلُونَ","you do","ٱللَّهَ خَبِيرٌۢ بِمَا","",44],["60:3:12",549,"تَعْمَلُونَ","you do","بَيْنَكُمْ ۚ وَٱللَّهُ بِمَا","بَصِيرٌۭ",44],["62:8:18",553,"تَعْمَلُونَ","do","فَيُنَبِّئُكُم بِمَا كُنتُمْ","",44],["63:2:12",554,"يَعْمَلُونَ","do","سَآءَ مَا كَانُوا۟","",44],["63:11:11",555,"تَعْمَلُونَ","you do","وَٱللَّهُ خَبِيرٌۢ بِمَا","",44],["64:2:10",556,"تَعْمَلُونَ","you do","مُّؤْمِنٌۭ ۚ وَٱللَّهُ بِمَا","بَصِيرٌ",44],["64:7:14",556,"عَمِلْتُمْ ۚ","you did","ثُمَّ لَتُنَبَّؤُنَّ بِمَا","وَذَٰلِكَ عَلَى ٱللَّهِ",44],["64:8:9",556,"تَعْمَلُونَ","you do","أَنزَلْنَا ۚ وَٱللَّهُ بِمَا","خَبِيرٌۭ",44],["64:9:11",556,"وَيَعْمَلْ","and does","وَمَن يُؤْمِنۢ بِٱللَّهِ","صَـٰلِحًۭا يُكَفِّرْ عَنْهُ",44],["65:11:10",559,"وَعَمِلُوا۟","and do","لِّيُخْرِجَ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ مِنَ ٱلظُّلُمَـٰتِ",44],["65:11:19",559,"وَيَعْمَلْ","and does","وَمَن يُؤْمِنۢ بِٱللَّهِ","صَـٰلِحًۭا يُدْخِلْهُ جَنَّـٰتٍۢ",44],["66:7:11",560,"تَعْمَلُونَ","do","تُجْزَوْنَ مَا كُنتُمْ","",44],["66:11:20",561,"وَعَمَلِهِۦ","and his deeds","وَنَجِّنِى مِن فِرْعَوْنَ","وَنَجِّنِى مِنَ ٱلْقَوْمِ",170],["67:2:8",562,"عَمَلًۭا ۚ","(in) deed","لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ","وَهُوَ ٱلْعَزِيزُ ٱلْغَفُورُ",170],["77:43:6",581,"تَعْمَلُونَ","do","هَنِيٓـًٔۢا بِمَا كُنتُمْ","",44],["84:25:4",590,"وَعَمِلُوا۟","and do","إِلَّا ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ",44],["85:11:4",590,"وَعَمِلُوا۟","and do","إِنَّ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتٌۭ",44],["88:3:1",592,"عَامِلَةٌۭ","Laboring","","نَّاصِبَةٌۭ",3097],["95:6:4",597,"وَعَمِلُوا۟","and do","إِلَّا ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ",44],["98:7:4",599,"وَعَمِلُوا۟","and do","إِنَّ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ هُمْ",44],["99:6:6",599,"أَعْمَـٰلَهُمْ","their deeds","ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟","",170],["99:7:2",599,"يَعْمَلْ","does","فَمَن","مِثْقَالَ ذَرَّةٍ خَيْرًۭا",44],["99:8:2",599,"يَعْمَلْ","does","وَمَن","مِثْقَالَ ذَرَّةٍۢ شَرًّۭا",44],["103:3:4",601,"وَعَمِلُوا۟","and do","إِلَّا ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ",44]]