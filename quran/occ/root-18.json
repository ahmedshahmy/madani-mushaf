5,"عَمَلٍ","deed","وَلَا تَعْمَلُونَ مِنْ","إِلَّا كُنَّا عَلَيْكُمْ",170],["10:81:16",218,"عَمَلَ","the work","ٱللَّهَ لَا يُصْلِحُ","ٱلْمُفْسِدِينَ",170],["11:7:16",222,"عَمَلًۭا ۗ","(in) deed","لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ","وَلَئِن قُلْتَ إِنَّكُم",170],["11:11:4",222,"وَعَمِلُوا۟","and do","إِلَّا ٱلَّذِينَ صَبَرُوا۟","ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ لَهُم",44],["11:15:9",223,"أَعْمَـٰلَهُمْ","(for) their deeds","وَزِينَتَهَا نُوَفِّ إِلَيْهِمْ","فِيهَا وَهُمْ فِيهَا",170],["11:16:16",223,"يَعْمَلُونَ","do","وَبَـٰطِلٌۭ مَّا كَانُوا۟","",44],["11:23:4",224,"وَعَمِلُوا۟","and do","إِنَّ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ وَأَخْبَتُوٓا۟ إِلَىٰ",44],["11:46:8",227,"عَمَلٌ","(his) deed","مِنْ أَهْلِكَ ۖ إِنَّهُۥ","غَيْرُ صَـٰلِحٍۢ ۖ فَلَا",170],["11:78:8",230,"يَعْمَلُونَ","doing","وَمِن قَبْلُ كَانُوا۟","ٱلسَّيِّـَٔاتِ ۚ قَالَ يَـٰقَوْمِ",44],["11:92:14",232,"تَعْمَلُونَ","you do","إِنَّ رَبِّى بِمَا","مُحِيطٌۭ",44],["11:93:2",232,"ٱعْمَلُوا۟","Work","وَيَـٰقَوْمِ","عَلَىٰ مَكَانَتِكُمْ إِنِّى",44],["11:93:6",232,"عَـٰمِلٌۭ ۖ","working","عَلَىٰ مَكَانَتِكُمْ إِنِّى","سَوْفَ تَعْلَمُونَ مَن",717],["11:111:6",234,"أَعْمَـٰلَهُمْ ۚ","their deeds","لَّمَّا لَيُوَفِّيَنَّهُمْ رَبُّكَ","إِنَّهُۥ بِمَا يَعْمَلُونَ",170],["11:111:9",234,"يَعْمَلُونَ","they do","أَعْمَـٰلَهُمْ ۚ إِنَّهُۥ بِمَا","خَبِيرٌۭ",44],["11:112:11",234,"تَعْمَلُونَ","you do","تَطْغَوْا۟ ۚ إِنَّهُۥ بِمَا","بَصِيرٌۭ",44],["11:121:5",235,"ٱعْمَلُوا۟","Work","لِّلَّذِينَ لَا يُؤْمِنُونَ","عَلَىٰ مَكَانَتِكُمْ إِنَّا",44],["11:121:9",235,"عَـٰمِلُونَ","(are also) working","عَلَىٰ مَكَانَتِكُمْ إِنَّا","",717],["11:123:16",235,"تَعْمَلُونَ","you do","رَبُّكَ بِغَـٰفِلٍ عَمَّا","",44],["12:19:16",237,"يَعْمَلُونَ","they do","وَٱللَّهُ عَلِيمٌۢ بِمَا","",44],["12:69:16",243,"يَعْمَلُونَ","do","تَبْتَئِسْ بِمَا كَانُوا۟","",44],["13:29:3",253,"وَعَمِلُوا۟","and did","ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ طُوبَىٰ لَهُمْ",44],["14:18:5",257,"أَعْمَـٰلُهُمْ","their deeds","ٱلَّذِينَ كَفَرُوا۟ بِرَبِّهِمْ ۖ","كَرَمَادٍ ٱشْتَدَّتْ بِهِ",170],["14:23:4",258,"وَعَمِلُوا۟","and did","وَأُدْخِلَ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ جَنَّـٰتٍۢ تَجْرِى",44],["14:42:6",260,"يَعْمَلُ","do","ٱللَّهَ غَـٰفِلًا عَمَّا","ٱلظَّـٰلِمُونَ ۚ إِنَّمَا يُؤَخِّرُهُمْ",44],["15:93:3",267,"يَعْمَلُونَ","do","عَمَّا كَانُوا۟","",44],["16:28:10",270,"نَعْمَلُ","doing","ٱلسَّلَمَ مَا كُنَّا","مِن سُوٓءٍۭ ۚ بَلَىٰٓ",44],["16:28:19",270,"تَعْمَلُونَ","do","عَلِيمٌۢ بِمَا كُنتُمْ","",44],["16:32:12",270,"تَعْمَلُونَ","do","ٱلْجَنَّةَ بِمَا كُنتُمْ","",44],["16:34:4",270,"عَمِلُوا۟","they did","فَأَصَابَهُمْ سَيِّـَٔاتُ مَا","وَحَاقَ بِهِم مَّا",44],["16:63:11",273,"أَعْمَـٰلَهُمْ","their deeds","فَزَيَّنَ لَهُمُ ٱلشَّيْطَـٰنُ","فَهُوَ وَلِيُّهُمُ ٱلْيَوْمَ",170],["16:93:17",277,"تَعْمَلُونَ","do","وَلَتُسْـَٔلُنَّ عَمَّا كُنتُمْ","",44],["16:96:15",278,"يَعْمَلُونَ","do","بِأَحْسَنِ مَا كَانُوا۟","",44],["16:97:2",278,"عَمِلَ","does","مَنْ","صَـٰلِحًۭا مِّن ذَكَرٍ",44],["16:97:18",278,"يَعْمَلُونَ","do","بِأَحْسَنِ مَا كَانُوا۟","",44],["16:111:12",280,"عَمِلَتْ","it did","كُلُّ نَفْسٍۢ مَّا","وَهُمْ لَا يُظْلَمُونَ",44],["16:119:5",281,"عَمِلُوا۟","did","إِنَّ رَبَّكَ لِلَّذِينَ","ٱلسُّوٓءَ بِجَهَـٰلَةٍۢ ثُمَّ",44],["17:9:11",283,"يَعْمَلُونَ","do","وَيُبَشِّرُ ٱلْمُؤْمِنِينَ ٱلَّذِينَ","ٱلصَّـٰلِحَـٰتِ أَنَّ لَهُمْ",44],["17:84:3",290,"يَعْمَلُ","works","قُلْ كُلٌّۭ","عَلَىٰ شَاكِلَتِهِۦ فَرَبُّكُمْ",44],["18:2:10",293,"يَعْمَلُونَ","do","وَيُبَشِّرَ ٱلْمُؤْمِنِينَ ٱلَّذِينَ","ٱلصَّـٰلِحَـٰتِ أَنَّ لَهُمْ",44],["18:7:11",294,"عَمَلًۭا","(in) deed","لِنَبْلُوَهُمْ أَيُّهُمْ أَحْسَنُ","",170],["18:30:4",297,"وَعَمِلُوا۟","and did","إِنَّ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ إِنَّا لَا",44],["18:30:12",297,"عَمَلًا","deeds","أَجْرَ مَنْ أَحْسَنَ","",170],["18:49:22",299,"عَمِلُوا۟","they did","أَحْصَىٰهَا ۚ وَوَجَدُوا۟ مَا","حَاضِرًۭا ۗ وَلَا يَظْلِمُ",44],["18:79:5",302,"يَعْمَلُونَ","working","ٱلسَّفِينَةُ فَكَانَتْ لِمَسَـٰكِينَ","فِى ٱلْبَحْرِ فَأَرَدتُّ",44],["18:88:4",303,"وَعَمِلَ","and does","وَأَمَّا مَنْ ءَامَنَ","صَـٰلِحًۭا فَلَهُۥ جَزَآءً",44],["18:103:5",304,"أَعْمَـٰلًا","(as to their) deeds","هَلْ نُنَبِّئُكُم بِٱلْأَخْسَرِينَ","",170],["18:105:8",304,"أَعْمَـٰلُهُمْ","their deeds","رَبِّهِمْ وَلِقَآئِهِۦ فَحَبِطَتْ","فَلَا نُقِيمُ لَهُمْ",170],["18:107:4",304,"وَعَمِلُوا۟","and did","إِنَّ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ كَانَتْ لَهُمْ",44],["18:110:17",304,"فَلْيَعْمَلْ","let him do","يَرْجُوا۟ لِقَآءَ رَبِّهِۦ","عَمَلًۭا صَـٰلِحًۭا وَلَا",44],["18:110:18",304,"عَمَلًۭا","deeds","لِقَآءَ رَبِّهِۦ فَلْيَعْمَلْ","صَـٰلِحًۭا وَلَا يُشْرِكْ",170],["19:60:5",309,"وَعَمِلَ","and did","مَن تَابَ وَءَامَنَ","صَـٰلِحًۭا فَأُو۟لَـٰٓئِكَ يَدْخُلُونَ",44],["19:96:4",312,"وَعَمِلُوا۟","and did","إِنَّ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ سَيَجْعَلُ لَهُمُ",44],["20:75:5",316,"عَمِلَ","he has done","يَأْتِهِۦ مُؤْمِنًۭا قَدْ","ٱلصَّـٰلِحَـٰتِ فَأُو۟لَـٰٓئِكَ لَهُمُ",44],["20:82:6",317,"وَعَمِلَ","and does","لِّمَن تَابَ وَءَامَنَ","صَـٰلِحًۭا ثُمَّ ٱهْتَدَىٰ",44],["20:112:2",319,"يَعْمَلْ","does","وَمَن","مِنَ ٱلصَّـٰلِحَـٰتِ وَهُوَ",44],["21:27:6",324,"يَعْمَلُونَ","act","بِٱلْقَوْلِ وَهُم بِأَمْرِهِۦ","",44],["21:74:10",328,"تَّعْمَلُ","doing","ٱلْقَرْيَةِ ٱلَّتِى كَانَت","ٱلْخَبَـٰٓئِثَ ۗ إِنَّهُمْ كَانُوا۟",44],["21:82:6",329,"وَيَعْمَلُونَ","and would do","مَن يَغُوصُونَ لَهُۥ","عَمَلًۭا دُونَ ذَٰلِكَ ۖ",44],["21:82:7",329,"عَمَلًۭا","work","يَغُوصُونَ لَهُۥ وَيَعْمَلُونَ","دُونَ ذَٰلِكَ ۖ وَكُنَّا",170],["21:94:2",330,"يَعْمَلْ","does","فَمَن","مِنَ ٱلصَّـٰلِحَـٰتِ وَهُوَ",44],["22:14:6",333,"وَعَمِلُوا۟","and do","يُدْخِلُ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ جَنَّـٰتٍۢ تَجْرِى",44],["22:23:6",334,"وَعَمِلُوا۟","and do","يُدْخِلُ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ جَنَّـٰتٍۢ تَجْرِى",44],["22:50:3",338,"وَعَمِلُوا۟","and do","فَٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ لَهُم مَّغْفِرَةٌۭ",44],["22:56:8",339,"وَعَمِلُوا۟","and did","بَيْنَهُمْ ۚ فَٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ فِى جَنَّـٰتِ",44],["22:68:7",340,"تَعْمَلُونَ","you do","ٱللَّهُ أَعْلَمُ بِمَا","",44],["23:51:6",345,"وَٱعْمَلُوا۟","and do","كُلُوا۟ مِنَ ٱلطَّيِّبَـٰتِ","صَـٰلِحًا ۖ إِنِّى بِمَا",44],["23:51:10",345,"تَعْمَلُونَ","you do","صَـٰلِحًا ۖ إِنِّى بِمَا","عَلِيمٌۭ",44],["23:63:8",346,"أَعْمَـٰلٌۭ","(are) deeds","مِّنْ هَـٰذَا وَلَهُمْ","مِّن دُونِ ذَٰلِكَ",170],["23:63:14",346,"عَـٰمِلُونَ","(are) doers","ذَٰلِكَ هُمْ لَهَا","",717],["23:100:2",348,"أَعْمَلُ","do","لَعَلِّىٓ","صَـٰلِحًۭا فِيمَا تَرَكْتُ ۚ",44],["24:24:9",352,"يَعْمَلُونَ","(to) do","وَأَرْجُلُهُم بِمَا كَانُوا۟","",44],["24:28:21",353,"تَعْمَلُونَ","you do","لَكُمْ ۚ وَٱللَّهُ بِمَا","عَلِيمٌۭ",44],["24:38:5",355,"عَمِلُوا۟","they did","ٱللَّهُ أَحْسَنَ مَا","وَيَزِيدَهُم مِّن فَضْلِهِۦ ۗ",44],["24:39:3",355,"أَعْمَـٰلُهُمْ","their deeds","وَٱلَّذِينَ كَفَرُوٓا۟","كَسَرَابٍۭ بِقِيعَةٍۢ يَحْسَبُهُ",170],["24:53:17",356,"تَعْمَلُونَ","you do","ٱللَّهَ خَبِيرٌۢ بِمَا","",44],["24:55:6",357,"وَعَمِلُوا۟","and do","ٱلَّذِينَ ءَامَنُوا۟ مِنكُمْ","ٱلصَّـٰلِحَـٰتِ لَيَسْتَخْلِفَنَّهُمْ فِى",44],["24:64:18",359,"عَمِلُوا۟ ۗ","they did","إِلَيْهِ فَيُنَبِّئُهُم بِمَا","وَٱللَّهُ بِكُلِّ شَىْءٍ",44],["25:23:4",362,"عَمِلُوا۟","they did","وَقَدِمْنَآ إِلَىٰ مَا","مِنْ عَمَلٍۢ فَجَعَلْنَـٰهُ",44],["25:23:6",362,"عَمَلٍۢ","(the) deed(s)","مَا عَمِلُوا۟ مِنْ","فَجَعَلْنَـٰهُ هَبَآءًۭ مَّنثُورًا",170],["25:70:5",366,"وَعَمِلَ","and does","مَن تَابَ وَءَامَنَ","عَمَلًۭا صَـٰلِحًۭا فَأُو۟لَـٰٓئِكَ",44],["25:70:6",366,"عَمَلًۭا","righteous deeds","تَابَ وَءَامَنَ وَعَمِلَ","صَـٰلِحًۭا فَأُو۟لَـٰٓئِكَ يُبَدِّلُ",170],["25:71:3",366,"وَعَمِلَ","and does","وَمَن تَابَ","صَـٰلِحًۭا فَإِنَّهُۥ يَتُوبُ",44],["26:112:6",372,"يَعْمَلُونَ","(to) do","عِلْمِى بِمَا كَانُوا۟","",44],["26:168:3",374,"لِعَمَلِكُم","(of) your deed","قَالَ إِنِّى","مِّنَ ٱلْقَالِينَ",170],["26:169:5",374,"يَعْمَلُونَ","they do","نَجِّنِى وَأَهْلِى مِمَّا","",44],["26:188:5",375,"تَعْمَلُونَ","you do","رَبِّىٓ أَعْلَمُ بِمَا","",44],["26:216:7",376,"تَعْمَلُونَ","you do","إِنِّى بَرِىٓءٌ