ُوا۟","and do","وَٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ لَنُبَوِّئَنَّهُم مِّنَ",44],["29:58:17",403,"ٱلْعَـٰمِلِينَ","(of) the workers","فِيهَا ۚ نِعْمَ أَجْرُ","",717],["30:15:4",405,"وَعَمِلُوا۟","and did","فَأَمَّا ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ فَهُمْ فِى",44],["30:41:13",408,"عَمِلُوا۟","they have done","لِيُذِيقَهُم بَعْضَ ٱلَّذِى","لَعَلَّهُمْ يَرْجِعُونَ",44],["30:44:6",409,"عَمِلَ","does","فَعَلَيْهِ كُفْرُهُۥ ۖ وَمَنْ","صَـٰلِحًۭا فَلِأَنفُسِهِمْ يَمْهَدُونَ",44],["30:45:4",409,"وَعَمِلُوا۟","and do","لِيَجْزِىَ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ مِن فَضْلِهِۦٓ ۚ",44],["31:8:4",411,"وَعَمِلُوا۟","and do","إِنَّ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتُ",44],["31:15:29",412,"تَعْمَلُونَ","do","فَأُنَبِّئُكُم بِمَا كُنتُمْ","",44],["31:23:10",413,"عَمِلُوٓا۟ ۚ","they did","مَرْجِعُهُمْ فَنُنَبِّئُهُم بِمَا","إِنَّ ٱللَّهَ عَلِيمٌۢ",44],["31:29:24",414,"تَعْمَلُونَ","you do","وَأَنَّ ٱللَّهَ بِمَا","خَبِيرٌۭ",44],["32:12:13",416,"نَعْمَلْ","we will do","أَبْصَرْنَا وَسَمِعْنَا فَٱرْجِعْنَا","صَـٰلِحًا إِنَّا مُوقِنُونَ",44],["32:14:14",416,"تَعْمَلُونَ","do","ٱلْخُلْدِ بِمَا كُنتُمْ","",44],["32:17:13",416,"يَعْمَلُونَ","do","جَزَآءًۢ بِمَا كَانُوا۟","",44],["32:19:4",416,"وَعَمِلُوا۟","and do","أَمَّا ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ فَلَهُمْ جَنَّـٰتُ",44],["32:19:12",416,"يَعْمَلُونَ","do","نُزُلًۢا بِمَا كَانُوا۟","",44],["33:2:11",418,"تَعْمَلُونَ","you do","ٱللَّهَ كَانَ بِمَا","خَبِيرًۭا",44],["33:9:20",419,"تَعْمَلُونَ","you do","وَكَانَ ٱللَّهُ بِمَا","بَصِيرًا",44],["33:19:30",420,"أَعْمَـٰلَهُمْ ۚ","their deeds","يُؤْمِنُوا۟ فَأَحْبَطَ ٱللَّهُ","وَكَانَ ذَٰلِكَ عَلَى",170],["33:31:6",422,"وَتَعْمَلْ","and does","مِنكُنَّ لِلَّهِ وَرَسُولِهِۦ","صَـٰلِحًۭا نُّؤْتِهَآ أَجْرَهَا",44],["33:71:3",427,"أَعْمَـٰلَكُمْ","your deeds","يُصْلِحْ لَكُمْ","وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ ۗ",170],["34:4:4",428,"وَعَمِلُوا۟","and do","لِّيَجْزِىَ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ ۚ أُو۟لَـٰٓئِكَ لَهُم",44],["34:11:2",429,"ٱعْمَلْ","make","أَنِ","سَـٰبِغَـٰتٍۢ وَقَدِّرْ فِى",44],["34:11:7",429,"وَٱعْمَلُوا۟","and work","وَقَدِّرْ فِى ٱلسَّرْدِ ۖ","صَـٰلِحًا ۖ إِنِّى بِمَا",44],["34:11:11",429,"تَعْمَلُونَ","you do","صَـٰلِحًا ۖ إِنِّى بِمَا","بَصِيرٌۭ",44],["34:12:14",429,"يَعْمَلُ","worked","وَمِنَ ٱلْجِنِّ مَن","بَيْنَ يَدَيْهِ بِإِذْنِ",44],["34:13:1",429,"يَعْمَلُونَ","They worked","","لَهُۥ مَا يَشَآءُ",44],["34:13:12",429,"ٱعْمَلُوٓا۟","Work","كَٱلْجَوَابِ وَقُدُورٍۢ رَّاسِيَـٰتٍ ۚ","ءَالَ دَاوُۥدَ شُكْرًۭا ۚ",44],["34:25:9",431,"تَعْمَلُونَ","you do","وَلَا نُسْـَٔلُ عَمَّا","",44],["34:33:34",432,"يَعْمَلُونَ","do","إِلَّا مَا كَانُوا۟","",44],["34:37:12",432,"وَعَمِلَ","and does","إِلَّا مَنْ ءَامَنَ","صَـٰلِحًۭا فَأُو۟لَـٰٓئِكَ لَهُمْ",44],["34:37:19",432,"عَمِلُوا۟","they did","جَزَآءُ ٱلضِّعْفِ بِمَا","وَهُمْ فِى ٱلْغُرُفَـٰتِ",44],["35:7:8",435,"وَعَمِلُوا۟","and do","شَدِيدٌۭ ۖ وَٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ لَهُم مَّغْفِرَةٌۭ",44],["35:8:5",435,"عَمَلِهِۦ","(of) his deed","زُيِّنَ لَهُۥ سُوٓءُ","فَرَءَاهُ حَسَنًۭا ۖ فَإِنَّ",170],["35:10:12",435,"وَٱلْعَمَلُ","and the deed","يَصْعَدُ ٱلْكَلِمُ ٱلطَّيِّبُ","ٱلصَّـٰلِحُ يَرْفَعُهُۥ ۚ وَٱلَّذِينَ",170],["35:37:6",438,"نَعْمَلْ","we will do","فِيهَا رَبَّنَآ أَخْرِجْنَا","صَـٰلِحًا غَيْرَ ٱلَّذِى",44],["35:37:11",438,"نَعْمَلُ ۚ","(to) do","غَيْرَ ٱلَّذِى كُنَّا","أَوَلَمْ نُعَمِّرْكُم مَّا",44],["36:35:5",442,"عَمِلَتْهُ","made it","مِن ثَمَرِهِۦ وَمَا","أَيْدِيهِمْ ۖ أَفَلَا يَشْكُرُونَ",44],["36:54:11",443,"تَعْمَلُونَ","do","إِلَّا مَا كُنتُمْ","",44],["36:71:7",445,"عَمِلَتْ","have made","خَلَقْنَا لَهُم مِّمَّا","أَيْدِينَآ أَنْعَـٰمًۭا فَهُمْ",44],["37:39:6",447,"تَعْمَلُونَ","do","إِلَّا مَا كُنتُمْ","",44],["37:61:3",448,"فَلْيَعْمَلِ","let work","لِمِثْلِ هَـٰذَا","ٱلْعَـٰمِلُونَ",44],["37:61:4",448,"ٱلْعَـٰمِلُونَ","the workers","لِمِثْلِ هَـٰذَا فَلْيَعْمَلِ","",717],["37:96:4",449,"تَعْمَلُونَ","you make","وَٱللَّهُ خَلَقَكُمْ وَمَا","",44],["38:24:19",454,"وَعَمِلُوا۟","and do","إِلَّا ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ وَقَلِيلٌۭ مَّا",44],["38:28:5",455,"وَعَمِلُوا۟","and do","نَجْعَلُ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ كَٱلْمُفْسِدِينَ فِى",44],["39:7:27",459,"تَعْمَلُونَ ۚ","do","فَيُنَبِّئُكُم بِمَا كُنتُمْ","إِنَّهُۥ عَلِيمٌۢ بِذَاتِ",44],["39:35:6",462,"عَمِلُوا۟","they did","عَنْهُمْ أَسْوَأَ ٱلَّذِى","وَيَجْزِيَهُمْ أَجْرَهُم بِأَحْسَنِ",44],["39:35:12",462,"يَعْمَلُونَ","do","بِأَحْسَنِ ٱلَّذِى كَانُوا۟","",44],["39:39:3",462,"ٱعْمَلُوا۟","Work","قُلْ يَـٰقَوْمِ","عَلَىٰ مَكَانَتِكُمْ إِنِّى",44],["39:39:7",462,"عَـٰمِلٌۭ ۖ","working","عَلَىٰ مَكَانَتِكُمْ إِنِّى","فَسَوْفَ تَعْلَمُونَ",717],["39:65:11",465,"عَمَلُكَ","your deeds","لَئِنْ أَشْرَكْتَ لَيَحْبَطَنَّ","وَلَتَكُونَنَّ مِنَ ٱلْخَـٰسِرِينَ",170],["39:70:5",466,"عَمِلَتْ","it did","كُلُّ نَفْسٍۢ مَّا","وَهُوَ أَعْلَمُ بِمَا",44],["39:74:16",466,"ٱلْعَـٰمِلِينَ","(of) the workers","نَشَآءُ ۖ فَنِعْمَ أَجْرُ","",717],["40:37:14",471,"عَمَلِهِۦ","(of) his deed","زُيِّنَ لِفِرْعَوْنَ سُوٓءُ","وَصُدَّ عَنِ ٱلسَّبِيلِ ۚ",170],["40:40:2",471,"عَمِلَ","does","مَنْ","سَيِّئَةًۭ فَلَا يُجْزَىٰٓ",44],["40:40:9",471,"عَمِلَ","does","إِلَّا مِثْلَهَا ۖ وَمَنْ","صَـٰلِحًۭا مِّن ذَكَرٍ",44],["40:58:7",473,"وَعَمِلُوا۟","and do","وَٱلْبَصِيرُ وَٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ وَلَا ٱلْمُسِىٓءُ ۚ",44],["41:5:15",477,"فَٱعْمَلْ","So work","بَيْنِنَا وَبَيْنِكَ حِجَابٌۭ","إِنَّنَا عَـٰمِلُونَ",44],["41:5:17",477,"عَـٰمِلُونَ","(are) working","حِجَابٌۭ فَٱعْمَلْ إِنَّنَا","",717],["41:8:4",477,"وَعَمِلُوا۟","and do","إِنَّ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ",44],["41:20:12",478,"يَعْمَلُونَ","do","وَجُلُودُهُم بِمَا كَانُوا۟","",44],["41:22:20",479,"تَعْمَلُونَ","you do","يَعْلَمُ كَثِيرًۭا مِّمَّا","",44],["41:27:10",479,"يَعْمَلُونَ","do","أَسْوَأَ ٱلَّذِى كَانُوا۟","",44],["41:33:8",480,"وَعَمِلَ","and does","دَعَآ إِلَى ٱللَّهِ","صَـٰلِحًۭا وَقَالَ إِنَّنِى",44],["41:40:20",481,"ٱعْمَلُوا۟","Do","ءَامِنًۭا يَوْمَ ٱلْقِيَـٰمَةِ ۚ","مَا شِئْتُمْ ۖ إِنَّهُۥ",44],["41:40:25",481,"تَعْمَلُونَ","you do","شِئْتُمْ ۖ إِنَّهُۥ بِمَا","بَصِيرٌ",44],["41:46:2",481,"عَمِلَ","does","مَّنْ","صَـٰلِحًۭا فَلِنَفْسِهِۦ ۖ وَمَنْ",44],["41:50:28",482,"عَمِلُوا۟","they did","ٱلَّذِينَ كَفَرُوا۟ بِمَا","وَلَنُذِيقَنَّهُم مِّنْ عَذَابٍ",44],["42:15:23",484,"أَعْمَـٰلُنَا","our deeds","رَبُّنَا وَرَبُّكُمْ ۖ لَنَآ","وَلَكُمْ أَعْمَـٰلُكُمْ ۖ لَا",170],["42:15:25",484,"أَعْمَـٰلُكُمْ ۖ","your deeds","لَنَآ أَعْمَـٰلُنَا وَلَكُمْ","لَا حُجَّةَ بَيْنَنَا",170],["42:22:11",485,"وَعَمِلُوا۟","and do","بِهِمْ ۗ وَٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ فِى رَوْضَاتِ",44],["42:23:8",486,"وَعَمِلُوا۟","and do","عِبَادَهُ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ ۗ قُل لَّآ",44],["42:26:4",486,"وَعَمِلُوا۟","and do","وَيَسْتَجِيبُ ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ وَيَزِيدُهُم مِّن",44],["43:72:7",494,"تَعْمَلُونَ","do","أُورِثْتُمُوهَا بِمَا كُنتُمْ","",44],["45:15:2",500,"عَمِلَ","does","مَنْ","صَـٰلِحًۭا فَلِنَفْسِهِۦ ۖ وَمَنْ",44],["45:21:10",500,"وَعَمِلُوا۟","and did","نَّجْعَلَهُمْ كَٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ سَوَآءًۭ مَّحْيَاهُمْ",44],["45:28:14",501,"تَعْمَلُونَ","do","تُجْزَوْنَ مَا كُنتُمْ","",44],["45:29:11",501,"تَعْمَلُونَ","do","نَسْتَنسِخُ مَا كُنتُمْ","",44],["45:30:4",501,"وَعَمِلُوا۟","and did","فَأَمَّا ٱلَّذِينَ ءَامَنُوا۟","ٱلصَّـٰلِحَـٰتِ فَيُدْخِلُهُمْ رَبُّهُمْ",44],["45:33:5",502,"عَمِلُوا۟","they did","لَهُمْ سَيِّـَٔاتُ مَا","وَحَاقَ بِهِم مَّا",44],["46:14:9",503,"يَعْمَلُونَ","do","جَزَآءًۢ بِمَا كَانُوا۟","",44],["46:15:33",504,"أَعْمَلَ","I do","وَعَلَىٰ وَٰلِدَىَّ وَأَنْ","صَـٰلِحًۭا تَرْضَىٰهُ وَأَصْلِحْ",44],["46:16:7",504,"عَمِلُوا۟","they did","عَنْهُمْ أَحْسَنَ مَا","وَنَتَجَاوَزُ عَن سَيِّـَٔاتِهِمْ",44],["46:19:4",504,"عَمِلُوا۟ ۖ","they did","وَلِكُلٍّۢ دَرَجَـٰتٌۭ مِّمَّا","وَلِيُوَفِّيَهُمْ أَعْمَـٰلَهُمْ وَهُمْ",44],["46:19:6",504,"أَعْمَـٰلَهُمْ","(for) their deeds","مِّمَّا عَمِلُوا۟ ۖ وَلِيُوَفِّيَهُمْ","وَهُمْ لَا يُظْلَمُونَ",170],["47:1:8",507,"أَعْمَـٰلَهُمْ","their deeds","سَبِيلِ ٱللَّهِ أَضَلّ