[["11:23:6",224,"وَأَخْبَتُوٓا۟","and humble themselves","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","إِلَىٰ رَبِّهِمْ أُو۟لَـٰٓئِكَ",2206],["22:34:20",336,"ٱلْمُخْبِتِينَ","(to) the humble ones","فَلَهُۥٓ أَسْلِمُوا۟ ۗ وَبَشِّرِ","",3892],["22:54:11",338,"فَتُخْبِتَ","and may humbly submit","رَّبِّكَ فَيُؤْمِنُوا۟ بِهِۦ","لَهُۥ قُلُوبُهُمْ ۗ وَإِنَّ",2206]]