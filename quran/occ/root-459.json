[["4:157:22",103,"شَكٍّۢ","doubt","ٱخْتَلَفُوا۟ فِيهِ لَفِى","مِّنْهُ ۚ مَا لَهُم",613],["10:94:4",219,"شَكٍّۢ","doubt","فَإِن كُنتَ فِى","مِّمَّآ أَنزَلْنَآ إِلَيْكَ",613],["10:104:7",220,"شَكٍّۢ","doubt","إِن كُنتُمْ فِى","مِّن دِينِى فَلَآ",613],["11:62:17",228,"شَكٍّۢ","doubt","ءَابَآؤُنَا وَإِنَّنَا لَفِى","مِّمَّا تَدْعُونَآ إِلَيْهِ",613],["11:110:16",234,"شَكٍّۢ","doubt","بَيْنَهُمْ ۚ وَإِنَّهُمْ لَفِى","مِّنْهُ مُرِيبٍۢ",613],["14:9:33",256,"شَكٍّۢ","doubt","بِهِۦ وَإِنَّا لَفِى","مِّمَّا تَدْعُونَنَآ إِلَيْهِ",613],["14:10:5",256,"شَكٌّۭ","any doubt","رُسُلُهُمْ أَفِى ٱللَّهِ","فَاطِرِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ",613],["27:66:9",383,"شَكٍّۢ","doubt","بَلْ هُمْ فِى","مِّنْهَا ۖ بَلْ هُم",613],["34:21:16",430,"شَكٍّۢ ۗ","doubt","هُوَ مِنْهَا فِى","وَرَبُّكَ عَلَىٰ كُلِّ",613],["34:54:14",434,"شَكٍّۢ","doubt","إِنَّهُمْ كَانُوا۟ فِى","مُّرِيبٍۭ",613],["38:8:9",453,"شَكٍّۢ","doubt","بَلْ هُمْ فِى","مِّن ذِكْرِى ۖ بَل",613],["40:34:10",471,"شَكٍّۢ","doubt","فَمَا زِلْتُمْ فِى","مِّمَّا جَآءَكُم بِهِۦ ۖ",613],["41:45:16",481,"شَكٍّۢ","doubt","بَيْنَهُمْ ۚ وَإِنَّهُمْ لَفِى","مِّنْهُ مُرِيبٍۢ",613],["42:14:28",484,"شَكٍّۢ","doubt","مِنۢ بَعْدِهِمْ لَفِى","مِّنْهُ مُرِيبٍۢ",613],["44:9:4",496,"شَكٍّۢ","doubt","بَلْ هُمْ فِى","يَلْعَبُونَ",613]]