[["2:96:2",15,"أَحْرَصَ","(the) most greedy","وَلَتَجِدَنَّهُمْ","ٱلنَّاسِ عَلَىٰ حَيَوٰةٍۢ",2962],["4:129:8",99,"حَرَصْتُمْ ۖ","you desired","بَيْنَ ٱلنِّسَآءِ وَلَوْ","فَلَا تَمِيلُوا۟ كُلَّ",1779],["9:128:10",207,"حَرِيصٌ","(he is) concerned","عَلَيْهِ مَا عَنِتُّمْ","عَلَيْكُم بِٱلْمُؤْمِنِينَ رَءُوفٌۭ",3193],["12:103:5",247,"حَرَصْتَ","you desire","أَكْثَرُ ٱلنَّاسِ وَلَوْ","بِمُؤْمِنِينَ",1779],["16:37:2",271,"تَحْرِصْ","you desire","إِن","عَلَىٰ هُدَىٰهُمْ فَإِنَّ",1779]]