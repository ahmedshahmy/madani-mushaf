[["2:164:33",25,"دَآبَّةٍۢ","moving creature","فِيهَا مِن كُلِّ","وَتَصْرِيفِ ٱلرِّيَـٰحِ وَٱلسَّحَابِ",547],["6:38:3",132,"دَآبَّةٍۢ","any animal","وَمَا مِن","فِى ٱلْأَرْضِ وَلَا",547],["8:22:3",179,"ٱلدَّوَآبِّ","(of) the living creatures","۞ إِنَّ شَرَّ","عِندَ ٱللَّهِ ٱلصُّمُّ",547],["8:55:3",184,"ٱلدَّوَآبِّ","(of) the living creatures","إِنَّ شَرَّ","عِندَ ٱللَّهِ ٱلَّذِينَ",547],["11:6:3",222,"دَآبَّةٍۢ","moving creature","۞ وَمَا مِن","فِى ٱلْأَرْضِ إِلَّا",547],["11:56:9",228,"دَآبَّةٍ","of a moving creature","وَرَبِّكُم ۚ مَّا مِن","إِلَّا هُوَ ءَاخِذٌۢ",547],["16:49:10",272,"دَآبَّةٍۢ","moving creatures","فِى ٱلْأَرْضِ مِن","وَٱلْمَلَـٰٓئِكَةُ وَهُمْ لَا",547],["16:61:10",273,"دَآبَّةٍۢ","moving creature","تَرَكَ عَلَيْهَا مِن","وَلَـٰكِن يُؤَخِّرُهُمْ إِلَىٰٓ",547],["22:18:18",334,"وَٱلدَّوَآبُّ","and the moving creatures","وَٱلنُّجُومُ وَٱلْجِبَالُ وَٱلشَّجَرُ","وَكَثِيرٌۭ مِّنَ ٱلنَّاسِ ۖ",547],["24:45:4",356,"دَآبَّةٍۢ","moving creature","وَٱللَّهُ خَلَقَ كُلَّ","مِّن مَّآءٍۢ ۖ فَمِنْهُم",547],["27:82:7",384,"دَآبَّةًۭ","a creature","عَلَيْهِمْ أَخْرَجْنَا لَهُمْ","مِّنَ ٱلْأَرْضِ تُكَلِّمُهُمْ",547],["29:60:3",403,"دَآبَّةٍۢ","a creature","وَكَأَيِّن مِّن","لَّا تَحْمِلُ رِزْقَهَا",547],["31:10:17",411,"دَآبَّةٍۢ ۚ","creature","فِيهَا مِن كُلِّ","وَأَنزَلْنَا مِنَ ٱلسَّمَآءِ",547],["34:14:10",429,"دَآبَّةُ","a creature","عَلَىٰ مَوْتِهِۦٓ إِلَّا","ٱلْأَرْضِ تَأْكُلُ مِنسَأَتَهُۥ ۖ",547],["35:28:3",437,"وَٱلدَّوَآبِّ","and moving creatures","وَمِنَ ٱلنَّاسِ","وَٱلْأَنْعَـٰمِ مُخْتَلِفٌ أَلْوَٰنُهُۥ",547],["35:45:12",440,"دَآبَّةٍۢ","creature","عَلَىٰ ظَهْرِهَا مِن","وَلَـٰكِن يُؤَخِّرُهُمْ إِلَىٰٓ",547],["42:29:10",486,"دَآبَّةٍۢ ۚ","(the) creatures","بَثَّ فِيهِمَا مِن","وَهُوَ عَلَىٰ جَمْعِهِمْ",547],["45:4:6",499,"دَآبَّةٍ","(the) moving creatures","وَمَا يَبُثُّ مِن","ءَايَـٰتٌۭ لِّقَوْمٍۢ يُوقِنُونَ",547]]