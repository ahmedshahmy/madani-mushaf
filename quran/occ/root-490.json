[["2:260:15",44,"لِّيَطْمَئِنَّ","to satisfy","قَالَ بَلَىٰ وَلَـٰكِن","قَلْبِى ۖ قَالَ فَخُذْ",943],["3:126:7",66,"وَلِتَطْمَئِنَّ","and to reassure","إِلَّا بُشْرَىٰ لَكُمْ","قُلُوبُكُم بِهِۦ ۗ وَمَا",943],["4:103:11",95,"ٱطْمَأْنَنتُمْ","you are secure","وَعَلَىٰ جُنُوبِكُمْ ۚ فَإِذَا","فَأَقِيمُوا۟ ٱلصَّلَوٰةَ ۚ إِنَّ",943],["5:113:6",126,"وَتَطْمَئِنَّ","and satisfy","أَن نَّأْكُلَ مِنْهَا","قُلُوبُنَا وَنَعْلَمَ أَن",943],["8:10:6",178,"وَلِتَطْمَئِنَّ","and so that might be at rest","ٱللَّهُ إِلَّا بُشْرَىٰ","بِهِۦ قُلُوبُكُمْ ۚ وَمَا",943],["10:7:9",209,"وَٱطْمَأَنُّوا۟","and feel satisfied","وَرَضُوا۟ بِٱلْحَيَوٰةِ ٱلدُّنْيَا","بِهَا وَٱلَّذِينَ هُمْ",943],["13:28:3",252,"وَتَطْمَئِنُّ","and find satisfaction","ٱلَّذِينَ ءَامَنُوا۟","قُلُوبُهُم بِذِكْرِ ٱللَّهِ ۗ",943],["13:28:10",252,"تَطْمَئِنُّ","find satisfaction","أَلَا بِذِكْرِ ٱللَّهِ","ٱلْقُلُوبُ",943],["16:106:11",279,"مُطْمَئِنٌّۢ","(is) content","مَنْ أُكْرِهَ وَقَلْبُهُۥ","بِٱلْإِيمَـٰنِ وَلَـٰكِن مَّن",2487],["16:112:7",280,"مُّطْمَئِنَّةًۭ","and content","قَرْيَةًۭ كَانَتْ ءَامِنَةًۭ","يَأْتِيهَا رِزْقُهَا رَغَدًۭا",2536],["17:95:8",291,"مُطْمَئِنِّينَ","securely","ٱلْأَرْضِ مَلَـٰٓئِكَةٌۭ يَمْشُونَ","لَنَزَّلْنَا عَلَيْهِم مِّنَ",2487],["22:11:11",333,"ٱطْمَأَنَّ","he is content","فَإِنْ أَصَابَهُۥ خَيْرٌ","بِهِۦ ۖ وَإِنْ أَصَابَتْهُ",943],["89:27:3",594,"ٱلْمُطْمَئِنَّةُ","who is satisfied","يَـٰٓأَيَّتُهَا ٱلنَّفْسُ","",2536]]