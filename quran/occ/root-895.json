[["11:27:18",224,"أَرَاذِلُنَا","(are) the lowest of us","إِلَّا ٱلَّذِينَ هُمْ","بَادِىَ ٱلرَّأْىِ وَمَا",1480],["16:70:9",274,"أَرْذَلِ","the worst","مَّن يُرَدُّ إِلَىٰٓ","ٱلْعُمُرِ لِكَىْ لَا",1480],["22:5:48",332,"أَرْذَلِ","the most abject","مَّن يُرَدُّ إِلَىٰٓ","ٱلْعُمُرِ لِكَيْلَا يَعْلَمَ",1480],["26:111:5",371,"ٱلْأَرْذَلُونَ","the lowest","أَنُؤْمِنُ لَكَ وَٱتَّبَعَكَ","",1480]]