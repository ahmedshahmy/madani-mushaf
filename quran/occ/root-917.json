[["6:98:8",140,"وَمُسْتَوْدَعٌۭ ۗ","and a resting place","نَّفْسٍۢ وَٰحِدَةٍۢ فَمُسْتَقَرٌّۭ","قَدْ فَصَّلْنَا ٱلْـَٔايَـٰتِ",2508],["11:6:12",222,"وَمُسْتَوْدَعَهَا ۚ","and its place of storage","رِزْقُهَا وَيَعْلَمُ مُسْتَقَرَّهَا","كُلٌّۭ فِى كِتَـٰبٍۢ",2508],["33:48:5",424,"وَدَعْ","and disregard","تُطِعِ ٱلْكَـٰفِرِينَ وَٱلْمُنَـٰفِقِينَ","أَذَىٰهُمْ وَتَوَكَّلْ عَلَى",3368],["93:3:2",596,"وَدَّعَكَ","has forsaken you","مَا","رَبُّكَ وَمَا قَلَىٰ",4522]]