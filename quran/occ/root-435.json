[["2:61:41",9,"وَبَآءُو","and they drew on themselves","عَلَيْهِمُ ٱلذِّلَّةُ وَٱلْمَسْكَنَةُ","بِغَضَبٍۢ مِّنَ ٱللَّهِ ۗ",1165],["2:90:21",14,"فَبَآءُو","So they have drawn (on themselves)","يَشَآءُ مِنْ عِبَادِهِۦ ۖ","بِغَضَبٍ عَلَىٰ غَضَبٍۢ ۚ",1165],["3:112:14",64,"وَبَآءُو","And they incurred","وَحَبْلٍۢ مِّنَ ٱلنَّاسِ","بِغَضَبٍۢ مِّنَ ٱللَّهِ",1165],["3:121:5",65,"تُبَوِّئُ","to post","غَدَوْتَ مِنْ أَهْلِكَ","ٱلْمُؤْمِنِينَ مَقَـٰعِدَ لِلْقِتَالِ ۗ",1171],["3:162:6",71,"بَآءَ","draws","رِضْوَٰنَ ٱللَّهِ كَمَنۢ","بِسَخَطٍۢ مِّنَ ٱللَّهِ",1165],["5:29:4",112,"تَبُوٓأَ","you be laden","إِنِّىٓ أُرِيدُ أَن","بِإِثْمِى وَإِثْمِكَ فَتَكُونَ",1165],["7:74:8",160,"وَبَوَّأَكُمْ","and settled you","مِنۢ بَعْدِ عَادٍۢ","فِى ٱلْأَرْضِ تَتَّخِذُونَ",1171],["8:16:13",178,"بَآءَ","(he has) incurred","إِلَىٰ فِئَةٍۢ فَقَدْ","بِغَضَبٍۢ مِّنَ ٱللَّهِ",1165],["10:87:6",218,"تَبَوَّءَا","Settle","مُوسَىٰ وَأَخِيهِ أَن","لِقَوْمِكُمَا بِمِصْرَ بُيُوتًۭا",1674],["10:93:2",219,"بَوَّأْنَا","We settled","وَلَقَدْ","بَنِىٓ إِسْرَٰٓءِيلَ مُبَوَّأَ",1171],["10:93:5",219,"مُبَوَّأَ","(in) a settlement","بَوَّأْنَا بَنِىٓ إِسْرَٰٓءِيلَ","صِدْقٍۢ وَرَزَقْنَـٰهُم مِّنَ",3786],["12:56:6",242,"يَتَبَوَّأُ","to settle","لِيُوسُفَ فِى ٱلْأَرْضِ","مِنْهَا حَيْثُ يَشَآءُ ۚ",1674],["16:41:9",271,"لَنُبَوِّئَنَّهُمْ","surely We will give them position","بَعْدِ مَا ظُلِمُوا۟","فِى ٱلدُّنْيَا حَسَنَةًۭ ۖ",1171],["22:26:2",335,"بَوَّأْنَا","We assigned","وَإِذْ","لِإِبْرَٰهِيمَ مَكَانَ ٱلْبَيْتِ",1171],["29:58:5",403,"لَنُبَوِّئَنَّهُم","surely We will give them a place","ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ","مِّنَ ٱلْجَنَّةِ غُرَفًۭا",1171],["39:74:9",466,"نَتَبَوَّأُ","we may settle","وَعْدَهُۥ وَأَوْرَثَنَا ٱلْأَرْضَ","مِنَ ٱلْجَنَّةِ حَيْثُ",1674],["59:9:2",546,"تَبَوَّءُو","settled","وَٱلَّذِينَ","ٱلدَّارَ وَٱلْإِيمَـٰنَ مِن",1674]]