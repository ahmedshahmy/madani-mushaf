[["2:60:14",9,"قَدْ","Indeed","ٱثْنَتَا عَشْرَةَ عَيْنًۭا ۖ","عَلِمَ كُلُّ أُنَاسٍۢ",24],["2:65:1",10,"وَلَقَدْ","And indeed","","عَلِمْتُمُ ٱلَّذِينَ ٱعْتَدَوْا۟",24],["2:75:5",11,"وَقَدْ","while indeed","أَن يُؤْمِنُوا۟ لَكُمْ","كَانَ فَرِيقٌۭ مِّنْهُمْ",24],["2:87:1",13,"وَلَقَدْ","And indeed","","ءَاتَيْنَا مُوسَى ٱلْكِتَـٰبَ",24],["2:92:1",14,"۞ وَلَقَدْ","And indeed","","جَآءَكُم مُّوسَىٰ بِٱلْبَيِّنَـٰتِ",24],["2:99:1",15,"وَلَقَدْ","And indeed","","أَنزَلْنَآ إِلَيْكَ ءَايَـٰتٍۭ",24],["2:102:57",16,"وَلَقَدْ","And indeed","يَضُرُّهُمْ وَلَا يَنفَعُهُمْ ۚ","عَلِمُوا۟ لَمَنِ ٱشْتَرَىٰهُ",24],["2:108:15",17,"فَقَدْ","so certainly","يَتَبَدَّلِ ٱلْكُفْرَ بِٱلْإِيمَـٰنِ","ضَلَّ سَوَآءَ ٱلسَّبِيلِ",24],["2:118:20",18,"قَدْ","Indeed","قَوْلِهِمْ ۘ تَشَـٰبَهَتْ قُلُوبُهُمْ ۗ","بَيَّنَّا ٱلْـَٔايَـٰتِ لِقَوْمٍۢ",24],["2:130:10",20,"وَلَقَدِ","And indeed","مَن سَفِهَ نَفْسَهُۥ ۚ","ٱصْطَفَيْنَـٰهُ فِى ٱلدُّنْيَا ۖ",24],["2:134:3",20,"قَدْ","(which)","تِلْكَ أُمَّةٌۭ","خَلَتْ ۖ لَهَا مَا",24],["2:137:7",21,"فَقَدِ","then indeed","مَآ ءَامَنتُم بِهِۦ","ٱهْتَدَوا۟ ۖ وَّإِن تَوَلَّوْا۟",24],["2:141:3",21,"قَدْ","(which)","تِلْكَ أُمَّةٌۭ","خَلَتْ ۖ لَهَا مَا",24],["2:144:1",22,"قَدْ","Indeed","","نَرَىٰ تَقَلُّبَ وَجْهِكَ",24],["2:231:18",37,"فَقَدْ","then indeed","وَمَن يَفْعَلْ ذَٰلِكَ","ظَلَمَ نَفْسَهُۥ ۚ وَلَا",24],["2:237:7",38,"وَقَدْ","while already","قَبْلِ أَن تَمَسُّوهُنَّ","فَرَضْتُمْ لَهُنَّ فَرِيضَةًۭ",24],["2:246:39",40,"وَقَدْ","while surely","فِى سَبِيلِ ٱللَّهِ","أُخْرِجْنَا مِن دِيَـٰرِنَا",24],["2:247:6",40,"قَدْ","(has) surely","نَبِيُّهُمْ إِنَّ ٱللَّهَ","بَعَثَ لَكُمْ طَالُوتَ",24],["2:256:5",42,"قَد","Surely","إِكْرَاهَ فِى ٱلدِّينِ ۖ","تَّبَيَّنَ ٱلرُّشْدُ مِنَ",24],["2:256:15",42,"فَقَدِ","then surely","بِٱلطَّـٰغُوتِ وَيُؤْمِنۢ بِٱللَّهِ","ٱسْتَمْسَكَ بِٱلْعُرْوَةِ ٱلْوُثْقَىٰ",24],["2:269:8",45,"فَقَدْ","then certainly","وَمَن يُؤْتَ ٱلْحِكْمَةَ","أُوتِىَ خَيْرًۭا كَثِيرًۭا ۗ",24],["3:13:1",51,"قَدْ","Surely","","كَانَ لَكُمْ ءَايَةٌۭ",24],["3:20:17",52,"فَقَدِ","then surely","ءَأَسْلَمْتُمْ ۚ فَإِنْ أَسْلَمُوا۟","ٱهْتَدَوا۟ ۖ وَّإِن تَوَلَّوْا۟",24],["3:40:7",55,"وَقَدْ","and verily","يَكُونُ لِى غُلَـٰمٌۭ","بَلَغَنِىَ ٱلْكِبَرُ وَٱمْرَأَتِى",24],["3:49:6",56,"قَدْ","[surely]","بَنِىٓ إِسْرَٰٓءِيلَ أَنِّى","جِئْتُكُم بِـَٔايَةٍۢ مِّن",24],["3:101:13",63,"فَقَدْ","then surely","وَمَن يَعْتَصِم بِٱللَّهِ","هُدِىَ إِلَىٰ صِرَٰطٍۢ",24],["3:118:15",65,"قَدْ","Indeed","وَدُّوا۟ مَا عَنِتُّمْ","بَدَتِ ٱلْبَغْضَآءُ مِنْ",24],["3:118:24",65,"قَدْ","Certainly","تُخْفِى صُدُورُهُمْ أَكْبَرُ ۚ","بَيَّنَّا لَكُمُ ٱلْـَٔايَـٰتِ ۖ",24],["3:123:1",66,"وَلَقَدْ","And certainly","","نَصَرَكُمُ ٱللَّهُ بِبَدْرٍۢ",24],["3:137:1",67,"قَدْ","Verily","","خَلَتْ مِن قَبْلِكُمْ",24],["3:140:4",67,"فَقَدْ","so certainly","إِن يَمْسَسْكُمْ قَرْحٌۭ","مَسَّ ٱلْقَوْمَ قَرْحٌۭ",24],["3:143:1",68,"وَلَقَدْ","And certainly","","كُنتُمْ تَمَنَّوْنَ ٱلْمَوْتَ",24],["3:143:9",68,"فَقَدْ","then indeed","قَبْلِ أَن تَلْقَوْهُ","رَأَيْتُمُوهُ وَأَنتُمْ تَنظُرُونَ",24],["3:144:5",68,"قَدْ","certainly","مُحَمَّدٌ إِلَّا رَسُولٌۭ","خَلَتْ مِن قَبْلِهِ",24],["3:152:1",69,"وَلَقَدْ","And certainly","","صَدَقَكُمُ ٱللَّهُ وَعْدَهُۥٓ",24],["3:152:33",69,"وَلَقَدْ","And surely","صَرَفَكُمْ عَنْهُمْ لِيَبْتَلِيَكُمْ ۖ","عَفَا عَنكُمْ ۗ وَٱللَّهُ",24],["3:154:13",70,"قَدْ","certainly","طَآئِفَةًۭ مِّنكُمْ ۖ وَطَآئِفَةٌۭ","أَهَمَّتْهُمْ أَنفُسُهُمْ يَظُنُّونَ",24],["3:155:14",70,"وَلَقَدْ","And surely","بِبَعْضِ مَا كَسَبُوا۟ ۖ","عَفَا ٱللَّهُ عَنْهُمْ ۗ",24],["3:164:1",71,"لَقَدْ","Certainly","","مَنَّ ٱللَّهُ عَلَى",24],["3:165:4",71,"قَدْ","surely","أَوَلَمَّآ أَصَـٰبَتْكُم مُّصِيبَةٌۭ","أَصَبْتُم مِّثْلَيْهَا قُلْتُمْ",24],["3:173:7",72,"قَدْ","(have) certainly","ٱلنَّاسُ إِنَّ ٱلنَّاسَ","جَمَعُوا۟ لَكُمْ فَٱخْشَوْهُمْ",24],["3:181:1",74,"لَّقَدْ","Certainly","","سَمِعَ ٱللَّهُ قَوْلَ",24],["3:183:16",74,"قَدْ","Surely","تَأْكُلُهُ ٱلنَّارُ ۗ قُلْ","جَآءَكُمْ رُسُلٌۭ مِّن",24],["3:184:3",74,"فَقَدْ","then certainly","فَإِن كَذَّبُوكَ","كُذِّب