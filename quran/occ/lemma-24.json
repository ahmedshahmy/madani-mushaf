",247,"قَدْ","Verily","رُءْيَـٰىَ مِن قَبْلُ","جَعَلَهَا رَبِّى حَقًّۭا ۖ",24],["12:100:19",247,"وَقَدْ","And indeed","جَعَلَهَا رَبِّى حَقًّۭا ۖ","أَحْسَنَ بِىٓ إِذْ",24],["12:101:2",247,"قَدْ","indeed","۞ رَبِّ","ءَاتَيْتَنِى مِنَ ٱلْمُلْكِ",24],["12:110:7",248,"قَدْ","certainly","ٱلرُّسُلُ وَظَنُّوٓا۟ أَنَّهُمْ","كُذِبُوا۟ جَآءَهُمْ نَصْرُنَا",24],["12:111:1",248,"لَقَدْ","Verily","","كَانَ فِى قَصَصِهِمْ",24],["13:6:5",250,"وَقَدْ","and verily","بِٱلسَّيِّئَةِ قَبْلَ ٱلْحَسَنَةِ","خَلَتْ مِن قَبْلِهِمُ",24],["13:30:5",253,"قَدْ","verily","أَرْسَلْنَـٰكَ فِىٓ أُمَّةٍۢ","خَلَتْ مِن قَبْلِهَآ",24],["13:32:1",253,"وَلَقَدِ","And certainly","","ٱسْتُهْزِئَ بِرُسُلٍۢ مِّن",24],["13:38:1",254,"وَلَقَدْ","And certainly","","أَرْسَلْنَا رُسُلًۭا مِّن",24],["13:42:1",254,"وَقَدْ","And certainly","","مَكَرَ ٱلَّذِينَ مِن",24],["14:5:1",255,"وَلَقَدْ","And verily","","أَرْسَلْنَا مُوسَىٰ بِـَٔايَـٰتِنَآ",24],["14:12:7",257,"وَقَدْ","while certainly","نَتَوَكَّلَ عَلَى ٱللَّهِ","هَدَىٰنَا سُبُلَنَا ۚ وَلَنَصْبِرَنَّ",24],["14:46:1",261,"وَقَدْ","And indeed","","مَكَرُوا۟ مَكْرَهُمْ وَعِندَ",24],["15:10:1",262,"وَلَقَدْ","And certainly","","أَرْسَلْنَا مِن قَبْلِكَ",24],["15:13:4",262,"وَقَدْ","and verily","لَا يُؤْمِنُونَ بِهِۦ ۖ","خَلَتْ سُنَّةُ ٱلْأَوَّلِينَ",24],["15:16:1",263,"وَلَقَدْ","And verily","","جَعَلْنَا فِى ٱلسَّمَآءِ",24],["15:24:1",263,"وَلَقَدْ","And verily","","عَلِمْنَا ٱلْمُسْتَقْدِمِينَ مِنكُمْ",24],["15:24:5",263,"وَلَقَدْ","and verily","عَلِمْنَا ٱلْمُسْتَقْدِمِينَ مِنكُمْ","عَلِمْنَا ٱلْمُسْتَـْٔخِرِينَ",24],["15:26:1",263,"وَلَقَدْ","And verily","","خَلَقْنَا ٱلْإِنسَـٰنَ مِن",24],["15:80:1",266,"وَلَقَدْ","And certainly","","كَذَّبَ أَصْحَـٰبُ ٱلْحِجْرِ",24],["15:87:1",266,"وَلَقَدْ","And certainly","","ءَاتَيْنَـٰكَ سَبْعًۭا مِّنَ",24],["15:97:1",267,"وَلَقَدْ","And verily","","نَعْلَمُ أَنَّكَ يَضِيقُ",24],["16:26:1",269,"قَدْ","Verily","","مَكَرَ ٱلَّذِينَ مِن",24],["16:36:1",271,"وَلَقَدْ","And certainly","","بَعَثْنَا فِى كُلِّ",24],["16:63:2",273,"لَقَدْ","certainly","تَٱللَّهِ","أَرْسَلْنَآ إِلَىٰٓ أُمَمٍۢ",24],["16:91:11",277,"وَقَدْ","while verily","ٱلْأَيْمَـٰنَ بَعْدَ تَوْكِيدِهَا","جَعَلْتُمُ ٱللَّهَ عَلَيْكُمْ",24],["16:103:1",279,"وَلَقَدْ","And certainly","","نَعْلَمُ أَنَّهُمْ يَقُولُونَ",24],["16:113:1",280,"وَلَقَدْ","And certainly","","جَآءَهُمْ رَسُولٌۭ مِّنْهُمْ",24],["17:33:12",285,"فَقَدْ","verily","وَمَن قُتِلَ مَظْلُومًۭا","جَعَلْنَا لِوَلِيِّهِۦ سُلْطَـٰنًۭا",24],["17:41:1",286,"وَلَقَدْ","And verily","","صَرَّفْنَا فِى هَـٰذَا",24],["17:55:7",287,"وَلَقَدْ","And verily","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۗ","فَضَّلْنَا بَعْضَ ٱلنَّبِيِّـۧنَ",24],["17:70:1",289,"۞ وَلَقَدْ","And certainly","","كَرَّمْنَا بَنِىٓ ءَادَمَ",24],["17:74:4",289,"لَقَدْ","certainly","وَلَوْلَآ أَن ثَبَّتْنَـٰكَ","كِدتَّ تَرْكَنُ إِلَيْهِمْ",24],["17:77:3",290,"قَدْ","[verily]","سُنَّةَ مَن","أَرْسَلْنَا قَبْلَكَ مِن",24],["17:89:1",291,"وَلَقَدْ","And verily","","صَرَّفْنَا لِلنَّاسِ فِى",24],["17:101:1",292,"وَلَقَدْ","And certainly","","ءَاتَيْنَا مُوسَىٰ تِسْعَ",24],["17:102:2",292,"لَقَدْ","Verily","قَالَ","عَلِمْتَ مَآ أَنزَلَ",24],["18:14:16",294,"لَّقَدْ","Certainly","مِن دُونِهِۦٓ إِلَـٰهًۭا ۖ","قُلْنَآ إِذًۭا شَطَطًا",24],["18:48:5",299,"لَّقَدْ","Certainly","عَلَىٰ رَبِّكَ صَفًّۭا","جِئْتُمُونَا كَمَا خَلَقْنَـٰكُمْ",24],["18:54:1",300,"وَلَقَدْ","And certainly","","صَرَّفْنَا فِى هَـٰذَا",24],["18:62:7",301,"لَقَدْ","Certainly","لِفَتَىٰهُ ءَاتِنَا غَدَآءَنَا","لَقِينَا مِن سَفَرِنَا",24],["18:71:12",301,"لَقَدْ","Certainly","أَخَرَقْتَهَا لِتُغْرِقَ أَهْلَهَا","جِئْتَ شَيْـًٔا إِمْرًۭا",24],["18:74:13",301,"لَّقَدْ","Certainly","زَكِيَّةًۢ بِغَيْرِ نَفْسٍۢ","جِئْتَ شَيْـًۭٔا نُّكْرًۭا",24],["18:76:9",302,"قَدْ","Verily","بَعْدَهَا فَلَا تُصَـٰحِبْنِى ۖ","بَلَغْتَ مِن لَّدُنِّى",24],["18:91:2",303,"وَقَدْ","And verily","كَذَٰلِكَ","أَحَطْنَا بِمَا لَدَيْهِ",24],["19:8:10",305,"وَقَدْ","and indeed","وَكَانَتِ ٱمْرَأَتِى عَاقِرًۭا","بَلَغْتُ مِنَ ٱلْكِبَرِ",24],["19:9:8",305,"وَقَدْ","and certainly","هُوَ عَلَىَّ هَيِّنٌۭ","خَلَقْتُكَ مِن قَبْلُ",24],["19:24:6",306,"قَدْ","verily","تَحْتِهَآ أَلَّا تَحْزَنِى","جَعَلَ رَبُّكِ تَحْتَكِ",24],["19:27:7",307,"لَقَدْ","Certainly","تَحْمِلُهُۥ ۖ قَالُوا۟ يَـٰمَرْيَمُ","جِئْتِ شَيْـًۭٔا فَرِيًّۭا",24],["19:43:3",308,"قَدْ","verily","يَـٰٓأَبَتِ إِنِّى","جَآءَنِى مِنَ ٱلْعِلْمِ",24],["19:89:1",311,"لَّقَدْ","Verily","","جِئْتُمْ شَيْـًٔا إِدًّۭا",24],["19:94:1",311,"لَّقَدْ","Verily","","أَحْصَىٰهُمْ وَعَدَّهُمْ عَدًّۭا",24],["20:36:2",313,"قَدْ","Verily","قَالَ","أُوتِيتَ سُؤْلَكَ يَـٰمُوسَىٰ",24],["20:37:1",313,"وَلَقَدْ","And indeed","","مَنَنَّا عَلَيْكَ مَرَّةً",24],["20:47:12",314,"قَدْ","Verily","إِسْرَٰٓءِيلَ وَلَا تُعَذِّبْهُمْ ۖ","جِئْنَـٰكَ بِـَٔايَةٍۢ مِّن",24],["20:48:2",314,"قَدْ","verily","إِنَّا","أُوحِىَ إِلَيْنَآ أَنَّ",24],["20:56:1",315,"وَلَقَدْ","And verily","","أَرَيْنَـٰهُ ءَايَـٰتِنَا كُلَّهَا",24],["20:61:12",315,"وَقَدْ","And verily","كَذِبًۭا فَيُسْحِتَكُم بِعَذَابٍۢ ۖ","خَابَ مَنِ ٱفْتَرَىٰ",24],["20:64:6",315,"وَقَدْ","And verily","ثُمَّ ٱئْتُوا۟ صَفًّۭا ۚ","أَفْلَحَ ٱلْيَوْمَ مَنِ",24],["20:75:4",316,"قَدْ","verily","وَمَن يَأْتِهِۦ مُؤْمِنًۭا","عَمِلَ ٱلصَّـٰلِحَـٰتِ فَأُو۟لَـٰٓئِكَ",24],["20:77:1",317,"وَلَقَدْ","And verily","","أَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ",24],["20:80:3",317,"قَدْ","Verily","يَـٰبَنِىٓ إِسْرَٰٓءِيلَ","أَنجَيْنَـٰكُم مِّنْ عَدُوِّكُمْ",24],["20:81:16",317,"فَقَدْ","indeed","يَحْلِلْ عَلَيْهِ غَضَبِى","هَوَىٰ",24],["20:85:3",317,"قَدْ","[verily]","قَالَ فَإِنَّا","فَتَنَّا قَوْمَكَ مِنۢ",24],["20:90:1",318,"وَلَقَدْ","And verily","","قَالَ لَهُمْ هَـٰرُونُ",24],["20:99:7",319,"قَدْ","has preceded","مِنْ أَنۢبَآءِ مَا","سَبَقَ ۚ وَقَدْ ءَاتَيْنَـٰكَ",24],["20:99:9",319,"وَقَدْ","And certainly","مَا قَدْ سَبَقَ ۚ","ءَاتَيْنَـٰكَ مِن لَّدُنَّا",24],["20:111:5",319,"وَقَدْ","And verily","ٱلْوُجُوهُ لِلْحَىِّ ٱلْقَيُّومِ ۖ","خَابَ مَنْ حَمَلَ",24],["20:115:1",320,"وَلَقَدْ","And verily","","عَهِدْنَآ إِلَىٰٓ ءَادَمَ",24],["20:125:6",320,"وَقَدْ","while [verily]","لِمَ حَشَرْتَنِىٓ أَعْمَىٰ","كُنتُ بَصِيرًۭا",24],["21:10:1",322,"لَقَدْ","Indeed","","أَنزَلْنَآ إِلَيْكُمْ كِتَـٰبًۭا",24],["21:41:1",325,"وَلَقَدِ","And verily","","ٱسْتُهْزِئَ بِرُسُلٍۢ مِّن",24],["21:48:1",326,"وَلَقَدْ","And verily","","ءَاتَيْنَا مُوسَىٰ وَهَـٰرُونَ",24],["21:51:1",326,"۞ وَلَقَدْ","And verily","","ءَاتَيْنَآ إِبْرَٰهِيمَ رُشْدَهُۥ",24],["21:54:2",326,"لَقَدْ","Verily","قَالَ","كُنتُمْ أَنتُمْ وَءَابَآؤُكُمْ",24],["21:65:5",327,"لَقَدْ","Verily","نُكِسُوا۟ عَلَىٰ رُءُوسِهِمْ","عَلِمْتَ مَا هَـٰٓؤُلَآءِ",24],["21:97:11",330,"قَدْ","Verily","ٱلَّذِينَ كَفَرُوا۟ يَـٰوَيْلَنَا","كُنَّا فِى غَفْلَةٍۢ",24],["21:105:1",331,"وَلَقَدْ","And verily","","كَتَبْنَا فِى ٱلزَّبُورِ",24],["22:42:3",337,"فَقَدْ","so verily","وَإِن يُكَذِّبُوكَ","كَذَّبَتْ قَبْلَهُمْ قَوْمُ",24],["23:1:1",342,"قَدْ","Indeed","","أَفْلَحَ ٱلْمُؤْمِنُونَ",24],["23:12:1",342,"وَلَقَدْ","And indeed","","خَلَقْنَا ٱلْإِنسَـٰنَ مِن",24],["23:17:1",342,"وَلَقَدْ","And indeed","","خَلَقْنَا فَوْقَكُمْ سَبْعَ",24],["23:23:1",343,"وَلَقَدْ","And verily","","أَرْسَلْنَا نُوحًا إِلَىٰ",24],["23:49:1",345,"وَلَقَدْ","And verily","","ءَاتَيْنَا مُوسَى ٱلْكِتَـٰبَ",24],["23:66:1",346,"قَدْ","Verily","","كَانَتْ ءَايَـٰتِى تُتْلَىٰ",24],["23:76:1",347,"وَلَقَدْ","And verily","","أَخَذْنَـٰهُم بِٱلْعَذَابِ فَمَا",24],["23:83:1",347,"لَقَدْ","Verily","","وُعِدْنَا نَحْنُ وَءَابَآؤُنَا",24],["24:34:1",354,"وَلَقَدْ","And verily","","أَنزَلْنَآ إِلَيْكُمْ ءَايَـٰتٍۢ",24],["24:41:14",355,"قَدْ","verily","وَٱلطَّيْرُ صَـٰٓفَّـٰتٍۢ ۖ كُلٌّۭ","عَلِمَ صَلَاتَهُۥ وَتَسْبِيحَهُۥ ۗ",24],["24:46:1",356,"لَّقَدْ","Verily","","أَنزَلْنَآ ءَايَـٰتٍۢ مُّبَيِّنَـٰتٍۢ ۚ",24],["24:63:9",359,"قَدْ","Verily","كَدُعَآءِ بَعْضِكُم بَعْضًۭا ۚ","يَعْلَمُ ٱللَّهُ ٱلَّذِينَ",24],["24:64:8",359,"قَدْ","Verily","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ","يَعْلَمُ مَآ أَنتُمْ",24],["25:4:13",360,"فَقَدْ","But verily","عَلَيْهِ قَوْمٌ ءَاخَرُونَ ۖ","جَآءُو ظُلْمًۭا وَزُورًۭا",24],["25:19:1",361,"فَقَدْ","So verily","","