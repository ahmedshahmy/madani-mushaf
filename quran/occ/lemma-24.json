ainly","","ذَرَأْنَا لِجَهَنَّمَ كَثِيرًۭا",24],["7:185:16",174,"قَدِ","verily","عَسَىٰٓ أَن يَكُونَ","ٱقْتَرَبَ أَجَلُهُمْ ۖ فَبِأَىِّ",24],["8:16:12",178,"فَقَدْ","certainly","مُتَحَيِّزًا إِلَىٰ فِئَةٍۢ","بَآءَ بِغَضَبٍۢ مِّنَ",24],["8:19:3",179,"فَقَدْ","then certainly","إِن تَسْتَفْتِحُوا۟","جَآءَكُمُ ٱلْفَتْحُ ۖ وَإِن",24],["8:31:6",180,"قَدْ","Verily","عَلَيْهِمْ ءَايَـٰتُنَا قَالُوا۟","سَمِعْنَا لَوْ نَشَآءُ",24],["8:38:9",181,"قَدْ","[verily]","يُغْفَرْ لَهُم مَّا","سَلَفَ وَإِن يَعُودُوا۟",24],["8:38:13",181,"فَقَدْ","then verily","سَلَفَ وَإِن يَعُودُوا۟","مَضَتْ سُنَّتُ ٱلْأَوَّلِينَ",24],["8:71:4",186,"فَقَدْ","certainly","وَإِن يُرِيدُوا۟ خِيَانَتَكَ","خَانُوا۟ ٱللَّهَ مِن",24],["9:25:1",190,"لَقَدْ","Verily","","نَصَرَكُمُ ٱللَّهُ فِى",24],["9:40:3",193,"فَقَدْ","certainly","إِلَّا تَنصُرُوهُ","نَصَرَهُ ٱللَّهُ إِذْ",24],["9:48:1",195,"لَقَدِ","Verily","","ٱبْتَغَوُا۟ ٱلْفِتْنَةَ مِن",24],["9:50:9",195,"قَدْ","Verily","تُصِبْكَ مُصِيبَةٌۭ يَقُولُوا۟","أَخَذْنَآ أَمْرَنَا مِن",24],["9:66:3",197,"قَدْ","verily","لَا تَعْتَذِرُوا۟","كَفَرْتُم بَعْدَ إِيمَـٰنِكُمْ ۚ",24],["9:74:5",199,"وَلَقَدْ","while certainly","بِٱللَّهِ مَا قَالُوا۟","قَالُوا۟ كَلِمَةَ ٱلْكُفْرِ",24],["9:94:12",202,"قَدْ","Verily","لَن نُّؤْمِنَ لَكُمْ","نَبَّأَنَا ٱللَّهُ مِنْ",24],["9:117:1",205,"لَّقَد","Verily","","تَّابَ ٱللَّهُ عَلَى",24],["9:128:1",207,"لَقَدْ","Certainly","","جَآءَكُمْ رَسُولٌۭ مِّنْ",24],["10:13:1",209,"وَلَقَدْ","And verily","","أَهْلَكْنَا ٱلْقُرُونَ مِن",24],["10:16:11",210,"فَقَدْ","Verily","وَلَآ أَدْرَىٰكُم بِهِۦ ۖ","لَبِثْتُ فِيكُمْ عُمُرًۭا",24],["10:45:12",214,"قَدْ","Certainly","ٱلنَّهَارِ يَتَعَارَفُونَ بَيْنَهُمْ ۚ","خَسِرَ ٱلَّذِينَ كَذَّبُوا۟",24],["10:51:8",214,"وَقَدْ","And certainly","ءَامَنتُم بِهِۦٓ ۚ ءَآلْـَٔـٰنَ","كُنتُم بِهِۦ تَسْتَعْجِلُونَ",24],["10:57:3",215,"قَدْ","Verily","يَـٰٓأَيُّهَا ٱلنَّاسُ","جَآءَتْكُم مَّوْعِظَةٌۭ مِّن",24],["10:89:2",219,"قَدْ","Verily","قَالَ","أُجِيبَت دَّعْوَتُكُمَا فَٱسْتَقِيمَا",24],["10:91:2",2