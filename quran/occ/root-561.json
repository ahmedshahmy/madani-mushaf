[["2:13:12",3,"ٱلسُّفَهَآءُ ۗ","the fools","أَنُؤْمِنُ كَمَآ ءَامَنَ","أَلَآ إِنَّهُمْ هُمُ",1102],["2:13:16",3,"ٱلسُّفَهَآءُ","(are) the fools","أَلَآ إِنَّهُمْ هُمُ","وَلَـٰكِن لَّا يَعْلَمُونَ",1102],["2:130:8",20,"سَفِهَ","fooled","إِبْرَٰهِـۧمَ إِلَّا مَن","نَفْسَهُۥ ۚ وَلَقَدِ ٱصْطَفَيْنَـٰهُ",4248],["2:142:2",22,"ٱلسُّفَهَآءُ","the foolish ones","۞ سَيَقُولُ","مِنَ ٱلنَّاسِ مَا",1102],["2:282:40",48,"سَفِيهًا","(of) limited understanding","ٱلَّذِى عَلَيْهِ ٱلْحَقُّ","أَوْ ضَعِيفًا أَوْ",1102],["4:5:3",77,"ٱلسُّفَهَآءَ","the foolish","وَلَا تُؤْتُوا۟","أَمْوَٰلَكُمُ ٱلَّتِى جَعَلَ",1102],["6:140:6",146,"سَفَهًۢا","(in) foolishness","ٱلَّذِينَ قَتَلُوٓا۟ أَوْلَـٰدَهُمْ","بِغَيْرِ عِلْمٍۢ وَحَرَّمُوا۟",4246],["7:66:10",158,"سَفَاهَةٍۢ","foolishness","إِنَّا لَنَرَىٰكَ فِى","وَإِنَّا لَنَظُنُّكَ مِنَ",2622],["7:67:5",158,"سَفَاهَةٌۭ","foolishness","يَـٰقَوْمِ لَيْسَ بِى","وَلَـٰكِنِّى رَسُولٌۭ مِّن",2622],["7:155:21",169,"ٱلسُّفَهَآءُ","the foolish","أَتُهْلِكُنَا بِمَا فَعَلَ","مِنَّآ ۖ إِنْ هِىَ",1102],["72:4:4",572,"سَفِيهُنَا","the foolish among us","وَأَنَّهُۥ كَانَ يَقُولُ","عَلَى ٱللَّهِ شَطَطًۭا",1102]]