[["18:9:5",294,"ٱلْكَهْفِ","(of) the cave","حَسِبْتَ أَنَّ أَصْحَـٰبَ","وَٱلرَّقِيمِ كَانُوا۟ مِنْ",1189],["18:10:5",294,"ٱلْكَهْفِ","the cave","أَوَى ٱلْفِتْيَةُ إِلَى","فَقَالُوا۟ رَبَّنَآ ءَاتِنَا",1189],["18:11:5",294,"ٱلْكَهْفِ","the cave","عَلَىٰٓ ءَاذَانِهِمْ فِى","سِنِينَ عَدَدًۭا",1189],["18:16:9",295,"ٱلْكَهْفِ","the cave","ٱللَّهَ فَأْوُۥٓا۟ إِلَى","يَنشُرْ لَكُمْ رَبُّكُم",1189],["18:17:7",295,"كَهْفِهِمْ","their cave","طَلَعَت تَّزَٰوَرُ عَن","ذَاتَ ٱلْيَمِينِ وَإِذَا",1189],["18:25:3",296,"كَهْفِهِمْ","their cave","وَلَبِثُوا۟ فِى","ثَلَـٰثَ مِا۟ئَةٍۢ سِنِينَ",1189]]