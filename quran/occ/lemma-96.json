5",345,"لَعَلَّهُمْ","so that they may","ءَاتَيْنَا مُوسَى ٱلْكِتَـٰبَ","يَهْتَدُونَ",96],["24:1:8",350,"لَّعَلَّكُمْ","so that you may","فِيهَآ ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ","تَذَكَّرُونَ",96],["24:27:17",352,"لَعَلَّكُمْ","so that you may","ذَٰلِكُمْ خَيْرٌۭ لَّكُمْ","تَذَكَّرُونَ",96],["24:31:77",353,"لَعَلَّكُمْ","So that you may","جَمِيعًا أَيُّهَ ٱلْمُؤْمِنُونَ","تُفْلِحُونَ",96],["24:56:7",357,"لَعَلَّكُمْ","so that you may","ٱلزَّكَوٰةَ وَأَطِيعُوا۟ ٱلرَّسُولَ","تُرْحَمُونَ",96],["24:61:75",358,"لَعَلَّكُمْ","so that you may","ٱللَّهُ لَكُمُ ٱلْـَٔايَـٰتِ","تَعْقِلُونَ",96],["26:3:1",367,"لَعَلَّكَ","Perhaps you","","بَـٰخِعٌۭ نَّفْسَكَ أَلَّا",96],["26:40:1",369,"لَعَلَّنَا","That we may","","نَتَّبِعُ ٱلسَّحَرَةَ إِن",96],["26:129:3",372,"لَعَلَّكُمْ","that you may","وَتَتَّخِذُونَ مَصَانِعَ","تَخْلُدُونَ",96],["27:7:15",377,"لَّعَلَّكُمْ","so that you may","ءَاتِيكُم بِشِهَابٍۢ قَبَسٍۢ","تَصْطَلُونَ",96],["27:46:11",381,"لَعَلَّكُمْ","so that you may","لَوْلَا تَسْتَغْفِرُونَ ٱللَّهَ","تُرْحَمُونَ",96],["28:29:26",389,"لَعَلَّكُمْ","so that you may","جَذْوَةٍۢ مِّنَ ٱلنَّارِ","تَصْطَلُونَ",96],["28:43:15",390,"لَّعَلَّهُمْ","that they may","لِلنَّاسِ وَهُدًۭى وَرَحْمَةًۭ","يَتَذَكَّرُونَ",96],["28:46:19",391,"لَعَلَّهُمْ","so that they may","نَّذِيرٍۢ مِّن قَبْلِكَ","يَتَذَكَّرُونَ",96],["28:51:5",392,"لَعَلَّهُمْ","so that they may","وَصَّلْنَا لَهُمُ ٱلْقَوْلَ","يَتَذَكَّرُونَ",96],["28:73:12",394,"وَلَعَلَّكُمْ","and so that you may","وَلِتَبْتَغُوا۟ مِن فَضْلِهِۦ","تَشْكُرُونَ",96],["30:41:14",408,"لَعَلَّهُمْ","so that they may","بَعْضَ ٱلَّذِى عَمِلُوا۟","يَرْجِعُونَ",96],["30:46:16",409,"وَلَعَلَّكُمْ","and that you may","وَلِتَبْتَغُوا۟ مِن فَضْلِهِۦ","تَشْكُرُونَ",96],["32:3:17",415,"لَعَلَّهُمْ","so that they may","نَّذِيرٍۢ مِّن قَبْلِكَ","يَهْتَدُونَ",96],["32:21:8",417,"لَعَلَّهُمْ","so that they may","دُونَ ٱلْعَذَابِ ٱلْأَكْبَرِ","يَرْجِعُونَ",96],["33:63:12",427,"لَعَلَّ","Perhaps","ٱللَّهِ ۚ وَمَا يُدْرِيكَ","ٱلسَّاعَةَ تَكُونُ قَرِيبًا",96],