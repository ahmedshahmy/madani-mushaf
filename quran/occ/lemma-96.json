[["2:21:10",4,"لَعَلَّكُمْ","so that you may","وَٱلَّذِينَ مِن قَبْلِكُمْ","تَتَّقُونَ",96],["2:52:7",8,"لَعَلَّكُمْ","so that you may","مِّنۢ بَعْدِ ذَٰلِكَ","تَشْكُرُونَ",96],["2:53:6",8,"لَعَلَّكُمْ","perhaps you","مُوسَى ٱلْكِتَـٰبَ وَٱلْفُرْقَانَ","تَهْتَدُونَ",96],["2:56:6",8,"لَعَلَّكُمْ","so that you may","مِّنۢ بَعْدِ مَوْتِكُمْ","تَشْكُرُونَ",96],["2:63:14",10,"لَعَلَّكُمْ","perhaps you","وَٱذْكُرُوا۟ مَا فِيهِ","تَتَّقُونَ",96],["2:73:10",11,"لَعَلَّكُمْ","perhaps you may","ٱلْمَوْتَىٰ وَيُرِيكُمْ ءَايَـٰتِهِۦ","تَعْقِلُونَ",96],["2:150:30",23,"وَلَعَلَّكُمْ","[and] so that you may","وَلِأُتِمَّ نِعْمَتِى عَلَيْكُمْ","تَهْتَدُونَ",96],["2:179:7",27,"لَعَلَّكُمْ","So that you may","حَيَوٰةٌۭ يَـٰٓأُو۟لِى ٱلْأَلْبَـٰبِ","تَتَّقُونَ",96],["2:183:13",28,"لَعَلَّكُمْ","so that you may","ٱلَّذِينَ مِن قَبْلِكُمْ","تَتَّقُونَ",96],["2:185:43",28,"وَلَعَلَّكُمْ","so that you may","عَلَىٰ مَا هَدَىٰكُمْ","تَشْكُرُونَ",96],["2:186:16",28,"لَعَلَّهُمْ","so that they may","لِى وَلْيُؤْمِنُوا۟ بِى","يَرْشُدُونَ",96],["2:187:64",29,"لَعَلَّهُمْ","so that they may","ٱللَّهُ ءَايَـٰتِهِۦ لِلنَّاسِ","يَتَّقُونَ",96],["2:189:26",29,"لَعَلَّكُمْ","so that you may","أَبْوَٰبِهَا ۚ وَٱتَّقُوا۟ ٱللَّهَ","تُفْلِحُونَ",96],["2:219:25",34,"لَعَلَّكُمْ","so that you may","ٱللَّهُ لَكُمُ ٱلْـَٔايَـٰتِ","تَتَفَكَّرُونَ",96],["2:221:38",35,"لَعَلَّهُمْ","so that they may","وَيُبَيِّنُ ءَايَـٰتِهِۦ لِلنَّاسِ","يَتَذَكَّرُونَ",96],["2:242:6",39,"لَعَلَّكُمْ","so that you may","ٱللَّهُ لَكُمْ ءَايَـٰتِهِۦ","تَعْقِلُونَ",96],["2:266:34",45,"لَعَلَّكُمْ","so that you may","ٱللَّهُ لَكُمُ ٱلْـَٔايَـٰتِ","تَتَفَكَّرُونَ",96],["3:72:16",59,"لَعَلَّهُمْ","perhaps they may","ٱلنَّهَارِ وَٱكْفُرُوٓا۟ ءَاخِرَهُۥ","يَرْجِعُونَ",96],["3:103:33",63,"لَعَلَّكُمْ","so that you may","ٱللَّهُ لَكُمْ ءَايَـٰتِهِۦ","تَهْتَدُونَ",96],["3:123:9",66,"لَعَلَّكُمْ","so that you may","أَذِلَّةٌۭ ۖ فَٱتَّقُوا۟ ٱللَّهَ","تَشْكُرُونَ",96],["3:130:11",66,"لَعَلَّكُمْ","so that you may","مُّضَـٰعَفَةًۭ ۖ وَٱتَّقُوا۟ ٱللَّهَ","تُفْلِحُونَ",96],["3:132:4",66,"لَعَلَّكُمْ","so that you may","وَأَطِيعُوا۟ ٱللَّهَ وَٱلرَّسُولَ","تُرْحَمُونَ",96],["3:200:9",76,"لَعَلَّكُمْ","so that you may","وَرَابِطُوا۟ وَٱتَّقُوا۟ ٱللَّهَ","تُفْلِحُونَ",96],["5:6:60",108,"لَعَلَّكُمْ","so that you may","وَلِيُتِمَّ نِعْمَتَهُۥ عَلَيْكُمْ","تَشْكُرُونَ",96],["5:35:12",113,"لَعَلَّكُمْ","so that you may","وَجَـٰهِدُوا۟ فِى سَبِيلِهِۦ","تُفْلِحُونَ",96],["5:89:44",122,"لَعَلَّكُمْ","so that you may","ٱللَّهُ لَكُمْ ءَايَـٰتِهِۦ","تَشْكُرُونَ",96],["5:90:14",122,"لَعَلَّكُمْ","so that you may","عَمَلِ ٱلشَّيْطَـٰنِ فَٱجْتَنِبُوهُ","تُفْلِحُونَ",96],["5:100:14",124,"لَعَلَّكُمْ","so that you may","ٱللَّهَ يَـٰٓأُو۟لِى ٱلْأَلْبَـٰبِ","تُفْلِحُونَ",96],["6:42:10",132,"لَعَلَّهُمْ","so that they may","فَأَخَذْنَـٰهُم بِٱلْبَأْسَآءِ وَٱلضَّرَّآءِ","يَتَضَرَّعُونَ",96],["6:51:16",133,"لَّعَلَّهُمْ","so that they may","وَلِىٌّۭ وَلَا شَفِيعٌۭ","يَتَّقُونَ",96],["6:65:26",135,"لَعَلَّهُمْ","so that they may","كَيْفَ نُصَرِّفُ ٱلْـَٔايَـٰتِ","يَفْقَهُونَ",96],["6:69:11",136,"لَعَلَّهُمْ","so that they may","شَىْءٍۢ وَلَـٰكِن ذِكْرَىٰ","يَتَّقُونَ",96],["6:151:41",148,"لَعَلَّكُمْ","so that you may","ذَٰلِكُمْ وَصَّىٰكُم بِهِۦ","تَعْقِلُونَ",96],["6:152:34",149,"لَعَلَّكُمْ","so that you may","ذَٰلِكُمْ وَصَّىٰكُم بِهِۦ","تَذَكَّرُونَ",96],["6:153:16",149,"لَعَلَّكُمْ","so that you may","ذَٰلِكُمْ وَصَّىٰكُم بِهِۦ","تَتَّقُونَ",96],["6:154:14",149,"لَّعَلَّهُم","so that they may","شَىْءٍۢ وَهُدًۭى وَرَحْمَةًۭ","بِلِقَآءِ رَبِّهِمْ يُؤْمِنُونَ",96],["6:155:7",149,"لَعَلَّكُمْ","so that you may","مُبَارَكٌۭ فَٱتَّبِعُوهُ وَٱتَّقُوا۟","تُرْحَمُونَ",96],["7:26:18",153,"لَعَلَّهُمْ","so that they may","مِنْ ءَايَـٰتِ ٱللَّهِ","يَذَّكَّرُونَ",96],["7:57:28",157,"لَعَلَّكُمْ","so that you may","كَذَٰلِكَ نُخْرِجُ ٱلْمَوْتَىٰ","تَذَكَّرُونَ",96],["7:63:12",158,"وَلَعَلَّكُمْ","and so that you may","مِّنكُمْ لِيُنذِرَكُمْ وَلِتَتَّقُوا۟","تُرْحَمُونَ",96],["7:69:26",159,"لَعَلَّكُمْ","so that you may","فَٱذْكُرُوٓا۟ ءَالَآءَ ٱللَّهِ","تُفْلِحُونَ",96],["7:94:12",162,"لَعَلَّهُمْ","so that they may","أَهْلَهَا بِٱلْبَأْسَآءِ وَٱلضَّرَّآءِ","يَضَّرَّعُونَ",96],["7:130:9",165,"لَعَلَّهُمْ","so that they may","وَنَقْصٍۢ مِّنَ ٱلثَّمَرَٰتِ","يَذَّكَّرُونَ",96],["7:158:30",170,"لَعَلَّكُمْ","so that you may","بِٱللَّهِ وَكَلِمَـٰتِهِۦ وَٱتَّبِعُوهُ","تَهْتَدُونَ",96],["7:164:18",172,"وَلَعَلَّهُمْ","and that they may","مَعْذِرَةً إِلَىٰ رَبِّكُمْ","يَتَّقُونَ",96],["7:168:13",172,"لَعَلَّهُمْ","so that they may","وَبَلَوْنَـٰهُم بِٱلْحَسَنَـٰتِ وَٱلسَّيِّـَٔاتِ","يَرْجِعُونَ",96],["7:171:18",173,"لَعَلَّكُمْ","so that you may","وَٱذْكُرُوا۟ مَا فِيهِ","تَتَّقُونَ",96],["7:174:4",173,"وَلَعَلَّهُمْ","so that they may","وَكَذَٰلِكَ نُفَصِّلُ ٱلْـَٔايَـٰتِ","يَرْجِعُونَ",96],["7:176:29",173,"لَعَلَّهُمْ","so that they may","بِـَٔايَـٰتِنَا ۚ فَٱقْصُصِ ٱلْقَصَصَ","يَتَفَكَّرُونَ",96],["7:204:7",176,"لَعَلَّكُمْ","so that you may","فَٱسْتَمِعُوا۟ لَهُۥ وَأَنصِتُوا۟","تُرْحَمُونَ",96],["8:26:18",180,"لَعَلَّكُمْ","so that you may","وَرَزَقَكُم مِّنَ ٱلطَّيِّبَـٰتِ","تَشْكُرُونَ",96],["8:45:11",182,"لَّعَلَّكُمْ","so that you may","وَٱذْكُرُوا۟ ٱللَّهَ كَثِيرًۭا","تُفْلِحُونَ",96],["8:57:9",184,"لَعَلَّهُمْ","so that they may","بِهِم مَّنْ خَلْفَهُمْ","يَذَّكَّرُونَ",96],["9:12:17",188,"لَعَلَّهُمْ","so that they may","لَآ أَيْمَـٰنَ لَهُمْ","يَنتَهُونَ",96],["9:122:21",206,"لَعَلَّهُمْ","so that they may","إِذَا رَجَعُوٓا۟ إِلَيْهِمْ","يَحْذَرُونَ",96],["11:12:1",222,"فَلَعَلَّكَ","Then possibly you","","تَارِكٌۢ بَعْضَ مَا",96],["12:2:5",235,"لَّعَلَّكُمْ","so that you may","أَنزَلْنَـٰهُ قُرْءَٰنًا عَرَبِيًّۭا","تَعْقِلُونَ",96],["12:46:21",241,"لَعَلَّهُمْ","so that they may","أَرْجِعُ إِلَى ٱلنَّاسِ","يَعْلَمُونَ",96],["12:62:7",242,"لَعَلَّهُمْ","so that they","بِضَـٰعَتَهُمْ فِى رِحَالِهِمْ","يَعْرِفُونَهَآ إِذَا ٱنقَلَبُوٓا۟",96],["12:62:13",242,"لَعَلَّهُمْ","so that they may","ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمْ","يَرْجِعُونَ",96],["13:2:23",249,"لَعَلَّكُم","so that you may","