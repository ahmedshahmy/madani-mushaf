[["2:31:2",6,"ءَادَمَ","Adam","وَعَلَّمَ","ٱلْأَسْمَآءَ كُلَّهَا ثُمَّ",421],["2:33:2",6,"يَـٰٓـَٔادَمُ","O Adam","قَالَ","أَنۢبِئْهُم بِأَسْمَآئِهِمْ ۖ فَلَمَّآ",421],["2:34:5",6,"لِـَٔادَمَ","to Adam","قُلْنَا لِلْمَلَـٰٓئِكَةِ ٱسْجُدُوا۟","فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ",421],["2:35:2",6,"يَـٰٓـَٔادَمُ","O Adam","وَقُلْنَا","ٱسْكُنْ أَنتَ وَزَوْجُكَ",421],["2:37:2",6,"ءَادَمُ","Adam","فَتَلَقَّىٰٓ","مِن رَّبِّهِۦ كَلِمَـٰتٍۢ",421],["3:33:4",54,"ءَادَمَ","Adam","۞ إِنَّ ٱللَّهَ ٱصْطَفَىٰٓ","وَنُوحًۭا وَءَالَ إِبْرَٰهِيمَ",421],["3:59:7",57,"ءَادَمَ ۖ","(of) Adam","عِندَ ٱللَّهِ كَمَثَلِ","خَلَقَهُۥ مِن تُرَابٍۢ",421],["5:27:5",112,"ءَادَمَ","(of) Adam","عَلَيْهِمْ نَبَأَ ٱبْنَىْ","بِٱلْحَقِّ إِذْ قَرَّبَا",421],["7:11:9",151,"لِـَٔادَمَ","to Adam","قُلْنَا لِلْمَلَـٰٓئِكَةِ ٱسْجُدُوا۟","فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ",421],["7:19:1",152,"وَيَـٰٓـَٔادَمُ","And O Adam","","ٱسْكُنْ أَنتَ وَزَوْجُكَ",421],["7:26:2",153,"ءَادَمَ","(of) Adam","يَـٰبَنِىٓ","قَدْ أَنزَلْنَا عَلَيْكُمْ",421],["7:27:2",153,"ءَادَمَ","(of) Adam","يَـٰبَنِىٓ","لَا يَفْتِنَنَّكُمُ ٱلشَّيْطَـٰنُ",421],["7:31:2",154,"ءَادَمَ","(of) Adam","۞ يَـٰبَنِىٓ","خُذُوا۟ زِينَتَكُمْ عِندَ",421],["7:35:2",154,"ءَادَمَ","(of) Adam","يَـٰبَنِىٓ","إِمَّا يَأْتِيَنَّكُمْ رُسُلٌۭ",421],["7:172:6",173,"ءَادَمَ","(of) Adam","رَبُّكَ مِنۢ بَنِىٓ","مِن ظُهُورِهِمْ ذُرِّيَّتَهُمْ",421],["17:61:5",288,"لِـَٔادَمَ","to Adam","قُلْنَا لِلْمَلَـٰٓئِكَةِ ٱسْجُدُوا۟","فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ",421],["17:70:4",289,"ءَادَمَ","(the) children of Adam","۞ وَلَقَدْ كَرَّمْنَا بَنِىٓ","وَحَمَلْنَـٰهُمْ فِى ٱلْبَرِّ",421],["18:50:5",299,"لِـَٔادَمَ","to Adam","قُلْنَا لِلْمَلَـٰٓئِكَةِ ٱسْجُدُوا۟","فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ",421],["19:58:10",309,"ءَادَمَ","(of) Adam","ٱلنَّبِيِّـۧنَ مِن ذُرِّيَّةِ","وَمِمَّنْ حَمَلْنَا مَعَ",421],["20:115:4",320,"ءَادَمَ","Adam","وَلَقَدْ عَهِدْنَآ إِلَىٰٓ","مِن قَبْلُ فَنَسِىَ",421],["20:116:5",320,"لِـَٔادَمَ","to Adam","قُلْنَا لِلْمَلَـٰٓئِكَةِ ٱسْجُدُوا۟","فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ",421],["20:117:2",320,"يَـٰٓـَٔادَمُ","O Adam","فَقُلْنَا","إِنَّ هَـٰذَا عَدُوٌّۭ",421],["20:120:5",320,"يَـٰٓـَٔادَمُ","O Adam","إِلَيْهِ ٱلشَّيْطَـٰنُ قَالَ","هَلْ أَدُلُّكَ عَلَىٰ",421],["20:121:13",320,"ءَادَمُ","And Adam disobeyed","وَرَقِ ٱلْجَنَّةِ ۚ وَعَصَىٰٓ","رَبَّهُۥ فَغَوَىٰ",421],["36:60:5",444,"ءَادَمَ","O Children of Adam","أَعْهَدْ إِلَيْكُمْ يَـٰبَنِىٓ","أَن لَّا تَعْبُدُوا۟",421]]