[["2:116:14",18,"قَـٰنِتُونَ","(are) humbly obedient","وَٱلْأَرْضِ ۖ كُلٌّۭ لَّهُۥ","",995],["2:238:8",39,"قَـٰنِتِينَ","devoutly obedient","ٱلْوُسْطَىٰ وَقُومُوا۟ لِلَّهِ","",995],["3:17:3",52,"وَٱلْقَـٰنِتِينَ","and the obedient","ٱلصَّـٰبِرِينَ وَٱلصَّـٰدِقِينَ","وَٱلْمُنفِقِينَ وَٱلْمُسْتَغْفِرِينَ بِٱلْأَسْحَارِ",995],["3:43:2",55,"ٱقْنُتِى","Be obedient","يَـٰمَرْيَمُ","لِرَبِّكِ وَٱسْجُدِى وَٱرْكَعِى",2777],["4:34:16",84,"قَـٰنِتَـٰتٌ","(are) obedient","مِنْ أَمْوَٰلِهِمْ ۚ فَٱلصَّـٰلِحَـٰتُ","حَـٰفِظَـٰتٌۭ لِّلْغَيْبِ بِمَا",1954],["16:120:5",281,"قَانِتًۭا","obedient","إِبْرَٰهِيمَ كَانَ أُمَّةًۭ","لِّلَّهِ حَنِيفًۭا وَلَمْ",995],["30:26:8",407,"قَـٰنِتُونَ","(are) obedient","وَٱلْأَرْضِ ۖ كُلٌّۭ لَّهُۥ","",995],["33:31:2",422,"يَقْنُتْ","is obedient","۞ وَمَن","مِنكُنَّ لِلَّهِ وَرَسُولِهِۦ",2777],["33:35:6",422,"وَٱلْقَـٰنِتِينَ","and the obedient men","وَٱلْمُسْلِمَـٰتِ وَٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ","وَٱلْقَـٰنِتَـٰتِ وَٱلصَّـٰدِقِينَ وَٱلصَّـٰدِقَـٰتِ",995],["33:35:7",422,"وَٱلْقَـٰنِتَـٰتِ","and the obedient women","وَٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ وَٱلْقَـٰنِتِينَ","وَٱلصَّـٰدِقِينَ وَٱلصَّـٰدِقَـٰتِ وَٱلصَّـٰبِرِينَ",1954],["39:9:3",459,"قَـٰنِتٌ","(is) devoutly obedient","أَمَّنْ هُوَ","ءَانَآءَ ٱلَّيْلِ سَاجِدًۭا",995],["66:5:12",560,"قَـٰنِتَـٰتٍۢ","obedient","مِّنكُنَّ مُسْلِمَـٰتٍۢ مُّؤْمِنَـٰتٍۢ","تَـٰٓئِبَـٰتٍ عَـٰبِدَٰتٍۢ سَـٰٓئِحَـٰتٍۢ",1954],["66:12:17",561,"ٱلْقَـٰنِتِينَ","the devoutly obedient","وَكُتُبِهِۦ وَكَانَتْ مِنَ","",995]]