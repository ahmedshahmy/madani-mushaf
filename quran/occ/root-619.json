[["20:39:2",314,"ٱقْذِفِيهِ","cast him","أَنِ","فِى ٱلتَّابُوتِ فَٱقْذِفِيهِ",916],["20:39:5",314,"فَٱقْذِفِيهِ","then cast it","ٱقْذِفِيهِ فِى ٱلتَّابُوتِ","فِى ٱلْيَمِّ فَلْيُلْقِهِ",916],["20:87:12",317,"فَقَذَفْنَـٰهَا","so we threw them","مِّن زِينَةِ ٱلْقَوْمِ","فَكَذَٰلِكَ أَلْقَى ٱلسَّامِرِىُّ",916],["21:18:2",323,"نَقْذِفُ","We hurl","بَلْ","بِٱلْحَقِّ عَلَى ٱلْبَـٰطِلِ",916],["33:26:9",421,"وَقَذَفَ","and cast","ٱلْكِتَـٰبِ مِن صَيَاصِيهِمْ","فِى قُلُوبِهِمُ ٱلرُّعْبَ",916],["34:48:4",433,"يَقْذِفُ","projects","قُلْ إِنَّ رَبِّى","بِٱلْحَقِّ عَلَّـٰمُ ٱلْغُيُوبِ",916],["34:53:6",434,"وَيَقْذِفُونَ","And they utter conjectures","بِهِۦ مِن قَبْلُ ۖ","بِٱلْغَيْبِ مِن مَّكَانٍۭ",916],["37:8:6",446,"وَيُقْذَفُونَ","are pelted","إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ","مِن كُلِّ جَانِبٍۢ",916],["59:2:29",545,"وَقَذَفَ","and He cast","حَيْثُ لَمْ يَحْتَسِبُوا۟ ۖ","فِى قُلُوبِهِمُ ٱلرُّعْبَ ۚ",916]]