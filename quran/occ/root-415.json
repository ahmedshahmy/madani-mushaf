[["2:115:3",18,"وَٱلْمَغْرِبُ ۚ","and the west","وَلِلَّهِ ٱلْمَشْرِقُ","فَأَيْنَمَا تُوَلُّوا۟ فَثَمَّ",844],["2:142:15",22,"وَٱلْمَغْرِبُ ۚ","and the west","قُل لِّلَّهِ ٱلْمَشْرِقُ","يَهْدِى مَن يَشَآءُ",844],["2:177:8",27,"وَٱلْمَغْرِبِ","and the west","وُجُوهَكُمْ قِبَلَ ٱلْمَشْرِقِ","وَلَـٰكِنَّ ٱلْبِرَّ مَنْ",844],["2:258:35",43,"ٱلْمَغْرِبِ","the west","فَأْتِ بِهَا مِنَ","فَبُهِتَ ٱلَّذِى كَفَرَ ۗ",844],["5:31:3",112,"غُرَابًۭا","a crow","فَبَعَثَ ٱللَّهُ","يَبْحَثُ فِى ٱلْأَرْضِ",2382],["5:31:19",112,"ٱلْغُرَابِ","[the] crow","أَكُونَ مِثْلَ هَـٰذَا","فَأُوَٰرِىَ سَوْءَةَ أَخِى ۖ",2382],["7:137:8",166,"وَمَغَـٰرِبَهَا","and the western (parts) of it","يُسْتَضْعَفُونَ مَشَـٰرِقَ ٱلْأَرْضِ","ٱلَّتِى بَـٰرَكْنَا فِيهَا ۖ",844],["18:17:11",295,"غَرَبَت","it set","ذَاتَ ٱلْيَمِينِ وَإِذَا","تَّقْرِضُهُمْ ذَاتَ ٱلشِّمَالِ",2374],["18:86:4",303,"مَغْرِبَ","(the) setting place","حَتَّىٰٓ إِذَا بَلَغَ","ٱلشَّمْسِ وَجَدَهَا تَغْرُبُ",844],["18:86:7",303,"تَغْرُبُ","setting","مَغْرِبَ ٱلشَّمْسِ وَجَدَهَا","فِى عَيْنٍ حَمِئَةٍۢ",2374],["20:130:12",321,"غُرُوبِهَا ۖ","its setting","طُلُوعِ ٱلشَّمْسِ وَقَبْلَ","وَمِنْ ءَانَآئِ ٱلَّيْلِ",2383],["24:35:25",354,"غَرْبِيَّةٍۢ","(of the) west","لَّا شَرْقِيَّةٍۢ وَلَا","يَكَادُ زَيْتُهَا يُضِىٓءُ",3466],["26:28:4",368,"وَٱلْمَغْرِبِ","and the west","قَالَ رَبُّ ٱلْمَشْرِقِ","وَمَا بَيْنَهُمَآ ۖ إِن",844],["28:44:4",391,"ٱلْغَرْبِىِّ","western","وَمَا كُنتَ بِجَانِبِ","إِذْ قَضَيْنَآ إِلَىٰ",3465],["35:27:21",437,"وَغَرَابِيبُ","and intensely black","وَحُمْرٌۭ مُّخْتَلِفٌ أَلْوَٰنُهَا","سُودٌۭ",3462],["50:39:12",520,"ٱلْغُرُوبِ","the setting","طُلُوعِ ٱلشَّمْسِ وَقَبْلَ","",2383],["55:17:4",531,"ٱلْمَغْرِبَيْنِ","(of) the two Wests","رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ","",844],["70:40:5",569,"وَٱلْمَغَـٰرِبِ","and the settings","أُقْسِمُ بِرَبِّ ٱلْمَشَـٰرِقِ","إِنَّا لَقَـٰدِرُونَ",844],["73:9:3",574,"وَٱلْمَغْرِبِ","and the west","رَّبُّ ٱلْمَشْرِقِ","لَآ إِلَـٰهَ إِلَّا",844]]