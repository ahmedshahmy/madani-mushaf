[["4:35:15",84,"يُوَفِّقِ","will cause reconciliation","إِن يُرِيدَآ إِصْلَـٰحًۭا","ٱللَّهُ بَيْنَهُمَآ ۗ إِنَّ",4739],["4:62:16",88,"وَتَوْفِيقًا","and reconciliation","أَرَدْنَآ إِلَّآ إِحْسَـٰنًۭا","",2686],["11:88:29",231,"تَوْفِيقِىٓ","(is) my success","مَا ٱسْتَطَعْتُ ۚ وَمَا","إِلَّا بِٱللَّهِ ۚ عَلَيْهِ",2686],["78:26:2",582,"وِفَاقًا","appropriate","جَزَآءًۭ","",4544]]