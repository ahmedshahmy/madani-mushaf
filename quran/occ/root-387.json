[["2:19:15",4,"حَذَرَ","(in) fear (of)","ءَاذَانِهِم مِّنَ ٱلصَّوَٰعِقِ","ٱلْمَوْتِ ۚ وَٱللَّهُ مُحِيطٌۢ",2264],["2:235:42",38,"فَٱحْذَرُوهُ ۚ","so beware of Him","مَا فِىٓ أَنفُسِكُمْ","وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ",750],["2:243:10",39,"حَذَرَ","(in) fear","دِيَـٰرِهِمْ وَهُمْ أُلُوفٌ","ٱلْمَوْتِ فَقَالَ لَهُمُ",2264],["3:28:22",53,"وَيُحَذِّرُكُمُ","And warns you","تَتَّقُوا۟ مِنْهُمْ تُقَىٰةًۭ ۗ","ٱللَّهُ نَفْسَهُۥ ۗ وَإِلَى",2797],["3:30:21",54,"وَيُحَذِّرُكُمُ","And warns you","وَبَيْنَهُۥٓ أَمَدًۢا بَعِيدًۭا ۗ","ٱللَّهُ نَفْسَهُۥ ۗ وَٱللَّهُ",2797],["4:71:5",89,"حِذْرَكُمْ","your precautions","ٱلَّذِينَ ءَامَنُوا۟ خُذُوا۟","فَٱنفِرُوا۟ ثُبَاتٍ أَوِ",1787],["4:102:26",95,"حِذْرَهُمْ","their precautions","فَلْيُصَلُّوا۟ مَعَكَ وَلْيَأْخُذُوا۟","وَأَسْلِحَتَهُمْ ۗ وَدَّ ٱلَّذِينَ",1787],["4:102:56",95,"حِذْرَكُمْ ۗ","your precautions","تَضَعُوٓا۟ أَسْلِحَتَكُمْ ۖ وَخُذُوا۟","إِنَّ ٱللَّهَ أَعَدَّ",1787],["5:41:40",114,"فَٱحْذَرُوا۟ ۚ","then beware","وَإِن لَّمْ تُؤْتَوْهُ","وَمَن يُرِدِ ٱللَّهُ",750],["5:49:10",116,"وَٱحْذَرْهُمْ","and beware of them","وَلَا تَتَّبِعْ أَهْوَآءَهُمْ","أَن يَفْتِنُوكَ عَنۢ",750],["5:92:5",123,"وَٱحْذَرُوا۟ ۚ","and beware","ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ","فَإِن تَوَلَّيْتُمْ فَٱعْلَمُوٓا۟",750],["9:64:1",197,"يَحْذَرُ","Fear","","ٱلْمُنَـٰفِقُونَ أَن تُنَزَّلَ",750],["9:64:17",197,"تَحْذَرُونَ","you fear","ٱللَّهَ مُخْرِجٌۭ مَّا","",750],["9:122:22",206,"يَحْذَرُونَ","beware","رَجَعُوٓا۟ إِلَيْهِمْ لَعَلَّهُمْ","",750],["17:57:18",287,"مَحْذُورًۭا","(ever) feared","عَذَابَ رَبِّكَ كَانَ","",3638],["24:63:16",359,"فَلْيَحْذَرِ","So let beware","يَتَسَلَّلُونَ مِنكُمْ لِوَاذًۭا ۚ","ٱلَّذِينَ يُخَالِفُونَ عَنْ",750],["26:56:3",369,"حَـٰذِرُونَ","forewarned","وَإِنَّا لَجَمِيعٌ","",3173],["28:6:12",386,"يَحْذَرُونَ","fearing","مِنْهُم مَّا كَانُوا۟","",750],["39:9:8",459,"يَحْذَرُ","fearing","ٱلَّيْلِ سَاجِدًۭا وَقَآئِمًۭا","ٱلْـَٔاخِرَةَ وَيَرْجُوا۟ رَحْمَةَ",750],["63:4:18",554,"فَٱحْذَرْهُمْ ۚ","so beware of them","عَلَيْهِمْ ۚ هُمُ ٱلْعَدُوُّ","قَـٰتَلَهُمُ ٱللَّهُ ۖ أَنَّىٰ",750],["64:14:10",557,"فَٱحْذَرُوهُمْ ۚ","so beware of them","وَأَوْلَـٰدِكُمْ عَدُوًّۭا لَّكُمْ","وَإِن تَعْفُوا۟ وَتَصْفَحُوا۟",750]]