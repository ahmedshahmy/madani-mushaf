[["2:237:11",38,"فَنِصْفُ","then (give) half","فَرَضْتُمْ لَهُنَّ فَرِيضَةًۭ","مَا فَرَضْتُمْ إِلَّآ",1092],["4:11:22",78,"ٱلنِّصْفُ ۚ","(is) half","كَانَتْ وَٰحِدَةًۭ فَلَهَا","وَلِأَبَوَيْهِ لِكُلِّ وَٰحِدٍۢ",1092],["4:12:2",79,"نِصْفُ","(is) half","۞ وَلَكُمْ","مَا تَرَكَ أَزْوَٰجُكُمْ",1092],["4:25:41",82,"نِصْفُ","(is) half","أَتَيْنَ بِفَـٰحِشَةٍۢ فَعَلَيْهِنَّ","مَا عَلَى ٱلْمُحْصَنَـٰتِ",1092],["4:176:16",106,"نِصْفُ","(is) a half","وَلَهُۥٓ أُخْتٌۭ فَلَهَا","مَا تَرَكَ ۚ وَهُوَ",1092],["73:3:1",574,"نِّصْفَهُۥٓ","Half of it","","أَوِ ٱنقُصْ مِنْهُ",1092],["73:20:10",575,"وَنِصْفَهُۥ","and half of it","مِن ثُلُثَىِ ٱلَّيْلِ","وَثُلُثَهُۥ وَطَآئِفَةٌۭ مِّنَ",1092]]