[["2:76:18",11,"لِيُحَآجُّوكُم","so that they argue with you","فَتَحَ ٱللَّهُ عَلَيْكُمْ","بِهِۦ عِندَ رَبِّكُمْ ۚ",718],["2:139:2",21,"أَتُحَآجُّونَنَا","Do you argue with us","قُلْ","فِى ٱللَّهِ وَهُوَ",718],["2:150:19",23,"حُجَّةٌ","any argument","يَكُونَ لِلنَّاسِ عَلَيْكُمْ","إِلَّا ٱلَّذِينَ ظَلَمُوا۟",1059],["2:158:8",24,"حَجَّ","performs Hajj","شَعَآئِرِ ٱللَّهِ ۖ فَمَنْ","ٱلْبَيْتَ أَوِ ٱعْتَمَرَ",3182],["2:189:8",29,"وَٱلْحَجِّ ۗ","and (for) the Hajj","هِىَ مَوَٰقِيتُ لِلنَّاسِ","وَلَيْسَ ٱلْبِرُّ بِأَن",887],["2:196:2",30,"ٱلْحَجَّ","the Hajj","وَأَتِمُّوا۟","وَٱلْعُمْرَةَ لِلَّهِ ۚ فَإِنْ",887],["2:196:40",30,"ٱلْحَجِّ","(by) the Hajj","تَمَتَّعَ بِٱلْعُمْرَةِ إِلَى","فَمَا ٱسْتَيْسَرَ مِنَ",887],["2:196:52",30,"ٱلْحَجِّ","the Hajj","ثَلَـٰثَةِ أَيَّامٍۢ فِى","وَسَبْعَةٍ إِذَا رَجَعْتُمْ ۗ",887],["2:197:1",31,"ٱلْحَجُّ","(For) the Hajj","","أَشْهُرٌۭ مَّعْلُومَـٰتٌۭ ۚ فَمَن",887],["2:197:7",31,"ٱلْحَجَّ","the Hajj","فَمَن فَرَضَ فِيهِنَّ","فَلَا رَفَثَ وَلَا",887],["2:197:15",31,"ٱلْحَجِّ ۗ","the Hajj","وَلَا جِدَالَ فِى","وَمَا تَفْعَلُوا۟ مِنْ",887],["2:258:5",43,"حَآجَّ","argued","تَرَ إِلَى ٱلَّذِى","إِبْرَٰهِـۧمَ فِى رَبِّهِۦٓ",718],["3:20:2",52,"حَآجُّوكَ","they argue with you","فَإِنْ","فَقُلْ أَسْلَمْتُ وَجْهِىَ",718],["3:61:2",57,"حَآجَّكَ","argues (with) you","فَمَنْ","فِيهِ مِنۢ بَعْدِ",718],["3:65:4",58,"تُحَآجُّونَ","(do) you argue","يَـٰٓأَهْلَ ٱلْكِتَـٰبِ لِمَ","فِىٓ إِبْرَٰهِيمَ وَمَآ",718],["3:66:3",58,"حَـٰجَجْتُمْ","argued","هَـٰٓأَنتُمْ هَـٰٓؤُلَآءِ","فِيمَا لَكُم بِهِۦ",718],["3:66:9",58,"تُحَآجُّونَ","(do) you argue","بِهِۦ عِلْمٌۭ فَلِمَ","فِيمَا لَيْسَ لَكُم",718],["3:73:19",59,"يُحَآجُّوكُمْ","they may argue with you","مَآ أُوتِيتُمْ أَوْ","عِندَ رَبِّكُمْ ۗ قُلْ",718],["3:97:13",62,"حِجُّ","(is) pilgrimage","وَلِلَّهِ عَلَى ٱلنَّاسِ","ٱلْبَيْتِ مَنِ ٱسْتَطَاعَ",3210],["4:165:9",104,"حُجَّةٌۢ","any argument","لِلنَّاسِ عَلَى ٱللَّهِ","بَعْدَ ٱلرُّسُلِ ۚ وَكَانَ",1059],["6:80:1",137,"وَحَآجَّهُۥ","And argued with him","","قَوْمُهُۥ ۚ قَالَ أَتُحَـٰٓجُّوٓنِّى",718],["6:80:4",137,"أَتُحَـٰٓجُّوٓنِّى","Do you argue with me","وَحَآجَّهُۥ قَوْمُهُۥ ۚ قَالَ","فِى ٱللَّهِ وَقَدْ",718],["6:83:2",138,"حُجَّتُنَآ","(is) Our argument","وَتِلْكَ","ءَاتَيْنَـٰهَآ إِبْرَٰهِيمَ عَلَىٰ",1059],["6:149:3",148,"ٱلْحُجَّةُ","(is) the argument","قُلْ فَلِلَّهِ","ٱلْبَـٰلِغَةُ ۖ فَلَوْ شَآءَ",1059],["9:3:8",187,"ٱلْحَجِّ","(of) the greater Pilgrimage","إِلَى ٱلنَّاسِ يَوْمَ","ٱلْأَكْبَرِ أَنَّ ٱللَّهَ",887],["9:19:3",189,"ٱلْحَآجِّ","(to) the pilgrims","۞ أَجَعَلْتُمْ سِقَايَةَ","وَعِمَارَةَ ٱلْمَسْجِدِ ٱلْحَرَامِ",3162],["22:27:4",335,"بِٱلْحَجِّ","[of] the Pilgrimage","وَأَذِّن فِى ٱلنَّاسِ","يَأْتُوكَ رِجَالًۭا وَعَلَىٰ",887],["28:27:13",388,"حِجَجٍۢ ۖ","years","أَن تَأْجُرَنِى ثَمَـٰنِىَ","فَإِنْ أَتْمَمْتَ عَشْرًۭا",3209],["40:47:2",472,"يَتَحَآجُّونَ","they will dispute","وَإِذْ","فِى ٱلنَّارِ فَيَقُولُ",4670],["42:15:27",484,"حُجَّةَ","argument","وَلَكُمْ أَعْمَـٰلُكُمْ ۖ لَا","بَيْنَنَا وَبَيْنَكُمُ ۖ ٱللَّهُ",1059],["42:16:2",485,"يُحَآجُّونَ","argue","وَٱلَّذِينَ","فِى ٱللَّهِ مِنۢ",718],["42:16:10",485,"حُجَّتُهُمْ","their argument","مَا ٱسْتُجِيبَ لَهُۥ","دَاحِضَةٌ عِندَ رَبِّهِمْ",1059],["45:25:8",501,"حُجَّتَهُمْ","their argument","بَيِّنَـٰتٍۢ مَّا كَانَ","إِلَّآ أَن قَالُوا۟",1059]]