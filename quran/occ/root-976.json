[["58:11:7",543,"تَفَسَّحُوا۟","Make room","إِذَا قِيلَ لَكُمْ","فِى ٱلْمَجَـٰلِسِ فَٱفْسَحُوا۟",4368],["58:11:10",543,"فَٱفْسَحُوا۟","then make room","تَفَسَّحُوا۟ فِى ٱلْمَجَـٰلِسِ","يَفْسَحِ ٱللَّهُ لَكُمْ ۖ",2767],["58:11:11",543,"يَفْسَحِ","Allah will make room","فِى ٱلْمَجَـٰلِسِ فَٱفْسَحُوا۟","ٱللَّهُ لَكُمْ ۖ وَإِذَا",2767]]