[["7:137:21",166,"وَدَمَّرْنَا","And We destroyed","إِسْرَٰٓءِيلَ بِمَا صَبَرُوا۟ ۖ","مَا كَانَ يَصْنَعُ",972],["17:16:13",283,"فَدَمَّرْنَـٰهَا","and We destroy it","فَحَقَّ عَلَيْهَا ٱلْقَوْلُ","تَدْمِيرًۭا",972],["17:16:14",283,"تَدْمِيرًۭا","(with) destruction","عَلَيْهَا ٱلْقَوْلُ فَدَمَّرْنَـٰهَا","",2665],["25:36:8",363,"فَدَمَّرْنَـٰهُمْ","Then We destroyed them","ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا","تَدْمِيرًۭا",972],["25:36:9",363,"تَدْمِيرًۭا","(with) destruction","كَذَّبُوا۟ بِـَٔايَـٰتِنَا فَدَمَّرْنَـٰهُمْ","",2665],["26:172:2",374,"دَمَّرْنَا","We destroyed","ثُمَّ","ٱلْـَٔاخَرِينَ",972],["27:51:7",381,"دَمَّرْنَـٰهُمْ","destroyed them","عَـٰقِبَةُ مَكْرِهِمْ أَنَّا","وَقَوْمَهُمْ أَجْمَعِينَ",972],["37:136:2",451,"دَمَّرْنَا","We destroyed","ثُمَّ","ٱلْـَٔاخَرِينَ",972],["46:25:1",505,"تُدَمِّرُ","Destroying","","كُلَّ شَىْءٍۭ بِأَمْرِ",972],["47:10:12",507,"دَمَّرَ","Allah destroyed","ٱلَّذِينَ مِن قَبْلِهِمْ ۚ","ٱللَّهُ عَلَيْهِمْ ۖ وَلِلْكَـٰفِرِينَ",972]]