[["2:67:15",10,"أَعُوذُ","I seek refuge","أَتَتَّخِذُنَا هُزُوًۭا ۖ قَالَ","بِٱللَّهِ أَنْ أَكُونَ",821],["3:36:19",54,"أُعِيذُهَا","[I] seek refuge for her","سَمَّيْتُهَا مَرْيَمَ وَإِنِّىٓ","بِكَ وَذُرِّيَّتَهَا مِنَ",3064],["7:200:6",176,"فَٱسْتَعِذْ","then seek refuge","مِنَ ٱلشَّيْطَـٰنِ نَزْغٌۭ","بِٱللَّهِ ۚ إِنَّهُۥ سَمِيعٌ",1697],["11:47:4",227,"أَعُوذُ","seek refuge","قَالَ رَبِّ إِنِّىٓ","بِكَ أَنْ أَسْـَٔلَكَ",821],["12:23:14",238,"مَعَاذَ","I seek refuge in Allah","هَيْتَ لَكَ ۚ قَالَ","ٱللَّهِ ۖ إِنَّهُۥ رَبِّىٓ",2441],["12:79:2",245,"مَعَاذَ","Allah forbid","قَالَ","ٱللَّهِ أَن نَّأْخُذَ",2441],["16:98:4",278,"فَٱسْتَعِذْ","seek refuge","فَإِذَا قَرَأْتَ ٱلْقُرْءَانَ","بِٱللَّهِ مِنَ ٱلشَّيْطَـٰنِ",1697],["19:18:3",306,"أَعُوذُ","[I] seek refuge","قَالَتْ إِنِّىٓ","بِٱلرَّحْمَـٰنِ مِنكَ إِن",821],["23:97:3",348,"أَعُوذُ","I seek refuge","وَقُل رَّبِّ","بِكَ مِنْ هَمَزَٰتِ",821],["23:98:1",348,"وَأَعُوذُ","And I seek refuge","","بِكَ رَبِّ أَن",821],["40:27:4",470,"عُذْتُ","[I] seek refuge","وَقَالَ مُوسَىٰٓ إِنِّى","بِرَبِّى وَرَبِّكُم مِّن",821],["40:56:18",473,"فَٱسْتَعِذْ","So seek refuge","مَّا هُم بِبَـٰلِغِيهِ ۚ","بِٱللَّهِ ۖ إِنَّهُۥ هُوَ",1697],["41:36:6",480,"فَٱسْتَعِذْ","then seek refuge","مِنَ ٱلشَّيْطَـٰنِ نَزْغٌۭ","بِٱللَّهِ ۖ إِنَّهُۥ هُوَ",1697],["44:20:2",497,"عُذْتُ","[I] seek refuge","وَإِنِّى","بِرَبِّى وَرَبِّكُمْ أَن",821],["72:6:6",572,"يَعُوذُونَ","who sought refuge","رِجَالٌۭ مِّنَ ٱلْإِنسِ","بِرِجَالٍۢ مِّنَ ٱلْجِنِّ",821],["113:1:2",604,"أَعُوذُ","I seek refuge","قُلْ","بِرَبِّ ٱلْفَلَقِ",821],["114:1:2",604,"أَعُوذُ","I seek refuge","قُلْ","بِرَبِّ ٱلنَّاسِ",821]]