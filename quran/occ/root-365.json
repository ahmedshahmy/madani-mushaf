[["2:177:31",27,"ٱلرِّقَابِ","freeing the necks (slaves)","ٱلسَّبِيلِ وَٱلسَّآئِلِينَ وَفِى","وَأَقَامَ ٱلصَّلَوٰةَ وَءَاتَى",920],["4:1:28",77,"رَقِيبًۭا","Ever-Watchful","ٱللَّهَ كَانَ عَلَيْكُمْ","",1390],["4:92:14",93,"رَقَبَةٍۢ","(of) a slave","مُؤْمِنًا خَطَـًۭٔا فَتَحْرِيرُ","مُّؤْمِنَةٍۢ وَدِيَةٌۭ مُّسَلَّمَةٌ",920],["4:92:32",93,"رَقَبَةٍۢ","(of) a believing slave","وَهُوَ مُؤْمِنٌۭ فَتَحْرِيرُ","مُّؤْمِنَةٍۢ ۖ وَإِن كَانَ",920],["4:92:46",93,"رَقَبَةٍۢ","(of) a slave","إِلَىٰٓ أَهْلِهِۦ وَتَحْرِيرُ","مُّؤْمِنَةٍۢ ۖ فَمَن لَّمْ",920],["5:89:25",122,"رَقَبَةٍۢ ۖ","a slave","كِسْوَتُهُمْ أَوْ تَحْرِيرُ","فَمَن لَّمْ يَجِدْ",920],["5:117:23",127,"ٱلرَّقِيبَ","the Watcher","تَوَفَّيْتَنِى كُنتَ أَنتَ","عَلَيْهِمْ ۚ وَأَنتَ عَلَىٰ",1390],["9:8:6",188,"يَرْقُبُوا۟","they do not regard (the ties)","يَظْهَرُوا۟ عَلَيْكُمْ لَا","فِيكُمْ إِلًّۭا وَلَا",2064],["9:10:2",188,"يَرْقُبُونَ","they respect (the ties)","لَا","فِى مُؤْمِنٍ إِلًّۭا",2064],["9:60:10",196,"ٱلرِّقَابِ","the (freeing of) the necks","وَٱلْمُؤَلَّفَةِ قُلُوبُهُمْ وَفِى","وَٱلْغَـٰرِمِينَ وَفِى سَبِيلِ",920],["11:93:16",232,"وَٱرْتَقِبُوٓا۟","And watch","وَمَنْ هُوَ كَـٰذِبٌۭ ۖ","إِنِّى مَعَكُمْ رَقِيبٌۭ",1696],["11:93:19",232,"رَقِيبٌۭ","a watcher","وَٱرْتَقِبُوٓا۟ إِنِّى مَعَكُمْ","",1390],["20:94:17",318,"تَرْقُبْ","you respect","بَنِىٓ إِسْرَٰٓءِيلَ وَلَمْ","قَوْلِى",2064],["28:18:5",387,"يَتَرَقَّبُ","(and) was vigilant","فِى ٱلْمَدِينَةِ خَآئِفًۭا","فَإِذَا ٱلَّذِى ٱسْتَنصَرَهُۥ",2785],["28:21:4",387,"يَتَرَقَّبُ ۖ","(and) vigilant","فَخَرَجَ مِنْهَا خَآئِفًۭا","قَالَ رَبِّ نَجِّنِى",2785],["33:52:25",425,"رَّقِيبًۭا","an Observer","عَلَىٰ كُلِّ شَىْءٍۢ","",1390],["44:10:1",496,"فَٱرْتَقِبْ","Then watch","","يَوْمَ تَأْتِى ٱلسَّمَآءُ",1696],["44:59:1",498,"فَٱرْتَقِبْ","So watch","","إِنَّهُم مُّرْتَقِبُونَ",1696],["44:59:3",498,"مُّرْتَقِبُونَ","(too are) watching","فَٱرْتَقِبْ إِنَّهُم","",3987],["47:4:6",507,"ٱلرِّقَابِ","the necks","ٱلَّذِينَ كَفَرُوا۟ فَضَرْبَ","حَتَّىٰٓ إِذَآ أَثْخَنتُمُوهُمْ",920],["50:18:7",519,"رَقِيبٌ","(is) an observer","قَوْلٍ إِلَّا لَدَيْهِ","عَتِيدٌۭ",1390],["54:27:6",529,"فَٱرْتَقِبْهُمْ","so watch them","ٱلنَّاقَةِ فِتْنَةًۭ لَّهُمْ","وَٱصْطَبِرْ",1696],["58:3:10",542,"رَقَبَةٍۢ","(of) a slave","لِمَا قَالُوا۟ فَتَحْرِيرُ","مِّن قَبْلِ أَن",920],["90:13:2",594,"رَقَبَةٍ","a neck","فَكُّ","",920]]