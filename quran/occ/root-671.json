[["4:78:8",90,"بُرُوجٍۢ","towers","وَلَوْ كُنتُمْ فِى","مُّشَيَّدَةٍۢ ۗ وَإِن تُصِبْهُمْ",1539],["15:16:5",263,"بُرُوجًۭا","constellations","جَعَلْنَا فِى ٱلسَّمَآءِ","وَزَيَّنَّـٰهَا لِلنَّـٰظِرِينَ",1539],["24:60:15",358,"مُتَبَرِّجَـٰتٍۭ","displaying","يَضَعْنَ ثِيَابَهُنَّ غَيْرَ","بِزِينَةٍۢ ۖ وَأَن يَسْتَعْفِفْنَ",3871],["25:61:6",365,"بُرُوجًۭا","constellations","جَعَلَ فِى ٱلسَّمَآءِ","وَجَعَلَ فِيهَا سِرَٰجًۭا",1539],["33:33:5",422,"تَبَرَّجْنَ","display yourselves","فِى بُيُوتِكُنَّ وَلَا","تَبَرُّجَ ٱلْجَـٰهِلِيَّةِ ٱلْأُولَىٰ ۖ",4351],["33:33:6",422,"تَبَرُّجَ","(as was the) display","بُيُوتِكُنَّ وَلَا تَبَرَّجْنَ","ٱلْجَـٰهِلِيَّةِ ٱلْأُولَىٰ ۖ وَأَقِمْنَ",4352],["85:1:3",590,"ٱلْبُرُوجِ","the constellations","وَٱلسَّمَآءِ ذَاتِ","",1539]]