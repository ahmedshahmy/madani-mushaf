[["4:77:17",90,"إِذَا","then","كُتِبَ عَلَيْهِمُ ٱلْقِتَالُ","فَرِيقٌۭ مِّنْهُمْ يَخْشَوْنَ",645],["7:107:3",164,"فَإِذَا","and suddenly","فَأَلْقَىٰ عَصَاهُ","هِىَ ثُعْبَانٌۭ مُّبِينٌۭ",645],["7:108:3",164,"فَإِذَا","and suddenly","وَنَزَعَ يَدَهُۥ","هِىَ بَيْضَآءُ لِلنَّـٰظِرِينَ",645],["7:117:7",164,"فَإِذَا","and suddenly","أَنْ أَلْقِ عَصَاكَ ۖ","هِىَ تَلْقَفُ مَا",645],["10:21:9",211,"إِذَا","behold","بَعْدِ ضَرَّآءَ مَسَّتْهُمْ","لَهُم مَّكْرٌۭ فِىٓ",645],["10:23:3",211,"إِذَا","behold","فَلَمَّآ أَنجَىٰهُمْ","هُمْ يَبْغُونَ فِى",645],["20:20:2",313,"فَإِذَا","and behold","فَأَلْقَىٰهَا","هِىَ حَيَّةٌۭ تَسْعَىٰ",645],["20:66:4",316,"فَإِذَا","Then behold","قَالَ بَلْ أَلْقُوا۟ ۖ","حِبَالُهُمْ وَعِصِيُّهُمْ يُخَيَّلُ",645],["29:65:14",404,"إِذَا","behold","نَجَّىٰهُمْ إِلَى ٱلْبَرِّ","هُمْ يُشْرِكُونَ",645],["30:25:14",407,"إِذَآ","behold","دَعْوَةًۭ مِّنَ ٱلْأَرْضِ","أَنتُمْ تَخْرُجُونَ",645],["30:36:13",408,"إِذَا","behold","بِمَا قَدَّمَتْ أَيْدِيهِمْ","هُمْ يَقْنَطُونَ",645],["36:29:6",442,"فَإِذَا","then behold","إِلَّا صَيْحَةًۭ وَٰحِدَةًۭ","هُمْ خَـٰمِدُونَ",645],["67:16:9",563,"فَإِذَا","when","يَخْسِفَ بِكُمُ ٱلْأَرْضَ","هِىَ تَمُورُ",645],["79:14:1",583,"فَإِذَا","And behold","","هُم بِٱلسَّاهِرَةِ",645]]