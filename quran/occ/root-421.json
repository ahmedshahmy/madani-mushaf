[["2:219:26",34,"تَتَفَكَّرُونَ","ponder","لَكُمُ ٱلْـَٔايَـٰتِ لَعَلَّكُمْ","",583],["2:266:35",45,"تَتَفَكَّرُونَ","ponder","لَكُمُ ٱلْـَٔايَـٰتِ لَعَلَّكُمْ","",583],["3:191:8",75,"وَيَتَفَكَّرُونَ","and they reflect","وَقُعُودًۭا وَعَلَىٰ جُنُوبِهِمْ","فِى خَلْقِ ٱلسَّمَـٰوَٰتِ",583],["6:50:28",133,"تَتَفَكَّرُونَ","you give thought","ٱلْأَعْمَىٰ وَٱلْبَصِيرُ ۚ أَفَلَا","",583],["7:176:30",173,"يَتَفَكَّرُونَ","reflect","فَٱقْصُصِ ٱلْقَصَصَ لَعَلَّهُمْ","",583],["7:184:2",174,"يَتَفَكَّرُوا۟ ۗ","they reflect","أَوَلَمْ","مَا بِصَاحِبِهِم مِّن",583],["10:24:43",211,"يَتَفَكَّرُونَ","who reflect","نُفَصِّلُ ٱلْـَٔايَـٰتِ لِقَوْمٍۢ","",583],["13:3:24",249,"يَتَفَكَّرُونَ","who ponder","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ","",583],["16:11:16",268,"يَتَفَكَّرُونَ","who reflect","ذَٰلِكَ لَـَٔايَةًۭ لِّقَوْمٍۢ","",583],["16:44:12",272,"يَتَفَكَّرُونَ","reflect","نُزِّلَ إِلَيْهِمْ وَلَعَلَّهُمْ","",583],["16:69:24",274,"يَتَفَكَّرُونَ","who reflect","ذَٰلِكَ لَـَٔايَةًۭ لِّقَوْمٍۢ","",583],["30:8:2",405,"يَتَفَكَّرُوا۟","they ponder","أَوَلَمْ","فِىٓ أَنفُسِهِم ۗ مَّا",583],["30:21:20",406,"يَتَفَكَّرُونَ","who reflect","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ","",583],["34:46:11",433,"تَتَفَكَّرُوا۟ ۚ","reflect","مَثْنَىٰ وَفُرَٰدَىٰ ثُمَّ","مَا بِصَاحِبِكُم مِّن",583],["39:42:26",463,"يَتَفَكَّرُونَ","who ponder","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ","",583],["45:13:16",499,"يَتَفَكَّرُونَ","who give thought","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ","",583],["59:21:18",548,"يَتَفَكَّرُونَ","give thought","نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ","",583],["74:18:2",575,"فَكَّرَ","thought","إِنَّهُۥ","وَقَدَّرَ",3414]]