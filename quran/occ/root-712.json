[["2:250:7",41,"أَفْرِغْ","Pour","وَجُنُودِهِۦ قَالُوا۟ رَبَّنَآ","عَلَيْنَا صَبْرًۭا وَثَبِّتْ",1733],["7:126:12",165,"أَفْرِغْ","Pour","لَمَّا جَآءَتْنَا ۚ رَبَّنَآ","عَلَيْنَا صَبْرًۭا وَتَوَفَّنَا",1733],["18:96:17",303,"أُفْرِغْ","I pour","نَارًۭا قَالَ ءَاتُونِىٓ","عَلَيْهِ قِطْرًۭا",1733],["28:10:5",386,"فَـٰرِغًا ۖ","empty","فُؤَادُ أُمِّ مُوسَىٰ","إِن كَادَتْ لَتُبْدِى",3404],["55:31:1",532,"سَنَفْرُغُ","Soon We will attend","","لَكُمْ أَيُّهَ ٱلثَّقَلَانِ",2363],["94:7:2",597,"فَرَغْتَ","you have finished","فَإِذَا","فَٱنصَبْ",2363]]