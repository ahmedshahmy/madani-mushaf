[["9:29:24",191,"يُعْطُوا۟","they pay","أُوتُوا۟ ٱلْكِتَـٰبَ حَتَّىٰ","ٱلْجِزْيَةَ عَن يَدٍۢ",951],["9:58:7",196,"أُعْطُوا۟","they are given","فِى ٱلصَّدَقَـٰتِ فَإِنْ","مِنْهَا رَضُوا۟ وَإِن",951],["9:58:12",196,"يُعْطَوْا۟","they are given","رَضُوا۟ وَإِن لَّمْ","مِنْهَآ إِذَا هُمْ",951],["11:108:16",233,"عَطَآءً","a bestowal","مَا شَآءَ رَبُّكَ ۖ","غَيْرَ مَجْذُوذٍۢ",1289],["17:20:6",284,"عَطَآءِ","(the) gift","هَـٰٓؤُلَآءِ وَهَـٰٓؤُلَآءِ مِنْ","رَبِّكَ ۚ وَمَا كَانَ",1289],["17:20:10",284,"عَطَآءُ","(the) gift","رَبِّكَ ۚ وَمَا كَانَ","رَبِّكَ مَحْظُورًا",1289],["20:50:4",314,"أَعْطَىٰ","gave","قَالَ رَبُّنَا ٱلَّذِىٓ","كُلَّ شَىْءٍ خَلْقَهُۥ",951],["38:39:2",455,"عَطَآؤُنَا","(is) Our gift","هَـٰذَا","فَٱمْنُنْ أَوْ أَمْسِكْ",1289],["53:34:1",527,"وَأَعْطَىٰ","And gave","","قَلِيلًۭا وَأَكْدَىٰٓ",951],["54:29:3",530,"فَتَعَاطَىٰ","and he took","فَنَادَوْا۟ صَاحِبَهُمْ","فَعَقَرَ",4318],["78:36:4",583,"عَطَآءً","a gift","جَزَآءًۭ مِّن رَّبِّكَ","حِسَابًۭا",1289],["92:5:3",595,"أَعْطَىٰ","gives","فَأَمَّا مَنْ","وَٱتَّقَىٰ",951],["93:5:2",596,"يُعْطِيكَ","will give you","وَلَسَوْفَ","رَبُّكَ فَتَرْضَىٰٓ",951],["108:1:2",602,"أَعْطَيْنَـٰكَ","We have given you","إِنَّآ","ٱلْكَوْثَرَ",951]]