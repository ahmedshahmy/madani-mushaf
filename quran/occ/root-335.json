[["3:137:6",67,"فَسِيرُوا۟","then travel","مِن قَبْلِكُمْ سُنَنٌۭ","فِى ٱلْأَرْضِ فَٱنظُرُوا۟",603],["5:96:8",124,"وَلِلسَّيَّارَةِ ۖ","and for the travelers","وَطَعَامُهُۥ مَتَـٰعًۭا لَّكُمْ","وَحُرِّمَ عَلَيْكُمْ صَيْدُ",1991],["6:11:2",129,"سِيرُوا۟","Travel","قُلْ","فِى ٱلْأَرْضِ ثُمَّ",603],["10:22:3",211,"يُسَيِّرُكُمْ","enables you to travel","هُوَ ٱلَّذِى","فِى ٱلْبَرِّ وَٱلْبَحْرِ ۖ",1396],["12:10:13",236,"ٱلسَّيَّارَةِ","[the] caravan","ٱلْجُبِّ يَلْتَقِطْهُ بَعْضُ","إِن كُنتُمْ فَـٰعِلِينَ",1991],["12:19:2",237,"سَيَّارَةٌۭ","a caravan","وَجَآءَتْ","فَأَرْسَلُوا۟ وَارِدَهُمْ فَأَدْلَىٰ",1991],["12:109:13",248,"يَسِيرُوا۟","they traveled","أَهْلِ ٱلْقُرَىٰٓ ۗ أَفَلَمْ","فِى ٱلْأَرْضِ فَيَنظُرُوا۟",603],["13:31:4",253,"سُيِّرَتْ","could be moved","وَلَوْ أَنَّ قُرْءَانًۭا","بِهِ ٱلْجِبَالُ أَوْ",1396],["16:36:21",271,"فَسِيرُوا۟","So travel","حَقَّتْ عَلَيْهِ ٱلضَّلَـٰلَةُ ۚ","فِى ٱلْأَرْضِ فَٱنظُرُوا۟",603],["18:47:2",299,"نُسَيِّرُ","We will cause (to) move","وَيَوْمَ","ٱلْجِبَالَ وَتَرَى ٱلْأَرْضَ",1396],["20:21:6",313,"سِيرَتَهَا","(to) its state","وَلَا تَخَفْ ۖ سَنُعِيدُهَا","ٱلْأُولَىٰ",4269],["22:46:2",337,"يَسِيرُوا۟","they traveled","أَفَلَمْ","فِى ٱلْأَرْضِ فَتَكُونَ",603],["27:69:2",383,"سِيرُوا۟","Travel","قُلْ","فِى ٱلْأَرْضِ فَٱنظُرُوا۟",603],["28:29:5",389,"وَسَارَ","and was traveling","قَضَىٰ مُوسَى ٱلْأَجَلَ","بِأَهْلِهِۦٓ ءَانَسَ مِن",603],["29:20:2",398,"سِيرُوا۟","Travel","قُلْ","فِى ٱلْأَرْضِ فَٱنظُرُوا۟",603],["30:9:2",405,"يَسِيرُوا۟","they traveled","أَوَلَمْ","فِى ٱلْأَرْضِ فَيَنظُرُوا۟",603],["30:42:2",409,"سِيرُوا۟","Travel","قُلْ","فِى ٱلْأَرْضِ فَٱنظُرُوا۟",603],["34:18:12",430,"ٱلسَّيْرَ ۖ","the journey","ظَـٰهِرَةًۭ وَقَدَّرْنَا فِيهَا","سِيرُوا۟ فِيهَا لَيَالِىَ",2634],["34:18:13",430,"سِيرُوا۟","Travel","وَقَدَّرْنَا فِيهَا ٱلسَّيْرَ ۖ","فِيهَا لَيَالِىَ وَأَيَّامًا",603],["35:44:2",439,"يَسِيرُوا۟","traveled","أَوَلَمْ","فِى ٱلْأَرْضِ فَيَنظُرُوا۟",603],["40:21:2",469,"يَسِيرُوا۟","they travel","۞ أَوَلَمْ","فِى ٱلْأَرْضِ