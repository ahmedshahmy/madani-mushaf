[["2:186:17",28,"يَرْشُدُونَ","(be) led aright","وَلْيُؤْمِنُوا۟ بِى لَعَلَّهُمْ","",4651],["2:256:7",42,"ٱلرُّشْدُ","the right (path)","ٱلدِّينِ ۖ قَد تَّبَيَّنَ","مِنَ ٱلْغَىِّ ۚ فَمَن",1224],["4:6:10",77,"رُشْدًۭا","sound judgement","فَإِنْ ءَانَسْتُم مِّنْهُمْ","فَٱدْفَعُوٓا۟ إِلَيْهِمْ أَمْوَٰلَهُمْ ۖ",1224],["7:146:20",168,"ٱلرُّشْدِ","(of) the righteousness","وَإِن يَرَوْا۟ سَبِيلَ","لَا يَتَّخِذُوهُ سَبِيلًۭا",1224],["11:78:26",230,"رَّشِيدٌۭ","right-minded","أَلَيْسَ مِنكُمْ رَجُلٌۭ","",1979],["11:87:20",231,"ٱلرَّشِيدُ","the right-minded","إِنَّكَ لَأَنتَ ٱلْحَلِيمُ","",1979],["11:97:10",232,"بِرَشِيدٍۢ","was right","وَمَآ أَمْرُ فِرْعَوْنَ","",1979],["18:10:16",294,"رَشَدًۭا","(in the) right way","لَنَا مِنْ أَمْرِنَا","",1388],["18:17:34",295,"مُّرْشِدًۭا","a guide","تَجِدَ لَهُۥ وَلِيًّۭا","",3985],["18:24:17",296,"رَشَدًۭا","right way","لِأَقْرَبَ مِنْ هَـٰذَا","",1388],["18:66:11",301,"رُشْدًۭا","(of) right guidance","تُعَلِّمَنِ مِمَّا عُلِّمْتَ","",1224],["21:51:4",326,"رُشْدَهُۥ","his guidance","۞ وَلَقَدْ ءَاتَيْنَآ إِبْرَٰهِيمَ","مِن قَبْلُ وَكُنَّا",1224],["40:29:26",470,"ٱلرَّشَادِ","the right","أَهْدِيكُمْ إِلَّا سَبِيلَ","",2610],["40:38:8",471,"ٱلرَّشَادِ","the right","ٱتَّبِعُونِ أَهْدِكُمْ سَبِيلَ","",2610],["49:7:28",516,"ٱلرَّٰشِدُونَ","the guided ones","وَٱلْعِصْيَانَ ۚ أُو۟لَـٰٓئِكَ هُمُ","",4213],["72:2:3",572,"ٱلرُّشْدِ","the right way","يَهْدِىٓ إِلَى","فَـَٔامَنَّا بِهِۦ ۖ وَلَن",1224],["72:10:13",572,"رَشَدًۭا","a right path","أَرَادَ بِهِمْ رَبُّهُمْ","",1388],["72:14:10",573,"رَشَدًۭا","(the) right path","أَسْلَمَ فَأُو۟لَـٰٓئِكَ تَحَرَّوْا۟","",1388],["72:21:8",573,"رَشَدًۭا","right path","لَكُمْ ضَرًّۭا وَلَا","",1388]]