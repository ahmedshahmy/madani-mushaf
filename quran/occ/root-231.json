[["2:50:4",8,"ٱلْبَحْرَ","the sea","وَإِذْ فَرَقْنَا بِكُمُ","فَأَنجَيْنَـٰكُمْ وَأَغْرَقْنَآ ءَالَ",283],["2:164:13",25,"ٱلْبَحْرِ","the sea","ٱلَّتِى تَجْرِى فِى","بِمَا يَنفَعُ ٱلنَّاسَ",283],["5:96:4",124,"ٱلْبَحْرِ","(of) the sea","أُحِلَّ لَكُمْ صَيْدُ","وَطَعَامُهُۥ مَتَـٰعًۭا لَّكُمْ",283],["5:103:5",124,"بَحِيرَةٍۢ","a Bahirah","جَعَلَ ٱللَّهُ مِنۢ","وَلَا سَآئِبَةٍۢ وَلَا",3325],["6:59:12",134,"وَٱلْبَحْرِ ۚ","and in the sea","مَا فِى ٱلْبَرِّ","وَمَا تَسْقُطُ مِن",283],["6:63:7",135,"وَٱلْبَحْرِ","and the sea","مِّن ظُلُمَـٰتِ ٱلْبَرِّ","تَدْعُونَهُۥ تَضَرُّعًۭا وَخُفْيَةًۭ",283],["6:97:11",140,"وَٱلْبَحْرِ ۗ","and the sea","فِى ظُلُمَـٰتِ ٱلْبَرِّ","قَدْ فَصَّلْنَا ٱلْـَٔايَـٰتِ",283],["7:138:4",167,"ٱلْبَحْرَ","the sea","وَجَـٰوَزْنَا بِبَنِىٓ إِسْرَٰٓءِيلَ","فَأَتَوْا۟ عَلَىٰ قَوْمٍۢ",283],["7:163:7",171,"ٱلْبَحْرِ","(by) the sea","ٱلَّتِى كَانَتْ حَاضِرَةَ","إِذْ يَعْدُونَ فِى",283],["10:22:6",211,"وَٱلْبَحْرِ ۖ","and the sea","يُسَيِّرُكُمْ فِى ٱلْبَرِّ","حَتَّىٰٓ إِذَا كُنتُمْ",283],["10:90:4",219,"ٱلْبَحْرَ","the sea","۞ وَجَـٰوَزْنَا بِبَنِىٓ إِسْرَٰٓءِيلَ","فَأَتْبَعَهُمْ فِرْعَوْنُ وَجُنُودُهُۥ",283],["14:32:21",259,"ٱلْبَحْرِ","the sea","ٱلْفُلْكَ لِتَجْرِىَ فِى","بِأَمْرِهِۦ ۖ وَسَخَّرَ لَكُمُ",283],["16:14:4",268,"ٱلْبَحْرَ","the sea","وَهُوَ ٱلَّذِى سَخَّرَ","لِتَأْكُلُوا۟ مِنْهُ لَحْمًۭا",283],["17:66:7",288,"ٱلْبَحْرِ","the sea","لَكُمُ ٱلْفُلْكَ فِى","لِتَبْتَغُوا۟ مِن فَضْلِهِۦٓ ۚ",283],["17:67:5",289,"ٱلْبَحْرِ","the sea","مَسَّكُمُ ٱلضُّرُّ فِى","ضَلَّ مَن تَدْعُونَ",283],["17:70:8",289,"وَٱلْبَحْرِ","and the sea","وَحَمَلْنَـٰهُمْ فِى ٱلْبَرِّ","وَرَزَقْنَـٰهُم مِّنَ ٱلطَّيِّبَـٰتِ",283],["18:60:10",300,"ٱلْبَحْرَيْنِ","(of) the two seas","حَتَّىٰٓ أَبْلُغَ مَجْمَعَ","أَوْ أَمْضِىَ حُقُبًۭا",283],["18:61:10",300,"ٱلْبَحْرِ","the sea","فَٱتَّخَذَ سَبِيلَهُۥ فِى","سَرَبًۭا",283],["18:63:19",301,"ٱلْبَحْرِ","the sea","وَٱتَّخَذَ سَبِيلَهُۥ فِى","عَجَبًۭا",283],["18:79:7",302,"ٱلْبَحْرِ","the sea","لِمَسَـٰكِينَ يَعْمَلُونَ فِى","فَأَرَدتُّ أَنْ أَعِيبَهَا",283],["18:109:4",304,"ٱلْبَحْرُ","the sea","قُل لَّوْ كَانَ","مِدَادًۭا لِّكَلِمَـٰتِ رَبِّى",283],["18:109:9",304,"ٱلْبَحْرُ","the sea","لِّكَلِمَـٰتِ رَبِّى لَنَفِدَ","قَبْلَ أَن تَنفَدَ",283],["20:77:12",317,"ٱلْبَحْرِ","the sea","لَهُمْ طَرِيقًۭا فِى","يَبَسًۭا لَّا تَخَـٰفُ",283],["22:65:13",340,"ٱلْبَحْرِ","the sea","وَٱلْفُلْكَ تَجْرِى فِى","بِأَمْرِهِۦ وَيُمْسِكُ ٱلسَّمَآءَ",283],["24:40:4",355,"بَحْرٍۢ","a sea","أَوْ كَظُلُمَـٰتٍۢ فِى","لُّجِّىٍّۢ يَغْشَىٰهُ مَوْجٌۭ",283],["25:53:4",364,"ٱلْبَحْرَيْنِ","the two seas","۞ وَهُوَ ٱلَّذِى مَرَجَ","هَـٰذَا عَذْبٌۭ فُرَاتٌۭ",283],["26:63:7",370,"ٱلْبَحْرَ ۖ","the sea","أَنِ ٱضْرِب بِّعَصَاكَ","فَٱنفَلَقَ فَكَانَ كُلُّ",283],["27:61:13",382,"ٱلْبَحْرَيْنِ","the two seas","رَوَٰسِىَ وَجَعَلَ بَيْنَ","حَاجِزًا ۗ أَءِلَـٰهٌۭ مَّعَ",283],["27:63:6",382,"وَٱلْبَحْرِ","and the sea","فِى ظُلُمَـٰتِ ٱلْبَرِّ","وَمَن يُرْسِلُ ٱلرِّيَـٰحَ",283],["30:41:5",408,"وَٱلْبَحْرِ","and the sea","ٱلْفَسَادُ فِى ٱلْبَرِّ","بِمَا كَسَبَتْ أَيْدِى",283],["31:27:8",413,"وَٱلْبَحْرُ","and the sea","مِن شَجَرَةٍ أَقْلَـٰمٌۭ","يَمُدُّهُۥ مِنۢ بَعْدِهِۦ",283],["31:27:13",413,"أَبْحُرٍۢ","seas","مِنۢ بَعْدِهِۦ سَبْعَةُ","مَّا نَفِدَتْ كَلِمَـٰتُ",283],["31:31:7",414,"ٱلْبَحْرِ","the sea","ٱلْفُلْكَ تَجْرِى فِى","بِنِعْمَتِ ٱللَّهِ لِيُرِيَكُم",283],["35:12:3",436,"ٱلْبَحْرَانِ","the two seas","وَمَا يَسْتَوِى","هَـٰذَا عَذْبٌۭ فُرَاتٌۭ",283],["42:32:5",487,"ٱلْبَحْرِ","the sea","ءَايَـٰتِهِ ٱلْجَوَارِ فِى","كَٱلْأَعْلَـٰمِ",283],["44:24:2",497,"ٱلْبَحْرَ","the sea","وَٱتْرُكِ","رَهْوًا ۖ إِنَّهُمْ جُندٌۭ",283],["45:12:5",499,"ٱلْبَحْرَ","the sea","ٱلَّذِى سَخَّرَ لَكُمُ","لِتَجْرِىَ ٱلْفُلْكُ فِيهِ",283],["52:6:1",523,"وَٱلْبَحْرِ","By the sea","","ٱلْمَسْجُورِ",283],["55:19:2",532,"ٱلْبَحْرَيْنِ","the two seas","مَرَجَ","يَلْتَقِيَانِ",283],["55:24:5",532,"ٱلْبَحْرِ","the sea","ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى","كَٱلْأَعْلَـٰمِ",283],["81:6:2",586,"ٱلْبِحَارُ","the seas","وَإِذَا","سُجِّرَتْ",283],["82:3:2",587,"ٱلْبِحَارُ","the seas","وَإِذَا","فُجِّرَتْ",283]]