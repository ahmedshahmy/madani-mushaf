[["2:275:34",47,"سَلَفَ","(has) passed","فَٱنتَهَىٰ فَلَهُۥ مَا","وَأَمْرُهُۥٓ إِلَى ٱللَّهِ ۖ",1392],["4:22:11",81,"سَلَفَ ۚ","passed before","إِلَّا مَا قَدْ","إِنَّهُۥ كَانَ فَـٰحِشَةًۭ",1392],["4:23:49",81,"سَلَفَ ۗ","passed before","إِلَّا مَا قَدْ","إِنَّ ٱللَّهَ كَانَ",1392],["5:95:41",123,"سَلَفَ ۚ","(has) passed","عَفَا ٱللَّهُ عَمَّا","وَمَنْ عَادَ فَيَنتَقِمُ",1392],["8:38:10",181,"سَلَفَ","(is) past","لَهُم مَّا قَدْ","وَإِن يَعُودُوا۟ فَقَدْ",1392],["10:30:6",212,"أَسْلَفَتْ ۚ","it did previously","كُلُّ نَفْسٍۢ مَّآ","وَرُدُّوٓا۟ إِلَى ٱللَّهِ",2192],["43:56:2",493,"سَلَفًۭا","a precedent","فَجَعَلْنَـٰهُمْ","وَمَثَلًۭا لِّلْـَٔاخِرِينَ",4252],["69:24:5",567,"أَسْلَفْتُمْ","you sent before you","وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ","فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ",2192]]