[["13:17:5",251,"فَسَالَتْ","and flows","مِنَ ٱلسَّمَآءِ مَآءًۭ","أَوْدِيَةٌۢ بِقَدَرِهَا فَٱحْتَمَلَ",4233],["13:17:9",251,"ٱلسَّيْلُ","the torrent","أَوْدِيَةٌۢ بِقَدَرِهَا فَٱحْتَمَلَ","زَبَدًۭا رَّابِيًۭا ۚ وَمِمَّا",2633],["34:12:7",429,"وَأَسَلْنَا","and We caused to flow","شَهْرٌۭ وَرَوَاحُهَا شَهْرٌۭ ۖ","لَهُۥ عَيْنَ ٱلْقِطْرِ ۖ",3034],["34:16:4",430,"سَيْلَ","(the) flood","فَأَعْرَضُوا۟ فَأَرْسَلْنَا عَلَيْهِمْ","ٱلْعَرِمِ وَبَدَّلْنَـٰهُم بِجَنَّتَيْهِمْ",2633]]