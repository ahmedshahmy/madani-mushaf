[["2:127:4",20,"ٱلْقَوَاعِدَ","the foundations","وَإِذْ يَرْفَعُ إِبْرَٰهِـۧمُ","مِنَ ٱلْبَيْتِ وَإِسْمَـٰعِيلُ",1959],["3:121:7",65,"مَقَـٰعِدَ","(to take) positions","أَهْلِكَ تُبَوِّئُ ٱلْمُؤْمِنِينَ","لِلْقِتَالِ ۗ وَٱللَّهُ سَمِيعٌ",1581],["3:168:4",72,"وَقَعَدُوا۟","while they sat","ٱلَّذِينَ قَالُوا۟ لِإِخْوَٰنِهِمْ","لَوْ أَطَاعُونَا مَا",738],["3:191:5",75,"وَقُعُودًۭا","and sitting","يَذْكُرُونَ ٱللَّهَ قِيَـٰمًۭا","وَعَلَىٰ جُنُوبِهِمْ وَيَتَفَكَّرُونَ",1624],["4:95:3",94,"ٱلْقَـٰعِدُونَ","the ones who sit","لَّا يَسْتَوِى","مِنَ ٱلْمُؤْمِنِينَ غَيْرُ",1094],["4:95:21",94,"ٱلْقَـٰعِدِينَ","the ones who sit","بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ عَلَى","دَرَجَةًۭ ۚ وَكُلًّۭا وَعَدَ",1094],["4:95:31",94,"ٱلْقَـٰعِدِينَ","the ones who sit","ٱللَّهُ ٱلْمُجَـٰهِدِينَ عَلَى","أَجْرًا عَظِيمًۭا",1094],["4:103:7",95,"وَقُعُودًۭا","and sitting","فَٱذْكُرُوا۟ ٱللَّهَ قِيَـٰمًۭا","وَعَلَىٰ جُنُوبِكُمْ ۚ فَإِذَا",1624],["4:140:16",100,"تَقْعُدُوا۟","sit","وَيُسْتَهْزَأُ بِهَا فَلَا","مَعَهُمْ حَتَّىٰ يَخُوضُوا۟",738],["5:24:16",112,"قَـٰعِدُونَ","sitting","فَقَـٰتِلَآ إِنَّا هَـٰهُنَا","",1094],["6:68:18",135,"تَقْعُدْ","sit","يُنسِيَنَّكَ ٱلشَّيْطَـٰنُ فَلَا","بَعْدَ ٱلذِّكْرَىٰ مَعَ",738],["7:16:4",152,"لَأَقْعُدَنَّ","surely I will sit","قَالَ فَبِمَآ أَغْوَيْتَنِى","لَهُمْ صِرَٰطَكَ ٱلْمُسْتَقِيمَ",738],["7:86:2",161,"تَقْعُدُوا۟","sit","وَلَا","بِكُلِّ صِرَٰطٍۢ تُوعِدُونَ",738],["9:5:11",187,"وَٱقْعُدُوا۟","and sit (in wait)","وَجَدتُّمُوهُمْ وَخُذُوهُمْ وَٱحْصُرُوهُمْ","لَهُمْ كُلَّ مَرْصَدٍۢ ۚ",738],["9:46:13",194,"ٱقْعُدُوا۟","Sit","ٱنۢبِعَاثَهُمْ فَثَبَّطَهُمْ وَقِيلَ","مَعَ ٱلْقَـٰعِدِينَ",738],["9:46:15",194,"ٱلْقَـٰعِدِينَ","those who sit","وَقِيلَ ٱقْعُدُوا۟ مَعَ","",1094],["9:81:3",200,"بِمَقْعَدِهِمْ","in their staying","فَرِحَ ٱلْمُخَلَّفُونَ","خِلَـٰفَ رَسُولِ ٱللَّهِ",1581],["9:83:20",200,"بِٱلْقُعُودِ","with sitting","عَدُوًّا ۖ إِنَّكُمْ رَضِيتُم","أَوَّلَ مَرَّةٍۢ فَٱقْعُدُوا۟",1624],["9:83:23",200,"فَٱقْعُدُوا۟","so sit","بِٱلْقُعُودِ أَوَّلَ مَرَّةٍۢ","مَعَ ٱلْخَـٰلِفِينَ",738],["9:86:18",200,"ٱلْقَـٰعِدِينَ","those who sit","ذَرْنَا نَكُن مَّعَ","",1094],["9:90:7",201,"وَقَعَدَ","and sat","ٱلْأَعْرَابِ لِيُؤْذَنَ لَهُمْ","ٱلَّذِينَ كَذَبُوا۟ ٱللَّهَ",738],["10:12:8",209,"قَاعِدًا","sitting","دَعَانَا لِجَنۢبِهِۦٓ أَوْ","أَوْ قَآئِمًۭا فَلَمَّا",1094],["16:26:10",269,"ٱلْقَوَاعِدِ","the foundations","ٱللَّهُ بُنْيَـٰنَهُم مِّنَ","فَخَرَّ عَلَيْهِمُ ٱلسَّقْفُ",1959],["17:22:7",284,"فَتَقْعُدَ","lest you will sit","ٱللَّهِ إِلَـٰهًا ءَاخَرَ","مَذْمُومًۭا مَّخْذُولًۭا",738],["17:29:11",285,"فَتَقْعُدَ","so that you sit","تَبْسُطْهَا كُلَّ ٱلْبَسْطِ","مَلُومًۭا مَّحْسُورًا",738],["24:60:1",358,"وَٱلْقَوَٰعِدُ","And postmenopausal","","مِنَ ٱلنِّسَآءِ ٱلَّـٰتِى",1959],["50:17:8",519,"قَعِيدٌۭ","seated","ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ","",4112],["54:55:2",531,"مَقْعَدِ","a seat","فِى","صِدْقٍ عِندَ مَلِيكٍۢ",1581],["72:9:3",572,"نَقْعُدُ","sit","وَأَنَّا كُنَّا","مِنْهَا مَقَـٰعِدَ لِلسَّمْعِ ۖ",738],["72:9:5",572,"مَقَـٰعِدَ","positions","كُنَّا نَقْعُدُ مِنْهَا","لِلسَّمْعِ ۖ فَمَن يَسْتَمِعِ",1581],["85:6:4",590,"قُعُودٌۭ","(were) sitting","إِذْ هُمْ عَلَيْهَا","",1624]]