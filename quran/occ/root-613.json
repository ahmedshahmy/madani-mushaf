[["4:94:24",93,"مَغَانِمُ","(are) booties","ٱلدُّنْيَا فَعِندَ ٱللَّهِ","كَثِيرَةٌۭ ۚ كَذَٰلِكَ كُنتُم",1575],["6:146:10",147,"وَٱلْغَنَمِ","and the sheep","ظُفُرٍۢ ۖ وَمِنَ ٱلْبَقَرِ","حَرَّمْنَا عَلَيْهِمْ شُحُومَهُمَآ",1846],["8:41:3",182,"غَنِمْتُم","you obtain (as) spoils of war","۞ وَٱعْلَمُوٓا۟ أَنَّمَا","مِّن شَىْءٍۢ فَأَنَّ",2373],["8:69:3",185,"غَنِمْتُمْ","you got as war booty","فَكُلُوا۟ مِمَّا","حَلَـٰلًۭا طَيِّبًۭا ۚ وَٱتَّقُوا۟",2373],["20:18:9",313,"غَنَمِى","my sheep","وَأَهُشُّ بِهَا عَلَىٰ","وَلِىَ فِيهَا مَـَٔارِبُ",1846],["21:78:10",328,"غَنَمُ","sheep","إِذْ نَفَشَتْ فِيهِ","ٱلْقَوْمِ وَكُنَّا لِحُكْمِهِمْ",1846],["48:15:6",512,"مَغَانِمَ","(the) spoils of war","إِذَا ٱنطَلَقْتُمْ إِلَىٰ","لِتَأْخُذُوهَا ذَرُونَا نَتَّبِعْكُمْ ۖ",1575],["48:19:1",513,"وَمَغَانِمَ","And spoils of war","","كَثِيرَةًۭ يَأْخُذُونَهَا ۗ وَكَانَ",1575],["48:20:3",513,"مَغَانِمَ","spoils of war","وَعَدَكُمُ ٱللَّهُ","كَثِيرَةًۭ تَأْخُذُونَهَا فَعَجَّلَ",1575]]