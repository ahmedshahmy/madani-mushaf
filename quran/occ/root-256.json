[["3:151:15",69,"وَمَأْوَىٰهُمُ","and their refuge","يُنَزِّلْ بِهِۦ سُلْطَـٰنًۭا ۖ","ٱلنَّارُ ۚ وَبِئْسَ مَثْوَى",469],["3:162:10",71,"وَمَأْوَىٰهُ","and his abode","بِسَخَطٍۢ مِّنَ ٱللَّهِ","جَهَنَّمُ ۚ وَبِئْسَ ٱلْمَصِيرُ",469],["3:197:4",76,"مَأْوَىٰهُمْ","their abode","مَتَـٰعٌۭ قَلِيلٌۭ ثُمَّ","جَهَنَّمُ ۚ وَبِئْسَ ٱلْمِهَادُ",469],["4:97:24",94,"مَأْوَىٰهُمْ","(will have) their abode","فَتُهَاجِرُوا۟ فِيهَا ۚ فَأُو۟لَـٰٓئِكَ","جَهَنَّمُ ۖ وَسَآءَتْ مَصِيرًا",469],["4:121:2",97,"مَأْوَىٰهُمْ","their abode","أُو۟لَـٰٓئِكَ","جَهَنَّمُ وَلَا يَجِدُونَ",469],["5:72:28",120,"وَمَأْوَىٰهُ","and his abode","ٱللَّهُ عَلَيْهِ ٱلْجَنَّةَ","ٱلنَّارُ ۖ وَمَا لِلظَّـٰلِمِينَ",469],["8:16:17",178,"وَمَأْوَىٰهُ","and his abode","بِغَضَبٍۢ مِّنَ ٱللَّهِ","جَهَنَّمُ ۖ وَبِئْسَ ٱلْمَصِيرُ",469],["8:26:12",180,"فَـَٔاوَىٰكُمْ","then He sheltered you","أَن يَتَخَطَّفَكُمُ ٱلنَّاسُ","وَأَيَّدَكُم بِنَصْرِهِۦ وَرَزَقَكُم",870],["8:72:12",186,"ءَاوَوا۟","gave shelter","سَبِيلِ ٱللَّهِ وَٱلَّذِينَ","وَّنَصَرُوٓا۟ أُو۟لَـٰٓئِكَ بَعْضُهُمْ",870],["8:74:9",186,"ءَاوَوا۟","gave shelter","سَبِيلِ ٱللَّهِ وَٱلَّذِينَ","وَّنَصَرُوٓا۟ أُو۟لَـٰٓئِكَ هُمُ",870],["9:73:8",199,"وَمَأْوَىٰهُمْ","And their abode","وَٱلْمُنَـٰفِقِينَ وَٱغْلُظْ عَلَيْهِمْ ۚ","جَهَنَّمُ ۖ وَبِئْسَ ٱلْمَصِيرُ",469],["9:95:13",202,"وَمَأْوَىٰهُمْ","and their abode","عَنْهُمْ ۖ إِنَّهُمْ رِجْسٌۭ ۖ","جَهَنَّمُ جَزَآءًۢ بِمَا",469],["10:8:2",209,"مَأْوَىٰهُمُ","their abode","أُو۟لَـٰٓئِكَ","ٱلنَّارُ بِمَا كَانُوا۟",469],["11:43:2",226,"سَـَٔاوِىٓ","I will betake myself","قَالَ","إِلَىٰ جَبَلٍۢ يَعْصِمُنِى",1283],["11:80:8",230,"ءَاوِىٓ","I could take refuge","بِكُمْ قُوَّةً أَوْ","إِلَىٰ رُكْنٍۢ شَدِيدٍۢ",1283],["12:69:5",243,"ءَاوَىٰٓ","he took","دَخَلُوا۟ عَلَىٰ يُوسُفَ","إِلَيْهِ أَخَاهُ ۖ قَالَ",870],["12:99:5",247,"ءَاوَىٰٓ","he took","دَخَلُوا۟ عَلَىٰ يُوسُفَ","إِلَيْهِ أَبَوَيْهِ وَقَالَ",870],["13:18:24",251,"وَمَأْوَىٰهُمْ","and their abode","لَهُمْ سُوٓءُ ٱلْحِسَابِ","جَهَنَّمُ ۖ وَبِئْسَ ٱلْمِهَادُ",469],["17:97:22",292,"مَّأْوَىٰهُمْ","Their abode","عُمْيًۭا وَبُكْمًۭا وَصُمًّۭا ۖ","جَهَنَّمُ ۖ كُلَّمَا خَبَتْ",469],["18:10:2",294,"أَوَى","retreated","إِذْ","ٱلْفِتْيَةُ إِلَى ٱلْكَهْفِ",1283],["18:16:7",295,"فَأْوُۥٓا۟","then retreat","يَعْبُدُونَ إِلَّا ٱللَّهَ","إِلَى ٱلْكَهْفِ يَنشُرْ",1283],["18:63:4",301,"أَوَيْنَآ","we retired","قَالَ أَرَءَيْتَ إِذْ","إِلَى ٱلصَّخْرَةِ فَإِنِّى",1283],["23:50:6",345,"وَءَاوَيْنَـٰهُمَآ","and We sheltered them","مَرْيَمَ وَأُمَّهُۥٓ ءَايَةًۭ","إِلَىٰ رَبْوَةٍۢ ذَاتِ",870],["24:57:8",357,"وَمَأْوَىٰهُمُ","And their abode","مُعْجِزِينَ فِى ٱلْأَرْضِ ۚ","ٱلنَّارُ ۖ وَلَبِئْسَ ٱلْمَصِيرُ",469],["29:25:22",399,"وَمَأْوَىٰكُمُ","and your abode","وَيَلْعَنُ بَعْضُكُم بَعْضًۭا","ٱلنَّارُ وَمَا لَكُم",469],["32:19:8",416,"ٱلْمَأْوَىٰ","(of) Refuge","ٱلصَّـٰلِحَـٰتِ فَلَهُمْ جَنَّـٰتُ","نُزُلًۢا بِمَا كَانُوا۟",469],["32:20:4",416,"فَمَأْوَىٰهُمُ","then their refuge","وَأَمَّا ٱلَّذِينَ فَسَقُوا۟","ٱلنَّارُ ۖ كُلَّمَآ أَرَادُوٓا۟",469],["33:51:5",425,"وَتُـْٔوِىٓ","or you may take","مَن تَشَآءُ مِنْهُنَّ","إِلَيْكَ مَن تَشَآءُ ۖ",870],["45:34:9",502,"وَمَأْوَىٰكُمُ","and your abode","لِقَآءَ يَوْمِكُمْ هَـٰذَا","ٱلنَّارُ وَمَا لَكُم",469],["53:15:3",526,"ٱلْمَأْوَىٰٓ","(of) Abode","عِندَهَا جَنَّةُ","",469],["57:15:10",539,"مَأْوَىٰكُمُ","Your abode","مِنَ ٱلَّذِينَ كَفَرُوا۟ ۚ","ٱلنَّارُ ۖ هِىَ مَوْلَىٰكُمْ ۖ",469],["66:9:8",561,"وَمَأْوَىٰهُمْ","And their abode","وَٱلْمُنَـٰفِقِينَ وَٱغْلُظْ عَلَيْهِمْ ۚ","جَهَنَّمُ ۖ وَبِئْسَ ٱلْمَصِيرُ",469],["70:13:3",569,"تُـْٔوِيهِ","sheltered him","وَفَصِيلَتِهِ ٱلَّتِى","",870],["79:39:4",584,"ٱلْمَأْوَىٰ","(is) the refuge","فَإِنَّ ٱلْجَحِيمَ هِىَ","",469],["79:41:4",584,"ٱلْمَأْوَىٰ","the refuge","فَإِنَّ ٱلْجَنَّةَ هِىَ","",469],["93:6:4",596,"فَـَٔاوَىٰ","and give shelter","أَلَمْ يَجِدْكَ يَتِيمًۭا","",870]]