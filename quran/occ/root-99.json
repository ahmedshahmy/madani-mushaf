[["2:25:12",5,"ٱلْأَنْهَـٰرُ ۖ","the rivers","تَجْرِى مِن تَحْتِهَا","كُلَّمَا رُزِقُوا۟ مِنْهَا",221],["2:74:18",11,"ٱلْأَنْهَـٰرُ ۚ","[the] rivers","لَمَا يَتَفَجَّرُ مِنْهُ","وَإِنَّ مِنْهَا لَمَا",221],["2:164:8",25,"وَٱلنَّهَارِ","and the day","وَٱلْأَرْضِ وَٱخْتِلَـٰفِ ٱلَّيْلِ","وَٱلْفُلْكِ ٱلَّتِى تَجْرِى",210],["2:249:9",41,"بِنَهَرٍۢ","with a river","إِنَّ ٱللَّهَ مُبْتَلِيكُم","فَمَن شَرِبَ مِنْهُ",221],["2:266:13",45,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","لَهُۥ فِيهَا مِن",221],["2:274:5",46,"وَٱلنَّهَارِ","and day","يُنفِقُونَ أَمْوَٰلَهُم بِٱلَّيْلِ","سِرًّۭا وَعَلَانِيَةًۭ فَلَهُمْ",210],["3:15:14",51,"ٱلْأَنْهَـٰرُ","[the] rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا وَأَزْوَٰجٌۭ",221],["3:27:4",53,"ٱلنَّهَارِ","the day","تُولِجُ ٱلَّيْلَ فِى","وَتُولِجُ ٱلنَّهَارَ فِى",210],["3:27:6",53,"ٱلنَّهَارَ","the day","فِى ٱلنَّهَارِ وَتُولِجُ","فِى ٱلَّيْلِ ۖ وَتُخْرِجُ",210],["3:72:13",59,"ٱلنَّهَارِ","(of) the day","ٱلَّذِينَ ءَامَنُوا۟ وَجْهَ","وَٱكْفُرُوٓا۟ ءَاخِرَهُۥ لَعَلَّهُمْ",210],["3:136:10",67,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا ۚ وَنِعْمَ",221],["3:190:8",75,"وَٱلنَّهَارِ","and the day","وَٱلْأَرْضِ وَٱخْتِلَـٰفِ ٱلَّيْلِ","لَـَٔايَـٰتٍۢ لِّأُو۟لِى ٱلْأَلْبَـٰبِ",210],["3:195:35",76,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","ثَوَابًۭا مِّنْ عِندِ",221],["3:198:10",76,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا نُزُلًۭا",221],["4:13:13",79,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا ۚ وَذَٰلِكَ",221],["4:57:10",87,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَآ أَبَدًۭا ۖ",221],["4:122:10",98,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَآ أَبَدًۭا ۖ",221],["5:12:36",109,"ٱلْأَنْهَـٰرُ ۚ","the rivers","تَجْرِى مِن تَحْتِهَا","فَمَن كَفَرَ بَعْدَ",221],["5:85:9",122,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا ۚ وَذَٰلِكَ",221],["5:119:13",127,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَآ أَبَدًۭا ۚ",221],["6:6:21",128,"ٱلْأَنْهَـٰرَ","the rivers","عَلَيْهِم مِّدْرَارًۭا وَجَعَلْنَا","تَجْرِى مِن تَحْتِهِمْ",221],["6:13:6",129,"وَٱلنَّهَارِ ۚ","and the day","سَكَنَ فِى ٱلَّيْلِ","وَهُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",210],["6:60:8",135,"بِٱلنَّهَارِ","by the day","وَيَعْلَمُ مَا جَرَحْتُم","ثُمَّ يَبْعَثُكُمْ فِيهِ",210],["7:43:10",155,"ٱلْأَنْهَـٰرُ ۖ","the rivers","تَجْرِى مِن تَحْتِهِمُ","وَقَالُوا۟ ٱلْحَمْدُ لِلَّهِ",221],["7:54:17",157,"ٱلنَّهَارَ","(with) the day","ٱلْعَرْشِ يُغْشِى ٱلَّيْلَ","يَطْلُبُهُۥ حَثِيثًۭا وَٱلشَّمْسَ",210],["9:72:9",198,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا وَمَسَـٰكِنَ",221],["9:89:8",201,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا ۚ ذَٰلِكَ",221],["9:100:19",203,"ٱلْأَنْهَـٰرُ","the rivers","جَنَّـٰتٍۢ تَجْرِى تَحْتَهَا","خَـٰلِدِينَ فِيهَآ أَبَدًۭا ۚ",221],["10:6:5",208,"وَٱلنَّهَارِ","and the day","فِى ٱخْتِلَـٰفِ ٱلَّيْلِ","وَمَا خَلَقَ ٱللَّهُ",210],["10:9:12",209,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهِمُ","فِى جَنَّـٰتِ ٱلنَّعِيمِ",221],["10:24:32",211,"نَهَارًۭا","(by) day","أَمْرُنَا لَيْلًا أَوْ","فَجَعَلْنَـٰهَا حَصِيدًۭا كَأَن",210],["10:45:9",214,"ٱلنَّهَارِ","the day","إِلَّا سَاعَةًۭ مِّنَ","يَتَعَارَفُونَ بَيْنَهُمْ ۚ قَدْ",210],["10:50:8",214,"نَهَارًۭا","(by) day","عَذَابُهُۥ بَيَـٰتًا أَوْ","مَّاذَا يَسْتَعْجِلُ مِنْهُ",210],["10:67:8",216,"وَٱلنَّهَارَ","and the day","ٱلَّيْلَ لِتَسْكُنُوا۟ فِيهِ","مُبْصِرًا ۚ إِنَّ فِى",210],["11:114:4",234,"ٱلنَّهَارِ","(of) the day","وَأَقِمِ ٱلصَّلَوٰةَ طَرَفَىِ","وَزُلَفًۭا مِّنَ ٱلَّيْلِ ۚ",210],["13:3:8",249,"وَأَنْهَـٰرًۭا ۖ","and rivers","وَجَعَلَ فِيهَا رَوَٰسِىَ","وَمِن كُلِّ ٱلثَّمَرَٰتِ",221],["13:3:18",249,"ٱلنَّهَارَ ۚ","(with) the day","ٱثْنَيْنِ ۖ يُغْشِى ٱلَّيْلَ","إِنَّ فِى ذَٰلِكَ",210],["13:10:14",250,"بِٱلنَّهَارِ","by day","مُسْتَخْفٍۭ بِٱلَّيْلِ وَسَارِبٌۢ","",210],["13:35:9",254,"ٱلْأَنْهَـٰرُ ۖ","the rivers","تَجْرِى مِن تَحْتِهَا","أُكُلُهَا دَآئِمٌۭ وَظِلُّهَا ۚ",221],["14:23:10",258,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا بِإِذْنِ",221],["14:32:25",259,"ٱلْأَنْهَـٰرَ","the rivers","بِأَمْرِهِۦ ۖ وَسَخَّرَ لَكُمُ","",221],["14:33:9",259,"وَٱلنَّهَارَ","and the day","وَسَخَّرَ لَكُمُ ٱلَّيْلَ","",210],["16:12:4",268,"وَٱلنَّهَارَ","and the day","وَسَخَّرَ لَكُمُ ٱلَّيْلَ","وَٱلشَّمْسَ وَٱلْقَمَرَ ۖ وَٱلنُّجُومُ",210],["16:15:8",269,"وَأَنْهَـٰرًۭا","and rivers","أَن تَمِيدَ بِكُمْ","وَسُبُلًۭا لَّعَلَّكُمْ تَهْتَدُونَ",221],["16:31:7",270,"ٱلْأَنْهَـٰرُ ۖ","the rivers","تَجْرِى مِن تَحْتِهَا","لَهُمْ فِيهَا مَا",221],["17:12:3",283,"وَٱلنَّهَارَ","and the day","وَجَعَلْنَا ٱلَّيْلَ","ءَايَتَيْنِ ۖ فَمَحَوْنَآ ءَايَةَ",210],["17:12:10",283,"ٱلنَّهَارِ","(of) the day","ٱلَّيْلِ وَجَعَلْنَآ ءَايَةَ","مُبْصِرَةًۭ لِّتَبْتَغُوا۟ فَضْلًۭا",210],["17:23:21",284,"تَنْهَرْهُمَا","repel them","لَّهُمَآ أُفٍّۢ وَلَا","وَقُل لَّهُمَا قَوْلًۭا",2673],["17:91:9",291,"ٱلْأَنْهَـٰرَ","the rivers","نَّخِيلٍۢ وَعِنَبٍۢ فَتُفَجِّرَ","خِلَـٰلَهَا تَفْجِيرًا",221],["18:31:8",297,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهِمُ","يُحَلَّوْنَ فِيهَا مِنْ",221],["18:33:11",297,"نَهَرًۭا","a river","شَيْـًۭٔا ۚ وَفَجَّرْنَا خِلَـٰلَهُمَا","",221],["20:76:6",316,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا ۚ وَذَٰلِكَ",221],["20:130:18",321,"ٱلنَّهَارِ","(of) the day","ٱلَّيْلِ فَسَبِّحْ وَأَطْرَافَ","لَعَلَّكَ تَرْضَىٰ",210],["21:20:3",323,"وَٱلنَّهَارَ","and [the] day","يُسَبِّحُونَ ٱلَّيْلَ","لَا يَفْتُرُونَ",210],["21:33:5",324,"وَٱلنَّهَارَ","and the day","ٱلَّذِى خَلَقَ ٱلَّيْلَ","وَٱلشَّمْسَ وَٱلْقَمَرَ ۖ كُلٌّۭ",210],["21:42:5",325,"وَٱلنَّهَارِ","and the day","مَن يَكْلَؤُكُم بِٱلَّيْلِ","مِنَ ٱلرَّحْمَـٰنِ ۗ بَلْ",210],["22:14:12",333,"ٱلْأَنْهَـٰرُ ۚ","the rivers","تَجْرِى مِن تَحْتِهَا","إِنَّ ٱللَّهَ يَفْعَلُ",221],["22:23:12",334,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","يُحَلَّوْنَ فِيهَا مِنْ",221],["22:61:7",339,"ٱلنَّهَارِ","the day","يُولِجُ ٱلَّيْلَ فِى","وَيُولِجُ ٱلنَّهَارَ فِى",210],["22:61:9",339,"ٱلنَّهَارَ","the day","فِى ٱلنَّهَارِ وَيُولِجُ","فِى ٱلَّيْلِ وَأَنَّ",210],["23:80:8",347,"وَٱلنَّهَارِ ۚ","and the day","وَلَهُ ٱخْتِلَـٰفُ ٱلَّيْلِ","أَفَلَا تَعْقِلُونَ",210],["24:44:4",356,"وَٱلنَّهَارَ ۚ","and the day","يُقَلِّبُ ٱللَّهُ ٱلَّيْلَ","إِنَّ فِى ذَٰلِكَ",210],["25:10:14",360,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","وَيَجْعَل لَّكَ قُصُورًۢا",221],["25:47:10",364,"ٱلنَّهَارَ","the day","وَٱلنَّوْمَ سُبَاتًۭا وَجَعَلَ","نُشُورًۭا",210],["25:62:5",365,"وَٱلنَّهَارَ","and the day","ٱلَّذِى جَعَلَ ٱلَّيْلَ","خِلْفَةًۭ لِّمَنْ أَرَادَ",210],["27:61:7",382,"أَنْهَـٰرًۭا","rivers","قَرَارًۭا وَجَعَلَ خِلَـٰلَهَآ","وَجَعَلَ لَهَا رَوَٰسِىَ",221],["27:86:8",384,"وَٱلنَّهَارَ","and the day","ٱلَّيْلَ لِيَسْكُنُوا۟ فِيهِ","مُبْصِرًا ۚ إِنَّ فِى",210],["28:72:7",394,"ٱلنَّهَارَ","the day","جَعَلَ ٱللَّهُ عَلَيْكُمُ","سَرْمَدًا إِلَىٰ يَوْمِ",210],["28:73:6",394,"وَٱلنَّهَارَ","and the day","جَعَلَ لَكُمُ ٱلَّيْلَ","لِتَسْكُنُوا۟ فِيهِ وَلِتَبْتَغُوا۟",210],["29:58:12",403,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا ۚ نِعْمَ",221],["30:23:5",406,"وَٱلنَّهَارِ","and the day","ءَايَـٰتِهِۦ مَنَامُكُم بِٱلَّيْلِ","وَٱبْتِغَآؤُكُم مِّن فَضْلِهِۦٓ ۚ",210],["31:29:8",414,"ٱلنَّهَارِ","the day","يُولِجُ ٱلَّيْلَ فِى","وَيُولِجُ ٱلنَّهَارَ فِى",210],["31:29:10",414,"ٱلنَّهَارَ","the day","فِى ٱلنَّهَارِ وَيُولِجُ","فِى ٱلَّيْلِ وَسَخَّرَ",210],["34:33:9",432,"وَٱلنَّهَارِ","and (by) day","بَلْ مَكْرُ ٱلَّيْلِ","إِذْ تَأْمُرُونَنَآ أَن",210],["35:13:4",436,"ٱلنَّهَارِ","the day","يُولِجُ ٱلَّيْلَ فِى","وَيُولِجُ ٱلنَّهَارَ فِى",210],["35:13:6",436,"ٱلنَّهَارَ","the day","فِى ٱلنَّهَارِ وَيُولِجُ","فِى ٱلَّيْلِ وَسَخَّرَ",210],["36:37:6",442,"ٱلنَّهَارَ","the day","ٱلَّيْلُ نَسْلَخُ مِنْهُ","فَإِذَا هُم مُّظْلِمُونَ",210],["36:40:11",442,"ٱلنَّهَارِ ۚ","the day","وَلَا ٱلَّيْلُ سَابِقُ","وَكُلٌّۭ فِى فَلَكٍۢ",210],["39:5:8",458,"ٱلنَّهَارِ","the day","يُكَوِّرُ ٱلَّيْلَ عَلَى","وَيُكَوِّرُ ٱلنَّهَارَ عَلَى",210],["39:5:10",458,"ٱلنَّهَارَ","the day","عَلَى ٱلنَّهَارِ وَيُكَوِّرُ","عَلَى ٱلَّيْلِ ۖ وَسَخَّرَ",210],["39:20:14",460,"ٱلْأَنْهَـٰرُ ۖ","the rivers","تَجْرِى مِن تَحْتِهَا","وَعْدَ ٱللَّهِ ۖ لَا",221],["40:61:8",474,"وَٱلنَّهَارَ","and the day","ٱلَّيْلَ لِتَسْكُنُوا۟ فِيهِ","مُبْصِرًا ۚ إِنَّ ٱللَّهَ",210],["41:37:4",480,"وَٱلنَّهَارُ","and the day","وَمِنْ ءَايَـٰتِهِ ٱلَّيْلُ","وَٱلشَّمْسُ وَٱلْقَمَرُ ۚ لَا",210],["41:38:9",480,"وَٱلنَّهَارِ","and day","يُسَبِّحُونَ لَهُۥ بِٱلَّيْلِ","وَهُمْ لَا يَسْـَٔمُونَ ۩",210],["43:51:12",493,"ٱلْأَنْهَـٰرُ","[the] rivers","مُلْكُ مِصْرَ وَهَـٰذِهِ","تَجْرِى مِن تَحْتِىٓ ۖ",221],["45:5:3",499,"وَٱلنَّهَارِ","and the day","وَٱخْتِلَـٰفِ ٱلَّيْلِ","وَمَآ أَنزَلَ ٱللَّهُ",210],["46:35:21",506,"نَّهَارٍۭ ۚ","a day","إِلَّا سَاعَةًۭ مِّن","بَلَـٰغٌۭ ۚ فَهَلْ يُهْلَكُ",210],["47:12:12",508,"ٱلْأَنْهَـٰرُ ۖ","the rivers","تَجْرِى مِن تَحْتِهَا","وَٱلَّذِينَ كَفَرُوا۟ يَتَمَتَّعُونَ",221],["47:15:7",508,"أَنْهَـٰرٌۭ","(are) rivers","وُعِدَ ٱلْمُتَّقُونَ ۖ فِيهَآ","مِّن مَّآءٍ غَيْرِ",221],["47:15:12",508,"وَأَنْهَـٰرٌۭ","and rivers","مَّآءٍ غَيْرِ ءَاسِنٍۢ","مِّن لَّبَنٍۢ لَّمْ",221],["47:15:18",508,"وَأَنْهَـٰرٌۭ","and rivers","لَّمْ يَتَغَيَّرْ طَعْمُهُۥ","مِّنْ خَمْرٍۢ لَّذَّةٍۢ",221],["47:15:23",508,"وَأَنْهَـٰرٌۭ","and rivers","خَمْرٍۢ لَّذَّةٍۢ لِّلشَّـٰرِبِينَ","مِّنْ عَسَلٍۢ مُّصَفًّۭى ۖ",221],["48:5:8",511,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا وَيُكَفِّرَ",221],["48:17:22",513,"ٱلْأَنْهَـٰرُ ۖ","the rivers","تَجْرِى مِن تَحْتِهَا","وَمَن يَتَوَلَّ يُعَذِّبْهُ",221],["54:54:5",531,"وَنَهَرٍۢ","and river","ٱلْمُتَّقِينَ فِى جَنَّـٰتٍۢ","",221],["57:6:4",538,"ٱلنَّهَارِ","the day","يُولِجُ ٱلَّيْلَ فِى","وَيُولِجُ ٱلنَّهَارَ فِى",210],["57:6:6",538,"ٱلنَّهَارَ","the day","فِى ٱلنَّهَارِ وَيُولِجُ","فِى ٱلَّيْلِ ۚ وَهُوَ",210],["57:12:16",539,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا ۚ ذَٰلِكَ",221],["58:22:35",545,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَا ۚ رَضِىَ",221],["61:12:9",552,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","وَمَسَـٰكِنَ طَيِّبَةًۭ فِى",221],["64:9:21",556,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَآ أَبَدًۭا ۚ",221],["65:11:26",559,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَآ أَبَدًۭا ۖ",221],["66:8:20",561,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","يَوْمَ لَا يُخْزِى",221],["71:5:7",570,"وَنَهَارًۭا","and day","دَعَوْتُ قَوْمِى لَيْلًۭا","",210],["71:12:9",571,"أَنْهَـٰرًۭا","rivers","جَنَّـٰتٍۢ وَيَجْعَل لَّكُمْ","",221],["73:7:4",574,"ٱلنَّهَارِ","the day","إِنَّ لَكَ فِى","سَبْحًۭا طَوِيلًۭا",210],["73:20:19",575,"وَٱلنَّهَارَ ۚ","and the day","وَٱللَّهُ يُقَدِّرُ ٱلَّيْلَ","عَلِمَ أَن لَّن",210],["78:11:2",582,"ٱلنَّهَارَ","the day","وَجَعَلْنَا","مَعَاشًۭا",210],["85:11:11",590,"ٱلْأَنْهَـٰرُ ۚ","the rivers","تَجْرِى مِن تَحْتِهَا","ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ",221],["91:3:1",595,"وَٱلنَّهَارِ","And the day","","إِذَا جَلَّىٰهَا",210],["92:2:1",595,"وَٱلنَّهَارِ","And the day","","إِذَا تَجَلَّىٰ",210],["93:10:4",596,"تَنْهَرْ","repel","وَأَمَّا ٱلسَّآئِلَ فَلَا","",2673],["98:8:9",599,"ٱلْأَنْهَـٰرُ","the rivers","تَجْرِى مِن تَحْتِهَا","خَـٰلِدِينَ فِيهَآ أَبَدًۭا ۖ",221]]