[["5:46:3",116,"ءَاثَـٰرِهِم","their footsteps","وَقَفَّيْنَا عَلَىٰٓ","بِعِيسَى ٱبْنِ مَرْيَمَ",649],["12:91:4",246,"ءَاثَرَكَ","Allah has preferred you","قَالُوا۟ تَٱللَّهِ لَقَدْ","ٱللَّهُ عَلَيْنَا وَإِن",1287],["18:6:5",294,"ءَاثَـٰرِهِمْ","their footsteps","بَـٰخِعٌۭ نَّفْسَكَ عَلَىٰٓ","إِن لَّمْ يُؤْمِنُوا۟",649],["18:64:8",301,"ءَاثَارِهِمَا","their footprints","نَبْغِ ۚ فَٱرْتَدَّا عَلَىٰٓ","قَصَصًۭا",649],["20:72:3",316,"نُّؤْثِرَكَ","we will prefer you","قَالُوا۟ لَن","عَلَىٰ مَا جَآءَنَا",1287],["20:84:5",317,"أَثَرِى","my tracks","هُمْ أُو۟لَآءِ عَلَىٰٓ","وَعَجِلْتُ إِلَيْكَ رَبِّ",649],["20:96:10",318,"أَثَرِ","(the) track","فَقَبَضْتُ قَبْضَةًۭ مِّنْ","ٱلرَّسُولِ فَنَبَذْتُهَا وَكَذَٰلِكَ",649],["30:50:3",409,"ءَاثَـٰرِ","(the) effects","فَٱنظُرْ إِلَىٰٓ","رَحْمَتِ ٱللَّهِ كَيْفَ",649],["36:12:8",440,"وَءَاثَـٰرَهُمْ ۚ","and their footprints","وَنَكْتُبُ مَا قَدَّمُوا۟","وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ",649],["37:70:3",448,"ءَاثَـٰرِهِمْ","their footsteps","فَهُمْ عَلَىٰٓ","يُهْرَعُونَ",649],["40:21:18",469,"وَءَاثَارًۭا","and (in) impressions","أَشَدَّ مِنْهُمْ قُوَّةًۭ","فِى ٱلْأَرْضِ فَأَخَذَهُمُ",649],["40:82:17",476,"وَءَاثَارًۭا","and impressions","مِنْهُمْ وَأَشَدَّ قُوَّةًۭ","فِى ٱلْأَرْضِ فَمَآ",649],["43:22:10",490,"ءَاثَـٰرِهِم","their footsteps","أُمَّةٍۢ وَإِنَّا عَلَىٰٓ","مُّهْتَدُونَ",649],["43:23:20",491,"ءَاثَـٰرِهِم","their footsteps","أُمَّةٍۢ وَإِنَّا عَلَىٰٓ","مُّقْتَدُونَ",649],["46:4:24",502,"أَثَـٰرَةٍۢ","a trace","قَبْلِ هَـٰذَآ أَوْ","مِّنْ عِلْمٍ إِن",3044],["48:29:23",515,"أَثَرِ","(the) trace","فِى وُجُوهِهِم مِّنْ","ٱلسُّجُودِ ۚ ذَٰلِكَ مَثَلُهُمْ",649],["57:27:4",541,"ءَاثَـٰرِهِم","their footsteps","ثُمَّ قَفَّيْنَا عَلَىٰٓ","بِرُسُلِنَا وَقَفَّيْنَا بِعِيسَى",649],["59:9:18",546,"وَيُؤْثِرُونَ","but prefer","حَاجَةًۭ مِّمَّآ أُوتُوا۟","عَلَىٰٓ أَنفُسِهِمْ وَلَوْ",1287],["74:24:6",576,"يُؤْثَرُ","imitated","هَـٰذَآ إِلَّا سِحْرٌۭ","",4699],["79:38:1",584,"وَءَاثَرَ","And preferred","","ٱلْحَيَوٰةَ ٱلدُّنْيَا",1287],["87:16:2",592,"تُؤْثِرُونَ","You prefer","بَلْ","ٱلْحَيَوٰةَ ٱلدُّنْيَا",1287]]