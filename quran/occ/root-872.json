[["7:148:9",168,"جَسَدًۭا","an image","مِنْ حُلِيِّهِمْ عِجْلًۭا","لَّهُۥ خُوَارٌ ۚ أَلَمْ",1560],["20:88:4",318,"جَسَدًۭا","body","فَأَخْرَجَ لَهُمْ عِجْلًۭا","لَّهُۥ خُوَارٌۭ فَقَالُوا۟",1560],["21:8:3",322,"جَسَدًۭا","bodies","وَمَا جَعَلْنَـٰهُمْ","لَّا يَأْكُلُونَ ٱلطَّعَامَ",1560],["38:34:7",455,"جَسَدًۭا","a body","وَأَلْقَيْنَا عَلَىٰ كُرْسِيِّهِۦ","ثُمَّ أَنَابَ",1560]]