[["3:159:5",71,"لِنتَ","you dealt gently","رَحْمَةٍۢ مِّنَ ٱللَّهِ","لَهُمْ ۖ وَلَوْ كُنتَ",2431],["20:44:4",314,"لَّيِّنًۭا","gentle","فَقُولَا لَهُۥ قَوْلًۭا","لَّعَلَّهُۥ يَتَذَكَّرُ أَوْ",3615],["34:10:10",429,"وَأَلَنَّا","And We made pliable","أَوِّبِى مَعَهُۥ وَٱلطَّيْرَ ۖ","لَهُ ٱلْحَدِيدَ",3003],["39:23:15",461,"تَلِينُ","relax","يَخْشَوْنَ رَبَّهُمْ ثُمَّ","جُلُودُهُمْ وَقُلُوبُهُمْ إِلَىٰ",2431],["59:5:4",546,"لِّينَةٍ","(the) palm-trees","مَا قَطَعْتُم مِّن","أَوْ تَرَكْتُمُوهَا قَآئِمَةً",3616]]