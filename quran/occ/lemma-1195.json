[["12:46:17",241,"لَّعَلِّىٓ","that I may","خُضْرٍۢ وَأُخَرَ يَابِسَـٰتٍۢ","أَرْجِعُ إِلَى ٱلنَّاسِ",1195],["20:10:10",312,"لَّعَلِّىٓ","perhaps I (can)","إِنِّىٓ ءَانَسْتُ نَارًۭا","ءَاتِيكُم مِّنْهَا بِقَبَسٍ",1195],["23:100:1",348,"لَعَلِّىٓ","That I may","","أَعْمَلُ صَـٰلِحًۭا فِيمَا",1195],["28:29:18",389,"لَّعَلِّىٓ","Perhaps","إِنِّىٓ ءَانَسْتُ نَارًۭا","ءَاتِيكُم مِّنْهَا بِخَبَرٍ",1195],["28:38:19",390,"لَّعَلِّىٓ","so that [I]","فَٱجْعَل لِّى صَرْحًۭا","أَطَّلِعُ إِلَىٰٓ إِلَـٰهِ",1195],["40:36:7",471,"لَّعَلِّىٓ","that I may","ٱبْنِ لِى صَرْحًۭا","أَبْلُغُ ٱلْأَسْبَـٰبَ",1195]]