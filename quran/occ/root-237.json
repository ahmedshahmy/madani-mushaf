[["2:216:5",34,"كُرْهٌۭ","(is) hateful","عَلَيْكُمُ ٱلْقِتَالُ وَهُوَ","لَّكُمْ ۖ وَعَسَىٰٓ أَن",1868],["2:216:9",34,"تَكْرَهُوا۟","you dislike","لَّكُمْ ۖ وَعَسَىٰٓ أَن","شَيْـًۭٔا وَهُوَ خَيْرٌۭ",574],["2:256:2",42,"إِكْرَاهَ","compulsion","لَآ","فِى ٱلدِّينِ ۖ قَد",2139],["3:83:12",60,"وَكَرْهًۭا","or unwillingly","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ طَوْعًۭا","وَإِلَيْهِ يُرْجَعُونَ",1349],["4:19:10",80,"كَرْهًۭا ۖ","(by) force","أَن تَرِثُوا۟ ٱلنِّسَآءَ","وَلَا تَعْضُلُوهُنَّ لِتَذْهَبُوا۟",1349],["4:19:25",80,"كَرِهْتُمُوهُنَّ","you dislike them","وَعَاشِرُوهُنَّ بِٱلْمَعْرُوفِ ۚ فَإِن","فَعَسَىٰٓ أَن تَكْرَهُوا۟",574],["4:19:28",80,"تَكْرَهُوا۟","you dislike","كَرِهْتُمُوهُنَّ فَعَسَىٰٓ أَن","شَيْـًۭٔا وَيَجْعَلَ ٱللَّهُ",574],["7:88:21",162,"كَـٰرِهِينَ","(the) ones who hate (it)","قَالَ أَوَلَوْ كُنَّا","",1080],["8:5:11",177,"لَكَـٰرِهُونَ","certainly disliked","فَرِيقًۭا مِّنَ ٱلْمُؤْمِنِينَ","",1080],["8:8:6",177,"كَرِهَ","disliked (it)","وَيُبْطِلَ ٱلْبَـٰطِلَ وَلَوْ","ٱلْمُجْرِمُونَ",574],["9:32:14",192,"كَرِهَ","the disbelievers dislike (it)","يُتِمَّ نُورَهُۥ وَلَوْ","ٱلْكَـٰفِرُونَ",574],["9:33:13",192,"كَرِهَ","dislike (it)","ٱلدِّينِ كُلِّهِۦ وَلَوْ","ٱلْمُشْرِكُونَ",574],["9:46:8",194,"كَرِهَ","Allah disliked","لَهُۥ عُدَّةًۭ وَلَـٰكِن","ٱللَّهُ ٱنۢبِعَاثَهُمْ فَثَبَّطَهُمْ",574],["9:48:16",195,"كَـٰرِهُونَ","disliked (it)","أَمْرُ ٱللَّهِ وَهُمْ","",1080],["9:53:5",195,"كَرْهًۭا","unwillingly","أَنفِقُوا۟ طَوْعًا أَوْ","لَّن يُتَقَبَّلَ مِنكُمْ ۖ",1349],["9:54:22",195,"كَـٰرِهُونَ","(are) unwilling","يُنفِقُونَ إِلَّا وَهُمْ","",1080],["9:81:7",200,"وَكَرِهُوٓا۟","and they disliked","خِلَـٰفَ رَسُولِ ٱللَّهِ","أَن يُجَـٰهِدُوا۟ بِأَمْوَٰلِهِمْ",574],["10:82:6",218,"كَرِهَ","dislike it","ٱلْحَقَّ بِكَلِمَـٰتِهِۦ وَلَوْ","ٱلْمُجْرِمُونَ",574],["10:99:11",220,"تُكْرِهُ","compel","كُلُّهُمْ جَمِيعًا ۚ أَفَأَنتَ","ٱلنَّاسَ حَتَّىٰ يَكُونُوا۟",1286],["11:28:19",224,"كَـٰرِهُونَ","averse to it","أَنُلْزِمُكُمُوهَا وَأَنتُمْ لَهَا","",1080],["13:15:8",251,"وَكَرْهًۭا","or unwillingly","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ طَوْعًۭا","وَظِلَـٰلُهُم بِٱلْغُدُوِّ وَٱلْـَٔاصَالِ ۩",1349],["16:62:4",273,"يَكْرَهُونَ","they dislike","وَيَجْعَلُونَ لِلَّهِ مَا","وَتَصِفُ أَلْسِنَتُهُمُ ٱلْكَذِبَ",574],["16:106:9",279,"أُكْرِهَ","is forced","إِيمَـٰنِهِۦٓ إِلَّا مَنْ","وَقَلْبُهُۥ مُطْمَئِنٌّۢ بِٱلْإِيمَـٰنِ",1286],["17:38:7",285,"مَكْرُوهًۭا","hateful","سَيِّئُهُۥ عِندَ رَبِّكَ","",3676],["20:73:8",316,"أَكْرَهْتَنَا","you compelled us","لَنَا خَطَـٰيَـٰنَا وَمَآ","عَلَيْهِ مِنَ ٱلسِّحْرِ ۗ",1286],["23:70:10",346,"كَـٰرِهُونَ","(are) averse","بِٱلْحَقِّ وَأَكْثَرُهُمْ لِلْحَقِّ","",1080],["24:33:29",354,"تُكْرِهُوا۟","compel","ٱلَّذِىٓ ءَاتَىٰكُمْ ۚ وَلَا","فَتَيَـٰتِكُمْ عَلَى ٱلْبِغَآءِ",1286],["24:33:41",354,"يُكْرِههُّنَّ","compels them","ٱلْحَيَوٰةِ ٱلدُّنْيَا ۚ وَمَن","فَإِنَّ ٱللَّهَ مِنۢ",1286],["24:33:46",354,"إِكْرَٰهِهِنَّ","their compulsion","ٱللَّهَ مِنۢ بَعْدِ","غَفُورٌۭ رَّحِيمٌۭ",2139],["40:14:7",468,"كَرِهَ","dislike (it)","لَهُ ٱلدِّينَ وَلَوْ","ٱلْكَـٰفِرُونَ",574],["41:11:13",477,"كَرْهًۭا","unwillingly","ٱئْتِيَا طَوْعًا أَوْ","قَالَتَآ أَتَيْنَا طَآئِعِينَ",1349],["43:78:7",495,"كَـٰرِهُونَ","(are) averse","وَلَـٰكِنَّ أَكْثَرَكُمْ لِلْحَقِّ","",1080],["46:15:7",504,"كُرْهًۭا","(with) hardship","إِحْسَـٰنًا ۖ حَمَلَتْهُ أُمُّهُۥ","وَوَضَعَتْهُ كُرْهًۭا ۖ وَحَمْلُهُۥ",1868],["46:15:9",504,"كُرْهًۭا ۖ","(with) hardship","أُمُّهُۥ كُرْهًۭا وَوَضَعَتْهُ","وَحَمْلُهُۥ وَفِصَـٰلُهُۥ ثَلَـٰثُونَ",1868],["47:9:3",507,"كَرِهُوا۟","hate","ذَٰلِكَ بِأَنَّهُمْ","مَآ أَنزَلَ ٱللَّهُ",574],["47:26:5",509,"كَرِهُوا۟","hate","بِأَنَّهُمْ قَالُوا۟ لِلَّذِينَ","مَا نَزَّلَ ٱللَّهُ",574],["47:28:7",509,"وَكَرِهُوا۟","and hated","مَآ أَسْخَطَ ٱللَّهَ","رِضْوَٰنَهُۥ فَأَحْبَطَ أَعْمَـٰلَهُمْ",574],["49:7:21",516,"وَكَرَّهَ","and has made hateful","وَزَيَّنَهُۥ فِى قُلُوبِكُمْ","إِلَيْكُمُ ٱلْكُفْرَ وَٱلْفُسُوقَ",3569],["49:12:25",517,"فَكَرِهْتُمُوهُ ۚ","Nay, you would hate it","لَحْمَ أَخِيهِ مَيْتًۭا","وَٱتَّقُوا۟ ٱللَّهَ ۚ إِنَّ",574],["61:8:10",552,"كَرِهَ","dislike","مُتِمُّ نُورِهِۦ وَلَوْ","ٱلْكَـٰفِرُونَ",574],["61:9:13",552,"كَرِهَ","dislike (it)","ٱلدِّينِ كُلِّهِۦ وَلَوْ","ٱلْمُشْرِكُونَ",574]]