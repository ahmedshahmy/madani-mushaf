[["22:5:37",332,"طِفْلًۭا","(as) a child","مُّسَمًّۭى ثُمَّ نُخْرِجُكُمْ","ثُمَّ لِتَبْلُغُوٓا۟ أَشُدَّكُمْ ۖ",1531],["24:31:56",353,"ٱلطِّفْلِ","[the] children","مِنَ ٱلرِّجَالِ أَوِ","ٱلَّذِينَ لَمْ يَظْهَرُوا۟",1531],["24:59:3",358,"ٱلْأَطْفَـٰلُ","the children","وَإِذَا بَلَغَ","مِنكُمُ ٱلْحُلُمَ فَلْيَسْتَـْٔذِنُوا۟",1531],["40:67:14",475,"طِفْلًۭا","(as) a child","عَلَقَةٍۢ ثُمَّ يُخْرِجُكُمْ","ثُمَّ لِتَبْلُغُوٓا۟ أَشُدَّكُمْ",1531]]