[["7:54:18",157,"يَطْلُبُهُۥ","seeking it","يُغْشِى ٱلَّيْلَ ٱلنَّهَارَ","حَثِيثًۭا وَٱلشَّمْسَ وَٱلْقَمَرَ",4621],["18:41:8",298,"طَلَبًۭا","to find it","فَلَن تَسْتَطِيعَ لَهُۥ","",3293],["22:73:27",341,"ٱلطَّالِبُ","(are) the seeker","يَسْتَنقِذُوهُ مِنْهُ ۚ ضَعُفَ","وَٱلْمَطْلُوبُ",3302],["22:73:28",341,"وَٱلْمَطْلُوبُ","and the one who is sought","مِنْهُ ۚ ضَعُفَ ٱلطَّالِبُ","",3646]]