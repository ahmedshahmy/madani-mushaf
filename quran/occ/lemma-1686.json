[["4:163:20",104,"وَيُونُسَ","and Yunus","وَٱلْأَسْبَاطِ وَعِيسَىٰ وَأَيُّوبَ","وَهَـٰرُونَ وَسُلَيْمَـٰنَ ۚ وَءَاتَيْنَا",1686],["6:86:3",138,"وَيُونُسَ","and Yunus","وَإِسْمَـٰعِيلَ وَٱلْيَسَعَ","وَلُوطًۭا ۚ وَكُلًّۭا فَضَّلْنَا",1686],["10:98:9",220,"يُونُسَ","(of) Yunus","إِيمَـٰنُهَآ إِلَّا قَوْمَ","لَمَّآ ءَامَنُوا۟ كَشَفْنَا",1686],["37:139:2",451,"يُونُسَ","Yunus","وَإِنَّ","لَمِنَ ٱلْمُرْسَلِينَ",1686]]