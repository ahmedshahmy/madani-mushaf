[["2:228:22",36,"وَبُعُولَتُهُنَّ","And their husbands","بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۚ","أَحَقُّ بِرَدِّهِنَّ فِى",1167],["4:128:5",99,"بَعْلِهَا","her husband","ٱمْرَأَةٌ خَافَتْ مِنۢ","نُشُوزًا أَوْ إِعْرَاضًۭا",1167],["11:72:7",230,"بَعْلِى","my husband","وَأَنَا۠ عَجُوزٌۭ وَهَـٰذَا","شَيْخًا ۖ إِنَّ هَـٰذَا",1167],["24:31:23",353,"لِبُعُولَتِهِنَّ","to their husbands","يُبْدِينَ زِينَتَهُنَّ إِلَّا","أَوْ ءَابَآئِهِنَّ أَوْ",1167],["24:31:28",353,"بُعُولَتِهِنَّ","(of) their husbands","ءَابَآئِهِنَّ أَوْ ءَابَآءِ","أَوْ أَبْنَآئِهِنَّ أَوْ",1167],["24:31:33",353,"بُعُولَتِهِنَّ","(of) their husbands","أَبْنَآئِهِنَّ أَوْ أَبْنَآءِ","أَوْ إِخْوَٰنِهِنَّ أَوْ",1167],["37:125:2",450,"بَعْلًۭا","Baal","أَتَدْعُونَ","وَتَذَرُونَ أَحْسَنَ ٱلْخَـٰلِقِينَ",3323]]