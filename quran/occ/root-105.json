[["2:96:1",15,"وَلَتَجِدَنَّهُمْ","And surely you will find them","","أَحْرَصَ ٱلنَّاسِ عَلَىٰ",106],["2:110:10",17,"تَجِدُوهُ","you will find it","لِأَنفُسِكُم مِّنْ خَيْرٍۢ","عِندَ ٱللَّهِ ۗ إِنَّ",106],["2:196:47",30,"يَجِدْ","find","ٱلْهَدْىِ ۚ فَمَن لَّمْ","فَصِيَامُ ثَلَـٰثَةِ أَيَّامٍۢ",106],["2:283:6",49,"تَجِدُوا۟","you find","عَلَىٰ سَفَرٍۢ وَلَمْ","كَاتِبًۭا فَرِهَـٰنٌۭ مَّقْبُوضَةٌۭ ۖ",106],["3:30:2",54,"تَجِدُ","will find","يَوْمَ","كُلُّ نَفْسٍۢ مَّا",106],["3:37:15",54,"وَجَدَ","he found","عَلَيْهَا زَكَرِيَّا ٱلْمِحْرَابَ","عِندَهَا رِزْقًۭا ۖ قَالَ",106],["4:43:36",85,"تَجِدُوا۟","you find","لَـٰمَسْتُمُ ٱلنِّسَآءَ فَلَمْ","مَآءًۭ فَتَيَمَّمُوا۟ صَعِيدًۭا",106],["4:52:9",87,"تَجِدَ","will you find","يَلْعَنِ ٱللَّهُ فَلَن","لَهُۥ نَصِيرًا",106],["4:64:20",88,"لَوَجَدُوا۟","surely they would have found","وَٱسْتَغْفَرَ لَهُمُ ٱلرَّسُولُ","ٱللَّهَ تَوَّابًۭا رَّحِيمًۭا",106],["4:65:12",88,"يَجِدُوا۟","they find","بَيْنَهُمْ ثُمَّ لَا","فِىٓ أَنفُسِهِمْ حَرَجًۭا",106],["4:82:10",91,"لَوَجَدُوا۟","surely they (would have) found","عِندِ غَيْرِ ٱللَّهِ","فِيهِ ٱخْتِلَـٰفًۭا كَثِيرًۭا",106],["4:88:20",92,"تَجِدَ","will you find","يُضْلِلِ ٱللَّهُ فَلَن","لَهُۥ سَبِيلًۭا",106],["4:89:22",92,"وَجَدتُّمُوهُمْ ۖ","you find them","فَخُذُوهُمْ وَٱقْتُلُوهُمْ حَيْثُ","وَلَا تَتَّخِذُوا۟ مِنْهُمْ",106],["4:91:1",92,"سَتَجِدُونَ","You will find","","ءَاخَرِينَ يُرِيدُونَ أَن",106],["4:92:50",93,"يَجِدْ","find","مُّؤْمِنَةٍۢ ۖ فَمَن لَّمْ","فَصِيَامُ شَهْرَيْنِ مُتَتَابِعَيْنِ",106],["4:100:6",94,"يَجِدْ","will find","فِى سَبِيلِ ٱللَّهِ","فِى ٱلْأَرْضِ مُرَٰغَمًۭا",106],["4:110:10",96,"يَجِدِ","he will find","ثُمَّ يَسْتَغْفِرِ ٱللَّهَ","ٱللَّهَ غَفُورًۭا رَّحِيمًۭا",106],["4:121:5",97,"يَجِدُونَ","they will find","مَأْوَىٰهُمْ جَهَنَّمُ وَلَا","عَنْهَا مَحِيصًۭا",106],["4:123:13",98,"يَجِدْ","he will find","يُجْزَ بِهِۦ وَلَا","لَهُۥ مِن دُونِ",106],["4:143:14",101,"تَجِدَ","you will find","يُضْلِلِ ٱللَّهُ فَلَن","لَهُۥ سَبِيلًۭا",106],["4:145:9",101,"تَجِدَ","you will find","مِنَ ٱلنَّارِ وَلَن","لَهُمْ نَصِيرًا",106],["4:173:19",105,"يَجِدُونَ","will they find","عَذَابًا أَلِيمًۭا وَلَا","لَهُم مِّن دُونِ",106],["5:6:38",108,"تَجِدُوا۟","you find","لَـٰمَسْتُمُ ٱلنِّسَآءَ فَلَمْ","مَآءًۭ فَتَيَمَّمُوا۟ صَعِيدًۭا",106],["5:82:1",121,"۞ لَتَجِدَنَّ","Surely you will find","","أَشَدَّ ٱلنَّاسِ عَدَٰوَةًۭ",106],["5:82:10",121,"وَلَتَجِدَنَّ","and surely you will find","ٱلْيَهُودَ وَٱلَّذِينَ أَشْرَكُوا۟ ۖ","أَقْرَبَهُم مَّوَدَّةًۭ لِّلَّذِينَ",106],["5:89:28",122,"يَجِدْ","find","رَقَبَةٍۢ ۖ فَمَن لَّمْ","فَصِيَامُ ثَلَـٰثَةِ أَيَّامٍۢ ۚ",106],["5:104:14",125,"وَجَدْنَا","we found","قَالُوا۟ حَسْبُنَا مَا","عَلَيْهِ ءَابَآءَنَآ ۚ أَوَلَوْ",106],["6:145:3",147,"أَجِدُ","(do) I find","قُل لَّآ","فِى مَآ أُوحِىَ",106],["7:17:13",152,"تَجِدُ","You (will) find","وَعَن شَمَآئِلِهِمْ ۖ وَلَا","أَكْثَرَهُمْ شَـٰكِرِينَ",106],["7:28:5",153,"وَجَدْنَا","We found","فَعَلُوا۟ فَـٰحِشَةًۭ قَالُوا۟","عَلَيْهَآ ءَابَآءَنَا وَٱللَّهُ",106],["7:44:8",156,"وَجَدْنَا","we found","ٱلنَّارِ أَن قَدْ","مَا وَعَدَنَا رَبُّنَا",106],["7:44:14",156,"وَجَدتُّم","you found","رَبُّنَا حَقًّۭا فَهَلْ","مَّا وَعَدَ رَبُّكُمْ",106],["7:102:2",163,"وَجَدْنَا","We found","وَمَا","لِأَكْثَرِهِم مِّنْ عَهْدٍۢ ۖ",106],["7:102:7",163,"وَجَدْنَآ","We found","مِّنْ عَهْدٍۢ ۖ وَإِن","أَكْثَرَهُمْ لَفَـٰسِقِينَ",106],["7:157:7",170,"يَجِدُونَهُۥ","they find him","ٱلنَّبِىَّ ٱلْأُمِّىَّ ٱلَّذِى","مَكْتُوبًا عِندَهُمْ فِى",106],["9:5:8",187,"وَجَدتُّمُوهُمْ","you find them","فَٱقْتُلُوا۟ ٱلْمُشْرِكِينَ حَيْثُ","وَخُذُوهُمْ وَٱحْصُرُوهُمْ وَٱقْعُدُوا۟",106],["9:57:2",196,"يَجِدُونَ","they could find","لَوْ","مَلْجَـًٔا أَوْ مَغَـٰرَٰتٍ",106],["9:79:10",199,"يَجِدُونَ","find","ٱلصَّدَقَـٰتِ وَٱلَّذِينَ لَا","إِلَّا جُهْدَهُمْ فَيَسْخَرُونَ",106],["9:91:11",201,"يَجِدُونَ","they find","عَلَى ٱلَّذِينَ لَا","مَا يُنفِقُونَ حَرَجٌ",106],["9:92:10",201,"أَجِدُ","I find","لِتَحْمِلَهُمْ قُلْتَ لَآ","مَآ أَحْمِلُكُمْ عَلَيْهِ",106],["9:92:21",201,"يَجِدُوا۟","they find","ٱلدَّمْعِ حَزَنًا أَلَّا","مَا يُنفِقُونَ",106],["9:123:9",207,"وَلْيَجِدُوا۟","and let them find","يَلُونَكُم مِّنَ ٱلْكُفَّارِ","فِيكُمْ غِلْظَةًۭ ۚ وَٱعْلَمُوٓا۟",106],["10:78:5",217,"وَجَدْنَا","we found","أَجِئْتَنَا لِتَلْفِتَنَا عَمَّا","عَلَيْهِ ءَابَآءَنَا وَتَكُونَ",106],["12:65:4",243,"وَجَدُوا۟","they found","وَلَمَّا فَتَحُوا۟ مَتَـٰعَهُمْ","بِضَـٰعَتَهُمْ رُدَّتْ إِلَيْهِمْ ۖ",106],["12:75:4",244,"وُجِدَ","it is found","قَالُوا۟ جَزَٰٓؤُهُۥ مَن","فِى رَحْلِهِۦ فَهُوَ",106],["12:79:8",245,"وَجَدْنَا","we found","نَّأْخُذَ إِلَّا مَن","مَتَـٰعَنَا عِندَهُۥٓ إِنَّآ",106],["12:94:7",246,"لَأَجِدُ","[I] find","قَالَ أَبُوهُمْ إِنِّى","رِيحَ يُوسُفَ ۖ لَوْلَآ",106],["17:68:13",289,"تَجِدُوا۟","you will find","حَاصِبًۭا ثُمَّ لَا","لَكُمْ وَكِيلًا",106],["17:69:18",289,"تَجِدُوا۟","you will find","كَفَرْتُمْ ۙ ثُمَّ لَا","لَكُمْ عَلَيْنَا بِهِۦ",106],["17:75:9",289,"تَجِدُ","you (would) have found","ٱلْمَمَاتِ ثُمَّ لَا","لَكَ عَلَيْنَا نَصِيرًۭا",106],["17:77:9",290,"تَجِدُ","you will find","مِن رُّسُلِنَا ۖ وَلَا","لِسُنَّتِنَا تَحْوِيلًا",106],["17:86:9",290,"تَجِدُ","you would find","إِلَيْكَ ثُمَّ لَا","لَكَ بِهِۦ عَلَيْنَا",106],["17:97:9",292,"تَجِدَ","you will find","وَمَن يُضْلِلْ فَلَن","لَهُمْ أَوْلِيَآءَ مِن",106],["18:17:31",295,"تَجِدَ","you will find","وَمَن يُضْلِلْ فَلَن","لَهُۥ وَلِيًّۭا مُّرْشِدًۭا",106],["18:27:12",296,"تَجِدَ","you will find","مُبَدِّلَ لِكَلِمَـٰتِهِۦ وَلَن","مِن دُونِهِۦ مُلْتَحَدًۭا",106],["18:36:9",298,"لَأَجِدَنَّ","I will surely find","رُّدِدتُّ إِلَىٰ رَبِّى","خَيْرًۭا مِّنْهَا مُنقَلَبًۭا",106],["18:49:20",299,"وَوَجَدُوا۟","And they will find","كَبِيرَةً إِلَّآ أَحْصَىٰهَا ۚ","مَا عَمِلُوا۟ حَاضِرًۭا ۗ",106],["18:53:8",299,"يَجِدُوا۟","they will find","أَنَّهُم مُّوَاقِعُوهَا وَلَمْ","عَنْهَا مَصْرِفًۭا",106],["18:58:16",300,"يَجِدُوا۟","they will find","لَّهُم مَّوْعِدٌۭ لَّن","مِن دُونِهِۦ مَوْئِلًۭا",106],["18:65:1",301,"فَوَجَدَا","Then they found","","عَبْدًۭا مِّنْ عِبَادِنَآ",106],["18:69:2",301,"سَتَجِدُنِىٓ","You will find me","قَالَ","إِن شَآءَ ٱللَّهُ",106],["18:77:12",302,"فَوَجَدَا","Then they found","فَأَبَوْا۟ أَن يُضَيِّفُوهُمَا","فِيهَا جِدَارًۭا يُرِيدُ",106],["18:86:6",303,"وَجَدَهَا","he found it","بَلَغَ مَغْرِبَ ٱلشَّمْسِ","تَغْرُبُ فِى عَيْنٍ",106],["18:86:11",303,"وَوَجَدَ","and he found","فِى عَيْنٍ حَمِئَةٍۢ","عِندَهَا قَوْمًۭا ۗ قُلْنَا",106],["18:90:6",303,"وَجَدَهَا","and he found it","بَلَغَ مَطْلِعَ ٱلشَّمْسِ","تَطْلُعُ عَلَىٰ قَوْمٍۢ",106],["18:93:6",303,"وَجَدَ","he found","بَلَغَ بَيْنَ ٱلسَّدَّيْنِ","مِن دُونِهِمَا قَوْمًۭا",106],["20:10:15",312,"أَجِدُ","I find","مِّنْهَا بِقَبَسٍ أَوْ","عَلَى ٱلنَّارِ هُدًۭى",106],["20:115:9",320,"نَجِدْ","We found","قَبْلُ فَنَسِىَ وَلَمْ","لَهُۥ عَزْمًۭا",106],["21:53:2",326,"وَجَدْنَآ","We found","قَالُوا۟","ءَابَآءَنَا لَهَا عَـٰبِدِينَ",106],["24:28:3",353,"تَجِدُوا۟","you find","فَإِن لَّمْ","فِيهَآ أَحَدًۭا فَلَا",106],["24:33:4",354,"يَجِدُونَ","find","وَلْيَسْتَعْفِفِ ٱلَّذِينَ لَا","نِكَاحًا حَتَّىٰ يُغْنِيَهُمُ",106],["24:39:13",355,"يَجِدْهُ","he finds it","إِذَا جَآءَهُۥ لَمْ","شَيْـًۭٔا وَوَجَدَ ٱللَّهَ",106],["24:39:15",355,"وَوَجَدَ","but he finds","لَمْ يَجِدْهُ شَيْـًۭٔا","ٱللَّهَ عِندَهُۥ فَوَفَّىٰهُ",106],["26:74:3",370,"وَجَدْنَآ","but we found","قَالُوا۟ بَلْ","ءَابَآءَنَا كَذَٰلِكَ يَفْعَلُونَ",106],["27:23:2",379,"وَجَدتُّ","found","إِنِّى","ٱمْرَأَةًۭ تَمْلِكُهُمْ وَأُوتِيَتْ",106],["27:24:1",379,"وَجَدتُّهَا","And I found her","","وَقَوْمَهَا يَسْجُدُونَ لِلشَّمْسِ",106],["28:15:8",387,"فَوَجَدَ","and found","غَفْلَةٍۢ مِّنْ أَهْلِهَا","فِيهَا رَجُلَيْنِ يَقْتَتِلَانِ",106],["28:23:5",388,"وَجَدَ","he found","وَرَدَ مَآءَ مَدْيَنَ","عَلَيْهِ أُمَّةًۭ مِّنَ",106],["28:23:11",388,"وَوَجَدَ","and he found","مِّنَ ٱلنَّاسِ يَسْقُونَ","مِن دُونِهِمُ ٱمْرَأَتَيْنِ",106],["28:27:24",388,"سَتَجِدُنِىٓ","You will find me","أَنْ أَشُقَّ عَلَيْكَ ۚ","إِن شَآءَ ٱللَّهُ",106],["31:21:12",413,"وَجَدْنَا","we found","بَلْ نَتَّبِعُ مَا","عَلَيْهِ ءَابَآءَنَآ ۚ أَوَلَوْ",106],["33:17:17",420,"يَجِدُونَ","they will find","بِكُمْ رَحْمَةًۭ ۚ وَلَا","لَهُم مِّن دُونِ",106],["33:62:9",426,"تَجِدَ","you will find","مِن قَبْلُ ۖ وَلَن","لِسُنَّةِ ٱللَّهِ تَبْدِيلًۭا",106],["33:65:5",427,"يَجِدُونَ","they will find","فِيهَآ أَبَدًۭا ۖ لَّا","وَلِيًّۭا وَلَا نَصِيرًۭا",106],["35:43:18",439,"تَجِدَ","you will find","سُنَّتَ ٱلْأَوَّلِينَ ۚ فَلَن","لِسُنَّتِ ٱللَّهِ تَبْدِيلًۭا ۖ",106],["35:43:23",439,"تَجِدَ","you will find","ٱللَّهِ تَبْدِيلًۭا ۖ وَلَن","لِسُنَّتِ ٱللَّهِ تَحْوِيلًا",106],["37:102:21",449,"سَتَجِدُنِىٓ","You will find me","ٱفْعَلْ مَا تُؤْمَرُ ۖ","إِن شَآءَ ٱللَّهُ",106],["38:44:9",456,"وَجَدْنَـٰهُ","[We] found him","وَلَا تَحْنَثْ ۗ إِنَّا","صَابِرًۭا ۚ نِّعْمَ ٱلْعَبْدُ ۖ",106],["43:22:4",490,"وَجَدْنَآ","[we] found","بَلْ قَالُوٓا۟ إِنَّا","ءَابَآءَنَا عَلَىٰٓ أُمَّةٍۢ",106],["43:23:14",491,"وَجَدْنَآ","[we] found","قَالَ مُتْرَفُوهَآ إِنَّا","ءَابَآءَنَا عَلَىٰٓ أُمَّةٍۢ",106],["43:24:6",491,"وَجَدتُّمْ","you found","جِئْتُكُم بِأَهْدَىٰ مِمَّا","عَلَيْهِ ءَابَآءَكُمْ ۖ قَالُوٓا۟",106],["48:22:9",513,"يَجِدُونَ","they would find","ٱلْأَدْبَـٰرَ ثُمَّ لَا","وَلِيًّۭا وَلَا نَصِيرًۭا",106],["48:23:9",513,"تَجِدَ","you will find","مِن قَبْلُ ۖ وَلَن","لِسُنَّةِ ٱللَّهِ تَبْدِيلًۭا",106],["51:36:2",522,"وَجَدْنَا","We found","فَمَا","فِيهَا غَيْرَ بَيْتٍۢ",106],["58:4:3",542,"يَجِدْ","find","فَمَن لَّمْ","فَصِيَامُ شَهْرَيْنِ مُتَتَابِعَيْنِ",106],["58:12:18",544,"تَجِدُوا۟","you find","وَأَطْهَرُ ۚ فَإِن لَّمْ","فَإِنَّ ٱللَّهَ غَفُورٌۭ",106],["58:22:2",545,"تَجِدُ","You will not find","لَّا","قَوْمًۭا يُؤْمِنُونَ بِٱللَّهِ",106],["59:9:12",546,"يَجِدُونَ","they find","هَاجَرَ إِلَيْهِمْ وَلَا","فِى صُدُورِهِمْ حَاجَةًۭ",106],["65:6:6",559,"وُجْدِكُمْ","your means","حَيْثُ سَكَنتُم مِّن","وَلَا تُضَآرُّوهُنَّ لِتُضَيِّقُوا۟",4549],["71:25:7",571,"يَجِدُوا۟","they found","فَأُدْخِلُوا۟ نَارًۭا فَلَمْ","لَهُم مِّن دُونِ",106],["72:8:4",572,"فَوَجَدْنَـٰهَا","but we found it","وَأَنَّا لَمَسْنَا ٱلسَّمَآءَ","مُلِئَتْ حَرَسًۭا شَدِيدًۭا",106],["72:9:10",572,"يَجِدْ","will find","فَمَن يَسْتَمِعِ ٱلْـَٔانَ","لَهُۥ شِهَابًۭا رَّصَدًۭا",106],["72:22:9",573,"أَجِدَ","can I find","ٱللَّهِ أَحَدٌۭ وَلَنْ","مِن دُونِهِۦ مُلْتَحَدًا",106],["73:20:66",575,"تَجِدُوهُ","you will find it","لِأَنفُسِكُم مِّنْ خَيْرٍۢ","عِندَ ٱللَّهِ هُوَ",106],["93:6:2",596,"يَجِدْكَ","He find you","أَلَمْ","يَتِيمًۭا فَـَٔاوَىٰ",106],["93:7:1",596,"وَوَجَدَكَ","And He found you","","ضَآلًّۭا فَهَدَىٰ",106],["93:8:1",596,"وَوَجَدَكَ","And He found you","","عَآئِلًۭا فَأَغْنَىٰ",106]]