[["2:2:2",2,"ٱلْكِتَـٰبُ","(is) the book","ذَٰلِكَ","لَا رَيْبَ ۛ فِيهِ ۛ",49],["2:44:8",7,"ٱلْكِتَـٰبَ ۚ","the Book","أَنفُسَكُمْ وَأَنتُمْ تَتْلُونَ","أَفَلَا تَعْقِلُونَ",49],["2:53:4",8,"ٱلْكِتَـٰبَ","the Book","وَإِذْ ءَاتَيْنَا مُوسَى","وَٱلْفُرْقَانَ لَعَلَّكُمْ تَهْتَدُونَ",49],["2:78:5",12,"ٱلْكِتَـٰبَ","the book","أُمِّيُّونَ لَا يَعْلَمُونَ","إِلَّآ أَمَانِىَّ وَإِنْ",49],["2:79:3",12,"يَكْتُبُونَ","write","فَوَيْلٌۭ لِّلَّذِينَ","ٱلْكِتَـٰبَ بِأَيْدِيهِمْ ثُمَّ",243],["2:79:4",12,"ٱلْكِتَـٰبَ","the book","فَوَيْلٌۭ لِّلَّذِينَ يَكْتُبُونَ","بِأَيْدِيهِمْ ثُمَّ يَقُولُونَ",49],["2:79:19",12,"كَتَبَتْ","have written","فَوَيْلٌۭ لَّهُم مِّمَّا","أَيْدِيهِمْ وَوَيْلٌۭ لَّهُم",243],["2:85:25",13,"ٱلْكِتَـٰبِ","the Book","إِخْرَاجُهُمْ ۚ أَفَتُؤْمِنُونَ بِبَعْضِ","وَتَكْفُرُونَ بِبَعْضٍۢ ۚ فَمَا",49],["2:87:4",13,"ٱلْكِتَـٰبَ","the Book","وَلَقَدْ ءَاتَيْنَا مُوسَى","وَقَفَّيْنَا مِنۢ بَعْدِهِۦ",49],["2:89:3",14,"كِتَـٰبٌۭ","a Book","وَلَمَّا جَآءَهُمْ","مِّنْ عِندِ ٱللَّهِ",49],["2:101:15",15,"ٱلْكِتَـٰبَ","the Book","مِّنَ ٱلَّذِينَ أُوتُوا۟","كِتَـٰبَ ٱللَّهِ وَرَآءَ",49],["2:101:16",15,"كِتَـٰبَ","(the) Book","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ","ٱللَّهِ وَرَآءَ ظُهُورِهِمْ",49],["2:105:7",16,"ٱلْكِتَـٰبِ","(of) the Book","كَفَرُوا۟ مِنْ أَهْلِ","وَلَا ٱلْمُشْرِكِينَ أَن",49],["2:109:5",17,"ٱلْكِتَـٰبِ","(of) the Book","كَثِيرٌۭ مِّنْ أَهْلِ","لَوْ يَرُدُّونَكُم مِّنۢ",49],["2:113:15",18,"ٱلْكِتَـٰبَ ۗ","the Book","شَىْءٍۢ وَهُمْ يَتْلُونَ","كَذَٰلِكَ قَالَ ٱلَّذِينَ",49],["2:121:3",19,"ٱلْكِتَـٰبَ","the Book","ٱلَّذِينَ ءَاتَيْنَـٰهُمُ","يَتْلُونَهُۥ حَقَّ تِلَاوَتِهِۦٓ",49],["2:129:10",20,"ٱلْكِتَـٰبَ","the Book","عَلَيْهِمْ ءَايَـٰتِكَ وَيُعَلِّمُهُمُ","وَٱلْحِكْمَةَ وَيُزَكِّيهِمْ ۚ إِنَّكَ",49],["2:144:24",22,"ٱلْكِتَـٰبَ","the Book","وَإِنَّ ٱلَّذِينَ أُوتُوا۟","لَيَعْلَمُونَ أَنَّهُ ٱلْحَقُّ",49],["2:145:5",22,"ٱلْكِتَـٰبَ","the Book","أَتَيْتَ ٱلَّذِينَ أُوتُوا۟","بِكُلِّ ءَايَةٍۢ مَّا",49],["2:146:3",23,"ٱلْكِتَـٰبَ","the Book","ٱلَّذِينَ ءَاتَيْنَـٰهُمُ","يَعْرِفُونَهُۥ كَمَا يَعْرِفُونَ",49],["2:151:11",23,"ٱلْكِتَـٰبَ","the Book","ءَايَـٰتِنَا وَيُزَكِّيكُمْ وَيُعَلِّمُكُمُ","وَٱلْحِكْمَةَ وَيُعَلِّمُكُم مَّا",49],["2:159:15",24,"ٱلْكِتَـٰبِ ۙ","the Book","بَيَّنَّـٰهُ لِلنَّاسِ فِى","أُو۟لَـٰٓئِكَ يَلْعَنُهُمُ ٱللَّهُ",49],["2:174:8",26,"ٱلْكِتَـٰبِ","the Book","أَنزَلَ ٱللَّهُ مِنَ","وَيَشْتَرُونَ بِهِۦ ثَمَنًۭا",49],["2:176:5",26,"ٱلْكِتَـٰبَ","the Book","بِأَنَّ ٱللَّهَ نَزَّلَ","بِٱلْحَقِّ ۗ وَإِنَّ ٱلَّذِينَ",49],["2:176:11",26,"ٱلْكِتَـٰبِ","the Book","ٱلَّذِينَ ٱخْتَلَفُوا۟ فِى","لَفِى شِقَاقٍۭ بَعِيدٍۢ",49],["2:177:17",27,"وَٱلْكِتَـٰبِ","and the Book","وَٱلْيَوْمِ ٱلْـَٔاخِرِ وَٱلْمَلَـٰٓئِكَةِ","وَٱلنَّبِيِّـۧنَ وَءَاتَى ٱلْمَالَ",49],["2:178:4",27,"كُتِبَ","Prescribed","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","عَلَيْكُمُ ٱلْقِصَاصُ فِى",243],["2:180:1",27,"كُتِبَ","Prescribed","","عَلَيْكُمْ إِذَا حَضَرَ",243],["2:183:4",28,"كُتِبَ","Is prescribed","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟","عَلَيْكُمُ ٱلصِّيَامُ كَمَا",243],["2:183:8",28,"كُتِبَ","was prescribed","عَلَيْكُمُ ٱلصِّيَامُ كَمَا","عَلَى ٱلَّذِينَ مِن",243],["2:187:28",29,"كَتَبَ","has ordained","بَـٰشِرُوهُنَّ وَٱبْتَغُوا۟ مَا","ٱللَّهُ لَكُمْ ۚ وَكُلُوا۟",243],["2:213:12",33,"ٱلْكِتَـٰبَ","the Book","وَمُنذِرِينَ وَأَنزَلَ مَعَهُمُ","بِٱلْحَقِّ لِيَحْكُمَ بَيْنَ",49],["2:216:1",34,"كُتِبَ","Is prescribed","","عَلَيْكُمُ ٱلْقِتَالُ وَهُوَ",243],["2:231:34",37,"ٱلْكِتَـٰبِ","the Book","أَنزَلَ عَلَيْكُم مِّنَ","وَٱلْحِكْمَةِ يَعِظُكُم بِهِۦ ۚ",49],["2:235:33",38,"ٱلْكِتَـٰبُ","the prescribed term","ٱلنِّكَاحِ حَتَّىٰ يَبْلُغَ","أَجَلَهُۥ ۚ وَٱعْلَمُوٓا۟ أَنَّ",49],["2:246:26",40,"كُتِبَ","prescribed","هَلْ عَسَيْتُمْ إِن","عَلَيْكُمُ ٱلْقِتَالُ أَلَّا",243],["2:246:45",40,"كُتِبَ","was prescribed","دِيَـٰرِنَا وَأَبْنَآئِنَا ۖ فَلَمَّا","عَلَيْهِمُ ٱلْقِتَالُ تَوَلَّوْا۟",243],["2:282:10",48,"فَٱكْتُبُوهُ ۚ","then write it","إِلَىٰٓ أَجَلٍۢ مُّسَمًّۭى","وَلْيَكْتُب بَّيْنَكُمْ كَاتِبٌۢ",243],["2:282:11",48,"وَلْيَكْتُب","And let write","أَجَلٍۢ مُّسَمًّۭى فَٱكْتُبُوهُ ۚ","بَّيْنَكُمْ كَاتِبٌۢ بِٱلْعَدْلِ ۚ",243],["2:282:13",48,"كَاتِبٌۢ","a scribe","فَٱكْتُبُوهُ ۚ وَلْيَكْتُب بَّيْنَكُمْ","بِٱلْعَدْلِ ۚ وَلَا يَأْبَ",1188],["2:282:17",48,"كَاتِبٌ","a scribe","بِٱلْعَدْلِ ۚ وَلَا يَأْبَ","أَن يَكْتُبَ كَمَا",1188],["2:282:19",48,"يَكْتُبَ","he writes","يَأْبَ كَاتِبٌ أَن","كَمَا عَلَّمَهُ ٱللَّهُ ۚ",243],["2:282:23",48,"فَلْيَكْتُبْ","So let him write","كَمَا عَلَّمَهُ ٱللَّهُ ۚ","وَلْيُمْلِلِ ٱلَّذِى عَلَيْهِ",243],["2:282:81",48,"تَكْتُبُوهُ","you write it","وَلَا تَسْـَٔمُوٓا۟ أَن","صَغِيرًا أَوْ كَبِيرًا",243],["2:282:107",48,"تَكْتُبُوهَا ۗ","you write it","عَلَيْكُمْ جُنَاحٌ أَلَّا","وَأَشْهِدُوٓا۟ إِذَا تَبَايَعْتُمْ ۚ",243],["2:282:113",48,"كَاتِبٌۭ","(the) scribe","تَبَايَعْتُمْ ۚ وَلَا يُضَآرَّ","وَلَا شَهِيدٌۭ ۚ وَإِن",1188],["2:283:7",49,"كَاتِبًۭا","a scribe","سَفَرٍۢ وَلَمْ تَجِدُوا۟","فَرِهَـٰنٌۭ مَّقْبُوضَةٌۭ ۖ فَإِنْ",1188],["2:285:13",49,"وَكُتُبِهِۦ","and His Books","ءَامَنَ بِٱللَّهِ وَمَلَـٰٓئِكَتِهِۦ","وَرُسُلِهِۦ لَا نُفَرِّقُ",49],["3:3:3",50,"ٱلْكِتَـٰبَ","the Book","نَزَّلَ عَلَيْكَ","بِٱلْحَقِّ مُصَدِّقًۭا لِّمَا",49],["3:7:5",50,"ٱلْكِتَـٰبَ","the Book","ٱلَّذِىٓ أَنزَلَ عَلَيْكَ","مِنْهُ ءَايَـٰتٌۭ مُّحْكَمَـٰتٌ",49],["3:7:11",50,"ٱلْكِتَـٰبِ","(of) the Book","مُّحْكَمَـٰتٌ هُنَّ أُمُّ","وَأُخَرُ مُتَشَـٰبِهَـٰتٌۭ ۖ فَأَمَّا",49],["3:19:10",52,"ٱلْكِتَـٰبَ","the Book","ٱخْتَلَفَ ٱلَّذِينَ أُوتُوا۟","إِلَّا مِنۢ بَعْدِ",49],["3:20:12",52,"ٱلْكِتَـٰبَ","the Book","وَقُل لِّلَّذِينَ أُوتُوا۟","وَٱلْأُمِّيِّـۧنَ ءَأَسْلَمْتُمْ ۚ فَإِنْ",49],["3:23:8",53,"ٱلْكِتَـٰبِ","the Scripture","أُوتُوا۟ نَصِيبًۭا مِّنَ","يُدْعَوْنَ إِلَىٰ كِتَـٰبِ",49],["3:23:11",53,"كِتَـٰبِ","(the) Book","ٱلْكِتَـٰبِ يُدْعَوْنَ إِلَىٰ","ٱللَّهِ لِيَحْكُمَ بَيْنَهُمْ",49],["3:48:2",56,"ٱلْكِتَـٰبَ","the Book","وَيُعَلِّمُهُ","وَٱلْحِكْمَةَ وَٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ",49],["3:53:7",57,"فَٱكْتُبْنَا","then write us","أَنزَلْتَ وَٱتَّبَعْنَا ٱلرَّسُولَ","مَعَ ٱلشَّـٰهِدِينَ",243],["3:64:3",58,"ٱلْكِتَـٰبِ","(of) the Book","قُلْ يَـٰٓأَهْلَ","تَعَالَوْا۟ إِلَىٰ كَلِمَةٍۢ",49],["3:65:2",58,"ٱلْكِتَـٰبِ","(of) the Book","يَـٰٓأَهْلَ","لِمَ تُحَآجُّونَ فِىٓ",49],["3:69:5",58,"ٱلْكِتَـٰبِ","(of) the Book","طَّآئِفَةٌۭ مِّنْ أَهْلِ","لَوْ يُضِلُّونَكُمْ وَمَا",49],["3:70:2",58,"ٱلْكِتَـٰبِ","(of) the Book","يَـٰٓأَهْلَ","لِمَ تَكْفُرُونَ بِـَٔايَـٰتِ",49],["3:71:2",59,"ٱلْكِتَـٰبِ","(of) the Book","يَـٰٓأَهْلَ","لِمَ تَلْبِسُونَ ٱلْحَقَّ",49],["3:72:5",59,"ٱلْكِتَـٰبِ","(of) the Book","طَّآئِفَةٌۭ مِّنْ أَهْلِ","ءَامِنُوا۟ بِٱلَّذِىٓ أُنزِلَ",49],["3:75:3",59,"ٱلْكِتَـٰبِ","(of) the Book","۞ وَمِنْ أَهْلِ","مَنْ إِن تَأْمَنْهُ",49],["3:78:6",60,"بِٱلْكِتَـٰبِ","in (reciting) the Book","لَفَرِيقًۭا يَلْوُۥنَ أَلْسِنَتَهُم","لِتَحْسَبُوهُ مِنَ ٱلْكِتَـٰبِ",49],["3:78:9",60,"ٱلْكِتَـٰبِ","the Book","بِٱلْكِتَـٰبِ لِتَحْسَبُوهُ مِنَ","وَمَا هُوَ مِنَ",49],["3:78:13",60,"ٱلْكِتَـٰبِ","the Book","وَمَا هُوَ مِنَ","وَيَقُولُونَ هُوَ مِنْ",49],["3:79:7",60,"ٱلْكِتَـٰبَ","the Book","أَن يُؤْتِيَهُ ٱللَّهُ","وَٱلْحُكْمَ وَٱلنُّبُوَّةَ ثُمَّ",49],["3:79:25",60,"ٱلْكِتَـٰبَ","the Book","بِمَا كُنتُمْ تُعَلِّمُونَ","وَبِمَا كُنتُمْ تَدْرُسُونَ",49],["3:81:9",60,"كِتَـٰبٍۢ","(the) Book","لَمَآ ءَاتَيْتُكُم مِّن","وَحِكْمَةٍۢ ثُمَّ جَآءَكُمْ",49],["3:98:3",62,"ٱلْكِتَـٰبِ","(of) the Book","قُلْ يَـٰٓأَهْلَ","لِمَ تَكْفُرُونَ بِـَٔايَـٰتِ",49],["3:99:3",62,"ٱلْكِتَـٰبِ","(of) the Book","قُلْ يَـٰٓأَهْلَ","لِمَ تَصُدُّونَ عَن",49],["3:100:10",62,"ٱلْكِتَـٰبَ","the Book","مِّنَ ٱلَّذِينَ أُوتُوا۟","يَرُدُّوكُم بَعْدَ إِيمَـٰنِكُمْ",49],["3:110:16",64,"ٱلْكِتَـٰبِ","(of) the Book","وَلَوْ ءَامَنَ أَهْلُ","لَكَانَ خَيْرًۭا لَّهُم ۚ",49],["3:113:5",64,"ٱلْكِتَـٰبِ","(of) the Book","سَوَآءًۭ ۗ مِّنْ أَهْلِ","أُمَّةٌۭ قَآئِمَةٌۭ يَتْلُونَ",49],["3:119:7",65,"بِٱلْكِتَـٰبِ","in the Book","وَلَا يُحِبُّونَكُمْ وَتُؤْمِنُونَ","كُلِّهِۦ وَإِذَا لَقُوكُمْ",49],["3:145:9",68,"كِتَـٰبًۭا","(at a) decree","إِلَّا بِإِذْنِ ٱللَّهِ","مُّؤَجَّلًۭا ۗ وَمَن يُرِدْ",49],["3:154:58",70,"كُتِبَ","was decreed","بُيُوتِكُمْ لَبَرَزَ ٱلَّذِينَ","عَلَيْهِمُ ٱلْقَتْلُ إِلَىٰ",243],["3:164:17",71,"ٱلْكِتَـٰبَ","the Book","ءَايَـٰتِهِۦ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ","وَٱلْحِكْمَةَ وَإِن كَانُوا۟",49],["3:181:12",74,"سَنَكْتُبُ","We will record","فَقِيرٌۭ وَنَحْنُ أَغْنِيَآءُ ۘ","مَا قَالُوا۟ وَقَتْلَهُمُ",243],["3:184:11",74,"وَٱلْكِتَـٰبِ","and the Book","جَآءُو بِٱلْبَيِّنَـٰتِ وَٱلزُّبُرِ","ٱلْمُنِيرِ",49],["3:186:9",74,"ٱلْكِتَـٰبَ","the Book","مِنَ ٱلَّذِينَ أُوتُوا۟","مِن قَبْلِكُمْ وَمِنَ",49],["3:187:7",75,"ٱلْكِتَـٰبَ","the Book","مِيثَـٰقَ ٱلَّذِينَ أُوتُوا۟","لَتُبَيِّنُنَّهُۥ لِلنَّاسِ وَلَا",49],["3:199:4",76,"ٱلْكِتَـٰبِ","(of) the Book","وَإِنَّ مِنْ أَهْلِ","لَمَن يُؤْمِنُ بِٱللَّهِ",49],["4:24:8",82,"كِتَـٰبَ","Decree","مَا مَلَكَتْ أَيْمَـٰنُكُمْ ۖ","ٱللَّهِ عَلَيْكُمْ ۚ وَأُحِلَّ",49],["4:44:8",85,"ٱلْكِتَـٰبِ","the Book","أُوتُوا۟ نَصِيبًۭا مِّنَ","يَشْتَرُونَ ٱلضَّلَـٰلَةَ وَيُرِيدُونَ",49],["4:47:4",86,"ٱلْكِتَـٰبَ","the Book","يَـٰٓأَيُّهَا ٱلَّذِينَ أُوتُوا۟","ءَامِنُوا۟ بِمَا نَزَّلْنَا",49],["4:51:8",86,"ٱلْكِتَـٰبِ","the Book","أُوتُوا۟ نَصِيبًۭا مِّنَ","يُؤْمِنُونَ بِٱلْجِبْتِ وَٱلطَّـٰغُوتِ",49],["4:54:14",87,"ٱلْكِتَـٰبَ","the Book","ءَاتَيْنَآ ءَالَ إِبْرَٰهِيمَ","وَٱلْحِكْمَةَ وَءَاتَيْنَـٰهُم مُّلْكًا",49],["4:66:3",89,"كَتَبْنَا","(had) decreed","وَلَوْ أَنَّا","عَلَيْهِمْ أَنِ ٱقْتُلُوٓا۟",243],["4:77:14",90,"كُتِبَ","was ordained","وَءَاتُوا۟ ٱلزَّكَوٰةَ فَلَمَّا","عَلَيْهِمُ ٱلْقِتَالُ إِذَا",243],["4:77:30",90,"كَتَبْتَ","have You ordained","وَقَالُوا۟ رَبَّنَا لِمَ","عَلَيْنَا ٱلْقِتَالَ لَوْلَآ",243],["4:81:14",91,"يَكْتُبُ","records","ٱلَّذِى تَقُولُ ۖ وَٱللَّهُ","مَا يُبَيِّتُونَ ۖ فَأَعْرِضْ",243],["4:103:19",95,"كِتَـٰبًۭا","prescribed","كَانَتْ عَلَى ٱلْمُؤْمِنِينَ","مَّوْقُوتًۭا",49],["4:105:4",95,"ٱلْكِتَـٰبَ","the Book","إِنَّآ أَنزَلْنَآ إِلَيْكَ","بِٱلْحَقِّ لِتَحْكُمَ بَيْنَ",49],["4:113:22",96,"ٱلْكِتَـٰبَ","the Book","وَأَنزَلَ ٱللَّهُ عَلَيْكَ","وَٱلْحِكْمَةَ وَعَلَّمَكَ مَا",49],["4:123:6",98,"ٱلْكِتَـٰبِ ۗ","(of) the Book","وَلَآ أَمَانِىِّ أَهْلِ","مَن يَعْمَلْ سُوٓءًۭا",49],["4:127:12",98,"ٱلْكِتَـٰبِ","the Book","يُتْلَىٰ عَلَيْكُمْ فِى","فِى يَتَـٰمَى ٱلنِّسَآءِ",49],["4:127:20",98,"كُتِبَ","is ordained","لَا تُؤْتُونَهُنَّ مَا","لَهُنَّ وَتَرْغَبُونَ أَن",243],["4:131:12",99,"ٱلْكِتَـٰبَ","the Book","وَصَّيْنَا ٱلَّذِينَ أُوتُوا۟","مِن قَبْلِكُمْ وَإِيَّاكُمْ",49],["4:136:7",100,"وَٱلْكِتَـٰبِ","and the Book","ءَامِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ","ٱلَّذِى نَزَّلَ عَلَىٰ",49],["4:136:12",100,"وَٱلْكِتَـٰبِ","and the Book","نَزَّلَ عَلَىٰ رَسُولِهِۦ","ٱلَّذِىٓ أَنزَلَ مِن",49],["4:136:21",100,"وَكُتُبِهِۦ","and His Books","يَكْفُرْ بِٱللَّهِ وَمَلَـٰٓئِكَتِهِۦ","وَرُسُلِهِۦ وَٱلْيَوْمِ ٱلْـَٔاخِرِ",49],["4:140:5",100,"ٱلْكِتَـٰبِ","the Book","نَزَّلَ عَلَيْكُمْ فِى","أَنْ إِذَا سَمِعْتُمْ",49],["4:153:3",102,"ٱلْكِتَـٰبِ","(of) the Book","يَسْـَٔلُكَ أَهْلُ","أَن تُنَزِّلَ عَلَيْهِمْ",49],["4:153:7",102,"كِتَـٰبًۭا","a book","أَن تُنَزِّلَ عَلَيْهِمْ","مِّنَ ٱلسَّمَآءِ ۚ فَقَدْ",49],["4:159:4",103,"ٱلْكِتَـٰبِ","(of) the Book","وَإِن مِّنْ أَهْلِ","إِلَّا لَيُؤْمِنَنَّ بِهِۦ",49],["4:171:2",105,"ٱلْكِتَـٰبِ","(of) the Book","يَـٰٓأَهْلَ","لَا تَغْلُوا۟ فِى",49],["5:5:8",107,"ٱلْكِتَـٰبَ","the Book","وَطَعَامُ ٱلَّذِينَ أُوتُوا۟","حِلٌّۭ لَّكُمْ وَطَعَامُكُمْ",49],["5:5:21",107,"ٱلْكِتَـٰبَ","the Book","مِنَ ٱلَّذِينَ أُوتُوا۟","مِن قَبْلِكُمْ إِذَآ",49],["5:15:2",110,"ٱلْكِتَـٰبِ","(of) the Book","يَـٰٓأَهْلَ","قَدْ جَآءَكُمْ رَسُولُنَا",49],["5:15:13",110,"ٱلْكِتَـٰبِ","the Scripture","كُنتُمْ تُخْفُونَ مِنَ","وَيَعْفُوا۟ عَن كَثِيرٍۢ ۚ",49],["5:15:22",110,"وَكِتَـٰبٌۭ","and a Book","مِّنَ ٱللَّهِ نُورٌۭ","مُّبِينٌۭ",49],["5:19:2",111,"ٱلْكِتَـٰبِ","(of) the Book","يَـٰٓأَهْلَ","قَدْ جَآءَكُمْ رَسُولُنَا",49],["5:21:6",111,"كَتَبَ","(has been) ordained","ٱلْأَرْضَ ٱلْمُقَدَّسَةَ ٱلَّتِى","ٱللَّهُ لَكُمْ وَلَا",243],["5:32:4",113,"كَتَبْنَا","We ordained","مِنْ أَجْلِ ذَٰلِكَ","عَلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ",243],["5:44:19",115,"كِتَـٰبِ","(the) Book","بِمَا ٱسْتُحْفِظُوا۟ مِن","ٱللَّهِ وَكَانُوا۟ عَلَيْهِ",49],["5:45:1",115,"وَكَتَبْنَا","And We ordained","","عَلَيْهِمْ فِيهَآ أَنَّ",243],["5:48:3",116,"ٱلْكِتَـٰبَ","the Book","وَأَنزَلْنَآ إِلَيْكَ","بِٱلْحَقِّ مُصَدِّقًۭا لِّمَا",49],["5:48:10",116,"ٱلْكِتَـٰبِ","the Book","بَيْنَ يَدَيْهِ مِنَ","وَمُهَيْمِنًا عَلَيْهِ ۖ فَٱحْكُم",49],["5:57:14",117,"ٱلْكِتَـٰبَ","the Book","مِّنَ ٱلَّذِينَ أُوتُوا۟","مِن قَبْلِكُمْ وَٱلْكُفَّارَ",49],["5:59:3",118,"ٱلْكِتَـٰبِ","(of) the Book","قُلْ يَـٰٓأَهْلَ","هَلْ تَنقِمُونَ مِنَّآ",49],["5:65:4",119,"ٱلْكِتَـٰبِ","(of) the Book","وَلَوْ أَنَّ أَهْلَ","ءَامَنُوا۟ وَٱتَّقَوْا۟ لَكَفَّرْنَا",49],["5:68:3",119,"ٱلْكِتَـٰبِ","(of) the Book","قُلْ يَـٰٓأَهْلَ","لَسْتُمْ عَلَىٰ شَىْءٍ",49],["5:77:3",120,"ٱلْكِتَـٰبِ","(of) the Book","قُلْ يَـٰٓأَهْلَ","لَا تَغْلُوا۟ فِى",49],["5:83:19",121,"فَٱكْتُبْنَا","so write us","يَقُولُونَ رَبَّنَآ ءَامَنَّا","مَعَ ٱلشَّـٰهِدِينَ",243],["5:110:23",126,"ٱلْكِتَـٰبَ","the Book","وَكَهْلًۭا ۖ وَإِذْ عَلَّمْتُكَ","وَٱلْحِكْمَةَ وَٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ ۖ",49],["6:7:4",128,"كِتَـٰبًۭا","a written Scripture","وَلَوْ نَزَّلْنَا عَلَيْكَ","فِى قِرْطَاسٍۢ فَلَمَسُوهُ",49],["6:12:9",129,"كَتَبَ","He has decreed","وَٱلْأَرْضِ ۖ قُل لِّلَّهِ ۚ","عَلَىٰ نَفْسِهِ ٱلرَّحْمَةَ ۚ",243],["6:20:3",130,"ٱلْكِتَـٰبَ","the Book","ٱلَّذِينَ ءَاتَيْنَـٰهُمُ","يَعْرِفُونَهُۥ كَمَا يَعْرِفُونَ",49],["6:38:16",132,"ٱلْكِتَـٰبِ","the Book","مَّا فَرَّطْنَا فِى","مِن شَىْءٍۢ ۚ ثُمَّ",49],["6:54:9",134,"كَتَبَ","(Has) Prescribed","فَقُلْ سَلَـٰمٌ عَلَيْكُمْ ۖ","رَبُّكُمْ عَلَىٰ نَفْسِهِ",243],["6:59:30",134,"كِتَـٰبٍۢ","a Record","يَابِسٍ إِلَّا فِى","مُّبِينٍۢ",49],["6:89:4",138,"ٱلْكِتَـٰبَ","the Book","أُو۟لَـٰٓئِكَ ٱلَّذِينَ ءَاتَيْنَـٰهُمُ","وَٱلْحُكْمَ وَٱلنُّبُوَّةَ ۚ فَإِن",49],["6:91:18",139,"ٱلْكِتَـٰبَ","the Book","قُلْ مَنْ أَنزَلَ","ٱلَّذِى جَآءَ بِهِۦ",49],["6:92:2",139,"كِتَـٰبٌ","(is) a Book","وَهَـٰذَا","أَنزَلْنَـٰهُ مُبَارَكٌۭ مُّصَدِّقُ",49],["6:114:9",142,"ٱلْكِتَـٰبَ","the Book","ٱلَّذِىٓ أَنزَلَ إِلَيْكُمُ","مُفَصَّلًۭا ۚ وَٱلَّذِينَ ءَاتَيْنَـٰهُمُ",49],["6:114:13",142,"ٱلْكِتَـٰبَ","the Book","مُفَصَّلًۭا ۚ وَٱلَّذِينَ ءَاتَيْنَـٰهُمُ","يَعْلَمُونَ أَنَّهُۥ مُنَزَّلٌۭ",49],["6:154:4",149,"ٱلْكِتَـٰبَ","the Book","ثُمَّ ءَاتَيْنَا مُوسَى","تَمَامًا عَلَى ٱلَّذِىٓ",49],["6:155:2",149,"كِتَـٰبٌ","(is) a Book","وَهَـٰذَا","أَنزَلْنَـٰهُ مُبَارَكٌۭ فَٱتَّبِعُوهُ",49],["6:156:5",149,"ٱلْكِتَـٰبُ","the Book","تَقُولُوٓا۟ إِنَّمَآ أُنزِلَ","عَلَىٰ طَآئِفَتَيْنِ مِن",49],["6:157:7",149,"ٱلْكِتَـٰبُ","the Book","أَنَّآ أُنزِلَ عَلَيْنَا","لَكُنَّآ أَهْدَىٰ مِنْهُمْ ۚ",49],["7:2:1",151,"كِتَـٰبٌ","(This is) a Book","","أُنزِلَ إِلَيْكَ فَلَا",49],["7:37:15",154,"ٱلْكِتَـٰبِ ۖ","the Book","يَنَالُهُمْ نَصِيبُهُم مِّنَ","حَتَّىٰٓ إِذَا جَآءَتْهُمْ",49],["7:52:3",157,"بِكِتَـٰبٍۢ","a Book","وَلَقَدْ جِئْنَـٰهُم","فَصَّلْنَـٰهُ عَلَىٰ عِلْمٍ",49],["7:145:1",168,"وَكَتَبْنَا","And We ordained (laws)","","لَهُۥ فِى ٱلْأَلْوَاحِ",243],["7:156:1",170,"۞ وَٱكْتُبْ","And ordain","","لَنَا فِى هَـٰذِهِ",243],["7:156:22",170,"فَسَأَكْتُبُهَا","So I will ordain it","وَسِعَتْ كُلَّ شَىْءٍۢ ۚ","لِلَّذِينَ يَتَّقُونَ وَيُؤْتُونَ",243],["7:157:8",170,"مَكْتُوبًا","written","ٱلْأُمِّىَّ ٱلَّذِى يَجِدُونَهُۥ","عِندَهُمْ فِى ٱلتَّوْرَىٰةِ",3677],["7:169:6",172,"ٱلْكِتَـٰبَ","the Book","بَعْدِهِمْ خَلْفٌۭ وَرِثُوا۟","يَأْخُذُونَ عَرَضَ هَـٰذَا",49],["7:169:23",172,"ٱلْكِتَـٰبِ","(of) the Book","يُؤْخَذْ عَلَيْهِم مِّيثَـٰقُ","أَن لَّا يَقُولُوا۟",49],["7:170:3",172,"بِٱلْكِتَـٰبِ","to the Book","وَٱلَّذِينَ يُمَسِّكُونَ","وَأَقَامُوا۟ ٱلصَّلَوٰةَ إِنَّا",49],["7:196:6",176,"ٱلْكِتَـٰبَ ۖ","the Book","ٱللَّهُ ٱلَّذِى نَزَّلَ","وَهُوَ يَتَوَلَّى ٱلصَّـٰلِحِينَ",49],["8:68:2",185,"كِتَـٰبٌۭ","an ordainment","لَّوْلَا","مِّنَ ٱللَّهِ سَبَقَ",49],["8:75:16",186,"كِتَـٰبِ","(the) Book","أَوْلَىٰ بِبَعْضٍۢ فِى","ٱللَّهِ ۗ إِنَّ ٱللَّهَ",49],["9:29:22",191,"ٱلْكِتَـٰبَ","the Scripture","مِنَ ٱلَّذِينَ أُوتُوا۟","حَتَّىٰ يُعْطُوا۟ ٱلْجِزْيَةَ",49],["9:36:10",192,"كِتَـٰبِ","(the) ordinance","عَشَرَ شَهْرًۭا فِى","ٱللَّهِ يَوْمَ خَلَقَ",49],["9:51:6",195,"كَتَبَ","Allah has decreed","يُصِيبَنَآ إِلَّا مَا","ٱللَّهُ لَنَا هُوَ",243],["9:120:42",206,"كُتِبَ","is recorded","عَدُوٍّۢ نَّيْلًا إِلَّا","لَهُم بِهِۦ عَمَلٌۭ",243],["9:121:11",206,"كُتِبَ","is recorded","يَقْطَعُونَ وَادِيًا إِلَّا","لَهُمْ لِيَجْزِيَهُمُ ٱللَّهُ",243],["10:1:4",208,"ٱلْكِتَـٰبِ","(of) the Book","الٓر ۚ تِلْكَ ءَايَـٰتُ","ٱلْحَكِيمِ",49],["10:21:20",211,"يَكْتُبُونَ","write down","مَكْرًا ۚ إِنَّ رُسُلَنَا","مَا تَمْكُرُونَ",243],["10:37:16",213,"ٱلْكِتَـٰبِ","(of) the Book","بَيْنَ يَدَيْهِ وَتَفْصِيلَ","لَا رَيْبَ فِيهِ",49],["10:61:41",215,"كِتَـٰبٍۢ","a Record","أَكْبَرَ إِلَّا فِى","مُّبِينٍ",49],["10:94:11",219,"ٱلْكِتَـٰبَ","the Book","فَسْـَٔلِ ٱلَّذِينَ يَقْرَءُونَ","مِن قَبْلِكَ ۚ لَقَدْ",49],["11:1:2",221,"كِتَـٰبٌ","(This is) a Book","الٓر ۚ","أُحْكِمَتْ ءَايَـٰتُهُۥ ثُمَّ",49],["11:6:15",222,"كِتَـٰبٍۢ","a Record","وَمُسْتَوْدَعَهَا ۚ كُلٌّۭ فِى","مُّبِينٍۢ",49],["11:17:12",223,"كِتَـٰبُ","(was) a Book","مِّنْهُ وَمِن قَبْلِهِۦ","مُوسَىٰٓ إِمَامًۭا وَرَحْمَةً ۚ",49],["11:110:4",234,"ٱلْكِتَـٰبَ","the Book","وَلَقَدْ ءَاتَيْنَا مُوسَى","فَٱخْتُلِفَ فِيهِ ۚ وَلَوْلَا",49],["12:1:4",235,"ٱلْكِتَـٰبِ","(of) the Book","الٓر ۚ تِلْكَ ءَايَـٰتُ","ٱلْمُبِينِ",49],["13:1:4",249,"ٱلْكِتَـٰبِ ۗ","(of) the Book","الٓمٓر ۚ تِلْكَ ءَايَـٰتُ","وَٱلَّذِىٓ أُنزِلَ إِلَيْكَ",49],["13:36:3",254,"ٱلْكِتَـٰبَ","the Book","وَٱلَّذِينَ ءَاتَيْنَـٰهُمُ","يَفْرَحُونَ بِمَآ أُنزِلَ",49],["13:38:21",254,"كِتَابٌۭ","prescribed","ٱللَّهِ ۗ لِكُلِّ أَجَلٍۢ","",49],["13:39:8",254,"ٱلْكِتَـٰبِ","(is) the Mother (of) the Book","وَيُثْبِتُ ۖ وَعِندَهُۥٓ أُمُّ","",49],["13:43:15",255,"ٱلْكِتَـٰبِ","(of) the Book","وَمَنْ عِندَهُۥ عِلْمُ","",49],["14:1:2",255,"كِتَـٰبٌ","A Book","الٓر ۚ","أَنزَلْنَـٰهُ إِلَيْكَ لِتُخْرِجَ",49],["15:1:4",262,"ٱلْكِتَـٰبِ","(of) the Book","الٓر ۚ تِلْكَ ءَايَـٰتُ","وَقُرْءَانٍۢ مُّبِينٍۢ",49],["15:4:7",262,"كِتَابٌۭ","a decree","قَرْيَةٍ إِلَّا وَلَهَا","مَّعْلُومٌۭ",49],["16:64:4",273,"ٱلْكِتَـٰبَ","the Book","وَمَآ أَنزَلْنَا عَلَيْكَ","إِلَّا لِتُبَيِّنَ لَهُمُ",49],["16:89:17",277,"ٱلْكِتَـٰبَ","the Book","هَـٰٓؤُلَآءِ ۚ وَنَزَّلْنَا عَلَيْكَ","تِبْيَـٰنًۭا لِّكُلِّ شَىْءٍۢ",49],["17:2:3",282,"ٱلْكِتَـٰبَ","the Book","وَءَاتَيْنَا مُوسَى","وَجَعَلْنَـٰهُ هُدًۭى لِّبَنِىٓ",49],["17:4:6",282,"ٱلْكِتَـٰبِ","the Book","بَنِىٓ إِسْرَٰٓءِيلَ فِى","لَتُفْسِدُنَّ فِى ٱلْأَرْضِ",49],["17:13:11",283,"كِتَـٰبًۭا","a record","لَهُۥ يَوْمَ ٱلْقِيَـٰمَةِ","يَلْقَىٰهُ مَنشُورًا",49],["17:14:2",283,"كِتَـٰبَكَ","your record","ٱقْرَأْ","كَفَىٰ بِنَفْسِكَ ٱلْيَوْمَ",49],["17:58:17",287,"ٱلْكِتَـٰبِ","the Book","كَانَ ذَٰلِكَ فِى","مَسْطُورًۭا",49],["17:71:8",289,"كِتَـٰبَهُۥ","his record","بِإِمَـٰمِهِمْ ۖ فَمَنْ أُوتِىَ","بِيَمِينِهِۦ فَأُو۟لَـٰٓئِكَ يَقْرَءُونَ",49],["17:71:12",289,"كِتَـٰبَهُمْ","their records","بِيَمِينِهِۦ فَأُو۟لَـٰٓئِكَ يَقْرَءُونَ","وَلَا يُظْلَمُونَ فَتِيلًۭا",49],["17:93:17",291,"كِتَـٰبًۭا","a book","حَتَّىٰ تُنَزِّلَ عَلَيْنَا","نَّقْرَؤُهُۥ ۗ قُلْ سُبْحَانَ",49],["18:1:7",293,"ٱلْكِتَـٰبَ","the Book","أَنزَلَ عَلَىٰ عَبْدِهِ","وَلَمْ يَجْعَل لَّهُۥ",49],["18:27:6",296,"كِتَابِ","the Book","أُوحِىَ إِلَيْكَ مِن","رَبِّكَ ۖ لَا مُبَدِّلَ",49],["18:49:2",299,"ٱلْكِتَـٰبُ","the Book","وَوُضِعَ","فَتَرَى ٱلْمُجْرِمِينَ مُشْفِقِينَ",49],["18:49:12",299,"ٱلْكِتَـٰبِ","[the] Book","يَـٰوَيْلَتَنَا مَالِ هَـٰذَا","لَا يُغَادِرُ صَغِيرَةًۭ",49],["19:12:3",306,"ٱلْكِتَـٰبَ","the Scripture","يَـٰيَحْيَىٰ خُذِ","بِقُوَّةٍۢ ۖ وَءَاتَيْنَـٰهُ ٱلْحُكْمَ",49],["19:16:3",306,"ٱلْكِتَـٰبِ","the Book","وَٱذْكُرْ فِى","مَرْيَمَ إِذِ ٱنتَبَذَتْ",49],["19:30:6",307,"ٱلْكِتَـٰبَ","the Scripture","عَبْدُ ٱللَّهِ ءَاتَىٰنِىَ","وَجَعَلَنِى نَبِيًّۭا",49],["19:41:3",308,"ٱلْكِتَـٰبِ","the Book","وَٱذْكُرْ فِى","إِبْرَٰهِيمَ ۚ إِنَّهُۥ كَانَ",49],["19:51:3",308,"ٱلْكِتَـٰبِ","the Book","وَٱذْكُرْ فِى","مُوسَىٰٓ ۚ إِنَّهُۥ كَانَ",49],["19:54:3",309,"ٱلْكِتَـٰبِ","the Book","وَٱذْكُرْ فِى","إِسْمَـٰعِيلَ ۚ إِنَّهُۥ كَانَ",49],["19:56:3",309,"ٱلْكِتَـٰبِ","the Book","وَٱذْكُرْ فِى","إِدْرِيسَ ۚ إِنَّهُۥ كَانَ",49],["19:79:2",311,"سَنَكْتُبُ","We will record","كَلَّا ۚ","مَا يَقُولُ وَنَمُدُّ",243],["20:52:6",315,"كِتَـٰبٍۢ ۖ","a Record","عِندَ رَبِّى فِى","لَّا يَضِلُّ رَبِّى",49],["21:10:4",322,"كِتَـٰبًۭا","a Book","لَقَدْ أَنزَلْنَآ إِلَيْكُمْ","فِيهِ ذِكْرُكُمْ ۖ أَفَلَا",49],["21:94:12",330,"كَـٰتِبُونَ","(are) Recorders","لِسَعْيِهِۦ وَإِنَّا لَهُۥ","",1188],["21:104:6",331,"لِلْكُتُبِ ۚ","for records","ٱلسَّمَآءَ كَطَىِّ ٱلسِّجِلِّ","كَمَا بَدَأْنَآ أَوَّلَ",49],["21:105:2",331,"كَتَبْنَا","We have written","وَلَقَدْ","فِى ٱلزَّبُورِ مِنۢ",243],["22:4:1",332,"كُتِبَ","It has been decreed","","عَلَيْهِ أَنَّهُۥ مَن",243],["22:8:12",333,"كِتَـٰبٍۢ","a Book","وَلَا هُدًۭى وَلَا","مُّنِيرٍۢ",49],["22:70:13",340,"كِتَـٰبٍ ۚ","a Record","إِنَّ ذَٰلِكَ فِى","إِنَّ ذَٰلِكَ عَلَى",49],["23:49:4",345,"ٱلْكِتَـٰبَ","the Scripture","وَلَقَدْ ءَاتَيْنَا مُوسَى","لَعَلَّهُمْ يَهْتَدُونَ",49],["23:62:7",346,"كِتَـٰبٌۭ","(is) a Record","إِلَّا وُسْعَهَا ۖ وَلَدَيْنَا","يَنطِقُ بِٱلْحَقِّ ۚ وَهُمْ",49],["24:33:13",354,"ٱلْكِتَـٰبَ","the writing","فَضْلِهِۦ ۗ وَٱلَّذِينَ يَبْتَغُونَ","مِمَّا مَلَكَتْ أَيْمَـٰنُكُمْ",49],["24:33:17",354,"فَكَاتِبُوهُمْ","then give them (the) writing","مِمَّا مَلَكَتْ أَيْمَـٰنُكُمْ","إِنْ عَلِمْتُمْ فِيهِمْ",3559],["25:5:4",360,"ٱكْتَتَبَهَا","which he has had written","وَقَالُوٓا۟ أَسَـٰطِيرُ ٱلْأَوَّلِينَ","فَهِىَ تُمْلَىٰ عَلَيْهِ",4800],["25:35:4",363,"ٱلْكِتَـٰبَ","the Scripture","وَلَقَدْ ءَاتَيْنَا مُوسَى","وَجَعَلْنَا مَعَهُۥٓ أَخَاهُ",49],["26:2:3",367,"ٱلْكِتَـٰبِ","(of) the Book","تِلْكَ ءَايَـٰتُ","ٱلْمُبِينِ",49],["27:1:5",377,"وَكِتَابٍۢ","and a Book","تِلْكَ ءَايَـٰتُ ٱلْقُرْءَانِ","مُّبِينٍ",49],["27:28:2",379,"بِّكِتَـٰبِى","with my letter","ٱذْهَب","هَـٰذَا فَأَلْقِهْ إِلَيْهِمْ",3580],["27:29:7",379,"كِتَـٰبٌۭ","a letter","إِنِّىٓ أُلْقِىَ إِلَىَّ","كَرِيمٌ",49],["27:40:6",380,"ٱلْكِتَـٰبِ","the Scripture","عِندَهُۥ عِلْمٌۭ مِّنَ","أَنَا۠ ءَاتِيكَ بِهِۦ",49],["27:75:9",383,"كِتَـٰبٍۢ","a Record","وَٱلْأَرْضِ إِلَّا فِى","مُّبِينٍ",49],["28:2:3",385,"ٱلْكِتَـٰبِ","(of) the Book","تِلْكَ ءَايَـٰتُ","ٱلْمُبِينِ",49],["28:43:4",390,"ٱلْكِتَـٰبَ","the Scripture","وَلَقَدْ ءَاتَيْنَا مُوسَى","مِنۢ بَعْدِ مَآ",49],["28:49:3",391,"بِكِتَـٰبٍۢ","a Book","قُلْ فَأْتُوا۟","مِّنْ عِندِ ٱللَّهِ",49],["28:52:3",392,"ٱلْكِتَـٰبَ","the Scripture","ٱلَّذِينَ ءَاتَيْنَـٰهُمُ","مِن قَبْلِهِۦ هُم",49],["28:86:7",396,"ٱلْكِتَـٰبُ","the Book","أَن يُلْقَىٰٓ إِلَيْكَ","إِلَّا رَحْمَةًۭ مِّن",49],["29:27:9",399,"وَٱلْكِتَـٰبَ","and the Book","فِى ذُرِّيَّتِهِ ٱلنُّبُوَّةَ","وَءَاتَيْنَـٰهُ أَجْرَهُۥ فِى",49],["29:45:6",401,"ٱلْكِتَـٰبِ","the Book","أُوحِىَ إِلَيْكَ مِنَ","وَأَقِمِ ٱلصَّلَوٰةَ ۖ إِنَّ",49],["29:46:4",402,"ٱلْكِتَـٰبِ","(with the) People of the Book","۞ وَلَا تُجَـٰدِلُوٓا۟ أَهْلَ","إِلَّا بِٱلَّتِى هِىَ",49],["29:47:4",402,"ٱلْكِتَـٰبَ ۚ","the Book","وَكَذَٰلِكَ أَنزَلْنَآ إِلَيْكَ","فَٱلَّذِينَ ءَاتَيْنَـٰهُمُ ٱلْكِتَـٰبَ",49],["29:47:7",402,"ٱلْكِتَـٰبَ","the Book","ٱلْكِتَـٰبَ ۚ فَٱلَّذِينَ ءَاتَيْنَـٰهُمُ","يُؤْمِنُونَ بِهِۦ ۖ وَمِنْ",49],["29:48:7",402,"كِتَـٰبٍۢ","Book","مِن قَبْلِهِۦ مِن","وَلَا تَخُطُّهُۥ بِيَمِينِكَ ۖ",49],["29:51:6",402,"ٱلْكِتَـٰبَ","the Book","أَنَّآ أَنزَلْنَا عَلَيْكَ","يُتْلَىٰ عَلَيْهِمْ ۚ إِنَّ",49],["30:56:9",410,"كِتَـٰبِ","(the) Decree","لَقَدْ لَبِثْتُمْ فِى","ٱللَّهِ إِلَىٰ يَوْمِ",49],["31:2:3",411,"ٱلْكِتَـٰبِ","(of) the Book","تِلْكَ ءَايَـٰتُ","ٱلْحَكِيمِ",49],["31:20:29",413,"كِتَـٰبٍۢ","a book","وَلَا هُدًۭى وَلَا","مُّنِيرٍۢ",49],["32:2:2",415,"ٱلْكِتَـٰبِ","(of) the Book","تَنزِيلُ","لَا رَيْبَ فِيهِ",49],["32:23:4",417,"ٱلْكِتَـٰبَ","the Scripture","وَلَقَدْ ءَاتَيْنَا مُوسَى","فَلَا تَكُن فِى",49],["33:6:14",418,"كِتَـٰبِ","(the) Decree","أَوْلَىٰ بِبَعْضٍۢ فِى","ٱللَّهِ مِنَ ٱلْمُؤْمِنِينَ",49],["33:6:28",418,"ٱلْكِتَـٰبِ","the Book","كَانَ ذَٰلِكَ فِى","مَسْطُورًۭا",49],["33:26:6",421,"ٱلْكِتَـٰبِ","(of) the Scripture","ظَـٰهَرُوهُم مِّنْ أَهْلِ","مِن صَيَاصِيهِمْ وَقَذَفَ",49],["34:3:31",428,"كِتَـٰبٍۢ","a Record","أَكْبَرُ إِلَّا فِى","مُّبِينٍۢ",49],["34:44:4",433,"كُتُبٍۢ","Scriptures","وَمَآ ءَاتَيْنَـٰهُم مِّن","يَدْرُسُونَهَا ۖ وَمَآ أَرْسَلْنَآ",49],["35:11:29",435,"كِتَـٰبٍ ۚ","a Register","عُمُرِهِۦٓ إِلَّا فِى","إِنَّ ذَٰلِكَ عَلَى",49],["35:25:12",437,"وَبِٱلْكِتَـٰبِ","and with the Book","رُسُلُهُم بِٱلْبَيِّنَـٰتِ وَبِٱلزُّبُرِ","ٱلْمُنِيرِ",49],["35:29:4",437,"كِتَـٰبَ","(the) Book","إِنَّ ٱلَّذِينَ يَتْلُونَ","ٱللَّهِ وَأَقَامُوا۟ ٱلصَّلَوٰةَ",49],["35:31:5",438,"ٱلْكِتَـٰبِ","the Book","أَوْحَيْنَآ إِلَيْكَ مِنَ","هُوَ ٱلْحَقُّ مُصَدِّقًۭا",49],["35:32:3",438,"ٱلْكِتَـٰبَ","the Book","ثُمَّ أَوْرَثْنَا","ٱلَّذِينَ ٱصْطَفَيْنَا مِنْ",49],["35:40:21",439,"كِتَـٰبًۭا","a Book","ٱلسَّمَـٰوَٰتِ أَمْ ءَاتَيْنَـٰهُمْ","فَهُمْ عَلَىٰ بَيِّنَتٍۢ",49],["36:12:5",440,"وَنَكْتُبُ","and We record","نَحْنُ نُحْىِ ٱلْمَوْتَىٰ","مَا قَدَّمُوا۟ وَءَاثَـٰرَهُمْ ۚ",243],["37:117:2",450,"ٱلْكِتَـٰبَ","the Book","وَءَاتَيْنَـٰهُمَا","ٱلْمُسْتَبِينَ",49],["37:157:2",452,"بِكِتَـٰبِكُمْ","your book","فَأْتُوا۟","إِن كُنتُمْ صَـٰدِقِينَ",49],["38:29:1",455,"كِتَـٰبٌ","(This is) a Book","","أَنزَلْنَـٰهُ إِلَيْكَ مُبَـٰرَكٌۭ",49],["39:1:2",458,"ٱلْكِتَـٰبِ","(of) the Book","تَنزِيلُ","مِنَ ٱللَّهِ ٱلْعَزِيزِ",49],["39:2:4",458,"ٱلْكِتَـٰبَ","the Book","إِنَّآ أَنزَلْنَآ إِلَيْكَ","بِٱلْحَقِّ فَٱعْبُدِ ٱللَّهَ",49],["39:23:5",461,"كِتَـٰبًۭا","a Book","نَزَّلَ أَحْسَنَ ٱلْحَدِيثِ","مُّتَشَـٰبِهًۭا مَّثَانِىَ تَقْشَعِرُّ",49],["39:41:4",463,"ٱلْكِتَـٰبَ","the Book","إِنَّآ أَنزَلْنَا عَلَيْكَ","لِلنَّاسِ بِٱلْحَقِّ ۖ فَمَنِ",49],["39:69:6",466,"ٱلْكِتَـٰبُ","the Record","بِنُورِ رَبِّهَا وَوُضِعَ","وَجِا۟ىٓءَ بِٱلنَّبِيِّـۧنَ وَٱلشُّهَدَآءِ",49],["40:2:2",467,"ٱلْكِتَـٰبِ","(of) the Book","تَنزِيلُ","مِنَ ٱللَّهِ ٱلْعَزِيزِ",49],["40:53:8",473,"ٱلْكِتَـٰبَ","the Book","وَأَوْرَثْنَا بَنِىٓ إِسْرَٰٓءِيلَ","",49],["40:70:3",475,"بِٱلْكِتَـٰبِ","the Book","ٱلَّذِينَ كَذَّبُوا۟","وَبِمَآ أَرْسَلْنَا بِهِۦ",49],["41:3:1",477,"كِتَـٰبٌۭ","A Book","","فُصِّلَتْ ءَايَـٰتُهُۥ قُرْءَانًا",49],["41:41:8",481,"لَكِتَـٰبٌ","(is) surely a Book","لَمَّا جَآءَهُمْ ۖ وَإِنَّهُۥ","عَزِيزٌۭ",49],["41:45:4",481,"ٱلْكِتَـٰبَ","the Book","وَلَقَدْ ءَاتَيْنَا مُوسَى","فَٱخْتُلِفَ فِيهِ ۗ وَلَوْلَا",49],["42:14:24",484,"ٱلْكِتَـٰبَ","the Book","وَإِنَّ ٱلَّذِينَ أُورِثُوا۟","مِنۢ بَعْدِهِمْ لَفِى",49],["42:15:15",484,"كِتَـٰبٍۢ ۖ","(the) Book","أَنزَلَ ٱللَّهُ مِن","وَأُمِرْتُ لِأَعْدِلَ بَيْنَكُمُ ۖ",49],["42:17:4",485,"ٱلْكِتَـٰبَ","the Book","ٱللَّهُ ٱلَّذِىٓ أَنزَلَ","بِٱلْحَقِّ وَٱلْمِيزَانَ ۗ وَمَا",49],["42:52:11",489,"ٱلْكِتَـٰبُ","the Book (is)","كُنتَ تَدْرِى مَا","وَلَا ٱلْإِيمَـٰنُ وَلَـٰكِن",49],["43:2:1",489,"وَٱلْكِتَـٰبِ","By the Book","","ٱلْمُبِينِ",49],["43:4:4",489,"ٱلْكِتَـٰبِ","(of) the Book","وَإِنَّهُۥ فِىٓ أُمِّ","لَدَيْنَا لَعَلِىٌّ حَكِيمٌ",49],["43:19:10",490,"سَتُكْتَبُ","Will be recorded","إِنَـٰثًا ۚ أَشَهِدُوا۟ خَلْقَهُمْ ۚ","شَهَـٰدَتُهُمْ وَيُسْـَٔلُونَ",243],["43:21:3",490,"كِتَـٰبًۭا","a book","أَمْ ءَاتَيْنَـٰهُمْ","مِّن قَبْلِهِۦ فَهُم",49],["43:80:11",495,"يَكْتُبُونَ","are recording","بَلَىٰ وَرُسُلُنَا لَدَيْهِمْ","",243],["44:2:1",496,"وَٱلْكِتَـٰبِ","By the Book","","ٱلْمُبِينِ",49],["45:2:2",499,"ٱلْكِتَـٰبِ","(of) the Book","تَنزِيلُ","مِنَ ٱللَّهِ ٱلْعَزِيزِ",49],["45:16:5",500,"ٱلْكِتَـٰبَ","the Book","ءَاتَيْنَا بَنِىٓ إِسْرَٰٓءِيلَ","وَٱلْحُكْمَ وَٱلنُّبُوَّةَ وَرَزَقْنَـٰهُم",49],["45:28:9",501,"كِتَـٰبِهَا","its record","أُمَّةٍۢ تُدْعَىٰٓ إِلَىٰ","ٱلْيَوْمَ تُجْزَوْنَ مَا",49],["45:29:2",501,"كِتَـٰبُنَا","Our Record","هَـٰذَا","يَنطِقُ عَلَيْكُم بِٱلْحَقِّ ۚ",49],["46:2:2",502,"ٱلْكِتَـٰبِ","(of) the Book","تَنزِيلُ","مِنَ ٱللَّهِ ٱلْعَزِيزِ",49],["46:4:19",502,"بِكِتَـٰبٍۢ","a book","فِى ٱلسَّمَـٰوَٰتِ ۖ ٱئْتُونِى","مِّن قَبْلِ هَـٰذَآ",49],["46:12:3",503,"كِتَـٰبُ","(was the) Scripture","وَمِن قَبْلِهِۦ","مُوسَىٰٓ إِمَامًۭا وَرَحْمَةًۭ ۚ",49],["46:12:8",503,"كِتَـٰبٌۭ","(is) a Book","إِمَامًۭا وَرَحْمَةًۭ ۚ وَهَـٰذَا","مُّصَدِّقٌۭ لِّسَانًا عَرَبِيًّۭا",49],["46:30:5",506,"كِتَـٰبًا","a Book","يَـٰقَوْمَنَآ إِنَّا سَمِعْنَا","أُنزِلَ مِنۢ بَعْدِ",49],["50:4:8",518,"كِتَـٰبٌ","(is) a Book","ٱلْأَرْضُ مِنْهُمْ ۖ وَعِندَنَا","حَفِيظٌۢ",49],["52:2:1",523,"وَكِتَـٰبٍۢ","And by (the) Book","","مَّسْطُورٍۢ",49],["52:41:5",525,"يَكْتُبُونَ","write (it) down","عِندَهُمُ ٱلْغَيْبُ فَهُمْ","",243],["56:78:2",537,"كِتَـٰبٍۢ","a Book","فِى","مَّكْنُونٍۢ",49],["57:16:18",539,"ٱلْكِتَـٰبَ","the Book","يَكُونُوا۟ كَٱلَّذِينَ أُوتُوا۟","مِن قَبْلُ فَطَالَ",49],["57:22:12",540,"كِتَـٰبٍۢ","a Register","أَنفُسِكُمْ إِلَّا فِى","مِّن قَبْلِ أَن",49],["57:25:7",541,"ٱلْكِتَـٰبَ","the Scripture","بِٱلْبَيِّنَـٰتِ وَأَنزَلْنَا مَعَهُمُ","وَٱلْمِيزَانَ لِيَقُومَ ٱلنَّاسُ",49],["57:26:9",541,"وَٱلْكِتَـٰبَ ۖ","and the Scripture","فِى ذُرِّيَّتِهِمَا ٱلنُّبُوَّةَ","فَمِنْهُم مُّهْتَدٍۢ ۖ وَكَثِيرٌۭ",49],["57:27:22",541,"كَتَبْنَـٰهَا","We prescribed it","وَرَهْبَانِيَّةً ٱبْتَدَعُوهَا مَا","عَلَيْهِمْ إِلَّا ٱبْتِغَآءَ",243],["57:29:4",541,"ٱلْكِتَـٰبِ","(of) the Book","لِّئَلَّا يَعْلَمَ أَهْلُ","أَلَّا يَقْدِرُونَ عَلَىٰ",49],["58:21:1",544,"كَتَبَ","Allah has decreed","","ٱللَّهُ لَأَغْلِبَنَّ أَنَا۠",243],["58:22:23",545,"كَتَبَ","He has decreed","أَوْ عَشِيرَتَهُمْ ۚ أُو۟لَـٰٓئِكَ","فِى قُلُوبِهِمُ ٱلْإِيمَـٰنَ",243],["59:2:8",545,"ٱلْكِتَـٰبِ","(of) the Scripture","كَفَرُوا۟ مِنْ أَهْلِ","مِن دِيَـٰرِهِمْ لِأَوَّلِ",49],["59:3:3",545,"كَتَبَ","(had) decreed","وَلَوْلَآ أَن","ٱللَّهُ عَلَيْهِمُ ٱلْجَلَآءَ",243],["59:11:12",547,"ٱلْكِتَـٰبِ","(of) the Scripture","كَفَرُوا۟ مِنْ أَهْلِ","لَئِنْ أُخْرِجْتُمْ لَنَخْرُجَنَّ",49],["62:2:13",553,"ٱلْكِتَـٰبَ","the Book","ءَايَـٰتِهِۦ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ","وَٱلْحِكْمَةَ وَإِن كَانُوا۟",49],["66:12:14",561,"وَكُتُبِهِۦ","and His Books","وَصَدَّقَتْ بِكَلِمَـٰتِ رَبِّهَا","وَكَانَتْ مِنَ ٱلْقَـٰنِتِينَ",49],["68:37:3",565,"كِتَـٰبٌۭ","a book","أَمْ لَكُمْ","فِيهِ تَدْرُسُونَ",49],["68:47:5",566,"يَكْتُبُونَ","write it","عِندَهُمُ ٱلْغَيْبُ فَهُمْ","",243],["69:19:4",567,"كِتَـٰبَهُۥ","his record","فَأَمَّا مَنْ أُوتِىَ","بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ",49],["69:19:9",567,"كِتَـٰبِيَهْ","my record","فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟","",49],["69:25:4",567,"كِتَـٰبَهُۥ","his record","وَأَمَّا مَنْ أُوتِىَ","بِشِمَالِهِۦ فَيَقُولُ يَـٰلَيْتَنِى",49],["69:25:10",567,"كِتَـٰبِيَهْ","my record","يَـٰلَيْتَنِى لَمْ أُوتَ","",49],["74:31:17",576,"ٱلْكِتَـٰبَ","the Scripture","لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟","وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟",49],["74:31:26",576,"ٱلْكِتَـٰبَ","the Scripture","يَرْتَابَ ٱلَّذِينَ أُوتُوا۟","وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ",49],["78:29:4",582,"كِتَـٰبًۭا","(in) a Book","وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ","",49],["82:11:2",587,"كَـٰتِبِينَ","recording","كِرَامًۭا","",1188],["83:7:3",588,"كِتَـٰبَ","(the) record","كَلَّآ إِنَّ","ٱلْفُجَّارِ لَفِى سِجِّينٍۢ",49],["83:9:1",588,"كِتَـٰبٌۭ","A book","","مَّرْقُومٌۭ",49],["83:18:3",588,"كِتَـٰبَ","(the) record","كَلَّآ إِنَّ","ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ",49],["83:20:1",588,"كِتَـٰبٌۭ","A book","","مَّرْقُومٌۭ",49],["84:7:4",589,"كِتَـٰبَهُۥ","his record","فَأَمَّا مَنْ أُوتِىَ","بِيَمِينِهِۦ",49],["84:10:4",589,"كِتَـٰبَهُۥ","his record","وَأَمَّا مَنْ أُوتِىَ","وَرَآءَ ظَهْرِهِۦ",49],["98:1:7",598,"ٱلْكِتَـٰبِ","of the Book","كَفَرُوا۟ مِنْ أَهْلِ","وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ",49],["98:3:2",598,"كُتُبٌۭ","(are) writings","فِيهَا","قَيِّمَةٌۭ",49],["98:4:5",598,"ٱلْكِتَـٰبَ","the Book","تَفَرَّقَ ٱلَّذِينَ أُوتُوا۟","إِلَّا مِنۢ بَعْدِ",49],["98:6:6",599,"ٱلْكِتَـٰبِ","(of) the Book","كَفَرُوا۟ مِنْ أَهْلِ","وَٱلْمُشْرِكِينَ فِى نَارِ",49]]