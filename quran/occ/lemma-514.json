[["2:248:20",40,"هَـٰرُونَ","(of) Harun","ءَالُ مُوسَىٰ وَءَالُ","تَحْمِلُهُ ٱلْمَلَـٰٓئِكَةُ ۚ إِنَّ",514],["4:163:21",104,"وَهَـٰرُونَ","and Harun","وَعِيسَىٰ وَأَيُّوبَ وَيُونُسَ","وَسُلَيْمَـٰنَ ۚ وَءَاتَيْنَا دَاوُۥدَ",514],["6:84:18",138,"وَهَـٰرُونَ ۚ","and Harun","وَأَيُّوبَ وَيُوسُفَ وَمُوسَىٰ","وَكَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",514],["7:122:3",165,"وَهَـٰرُونَ","and Harun","رَبِّ مُوسَىٰ","",514],["7:142:15",167,"هَـٰرُونَ","Harun","وَقَالَ مُوسَىٰ لِأَخِيهِ","ٱخْلُفْنِى فِى قَوْمِى",514],["10:75:6",217,"وَهَـٰرُونَ","and Harun","مِنۢ بَعْدِهِم مُّوسَىٰ","إِلَىٰ فِرْعَوْنَ وَمَلَإِي۟هِۦ",514],["19:28:2",307,"هَـٰرُونَ","(of) Harun","يَـٰٓأُخْتَ","مَا كَانَ أَبُوكِ",514],["19:53:6",309,"هَـٰرُونَ","Harun","مِن رَّحْمَتِنَآ أَخَاهُ","نَبِيًّۭا",514],["20:30:1",313,"هَـٰرُونَ","Harun","","أَخِى",514],["20:70:7",316,"هَـٰرُونَ","(of) Harun","قَالُوٓا۟ ءَامَنَّا بِرَبِّ","وَمُوسَىٰ",514],["20:90:4",318,"هَـٰرُونُ","Harun","وَلَقَدْ قَالَ لَهُمْ","مِن قَبْلُ يَـٰقَوْمِ",514],["20:92:2",318,"يَـٰهَـٰرُونُ","O Harun","قَالَ","مَا مَنَعَكَ إِذْ",514],["21:48:4",326,"وَهَـٰرُونَ","and Harun","وَلَقَدْ ءَاتَيْنَا مُوسَىٰ","ٱلْفُرْقَانَ وَضِيَآءًۭ وَذِكْرًۭا",514],["23:45:5",345,"هَـٰرُونَ","Harun","أَرْسَلْنَا مُوسَىٰ وَأَخَاهُ","بِـَٔايَـٰتِنَا وَسُلْطَـٰنٍۢ مُّبِينٍ",514],["25:35:8",363,"هَـٰرُونَ","Harun","وَجَعَلْنَا مَعَهُۥٓ أَخَاهُ","وَزِيرًۭا",514],["26:13:8",367,"هَـٰرُونَ","Harun","لِسَانِى فَأَرْسِلْ إِلَىٰ","",514],["26:48:3",369,"وَهَـٰرُونَ","and Harun","رَبِّ مُوسَىٰ","",514],["28:34:2",389,"هَـٰرُونُ","Harun","وَأَخِى","هُوَ أَفْصَحُ مِنِّى",514],["37:114:5",450,"وَهَـٰرُونَ","and Harun","مَنَنَّا عَلَىٰ مُوسَىٰ","",514],["37:120:4",450,"وَهَـٰرُونَ","and Harun","سَلَـٰمٌ عَلَىٰ مُوسَىٰ","",514]]