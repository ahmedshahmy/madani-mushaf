[["3:118:19",65,"أَفْوَٰهِهِمْ","their mouths","بَدَتِ ٱلْبَغْضَآءُ مِنْ","وَمَا تُخْفِى صُدُورُهُمْ",713],["3:167:25",72,"بِأَفْوَٰهِهِم","with their mouths","مِنْهُمْ لِلْإِيمَـٰنِ ۚ يَقُولُونَ","مَّا لَيْسَ فِى",713],["5:41:13",114,"بِأَفْوَٰهِهِمْ","with their mouths","ٱلَّذِينَ قَالُوٓا۟ ءَامَنَّا","وَلَمْ تُؤْمِن قُلُوبُهُمْ ۛ",713],["9:8:12",188,"بِأَفْوَٰهِهِمْ","with their mouths","وَلَا ذِمَّةًۭ ۚ يُرْضُونَكُم","وَتَأْبَىٰ قُلُوبُهُمْ وَأَكْثَرُهُمْ",713],["9:30:13",191,"بِأَفْوَٰهِهِمْ ۖ","with their mouths","ٱللَّهِ ۖ ذَٰلِكَ قَوْلُهُم","يُضَـٰهِـُٔونَ قَوْلَ ٱلَّذِينَ",713],["9:32:6",192,"بِأَفْوَٰهِهِمْ","with their mouths","يُطْفِـُٔوا۟ نُورَ ٱللَّهِ","وَيَأْبَى ٱللَّهُ إِلَّآ",713],["13:14:18",251,"فَاهُ","his mouth","إِلَى ٱلْمَآءِ لِيَبْلُغَ","وَمَا هُوَ بِبَـٰلِغِهِۦ ۚ",3393],["14:9:24",256,"أَفْوَٰهِهِمْ","their mouths","فَرَدُّوٓا۟ أَيْدِيَهُمْ فِىٓ","وَقَالُوٓا۟ إِنَّا كَفَرْنَا",713],["18:5:12",294,"أَفْوَٰهِهِمْ ۚ","their mouths","كَلِمَةًۭ تَخْرُجُ مِنْ","إِن يَقُولُونَ إِلَّا",713],["24:15:5",351,"بِأَفْوَاهِكُم","with your mouths","تَلَقَّوْنَهُۥ بِأَلْسِنَتِكُمْ وَتَقُولُونَ","مَّا لَيْسَ لَكُم",713],["33:4:22",418,"بِأَفْوَٰهِكُمْ ۖ","by your mouths","أَبْنَآءَكُمْ ۚ ذَٰلِكُمْ قَوْلُكُم","وَٱللَّهُ يَقُولُ ٱلْحَقَّ",713],["36:65:4",444,"أَفْوَٰهِهِمْ","their mouths","ٱلْيَوْمَ نَخْتِمُ عَلَىٰٓ","وَتُكَلِّمُنَآ أَيْدِيهِمْ وَتَشْهَدُ",713],["61:8:5",552,"بِأَفْوَٰهِهِمْ","with their mouths","لِيُطْفِـُٔوا۟ نُورَ ٱللَّهِ","وَٱللَّهُ مُتِمُّ نُورِهِۦ",713]]