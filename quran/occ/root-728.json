[["4:27:11",83,"تَمِيلُوا۟","you deviate","يَتَّبِعُونَ ٱلشَّهَوَٰتِ أَن","مَيْلًا عَظِيمًۭا",2061],["4:27:12",83,"مَيْلًا","(into) a deviation","ٱلشَّهَوَٰتِ أَن تَمِيلُوا۟","عَظِيمًۭا",2473],["4:102:36",95,"فَيَمِيلُونَ","so (that) they (can) assault","عَنْ أَسْلِحَتِكُمْ وَأَمْتِعَتِكُمْ","عَلَيْكُم مَّيْلَةًۭ وَٰحِدَةًۭ ۚ",2061],["4:102:38",95,"مَّيْلَةًۭ","(in) an attack","وَأَمْتِعَتِكُمْ فَيَمِيلُونَ عَلَيْكُم","وَٰحِدَةًۭ ۚ وَلَا جُنَاحَ",3945],["4:129:10",99,"تَمِيلُوا۟","incline","وَلَوْ حَرَصْتُمْ ۖ فَلَا","كُلَّ ٱلْمَيْلِ فَتَذَرُوهَا",2061],["4:129:12",99,"ٱلْمَيْلِ","the inclination","فَلَا تَمِيلُوا۟ كُلَّ","فَتَذَرُوهَا كَٱلْمُعَلَّقَةِ ۚ وَإِن",2473]]