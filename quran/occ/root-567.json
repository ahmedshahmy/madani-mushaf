[["7:205:12",176,"وَٱلْـَٔاصَالِ","and (in) the evenings","مِنَ ٱلْقَوْلِ بِٱلْغُدُوِّ","وَلَا تَكُن مِّنَ",1033],["13:15:11",251,"وَٱلْـَٔاصَالِ ۩","and in the afternoons","وَكَرْهًۭا وَظِلَـٰلُهُم بِٱلْغُدُوِّ","",1033],["14:24:11",258,"أَصْلُهَا","its root","طَيِّبَةًۭ كَشَجَرَةٍۢ طَيِّبَةٍ","ثَابِتٌۭ وَفَرْعُهَا فِى",1728],["24:36:14",354,"وَٱلْـَٔاصَالِ","and (in) the evenings","لَهُۥ فِيهَا بِٱلْغُدُوِّ","",1033],["25:5:9",360,"وَأَصِيلًۭا","and evening","تُمْلَىٰ عَلَيْهِ بُكْرَةًۭ","",1033],["33:42:3",423,"وَأَصِيلًا","and evening","وَسَبِّحُوهُ بُكْرَةًۭ","",1033],["37:64:5",448,"أَصْلِ","(the) bottom","شَجَرَةٌۭ تَخْرُجُ فِىٓ","ٱلْجَحِيمِ",1728],["48:9:8",511,"وَأَصِيلًا","and evening","وَتُوَقِّرُوهُ وَتُسَبِّحُوهُ بُكْرَةًۭ","",1033],["59:5:9",546,"أُصُولِهَا","their roots","تَرَكْتُمُوهَا قَآئِمَةً عَلَىٰٓ","فَبِإِذْنِ ٱللَّهِ وَلِيُخْزِىَ",1728],["76:25:5",579,"وَأَصِيلًۭا","and evening","ٱسْمَ رَبِّكَ بُكْرَةًۭ","",1033]]