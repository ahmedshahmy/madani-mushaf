[["2:25:27",5,"مُتَشَـٰبِهًۭا ۖ","(things) in resemblance","قَبْلُ ۖ وَأُتُوا۟ بِهِۦ","وَلَهُمْ فِيهَآ أَزْوَٰجٌۭ",1206],["2:70:11",11,"تَشَـٰبَهَ","look alike","هِىَ إِنَّ ٱلْبَقَرَ","عَلَيْنَا وَإِنَّآ إِن",1645],["2:118:18",18,"تَشَـٰبَهَتْ","Became alike","قَبْلِهِم مِّثْلَ قَوْلِهِمْ ۘ","قُلُوبُهُمْ ۗ قَدْ بَيَّنَّا",1645],["3:7:13",50,"مُتَشَـٰبِهَـٰتٌۭ ۖ","(are) allegorical","أُمُّ ٱلْكِتَـٰبِ وَأُخَرُ","فَأَمَّا ٱلَّذِينَ فِى",1206],["3:7:21",50,"تَشَـٰبَهَ","(is) allegorical","زَيْغٌۭ فَيَتَّبِعُونَ مَا","مِنْهُ ٱبْتِغَآءَ ٱلْفِتْنَةِ",1645],["4:157:15",103,"شُبِّهَ","it was made to appear (so)","وَمَا صَلَبُوهُ وَلَـٰكِن","لَهُمْ ۚ وَإِنَّ ٱلَّذِينَ",2889],["6:99:30",140,"مُشْتَبِهًۭا","resembling","أَعْنَابٍۢ وَٱلزَّيْتُونَ وَٱلرُّمَّانَ","وَغَيْرَ مُتَشَـٰبِهٍ ۗ ٱنظُرُوٓا۟",3748],["6:99:32",140,"مُتَشَـٰبِهٍ ۗ","resembling","وَٱلرُّمَّانَ مُشْتَبِهًۭا وَغَيْرَ","ٱنظُرُوٓا۟ إِلَىٰ ثَمَرِهِۦٓ",1206],["6:141:14",146,"مُتَشَـٰبِهًۭا","similar","أُكُلُهُۥ وَٱلزَّيْتُونَ وَٱلرُّمَّانَ","وَغَيْرَ مُتَشَـٰبِهٍۢ ۚ كُلُوا۟",1206],["6:141:16",146,"مُتَشَـٰبِهٍۢ ۚ","similar","وَٱلرُّمَّانَ مُتَشَـٰبِهًۭا وَغَيْرَ","كُلُوا۟ مِن ثَمَرِهِۦٓ",1206],["13:16:35",251,"فَتَشَـٰبَهَ","so that seemed alike","شُرَكَآءَ خَلَقُوا۟ كَخَلْقِهِۦ","ٱلْخَلْقُ عَلَيْهِمْ ۚ قُلِ",1645],["39:23:6",461,"مُّتَشَـٰبِهًۭا","(its parts) resembling each other","أَحْسَنَ ٱلْحَدِيثِ كِتَـٰبًۭا","مَّثَانِىَ تَقْشَعِرُّ مِنْهُ",1206]]