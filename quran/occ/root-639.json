[["7:22:1",152,"فَدَلَّىٰهُمَا","So he made both of them fall","","بِغُرُورٍۢ ۚ فَلَمَّا ذَاقَا",1068],["20:40:6",314,"أَدُلُّكُمْ","I show you","أُخْتُكَ فَتَقُولُ هَلْ","عَلَىٰ مَن يَكْفُلُهُۥ ۖ",1068],["20:120:7",320,"أَدُلُّكَ","I direct you","قَالَ يَـٰٓـَٔادَمُ هَلْ","عَلَىٰ شَجَرَةِ ٱلْخُلْدِ",1068],["25:45:16",364,"دَلِيلًۭا","an indication","جَعَلْنَا ٱلشَّمْسَ عَلَيْهِ","",3373],["28:12:8",386,"أَدُلُّكُمْ","direct you","قَبْلُ فَقَالَتْ هَلْ","عَلَىٰٓ أَهْلِ بَيْتٍۢ",1068],["34:7:5",428,"نَدُلُّكُمْ","we direct you","ٱلَّذِينَ كَفَرُوا۟ هَلْ","عَلَىٰ رَجُلٍۢ يُنَبِّئُكُمْ",1068],["34:14:6",429,"دَلَّهُمْ","indicated to them","عَلَيْهِ ٱلْمَوْتَ مَا","عَلَىٰ مَوْتِهِۦٓ إِلَّا",1068],["61:10:5",552,"أَدُلُّكُمْ","I guide you","ٱلَّذِينَ ءَامَنُوا۟ هَلْ","عَلَىٰ تِجَـٰرَةٍۢ تُنجِيكُم",1068]]