[["4:8:3",78,"ٱلْقِسْمَةَ","(at) the (time of) division","وَإِذَا حَضَرَ","أُو۟لُوا۟ ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ",1965],["5:3:27",107,"تَسْتَقْسِمُوا۟","you seek division","عَلَى ٱلنُّصُبِ وَأَن","بِٱلْأَزْلَـٰمِ ۚ ذَٰلِكُمْ فِسْقٌ ۗ",4421],["5:53:6",117,"أَقْسَمُوا۟","swore","ءَامَنُوٓا۟ أَهَـٰٓؤُلَآءِ ٱلَّذِينَ","بِٱللَّهِ جَهْدَ أَيْمَـٰنِهِمْ ۙ",504],["5:106:32",125,"فَيُقْسِمَانِ","and let them both swear","مِنۢ بَعْدِ ٱلصَّلَوٰةِ","بِٱللَّهِ إِنِ ٱرْتَبْتُمْ",504],["5:107:15",125,"فَيُقْسِمَانِ","and let them both swear","ٱسْتَحَقَّ عَلَيْهِمُ ٱلْأَوْلَيَـٰنِ","بِٱللَّهِ لَشَهَـٰدَتُنَآ أَحَقُّ",504],["6:109:1",141,"وَأَقْسَمُوا۟","And they swear","","بِٱللَّهِ جَهْدَ أَيْمَـٰنِهِمْ",504],["7:21:1",152,"وَقَاسَمَهُمَآ","And he swore (to) both of them","","إِنِّى لَكُمَا لَمِنَ",4110],["7:49:3",156,"أَقْسَمْتُمْ","you had sworn","أَهَـٰٓؤُلَآءِ ٱلَّذِينَ","لَا يَنَالُهُمُ ٱللَّهُ",504],["14:44:20",261,"أَقْسَمْتُم","sworn","ٱلرُّسُلَ ۗ أَوَلَمْ تَكُونُوٓا۟","مِّن قَبْلُ مَا",504],["15:44:8",264,"مَّقْسُومٌ","assigned","بَابٍۢ مِّنْهُمْ جُزْءٌۭ","",3924],["15:90:4",266,"ٱلْمُقْتَسِمِينَ","those who divided","كَمَآ أَنزَلْنَا عَلَى","",3838],["16:38:1",271,"وَأَقْسَمُوا۟","And they swear","","بِٱللَّهِ جَهْدَ أَيْمَـٰنِهِمْ ۙ",504],["24:53:1",356,"۞ وَأَقْسَمُوا۟","And they swear","","بِٱللَّهِ جَهْدَ أَيْمَـٰنِهِمْ",504],["24:53:10",356,"تُقْسِمُوا۟ ۖ","swear","لَيَخْرُجُنَّ ۖ قُل لَّا","طَاعَةٌۭ مَّعْرُوفَةٌ ۚ إِنَّ",504],["27:49:2",381,"تَقَاسَمُوا۟","Swear to each other","قَالُوا۟","بِٱللَّهِ لَنُبَيِّتَنَّهُۥ وَأَهْلَهُۥ",4403],["30:55:4",410,"يُقْسِمُ","will swear","وَيَوْمَ تَقُومُ ٱلسَّاعَةُ","ٱلْمُجْرِمُونَ مَا لَبِثُوا۟",504],["35:42:1",439,"وَأَقْسَمُوا۟","And they swore","","بِٱللَّهِ جَهْدَ أَيْمَـٰنِهِمْ",504],["43:32:2",491,"يَقْسِمُونَ","distribute","أَهُمْ","رَحْمَتَ رَبِّكَ ۚ نَحْنُ",2581],["43:32:6",491,"قَسَمْنَا","[We] distribute","رَحْمَتَ رَبِّكَ ۚ نَحْنُ","بَيْنَهُم مَّعِيشَتَهُمْ فِى",2581],["51:4:1",520,"فَٱلْمُقَسِّمَـٰتِ","And those distributing","","أَمْرًا",3834],["53:22:3",526,"قِسْمَةٌۭ","(is) a division","تِلْكَ إِذًۭا","ضِيزَىٰٓ",1965],["54:28:4",530,"قِسْمَةٌۢ","(is) to be shared","وَنَبِّئْهُمْ أَنَّ ٱلْمَآءَ","بَيْنَهُمْ ۖ كُلُّ شِرْبٍۢ",1965],["56:75:2",536,"أُقْسِمُ","I swear","۞ فَلَآ","بِمَوَٰقِعِ ٱلنُّجُومِ",504],["56:76:2",536,"لَقَسَمٌۭ","(is) surely an oath","وَإِنَّهُۥ","لَّوْ تَعْلَمُونَ عَظِيمٌ",2580],["68:17:8",565,"أَقْسَمُوا۟","they swore","أَصْحَـٰبَ ٱلْجَنَّةِ إِذْ","لَيَصْرِمُنَّهَا مُصْبِحِينَ",504],["69:38:2",568,"أُقْسِمُ","I swear","فَلَآ","بِمَا تُبْصِرُونَ",504],["70:40:2",569,"أُقْسِمُ","I swear","فَلَآ","بِرَبِّ ٱلْمَشَـٰرِقِ وَٱلْمَغَـٰرِبِ",504],["75:1:2",577,"أُقْسِمُ","I swear","لَآ","بِيَوْمِ ٱلْقِيَـٰمَةِ",504],["75:2:2",577,"أُقْسِمُ","I swear","وَلَآ","بِٱلنَّفْسِ ٱللَّوَّامَةِ",504],["81:15:2",586,"أُقْسِمُ","I swear","فَلَآ","بِٱلْخُنَّسِ",504],["84:16:2",589,"أُقْسِمُ","I swear","فَلَآ","بِٱلشَّفَقِ",504],["89:5:4",593,"قَسَمٌۭ","(not) an oath","هَلْ فِى ذَٰلِكَ","لِّذِى حِجْرٍ",2580],["90:1:2",594,"أُقْسِمُ","I swear","لَآ","بِهَـٰذَا ٱلْبَلَدِ",504]]