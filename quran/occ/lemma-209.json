[["2:102:11",16,"وَلَـٰكِنَّ","[and] but","وَمَا كَفَرَ سُلَيْمَـٰنُ","ٱلشَّيَـٰطِينَ كَفَرُوا۟ يُعَلِّمُونَ",209],["2:177:9",27,"وَلَـٰكِنَّ","[and] but","قِبَلَ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ","ٱلْبِرَّ مَنْ ءَامَنَ",209],["2:189:16",29,"وَلَـٰكِنَّ","[and] but","ٱلْبُيُوتَ مِن ظُهُورِهَا","ٱلْبِرَّ مَنِ ٱتَّقَىٰ ۗ",209],["2:243:24",39,"وَلَـٰكِنَّ","[and] but","فَضْلٍ عَلَى ٱلنَّاسِ","أَكْثَرَ ٱلنَّاسِ لَا",209],["2:251:22",41,"وَلَـٰكِنَّ","[and] but","بِبَعْضٍۢ لَّفَسَدَتِ ٱلْأَرْضُ","ٱللَّهَ ذُو فَضْلٍ",209],["2:253:48",42,"وَلَـٰكِنَّ","[and] but","ٱللَّهُ مَا ٱقْتَتَلُوا۟","ٱللَّهَ يَفْعَلُ مَا",209],["2:272:4",46,"وَلَـٰكِنَّ","[and] but","۞ لَّيْسَ عَلَيْكَ هُدَىٰهُمْ","ٱللَّهَ يَهْدِى مَن",209],["3:179:21",73,"وَلَـٰكِنَّ","[and] but","لِيُطْلِعَكُمْ عَلَى ٱلْغَيْبِ","ٱللَّهَ يَجْتَبِى مِن",209],["5:81:12",121,"وَلَـٰكِنَّ","[and] but","مَا ٱتَّخَذُوهُمْ أَوْلِيَآءَ","كَثِيرًۭا مِّنْهُمْ فَـٰسِقُونَ",209],["5:103:12",124,"وَلَـٰكِنَّ","[And] but","وَصِيلَةٍۢ وَلَا حَامٍۢ ۙ","ٱلَّذِينَ كَفَرُوا۟ يَفْتَرُونَ",209],["6:33:10",131,"وَلَـٰكِنَّ","but","فَإِنَّهُمْ لَا يُكَذِّبُونَكَ","ٱلظَّـٰلِمِينَ بِـَٔايَـٰتِ ٱللَّهِ",209],["6:37:16",132,"وَلَـٰكِنَّ","but","أَن يُنَزِّلَ ءَايَةًۭ","أَكْثَرَهُمْ لَا يَعْلَمُونَ",209],["6:111:20",142,"وَلَـٰكِنَّ","But","أَن يَشَآءَ ٱللَّهُ","أَكْثَرَهُمْ يَجْهَلُونَ",209],["7:131:19",166,"وَلَـٰكِنَّ","but","طَـٰٓئِرُهُمْ عِندَ ٱللَّهِ","أَكْثَرَهُمْ لَا يَعْلَمُونَ",209],["7:176:5",173,"وَلَـٰكِنَّهُۥٓ","[and] but he","شِئْنَا لَرَفَعْنَـٰهُ بِهَا","أَخْلَدَ إِلَى ٱلْأَرْضِ",209],["7:187:33",174,"وَلَـٰكِنَّ","but","عِلْمُهَا عِندَ ٱللَّهِ","أَكْثَرَ ٱلنَّاسِ لَا",209],["8:17:3",179,"وَلَـٰكِنَّ","but","فَلَمْ تَقْتُلُوهُمْ","ٱللَّهَ قَتَلَهُمْ ۚ وَمَا",209],["8:17:10",179,"وَلَـٰكِنَّ","but","رَمَيْتَ إِذْ رَمَيْتَ","ٱللَّهَ رَمَىٰ ۚ وَلِيُبْلِىَ",209],["8:34:18",181,"وَلَـٰكِنَّ","but","أَوْلِيَآؤُهُۥٓ إِلَّا ٱلْمُتَّقُونَ","أَكْثَرَهُمْ لَا يَعْلَمُونَ",209],["8:43:14",182,"وَلَـٰكِنَّ","but","وَلَتَنَـٰزَعْتُمْ فِى ٱلْأَمْرِ","ٱللَّهَ سَلَّمَ ۗ إِنَّهُۥ",209],["8:63:14",185,"وَلَـٰكِنَّ","but","أَلَّفْتَ بَيْنَ قُلُوبِهِمْ","ٱللَّهَ أَلَّفَ بَيْنَهُمْ ۚ",209],["9:56:8",196,"وَلَـٰكِنَّهُمْ","but they","وَمَا هُم مِّنكُمْ","قَوْمٌۭ يَفْرَقُونَ",209],["10:44:7",214,"وَلَـٰكِنَّ","but","يَظْلِمُ ٱلنَّاسَ شَيْـًۭٔا","ٱلنَّاسَ أَنفُسَهُمْ يَظْلِمُونَ",209],["10:55:13",215,"وَلَـٰكِنَّ","But","وَعْدَ ٱللَّهِ حَقٌّۭ","أَكْثَرَهُمْ لَا يَعْلَمُونَ",209],["10:60:16",215,"وَلَـٰكِنَّ","but","فَضْلٍ عَلَى ٱلنَّاسِ","أَكْثَرَهُمْ لَا يَشْكُرُونَ",209],["11:17:35",223,"وَلَـٰكِنَّ","but","ٱلْحَقُّ مِن رَّبِّكَ","أَكْثَرَ ٱلنَّاسِ لَا",209],["12:21:28",237,"وَلَـٰكِنَّ","but","غَالِبٌ عَلَىٰٓ أَمْرِهِۦ","أَكْثَرَ ٱلنَّاسِ لَا",209],["12:38:22",240,"وَلَـٰكِنَّ","but","عَلَيْنَا وَعَلَى ٱلنَّاسِ","أَكْثَرَ ٱلنَّاسِ لَا",209],["12:40:28",240,"وَلَـٰكِنَّ","but","ذَٰلِكَ ٱلدِّينُ ٱلْقَيِّمُ","أَكْثَرَ ٱلنَّاسِ لَا",209],["12:68:26",243,"وَلَـٰكِنَّ","but","عِلْمٍۢ لِّمَا عَلَّمْنَـٰهُ","أَكْثَرَ ٱلنَّاسِ لَا",209],["13:1:11",249,"وَلَـٰكِنَّ","but","مِن رَّبِّكَ ٱلْحَقُّ","أَكْثَرَ ٱلنَّاسِ لَا",209],["14:11:9",257,"وَلَـٰكِنَّ","but","إِلَّا بَشَرٌۭ مِّثْلُكُمْ","ٱللَّهَ يَمُنُّ عَلَىٰ",209],["16:38:14",271,"وَلَـٰكِنَّ","but","وَعْدًا عَلَيْهِ حَقًّۭا","أَكْثَرَ ٱلنَّاسِ لَا",209],["22:2:19",332,"وَلَـٰكِنَّ","but","وَمَا هُم بِسُكَـٰرَىٰ","عَذَابَ ٱللَّهِ شَدِيدٌۭ",209],["24:21:27",352,"وَلَـٰكِنَّ","but","مِّنْ أَحَدٍ أَبَدًۭا","ٱللَّهَ يُزَكِّى مَن",209],["27:73:7",383,"وَلَـٰكِنَّ","but","فَضْلٍ عَلَى ٱلنَّاسِ","أَكْثَرَهُمْ لَا يَشْكُرُونَ",209],["28:13:14",386,"وَلَـٰكِنَّ","But","وَعْدَ ٱللَّهِ حَقٌّۭ","أَكْثَرَهُمْ لَا يَعْلَمُونَ",209],["28:56:6",392,"وَلَـٰكِنَّ","but","تَهْدِى مَنْ أَحْبَبْتَ","ٱللَّهَ يَهْدِى مَن",209],["28:57:22",392,"وَلَـٰكِنَّ","But","رِّزْقًۭا مِّن لَّدُنَّا","أَكْثَرَهُمْ لَا يَعْلَمُونَ",209],["30:6:7",405,"وَلَـٰكِنَّ","but","يُخْلِفُ ٱللَّهُ وَعْدَهُۥ","أَكْثَرَ ٱلنَّاسِ لَا",209],["30:30:18",407,"وَلَـٰكِنَّ","but","ذَٰلِكَ ٱلدِّينُ ٱلْقَيِّمُ","أَكْثَرَ ٱلنَّاسِ لَا",209],["30:56:17",410,"وَلَـٰكِنَّكُمْ","but you","فَهَـٰذَا يَوْمُ ٱلْبَعْثِ","كُنتُمْ لَا تَعْلَمُونَ",209],["34:28:8",431,"وَلَـٰكِنَّ","But","لِّلنَّاسِ بَشِيرًۭا وَنَذِيرًۭا","أَكْثَرَ ٱلنَّاسِ لَا",209],["34:36:9",432,"وَلَـٰكِنَّ","but","لِمَن يَشَآءُ وَيَقْدِرُ","أَكْثَرَ ٱلنَّاسِ لَا",209],["39:49:19",464,"وَلَـٰكِنَّ","but","بَلْ هِىَ فِتْنَةٌۭ","أَكْثَرَهُمْ لَا يَعْلَمُونَ",209],["40:57:8",473,"وَلَـٰكِنَّ","but","مِنْ خَلْقِ ٱلنَّاسِ","أَكْثَرَ ٱلنَّاسِ لَا",209],["40:59:7",474,"وَلَـٰكِنَّ","but","لَّا رَيْبَ فِيهَا","أَكْثَرَ ٱلنَّاسِ لَا",209],["40:61:16",474,"وَلَـٰكِنَّ","but","فَضْلٍ عَلَى ٱلنَّاسِ","أَكْثَرَ ٱلنَّاسِ لَا",209],["43:78:4",495,"وَلَـٰكِنَّ","but","لَقَدْ جِئْنَـٰكُم بِٱلْحَقِّ","أَكْثَرَكُمْ لِلْحَقِّ كَـٰرِهُونَ",209],["44:39:5",497,"وَلَـٰكِنَّ","but","خَلَقْنَـٰهُمَآ إِلَّا بِٱلْحَقِّ","أَكْثَرَهُمْ لَا يَعْلَمُونَ",209],["45:26:14",501,"وَلَـٰكِنَّ","But","لَا رَيْبَ فِيهِ","أَكْثَرَ ٱلنَّاسِ لَا",209],["49:7:13",516,"وَلَـٰكِنَّ","but","مِّنَ ٱلْأَمْرِ لَعَنِتُّمْ","ٱللَّهَ حَبَّبَ إِلَيْكُمُ",209],["52:47:7",525,"وَلَـٰكِنَّ","but","عَذَابًۭا دُونَ ذَٰلِكَ","أَكْثَرَهُمْ لَا يَعْلَمُونَ",209],["57:14:7",539,"وَلَـٰكِنَّكُمْ","but you","مَّعَكُمْ ۖ قَالُوا۟ بَلَىٰ","فَتَنتُمْ أَنفُسَكُمْ وَتَرَبَّصْتُمْ",209],["59:6:14",546,"وَلَـٰكِنَّ","but","خَيْلٍۢ وَلَا رِكَابٍۢ","ٱللَّهَ يُسَلِّطُ رُسُلَهُۥ",209],["63:7:17",555,"وَلَـٰكِنَّ","but","خَزَآئِنُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","ٱلْمُنَـٰفِقِينَ لَا يَفْقَهُونَ",209],["63:8:14",555,"وَلَـٰكِنَّ","but","ٱلْعِزَّةُ وَلِرَسُولِهِۦ وَلِلْمُؤْمِنِينَ","ٱلْمُنَـٰفِقِينَ لَا يَعْلَمُونَ",209]]