[["2:235:29",38,"عُقْدَةَ","the knot","مَّعْرُوفًۭا ۚ وَلَا تَعْزِمُوا۟","ٱلنِّكَاحِ حَتَّىٰ يَبْلُغَ",1508],["2:237:21",38,"عُقْدَةُ","(is the) knot","يَعْفُوَا۟ ٱلَّذِى بِيَدِهِۦ","ٱلنِّكَاحِ ۚ وَأَن تَعْفُوٓا۟",1508],["4:33:9",83,"عَقَدَتْ","pledged","ٱلْوَٰلِدَانِ وَٱلْأَقْرَبُونَ ۚ وَٱلَّذِينَ","أَيْمَـٰنُكُمْ فَـَٔاتُوهُمْ نَصِيبَهُمْ ۚ",3120],["5:1:5",106,"بِٱلْعُقُودِ ۚ","the contracts","ٱلَّذِينَ ءَامَنُوٓا۟ أَوْفُوا۟","أُحِلَّتْ لَكُم بَهِيمَةُ",3151],["5:89:10",122,"عَقَّدتُّمُ","you contracted","وَلَـٰكِن يُؤَاخِذُكُم بِمَا","ٱلْأَيْمَـٰنَ ۖ فَكَفَّـٰرَتُهُۥٓ إِطْعَامُ",3121],["20:27:2",313,"عُقْدَةًۭ","(the) knot","وَٱحْلُلْ","مِّن لِّسَانِى",1508],["113:4:5",604,"ٱلْعُقَدِ","the knots","شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى","",1508]]