[["2:55:10",8,"جَهْرَةًۭ","manifestly","حَتَّىٰ نَرَى ٱللَّهَ","فَأَخَذَتْكُمُ ٱلصَّـٰعِقَةُ وَأَنتُمْ",1856],["4:148:4",102,"ٱلْجَهْرَ","the public mention","۞ لَّا يُحِبُّ ٱللَّهُ","بِٱلسُّوٓءِ مِنَ ٱلْقَوْلِ",1076],["4:153:19",102,"جَهْرَةًۭ","manifestly","فَقَالُوٓا۟ أَرِنَا ٱللَّهَ","فَأَخَذَتْهُمُ ٱلصَّـٰعِقَةُ بِظُلْمِهِمْ ۚ",1856],["6:3:9",128,"وَجَهْرَكُمْ","and what you make public","ٱلْأَرْضِ ۖ يَعْلَمُ سِرَّكُمْ","وَيَعْلَمُ مَا تَكْسِبُونَ",1076],["6:47:9",133,"جَهْرَةً","openly","ٱللَّهِ بَغْتَةً أَوْ","هَلْ يُهْلَكُ إِلَّا",1856],["7:205:8",176,"ٱلْجَهْرِ","the loudness","تَضَرُّعًۭا وَخِيفَةًۭ وَدُونَ","مِنَ ٱلْقَوْلِ بِٱلْغُدُوِّ",1076],["13:10:7",250,"جَهَرَ","publicizes","أَسَرَّ ٱلْقَوْلَ وَمَن","بِهِۦ وَمَنْ هُوَ",1342],["16:75:19",275,"وَجَهْرًا ۖ","and publicly","يُنفِقُ مِنْهُ سِرًّۭا","هَلْ يَسْتَوُۥنَ ۚ ٱلْحَمْدُ",1076],["17:110:14",293,"تَجْهَرْ","be loud","ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ ۚ وَلَا","بِصَلَاتِكَ وَلَا تُخَافِتْ",1342],["20:7:2",312,"تَجْهَرْ","you speak aloud","وَإِن","بِٱلْقَوْلِ فَإِنَّهُۥ يَعْلَمُ",1342],["21:110:3",331,"ٱلْجَهْرَ","the declared","إِنَّهُۥ يَعْلَمُ","مِنَ ٱلْقَوْلِ وَيَعْلَمُ",1076],["49:2:11",515,"تَجْهَرُوا۟","be loud","صَوْتِ ٱلنَّبِىِّ وَلَا","لَهُۥ بِٱلْقَوْلِ كَجَهْرِ",1342],["49:2:14",515,"كَجَهْرِ","like (the) loudness","تَجْهَرُوا۟ لَهُۥ بِٱلْقَوْلِ","بَعْضِكُمْ لِبَعْضٍ أَن",1076],["67:13:4",563,"ٱجْهَرُوا۟","proclaim","وَأَسِرُّوا۟ قَوْلَكُمْ أَوِ","بِهِۦٓ ۖ إِنَّهُۥ عَلِيمٌۢ",1342],["71:8:4",570,"جِهَارًۭا","publicly","ثُمَّ إِنِّى دَعَوْتُهُمْ","",3537],["87:7:7",591,"ٱلْجَهْرَ","the manifest","ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ","وَمَا يَخْفَىٰ",1076]]