[["2:44:3",7,"بِٱلْبِرِّ","[the] righteousness","۞ أَتَأْمُرُونَ ٱلنَّاسَ","وَتَنسَوْنَ أَنفُسَكُمْ وَأَنتُمْ",970],["2:177:2",27,"ٱلْبِرَّ","[the] righteousness","۞ لَّيْسَ","أَن تُوَلُّوا۟ وُجُوهَكُمْ",970],["2:177:10",27,"ٱلْبِرَّ","the righteous[ness]","ٱلْمَشْرِقِ وَٱلْمَغْرِبِ وَلَـٰكِنَّ","مَنْ ءَامَنَ بِٱللَّهِ",970],["2:189:10",29,"ٱلْبِرُّ","[the] righteousness","لِلنَّاسِ وَٱلْحَجِّ ۗ وَلَيْسَ","بِأَن تَأْتُوا۟ ٱلْبُيُوتَ",970],["2:189:17",29,"ٱلْبِرَّ","[the] righteous","مِن ظُهُورِهَا وَلَـٰكِنَّ","مَنِ ٱتَّقَىٰ ۗ وَأْتُوا۟",970],["2:224:7",35,"تَبَرُّوا۟","you do good","عُرْضَةًۭ لِّأَيْمَـٰنِكُمْ أَن","وَتَتَّقُوا۟ وَتُصْلِحُوا۟ بَيْنَ",2661],["3:92:3",62,"ٱلْبِرَّ","[the] righteousness","لَن تَنَالُوا۟","حَتَّىٰ تُنفِقُوا۟ مِمَّا",970],["3:193:20",75,"ٱلْأَبْرَارِ","the righteous","سَيِّـَٔاتِنَا وَتَوَفَّنَا مَعَ","",465],["3:198:21",76,"لِّلْأَبْرَارِ","for the righteous","عِندَ ٱللَّهِ خَيْرٌۭ","",465],["5:2:40",106,"ٱلْبِرِّ","[the] righteousness","تَعْتَدُوا۟ ۘ وَتَعَاوَنُوا۟ عَلَى","وَٱلتَّقْوَىٰ ۖ وَلَا تَعَاوَنُوا۟",970],["5:96:12",124,"ٱلْبَرِّ","(of) the land","وَحُرِّمَ عَلَيْكُمْ صَيْدُ","مَا دُمْتُمْ حُرُمًۭا ۗ",465],["6:59:11",134,"ٱلْبَرِّ","the land","وَيَعْلَمُ مَا فِى","وَٱلْبَحْرِ ۚ وَمَا تَسْقُطُ",465],["6:63:6",135,"ٱلْبَرِّ","(of) the land","يُنَجِّيكُم مِّن ظُلُمَـٰتِ","وَٱلْبَحْرِ تَدْعُونَهُۥ تَضَرُّعًۭا",465],["6:97:10",140,"ٱلْبَرِّ","(of) the land","بِهَا فِى ظُلُمَـٰتِ","وَٱلْبَحْرِ ۗ قَدْ فَصَّلْنَا",465],["10:22:5",211,"ٱلْبَرِّ","the land","ٱلَّذِى يُسَيِّرُكُمْ فِى","وَٱلْبَحْرِ ۖ حَتَّىٰٓ إِذَا",465],["17:67:14",289,"ٱلْبَرِّ","the land","فَلَمَّا نَجَّىٰكُمْ إِلَى","أَعْرَضْتُمْ ۚ وَكَانَ ٱلْإِنسَـٰنُ",465],["17:68:6",289,"ٱلْبَرِّ","(of) the land","يَخْسِفَ بِكُمْ جَانِبَ","أَوْ يُرْسِلَ عَلَيْكُمْ",465],["17:70:7",289,"ٱلْبَرِّ","the land","ءَادَمَ وَحَمَلْنَـٰهُمْ فِى","وَٱلْبَحْرِ وَرَزَقْنَـٰهُم مِّنَ",465],["19:14:1",306,"وَبَرًّۢا","And dutiful","","بِوَٰلِدَيْهِ وَلَمْ يَكُن",465],["19:32:1",307,"وَبَرًّۢا","And dutiful","","بِوَٰلِدَتِى وَلَمْ يَجْعَلْنِى",465],["27:63:5",382,"ٱلْبَرِّ","(of) the land","يَهْدِيكُمْ فِى ظُلُمَـٰتِ","وَٱلْبَحْرِ وَمَن يُرْسِلُ",465],["29:65:13",404,"ٱلْبَرِّ","the land","فَلَمَّا نَجَّىٰهُمْ إِلَى","إِذَا هُمْ يُشْرِكُونَ",465],["30:41:4",408,"ٱلْبَرِّ","the land","ظَهَرَ ٱلْفَسَادُ فِى","وَٱلْبَحْرِ بِمَا كَسَبَتْ",465],["31:32:13",414,"ٱلْبَرِّ","the land","فَلَمَّا نَجَّىٰهُمْ إِلَى","فَمِنْهُم مُّقْتَصِدٌۭ ۚ وَمَا",465],["52:28:8",524,"ٱلْبَرُّ","(is) the Most Kind","نَدْعُوهُ ۖ إِنَّهُۥ هُوَ","ٱلرَّحِيمُ",465],["58:9:13",543,"بِٱلْبِرِّ","for righteousness","وَمَعْصِيَتِ ٱلرَّسُولِ وَتَنَـٰجَوْا۟","وَٱلتَّقْوَىٰ ۖ وَٱتَّقُوا۟ ٱللَّهَ",970],["60:8:15",550,"تَبَرُّوهُمْ","you deal kindly","مِّن دِيَـٰرِكُمْ أَن","وَتُقْسِطُوٓا۟ إِلَيْهِمْ ۚ إِنَّ",2661],["76:5:2",578,"ٱلْأَبْرَارَ","the righteous","إِنَّ","يَشْرَبُونَ مِن كَأْسٍۢ",465],["80:16:2",585,"بَرَرَةٍۢ","dutiful","كِرَامٍۭ","",465],["82:13:2",587,"ٱلْأَبْرَارَ","the righteous","إِنَّ","لَفِى نَعِيمٍۢ",465],["83:18:4",588,"ٱلْأَبْرَارِ","(of) the righteous","كَلَّآ إِنَّ كِتَـٰبَ","لَفِى عِلِّيِّينَ",465],["83:22:2",588,"ٱلْأَبْرَارَ","the righteous","إِنَّ","لَفِى نَعِيمٍ",465]]