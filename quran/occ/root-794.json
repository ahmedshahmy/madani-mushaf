[["4:43:33",85,"لَـٰمَسْتُمُ","you have touched","مِّنَ ٱلْغَآئِطِ أَوْ","ٱلنِّسَآءَ فَلَمْ تَجِدُوا۟",1572],["5:6:35",108,"لَـٰمَسْتُمُ","has (had) contact","مِّنَ ٱلْغَآئِطِ أَوْ","ٱلنِّسَآءَ فَلَمْ تَجِدُوا۟",1572],["6:7:7",128,"فَلَمَسُوهُ","and they touched it","كِتَـٰبًۭا فِى قِرْطَاسٍۢ","بِأَيْدِيهِمْ لَقَالَ ٱلَّذِينَ",1572],["57:13:14",539,"فَٱلْتَمِسُوا۟","and seek","قِيلَ ٱرْجِعُوا۟ وَرَآءَكُمْ","نُورًۭا فَضُرِبَ بَيْنَهُم",4805],["72:8:2",572,"لَمَسْنَا","sought to touch","وَأَنَّا","ٱلسَّمَآءَ فَوَجَدْنَـٰهَا مُلِئَتْ",1572]]