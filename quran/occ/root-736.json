[["4:9:15",78,"سَدِيدًا","appropriate","ٱللَّهَ وَلْيَقُولُوا۟ قَوْلًۭا","",2621],["18:93:5",303,"ٱلسَّدَّيْنِ","the two mountains","إِذَا بَلَغَ بَيْنَ","وَجَدَ مِن دُونِهِمَا",1635],["18:94:19",303,"سَدًّۭا","a barrier","تَجْعَلَ بَيْنَنَا وَبَيْنَهُمْ","",1635],["33:70:8",427,"سَدِيدًۭا","right","ٱللَّهَ وَقُولُوا۟ قَوْلًۭا","",2621],["36:9:5",440,"سَدًّۭا","a barrier","مِنۢ بَيْنِ أَيْدِيهِمْ","وَمِنْ خَلْفِهِمْ سَدًّۭا",1635],["36:9:8",440,"سَدًّۭا","a barrier","سَدًّۭا وَمِنْ خَلْفِهِمْ","فَأَغْشَيْنَـٰهُمْ فَهُمْ لَا",1635]]