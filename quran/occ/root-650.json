[["11:81:9",230,"فَأَسْرِ","So travel","لَن يَصِلُوٓا۟ إِلَيْكَ ۖ","بِأَهْلِكَ بِقِطْعٍۢ مِّنَ",1140],["15:65:1",265,"فَأَسْرِ","So travel","","بِأَهْلِكَ بِقِطْعٍۢ مِّنَ",1140],["17:1:3",282,"أَسْرَىٰ","took","سُبْحَـٰنَ ٱلَّذِىٓ","بِعَبْدِهِۦ لَيْلًۭا مِّنَ",1140],["19:24:10",306,"سَرِيًّۭا","a stream","جَعَلَ رَبُّكِ تَحْتَكِ","",4259],["20:77:6",317,"أَسْرِ","Travel by night","إِلَىٰ مُوسَىٰٓ أَنْ","بِعِبَادِى فَٱضْرِبْ لَهُمْ",1140],["26:52:5",369,"أَسْرِ","Travel by night","إِلَىٰ مُوسَىٰٓ أَنْ","بِعِبَادِىٓ إِنَّكُم مُّتَّبَعُونَ",1140],["44:23:1",497,"فَأَسْرِ","Then \"Set out","","بِعِبَادِى لَيْلًا إِنَّكُم",1140],["89:4:3",593,"يَسْرِ","it passes","وَٱلَّيْلِ إِذَا","",4659]]