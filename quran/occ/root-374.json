[["3:147:11",68,"وَإِسْرَافَنَا","and our excesses","ٱغْفِرْ لَنَا ذُنُوبَنَا","فِىٓ أَمْرِنَا وَثَبِّتْ",2145],["4:6:16",77,"إِسْرَافًۭا","extravagantly","أَمْوَٰلَهُمْ ۖ وَلَا تَأْكُلُوهَآ","وَبِدَارًا أَن يَكْبَرُوا۟ ۚ",2145],["5:32:40",113,"لَمُسْرِفُونَ","(are) surely those who commit excesses","ذَٰلِكَ فِى ٱلْأَرْضِ","",634],["6:141:27",146,"تُسْرِفُوٓا۟ ۚ","(be) extravagant","يَوْمَ حَصَادِهِۦ ۖ وَلَا","إِنَّهُۥ لَا يُحِبُّ",1141],["6:141:31",146,"ٱلْمُسْرِفِينَ","the ones who are extravagant","إِنَّهُۥ لَا يُحِبُّ","",634],["7:31:11",154,"تُسْرِفُوٓا۟ ۚ","be extravagant","وَكُلُوا۟ وَٱشْرَبُوا۟ وَلَا","إِنَّهُۥ لَا يُحِبُّ",1141],["7:31:15",154,"ٱلْمُسْرِفِينَ","the extravagant ones","إِنَّهُۥ لَا يُحِبُّ","",634],["7:81:11",160,"مُّسْرِفُونَ","(who) commit excesses","بَلْ أَنتُمْ قَوْمٌۭ","",634],["10:12:24",209,"لِلْمُسْرِفِينَ","to the extravagant","مَّسَّهُۥ ۚ كَذَٰلِكَ زُيِّنَ","مَا كَانُوا۟ يَعْمَلُونَ",634],["10:83:22",218,"ٱلْمُسْرِفِينَ","the ones who commit excesses","ٱلْأَرْضِ وَإِنَّهُۥ لَمِنَ","",634],["17:33:17",285,"يُسْرِف","he should exceed","لِوَلِيِّهِۦ سُلْطَـٰنًۭا فَلَا","فِّى ٱلْقَتْلِ ۖ إِنَّهُۥ",1141],["20:127:4",321,"أَسْرَفَ","transgresses","وَكَذَٰلِكَ نَجْزِى مَنْ","وَلَمْ يُؤْمِنۢ بِـَٔايَـٰتِ",1141],["21:9:8",322,"ٱلْمُسْرِفِينَ","the transgressors","وَمَن نَّشَآءُ وَأَهْلَكْنَا","",634],["25:67:5",365,"يُسْرِفُوا۟","(are) not extravagant","إِذَآ أَنفَقُوا۟ لَمْ","وَلَمْ يَقْتُرُوا۟ وَكَانَ",1141],["26:151:4",373,"ٱلْمُسْرِفِينَ","(of) the transgressors","وَلَا تُطِيعُوٓا۟ أَمْرَ","",634],["36:19:9",441,"مُّسْرِفُونَ","transgressing","بَلْ أَنتُمْ قَوْمٌۭ","",634],["39:53:4",464,"أَسْرَفُوا۟","have transgressed","۞ قُلْ يَـٰعِبَادِىَ ٱلَّذِينَ","عَلَىٰٓ أَنفُسِهِمْ لَا",1141],["40:28:38",470,"مُسْرِفٌۭ","(is) a transgressor","يَهْدِى مَنْ هُوَ","كَذَّابٌۭ",634],["40:34:29",471,"مُسْرِفٌۭ","(is) a transgressor","ٱللَّهُ مَنْ هُوَ","مُّرْتَابٌ",634],["40:43:19",472,"ٱلْمُسْرِفِينَ","the transgressors","إِلَى ٱللَّهِ وَأَنَّ","هُمْ أَصْحَـٰبُ ٱلنَّارِ",634],["43:5:8",489,"مُّسْرِفِينَ","transgressing","أَن كُنتُمْ قَوْمًۭا","",634],["44:31:7",497,"ٱلْمُسْرِفِينَ","the transgressors","كَانَ عَالِيًۭا مِّنَ","",634],["51:34:4",522,"لِلْمُسْرِفِينَ","for the transgressors","مُّسَوَّمَةً عِندَ رَبِّكَ","",634]]