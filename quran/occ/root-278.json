[["2:137:15",21,"فَسَيَكْفِيكَهُمُ","So will suffice you against them","هُمْ فِى شِقَاقٍۢ ۖ","ٱللَّهُ ۚ وَهُوَ ٱلسَّمِيعُ",352],["3:124:5",66,"يَكْفِيَكُمْ","enough for you","تَقُولُ لِلْمُؤْمِنِينَ أَلَن","أَن يُمِدَّكُمْ رَبُّكُم",352],["4:6:35",77,"وَكَفَىٰ","And is sufficient","أَمْوَٰلَهُمْ فَأَشْهِدُوا۟ عَلَيْهِمْ ۚ","بِٱللَّهِ حَسِيبًۭا",352],["4:45:4",86,"وَكَفَىٰ","and (is) sufficient","وَٱللَّهُ أَعْلَمُ بِأَعْدَآئِكُمْ ۚ","بِٱللَّهِ وَلِيًّۭا وَكَفَىٰ",352],["4:45:7",86,"وَكَفَىٰ","and sufficient","وَكَفَىٰ بِٱللَّهِ وَلِيًّۭا","بِٱللَّهِ نَصِيرًۭا",352],["4:50:7",86,"وَكَفَىٰ","and sufficient","عَلَى ٱللَّهِ ٱلْكَذِبَ ۖ","بِهِۦٓ إِثْمًۭا مُّبِينًا",352],["4:55:9",87,"وَكَفَىٰ","and sufficient","مَّن صَدَّ عَنْهُ ۚ","بِجَهَنَّمَ سَعِيرًا",352],["4:70:5",89,"وَكَفَىٰ","and sufficient","ٱلْفَضْلُ مِنَ ٱللَّهِ ۚ","بِٱللَّهِ عَلِيمًۭا",352],["4:79:16",90,"وَكَفَىٰ","and is sufficient","وَأَرْسَلْنَـٰكَ لِلنَّاسِ رَسُولًۭا ۚ","بِٱللَّهِ شَهِيدًۭا",352],["4:81:22",91,"وَكَفَىٰ","And sufficient","وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ","بِٱللَّهِ وَكِيلًا",352],["4:132:8",99,"وَكَفَىٰ","And is sufficient","وَمَا فِى ٱلْأَرْضِ ۚ","بِٱللَّهِ وَكِيلًا",352],["4:166:11",104,"وَكَفَىٰ","And is sufficient","بِعِلْمِهِۦ ۖ وَٱلْمَلَـٰٓئِكَةُ يَشْهَدُونَ ۚ","بِٱللَّهِ شَهِيدًا",352],["4:171:51",105,"وَكَفَىٰ","And is sufficient","وَمَا فِى ٱلْأَرْضِ ۗ","بِٱللَّهِ وَكِيلًۭا",352],["10:29:1",212,"فَكَفَىٰ","So sufficient","","بِٱللَّهِ شَهِيدًۢا بَيْنَنَا",352],["13:43:7",255,"كَفَىٰ","Sufficient","لَسْتَ مُرْسَلًۭا ۚ قُلْ","بِٱللَّهِ شَهِيدًۢا بَيْنِى",352],["15:95:2",267,"كَفَيْنَـٰكَ","[We] are sufficient for you","إِنَّا","ٱلْمُسْتَهْزِءِينَ",352],["17:14:3",283,"كَفَىٰ","Sufficient","ٱقْرَأْ كِتَـٰبَكَ","بِنَفْسِكَ ٱلْيَوْمَ عَلَيْكَ",352],["17:17:8",283,"وَكَفَىٰ","And sufficient","مِنۢ بَعْدِ نُوحٍۢ ۗ","بِرَبِّكَ بِذُنُوبِ عِبَادِهِۦ",352],["17:65:7",288,"وَكَفَىٰ","And sufficient","لَكَ عَلَيْهِمْ سُلْطَـٰنٌۭ ۚ","بِرَبِّكَ وَكِيلًۭا",352],["17:96:2",291,"كَفَىٰ","Sufficient is","قُلْ","بِٱللَّهِ شَهِيدًۢا بَيْنِى",352],["21:47:18",326,"وَكَفَىٰ","And sufficient","خَرْدَلٍ أَتَيْنَا بِهَا ۗ","بِنَا حَـٰسِبِينَ",352],["25:31:8",362,"وَكَفَىٰ","But sufficient is","عَدُوًّۭا مِّنَ ٱلْمُجْرِمِينَ ۗ","بِرَبِّكَ هَادِيًۭا وَنَصِيرًۭا",352],["25:58:9",365,"وَكَفَىٰ","And sufficient is","يَمُوتُ وَسَبِّحْ بِحَمْدِهِۦ ۚ","بِهِۦ بِذُنُوبِ عِبَادِهِۦ",352],["29:51:2",402,"يَكْفِهِمْ","sufficient for them","أَوَلَمْ","أَنَّآ أَنزَلْنَا عَلَيْكَ",352],["29:52:2",402,"كَفَىٰ","Sufficient is","قُلْ","بِٱللَّهِ بَيْنِى وَبَيْنَكُمْ",352],["33:3:4",418,"وَكَفَىٰ","And Allah is sufficient","وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ","بِٱللَّهِ وَكِيلًۭا",352],["33:25:9",421,"وَكَفَى","And sufficient is","لَمْ يَنَالُوا۟ خَيْرًۭا ۚ","ٱللَّهُ ٱلْمُؤْمِنِينَ ٱلْقِتَالَ ۚ",352],["33:39:11",423,"وَكَفَىٰ","And sufficient is Allah","أَحَدًا إِلَّا ٱللَّهَ ۗ","بِٱللَّهِ حَسِيبًۭا",352],["33:48:10",424,"وَكَفَىٰ","And sufficient is Allah","وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ","بِٱللَّهِ وَكِيلًۭا",352],["39:36:3",462,"بِكَافٍ","sufficient","أَلَيْسَ ٱللَّهُ","عَبْدَهُۥ ۖ وَيُخَوِّفُونَكَ بِٱلَّذِينَ",3555],["41:53:13",482,"يَكْفِ","sufficient","أَنَّهُ ٱلْحَقُّ ۗ أَوَلَمْ","بِرَبِّكَ أَنَّهُۥ عَلَىٰ",352],["46:8:18",503,"كَفَىٰ","Sufficient is He","بِمَا تُفِيضُونَ فِيهِ ۖ","بِهِۦ شَهِيدًۢا بَيْنِى",352],["48:28:12",514,"وَكَفَىٰ","And sufficient is","عَلَى ٱلدِّينِ كُلِّهِۦ ۚ","بِٱللَّهِ شَهِيدًۭا",352]]