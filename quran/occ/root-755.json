[["2:266:25",45,"إِعْصَارٌۭ","whirlwind","ذُرِّيَّةٌۭ ضُعَفَآءُ فَأَصَابَهَآ","فِيهِ نَارٌۭ فَٱحْتَرَقَتْ ۗ",2921],["12:36:9",239,"أَعْصِرُ","pressing","أَحَدُهُمَآ إِنِّىٓ أَرَىٰنِىٓ","خَمْرًۭا ۖ وَقَالَ ٱلْـَٔاخَرُ",2756],["12:49:11",241,"يَعْصِرُونَ","they will press","يُغَاثُ ٱلنَّاسُ وَفِيهِ","",2756],["78:14:3",582,"ٱلْمُعْصِرَٰتِ","the rain clouds","وَأَنزَلْنَا مِنَ","مَآءًۭ ثَجَّاجًۭا",3763],["103:1:1",601,"وَٱلْعَصْرِ","By the time","","",3101]]