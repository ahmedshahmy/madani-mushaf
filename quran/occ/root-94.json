[["2:66:5",10,"يَدَيْهَا","(of) them","نَكَـٰلًۭا لِّمَا بَيْنَ","وَمَا خَلْفَهَا وَمَوْعِظَةًۭ",99],["2:79:5",12,"بِأَيْدِيهِمْ","with their (own) hands","لِّلَّذِينَ يَكْتُبُونَ ٱلْكِتَـٰبَ","ثُمَّ يَقُولُونَ هَـٰذَا",99],["2:79:20",12,"أَيْدِيهِمْ","their hands","لَّهُم مِّمَّا كَتَبَتْ","وَوَيْلٌۭ لَّهُم مِّمَّا",99],["2:95:6",15,"أَيْدِيهِمْ ۗ","their hands","أَبَدًۢا بِمَا قَدَّمَتْ","وَٱللَّهُ عَلِيمٌۢ بِٱلظَّـٰلِمِينَ",99],["2:97:15",15,"يَدَيْهِ","before it","مُصَدِّقًۭا لِّمَا بَيْنَ","وَهُدًۭى وَبُشْرَىٰ لِلْمُؤْمِنِينَ",99],["2:195:7",30,"بِأَيْدِيكُمْ","[with your hands]","ٱللَّهِ وَلَا تُلْقُوا۟","إِلَى ٱلتَّهْلُكَةِ ۛ وَأَحْسِنُوٓا۟ ۛ",99],["2:237:20",38,"بِيَدِهِۦ","in whose hands","أَوْ يَعْفُوَا۟ ٱلَّذِى","عُقْدَةُ ٱلنِّكَاحِ ۚ وَأَن",99],["2:249:24",41,"بِيَدِهِۦ ۚ","(of) his hand","مَنِ ٱغْتَرَفَ غُرْفَةًۢ","فَشَرِبُوا۟ مِنْهُ إِلَّا",99],["2:255:30",42,"أَيْدِيهِمْ","before them","يَعْلَمُ مَا بَيْنَ","وَمَا خَلْفَهُمْ ۖ وَلَا",99],["3:3:8",50,"يَدَيْهِ","before it","مُصَدِّقًۭا لِّمَا بَيْنَ","وَأَنزَلَ ٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ",99],["3:26:19",53,"بِيَدِكَ","In Your hand","وَتُذِلُّ مَن تَشَآءُ ۖ","ٱلْخَيْرُ ۖ إِنَّكَ عَلَىٰ",99],["3:50:4",56,"يَدَىَّ","before me","وَمُصَدِّقًۭا لِّمَا بَيْنَ","مِنَ ٱلتَّوْرَىٰةِ وَلِأُحِلَّ",99],["3:73:25",59,"بِيَدِ","(is) in the Hand","قُلْ إِنَّ ٱلْفَضْلَ","ٱللَّهِ يُؤْتِيهِ مَن",99],["3:182:4",74,"أَيْدِيكُمْ","your hands","ذَٰلِكَ بِمَا قَدَّمَتْ","وَأَنَّ ٱللَّهَ لَيْسَ",99],["4:43:43",85,"وَأَيْدِيكُمْ ۗ","and your hands","طَيِّبًۭا فَٱمْسَحُوا۟ بِوُجُوهِكُمْ","إِنَّ ٱللَّهَ كَانَ",99],["4:62:7",88,"أَيْدِيهِمْ","their hands","مُّصِيبَةٌۢ بِمَا قَدَّمَتْ","ثُمَّ جَآءُوكَ يَحْلِفُونَ",99],["4:77:8",90,"أَيْدِيَكُمْ","your hands","قِيلَ لَهُمْ كُفُّوٓا۟","وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟",99],["4:91:22",92,"أَيْدِيَهُمْ","their hands","إِلَيْكُمُ ٱلسَّلَمَ وَيَكُفُّوٓا۟","فَخُذُوهُمْ وَٱقْتُلُوهُمْ حَيْثُ",99],["5:6:10",108,"وَأَيْدِيَكُمْ","and your hands","ٱلصَّلَوٰةِ فَٱغْسِلُوا۟ وُجُوهَكُمْ","إِلَى ٱلْمَرَافِقِ وَٱمْسَحُوا۟",99],["5:6:45",108,"وَأَيْدِيكُم","and your hands","طَيِّبًۭا فَٱمْسَحُوا۟ بِوُجُوهِكُمْ","مِّنْهُ ۚ مَا يُرِيدُ",99],["5:11:14",109,"أَيْدِيَهُمْ","their hands","أَن يَبْسُطُوٓا۟ إِلَيْكُمْ","فَكَفَّ أَيْدِيَهُمْ عَنكُمْ ۖ",99],["5:11:16",109,"أَيْدِيَهُمْ","their hands","إِلَيْكُمْ أَيْدِيَهُمْ فَكَفَّ","عَنكُمْ ۖ وَٱتَّقُوا۟ ٱللَّهَ ۚ",99],["5:28:4",112,"يَدَكَ","your hand","لَئِنۢ بَسَطتَ إِلَىَّ","لِتَقْتُلَنِى مَآ أَنَا۠",99],["5:28:9",112,"يَدِىَ","my hand","مَآ أَنَا۠ بِبَاسِطٍۢ","إِلَيْكَ لِأَقْتُلَكَ ۖ إِنِّىٓ",99],["5:33:17",113,"أَيْدِيهِمْ","their hands","يُصَلَّبُوٓا۟ أَوْ تُقَطَّعَ","وَأَرْجُلُهُم مِّنْ خِلَـٰفٍ",99],["5:38:4",114,"أَيْدِيَهُمَا","their hands","وَٱلسَّارِقُ وَٱلسَّارِقَةُ فَٱقْطَعُوٓا۟","جَزَآءًۢ بِمَا كَسَبَا",99],["5:46:10",116,"يَدَيْهِ","his hands","مُصَدِّقًۭا لِّمَا بَيْنَ","مِنَ ٱلتَّوْرَىٰةِ ۖ وَءَاتَيْنَـٰهُ",99],["5:46:21",116,"يَدَيْهِ","his hands","وَمُصَدِّقًۭا لِّمَا بَيْنَ","مِنَ ٱلتَّوْرَىٰةِ وَهُدًۭى",99],["5:48:8",116,"يَدَيْهِ","his hands","مُصَدِّقًۭا لِّمَا بَيْنَ","مِنَ ٱلْكِتَـٰبِ وَمُهَيْمِنًا",99],["5:64:3",118,"يَدُ","The Hand","وَقَالَتِ ٱلْيَهُودُ","ٱللَّهِ مَغْلُولَةٌ ۚ غُلَّتْ",99],["5:64:7",118,"أَيْدِيهِمْ","their hands","ٱللَّهِ مَغْلُولَةٌ ۚ غُلَّتْ","وَلُعِنُوا۟ بِمَا قَالُوا۟ ۘ",99],["5:64:12",118,"يَدَاهُ","His Hands","بِمَا قَالُوا۟ ۘ بَلْ","مَبْسُوطَتَانِ يُنفِقُ كَيْفَ",99],["5:94:10",123,"أَيْدِيكُمْ","your hands","مِّنَ ٱلصَّيْدِ تَنَالُهُۥٓ","وَرِمَاحُكُمْ لِيَعْلَمَ ٱللَّهُ",99],["6:7:8",128,"بِأَيْدِيهِمْ","with their hands","فِى قِرْطَاسٍۢ فَلَمَسُوهُ","لَقَالَ ٱلَّذِينَ كَفَرُوٓا۟",99],["6:92:8",139,"يَدَيْهِ","its hands","مُّصَدِّقُ ٱلَّذِى بَيْنَ","وَلِتُنذِرَ أُمَّ ٱلْقُرَىٰ",99],["6:93:32",139,"أَيْدِيهِمْ","their hands (saying)","ٱلْمَوْتِ وَٱلْمَلَـٰٓئِكَةُ بَاسِطُوٓا۟","أَخْرِجُوٓا۟ أَنفُسَكُمُ ۖ ٱلْيَوْمَ",99],["7:17:5",152,"أَيْدِيهِمْ","them","لَـَٔاتِيَنَّهُم مِّنۢ بَيْنِ","وَمِنْ خَلْفِهِمْ وَعَنْ",99],["7:57:7",157,"يَدَىْ","before","ٱلرِّيَـٰحَ بُشْرًۢا بَيْنَ","رَحْمَتِهِۦ ۖ حَتَّىٰٓ إِذَآ",99],["7:108:2",164,"يَدَهُۥ","his hand","وَنَزَعَ","فَإِذَا هِىَ بَيْضَآءُ",99],["7:124:2",165,"أَيْدِيَكُمْ","your hands","لَأُقَطِّعَنَّ","وَأَرْجُلَكُم مِّنْ خِلَـٰفٍۢ",99],["7:149:4",168,"أَيْدِيهِمْ","their hands","وَلَمَّا سُقِطَ فِىٓ","وَرَأَوْا۟ أَنَّهُمْ قَدْ",99],["7:195:7",175,"أَيْدٍۢ","hands","بِهَآ ۖ أَمْ لَهُمْ","يَبْطِشُونَ بِهَآ ۖ أَمْ",99],["8:51:4",183,"أَيْدِيكُمْ","your hands","ذَٰلِكَ بِمَا قَدَّمَتْ","وَأَنَّ ٱللَّهَ لَيْسَ",99],["8:70:6",186,"أَيْدِيكُم","your hands","قُل لِّمَن فِىٓ","مِّنَ ٱلْأَسْرَىٰٓ إِن",99],["9:14:4",189,"بِأَيْدِيكُمْ","by your hands","قَـٰتِلُوهُمْ يُعَذِّبْهُمُ ٱللَّهُ","وَيُخْزِهِمْ وَيَنصُرْكُمْ عَلَيْهِمْ",99],["9:29:27",191,"يَدٍۢ","willingly","يُعْطُوا۟ ٱلْجِزْيَةَ عَن","وَهُمْ صَـٰغِرُونَ",99],["9:52:18",195,"بِأَيْدِينَا ۖ","by our hands","مِّنْ عِندِهِۦٓ أَوْ","فَتَرَبَّصُوٓا۟ إِنَّا مَعَكُم",99],["9:67:12",197,"أَيْدِيَهُمْ ۚ","their hands","عَنِ ٱلْمَعْرُوفِ وَيَقْبِضُونَ","نَسُوا۟ ٱللَّهَ فَنَسِيَهُمْ ۗ",99],["10:37:14",213,"يَدَيْهِ","(was) before it","تَصْدِيقَ ٱلَّذِى بَيْنَ","وَتَفْصِيلَ ٱلْكِتَـٰبِ لَا",99],["11:70:3",229,"أَيْدِيَهُمْ","their hands","فَلَمَّا رَءَآ","لَا تَصِلُ إِلَيْهِ",99],["12:31:21",239,"أَيْدِيَهُنَّ","their hands","رَأَيْنَهُۥٓ أَكْبَرْنَهُۥ وَقَطَّعْنَ","وَقُلْنَ حَـٰشَ لِلَّهِ",99],["12:50:18",241,"أَيْدِيَهُنَّ ۚ","their hands","ٱلنِّسْوَةِ ٱلَّـٰتِى قَطَّعْنَ","إِنَّ رَبِّى بِكَيْدِهِنَّ",99],["12:111:16",248,"يَدَيْهِ","(was) before it","تَصْدِيقَ ٱلَّذِى بَيْنَ","وَتَفْصِيلَ كُلِّ شَىْءٍۢ",99],["13:11:5",250,"يَدَيْهِ","(him)","مُعَقِّبَـٰتٌۭ مِّنۢ بَيْنِ","وَمِنْ خَلْفِهِۦ يَحْفَظُونَهُۥ",99],["14:9:22",256,"أَيْدِيَهُمْ","their hands","رُسُلُهُم بِٱلْبَيِّنَـٰتِ فَرَدُّوٓا۟","فِىٓ أَفْوَٰهِهِمْ وَقَالُوٓا۟",99],["17:29:3",285,"يَدَكَ","your hand","وَلَا تَجْعَلْ","مَغْلُولَةً إِلَىٰ عُنُقِكَ",99],["18:57:12",300,"يَدَاهُ ۚ","his hands","وَنَسِىَ مَا قَدَّمَتْ","إِنَّا جَعَلْنَا عَلَىٰ",99],["19:64:9",309,"أَيْدِينَا","(is) before us","لَهُۥ مَا بَيْنَ","وَمَا خَلْفَنَا وَمَا",99],["20:22:2",313,"يَدَكَ","your hand","وَٱضْمُمْ","إِلَىٰ جَنَاحِكَ تَخْرُجْ",99],["20:71:14",316,"أَيْدِيَكُمْ","your hands","عَلَّمَكُمُ ٱلسِّحْرَ ۖ فَلَأُقَطِّعَنَّ","وَأَرْجُلَكُم مِّنْ خِلَـٰفٍۢ",99],["20:110:4",319,"أَيْدِيهِمْ","(is) before them","يَعْلَمُ مَا بَيْنَ","وَمَا خَلْفَهُمْ وَلَا",99],["21:28:4",324,"أَيْدِيهِمْ","(is) before them","يَعْلَمُ مَا بَيْنَ","وَمَا خَلْفَهُمْ وَلَا",99],["22:10:4",333,"يَدَاكَ","your hands","ذَٰلِكَ بِمَا قَدَّمَتْ","وَأَنَّ ٱللَّهَ لَيْسَ",99],["22:76:4",341,"أَيْدِيهِمْ","(is) before them","يَعْلَمُ مَا بَيْنَ","وَمَا خَلْفَهُمْ ۗ وَإِلَى",99],["23:88:3",347,"بِيَدِهِۦ","in Whose Hand(s)","قُلْ مَنۢ","مَلَكُوتُ كُلِّ شَىْءٍۢ",99],["24:24:5",352,"وَأَيْدِيهِمْ","and their hands","تَشْهَدُ عَلَيْهِمْ أَلْسِنَتُهُمْ","وَأَرْجُلُهُم بِمَا كَانُوا۟",99],["24:40:20",355,"يَدَهُۥ","his hand","بَعْضٍ إِذَآ أَخْرَجَ","لَمْ يَكَدْ يَرَىٰهَا ۗ",99],["25:27:5",362,"يَدَيْهِ","his hands","يَعَضُّ ٱلظَّالِمُ عَلَىٰ","يَقُولُ يَـٰلَيْتَنِى ٱتَّخَذْتُ",99],["25:48:7",364,"يَدَىْ","before","ٱلرِّيَـٰحَ بُشْرًۢا بَيْنَ","رَحْمَتِهِۦ ۚ وَأَنزَلْنَا مِنَ",99],["26:33:2",368,"يَدَهُۥ","his hand","وَنَزَعَ","فَإِذَا هِىَ بَيْضَآءُ",99],["26:49:16",369,"أَيْدِيَكُمْ","your hands","فَلَسَوْفَ تَعْلَمُونَ ۚ لَأُقَطِّعَنَّ","وَأَرْجُلَكُم مِّنْ خِلَـٰفٍۢ",99],["27:12:2",377,"يَدَكَ","your hand","وَأَدْخِلْ","فِى جَيْبِكَ تَخْرُجْ",99],["27:63:12",382,"يَدَىْ","before","ٱلرِّيَـٰحَ بُشْرًۢا بَيْنَ","رَحْمَتِهِۦٓ ۗ أَءِلَـٰهٌۭ مَّعَ",99],["28:32:2",389,"يَدَكَ","your hand","ٱسْلُكْ","فِى جَيْبِكَ تَخْرُجْ",99],["28:47:7",391,"أَيْدِيهِمْ","their hands","مُّصِيبَةٌۢ بِمَا قَدَّمَتْ","فَيَقُولُوا۟ رَبَّنَا لَوْلَآ",99],["30:36:12",408,"أَيْدِيهِمْ","their hands","سَيِّئَةٌۢ بِمَا قَدَّمَتْ","إِذَا هُمْ يَقْنَطُونَ",99],["30:41:8",408,"أَيْدِى","(the) hands","وَٱلْبَحْرِ بِمَا كَسَبَتْ","ٱلنَّاسِ لِيُذِيقَهُم بَعْضَ",99],["34:9:6",429,"أَيْدِيهِمْ","(is) before them","إِلَىٰ مَا بَيْنَ","وَمَا خَلْفَهُم مِّنَ",99],["34:12:16",429,"يَدَيْهِ","before him","مَن يَعْمَلُ بَيْنَ","بِإِذْنِ رَبِّهِۦ ۖ وَمَن",99],["34:31:11",431,"يَدَيْهِ ۗ","(was) before it","وَلَا بِٱلَّذِى بَيْنَ","وَلَوْ تَرَىٰٓ إِذِ",99],["34:46:22",433,"يَدَىْ","before","نَذِيرٌۭ لَّكُم بَيْنَ","عَذَابٍۢ شَدِيدٍۢ",99],["35:31:11",438,"يَدَيْهِ ۗ","before it","مُصَدِّقًۭا لِّمَا بَيْنَ","إِنَّ ٱللَّهَ بِعِبَادِهِۦ",99],["36:9:4",440,"أَيْدِيهِمْ","their hands/their front","وَجَعَلْنَا مِنۢ بَيْنِ","سَدًّۭا وَمِنْ خَلْفِهِمْ",99],["36:35:6",442,"أَيْدِيهِمْ ۖ","their hands","ثَمَرِهِۦ وَمَا عَمِلَتْهُ","أَفَلَا يَشْكُرُونَ",99],["36:45:7",443,"أَيْدِيكُمْ","(is) before you","ٱتَّقُوا۟ مَا بَيْنَ","وَمَا خَلْفَكُمْ لَعَلَّكُمْ",99],["36:65:6",444,"أَيْدِيهِمْ","their hands","عَلَىٰٓ أَفْوَٰهِهِمْ وَتُكَلِّمُنَآ","وَتَشْهَدُ أَرْجُلُهُم بِمَا",99],["36:71:8",445,"أَيْدِينَآ","Our hands","لَهُم مِّمَّا عَمِلَتْ","أَنْعَـٰمًۭا فَهُمْ لَهَا",99],["36:83:3",445,"بِيَدِهِۦ","in Whose hand","فَسُبْحَـٰنَ ٱلَّذِى","مَلَكُوتُ كُلِّ شَىْءٍۢ",99],["38:44:2",456,"بِيَدِكَ","in your hand","وَخُذْ","ضِغْثًۭا فَٱضْرِب بِّهِۦ",99],["38:45:7",456,"ٱلْأَيْدِى","(of) strength","وَإِسْحَـٰقَ وَيَعْقُوبَ أُو۟لِى","وَٱلْأَبْصَـٰرِ",99],["38:75:9",457,"بِيَدَىَّ ۖ","with My Hands","تَسْجُدَ لِمَا خَلَقْتُ","أَسْتَكْبَرْتَ أَمْ كُنتَ",99],["41:14:6",478,"أَيْدِيهِمْ","from before them","ٱلرُّسُلُ مِنۢ بَيْنِ","وَمِنْ خَلْفِهِمْ أَلَّا",99],["41:25:8",479,"أَيْدِيهِمْ","(was) before them","لَهُم مَّا بَيْنَ","وَمَا خَلْفَهُمْ وَحَقَّ",99],["41:42:6",481,"يَدَيْهِ","before it","ٱلْبَـٰطِلُ مِنۢ بَيْنِ","وَلَا مِنْ خَلْفِهِۦ ۖ",99],["42:30:7",486,"أَيْدِيكُمْ","your hands","مُّصِيبَةٍۢ فَبِمَا كَسَبَتْ","وَيَعْفُوا۟ عَن كَثِيرٍۢ",99],["42:48:24",488,"أَيْدِيهِمْ","their hands","سَيِّئَةٌۢ بِمَا قَدَّمَتْ","فَإِنَّ ٱلْإِنسَـٰنَ كَفُورٌۭ",99],["46:21:13",505,"يَدَيْهِ","before him","ٱلنُّذُرُ مِنۢ بَيْنِ","وَمِنْ خَلْفِهِۦٓ أَلَّا",99],["46:30:13",506,"يَدَيْهِ","(was) before it","مُصَدِّقًۭا لِّمَا بَيْنَ","يَهْدِىٓ إِلَى ٱلْحَقِّ",99],["48:10:7",512,"يَدُ","(The) Hand","إِنَّمَا يُبَايِعُونَ ٱللَّهَ","ٱللَّهِ فَوْقَ أَيْدِيهِمْ ۚ",99],["48:10:10",512,"أَيْدِيهِمْ ۚ","their hands","يَدُ ٱللَّهِ فَوْقَ","فَمَن نَّكَثَ فَإِنَّمَا",99],["48:20:10",513,"أَيْدِىَ","(the) hands","لَكُمْ هَـٰذِهِۦ وَكَفَّ","ٱلنَّاسِ عَنكُمْ وَلِتَكُونَ",99],["48:24:4",514,"أَيْدِيَهُمْ","their hands","وَهُوَ ٱلَّذِى كَفَّ","عَنكُمْ وَأَيْدِيَكُمْ عَنْهُم",99],["48:24:6",514,"وَأَيْدِيَكُمْ","and your hands","كَفَّ أَيْدِيَهُمْ عَنكُمْ","عَنْهُم بِبَطْنِ مَكَّةَ",99],["49:1:7",515,"يَدَىِ","before Allah","لَا تُقَدِّمُوا۟ بَيْنَ","ٱللَّهِ وَرَسُولِهِۦ ۖ وَٱتَّقُوا۟",99],["57:12:8",539,"أَيْدِيهِمْ","before them","يَسْعَىٰ نُورُهُم بَيْنَ","وَبِأَيْمَـٰنِهِم بُشْرَىٰكُمُ ٱلْيَوْمَ",99],["57:29:14",541,"بِيَدِ","(is) in Allah's Hand","ٱللَّهِ ۙ وَأَنَّ ٱلْفَضْلَ","ٱللَّهِ يُؤْتِيهِ مَن",99],["58:12:9",544,"يَدَىْ","before","ٱلرَّسُولَ فَقَدِّمُوا۟ بَيْنَ","نَجْوَىٰكُمْ صَدَقَةًۭ ۚ ذَٰلِكَ",99],["58:13:5",544,"يَدَىْ","before","أَن تُقَدِّمُوا۟ بَيْنَ","نَجْوَىٰكُمْ صَدَقَـٰتٍۢ ۚ فَإِذْ",99],["59:2:35",545,"بِأَيْدِيهِمْ","with their hands","ٱلرُّعْبَ ۚ يُخْرِبُونَ بُيُوتَهُم","وَأَيْدِى ٱلْمُؤْمِنِينَ فَٱعْتَبِرُوا۟",99],["59:2:36",545,"وَأَيْدِى","and the hands","يُخْرِبُونَ بُيُوتَهُم بِأَيْدِيهِمْ","ٱلْمُؤْمِنِينَ فَٱعْتَبِرُوا۟ يَـٰٓأُو۟لِى",99],["60:2:8",549,"أَيْدِيَهُمْ","their hands","أَعْدَآءًۭ وَيَبْسُطُوٓا۟ إِلَيْكُمْ","وَأَلْسِنَتَهُم بِٱلسُّوٓءِ وَوَدُّوا۟",99],["60:12:25",551,"أَيْدِيهِنَّ","their hands","بِبُهْتَـٰنٍۢ يَفْتَرِينَهُۥ بَيْنَ","وَأَرْجُلِهِنَّ وَلَا يَعْصِينَكَ",99],["61:6:15",552,"يَدَىَّ","my hands","مُّصَدِّقًۭا لِّمَا بَيْنَ","مِنَ ٱلتَّوْرَىٰةِ وَمُبَشِّرًۢا",99],["62:7:6",553,"أَيْدِيهِمْ ۚ","their hands","أَبَدًۢا بِمَا قَدَّمَتْ","وَٱللَّهُ عَلِيمٌۢ بِٱلظَّـٰلِمِينَ",99],["66:8:32",561,"أَيْدِيهِمْ","their hands","نُورُهُمْ يَسْعَىٰ بَيْنَ","وَبِأَيْمَـٰنِهِمْ يَقُولُونَ رَبَّنَآ",99],["67:1:3",562,"بِيَدِهِ","in Whose Hand","تَبَـٰرَكَ ٱلَّذِى","ٱلْمُلْكُ وَهُوَ عَلَىٰ",99],["72:27:10",573,"يَدَيْهِ","him","يَسْلُكُ مِنۢ بَيْنِ","وَمِنْ خَلْفِهِۦ رَصَدًۭا",99],["78:40:10",583,"يَدَاهُ","his hands","ٱلْمَرْءُ مَا قَدَّمَتْ","وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى",99],["80:15:1",585,"بِأَيْدِى","In (the) hands","","سَفَرَةٍۢ",99],["111:1:2",603,"يَدَآ","(the) hands","تَبَّتْ","أَبِى لَهَبٍۢ وَتَبَّ",99]]