[["2:9:10",3,"يَشْعُرُونَ","they realize (it)","إِلَّآ أَنفُسَهُمْ وَمَا","",432],["2:12:7",3,"يَشْعُرُونَ","they realize (it)","ٱلْمُفْسِدُونَ وَلَـٰكِن لَّا","",432],["2:154:13",24,"تَشْعُرُونَ","perceive","أَحْيَآءٌۭ وَلَـٰكِن لَّا","",432],["2:158:5",24,"شَعَآئِرِ","(the) symbols","ٱلصَّفَا وَٱلْمَرْوَةَ مِن","ٱللَّهِ ۖ فَمَنْ حَجَّ",1451],["2:198:16",31,"ٱلْمَشْعَرِ","the Monument","فَٱذْكُرُوا۟ ٱللَّهَ عِندَ","ٱلْحَرَامِ ۖ وَٱذْكُرُوهُ كَمَا",3621],["3:69:13",58,"يَشْعُرُونَ","they perceive","إِلَّآ أَنفُسَهُمْ وَمَا","",432],["5:2:6",106,"شَعَـٰٓئِرَ","(the) rites","ءَامَنُوا۟ لَا تُحِلُّوا۟","ٱللَّهِ وَلَا ٱلشَّهْرَ",1451],["6:26:11",130,"يَشْعُرُونَ","they perceive","إِلَّآ أَنفُسَهُمْ وَمَا","",432],["6:109:16",141,"يُشْعِرُكُمْ","will make you perceive","عِندَ ٱللَّهِ ۖ وَمَا","أَنَّهَآ إِذَا جَآءَتْ",2794],["6:123:15",143,"يَشْعُرُونَ","they perceive","إِلَّا بِأَنفُسِهِمْ وَمَا","",432],["7:95:18",162,"يَشْعُرُونَ","perceive","بَغْتَةًۭ وَهُمْ لَا","",432],["12:15:17",237,"يَشْعُرُونَ","perceive","هَـٰذَا وَهُمْ لَا","",432],["12:107:14",248,"يَشْعُرُونَ","perceive","بَغْتَةًۭ وَهُمْ لَا","",432],["16:21:5",269,"يَشْعُرُونَ","they perceive","غَيْرُ أَحْيَآءٍۢ ۖ وَمَا","أَيَّانَ يُبْعَثُونَ",432],["16:26:21",269,"يَشْعُرُونَ","they (did) not perceive","مِنْ حَيْثُ لَا","",432],["16:45:16",272,"يَشْعُرُونَ","they perceive","مِنْ حَيْثُ لَا","",432],["16:80:21",276,"وَأَشْعَارِهَآ","and their hair","وَمِنْ أَصْوَافِهَا وَأَوْبَارِهَا","أَثَـٰثًۭا وَمَتَـٰعًا إِلَىٰ",2123],["18:19:36",295,"يُشْعِرَنَّ","And let not be aware","مِّنْهُ وَلْيَتَلَطَّفْ وَلَا","بِكُمْ أَحَدًا",2794],["21:5:9",322,"شَاعِرٌۭ","(is) a poet","ٱفْتَرَىٰهُ بَلْ هُوَ","فَلْيَأْتِنَا بِـَٔايَةٍۢ كَمَآ",1262],["22:32:4",336,"شَعَـٰٓئِرَ","(the) Symbols","ذَٰلِكَ وَمَن يُعَظِّمْ","ٱللَّهِ فَإِنَّهَا مِن",1451],["22:36:5",336,"شَعَـٰٓئِرِ","(the) Symbols","جَعَلْنَـٰهَا لَكُم مِّن","ٱللَّهِ لَكُمْ فِيهَا",1451],["23:56:7",345,"يَشْعُرُونَ","they perceive","ٱلْخَيْرَٰتِ ۚ بَل لَّ