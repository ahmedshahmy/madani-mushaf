[["14:17:4",257,"يُسِيغُهُۥ","(to) swallowing it","يَتَجَرَّعُهُۥ وَلَا يَكَادُ","وَيَأْتِيهِ ٱلْمَوْتُ مِن",4733],["16:66:16",274,"سَآئِغًۭا","palatable","وَدَمٍۢ لَّبَنًا خَالِصًۭا","لِّلشَّـٰرِبِينَ",2616],["35:12:7",436,"سَآئِغٌۭ","pleasant","هَـٰذَا عَذْبٌۭ فُرَاتٌۭ","شَرَابُهُۥ وَهَـٰذَا مِلْحٌ",2616]]