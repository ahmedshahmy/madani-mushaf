[["2:57:1",8,"وَظَلَّلْنَا","And We shaded","","عَلَيْكُمُ ٱلْغَمَامَ وَأَنزَلْنَا",2319],["2:210:8",32,"ظُلَلٍۢ","(the) shadows","يَأْتِيَهُمُ ٱللَّهُ فِى","مِّنَ ٱلْغَمَامِ وَٱلْمَلَـٰٓئِكَةُ",1164],["4:57:19",87,"ظِلًّۭا","(in the) shade","أَزْوَٰجٌۭ مُّطَهَّرَةٌۭ ۖ وَنُدْخِلُهُمْ","ظَلِيلًا",659],["4:57:20",87,"ظَلِيلًا","thick","مُّطَهَّرَةٌۭ ۖ وَنُدْخِلُهُمْ ظِلًّۭا","",2317],["7:160:26",171,"وَظَلَّلْنَا","And We shaded","كُلُّ أُنَاسٍۢ مَّشْرَبَهُمْ ۚ","عَلَيْهِمُ ٱلْغَمَـٰمَ وَأَنزَلْنَا",2319],["7:171:6",173,"ظُلَّةٌۭ","a canopy","ٱلْجَبَلَ فَوْقَهُمْ كَأَنَّهُۥ","وَظَنُّوٓا۟ أَنَّهُۥ وَاقِعٌۢ",1164],["13:15:9",251,"وَظِلَـٰلُهُم","and (so do) their shadows","وَٱلْأَرْضِ طَوْعًۭا وَكَرْهًۭا","بِٱلْغُدُوِّ وَٱلْـَٔاصَالِ ۩",659],["13:35:12",254,"وَظِلُّهَا ۚ","and its shade","ٱلْأَنْهَـٰرُ ۖ أُكُلُهَا دَآئِمٌۭ","تِلْكَ عُقْبَى ٱلَّذِينَ",659],["15:14:7",262,"فَظَلُّوا۟","and they were to continue","بَابًۭا مِّنَ ٱلسَّمَآءِ","فِيهِ يَعْرُجُونَ",894],["16:48:10",272,"ظِلَـٰلُهُۥ","their shadows","مِن شَىْءٍۢ يَتَفَيَّؤُا۟","عَنِ ٱلْيَمِينِ وَٱلشَّمَآئِلِ",659],["16:58:5",273,"ظَلَّ","turns","بُشِّرَ أَحَدُهُم بِٱلْأُنثَىٰ","وَجْهُهُۥ مُسْوَدًّۭا وَهُوَ",894],["16:81:6",276,"ظِلَـٰلًۭا","shades","لَكُم مِّمَّا خَلَقَ","وَجَعَلَ لَكُم مِّنَ",659],["20:97:20",318,"ظَلْتَ","you have remained","إِلَىٰٓ إِلَـٰهِكَ ٱلَّذِى","عَلَيْهِ عَاكِفًۭا ۖ لَّنُحَرِّقَنَّهُۥ",894],["25:45:7",364,"ٱلظِّلَّ","the shadow","رَبِّكَ كَيْفَ مَدَّ","وَلَوْ شَآءَ لَجَعَلَهُۥ",659],["26:4:8",367,"فَظَلَّتْ","so would bend","مِّنَ ٱلسَّمَآءِ ءَايَةًۭ","أَعْنَـٰقُهُمْ لَهَا خَـٰضِعِينَ",894],["26:71:4",370,"فَنَظَلُّ","so we will remain","قَالُوا۟ نَعْبُدُ أَصْنَامًۭا","لَهَا عَـٰكِفِينَ",894],["26:189:5",375,"ٱلظُّلَّةِ ۚ","(of) the shadow","فَأَخَذَهُمْ عَذَابُ يَوْمِ","إِنَّهُۥ كَانَ عَذَابَ",1164],["28:24:6",388,"ٱلظِّلِّ","the shade","ثُمَّ تَوَلَّىٰٓ إِلَى","فَقَالَ رَبِّ إِنِّى",659],["30:51:6",410,"لَّظَلُّوا۟","certainly they continue","رِيحًۭا فَرَأَوْهُ مُصْفَرًّۭا","مِنۢ بَعْدِهِۦ يَكْفُرُونَ",894],["31:32:4",414,"كَٱلظُّلَلِ","like canopies","وَإِذَا غَشِيَهُم مَّوْجٌۭ","دَعَوُا۟ ٱللَّهَ مُخْلِصِينَ",1164],["35:21:2",437,"ٱلظِّلُّ","the shade","وَلَا","وَلَا ٱلْحَرُورُ",659],["36:56:4",444,"ظِلَـٰلٍ","shades","هُمْ وَأَزْوَٰجُهُمْ فِى","عَلَى ٱلْأَرَآئِكِ مُتَّكِـُٔونَ",659],["39:16:4",460,"ظُلَلٌۭ","coverings","لَهُم مِّن فَوْقِهِمْ","مِّنَ ٱلنَّارِ وَمِن",1164],["39:16:9",460,"ظُلَلٌۭ ۚ","coverings","ٱلنَّارِ وَمِن تَحْتِهِمْ","ذَٰلِكَ يُخَوِّفُ ٱللَّهُ",1164],["42:33:5",487,"فَيَظْلَلْنَ","then they would remain","يَشَأْ يُسْكِنِ ٱلرِّيحَ","رَوَاكِدَ عَلَىٰ ظَهْرِهِۦٓ ۚ",894],["43:17:8",490,"ظَلَّ","becomes","ضَرَبَ لِلرَّحْمَـٰنِ مَثَلًۭا","وَجْهُهُۥ مُسْوَدًّۭا وَهُوَ",894],["56:30:1",535,"وَظِلٍّۢ","And shade","","مَّمْدُودٍۢ",659],["56:43:1",535,"وَظِلٍّۢ","And a shade","","مِّن يَحْمُومٍۢ",659],["56:65:5",536,"فَظَلْتُمْ","then you would remain","نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًۭا","تَفَكَّهُونَ",894],["76:14:3",579,"ظِلَـٰلُهَا","(are) its shades","وَدَانِيَةً عَلَيْهِمْ","وَذُلِّلَتْ قُطُوفُهَا تَذْلِيلًۭا",659],["77:30:3",581,"ظِلٍّۢ","a shadow","ٱنطَلِقُوٓا۟ إِلَىٰ","ذِى ثَلَـٰثِ شُعَبٍۢ",659],["77:31:2",581,"ظَلِيلٍۢ","cool shade","لَّا","وَلَا يُغْنِى مِنَ",2317],["77:41:4",581,"ظِلَـٰلٍۢ","shades","إِنَّ ٱلْمُتَّقِينَ فِى","وَعُيُونٍۢ",659]]