[["2:109:23",17,"وَٱصْفَحُوا۟","and overlook","لَهُمُ ٱلْحَقُّ ۖ فَٱعْفُوا۟","حَتَّىٰ يَأْتِىَ ٱللَّهُ",1251],["5:13:28",109,"وَٱصْفَحْ ۚ","and overlook","مِّنْهُمْ ۖ فَٱعْفُ عَنْهُمْ","إِنَّ ٱللَّهَ يُحِبُّ",1251],["15:85:12",266,"فَٱصْفَحِ","So overlook","وَإِنَّ ٱلسَّاعَةَ لَـَٔاتِيَةٌۭ ۖ","ٱلصَّفْحَ ٱلْجَمِيلَ",1251],["15:85:13",266,"ٱلصَّفْحَ","(with) forgiveness","ٱلسَّاعَةَ لَـَٔاتِيَةٌۭ ۖ فَٱصْفَحِ","ٱلْجَمِيلَ",2291],["24:22:17",352,"وَلْيَصْفَحُوٓا۟ ۗ","and let them overlook","سَبِيلِ ٱللَّهِ ۖ وَلْيَعْفُوا۟","أَلَا تُحِبُّونَ أَن",1251],["43:5:4",489,"صَفْحًا","disregarding (you)","أَفَنَضْرِبُ عَنكُمُ ٱلذِّكْرَ","أَن كُنتُمْ قَوْمًۭا",2291],["43:89:1",495,"فَٱصْفَحْ","So turn away","","عَنْهُمْ وَقُلْ سَلَـٰمٌۭ ۚ",1251],["64:14:13",557,"وَتَصْفَحُوا۟","and overlook","فَٱحْذَرُوهُمْ ۚ وَإِن تَعْفُوا۟","وَتَغْفِرُوا۟ فَإِنَّ ٱللَّهَ",1251]]