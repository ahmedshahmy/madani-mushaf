[["1:5:2",1,"نَعْبُدُ","we worship","إِيَّاكَ","وَإِيَّاكَ نَسْتَعِينُ",97],["2:21:3",4,"ٱعْبُدُوا۟","worship","يَـٰٓأَيُّهَا ٱلنَّاسُ","رَبَّكُمُ ٱلَّذِى خَلَقَكُمْ",97],["2:23:8",4,"عَبْدِنَا","Our slave","مِّمَّا نَزَّلْنَا عَلَىٰ","فَأْتُوا۟ بِسُورَةٍۢ مِّن",87],["2:83:7",12,"تَعْبُدُونَ","you will worship","بَنِىٓ إِسْرَٰٓءِيلَ لَا","إِلَّا ٱللَّهَ وَبِٱلْوَٰلِدَيْنِ",97],["2:90:20",14,"عِبَادِهِۦ ۖ","His servants","مَن يَشَآءُ مِنْ","فَبَآءُو بِغَضَبٍ عَلَىٰ",87],["2:133:12",20,"تَعْبُدُونَ","will you worship","قَالَ لِبَنِيهِ مَا","مِنۢ بَعْدِى قَالُوا۟",97],["2:133:16",20,"نَعْبُدُ","We will worship","مِنۢ بَعْدِى قَالُوا۟","إِلَـٰهَكَ وَإِلَـٰهَ ءَابَآئِكَ",97],["2:138:10",21,"عَـٰبِدُونَ","(are) worshippers","صِبْغَةًۭ ۖ وَنَحْنُ لَهُۥ","",766],["2:172:14",26,"تَعْبُدُونَ","worship Him","إِن كُنتُمْ إِيَّاهُ","",97],["2:178:11",27,"وَٱلْعَبْدُ","and the slave","ٱلْقَتْلَى ۖ ٱلْحُرُّ بِٱلْحُرِّ","بِٱلْعَبْدِ وَٱلْأُنثَىٰ بِٱلْأُنثَىٰ ۚ",87],["2:178:12",27,"بِٱلْعَبْدِ","for the slave","ٱلْحُرُّ بِٱلْحُرِّ وَٱلْعَبْدُ","وَٱلْأُنثَىٰ بِٱلْأُنثَىٰ ۚ فَمَنْ",87],["2:186:3",28,"عِبَادِى","My servants","وَإِذَا سَأَلَكَ","عَنِّى فَإِنِّى قَرِيبٌ ۖ",87],["2:207:11",32,"بِٱلْعِبَادِ","to His servants","ٱللَّهِ ۗ وَٱللَّهُ رَءُوفٌۢ","",87],["2:221:18",35,"وَلَعَبْدٌۭ","and a bondman","ٱلْمُشْرِكِينَ حَتَّىٰ يُؤْمِنُوا۟ ۚ","مُّؤْمِنٌ خَيْرٌۭ مِّن",87],["3:15:24",51,"بِٱلْعِبَادِ","of (His) slaves","ٱللَّهِ ۗ وَٱللَّهُ بَصِيرٌۢ","",87],["3:20:26",52,"بِٱلْعِبَادِ","of [His] slaves","ٱلْبَلَـٰغُ ۗ وَٱللَّهُ بَصِيرٌۢ","",87],["3:30:26",54,"بِٱلْعِبَادِ","to (His) [the] slaves","نَفْسَهُۥ ۗ وَٱللَّهُ رَءُوفٌۢ","",87],["3:51:5",56,"فَٱعْبُدُوهُ ۗ","so worship Him","ٱللَّهَ رَبِّى وَرَبُّكُمْ","هَـٰذَا صِرَٰطٌۭ مُّسْتَقِيمٌۭ",97],["3:64:11",58,"نَعْبُدَ","we worship","بَيْنَنَا وَبَيْنَكُمْ أَلَّا","إِلَّا ٱللَّهَ وَلَا",97],["3:79:14",60,"عِبَادًۭا","worshippers","يَقُولَ لِلنَّاسِ كُونُوا۟","لِّى مِن دُونِ",87],["3:182:9",74,"لِّلْعَبِيدِ","to (His) slaves","ٱللَّهَ لَيْسَ بِظَلَّامٍۢ","",87],["4:36:1",84,"۞ وَٱعْبُدُوا۟","And worship","","ٱللَّهَ وَلَا تُشْرِكُوا۟",97],["4:118:6",97,"عِبَادِكَ","your slaves","وَقَالَ لَأَتَّخِذَنَّ مِنْ","نَصِيبًۭا مَّفْرُوضًۭا",87],["4:172:6",105,"عَبْدًۭا","a slave","ٱلْمَسِيحُ أَن يَكُونَ","لِّلَّهِ وَلَا ٱلْمَلَـٰٓئِكَةُ",87],["4:172:14",105,"عِبَادَتِهِۦ","His worship","وَمَن يَسْتَنكِفْ عَنْ","وَيَسْتَكْبِرْ فَسَيَحْشُرُهُمْ إِلَيْهِ",884],["5:60:19",118,"وَعَبَدَ","and (who) worshipped","مِنْهُمُ ٱلْقِرَدَةَ وَٱلْخَنَازِيرَ","ٱلطَّـٰغُوتَ ۚ أُو۟لَـٰٓئِكَ شَرٌّۭ",97],["5:72:15",120,"ٱعْبُدُوا۟","Worship","ٱلْمَسِيحُ يَـٰبَنِىٓ إِسْرَٰٓءِيلَ","ٱللَّهَ رَبِّى وَرَبَّكُمْ ۖ",97],["5:76:2",120,"أَتَعْبُدُونَ","Do you worship","قُلْ","مِن دُونِ ٱللَّهِ",97],["5:117:9",127,"ٱعْبُدُوا۟","You worship","أَمَرْتَنِى بِهِۦٓ أَنِ","ٱللَّهَ رَبِّى وَرَبَّكُمْ ۚ",97],["5:118:4",127,"عِبَادُكَ ۖ","(are) Your slaves","إِن تُعَذِّبْهُمْ فَإِنَّهُمْ","وَإِن تَغْفِرْ لَهُمْ",87],["6:18:4",129,"عِبَادِهِۦ ۚ","His slaves","وَهُوَ ٱلْقَاهِرُ فَوْقَ","وَهُوَ ٱلْحَكِيمُ ٱلْخَبِيرُ",87],["6:56:5",134,"أَعْبُدَ","I worship","إِنِّى نُهِيتُ أَنْ","ٱلَّذِينَ تَدْعُونَ مِن",97],["6:61:4",135,"عِبَادِهِۦ ۖ","His slaves","وَهُوَ ٱلْقَاهِرُ فَوْقَ","وَيُرْسِلُ عَلَيْكُمْ حَفَظَةً",87],["6:88:9",138,"عِبَادِهِۦ ۚ","His slaves","مَن يَشَآءُ مِنْ","وَلَوْ أَشْرَكُوا۟ لَحَبِطَ",87],["6:102:11",141,"فَٱعْبُدُوهُ ۚ","so worship Him","خَـٰلِقُ كُلِّ شَىْءٍۢ","وَهُوَ عَلَىٰ كُلِّ",97],["7:32:8",154,"لِعِبَادِهِۦ","for His slaves","ٱللَّهِ ٱلَّتِىٓ أَخْرَجَ","وَٱلطَّيِّبَـٰتِ مِنَ ٱلرِّزْقِ ۚ",87],["7:59:8",158,"ٱعْبُدُوا۟","Worship","قَوْمِهِۦ فَقَالَ يَـٰقَوْمِ","ٱللَّهَ مَا لَكُم",97],["7:65:7",158,"ٱعْبُدُوا۟","Worship","هُودًۭا ۗ قَالَ يَـٰقَوْمِ","ٱللَّهَ مَا لَكُم",97],["7:70:3",159,"لِنَعْبُدَ","that we (should) worship","قَالُوٓا۟ أَجِئْتَنَا","ٱللَّهَ وَحْدَهُۥ وَنَذَرَ",97],["7:70:9",159,"يَعْبُدُ","worship","وَنَذَرَ مَا كَانَ","ءَابَآؤُنَا ۖ فَأْتِنَا بِمَا",97],["7:73:7",159,"ٱعْبُدُوا۟","Worship","صَـٰلِحًۭا ۗ قَالَ يَـٰقَوْمِ","ٱللَّهَ مَا لَكُم",97],["7:85:7",161,"ٱعْبُدُوا۟","Worship","شُعَيْبًۭا ۗ قَالَ يَـٰقَوْمِ","ٱللَّهَ مَا لَكُم",97],["7:128:14",165,"عِبَادِهِۦ ۖ","His servants","مَن يَشَآءُ مِنْ","وَٱلْعَـٰقِبَةُ لِلْمُتَّقِينَ",87],["7:194:7",175,"عِبَادٌ","(are) slaves","مِن دُونِ ٱللَّهِ","أَمْثَالُكُمْ ۖ فَٱدْعُوهُمْ فَلْيَسْتَجِيبُوا۟",87],["7:206:8",176,"عِبَادَتِهِۦ","His worship","لَا يَسْتَكْبِرُونَ عَنْ","وَيُسَبِّحُونَهُۥ وَلَهُۥ يَسْجُدُونَ ۩",884],["8:41:23",182,"عَبْدِنَا","Our slave","وَمَآ أَنزَلْنَا عَلَىٰ","يَوْمَ ٱلْفُرْقَانِ يَوْمَ",87],["8:51:9",183,"لِّلْعَبِيدِ","to His slaves","ٱللَّهَ لَيْسَ بِظَلَّـٰمٍۢ","",87],["9:31:14",191,"لِيَعْبُدُوٓا۟","that they worship","وَمَآ أُمِرُوٓا۟ إِلَّا","إِلَـٰهًۭا وَٰحِدًۭا ۖ لَّآ",97],["9:104:9",203,"عِبَادِهِۦ","His slaves","يَقْبَلُ ٱلتَّوْبَةَ عَنْ","وَيَأْخُذُ ٱلصَّدَقَـٰتِ وَأَنَّ",87],["9:112:2",205,"ٱلْعَـٰبِدُونَ","those who worship","ٱلتَّـٰٓئِبُونَ","ٱلْحَـٰمِدُونَ ٱلسَّـٰٓئِحُونَ ٱلرَّٰكِعُونَ",766],["10:3:27",208,"فَٱعْبُدُوهُ ۚ","so worship Him","ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ","أَفَلَا تَذَكَّرُونَ",97],["10:18:1",210,"وَيَعْبُدُونَ","And they worship","","مِن دُونِ ٱللَّهِ",97],["10:28:18",212,"تَعْبُدُونَ","worship us","مَّا كُنتُمْ إِيَّانَا","",97],["10:29:9",212,"عِبَادَتِكُمْ","your worship","إِن كُنَّا عَنْ","لَغَـٰفِلِينَ",884],["10:104:11",220,"أَعْبُدُ","I worship","مِّن دِينِى فَلَآ","ٱلَّذِينَ تَعْبُدُونَ مِن",97],["10:104:13",220,"تَعْبُدُونَ","you worship","فَلَآ أَعْبُدُ ٱلَّذِينَ","مِن دُونِ ٱللَّهِ",97],["10:104:18",220,"أَعْبُدُ","I worship","دُونِ ٱللَّهِ وَلَـٰكِنْ","ٱللَّهَ ٱلَّذِى يَتَوَفَّىٰكُمْ ۖ",97],["10:107:21",221,"عِبَادِهِۦ ۚ","His slaves","مَن يَشَآءُ مِنْ","وَهُوَ ٱلْغَفُورُ ٱلرَّحِيمُ",87],["11:2:2",221,"تَعْبُدُوٓا۟","you worship","أَلَّا","إِلَّا ٱللَّهَ ۚ إِنَّنِى",97],["11:26:3",224,"تَعْبُدُوٓا۟","worship","أَن لَّا","إِلَّا ٱللَّهَ ۖ إِنِّىٓ",97],["11:50:7",227,"ٱعْبُدُوا۟","Worship","هُودًۭا ۚ قَالَ يَـٰقَوْمِ","ٱللَّهَ مَا لَكُم",97],["11:61:7",228,"ٱعْبُدُوا۟","Worship","صَـٰلِحًۭا ۚ قَالَ يَـٰقَوْمِ","ٱللَّهَ مَا لَكُم",97],["11:62:11",228,"نَّعْبُدَ","we worship","هَـٰذَآ ۖ أَتَنْهَىٰنَآ أَن","مَا يَعْبُدُ ءَابَآؤُنَا",97],["11:62:13",228,"يَعْبُدُ","our forefathers worshipped","أَن نَّعْبُدَ مَا","ءَابَآؤُنَا وَإِنَّنَا لَفِى",97],["11:84:7",231,"ٱعْبُدُوا۟","Worship","شُعَيْبًۭا ۚ قَالَ يَـٰقَوْمِ","ٱللَّهَ مَا لَكُم",97],["11:87:8",231,"يَعْبُدُ","worship","أَن نَّتْرُكَ مَا","ءَابَآؤُنَآ أَوْ أَن",97],["11:109:6",234,"يَعْبُدُ","worship","فِى مِرْيَةٍۢ مِّمَّا","هَـٰٓؤُلَآءِ ۚ مَا يَعْبُدُونَ",97],["11:109:9",234,"يَعْبُدُونَ","they worship","يَعْبُدُ هَـٰٓؤُلَآءِ ۚ مَا","إِلَّا كَمَا يَعْبُدُ",97],["11:109:12",234,"يَعْبُدُ","worshipped","يَعْبُدُونَ إِلَّا كَمَا","ءَابَآؤُهُم مِّن قَبْلُ ۚ",97],["11:123:9",235,"فَٱعْبُدْهُ","so worship Him","يُرْجَعُ ٱلْأَمْرُ كُلُّهُۥ","وَتَوَكَّلْ عَلَيْهِ ۚ وَمَا",97],["12:24:18",238,"عِبَادِنَا","Our slaves","وَٱلْفَحْشَآءَ ۚ إِنَّهُۥ مِنْ","ٱلْمُخْلَصِينَ",87],["12:40:2",240,"تَعْبُدُونَ","you worship","مَا","مِن دُونِهِۦٓ إِلَّآ",97],["12:40:22",240,"تَعْبُدُوٓا۟","you worship","لِلَّهِ ۚ أَمَرَ أَلَّا","إِلَّآ إِيَّاهُ ۚ ذَٰلِكَ",97],["13:36:17",254,"أَعْبُدَ","I worship","إِنَّمَآ أُمِرْتُ أَنْ","ٱللَّهَ وَلَآ أُشْرِكَ",97],["14:10:29",256,"يَعْبُدُ","worship","تَصُدُّونَا عَمَّا كَانَ","ءَابَآؤُنَا فَأْتُونَا بِسُلْطَـٰنٍۢ",97],["14:11:16",257,"عِبَادِهِۦ ۖ","His slaves","مَن يَشَآءُ مِنْ","وَمَا كَانَ لَنَآ",87],["14:31:2",259,"لِّعِبَادِىَ","to My slaves","قُل","ٱلَّذِينَ ءَامَنُوا۟ يُقِيمُوا۟",87],["14:35:12",260,"نَّعْبُدَ","we worship","وَٱجْنُبْنِى وَبَنِىَّ أَن","ٱلْأَصْنَامَ",97],["15:40:2",264,"عِبَادَكَ","Your slaves","إِلَّا","مِنْهُمُ ٱلْمُخْلَصِينَ",87],["15:42:2",264,"عِبَادِى","My slaves","إِنَّ","لَيْسَ لَكَ عَلَيْهِمْ",87],["15:49:2",264,"عِبَادِىٓ","My slaves","۞ نَبِّئْ","أَنِّىٓ أَنَا ٱلْغَفُورُ",87],["15:99:1",267,"وَٱعْبُدْ","And worship","","رَبَّكَ حَتَّىٰ يَأْتِيَكَ",97],["16:2:10",267,"عِبَادِهِۦٓ","His slaves","مَن يَشَآءُ مِنْ","أَنْ أَنذِرُوٓا۟ أَنَّهُۥ",87],["16:35:8",271,"عَبَدْنَا","we (would) have worshipped","شَآءَ ٱللَّهُ مَا","مِن دُونِهِۦ مِن",97],["16:36:8",271,"ٱعْبُدُوا۟","Worship","أُمَّةٍۢ رَّسُولًا أَنِ","ٱللَّهَ وَٱجْتَنِبُوا۟ ٱلطَّـٰغُوتَ ۖ",97],["16:73:1",275,"وَيَعْبُدُونَ","And they worship","","مِن دُونِ ٱللَّهِ",97],["16:75:4",275,"عَبْدًۭا","(of) a slave","۞ ضَرَبَ ٱللَّهُ مَثَلًا","مَّمْلُوكًۭا لَّا يَقْدِرُ",87],["16:114:13",280,"تَعْبُدُونَ","you worship","إِن كُنتُمْ إِيَّاهُ","",97],["17:1:4",282,"بِعَبْدِهِۦ","His servant","سُبْحَـٰنَ ٱلَّذِىٓ أَسْرَىٰ","لَيْلًۭا مِّنَ ٱلْمَسْجِدِ",87],["17:3:8",282,"عَبْدًۭا","a servant","نُوحٍ ۚ إِنَّهُۥ كَانَ","شَكُورًۭا",87],["17:5:7",282,"عِبَادًۭا","servants","أُولَىٰهُمَا بَعَثْنَا عَلَيْكُمْ","لَّنَآ أُو۟لِى بَأْسٍۢ",87],["17:17:11",283,"عِبَادِهِۦ","(of) His servants","وَكَفَىٰ بِرَبِّكَ بِذُنُوبِ","خَبِيرًۢا بَصِيرًۭا",87],["17:23:4",284,"تَعْبُدُوٓا۟","worship","۞ وَقَضَىٰ رَبُّكَ أَلَّا","إِلَّآ إِيَّاهُ وَبِٱلْوَٰلِدَيْنِ",97],["17:30:10",285,"بِعِبَادِهِۦ","of His slaves","وَيَقْدِرُ ۚ إِنَّهُۥ كَانَ","خَبِيرًۢا بَصِيرًۭا",87],["17:53:2",287,"لِّعِبَادِى","to My slaves","وَقُل","يَقُولُوا۟ ٱلَّتِى هِىَ",87],["17:65:2",288,"عِبَادِى","My slaves","إِنَّ","لَيْسَ لَكَ عَلَيْهِمْ",87],["17:96:9",291,"بِعِبَادِهِۦ","of His slaves","وَبَيْنَكُمْ ۚ إِنَّهُۥ كَانَ","خَبِيرًۢا بَصِيرًۭا",87],["18:1:6",293,"عَبْدِهِ","His slave","ٱلَّذِىٓ أَنزَلَ عَلَىٰ","ٱلْكِتَـٰبَ وَلَمْ يَجْعَل",87],["18:16:4",295,"يَعْبُدُونَ","they worship","وَإِذِ ٱعْتَزَلْتُمُوهُمْ وَمَا","إِلَّا ٱللَّهَ فَأْوُۥٓا۟",97],["18:65:2",301,"عَبْدًۭا","a servant","فَوَجَدَا","مِّنْ عِبَادِنَآ ءَاتَيْنَـٰهُ",87],["18:65:4",301,"عِبَادِنَآ","Our servants","فَوَجَدَا عَبْدًۭا مِّنْ","ءَاتَيْنَـٰهُ رَحْمَةًۭ مِّنْ",87],["18:102:6",304,"عِبَادِى","My servants","كَفَرُوٓا۟ أَن يَتَّخِذُوا۟","مِن دُونِىٓ أَوْلِيَآءَ ۚ",87],["18:110:22",304,"بِعِبَادَةِ","in (the) worship","صَـٰلِحًۭا وَلَا يُشْرِكْ","رَبِّهِۦٓ أَحَدًۢا",884],["19:2:4",305,"عَبْدَهُۥ","(to) His servant","ذِكْرُ رَحْمَتِ رَبِّكَ","زَكَرِيَّآ",87],["19:30:3",307,"عَبْدُ","a slave","قَالَ إِنِّى","ٱللَّهِ ءَاتَىٰنِىَ ٱلْكِتَـٰبَ",87],["19:36:5",307,"فَٱعْبُدُوهُ ۚ","so worship Him","ٱللَّهَ رَبِّى وَرَبُّكُمْ","هَـٰذَا صِرَٰطٌۭ مُّسْتَقِيمٌۭ",97],["19:42:6",308,"تَعْبُدُ","(do) you worship","لِأَبِيهِ يَـٰٓأَبَتِ لِمَ","مَا لَا يَسْمَعُ",97],["19:44:3",308,"تَعْبُدِ","worship","يَـٰٓأَبَتِ لَا","ٱلشَّيْطَـٰنَ ۖ إِنَّ ٱلشَّيْطَـٰنَ",97],["19:49:4",308,"يَعْبُدُونَ","they worshipped","فَلَمَّا ٱعْتَزَلَهُمْ وَمَا","مِن دُونِ ٱللَّهِ",97],["19:61:6",309,"عِبَادَهُۥ","(to) His slaves","ٱلَّتِى وَعَدَ ٱلرَّحْمَـٰنُ","بِٱلْغَيْبِ ۚ إِنَّهُۥ كَانَ",87],["19:63:6",309,"عِبَادِنَا","Our slaves","ٱلَّتِى نُورِثُ مِنْ","مَن كَانَ تَقِيًّۭا",87],["19:65:6",310,"فَٱعْبُدْهُ","so worship Him","وَٱلْأَرْضِ وَمَا بَيْنَهُمَا","وَٱصْطَبِرْ لِعِبَـٰدَتِهِۦ ۚ هَلْ",97],["19:65:8",310,"لِعِبَـٰدَتِهِۦ ۚ","in His worship","بَيْنَهُمَا فَٱعْبُدْهُ وَٱصْطَبِرْ","هَلْ تَعْلَمُ لَهُۥ",884],["19:82:3",311,"بِعِبَادَتِهِمْ","their worship (of them)","كَلَّا ۚ سَيَكْفُرُونَ","وَيَكُونُونَ عَلَيْهِمْ ضِدًّا",884],["19:93:10",311,"عَبْدًۭا","(as) a slave","إِلَّآ ءَاتِى ٱلرَّحْمَـٰنِ","",87],["20:14:8",313,"فَٱعْبُدْنِى","so worship Me","إِلَـٰهَ إِلَّآ أَنَا۠","وَأَقِمِ ٱلصَّلَوٰةَ لِذِكْرِىٓ",97],["20:77:7",317,"بِعِبَادِى","with My slaves","مُوسَىٰٓ أَنْ أَسْرِ","فَٱضْرِبْ لَهُمْ طَرِيقًۭا",87],["21:19:11",323,"عِبَادَتِهِۦ","worship Him","لَا يَسْتَكْبِرُونَ عَنْ","وَلَا يَسْتَحْسِرُونَ",884],["21:25:15",324,"فَٱعْبُدُونِ","so worship Me","إِلَـٰهَ إِلَّآ أَنَا۠","",97],["21:26:7",324,"عِبَادٌۭ","(they are) slaves","وَلَدًۭا ۗ سُبْحَـٰنَهُۥ ۚ بَلْ","مُّكْرَمُونَ",87],["21:53:5",326,"عَـٰبِدِينَ","worshippers","وَجَدْنَآ ءَابَآءَنَا لَهَا","",766],["21:66:2",327,"أَفَتَعْبُدُونَ","Then do you worship","قَالَ","مِن دُونِ ٱللَّهِ",97],["21:67:4",327,"تَعْبُدُونَ","you worship","أُفٍّۢ لَّكُمْ وَلِمَا","مِن دُونِ ٱللَّهِ ۖ",97],["21:73:15",328,"عَـٰبِدِينَ","worshippers","ٱلزَّكَوٰةِ ۖ وَكَانُوا۟ لَنَا","",766],["21:84:16",329,"لِلْعَـٰبِدِينَ","for the worshippers","مِّنْ عِندِنَا وَذِكْرَىٰ","",766],["21:92:8",330,"فَٱعْبُدُونِ","so worship Me","وَٰحِدَةًۭ وَأَنَا۠ رَبُّكُمْ","",97],["21:98:3",330,"تَعْبُدُونَ","you worship","إِنَّكُمْ وَمَا","مِن دُونِ ٱللَّهِ",97],["21:105:11",331,"عِبَادِىَ","My slaves","أَنَّ ٱلْأَرْضَ يَرِثُهَا","ٱلصَّـٰلِحُونَ",87],["21:106:6",331,"عَـٰبِدِينَ","worshippers","هَـٰذَا لَبَلَـٰغًۭا لِّقَوْمٍ","",766],["22:10:9",333,"لِّلْعَبِيدِ","to His slaves","ٱللَّهَ لَيْسَ بِظَلَّـٰمٍۢ","",87],["22:11:4",333,"يَعْبُدُ","worships","وَمِنَ ٱلنَّاسِ مَن","ٱللَّهَ عَلَىٰ حَرْفٍۢ ۖ",97],["22:71:1",340,"وَيَعْبُدُونَ","And they worship","","مِن دُونِ ٱللَّهِ",97],["22:77:6",341,"وَٱعْبُدُوا۟","and worship","ءَامَنُوا۟ ٱرْكَعُوا۟ وَٱسْجُدُوا۟","رَبَّكُمْ وَٱفْعَلُوا۟ ٱلْخَيْرَ",97],["23:23:8",343,"ٱعْبُدُوا۟","Worship","قَوْمِهِۦ فَقَالَ يَـٰقَوْمِ","ٱللَّهَ مَا لَكُم",97],["23:32:6",344,"ٱعْبُدُوا۟","Worship","رَسُولًۭا مِّنْهُمْ أَنِ","ٱللَّهَ مَا لَكُم",97],["23:47:7",345,"عَـٰبِدُونَ","(are) slaves","مِثْلِنَا وَقَوْمُهُمَا لَنَا","",766],["23:109:5",349,"عِبَادِى","My slaves","كَانَ فَرِيقٌۭ مِّنْ","يَقُولُونَ رَبَّنَآ ءَامَنَّا",87],["24:32:6",354,"عِبَادِكُمْ","your male slaves","مِنكُمْ وَٱلصَّـٰلِحِينَ مِنْ","وَإِمَآئِكُمْ ۚ إِن يَكُونُوا۟",87],["24:55:27",357,"يَعْبُدُونَنِى","(for) they worship Me","بَعْدِ خَوْفِهِمْ أَمْنًۭا ۚ","لَا يُشْرِكُونَ بِى",97],["25:1:6",359,"عَبْدِهِۦ","His slave","نَزَّلَ ٱلْفُرْقَانَ عَلَىٰ","لِيَكُونَ لِلْعَـٰلَمِينَ نَذِيرًا",87],["25:17:4",361,"يَعْبُدُونَ","they worship","وَيَوْمَ يَحْشُرُهُمْ وَمَا","مِن دُونِ ٱللَّهِ",97],["25:17:11",361,"عِبَادِى","My slaves","فَيَقُولُ ءَأَنتُمْ أَضْلَلْتُمْ","هَـٰٓؤُلَآءِ أَمْ هُمْ",87],["25:55:1",364,"وَيَعْبُدُونَ","But they worship","","مِن دُونِ ٱللَّهِ",97],["25:58:12",365,"عِبَادِهِۦ","(of) His slaves","وَكَفَىٰ بِهِۦ بِذُنُوبِ","خَبِيرًا",87],["25:63:1",365,"وَعِبَادُ","And (the) slaves","","ٱلرَّحْمَـٰنِ ٱلَّذِينَ يَمْشُونَ",87],["26:22:6",368,"عَبَّدتَّ","you have enslaved","تَمُنُّهَا عَلَىَّ أَنْ","بَنِىٓ إِسْرَٰٓءِيلَ",3108],["26:52:6",369,"بِعِبَادِىٓ","with My slaves","مُوسَىٰٓ أَنْ أَسْرِ","إِنَّكُم مُّتَّبَعُونَ",87],["26:70:6",370,"تَعْبُدُونَ","(do) you worship","لِأَبِيهِ وَقَوْمِهِۦ مَا","",97],["26:71:2",370,"نَعْبُدُ","We worship","قَالُوا۟","أَصْنَامًۭا فَنَظَلُّ لَهَا",97],["26:75:5",370,"تَعْبُدُونَ","worshipping","أَفَرَءَيْتُم مَّا كُنتُمْ","",97],["26:92:6",371,"تَعْبُدُونَ","(to) worship","أَيْنَ مَا كُنتُمْ","",97],["27:15:14",378,"عِبَادِهِ","His servants","عَلَىٰ كَثِيرٍۢ مِّنْ","ٱلْمُؤْمِنِينَ",87],["27:19:23",378,"عِبَادِكَ","Your slaves","وَأَدْخِلْنِى بِرَحْمَتِكَ فِى","ٱلصَّـٰلِحِينَ",87],["27:43:4",380,"تَّعْبُدُ","worship","وَصَدَّهَا مَا كَانَت","مِن دُونِ ٱللَّهِ ۖ",97],["27:45:8",381,"ٱعْبُدُوا۟","Worship","أَخَاهُمْ صَـٰلِحًا أَنِ","ٱللَّهَ فَإِذَا هُمْ",97],["27:59:6",382,"عِبَادِهِ","His slaves","لِلَّهِ وَسَلَـٰمٌ عَلَىٰ","ٱلَّذِينَ ٱصْطَفَىٰٓ ۗ ءَآللَّهُ",87],["27:91:4",385,"أَعْبُدَ","I worship","إِنَّمَآ أُمِرْتُ أَنْ","رَبَّ هَـٰذِهِ ٱلْبَلْدَةِ",97],["28:63:18",393,"يَعْبُدُونَ","worship us","مَا كَانُوٓا۟ إِيَّانَا","",97],["28:82:14",395,"عِبَادِهِۦ","His slaves","لِمَن يَشَآءُ مِنْ","وَيَقْدِرُ ۖ لَوْلَآ أَن",87],["29:16:5",398,"ٱعْبُدُوا۟","Worship","إِذْ قَالَ لِقَوْمِهِ","ٱللَّهَ وَٱتَّقُوهُ ۖ ذَٰلِكُمْ",97],["29:17:2",398,"تَعْبُدُونَ","you worship","إِنَّمَا","مِن دُونِ ٱللَّهِ",97],["29:17:11",398,"تَعْبُدُونَ","you worship","إِفْكًا ۚ إِنَّ ٱلَّذِينَ","مِن دُونِ ٱللَّهِ",97],["29:17:23",398,"وَٱعْبُدُوهُ","and worship Him","عِندَ ٱللَّهِ ٱلرِّزْقَ","وَٱشْكُرُوا۟ لَهُۥٓ ۖ إِلَيْهِ",97],["29:36:7",400,"ٱعْبُدُوا۟","Worship","شُعَيْبًۭا فَقَالَ يَـٰقَوْمِ","ٱللَّهَ وَٱرْجُوا۟ ٱلْيَوْمَ",97],["29:56:1",403,"يَـٰعِبَادِىَ","O My servants","","ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّ",87],["29:56:8",403,"فَٱعْبُدُونِ","worship Me","أَرْضِى وَٰسِعَةٌۭ فَإِيَّـٰىَ","",97],["29:62:7",403,"عِبَادِهِۦ","His slaves","لِمَن يَشَآءُ مِنْ","وَيَقْدِرُ لَهُۥٓ ۚ إِنَّ",87],["30:48:25",409,"عِبَادِهِۦٓ","His slaves","مَن يَشَآءُ مِنْ","إِذَا هُمْ يَسْتَبْشِرُونَ",87],["34:9:28",429,"عَبْدٍۢ","slave","ذَٰلِكَ لَـَٔايَةًۭ لِّكُلِّ","مُّنِيبٍۢ",87],["34:13:18",429,"عِبَادِىَ","My slaves","شُكْرًۭا ۚ وَقَلِيلٌۭ مِّنْ","ٱلشَّكُورُ",87],["34:39:9",432,"عِبَادِهِۦ","His slaves","لِمَن يَشَآءُ مِنْ","وَيَقْدِرُ لَهُۥ ۚ وَمَآ",87],["34:40:10",433,"يَعْبُدُونَ","worshipping","أَهَـٰٓؤُلَآءِ إِيَّاكُمْ كَانُوا۟","",97],["34:41:9",433,"يَعْبُدُونَ","(to) worship","دُونِهِم ۖ بَلْ كَانُوا۟","ٱلْجِنَّ ۖ أَكْثَرُهُم بِهِم",97],["34:43:16",433,"يَعْبُدُ","(to) worship","يَصُدَّكُمْ عَمَّا كَانَ","ءَابَآؤُكُمْ وَقَالُوا۟ مَا",97],["35:28:12",437,"عِبَادِهِ","His slaves","يَخْشَى ٱللَّهَ مِنْ","ٱلْعُلَمَـٰٓؤُا۟ ۗ إِنَّ ٱللَّهَ",87],["35:31:14",438,"بِعِبَادِهِۦ","of His slaves","يَدَيْهِ ۗ إِنَّ ٱللَّهَ","لَخَبِيرٌۢ بَصِيرٌۭ",87],["35:32:7",438,"عِبَادِنَا ۖ","Our slaves","ٱلَّذِينَ ٱصْطَفَيْنَا مِنْ","فَمِنْهُمْ ظَالِمٌۭ لِّنَفْسِهِۦ",87],["35:45:24",440,"بِعِبَادِهِۦ","of His slaves","فَإِنَّ ٱللَّهَ كَانَ","بَصِيرًۢا",87],["36:22:4",441,"أَعْبُدُ","I worship","وَمَا لِىَ لَآ","ٱلَّذِى فَطَرَنِى وَإِلَيْهِ",97],["36:30:3",442,"ٱلْعِبَادِ ۚ","the servants","يَـٰحَسْرَةً عَلَى","مَا يَأْتِيهِم مِّن",87],["36:60:8",444,"تَعْبُدُوا۟","worship","ءَادَمَ أَن لَّا","ٱلشَّيْطَـٰنَ ۖ إِنَّهُۥ لَكُمْ",97],["36:61:2",444,"ٱعْبُدُونِى ۚ","you worship Me","وَأَنِ","هَـٰذَا صِرَٰطٌۭ مُّسْتَقِيمٌۭ",97],["37:22:7",446,"يَعْبُدُونَ","worship","وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟","",97],["37:40:2",447,"عِبَادَ","(the) slaves","إِلَّا","ٱللَّهِ ٱلْمُخْلَصِينَ",87],["37:74:2",448,"عِبَادَ","(the) slaves","إِلَّا","ٱللَّهِ ٱلْمُخْلَصِينَ",87],["37:81:3",449,"عِبَادِنَا","Our slaves","إِنَّهُۥ مِنْ","ٱلْمُؤْمِنِينَ",87],["37:85:6",449,"تَعْبُدُونَ","you worship","لِأَبِيهِ وَقَوْمِهِۦ مَاذَا","",97],["37:95:2",449,"أَتَعْبُدُونَ","Do you worship","قَالَ","مَا تَنْحِتُونَ",97],["37:111:3",450,"عِبَادِنَا","Our slaves","إِنَّهُۥ مِنْ","ٱلْمُؤْمِنِينَ",87],["37:122:3",450,"عِبَادِنَا","Our slaves","إِنَّهُمَا مِنْ","ٱلْمُؤْمِنِينَ",87],["37:128:2",451,"عِبَادَ","(the) slaves","إِلَّا","ٱللَّهِ ٱلْمُخْلَصِينَ",87],["37:132:3",451,"عِبَادِنَا","Our slaves","إِنَّهُۥ مِنْ","ٱلْمُؤْمِنِينَ",87],["37:160:2",452,"عِبَادَ","(the) slaves","إِلَّا","ٱللَّهِ ٱلْمُخْلَصِينَ",87],["37:161:3",452,"تَعْبُدُونَ","you worship","فَإِنَّكُمْ وَمَا","",97],["37:169:2",452,"عِبَادَ","slaves","لَكُنَّا","ٱللَّهِ ٱلْمُخْلَصِينَ",87],["37:171:4",452,"لِعِبَادِنَا","for Our slaves","وَلَقَدْ سَبَقَتْ كَلِمَتُنَا","ٱلْمُرْسَلِينَ",87],["38:17:6",454,"عَبْدَنَا","Our slave","مَا يَقُولُونَ وَٱذْكُرْ","دَاوُۥدَ ذَا ٱلْأَيْدِ ۖ",87],["38:30:5",455,"ٱلْعَبْدُ ۖ","slave","لِدَاوُۥدَ سُلَيْمَـٰنَ ۚ نِعْمَ","إِنَّهُۥٓ أَوَّابٌ",87],["38:41:2",455,"عَبْدَنَآ","Our slave","وَٱذْكُرْ","أَيُّوبَ إِذْ نَادَىٰ",87],["38:44:12",456,"ٱلْعَبْدُ ۖ","slave","وَجَدْنَـٰهُ صَابِرًۭا ۚ نِّعْمَ","إِنَّهُۥٓ أَوَّابٌۭ",87],["38:45:2",456,"عِبَـٰدَنَآ","Our slaves","وَٱذْكُرْ","إِبْرَٰهِيمَ وَإِسْحَـٰقَ وَيَعْقُوبَ",87],["38:83:2",457,"عِبَادَكَ","Your slaves","إِلَّا","مِنْهُمُ ٱلْمُخْلَصِينَ",87],["39:2:6",458,"فَٱعْبُدِ","so worship","إِلَيْكَ ٱلْكِتَـٰبَ بِٱلْحَقِّ","ٱللَّهَ مُخْلِصًۭا لَّهُ",97],["39:3:11",458,"نَعْبُدُهُمْ","we worship them","دُونِهِۦٓ أَوْلِيَآءَ مَا","إِلَّا لِيُقَرِّبُونَآ إِلَى",97],["39:7:9",459,"لِعِبَادِهِ","in His slaves","عَنكُمْ ۖ وَلَا يَرْضَىٰ","ٱلْكُفْرَ ۖ وَإِن تَشْكُرُوا۟",87],["39:10:2",459,"يَـٰعِبَادِ","O My slaves","قُلْ","ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟",87],["39:11:5",460,"أَعْبُدَ","I worship","إِنِّىٓ أُمِرْتُ أَنْ","ٱللَّهَ مُخْلِصًۭا لَّهُ",97],["39:14:3",460,"أَعْبُدُ","I worship Allah","قُلِ ٱللَّهَ","مُخْلِصًۭا لَّهُۥ دِينِى",97],["39:15:1",460,"فَٱعْبُدُوا۟","So worship","","مَا شِئْتُم مِّن",97],["39:16:14",460,"عِبَادَهُۥ ۚ","His slaves","يُخَوِّفُ ٱللَّهُ بِهِۦ","يَـٰعِبَادِ فَٱتَّقُونِ",87],["39:16:15",460,"يَـٰعِبَادِ","O My slaves","ٱللَّهُ بِهِۦ عِبَادَهُۥ ۚ","فَٱتَّقُونِ",87],["39:17:5",460,"يَعْبُدُوهَا","they worship them","ٱجْتَنَبُوا۟ ٱلطَّـٰغُوتَ أَن","وَأَنَابُوٓا۟ إِلَى ٱللَّهِ",97],["39:17:12",460,"عِبَادِ","(to) My slaves","لَهُمُ ٱلْبُشْرَىٰ ۚ فَبَشِّرْ","",87],["39:36:4",462,"عَبْدَهُۥ ۖ","(for) His slave","أَلَيْسَ ٱللَّهُ بِكَافٍ","وَيُخَوِّفُونَكَ بِٱلَّذِينَ مِن",87],["39:46:12",463,"عِبَادِكَ","Your slaves","أَنتَ تَحْكُمُ بَيْنَ","فِى مَا كَانُوا۟",87],["39:53:2",464,"يَـٰعِبَادِىَ","O My slaves","۞ قُلْ","ٱلَّذِينَ أَسْرَفُوا۟ عَلَىٰٓ",87],["39:64:5",465,"أَعْبُدُ","(to) worship","أَفَغَيْرَ ٱللَّهِ تَأْمُرُوٓنِّىٓ","أَيُّهَا ٱلْجَـٰهِلُونَ",97],["39:66:3",465,"فَٱعْبُدْ","But worship Allah","بَلِ ٱللَّهَ","وَكُن مِّنَ ٱلشَّـٰكِرِينَ",97],["40:15:13",468,"عِبَادِهِۦ","His slaves","مَن يَشَآءُ مِنْ","لِيُنذِرَ يَوْمَ ٱلتَّلَاقِ",87],["40:31:14",470,"لِّلْعِبَادِ","for (His) slaves","ٱللَّهُ يُرِيدُ ظُلْمًۭا","",87],["40:44:12",472,"بِٱلْعِبَادِ","of (His) slaves","إِنَّ ٱللَّهَ بَصِيرٌۢ","",87],["40:48:12",472,"ٱلْعِبَادِ","(His) slaves","قَدْ حَكَمَ بَيْنَ","",87],["40:60:10",474,"عِبَادَتِى","worship Me","ٱلَّذِينَ يَسْتَكْبِرُونَ عَنْ","سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ",884],["40:66:5",474,"أَعْبُدَ","worship","إِنِّى نُهِيتُ أَنْ","ٱلَّذِينَ تَدْعُونَ مِن",97],["40:85:14",476,"عِبَادِهِۦ ۖ","His slaves","قَدْ خَلَتْ فِى","وَخَسِرَ هُنَالِكَ ٱلْكَـٰفِرُونَ",87],["41:14:10",478,"تَعْبُدُوٓا۟","worship","وَمِنْ خَلْفِهِمْ أَلَّا","إِلَّا ٱللَّهَ ۖ قَالُوا۟",97],["41:37:19",480,"تَعْبُدُونَ","worship","إِن كُنتُمْ إِيَّاهُ","",97],["41:46:11",481,"لِّلْعَبِيدِ","to His slaves","وَمَا رَبُّكَ بِظَلَّـٰمٍۢ","",87],["42:19:3",485,"بِعِبَادِهِۦ","with His slaves","ٱللَّهُ لَطِيفٌۢ","يَرْزُقُ مَن يَشَآءُ ۖ",87],["42:23:5",486,"عِبَادَهُ","(to) His slaves","ٱلَّذِى يُبَشِّرُ ٱللَّهُ","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟",87],["42:25:6",486,"عِبَادِهِۦ","His slaves","يَقْبَلُ ٱلتَّوْبَةَ عَنْ","وَيَعْفُوا۟ عَنِ ٱلسَّيِّـَٔاتِ",87],["42:27:5",486,"لِعِبَادِهِۦ","for His slaves","بَسَطَ ٱللَّهُ ٱلرِّزْقَ","لَبَغَوْا۟ فِى ٱلْأَرْضِ",87],["42:27:15",486,"بِعِبَادِهِۦ","of His slaves","مَّا يَشَآءُ ۚ إِنَّهُۥ","خَبِيرٌۢ بَصِيرٌۭ",87],["42:52:22",489,"عِبَادِنَا ۚ","Our slaves","مَن نَّشَآءُ مِنْ","وَإِنَّكَ لَتَهْدِىٓ إِلَىٰ",87],["43:15:4",490,"عِبَادِهِۦ","His slaves","وَجَعَلُوا۟ لَهُۥ مِنْ","جُزْءًا ۚ إِنَّ ٱلْإِنسَـٰنَ",87],["43:19:5",490,"عِبَـٰدُ","(are) slaves","ٱلْمَلَـٰٓئِكَةَ ٱلَّذِينَ هُمْ","ٱلرَّحْمَـٰنِ إِنَـٰثًا ۚ أَشَهِدُوا۟",87],["43:20:6",490,"عَبَدْنَـٰهُم ۗ","we would not have worshipped them","شَآءَ ٱلرَّحْمَـٰنُ مَا","مَّا لَهُم بِذَٰلِكَ",97],["43:26:9",491,"تَعْبُدُونَ","you worship","إِنَّنِى بَرَآءٌۭ مِّمَّا","",97],["43:45:13",492,"يُعْبَدُونَ","to be worshipped","دُونِ ٱلرَّحْمَـٰنِ ءَالِهَةًۭ","",97],["43:59:4",493,"عَبْدٌ","a slave","إِنْ هُوَ إِلَّا","أَنْعَمْنَا عَلَيْهِ وَجَعَلْنَـٰهُ",87],["43:64:6",494,"فَٱعْبُدُوهُ ۚ","so worship Him","هُوَ رَبِّى وَرَبُّكُمْ","هَـٰذَا صِرَٰطٌۭ مُّسْتَقِيمٌۭ",97],["43:68:1",494,"يَـٰعِبَادِ","O My slaves","","لَا خَوْفٌ عَلَيْكُمُ",87],["43:81:8",495,"ٱلْعَـٰبِدِينَ","(of) the worshippers","وَلَدٌۭ فَأَنَا۠ أَوَّلُ","",766],["44:18:4",496,"عِبَادَ","(the) servants","أَنْ أَدُّوٓا۟ إِلَىَّ","ٱللَّهِ ۖ إِنِّى لَكُمْ",87],["44:23:2",497,"بِعِبَادِى","with My slaves","فَأَسْرِ","لَيْلًا إِنَّكُم مُّتَّبَعُونَ",87],["46:6:8",503,"بِعِبَادَتِهِمْ","of their worship","لَهُمْ أَعْدَآءًۭ وَكَانُوا۟","كَـٰفِرِينَ",884],["46:21:17",505,"تَعْبُدُوٓا۟","you worship","وَمِنْ خَلْفِهِۦٓ أَلَّا","إِلَّا ٱللَّهَ إِنِّىٓ",97],["50:8:4",518,"عَبْدٍۢ","slave","تَبْصِرَةًۭ وَذِكْرَىٰ لِكُلِّ","مُّنِيبٍۢ",87],["50:11:2",518,"لِّلْعِبَادِ ۖ","for the slaves","رِّزْقًۭا","وَأَحْيَيْنَا بِهِۦ بَلْدَةًۭ",87],["50:29:8",519,"لِّلْعَبِيدِ","to My slaves","وَمَآ أَنَا۠ بِظَلَّـٰمٍۢ","",87],["51:56:6",523,"لِيَعْبُدُونِ","that they worship Me","ٱلْجِنَّ وَٱلْإِنسَ إِلَّا","",97],["53:10:3",526,"عَبْدِهِۦ","His slave","فَأَوْحَىٰٓ إِلَىٰ","مَآ أَوْحَىٰ",87],["53:62:3",528,"وَٱعْبُدُوا۟ ۩","and worship (Him)","فَٱسْجُدُوا۟ لِلَّهِ","",97],["54:9:6",529,"عَبْدَنَا","Our slave","قَوْمُ نُوحٍۢ فَكَذَّبُوا۟","وَقَالُوا۟ مَجْنُونٌۭ وَٱزْدُجِرَ",87],["57:9:5",538,"عَبْدِهِۦٓ","His slave","ٱلَّذِى يُنَزِّلُ عَلَىٰ","ءَايَـٰتٍۭ بَيِّنَـٰتٍۢ لِّيُخْرِجَكُم",87],["60:4:17",549,"تَعْبُدُونَ","you worship","بُرَءَٰٓؤُا۟ مِنكُمْ وَمِمَّا","مِن دُونِ ٱللَّهِ",97],["66:5:14",560,"عَـٰبِدَٰتٍۢ","who worship","مُّؤْمِنَـٰتٍۢ قَـٰنِتَـٰتٍۢ تَـٰٓئِبَـٰتٍ","سَـٰٓئِحَـٰتٍۢ ثَيِّبَـٰتٍۢ وَأَبْكَارًۭا",3103],["66:10:12",561,"عَبْدَيْنِ","two [slaves]","لُوطٍۢ ۖ كَانَتَا تَحْتَ","مِنْ عِبَادِنَا صَـٰلِحَيْنِ",87],["66:10:14",561,"عِبَادِنَا","Our slaves","تَحْتَ عَبْدَيْنِ مِنْ","صَـٰلِحَيْنِ فَخَانَتَاهُمَا فَلَمْ",87],["71:3:2",570,"ٱعْبُدُوا۟","Worship","أَنِ","ٱللَّهَ وَٱتَّقُوهُ وَأَطِيعُونِ",97],["71:27:5",571,"عِبَادَكَ","Your slaves","إِن تَذَرْهُمْ يُضِلُّوا۟","وَلَا يَلِدُوٓا۟ إِلَّا",87],["72:19:4",573,"عَبْدُ","(the) slave","وَأَنَّهُۥ لَمَّا قَامَ","ٱللَّهِ يَدْعُوهُ كَادُوا۟",87],["76:6:4",579,"عِبَادُ","(the) slaves","عَيْنًۭا يَشْرَبُ بِهَا","ٱللَّهِ يُفَجِّرُونَهَا تَفْجِيرًۭا",87],["89:29:3",594,"عِبَـٰدِى","My slaves","فَٱدْخُلِى فِى","",87],["96:10:1",597,"عَبْدًا","A slave","","إِذَا صَلَّىٰٓ",87],["98:5:4",598,"لِيَعْبُدُوا۟","to worship","وَمَآ أُمِرُوٓا۟ إِلَّا","ٱللَّهَ مُخْلِصِينَ لَهُ",97],["106:3:1",602,"فَلْيَعْبُدُوا۟","So let them worship","","رَبَّ هَـٰذَا ٱلْبَيْتِ",97],["109:2:2",603,"أَعْبُدُ","I worship","لَآ","مَا تَعْبُدُونَ",97],["109:2:4",603,"تَعْبُدُونَ","you worship","لَآ أَعْبُدُ مَا","",97],["109:3:3",603,"عَـٰبِدُونَ","(are) worshippers","وَلَآ أَنتُمْ","مَآ أَعْبُدُ",766],["109:3:5",603,"أَعْبُدُ","I worship","أَنتُمْ عَـٰبِدُونَ مَآ","",97],["109:4:3",603,"عَابِدٌۭ","a worshipper","وَلَآ أَنَا۠","مَّا عَبَدتُّمْ",766],["109:4:5",603,"عَبَدتُّمْ","you worship","أَنَا۠ عَابِدٌۭ مَّا","",97],["109:5:3",603,"عَـٰبِدُونَ","(are) worshippers","وَلَآ أَنتُمْ","مَآ أَعْبُدُ",766],["109:5:5",603,"أَعْبُدُ","I worship","أَنتُمْ عَـٰبِدُونَ مَآ","",97]]