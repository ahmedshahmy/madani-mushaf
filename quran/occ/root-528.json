[["21:63:9",327,"يَنطِقُونَ","speak","فَسْـَٔلُوهُمْ إِن كَانُوا۟","",936],["21:65:9",327,"يَنطِقُونَ","(can) speak","عَلِمْتَ مَا هَـٰٓؤُلَآءِ","",936],["23:62:8",346,"يَنطِقُ","(which) speaks","وُسْعَهَا ۖ وَلَدَيْنَا كِتَـٰبٌۭ","بِٱلْحَقِّ ۚ وَهُمْ لَا",936],["27:16:8",378,"مَنطِقَ","(the) language","يَـٰٓأَيُّهَا ٱلنَّاسُ عُلِّمْنَا","ٱلطَّيْرِ وَأُوتِينَا مِن",3684],["27:85:8",384,"يَنطِقُونَ","speak","ظَلَمُوا۟ فَهُمْ لَا","",936],["37:92:4",449,"تَنطِقُونَ","you speak","مَا لَكُمْ لَا","",936],["41:21:7",479,"أَنطَقَنَا","Allah made us speak","شَهِدتُّمْ عَلَيْنَا ۖ قَالُوٓا۟","ٱللَّهُ ٱلَّذِىٓ أَنطَقَ",2181],["41:21:10",479,"أَنطَقَ","makes speak","أَنطَقَنَا ٱللَّهُ ٱلَّذِىٓ","كُلَّ شَىْءٍۢ وَهُوَ",2181],["45:29:3",501,"يَنطِقُ","speaks","هَـٰذَا كِتَـٰبُنَا","عَلَيْكُم بِٱلْحَقِّ ۚ إِنَّا",936],["51:23:9",521,"تَنطِقُونَ","speak","مِّثْلَ مَآ أَنَّكُمْ","",936],["53:3:2",526,"يَنطِقُ","he speaks","وَمَا","عَنِ ٱلْهَوَىٰٓ",936],["77:35:4",581,"يَنطِقُونَ","they will speak","هَـٰذَا يَوْمُ لَا","",936]]