[["5:3:32",107,"يَئِسَ","(have) despaired","ذَٰلِكُمْ فِسْقٌ ۗ ٱلْيَوْمَ","ٱلَّذِينَ كَفَرُوا۟ مِن",1018],["11:9:10",222,"لَيَـُٔوسٌۭ","(is) despairing","نَزَعْنَـٰهَا مِنْهُ إِنَّهُۥ","كَفُورٌۭ",2052],["12:80:2",245,"ٱسْتَيْـَٔسُوا۟","they despaired","فَلَمَّا","مِنْهُ خَلَصُوا۟ نَجِيًّۭا ۖ",2851],["12:87:8",246,"تَا۟يْـَٔسُوا۟","despair","يُوسُفَ وَأَخِيهِ وَلَا","مِن رَّوْحِ ٱللَّهِ ۖ",1018],["12:87:14",246,"يَا۟يْـَٔسُ","despairs","ٱللَّهِ ۖ إِنَّهُۥ لَا","مِن رَّوْحِ ٱللَّهِ",1018],["12:110:3",248,"ٱسْتَيْـَٔسَ","gave up hope","حَتَّىٰٓ إِذَا","ٱلرُّسُلُ وَظَنُّوٓا۟ أَنَّهُمْ",2851],["13:31:20",253,"يَا۟يْـَٔسِ","know","ٱلْأَمْرُ جَمِيعًا ۗ أَفَلَمْ","ٱلَّذِينَ ءَامَنُوٓا۟ أَن",1018],["17:83:12",290,"يَـُٔوسًۭا","(in) despair","مَسَّهُ ٱلشَّرُّ كَانَ","",2052],["29:23:7",398,"يَئِسُوا۟","(have) despaired","ٱللَّهِ وَلِقَآئِهِۦٓ أُو۟لَـٰٓئِكَ","مِن رَّحْمَتِى وَأُو۟لَـٰٓئِكَ",1018],["41:49:10",482,"فَيَـُٔوسٌۭ","then he gives up hope","وَإِن مَّسَّهُ ٱلشَّرُّ","قَنُوطٌۭ",2052],["60:13:11",551,"يَئِسُوا۟","they despair","ٱللَّهُ عَلَيْهِمْ قَدْ","مِنَ ٱلْـَٔاخِرَةِ كَمَا",1018],["60:13:15",551,"يَئِسَ","despair","مِنَ ٱلْـَٔاخِرَةِ كَمَا","ٱلْكُفَّارُ مِنْ أَصْحَـٰبِ",1018],["65:4:2",558,"يَئِسْنَ","have despaired","وَٱلَّـٰٓـِٔى","مِنَ ٱلْمَحِيضِ مِن",1018]]