[["5:90:9",122,"رِجْسٌۭ","(are an) abomination","وَٱلْمَيْسِرُ وَٱلْأَنصَابُ وَٱلْأَزْلَـٰمُ","مِّنْ عَمَلِ ٱلشَّيْطَـٰنِ",857],["6:125:24",144,"ٱلرِّجْسَ","the filth","كَذَٰلِكَ يَجْعَلُ ٱللَّهُ","عَلَى ٱلَّذِينَ لَا",857],["6:145:23",147,"رِجْسٌ","(is) filth","لَحْمَ خِنزِيرٍۢ فَإِنَّهُۥ","أَوْ فِسْقًا أُهِلَّ",857],["7:71:7",159,"رِجْسٌۭ","punishment","عَلَيْكُم مِّن رَّبِّكُمْ","وَغَضَبٌ ۖ أَتُجَـٰدِلُونَنِى فِىٓ",857],["9:95:12",202,"رِجْسٌۭ ۖ","(are) impure","فَأَعْرِضُوا۟ عَنْهُمْ ۖ إِنَّهُمْ","وَمَأْوَىٰهُمْ جَهَنَّمُ جَزَآءًۢ",857],["9:125:7",207,"رِجْسًا","(in) evil","قُلُوبِهِم مَّرَضٌۭ فَزَادَتْهُمْ","إِلَىٰ رِجْسِهِمْ وَمَاتُوا۟",857],["9:125:9",207,"رِجْسِهِمْ","their evil","فَزَادَتْهُمْ رِجْسًا إِلَىٰ","وَمَاتُوا۟ وَهُمْ كَـٰفِرُونَ",857],["10:100:10",220,"ٱلرِّجْسَ","the wrath","بِإِذْنِ ٱللَّهِ ۚ وَيَجْعَلُ","عَلَى ٱلَّذِينَ لَا",857],["22:30:19",335,"ٱلرِّجْسَ","the abomination","يُتْلَىٰ عَلَيْكُمْ ۖ فَٱجْتَنِبُوا۟","مِنَ ٱلْأَوْثَـٰنِ وَٱجْتَنِبُوا۟",857],["33:33:21",422,"ٱلرِّجْسَ","the impurity","ٱللَّهُ لِيُذْهِبَ عَنكُمُ","أَهْلَ ٱلْبَيْتِ وَيُطَهِّرَكُمْ",857]]