[["27:17:9",378,"يُوزَعُونَ","(were) set in rows","وَٱلْإِنسِ وَٱلطَّيْرِ فَهُمْ","",2087],["27:19:7",378,"أَوْزِعْنِىٓ","Grant me (the) power","قَوْلِهَا وَقَالَ رَبِّ","أَنْ أَشْكُرَ نِعْمَتَكَ",2203],["27:83:11",384,"يُوزَعُونَ","will be set in rows","يُكَذِّبُ بِـَٔايَـٰتِنَا فَهُمْ","",2087],["41:19:8",478,"يُوزَعُونَ","will be assembled in rows","إِلَى ٱلنَّارِ فَهُمْ","",2087],["46:15:23",504,"أَوْزِعْنِىٓ","grant me (the) power","سَنَةًۭ قَالَ رَبِّ","أَنْ أَشْكُرَ نِعْمَتَكَ",2203]]