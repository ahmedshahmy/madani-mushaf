[["5:54:27",117,"لَوْمَةَ","the blame","ٱللَّهِ وَلَا يَخَافُونَ","لَآئِمٍۢ ۚ ذَٰلِكَ فَضْلُ",3601],["5:54:28",117,"لَآئِمٍۢ ۚ","(of) a critic","وَلَا يَخَافُونَ لَوْمَةَ","ذَٰلِكَ فَضْلُ ٱللَّهِ",3589],["12:32:4",239,"لُمْتُنَّنِى","you blamed me","قَالَتْ فَذَٰلِكُنَّ ٱلَّذِى","فِيهِ ۖ وَلَقَدْ رَٰوَدتُّهُۥ",1872],["14:22:25",258,"تَلُومُونِى","blame me","فَٱسْتَجَبْتُمْ لِى ۖ فَلَا","وَلُومُوٓا۟ أَنفُسَكُم ۖ مَّآ",1872],["14:22:26",258,"وَلُومُوٓا۟","but blame","لِى ۖ فَلَا تَلُومُونِى","أَنفُسَكُم ۖ مَّآ أَنَا۠",1872],["17:29:12",285,"مَلُومًۭا","blameworthy","كُلَّ ٱلْبَسْطِ فَتَقْعُدَ","مَّحْسُورًا",1355],["17:39:17",286,"مَلُومًۭا","blameworthy","فَتُلْقَىٰ فِى جَهَنَّمَ","مَّدْحُورًا",1355],["23:6:10",342,"مَلُومِينَ","blameworthy","أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ","",1355],["37:142:4",451,"مُلِيمٌۭ","(was) blameworthy","فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ","",2493],["51:40:7",522,"مُلِيمٌۭ","(was) blameworthy","فِى ٱلْيَمِّ وَهُوَ","",2493],["51:54:5",523,"بِمَلُومٍۢ","(are) to be blamed","عَنْهُمْ فَمَآ أَنتَ","",1355],["68:30:5",565,"يَتَلَـٰوَمُونَ","blaming each other","بَعْضُهُمْ عَلَىٰ بَعْضٍۢ","",4681],["70:30:10",569,"مَلُومِينَ","blameworthy","أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ","",1355],["75:2:4",577,"ٱللَّوَّامَةِ","self-accusing","وَلَآ أُقْسِمُ بِٱلنَّفْسِ","",3614]]