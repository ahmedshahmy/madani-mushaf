[["16:103:12",279,"أَعْجَمِىٌّۭ","(is) foreign","ٱلَّذِى يُلْحِدُونَ إِلَيْهِ","وَهَـٰذَا لِسَانٌ عَرَبِىٌّۭ",1724],["26:198:5",375,"ٱلْأَعْجَمِينَ","(of) the non-Arabs","نَزَّلْنَـٰهُ عَلَىٰ بَعْضِ","",2952],["41:44:4",481,"أَعْجَمِيًّۭا","(in) a foreign (language)","وَلَوْ جَعَلْنَـٰهُ قُرْءَانًا","لَّقَالُوا۟ لَوْلَا فُصِّلَتْ",1724],["41:44:9",481,"ءَا۬عْجَمِىٌّۭ","(Is it) a foreign (language)","لَوْلَا فُصِّلَتْ ءَايَـٰتُهُۥٓ ۖ","وَعَرَبِىٌّۭ ۗ قُلْ هُوَ",1724]]