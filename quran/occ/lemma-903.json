[["3:38:1",55,"هُنَالِكَ","There only","","دَعَا زَكَرِيَّا رَبَّهُۥ ۖ",903],["7:119:2",164,"هُنَالِكَ","there","فَغُلِبُوا۟","وَٱنقَلَبُوا۟ صَـٰغِرِينَ",903],["10:30:1",212,"هُنَالِكَ","There","","تَبْلُوا۟ كُلُّ نَفْسٍۢ",903],["18:44:1",298,"هُنَالِكَ","There","","ٱلْوَلَـٰيَةُ لِلَّهِ ٱلْحَقِّ ۚ",903],["25:13:8",361,"هُنَالِكَ","there","ضَيِّقًۭا مُّقَرَّنِينَ دَعَوْا۟","ثُبُورًۭا",903],["33:11:1",419,"هُنَالِكَ","There","","ٱبْتُلِىَ ٱلْمُؤْمِنُونَ وَزُلْزِلُوا۟",903],["38:11:3",453,"هُنَالِكَ","there","جُندٌۭ مَّا","مَهْزُومٌۭ مِّنَ ٱلْأَحْزَابِ",903],["40:78:31",476,"هُنَالِكَ","there","قُضِىَ بِٱلْحَقِّ وَخَسِرَ","ٱلْمُبْطِلُونَ",903],["40:85:16",476,"هُنَالِكَ","there","فِى عِبَادِهِۦ ۖ وَخَسِرَ","ٱلْكَـٰفِرُونَ",903]]