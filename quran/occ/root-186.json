[["2:26:6",5,"يَضْرِبَ","set forth","لَا يَسْتَحْىِۦٓ أَن","مَثَلًۭا مَّا بَعُوضَةًۭ",218],["2:60:6",9,"ٱضْرِب","Strike","مُوسَىٰ لِقَوْمِهِۦ فَقُلْنَا","بِّعَصَاكَ ٱلْحَجَرَ ۖ فَٱنفَجَرَتْ",218],["2:61:37",9,"وَضُرِبَتْ","And were struck","لَكُم مَّا سَأَلْتُمْ ۗ","عَلَيْهِمُ ٱلذِّلَّةُ وَٱلْمَسْكَنَةُ",218],["2:73:2",11,"ٱضْرِبُوهُ","Strike him","فَقُلْنَا","بِبَعْضِهَا ۚ كَذَٰلِكَ يُحْىِ",218],["2:273:9",46,"ضَرْبًۭا","(to) move about","ٱللَّهِ لَا يَسْتَطِيعُونَ","فِى ٱلْأَرْضِ يَحْسَبُهُمُ",1756],["3:112:1",64,"ضُرِبَتْ","Struck","","عَلَيْهِمُ ٱلذِّلَّةُ أَيْنَ",218],["3:112:18",64,"وَضُرِبَتْ","and struck","بِغَضَبٍۢ مِّنَ ٱللَّهِ","عَلَيْهِمُ ٱلْمَسْكَنَةُ ۚ ذَٰلِكَ",218],["3:156:11",70,"ضَرَبُوا۟","they traveled","وَقَالُوا۟ لِإِخْوَٰنِهِمْ إِذَا","فِى ٱلْأَرْضِ أَوْ",218],["4:34:29",84,"وَٱضْرِبُوهُنَّ ۖ","and [finally] strike them","وَٱهْجُرُوهُنَّ فِى ٱلْمَضَاجِعِ","فَإِنْ أَطَعْنَكُمْ فَلَا",218],["4:94:5",93,"ضَرَبْتُمْ","you go forth","ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا","فِى سَبِيلِ ٱللَّهِ",218],["4:101:2",94,"ضَرَبْتُمْ","you travel","وَإِذَا","فِى ٱلْأَرْضِ فَلَيْسَ",218],["5:106:22",125,"ضَرَبْتُمْ","(are) travel(ing)","غَيْرِكُمْ إِنْ أَنتُمْ","فِى ٱلْأَرْضِ فَأَصَـٰبَتْكُم",218],["7:160:13",171,"ٱضْرِب","Strike","ٱسْتَسْقَىٰهُ قَوْمُهُۥٓ أَنِ","بِّعَصَاكَ ٱلْحَجَرَ ۖ فَٱنۢبَجَسَتْ",218],["8:12:17",178,"فَٱضْرِبُوا۟","so strike","ٱلَّذِينَ كَفَرُوا۟ ٱلرُّعْبَ","فَوْقَ ٱلْأَعْنَاقِ وَٱضْرِبُوا۟",218],["8:12:20",178,"وَٱضْرِبُوا۟","and strike","فَٱضْرِبُوا۟ فَوْقَ ٱلْأَعْنَاقِ","مِنْهُمْ كُلَّ بَنَانٍۢ",218],["8:50:8",183,"يَضْرِبُونَ","striking","ٱلَّذِينَ كَفَرُوا۟ ۙ ٱلْمَلَـٰٓئِكَةُ","وُجُوهَهُمْ وَأَدْبَـٰرَهُمْ وَذُوقُوا۟",218],["13:17:24",251,"يَضْرِبُ","sets forth","زَبَدٌۭ مِّثْلُهُۥ ۚ كَذَٰلِكَ","ٱللَّهُ ٱلْحَقَّ وَٱلْبَـٰطِلَ ۚ",218],["13:17:40",251,"يَضْرِبُ","Allah sets forth","فِى ٱلْأَرْضِ ۚ كَذَٰلِكَ","ٱللَّهُ ٱلْأَمْثَالَ",218],["14:24:4",258,"ضَرَبَ","Allah sets forth","أَلَمْ تَرَ كَيْفَ","ٱللَّهُ مَثَلًۭا كَلِمَةًۭ",218],["14:25:7",259,"وَيَضْرِبُ","And Allah sets forth","حِينٍۭ بِإِذْنِ رَبِّهَا ۗ","ٱللَّهُ ٱلْأَمْثَالَ لِلنَّاسِ",218],["14:45:12",261,"وَضَرَبْنَا","and We put forth","كَيْفَ فَعَلْنَا بِهِمْ","لَكُمُ ٱلْأَمْثَالَ",218],["16:74:2",275,"تَضْرِبُوا۟","put forth","فَلَا","لِلَّهِ ٱلْأَمْثَالَ ۚ إِنَّ",218],["16:75:1",275,"۞ ضَرَبَ","Allah sets forth","","ٱللَّهُ مَثَلًا عَبْدًۭا",218],["16:76:1",275,"وَضَرَبَ","And Allah sets forth","","ٱللَّهُ مَثَلًۭا رَّجُلَيْنِ",218],["16:112:1",280,"وَضَرَبَ","And Allah sets forth","","ٱللَّهُ مَثَلًۭا قَرْيَةًۭ",218],["17:48:3",286,"ضَرَبُوا۟","they put forth","ٱنظُرْ كَيْفَ","لَكَ ٱلْأَمْثَالَ فَضَلُّوا۟",218],["18:11:1",294,"فَضَرَبْنَا","So We cast","","عَلَىٰٓ ءَاذَانِهِمْ فِى",218],["18:32:1",297,"۞ وَٱضْرِبْ","And set forth","","لَهُم مَّثَلًۭا رَّجُلَيْنِ",218],["18:45:1",298,"وَٱضْرِبْ","And present","","لَهُم مَّثَلَ ٱلْحَيَوٰةِ",218],["20:77:8",317,"فَٱضْرِبْ","and strike","أَنْ أَسْرِ بِعِبَادِى","لَهُمْ طَرِيقًۭا فِى",218],["22:73:3",341,"ضُرِبَ","Is set forth","يَـٰٓأَيُّهَا ٱلنَّاسُ","مَثَلٌۭ فَٱسْتَمِعُوا۟ لَهُۥٓ ۚ",218],["24:31:15",353,"وَلْيَضْرِبْنَ","And let them draw","مَا ظَهَرَ مِنْهَا ۖ","بِخُمُرِهِنَّ عَلَىٰ جُيُوبِهِنَّ ۖ",218],["24:31:64",353,"يَضْرِبْنَ","let them stamp","عَوْرَٰتِ ٱلنِّسَآءِ ۖ وَلَا","بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا",218],["24:35:41",354,"وَيَضْرِبُ","And Allah sets forth","لِنُورِهِۦ مَن يَشَآءُ ۚ","ٱللَّهُ ٱلْأَمْثَـٰلَ لِلنَّاسِ ۗ",218],["25:9:3",360,"ضَرَبُوا۟","they set forth","ٱنظُرْ كَيْفَ","لَكَ ٱلْأَمْثَـٰلَ فَضَلُّوا۟",218],["25:39:2",363,"ضَرَبْنَا","We have set forth","وَكُلًّۭا","لَهُ ٱلْأَمْثَـٰلَ ۖ وَكُلًّۭا",218],["26:63:5",370,"ٱضْرِب","Strike","إِلَىٰ مُوسَىٰٓ أَنِ","بِّعَصَاكَ ٱلْبَحْرَ ۖ فَٱنفَلَقَ",218],["29:43:3",401,"نَضْرِبُهَا","We set forth","وَتِلْكَ ٱلْأَمْثَـٰلُ","لِلنَّاسِ ۖ وَمَا يَعْقِلُهَآ",218],["30:28:1",407,"ضَرَبَ","He sets forth","","لَكُم مَّثَلًۭا مِّنْ",218],["30:58:2",410,"ضَرَبْنَا","We (have) set forth","وَلَقَدْ","لِلنَّاسِ فِى هَـٰذَا",218],["36:13:1",441,"وَٱضْرِبْ","And set forth","","لَهُم مَّثَلًا أَصْحَـٰبَ",218],["36:78:1",445,"وَضَرَبَ","And he sets forth","","لَنَا مَثَلًۭا وَنَسِىَ",218],["37:93:3",449,"ضَرْبًۢا","striking","فَرَاغَ عَلَيْهِمْ","بِٱلْيَمِينِ",1756],["38:44:4",456,"فَٱضْرِب","and strike","وَخُذْ بِيَدِكَ ضِغْثًۭا","بِّهِۦ وَلَا تَحْنَثْ ۗ",218],["39:27:2",461,"ضَرَبْنَا","We have set forth","وَلَقَدْ","لِلنَّاسِ فِى هَـٰذَا",218],["39:29:1",461,"ضَرَبَ","Allah sets forth","","ٱللَّهُ مَثَلًۭا رَّجُلًۭا",218],["43:5:1",489,"أَفَنَضْرِبُ","Then should We take away","","عَنكُمُ ٱلذِّكْرَ صَفْحًا",218],["43:17:5",490,"ضَرَبَ","he sets up","بُشِّرَ أَحَدُهُم بِمَا","لِلرَّحْمَـٰنِ مَثَلًۭا ظَلَّ",218],["43:57:2",493,"ضُرِبَ","is presented","۞ وَلَمَّا","ٱبْنُ مَرْيَمَ مَثَلًا",218],["43:58:7",493,"ضَرَبُوهُ","they present it","أَمْ هُوَ ۚ مَا","لَكَ إِلَّا جَدَلًۢا ۚ",218],["47:3:15",507,"يَضْرِبُ","Allah presents","مِن رَّبِّهِمْ ۚ كَذَٰلِكَ","ٱللَّهُ لِلنَّاسِ أَمْثَـٰلَهُمْ",218],["47:4:5",507,"فَضَرْبَ","then strike","لَقِيتُمُ ٱلَّذِينَ كَفَرُوا۟","ٱلرِّقَابِ حَتَّىٰٓ إِذَآ",1756],["47:27:5",509,"يَضْرِبُونَ","striking","إِذَا تَوَفَّتْهُمُ ٱلْمَلَـٰٓئِكَةُ","وُجُوهَهُمْ وَأَدْبَـٰرَهُمْ",218],["57:13:16",539,"فَضُرِبَ","Then will be put up","وَرَآءَكُمْ فَٱلْتَمِسُوا۟ نُورًۭا","بَيْنَهُم بِسُورٍۢ لَّهُۥ",218],["59:21:15",548,"نَضْرِبُهَا","We present them","ٱللَّهِ ۚ وَتِلْكَ ٱلْأَمْثَـٰلُ","لِلنَّاسِ لَعَلَّهُمْ يَتَفَكَّرُونَ",218],["66:10:1",561,"ضَرَبَ","Presents","","ٱللَّهُ مَثَلًۭا لِّلَّذِينَ",218],["66:11:1",561,"وَضَرَبَ","And presents","","ٱللَّهُ مَثَلًۭا لِّلَّذِينَ",218],["73:20:37",575,"يَضْرِبُونَ","traveling","مِنكُم مَّرْضَىٰ ۙ وَءَاخَرُونَ","فِى ٱلْأَرْضِ يَبْتَغُونَ",218]]