[["6:93:28",139,"غَمَرَٰتِ","agonies","إِذِ ٱلظَّـٰلِمُونَ فِى","ٱلْمَوْتِ وَٱلْمَلَـٰٓئِكَةُ بَاسِطُوٓا۟",3461],["23:54:3",345,"غَمْرَتِهِمْ","their confusion","فَذَرْهُمْ فِى","حَتَّىٰ حِينٍ",1845],["23:63:4",346,"غَمْرَةٍۢ","confusion","بَلْ قُلُوبُهُمْ فِى","مِّنْ هَـٰذَا وَلَهُمْ",1845],["51:11:4",521,"غَمْرَةٍۢ","flood","ٱلَّذِينَ هُمْ فِى","سَاهُونَ",1845]]