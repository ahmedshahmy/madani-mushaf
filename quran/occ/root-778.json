[["23:20:7",343,"بِٱلدُّهْنِ","oil","طُورِ سَيْنَآءَ تَنۢبُتُ","وَصِبْغٍۢ لِّلْـَٔاكِلِينَ",3392],["55:37:6",532,"كَٱلدِّهَانِ","like murky oil","ٱلسَّمَآءُ فَكَانَتْ وَرْدَةًۭ","",3391],["56:81:4",537,"مُّدْهِنُونَ","(are) indifferent","أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم","",3962],["68:9:3",564,"تُدْهِنُ","you should compromise","وَدُّوا۟ لَوْ","فَيُدْهِنُونَ",2805],["68:9:4",564,"فَيُدْهِنُونَ","so they would compromise","وَدُّوا۟ لَوْ تُدْهِنُ","",2805]]