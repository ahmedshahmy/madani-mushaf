[["11:56:13",228,"بِنَاصِيَتِهَآ ۚ","of its forelock","إِلَّا هُوَ ءَاخِذٌۢ","إِنَّ رَبِّى عَلَىٰ",1940],["55:41:5",532,"بِٱلنَّوَٰصِى","by the forelocks","ٱلْمُجْرِمُونَ بِسِيمَـٰهُمْ فَيُؤْخَذُ","وَٱلْأَقْدَامِ",4094],["96:15:6",598,"بِٱلنَّاصِيَةِ","by the forelock","لَّمْ يَنتَهِ لَنَسْفَعًۢا","",1940],["96:16:1",598,"نَاصِيَةٍۢ","A forelock","","كَـٰذِبَةٍ خَاطِئَةٍۢ",1940]]