[["2:144:12",22,"شَطْرَ","towards the direction","تَرْضَىٰهَا ۚ فَوَلِّ وَجْهَكَ","ٱلْمَسْجِدِ ٱلْحَرَامِ ۚ وَحَيْثُ",1263],["2:144:20",22,"شَطْرَهُۥ ۗ","(in) its direction","كُنتُمْ فَوَلُّوا۟ وُجُوهَكُمْ","وَإِنَّ ٱلَّذِينَ أُوتُوا۟",1263],["2:149:6",23,"شَطْرَ","(in the) direction","خَرَجْتَ فَوَلِّ وَجْهَكَ","ٱلْمَسْجِدِ ٱلْحَرَامِ ۖ وَإِنَّهُۥ",1263],["2:150:6",23,"شَطْرَ","(in the) direction","خَرَجْتَ فَوَلِّ وَجْهَكَ","ٱلْمَسْجِدِ ٱلْحَرَامِ ۚ وَحَيْثُ",1263],["2:150:14",23,"شَطْرَهُۥ","(in) its direction","كُنتُمْ فَوَلُّوا۟ وُجُوهَكُمْ","لِئَلَّا يَكُونَ لِلنَّاسِ",1263]]