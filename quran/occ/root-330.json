[["2:58:12",9,"ٱلْبَابَ","the gate","شِئْتُمْ رَغَدًۭا وَٱدْخُلُوا۟","سُجَّدًۭا وَقُولُوا۟ حِطَّةٌۭ",398],["2:189:23",29,"أَبْوَٰبِهَا ۚ","their doors","وَأْتُوا۟ ٱلْبُيُوتَ مِنْ","وَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ",398],["4:154:8",102,"ٱلْبَابَ","the gate","وَقُلْنَا لَهُمُ ٱدْخُلُوا۟","سُجَّدًۭا وَقُلْنَا لَهُمْ",398],["5:23:11",111,"ٱلْبَابَ","(through) the gate","عَلَيْهِمَا ٱدْخُلُوا۟ عَلَيْهِمُ","فَإِذَا دَخَلْتُمُوهُ فَإِنَّكُمْ",398],["6:44:8",132,"أَبْوَٰبَ","gates","بِهِۦ فَتَحْنَا عَلَيْهِمْ","كُلِّ شَىْءٍ حَتَّىٰٓ",398],["7:40:10",155,"أَبْوَٰبُ","(the) doors","لَا تُفَتَّحُ لَهُمْ","ٱلسَّمَآءِ وَلَا يَدْخُلُونَ",398],["7:161:14",171,"ٱلْبَابَ","the gate","وَقُولُوا۟ حِطَّةٌۭ وَٱدْخُلُوا۟","سُجَّدًۭا نَّغْفِرْ لَكُمْ",398],["12:23:9",238,"ٱلْأَبْوَٰبَ","the doors","عَن نَّفْسِهِۦ وَغَلَّقَتِ","وَقَالَتْ هَيْتَ لَكَ ۚ",398],["12:25:2",238,"ٱلْبَابَ","(to) the door","وَٱسْتَبَقَا","وَقَدَّتْ قَمِيصَهُۥ مِن",398],["12:25:10",238,"ٱلْبَابِ ۚ","the door","وَأَلْفَيَا سَيِّدَهَا لَدَا","قَالَتْ مَا جَزَآءُ",398],["12:67:6",243,"بَابٍۢ","one gate","لَا تَدْخُلُوا۟ مِنۢ","وَٰحِدٍۢ وَٱدْخُلُوا۟ مِنْ",398],["12:67:10",243,"أَبْوَٰبٍۢ","gates","وَٰحِدٍۢ وَٱدْخُلُوا۟ مِنْ","مُّتَفَرِّقَةٍۢ ۖ وَمَآ أُغْنِى",398],["13:23:15",252,"بَابٍۢ","gate","عَلَيْهِم مِّن كُلِّ","",398],["15:14:4",262,"بَابًۭا","a gate","وَلَوْ فَتَحْنَا عَلَيْهِم","مِّنَ ٱلسَّمَآءِ فَظَلُّوا۟",398],["15:44:3",264,"أَبْوَٰبٍۢ","gates","لَهَا سَبْعَةُ","لِّكُلِّ بَابٍۢ مِّنْهُمْ",398],["15:44:5",264,"بَابٍۢ","gate","سَبْعَةُ أَبْوَٰبٍۢ لِّكُلِّ","مِّنْهُمْ جُزْءٌۭ مَّقْسُومٌ",398],["16:29:2",270,"أَبْوَٰبَ","(the) gates","فَٱدْخُلُوٓا۟","جَهَنَّمَ خَـٰلِدِينَ فِيهَا ۖ",398],["23:77:5",347,"بَابًۭا","a gate","إِذَا فَتَحْنَا عَلَيْهِم","ذَا عَذَابٍۢ شَدِيدٍ",398],["38:50:5",456,"ٱلْأَبْوَٰبُ","the gates","عَدْنٍۢ مُّفَتَّحَةًۭ لَّهُمُ","",398],["39:71:11",466,"أَبْوَٰبُهَا","its gates","إِذَا جَآءُوهَا فُتِحَتْ","وَقَالَ لَهُمْ خَزَنَتُهَآ",398],["39:72:3",466,"أَبْوَٰبَ","(the) gates","قِيلَ ٱدْخُلُوٓا۟","جَهَنَّمَ خَـٰلِدِينَ فِيهَا ۖ",398],["39:73:12",466,"أَبْوَٰبُهَا","its gates","إِذَا جَآءُوهَا وَفُتِحَتْ","وَقَالَ لَهُمْ خَزَنَتُهَا",398],["40:76:2",475,"أَبْوَٰبَ","(the) gates","ٱدْخُلُوٓا۟","جَهَنَّمَ خَـٰلِدِينَ فِيهَا ۖ",398],["43:34:2",492,"أَبْوَٰبًۭا","doors","وَلِبُيُوتِهِمْ","وَسُرُرًا عَلَيْهَا يَتَّكِـُٔونَ",398],["54:11:2",529,"أَبْوَٰبَ","(the) gates","فَفَتَحْنَآ","ٱلسَّمَآءِ بِمَآءٍۢ مُّنْهَمِرٍۢ",398],["57:13:20",539,"بَابٌۢ","a gate","بَيْنَهُم بِسُورٍۢ لَّهُۥ","بَاطِنُهُۥ فِيهِ ٱلرَّحْمَةُ",398],["78:19:4",582,"أَبْوَٰبًۭا","gateways","وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ","",398]]