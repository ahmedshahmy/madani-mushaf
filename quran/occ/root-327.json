[["2:35:15",6,"ٱلشَّجَرَةَ","[the] tree","وَلَا تَقْرَبَا هَـٰذِهِ","فَتَكُونَا مِنَ ٱلظَّـٰلِمِينَ",521],["4:65:8",88,"شَجَرَ","arises","حَتَّىٰ يُحَكِّمُوكَ فِيمَا","بَيْنَهُمْ ثُمَّ لَا",2869],["7:19:13",152,"ٱلشَّجَرَةَ","[the] tree","وَلَا تَقْرَبَا هَـٰذِهِ","فَتَكُونَا مِنَ ٱلظَّـٰلِمِينَ",521],["7:20:17",152,"ٱلشَّجَرَةِ","[the] tree","رَبُّكُمَا عَنْ هَـٰذِهِ","إِلَّآ أَن تَكُونَا",521],["7:22:5",152,"ٱلشَّجَرَةَ","the tree","بِغُرُورٍۢ ۚ فَلَمَّا ذَاقَا","بَدَتْ لَهُمَا سَوْءَٰتُهُمَا",521],["7:22:21",152,"ٱلشَّجَرَةِ","[the] tree","أَنْهَكُمَا عَن تِلْكُمَا","وَأَقُل لَّكُمَآ إِنَّ",521],["14:24:9",258,"كَشَجَرَةٍۢ","(is) like a tree","مَثَلًۭا كَلِمَةًۭ طَيِّبَةًۭ","طَيِّبَةٍ أَصْلُهَا ثَابِتٌۭ",521],["14:26:4",259,"كَشَجَرَةٍ","(is) like a tree","وَمَثَلُ كَلِمَةٍ خَبِيثَةٍۢ","خَبِيثَةٍ ٱجْتُثَّتْ مِن",521],["16:10:11",268,"شَجَرٌۭ","(grows) vegetation","مِّنْهُ شَرَابٌۭ وَمِنْهُ","فِيهِ تُسِيمُونَ",1027],["16:68:11",274,"ٱلشَّجَرِ","the trees","ٱلْجِبَالِ بُيُوتًۭا وَمِنَ","وَمِمَّا يَعْرِشُونَ",1027],["17:60:16",288,"وَٱلشَّجَرَةَ","and the tree","إِلَّا فِتْنَةًۭ لِّلنَّاسِ","ٱلْمَلْعُونَةَ فِى ٱلْقُرْءَانِ ۚ",521],["20:120:9",320,"شَجَرَةِ","(the) tree","هَلْ أَدُلُّكَ عَلَىٰ","ٱلْخُلْدِ وَمُلْكٍۢ لَّا",521],["22:18:17",334,"وَٱلشَّجَرُ","and the trees","وَٱلْقَمَرُ وَٱلنُّجُومُ وَٱلْجِبَالُ","وَٱلدَّوَآبُّ وَكَثِيرٌۭ مِّنَ",1027],["23:20:1",343,"وَشَجَرَةًۭ","And a tree","","تَخْرُجُ مِن طُورِ",521],["24:35:19",354,"شَجَرَةٍۢ","a tree","دُرِّىٌّۭ يُوقَدُ مِن","مُّبَـٰرَكَةٍۢ زَيْتُونَةٍۢ لَّا",521],["27:60:20",382,"شَجَرَهَآ ۗ","their trees","لَكُمْ أَن تُنۢبِتُوا۟","أَءِلَـٰهٌۭ مَّعَ ٱللَّهِ ۚ",1027],["28:30:12",389,"ٱلشَّجَرَةِ","the tree","ٱلْبُقْعَةِ ٱلْمُبَـٰرَكَةِ مِنَ","أَن يَـٰمُوسَىٰٓ إِنِّىٓ",521],["31:27:6",413,"شَجَرَةٍ","(the) trees","فِى ٱلْأَرْضِ مِن","أَقْلَـٰمٌۭ وَٱلْبَحْرُ يَمُدُّهُۥ",521],["36:80:5",445,"ٱلشَّجَرِ","the tree","جَعَلَ لَكُم مِّنَ","ٱلْأَخْضَرِ نَارًۭا فَإِذَآ",1027],["37:62:5",448,"شَجَرَةُ","(the) tree","خَيْرٌۭ نُّزُلًا أَمْ","ٱلزَّقُّومِ",521],["37:64:2",448,"شَجَرَةٌۭ","(is) a tree","إِنَّهَا","تَخْرُجُ فِىٓ أَصْلِ",521],["37:146:3",451,"شَجَرَةًۭ","a plant","وَأَنۢبَتْنَا عَلَيْهِ","مِّن يَقْطِينٍۢ",521],["44:43:2",498,"شَجَرَتَ","(the) tree","إِنَّ","ٱلزَّقُّومِ",521],["48:18:9",513,"ٱلشَّجَرَةِ","the tree","إِذْ يُبَايِعُونَكَ تَحْتَ","فَعَلِمَ مَا فِى",521],["55:6:2",531,"وَٱلشَّجَرُ","and the trees","وَٱلنَّجْمُ","يَسْجُدَانِ",1027],["56:52:3",536,"شَجَرٍۢ","(the) tree","لَـَٔاكِلُونَ مِن","مِّن زَقُّومٍۢ",1027],["56:72:3",536,"شَجَرَتَهَآ","its tree","ءَأَنتُمْ أَنشَأْتُمْ","أَمْ نَحْنُ ٱلْمُنشِـُٔونَ",521]]