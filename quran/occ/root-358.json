[["2:96:12",15,"يُعَمَّرُ","he could be granted a life","يَوَدُّ أَحَدُهُمْ لَوْ","أَلْفَ سَنَةٍۢ وَمَا",1436],["2:96:21",15,"يُعَمَّرَ ۗ","he should be granted life","مِنَ ٱلْعَذَابِ أَن","وَٱللَّهُ بَصِيرٌۢ بِمَا",1436],["2:158:11",24,"ٱعْتَمَرَ","performs Umrah","حَجَّ ٱلْبَيْتَ أَوِ","فَلَا جُنَاحَ عَلَيْهِ",4783],["2:196:3",30,"وَٱلْعُمْرَةَ","and the Umrah","وَأَتِمُّوا۟ ٱلْحَجَّ","لِلَّهِ ۚ فَإِنْ أُحْصِرْتُمْ",2258],["2:196:38",30,"بِٱلْعُمْرَةِ","of the Umrah","أَمِنتُمْ فَمَن تَمَتَّعَ","إِلَى ٱلْحَجِّ فَمَا",2258],["9:17:5",189,"يَعْمُرُوا۟","they maintain","كَانَ لِلْمُشْرِكِينَ أَن","مَسَـٰجِدَ ٱللَّهِ شَـٰهِدِينَ",1499],["9:18:2",189,"يَعْمُرُ","will maintain","إِنَّمَا","مَسَـٰجِدَ ٱللَّهِ مَنْ",1499],["9:19:4",189,"وَعِمَارَةَ","and (the) maintenance","۞ أَجَعَلْتُمْ سِقَايَةَ ٱلْحَآجِّ","ٱلْمَسْجِدِ ٱلْحَرَامِ كَمَنْ",3142],["10:16:14",210,"عُمُرًۭا","a lifetime","فَقَدْ لَبِثْتُ فِيكُمْ","مِّن قَبْلِهِۦٓ ۚ أَفَلَا",1049],["11:61:18",228,"وَٱسْتَعْمَرَكُمْ","and settled you","أَنشَأَكُم مِّنَ ٱلْأَرْضِ","فِيهَا فَٱسْتَغْفِرُوهُ ثُمَّ",4828],["15:72:1",266,"لَعَمْرُكَ","By your life","","إِنَّهُمْ لَفِى سَكْرَتِهِمْ",3117],["16:70:10",274,"ٱلْعُمُرِ","(of) the age","يُرَدُّ إِلَىٰٓ أَرْذَلِ","لِكَىْ لَا يَعْلَمَ",1049],["21:44:8",325,"ٱلْعُمُرُ ۗ","the life","حَتَّىٰ طَالَ عَلَيْهِمُ","أَفَلَا يَرَوْنَ أَنَّا",1049],["22:5:49",332,"ٱلْعُمُرِ","age","يُرَدُّ إِلَىٰٓ أَرْذَلِ","لِكَيْلَا يَعْلَمَ مِنۢ",1049],["26:18:9",367,"عُمُرِكَ","your life","وَلَبِثْتَ فِينَا مِنْ","سِنِينَ",1049],["28:45:6",391,"ٱلْعُمُرُ ۚ","the life","قُرُونًۭا فَتَطَاوَلَ عَلَيْهِمُ","وَمَا كُنتَ ثَاوِيًۭا",1049],["30:9:18",405,"وَعَمَرُوهَآ","and built (on) it","قُوَّةًۭ وَأَثَارُوا۟ ٱلْأَرْضَ","أَكْثَرَ مِمَّا عَمَرُوهَا",1499],["30:9:21",405,"عَمَرُوهَا","they have built (on) it","وَعَمَرُوهَآ أَكْثَرَ مِمَّا","وَجَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَـٰتِ ۖ",1499],["35:11:20",435,"يُعَمَّرُ","is granted life","إِلَّا بِعِلْمِهِۦ ۚ وَمَا","مِن مُّعَمَّرٍۢ وَلَا",1436],["35:11:22",435,"مُّعَمَّرٍۢ","aged person","وَمَا يُعَمَّرُ مِن","وَلَا يُنقَصُ مِنْ",3954],["35:11:26",435,"عُمُرِهِۦٓ","his life","وَلَا يُنقَصُ مِنْ","إِلَّا فِى كِتَـٰبٍ ۚ",1049],["35:37:13",438,"نُعَمِّرْكُم","We give you life long enough","كُنَّا نَعْمَلُ ۚ أَوَلَمْ","مَّا يَتَذَكَّرُ فِيهِ",1436],["36:68:2",444,"نُّعَمِّرْهُ","We grant him long life","وَمَن","نُنَكِّسْهُ فِى ٱلْخَلْقِ ۖ",1436],["52:4:2",523,"ٱلْمَعْمُورِ","frequented","وَٱلْبَيْتِ","",3632]]