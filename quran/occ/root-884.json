[["38:23:7",454,"نَعْجَةًۭ","ewe(s)","لَهُۥ تِسْعٌۭ وَتِسْعُونَ","وَلِىَ نَعْجَةٌۭ وَٰحِدَةٌۭ",1610],["38:23:9",454,"نَعْجَةٌۭ","ewe","وَتِسْعُونَ نَعْجَةًۭ وَلِىَ","وَٰحِدَةٌۭ فَقَالَ أَكْفِلْنِيهَا",1610],["38:24:5",454,"نَعْجَتِكَ","your ewe","لَقَدْ ظَلَمَكَ بِسُؤَالِ","إِلَىٰ نِعَاجِهِۦ ۖ وَإِنَّ",1610],["38:24:7",454,"نِعَاجِهِۦ ۖ","his ewes","بِسُؤَالِ نَعْجَتِكَ إِلَىٰ","وَإِنَّ كَثِيرًۭا مِّنَ",1610]]