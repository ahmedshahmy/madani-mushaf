[["3:99:12",62,"عِوَجًۭا","(seem) crooked","مَنْ ءَامَنَ تَبْغُونَهَا","وَأَنتُمْ شُهَدَآءُ ۗ وَمَا",885],["7:45:7",156,"عِوَجًۭا","crookedness","سَبِيلِ ٱللَّهِ وَيَبْغُونَهَا","وَهُم بِٱلْـَٔاخِرَةِ كَـٰفِرُونَ",885],["7:86:14",161,"عِوَجًۭا ۚ","crooked","ءَامَنَ بِهِۦ وَتَبْغُونَهَا","وَٱذْكُرُوٓا۟ إِذْ كُنتُمْ",885],["11:19:7",223,"عِوَجًۭا","crookedness","سَبِيلِ ٱللَّهِ وَيَبْغُونَهَا","وَهُم بِٱلْـَٔاخِرَةِ هُمْ",885],["14:3:12",255,"عِوَجًا ۚ","crookedness","سَبِيلِ ٱللَّهِ وَيَبْغُونَهَا","أُو۟لَـٰٓئِكَ فِى ضَلَـٰلٍۭ",885],["18:1:11",293,"عِوَجَاۜ","any crookedness","وَلَمْ يَجْعَل لَّهُۥ","",885],["20:107:4",319,"عِوَجًۭا","any crookedness","لَّا تَرَىٰ فِيهَا","وَلَآ أَمْتًۭا",885],["20:108:5",319,"عِوَجَ","deviation","يَتَّبِعُونَ ٱلدَّاعِىَ لَا","لَهُۥ ۖ وَخَشَعَتِ ٱلْأَصْوَاتُ",885],["39:28:5",461,"عِوَجٍۢ","crookedness","عَرَبِيًّا غَيْرَ ذِى","لَّعَلَّهُمْ يَتَّقُونَ",885]]