[["2:222:7",35,"فَٱعْتَزِلُوا۟","so keep away (from)","قُلْ هُوَ أَذًۭى","ٱلنِّسَآءَ فِى ٱلْمَحِيضِ ۖ",1122],["4:90:25",92,"ٱعْتَزَلُوكُمْ","they withdraw from you","عَلَيْكُمْ فَلَقَـٰتَلُوكُمْ ۚ فَإِنِ","فَلَمْ يُقَـٰتِلُوكُمْ وَأَلْقَوْا۟",1122],["4:91:17",92,"يَعْتَزِلُوكُمْ","they withdraw from you","فِيهَا ۚ فَإِن لَّمْ","وَيُلْقُوٓا۟ إِلَيْكُمُ ٱلسَّلَمَ",1122],["11:42:12",226,"مَعْزِلٍۢ","apart","ٱبْنَهُۥ وَكَانَ فِى","يَـٰبُنَىَّ ٱرْكَب مَّعَنَا",3634],["18:16:2",295,"ٱعْتَزَلْتُمُوهُمْ","you withdraw from them","وَإِذِ","وَمَا يَعْبُدُونَ إِلَّا",1122],["19:48:1",308,"وَأَعْتَزِلُكُمْ","And I will leave you","","وَمَا تَدْعُونَ مِن",1122],["19:49:2",308,"ٱعْتَزَلَهُمْ","he left them","فَلَمَّا","وَمَا يَعْبُدُونَ مِن",1122],["26:212:4",376,"لَمَعْزُولُونَ","(are) surely banished","إِنَّهُمْ عَنِ ٱلسَّمْعِ","",3635],["33:51:12",425,"عَزَلْتَ","you (had) set aside","وَمَنِ ٱبْتَغَيْتَ مِمَّنْ","فَلَا جُنَاحَ عَلَيْكَ ۚ",3131],["44:21:5",497,"فَٱعْتَزِلُونِ","then leave me alone","لَّمْ تُؤْمِنُوا۟ لِى","",1122]]