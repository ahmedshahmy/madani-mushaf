[["2:19:2",4,"كَصَيِّبٍۢ","like a rainstorm","أَوْ","مِّنَ ٱلسَّمَآءِ فِيهِ",3259],["2:156:3",24,"أَصَـٰبَتْهُم","strikes them","ٱلَّذِينَ إِذَآ","مُّصِيبَةٌۭ قَالُوٓا۟ إِنَّا",187],["2:156:4",24,"مُّصِيبَةٌۭ","a misfortune","ٱلَّذِينَ إِذَآ أَصَـٰبَتْهُم","قَالُوٓا۟ إِنَّا لِلَّهِ",850],["2:264:24",44,"فَأَصَابَهُۥ","then fell on it","صَفْوَانٍ عَلَيْهِ تُرَابٌۭ","وَابِلٌۭ فَتَرَكَهُۥ صَلْدًۭا ۖ",187],["2:265:14",45,"أَصَابَهَا","fell on it","كَمَثَلِ جَنَّةٍۭ بِرَبْوَةٍ","وَابِلٌۭ فَـَٔاتَتْ أُكُلَهَا",187],["2:265:21",45,"يُصِبْهَا","fall (on) it","ضِعْفَيْنِ فَإِن لَّمْ","وَابِلٌۭ فَطَلٌّۭ ۗ وَٱللَّهُ",187],["2:266:19",45,"وَأَصَابَهُ","and strikes him","مِن كُلِّ ٱلثَّمَرَٰتِ","ٱلْكِبَرُ وَلَهُۥ ذُرِّيَّةٌۭ",187],["2:266:24",45,"فَأَصَابَهَآ","then falls on it","وَلَهُۥ ذُرِّيَّةٌۭ ضُعَفَآءُ","إِعْصَارٌۭ فِيهِ نَارٌۭ",187],["3:117:12",65,"أَصَابَتْ","it struck","رِيحٍۢ فِيهَا صِرٌّ","حَرْثَ قَوْمٍۢ ظَلَمُوٓا۟",187],["3:120:6",65,"تُصِبْكُمْ","strikes you","حَسَنَةٌۭ تَسُؤْهُمْ وَإِن","سَيِّئَةٌۭ يَفْرَحُوا۟ بِهَا ۖ",187],["3:146:11",68,"أَصَابَهُمْ","befell them","فَمَا وَهَنُوا۟ لِمَآ","فِى سَبِيلِ ٱللَّهِ",187],["3:153:21",69,"أَصَـٰبَكُمْ ۗ","(had) befallen you","فَاتَكُمْ وَلَا مَآ","وَٱللَّهُ خَبِيرٌۢ بِمَا",187],["3:165:2",71,"أَصَـٰبَتْكُم","struck you","أَوَلَمَّآ","مُّصِيبَةٌۭ قَدْ أَصَبْتُم",187],["3:165:3",71,"مُّصِيبَةٌۭ","disaster","أَوَلَمَّآ أَصَـٰبَتْكُم","قَدْ أَصَبْتُم مِّثْلَيْهَا",850],["3:165:5",71,"أَصَبْتُم","you (had) struck (them)","أَصَـٰبَتْكُم مُّصِيبَةٌۭ قَدْ","مِّثْلَيْهَا قُلْتُمْ أَنَّىٰ",187],["3:166:2",72,"أَصَـٰبَكُمْ","struck you","وَمَآ","يَوْمَ ٱلْتَقَى ٱلْجَمْعَانِ",187],["3:172:8",72,"أَصَابَهُمُ","befell them","مِنۢ بَعْدِ مَآ","ٱلْقَرْحُ ۚ لِلَّذِينَ أَحْسَنُوا۟",187],["4:62:3",88,"أَصَـٰبَتْهُم","befalls them","فَكَيْفَ إِذَآ","مُّصِيبَةٌۢ بِمَا قَدَّمَتْ",187],["4:62:4",88,"مُّصِيبَةٌۢ","disaster","فَكَيْفَ إِذَآ أَصَـٰبَتْهُم","بِمَا قَدَّمَتْ أَيْدِيهِمْ",850],["4:72:6",89,"أَصَـٰبَتْكُم","befalls you","لَمَن لَّيُبَطِّئَنَّ فَإِنْ","مُّصِيبَةٌۭ قَالَ قَدْ",187],["4:72:7",89,"مُّصِيبَةٌۭ","a disaster","لَّيُبَطِّئَنَّ فَإِنْ أَصَـٰبَتْكُم","قَالَ قَدْ أَنْعَمَ",850],["4:73:2",89,"أَصَـٰبَكُمْ","befalls you","وَلَئِنْ","فَضْلٌۭ مِّنَ ٱللَّهِ",187],["4:78:11",90,"تُصِبْهُمْ","befalls them","بُرُوجٍۢ مُّشَيَّدَةٍۢ ۗ وَإِن","حَسَنَةٌۭ يَقُولُوا۟ هَـٰذِهِۦ",187],["4:78:19",90,"تُصِبْهُمْ","befalls them","عِندِ ٱللَّهِ ۖ وَإِن","سَيِّئَةٌۭ يَقُولُوا۟ هَـٰذِهِۦ",187],["4:79:2",90,"أَصَابَكَ","befalls you","مَّآ","مِنْ حَسَنَةٍۢ فَمِنَ",187],["4:79:8",90,"أَصَابَكَ","befalls you","فَمِنَ ٱللَّهِ ۖ وَمَآ","مِن سَيِّئَةٍۢ فَمِن",187],["5:49:26",116,"يُصِيبَهُم","afflict them","يُرِيدُ ٱللَّهُ أَن","بِبَعْضِ ذُنُوبِهِمْ ۗ وَإِنَّ",187],["5:52:11",117,"تُصِيبَنَا","(may) strike us","يَقُولُونَ نَخْشَىٰٓ أَن","دَآئِرَ ةٌۭ ۚ فَعَسَى ٱللَّهُ",187],["5:106:25",125,"فَأَصَـٰبَتْكُم","then befalls you","ضَرَبْتُمْ فِى ٱلْأَرْضِ","مُّصِيبَةُ ٱلْمَوْتِ ۚ تَحْبِسُونَهُمَا",187],["5:106:26",125,"مُّصِيبَةُ","calamity","فِى ٱلْأَرْضِ فَأَصَـٰبَتْكُم","ٱلْمَوْتِ ۚ تَحْبِسُونَهُمَا مِنۢ",850],["6:124:19",143,"سَيُصِيبُ","Will afflict","حَيْثُ يَجْعَلُ رِسَالَتَهُۥ ۗ","ٱلَّذِينَ أَجْرَمُوا۟ صَغَارٌ",187],["7:100:12",163,"أَصَبْنَـٰهُم","We (could) afflict them","أَن لَّوْ نَشَآءُ","بِذُنُوبِهِمْ ۚ وَنَطْبَعُ عَلَىٰ",187],["7:131:8",166,"تُصِبْهُمْ","afflicts them","لَنَا هَـٰذِهِۦ ۖ وَإِن","سَيِّئَةٌۭ يَطَّيَّرُوا۟ بِمُوسَىٰ",187],["7:156:14",170,"أُصِيبُ","I afflict","إِلَيْكَ ۚ قَالَ عَذَابِىٓ","بِهِۦ مَنْ أَشَآءُ ۖ",187],["8:25:4",179,"تُصِيبَنَّ","which will afflict","وَٱتَّقُوا۟ فِتْنَةًۭ لَّا","ٱلَّذِينَ ظَلَمُوا۟ مِنكُمْ",187],["9:50:2",195,"تُصِبْكَ","befalls you","إِن","حَسَنَةٌۭ تَسُؤْهُمْ ۖ وَإِن",187],["9:50:6",195,"تُصِبْكَ","befalls you","حَسَنَةٌۭ تَسُؤْهُمْ ۖ وَإِن","مُصِيبَةٌۭ يَقُولُوا۟ قَدْ",187],["9:50:7",195,"مُصِيبَةٌۭ","a calamity","تَسُؤْهُمْ ۖ وَإِن تُصِبْكَ","يَقُولُوا۟ قَدْ أَخَذْنَآ",850],["9:51:3",195,"يُصِيبَنَآ","will befall us","قُل لَّن","إِلَّا مَا كَتَبَ",187],["9:52:12",195,"يُصِيبَكُمُ","Allah will afflict you","نَتَرَبَّصُ بِكُمْ أَن","ٱللَّهُ بِعَذَابٍۢ مِّنْ",187],["9:90:12",201,"سَيُصِيبُ","Will strike","كَذَبُوا۟ ٱللَّهَ وَرَسُولَهُۥ ۚ","ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ",187],["9:120:22",206,"يُصِيبُهُمْ","afflict them","ذَٰلِكَ بِأَنَّهُمْ لَا","ظَمَأٌۭ وَلَا نَصَبٌۭ",187],["10:107:16",221,"يُصِيبُ","He causes it to reach","فَلَا رَآدَّ لِفَضْلِهِۦ ۚ","بِهِۦ مَن يَشَآءُ",187],["11:81:21",230,"مُصِيبُهَا","will strike her","إِلَّا ٱمْرَأَتَكَ ۖ إِنَّهُۥ","مَآ أَصَابَهُمْ ۚ إِنَّ",3774],["11:81:23",230,"أَصَابَهُمْ ۚ","will strike them","إِنَّهُۥ مُصِيبُهَا مَآ","إِنَّ مَوْعِدَهُمُ ٱلصُّبْحُ ۚ",187],["11:89:6",232,"يُصِيبَكُم","befalls you","يَجْرِمَنَّكُمْ شِقَاقِىٓ أَن","مِّثْلُ مَآ أَصَابَ",187],["11:89:9",232,"أَصَابَ","befell","يُصِيبَكُم مِّثْلُ مَآ","قَوْمَ نُوحٍ أَوْ",187],["12:56:10",242,"نُصِيبُ","We bestow","مِنْهَا حَيْثُ يَشَآءُ ۚ","بِرَحْمَتِنَا مَن نَّشَآءُ ۖ",187],["13:13:9",250,"فَيُصِيبُ","and strikes","خِيفَتِهِۦ وَيُرْسِلُ ٱلصَّوَٰعِقَ","بِهَا مَن يَشَآءُ",187],["13:31:34",253,"تُصِيبُهُم","to strike them","يَزَالُ ٱلَّذِينَ كَفَرُوا۟","بِمَا صَنَعُوا۟ قَارِعَةٌ",187],["16:34:1",270,"فَأَصَابَهُمْ","Then struck them","","سَيِّـَٔاتُ مَا عَمِلُوا۟",187],["22:11:9",333,"أَصَابَهُۥ","befalls him","عَلَىٰ حَرْفٍۢ ۖ فَإِنْ","خَيْرٌ ٱطْمَأَنَّ بِهِۦ ۖ",187],["22:11:14",333,"أَصَابَتْهُ","befalls him","ٱطْمَأَنَّ بِهِۦ ۖ وَإِنْ","فِتْنَةٌ ٱنقَلَبَ عَلَىٰ",187],["22:35:10",336,"أَصَابَهُمْ","has afflicted them","وَٱلصَّـٰبِرِينَ عَلَىٰ مَآ","وَٱلْمُقِيمِى ٱلصَّلَوٰةِ وَمِمَّا",187],["24:43:26",355,"فَيُصِيبُ","and He strikes","فِيهَا مِنۢ بَرَدٍۢ","بِهِۦ مَن يَشَآءُ",187],["24:63:22",359,"تُصِيبَهُمْ","befalls them","عَنْ أَمْرِهِۦٓ أَن","فِتْنَةٌ أَوْ يُصِيبَهُمْ",187],["24:63:25",359,"يُصِيبَهُمْ","befalls them","تُصِيبَهُمْ فِتْنَةٌ أَوْ","عَذَابٌ أَلِيمٌ",187],["28:47:3",391,"تُصِيبَهُم","struck them","وَلَوْلَآ أَن","مُّصِيبَةٌۢ بِمَا قَدَّمَتْ",187],["28:47:4",391,"مُّصِيبَةٌۢ","a disaster","وَلَوْلَآ أَن تُصِيبَهُم","بِمَا قَدَّمَتْ أَيْدِيهِمْ",850],["30:36:8",408,"تُصِبْهُمْ","afflicts them","فَرِحُوا۟ بِهَا ۖ وَإِن","سَيِّئَةٌۢ بِمَا قَدَّمَتْ",187],["30:48:20",409,"أَصَابَ","He causes it to fall on","مِنْ خِلَـٰلِهِۦ ۖ فَإِذَآ","بِهِۦ مَن يَشَآءُ",187],["31:17:12",412,"أَصَابَكَ ۖ","befalls you","وَٱصْبِرْ عَلَىٰ مَآ","إِنَّ ذَٰلِكَ مِنْ",187],["38:36:8",455,"أَصَابَ","he directed","بِأَمْرِهِۦ رُخَآءً حَيْثُ","",187],["39:51:1",464,"فَأَصَابَهُمْ","Then struck them","","سَيِّـَٔاتُ مَا كَسَبُوا۟ ۚ",187],["39:51:9",464,"سَيُصِيبُهُمْ","will strike them","ظَلَمُوا۟ مِنْ هَـٰٓؤُلَآءِ","سَيِّـَٔاتُ مَا كَسَبُوا۟",187],["40:28:28",470,"يُصِبْكُم","(there) will strike you","وَإِن يَكُ صَادِقًۭا","بَعْضُ ٱلَّذِى يَعِدُكُمْ ۖ",187],["42:30:2",486,"أَصَـٰبَكُم","befalls you","وَمَآ","مِّن مُّصِيبَةٍۢ فَبِمَا",187],["42:30:4",486,"مُّصِيبَةٍۢ","(the) misfortune","وَمَآ أَصَـٰبَكُم مِّن","فَبِمَا كَسَبَتْ أَيْدِيكُمْ",850],["42:39:3",487,"أَصَابَهُمُ","strikes them","وَٱلَّذِينَ إِذَآ","ٱلْبَغْىُ هُمْ يَنتَصِرُونَ",187],["42:48:20",488,"تُصِبْهُمْ","befalls them","فَرِحَ بِهَا ۖ وَإِن","سَيِّئَةٌۢ بِمَا قَدَّمَتْ",187],["48:25:22",514,"فَتُصِيبَكُم","and would befall you","تَعْلَمُوهُمْ أَن تَطَـُٔوهُمْ","مِّنْهُم مَّعَرَّةٌۢ بِغَيْرِ",187],["49:6:10",516,"تُصِيبُوا۟","you harm","بِنَبَإٍۢ فَتَبَيَّنُوٓا۟ أَن","قَوْمًۢا بِجَهَـٰلَةٍۢ فَتُصْبِحُوا۟",187],["57:22:2",540,"أَصَابَ","strikes","مَآ","مِن مُّصِيبَةٍۢ فِى",187],["57:22:4",540,"مُّصِيبَةٍۢ","disaster","مَآ أَصَابَ مِن","فِى ٱلْأَرْضِ وَلَا",850],["64:11:2",557,"أَصَابَ","strikes","مَآ","مِن مُّصِيبَةٍ إِلَّا",187],["64:11:4",557,"مُّصِيبَةٍ","disaster","مَآ أَصَابَ مِن","إِلَّا بِإِذْنِ ٱللَّهِ ۗ",850],["78:38:14",583,"صَوَابًۭا","(what is) correct","لَهُ ٱلرَّحْمَـٰنُ وَقَالَ","",3255]]