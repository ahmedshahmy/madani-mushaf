[["2:113:3",18,"لَيْسَتِ","Not","وَقَالَتِ ٱلْيَهُودُ","ٱلنَّصَـٰرَىٰ عَلَىٰ شَىْءٍۢ",119],["2:113:9",18,"لَيْسَتِ","Not","شَىْءٍۢ وَقَالَتِ ٱلنَّصَـٰرَىٰ","ٱلْيَهُودُ عَلَىٰ شَىْءٍۢ",119],["2:177:1",27,"۞ لَّيْسَ","It is not","","ٱلْبِرَّ أَن تُوَلُّوا۟",119],["2:189:9",29,"وَلَيْسَ","And it is not","مَوَٰقِيتُ لِلنَّاسِ وَٱلْحَجِّ ۗ","ٱلْبِرُّ بِأَن تَأْتُوا۟",119],["2:198:1",31,"لَيْسَ","Not is","","عَلَيْكُمْ جُنَاحٌ أَن",119],["2:249:13",41,"فَلَيْسَ","then he is not","فَمَن شَرِبَ مِنْهُ","مِنِّى وَمَن لَّمْ",119],["2:267:19",45,"وَلَسْتُم","while you (would) not","ٱلْخَبِيثَ مِنْهُ تُنفِقُونَ","بِـَٔاخِذِيهِ إِلَّآ أَن",119],["2:272:1",46,"۞ لَّيْسَ","Not","","عَلَيْكَ هُدَىٰهُمْ وَلَـٰكِنَّ",119],["2:282:103",48,"فَلَيْسَ","then not","حَاضِرَةًۭ تُدِيرُونَهَا بَيْنَكُمْ","عَلَيْكُمْ جُنَاحٌ أَلَّا",119],["3:28:12",53,"فَلَيْسَ","then not he (has)","وَمَن يَفْعَلْ ذَٰلِكَ","مِنَ ٱللَّهِ فِى",119],["3:36:12",54,"وَلَيْسَ","and is not","أَعْلَمُ بِمَا وَضَعَتْ","ٱلذَّكَرُ كَٱلْأُنثَىٰ ۖ وَإِنِّى",119],["3:66:11",58,"لَيْسَ","not","فَلِمَ تُحَآجُّونَ فِيمَا","لَكُم بِهِۦ عِلْمٌۭ ۚ",119],["3:75:26",59,"لَيْسَ","Not","ذَٰلِكَ بِأَنَّهُمْ قَالُوا۟","عَلَيْنَا فِى ٱلْأُمِّيِّـۧنَ",119],["3:113:1",64,"۞ لَيْسُوا۟","They are not","","سَوَآءًۭ ۗ مِّنْ أَهْلِ",119],["3:128:1",66,"لَيْسَ","Not","","لَكَ مِنَ ٱلْأَمْرِ",119],["3:167:27",72,"لَيْسَ","was not","يَقُولُونَ بِأَفْوَٰهِهِم مَّا","فِى قُلُوبِهِمْ ۗ وَٱللَّهُ",119],["3:182:7",74,"لَيْسَ","is not","أَيْدِيكُمْ وَأَنَّ ٱللَّهَ","بِظَلَّامٍۢ لِّلْعَبِيدِ",119],["4:18:1",80,"وَلَيْسَتِ","And not","","ٱلتَّوْبَةُ لِلَّذِينَ يَعْمَلُونَ",119],["4:94:16",93,"لَسْتَ","You are not","أَلْقَىٰٓ إِلَيْكُمُ ٱلسَّلَـٰمَ","مُؤْمِنًۭا تَبْتَغُونَ عَرَضَ",119],["4:101:5",94,"فَلَيْسَ","then not","ضَرَبْتُمْ فِى ٱلْأَرْضِ","عَلَيْكُمْ جُنَاحٌ أَن",119],["4:123:1",98,"لَّيْسَ","Not","","بِأَمَانِيِّكُمْ وَلَآ أَمَانِىِّ",119],["4:176:10",106,"لَيْسَ","(and) not","إِنِ ٱمْرُؤٌا۟ هَلَكَ","لَهُۥ وَلَدٌۭ وَلَهُۥٓ",119],["5:68:4",119,"لَسْتُمْ","You are not","قُلْ يَـٰٓأَهْلَ ٱلْكِتَـٰبِ","عَلَىٰ شَىْءٍ حَتَّىٰ",119],["5:93:1",123,"لَيْسَ","Not","","عَلَى ٱلَّذِينَ ءَامَنُوا۟",119],["5:116:24",127,"لَيْسَ","not","أَنْ أَقُولَ مَا","لِى بِحَقٍّ ۚ إِن",119],["6:30:8",131,"أَلَيْسَ","Is not","عَلَىٰ رَبِّهِمْ ۚ قَالَ","هَـٰذَا بِٱلْحَقِّ ۚ قَالُوا۟",119],["6:51:9",133,"لَيْسَ","not","يُحْشَرُوٓا۟ إِلَىٰ رَبِّهِمْ ۙ","لَهُم مِّن دُونِهِۦ",119],["6:53:12",134,"أَلَيْسَ","is not","عَلَيْهِم مِّنۢ بَيْنِنَآ ۗ","ٱللَّهُ بِأَعْلَمَ بِٱلشَّـٰكِرِينَ",119],["6:66:7",135,"لَّسْتُ","I am not","وَهُوَ ٱلْحَقُّ ۚ قُل","عَلَيْكُم بِوَكِيلٍۢ",119],["6:70:17",136,"لَيْسَ","not","نَفْسٌۢ بِمَا كَسَبَتْ","لَهَا مِن دُونِ",119],["6:89:15",138,"لَّيْسُوا۟","who are not","وَكَّلْنَا بِهَا قَوْمًۭا","بِهَا بِكَـٰفِرِينَ",119],["6:122:16",143,"لَيْسَ","not","مَّثَلُهُۥ فِى ٱلظُّلُمَـٰتِ","بِخَارِجٍۢ مِّنْهَا ۚ كَذَٰلِكَ",119],["6:159:7",150,"لَّسْتَ","you are not","دِينَهُمْ وَكَانُوا۟ شِيَعًۭا","مِنْهُمْ فِى شَىْءٍ ۚ",119],["7:61:3",158,"لَيْسَ","There is not","قَالَ يَـٰقَوْمِ","بِى ضَلَـٰلَةٌۭ وَلَـٰكِنِّى",119],["7:67:3",158,"لَيْسَ","There is not","قَالَ يَـٰقَوْمِ","بِى سَفَاهَةٌۭ وَلَـٰكِنِّى",119],["7:172:13",173,"أَلَسْتُ","Am I not","وَأَشْهَدَهُمْ عَلَىٰٓ أَنفُسِهِمْ","بِرَبِّكُمْ ۖ قَالُوا۟ بَلَىٰ ۛ",119],["8:51:7",183,"لَيْسَ","(is) not","أَيْدِيكُمْ وَأَنَّ ٱللَّهَ","بِظَلَّـٰمٍۢ لِّلْعَبِيدِ",119],["9:91:1",201,"لَّيْسَ","Not","","عَلَى ٱلضُّعَفَآءِ وَلَا",119],["11:8:14",222,"لَيْسَ","not","أَلَا يَوْمَ يَأْتِيهِمْ","مَصْرُوفًا عَنْهُمْ وَحَاقَ",119],["11:16:3",223,"لَيْسَ","(is) not","أُو۟لَـٰٓئِكَ ٱلَّذِينَ","لَهُمْ فِى ٱلْـَٔاخِرَةِ",119],["11:46:4",227,"لَيْسَ","(is) not","قَالَ يَـٰنُوحُ إِنَّهُۥ","مِنْ أَهْلِكَ ۖ إِنَّهُۥ",119],["11:46:14",227,"لَيْسَ","not","فَلَا تَسْـَٔلْنِ مَا","لَكَ بِهِۦ عِلْمٌ ۖ",119],["11:47:9",227,"لَيْسَ","not","أَنْ أَسْـَٔلَكَ مَا","لِى بِهِۦ عِلْمٌۭ ۖ",119],["11:78:23",230,"أَلَيْسَ","Is (there) not","تُخْزُونِ فِى ضَيْفِىٓ ۖ","مِنكُمْ رَجُلٌۭ رَّشِيدٌۭ",119],["11:81:27",230,"أَلَيْسَ","Is not","إِنَّ مَوْعِدَهُمُ ٱلصُّبْحُ ۚ","ٱلصُّبْحُ بِقَرِيبٍۢ",119],["13:43:4",255,"لَسْتَ","You are not","وَيَقُولُ ٱلَّذِينَ كَفَرُوا۟","مُرْسَلًۭا ۚ قُلْ كَفَىٰ",119],["15:20:6",263,"لَّسْتُمْ","you are not","فِيهَا مَعَـٰيِشَ وَمَن","لَهُۥ بِرَٰزِقِينَ",119],["15:42:3",264,"لَيْسَ","not","إِنَّ عِبَادِى","لَكَ عَلَيْهِمْ سُلْطَـٰنٌ",119],["16:99:2",278,"لَيْسَ","not","إِنَّهُۥ","لَهُۥ سُلْطَـٰنٌ عَلَى",119],["17:36:4",285,"لَيْسَ","not","وَلَا تَقْفُ مَا","لَكَ بِهِۦ عِلْمٌ ۚ",119],["17:65:3",288,"لَيْسَ","not","إِنَّ عِبَادِى","لَكَ عَلَيْهِمْ سُلْطَـٰنٌۭ ۚ",119],["22:10:7",333,"لَيْسَ","is not","يَدَاكَ وَأَنَّ ٱللَّهَ","بِظَلَّـٰمٍۢ لِّلْعَبِيدِ",119],["22:71:11",340,"لَيْسَ","not","بِهِۦ سُلْطَـٰنًۭا وَمَا","لَهُم بِهِۦ عِلْمٌۭ ۗ",119],["24:15:7",351,"لَيْسَ","not","وَتَقُولُونَ بِأَفْوَاهِكُم مَّا","لَكُم بِهِۦ عِلْمٌۭ",119],["24:29:1",353,"لَّيْسَ","Not","","عَلَيْكُمْ جُنَاحٌ أَن",119],["24:58:31",357,"لَيْسَ","Not","ثَلَـٰثُ عَوْرَٰتٍۢ لَّكُمْ ۚ","عَلَيْكُمْ وَلَا عَلَيْهِمْ",119],["24:60:8",358,"فَلَيْسَ","then not is","لَا يَرْجُونَ نِكَاحًۭا","عَلَيْهِنَّ جُنَاحٌ أَن",119],["24:61:1",358,"لَّيْسَ","Not is","","عَلَى ٱلْأَعْمَىٰ حَرَجٌۭ",119],["24:61:50",358,"لَيْسَ","Not is","مَّفَاتِحَهُۥٓ أَوْ صَدِيقِكُمْ ۚ","عَلَيْكُمْ جُنَاحٌ أَن",119],["29:8:10",397,"لَيْسَ","not","لِتُشْرِكَ بِى مَا","لَكَ بِهِۦ عِلْمٌۭ",119],["29:10:25",397,"أَوَلَيْسَ","Is not","إِنَّا كُنَّا مَعَكُمْ ۚ","ٱللَّهُ بِأَعْلَمَ بِمَا",119],["29:68:13",404,"أَلَيْسَ","Is there not","بِٱلْحَقِّ لَمَّا جَآءَهُۥٓ ۚ","فِى جَهَنَّمَ مَثْوًۭى",119],["31:15:8",412,"لَيْسَ","not","تُشْرِكَ بِى مَا","لَكَ بِهِۦ عِلْمٌۭ",119],["33:5:15",418,"وَلَيْسَ","But not is","فِى ٱلدِّينِ وَمَوَٰلِيكُمْ ۚ","عَلَيْكُمْ جُنَاحٌۭ فِيمَآ",119],["33:32:3",422,"لَسْتُنَّ","You are not","يَـٰنِسَآءَ ٱلنَّبِىِّ","كَأَحَدٍۢ مِّنَ ٱلنِّسَآءِ ۚ",119],["36:81:1",445,"أَوَلَيْسَ","Is it not","","ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ",119],["39:32:11",462,"أَلَيْسَ","Is (there) not","بِٱلصِّدْقِ إِذْ جَآءَهُۥٓ ۚ","فِى جَهَنَّمَ مَثْوًۭى",119],["39:36:1",462,"أَلَيْسَ","Is not","","ٱللَّهُ بِكَافٍ عَبْدَهُۥ ۖ",119],["39:37:8",462,"أَلَيْسَ","Is not","لَهُۥ مِن مُّضِلٍّ ۗ","ٱللَّهُ بِعَزِيزٍۢ ذِى",119],["39:60:10",465,"أَلَيْسَ","Is (there) not","ٱللَّهِ وُجُوهُهُم مُّسْوَدَّةٌ ۚ","فِى جَهَنَّمَ مَثْوًۭى",119],["40:42:7",472,"لَيْسَ","not","وَأُشْرِكَ بِهِۦ مَا","لِى بِهِۦ عِلْمٌۭ",119],["40:43:6",472,"لَيْسَ","not","أَنَّمَا تَدْعُونَنِىٓ إِلَيْهِ","لَهُۥ دَعْوَةٌۭ فِى",119],["42:11:14",484,"لَيْسَ","(There) is not","أَزْوَٰجًۭا ۖ يَذْرَؤُكُمْ فِيهِ ۚ","كَمِثْلِهِۦ شَىْءٌۭ ۖ وَهُوَ",119],["43:51:7",493,"أَلَيْسَ","Is not","قَوْمِهِۦ قَالَ يَـٰقَوْمِ","لِى مُلْكُ مِصْرَ",119],["46:32:6",506,"فَلَيْسَ","then not","يُجِبْ دَاعِىَ ٱللَّهِ","بِمُعْجِزٍۢ فِى ٱلْأَرْضِ",119],["46:32:10",506,"وَلَيْسَ","and not","بِمُعْجِزٍۢ فِى ٱلْأَرْضِ","لَهُۥ مِن دُونِهِۦٓ",119],["46:34:7",506,"أَلَيْسَ","Is not","كَفَرُوا۟ عَلَى ٱلنَّارِ","هَـٰذَا بِٱلْحَقِّ ۖ قَالُوا۟",119],["48:11:14",512,"لَيْسَ","is not","يَقُولُونَ بِأَلْسِنَتِهِم مَّا","فِى قُلُوبِهِمْ ۚ قُلْ",119],["48:17:1",513,"لَّيْسَ","Not is","","عَلَى ٱلْأَعْمَىٰ حَرَجٌۭ",119],["53:39:2",527,"لَّيْسَ","is not","وَأَن","لِلْإِنسَـٰنِ إِلَّا مَا",119],["53:58:1",528,"لَيْسَ","Not is","","لَهَا مِن دُونِ",119],["56:2:1",534,"لَيْسَ","Not","","لِوَقْعَتِهَا كَاذِبَةٌ",119],["58:10:8",543,"وَلَيْسَ","but not","لِيَحْزُنَ ٱلَّذِينَ ءَامَنُوا۟","بِضَآرِّهِمْ شَيْـًٔا إِلَّا",119],["69:35:1",567,"فَلَيْسَ","So not","","لَهُ ٱلْيَوْمَ هَـٰهُنَا",119],["70:2:2",568,"لَيْسَ","not","لِّلْكَـٰفِرِينَ","لَهُۥ دَافِعٌۭ",119],["75:40:1",578,"أَلَيْسَ","Is not","","ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ",119],["88:6:1",592,"لَّيْسَ","Not is","","لَهُمْ طَعَامٌ إِلَّا",119],["88:22:1",592,"لَّسْتَ","You are not","","عَلَيْهِم بِمُصَيْطِرٍ",119],["95:8:1",597,"أَلَيْسَ","Is not","","ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ",119]]