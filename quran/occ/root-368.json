[["2:227:3",36,"ٱلطَّلَـٰقَ","(on) [the] divorce","وَإِنْ عَزَمُوا۟","فَإِنَّ ٱللَّهَ سَمِيعٌ",2313],["2:228:1",36,"وَٱلْمُطَلَّقَـٰتُ","And the women who are divorced","","يَتَرَبَّصْنَ بِأَنفُسِهِنَّ ثَلَـٰثَةَ",2486],["2:229:1",36,"ٱلطَّلَـٰقُ","The divorce","","مَرَّتَانِ ۖ فَإِمْسَاكٌۢ بِمَعْرُوفٍ",2313],["2:230:2",36,"طَلَّقَهَا","he divorces her","فَإِن","فَلَا تَحِلُّ لَهُۥ",828],["2:230:13",36,"طَلَّقَهَا","he divorces her","زَوْجًا غَيْرَهُۥ ۗ فَإِن","فَلَا جُنَاحَ عَلَيْهِمَآ",828],["2:231:2",37,"طَلَّقْتُمُ","you divorce","وَإِذَا","ٱلنِّسَآءَ فَبَلَغْنَ أَجَلَهُنَّ",828],["2:232:2",37,"طَلَّقْتُمُ","you divorce","وَإِذَا","ٱلنِّسَآءَ فَبَلَغْنَ أَجَلَهُنَّ",828],["2:236:5",38,"طَلَّقْتُمُ","you divorce","جُنَاحَ عَلَيْكُمْ إِن","ٱلنِّسَآءَ مَا لَمْ",828],["2:237:2",38,"طَلَّقْتُمُوهُنَّ","you divorce them","وَإِن","مِن قَبْلِ أَن",828],["2:241:1",39,"وَلِلْمُطَلَّقَـٰتِ","And for the divorced women","","مَتَـٰعٌۢ بِٱلْمَعْرُوفِ ۖ حَقًّا",2486],["18:71:1",301,"فَٱنطَلَقَا","So they both set out","","حَتَّىٰٓ إِذَا رَكِبَا",945],["18:74:1",301,"فَٱنطَلَقَا","Then they both set out","","حَتَّىٰٓ إِذَا لَقِيَا",945],["18:77:1",302,"فَٱنطَلَقَا","So they set out","","حَتَّىٰٓ إِذَآ أَتَيَآ",945],["26:13:4",367,"يَنطَلِقُ","expresses well","وَيَضِيقُ صَدْرِى وَلَا","لِسَانِى فَأَرْسِلْ إِلَىٰ",945],["33:49:8",424,"طَلَّقْتُمُوهُنَّ","divorce them","نَكَحْتُمُ ٱلْمُؤْمِنَـٰتِ ثُمَّ","مِن قَبْلِ أَن",828],["38:6:1",453,"وَٱنطَلَقَ","And went forth","","ٱلْمَلَأُ مِنْهُمْ أَنِ",945],["48:15:4",512,"ٱنطَلَقْتُمْ","you set forth","سَيَقُولُ ٱلْمُخَلَّفُونَ إِذَا","إِلَىٰ مَغَانِمَ لِتَأْخُذُوهَا",945],["65:1:4",558,"طَلَّقْتُمُ","you divorce","يَـٰٓأَيُّهَا ٱلنَّبِىُّ إِذَا","ٱلنِّسَآءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ",828],["65:1:6",558,"فَطَلِّقُوهُنَّ","then divorce them","إِذَا طَلَّقْتُمُ ٱلنِّسَآءَ","لِعِدَّتِهِنَّ وَأَحْصُوا۟ ٱلْعِدَّةَ ۖ",828],["66:5:4",560,"طَلَّقَكُنَّ","he divorced you","عَسَىٰ رَبُّهُۥٓ إِن","أَن يُبْدِلَهُۥٓ أَزْوَٰجًا",828],["68:23:1",565,"فَٱنطَلَقُوا۟","So they went","","وَهُمْ يَتَخَـٰفَتُونَ",945],["77:29:1",581,"ٱنطَلِقُوٓا۟","Proceed","","إِلَىٰ مَا كُنتُم",945],["77:30:1",581,"ٱنطَلِقُوٓا۟","Proceed","","إِلَىٰ ظِلٍّۢ ذِى",945]]