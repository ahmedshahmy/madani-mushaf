[["3:119:17",65,"ٱلْأَنَامِلَ","the finger tips","خَلَوْا۟ عَضُّوا۟ عَلَيْكُمُ","مِنَ ٱلْغَيْظِ ۚ قُلْ",3019],["27:18:6",378,"ٱلنَّمْلِ","(of) the ants","أَتَوْا۟ عَلَىٰ وَادِ","قَالَتْ نَمْلَةٌۭ يَـٰٓأَيُّهَا",2570],["27:18:8",378,"نَمْلَةٌۭ","an ant","وَادِ ٱلنَّمْلِ قَالَتْ","يَـٰٓأَيُّهَا ٱلنَّمْلُ ٱدْخُلُوا۟",4039],["27:18:10",378,"ٱلنَّمْلُ","ants","قَالَتْ نَمْلَةٌۭ يَـٰٓأَيُّهَا","ٱدْخُلُوا۟ مَسَـٰكِنَكُمْ لَا",2570]]