[["18:18:19",295,"فِرَارًۭا","(in) flight","عَلَيْهِمْ لَوَلَّيْتَ مِنْهُمْ","وَلَمُلِئْتَ مِنْهُمْ رُعْبًۭا",1548],["26:21:1",368,"فَفَرَرْتُ","So I fled","","مِنكُمْ لَمَّا خِفْتُكُمْ",1178],["33:13:25",419,"فِرَارًۭا","to flee","إِن يُرِيدُونَ إِلَّا","",1548],["33:16:4",420,"ٱلْفِرَارُ","the fleeing","قُل لَّن يَنفَعَكُمُ","إِن فَرَرْتُم مِّنَ",1548],["33:16:6",420,"فَرَرْتُم","you flee","يَنفَعَكُمُ ٱلْفِرَارُ إِن","مِّنَ ٱلْمَوْتِ أَوِ",1178],["51:50:1",522,"فَفِرُّوٓا۟","So flee","","إِلَى ٱللَّهِ ۖ إِنِّى",1178],["62:8:5",553,"تَفِرُّونَ","you flee","إِنَّ ٱلْمَوْتَ ٱلَّذِى","مِنْهُ فَإِنَّهُۥ مُلَـٰقِيكُمْ ۖ",1178],["71:6:5",570,"فِرَارًۭا","(in) flight","يَزِدْهُمْ دُعَآءِىٓ إِلَّا","",1548],["74:51:1",577,"فَرَّتْ","Fleeing","","مِن قَسْوَرَةٍۭ",1178],["75:10:5",577,"ٱلْمَفَرُّ","(is) the escape","ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ","",3659],["80:34:2",585,"يَفِرُّ","will flee","يَوْمَ","ٱلْمَرْءُ مِنْ أَخِيهِ",1178]]