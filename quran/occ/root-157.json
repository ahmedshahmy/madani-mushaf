ُونَ","they put their trust","صَبَرُوا۟ وَعَلَىٰ رَبِّهِمْ","",292],["16:99:10",278,"يَتَوَكَّلُونَ","they put their trust","ءَامَنُوا۟ وَعَلَىٰ رَبِّهِمْ","",292],["17:2:12",282,"وَكِيلًۭا","(as) a Disposer of affairs","تَتَّخِذُوا۟ مِن دُونِى","",444],["17:54:14",287,"وَكِيلًۭا","(as) a guardian","وَمَآ أَرْسَلْنَـٰكَ عَلَيْهِمْ","",444],["17:65:9",288,"وَكِيلًۭا","(as) a Guardian","سُلْطَـٰنٌۭ ۚ وَكَفَىٰ بِرَبِّكَ","",444],["17:68:15",289,"وَكِيلًا","a guardian","لَا تَجِدُوا۟ لَكُمْ","",444],["17:86:13",290,"وَكِيلًا","any advocate","لَكَ بِهِۦ عَلَيْنَا","",444],["25:43:9",363,"وَكِيلًا","a guardian","أَفَأَنتَ تَكُونُ عَلَيْهِ","",444],["25:58:1",365,"وَتَوَكَّلْ","And put your trust","","عَلَى ٱلْحَىِّ ٱلَّذِى",292],["26:217:1",376,"وَتَوَكَّلْ","And put (your) trust","","عَلَى ٱلْعَزِيزِ ٱلرَّحِيمِ",292],["27:79:1",384,"فَتَوَكَّلْ","So put your trust","","عَلَى ٱللَّهِ ۖ إِنَّكَ",292],["28:28:15",388,"وَكِيلٌۭ","(is) a Witness","عَلَىٰ مَا نَقُولُ","",444],["29:59:5",403,"يَتَوَكَّلُونَ","put their trust","صَبَرُوا۟ وَعَلَىٰ رَبِّهِمْ","",292],["32:11:6",415,"وُكِّلَ","has been put in charge","مَّلَكُ ٱلْمَوْتِ ٱلَّذِى","بِكُمْ ثُمَّ إِلَىٰ",2721],["33:3:1",418,"وَتَوَكَّلْ","And put your trust","","عَلَى ٱللَّهِ ۚ وَكَفَىٰ",292],["33:3:6",418,"وَكِيلًۭا","(as) Disposer of affairs","ٱللَّهِ ۚ وَكَفَىٰ بِٱللَّهِ","",444],["33:48:7",424,"وَتَوَكَّلْ","and put your trust","وَٱلْمُنَـٰفِقِينَ وَدَعْ أَذَىٰهُمْ","عَلَى ٱللَّهِ ۚ وَكَفَىٰ",292],["33:48:12",424,"وَكِيلًۭا","(as) a Trustee","ٱللَّهِ ۚ وَكَفَىٰ بِٱللَّهِ","",444],["39:38:35",462,"يَتَوَكَّلُ","put trust","حَسْبِىَ ٱللَّهُ ۖ عَلَيْهِ","ٱلْمُتَوَكِّلُونَ",292],["39:38:36",462,"ٱلْمُتَوَكِّلُونَ","those who trust","ٱللَّهُ ۖ عَلَيْهِ يَتَوَكَّلُ","",1594],["39:41:18",463,"بِوَكِيلٍ","a manager","وَمَآ أَنتَ عَلَيْهِم","",444],["39:62:9",465,"وَكِيلٌۭ","a Guardian","عَلَىٰ كُلِّ شَىْءٍۢ","",444],["42:6:12",483,"بِوَكِيلٍۢ","a manager","وَمَآ أَنتَ عَلَيْهِم","",444],["42:10:13",483,"تَوَكَّلْتُ","I put my trust","ٱللَّهُ رَبِّى عَلَيْهِ","وَإِلَيْهِ أُنِيبُ",292],["42:36:17",487,"يَتَوَكَّلُونَ","put (their) trust","ءَامَنُوا۟ وَعَلَىٰ رَبِّهِمْ","",292],["58:10:16",543,"فَلْيَتَوَكَّلِ","let put (their) trust","ٱللَّهِ ۚ وَعَلَى ٱللَّهِ","ٱلْمُؤْمِنُونَ",292],["60:4:48",549,"تَوَكَّلْنَا","we put our trust","شَىْءٍۢ ۖ رَّبَّنَا عَلَيْكَ","وَإِلَيْكَ أَنَبْنَا وَإِلَيْكَ",292],["64:13:8",557,"فَلْيَتَوَكَّلِ","let put (their) trust","هُوَ ۚ وَعَلَى ٱللَّهِ","ٱلْمُؤْمِنُونَ",292],["65:3:7",558,"يَتَوَكَّلْ","puts his trust","لَا يَحْتَسِبُ ۚ وَمَن","عَلَى ٱللَّهِ فَهُوَ",292],["67:29:7",564,"تَوَكَّلْنَا ۖ","we put (our) trust","ءَامَنَّا بِهِۦ وَعَلَيْهِ","فَسَتَعْلَمُونَ مَنْ هُوَ",292],["73:9:9",574,"وَكِيلًۭا","(as) Disposer of Affairs","إِلَّا هُوَ فَٱتَّخِذْهُ","",444]]