[["3:122:11",66,"فَلْيَتَوَكَّلِ","let put (their) trust","وَلِيُّهُمَا ۗ وَعَلَى ٱللَّهِ","ٱلْمُؤْمِنُونَ",292],["3:159:24",71,"فَتَوَكَّلْ","then put trust","ٱلْأَمْرِ ۖ فَإِذَا عَزَمْتَ","عَلَى ٱللَّهِ ۚ إِنَّ",292],["3:159:30",71,"ٱلْمُتَوَكِّلِينَ","the ones who put trust (in Him)","إِنَّ ٱللَّهَ يُحِبُّ","",1594],["3:160:17",71,"فَلْيَتَوَكَّلِ","let put (their) trust","بَعْدِهِۦ ۗ وَعَلَى ٱللَّهِ","ٱلْمُؤْمِنُونَ",292],["3:173:17",72,"ٱلْوَكِيلُ","[the] Disposer of affairs","حَسْبُنَا ٱللَّهُ وَنِعْمَ","",444],["4:81:19",91,"وَتَوَكَّلْ","and put (your) trust","يُبَيِّتُونَ ۖ فَأَعْرِضْ عَنْهُمْ","عَلَى ٱللَّهِ ۚ وَكَفَىٰ",292],["4:81:24",91,"وَكِيلًا","(as) a Trustee","ٱللَّهِ ۚ وَكَفَىٰ بِٱللَّهِ","",444],["4:109:18",96,"وَكِيلًۭا","(their) defender","مَّن يَكُونُ عَلَيْهِمْ","",444],["4:132:10",99,"وَكِيلًا","(as) a Disposer of affairs","ٱلْأَرْضِ ۚ وَكَفَىٰ بِٱللَّهِ","",444],["4:171:53",105,"وَكِيلًۭا","(as) a Disposer of affairs","ٱلْأَرْضِ ۗ وَكَفَىٰ بِٱللَّهِ","",444],["5:11:22",109,"فَلْيَتَوَكَّلِ","so let put the trust","ٱللَّهَ ۚ وَعَلَى ٱللَّهِ","ٱلْمُؤْمِنُونَ",292],["5:23:18",111,"فَتَوَكَّلُوٓا۟","then put your trust","غَـٰلِبُونَ ۚ وَعَلَى ٱللَّهِ","إِن كُنتُم مُّؤْمِنِينَ",292],["6:66:9",135,"بِوَكِيلٍۢ","a manager","قُل لَّسْتُ عَلَيْكُم","",444],["6:89:12",138,"وَكَّلْنَا","We have entrusted","بِهَا هَـٰٓؤُلَآءِ فَقَدْ","بِهَا قَوْمًۭا لَّيْسُوا۟",2721],["6:102:16",141,"وَكِيلٌۭ","a Guardian","عَلَىٰ كُلِّ شَىْءٍۢ","",444],["6:107:13",141,"بِوَكِيلٍۢ","a manager","وَمَآ أَنتَ عَلَيْهِم","",444],["7:89:33",162,"تَوَكَّلْنَا ۚ","we put our trust","عِلْمًا ۚ عَلَى ٱللَّهِ","رَبَّنَا ٱفْتَحْ بَيْنَنَا",292],["8:2:17",177,"يَتَوَكَّلُونَ","they put their trust","إِيمَـٰنًۭا وَعَلَىٰ رَبِّهِمْ","",292],["8:49:12",183,"يَتَوَكَّلْ","puts (his) trust","هَـٰٓؤُلَآءِ دِينُهُمْ ۗ وَمَن","عَلَى ٱللَّهِ فَإِنَّ",292],["8:61:6",184,"وَتَوَكَّلْ","and put (your) trust","لِلسَّلْمِ فَٱجْنَحْ لَهَا","عَلَى ٱللَّهِ ۚ إِنَّهُۥ",292],["9:51:13",195,"فَلْيَ