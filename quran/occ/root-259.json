[["2:27:8",5,"وَيَقْطَعُونَ","and [they] cut","مِنۢ بَعْدِ مِيثَـٰقِهِۦ","مَآ أَمَرَ ٱللَّهُ",740],["2:166:10",25,"وَتَقَطَّعَتْ","[and] will be cut off","ٱتَّبَعُوا۟ وَرَأَوُا۟ ٱلْعَذَابَ","بِهِمُ ٱلْأَسْبَابُ",1407],["3:127:1",66,"لِيَقْطَعَ","That He may cut off","","طَرَفًۭا مِّنَ ٱلَّذِينَ",740],["5:33:16",113,"تُقَطَّعَ","be cut off","أَوْ يُصَلَّبُوٓا۟ أَوْ","أَيْدِيهِمْ وَأَرْجُلُهُم مِّنْ",739],["5:38:3",114,"فَٱقْطَعُوٓا۟","[then] cut off","وَٱلسَّارِقُ وَٱلسَّارِقَةُ","أَيْدِيَهُمَا جَزَآءًۢ بِمَا",740],["6:45:1",133,"فَقُطِعَ","So was cut off","","دَابِرُ ٱلْقَوْمِ ٱلَّذِينَ",740],["6:94:23",139,"تَّقَطَّعَ","have been severed (bonds)","فِيكُمْ شُرَكَـٰٓؤُا۟ ۚ لَقَد","بَيْنَكُمْ وَضَلَّ عَنكُم",1407],["7:72:6",159,"وَقَطَعْنَا","And We cut off","مَعَهُۥ بِرَحْمَةٍۢ مِّنَّا","دَابِرَ ٱلَّذِينَ كَذَّبُوا۟",740],["7:124:1",165,"لَأُقَطِّعَنَّ","I will surely cut off","","أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ",739],["7:160:1",171,"وَقَطَّعْنَـٰهُمُ","And We divided them","","ٱثْنَتَىْ عَشْرَةَ أَسْبَاطًا",739],["7:168:1",172,"وَقَطَّعْنَـٰهُمْ","And We divided them","","فِى ٱلْأَرْضِ أُمَمًۭا ۖ",739],["8:7:21",177,"وَيَقْطَعَ","and cut off","يُحِقَّ ٱلْحَقَّ بِكَلِمَـٰتِهِۦ","دَابِرَ ٱلْكَـٰفِرِينَ",740],["9:110:11",204,"تَقَطَّعَ","(are) cut into pieces","قُلُوبِهِمْ إِلَّآ أَن","قُلُوبُهُمْ ۗ وَٱللَّهُ عَلِيمٌ",1407],["9:121:8",206,"يَقْطَعُونَ","they cross","وَلَا كَبِيرَةًۭ وَلَا","وَادِيًا إِلَّا كُتِبَ",740],["10:27:18",212,"قِطَعًۭا","(with) pieces","كَأَنَّمَآ أُغْشِيَتْ وُجُوهُهُمْ","مِّنَ ٱلَّيْلِ مُظْلِمًا ۚ",2584],["11:81:11",230,"بِقِطْعٍۢ","in a part","إِلَيْكَ ۖ فَأَسْرِ بِأَهْلِكَ","مِّنَ ٱلَّيْلِ وَلَا",2585],["12:31:20",239,"وَقَطَّعْنَ","and cut","فَلَمَّا رَأَيْنَهُۥٓ أَكْبَرْنَهُۥ","أَيْدِيَهُنَّ وَقُلْنَ حَـٰشَ",739],["12:50:17",241,"قَطَّعْنَ","cut","بَالُ ٱلنِّسْوَةِ ٱلَّـٰتِى","أَيْدِيَهُنَّ ۚ إِنَّ رَبِّى",739],["13:4:3",249,"قِطَعٌۭ","are tracks","وَفِى ٱلْأَرْضِ","مُّتَجَـٰوِرَٰتٌۭ وَجَنَّـٰتٌۭ مِّنْ",2584],["13:25:8",252,"وَيَقْطَعُونَ","and sever","مِنۢ بَعْدِ مِيثَـٰقِهِۦ","مَآ أَمَرَ ٱللَّهُ",740],["13:31:8",253,"قُطِّعَتْ","could be cloven asunder","بِهِ ٱلْجِبَالُ أَوْ","بِهِ ٱلْأَرْضُ أَوْ",739],["15:65:3",265,"بِقِطْعٍۢ","in a portion","فَأَسْرِ بِأَهْلِكَ","مِّنَ ٱلَّيْلِ وَٱتَّبِعْ",2585],["15:66:8",265,"مَقْطُوعٌۭ","would be cut off","أَنَّ دَابِرَ هَـٰٓؤُلَآءِ","مُّصْبِحِينَ",3694],["20:71:13",316,"فَلَأُقَطِّعَنَّ","So surely I will cut off","ٱلَّذِى عَلَّمَكُمُ ٱلسِّحْرَ ۖ","أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ",739],["21:93:1",330,"وَتَقَطَّعُوٓا۟","But they cut off","","أَمْرَهُم بَيْنَهُمْ ۖ كُلٌّ",1407],["22:15:16",333,"لْيَقْطَعْ","let him cut off","إِلَى ٱلسَّمَآءِ ثُمَّ","فَلْيَنظُرْ هَلْ يُذْهِبَنَّ",740],["22:19:8",334,"قُطِّعَتْ","will be cut out","رَبِّهِمْ ۖ فَٱلَّذِينَ كَفَرُوا۟","لَهُمْ ثِيَابٌۭ مِّن",739],["23:53:1",345,"فَتَقَطَّعُوٓا۟","But they cut off","","أَمْرَهُم بَيْنَهُمْ زُبُرًۭا ۖ",1407],["26:49:15",369,"لَأُقَطِّعَنَّ","I will surely cut off","ٱلسِّحْرَ فَلَسَوْفَ تَعْلَمُونَ ۚ","أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ",739],["27:32:9",379,"قَاطِعَةً","the one to decide","أَمْرِى مَا كُنتُ","أَمْرًا حَتَّىٰ تَشْهَدُونِ",4104],["29:29:4",399,"وَتَقْطَعُونَ","and you cut off","أَئِنَّكُمْ لَتَأْتُونَ ٱلرِّجَالَ","ٱلسَّبِيلَ وَتَأْتُونَ فِى",740],["47:15:43",508,"فَقَطَّعَ","so it cuts into pieces","وَسُقُوا۟ مَآءً حَمِيمًۭا","أَمْعَآءَهُمْ",739],["47:22:9",509,"وَتُقَطِّعُوٓا۟","and cut off","تُفْسِدُوا۟ فِى ٱلْأَرْضِ","أَرْحَامَكُمْ",739],["56:33:2",535,"مَقْطُوعَةٍۢ","limited","لَّا","وَلَا مَمْنُوعَةٍۢ",3695],["59:5:2",546,"قَطَعْتُم","you cut down","مَا","مِّن لِّينَةٍ أَوْ",740],["69:46:2",568,"لَقَطَعْنَا","certainly We (would) have cut off","ثُمَّ","مِنْهُ ٱلْوَتِينَ",740]]