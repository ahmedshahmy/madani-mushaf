[["5:48:28",116,"شِرْعَةًۭ","a law","لِكُلٍّۢ جَعَلْنَا مِنكُمْ","وَمِنْهَاجًۭا ۚ وَلَوْ شَآءَ",2883],["7:163:17",171,"شُرَّعًۭا","visibly","حِيتَانُهُمْ يَوْمَ سَبْتِهِمْ","وَيَوْمَ لَا يَسْبِتُونَ ۙ",2894],["42:13:1",484,"۞ شَرَعَ","He has ordained","","لَكُم مِّنَ ٱلدِّينِ",2121],["42:21:4",485,"شَرَعُوا۟","who have ordained","أَمْ لَهُمْ شُرَكَـٰٓؤُا۟","لَهُم مِّنَ ٱلدِّينِ",2121],["45:18:4",500,"شَرِيعَةٍۢ","an ordained way","ثُمَّ جَعَلْنَـٰكَ عَلَىٰ","مِّنَ ٱلْأَمْرِ فَٱتَّبِعْهَا",2873]]