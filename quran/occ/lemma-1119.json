[["3:37:9",54,"زَكَرِيَّا ۖ","(of) Zakariya","نَبَاتًا حَسَنًۭا وَكَفَّلَهَا","كُلَّمَا دَخَلَ عَلَيْهَا",1119],["3:37:13",54,"زَكَرِيَّا","Zakariya","كُلَّمَا دَخَلَ عَلَيْهَا","ٱلْمِحْرَابَ وَجَدَ عِندَهَا",1119],["3:38:3",55,"زَكَرِيَّا","Zakariya","هُنَالِكَ دَعَا","رَبَّهُۥ ۖ قَالَ رَبِّ",1119],["6:85:1",138,"وَزَكَرِيَّا","And Zakariya","","وَيَحْيَىٰ وَعِيسَىٰ وَإِلْيَاسَ ۖ",1119],["19:2:5",305,"زَكَرِيَّآ","Zakariya","رَحْمَتِ رَبِّكَ عَبْدَهُۥ","",1119],["19:7:1",305,"يَـٰزَكَرِيَّآ","O Zakariya","","إِنَّا نُبَشِّرُكَ بِغُلَـٰمٍ",1119],["21:89:1",329,"وَزَكَرِيَّآ","And Zakariya","","إِذْ نَادَىٰ رَبَّهُۥ",1119]]