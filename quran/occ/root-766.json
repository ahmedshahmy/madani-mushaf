[["15:94:1",267,"فَٱصْدَعْ","So proclaim","","بِمَا تُؤْمَرُ وَأَعْرِضْ",4789],["30:43:16",409,"يَصَّدَّعُونَ","they will be divided","مِنَ ٱللَّهِ ۖ يَوْمَئِذٍۢ","",4618],["56:19:2",535,"يُصَدَّعُونَ","they will get headache","لَّا","عَنْهَا وَلَا يُنزِفُونَ",4706],["59:21:9",548,"مُّتَصَدِّعًۭا","breaking asunder","جَبَلٍۢ لَّرَأَيْتَهُۥ خَـٰشِعًۭا","مِّنْ خَشْيَةِ ٱللَّهِ ۚ",3997],["86:12:3",591,"ٱلصَّدْعِ","cracks open","وَٱلْأَرْضِ ذَاتِ","",3279]]