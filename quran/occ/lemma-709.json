[["2:125:15",19,"وَإِسْمَـٰعِيلَ","and Ishmael","وَعَهِدْنَآ إِلَىٰٓ إِبْرَٰهِـۧمَ","أَن طَهِّرَا بَيْتِىَ",709],["2:127:7",20,"وَإِسْمَـٰعِيلُ","and Ishmael","ٱلْقَوَاعِدَ مِنَ ٱلْبَيْتِ","رَبَّنَا تَقَبَّلْ مِنَّآ ۖ",709],["2:133:21",20,"وَإِسْمَـٰعِيلَ","and Ishmael","وَإِلَـٰهَ ءَابَآئِكَ إِبْرَٰهِـۧمَ","وَإِسْحَـٰقَ إِلَـٰهًۭا وَٰحِدًۭا",709],["2:136:11",21,"وَإِسْمَـٰعِيلَ","and Ishmael","أُنزِلَ إِلَىٰٓ إِبْرَٰهِـۧمَ","وَإِسْحَـٰقَ وَيَعْقُوبَ وَٱلْأَسْبَاطِ",709],["2:140:5",21,"وَإِسْمَـٰعِيلَ","and Ishmael","تَقُولُونَ إِنَّ إِبْرَٰهِـۧمَ","وَإِسْحَـٰقَ وَيَعْقُوبَ وَٱلْأَسْبَاطَ",709],["3:84:11",61,"وَإِسْمَـٰعِيلَ","and Ishmael","أُنزِلَ عَلَىٰٓ إِبْرَٰهِيمَ","وَإِسْحَـٰقَ وَيَعْقُوبَ وَٱلْأَسْبَاطِ",709],["4:163:14",104,"وَإِسْمَـٰعِيلَ","and Ishmael","وَأَوْحَيْنَآ إِلَىٰٓ إِبْرَٰهِيمَ","وَإِسْحَـٰقَ وَيَعْقُوبَ وَٱلْأَسْبَاطِ",709],["6:86:1",138,"وَإِسْمَـٰعِيلَ","And Ishmael","","وَٱلْيَسَعَ وَيُونُسَ وَلُوطًۭا ۚ",709],["14:39:8",260,"إِسْمَـٰعِيلَ","Ishmael","لِى عَلَى ٱلْكِبَرِ","وَإِسْحَـٰقَ ۚ إِنَّ رَبِّى",709],["19:54:4",309,"إِسْمَـٰعِيلَ ۚ","Ishmael","وَٱذْكُرْ فِى ٱلْكِتَـٰبِ","إِنَّهُۥ كَانَ صَادِقَ",709],["21:85:1",329,"وَإِسْمَـٰعِيلَ","And Ishmael","","وَإِدْرِيسَ وَذَا ٱلْكِفْلِ ۖ",709],["38:48:2",456,"إِسْمَـٰعِيلَ","Ishmael","وَٱذْكُرْ","وَٱلْيَسَعَ وَذَا ٱلْكِفْلِ ۖ",709]]