[["2:184:16",28,"يُطِيقُونَهُۥ","can afford it","أُخَرَ ۚ وَعَلَى ٱلَّذِينَ","فِدْيَةٌۭ طَعَامُ مِسْكِينٍۢ ۖ",4711],["2:249:38",41,"طَاقَةَ","strength","مَعَهُۥ قَالُوا۟ لَا","لَنَا ٱلْيَوْمَ بِجَالُوتَ",2304],["2:286:36",49,"طَاقَةَ","(the) strength","تُحَمِّلْنَا مَا لَا","لَنَا بِهِۦ ۖ وَٱعْفُ",2304],["3:180:17",73,"سَيُطَوَّقُونَ","Their necks will be encircled","هُوَ شَرٌّۭ لَّهُمْ ۖ","مَا بَخِلُوا۟ بِهِۦ",4710]]