[["2:71:18",11,"ٱلْـَٔـٰنَ","Now","شِيَةَ فِيهَا ۚ قَالُوا۟","جِئْتَ بِٱلْحَقِّ ۚ فَذَبَحُوهَا",968],["2:187:24",29,"فَٱلْـَٔـٰنَ","So now","عَلَيْكُمْ وَعَفَا عَنكُمْ ۖ","بَـٰشِرُوهُنَّ وَٱبْتَغُوا۟ مَا",968],["4:18:14",80,"ٱلْـَٔـٰنَ","now","قَالَ إِنِّى تُبْتُ","وَلَا ٱلَّذِينَ يَمُوتُونَ",968],["8:66:1",185,"ٱلْـَٔـٰنَ","Now","","خَفَّفَ ٱللَّهُ عَنكُمْ",968],["10:51:7",214,"ءَآلْـَٔـٰنَ","Now","وَقَعَ ءَامَنتُم بِهِۦٓ ۚ","وَقَدْ كُنتُم بِهِۦ",968],["10:91:1",219,"ءَآلْـَٔـٰنَ","Now","","وَقَدْ عَصَيْتَ قَبْلُ",968],["12:51:20",241,"ٱلْـَٔـٰنَ","Now","قَالَتِ ٱمْرَأَتُ ٱلْعَزِيزِ","حَصْحَصَ ٱلْحَقُّ أَنَا۠",968],["72:9:9",572,"ٱلْـَٔانَ","now","لِلسَّمْعِ ۖ فَمَن يَسْتَمِعِ","يَجِدْ لَهُۥ شِهَابًۭا",968]]