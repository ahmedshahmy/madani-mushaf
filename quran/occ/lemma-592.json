[["2:251:5",41,"دَاوُۥدُ","Dawood","بِإِذْنِ ٱللَّهِ وَقَتَلَ","جَالُوتَ وَءَاتَىٰهُ ٱللَّهُ",592],["4:163:24",104,"دَاوُۥدَ","(to) Dawood","وَهَـٰرُونَ وَسُلَيْمَـٰنَ ۚ وَءَاتَيْنَا","زَبُورًۭا",592],["5:78:9",121,"دَاوُۥدَ","(of) Dawood","إِسْرَٰٓءِيلَ عَلَىٰ لِسَانِ","وَعِيسَى ٱبْنِ مَرْيَمَ ۚ",592],["6:84:13",138,"دَاوُۥدَ","Dawood","قَبْلُ ۖ وَمِن ذُرِّيَّتِهِۦ","وَسُلَيْمَـٰنَ وَأَيُّوبَ وَيُوسُفَ",592],["17:55:14",287,"دَاوُۥدَ","Dawood","عَلَىٰ بَعْضٍۢ ۖ وَءَاتَيْنَا","زَبُورًۭا",592],["21:78:1",328,"وَدَاوُۥدَ","And Dawud","","وَسُلَيْمَـٰنَ إِذْ يَحْكُمَانِ",592],["21:79:9",328,"دَاوُۥدَ","Dawud","وَعِلْمًۭا ۚ وَسَخَّرْنَا مَعَ","ٱلْجِبَالَ يُسَبِّحْنَ وَٱلطَّيْرَ ۚ",592],["27:15:3",378,"دَاوُۥدَ","Dawood","وَلَقَدْ ءَاتَيْنَا","وَسُلَيْمَـٰنَ عِلْمًۭا ۖ وَقَالَا",592],["27:16:3",378,"دَاوُۥدَ ۖ","Dawood","وَوَرِثَ سُلَيْمَـٰنُ","وَقَالَ يَـٰٓأَيُّهَا ٱلنَّاسُ",592],["34:10:3",429,"دَاوُۥدَ","Dawood","۞ وَلَقَدْ ءَاتَيْنَا","مِنَّا فَضْلًۭا ۖ يَـٰجِبَالُ",592],["34:13:14",429,"دَاوُۥدَ","(of) Dawood","رَّاسِيَـٰتٍ ۚ ٱعْمَلُوٓا۟ ءَالَ","شُكْرًۭا ۚ وَقَلِيلٌۭ مِّنْ",592],["38:17:7",454,"دَاوُۥدَ","Dawood","يَقُولُونَ وَٱذْكُرْ عَبْدَنَا","ذَا ٱلْأَيْدِ ۖ إِنَّهُۥٓ",592],["38:22:4",454,"دَاوُۥدَ","Dawood","إِذْ دَخَلُوا۟ عَلَىٰ","فَفَزِعَ مِنْهُمْ ۖ قَالُوا۟",592],["38:24:25",454,"دَاوُۥدُ","Dawood","مَّا هُمْ ۗ وَظَنَّ","أَنَّمَا فَتَنَّـٰهُ فَٱسْتَغْفَرَ",592],["38:26:1",454,"يَـٰدَاوُۥدُ","O Dawood","","إِنَّا جَعَلْنَـٰكَ خَلِيفَةًۭ",592],["38:30:2",455,"لِدَاوُۥدَ","to Dawood","وَوَهَبْنَا","سُلَيْمَـٰنَ ۚ نِعْمَ ٱلْعَبْدُ ۖ",592]]