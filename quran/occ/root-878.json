[["9:58:3",196,"يَلْمِزُكَ","criticizes you","وَمِنْهُم مَّن","فِى ٱلصَّدَقَـٰتِ فَإِنْ",2060],["9:79:2",199,"يَلْمِزُونَ","criticize","ٱلَّذِينَ","ٱلْمُطَّوِّعِينَ مِنَ ٱلْمُؤْمِنِينَ",2060],["49:11:24",516,"تَلْمِزُوٓا۟","insult","خَيْرًۭا مِّنْهُنَّ ۖ وَلَا","أَنفُسَكُمْ وَلَا تَنَابَزُوا۟",2060],["104:1:4",601,"لُّمَزَةٍ","backbiter","وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ","",3620]]