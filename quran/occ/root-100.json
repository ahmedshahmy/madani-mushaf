[["2:3:8",2,"يُنفِقُونَ","they spend","ٱلصَّلَوٰةَ وَمِمَّا رَزَقْنَـٰهُمْ","",179],["2:195:1",30,"وَأَنفِقُوا۟","And spend","","فِى سَبِيلِ ٱللَّهِ",179],["2:215:3",33,"يُنفِقُونَ ۖ","they (should) spend","يَسْـَٔلُونَكَ مَاذَا","قُلْ مَآ أَنفَقْتُم",179],["2:215:6",33,"أَنفَقْتُم","you spend","يُنفِقُونَ ۖ قُلْ مَآ","مِّنْ خَيْرٍۢ فَلِلْوَٰلِدَيْنِ",179],["2:219:17",34,"يُنفِقُونَ","they (should) spend","نَّفْعِهِمَا ۗ وَيَسْـَٔلُونَكَ مَاذَا","قُلِ ٱلْعَفْوَ ۗ كَذَٰلِكَ",179],["2:254:4",42,"أَنفِقُوا۟","Spend","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟","مِمَّا رَزَقْنَـٰكُم مِّن",179],["2:261:3",44,"يُنفِقُونَ","spend","مَّثَلُ ٱلَّذِينَ","أَمْوَٰلَهُمْ فِى سَبِيلِ",179],["2:262:2",44,"يُنفِقُونَ","spend","ٱلَّذِينَ","أَمْوَٰلَهُمْ فِى سَبِيلِ",179],["2:262:11",44,"أَنفَقُوا۟","they spend","لَا يُتْبِعُونَ مَآ","مَنًّۭا وَلَآ أَذًۭى ۙ",179],["2:264:10",44,"يُنفِقُ","spends","بِٱلْمَنِّ وَٱلْأَذَىٰ كَٱلَّذِى","مَالَهُۥ رِئَآءَ ٱلنَّاسِ",179],["2:265:3",45,"يُنفِقُونَ","spend","وَمَثَلُ ٱلَّذِينَ","أَمْوَٰلَهُمُ ٱبْتِغَآءَ مَرْضَاتِ",179],["2:267:4",45,"أَنفِقُوا۟","Spend","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟","مِن طَيِّبَـٰتِ مَا",179],["2:267:18",45,"تُنفِقُونَ","you spend","تَيَمَّمُوا۟ ٱلْخَبِيثَ مِنْهُ","وَلَسْتُم بِـَٔاخِذِيهِ إِلَّآ",179],["2:270:2",46,"أَنفَقْتُم","you spend","وَمَآ","مِّن نَّفَقَةٍ أَوْ",179],["2:270:4",46,"نَّفَقَةٍ","(your) expenditures","وَمَآ أَنفَقْتُم مِّن","أَوْ نَذَرْتُم مِّن",2552],["2:272:10",46,"تُنفِقُوا۟","you spend","مَن يَشَآءُ ۗ وَمَا","مِنْ خَيْرٍۢ فَلِأَنفُسِكُمْ ۚ",179],["2:272:15",46,"تُنفِقُونَ","you spend","خَيْرٍۢ فَلِأَنفُسِكُمْ ۚ وَمَا","إِلَّا ٱبْتِغَآءَ وَجْهِ",179],["2:272:21",46,"تُنفِقُوا۟","you spend","وَجْهِ ٱللَّهِ ۚ وَمَا","مِنْ خَيْرٍۢ يُوَفَّ",179],["2:273:24",46,"تُنفِقُوا۟","you spend","ٱلنَّاسَ إِلْحَافًۭا ۗ وَمَا","مِنْ خَيْرٍۢ فَإِنَّ",179],["2:274:2",46,"يُنفِقُونَ","spend","ٱلَّذِينَ","أَمْوَٰلَهُم بِٱلَّيْلِ وَٱلنَّهَارِ",179],["3:17:4",52,"وَٱلْمُنفِقِينَ","and those who spend","ٱلصَّـٰبِرِينَ وَٱلصَّـٰدِقِينَ وَٱلْقَـٰنِتِينَ","وَٱلْمُسْتَغْفِرِينَ بِٱلْأَسْحَارِ",3828],["3:92:5",62,"تُنفِقُوا۟","you spend","تَنَالُوا۟ ٱلْبِرَّ حَتَّىٰ","مِمَّا تُحِبُّونَ ۚ وَمَا",179],["3:92:9",62,"تُنفِقُوا۟","you spend","مِمَّا تُحِبُّونَ ۚ وَمَا","مِن شَىْءٍۢ فَإِنَّ",179],["3:117:3",65,"يُنفِقُونَ","they spend","مَثَلُ مَا","فِى هَـٰذِهِ ٱلْحَيَوٰةِ",179],["3:134:2",67,"يُنفِقُونَ","spend","ٱلَّذِينَ","فِى ٱلسَّرَّآءِ وَٱلضَّرَّآءِ",179],["3:167:3",72,"نَافَقُوا۟ ۚ","(are) hypocrites","وَلِيَعْلَمَ ٱلَّذِينَ","وَقِيلَ لَهُمْ تَعَالَوْا۟",2549],["4:34:12",84,"أَنفَقُوا۟","they spend","عَلَىٰ بَعْضٍۢ وَبِمَآ","مِنْ أَمْوَٰلِهِمْ ۚ فَٱلصَّـٰلِحَـٰتُ",179],["4:38:2",85,"يُنفِقُونَ","spend","وَٱلَّذِينَ","أَمْوَٰلَهُمْ رِئَآءَ ٱلنَّاسِ",179],["4:39:8",85,"وَأَنفَقُوا۟","and spent","بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ","مِمَّا رَزَقَهُمُ ٱللَّهُ ۚ",179],["4:61:12",88,"ٱلْمُنَـٰفِقِينَ","the hypocrites","وَإِلَى ٱلرَّسُولِ رَأَيْتَ","يَصُدُّونَ عَنكَ صُدُودًۭا",403],["4:88:4",92,"ٱلْمُنَـٰفِقِينَ","the hypocrites (that)","۞ فَمَا لَكُمْ فِى","فِئَتَيْنِ وَٱللَّهُ أَرْكَسَهُم",403],["4:138:2",100,"ٱلْمُنَـٰفِقِينَ","(to) the hypocrites","بَشِّرِ","بِأَنَّ لَهُمْ عَذَابًا",403],["4:140:29",100,"ٱلْمُنَـٰفِقِينَ","the hypocrites","إِنَّ ٱللَّهَ جَامِعُ","وَٱلْكَـٰفِرِينَ فِى جَهَنَّمَ",403],["4:142:2",101,"ٱلْمُنَـٰفِقِينَ","the hypocrites","إِنَّ","يُخَـٰدِعُونَ ٱللَّهَ وَهُوَ",403],["4:145:2",101,"ٱلْمُنَـٰفِقِينَ","the hypocrites","إِنَّ","فِى ٱلدَّرْكِ ٱلْأَسْفَلِ",403],["5:64:14",118,"يُنفِقُ","He spends","بَلْ يَدَاهُ مَبْسُوطَتَانِ","كَيْفَ يَشَآءُ ۚ وَلَيَزِيدَنَّ",179],["6:35:10",131,"نَفَقًۭا","a tunnel","ٱسْتَطَعْتَ أَن تَبْتَغِىَ","فِى ٱلْأَرْضِ أَوْ",4027],["8:3:6",177,"يُنفِقُونَ","they spend","ٱلصَّلَوٰةَ وَمِمَّا رَزَقْنَـٰهُمْ","",179],["8:36:4",181,"يُنفِقُونَ","they spend","إِنَّ ٱلَّذِينَ كَفَرُوا۟","أَمْوَٰلَهُمْ لِيَصُدُّوا۟ عَن",179],["8:36:10",181,"فَسَيُنفِقُونَهَا","So they will spend it","عَن سَبِيلِ ٱللَّهِ ۚ","ثُمَّ تَكُونُ عَلَيْهِمْ",179],["8:49:3",183,"ٱلْمُنَـٰفِقُونَ","the hypocrites","إِذْ يَقُولُ","وَٱلَّذِينَ فِى قُلُوبِهِم",403],["8:60:23",184,"تُنفِقُوا۟","you spend","ٱللَّهُ يَعْلَمُهُمْ ۚ وَمَا","مِن شَىْءٍۢ فِى",179],["8:63:5",185,"أَنفَقْتَ","you (had) spent","بَيْنَ قُلُوبِهِمْ ۚ لَوْ","مَا فِى ٱلْأَرْضِ",179],["9:34:22",192,"يُنفِقُونَهَا","spend it","ٱلذَّهَبَ وَٱلْفِضَّةَ وَلَا","فِى سَبِيلِ ٱللَّهِ",179],["9:53:2",195,"أَنفِقُوا۟","Spend","قُلْ","طَوْعًا أَوْ كَرْهًۭا",179],["9:54:6",195,"نَفَقَـٰتُهُمْ","their contributions","أَن تُقْبَلَ مِنْهُمْ","إِلَّآ أَنَّهُمْ كَفَرُوا۟",4028],["9:54:19",195,"يُنفِقُونَ","they spend","وَهُمْ كُسَالَىٰ وَلَا","إِلَّا وَهُمْ كَـٰرِهُونَ",179],["9:64:2",197,"ٱلْمُنَـٰفِقُونَ","the hypocrites","يَحْذَرُ","أَن تُنَزَّلَ عَلَيْهِمْ",403],["9:67:1",197,"ٱلْمُنَـٰفِقُونَ","The hypocrite men","","وَٱلْمُنَـٰفِقَـٰتُ بَعْضُهُم مِّنۢ",403],["9:67:2",197,"وَٱلْمُنَـٰفِقَـٰتُ","and the hypocrite women","ٱلْمُنَـٰفِقُونَ","بَعْضُهُم مِّنۢ بَعْضٍۢ ۚ",1365],["9:67:17",197,"ٱلْمُنَـٰفِقِينَ","the hypocrites","ٱللَّهَ فَنَسِيَهُمْ ۗ إِنَّ","هُمُ ٱلْفَـٰسِقُونَ",403],["9:68:3",197,"ٱلْمُنَـٰفِقِينَ","the hypocrite men","وَعَدَ ٱللَّهُ","وَٱلْمُنَـٰفِقَـٰتِ وَٱلْكُفَّارَ نَارَ",403],["9:68:4",197,"وَٱلْمُنَـٰفِقَـٰتِ","and the hypocrite women","وَعَدَ ٱللَّهُ ٱلْمُنَـٰفِقِينَ","وَٱلْكُفَّارَ نَارَ جَهَنَّمَ",1365],["9:73:5",199,"وَٱلْمُنَـٰفِقِينَ","and the hypocrites","ٱلنَّبِىُّ جَـٰهِدِ ٱلْكُفَّارَ","وَٱغْلُظْ عَلَيْهِمْ ۚ وَمَأْوَىٰهُمْ",403],["9:77:2",199,"نِفَاقًۭا","(with) hypocrisy","فَأَعْقَبَهُمْ","فِى قُلُوبِهِمْ إِلَىٰ",1946],["9:91:13",201,"يُنفِقُونَ","they (can) spend","لَا يَجِدُونَ مَا","حَرَجٌ إِذَا نَصَحُوا۟",179],["9:92:23",201,"يُنفِقُونَ","they (could) spend","أَلَّا يَجِدُوا۟ مَا","",179],["9:97:4",202,"وَنِفَاقًۭا","and hypocrisy","ٱلْأَعْرَابُ أَشَدُّ كُفْرًۭا","وَأَجْدَرُ أَلَّا يَعْلَمُوا۟",1946],["9:98:6",202,"يُنفِقُ","he spends","مَن يَتَّخِذُ مَا","مَغْرَمًۭا وَيَتَرَبَّصُ بِكُمُ",179],["9:99:10",202,"يُنفِقُ","he spends","ٱلْـَٔاخِرِ وَيَتَّخِذُ مَا","قُرُبَـٰتٍ عِندَ ٱللَّهِ",179],["9:101:5",203,"مُنَـٰفِقُونَ ۖ","(are) hypocrites","حَوْلَكُم مِّنَ ٱلْأَعْرَابِ","وَمِنْ أَهْلِ ٱلْمَدِينَةِ ۖ",403],["9:101:11",203,"ٱلنِّفَاقِ","the hypocrisy","ٱلْمَدِينَةِ ۖ مَرَدُوا۟ عَلَى","لَا تَعْلَمُهُمْ ۖ نَحْنُ",1946],["9:121:2",206,"يُنفِقُونَ","they spend","وَلَا","نَفَقَةًۭ صَغِيرَةًۭ وَلَا",179],["9:121:3",206,"نَفَقَةًۭ","any spending","وَلَا يُنفِقُونَ","صَغِيرَةًۭ وَلَا كَبِيرَةًۭ",2552],["13:22:8",252,"وَأَنفَقُوا۟","and spend","رَبِّهِمْ وَأَقَامُوا۟ ٱلصَّلَوٰةَ","مِمَّا رَزَقْنَـٰهُمْ سِرًّۭا",179],["14:31:7",259,"وَيُنفِقُوا۟","and (to) spend","ءَامَنُوا۟ يُقِيمُوا۟ ٱلصَّلَوٰةَ","مِمَّا رَزَقْنَـٰهُمْ سِرًّۭا",179],["16:75:16",275,"يُنفِقُ","spends","رِزْقًا حَسَنًۭا فَهُوَ","مِنْهُ سِرًّۭا وَجَهْرًا ۖ",179],["17:100:11",292,"ٱلْإِنفَاقِ ۚ","(of) spending","إِذًۭا لَّأَمْسَكْتُمْ خَشْيَةَ","وَكَانَ ٱلْإِنسَـٰنُ قَتُورًۭا",2934],["18:42:8",298,"أَنفَقَ","he (had) spent","كَفَّيْهِ عَلَىٰ مَآ","فِيهَا وَهِىَ خَاوِيَةٌ",179],["22:35:15",336,"يُنفِقُونَ","they spend","ٱلصَّلَوٰةِ وَمِمَّا رَزَقْنَـٰهُمْ","",179],["25:67:3",365,"أَنفَقُوا۟","they spend","وَٱلَّذِينَ إِذَآ","لَمْ يُسْرِفُوا۟ وَلَمْ",179],["28:54:12",392,"يُنفِقُونَ","they spend","ٱلسَّيِّئَةَ وَمِمَّا رَزَقْنَـٰهُمْ","",179],["29:11:6",397,"ٱلْمُنَـٰفِقِينَ","the hypocrites","ٱلَّذِينَ ءَامَنُوا۟ وَلَيَعْلَمَنَّ","",403],["32:16:11",416,"يُنفِقُونَ","they spend","وَطَمَعًۭا وَمِمَّا رَزَقْنَـٰهُمْ","",179],["33:1:8",418,"وَٱلْمُنَـٰفِقِينَ ۗ","and the hypocrites","وَلَا تُطِعِ ٱلْكَـٰفِرِينَ","إِنَّ ٱللَّهَ كَانَ",403],["33:12:3",419,"ٱلْمُنَـٰفِقُونَ","the hypocrites","وَإِذْ يَقُولُ","وَٱلَّذِينَ فِى قُلُوبِهِم",403],["33:24:6",421,"ٱلْمُنَـٰفِقِينَ","the hypocrites","ٱلصَّـٰدِقِينَ بِصِدْقِهِمْ وَيُعَذِّبَ","إِن شَآءَ أَوْ",403],["33:48:4",424,"وَٱلْمُنَـٰفِقِينَ","and the hypocrites","وَلَا تُطِعِ ٱلْكَـٰفِرِينَ","وَدَعْ أَذَىٰهُمْ وَتَوَكَّلْ",403],["33:60:4",426,"ٱلْمُنَـٰفِقُونَ","the hypocrites","۞ لَّئِن لَّمْ يَنتَهِ","وَٱلَّذِينَ فِى قُلُوبِهِم",403],["33:73:3",427,"ٱلْمُنَـٰفِقِينَ","the hypocrite men","لِّيُعَذِّبَ ٱللَّهُ","وَٱلْمُنَـٰفِقَـٰتِ وَٱلْمُشْرِكِينَ وَٱلْمُشْرِكَـٰتِ",403],["33:73:4",427,"وَٱلْمُنَـٰفِقَـٰتِ","and the hypocrite women","لِّيُعَذِّبَ ٱللَّهُ ٱلْمُنَـٰفِقِينَ","وَٱلْمُشْرِكِينَ وَٱلْمُشْرِكَـٰتِ وَيَتُوبَ",1365],["34:39:13",432,"أَنفَقْتُم","you spend","وَيَقْدِرُ لَهُۥ ۚ وَمَآ","مِّن شَىْءٍۢ فَهُوَ",179],["35:29:8",437,"وَأَنفَقُوا۟","and spend","ٱللَّهِ وَأَقَامُوا۟ ٱلصَّلَوٰةَ","مِمَّا رَزَقْنَـٰهُمْ سِرًّۭا",179],["36:47:4",443,"أَنفِقُوا۟","Spend","وَإِذَا قِيلَ لَهُمْ","مِمَّا رَزَقَكُمُ ٱللَّهُ",179],["42:38:11",487,"يُنفِقُونَ","they spend","بَيْنَهُمْ وَمِمَّا رَزَقْنَـٰهُمْ","",179],["47:38:4",510,"لِتُنفِقُوا۟","to spend","هَـٰٓأَنتُمْ هَـٰٓؤُلَآءِ تُدْعَوْنَ","فِى سَبِيلِ ٱللَّهِ",179],["48:6:2",511,"ٱلْمُنَـٰفِقِينَ","the hypocrite men","وَيُعَذِّبَ","وَٱلْمُنَـٰفِقَـٰتِ وَٱلْمُشْرِكِينَ وَٱلْمُشْرِكَـٰتِ",403],["48:6:3",511,"وَٱلْمُنَـٰفِقَـٰتِ","and the hypocrite women","وَيُعَذِّبَ ٱلْمُنَـٰفِقِينَ","وَٱلْمُشْرِكِينَ وَٱلْمُشْرِكَـٰتِ ٱلظَّآنِّينَ",1365],["57:7:4",538,"وَأَنفِقُوا۟","and spend","ءَامِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ","مِمَّا جَعَلَكُم مُّسْتَخْلَفِينَ",179],["57:7:12",538,"وَأَنفَقُوا۟","and spend","فَٱلَّذِينَ ءَامَنُوا۟ مِنكُمْ","لَهُمْ أَجْرٌۭ كَبِيرٌۭ",179],["57:10:4",538,"تُنفِقُوا۟","you spend","وَمَا لَكُمْ أَلَّا","فِى سَبِيلِ ٱللَّهِ",179],["57:10:16",538,"أَنفَقَ","spent","يَسْتَوِى مِنكُم مَّنْ","مِن قَبْلِ ٱلْفَتْحِ",179],["57:10:26",538,"أَنفَقُوا۟","spent","دَرَجَةًۭ مِّنَ ٱلَّذِينَ","مِنۢ بَعْدُ وَقَـٰتَلُوا۟ ۚ",179],["57:13:3",539,"ٱلْمُنَـٰفِقُونَ","the hypocrite men","يَوْمَ يَقُولُ","وَٱلْمُنَـٰفِقَـٰتُ لِلَّذِينَ ءَامَنُوا۟",403],["57:13:4",539,"وَٱلْمُنَـٰفِقَـٰتُ","and the hypocrite women","يَوْمَ يَقُولُ ٱلْمُنَـٰفِقُونَ","لِلَّذِينَ ءَامَنُوا۟ ٱنظُرُونَا",1365],["59:11:5",547,"نَافَقُوا۟","(were) hypocrites","تَرَ إِلَى ٱلَّذِينَ","يَقُولُونَ لِإِخْوَٰنِهِمُ ٱلَّذِينَ",2549],["60:10:29",550,"أَنفَقُوا۟ ۚ","they have spent","لَهُنَّ ۖ وَءَاتُوهُم مَّآ","وَلَا جُنَاحَ عَلَيْكُمْ",179],["60:10:44",550,"أَنفَقْتُمْ","you have spent","ٱلْكَوَافِرِ وَسْـَٔلُوا۟ مَآ","وَلْيَسْـَٔلُوا۟ مَآ أَنفَقُوا۟ ۚ",179],["60:10:47",550,"أَنفَقُوا۟ ۚ","they have spent","أَنفَقْتُمْ وَلْيَسْـَٔلُوا۟ مَآ","ذَٰلِكُمْ حُكْمُ ٱللَّهِ ۖ",179],["60:11:15",550,"أَنفَقُوا۟ ۚ","they had spent","أَزْوَٰجُهُم مِّثْلَ مَآ","وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ",179],["63:1:3",554,"ٱلْمُنَـٰفِقُونَ","the hypocrites","إِذَا جَآءَكَ","قَالُوا۟ نَشْهَدُ إِنَّكَ",403],["63:1:16",554,"ٱلْمُنَـٰفِقِينَ","the hypocrites","وَٱللَّهُ يَشْهَدُ إِنَّ","لَكَـٰذِبُونَ",403],["63:7:5",555,"تُنفِقُوا۟","spend","ٱلَّذِينَ يَقُولُونَ لَا","عَلَىٰ مَنْ عِندَ",179],["63:7:18",555,"ٱلْمُنَـٰفِقِينَ","the hypocrites","ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَلَـٰكِنَّ","لَا يَفْقَهُونَ",403],["63:8:15",555,"ٱلْمُنَـٰفِقِينَ","the hypocrites","وَلِرَسُولِهِۦ وَلِلْمُؤْمِنِينَ وَلَـٰكِنَّ","لَا يَعْلَمُونَ",403],["63:10:1",555,"وَأَنفِقُوا۟","And spend","","مِن مَّا رَزَقْنَـٰكُم",179],["64:16:7",557,"وَأَنفِقُوا۟","and spend","ٱسْتَطَعْتُمْ وَٱسْمَعُوا۟ وَأَطِيعُوا۟","خَيْرًۭا لِّأَنفُسِكُمْ ۗ وَمَن",179],["65:6:15",559,"فَأَنفِقُوا۟","then spend","كُنَّ أُو۟لَـٰتِ حَمْلٍۢ","عَلَيْهِنَّ حَتَّىٰ يَضَعْنَ",179],["65:7:1",559,"لِيُنفِقْ","Let spend","","ذُو سَعَةٍۢ مِّن",179],["65:7:10",559,"فَلْيُنفِقْ","let him spend","قُدِرَ عَلَيْهِ رِزْقُهُۥ","مِمَّآ ءَاتَىٰهُ ٱللَّهُ ۚ",179],["66:9:5",561,"وَٱلْمُنَـٰفِقِينَ","and the hypocrites","ٱلنَّبِىُّ جَـٰهِدِ ٱلْكُفَّارَ","وَٱغْلُظْ عَلَيْهِمْ ۚ وَمَأْوَىٰهُمْ",403]]