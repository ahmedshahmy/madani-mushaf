[["2:192:2",30,"ٱنتَهَوْا۟","they cease","فَإِنِ","فَإِنَّ ٱللَّهَ غَفُورٌۭ",610],["2:193:10",30,"ٱنتَهَوْا۟","they cease","ٱلدِّينُ لِلَّهِ ۖ فَإِنِ","فَلَا عُدْوَٰنَ إِلَّا",610],["2:275:31",47,"فَٱنتَهَىٰ","and he refrained","مَوْعِظَةٌۭ مِّن رَّبِّهِۦ","فَلَهُۥ مَا سَلَفَ",610],["3:104:9",63,"وَيَنْهَوْنَ","and forbidding","ٱلْخَيْرِ وَيَأْمُرُونَ بِٱلْمَعْرُوفِ","عَنِ ٱلْمُنكَرِ ۚ وَأُو۟لَـٰٓئِكَ",353],["3:110:8",64,"وَتَنْهَوْنَ","and forbidding","لِلنَّاسِ تَأْمُرُونَ بِٱلْمَعْرُوفِ","عَنِ ٱلْمُنكَرِ وَتُؤْمِنُونَ",353],["3:114:7",64,"وَيَنْهَوْنَ","and forbid","ٱلْـَٔاخِرِ وَيَأْمُرُونَ بِٱلْمَعْرُوفِ","عَنِ ٱلْمُنكَرِ وَيُسَـٰرِعُونَ",353],["4:31:5",83,"تُنْهَوْنَ","you are forbidden","تَجْتَنِبُوا۟ كَبَآئِرَ مَا","عَنْهُ نُكَفِّرْ عَنكُمْ",353],["4:161:4",103,"نُهُوا۟","they were forbidden","وَأَخْذِهِمُ ٱلرِّبَوٰا۟ وَقَدْ","عَنْهُ وَأَكْلِهِمْ أَمْوَٰلَ",353],["4:171:32",105,"ٱنتَهُوا۟","desist","وَلَا تَقُولُوا۟ ثَلَـٰثَةٌ ۚ","خَيْرًۭا لَّكُمْ ۚ إِنَّمَا",610],["5:63:2",118,"يَنْهَىٰهُمُ","forbid them","لَوْلَا","ٱلرَّبَّـٰنِيُّونَ وَٱلْأَحْبَارُ عَن",353],["5:73:17",120,"يَنتَهُوا۟","they desist","وَٰحِدٌۭ ۚ وَإِن لَّمْ","عَمَّا يَقُولُونَ لَيَمَسَّنَّ",610],["5:79:3",121,"يَتَنَاهَوْنَ","forbidding each other","كَانُوا۟ لَا","عَن مُّنكَرٍۢ فَعَلُوهُ ۚ",4684],["5:91:20",123,"مُّنتَهُونَ","(be) the ones who abstain","ٱلصَّلَوٰةِ ۖ فَهَلْ أَنتُم","",3978],["6:26:2",130,"يَنْهَوْنَ","forbid (others)","وَهُمْ","عَنْهُ وَيَنْـَٔوْنَ عَنْهُ ۖ",353],["6:28:13",131,"نُهُوا۟","they were forbidden","رُدُّوا۟ لَعَادُوا۟ لِمَا","عَنْهُ وَإِنَّهُمْ لَكَـٰذِبُونَ",353],["6:56:3",134,"نُهِيتُ","[I] am forbidden","قُلْ إِنِّى","أَنْ أَعْبُدَ ٱلَّذِينَ",353],["7:20:13",152,"نَهَىٰكُمَا","forbid you both","سَوْءَٰتِهِمَا وَقَالَ مَا","رَبُّكُمَا عَنْ هَـٰذِهِ",353],["7:22:18",152,"أَنْهَكُمَا","I forbid you both","وَنَادَىٰهُمَا رَبُّهُمَآ أَلَمْ","عَن تِلْكُمَا ٱلشَّجَرَةِ",353],["7:157:15",170,"وَيَنْهَىٰهُمْ","and forbids them","وَٱلْإِنجِيلِ يَأْمُرُهُم بِٱلْمَعْرُوفِ","عَنِ ٱلْمُنكَرِ وَيُحِلُّ",353],["7:165:8",172,"يَنْهَوْنَ","forbade","بِهِۦٓ أَنجَيْنَا ٱلَّذِينَ","عَنِ ٱلسُّوٓءِ وَأَخَذْنَا",353],["7:166:5",172,"نُهُوا۟","they were forbidden","عَتَوْا۟ عَن مَّا","عَنْهُ قُلْنَا لَهُمْ",353],["8:19:7",179,"تَنتَهُوا۟","you desist","جَآءَكُمُ ٱلْفَتْحُ ۖ وَإِن","فَهُوَ خَيْرٌۭ لَّكُمْ ۖ",610],["8:38:5",181,"يَنتَهُوا۟","they cease","لِّلَّذِينَ كَفَرُوٓا۟ إِن","يُغْفَرْ لَهُم مَّا",610],["8:39:11",181,"ٱنتَهَوْا۟","they cease","كُلُّهُۥ لِلَّهِ ۚ فَإِنِ","فَإِنَّ ٱللَّهَ بِمَا",610],["9:12:18",188,"يَنتَهُونَ","cease","أَيْمَـٰنَ لَهُمْ لَعَلَّهُمْ","",610],["9:67:8",197,"وَيَنْهَوْنَ","and forbid","بَعْضٍۢ ۚ يَأْمُرُونَ بِٱلْمُنكَرِ","عَنِ ٱلْمَعْرُوفِ وَيَقْبِضُونَ",353],["9:71:8",198,"وَيَنْهَوْنَ","and forbid","بَعْضٍۢ ۚ يَأْمُرُونَ بِٱلْمَعْرُوفِ","عَنِ ٱلْمُنكَرِ وَيُقِيمُونَ",353],["9:112:9",205,"وَٱلنَّاهُونَ","and those who forbid","ٱلسَّـٰجِدُونَ ٱلْـَٔامِرُونَ بِٱلْمَعْرُوفِ","عَنِ ٱلْمُنكَرِ وَٱلْحَـٰفِظُونَ",4076],["11:62:9",228,"أَتَنْهَىٰنَآ","Do you forbid us","مَرْجُوًّۭا قَبْلَ هَـٰذَآ ۖ","أَن نَّعْبُدَ مَا",353],["11:88:20",231,"أَنْهَىٰكُمْ","I forbid you","أُخَالِفَكُمْ إِلَىٰ مَآ","عَنْهُ ۚ إِنْ أُرِيدُ",353],["11:116:9",234,"يَنْهَوْنَ","forbidding","قَبْلِكُمْ أُو۟لُوا۟ بَقِيَّةٍۢ","عَنِ ٱلْفَسَادِ فِى",353],["15:70:3",265,"نَنْهَكَ","we forbid you","قَالُوٓا۟ أَوَلَمْ","عَنِ ٱلْعَـٰلَمِينَ",353],["16:90:9",277,"وَيَنْهَىٰ","and forbids","وَإِيتَآئِ ذِى ٱلْقُرْبَىٰ","عَنِ ٱلْفَحْشَآءِ وَٱلْمُنكَرِ",353],["19:46:9",308,"تَنتَهِ","you desist","يَـٰٓإِبْرَٰهِيمُ ۖ لَئِن لَّمْ","لَأَرْجُمَنَّكَ ۖ وَٱهْجُرْنِى مَلِيًّۭا",610],["20:54:9",315,"ٱلنُّهَىٰ","(of) intelligence","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّأُو۟لِى","",2573],["20:128:17",321,"ٱلنُّهَىٰ","(of) intelligence","ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّأُو۟لِى","",2573],["22:41:12",337,"وَنَهَوْا۟","and forbid","ٱلزَّكَوٰةَ وَأَمَرُوا۟ بِٱلْمَعْرُوفِ","عَنِ ٱلْمُنكَرِ ۗ وَلِلَّهِ",353],["26:116:4",372,"تَنتَهِ","you desist","قَالُوا۟ لَئِن لَّمْ","يَـٰنُوحُ لَتَكُونَنَّ مِنَ",610],["26:167:4",374,"تَنتَهِ","you desist","قَالُوا۟ لَئِن لَّمْ","يَـٰلُوطُ لَتَكُونَنَّ مِنَ",610],["29:45:11",401,"تَنْهَىٰ","prevents","ٱلصَّلَوٰةَ ۖ إِنَّ ٱلصَّلَوٰةَ","عَنِ ٱلْفَحْشَآءِ وَٱلْمُنكَرِ ۗ",353],["31:17:6",412,"وَٱنْهَ","and forbid","ٱلصَّلَوٰةَ وَأْمُرْ بِٱلْمَعْرُوفِ","عَنِ ٱلْمُنكَرِ وَٱصْبِرْ",353],["33:60:3",426,"يَنتَهِ","cease","۞ لَّئِن لَّمْ","ٱلْمُنَـٰفِقُونَ وَٱلَّذِينَ فِى",610],["36:18:7",441,"تَنتَهُوا۟","you desist","بِكُمْ ۖ لَئِن لَّمْ","لَنَرْجُمَنَّكُمْ وَلَيَمَسَّنَّكُم مِّنَّا",610],["40:66:3",474,"نُهِيتُ","[I] have been forbidden","۞ قُلْ إِنِّى","أَنْ أَعْبُدَ ٱلَّذِينَ",353],["53:14:3",526,"ٱلْمُنتَهَىٰ","(of) the utmost boundary","عِندَ سِدْرَةِ","",1911],["53:42:4",527,"ٱلْمُنتَهَىٰ","(is) the final goal","وَأَنَّ إِلَىٰ رَبِّكَ","",1911],["58:8:5",543,"نُهُوا۟","were forbidden","تَرَ إِلَى ٱلَّذِينَ","عَنِ ٱلنَّجْوَىٰ ثُمَّ",353],["58:8:11",543,"نُهُوا۟","they were forbidden","ثُمَّ يَعُودُونَ لِمَا","عَنْهُ وَيَتَنَـٰجَوْنَ بِٱلْإِثْمِ",353],["59:7:29",546,"نَهَىٰكُمْ","he forbids you","ٱلرَّسُولُ فَخُذُوهُ وَمَا","عَنْهُ فَٱنتَهُوا۟ ۚ وَٱتَّقُوا۟",353],["59:7:31",546,"فَٱنتَهُوا۟ ۚ","refrain","وَمَا نَهَىٰكُمْ عَنْهُ","وَٱتَّقُوا۟ ٱللَّهَ ۖ إِنَّ",610],["60:8:2",550,"يَنْهَىٰكُمُ","(does) forbid you","لَّا","ٱللَّهُ عَنِ ٱلَّذِينَ",353],["60:9:2",550,"يَنْهَىٰكُمُ","forbids you","إِنَّمَا","ٱللَّهُ عَنِ ٱلَّذِينَ",353],["79:40:6",584,"وَنَهَى","and restrained","خَافَ مَقَامَ رَبِّهِۦ","ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",353],["79:44:3",584,"مُنتَهَىٰهَآ","(is) its finality","إِلَىٰ رَبِّكَ","",1911],["96:9:3",597,"يَنْهَىٰ","forbids","أَرَءَيْتَ ٱلَّذِى","",353],["96:15:4",598,"يَنتَهِ","he desists","كَلَّا لَئِن لَّمْ","لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",610]]