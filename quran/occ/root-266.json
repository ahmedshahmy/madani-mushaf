[["2:229:2",36,"مَرَّتَانِ ۖ","(is) twice","ٱلطَّلَـٰقُ","فَإِمْسَاكٌۢ بِمَعْرُوفٍ أَوْ",528],["2:259:3",43,"مَرَّ","passed","أَوْ كَٱلَّذِى","عَلَىٰ قَرْيَةٍۢ وَهِىَ",845],["6:94:7",139,"مَرَّةٍۢ","time","كَمَا خَلَقْنَـٰكُمْ أَوَّلَ","وَتَرَكْتُم مَّا خَوَّلْنَـٰكُمْ",528],["6:110:9",141,"مَرَّةٍۢ","time","يُؤْمِنُوا۟ بِهِۦٓ أَوَّلَ","وَنَذَرُهُمْ فِى طُغْيَـٰنِهِمْ",528],["7:189:17",175,"فَمَرَّتْ","and continues","حَمَلَتْ حَمْلًا خَفِيفًۭا","بِهِۦ ۖ فَلَمَّآ أَثْقَلَت",845],["8:56:9",184,"مَرَّةٍۢ","time","عَهْدَهُمْ فِى كُلِّ","وَهُمْ لَا يَتَّقُونَ",528],["9:13:12",188,"مَرَّةٍ ۚ","time","وَهُم بَدَءُوكُمْ أَوَّلَ","أَتَخْشَوْنَهُمْ ۚ فَٱللَّهُ أَحَقُّ",528],["9:80:11",200,"مَرَّةًۭ","times","تَسْتَغْفِرْ لَهُمْ سَبْعِينَ","فَلَن يَغْفِرَ ٱللَّهُ",528],["9:83:22",200,"مَرَّةٍۢ","time","رَضِيتُم بِٱلْقُعُودِ أَوَّلَ","فَٱقْعُدُوا۟ مَعَ ٱلْخَـٰلِفِينَ",528],["9:101:17",203,"مَّرَّتَيْنِ","twice","نَحْنُ نَعْلَمُهُمْ ۚ سَنُعَذِّبُهُم","ثُمَّ يُرَدُّونَ إِلَىٰ",528],["9:126:8",207,"مَّرَّةً","once","فِى كُلِّ عَامٍۢ","أَوْ مَرَّتَيْنِ ثُمَّ",528],["9:126:10",207,"مَرَّتَيْنِ","twice","عَامٍۢ مَّرَّةً أَوْ","ثُمَّ لَا يَتُوبُونَ",528],["10:12:15",209,"مَرَّ","he passes on","كَشَفْنَا عَنْهُ ضُرَّهُۥ","كَأَن لَّمْ يَدْعُنَآ",845],["11:38:4",226,"مَرَّ","passed","وَيَصْنَعُ ٱلْفُلْكَ وَكُلَّمَا","عَلَيْهِ مَلَأٌۭ مِّن",845],["12:105:7",248,"يَمُرُّونَ","they pass","فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ","عَلَيْهَا وَهُمْ عَنْهَا",845],["17:4:10",282,"مَرَّتَيْنِ","twice","لَتُفْسِدُنَّ فِى ٱلْأَرْضِ","وَلَتَعْلُنَّ عُلُوًّۭا كَبِيرًۭا",528],["17:7:19",282,"مَرَّةٍۢ","time","كَمَا دَخَلُوهُ أَوَّلَ","وَلِيُتَبِّرُوا۟ مَا عَلَوْا۟",528],["17:51:14",287,"مَرَّةٍۢ ۚ","time","ٱلَّذِى فَطَرَكُمْ أَوَّلَ","فَسَيُنْغِضُونَ إِلَيْكَ رُءُوسَهُمْ",528],["18:48:10",299,"مَرَّةٍۭ ۚ","time","كَمَا خَلَقْنَـٰكُمْ أَوَّلَ","بَلْ زَعَمْتُمْ أَلَّن",528],["20:37:4",313,"مَرَّةً","another time","وَلَقَدْ مَنَنَّا عَلَيْكَ","أُخْرَىٰٓ",528],["24:58:14",357,"مَرَّٰتٍۢ ۚ","times","ٱلْحُلُمَ مِنكُمْ ثَلَـٰثَ","مِّن قَبْلِ صَلَوٰةِ",3711],["25:72:6",366,"مَرُّوا۟","they pass","يَشْهَدُونَ ٱلزُّورَ وَإِذَا","بِٱللَّغْوِ مَرُّوا۟ كِرَامًۭا",845],["25:72:8",366,"مَرُّوا۟","they pass","وَإِذَا مَرُّوا۟ بِٱللَّغْوِ","كِرَامًۭا",845],["27:88:6",384,"تَمُرُّ","will pass","تَحْسَبُهَا جَامِدَةًۭ وَهِىَ","مَرَّ ٱلسَّحَابِ ۚ صُنْعَ",845],["27:88:7",384,"مَرَّ","(as the) passing","جَامِدَةًۭ وَهِىَ تَمُرُّ","ٱلسَّحَابِ ۚ صُنْعَ ٱللَّهِ",3710],["28:54:4",392,"مَّرَّتَيْنِ","twice","أُو۟لَـٰٓئِكَ يُؤْتَوْنَ أَجْرَهُم","بِمَا صَبَرُوا۟ وَيَدْرَءُونَ",528],["33:31:10",422,"مَرَّتَيْنِ","twice","صَـٰلِحًۭا نُّؤْتِهَآ أَجْرَهَا","وَأَعْتَدْنَا لَهَا رِزْقًۭا",528],["36:79:6",445,"مَرَّةٍۢ ۖ","time","ٱلَّذِىٓ أَنشَأَهَآ أَوَّلَ","وَهُوَ بِكُلِّ خَلْقٍ",528],["37:137:2",451,"لَتَمُرُّونَ","surely pass","وَإِنَّكُمْ","عَلَيْهِم مُّصْبِحِينَ",845],["41:21:16",479,"مَرَّةٍۢ","time","وَهُوَ خَلَقَكُمْ أَوَّلَ","وَإِلَيْهِ تُرْجَعُونَ",528],["53:6:2",526,"مِرَّةٍۢ","Possessor of soundness","ذُو","فَٱسْتَوَىٰ",3744],["54:2:7",528,"مُّسْتَمِرٌّۭ","continuing","يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌۭ","",2541],["54:19:9",529,"مُّسْتَمِرٍّۢ","continuous","فِى يَوْمِ نَحْسٍۢ","",2541],["54:46:6",530,"وَأَمَرُّ","and more bitter","مَوْعِدُهُمْ وَٱلسَّاعَةُ أَدْهَىٰ","",3010],["83:30:2",588,"مَرُّوا۟","they passed","وَإِذَا","بِهِمْ يَتَغَامَزُونَ",845]]