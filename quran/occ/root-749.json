[["20:53:19",315,"شَتَّىٰ","diverse","أَزْوَٰجًۭا مِّن نَّبَاتٍۢ","",1705],["24:61:57",358,"أَشْتَاتًۭا ۚ","separately","تَأْكُلُوا۟ جَمِيعًا أَوْ","فَإِذَا دَخَلْتُم بُيُوتًۭا",2149],["59:14:18",547,"شَتَّىٰ ۚ","(are) divided","تَحْسَبُهُمْ جَمِيعًۭا وَقُلُوبُهُمْ","ذَٰلِكَ بِأَنَّهُمْ قَوْمٌۭ",1705],["92:4:3",595,"لَشَتَّىٰ","(are) surely diverse","إِنَّ سَعْيَكُمْ","",1705],["99:6:4",599,"أَشْتَاتًۭا","(in) scattered groups","يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ","لِّيُرَوْا۟ أَعْمَـٰلَهُمْ",2149]]