[["2:61:15",9,"تُنۢبِتُ","grows","يُخْرِجْ لَنَا مِمَّا","ٱلْأَرْضُ مِنۢ بَقْلِهَا",587],["2:261:10",44,"أَنۢبَتَتْ","which grows","ٱللَّهِ كَمَثَلِ حَبَّةٍ","سَبْعَ سَنَابِلَ فِى",587],["3:37:5",54,"وَأَنۢبَتَهَا","and reared her","رَبُّهَا بِقَبُولٍ حَسَنٍۢ","نَبَاتًا حَسَنًۭا وَكَفَّلَهَا",587],["3:37:6",54,"نَبَاتًا","a rearing","بِقَبُولٍ حَسَنٍۢ وَأَنۢبَتَهَا","حَسَنًۭا وَكَفَّلَهَا زَكَرِيَّا ۖ",915],["6:99:9",140,"نَبَاتَ","vegetation","مَآءًۭ فَأَخْرَجْنَا بِهِۦ","كُلِّ شَىْءٍۢ فَأَخْرَجْنَا",915],["7:58:4",158,"نَبَاتُهُۥ","its vegetation","وَٱلْبَلَدُ ٱلطَّيِّبُ يَخْرُجُ","بِإِذْنِ رَبِّهِۦ ۖ وَٱلَّذِى",915],["10:24:11",211,"نَبَاتُ","(the) plants","ٱلسَّمَآءِ فَٱخْتَلَطَ بِهِۦ","ٱلْأَرْضِ مِمَّا يَأْكُلُ",915],["15:19:6",263,"وَأَنۢبَتْنَا","and [We] caused to grow","وَأَلْقَيْنَا فِيهَا رَوَٰسِىَ","فِيهَا مِن كُلِّ",587],["16:11:1",268,"يُنۢبِتُ","He causes to grow","","لَكُم بِهِ ٱلزَّرْعَ",587],["18:45:12",298,"نَبَاتُ","(the) vegetation","ٱلسَّمَآءِ فَٱخْتَلَطَ بِهِۦ","ٱلْأَرْضِ فَأَصْبَحَ هَشِيمًۭا",915],["20:53:18",315,"نَّبَاتٍۢ","plants","بِهِۦٓ أَزْوَٰجًۭا مِّن","شَتَّىٰ",915],["22:5:65",332,"وَأَنۢبَتَتْ","and grows","ٱلْمَآءَ ٱهْتَزَّتْ وَرَبَتْ","مِن كُلِّ زَوْجٍۭ",587],["23:20:6",343,"تَنۢبُتُ","(which) produces","مِن طُورِ سَيْنَآءَ","بِٱلدُّهْنِ وَصِبْغٍۢ لِّلْـَٔاكِلِينَ",4395],["26:7:6",367,"أَنۢبَتْنَا","We produced","إِلَى ٱلْأَرْضِ كَمْ","فِيهَا مِن كُلِّ",587],["27:60:10",382,"فَأَنۢبَتْنَا","And We caused to grow","مِّنَ ٱلسَّمَآءِ مَآءًۭ","بِهِۦ حَدَآئِقَ ذَاتَ",587],["27:60:19",382,"تُنۢبِتُوا۟","you cause to grow","كَانَ لَكُمْ أَن","شَجَرَهَآ ۗ أَءِلَـٰهٌۭ مَّعَ",587],["31:10:22",411,"فَأَنۢبَتْنَا","then We caused to grow","مِنَ ٱلسَّمَآءِ مَآءًۭ","فِيهَا مِن كُلِّ",587],["36:36:7",442,"تُنۢبِتُ","grows","ٱلْأَزْوَٰجَ كُلَّهَا مِمَّا","ٱلْأَرْضُ وَمِنْ أَنفُسِهِمْ",587],["37:146:1",451,"وَأَنۢبَتْنَا","And We caused to grow","","عَلَيْهِ شَجَرَةًۭ مِّن",587],["50:7:6",518,"وَأَنۢبَتْنَا","and We made to grow","وَأَلْقَيْنَا فِيهَا رَوَٰسِىَ","فِيهَا مِن كُلِّ",587],["50:9:6",518,"فَأَنۢبَتْنَا","then We made to grow","ٱلسَّمَآءِ مَآءًۭ مُّبَـٰرَكًۭا","بِهِۦ جَنَّـٰتٍۢ وَحَبَّ",587],["57:20:18",540,"نَبَاتُهُۥ","its growth","غَيْثٍ أَعْجَبَ ٱلْكُفَّارَ","ثُمَّ يَهِيجُ فَتَرَىٰهُ",915],["71:17:2",571,"أَنۢبَتَكُم","has caused you to grow","وَٱللَّهُ","مِّنَ ٱلْأَرْضِ نَبَاتًۭا",587],["71:17:5",571,"نَبَاتًۭا","(as) a growth","أَنۢبَتَكُم مِّنَ ٱلْأَرْضِ","",915],["78:15:4",582,"وَنَبَاتًۭا","and vegetation","لِّنُخْرِجَ بِهِۦ حَبًّۭا","",915],["80:27:1",585,"فَأَنۢبَتْنَا","Then We caused to grow","","فِيهَا حَبًّۭا",587]]