[["4:73:13",89,"يَـٰلَيْتَنِى","Oh! I wish","بَيْنَكُمْ وَبَيْنَهُۥ مَوَدَّةٌۭ","كُنتُ مَعَهُمْ فَأَفُوزَ",667],["6:27:8",130,"يَـٰلَيْتَنَا","Oh! Would that we","عَلَى ٱلنَّارِ فَقَالُوا۟","نُرَدُّ وَلَا نُكَذِّبَ",667],["18:42:15",298,"يَـٰلَيْتَنِى","Oh! I wish","عَلَىٰ عُرُوشِهَا وَيَقُولُ","لَمْ أُشْرِكْ بِرَبِّىٓ",667],["19:23:7",306,"يَـٰلَيْتَنِى","O! I wish","جِذْعِ ٱلنَّخْلَةِ قَالَتْ","مِتُّ قَبْلَ هَـٰذَا",667],["25:27:7",362,"يَـٰلَيْتَنِى","O I wish","عَلَىٰ يَدَيْهِ يَقُولُ","ٱتَّخَذْتُ مَعَ ٱلرَّسُولِ",667],["25:28:2",362,"لَيْتَنِى","I wish","يَـٰوَيْلَتَىٰ","لَمْ أَتَّخِذْ فُلَانًا",667],["28:79:11",395,"يَـٰلَيْتَ","O! Would that","يُرِيدُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","لَنَا مِثْلَ مَآ",667],["33:66:7",427,"يَـٰلَيْتَنَآ","O we wish","فِى ٱلنَّارِ يَقُولُونَ","أَطَعْنَا ٱللَّهَ وَأَطَعْنَا",667],["36:26:5",441,"يَـٰلَيْتَ","I wish","ٱدْخُلِ ٱلْجَنَّةَ ۖ قَالَ","قَوْمِى يَعْلَمُونَ",667],["43:38:5",492,"يَـٰلَيْتَ","O would that","إِذَا جَآءَنَا قَالَ","بَيْنِى وَبَيْنَكَ بُعْدَ",667],["69:25:7",567,"يَـٰلَيْتَنِى","O! I wish","كِتَـٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ","لَمْ أُوتَ كِتَـٰبِيَهْ",667],["69:27:1",567,"يَـٰلَيْتَهَا","O! I wish it","","كَانَتِ ٱلْقَاضِيَةَ",667],["78:40:13",583,"يَـٰلَيْتَنِى","O I wish","يَدَاهُ وَيَقُولُ ٱلْكَافِرُ","كُنتُ تُرَٰبًۢا",667],["89:24:2",594,"يَـٰلَيْتَنِى","O I wish","يَقُولُ","قَدَّمْتُ لِحَيَاتِى",667]]