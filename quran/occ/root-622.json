[["2:65:7",10,"ٱلسَّبْتِ","the (matter of) Sabbath","ٱعْتَدَوْا۟ مِنكُمْ فِى","فَقُلْنَا لَهُمْ كُونُوا۟",1232],["4:47:24",86,"ٱلسَّبْتِ ۚ","(of) the Sabbath","كَمَا لَعَنَّآ أَصْحَـٰبَ","وَكَانَ أَمْرُ ٱللَّهِ",1232],["4:154:15",102,"ٱلسَّبْتِ","the Sabbath","لَا تَعْدُوا۟ فِى","وَأَخَذْنَا مِنْهُم مِّيثَـٰقًا",1232],["7:163:11",171,"ٱلسَّبْتِ","the (matter of) Sabbath","إِذْ يَعْدُونَ فِى","إِذْ تَأْتِيهِمْ حِيتَانُهُمْ",1232],["7:163:16",171,"سَبْتِهِمْ","(of) their Sabbath","تَأْتِيهِمْ حِيتَانُهُمْ يَوْمَ","شُرَّعًۭا وَيَوْمَ لَا",1232],["7:163:20",171,"يَسْبِتُونَ ۙ","they had Sabbath","شُرَّعًۭا وَيَوْمَ لَا","لَا تَأْتِيهِمْ ۚ كَذَٰلِكَ",4657],["16:124:3",281,"ٱلسَّبْتُ","the Sabbath","إِنَّمَا جُعِلَ","عَلَى ٱلَّذِينَ ٱخْتَلَفُوا۟",1232],["25:47:8",364,"سُبَاتًۭا","a rest","ٱلَّيْلَ لِبَاسًۭا وَٱلنَّوْمَ","وَجَعَلَ ٱلنَّهَارَ نُشُورًۭا",2642],["78:9:3",582,"سُبَاتًۭا","(for) rest","وَجَعَلْنَا نَوْمَكُمْ","",2642]]