[["2:171:12",26,"وَنِدَآءًۭ ۚ","and cries","يَسْمَعُ إِلَّا دُعَآءًۭ","صُمٌّۢ بُكْمٌ عُمْىٌۭ",2563],["3:39:1",55,"فَنَادَتْهُ","Then called him","","ٱلْمَلَـٰٓئِكَةُ وَهُوَ قَآئِمٌۭ",269],["3:193:4",75,"مُنَادِيًۭا","a caller","رَّبَّنَآ إِنَّنَا سَمِعْنَا","يُنَادِى لِلْإِيمَـٰنِ أَنْ",3823],["3:193:5",75,"يُنَادِى","calling","إِنَّنَا سَمِعْنَا مُنَادِيًۭا","لِلْإِيمَـٰنِ أَنْ ءَامِنُوا۟",269],["5:58:2",118,"نَادَيْتُمْ","you make a call","وَإِذَا","إِلَى ٱلصَّلَوٰةِ ٱتَّخَذُوهَا",269],["7:22:15",152,"وَنَادَىٰهُمَا","And called them both","مِن وَرَقِ ٱلْجَنَّةِ ۖ","رَبُّهُمَآ أَلَمْ أَنْهَكُمَا",269],["7:43:29",155,"وَنُودُوٓا۟","And they will be addressed","رُسُلُ رَبِّنَا بِٱلْحَقِّ ۖ","أَن تِلْكُمُ ٱلْجَنَّةُ",269],["7:44:1",156,"وَنَادَىٰٓ","And will call out","","أَصْحَـٰبُ ٱلْجَنَّةِ أَصْحَـٰبَ",269],["7:46:9",156,"وَنَادَوْا۟","And they will call out","يَعْرِفُونَ كُلًّۢا بِسِيمَىٰهُمْ ۚ","أَصْحَـٰبَ ٱلْجَنَّةِ أَن",269],["7:48:1",156,"وَنَادَىٰٓ","And (will) call out","","أَصْحَـٰبُ ٱلْأَعْرَافِ رِجَالًۭا",269],["7:50:1",156,"وَنَادَىٰٓ","And (will) call out","","أَصْحَـٰبُ ٱلنَّارِ أَصْحَـٰبَ",269],["11:42:7",226,"وَنَادَىٰ","and Nuh called out","فِى مَوْجٍۢ كَٱلْجِبَالِ","نُوحٌ ٱبْنَهُۥ وَكَانَ",269],["11:45:1",226,"وَنَادَىٰ","And Nuh called","","نُوحٌۭ رَّبَّهُۥ فَقَالَ",269],["18:52:3",299,"نَادُوا۟","Call","وَيَوْمَ يَقُولُ","شُرَكَآءِىَ ٱلَّذِينَ زَعَمْتُمْ",269],["19:3:2",305,"نَادَىٰ","he called","إِذْ","رَبَّهُۥ نِدَآءً خَفِيًّۭا",269],["19:3:4",305,"نِدَآءً","a call","إِذْ نَادَىٰ رَبَّهُۥ","خَفِيًّۭا",2563],["19:24:1",306,"فَنَادَىٰهَا","So cried to her","","مِن تَحْتِهَآ أَلَّا",269],["19:52:1",309,"وَنَـٰدَيْنَـٰهُ","And We called him","","مِن جَانِبِ ٱلطُّورِ",269],["19:73:16",310,"نَدِيًّۭا","(in) assembly","خَيْرٌۭ مَّقَامًۭا وَأَحْسَنُ","",4025],["20:11:3",312,"نُودِىَ","he was called","فَلَمَّآ أَتَىٰهَا","يَـٰمُوسَىٰٓ",269],["21:76:3",328,"نَادَىٰ","he called","وَنُوحًا إِذْ","مِن قَبْلُ فَٱسْتَجَبْنَا",269],["21:83:3",329,"نَادَىٰ","he called","۞ وَأَيُّوبَ إِذْ","رَبَّهُۥٓ أَنِّى مَسَّنِىَ",269],["21:87:11",329,"فَنَادَىٰ","Then he called","لَّن نَّقْدِرَ عَلَيْهِ","فِى ٱلظُّلُمَـٰتِ أَن",269],["21:89:3",329,"نَادَىٰ","he called","وَزَكَرِيَّآ إِذْ","رَبَّهُۥ رَبِّ لَا",269],["26:10:2",367,"نَادَىٰ","your Lord called","وَإِذْ","رَبُّكَ مُوسَىٰٓ أَنِ",269],["27:8:3",377,"نُودِىَ","he was called","فَلَمَّا جَآءَهَا","أَنۢ بُورِكَ مَن",269],["28:30:3",389,"نُودِىَ","he was called","فَلَمَّآ أَتَىٰهَا","مِن شَـٰطِئِ ٱلْوَادِ",269],["28:46:6",391,"نَادَيْنَا","We called","بِجَانِبِ ٱلطُّورِ إِذْ","وَلَـٰكِن رَّحْمَةًۭ مِّن",269],["28:62:2",393,"يُنَادِيهِمْ","He will call them","وَيَوْمَ","فَيَقُولُ أَيْنَ شُرَكَآءِىَ",269],["28:65:2",393,"يُنَادِيهِمْ","He will call them","وَيَوْمَ","فَيَقُولُ مَاذَآ أَجَبْتُمُ",269],["28:74:2",394,"يُنَادِيهِمْ","He will call them","وَيَوْمَ","فَيَقُولُ أَيْنَ شُرَكَآءِىَ",269],["29:29:8",399,"نَادِيكُمُ","your meetings","ٱلسَّبِيلَ وَتَأْتُونَ فِى","ٱلْمُنكَرَ ۖ فَمَا كَانَ",2548],["37:75:2",448,"نَادَىٰنَا","called Us","وَلَقَدْ","نُوحٌۭ فَلَنِعْمَ ٱلْمُجِيبُونَ",269],["37:104:1",450,"وَنَـٰدَيْنَـٰهُ","And We called out to him","","أَن يَـٰٓإِبْرَٰهِيمُ",269],["38:3:7",453,"فَنَادَوا۟","then they called out","قَبْلِهِم مِّن قَرْنٍۢ","وَّلَاتَ حِينَ مَنَاصٍۢ",269],["38:41:5",455,"نَادَىٰ","he called","عَبْدَنَآ أَيُّوبَ إِذْ","رَبَّهُۥٓ أَنِّى مَسَّنِىَ",269],["40:10:4",468,"يُنَادَوْنَ","will be cried out to them","إِنَّ ٱلَّذِينَ كَفَرُوا۟","لَمَقْتُ ٱللَّهِ أَكْبَرُ",269],["40:32:6",470,"ٱلتَّنَادِ","(of) Calling","أَخَافُ عَلَيْكُمْ يَوْمَ","",4483],["41:44:27",481,"يُنَادَوْنَ","are being called","عَلَيْهِمْ عَمًى ۚ أُو۟لَـٰٓئِكَ","مِن مَّكَانٍۭ بَعِيدٍۢ",269],["41:47:20",482,"يُنَادِيهِمْ","He will call them","إِلَّا بِعِلْمِهِۦ ۚ وَيَوْمَ","أَيْنَ شُرَكَآءِى قَالُوٓا۟",269],["43:51:1",493,"وَنَادَىٰ","And called out","","فِرْعَوْنُ فِى قَوْمِهِۦ",269],["43:77:1",495,"وَنَادَوْا۟","And they will call","","يَـٰمَـٰلِكُ لِيَقْضِ عَلَيْنَا",269],["49:4:3",515,"يُنَادُونَكَ","call you","إِنَّ ٱلَّذِينَ","مِن وَرَآءِ ٱلْحُجُرَٰتِ",269],["50:41:3",520,"يُنَادِ","will call","وَٱسْتَمِعْ يَوْمَ","ٱلْمُنَادِ مِن مَّكَانٍۢ",269],["50:41:4",520,"ٱلْمُنَادِ","the caller","وَٱسْتَمِعْ يَوْمَ يُنَادِ","مِن مَّكَانٍۢ قَرِيبٍۢ",3822],["54:29:1",530,"فَنَادَوْا۟","But they called","","صَاحِبَهُمْ فَتَعَاطَىٰ فَعَقَرَ",269],["57:14:1",539,"يُنَادُونَهُمْ","They will call them","","أَلَمْ نَكُن مَّعَكُمْ ۖ",269],["62:9:5",554,"نُودِىَ","(the) call is made","ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا","لِلصَّلَوٰةِ مِن يَوْمِ",269],["68:21:1",565,"فَتَنَادَوْا۟","And they called one another","","مُصْبِحِينَ",4398],["68:48:9",566,"نَادَىٰ","he called out","كَصَاحِبِ ٱلْحُوتِ إِذْ","وَهُوَ مَكْظُومٌۭ",269],["79:16:2",583,"نَادَىٰهُ","called him","إِذْ","رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ",269],["79:23:2",584,"فَنَادَىٰ","and called out","فَحَشَرَ","",269],["96:17:2",598,"نَادِيَهُۥ","his associates","فَلْيَدْعُ","",2548]]