[["4:93:4",93,"مُّتَعَمِّدًۭا","intentionally","وَمَن يَقْتُلْ مُؤْمِنًۭا","فَجَزَآؤُهُۥ جَهَنَّمُ خَـٰلِدًۭا",2542],["5:95:12",123,"مُّتَعَمِّدًۭا","intentionally","وَمَن قَتَلَهُۥ مِنكُم","فَجَزَآءٌۭ مِّثْلُ مَا",2542],["13:2:6",249,"عَمَدٍۢ","pillars","رَفَعَ ٱلسَّمَـٰوَٰتِ بِغَيْرِ","تَرَوْنَهَا ۖ ثُمَّ ٱسْتَوَىٰ",1764],["31:10:4",411,"عَمَدٍۢ","pillars","خَلَقَ ٱلسَّمَـٰوَٰتِ بِغَيْرِ","تَرَوْنَهَا ۖ وَأَلْقَىٰ فِى",1764],["33:5:23",418,"تَعَمَّدَتْ","intended","بِهِۦ وَلَـٰكِن مَّا","قُلُوبُكُمْ ۚ وَكَانَ ٱللَّهُ",4321],["89:7:3",593,"ٱلْعِمَادِ","lofty pillars","إِرَمَ ذَاتِ","",3141],["104:9:2",601,"عَمَدٍۢ","columns","فِى","مُّمَدَّدَةٍۭ",1764]]