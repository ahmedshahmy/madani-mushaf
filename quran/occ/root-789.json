[["2:249:31",41,"جَاوَزَهُۥ","he crossed it","قَلِيلًۭا مِّنْهُمْ ۚ فَلَمَّا","هُوَ وَٱلَّذِينَ ءَامَنُوا۟",1558],["7:138:1",167,"وَجَـٰوَزْنَا","And We led across","","بِبَنِىٓ إِسْرَٰٓءِيلَ ٱلْبَحْرَ",1558],["10:90:1",219,"۞ وَجَـٰوَزْنَا","And We took across","","بِبَنِىٓ إِسْرَٰٓءِيلَ ٱلْبَحْرَ",1558],["18:62:2",301,"جَاوَزَا","they had passed beyond","فَلَمَّا","قَالَ لِفَتَىٰهُ ءَاتِنَا",1558],["46:16:8",504,"وَنَتَجَاوَزُ","and We will overlook","أَحْسَنَ مَا عَمِلُوا۟","عَن سَيِّـَٔاتِهِمْ فِىٓ",4052]]