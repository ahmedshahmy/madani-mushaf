[["2:17:6",4,"فَلَمَّآ","then, when","ٱلَّذِى ٱسْتَوْقَدَ نَارًۭا","أَضَآءَتْ مَا حَوْلَهُۥ",71],["2:33:5",6,"فَلَمَّآ","And when","يَـٰٓـَٔادَمُ أَنۢبِئْهُم بِأَسْمَآئِهِمْ ۖ","أَنۢبَأَهُم بِأَسْمَآئِهِمْ قَالَ",71],["2:89:1",14,"وَلَمَّا","And when","","جَآءَهُمْ كِتَـٰبٌۭ مِّنْ",71],["2:89:17",14,"فَلَمَّا","then when","عَلَى ٱلَّذِينَ كَفَرُوا۟","جَآءَهُم مَّا عَرَفُوا۟",71],["2:101:1",15,"وَلَمَّا","And when","","جَآءَهُمْ رَسُولٌۭ مِّنْ",71],["2:246:44",40,"فَلَمَّا","Yet, when","مِن دِيَـٰرِنَا وَأَبْنَآئِنَا ۖ","كُتِبَ عَلَيْهِمُ ٱلْقِتَالُ",71],["2:249:1",41,"فَلَمَّا","Then when","","فَصَلَ طَالُوتُ بِٱلْجُنُودِ",71],["2:249:30",41,"فَلَمَّا","Then when","إِلَّا قَلِيلًۭا مِّنْهُمْ ۚ","جَاوَزَهُۥ هُوَ وَٱلَّذِينَ",71],["2:250:1",41,"وَلَمَّا","And when","","بَرَزُوا۟ لِجَالُوتَ وَجُنُودِهِۦ",71],["2:259:57",43,"فَلَمَّا","Then when","ثُمَّ نَكْسُوهَا لَحْمًۭا ۚ","تَبَيَّنَ لَهُۥ قَالَ",71],["3:36:1",54,"فَلَمَّا","Then when","","وَضَعَتْهَا قَالَتْ رَبِّ",71],["3:52:1",56,"۞ فَلَمَّآ","Then when","","أَحَسَّ عِيسَىٰ مِنْهُمُ",71],["3:142:6",68,"وَلَمَّا","while has not yet","أَن تَدْخُلُوا۟ ٱلْجَنَّةَ","يَعْلَمِ ٱللَّهُ ٱلَّذِينَ",71],["3:165:1",71,"أَوَلَمَّآ","Or when","","أَصَـٰبَتْكُم مُّصِيبَةٌۭ قَدْ",71],["4:77:13",90,"فَلَمَّا","Then when","ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ","كُتِبَ عَلَيْهِمُ ٱلْقِتَالُ",71],["5:117:19",127,"فَلَمَّا","then when","مَّا دُمْتُ فِيهِمْ ۖ","تَوَفَّيْتَنِى كُنتَ أَنتَ",71],["6:5:4",128,"لَمَّا","when","فَقَدْ كَذَّبُوا۟ بِٱلْحَقِّ","جَآءَهُمْ ۖ فَسَوْفَ يَأْتِيهِمْ",71],["6:44:1",132,"فَلَمَّا","So when","","نَسُوا۟ مَا ذُكِّرُوا۟",71],["6:76:1",137,"فَلَمَّا","So when","","جَنَّ عَلَيْهِ ٱلَّيْلُ",71],["6:76:10",137,"فَلَمَّآ","But when","قَالَ هَـٰذَا رَبِّى ۖ","أَفَلَ قَالَ لَآ",71],["6:77:1",137,"فَلَمَّا","When","","رَءَا ٱلْقَمَرَ بَازِغًۭا",71],["6:77:8",137,"فَلَمَّآ","But when","قَالَ هَـٰذَا رَبِّى ۖ","أَفَلَ قَالَ لَئِن",71],["6:78:1",137,"فَلَمَّا","When","","رَءَا ٱلشَّمْسَ بَازِغَةًۭ",71],["6:78:10",137,"فَلَمَّآ","But when","رَبِّى هَـٰذَآ أَكْبَرُ ۖ","أَفَلَتْ قَالَ يَـٰقَوْمِ",71],["7:22:3",152,"فَلَمَّا","Then when","فَدَلَّىٰهُمَا بِغُرُورٍۢ ۚ","ذَاقَا ٱلشَّجَرَةَ بَدَتْ",71],["7:116:3",164,"فَلَمَّآ","Then when","قَالَ أَلْقُوا۟ ۖ","أَلْقَوْا۟ سَحَرُوٓا۟ أَعْيُنَ",71],["7:126:9",165,"لَمَّا","when","ءَامَنَّا بِـَٔايَـٰتِ رَبِّنَا","جَآءَتْنَا ۚ رَبَّنَآ أَفْرِغْ",71],["7:134:1",166,"وَلَمَّا","And when","","وَقَعَ عَلَيْهِمُ ٱلرِّجْزُ",71],["7:135:1",166,"فَلَمَّا","But when","","كَشَفْنَا عَنْهُمُ ٱلرِّجْزَ",71],["7:143:1",167,"وَلَمَّا","And when","","جَآءَ مُوسَىٰ لِمِيقَـٰتِنَا",71],["7:143:24",167,"فَلَمَّا","But when","مَكَانَهُۥ فَسَوْفَ تَرَىٰنِى ۚ","تَجَلَّىٰ رَبُّهُۥ لِلْجَبَلِ",71],["7:143:33",167,"فَلَمَّآ","And when","وَخَرَّ مُوسَىٰ صَعِقًۭا ۚ","أَفَاقَ قَالَ سُبْحَـٰنَكَ",71],["7:149:1",168,"وَلَمَّا","And when","","سُقِطَ فِىٓ أَيْدِيهِمْ",71],["7:150:1",169,"وَلَمَّا","And when","","رَجَعَ مُوسَىٰٓ إِلَىٰ",71],["7:154:1",169,"وَلَمَّا","And when","","سَكَتَ عَن مُّوسَى",71],["7:155:7",169,"فَلَمَّآ","Then when","سَبْعِينَ رَجُلًۭا لِّمِيقَـٰتِنَا ۖ","أَخَذَتْهُمُ ٱلرَّجْفَةُ قَالَ",71],["7:165:1",172,"فَلَمَّا","So when","","نَسُوا۟ مَا ذُكِّرُوا۟",71],["7:166:1",172,"فَلَمَّا","So when","","عَتَوْا۟ عَن مَّا",71],["7:189:12",175,"فَلَمَّا","And when","زَوْجَهَا لِيَسْكُنَ إِلَيْهَا ۖ","تَغَشَّىٰهَا حَمَلَتْ حَمْلًا",71],["7:189:19",175,"فَلَمَّآ","But when","خَفِيفًۭا فَمَرَّتْ بِهِۦ ۖ","أَثْقَلَت دَّعَوَا ٱللَّهَ",71],["7:190:1",175,"فَلَمَّآ","But when","","ءَاتَىٰهُمَا صَـٰلِحًۭا جَعَلَا",71],["8:48:16",183,"فَلَمَّا","But when","وَإِنِّى جَارٌۭ لَّكُمْ ۖ","تَرَآءَتِ ٱلْفِئَتَانِ نَكَصَ",71],["9:76:1",199,"فَلَمَّآ","But when","","ءَاتَىٰهُم مِّن فَضْلِهِۦ",71],["9:114:11",205,"فَلَمَّا","But when","مَّوْعِدَةٍۢ وَعَدَهَآ إِيَّاهُ","تَبَيَّنَ لَهُۥٓ أَنَّهُۥ",71],["10:12:11",209,"فَلَمَّا","But when","قَاعِدًا أَوْ قَآئِمًۭا","كَشَفْنَا عَنْهُ ضُرَّهُۥ",71],["10:13:6",209,"لَمَّا","when","ٱلْقُرُونَ مِن قَبْلِكُمْ","ظَلَمُوا۟ ۙ وَجَآءَتْهُمْ رُسُلُهُم",71],["10:23:1",211,"فَلَمَّآ","But when","","أَنجَىٰهُمْ إِذَا هُمْ",71],["10:54:13",215,"لَمَّا","when","بِهِۦ ۗ وَأَسَرُّوا۟ ٱلنَّدَامَةَ","رَأَوُا۟ ٱلْعَذَابَ ۖ وَقُضِىَ",71],["10:76:1",217,"فَلَمَّا","So when","","جَآءَهُمُ ٱلْحَقُّ مِنْ",71],["10:77:5",217,"لَمَّا","when","مُوسَىٰٓ أَتَقُولُونَ لِلْحَقِّ","جَآءَكُمْ ۖ أَسِحْرٌ هَـٰذَا",71],["10:80:1",218,"فَلَمَّا","So when","","جَآءَ ٱلسَّحَرَةُ قَالَ",71],["10:81:1",218,"فَلَمَّآ","Then when","","أَلْقَوْا۟ قَالَ مُوسَىٰ",71],["10:98:10",220,"لَمَّآ","When","إِلَّا قَوْمَ يُونُسَ","ءَامَنُوا۟ كَشَفْنَا عَنْهُمْ",71],["11:58:1",228,"وَلَمَّا","And when","","جَآءَ أَمْرُنَا نَجَّيْنَا",71],["11:66:1",229,"فَلَمَّا","So when","","جَآءَ أَمْرُنَا نَجَّيْنَا",71],["11:70:1",229,"فَلَمَّا","But when","","رَءَآ أَيْدِيَهُمْ لَا",71],["11:74:1",230,"فَلَمَّا","And when","","ذَهَبَ عَنْ إِبْرَٰهِيمَ",71],["11:77:1",230,"وَلَمَّا","And when","","جَآءَتْ رُسُلُنَا لُوطًۭا",71],["11:82:1",231,"فَلَمَّا","So when","","جَآءَ أَمْرُنَا جَعَلْنَا",71],["11:94:1",232,"وَلَمَّا","And when","","جَآءَ أَمْرُنَا نَجَّيْنَا",71],["11:101:17",233,"لَّمَّا","when","ٱللَّهِ مِن شَىْءٍۢ","جَآءَ أَمْرُ رَبِّكَ ۖ",71],["11:111:3",234,"لَّمَّا","to each [when]","وَإِنَّ كُلًّۭا","لَيُوَفِّيَنَّهُمْ رَبُّكَ أَعْمَـٰلَهُمْ ۚ",71],["12:15:1",237,"فَلَمَّا","So when","","ذَهَبُوا۟ بِهِۦ وَأَجْمَعُوٓا۟",71],["12:22:1",237,"وَلَمَّا","And when","","بَلَغَ أَشُدَّهُۥٓ ءَاتَيْنَـٰهُ",71],["12:28:1",238,"فَلَمَّا","So when","","رَءَا قَمِيصَهُۥ قُدَّ",71],["12:31:1",239,"فَلَمَّا","So when","","سَمِعَتْ بِمَكْرِهِنَّ أَرْسَلَتْ",71],["12:31:17",239,"فَلَمَّا","Then when","وَقَالَتِ ٱخْرُجْ عَلَيْهِنَّ ۖ","رَأَيْنَهُۥٓ أَكْبَرْنَهُۥ وَقَطَّعْنَ",71],["12:50:5",241,"فَلَمَّا","But when","ٱلْمَلِكُ ٱئْتُونِى بِهِۦ ۖ","جَآءَهُ ٱلرَّسُولُ قَالَ",71],["12:54:7",242,"فَلَمَّا","Then when","بِهِۦٓ أَسْتَخْلِصْهُ لِنَفْسِى ۖ","كَلَّمَهُۥ قَالَ إِنَّكَ",71],["12:59:1",242,"وَلَمَّا","And when","","جَهَّزَهُم بِجَهَازِهِمْ قَالَ",71],["12:63:1",242,"فَلَمَّا","So when","","رَجَعُوٓا۟ إِلَىٰٓ أَبِيهِمْ",71],["12:65:1",243,"وَلَمَّا","And when","","فَتَحُوا۟ مَتَـٰعَهُمْ وَجَدُوا۟",71],["12:66:16",243,"فَلَمَّآ","And when","أَن يُحَاطَ بِكُمْ ۖ","ءَاتَوْهُ مَوْثِقَهُمْ قَالَ",71],["12:68:1",243,"وَلَمَّا","And when","","دَخَلُوا۟ مِنْ حَيْثُ",71],["12:69:1",243,"وَلَمَّا","And when","","دَخَلُوا۟ عَلَىٰ يُوسُفَ",71],["12:70:1",244,"فَلَمَّا","So when","","جَهَّزَهُم بِجَهَازِهِمْ جَعَلَ",71],["12:80:1",245,"فَلَمَّا","So when","","ٱسْتَيْـَٔسُوا۟ مِنْهُ خَلَصُوا۟",71],["12:88:1",246,"فَلَمَّا","So when","","دَخَلُوا۟ عَلَيْهِ قَالُوا۟",71],["12:94:1",246,"وَلَمَّا","And when","","فَصَلَتِ ٱلْعِيرُ قَالَ",71],["12:96:1",247,"فَلَمَّآ","Then when","","أَن جَآءَ ٱلْبَشِيرُ",71],["12:99:1",247,"فَلَمَّا","Then when","","دَخَلُوا۟ عَلَىٰ يُوسُفَ",71],["14:22:3",258,"لَمَّا","when","وَقَالَ ٱلشَّيْطَـٰنُ","قُضِىَ ٱلْأَمْرُ إِنَّ",71],["15:61:1",265,"فَلَمَّا","And when","","جَآءَ ءَالَ لُوطٍ",71],["17:67:11",289,"فَلَمَّا","But when","تَدْعُونَ إِلَّآ إِيَّاهُ ۖ","نَجَّىٰكُمْ إِلَى ٱلْبَرِّ",71],["18:59:4",300,"لَمَّا","when","وَتِلْكَ ٱلْقُرَىٰٓ أَهْلَكْنَـٰهُمْ","ظَلَمُوا۟ وَجَعَلْنَا لِمَهْلِكِهِم",71],["18:61:1",300,"فَلَمَّا","But when","","بَلَغَا مَجْمَعَ بَيْنِهِمَا",71],["18:62:1",301,"فَلَمَّا","Then when","","جَاوَزَا قَالَ لِفَتَىٰهُ",71],["19:49:1",308,"فَلَمَّا","So when","","ٱعْتَزَلَهُمْ وَمَا يَعْبُدُونَ",71],["20:11:1",312,"فَلَمَّآ","Then when","","أَتَىٰهَا نُودِىَ يَـٰمُوسَىٰٓ",71],["21:12:1",323,"فَلَمَّآ","Then when","","أَحَسُّوا۟ بَأْسَنَآ إِذَا",71],["25:37:3",363,"لَّمَّا","when","وَقَوْمَ نُوحٍۢ","كَذَّبُوا۟ ٱلرُّسُلَ أَغْرَقْنَـٰهُمْ",71],["26:21:3",368,"لَمَّا","when","فَفَرَرْتُ مِنكُمْ","خِفْتُكُمْ فَوَهَبَ لِى",71],["26:41:1",369,"فَلَمَّا","So when","","جَآءَ ٱلسَّحَرَةُ قَالُوا۟",71],["26:61:1",370,"فَلَمَّا","Then when","","تَرَٰٓءَا ٱلْجَمْعَانِ قَالَ",71],["27:8:1",377,"فَلَمَّا","But when","","جَآءَهَا نُودِىَ أَنۢ",71],["27:10:3",377,"فَلَمَّا","But when","وَأَلْقِ عَصَاكَ ۚ","رَءَاهَا تَهْتَزُّ كَأَنَّهَا",71],["27:13:1",377,"فَلَمَّا","But when","","جَآءَتْهُمْ ءَايَـٰتُنَا مُبْصِرَةًۭ",71],["27:36:1",380,"فَلَمَّا","So when","","جَآءَ سُلَيْمَـٰنَ قَالَ",71],["27:40:15",380,"فَلَمَّا","Then when","يَرْتَدَّ إِلَيْكَ طَرْفُكَ ۚ","رَءَاهُ مُسْتَقِرًّا عِندَهُۥ",71],["27:42:1",380,"فَلَمَّا","So when","","جَآءَتْ قِيلَ أَهَـٰكَذَا",71],["27:44:5",380,"فَلَمَّا","Then when","لَهَا ٱدْخُلِى ٱلصَّرْحَ ۖ","رَأَتْهُ حَسِبَتْهُ لُجَّةًۭ",71],["28:14:1",387,"وَلَمَّا","And when","","بَلَغَ أَشُدَّهُۥ وَٱسْتَوَىٰٓ",71],["28:19:1",387,"فَلَمَّآ","Then when","","أَنْ أَرَادَ أَن",71],["28:22:1",388,"وَلَمَّا","And when","","تَوَجَّهَ تِلْقَآءَ مَدْيَنَ",71],["28:23:1",388,"وَلَمَّا","And when","","وَرَدَ مَآءَ مَدْيَنَ",71],["28:25:15",388,"فَلَمَّا","So when","مَا سَقَيْتَ لَنَا ۚ","جَآءَهُۥ وَقَصَّ عَلَيْهِ",71],["28:29:1",389,"۞ فَلَمَّا","Then when","","قَضَىٰ مُوسَى ٱلْأَجَلَ",71],["28:30:1",389,"فَلَمَّآ","But when","","أَتَىٰهَا نُودِىَ مِن",71],["28:31:4",389,"فَلَمَّا","But when","وَأَنْ أَلْقِ عَصَاكَ ۖ","رَءَاهَا تَهْتَزُّ كَأَنَّهَا",71],["28:36:1",390,"فَلَمَّا","But when","","جَآءَهُم مُّوسَىٰ بِـَٔايَـٰتِنَا",71],["28:48:1",391,"فَلَمَّا","But when","","جَآءَهُمُ ٱلْحَقُّ مِنْ",71],["29:31:1",400,"وَلَمَّا","And when","","جَآءَتْ رُسُلُنَآ إِبْرَٰهِيمَ",71],["29:33:1",400,"وَلَمَّآ","And when","","أَن جَآءَتْ رُسُلُنَا",71],["29:65:10",404,"فَلَمَّا","But when","مُخْلِصِينَ لَهُ ٱلدِّينَ","نَجَّىٰهُمْ إِلَى ٱلْبَرِّ",71],["29:68:11",404,"لَمَّا","when","أَوْ كَذَّبَ بِٱلْحَقِّ","جَآءَهُۥٓ ۚ أَلَيْسَ فِى",71],["31:32:10",414,"فَلَمَّا","But when","مُخْلِصِينَ لَهُ ٱلدِّينَ","نَجَّىٰهُمْ إِلَى ٱلْبَرِّ",71],["32:24:6",417,"لَمَّا","when","أَئِمَّةًۭ يَهْدُونَ بِأَمْرِنَا","صَبَرُوا۟ ۖ وَكَانُوا۟ بِـَٔايَـٰتِنَا",71],["33:22:1",420,"وَلَمَّا","And when","","رَءَا ٱلْمُؤْمِنُونَ ٱلْأَحْزَابَ",71],["33:37:26",423,"فَلَمَّا","So when","أَحَقُّ أَن تَخْشَىٰهُ ۖ","قَ