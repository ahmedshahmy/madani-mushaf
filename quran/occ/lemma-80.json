[["2:55:7",8,"حَتَّىٰ","until","لَن نُّؤْمِنَ لَكَ","نَرَى ٱللَّهَ جَهْرَةًۭ",80],["2:102:28",16,"حَتَّىٰ","unless","يُعَلِّمَانِ مِنْ أَحَدٍ","يَقُولَآ إِنَّمَا نَحْنُ",80],["2:109:24",17,"حَتَّىٰ","until","ٱلْحَقُّ ۖ فَٱعْفُوا۟ وَٱصْفَحُوا۟","يَأْتِىَ ٱللَّهُ بِأَمْرِهِۦٓ ۗ",80],["2:120:7",19,"حَتَّىٰ","until","ٱلْيَهُودُ وَلَا ٱلنَّصَـٰرَىٰ","تَتَّبِعَ مِلَّتَهُمْ ۗ قُلْ",80],["2:187:33",29,"حَتَّىٰ","until","لَكُمْ ۚ وَكُلُوا۟ وَٱشْرَبُوا۟","يَتَبَيَّنَ لَكُمُ ٱلْخَيْطُ",80],["2:191:17",30,"حَتَّىٰ","until","عِندَ ٱلْمَسْجِدِ ٱلْحَرَامِ","يُقَـٰتِلُوكُمْ فِيهِ ۖ فَإِن",80],["2:193:2",30,"حَتَّىٰ","until","وَقَـٰتِلُوهُمْ","لَا تَكُونَ فِتْنَةٌۭ",80],["2:196:14",30,"حَتَّىٰ","until","وَلَا تَحْلِقُوا۟ رُءُوسَكُمْ","يَبْلُغَ ٱلْهَدْىُ مَحِلَّهُۥ ۚ",80],["2:214:17",33,"حَتَّىٰ","until","ٱلْبَأْسَآءُ وَٱلضَّرَّآءُ وَزُلْزِلُوا۟","يَقُولَ ٱلرَّسُولُ وَٱلَّذِينَ",80],["2:217:32",34,"حَتَّىٰ","until","وَلَا يَزَالُونَ يُقَـٰتِلُونَكُمْ","يَرُدُّوكُمْ عَن دِينِكُمْ",80],["2:221:4",35,"حَتَّىٰ","until","وَلَا تَنكِحُوا۟ ٱلْمُشْرِكَـٰتِ","يُؤْمِنَّ ۚ وَلَأَمَةٌۭ مُّؤْمِنَةٌ",80],["2:221:16",35,"حَتَّىٰ","until","وَلَا تُنكِحُوا۟ ٱلْمُشْرِكِينَ","يُؤْمِنُوا۟ ۚ وَلَعَبْدٌۭ مُّؤْمِنٌ",80],["2:222:13",35,"حَتَّىٰ","until","ٱلْمَحِيضِ ۖ وَلَا تَقْرَبُوهُنَّ","يَطْهُرْنَ ۖ فَإِذَا تَطَهَّرْنَ",80],["2:230:8",36,"حَتَّىٰ","until","لَهُۥ مِنۢ بَعْدُ","تَنكِحَ زَوْجًا غَيْرَهُۥ ۗ",80],["2:235:31",38,"حَتَّىٰ","until","تَعْزِمُوا۟ عُقْدَةَ ٱلنِّكَاحِ","يَبْلُغَ ٱلْكِتَـٰبُ أَجَلَهُۥ ۚ",80],["3:92:4",62,"حَتَّىٰ","until","لَن تَنَالُوا۟ ٱلْبِرَّ","تُنفِقُوا۟ مِمَّا تُحِبُّونَ ۚ",80],["3:152:8",69,"حَتَّىٰٓ","until","إِذْ تَحُسُّونَهُم بِإِذْنِهِۦ ۖ","إِذَا فَشِلْتُمْ وَتَنَـٰزَعْتُمْ",80],["3:179:10",73,"حَتَّىٰ","until","مَآ أَنتُمْ عَلَيْهِ","يَمِيزَ ٱلْخَبِيثَ مِنَ",80],["3:183:10",74,"حَتَّىٰ","until","أَلَّا نُؤْمِنَ لِرَسُولٍ","يَأْتِيَنَا بِقُرْبَانٍۢ تَأْكُلُهُ",80],["4:6:3",77,"حَتَّىٰٓ","until","وَٱبْتَلُوا۟ ٱلْيَتَـٰمَىٰ","إِذَا بَلَغُوا۟ ٱلنِّكَاحَ",80],["4:15:15",80,"حَتَّىٰ","until","فَأَمْسِكُوهُنَّ فِى ٱلْبُيُوتِ","يَتَوَفَّىٰهُنَّ ٱلْمَوْتُ أَوْ",80],["4:18:6",80,"حَتَّىٰٓ","until","لِلَّذِينَ يَعْمَلُونَ ٱلسَّيِّـَٔاتِ","إِذَا حَضَرَ أَحَدَهُمُ",80],["4:43:9",85,"حَتَّىٰ","until","ٱلصَّلَوٰةَ وَأَنتُمْ سُكَـٰرَىٰ","تَعْلَمُوا۟ مَا تَقُولُونَ",80],["4:43:18",85,"حَتَّىٰ","until","إِلَّا عَابِرِى سَبِيلٍ","تَغْتَسِلُوا۟ ۚ وَإِن كُنتُم",80],["4:65:5",88,"حَتَّىٰ","until","وَرَبِّكَ لَا يُؤْمِنُونَ","يُحَكِّمُوكَ فِيمَا شَجَرَ",80],["4:89:12",92,"حَتَّىٰ","until","تَتَّخِذُوا۟ مِنْهُمْ أَوْلِيَآءَ","يُهَاجِرُوا۟ فِى سَبِيلِ",80],["4:140:18",100,"حَتَّىٰ","until","فَلَا تَقْعُدُوا۟ مَعَهُمْ","يَخُوضُوا۟ فِى حَدِيثٍ",80],["5:22:10",111,"حَتَّىٰ","until","وَإِنَّا لَن نَّدْخُلَهَا","يَخْرُجُوا۟ مِنْهَا فَإِن",80],["5:68:7",119,"حَتَّىٰ","until","لَسْتُمْ عَلَىٰ شَىْءٍ","تُقِيمُوا۟ ٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ",80],["6:25:21",130,"حَتَّىٰٓ","Until","لَّا يُؤْمِنُوا۟ بِهَا ۚ","إِذَا جَآءُوكَ يُجَـٰدِلُونَكَ",80],["6:31:7",131,"حَتَّىٰٓ","until","كَذَّبُوا۟ بِلِقَآءِ ٱللَّهِ ۖ","إِذَا جَآءَتْهُمُ ٱلسَّاعَةُ",80],["6:34:11",131,"حَتَّىٰٓ","until","مَا كُذِّبُوا۟ وَأُوذُوا۟","أَتَىٰهُمْ نَصْرُنَا ۚ وَلَا",80],["6:44:11",132,"حَتَّىٰٓ","until","أَبْوَٰبَ كُلِّ شَىْءٍ","إِذَا فَرِحُوا۟ بِمَآ",80],["6:61:8",135,"حَتَّىٰٓ","until","وَيُرْسِلُ عَلَيْكُمْ حَفَظَةً","إِذَا جَآءَ أَحَدَكُمُ",80],["6:68:9",135,"حَتَّىٰ","until","ءَايَـٰتِنَا فَأَعْرِضْ عَنْهُمْ","يَخُوضُوا۟ فِى حَدِيثٍ",80],["6:124:7",143,"حَتَّىٰ","until","قَالُوا۟ لَن نُّؤْمِنَ","نُؤْتَىٰ مِثْلَ مَآ",80],["6:148:20",148,"حَتَّىٰ","until","ٱلَّذِينَ مِن قَبْلِهِمْ","ذَاقُوا۟ بَأْسَنَا ۗ قُلْ",80],["6:152:9",149,"حَتَّىٰ","until","بِٱلَّتِى هِىَ أَحْسَنُ","يَبْلُغَ أَشُدَّهُۥ ۖ وَأَوْفُوا۟",80],["7:37:16",154,"حَتَّىٰٓ","until","نَصِيبُهُم مِّنَ ٱلْكِتَـٰبِ ۖ","إِذَا جَآءَتْهُمْ رُسُلُنَا",80],["7:38:19",155,"حَتَّىٰٓ","until","أُمَّةٌۭ لَّعَنَتْ أُخْتَهَا ۖ","إِذَا ٱدَّارَكُوا۟ فِيهَا",80],["7:40:15",155,"حَتَّىٰ","until","وَلَا يَدْخُلُونَ ٱلْجَنَّةَ","يَلِجَ ٱلْجَمَلُ فِى",80],["7:57:9",157,"حَتَّىٰٓ","until","بَيْنَ يَدَىْ رَحْمَتِهِۦ ۖ","إِذَآ أَقَلَّتْ سَحَابًۭا",80],["7:87:13",161,"حَتَّىٰ","until","لَّمْ يُؤْمِنُوا۟ فَٱصْبِرُوا۟","يَحْكُمَ ٱللَّهُ بَيْنَنَا ۚ",80],["7:95:6",162,"حَتَّىٰ","until","مَكَانَ ٱلسَّيِّئَةِ ٱلْحَسَنَةَ","عَفَوا۟ وَّقَالُوا۟ قَدْ",80],["8:39:2",181,"حَتَّىٰ","until","وَقَـٰتِلُوهُمْ","لَا تَكُونَ فِتْنَةٌۭ",80],["8:53:11",184,"حَتَّىٰ","until","أَنْعَمَهَا عَلَىٰ قَوْمٍ","يُغَيِّرُوا۟ مَا بِأَنفُسِهِمْ ۙ",80],["8:67:8",185,"حَتَّىٰ","until","يَكُونَ لَهُۥٓ أَسْرَىٰ","يُثْخِنَ فِى ٱلْأَرْضِ ۚ",80],["8:72:28",186,"حَتَّىٰ","until","وَلَـٰيَتِهِم مِّن شَىْءٍ","يُهَاجِرُوا۟ ۚ وَإِنِ ٱسْتَنصَرُوكُمْ",80],["9:6:7",187,"حَتَّىٰ","until","ٱلْمُشْرِكِينَ ٱسْتَجَارَكَ فَأَجِرْهُ","يَسْمَعَ كَلَـٰمَ ٱللَّهِ",80],["9:24:25",190,"حَتَّىٰ","until","فِى سَبِيلِهِۦ فَتَرَبَّصُوا۟","يَأْتِىَ ٱللَّهُ بِأَمْرِهِۦ ۗ",80],["9:29:23",191,"حَتَّىٰ","until","ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ","يُعْطُوا۟ ٱلْجِزْيَةَ عَن",80],["9:43:7",194,"حَتَّىٰ","until","لِمَ أَذِنتَ لَهُمْ","يَتَبَيَّنَ لَكَ ٱلَّذِينَ",80],["9:48:9",195,"حَتَّىٰ","until","وَقَلَّبُوا۟ لَكَ ٱلْأُمُورَ","جَآءَ ٱلْحَقُّ وَظَهَرَ",80],["9:115:9",205,"حَتَّىٰ","until","بَعْدَ إِذْ هَدَىٰهُمْ","يُبَيِّنَ لَهُم مَّا",80],["9:118:5",206,"حَتَّىٰٓ","until","ٱلثَّلَـٰثَةِ ٱلَّذِينَ خُلِّفُوا۟","إِذَا ضَاقَتْ عَلَيْهِمُ",80],["10:22:7",211,"حَتَّىٰٓ","until","فِى ٱلْبَرِّ وَٱلْبَحْرِ ۖ","إِذَا كُنتُمْ فِى",80],["10:24:17",211,"حَتَّىٰٓ","until","يَأْكُلُ ٱلنَّاسُ وَٱلْأَنْعَـٰمُ","إِذَآ أَخَذَتِ ٱلْأَرْضُ",80],["10:88:26",218,"حَتَّىٰ","until","قُلُوبِهِمْ فَلَا يُؤْمِنُوا۟","يَرَوُا۟ ٱلْعَذَابَ ٱلْأَلِيمَ",80],["10:90:10",219,"حَتَّىٰٓ","until","وَجُنُودُهُۥ بَغْيًۭا وَعَدْوًا ۖ","إِذَآ أَدْرَكَهُ ٱلْغَرَقُ",80],["10:93:12",219,"حَتَّىٰ","until","ٱلطَّيِّبَـٰتِ فَمَا ٱخْتَلَفُوا۟","جَآءَهُمُ ٱلْعِلْمُ ۚ إِنَّ",80],["10:97:5",219,"حَتَّىٰ","until","جَآءَتْهُمْ كُلُّ ءَايَةٍ","يَرَوُا۟ ٱلْعَذَابَ ٱلْأَلِيمَ",80],["10:99:13",220,"حَتَّىٰ","until","أَفَأَنتَ تُ