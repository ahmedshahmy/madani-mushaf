[["7:85:4",161,"شُعَيْبًۭا ۗ","Shuaib","وَإِلَىٰ مَدْيَنَ أَخَاهُمْ","قَالَ يَـٰقَوْمِ ٱعْبُدُوا۟",758],["7:88:8",162,"يَـٰشُعَيْبُ","O Shuaib","مِن قَوْمِهِۦ لَنُخْرِجَنَّكَ","وَٱلَّذِينَ ءَامَنُوا۟ مَعَكَ",758],["7:90:9",162,"شُعَيْبًا","Shuaib","قَوْمِهِۦ لَئِنِ ٱتَّبَعْتُمْ","إِنَّكُمْ إِذًۭا لَّخَـٰسِرُونَ",758],["7:92:3",162,"شُعَيْبًۭا","Shuaib","ٱلَّذِينَ كَذَّبُوا۟","كَأَن لَّمْ يَغْنَوْا۟",758],["7:92:10",162,"شُعَيْبًۭا","Shuaib","فِيهَا ۚ ٱلَّذِينَ كَذَّبُوا۟","كَانُوا۟ هُمُ ٱلْخَـٰسِرِينَ",758],["11:84:4",231,"شُعَيْبًۭا ۚ","Shuaib","۞ وَإِلَىٰ مَدْيَنَ أَخَاهُمْ","قَالَ يَـٰقَوْمِ ٱعْبُدُوا۟",758],["11:87:2",231,"يَـٰشُعَيْبُ","O Shuaib","قَالُوا۟","أَصَلَوٰتُكَ تَأْمُرُكَ أَن",758],["11:91:2",232,"يَـٰشُعَيْبُ","O Shuaib","قَالُوا۟","مَا نَفْقَهُ كَثِيرًۭا",758],["11:94:5",232,"شُعَيْبًۭا","Shuaib","جَآءَ أَمْرُنَا نَجَّيْنَا","وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ",758],["26:177:4",374,"شُعَيْبٌ","Shuaib","إِذْ قَالَ لَهُمْ","أَلَا تَتَّقُونَ",758],["29:36:4",400,"شُعَيْبًۭا","Shuaib","وَإِلَىٰ مَدْيَنَ أَخَاهُمْ","فَقَالَ يَـٰقَوْمِ ٱعْبُدُوا۟",758]]