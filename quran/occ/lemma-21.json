[["2:36:3",6,"عَنْهَا","from it","فَأَزَلَّهُمَا ٱلشَّيْطَـٰنُ","فَأَخْرَجَهُمَا مِمَّا كَانَا",21],["2:48:6",7,"عَن","for","لَّا تَجْزِى نَفْسٌ","نَّفْسٍۢ شَيْـًۭٔا وَلَا",21],["2:52:3",8,"عَنكُم","you","ثُمَّ عَفَوْنَا","مِّنۢ بَعْدِ ذَٰلِكَ",21],["2:74:36",11,"عَمَّا","of what","وَمَا ٱللَّهُ بِغَـٰفِلٍ","تَعْمَلُونَ",21],["2:85:48",13,"عَمَّا","of what","وَمَا ٱللَّهُ بِغَـٰفِلٍ","تَعْمَلُونَ",21],["2:86:9",13,"عَنْهُمُ","for them","بِٱلْـَٔاخِرَةِ ۖ فَلَا يُخَفَّفُ","ٱلْعَذَابُ وَلَا هُمْ",21],["2:119:8",18,"عَنْ","about","وَنَذِيرًۭا ۖ وَلَا تُسْـَٔلُ","أَصْحَـٰبِ ٱلْجَحِيمِ",21],["2:120:3",19,"عَنكَ","with you","وَلَن تَرْضَىٰ","ٱلْيَهُودُ وَلَا ٱلنَّصَـٰرَىٰ",21],["2:123:6",19,"عَن","(of)","لَّا تَجْزِى نَفْسٌ","نَّفْسٍۢ شَيْـًۭٔا وَلَا",21],["2:130:3",20,"عَن","from","وَمَن يَرْغَبُ","مِّلَّةِ إِبْرَٰهِـۧمَ إِلَّا",21],["2:134:13",20,"عَمَّا","about what","كَسَبْتُمْ ۖ وَلَا تُسْـَٔلُونَ","كَانُوا۟ يَعْمَلُونَ",21],["2:140:29",21,"عَمَّا","of what","وَمَا ٱللَّهُ بِغَـٰفِلٍ","تَعْمَلُونَ",21],["2:141:13",21,"عَمَّا","about what","كَسَبْتُمْ ۖ وَلَا تُسْـَٔلُونَ","كَانُوا۟ يَعْمَلُونَ",21],["2:142:7",22,"عَن","from","ٱلنَّاسِ مَا وَلَّىٰهُمْ","قِبْلَتِهِمُ ٱلَّتِى كَانُوا۟",21],["2:144:33",22,"عَمَّا","of what","وَمَا ٱللَّهُ بِغَـٰفِلٍ","يَعْمَلُونَ",21],["2:149:16",23,"عَمَّا","of what","وَمَا ٱللَّهُ بِغَـٰفِلٍ","تَعْمَلُونَ",21],["2:162:5",24,"عَنْهُمُ","for them","فِيهَا ۖ لَا يُخَفَّفُ","ٱلْعَذَابُ وَلَا هُمْ",21],["2:186:4",28,"عَنِّى","about Me","وَإِذَا سَأَلَكَ عِبَادِى","فَإِنِّى قَرِيبٌ ۖ أُجِيبُ",21],["2:187:23",29,"عَنكُمْ ۖ","[on] you","فَتَابَ عَلَيْكُمْ وَعَفَا","فَٱلْـَٔـٰنَ بَـٰشِرُوهُنَّ وَٱبْتَغُوا۟",21],["2:189:2",29,"عَنِ","about","۞ يَسْـَٔلُونَكَ","ٱلْأَهِلَّةِ ۖ قُلْ هِىَ",21],["2:217:2",34,"عَنِ","about","يَسْـَٔلُونَكَ","ٱلشَّهْرِ ٱلْحَرَامِ قِتَالٍۢ",21],["2:217:12",34,"عَن","from","فِيهِ كَبِيرٌۭ ۖ وَصَدٌّ","سَبِيلِ ٱللَّهِ وَكُفْرٌۢ",21],["2:217:34",34,"عَن","from","يُقَـٰتِلُونَكُمْ حَتَّىٰ يَرُدُّوكُمْ","دِينِكُمْ إِنِ ٱسْتَطَـٰعُوا۟ ۚ",21],["2:217:41",34,"عَن","from","وَمَن يَرْتَدِدْ مِنكُمْ","دِينِهِۦ فَيَمُتْ وَهُوَ",21],["2:219:2",34,"عَنِ","about","۞ يَسْـَٔلُونَكَ","ٱلْخَمْرِ وَٱلْمَيْسِرِ ۖ قُلْ",21],["2:220:5",35,"عَنِ","about","ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ ۗ وَيَسْـَٔلُونَكَ","ٱلْيَتَـٰمَىٰ ۖ قُلْ إِصْلَاحٌۭ",21],["2:222:2",35,"عَنِ","about","وَيَسْـَٔلُونَكَ","ٱلْمَحِيضِ ۖ قُلْ هُوَ",21],["2:233:37",37,"عَن","through","فَإِنْ أَرَادَا فِصَالًا","تَرَاضٍۢ مِّنْهُمَا وَتَشَاوُرٍۢ",21],["2:271:14",46,"عَنكُم","from you","خَيْرٌۭ لَّكُمْ ۚ وَيُكَفِّرُ","مِّن سَيِّـَٔاتِكُمْ ۗ وَٱللَّهُ",21],["2:286:40",49,"عَنَّا","[from] us","لَنَا بِهِۦ ۖ وَٱعْفُ","وَٱغْفِرْ لَنَا وَٱرْحَمْنَآ ۚ",21],["3:10:6",51,"عَنْهُمْ","[for] them","كَفَرُوا۟ لَن تُغْنِىَ","أَمْوَٰلُهُمْ وَلَآ أَوْلَـٰدُهُم",21],["3:88:5",61,"عَنْهُمُ","for them","فِيهَا لَا يُخَفَّفُ","ٱلْعَذَابُ وَلَا هُمْ",21],["3:97:24",62,"عَنِ","of","فَإِنَّ ٱللَّهَ غَنِىٌّ","ٱلْعَـٰلَمِينَ",21],["3:99:6",62,"عَن","from","ٱلْكِتَـٰبِ لِمَ تَصُدُّونَ","سَبِيلِ ٱللَّهِ مَنْ",21],["3:99:18",62,"عَمَّا","of what","وَمَا ٱللَّهُ بِغَـٰفِلٍ","تَعْمَلُونَ",21],["3:104:10",63,"عَنِ","from","وَيَأْمُرُونَ بِٱلْمَعْرُوفِ وَيَنْهَوْنَ","ٱلْمُنكَرِ ۚ وَأُو۟لَـٰٓئِكَ هُمُ",21],["3:110:9",64,"عَنِ","[from]","تَأْمُرُونَ بِٱلْمَعْرُوفِ وَتَنْهَوْنَ","ٱلْمُنكَرِ وَتُؤْمِنُونَ بِٱللَّهِ ۗ",21],["3:114:8",64,"عَنِ","[from]","وَيَأْمُرُونَ بِٱلْمَعْرُوفِ وَيَنْهَوْنَ","ٱلْمُنكَرِ وَيُسَـٰرِعُونَ فِى",21],["3:116:6",65,"عَنْهُمْ","[for] them","كَفَرُوا۟ لَن تُغْنِىَ","أَمْوَٰلُهُمْ وَلَآ أَوْلَـٰدُهُم",21],["3:134:9",67,"عَنِ","[from]","وَٱلْكَـٰظِمِينَ ٱلْغَيْظَ وَٱلْعَافِينَ","ٱلنَّاسِ ۗ وَٱللَّهُ يُحِبُّ",21],["3:152:31",69,"عَنْهُمْ","from them","ٱلْـَٔاخِرَةَ ۚ ثُمَّ صَرَفَكُمْ","لِيَبْتَلِيَكُمْ ۖ وَلَقَدْ عَفَا",21],["3:152:35",69,"عَنكُمْ ۗ","you","لِيَبْتَلِيَكُمْ ۖ وَلَقَدْ عَفَا","وَٱللَّهُ ذُو فَضْلٍ",21],["3:155:17",70,"عَنْهُمْ ۗ","[on] them","وَلَقَدْ عَفَا ٱللَّهُ","إِنَّ ٱللَّهَ غَفُورٌ",21],["3:159:16",71,"عَنْهُمْ","[from] them","مِنْ حَوْلِكَ ۖ فَٱعْفُ","وَٱسْتَغْفِرْ لَهُمْ وَشَاوِرْهُمْ",21],["3:168:11",72,"عَنْ","from","قُتِلُوا۟ ۗ قُلْ فَٱدْرَءُوا۟","أَنفُسِكُمُ ٱلْمَوْتَ إِن",21],["3:185:12",74,"عَنِ","from","ٱلْقِيَـٰمَةِ ۖ فَمَن زُحْزِحَ","ٱلنَّارِ وَأُدْخِلَ ٱلْجَنَّةَ",21],["3:193:16",75,"عَنَّا","from us","لَنَا ذُنُوبَنَا وَكَفِّرْ","سَيِّـَٔاتِنَا وَتَوَفَّنَا مَعَ",21],["3:195:28",76,"عَنْهُمْ","from them","وَقَـٰتَلُوا۟ وَقُتِلُوا۟ لَأُكَفِّرَنَّ","سَيِّـَٔاتِهِمْ وَلَأُدْخِلَنَّهُمْ جَنَّـٰتٍۢ",21],["4:4:8",77,"عَن","of","فَإِن طِبْنَ لَكُمْ","شَىْءٍۢ مِّنْهُ نَفْسًۭا",21],["4:16:9",80,"عَنْهُمَآ ۗ","from both of them","تَابَا وَأَصْلَحَا فَأَعْرِضُوا۟","إِنَّ ٱللَّهَ كَانَ",21],["4:28:5",83,"عَنكُمْ ۚ","for you","ٱللَّهُ أَن يُخَفِّفَ","وَخُلِقَ ٱلْإِنسَـٰنُ ضَعِيفًۭا",21],["4:29:13",83,"عَن","on","أَن تَكُونَ تِجَـٰرَةً","تَرَاضٍۢ مِّنكُمْ ۚ وَلَا",21],["4:31:6",83,"عَنْهُ","from [it]","كَبَآئِرَ مَا تُنْهَوْنَ","نُكَفِّرْ عَنكُمْ سَيِّـَٔاتِكُمْ",21],["4:31:8",83,"عَنكُمْ","from you","تُنْهَوْنَ عَنْهُ نُكَفِّرْ","سَيِّـَٔاتِكُمْ وَنُدْخِلْكُم مُّدْخَلًۭا",21],["4:46:6",86,"عَن","from","هَادُوا۟ يُحَرِّفُونَ ٱلْكَلِمَ","مَّوَاضِعِهِۦ وَيَقُولُونَ سَمِعْنَا",21],["4:55:8",87,"عَنْهُ ۚ","from him","وَمِنْهُم مَّن صَدَّ","وَكَفَىٰ بِجَهَنَّمَ سَعِيرًا",21],["4:61:14",88,"عَنكَ","from you","رَأَيْتَ ٱلْمُنَـٰفِقِينَ يَصُدُّونَ","صُدُودًۭا",21],["4:63:9",88,"عَنْهُمْ","from them","فِى قُلُوبِهِمْ فَأَعْرِضْ","وَعِظْهُمْ وَقُل لَّهُمْ",21],["4:81:18",91,"عَنْهُمْ","from them","مَا يُبَيِّتُونَ ۖ فَأَعْرِضْ","وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ",21],["4:99:6",94,"عَنْهُمْ ۚ","[on] them","ٱللَّهُ أَن يَعْفُوَ","وَكَانَ ٱللَّهُ عَفُوًّا",21],["4:102:33",95,"عَنْ","[about]","كَفَرُوا۟ لَوْ تَغْفُلُونَ","أَسْلِحَتِكُمْ وَأَمْتِعَتِكُمْ فَيَمِيلُونَ",21],["4:107:3",96,"عَنِ","for","وَلَا تُجَـٰدِلْ","ٱلَّذِينَ يَخْتَانُونَ أَنفُسَهُمْ ۚ",21],["4:109:4",96,"عَنْهُمْ","for them","هَـٰٓأَنتُمْ هَـٰٓؤُلَآءِ جَـٰدَلْتُمْ","فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا",21],["4:109:11",96,"عَنْهُمْ","for them","فَمَن يُجَـٰدِلُ ٱللَّهَ","يَوْمَ ٱلْقِيَـٰمَةِ أَم",21],["4:121:6",97,"عَنْهَا","from it","جَهَنَّمُ وَلَا يَجِدُونَ","مَحِيصًۭا",21],["4:149:8",102,"عَن","[of]","تُخْفُوهُ أَوْ تَعْفُوا۟","سُوٓءٍۢ فَإِنَّ ٱللَّهَ",21],["4:153:32",102,"عَن","for","جَآءَتْهُمُ ٱلْبَيِّنَـٰتُ فَعَفَوْنَا","ذَٰلِكَ ۚ وَءَاتَيْنَا مُوسَىٰ",21],["4:160:11",103,"عَن","from","أُحِلَّتْ لَهُمْ وَبِصَدِّهِمْ","سَبِيلِ ٱللَّهِ كَثِيرًۭا",21],["4:161:5",103,"عَنْهُ","from it","ٱلرِّبَوٰا۟ وَقَدْ نُهُوا۟","وَأَكْلِهِمْ أَمْوَٰلَ ٱلنَّاسِ",21],["4:167:5",104,"عَن","from","ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوا۟","سَبِيلِ ٱللَّهِ قَدْ",21],["4:172:13",105,"عَنْ","from","ٱلْمُقَرَّبُونَ ۚ وَمَن يَسْتَنكِفْ","عِبَادَتِهِۦ وَيَسْتَكْبِرْ فَسَيَحْشُرُهُمْ",21],["5:2:33",106,"عَنِ","from","قَوْمٍ أَن صَدُّوكُمْ","ٱلْمَسْجِدِ ٱلْحَرَامِ أَن",21],["5:11:17",109,"عَنكُمْ ۖ","from you","أَيْدِيَهُمْ فَكَفَّ أَيْدِيَهُمْ","وَٱتَّقُوا۟ ٱللَّهَ ۚ وَعَلَى",21],["5:12:29",109,"عَنكُمْ","from you","قَرْضًا حَسَنًۭا لَّأُكَفِّرَنَّ","سَيِّـَٔاتِكُمْ وَلَأُدْخِلَنَّكُمْ جَنَّـٰتٍۢ",21],["5:13:10",109,"عَن","from","قَـٰسِيَةًۭ ۖ يُحَرِّفُونَ ٱلْكَلِمَ","مَّوَاضِعِهِۦ ۙ وَنَسُوا۟ حَظًّۭا",21],["5:13:27",109,"عَنْهُمْ","them","قَلِيلًۭا مِّنْهُمْ ۖ فَٱعْفُ","وَٱصْفَحْ ۚ إِنَّ ٱللَّهَ",21],["5:15:15",110,"عَن","of","مِنَ ٱلْكِتَـٰبِ وَيَعْفُوا۟","كَثِيرٍۢ ۚ قَدْ جَآءَكُم",21],["5:42:11",115,"عَنْهُمْ ۖ","from them","بَيْنَهُمْ أَوْ أَعْرِضْ","وَإِن تُعْرِضْ عَنْهُمْ",21],["5:42:14",115,"عَنْهُمْ","from them","عَنْهُمْ ۖ وَإِن تُعْرِضْ","فَلَن يَضُرُّوكَ شَيْـًۭٔا ۖ",21],["5:48:21",116,"عَمَّا","when","وَلَا تَتَّبِعْ أَهْوَآءَهُمْ","جَآءَكَ مِنَ ٱلْحَقِّ ۚ",21],["5:49:13",116,"عَنۢ","from","وَٱحْذَرْهُمْ أَن يَفْتِنُوكَ","بَعْضِ مَآ أَنزَلَ",21],["5:54:7",117,"عَن","from","مَن يَرْتَدَّ مِنكُمْ","دِينِهِۦ فَسَوْفَ يَأْتِى",21],["5:60:25",118,"عَن","from","شَرٌّۭ مَّكَانًۭا وَأَضَلُّ","سَوَآءِ ٱلسَّبِيلِ",21],["5:63:5",118,"عَن","from","يَنْهَىٰهُمُ ٱلرَّبَّـٰنِيُّونَ وَٱلْأَحْبَارُ","قَوْلِهِمُ ٱلْإِثْمَ وَأَكْلِهِمُ",21],["5:65:8",119,"عَنْهُمْ","from them","ءَامَنُوا۟ وَٱتَّقَوْا۟ لَكَفَّرْنَا","سَيِّـَٔاتِهِمْ وَلَأَدْخَلْنَـٰهُمْ جَنَّـٰتِ",21],["5:73:18",120,"عَمَّا","from what","وَإِن لَّمْ يَنتَهُوا۟","يَقُولُونَ لَيَمَسَّنَّ ٱلَّذِينَ",21],["5:77:21",120,"عَن","from","وَأَضَلُّوا۟ كَثِيرًۭا وَضَلُّوا۟","سَوَآءِ ٱلسَّبِيلِ",21],["5:79:4",121,"عَن","from","كَانُوا۟ لَا يَتَنَاهَوْنَ","مُّنكَرٍۢ فَعَلُوهُ ۚ لَبِئْسَ",21],["5:91:13",123,"عَن","from","ٱلْخَمْرِ وَٱلْمَيْسِرِ وَيَصُدَّكُمْ","ذِكْرِ ٱللَّهِ وَعَنِ",21],["5:91:16",123,"وَعَنِ","and from","عَن ذِكْرِ ٱللَّهِ","ٱلصَّلَوٰةِ ۖ فَهَلْ أَنتُم",21],["5:95:40",123,"عَمَّا","what","أَمْرِهِۦ ۗ عَفَا ٱللَّهُ","سَلَفَ ۚ وَمَنْ عَادَ",21],["5:101:6",124,"عَنْ","about","ءَامَنُوا۟ لَا تَسْـَٔلُوا۟","أَشْيَآءَ إِن تُبْدَ",21],["5:101:14",124,"عَنْهَا","about it","تَسُؤْكُمْ وَإِن تَسْـَٔلُوا۟","حِينَ يُنَزَّلُ ٱلْقُرْءَانُ",21],["5:101:22",124,"عَنْهَا ۗ","[about] it","لَكُمْ عَفَا ٱللَّهُ","وَٱللَّهُ غَفُورٌ حَلِيمٌۭ",21],["5:110:51",126,"عَنكَ","from you","كَفَفْتُ بَنِىٓ إِسْرَٰٓءِيلَ","إِذْ جِئْتَهُم بِٱلْبَيِّنَـٰتِ",21],["5:119:19",127,"عَنْهُمْ","with them","أَبَدًۭا ۚ رَّضِىَ ٱللَّهُ","وَرَضُوا۟ عَنْهُ ۚ ذَٰلِكَ",21],["5:119:21",127,"عَنْهُ ۚ","with Him","ٱللَّهُ عَنْهُمْ وَرَضُوا۟","ذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ",21],["6:4:10",128,"عَنْهَا","from it","رَبِّهِمْ إِلَّا كَانُوا۟","مُعْرِضِينَ",21],["6:16:3",129,"عَنْهُ","from it","مَّن يُصْرَفْ","يَوْمَئِذٍۢ فَقَدْ رَحِمَهُۥ ۚ",21],["6:24:7",130,"عَنْهُم","from them","عَلَىٰٓ أَنفُسِهِمْ ۚ وَضَلَّ","مَّا كَانُوا۟ يَفْتَرُونَ",21],["6:26:3",130,"عَنْهُ","from it","وَهُمْ يَنْهَوْنَ","وَيَنْـَٔوْنَ عَنْهُ ۖ وَإِن",21],["6:26:5",130,"عَنْهُ ۖ","from it","يَنْهَوْنَ عَنْهُ وَيَنْـَٔوْنَ","وَإِن يُهْلِكُونَ إِلَّآ",21],["6:28:14",131,"عَنْهُ","from it","لَعَادُوا۟ لِمَا نُهُوا۟","وَإِنَّهُمْ لَكَـٰذِبُونَ",21],["6:68:8",135,"عَنْهُمْ","from them","فِىٓ ءَايَـٰتِنَا فَأَعْرِضْ","حَتَّىٰ يَخُوضُوا۟ فِى",21],["6:88:13",138,"عَنْهُم","for them","وَلَوْ أَشْرَكُوا۟ لَحَبِطَ","مَّا كَانُوا۟ يَعْمَلُونَ",21],["6:93:47",139,"عَنْ","towards","غَيْرَ ٱلْحَقِّ وَكُنتُمْ","ءَايَـٰتِهِۦ تَسْتَكْبِرُونَ",21],["6:94:26",139,"عَنكُم","from you","تَّقَطَّعَ بَيْنَكُمْ وَضَلَّ","مَّا كُنتُمْ تَزْعُمُونَ",21],["6:100:14",140,"عَمَّا","above what","عِلْمٍۢ ۚ سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ","يَصِفُونَ",21],["6:106:12",141,"عَنِ","from","إِلَّا هُوَ ۖ وَأَعْرِضْ","ٱلْمُشْرِكِينَ",21],["6:116:8",142,"عَن","from","فِى ٱلْأَرْضِ يُضِلُّوكَ","سَبِيلِ ٱللَّهِ ۚ إِن",21],["6:117:7",142,"عَن","from","أَعْلَمُ مَن يَضِلُّ","سَبِيلِهِۦ ۖ وَهُوَ أَعْلَمُ",21],["6:132:8",145,"عَمَّا","about what","وَمَا رَبُّكَ بِغَـٰفِلٍ","يَعْمَلُونَ",21],["6:147:11",148,"عَنِ","from","وَلَا يُرَدُّ بَأْسُهُۥ","ٱلْقَوْمِ ٱلْمُجْرِمِينَ",21],["6:153:11",149,"عَن","from","ٱلسُّبُلَ فَتَفَرَّقَ بِكُمْ","سَبِيلِهِۦ ۚ ذَٰلِكُمْ وَصَّىٰكُم",21],["6:156:12",149,"عَن","about","قَبْلِنَا وَإِن كُنَّا","دِرَاسَتِهِمْ لَغَـٰفِلِينَ",21],["6:157:25",149,"عَنْهَا ۗ","from them","بِـَٔايَـٰتِ ٱللَّهِ وَصَدَفَ","سَنَجْزِى ٱلَّذِينَ يَصْدِفُونَ",21],["6:157:29",149,"عَنْ","from","سَنَجْزِى ٱلَّذِينَ يَصْدِفُونَ","ءَايَـٰتِنَا سُوٓءَ ٱلْعَذَابِ",21],["7:17:8",152,"وَعَنْ","and from","أَيْدِيهِمْ وَمِنْ خَلْفِهِمْ","أَيْمَـٰنِهِمْ وَعَن شَمَآئِلِهِمْ ۖ",21],["7:17:10",152,"وَعَن","and from","خَلْفِهِمْ وَعَنْ أَيْمَـٰنِهِمْ","شَمَآئِلِهِمْ ۖ وَلَا تَجِدُ",21],["7:20:8",152,"عَنْهُمَا","from both of them","لَهُمَا مَا وُۥرِىَ","مِن سَوْءَٰتِهِمَا وَقَالَ",21],["7:20:15",152,"عَنْ","from","مَا نَهَىٰكُمَا رَبُّكُمَا","هَـٰذِهِ ٱلشَّجَرَةِ إِلَّآ",21],["7:22:19",152,"عَن","from","رَبُّهُمَآ أَلَمْ أَنْهَكُمَا","تِلْكُمَا ٱلشَّجَرَةِ وَأَقُل",21],["7:27:12",153,"عَنْهُمَا","from both of them","مِّنَ ٱلْجَنَّةِ يَنزِعُ","لِبَاسَهُمَا لِيُرِيَهُمَا سَوْءَٰتِهِمَآ ۗ",21],["7:36:5",154,"عَنْهَآ","towards them","كَذَّبُوا۟ بِـَٔايَـٰتِنَا وَٱسْتَكْبَرُوا۟","أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ ۖ",21],["7:37:31",154,"عَنَّا","from us","ٱللَّهِ ۖ قَالُوا۟ ضَلُّوا۟","وَشَهِدُوا۟ عَلَىٰٓ أَنفُسِهِمْ",21],["7:40:6",155,"عَنْهَا","towards them","كَذَّبُوا۟ بِـَٔايَـٰتِنَا وَٱسْتَكْبَرُوا۟","لَا تُفَتَّحُ لَهُمْ",21],["7:45:3",156,"عَن","from","ٱلَّذِينَ يَصُدُّونَ","سَبِيلِ ٱللَّهِ وَيَبْغُونَهَا",21],["7:48:10",156,"عَنكُمْ","[to] you","قَالُوا۟ مَآ أَغْنَىٰ","جَمْعُكُمْ وَمَا كُنتُمْ",21],["7:53:35",157,"عَنْهُم","from them","خَسِرُوٓا۟ أَنفُسَهُمْ وَضَلَّ","مَّا كَانُوا۟ يَفْتَرُونَ",21],["7:77:4",160,"عَنْ","towards","فَعَقَرُوا۟ ٱلنَّاقَةَ وَعَتَوْا۟","أَمْرِ رَبِّهِمْ وَقَالُوا۟",21],["7:79:2",160,"عَنْهُمْ","from them","فَتَوَلَّىٰ","وَقَالَ يَـٰقَوْمِ لَقَدْ",21],["7:86:7",161,"عَن","from","صِرَٰطٍۢ تُوعِدُونَ وَتَصُدُّونَ","سَبِيلِ ٱللَّهِ مَنْ",21],["7:93:2",162,"عَنْهُمْ","from them","فَتَوَلَّىٰ","وَقَالَ يَـٰقَوْمِ لَقَدْ",21],["7:134:15",166,"عَنَّا","from us","عِندَكَ ۖ لَئِن كَشَفْتَ","ٱلرِّجْزَ لَنُؤْمِنَنَّ لَكَ",21],["7:135:3",166,"عَنْهُمُ","from them","فَلَمَّا كَشَفْنَا","ٱلرِّجْزَ إِلَىٰٓ أَجَلٍ",21],["7:136:10",166,"عَنْهَا","to them","كَذَّبُوا۟ بِـَٔايَـٰتِنَا وَكَانُوا۟","غَـٰفِلِينَ",21],["7:146:2",168,"عَنْ","from","سَأَصْرِفُ","ءَايَـٰتِىَ ٱلَّذِينَ يَتَكَبَّرُونَ",21],["7:146:35",168,"عَنْهَا","of them","كَذَّبُوا۟ بِـَٔايَـٰتِنَا وَكَانُوا۟","غَـٰفِلِينَ",21],["7:154:3",169,"عَن","from","وَلَمَّا سَكَتَ","مُّوسَى ٱلْغَضَبُ أَخَذَ",21],["7:157:16",170,"عَنِ","from","يَأْمُرُهُم بِٱلْمَعْرُوفِ وَيَنْهَىٰهُمْ","ٱلْمُنكَرِ وَيُحِلُّ لَهُمُ",21],["7:157:25",170,"عَنْهُمْ","from them","عَلَيْهِمُ ٱلْخَبَـٰٓئِثَ وَيَضَعُ","إِصْرَهُمْ وَٱلْأَغْلَـٰلَ ٱلَّتِى",21],["7:163:2",171,"عَنِ","about","وَسْـَٔلْهُمْ","ٱلْقَرْيَةِ ٱلَّتِى كَانَتْ",21],["7:165:9",172,"عَنِ","[from]","أَنجَيْنَا ٱلَّذِينَ يَنْهَوْنَ","ٱلسُّوٓءِ وَأَخَذْنَا ٱلَّذِينَ",21],["7:166:3",172,"عَن","about","فَلَمَّا عَتَوْا۟","مَّا نُهُوا۟ عَنْهُ",21],["7:166:6",172,"عَنْهُ","from it","عَن مَّا نُهُوا۟","قُلْنَا لَهُمْ كُونُوا۟",21],["7:172:24",173,"عَنْ","about","ٱلْقِيَـٰمَةِ إِنَّا كُنَّا","هَـٰذَا غَـٰفِلِينَ",21],["7:187:2",174,"عَنِ","about","يَسْـَٔلُونَكَ","ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا ۖ",21],["7:187:27",174,"عَنْهَا ۖ","about it","يَسْـَٔلُونَكَ كَأَنَّكَ حَفِىٌّ","قُلْ إِنَّمَا عِلْمُهَا",21],["7:190:11",175,"عَمَّا","above what","ءَاتَىٰهُمَا ۚ فَتَعَـٰلَى ٱللَّهُ","يُشْرِكُونَ",21],["7:199:6",176,"عَنِ","from","وَأْمُرْ بِٱلْعُرْفِ وَأَعْرِضْ","ٱلْجَـٰهِلِينَ",21],["7:206:7",176,"عَنْ","from","رَبِّكَ لَا يَسْتَكْبِرُونَ","عِبَادَتِهِۦ وَيُسَبِّحُونَهُۥ وَلَهُۥ",21],["8:1:2",177,"عَنِ","about","يَسْـَٔلُونَكَ","ٱلْأَنفَالِ ۖ قُلِ ٱلْأَنفَالُ",21],["8:11:14",178,"عَنكُمْ","from you","لِّيُطَهِّرَكُم بِهِۦ وَيُذْهِبَ","رِجْزَ ٱلشَّيْطَـٰنِ وَلِيَرْبِطَ",21],["8:19:16",179,"عَنكُمْ","you","نَعُدْ وَلَن تُغْنِىَ","فِئَتُكُمْ شَيْـًۭٔا وَلَوْ",21],["8:20:9",179,"عَنْهُ","from him","وَرَسُولَهُۥ وَلَا تَوَلَّوْا۟","وَأَنتُمْ تَسْمَعُونَ",21],["8:29:11",180,"عَنكُمْ","from you","لَّكُمْ فُرْقَانًۭا وَيُكَفِّرْ","سَيِّـَٔاتِكُمْ وَيَغْفِرْ لَكُمْ ۗ",21],["8:34:8",181,"عَنِ","from","ٱللَّهُ وَهُمْ يَصُدُّونَ","ٱلْمَسْجِدِ ٱلْحَرَامِ وَمَا",21],["8:36:7",181,"عَن","from","يُنفِقُونَ أَمْوَٰلَهُمْ لِيَصُدُّوا۟","سَبِيلِ ٱللَّهِ ۚ فَسَيُنفِقُونَهَا",21],["8:42:25",182,"عَنۢ","on","لِّيَهْلِكَ مَنْ هَلَكَ","بَيِّنَةٍۢ وَيَحْيَىٰ مَنْ",21],["8:42:30",182,"عَنۢ","on","وَيَحْيَىٰ مَنْ حَىَّ","بَيِّنَةٍۢ ۗ وَإِنَّ ٱللَّهَ",21],["8:47:11",183,"عَن","from","وَرِئَآءَ ٱلنَّاسِ وَيَصُدُّونَ","سَبِيلِ ٱللَّهِ ۚ وَٱللَّهُ",21],["8:66:4",185,"عَنكُمْ","for you","ٱلْـَٔـٰنَ خَفَّفَ ٱللَّهُ","وَعَلِمَ أَنَّ فِيكُمْ",21],["9:9:7",188,"عَن","from","ثَمَنًۭا قَلِيلًۭا فَصَدُّوا۟","سَبِيلِهِۦٓ ۚ إِنَّهُمْ سَآءَ",21],["9:25:14",190,"عَنكُمْ","you","كَثْرَتُكُمْ فَلَمْ تُغْنِ","شَيْـًۭٔا وَضَاقَتْ عَلَيْكُمُ",21],["9:29:26",191,"عَن","willingly","حَتَّىٰ يُعْطُوا۟ ٱلْجِزْيَةَ","يَدٍۢ وَهُمْ صَـٰغِرُونَ",21],["9:31:22",191,"عَمَّا","from what","إِلَّا هُوَ ۚ سُبْحَـٰنَهُۥ","يُشْرِكُونَ",21],["9:34:14",192,"عَن","from","ٱلنَّاسِ بِٱلْبَـٰطِلِ وَيَصُدُّونَ","سَبِيلِ ٱللَّهِ ۗ وَٱلَّذِينَ",21],["9:43:3",194,"عَنكَ","you","عَفَا ٱللَّهُ","لِمَ أَذِنتَ لَهُمْ",21],["9:66:9",197,"عَن","[on]","إِيمَـٰنِكُمْ ۚ إِن نَّعْفُ","طَآئِفَةٍۢ مِّنكُمْ نُعَذِّبْ",21],["9:67:9",197,"عَنِ","what","يَأْمُرُونَ بِٱلْمُنكَرِ وَيَنْهَوْنَ","ٱلْمَعْرُوفِ وَيَقْبِضُونَ أَيْدِيَهُمْ ۚ",21],["9:71:9",198,"عَنِ","from","يَأْمُرُونَ بِٱلْمَعْرُوفِ وَيَنْهَوْنَ","ٱلْمُنكَرِ وَيُقِيمُونَ ٱلصَّلَوٰةَ",21],["9:95:8",202,"عَنْهُمْ ۖ","from them","ٱنقَلَبْتُمْ إِلَيْهِمْ لِتُعْرِضُوا۟","فَأَعْرِضُوا۟ عَنْهُمْ ۖ إِنَّهُمْ",21],["9:95:10",202,"عَنْهُمْ ۖ","from them","لِتُعْرِضُوا۟ عَنْهُمْ ۖ فَأَعْرِضُوا۟","إِنَّهُمْ رِجْسٌۭ ۖ وَمَأْوَىٰهُمْ",21],["9:96:4",202,"عَنْهُمْ ۖ","with them","يَحْلِفُونَ لَكُمْ لِتَرْضَوْا۟","فَإِن تَرْضَوْا۟ عَنْهُمْ",21],["9:96:7",202,"عَنْهُمْ","with them","عَنْهُمْ ۖ فَإِن تَرْضَوْا۟","فَإِنَّ ٱللَّهَ لَا",21],["9:96:12",202,"عَنِ","with","ٱللَّهَ لَا يَرْضَىٰ","ٱلْقَوْمِ ٱلْفَـٰسِقِينَ",21],["9:100:11",203,"عَنْهُمْ","with them","بِإِحْسَـٰنٍۢ رَّضِىَ ٱللَّهُ","وَرَضُوا۟ عَنْهُ وَأَعَدَّ",21],["9:100:13",203,"عَنْهُ","with Him","ٱللَّهُ عَنْهُمْ وَرَضُوا۟","وَأَعَدَّ لَهُمْ جَنَّـٰتٍۢ",21],["9:104:8",203,"عَنْ","from","هُوَ يَقْبَلُ ٱلتَّوْبَةَ","عِبَادِهِۦ وَيَأْخُذُ ٱلصَّدَقَـٰتِ",21],["9:112:10",205,"عَنِ","[on]","ٱلْـَٔامِرُونَ بِٱلْمَعْرُوفِ وَٱلنَّاهُونَ","ٱلْمُنكَرِ وَٱلْحَـٰفِظُونَ لِحُدُودِ",21],["9:114:7",205,"عَن","because","إِبْرَٰهِيمَ لِأَبِيهِ إِلَّا","مَّوْعِدَةٍۢ وَعَدَهَآ إِيَّاهُ",21],["9:120:11",206,"عَن","after","ٱلْأَعْرَابِ أَن يَتَخَلَّفُوا۟","رَّسُولِ ٱللَّهِ وَلَا",21],["9:120:17",206,"عَن","to","وَلَا يَرْغَبُوا۟ بِأَنفُسِهِمْ","نَّفْسِهِۦ ۚ ذَٰلِكَ بِأَنَّهُمْ",21],["10:7:13",209,"عَنْ","(are) of","بِهَا وَٱلَّذِينَ هُمْ","ءَايَـٰتِنَا غَـٰفِلُونَ",21],["10:12:13",209,"عَنْهُ","from him","قَآئِمًۭا فَلَمَّا كَشَفْنَا","ضُرَّهُۥ مَرَّ كَأَن",21],["10:18:28",210,"عَمَّا","above what","ٱلْأَرْضِ ۚ سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ","يُشْرِكُونَ",21],["10:29:8",212,"عَنْ","of","وَبَيْنَكُمْ إِن كُنَّا","عِبَادَتِكُمْ لَغَـٰفِلِينَ",21],["10:30:13",212,"عَنْهُم","from them","مَوْلَىٰهُمُ ٱلْحَقِّ ۖ وَضَلَّ","مَّا كَانُوا۟ يَفْتَرُونَ",21],["10:61:23",215,"عَن","from","فِيهِ ۚ وَمَا يَعْزُبُ","رَّبِّكَ مِن مِّثْقَالِ",21],["10:78:4",217,"عَمَّا","from that","قَالُوٓا۟ أَجِئْتَنَا لِتَلْفِتَنَا","وَجَدْنَا عَلَيْهِ ءَابَآءَنَا",21],["10:88:15",218,"عَن","from","ٱلدُّنْيَا رَبَّنَا لِيُضِلُّوا۟","سَبِيلِكَ ۖ رَبَّنَا ٱطْمِسْ",21],["10:92:12",219,"عَنْ","of","كَثِيرًۭا مِّنَ ٱلنَّاسِ","ءَايَـٰتِنَا لَغَـٰفِلُونَ",21],["10:98:13",220,"عَنْهُمْ","from them","لَمَّآ ءَامَنُوا۟ كَشَفْنَا","عَذَابَ ٱلْخِزْىِ فِى",21],["10:101:11",220,"عَن","to","تُغْنِى ٱلْـَٔايَـٰتُ وَٱلنُّذُرُ","قَوْمٍۢ لَّا يُؤْمِنُونَ",21],["11:8:3",222,"عَنْهُمُ","from them","وَلَئِنْ أَخَّرْنَا","ٱلْعَذَابَ إِلَىٰٓ أُمَّةٍۢ",21],["11:8:16",222,"عَنْهُمْ","from them","يَأْتِيهِمْ لَيْسَ مَصْرُوفًا","وَحَاقَ بِهِم مَّا",21],["11:10:10",222,"عَنِّىٓ ۚ","from me","لَيَقُولَنَّ ذَهَبَ ٱلسَّيِّـَٔاتُ","إِنَّهُۥ لَفَرِحٌۭ فَخُورٌ",21],["11:19:3",223,"عَن","from","ٱلَّذِينَ يَصُدُّونَ","سَبِيلِ ٱللَّهِ وَيَبْغُونَهَا",21],["11:21:6",224,"عَنْهُم","from them","خَسِرُوٓا۟ أَنفُسَهُمْ وَضَلَّ","مَّا كَانُوا۟ يَفْتَرُونَ",21],["11:53:10",227,"عَن","on","نَحْنُ بِتَارِكِىٓ ءَالِهَتِنَا","قَوْلِكَ وَمَا نَحْنُ",21],["11:74:3",230,"عَنْ","from","فَلَمَّا ذَهَبَ","إِبْرَٰهِيمَ ٱلرَّوْعُ وَجَآءَتْهُ",21],["11:76:3",230,"عَنْ","from","يَـٰٓإِبْرَٰهِيمُ أَعْرِضْ","هَـٰذَآ ۖ إِنَّهُۥ قَدْ",21],["11:88:21",231,"عَنْهُ ۚ","from it","إِلَىٰ مَآ أَنْهَىٰكُمْ","إِنْ أُرِيدُ إِلَّا",21],["11:101:8",233,"عَنْهُمْ","them","أَنفُسَهُمْ ۖ فَمَآ أَغْنَتْ","ءَالِهَتُهُمُ ٱلَّتِى يَدْعُونَ",21],["11:116:10",234,"عَنِ","from","أُو۟لُوا۟ بَقِيَّةٍۢ يَنْهَوْنَ","ٱلْفَسَادِ فِى ٱلْأَرْضِ",21],["11:123:15",235,"عَمَّا","of what","وَمَا رَبُّكَ بِغَـٰفِلٍ","تَعْمَلُونَ",21],["12:13:12",236,"عَنْهُ","of him","يَأْكُلَهُ ٱلذِّئْبُ وَأَنتُمْ","غَـٰفِلُونَ",21],["12:23:6",238,"عَن","from","هُوَ فِى بَيْتِهَا","نَّفْسِهِۦ وَغَلَّقَتِ ٱلْأَبْوَٰبَ",21],["12:24:13",238,"عَنْهُ","from him","رَبِّهِۦ ۚ كَذَٰلِكَ لِنَصْرِفَ","ٱلسُّوٓءَ وَٱلْفَحْشَآءَ ۚ إِنَّهُۥ",21],["12:26:4",238,"عَن","about","قَالَ هِىَ رَٰوَدَتْنِى","نَّفْسِى ۚ وَشَهِدَ شَاهِدٌۭ",21],["12:29:3",238,"عَنْ","from","يُوسُفُ أَعْرِضْ","هَـٰذَا ۚ وَٱسْتَغْفِرِى لِذَنۢبِكِ ۖ",21],["12:30:9",238,"عَن","about","ٱلْعَزِيزِ تُرَٰوِدُ فَتَىٰهَا","نَّفْسِهِۦ ۖ قَدْ شَغَفَهَا",21],["12:32:8",239,"عَن","[from]","فِيهِ ۖ وَلَقَدْ رَٰوَدتُّهُۥ","نَّفْسِهِۦ فَٱسْتَعْصَمَ ۖ وَلَئِن",21],["12:33:11",239,"عَنِّى","from me","إِلَيْهِ ۖ وَإِلَّا تَصْرِفْ","كَيْدَهُنَّ أَصْبُ إِلَيْهِنَّ",21],["12:34:5",239,"عَنْهُ","from him","لَهُۥ رَبُّهُۥ فَصَرَفَ","كَيْدَهُنَّ ۚ إِنَّهُۥ هُوَ",21],["12:51:7",241,"عَن","from","إِذْ رَٰوَدتُّنَّ يُوسُفَ","نَّفْسِهِۦ ۚ قُلْنَ حَـٰشَ",21],["12:51:25",241,"عَن","from","ٱلْحَقُّ أَنَا۠ رَٰوَدتُّهُۥ","نَّفْسِهِۦ وَإِنَّهُۥ لَمِنَ",21],["12:61:3",242,"عَنْهُ","for him","قَالُوا۟ سَنُرَٰوِدُ","أَبَاهُ وَإِنَّا لَفَـٰعِلُونَ",21],["12:67:14",243,"عَنكُم","you","مُّتَفَرِّقَةٍۢ ۖ وَمَآ أُغْنِى","مِّنَ ٱللَّهِ مِن",21],["12:68:10",243,"عَنْهُم","them","مَّا كَانَ يُغْنِى","مِّنَ ٱللَّهِ مِن",21],["12:84:2",245,"عَنْهُمْ","from them","وَتَوَلَّىٰ","وَقَالَ يَـٰٓأَسَفَىٰ عَلَىٰ",21],["12:105:10",248,"عَنْهَا","(are) from them","يَمُرُّونَ عَلَيْهَا وَهُمْ","مُعْرِضُونَ",21],["12:110:17",248,"عَنِ","from","وَلَا يُرَدُّ بَأْسُنَا","ٱلْقَوْمِ ٱلْمُجْرِمِينَ",21],["13:33:31",253,"عَنِ","from","كَفَرُوا۟ مَكْرُهُمْ وَصُدُّوا۟","ٱلسَّبِيلِ ۗ وَمَن يُضْلِلِ",21],["14:3:8",255,"عَن","from","عَلَى ٱلْـَٔاخِرَةِ وَيَصُدُّونَ","سَبِيلِ ٱللَّهِ وَيَبْغُونَهَا",21],["14:10:27",256,"عَمَّا","from what","تُرِيدُونَ أَن تَصُدُّونَا","كَانَ يَعْبُدُ ءَابَآؤُنَا",21],["14:21:15",258,"عَنَّا","us","فَهَلْ أَنتُم مُّغْنُونَ","مِنْ عَذَابِ ٱللَّهِ",21],["14:30:5",259,"عَن","from","لِلَّهِ أَندَادًۭا لِّيُضِلُّوا۟","سَبِيلِهِۦ ۗ قُلْ تَمَتَّعُوا۟",21],["14:42:5",260,"عَمَّا","of what","تَحْسَبَنَّ ٱللَّهَ غَـٰفِلًا","يَعْمَلُ ٱلظَّـٰلِمُونَ ۚ إِنَّمَا",21],["15:51:2",264,"عَن","about","وَنَبِّئْهُمْ","ضَيْفِ إِبْرَٰهِيمَ",21],["15:70:4",265,"عَنِ","from","قَ