َّا كَسَبُوا۟ شَيْـًۭٔا",21],["45:19:4",500,"عَنكَ","you","إِنَّهُمْ لَن يُغْنُوا۟","مِنَ ٱللَّهِ شَيْـًۭٔا ۚ",21],["46:3:13",502,"عَمَّآ","from what","مُّسَمًّۭى ۚ وَٱلَّذِينَ كَفَرُوا۟","أُنذِرُوا۟ مُعْرِضُونَ",21],["46:5:16",502,"عَن","of","يَوْمِ ٱلْقِيَـٰمَةِ وَهُمْ","دُعَآئِهِمْ غَـٰفِلُونَ",21],["46:16:4",504,"عَنْهُمْ","from them","أُو۟لَـٰٓئِكَ ٱلَّذِينَ نَتَقَبَّلُ","أَحْسَنَ مَا عَمِلُوا۟",21],["46:16:9",504,"عَن","[from]","مَا عَمِلُوا۟ وَنَتَجَاوَزُ","سَيِّـَٔاتِهِمْ فِىٓ أَصْحَـٰبِ",21],["46:22:4",505,"عَنْ","from","قَالُوٓا۟ أَجِئْتَنَا لِتَأْفِكَنَا","ءَالِهَتِنَا فَأْتِنَا بِمَا",21],["46:26:14",505,"عَنْهُمْ","them","وَأَفْـِٔدَةًۭ فَمَآ أَغْنَىٰ","سَمْعُهُمْ وَلَآ أَبْصَـٰرُهُمْ",21],["46:28:12",505,"عَنْهُمْ ۚ","from them","ءَالِهَةًۢ ۖ بَلْ ضَلُّوا۟","وَذَٰلِكَ إِفْكُهُمْ وَمَا",21],["47:1:4",507,"عَن","from","ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوا۟","سَبِيلِ ٱللَّهِ أَضَلَّ",21],["47:2:15",507,"عَنْهُمْ","from them","مِن رَّبِّهِمْ ۙ كَفَّرَ","سَيِّـَٔاتِهِمْ وَأَصْلَحَ بَالَهُمْ",21],["47:32:5",510,"عَن","from","ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوا۟","سَبِيلِ ٱللَّهِ وَشَآقُّوا۟",21],["47:34:5",510,"عَن","from","ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوا۟","سَبِيلِ ٱللَّهِ ثُمَّ",21],["47:38:15",510,"عَن","from","يَبْخَلْ فَإِنَّمَا يَبْخَلُ","نَّفْسِهِۦ ۚ وَٱللَّهُ ٱلْغَنِىُّ",21],["48:5:12",511,"عَنْهُمْ","from them","خَـٰلِدِينَ فِيهَا وَيُكَفِّرَ","سَيِّـَٔاتِهِمْ ۚ وَكَانَ ذَٰلِكَ",21],["48:18:4",513,"عَنِ","with","۞ لَّقَدْ رَضِىَ ٱللَّهُ","ٱلْمُؤْمِنِينَ إِذْ يُبَايِعُونَكَ",21],["48:20:12",513,"عَنكُمْ","from you","وَكَفَّ أَيْدِىَ ٱلنَّاسِ","وَلِتَكُونَ ءَايَةًۭ لِّلْمُؤْمِنِينَ",21],["48:24:5",514,"عَنكُمْ","from you","ٱلَّذِى كَفَّ أَيْدِيَهُمْ","وَأَيْدِيَكُمْ عَنْهُم بِبَطْنِ",21],["48:24:7",514,"عَنْهُم","from them","أَيْدِيَهُمْ عَنكُمْ وَأَيْدِيَكُمْ","بِبَطْنِ مَكَّةَ مِنۢ",21],["48:25:5",514,"عَنِ","from","ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوكُمْ","ٱلْمَسْجِدِ ٱلْحَرَامِ وَٱلْهَدْىَ",21],["50:17:4",519,"عَنِ","on","إِذْ يَتَلَقَّى ٱلْمُتَلَقِّيَانِ","ٱلْيَم